// #3375: a parameter named `resume` does not switch off the check of the
// arm's own `resume(v)`: inside the arm the name is the continuation, so a
// String is refused for an Int operation. It used to compile.
effect G {
  Op -> Int
}

fn via_param(resume: (Int) -> Int) -> Int {
  handle {
    perform G::Op + 1
  } with G {
    Op => resume("str")
  }
}

fn main() -> Int {
  via_param((x: Int) -> x)
}
