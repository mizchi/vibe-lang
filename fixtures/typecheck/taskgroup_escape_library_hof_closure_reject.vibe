// #3360: a closure literal handed to a library function is checked before the
// call fixes its parameter's type, so `Array::push(c, h)` saw an open type and
// was let through: the handle was joined after its group closed. The same
// write in a `for h in hs` loop was refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let c: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, () -> { 41 })]
    let _ = Array::map(hs, (h) -> {
      Array::push(c, h)
      0
    })
    1
  })
  println("r=\{r} after=\{TaskHandle::join(Array::get(c, 0))}")
}
