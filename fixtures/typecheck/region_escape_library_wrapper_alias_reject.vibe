// #3255: a call through an alias of a library wrapper that stores its
// argument (`MutMap::set` from `@vibe/core`) is judged by the wrapper the
// alias names. Before, the retaining-write check matched the callee's
// SPELLING: `put` named no entry, so storing a region value into an outer map
// through it was accepted, while the direct call was refused.
import @vibe/core { MutMap }

fn aliased() -> Int {
  let outer: MutMap[Int, MutList[Int]] = MutMap::new_int()
  let put = MutMap::set
  let put2 = put
  region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    put2(outer, 1, cell)
    1
  }
}
