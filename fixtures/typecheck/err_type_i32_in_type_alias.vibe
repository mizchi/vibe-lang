//# #3727: `i32` in a type alias's body is refused too.
//#
//# An alias body never ran the unknown-type check, so `type Word = i32`
//# would otherwise keep `i32` alive behind a second name.
type Word = i32

fn id(x: Word) -> Word {
  x
}

fn main() -> Unit allows Console {
  println("\{id(x = 1)}")
}
