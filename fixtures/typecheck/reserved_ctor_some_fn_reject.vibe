// #3086: `Some` is the built-in Option constructor, and every `Some` in an
// expression resolves to it in the checker. A top-level `fn` named `Some` is refused
// at its own token, with the rename named, instead of being silently ignored.
struct B {
  v: Bool
}

fn Some(x: Bool) -> B {
  B::{ v: x }
}

fn main() -> Unit {
  let _ = Some(false)
}
