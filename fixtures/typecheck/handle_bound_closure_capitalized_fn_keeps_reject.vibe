// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It is handed to an ordinary function whose name starts with
// an uppercase letter and which keeps it in a module-level array: the case
// of a name does not make a constructor. `g()` answered `6` from the dead
// handler after `vibe check` was clean.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn Keep(f: () -> Int) -> Unit {
  Array::push(saved, f)
}

fn main() -> Unit allows Console {
  handle {
    Keep(() -> perform Ask::Get() + 1)
  } with { Ask::Get() => resume(5) }
  let g = Array::get(saved, 0)
  println("g=\{g()}")
}
