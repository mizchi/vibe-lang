//# #3793: `u8` is not an 8-bit type.
//#
//# It resolved to a builtin type whose arithmetic was the 63-bit `Int`'s, so
//# `255 + 255` under the name `u8` checked clean and printed `d=510`. It is
//# now an unknown type, and the message leads with the edit: write `Int`.
fn main() -> Unit allows Console {
  let c: u8 = 255
  let d: u8 = c + c
  println("d=\{d}")
}
