// #3371: a constructor payload pattern was never tested either: for
// `perform Paint::Use(Color::Red)` the later `Color::Green` arm ran and `run`
// answered 2. The edit moves the constructor into a `match` in the arm body.
enum Color {
  Red;
  Green
}

effect Paint {
  Use(Color) -> Int
}

fn run() -> Int {
  handle {
    perform Paint::Use(Color::Red)
  } with {
    Paint::Use(Color::Red) => resume(1);
    Paint::Use(Color::Green) => resume(2)
  }
}
