// #3408 (Codex on #3409): a generic callee called through a local alias is
// instantiated under the alias's own spelling at the call, so `h(1)` gives
// `Box[Int]`, which the caller covers.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn mid() -> Int with Box {
  let h = mk
  h(1)
}
fn top() -> Int with Box[Int] {
  mid()
}
