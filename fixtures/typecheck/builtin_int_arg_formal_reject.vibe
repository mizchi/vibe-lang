// #3022 review: a type variable passed where a builtin takes an `Int` is bound
// to `Int`, so a generic wrapper is not instantiated at `String` and then read
// as an integer.
fn convert[T](x: T) -> Float64 {
  Int::to_float64(x)
}

fn main() -> Unit allows Console {
  println("\{convert(x = "abc")}")
}
