// #3488 follow-up: a builtin function's result is fresh. `MutList::empty(r)`
// takes the region token, but the list it returns aliases nothing outside the
// region, so storing the list into itself is not an escape.
fn one() -> Int {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, l)
    7
  }
}

fn main() -> Unit allows Console {
  println("\{one()}")
}
