// #3594: the same with `forward` imported. Its module publishes that the
// closure it returns in a field performs its row variable `e`, which this
// call instantiates to `Exception[Int]`.
import ../modules/handle_bound_closure_row_var_dep.vibe {
  fallback, forward
}

fn noisy() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Unit allows Console {
  let b = handle {
    forward(noisy)
  } with { Exception[Int]::Throw(c) => fallback(c) }
  let f = b.f
  println("\{f()}")
}
