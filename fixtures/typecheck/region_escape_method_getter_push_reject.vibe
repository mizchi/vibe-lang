// #4091: a method call runs the function its receiver's type names, here one
// that returns a module-level array.

let kept: Array[MutList[Int]] = []

struct Holder {
  n: Int
}

fn Holder::sink(self: Holder) -> Array[MutList[Int]] {
  let _ = self.n
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let h = Holder::{ n: 1 }
    Array::push(h.sink(), value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
