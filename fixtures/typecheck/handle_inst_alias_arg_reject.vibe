// #3022 review: an alias argument is read through to its target. `get_a`
// declares `State[A]` for `type A = Int`; the handler resumes a String.
type A = Int

effect State[S] {
  Get() -> S
}

fn get_a() -> Int with State[A] {
  perform State::Get()
}

fn main() -> Unit allows Console {
  let n = handle {
    get_a()
  } with { State::Get() => resume("abc") }
  println("\{n}")
}
