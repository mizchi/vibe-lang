// #3255: a program's own function spelled like a library wrapper that
// retains (`MutMap::set`) is judged by its body, as any program function is.
// This one keeps nothing, so handing it a region value is fine; before, the
// retaining-write check refused it by its spelling.
struct Bag { n: Int }

fn MutMap::set(_ m: Bag, k: Int, v: MutList[Int]) -> Int {
  m.n + k + MutList::length(v)
}

fn shadow() -> Int {
  let outer = Bag::{ n: 1 }
  region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    MutMap::set(outer, k = 1, v = cell)
  }
}
