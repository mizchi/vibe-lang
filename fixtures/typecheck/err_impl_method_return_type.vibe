// #3538: the impl returned `Int` where the trait declares `String`, and the
// caller printed the integer as a string (NUL bytes).
trait Name { name(Self) -> String }

struct P { x: Int }

impl Name for P {
  name(self) -> Int { 42 }
}

fn main allows Console {
  println(Name::name(P::{ x: 1 }))
}
