// #3488 (Codex on #3492): a record field that may be the outer cell, by a
// conditional, is the outer cell for the check.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let flag = true
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: if flag { c } else { Cell::{ v: None } } }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
