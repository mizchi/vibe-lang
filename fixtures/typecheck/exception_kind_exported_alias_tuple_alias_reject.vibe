// #3028: an exported type alias publishes its body, so a function row in it
// must spell its exception kind as the type it names. `Pair` resolves to
// `(Int, Int)`, which a row cannot spell, so the alias would publish the
// private alias NAME.
type Pair = (Int, Int)

export type Callback = () -> Int with Exception[Pair]

fn main() -> Int {
  0
}
