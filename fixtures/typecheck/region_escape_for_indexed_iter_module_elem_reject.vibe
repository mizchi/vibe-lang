// Codex on #4100: a `C::iter_get` that returns a module-level array hands
// out no part of the iterand, but the array outlives every region, so the
// write is refused (main before this printed `kept=true`).
let kept: Array[MutList[Int]] = []

struct Bag {
  n: Int
}

fn Bag::iter_length(_ b: Bag) -> Int {
  b.n
}

fn Bag::iter_get(_ b: Bag, i: Int) -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let bag = Bag::{ n: 1 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in bag {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
