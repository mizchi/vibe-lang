//# #2475 (Codex on #2819), a CONTROL for the arity half of the rule.
//#
//# The applied door of `resolve_type_expr_core_shadowed` hard-codes `Array` at
//# ARITY 1 only, so a two-parameter `Array` falls through to `find_typedef`
//# and this declaration can be named. It is named below, in an annotation,
//# because "can be named" is the whole reason for accepting it -- a program
//# that reached the type only by inference would pass just as well with the
//# declaration unnameable, which is the defect #2475 refuses.
//#
//# The controls are one declaration per file on purpose: a declared type owns
//# the APPLIED spelling for type ARGUMENTS too, so a file that also declared
//# `struct Int[T]` could not write `Array[Int, String]` at all.
struct Array[K, V] {
  k: K;
  v: V
}

fn read(a: Array[Int, String]) -> Int {
  a.k
}

fn main() -> Int {
  read(Array::{ k: 7, v: "x" })
}
