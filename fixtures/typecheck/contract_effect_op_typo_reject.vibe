// #3022 review: a contract's effect operations reach its sibling files with
// the effect name, so `with Ask::Typo` in fixtures/typecheck/
// contract_effect_op_typo_pkg/impl.vibe is refused.
import ./contract_effect_op_typo_pkg { read_one }

export fn main() -> Int {
  handle {
    read_one()
  } with { Ask::Get => resume(1) }
}
