// #3488 (Codex on #3492): a record field set from a block whose tail is the outer cell (`{ 0; c }`) is that cell.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(w = Wrap::{ cell: {
      0
      c
    } }, x = TaskGroup::spawn(n, f = () -> { 41 }))
    1
  })
  println("r=\{r}")
}
