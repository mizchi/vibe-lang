// #3488: a handled block's value is its body's (or an arm's), so it may be
// the outer cell (Codex on #3492).
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: handle { outer } with { Exception::Throw(msg) => Cell::{ v: None } } }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
