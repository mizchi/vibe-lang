// #3275: a perform inside a handler arm is handled by the enclosing handler,
// here the caller of a `with Box[Int]` function, so its payload is an `Int`.
// The local handle's own instantiation (`String`) covers only its body.
effect Box[T] {
  Put(T) -> Int
}

fn producer() -> Int with Box[Int] {
  handle {
    perform Box::Put("x")
  } with {
    Box::Put(v) => resume(perform Box::Put(v))
  }
}
