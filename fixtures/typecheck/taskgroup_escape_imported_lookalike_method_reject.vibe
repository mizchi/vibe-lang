// #3360 (Codex on #3467): `Task::hold` is a method of a type the runtime also
// names, declared in a module that is not the runtime; it keeps its argument,
// so the handle cannot be handed to it.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_lookalike_dep_ok.vibe { Slot, Task }

fn main() -> Unit allows Exception + Console {
  let s: Slot[TaskHandle[Int]] = Slot::{ v: None }
  let r = TaskGroup::run((n) -> {
    Task::hold(s, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
