// #3311 / #3341 (Codex on #3340): a named lambda passed to a function-typed
// struct field is compared with the field's row, like an argument of a
// declared function.
effect Box[T] {
  Put(T) -> Int
}

struct Runner {
  run: (() -> Int with Box[String]) -> Int
}

fn producer(r: Runner) -> Int with Box[String] {
  let g = () -> {
    perform Box::Put(1)
  }
  r.run(g)
}
