// #3387: a struct field typed `() -> Int` names no `Box`, so the lambda it
// holds performs at the `Box[String]` in scope where it is stored.
effect Box[T] {
  Put(T) -> Int
}
struct Holder { f: () -> Int }
fn via_field() -> Int with Box[String] {
  let h = Holder::{ f: () -> Int { perform Box::Put(1) } }
  let g = h.f
  g()
}
