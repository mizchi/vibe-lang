// #3036 control: an `Outer` and an `Inner` whose definitions are identical
// to dup_type_nested_a_dep_ok's -- same fields, same types, same order, all
// the way down.
export struct Inner {
  code: Int
}

export struct Outer {
  inner: Inner
}

export fn consume_outer(o: Outer) -> Int {
  o.inner.code
}
