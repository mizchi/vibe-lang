// #4115: a contract whose `opaque type`s are sealed at the import. Outside
// this package `Handle` and `Shade` are names only: the consumer fixtures
// beside it construct, read and destructure them, and each is refused.

opaque type Handle
opaque type Shade

fn handle_new(_ n: Int) -> Handle
fn handle_get(_ h: Handle) -> Int
fn shade_dark() -> Shade
fn shade_code(_ s: Shade) -> Int
