// Implementation of ./index.vpkg (#4115). Inside the package both types are
// ordinary declarations.

export struct Handle {
  n: Int
}

export enum Shade {
  Dark;
  Light
}

export fn handle_new(_ n: Int) -> Handle { Handle::{ n: n } }

export fn handle_get(_ h: Handle) -> Int { h.n }

export fn shade_dark() -> Shade { Shade::Dark }

export fn shade_code(_ s: Shade) -> Int {
  match s {
    Shade::Dark => 0,
    Shade::Light => 1
  }
}
