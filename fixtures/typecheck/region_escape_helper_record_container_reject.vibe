// #4091 (Codex on #4106): beside a copied scalar, the helper's record holds a
// module-level array, so a push into that field keeps the region value there.

let tag: Int = 7
let kept: Array[MutList[Int]] = []

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn make_box() -> Box {
  Box::{ tag: tag, items: kept }
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let b = make_box()
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
