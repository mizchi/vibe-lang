// #3538: a bodyless GENERIC impl dispatches every instantiation to the one
// `Box::name`, so that function must hold for every `Box[T]`. Written for
// `Box[Int]`, it was accepted, and the witness for `Box[String]` handed it a
// string: `self.v + 1` answered `137438953475`.
trait Name {
  name(Self) -> Int
}

struct Box[T] {
  v: T
}

impl [T] Name for Box[T]

fn Box::name(self: Box[Int]) -> Int {
  self.v + 1
}

fn via[T: Name](x: T) -> Int {
  T::name(x)
}

fn main allows Console {
  let b: Box[String] = Box::{ v: "hello" }
  println("b=\{via(b)}")
}
