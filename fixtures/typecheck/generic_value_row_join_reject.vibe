// #3387: an imported generic function taken as a value keeps its callback
// row's instantiation through an `if` join. `T` is `String` here, so the
// callback's perform must be a `Wrap[String]`.
import ./callback_row_extracted_generic_dep_ok.vibe {
  Wrap, effect Box, mk_wrap, run_wrap
}
fn caller(c: Bool) -> Int with Box {
  let f = if c { run_wrap } else { run_wrap }
  f("abc", () -> {
    perform Box::Put(Wrap::{ v: 12345 })
  }, String::length)
}
