// #4018: an undeclared type name in an effect operation's PARAMETER is
// refused at the declaration, as it is in a struct field. It used to fall
// through to a rigid name nothing else could produce, so this checked clean
// -- and the `perform`, which passes an `Int` where the signature says `Zzz`,
// checked clean too.
effect E {
  Get(Zzz) -> String
}

fn f() -> String with E {
  perform E::Get(1)
}
