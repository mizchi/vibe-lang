// An `Array::map` callback over an `Array[String]` is handed no result type,
// so its early `return 123` is checked against nothing. Seeding `s` with the
// element type would type the lambda `(String) -> String` from its tail and
// put an `Int` into the `Array[String]`. The parameter is left unseeded, so
// `s + s` settles on `Int` and the call is refused, as before the seed.
// (Nothing else here constrains `s`: an `s == ""` test would make it a
// `String` with or without the seed, which is the general unchecked-`return`
// case rather than this seed's.)
fn f(xs: Array[String], stop: Bool) -> Array[String] {
  Array::map(xs, f = (s) -> {
    if stop {
      return 123
    }
    s + s
  })
}
