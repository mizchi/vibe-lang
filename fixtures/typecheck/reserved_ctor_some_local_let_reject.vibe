// #3086: `Some` is the built-in Option constructor, and every `Some` in an
// expression resolves to it in the checker. A local `let` named `Some` is refused
// at its own token, with the rename named, instead of being silently ignored.
struct B {
  v: Bool
}

fn main() -> Unit {
  let Some = (x: Bool) -> B::{ v: x }
  let _ = Some(false)
}
