// #3601: the same for an imported function: its published kind is checked
// where it is passed as a value.
import ../modules/exception_erased_row_dep.vibe {
  fail
}

fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn main() -> Unit allows Console {
  let r = handle {
    run(fail)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
