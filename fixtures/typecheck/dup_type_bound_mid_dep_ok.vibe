// #3036 (Codex on #3076): names dup_type_a_dep_ok's `Err` ONLY inside a
// generic bound -- of an exported function and of an exported trait's method.
import ./dup_type_a_dep_ok.vibe { Err }

export trait Builds[E] {
  build(Self) -> E
}

export fn use_it[T: Builds[Err]](x: T) -> Int {
  1
}

export trait Runs {
  run[T: Builds[Err]](Self, T) -> Int
}
