// #3475 control: imported TaskGroup calls and a polymorphic Array receiver
// remain valid while the element, region and effect arguments are inferred.
import @vibe/concurrent {
  TaskGroup
}

fn count[T](xs: Array[T]) -> Int {
  Array::length(xs)
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let _ = g
    count([1, 2, 3])
  })
}
