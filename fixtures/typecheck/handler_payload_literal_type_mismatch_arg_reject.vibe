// #3371: in a multi-argument operation the mismatch names the argument; the
// first argument's literal agrees with its type, the second's does not, so
// no `==` edit is offered for either.
effect Two {
  Add(Int, Int) -> Int
}

fn run() -> Int {
  handle {
    perform Two::Add(1, 2)
  } with {
    Two::Add(1, "two") => resume(3);
    Two::Add(a, b) => resume(a + b)
  }
}
