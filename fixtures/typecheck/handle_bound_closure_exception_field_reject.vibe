// #3584: a closure that throws what a `handle` catches must not outlive that
// handle inside a struct field. `mk` throws and returns a `Box` whose field
// holds a closure without the row, which inherited its throw from `mk`'s;
// returned as the handle's value, `f()` threw with no handler around it and
// trapped after `vibe check` was clean.
// fixtures/handle_bound_closure_inside_test.vibe returns a struct whose
// field holds a closure that does not throw.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let b = handle {
    mk()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
