// #2994: a handle whose covered perform is one level down (inside a closure
// passed to Array::map in the callee) is refused with a position -- the handled
// body's first call, the edge the reader has to follow.
effect Counter { Next() -> Int }
fn via_map(xs: Array[Int]) -> Array[Int] with Counter {
  Array::map(xs, (x: Int) -> Int { x + perform Counter::Next() })
}
fn main allows Stdout {
  let r = handle { via_map([1, 2]) } with { Counter::Next() => resume(100) }
  println("\{Array::length(r)}")
}
