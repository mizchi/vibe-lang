// #3541: a closure literal the handled body passes on -- here to a callback
// parameter typed with the erased `with Exception` -- throws into that body.
// Its `Int` reached the erased arm, which read 5 as a String (`len=10`).
// #3601: the parameter's erased row carries only messages, and `run`'s own
// erased row lets what the closure raises out to its caller, so the literal
// itself is refused.
fn run(cb: () -> Int with Exception) -> Int with Exception {
  cb()
}

fn main allows Console {
  let r = handle { run(() -> { throw(5) }) } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
