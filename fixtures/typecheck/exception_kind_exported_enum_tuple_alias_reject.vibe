// #3028: an exported enum publishes each constructor's signature, so a
// function row in a payload must spell its exception kind as the type it
// names. `Pair` resolves to `(Int, Int)`, which a row cannot spell, so the
// constructor would publish the alias NAME -- and an importer with its own
// `Pair` would read that name as its own type.
type Pair = (Int, Int)

export enum Job {
  Run(() -> Int with Exception[Pair])
}

fn main() -> Int {
  0
}
