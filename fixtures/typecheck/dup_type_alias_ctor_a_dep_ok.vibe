// #3036 (Codex on #3076): half of dup_type_alias_ctor_alpha_ok.vibe -- a bare
// parameterized alias passed to a constructor slot, its binder spelled `X`.
export struct Holder[F[_]] {
  value: F[Int]
}

type Inner[X] = Array[X]

export struct Wrap {
  h: Holder[Inner]
}

export fn take_a(w: Wrap) -> Int {
  1
}
