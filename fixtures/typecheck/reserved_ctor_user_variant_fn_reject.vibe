// #3086: `Ok` is a constructor of `Res`, and every `Ok` in an expression
// resolves to it in the checker. Before the refusal, a top-level `fn` named `Ok` was
// accepted, the checker typed `Ok(1) + 1` through the binding, and codegen
// built the VARIANT instead: the sum printed a heap address (`257` on linear,
// `210` on gc).
enum Res {
  Ok(Int);
  Err(String)
}

fn Ok(x: Int) -> Int {
  x + 1
}

fn main() -> Unit {
  let _ = Ok(1) + 1
}
