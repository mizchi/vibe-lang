// #3417: the same reassignment under an annotated `let mut`.
effect Box[T] {
  Put(T) -> Int
}

fn g() -> Int with Box[Int] {
  perform Box::Put(12345)
}

fn h() -> Int with Box[String] {
  perform Box::Put("a")
}

fn run() -> Int with Box[String] {
  let mut f: () -> Int with Box[String] = h
  f = g
  f()
}
