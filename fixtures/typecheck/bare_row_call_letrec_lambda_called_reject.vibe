// #3408: a recursive local lambda that `mid` calls runs in `mid`, through its
// own recursion, so `mid` requires `mk`'s `Box[Int]` and a `Box[String]`
// caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let rec go = (n: Int) -> Int with Box {
    if n == 0 {
      mk()
    } else {
      go(n - 1)
    }
  }
  go(3)
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
