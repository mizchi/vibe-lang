// #3965: a qualified call to a trait method, `Value::value(..)`, whose trait
// a dependency declares. Under VIBE_CHECKED_MODULE_CACHE=on the dependency's
// reused artifact published its surface from the statements as parsed, which
// lack the `Value::value` wrapper the checker derives for the trait, so this
// call was `unknown name: Value::value` while `off` and `verify` compiled it.
// scripts/checked_module_cache_parity.mjs compiles every row of
// fixtures/typecheck/expected.tsv through off, verify and on.
import ./checked_cache_trait_method_base_dep_ok.vibe {
  Note, Value
}

impl Value[Int] for Note {
  value(self) -> Int {
    self.n + 1
  }
}

export fn from_use() -> Int {
  Value::value(Note::{ n: 0 })
}
