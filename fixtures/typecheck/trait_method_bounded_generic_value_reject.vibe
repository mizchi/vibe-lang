// #3580: a trait method with a bounded binder of its own takes those
// witnesses from the CALL through the trait, ahead of its arguments. Taken as
// a value there is no call to read them from, so the build refuses it with
// the edit rather than emitting a call the dictionary slot does not match.

trait Render {
  render(Self) -> String
}

struct Qt {
  name: String
}

impl Render for Qt {
  render(self) -> String {
    "Qt(\{self.name})"
  }
}

trait W {
  write[X: Render](Self, X) -> String
}

struct P {
  n: Int
}

impl W for P {
  write[Y: Render](self, x: Y) -> String {
    "\{self.n}:" + Y::render(x)
  }
}

fn go[T: W](t: T) -> String {
  let f = T::write
  f(t, Qt::{ name: "q" })
}

fn main() -> Unit allows Console {
  println(go(P::{ n: 3 }))
}
