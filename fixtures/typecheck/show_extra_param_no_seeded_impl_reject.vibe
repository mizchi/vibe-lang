// #3022 review: a program's own `Show` whose `to_string` takes another
// parameter is not the builtin shape, so the builtin `Int::to_string` does
// not satisfy it. Seeding it would put a one-argument function behind a
// two-argument method.
trait Show {
  to_string(Self, Int) -> String
}

fn show_it[T: Show](x: T) -> String {
  T::to_string(x, 2)
}

fn main() -> Unit allows Console {
  println(show_it(1))
}
