// #2962: the arm never calls resume, so its value is what the perform
// receives -- an Int where the operation returns String. The checker used to
// compare the arm against the handle BODY's type (Int) and accept this; at run
// time `String::length` then read the Int as a packed string (measured 114).
effect Cfg {
  Get() -> String
}

fn body() -> Int with Cfg {
  let s = perform Cfg::Get()
  String::length(s) + 100
}

fn main() -> Int {
  handle { body() } with { Cfg::Get() => 7 }
}
