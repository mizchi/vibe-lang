// #3589: a `Holder[e]` parameter forwarded to another row-polymorphic callee
// passes its row on, and a caller ABOVE the declarations is charged the same
// way as one below them.
struct Holder[r] {
  run: () -> Int with r
}

fn early() -> Int {
  outer(Holder::{ run: noisy })
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn call_holder[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

fn outer[e](h: Holder[e]) -> Int with e {
  call_holder(h)
}

fn main() -> Unit allows Console {
  println("\{early()}")
}
