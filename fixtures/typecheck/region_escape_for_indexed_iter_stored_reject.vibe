// #4050 (Codex on #4061): an indexed iterator whose `iter_get` returns a
// stored element of the iterand hands out a part of `outer`, so the write
// keeps the region value past the region (main printed `kept=true`).
struct Stored {
  items: Array[Array[MutList[Int]]]
}

fn Stored::iter_length(_ s: Stored) -> Int {
  Array::length(s.items)
}

fn Stored::iter_get(_ s: Stored, i: Int) -> Array[MutList[Int]] {
  Array::get(s.items, at = i)
}

fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let xs = Stored::{ items: [outer] }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in xs {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
