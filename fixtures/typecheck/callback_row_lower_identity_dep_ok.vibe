export effect Box[T] {
  Put(T) -> Int
}
export struct point { x: Int }
export enum tone {
  Light
}
export type payload = String
export fn run_point(_ f: () -> Int with Box[point]) -> Int {
  handle {
    f()
  } with { Box::Put(p) => resume(p.x) }
}
export fn point_producer() -> Int with Box[point] {
  perform Box::Put(point::{ x: 42 })
}
export fn run_tone(_ f: () -> Int with Box[tone]) -> Int {
  42
}
export fn run_payload(_ f: () -> Int with Box[payload]) -> Int {
  42
}
