// #3595: the accepted side of `row_var_concrete_label_*_reject`: a wrapper
// that declares the concrete label beside its row variable, called directly
// and through a struct field, by a caller that declares `Console`, with a
// `Console` argument and a pure one.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("noisy")
  1
}

fn pure_one() -> Int {
  1
}

fn m1(f: () -> Int with Console + e) -> Int with Console + e {
  f()
}

fn m1h(f: () -> Int with Console + e) -> Int with Console + e {
  let h = Holder::{ run: f }
  (h.run)()
}

fn loud() -> Int with Console {
  m1(noisy) + m1(pure_one) + m1h(noisy) + m1h(pure_one)
}

fn main() -> Unit allows Console {
  println("\{loud()}")
}
