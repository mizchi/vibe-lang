// #3343 (Codex on #3359): the body hands a struct holding the handle back
// from the group with an explicit `return`. The body's result check read only
// the tail, so this compiled and the handle was joined after its group
// closed; the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

fn main() -> Unit allows Exception + Console {
  let b = TaskGroup::run((n) -> {
    let x = Box::{ h: TaskGroup::spawn(n, () -> { 41 }) }
    return x
  })
  println("after=\{TaskHandle::join(b.h)}")
}
