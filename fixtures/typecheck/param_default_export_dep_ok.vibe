// #3440: exported functions with parameter defaults, imported by the
// err_param_default_imported_* fixtures. Exporting them is accepted.
export fn pick(_ x: Option[Int] = Some(1)) -> Option[Int] {
  x
}

fn label(name: String, times: Int = 1, sep?: String) -> String {
  let s = match sep {
    Some(v) => v,
    None => "-"
  }
  "\{name}\{s}\{times}"
}

export {
  label
}
