// #3022 review: a local that names a function (`let f = get_int`) makes a
// call through it a call to that function. `get_int` needs `State[Int]`; the
// handler resumes a String.
effect State[S] {
  Get() -> S
}

fn get_int() -> Int with State[Int] {
  perform State::Get()
}

fn main() -> Unit allows Stdout {
  let n = handle {
    let f = get_int
    f()
  } with { State::Get() => resume("abc") }
  println("\{n}")
}
