// #3318: fixing a row formal to ANOTHER type parameter is the same hole. The
// body makes `A` the type of `b`, but a caller instantiates `A` and `B`
// separately, so a handler at `String` received the `Int` passed as `b`.
effect Box[T] {
  Put(T) -> Int
}

fn f[A, B](b: B) -> Int with Box[A] {
  perform Box::Put(b)
}

fn main() -> Int {
  handle {
    f(7)
  } with {
    Box::Put(v) => resume(String::length(v))
  }
}
