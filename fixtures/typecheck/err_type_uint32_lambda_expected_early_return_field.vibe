// A struct field of type `(UInt32) -> UInt32` given a lambda with no written
// result type: a `return` inside a `match` arm is checked against `UInt32`.
struct H {
  u: (UInt32) -> UInt32
}

fn make() -> H {
  H::{
    u: (k) -> {
      match k == 0 {
        true => {
          return 4294967296
        },
        false => ()
      }
      1
    }
  }
}
