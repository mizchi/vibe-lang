// #2985 review (Codex P1): a lambda inside the arm that calls `resume(..)`
// CAPTURES the continuation, so the arm is a suspend arm and its value is
// the handle's result; `resume` there is `(op value) -> handle value`. A
// lambda annotated `-> String` around `resume("x")` in an Int-valued handle
// used to type-check as a tail-resumptive arm and then reach codegen with
// the `resume` unbound (an unloadable module); it is now a plain mismatch.
effect Ask {
  Get() -> String
}

fn main() -> Int {
  handle {
    String::length(perform Ask::Get()) + 1
  } with { Ask::Get() => {
    let f = () -> String {
      resume("x")
    }
    f()
  } }
}
