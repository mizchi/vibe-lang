// #3360: a `TaskGroup::run` body passed by name is imported. It keeps a
// handle of its group in its own module's array, which the summary its module
// published records.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { keep_body }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run(keep_body)
  println("r=\{r}")
}
