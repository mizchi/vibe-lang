// #3343 (Codex on #3359): the body's tail is an `if` whose branches each
// build a struct holding a handle. The result check saw only the branches'
// unified nominal type, so this compiled and the handle was joined after its
// group closed; the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

fn main() -> Unit allows Exception + Console {
  let flag = true
  let b = TaskGroup::run((n) -> {
    if flag {
      Box::{ h: TaskGroup::spawn(n, () -> { 41 }) }
    } else {
      Box::{ h: TaskGroup::spawn(n, () -> { 42 }) }
    }
  })
  println("after=\{TaskHandle::join(b.h)}")
}
