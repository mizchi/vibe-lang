// #3601 (Codex on #3605): `pick` infers `T` from a record whose field is
// typed with the erased `with Exception` row, then receives a record whose
// field raises `Exception[Int]`. Had the second record been accepted, the
// erased arm would read the `Int` 7 as a `String`. Rows unify by kind, so the
// two records are refused; this pins that the anonymous-record route is
// closed like the tuple and named-type ones.
fn pick[T](a: T, b: T) -> T {
  b
}

fn safe() -> Int with Exception {
  throw("no")
}

fn bad() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Unit allows Console {
  let r = pick(record { f: safe }, record { f: bad })
  let n = handle {
    let g = r.f
    g()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{n}")
}
