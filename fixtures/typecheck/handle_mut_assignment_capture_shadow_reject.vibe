effect Ask { Get() -> Int }

fn run() -> Int with Ask {
  let mut side = () -> Int { 0 }
  let helper = () -> Int { perform Ask::Get() }
  side = () -> Int { helper() }
  let helper = () -> Int { 0 }
  handle { side() } with { Ask::Get() => resume(42) }
}

export fn main() -> Int {
  handle { run() } with { Ask::Get() => resume(1) }
}
