// #3601: the same `fail`, re-exported by another module and imported under
// another name: the published kind follows the function.
import ../modules/exception_erased_row_mid.vibe {
  fail as boom
}

fn main() -> Unit allows Console {
  let r = handle {
    boom()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
