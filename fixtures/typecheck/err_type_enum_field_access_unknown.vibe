//# #2807: no struct in the program declares `absent`, and the read is still
//# refused HERE rather than in codegen.
//#
//# The same missing arm made `vibe check` and the build disagree: this file was
//# clean under the checker and died at codegen with an unlocated
//# `unknown struct field`. One arm closes both halves.
enum Envelope {
  Sealed;
  Stuffed(Int)
}

export fn main() -> Int {
  let e = Stuffed(7)
  e.absent
}
