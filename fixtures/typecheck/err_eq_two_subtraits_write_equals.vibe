// #3562: two subtraits of `Eq` whose impls for `Box` each write `equals`.
// A caller through `[T: Key]` answered `false` and one through `[T: Mark]`
// `true` for the same two values.
trait Key: Eq {
  tag(Self) -> Int
}

trait Mark: Eq {
  mark(Self) -> Int
}

struct Box[T] {
  v: T
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

impl [T] Mark for Box[T] {
  mark(self) -> Int {
    1
  }
  equals(self, o: Box[T]) -> Bool {
    true
  }
}

fn via_key[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn via_mark[T: Mark](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn answers() -> String {
  let p: Box[Int] = Box::{ v: 1 }
  let q: Box[Int] = Box::{ v: 1 }
  "key=\{via_key(p, q)} mark=\{via_mark(p, q)}"
}
