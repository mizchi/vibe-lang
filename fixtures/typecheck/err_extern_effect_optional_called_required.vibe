// #4082: under the optional grade `allows Greeter?`, a provider may not be
// bound, so a plain call to `Greeter::greet` is refused: `perform?` is the
// call that can answer `NotGranted`.
extern effect Greeter {
  greet(String) -> String
}

fn main() -> Unit allows Console + Greeter? {
  println(Greeter::greet("vibe"))
}
