// #4142: a `while` throws its body's value away wherever it stands, here as
// the function's last expression.
fn fill(m: Map[String, Int], limit: Int) -> Unit {
  let mut i = 0
  while i < limit {
    i = i + 1
    Map::set(m, key = "k", value = i)
  }
}

fn main() -> Int {
  let m: Map[String, Int] = Map::new()
  fill(m = m, limit = 2)
  Map::size(m)
}
