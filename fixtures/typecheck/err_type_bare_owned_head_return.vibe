// A compiler-owned generic head written bare in a signature resolved to a
// wildcard too: a builder of `String` came back as one the caller froze as
// `Array[Int]`, and `+ 1` read the string's pointer (`137438953473`). Only
// region and row slots may be left to the call; the element type may not.
fn mk() -> ArrayBuilder {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, "s")
  b
}

fn main allows Console {
  let b = mk()
  ArrayBuilder::push(b, 1)
  let xs: Array[Int] = ArrayBuilder::freeze(b)
  println("\{Array::get(xs, 0) + 1}")
}
