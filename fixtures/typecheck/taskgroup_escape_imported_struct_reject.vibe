// #3360 (Codex on #3467): a struct that holds the handle carries it into a
// helper that stores the struct. The parameter's type names no region, so it
// was not probed, and the call compiled.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_struct_dep_ok.vibe { Shelf, Slot, shelve }

fn main() -> Unit allows Exception + Console {
  let shelf = Shelf::{ held: None }
  let r = TaskGroup::run((n) -> {
    shelve(shelf, Slot::{ h: TaskGroup::spawn(n, () -> { 41 }) })
    1
  })
  println("r=\{r}")
}
