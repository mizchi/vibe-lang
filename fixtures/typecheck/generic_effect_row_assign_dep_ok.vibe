// #3417: the module `generic_effect_row_assign_import_*` reassign from. The
// row `Box[Name]` reaches the importer as published text, `Box[^Name]`.
export effect Box[T] {
  Put(T) -> Int
}

export struct Name {
  s: String
}

export fn h() -> Int with Box[Name] {
  perform Box::Put(Name::{ s: "a" })
}

export fn h2() -> Int with Box[Name] {
  perform Box::Put(Name::{ s: "b" })
}

export fn hi() -> Int with Box[Int] {
  perform Box::Put(1)
}
