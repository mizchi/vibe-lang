// Codex on #4057 control: the fold accumulator starts as `mine`, declared
// inside `region r`, and is folded inside a nested `region s`. It may hold
// `r`'s value `cell`.
fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine: Array[MutList[Int]] = []
    let got = region s {
      let kept = Array::fold([1, 2], init = mine, f = (acc, x) -> {
        Array::push(acc, value = cell)
        acc
      })
      Array::length(kept)
    }
    got + Array::length(mine)
  }
  println("v=\{v}")
}
