//# #2888: a generic struct's field, bound by a struct PATTERN, kept its type.
//
// `check_pattern`'s `PStruct` arm bound every field at `CtUnknown` without
// reading the struct name, so the binder carried no type and the `Int`
// annotation below constrained nothing. This compiled clean and printed the
// allocation address -- 233, constant across `w: 5` / `99` / `1000`, because
// the field value never participated.
//
// The two neighbours were already correct and are the controls for the fix
// not being too wide: the same formal read through a declared-return helper,
// and the same formal destructured from a TUPLE, were both rejected.

struct Qt {
  w: Int
}

struct Box1[U] {
  value: U
}

fn take[T](a: T) -> Int {
  let r = Box1::{ value: a }
  let v: Int = match r { Box1::{ value } => value }
  v + 1
}

fn main() -> Unit allows Console {
  println(__to_string(take(Qt::{ w: 5 })))
}
