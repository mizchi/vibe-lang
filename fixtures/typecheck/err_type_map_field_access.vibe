//# #2820: a field read on a `StringMap` receiver is refused.
//#
//# `StringMap[V]` has no type of its own -- it resolves to `Map[String, V]`
//# -- so this receiver arrives at the checker's EDot arm as a `CtNamed` with
//# no typedef, which is the arm that tolerates unresolved cross-module names.
//# The refusal tests the compiler's own type-constructor registry at the
//# arity the name was applied with, not the spelling.
//#
//# The message names `Map`, not the `StringMap` the source wrote, and that is
//# the useful answer rather than an approximation of it: `Map::` is the
//# namespace the operations actually live in (`Map::size(mm)` on a
//# `StringMap[Int]`), so `call `Map::v(...)`` is the edit.
fn read(m: StringMap[Int]) -> Int {
  m.v
}

export fn main() -> Int {
  read(Map::from_pairs([("key", 42)]))
}
