// #3488 control (Codex on #3492): a field set from a call whose declared
// result is a scalar copies that scalar, even when the call reads an outer
// binding.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell;
  tag: Int
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn same(x: Int) -> Int {
  x
}

fn main() -> Unit allows Exception + Console {
  let outer_tag = 7
  let r = TaskGroup::run((n) -> {
    let w = Wrap::{ cell: Cell::{ v: None }, tag: same(outer_tag) }
    put(w, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
