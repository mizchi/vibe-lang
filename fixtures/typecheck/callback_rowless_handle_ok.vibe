// #3387: inside a `handle` the lambda performs at the handle's instantiation,
// which is not the enclosing function's, so it is not compared with it.
effect Box[T] {
  Put(T) -> Int
}
fn apply(f: () -> Int) -> Int {
  f()
}
fn caller() -> Int with Box[String] {
  handle {
    apply(() -> {
      perform Box::Put(12345)
    })
  } with { Box::Put(n) => resume(n + 1) }
}
