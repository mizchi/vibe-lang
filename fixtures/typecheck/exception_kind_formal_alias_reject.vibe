// #2985 review (Codex P0): inside `fn f[T]`, the kind `Exception[Array[T]]`
// names the FORMAL even when an import alias spells the same `T`, so
// handing the payload to a function over the imported enum is refused.
// Before, the kind resolved to the enum and `catch_code(41)` compiled and
// trapped inside `hue_code`.
import ./exception_kind_formal_alias_dep.vibe {
  Hue as T, hue_code
}

fn raise_one[T](x: T) -> Int with Exception[Array[T]] {
  throw([x])
}

fn catch_code[T](x: T) -> Int {
  handle {
    raise_one(x)
  } with { Exception[Array[T]]::Throw(e) => hue_code(Array::get(e, 0)) }
}

fn main() -> Int {
  catch_code(41)
}
