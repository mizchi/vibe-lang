// A `derive (Show)` struct with a concrete `StringMap` field. The derived
// renderer routed the field through `__to_string`, so `"\{s}"` printed
// `S { m: <address> }` with `vibe check` clean: the interpolation check
// looks only at a nominal's type arguments, and `S` has none.
struct S {
  m: StringMap[Int]
} derive (Show)

fn show_s() -> String {
  let s = S::{ m: Map::from_pairs([("a", 1)]) }
  "s=\{s}"
}
