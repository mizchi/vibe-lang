// ADR-0120: an omitted optional parameter shifts every labeled argument after
// it, so `first = slot` is written at index 0 but fills formal slot 1. Asked
// of the argument at its written index, slot 1 read `second = 0`, and the
// escaped callback compiled.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](unused?: Int, first: A, second: B) -> Wrapper[A, B] {
  Pair(first, second)
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(slot, _) = escaped
  Array::length(slot.callback())
}
