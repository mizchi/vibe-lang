// #4050 control: a loop over a container declared INSIDE the region may store
// region values in its elements.
// `main` answers 10 * the block's value + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let inner: Array[MutList[Int]] = []
    let ib = [inner]
    for a in ib {
      Array::push(a, value = cell)
    }
    1
  }
  v * 10 + Array::length(outer)
}
