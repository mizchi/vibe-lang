// #3042 (Codex on #3063): an imported value named `Ordering` is not the
// prelude type. Referring to it used to count as using the prelude, and the
// seeded enum then overwrote the import, refusing the call below.
import ./ordering_value_import_dep_ok.vibe { Ordering }

fn main() -> Int {
  Ordering() + 1
}
