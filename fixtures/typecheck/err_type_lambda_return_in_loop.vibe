// A `return` inside a loop of a lambda with no written result type is checked
// against the lambda's result (#4062).
fn ap(f: (Int) -> Int, x: Int) -> Int {
  f(x)
}

fn use() -> Int {
  ap(f = (k) -> {
    let mut i = 0
    while i < 3 {
      if i == k {
        return "found"
      }
      i = i + 1
    }
    -1
  }, x = 1)
}
