// #3387 (Codex on #3407): a generic function whose own row names a
// constructor formal (`Kb[F]` of `put[F[_]](x: F[Int])`), taken as a value
// through a join: `f([1])` performs `Kb` at `Array`, and the `Kb` in scope
// is `Kb[Option]`. Calling `put([1])` directly is refused by the effect pass.
effect Kb[F[_]] {
  Put(F[Int]) -> Int
}
fn put[F[_]](x: F[Int]) -> Int with Kb[F] {
  perform Kb::Put(x)
}
fn caller(c: Bool) -> Int with Kb[Option] {
  let f = if c { put } else { put }
  f([1])
}
