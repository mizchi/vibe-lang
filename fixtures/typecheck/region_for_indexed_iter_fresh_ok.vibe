// #4050 (Codex on #4061): a `for` over a declared indexed iterator binds
// what `C::iter_get` returns, not the iterand. This one hands out a new
// array each step, so writing a region value into it keeps nothing.
// `main` answers 10 * the block's value.
struct Fresh {
  n: Int
}

fn Fresh::iter_length(_ f: Fresh) -> Int {
  f.n
}

fn Fresh::iter_get(_ f: Fresh, i: Int) -> Array[MutList[Int]] {
  []
}

fn main() -> Int allows Exception {
  let xs = Fresh::{ n: 2 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in xs {
      Array::push(a, value = cell)
    }
    1
  }
  v * 10
}
