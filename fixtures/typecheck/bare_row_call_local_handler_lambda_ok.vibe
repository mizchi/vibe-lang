// #3416: a local lambda that handles the `Box` its callback parameter names
// discharges it, as a top-level `run` does, so `mid` does not take `mk`'s
// `Box[Int]` from the callback it passes.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let cb = () -> mk()
  let lrun = (f: () -> Int with Box[Int]) -> Int {
    handle {
      f()
    } with { Box::Put(n) => resume(n + 1) }
  }
  lrun(cb)
}
fn top() -> Int with Box[String] {
  mid()
}
