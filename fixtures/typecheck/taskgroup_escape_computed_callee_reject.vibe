// #3488 (Codex on #3492): a call through a computed callee aliases what its
// arguments do.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap1(c: Cell) -> Wrap {
  Wrap::{ cell: c }
}

fn wrap2(c: Cell) -> Wrap {
  Wrap::{ cell: c }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let flag = true
  let r = TaskGroup::run((n) -> {
    put((if flag {
      wrap1
    } else {
      wrap2
    })(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
