// #4091: a container of the region body linked only with fresh values and
// scalars read from outside it is local, so region values may be stored in it
// and in its elements.

let label: String = "x"

fn main() -> Int allows Exception {
  let width = 3
  let v = region r {
    let c = MutList::empty(r)
    let rows: Array[Array[MutList[Int]]] = []
    for i in [0, 1] {
      let row: Array[MutList[Int]] = []
      Array::push(row, value = MutList::empty(r))
      Array::push(rows, value = row)
      let _ = i + width + String::length(label)
    }
    Array::push(Array::get(rows, at = 0), value = c)
    Array::length(rows)
  }
  v
}
