// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The closure-returning method is called by its qualified name
// (`Factory::mk(fac)`); handle_bound_closure_method_result_reject is the
// method-call spelling.
effect Ask {
  Get() -> Int
}

struct Factory {
  k: Int
}

fn Factory::mk(self: Factory) -> (() -> Int) with Ask {
  () -> perform Ask::Get() + self.k
}

fn main() -> Unit allows Console {
  let fac = Factory::{ k: 1 }
  let g = handle {
    Factory::mk(fac)
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
