//# #2762: an aggregate `export { }` naming something this module neither
//# declares nor imports is REFUSED.
//#
//# Before the fix the two lanes disagreed about whether this is a program.
//# Measured 2026-09-15 against a stage2 built from main at f8d0b24:
//#
//# | lane | result |
//# |---|---|
//# | `VIBE_CHECK_ONLY=1` | clean, exit 0, output written |
//# | the same plus the invalidation trace | `exported name missing from checked environment: <the name below>`, exit 1, no output |
//#
//# The export silently became a no-op, and a consumer that imported the
//# promised name was told `line 3:3: imported name '...' is not exported by
//# './dep.vibe'` -- a diagnostic pointing at its OWN import rather than at the
//# module that promised the name.
//#
//# The prose above deliberately does NOT spell the exported identifier. The
//# refusal's position comes from `locate_type_error_heuristic`'s
//# first-occurrence scan (`SExport` carries no offset), so a mention up here
//# would claim it -- measured, `line 10:95`, inside this comment.

export {
  NotDeclaredAnywhere
}

export fn main() -> Int {
  1
}

//# Imported by `export_aggregate_importer_refused.vibe`, whose row asserts that
//# the diagnostic names THIS module and not the importer.
export fn mk() -> Int {
  2
}
