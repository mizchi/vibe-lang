//# #3026: the dependency's kind `Err` is private, so it is not among the
//# declarations the dependency publishes -- and it is still a different type
//# from this module's `Err`. An exception kind is never a type parameter (that
//# is refused where the kind is written), so its name counts without a
//# published declaration to confirm it.
import ./foreign_type_name_private_dep.vibe { fail_private }

struct Err {
  name: String
}

fn relay() -> Int with Exception[Err] {
  fail_private()
}

fn main() -> Unit {
  let _ = handle {
    relay()
  } with {
    Exception[Err]::Throw(e) => String::length(e.name)
  }
}
