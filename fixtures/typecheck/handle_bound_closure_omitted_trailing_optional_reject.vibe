// A labeled closure argument is followed by an omitted optional parameter, so
// the callee's type has one parameter more than the call writes -- the shape
// a method's receiver also has. Read as a receiver shift, the closure took
// `unused`'s `Option[Int]`, no function could be kept there, and the `Log` it
// performs escaped the `handle` with no diagnostic (Codex on #3844).
effect Ask {
  Get() -> Int
}

effect Log {
  Put(n: Int) -> Unit
}

let kept: Array[() -> Int with Ask] = []

fn keep(f: () -> Int with Ask, unused?: Int) -> Unit {
  let _ = unused
  Array::push(kept, value = f)
}

fn main() -> Unit allows Console {
  let n = handle {
    keep(f = () -> {
      let v = perform Ask::Get()
      perform Log::Put(v)
      v
    })
    1
  } with {
    Ask::Get() => resume(5);
    Log::Put(_) => resume(())
  }
  println("\{n}")
}
