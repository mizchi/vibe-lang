//# #3297: the same refusal over a type-CONSTRUCTOR variable. `x` has type
//# `F[Int]` with `F` quantified by the `let`, so `cmp` serves both an `Array`
//# and an `Option` caller with one body. Measured before the refusal, both
//# calls below answered `false` for equal values.
enum K[T, F[_]] {
  A(T);
  B(F[Int])
}

export fn main() -> Int {
  let cmp = (x, y) -> B(x) == B(y)
  if cmp([1, 2], [1, 2]) && cmp(Some(1), Some(1)) {
    1
  } else {
    0
  }
}
