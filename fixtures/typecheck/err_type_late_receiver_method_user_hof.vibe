//# #4037: the same through a program higher-order function.
struct Counter {
  n: Int
}

fn Counter::size(c: Counter) -> Int {
  c.n
}

fn Counter::add(c: Counter, k: Int) -> Int {
  c.n + k
}

fn apply(c: Counter, f: (Counter) -> Int) -> Int {
  f(c)
}

fn main() -> Int {
  apply(c = Counter::{ n: 3 }, f = (c) -> c.size(1, 2))
}
