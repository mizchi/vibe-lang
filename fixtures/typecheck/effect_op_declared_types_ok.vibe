// #4018: what an effect operation's signature may name -- the effect's own
// type parameters (a kinded one included), builtin types, and types this file
// declares, BEFORE or AFTER the effect (a later alias too: aliases are not
// preclaimed, so the check runs once every declaration is in place).
struct Before {
  n: Int
}

effect Gen[T, F[_]] {
  Get(T, F[Int]) -> Later;
  Put(Al, Map[String, Int], Bytes, Float64) -> Option[Array[T]];
  Both(Before, (Int, String), (Bool) -> Char) -> Unit
}

effect Plain {
  Ask(Later, Al) -> Before
}

type Al = Array[Int]

struct Later {
  n: Int
}

fn ask() -> Int with Plain {
  let b = perform Plain::Ask(Later::{ n: 1 }, [2, 3])
  b.n
}
