// #3311: a method's callback parameter fixes the instantiation the same way
// a function's does.
effect Box[T] {
  Put(T) -> Int
}

struct Runner {
  base: Int
}

fn Runner::go(r: Runner, f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(s) => resume(r.base + String::length(s))
  }
}

fn producer() -> Int with Box {
  let r = Runner::{ base: 1 }
  r.go(() -> {
    perform Box::Put(1)
  })
}
