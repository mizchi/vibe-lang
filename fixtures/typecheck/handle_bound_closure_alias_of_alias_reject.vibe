// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It throws through an alias of an alias of a throwing
// function.
// fixtures/handle_bound_closure_inside_test.vibe runs the alias called
// inside.
fn boom() -> Int with Exception[String] {
  throw("x")
  1
}

fn main() -> Unit allows Console {
  let g = handle {
    let f = boom
    let f2 = f
    () -> f2() + 1
  } with { Exception[String]::Throw(_) => () -> 0 }
  println("g=\{g()}")
}
