// #3493: provisional inference preserves an earlier deferred field check.
struct Holder { payload: String }
let xs = []
fn read() -> Int {
  Array::get(xs, at = 0).payload
}
let rec touch = (v) -> Unit {
  Array::push(xs, value = Holder::{ payload: "bad" })
  if false {
    touch(v = v)
  } else {
    ()
  }
}
fn main() -> Int {
  touch(v = 0)
  read()
}
