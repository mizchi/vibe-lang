// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The closure-returning method is the last of a chain
// (`fac.me().mk()`). `g()` answered `6` from the dead handler after
// `vibe check` was clean.
effect Ask {
  Get() -> Int
}

struct Factory {
  k: Int
}

fn Factory::mk(self: Factory) -> (() -> Int) with Ask {
  () -> perform Ask::Get() + self.k
}

fn Factory::me(self: Factory) -> Factory {
  self
}

fn main() -> Unit allows Console {
  let fac = Factory::{ k: 1 }
  let g = handle {
    fac.me().mk()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
