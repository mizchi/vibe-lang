// #3642: a struct with no iteration protocol is refused in `for` whether its
// type is spelled with its own name or through a `type` alias. Through the
// alias the loop used to compile and run zero times, answering 0.
struct Countdown {
  n: Int
}

type C = Countdown

fn main allows Console {
  let c: C = Countdown::{ n: 4 }
  let mut acc = 0
  for x in c {
    acc = acc + x
  }
  println("alias = \{acc}")
}
