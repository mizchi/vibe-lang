// #3518: `TaskGroup::spawn[.., T: Send]`'s result crosses to the joining task,
// and a closure is not Send. The task closure's row differs from the
// parameter's `Exception + e`, so the parameter was unified only by the
// effect-stripped retry, whose substitution was thrown away: `T` stayed an
// open variable, the bound check skipped it, and this program checked clean
// and printed 2.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Int allows Exception {
  TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> {
      (x: Int) -> x + 1
    })
    let g = TaskHandle::join(h)
    g(1)
  })
}
