// ADR-0088: a test artifact runs with full authority, so a `perform?` written
// directly in a block advertises a `NotGranted` arm that can never run; it is
// refused with the two edits (Codex review on PR #2653). A helper that
// requires `with Fs::read_file?` and performs there is the honest shape.
test "asks optionally" allows Fs::read_file? {
  let _ = perform? Fs::read_file("x")
  assert(true)
}
