// #3318: a type parameter the row names is chosen by the caller's handler,
// so the body must not fix it. `perform Box::Put(1)` made `T` an `Int`, the
// row still said `Box[T]`, and a handler at `String` read the `Int` as a
// string (`String::length` answered `2`).
effect Box[T] {
  Put(T) -> Int
}

fn f[T]() -> Int with Box[T] {
  perform Box::Put(1)
}

fn main() -> Int {
  handle {
    f()
  } with {
    Box::Put(v) => resume(String::length(v))
  }
}
