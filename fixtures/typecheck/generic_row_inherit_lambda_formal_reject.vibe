// #3095: a generic lambda with no row of its own inherits the enclosing row,
// but its body still runs at its own `T`: `get(y)` requires `State[T]`, which
// `with State[String]` does not cover.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller() -> Int with State[String] {
  let f = [T](y: T) -> Int {
    get(y)
  }
  f(1)
}
