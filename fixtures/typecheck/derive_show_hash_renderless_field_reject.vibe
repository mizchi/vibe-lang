// #3567: a `derive (Show)` type holding a `derive (Hash)` type whose own field
// has no renderer. `derive (Hash)` implies a renderer only when it can render
// every field; `Outer`'s would call `Inner::to_string`, which does not exist,
// so `Outer` has none, and `Top`'s renderer is refused at `Top`, naming the
// edit, rather than stopping in code generation.
struct Inner {
  n: Int
}

impl Hash for Inner {
  hash_key(self: Inner) -> String {
    "i" + Int::to_string(self.n)
  }
}

struct Outer {
  i: Inner
} derive (Hash)

struct Top {
  o: Outer
} derive (Show)
