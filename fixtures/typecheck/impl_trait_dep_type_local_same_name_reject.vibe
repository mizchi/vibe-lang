// #3551 review: this module's own `Hidden` is not the dependency's, though
// both are spelled `Hidden`. The impl was checked against the trait by
// spelling and accepted; `call_it` then handed it the dependency's `Hidden`
// and `x.n` read its `String` field (measured on bcc090da5: `k=hellok=`).
import ./impl_trait_dep_type_dep_ok.vibe {
  call_it, trait Tr
}

struct Hidden {
  n: Int
}

struct P {
  k: Int
}

impl Tr for P {
  make(x: Hidden) -> P {
    P::{ k: x.n + 1 }
  }
  show(self) -> String {
    "k=\{self.k}"
  }
}

fn main allows Console {
  println(call_it(P::{ k: 0 }))
}
