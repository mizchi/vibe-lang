// #3311 (Codex on #3340): a function type around a callee formal the call
// fixes. `Fn1[T]` is `(T) -> Int`, and `x: 41` makes it `(Int) -> Int` for
// this call, so the lambda may not perform a `(String) -> Int`. Before, a
// function-typed instantiation was never handed over, so this checked clean.
effect Box[T] {
  Put(T) -> Int
}

type Fn1[A] = (A) -> Int

fn run_g[T](x: T, f: () -> Int with Box[Fn1[T]]) -> Int {
  handle {
    f()
  } with {
    Box::Put(m) => resume(m(x))
  }
}

fn producer() -> Int with Box[Fn1[Int]] {
  run_g(41, () -> {
    perform Box::Put((s: String) -> Int { String::length(s) })
  })
}
