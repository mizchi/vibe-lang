// #3601: `wrap` calls the imported `fail` under its own erased row, so its
// module publishes the kind for `wrap` too.
import ../modules/exception_erased_row_mid.vibe {
  wrap
}

fn main() -> Unit allows Console {
  let r = handle {
    wrap()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
