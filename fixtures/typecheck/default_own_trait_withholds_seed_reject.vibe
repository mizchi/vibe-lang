// #3187: a program that declares its OWN `Default` gets only its own impls.
// The prelude's `impl Default for Double` must not satisfy this trait: here
// it has a method, and a seeded row would send `T::default()` at `Double` to
// a `Double::default` nobody wrote. So the seeded `Default` rows are withheld
// whenever a `Default` is declared in the program or arrives by import.
trait Default {
  default() -> Self
}

impl Default for Int {
  default() -> Int {
    0
  }
}

fn fresh[T: Default](witness: T) -> T {
  T::default()
}

fn main() -> Int {
  let d = fresh(1.5)
  if d > 1.0 {
    1
  } else {
    fresh(3)
  }
}
