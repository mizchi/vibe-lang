// #3564: a `derive (Show)` struct with a plain `Map` field. Interpolating a
// `Map` itself is refused (it has no text form), so the derived renderer has
// nothing to render it with; before #3551 it printed `S { m: <address> }`.
struct S {
  m: Map[String, Int]
} derive (Show)

fn show_s() -> String {
  let m: Map[String, Int] = Map::new()
  let s = S::{ m: Map::set(m, "a", 1) }
  "s=\{s}"
}
