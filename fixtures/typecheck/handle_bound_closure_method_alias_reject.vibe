// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It throws through a local alias of a method.
// fixtures/handle_bound_closure_inside_test.vibe runs the alias called
// inside.
struct Foo {
  n: Int
}

fn Foo::boom(self: Foo) -> Int with Exception[String] {
  throw("x")
  self.n
}

fn main() -> Unit allows Console {
  let foo = Foo::{ n: 1 }
  let g = handle {
    let m = Foo::boom
    () -> m(foo) + 1
  } with { Exception[String]::Throw(_) => () -> 0 }
  println("g=\{g()}")
}
