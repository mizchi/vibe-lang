// #3547: an unannotated fold callback over `Double` values. Its parameters
// are not typed `Double` from the call (the lowering chooses float arithmetic
// from a parameter's spelling, so an unannotated `acc + s` would add two
// boxed values as integers), and `+` typed them `Int`. The refusal used to
// read backwards ("expected (Double, Double) -> Double, got (Int, Int) ->
// Int"); it now leads with the annotation that fixes it.
import @vibe/builtin {
  trait Iterator
}

fn total(ds: Array[Double]) -> Double {
  Iterator::fold(ds, 0.0, (acc, s) -> acc + s)
}
