// #4091: a getter returns a module-level array, and a binding of the region body
// holds the result. The check read the call's result through its arguments
// only, found none, and took the binding for a fresh local, so the push kept
// the region's `MutList` in `kept` after the region closed.

let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let s = get_sink()
    Array::push(s, value = a)
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
