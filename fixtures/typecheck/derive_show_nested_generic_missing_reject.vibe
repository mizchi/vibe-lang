// #3591: the derived renderer inlines a `derive (Show)` generic at its
// instantiation, so `Box[Set[Int]]` renders its `v: T` field as a `Set[Int]`,
// through `Set::to_string`, which `Set` does not provide. This was reported
// clean and the build stopped with an internal compiler error. It is refused at
// `ViaGeneric` now, naming the edit.
import @vibe/core { struct Set }

struct Box[T] {
  v: T
} derive (Show)

struct ViaGeneric {
  b: Box[Set[Int]]
} derive (Show)
