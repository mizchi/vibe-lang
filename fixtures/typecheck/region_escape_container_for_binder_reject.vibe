// #4091: a container that an outer array was pushed into yields that array to
// a `for` over it.

let sink: Array[MutList[Int]] = []

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    Array::push(init, value = sink)
    for bx in init {
      Array::push(bx, value = c)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
