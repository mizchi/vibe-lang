// #3387 route 1 as the issue wrote it, #3405: `Wrap` is not imported, so the
// struct literal names a type this module cannot see. It used to be typed
// unknown, which unified with any row, and the program checked clean.
import ./callback_row_extracted_generic_dep_ok.vibe {
  effect Box, run_wrap
}
fn caller(c: Bool) -> Int with Box {
  let f = if c { run_wrap } else { run_wrap }
  f("abc", () -> {
    perform Box::Put(Wrap::{ v: 12345 })
  }, String::length)
}
