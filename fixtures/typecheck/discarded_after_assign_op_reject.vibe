// #4146: a value thrown away after a compound assignment (`+=`), at the tail
// of a `while` body. Its own row, so a walk that stopped following `+=`
// fails here instead of being covered by the plain-assignment fixture.
fn spin() -> Int {
  let mut n = 0
  while n < 3 {
    n += 1
    Array::get([1, 2], at = 0)
  }
  n
}
