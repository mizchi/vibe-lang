//# #2807: the refusal does not depend on the field's declared type lining up.
//#
//# `Tagged` declares `label: String`, and the tolerated read took that type on
//# faith: `String::length` was handed the enum's tagged integer and read it as
//# a `(ptr|len)` string, answering `14` for `Carton::Boxed(7)`.
struct Tagged {
  label: String
}

enum Carton {
  Bare;
  Boxed(Int)
}

export fn main() -> Int {
  let c = Boxed(7)
  String::length(c.label)
}
