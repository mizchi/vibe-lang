import @vibe/concurrent {
  TaskGroup, TaskHandle
}
struct Box[T] { mut v: Option[T] }
fn main() -> Int allows Exception {
  let result = TaskGroup::run((g) -> {
    let b: Box[TaskHandle[Int]] = Box::{ v: None }
    let _ = {
      match Some(b) {
        Some(b) => {
          b.v = Some(TaskGroup::spawn(g, () -> 42))
          match b.v {
            Some(h) => TaskHandle::join(h),
            None => 0
          }
        },
        None => 0
      }
    }
    b
  })
  match result.v {
    None => 42,
    Some(_) => 0
  }
}
