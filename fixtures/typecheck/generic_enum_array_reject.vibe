//# #3326: a generic ENUM applied to `X` does not accept an `Array[X]` either,
// and neither does the reverse direction (an applied generic value where an
// `Array` is declared). Both compiled clean before.

enum Wrap[T] {
  W(T);
  Empty
}

struct Cell[T] {
  value: T
}

fn total(xs: Array[Int]) -> Int {
  Array::length(xs)
}

fn main() -> Unit allows Console {
  let w: Wrap[Int] = [1]
  println(__to_string(total(Cell::{ value: 1 })))
}
