// #3045: what an empty row promises. It excludes host capabilities and
// algebraic effects; it does NOT exclude mutating values reachable from the
// arguments. This compiles, and the caller's array grows.
fn grow(xs: Array[Int]) -> Unit {
  Array::push(xs, 9)
}

fn size_after_grow() -> Int {
  let ys = [1, 2]
  grow(ys)
  Array::length(ys)
}
