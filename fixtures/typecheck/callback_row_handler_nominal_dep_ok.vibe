// #3372: published own-row nominals and indexed arguments retain handler authority.
export effect Box[T] {
  Put(T) -> Int
}
export struct Pt { x: Int }
export enum Shade {
  Light
}
export struct Wrap[T] { v: T }
export fn producer() -> Int with Box[Pt] {
  perform Box::Put(Pt::{ x: 42 })
}
export fn enum_producer() -> Int with Box[Shade] {
  perform Box::Put(Light)
}
export fn use_pt(p: Pt) -> Int {
  p.x
}
export fn use_shade(s: Shade) -> Int {
  match s {
    Light => 42
  }
}
export fn array_producer() -> Int with Box[Array[Pt]] {
  perform Box::Put([Pt::{ x: 42 }])
}
export fn generic_producer[T](x: T) -> Int with Box[Wrap[T]] {
  perform Box::Put(Wrap::{ v: x })
}
