// #2334: the same refusal when the call comes BEFORE the generic function it
// instantiates, and through a generic caller: `outer`'s `K` reaches `look`'s
// map key, so `outer(m, 'x')` is refused too.
fn main {
  let m: Map[Char, Int] = Map::set(Map::new(), 'x', 10)
  let _ = outer(m, 'x')
  ()
}

fn outer[K](m: Map[K, Int], k: K) -> Int {
  look(m, k)
}

fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}
