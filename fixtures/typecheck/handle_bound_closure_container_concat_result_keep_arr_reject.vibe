// #4088: `Array::concat` stores nothing into its arguments, but its result
// holds every element of both, so keeping the result of a concat with an
// array holding a handle-bound closure is refused.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let arr: Array[() -> Int] = []
    let other = [plain]
    Array::push(arr, value = g)
    let both = Array::concat(other, arr)
    let _ = keep_arr(xs = Array::reverse(both))
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()} \{plain()}")
}
