// #3541: an erased `with Exception` row does not absorb a callee's
// `Exception[Int]`: it carries only the thrown message, so the caller's
// erased arm read the Int 7 as a String (`len=14`). The kind stays in the
// row (`with Exception[Int]`).
fn f() -> Int with Exception[Int] {
  throw(7)
}

fn h() -> Int with Exception {
  f()
}

fn main allows Console {
  let r = handle { h() } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
