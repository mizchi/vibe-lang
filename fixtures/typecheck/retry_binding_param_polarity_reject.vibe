// #3518 review: `T` occurs only in parameter positions of the function
// assigned to `f: (T, T) -> Int` -- a `Log` callback and a `Tick` one. A join
// made `T` a `Log + Tick` callback, which the generic body could hand to the
// `Log`-only parameter. The rows differ, and the argument is refused with the
// edit.
effect Log {
  Emit(Int) -> Unit
}

effect Tick {
  Bump() -> Unit
}

fn both(a: () -> Int with Log, b: () -> Int with Tick) -> Int {
  0
}

fn take[T, e](f: (T, T) -> Int with Exception + e) -> Int {
  0
}

fn main() -> Int allows Exception {
  take(both)
}
