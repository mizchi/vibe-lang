// #3621, Codex on #3620: an alias under an annotation (`let a: () -> Int =
// g`) passed at a row-typed parameter is refused like a bare alias
// (fixtures/typecheck/slot_row_local_alias_refused.vibe); it trapped after a
// clean `vibe check`.
effect Box[T] {
  Put(T) -> Unit
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let a: () -> Int = g
  drive(a) + drive(tick)
}
