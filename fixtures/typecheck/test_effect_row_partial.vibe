// #1508: a declared row is not a blanket exemption -- what it does not name is
// still reported. Here `Http::close` is missing from the row.
test "partial row" allows Http::request {
  let r = Http::request("GET", url = "http://127.0.0.1:1/", headers = "", body = "")
  Http::close(r)
  assert(true)
}
