// #3958: two sibling modules implement `Value` for `Note`, one as
// `Value[Alias]` with `type Alias = Int` PRIVATE to it, one as `Value[Int]`.
// The linked program held both, and a call through either module dispatched
// to one of them for both callers; it is refused as an overlap, as with the
// exported alias (err_impl_overlap_alias_siblings.vibe).
import ./impl_overlap_private_alias_a_dep_ok.vibe {
  from_private_a
}

import ./impl_overlap_alias_b_dep_ok.vibe {
  from_b
}

fn main allows Console {
  println("\{from_private_a() * 10 + from_b()}")
}
