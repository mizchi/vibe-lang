// #3958: two sibling modules implement `Value` for `Note`, one as
// `Value[Alias]` through a PRIVATE `type Alias = Int`, one as `Value[Int]`.
// The linked program printed `22` -- the `Value[Alias]` module's caller ran
// the other module's impl -- because the linker had renamed the private alias
// before the coherence check read the key. It is refused as an overlap, the
// way the exported-alias pair (err_impl_overlap_alias_siblings.vibe) is.
import ./impl_overlap_private_alias_a_dep_ok.vibe {
  from_a
}

import ./impl_overlap_alias_b_dep_ok.vibe {
  from_b
}

fn main allows Console {
  println("\{from_a() * 10 + from_b()}")
}
