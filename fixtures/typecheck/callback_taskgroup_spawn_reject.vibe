// #3387 (Codex on #3407): a spawned task's row forwards the enclosing
// effects through a row variable, so its `perform Box::Put(12345)` reaches the
// `Box[String]` of the function the group runs in.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}
effect Box[T] {
  Put(T) -> Int
}
fn caller() -> Int with Box[String] + Exception {
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> {
      perform Box::Put(12345)
    })
    TaskHandle::join(h)
  })
}
