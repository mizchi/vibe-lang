// #3493: a forward value use is checked at its inferred binding type.
struct LocalHelper { greet: (String) -> Int }
fn make_helper() -> LocalHelper {
  LocalHelper::{ greet: (name) -> 5 }
}
fn early() -> String {
  helper.greet("x")
}
let helper = make_helper()
fn main() -> Int {
  String::length(early())
}
