//# #2848, the other half: NO struct declares the field. Before the fix this
//# was clean in `vibe check` (empty output, exit 0) and died in the build with
//# an unlocated `unknown struct field: v` -- a message that asserts the
//# receiver is a struct whose field list lacks `v`, when the receiver is a type
//# parameter that has no fields under any instantiation. The refusal is keyed
//# on the RECEIVER being a formal, not on whether some struct happens to spell
//# the field, so both halves get the same located message.
fn read[T](m: T) -> Int {
  m.v
}

export fn main() -> Int {
  read(3)
}
