// #3575: an open row meets another open row. `Console + e` given a value of
// `Console + Fs + f` binds `e := Fs + f`; given `Fs + f`, which lacks the
// slot's `Console`, it widens `e` to `Fs + f`. Each caller declares the row
// the call resolves to.
fn call(f: () -> Int with Console + e) -> Int with Console + e {
  f()
}

fn superset(g: () -> Int with Console + Fs + f) -> Int with Console + Fs + f {
  call(g)
}

fn narrower(g: () -> Int with Fs + f) -> Int with Console + Fs + f {
  call(g)
}

fn reads() -> Int with Fs {
  String::length(Fs::read_file("open_row_open_value_ok.txt"))
}

fn main() -> Unit allows Console + Fs {
  println("\{superset(reads) + narrower(reads)}")
}
