// #3416: a returned closure is excused only for the labels its declared row
// names exactly. It performs `Box[Int]` but declares `Box[String]`, so
// `mid` keeps `Box[Int]` and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> (() -> Int with Box[String]) with Box {
  () -> mk()
}
fn caller() -> Int with Box[String] {
  let f = mid()
  f()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
