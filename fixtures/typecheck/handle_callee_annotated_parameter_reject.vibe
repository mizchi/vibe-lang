effect Ask {
  Get() -> Int
}

fn ask_once() -> Int with Ask {
  perform Ask::Get()
}

fn run(cb: () -> Int with Ask) -> Int with Ask {
  let f: () -> Int with Ask = cb
  handle { f() } with { Ask::Get() => resume(1) }
}

export fn main() -> Int {
  handle { run(ask_once) } with { Ask::Get() => resume(2) }
}
