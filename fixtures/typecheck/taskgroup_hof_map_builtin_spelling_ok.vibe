// #3255 control: a program `fn Array::push` that keeps nothing, called
// inside a closure handed to `Array::map`, is judged by its body, as it is in
// `for h in hs`. The callback re-check used to take the builtin's answer for
// the spelling and refuse it as a container write.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn Array::push(_ xs: Array[TaskHandle[Int]], value: TaskHandle[Int]) -> Int {
  let _ = xs
  let _ = value
  1
}

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, f = () -> { 41 })]
    let got = Array::map(hs, f = (h) -> Array::push(outer, value = h))
    Array::get(got, at = 0)
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
