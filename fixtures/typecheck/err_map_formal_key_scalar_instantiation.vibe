// #2334: a generic body is lowered once, with the String key operations, so a
// call that instantiates its map-key parameter at `Int` is refused at the call
// rather than hash the number as a String pointer.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}

fn main {
  let m: Map[Int, Int] = Map::set(Map::new(), 1, 10)
  let _ = look(m, 1)
  ()
}
