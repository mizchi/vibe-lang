// #2983 (2): an effectset is not a type, so it cannot be an exception kind.
// `Exception[IoErrors]` used to be accepted as a label that discharged
// nothing, and the hint then suggested declaring it.
enum NotFound {
  NotFound(String)
}

enum Denied {
  Denied(Int)
}

effectset IoErrors = { Exception[NotFound], Exception[Denied] }

fn f() -> Int with IoErrors {
  throw(NotFound("x"))
}

fn main() -> Int {
  handle { f() } with { Exception[IoErrors]::Throw(_) => 0 }
}
