//# #2762 green side: a compiler-provided name. This is the shape
//# `lib/@vibe/builtin/option.vibe` opens with -- the module declares nothing
//# called `Option` and publishes its declaration authority anyway -- so a
//# refusal that only consulted the module's own statements would reject the
//# builtin package.

export {
  Option
}

export fn main() -> Int {
  1
}
