// #3551 review: a field only an unusable written `hash_key` could key is
// refused, also when an impl keys another application of the type
// (`impl Hash for Box[Int]` beside `fn Box::hash_key(x: Int)`). The accepted
// side is `derive_hash_applied_beside_unusable_test.vibe`.
import @vibe/core {
  has_by
}

struct Box[T] {
  v: T
} derive (Show)

fn Box::hash_key(x: Int) -> String {
  "n" + Int::to_string(x)
}

impl Hash for Box[Int] {
  hash_key(self) -> String {
    let b: Box[Int] = self
    "b" + Int::to_string(b.v)
  }
}

struct Outer {
  b: Box[String]
} derive (Hash)

fn main() -> Unit allows Console {
  println(Outer::hash_key(Outer::{ b: Box::{ v: "x" } }))
}
