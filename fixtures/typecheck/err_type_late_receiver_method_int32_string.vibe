//# #4037 (Codex on #4046): the refused control for the Int32 literal
//# adaptation. An integer literal takes a late-resolved method's `Int32`
//# parameter (#3730), but a string does not.
struct Counter {
  n: Int
}

fn Counter::add(c: Counter, k: Int32) -> Int {
  c.n
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }]
  Array::length(Array::map(xs, f = (c) -> c.add(k = "x")))
}
