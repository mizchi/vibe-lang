// #3408: the edit the refusal of a generic function passed by name names:
// a lambda that calls it at `Int` fixes `mk`'s `Box[T]` at `Box[Int]`, which
// the caller covers.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn pass(f: (Int) -> Int with Box) -> Int with Box {
  f(12345)
}
fn mid() -> Int with Box {
  pass((x: Int) -> mk(x))
}
fn top() -> Int with Box[Int] {
  mid()
}
