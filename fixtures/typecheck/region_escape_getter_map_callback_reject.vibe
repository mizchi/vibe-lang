// #4091: an element callback over a getter's result receives module storage,
// so a write into its parameter keeps the region value after the region.

let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

let boxes_top: Array[Array[MutList[Int]]] = [kept]

fn get_boxes() -> Array[Array[MutList[Int]]] {
  boxes_top
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let _ = Array::map(get_boxes(), f = (bx) -> {
      Array::push(bx, value = a)
      0
    })
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
