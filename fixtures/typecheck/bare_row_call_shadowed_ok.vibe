// #3408 (Codex on #3409): `mid` calls its own local `mk`, which shadows the
// top-level one, so it does not take the top-level `mk`'s `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let mk = () -> 1
  mk()
}
fn top() -> Int with Box[String] {
  mid()
}
