// #3360 (Codex on #3467): a module that declares (private) structs named
// `TaskGroup` and `TaskHandle` is not the runtime. Only the methods of the
// types it declares are exempt from publishing what they keep; its free
// helper `hold` still does.
struct TaskGroup {
  id: Int
}

struct TaskHandle {
  id: Int
}

export struct Slot[T] {
  mut v: Option[T]
}

export fn hold[T](s: Slot[T], x: T) -> Unit {
  s.v = Some(x)
}
