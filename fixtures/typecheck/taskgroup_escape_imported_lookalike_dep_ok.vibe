// #3360 (Codex on #3467): a module that declares (private) structs named
// `TaskGroup` and `TaskHandle` is not the runtime, which is recognized by its
// path. Its free helper `hold` and its `Task::hold` -- a method of a type the
// runtime also names -- both publish what they keep.
struct TaskGroup {
  id: Int
}

struct TaskHandle {
  id: Int
}

export struct Slot[T] {
  mut v: Option[T]
}

export fn hold[T](s: Slot[T], x: T) -> Unit {
  s.v = Some(x)
}

export struct Task {
  id: Int
}

export fn Task::hold[T](s: Slot[T], x: T) -> Unit {
  s.v = Some(x)
}
