// #3372: the published callback's payload is itself an effectful function.
export effect Box[T] {
  Put(T) -> Int
}
export effect Inner[T] {
  Put(T) -> Int
}
export struct Pt { x: Int }
export type Work = () -> Int with Inner[Pt]

export fn use_inner(g: () -> Int with Inner[Pt]) -> Int {
  handle {
    g()
  } with { Inner::Put(p) => {
    let q: Pt = p; resume(q.x)
  } }
}

export fn run_nested(f: () -> Int with Box[Work]) -> Int {
  handle {
    f()
  } with { Box::Put(g) => resume(use_inner(g)) }
}
