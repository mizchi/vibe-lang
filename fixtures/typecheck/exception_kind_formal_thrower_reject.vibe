// #3002: a row item is never substituted at a call site, so an exception kind
// naming a type parameter is refused where it is written.
fn boom[T](x: T) -> Int with Exception[T] {
  throw(x)
}

fn main() -> Unit allows Stdout {
  let r = handle { boom("abc") } with { Exception[String]::Throw(e) => String::length(e) }
  println("r=\{r}")
}
