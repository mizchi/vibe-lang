// A lambda with no written result type whose `return` and final value have
// different types is refused, not typed by its final value alone (#4062).
// Before, `ap(f = ..)` compiled and handed `ap` a string as an `Int`.
fn ap(f: (Int) -> Int, x: Int) -> Int {
  f(x)
}

fn use() -> Int {
  ap(f = (k) -> {
    if k == 0 {
      return "oops"
    }
    k
  }, x = 0)
}
