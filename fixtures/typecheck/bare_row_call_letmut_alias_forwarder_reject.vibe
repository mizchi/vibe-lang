// #3416 (Codex on #3436): `let mut h = pass` calls `pass`, whose own row
// names `Box`, so it forwards its callback's `Box[Int]`; `mid` requires it
// and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn pass(f: () -> Int with Box[Int]) -> Int with Box[Int] {
  f()
}
fn mid() -> Int with Box {
  let mut h = pass
  h(() -> mk())
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
