// #3596: a conditional alias stands for every declaration a branch names.
// `mk_ok`'s field closure does not throw, but `mk`'s does, and either may be
// the one called.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn mk_ok() -> Box with Exception[Int] {
  Box::{ f: () -> 1 }
}

fn pick(c: Bool) -> Int {
  let g = if c {
    mk_ok
  } else {
    mk
  }
  let b = handle {
    g()
  } with { Exception[Int]::Throw(n) => Box::{ f: () -> n } }
  let f = b.f
  f()
}

fn main() -> Unit allows Console {
  println("\{pick(false)}")
}
