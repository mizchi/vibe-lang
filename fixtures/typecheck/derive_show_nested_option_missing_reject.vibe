// #3591: `derive (Show)` renders an `Option` field through its payload, so
// `v: Option[Set[Int]]` goes through `Set::to_string`, which `Set` does not
// provide. Only a bare `v: Set[Int]` was refused (#3073); this one was
// reported clean and the build stopped with an internal compiler error
// (`Set::to_string` reached code generation unresolved). It is refused at `S`
// now, naming the edit.
import @vibe/core { struct Set }

struct S {
  v: Option[Set[Int]]
} derive (Show)
