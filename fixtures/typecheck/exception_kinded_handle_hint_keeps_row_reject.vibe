// #2975 follow-up (Codex on #3021): a kinded handle strips the function's own
// exception labels from its body's row for the exactness check. The hint for
// a missing non-exception effect in that body must still carry them -- it
// used to suggest `with Log`, dropping the `Exception` the function declares.
effect Log {
  Emit(String) -> Unit
}

fn logs() -> Int with Log {
  perform Log::Emit("x")
  1
}

fn f() -> Int with Exception {
  handle { logs() } with { Exception[String]::Throw(_) => 0 }
}

fn main() -> Int {
  handle { f() } with { Exception::Throw(_) => 0 }
}
