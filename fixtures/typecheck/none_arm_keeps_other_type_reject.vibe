//# #3149: `None` is `Option[?a]` with a fresh `?a`, not `Option[unknown]`. A
//# `match` whose first arm was `None` typed as `Option[unknown]` and dropped
//# the other arm's `Option[Array[Int]]`, so this `String::length` of an Array
//# checked clean.
fn g(flag: Bool) -> Int {
  let o = match flag {
    true => None,
    false => Some([1, 2, 3])
  }
  match o {
    Some(v) => String::length(v),
    None => 0
  }
}

export fn main() -> Int {
  g(false)
}
