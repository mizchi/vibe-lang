// An integer-literal `return` in a lambda whose result is `Int32` (its tail
// is one) is range-checked as `Int32` (#4062). Before, it returned
// 2147483648 through an `Array[Int32]`.
fn f(xs: Array[Int32]) -> Array[Int32] {
  Array::map(xs, f = (k: Int32) -> {
    if k == 0 {
      return 2147483648
    }
    k
  })
}
