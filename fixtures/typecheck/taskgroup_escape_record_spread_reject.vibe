// #3488: a spread copies its operand's elements, so `[...cells]` still
// holds the cells declared outside the body.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

fn put(cells: Array[Cell], x: TaskHandle[Int]) -> Unit {
  cells[0].v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let cells = [Cell::{ v: None }]
  let r = TaskGroup::run((n) -> {
    put([...cells], TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
