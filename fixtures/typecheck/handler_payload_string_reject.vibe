// #3371: a string literal payload was ignored like an Int one; the arm that
// ran for `perform Say::Word("hi")` was the later `Say::Word(_)`.
effect Say {
  Word(String) -> Int
}

fn run() -> Int {
  handle {
    perform Say::Word("hi")
  } with {
    Say::Word("hi") => resume(100);
    Say::Word(_) => resume(5)
  }
}
