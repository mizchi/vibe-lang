// #3488 (Codex on #3492): a `return` inside a condition hands the
// parameter back too.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn pick(c: Cell) -> Cell {
  if {
    return c
    true
  } {
    Cell::{ v: None }
  } else {
    Cell::{ v: None }
  }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: pick(outer) }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
