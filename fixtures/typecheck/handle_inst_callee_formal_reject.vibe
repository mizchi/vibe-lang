// #3027: a callee's row may name its own type formal (`State[S]`). At a call
// the formal takes the type the call instantiates it to -- `Int` here, from
// `use_int`'s parameter -- and that is what the handler must answer. The
// handler resumes a String.
effect State[S] {
  Get() -> S
}

fn get[S]() -> S with State[S] {
  perform State::Get()
}

fn use_int(x: Int) -> Int {
  x + 1
}

fn main() -> Unit allows Console {
  let n = handle {
    use_int(get())
  } with { State::Get() => resume("abc") }
  println("\{n}")
}
