// #3585: the closure is bound by `let` first, performs `Log` before `Ask`,
// and is kept at a parameter whose row carries only `Log`: the `Ask` it
// performs still needs this handle.
effect Ask {
  Get() -> Int
}

effect Log {
  Put(n: Int) -> Unit
}

let kept: Array[() -> Int with Log] = []

fn keep(f: () -> Int with Log) -> Unit {
  Array::push(kept, f)
}

fn main() -> Unit allows Console {
  let n = handle {
    let h = () -> {
      perform Log::Put(1)
      perform Ask::Get()
    }
    keep(h)
    1
  } with {
    Ask::Get() => resume(5);
    Log::Put(_) => resume(())
  }
  println("\{n}")
}
