// #3096 review: the declaration's own `[N]` shadows the imported alias
// `type N = String` over its header and body, so `with State[N]` names the
// formal, not `String`, and does not authorize a call requiring
// `State[String]`.
import ./generic_row_imported_alias_dep.vibe { State, get, N }

fn caller[N](x: N) -> Int with State[N] {
  get("abc")
}
