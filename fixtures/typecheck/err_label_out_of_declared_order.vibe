// ADR-0120 D2: labels are written in the declared order, so the written order
// is the evaluation order. A label written ahead of one the declaration lists
// before it is refused with the move and the declared order.
fn three(a: Int, b: Int, c: Int) -> Int {
  a * 100 + b * 10 + c
}

fn run() -> Int {
  three(a = 1, c = 3, b = 2)
}
