// #4091: a closure whose body the check does not read may return what it
// captured, here an array declared before the region.

fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let pick = () -> outer
  let v = region r {
    let c = MutList::empty(r)
    let s = pick()
    Array::push(s, value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
