// #3599: a top-level binding of a call's result names no function the check
// can read, so a closure in a declared type's field of what it returns is
// taken to throw what the handle catches. `top_g` is `mk`, whose `Box`
// holds a closure that inherited `mk`'s throw; returned as the handle's
// value, `f()` threw with no handler around it.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn pick(n: Int) -> () -> Box with Exception[Int] {
  mk
}

let top_g: () -> Box with Exception[Int] = pick(3)

fn main() -> Unit allows Console {
  let b = handle {
    top_g()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
