//# #2762 green side: a LOCAL `trait` has no flat binding, so the refusal must
//# find it through `interface_local_nonvalue_kind` instead. Publishing a
//# private trait by aggregate export is what puts its impls in the export
//# surface (`restrict_env_to_export_surface`), so refusing this shape would
//# withdraw them.

export {
  Marker
}

trait Marker

export fn main() -> Int {
  1
}
