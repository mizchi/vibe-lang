// #3360 (Codex on #3473): the helper's module has more private companions
// than the summary budget allows; they are not published, so its exported
// `keep_in` is still summarized and the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_import_budget_dep_ok.vibe { keep_in }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    keep_in(outer, h)
    1
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
