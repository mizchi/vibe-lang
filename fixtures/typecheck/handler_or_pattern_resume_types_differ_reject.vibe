// #3301: an or-pattern handler arm is checked once per operation, so a body
// that names `resume` would hold it at `(Int) -> Int` for `A` and at
// `(String) -> Int` for `B` -- one expression at two types, and `vibe type-at`
// answered with whichever copy was checked last. The arm is refused instead;
// the message names the edit, separate arms.
effect Name {
  A -> Int
  B -> String
}

fn work() -> Int with Name {
  let a = perform Name::A
  let b = perform Name::B
  a + String::length(b)
}

fn main() -> Int {
  handle {
    work()
  } with Name {
    A|B => {
      let k = resume
      0
    }
  }
}
