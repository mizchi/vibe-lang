// ADR-0088: a `test` block is an entry point, so its row is admitted like
// `main`'s -- a user effect has no owner the run can bring in, and granting
// it used to authorize a `perform` no handler would ever catch (Codex review
// on PR #2653).
effect Ask {
  Get() -> Int
}

test "grants a user effect" allows Ask::Get {
  let _ = perform Ask::Get()
  assert(true)
}
