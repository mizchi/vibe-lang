// ADR-0088: a `test` block is an entry point, so its row is admitted like
// `main`'s. Granting a user effect used to authorize a `perform` no handler
// would ever catch (Codex review on PR #2653). Since ADR-0124 decision 3
// (#2656) the label is admitted when the block handles the operation, and the
// block is walked without it, so the perform outside the handle is still
// refused at its site.
effect Ask {
  Get() -> Int
}

test "grants a user effect" allows Ask::Get {
  let _ = perform Ask::Get()
  let v = handle {
    perform Ask::Get()
  } with {
    Ask::Get() => resume(1)
  }
  assert(v == 1)
}
