// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. A closure applied in place never leaves -- but here the one
// applied returns another that performs, and that one is the handle's value.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

fn main() -> Unit allows Console {
  let g = handle {
    (() -> () -> perform Ask::Get() + 1)()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
