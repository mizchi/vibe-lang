// #3588: `join`'s parameter is `TaskHandle[rg, e, T]`; given the elided
// `TaskHandle[Int]` it failed to unify, so `T` was never bound and the call's
// result was free to be returned as a `String`.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError }

fn get(h: TaskHandle[Int]) -> String with Exception[TaskError] {
  TaskHandle::join(h)
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> 7)
    get(h)
  })
  println("len=\{String::length(r)}")
}
