// #3036: self- and mutually-recursive declarations, so the transitive
// identity walk has to terminate on a cycle.
export enum Chain {
  Link(Int, Chain);
  End
}

export struct Node {
  kids: Array[Leaf];
  chain: Chain
}

export struct Leaf {
  up: Option[Node]
}

export fn make_node() -> Node {
  Node::{ kids: [], chain: End }
}
