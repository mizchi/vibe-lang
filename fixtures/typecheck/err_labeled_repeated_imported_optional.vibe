// #3432: a label repeated on a call to an imported function is refused, as it
// is for a local callee. Before, `greet(name = "a", name = "b")` was padded
// with `None` and compiled, answering "a x1" (Codex on #3441).
import ../optional_param_import/lib.vibe { greet }

fn call() -> String {
  greet(name = "a", name = "b")
}
