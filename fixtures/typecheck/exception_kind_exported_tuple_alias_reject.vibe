// Codex on #3021: an EXPORTED row whose exception kind resolves to a spelling
// a row cannot hold (a tuple alias) is refused. The row would otherwise be
// published with the alias NAME, and an importer declaring its own `Pair`
// (say `type Pair = String`) would take the dependency's tuple payload for its
// String kind.
type Pair = (Int, Int)

export fn fail_pair(n: Int) -> Int with Exception[Pair] {
  if n > 0 {
    let p: Pair = (n, n + 1)
    throw(p)
  } else {
    0
  }
}

fn main() -> Int {
  handle { fail_pair(1) } with { Exception::Throw(_) => 0 }
}
