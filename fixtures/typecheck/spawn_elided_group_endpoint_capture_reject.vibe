// #3640: a group written `TaskGroup` names no nursery, so a task spawned into
// it cannot be seen to hold an endpoint of its own nursery. The diagnostic
// names the edit: write the group with its region.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn start(g: TaskGroup) -> TaskHandle[Int] {
  TaskGroup::spawn(g, () -> TaskHandle::join(TaskGroup::spawn(g, () -> 1)))
}

fn main() -> Unit allows Console + Exception {
  let w = TaskGroup::run((g) -> {
    TaskHandle::join(start(g))
  })
  println("w = \{w}")
}
