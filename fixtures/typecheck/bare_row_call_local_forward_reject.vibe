// #3416 control: a local lambda that calls its callback outside any handle
// forwards the callback's `Box[Int]` to the caller, so `top`'s `Box[String]`
// does not cover it.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let cb = () -> mk()
  let lrun = (f: () -> Int with Box[Int]) -> Int {
    f()
  }
  lrun(cb)
}
fn top() -> Int with Box[String] {
  mid()
}
