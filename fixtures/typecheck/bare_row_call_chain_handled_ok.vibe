// #3408: a callee whose `Box` the bare function handles itself does not fix
// that function's payload.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  handle {
    mk()
  } with { Box::Put(n) => resume(n + 1) }
}
fn top() -> Int with Box[String] {
  mid()
}
