// #3112 (Codex on #3091): a declaration that does not STORE its type
// parameter holds no future cell, whatever that parameter is instantiated
// with. `Marker[T]` keeps only an `Int`, so `Marker[Future[a]]` must not keep
// `a` monomorphic: `m` is usable at two payload types. The value restriction
// used to scan every type argument of a declared type, phantom or not, and
// rejected the second use.
enum Marker[T] {
  Tag(Int)
}

fn mark[T]() -> Marker[Future[T]] {
  Marker::Tag(1)
}

fn uses() -> Int {
  let m = mark()
  let a: Marker[Future[Int]] = m
  let b: Marker[Future[String]] = m
  match (a, b) {
    (Tag(x), Tag(y)) => x + y,
    _ => 0
  }
}
