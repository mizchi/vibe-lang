// #3621: a row-free closure literal bound by `let` passed to the row-typed
// parameter of a LOCAL lambda (#3416), whose handle passes that parameter
// the dict. The literal is stamped only at a top-level function's slot, so
// it kept the row-free calling convention and the call trapped ("indirect
// call type mismatch") after a clean `vibe check`. The build is refused
// with the edit.
effect Box[T] {
  Put(T) -> Unit
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let run = (f: () -> Int with Box[String]) -> handle {
    f()
  } with { Box::Put(_) => resume(()) }
  run(g) + drive(tick)
}
