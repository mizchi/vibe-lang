// #3488 (Codex on #3492): a field set from a `match` arm that hands back the
// scrutinee through a binder (`Some(x) => x`) is the scrutinee's location.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: match Some(c) {
      Some(x) => x,
      None => Cell::{ v: None }
    } }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
