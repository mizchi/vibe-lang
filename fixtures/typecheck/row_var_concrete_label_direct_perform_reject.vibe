// #3595: a declared row variable stands for what the caller passes, not for
// what the body itself performs. `m2` prints and declares only `e`; passing
// a pure function instantiates `e` to nothing, so the pure `q` printed.
fn pure_one() -> Int {
  1
}

fn m2(f: () -> Int with e) -> Int with e {
  println("direct side effect")
  f()
}

fn q() -> Int {
  m2(pure_one)
}

fn main() -> Unit allows Console {
  println("\{q()}")
}
