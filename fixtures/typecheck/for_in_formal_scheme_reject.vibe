//# #3149: the same for a `for` iterand: `c` is bound to `Array[_]` in the
//# body, the scheme carries it, and passing a Map is a type error at the call.
fn count[T](c: T) -> Int {
  let mut n = 0
  for x in c {
    n = n + 1
  }
  n
}

export fn main() -> Int {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  count(m)
}
