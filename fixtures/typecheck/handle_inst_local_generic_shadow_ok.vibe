// #3027 (Codex on #3039): a local generic lambda that shadows a top-level
// generic function names its OWN formal in its row. The handler check must not
// read that formal through the top-level declaration's positions, where `S`
// sits where the lambda has `T` -- that refused this correct program with
// `requires State[Int]`. The lambda declares the row without performing: a
// `perform` from a local lambda is not evidence-passed yet.
effect State[S] {
  Get() -> S
}

fn get[S, T](x: T, y: S) -> Int {
  0
}

fn main() -> Int {
  let get = [S, T](x: S, y: T) -> Int with State[S] {
    1
  }
  let n = handle {
    get("abc", 1)
  } with { State::Get() => resume("xyz") }
  n
}
