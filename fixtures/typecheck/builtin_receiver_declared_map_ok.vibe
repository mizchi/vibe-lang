//# #2820 CONTROL. `Map` is NOT in #2475's refused set (that covers `Array` /
//# `Option` at arity 1 and `resolve_builtin` at arity 0), so a source
//# declaration may take the spelling -- and when it does, `find_typedef` finds
//# it and the field resolves through the struct's own field list. The builtin
//# refusal is gated on there being NO such declaration, so this file is what
//# fails if that gate is dropped.
struct Map[K, V] {
  k: K;
  v: V
}

fn read(m: Map[Int, String]) -> Int {
  m.k
}

export fn main() -> Int {
  read(Map::{ k: 9, v: "x" })
}
