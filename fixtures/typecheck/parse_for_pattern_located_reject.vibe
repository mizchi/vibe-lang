// #3548: a pattern after `for` is refused at the `(`, once. The recovering
// parser used to resume at the next `let` inside the same body and report a
// second, bogus error at the start of the declaration.
fn total(pairs: Array[(Int, Int)]) -> Int {
  let mut s = 0
  for (u, n) in pairs {
    s = s + u + n
  }
  s
}
