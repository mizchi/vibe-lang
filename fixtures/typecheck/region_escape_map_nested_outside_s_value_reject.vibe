// #4050 (Codex on #4057): `boxes` is declared outside both regions, so
// storing the nested `region s`'s value in an element keeps it past `s`.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    region s {
      let cell = MutList::empty(s)
      MutList::push(cell, 3)
      let _ = Array::map(boxes, f = (a) -> {
        Array::push(a, value = cell)
        0
      })
      1
    }
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
