// #3408 (Codex on #3409): `mid` calls `mk` through a local alias. The call is
// recorded as a call of `mk`, so `mid` requires `Box[Int]` and a
// `Box[String]` caller is refused with the row edit.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let h = mk
  h()
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
