// #3488 control (Codex on #3492): a local that shadows the parameter is what
// the helper returns, so its result holds nothing of the argument.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap(c: Cell) -> Wrap {
  let c = Cell::{ v: None }
  Wrap::{ cell: c }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
