// #3605 review: an annotated tuple hands each element its own slot's row. The
// first slot names the `Int` that `bad` lets out, the second is the erased
// row alone, so `bad` in the second slot is refused.
fn bad() -> Int with Exception {
  throw(7)
}

fn main() -> Unit allows Console {
  let ps: (() -> Int with Exception + Exception[Int], () -> Int with Exception) = (bad, bad)
  let (_, second) = ps
  let r = handle {
    second()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
