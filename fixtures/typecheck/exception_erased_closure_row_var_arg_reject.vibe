// #3605 review: a closure literal with its own erased row, passed where the
// parameter carries a row variable the callee lets out (`run[e]`), throws an
// `Int`. The call filled `e` from the literal's erased row alone, so the erased
// arm read the `Int` 7 as a `String` (`len=14`).
fn run(f: () -> Int with e) -> Int with e {
  f()
}

fn main() -> Unit allows Console {
  let r = handle {
    run(() -> Int with Exception {
      throw(7)
    })
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
