// #3375: an arm nested (through a lambda) in another arm checks its
// `resume(v)` against its OWN operation; the enclosing arm's continuation in
// scope used to switch the check off, so an Int resumed a String operation.
effect G {
  Op -> Int
}

effect H {
  P -> String
}

fn main() -> Int {
  handle {
    perform G::Op + 1
  } with G {
    Op => {
      let g = () -> handle {
        String::length(perform H::P)
      } with H {
        P => resume(5)
      }
      resume(g())
    }
  }
}
