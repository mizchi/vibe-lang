// #4064, Codex review on #4081: an array literal is fresh storage, so a push
// into it does not reach the closures written in it
// (fixtures/handle_bound_closure_container_test.vibe) -- but the array holds
// the pushed closure, and keeping the array is refused.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let arr = [plain]
    Array::push(arr, value = g)
    let _ = keep_arr(xs = arr)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()} \{plain()}")
}
