// #4115: what stays allowed for an opaque type outside its package: naming
// it in annotations, passing it on, and calling the package's functions.
import ./opaque_seal_pkg { Handle, Shade, handle_get, handle_new, shade_code, shade_dark }

fn pass(_ h: Handle) -> Handle { h }

fn both(_ h: Handle, s: Shade) -> Int { handle_get(h) + shade_code(s) }

export fn main() -> Int {
  let h: Handle = pass(handle_new(41))
  let s: Shade = shade_dark()
  both(h, s = s)
}
