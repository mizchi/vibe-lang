// As with an index assignment, `Array::set(acc, at = 0, value = sink)`
// redirects what the next iteration pushes into.
fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let v = region r {
    let a = MutList::empty(r)
    let b = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    let _ = Array::fold([a, b], init = init, f = (acc, c) -> {
      Array::push(Array::get(acc, at = 0), value = c)
      Array::set(acc, at = 0, value = sink)
      acc
    })
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
