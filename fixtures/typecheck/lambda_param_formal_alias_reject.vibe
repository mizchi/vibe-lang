// #3011: the lambda-parameter twin of body_annotation_formal_alias_reject --
// `(v: T) -> ..` inside `fn f[T]` names the formal, not the import alias.
import ./exception_kind_formal_alias_dep.vibe {
  Hue as T, hue_code
}

fn f[T](x: T) -> Int {
  let g = (v: T) -> Int {
    hue_code(v)
  }
  g(x)
}

export fn main() -> Int {
  f(41)
}
