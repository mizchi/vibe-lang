// #3596: an alias of an alias, one bound before the handle and one inside
// it. Each is read where it was written, so `h` stands for `mk`.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let g = mk
  let b = handle {
    let h = g
    h()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
