// #3538: a trait method declares no effects, so the impl's `with Console` let
// the pure generic caller `go` print.
trait Speak { speak(Self) -> Int }

impl Speak for Int {
  speak(x: Int) -> Int with Console {
    println("side effect")
    x
  }
}

fn go[T: Speak](x: T) -> Int { T::speak(x) }

fn main allows Console {
  println("\{go(3)}")
}
