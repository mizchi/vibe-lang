// #4091 (Codex on #4106): the inner binder that shadows `xs` is the one that
// comes to hold `sink`, and a region value is pushed into its element.

let sink: Array[MutList[Int]] = []

fn main() -> Unit allows Exception + Console {
  let flag = Array::length(sink) == 0
  let v = region r {
    let c = MutList::empty(r)
    let xs: Array[Array[MutList[Int]]] = [[]]
    if flag {
      let xs: Array[Array[MutList[Int]]] = [[]]
      Array::set(xs, at = 0, value = sink)
      Array::push(Array::get(xs, at = 0), value = c)
    } else {
      ()
    }
    Array::length(xs)
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
