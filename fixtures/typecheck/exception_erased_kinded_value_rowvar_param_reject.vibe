// #3601 (Codex on #3605): a function whose row names `Exception[Int]`,
// passed to a parameter typed `with Exception + e`. The value's exception is
// matched to the slot's erased `Exception` and `e` is left empty (#3033), so
// `run`'s callers read only messages and the erased arm read the `Int` 7 as a
// `String` (`len=14`).
fn run[e](f: () -> Int with Exception + e) -> Int with Exception + e {
  f()
}

fn fail() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Unit allows Console {
  let n = handle {
    run(fail)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{n}")
}
