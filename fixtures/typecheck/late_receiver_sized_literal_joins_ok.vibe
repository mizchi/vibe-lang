struct Holder {
  get: () -> UInt32
}

fn main() -> Int {
  let values = [Holder::{ get: () -> Int::wrap_uint32(4294967295) }]
  let branches = Array::map(values, f = (h) -> if true { h.get() } else { 0 })
  let matches = Array::map(values, f = (h) -> match true { true => 0, false => h.get() })
  let arrays = Array::map(values, f = (h) -> [0, h.get(), 1])
  let first = Array::get(arrays, at = 0)
  if Array::get(branches, at = 0) == Array::get(first, at = 1) && Array::get(matches, at = 0) == Array::get(first, at = 0) {
    UInt32::to_int(Array::get(first, at = 2))
  } else {
    0
  }
}
