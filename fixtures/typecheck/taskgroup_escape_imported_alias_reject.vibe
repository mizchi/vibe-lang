// #3360 (Codex on #3467): an exported alias of a helper keeps what the
// helper keeps; an importer sees only the alias.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_helper_dep_ok.vibe { Cell }
import ./taskgroup_escape_imported_struct_dep_ok.vibe { put_alias }

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put_alias(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
