// #3022 review: a nested handle shadows only the effects its own arms name.
// Here the inner handle discharges `Ask`, so the `State[String]` call in its
// body still reaches the outer `State[Int]` handler and is compared with it.
effect State[S] {
  Get() -> S
}

effect Ask {
  Q() -> Int
}

fn get_str() -> String with State[String] {
  perform State::Get()
}

fn main() -> Unit allows Console {
  let r = handle {
    handle {
      String::length(get_str())
    } with { Ask::Q() => resume(0) }
  } with { State::Get() => resume(1) }
  println("\{r}")
}
