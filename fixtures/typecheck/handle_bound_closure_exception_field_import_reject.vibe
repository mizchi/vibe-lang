// #3593: #3584's program with the function that builds the struct moved into
// another module. The importer cannot read `mk`'s body, and `Box` is not even
// imported by name, so `vibe check` was clean while `f()` threw with no
// handler around it. `mk`'s module now publishes that the closure it returns
// in a field throws.
// fixtures/handle_bound_closure_import_field_test.vibe imports `mk_ok`, whose
// field closure does not throw.
import ../modules/handle_bound_closure_field_dep.vibe {
  fallback, mk
}

fn main() -> Unit allows Console {
  let b = handle {
    mk()
  } with { Exception[Int]::Throw(c) => fallback(c) }
  let f = b.f
  println("\{f()}")
}
