// #3488 (Codex on #3492): a helper that returns through a `for` element
// hands back what the iterator holds.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap(c: Cell) -> Wrap {
  for x in [c] {
    return Wrap::{ cell: x }
  }
  Wrap::{ cell: Cell::{ v: None } }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
