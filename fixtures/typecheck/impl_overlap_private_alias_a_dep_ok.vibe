// #3958: one of two sibling impls of `Value` for `Note`, spelled through a
// PRIVATE alias of `Int`. The merge renames the alias per file
// (`Alias_dep_<path>`), so the impl's key has to follow it, or the linked
// check reads `Value[Alias]`, which names nothing, and lets the pair through.
import ./impl_overlap_alias_base_dep_ok.vibe {
  Note, Value
}

type Alias = Int

impl Value[Alias] for Note {
  value(self) -> Alias {
    1
  }
}

// Not `Value::value(..)`: see impl_overlap_alias_a_dep_ok.vibe (#3965).
export fn from_private_a() -> Int {
  1
}
