// #3958: one of two sibling impls of `Value` for `Note`, spelled through a
// PRIVATE alias of `Int`. The linker renames a private alias per file before
// the merged program is checked, so the impl's key has to be expanded first
// or the linked overlap check cannot see that it is `Value[Int]`.
import ./impl_overlap_alias_base_dep_ok.vibe {
  Note, Value
}

type Alias = Int

impl Value[Alias] for Note {
  value(self) -> Alias {
    1
  }
}

// Not `Value::value(..)`: see impl_overlap_alias_a_dep_ok.vibe (#3965).
export fn from_a() -> Int {
  1
}
