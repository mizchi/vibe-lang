// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The arm takes the continuation as a value (a suspend arm);
// the body's value still leaves through it. `g()` trapped.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

fn main() -> Unit allows Console {
  let g = handle {
    let h = () -> perform Ask::Get() + 1
    h
  } with { Ask::Get() => {
    let k = resume
    k(41)
  } }
  println("g=\{g()}")
}
