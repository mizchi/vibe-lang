// ADR-0094 (#3143, Codex on #4020): a resource argument is checked on every
// row, so moving the function into a local closure does not skip it.
effect Kv[R: Store::Bucket] {
  Get(String) -> String
}

resource Logs: Store::Queue

fn outer() -> Int {
  let inner = (key: String) -> String with Kv[Logs] {
    perform Kv::Get(key)
  }
  0
}
