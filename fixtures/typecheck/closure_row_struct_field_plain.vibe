// #1451 guard: the grant is per FIELD. A field whose declared type carries NO row
// must not let a stored literal perform -- the row would be lost at the boundary
// and the perform would run with no handler.
effect Log {
  Emit(String) -> Unit
}

struct Plain {
  run: (String) -> Unit
}

fn mk() -> Plain {
  Plain::{
    run: (s) -> {
      perform Log::Emit(s)
    }
  }
}
