// #3593: the same through a method call on an imported type. `fac.build()`
// resolves to `Factory::build`, declared in another module, whose closure in
// `Box`'s field throws.
import ../modules/handle_bound_closure_field_dep.vibe {
  Box, Factory
}

fn main() -> Unit allows Console {
  let fac = Factory::{ n: 7 }
  let b = handle {
    fac.build()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
