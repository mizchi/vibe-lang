// #3539: a call through a `match` binder is charged the binder type's row
// (so is one through a `for` or a destructuring binder; see
// lib/@vibe/compiler/tests/effect_row_typed_callee_test.vibe).
fn pure_fn(o: Option[() -> Unit with Console]) -> Int {
  match o {
    Some(f) => f(),
    None => ()
  }
  42
}
