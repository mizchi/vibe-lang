// #3572 control: the elided spellings stay legal where the value is used
// through the package's functions, and the complete spelling still reads the
// field at its declared type.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError }

fn spawn_seven(g: TaskGroup) -> TaskHandle[Int] {
  TaskGroup::spawn(g, () -> 7)
}

fn wait(h: TaskHandle[Int]) -> Int with Exception[TaskError] {
  TaskHandle::join(h)
}

fn witness[rg, e](g: TaskGroup[rg, e], x: rg) -> rg {
  let w = g._region_witness
  w(x)
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    wait(spawn_seven(n))
  })
  println("r=\{r}")
}
