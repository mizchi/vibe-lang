// A struct pattern field binds its own name only. A sub-pattern after `:` was
// read as the closing brace, so the parse failed one token later with
// `expected => but got ident`, naming no edit. It is refused at the `:` with
// the spelling that works: bind the field, then match its value.
struct S {
  f: Option[Int];
  g: Int
}

fn pick(s: S) -> Int {
  match s {
    S::{ f: Some(x), g } => x + g
  }
}

export let _start: () -> Int = () -> pick(S::{ f: Some(1), g: 2 })
