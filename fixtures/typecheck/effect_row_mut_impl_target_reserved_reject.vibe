// #3045: an impl target embedding a function type may not name the reserved
// `Mut` either. The parser refuses the label in every row it reads, whatever
// construct the row sits in (Codex on #3061).
struct Box[T] {
  value: T
}

trait Marker {
  mark(Self) -> Int
}

impl Marker for Box[() -> Unit with Mut] {
  mark(self) -> Int {
    1
  }
}
