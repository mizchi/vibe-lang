// #3102 review: a top-level formal spelled `Option` passed to a generic callee
// under `with State[Option]` names the same rigid formal on both sides.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[Option](x: Option) -> Bool with State[Option] {
  get(x) > 0
}
