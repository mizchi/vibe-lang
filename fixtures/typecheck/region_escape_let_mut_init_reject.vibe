// #4091: a `let mut` initialized with an outer array is that array.

let sink: Array[MutList[Int]] = []

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let mut m: Array[MutList[Int]] = sink
    Array::push(m, value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
