// #3538: a call through `[T: Child[Int]]` types the inherited `get` with
// `Base`'s `A` as `Int` and dispatches to this impl, so the impl is held to
// `Int` too. It was compared with `A` left open, and the caller added 1 to a
// String's address.
trait Base[A] { get(Self) -> A }

trait Child[A]: Base {}

struct P { x: Int }

impl Child[Int] for P {
  get(self) -> String { "hello" }
}

fn via[T: Child[Int]](v: T) -> Int { T::get(v) }

fn main allows Console {
  let n: Int = via(P::{ x: 1 }) + 1
  println("n=\{n}")
}
