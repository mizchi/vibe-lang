//# #3026 control: the importer names the dependency's `Err` rather than
//# declaring its own, so the imported signatures and the local spelling are the
//# same declaration and nothing is refused.
import ./foreign_type_name_dep.vibe { Err, make_err, fail_err }

fn relay() -> Int with Exception[Err] {
  fail_err()
}

fn main() -> Unit {
  let e: Err = make_err()
  let _ = e.code
  let _ = handle {
    relay()
  } with {
    Exception[Err]::Throw(x) => x.code
  }
}
