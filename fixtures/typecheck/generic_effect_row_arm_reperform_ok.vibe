// #3275 control: the perform inside the arm escapes to the caller of this
// `with Box[Int]` function, so it sends an `Int`; the handled body's perform
// belongs to the local handle, whose arm reads a `String`.
effect Box[T] {
  Put(T) -> Int
}

fn producer() -> Int with Box[Int] {
  handle {
    perform Box::Put("xyz")
  } with {
    Box::Put(v) => resume(perform Box::Put(String::length(v)))
  }
}
