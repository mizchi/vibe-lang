// #3536: a body may not make two declared type parameters one type. `x: T`
// returned as `U` unified the two while the scheme still quantified both, so
// `cast("hello")` typed as `Int` and `n + 1` printed the string's pointer
// plus one (`137438953475`).
fn cast[T, U](x: T) -> U {
  x
}

fn main allows Console {
  let n: Int = cast("hello")
  println("\{n + 1}")
}
