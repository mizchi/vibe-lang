// #3044: `let*` leaves its enclosing BLOCK, so in a function returning `Int`
// a nested block whose value is not an Option is fixed by wrapping that
// block's result -- the message names that edit, not only a change of the
// function's return type (Codex on #3061).
fn lookup() -> Option[Int] {
  Some(1)
}

fn f() -> Int {
  let r = {
    let* x = lookup()
    x + 1
  }
  0
}
