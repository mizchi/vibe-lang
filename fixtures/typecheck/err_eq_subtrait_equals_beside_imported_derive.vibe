// #3562: the `derive (Eq)` is in the type's own module and the impl of the
// subtrait `Key` that writes another `equals` is here; the imported witness
// is just as much a second `Eq::equals` for `Box`.
import ../modules/eq_subtrait_key_owner.vibe {
  trait Key, struct Box
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

fn via_eq[U: Eq](a: U, b: U) -> Bool {
  U::equals(a, b)
}

fn via_key[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn answers() -> String {
  let p: Box[Int] = Box::{ v: 1 }
  "eq=\{via_eq(p, p)} key=\{via_key(p, p)}"
}
