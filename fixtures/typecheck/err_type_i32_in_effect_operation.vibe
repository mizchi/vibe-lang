//# #3727: `i32` in an effect operation's signature is refused too.
//#
//# An operation's signature never ran the unknown-type check, so once `i32`
//# stopped resolving to `Int` it stood for any type: `perform E::Op + 1`
//# resumed with 2147483647 checked clean and printed `2147483648`.
effect E {
  Op() -> i32
}

fn m() -> Int with E {
  perform E::Op + 1
}

fn main() -> Unit allows Console {
  let r = handle {
    m()
  } with {
    E::Op => resume(2147483647)
  }
  println("\{r}")
}
