// ADR-0124 decision 3 (#2656), r2: `allows Db` does not admit a perform
// outside every handler; the body is walked without the label, so the perform
// is refused at its site even though a handle elsewhere in `main` names `Db`.
effect Db {
  Get(Int) -> Int
}

fn main allows Console + Db {
  let a = perform Db::Get(1)
  let v = handle {
    perform Db::Get(2)
  } with {
    Db::Get(n) => resume(n)
  }
  println("\{a} \{v}")
}
