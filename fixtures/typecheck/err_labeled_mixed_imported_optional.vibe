// #3432: mixing positional and labeled arguments is refused on a call to an
// imported function, as it is for a local callee. Before, the imported call
// skipped the check and `greet("hi", times = 4)` compiled (Codex on #3441).
import ../optional_param_import/lib.vibe { greet }

fn call() -> String {
  greet("hi", times = 4)
}
