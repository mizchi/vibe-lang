export effect Box[T] {
  Put(T) -> Int
}
export fn make[T](x: T) -> () -> Int with Box[T] {
  () -> Int with Box[T] {
    perform Box::Put(x)
  }
}
export fn consume_int(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
export fn consume_string(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(s)) }
}
