//# #3026 (Codex review on #3035): importing a trait retains the dependency's
//# impls of it. `impl Describe for Err` names the dependency's `Err`; with this
//# module's own `Err`, the local type would satisfy the dependency's impl and
//# dispatch into code compiled for the dependency's layout.
import ./foreign_type_name_dep.vibe { Describe }

struct Err {
  name: String
}

fn main() -> Unit {
  let _ = Err::{ name: "x" }
}
