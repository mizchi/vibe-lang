// #3601: `fail` is declared with the erased `with Exception` row and throws
// an `Int` in another module. The importer saw only the declared row, so the
// erased arm read the `Int` 7 as a `String` (`len=14`). The module now
// publishes the kind its row lets out, and the arm that reads `m` is refused.
import ../modules/exception_erased_row_dep.vibe {
  fail
}

fn main() -> Unit allows Console {
  let r = handle {
    fail()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
