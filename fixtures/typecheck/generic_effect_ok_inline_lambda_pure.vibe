// #2078 false-positive guard. An inline literal with NO row annotation has an
// INFERRED row (structurally distinct from an empty one -- it inherits its
// surrounding context), so the instantiation stays unresolved and `run` keeps
// requiring nothing. Reading a row here instead of bailing would reject the
// ordinary pure passthrough, which is the mistake that sank the naive fix in
// #1485 (see generic_effect_matrix_ok_passthrough_pure).
effect Ask {
  Get(Int) -> Int
}

let apply = [T](f: (x: T) -> T with e, x: T) -> T with e { f(x) }

let run = (x: Int) -> Int {
  apply((y: Int) -> Int {
    y + 1
  }, x)
}

fn main {
  let _ = run(1)
}
