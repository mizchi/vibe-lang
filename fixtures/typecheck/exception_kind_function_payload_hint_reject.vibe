// #3033 follow-up (Codex on #3052): a function payload has a kind, and a row
// cannot spell it -- `collect_row_item_targs` reads type NAMES, so
// `with Exception[(Int, Int) -> Int]` is a syntax error. The hint used to
// suggest exactly that, and its comma split the kind into
// `(Int + Int) -> Int`. It now asks for an alias and pastes the alias. The
// harness reads the first line only; the hint's text is pinned by
// lib/@vibe/compiler/tests/checker_effects_test.vibe.
struct IoErr {
  code: Int
}

struct Holder {
  cb: (Int, Int) -> Int
}

fn boom(h: Holder) -> Int with Exception[IoErr] {
  throw(h.cb)
}
