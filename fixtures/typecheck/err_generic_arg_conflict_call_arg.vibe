// #3590: the same pair as a call argument. `take` declares its first argument
// open and its second `String`; a `Pair[x, Int]` handed to it was accepted.
struct Pair[A, B] {
  a: A
  b: B
}

fn take[y](p: Pair[y, String]) -> String {
  p.b
}

fn pass[x](h: Pair[x, Int]) -> String {
  take(h)
}

fn main() -> Unit allows Console {
  let s = pass(Pair::{ a: 1, b: 7 })
  println("len=\{String::length(s)}")
}
