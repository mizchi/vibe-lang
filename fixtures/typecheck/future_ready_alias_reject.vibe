// #3163: the issue's repro. `Future::ready` has no value form, so binding it
// to a name is refused, naming the call and the wrap forms. A value form
// typed from the builtin table's erased row would read the future's Int as a
// String below.
fn read_it() -> Int with Async {
  let ready = Future::ready
  let f = ready(5)
  let s: String = await(f)
  String::length(s)
}
