// #3408 (Codex on #3409): `cb = mk` reassigns a mutable binding to a
// function; the later `cb()` runs `mk`. The assigned function is read at
// the assignment, like an assigned lambda, so `mid` requires `Box[Int]` and
// a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let mut cb: () -> Int with Box = () -> 0
  cb = mk
  cb()
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
