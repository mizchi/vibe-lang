// #3601: a closure literal with its own erased row, applied where it is
// written, throws an `Int` into the handled body: what it lets out is the
// enclosing body's, so the erased arm that reads `m` is refused.
fn main() -> Unit allows Console {
  let r = handle {
    (() -> Int with Exception {
      throw(7)
    })()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
