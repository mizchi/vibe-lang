// #3862: the tail constructor reads a local that holds a parameter
// (`let held = first`), so the parameter's region provenance flows through it.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[A, B] {
  let held = first
  Pair(held, second)
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(slot, _) = escaped
  Array::length(slot.callback())
}
