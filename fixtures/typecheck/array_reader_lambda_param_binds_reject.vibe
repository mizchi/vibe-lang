//# #3145: an unannotated lambda parameter used only through a builtin
//# `Array::*` reader is bound to `Array[_]`, the way the direct fast path
//# already bound it (#3006), so a Map argument is a type error at the call.
//# `Array::reverse` / `get` / `slice` / `concat` / `push` / `push_all` /
//# `map` / `fold` took special checker arms that skipped the binding: the
//# parameter stayed open and a one-entry map answered `0` here, silently.
export fn main() -> Int {
  let count = (c) -> {
    Array::length(Array::reverse(c))
  }
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  count(m)
}
