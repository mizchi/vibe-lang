// #3518 review: `(T, T)` from a `Log` and a `State` function -- neither row
// covers the other. `T` takes a function type whose row is their union, so a
// `fallback` that carries both is accepted rather than refused as dropping an
// effect.
effect Log {
  Emit(Int) -> Unit
}

effect Tick {
  Bump() -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn ticked() -> Int with Tick {
  perform Tick::Bump()
  2
}

fn both_rows() -> Int with Log + Tick {
  logged() + ticked()
}

fn pair() -> (() -> Int with Log, () -> Int with Tick) {
  (logged, ticked)
}

fn choose3[T, e](mk: () -> (T, T) with Exception + e, fallback: T) -> T {
  fallback
}

fn pick() -> () -> Int with Log + Tick {
  choose3(pair, both_rows)
}

fn main() -> Int {
  0
}
