// #3036 (Codex on #3076): reaches dup_type_a_dep_ok's `Err` only through an
// operation-level effect-set member, `Fail::Raise`, whose signature takes
// `Err`. Neither `Fail` nor `Err` is re-exported.
import ./dup_type_a_dep_ok.vibe { Err }

effect Fail {
  Raise(Err) -> Unit
}

export effectset Caps = { Fail::Raise }

export fn run(n: Int) -> Int with Caps {
  if n < 0 {
    perform Fail::Raise(Err::{ code: n })
  }
  n
}
