// #4050: a `match` arm's binder holds a part of the scrutinee, so a
// scrutinee built over an outer binding makes the binder an alias of it.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    match Some(outer) {
      Some(a) => Array::push(a, value = cell),
      None => ()
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
