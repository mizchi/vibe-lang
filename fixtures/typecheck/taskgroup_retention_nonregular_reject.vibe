import @vibe/concurrent {
  TaskGroup, TaskHandle
}
struct Cell[T] { mut v: Option[T] }
enum Nest[T] {
  Here(T);
  Next(Nest[TaskHandle[Int]])
}
fn main() -> Int allows Exception {
  let outer: Cell[Nest[Int]] = Cell::{ v: None }
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> 42)
    let value: Nest[Int] = Next(Here(h))
    outer.v = Some(value)
    0
  })
  42
}
