// #3057: a PRIVATE top-level alias of an imported generic. `h("x", 1)` binds
// `A` (f's first formal) to `Int`, so the call requires `Slot[Int]`. The
// alias used to be recorded with no row at all, and its scheme kept `f`'s
// marker indices while quantifying in another order, so this compiled clean.
import ./generic_row_formal_reorder_dep_ok.vibe { Slot, f }

let h = f

fn caller() -> Int with Slot[String] {
  h("x", 1)
}
