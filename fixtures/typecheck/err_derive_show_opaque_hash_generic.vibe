// A `derive (Show)` field whose type is a Hash-only generic at a handle
// argument. `Box`'s renderer is generated by its `derive (Hash)` and renders
// `v`, so `Outer { b: Box { v: <address> } }` was printed.
struct Box[T] {
  v: T
} derive (Hash)

fn Box::hash_key[T](b: Box[T]) -> String {
  "b"
}

struct Outer {
  b: Box[StringMap[Int]]
} derive (Show)

fn show_outer() -> String {
  let o = Outer::{ b: Box::{ v: Map::from_pairs([("a", 1)]) } }
  "o=\{o}"
}
