// Codex on #4100: a `C::iter_get` that publishes the fresh array it hands
// out into a module-level array, through a `let` whose value is a call. The
// element is built in the body but is no longer fresh, so the write keeps
// the region value in `kept` (the positive-evidence rule alone accepted it
// and printed `kept=true`).
let kept: Array[Array[MutList[Int]]] = []

struct Bag {
  n: Int
}

fn Bag::iter_length(_ b: Bag) -> Int {
  b.n
}

fn Bag::iter_get(_ b: Bag, i: Int) -> Array[MutList[Int]] {
  let fresh: Array[MutList[Int]] = []
  let _ = Array::push(kept, value = fresh)
  fresh
}

fn main() -> Unit allows Exception + Console {
  let bag = Bag::{ n: 1 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in bag {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(Array::get(kept, at = 0)) > 0}")
}
