// #3408 (Codex on #3409): `run` handles the `Box` its callback parameter
// names, so `mid` does not take `mk`'s `Box[Int]` from the lambda passed to it.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn run(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
fn mid() -> Int with Box {
  run(() -> mk())
}
fn top() -> Int with Box[String] {
  mid()
}
