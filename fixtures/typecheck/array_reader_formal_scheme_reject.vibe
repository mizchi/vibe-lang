//# #3149: a formal the body binds to `Array[_]` (here through the builtin
//# `Array::length`, #3006) is substituted into the declaration's scheme, so a
//# caller passing a Map is a type error at the call. It stayed quantified --
//# only a FULLY concrete binding (`String`, `Array[Int]`) was substituted --
//# and this compiled, answering 0 for a one-entry map.
fn count[T](c: T) -> Int {
  Array::length(c)
}

export fn main() -> Int {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  count(m)
}
