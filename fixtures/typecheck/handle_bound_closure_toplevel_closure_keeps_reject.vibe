// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. It is handed to a top-level closure binding that keeps it in
// a module-level array. `g()` answered `6` from the dead handler after
// `vibe check` was clean.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

let slot = (f: () -> Int) -> Array::push(saved, f)

fn main() -> Unit allows Console {
  handle {
    slot(() -> perform Ask::Get() + 1)
  } with { Ask::Get() => resume(5) }
  let g = Array::get(saved, 0)
  println("g=\{g()}")
}
