// #3540: a kinded arm over a row variable reached through the function a
// callback returns. Before the fix this answered `274877906948`: the String
// thrown through `e` read as an Int.
fn guarded(mk: () -> (() -> Int with e)) -> Int with e {
  handle {
    let f = mk()
    f() + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded(() -> thrower)
  } with { Exception[String]::Throw(m) => String::length(m) }
}
