// #3539 controls: the same callee shapes with pure function types, and with
// the row declared, compile.
fn mk() -> (() -> Unit with Console) {
  () -> println("side effect")
}

fn mk_pure() -> (() -> Int) {
  () -> 1
}

struct S {
  f: (Int) -> Int
}

fn pure_fn(s: S, o: Option[() -> Int], fs: Array[() -> Int]) -> Int {
  let n = match o {
    Some(f) => f(),
    None => 0
  }
  mk_pure()() + (s.f)(1) + s.f(2) + (Array::get(fs, 0))() + n
}

fn eff_fn(fs: Array[() -> Unit with Console]) -> Int with Console {
  mk()()
  for f in fs {
    f()
  }
  42
}

fn main allows Console {
  println("\{pure_fn(S::{ f: (x) -> x }, None, [() -> 3]) + eff_fn([])}")
}
