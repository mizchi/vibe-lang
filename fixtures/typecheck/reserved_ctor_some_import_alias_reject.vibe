// #3086: `Some` is the built-in Option constructor, and every `Some` in an
// expression resolves to it in the checker. A import alias named `Some` is refused
// at its own token, with the rename named, instead of being called by codegen where the checker typed an Option.
import ./reserved_ctor_some_import_alias_dep.vibe { mk as Some }

fn main() -> Unit {
  let _ = Some(false)
}
