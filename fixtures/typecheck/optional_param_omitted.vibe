// #1500: an optional (`z?`) parameter may be omitted at the call site, and the
// body receives `Option[T]`. Before this, `?` only ever reached the parameter
// NAME -- the declared type stayed `T`, the call site had to pass it, and the
// docs' own example did not compile.
fn d(x: Int, z?: Int) -> String {
  match z {
    Some(v) => Int::to_string(v),
    None => "none"
  }
}

export let omitted: () -> String = () -> {
  d(1)
}

export let supplied: () -> String = () -> {
  d(1, 10)
}
