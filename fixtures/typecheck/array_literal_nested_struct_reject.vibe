//# #3353: the nested side of array_literal_struct_then_array_reject.vibe.
//
// An array of structs first, an array of arrays second: the outer literal's
// element check used to run only for an array of SCALARS, so this typed as
// `Array[Array[P]]` and an `Array[Int]` was read as a `P`.

struct P {
  v: Int
}

fn main() -> Unit allows Console {
  let xs = [[P::{ v: 1 }], [[1]]]
  println(__to_string(Array::get(Array::get(xs, 1), 0).v))
}
