// #3518: `Parallel::map[.., U: Send]`'s per-element results take the same
// path, and were accepted the same way.
import @vibe/concurrent {
  TaskGroup, Parallel
}

fn main() -> Int allows Exception {
  TaskGroup::run((g) -> {
    let ys = Parallel::map(g, [1, 2], (x: Int) -> (y: Int) -> x + y)
    Array::length(ys)
  })
}
