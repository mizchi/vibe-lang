// #4050 (Codex on #4057): inside `region r`, a `TaskGroup::run` body maps
// `boxes`, declared in `r`, storing the group's task handle in each element:
// the handle outlives its group.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let outer: Array[TaskHandle[Int]] = []
    let boxes = [outer]
    let got = TaskGroup::run((n) -> {
      let h = TaskGroup::spawn(n, f = () -> { 41 })
      let _ = Array::map(boxes, f = (a) -> {
        Array::push(a, value = h)
        0
      })
      1
    })
    got + Array::length(outer)
  }
  println("v=\{v}")
}
