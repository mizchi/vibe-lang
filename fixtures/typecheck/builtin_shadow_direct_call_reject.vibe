// #3179: the program declares its own `Array::get`, answering a `String`.
// The direct call below is typed from that declaration, so adding 1 to its
// result is refused. The checker used to type the call through the builtin's
// arm (`Int` from an `Array[Int]` receiver), and this program checked clean
// and added 1 to a string at run time.
fn Array::get(xs: Array[Int], i: Int) -> String {
  let _ = xs
  let _ = i
  "own"
}

fn main() -> Int {
  let v = Array::get([1, 2], 0)
  v + 1
}
