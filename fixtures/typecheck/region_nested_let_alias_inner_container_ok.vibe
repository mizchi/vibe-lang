// #4050: the same through `let a = inner`, which was marked as an alias for
// every active region and refused here before.
// `main` answers 100 * the inner block's value + 10 * the r1-local array's
// length + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let gboxes = [outer]
  let v = region r1 {
    let cell1 = MutList::empty(r1)
    MutList::push(cell1, 3)
    let inner: Array[MutList[Int]] = []
    let boxes = [inner]
    let w = region r2 {
      let cell2 = MutList::empty(r2)
      MutList::push(cell2, 4)
      let a = inner
      Array::push(a, value = cell1)
      1
    }
    w * 10 + Array::length(inner)
  }
  v * 10 + Array::length(outer)
}
