// #3542: importing a builtin operation from `@vibe/builtin` must keep its
// signature. The publication's marker used to shadow it with an unknown type,
// so this binding checked clean and the Double printed as an address.
import @vibe/builtin {
  Float64::floor
}

fn main {
  let s: String = Float64::floor(2.5)
  let _t = s
  ()
}
