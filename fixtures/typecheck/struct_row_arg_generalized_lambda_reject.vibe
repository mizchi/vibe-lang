// #3589: a generalized top-level lambda returning a literal publishes the
// row its literal stored. `make` used to generalize to `() -> Holder[$N]`
// with `$N` (bound to `Console`) read as a free row, so a pure caller ran
// `noisy` through `make().run`.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

let make = () -> Holder::{ run: noisy }

fn quiet() -> Int {
  (make().run)()
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
