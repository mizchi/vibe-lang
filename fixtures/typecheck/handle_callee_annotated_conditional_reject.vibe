effect Ask {
  Get() -> Int
}

fn ask_once() -> Int with Ask {
  perform Ask::Get()
}

fn ask_twice() -> Int with Ask {
  perform Ask::Get() + perform Ask::Get()
}

export fn main() -> Int {
  let c = true
  let f: () -> Int with Ask = if c { ask_once } else { ask_twice }
  handle { f() } with { Ask::Get() => resume(1) }
}
