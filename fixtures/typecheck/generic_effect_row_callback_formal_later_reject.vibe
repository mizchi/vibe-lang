// #3311: when the argument that fixes the callee's formal comes after the
// lambda, the lambda's perform fixes `T` first and the later argument is the
// one refused. Either way the program does not check; before, it did, and the
// arm compared an `Int` payload with a `String`.
effect Box[T] {
  Put(T) -> Int
}

fn run[T: Eq](f: () -> Int with Box[T], x: T) -> Int {
  handle {
    f()
  } with {
    Box::Put(v) => resume(if v == x {
      1
    } else {
      0
    })
  }
}

fn producer() -> Int with Box {
  run(() -> {
    perform Box::Put(1)
  }, "s")
}
