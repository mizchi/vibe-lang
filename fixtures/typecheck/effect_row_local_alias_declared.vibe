// #1515 guard: declaring the row is the fix, and it must keep compiling --
// including through an alias OF an alias, which resolves via the overlay the
// first binding just registered.
effect Log {
  Emit(String) -> Unit
}

fn eff(s: String) -> Unit with Log::Emit {
  perform Log::Emit(s)
}

fn caller() -> Unit with Log::Emit {
  let f = eff
  let g = f
  g("ok")
}
