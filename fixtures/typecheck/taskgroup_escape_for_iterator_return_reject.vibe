// #3488 (Codex on #3492): a `return` inside a `for` loop's iterator hands
// back what it returns, like any other `return` in the helper.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap(c: Cell) -> Wrap {
  let fresh = Cell::{ v: None }
  let mut n = 0
  for x in {
    return Wrap::{ cell: c }
    [1]
  } {
    n = n + x
  }
  Wrap::{ cell: fresh }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
