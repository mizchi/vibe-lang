// #4050: a row of a region-local array built over an outer one is still the
// outer element; the inner loop's binder aliases it through the outer loop's.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let nested = [boxes]
    for row in nested {
      for a in row {
        Array::push(a, value = cell)
      }
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
