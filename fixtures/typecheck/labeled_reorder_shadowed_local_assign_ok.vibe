// Codex on #3666: `b = ..` assigns a local `g` of its own, not the outer
// `let mut` lambda a labeled call reads, so reordering the call is safe and
// it is accepted.
fn f(a: Int, b: Int) -> Int {
  a + b
}

fn main() -> Int {
  let mut g = (x~: Int, y~: Int) -> Int { x - y }
  let first = g(y = 3, x = 10)
  first + f(b = {
    let mut g = 0
    g = 1
    g
  }, a = 0)
}
