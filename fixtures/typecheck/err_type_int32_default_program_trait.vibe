// #3824: only the shipped `Default` is borrowed for `Int32`. This program
// declares its own, whose `Int` impl returns a value outside 32 bits, so the
// bound stays refused at `Int32`.
trait Default {
  default() -> Self
}

impl Default for Int {
  default() -> Int {
    4294967296
  }
}

fn fresh[T: Default](_ x: T) -> T {
  T::default()
}

fn main() -> Unit allows Console {
  let a: Int32 = 1
  println("\{fresh(a)}")
}
