// #3434: a shadowing `let` the normalize pass cannot type, whose checker type
// is a struct with no Show, is refused like any value of that type. Before,
// the missing-Show check read the outer binding's `Option[Int]`, skipped the
// refusal, and the value rendered as an address (Codex on #3453).
struct Raw {
  n: Int
}

fn render(b: Option[Int]) -> String {
  let b = match b {
    Some(v) => Raw::{ n: v },
    None => Raw::{ n: 0 }
  }
  "\{b}"
}
