// #4091: a getter's result stored into a container of the region body makes
// that element module storage.

let sink: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  sink
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    Array::set(init, at = 0, value = get_sink())
    Array::push(Array::get(init, at = 0), value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
