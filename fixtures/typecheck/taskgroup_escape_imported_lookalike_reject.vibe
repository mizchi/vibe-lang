// #3360 (Codex on #3467): `hold` comes from a module that declares look-alike
// `TaskGroup` / `TaskHandle` structs; it still keeps its argument.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_lookalike_dep_ok.vibe { Slot, hold }

fn main() -> Unit allows Exception + Console {
  let s: Slot[TaskHandle[Int]] = Slot::{ v: None }
  let r = TaskGroup::run((n) -> {
    hold(s, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
