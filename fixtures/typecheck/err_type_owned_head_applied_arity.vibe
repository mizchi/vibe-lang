// A compiler-owned head applied to more arguments than it takes is refused.
// `ArrayBuilder[String, Int]` has no declaration behind it, so its arguments
// were never counted: the parameter accepted the `ArrayBuilder[Int]` built
// below, froze it into an `Array[String]`, and the run printed `first=`
// followed by the bytes at the address the `7` was read as.
fn take(b: ArrayBuilder[String, Int]) -> Array[String] {
  ArrayBuilder::freeze(b)
}

fn main allows Console {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, 7)
  let xs = take(b)
  println(String::concat("first=", Array::get(xs, 0)))
}
