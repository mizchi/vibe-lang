// #3371: a tuple of names in a payload position cannot fail, but neither
// lowering destructures it, so its names bind nothing. Where an outer binding
// has the same name, the arm body read THAT one: measured on main, this `run`
// answered 100 for a payload of (10, 3). The message asks for a `let` in the
// arm body.
type P2 = (Int, Int)

effect Pair {
  Diff(P2) -> Int
}

fn run() -> Int {
  let a = 100
  handle {
    perform Pair::Diff((10, 3))
  } with {
    Pair::Diff((a, b)) => resume(a)
  }
}
