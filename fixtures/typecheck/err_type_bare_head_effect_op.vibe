// #3536: an effect operation whose result is a bare generic head let the
// handler resume with an `Array[String]` that `perform` handed on as an
// `Array[Int]`.
effect Src {
  Get() -> Array
}

fn read() -> Array[Int] with Src {
  perform Src::Get()
}

fn main allows Console {
  let ys = handle {
    read()
  } with {
    Src::Get() => resume(["hello"])
  }
  println("\{Array::get(ys, 0) + 1}")
}
