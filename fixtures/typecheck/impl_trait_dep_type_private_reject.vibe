// #3551 review: `Sealed::seal` takes the dependency's private `Secret`, which
// no importer can spell. An impl written for `Int` there is refused; one
// that leaves the parameter unannotated is generic over it and accepted
// (`fixtures/impl_trait_dep_type_test.vibe`).
import ./impl_trait_dep_type_dep_ok.vibe {
  call_sealed, trait Sealed
}

struct P {
  k: Int
}

impl Sealed for P {
  seal(x: Int) -> P {
    P::{ k: x }
  }
  open_it(self) -> String {
    "k=\{self.k}"
  }
}

fn main allows Console {
  println(call_sealed(P::{ k: 0 }))
}
