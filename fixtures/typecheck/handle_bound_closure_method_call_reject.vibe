// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The closure performs through a method call, whose row the
// checker resolves at the call. `g()` answered `6` from the dead handler.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

struct Foo {
  n: Int
}

fn Foo::ask(self: Foo) -> Int with Ask {
  perform Ask::Get() + self.n
}

fn main() -> Unit allows Console {
  let foo = Foo::{ n: 1 }
  let g = handle {
    () -> foo.ask()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
