// #3488: a helper whose result is a fresh `let mut` built and returned is
// not an alias of its parameter (control for the fail-closed binder rule).
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn build(c: Cell) -> Wrap {
  let mut w = Wrap::{ cell: Cell::{ v: None } }
  w = Wrap::{ cell: Cell::{ v: None } }
  w
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(build(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
