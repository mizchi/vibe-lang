// #2985 review: under a kinded handler a `throw` whose payload kind cannot
// be read from its syntax (here a builtin call's result) is refused with a
// message naming the edit -- bind the payload with an annotated `let` first
// -- rather than with a phantom `Exception::Throw` requirement. The arm
// catches every exception at run time, so an unresolved payload is one it
// cannot be trusted to bind at `Int`. The same program with
// `let n: Int = String::length("abcd"); throw(n)` is accepted
// (fixtures/exception_kinded_handle_nesting_test.vibe).
fn main() -> Int {
  handle {
    throw(String::length("abcd"))
  } with { Exception[Int]::Throw(n) => n * 100 }
}
