// #3408 (Codex on #3409): a `let mut` lambda that the body never calls
// performs nothing, so `mid` does not take `mk`'s `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let mut cb = () -> mk()
  0
}
fn top() -> Int with Box[String] {
  mid()
}
