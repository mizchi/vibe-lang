// #3301: or-pattern alternatives count toward a handler's exhaustiveness, so
// an operation none of them names is still reported. Before the fix an
// all-or-pattern handler was not checked for exhaustiveness at all.
effect Logger {
  A -> Int
  B -> Int
  C -> Int
}

fn main() -> Int {
  handle {
    perform Logger::A + perform Logger::B
  } with Logger {
    A|B => resume(7)
  }
}
