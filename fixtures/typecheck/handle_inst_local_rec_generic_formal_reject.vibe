// #3027 (Codex on #3047): a recursive local generic lambda (`let rec`) names
// its own formal in its row, and it is resolved at the call exactly like a
// plain `let`'s -- `let rec` binds through its own arm, which recorded no
// declaration, so `State[S]` stayed an open spelling and the `State[Int]`
// handler below was accepted for a call that requires `State[String]`.
effect State[S] {
  Get() -> S
}

fn main() -> Int {
  let rec get = [S](x: S) -> Int with State[S] {
    1
  }
  handle {
    get("abc")
  } with { State::Get() => resume(7) }
}
