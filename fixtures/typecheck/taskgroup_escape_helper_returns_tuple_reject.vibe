// #3343 (Codex on #3359): the handle comes back in a tuple declared
// `(Int, TaskHandle[Int])`. This compiled and the handle was joined after its
// group closed; the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn pair(h: TaskHandle[Int]) -> (Int, TaskHandle[Int]) {
  (1, h)
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[(Int, TaskHandle[Int])] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    c.v = Some(pair(TaskGroup::spawn(n, () -> { 41 })))
    1
  })
  let after = match c.v {
    Some((_, h)) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
