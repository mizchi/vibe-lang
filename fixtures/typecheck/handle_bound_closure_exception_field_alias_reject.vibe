// #3596: #3584's program with the builder called through a local alias
// written inside the handled body. `g` stands for `mk`, whose closure in
// `Box`'s field throws; the alias was not followed, so `vibe check` was
// clean while `f()` threw with no handler around it.
// fixtures/handle_bound_closure_field_alias_test.vibe holds the accepted
// shapes.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let b = handle {
    let g = mk
    g()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
