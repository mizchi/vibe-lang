// #4050 (Codex on #4061): an element of `next`'s `Some((element, rest))` read
// out of `self.items` is a part of `outer`, however fresh the continuation:
// the write keeps the region value past the region.
trait Iterator[T] {
  next(Self) -> Option[(T, Self)]
}

struct Gen {
  items: Array[Array[MutList[Int]]];
  left: Int
}

impl Iterator for Gen {
  next(self) -> Option[(T, Gen)] {
    if self.left > 0 {
      Some((Array::get(self.items, at = 0), Gen::{ items: [], left: 0 }))
    } else {
      None
    }
  }
}

fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let xs = Gen::{ items: [outer], left: 1 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in xs {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
