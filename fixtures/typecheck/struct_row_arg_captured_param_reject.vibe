// #3589 (Codex review on #3594): a parameter naming a captured cell's row
// does not make the row the lambda's own -- `choose` returns the top-level
// `shared` on one branch, so two calls must see that cell at one row.
struct Cell[r] {
  mut run: () -> Int with r
}

fn pure_one() -> Int {
  1
}

fn noisy() -> Int with Console {
  println("noisy ran")
  2
}

let shared = Cell::{ run: pure_one }

let choose = (other) -> if true {
  shared
} else {
  other
}

fn setter() -> Unit with Console {
  let c = choose(Cell::{ run: noisy })
  c.run = noisy
}

fn quiet() -> Int {
  let c = choose(Cell::{ run: pure_one })
  (c.run)()
}

fn main() -> Unit allows Console {
  setter()
  println("\{quiet()}")
}
