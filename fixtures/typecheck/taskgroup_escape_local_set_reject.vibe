// #3343 (Codex on #3359): a body-local array of boxes gets a box holding the
// handle with `Array::set`, and the array is returned. This compiled and the
// handle was joined after its group closed; the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: Option[TaskHandle[Int]]
}

fn main() -> Unit allows Exception + Console {
  let bs = TaskGroup::run((n) -> {
    let bs = [Box::{ h: None }]
    Array::set(bs, 0, Box::{ h: Some(TaskGroup::spawn(n, () -> { 41 })) })
    bs
  })
  let after = match Array::get(bs, 0).h {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("after=\{after}")
}
