//# #3326 review: an IMPORTED type spelled like a compiler-owned head is the
// dependency's struct, not the compiler's, so a `Future[Int]` here may not
// hold an array. user_owned_head_import_reverse_reject.vibe is the other
// direction.

import ./user_owned_head_dep_ok.vibe {
  Future
}

fn main() -> Unit allows Console {
  let f: Future[Int] = [1]
  println(__to_string(f.v))
}
