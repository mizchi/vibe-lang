effect Ask {
  Get() -> Int
}
fn ask_once() -> Int with Ask {
  perform Ask::Get()
}
fn run(ask_once~: () -> Int) -> Int with Ask {
  let f: () -> Int with Ask = ask_once; handle {
    f()
  } with { Ask::Get() => resume(7) }
}
export fn main() -> Int {
  handle {
    run(ask_once = () -> Int {
      99
    })
  } with { Ask::Get() => resume(8) }
}
