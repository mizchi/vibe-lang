// #3033 (decided): a row that names only exception kinds does not cover an
// erased callback even when it also carries an effect variable. The callback
// slot spells `Exception` beside `e`, so a caller's erased exception is
// matched by that label and `e` is left empty: the caller's row would be
// just `Exception[Wrapped]`, and a caller's `Exception[Wrapped]` arm would
// then read any payload `f` raises as a `Wrapped`. Letting `e` carry the
// callback's row (`f: () -> Int with e`) is the honest spelling, pinned by
// fixtures/exception_kinded_row_rowvar_callback_test.vibe.
enum Wrapped {
  Wrapped(String)
}

fn guarded[e](f: () -> Int with Exception + e) -> Int with Exception[Wrapped] + e {
  let r = f()
  if r < 0 {
    throw(Wrapped("negative"))
  } else {
    r
  }
}

fn main() -> Int {
  handle { guarded(() -> 41) } with { Exception::Throw(_) => 0 }
}
