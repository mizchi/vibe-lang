// #3371: a literal nested inside a constructor payload (`Some(1)`) was
// ignored as well; for `perform Ask::Get(Some(1))` the later `Ask::Get(_)`
// arm ran and `run` answered 5.
effect Ask {
  Get(Option[Int]) -> Int
}

fn run() -> Int {
  handle {
    perform Ask::Get(Some(1))
  } with {
    Ask::Get(Some(1)) => resume(100);
    Ask::Get(_) => resume(5)
  }
}
