// #3343: the helper called as a method. `c.put(handle)` reaches `Cell::put`,
// which stores its argument in the receiver; the receiver is the outer `c`.
// This compiled and the handle was joined after its group closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn Cell::put[T](self: Cell[T], v: T) -> Unit {
  self.v = Some(v)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    c.put(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
