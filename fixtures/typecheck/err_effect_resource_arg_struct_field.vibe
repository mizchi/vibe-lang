// ADR-0094 (#3143, Codex on #4020): a resource argument written in a
// declaration-owned function type -- here a struct field -- is checked like
// one on a function.
effect Kv[R: Store::Bucket] {
  Get(String) -> String
}

resource Logs: Store::Queue

struct Holder {
  run: () -> String with Kv[Logs]
}
