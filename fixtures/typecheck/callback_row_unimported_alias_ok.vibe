// #3351 control: importing the alias the callback row names lets the perform
// be checked against it (`Pts` is `Pt`, which is still not imported here).
import ./callback_row_unimported_dep_ok.vibe {
  effect Box, run_pts, Pts, mk_pt
}

fn producer() -> Int with Box {
  run_pts(() -> {
    perform Box::Put(mk_pt(3))
  })
}
