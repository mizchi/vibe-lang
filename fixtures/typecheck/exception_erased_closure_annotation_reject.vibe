// #3601: a closure literal annotated with the erased `with Exception` row
// throws an `Int`. A call through the binding read only that row, so the
// erased arm read the `Int` 7 as a `String` (`len=14`). The binding is now
// charged the kinds the closure's row lets out.
fn main() -> Unit allows Console {
  let f: () -> Int with Exception = () -> throw(7)
  let r = handle {
    f()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
