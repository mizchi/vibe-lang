// #3416: a lambda assigned to a `let mut` binding that is never called does
// not run, so `mid` does not take `mk`'s `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let mut cb = () -> 0
  cb = () -> mk()
  0
}
fn top() -> Int with Box[String] {
  mid()
}
