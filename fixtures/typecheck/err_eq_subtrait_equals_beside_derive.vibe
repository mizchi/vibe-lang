// #3562: `derive (Eq)` gives `Box` one `equals`, and the impl of `Key`, a
// subtrait of `Eq`, writes another. A caller through `[U: Eq]` ran the
// derived one and a caller through `[T: Key]` the impl's: the same two values
// answered `true` and `false`.
trait Key: Eq {
  tag(Self) -> Int
}

struct Box[T] {
  v: T
} derive (Eq)

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

fn helper[U: Eq](a: U, b: U) -> Bool {
  U::equals(a, b)
}

fn outer[T: Key](a: T, b: T) -> Bool {
  helper(a, b)
}

fn outer2[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn answers() -> String {
  let p: Box[Int] = Box::{ v: 1 }
  let q: Box[Int] = Box::{ v: 1 }
  "direct=\{helper(p, q)} through=\{outer(p, q)} own=\{outer2(p, q)}"
}
