// #4050 control: writing a value that holds no region (a length read from a
// region value) into an outer element is accepted.
// `main` answers 10 * the block's value + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[Int] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in boxes {
      Array::push(a, value = MutList::length(cell))
    }
    1
  }
  v * 10 + Array::length(outer)
}
