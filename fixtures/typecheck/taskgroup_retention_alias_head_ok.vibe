import @vibe/concurrent {
  TaskGroup, TaskHandle
}
struct Box[T] { mut v: T }
type Sender[T] = Box[T]
fn main() -> Int allows Exception {
  let outside: Box[Option[Sender[Int]]] = Box::{ v: None }
  let _ = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> 42)
    let result: Sender[Int] = Box::{ v: TaskHandle::join(h) }
    outside.v = Some(result)
    0
  })
  match outside.v {
    Some(b) => b.v,
    None => 0
  }
}
