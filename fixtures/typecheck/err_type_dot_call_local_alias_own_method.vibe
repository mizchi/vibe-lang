// #3890: a dot-call reaches a method through an import alias only when that
// alias carries the type's own method. A local alias's own `fn M::tag` is not
// a method of `L`, so `l.tag()` is still refused.
struct L {
  v: Int
}

type M = L

fn M::tag(_ m: M) -> String {
  "M"
}

fn main() -> Unit {
  let l = L::{ v: 1 }
  let t = l.tag()
  ()
}
