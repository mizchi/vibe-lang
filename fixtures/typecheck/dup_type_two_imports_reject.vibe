// #3036: `make_err` returns dup_type_a_dep_ok's `Err`, and `Err` is imported
// from dup_type_b_dep_ok, a different declaration with the same name. Types
// are identified by their bare name, so the two were unified and `e.name`
// read a's `{ code: Int }` through b's layout with `vibe check` clean.
import ./dup_type_a_dep_ok.vibe { make_err }
import ./dup_type_b_dep_ok.vibe { Err }

fn read() -> String {
  let e: Err = make_err()
  e.name
}
