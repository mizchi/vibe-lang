// #4091: an element of a getter's result is module storage too: the getter
// returns a module-level array of arrays, and the push writes into one of
// them.

let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

let boxes_top: Array[Array[MutList[Int]]] = [kept]

fn get_boxes() -> Array[Array[MutList[Int]]] {
  boxes_top
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let bx = Array::get(get_boxes(), at = 0)
    Array::push(bx, value = a)
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
