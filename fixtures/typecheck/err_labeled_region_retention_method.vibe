struct Sink {
  items: Array[() -> Array[Int]]
}

fn Sink::stash(self: Sink, tag: Int, value: () -> Array[Int]) -> Unit {
  Array::push(self.items, value = value)
}

fn main() -> Int {
  let outside: Sink = Sink::{ items: [] }
  let _ = region r {
    let values = MutList::empty(r)
    outside.stash(tag = 0, value = () -> Array[Int] {
      MutList::to_array(values)
    })
    0
  }
  42
}
