// #3537: `selected` is bound to a call result, so it is not generalized (the
// value restriction). Calling it still fixes the callback row's payload: the
// `#einst:` label the instantiation of `make` recorded is read, not the
// marked row text, which names `make`'s formal and no type of this module.
import ./callback_row_result_generic_dep_ok.vibe {
  consume_int, consume_string, effect Box, make
}
fn caller() -> Int {
  let selected = Array::get([make], 0)
  consume_string(selected("abc"))
}
