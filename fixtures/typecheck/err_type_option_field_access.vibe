//# #2820 CONTROL for the message split. An `Option` receiver was already
//# refused before #2820 -- it is the row the issue uses as its control -- and
//# it must keep the GENERAL non-struct wording, not the builtin one. A field
//# read on an `Option` has a second plausible edit (match it, or `?`), so
//# "call `Option::v(...)`" would be the wrong lead; the builtin-container
//# message is reserved for receivers that have no fields under any reading.
fn read(m: Option[Int]) -> Int {
  m.v
}

export fn main() -> Int {
  read(Some(3))
}
