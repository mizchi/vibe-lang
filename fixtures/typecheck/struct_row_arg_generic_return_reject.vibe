// #3589: a signature returning `Holder[e]` whose body stores `noisy` binds
// `e` to `Console`, so a caller of `make` is charged it, as it is for
// `fn make[e]() -> () -> Int with e { noisy }`.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

fn make[e]() -> Holder[e] {
  Holder::{ run: noisy }
}

fn quiet() -> Int {
  (make().run)()
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
