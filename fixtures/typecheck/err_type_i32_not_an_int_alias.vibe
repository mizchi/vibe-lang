//# #3727: `i32` is not a spelling of `Int`.
//#
//# It used to resolve to `Int`, which is 63-bit (ADR-0105), so this program
//# checked clean and printed `y=2147483648` -- a value no 32-bit reading of
//# `2147483647 + 1` gives. It is now an unknown type, and the message leads
//# with the edit: write `Int`.
fn main() -> Unit allows Console {
  let x: i32 = 2147483647
  let y: i32 = x + 1
  println("y=\{y}")
}
