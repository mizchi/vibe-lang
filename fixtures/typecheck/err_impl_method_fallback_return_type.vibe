// #3538: a bodyless impl dispatches to `P::name` wherever it is declared, so
// that function is held to the trait. Behind another statement it was not,
// and the caller added 1 to a String's address.
trait Name { name(Self) -> Int }

struct P { x: Int }

impl Name for P

fn helper() -> Int { 1 }

fn P::name(self: P) -> String { "hello" }

fn main allows Console {
  let n: Int = Name::name(P::{ x: 1 }) + helper()
  println("n=\{n}")
}
