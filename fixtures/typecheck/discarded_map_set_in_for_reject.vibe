// #4142: the measured instance -- the body of a statement `for` throws the
// new map away on every iteration, so `taken` stays empty.
fn count_distinct(names: Array[String]) -> Int {
  let taken: Map[String, Bool] = Map::new()
  for n in names {
    Map::set(taken, key = n, value = true)
  }
  Map::size(taken)
}

fn main() -> Int {
  count_distinct(names = ["a", "b", "a"])
}
