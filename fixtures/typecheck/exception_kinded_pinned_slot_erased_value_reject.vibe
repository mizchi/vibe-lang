// #3540: a slot `with Exception[Int] + e` refuses a value whose row is the
// erased `with Exception`, as the closed slot `with Exception[Int]` does. The
// kind label matches the whole exception family, so the erased label is not
// put in `e`, and the kinded handle inside `guarded` trusts that `e` holds no
// exception. Before the fix the slot took the value, and the `Exception[Int]`
// arm caught the message "bare" and answered `330712481796`.
fn guarded[e](f: () -> Int with Exception[Int] + e) -> Int with e {
  handle {
    f() + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn erased_thrower() -> Int with Exception {
  throw("bare")
}

fn main() -> Int {
  handle {
    guarded(erased_thrower)
  } with { Exception::Throw(m) => String::length(m) }
}
