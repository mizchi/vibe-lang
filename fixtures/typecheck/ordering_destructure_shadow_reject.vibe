// #3042 (Codex on #3063): a top-level destructuring binder spelled like a
// prelude constructor shadows it as `let Less = 1` does, so `derive (Ord)`
// beside it is refused rather than building this `Int`.
struct Holder { Less: Int }

let Holder::{ Less } = Holder::{ Less: 1 }

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = Less
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
