// #2985 review (Codex P0): a throw of ANOTHER kind under a kinded handler.
// The outer row authorized `Exception[IoErr]`, so the checker believed the
// throw propagated past the `Exception[String]` handle; at run time the
// handle caught it and read the enum as a String (`505`).
enum IoErr {
  NotFound(String)
}

fn fail() -> Int with Exception[IoErr] {
  throw(NotFound("cfg"))
}

fn main() -> Int allows Exception[IoErr] {
  handle {
    fail()
  } with { Exception[String]::Throw(s) => String::length(s) }
}
