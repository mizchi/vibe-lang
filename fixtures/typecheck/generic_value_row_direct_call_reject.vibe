// #3387: a generic function's own row, taken as a value through a join and
// called directly: `T` is `Int` at this call, and the `Box` in scope is
// `Box[String]`.
effect Box[T] {
  Put(T) -> Int
}
fn put_it[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn caller(c: Bool) -> Int with Box[String] {
  let f = if c { put_it } else { put_it }
  f(12345)
}
