// #3488 (Codex on #3492): a helper's match binders hold what its scrutinee
// holds, so a result built from them hands the parameter back.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap(c: Cell) -> Wrap {
  match Some(c) {
    Some(x) => Wrap::{ cell: x },
    None => Wrap::{ cell: Cell::{ v: None } }
  }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
