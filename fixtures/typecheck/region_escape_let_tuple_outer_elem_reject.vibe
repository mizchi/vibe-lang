// #4050: a destructuring `let` is a one-arm match: its binders are parts of
// the value, here the outer array itself.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let (a, _) = (outer, 1)
    Array::push(a, value = cell)
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
