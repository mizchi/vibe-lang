// #3576: a local lambda's own `[e]` is instantiated at the call; the effect
// it is instantiated to is charged to the enclosing function, which declares
// none here.
effect Tick {
  Step(Int) -> Int
}

fn ticks() -> Int with Tick {
  perform Tick::Step(10)
}

fn quiet() -> Int {
  let call = [e](f: () -> Int with e) -> Int with e {
    f() + 1
  }
  call(ticks)
}
