// #3520: `sleep` in a closure handed to a parameter that expects no `Async`
// (`TaskGroup::run`'s body). A row on the literal would not help -- the
// callee runs it as a plain function -- so the refusal asks to move the call
// out, and points a task at `TaskGroup::spawn_suspend`.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Int allows Exception + Async {
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn(g, () -> 1)
    sleep(10)
    TaskHandle::join(a)
  })
}
