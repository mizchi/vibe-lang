// The `@vibe/concurrent` handles have no text form: the group a
// `TaskGroup::run` body receives printed `n=1052`.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let _ = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 1 })
    println("n=\{n}")
    TaskHandle::join(h)
  })
}
