// #3275 control: a lambda that declares its own row replaces the enclosing
// row's instantiation, so `with Box[String]` lets it send a `String` inside a
// `with Box[Int]` function; the local handle answers it at `String`.
effect Box[T] {
  Put(T) -> Int
}

fn producer() -> Int with Box[Int] {
  let g = () -> Int with Box[String] { perform Box::Put("hello") }
  let n = handle {
    g()
  } with {
    Box::Put(v) => resume(String::length(v))
  }
  n + perform Box::Put(1)
}
