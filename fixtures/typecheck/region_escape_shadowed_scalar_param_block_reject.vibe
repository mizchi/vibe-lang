// #4091 (Codex on #4106): the shadowing `let n = xs` sits in a nested block.

let sink: Array[MutList[Int]] = []

struct Box {
  items: Array[MutList[Int]]
}

fn wrap(n: Int, xs: Array[MutList[Int]]) -> Box {
  let b = {
    let n = xs
    Box::{ items: n }
  }
  b
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let b = wrap(n = 0, xs = sink)
    Array::push(b.items, value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
