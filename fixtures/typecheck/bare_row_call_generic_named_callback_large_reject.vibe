// #3483: bare_row_call_generic_named_callback_reject in a program with more
// than 256 top-level bindings, where bare-row propagation reads callees
// through a snapshot of the checker env. `mk` must still be seen as generic.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn pass(f: (Int) -> Int with Box) -> Int with Box {
  f(12345)
}
fn mid() -> Int with Box {
  pass(f = mk)
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}

