// ADR-0124 decision 3 (#2656), r4: a call to a `with Db` callee outside every
// handler is refused at the call. Walked under a row WITH `Db`, this call was
// satisfied by the label, and the run would have reached an unhandled `Db`.
effect Db {
  Get(Int) -> Int
}

fn app() -> Int with Db {
  perform Db::Get(1)
}

fn main allows Console + Db {
  let a = app()
  let v = handle {
    app()
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{a} \{v}")
}
