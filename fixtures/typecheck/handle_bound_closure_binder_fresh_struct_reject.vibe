// Codex review on #4066: a closure that performs what a `handle` answers,
// written in a scrutinee beside a plain closure, is still handle-bound in
// its own part. The binder of that part reaching a function that keeps it
// is refused, as `let h = () -> perform Ask::Get(); keep(f = h)` is. Only
// the binder of the plain part stays plain
// (fixtures/handle_bound_closure_binder_test.vibe).
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

struct Pair {
  a: () -> Int;
  b: () -> Int
}

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn main() -> Unit allows Console {
  handle {
    match Pair::{
      a: () -> perform Ask::Get() + 1,
      b: () -> 7
    } {
      Pair::{ a, b } => {
        let _ = keep(f = a)
      }
    }
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()}")
}
