// #3609: a `return` hands its value to the enclosing function's declared
// result. A result typed with the erased row alone carries only messages, so
// `bad`, which lets out an `Int`, is still refused there.
fn bad() -> Int with Exception {
  throw(7)
}

fn make(c: Bool) -> () -> Int with Exception {
  if c {
    return bad
  }
  () -> 1
}

fn main() -> Unit allows Console {
  let r = handle {
    make(true)()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
