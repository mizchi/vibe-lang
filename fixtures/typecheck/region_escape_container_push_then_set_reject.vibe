// #4091: the same write and redirect in the other order, inside a loop: the
// second iteration pushes into `sink`. What a container may hold is read
// over its whole scope, so the order does not matter.

let sink: Array[MutList[Int]] = []

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    for i in [0, 1] {
      Array::push(Array::get(init, at = 0), value = c)
      Array::set(init, at = 0, value = sink)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
