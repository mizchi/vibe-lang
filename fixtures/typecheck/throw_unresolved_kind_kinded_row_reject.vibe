// #2964: `with Exception[K]` is a promise about the kinds that leave the
// function. A `throw` whose payload kind this check cannot resolve (a pattern
// binder, a field) used to be admitted under ANY kinded row, so `f` promised
// `Exception[IoErr]` and threw a `ParseErr`.
enum IoErr {
  NotFound(String)
}

enum ParseErr {
  Eof
}

fn f(x: Option[ParseErr]) -> Int with Exception[IoErr] {
  match x {
    Some(e) => throw(e)
    None => 0
  }
}

export fn main() -> Int {
  handle {
    f(None)
  } with { Exception::Throw(_e) => 1 }
}
