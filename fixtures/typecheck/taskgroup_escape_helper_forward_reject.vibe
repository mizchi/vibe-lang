// #3343: the helper is declared BELOW the call, so the call is checked before
// the helper's own body; it is found by name all the same. This compiled and
// the handle was joined after its group closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put_later(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}

fn put_later[T](c: Cell[T], v: T) -> Unit {
  c.v = Some(v)
}
