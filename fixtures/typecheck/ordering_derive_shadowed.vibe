// #3042: `derive (Ord)` builds `Less` / `Equal` / `Greater` of the prelude
// `Ordering`. A module that declares one of those constructors for its own enum
// has no prelude `Ordering` to build, so the derive is refused with the rename
// that fixes it instead of lowering a `compare` whose `Less` is a `Verdict`.

enum Verdict {
  Less;
  Same;
  More
}

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
