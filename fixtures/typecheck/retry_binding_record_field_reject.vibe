// #3518 review: the control for `retry_binding_record_field_ok`. `?u`,
// recovered from the record field, keeps `Log`, so reading the field back as
// a pure callback is refused.
effect Log {
  Emit(Int) -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn two[T, e](a: T, mk: () -> T with Exception + e) -> T with Exception + e {
  mk()
}

fn main() -> Int allows Exception {
  let r = two(record { cb: None }, () -> { record { cb: Some(logged) } })
  let record { cb: c } = r
  let pure: Option[() -> Int] = c
  0
}
