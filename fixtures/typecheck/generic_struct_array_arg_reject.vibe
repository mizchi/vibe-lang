//# #3326: the argument side of generic_struct_array_let_reject.vibe.
//
// A call argument goes through the same `check_assignable`, so `take([7])`
// compiled clean and `c.value` read the array's packed representation.

struct Cell[T] {
  value: T
}

fn take(c: Cell[Int]) -> Int {
  c.value
}

fn main() -> Unit allows Console {
  println(__to_string(take([7])))
}
