// #3591: the derived renderer expands an alias, so `Option[Array[Ints]]` with
// `type Ints = Set[Int]` goes through `Set::to_string`, which `Set` does not
// provide. This was reported clean and the build stopped with an internal
// compiler error. It is refused at `ViaAlias` now, naming the edit.
import @vibe/core { struct Set }

type Ints = Set[Int]

struct ViaAlias {
  v: Option[Array[Ints]]
} derive (Show)
