// #3095: a callback parameter's row, read inside a nested generic lambda.
// `f`'s `State[S]` names `w`'s formal, which no nested binder rebinds, so the
// lambda's `with State[Int]` does not cover it.
effect State[S] {
  Get() -> S
}

fn w[S](x: S, f: () -> Int with State[S]) -> Int {
  let g = [T](y: T) -> Int with State[Int] {
    f()
  }
  0
}
