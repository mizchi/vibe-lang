import @vibe/concurrent {
  TaskGroup, TaskHandle
}
struct Cell[T] { mut v: Option[T] }
fn main_like() -> Int with Exception {
  let outer = Cell::{ v: None }; TaskGroup::run((g) -> {
    let b = loop (step = 0) {
      break TaskHandle::join(TaskGroup::spawn(g, () -> {
        42
      }))
    }; outer.v = Some(b); 0
  }); 0
}
