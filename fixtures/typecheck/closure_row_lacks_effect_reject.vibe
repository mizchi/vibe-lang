// #3520: an explicitly annotated closure literal whose row lacks `Console`.
// The function around it declares `Console`, so the row that lacks it is the
// closure's: the report used to blame `main` and tell it to add what it
// already had.
fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn main() -> Int allows Console + Exception {
  run(() -> Int with Exception {
    println("x")
    1
  })
}
