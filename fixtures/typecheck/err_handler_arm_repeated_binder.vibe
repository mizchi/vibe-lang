// A handler arm binds its payloads in order, so `Pair::Put(x, x)` let the
// second payload shadow the first: the program below printed `r=2`. A name
// bound twice in one handler arm is refused, as `(x, x)` in a `match` is.
effect Pair {
  Put(Int, Int) -> Int
}

fn work() -> Int with Pair {
  perform Pair::Put(1, 2)
}

fn main() -> Int {
  handle {
    work()
  } with {
    Pair::Put(x, x) => resume(x)
  }
}
