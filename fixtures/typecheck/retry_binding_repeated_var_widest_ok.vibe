// #3518 review: a variable the effect-stripped retry binds at more than one
// position takes the occurrence every other fits into -- here the `Log`
// function, which the pure one fits by pure-to-effectful subsumption. Bound
// from whichever occurrence the walk met first, `T` was the pure function and
// `fallback`, the `Log` one, was refused for dropping `Log`.
effect Log {
  Emit(Int) -> Unit
}

fn plain() -> Int {
  1
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn both() -> (() -> Int, () -> Int with Log) {
  (plain, logged)
}

fn choose2[T, e](mk: () -> (T, T) with Exception + e, fallback: T) -> T {
  fallback
}

fn pick() -> () -> Int with Log {
  choose2(both, logged)
}

fn main() -> Int {
  handle {
    logged()
  } with {
    Log::Emit(_) => resume(())
  }
}
