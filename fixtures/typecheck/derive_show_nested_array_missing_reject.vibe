// #3591: `derive (Show)` renders an `Array` field element by element, so
// `v: Array[MutMap[Int, Int]]` goes through `MutMap::to_string`, which
// `MutMap` does not provide. This was reported clean and the build stopped
// with an internal compiler error (`MutMap::to_string` reached code generation
// unresolved). It is refused at `S` now, naming the edit.
import @vibe/core { struct MutMap }

struct S {
  v: Array[MutMap[Int, Int]]
} derive (Show)
