//# The declarations the import_alias_namespace_* fixtures import: a
//# capitalized FUNCTION, which an import list cannot tell from a type by its
//# spelling, and a struct.

/// A function whose name is capitalized like a type's.
export fn MakeTag(n: Int) -> Int {
  n + 1
}

/// A struct the importer may take under a builtin namespace's name.
export struct Record {
  n: Int
}
