// #1511 / #2121: the `handle` eligibility boundary, pinned per callee shape.
//
// docs/cheatsheet.md described this boundary in prose and drifted: it recorded
// a local-closure callee as REJECTED when it compiles, and the diagnostic text
// still claims a closure-parameter call is rejected when it is accepted. Prose
// cannot be checked; these can.
effect Ask { Get() -> Int }

fn ask_once() -> Int with Ask { perform Ask::Get() }

// A local binding aliasing the performing top-level `fn`, annotated with the
// row. Rejected by the #1347 "can never fire" check -- the body reaches no
// syntactic `perform` and calls an opaque value -- NOT by handle eligibility.
fn main() -> Unit {
  let f: () -> Int with Ask = ask_once
  let _ = handle { f() } with Ask { Get() => resume(1) }
}
