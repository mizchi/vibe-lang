// #3651 control (Codex on #3657): a top-level binding that takes a builtin's
// spelling is the program's value. Its call is not judged as the builtin: it
// is a call through a value, so it is positional (ADR-0120 Phase 4b), and
// `println(1)` against the builtin would be a type error.
fn identity(_ x: Int) -> Int {
  x
}

let println = identity

fn main() -> Unit {
  let _ = println(1)
  ()
}
