let sink: Array[MutList[Int]] = []

fn make(flag: Bool) -> Array[Array[MutList[Int]]] {
  let local: Array[Array[MutList[Int]]] = [[]]
  Array::set(local, at = 0, value = sink)
  if flag {
    return local
  }
  [[]]
}

fn wrap(flag: Bool) -> Array[Array[MutList[Int]]] {
  make(flag = flag)
}

fn main() -> Unit allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let nested = wrap(flag = true)
    Array::push(Array::get(nested, at = 0), value = c)
    1
  }
  let _ = v
  ()
}
