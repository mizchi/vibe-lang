// #3640: the caller of a helper written `fn start(g: TaskGroup, f: () -> Int)`
// may not hand the task a non-Send capture, exactly as with
// `TaskGroup[rg, e]`. A captured `Array` used to be accepted.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn start(g: TaskGroup, f: () -> Int) -> TaskHandle[Int] {
  TaskGroup::spawn(g, f)
}

fn main() -> Unit allows Console + Exception {
  let xs = [1]
  let w = TaskGroup::run((g) -> {
    let h = start(g, () -> Array::length(xs))
    TaskHandle::join(h)
  })
  println("w = \{w}")
}
