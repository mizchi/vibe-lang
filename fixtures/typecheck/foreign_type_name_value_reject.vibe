//# #3026: an imported signature names the dependency's `Err`, and this module
//# declares its own `Err`. Types are identified by their bare name, so before
//# the fix the two unified: `e.name` read the dependency's Int field as a
//# String (measured: `String::length(e.name)` answered 6) with `vibe check`
//# clean.
import ./foreign_type_name_dep.vibe { make_err }

struct Err {
  name: String
}

fn main() -> Unit {
  let e: Err = make_err()
  let _ = String::length(e.name)
}
