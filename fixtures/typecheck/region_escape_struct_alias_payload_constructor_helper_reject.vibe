// #3862 (Codex on #3868): a local that holds a parameter INSIDE a literal
// (`let held = Holder::{ v: first }`) is still an alias of it, so the
// parameter's region provenance reaches the tail constructor through it.
struct Slot {
  callback: () -> Array[Int]
}

struct Holder[T] {
  v: T
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Holder[A], B] {
  let held = Holder::{ v: first }
  Pair(held, second)
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(holder, _) = escaped
  Array::length(holder.v.callback())
}
