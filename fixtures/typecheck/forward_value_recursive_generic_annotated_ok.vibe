// #3493: complete recursive generic signatures retain independent call types.
let recurse = [T](x: T, depth: Int) -> T {
  if depth == 0 {
    x
  } else {
    recurse(x = x, depth = depth - 1)
  }
}

fn main() -> Int {
  let label: String = recurse(x = "ok", depth = 2)
  recurse(x = 5, depth = 3) + String::length(label)
}
