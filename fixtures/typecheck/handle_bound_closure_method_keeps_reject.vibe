// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. A method stores it in its receiver. `g()` answered `6` from
// the dead handler after `vibe check` was clean.
effect Ask {
  Get() -> Int
}

struct Holder {
  fs: Array[() -> Int]
}

fn Holder::keep(self: Holder, f: () -> Int) -> Unit {
  Array::push(self.fs, f)
}

fn main() -> Unit allows Console {
  let holder = Holder::{ fs: [] }
  handle {
    let h = () -> perform Ask::Get() + 1
    holder.keep(h)
  } with { Ask::Get() => resume(5) }
  let g = Array::get(holder.fs, 0)
  println("g=\{g()}")
}
