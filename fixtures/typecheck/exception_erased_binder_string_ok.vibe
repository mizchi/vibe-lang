// #3541 control: the erased `Exception::Throw(m)` binder is a String, so the
// uses that read it as the message -- printing, concatenation, returning it
// where the handle produces a String -- keep compiling, and so do the uses
// that accept any type (rethrowing it, passing it to a generic parameter).
fn f() -> Int with Exception {
  throw("str")
}

fn id[T](x: T) -> T {
  x
}

fn rethrow() -> Int with Exception {
  handle { f() } with { Exception::Throw(m) => {
    let _same = id(m)
    throw(m)
  } }
}

fn main allows Console {
  let shown = handle { f(); "ok" } with { Exception::Throw(m) => String::concat("failed: ", m) }
  println(shown)
  let n = handle { rethrow() } with { Exception::Throw(m) => {
    println(m)
    0
  } }
  println("\{n}")
}
