//# #2848: the formal of a NESTED generic lambda is refused too. `U` is the
//# lambda's own binder, recorded when its `EFn` header is checked, and the
//# read sits inside that binder's open declaration. The message names `U`, the
//# binder the reader sees at the site.
struct Crate {
  payload: Int
}

fn outer() -> Int {
  let inner = [U](m: U) -> Int {
    m.payload
  }
  inner(7)
}

export fn main() -> Int {
  outer()
}
