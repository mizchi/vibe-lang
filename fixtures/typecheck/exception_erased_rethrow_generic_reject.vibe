// #3541 (#3551 review): a value caught by the erased `Exception::Throw(m)` arm
// is of no known kind, however it is rethrown. `throw(id(m))` used to record
// the inferred `String`, so `g` compiled declaring `Exception[String]` while
// rethrowing `f`'s `Int`, and the `Exception[String]::Throw(s)` arm below
// read that `Int` as a String: the program printed `len=14`. The edit is the
// kinded arm (`Exception[Int]::Throw(m)`) or the erased `with Exception` row.
fn f() -> Int with Exception[Int] {
  throw(7)
}

fn id[T](x: T) -> T {
  x
}

fn g() -> Int with Exception[String] {
  handle { f() } with { Exception::Throw(m) => throw(id(m)) }
}

fn main allows Console {
  let r = handle { g() } with { Exception[String]::Throw(s) => String::length(s) }
  println("len=\{r}")
}
