// #3589 (Codex review on #3594): the control for struct_row_arg_nested_reject.
// `Box[t]` passes `t` to `Other[t]`, whose `t` is an ordinary type parameter
// (no field names it in a function row), so `Box`'s `t` stays an ordinary
// type parameter even though it is spelled like a row: `Box::{ v: Other::{
// x: 5 } }` is a `Box[Int]`, and a stored function is an ordinary value.
struct Other[t] {
  x: t
}

struct Box[t] {
  v: Other[t]
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn get_x(b: Box[Int]) -> Int {
  b.v.x
}

fn wrap[t](x: t) -> Box[t] {
  Box::{ v: Other::{ x: x } }
}

fn run_box(b: Box[() -> Int with Console]) -> Int with Console {
  (b.v.x)()
}

fn main() -> Unit allows Console {
  let b = Box::{ v: Other::{ x: 5 } }
  let n: Int = get_x(b) + get_x(wrap(1))
  let f = Box::{ v: Other::{ x: say } }
  println("\{n} \{run_box(f)}")
}
