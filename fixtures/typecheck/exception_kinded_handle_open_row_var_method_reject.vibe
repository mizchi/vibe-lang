// #3540: the same hole in a method, with the callback wrapped in a local
// closure that declares the variable as its row. Calling the closure runs `e`
// inside the kinded handle exactly as `f()` would.
struct Runner {
  n: Int
}

fn Runner::go[e](self: Runner, f: () -> Int with e) -> Int with e {
  handle {
    let h = () -> Int with e {
      f()
    }
    h() + self.n
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn main() -> Int {
  let p = Runner::{ n: 1 }
  p.go(() -> 41)
}
