struct State {
  tag: Int
}

let state = State::{ tag: 2 }

fn get_state() -> State {
  state
}

struct Box {
  tag: Array[MutList[Int]]
}

let sink: Array[MutList[Int]] = []

fn main() -> Unit allows Exception {
  region r {
    let c = MutList::empty(r)
    let boxes: Array[Box] = []
    let get_state = () -> Box::{ tag: sink }
    Array::push(boxes, value = Box::{ tag: get_state().tag })
    let b = Array::get(boxes, at = 0)
    Array::push(b.tag, value = c)
  }
}
