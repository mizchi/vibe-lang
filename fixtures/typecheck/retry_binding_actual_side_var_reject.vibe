// #3518 review: `(T, T)` against `([], [1])`. The retry's occurrences are
// `Array[?u]` and `Array[Int]`; choosing the first left `?u` -- a variable of
// the ACTUAL side -- unbound, so `T` could later be read as `Array[String]`
// while the value holds an `Int`. The other occurrence is unified with the
// choice, so `T` is `Array[Int]` and the annotation is refused.
fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let r: Array[String] = second(() -> ([], [1]))
  Array::length(r)
}
