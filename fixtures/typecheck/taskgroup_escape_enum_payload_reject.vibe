// #3343 (Codex on #3359): the handle is written into an outer cell as an
// enum payload, whose nominal type `Slot` does not show it. This compiled and
// the handle was joined after its group closed; the write is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

enum Slot {
  Has(TaskHandle[Int]);
  Empty
}

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[Slot] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    c.v = Some(Has(TaskGroup::spawn(n, () -> { 41 })))
    1
  })
  let after = match c.v {
    Some(Has(h)) => TaskHandle::join(h),
    _ => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
