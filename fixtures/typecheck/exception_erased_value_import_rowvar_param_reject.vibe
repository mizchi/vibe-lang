// #3601 (Codex on #3605): the imported `fail` lets an `Int` out through its
// erased row. Passed to a parameter typed `with Exception + e`, the value's
// exception is matched to the slot's `Exception` and `e` is left empty
// (#3033), so the erased arm read the `Int` 7 as a `String`.
import ../modules/exception_erased_row_dep.vibe {
  fail
}

fn run[e](f: () -> Int with Exception + e) -> Int with Exception + e {
  f()
}

fn main() -> Unit allows Console {
  let n = handle {
    run(fail)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{n}")
}
