// #3623: the field's row `Box[F[Int]]` at `Holder[Option]` is
// `Box[Option[Int]]`, with the argument still applied to the constructor.
// The closure stored there performs `Box` at `Array[Int]`, which the handler
// a call through the field passes would read as an `Option[Int]`, so it is
// refused naming the instantiated row. The accepted shapes are in
// fixtures/struct_field_row_kinded_formal_test.vibe.
effect Box[T] {
  Put(T) -> Unit
}

struct Holder[F[_]] {
  f: () -> Int with Box[F[Int]]
}

fn drive_o(f: () -> Int with Box[Option[Int]]) -> Int {
  handle {
    f()
  } with {
    Box::Put(_) => resume(())
  }
}

fn main() -> Int {
  let h = Holder[Option]::{ f: () -> {
    perform Box::Put([1, 2])
    5
  } }
  drive_o(h.f)
}
