// ADR-0124 (#2656): an `extern effect` crosses the entry boundary the way a
// standard provider does. The catalog classifies it as a capability from its
// declaration; the host supplies it, and the runner refuses before `main`
// when no provider is bound (scripts/test_wasm_import_gate.sh).
extern effect Kv {
  get(String) -> String
}

fn main() -> Unit allows Kv {
  let _ = Kv::get("a")
  ()
}
