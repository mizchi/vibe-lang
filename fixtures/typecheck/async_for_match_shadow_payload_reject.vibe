// #3198 review (Codex): the match binder `it` shadows the parameter `it`,
// and its own head comes from `o`'s annotation, not from the parameter.
trait AIter[T] {
  next(Self) -> Future[Option[(T, Self)]]
}

struct Countdown {
  n: Int
}

impl AIter for Countdown {
  next(self) -> Future[Option[(Int, Countdown)]] {
    Future::ready(if self.n > 0 {
      Some((self.n, Countdown::{ n: self.n - 1 }))
    } else {
      None
    })
  }
}

fn total(o: Option[Countdown], it: Int) -> Int {
  let mut acc = it
  match o {
    Some(it) => {
      for x in it {
        acc = acc + x
      }
      ()
    },
    None => ()
  }
  acc
}

fn main() -> Int {
  total(Some(Countdown::{ n: 3 }), 0)
}
