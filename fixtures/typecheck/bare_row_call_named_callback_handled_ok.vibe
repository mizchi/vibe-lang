// #3408: `mk` passed by name to `run`, whose row does not name `Box` (it
// handles its callback's), so `mid` does not take `mk`'s `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn run(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
fn mid() -> Int with Box {
  run(mk)
}
fn top() -> Int with Box[String] {
  mid()
}
