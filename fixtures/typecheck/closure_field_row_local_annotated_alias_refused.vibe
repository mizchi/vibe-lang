// Codex on #3620: an alias under an annotation (`let alias: () -> Int = g`)
// reaches the stamp as an identity ascription of `g`, so it was not tracked
// as an alias: `g` kept the row-free calling convention while the field's
// reader passed the handler, and the call trapped after a clean
// `vibe check`. It is refused like a bare alias
// (fixtures/typecheck/closure_field_row_local_alias_refused.vibe).
effect Box[T] {
  Put(T) -> Unit
}

struct Holder[T] {
  f: () -> Int with Box[T]
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let alias: () -> Int = g
  let h = Holder[String]::{ f: alias }
  drive(h.f) + drive(tick)
}
