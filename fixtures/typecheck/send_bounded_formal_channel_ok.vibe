// #3554 control: with the bound declared on `relay`'s binder, the body may
// hand its `T` to `Channel::bounded`, and the caller's `Int` is checked Send
// at `relay`'s own call.
import @vibe/concurrent {
  TaskGroup, TaskHandle, Channel, Sender, Receiver
}

fn relay[T: Send](x: T) -> Option[T] with Exception {
  TaskGroup::run((g) -> {
    let (tx, rx) = Channel::bounded(g, 1)
    Sender::send(tx, x)
    Receiver::recv(rx)
  })
}

fn main() -> Int allows Exception {
  match relay(3) {
    Some(v) => v,
    None => 0
  }
}
