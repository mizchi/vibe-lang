// #3360: helpers declared in another module. `put` and `Cell::stash` keep
// their second argument (they store it in the cell), `peek` and `count` keep
// nothing, and `relay` keeps what it hands to `put`.
export struct Cell[T] {
  mut v: Option[T]
}

export fn put[T](c: Cell[T], x: T) -> Unit {
  c.v = Some(x)
}

export fn relay[T](c: Cell[T], x: T) -> Unit {
  put(c, x)
}

export fn Cell::stash[T](c: Cell[T], x: T) -> Unit {
  c.v = Some(x)
}

export fn peek[T](c: Cell[T], x: T) -> Bool {
  match c.v {
    Some(_) => true,
    None => false
  }
}

export fn count[T](xs: Array[T]) -> Int {
  Array::length(xs)
}
