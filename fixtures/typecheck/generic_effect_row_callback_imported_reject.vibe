// #3311 (Codex on #3340): an imported generic callee has no declaration in the
// importer, so its callback row's `T` is read from the marker its published
// type carries: `run_len("abc", ..)` gives `T` = `String`, and the lambda's
// `Box::Put(12345)` is refused. Before, the lambda was handed nothing: this
// checked clean, and `run_len`'s arm measured the `Int` with `String::length`
// (it answered `24690`).
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_len
}

fn producer() -> Int with Box {
  run_len("abc", () -> {
    perform Box::Put(12345)
  }, (s) -> String::length(s))
}
