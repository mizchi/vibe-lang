// #1503 follow-up: the marker-trait gate applies through the supertrait scan
// too. `MBase` has no methods, so it dispatches to the builtin `==` / `<`, and
// those are reference equality on `Array` (#1526) -- widening the supertrait
// scan must not let this through the back door.
trait MBase

trait MChild: MBase

impl [T] MChild for Array[T]

fn use_base[T: MBase](x: T) -> T {
  x
}

export let v: () -> Int = () -> {
  Array::length(use_base([1, 2, 3]))
}
