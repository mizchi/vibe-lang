// #3590: `Pair[x, Int]` returned as `Pair[x, String]`. The open `x` made the
// pair not ground, so the failed unify was tolerated as possibly polymorphic
// and `p.b` read the `7` as a `String`. No choice of `x` reconciles the
// second argument, so it is refused.
struct Pair[A, B] {
  a: A
  b: B
}

fn conv[x](h: Pair[x, Int]) -> Pair[x, String] {
  h
}

fn main() -> Unit allows Console {
  let p = conv(Pair::{ a: 1, b: 7 })
  println("len=\{String::length(p.b)}")
}
