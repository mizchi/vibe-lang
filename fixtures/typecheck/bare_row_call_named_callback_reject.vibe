// #3408 (Codex on #3409): `mk` passed by name to the bare forwarder `pass` is
// run by `pass`, whose row forwards it, so `mid` requires `mk`'s `Box[Int]`
// and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn pass(f: () -> Int with Box) -> Int with Box {
  f()
}
fn mid() -> Int with Box {
  pass(mk)
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
