// #2965: an erased `with Exception` callee under a kinded handler may raise
// any kind, and the arm would read it as `IoErr` (it trapped `unreachable`).
enum IoErr {
  NotFound(String);
  Denied(String)
}

enum ParseErr {
  Eof;
  Bad(Int)
}

fn parse() -> Int with Exception {
  throw(Bad(7))
}

fn main() -> Unit allows Console {
  let r = handle { parse() } with {
    Exception[IoErr]::Throw(e) => match e {
      NotFound(_p) => 1
      Denied(_p) => 2
    }
  }
  println("r = \{r}")
}
