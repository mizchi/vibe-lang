// #3595: calling `f` performs `Console + e`, and `m1` declares only `e`. A
// call site instantiates `e` from what the argument adds beyond the
// parameter's concrete `Console`, so nothing would charge `Console` to the
// caller: before the fix the body was accepted (a declared row variable
// authorized every label) and the pure `q` printed.
fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

fn m1(f: () -> Int with Console + e) -> Int with e {
  f()
}

fn q() -> Int {
  m1(noisy)
}

fn main() -> Unit allows Console {
  println("\{q()}")
}
