// #3476: `cell_of` is private to the dependency and not imported. The call
// used to compile and run the dependency's private function.
import @vibe/concurrent { TaskGroup }
import ./undefined_call_private_dep_fn_dep_ok.vibe { Cell }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let c: Cell = cell_of(h)
    c.v
  })
  println("r=\{r}")
}
