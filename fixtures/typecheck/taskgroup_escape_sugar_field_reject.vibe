// #3276: `taskgroup { g => body }` is a literal `TaskGroup::run` call, so its
// body is checked inside the group's region too. Storing the group's handle
// in a generic struct field bound before it compiled before the fix.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = taskgroup { g => {
    c.v = Some(TaskGroup::spawn(g, () -> { 41 }))
    1
  } }
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
