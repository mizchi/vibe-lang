//# #3326 review: the array-layout exemption belongs to the compiler's head.
//
// The compiler's own `FixedArray[T]` is a phantom over `Array[T]`'s layout,
// so it may flow into an `Array` slot. A program's own `struct FixedArray[T]`
// is an ordinary struct: passing one where an `Array` is declared reads the
// struct as an array. Declared AFTER its use, so the check cannot depend on
// declaration order.

fn total(xs: Array[Int]) -> Int {
  Array::length(xs)
}

fn main() -> Unit allows Console {
  println(__to_string(total(FixedArray::{ v: 1 })))
}

struct FixedArray[T] {
  v: T
}
