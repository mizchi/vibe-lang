//# #3326 review (Codex P2 on #3352): `FixedArray` is a reserved spelling.
//
// The builtin `FixedArray[T]` is a phantom over `Array[T]`'s layout, so its
// values may flow into an `Array` slot. A program's own `struct FixedArray`
// resolves to the same `CtNamed("FixedArray", args)`, and nothing tells the
// two apart: refusing every `FixedArray` where an `Array` is declared turned
// away the builtin's own `FixedArray::make(2, 1)` below, and accepting them
// let an array be read as the struct (`let x: FixedArray[Int] =
// FixedArray::make(2, 7); x.v` checked clean). The declaration is refused,
// with the edit, the way `struct Array[T]` is.

struct FixedArray[T] {
  v: T
}

fn take(xs: Array[Int]) -> Int {
  Array::length(xs)
}

fn main() -> Unit allows Console {
  println(__to_string(take(FixedArray::make(2, 1))))
}
