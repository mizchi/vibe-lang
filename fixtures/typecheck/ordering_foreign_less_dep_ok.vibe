// #3042 (Codex on #3063): the dependency half of
// ordering_derive_imported_foreign_less.vibe -- an enum unrelated to the
// prelude `Ordering` that happens to have a `Less` constructor.

export enum Verdict {
  Less;
  Same;
  More
}

export fn verdict_of(n: Int) -> Verdict {
  if n < 0 {
    Less
  } else if n == 0 {
    Same
  } else {
    More
  }
}
