// #3301 (Codex on #3337): neither effect lowering matches a handler arm's
// payload patterns -- both dispatch on the operation alone -- so the split
// would compile `P(1)|Q(2) => resume(100)` as `P(_)` and `Q(_)`, and
// `perform Pick::P(3)` answered 100. The or-pattern arm is refused instead,
// and the message names the edit: one arm per operation, testing the payload
// with `if` in its body.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

fn main() -> Int {
  handle {
    perform Pick::P(3)
  } with Pick {
    P(1)|Q(2) => resume(100);
    P(_) => resume(5);
    Q(_) => resume(7)
  }
}
