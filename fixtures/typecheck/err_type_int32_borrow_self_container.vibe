// #3730: `Int`'s impl of a trait is not borrowed for `Int32` when a method
// can write or hand out a `Self` -- here through an `Array[Self]` -- since it
// would store an `Int` outside 32 bits.
trait Fill {
  fill(Self, Array[Self]) -> Unit
}

fn push_big(_ xs: Array[Int]) -> Unit {
  Array::push(xs, value = 2147483648)
}

impl Fill for Int {
  fill(self, xs) -> Unit {
    push_big(xs)
  }
}

fn go[T: Fill](x: T, xs: Array[T]) -> Unit {
  T::fill(x, xs)
}

fn main() -> Unit allows Console {
  let xs: Array[Int32] = []
  let a: Int32 = 1
  go(x = a, xs = xs)
  println("\{Array::get(xs, at = 0)}")
}
