// #3102 review: a lambda formal spelled `Array` passes its own formal. With no
// arguments it cannot be the builtin (which always carries one), so both rows
// name the same rigid formal and match.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn outer() -> Int {
  let f = [Array](v: Array) -> Bool with State[Array] {
    get(v) > 0
  }
  0
}
