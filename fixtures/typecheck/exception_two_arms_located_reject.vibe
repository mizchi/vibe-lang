// #3548: the one-exception-arm refusal is located at the second exception
// arm, the one that can never run.
fn fail_int() -> Int with Exception[Int] {
  throw(7)
}

fn caught() -> Int {
  handle {
    fail_int()
  } with { Exception[String]::Throw(s) => String::length(s); Exception[Int]::Throw(n) => n + 1000 }
}
