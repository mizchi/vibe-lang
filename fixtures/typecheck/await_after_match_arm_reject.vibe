// #3177: a match arm's binder ends with its arm. The `await` after the match
// is the builtin again, so the row-free lambda calling it is refused.
fn read_it(fut: Future[Int]) -> Int {
  let picked: Option[(Future[Int]) -> String] = Some((f: Future[Int]) -> "hello")
  let n = match picked {
    Some(await) => String::length(await(Future::ready(5))),
    None => 0
  }
  let later = () -> await(fut)
  n + later()
}
