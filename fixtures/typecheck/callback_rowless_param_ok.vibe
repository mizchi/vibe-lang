// #3387: the accepted side of callback_rowless_param_reject.
effect Box[T] {
  Put(T) -> Int
}
fn apply(f: () -> Int) -> Int {
  f()
}
fn caller() -> Int with Box[String] {
  apply(() -> {
    perform Box::Put("abcd")
  })
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
