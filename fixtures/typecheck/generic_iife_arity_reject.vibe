//# #2890: the same unchecked call, seen through arity rather than types.
//
// One parameter, two arguments. Accepted before, because a `CtForAll` callee
// never reached the branch that compares the counts.

fn main() -> Unit allows Console {
  let v = ([U](u: U) -> U { u })(1, 2)
  println(__to_string(1))
}
