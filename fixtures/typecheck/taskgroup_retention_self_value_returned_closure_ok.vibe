// #4054: the same returned closure, with no task handle behind the binder,
// leaves the task group.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}
fn main() -> Int allows Exception {
  let result = TaskGroup::run((g) -> {
    let _ = TaskHandle::join(TaskGroup::spawn(g, f = () -> 42))
    let rec mk = (n: Int) -> () -> Int {
      () -> {
        let again = mk
        n
      }
    }
    mk(1)
  })
  result()
}
