// #3051: the handler instantiates `State[Int]`, but this call of the imported
// `get` requires `State[String]`. Accepted before, with the imported callee's
// row formal left unresolved.
import ./generic_row_formal_dep_ok.vibe { State, get }

fn main() -> Int {
  handle {
    get("abc")
  } with {
    State::Get() => resume(7)
  }
}
