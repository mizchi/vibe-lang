// #3371: a payload pattern that cannot fail and binds nothing already means
// `_`, so the message asks for `_` -- one spelling for "ignore the payload".
type P2 = (Int, Int)

effect Pair {
  Diff(P2) -> Int
}

fn run() -> Int {
  handle {
    perform Pair::Diff((10, 3))
  } with {
    Pair::Diff((_, _)) => resume(1)
  }
}
