// #3416 (Codex on #3436): a generic callee called through a `let mut` alias
// is instantiated at the call, as through a `let` alias, so `h(1)` gives
// `Box[Int]`, which the caller covers.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn mid() -> Int with Box {
  let mut h = mk
  h(1)
}
fn top() -> Int with Box[Int] {
  mid()
}
