// #3036: only `Left` and `Right` are selected, but each import projects the
// `Err` its payload names under that bare name, so the two different `Err`s
// would be unified exactly as two direct imports of `Err` would.
import ./dup_type_closure_left_dep_ok.vibe { Left }
import ./dup_type_closure_right_dep_ok.vibe { Right }

fn code(l: Left) -> Int {
  match l {
    A(e) => e.code
  }
}
