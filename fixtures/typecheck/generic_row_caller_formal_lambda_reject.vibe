// #3053: a nested generic lambda's formal is rigid inside it too. `get(1)`
// requires `State[Int]`, which the lambda's `with State[T]` does not cover.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller() -> Int with State[String] {
  let inner = [T](y: T) -> Int with State[T] {
    get(1)
  }
  inner("abc")
}
