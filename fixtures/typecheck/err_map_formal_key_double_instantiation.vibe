// #2334: a generic helper whose type parameter keys a map, instantiated at a
// key the builtin map has no implementation for at all. The key type exists
// only in the instantiation, so the instantiation is what is refused.
fn put[K, V](m: Map[K, V], k: K, v: V) -> Map[K, V] {
  Map::set(m, k, v)
}

fn main {
  let _ = put(Map::new(), 1.5, 10)
  ()
}
