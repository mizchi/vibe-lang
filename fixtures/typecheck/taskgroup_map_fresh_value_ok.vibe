// #3495: a map built inside the body over a fresh cell is local to it.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let m = Map::from_pairs([("k", Cell::{ v: None })])
    m["k"].v = Some(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
