// #3584 (Codex on #3594): the handle is checked before the helper it calls,
// and the helper reaches the throwing closure through a local alias
// (`let f = mk`), whose callee type is recorded only when the helper's
// body is checked. Read before that, the helper looked like it built
// nothing that throws, the answer was remembered, and `vibe check` was
// clean while `(b.f)()` threw with no handler around it.
struct Box {
  f: () -> Int
}

fn main() -> Unit allows Console {
  let b = handle {
    helper()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}

fn helper() -> Box with Exception[Int] {
  let f = mk
  Box::{ f: f() }
}

fn mk() -> (() -> Int) with Exception[Int] {
  () -> throw(7)
}
