// #4049: a top-level function handed to `Array::map` by name inside a region
// stores each region list in a module-level array. Only a closure literal
// was re-checked, so this compiled and the list outlived its region, while
// the same call in `for c in [cell]` is refused.
let kept: Array[MutList[Int]] = []

fn stash(c: MutList[Int]) -> Int {
  Array::push(kept, value = c)
  0
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let _ = Array::map([cell], f = stash)
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
