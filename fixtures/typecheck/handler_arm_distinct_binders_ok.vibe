// The accepted counterpart of err_handler_arm_repeated_binder: distinct
// payload binders, and wildcards, which bind nothing and may repeat.
effect Pair {
  Put(Int, Int) -> Int
}

fn work() -> Int with Pair {
  perform Pair::Put(1, 2)
}

fn main() -> Int {
  let a = handle {
    work()
  } with {
    Pair::Put(x, y) => resume(x - y)
  }
  let b = handle {
    work()
  } with {
    Pair::Put(_, _) => resume(0)
  }
  a + b
}
