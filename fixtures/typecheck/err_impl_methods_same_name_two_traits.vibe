// #3962: impls of two different traits for one type both define `size`, so
// both methods are bound to `Note::size`. The report names both impls and
// is located at the second one's header.

trait Size {
  size(Self) -> Int
}

trait Len {
  size(Self) -> Int
}

struct Note {
  n: Int
}

impl Size for Note {
  size(self) -> Int { self.n }
}

impl Len for Note {
  size(self) -> Int { 1 }
}
