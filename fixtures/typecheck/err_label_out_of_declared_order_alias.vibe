// ADR-0120 D2 through a local transparent alias (#3889): `M::sub` is placed by
// `L::sub`'s declaration, so its labels follow that declared order too.
struct L { v: Int }

fn L::sub(_ l: L, by: Int, and: Int) -> Int {
  l.v - by * 10 - and * 4
}

type M = L

fn run(m: M) -> Int {
  M::sub(m, and = 3, by = 2)
}
