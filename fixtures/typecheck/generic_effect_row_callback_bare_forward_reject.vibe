// #3311 control: a callback row with no type argument (`with Box`) hands the
// lambda nothing, so it keeps the instantiation of the `handle` around the
// call, which `pass` forwards the perform to. That handle reads an `Int`, so
// the `String` payload is still refused. Handing the lambda a fresh
// instantiation here would have let it through.
effect Box[T] {
  Put(T) -> Int
}

fn pass(f: () -> Int with Box) -> Int with Box {
  f()
}

fn main_like() -> Int {
  handle {
    pass(() -> {
      perform Box::Put("x")
    })
  } with {
    Box::Put(n) => resume(n + 1)
  }
}
