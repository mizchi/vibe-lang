// #3488 control (Codex on #3492): a `match` whose arms are all scalars
// copies a scalar, even when one arm reads an outer binding.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell;
  tag: Int
}

fn fwd(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer_tag = 7
  let flag = true
  let r = TaskGroup::run((n) -> {
    let w = Wrap::{ cell: Cell::{ v: None }, tag: match flag {
      true => outer_tag,
      false => 0
    } }
    fwd(w, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
