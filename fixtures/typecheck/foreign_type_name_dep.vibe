// Dependency of the foreign_type_name_* fixtures (#3026): a type named `Err`
// that an importer may also declare for itself.
export struct Err {
  code: Int
}

export fn make_err() -> Err {
  Err::{ code: 3 }
}

export fn fail_err() -> Int with Exception[Err] {
  throw(Err::{ code: 7 })
}

export effect Read[F[_]] {
  Get() -> F[Int]
}

export fn read_g[G[_]]() -> Int with Read[G] {
  0
}

export type Pair[A, B] = (A, B)

export struct Holder[H[_, _]] {
  value: Int
}

export fn hold() -> Holder[Pair] {
  Holder::{ value: 1 }
}
