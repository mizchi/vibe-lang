// #3541: the erased arm hands `m` to a top-level function that keeps it, and
// code outside every arm reads it back as a `String`. `f` threw an `Int`, so
// `recall()` returned the Int 7 typed as a String (`len=14`). The arm reads
// its binder over a body that raises `Exception[Int]`, so it is refused.
let saved: Array[String] = []

fn remember(s: String) -> Unit {
  Array::push(saved, s)
}

fn recall() -> String {
  Array::get(saved, 0)
}

fn f() -> Int with Exception[Int] {
  throw(7)
}

fn keep() -> Int {
  handle { f() } with { Exception::Throw(m) => {
    remember(m)
    0
  } }
}

fn main allows Console {
  let _ = keep()
  println("len=\{String::length(recall())}")
}
