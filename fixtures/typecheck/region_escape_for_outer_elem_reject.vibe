// #4050: a `for` binder bound to an element of a container declared outside
// the region is that element: writing a region value into it keeps the value
// in the outer container after the region ends. `Array::get(boxes, at = 0)`
// was refused; the loop variable was judged as a binding of the region body.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in boxes {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
