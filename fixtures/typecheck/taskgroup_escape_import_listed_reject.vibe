// #3360 (Codex on #3473): a helper its module publishes through
// `export { .. }`, and one published as an alias of another, are summarized
// like a function declared `export`.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_import_dep_ok.vibe { put_listed }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    put_listed(outer, h)
    1
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
