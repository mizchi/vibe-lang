// #3387 (Codex on #3407): the members of a joined callee disagree on `Box`,
// but a callback that never performs `Box` is not tied to either.
import ./callback_row_joined_generic_dep_ok.vibe {
  effect Box, first, second
}
fn caller() -> Int with Box {
  Array::get([first, second], 0)("abc", 17, () -> 1)
}
