// #3343 (Codex on #3359): the counterpart of taskgroup_escape_shadowed_head_ok.
// A program's own `struct Sender[T]` that holds the HANDLE itself still
// carries the group's region, by its field, and the outer write is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Sender[T] {
  value: T
}

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[Sender[TaskHandle[Int]]] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    c.v = Some(Sender::{ value: TaskGroup::spawn(n, () -> { 41 }) })
    1
  })
  let after = match c.v {
    Some(s) => TaskHandle::join(s.value),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
