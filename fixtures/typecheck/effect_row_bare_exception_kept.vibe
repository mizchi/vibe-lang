// #3539 control: a `with Exception` slot still accepts a `with Exception` and
// a `with Exception[K]` value, and a `with e` slot accepts either.
fn call_e(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn apply[T](x: T, f: () -> Int with e) -> Int with e {
  f()
}

fn thrower() -> Int with Exception {
  throw("dropped")
  1
}

fn kinded() -> Int with Exception[String] {
  throw("k")
  1
}

fn ok() -> Int with Exception {
  call_e(thrower) + call_e(kinded) + apply(0, thrower)
}
