// Codex on #4057 control: a `let mut` callback mapping an `Array[Int]`
// declared before the region. Its element is an `Int`, which holds nothing
// of the region, so the callback is not refused as untraceable.
fn main() -> Unit allows Exception + Console {
  let pre: Array[Int] = [1, 2]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mut inc = (x: Int) -> x + 1
    inc = (x: Int) -> x + 2
    let got = Array::map(pre, f = inc)
    Array::get(got, at = 1) + MutList::length(cell)
  }
  println("v=\{v}")
}
