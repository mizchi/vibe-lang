// #3625: `Float` carries every builtin impl `Double` does, `Ord` included, but
// `<` on an erased formal reaches no witness and lowers to the builtin
// comparison, which reads a `Float`'s box rather than its value. The bound is
// refused at `Float` exactly as at `Double`, and the message names the edit.
fn smaller[T: Ord](x: T, y: T) -> Bool {
  x < y
}

fn check() -> Bool {
  smaller(2.5f, 1.5f)
}
