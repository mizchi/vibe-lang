//# #4037: the correct spelling checks clean once the call is judged against
//# `Counter::size` / `Counter::add`, but the trait-dictionary pass still names
//# a dot call's receiver from its spelling, which knows nothing about an
//# unannotated lambda parameter, so the build fails with
//# `unknown struct field: size`. That is the typed-lowering work of #2501;
//# promote this row to `ok` when it lands.
struct Counter {
  n: Int
}

fn Counter::size(c: Counter) -> Int {
  c.n
}

fn Counter::add(c: Counter, k: Int) -> Int {
  c.n + k
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }, Counter::{ n: 2 }]
  Array::fold(xs, init = 0, f = (acc, c) -> acc + c.size() + c.add(k = 10))
}
