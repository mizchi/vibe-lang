// #3033: the exported-row refusal covers a STRUCT FIELD's function row too --
// `cb`'s kind `Pair` resolves to `(Int, Int)`, which a published row cannot
// spell, so the field would publish the alias name.
type Pair = (Int, Int)

export struct Holder {
  cb: () -> Int with Exception[Pair]
}

fn main() -> Int {
  0
}
