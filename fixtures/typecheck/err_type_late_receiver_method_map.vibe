//# #4037: the same through `Array::map`.
struct Counter {
  n: Int
}

fn Counter::size(c: Counter) -> Int {
  c.n
}

fn Counter::add(c: Counter, k: Int) -> Int {
  c.n + k
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }, Counter::{ n: 2 }]
  Array::length(Array::map(xs, f = (c) -> c.size(99)))
}
