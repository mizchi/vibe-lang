// #3095: the nested lambda's own `[N]` shadows the imported alias
// `type N = String` inside the lambda, so its `with State[N]` names the formal
// and does not cover a call requiring `State[String]`.
import ./generic_row_imported_alias_dep.vibe { State, get, N }

fn outer() -> Int {
  let f = [N](v: N) -> Int with State[N] {
    get("abc")
  }
  0
}
