// #3539 through a local alias: `g` is `apply`, and its argument (`fs[0]`) is
// one the effects walk cannot read, so `apply`'s row variable stayed open and
// the call charged nothing. Before the fix this compiled, and `pure_fn` ran a
// `Console` callback from a function declared pure.
fn apply(f: () -> Unit with e) -> Unit with e {
  f()
}

fn pure_fn(fs: Array[() -> Unit with Console]) -> Int {
  let g = apply
  g(fs[0])
  42
}
