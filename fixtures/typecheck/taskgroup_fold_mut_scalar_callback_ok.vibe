// Codex on #4057 control: a `let mut` scalar callback folding inside
// `TaskGroup::run` is not refused as untraceable.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, f = () -> { 41 })
    let mut add = (a: Int, b: Int) -> a + b
    add = (a: Int, b: Int) -> a + b + 0
    Array::fold([1, 2], init = TaskHandle::join(h), f = add)
  })
  println("r=\{r}")
}
