// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. A helper whose result holds no function stores it into an
// array the handled body declares, and the array is the handle's value.
// The call cannot return the closure, but the array it was handed beside
// can carry it out.
effect Ask {
  Get() -> Int
}

fn add(xs: Array[() -> Int], f: () -> Int) -> Unit {
  Array::push(xs, f)
}

fn main() -> Unit allows Console {
  let fs = handle {
    let xs: Array[() -> Int] = []
    add(xs, () -> perform Ask::Get() + 1)
    xs
  } with { Ask::Get() => resume(5) }
  let g = Array::get(fs, 0)
  println("g=\{g()}")
}
