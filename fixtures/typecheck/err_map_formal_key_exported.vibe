// #2334: an exported function that keys a map by its type parameter is
// refused. Another module's call is checked against the signature alone, so a
// scalar instantiation there could not be refused, and this body compares the
// key as a `String`.
export fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}

fn main {
  ()
}
