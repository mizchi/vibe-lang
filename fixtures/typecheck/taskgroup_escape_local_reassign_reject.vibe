// #3343 (Codex on #3359): a body-local `let mut` starts empty, is assigned a
// box holding the handle, and is written into an outer cell. This compiled
// and the handle was joined after its group closed; the write is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[Box] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    let mut x = None
    x = Some(Box::{ h: TaskGroup::spawn(n, () -> { 41 }) })
    c.v = x
    1
  })
  let after = match c.v {
    Some(b) => TaskHandle::join(b.h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
