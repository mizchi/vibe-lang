// #2985 review: an APPLIED kind (`Exception[Array[Int]]`) must bind its
// payload at that type too; it used to fall back to the erased binder, so
// returning `e` as the handle's Int compiled and exposed the array pointer.
fn f() -> Int with Exception[Array[Int]] {
  throw([1, 2])
}

fn main() -> Int {
  handle { f() } with { Exception[Array[Int]]::Throw(e) => e }
}
