// #3360 control: a closure literal handed to a library function inside a
// `TaskGroup::run` body may still write its handles into a binding declared in
// the body, and an outer binding may receive a joined result.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let totals: Array[Int] = []
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, () -> { 41 })]
    let local: Array[TaskHandle[Int]] = []
    let _ = Array::map(hs, (h) -> {
      Array::push(local, h)
      Array::push(totals, TaskHandle::join(h))
      0
    })
    Array::length(local)
  })
  println("r=\{r} total=\{Array::get(totals, 0)}")
}
