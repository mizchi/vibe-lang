// #3276: a task handle stored with `Array::set` into an outer array whose
// binding is annotated with a concrete type. The annotation closes the
// binding's type, so the scan of outer bindings after the body found no
// region in it; this compiled and printed `r=1 after=41`. The write is now
// refused where it happens, whatever the target's declared type.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let c: Array[Option[TaskHandle[Int]]] = [None]
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    Array::set(c, 0, Some(h))
    1
  })
  let after = match Array::get(c, 0) {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
