// #3022 review: a multi-argument generic effect row is refused where it is
// written for now; the handler comparison checks every argument position for
// when that support lands.
effect Pair[A, B] {
  First() -> A;
  Second() -> B
}

fn needs() -> Int with Pair[Int, String] {
  perform Pair::First()
}

fn main() -> Unit allows Console {
  let r = handle {
    needs()
  } with {
    Pair::First() => resume("x");
    Pair::Second() => resume(1)
  }
  println("\{r}")
}
