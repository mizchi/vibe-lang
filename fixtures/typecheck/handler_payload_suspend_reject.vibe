// #3371: an arm that stores `resume` takes the suspend lowering, which DID
// test the payload -- and trapped when no arm matched. The same arm under a
// tail-resumptive handle ignored it, and which lowering a handle takes
// depends on its other arms, so the payload pattern is refused here too.
effect Pick {
  P(Int) -> Int
}

fn run() -> Int {
  handle {
    perform Pick::P(1)
  } with {
    Pick::P(1) => {
      let k = resume
      k(100)
    };
    Pick::P(_) => {
      let k = resume
      k(5)
    }
  }
}
