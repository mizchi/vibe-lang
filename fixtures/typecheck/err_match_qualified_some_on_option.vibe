// #3421: a pattern used to keep only the variant name, so `Maybe::Some(n)` on an
// `Option` was read as the builtin `Some` and `f(mk(5))` answered `5`. Since
// #3422 the pattern keeps its owner, and is refused where it is written.
enum Maybe {
  Some(Int);
  Nothing
}

fn f(v: Option[Int]) -> Int {
  match v {
    Maybe::Some(n) => n,
    _ => 0
  }
}

fn mk(x: Int) -> Option[Int] {
  Some(x)
}

fn main() -> Unit {
  let _ = f(mk(5))
}
