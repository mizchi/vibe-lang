// #2334 control: a local generic that shares its spelling with a top-level
// function keyed by its type parameter is a different binding. Calling it at
// `Int` is fine; only the top-level function's own calls are restricted.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, key = k)
}

fn main {
  let look = [T](a: T, b: T) -> T { b }
  let _ = look(1, 2)
  ()
}
