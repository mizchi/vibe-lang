// #3343 (Codex on #3359): a literal body that RETURNS a struct built from the
// handle. The return check read the result's type, `Box`, which does not show
// its fields; this compiled and the handle was joined after its group
// closed. The return check now asks the body's tail, as the `region` block's
// does.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

fn main() -> Unit allows Exception + Console {
  let b = TaskGroup::run((n) -> {
    Box::{ h: TaskGroup::spawn(n, () -> { 41 }) }
  })
  println("after=\{TaskHandle::join(b.h)}")
}
