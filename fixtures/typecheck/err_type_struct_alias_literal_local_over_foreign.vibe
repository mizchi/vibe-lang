// #3837 (Codex on #3855): a local alias of an alias another module declares
// is refused too. Lowering renames `M` one hop, to `R`, and cannot see past
// it, so the literal would be laid out by its field set alone.
import ../_struct_alias_literal_reexport_dep.vibe {
  R
}

type M = R

fn main() -> Unit {
  let m = M::{ x: 1, y: "a", z: false }
  ()
}
