// #3424: a row-free closure bound by `let` and passed where its callee hands
// it evidence, but also used elsewhere, cannot take the parameter's row. It
// was compiled without a parameter for the evidence, and `run_str(k)` trapped
// with `null function or function signature mismatch`; the build is refused
// with the edit instead.
effect Box[T] {
  Put(T) -> Int
}

fn run_str(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(s) => resume(String::length(s))
  }
}

fn use_twice() -> Int {
  let k = () -> 5
  run_str(k) + k()
}
