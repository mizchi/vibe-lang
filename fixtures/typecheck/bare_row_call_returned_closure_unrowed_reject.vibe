// #3416: a returned closure is excused only for the labels its declared row
// names exactly. `() -> Int` names none, so the closure's `Box[Int]` is
// charged to `mid` and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> (() -> Int) with Box {
  () -> mk()
}
fn caller() -> Int with Box[String] {
  let f = mid()
  0
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
