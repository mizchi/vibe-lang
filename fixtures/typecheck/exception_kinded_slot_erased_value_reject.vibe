// Codex on #3021 (the mirror of #3015): a function value whose row is the
// ERASED `Exception` cannot fill a slot that names only a kind. `run` trusts
// its parameter's row, so its `Exception[String]` arm read `child`'s Int
// payload as a String.
fn child() -> Int with Exception {
  throw(7)
}

fn run(f: () -> Int with Exception[String]) -> Int {
  handle { f() } with { Exception[String]::Throw(s) => String::length(s) }
}

fn main() -> Int {
  run(child)
}
