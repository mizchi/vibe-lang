//# #2475: a declared type may not take a builtin type's spelling.
//#
//# The checker resolves a type NAME builtin-first, so in this program the
//# annotation `Int` is unconditionally the BUILTIN -- `fn bump(x: Int)` takes
//# an integer, and `s.value` on an `Int`-annotated parameter is refused as a
//# field access on a non-struct. The declaration therefore introduces a type
//# nobody can write down. Refusing it is what makes the checker's registry and
//# the equality channel's owners registry agree about the spelling.
struct Int {
  value: String
} derive (Eq)

export fn main() -> Int {
  0
}
