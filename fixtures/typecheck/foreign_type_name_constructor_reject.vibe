//# #3026: a nominal type passed bare to a higher-kinded slot is a
//# `CtConstructor`. `hold_box` returns `Holder1[Box]` naming the dependency's
//# `Box`, which is not this module's `Box`.
import ./foreign_type_name_dep.vibe { hold_box }

struct Box[T] {
  other: T
}

fn main() -> Unit {
  let _ = hold_box()
}
