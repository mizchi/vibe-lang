// #3540: a struct row argument (`Job[e]`) is a carrier of `e` with no
// exception label beside it, so `f`'s `Exception[Int] + e` does not pin `e`.
// Before the fix the pin held and this answered `274877906948`.
struct Job[e] {
  run: () -> Int with e
}

fn guarded[e](f: () -> Int with Exception[Int] + e, j: Job[e]) -> Int with e {
  handle {
    f() + (j.run)()
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded(() -> 1, Job::{ run: thrower })
  } with { Exception[String]::Throw(m) => String::length(m) }
}
