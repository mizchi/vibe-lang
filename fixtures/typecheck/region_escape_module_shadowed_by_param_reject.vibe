let sink: Array[MutList[Int]] = []

struct Holder[T] {
  value: T
}

let state = Holder::{ value: 0 }

struct Box {
  items: Array[MutList[Int]]
}

fn wrap(state: Holder[Array[MutList[Int]]]) -> Box {
  Box::{ items: state.value }
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    let b = wrap(state = Holder::{ value: sink })
    Array::push(b.items, value = cell)
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
