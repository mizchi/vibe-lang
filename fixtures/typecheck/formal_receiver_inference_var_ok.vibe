//# #2848 CONTROL. An ordinary not-yet-solved inference variable is NOT a type
//# parameter and keeps its tolerance. `p` is an unannotated lambda parameter:
//# at the read its type is a fresh variable that no `[T]` header recorded, so
//# `open_formal_name_for_var` answers "" and the read types as before. Inside
//# a generic body a formal is the same kind of variable (#2130), which is why
//# the refusal is keyed on the `eq_formal_vars` identity and not on "the
//# receiver is an unsolved variable" -- written that way, this file goes red.
//# The answer is pinned: `+ 100` rules out a first-field offset hit by luck.
struct Holder {
  v: Int
}

export fn main() -> Int {
  let f = (p) -> {
    p.v
  }
  f(Holder::{ v: 8 }) + 100
}
