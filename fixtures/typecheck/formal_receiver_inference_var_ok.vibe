//# #2848 CONTROL. An unannotated lambda parameter in ARGUMENT position is an
//# ordinary inference variable, not a type parameter: no `[T]` header recorded
//# it, and the call unifies it with `Holder` inside the enclosing body rather
//# than quantifying it. The read is recorded as pending while `p` is unsolved
//# and judged again at the end of `main`'s body, where it resolves to a struct
//# carrying `v` and is dropped. This is what goes red if the refusal were
//# keyed on "the receiver is an unsolved variable" instead of on identity, or
//# if the deferred pass refused a variable that merely resolved late. The
//# answer is pinned: `+ 100` rules out a first-field offset hit by luck.
//#
//# The `let`-bound spelling (`let f = (p) -> { p.v }; f(h)`) is NOT a control:
//# `let` generalizes `f`, and a read on a quantified parameter is refused
//# (`err_type_open_receiver_field_access_lambda`).
struct Holder {
  v: Int
}

fn apply(h: Holder, f: (Holder) -> Int) -> Int {
  f(h)
}

export fn main() -> Int {
  apply(Holder::{ v: 8 }, (p) -> {
    p.v
  }) + 100
}
