// #3572: a `TaskGroup` written without its region and row binds none of the
// struct's formals, so `_region_witness: (rg) -> rg` was read raw. `leak`
// checked clean and handed the `Int` 7 on as a `String` (`len=14`). A field
// of a compiler-owned head written that way is refused.
import @vibe/concurrent { TaskGroup, TaskError }

fn leak(g: TaskGroup) -> String {
  let w = g._region_witness
  w(7)
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    leak(n)
  })
  println("len=\{String::length(r)}")
}
