// #3013: an unannotated closure LITERAL passed where the parameter declares
// `Exception[Int]` may throw only `Int`. Its body used to be charged to the
// enclosing row (`Exception[String]`), so the String landed in `takes_int`'s
// `Int` arm and was read as an Int. A named argument was already refused.
fn takes_int(f: () -> Int with Exception[Int]) -> Int {
  handle {
    f()
  } with { Exception[Int]::Throw(n) => n + 1000 }
}

fn g() -> Int with Exception[String] {
  takes_int(() -> Int { throw("hello") })
}

export fn main() -> Int {
  handle {
    g()
  } with { Exception[String]::Throw(s) => String::length(s) }
}
