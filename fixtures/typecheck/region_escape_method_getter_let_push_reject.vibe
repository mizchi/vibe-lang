// #4091: the method getter's result held in a binding of the region body.

let kept: Array[MutList[Int]] = []

struct Holder {
  n: Int
}

fn Holder::sink(self: Holder) -> Array[MutList[Int]] {
  let _ = self.n
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let h = Holder::{ n: 1 }
    let s = h.sink()
    Array::push(s, value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
