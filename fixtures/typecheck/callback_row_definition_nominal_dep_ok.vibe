export effect Box[T] {
  Put(T) -> Int
}
export struct Pt { x: Int }
export fn mk_pt() -> Pt {
  Pt::{ x: 42 }
}
export fn producer() -> Int with Box[Pt] {
  perform Box::Put(Pt::{ x: 42 })
}
export fn use_pt(p: Pt) -> Int {
  p.x
}
export struct Holder { run: () -> Int with Box[Pt] }
export enum Choice {
  Run(() -> Int with Box[Pt])
}
export fn accept_holder(h: Holder) -> Int {
  42
}
export fn accept_choice(c: Choice) -> Int {
  42
}
export fn emit_holder(h: Holder) -> Int with Box[Pt] {
  h.run()
}
export fn emit_choice(c: Choice) -> Int with Box[Pt] {
  match c {
    Run(f) => f()
  }
}
