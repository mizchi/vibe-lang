// #3360: a type companion travels with its type, and so does what it keeps:
// importing `Cell` brings `Cell::stash` and its summary.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_helper_dep_ok.vibe { Cell }

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    Cell::stash(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
