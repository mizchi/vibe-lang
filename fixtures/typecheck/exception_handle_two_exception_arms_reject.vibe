// #2985 review (Codex P0): a handle may have only ONE exception arm. The
// exception channel carries no kind and only the first exception arm is
// compiled, so `Exception[String]` + `Exception[Int]` routed an Int throw
// into the String arm (`14`).
fn fail_int() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Int {
  handle {
    fail_int()
  } with { Exception[String]::Throw(s) => String::length(s); Exception[Int]::Throw(n) => n + 1000 }
}
