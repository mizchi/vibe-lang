// #3155: a local alias of a row-polymorphic function instantiates the
// function's row variable at each call, as the direct call does. Here `e` is
// `Console`, read from the named argument, so `caller` is told to declare
// `Console`. Before the fix the alias charged the bare token instead
// ("missing { e }"), an edit that names no effect.
// generic_effect_local_alias_ok.vibe is the pure twin.
fn apply[T](f: () -> T with e) -> T with e {
  f()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn caller() -> Int {
  let a = apply
  a(noisy)
}

fn main() -> Unit allows Console {
  println("\{caller()}")
}
