// #3276: `Array::push` onto an annotated outer array is the same escape as
// `Array::set`: it compiled, and the handle was joined after its group closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let c: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    Array::push(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r} after=\{TaskHandle::join(Array::get(c, 0))}")
}
