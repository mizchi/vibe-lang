// #3095: a callee formal only the row names is open at the call, so the
// caller's `with State[Int]` covers it. The requirement used to keep the
// callee's spelling `State[S]`, read as the caller's own formal `S`.
effect State[S] {
  Get() -> S
}

fn clear[S]() -> Int with State[S] {
  1
}

fn caller[S](x: S) -> Int with State[Int] {
  clear()
}
