// #3541: the erased arm hands `m` to a closure parameter, which stores it in
// a `String` field that the caller reads after the handle. `f` threw an
// `Int`, so the field held the Int 7 typed as a String (`len=14`). The arm
// reads its binder over a body that raises `Exception[Int]`, so it is refused.
struct Cell {
  mut value: String
}

fn f() -> Int with Exception[Int] {
  throw(7)
}

fn keep(store: (String) -> Unit) -> Int {
  handle { f() } with { Exception::Throw(m) => {
    store(m)
    0
  } }
}

fn main allows Console {
  let cell = Cell::{ value: "" }
  let _ = keep((s) -> { cell.value = s })
  println("len=\{String::length(cell.value)}")
}
