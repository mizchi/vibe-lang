// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The closure leaves through an inner `handle` of another
// effect, which passes its body's value on. `g()` trapped.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

effect Log {
  Put(Int) -> Unit
}

fn main() -> Unit allows Console {
  let g = handle {
    handle {
      let h = () -> perform Ask::Get() + 1
      h
    } with { Log::Put(_) => resume(()) }
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
