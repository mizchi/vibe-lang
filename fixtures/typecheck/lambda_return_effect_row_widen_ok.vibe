fn quiet() -> Int {
  7
}

fn noisy() -> Int with Console {
  println("noisy")
  9
}

fn main() -> Unit allows Console {
  let tail = (b: Bool) -> {
    if b {
      return quiet
    }
    noisy
  }
  let earlier = (b: Bool, c: Bool) -> {
    if b {
      return quiet
    }
    if c {
      return noisy
    }
    quiet
  }
  let tail_fn: () -> Int with Console = tail(true)
  let earlier_fn: () -> Int with Console = earlier(false, true)
  let compound = (b: Bool) -> {
    if b {
      return (0, quiet)
    }
    return (1, noisy)
  }
  let reverse = (b: Bool, k: Int32) -> {
    if b {
      return (0, noisy, 0)
    }
    return (k, quiet, 1)
  }
  let compound_result: (Int, () -> Int with Console) = compound(false)
  let (_, compound_fn) = compound_result
  let one: Int32 = 1
  let reverse_result: (Int32, () -> Int with Console, Int) = reverse(false, one)
  let (value, reverse_fn, _) = reverse_result
  println("\{tail_fn() + earlier_fn()}")
  println("\{compound_fn() + reverse_fn() + Int32::to_int(value)}")
}
