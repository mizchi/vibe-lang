// #2963: `e` is an IoErr (the arm's kind), and the handle's result is Int;
// returning `e` as the result must be a type error. It used to compile and
// print an allocation address.
enum IoErr {
  NotFound(String)
}

fn f() -> Int with Exception[IoErr] {
  throw(NotFound("x"))
}

fn main() -> Int {
  handle { f() } with { Exception[IoErr]::Throw(e) => e }
}
