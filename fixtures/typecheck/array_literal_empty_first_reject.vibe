//# #2893: an array literal whose FIRST element is `[]`.
//
// `EArray` takes its element type from the first element and only cross-checked
// the rest when that type was a scalar or a one-level array of scalars. An
// empty literal types as `CtArray(<fresh var>)` since #2447 gave it a real
// element slot, which fell through to "do not cross-check" -- so no later
// element was ever unified with that var, it stayed unconstrained, and it
// absorbed anything. Measured: this compiled clean and printed 233, the
// allocation address plus one.
//
// Order was the whole trigger: the same literal with the empty row SECOND
// (`[xs, []]`) was rejected, because a real type went in first.

struct Qt {
  w: Int
}

fn take[T](a: T) -> Int {
  let xs = [[], [a]]
  let ys = Array::get(xs, 1)
  let v: Int = Array::get(ys, 0)
  v + 1
}

fn main() -> Unit allows Console {
  println(__to_string(take(Qt::{ w: 5 })))
}
