// #3042 (Codex on #3063): an imported signature that carries an `Ordering` of
// another shape does not stand in for the prelude. The checker used to bind
// `Less` / `Equal` / `Greater` onto that foreign `Ordering` without looking at
// its definition.
import ./ordering_foreign_type_dep_ok.vibe { order_of }

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = order_of(1)
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
