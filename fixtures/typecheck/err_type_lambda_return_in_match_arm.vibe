// A `return` inside a `match` arm of a lambda with no written result type is
// checked against the lambda's result (#4062).
fn ap(f: (Int) -> Int, x: Int) -> Int {
  f(x)
}

fn use() -> Int {
  ap(f = (k) -> {
    match k {
      0 => {
        return true
      },
      _ => ()
    }
    k
  }, x = 0)
}
