// #3036 (Codex on #3076): `echo` declares its OWN formal spelled `Err`, while
// `probe` names dup_type_a_dep_ok's concrete `Err`. The formal binds only in
// `echo`'s signature, so `probe`'s `Err` must still be carried and compared.
import ./dup_type_a_dep_ok.vibe { Err }

export trait Probe2 {
  echo[Err](Self, Err) -> Err
  probe(Self, Err) -> Int
}

impl Probe2 for Int {
  echo[Err](self, e: Err) -> Err {
    e
  }
  probe(self, e: Err) -> Int {
    self + e.code
  }
}
