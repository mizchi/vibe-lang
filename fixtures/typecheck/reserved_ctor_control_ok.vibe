// #3086 control: the refusal is about BINDING the names. Using the built-in
// `Some` / `None`, a lowercase `some` / `none`, a qualified enum variant named
// `Some`, and a binder that merely contains the spelling all still check.
enum Maybe {
  Some(Int);
  Nothing
}

fn some(x: Int) -> Option[Int] {
  Some(x)
}

fn main() -> Unit {
  let none = None
  let a: Option[Int] = some(1)
  let Some_ish = 2
  let m = Maybe::Some(3)
  let b = match a {
    Some(v) => v + Some_ish,
    None => 0
  }
  let _ = (none == a, m, b)
}
