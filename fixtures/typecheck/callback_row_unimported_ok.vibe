// #3351 controls: a module that does not import `Pt` can still pass the
// callee a `Pt` it got from the dependency, and read one the callee's arm
// resumes with. A named callback declared with the row is unaffected.
import ./callback_row_unimported_dep_ok.vibe {
  effect Box, effect Get, run_pt, run_shade, run_take, mk_light, mk_pt
}

fn via_value() -> Int with Box {
  run_pt(() -> {
    perform Box::Put(mk_pt(7))
  })
}

fn via_enum_value() -> Int with Box {
  run_shade(() -> {
    perform Box::Put(mk_light(5))
  })
}

fn read_field() -> Int with Get {
  run_take(() -> {
    let p = perform Get::Take()
    p.x + 1
  })
}

fn read_bare() -> Int with Get {
  run_take(() -> {
    let p = perform Get::Take
    mk_pt(p.x).x
  })
}
