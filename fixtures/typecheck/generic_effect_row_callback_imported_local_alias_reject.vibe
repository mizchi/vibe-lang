// #3311 (Codex on #3340): the same through a local alias of an imported
// generic, which the importer generalizes afresh and whose callback row it
// respells against the alias's own quantifiers.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_len
}

fn producer() -> Int with Box {
  let local = run_len
  local("abc", () -> {
    perform Box::Put(2)
  }, (s) -> String::length(s))
}
