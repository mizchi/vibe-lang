//# #2848 (Codex on #2864): the generalization refusal does not depend on a
//# type parameter being in scope. `read` declares none; `f` is still a
//# `let`-bound lambda, so `p` is quantified and the read has no receiver type
//# to take an offset from. Measured before the refusal: with `m: Option[Int]`
//# this compiled clean and answered `7` -- the option's payload read through
//# `Crate`'s offset -- where the annotated twin (`err_type_option_field_access`,
//# `m.payload` written directly) was already refused. With `m: Crate` the same
//# program answers correctly today, but only because exactly one struct in
//# the program spells `payload`; the body is lowered once, so a second caller
//# with a different struct would read the wrong slot. Both are the same edit:
//# annotate `p`.
struct Crate {
  payload: Int
}

fn read(m: Option[Int]) -> Int {
  let f = (p) -> {
    p.payload
  }
  f(m)
}

export fn main() -> Int {
  read(Some(7))
}
