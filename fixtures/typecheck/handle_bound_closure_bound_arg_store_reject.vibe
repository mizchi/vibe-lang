// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. Bound by `let` and handed to a helper that returns `Unit`, it
// cannot be the handle's value -- but the helper is also given an array
// declared outside the handle, and pushes it there. `g()` trapped.
// fixtures/handle_bound_closure_inside_test.vibe runs the shapes that stay
// inside.
effect Ask {
  Get() -> Int
}

fn keep(arr: Array[() -> Int], f: () -> Int) -> Unit {
  Array::push(arr, f)
}

fn main() -> Unit allows Console {
  let arr: Array[() -> Int] = []
  let _ = handle {
    let h = () -> perform Ask::Get() + 1
    keep(arr, h)
    0
  } with { Ask::Get() => resume(5) }
  let g = Array::get(arr, 0)
  println("g=\{g()}")
}
