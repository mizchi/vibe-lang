// #2985 review (Codex P0): a closure created AND called inside a kinded
// handle keeps the handle's strictness -- its throw reaches that arm. Before,
// every closure literal was relaxed to the gradual rule, so `throw(7)` here
// was admitted and the `Exception[String]` arm read `7` as a String (`14`).
fn main() -> Int {
  handle {
    let f = () -> Int {
      throw(7)
    }
    f()
  } with { Exception[String]::Throw(s) => String::length(s) }
}
