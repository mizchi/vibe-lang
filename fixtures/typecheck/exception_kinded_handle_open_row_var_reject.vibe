// #3540: a kinded arm over a callback whose row is an open variable. The
// caller fills `e` with `Exception[String]`, and the `Exception[Int]` arm --
// a catch-all at run time, since the exception channel carries no kind --
// caught the String and read its pointer as an Int: this printed
// `r=274877906948` instead of reaching the caller's `Exception[String]` arm.
// The handle is refused at its definition, whoever calls `guarded`.
fn guarded(f: () -> Int with e) -> Int with e {
  handle {
    f() + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded(thrower)
  } with { Exception[String]::Throw(m) => String::length(m) }
}
