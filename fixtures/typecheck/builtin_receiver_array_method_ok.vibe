//# #2820 CONTROL. The dot-call spelling the builtin-receiver diagnostics
//# themselves recommend must keep working, and must keep ANSWERING.
//#
//# `xs.my_len()` is `ECall(EDot(xs, "my_len"), [])`, typed by the ECall arm's
//# callee-is-EDot case, which checks the receiver alone and never recurses
//# into the EDot node -- so the value-position refusal added for an `Array`
//# receiver cannot reach it. That is the claim this file measures rather than
//# assumes: `+ 100` makes the answer name the declared function, so a first-
//# field offset landed on by luck could not produce it.
fn Array::my_len(xs: Array[Int]) -> Int {
  Array::length(xs) + 100
}

export fn main() -> Int {
  let xs = [1, 2, 3]
  xs.my_len()
}
