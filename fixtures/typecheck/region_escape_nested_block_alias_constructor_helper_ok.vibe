// #3862 control (Codex on #3868): a `let` inside the block that initializes
// an alias shadows the parameter there too. `held` holds only the inner
// `first`, an Int, so nothing escapes.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Int, B] {
  let held = {
    let first = 0
    first
  }
  Pair(held, second)
}

fn main() -> Int {
  let kept = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(n, _) = kept
  n
}
