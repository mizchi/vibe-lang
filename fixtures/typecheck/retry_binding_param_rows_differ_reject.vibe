// #3518 review: `T` occurs as a function taking a `Log` callback and as one
// taking a pure callback. A parameter is contravariant, so no row covers
// both: joined, the pure-callback function would be handed a `Log` callback
// it runs with no handler; either occurrence alone mistypes the other. The
// argument is refused, asking for the function type to be written.
effect Log {
  Emit(Int) -> Unit
}

fn run_logged(cb: () -> Int with Log) -> Int {
  0
}

fn run_pure(cb: () -> Int) -> Int {
  cb()
}

fn pair() -> ((() -> Int with Log) -> Int, (() -> Int) -> Int) {
  (run_logged, run_pure)
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let f = second(pair)
  0
}
