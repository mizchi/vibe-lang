// #3518 review: `T` occurs as a function taking a `Log` callback and as one
// taking a pure callback. A union of the parameter rows would hand the
// pure-callback function a `Log` callback; an intersection is right here but
// wrong at a result. The occurrences carry different rows, so the argument
// is refused with the edit.
effect Log {
  Emit(Int) -> Unit
}

fn run_logged(cb: () -> Int with Log) -> Int {
  0
}

fn run_pure(cb: () -> Int) -> Int {
  cb()
}

fn pair() -> ((() -> Int with Log) -> Int, (() -> Int) -> Int) {
  (run_logged, run_pure)
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let f = second(pair)
  0
}
