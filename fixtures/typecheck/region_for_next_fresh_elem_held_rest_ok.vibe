// #4050 (Codex on #4061): the `for` desugar binds only the element of
// `next`'s `Some((element, rest))`, so a fresh element may be written although
// the continuation keeps `self.items`. `main` answers 10 * the block's value +
// the outer array's length: 10 shows the loop never wrote `outer`.
trait Iterator[T] {
  next(Self) -> Option[(T, Self)]
}

struct Gen {
  items: Array[Array[MutList[Int]]];
  left: Int
}

impl Iterator for Gen {
  next(self) -> Option[(T, Gen)] {
    if self.left > 0 {
      let fresh: Array[MutList[Int]] = []
      Some((fresh, Gen::{ items: self.items, left: 0 }))
    } else {
      None
    }
  }
}

fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let xs = Gen::{ items: [outer], left: 1 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    for a in xs {
      Array::push(a, value = cell)
    }
    1
  }
  v * 10 + Array::length(outer)
}
