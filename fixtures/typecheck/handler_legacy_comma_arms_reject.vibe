// #3072: the single-effect `with Effect { ... }` handler refuses a `,`
// between arms AT THE COMMA as well, and names the separator it accepts.
effect Ask {
  Get() -> Int
  Put(Int) -> Unit
}

fn run() -> Int {
  let x = 1
  handle {
    perform Ask::Get() + x
  } with Ask {
    Get() => resume(41), Put(_) => resume(())
  }
}
