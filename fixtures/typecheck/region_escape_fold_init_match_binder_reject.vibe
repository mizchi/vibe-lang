// Codex on #4078: a fold's `init` is a `match` binder over a getter's result.
// b44deee8c printed `kept=true`; main refuses it.
let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let cells = [a]
    match Some(get_sink()) {
      Some(s) => {
        let _ = Array::fold(cells, init = s, f = (acc, c) -> {
          Array::push(acc, value = c)
          acc
        })
        1
      },
      None => 0
    }
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
