// #1503 follow-up (Codex review on #1528): the supertrait scan needs the same
// constructor-aware matching as the direct scan, and has to look at generic
// impls at all -- it skipped `EnvTraitImplGen` outright. `Child` is
// method-bearing, so the marker-trait gate does not apply.
trait Base {
  base_m(Self) -> Int
}

trait Child: Base {
  child_m(Self) -> Int
}

impl [T] Child for Array[T] {
  base_m(self) -> Int {
    Array::length(self)
  }
  child_m(self) -> Int {
    1
  }
}

fn use_base[T: Base](x: T) -> T {
  x
}

export let v: () -> Int = () -> {
  Array::length(use_base([1, 2, 3]))
}
