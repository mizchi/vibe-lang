// #3163: `f.await()` is not a method call on a future. It used to check
// clean with an unknown result -- the String below unchecked against the
// Int payload -- and then fail in codegen with "unknown struct field".
fn read_it() -> Int with Async {
  let f = Future::ready(5)
  let s: String = f.await()
  String::length(s)
}
