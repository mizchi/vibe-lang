// #3518 review: the retry binds `F` and `T` of `F[T]` through a
// higher-kinded application, which the position walk does not descend into.
// Left unbound, `give(() -> Some("hello"))` could be read as `Option[Int]`.
// Such a variable keeps the retry's own binding, so the annotation is refused.
fn give[F[_], T, e](f: () -> F[T] with Exception + e) -> F[T] with Exception + e {
  f()
}

fn main() -> Int allows Exception {
  let x: Option[Int] = give(() -> Some("hello"))
  match x {
    Some(n) => n,
    None => 0
  }
}
