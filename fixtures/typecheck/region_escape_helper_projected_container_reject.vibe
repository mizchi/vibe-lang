// #4091 (Codex on #4106): the projected field is the module-level record's
// container (`state.items`), so the helper's result holds module storage and
// a push into that field keeps the region value there.

struct State {
  tag: Int;
  items: Array[MutList[Int]]
}

let state: State = State::{ tag: 7, items: [] }

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn make_box() -> Box {
  Box::{ tag: state.tag, items: state.items }
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let b = make_box()
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  println("v=\{v} kept=\{Array::length(state.items) > 0}")
}
