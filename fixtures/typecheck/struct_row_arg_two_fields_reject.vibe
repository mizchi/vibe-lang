// #3589 (Codex review on #3594): two fields under one row formal give it
// both their labels, so `Pair::{ a: say, b: home }` is a `Pair[Console, Env]`
// and a caller declaring only `Console` cannot run the `Env` field.
struct Pair[r] {
  a: () -> Int with r
  b: () -> Int with r
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn home() -> Int with Env {
  if Env::get("HOME") == "" {
    2
  } else {
    3
  }
}

fn run_b[r](p: Pair[r]) -> Int with r {
  (p.b)()
}

fn quiet() -> Int with Console {
  let p = Pair::{ a: say, b: home }
  run_b(p)
}

fn main() -> Unit allows Console + Env {
  println("\{quiet()}")
}
