// #3890 (Codex on #3893): a dot-call through an import alias resolves to the
// type's companion only when the receiver has no field of that name. `FB`
// has a field `get: () -> String` and a companion `FB::get(_, Int)`; `b.get()`
// is the field call it was before, not an arity error against the companion.
import ../_import_alias_dot_call_field_dep.vibe {
  FB as FieldBox, make_field_box
}

fn main() -> Unit {
  let b: FieldBox = make_field_box()
  let s: String = b.get()
  ()
}
