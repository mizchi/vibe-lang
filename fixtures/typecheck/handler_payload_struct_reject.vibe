// #3371: a struct destructure in a payload position binds nothing, like a
// tuple one, so `x` in the arm body read the outer `x`: measured on main,
// `run` answered 100 for `Pt::{ x: 10, y: 3 }`. The message names the
// binder and asks for a `match` against the written pattern in the arm body.
struct Pt {
  x: Int;
  y: Int
}

effect Geo {
  Sum(Pt) -> Int
}

fn run() -> Int {
  let x = 100
  handle {
    perform Geo::Sum(Pt::{ x: 10, y: 3 })
  } with {
    Geo::Sum(Pt::{ x, y }) => resume(x)
  }
}
