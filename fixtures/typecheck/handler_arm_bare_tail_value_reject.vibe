// #2969: an arm that never calls `resume` used to be an implicit resume
// (#2962) -- `7` was what the perform received, here an Int where the
// operation returns String, and before #2985 the checker compared it with the
// handle BODY's type and accepted it (measured 114 at run time). A bare tail
// value is refused now; the message names the edit, `resume(<value>)`.
effect Cfg {
  Get() -> String
}

fn body() -> Int with Cfg {
  let s = perform Cfg::Get()
  String::length(s) + 100
}

fn main() -> Int {
  handle { body() } with { Cfg::Get() => 7 }
}
