// #3563: a generic whose applied bound names its OWN formal (`[T: Same[T]]`)
// and is called above its declaration. The hoisted bound is re-keyed the way
// the declaration's own check keys it, so `both(1, 2)` is refused as
// ``no impl `Same[Int]` for `Int` `` and `both(P, P)` is accepted. Before the
// fix both calls were refused, as ``no impl `Same[T]` for ...``.
trait Same[A] {
  same(Self, A) -> Bool
}

struct P { x: Int }

impl Same[P] for P {
  same(self, other: P) -> Bool {
    self.x == other.x
  }
}

fn caller() -> Bool {
  both(P::{ x: 1 }, P::{ x: 1 })
}

fn bad() -> Bool {
  both(1, 2)
}

fn both[T: Same[T]](a: T, b: T) -> Bool {
  Same::same(a, b)
}
