// #4121: a generic caller whose parameter reaches a WRITTEN map key through
// another generic is restricted by that write, declared before or after it:
// `outer(m, true)` is refused although `outer` itself only forwards.
fn main {
  let _ = outer(m = Map::new(), k = true)
  ()
}

fn outer[K](m: Map[K, Int], k: K) -> Map[K, Int] {
  put(m = m, k = k)
}

fn put[K](m: Map[K, Int], k: K) -> Map[K, Int] {
  Map::set(m, key = k, value = 1)
}
