// #3036 control: two distinct declarations named `Err` with IDENTICAL
// definitions. Identity is the definition, not the declaring path, so these
// are one type: reading one through the other's layout reads the same field
// at the same slot with the same type, which is what the refusal exists to
// prevent from going wrong. Accepted deliberately.
import ./dup_type_a_dep_ok.vibe { make_err }
import ./dup_type_same_layout_dep_ok.vibe { Err }

fn read() -> Int {
  let e: Err = make_err()
  e.code
}
