// #3343: a struct whose field spells a region-carrying type without its
// region slot (`h: TaskHandle[Int]`, as a parameter annotation may) typed its
// literal as unknown, so every use of the value went unchecked -- this
// compiled -- and the region checks could not see the handle inside it. The
// literal now has its struct's type.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let b = Box::{ h: TaskGroup::spawn(n, () -> { 41 }) }
    let z: Bool = b
    TaskHandle::join(b.h)
  })
  println("r=\{r}")
}
