// #3051 (Codex on #3056): a dependency exporting an ALIAS of a private generic
// callee. The alias's published row must name its formal by quantifier index
// too, or an importer's `get("abc")` falls back to the base-name match.
export effect State[S] {
  Get() -> S
}

fn get0[S](x: S) -> Int with State[S] {
  1
}

export let get = get0
