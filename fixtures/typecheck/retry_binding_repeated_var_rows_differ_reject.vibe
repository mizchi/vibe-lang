// #3518 review: `T` occurs as a pure function and as a `Log` function. The
// effect-stripped retry bound `T` from one of them; which one depended on the
// walk, and binding the pure one let `fallback` drop `Log`. The occurrences
// carry different rows, and no rule that reconciles rows is sound at every
// position, so the argument is refused with the edit: write the function
// type the value should have (`() -> Int with Log` on the pure one).
effect Log {
  Emit(Int) -> Unit
}

fn plain() -> Int {
  1
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn both() -> (() -> Int, () -> Int with Log) {
  (plain, logged)
}

fn choose2[T, e](mk: () -> (T, T) with Exception + e, fallback: T) -> T {
  fallback
}

fn pick() -> () -> Int with Log {
  choose2(both, logged)
}

fn main() -> Int {
  0
}
