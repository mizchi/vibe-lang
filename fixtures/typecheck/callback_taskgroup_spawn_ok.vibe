// #3387: the accepted side of callback_taskgroup_spawn_reject.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}
effect Box[T] {
  Put(T) -> Int
}
fn caller() -> Int with Box[String] + Exception {
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> {
      perform Box::Put("abcd")
    })
    TaskHandle::join(h)
  })
}
