// #4142 controls: the new map is assigned back, bound, returned, or thrown
// away on purpose with `let _ =`; and `Array::push`, which mutates in place,
// stays a statement.
fn add(m: Map[String, Int], key: String) -> Map[String, Int] {
  Map::set(m, key = key, value = 1)
}

fn main() -> Int {
  let mut m: Map[String, Int] = Map::new()
  m = Map::set(m, key = "a", value = 1)
  let m2 = Map::set(m, key = "b", value = 2)
  let _ = Map::set(m2, key = "c", value = 3)
  let xs: Array[Int] = []
  Array::push(xs, value = 1)
  Map::size(add(m = m2, key = "d")) + Array::length(xs)
}
