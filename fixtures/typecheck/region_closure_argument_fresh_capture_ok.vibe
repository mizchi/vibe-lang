fn main() -> Int allows Exception {
  let result = region r {
    let c = MutList::empty(r)
    let fresh: Array[MutList[Int]] = []
    let redirect = (xs: Array[Array[MutList[Int]]]) -> {
      Array::set(xs, at = 0, value = fresh)
    }
    let init: Array[Array[MutList[Int]]] = [[]]
    redirect(init)
    Array::push(Array::get(init, at = 0), value = c)
    Array::length(fresh)
  }
  result
}
