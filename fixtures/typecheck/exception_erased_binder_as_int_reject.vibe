// #3541: the erased `Exception::Throw(m)` binder is the thrown message, a
// String. Read as an Int it compiled and printed `payload+1: 137438953474`;
// the edit is the kinded arm, which types the payload at its kind.
fn f() -> Int with Exception {
  throw("str")
}

fn main allows Console {
  let r: Int = handle { f() } with { Exception::Throw(m) => m + 1 }
  println("payload+1: \{r}")
}
