// #3596: local aliases with an annotation, one bound before the handle and
// one inside it, the inner one in a block. Each stands for `mk`.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn main() -> Unit allows Console {
  let g: () -> Box with Exception[Int] = mk
  let b = handle {
    let h: () -> Box with Exception[Int] = {
      let t = g
      t
    }
    h()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
