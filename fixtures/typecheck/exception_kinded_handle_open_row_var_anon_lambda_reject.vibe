// #3540: the same refusal in a lambda bound to no name. The message points
// at "this lambda" rather than at the function `run` around it.
fn run(f: () -> Int with e) -> Int with e {
  let fs = [
    () -> Int with e {
      handle {
        f() + 1
      } with { Exception[Int]::Throw(code) => code * 2 }
    }
  ]
  Array::length(fs)
}

fn main() -> Int {
  run(() -> 1)
}
