// #3419 controls: a constructor of the scrutinee's own type is accepted,
// beside another enum's, through a nested `Option` payload, a tuple of them,
// and a generic enum.
enum E {
  A(Int);
  B
}

enum F {
  C(Int);
  D
}

enum Wrap[T] {
  W(T);
  Empty
}

fn on_f(v: F) -> Int {
  match v {
    C(n) => n,
    D => 0
  }
}

fn nested(v: Option[Option[Int]]) -> Int {
  match v {
    Some(Some(n)) => n,
    Some(None) => 1,
    None => 0
  }
}

fn pair(v: (Option[Int], E)) -> Int {
  match v {
    (Some(n), A(m)) => n + m,
    (_, _) => 0
  }
}

fn wrapped(v: Wrap[Int]) -> Int {
  match v {
    W(n) => n,
    Empty => 0
  }
}

fn main() -> Unit {
  let _ = on_f(D) + nested(None) + pair((None, B)) + wrapped(Empty)
}
