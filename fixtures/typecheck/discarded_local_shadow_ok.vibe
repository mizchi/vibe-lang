// #4146: a local the statement binds shadows the builtin of its name, so the
// call it ends in is to that local -- which may act -- and is not judged.
fn main() -> Int {
  let xs: Array[Int] = []
  if true {
    let not = (b: Bool) -> {
      Array::push(xs, value = 1)
      b
    }
    not(true)
  } else {
    false
  }
  match Some((b: Bool) -> b) {
    Some(not) => not(true),
    None => false
  }
  Array::length(xs)
}
