// #3947 (Codex on #3956): `impl Value[Int]` and `impl Value[Alias]` overlap
// once `type Alias = Int` expands. It used to be accepted, and the lowering
// then named both impls' methods after the same key. The targets differ in
// spelling (`Wrap[T]` covers `Wrap[Int]`), so the methods are two bindings and
// the refusal is the overlap check's own.
type Alias = Int

trait Value[A] {
  value(Self) -> A
}

struct Wrap[T] {
  v: T
}

impl [T] Value[Int] for Wrap[T] {
  value(self) -> Int {
    1
  }
}

impl Value[Alias] for Wrap[Int] {
  value(self) -> Alias {
    self.v + 100
  }
}

fn main allows Console {
  println("unreachable")
}
