// #3947 (Codex on #3956): `impl Value[Int]` and `impl Value[Alias]` for one
// target are one impl twice once `type Alias = Int` expands, so the second is
// an overlap. It used to be accepted, and the lowering then named both
// impls' methods after the same key.
type Alias = Int

trait Value[A] {
  value(Self) -> A
}

struct Note {
  n: Int
}

impl Value[Int] for Note {
  value(self) -> Int {
    self.n
  }
}

impl Value[Alias] for Note {
  value(self) -> Alias {
    self.n + 100
  }
}

fn main allows Console {
  println("unreachable")
}
