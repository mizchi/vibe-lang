// #1515: a row-carrying function bound to a LOCAL and called through that name.
// The direct call and the row-carrying-parameter form were both rejected; only
// the alias slipped through, so `caller` performed Log::Emit with no declared
// row and no handler. Reproduced on the committed seed too (predates #1451).
effect Log {
  Emit(String) -> Unit
}

fn eff(s: String) -> Unit with Log::Emit {
  perform Log::Emit(s)
}

fn caller() -> Unit {
  let f = eff
  f("boom")
}
