// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The method's result is bound by `let` and returned by name.
// `g()` answered `6` from the dead handler after `vibe check` was clean.
effect Ask {
  Get() -> Int
}

struct Factory {
  k: Int
}

fn Factory::mk(self: Factory) -> (() -> Int) with Ask {
  () -> perform Ask::Get() + self.k
}

fn main() -> Unit allows Console {
  let fac = Factory::{ k: 1 }
  let g = handle {
    let h = fac.mk()
    h
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
