// #3360 control (Codex on #3473): `put` here is the keep-nothing function
// `taskgroup_import_shadow_mid_ok.vibe` declares over the retaining one it
// imports, so the call is accepted.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_import_shadow_mid_ok.vibe { put }

fn main() -> Unit allows Exception + Console {
  let outer: Array[TaskHandle[Int]] = []
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    put(outer, h)
    TaskHandle::join(h)
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
