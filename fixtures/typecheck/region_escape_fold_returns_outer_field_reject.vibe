// Codex on #4078 control: a fold callback that returns a field of a struct
// declared before the region makes that field the accumulator.
struct Holder {
  items: Array[MutList[Int]]
}

fn main() -> Unit allows Exception + Console {
  let h = Holder::{ items: [] }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine: Array[MutList[Int]] = []
    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
      Array::push(acc, value = cell)
      h.items
    })
    1
  }
  println("v=\{v} kept=\{Array::length(h.items) > 0}")
}
