// #3589 (Codex review on #3594): two nested fields under one row formal that
// store the same row -- `Pair::{ a: Inner::{ run: say }, b: Inner::{ run: say
// } }` is a `Pair[Console]`, and a `Console` caller runs it.
struct Inner[r] {
  run: () -> Int with r
}

struct Pair[r] {
  a: Inner[r]
  b: Inner[r]
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn run_b[r](p: Pair[r]) -> Int with r {
  (p.b.run)()
}

fn quiet() -> Int with Console {
  let p = Pair::{ a: Inner::{ run: say }, b: Inner::{ run: say } }
  run_b(p)
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
