// #4146: a value thrown away after an assignment in the same block. The
// block's rest is the assignment's continuation, so the walk follows it: once
// at the tail of a statement-position `if` branch, once at the tail of a
// `while` body.
fn spin(flag: Bool) -> Int {
  let mut n = 0
  if flag {
    n = n + 1
    String::concat("a", "b")
  } else {
    ""
  }
  while n < 3 {
    n += 1
    Array::get([1, 2], at = 0)
  }
  n
}
