// #4146: a value thrown away after a plain assignment. The block's rest is
// the assignment's continuation, so the walk follows it to the tail of this
// statement-position `if` branch.
fn spin(flag: Bool) -> Int {
  let mut n = 0
  if flag {
    n = n + 1
    String::concat("a", "b")
  } else {
    ""
  }
  n
}
