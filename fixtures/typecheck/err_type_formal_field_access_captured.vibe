//# #2848: a formal read through a plain closure is still the ENCLOSING
//# declaration's formal. `m` keeps `T`'s variable when it is captured, so the
//# read inside the closure resolves to the same open binder and is refused
//# with `T` named. This is the shape a refusal keyed on "the innermost binder
//# has type parameters" would miss: the closure declares none.
struct Crate {
  payload: Int
}

fn read[T](m: T) -> Int {
  let f = () -> {
    m.payload
  }
  f()
}

export fn main() -> Int {
  read(7)
}
