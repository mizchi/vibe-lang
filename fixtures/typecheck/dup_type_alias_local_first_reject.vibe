// #3036 (Codex on #3076): the same two imports in the other order. Here the
// later `Y` shadows the alias and the program happens to read the right
// layout, but which `Y` a name means must not depend on import order: the
// two are refused the same way.
import ./dup_type_a_dep_ok.vibe { Err as Y }
import ./dup_type_alias_local_dep_ok.vibe { Y, make_y }

fn read() -> Int {
  let v: Y = make_y()
  String::length(v.name)
}
