//# #3297: `==` inside a `let`-bound lambda on a value whose type the lambda
//# is generalized over. `x` and `y` are unannotated, so `cmp` is generic in
//# their type and every call instantiates its own copy; the body is lowered
//# once for all of them, so the comparison has no type to compare by.
//# Measured before the refusal: `cmp([1, 2], [1, 2])` compiled clean and
//# answered `false`, because the comparison reached the derived
//# `Res::equals`, which compares the `E` payload by reference. The edit is to
//# annotate `x` and `y`.
enum Res[T, E] {
  Ok(T);
  Err(E)
}

export fn main() -> Int {
  let cmp = (x, y) -> {
    let a = Err(x)
    let b = Err(y)
    a == b
  }
  if cmp([1, 2], [1, 2]) {
    1
  } else {
    0
  }
}
