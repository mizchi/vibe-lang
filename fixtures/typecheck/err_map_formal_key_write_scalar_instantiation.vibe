// #4121: a generic READ through a map-key parameter dispatches on the map at
// run time, but a WRITE cannot: `Map::set` into an empty map has no mark to
// read, so a generic body lowers it with the String key operations. A call
// that instantiates a written map-key parameter at `Int` stays refused.
fn put[K, V](m: Map[K, V], k: K, v: V) -> Map[K, V] {
  Map::set(m, key = k, value = v)
}

fn main {
  let _ = put(m = Map::new(), k = 1, v = 10)
  ()
}
