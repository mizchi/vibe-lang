// #2983: an exception kind is a TYPE. An effectset of kinds is not one, so
// `Exception[IoErrors]` is refused; the row that throws the set's kinds is
// written `with IoErrors`.
suberror NotFound(String)

suberror Denied(Int)

effectset IoErrors = {
  Exception[NotFound],
  Exception[Denied]
}

fn f(x: Int) -> Int with Exception[IoErrors] {
  x
}
