// Codex on #4100: `Gen::next` hands out `self.items`, and `Bag::iter`
// builds the first iterator around a module-level array, so the first
// element IS that array. The element reaches what `C::iter`'s result does,
// so the write is refused (main before this printed `kept=true`).
trait Iterator[T] {
  next(Self) -> Option[(T, Self)]
}

trait Iterable[T] {
  iter(Self) -> Gen
}

let kept: Array[MutList[Int]] = []

struct Bag {
  n: Int
}

struct Gen {
  items: Array[MutList[Int]];
  left: Int
}

impl Iterator for Gen {
  next(self) -> Option[(T, Gen)] {
    if self.left > 0 {
      Some((self.items, Gen::{ items: [], left: self.left - 1 }))
    } else {
      None
    }
  }
}

impl Iterable for Bag {
  iter(self) -> Gen {
    Gen::{ items: kept, left: self.n }
  }
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let bag = Bag::{ n: 1 }
    for a in bag {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
