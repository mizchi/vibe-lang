// #3371: a nested `record { x, y }` pattern reaches the checker as a tuple of
// its field patterns, labels dropped, so printing it back gave `(x, y)` and
// the message suggested `let (x, y) = v` -- an edit that does not say what
// was written (Codex on #3384). The message now names the binder and asks
// for a `match` against the reader's own pattern; that edit is run in
// fixtures/handler_arm_payload_binder_test.vibe.
effect Geo[T] {
  Sum(T) -> Int
}

fn run() -> Int {
  handle {
    perform Geo::Sum(record { x: 10, y: 3 })
  } with {
    Geo::Sum(record { x, y }) => resume(x - y)
  }
}
