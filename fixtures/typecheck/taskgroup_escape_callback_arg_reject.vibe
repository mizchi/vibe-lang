// #3343: the helper does not store anything itself; it hands the handle to
// the function it is passed, and that closure stores it in an outer binding.
// The helper's parameter stands for the closure during the re-check, so the
// closure's write is judged with the handle's region. This compiled and the
// handle was joined after its group closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn apply_to[T](h: T, f: (T) -> Unit) -> Unit {
  f(h)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    apply_to(TaskGroup::spawn(n, () -> { 41 }), (x) -> {
      c.v = Some(x)
    })
    1
  })
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
