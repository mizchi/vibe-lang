// #3962: two impls of one applied trait for one target. The overlap check
// reports the second impl at its header; the method bindings the two blocks
// share (`Note$impl$..::value`) are not reported as a duplicate declaration
// as well, which used to come first and name the encoded binding.

trait Value[A] {
  value(Self) -> A
}

struct Note {
  n: Int
}

impl Value[Int] for Note {
  value(self) -> Int { self.n }
}

impl Value[Int] for Note {
  value(self) -> Int { 1 }
}
