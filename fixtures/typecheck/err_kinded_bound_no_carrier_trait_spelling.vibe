// #4070: a bound no parameter carries is refused with the trait as the
// source spells it (`Takes[F[Int]]`), not its storage key
// (`$trait$A84_97_...`).
trait Takes[A] {
  take(A) -> Int
}

impl Takes[Array[Int]] for Array {
  take(xs: Array[Int]) -> Int {
    Array::length(xs)
  }
}

fn none_carries[F[_]: Takes[F[Int]]](_ n: Int) -> Int {
  let g = F::take
  n
}

fn main() -> Int {
  none_carries(1)
}
