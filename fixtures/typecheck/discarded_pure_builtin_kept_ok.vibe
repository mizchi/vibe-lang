// #4146 controls: a pure builtin's result bound, returned, used as a
// condition or a `for` comprehension's value, or thrown away on purpose with
// `let _ =`; the in-place `Array::push` / `Array::set` stay statements; and
// a `for` used as an expression collects its body values.
fn first(xs: Array[Int]) -> Int {
  Array::get(xs, at = 0)
}

fn main() -> Int {
  let xs = [1, 2]
  let s = String::concat("a", "b")
  let _ = Array::get(xs, at = 1)
  Array::push(xs, value = 3)
  Array::set(xs, at = 0, value = 5)
  let lens = for w in ["x", "yy"] {
    String::length(w)
  }
  if String::contains(s, needle = "a") {
    first(xs = xs) + Array::length(lens)
  } else {
    0
  }
}
