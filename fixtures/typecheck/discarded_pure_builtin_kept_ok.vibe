// #4146 controls: a value-only builtin whose result is bound, returned, used
// as an argument, or thrown away on purpose with `let _ =`; and the builtins
// the registry flags pure that act rather than only return a value --
// `Array::set` (its result is `Unit`) -- stay statements.
fn tail(s: String) -> String {
  String::concat(s, "!")
}

fn main() -> Int {
  let xs = [1, 2, 3]
  let s = String::concat("a", "b")
  let _ = Array::get(xs, at = 0)
  Array::set(xs, at = 0, value = 9)
  String::length(tail(s = s)) + Array::get(xs, at = 0)
}
