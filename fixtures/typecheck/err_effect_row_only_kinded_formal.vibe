// #3418: a constructor formal only `run`'s rows name is fixed at the call by
// the row in scope, as a plain formal is since #3386. The callback performed
// `Box` at `Array[Int]` and reached a `Box[Option[Int]]` handler.
effect Box[T] {
  Put(T) -> Int
}

fn run[F[_]](f: () -> Int with Box[F[Int]]) -> Int with Box[F[Int]] {
  f()
}

fn caller() -> Int with Box[Option[Int]] {
  run(() -> {
    perform Box::Put([1])
  })
}
