// A bare `FrozenArray` parameter accepted a frozen array of `String` where
// the body read an `Int`, and `+ 1` printed the string's pointer
// (`137438953475`).
fn first(f: FrozenArray) -> Int {
  FrozenArray::get(f, 0)
}

fn main allows Console {
  let f = FrozenArray::from_array(["hello"])
  println("\{first(f) + 1}")
}
