//# #3353: the unannotated side of array_literal_struct_then_array_reject.vibe.
//
// With no annotation, the first element alone fixed the literal's type:
// `[(1, 2), "x"]` typed as `Array[(Int, Int)]`, and the string was read as a
// tuple.

fn main() -> Unit allows Console {
  let xs = [(1, 2), "x"]
  let (a, b) = Array::get(xs, 1)
  println(__to_string(a + b))
}
