// #3360 (Codex on #3473): a type companion its module publishes with the
// type (`fn Cell::stash`, no `export` of its own), reached by importing the
// type alone. It keeps the handle in its module's array.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { Cell }

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ n: 1 }
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    Cell::stash(c, h)
    1
  })
  println("r=\{r}")
}
