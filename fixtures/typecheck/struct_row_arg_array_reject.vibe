// #3589 (Codex review on #3594): an array literal whose elements store
// different rows in a struct's row argument is refused, as an array of the
// two functions is: the elements' type kept the first element's row, and
// `run_last` ran `home`'s `Env` in a `Console` function.
struct Inner[r] {
  run: () -> Int with r
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn home() -> Int with Env {
  if Env::get("HOME") == "" {
    2
  } else {
    3
  }
}

fn run_last[r](xs: Array[Inner[r]]) -> Int with r {
  (Array::get(xs, 1).run)()
}

fn call_last[r](xs: Array[() -> Int with r]) -> Int with r {
  (Array::get(xs, 1))()
}


fn quiet2() -> Int with Console {
  let xs = [Inner::{ run: say }, Inner::{ run: home }]
  run_last(xs)
}

fn main() -> Unit allows Console + Env {
  println("\{quiet2()}")
}
