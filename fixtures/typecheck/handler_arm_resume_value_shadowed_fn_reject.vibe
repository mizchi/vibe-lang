// #3375: inside a handler arm `resume` is the arm's continuation even when a
// top-level `fn resume` exists, and the value it resumes with is checked
// against the operation's return type. The check used to stand down whenever
// any `resume` was in scope, so this compiled and resumed the Int `perform`
// with a string (measured: the handle answered 137438953474).
effect G {
  Op -> Int
}

fn resume(x: Int) -> Int {
  x
}

fn main() -> Int {
  handle {
    perform G::Op + 1
  } with G {
    Op => resume("str")
  }
}
