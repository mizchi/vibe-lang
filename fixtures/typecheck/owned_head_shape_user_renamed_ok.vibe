// #3551 review: the edit the refusal names. A program `TaskGroup` whose
// formals are not the shipped `rg` / `e` is the program's own struct and is
// held to them, so it is written with both arguments.
struct TaskGroup[A, B] {
  first: A;
  second: B
}

fn first_of(g: TaskGroup[Int, String]) -> Int {
  g.first
}

fn main() -> Int {
  first_of(TaskGroup::{ first: 7, second: "x" })
}
