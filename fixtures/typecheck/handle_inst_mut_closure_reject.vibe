// #3022 review: a lambda held in a `let mut` and called under the handler is
// followed too. `get_int` needs `State[Int]`; the handler resumes a String.
effect State[S] {
  Get() -> S
}

fn get_int() -> Int with State[Int] {
  perform State::Get()
}

fn main() -> Unit allows Console {
  let n = handle {
    let mut f = () -> Int with State[Int] { get_int() }
    f()
  } with { State::Get() => resume("abc") }
  println("\{n}")
}
