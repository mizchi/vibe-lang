// ADR-0094 (#3143, Codex on #4020): the effect's resource kind comes from its
// resolved declaration, so an IMPORTED effect is checked like a local one.
import ./effect_resource_param_dep_ok.vibe { effect Kv }

resource Logs: Store::Queue

fn lookup(_ key: String) -> String with Kv[Logs] {
  perform Kv::Get(key)
}
