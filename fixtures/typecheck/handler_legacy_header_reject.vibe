// #3530: the single-effect handler header `with Effect { Op(..) => .. }` was
// removed. It is refused at the header, with the handler-set spelling that
// replaces it, naming the effect and the first arm's operation.
effect Ask {
  Get() -> Int
  Put(Int) -> Unit
}

fn run() -> Int {
  handle {
    perform Ask::Get() + 1
  } with Ask {
    Get() => resume(41);
    Put(_) => resume(())
  }
}
