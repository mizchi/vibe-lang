// #3599: a builder handed in as a parameter names no declaration the check
// can read, so a closure in a declared type's field of what it returns is
// taken to throw what the handle catches. `run(mk)` returned `mk`'s `Box`,
// whose closure inherited `mk`'s throw, as the handle's value; `f()` threw
// with no handler around it and trapped after `vibe check` was clean.
// fixtures/handle_bound_closure_unread_callee_test.vibe holds the accepted
// controls.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

fn run(g: () -> Box with Exception[Int]) -> Box {
  handle {
    g()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
}

fn main() -> Unit allows Console {
  let b = run(mk)
  let f = b.f
  println("\{f()}")
}
