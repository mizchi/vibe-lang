// #3488: `fwd` wraps the outer cell in a record literal and `put` stores the
// handle through the record's field, so the handle outlives its group.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn fwd(c: Cell, x: TaskHandle[Int]) -> Unit {
  let w = Wrap::{ cell: c }
  put(w, x)
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    fwd(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
