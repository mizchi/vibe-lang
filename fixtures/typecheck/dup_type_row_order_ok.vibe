// #3036 (Codex on #3076): an effect row is a set, so `with Fs + Env` and
// `with Env + Fs + Env` in a field's type are one declaration: importing
// through both halves is accepted.
import ./dup_type_row_order_a_dep_ok.vibe { Job, take_a }
import ./dup_type_row_order_b_dep_ok.vibe { Job, take_b }

fn total(j: Job) -> Int {
  take_a(j) + take_b(j)
}
