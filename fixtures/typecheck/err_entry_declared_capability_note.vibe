// ADR-0084 / ADR-0094 (#3143): an effect that declares a resource parameter is
// a capability by its declaration, and the classifier reads that through
// OperationRef. No host provides a program-declared effect yet (#2656), so
// the entry still refuses it, and the refusal says why the edit is `handle`.
effect Kv[R: Store::Bucket] {
  Get(String) -> String
}

resource Posts: Store::Bucket

fn main() -> Unit allows Kv[Posts] {
  let _ = perform Kv::Get("a")
  ()
}
