// #3837: a struct literal does not follow an alias that fixes the struct's
// type arguments: the literal infers its own, so `IB::{ v: "s" }` would build a
// `Box[String]` under a name that says `Box[Int]`.
struct Box[T] {
  v: T
}

type IB = Box[Int]

fn main() -> Unit {
  let b = IB::{ v: "s" }
  ()
}
