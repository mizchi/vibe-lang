// #3301 (Codex on #3337): an or-pattern arm of a generic effect is compared
// at the types the handle instantiated. Here `A` is `Int` and `B` is
// `String`, so `resume` would hold two types and the arm is refused; at
// `E[Int, Int]` the same arm is accepted
// (fixtures/handler_or_pattern_generic_resume_test.vibe).
effect E[A, B] {
  X -> A
  Y -> B
}

fn main() -> Int {
  handle {
    let a: Int = perform E::X
    let b: String = perform E::Y
    a + String::length(b)
  } with E {
    X|Y => {
      let k = resume
      0
    }
  }
}
