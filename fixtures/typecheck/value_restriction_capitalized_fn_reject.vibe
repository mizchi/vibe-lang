// #3537: whether a call is a constructor application is read from the
// declarations, not from the callee's first letter. `Make` is an ordinary
// function, so `f` is bound to a call result and is not generalized: the
// closure shares one array across every call. Read by spelling, `f` was
// generalized and `Array::get(r, 0) + 1` read "hello" as an Int.
fn Make[T]() -> (T) -> Array[T] {
  let a: Array[T] = []
  (x) -> {
    Array::push(a, x)
    a
  }
}

fn main allows Console {
  let f = Make()
  let _ = f("hello")
  let r: Array[Int] = f(5)
  println("\{Array::get(r, 0) + 1}")
}
