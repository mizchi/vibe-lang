// #3408 (Codex on #3409): `mk` in the `Some(mk)` arm is the pattern-bound
// function value, not the top-level `mk`, so `mid` does not take
// `Box[Int]` and a `Box[String]` caller is accepted.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid(f: Option[() -> Int]) -> Int with Box {
  match f {
    Some(mk) => mk(),
    None => 0
  }
}
fn caller() -> Int with Box[String] {
  mid(None)
}
