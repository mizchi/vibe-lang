// A type alias that reuses a compiler-owned head's name is held to its own
// formals. `Future[Int]` used to skip the arity check because `Future` is a
// compiler-owned name; the alias expanded with `U` left rigid, so `(1, 2)`
// passed and its `2` was read as a `String` (the run printed `    !`).
type Future[T, U] = (T, U)

fn second(p: Future[Int]) -> String {
  p.1
}

fn main allows Console {
  println(String::concat(second((1, 2)), "!"))
}
