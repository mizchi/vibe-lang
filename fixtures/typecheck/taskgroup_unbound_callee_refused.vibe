// #3476: `no_such_fn` exists nowhere. A bare call whose first argument has
// an imported type is retried as a method of that type and typed without a
// body, so the checker accepts it; inside a lambda the name then became a
// capture holding 0, and the program trapped when it ran
// (`null function or function signature mismatch`). It is refused at build
// time now, as the same call outside a lambda already was.
import @vibe/concurrent { TaskGroup }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let s: String = no_such_fn(h)
    String::length(s)
  })
  println("r=\{r}")
}
