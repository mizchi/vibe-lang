// #3476: `no_such_fn` exists nowhere. The checker refuses it (`unknown
// name`, #3480: an opaque receiver no longer takes the method retry). Before
// that, the retry typed the call without a body, and inside a lambda the name
// became a capture holding 0, so the program trapped when it ran (`null
// function or function signature mismatch`). Codegen now also refuses such a
// capture at build time, should the checker let one through again.
import @vibe/concurrent { TaskGroup }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let s: String = no_such_fn(h)
    String::length(s)
  })
  println("r=\{r}")
}
