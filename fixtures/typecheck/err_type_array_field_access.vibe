//# #2820: a field read on an `Array` receiver is refused.
//#
//# There is no struct in this program at all, so nothing can give `.v` a
//# meaning. Before the fix this was CLEAN in `vibe check` -- empty output,
//# exit 0 -- and the build rejected it with an unlocated `unknown struct
//# field: v`, a message that also asserts the receiver IS a struct whose
//# field list lacks `v`.
fn read(m: Array[Int]) -> Int {
  m.v
}

export fn main() -> Int {
  read([11, 22, 33])
}
