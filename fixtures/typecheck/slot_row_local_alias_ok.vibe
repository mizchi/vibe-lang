// A row-free callback keeps its calling convention through a local alias.
effect Box[T] {
  Put(T) -> Unit
}

fn drive(_ f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let a = g
  drive(a) + drive(tick)
}
