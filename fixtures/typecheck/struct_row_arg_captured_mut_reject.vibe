// #3589 (Codex review on #3594): a top-level lambda returning a captured
// mutable row-bearing struct does not quantify the struct's row, so two
// calls of `get` share one cell's row and storing a `Console` function in
// it is refused, as storing it through `shared` directly is.
struct Cell[r] {
  mut run: () -> Int with r
}

fn pure_one() -> Int {
  1
}

fn noisy() -> Int with Console {
  println("noisy ran")
  2
}

let shared = Cell::{ run: pure_one }

let get = () -> shared

fn setter() -> Unit with Console {
  let c = get()
  c.run = noisy
}

fn quiet() -> Int {
  let c = get()
  (c.run)()
}

fn main() -> Unit allows Console {
  setter()
  println("\{quiet()}")
}
