// #2985 review (Codex P0): a closure literal handed to a callee whose row
// carries the literal's throws back out (here through the row variable `e`)
// stays as strict as the handle body. Before, every literal argument was
// relaxed to the gradual rule, the row-variable instantiation bailed on the
// unannotated literal, and `throw(7)` reached the `Exception[String]` arm and
// read as a String (`14`).
fn invoke[e](f: () -> Int with e) -> Int with e {
  f()
}

fn main() -> Int {
  handle {
    invoke(() -> Int {
      throw(7)
    })
  } with { Exception[String]::Throw(s) => String::length(s) }
}
