// #3051: a dependency exporting a generic callee whose row names its formal.
// The importers below (generic_row_formal_imported_*,
// handle_inst_imported_callee_formal_reject) need `S` instantiated at their
// call, which an importer can only do if the published row says which scheme
// variable `S` is.
export effect State[S] {
  Get() -> S
}

export fn get[S](x: S) -> Int with State[S] {
  1
}
