// #3341: binding a lambda to a name annotated with a row decides its
// instantiation too -- the annotation is where every later use reads it.
effect Box[T] {
  Put(T) -> Int
}

fn aliased() -> Int with Box[String] {
  let g = () -> Int { perform Box::Put(5) }
  let h: () -> Int with Box[String] = g
  h()
}
