// Codex on #4100: `next` hands out `self.items`, and its continuation
// carries a module-level array, so from the second step on the element IS
// that array -- even for an iterand built inside the region. The element
// reaches what the continuation does, so the write is refused (main before
// this printed `kept=true`).
trait Iterator[T] {
  next(Self) -> Option[(T, Self)]
}

let kept: Array[MutList[Int]] = []

struct Gen {
  items: Array[MutList[Int]];
  left: Int
}

impl Iterator for Gen {
  next(self) -> Option[(T, Gen)] {
    if self.left > 0 {
      Some((self.items, Gen::{ items: kept, left: self.left - 1 }))
    } else {
      None
    }
  }
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let xs = Gen::{ items: [], left: 2 }
    for a in xs {
      Array::push(a, value = cell)
    }
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
