// A bare type alias that reuses a compiler-owned head's name and arity asks
// for the alias's own formals, not the compiler head's payload: `MutList`
// here takes 2 type arguments. The message used to ask for `MutList[T]`, an
// edit that then compiled clean and read the `U` element as anything (the
// shape `err_type_owned_name_alias_arity` pins).
type MutList[T, U] = (T, U)

fn second(p: MutList) -> String {
  p.1
}
