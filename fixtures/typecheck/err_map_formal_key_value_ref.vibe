// #2334: a function that keys a map by its type parameter, passed as a value,
// is instantiated where the instantiation check cannot see it -- here at an
// `Int` key -- so the value use is refused, and a direct call is the edit.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}

fn main {
  let f = look
  let m: Map[Int, Int] = Map::set(Map::new(), 1, 10)
  let _ = f(m, 1)
  ()
}
