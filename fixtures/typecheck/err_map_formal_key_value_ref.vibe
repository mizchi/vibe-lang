// #2334: a function that keys a map by its type parameter, taken as a value,
// is instantiated at the reference. The checker records that instantiation
// like a call's, so the `Int` key reaching it through `f` is refused.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}

fn main {
  let f = look
  let m: Map[Int, Int] = Map::set(Map::new(), 1, 10)
  let _ = f(m, 1)
  ()
}
