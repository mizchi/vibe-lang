// A function of the wrong arity given to a generic function parameter. The
// expected type mentions `T`, so the mismatch was tolerated as "not ground",
// and the call trapped at run time with "indirect call type mismatch".
fn app[T](f: () -> T) -> T {
  f()
}

fn call_it() -> Int {
  app((x: Int) -> Int { x })
}
