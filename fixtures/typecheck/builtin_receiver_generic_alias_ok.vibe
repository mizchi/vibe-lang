// #3475 control: a parameterized alias of `Array` is still an Array to the
// receiver check, and a generic struct's own field reaches the builtin.
type AL[V] = Array[V]

struct Q[T] { x: T }

fn main() -> Int {
  let xs: AL[Int] = [1, 2, 3]
  let q: Q[String] = Q::{ x: "abc" }
  Array::length(xs) * 100 + String::length(q.x) * 10 + Array::get(xs, 1)
}
