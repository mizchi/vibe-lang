// #4091: a method call whose receiver is not a name (`make_holder().sink()`)
// runs the imported `Holder::sink`, which returns its module's array. The
// check resolved a method only through a receiver it could name, and read
// any other as a builtin's, holding only its receiver and arguments.

import ./region_escape_imported_method_dep_ok.vibe { Holder, make_holder, kept_len }

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let s = make_holder().sink()
    Array::push(s, value = c)
    1
  }
  println("v=\{v} kept=\{kept_len() > 0}")
}
