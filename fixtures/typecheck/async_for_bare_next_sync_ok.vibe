// #3641 control: a bare `next` that returns a plain `Option` is a SYNC
// iterator. The desugar drives it without `await`, so a row-less function
// that loops over it is not charged `Async`. (The unrelated trait makes the
// program take the trait-aware loop classification, which is where a sync
// bare `next` is driven.)
trait Named {
  name(Self) -> String
}

struct Countdown {
  n: Int
}

fn Countdown::next(c: Countdown) -> Option[(Int, Countdown)] {
  if c.n <= 0 {
    None
  } else {
    Some((c.n, Countdown::{ n: c.n - 1 }))
  }
}

fn sum_down(n: Int) -> Int {
  let mut acc = 0
  for x in Countdown::{ n: n } {
    acc = acc + x
  }
  acc
}

fn main allows Console {
  println("sum = \{sum_down(4)}")
}
