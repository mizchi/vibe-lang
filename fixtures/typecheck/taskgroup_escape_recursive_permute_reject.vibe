// #3488 (Codex on #3492): a recursive helper that permutes its parameters
// can hand back any of them, so a cycle counts its arguments as held.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn route(a: Cell, b: Cell, c: Cell, n: Int) -> Wrap {
  if n == 0 {
    Wrap::{ cell: c }
  } else {
    route(a = b, b = c, c = a, n = n - 1)
  }
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    let x = Cell::{ v: None }
    let y = Cell::{ v: None }
    put(w = route(a = x, b = outer, c = y, n = 2), x = TaskGroup::spawn(n, f = () -> { 41 }))
    1
  })
  println("r=\{r}")
}
