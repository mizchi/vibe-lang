// #3596: a top-level alias with an annotation. Its value is the annotated
// name, which stands for `mk` as a bare alias does.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

let make: () -> Box with Exception[Int] = mk

fn main() -> Unit allows Console {
  let b = handle {
    make()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
