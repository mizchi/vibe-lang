//# #3549: an `Array` of closures compares its elements with the same `==`.
//# Measured before the refusal, `[f] == [g]` answered `false` for two
//# closures with the same body.
export fn main() -> Int {
  let f = (x: Int) -> x + 1
  let g = (x: Int) -> x + 1
  if [f] == [g] {
    1
  } else {
    0
  }
}
