// #3163: a local binding named `await` is the binding, so its own return
// type is what the call answers (fixtures/await_shadowed_binding_test.vibe
// runs it).
fn read_it() -> Int with Async {
  let await = (f: Future[Int]) -> "hello"
  let s: String = await(Future::ready(5))
  String::length(s)
}
