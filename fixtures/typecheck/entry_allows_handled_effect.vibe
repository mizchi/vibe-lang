// ADR-0124 decision 3 (#2656): an entry row may name an effect the program
// declares when the entry's own body handles it. The label grants no host
// authority; it records the handler. r1: a direct perform inside the handle.
effect Db {
  Get(Int) -> Int
}

fn main allows Console + Db {
  let v = handle {
    perform Db::Get(1)
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{v}")
}
