//# #3326 review: a program's own type spelled like a compiler-owned head.
//
// A program may declare `struct Future[T]`
// (fixtures/user_future_struct_field_call_test.vibe). Its values resolve to
// the same `CtNamed("Future", args)` the compiler's own `Future` does, so a
// check that decided ownership by spelling let an array through here, and
// `x.v` read the array's packed representation.

struct Future[T] {
  v: T
}

fn main() -> Unit allows Console {
  let x: Future[Int] = [1]
  println(__to_string(x.v))
}
