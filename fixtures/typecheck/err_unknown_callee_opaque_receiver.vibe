// #3476: `no_such_fn` exists nowhere. Its first argument has an opaque
// imported type (`TaskHandle`), which used to send the call down the method
// retry, typed without a body, so it compiled and trapped when it ran.
import @vibe/concurrent { TaskGroup }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let s: String = no_such_fn(h)
    String::length(s)
  })
  println("r=\{r}")
}
