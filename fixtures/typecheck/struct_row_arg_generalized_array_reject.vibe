// #3589: the same as `struct_row_arg_generalized_lambda_reject`, with the
// literal inside an array.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

let make = () -> [Holder::{ run: noisy }]

fn quiet() -> Int {
  (Array::get(make(), 0).run)()
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
