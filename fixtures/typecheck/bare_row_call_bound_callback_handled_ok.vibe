// #3408 (Codex on #3409): the lambda is bound first and then passed to
// `run`, which handles the `Box` its callback parameter names. It is read
// at that use, as an inline argument is, so `mid` does not take `mk`'s
// `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn run(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}
fn mid() -> Int with Box {
  let cb = () -> mk()
  run(cb)
}
fn top() -> Int with Box[String] {
  mid()
}
