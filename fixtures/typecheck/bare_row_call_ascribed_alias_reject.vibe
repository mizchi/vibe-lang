// #3408 (Codex on #3409): an annotated local alias is lowered to an
// ascription around `mk`; it is still a call of `mk`, so `mid` requires
// `Box[Int]` and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let h: () -> Int with Box = mk
  h()
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
