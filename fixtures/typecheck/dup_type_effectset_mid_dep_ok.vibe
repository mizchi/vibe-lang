// #3036 (Codex on #3076): reaches dup_type_a_dep_ok's `Err` only through an
// effect-set member, `Exception[Err]`, and exports a function whose row is
// that set. `Err` itself is not re-exported.
import ./dup_type_a_dep_ok.vibe { Err }

export effectset Fail = { Exception[Err] }

export fn risky(n: Int) -> Int with Fail {
  if n < 0 {
    throw(Err::{ code: n })
  } else {
    n
  }
}
