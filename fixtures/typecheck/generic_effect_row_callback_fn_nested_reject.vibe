// #3311 (Codex on #3340): a function type nested in a declared generic
// struct, `W[Mapper]`, is handed to the lambda with its parts. Before, the
// function type inside made the whole instantiation unreadable, and this
// checked clean.
effect Box[T] {
  Put(T) -> Int
}

type Mapper = (Int) -> Int

struct W[T] {
  f: T
}

fn run_w(f: () -> Int with Box[W[Mapper]]) -> Int {
  handle {
    f()
  } with {
    Box::Put(w) => resume(w.f(41))
  }
}

fn producer() -> Int with Box[W[Mapper]] {
  run_w(() -> {
    perform Box::Put(W::{ f: (s: String) -> Int { String::length(s) } })
  })
}
