// #3518: the same lost binding let any non-Send result through, not only a
// closure: `Option[Array[Int]]` shares the array with the joining task.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Int allows Exception {
  TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> {
      Some([1, 2])
    })
    match TaskHandle::join(h) {
      Some(xs) => Array::length(xs),
      None => 0
    }
  })
}
