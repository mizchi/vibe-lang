// #3042 (Codex on #3063): an import that binds `Less` to another enum does not
// stand in for the prelude `Ordering`. Before the check, the prelude was
// skipped because SOME `Less` was already bound, and the derived `compare`
// built this `Verdict::Less` where it promised an `Ordering`. The derive is
// refused with the edit that fixes it.
import ./ordering_foreign_less_dep_ok.vibe { Verdict, verdict_of }

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = verdict_of(1)
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
