effect Ask {
  Get() -> Int
}

fn run() -> Int with Ask {
  let mut side = () -> Int { perform Ask::Get() }
  handle {
    side = () -> Int { perform Ask::Get() }
    perform Ask::Get()
  } with {
    Ask::Get() => resume(0)
  }
  handle { side() } with {
    Ask::Get() => resume(42)
  }
}

export fn main() -> Int {
  handle { run() } with {
    Ask::Get() => resume(1)
  }
}
