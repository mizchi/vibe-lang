// Codex on #3620: the field `f` is declared `with Box[T]`, a row naming the
// struct's type parameter. The closure stored in `h` is a literal bound by
// `let` and named in the field, and that record writes no type arguments and
// is bound under no annotation, so the compiler cannot give the closure the
// instantiated row (`Box[String]`), while `drive` calls it with that handler.
// Named, the literal slipped past the refusal its inline spelling gets
// (closure_field_generic_row_inferred_refused.vibe): with `tick` performing
// `Box`, `drive` passes the handler, and this program trapped ("null function
// or function signature mismatch") after a clean `vibe check`. The build is
// refused with the same edit.
effect Box[T] {
  Put(T) -> Unit
}

struct Holder[T] {
  f: () -> Int with Box[T]
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(_) => resume(())
  }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 7
  let h = Holder::{ f: g }
  drive(h.f) + drive(tick)
}
