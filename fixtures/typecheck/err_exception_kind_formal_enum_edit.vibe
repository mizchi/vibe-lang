// #3549: the alternative edit is a value of an enum the program declares.
// The hint used to suggest `Result[_, T]`, a type the language no longer has.
fn boom[T](x: T) -> Int with Exception[T] {
  throw(x)
}

fn main() -> Unit allows Console {
  let r = handle { boom("abc") } with { Exception[String]::Throw(e) => String::length(e) }
  println("r=\{r}")
}
