// #3488: a map literal holds its values, so a map built over an outer cell
// reaches it, and a handle stored through it outlives the group (Codex on
// #3492).
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    let m = Map::from_pairs([("k", outer)])
    m["k"].v = Some(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
