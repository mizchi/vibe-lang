// #3155: calling a local alias of a row-polymorphic function (and an alias of
// that alias) checks like the direct call. Every call here passes a pure
// argument, so nothing is required. Before the fix the alias carried the
// variable `e` uninstantiated and `main` was refused with "entry point 'main'
// has unresolved effect row { e }". generic_effect_local_alias_leak.vibe is
// the effectful twin, and a bare `e` would still leak there.
fn apply[T](f: () -> T with e) -> T with e {
  f()
}

fn pure_one() -> Int {
  1
}

fn main() -> Unit allows Console {
  let a = apply
  let b = a
  let v = b(() -> 40) + a(pure_one) + apply(pure_one)
  println("\{v}")
}
