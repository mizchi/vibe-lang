// #3416: `mid` returns the closure, but it also runs it before returning,
// so that call's `Box[Int]` is `mid`'s and a `Box[String]` caller is refused.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> (() -> Int with Box[Int]) with Box {
  let f = () -> mk()
  let n = f()
  f
}
fn caller() -> Int with Box[String] {
  let g = mid()
  0
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
