// Codex on #3995: `Apply[F[_], A] = F[A]` applies its constructor argument,
// so `Ai = Apply[Dup, A(i-1)]` doubles at each step although no alias body
// names `Dup` directly. The canonical-key definitions are bounded by the
// checker's own alias count, which reads each argument's real size, so
// the chain is capped and the preflight reports it instead of exhausting the
// stack.
type Apply[F[_], A] = F[A]
type Dup[T] = (T, T)
type A0 = Int
type A1 = Apply[Dup, A0]
type A2 = Apply[Dup, A1]
type A3 = Apply[Dup, A2]
type A4 = Apply[Dup, A3]
type A5 = Apply[Dup, A4]
type A6 = Apply[Dup, A5]
type A7 = Apply[Dup, A6]
type A8 = Apply[Dup, A7]
type A9 = Apply[Dup, A8]
type A10 = Apply[Dup, A9]
type A11 = Apply[Dup, A10]
type A12 = Apply[Dup, A11]
type A13 = Apply[Dup, A12]
type A14 = Apply[Dup, A13]
type A15 = Apply[Dup, A14]
type A16 = Apply[Dup, A15]
type A17 = Apply[Dup, A16]
type A18 = Apply[Dup, A17]
type A19 = Apply[Dup, A18]
type A20 = Apply[Dup, A19]
type A21 = Apply[Dup, A20]
type A22 = Apply[Dup, A21]
type A23 = Apply[Dup, A22]
type A24 = Apply[Dup, A23]
trait Mark[X] {}
struct Note {
  n: Int
}
impl Mark[Int] for Note {}
fn main allows Console {
  println("ok")
}
