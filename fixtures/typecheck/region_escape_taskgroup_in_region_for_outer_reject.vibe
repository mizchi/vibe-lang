// #4050: inside a `TaskGroup::run` body nested in r1, a container declared
// outside r1 may not keep an r1 value through a loop variable.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let gboxes = [outer]
  let v = region r1 {
    let cell1 = MutList::empty(r1)
    MutList::push(cell1, 3)
    let w = TaskGroup::run((n) -> {
      for a in gboxes {
        Array::push(a, value = cell1)
      }
      1
    })
    w
  }
  v * 10 + Array::length(outer)
}
