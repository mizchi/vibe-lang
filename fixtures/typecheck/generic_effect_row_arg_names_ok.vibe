// #3319 control: a row argument naming a formal in scope (the function's own,
// or an enclosing one inside a nested lambda), a builtin, a declared struct,
// an alias, or a function type's row in an annotation is not an unknown type.
effect Box[T] {
  Put(T) -> Int
}

struct P {
  x: Int
}

type Ints = Array[Int]

fn own_formal[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}

fn builtin() -> Int with Box[Array[Int]] {
  perform Box::Put([1])
}

fn declared() -> Int with Box[P] {
  perform Box::Put(P::{ x: 1 })
}

fn alias() -> Int with Box[Ints] {
  perform Box::Put([2])
}

fn enclosing_formal[T](x: T) -> Int {
  let inner = () -> Int with Box[T] {
    perform Box::Put(x)
  }
  0
}

fn annotated(cb: () -> Int with Box[Option[P]]) -> Int {
  0
}
