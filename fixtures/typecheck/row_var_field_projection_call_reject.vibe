// #3568: a callback stored in a struct field and called through the field
// runs the callback, so `wrap` must declare `e` exactly as a direct `f()`
// would require. Before the fix this compiled, and `quiet` printed from a
// function declared pure.
struct Holder[e] {
  run: () -> Int with e
}

fn wrap(f: () -> Int with e) -> Int {
  let h = Holder::{ run: f }
  (h.run)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
