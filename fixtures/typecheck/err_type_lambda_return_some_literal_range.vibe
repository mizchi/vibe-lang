// A `return` whose value holds an integer literal (`Some(4294967296)`) takes
// the type the rest of the lambda settles on -- here `Option[UInt32]`, from
// the tail -- and the literal is range-checked against it (#4062).
fn f(k: UInt32) -> Option[UInt32] {
  let g = (x: UInt32) -> {
    if x == 0 {
      return Some(4294967296)
    }
    Some(x)
  }
  g(k)
}
