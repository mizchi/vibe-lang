// A fully labeled call that reorders its labels AND omits a trailing default
// cannot be reordered into declared order, so it must be refused rather than
// bind the labels by position (`a = 4, b = 5`).
fn f(a: Int = 1, b: Int = 2, c: Int = 3) -> Int {
  a * 100 + b * 10 + c
}

fn main() -> Unit {
  let _ = f(b = 4, a = 5)
  ()
}
