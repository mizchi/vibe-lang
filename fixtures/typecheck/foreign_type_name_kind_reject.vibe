//# #3026: the same collision through an exception kind. `fail_err` throws the
//# dependency's `Err`; this module's `Exception[Err]` handler bound it at the
//# local `Err` (measured: `String::length(e.name)` answered 14).
import ./foreign_type_name_dep.vibe { fail_err }

struct Err {
  name: String
}

fn relay() -> Int with Exception[Err] {
  fail_err()
}

fn main() -> Unit {
  let _ = handle {
    relay()
  } with {
    Exception[Err]::Throw(e) => String::length(e.name)
  }
}
