// #3601: `bad`'s erased row lets an `Int` out, which a call of `bad` is
// charged. Passed as a value to a parameter typed with the erased row, it is
// typed by that row alone: `run`'s `f()` raised nothing but messages to the
// checker, and the erased arm read the `Int` 7 as a `String` (`len=14`).
fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn bad() -> Int with Exception {
  throw(7)
}

fn main() -> Unit allows Console {
  let r = handle {
    run(bad)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
