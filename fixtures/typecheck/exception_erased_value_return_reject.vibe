// #3609: a function's declared result is the slot its final expression is
// handed to. A result typed with the erased row alone carries only messages,
// so `bad`, which lets out an `Int`, is still refused there.
fn bad() -> Int with Exception {
  throw(7)
}

fn make() -> () -> Int with Exception {
  bad
}

fn main() -> Unit allows Console {
  let r = handle {
    make()()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
