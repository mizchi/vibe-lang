//# #3549: a tuple element holding a function. Measured before the refusal,
//# `(f, 1) == (f, 1)` answered `true` and the same pair built from a second
//# closure `false`.
export fn main() -> Int {
  let f = (x: Int) -> x + 1
  let g = (x: Int) -> x + 1
  if (f, 1) == (g, 1) {
    1
  } else {
    0
  }
}
