// #3086: `None` is the built-in Option empty value, and every `None` in an
// expression resolves to it in the checker. A loop variable named `None` is refused
// at its own token, with the rename named, instead of being silently ignored.
struct B {
  v: Bool
}

fn main() -> Unit {
  let _ = for None in [1, 2] {
    None + 1
  }
}
