// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The function it is handed calls it only inside a closure of
// its own, which it keeps. `g()` answered `6` from the dead handler after
// `vibe check` was clean.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Unit {
  Array::push(saved, () -> f() + 0)
}

fn main() -> Unit allows Console {
  handle {
    keep(() -> perform Ask::Get() + 1)
  } with { Ask::Get() => resume(5) }
  let g = Array::get(saved, 0)
  println("g=\{g()}")
}
