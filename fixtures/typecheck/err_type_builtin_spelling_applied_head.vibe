//# #2475 (Codex on #2819): `Array` / `Option` / `StringMap` are NOT in
//# `resolve_builtin` -- they are hard-coded in the APPLIED door of
//# `resolve_type_expr_core_shadowed`, at arity 1 only. So `enum Option[T]`
//# collides even though the name-only registry does not know it.
//#
//# Arity is what makes this precise: `struct Array[K, V]` resolves through
//# `find_typedef` and stays legal, as does a bare `struct Option`.
enum Option[T] {
  Yes(T);
  Nope
}

export fn main() -> Int {
  0
}
