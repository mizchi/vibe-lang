// Codex on #3620: a closure literal bound by `let` takes a row-typed field's
// row at its binding only when it is stored by its own name. Stored through
// a local alias (`let alias = g`), the alias's binding is a use of `g` the
// compiler cannot give the row, so `g` kept the row-free calling convention
// while the field's reader (`drive`) passed the handler (`tick` performs
// `Box`), and the call trapped
// ("null function or function signature mismatch") after a clean
// `vibe check`. The build is refused with the edit; `g` stored by its own
// name answers (fixtures/closure_field_generic_row_test.vibe).
effect Box[T] {
  Put(T) -> Unit
}

struct Holder[T] {
  f: () -> Int with Box[T]
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(_) => resume(())
  }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let alias = g
  let h = Holder[String]::{ f: alias }
  drive(h.f) + drive(tick)
}
