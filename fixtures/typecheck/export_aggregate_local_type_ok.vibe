//# #2762 green side: a private `struct` / `enum` / type alias. Unlike a trait
//# or an effect these DO carry a flat binding, so they resolve through the
//# other half of the predicate.

export {
  Point,
  Hue,
  Ints
}

struct Point {
  x: Int
}

enum Hue {
  Red;
  Blue
}

type Ints = Array[Int]

export fn main() -> Int {
  1
}
