// #3574: `Job[e]` beside `with e` names the signature's row variable, so a
// call instantiates it from the literal and charges the caller.
effect Tick {
  Step(Int) -> Int
}

struct Job[e] {
  run: () -> Int with e
}

fn ticks() -> Int with Tick {
  perform Tick::Step(10)
}

fn go(j: Job[e]) -> Int with e {
  (j.run)()
}

fn leak() -> Int {
  go(Job::{ run: ticks })
}
