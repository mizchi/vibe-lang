// #3416: the callback is passed to a LOCAL lambda that handles the `Box` its
// parameter names. A top-level `run` with the same signature was recognized
// as discharging it (`bare_row_call_bound_callback_handled_ok`); the local
// one was not, so `mid` took `mk`'s `Box[Int]` and `top` was refused. The
// lambda's body is read: its only use of `f` is a call inside the handle.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  let cb = () -> mk()
  let lrun = (f: () -> Int with Box[Int]) -> Int {
    handle {
      f()
    } with { Box::Put(n) => resume(n + 1) }
  }
  lrun(cb)
}
fn top() -> Int with Box[String] {
  mid()
}
