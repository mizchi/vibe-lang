// #3564: a function field spelled through a type alias. The derived renderer
// matched the alias name, not the function type it names, so the refusal for
// a function field (#3092) never saw it and `"\{c}"` printed `C { f: 4097 }`,
// a table index.
type F = (Int) -> Int

struct C {
  f: F
} derive (Show)

fn show_c() -> String {
  let c = C::{ f: (x) -> x }
  "c=\{c}"
}
