// #3036 control: `Probe::probe` takes dup_type_a_dep_ok's `Err`, and `Err`
// is imported from dup_type_a_dep_ok itself -- the same declaration through
// a trait signature and a direct import. Stays legal.
import ./dup_type_trait_sig_mid_dep_ok.vibe { trait Probe }
import ./dup_type_a_dep_ok.vibe { Err }

fn read() -> Int {
  Probe::probe(1, Err::{ code: 2 })
}
