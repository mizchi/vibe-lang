// #3476: `handle_count` is private to its module and not imported. The
// method retry on the `TaskHandle` argument used to accept the call, and the
// program ran the dependency's private function.
import @vibe/concurrent { TaskGroup }
import ./opaque_receiver_dep_ok.vibe { visible_count }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    visible_count(h) + handle_count(h)
  })
  println("r=\{r}")
}
