//# #3549: `derive (Eq)` registers `impl Eq`, so a `[T: Eq]` bound was
//# satisfied by `D` and its derived comparator compared the function field by
//# identity: measured before the refusal, `eq2(a, b)` answered `false` for two
//# values built from closures with the same body. The derive is refused at the
//# declaration, whether or not anything compares a `D` (a bound instantiated
//# at `D` is refused as well, by the same rule as
//# eq_function_generic_derive_bound_reject.vibe).
struct D {
  f: (Int) -> Int
} derive (Eq)

export fn main() -> Int {
  let a = D::{ f: (x: Int) -> x + 1 }
  a.f(1)
}
