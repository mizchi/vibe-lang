// #3862: a constructor in a `match` arm is a tail too.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[A, B] {
  match 1 {
    _ => Pair(first, second)
  }
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(slot, _) = escaped
  Array::length(slot.callback())
}
