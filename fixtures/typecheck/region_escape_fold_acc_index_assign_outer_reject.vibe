// Codex on #4078: a fold callback pushes each region list into `acc[0]`, then
// points `acc[0]` at an outer array and returns `acc`. The next iteration's
// push lands in the outer array. Refused because the accumulator may hold a
// binding declared before the region (a narrowing that accepted it was
// withdrawn, #4101).
fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let v = region r {
    let a = MutList::empty(r)
    let b = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    let _ = Array::fold([a, b], init = init, f = (acc, c) -> {
      Array::push(acc[0], value = c)
      acc[0] = sink
      acc
    })
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
