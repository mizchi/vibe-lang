// #4091: the dependency of region_escape_imported_method_call_receiver_reject.
// `Holder::sink` returns this module's array.

let kept: Array[MutList[Int]] = []

export struct Holder {
  n: Int
}

export fn make_holder() -> Holder {
  Holder::{ n: 1 }
}

export fn Holder::sink(self: Holder) -> Array[MutList[Int]] {
  let _ = self.n
  kept
}

export fn kept_len() -> Int {
  Array::length(kept)
}
