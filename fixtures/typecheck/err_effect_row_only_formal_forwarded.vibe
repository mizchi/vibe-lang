// #3386: `T` is named only by `run`'s rows, and `run` forwards `Box[T]` to its
// caller, so the call fixes `T := String` from `caller`'s row. The lambda's
// `Put(12345)` used to be checked at a free `T` and reach a `Box[String]`
// handler.
effect Box[T] {
  Put(T) -> Int
}

fn run[T](f: () -> Int with Box[T]) -> Int with Box[T] {
  f()
}

fn caller() -> Int with Box[String] {
  run(() -> {
    perform Box::Put(12345)
  })
}
