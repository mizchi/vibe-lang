// #3371 (Codex on #3384): the suggested binder must not capture a name the
// arm body reads. This body reads the outer `v` and `v1`; suggesting
// `Pick::P(v) => if v == 1 { .. }` would have made `resume(v + v1)` read the
// payload instead and silently changed the answer, so the binder is `v2`.
// The edited arm is run in fixtures/handler_arm_payload_binder_test.vibe.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

fn run(v: Int, v1: Int) -> Int {
  handle {
    perform Pick::P(3)
  } with {
    Pick::P(1) => resume(v + v1);
    Pick::Q(_) => resume(7)
  }
}
