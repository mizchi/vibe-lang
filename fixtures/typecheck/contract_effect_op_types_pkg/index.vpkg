// #4018: an effect a contract declares names the types the same contract
// declares -- a struct, an alias over it, and an opaque type its sibling
// implementation file defines.
struct Item {
  n: Int
}

type Items = Array[Item]

opaque type Token

effect Src {
  Next(Token) -> Option[Item];
  All() -> Items
}

fn count() -> Int with Src
fn first_token() -> Token
