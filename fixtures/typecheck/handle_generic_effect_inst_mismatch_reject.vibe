//# #3010: the handle instantiates `State[S]` at `S = String` (its `Get` arm
//# answers a String), but the handled call declares `State[Int]`. Nothing
//# compared the two, so `perform State::Get() + 1` ran on the string.
effect State[S] {
  Get() -> S;
  Put(v: S) -> Unit
}

fn counter() -> Int with State[Int] {
  perform State::Get() + 1
}

export fn main() -> Int {
  let s = handle {
    counter()
  } with {
    State::Get() => "str";
    State::Put(_v) => ()
  }
  String::length(s)
}
