// #3589 (Codex review on #3594): two branches storing different rows in a
// struct's row argument (`Inner[Console]` and `Inner[Env]`) do not join to
// the first one: the `Env` branch would run in a `Console` function. The
// join is refused, as it is for the two functions themselves.
struct Inner[r] {
  run: () -> Int with r
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn home() -> Int with Env {
  if Env::get("HOME") == "" {
    2
  } else {
    3
  }
}

fn run_it[r](i: Inner[r]) -> Int with r {
  (i.run)()
}

fn pick(c: Bool) -> Int with Console {
  let i = if c {
    Inner::{ run: say }
  } else {
    Inner::{ run: home }
  }
  run_it(i)
}

fn main() -> Unit allows Console + Env {
  println("\{pick(false)}")
}
