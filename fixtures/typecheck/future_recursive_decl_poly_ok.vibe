// #3112: the value restriction keeps a binding that holds a `Future` cell
// monomorphic, and looks through declarations to find one. A recursive
// declaration with no `Future` anywhere -- `Chain[T]` below -- is not such a
// holder, so `let e = Chain::End` stays polymorphic and is usable at two
// types. The walk used to follow `Chain`'s own recursive payload to its depth
// cap and count that as a future cell (Codex on #3091).
enum Chain[T] {
  Link(T, Chain[T]);
  End
}

fn uses() -> Int {
  let e = Chain::End
  let a: Chain[Int] = e
  let b: Chain[String] = e
  match (a, b) {
    (End, End) => 1,
    _ => 0
  }
}
