// #3042 (Codex on #3063): a top-level VALUE spelled like a prelude
// constructor shadows it as a declaration would. Resolution lets `let Less`
// win over the constructor, so a derived `compare` would return this `Int`.
let Less = 1

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = Less
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
