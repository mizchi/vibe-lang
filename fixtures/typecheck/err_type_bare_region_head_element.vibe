// `MutList[T, r]` has a region slot the call may supply, but its element
// type is a payload: a bare `MutList` parameter pushed a `String` into a
// `MutList[Int]`, and `+ 1` read the string's pointer (`137438953473`).
fn add_str(l: MutList) -> Unit {
  MutList::push(l, "s")
}

fn total() -> Int {
  let frozen = region r {
    let l = MutList::empty(r)
    MutList::push(l, 1)
    add_str(l)
    MutList::freeze(l)
  }
  FrozenArray::get(frozen, 1) + 1
}
