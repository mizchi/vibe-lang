// #3561: `wrap` hands its callback's row variable to `apply`, so it must
// declare it, exactly as a direct `f()` would require. Before the fix this
// compiled, and `quiet` printed from a function declared pure.
fn apply(f: () -> Int with e) -> Int with e {
  f()
}

fn wrap(f: () -> Int with e) -> Int {
  apply(f)
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
