// #3540: a closure that throws what a `handle` catches must not outlive
// that handle. `mk` throws and returns a closure without the row, which
// inherited its throw from `mk`'s; returned as the handle's value, `g()`
// threw with no handler around it and trapped after `vibe check` was
// clean. fixtures/handle_bound_closure_inside_test.vibe returns a struct
// whose field holds a closure under an exception row.
fn mk() -> (() -> Int) with Exception[Int] {
  () -> throw(7)
}

fn main() -> Unit allows Console {
  let g = handle {
    mk()
  } with { Exception[Int]::Throw(_) => () -> 0 }
  println("g=\{g()}")
}
