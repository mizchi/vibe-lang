// #3343: a body passed BY NAME. `TaskGroup::run(body)` checked only the
// literal spelling inside the region, so this compiled and the handle was
// joined after its group closed. The named closure is now re-checked under
// the call's region, its group parameter carrying the region, as a literal
// body is.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let body = (n) -> {
    c.v = Some(TaskGroup::spawn(n, () -> { 41 }))
    1
  }
  let r = TaskGroup::run(body)
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
