// #3551 review control: a lambda written inside an erased
// `Exception::Throw(m)` arm and bound by `let` receives only the arguments of
// its direct calls. Called with values of its own, its parameter -- even one
// spelled `m` -- holds a `String` of its own, so `Exception[String]` is the
// row each function declares. Every lambda parameter used to count as a
// carrier of the caught value.
fn f() -> Int with Exception[Int] {
  throw(7)
}

fn shadowing_param() -> Int with Exception[String] {
  handle { f() } with { Exception::Throw(m) => {
    let k = (m: String) -> throw(m)
    k("other")
  } }
}

fn other_param() -> Int with Exception[String] {
  handle { f() } with { Exception::Throw(m) => {
    let _n = String::length(m)
    let k = (s: String) -> throw(s)
    k("other")
  } }
}

fn main allows Console {
  let a = handle { shadowing_param() } with { Exception[String]::Throw(s) => String::length(s) }
  let b = handle { other_param() } with { Exception[String]::Throw(s) => String::length(s) }
  println("\{a} \{b}")
}
