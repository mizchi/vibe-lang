// #3947: one of two sibling impls of `Value` for `Note`, spelled through an
// exported alias of `Int`.
import ./impl_overlap_alias_base_dep_ok.vibe {
  Note, Value
}

export type Alias = Int

impl Value[Alias] for Note {
  value(self) -> Alias {
    1
  }
}

// Not `Value::value(..)`: a qualified call to a trait a reused checked module
// exports is refused under VIBE_CHECKED_MODULE_CACHE=on (#3965), and the
// linked check this pair exists for needs only the two impls.
export fn from_a() -> Int {
  1
}
