// #3518 review: `T` occurs as `Array[?u]` and as `Array[() -> Int with Log]`,
// and `?u` itself also meets a `() -> Int with Tick` slot. Merging `T` bound
// `?u` to the `Log` function, and `?u`'s own occurrence was then skipped as
// already bound, so the `Tick` slot held a `Log` function. Every occurrence is
// now checked against its variable's final binding: the rows differ, and the
// argument is refused with the edit.
effect Log {
  Emit(Int) -> Unit
}

effect Tick {
  Bump() -> Unit
}

fn logged() -> Int with Log {
  perform Log::Emit(1)
  1
}

fn three[T, e](mk: () -> (T, T, () -> Int with Tick) with Exception + e) -> Int {
  0
}

fn main() -> Int allows Exception {
  let us = []
  three(() -> (us, [logged], Array::get(us, 0)))
}
