// A struct field row naming a declared effect, and a struct whose row
// parameter is a lowercase letter, are accepted by the check that refuses an
// unknown effect in a field row (`struct_field_row_*_reject.vibe`).
effect Ask {
  Get() -> Int
}

struct Asking {
  run: () -> Int with Ask
}

struct Holder[e] {
  run: () -> Int with e
}

fn asks() -> Int with Ask {
  perform Ask::Get() + 1
}

fn call_asking(a: Asking) -> Int with Ask {
  (a.run)()
}

fn call_holder[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

fn both() -> Int with Ask {
  call_asking(Asking::{ run: asks }) + call_holder(Holder::{ run: asks })
}
