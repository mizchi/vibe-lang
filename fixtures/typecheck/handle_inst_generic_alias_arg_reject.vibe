// #3027: a generic alias argument is read through to its target with the
// alias's parameter substituted. `get_id` declares `State[Id[Int]]`, which is
// `State[Int]`; the handler resumes a String.
type Id[T] = T

effect State[S] {
  Get() -> S
}

fn get_id() -> Int with State[Id[Int]] {
  perform State::Get()
}

fn main() -> Unit allows Console {
  let n = handle {
    get_id()
  } with { State::Get() => resume("abc") }
  println("\{n + 1}")
}
