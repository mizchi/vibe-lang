// #4091: an imported function's body is not read here, and it may return its
// own module's storage, as this getter does; its result is outer storage.

import ./region_escape_import_getter_dep_ok.vibe { get_sink, kept_len }

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let s = get_sink()
    Array::push(s, value = c)
    1
  }
  println("v=\{v} kept=\{kept_len() > 0}")
}
