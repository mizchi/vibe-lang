// #4088: a program's own `fn Array::reverse` is not the builtin, whose
// result is fresh storage: this one answers its argument, so the closure
// stored into the result is in `arr`, and keeping `arr` is refused.
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn Array::reverse(xs: Array[() -> Int]) -> Array[() -> Int] {
  xs
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let arr = [plain]
    let copy = Array::reverse(xs = arr)
    Array::set(copy, at = 0, value = g)
    let _ = keep_arr(xs = arr)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("k=\{k()}")
}
