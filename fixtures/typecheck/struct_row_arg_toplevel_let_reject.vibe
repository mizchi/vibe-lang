// #3589: a top-level binding of a literal keeps the row it stored, alone and
// inside an array or a tuple.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

let h = Holder::{ run: noisy }

let hs = [Holder::{ run: noisy }]

let tp = (Holder::{ run: noisy }, 2)

fn quiet() -> Int {
  (h.run)() + (Array::get(hs, 0).run)() + (tp.0.run)()
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
