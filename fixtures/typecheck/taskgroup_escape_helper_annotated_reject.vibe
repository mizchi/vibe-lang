// #3343: the helper's parameters are annotated with types that do not spell
// the region (`TaskHandle[Int]`), so a check of its body alone sees no group.
// The re-check binds each parameter to its argument's type at the call, which
// carries the region. This compiled and the handle was joined after its group
// closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn put(c: Array[Option[TaskHandle[Int]]], h: TaskHandle[Int]) -> Unit {
  Array::set(c, 0, Some(h))
}

fn main() -> Unit allows Exception + Console {
  let c: Array[Option[TaskHandle[Int]]] = [None]
  let r = TaskGroup::run((n) -> {
    put(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  let after = match Array::get(c, 0) {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
