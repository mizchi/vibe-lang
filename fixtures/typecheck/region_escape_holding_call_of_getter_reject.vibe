// #4091 (Codex on #4106): `same` may return its argument, so the box's
// `items` is the getter's storage, and the push keeps the region value there.

let sink: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  sink
}

fn same(xs: Array[MutList[Int]]) -> Array[MutList[Int]] {
  xs
}

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let boxes: Array[Box] = []
    Array::push(boxes, value = Box::{ tag: 0, items: same(xs = get_sink()) })
    let b = Array::get(boxes, at = 0)
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
