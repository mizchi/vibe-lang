// #3101: a lambda with no row of its own inherits the enclosing
// `with State[S]`, whose `S` is the OUTER formal. `get(y)` requires the
// lambda's own `S`, which merely shares the spelling.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[S](x: S) -> Int with State[S] {
  let g = [S](y: S) -> Int {
    get(y)
  }
  0
}
