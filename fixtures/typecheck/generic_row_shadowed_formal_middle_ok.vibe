// #3101 control: under a non-generic middle lambda, the inner lambda passes
// its own `S`.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[S](x: S) -> Int {
  let h = (u: Int) -> Int {
    let g = [S](y: S) -> Int with State[S] {
      get(y)
    }
    u
  }
  0
}
