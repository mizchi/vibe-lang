// #4050 (Codex on #4061): a constructor pattern pairs with a call of that constructor, and the tuple inside it pairs component by component.
// `main` answers 10 * the block's value + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let inner: Array[MutList[Int]] = []
    match Some((outer, inner)) {
      Some((_, a)) => Array::push(a, value = cell),
      None => ()
    }
    1
  }
  v * 10 + Array::length(outer)
}
