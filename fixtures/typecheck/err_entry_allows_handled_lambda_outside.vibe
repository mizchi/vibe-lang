// ADR-0124 decision 3 (#2656), r9: a local function value whose row names
// `Db`, called outside the handler, is refused at the call.
effect Db {
  Get(Int) -> Int
}

fn main allows Console + Db {
  let f = () -> Int with Db {
    perform Db::Get(1)
  }
  let a = f()
  let v = handle {
    f()
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{a} \{v}")
}
