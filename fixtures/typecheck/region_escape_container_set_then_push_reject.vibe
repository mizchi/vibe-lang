// #4091: a container of the region body comes to hold an outer array through
// `Array::set`, and a region value is then pushed into that element. The
// check had no model of what a container holds, so it judged the element by
// the container, which is local.

let sink: Array[MutList[Int]] = []

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let init: Array[Array[MutList[Int]]] = [[]]
    Array::set(init, at = 0, value = sink)
    Array::push(Array::get(init, at = 0), value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
