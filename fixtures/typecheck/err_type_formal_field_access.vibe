//# #2848: a field read on a TYPE PARAMETER receiver is refused.
//#
//# `Crate` declares `payload`; `T` promises nothing. Before the fix the read
//# typed as `CtUnknown` (a plain formal is a unification variable inside its
//# body, and an unsolved variable was tolerated) and codegen resolved
//# `.payload` by SPELLING against the only struct declaring it, emitting a load
//# at that struct's offset. Measured on the committed seed: this compiled clean
//# on both lanes and answered `0` -- slot 0 of the tagged integer `7`, read
//# through `Crate`'s field offset. There is no `Crate` anywhere near the call.
struct Crate {
  payload: Int
}

fn read[T](m: T) -> Int {
  m.payload
}

export fn main() -> Int {
  read(7)
}
