// #3947 (Codex on #3956): two sibling modules implement `Value` for `Note`,
// one as `Value[Alias]` (`type Alias = Int`), one as `Value[Int]`. Neither
// module's own check sees the other, so the linked program's coherence check
// must compare canonical keys; the lowering keys both impls alike.
import ./impl_overlap_alias_a_dep_ok.vibe {
  from_a
}

import ./impl_overlap_alias_b_dep_ok.vibe {
  from_b
}

fn main allows Console {
  println("\{from_a() * 10 + from_b()}")
}
