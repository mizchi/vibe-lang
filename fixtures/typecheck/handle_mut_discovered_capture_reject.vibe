effect Ask {
  Get() -> Int
}
type Callback = () -> Int

fn make() -> Callback {
  () -> Int {
    0
  }
}

fn run() -> Int with Ask {
  let mut side = () -> Int {
    0
  }
  let mut helper = make()
  helper = () -> Int {
    perform Ask::Get()
  }
  side = () -> Int {
    helper()
  }
  helper = () -> Int {
    7
  }
  handle {
    side()
  } with { Ask::Get() => resume(42) }
}

export fn main() -> Int {
  handle {
    run()
  } with { Ask::Get() => resume(1) }
}
