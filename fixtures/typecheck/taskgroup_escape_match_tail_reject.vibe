// #3343 (Codex on #3359): the body's tail is a `match` whose arms each build
// a struct holding a handle. This compiled and the handle was joined after
// its group closed; the call is refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

fn main() -> Unit allows Exception + Console {
  let pick: Option[Int] = Some(1)
  let b = TaskGroup::run((n) -> {
    match pick {
      Some(k) => Box::{ h: TaskGroup::spawn(n, () -> { k + 40 }) },
      None => Box::{ h: TaskGroup::spawn(n, () -> { 0 }) }
    }
  })
  println("after=\{TaskHandle::join(b.h)}")
}
