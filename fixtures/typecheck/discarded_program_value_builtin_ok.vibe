// #4146: only the builtin is judged. A program's own `fn String::concat` is a
// call to that function, whatever it does.
let log: Array[String] = []

fn String::concat(a: String, b: String) -> String {
  Array::push(log, value = b)
  a
}

fn main() -> Int {
  String::concat(a = "x", b = "y")
  Array::length(log)
}
