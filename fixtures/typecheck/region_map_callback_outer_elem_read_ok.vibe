// #4050 control: a callback over a container declared outside the region may
// read each element and write a region-free value into it; only a region
// value written there outlives the region. A callback over a container
// declared inside the region may keep region values in it.
fn main() -> Unit allows Exception + Console {
  let outer: Array[Int] = []
  let boxes = [outer]
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let sizes = Array::map(boxes, f = (a) -> {
      Array::push(a, value = MutList::length(cell))
      Array::length(a)
    })
    let inner: Array[MutList[Int]] = []
    let mine = [inner]
    let _ = Array::map(mine, f = (b) -> {
      Array::push(b, value = cell)
      0
    })
    Array::get(sizes, at = 0) + Array::length(inner)
  }
  println("v=\{v} outer=\{Array::length(outer)}")
}
