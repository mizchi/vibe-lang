// #3311 (Codex on #3340): a lambda passed to a function-typed struct field,
// `r.run(..)`, performs at the field's row. A field call found the field's
// type only after its arguments, so the lambda was handed nothing and its
// `perform Box::Put(1)` chose `Int` under `run: (() -> Int with Box[String])
// -> Int`. The type check passed; only the effect-evidence pass refused the
// program, for a reason that has nothing to do with the payload.
effect Box[T] {
  Put(T) -> Int
}

struct Runner {
  run: (() -> Int with Box[String]) -> Int
}

fn producer(r: Runner) -> Int with Box[String] {
  r.run(() -> {
    perform Box::Put(1)
  })
}
