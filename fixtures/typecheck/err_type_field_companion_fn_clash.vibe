// #3896: a field holding a function beside a companion of the same name is
// refused at the companion. Before, `g.get()` was typed as `G::get` (an `Int`)
// while both lowerings ran the field (a `String`), so `n + 1` printed the
// string's raw representation.
struct G {
  get: () -> String
}

fn G::get(_ g: G) -> Int {
  41
}

fn main() -> Unit {
  let g = G::{ get: () -> "field" }
  let n: Int = G::get(g)
  ()
}
