// #3408: a lambda that `mid` only builds can still be invoked there. Its
// body is read, so `mid` requires `Box[Int]` (Codex on #3409 asked to leave
// built closures out; that would let this through).
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid() -> Int with Box {
  Array::get([() -> mk()], 0)()
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
