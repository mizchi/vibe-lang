// #4050: an r1-local literal over an outer array carries the outer array's
// regions: its element, iterated inside r2, may not keep an r1 value.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let v = region r1 {
    let cell1 = MutList::empty(r1)
    MutList::push(cell1, 3)
    let boxes = [outer]
    let w = region r2 {
      for a in boxes {
        Array::push(a, value = cell1)
      }
      1
    }
    w
  }
  v * 10 + Array::length(outer)
}
