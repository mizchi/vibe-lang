let sink: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  sink
}

struct State {
  tag: Int;
  items: Array[MutList[Int]]
}

let state: State = State::{ tag: 0, items: sink }

fn get_state() -> State {
  state
}

fn State::read_tag(self: State) -> Int {
  self.tag
}

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn main() -> Int allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let boxes: Array[Box] = []
    Array::push(boxes, value = Box::{ tag: get_state().read_tag(), items: [] })
    let b = Array::get(boxes, at = 0)
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  v * 10 + Array::length(sink)
}
