// #4142: only the builtin is judged. A program's own `fn Map::set` is a call
// to that function, whatever it does.
let log: Array[String] = []

fn Map::set(m: Map[String, Int], key: String, value: Int) -> Map[String, Int] {
  Array::push(log, value = key)
  m
}

fn main() -> Int {
  let m: Map[String, Int] = Map::new()
  Map::set(m = m, key = "a", value = 1)
  Array::length(log)
}
