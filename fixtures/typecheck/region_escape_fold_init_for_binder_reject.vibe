// Codex on #4078: a fold's `init` is a `for` binder over a getter's result.
// A binder's storage is not known, so the accumulator predates every active
// region. b44deee8c printed `kept=true`; main refuses it.
let kept: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let a = MutList::empty(r)
    let cells = [a]
    for s in [get_sink()] {
      let _ = Array::fold(cells, init = s, f = (acc, c) -> {
        Array::push(acc, value = c)
        acc
      })
    }
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
