//# #4037: the call is typed by a result variable, so a use that fixed it to
//# `String` is a mismatch once `Counter::size` is known to return `Int`.
struct Counter {
  n: Int
}

fn Counter::size(c: Counter) -> Int {
  c.n
}

fn Counter::add(c: Counter, k: Int) -> Int {
  c.n + k
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }, Counter::{ n: 2 }]
  let r: String = Array::fold(xs, init = "", f = (acc, c) -> acc + c.size())
  String::length(r)
}
