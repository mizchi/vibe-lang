// #3311 (Codex on #3340) control: payloads that are the type each call gives
// the imported callee's `T`, through the callee, its exported alias and a
// local alias, check clean.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_len, run_len_alias, run_pt, Pt
}

fn producer() -> Int with Box {
  let local = run_len
  run_len("abc", () -> {
    perform Box::Put("de")
  }, (s) -> String::length(s)) + run_len_alias(3, () -> {
    perform Box::Put(4)
  }, (n) -> n) + local([1], () -> {
    perform Box::Put([2, 3])
  }, (xs) -> Array::length(xs)) + run_pt(() -> {
    perform Box::Put(Pt::{ x: 5 })
  })
}
