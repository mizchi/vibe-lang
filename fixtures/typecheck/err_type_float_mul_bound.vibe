// #3625: `[T: Mul]` holds at `Float`, but `*` in the generic body fixes the
// operand type to `Int` (there is no witness to dispatch an erased `*`
// through), so the call is refused at the argument rather than multiplying
// two boxes or skipping the f32 rounding.
fn mul2[T: Mul](a: T, b: T) -> T {
  a * b
}

fn check() -> Float {
  mul2(1.5f, 2.0f)
}
