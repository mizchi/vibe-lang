// #3372: exported producers keep the same nominal authority as their consumers.
export effect Box[T] {
  Put(T) -> Int
}
export struct Pt { x: Int }
export enum Shade {
  Light
}

export fn producer() -> Int with Box[Pt] {
  perform Box::Put(Pt::{ x: 42 })
}
export fn run_pt(f: () -> Int with Box[Pt]) -> Int {
  handle {
    f()
  } with { Box::Put(p) => {
    let q: Pt = p; resume(q.x)
  } }
}

export fn enum_producer() -> Int with Box[Shade] {
  perform Box::Put(Light)
}
export fn run_shade(f: () -> Int with Box[Shade]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => {
    let q: Shade = s; resume(match q {
      Light => 42
    })
  } }
}
