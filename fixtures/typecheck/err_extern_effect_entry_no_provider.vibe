// ADR-0124 (#2656): the catalog classifies an `extern effect` as a capability
// from its declaration. Binding a provider is not implemented yet, so the
// entry still refuses it, and the refusal says so.
extern effect Kv {
  get(String) -> String
}

fn main() -> Unit allows Kv {
  let _ = Kv::get("a")
  ()
}
