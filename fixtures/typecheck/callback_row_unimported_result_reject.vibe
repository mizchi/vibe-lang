// #3351: an operation's RESULT at a callback row's unimported `Pt`. The
// lambda used to read the performed value at whatever type it liked (here an
// Int); it is a `Pt`.
import ./callback_row_unimported_dep_ok.vibe {
  effect Get, run_take
}

fn producer() -> Int with Get {
  run_take(() -> {
    let n = perform Get::Take()
    n + 1
  })
}
