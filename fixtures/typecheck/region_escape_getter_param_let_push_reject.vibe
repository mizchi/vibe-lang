// #4091: the same getter, its result held in a binding of the region body.

let kept: Array[MutList[Int]] = []

fn get_kept(n: Int) -> Array[MutList[Int]] {
  let _ = n
  kept
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    let a = get_kept(n = 1)
    Array::push(a, value = cell)
    1
  }
  println("v=\{v} kept=\{Array::length(kept) > 0}")
}
