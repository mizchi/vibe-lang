// #3095: a callback parameter's row is read where it was written. `f`
// requires `State[Box[S]]`, which `w`'s `with State[S]` does not cover.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

struct Box[T] {
  v: T
}

fn w[S](x: S, f: () -> Int with State[Box[S]]) -> Int with State[S] {
  f()
}
