// #3601: a closure literal bound by `let` with its own erased row throws an
// `Int`. A call through the binding read only that row, so the erased arm
// read the `Int` 7 as a `String` (`len=14`). The binding is charged the kinds
// the closure's row lets out, as a named function's caller is.
fn main() -> Unit allows Console {
  let f = () -> Int with Exception {
    throw(7)
  }
  let r = handle {
    f()
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
