// #3022 review: a closure bound inside the handled body and called there runs
// under the handler, so the calls in its body are compared with the handler's
// instantiation. `get_int` needs `State[Int]`; the handler resumes a String.
effect State[S] {
  Get() -> S
}

fn get_int() -> Int with State[Int] {
  perform State::Get()
}

fn main() -> Unit allows Console {
  let n = handle {
    let twice = () -> get_int() + get_int()
    twice()
  } with { State::Get() => resume("abc") }
  println("\{n}")
}
