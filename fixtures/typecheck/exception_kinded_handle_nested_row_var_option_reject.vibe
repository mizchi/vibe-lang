// #3540: a kinded arm over a row variable reached through a function held in
// an `Option` parameter and bound by a `match` arm. Before the fix this
// answered `274877906948`: the String thrown through `e` read as an Int.
fn guarded(o: Option[() -> Int with e]) -> Int with e {
  handle {
    match o {
      Some(f) => f() + 1,
      None => 0
    }
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded(Some(thrower))
  } with { Exception[String]::Throw(m) => String::length(m) }
}
