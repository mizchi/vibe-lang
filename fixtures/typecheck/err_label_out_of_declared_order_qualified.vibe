// ADR-0120 D2 at an explicitly qualified call: the diagnostic covers the whole
// written callee `Meter::sub`, from its start (Codex on #3903).
struct Meter { base: Int }

fn Meter::sub(_ self: Meter, a: Int, b: Int) -> Int {
  self.base + a - b
}

fn run(m: Meter) -> Int {
  Meter::sub(m, b = 1, a = 10)
}
