// #3549 control: the import binds `h`, so declaring the source name `helper`
// is no clash, and neither is a block-local binding spelled like an import.
import ./import_decl_clash_dep_ok.vibe { helper as h, other }

fn helper(n: Int) -> Int {
  h(n) + 100
}

fn local_shadow() -> Int {
  let other = 5
  other + helper(1)
}
