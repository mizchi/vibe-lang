// #3488 control (Codex on #3492): a field read at a generic struct's
// instantiation (`Holder[Int]`'s `tag: T`) is the scalar it instantiates to.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell;
  tag: Int
}

struct Holder[T] {
  tag: T
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let holder: Holder[Int] = Holder::{ tag: 7 }
  let r = TaskGroup::run((n) -> {
    let w = Wrap::{ cell: Cell::{ v: None }, tag: holder.tag }
    put(w, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
