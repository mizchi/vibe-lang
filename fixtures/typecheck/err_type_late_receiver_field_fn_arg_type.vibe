//# #4037: a function stored in a field, reached through a receiver that is
//# resolved only when `apply` unifies the lambda with its parameter. Measured
//# on main at 76e511a4a this checked clean and printed 137438953474: the
//# string handed to `(Int) -> Int` was added to as an integer. With
//# `(v: Holder)` it was refused; it is now refused either way.
struct Holder {
  f: (Int) -> Int
}

fn apply(h: Holder, g: (Holder) -> Int) -> Int {
  g(h)
}

fn main() -> Int {
  let h = Holder::{ f: (x) -> x + 1 }
  apply(h = h, g = (v) -> v.f("abc"))
}
