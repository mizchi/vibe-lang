// #3343 (Codex on #3359): the body's tail builds the handle two structs deep
// (`Outer::{ inner: Inner::{ h } }`). The result check read the outer
// literal's field types, and `Inner` does not show the handle, so this
// compiled and the handle was joined after its group closed; the call is
// refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Inner {
  h: TaskHandle[Int]
}

struct Outer {
  inner: Inner
}

fn main() -> Unit allows Exception + Console {
  let o = TaskGroup::run((n) -> {
    Outer::{ inner: Inner::{ h: TaskGroup::spawn(n, () -> { 41 }) } }
  })
  println("after=\{TaskHandle::join(o.inner.h)}")
}
