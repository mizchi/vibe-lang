// #3387: the same join over a generic function declared in this module.
effect Box[T] {
  Put(T) -> Int
}
struct Wrap[T] { v: T }
fn run_wrap[T](x: T, f: () -> Int with Box[Wrap[T]], len: (T) -> Int) -> Int {
  handle {
    f()
  } with { Box::Put(w) => {
    let q: Wrap[T] = w; resume(len(q.v) + len(x) * 0)
  } }
}
fn caller(c: Bool) -> Int with Box {
  let f = if c { run_wrap } else { run_wrap }
  f("abc", () -> {
    perform Box::Put(Wrap::{ v: 12345 })
  }, String::length)
}
