// #3540: a kinded arm over a row variable reached through a function in a
// tuple parameter, run after destructuring. Before the fix this answered
// `274877906948`: the String thrown through `e` read as an Int.
fn guarded(p: (() -> Int with e, Int)) -> Int with e {
  handle {
    let (f, n) = p
    f() + n
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn thrower() -> Int with Exception[String] {
  throw("boom")
}

fn main() -> Int {
  handle {
    guarded((thrower, 1))
  } with { Exception[String]::Throw(m) => String::length(m) }
}
