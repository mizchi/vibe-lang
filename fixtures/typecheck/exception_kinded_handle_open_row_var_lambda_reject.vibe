// #3540: a kinded handle over an open row variable inside a local lambda.
// The edit belongs in the lambda that holds the handle, so the message names
// `guarded`, not the function `run` around it (it used to say "out of
// 'run'").
fn run(f: () -> Int with e) -> Int with e {
  let guarded = (g: () -> Int with e) -> Int with e {
    handle {
      g() + 1
    } with { Exception[Int]::Throw(code) => code * 2 }
  }
  guarded(f)
}

fn main() -> Int {
  run(() -> 1)
}
