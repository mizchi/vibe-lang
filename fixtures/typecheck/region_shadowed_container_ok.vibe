// #4091 (Codex on #4106): a nested `let xs = sink` is another binder; the
// outer `xs` stays a fresh array of the region body, so a region value may be
// pushed into it. `main` answers 10 * the block's value + `sink`'s length.

let sink: Array[MutList[Int]] = []

fn main() -> Int allows Exception {
  let flag = Array::length(sink) == 0
  let v = region r {
    let c = MutList::empty(r)
    let xs: Array[MutList[Int]] = []
    if flag {
      let xs = sink
      let _ = Array::length(xs)
      ()
    } else {
      ()
    }
    Array::push(xs, value = c)
    Array::length(xs)
  }
  v * 10 + Array::length(sink)
}
