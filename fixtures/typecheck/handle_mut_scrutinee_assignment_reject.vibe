effect Ask {
  Get() -> Int
}

fn run() -> Int with Ask {
  let mut side = () -> Int {
    perform Ask::Get()
  }
  handle {
    match {
      side = () -> Int {
        7
      }; true
    } {
      true => side(),
      false => 0
    }
  } with { Ask::Get() => resume(42) }
}

export fn main() -> Int {
  handle {
    run()
  } with { Ask::Get() => resume(1) }
}
