// ADR-0088: `allows Fs?` is the optional grade for every operation of the
// provider, so it satisfies a callee's `with Fs::read_file?` the way
// `allows Fs::read_file?` does (Codex review on PR #2653). The non-interactive
// compiler freezes the unresolved optional grant to `NotGranted`, so `main`
// prints 0 without touching the filesystem.
fn cached() -> Attempt[String, String] with Fs::read_file? {
  perform? Fs::read_file("cache.json")
}

fn main() -> Int allows Fs? {
  match cached() {
    NotGranted => 0,
    Errored(_) => 1,
    Granted(_) => 2
  }
}
