// #3488 (Codex on #3492): a helper that calls a local closure hands back what
// the closure's arguments hold, so a result built by it holds the parameter.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn wrap(c: Cell) -> Wrap {
  let f = (x: Cell) -> { Wrap::{ cell: x } }
  f(c)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(wrap(outer), TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
