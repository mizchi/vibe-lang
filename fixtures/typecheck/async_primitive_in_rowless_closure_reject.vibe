// #3520: `sleep` inside a closure with no row of its own. The closure runs as
// a plain one, so the refusal names the edits for the closure -- move the
// call out, or give it a row -- instead of the bare "effectful call outside
// effectful context: sleep" it used to print with no position.
fn main() -> Int allows Async {
  let f = () -> {
    sleep(1)
    1
  }
  f()
}
