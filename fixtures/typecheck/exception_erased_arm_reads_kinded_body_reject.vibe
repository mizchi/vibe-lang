// #3541: the erased `Exception::Throw(m)` arm reads `m` as the thrown
// message, a `String`, and the kind is not carried at run time. `f` throws an
// `Int`, so `String::length(m)` read the Int 7 as a String and printed
// `len=14`. A body that raises a kind other than `String` under an arm that
// reads its binder is refused, and the edit is the kinded arm.
fn f() -> Int with Exception[Int] {
  throw(7)
}

fn main allows Console {
  let r = handle { f() } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
