// ADR-0094 (#3143, Codex on #4020): an effectset member is a row label, so
// its resource argument is checked where the effectset is declared, even
// when no row names the effectset.
effect Kv[R: Store::Bucket] {
  Get(String) -> String
}

resource Logs: Store::Queue

effectset Reads = { Kv[Logs] }

fn lookup(_ key: String) -> String {
  handle {
    perform Kv::Get(key)
  } with {
    Kv::Get(k) => resume(k)
  }
}
