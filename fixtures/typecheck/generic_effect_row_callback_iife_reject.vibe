// #3341 (Codex on #3340): a generic lambda applied where it is written is
// opened before its arguments, and a callback argument's row is read against
// that instantiation. `x: T` makes `T` a `String` here, so the callback's
// `perform Box::Put(1)` is refused at the perform; before, the callback was
// checked with no row and its perform chose `Int`.
effect Box[T] {
  Put(T) -> Int
}

fn via_iife() -> Int with Box[String] {
  ([T](x: T, f: () -> Int with Box[T]) -> Int with Box[T] {
    f()
  })("s", () -> { perform Box::Put(1) })
}
