// #3589: a generalized lambda storing its callback publishes the callback's
// row as the literal's argument, so `wrap(noisy).run` is charged `Console`.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

let wrap = (f: () -> Int with e) -> Holder::{ run: f }

fn quiet() -> Int {
  (wrap(noisy).run)()
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
