//# #3353: every element of an array literal is checked against the first.
//
// The check used to run only when the first element was a scalar, an array of
// scalars or an unresolved variable. With a struct first, the literal typed as
// `Array[P]` whatever came after it: this compiled clean, and `.v` on the
// second element read the `Array[Int]`'s packed representation as a `P`
// (21474836794, then a trap).

struct P {
  v: Int
}

fn main() -> Unit allows Console {
  let xs: Array[P] = [P::{ v: 1 }, [5]]
  println(__to_string(Array::get(xs, 1).v))
}
