// #3341 with a function-typed instantiation: a lambda bound to a name and then
// passed is compared with the parameter's row, `Box[Mapper]` read as
// `(Int) -> Int`. Before, that row was not read at all, so this checked clean.
effect Box[T] {
  Put(T) -> Int
}

type Mapper = (Int) -> Int

fn run_map(f: () -> Int with Box[Mapper]) -> Int {
  handle {
    f()
  } with {
    Box::Put(m) => resume(m(41))
  }
}

fn producer() -> Int with Box[Mapper] {
  let g = () -> {
    perform Box::Put((s: String) -> Int { String::length(s) })
  }
  run_map(g)
}
