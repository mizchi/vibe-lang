//# #4037: the accepted control. A function stored in a field, called through
//# a receiver resolved only by the enclosing call, still compiles and runs,
//# chained through a second lambda as well.
struct Holder {
  f: (Int) -> Int
}

fn apply(h: Holder, g: (Holder) -> Int) -> Int {
  g(h)
}

fn main() -> Int {
  let h = Holder::{ f: (x) -> x + 1 }
  let hs = [h, Holder::{ f: (x) -> x * 2 }]
  apply(h = h, g = (v) -> v.f(41)) + Array::fold(hs, init = 0, f = (acc, w) -> acc + w.f(w.f(1)))
}
