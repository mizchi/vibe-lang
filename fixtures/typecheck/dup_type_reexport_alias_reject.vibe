// #3036: two aliased re-exports of different declarations both named `Err`.
// Each publishes its `Err` under the bare name beside the alias, so an
// importer of `Left` and `Right` would get one `Err` for both.
export ./dup_type_a_dep_ok.vibe { Err as Left }
export ./dup_type_b_dep_ok.vibe { Err as Right }
