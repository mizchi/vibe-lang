// #3551: a field spelled through an applied alias another module exports is
// judged expanded. `Many[Int]` is `Array[Int]`, which `derive (Ord)` has no
// order for, so it is refused like the array itself.
import ../modules/derive_ord_alias_owner.vibe {
  Many
}

struct Bag {
  xs: Many[Int]
} derive (Ord)
