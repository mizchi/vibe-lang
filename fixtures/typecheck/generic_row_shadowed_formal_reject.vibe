// #3101: an inner binder that reuses an outer formal's spelling binds a
// DIFFERENT type. `get(x)` requires `State[<outer S>]`; the lambda's own
// `with State[S]` names its `S`, so it does not cover the call.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[S](x: S) -> Int {
  let g = [S](y: S) -> Int with State[S] {
    get(x)
  }
  0
}
