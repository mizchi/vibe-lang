// #3057: the same alias bound INSIDE a body. Its row is read from `f`, whose
// marker indexes `f`'s quantifier list, while the call's bindings come from
// the alias's own, re-ordered scheme; the call used to read `A` as `String`.
import ./generic_row_formal_reorder_dep_ok.vibe { Slot, f }

fn caller() -> Int with Slot[String] {
  let h = f
  h("x", 1)
}
