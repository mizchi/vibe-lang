// #3551 review: the same hole through a two-parameter trait and a head whose
// formals share both of the trait's spellings (`T`, `U`).
struct Pair[T, U] {
  a: T;
  b: U
}

trait Two[T, U] {
  g(Self, Pair[Int, Int]) -> String
}

struct P {
  n: Int
}

impl Two for P {
  g(self, x: Pair) -> String {
    x.b
  }
}

fn main() -> Unit allows Console {
  let s = P::g(P::{ n: 1 }, Pair::{ a: 1, b: 42 })
  println("len=\{Int::to_string(String::length(s))}")
}
