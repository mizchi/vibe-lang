// #4050 (Codex on #4061): pairing reaches through a constructor call: the binder of its outer component is an alias of that binding.
fn main() -> Unit allows Exception + Console {
  let outer: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let inner: Array[MutList[Int]] = []
    match Some((inner, outer)) {
      Some((_, a)) => Array::push(a, value = cell),
      None => ()
    }
    1
  }
  println("v=\{v} kept=\{Array::length(outer) > 0}")
}
