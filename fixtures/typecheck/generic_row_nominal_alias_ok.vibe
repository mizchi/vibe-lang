// #3095 control: an alias is not compared by spelling. `B[S]` is `Box[S]`,
// and `P` is `Pt`, so both rows cover their calls.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

struct Box[T] {
  v: T
}

struct Pt {
  x: Int
}

type B[T] = Box[T]

type P = Pt

fn caller[S](x: S) -> Int with State[B[S]] {
  get(Box::{ v: x })
}

fn caller2() -> Int with State[P] {
  get(Pt::{ x: 1 })
}
