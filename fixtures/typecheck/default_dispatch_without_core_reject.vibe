// #3187: `[T: Default]` at `Int` is satisfied without an import (the prelude
// declares `impl Default for Int`), but the prelude's `Default` is a marker:
// the method-bearing `trait Default { default() -> Self }` is in @vibe/core.
// So `T::default()` has nothing to dispatch to here, and the diagnostic names
// the import that supplies it rather than reporting `unknown name`.
// fixtures/derive_default_bound_test.vibe is the same call with the import.
fn fresh[T: Default](witness: T) -> T {
  T::default()
}

fn main() -> Int {
  fresh(3)
}
