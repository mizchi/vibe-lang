fn stash(dst: Array[() -> Array[Int]], value?: () -> Array[Int]) -> Unit {
  match value {
    Some(f) => Array::push(dst, f),
    None => ()
  }
}

fn main() -> Int {
  let outside: Array[() -> Array[Int]] = []
  let _ = region r {
    let values = MutList::empty(r)
    stash(value = () -> Array[Int] {
      MutList::to_array(values)
    }, dst = outside)
    0
  }
  42
}
