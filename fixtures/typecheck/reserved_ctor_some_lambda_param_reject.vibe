// #3086: `Some` is the built-in Option constructor, and every `Some` in an
// expression resolves to it in the checker. A lambda parameter named `Some` is refused
// at its own token, with the rename named, instead of being silently ignored.
struct B {
  v: Bool
}

fn run(f: ((Bool) -> B) -> Unit) -> Unit {
  f((x: Bool) -> B::{ v: x })
}

fn main() -> Unit {
  run(Some -> {
    let _ = Some(false)
  })
}
