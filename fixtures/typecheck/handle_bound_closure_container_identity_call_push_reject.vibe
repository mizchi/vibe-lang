// #4064, Codex review on #4081: a call that is not a container builtin may
// answer its argument (`same(xs = arr)`), so its result shares that
// argument's storage and a handle-bound closure pushed into it is in `arr`.
// A container builtin's result (`Array::slice`) is fresh
// (fixtures/handle_bound_closure_container_test.vibe).
effect Ask {
  Get() -> Int
}

let saved: Array[() -> Int] = []

fn keep(f: () -> Int) -> Int {
  Array::push(saved, value = f)
  0
}

fn keep_arr(xs: Array[() -> Int]) -> Int {
  Array::push(saved, value = Array::get(xs, at = 0))
  0
}

fn same(xs: Array[() -> Int]) -> Array[() -> Int] {
  xs
}

fn main() -> Unit allows Console {
  let plain = () -> 7
  handle {
    let g = () -> perform Ask::Get() + 1
    let arr: Array[() -> Int] = []
    let a2 = same(xs = arr)
    Array::push(a2, value = g)
    let _ = keep_arr(xs = arr)
    ()
  } with { Ask::Get() => resume(5) }
  let k = Array::get(saved, at = 0)
  println("g=\{k()} \{plain()}")
}
