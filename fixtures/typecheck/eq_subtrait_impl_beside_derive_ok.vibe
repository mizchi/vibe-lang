// #3562 controls. A subtrait impl that writes no `equals` beside `derive (Eq)`
// is the ordinary case. A plain impl's `equals` (`impl Key for Pt`) is the one
// `Pt::equals` the program defines, which the derive gives way to and every
// witness of `Pt` dispatches to, so it is not a second definition.
trait Key: Eq {
  tag(Self) -> Int
}

struct Box[T] {
  v: T
} derive (Eq)

impl [T] Key for Box[T] {
  tag(self) -> Int {
    7
  }
}

struct Pt {
  x: Int
} derive (Eq)

impl Key for Pt {
  tag(self) -> Int {
    1
  }
  equals(self, o: Pt) -> Bool {
    self.x == o.x
  }
}

fn helper[U: Eq](a: U, b: U) -> Bool {
  U::equals(a, b)
}

fn outer[T: Key](a: T, b: T) -> Bool {
  helper(a, b) && T::equals(a, b)
}

fn answers() -> Bool {
  let p: Box[Int] = Box::{ v: 1 }
  outer(p, p) && outer(Pt::{ x: 1 }, Pt::{ x: 1 })
}
