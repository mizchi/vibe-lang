// #3301: an or-pattern handler arm is compiled once per operation, and an
// or-pattern arm nested in its body once per copy of that body, so a chain of
// n two-operation arms copies its innermost `handle` 2^(n-1) times. Before
// the copy limit, sixteen levels did not finish `vibe check` in five minutes.
// Ten levels copy the last `handle` 512 times, over the limit of 256, and
// the message names the edit: move that `handle` into a function.

effect E0 {
  A0 -> Int
  B0 -> Int
}

effect E1 {
  A1 -> Int
  B1 -> Int
}

effect E2 {
  A2 -> Int
  B2 -> Int
}

effect E3 {
  A3 -> Int
  B3 -> Int
}

effect E4 {
  A4 -> Int
  B4 -> Int
}

effect E5 {
  A5 -> Int
  B5 -> Int
}

effect E6 {
  A6 -> Int
  B6 -> Int
}

effect E7 {
  A7 -> Int
  B7 -> Int
}

effect E8 {
  A8 -> Int
  B8 -> Int
}

effect E9 {
  A9 -> Int
  B9 -> Int
}

fn main() -> Int {
  handle {
    perform E0::A0 + perform E0::B0
  } with E0 {
    A0|B0 => {
      let f = () -> handle {
        perform E1::A1 + perform E1::B1
      } with E1 {
        A1|B1 => {
          let f = () -> handle {
            perform E2::A2 + perform E2::B2
          } with E2 {
            A2|B2 => {
              let f = () -> handle {
                perform E3::A3 + perform E3::B3
              } with E3 {
                A3|B3 => {
                  let f = () -> handle {
                    perform E4::A4 + perform E4::B4
                  } with E4 {
                    A4|B4 => {
                      let f = () -> handle {
                        perform E5::A5 + perform E5::B5
                      } with E5 {
                        A5|B5 => {
                          let f = () -> handle {
                            perform E6::A6 + perform E6::B6
                          } with E6 {
                            A6|B6 => {
                              let f = () -> handle {
                                perform E7::A7 + perform E7::B7
                              } with E7 {
                                A7|B7 => {
                                  let f = () -> handle {
                                    perform E8::A8 + perform E8::B8
                                  } with E8 {
                                    A8|B8 => {
                                      let f = () -> handle {
                                        perform E9::A9 + perform E9::B9
                                      } with E9 {
                                        A9|B9 => {
                                          let f = () -> 1
                                          resume(f() + 1)
                                        }
                                      }
                                      resume(f() + 1)
                                    }
                                  }
                                  resume(f() + 1)
                                }
                              }
                              resume(f() + 1)
                            }
                          }
                          resume(f() + 1)
                        }
                      }
                      resume(f() + 1)
                    }
                  }
                  resume(f() + 1)
                }
              }
              resume(f() + 1)
            }
          }
          resume(f() + 1)
        }
      }
      resume(f() + 1)
    }
  }
}
