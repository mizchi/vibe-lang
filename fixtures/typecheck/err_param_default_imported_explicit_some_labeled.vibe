// #3440: the bits name the right parameter of an imported header: `times`
// has a default, `sep` is a plain optional. Exported by list, aliased.
import ./param_default_export_dep_ok.vibe {
  label as tag
}

fn main() -> Unit {
  let _ = tag("a", sep = None)
  let _ = tag("a", times = Some(2))
  ()
}
