// #3641: a `for` over a type whose `next` returns a `Future` takes the await
// loop whether `next` is a trait method or a bare `fn T::next`. The effect
// check used to charge `Async` only for the trait form (#1358), so this
// row-less `sum_down` compiled and suspended at every step. The bare method
// is charged now, exactly as the trait form is.
struct Countdown {
  n: Int
}

fn Countdown::next(c: Countdown) -> Future[Option[(Int, Countdown)]] {
  if c.n <= 0 {
    Future::ready(None)
  } else {
    Future::ready(Some((c.n, Countdown::{ n: c.n - 1 })))
  }
}

fn sum_down(n: Int) -> Int {
  let mut acc = 0
  for x in Countdown::{ n: n } {
    acc = acc + x
  }
  acc
}

fn main allows Console + Async {
  println("sum = \{sum_down(4)}")
}
