// #3538: the impl's `k: String` disagreed with the trait's `Int`, and
// `Name::name(p, 12345)` printed `24690` (`String::length` of an Int).
trait Name { name(Self, Int) -> Int }

struct P { x: Int }

impl Name for P {
  name(self, k: String) -> Int { String::length(k) }
}

fn main allows Console {
  println("\{Name::name(P::{ x: 1 }, 12345)}")
}
