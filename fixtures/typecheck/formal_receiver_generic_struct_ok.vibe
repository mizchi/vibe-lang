//# #2848 CONTROL. A field read in a GENERIC BODY is fine when the receiver's
//# type is a struct that merely mentions the formal: `b: Box[T]` arrives as
//# `CtNamed("Box", [T])`, `find_typedef` claims it, and the field resolves
//# through the struct's own field list with `T` substituted (#829). The
//# refusal is keyed on the receiver's type BEING the formal, not on a formal
//# being in scope, and this is what goes red if it were written the wider way.
//# The answer is pinned, not just the compile: `+ 100` makes a first-field
//# offset landed on by luck unable to produce it.
struct Box[T] {
  v: T
}

fn get[T](b: Box[T]) -> T {
  b.v
}

export fn main() -> Int {
  get(Box::{ v: 5 }) + 100
}
