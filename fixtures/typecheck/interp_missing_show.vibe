// #1445 (owner decision: option 1 = error): interpolating a value whose type is
// a DECLARED aggregate with no Show renderer used to print the ADR-0058 pointer
// decimal silently (`288`). The type is known here, so this is a missing
// `derive(Show)`, not an unknowable shape.
enum F {
  C(Int);
  D
}

fn show_it() -> String {
  let f = F::C(7)
  "\{f}"
}
