// #3551 review: a declared value built from an erased arm's binder holds
// whatever `Exception::Throw(m)` caught -- here `f`'s `Int` -- even though
// `Why`'s type shows no `String`. So `throw(Why::Because(m))` is a rethrow of
// no known kind, which the declared `Exception[Why]` does not cover. This
// compiled, and `main`'s `Exception[Why]::Throw(w)` arm read the `Int` 7 as
// the `String` in `w` (it printed `len=14`). The edit is the kinded arm
// (`Exception[Int]::Throw(m)`) or the erased `with Exception` row.
fn f() -> Int with Exception[Int] {
  throw(7)
}

enum Why {
  Because(String)
}

fn g() -> Int with Exception[Why] {
  handle {
    f()
  } with { Exception::Throw(m) => throw(Why::Because(m)) }
}

fn main allows Console {
  let r = handle {
    g()
  } with { Exception[Why]::Throw(w) => match w {
    Why::Because(s) => String::length(s)
  } }
  println("len=\{r}")
}
