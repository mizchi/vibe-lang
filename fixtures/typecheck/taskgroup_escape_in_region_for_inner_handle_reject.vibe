// #4050: a task handle may not be kept in an r1-local container through a
// loop variable inside a `TaskGroup::run` body nested in r1.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Int allows Exception {
  let v = region r1 {
    let inner: Array[TaskHandle[Int]] = []
    let boxes = [inner]
    let w = TaskGroup::run((n) -> {
      let h = TaskGroup::spawn(n, f = () -> { 41 })
      for a in boxes {
        Array::push(a, value = h)
      }
      1
    })
    w * 10 + Array::length(inner)
  }
  v
}
