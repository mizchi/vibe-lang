// #3343: ADR-0090's `region r { .. }` had the helper hole too. `put` pushes
// its argument onto the array it is passed, and the array is declared before
// the region; the closure it pushes reads region-bound storage. This compiled
// and the closure outlived its region.
fn put[T](xs: Array[T], v: T) -> Unit {
  Array::push(xs, v)
}

fn main() -> Unit allows Exception + Console {
  let outer: Array[() -> Array[Int]] = []
  let _ = region r {
    let values = MutList::empty(r)
    MutList::push(values, 7)
    put(outer, () -> Array[Int] {
      MutList::to_array(values)
    })
    0
  }
  println("n=\{Array::length(outer)}")
}
