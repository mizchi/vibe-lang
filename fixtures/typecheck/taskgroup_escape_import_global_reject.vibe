// #3360: an imported helper keeps the group's task handle in its own
// module-level array, which no argument of the call reaches.
import @vibe/concurrent { TaskGroup }
import ./taskgroup_escape_import_dep_ok.vibe { put_global }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    put_global(h)
    1
  })
  println("r=\{r}")
}
