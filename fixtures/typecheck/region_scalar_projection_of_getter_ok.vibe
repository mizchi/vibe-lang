struct State {
  tag: Int;
  items: Array[MutList[Int]]
}

let state = State::{ tag: 2, items: [] }

fn get_state() -> State {
  state
}

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn main() -> Int allows Exception {
  region r {
    let c = MutList::empty(r)
    let boxes: Array[Box] = []
    Array::push(boxes, value = Box::{ tag: get_state().tag, items: [] })
    let b = Array::get(boxes, at = 0)
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
}
