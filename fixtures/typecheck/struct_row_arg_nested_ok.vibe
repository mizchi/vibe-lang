// #3589 (Codex review on #3594): the accepted side of
// struct_row_arg_nested_reject -- a caller declaring both labels.
struct Inner[r] {
  run: () -> Int with r
}

struct Pair[r] {
  a: Inner[r]
  b: Inner[r]
}

fn say() -> Int with Console {
  println("hi")
  1
}

fn home() -> Int with Env {
  if Env::get("HOME") == "" {
    2
  } else {
    3
  }
}

fn run_b[r](p: Pair[r]) -> Int with r {
  (p.b.run)()
}

fn quiet() -> Int with Console + Env {
  let p = Pair::{ a: Inner::{ run: say }, b: Inner::{ run: home } }
  run_b(p)
}

fn main() -> Unit allows Console + Env {
  println("\{quiet()}")
}
