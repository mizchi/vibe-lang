// #3551 review: a program struct spelled like the shipped `TaskGroup[rg, e]`
// was read as the compiler's own declaration, so a bare `TaskGroup` left `rg`
// and `e` unbound. `as_str` checked clean and printed the `Int` field `7` as a
// `String`. The declaration is refused instead.
struct TaskGroup[rg, e] {
  first: rg;
  second: e
}

fn as_str(g: TaskGroup) -> String {
  g.first
}

fn main() -> Unit allows Console {
  println(as_str(TaskGroup::{ first: 7, second: "x" }))
}
