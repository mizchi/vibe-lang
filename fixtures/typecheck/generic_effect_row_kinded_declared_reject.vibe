// #3275 follow-up after #3304: a declared generic type passed to a kinded
// effect parameter is its constructor, so under `with Read[Cell]` the payload
// of `Read::Put(F[Int])` is a `Cell[Int]`, and a `Cell[String]` is refused.
// With `Cell` resolved as a complete type, `F[Int]` was an application that
// the checker tolerated against any `Cell[..]`, so this was accepted.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

struct Cell[T] {
  value: T
}

fn producer() -> Int with Read[Cell] {
  perform Read::Put(Cell::{ value: "s" })
}
