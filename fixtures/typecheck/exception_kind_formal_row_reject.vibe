// #3002: a row stores its items as text, so a type formal inside an exception
// kind is never substituted at a call site. The declaration used to be
// accepted and every call refused with a hint naming `Exception[T]` as a
// missing effect of the CALLER; it is refused where it is written.
fn boom[T](x: T) -> Int with Exception[T] {
  throw(x)
}

fn main() -> Int {
  handle { boom("abc") } with { Exception[String]::Throw(e) => String::length(e) }
}
