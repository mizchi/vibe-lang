// #3022 review: the builtin scalar `Show` impls belong to the builtin trait.
// A program's own `trait Show` with a different method is not satisfied at
// `Int` by an impl nobody wrote.
trait Show {
  render(Self) -> String
}

fn show_it[T: Show](x: T) -> String {
  T::render(x)
}

fn main() -> Unit allows Console {
  println(show_it(1))
}
