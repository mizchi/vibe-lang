// #3588: the complete spelling had the same hole. The region and row are
// rigid formals of `conv`, which kept the pair on the tolerated path, but no
// choice of them turns an `Int` payload into a `String` one.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError }

fn conv[rg, e](h: TaskHandle[rg, e, Int]) -> TaskHandle[rg, e, String] {
  h
}

fn main() -> Unit allows Console + Exception[TaskError] {
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> 7)
    TaskHandle::join(conv(h))
  })
  println("len=\{String::length(r)}")
}
