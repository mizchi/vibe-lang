// #4050 (Codex on #4061): a tuple pattern pairs with the tuple it matches, so a binder of the region-local component may be written although another component is outer.
// `main` answers 10 * the block's value + the outer array's length.
fn main() -> Int allows Exception {
  let outer: Array[MutList[Int]] = []
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let inner: Array[MutList[Int]] = []
    match (outer, inner) {
      (_, a) => Array::push(a, value = cell)
    }
    1
  }
  v * 10 + Array::length(outer)
}
