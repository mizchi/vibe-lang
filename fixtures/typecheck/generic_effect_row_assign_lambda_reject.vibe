// #3417: a lambda assigned to the binding performs at the binding's row.
effect Box[T] {
  Put(T) -> Int
}

fn g() -> Int with Box[Int] {
  perform Box::Put(12345)
}

fn h() -> Int with Box[String] {
  perform Box::Put("a")
}

fn run() -> Int with Box[String] {
  let mut f = h
  f = () -> { perform Box::Put(12345) }
  f()
}
