// #3576: a lambda's own `e` beside a concrete label. The concrete `Log` is
// charged as written and `e`, instantiated to `Tick` here, from the call's
// type; a caller declaring only `Log` is refused.
effect Log {
  Emit(String) -> Unit
}

effect Tick {
  Step(Int) -> Int
}

fn both() -> Int with Log + Tick {
  perform Log::Emit("both")
  perform Tick::Step(1)
}

fn only_log() -> Int with Log {
  let call = [e](f: () -> Int with Log + e) -> Int with Log + e {
    f()
  }
  call(both)
}
