// #3022 review: an instantiated generic nominal argument is compared too. The
// callee requires `State[Box[Int]]`; the handler resumes a `Box[String]`.
struct Box[T] { value: T }

effect State[S] {
  Get() -> S
}

fn get_box() -> Int with State[Box[Int]] {
  let b = perform State::Get()
  b.value
}

fn main() -> Unit allows Console {
  let n = handle {
    get_box()
  } with { State::Get() => resume(Box::{ value: "abc" }) }
  println("\{n}")
}
