// #3568 (Codex review on #3587): a callback stored inside a declared generic
// type in a field (`run: Wrap[() -> Int with r]`) binds the struct's row
// formal like a bare function field does, so `(h.run.value)()` charges `e`.
// Measured on the PR head: already refused, so this pins it.
struct Wrap[T] {
  value: T
}

struct Holder[r] {
  run: Wrap[() -> Int with r]
}

fn wrap(f: () -> Int with e) -> Int {
  let h = Holder::{ run: Wrap::{ value: f } }
  (h.run.value)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
