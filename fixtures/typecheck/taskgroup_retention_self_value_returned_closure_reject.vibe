// #4054: the returned closure captures only the recursive binder, which
// captures the task handle. The binder's region must reach that closure.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}
fn main() -> Int allows Exception {
  let result = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, f = () -> 42)
    let rec mk = (n: Int) -> () -> Int with Exception {
      let x = TaskHandle::join(h)
      () -> {
        let again = mk
        x + n
      }
    }
    mk(1)
  })
  result()
}
