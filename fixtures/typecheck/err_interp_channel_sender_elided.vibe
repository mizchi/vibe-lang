// Codex review on #3587: a `Sender` written without its region and row
// (`Sender[Int]`, a supported spelling) carries its payload as its first
// argument, so the region test that classifies a concurrent handle missed it
// and `"\{s}"` checked clean and printed an address.
import @vibe/concurrent { Sender }

fn show(s: Sender[Int]) -> String {
  "s=\{s}"
}
