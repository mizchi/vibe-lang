// #4091 (Codex on #4106): a local that shadows the scalar parameter `n` with
// the container `xs` is what the result holds; the parameter's `Int`
// annotation does not type it, so the result holds `xs`, here `sink`.

let sink: Array[MutList[Int]] = []

struct Box {
  items: Array[MutList[Int]]
}

fn wrap(n: Int, xs: Array[MutList[Int]]) -> Box {
  let n = xs
  Box::{ items: n }
}

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let b = wrap(n = 0, xs = sink)
    Array::push(b.items, value = c)
    1
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
