// #2969: a local `let resume = ..` inside the arm shadows the continuation,
// so the tail `resume("abcd")` calls the local function and resumes nothing.
// It is a bare tail value and is refused.
effect Ask {
  Get() -> String
}

fn body() -> Int with Ask {
  String::length(perform Ask::Get())
}

fn main() -> Int {
  handle { body() } with { Ask::Get() => {
    let resume = (s: String) -> String { String::concat(s, "!") }
    resume("abcd")
  } }
}
