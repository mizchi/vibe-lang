// #3518: the lost binding was a type hole of its own. `give` returns the
// closure's `String`, but `s` was typed as an open variable, so binding it at
// `Int` checked clean and the program printed 137438953475 (the string's
// packed pointer read as an Int).
fn give[T, e](f: () -> T with Exception + e) -> T with Exception + e {
  f()
}

fn main() -> Int allows Exception {
  let s = give(() -> "hello")
  let n: Int = s
  n + 1
}
