// #3036 (Codex on #3076): declares its own `Err { code: Int }` and exports
// only an effect set over it -- `Err` is named solely inside the member
// `Exception[Err]`, and this module holds no imported markers.
struct Err {
  code: Int
}

export effectset Fail = { Exception[Err] }

fn keep() -> Int with Fail {
  throw(Err::{ code: 1 })
}
