struct Holder {
  f: (UInt32) -> Int
  get: () -> UInt32
}

fn main() -> Int {
  let hs = [Holder::{ f: (x) -> UInt32::to_int(x), get: () -> Int::wrap_uint32(4294967295) }]
  let args = Array::map(hs, f = (h) -> h.f(42))
  let wraps = Array::map(hs, f = (h) -> (h.get() + 1) == ~h.get())
  if Array::get(wraps, at = 0) {
    Array::get(args, at = 0)
  } else {
    1
  }
}
