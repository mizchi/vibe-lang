struct Width {
  n: UInt32
}

struct Holder {
  f: (UInt32) -> Int
  get: () -> UInt32
  width: () -> Width
}

fn main() -> Int {
  let hs = [Holder::{ f: (x) -> UInt32::to_int(x), get: () -> Int::wrap_uint32(4294967295), width: () -> Width::{ n: 4294967295 } }]
  let args = Array::map(hs, f = (h) -> h.f(42))
  let wraps = Array::map(hs, f = (h) -> (h.get() + 1) == ~h.get())
  let ordered = Array::map(hs, f = (h) -> h.get() > ~h.get() && h.get() > (if true { 0 } else { 1 }))
  let nested = Array::map(hs, f = (h) -> Some((h.get(), true)) == Some((4294967295, true)))
  let projected = Array::map(hs, f = (h) -> h.width().n == 4294967295)
  if Array::get(wraps, at = 0) && Array::get(ordered, at = 0) && Array::get(nested, at = 0) && Array::get(projected, at = 0) {
    Array::get(args, at = 0)
  } else {
    1
  }
}
