// #3311 (Codex on #3340): an imported NON-generic callee whose callback row
// names a type the importer imports (`Box[Pt]`) fixes the payload at `Pt`.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_pt, Pt
}

fn producer() -> Int with Box {
  run_pt(() -> {
    perform Box::Put(1)
  })
}
