// #3434: a shadowing `let` the normalize pass cannot type, of the same struct
// with no Show as the binding it shadows, is refused on every lane. A lane
// that passes no typed rows (`vibe check --single-file`'s interpolation pass)
// has no checker answer for the shadow, so it reads the outer binding's
// entries; treating the shadow as a fresh name there skipped the refusal and
// the check answered clean (Codex on #3453).
struct Raw {
  n: Int
}

fn render(x: Raw, c: Bool) -> String {
  let x = if c {
    x
  } else {
    x
  }
  "\{x}"
}
