// #3837: a transparent alias over one that lowering cannot follow is refused
// at that hop, named in the message.
struct Pair[A, B] {
  a: A;
  b: B
}

type Rev[A, B] = Pair[B, A]

type Undo[A, B] = Rev[B, A]

type Same[A, B] = Undo[A, B]

fn main() -> Unit {
  let u = Same::{ a: 1, b: 2 }
  ()
}
