// #3598: the branches of an annotated `if` join at the wider row, and that
// row is still checked against the annotation. A branch throwing a kind the
// annotation does not name is refused even when the pure branch comes first.
fn other() -> Int with Exception[String] {
  throw("x")
}

let c = true

let make: () -> Int with Exception[Int] = if c {
  () -> 1
} else {
  other
}

fn main() -> Unit allows Console {
  let r = handle {
    make()
  } with { Exception[Int]::Throw(n) => n }
  println("\{r}")
}
