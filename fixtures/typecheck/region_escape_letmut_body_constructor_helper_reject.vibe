// #3862: a `let mut` before the tail constructor does not hide the payload
// parameters.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[A, B] {
  let mut n = 0
  n = 1
  Pair(first, second)
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(slot, _) = escaped
  Array::length(slot.callback())
}
