// #3408 (Codex on #3409): the generic `mk` is passed by name to the bare
// forwarder `pass`, which calls it at `Int`. No call here fixes `mk`'s `T`,
// so its `Box[T]` is unknown and refused with the edit (call it through a
// lambda at the type meant). This checked clean on main and printed 24690.
effect Box[T] {
  Put(T) -> Int
}
fn mk[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}
fn pass(f: (Int) -> Int with Box) -> Int with Box {
  f(12345)
}
fn mid() -> Int with Box {
  pass(mk)
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
