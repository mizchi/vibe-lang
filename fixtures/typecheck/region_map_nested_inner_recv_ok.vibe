// Codex on #4057 control: `boxes` is declared inside `region r` and mapped
// inside a nested `region s`. Its elements live as long as `r`, so the
// callback may store `r`'s value `cell` in them.
fn main() -> Unit allows Exception + Console {
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let outer: Array[MutList[Int]] = []
    let boxes = [outer]
    let got = region s {
      let _ = Array::map(boxes, f = (a) -> {
        Array::push(a, value = cell)
        0
      })
      1
    }
    got + Array::length(outer)
  }
  println("v=\{v}")
}
