// #3387 (Codex on #3407): `Array::filter`'s callback parameter names no row
// either, and it is checked on the direct builtin path, not `Array::map`'s.
effect Box[T] {
  Put(T) -> Int
}
fn caller() -> Int with Box[String] {
  let r = Array::filter([12345], (x) -> {
    perform Box::Put(x)
    true
  })
  1
}
