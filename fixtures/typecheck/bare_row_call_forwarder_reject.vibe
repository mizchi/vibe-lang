// #3408 (Codex on #3409): `pass` names `Box` on its callback parameter but
// does not handle it: its own row is the bare `Box`, so the callback's
// performs reach `pass`'s caller. `mid` therefore requires `mk`'s `Box[Int]`
// and a `Box[String]` caller is refused. Skipping the callback because the
// parameter named `Box` left `mid` bare; the
// program was refused only by the evidence pass, not with the row edit.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn pass(f: () -> Int with Box) -> Int with Box {
  f()
}
fn mid() -> Int with Box {
  pass(() -> mk())
}
fn caller() -> Int with Box[String] {
  mid()
}
fn main() -> Int {
  handle {
    caller()
  } with { Box::Put(s) => resume(String::length(s)) }
}
