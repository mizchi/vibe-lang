// ADR-0124 decision 3 (#2656), r11: a callee declared `with Db` that runs a
// callback, called outside every handler, is refused at the call.
effect Db {
  Get(Int) -> Int
}

fn call_it(g: () -> Int with Db) -> Int with Db {
  g()
}

fn main allows Console + Db {
  let a = call_it(g = () -> {
    perform Db::Get(1)
  })
  let v = handle {
    perform Db::Get(2)
  } with {
    Db::Get(n) => resume(n)
  }
  println("\{a} \{v}")
}
