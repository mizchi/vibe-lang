// #3014: an imported row-polymorphic helper instantiates its row variable at
// the call site, like a same-file one. `apply_it(asks)` charges `Ask` to
// `main`, which has no handler for it (it used to compile and trap).
import ./imported_row_poly_dep.vibe { apply_it }

effect Ask {
  Get() -> Int
}

fn asks() -> Int with Ask {
  perform Ask::Get()
}

fn main() -> Unit allows Console {
  let r = apply_it(asks)
  println("r=\{r}")
}
