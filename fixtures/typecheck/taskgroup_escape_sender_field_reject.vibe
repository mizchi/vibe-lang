// #3276: the rule covers every token of the group, not only task handles. A
// channel endpoint stored in a field bound before the group would let a
// caller send into a group that has already closed.
import @vibe/concurrent { TaskGroup, Channel, Sender, Receiver }

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    let (tx, rx) = Channel::bounded(n, 1)
    c.v = Some(tx)
    Sender::send(tx, 1)
    match Receiver::recv(rx) {
      Some(x) => x,
      None => 0
    }
  })
  println("r=\{r}")
}
