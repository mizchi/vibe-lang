// Codex P0 on #2985: the `else` branch is a bare tail value next to a tail
// `resume` -- an Int where the operation returns String, which a whole-arm
// "mentions resume" check once typed as the handle's Int result and accepted.
// Since #2969 a bare tail is refused outright, so the message names the edit.
effect Name {
  Get() -> String
}

fn greet_len() -> Int with Name {
  let s = perform Name::Get()
  String::length(s)
}

fn main() -> Int {
  handle { greet_len() } with { Name::Get() => if true { resume("ok") } else { 7 } }
}
