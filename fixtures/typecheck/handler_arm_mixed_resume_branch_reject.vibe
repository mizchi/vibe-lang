// Codex P0 on #2985: the `else` branch is a bare tail value, so it is what
// the perform receives (the lowering strips the tail `resume`); an Int where
// the operation returns String. A whole-arm "mentions resume" check typed
// both branches as the handle's Int result and accepted this.
effect Name {
  Get() -> String
}

fn greet_len() -> Int with Name {
  let s = perform Name::Get()
  String::length(s)
}

fn main() -> Int {
  handle { greet_len() } with { Name::Get() => if true { resume("ok") } else { 7 } }
}
