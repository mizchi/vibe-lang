// #2335: a concrete impl is exact. The Array[Int] method body must never be
// selected for Array[String], which was the silent-wrong #2262 behavior.
trait Measured {
  measure(Self) -> Int
}

impl Measured for Array[Int] {
  measure(self) -> Int {
    Array::length(self)
  }
}

fn measure[T: Measured](x: T) -> Int {
  T::measure(x)
}

fn main() -> Int {
  measure(["not", "ints"])
}
