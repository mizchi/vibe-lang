// #2145: the book's `perform?` program, verbatim. The checker types this as
// `Attempt[T, String]`; code generation cannot emit it, so `check_program`
// rejects it here instead of letting it reach the codegen unresolved-name path
// ("this is a bug in the compiler ... please report the source").
//
// Kept in the compiler's own corpus, not only in the book gate: the book gate
// reads the block out of a chapter, so a chapter edit moves or drops the pin
// without anything noticing. This row is the compiler asserting its own
// behaviour.
//
// When codegen lowers `perform?`, this fixture COMPILES and the gate fails with
// "expected 'reject', got 'ok'" -- that is the signal to flip the row to `ok`
// and give the program a runtime expectation instead.
fn main() -> Int with () allows Console + Fs::read_file? {
  let a = perform? Fs::read_file("config.json")
  match a {
    NotGranted => 0,
    Errored(_) => 1,
    Granted(_) => 2
  }
}
