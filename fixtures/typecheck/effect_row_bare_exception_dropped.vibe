// #3539: a function value whose row is the bare `Exception` cannot go where a
// row-less function type is expected (`with Exception[K]` and `with Console`
// were already refused). `call(thrower)` typed `pure` with an empty row and
// trapped at run time.
fn call(f: () -> Int) -> Int {
  f()
}

fn thrower() -> Int with Exception {
  throw("dropped")
  1
}

fn pure() -> Int {
  call(thrower)
}
