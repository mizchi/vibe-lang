struct State {
  tag: Int
}

struct Box {
  mut tag: Int;
  items: Array[MutList[Int]]
}

let state: State = State::{ tag: 7 }

fn main() -> Int allows Exception {
  region r {
    let cell = MutList::empty(r)
    let b = Box::{ tag: 0, items: [] }
    let copy = (s: State) -> {
      b.tag = s.tag
    }
    copy(state)
    Array::push(b.items, value = cell)
    Array::length(b.items) + b.tag
  }
}
