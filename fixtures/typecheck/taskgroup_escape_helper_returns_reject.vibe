// #3343 (Codex on #3359): a helper that keeps nothing but RETURNS the handle
// under a type that does not name the group. `passthrough` is declared
// `-> TaskHandle[Int]`, so the call's result type carries no region, and the
// caller's own write of it into an outer cell saw none: this compiled and
// the handle was joined after its group closed. The result now carries the
// region of the handle it was made from, and the write is refused; joining
// the result inside the body stays legal.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn passthrough(h: TaskHandle[Int]) -> TaskHandle[Int] {
  h
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    c.v = Some(passthrough(TaskGroup::spawn(n, () -> { 41 })))
    1
  })
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
