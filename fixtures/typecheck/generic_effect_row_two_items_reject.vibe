// #3275: each generic effect a row names is fixed at its own type argument:
// `St::Get` answers a `String`, which `Box::Put` cannot take under
// `with Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}

effect St[S] {
  Get() -> S
}

fn producer() -> Int with Box[Int] + St[String] {
  let s = perform St::Get()
  perform Box::Put(s)
}
