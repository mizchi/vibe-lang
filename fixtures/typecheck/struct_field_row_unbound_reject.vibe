// #3568: a row variable in a field's row that the struct does not bind ties
// the field to no value's row, so a call through the field was charged
// nothing and a pure `quiet` printed. The declaration is refused with the
// parameter list that binds it.
struct Holder {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

fn wrap(f: () -> Int with e) -> Int {
  let h = Holder::{ run: f }
  (h.run)()
}

fn quiet() -> Int {
  wrap(noisy)
}
