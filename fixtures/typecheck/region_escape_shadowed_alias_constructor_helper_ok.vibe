// #3862 control (Codex on #3868): a `let` that shadows an ALIAS of a
// parameter hides it too. `held` first holds `first`, then `0`, so only an
// Int reaches the result and nothing escapes.
struct Slot {
  callback: () -> Array[Int]
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Int, B] {
  let held = first
  let _ = held
  let held = 0
  Pair(held, second)
}

fn main() -> Int {
  let kept = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(n, _) = kept
  n
}
