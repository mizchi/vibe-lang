// #3551 review: the impl's own target written bare is read as the target
// applied to its erased formals (`Q[A]`), so it is held to the trait's
// `Q[Int]` like the written `Q[A]`. Left bare it was a wildcard: `x.v` read
// the `Int` field as a `String` (measured: `len=84`).
struct Q[A] {
  v: A
}

trait Gen[A] {
  f(Self, Q[Int]) -> String
}

impl Gen for Q {
  f(self, x: Q) -> String {
    x.v
  }
}

fn main() -> Unit allows Console {
  let s = Q::f(Q::{ v: 7 }, Q::{ v: 42 })
  println("len=\{Int::to_string(String::length(s))}")
}
