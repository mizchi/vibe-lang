// #3493: a forward value use is checked at its inferred binding type.
struct LocalHelper { greet: (String) -> Int }
struct Later { eval: () -> String }
let (helper, later) = (LocalHelper::{ greet: (name) -> 5 }, Later::{
  eval: () -> {
    helper.greet("x")
  }
})
fn main() -> Int {
  String::length(later.eval())
}
