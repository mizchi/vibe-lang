// #3371: a tuple payload pattern holding a literal was never tested; for
// `perform Pair::Diff((1, 3))` the later `Pair::Diff(_)` arm ran and `run`
// answered 5.
type P2 = (Int, Int)

effect Pair {
  Diff(P2) -> Int
}

fn run() -> Int {
  handle {
    perform Pair::Diff((1, 3))
  } with {
    Pair::Diff((1, _)) => resume(100);
    Pair::Diff(_) => resume(5)
  }
}
