//# #4037 (Codex on #4046): integer literals passed to a late-resolved
//# method's `Int32` / `UInt32` parameters, labeled, positional and optional,
//# check clean as they do through an annotated receiver. The build fails as
//# `late_receiver_method_debt` does, on the lowering of the dot call itself
//# (#2501); promote this row to `ok` with it.
struct Counter {
  n: Int
}

fn Counter::add(c: Counter, k: Int32) -> Int {
  c.n
}

fn Counter::addu(c: Counter, k: UInt32) -> Int {
  c.n
}

fn Counter::pos(c: Counter, _ k: Int32) -> Int {
  c.n
}

fn Counter::opt(c: Counter, k: Int, m?: Int32) -> Int {
  c.n + k
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }]
  Array::length(Array::map(xs, f = (c) -> c.add(k = 1) + c.addu(k = 7) + c.pos(3) + c.opt(k = 1, m = 2)))
}
