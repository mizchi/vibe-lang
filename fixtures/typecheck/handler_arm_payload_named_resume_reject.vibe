// #2969: a payload binder named `resume` hides the continuation from the
// whole arm, so no tail can resume the perform. The arm is refused and the
// message asks for the binder to be renamed (it used to be an implicit resume
// of the payload).
effect Named {
  Get(resume: String) -> String
}

fn body() -> Int with Named {
  String::length(perform Named::Get("abcd"))
}

fn main() -> Int {
  handle { body() } with { Named::Get(resume) => resume }
}
