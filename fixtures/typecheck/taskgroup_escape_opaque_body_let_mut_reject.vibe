// #3343 (Codex on #3359): a body passed by name that is a `let mut` closure.
// Its code was checked where it was written, outside the group's region, and
// a `let mut` may be reassigned, so nothing about what it keeps is known; the
// call is refused with the edit (write the body inline, or bind it with
// `let`). The scan of outer bindings refused this shape already, but only
// because the closure's open type took the region.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c = Cell::{ v: None }
  let mut body = (n) -> {
    c.v = Some(TaskGroup::spawn(n, () -> { 41 }))
    1
  }
  let r = TaskGroup::run(body)
  let after = match c.v {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
