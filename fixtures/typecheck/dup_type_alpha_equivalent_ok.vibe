// #3036 (Codex on #3076): `Box[T] { value: T }` and `Box[U] { value: U }` are
// one declaration -- a binder's spelling is not part of its identity -- so
// importing both routes is accepted, like dup_type_same_layout_ok.
import ./dup_type_alpha_box_a_dep_ok.vibe { box_of }
import ./dup_type_alpha_box_b_dep_ok.vibe { unbox }

fn read() -> Int {
  unbox(box_of(3))
}
