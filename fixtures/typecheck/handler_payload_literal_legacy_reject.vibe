// #3371: the legacy `with Effect { .. }` header qualifies each arm the same
// way, so its literal payload was ignored too: `P(1)` lost to the later
// `P(_)` for `perform Pick::P(1)` and `main` answered 5, not 100.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

fn main() -> Int {
  handle {
    perform Pick::P(1)
  } with Pick {
    P(1) => resume(100);
    P(_) => resume(5);
    Q(_) => resume(7)
  }
}
