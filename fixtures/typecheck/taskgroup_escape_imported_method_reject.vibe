// #3360 (Codex on #3467): an imported helper that stores its argument
// through a method-style call (`c.stash(x)`) keeps it as a direct call does.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_imported_helper_dep_ok.vibe { Cell, tuck }

fn main() -> Unit allows Exception + Console {
  let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    tuck(c, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
