//# #2475 (Codex on #2819), a CONTROL: the applied door never consults
//# `resolve_builtin`, so `Int[T]` reaches `find_typedef` and can be named even
//# though a bare `Int` cannot (err_type_builtin_spelling_struct pins that
//# refusal). This is why the rule is arity-aware and not a name list.
//#
//# The argument is `Bool` and not `Int` because a declared `struct Int[T]`
//# owns the applied spelling for its own ARGUMENTS too: `Int[Int]` is refused
//# with "`Int` is a constructor with 1 argument(s)". That is a readability
//# cost of the shadowing, not the silent-wrongness #2475 is about, and it does
//# not make the declaration unnameable.
struct Int[T] {
  v: T
}

fn read(i: Int[Bool]) -> Int {
  if i.v {
    9
  } else {
    0
  }
}

fn main() -> Int {
  read(Int::{ v: true })
}
