// #3198 review (Codex): a match binder over an ANNOTATED name carries the
// payload head the annotation names. `c` is a `Countdown`, an async
// iterator, so the row-free function must be refused: the desugar would insert
// the builtin `await` into it.
trait AIter[T] {
  next(Self) -> Future[Option[(T, Self)]]
}

struct Countdown {
  n: Int
}

impl AIter for Countdown {
  next(self) -> Future[Option[(Int, Countdown)]] {
    Future::ready(if self.n > 0 {
      Some((self.n, Countdown::{ n: self.n - 1 }))
    } else {
      None
    })
  }
}

fn total(o: Option[Countdown]) -> Int {
  let mut acc = 0
  match o {
    Some(c) => {
      for x in c {
        acc = acc + x
      }
      ()
    },
    None => ()
  }
  acc
}

fn main() -> Int {
  total(Some(Countdown::{ n: 3 }))
}
