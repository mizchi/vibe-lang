// #3022 review: an immediately invoked lambda runs its body under the
// enclosing handler, so its calls are compared with the handler's
// instantiation. `get_str` needs `State[String]`; the handler resumes `Int`.
effect State[S] {
  Get() -> S
}

fn get_str() -> String with State[String] {
  perform State::Get()
}

fn main() -> Unit allows Stdout {
  let n = handle {
    let s = (() -> String with State[String] { get_str() })()
    String::length(s)
  } with { State::Get() => resume(7) }
  println("\{n}")
}
