// #3540: a closure that performs what a `handle` answers must not outlive
// that handle. The method returns the closure inside a tuple. `g()`
// answered `6` from the dead handler after `vibe check` was clean.
effect Ask {
  Get() -> Int
}

struct Factory {
  k: Int
}

fn Factory::mk(self: Factory) -> (() -> Int, Int) with Ask {
  (() -> perform Ask::Get() + self.k, 0)
}

fn main() -> Unit allows Console {
  let fac = Factory::{ k: 1 }
  let (g, _) = handle {
    fac.mk()
  } with { Ask::Get() => resume(5) }
  println("g=\{g()}")
}
