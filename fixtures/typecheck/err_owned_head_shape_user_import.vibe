// #3551 review: the shape a program struct copies from the shipped
// `Sender[rg, e, T]` reached an importer as the compiler's own declaration, so
// `Sender[Int]` left `rg` unbound and `s.tag` (an `Int`) was accepted as a
// `String`. The dependency's declaration is refused.
import ./err_owned_head_shape_user_dep.vibe {
  struct Sender
}

fn tag_of(s: Sender[Int]) -> String {
  s.tag
}

fn main() -> Unit allows Console {
  println(tag_of(Sender::{ tag: 7, v: 1 }))
}
