// A row-free callback can fill a local lambda’s row-carrying parameter.
effect Box[T] {
  Put(T) -> Unit
}

fn drive(_ f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 1
  let run = (f: () -> Int with Box[String]) -> handle {
    f()
  } with { Box::Put(_) => resume(()) }
  run(g) + drive(tick)
}
