// Codex on #4078: a fold callback rebinds `h` to a holder of an outer array
// and returns `Holder::{ items: h.items }`. The item was judged by its type in
// the callback's definition scope, where `h` is the outer `Nums` and
// `h.items` an `Int`, so the record counted as fresh; the second push then
// stored the region list in `sink`. e55476738 printed `kept=true`.
struct Nums {
  items: Int
}

struct Holder {
  items: Array[MutList[Int]]
}

fn main() -> Unit allows Exception + Console {
  let sink: Array[MutList[Int]] = []
  let h = Nums::{ items: 0 }
  let v = region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    let mine = Holder::{ items: [] }
    let _ = Array::fold([1, 2], init = mine, f = (acc, x) -> {
      Array::push(acc.items, value = cell)
      let h = Holder::{ items: sink }
      Holder::{ items: h.items }
    })
    h.items
  }
  println("v=\{v} kept=\{Array::length(sink) > 0}")
}
