// #3027 (Codex on #3039): the callee's formal hidden behind a parameterized
// alias (`-> Id[S]` for `type Id[T] = T`) still takes the call's type.
type Id[T] = T

effect State[S] {
  Get() -> S
}

fn get[S]() -> Id[S] with State[S] {
  perform State::Get()
}

fn use_int(x: Int) -> Int {
  x + 1
}

fn main() -> Unit allows Stdout {
  let n = handle {
    use_int(get())
  } with { State::Get() => resume("abc") }
  println("\{n}")
}
