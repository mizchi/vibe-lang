// #3027 (Codex on #3047): a local generic lambda names its own formal in its
// row. Called with a String, `State[S]` is `State[String]` at that call, and a
// handler answering `State[Int]` must be refused -- the formal used to stay an
// open spelling, which the check never judges, so the program was accepted.
// The lambda declares the row without performing: a `perform` from a local
// lambda is not evidence-passed yet.
effect State[S] {
  Get() -> S
}

fn main() -> Int {
  let get = [S](x: S) -> Int with State[S] {
    1
  }
  handle {
    get("abc")
  } with { State::Get() => resume(7) }
}
