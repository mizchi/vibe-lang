// ADR-0120 (Codex on #3844): an omitted optional parameter shifts every
// labeled argument after it. Re-checking `put` with each argument's type
// bound to the parameter at its WRITTEN index bound `c`'s type to `unused`
// and the handle's to `c`, so the store into `c` was not judged as a store
// of the handle, and the handle was joined after its group closed.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn put(unused?: Int, c: Array[Option[TaskHandle[Int]]], h: TaskHandle[Int]) -> Unit {
  let _ = unused
  Array::set(c, at = 0, value = Some(h))
}

fn main() -> Unit allows Exception + Console {
  let c: Array[Option[TaskHandle[Int]]] = [None]
  let r = TaskGroup::run((n) -> {
    put(c = c, h = TaskGroup::spawn(n, f = () -> { 41 }))
    1
  })
  let after = match Array::get(c, at = 0) {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
