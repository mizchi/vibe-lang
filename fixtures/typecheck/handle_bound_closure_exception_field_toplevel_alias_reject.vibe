// #3593 (Codex review on #3594): a TOP-LEVEL alias of a builder is followed to
// the declaration it names, so the throwing field closure it returns cannot
// leave the handle through `make_alias()` either.
struct Box {
  f: () -> Int
}

fn mk() -> Box with Exception[Int] {
  Box::{ f: () -> throw(7) }
}

let make_alias = mk

fn main() -> Unit allows Console {
  let b = handle {
    make_alias()
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
