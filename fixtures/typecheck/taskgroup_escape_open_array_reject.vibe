// #3276: the shape that was already refused -- an unannotated outer array
// whose open element type picked up the region. It now gets the same refusal
// as the annotated and generic-struct shapes, located at the write instead of
// at the `TaskGroup::run` callee, and only once.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let cell = [None]
  let r = TaskGroup::run((n) -> {
    Array::set(cell, at = 0, value = Some(TaskGroup::spawn(n, f = () -> { 41 })))
    1
  })
  let after = match Array::get(cell, at = 0) {
    Some(h) => TaskHandle::join(h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
