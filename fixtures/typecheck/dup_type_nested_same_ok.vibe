// #3036 control: `wrap_outer` brings dup_type_nested_a_dep_ok's `Outer` and
// the `Inner` it holds as reference definitions (one hop), and the same two
// declarations are imported directly. One declaration each, so it stays
// legal.
import ./dup_type_nested_mid_dep_ok.vibe { wrap_outer }
import ./dup_type_nested_a_dep_ok.vibe { Inner, Outer }

fn read() -> Int {
  let o: Outer = wrap_outer()
  let i: Inner = o.inner
  i.code
}
