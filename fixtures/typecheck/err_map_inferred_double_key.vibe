// #2334: a key the checker only INFERRED -- here from an unannotated
// `Map::new()` -- is refused like an annotated one. The builtin map has no
// `Double` key implementation, and this call would otherwise fall to the
// String key operations and compare the number as a String pointer.
fn main {
  let m = Map::set(Map::new(), 1.5, 10)
  let _ = Map::get(m, 1.5)
  ()
}
