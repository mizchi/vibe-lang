//# #4037: an argument of the wrong type, once the receiver resolves. Before,
//# the labeled call was refused as a call through a function value.
struct Counter {
  n: Int
}

fn Counter::size(c: Counter) -> Int {
  c.n
}

fn Counter::add(c: Counter, k: Int) -> Int {
  c.n + k
}

fn main() -> Int {
  let xs = [Counter::{ n: 1 }, Counter::{ n: 2 }]
  Array::fold(xs, init = 0, f = (acc, c) -> acc + c.add(k = "x"))
}
