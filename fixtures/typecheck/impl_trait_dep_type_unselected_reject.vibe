// #3551 review: `Tr::make` takes the dependency's `Hidden`, which this module
// does not import. The impl-signature check read the unselected name as a
// wildcard and accepted `make(x: Int)`; `call_it` then handed it a `Hidden`,
// and `x + 1` added 1 to its address (measured on bcc090da5: `k=265`).
import ./impl_trait_dep_type_dep_ok.vibe {
  call_it, trait Tr
}

struct P {
  k: Int
}

impl Tr for P {
  make(x: Int) -> P {
    P::{ k: x + 1 }
  }
  show(self) -> String {
    "k=\{self.k}"
  }
}

fn main allows Console {
  println(call_it(P::{ k: 0 }))
}
