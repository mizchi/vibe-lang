// #3036 control: two distinct `Outer`s whose nested `Inner`s are also
// identical definitions. Identity is the definition, transitively, so these
// are one type (the `dup_type_same_layout_ok` decision, one level down).
import ./dup_type_nested_a_dep_ok.vibe { make_outer }
import ./dup_type_nested_same_layout_dep_ok.vibe { consume_outer }

fn read() -> Int {
  consume_outer(make_outer())
}
