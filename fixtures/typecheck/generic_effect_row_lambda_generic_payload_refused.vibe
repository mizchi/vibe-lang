// #3341 / #3424: a lambda generic in its payload is checked at each use's
// instantiation, and `vibe check` accepts this. The build refuses it: the
// callback passed to `run_int` calls the local `g`, which the compiler cannot
// give `run_int`'s handler, so the callback would take no handler argument
// while `run_int` calls it with one -- measured, it trapped with `indirect call
// type mismatch`. The edit the message names (move it to a top-level generic
// `fn`) is in fixtures/callback_row_slot_edits_test.vibe.
effect Box[T] {
  Put(T) -> Int
}

fn run_int(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with {
    Box::Put(n) => resume(n + 1)
  }
}

fn generic_payload() -> Int with Box[String] {
  let g = (x) -> { perform Box::Put(x) }
  g("a") + run_int(() -> g(1))
}
