// #3539 through a local alias: the accepted counterpart -- the caller declares
// the row the callback brings, and a pure callback brings none.
fn apply(f: () -> Unit with e) -> Unit with e {
  f()
}

fn loud(fs: Array[() -> Unit with Console]) -> Int with Console {
  let g = apply
  g(fs[0])
  42
}

fn quiet(fs: Array[() -> Unit]) -> Int {
  let g = apply
  g(fs[0])
  42
}
