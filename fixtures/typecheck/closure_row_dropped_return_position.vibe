// #1451 guard: the UNSOUND direction must stay rejected. Returning a value whose
// concrete row carries Log::Emit through a PURE-typed return slot would let the
// perform run with no handler. check_assignable reports this via
// effect_row_dropped; only the pure -> effectful direction is tolerated.
effect Log {
  Emit(String) -> Unit
}

fn eff(s: String) -> Unit with Log::Emit {
  perform Log::Emit(s)
}

fn drop_row() -> (String) -> Unit {
  eff
}
