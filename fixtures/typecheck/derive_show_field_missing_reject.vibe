// #3073: `derive (Show)` on `Outer` goes through `Inner::to_string` for its field `inner`, and
// `Inner` neither derives `Show` nor defines `to_string`. `vibe check` reported this
// clean and the build stopped with an internal compiler error (`Inner::to_string`
// reached code generation unresolved); it is refused at `Outer` now, naming the
// edit.
struct Inner {
  x: Int
}

struct Outer {
  inner: Inner
} derive (Show)
