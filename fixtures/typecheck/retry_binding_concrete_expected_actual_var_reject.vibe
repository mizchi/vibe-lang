// #3518 review: the retry binds a variable of the ACTUAL side against a
// concrete expected position -- `?u` of an untyped `[]` against `Int` in
// `() -> Array[Int]`. Only variables of the expected side were carried
// forward, so `xs` stayed open, a later push typed it `Array[String]`, and
// the returned `Array[Int]` aliased it. The binding is kept, and the push is
// refused.
fn as_ints[e](f: () -> Array[Int] with Exception + e) -> Array[Int] with Exception + e {
  f()
}

fn main() -> Int allows Exception {
  let xs = []
  let ints = as_ints(() -> xs)
  Array::push(xs, "hello")
  Array::length(ints)
}
