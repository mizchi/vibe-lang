// #3589: a struct literal storing `noisy` is a `Holder[Console]`, and a call
// to `call_holder[e](h: Holder[e]) -> Int with e` instantiates `e` from it, so
// the pure `quiet` is charged `Console`. Before the fix `e` in `Holder[e]` was
// a type variable no row shared, the call charged nothing, and `quiet`
// printed from a function declared pure.
struct Holder[r] {
  run: () -> Int with r
}

fn noisy() -> Int with Console {
  println("side effect from a pure caller")
  1
}

fn call_holder[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

fn quiet() -> Int {
  call_holder(Holder::{ run: noisy })
}

fn main() -> Unit allows Console {
  println("\{quiet()}")
}
