//# #3573: `Self` in an impl method's BODY is the impl's target too. A local
//# `let other: Self = Q::{ .. }` in `impl W for P` used to be accepted, the
//# annotation a wildcard, and `other.k` read a `Q` as a `P`.
trait W {
  get(Self) -> Int
}

struct P {
  k: Int
}

struct Q {
  a: String
  k: Int
}

impl W for P {
  get(self: Self) -> Int {
    let other: Self = Q::{ a: "zz", k: 7 }
    other.k + self.k
  }
}

export fn main() -> Int {
  W::get(P::{ k: 1 })
}
