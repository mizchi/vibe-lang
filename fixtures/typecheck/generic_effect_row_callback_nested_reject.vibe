// #3311: a callback nested in another callback performs at its own
// parameter's row (`Box[Int]`), not at the outer one's (`Box[String]`).
effect Box[T] {
  Put(T) -> Int
}

fn run_str(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with {
    Box::Put(s) => resume(String::length(s))
  }
}

fn run_int(f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with {
    Box::Put(n) => resume(n + 1)
  }
}

fn producer() -> Int with Box {
  run_str(() -> {
    perform Box::Put("ok") + run_int(() -> {
      perform Box::Put("bad")
    })
  })
}
