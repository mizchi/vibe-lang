// ADR-0124 decision 3 (#2656), Codex on #4067: a caller of `main` is charged
// the entry's residual requirement, not the labels `main` handles itself.
// `allows Db` records `main`'s handler; a function or a test that calls
// `main` needs no `Db` of its own.
effect Db {
  Get(Int) -> Int
}

fn app() -> Int with Db {
  perform Db::Get(1)
}

fn main allows Console + Db {
  let v = handle {
    app()
  } with {
    Db::Get(n) => resume(n + 41)
  }
  println("\{v}")
}

fn run_main() -> Unit with Console {
  main()
}

test "calls main" {
  main()
}
