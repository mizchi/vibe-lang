effect Ask { Get() -> Int }
effect Log { Note() -> Unit }

fn ask_once() -> Int with Ask { perform Ask::Get() }

fn run() -> Int with Log {
  let f: () -> Int with Ask + Log = ask_once
  handle { f() } with { Ask::Get() => resume(7) }
}

export fn main() -> Int {
  handle { run() } with { Log::Note() => resume(()) }
}
