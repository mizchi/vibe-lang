// #3862 (Codex on #3868): a payload that holds a parameter inside a literal
// (`Pair(Holder::{ v: first }, ..)`) carries that parameter's region
// provenance, as a bare `Pair(first, ..)` does.
struct Slot {
  callback: () -> Array[Int]
}

struct Holder[T] {
  v: T
}

enum Wrapper[A, B] {
  Pair(A, B)
}

fn pack[A, B](first: A, second: B) -> Wrapper[Holder[A], B] {
  Pair(Holder::{ v: first }, second)
}

fn main() -> Int {
  let escaped = region r {
    let values = MutList::empty(r)
    pack(first = Slot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = 0)
  }
  let Pair(holder, _) = escaped
  Array::length(holder.v.callback())
}
