// #3343 (Codex on #3359): ADR-0090's `region r { .. }` had the same hole as a
// task group: a region-bound list reaches the helper inside a struct argument
// whose nominal type does not show it, and the helper stores the struct in an
// outer cell. This compiled; the call is refused.
struct Holder {
  xs: MutList[Int]
}

struct Cell[T] {
  mut v: Option[T]
}

fn put(c: Cell[Holder], h: Holder) -> Unit {
  c.v = Some(h)
}

fn main() -> Unit allows Console {
  let c: Cell[Holder] = Cell::{ v: None }
  let n = region r {
    let xs = MutList::empty(r)
    MutList::push(xs, 1)
    put(c, Holder::{ xs: xs })
    MutList::length(xs)
  }
  println("n=\{n}")
}
