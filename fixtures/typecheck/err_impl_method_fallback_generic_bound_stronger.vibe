// #3551 review: a bodyless impl dispatches `write` to the fallback
// `P::write`, so the fallback's own binder may not require more than the
// trait's `write: [X: Render]` promises. `Loud` extends `Render`, not the
// other way round, so a caller through the trait never supplies `Loud`.
trait Render {
  render(Self) -> String
}

trait Loud: Render {
  shout(Self) -> String
}

trait W {
  write: [X: Render](Self, X) -> String
}

struct P {
  k: Int
}

fn P::write[Y: Loud](self: P, x: Y) -> String {
  Y::shout(x)
}

impl W for P

fn main allows Console {
  println("ok")
}
