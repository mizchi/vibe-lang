// #3360 control: imported helpers that read or join a task handle, or store
// it in an array the body declares itself, and an imported body that keeps
// its handles in its own local, stay accepted.
import @vibe/concurrent { TaskGroup, TaskHandle }
import ./taskgroup_escape_import_dep_ok.vibe { local_body, peek, put, wait }

fn main() -> Unit allows Exception + Console {
  let outer: Array[Int] = []
  let r = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 41 })
    let mine: Array[TaskHandle[Int]] = []
    put(mine, h)
    put(outer, wait(h))
    peek(h) + Array::length(mine)
  })
  let q = TaskGroup::run(local_body)
  println("r=\{r} q=\{q} after=\{Array::length(outer)}")
}
