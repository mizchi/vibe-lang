// #3493: valid forward references preserve their inferred types and runtime value.
struct LocalHelper { greet: (String) -> Int }
struct Later { eval: () -> Int }
let (helper, later) = (LocalHelper::{ greet: (name) -> 5 }, Later::{
  eval: () -> {
    helper.greet("x")
  }
})
fn main() -> Int {
  later.eval()
}
