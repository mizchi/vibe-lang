// #2985 review (Codex P0): the closure-argument rule trusts a callee whose
// parameter row admits the erased `Exception` to discharge what the closure
// throws. That trust rests on THIS refusal: a callee that calls such a
// parameter without declaring or handling the exception is refused at its
// own definition (the exception row is checked), so it cannot silently hand
// the closure's `7` to the `Exception[String]` arm below. The refusal must
// name `invoke`, not the handle.
fn invoke(f: () -> Int with Exception) -> Int {
  f()
}

fn main() -> Int {
  handle {
    invoke(() -> Int {
      throw(7)
    })
  } with { Exception[String]::Throw(s) => String::length(s) }
}
