// #3341: a lambda generic in its payload is let-generalized, so each call
// instantiates it afresh; its instantiation is read at the call. Here the
// call passes an `Int` where the function's row says `Box[String]`.
effect Box[T] {
  Put(T) -> Int
}

fn generalized() -> Int with Box[String] {
  let g = (x) -> { perform Box::Put(x) }
  g(1)
}
