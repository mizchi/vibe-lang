// #3372: the declared callback contract applies through aggregate wrappers.
export effect Box[T] {
  Put(T) -> Int
}
export struct Wrap[T] { v: T }
export struct Holder[F] { run: F }
export fn mk_wrap[T](v: T) -> Wrap[T] {
  Wrap::{ v: v }
}
export fn run_array[T](x: T, callbacks: Array[() -> Int with Box[Wrap[T]]]) -> Int {
  42
}
export fn run_option[T](x: T, callbacks: Option[() -> Int with Box[Wrap[T]]]) -> Int {
  42
}
export fn run_tuple[T](x: T, callbacks: (() -> Int with Box[Wrap[T]], Int)) -> Int {
  42
}
export fn run_record[T](x: T, callbacks: Holder[() -> Int with Box[Wrap[T]]]) -> Int {
  42
}
