// #3408 (Codex on #3409): the parameter `mk` (then declared `mk~`, a spelling
// since retired) is read as `mk` in the body, so the call is the parameter's,
// not the top-level `mk`'s, and `mid` does not take `Box[Int]`.
effect Box[T] {
  Put(T) -> Int
}
fn mk() -> Int with Box {
  perform Box::Put(12345)
}
fn mid(mk: () -> Int) -> Int with Box {
  mk()
}
fn caller() -> Int with Box[String] {
  mid(mk = () -> 1)
}
