// #3238 / #3371: the payload pattern `A` of the same-named operation
// `Logger::A` is a bare constructor (`Payload::A`), not a binder. Before
// #3371 the build refused it as a constructor collision with the private
// enum pattern `Api::A`; it is now refused first as a payload pattern -- a
// handler arm's payload is a name or `_` -- and this row pins that message.
// The collision itself is still pinned, with the bare `A` moved into the arm
// body, by fixtures/reexport_enum_alias_private_handler_nested_collision_refused.vibe.
import ../import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

enum Payload {
  A
}

effect Logger {
  A(Payload) -> Int
}

fn run() -> Int {
  handle {
    perform Logger::A(Payload::A)
  } with { Logger::A(A) => resume(7) }
}

fn pick() -> Int {
  match Api::A {
    Api::A => 1,
    Api::B => 2
  }
}
