// #3539: an argument the effects walk cannot read (`Array::get(fs, 0)`) left
// `apply`'s row variable open and the call charged nothing. The checker's
// instantiation binds it to the element's row.
fn apply(f: () -> Unit with e) -> Unit with e {
  f()
}

fn pure_fn(fs: Array[() -> Unit with Console]) -> Int {
  apply(Array::get(fs, 0))
  42
}
