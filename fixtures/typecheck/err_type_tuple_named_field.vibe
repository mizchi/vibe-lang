//# #2807: a tuple read whose field name is not a numeric slot.
//#
//# `parse_tuple_index` returns nothing for `payload`, and that answer was
//# tolerated rather than refused, so codegen resolved the name by spelling
//# against `Crate` and emitted the load. Measured before the fix, on a compiler
//# built from 4905ca8: this compiled clean and answered `7` -- slot 0 of the
//# tuple, read through a struct's offset.
struct Crate {
  payload: Int
}

export fn main() -> Int {
  let t = (7, 8)
  t.payload
}
