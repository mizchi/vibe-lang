// #3568: the accepted side of `row_var_{field,tuple}_projection_call_reject`:
// a function that declares the callback's row `e` may call it through a
// struct field or a tuple projection, and its caller is charged `Console`.
struct Holder[e] {
  run: () -> Int with e
}

fn via_field(f: () -> Int with e) -> Int with e {
  let h = Holder::{ run: f }
  (h.run)()
}

fn via_tuple(f: () -> Int with e) -> Int with e {
  let t = (f, 1)
  (t.0)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn loud() -> Int with Console {
  via_field(noisy) + via_tuple(noisy)
}
