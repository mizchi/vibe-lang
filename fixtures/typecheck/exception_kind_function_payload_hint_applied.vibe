// The edit the hint in exception_kind_function_payload_hint_reject names,
// applied verbatim: the alias it asks for, and the row it pastes.
type Kind = (Int, Int) -> Int

struct IoErr {
  code: Int
}

struct Holder {
  cb: (Int, Int) -> Int
}

fn boom(h: Holder) -> Int with Exception[Kind] + Exception[IoErr] {
  throw(h.cb)
}
