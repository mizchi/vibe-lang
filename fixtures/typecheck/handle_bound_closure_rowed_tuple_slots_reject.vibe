// #3540 / #1451: the result declares `Ask` for both of its function slots,
// but only a closure that IS the function's result takes the declared row:
// these two kept this handle's evidence, and `drive(f)` trapped (`null
// function or function signature mismatch`). Refused like any closure that
// leaves its handle; fixtures/returned_row_closure_test.vibe runs the
// results that are a function type.
effect Ask {
  Get() -> Int
}

fn ask() -> Int with Ask {
  perform Ask::Get()
}

fn mid_pair() -> (() -> Int with Ask, () -> Int with Ask) {
  handle {
    (() -> ask(), () -> ask() + 1)
  } with { Ask::Get() => resume(5) }
}

fn drive(f: () -> Int with Ask) -> Int {
  handle {
    f()
  } with { Ask::Get() => resume(40) }
}

fn main() -> Unit allows Console {
  let (f, g) = mid_pair()
  println("f=\{drive(f)} g=\{drive(g)}")
}
