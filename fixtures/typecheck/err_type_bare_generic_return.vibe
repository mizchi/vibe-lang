// #3536: a generic head written bare in a signature resolved to a wildcard,
// so `["str"]` came back as an `Array[Int]` and `+ 1` read the string's
// pointer (`137438953474`).
fn mk() -> Array {
  ["str"]
}

fn main allows Console {
  let xs: Array[Int] = mk()
  println("\{Array::get(xs, 0) + 1}")
}
