// #3053: `with State[Int]` does not authorize a callee's `State[String]`.
// Generic effect labels used to match by base name alone (#1340 v1), so this
// compiled and the handler that discharges `State[Int]` answered a `String`
// request with an `Int`.
effect State[S] {
  Get() -> S
}

fn g(x: String) -> Int with State[String] {
  1
}

fn caller() -> Int with State[Int] {
  g("abc")
}
