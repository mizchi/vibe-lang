// A program struct that reuses a compiler-owned head's name (and arity) is
// held to its own formals. `MutList[Int]` used to be read as the compiler's
// `MutList[T, r]` with its region slot left to the call, so `U` stayed rigid,
// `b: 2` passed, and the field was read as a `String` (the run printed `    !`).
struct MutList[T, U] {
  a: T;
  b: U
}

fn second(p: MutList[Int]) -> String {
  p.b
}

fn main allows Console {
  println(String::concat(second(MutList::{ a: 1, b: 2 }), "!"))
}
