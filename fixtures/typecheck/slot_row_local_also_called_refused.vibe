// #3621: `g` is passed to the row-typed parameter of `drive` and also
// called directly, where no handler is passed, so no one calling convention
// serves both uses. It kept the row-free one while `drive` passed the
// handler (`tick` performs `Box`), and the call trapped ("indirect call type
// mismatch") after a clean `vibe check`. The build is refused with the edit.
// A closure whose binding writes the row answers
// (fixtures/named_fn_row_slot_test.vibe).
effect Box[T] {
  Put(T) -> Unit
}

fn drive(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(_) => resume(()) }
}

fn tick() -> Int with Box[String] {
  perform Box::Put("t")
  1
}

fn main() -> Int {
  let g = () -> 7
  drive(g) + g() + drive(tick)
}
