// #3549: the capture's type is shown as the reader can write it. The region
// the checker made up for the outer group and an unresolved type variable
// printed as `Sender[#region_240, ?t238, Int]`.
import @vibe/concurrent { TaskGroup, TaskHandle, TaskError, Channel, Sender, SendError, ChannelConfigError }

fn main() -> Unit allows Console + Exception[TaskError] + Exception[SendError] + Exception[ChannelConfigError] {
  let total = TaskGroup::run((n) -> {
    let (tx, _rx) = Channel::bounded(n, 4)
    let inner = TaskGroup::run((m) -> {
      let h = TaskGroup::spawn(m, () -> {
        Sender::send(tx, 1)
        0
      })
      TaskHandle::join(h)
    })
    Sender::release(tx)
    inner
  })
  println("total=\{total}")
}
