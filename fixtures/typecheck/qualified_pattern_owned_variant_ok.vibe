// #1455 step 3 companion: a qualifier that DOES own the variant stays legal,
// and an effect handle arm's `Effect::Op` pattern reaches the same side
// channel without being mistaken for an enum variant.
enum Color { Red; Green }

effect Log {
  Emit(String) -> Unit
}

fn describe(c: Color) -> String {
  match c {
    Color::Red => "red"
    Color::Green => "green"
  }
}

fn shout(s: String) -> String with Log {
  perform Log::Emit(s)
  s
}

fn run_logged() -> String {
  handle {
    shout("hi")
  } with {
    Log::Emit(m) => resume(m)
  }
}
