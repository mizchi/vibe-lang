// Codex on #3021: an effect named BELOW a type constructor in an exception
// kind is not a type either. `Exception[Array[Ask]]` used to be accepted and
// the arm's binder typed as though `Ask` were a value type.
effect Ask {
  Get() -> Int
}

fn main() -> Int {
  handle { throw([1]) } with { Exception[Array[Ask]]::Throw(_) => 0 }
}
