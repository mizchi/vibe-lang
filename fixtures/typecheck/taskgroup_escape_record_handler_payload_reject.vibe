// #3488 (Codex on #3492): a handler arm's binder is the payload an
// operation in the handled body was given -- here the thrown outer cell.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: handle { throw(outer) } with { Exception[Cell]::Throw(x) => x } }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
