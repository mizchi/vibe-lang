// #3598: the same refusal for a local annotated `let` over a `match`, with
// the pure arm first.
fn other() -> Int with Exception[String] {
  throw("x")
}

fn run(k: Int) -> Int with Exception[Int] {
  let f: () -> Int with Exception[Int] = match k {
    0 => () -> 1,
    _ => other
  }
  f()
}

fn main() -> Unit allows Console {
  let r = handle {
    run(1)
  } with { Exception[Int]::Throw(n) => n }
  println("\{r}")
}
