// #3311 (Codex on #3340) control: the same when the other `Wrap` is imported
// from another module: the two are refused at the import (#3036), so the
// callback row never reads one as the other.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_wrap
}

import ./generic_effect_row_callback_other_dep_ok.vibe {
  Wrap, other_wrap
}

fn producer() -> Int with Box {
  run_wrap("abc", () -> {
    perform Box::Put(other_wrap())
  }, (s) -> String::length(s))
}
