// #2969 (Codex P1 on #3049): the outer arm's tail is a nested `handle` whose
// arm stores the INNER `resume` and returns 7. That 7 becomes the nested
// handle's result and so the outer arm's tail value -- an implicit resume of
// the outer perform (measured `r=107`). A nested handle with a suspend arm in
// tail position is a bare tail; wrap it in the outer resume(...).
effect Outer {
  Get() -> Int
}

effect Inner {
  Pause() -> Int
}

fn body() -> Int with Outer {
  perform Outer::Get() + 100
}

fn main() -> Int {
  handle {
    body()
  } with { Outer::Get() => handle {
    let n = perform Inner::Pause()
    return n
  } with { Inner::Pause() => {
    let k = resume
    7
  } } }
}
