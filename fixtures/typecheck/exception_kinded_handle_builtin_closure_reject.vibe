// #2985 review: a closure literal handed to a BUILTIN is one whose
// parameter rows the effects pass cannot see, so under a kinded handle it
// stays as strict as the body. `Array::map` runs the literal right here, so
// the `throw(7)` would land in the `Exception[String]` arm and be read as a
// String.
fn main() -> Int {
  handle {
    let ys = Array::map([1, 2, 3], (x) -> Int {
      if x == 2 {
        throw(7)
      }
      x
    })
    Array::length(ys)
  } with { Exception[String]::Throw(s) => String::length(s) }
}
