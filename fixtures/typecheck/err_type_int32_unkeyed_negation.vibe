//# #3730: a sized negation is wrapped by its operand's position, and
//# `-(a + b)` negates an operator, which has none. It is refused with the
//# edit (`0 - (..)`) rather than left unwrapped, where `-(MIN + 0)` would be
//# 2147483648.
fn neg_sum(a: Int32, b: Int32) -> Int32 {
  -(a + b)
}

fn main() -> Int {
  0
}
