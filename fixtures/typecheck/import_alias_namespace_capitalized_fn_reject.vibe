//# A capitalized function imported under a builtin namespace's name. The
//# parser classifies an import item by its spelling and read `MakeTag` as a
//# type, so the alias was accepted, `Array::length(..)` was rewritten to
//# `MakeTag::length(..)`, `vibe check` stayed clean and `vibe build` stopped
//# with an internal compiler error. The checker sees the dependency's
//# declarations and refuses the alias with the edit.
import ./import_alias_namespace_value_dep_ok.vibe { MakeTag as Array }

fn main() -> Int {
  Array(1) + Array::length([1, 2, 3])
}
