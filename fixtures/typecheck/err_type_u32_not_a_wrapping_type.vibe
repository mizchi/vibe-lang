//# #3793: `u32` is not a 32-bit type.
//#
//# It resolved to a builtin type whose arithmetic was the 63-bit `Int`'s, so
//# this program checked clean and printed `b=8589934590`, a value no 32-bit
//# reading of `4294967295 + 4294967295` gives. It is now an unknown type, and
//# the message leads with the edit: write `Int`.
fn bump(_ x: u32) -> u32 {
  x + x
}

fn main() -> Unit allows Console {
  let a: u32 = 4294967295
  println("b=\{bump(a)}")
}
