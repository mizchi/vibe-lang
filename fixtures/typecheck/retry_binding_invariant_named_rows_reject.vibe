// #3518 review: `T` occurs as `Consumer[() -> Int with Log]` and as
// `Consumer[() -> Int with Tick]`. `Consumer` takes its argument in a
// parameter position, so a joined `Consumer[() -> Int with Log + Tick]` would
// hand the `Tick` consumer a `Log` callback it runs with no handler. The rows
// differ, and the argument is refused with the edit.
effect Log {
  Emit(Int) -> Unit
}

effect Tick {
  Bump() -> Unit
}

struct Consumer[T] {
  take: (T) -> Int
}

fn run_logged(cb: () -> Int with Log) -> Int {
  0
}

fn run_ticked(cb: () -> Int with Tick) -> Int {
  0
}

fn pair() -> (Consumer[() -> Int with Log], Consumer[() -> Int with Tick]) {
  (Consumer::{ take: run_logged }, Consumer::{ take: run_ticked })
}

fn second[T, e](mk: () -> (T, T) with Exception + e) -> T with Exception + e {
  let (_, b) = mk()
  b
}

fn main() -> Int allows Exception {
  let c = second(pair)
  0
}
