// The enum form: a Hash-only derive with `Acc::hash_key` written still
// generates the renderer, which printed the `ArrayBuilder` payload's address.
enum Acc {
  Building(ArrayBuilder[Int])
  Done
} derive (Hash)

fn Acc::hash_key(a: Acc) -> String {
  "a"
}

fn show_acc() -> String {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, 1)
  let a = Acc::Building(b)
  "a=\{a}"
}
