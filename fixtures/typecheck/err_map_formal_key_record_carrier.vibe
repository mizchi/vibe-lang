// #2334: a helper whose type parameter keys a map keeps its restriction when
// it is carried in a record and called through the field at an `Int` key.
fn look[K, V](m: Map[K, V], k: K) -> V {
  Map::get(m, k)
}

fn main {
  let r = record { f: look }
  let m: Map[Int, Int] = Map::set(Map::new(), 1, 10)
  let _ = (r.f)(m, 1)
  ()
}
