// #3551 review: a bodyless `impl [T] Name for Box[T]` dispatches every
// instantiation to the fallback `Box::name`, and the impl promises nothing of
// `T`. The fallback's `[U: Render]` was accepted, and `via(Box[Plain])` asked
// for a `Render` witness for `Plain`: measured on 22c039be1, a clean check,
// then a module the wasm validator rejected.
trait Render {
  render(Self) -> String
}

trait Name {
  name(Self) -> String
}

struct Box[T] {
  v: T
}

struct Plain {
  a: Int
}

impl [T] Name for Box[T]

fn Box::name[U: Render](self: Box[U]) -> String {
  U::render(self.v)
}

fn via[N: Name](n: N) -> String {
  N::name(n)
}

fn main allows Console {
  let b: Box[Plain] = Box::{ v: Plain::{ a: 7 } }
  println(via(b))
}
