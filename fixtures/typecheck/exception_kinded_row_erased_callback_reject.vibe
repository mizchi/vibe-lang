// #3015: a row that declares only `Exception[String]` cannot call a callback
// that may raise ANY kind. The row was trusted by every caller, and a kinded
// `Exception[String]` handler around `relabel(child_int)` read the Int 7 as a
// String.
fn relabel(f: () -> Int with Exception) -> Int with Exception[String] {
  f()
}

fn child_int() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Int {
  handle { relabel(child_int) } with { Exception[String]::Throw(s) => String::length(s) }
}
