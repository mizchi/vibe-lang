// #3495: a write through a map index reaches the value the map holds, so a
// handle stored through an outer map's cell outlives the group.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let outer_map = Map::from_pairs([("k", outer)])
  let r = TaskGroup::run((n) -> {
    outer_map["k"].v = Some(TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
