// #3101: a non-generic lambda standing between the two binders does not make
// them one. `get(x)` still requires the outer `S`.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

fn caller[S](x: S) -> Int {
  let h = (u: Int) -> Int {
    let g = [S](y: S) -> Int with State[S] {
      get(x)
    }
    u
  }
  0
}
