// #3589: the accepted side of `struct_row_arg_generalized_*_reject`: a pure
// function stored by a generalized lambda and by a top-level binding, called
// from a pure caller; a lambda storing its callback, called with a pure one
// from a pure caller and with `noisy` from a caller that declares `Console`.
struct Holder[r] {
  run: () -> Int with r
}

fn calm() -> Int {
  40
}

fn noisy() -> Int with Console {
  println("noisy")
  1
}

let make = () -> Holder::{ run: calm }

let h = Holder::{ run: calm }

let make_noisy = () -> Holder::{ run: noisy }

let wrap = (f: () -> Int with e) -> Holder::{ run: f }

fn quiet() -> Int {
  (make().run)() + (h.run)() + (wrap(calm).run)() - 80
}

fn loud() -> Int with Console {
  (make_noisy().run)() + (wrap(noisy).run)()
}

fn main() -> Unit allows Console {
  println("\{quiet()} \{loud()}")
}
