// #3551 review: a shadow of an erased arm's binder ends with its block. After
// the `if` block, `m` is again the value `Exception::Throw(m)` caught -- `f`'s
// `Int` -- so `throw(m)` is a rethrow of no known kind, which the declared
// `Exception[String]` does not cover. The edit is the kinded arm
// (`Exception[Int]::Throw(m)`) or the erased `with Exception` row.
fn f() -> Int with Exception[Int] {
  throw(7)
}

fn g() -> Int with Exception[String] {
  handle { f() } with { Exception::Throw(m) => {
    let c = true
    if c {
      let m = "other"
      let _n = String::length(m)
    }
    throw(m)
  } }
}

fn main allows Console {
  let r = handle { g() } with { Exception[String]::Throw(s) => String::length(s) }
  println("len=\{r}")
}
