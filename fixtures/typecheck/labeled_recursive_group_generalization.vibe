// Inferred recursive groups retain declaration labels after generalization.
let rec choose = (x: Int, y: Int) -> {
  if x == 0 {
    y
  } else {
    choose(x = 0, y = y)
  }
}

let rec first = (x: Int, y: Int) -> {
  if x == 0 {
    y
  } else {
    second(x = 0, y = y)
  }
}

let rec second = (x: Int, y: Int) -> {
  if x == 0 {
    y
  } else {
    first(x = 0, y = y)
  }
}

fn main() -> Int {
  if choose(x = 0, y = 3) == 3 && first(x = 0, y = 5) == 5 && second(x = 0, y = 7) == 7 {
    0
  } else {
    assert(false); 1
  }
}
