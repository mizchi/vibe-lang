// Inferred recursive groups retain declaration labels after generalization.
let rec choose = (x: Int, y: Int) -> {
  if x == 0 {
    y
  } else {
    choose(x = 0, y = y)
  }
}

let rec first = (x: Int, y: Int) -> {
  if x == 0 {
    y
  } else {
    second(x = 0, y = y)
  }
}

let rec second = (x: Int, y: Int) -> {
  if x == 0 {
    y
  } else {
    first(x = 0, y = y)
  }
}

fn main() -> Int {
  if choose(y = 3, x = 0) == 3 && first(y = 5, x = 0) == 5 && second(y = 7, x = 0) == 7 {
    0
  } else {
    assert(false); 1
  }
}
