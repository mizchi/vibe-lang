// #3036 control: a cyclic closure (`Chain` names itself, `Node` and `Leaf`
// name each other) reached by a signature one hop away and by a direct
// import of the same declarations. The walk terminates, and one declaration
// each stays legal.
import ./dup_type_cycle_mid_dep_ok.vibe { wrap_node }
import ./dup_type_cycle_dep_ok.vibe { Leaf, Node }

fn count() -> Int {
  let n: Node = wrap_node()
  let kids: Array[Leaf] = n.kids
  Array::length(kids)
}
