// #4142 control: a handler arm that binds `resume` as a value receives the
// handle body's result through the continuation call, so a `Map::set` at the
// body's tail is used even though the `handle` itself ends a `while` body.
effect Ask {
  Get() -> Int
}

fn main() -> Int {
  let m: Map[String, Int] = Map::new()
  let seen: Array[Map[String, Int]] = []
  let mut i = 0
  while i < 2 {
    i = i + 1
    handle {
      let v = perform Ask::Get()
      Map::set(m, key = "a", value = v)
    } with {
      Ask::Get() => {
        let k = resume
        let updated = k(i)
        Array::push(seen, value = updated)
        updated
      }
    }
  }
  Array::length(seen)
}
