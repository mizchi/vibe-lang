// ADR-0120 (Codex on #3844): an omitted optional parameter shifts every
// labeled argument after it, so `f = bad` is written at index 1 but fills
// formal slot 2. Read at its written index, `bad` was judged against `safe`'s
// `Exception[Int]` row and passed into `f`'s erased row unrefused; the erased
// arm then read the `Int` 7 as a `String`.
fn run(unused?: Int, safe: () -> Int with Exception[Int], f: () -> Int with Exception) -> Int with Exception {
  let _ = unused
  let _ = safe
  f()
}

fn bad() -> Int with Exception {
  throw(7)
}

fn main() -> Unit allows Console {
  let r = handle {
    run(safe = () -> 0, f = bad)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{r}")
}
