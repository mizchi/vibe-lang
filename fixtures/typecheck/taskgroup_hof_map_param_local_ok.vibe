// #3360 control: a closure handed to `Array::map` that stores its parameter
// in an array it binds itself, or that keeps only the joined value outside,
// stays accepted.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let outer: Array[Int] = []
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, () -> { 41 })]
    let _ = Array::map(hs, (h) -> {
      let mine = [h]
      Array::push(mine, h)
      Array::push(outer, TaskHandle::join(h))
      Array::length(mine)
    })
    1
  })
  println("r=\{r} after=\{Array::length(outer)}")
}
