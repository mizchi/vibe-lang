// #2974: a parse error inside an interpolation's `\{..}` is located at its
// real line and column, not at `line 1` (the fragment's own token index used
// to be resolved against the file's tokens).
fn f(x: Int) -> Int { x }
fn main() -> Unit allows Console {
  let a = 1
  println("v=\{f(x~: 1)}")
}
