// #3561: a function literal written at the call hands its `with e` to
// `apply` exactly as a named callback does, so `wrap` must declare it. Before
// the fix this compiled, and `quiet` printed from a function declared pure.
fn apply(f: () -> Int with e) -> Int with e {
  f()
}

fn wrap(f: () -> Int with e) -> Int {
  apply(() -> Int with e { f() })
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
