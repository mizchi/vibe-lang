// #3198 review (Codex): the positive side -- with `Async` in the row, the
// same match-bound async iterator is accepted.
trait AIter[T] {
  next(Self) -> Future[Option[(T, Self)]]
}

struct Countdown {
  n: Int
}

impl AIter for Countdown {
  next(self) -> Future[Option[(Int, Countdown)]] {
    Future::ready(if self.n > 0 {
      Some((self.n, Countdown::{ n: self.n - 1 }))
    } else {
      None
    })
  }
}

fn total(o: Option[Countdown]) -> Int with Async {
  let mut acc = 0
  match o {
    Some(c) => {
      for x in c {
        acc = acc + x
      }
      ()
    },
    None => ()
  }
  acc
}
