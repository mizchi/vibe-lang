// A lambda passed for `(Int32) -> Int32` with no written result type: an
// early `return` is checked against `Int32` as the tail is, so a literal out
// of range is refused even though the tail `0` fits.
fn ap(f: (Int32) -> Int32) -> Int32 {
  f(5)
}

fn use() -> Int32 {
  ap(f = (k) -> {
    if k == 0 {
      return 2147483648
    }
    0
  })
}
