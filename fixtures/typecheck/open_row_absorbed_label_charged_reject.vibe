// #3575: `e` in `Log + e` takes the callback's `Tick`, so the caller is
// charged it; a caller that declares only `Log` is refused.
effect Log {
  Emit(String) -> Unit
}

effect Tick {
  Step(Int) -> Int
}

fn call(f: () -> Int with Log + e) -> Int with Log + e {
  f()
}

fn both() -> Int with Log + Tick {
  perform Log::Emit("both")
  perform Tick::Step(1)
}

fn only_log() -> Int with Log {
  call(both)
}
