//# #3549: an enum payload holding a function, reached through a generic
//# struct's type argument. Measured before the refusal, `E::A(f) == E::A(g)`
//# answered `false` for two closures with the same body.
enum E {
  A((Int) -> Int);
  B
}

struct Box[T] {
  v: T
}

export fn main() -> Int {
  let f = (x: Int) -> x + 1
  let g = (x: Int) -> x + 1
  let a: Box[E] = Box::{ v: E::A(f) }
  let b: Box[E] = Box::{ v: E::A(g) }
  if a == b {
    1
  } else {
    0
  }
}
