// #3418: a bare `with Kb` of a kinded effect is read with the constructor its
// body performs at, like a scalar one (#3408). Under the caller's `Kb[Cell]`
// the handler read the `Array[Int]` as a `Cell[Int]`, and `v.value` answered
// `30064771342`.
effect Kb[F[_]] {
  Put(F[Int]) -> Int
}

struct Cell[T] {
  value: T
}

fn mk(x: Array[Int]) -> Int with Kb {
  perform Kb::Put(x)
}

fn caller() -> Int with Kb[Cell] {
  mk([7, 8, 9])
}
