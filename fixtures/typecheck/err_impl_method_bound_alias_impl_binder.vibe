// #3947 (Codex on #3956): each side of an impl-method bound comparison is
// resolved under its own binders. `T` is an imported alias of `Int`, so the
// trait's `run[U: Value[StringMap[T]]]` promises `Value[Map[String, Int]]`,
// while the impl's `run[T: Value[Map[String, T]]]` names its OWN binder `T`
// and asks for a witness at the caller's type. Resolving both under the union
// of the binders read the trait's `T` as the impl's and accepted the impl.
import ./impl_method_bound_alias_defs_dep_ok.vibe {
  T
}

trait Value[A] {
  value(Self) -> Int
}

trait Run {
  run[U: Value[StringMap[T]]](Self, U) -> Int
}

struct Runner {
  k: Int
}

impl Run for Runner {
  run[T: Value[Map[String, T]]](self, v: T) -> Int {
    self.k + T::value(v)
  }
}

fn main allows Console {
  println("unreachable")
}
