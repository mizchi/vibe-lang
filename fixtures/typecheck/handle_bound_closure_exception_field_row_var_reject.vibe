// #3594: a row-polymorphic builder. `forward(noisy)` instantiates `e` to
// `Exception[Int]`, and the closure `forward` stores in the field calls
// `noisy` through the handler of this call, so calling `f` after the handle
// threw with no handler around it.
struct Box {
  f: () -> Int
}

fn forward[e](g: () -> Int with e) -> Box with e {
  Box::{ f: () -> g() }
}

fn noisy() -> Int with Exception[Int] {
  throw(7)
}

fn main() -> Unit allows Console {
  let b = handle {
    forward(noisy)
  } with { Exception[Int]::Throw(c) => Box::{ f: () -> c } }
  let f = b.f
  println("\{f()}")
}
