// #3351: an effect parameter that takes a constructor (`Kb[F[_]]`), at a
// callback row naming `Bag`, which this module does not import. A constructor
// is read through its declaration, so the perform is refused with the edit.
import ./callback_row_unimported_dep_ok.vibe {
  effect Kb, run_bag
}

fn producer() -> Int with Kb {
  run_bag(() -> {
    perform Kb::Put(41)
  })
}
