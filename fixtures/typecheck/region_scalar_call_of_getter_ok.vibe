// #4091 (Codex on #4106): `Array::length(get_sink())` copies an `Int` out of
// the getter's storage, so the box stored in `boxes` holds none of it.
// `main` answers 10 * the block's value + `sink`'s length.

let sink: Array[MutList[Int]] = []

fn get_sink() -> Array[MutList[Int]] {
  sink
}

struct Box {
  tag: Int;
  items: Array[MutList[Int]]
}

fn main() -> Int allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let boxes: Array[Box] = []
    Array::push(boxes, value = Box::{ tag: Array::length(get_sink()), items: [] })
    let b = Array::get(boxes, at = 0)
    Array::push(b.items, value = c)
    Array::length(b.items) + b.tag
  }
  v * 10 + Array::length(sink)
}
