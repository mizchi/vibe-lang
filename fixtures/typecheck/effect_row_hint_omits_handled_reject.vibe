// #2975: the row hint for a body inside a `handle` names what the FUNCTION
// must declare. It used to fold the handle's discharged labels into both the
// "declared" set and the hint (`add 'with Ask + Ask::Get + Log'`), telling the
// user to declare the effect they had just handled.
effect Ask {
  Get() -> Int
}

effect Log {
  Emit(String) -> Unit
}

fn f() -> Int with Ask + Log {
  perform Log::Emit("x")
  perform Ask::Get()
}

fn g() -> Int {
  handle { f() } with { Ask::Get() => resume(1) }
}

fn main() -> Int {
  handle { g() } with { Log::Emit(_) => resume(()) }
}
