// #3562: the impl of `Key`, a subtrait of `Eq`, writes `equals`, and a later
// `impl Eq for Box[Int]` writes another for an instantiation it covers.
trait Key: Eq {
  tag(Self) -> Int
}

struct Box[T] {
  v: T
}

impl [T] Key for Box[T] {
  tag(self) -> Int {
    0
  }
  equals(self, o: Box[T]) -> Bool {
    false
  }
}

impl Eq for Box[Int] {
  equals(self, o: Box[Int]) -> Bool {
    true
  }
}

fn outer[T: Key](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn answers() -> Bool {
  let p: Box[Int] = Box::{ v: 1 }
  outer(p, p)
}
