// #3601 (Codex on #3605): `fail`'s erased row lets an `Int` out. The
// parameter row `with Exception + e` looks as if `e` could carry the kind,
// but a call matches the value's erased exception to the slot's `Exception`
// and leaves `e` empty (#3033), so `run`'s callers read only messages and the
// erased arm read the `Int` 7 as a `String` (`len=14`).
fn run[e](f: () -> Int with Exception + e) -> Int with Exception + e {
  f()
}

fn fail() -> Int with Exception {
  throw(7)
}

fn main() -> Unit allows Console {
  let n = handle {
    run(fail)
  } with { Exception::Throw(m) => String::length(m) }
  println("len=\{n}")
}
