// #3238 / #3371: a qualified private pattern `Api::A` in the payload position
// of the same-named operation `Logger::A` does not compete with it (that used
// to be a false "rename one of the variants" refusal). The payload pattern is
// refused since #3371: it was never tested, so this arm also ran for
// `perform Logger::A(Api::B)` (measured: 7). This row pins that the refusal
// is that one; the accepted spelling, which matches the payload in the arm
// body, is fixtures/reexport_enum_alias_private_qualified_payload_test.vibe.
import ../import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

effect Logger {
  A(Api) -> Int
}

fn run() -> Int {
  handle {
    perform Logger::A(Api::A)
  } with { Logger::A(Api::A) => resume(7) }
}
