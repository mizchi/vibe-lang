// ADR-0088: an effectset the program declares is one spelling at the entry;
// it is expanded before admission, so the grant is exactly its members.
effectset AppCaps = { Console, Fs::read_file }

fn read_or_default(path: String) -> String with Fs::read_file {
  Fs::read_file(path)
}

fn main allows AppCaps {
  let _ = read_or_default("fixtures/typecheck/entry_allows_effectset.vibe")
  println("bundled")
}
