// #3551 review: `factory` returns its callback with the callback's own row
// `e`, so calling what it returns runs `f`, and `wrap` must declare `e`
// exactly as a direct `f()` would require. Before the fix this compiled, and
// `quiet` printed from a function declared pure.
fn factory(f: () -> Int with e) -> () -> Int with e {
  f
}

fn wrap(f: () -> Int with e) -> Int {
  factory(f)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
