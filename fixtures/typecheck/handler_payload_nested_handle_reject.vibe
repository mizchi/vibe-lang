// #3371: the inner handle of a nested pair is refused for its own arm; the
// outer arm binds its payload and stays accepted.
effect Pick {
  P(Int) -> Int
  Q(Int) -> Int
}

effect Outer {
  O(Int) -> Int
}

fn run() -> Int {
  handle {
    let a = perform Outer::O(1)
    let b = handle {
      perform Pick::P(3)
    } with {
      Pick::P(1) => resume(100);
      Pick::Q(_) => resume(7)
    }
    a + b
  } with {
    Outer::O(n) => resume(n)
  }
}
