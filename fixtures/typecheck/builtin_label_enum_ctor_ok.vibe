// #3651 control (Codex on #3657): an enum constructor that takes a builtin's
// spelling is a program binding, so its call is not judged as the builtin's.
// A constructor is positional (ADR-0120 D1); `println(1)` against the builtin
// would be a type error.
enum Message {
  println(Int)
}

fn main() -> Unit allows Console {
  let _ = println(1)
  ()
}
