// #3311 (Codex on #3340) control: a callback row's `Wrap` is read in the
// importer's scope, which is the exporter's `Wrap` because a module whose own
// `Wrap` is a different declaration is refused at the import (#3035). This
// pins that refusal for a name the callee uses only inside a callback row.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_wrap
}

struct Wrap[T] {
  name: String
}

fn producer() -> Int with Box {
  run_wrap("abc", () -> {
    perform Box::Put(Wrap::{ name: "zz" })
  }, (s) -> String::length(s))
}
