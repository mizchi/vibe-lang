// #1511 / #2121: the `handle` eligibility boundary, pinned per callee shape.
//
// docs/cheatsheet.md described this boundary in prose and drifted: it recorded
// a local-closure callee as REJECTED when it compiles, and the diagnostic text
// still claims a closure-parameter call is rejected when it is accepted. Prose
// cannot be checked; these can.
effect Ask { Get() -> Int }

fn ask_once() -> Int with Ask { perform Ask::Get() }

// Through a FUNCTION PARAMETER. The eligibility diagnostic's own text says
// "a call through a local binding or a closure parameter hides the perform and
// is what this rejects" -- measured, this is accepted. That sentence overstates
// the rule; this fixture is what would catch it changing back.
fn apply(f: () -> Int with Ask) -> Int with Ask { f() }

fn main() -> Unit {
  let _ = handle { apply(ask_once) } with { Ask::Get() => resume(1) }
}
