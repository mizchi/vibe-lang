// #3568: a callback held in a tuple and called through a projection runs the
// callback, so `wrap` must declare `e` exactly as a direct `f()` would
// require. Before the fix this compiled, and `quiet` printed from a function
// declared pure.
fn wrap(f: () -> Int with e) -> Int {
  let t = (f, 1)
  (t.0)()
}

fn noisy() -> Int with Console {
  println("x")
  1
}

fn quiet() -> Int {
  wrap(noisy)
}
