//# #2848 CONTROL (Codex on #2864, round 2). An impl method's `self` is
//# identified by its type VARIABLE, not by the spelling `self`, so an alias
//# `let value = self` keeps the impl treatment and `value.payload` is judged
//# against `Crate`, found, and accepted. The direct `self.payload` in the
//# second method is the shape every `impl` in `lib/` uses. The answer is
//# pinned: 7 + 100 rules out a first-field offset hit by luck.
struct Crate {
  payload: Int
}

trait Weigh {
  weigh(Self) -> Int;
  weigh_direct(Self) -> Int
}

impl Weigh for Crate {
  weigh(self) -> Int {
    let value = self
    value.payload
  };
  weigh_direct(self) -> Int {
    self.payload + 100
  }
}

export fn main() -> Int {
  let c = Crate::{ payload: 7 }
  Crate::weigh(c) + Crate::weigh_direct(c)
}
