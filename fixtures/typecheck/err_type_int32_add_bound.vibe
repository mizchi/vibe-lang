//# #3730: `Int32` has no `Add` impl yet. Its witness would be `Int`'s
//# unwrapped sum, so `[T: Add]` at an `Int32` is refused instead of
//# computing a 63-bit result under a 32-bit name.
fn sum[T: Add](a: T, b: T) -> T {
  a + b
}

fn twice(x: Int32) -> Int32 {
  sum(x, x)
}

fn main() -> Int {
  0
}
