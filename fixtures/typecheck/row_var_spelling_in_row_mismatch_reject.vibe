// A row-mismatch message spells a row variable as the source wrote it.
// Since #3557 instantiates a signature's own `with e` per call, the message
// printed the internal name: `(() -> Int with $7) -> Int with $7`. The
// refusal itself is right: `takes` promises a pure `g`, and `call` run on a
// `Console` callback performs `Console`.
fn call(f: () -> Int with e) -> Int with e {
  f()
}

fn takes(g: (() -> Int with Console) -> Int) -> Int {
  g(() -> 1)
}

fn main() -> Int {
  takes(call)
}
