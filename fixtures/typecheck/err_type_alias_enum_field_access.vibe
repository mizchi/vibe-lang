//# #2807: an alias to an enum needs no arm of its own, and this pins that.
//#
//# A type annotation is elaborated through `resolve_type_expr` before it is
//# bound, so `let t: TAlias` arrives at the field check already resolved to the
//# underlying enum. The diagnostic therefore names `Tote`, not `TAlias`.
//# Measured before the fix, on a compiler built from 4905ca8: this compiled
//# clean and answered `7`.
struct Crate {
  payload: Int
}

enum Tote {
  Slack;
  Laden(Int)
}

type TAlias = Tote

export fn main() -> Int {
  let t: TAlias = Laden(7)
  t.payload
}
