// #2985 review (Codex P0): a closure literal handed to a parameter whose row
// names a kind may throw exactly that kind, whatever the enclosing arm
// handles -- the callee's own kinded arm catches everything the literal
// raises. `takes_int` discharges `Exception[Int]`, so a `String` thrown in
// the literal would land in its `Exception[Int]` arm and be read as an Int
// (a named argument of that row was already refused with an effect-row
// mismatch; a literal was not compared with the parameter at all).
fn takes_int(f: () -> Int with Exception[Int]) -> Int {
  handle {
    f()
  } with { Exception[Int]::Throw(n) => n + 1000 }
}

fn main() -> Int {
  handle {
    takes_int(() -> Int {
      throw("hello")
    })
  } with { Exception[String]::Throw(s) => String::length(s) }
}
