// Codex on #3995: `Ignore[T] = Int` discards an argument that the resolver
// still expands first. `A = Ignore[Dup[Dup[..Int..]]]` (24 nested `Dup`s) is
// one node, but its argument is tens of millions. The canonical-key size count
// also tracks the largest argument an alias's resolution expands, so `A` is
// left out of the definitions and the checker's alias preflight reports it.
type Ignore[T] = Int

type Dup[T] = (T, T)

type A = Ignore[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Dup[Int]]]]]]]]]]]]]]]]]]]]]]]]]

trait Mark[X] {}

struct Note {
  n: Int
}

impl Mark[Int] for Note {}

fn main allows Console {
  println("unreachable")
}
