// #3488: a block that assigns an outer cell to a `let mut` and returns it
// still holds the outer cell (Codex on #3492).
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{
      cell: {
        let mut y = Cell::{ v: None }
        y = outer
        y
      }
    }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
