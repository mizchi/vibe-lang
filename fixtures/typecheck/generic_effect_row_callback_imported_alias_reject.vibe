// #3311 (Codex on #3340): the same through an exported alias of a private
// generic (`export let run_len_alias = run_len0`), whose published callback
// row indexes the alias's own quantifiers.
import ./generic_effect_row_callback_dep_ok.vibe {
  effect Box, run_len_alias
}

fn producer() -> Int with Box {
  run_len_alias("abc", () -> {
    perform Box::Put(1)
  }, (s) -> String::length(s))
}
