// #3275 follow-up (Codex on #3315): `struct Higher[G[_]]` has the arity
// `effect Read[F[_]]` asks for, but its own parameter is a constructor, so it
// cannot stand for `F`, which the operation applies to `Int`. The row-item
// check compared arities only and reported nothing, and a first cut of the
// kinded row arm left `F` fresh, so this perform checked clean.
effect Read[F[_]] {
  Put(F[Int]) -> Int
}

struct Higher[G[_]] {
  v: G[Int]
}

fn producer() -> Int with Read[Higher] {
  perform Read::Put(Some(1))
}
