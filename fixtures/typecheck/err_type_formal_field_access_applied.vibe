//# #2848 (Codex on #2864, round 3): the receiver is an APPLIED formal. `xs:
//# F[A]` arrives as `CtApplied(head, args)` whose head is the rigid
//# `#hktformal.F`, and the non-struct arm only recognised a top-level
//# variable, so the read was tolerated. Measured on the stage2 from 825cca8:
//# this compiled clean and answered 30064771306 -- an `Array[Int]` header
//# read through `Crate`'s field offset. The head is the formal, so the read is
//# refused naming `F`.
struct Crate {
  payload: Int
}

fn read[F, A](xs: F[A]) -> Int {
  xs.payload
}

export fn main() -> Int {
  read([7])
}
