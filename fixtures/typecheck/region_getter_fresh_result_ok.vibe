// #4091: a function whose result is built fresh, or is read out of its own
// argument (a `for` element), returns no outer storage.

fn make_list() -> Array[MutList[Int]] {
  []
}

fn first_of(xs: Array[Array[MutList[Int]]]) -> Array[MutList[Int]] {
  for x in xs {
    return x
  }
  []
}

fn main() -> Int allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    let s = make_list()
    Array::push(s, value = c)
    let rows: Array[Array[MutList[Int]]] = [[]]
    let row = first_of(xs = rows)
    Array::push(row, value = c)
    Array::length(s) + Array::length(row)
  }
  v
}
