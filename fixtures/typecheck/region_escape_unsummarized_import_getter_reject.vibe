// #4091: a module past the retention summary budget publishes no summary, so
// its getter's result cannot be shown fresh. Only the standard library, which
// publishes none by design, is trusted for that; any other import without a
// summary may return its own storage, as this one does.

import ./region_escape_unsummarized_import_dep_ok.vibe { get_sink, kept_len }

fn main() -> Unit allows Exception + Console {
  let v = region r {
    let c = MutList::empty(r)
    let s = get_sink()
    Array::push(s, value = c)
    1
  }
  println("v=\{v} kept=\{kept_len() > 0}")
}
