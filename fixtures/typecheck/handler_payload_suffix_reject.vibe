// #3371: a suffix handler (`with E::Op(..) => ..` before the block tail it
// handles) is one more spelling of the same arm; its literal payload was
// ignored and `run` answered 100 for `perform Pick::P(3)`.
effect Pick {
  P(Int) -> Int
}

fn run() -> Int {
  with Pick::P(1) => resume(100)
  perform Pick::P(3)
}
