// #3417: the kind is `Exception[(Int, Int) -> Int]`, a function payload,
// and its comma used to cut it in two, so the message asked for
// `Exception[(Int`. A row cannot spell a function kind, so the edit now
// declares an alias first and names the kind through it.
struct H {
  cb: (Int, Int) -> Int
}

fn run(f: () -> Int with Exception) -> Int with Exception {
  f()
}

fn go(h: H) -> Int with Exception {
  run(f = () -> throw(h.cb))
}
