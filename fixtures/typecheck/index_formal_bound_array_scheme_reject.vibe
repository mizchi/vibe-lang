//# #3156 review: a formal the body unifies with an Array through an ordinary
//# function (`require_array`) before indexing it. Declared ABOVE its caller,
//# the declaration's scheme carries that binding (#3149), so a Map argument
//# is a type error at the call. On the dbef63162 compiler this compiled and
//# the index read the map's backing store by position.
fn require_array[E](xs: Array[E]) -> Unit {
  ()
}

fn first[T](x: T) -> Int {
  require_array(x)
  x[0]
}

export fn main() -> Int {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  first(m)
}
