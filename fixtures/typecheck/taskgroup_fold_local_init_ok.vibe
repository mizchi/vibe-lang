// A fold inside a `TaskGroup::run` body pushes the group's handles into a
// local `init` and returns `acc`. The accumulator lives in the body, so the
// handles do not outlive the group. Before this change it was refused.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception + Console {
  let r = TaskGroup::run((n) -> {
    let hs = [TaskGroup::spawn(n, f = () -> { 41 }), TaskGroup::spawn(n, f = () -> { 1 })]
    let mine: Array[TaskHandle[Int]] = []
    let got = Array::fold(hs, init = mine, f = (acc, h) -> {
      Array::push(acc, value = h)
      acc
    })
    let mut total = 0
    for g in got {
      total = total + TaskHandle::join(g)
    }
    total
  })
  println("r=\{r}")
}
