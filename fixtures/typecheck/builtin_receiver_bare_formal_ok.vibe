//# #2820 CONTROL for the `Map` half. A bare type formal named for a builtin
//# is legal, and it resolves to the same `CtNamed("Map", [])` shape the builtin
//# arrives as -- distinguished only by arity, which is why the builtin refusal
//# requires the applied arity to match the registry's (>= 1) rather than
//# testing the name on its own. `shadowed` must keep compiling and answering.
//#
//# This file used to ALSO pin a field read on a plain formal (`fn read[T](m:
//# T) { m.v }`) as tolerated, and said so was a known defect: #2848. That read
//# resolved by SPELLING against any struct declaring the name, so `read(7)`
//# answered `0`. It is refused now -- `fixtures/typecheck/
//# err_type_formal_field_access*.vibe` hold the refusals -- and the concrete
//# `read` here is the edit the refusal's message names: write the struct that
//# declares the field in place of the type parameter.
struct Holder {
  v: Int
}

fn read(m: Holder) -> Int {
  m.v
}

fn shadowed[Map](m: Map) -> Int {
  7
}

export fn main() -> Int {
  read(Holder::{ v: 3 }) + shadowed(Holder::{ v: 1 })
}
