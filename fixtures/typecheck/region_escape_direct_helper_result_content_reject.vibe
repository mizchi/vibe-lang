let sink: Array[MutList[Int]] = []

fn make() -> Array[Array[MutList[Int]]] {
  let local: Array[Array[MutList[Int]]] = [[]]
  Array::set(local, at = 0, value = sink)
  local
}

fn main() -> Unit allows Exception {
  let v = region r {
    let c = MutList::empty(r)
    Array::push(Array::get(make(), at = 0), value = c)
    1
  }
  let _ = v
  ()
}
