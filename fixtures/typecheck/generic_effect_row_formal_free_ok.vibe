// #3318 control: a row formal the body keeps generic is accepted -- a
// payload of the formal's own type, a formal the body never performs at, and
// a body-local value whose type is free. A concrete row is unaffected.
effect Box[T] {
  Put(T) -> Int
}

fn put_any[T](x: T) -> Int with Box[T] {
  perform Box::Put(x)
}

fn put_twice[T](x: T, y: T) -> Int with Box[T] {
  perform Box::Put(x) + perform Box::Put(y)
}

fn silent[T]() -> Int with Box[T] {
  0
}

fn put_first[T](xs: Array[T]) -> Int with Box[T] {
  perform Box::Put(Array::get(xs, 0))
}

fn put_int() -> Int with Box[Int] {
  perform Box::Put(1)
}

fn main() -> Int {
  handle {
    put_any("s") + put_twice("a", "b") + silent() + put_first(["c"])
  } with {
    Box::Put(v) => resume(String::length(v))
  }
}
