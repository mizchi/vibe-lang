// #3536: a type alias whose body is a bare generic head made every use of
// the alias a wildcard: `mk` returned an `Array[String]` its caller read as
// an `Array[Int]`.
type Items = Array

fn mk() -> Items {
  ["hello"]
}

fn main allows Console {
  let ys: Array[Int] = mk()
  println("\{Array::get(ys, 0) + 1}")
}
