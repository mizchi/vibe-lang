// #3584: the throwing closure reaches the handle's value through a call
// chain and an enum payload. `mk` binds it by `let`, the closure throws
// through a call to `fail`, and `wrap` only forwards `mk`'s value -- the
// handle around `wrap()` is still what catches the throw.
enum Cb {
  C(() -> Int);
  Done
}

fn fail() -> Int with Exception[Int] {
  throw(7)
}

fn mk() -> Cb with Exception[Int] {
  let g = () -> fail() + 1
  Cb::C(g)
}

fn wrap() -> Cb with Exception[Int] {
  mk()
}

fn main() -> Unit allows Console {
  let c = handle {
    wrap()
  } with { Exception[Int]::Throw(_) => Cb::Done }
  match c {
    C(f) => println("\{f()}"),
    Done => println("done")
  }
}
