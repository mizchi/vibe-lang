// #3343 (Codex on #3359): a struct built from the handle, written straight
// into an outer cell. `Box`'s nominal type does not show its fields, so the
// write check, which reads the stored value's type, saw no region: this
// compiled and the handle was joined after its group closed. The write now
// also asks the stored value itself.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Box {
  h: TaskHandle[Int]
}

struct Cell[T] {
  mut v: Option[T]
}

fn main() -> Unit allows Exception + Console {
  let c: Cell[Box] = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    c.v = Some(Box::{ h: TaskGroup::spawn(n, () -> { 41 }) })
    1
  })
  let after = match c.v {
    Some(b) => TaskHandle::join(b.h),
    None => 0 - 1
  }
  println("r=\{r} after=\{after}")
}
