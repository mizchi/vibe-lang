// A Hash-only derive with `S::hash_key` written. The derived key is not
// generated, so its own refusal of the `StringMap` field never runs, but the
// derive still generates `S::to_string`: `"\{s}"` printed `S { m: <address> }`
// with `vibe check` clean.
struct S {
  m: StringMap[Int]
} derive (Hash)

fn S::hash_key(s: S) -> String {
  "s"
}

fn show_s() -> String {
  let s = S::{ m: Map::from_pairs([("a", 1)]) }
  "s=\{s}"
}
