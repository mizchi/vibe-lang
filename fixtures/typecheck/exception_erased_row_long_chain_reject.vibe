// #3541 (Codex review on #3594): a non-String kind forwarded through a
// chain of erased `with Exception` rows longer than the old 16-round cap
// still reaches the erased arm that reads its binder, so the arm is refused.
fn f0() -> Int with Exception {
  throw(7)
}

fn f1() -> Int with Exception {
  f0()
}

fn f2() -> Int with Exception {
  f1()
}

fn f3() -> Int with Exception {
  f2()
}

fn f4() -> Int with Exception {
  f3()
}

fn f5() -> Int with Exception {
  f4()
}

fn f6() -> Int with Exception {
  f5()
}

fn f7() -> Int with Exception {
  f6()
}

fn f8() -> Int with Exception {
  f7()
}

fn f9() -> Int with Exception {
  f8()
}

fn f10() -> Int with Exception {
  f9()
}

fn f11() -> Int with Exception {
  f10()
}

fn f12() -> Int with Exception {
  f11()
}

fn f13() -> Int with Exception {
  f12()
}

fn f14() -> Int with Exception {
  f13()
}

fn f15() -> Int with Exception {
  f14()
}

fn f16() -> Int with Exception {
  f15()
}

fn f17() -> Int with Exception {
  f16()
}

fn f18() -> Int with Exception {
  f17()
}

fn f19() -> Int with Exception {
  f18()
}

fn f20() -> Int with Exception {
  f19()
}

fn outer() -> Int {
  handle {
    f20()
  } with {
    Exception::Throw(m) => String::length(m)
  }
}
