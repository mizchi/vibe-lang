// #3488 control: a fresh record literal (`Cell::{ v: None }`, whose `None` is a
// constructor, not a binding) passed straight to a keeping helper is fresh.
import @vibe/concurrent { TaskGroup, TaskHandle }

struct Cell {
  mut v: Option[TaskHandle[Int]]
}

struct Wrap {
  cell: Cell
}

fn put(w: Wrap, x: TaskHandle[Int]) -> Unit {
  w.cell.v = Some(x)
}

fn main() -> Unit allows Exception + Console {
  let outer = Cell::{ v: None }
  let r = TaskGroup::run((n) -> {
    put(Wrap::{ cell: Cell::{ v: None } }, TaskGroup::spawn(n, () -> { 41 }))
    1
  })
  println("r=\{r}")
}
