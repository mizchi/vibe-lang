// #3341: a lambda whose own row says `Box[Int]` is not a `Box[String]`
// callback. Function types unify generic row labels by base name (#1340), so
// it was accepted and the callee's handler read the `Int` as a `String`.
effect Box[T] {
  Put(T) -> Int
}

fn run_cb(f: () -> Int with Box[String]) -> Int with Box[String] {
  f()
}

fn own_row_mismatch() -> Int with Box[String] {
  run_cb(() -> Int with Box[Int] { perform Box::Put(3) })
}
