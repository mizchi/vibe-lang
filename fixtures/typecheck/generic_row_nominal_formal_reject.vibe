// #3095: the call requires `State[Box[S]]`. `Box` is a struct, so the caller's
// `with State[S]` names a different type and does not cover it.
effect State[S] {
  Get() -> S
}

fn get[S](x: S) -> Int with State[S] {
  1
}

struct Box[T] {
  v: T
}

fn caller[S](x: S) -> Int with State[S] {
  get(Box::{ v: x })
}
