struct InlineSlot {
  callback: () -> Array[Int]
}

test "inline nominal projection preserves callback provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    ((slot: InlineSlot) -> () -> Array[Int] {
      slot.callback
    })(InlineSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    })
  }
  let _ = escaped()
}
