import ./resolved_mutbytes_support/operations.vibe {
  probe as direct_probe
}
import ./resolved_mutbytes_support/reexport.vibe {
  probe as reexported_probe
}

fn MutBytes::push(a: Int, b: Int) -> Int {
  a - b
}

test "imported and re-exported builtin calls keep their module authority" {
  inspect(direct_probe(), content = "2")
  inspect(reexported_probe(), content = "2")
  inspect(MutBytes::push(7, 20), content = "-13")
}

test "a first-class program function keeps its identity under a builtin spelling" {
  let subtract = MutBytes::push
  inspect(subtract(9, 2), content = "7")
}
