// #716: merge-layer import visibility. Two files export the same name and a
// dep export shadows a builtin; each importing file must get exactly what its
// `import` statements name — not first-match-in-the-function-table roulette.

import ./import_visibility_dep_a.vibe {
  add, pick
}

import ./import_visibility_dep_b.vibe {
  double_pick, pick as pick_b
}

test "same-name exports resolve per import (#716)" {
  assert_eq(pick(), 1)
  assert_eq(pick_b(), 2)
}

test "defining file's own references follow the rename (#716)" {
  assert_eq(double_pick(), 4)
}

test "imported export shadowing a builtin name wins (#716)" {
  assert_eq(add(1, 2), 102)
}
