// #3156 review: the `for` side of err_index_formal_bound_array_refused.vibe.
// The body unified the formal with an Array before the loop, so the iterand
// was taken as a settled Array and filed nothing; the caller above the
// declaration passed a two-entry map and the loop ran zero times (`count`
// answered 0). The loop is refused now.

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::set(Map::new(), "a", 1), "b", 2)
  count(m)
}

fn require_array[E](xs: Array[E]) -> Unit {
  ()
}

fn count[T](c: T) -> Int {
  require_array(c)
  let mut n = 0
  for _x in c {
    n = n + 1
  }
  n
}
