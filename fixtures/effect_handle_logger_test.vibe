// Logger effect: collect log messages via handler

effect Logger {
  Info(String) -> Unit;
  Warn(String) -> Unit
}

test "effect handle logger" {
  let result = handle {
    perform Logger::Info("starting")
    let x = 40 + 2
    perform Logger::Warn("done")
    x
  } with { Logger::Info(_msg) => resume(0); Logger::Warn(_msg) => resume(0) }
  inspect(result, "42")
}
