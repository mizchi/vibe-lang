// #3083: a fully annotated tuple parameter records its type only as its
// equality shape, so an interpolation of it that is not a bare rendering shim
// reached codegen unexpanded, where #2987 refused it ("cannot interpolate
// `t`: ... bind it with a type annotation first") although it already had
// one. The declared type now reaches the renderer.
struct Pt {
  x: Int
} derive (Show)

fn f(t: (Int, String)) -> String {
  "x=\{t}"
}

fn g(t: (Int, Bool)) -> String {
  "g=\{t}"
}

fn h(t: (Int, (Bool, Double), Pt)) -> String {
  "h=\{t}"
}

test "an annotated tuple parameter renders by content" {
  inspect(f((1, "a")), content = "x=(1, a)")
}

test "a Bool position renders as a Bool" {
  inspect(g((2, true)), content = "g=(2, true)")
}

test "nested tuple, Double and a derived struct" {
  inspect(h((3, (false, 1.5), Pt::{ x: 4 })), content = "h=(3, (false, 1.5), Pt { x: 4 })")
}

test "a lambda's annotated tuple parameter" {
  let k = (t: (Int, Bool)) -> String { "k=\{t}" }
  inspect(k((5, false)), content = "k=(5, false)")
}
