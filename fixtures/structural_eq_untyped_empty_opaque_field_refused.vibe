//# ADR-0097 fail-closed: a declared comparator that reaches an opaque nominal
//# field must not be adopted as the inferred element shape of `let xs = []`.
//# `eq_for_typed` has no structural StringBuilder arm, so admitting `Outer`
//# would make separately allocated equal builders compare by identity.

struct Outer {
  b: StringBuilder
} derive (Eq)

fn builder_whole() -> StringBuilder {
  let b = StringBuilder::new()
  StringBuilder::push(b, "same")
  b
}

fn builder_parts() -> StringBuilder {
  let b = StringBuilder::new()
  StringBuilder::push(b, "sa")
  StringBuilder::push(b, "me")
  b
}

export fn _start() -> Int {
  let left = []
  Array::push(left, Outer::{ b: builder_whole() })
  let right = []
  Array::push(right, Outer::{ b: builder_parts() })
  if left == right {
    1
  } else {
    0
  }
}
