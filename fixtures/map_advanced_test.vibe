//# Misc

test "map with many entries" {
  let m = Map::from_pairs([("1", "one"), ("2", "two"), ("3", "three")])
  assert(m["1"] == "one")
  assert(m["2"] == "two")
  assert(m["3"] == "three")
  assert(Map::size(m) == 3)
}

test "map builder pattern" {
  let b = MapBuilder::new()
  MapBuilder::set(b, "a", 1)
  MapBuilder::set(b, "b", 2)
  MapBuilder::set(b, "c", 3)
  let m = MapBuilder::freeze(b)
  assert(m["a"] == 1)
  assert(m["b"] == 2)
  assert(m["c"] == 3)
  assert(Map::size(m) == 3)
}

test "map chain set" {
  let empty: Map[String, Int] = Map::new()
  let m = Map::set(Map::set(Map::set(empty, "x", 10), "y", 20), "z", 30)
  assert(m["x"] == 10)
  assert(m["y"] == 20)
  assert(m["z"] == 30)
}

test "map delete all" {
  let m = Map::from_pairs([("a", 1), ("b", 2)])
  let m2 = Map::delete(Map::delete(m, "a"), "b")
  assert(Map::size(m2) == 0)
}

test "map keys order" {
  let m = Map::from_pairs([("c", 3), ("a", 1), ("b", 2)])
  let ks = Map::keys(m)
  assert(Array::length(ks) == 3)
  assert(Array::any(ks, k -> k == "a"))
  assert(Array::any(ks, k -> k == "b"))
  assert(Array::any(ks, k -> k == "c"))
}

test "map values sum" {
  let m = Map::from_pairs([("a", 10), ("b", 20), ("c", 30)])
  let vs = Map::values(m)
  let sum = Array::fold(vs, 0, (a, b) -> a + b)
  assert(sum == 60)
}

test "map large" {
  let b = MapBuilder::new()
  let mut i = 0
  while i < 50 {
    MapBuilder::set(b, Int::to_string(i), i * i)
    i += 1
  }
  let m = MapBuilder::freeze(b)
  assert(Map::size(m) == 50)
  assert(m["0"] == 0)
  assert(m["7"] == 49)
  assert(m["49"] == 2401)
}

test "map overwrite in builder" {
  let b = MapBuilder::new()
  MapBuilder::set(b, "key", 1)
  MapBuilder::set(b, "key", 2)
  MapBuilder::set(b, "key", 3)
  let m = MapBuilder::freeze(b)
  assert(m["key"] == 3)
  assert(Map::size(m) == 1)
}

test "map has_key after delete" {
  let m = Map::from_pairs([("a", 1), ("b", 2), ("c", 3)])
  let m2 = Map::delete(m, "b")
  assert(Map::has_key(m2, "a"))
  assert(not(Map::has_key(m2, "b")))
  assert(Map::has_key(m2, "c"))
}

test "map single entry" {
  let m = Map::from_pairs([("only", 42)])
  assert(Map::size(m) == 1)
  assert(m["only"] == 42)
  let ks = Map::keys(m)
  assert(ks[0] == "only")
  let vs = Map::values(m)
  assert(vs[0] == 42)
}
