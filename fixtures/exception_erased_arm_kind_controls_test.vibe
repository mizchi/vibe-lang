// #3541 controls: the erased `Exception::Throw(m)` arm reads `m` as the
// thrown message, a `String`, so a body that raises another kind under an arm
// that reads its binder, and a non-`String` throw under the erased
// `with Exception` row, are refused
// (fixtures/typecheck/exception_erased_{arm,row,slot}_*_reject.vibe). What
// stays accepted, with the answers it gives: an erased arm over a body that
// raises only messages, the kinded arm over another kind, an erased arm that
// leaves its payload unread over any kind, and a row naming the kind beside
// the erased label.

fn fail_text() -> Int with Exception[String] {
  throw("boom")
}

fn fail_erased() -> Int with Exception {
  throw("erased boom")
}

fn fail_code() -> Int with Exception[Int] {
  throw(7)
}

/// Both labels: the kinded one carries the `Int`, the erased one the message.
fn fail_either(code: Bool) -> Int with Exception + Exception[Int] {
  if code {
    fail_code()
  } else {
    fail_erased()
  }
}

/// Only messages reach the erased arm, which reads one.
fn read_message() -> String {
  handle {
    let _ = fail_text()
    let _ = fail_erased()
    "none"
  } with { Exception::Throw(m) => String::concat("caught: ", m) }
}

/// The kinded arm binds the `Int` at its own type.
fn read_code() -> Int {
  handle { fail_code() } with { Exception[Int]::Throw(c) => c + 1 }
}

/// An arm that leaves its payload unread catches every kind.
fn ignore_any(code: Bool) -> Int {
  handle { fail_either(code) } with { Exception::Throw(_) => 100 }
}

/// So does one whose binder its body never mentions.
fn ignore_named() -> Int {
  handle { fail_code() } with { Exception::Throw(_unused) => 200 }
}

/// The erased binder rethrown under the erased row, over a message.
fn rethrow_message() -> Int with Exception {
  handle { fail_text() } with { Exception::Throw(m) => throw(m) }
}

test "an erased arm over messages reads the message" {
  inspect(read_message(), "caught: boom")
}

test "a kinded arm reads its kind" {
  inspect(read_code(), "8")
}

test "an unread erased arm catches every kind" {
  inspect(ignore_any(true), "100")
  inspect(ignore_any(false), "100")
  inspect(ignore_named(), "200")
}

test "a rethrown message reaches an outer erased arm as a String" {
  let r = handle {
    let _ = rethrow_message()
    "none"
  } with { Exception::Throw(m) => m }
  inspect(r, "boom")
}

test "a recursive local closure over messages reads the message" {
  let rec count = (n: Int) -> Int with Exception {
    if n > 0 {
      count(n - 1)
    } else {
      throw("done")
    }
  }
  let r = handle {
    count(2)
  } with { Exception::Throw(m) => String::length(m) }
  inspect(r, "4")
}

test "an unread erased arm catches a recursive local closure's kind" {
  let rec count = (n: Int) -> Int with Exception {
    if n > 0 {
      count(n - 1)
    } else {
      throw(7)
    }
  }
  let r = handle {
    count(2)
  } with { Exception::Throw(_) => 100 }
  inspect(r, "100")
}

fn run_cb(f: () -> Int with e) -> Int with e {
  f()
}

test "a message-only literal through a row-variable callback reads the message" {
  let r = handle {
    run_cb(() -> Int with Exception {
      throw("boom")
    })
  } with { Exception::Throw(m) => String::length(m) }
  inspect(r, "4")
}

fn leaks_int() -> Int with Exception {
  throw(7)
}

test "an annotated aggregate whose element row names the kind takes a leaky function" {
  let fs: Array[() -> Int with Exception + Exception[Int]] = [leaks_int]
  let pair: (() -> Int with Exception + Exception[Int], Int) = (leaks_int, 1)
  let opt: Option[() -> Int with Exception + Exception[Int]] = Some(leaks_int)
  let r = handle {
    let f = Array::get(fs, 0)
    f()
  } with { Exception::Throw(_) => 100 }
  let (g, n) = pair
  let s = handle {
    g() + n
  } with { Exception::Throw(_) => 200 }
  let t = match opt {
    Some(h) => handle {
      h()
    } with { Exception::Throw(_) => 300 },
    None => 0
  }
  inspect(r + s + t, "600")
}
