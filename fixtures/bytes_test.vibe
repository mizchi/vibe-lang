//# Misc

test "bytes new and length" {
  let b = Bytes::new()
  assert(Bytes::length(b) == 0)
}

test "bytes push and get" {
  let b = Bytes::new()
  Bytes::push(b, value = 42)
  Bytes::push(b, value = 99)
  assert(Bytes::length(b) == 2)
  assert(Bytes::get(b, at = 0) == 42)
  assert(Bytes::get(b, at = 1) == 99)
}

test "bytes set" {
  let b = Bytes::new()
  Bytes::push(b, value = 0)
  Bytes::push(b, value = 0)
  Bytes::set(b, at = 0, value = 255)
  Bytes::set(b, at = 1, value = 128)
  assert(Bytes::get(b, at = 0) == 255)
  assert(Bytes::get(b, at = 1) == 128)
}

test "bytes slice" {
  let b = Bytes::new()
  Bytes::push(b, value = 10)
  Bytes::push(b, value = 20)
  Bytes::push(b, value = 30)
  Bytes::push(b, value = 40)
  let s = Bytes::slice(b, start = 1, end = 3)
  assert(Bytes::length(s) == 2)
  assert(Bytes::get(s, at = 0) == 20)
  assert(Bytes::get(s, at = 1) == 30)
}

test "bytes concat" {
  let a = Bytes::new()
  Bytes::push(a, value = 1)
  Bytes::push(a, value = 2)
  let b = Bytes::new()
  Bytes::push(b, value = 3)
  Bytes::push(b, value = 4)
  let c = Bytes::concat(a, b)
  assert(Bytes::length(c) == 4)
  assert(Bytes::get(c, at = 0) == 1)
  assert(Bytes::get(c, at = 1) == 2)
  assert(Bytes::get(c, at = 2) == 3)
  assert(Bytes::get(c, at = 3) == 4)
}

test "bytes from array" {
  let arr = [65, 66, 67]
  let b = Bytes::from_array(arr)
  assert(Bytes::length(b) == 3)
  assert(Bytes::get(b, at = 0) == 65)
  assert(Bytes::get(b, at = 1) == 66)
  assert(Bytes::get(b, at = 2) == 67)
}

test "bytes to array" {
  let b = Bytes::new()
  Bytes::push(b, value = 10)
  Bytes::push(b, value = 20)
  Bytes::push(b, value = 30)
  let arr = Bytes::to_array(b)
  assert(Array::length(arr) == 3)
  assert(arr[0] == 10)
  assert(arr[1] == 20)
  assert(arr[2] == 30)
}

test "bytes fill" {
  let b = Bytes::new()
  Bytes::fill(b, value = 0xFF, count = 5)
  assert(Bytes::length(b) == 5)
  assert(Bytes::get(b, at = 0) == 0xFF)
  assert(Bytes::get(b, at = 4) == 0xFF)
}

test "bytes append" {
  let a = Bytes::new()
  Bytes::push(a, value = 1)
  Bytes::push(a, value = 2)
  let b = Bytes::new()
  Bytes::push(b, value = 3)
  Bytes::push(b, value = 4)
  Bytes::append(a, bytes = b)
  assert(Bytes::length(a) == 4)
  assert(Bytes::get(a, at = 2) == 3)
  assert(Bytes::get(a, at = 3) == 4)
}

test "bytes from string" {
  // Bytes::from_string isn't a builtin; build byte-by-byte from char codes
  // (same technique lib/@vibe/builtin/bytes.vibe's `from_ascii` uses).
  let s = "ABC"
  let b = Bytes::new()
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(b, value = String::char_code_at(s, at = i))
    i += 1
  }
  assert(Bytes::length(b) > 0)
}

test "empty bytes" {
  let b = Bytes::new()
  assert(Bytes::length(b) == 0)
}
