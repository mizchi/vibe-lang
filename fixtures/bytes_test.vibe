//# Misc

test "bytes new and length" {
  let b = Bytes::new()
  assert(Bytes::length(b) == 0)
}

test "bytes push and get" {
  let b = Bytes::new()
  Bytes::push(b, 42)
  Bytes::push(b, 99)
  assert(Bytes::length(b) == 2)
  assert(Bytes::get(b, 0) == 42)
  assert(Bytes::get(b, 1) == 99)
}

test "bytes set" {
  let b = Bytes::new()
  Bytes::push(b, 0)
  Bytes::push(b, 0)
  Bytes::set(b, 0, 255)
  Bytes::set(b, 1, 128)
  assert(Bytes::get(b, 0) == 255)
  assert(Bytes::get(b, 1) == 128)
}

test "bytes slice" {
  let b = Bytes::new()
  Bytes::push(b, 10)
  Bytes::push(b, 20)
  Bytes::push(b, 30)
  Bytes::push(b, 40)
  let s = Bytes::slice(b, 1, 3)
  assert(Bytes::length(s) == 2)
  assert(Bytes::get(s, 0) == 20)
  assert(Bytes::get(s, 1) == 30)
}

test "bytes concat" {
  let a = Bytes::new()
  Bytes::push(a, 1)
  Bytes::push(a, 2)
  let b = Bytes::new()
  Bytes::push(b, 3)
  Bytes::push(b, 4)
  let c = Bytes::concat(a, b)
  assert(Bytes::length(c) == 4)
  assert(Bytes::get(c, 0) == 1)
  assert(Bytes::get(c, 1) == 2)
  assert(Bytes::get(c, 2) == 3)
  assert(Bytes::get(c, 3) == 4)
}

test "bytes from array" {
  let arr = [65, 66, 67]
  let b = Bytes::from_array(arr)
  assert(Bytes::length(b) == 3)
  assert(Bytes::get(b, 0) == 65)
  assert(Bytes::get(b, 1) == 66)
  assert(Bytes::get(b, 2) == 67)
}

test "bytes to array" {
  let b = Bytes::new()
  Bytes::push(b, 10)
  Bytes::push(b, 20)
  Bytes::push(b, 30)
  let arr = Bytes::to_array(b)
  assert(Array::length(arr) == 3)
  assert(arr[0] == 10)
  assert(arr[1] == 20)
  assert(arr[2] == 30)
}

test "bytes fill" {
  let b = Bytes::new()
  Bytes::fill(b, 0xFF, 5)
  assert(Bytes::length(b) == 5)
  assert(Bytes::get(b, 0) == 0xFF)
  assert(Bytes::get(b, 4) == 0xFF)
}

test "bytes append" {
  let a = Bytes::new()
  Bytes::push(a, 1)
  Bytes::push(a, 2)
  let b = Bytes::new()
  Bytes::push(b, 3)
  Bytes::push(b, 4)
  Bytes::append(a, b)
  assert(Bytes::length(a) == 4)
  assert(Bytes::get(a, 2) == 3)
  assert(Bytes::get(a, 3) == 4)
}

test "bytes from string" {
  // Bytes::from_string isn't a builtin; build byte-by-byte from char codes
  // (same technique lib/@vibe/builtin/bytes.vibe's `from_ascii` uses).
  let s = "ABC"
  let b = Bytes::new()
  let mut i = 0
  while i < String::length(s) {
    Bytes::push(b, String::char_code_at(s, i))
    i += 1
  }
  assert(Bytes::length(b) > 0)
}

test "empty bytes" {
  let b = Bytes::new()
  assert(Bytes::length(b) == 0)
}
