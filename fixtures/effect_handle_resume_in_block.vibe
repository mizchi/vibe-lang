// resume() inside a block in handler arm
effect Ask {
  Question(String) -> String
}

let result = handle {
  let answer = perform Ask::Question("name?")
  String::length(answer)
} with Ask {
  Question(q, k) => {
    let response = String::concat("Hello, ", q)
    resume(response)
  }
}
result

__DATA__
{"last": "12"}
