// #3163: a function imported under the name `await` is that function, not the
// builtin: its String comes back, so the length is 5. The builtin would hand
// back the future's Int.
import ./dep.vibe {
  my_await as await
}

fn read_it() -> Int with Async {
  let s: String = await(Future::ready(5))
  String::length(s)
}

test "a function imported as await is the import" {
  inspect(read_it(), content = "5")
}
