// Codex on #3059: an entry whose grant is written on its binding annotation
// (`let main: () -> Int with Fs = () -> { .. }`) instead of on the lambda.
// The checker reads the annotation's row as the grant, but the provider read
// only the lambda's row, so the perform got no arm and escaped as a raw wasm
// exception. Compiled and run by tests/gates/late/run.sh; answers 1.
fn exists_via_perform(path: String) -> Bool with Fs {
  perform Fs::Exists(path)
}

let main: () -> Int with Fs = () -> {
  if exists_via_perform("fixtures/host_provider_annotated_entry.vibe") {
    1
  } else {
    0
  }
}
