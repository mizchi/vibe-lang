// Combining Error (throw/catch) with user-defined effect
effect Validator {
  IsValid(String) -> Bool
}

let validate = handle {
  let input = "hello"
  let valid = perform Validator::IsValid(input)
  if valid {
    String::length(input)
  } else {
    throw("invalid input")
    0
  }
} {
  Validator::IsValid(_s) => resume(true),
  Error(_msg) => -1
}
validate

__DATA__
{"error_contains": "Unit"}
