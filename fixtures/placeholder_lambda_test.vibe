//# Misc

test "placeholder single arg" {
  let xs = [1, 2, 3]
  let doubled = Array::map(xs, _ * 2)
  assert(doubled[0] == 2)
  assert(doubled[1] == 4)
  assert(doubled[2] == 6)
}

test "placeholder with add" {
  let xs = [10, 20, 30]
  let inc = Array::map(xs, _ + 1)
  assert(inc[0] == 11)
  assert(inc[1] == 21)
}

test "placeholder two args in fold" {
  let xs = [1, 2, 3, 4]
  let sum = Array::fold(xs, 0, _ + _)
  assert(sum == 10)
}

test "placeholder in filter" {
  let xs = [1, 2, 3, 4, 5, 6]
  let evens = Array::filter(xs, _ % 2 == 0)
  assert(Array::length(evens) == 3)
  assert(evens[0] == 2)
}

test "placeholder in any" {
  let xs = [1, 3, 5, 7]
  assert(Array::any(xs, _ > 5))
  assert(not(Array::any(xs, _ > 10)))
}

test "placeholder in all" {
  let xs = [2, 4, 6]
  assert(Array::all(xs, _ > 0))
  assert(not(Array::all(xs, _ > 3)))
}
