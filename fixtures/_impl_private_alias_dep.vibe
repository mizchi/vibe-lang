// #3958: an impl spelled through a private alias, with no sibling: its key
// is expanded before the merge, and the method it binds still dispatches.
export trait Weight[A] {
  weight(Self) -> A
}

export struct Crate {
  n: Int
}

type Kilos = Int

impl Weight[Kilos] for Crate {
  weight(self) -> Kilos {
    self.n * 2
  }
}

fn weigh[W: Weight[Kilos]](_ w: W) -> Kilos {
  W::weight(w)
}

export fn crate_weight(_ n: Int) -> Int {
  weigh(Crate::{ n: n })
}
