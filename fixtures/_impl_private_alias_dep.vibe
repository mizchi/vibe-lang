// #3958: an impl spelled through a private alias, with no sibling: its key
// is expanded before the merge, and the method it binds still dispatches.
export trait Weight[A] {
  weight(Self) -> A
}

export struct Crate {
  n: Int
}

type Kilos = Int

impl Weight[Kilos] for Crate {
  weight(self) -> Kilos {
    self.n * 2
  }
}

fn weigh[W: Weight[Kilos]](_ w: W) -> Kilos {
  W::weight(w)
}

export fn crate_weight(_ n: Int) -> Int {
  weigh(Crate::{ n: n })
}

// Codex on #3970: a private alias whose body names an exported alias is
// expanded through it in the body's own scope. `Grams` is `Kilos2`, which is
// `Int`; rewritten only one level, the bound of `tag_of` read `Tag[Kilos2]`,
// the function's own parameter `Kilos2` captured it, and the call ran the
// `Tag[String]` impl (15) instead of `Tag[Int]` (10).
export trait Tag[A] {
  tag(Self) -> Int
}

impl Tag[Int] for Crate {
  tag(self) -> Int {
    self.n * 2
  }
}

impl Tag[String] for Crate {
  tag(self) -> Int {
    self.n * 3
  }
}

export type Kilos2 = Int

type Grams = Kilos2

fn tag_of[Kilos2, W: Tag[Grams]](_ t: Kilos2, _ w: W) -> Int {
  let _ = t
  W::tag(w)
}

export fn tagged_weight(_ n: Int) -> Int {
  tag_of("crate", Crate::{ n: n })
}
