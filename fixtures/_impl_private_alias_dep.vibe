import ./_impl_private_alias_defs.vibe {
  Kilos3
}

// #3958: an impl spelled through a private alias, with no sibling. The merge
// renames the private alias per file; the impl's key is renamed with it, so
// the methods bound under the renamed key are still the impl's. On main the
// key kept the old spelling and the impl was refused for a missing body.
export trait Weight[A] {
  weight(Self) -> A
}

export struct Crate {
  n: Int
}

type Kilos = Int

impl Weight[Kilos] for Crate {
  weight(self) -> Kilos {
    self.n * 2
  }
}

fn weigh[W: Weight[Kilos]](_ w: W) -> Kilos {
  W::weight(w)
}

export fn crate_weight(_ n: Int) -> Int {
  weigh(Crate::{ n: n })
}

// Codex on #3970: a private alias whose body names an exported alias is
// expanded through it in the body's own scope. `Grams` is `Kilos2`, which is
// `Int`; rewritten only one level, the bound of `tag_of` read `Tag[Kilos2]`,
// the function's own parameter `Kilos2` captured it, and the call ran the
// `Tag[String]` impl (15) instead of `Tag[Int]` (10).
export trait Tag[A] {
  tag(Self) -> Int
}

impl Tag[Int] for Crate {
  tag(self) -> Int {
    self.n * 2
  }
}

impl Tag[String] for Crate {
  tag(self) -> Int {
    self.n * 3
  }
}

export type Kilos2 = Int

type Grams = Kilos2

fn tag_of[Kilos2, W: Tag[Grams]](_ t: Kilos2, _ w: W) -> Int {
  let _ = t
  W::tag(w)
}

export fn tagged_weight(_ n: Int) -> Int {
  tag_of("crate", Crate::{ n: n })
}

// Codex on #3970, round 2: the same through an IMPORTED alias. `Grams3` is
// `Kilos3` from _impl_private_alias_defs.vibe, which is `Int`; this module's
// declarations cannot see that body, so `Tag[Grams3]` must reach the merged
// program's pass, which can, rather than be rewritten here to `Tag[Kilos3]`
// for `tag_of3`'s own parameter `Kilos3` to capture.
type Grams3 = Kilos3

fn tag_of3[Kilos3, W: Tag[Grams3]](_ t: Kilos3, _ w: W) -> Int {
  let _ = t
  W::tag(w)
}

export fn imported_tagged_weight(_ n: Int) -> Int {
  tag_of3("crate", Crate::{ n: n })
}
