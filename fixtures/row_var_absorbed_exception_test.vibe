// #3016: a row variable's instantiation does not take the labels the
// parameter row already carries concretely. `absorb` handles the `Exception`
// its callback raises, so `main` is charged nothing for `child`'s kind.
fn absorb[e](f: () -> Int with Exception + e) -> Int with e {
  handle {
    f()
  } with { Exception::Throw(_x) => -1 }
}

fn child() -> Int with Exception[String] {
  throw("x")
}

test "absorbed exception is not charged to the caller" {
  inspect(absorb(child), "-1")
}
