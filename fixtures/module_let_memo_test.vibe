// Regression: a module-level non-function `let` initializes ONCE and every
// reference sees the SAME value (matching the gc backend, which initializes
// module globals in _start). The linear lane used to compile these as
// re-evaluating thunks — each reference rebuilt the initializer (an O(size)
// allocation per table access: ~148 B/call for a 16-entry table in
// bench/_probe_sb_phases.vibe) and mutations were silently lost between
// accesses (a cross-backend semantics split).

let table = [10, 20, 30, 40]

let cell = [0]

let lookup: (Int) -> Int = (i) -> {
  Array::get(table, at = i & 3)
}

test "module table reads are stable" {
  assert(lookup(i = 0) == 10)
  assert(lookup(i = 3) == 40)
  let mut i = 0
  let mut acc = 0
  while i < 8 {
    acc = acc + lookup(i = i)
    i = i + 1
  }
  assert(acc == 200)
}

test "module cell mutation is visible across accesses" {
  Array::set(cell, at = 0, value = 41)
  assert(Array::get(cell, at = 0) + 1 == 42)
  Array::set(cell, at = 0, value = Array::get(cell, at = 0) + 1)
  assert(Array::get(cell, at = 0) == 42)
}

test "two references share one identity" {
  let a = table
  let b = table
  Array::set(a, at = 3, value = 99)
  assert(Array::get(b, at = 3) == 99)
  Array::set(a, at = 3, value = 40)
  assert(Array::get(table, at = 3) == 40)
}
