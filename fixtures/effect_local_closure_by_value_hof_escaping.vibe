// #1070 general case — RESOLVED by the type-directed closure evidence
// (ADR-0076 追記34 V1): a capturing effectful local closure referenced
// MORE than once -- once passed by value into a higher-order function's
// closure-typed parameter, and once called directly -- now migrates to
// the evidence path. The row type decides the convention (every row-Ask
// closure value takes __ev_Ask as its leading param program-wide), so
// the same closure value has ONE arity at both use sites and the old
// single-use/universal-call-site proofs are unnecessary. Historically
// this fixture pinned the replay fallback (the last genuine replay
// consumer); the value stays 206 either way, and the M2 side-effect
// dedup that migration brings is pinned separately by
// effect_closure_value_evidence_m2.vibe (gate 54).
//   direct: perform resolves to 1, + captured base (100) == 101
//   viaApply: perform resolves to 5, + captured base (100) == 105
//   total == 206
effect Ask {
  Get -> Int
}

let apply = (f: () -> Int with Ask) -> Int with Ask {
  f()
}

export let main = () -> Int {
  let base = 100
  let inner = () -> Int with Ask {
    perform Ask::Get + base
  }
  let direct = handle {
    inner()
  } with Ask {
    Get => resume(1)
  }
  let via_apply = handle {
    apply(inner)
  } with Ask {
    Get => resume(5)
  }
  direct + via_apply
}

// #1571: the expectation lives here, checked by `inspect` and updatable
// with `vibe test --update`, instead of in a `__DATA__` tail the gate has
// to `sed` off and compare in shell.
test "effect local closure by value hof escaping" {
  inspect(main(), "206")
}
