// #897 (ADR-0070 Phase 1): end-to-end directory-shared vpkg import. Mirrors
// ./contract_pkg_vpkg_test.vibe's shape, but exercises the OTHER half of
// ADR-0070's two import forms: `index.vpkg`'s `import @vibe/random { seed }`
// registers `seed` into the package directory's SHARED scope, so sibling
// impl files (impl.vibe, shadow_impl.vibe) can use it directly without their
// own import line. This compiles through the ordinary #716 merge machinery
// same as any other vpkg package, so it exercises the whole-program merge
// lane; `vibe test`'s incremental per-file typecheck lane is exercised by
// the same run (both lanes must resolve `seed` for this file to compile at
// all).

import ./contract_pkg_vpkg_shared_scope { wrapped_seed, shadow_seed }

test "directory-shared vpkg import: sibling uses @vibe/random without its own import (#897)" {
  // @vibe/random's seed(0) == 1 (0 normalizes to 1) -- a distinctive value
  // that only comes out right if `wrapped_seed` really called the REAL
  // @vibe/random `seed`, not some accidental identity/no-op.
  assert_eq(wrapped_seed(0), 1)
  assert_eq(wrapped_seed(42), 42)
}

test "directory-shared vpkg import: sibling's own local shadows the inherited import (#897)" {
  assert_eq(shadow_seed(5), 1005)
}
