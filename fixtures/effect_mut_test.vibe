// ADR-0021 Phase 1 demo: mutability expressed as a tail-resumptive
// effect handler. The user code only emits `perform` calls; the actual
// mutable state lives in an `ArrayBuilder` that the surrounding handler
// arms close over. The handler arms are tail-resumptive (each arm ends
// in `resume(...)`) so the compiler can inline-eliminate the indirection.
//
// Note the effects declared below are `Push` and `State`, declared here like
// any user effect. There is no builtin `Mut` effect -- ADR-0021's `effect
// Mut<T>` spelling was never implemented, and the mechanism this demonstrates
// is ADR-0050's.

//# Effects

effect Push {
  Push(Int) -> Unit
  Build() -> Array[Int]
}

effect State {
  Get() -> Int
  Put(Int) -> Unit
}

//# Misc

test "Mut-as-effect: Push handler accumulates into an ArrayBuilder" {
  // The handler captures a fresh ArrayBuilder; perform Push::Push(v)
  // appends, perform Push::Build() materialises and returns.
  let result = {
    let buf = ArrayBuilder::new()
    handle {
      let _ = perform Push::Push(1)
      let _ = perform Push::Push(2)
      let _ = perform Push::Push(3)
      perform Push::Build()
    } with {
      Push::Push(v) => { ArrayBuilder::push(buf, v); resume(()) };
      Push::Build() => resume(ArrayBuilder::freeze(buf))
    }
  }
  assert(Array::length(result) == 3)
  assert(Array::get(result, 0) == 1)
  assert(Array::get(result, 1) == 2)
  assert(Array::get(result, 2) == 3)
}

test "Mut-as-effect: fold accumulating across many performs" {
  let total = {
    let mut sum = 0
    handle {
      let _ = perform Push::Push(10)
      let _ = perform Push::Push(20)
      let _ = perform Push::Push(30)
      perform Push::Build()
      sum
    } with {
      Push::Push(v) => { sum = sum + v; resume(()) };
      Push::Build() => resume([])
    }
  }
  assert(total == 60)
}

test "Mut-as-effect: Get/Put state via outer let mut" {
  // Classic State[Int] handler: Get returns the current value, Put
  // updates it. The mutable cell `cell` lives outside the handle so the
  // handler arms can close over it.
  let final_value = {
    let mut cell = 0
    handle {
      let _ = perform State::Put(10)
      let a = perform State::Get()
      let _ = perform State::Put(a + 5)
      perform State::Get()
    } with {
      State::Get() => resume(cell);
      State::Put(n) => { cell = n; resume(()) }
    }
  }
  assert(final_value == 15)
}
