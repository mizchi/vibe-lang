// #4065: a `let mut` reassigned inside a `while` to the handle-bound closure
// read out of an array, then handed to a row-free parameter on the next pass.
// The assignment outlives its statement, so the next pass reads the closure
// at its evidence arity, which is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let mut f = () -> 7
    let mut n = 0
    let mut total = 0
    while n < 2 {
      if n > 0 {
        total = apply(f = f)
      }
      f = Array::get([g], at = 0)
      n = n + 1
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
