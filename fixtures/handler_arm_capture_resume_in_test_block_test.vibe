// #3009: a test block whose handler captures `resume` as a value compiles
// on the wasm-gc lane too (the gc module compile now runs the suspend pass).
effect Ask {
  Other() -> Int
}

test "captured continuation performed inside a test block, one op" {
  let r = handle {
    let n = perform Ask::Other()
    n + 1
  } with {
    Ask::Other() => {
      let k = resume
      k(3)
    }
  }
  assert_eq(r, 4)
}
