import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api as X
}
import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api as Y
}

test "two facade aliases name the same private constructor" {
  inspect(match X::A {
    X::A => 1,
    X::B => 2
  }, content = "1")
  inspect(match Y::B {
    Y::A => 1,
    Y::B => 2
  }, content = "2")
}
