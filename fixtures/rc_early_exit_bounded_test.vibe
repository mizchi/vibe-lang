// #3141: an early exit keeps the RC heap frontier bounded.
//
// `return`, `break`, `continue` and `throw` transfer control past the
// scope-end drops of every scope they leave, so each binding in those scopes
// leaked on every call that took the exit: a heap binding the early path
// never consumed, the references a binding kept for uses after the exit (its
// dup budget), a loop body's binding on `break` / `continue`, a function's
// bindings on a `throw` into its caller's handle or into a handle of its own,
// bindings of nested scopes, and a captured `let mut` cell with its closure.
// Measured on a stage2 built from main at a3ad813eb, each exit form leaked
// linearly (112 B per call for most shapes, 40 B for the cell); those shapes
// alone grew __heap_ptr by 1,872,288 B over the 2000 rounds. With the
// release, 440 B. The gate compiles it under VIBE_RC=1 and bounds the growth
// (tests/gates/mid/run.sh, 40f0h); the same gate checks the answer on the
// bump, rc, shadow and gc lanes, and the shadow lane traps on the drop of a
// freed block. What each exit still hands out, and what it must not release,
// is pinned by fixtures/rc_early_exit_release_test.vibe.
//
// The rounds also take a `let mut` no closure captures -- unassigned (with
// and without a dup budget), stored before the exit, stored after it, stored
// in the loop the exit leaves, and declared in a loop body a `break` leaves
// -- and a parameterized loop, whose `break v` and `continue(a)` are stores
// followed by the exit (#3181 review). With them the fixture grows
// 3,888,084 B on a stage2 from main at 6646ccbfb (no exit releases
// anything), 1,344,212 B when every exit releases what it leaves except a
// `let mut`, and 440 B after #3181.
//
// #3168 / #3175 add a parameterized loop whose value is discarded
// (loop_discard: its result slot held the `break d` value and nothing
// released it), a `break d` of the body binding after `continue`s
// (loop_brk_body: the `continue` left `d`, consumed on the `break` path
// only, unreleased) and a `break` storing a borrowed element whose array
// outlives the loop (loop_borrow: the slot did not retain it, and the
// consumer released the array's element). On a stage2 from main at
// a81ffcb2e the fixture traps in loop_borrow on the default, rc and shadow
// lanes; without loop_borrow it grows 1,120,244 B there. Now 472 B.
//
// `main` sums, per round i: 1 each from ret_guard, ret_budget, ret_pick, brk,
// thr, thr_local, mut_guard, mut_budget, mut_store_before, mut_store_after,
// mut_store_in_loop, mut_brk, mut_record, ret_map, loop_exit, loop_discard,
// loop_brk_body and loop_borrow, 2 from cont, 5 from nested, and i from
// ret_cell:
// 2000 * (18 + 2 + 5) + 1999 * 2000 / 2 = 2049000.

enum D {
  A(Array[Int])
}

struct Rec {
  xs: Array[Int]
}

fn second(d: D) -> Int {
  match d {
    A(xs) => Array::get(xs, 1)
  }
}

fn keep(d: D) -> D {
  d
}

// A binding the early path never consumes.
fn ret_guard(n: Int) -> Int {
  let d = A([n, 1])
  if n >= 0 {
    return 1
  }
  second(d)
}

// A binding consumed twice after the guard: the early path also holds the
// reference kept for the second use.
fn ret_budget(n: Int) -> Int {
  let d = A([n, 1])
  if n >= 0 {
    return 1
  }
  let e = keep(d)
  second(e) + second(keep(d))
}

// One binding handed out, the other left behind.
fn ret_pick(n: Int) -> D {
  let d = A([n, 1])
  let e = A([n, 1])
  if n >= 0 {
    return d
  }
  e
}

fn brk(n: Int) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let d = A([i + n, 1])
    if i == 1 {
      break
    }
    acc = acc + second(d)
    i = i + 1
  }
  acc
}

fn cont(n: Int) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    i = i + 1
    let d = A([i + n, 1])
    if i == 2 {
      continue
    }
    acc = acc + second(d)
  }
  acc
}

fn thrower(n: Int) -> Int with Exception {
  let d = A([n, 1])
  if n >= 0 {
    throw("stop")
  }
  second(d)
}

fn thr(n: Int) -> Int {
  handle { thrower(n) } with { Exception::Throw(_) => 1 }
}

fn thr_local(n: Int) -> Int {
  handle {
    let d = A([n, 1])
    if n >= 0 {
      throw("stop")
    }
    second(d)
  } with { Exception::Throw(_) => 1 }
}

// Nested scopes: a return from a block inside a loop body leaves the block,
// the loop body and the function.
fn nested(n: Int) -> Int {
  let a = A([n, 1])
  let mut i = 0
  while i < 3 {
    let b = A([i, 2])
    if i == 1 {
      let c = A([i, 3])
      return second(b) + second(c)
    }
    i = i + 1
  }
  second(a)
}

// The #3141 report's own shape: a captured cell returned early.
fn ret_cell(c: Bool, n: Int) -> D {
  let mut d = A([n, n])
  let f = () -> Int { second(d) }
  let _ = f()
  if c {
    return d
  }
  A([0, 1])
}

// A `let mut` no closure captures: the exit releases what the slot holds
// when it is taken.
fn mut_guard(n: Int) -> Int {
  let mut d = A([n, 1])
  if n >= 0 {
    return 1
  }
  second(d)
}

// With a dup budget and no store, the slot holds both references on the
// early path, as a `let` does, and releases both.
fn mut_budget(n: Int) -> Int {
  let mut d = A([n, 1])
  if n >= 0 {
    return 1
  }
  let e = keep(d)
  second(e) + second(keep(d))
}

fn mut_store_before(n: Int) -> Int {
  let mut d = A([n, 1])
  d = A([n, 2])
  if n >= 0 {
    return 1
  }
  second(d)
}

fn mut_store_after(n: Int) -> Int {
  let mut d = A([n, 1])
  if n >= 0 {
    return 1
  }
  d = A([n, 2])
  second(d)
}

fn mut_store_in_loop(n: Int) -> Int {
  let mut d = A([n, 1])
  let mut i = 0
  while i < 3 {
    d = A([i, n])
    if i == 1 {
      return i
    }
    i = i + 1
  }
  second(d)
}

fn mut_brk(n: Int) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut d = A([i + n, 1])
    d = A([i + n, 1])
    if i == 1 {
      break
    }
    acc = acc + second(d)
    i = i + 1
  }
  acc
}

// `break v` is `__loop_result = v; break` and `continue(a)` assigns the
// loop's parameter before it jumps: both release the body's binding.
// #3181 review: a `let mut` initialized from a struct literal, left by an
// early exit before any store.
fn mut_record(n: Int) -> Int {
  let mut r = Rec::{ xs: [n, 1] }
  if n >= 0 {
    return 1
  }
  Array::length(r.xs)
}

// #3181 review: an exit handing out a map literal still releases the other
// bindings it leaves.
fn ret_map(n: Int) -> Int {
  let d = A([n, 1])
  if n >= 0 {
    return Map::size(mk_map(n))
  }
  second(d)
}

fn mk_map(n: Int) -> StringMap[Int] {
  let d = A([n, 2])
  if n >= 0 {
    return Map::from_pairs([("k", n)])
  }
  Map::set(Map::new(), "j", second(d))
}

fn loop_exit(n: Int) -> Int {
  loop (i = 0) {
    let d = A([i + n, 1])
    if i == 2 {
      break i - 1
    }
    continue(i + 1)
  }
}

// #3168: a parameterized loop whose value is discarded. Its `break d`
// stores `d` in the loop's result slot, which the scope end now releases.
fn loop_discard(n: Int) -> Int {
  loop (i = 0) {
    let d = A([i + n, 1])
    if i == 2 {
      break d
    }
    continue(i + 1)
  }
  1
}

// #3175: `break d` consumes the body binding on one path only, and the
// earlier iterations' `continue` leaves it on the other; the `continue`
// releases it under the binding's path flag.
fn loop_brk_body(n: Int) -> Int {
  let r = loop (i = 0) {
    let d = A([i + n, 1])
    if i == 2 {
      break d
    }
    continue(i + 1)
  }
  second(r)
}

// #3168: a `break` storing a borrowed element; the slot retains it, and the
// array outlives the loop.
fn loop_borrow(n: Int) -> Int {
  let ds = [A([n, 3]), A([n, 1])]
  let r = loop (i = 0) {
    if i == 1 {
      break Array::get(ds, 1)
    }
    continue(i + 1)
  }
  second(r) + second(Array::get(ds, 1)) - 1
}

fn round(i: Int) -> Int {
  let mixed = ret_guard(i) + ret_budget(i) + second(ret_pick(i)) + brk(i) + cont(i) + thr(i) + thr_local(i) + nested(i) + second(ret_cell(i >= 0, i))
  let muts = mut_guard(i) + mut_budget(i) + mut_store_before(i) + mut_store_after(i) + mut_store_in_loop(i) + mut_brk(i) + mut_record(i) + ret_map(i) + loop_exit(i)
  let loops = loop_discard(i) + loop_brk_body(i) + loop_borrow(i)
  mixed + muts + loops
}

export fn main() -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 2000 {
    acc = acc + round(i)
    i = i + 1
  }
  acc
}
