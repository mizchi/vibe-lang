// A labeled call reorders its arguments, and one argument reassigns a `let mut`
// lambda that another argument calls. The arguments run in written order, so
// `b = ..` swaps `g` before `a = g(3, 10)` runs, and that call reaches the
// lambda the binding then holds: y = 3, x = 10, answering 7 (Codex on #3666).
// A call through the lambda is positional (ADR-0120 Phase 4b).
fn f(a: Int, b: Int) -> Int {
  a + b
}

test "a reassignment in an earlier-written argument is the lambda a later one calls" {
  let mut g = (x: Int, y: Int) -> Int { x - y }
  let r = f(b = {
    g = (y: Int, x: Int) -> Int { x - y }
    0
  }, a = g(3, 10))
  inspect(r, content = "7")
}

test "a local of the same name inside an argument is not the outer lambda" {
  let mut g = (x: Int, y: Int) -> Int { x - y }
  let first = g(10, 3)
  let r = f(b = {
    let mut g = 0
    g = 1
    g
  }, a = 0)
  inspect(first, content = "7")
  inspect(r, content = "1")
}
