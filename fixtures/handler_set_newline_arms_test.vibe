// #2981: handler-set arms may be separated by a newline, like `match` arms.
// They had to be `;`-separated, and the newline form failed with an unlocated
// `expected ';' or '}' in handler set`.
effect State[S] {
  Get() -> S;
  Put(v: S) -> Unit
}

fn counter() -> Int with State[Int] {
  perform State::Get() + 1
}

test "newline-separated handler arms" {
  let s = handle {
    counter()
  } with {
    State::Get() => 41
    State::Put(_v) => ()
  }
  inspect(s, "42")
}
