// #3735: `xs[a: b]`, `xs[a:]` and `xs[i]` on an Array that reaches the
// operator through a typed parameter take the runtime three-way dispatch
// (`__slice` / `__len` / `__index`): a String is a `(ptr << 32) | len`
// immediate, and a pointer's first header word tells Bytes (a negated
// capacity, high bit set) from an Array (a capacity).
//
// On the RC lane an Array value is `block + 8 | 1`, and the dispatch read that
// header word at the odd address: one byte in, so its top byte was the low
// byte of the Array's LENGTH. Whenever that byte was 128 or more the Array
// read as Bytes and went to the Bytes builtin, which trapped with `memory
// access out of bounds` in `__rt_bytes_get` -- at 128..255 elements, 1000 and
// 5000, but not at 600 (0x258). The lengths below straddle those edges, and
// every answer is compared against `Array::slice` / `Array::get`, which never
// took the dispatch.

fn copy_range(xs: Array[String]) -> Array[String] {
  xs[0: Array::length(xs)]
}

fn open_tail(xs: Array[String]) -> Array[String] {
  xs[1:]
}

fn element(xs: Array[String], i: Int) -> String {
  xs[i]
}

fn ints_mid(xs: Array[Int]) -> Array[Int] {
  xs[2: Array::length(xs) - 1]
}

fn bytes_range(b: Bytes) -> Bytes {
  b[1: 3]
}

fn string_range(s: String) -> String {
  s[1: 3]
}

fn strings_of(_ n: Int) -> Array[String] {
  let xs: Array[String] = []
  let mut i = 0
  while i < n {
    Array::push(xs, value = "v\{i}")
    i = i + 1
  }
  xs
}

fn ints_of(_ n: Int) -> Array[Int] {
  let xs: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(xs, value = i * 3)
    i = i + 1
  }
  xs
}

// The number of lengths in `sizes` at which every syntax form agrees with
// the Array builtin, element by element.
fn agreeing(sizes: Array[Int]) -> Int {
  let mut ok = 0
  for n in sizes {
    let xs = strings_of(n)
    let full = copy_range(xs = xs)
    let tail = open_tail(xs = xs)
    let ys = ints_of(n)
    let mid = ints_mid(xs = ys)
    let same = full == Array::slice(xs, start = 0, end = n) && tail == Array::slice(xs, start = 1, end = n) && element(xs = xs, i = n - 1) == Array::get(xs, at = n - 1) && mid == Array::slice(ys, start = 2, end = n - 1)
    if same {
      ok = ok + 1
    } else {
      ()
    }
  }
  ok
}

test "range and index syntax on an Array agree with the Array builtins at every length" {
  let sizes = [4, 127, 128, 129, 200, 255, 256, 383, 384, 600, 1000, 5000]
  inspect(agreeing(sizes = sizes), content = "12")
}

test "Bytes and String operands keep their own dispatch" {
  let b = Bytes::new()
  for c in [97, 98, 99, 100, 101, 102] {
    Bytes::push(b, value = c)
  }
  inspect(Bytes::length(bytes_range(b = b)), content = "2")
  inspect(Bytes::get(bytes_range(b = b), at = 0), content = "98")
  inspect(string_range(s = "abcdef"), content = "bc")
}
