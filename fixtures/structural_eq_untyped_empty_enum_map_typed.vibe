//# Codex round 5 on #2456: a program may own the `Map` spelling with an ENUM.
//# A generic enum has no per-instantiation comparator (only generic structs
//# do, #2195); its derived `Map::equals` compares a formal-typed payload with
//# the raw word `==`, which is content equality only for word-sized scalars.
//# With such arguments the declared comparator answers by content.

enum Map[K, V] {
  Entry(K, V)
}

fn fill(xs: Array[Map[String, Int]], v: Int) -> Unit {
  Array::push(xs, Entry("k", v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  assert(left == right)
  assert(left != other)
  0
}
