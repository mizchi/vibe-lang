// ADR-0076 (#817) Phase 3 regression lock: a function whose declared
// effect row contains MULTIPLE effects (here `{ Ask, Fs }`), discharged
// by two separate, nested handle sites reached through an intermediate
// wrapper function (`ask_only_wrapper`'s own body IS a `handle ... with
// Ask {...}`, so from `compute`'s `handle ... with Fs {...}` outward, this
// is a directly-nested handle pair split across a function boundary).
//
// evidence_dict_pass.vibe's `needing` restriction originally required a
// row to be EXACTLY one effect name (edp_row_is_exactly). A relaxation to
// row CONTAINMENT (any row with `ename` as one of several comma-joined
// labels) was tried and reverted TWICE before being root-caused and
// shipped for real (2026-07-23, see edp_row_is_exactly's doc comment):
// the crash this fixture used to pin was never actually about
// multi-effect rows -- it was an unrelated rewrite-coverage bug
// (edp_rewrite_needing_body silently skipping `let`-bound performs) that
// this exact fixture happened to trigger because `both_helper` binds both
// its performs via `let`.
//
// At first, with that bug fixed, only `Ask` migrated: `Fs` was still
// rejected because `ask_only_wrapper` (needing `Fs`) has a body that is
// directly `handle {...} with Ask {...}`, an `EHandle` node
// edp_has_unsafe_construct unconditionally rejected at the time. That
// same day, edp_has_unsafe_construct was extended to recurse into a
// nested handle for a DIFFERENT effect instead of rejecting it outright
// (see that function's doc comment) -- which applies to exactly this
// shape. `Fs` now ALSO migrates: verified via the same migration-plan
// probe technique (both plans genuinely produced and applied, not merely
// "doesn't crash").
//
// With BOTH effects migrated, `both_helper`'s `Ask::Get` AND `Fs::Read`
// both run through their evidence dicts -- no replay/frontier machinery
// at all for either effect anymore, so `compute`'s handled body runs
// EXACTLY ONCE (no redundant re-execution from either effect's replay
// loop). The expected value therefore CHANGED from 3018 (the replay-
// inflated value: `Fs`'s old handler body replayed an extra time each
// pass, incrementing `count` beyond what a single logical execution
// would) to 2017 (count == 2, one increment per statement, each running
// exactly once; r == 15 + 2 == 17; main() == 2 * 1000 + 17 == 2017) --
// this fixture is now a regression lock on BOTH effects of a nested-
// handle-plus-multi-effect-row function migrating correctly, not merely
// on containment being safe.
effect Ask {
  Get -> Int
}

effect Fs {
  Read -> Int
}

let both_helper = () -> Int with Ask + Fs {
  let a = perform Ask::Get
  let b = perform Fs::Read
  a + b
}

let ask_only_wrapper = () -> Int with Fs {
  handle {
    both_helper()
  } with {
    Ask::Get => resume(5)
  }
}

let compute = () -> (Int, Int) {
  let mut count = 0
  let r = handle {
    count = count + 1
    let v = ask_only_wrapper()
    count = count + 1
    v + count
  } with {
    Fs::Read => resume(10)
  }
  (count, r)
}

export let main = () -> Int {
  let (count, r) = compute()
  count * 1000 + r
}

// #1571: the expectation lives here, checked by `inspect` and updatable
// with `vibe test --update`, instead of in a `__DATA__` tail the gate has
// to `sed` off and compare in shell.
test "effect handle multi effect row nested" {
  inspect(main(), "2017")
}
