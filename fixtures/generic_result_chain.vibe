let safe_div = (a: Int, b: Int) -> Option[Int] {
  if b == 0 { None } else { Some(a / b) }
}
let chain = (opt: Option[Int], f: (Int) -> Option[Int]) -> Option[Int] {
  match opt {
    Some(v) => f(v),
    None => None
  }
}
let result = chain(safe_div(100, 5), (x) -> safe_div(x, 2))
match result {
  Some(v) => v,
  None => -1
}

