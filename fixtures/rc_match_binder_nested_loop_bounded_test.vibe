// #3191: a match binder stored by a loop nested in its arm must not leak
// the reference the store acquires. Both the stored value and the binder
// remain readable after the loop.
fn one_round(n: Int) -> Int {
  match Some([n, n + 1]) {
    Some(p) => {
      let mut cur = [0, 0]
      let mut i = 0
      while i < 3 {
        cur = p
        i = i + 1
      }
      Array::get(cur, 1) + Array::get(p, 1)
    },
    None => 0
  }
}

export fn main() -> Int {
  let mut i = 0
  let mut total = 0
  while i < 2000 {
    total = total + one_round(i)
    i = i + 1
  }
  total
}
