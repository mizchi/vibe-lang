// #1536 (a) v8: a compound binary condition in sequence-head position. The
// suspension is named, the comparison then runs on the name, and the sequence
// tail after the `if` runs once -- for one branch only.
effect Ask {
  Get(Int) -> Int
}

let visits = [
  0
]
let tails = [
  0
]

let _start = () -> Int {
  handle {
    let mut got = 0
    if perform Ask::Get(1) > 0 {
      got = 10
    } else {
      got = 20
    }
    Array::set(tails, 0, Array::get(tails, 0) + 1)
    got * 100 + Array::get(visits, 0) * 10 + Array::get(tails, 0)
  } with Ask {
    Get(n) => {
      Array::set(visits, 0, Array::get(visits, 0) + 1)
      let k = resume
      k(n)
    }
  }
}
_start()

__DATA__
{
  "last": "1011"
}
