// RC guard (#4153, #4200): one result path reads into a local, the other
// hands back a parameter the caller keeps using. The local path never reads
// that parameter, so the callee must release the unused argument
// there. The parameter path moves the reference into the result instead.
// The probes read the result and the caller's parameter after allocating
// another array. The gate also bounds the heap on RC and shadow.
fn mka(_ i: Int) -> Array[Int] {
  [i, i + 1, i + 2]
}

fn mixed_param_tail(_ p: Array[Int], _ i: Int) -> Array[Int] {
  let v = [mka(i), mka(i + 2)]
  if i % 2 == 0 {
    Array::get(v, at = 1)
  } else {
    p
  }
}

enum Slot {
  Full(Array[Int]);
  Empty
}

fn mixed_param_match(_ p: Array[Int], _ i: Int) -> Array[Int] {
  let slot = if i % 2 == 0 {
    Full(mka(i))
  } else {
    Empty
  }
  match slot {
    Full(value) => value,
    Empty => p
  }
}

struct Outer {
  items: Array[Array[Int]]
}

fn consume_outer(_ xs: Array[Array[Int]]) -> Int {
  let held = Outer::{ items: xs }
  Array::get(Array::get(held.items, at = 0), at = 0)
}

fn retained_param_view(_ xs: Array[Array[Int]], _ take: Bool) -> Array[Int] {
  if take {
    [consume_outer(xs)]
  } else {
    Array::get(xs, at = 0)
  }
}

fn probe(_ i: Int) -> Int {
  let p = mka(i + 4)
  let x = mixed_param_tail(p, i)
  let y = mixed_param_match(p, i)
  let z = retained_param_view([mka(i)], i % 2 == 0)
  let fresh = [mka(i + 7), mka(i + 9), mka(i + 11)]
  // Even calls return local payloads. Odd calls return the parameter twice.
  let k = if i % 2 == 0 {
    0
  } else {
    2
  }
  (Array::get(x, at = 0) - i - 2 - k) +
  (Array::get(y, at = 0) - i - 2 * k) +
  (Array::get(p, at = 0) - i - 4) + (Array::get(z, at = 0) - i) + Array::length(fresh) - 3
}

fn main() -> Int {
  let mut acc = 0
  let mut i = 0
  while i < 2000 {
    acc = acc + probe(i)
    i = i + 1
  }
  acc
}

test "a local path and a parameter path release the parameter once (#4153)" {
  inspect(probe(4), content = "0")
  inspect(probe(5), content = "0")
  inspect(main(), content = "0")
}
