// #2991: an optional (`b?: T`) or labeled (`b~: T`) parameter renders exactly
// like the same parameter declared without the marker. The parser declares a
// `?` parameter `Option[T]`, but the marker stays on the parameter NAME, and
// the interpolation pass recorded the type under that marked spelling -- so
// `\{b}` found no type for `b` and printed an allocation address (`256`,
// `304`) while `match b` in the same body saw `Some(1)` / `None`.

struct Pt {
  x: Int
} derive (Show)

fn k(b: Option[Int]) -> String {
  "annotated \{b}"
}

fn k2(b?: Int) -> String {
  "optional \{b}"
}

fn k3(b?: Int) -> String {
  let x = b
  "via let \{x}"
}

fn ks(s?: String) -> String {
  "s=\{s}"
}

fn kp(p?: Pt) -> String {
  "p=\{p}"
}

fn kl(b~: Option[Int]) -> String {
  "labeled \{b}"
}

test "an optional Int parameter renders as the Option it is declared" {
  inspect(k(Some(1)), "annotated Some(1)")
  inspect(k2(1), "optional Some(1)")
  inspect(k2(), "optional None")
  inspect(k3(1), "via let Some(1)")
  inspect(k3(), "via let None")
}

test "optional String and struct parameters render by content" {
  inspect(ks("hi"), "s=Some(hi)")
  inspect(ks(), "s=None")
  inspect(kp(Pt::{ x: 3 }), "p=Some(Pt { x: 3 })")
  inspect(kp(), "p=None")
}

test "a labeled parameter renders under its unmarked name" {
  inspect(kl(b = Some(2)), "labeled Some(2)")
  inspect(kl(b = None), "labeled None")
}
