struct MultiPayloadSlot {
  callback: () -> Array[Int]
}

enum MultiPayloadWrapper[A, B] {
  MultiPayloadPair(A, B)
}

fn multi_payload_pack[A, B](first: A, second: B) -> MultiPayloadWrapper[A, B] {
  MultiPayloadPair(first, second)
}

test "constructor helpers preserve every payload dependency" {
  let escaped = region r {
    let values = MutList::empty(r)
    multi_payload_pack(MultiPayloadSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, 0)
  }
  let MultiPayloadPair(slot, _) = escaped
  let _ = slot.callback()
}
