// #3547: a `derive (Show)` generic type with an `Array[T]` field of its own
// type parameter. The derived renderer is one function for every
// instantiation, so the array's elements have no renderer there. The build
// was refused while the generated array helper was rewritten, in the
// compiler's own spelling (`pass an explicit renderer '(__Vfp_T) -> String'
// ... [@fn=__arr_to_string____Vfp_T]`), naming neither the type nor the
// field -- even with the type unused, as here. The refusal now names the
// type, the field and the edit.
struct G[T] {
  w: Array[T]
} derive (Show)

export let _start: () -> Int = () -> {
  0
}
