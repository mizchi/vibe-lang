//# #3297: the edit the `err_eq_derived_generic_*_refused.vibe` and
//# `err_eq_formal_payload_refused.vibe` refusals name, applied. With the
//# bindings annotated, the comparison knows its complete type and compares
//# the formal-typed field or payload through the function's `Eq` witness, so
//# equal `derive (Eq)` values answer `true` and different ones `false`.

enum Res[T, E] {
  Ok(T);
  Err(E)
}

enum Wr[T, E] {
  Good(T);
  Bad(E)
}

struct Box[T] {
  v: T
} derive (Eq)

struct Pt {
  x: Int;
  tags: Array[Int]
} derive (Eq)

fn same_err[T: Eq](x: T, y: T) -> Bool {
  let a: Res[Int, T] = Err(x)
  let b: Res[Int, T] = Err(y)
  a == b
}

fn same_bad[T: Eq](x: T, y: T) -> Bool {
  let a: Wr[Int, T] = Bad(x)
  let b: Wr[Int, T] = Bad(y)
  a == b
}

fn same_box[T: Eq](x: T, y: T) -> Bool {
  let a: Box[T] = Box::{ v: x }
  let b: Box[T] = Box::{ v: y }
  a == b
}

test "an Ok / Err payload" {
  inspect(same_err(x = Pt::{ x: 1, tags: [1] }, y = Pt::{ x: 1, tags: [1] }), "true")
  inspect(same_err(x = Pt::{ x: 1, tags: [1] }, y = Pt::{ x: 1, tags: [2] }), "false")
  inspect(same_err(x = 1.5, y = 1.5), "true")
  inspect(same_err(x = 1.5, y = 2.5), "false")
}

test "a generic enum payload" {
  inspect(same_bad(x = Pt::{ x: 1, tags: [1] }, y = Pt::{ x: 1, tags: [1] }), "true")
  inspect(same_bad(x = Pt::{ x: 1, tags: [1] }, y = Pt::{ x: 1, tags: [2] }), "false")
}

test "a generic struct field" {
  inspect(same_box(x = Pt::{ x: 1, tags: [1] }, y = Pt::{ x: 1, tags: [1] }), "true")
  inspect(same_box(x = Pt::{ x: 1, tags: [1] }, y = Pt::{ x: 1, tags: [2] }), "false")
}
