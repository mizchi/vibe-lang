enum EnumAssignmentBox { EnumAssignmentHold(() -> Array[Int]) }

fn build_enum_outer_assignment() -> Int {
  let mut escaped = EnumAssignmentBox::EnumAssignmentHold(() -> Array[Int] {
    []
  })
  region r {
    let values = MutList::empty(r)
    escaped = EnumAssignmentBox::EnumAssignmentHold(() -> Array[Int] {
      MutList::to_array(values)
    })
    0
  }
}
