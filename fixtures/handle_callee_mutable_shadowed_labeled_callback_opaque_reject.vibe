effect Ask { Get() -> Int }

fn ask_once() -> Int with Ask { perform Ask::Get() }
fn pure() -> Int { 7 }

fn run() -> Int with Ask {
  handle {
    let cb = (ask_once~: () -> Int) -> Int {
      let mut f = ask_once
      f()
    }
    let _ = cb(ask_once = pure)
    perform Ask::Get()
  } with { Ask::Get() => resume(1) }
}

export fn main() -> Int {
  handle { run() } with { Ask::Get() => resume(2) }
}
