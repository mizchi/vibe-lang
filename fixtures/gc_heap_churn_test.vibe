// Current wasm-gc-lane allocation characterization. The gc backend still
// stores user aggregates in guest linear memory; this deliberately discards
// a fresh aggregate on every iteration so the runner can observe its bump
// high-water mark. It does NOT claim Wasmtime tracing-GC liveness.

let churn: (Int) -> Int = (n) -> {
  let mut i = 0
  let mut sum = 0
  while i < n {
    let values = [
      i,
      i + 1,
      i + 2,
      i + 3
    ]
    sum = sum + Array::get(values, 0) + Array::get(values, 3)
    i = i + 1
  }
  sum
}

test "gc lane: discarded aggregate churn remains semantically correct" {
  assert(churn(8192) == 67125248)
}
