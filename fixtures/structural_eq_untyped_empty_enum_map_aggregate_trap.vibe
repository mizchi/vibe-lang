//# Codex round 5 on #2456, the fail-closed side. `enum Map[K, V]` with an
//# aggregate argument: the derived `Map::equals` would compare the `K`
//# payload by reference and answer `false` for two content-equal, separately
//# allocated arrays (measured on the stage2 at cf6e0c4: this program returned
//# normally). Once both sides are non-empty the comparison must TRAP instead.

enum Map[K, V] {
  Entry(K, V)
}

fn fill(xs: Array[Map[Array[Int], Int]], v: Int) -> Unit {
  Array::push(xs, Entry([v, v + 1], v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
