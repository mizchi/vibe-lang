//# #2737 control: a TOP-LEVEL binder's bound is threaded and keeps working.
//
// Three rungs are refused when the bound sits on a lambda binder (the
// `lambda_bound_dispatch_*_refused.vibe` fixtures). Each refusal is one condition
// away from rejecting the shape the language actually supports, so this file pins
// the supported shape on the same three rungs. Without it, a refusal that grew too
// wide would look like a pass: the refusal fixtures would still refuse.
//
// `outer_*` here is the same code as in each refusal fixture with the binder moved
// to the top level -- which is precisely the edit those refusals name.

trait Eq {
  equals(Self, Self) -> Bool
}

trait Show {
  to_string(Self) -> String
}

struct Pt {
  v: Int
}

impl Eq for Pt {
  equals(a: Pt, b: Pt) -> Bool {
    a.v == b.v
  }
}

impl Show for Pt {
  to_string(a: Pt) -> String {
    "Pt!"
  }
}

fn via_qualified[T: Eq](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn via_ufcs[T: Eq](a: T, b: T) -> Bool {
  a.equals(b)
}

fn via_interp[T: Show](a: T) -> String {
  "\{a}"
}

fn equality_snapshot(value: Bool) -> String {
  if value {
    "true"
  } else {
    "false"
  }
}

test "the qualified spelling dispatches through a top-level binder's witness" {
  inspect(equality_snapshot(via_qualified(Pt::{ v: 1 }, Pt::{ v: 1 })), content = "true")
}

test "the qualified spelling still separates different values" {
  inspect(equality_snapshot(via_qualified(Pt::{ v: 1 }, Pt::{ v: 2 })), content = "false")
}

test "the UFCS spelling dispatches through the same witness" {
  inspect(equality_snapshot(via_ufcs(Pt::{ v: 1 }, Pt::{ v: 1 })), content = "true")
}

test "the UFCS spelling still separates different values" {
  inspect(equality_snapshot(via_ufcs(Pt::{ v: 1 }, Pt::{ v: 2 })), content = "false")
}

test "interpolation dispatches through the threaded Show witness" {
  inspect(via_interp(Pt::{ v: 1 }), content = "Pt!")
}
