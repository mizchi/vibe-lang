//# #2737 control: a TOP-LEVEL binder's bound is threaded and keeps working.
//
// Four rungs are refused when the bound sits on a lambda binder (the
// `lambda_bound_dispatch_*_refused.vibe` fixtures), and interpolation of a
// nested binder's formal is refused too (`lambda_bound_erased_interp_*`). Each
// refusal is one condition away from rejecting the shape the language actually
// supports, so this file pins the supported shape for all of them. Without it, a refusal that grew too
// wide would look like a pass: the refusal fixtures would still refuse.
//
// `outer_*` here is the same code as in each refusal fixture with the binder moved
// to the top level -- which is precisely the edit those refusals name.

trait Eq {
  equals(Self, Self) -> Bool
}

trait Show {
  to_string(Self) -> String
}

struct Pt {
  v: Int
}

impl Eq for Pt {
  equals(a: Pt, b: Pt) -> Bool {
    a.v == b.v
  }
}

impl Show for Pt {
  to_string(a: Pt) -> String {
    "Pt!"
  }
}

fn via_qualified[T: Eq](a: T, b: T) -> Bool {
  T::equals(a, b)
}

fn via_ufcs[T: Eq](a: T, b: T) -> Bool {
  a.equals(b)
}

fn via_interp[T: Show](a: T) -> String {
  "\{a}"
}

// #2745: interpolation at a TOP-LEVEL binder, the shape the erased-interp
// refusal must not eat. A top-level generic is specialized per instantiation, so
// the concrete type is what gets asked about -- which is why `Int` renders and a
// renderless struct is refused by name (#1445) rather than printing a pointer.
// Without these rows, a refusal that widened to cover top-level binders would
// leave every `lambda_bound_erased_interp_*_refused.vibe` fixture still refusing.
fn show_any_unbounded[T](a: T) -> String {
  "\{a}"
}

// #2737 (Codex, P1): the witness taken as a VALUE. This is the shape one binder
// away from `lambda_bound_dispatch_value_refused.vibe`, and the refusal for that
// one lives on the same arm -- so without this row, a check that swallowed the
// working form would leave the refusal fixture still refusing.
fn via_value[T: Eq](a: T, b: T) -> Bool {
  let cmp = T::equals
  cmp(a, b)
}

fn is_big(n: Int) -> Bool {
  n > 3
}

fn equality_snapshot(value: Bool) -> String {
  if value {
    "true"
  } else {
    "false"
  }
}

test "the qualified spelling dispatches through a top-level binder's witness" {
  inspect(equality_snapshot(via_qualified(Pt::{ v: 1 }, Pt::{ v: 1 })), content = "true")
}

test "the qualified spelling still separates different values" {
  inspect(equality_snapshot(via_qualified(Pt::{ v: 1 }, Pt::{ v: 2 })), content = "false")
}

test "the UFCS spelling dispatches through the same witness" {
  inspect(equality_snapshot(via_ufcs(Pt::{ v: 1 }, Pt::{ v: 1 })), content = "true")
}

test "the UFCS spelling still separates different values" {
  inspect(equality_snapshot(via_ufcs(Pt::{ v: 1 }, Pt::{ v: 2 })), content = "false")
}

test "interpolation dispatches through the threaded Show witness" {
  inspect(via_interp(Pt::{ v: 1 }), content = "Pt!")
}

test "the witness taken as a value dispatches through a top-level binder" {
  inspect(equality_snapshot(via_value(Pt::{ v: 1 }, Pt::{ v: 1 })), content = "true")
}

test "the witness taken as a value still separates different values" {
  inspect(equality_snapshot(via_value(Pt::{ v: 1 }, Pt::{ v: 2 })), content = "false")
}

test "#2745: an unbounded top-level formal still interpolates at a scalar" {
  inspect(show_any_unbounded(7), content = "7")
}

test "#2745: a top-level formal with a Show witness still dispatches" {
  inspect(show_any_unbounded("s"), content = "s")
}

// #2745 (Codex, P1 on #2761): the erased-formal check runs ahead of every
// rendering path, including #1527's Bool one. A GENUINE Bool must still render
// `true` / `false` -- what changes the answer is the binder, not the spelling.
test "#1527: a genuine Bool through a call still renders true" {
  inspect("\{is_big(9)}", content = "true")
}

test "#1527: and false" {
  inspect("\{is_big(1)}", content = "false")
}

// #2745 (Codex, P1 round 2 on #2761): the erased-formal check now walks THROUGH
// the forms whose value comes from a sub-expression. A compound with no erased
// formal must still render -- these are where an over-eager walk would show,
// since `lambda_bound_erased_interp_compound_refused.vibe` would keep refusing
// either way.
test "#2745: an if inside interpolation, concrete branches" {
  inspect("\{if 1 > 0 { "yes" } else { "no" }}", content = "yes")
}

test "#2745: a single-arm match inside interpolation, concrete" {
  inspect("\{match 2 { _ => 7 }}", content = "7")
}

test "#2745: an if over Ints inside interpolation" {
  inspect("\{if 1 > 0 { 11 } else { 22 }}", content = "11")
}

// #2745 (Codex, P1 round 3 on #2761): a let-form inside the interpolation binds
// in ITS OWN scope. These two are the false-REFUSAL side -- a wrongly rejected
// program -- which `lambda_bound_erased_interp_let_refused.vibe` cannot catch,
// because it would keep refusing either way.
fn shadowing_let[T](a: T) -> String {
  "\{ { let a = 1; a } }"
}

fn fresh_let[T](a: T) -> String {
  "\{ { let n = 5; n } }"
}

test "#2745: a let that shadows the formal with an Int renders the Int" {
  inspect(shadowing_let(7), content = "1")
}

test "#2745: a let binding a fresh name renders it" {
  inspect(fresh_let(7), content = "5")
}

// #2745 (Codex, P1 round 4 on #2761): a match PATTERN that rebinds the formal's
// spelling at a concrete type. The false-refusal side again -- the refusal
// fixtures would keep refusing either way, so only this side can catch it.
fn shadowing_match[T](a: T) -> String {
  "\{match 1 { a => a }}"
}

test "#2745: a match arm that shadows the formal renders the Int" {
  inspect(shadowing_match(7), content = "1")
}

// #2745 (Codex, P1 round 5 on #2761): the walk now pairs a DESTRUCTURING
// pattern's payloads against the scrutinee, and absorbs what an evaluated
// sub-expression ASSIGNS. Both widenings are one condition away from rejecting a
// correct program, and neither `lambda_bound_erased_interp_destructure_refused`
// nor `..._loop_refused` can catch that -- they would keep refusing either way.
fn destructure_concrete[T](a: T) -> String {
  "\{match (3, 4) { (b, _) => b }}"
}

fn destructure_shadowing[T](a: T) -> String {
  "\{match (1, 2) { (a, _) => a }}"
}

fn destructure_other_slot[T](a: T) -> String {
  "\{match (a, 9) { (_, c) => c }}"
}

fn loop_concrete[T](a: T) -> String {
  "\{loop (i = 0) { break 6 }}"
}

fn assign_concrete[T](a: T) -> String {
  "\{ { let mut b = 0
  b = 8
  b } }"
}

test "#2745: a destructuring match over a concrete tuple renders the element" {
  inspect(destructure_concrete(7), content = "3")
}

test "#2745: a destructuring pattern that shadows the formal renders the Int" {
  inspect(destructure_shadowing(7), content = "1")
}

test "#2745: a destructured slot that is NOT the formal still renders" {
  inspect(destructure_other_slot(7), content = "9")
}

test "#2745: a loop breaking a concrete value still renders it" {
  inspect(loop_concrete(7), content = "6")
}

test "#2745: an assignment of a concrete value still renders it" {
  inspect(assign_concrete(7), content = "8")
}

// #2745: a call that returns its own type parameter is refused only when an
// ARGUMENT is erased. This is the cost boundary of that arm, and the refusal
// fixture cannot see it -- `lambda_bound_erased_interp_generic_call_refused`
// would keep refusing either way.
fn keep_it[U](x: U) -> U {
  x
}

fn generic_call_concrete[T](a: T) -> String {
  "\{keep_it(5)}"
}

fn generic_call_string[T](a: T) -> String {
  "\{keep_it("s")}"
}

test "#2745: a generic call with a concrete argument still renders" {
  inspect(generic_call_concrete(7), content = "5")
}

test "#2745: and with a String argument" {
  inspect(generic_call_string(7), content = "s")
}
