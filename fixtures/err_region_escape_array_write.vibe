fn build() -> Array[() -> Array[Int]] {
  let outer: Array[() -> Array[Int]] = []
  let _ = region r {
    let values = MutList::empty(r)
    Array::push(outer, () -> Array[Int] {
      MutList::to_array(values)
    })
    0
  }
  outer
}

test "outer arrays cannot retain region-backed closures" {
  let _ = build()
}
