// #1967: was fixtures/json_stringify.vibe + __DATA__.last "true".
// Current @vibe/json ships parse / stringify; last "true" is the z
// bool after a stringify round-trip.

import @vibe/json {
  Json,
  Json::as_bool,
  Json::as_num,
  Json::as_str,
  Json::get,
  parse,
  stringify
}

test "json stringify round-trip keeps z true" {
  let (obj, _) = parse("{\"x\":1,\"y\":\"hello\",\"z\":true}")
  let s = stringify(obj)
  let (obj2, _) = parse(s)
  let x = Json::as_num(Json::get(obj2, "x"))
  let y = Json::as_str(Json::get(obj2, "y"))
  let z = Json::as_bool(Json::get(obj2, "z"))
  assert(eq(x, 1.0))
  inspect(y, "hello")
  inspect(z, "true")
}
