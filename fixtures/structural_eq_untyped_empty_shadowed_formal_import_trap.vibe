//# Codex round 8 on #2456, the imported spelling: the #2141 guard sees only
//# same-file declarations, so an IMPORTED `struct T` next to `enum Wrap[T] {
//# W(T) }` compiles, and the payload is the formal. Same measurement and
//# same contract as the alias sibling: it must TRAP, never answer `false`
//# by reference.

import ./structural_eq_untyped_empty_shadowed_formal_dep.vibe { T }

enum Wrap[T] {
  W(T);
  Empty
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
