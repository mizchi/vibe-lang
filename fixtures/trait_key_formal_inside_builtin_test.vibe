//# Codex on #3956: a bound whose argument holds a formal inside a builtin or an
//# alias (`Value[StringMap[T]]`, `Value[Counts[T]]`) is canonical around the
//# formal, so it meets `impl Value[StringMap[Int]]`, whose key the lowering
//# spells `Value[Map[String, Int]]`. Before, an argument naming a formal was
//# kept as written: the checker accepted the call and witness generation found
//# no impl.

trait Value[A] {
  value(Self) -> Int
}

struct Note {
  n: Int
}

impl Value[StringMap[Int]] for Note {
  value(self) -> Int {
    self.n
  }
}

type Counts[T] = StringMap[T]

fn through_builtin[T, V: Value[StringMap[T]]](v: V, _ x: T) -> Int {
  V::value(v)
}

fn through_alias[T, V: Value[Counts[T]]](v: V, _ x: T) -> Int {
  V::value(v)
}

test "a formal inside StringMap" {
  inspect(through_builtin(v = Note::{ n: 3 }, 1), content = "3")
}

test "a formal inside an alias of StringMap" {
  inspect(through_alias(v = Note::{ n: 4 }, 1), content = "4")
}
