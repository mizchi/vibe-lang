struct ConditionalAliasSlot {
  callback: () -> Array[Int]
}

fn choose_alias[T](first: T, second: T) -> T {
  if true {
    first
  } else {
    second
  }
}

test "conditional alias results preserve every possible dependency" {
  let escaped = region r {
    let values = MutList::empty(r)
    choose_alias(first = ConditionalAliasSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }, second = ConditionalAliasSlot::{
      callback: () -> Array[Int] {
        []
      }
    })
  }
  let _ = escaped.callback()
}
