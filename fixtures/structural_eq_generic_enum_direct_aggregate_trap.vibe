//# Codex round 5 on #2456: a source-owned generic ENUM compared DIRECTLY
//# (annotated bindings, not the untyped-empty arm). `enum Map[K, V]` owns the
//# `Map` spelling, so `eq_for_typed` takes the declared-type dispatch; a
//# generic enum has only its derived `Map::equals`, which compares the `K`
//# payload with the raw word `==` -- reference equality for an `Array`.
//# Measured on the stage2 at cf6e0c4: `a == b` below answered `false` for
//# two content-equal, separately allocated payloads. It must TRAP instead;
//# `Map[String, Int]` (word-scalar arguments) answers.

enum Map[K, V] {
  Entry(K, V)
}

export fn _start() -> Int {
  let a: Map[Array[Int], Int] = Entry([1, 2], 1)
  let b: Map[Array[Int], Int] = Entry([1, 2], 1)
  if a == b {
    1
  } else {
    0
  }
}
