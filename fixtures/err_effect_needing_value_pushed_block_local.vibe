// #4065: an argument that is a block pushing the handle-bound closure into a
// local array of its own and reading it back hands that closure at its
// evidence arity to a row-free parameter, which is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    apply(f = {
      let ys: Array[() -> Int] = [() -> 7]
      Array::push(ys, value = g)
      Array::get(ys, at = 1)
    })
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
