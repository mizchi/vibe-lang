// #2990 control: a present key still answers its value, and `has_key` is the
// guard a caller writes before a lookup that may miss.
test "a present key answers and has_key guards a miss" {
  let m = Map::from_pairs([("a", 1), ("b", 2)])
  inspect(Map::get(m, "b"), "2")
  inspect(Map::has_key(m, "zz"), "false")
  let v = if Map::has_key(m, "zz") {
    Map::get(m, "zz")
  } else {
    0 - 1
  }
  inspect(v, "-1")
}
