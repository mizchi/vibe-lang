// #1261: the escape that eta-expansion CANNOT rescue -- the value leaves
// from a position the evidence migration never rewrites, so there is no
// evidence in scope to close over.
//
// `outer` neither declares the row nor sits inside the `handle`, so it gets
// no dict parameter and its body is left alone; wrapping `susp` there would
// only move the arity mismatch inside the wrapper. (A row-DECLARING but
// perform-free function is the same story: edp keeps it out of `needing`
// precisely because it has no perform of its own to resolve, so it too
// receives no dict.)
//
// Per ADR-0076 追記34 V2 (an un-migratable shape is a hard error, never a
// silent fallback) this is rejected at compile time with the fix in the
// message. See effect_needing_value_escape_wrapped_test.vibe for the shape that
// IS rescued, and effect_needing_value_annotated_test.vibe for the annotated
// form this diagnostic points at.
effect Async {
  Suspend(Int) -> Int
}

fn apply1(f: (x: Int) -> Int) -> Int {
  f(1)
}

fn susp(x: Int) -> Int with Async {
  perform Async::Suspend(x)
}

fn outer() -> Int {
  apply1(susp)
}

let _start = () -> Int {
  handle {
    outer()
  } with Async {
    Suspend(t) => resume(t + 41)
  }
}
_start()
