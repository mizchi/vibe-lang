// #3146: the ROW of a compiler-synthesized builtin call is the builtin's.
// The program's own `String::concat` carries `with Console`; the
// interpolation join inside the row-less `label` is the builtin's pure
// `String::concat`, so `label` needs no row. Before #3146 the checker charged
// the program's row to it (`effect row mismatch for 'label': missing
// { Console }`). A direct call to the program's function still needs the row
// (see the `allows Console` test below).

fn String::concat(a: String, b: String) -> String with Console {
  println("shadow")
  a
}

fn label(n: Int) -> String {
  "n=\{n}!"
}

test "a synthesized join carries the builtin's empty row" {
  inspect(label(4), content = "n=4!")
}

test "the program's own call keeps its own row and answer" allows Console {
  inspect(String::concat("x", "y"), content = "x")
}
