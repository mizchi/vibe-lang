//# #2745: a tuple bound to a NAME is still the shape a pattern takes apart.
//
// Codex, P1 round 6 on #2761. Round 5 paired a destructuring pattern against a
// scrutinee WRITTEN AT THE SITE; bind the tuple to a name first and the
// scrutinee arrives as an `EIdent`, so every payload blanked again. Measured:
// `{ let pair = (a, 1); match pair { (b, _) => b } }` with `a: T` printed
// `252`, the tagged pointer.
//
// Each element's classification is now recorded at the binding under a reserved
// key (`__Vtupelem$<name>$<i>`, the device `array_elem_key` already uses), and
// the pairing reads it. TUPLES only: a `PTuple` pattern can only match a tuple,
// so the shape is certain without checking a constructor name. A constructor or
// record bound to a name keeps the blank answer.
//
// The arity is part of the test. If the recorded tuple is wider or narrower than
// the pattern, the whole pattern blanks rather than pairing against half an
// answer -- a partial pairing is how a payload gets the wrong element's type.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let pair = (a, 1)
    match pair {
      (b, _) => b
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
