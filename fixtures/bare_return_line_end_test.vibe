//# #3578: a bare `return` at the end of a line ends the statement, the way a
//# bare `break` does. The next line is unreachable code, not the return
//# value: `return` then `println(..)` used to run the call, and `return` then
//# `let y = ..` was a parse error.

fn return_skips_next_line(log: Array[Int]) -> Unit {
  Array::push(log, 1)
  return
  Array::push(log, 2)
}

fn return_before_let(log: Array[Int]) -> Unit {
  Array::push(log, 1)
  return
  let y = 2
  Array::push(log, y)
}

fn return_before_brace(log: Array[Int], stop: Bool) -> Unit {
  Array::push(log, 1)
  if stop {
    return
  }
  Array::push(log, 2)
}

fn return_value_same_line(x: Int) -> Int {
  if x > 0 {
    return x + 1
  }
  0
}

fn return_in_match_arm(log: Array[Int], k: Int) -> Unit {
  match k {
    0 => return
    _ => Array::push(log, k)
  }
  Array::push(log, 9)
}

test "a bare return does not take the next line as its value" {
  let log: Array[Int] = []
  return_skips_next_line(log)
  inspect(log, "[1]")
}

test "a bare return before a let is a statement boundary" {
  let log: Array[Int] = []
  return_before_let(log)
  inspect(log, "[1]")
}

test "a bare return before a closing brace" {
  let a: Array[Int] = []
  return_before_brace(a, true)
  inspect(a, "[1]")
  let b: Array[Int] = []
  return_before_brace(b, false)
  inspect(b, "[1, 2]")
}

test "a return with a value on its own line keeps the value" {
  inspect(return_value_same_line(4), "5")
  inspect(return_value_same_line(0), "0")
}

test "a bare return ends a match arm" {
  let a: Array[Int] = []
  return_in_match_arm(a, 0)
  inspect(a, "[]")
  let b: Array[Int] = []
  return_in_match_arm(b, 3)
  inspect(b, "[3, 9]")
}
