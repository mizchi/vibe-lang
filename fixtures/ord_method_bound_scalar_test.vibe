//# A program `Ord` with a method still applies at a by-value scalar (#3350).
//
// `<` on an erased formal has no witness, so `[T: Ord]` is judged by the type
// alone: refused at a struct (fixtures/err_type_ord_method_bound_struct.vibe),
// accepted at `Int`, where the builtin `<` is the right order.

trait Ord {
  rank(Self) -> Int
}

impl Ord for Int {
  rank(a: Int) -> Int {
    a
  }
}

fn smaller[T: Ord](a: T, b: T) -> Bool {
  a < b
}

test "a method-bearing program Ord at Int orders by value" {
  inspect(smaller(a = 1, b = 2), "true")
  inspect(smaller(a = 2, b = 1), "false")
  inspect(smaller(a = -3, b = 2), "true")
}
