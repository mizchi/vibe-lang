// #2378: this file imports ONE unrelated name from a dependency that defines
// `fn String::index_of` -- and would get that definition anyway, program-wide
// and silently: measured on the seed, `String::index_of("hello world",
// "world")` here answered -999. The loader refuses the import with the edit
// first, naming the dependency (tests/gates/late/run.sh pins the message).
// The entry file's OWN shadow stays legal -- it is explicit in the program
// being compiled (fixtures/to_string_shadowed_builtin_test.vibe).
import ./modules/builtin_fn_shadowing_dep.vibe { unrelated_helper }

export fn main() -> Int {
  unrelated_helper() + String::index_of("hello world", "world")
}
