// #1295: wasm-gc must normalize packed Strings to character-code Arrays
// before its shared for-in Array loop. This is a self-contained executable
// fixture covering literals, empty Strings, indexed iteration, and a String
// assembled dynamically at runtime.

let char_sum: (String) -> Int = (s) -> {
  let mut sum = 0
  for c in s {
    sum = sum + c
  }
  sum
}

let indexed_sum: (String) -> Int = (s) -> {
  let mut sum = 0
  for i, c in s {
    sum = sum + i * 1000 + c
  }
  sum
}

export let main = () -> Int {
  let nonempty = char_sum("abc")
  let empty = char_sum("")
  let indexed = indexed_sum("AB")
  let dynamic = char_sum(String::concat("x", "y"))
  nonempty + empty + indexed + dynamic
}
