// Scenario 8: Two effects with same op name — no collision
effect A {
  Get -> Int
}

effect B {
  Get -> String
}

let result = handle {
  let a = perform A::Get
  let b = perform B::Get
  a + String::length(b)
} {
  A::Get => resume(10),
  B::Get => resume("hello")
}
result

__DATA__
{"last": "15"}
