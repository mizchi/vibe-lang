// Scenario 8: Two effects with same op name — no collision
effect A {
  Get -> Int
}

effect B {
  Get -> String
}

let result = handle {
  handle {
    let a = perform A::Get
    let b = perform B::Get
    a + String::length(b)
  } with {
    B::Get => resume("hello")
  }
} with {
  A::Get => resume(10)
}
result

__DATA__
{"last": "15"}
