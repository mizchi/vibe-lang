// The accepted side of the struct-field row check: a struct whose row
// parameter is a lowercase letter, instantiated with an effectful function.
// The pure instantiation is `struct_field_row_param_pure_test.vibe`, a field
// row naming a declared effect is
// `typecheck/struct_field_row_declared_effect_ok.vibe`, and the refused side
// is `typecheck/struct_field_row_{formal,unknown_effect}_reject.vibe`.

struct Holder[e] {
  run: () -> Int with e
}

fn loud() -> Int with Console {
  println("loud")
  2
}

fn call_holder[e](h: Holder[e]) -> Int with e {
  (h.run)()
}

test "a lowercase row parameter, effectful" {
  inspect(call_holder(Holder::{ run: loud }), content = "2")
}
