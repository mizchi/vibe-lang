// #3158 review: a user `impl Add for Pt` on the marker `Add` has no method to
// dispatch through, so `[T: Add]`'s `+` at `Pt` would add two pointers. The
// bound is refused there; the impl itself stays a legal declaration.

struct Pt {
  x: Int
}

impl Add for Pt

fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

fn main() -> Unit allows Console {
  let p = add2(Pt::{ x: 1 }, Pt::{ x: 2 })
  println(__to_string(p.x))
}
