// #3010 control: the same handle over a `State[Int]` body with an `Int`
// handler is accepted and answers through the arm. The refusal compares the
// handle's instantiation with the callee's declared row, so a matching pair
// must keep compiling.
effect State[S] {
  Get() -> S;
  Put(v: S) -> Unit
}

fn counter() -> Int with State[Int] {
  perform State::Get() + 1
}

test "a State[Int] body under an Int handler answers through the arm" {
  let s = handle {
    counter()
  } with {
    State::Get() => resume(41);
    State::Put(_v) => resume(())
  }
  inspect(s, "42")
}
