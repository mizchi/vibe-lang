// `derive (Ord)` over `String` and `Double` fields compares the values. It
// used to compare the two references: equal values answered `Less`, and the
// order of unequal ones followed allocation order.
struct D {
  v: Double
} derive (Ord)

enum E {
  K(String)
} derive (Ord)

struct Person {
  name: String;
  age: Int
} derive (Ord)

fn text(o: Ordering) -> String {
  match o {
    Less => "Less",
    Equal => "Equal",
    Greater => "Greater"
  }
}

test "a Double field orders by value" {
  inspect(text(D::compare(D::{ v: 2.5 }, D::{ v: 1.5 })), "Greater")
  inspect(text(D::compare(D::{ v: 1.5 }, D::{ v: 1.5 })), "Equal")
  inspect(text(D::compare(D::{ v: -1.0 }, D::{ v: 0.5 })), "Less")
}

test "a String payload orders by content" {
  inspect(text(E::compare(K("b"), K("a"))), "Greater")
  inspect(text(E::compare(K("a"), K("b"))), "Less")
  inspect(text(E::compare(K(String::concat("a", "b")), K("ab"))), "Equal")
}

test "a String field decides before a later field" {
  let a = Person::{ name: "ann", age: 40 }
  let b = Person::{ name: "bob", age: 20 }
  inspect(text(Person::compare(a, b)), "Less")
  inspect(text(Person::compare(b, a)), "Greater")
  inspect(text(Person::compare(a, Person::{ name: "ann", age: 41 })), "Less")
}
