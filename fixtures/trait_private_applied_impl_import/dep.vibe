export trait Measured {
  measure(Self) -> Int
}

struct Hidden[T] {
  value: T
}

impl Measured for Hidden[Int] {
  measure(_self: Hidden[Int]) -> Int {
    31
  }
}

fn measure[T: Measured](value: T) -> Int {
  T::measure(value)
}

export fn hidden_measure() -> Int {
  measure(Hidden[Int]::{ value: 1 })
}
