//# ADR-0097 fail-closed: `let xs = []` has no element comparator. Once the
//# array becomes non-empty, `==` must trap instead of silently comparing
//# identity or length. Add an element annotation to make comparison valid.

export fn _start() -> Int {
  let left = [
  ]
  Array::push(left, 1)
  let right = [
  ]
  Array::push(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
