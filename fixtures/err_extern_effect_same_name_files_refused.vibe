// ADR-0124 (#4082): two modules outside any package each declare `extern
// effect Kv`. They are two declarations, so a program importing both is
// refused like two packages' (err_extern_effect_same_name_packages_refused.vibe),
// naming both files; it used to build into one `vibe:effect:./Kv` import.
import ./modules/extern_same_name_file_a.vibe {
  Kv, read_a
}

import ./modules/extern_same_name_file_b.vibe {
  read_b
}

fn main() -> Unit allows Console + Kv {
  println(read_a(k = "x"))
  println(read_b(k = "y"))
}
