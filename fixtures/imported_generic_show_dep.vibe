// #3085: generic `derive (Show)` types declared in one module and rendered as
// fields / payloads of derived types, and interpolated, in the importer.
export struct Box[T] {
  v: T
} derive (Show)

export enum G[T] {
  GA(T);
  GB
} derive (Show)

export fn make_box(b: Bool) -> Box[Bool] {
  Box::{ v: b }
}
