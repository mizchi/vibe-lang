// #897 (ADR-0070 Phase 1): directory-shared scope for the UNQUALIFIED
// `import @user/mod { x, y }` form. `seed` is declared here but consumed by
// sibling `.vibe` implementation files WITHOUT their own import line --
// every ordinary `.vibe` file in this same directory (impl.vibe,
// shadow_impl.vibe) can call `seed` directly, because this vpkg's own
// `import @vibe/random { seed }` registers it into the package directory's
// shared scope. Contrast with the `as mod only` form (fixtures/qualified_import_test.vibe
// and lib/@vibe/compiler/tests/*): that one stays namespaced (`mod.x` only)
// and is NOT shared with siblings.
import @vibe/random { seed }

fn wrapped_seed(x: Int) -> Int
fn shadow_seed(x: Int) -> Int
