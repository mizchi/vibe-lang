// #4065: the closure pushed into an outer array inside a `match` arm. The array
// holds it after the scope ends, so a later read of the element is the
// closure at its evidence arity and handing it to a row-free parameter is
// refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    match 0 {
      _ => Array::push(xs, value = g)
    }
    apply(f = Array::get(xs, at = 1))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
