// #1087: a `throw` in NON-tail position directly inside a
// `handle .. with Exception` body (here: inside an if-branch with trailing
// body code) must abort the body and make the arm's value the handle's
// result. The ADR-0076 Phase 2 direct-perform inliner used to splice the
// arm body in place of the perform (resumptive semantics) -- the arm ran
// but its value was discarded and the body's continuation kept going, so
// this returned 41 instead of 1. Error arms are now excluded from that
// pass (idp_arms_discharge_error) and stay on the try_table lowering.
//   want: 1 (arm value), NOT 41 (body continuation)
export let main = () -> Int {
  handle {
    let x = 41
    if x > 0 {
      throw("boom")
    }
    x
  } with Exception {
    Throw(_) => 1
  }
}

// #1571: the expected value lives here, not in a `__DATA__` tail, and is
// updatable with `vibe test --update`. `main` discharges Exception in its own
// handle, so the test block needs no row.
test "a non-tail throw aborts the handle body to the arm's value" {
  inspect(main(), "1")
}
