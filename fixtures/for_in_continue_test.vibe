// #1967: was fixtures/for_in_continue.vibe + __DATA__.last "[1, 3, 5]".
// continue skips even numbers in a for-in collection. Seed still hangs
// (#2023 increment-before-body is checkout/stage2 only).

test "for-in continue skips even numbers" {
  inspect(for x in [
    1,
    2,
    3,
    4,
    5
  ] {
    if x % 2 == 0 {
      continue
    } else {
      ()
    }
    x
  }, "[1, 3, 5]")
}
