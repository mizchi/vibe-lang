//# Codex round 2 on #2456: a source declaration owns the `Map` spelling
//# (`fixtures/typecheck/map_local_shadow_ok.vibe`, #2263). The typed channel's
//# admission and `eq_for_typed` both consult `dtd_eq_type_owners`, so a
//# program-declared generic `Map` dispatches to its declared per-instantiation
//# comparator and never to the builtin `__map_equals__`, which reads a struct
//# as a map (it trapped with `memory access out of bounds` on the first
//# stage2 of #2456, where the previous compiler failed closed).

struct Map[K, V] {
  k: K;
  v: V
} derive (Eq)

fn fill(xs: Array[Map[String, Int]], v: Int) -> Unit {
  Array::push(xs, Map::{ k: "k", v: v })
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  assert(left == right)
  assert(left != other)
  0
}
