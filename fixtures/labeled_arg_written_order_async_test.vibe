// #3549 / ADR-0120 D2: labeled arguments that suspend are still evaluated left
// to right, in the written order, which is the declared order
// (fixtures/labeled_arg_declared_order_test.vibe holds the synchronous cases;
// this file is apart because the wasm-gc backend has no `await` yet).

fn sub(x: Int, y: Int) -> Int {
  x - y
}

fn joined(_ log: Array[String]) -> String {
  String::join(log, sep = ",")
}

fn awaited(log: Array[String], s: String, v: Int) -> Int with Async {
  Array::push(log, value = s)
  await(Future::ready(v))
}

fn async_sub(_ log: Array[String]) -> Int with Async {
  sub(x = awaited(log = log, s = "x", v = 10), y = awaited(log = log, s = "y", v = 1))
}

test "suspending arguments run left to right" {
  let log: Array[String] = []
  let r = handle {
    async_sub(log)
  } with { Async::Suspend(_) => resume(0) }
  inspect(joined(log), content = "x,y")
  inspect(r, content = "9")
}
