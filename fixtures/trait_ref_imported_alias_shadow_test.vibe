//# #3953 (Codex on #3961): a type the module declares itself wins over an
//# imported alias of the same name. The local `struct Alias` is what
//# `Value[Alias]` names, so the impl key is not rewritten to `Value[Int]`.

import ./_trait_ref_alias_defs.vibe { Alias }

trait Value[A] {
  value(Self) -> A
}

struct Alias {
  n: Int
}

struct Note {
  n: Int
}

impl Value[Alias] for Note {
  value(self) -> Alias {
    Alias::{ n: self.n }
  }
}

fn value_of[V: Value[Alias]](_ v: V) -> Int {
  V::value(v).n
}

test "a local struct shadows an imported alias" {
  inspect(value_of(Note::{ n: 6 }), content = "6")
}
