// #1340 (ADR-0071): a `with State[Int]` row item parses, authorizes the
// bare-effect perform (containment is base-name aware), and the handle
// still discharges it. The handler's shared per-handle instantiation binds
// S = Int through `Get => resume(35)`, so the arithmetic below type-checks
// against the instantiated signature end to end.
effect State[S] {
  Get() -> S;
  Put(S) -> Unit
}

let bump = () -> Int with State[Int] {
  let n = perform State::Get()
  perform State::Put(n + 1)
  n + 7
}

export let main = () -> Int {
  handle {
    bump()
  } with {
    State::Get => resume(35);
    State::Put(_v) => resume(())
  }
}

// #1571: the expectation lives here, checked by `inspect` and updatable
// with `vibe test --update`, instead of in a `__DATA__` tail the gate has
// to `sed` off and compare in shell.
test "effect generic row instantiation" {
  inspect(main(), "42")
}
