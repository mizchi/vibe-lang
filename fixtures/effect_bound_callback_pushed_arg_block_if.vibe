// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    apply(f = {
      let ys: Array[() -> Int] = [() -> 7]
      if true {
        Array::push(ys, value = g)
      } else {
        ()
      }
      Array::get(ys, at = 1)
    })
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
