//# #3730: a program's own function at a sized-integer conversion's spelling
//# answers its calls. The post-check rewrite of the builtin conversion must not
//# replace them: `rename_builtin_shadow_defs` moves the program's definition
//# aside, and the rewrite leaves the renamed name alone.

fn Int32::to_int(_ x: Int32) -> Int {
  99
}

test "a program's own Int32::to_int is the function that runs" {
  let x: Int32 = 1
  inspect(Int32::to_int(x), content = "99")
  let u: UInt32 = 4294967295
  inspect(UInt32::to_int(u), content = "4294967295")
}
