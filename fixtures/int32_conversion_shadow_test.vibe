// #3730: a program's own function spelled like a conversion builtin is the
// one its calls reach; the post-check rewrite of the builtin leaves it alone.

fn Int::wrap_int32(n: Int) -> Int {
  n + 100
}

test "a program's own Int::wrap_int32 is called, not the builtin" {
  inspect(Int::wrap_int32(1), content = "101")
}
