//# Codex round 9 on #2456, the other side: an alias that DOES observe its
//# argument -- `type Keep[X] = Array[X]` -- leaves the formal in the payload
//# after expansion (`Keep[T]` is `Array[T]`), so the derived `Wrap::equals`
//# would compare it through the erased `==`. Once both sides are non-empty
//# the comparison must TRAP.

type Keep[X] = Array[X]

enum Wrap[T] {
  W(Keep[T]);
  Empty
}

fn fill(xs: Array[Wrap[Int]], v: Int) -> Unit {
  Array::push(xs, W([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
