//# A generic whose `[T: Eq]` bound is supplied at each call is refused as a
//# value (`fixtures/err_threaded_generic_value_refused.vibe`). These are the
//# shapes that must keep compiling: a local binding that shadows the
//# generic's name, and the lambda the refusal's message suggests.

fn same[T: Eq](x: T, y: T) -> Bool {
  x == y
}

fn apply2(f: (Int, Int) -> Bool, a: Int, b: Int) -> Bool {
  f(a, b)
}

test "a lambda that calls the generic at a concrete type" {
  let g = (a: Double, b: Double) -> same(a, b)
  inspect(g(1.5, 1.5), "true")
  inspect(g(1.5, 2.5), "false")
  inspect(apply2((a: Int, b: Int) -> same(a, b), 3, 3), "true")
}

test "a local binding that shadows the generic's name" {
  let same = (a: Int, b: Int) -> a < b
  let g = same
  inspect(g(1, 2), "true")
  inspect(apply2(same, 2, 1), "false")
}

test "a parameter that shadows the generic's name" {
  let run = (same: (Int, Int) -> Bool) -> {
    let h = same
    h(4, 4)
  }
  inspect(run((a: Int, b: Int) -> a == b), "true")
}
