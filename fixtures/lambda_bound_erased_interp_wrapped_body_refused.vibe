//# #2745: an unannotated local lambda whose body WRAPS its parameter.
//
// Codex, P1 round 17 on #2761. Measured on `9859e55`:
// `let idf = [U](u: U) { if true { u } else { u } }` then `"\{idf(a)}"`
// printed a 3-digit pointer decimal, while the bare `{ u }` spelling of the
// same lambda -- which the checker types identically -- was refused.
//
// Round 15's body rule matched a bare `EIdent` and stopped there. The walk now
// descends the same VALUE positions the rest of this file does, because "the
// value of an `if` is the value of a branch" is the same statement here as it
// is in `dtd_erased_interp_formal`. A binding that SHADOWS a parameter stops
// the walk: past it the name no longer means the parameter, and answering from
// the parameter would be round 3's stale-binding mistake in a new place.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let idf = [U](u: U) {
      if true {
        u
      } else {
        u
      }
    }
    "\{idf(a)}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
