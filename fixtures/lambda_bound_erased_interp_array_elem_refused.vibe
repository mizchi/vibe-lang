//# #2745: an element read out of a let-bound ARRAY.
//
// Codex, P1 round 8 on #2761. `{ let xs = [a]; Array::get(xs, 0) }` with
// `a: T` printed `252`, the tagged pointer.
//
// This one needed NO new read path, which is the interesting part. The tuple
// routes in the previous commit had to add one because two tables already
// answered that question and disagreed; here `infer_arg_type_name`'s
// `Array::get` arm ALREADY reads `array_elem_key`, so recording the element's
// classification into that same key is what makes the two agree. Writing a
// third table beside it is the mistake the projection bug was made of.
//
// The first erased element decides. An array is homogeneous, so any element
// that classifies answers for the whole; recording nothing when none does keeps
// the fail-open answer for an array this walk cannot place.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let xs = [a]
    Array::get(xs, 0) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
