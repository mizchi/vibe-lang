// Scenario 11: throw inside handle arm — Error must be handled by outer scope
effect Ask {
  Question(String) -> String
}

let result = handle {
  handle {
    let answer = perform Ask::Question("ok?")
    String::length(answer)
  } with Ask {
    Question(_q) => {
      throw("handler failure")
      resume("x")
    }
  }
} with Exception {
  Throw(msg) => String::length(msg)
}
// "handler failure" → length 15
result

__DATA__
{"last": "15"}
