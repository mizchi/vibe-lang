// #2872 case (1), on a user struct rather than a builtin type.
//
// `Pt` carries no `derive (Eq)`, so nothing generates `Pt::describe` and the
// bodyless impl has no fallback. Not a duplicate of the `Int` fixture: that
// one is the shape where a BUILTIN spelling plausibly exists for the type
// (`Int::to_string` does), which is what the builtin arm of the fallback has
// to decline for a method the builtin registry does not carry. Here nothing
// could exist at all.

struct Pt {
  x: Int;
  y: Int;
}

trait Describe {
  describe(Self) -> String
}

impl Describe for Pt

fn show[T: Describe](x: T) -> String {
  T::describe(x)
}

export fn main() -> Int {
  let _ = show(Pt::{ x: 1, y: 2 })
  0
}
