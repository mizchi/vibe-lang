//# A generic impl over a marker `Eq` still applies at a by-value scalar (#3350).
//
// `impl [T: Eq] Same for Box[T]` compares the erased `T` with the builtin
// `==`. At `Box[Pt]` that is reference identity and the impl is refused
// (fixtures/err_type_eq_generic_impl_param_bound.vibe); at `Box[Int]` it is
// content equality, so the impl keeps applying and answering.

trait Eq {}

impl Eq for Int {}

trait Same {
  same(Self, Self) -> Bool
}

struct Box[T] {
  v: T
}

impl [T: Eq] Same for Box[T] {
  same(a: Box[T], b: Box[T]) -> Bool {
    a.v == b.v
  }
}

fn f[U: Same](a: U, b: U) -> Bool {
  U::same(a, b)
}

test "a marker-Eq generic impl at Box[Int] compares by value" {
  inspect(f(Box::{ v: 1 }, Box::{ v: 1 }), "true")
  inspect(f(Box::{ v: 1 }, Box::{ v: 2 }), "false")
}
