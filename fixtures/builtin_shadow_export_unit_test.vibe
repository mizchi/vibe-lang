import @vibe/builtin {
  trait Iterator
}

import ./modules/builtin_shadow_entry_scope_dep.vibe {
  doubled
}

// @vibe/builtin's export list contains Array::map, but this definition is
// private to the entry file. Calls in the dependency still mean the builtin.
fn Array::map(xs: Array[Int], f: (Int) -> Int) -> Array[Int] {
  let _ = xs
  let _ = f
  [42]
}

test "a different unit's export list cannot publish the private shadow" {
  inspect(Array::length(Array::map([1, 2, 3], (x: Int) -> Int {
    x + 1
  })), "1")
  inspect(Array::length(doubled([1, 2, 3])), "3")
}
