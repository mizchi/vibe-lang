// #3184: a `let mut` that stores a view, or an owned binding from outside the
// loop the store runs in, takes a reference of its own -- and the fix must
// not buy that with a leak. Every reference a store now takes is released by
// the slot (its next store, or its scope end), and a loop-carried binding the
// store no longer takes by transfer keeps its own scope-end release.
//
// #3190 extends it to a `let` / `let mut` initialized from a conditional, a
// match or a block whose tail names such a binding (the shapes after
// `kid_walk` below).
//
// Each shape returns 1 when the value it stored is still the one it stored,
// and each round runs all 41, so `main` answers 2000 * 41 = 82000. The gate
// (tests/gates/mid/run.sh, 40f0i) checks that answer on the bump, rc, shadow
// and gc lanes -- on a stage2 from the #3181 branch (9159d7a76) the rc lane
// answered with the blocks that reused the freed ones and the shadow lane
// trapped, and so did the #3190 shapes on one from the #3184 branch
// (40d32fe86) -- and bounds the rc lane's `__heap_ptr` growth. What each
// shape hands out afterwards is pinned by
// fixtures/rc_mut_store_view_test.vibe.
//
// A stored `for` element is pinned there and not here: a `for` over a named
// array leaks that array under RC whether or not its body stores anything
// (312 B per round for the shape, measured the same with the store removed),
// so a bound on it would measure that leak and not this fix.

enum D {
  A(Array[Int])
}

struct R {
  d: D
}

struct Node {
  tag: Int;
  kids: Array[Node]
}

fn second(d: D) -> Int {
  match d {
    A(xs) => Array::get(xs, 1)
  }
}

// Takes `d` owned and consumes it twice.
fn hold(d: D) -> Int {
  let h = [d, d]
  second(Array::get(h, 1))
}

fn first(xs: Array[D]) -> D {
  Array::get(xs, 0)
}

fn check(got: Int, want: Int) -> Int {
  if got == want {
    1
  } else {
    0
  }
}

fn while_view(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([i, n + i])]
    let v = Array::get(xs, 0)
    cur = v
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn branch_view(n: Int) -> Int {
  let mut cur = A([0, 0])
  if n >= 0 {
    let xs = [A([1, n])]
    let v = Array::get(xs, 0)
    cur = v
  } else {
    ()
  }
  check(hold(cur), n)
}

fn owner_outlives(n: Int) -> Int {
  let xs = [A([2, n])]
  let mut cur = A([0, 0])
  let v = Array::get(xs, 0)
  cur = v
  check(hold(cur) + second(Array::get(xs, 0)), 2 * n)
}

fn view_outside_loop(n: Int) -> Int {
  let xs = [A([3, n])]
  let v = Array::get(xs, 0)
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = v
    i = i + 1
  }
  check(hold(cur) + second(Array::get(xs, 0)), 2 * n)
}

fn alias_view(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([5, n + i])]
    let v = Array::get(xs, 0)
    let w = v
    cur = w
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn block_view(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([6, n + i])]
    cur = {
      let v = Array::get(xs, 0)
      v
    }
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn wrapper_view(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([7, n + i])]
    let v = first(xs)
    cur = v
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn cond_view(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([8, n + i])]
    let v = Array::get(xs, 0)
    cur = if i >= 0 {
      v
    } else {
      A([0, 0])
    }
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn cond_proj(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let r = R::{ d: A([9, n + i]) }
    cur = if i >= 0 {
      r.d
    } else {
      A([0, 0])
    }
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn cond_call(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([10, n + i])]
    cur = if i >= 0 {
      Array::get(xs, 0)
    } else {
      A([0, 0])
    }
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn cond_fresh(n: Int) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    let xs = [A([11, 0])]
    let v = Array::get(xs, 0)
    cur = if i < 0 {
      v
    } else {
      A([11, n + i])
    }
    i = i + 1
  }
  check(hold(cur), n + 2)
}

fn break_view(n: Int) -> Int {
  let d = loop (i = 0) {
    let xs = [A([12, n + i])]
    let v = Array::get(xs, 0)
    if i == 2 {
      break v
    }
    continue(i + 1)
  }
  check(hold(d), n + 2)
}

// The loop hands its parameter back through `break cur` rather than
// consuming it inside the body: an owning call on a loop-carried binding
// there (`break hold(cur)`) leaks one reference per loop on its own, with or
// without a view, which this bound would otherwise measure.
fn continue_view(n: Int) -> Int {
  let d = loop (cur = A([0, 0]), i = 0) {
    if i == 3 {
      break cur
    }
    let xs = [A([13, n + i])]
    let v = Array::get(xs, 0)
    continue(v, i + 1)
  }
  check(hold(d), n + 2)
}

fn loop_carried(n: Int) -> Int {
  let p = A([14, n])
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = p
    i = i + 1
  }
  check(hold(cur), n)
}

fn loop_carried_used(n: Int) -> Int {
  let p = A([15, n])
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = p
    i = i + 1
  }
  check(hold(cur) + hold(p), 2 * n)
}

fn cond_loop_carried(n: Int) -> Int {
  let p = A([20, n])
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = if i >= 0 {
      p
    } else {
      A([0, 0])
    }
    i = i + 1
  }
  check(hold(cur) + hold(p), 2 * n)
}

// The block's head does not call anything on `p`: a call on a loop-carried
// binding inside the loop leaks one reference per loop on its own (#706's
// retain plus the plan's dup), store or no store.
fn block_loop_carried(n: Int) -> Int {
  let p = A([21, n])
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = {
      let _ = i + 1
      p
    }
    i = i + 1
  }
  check(hold(cur) + hold(p), 2 * n)
}

fn store_param(p: D) -> Int {
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = p
    i = i + 1
  }
  hold(cur)
}

fn param_loop(n: Int) -> Int {
  let p = A([16, n])
  let a = store_param(p)
  check(a + hold(p), 2 * n)
}

fn init_view(n: Int) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let xs = [A([17, n + i])]
    let v = Array::get(xs, 0)
    let mut cur = v
    acc = acc + hold(cur)
    i = i + 1
  }
  check(acc, 3 * n + 3)
}

fn init_loop_carried(n: Int) -> Int {
  let p = A([18, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = p
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn init_call_store_view(n: Int) -> Int {
  let ys = [A([19, 0])]
  let mut cur = Array::get(ys, 0)
  let mut i = 0
  while i < 3 {
    let xs = [A([19, n + i])]
    let v = Array::get(xs, 0)
    cur = v
    i = i + 1
  }
  check(hold(cur) + hold(Array::get(ys, 0)), n + 2)
}

fn kid_walk_cond(n: Int) -> Int {
  let mut cur = Node::{ tag: 0, kids: [Node::{ tag: 1, kids: [Node::{ tag: n, kids: [] }] }] }
  let mut d = 0
  while d < 2 {
    let k = Array::get(cur.kids, 0)
    cur = if d >= 0 {
      k
    } else {
      Node::{ tag: 0, kids: [] }
    }
    d = d + 1
  }
  check(cur.tag, n)
}

fn kid_walk(n: Int) -> Int {
  let mut cur = Node::{ tag: 0, kids: [Node::{ tag: 1, kids: [Node::{ tag: n, kids: [] }] }] }
  let mut d = 0
  while d < 2 {
    let k = Array::get(cur.kids, 0)
    cur = k
    d = d + 1
  }
  check(cur.tag, n)
}

// #3190: a `let mut` or `let` in a loop initialized from a conditional, a
// match or a block that hands back an owned binding from outside the loop.
// The binder takes a reference of its own there, released by its owning use,
// its next store or its scope end, and `p` keeps its own for its scope end.
// Unfixed, the `let mut` shapes trapped under shadow (the plan transferred
// `p` into the binder on every iteration) and the `let` shapes leaked 112 or
// 224 B per round (codegen retained the tail the plan had also budgeted).
fn peek(d: D) -> Int {
  match d {
    A(xs) => Array::get(xs, 1) + 0
  }
}

fn init_cond_loop_carried(n: Int) -> Int {
  let p = A([30, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = if i >= 1 {
      p
    } else {
      A([0, n])
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn init_match_loop_carried(n: Int) -> Int {
  let p = A([31, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = match i {
      0 => A([0, n]),
      _ => p
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn init_block_loop_carried(n: Int) -> Int {
  let p = A([32, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = {
      let e = A([i, i])
      p
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn let_cond_loop_carried(n: Int) -> Int {
  let p = A([33, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let c = if i >= 1 {
      p
    } else {
      A([0, n])
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn let_match_loop_carried(n: Int) -> Int {
  let p = A([34, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let c = match i {
      0 => A([0, n]),
      _ => p
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn let_block_loop_carried(n: Int) -> Int {
  let p = A([35, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let c = {
      let e = A([i, i])
      p
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn init_cond_read(n: Int) -> Int {
  let p = A([36, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = if i >= 1 {
      p
    } else {
      A([0, n])
    }
    acc = acc + peek(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn let_cond_read(n: Int) -> Int {
  let p = A([37, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let c = if i >= 1 {
      p
    } else {
      A([0, n])
    }
    acc = acc + peek(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn init_cond_then_store(n: Int) -> Int {
  let p = A([38, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = if i >= 1 {
      p
    } else {
      A([0, n])
    }
    acc = acc + peek(c)
    c = A([1, n])
    acc = acc + peek(c)
    i = i + 1
  }
  check(acc + hold(p), 7 * n)
}

fn init_cond_param(p: D) -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = if i >= 1 {
      p
    } else {
      A([0, 0])
    }
    acc = acc + hold(c)
    i = i + 1
  }
  acc
}

fn param_init_cond(n: Int) -> Int {
  let p = A([39, n])
  let a = init_cond_param(p)
  check(a + hold(p), 3 * n)
}

fn init_cond_both(n: Int) -> Int {
  let p = A([40, n])
  let q = A([41, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = if i >= 1 {
      p
    } else {
      q
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p) + hold(q), 5 * n)
}

fn init_same_branches(n: Int) -> Int {
  let p = A([42, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let mut c = if i >= 1 {
      p
    } else {
      p
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn let_same_arms(n: Int) -> Int {
  let p = A([43, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let c = match i {
      0 => p,
      _ => p
    }
    acc = acc + hold(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

fn store_same_branches(n: Int) -> Int {
  let p = A([44, n])
  let mut cur = A([0, 0])
  let mut i = 0
  while i < 3 {
    cur = if i >= 1 {
      p
    } else {
      p
    }
    i = i + 1
  }
  check(hold(cur) + hold(p), 2 * n)
}

// The binder of a conditional initializer stored into a slot that its scope
// end releases (unfixed: a trap under rc).
fn let_cond_stored(n: Int) -> Int {
  let p = A([45, n])
  let mut cur = A([0, 0])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let c = if i >= 0 {
      p
    } else {
      A([0, n])
    }
    cur = c
    acc = acc + peek(cur)
    i = i + 1
  }
  check(acc + peek(cur) + hold(p), 5 * n)
}

// A view on one branch: the binder stays borrow-bound, and only read.
fn view_or_outer_read(n: Int) -> Int {
  let p = A([46, n])
  let mut i = 0
  let mut acc = 0
  while i < 3 {
    let xs = [A([0, n])]
    let c = if i >= 1 {
      p
    } else {
      Array::get(xs, 0)
    }
    acc = acc + peek(c)
    i = i + 1
  }
  check(acc + hold(p), 4 * n)
}

// #768's shape: an outer `let mut` reassigned in the loop, handed back by a
// branch (unfixed: 336 B per round leaked, as a `let` and as a `let mut`).
fn cached_last(n: Int) -> Int {
  let mut last = A([47, n])
  let mut i = 0
  let mut acc = 0
  while i < 4 {
    let bucket = if i % 2 == 1 {
      last
    } else {
      A([1, n])
    }
    acc = acc + peek(bucket)
    last = bucket
    i = i + 1
  }
  check(acc + hold(last), 5 * n)
}

fn cached_last_mut(n: Int) -> Int {
  let mut last = A([48, n])
  let mut i = 0
  let mut acc = 0
  while i < 4 {
    let mut bucket = if i % 2 == 1 {
      last
    } else {
      A([1, n])
    }
    acc = acc + peek(bucket)
    last = bucket
    i = i + 1
  }
  check(acc + hold(last), 5 * n)
}

fn round(i: Int) -> Int {
  let views = while_view(i) + branch_view(i) + owner_outlives(i) + view_outside_loop(i) + alias_view(i) + block_view(i) + wrapper_view(i)
  let conds = cond_view(i) + cond_proj(i) + cond_call(i) + cond_fresh(i) + kid_walk(i) + kid_walk_cond(i)
  let loops = break_view(i) + continue_view(i) + loop_carried(i) + loop_carried_used(i) + cond_loop_carried(i) + block_loop_carried(i) + param_loop(i)
  let inits = init_view(i) + init_loop_carried(i) + init_call_store_view(i)
  let tail_inits = init_cond_loop_carried(i) + init_match_loop_carried(i) + init_block_loop_carried(i) + let_cond_loop_carried(i) + let_match_loop_carried(i) + let_block_loop_carried(i) + init_cond_read(i)
  let more_inits = let_cond_read(i) + init_cond_then_store(i) + param_init_cond(i) + init_cond_both(i) + init_same_branches(i) + let_same_arms(i) + store_same_branches(i)
  let binders = let_cond_stored(i) + view_or_outer_read(i) + cached_last(i) + cached_last_mut(i)
  views + conds + loops + inits + tail_inits + more_inits + binders
}

export fn main() -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 2000 {
    acc = acc + round(i)
    i = i + 1
  }
  acc
}
