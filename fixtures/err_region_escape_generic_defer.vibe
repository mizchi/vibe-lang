fn defer[T, U](value: T, project: (T) -> U) -> () -> U {
  () -> U {
    project(value)
  }
}

test "generic captures retain dependent provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    defer(values, (xs) -> Array[Int] {
      MutList::to_array(xs)
    })
  }
  let _ = escaped()
}
