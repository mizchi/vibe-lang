//# #2745: an array whose ELEMENT is itself an aggregate.
//
// Codex, P1 round 13 on #2761. Measured on `2d6e2b4`: `{ let xs = [[a]];
// let ys = Array::get(xs, 0); Array::get(ys, 0) }` printed a 3-digit pointer
// decimal.
//
// The array recorder stored one thing, the first element's CLASSIFICATION, and
// an element that is itself an aggregate classifies as "". So `xs` recorded
// nothing and neither `Array::get` could recover the formal. The element now
// gets a SLOT of its own, recorded by the same recorder that gives a tuple
// element or a record field one, and `Array::get` copies that slot's records
// onto the name it binds -- the same alias relation every other route uses,
// which is what makes depth close here as it does everywhere else.
//
// An array's elements are uniform, so there is ONE slot rather than one per
// index, and it borrows index 0's spelling: a name bound to an array has no
// tuple records, so the two cannot collide, and sharing the spelling means the
// mask, the scope compaction and the alias copy need no array-specific arm.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let xs = [[a]]
    let ys = Array::get(xs, 0)
    Array::get(ys, 0) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
