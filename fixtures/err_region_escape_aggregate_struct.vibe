struct AggregateSlot {
  callback: () -> Array[Int]
}

test "aggregate tails preserve nominal field provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    [
      AggregateSlot::{
        callback: () -> Array[Int] {
          MutList::to_array(values)
        }
      }
    ]
  }
  let _ = Array::get(escaped, 0).callback()
}
