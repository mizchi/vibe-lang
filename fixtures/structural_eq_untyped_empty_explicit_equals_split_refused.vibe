//# Codex round 13 on #2456: an explicit comparator is admitted only when
//# BOTH of its parameters name the same instantiation. This `Wrap::equals`
//# takes `(Wrap[String], Wrap[Array[Int]])`; admitting `Wrap[String]` from
//# the first parameter alone would hand the second a string payload that the
//# body reads as an array (the generated array helper calls the comparator
//# after checking has finished). Once both sides are non-empty the
//# comparison must TRAP. Measured on 614f808: this program returned 0.

enum Wrap[T] {
  W(T);
  Empty
}

fn Wrap::equals(a: Wrap[String], b: Wrap[Array[Int]]) -> Bool {
  match a {
    W(x) => match b {
      W(y) => Array::length(y) == 2,
      _ => false
    },
    Empty => match b {
      Empty => true,
      _ => false
    }
  }
}

fn fill(xs: Array[Wrap[String]], v: String) -> Unit {
  Array::push(xs, W(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, "ab")
  let right = []
  fill(right, "cd")
  if left == right {
    1
  } else {
    0
  }
}
