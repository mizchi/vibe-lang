effect Ask { Get() -> Int }

fn inner_handled() -> Int with Ask {
  perform Ask::Get()
}

fn outer(f: () -> Int with Ask) -> Int {
  handle { f() } with { Ask::Get() => resume(1) }
}

fn locally(outer~: (() -> Int with Ask) -> Int) -> Int {
  outer(inner_handled)
}

export fn main() -> Int {
  let side = () -> Int with Ask { perform Ask::Get() }
  let handled = outer(side)
  handled + locally(outer = (f: () -> Int with Ask) -> Int { 5 })
}
