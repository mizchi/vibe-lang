//# #2745: a tuple reaching the pattern through ANOTHER name.
//
// Codex, P1 round 7 on #2761. Round 6 recorded a tuple literal's elements at
// the binding that names it; bind that name to a SECOND name and the new one
// had no keys of its own, so the pattern blanked again. Measured:
// `{ let pair1 = (a, 1); let pair2 = pair1; match pair2 { (b, _) => b } }`
// with `a: T` printed `252`, the tagged pointer.
//
// The fix copies the source's keys, which makes the alias relation TRANSITIVE
// by construction -- `pair3 = pair2` copies what `pair2` itself copied, so a
// chain of any length resolves without a rule per hop. That is the difference
// between closing a relation and adding another arm; this file is named for the
// chain rather than for the two-hop case so it reads as the former.
//
// The copy stops at the first missing index, preserving the recorded ARITY.
// The pairing rejects a length it cannot confirm, and half a copy would defeat
// that check rather than merely weaken it.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let pair1 = (a, 1)
    let pair2 = pair1
    let pair3 = pair2
    match pair3 {
      (b, _) => b
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
