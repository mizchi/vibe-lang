// #1157: `perform Eff::Op` (zero-arg operation, no parens) must be checked by
// the same direct effect-row discipline as the parenthesized form
// (`perform Eff::Op(args)`). Previously this shape parsed its `perform`
// argument to a bare `EIdent`, not an `ECall`, and fell through the checker's
// `match op_callee { ECall(...) => ... }` guard entirely -- compiling with
// zero diagnostics despite `asks` never declaring `Ask` in a `with ...`
// clause.
// needle: "missing { Ask::Get } (no 'with' clause, requires { Ask::Get })"
effect Ask {
  Get -> Int
}

fn asks() -> Int {
  perform Ask::Get
}
