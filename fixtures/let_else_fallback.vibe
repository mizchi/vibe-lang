// let...else with fallback - else body value is ignored, pattern bindings unavailable
// In real use, else body should diverge (raise, break, etc.)
// Here we test that the else body evaluates but v is not bound
enum Maybe { Just(Int); Nothing }
let x = Just(42)
let Just(v) = x else { 0 }
v

__DATA__
{"last": "42"}
