test "map iterate" {
  let m = MapBuilder::new()
  let _ = (MapBuilder::set(m, key = "a", value = 1))
  let _ = (MapBuilder::set(m, key = "b", value = 2))
  let _ = (MapBuilder::set(m, key = "c", value = 3))
  let frozen = MapBuilder::freeze(m)
  let keys = Map::keys(frozen)
  inspect(Array::length(keys), "3")
}
