// #3105: the import target of private_type_impl_import_test.vibe. Every type
// here is PRIVATE, so the merge renames it (`Pt` -> `Pt_dep_<path>`), and each
// carries an impl of a method-bearing trait. Only the functions are exported.

struct Pt {
  x: Int;
  y: Int
}

enum Shape {
  Square(Int);
  Rect(Int, Int)
}

trait Measured {
  measure(Self) -> Int
}

trait Described {
  area(Self) -> Int;
  sides(Self) -> Int;
  label(Self) -> String
}

impl Measured for Pt {
  measure(a: Pt) -> Int {
    a.x + a.y
  }
}

impl Measured for Shape {
  measure(s: Shape) -> Int {
    match s {
      Square(n) => n,
      Rect(w, h) => w + h
    }
  }
}

impl Described for Shape {
  area(s: Shape) -> Int {
    match s {
      Square(n) => n * n,
      Rect(w, h) => w * h
    }
  }
  sides(s: Shape) -> Int {
    match s {
      Square(_) => 4,
      Rect(_, _) => 4
    }
  }
  label(s: Shape) -> String {
    match s {
      Square(_) => "square",
      Rect(_, _) => "rect"
    }
  }
}

impl Described for Pt {
  area(p: Pt) -> Int {
    p.x * p.y
  }
  sides(_p: Pt) -> Int {
    0
  }
  label(_p: Pt) -> String {
    "pt"
  }
}

fn Pt::sum(p: Pt) -> Int {
  p.x + p.y
}

fn meas[T: Measured](v: T) -> Int {
  T::measure(v) * 10
}

fn describe[T: Described](v: T) -> String {
  "\{T::label(v)}:\{T::area(v)}/\{T::sides(v)}"
}

/// Through a `[T: Measured]` dictionary: the shape #3105 reported.
export fn measured_struct() -> Int {
  meas(Pt::{ x: 3, y: 4 })
}

/// A direct qualified call and UFCS on the private struct.
export fn direct_struct() -> Int {
  let p = Pt::{ x: 3, y: 4 }
  Pt::measure(p) * 100 + p.measure() * 10 + p.sum()
}

/// A private enum through a dictionary and directly.
export fn measured_enum() -> Int {
  meas(Rect(2, 5)) + Shape::measure(Square(6)) + Square(1).measure()
}

/// A trait with several methods, at the private enum and the private struct.
export fn described() -> String {
  "\{describe(Rect(2, 5))} \{describe(Square(3))} \{describe(Pt::{ x: 3, y: 4 })}"
}
