// Dependency of typecheck/import_alias_dot_call_field_ok.vibe (#3890): a function-valued
// field and a companion of the same name, with different signatures.

export struct FB {
  get: () -> String
}

export fn FB::get(_ b: FB, _ n: Int) -> Int {
  n
}

export fn make_field_box() -> FB {
  FB::{ get: () -> "field" }
}
