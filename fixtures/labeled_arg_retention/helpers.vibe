export fn stash(dst: Array[() -> Array[Int]], value: () -> Array[Int]) -> Unit {
  Array::push(dst, value)
}

export fn stash_optional(dst: Array[() -> Array[Int]], value?: () -> Array[Int]) -> Unit {
  match value {
    Some(f) => Array::push(dst, f),
    None => ()
  }
}

export fn ignore(dst: Array[() -> Array[Int]], value: () -> Array[Int]) -> Unit {
  ()
}
