import ./helpers.vibe {
  ignore, stash, stash_optional
}

fn stored_independent_value() -> Int {
  let outside: Array[() -> Array[Int]] = []
  let _ = region r {
    let values = MutList::empty(r)
    ignore(dst = outside, value = () -> Array[Int] {
      MutList::to_array(values)
    })
    stash(dst = outside, value = () -> Array[Int] {
      [42]
    })
    stash_optional(dst = outside)
    0
  }
  let read = Array::get(outside, at = 0)
  Array::get(read(), at = 0)
}

test "imported retention summaries accept independent and omitted labeled values" {
  assert_eq(stored_independent_value(), 42)
}
