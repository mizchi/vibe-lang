//# #2737: a HIGHER-KINDED lambda binder's bound is refused like a plain one.
//
// Codex round 2, P1. A kinded formal arrives as `type_param_key(name, arity)` --
// `F[_]` is spelled `<prefix>1$F` -- while every lookup in this pass passes a bare
// head: `split_qualified` gives `F` for `F::map`, `infer_arg_type_name` gives `F`,
// and `build_gens` canonicalizes with `type_param_name` already. Stored as the
// key, a kinded binder was invisible to `formal_in_scope`,
// `dtd_formal_is_shadowed` and `dtd_formal_bound_promises` alike, so both the
// withholding guard and the refusal skipped it.
//
// Measured on main at 8f70aa1 and again with the refusals but before
// canonicalization, this program died with a bare `trap: RuntimeError:
// unreachable` at `outer`; it now carries the message. So the observable was a
// trap rather than a wrong value in THIS shape -- the defect is in the predicate,
// which by construction could never see a kinded binder, and the fix is what makes
// the three rungs' guarantee hold for one.
//
// The top-level kinded form is the shape this must not eat, and it is exercised by
// `lib/@vibe/compiler/tests/kinded_constructor_unification_test.vibe`, where
// `fn map[F[_]: Mappable[F], A, B](xs: F[A], f: (A) -> B) -> F[B] { F::map(xs, f) }`
// maps a `Box` and a `Slot` through their own impls.

trait Mappable[F[_]] {
  map[A, B](F[A], (A) -> B) -> F[B]
}

struct Box[T] {
  value: T
}

enum Slot[T] {
  Full(T)
}

impl Mappable[Box] for Box {
  map(xs: Box[A], f: (A) -> B) -> Box[B] {
    Box::{ value: f(xs.value) }
  }
}

impl Mappable[Slot] for Slot {
  map(xs: Slot[A], f: (A) -> B) -> Slot[B] {
    match xs {
      Full(value) => Full(f(value))
    }
  }
}

fn outer[F[_]: Mappable[F]](xs: F[Int]) -> Int {
  let inner = [F[_]: Mappable[F]](ys: F[Int]) -> F[Int] {
    F::map(ys, (x) -> {
      x + 1
    })
  }
  let r = inner(Full(5))
  match r {
    Full(v) => v
  }
}

export fn _start() -> Int {
  outer(Box::{ value: 9 })
}
