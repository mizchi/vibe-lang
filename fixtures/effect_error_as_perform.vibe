// Error as explicit perform: perform Error::Throw("msg")
// Should be equivalent to throw("msg")

let safe = () -> Int with { Error } {
  perform Error::Throw("fail")
  0
}

let result = handle {
  safe()
} {
  Error(msg) => String::length(msg)
}
// "fail" → length 4
result

