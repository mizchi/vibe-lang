//# ADR-0097 fail-closed: the second round of the `dtd_eq_unsafe_types`
//# fixpoint.
//#
//# `Deep`'s own field is a plain declared struct, so one pass over the
//# declarations cannot see anything wrong with it -- `Outer` is only marked
//# unsafe by that same pass. Without the loop, `Deep` would be adopted and two
//# equal values would answer `false` (measured). Same shape as
//# structural_eq_untyped_empty_generic_field_trap.vibe, one level further out.

struct Box[T] {
  value: T
} derive (Eq)

struct Outer {
  box: Box[Array[Int]]
} derive (Eq)

struct Deep {
  o: Outer
} derive (Eq)

export fn _start() -> Int {
  let left = []
  Array::push(left, Deep::{
    o: Outer::{
      box: Box[Array[Int]]::{
        value: [1, 2]
      }
    }
  })
  let right = []
  Array::push(right, Deep::{
    o: Outer::{
      box: Box[Array[Int]]::{
        value: [1, 2]
      }
    }
  })
  if left == right {
    1
  } else {
    0
  }
}
