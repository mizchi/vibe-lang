// #3042 (Codex on #3063): an exact-shaped `enum Ordering { Less; Equal;
// Greater }` declared by a dependency IS the prelude for its importers, and
// the checker gives them the prelude's `compare` / `to_string` / `==`. The
// dependency wrote no derives; the lowering supplies them, so every call the
// checker accepted resolves instead of reaching codegen unbound.

import ./modules/ordering_exact_shape_dep.vibe { sign_of }

struct Version { major: Int; minor: Int } derive (Ord)

// `Show` is a marker trait: the bound is what is checked here.
fn shown[T: Show](v: T) -> Int {
  1
}

fn same[T: Eq](a: T, b: T) -> Bool {
  T::equals(a, b)
}

test "a dependency's derive-less Ordering carries the prelude's operations" {
  inspect(Ordering::to_string(sign_of(0 - 5)), "Less")
  inspect(sign_of(0) == Equal, "true")
  inspect(Ordering::to_string(Ordering::compare(sign_of(1), sign_of(0))), "Greater")
  let v = Version::compare(Version::{ major: 1, minor: 2 }, Version::{ major: 1, minor: 9 })
  inspect(Ordering::to_string(v), "Less")
}

test "it satisfies the prelude's Eq and Show bounds" {
  inspect(shown(sign_of(3)), "1")
  inspect(same(sign_of(0), Equal), "true")
}
