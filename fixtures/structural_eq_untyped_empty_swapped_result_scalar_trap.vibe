//# Codex rounds 3-6 on #2456, the fail-closed side. A source-owned generic
//# ENUM has only its derived `::equals`, which compares a formal-typed payload
//# with the raw word `==`. That is not content equality for ANY argument:
//# reference equality for an aggregate, and through the generic `eq`
//# builtin's string fallback not even exact for an `Int` (`64 << 32` vs
//# `65 << 32` compared equal, measured). Once both sides are non-empty the
//# comparison must TRAP rather than answer through that comparator, until
//# generic enums get a per-instantiation comparator like generic structs
//# (#2195).
//# Here: `Ok(E) | Err(T)` (right names and arities, swapped formals), `Int` payloads.

enum Result[T, E] {
  Ok(E);
  Err(T)
}

fn fill(xs: Array[Result[String, Int]], v: Int) -> Unit {
  Array::push(xs, Ok(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 65 << 32)
  if left == right {
    1
  } else {
    0
  }
}
