struct StructContainerWrap {
  callback: () -> Array[Int]
}

fn build_struct_container() -> Array[StructContainerWrap] {
  region r {
    let values = MutList::empty(r)
    [
      StructContainerWrap::{
        callback: () -> Array[Int] {
          MutList::to_array(values)
        }
      }
    ]
  }
}
