// #1938: the same struct erasure inside a container, away from tail position.
//   error_contains: "has no type parameter to record the region"
struct Wrap {
  f: () -> Array[Int]
}

fn build() -> Array[Wrap] {
  region r {
    let values = MutList::empty(r)
    [
      Wrap::{
        f: () -> Array[Int] {
          MutList::to_array(values)
        }
      }
    ]
  }
}
