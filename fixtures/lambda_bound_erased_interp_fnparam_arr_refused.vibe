//# #2745: a function-valued parameter whose declared return is an AGGREGATE.
//
// Codex, P1 round 23 on #2761. Measured on `c799c16`:
// `[T](a: T, f: (T) -> Array[T]) { "\{Array::get(f(a), 0)}" }` printed a
// 3-digit pointer decimal.
//
// Round 20 recorded a parameter's return only when it was a bare `TyName`, so
// the annotation that names an ELEMENT rather than a value said nothing. That
// is round 17's hole in the other half of this pass -- there for a local
// lambda, here for a parameter -- and closing it needed no new reader: since
// round 23 a marker's source may be a declared type name, so a parameter's
// element and a local lambda's element go in the SAME slot and are resolved by
// the same rule.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T, f: (T) -> Array[T]) -> String {
    "\{Array::get(f(a), 0)}"
  }
  inner(Qt::{ w: 5 }, (v: Qt) -> Array[Qt] {
    [v]
  })
}

export fn _start() -> Int {
  String::length(outer(7))
}
