// A row-free callback can be adapted at each of two differently instantiated rows.
effect Box[T] {
  Put(T) -> Int
}

effect Other {
  Ping() -> Int
}

fn run_cb(_ f: () -> Int with Box[String]) -> Int with Box[String] {
  f()
}

fn run_int(_ f: () -> Int with Box[Int]) -> Int {
  handle {
    f()
  } with { Box::Put(n) => resume(n + 1) }
}

fn pure_lambda() -> Int with Box[String] {
  let g = () -> Int {
    3
  }
  run_cb(g) + run_int(g)
}

fn put_s() -> Int with Box[String] {
  perform Box::Put("s")
}

fn performs() -> Int with Box[String] {
  run_cb(put_s)
}

fn run() -> Int {
  handle {
    pure_lambda() + performs()
  } with { Box::Put(_) => resume(1) }
}

test "a pure callback adapts to two effect instantiations" {
  inspect(run(), content = "7")
}
