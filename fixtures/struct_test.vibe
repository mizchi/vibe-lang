//# Types

struct Point { x: Int; y: Int } derive(Eq)
struct Color { r: Int; g: Int; b: Int } derive(Eq)

//# Misc

test "struct create and access" {
  let p = Point::{ x: 3, y: 4 }
  assert(p.x == 3)
  assert(p.y == 4)
}

test "struct equality" {
  let a = Point::{ x: 1, y: 2 }
  let b = Point::{ x: 1, y: 2 }
  let c = Point::{ x: 3, y: 4 }
  assert(a == b)
  assert(a != c)
}

test "struct in match" {
  let p = Point::{ x: 10, y: 20 }
  let sum = match p {
    Point::{ x, y } => x + y
  }
  assert(sum == 30)
}

test "struct in array" {
  let points = [
    Point::{ x: 0, y: 0 },
    Point::{ x: 1, y: 1 },
    Point::{ x: 2, y: 2 }
  ]
  assert(points[0].x == 0)
  assert(points[2].y == 2)
}

test "struct in option" {
  let opt: Option[Point] = Some(Point::{ x: 5, y: 10 })
  let result = match opt {
    Some(p) => p.x + p.y,
    None => 0
  }
  assert(result == 15)
}

test "struct with three fields" {
  let c = Color::{ r: 255, g: 128, b: 0 }
  assert(c.r == 255)
  assert(c.g == 128)
  assert(c.b == 0)
}

test "struct equality with three fields" {
  let a = Color::{ r: 0, g: 0, b: 0 }
  let b = Color::{ r: 0, g: 0, b: 0 }
  assert(a == b)
}

test "struct as function arg" {
  let distance_sq: (Point) -> Int = (p) -> { p.x * p.x + p.y * p.y }
  assert(distance_sq(Point::{ x: 3, y: 4 }) == 25)
}
