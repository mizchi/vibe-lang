// #1985 regression guard: the gc lane's local frame must stay LINEAR in
// branch-nesting depth.
//
// Both arms of every `if` bind at the same lexical depth, so a lane that
// reuses sibling slots (linear always did; the gc lane does since #1985) needs
// one set of slots per LEVEL, while a lane that starts each arm above its
// sibling's high-water mark needs one per PATH -- 2^depth of them. At depth 5
// that is the difference between ~11 locals and ~125.
//
// The shape is generated rather than hand-written on purpose: the point is the
// full binary tree, and the count is what the gate reads
// (scripts/wasm_local_counts.mjs). Nothing here binds a typed wasm-gc local --
// fixtures/gc_sibling_slot_reuse.vibe covers the arms that do, which are the
// ones that must still NOT share slots.

fn nested_no_typed(n: Int) -> Int {
  let acc = n
  if n > 5 {
    let t5 = acc + 5
    let acc = t5 * 2
    if n > 4 {
      let t4 = acc + 4
      let acc = t4 * 2
      if n > 3 {
        let t3 = acc + 3
        let acc = t3 * 2
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      } else {
        let e3 = acc - 3
        let acc = e3 + 3
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      }
    } else {
      let e4 = acc - 4
      let acc = e4 + 3
      if n > 3 {
        let t3 = acc + 3
        let acc = t3 * 2
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      } else {
        let e3 = acc - 3
        let acc = e3 + 3
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      }
    }
  } else {
    let e5 = acc - 5
    let acc = e5 + 3
    if n > 4 {
      let t4 = acc + 4
      let acc = t4 * 2
      if n > 3 {
        let t3 = acc + 3
        let acc = t3 * 2
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      } else {
        let e3 = acc - 3
        let acc = e3 + 3
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      }
    } else {
      let e4 = acc - 4
      let acc = e4 + 3
      if n > 3 {
        let t3 = acc + 3
        let acc = t3 * 2
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      } else {
        let e3 = acc - 3
        let acc = e3 + 3
        if n > 2 {
          let t2 = acc + 2
          let acc = t2 * 2
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        } else {
          let e2 = acc - 2
          let acc = e2 + 3
          if n > 1 {
            let t1 = acc + 1
            let acc = t1 * 2
            acc
          } else {
            let e1 = acc - 1
            let acc = e1 + 3
            acc
          }
        }
      }
    }
  }
}

test "nested branches evaluate the same however slots are numbered" {
  inspect(nested_no_typed(9), "546")
  inspect(nested_no_typed(3), "10")
  inspect(nested_no_typed(0), "0")
}

export let main = () -> Int {
  nested_no_typed(9)
}
