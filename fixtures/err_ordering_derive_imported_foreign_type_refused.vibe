// #3042 (Codex on #3063): an imported signature that carries an `Ordering` of
// another shape does not stand in for the prelude. This module never sees that
// declaration (only `order_of` is imported), so the checker seeds the prelude;
// the merged program then holds the foreign `Ordering` and no `Less`, and the
// build stopped with an internal compiler error. The lowering now refuses it,
// naming the rename (tests/gates/early/run.sh).
import ./modules/ordering_foreign_type_dep.vibe { order_of }

struct Point { x: Int; y: Int } derive (Ord)

fn main() -> Unit {
  let _ = order_of(1)
  let _ = Point::compare(Point::{ x: 1, y: 2 }, Point::{ x: 3, y: 4 })
}
