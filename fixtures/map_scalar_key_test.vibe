// #2334: the builtin map takes `Int`, `Char` and `Bool` keys. The checker
// types each keyed call's key, and a scalar key is compared as an exact i64
// value -- never hashed or compared as a String pointer.

fn int_map(_ n: Int) -> Map[Int, Int] {
  let mut m: Map[Int, Int] = Map::new()
  let mut i = 0
  while i < n {
    m = Map::set(m, key = i * 7, value = i)
    i = i + 1
  }
  m
}

test "Int keys: set, get, has_key, size" {
  let m = Map::set(Map::set(Map::new(), key = 1, value = "one"), key = 2, value = "two")
  inspect(Map::get(m, key = 1), content = "one")
  inspect(Map::get(m, key = 2), content = "two")
  inspect(Map::has_key(m, key = 2), content = "true")
  inspect(Map::has_key(m, key = 3), content = "false")
  inspect(Map::size(m), content = "2")
}

test "Int keys past the index threshold" {
  // 20 entries: a String-keyed map builds its hash index at 8.
  let m = int_map(20)
  inspect(Map::size(m), content = "20")
  inspect(Map::get(m, key = 0), content = "0")
  inspect(Map::get(m, key = 133), content = "19")
  inspect(Map::has_key(m, key = 134), content = "false")
}

test "overwriting an Int key keeps one entry" {
  let m = Map::set(int_map(10), key = 14, value = 99)
  inspect(Map::size(m), content = "10")
  inspect(Map::get(m, key = 14), content = "99")
}

test "delete by Int key" {
  let m = Map::delete(int_map(10), key = 21)
  inspect(Map::size(m), content = "9")
  inspect(Map::has_key(m, key = 21), content = "false")
  inspect(Map::has_key(m, key = 28), content = "true")
}

test "Int keys that agree in their low 32 bits are distinct" {
  let a = 5
  let b = 5 + (1 << 32)
  let m = Map::set(Map::set(Map::new(), key = a, value = "low"), key = b, value = "high")
  inspect(Map::size(m), content = "2")
  inspect(Map::get(m, key = a), content = "low")
  inspect(Map::get(m, key = b), content = "high")
}

test "keys are returned as Ints" {
  let m: Map[Int, String] = Map::set(Map::set(Map::new(), key = 30, value = "x"), key = 12, value = "y")
  let mut total = 0
  for k in Map::keys(m) {
    total = total + k
  }
  inspect(total, content = "42")
}

test "for-in over an Int-keyed map binds Int keys" {
  let m = int_map(4)
  let mut total = 0
  for k in m {
    total = total + k
  }
  inspect(total, content = "42")
}

test "Char and Bool keys" {
  let c = Map::set(Map::set(Map::new(), key = 'a', value = 1), key = 'b', value = 2)
  inspect(Map::get(c, key = 'b'), content = "2")
  inspect(Map::has_key(c, key = 'z'), content = "false")
  let flags = Map::set(Map::set(Map::new(), key = true, value = "yes"), key = false, value = "no")
  inspect(Map::get(flags, key = false), content = "no")
  inspect(Map::size(flags), content = "2")
}

test "a String-keyed map past the index threshold is unchanged" {
  let mut m: Map[String, Int] = Map::new()
  let mut i = 0
  while i < 20 {
    m = Map::set(m, key = "k\{i}", value = i)
    i = i + 1
  }
  inspect(Map::get(m, key = "k17"), content = "17")
  inspect(Map::has_key(m, key = "k20"), content = "false")
}

test "indexing an Int-keyed map" {
  let m = int_map(12)
  inspect(m[77], content = "11")
}

test "== on Int-keyed maps compares keys and values" {
  let a = Map::set(Map::set(Map::new(), key = 1, value = 10), key = 2, value = 20)
  let b = Map::set(Map::set(Map::new(), key = 2, value = 20), key = 1, value = 10)
  let c = Map::set(Map::new(), key = 1, value = 10)
  inspect(a == b, content = "true")
  inspect(a == c, content = "false")
}
