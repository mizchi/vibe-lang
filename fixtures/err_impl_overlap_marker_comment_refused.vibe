// #3551: one module writes `impl Name for Int`; another writes the same impl
// and opens with the comment line the loader puts on a contract facade. The
// overlap check took that comment for provenance and skipped the module, so
// this built and printed `from-a from-a` -- `from-marker from-marker` with the
// imports swapped. No unit is exempt by its text or its path now, and this is
// refused, naming both impls.

import ./modules/impl_overlap_a.vibe {
  a_name
}

import ./modules/impl_overlap_marker_comment.vibe {
  marker_name
}

test "both modules keep their own impl" {
  inspect("\{a_name()} \{marker_name()}", "from-a from-marker")
}
