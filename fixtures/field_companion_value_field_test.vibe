//# #3896: a field holding a value may share its name with a companion; the
//# field is read as `s.size` and the companion is called as `S::size(s)`.
//# (`s.size()` is refused: see
//# `typecheck/err_type_dot_call_value_field_companion.vibe`.)

struct S {
  size: Int
}

fn S::size(_ s: S) -> Int {
  s.size * 10
}

test "a value field and a companion of one name" {
  let s = S::{ size: 3 }
  inspect(s.size, content = "3")
  inspect(S::size(s), content = "30")
}
