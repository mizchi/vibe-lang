// #3569: a bodyless impl's fallback whose bounded formal `U` appears in no
// `Self` parameter. The trait reaches `Tag::name` with a `Tag[String]`, which
// says nothing about `U`, so its `Eq` witness cannot be built. Before, the
// call through `via` was emitted one dictionary short and the wasm validator
// rejected the module after a clean `vibe check`; now the build refuses it,
// naming the edit. The accepted side is
// `fixtures/impl_bodyless_bounded_fallback_test.vibe`.

trait Name {
  name(Self, Int) -> Int
}

struct Tag[T] {
  t: T
}

impl Name for Tag[String]

fn Tag::name[U: Eq](self: Tag[String], x: U) -> Int {
  if x == x {
    2
  } else {
    0
  }
}

fn via[T: Name](x: T) -> Int {
  T::name(x, 1)
}

export let _start: () -> Int = () -> {
  let t: Tag[String] = Tag::{ t: "a" }
  via(t)
}
