import @vibe/compiler/core {
  Expr, Stmt
}

// Negative control for the host's sole-item owner check. Both arrays survive
// the call and own the same statement.
fn main() -> Array[Array[Stmt]] {
  let original = [SLet(false, false, "value", None, EInt(3))]
  let also_owns = [Array::get(original, at = 0)]
  [original, also_owns]
}
