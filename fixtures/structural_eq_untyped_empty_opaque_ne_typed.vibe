//# Pin the `!=` spelling and the `let mut` spelling of the same residual: it
//# is lowered through the same typed dispatch and then negated, so it must
//# answer by content too (#2391, after #2447).

fn fill(xs: Array[Int], v: Int) -> Unit {
  Array::push(xs, v)
}

export fn _start() -> Int {
  let mut left = [
  ]
  fill(left, 1)
  let mut right = [
  ]
  fill(right, 2)
  let mut same = [
  ]
  fill(same, 1)
  assert(left != right)
  assert(!(left != same))
  0
}
