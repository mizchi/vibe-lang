// #3158 review: `Add` is a marker trait, so `a + b` over an erased `[T: Add]`
// lowers to `__generic_add`, which joins two strings and otherwise runs a raw
// integer add. The prelude declares `impl Add for Double`, and measured on main
// at 18a0dcef3 `add2(1.5, 2.25)` printed `add=0` on the linear lane -- the raw
// add of two boxes. The bound is refused at `Double`, the same way the marker
// `Ord` bound is (fixtures/err_type_ord_marker_bound_double.vibe), and this file
// pins the MESSAGE, not just the refusal.

fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

fn main() -> Unit allows Console {
  println(__to_string(add2(1.5, 2.25)))
}
