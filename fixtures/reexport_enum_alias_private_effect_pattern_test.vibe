import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

effect Logger {
  A -> Int
}

test "an effect operation with the same name keeps its own handler" {
  let value = handle {
    perform Logger::A
  } with { Logger::A => resume(7) }
  inspect(value, content = "7")
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
}
