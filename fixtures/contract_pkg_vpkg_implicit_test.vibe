// #897/#855 (ADR-0070 Phase 1): a .vpkg contract gets implicit membership
// unconditionally -- `explicit_fn` (via the old `import ./impl.vibe {}`
// idiom) and `implicit_fn` (from `extra.vibe`, never imported at all)
// coexist in the same package. The `_scratch.vibe` and `internal_test.vibe`
// siblings are excluded from the impl set (see their own file comments);
// this whole file failing to compile would mean either exclusion is
// broken (a conformance violation from their extraneous exports) or
// implicit membership itself isn't merging in `extra.vibe`.

import ./contract_pkg_vpkg_implicit { explicit_fn, implicit_fn }

test "explicit + implicit membership coexist in a .vpkg package (#897/#855)" {
  assert_eq(explicit_fn(41), 42)
  assert_eq(implicit_fn(40), 42)
}
