// #2969: a handler arm for a resumable operation hands its value back to the
// `perform` with `resume(...)` on every tail, or leaves the arm with `return`
// / `throw`. A bare tail value used to be an implicit resume (#2962); it is
// refused now (fixtures/typecheck/handler_arm_bare_tail_*_reject.vibe), so
// the shapes below are the accepted spellings and the answers they give.

effect Cfg {
  Get() -> Int
}

effect Log {
  Emit(String) -> Unit
}

effect Name {
  Get() -> String
}

fn add_hundred() -> Int with Cfg {
  let a = perform Cfg::Get()
  a + 100
}

fn work() -> Int with Log {
  perform Log::Emit("first")
  perform Log::Emit("second")
  42
}

fn greet_len() -> Int with Name {
  let s = perform Name::Get()
  String::length(s)
}

test "a tail resume delivers its value to the perform and the body continues" {
  let r = handle {
    add_hundred()
  } with { Cfg::Get() => resume(5) }
  assert_eq(r, 105)
}

test "a Unit-returning operation's arm resumes with unit inside an Int body" {
  let sink: Array[String] = []
  let r = handle {
    work()
  } with { Log::Emit(msg) => {
    Array::push(sink, msg)
    resume(())
  } }
  assert_eq(r, 42)
  assert_eq(Array::length(sink), 2)
  assert_eq(Array::get(sink, 1), "second")
}

test "the resumed value is checked against the operation's return type, not the body's" {
  let r = handle {
    greet_len()
  } with { Name::Get() => resume("abcd") }
  assert_eq(r, 4)
}

test "a lambda parameter named resume? shadows the continuation for the checker and the lowering alike" {
  // #2985 review: the lowering's shadow walk stripped only `~`, so this
  // arm was classified differently by the checker and by the lowering, and
  // the string became the handle's Int result (measured 296352743426).
  let r = handle {
    greet_len()
  } with { Name::Get() => {
    let h = (resume?: Int) -> Int {
      match resume {
        Some(v) => v
        None => 0
      }
    }
    let _ = h()
    resume("abcd")
  } }
  assert_eq(r, 4)
}

test "every branch of a tail if resumes" {
  let a = handle {
    greet_len()
  } with { Name::Get() => if true {
    resume("ok")
  } else {
    resume("no")
  } }
  let b = handle {
    greet_len()
  } with { Name::Get() => if false {
    resume("ok")
  } else {
    resume("three")
  } }
  assert_eq(a, 2)
  assert_eq(b, 5)
}

effect Word {
  Get() -> String
}

fn pick_or_leave(flag: Bool) -> Int {
  // #2985 review (Codex P2): an arm whose every tail is `return` has no
  // value to resume with -- the return leaves the function.
  let r = handle {
    String::length(perform Word::Get()) + 1
  } with { Word::Get() => if flag {
    return 42
  } else {
    return 7
  } }
  r * 10
}

test "an arm that only returns does not resume" {
  assert_eq(pick_or_leave(true), 42)
  assert_eq(pick_or_leave(false), 7)
}

fn pick_or_answer(flag: Bool) -> Int {
  // A `return` in one branch next to a resume in the other (Codex P2 on
  // #2985): the returning branch leaves, the other resumes the perform.
  let r = handle {
    String::length(perform Word::Get()) + 1
  } with { Word::Get() => if flag {
    return 42
  } else {
    resume("abcd")
  } }
  r * 10
}

test "a return in one branch of an arm; the other branch resumes" {
  assert_eq(pick_or_answer(true), 42)
  assert_eq(pick_or_answer(false), 50)
}

fn pick_or_throw(flag: Bool) -> Int with Exception {
  // A `throw` leaves the arm through the enclosing Exception handler, so it
  // is not a bare tail either.
  handle {
    String::length(perform Word::Get())
  } with { Word::Get() => if flag {
    throw("no word")
  } else {
    resume("xyz")
  } }
}

test "a throw in one branch of an arm; the other branch resumes" {
  let a = handle {
    pick_or_throw(true)
  } with { Exception::Throw(_) => -1 }
  let b = handle {
    pick_or_throw(false)
  } with { Exception::Throw(_) => -1 }
  assert_eq(a, -1)
  assert_eq(b, 3)
}
