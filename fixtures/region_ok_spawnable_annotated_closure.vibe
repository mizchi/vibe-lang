// #3152 review: a local closure bound with a type annotation
// (`let f: () -> Int = () -> k`) is the parser's ascription call around the
// literal. Its captures are recorded through that wrapper, so a later
// `TaskGroup::spawn(n, f)` is checked like the literal and, capturing only a
// Send `Int`, compiles. 41.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

export let main = () -> Int with Exception {
  let k = 40
  TaskGroup::run((n) -> {
    let f: () -> Int = () -> k + 1
    TaskHandle::join(TaskGroup::spawn(n, f))
  })
}

test "region ok spawnable annotated closure" allows Exception {
  inspect(main(), "41")
}
