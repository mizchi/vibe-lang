// A `handle ... with E` over a user-declared multi-operation effect must cover
// every operation of E (or carry a catch-all arm). Here `Calc` declares Add and
// Sub but the handler only covers Add, so `Calc::Sub` would be unhandled.
effect Calc {
  Add(Int) -> Int;
  Sub(Int) -> Int
}

let work = () -> Int with { Calc } {
  perform Calc::Add(1)
}

let main = () -> Int {
  handle { work() } with Calc {
    Add(x) => resume(x + 1)
  }
}

__DATA__
{"error_contains": "non-exhaustive handler"}
