// #3490 control: with no top-level value of its name, the namespace reaches
// the import, and a local of its name still shadows it (#897).

import ./dep.vibe as helper only {
  greet
}

struct LocalHelper {
  greet: (String) -> String
}

fn local_shadow() -> String {
  let helper = LocalHelper::{ greet: (name) -> String::concat("local ", name) }
  helper.greet("value")
}

test "an unshadowed namespace reaches the import" {
  inspect(helper.greet("value", Some(2)), content = "value x2")
  inspect(local_shadow(), content = "local value")
}
