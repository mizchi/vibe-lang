// #3490: a top-level value spelled like a qualified-import namespace shadows
// it, as a local one does (#897). The checker typed `helper.greet` as the
// value's field while the program called the import and printed `value x1`.

import ./dep.vibe as helper only {
  greet
}

struct LocalHelper {
  greet: (String) -> String
}

let helper = LocalHelper::{ greet: (name) -> String::concat("top ", name) }

fn through_fn() -> String {
  helper.greet("fn")
}

test "a top-level value shadows the qualified-import namespace" {
  inspect(helper.greet("value"), content = "top value")
  inspect(through_fn(), content = "top fn")
}
