// Codex on #3492: a top-level `let`-pattern that rebinds a qualified
// import's namespace still reads the import in its own initializer, as the
// checker does. Before, the merged program dropped the alias module-wide and
// the build stopped with "unknown struct field: greet".
import ./dep.vibe as helper only {
  greet
}

let (helper, n) = (helper.greet("x"), 1)

test "a let-pattern's initializer reads the namespace it rebinds" {
  inspect(helper, content = "x x1")
  inspect(n, content = "1")
}
