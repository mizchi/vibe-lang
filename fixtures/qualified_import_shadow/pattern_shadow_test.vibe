// #3490 (Codex on #3492): a top-level pattern binding shadows the namespace
// too.

import ./dep.vibe as helper only {
  greet
}

struct LocalHelper {
  greet: (String) -> String
}

let (helper, n) = (LocalHelper::{ greet: (name) -> String::concat("pat ", name) }, 3)

test "a top-level pattern binding shadows the qualified-import namespace" {
  inspect(helper.greet("value"), content = "pat value")
  inspect(n, content = "3")
}
