fn receiver(trace: Array[Int], values: Array[Int]) -> Array[Int] {
  trace[0] = trace[0] * 10 + 1
  values
}
fn index(trace: Array[Int]) -> Int {
  trace[0] = trace[0] * 10 + 2
  1
}
fn value(trace: Array[Int]) -> Int {
  trace[0] = trace[0] * 10 + 3
  16
}

test "Array set evaluates its receiver index and value once in source order" {
  let trace: Array[Int] = [0]
  let values: Array[Int] = Array::with_capacity(4)
  Array::push(values, 29)
  Array::push(values, 11)
  Array::set(receiver(trace, values), index(trace), value(trace))
  inspect(trace[0], content = "123")
  inspect(values[0] - values[1], content = "13")
}

test "first-class Array builtins carry their operation identities" {
  let reserve = Array::with_capacity
  let push = Array::push
  let set = Array::set
  let values: Array[Int] = reserve(4)
  push(values, 29)
  push(values, 11)
  set(values, 1, 16)
  inspect(values[0] - values[1], content = "13")
}

test "Array mutation preserves heap element ownership" {
  let values: Array[String] = Array::with_capacity(4)
  Array::push(values, "before")
  Array::set(values, 0, "after")
  inspect(values[0], content = "after")
}

test "native GC array mutation preserves aliases" {
  let original = [29, 11]
  let alias = original
  Array::set(alias, 1, 16)
  inspect(original[0] - original[1], content = "13")
}
