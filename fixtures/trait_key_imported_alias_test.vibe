//# #3953: an applied trait key spelled through an IMPORTED type alias names
//# its expansion, so the impl and a bound spelled the other way meet: the
//# alias imported directly or through a re-export, with the impl through the
//# alias and the bound expanded, and the reverse.

import ./modules/trait_key_imported_alias_defs.vibe {
  Alias
}

import ./modules/trait_key_imported_alias_reexport.vibe {
  Alias as Again
}

trait Value[A] {
  value(Self) -> A
}

struct Note {
  n: Int
}

impl Value[Alias] for Note {
  value(self) -> Alias {
    self.n
  }
}

fn int_value_of[V: Value[Int]](_ v: V) -> Int {
  V::value(v)
}

fn alias_value_of[V: Value[Alias]](_ v: V) -> Int {
  V::value(v)
}

trait Size[A] {
  size(Self) -> A
}

struct Cell {
  n: Int
}

impl Size[Int] for Cell {
  size(self) -> Int {
    self.n
  }
}

fn size_through_alias[V: Size[Alias]](_ v: V) -> Int {
  V::size(v)
}

fn size_through_reexport[V: Size[Again]](_ v: V) -> Int {
  V::size(v)
}

fn value_through_reexport[V: Value[Again]](_ v: V) -> Int {
  V::value(v)
}

test "impl through the imported alias, bound expanded" {
  inspect(int_value_of(Note::{ n: 6 }), content = "6")
  inspect(alias_value_of(Note::{ n: 7 }), content = "7")
}

test "impl expanded, bound through the imported alias" {
  inspect(size_through_alias(Cell::{ n: 8 }), content = "8")
}

test "through a re-exported alias" {
  inspect(size_through_reexport(Cell::{ n: 9 }), content = "9")
  inspect(value_through_reexport(Note::{ n: 10 }), content = "10")
}
