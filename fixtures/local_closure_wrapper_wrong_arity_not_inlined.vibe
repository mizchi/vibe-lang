// #1070 narrow-slice regression: dtpw_collect_wrappers (desugar_trait_dict.vibe)
// must only recognize a wrapper whose body is EXACTLY a same-arity direct
// call to its own sole parameter with NO extra arguments (e.g.
// `apply = (f) -> { f() }`). A function that calls its parameter WITH an
// argument (`apply_with_arg = (f) -> { f(5) }`) is a different shape --
// inlining `apply_with_arg(g)` into `g` would silently drop the call
// entirely (the exact bug caught and fixed in dtpw_inline_expr's first
// draft, which is why this negative case matters). This fixture pins that
// such a wrapper is correctly left untouched and unaffected.
//   g = (x) -> x + 1, apply_with_arg(g) => g(5) => 6
let apply_with_arg = (f: (Int) -> Int) -> Int {
  f(5)
}

export let main = () -> Int {
  let g = (x: Int) -> Int {
    x + 1
  }
  apply_with_arg(g)
}

// #1571: the expectation lives here, checked by `inspect` and updatable
// with `vibe test --update`, instead of in a `__DATA__` tail the gate has
// to `sed` off and compare in shell.
test "local closure wrapper wrong arity not inlined" {
  inspect(main(), "6")
}
