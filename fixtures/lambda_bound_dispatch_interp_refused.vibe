//# #2737: interpolating a value whose type is a lambda binder's is refused.
//
// The interpolation rung consults the same `find_dict_for_method` as the two
// explicit spellings, so before the fix it took the enclosing binder's `Show`
// dictionary by spelling. Measured on main at 8f70aa1, `outer` at `Pt` with
// `inner` applied to a `Qt` printed `Pt!` -- a `Qt` rendered through
// `Pt::to_string`, the same defect as the `Eq` one and the reason the withholding
// guard lives in the lookup rather than in the `==` rung.
//
// This rung LOOKS like one that can fall through honestly, because interpolation
// has a total builtin renderer. It cannot, and that was measured rather than
// assumed: with the dictionary withheld and nothing else changed, the same
// program printed `284` -- the tagged pointer. A formal-typed value is erased, so
// the renderer reads a representation, not a value. `Pt!` is a lie about the type
// and `284` is not information; neither is the program's value, so the rung is
// refused like the others.
//
// A SCALAR does render truthfully, and it never reaches here: `interp_shape`
// answers first. That is also why a top-level `[T: Show]` applied to `7` prints
// `7` and not `Int!` (measured on both sides of this change -- pre-existing, and
// untouched by it).

trait Show {
  to_string(Self) -> String
}

struct Pt {
  v: Int
}

struct Qt {
  w: Int
}

impl Show for Pt {
  to_string(a: Pt) -> String {
    "Pt!"
  }
}

impl Show for Qt {
  to_string(a: Qt) -> String {
    "Qt!"
  }
}

fn outer_show[T: Show](x: T) -> String {
  let inner = [T: Show](a: T) -> String {
    "\{a}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer_show(Pt::{ v: 1 }))
}
