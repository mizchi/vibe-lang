//# Codex round 16 on #2456: an explicit comparator is admitted only when it
//# carries no effect row. The `==` desugar injects the comparator call after
//# effect checking, so a `Wrap::equals ... with Console` would run inside
//# this pure `_start` without the caller carrying `Console`. Measured on
//# 81bc3f6: this program printed "cmp" from a function checked as pure and
//# returned 0. It must TRAP once both sides are non-empty. (A comparator
//# whose body performs an effect it does not declare is rejected by the
//# checker at its declaration, so the annotation is the whole contract.)

enum Wrap[T] {
  W(T);
  Empty
}

fn Wrap::equals(a: Wrap[Array[Int]], b: Wrap[Array[Int]]) -> Bool with Console {
  Console::write_stream("cmp\n")
  match a {
    W(x) => match b {
      W(y) => x == y,
      _ => false
    },
    Empty => match b {
      Empty => true,
      _ => false
    }
  }
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    0
  } else {
    1
  }
}
