import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

type Local = Api

test "a local type alias qualifies the private constructor" {
  inspect(match Api::A {
    Local::A => 1,
    Local::B => 2
  }, content = "1")
  inspect(match Api::B {
    Local::A => 1,
    Local::B => 2
  }, content = "2")
}
