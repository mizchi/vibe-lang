//# Pin the `!=` spelling of the same residual: it is lowered through the same
//# guarded equality and then negated, so it must fail closed too.

fn fill(xs: Array[Int], v: Int) -> Unit {
  Array::push(xs, v)
}

export fn _start() -> Int {
  let mut left = [
  ]
  fill(left, 1)
  let mut right = [
  ]
  fill(right, 2)
  if left != right {
    1
  } else {
    0
  }
}
