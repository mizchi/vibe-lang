// #1279: `Exception` is the interim abortive alias of `Error`, not the
// proposed generic `Exception[E]` from ADR-0085. Both spellings use the same
// Throw tag and may handle each other during the compatibility bridge.

fn divide(x: Int) -> Int with Exception {
  if x == 0 {
    perform Exception::Throw("division by zero")
  }
  100 / x
}

fn legacy_fail() -> Int with Exception {
  throw("legacy failure")
}

test "Exception Throw is abortive and handled on its own alias" {
  let safe = handle {
    divide(0)
  } with {
    Exception::Throw(_) => 0 - 1
  }
  let fine = handle {
    divide(4)
  } with {
    Exception::Throw(_) => 0 - 1
  }
  assert(safe == 0 - 1)
  assert(fine == 25)
}

test "Error and Exception handler spellings share the abortive tag" {
  let caught_by_error = handle {
    divide(0)
  } with {
    Exception::Throw(_) => 10
  }
  let caught_by_exception = handle {
    legacy_fail()
  } with {
    Exception::Throw(_) => 20
  }
  assert(caught_by_error == 10)
  assert(caught_by_exception == 20)
}
