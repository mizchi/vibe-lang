// #3538: an impl is held to its trait's signature through two more routes:
// the `<Type>::<method>` function a bodyless impl dispatches to, wherever it
// is declared, and an inherited method under an applied subtrait. These match
// the trait, and still compile and answer through a bound.

// A bodyless impl dispatches to `Q::label`, declared behind another statement.
trait Label {
  label(Self) -> Int
}

struct Q { y: Int }

impl Label for Q

fn unrelated() -> Int {
  0
}

fn Q::label(self: Q) -> Int {
  self.y + 100
}

fn labeled[T: Label](v: T) -> Int {
  T::label(v)
}

test "a matching fallback after another statement answers through a bound" {
  inspect(labeled(Q::{ y: 5 }) + unrelated(), "105")
}

// An inherited method takes the subtrait's applied argument by position.
trait Base[A] {
  get(Self) -> A
}

trait Child[A]: Base {}

struct R { z: Int }

impl Child[Int] for R {
  get(self) -> Int {
    self.z * 2
  }
}

fn got[T: Child[Int]](v: T) -> Int {
  T::get(v)
}

test "an inherited method matching the applied subtrait answers through a bound" {
  inspect(got(R::{ z: 21 }) + 1, "43")
}
