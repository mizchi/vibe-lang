// #3066: a module-private enum rendered inside a render argument's payload.
// The checker's render row names it by the merged (renamed) declaration, so
// the importer's own `Hue` cannot be picked up in its place.
enum Hue {
  Red;
  Blue
} derive (Show)

export fn describe() -> String {
  let pick = () -> Blue
  let o = [Some(pick())]
  let k = () -> true
  let t = (Some(k()), Some(Red))
  "\{o} \{t}"
}
