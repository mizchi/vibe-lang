// #1967: was fixtures/trait_hierarchy_ord_implies_eq_operator.vibe +
// __DATA__.last "true".

trait LocalEq
trait LocalOrd: LocalEq
impl LocalOrd for Int

fn accepts_eq[T: LocalEq](value: T) -> Bool {
  true
}

fn same[T: LocalOrd](a: T, b: T) -> Bool {
  accepts_eq(a) && accepts_eq(b)
}

test "LocalOrd implies LocalEq operator same is true" {
  inspect(same(1, 1), "true")
}
