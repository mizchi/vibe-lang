//# Codex round 14 on #2456: an explicit comparator's signature is validated
//# through alias expansion, so a `-> Truth` result with `type Truth = Bool`
//# declared BELOW the enum must still be recognised as `Bool`. Measured on
//# 33d2043: the comparator was validated against a half-filled alias table,
//# never recorded, and both the direct compare and the untyped-empty compare
//# trapped. Both ANSWER now -- the enums' comparators are recorded only after
//# the whole declaration scan.

enum Wrap[T] {
  W(T);
  Empty
}

fn Wrap::equals(a: Wrap[Array[Int]], b: Wrap[Array[Int]]) -> Truth {
  match a {
    W(x) => match b {
      W(y) => x == y,
      _ => false
    },
    Empty => match b {
      Empty => true,
      _ => false
    }
  }
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W([v, v + 1]))
}

fn mk(v: Int) -> Wrap[Array[Int]] {
  W([v, v + 1])
}

type Truth = Bool

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  assert(left == right)
  assert(left != other)
  let a = mk(1)
  let b = mk(1)
  let c = mk(2)
  assert(a == b)
  assert(a != c)
  0
}
