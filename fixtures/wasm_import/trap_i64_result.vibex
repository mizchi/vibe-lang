// An i64 result that needs the 64th bit does not fit a 63-bit `Int`: the
// binding TRAPS instead of answering a different number.
// Asserted by scripts/test_wasm_import_gate.sh.
import ./counter.wasm {
  too_wide
}

fn main() -> Unit allows Console {
  println("before")
  println("r=\{too_wide()}")
}
