// `vibe bench` over a typed core-wasm import: each bench block gets a fresh
// instance, and the foreign module has to be linked into it too.
// Run by scripts/test_wasm_import_gate.sh.
import ./counter.wasm {
  add_i32
}

bench "foreign add_i32" {
  let mut i = 0
  let mut acc = 0
  while i < 1000 {
    acc = add_i32(acc, 1)
    i = i + 1
  }
  acc
}
