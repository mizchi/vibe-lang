// ADR-0124 decision 2 (#4082): `allows Greeter?` makes the provider optional.
// `vibe run --provide Greeter=greeter.component.wasm` grants it, and
// `perform? Greeter::greet(..)` calls the provider; with no `--provide` the
// call answers `NotGranted`, and the program runs without importing
// `vibe:effect:./Greeter` at all. Run by scripts/test_wasm_import_gate.sh.
extern effect Greeter {
  greet(String) -> String
}

fn main() -> Unit allows Console + Greeter? {
  match perform? Greeter::greet("vibe") {
    Granted(s) => println("granted: \{s}"),
    NotGranted => println("not granted"),
    Errored(e) => println("errored: \{e}")
  }
}
