// ADR-0124 (#2656): a `test` block that calls an `extern effect` runs against
// the provider `vibe test --provide Greeter=greeter.component.wasm` binds --
// the way a test mocks a host effect. The unit runner excludes it: it binds no
// provider, so it would see only the refusal. Run by
// scripts/test_wasm_import_gate.sh.
extern effect Greeter {
  greet(String) -> String
}

fn hello(name: String) -> String with Greeter {
  Greeter::greet(name)
}

test "greets through the bound provider" allows Greeter {
  inspect(hello(name = "test"), content = "hi, test")
}
