// `vibe run` over a typed core-wasm import; scripts/test_wasm_import_gate.sh
// runs it on viberun and on the node runner and compares the output.
import ./counter.wasm {
  add_i32, bump, count
}

fn main() -> Unit allows Console {
  bump(40)
  bump(UInt32::to_int(add_i32(1, 1)))
  println("count=\{count()}")
}
