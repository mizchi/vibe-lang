// #4082: the instrumented builds of `vibe run --trace` and `vibe run --break`
// take the provider grants as the plain run does, so a bound provider answers
// `Granted` there too. Before, both lowered `perform?` against an empty
// table and answered `NotGranted` with the provider bound. Run by
// scripts/test_wasm_import_gate.sh.
extern effect Greeter {
  greet(String) -> String
}

fn main() -> Unit allows Console + Greeter? {
  match perform? Greeter::greet("debug") {
    Granted(s) => println("granted: \{s}"),
    NotGranted => println("not granted"),
    Errored(e) => println("errored: \{e}")
  }
}
