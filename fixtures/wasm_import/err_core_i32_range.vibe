// #3730: a core module's `i32` is offered as `UInt32`, so an argument that
// fits no 32-bit reading is a compile-time error at the call. Before, it was
// an `Int` the binding's stub trapped at run time. Asserted by
// scripts/test_wasm_import_gate.sh.
import ./counter.wasm {
  add_i32
}

fn main() -> Unit allows Console {
  println("r=\{add_i32(4294967296, 1)}")
}
