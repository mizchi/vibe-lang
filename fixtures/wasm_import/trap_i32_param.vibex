// An `Int` outside both readings of 32 bits does not fit an i32 parameter:
// the binding TRAPS instead of passing a truncated, different number.
// Asserted by scripts/test_wasm_import_gate.sh.
import ./counter.wasm {
  add_i32
}

fn main() -> Unit allows Console {
  println("before")
  println("r=\{add_i32(4294967296, 1)}")
}
