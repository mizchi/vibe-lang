// ADR-0124 (#2656): the entry admits an `extern effect` it reaches through
// an import, and the binding of the importing program calls the provider.
// Run by scripts/test_wasm_import_gate.sh.
import ./extern_greeter_lib.vibe {
  Greeter, hello
}

fn main() -> Unit allows Console + Greeter {
  println(hello(name = "import"))
}
