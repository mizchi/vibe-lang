// A wasm COMPONENT imported with the types its WIT declares
// (greeter.wit, built by scripts/build_wasm_import_fixtures.sh). Run on
// viberun by scripts/test_wasm_import_gate.sh.
import ./greeter.component.wasm {
  add, counter, greet
}

fn main() -> Unit allows Console {
  println(greet("vibe"))
  println("add=\{add(40, 2)}")
  let _ = counter()
  println("counter=\{counter()}")
}
