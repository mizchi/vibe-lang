// `_initialize` on both sides of the reactor convention; see reactor.wat and
// odd_init.wat. `value=7` means the real initializer ran; `foo=42 init=2`
// means the look-alike was left alone at link time and is still callable.
import ./odd_init.wasm {
  _initialize, foo
}
import ./reactor.wasm {
  value
}

fn main() -> Unit allows Console {
  println("value=\{value()} foo=\{foo()} init=\{_initialize(1)}")
}
