// An Int outside the WIT `s32` of `add` is refused by the runner's lowering
// instead of reaching the component truncated. Asserted by
// scripts/test_wasm_import_gate.sh.
import ./greeter.component.wasm {
  add
}

fn main() -> Unit allows Console {
  println("before")
  println("r=\{add(2147483648, 0)}")
}
