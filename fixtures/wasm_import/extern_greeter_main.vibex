// ADR-0124 (#2656): an `extern effect` whose provider is bound at launch.
// `Greeter::greet` lowers to field `greet#string->string` of the core import
// `vibe:effect:./Greeter`, which viberun bridges to the component that
// `vibe run --provide Greeter=greeter.component.wasm` names -- here the same
// component greeter_main.vibex imports directly. Run by
// scripts/test_wasm_import_gate.sh.
extern effect Greeter {
  greet(String) -> String
}

fn hello(name: String) -> String with Greeter {
  Greeter::greet(name)
}

fn main() -> Unit allows Console + Greeter {
  println(hello(name = "vibe"))
}
