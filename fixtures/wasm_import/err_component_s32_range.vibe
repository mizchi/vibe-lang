// #3730: the component's `add` takes WIT `s32`, which the binding offers as
// `Int32`, so an argument outside -2^31 .. 2^31-1 is a compile-time error at
// the call. Before, it was an `Int` the runner refused at run time.
// Asserted by scripts/test_wasm_import_gate.sh.
import ./greeter.component.wasm {
  add
}

fn main() -> Unit allows Console {
  println("r=\{add(2147483648, 0)}")
}
