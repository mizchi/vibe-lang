// The memory accessors over an exported SHARED memory; see shared_memory.wat.
// A byte the module's data segment wrote is read by the accessor, a byte the
// accessor stores is read by the module, and the size is one 64 KiB page.
import ./shared_memory.wasm {
  peek, wasm_memory_load_u8, wasm_memory_size, wasm_memory_store_u8
}

fn main() -> Unit allows Console {
  wasm_memory_store_u8(5, 7)
  println("load=\{wasm_memory_load_u8(3)} peek=\{peek(5)} size=\{wasm_memory_size()}")
}
