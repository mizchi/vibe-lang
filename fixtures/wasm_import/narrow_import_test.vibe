// #3826: a component's WIT `u8` / `s16` are offered as `UInt32` / `Int32`,
// the 32-bit types whose values hold every narrow one, so an in-range call
// answers exactly. A component runs on viberun only, so the unit runner (node)
// excludes this file and scripts/test_wasm_import_gate.sh runs it on viberun,
// on both RC lanes. An argument outside the narrow range is refused at the
// call (trap_component_u8_range.vibex).
import ./narrow.component.wasm {
  inc8, neg16
}

test "u8 and s16 answer exactly in range" {
  inspect(inc8(254), content = "255")
  inspect(neg16(-32767), content = "32767")
  inspect(neg16(300), content = "-300")
}
