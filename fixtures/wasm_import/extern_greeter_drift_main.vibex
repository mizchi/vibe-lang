// ADR-0124 (#2656): a provider whose export does not have the declared
// signature is refused at link time, before `main`: this program declares
// `greet(Int) -> Int`, and greeter.component.wasm exports
// `greet: func(name: string) -> string`. Run by
// scripts/test_wasm_import_gate.sh.
extern effect Greeter {
  greet(Int) -> Int
}

fn main() -> Unit allows Console + Greeter {
  println("greet=\{Greeter::greet(1)}")
}
