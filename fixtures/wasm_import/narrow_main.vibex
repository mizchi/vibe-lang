// #3826: a component's WIT `u8` / `s16` are offered as `UInt32` / `Int32`,
// the 32-bit types whose values hold every narrow one, so an in-range call
// answers exactly. Run on viberun by scripts/test_wasm_import_gate.sh; an
// argument outside the narrow range is refused at the call
// (trap_component_u8_range.vibex).
import ./narrow.component.wasm {
  inc8, neg16
}

fn main() -> Unit allows Console {
  println("inc8=\{inc8(254)}")
  println("neg16=\{neg16(-32767)}")
  println("neg16=\{neg16(300)}")
}
