// #4082: a test reaches an optional `extern effect` operation through a
// helper declared `with Greeter?`, with `vibe test --provide Greeter=greeter.component.wasm` binding it, so `perform?` reaches the provider.
// A test build grants the standard providers ambiently, but an extern effect
// only through a bound provider. The unit runner excludes it; run by
// scripts/test_wasm_import_gate.sh.
extern effect Greeter {
  greet(String) -> String
}

fn try_greet(name: String) -> String with Greeter? {
  match perform? Greeter::greet(name) {
    Granted(s) => s,
    NotGranted => "nobody",
    Errored(e) => e
  }
}

test "answers through the binding, or NotGranted" allows Greeter? {
  inspect(try_greet(name = "test"), content = "hi, test")
}
