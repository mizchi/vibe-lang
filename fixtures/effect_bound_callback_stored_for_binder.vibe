// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7, () -> 8]
    let mut total = 0
    for f in xs {
      total = total + apply(f = f)
      Array::set(xs, at = 1, value = g)
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
