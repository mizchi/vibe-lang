// `Array::truncate` only ever shrinks (#3115 review of #2837). A length at or
// above the current one, or a negative one, used to be stored as-is, exposing
// slots past the live prefix: stale elements, memory past the capacity, or
// elements a planned truncate release had already dropped.

test "a larger length leaves the array unchanged" {
  let xs = [1, 2, 3]
  Array::truncate(xs, length = 1)
  Array::truncate(xs, length = 3)
  inspect(Array::length(xs), content = "1")
  Array::push(xs, value = 9)
  inspect(xs, content = "[1, 9]")
}

test "a negative length leaves the array unchanged" {
  let xs = [1, 2, 3]
  Array::truncate(xs, length = -1)
  inspect(Array::length(xs), content = "3")
}

test "the current length is a no-op and a smaller one shrinks" {
  let xs = [[1], [2], [3]]
  Array::truncate(xs, length = 3)
  inspect(Array::length(xs), content = "3")
  Array::truncate(xs, length = 0)
  inspect(Array::length(xs), content = "0")
}

test "a length past the 32-bit range is compared in full, not wrapped" {
  let xs = [1, 2, 3]
  Array::truncate(xs, length = 1 << 32)
  inspect(Array::length(xs), content = "3")
  Array::truncate(xs, length = (1 << 32) + 1)
  inspect(Array::length(xs), content = "3")
  Array::truncate(xs, length = 0 - ((1 << 32) - 1))
  inspect(Array::length(xs), content = "3")
}
