// #3378: a generic called above its declaration is accepted when its body
// leaves every formal free; only a body that fixes one is refused
// (`fixtures/typecheck/err_generic_forward_call_fixes_formal.vibe`).
fn caller() -> (Int, String) {
  (first_of(1, "a"), first_of("b", 2))
}

fn first_of[A, B](a: A, b: B) -> A {
  let _ = b
  a
}

fn add_one[T](x: T) -> Int {
  x + 1
}

fn add_one_after(x: Int) -> Int {
  add_one(x)
}

test "a forward call to a generic whose formals stay free" {
  inspect(caller(), "(1, b)")
}

test "a generic that fixes its formal, called below its declaration" {
  inspect(add_one_after(3), "4")
}
