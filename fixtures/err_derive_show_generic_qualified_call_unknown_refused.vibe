// #3559: `H::to_string(h)` inside a generic function, where `h`'s type
// arguments are not known. The derived renderer erases them, so
// `show_it(H::{ v: 1.5 })` printed `H { v: 276 }`. The call is refused with
// the edit, the way interpolating `h` is (#3082).
struct H[T] {
  v: T
} derive (Show)

fn show_it[T](h: H[T]) -> String {
  H::to_string(h)
}

export let _start: () -> Int = () -> {
  let _ = show_it(H::{ v: 1.5 })
  0
}
