//# Codex round 4 on #2456: a `struct` may own the `Result` spelling too. It
//# is not an enum at all, so neither the `Ok`/`Err` arm nor a derived enum
//# comparator applies; it is a generic struct and takes its per-instantiation
//# comparator, which compares the `Array[Int]` field by content.

struct Result[T, E] {
  ok: T;
  err: E
} derive (Eq)

fn fill(xs: Array[Result[Array[Int], Int]], v: Int) -> Unit {
  Array::push(xs, Result::{ ok: [v, v + 1], err: v })
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  assert(left == right)
  assert(left != other)
  0
}
