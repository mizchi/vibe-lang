// #3133 review: an unannotated lambda parameter that shadows an outer
// Map-typed binding of the same name. The checker files the parameter's index
// as open, and that verdict is authoritative: the spelling fallback reads the
// OUTER binding's type, and used to rewrite `m[0]` to `Map::get` -- so a call
// with an Array ran Map indexing. Refused like any open receiver.

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  let _ = Map::size(m)
  let f = (m) -> { m[0] }
  f([5])
}
