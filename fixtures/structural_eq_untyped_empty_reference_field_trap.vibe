//# ADR-0097 fail-closed: a declared comparator that reaches a reference-backed
//# field must not be adopted as the inferred element shape of `let xs = []`.
//# `eq_for_typed` has no structural Map arm, so admitting `Outer` would make
//# separately allocated equal maps compare by identity and answer false.

struct Outer {
  m: Map[String, Int]
} derive (Eq)

export fn _start() -> Int {
  let left = []
  Array::push(left, Outer::{
    m: Map::from_pairs([("a", 1)])
  })
  let right = []
  Array::push(right, Outer::{
    m: Map::from_pairs([("a", 1)])
  })
  if left == right {
    1
  } else {
    0
  }
}
