// #3587 (Codex review): the cross-module supertrait-method refusal reads a
// program-declared marker `trait Eq {}` as declaring no methods, the way the
// single-module checker does. So a dependency's `impl Key for Box[T]` that
// writes an `equals`, beside this entry's `impl Eq for Box[T] {}`, is not two
// `Eq::equals` and the program is accepted. It used to be refused at link time.

import ./modules/eq_marker_subtrait_key_equals.vibe {
  Eq, Key, struct Box, box_value
}

impl [T] Eq for Box[T] {}

test "a marker Eq beside a subtrait impl's own equals is accepted" {
  let b: Box[Int] = Box::{ v: 1 }
  inspect(box_value(b), content = "1")
}
