// #3517: the same refusal when the task only calls a function whose row
// carries `Async`, even one that never suspends, and imports nothing
// experimental. `work` is compiled with a step-returning clone, so the task
// closure that calls it returned a step: `main` answered 1324 (measured on
// the committed seed) where the answer is 6. Compiled and refused by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn work() -> Int with Async {
  5
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> {
      work() + 1
    })
    TaskHandle::join(h)
  })
}
