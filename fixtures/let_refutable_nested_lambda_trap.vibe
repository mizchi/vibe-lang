// #3626: the refutable-`let` message for a constructor nested in a tuple,
// inside a closure whose value is a String. The failed arm yields no value,
// so it must type as whatever the matching arm's continuation produces --
// here a String, which the wasm-gc lane does not represent as an Int.

enum Shape {
  Circle(Int);
  Rect(Int, Int)
}

fn width(s: Shape) -> String {
  let f = (x: Shape) -> {
    let (Rect(w, _), n) = (x, 1)
    "w=\{w} n=\{n}"
  }
  f(s)
}

fn main allows Console {
  println("before \{width(Rect(2, 3))}")
  println("after \{width(Circle(1))}")
}
