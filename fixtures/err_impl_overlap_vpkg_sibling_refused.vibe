// #3551: two packages, each with a contract that shares an import with its
// siblings (#897), each implement `Name` for `Int` in a sibling file. The
// loader opens every such sibling with its shared-import marker line, and the
// overlap check took that line for a generated unit and skipped both, so this
// built and printed `from-pkg-a from-pkg-a` (`from-pkg-b from-pkg-b` with the
// imports swapped). It is refused, naming both impls.

import ./modules/impl_overlap_pkg_a {
  pkg_a_name
}

import ./modules/impl_overlap_pkg_b {
  pkg_b_name
}

test "both packages keep their own impl" {
  inspect("\{pkg_a_name()} \{pkg_b_name()}", "from-pkg-a from-pkg-b")
}
