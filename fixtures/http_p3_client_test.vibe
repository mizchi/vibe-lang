// Phase 3: HTTP client test for WASI P3 client adapter compose.
// Uses http_request/http_response_status/http_close builtins
// which get routed through the P3 client adapter.
let handle = http_request("GET", "http://127.0.0.1:18793/hello", "", "")
let status = http_response_status(handle)
http_close(handle)
status
