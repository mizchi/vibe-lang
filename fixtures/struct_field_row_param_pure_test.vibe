// The accepted side of the struct-field row check: a struct whose row
// parameter is a lowercase letter, instantiated with a pure function. Before
// the check, the same struct written `Holder[E]` read `E` as an effect and
// was refused at `main` (`typecheck/struct_field_row_formal_reject.vibe`).

struct Holder[e] {
  run: () -> Int with e
}

fn quiet() -> Int {
  1
}

fn run_pure_holder() -> Int {
  let h = Holder::{ run: quiet }
  (h.run)()
}

test "a lowercase row parameter, pure" {
  inspect(run_pure_holder(), content = "1")
}
