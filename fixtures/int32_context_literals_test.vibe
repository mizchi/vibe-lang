//# #3730: an integer literal takes the `Int32` / `UInt32` type its context
//# expects in more places than a binding or an argument: a struct literal's
//# field, a `Some(..)` payload, a tuple element, the other branch of an `if`,
//# another arm of a `match`, and an element beside a sized one in an array
//# literal. Each answer below is the wrapped 32-bit value, so a literal that
//# did not take the sized type would fail to check rather than compute.

struct Pixel {
  x: Int32;
  level: UInt32
} derive (Eq, Show)

fn bump(_ x: Int32) -> Int32 {
  x + 1
}

fn or_zero(c: Bool, x: Int32) -> Int32 {
  if c {
    x
  } else {
    0
  }
}

fn grade(_ n: Int) -> UInt32 {
  match n {
    0 => 4294967295,
    1 => Int::wrap_uint32(5),
    _ => 7
  }
}

test "a struct field literal takes the field's sized type" {
  let p = Pixel::{ x: 2147483647, level: 4294967295 }
  inspect(Int32::to_int(bump(p.x)), content = "-2147483648")
  inspect(p == Pixel::{ x: 2147483647, level: 4294967295 }, content = "true")
}

test "a Some payload and a tuple element take the sized type" {
  let o: Option[UInt32] = Some(4294967295)
  inspect(o == Int::to_uint32(4294967295), content = "true")
  let t: (Int32, String) = (2147483647, "max")
  let (n, label) = t
  inspect("\{label}=\{Int32::to_int(bump(n))}", content = "max=-2147483648")
}

test "a literal branch or arm beside a sized one takes its type" {
  inspect(Int32::to_int(or_zero(true, bump(2147483647))), content = "-2147483648")
  inspect(Int32::to_int(or_zero(false, 5)), content = "0")
  inspect(UInt32::to_int(grade(0)), content = "4294967295")
  inspect(UInt32::to_int(grade(1)), content = "5")
  inspect(UInt32::to_int(grade(9)), content = "7")
}

test "an array literal mixing literals and sized values is sized" {
  let x = bump(1)
  let xs = [1, x, 3]
  let ys: Array[Int32] = [1, 2, 3]
  inspect(xs == ys, content = "true")
  inspect(Int32::to_int(Array::get(xs, at = 1)), content = "2")
  let zs = [bump(2147483647), 0]
  inspect(Int32::to_int(Array::get(zs, at = 0)), content = "-2147483648")
}

// A branch or arm that only `return`s yields nothing to the `if` / `match`,
// so the operand of its `return` does not size the literal beside it: `y`
// stays an `Int`, and the explicit wrap is what makes it a `UInt32`.
fn wrap_or_return(c: Bool, x: UInt32) -> UInt32 {
  let y = if c {
    4294967296
  } else {
    return x
  }
  Int::wrap_uint32(y)
}

fn return_or_wrap(c: Bool, x: Int32) -> Int32 {
  let y = if c {
    return x
  } else {
    2147483648
  }
  Int::wrap_int32(y)
}

fn arm_wrap_or_return(n: Int, x: Int32) -> Int32 {
  let y = match n {
    0 => 2147483648,
    _ => return x
  }
  Int::wrap_int32(y)
}

// A returning arm between a literal and a sized arm does not stop the literal
// from taking the sized type.
fn arm_skip_return(n: Int, x: UInt32) -> UInt32 {
  match n {
    0 => 4294967295,
    1 => return x,
    _ => x
  }
}

test "a returning branch or arm does not size the literal beside it" {
  inspect(UInt32::to_int(wrap_or_return(true, 3)), content = "0")
  inspect(UInt32::to_int(wrap_or_return(false, 3)), content = "3")
  inspect(Int32::to_int(return_or_wrap(false, 3)), content = "-2147483648")
  inspect(Int32::to_int(return_or_wrap(true, 3)), content = "3")
  inspect(Int32::to_int(arm_wrap_or_return(0, 3)), content = "-2147483648")
  inspect(Int32::to_int(arm_wrap_or_return(1, 3)), content = "3")
  inspect(UInt32::to_int(arm_skip_return(0, 3)), content = "4294967295")
  inspect(UInt32::to_int(arm_skip_return(1, 3)), content = "3")
  inspect(UInt32::to_int(arm_skip_return(2, 3)), content = "3")
}
