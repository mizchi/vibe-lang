//# Codex on #3971: `impl Key for Int` in a module that also declares a
//# private `type Key = Int` keeps implementing the trait `Key` once the
//# merge renames the alias per file; before, the gc lane answered that
//# there was no impl of `Key` for `Int`.

import ./modules/private_type_trait_same_name.vibe {
  run_key
}

test "a trait spelled like a private alias" {
  inspect(run_key(4), content = "5")
}
