// #3075: a function has no text form. Interpolating one inside an Option
// printed its table index or closure address (`Some(<address>)`). Refused at
// check time, naming what to interpolate instead.
export let _start: () -> Int = () -> {
  let o = Some((x: Int) -> x + 1)
  let s = "o=\{o}"
  String::length(s)
}
