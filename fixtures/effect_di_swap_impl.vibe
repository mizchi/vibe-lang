// Dependency injection: same logic, different handler = different behavior
effect Repo { FindById(Int) -> String }

// Production handler → "Alice Johnson" (length 13)
let prod = handle {
  let name = perform Repo::FindById(1)
  String::length(name)
} with {
  Repo::FindById(_id) => resume("Alice Johnson")
}

// Test handler → "Test User" (length 9)
let test_result = handle {
  let name = perform Repo::FindById(1)
  String::length(name)
} with {
  Repo::FindById(_id) => resume("Test User")
}

prod + test_result

__DATA__
{"last": "22"}
