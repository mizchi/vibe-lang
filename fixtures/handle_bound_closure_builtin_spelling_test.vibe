// #3255: a program's own function spelled like a builtin that only calls its
// callback (`Array::fold`) is judged by its body inside a `handle`, not by the
// spelling. This one only calls the closure, so handing it one that performs
// what the handle answers is fine, as it is for a program function named
// anything else (`apply` in handle_bound_closure_inside_test.vibe).
// fixtures/typecheck/handle_bound_closure_builtin_spelling_keeps_reject.vibe
// is the refused side: a function of the spelling that keeps the closure.

effect Ask {
  Get() -> Int
}

fn Array::fold(_ xs: Array[Int], f: () -> Int) -> Int {
  f() * 10 + Array::length(xs)
}

fn program_fold() -> Int {
  handle {
    Array::fold([1, 2, 3], f = () -> perform Ask::Get() + 1)
  } with { Ask::Get() => resume(5) }
}

test "a program function of a calls-only builtin spelling runs inside the handle" {
  inspect(program_fold(), content = "63")
}
