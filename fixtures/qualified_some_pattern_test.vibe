// #3422: a pattern that names its owner (`Maybe::Some`) is matched as that
// enum's variant on both backends, beside builtin `Some` / `None` patterns on
// an `Option`, nested and in an or-pattern; `Pick::None` is a qualified
// `None` of a program enum.
enum Maybe {
  Nothing;
  Some(Int)
}

enum Pick {
  Got(Int);
  None
}

fn g(m: Maybe) -> Int {
  match m {
    Maybe::Some(n) => n,
    Maybe::Nothing => 0
  }
}

fn h(o: Option[Int]) -> Int {
  match o {
    Some(n) => n,
    None => 0 - 1
  }
}

fn nested(p: (Maybe, Option[Int])) -> Int {
  match p {
    (Maybe::Some(a), Some(b)) => a + b,
    (Maybe::Some(a), None) => a,
    (Maybe::Nothing, _) => 0
  }
}

fn either(p: Pick) -> Int {
  match p {
    Pick::Got(1) | Pick::Got(2) => 12,
    Pick::Got(n) => n,
    Pick::None => 0 - 2
  }
}

test "a qualified Some is its enum's variant" {
  inspect(g(Maybe::Some(7)), "7")
  inspect(g(Maybe::Nothing), "0")
}

test "a bare Some on an Option is the builtin" {
  inspect(h(Some(5)), "5")
  inspect(h(None), "-1")
}

test "nested and or-patterns" {
  inspect(nested((Maybe::Some(2), Some(3))), "5")
  inspect(nested((Maybe::Some(2), None)), "2")
  inspect(nested((Maybe::Nothing, Some(9))), "0")
  inspect(either(Pick::Got(2)), "12")
  inspect(either(Pick::Got(9)), "9")
  inspect(either(Pick::None), "-2")
}
