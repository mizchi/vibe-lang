// Curried generic function

test "generic curried" {
  let curry = [A, B, C](f: (A, B) -> C) -> (A) -> (B) -> C {
    (a: A) -> (B) -> C {
      (b: B) -> C {
        f(a, b)
      }
    }
  }
  let add = (a: Int, b: Int) -> Int {
    a + b
  }
  let curried = curry(add)
  let add5 = curried(5)
  inspect(add5(3), "8")
}
