let make_inferred = (n: Int) -> {
  [n]
}

fn discard_capturing_lambda(n: Int) -> Int {
  let capture = [n]
  (x: Int) -> Int {
    Array::get(capture, 0) + x
  }
  1
}

fn discard_local_lambda_result(n: Int) -> Int {
  let make = (x: Int) -> Array[Int] {
    [x]
  }
  make(n)
  1
}

fn discard_inferred_global_result(n: Int) -> Int {
  make_inferred(n)
  1
}

fn discard_handle_result(n: Int) -> Int {
  handle {
    [n]
  } with { Probe::Ask() => resume(n) }
  1
}

test "discarded closure, local call and handle leave the following value" {
  inspect(discard_capturing_lambda(7), "1")
  inspect(discard_local_lambda_result(7), "1")
  inspect(discard_inferred_global_result(7), "1")
  inspect(discard_handle_result(7), "1")
}

export fn main() -> Int {
  let mut i = 0
  let mut total = 0
  while i < 2000 {
    total = total + discard_capturing_lambda(i)
    total = total + discard_local_lambda_result(i)
    total = total + discard_inferred_global_result(i)
    total = total + discard_handle_result(i)
    i = i + 1
  }
  total
}
effect Probe {
  Ask() -> Int
}
