let make_inferred = (n: Int) -> {
  [n]
}

let make_inferred_block = (n: Int) -> {
  let next = n + 1
  [next]
}

let make_inferred_branch = (n: Int) -> {
  if n > 0 { [n] } else { [0] }
}

fn discard_capturing_lambda(n: Int) -> Int {
  let capture = [n]
  (x: Int) -> Int {
    Array::get(capture, 0) + x
  }
  1
}

fn discard_local_lambda_result(n: Int) -> Int {
  let make = (x: Int) -> Array[Int] {
    [x]
  }
  make(n)
  1
}

fn discard_local_borrowed_lambda_result(n: Int) -> Int {
  let xss = [[n]]
  let get = () -> Array[Int] { Array::get(xss, 0) }
  get()
  if Array::get(Array::get(xss, 0), 0) == n { 1 } else { 0 }
}

fn discard_mutable_lambda_result(n: Int) -> Int {
  let mut make = (x: Int) -> Array[Int] { [x] }
  make(n)
  make = (x: Int) -> Array[Int] { [x + 1] }
  make(n)
  1
}

fn discard_recursive_lambda_result(n: Int) -> Int {
  let rec make = (x: Int) -> Array[Int] { [x] }
  make(n)
  1
}

fn discard_inferred_global_result(n: Int) -> Int {
  make_inferred(n)
  1
}

fn discard_inferred_spine_result(n: Int) -> Int {
  make_inferred_block(n)
  make_inferred_branch(n)
  1
}

fn discard_parameterized_loop_result(n: Int) -> Int {
  loop (i = n) { break [i] }
  1
}

fn discard_handle_result(n: Int) -> Int {
  handle {
    [n]
  } with { Probe::Ask() => resume(n) }
  1
}

test "discarded closure, local call and handle leave the following value" {
  inspect(discard_capturing_lambda(7), "1")
  inspect(discard_local_lambda_result(7), "1")
  inspect(discard_local_borrowed_lambda_result(7), "1")
  inspect(discard_mutable_lambda_result(7), "1")
  inspect(discard_recursive_lambda_result(7), "1")
  inspect(discard_inferred_global_result(7), "1")
  inspect(discard_inferred_spine_result(7), "1")
  inspect(discard_parameterized_loop_result(7), "1")
  inspect(discard_handle_result(7), "1")
}

export fn main() -> Int {
  let mut i = 0
  let mut total = 0
  while i < 2000 {
    total = total + discard_capturing_lambda(i)
    total = total + discard_local_lambda_result(i)
    total = total + discard_local_borrowed_lambda_result(i)
    total = total + discard_mutable_lambda_result(i)
    total = total + discard_recursive_lambda_result(i)
    total = total + discard_inferred_global_result(i)
    total = total + discard_inferred_spine_result(i)
    total = total + discard_parameterized_loop_result(i)
    total = total + discard_handle_result(i)
    i = i + 1
  }
  total
}
effect Probe {
  Ask() -> Int
}
