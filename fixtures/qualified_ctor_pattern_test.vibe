// #742: qualified variant PATTERNS `Enum::Variant(..)` parse and match. The
// qualifier is dropped at parse, mirroring the expression side (#672) —
// codegen's ctor table is keyed unqualified. Before this, `Result::Ok(v) =>`
// failed with "expected => but got ::" (host-era libraries like
// vibe/json/jsonrpc.vibe were full of the form).

// #1324 removed the prelude `Result`. This fixture is about the qualified
// PATTERN spelling `Enum::Variant(..)`, not about where the enum comes from,
// so it declares its own — the `Result::Ok(v) =>` form below is unchanged.
enum Result[T, E] {
  Ok(T);
  Err(E)
}

enum Shade {
  Light(Int);
  Dark
}

let to_result = (flag: Bool) -> Result[Int, String] {
  if flag {
    Ok(41)
  } else {
    Err("nope")
  }
}

test "qualified result patterns" {
  match to_result(true) {
    Result::Ok(v) => assert(eq(v, 41)),
    Result::Err(_) => assert(false)
  }
  match to_result(false) {
    Result::Ok(_) => assert(false),
    Result::Err(msg) => assert(msg == "nope")
  }
}

test "qualified option patterns" {
  let o = Some(7)
  match o {
    Option::Some(v) => assert(eq(v, 7)),
    Option::None => assert(false)
  }
}

test "qualified user enum patterns incl nullary" {
  let s = Light(3)
  match s {
    Shade::Light(n) => assert(eq(n, 3)),
    Shade::Dark => assert(false)
  }
  let d = Dark
  match d {
    Shade::Light(_) => assert(false),
    Shade::Dark => assert(true)
  }
}

test "unqualified patterns unchanged" {
  match to_result(true) {
    Ok(v) => assert(eq(v, 41)),
    Err(_) => assert(false)
  }
}
