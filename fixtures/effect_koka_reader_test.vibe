// Koka-style Reader effect (ask) — tail-resumptive inline

// Analogous to polysemy Reader without higher-order `local`

effect Reader {
  Ask -> String;
}

test "effect koka reader" {
  let result = handle {
    let name = perform Reader::Ask
    String::concat("Hello, ", name)
  } with { Reader::Ask => resume("World") }
  inspect(String::length(result), "12")
}
