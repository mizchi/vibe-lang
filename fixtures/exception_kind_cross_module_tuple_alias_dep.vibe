// Dependency of exception_kind_cross_module_tuple_alias_test.vibe: a row whose
// kind is a TUPLE alias. Its resolution `(Int, Int)` holds a comma, so the
// published row keeps the alias spelling rather than breaking row parsing.
export type Pair = (Int, Int)

export fn fail_pair(n: Int) -> Int with Exception[Pair] {
  if n > 0 {
    let p: Pair = (n, n + 1)
    throw(p)
  } else {
    0
  }
}
