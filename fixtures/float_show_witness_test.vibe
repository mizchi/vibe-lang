trait Show {
  to_string(Self) -> String
}
fn render[T: Show](x: T) -> String {
  T::to_string(x)
}

test "a Float Show witness preserves the shortest binary32 spelling" {
  inspect(render(0.1f), content = "0.1")
  inspect(render(1.0f / 3.0f), content = "0.33333334")
  inspect(render(0.0f / 0.0f), content = "NaN")
  inspect(render(1.0f / 0.0f), content = "Infinity")
  let x: f32 = 0.1f
  inspect(render(x), content = "0.1")
}
