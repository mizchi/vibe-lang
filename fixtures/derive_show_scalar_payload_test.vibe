// #3087: a NON-generic `derive (Show)` enum or struct renders each payload /
// field through its declared type. A `Bool` or `Double` there went to the
// runtime heuristic, which cannot tell a Bool or a boxed Double from an Int:
// `Yes(false)` rendered `Yes(0)`. The derived renderer now names the renderer
// for those declared types.
enum E {
  Yes(Bool);
  Ratio(Double);
  Both(Bool, Int);
  Nothing
} derive (Show)

struct Flags {
  on: Bool;
  scale: Double;
  n: Int
} derive (Show)

test "a Bool payload renders as a Bool" {
  inspect("\{E::Yes(false)} \{Yes(true)}", content = "Yes(false) Yes(true)")
}

test "a Double payload and a mixed payload" {
  inspect("\{Ratio(0.25)} \{Both(true, 3)} \{Nothing}", content = "Ratio(0.25) Both(true, 3) Nothing")
}

test "Bool and Double fields of a derived struct" {
  let f = Flags::{ on: false, scale: 1.5, n: 2 }
  inspect("\{f}", content = "Flags { on: false, scale: 1.5, n: 2 }")
}

test "through a binding and a container" {
  let e = Yes(true)
  let xs = [Yes(false), Nothing]
  inspect("\{e} \{xs}", content = "Yes(true) [Yes(false), Nothing]")
}
