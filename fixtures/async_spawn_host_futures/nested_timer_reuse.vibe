// #1537: a nested group arms its own timer after an enclosing group's timer
// fired during its wait. The outer group arms a 300ms timer for `a`; it fires
// while the nested group waits (from ~100ms), so the nested group leaves it in
// the mailbox. The nested task `s` then sleeps 200ms after its 250ms future
// lands (~350ms). Its timer id must not match the stale mailbox entry: ids are
// an adapter counter, never the subtask handle a dropped timer frees for reuse.
// wasmtime 47 did not reuse the handle in this shape, so this row pins the
// timing (`s` sleeps its full 200ms, ~550ms total) rather than the reuse
// itself. 1 + (40 + 2) = 43. Executed by
// scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      sleep(300)
      1
    })
    let b = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      let _ = await(host_future_named("fast"))
      TaskGroup::run((h) -> {
        let t = TaskGroup::spawn_suspend(h, () -> Int with Async + Exception {
          await(host_future_named("slow"))
        })
        let s = TaskGroup::spawn_suspend(h, () -> Int with Async + Exception {
          let v = await(host_future_named("mid"))
          sleep(200)
          v
        })
        TaskGroup::pump_all(h)
        TaskHandle::join(t) + TaskHandle::join(s)
      })
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(a) + TaskHandle::join(b)
  })
}
