// #3189 review (Codex): the program's only host-stream read sits in a spawned
// closure literal on the arm of `start` that its one call decides against with
// a constant `false`. `fold_const_bool_params` removes that arm, and the
// reachability prune then removes the read, its step clone and the injected
// `__hs_next`. The prelude runs BEFORE both, so it saw the read and gave the
// entry boundary its stream machinery: a settle band that calls
// `host_stream_read`, and -- when the scheduler hooks' stream half was
// decided before the prune -- hooks that arm and cancel host streams. With no
// host stream left to compose, the first was an invalid component (an import
// of `host_stream_read` no adapter provides) and the second a refused build
// ("host_stream_cancel without a host stream"). Neither can run: the program
// has no reachable stream operation, so it must compose with no host-stream
// import at all and answer from its host future, 1 + 41 = 42.
// Executed by scripts/test_named_hoststreams_component_gate.sh.
import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

fn start(g: TaskGroup, read: Bool) -> TaskHandle[Int] {
  if read {
    TaskGroup::spawn_suspend(g, () -> Int with Async {
      let s = host_stream_named("left")
      host_stream_next(s)
    })
  } else {
    TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      await(host_future_named("fast")) + 41
    })
  }
}

let run: () -> Int with Async + Exception = () -> {
  TaskGroup::run((g) -> {
    let t = start(g, false)
    TaskGroup::pump_all(g)
    TaskHandle::join(t)
  })
}
