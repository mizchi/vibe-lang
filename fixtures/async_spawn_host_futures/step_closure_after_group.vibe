// #3192: `step_closure_before_group.vibe` with the call moved after the
// group. It answered 1421, a heap pointer plus one. 40 + 1 = 41. Executed by
// scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  let fetch = () -> Int with Async {
    await(host_future_named("slow"))
  }
  let a = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      1
    })
    TaskHandle::join(h)
  })
  let x = fetch()
  x + a
}
