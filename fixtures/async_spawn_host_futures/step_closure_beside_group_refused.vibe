// #3161, the related shape: an Async entry calls a closure literal of its own
// whose row carries Async, next to a `TaskGroup::run`. Linking the group links
// `TaskGroup::spawn_suspend`, whose handler stores `resume`, so the literal is
// compiled to the step convention, and the entry's boundary -- which resumes
// in place -- cannot call it. It stays a compile error; the message now leads
// with the edit (a top-level `fn .. with Async` keeps both conventions),
// which `step_fn_beside_group.vibe` shows working. Compiled and refused by
// scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  let fetch = () -> Int with Async {
    await(host_future_named("slow"))
  }
  let x = fetch()
  let y = TaskGroup::run((g) -> {
    let a = TaskGroup::spawn(g, () -> Int {
      1
    })
    TaskHandle::join(a)
  })
  x + y
}
