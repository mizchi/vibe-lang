// #3161, the side that stays refused: an ordinary `spawn` child captures a
// name bound to a call's result with no type written. Nothing in the syntax
// shows that value is plain data rather than a closure that suspends, which
// the child would call under the plain convention. The refusal now leads with
// the edit -- give the binding its type (`let n: Int = ..`) or bind it inside
// the closure -- instead of naming only the call to `TaskGroup::run`; the
// annotated spelling is `mixed_spawn.vibe`. Compiled and refused by
// scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn weigh(xs: Array[Int], k: Int) -> Int {
  let mut total = 0
  let mut i = 0
  while i < Array::length(xs) {
    total = total + Array::get(xs, i) * k
    i = i + 1
  }
  total
}

let run: () -> Int with Async + Exception = () -> {
  let n = weigh([7], 3)
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn(g, () -> Int {
      n
    })
    let c = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      await(host_future_named("slow"))
    })
    TaskHandle::join(a) + TaskHandle::join(c)
  })
}
