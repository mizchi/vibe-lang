// #1537: a sleep that begins after the group's shared timer was armed is not
// debited that timer's duration. Task `a` sleeps 1000ms, so the timer is armed
// for 1000ms; task `b`'s 900ms future lands first and `b` then sleeps 500ms.
// When the 1000ms timer fires only `a`'s debt is paid; `b` still sleeps its
// 500ms, so the run takes at least 1400ms. Debiting every sleeper would end
// `b`'s sleep at about 1000ms. 1 + 40 = 41. Executed by
// scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      sleep(1000)
      1
    })
    let b = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      let v = await(host_future_named("slow"))
      sleep(500)
      v
    })
    TaskGroup::pump_all(g)
    TaskHandle::join(a) + TaskHandle::join(b)
  })
}
