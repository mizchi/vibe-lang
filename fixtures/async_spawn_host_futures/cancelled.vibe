// #1537: a task cancelled while parked on a host future was its only waiter,
// so the group cancels that future's read and releases its handle
// (`host_future_cancel`); the live task's future still lands. Answers the live
// task's 40. Executed by scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      await(host_future_named("slow"))
    })
    let c = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      await(host_future_named("fast"))
    })
    TaskHandle::cancel(c)
    TaskGroup::pump_all(g)
    TaskHandle::join(a)
  })
}
