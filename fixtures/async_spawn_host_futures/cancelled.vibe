// #1537: a task cancelled while parked on a host future leaves that future
// armed in the group's waitable set. When it lands before the future a live
// task awaits, its value is discarded rather than treated as a missing waiter
// (which trapped the whole group). Answers the live task's 40. Executed by
// scripts/test_named_hostfutures_component_gate.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      await(host_future_named("slow"))
    })
    let c = TaskGroup::spawn_suspend(g, () -> Int with Async + Exception {
      await(host_future_named("fast"))
    })
    TaskHandle::cancel(c)
    TaskGroup::pump_all(g)
    TaskHandle::join(a)
  })
}
