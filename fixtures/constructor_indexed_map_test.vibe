import @vibe/builtin {
  trait Mappable
}

test "Array maps through a constructor-indexed witness" {
  let values = [1, 2] |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "Option maps through a constructor-indexed witness" {
  let value = Some(3) |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  assert_eq(value, Some(8))
}

test "loop break values use lexical let constructors" {
  let values = Mappable::map(loop (i = 0) {
    let xs = [i]
    break xs
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [1])
}
