import @vibe/builtin {
  map, trait Mappable
}

test "Array maps through a constructor-indexed witness" {
  let values = [1, 2] |> map((x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "Option maps through a constructor-indexed witness" {
  let value = Some(3) |> map((x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(value, Some(8))
}
