import @vibe/builtin {
  trait Iterator
}

test "Array maps through its Iterator witness" {
  let values = [1, 2] |> Iterator::map((x) -> {
    x + 1
  }) |> Iterator::map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "loop break values use lexical let constructors" {
  let values = Iterator::map(loop (i = 0) {
    let xs = [i]
    break xs
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [1])
}
