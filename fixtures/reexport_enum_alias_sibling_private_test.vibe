import ./import_kind_phase1/reexport.vibe {
  PublicChoice, is_first
}
import ./import_kind_phase1/sibling_choice_private.vibe {
  answer
}

test "a private same-name enum leaves the public alias unambiguous" {
  inspect(answer, content = "99")
  inspect(is_first(PublicChoice::First), content = "true")
  inspect(is_first(PublicChoice::Second), content = "false")
}
