//# #2745: the same refusal when the lambda is applied only at a SCALAR.
//
// This program prints `42` today, correctly -- and is refused anyway. That is the
// accepted cost of the fix, pinned here so it is a decision on the record rather
// than a surprise.
//
// It renders correctly by ACCIDENT of the instantiation. The lambda is lowered
// once, so `inner(42)` and `inner(Qt::{ w: 5 })` share a lowering; the sibling
// fixture is that same lambda applied to a struct, printing `272`. This pass
// cannot tell the two apart without specializing the lambda -- the work #2737
// left open -- so refusing both is the fail-closed reading of "never be silently
// wrong", and the edit the message names restores the scalar case: at a top-level
// binder, specialization gives the interpolation a concrete type again.

trait Eq {
  equals(Self, Self) -> Bool
}

struct Qt {
  w: Int
}

impl Eq for Qt {
  equals(a: Qt, b: Qt) -> Bool {
    a.w == b.w
  }
}

impl Eq for Int {
  equals(a: Int, b: Int) -> Bool {
    a == b
  }
}

fn outer[T: Eq](x: T) -> String {
  let inner = [T: Eq](a: T) -> String {
    "\{a}"
  }
  inner(42)
}

export fn _start() -> Int {
  String::length(outer(7))
}
