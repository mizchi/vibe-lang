// #2964 control: under a kinded row, the edits the unresolved-kind refusal
// names compile and run -- a payload with a type annotation, and the erased
// `with Exception` row, which stays gradual.
enum ParseErr {
  Eof
}

fn annotated(x: Option[ParseErr]) -> Int with Exception[ParseErr] {
  match x {
    Some(v) => {
      let e: ParseErr = v
      throw(e)
    }
    None => 0
  }
}

fn erased(x: Option[ParseErr]) -> Int with Exception {
  match x {
    Some(e) => throw(e)
    None => 0
  }
}

test "an annotated payload and the erased row both compile" {
  let a = handle {
    annotated(Some(Eof))
  } with { Exception[ParseErr]::Throw(_e) => 1 }
  let b = handle {
    erased(Some(Eof))
  } with { Exception::Throw(_e) => 2 }
  inspect(a + b, "3")
}
