// `(vibe.int.untag x)` / `(vibe.int.tag x)` in an inline-wasm body: the number
// an `Int` holds and back, in whatever representation the compiling lane uses
// (tagged `n << 1` on RC, raw on bump). The bump lane is exercised by
// scripts/test_wasm_import_gate.sh, whose bindings are built from these.
fn times3(_ a: Int) -> Int = wasm"(vibe.int.tag (i64.mul (vibe.int.untag (local.get $a)) (i64.const 3)))"

fn halve(_ a: Int) -> Int = wasm"(vibe.int.tag (i64.div_s (vibe.int.untag (local.get $a)) (i64.const 2)))"

test "untag and tag round-trip the number" {
  inspect(times3(14), content = "42")
  inspect(times3(-5), content = "-15")
  inspect(halve(85), content = "42")
}
