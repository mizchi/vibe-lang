// #1967: was fixtures/hex_literal.vibe + __DATA__.last. Hex literals and
// arithmetic, checked by inspect (display form, not the old debug printer).

test "hex literals" {
  inspect(0xFF, "255")
  inspect(0x100, "256")
  inspect(0X1a2b, "6699")
  inspect(0x0, "0")
  inspect(0xFF + 1, "256")
  inspect(0x10 * 0x10, "256")
}
