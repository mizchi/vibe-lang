// #1720: source may spell the generated prefix. A source-bound opaque local
// must be classified before the unbound generated-name authorization.
effect Ask {
  Get(Int) -> Int
}

fn maker() -> () -> Int with Ask {
  () -> Int with Ask {
    perform Ask::Get(1)
  }
}

let _start = () -> Int {
  handle {
    let seed = perform Ask::Get(0)
    let __scps_user = maker()
    let a = __scps_user()
    seed + a
  } with {
    Ask::Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
