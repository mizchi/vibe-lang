// #3587: one sibling module writes `equals` in `impl [T] Key for Box[T]`
// (under `trait Key: Eq`), another writes `impl [T] Eq for Box[T]`, and
// neither imports the other. This answered `eq=true key=false` for one value.
// Refused at link time, naming both impls.

import ./modules/eq_subtrait_sib_types.vibe {
  struct Box
}

import ./modules/eq_subtrait_sib_key.vibe {
  via_key
}

import ./modules/eq_subtrait_sib_eq.vibe {
  via_eq
}

test "one equals for Box through every bound" {
  let p: Box[Int] = Box::{ v: 1 }
  inspect("eq=\{via_eq(p, p)} key=\{via_key(p, p)}", content = "eq=true key=true")
}
