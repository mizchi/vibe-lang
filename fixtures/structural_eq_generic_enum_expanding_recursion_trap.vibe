//# #2467: a generic ENUM's specializations join the same worklist as a
//# generic struct's (#2195), and a NON-REGULAR recursion -- `Nest[T]` whose
//# payload is `Nest[Array[T]]` -- would grow it forever: `Nest[Int]` needs
//# `Nest[Array[Int]]`, which needs `Nest[Array[Array[Int]]]`, ... The
//# finiteness walk (`generic_eq_graph_node_is_finite`) now reads enum
//# payloads too, so the comparison fails closed instead of hanging the
//# compiler. The `N` arm of `Nest::equals__Int` is the fail-closed form, so
//# comparing two `N(...)` values must TRAP. (The stage2 from main at 50801e0
//# answered `1` here through the derived comparator's erased `==`.)

enum Nest[T] {
  N(Nest[Array[T]]);
  End(T)
}

export fn _start() -> Int {
  let a: Nest[Int] = N(End([1]))
  let b: Nest[Int] = N(End([1]))
  if a == b {
    1
  } else {
    0
  }
}
