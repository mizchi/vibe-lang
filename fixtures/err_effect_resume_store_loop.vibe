// ADR-0076 Phase 3a/3b (#817): performs of the handled effect must sit
// directly on the handle body's let/seq/tail/branch-tail spine when an
// arm captures `resume` as a value.
//
// #1230 made a PLAIN `while` + `let mut` spine eligible (the loop becomes a
// recursive step-returning closure -- see effect_resume_store_loop.vibe),
// but `break`/`continue`/`return` inside such a loop still are not: once
// the loop body is a function, they have no target, and rewriting them
// needs an escape continuation the lowering does not build. This is the
// guardrail that the widening did not quietly swallow them.
effect Async {
  Suspend(Int) -> Int
}

let sunk: Array[(Int) -> Int] = []

let _start = () -> Int {
  handle {
    let mut i = 0
    while i < 3 {
      let v = perform Async::Suspend(i)
      if v > 100 {
        break
      } else {
        ()
      }
      i = i + 1
    }
    i
  } with Async {
    Suspend(t) => {
      Array::push(sunk, resume)
      0 - t
    }
  }
}
_start()

__DATA__
{"error_contains":"let/seq/tail/branch-tail spine"}
