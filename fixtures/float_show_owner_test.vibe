trait Show {
  to_string(Self) -> String
}
trait Weird {
  to_string(Self) -> String
}
impl Weird for Float {
  to_string(x: Float) -> String {
    "weird"
  }
}
fn render[T: Show + Weird](x: T) -> String {
  T::to_string(x)
}

test "Show's builtin Float implementation belongs to Show" {
  inspect(render(0.1f), content = "0.1")
}
