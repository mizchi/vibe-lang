//# #2745: a nested aggregate reached through an ALIAS.
//
// The depth axis crossed with round 7's hop axis. An alias used to copy the
// source's records family by family -- shape exactly, fields by prefix,
// elements by probing indices 0..8 -- so it carried the TOP level and nothing
// under it: `let p = ((a, 1), 2); let q = p; match q { ((b, _), _) => b }`
// printed `252` even with the direct nesting closed.
//
// A key is `<family>$<owner>` or `<family>$<owner>$<slot>`, and a nested slot's
// owner is itself `<owner>$<slot>`, so ONE prefix test per family carries the
// whole tree at any depth. That is the same construction round 7 used for hops:
// close the relation, not the hop -- and here, not the level either.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let p = ((a, 1), 2)
    let q = p
    match q {
      ((b, _), _) => b
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
