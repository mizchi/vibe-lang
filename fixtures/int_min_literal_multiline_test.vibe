// #3022 review: a prefix `-` on the line before the minimum Int magnitude is
// still its sign.
test "Int::min_value spelled across a line break" {
  let x = -
    4611686018427387904
  inspect(x, "-4611686018427387904")
}

// A `//` comment between the sign and the magnitude is not in the token
// stream, so the `-` before it is still the sign.
test "Int::min_value with a comment between sign and magnitude" {
  let x = - // the sign
    4611686018427387904
  inspect(x, "-4611686018427387904")
}
