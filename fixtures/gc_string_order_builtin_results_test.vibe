// #3545: on the wasm-gc lane, `String <` compared some runtime strings by
// REFERENCE -- `String::from_byte`, `Int::to_string` and `String::split`
// results reached the comparison with no type the syntactic classifier could
// read, so the bare `<` lowered to a raw i64 compare and answered by
// allocation order. Every assertion here must hold on BOTH lanes.
//
// Each pair is built so that address order and content order DISAGREE: the
// left operand is allocated first but sorts after the right one. A raw
// reference compare therefore answers the opposite of the content compare,
// and cannot pass by luck.
//
// Run on the linear, RC and gc lanes by tests/gates/early/extended_derive.sh.

struct Named {
  name: String;
  rank: Int
}

fn later_byte() -> String {
  String::from_byte(66)
}

fn earlier_byte() -> String {
  String::from_byte(65)
}

//# Tests

test "#3545 String::from_byte results order by content" {
  let a = String::from_byte(66)
  let b = String::from_byte(65)
  inspect(a < b, content = "false")
  inspect(a > b, content = "true")
  inspect(a <= b, content = "false")
  inspect(a >= b, content = "true")
  inspect(b < a, content = "true")
  inspect(a < a, content = "false")
  inspect(a <= a, content = "true")
  inspect(a == b, content = "false")
  inspect(a != b, content = "true")
}

test "#3545 equal runtime strings compare equal and unordered" {
  let a = String::from_byte(66)
  let b = String::from_byte(66)
  inspect(a == b, content = "true")
  inspect(a != b, content = "false")
  inspect(a < b, content = "false")
  inspect(a <= b, content = "true")
  inspect(a >= b, content = "true")
  inspect(a > b, content = "false")
}

test "#3545 Int::to_string results order by content" {
  inspect(Int::to_string(9) < Int::to_string(1), content = "false")
  inspect(Int::to_string(9) > Int::to_string(1), content = "true")
  inspect(Int::to_string(9) <= Int::to_string(10), content = "false")
  inspect(Int::to_string(10) >= Int::to_string(9), content = "false")
  inspect(Int::to_string(7) == Int::to_string(7), content = "true")
  let x = Int::to_string(20)
  let y = Int::to_string(3)
  inspect(x < y, content = "true")
  inspect(x != y, content = "true")
}

test "#3545 String::split elements order by content" {
  let sp = String::split("b,a,b", ",")
  inspect(sp[0] < sp[1], content = "false")
  inspect(sp[0] > sp[1], content = "true")
  inspect(sp[0] >= sp[1], content = "true")
  inspect(sp[1] <= sp[0], content = "true")
  inspect(sp[0] == sp[2], content = "true")
  inspect(sp[0] != sp[1], content = "true")
  let first = Array::get(sp, 0)
  let second = Array::get(sp, 1)
  inspect(first < second, content = "false")
}

test "#3545 Array[String] elements built at run time order by content" {
  let xs: Array[String] = []
  Array::push(xs, String::from_byte(122))
  Array::push(xs, String::from_byte(97))
  inspect(xs[0] < xs[1], content = "false")
  inspect(xs[0] > xs[1], content = "true")
  inspect(xs[1] <= xs[0], content = "true")
  inspect(xs[0] == String::from_byte(122), content = "true")
}

test "#3545 a String struct field orders by content" {
  let p = Named::{ name: String::from_byte(66), rank: 1 }
  let q = Named::{ name: String::from_byte(65), rank: 2 }
  inspect(p.name < q.name, content = "false")
  inspect(p.name > q.name, content = "true")
  inspect(p.name >= q.name, content = "true")
  inspect(q.name <= p.name, content = "true")
  inspect(p.name == q.name, content = "false")
  inspect(p.name != q.name, content = "true")
}

test "#3545 function results order by content" {
  inspect(later_byte() < earlier_byte(), content = "false")
  inspect(later_byte() > earlier_byte(), content = "true")
  inspect(later_byte() == later_byte(), content = "true")
}

test "#3545 a comparison in an if condition orders by content" {
  let a = String::from_byte(66)
  let b = String::from_byte(65)
  let lt = if a < b {
    "lt"
  } else {
    "not-lt"
  }
  inspect(lt, content = "not-lt")
  let ge = if a >= b {
    "ge"
  } else {
    "not-ge"
  }
  inspect(ge, content = "ge")
}

test "#3545 a comparison in a while condition orders by content" {
  let xs = String::split("d,c,b,a", ",")
  let mut i = 0
  while i + 1 < Array::length(xs) && xs[i] > xs[i + 1] {
    i = i + 1
  }
  inspect(i, content = "3")
}
