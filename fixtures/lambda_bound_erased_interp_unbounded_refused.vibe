//# #2745: the refusal keys on the BINDER, not on whether it carries a bound.
//
// #2737's dispatch refusals require the binder's bound to promise the method,
// because a dispatch is a request for a witness. Interpolation is not: every type
// is renderable in principle, so what matters is only whether this pass knows
// which type it has. An UNBOUNDED nested binder is exactly as erased as a bounded
// one, and measured on main at b4ccb37 this printed `272` too.
//
// The binder here is also spelled differently from the enclosing one, so this
// pins that the condition is about the binder rather than about shadowing. The
// dispatch rungs used to make the same distinction with a fixture of their own;
// #2778 threaded a nested binder's bound, so that whole family compiles now and
// its answers moved to `lambda_bound_nested_witness_test.vibe`. This condition
// survived the threading because it is not about which dictionary is reachable
// -- there is no witness to reach for an unbounded formal at any binder level.

trait Eq {
  equals(Self, Self) -> Bool
}

struct Qt {
  w: Int
}

impl Eq for Qt {
  equals(a: Qt, b: Qt) -> Bool {
    a.w == b.w
  }
}

impl Eq for Int {
  equals(a: Int, b: Int) -> Bool {
    a == b
  }
}

fn outer[T: Eq](x: T) -> String {
  let inner = [U](a: U) -> String {
    "\{a}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
