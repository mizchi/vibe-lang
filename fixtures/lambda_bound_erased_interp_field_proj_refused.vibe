//# #2745: a NAMED field projection of a local record.
//
// Codex, P1 round 13 on #2761. Measured on `2d6e2b4`:
// `{ let r = Box1::{ value: a }; r.value }` printed a 3-digit pointer decimal.
//
// The projection arm read the numeric index keys and stopped there, so a named
// field fell through to the leaf -- which infers the DECLARED field type, and
// for `struct Box1[U] { value: U }` that is the STRUCT's own formal `U`, not
// the nested binder's `T`. The wrong answer was therefore a confident one
// rather than an absent one, which is why it rendered instead of refusing.
//
// A projection is one question. `.0` and `.value` differ only in which key
// family holds the answer, and the arm now picks the family from the field.

struct Qt {
  w: Int
}

struct Box1[U] {
  value: U
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let r = Box1::{ value: a }
    r.value } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
