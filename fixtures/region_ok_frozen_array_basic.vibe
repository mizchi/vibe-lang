// #906: FrozenArray[T] functional smoke test. FrozenArray is a
// checker-only phantom-type distinction over Array[T]'s exact same
// runtime layout (mirrors ArrayBuilder's new/push/freeze technique,
// checker.vibe #938) -- from_array/to_array are pure identity casts,
// get/length alias Array::get/Array::length's own bodies (see
// codegen/gc/backend_body.vibe, codegen/wasi/linked_compile.vibe). This
// pins that the four builtins actually compile and run end to end: wrap
// an Array[Int], read it back through FrozenArray::get/length, then
// unwrap via to_array and confirm the escape hatch returns a real, usable
// Array again.
export let main = () -> Int {
  let a = [40, 1, 1]
  let fa = FrozenArray::from_array(a)
  let g0 = FrozenArray::get(fa, 0)
  let len = FrozenArray::length(fa)
  let back = FrozenArray::to_array(fa)
  let b1 = Array::get(back, 1)
  g0 + len - b1
}

// #1571: the expectation lives here, checked by `inspect` and updatable with
// `vibe test --update`, instead of in a `__DATA__` tail the gate has to `sed`
// off and compare in shell.
test "region ok frozen array basic" {
  inspect(main(), "42")
}
