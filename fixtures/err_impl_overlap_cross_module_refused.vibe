// #3544: two imported modules each write `impl Name for Int`. Linked into one
// program they define `Int::name` twice, and the build used to keep whichever
// module the import order merged first -- this printed `from-a from-a`, and
// `from-b from-b` with the imports swapped. It is refused, naming both impls.

import ./modules/impl_overlap_a.vibe {
  a_name
}

import ./modules/impl_overlap_b.vibe {
  b_name
}

test "both modules keep their own impl" {
  inspect("\{a_name()} \{b_name()}", "from-a from-b")
}
