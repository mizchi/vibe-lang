// ADR-0090 Phase 1 (red-first, positive): build inside the region, freeze to
// escape. Expected once the vertical slice lands: compiles and returns 6.
fn total() -> Int {
  let frozen = region r {
    let l = MutList::empty[Int](r)
    MutList::push(l, 1)
    MutList::push(l, 2)
    MutList::push(l, 3)
    MutList::freeze(l)
  }
  let mut i = 0
  let mut acc = 0
  while i < FrozenArray::length(frozen) {
    acc = acc + FrozenArray::get(frozen, i)
    i = i + 1
  }
  acc
}

let _start = () -> Int {
  total() * 7
}
_start()

