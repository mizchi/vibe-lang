// #1081 step 3 Phase B (Codex review, PR #1151, P1): a `let mut` binding
// declared in the ENCLOSING function BEFORE calling `TaskGroup::run` (not
// inside the run body itself) must still be rejected when an inline spawn
// closure captures it. The first version of `check_spawnable_mut_captures`
// anchored on the `TaskGroup::run` call's own closure argument, so a
// mutable binding declared OUTSIDE that argument (but still lexically
// enclosing the whole call) was invisible to it. Fixed by running the
// check once per top-level declaration (its whole body), not once per
// `TaskGroup::run` call (see check_spawnable_mut_captures_stmts).
import @vibe/concurrent { TaskGroup }

fn main() -> Unit with Exception {
  let mut counter = 0
  let _r = TaskGroup::run((n) -> {
    let _t = TaskGroup::spawn(n, () -> {
      counter += 1
      0
    })
    0
  })
  ()
}
