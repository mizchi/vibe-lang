fn pass(callback: (Int) -> Int) -> (Int) -> Int {
  callback
}

fn fresh_counter() -> (Int) -> Int {
  let offset = [1]
  (n: Int) -> Int {
    n + Array::get(offset, 0)
  }
}

fn pass_or_fresh(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return fresh_counter()
  }
  callback
}

fn counter_through_mutable_alias(start: Int, replace: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass(go)
  if replace {
    out = fresh_counter()
  }
  out
}

fn counter_through_mutable_mixed_alias(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass_or_fresh(go, choose)
  out
}

fn counter_with_shadowed_recursive_name(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let go = fresh_counter()
  let mut out = pass(go)
  out
}

fn counter_through_branching_mutable_alias(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = if choose {
    pass(go)
  } else {
    pass(go)
  }
  out
}

fn counter_through_mutable_reassignment(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = fresh_counter()
  out = pass(go)
  out
}

fn counter_through_wrapped_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let mut marker = 0
    marker = 1
    pass(go)
  }
  out
}

fn counter_through_bound_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let alias = pass(go)
    alias
  }
  out
}

fn counter_through_nested_bound_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let alias = pass(go)
    let marker = 0
    alias
  }
  out
}

fn counter_through_chained_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let first = pass(go)
    let second = first
    second
  }
  out
}

fn counter_through_branching_mutable_pass_arg(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass(if choose {
    go
  } else {
    go
  })
  out
}

fn counter_through_wrapped_mutable_pass_arg(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass({
    let marker = 0
    go
  })
  out
}

fn counter_through_nested_mutable_pass_arg(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass(pass(go))
  out
}

fn counter_through_aliased_nested_mutable_pass_arg(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass({
    let alias = go
    pass(alias)
  })
  out
}

fn counter_through_aliased_mutable_pass_result(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let alias = go
    pass(alias)
  }
  out
}

test "a mutable passthrough result keeps the recursive closure alive" {
  let escaped = counter_through_mutable_alias(8, false)
  inspect(escaped(5), content = "9")
}

test "replacing the mutable alias releases the recursive closure" {
  let mut i = 0
  while i < 200 {
    let f = counter_through_mutable_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_mutable_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a mutable mixed helper keeps both return paths owned" {
  let forwarded = counter_through_mutable_mixed_alias(8, false)
  inspect(forwarded(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = counter_through_mutable_mixed_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_mutable_mixed_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a shadowed recursive name does not gain a spare reference" {
  let mut i = 0
  while i < 200 {
    let f = counter_with_shadowed_recursive_name(8)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_with_shadowed_recursive_name(8)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "branching mutable initializer transfers its selected recursive reference" {
  let left = counter_through_branching_mutable_alias(8, true)
  let right = counter_through_branching_mutable_alias(8, false)
  inspect(left(5), content = "9")
  inspect(right(5), content = "9")
}

test "reassignment transfers a recursive closure to the mutable slot" {
  let escaped = counter_through_mutable_reassignment(8)
  inspect(escaped(5), content = "9")
}

test "a mutable block result retains its recursive passthrough" {
  let escaped = counter_through_wrapped_mutable_alias(8)
  inspect(escaped(5), content = "9")
}

test "a mutable block follows its returned binding to the passthrough" {
  let escaped = counter_through_bound_mutable_alias(8)
  inspect(escaped(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = counter_through_bound_mutable_alias(8)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_bound_mutable_alias(8)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a mutable block follows an alias through another binding" {
  let escaped = counter_through_nested_bound_mutable_alias(8)
  inspect(escaped(5), content = "9")
}

test "a mutable initializer follows a chain of immutable aliases" {
  let escaped = counter_through_chained_mutable_alias(8)
  inspect(escaped(5), content = "9")
}

test "a mutable passthrough argument retains either recursive branch" {
  let left = counter_through_branching_mutable_pass_arg(8, true)
  let right = counter_through_branching_mutable_pass_arg(8, false)
  inspect(left(5), content = "9")
  inspect(right(5), content = "9")
}

test "a mutable passthrough argument retains a wrapped recursive result" {
  let escaped = counter_through_wrapped_mutable_pass_arg(8)
  inspect(escaped(5), content = "9")
}

test "a mutable nested passthrough argument retains the recursive result" {
  let escaped = counter_through_nested_mutable_pass_arg(8)
  inspect(escaped(5), content = "9")
}

test "a mutable passthrough retains an alias returned through another helper" {
  let escaped = counter_through_aliased_nested_mutable_pass_arg(8)
  inspect(escaped(5), content = "9")
}

test "a mutable result retains an alias returned through a helper" {
  let escaped = counter_through_aliased_mutable_pass_result(8)
  inspect(escaped(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = counter_through_aliased_mutable_pass_result(8)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_aliased_mutable_pass_result(8)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}
