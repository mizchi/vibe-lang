fn pass(callback: (Int) -> Int) -> (Int) -> Int {
  callback
}

fn fresh_counter() -> (Int) -> Int {
  let offset = [1]
  (n: Int) -> Int {
    n + Array::get(offset, 0)
  }
}

fn pass_or_fresh(callback: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return fresh_counter()
  }
  callback
}

fn pick_early(first: (Int) -> Int, second: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return second
  }
  first
}

fn pick_early_mut(first: (Int) -> Int, second: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return {
      let mut selected = second; selected
    }
  }
  first
}

effect SelectCallback {
  Pick((Int) -> Int) -> Unit
}

fn pick_handler(first: (Int) -> Int, second: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  handle {
    if choose {
      perform SelectCallback::Pick(second)
    }
    first
  } with { SelectCallback::Pick(first) => return first }
}

fn pick_loop(callback: (Int) -> Int, choices: Array[(Int) -> Int]) -> (Int) -> Int {
  for callback in choices {
    return callback
  }
  callback
}

fn pick_forward(first: (Int) -> Int, second: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return later_passthrough(second)
  }
  first
}

fn later_passthrough(callback: (Int) -> Int) -> (Int) -> Int {
  callback
}

fn pick_unknown(first: (Int) -> Int, second: (Int) -> Int, choose: Bool) -> (Int) -> Int {
  if choose {
    return later_mutable(second)
  }
  first
}

fn later_mutable(callback: (Int) -> Int) -> (Int) -> Int {
  let mut selected = callback
  selected
}

fn pick_pattern_shadow(callback: (Int) -> Int, choice: Option[(Int) -> Int]) -> (Int) -> Int {
  let alias = callback
  match choice {
    Some(alias) => alias,
    None => alias
  }
}

fn counter_through_early_pick(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pick_early(fresh_counter(), go, choose)
  out
}

fn counter_through_early_pick_return(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pick_early(fresh_counter(), go, choose)
  return out
}

fn counter_through_early_mut_pick(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pick_early_mut(fresh_counter(), go, true)
}

fn counter_through_handler_pick(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pick_handler(fresh_counter(), go, true)
}

fn counter_through_loop_pick(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  pick_loop(fresh_counter(), [go])
}

fn counter_through_forward_pick(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pick_forward(fresh_counter(), go, true)
  out
}

fn counter_through_unknown_pick(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pick_unknown(fresh_counter(), go, true)
  out
}

fn counter_through_pattern_shadow_pick(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pick_pattern_shadow(fresh_counter(), Some(go))
  out
}

fn counter_through_mutable_alias(start: Int, replace: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass(go)
  if replace {
    out = fresh_counter()
  }
  out
}

fn counter_through_mutable_mixed_alias(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass_or_fresh(go, choose)
  out
}

fn counter_with_shadowed_recursive_name(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let go = fresh_counter()
  let mut out = pass(go)
  out
}

fn counter_through_branching_mutable_alias(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = if choose {
    pass(go)
  } else {
    pass(go)
  }
  out
}

fn counter_through_mutable_reassignment(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = fresh_counter()
  out = pass(go)
  out
}

fn counter_through_wrapped_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let mut marker = 0
    marker = 1
    pass(go)
  }
  out
}

fn counter_through_bound_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let alias = pass(go)
    alias
  }
  out
}

fn counter_through_nested_bound_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let alias = pass(go)
    let marker = 0
    alias
  }
  out
}

fn counter_through_chained_mutable_alias(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let first = pass(go)
    let second = first
    second
  }
  out
}

fn counter_through_branching_mutable_pass_arg(start: Int, choose: Bool) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass(if choose {
    go
  } else {
    go
  })
  out
}

fn counter_through_wrapped_mutable_pass_arg(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass({
    let marker = 0
    go
  })
  out
}

fn counter_through_nested_mutable_pass_arg(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass(pass(go))
  out
}

fn counter_through_aliased_nested_mutable_pass_arg(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = pass({
    let alias = go
    pass(alias)
  })
  out
}

fn counter_through_aliased_mutable_pass_result(start: Int) -> (Int) -> Int {
  let rec go = (n: Int) -> Int {
    if n > start {
      n
    } else {
      go(n + 1)
    }
  }
  let mut out = {
    let alias = go
    pass(alias)
  }
  out
}

test "a mutable passthrough result keeps the recursive closure alive" {
  let escaped = counter_through_mutable_alias(8, false)
  inspect(escaped(5), content = "9")
}

test "an early return of a different parameter keeps the recursive closure alive" {
  inspect(counter_through_early_pick(8, true)(5), content = "9")
  inspect(counter_through_early_pick(8, false)(5), content = "6")
  let mut i = 0
  while i < 200 {
    let f = counter_through_early_pick(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_early_pick(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
  let mut j = 0
  while j < 200 {
    let f = counter_through_early_pick(8, false)
    let _ = f(5)
    j = j + 1
  }
  let fresh_before = Profiler::heap_bytes()
  while j < 2200 {
    let f = counter_through_early_pick(8, false)
    let _ = f(5)
    j = j + 1
  }
  inspect(Profiler::heap_bytes() - fresh_before < 1000, content = "true")
}

