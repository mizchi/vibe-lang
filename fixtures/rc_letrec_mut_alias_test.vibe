test "an early mutable alias releases the unused callback" {
  let mut i = 0
  while i < 200 {
    let f = pick_early_mut(fresh_counter(), fresh_counter(), true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = pick_early_mut(fresh_counter(), fresh_counter(), true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

