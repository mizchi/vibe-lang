}

test "an explicit return keeps an ambiguous mutable result alive" {
  inspect(counter_through_early_pick_return(8, true)(5), content = "9")
  inspect(counter_through_early_pick_return(8, false)(5), content = "6")
  let mut i = 0
  while i < 200 {
    let f = counter_through_early_pick_return(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_early_pick_return(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a helper with fresh callbacks returns its selected callback" {
  let mut i = 0
  while i < 200 {
    let f = pick_early(fresh_counter(), fresh_counter(), true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = pick_early(fresh_counter(), fresh_counter(), true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "replacing the mutable alias releases the recursive closure" {
  let mut i = 0
  while i < 200 {
    let f = counter_through_mutable_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_mutable_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a mutable mixed helper keeps both return paths owned" {
  let forwarded = counter_through_mutable_mixed_alias(8, false)
  inspect(forwarded(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = counter_through_mutable_mixed_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_mutable_mixed_alias(8, true)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a shadowed recursive name does not gain a spare reference" {
  let mut i = 0
  while i < 200 {
    let f = counter_with_shadowed_recursive_name(8)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_with_shadowed_recursive_name(8)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "branching mutable initializer transfers its selected recursive reference" {
  let left = counter_through_branching_mutable_alias(8, true)
  let right = counter_through_branching_mutable_alias(8, false)
  inspect(left(5), content = "9")
  inspect(right(5), content = "9")
}

test "reassignment transfers a recursive closure to the mutable slot" {
  let escaped = counter_through_mutable_reassignment(8)
  inspect(escaped(5), content = "9")
}

test "a mutable block result retains its recursive passthrough" {
  let escaped = counter_through_wrapped_mutable_alias(8)
  inspect(escaped(5), content = "9")
}

test "a mutable block follows its returned binding to the passthrough" {
  let escaped = counter_through_bound_mutable_alias(8)
  inspect(escaped(5), content = "9")
  let mut i = 0
  while i < 200 {
    let f = counter_through_bound_mutable_alias(8)
    let _ = f(5)
    i = i + 1
  }
  let before = Profiler::heap_bytes()
  while i < 2200 {
    let f = counter_through_bound_mutable_alias(8)
    let _ = f(5)
    i = i + 1
  }
  inspect(Profiler::heap_bytes() - before < 1000, content = "true")
}

test "a mutable block follows an alias through another binding" {
  let escaped = counter_through_nested_bound_mutable_alias(8)
  inspect(escaped(5), content = "9")
}

test "a mutable initializer follows a chain of immutable aliases" {
  let escaped = counter_through_chained_mutable_alias(8)
  inspect(escaped(5), content = "9")
}

test "a mutable passthrough argument retains either recursive branch" {
  let left = counter_through_branching_mutable_pass_arg(8, true)
  let right = counter_through_branching_mutable_pass_arg(8, false)
  inspect(left(5), content = "9")
  inspect(right(5), content = "9")
}

test "a mutable passthrough argument retains a wrapped recursive result" {
  let escaped = counter_through_wrapped_mutable_pass_arg(8)
  inspect(escaped(5), content = "9")
}

test "a mutable nested passthrough argument retains the recursive result" {
  let escaped = counter_through_nested_mutable_pass_arg(8)
  inspect(escaped(5), content = "9")
}

test "a mutable passthrough retains an alias returned through another helper" {
  let escaped = counter_through_aliased_nested_mutable_pass_arg(8)
  inspect(escaped(5), content = "9")
}

