// #3350: over the BUILTIN `Eq`, a bound whose witness dictionary keeps a
// wrong-shaped `equals` is refused too.
//
// Supertraits flatten in declaration order and the first `equals` wins, so
// `Key`'s dictionary keeps `Bad`'s `equals(Int, Int)`, which `==` does not
// call. The builtin `Eq` is method-bearing, so the #2612 guard never judged
// it, and `==` fell back to the builtin comparison: measured on the #3327
// stage2 (43ee1c792), this checked clean and answered `false` for two equal
// `Pt`. With `Good` listed first the dictionary keeps `Good`'s
// `equals(Self, Self) -> Bool` and the comparison is by content
// (fixtures/eq_builtin_subtrait_first_equals_test.vibe).

trait Good {
  equals(Self, Self) -> Bool
}

trait Bad {
  equals(Int, Int) -> Bool
}

trait Key: Bad + Good + Eq {}

struct Pt {
  v: Int
}

impl Key for Pt {
  equals(a: Int, b: Int) -> Bool {
    true
  }
}

fn same[T: Key](x: T, y: T) -> Bool {
  x == y
}

fn main() -> Unit allows Console {
  println(__to_string(same(Pt::{ v: 1 }, Pt::{ v: 1 })))
}
