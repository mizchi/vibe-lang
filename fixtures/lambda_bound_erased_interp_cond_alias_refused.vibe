//# #2745: a function value reached through a CONDITIONAL.
//
// Codex, P1 round 22 on #2761. Measured on `6c3b1d7`:
// `let g = if true { f } else { f }`, with `f: (T) -> T` a parameter, then
// `g(a)` printed a 3-digit pointer decimal.
//
// The binder read `EFn` and `EIdent` and masked everything else, so a value
// that merely PASSES A FUNCTION THROUGH lost what the function knew. The
// descent it needed is the one `dtd_interp_lamret_body_param` already makes
// for a lambda's body: "the value of an `if` is the value of a branch" is one
// statement, and every place that needs it should read it rather than restate
// it. That is the third time in this PR the answer was to make an existing
// rule reachable from a second place instead of writing a second rule.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T, f: (T) -> T) -> String {
    let g = if true {
      f
    } else {
      f
    }
    "\{g(a)}"
  }
  inner(Qt::{ w: 5 }, (v: Qt) -> Qt {
    v
  })
}

export fn _start() -> Int {
  String::length(outer(7))
}
