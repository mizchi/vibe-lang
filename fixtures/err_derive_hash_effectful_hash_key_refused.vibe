// #3551: a `derive (Hash)` field whose type's written `hash_key` declares
// `with Console`, imported from another module. The derived `Outer::hash_key`
// is generated after effect checking and declares no effects, so it called
// the effectful one anyway: `pure_key` below, whose row is empty, printed
// `hashing`. The derive is refused, naming the edit.

import ./modules/derive_hash_effectful_owner.vibe {
  struct Inner
}

struct Outer {
  i: Inner
} derive (Hash)

fn pure_key(o: Outer) -> String {
  Outer::hash_key(o)
}

export let _start: () -> Int = () -> {
  String::length(pure_key(Outer::{ i: Inner::{ n: 3 } }))
}
