import @vibe/core {
  add_by, contains_by, empty, from_array_by, remove_by, size, struct StringSet
}

struct Key { value: Int }

fn key_text(_ key: Key) -> String {
  "key=\{key.value}"
}

test "#2840: equal distinct values share an explicit StringSet key" {
  let original = Key::{ value: 5 }
  let set = StringSet::add_by(empty(), key = key_text, value = original)
  assert(StringSet::contains_by(set, key = key_text, value = original))
  assert(StringSet::contains_by(set, key = key_text, value = Key::{ value: 5 }))
  assert(!StringSet::contains_by(set, key = key_text, value = Key::{ value: 6 }))
  let removed = StringSet::remove_by(set, key = key_text, value = Key::{ value: 5 })
  assert(removed.is_empty())
  assert(set.contains(value = "key=5"))
}

test "#2840: bare helpers and arrays use the same key function" {
  let set = from_array_by(values = [
    Key::{ value: 5 },
    Key::{ value: 5 },
    Key::{ value: 6 }
  ], key = key_text)
  assert(size(set) == 2)
  assert(contains_by(s = set, key = key_text, value = Key::{ value: 5 }))
  let added = add_by(s = set, key = key_text, value = Key::{ value: 7 })
  let removed = remove_by(s = added, key = key_text, value = Key::{ value: 6 })
  assert(size(removed) == 2)
  assert(contains_by(s = removed, key = key_text, value = Key::{ value: 7 }))
  assert(!contains_by(s = removed, key = key_text, value = Key::{ value: 6 }))
}

test "#2840: Bool keys use the supplied renderer" {
  let render = (value: Bool) -> String {
    if value {
      "yes"
    } else {
      "no"
    }
  }
  let set = from_array_by(values = [true, false, true], key = render)
  assert(set.contains(value = "yes"))
  assert(set.contains(value = "no"))
  assert(!set.contains(value = "1"))
  assert(size(set) == 2)
}
