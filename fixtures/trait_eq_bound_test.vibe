// #1967: was fixtures/trait_eq_string_operator_runtime.vibe +
// fixtures/trait_eq_operator_accepts_eq_bound_type_parameter.vibe
// (`__DATA__.last` "true"). Seed already implements `[T: Eq] a == b` for
// String and Int; the generated unit lane trapped on the wrapper, not `==`.

fn eqs[T: Eq](a: T, b: T) -> Bool {
  a == b
}

test "Eq bound accepts String and Int" {
  inspect(eqs(a = "a", b = "a"), "true")
  inspect(eqs(a = "a", b = "b"), "false")
  inspect(eqs(a = 1, b = 1), "true")
  inspect(eqs(a = 1, b = 2), "false")
}
