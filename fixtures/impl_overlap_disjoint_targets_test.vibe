// #3551 review control: impls of one trait at disjoint targets in two
// modules (`Box[Int]`, `Box[String]`) share no type, so they are not an
// overlap, and each module's calls run its own impl.

import ./modules/impl_overlap_box_int.vibe {
  box_int_name
}

import ./modules/impl_overlap_box_string.vibe {
  box_string_name
}

test "impls at disjoint targets are not an overlap" {
  inspect("\{box_int_name()} \{box_string_name()}", "from-int from-string")
}
