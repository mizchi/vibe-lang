//# Codex round 14 on #2456: an untyped-empty compare INSIDE a generic body,
//# `fn same[T]`, next to an imported `struct T` (the #2141 guard sees only
//# same-file declarations). The element type here is the lexical formal, and
//# the checker records no typed-`==` row for a type variable (measured on
//# 33d2043: the module's eq-row count is empty), so the arm fails closed;
//# the consumer additionally refuses any row spelling a formal in scope, so
//# the spelling `T` can never be read as the imported declaration. Two
//# content-equal, separately allocated arrays must TRAP, never answer
//# `false` by reference.
//#
//# #2474 (a): the formal carries `Eq` because the checker now rejects `==` on
//# an operand whose type mentions an UNBOUNDED formal before anything is
//# lowered (lib/@vibe/compiler/tests/eq_unbounded_formal_test.vibe pins that
//# side). With the bound the untyped-empty arm below is reached exactly as
//# before, and the trap contract is unchanged until #2523 gives the bound a
//# real witness.

import ./structural_eq_untyped_empty_shadowed_formal_dep.vibe { T }

fn same[T: Eq](v: T, w: T) -> Bool {
  let left = []
  Array::push(left, v)
  let right = []
  Array::push(right, w)
  left == right
}

export fn _start() -> Int {
  if same([1, 2], [1, 2]) {
    0
  } else {
    1
  }
}
