// `\u{hex}` writes the UTF-8 bytes of a Unicode scalar value, and `\'` is a
// quote. A `String` is a byte string, so lengths count bytes.
test "unicode escapes are UTF-8 bytes" {
  inspect(String::length("\u{41}"), "1")
  inspect("\u{41}\u{42}" == "AB", "true")
  inspect(String::length("\u{e9}"), "2")
  inspect("\u{e9}" == "é", "true")
  inspect(String::length("\u{3042}"), "3")
  inspect("\u{3042}" == "あ", "true")
  inspect(String::length("\u{1F600}"), "4")
  inspect(String::byte_at("\u{1F600}", 0), "240")
}

test "an escaped single quote" {
  inspect("it\'s" == "it's", "true")
}
