// ADR-0071 (#755) step 5, WIT generation: wit_gen.vibe previously resolved
// each raw effect-row label verbatim, so an `effectset` alias (or a bare
// qualified `Effect::Op` row item with no plain `Effect` row item alongside
// it) never matched the effect definition it actually referred to and fell
// through to the "host capability effect ... no WIT mapping yet" comment
// marker, even though `Ask` has a real interface mapping. wit_gen.vibe now
// expands effectset aliases and resolves qualified operation items back to
// their underlying effect name before rendering. This fixture covers both:
// `with_alias` uses the effectset `AskAll`, `with_qualified` uses the bare
// qualified item `Ask::Get` directly (no plain `Ask` row item). Both must
// render the same `import ask: interface { get: ... }` block as an ordinary
// `with Ask` row would. Expected output: fixtures/wit_gen_effectset.golden.wit
// (byte-exact).

effect Ask {
  Get -> Int
}

effectset AskAll = { Ask::Get }

export let with_alias: () -> Int with AskAll = () -> {
  perform Ask::Get
}

export let with_qualified: () -> Int with Ask::Get = () -> {
  perform Ask::Get
}
