fn pass(f: () -> Array[Int]) -> () -> Array[Int] {
  f
}

fn build() -> () -> Array[Int] {
  region r {
    let values = MutList::empty(r)
    pass(() -> Array[Int] {
      MutList::to_array(values)
    })
  }
}

test "monomorphic callback result cannot erase region provenance" {
  let _ = build()
}
