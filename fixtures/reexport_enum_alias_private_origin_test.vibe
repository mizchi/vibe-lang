import ./import_kind_phase1/private_enum_alias_facade.vibe {
  Api
}

#cfg(disabled) fn hidden_pattern() -> Int {
  match Api::A {
    A => 0,
    _ => 1
  }
}

test "a public alias keeps a private enum constructor reachable" {
  inspect(Api::A == Api::A, content = "true")
  inspect(Api::A == Api::B, content = "false")
}

test "a qualified pattern selects a private enum constructor" {
  inspect(match Api::A {
    Api::A => 1,
    Api::B => 2
  }, content = "1")
  inspect(match Api::B {
    Api::A => 1,
    Api::B => 2
  }, content = "2")
}
