// #3567: interpolating a `derive (Hash)` type whose field's type has no
// renderer. The renderer `derive (Hash)` implies would render field `i`
// through `Inner::to_string`, which does not exist, so it is not derived (the
// key does not need it), and the interpolation is refused like that of a type
// that derives nothing, naming the edit. Before, it stopped with an internal
// compiler error (`Inner::to_string` reached code generation unresolved).

struct Inner {
  n: Int
}

impl Hash for Inner {
  hash_key(self: Inner) -> String {
    "i" + Int::to_string(self.n)
  }
}

struct Outer {
  i: Inner
} derive (Hash)

fn show_outer() -> String {
  let o = Outer::{ i: Inner::{ n: 3 } }
  "o=\{o}"
}

export let _start: () -> Int = () -> {
  String::length(show_outer())
}
