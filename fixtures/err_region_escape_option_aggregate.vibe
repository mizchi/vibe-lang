struct OptionSlot {
  callback: () -> Array[Int]
}

test "Option constructors preserve nominal field provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    Some(OptionSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    })
  }
  let Some(slot) = escaped
  let _ = slot.callback()
}
