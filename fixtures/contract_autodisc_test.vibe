// #730: sibling auto-discovery of contract implementation files. The
// package's index.vpkg declares fns but NO implementation imports; the
// loader enumerates the sibling *.vibe files with Fs::readdir, conformance-
// checks against their union, and builds the facade from the discovered
// list. Requires the readdir-capability seed (Fs::readdir codegen).

import ./contract_autodisc_pkg { triple, shout }

test "auto-discovered contract package works end to end" {
  assert(triple(14) == 42)
  assert(shout("vibe") == "vibe!")
}

import ./contract_autodisc_nested_pkg {
  triple as nested_triple, shout as nested_shout, double
}

// A direct production root explicitly re-exports the nested source. The
// package scanner itself does not recurse below the index.vpkg directory.
test "contract package reaches nested source through an explicit relative edge" {
  assert(nested_triple(14) == 42)
  assert(nested_shout("vibe") == "vibe!")
  assert(double(21) == 42)
}
