// #2987: a loop whose body shadows an outer binding with a value the
// interpolation pass cannot classify. The pass correctly claims no shape
// (claiming the OUTER `y`'s `String` printed `[276, 288]`, Codex on #1896),
// but the unclaimed render then reached the runtime heuristic and printed a
// bare address. The checker knows the value is an `Array[Option[Int]]`, so
// the build is refused instead; `let typed: Array[Option[Int]] = shadowed`
// renders it (fixtures/show_array_from_call_test.vibe).
export let _start: () -> Int = () -> {
  let y = "outer"
  let shadowed = for x in [1, 2] {
    let y = Some(x)
    y
  }
  let s = __to_string(shadowed)
  String::length(s) + String::length(y)
}
