// Codex on #3349: an APPLIED equality bound gets the equality edit.
//
// `trait Eq[A]` is a marker, so `[T: Eq[Int]]` at a struct is refused like
// `[T: Eq]` (the guard reads the bare trait name). The edit, though, was
// chosen by comparing the DISPLAYED reference, `Eq[Int]`, against "Eq", so
// this refusal ended with the `<` advice -- "`<` has no witness to dispatch
// through, so giving `Eq[Int]` a method would not help" -- when an
// `equals(Self, Self) -> Bool` method is exactly what makes `==` dispatch.

trait Eq[A] {}

struct Pt {
  v: Int
}

impl Eq[Int] for Pt {}

fn same[T: Eq[Int]](x: T, y: T) -> Bool {
  x == y
}

fn main() -> Unit allows Console {
  println(__to_string(same(Pt::{ v: 1 }, Pt::{ v: 1 })))
}
