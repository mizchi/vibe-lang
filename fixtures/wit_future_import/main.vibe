// #2064: a real program reaching the WIT-derived async import route. The two
// bindings come from `prices.wit` through `from_wit_future_imports`; each names
// its versioned interface address, so linked_compile emits
// `vibe.wit_future_get$example:prices/api@1.0.0#get-price` (and `#get-tax`),
// and the composer imports both from ONE `example:prices/api@1.0.0` instance
// rather than as root functions. Compiled and validated by
// scripts/test_wit_async_import_component_gate.sh.
import ./prices_bindings.vibe {
  get_price, get_tax
}

let run: () -> Int with Async = () -> {
  let p = get_price()
  let t = get_tax()
  await(p) + await(t)
}
