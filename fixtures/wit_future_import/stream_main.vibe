// #2066: WIT futures and a runner-private named host stream in ONE component.
// The stream is a root import, so it takes component func 0 and the WIT
// interface's aliased functions follow it; the lowers keep the core order
// (futures, then streams). 40 + 2 + (10 + 15 + 17) = 84. Compiled and executed
// by scripts/test_wit_async_import_component_gate.sh.
import ./prices_bindings.vibe {
  get_price, get_tax
}

fn drain(s: HostStream) -> Int with Async {
  let mut total = 0
  for b in s {
    total = total + b
  }
  total
}

let run: () -> Int with Async = () -> {
  let price = get_price()
  let tax = get_tax()
  let body = drain(host_stream_named("body"))
  await(price) + await(tax) + body
}
