// #3131 (Codex on #3091): a WIT call takes one of the adapter's 512 result
// slots, and only an await or a cancel gave it back. 600 futures dropped
// unawaited filled every slot, and the next, otherwise valid, call trapped.
// The oldest unawaited future's slot is now reclaimed when the table fills,
// so the price is read: 40. Executed by
// scripts/test_wit_async_import_component_gate.sh.
import ./prices_bindings.vibe {
  get_price, get_tax
}

let run: () -> Int with Async + Exception = () -> {
  let mut i = 0
  while i < 600 {
    let _ = get_tax()
    i = i + 1
  }
  await(get_price())
}
