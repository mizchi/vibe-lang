//# Codex round 14 on #2456: an untyped-empty compare INSIDE a generic body,
//# `fn same[T]`, next to an imported `struct T` (the #2141 guard sees only
//# same-file declarations). The element type here is the lexical formal, so
//# the checker records no typed-`==` row and the consumer refuses any row
//# spelling a formal in scope -- the spelling `T` can never be read as the
//# imported declaration.
//#
//# #2474 (a): this program is now REJECTED at check time, before anything is
//# lowered. `left == right` compares two `Array[T]` values and `T` carries no
//# `Eq` bound, so there is no comparator the one lowering of this body could
//# reach; the diagnostic names the bound as the edit. It used to compile and
//# fail closed at run time (the trap this fixture pinned); a compile-time
//# refusal is the same contract one phase earlier, and the gate asserts the
//# refusal and its message. The bound cannot simply be added here: `[T: Eq]`
//# at `Array[Int]` is itself refused (`no impl `Eq` for `Array[Int]``, the
//# marker-trait gate), which is exactly why the site had no comparator.

import ./structural_eq_untyped_empty_shadowed_formal_dep.vibe { T }

fn same[T](v: T, w: T) -> Bool {
  let left = []
  Array::push(left, v)
  let right = []
  Array::push(right, w)
  left == right
}

export fn _start() -> Int {
  if same([1, 2], [1, 2]) {
    0
  } else {
    1
  }
}
