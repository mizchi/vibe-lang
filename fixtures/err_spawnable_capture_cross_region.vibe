// #1081 step 3 Phase B: a spawn closure capturing a Sender endpoint from a
// DIFFERENT (outer) nursery is rejected exactly like any other non-Send
// value -- `Spawnable[r]` only permits an endpoint tagged with THIS SAME
// spawn call's own region, per docs/concurrency.md.
import @vibex/concurrent { TaskGroup, Channel, Sender }

fn main {
  let r = TaskGroup::run((outer) -> {
    match Channel::bounded(outer, 1) {
      Ok((tx, rx)) => {
        TaskGroup::run((inner) -> {
          TaskGroup::spawn(inner, () -> {
            let _ = Sender::send(tx, 1)
            0
          })
        })
      },
      Err(_) => Err(Cancelled)
    }
  })
  ()
}

