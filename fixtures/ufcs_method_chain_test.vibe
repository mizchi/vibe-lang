// #864: UFCS-style method chaining (`x.method(args)`) on a prelude function
// like `Result::and_then` used to fail at CODEGEN time with
// "unknown struct field: and_then" (or whichever method came next in a
// chain), even though the checker already accepted the expression as a
// normal function call (its `EDot(obj, method, ...)` arm in checker.vibe
// resolves `T::method` via type-directed lookup independently of codegen).
//
// Root cause: `infer_arg_type_name` in desugar_trait_dict.vibe (the
// best-effort pass that decides whether `x.method(args)` should be rewritten
// into a qualified function call, vs. left as a struct-field-holds-a-closure
// call) had no case for its `arg` itself being a UFCS call
// (`ECall(EDot(...), ...)`), so the RESULT TYPE of any `.method(...)` call
// went untracked. That broke exactly the chained / let-then-used shapes
// below: the outer `.method(...)` in a chain, or a later `.method()` on a
// `let`-bound UFCS call result, couldn't infer its receiver's type, so it
// was left as a bare EDot and codegen's EDot fallback (which only
// understands genuine struct-field projections) threw. A standalone single
// `x.and_then(f)` whose result is never chained/reused was unaffected —
// only the SECOND method in the pipeline (chained or via a `let`) surfaced
// the bug.

import ../lib/@vibe/prelude {
  Result, Ok, Err, Result::and_then
}

fn half(x: Int) -> Result[Int, String] {
  if x % 2 == 0 {
    Ok(x / 2)
  } else {
    Err("odd")
  }
}

test "pipe-first Result::and_then still works" {
  let a = Ok(4) |> Result::and_then(half)
  assert_eq(a.unwrap_or(-1), 2)
}

test "UFCS and_then on inline literal receiver, chained with unwrap_or" {
  let b = Ok(4).and_then(half)
  assert_eq(b.unwrap_or(-1), 2)
}

test "UFCS and_then on let-bound receiver, chained with unwrap_or" {
  let r: Result[Int, String] = Ok(16)
  let c = r.and_then(half)
  assert_eq(c.unwrap_or(-1), 8)
}

test "UFCS and_then multi-stage chain, inline literal receiver" {
  let d = Ok(16).and_then(half).and_then(half)
  assert_eq(d.unwrap_or(-1), 4)
}

test "UFCS and_then multi-stage chain, let-bound receiver" {
  let r: Result[Int, String] = Ok(16)
  let e = r.and_then(half).and_then(half)
  assert_eq(e.unwrap_or(-1), 4)
}

test "UFCS and_then chained directly with is_ok (no intermediate let)" {
  assert(Ok(4).and_then(half).is_ok())
  assert(!Ok(3).and_then(half).is_ok())
}

test "UFCS and_then propagates Err through the chain" {
  let f = Ok(3).and_then(half)
  assert(f.is_err())
  assert_eq(f.unwrap_or(-1), -1)
}
