test "generic option map" {
  let option_map = [A, B](opt: Option[A], f: (A) -> B) -> Option[B] {
    match opt {
      Some(v) => Some(f(v)),
      None => None
    }
  }
  let result = option_map(Some(5), (x: Int) -> Int {
    x * 10
  })
  inspect(match result {
    Some(n) => n,
    None => 0
  }, "50")
}
