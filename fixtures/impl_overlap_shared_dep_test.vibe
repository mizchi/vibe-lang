// #3544 control: one impl reached along two import paths (directly, and
// through another module that imports the implementing module) is ONE impl,
// merged once -- not an overlap.

import ./modules/impl_overlap_a.vibe {
  a_name
}

import ./modules/impl_overlap_via_a.vibe {
  via_a
}

test "an impl reached twice is not an overlap" {
  inspect(a_name(), "from-a")
  inspect(via_a(), "from-a")
}
