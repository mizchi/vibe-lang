//# #3297: `==` whose operands this site knows only by their generic head.
//# `a` and `b` are `Box[T]` for the function's `Eq`-bounded formal `T`, read
//# from struct literals the witness route does not resolve, so the last rung
//# of the ladder had only the name `Box` and called the derived `Box::equals`,
//# which compares the `v: T` field with the raw `==` -- reference identity for
//# the `derive (Eq)` struct the test passes. Measured before the refusal, the
//# comparison compiled clean and answered `false` for equal values. Annotating
//# the bindings (`let a: Box[T] = ...`) supplies the complete type
//# (`eq_derived_generic_annotated_witness_test.vibe`).

struct Box[T] {
  v: T
} derive (Eq)

struct Pt {
  x: Int;
  tags: Array[Int]
} derive (Eq)

fn same_box[T: Eq](x: T, y: T) -> Bool {
  let a = Box::{ v: x }
  let b = Box::{ v: y }
  a == b
}

test "equal fields" {
  inspect(same_box(Pt::{ x: 1, tags: [1] }, Pt::{ x: 1, tags: [1] }), "true")
}
