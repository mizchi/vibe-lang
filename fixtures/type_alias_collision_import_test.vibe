//# #3929: two dependencies each export a type alias spelled `Alias` (and a
//# generic `Pair`), and this file exports one more. The wasm-gc lane checks
//# the merged program again, and there the declarations used to share one
//# name, so `c`'s `-> Alias` read `d`'s `String`. Each provider's alias is
//# now renamed for that merge, and its importers follow.

import ./modules/type_alias_collision_c.vibe {
  Alias as CA,
  Box,
  Note,
  S,
  alias_companion,
  alias_positional,
  all,
  effect_formal,
  lambda_formal,
  mk,
  note_applied,
  note_bounded,
  note_value,
  outer_formal,
  run_note,
  slot_row,
  twins
}

import ./modules/type_alias_collision_d.vibe {
  greet, two
}

export type Alias = Bool

test "aliases of one name from three files" {
  let s: CA = mk()
  inspect(s.v, content = "5")
  let lit: CA = CA::{ v: 9 }
  inspect(S::double(lit), content = "18")
  let (x, _) = twins(lit)
  inspect(x.v, content = "9")
  inspect(all([lit, s]), content = "2")
  let g: String = greet()
  inspect(g, content = "hi")
  let p: Array[Int] = two()
  inspect(Array::length(p), content = "2")
  let bx: Box[Int] = Box::{ value: 4 }
  inspect(bx.value, content = "4")
  inspect(note_value(Note::{ n: 6 }), content = "6")
  inspect(note_applied(Note::{ n: 6 }), content = "7")
  inspect(note_bounded(Note::{ n: 6 }), content = "70")
  inspect(alias_companion(), content = "7")
  inspect(CA::seven(), content = "7")
  inspect(lambda_formal(), content = "s")
  inspect(alias_positional(), content = "3")
  inspect(outer_formal(x = "t"), content = "t")
  inspect(effect_formal(), content = "ok")
  inspect(slot_row(), content = "5")
  inspect(run_note(), content = "4")
  let b: Alias = true
  inspect(b, content = "true")
}
