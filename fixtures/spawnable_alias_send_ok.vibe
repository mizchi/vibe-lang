// #3125: the other side of err_spawnable_capture_alias.vibe -- an alias of
// `TaskGroup::spawn` whose closure captures only a `Send` value still
// compiles, as the direct call does.
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception {
  let base = 41
  let v = TaskGroup::run((n) -> {
    let sp = TaskGroup::spawn
    let h = sp(n, () -> base + 1)
    TaskHandle::join(h)
  })
  let _ = v
  ()
}
