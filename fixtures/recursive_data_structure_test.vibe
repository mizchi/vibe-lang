enum IntList {
  Nil;
  Cons(Int, IntList)
}

test "recursive data structure" {
  let rec sum_list = (lst: IntList) -> Int {
    match lst {
      Nil => 0,
      Cons(h, t) => h + sum_list(t)
    }
  }
  let rec rev_append = (lst: IntList, acc: IntList) -> IntList {
    match lst {
      Nil => acc,
      Cons(h, t) => rev_append(t, Cons(h, acc))
    }
  }
  let lst = Cons(1, Cons(2, Cons(3, Nil)))
  let rev = rev_append(lst, Nil)
  inspect(sum_list(rev), "6")
}
