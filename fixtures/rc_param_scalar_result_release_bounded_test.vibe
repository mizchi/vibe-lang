// #2827: a parameter consumed on some paths only is released on the others
// when the function's declared result is an `Int`, a `Bool` or `Unit`, even
// if another path hands back a field of it.
//
// The guarded epilogue drop a split parameter takes (#3988) does not retain
// an escaping interior read, so the planner declined it for any body whose
// value may be a view of the parameter -- and any field read counted, `ctx.n`
// of an `Int` field included. A function declared to return an `Int`, a
// `Bool` or `Unit` hands back a value that holds no pointer, so no path of it
// can return a view, and its parameters take the guarded drop.
//
// The shapes: a `match` arm returning an `Int` field (`by_arm`), an `if`
// returning a `Bool` field (`flag`), a `let` alias of the field (`via_let`)
// and a field read after a consuming early `return` (`after_return`). On a
// stage2 built from main at ae88b61 each leaked 128 B per round that skipped
// the consume, and __heap_ptr grew by 512,548 B over the run; with the
// change, 548 B.
//
// `items_of` returns an `Array` field, a view of its parameter, so it keeps
// declining (`perceus_param_scalar_result_plan_test` pins that), and the
// array it hands back has to come back intact. It is not a detector for a
// planner that wrongly admits it: measured on a stage2 whose planner treated
// every result as immediate, the scope-end drop this shape also takes retains
// the escaping field read first, and the answer and the shadow lane stayed
// clean. It runs for 8 rounds only, because declining leaks on the path that
// skips the consume. The gate compiles this under VIBE_RC=1 and bounds the
// growth (tests/gates/mid, 40f0q), and checks the answer on the bump, rc,
// shadow and gc lanes; the shadow lane traps on the drop of a freed block,
// which is what releasing a parameter twice on one path would hit.
//
// `main` sums, per round i of 2000, 3 + 0 + 3 + 3 = 9 for even i and
// i + (1 when i % 4 == 1) + i + i for odd i: 1000 * 9 +
// 3 * (1 + 3 + ... + 1999) + 500 = 3009500. The control adds, per round i of
// 8, i + 3: 28 + 24 = 52, so 3009552.

struct Ctx {
  xs: Array[Int];
  n: Int;
  ok: Bool
}

fn keep(_ c: Ctx) -> Ctx {
  c
}

fn mk(_ i: Int) -> Ctx {
  Ctx::{ xs: [i, i + 1, i + 2], n: i, ok: i % 4 == 1 }
}

fn by_arm(ctx: Ctx, o: Option[Int]) -> Int {
  match o {
    Some(_) => Array::length(keep(ctx).xs),
    None => ctx.n
  }
}

fn flag(ctx: Ctx, c: Bool) -> Bool {
  if c {
    Array::length(keep(ctx).xs) > 5
  } else {
    ctx.ok
  }
}

fn via_let(ctx: Ctx, c: Bool) -> Int {
  if c {
    Array::length(keep(ctx).xs)
  } else {
    let n = ctx.n
    n
  }
}

fn after_return(ctx: Ctx, c: Bool) -> Int {
  if c {
    return Array::length(keep(ctx).xs)
  } else {
    ()
  }
  ctx.n
}

fn items_of(ctx: Ctx, c: Bool) -> Array[Int] {
  if c {
    keep(ctx).xs
  } else {
    ctx.xs
  }
}

fn round(_ i: Int) -> Int {
  let even = i % 2 == 0
  let o = if even {
    Some(i)
  } else {
    None
  }
  let a = by_arm(ctx = mk(i), o = o)
  let b = if flag(ctx = mk(i), c = even) {
    1
  } else {
    0
  }
  let c = via_let(ctx = mk(i), c = even)
  let e = after_return(ctx = mk(i), c = even)
  a + b + c + e
}

fn control(_ i: Int) -> Int {
  let xs = items_of(ctx = mk(i), c = i % 2 == 0)
  Array::get(xs, at = 0) + Array::length(xs)
}

export fn main() -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 2000 {
    acc = acc + round(i)
    i = i + 1
  }
  let mut j = 0
  while j < 8 {
    acc = acc + control(j)
    j = j + 1
  }
  acc
}
