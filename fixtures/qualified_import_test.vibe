// #897 Phase 1: `import <path> as <mod> only { x, y }` binds the imported
// items under a namespace, accessed as `mod.x`/`mod.y` -- unlike a plain
// `import <path> { x, y }`, the bare names `x`/`y` are NOT brought into
// scope, so they stay free for the importing file's own use (e.g. the
// builtin `add` below).

import ./qualified_import_helper.vibe as helper only {
  add,
  double as twice
}

test "qualified import namespace access (#897)" {
  assert_eq(helper.add(40, 2), 42)
  assert_eq(helper.twice(21), 42)
}

test "qualified import does not pollute the bare names (#897)" {
  // `add` here is still the builtin integer add, not helper's `add` --
  // `only` scopes the import strictly under `helper.`.
  assert_eq(add(1, 2), 3)
}

struct LocalHelper {
  add: (Int, Int) -> Int
}

test "a local shadowing the qualified-import namespace wins (#897 Codex review)" {
  // `helper` here is a genuine local value with its OWN `add` field -- it
  // must shadow the qualified-import namespace of the same name, so
  // `helper.add(50, 8)` calls the field-stored subtraction, not the
  // imported (addition) `add`. Before the shadowing fix this silently
  // rewrote to the wrong function (50 + 8 = 58, not the expected 42).
  let helper = LocalHelper::{ add: (a, b) -> a - b }
  assert_eq(helper.add(50, 8), 42)
}
