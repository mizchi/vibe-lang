// #3144 round 4: wasm-gc's native Array-reference ABI excludes a generic
// signature, and knows which declarations were generic only from a table of
// NAMES collected before the generic binders are erased. That table used to
// be collected before a program's own `Array::length` was renamed aside
// (`Array::length$user`), so codegen looked the renamed declaration up, did
// not find it, read it as monomorphic and admitted it to the reference lane --
// one native array literal where the same program under any other name has
// none. The gate row compiles this on wasm-gc and counts them (must be 0).

fn Array::length[T](values: Array[Int], marker: T) -> Array[Int] {
  let _ = marker
  values
}

let ident: (Array[Int]) -> Array[Int] = (values) -> values

test "a generic program Array::length stays on the tagged ABI" {
  let input = [
    40,
    2
  ]
  let output = Array::length(input, 7)
  assert(Array::get(ident(output), 0) == 40)
}
