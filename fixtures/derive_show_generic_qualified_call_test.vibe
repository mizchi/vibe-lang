// #3559: `H::to_string(x)` on a `derive (Show)` generic struct or enum renders
// the content at the argument's instantiation, the way `"\{x}"` does. It used
// to call the one derived renderer, which erases the formals, and printed the
// field's address (`H { v: 280 }` for `[1, 2]`).

struct H[T] {
  v: T
} derive (Show)

enum W[T] {
  Wrap(T)
  Nothing
} derive (Show)

test "a qualified to_string on a generic struct renders the field" {
  let a = H::{ v: [1, 2] }
  inspect(H::to_string(a), "H { v: [1, 2] }")
  let b: H[Double] = H::{ v: 1.5 }
  inspect(H::to_string(b), "H { v: 1.5 }")
  inspect(H::to_string(H::{ v: 2.5 }), "H { v: 2.5 }")
  inspect(H::to_string(H::{ v: 3 }), "H { v: 3 }")
}

test "a qualified to_string agrees with interpolation" {
  let a = H::{ v: [1.5] }
  inspect(H::to_string(a) == "\{a}", "true")
}

test "a qualified to_string on a generic enum renders the payload" {
  let w: W[Array[Int]] = Wrap([4, 5])
  inspect(W::to_string(w), "Wrap([4, 5])")
}
