//# #2778: a nested show-shim interpolates the concrete argument.
//
// Gate compile control. Runtime answers live in
// `lambda_bound_nested_witness_test.vibe`.

trait Eq {
  equals(Self, Self) -> Bool
}

impl Eq for Int {
  equals(a: Int, b: Int) -> Bool {
    a == b
  }
}

export fn _start() -> Int {
  let inner = [T: Eq](a: T) -> String {
    "\{a}"
  }
  String::length(inner(7))
}
