// #1343 (ADR-0071 operation-level rows, builtin slice): a host capability can
// now be granted one OPERATION at a time. Before this, the builtin call path
// only ever compared the bare effect label, so `with Fs::read_file` was
// rejected with `missing { Fs }` and the only expressible grant was the whole
// effect (read + write + readdir). That coarseness is what forced rows like
// `with Http` to bundle "serve a port" with "make an outbound request".
//
// `reads_only` grants exactly one operation; `reads_and_writes` shows the bare
// effect still authorizes everything (unchanged behavior, the form all
// existing code uses).
fn reads_only(p: String) -> String with Fs::read_file {
  Fs::read_file(p)
}

fn reads_and_writes(p: String) -> Unit with Fs {
  Fs::write_file(p, Fs::read_file(p))
}

export let main = () -> Int with Fs {
  let _ = reads_only("Taskfile.pkl")
  42
}

test "main produces its recorded value" {
  // #1571: expectation moved off a `__DATA__` tail; `vibe test --update`
  // rewrites this literal.
  inspect(main(), "42")
}
