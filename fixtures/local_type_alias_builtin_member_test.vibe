//# #3909: a builtin type's operations are reached through a transparent
//# alias this file declares (`type D = Float64`, then `D::floor(2.5)`), the
//# way they already were through `import @vibe/builtin { Float64 as D }`
//# (#3758) and an importer alias of a re-exported builtin (#3888). It used to
//# be an unknown name on both lanes. A chain (`type E = D`) follows the same
//# rule, a labeled operation places its labels by the builtin's signature,
//# and a value binder spelled `D` does not shadow it: a qualified name is
//# never a field of a value.

type D = Float64

type E = D

type S = String

type I = Int

fn shadowed(D: Int) -> Float64 {
  D::floor(Int::to_float64(D) + 0.5)
}

test "builtin operations through a local alias" {
  inspect(D::floor(2.5), content = "2")
  inspect(E::ceil(1.5), content = "2")
  inspect(D::max(1.5, 2.5), content = "2.5")
  inspect(S::trim("  y  "), content = "y")
  inspect(S::starts_with("abc", prefix = "ab"), content = "true")
  inspect(I::to_string(3), content = "3")
  inspect(shadowed(D = 4), content = "4")
  let d: D = 1.5
  inspect(D::floor(d), content = "1")
}
