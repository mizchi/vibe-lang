import @vibe/lsp {
  lsp_main, lsp_published_diagnostics
}
import @vibe/json {
  Json
}

// The gate sends an exit frame. The unit runner closes stdin, which also exits the server.
fn main() -> Int allows Stdin + Console + Env + Fs {
  let _ = lsp_main(true, checked_error_row = false)
  let uri = "untitled:invocation-policy"
  let source = "import @vibe/concurrent/experimental { TaskGroup }\nexport fn main() -> Int { 0 }"
  let docs = Map::set(Map::new(), key = uri, value = source)
  let result = lsp_published_diagnostics(uri = uri, docs = docs, checked_error_row = false)
  if String::contains(Json::stringify(result), needle = "VIBE_UNSTABLE=1") {
    0
  } else {
    1
  }
}

test "an opted-in LSP invocation leaves independent diagnostics strict" allows Stdin + Console + Env + Fs {
  inspect(main(), content = "0")
}
