// #1116 Codex review (P1): a closure literal whose row carries TWO
// migrated effects (`with A + B`), used as a by-value HOF argument.
// A's sweep prepends `__ev_A`; the idempotency guard must be
// effect-specific so B's sweep still prepends `__ev_B` and rewrites the
// B perform — a blanket `__ev_` prefix check would skip it and let the
// raw B perform escape after B's handler is removed (arity trap / wrong
// value). want 33: A::Get resumes 10, B::Get resumes 20, 10 + 20 + 3.
effect A {
  Get -> Int
}

effect B {
  Get -> Int
}

fn run2(f: () -> Int with A + B) -> Int with A + B {
  f()
}

let _start = () -> Int {
  let both = () -> Int with A + B {
    let x = perform A::Get
    let y = perform B::Get
    x + y + 3
  }
  handle {
    handle {
      run2(both)
    } with A {
      Get => resume(10)
    }
  } with B {
    Get => resume(20)
  }
}
