// #2990: `Map::get` on a missing key traps. It used to answer the zero bit
// pattern typed as the value type: a String that printed `0` and compared
// equal to `""`, an Array at address 0, an Int `0` indistinguishable from a
// stored one. Pinned by the early gate: this program must FAIL at run time.
fn main allows Console {
  let mi = Map::from_pairs([("a", 1)])
  println("present: \{Map::get(mi, "a")}")
  println("missing: \{Map::get(mi, "zz")}")
}
