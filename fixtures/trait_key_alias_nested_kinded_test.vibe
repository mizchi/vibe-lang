// #3995: constructor application must still canonicalize accepted keys.
type Apply[F[_], X] = F[X]
type Dup[T] = (T, T)
type Wide = Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Apply[Dup, Int]]]]]]
trait Mark[X] {
  mark(Self) -> Int
}
struct Note { n: Int }
impl Mark[((((((Int, Int), (Int, Int)), ((Int, Int), (Int, Int))), (((Int, Int), (Int, Int)), ((Int, Int), (Int, Int)))), ((((Int, Int), (Int, Int)), ((Int, Int), (Int, Int))), (((Int, Int), (Int, Int)), ((Int, Int), (Int, Int))))), (((((Int, Int), (Int, Int)), ((Int, Int), (Int, Int))), (((Int, Int), (Int, Int)), ((Int, Int), (Int, Int)))), ((((Int, Int), (Int, Int)), ((Int, Int), (Int, Int))), (((Int, Int), (Int, Int)), ((Int, Int), (Int, Int))))))] for Note {
  mark(self) -> Int {
    self.n
  }
}
fn marked[T: Mark[Wide]](_ value: T) -> Int {
  T::mark(value)
}
test "nested constructor key matches the plain tuple key" {
  inspect(marked(Note::{ n: 37 }), content = "37")
}
