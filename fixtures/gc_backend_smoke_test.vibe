// wasm-gc backend smoke fixture (gate 40h). Covers the currently supported
// gc-lane subset: top-level annotated functions, an ANNOTATED LOCAL LAMBDA
// (the #705 distribute_local_fn_ann shape -- must behave identically to the
// linear backend), literal/string match arms, and while accumulation.
// KNOWN GC-LANE GAPS (pre-existing, not covered here): user-defined enums
// (ctor table is hardcoded to Option), constructor calls, nested patterns,
// and closures capturing `let mut` (ref-cell store miscompiles).

let is_pos: (Int) -> Bool = (n) -> {
  n > 0
}

let is_neg: (Int) -> Bool = (n) -> {
  n < 0
}

let pick: (Int, String) -> Int = (n, s) -> {
  match n {
    0 => 10,
    1 => match s {
      "a" => 20,
      _ => 21
    },
    _ => 30
  }
}

export let main = () -> Int {
  let check: (Int) -> Int = (sp) -> {
    let a = if is_pos(sp) {
      1
    } else {
      0
    }
    let b = if is_neg(sp) {
      113
    } else {
      2
    }
    a + b
  }
  let mut i = 0
  let mut acc = 0
  while i < 4 {
    acc = acc + pick(i, "a")
    i = i + 1
  }
  acc + check(5) + check(0 - 3)
}
