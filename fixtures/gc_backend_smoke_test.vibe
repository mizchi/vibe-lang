// wasm-gc backend smoke fixture (gate 40h). Covers the currently supported
// gc-lane subset: top-level annotated functions, an ANNOTATED LOCAL LAMBDA
// (the #705 distribute_local_fn_ann shape -- must behave identically to the
// linear backend), literal/string match arms, while accumulation, and (#538)
// user-defined enums: constructor calls, ctor pattern match with payload
// binds, and Option Some/None -- these were dead until the
// CompileCtxGc.gc_ctor_table field rename (the ctor table was constructed
// correctly but every read hit the wrong struct slot via the name-first-match
// field resolution bug; see the field-collision issue / #722).
// batch2 below locks the #538 round-2 fixes: nested ctor patterns, closures
// capturing `let mut` (linear ref cells), Map with real eq, the string-op
// builtin set (linear body reuse), StringBuilder, and `handle`/`throw` via
// wasm exception-handling try_table. Remaining frontier lives in
// scripts/test_gc_selfbuild.sh (run E2E of the gc-compiled compiler, P5 size).

let is_pos: (Int) -> Bool = (n) -> {
  n > 0
}

let is_neg: (Int) -> Bool = (n) -> {
  n < 0
}

// #1286: assert_eq must use the same content-aware equality lowering as the
// linear backend for a binding and a function result, not pointer identity.
let gc_string_echo: (String) -> String = (s) -> {
  String::concat(s, "!")
}

let pick: (Int, String) -> Int = (n, s) -> {
  match n {
    0 => 10,
    1 => match s {
      "a" => 20,
      _ => 21
    },
    _ => 30
  }
}

// Heap-growth exercise (#415 gc-lane memory.grow fix): push enough elements
// that the array data crosses the initial 1-page (64KB) linear memory -- this
// trapped OOB before emit_heap_memory_grow_check was wired into the gc
// backend's bump-allocation sites.
let grow_sum: (Int) -> Int = (n) -> {
  let xs: Array[Int] = []
  let mut i = 0
  while i < n {
    Array::push(xs, i % 7)
    i = i + 1
  }
  let mut j = 0
  let mut acc = 0
  while j < Array::length(xs) {
    acc = acc + Array::get(xs, j)
    j = j + 1
  }
  acc
}

// #538: user enums on the gc lane -- ctor calls, payload binds, multi-variant
// dispatch, and builtin Option. Locks the gc_ctor_table fix in place.
enum Shape {
  Dot;
  Circle(Int);
  Rect(Int, Int)
}

let area: (Shape) -> Int = (s) -> {
  match s {
    Dot => 1,
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h
  }
}

let unwrap_or: (Option[Int], Int) -> Int = (o, d) -> {
  match o {
    Some(v) => v,
    None => d
  }
}

let enum_sum: () -> Int = () -> {
  area(Dot) + area(Circle(3)) + area(Rect(4, 5)) + unwrap_or(Some(52), 0) + unwrap_or(None, 6)
}

// #538 batch-2 coverage: everything unlocked by the Map-eq fix, the linear
// string-op body reuse, recursive patterns, linear ref cells, and the
// try_table Error handler. Locks each in the enforced gate (the probe suite
// in scripts/test_gc_selfbuild.sh is informational only).
enum Tree {
  Leaf(Int);
  Node(Tree, Tree)
}

let rec tree_sum: (Tree) -> Int = (t) -> {
  match t {
    Leaf(v) => v,
    Node(Leaf(a), r) => a + tree_sum(r),
    Node(l, r) => tree_sum(l) + tree_sum(r)
  }
}

let risky: (Int) -> Int with Exception = (x) -> {
  if x == 0 {
    throw("zero")
  }
  100 / x
}

let batch2: () -> Int = () -> {
  // nested ctor pattern binds (6)
  let nested = tree_sum(Node(Leaf(1), Node(Leaf(2), Leaf(3))))
  // mut-capture closure via linear ref cell (12)
  let mut acc = 0
  let add = (n: Int) -> Unit {
    acc = acc + n
  }
  add(5)
  add(7)
  // Map with real eq (42)
  let mb = MapBuilder::new()
  MapBuilder::set(mb, "a", 40)
  MapBuilder::set(mb, "b", 2)
  let m = MapBuilder::freeze(mb)
  let map_v = Map::get(m, "a") + Map::get(m, "b")
  // string ops + StringBuilder (5 + 5)
  let s = "hello,world"
  let sops = if String::contains(s, "world") {
    String::index_of(s, ",")
  } else {
    0 - 1
  }
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "ab")
  StringBuilder::push(sb, "cde")
  let sblen = String::length(StringBuilder::freeze(sb))
  // Error handle via try_table (42)
  let handled = handle {
    risky(0)
  } with Exception {
    Throw(_) => 42
  }
  nested + acc + map_v + sops + sblen + handled
}

// float_batch locks the #744-family gc float fixes: raw-bits i64 comparison
// inverts the order of two NEGATIVE floats (cmp1/cmp2), integer `0 - bits`
// unary negation produces garbage (cmp3/cmp4), and `__to_string`/interp of a
// statically-floatish value stringified the raw f64 bits (cmp5). Expected
// contribution: 1 + 0 + 100 + 1000 + 10000 = 11101.
let float_batch: () -> Int = () -> {
  let a = 0.0 - 2.5
  let b = 0.0 - 1.5
  let cmp1 = if a < b {
    1
  } else {
    0
  }
  let cmp2 = if b < a {
    10
  } else {
    0
  }
  let x = 3.5
  let nx = -x
  let cmp3 = if nx < 0.0 {
    100
  } else {
    0
  }
  let cmp4 = if nx + x == 0.0 {
    1000
  } else {
    0
  }
  let s = "\{2.25}"
  let cmp5 = if s == "2.25" {
    10000
  } else {
    0
  }
  cmp1 + cmp2 + cmp3 + cmp4 + cmp5
}

// #997: `Double::to_int` lowers to wasm's `i64.trunc_f64_s`, which TRAPS
// (an unhandled wasm trap, not a catchable `Error`) on NaN or +-Infinity --
// on the gc backend just like the linear one (`gc_gen_double_to_int_body`
// in codegen/gc/backend_builtins_numeric.vibe carries the identical NaN /
// out-of-i64-range guard as the linear backend's `gen_double_to_int_body`).
// These now saturate to 0 instead of trapping; ordinary in-range values
// still truncate toward zero. Expected contribution: 0 + 0 + 0 + 37 = 37.
let double_to_int_batch: () -> Int = () -> {
  let nan = 0.0 / 0.0
  let pinf = 1.0 / 0.0
  let ninf = (0.0 - 1.0) / 0.0
  Double::to_int(nan) + Double::to_int(pinf) + Double::to_int(ninf) + Double::to_int(3.7) * 10 + 7
}

// #2107: `with Stdout` because `assert_eq` expands to a failure branch that
// prints, and the print builtins now carry their row. Inside a `test` block
// the standard test effect set grants it; this entry is a plain function, so
// it declares it.
export let main = () -> Int with Stdout {
  let check: (Int) -> Int = (sp) -> {
    let a = if is_pos(sp) {
      1
    } else {
      0
    }
    let b = if is_neg(sp) {
      113
    } else {
      2
    }
    a + b
  }
  let mut i = 0
  let mut acc = 0
  while i < 4 {
    acc = acc + pick(i, "a")
    i = i + 1
  }
  let heap_string = String::concat("vi", "be")
  assert_eq(heap_string, "vibe")
  assert_eq(gc_string_echo("ok"), "ok!")
  acc + check(5) + check(0 - 3) + grow_sum(30000) + enum_sum() + batch2() + float_batch() + double_to_int_batch()
}
