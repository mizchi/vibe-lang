// #3625: bounded Float operations must use values and round every sum to f32.
fn same[T: Eq](a: T, b: T) -> Bool {
  a == b
}
fn plus[T: Add](a: T, b: T) -> T {
  a + b
}
fn accumulate[T: Add](a: T, b: T) -> T {
  let mut out = a
  out += b
  out += b
  out
}
fn keep[T: Show](_ a: T) -> T {
  a
}
fn pick[T](_ a: T) -> T {
  a
}
fn indirect[T: Add](a: T, b: T, make: () -> T) -> T {
  let saved = pick(a)
  (if true {
    saved
  } else {
    b
  }) + make()
}
fn nested[T: Add](a: T, b: T) -> (T, Float32) {
  let inner = [T: Add](x: T, y: T) -> T {
    x + y
  }
  (a + b, inner(0.1f, 0.2f))
}
fn concrete_result[T: Add](_ unused: T) -> Int {
  pick(20) + pick(7)
}

test "Float Eq compares values including IEEE edge cases" {
  inspect(same(a = 0.1f, b = 0.1f), content = "true")
  inspect(same(a = 0.1f, b = 0.2f), content = "false")
  inspect(same(a = -0.0f, b = 0.0f), content = "true")
  let nan = 0.0f / 0.0f
  inspect(same(a = nan, b = nan), content = "false")
  let inf = 1.0f / 0.0f
  inspect(same(a = inf, b = inf), content = "true")
  inspect(same(a = inf, b = -inf), content = "false")
  let alias: Float32 = 0.1f
  inspect(same(a = alias, b = 0.1f), content = "true")
}

test "Float Add rounds each generic sum" {
  inspect(plus(a = 1.5f, b = 2.25f), content = "3.75")
  inspect(plus(a = 0.1f, b = 0.2f), content = "0.3")
  inspect(plus(a = plus(a = 16777216.0f, b = 1.0f), b = -16777216.0f), content = "0")
  inspect(accumulate(a = 16777216.0f, b = 1.0f), content = "16777216")
  inspect(accumulate(a = 0.0f, b = 0.1f), content = "0.2")
  inspect(plus(a = -1.5f, b = -2.25f), content = "-3.75")
  inspect(plus(a = 1.0f / 0.0f, b = 1.0f), content = "Infinity")
  inspect(plus(a = 0.0f / 0.0f, b = 1.0f), content = "NaN")
  inspect(1.0f / plus(a = -0.0f, b = -0.0f), content = "-Infinity")
  let alias: Float32 = 0.1f
  inspect(plus(a = alias, b = 0.2f), content = "0.3")
}

test "generic dispatch follows lexical formals through expressions" {
  inspect(indirect(a = 0.1f, b = 0.2f, make = () -> Float32 {
    0.2f
  }), content = "0.3")
  inspect(nested(a = 20, b = 7), content = "(27, 0.3)")
  inspect(concrete_result(0.1f), content = "27")
}

test "Add retains Int String and Double behavior" {
  inspect(plus(a = 20, b = 7), content = "27")
  inspect(plus(a = "left", b = "right"), content = "leftright")
  inspect(plus(a = 1.5, b = 2.25), content = "3.75")
  inspect(plus(a = 0.1, b = 0.2), content = "0.30000000000000004")
  inspect(accumulate(a = 1.5, b = 0.25), content = "2")
  inspect(keep(0.1f), content = "0.1")
}

trait Key: Add
impl Key for Float32
fn inherited[T: Key](a: T, b: T) -> T {
  a + b
}

test "a subtrait inherits the binary32 Add witness" {
  inspect(inherited(a = 0.1f, b = 0.2f), content = "0.3")
}
