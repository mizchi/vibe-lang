// #3327 review (Codex on #3349): the witness `==` dispatches through is the
// FIRST `equals` the flattened dictionary keeps, so that is the one the guard
// judges.
//
// `Key` extends two traits that both declare `equals`. Supertraits flatten in
// declaration order and a later method of the same name is dropped, so here
// the dictionary keeps `Bad`'s `equals(Int, Int)`, which `==` does not call:
// the comparison would lower to the builtin one and compare `Pt` by
// reference. Refused. The reverse order, `Good + Bad + Eq`, keeps `Good`'s
// `equals(Self, Self) -> Bool` and compares through it
// (fixtures/eq_marker_subtrait_bound_accepted_test.vibe).

trait Eq {}

trait Good {
  equals(Self, Self) -> Bool
}

trait Bad {
  equals(Int, Int) -> Bool
}

trait Key: Bad + Good + Eq {}

struct Pt {
  v: Int
}

impl Eq for Pt {}

impl Key for Pt {
  equals(a: Int, b: Int) -> Bool {
    true
  }
}

fn same[T: Key](x: T, y: T) -> Bool {
  x == y
}

fn main() -> Unit allows Console {
  println(__to_string(same(Pt::{ v: 1 }, Pt::{ v: 1 })))
}
