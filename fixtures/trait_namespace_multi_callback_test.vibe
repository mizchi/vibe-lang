trait Mixer {
  mix(Self, (Int) -> Int, (Int) -> Int) -> Int
}

impl Mixer for Int {
  mix(self, left, right) -> Int {
    left(self) + right(self)
  }
}

test "trait namespace operation preserves distinct callbacks" {
  let result = Mixer::mix(2, (x) -> {
    x + 1
  }, (x) -> {
    x * 10
  })
  assert_eq(result, 23)
}
