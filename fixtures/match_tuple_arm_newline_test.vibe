// #2972: a match arm whose pattern starts with `(` may follow the previous arm
// on a new line. It was parsed as a call on the previous arm's value and
// failed with `unexpected in pattern: ;` at line 1:1.
fn f(p: (Int, Int)) -> Int {
  match p {
    (0, 0) => 1
    (1, _) => 2
    _ => 3
  }
}

fn g(p: (Int, Int)) -> String {
  match p {
    (0, 0) => "origin"
    (0, _) => "axis"
    _ => "plane"
  }
}

test "newline-separated tuple arms" {
  inspect(f((0, 0)), "1")
  inspect(f((1, 5)), "2")
  inspect(f((2, 2)), "3")
  inspect(g((0, 3)), "axis")
}
