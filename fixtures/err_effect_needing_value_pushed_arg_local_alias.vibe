// A block returns a closure stored in its array through a branch-local alias.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    apply(f = {
      let ys: Array[() -> Int] = [() -> 7]
      if true {
        let zs = ys
        Array::push(zs, value = g)
      } else {
        ()
      }
      Array::get(ys, at = 1)
    })
  } with { Ask::Get() => resume(5) }
}
_start()
