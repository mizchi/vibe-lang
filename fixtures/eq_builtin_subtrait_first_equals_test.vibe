//# Over the builtin `Eq`, the witness is the flattened dictionary's first `equals` (#3350).
//
// `Key: Good + Bad + Eq` keeps `Good`'s `equals(Self, Self) -> Bool` (the
// first one its supertraits flatten to) and `==` compares through it. The
// reverse order keeps `Bad`'s `equals(Int, Int)` and is refused
// (fixtures/err_type_eq_builtin_subtrait_wrong_first_equals.vibe).

trait Good {
  equals(Self, Self) -> Bool
}

trait Bad {
  equals(Int, Int) -> Bool
}

trait Key: Good + Bad + Eq {}

struct Pt {
  v: Int
}

impl Key for Pt {
  equals(a: Pt, b: Pt) -> Bool {
    a.v == b.v
  }
}

fn same[T: Key](x: T, y: T) -> Bool {
  x == y
}

test "the first flattened equals is the witness over the builtin Eq" {
  inspect(same(Pt::{ v: 1 }, Pt::{ v: 1 }), "true")
  inspect(same(Pt::{ v: 1 }, Pt::{ v: 2 }), "false")
}
