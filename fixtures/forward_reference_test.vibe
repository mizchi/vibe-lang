// #1967: was fixtures/forward_reference.vibe + __DATA__.last "11",
// fixtures/forward_reference_no_ret_annotation.vibe + __DATA__.last "11",
// fixtures/forward_reference_mutual.vibe + __DATA__.last "true", and
// fixtures/forward_reference_annotated_let.vibe + __DATA__.last "42".
// Current `fn` is hoisted (lowered to `let rec`) and expresses the function
// values. Local `let` forward-ref (including annotated value lets) is still
// rejected — see lib/@vibe/compiler/tests/forward_reference_debt_test.vibe.

fn double_then_add(x: Int) -> Int {
  add_one(x * 2)
}

fn add_one(x: Int) -> Int {
  x + 1
}

fn is_even(n: Int) -> Bool {
  if n == 0 {
    true
  } else {
    is_odd(n - 1)
  }
}

fn is_odd(n: Int) -> Bool {
  if n == 0 {
    false
  } else {
    is_even(n - 1)
  }
}

test "forward-looking call uses the later helper" {
  inspect(double_then_add(5), "11")
}

test "mutually recursive even/odd via hoisted fn" {
  inspect(is_even(10), "true")
}
