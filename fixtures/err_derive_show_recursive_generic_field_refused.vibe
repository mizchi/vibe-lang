// #3082: a derived renderer whose field is a recursive `derive (Show)` generic
// at an argument other than `Int` / `String` (`L[Bool]`) can only call the
// field type's erased renderer, which would print the nested `Bool` payloads
// through the erased formal. Refused, naming the edit.
struct L[T] {
  head: T;
  rest: Option[L[T]]
} derive (Show)

struct O {
  l: L[Bool]
} derive (Show)

export let _start: () -> Int = () -> {
  let o = O::{ l: L::{ head: true, rest: None } }
  let s = "o=\{o}"
  String::length(s)
}
