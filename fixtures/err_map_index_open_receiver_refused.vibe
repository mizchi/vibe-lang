// #3133: an index whose receiver's type never resolves is REFUSED at build
// time. `c` is an erased type parameter: the one lowering this body gets must
// serve every instantiation, and array indexing on a Map reads its backing
// store positionally -- before this refusal, `at(m, "a")` returned a wrong
// value (or trapped out of bounds) with no diagnostic. The edit is an
// annotation, or the explicit `Map::get` / `Array::get`.

fn at[T](c: T, k: String) -> Int {
  c[k]
}

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), key = "a", value = 1)
  at(c = m, k = "a")
}
