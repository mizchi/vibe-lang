// Row chain: two nested handlers each consume one effect (inline)
effect Auth { Verify(String) -> Bool }
effect Log { Info(String) -> Unit }

// Inner handle: Auth → resume(true), Log passes through
// Outer handle: Log → resume(0)
let result = handle {
  handle {
    perform Log::Info("start")
    let ok = perform Auth::Verify("token")
    if ok { 42 } else { 0 }
  } { Auth::Verify(_token) => resume(true) }
} { Log::Info(_msg) => resume(0) }
result

__DATA__
{"last": "42"}
