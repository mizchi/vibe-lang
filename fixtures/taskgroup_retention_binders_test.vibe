import @vibe/concurrent {
  TaskGroup, TaskHandle
}
struct Box[T] { mut v: Option[T] }

fn binder_zero() -> Int with Exception {
  let outside: Box[Box[TaskHandle[Int]]] = Box::{ v: None }
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> 42)
    let f = () -> Box[TaskHandle[Int]] with Exception {
      let _ = TaskHandle::join(h); Box::{ v: None }
    }
    outside.v = Some(f())
    0
  })
  match outside.v {
    Some(b) => match b.v {
      None => 42,
      Some(_) => 0
    },
    None => 0
  }
}

test "safe zero binder result stays independent" allows Exception {
  assert_eq(binder_zero(), 42)
}

fn binder_match() -> Int with Exception {
  let result = TaskGroup::run((g) -> {
    let b: Box[TaskHandle[Int]] = Box::{ v: None }
    let _ = {
      match Some(Box[TaskHandle[Int]]::{ v: None }) {
        Some(b) => {
          b.v = Some(TaskGroup::spawn(g, () -> 42))
          match b.v {
            Some(h) => TaskHandle::join(h),
            None => 0
          }
        },
        None => 0
      }
    }
    b
  })
  match result.v {
    None => 42,
    Some(_) => 0
  }
}

test "safe match binder result stays independent" allows Exception {
  assert_eq(binder_match(), 42)
}

fn binder_for() -> Int with Exception {
  let result = TaskGroup::run((g) -> {
    let b: Box[TaskHandle[Int]] = Box::{ v: None }
    let _ = {
      for b in [Box[TaskHandle[Int]]::{ v: None }] {
        b.v = Some(TaskGroup::spawn(g, () -> 42))
        let _ = match b.v {
          Some(h) => TaskHandle::join(h),
          None => 0
        }
      }
    }
    b
  })
  match result.v {
    None => 42,
    Some(_) => 0
  }
}

test "safe for binder result stays independent" allows Exception {
  assert_eq(binder_for(), 42)
}

fn binder_rec() -> Int with Exception {
  let result = TaskGroup::run((g) -> {
    let b: Box[TaskHandle[Int]] = Box::{ v: None }
    let _ = {
      let rec b = () -> Int with Exception {
        TaskHandle::join(TaskGroup::spawn(g, () -> 42))
      }
      b()
    }
    b
  })
  match result.v {
    None => 42,
    Some(_) => 0
  }
}

test "safe rec binder result stays independent" allows Exception {
  assert_eq(binder_rec(), 42)
}

fn binder_loop() -> Int with Exception {
  let result = TaskGroup::run((g) -> {
    let b: Box[TaskHandle[Int]] = Box::{ v: None }
    let _ = {
      loop (b = Box[TaskHandle[Int]]::{ v: None }) {
        b.v = Some(TaskGroup::spawn(g, () -> 42))
        break match b.v {
          Some(h) => TaskHandle::join(h),
          None => 0
        }
      }
    }
    b
  })
  match result.v {
    None => 42,
    Some(_) => 0
  }
}

test "safe loop binder result stays independent" allows Exception {
  assert_eq(binder_loop(), 42)
}

fn binder_zero_expr() -> Int with Exception {
  let outside: Box[Box[TaskHandle[Int]]] = Box::{ v: None }
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, () -> 42)
    outside.v = Some((() -> Box[TaskHandle[Int]] with Exception {
      let _ = TaskHandle::join(h); Box::{ v: None }
    })())
    0
  })
  match outside.v {
    Some(b) => match b.v {
      None => 42,
      Some(_) => 0
    },
    None => 0
  }
}

test "safe zero_expr binder result stays independent" allows Exception {
  assert_eq(binder_zero_expr(), 42)
}
