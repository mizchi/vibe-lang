// #639 criterion 2: a `handle ... with Ask` discharges Ask for its body,
// but `needs_both` also requires Fs, which nothing here handles. The
// row-mismatch message must show Ask as already covered and Fs as the one
// genuinely still missing, distinguishing "handled locally but this call
// needs more" from a plain "nothing declared at all" mismatch
// (fixtures/err_effect_missing_annotation.vibe). Since #2975 the handled
// labels have their own clause instead of being folded into "declared" and
// the hint, which told the reader to declare what the handle discharged.
// needle: "missing { Fs } (no 'with' clause, requires { Fs }) (handled here by an enclosing `handle`: { Ask, Ask::Get })"
effect Ask {
  Get -> Int
}

fn needs_both() -> Int with Ask + Fs {
  perform Ask::Get
}

fn handles_ask_only() -> Int {
  handle {
    needs_both()
  } with {
    Ask::Get => resume(1)
  }
}
