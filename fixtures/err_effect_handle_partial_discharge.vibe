// #639 criterion 2: a `handle ... with Ask` discharges Ask for its body,
// but `needs_both` also requires Fs, which nothing here handles. The
// row-mismatch message names Fs as the one genuinely still missing. Since
// #2975 it describes the function's OWN row (none here) and leaves the
// handled Ask out entirely, so the hint it prints is pasteable as written.
// needle: "missing { Fs } (no 'with' clause, requires { Fs })"
effect Ask {
  Get -> Int
}

fn needs_both() -> Int with Ask + Fs {
  perform Ask::Get
}

fn handles_ask_only() -> Int {
  handle {
    needs_both()
  } with {
    Ask::Get => resume(1)
  }
}
