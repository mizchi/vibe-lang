// #639 criterion 2: a `handle ... with Ask` discharges Ask for its body,
// but `needs_both` also requires Fs, which nothing here handles. The
// row-mismatch message must show Ask as already covered ("declared with
// { Ask, Ask::Get }" -- handle-discharged effects are unioned into the
// declared row before the check) and Fs as the one genuinely still
// missing, distinguishing "handled locally but this call needs more" from
// a plain "nothing declared at all" mismatch (fixtures/err_effect_missing_annotation.vibe).
// needle: "missing { Fs } (declared with { Ask, Ask::Get }, requires { Ask, Ask::Get, Fs })"
effect Ask {
  Get -> Int
}

fn needs_both() -> Int with Ask + Fs {
  perform Ask::Get
}

fn handles_ask_only() -> Int {
  handle {
    needs_both()
  } with Ask {
    Get => resume(1)
  }
}
