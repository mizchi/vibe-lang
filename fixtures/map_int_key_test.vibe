// #1967: was fixtures/map_int_key.vibe + __DATA__.last "200", and
// fixtures/map_int_key_has_keys.vibe + __DATA__.last "1".
// MapBuilder::set only accepts String keys; Int-key writes/reads go
// through set_by / get_by / has_by. The stale MapBuilder::set(Int, ...)
// shape is still rejected — see
// lib/@vibe/compiler/tests/map_int_key_debt_test.vibe.

import @vibe/core {
  get_by, has_by, set_by
}

test "map Int-key get_by returns the stored value" {
  let empty: Map[String, Int] = Map::new()
  let m = set_by(set_by(set_by(empty, 1, 100), 2, 200), 3, 300)
  match get_by(m, 2) {
    Some(v) => inspect(v, "200"),
    None => inspect(0, "200")
  }
}

test "map Int-key has_by and keys keep the claimed 1" {
  let empty: Map[String, Int] = Map::new()
  let m = set_by(set_by(set_by(empty, 10, 100), 20, 200), 30, 300)
  let has10 = has_by(m, 10)
  let has99 = has_by(m, 99)
  let count = Array::length(Map::keys(m))
  let claimed = if has10 && not(has99) && count == 3 {
    1
  } else {
    0
  }
  inspect(claimed, "1")
}
