// Open row: middleware handles Log, passes through rest
effect Log { Info(String) -> Unit }
effect Db { Query(String) -> String }

// | e means "plus whatever other effects"
let with_log = [A](f: () -> A with Log | e) -> A with e {
  handle { f() } with Log {
    Info(_msg) => resume(0)
  }
}

// app uses Log + Db
let result = with_log(() -> Int with Log + Db {
  perform Log::Info("querying")
  let data = handle {
    perform Db::Query("SELECT 1")
  } with Db {
    Query(_sql) => resume("result")
  }
  String::length(data)
})
result

