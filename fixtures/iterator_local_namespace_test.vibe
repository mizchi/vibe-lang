trait Iterator[T] {
  iter_length(Self) -> Int
  iter_get(Self, Int) -> T
}

fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] {
  [77]
}

test "a local Iterator helper keeps its own semantics" {
  let values = Iterator::map([1, 2], (x: Int) -> Int {
    x + 1
  })
  assert_eq(values, [77])
}
