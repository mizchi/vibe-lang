// ADR-0071 step 1 (docs/effectset.md): `with ...` row items may now name
// a single qualified operation (`Effect::op`), not just a whole effect name.
// This fixture is a parse/round-trip/compile/run smoke test for that new
// grammar (collect_effect_names in lib/@vibe/parser/parser_base.vibe) --
// operation-level CHECKING (rejecting a perform of a DIFFERENT operation of
// the same effect when only one operation is named in the row) is a
// separate, larger change (step 3), not implemented yet.
effect Ask {
  Get -> Int
}

let read_one = () -> Int with Ask::Get {
  perform Ask::Get
}

export let main = () -> Int with Ask::Get {
  handle {
    read_one()
  } with Ask {
    Get => resume(42)
  }
}

__DATA__
{"last": "42"}
