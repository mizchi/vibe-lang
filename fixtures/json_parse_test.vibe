// #1967: was fixtures/json_parse.vibe + __DATA__.last "5".
// Current @vibe/json ships parse(s) -> (Json, Int) (throws) and
// throwing Json::get / Json::as_*. last "5" is the object's key_count.

import @vibe/json {
  Json, parse
}

test "json parse object key_count is 5" {
  let (obj, _) = parse("{\"name\":\"alice\",\"age\":30,\"active\":true,\"scores\":[1,2,3],\"meta\":null}")
  let name = Json::as_str(Json::get(obj, "name"))
  let age = Json::as_num(Json::get(obj, "age"))
  let active = Json::as_bool(Json::get(obj, "active"))
  inspect(name, "alice")
  assert(eq(age, 30.0))
  assert(active)
  let keys = Map::keys(Json::as_obj(obj))
  let key_count = Array::length(keys)
  inspect(key_count, "5")
}
