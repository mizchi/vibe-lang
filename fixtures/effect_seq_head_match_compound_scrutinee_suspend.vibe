// #1536 (a) v8: a constructor wrapping a suspension is a compound scrutinee.
// The suspension is named first and the constructor is applied to the name, so
// the operation happens once, the arm selection sees the wrapped value, and the
// sequence tail after the match still runs once.
effect Ask {
  Get(Int) -> Int
}

let visits = [
  0
]
let tails = [
  0
]

let _start = () -> Int {
  handle {
    let mut got = 0
    match Some(perform Ask::Get(2) + 1) {
      Some(n) => {
        got = n
        got
      },
      None => {
        got = 9
        got
      }
    }
    Array::set(tails, 0, Array::get(tails, 0) + 1)
    got * 100 + Array::get(visits, 0) * 10 + Array::get(tails, 0)
  } with {
    Ask::Get(n) => {
      Array::set(visits, 0, Array::get(visits, 0) + 1)
      let k = resume
      k(n + 1)
    }
  }
}

test "compound match scrutinee suspends once" {
  inspect(_start(), "411")
}
