import ../lib/@vibe/builtin {
  String::count, String::join, String::replace, String::replace_all, String::trim_start, String::trim_end
}

//# Misc

test "string equality" {
  assert("hello" == "hello")
  assert("foo" != "bar")
  let a = "abc"
  let b = "abc"
  assert(a == b)
}

test "string length" {
  assert(String::length("hello") == 5)
  assert(String::length("") == 0)
  assert(String::length("a") == 1)
}

test "string concat" {
  let s = String::concat("he", "llo")
  assert(s == "hello")
}

test "string + operator" {
  assert("hello" + " world" == "hello world")
  let a = "foo"
  let b = "bar"
  assert(a + b == "foobar")
}

test "string substring" {
  let s = "hello"
  assert(String::substring(s, 1, 4) == "ell")
  assert(String::substring(s, 0, 5) == "hello")
}

test "string slice" {
  let s = "hello"
  assert(s[1: 4] == "ell")
  assert(s[: 3] == "hel")
  assert(s[2:] == "llo")
}

test "string split" {
  let parts = String::split("a,b,c", ",")
  assert(Array::length(parts) == 3)
  assert(Array::get(parts, 0) == "a")
  assert(Array::get(parts, 1) == "b")
  assert(Array::get(parts, 2) == "c")
}

test "string index_of" {
  assert(String::index_of("hello", "ll") == 2)
  assert(String::index_of("hello", "xyz") == -1)
}

test "string contains" {
  assert(String::contains("hello world", "world"))
  assert(not(String::contains("hello", "xyz")))
}

test "string starts_with ends_with" {
  assert(String::starts_with("hello", "hel"))
  assert(String::ends_with("hello", "llo"))
  assert(not(String::starts_with("hello", "llo")))
  assert(not(String::ends_with("hello", "hel")))
}

test "string trim" {
  assert(String::trim("  hello  ") == "hello")
  assert(String::trim_start("  hello") == "hello")
  assert(String::trim_end("hello  ") == "hello")
}

test "string to_upper to_lower" {
  assert(String::to_upper("hello") == "HELLO")
  assert(String::to_lower("HELLO") == "hello")
}

test "string replace" {
  assert(String::replace("hello world", "world", "vibe") == "hello vibe")
}

test "string replace_all" {
  assert(String::replace_all("aaa", "a", "b") == "bbb")
}

test "string char_code_at" {
  assert(String::char_code_at("A", 0) == 65)
  assert(String::char_code_at("a", 0) == 97)
}

test "string from_char_code" {
  assert(String::from_char_code(65) == "A")
  assert(String::from_char_code(97) == "a")
}

test "string join" {
  let parts = [
    "a",
    "b",
    "c"
  ]
  assert(String::join(parts, ",") == "a,b,c")
  assert(String::join(parts, "") == "abc")
}

test "string interpolation" {
  let x = 42
  let s = "val=\{x}"
  assert(s == "val=42")
}

test "raw string" {
  let s = "hello\\nworld"
  assert(String::length(s) == 12)
}

test "string count" {
  assert(String::count("banana", "a") == 3)
  assert(String::count("hello", "ll") == 1)
}

test "string concat in mut assign" {
  let mut r = ""
  r = "ab" + "cd"
  assert(r == "abcd")
  r = r + "ef"
  assert(r == "abcdef")
}

test "string concat in while loop" {
  let mut r = ""
  let mut i = 0
  while i < 3 {
    r = r + "x"
    i += 1
  }
  assert(r == "xxx")
}

test "string concat in continue args" {
  let result = loop (i = 0, acc = "") {
    if i >= 3 { break(acc) }
    continue(i + 1, acc + Int::to_string(i))
  }
  assert(result == "012")
}

test "string equality in mut assign" {
  let mut eq = false
  eq = "foo" == "foo"
  assert(eq)
  eq = "foo" == "bar"
  assert(not(eq))
}
