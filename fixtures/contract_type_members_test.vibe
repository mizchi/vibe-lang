// A package contract that re-exports a type from another module publishes the
// type's derived methods and its impl methods, supertrait methods included,
// without declaring them (#3172 review). The free functions under the same
// types are refused: fixtures/typecheck/contract_type_member_free_fn_reject.vibe.

import ./modules/contract_type_members {
  Node, Ver, make_node, make_ver
}

fn label(o: Ordering) -> String {
  match o {
    Less => "less",
    Equal => "equal",
    Greater => "greater"
  }
}

test "derived methods travel through a contract" {
  let a = make_ver(1, 2)
  let b = make_ver(1, 9)
  inspect(Ver::equals(a, a), "true")
  inspect(Ver::equals(a, b), "false")
  inspect(label(Ver::compare(a, b)), "less")
}

test "impl methods travel through a contract, inherited ones included" {
  let n = make_node(4)
  inspect(Node::child_m(n), "5")
  inspect(Node::base_m(n), "4")
}
