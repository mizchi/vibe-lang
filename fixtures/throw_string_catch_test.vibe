// throw string → catch → verify string is preserved

// If string is preserved, result should be "hello_error" (length 11)

test "throw string catch" {
  let safe = () -> String with Exception {
    throw("hello_error")
    "unreachable"
  }
  let result = handle {
    safe()
  } with { Exception::Throw(msg) => msg }
  inspect(String::length(result), "11")
}
