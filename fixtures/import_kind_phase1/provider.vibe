export type Alias = Int

export struct Record {
  value: Int
}

export enum Choice {
  First;
  Second
}

export fn is_first(value: Choice) -> Bool {
  match value {
    Choice::First => true,
    Choice::Second => false
  }
}

export effect Audit {
  Emit(String) -> Unit
}

export trait Marker

export fn Record::make(value: Int) -> Record {
  Record::{ value }
}

export let answer = 42
