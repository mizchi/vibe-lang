// ADR-0021: Mut effect via CPS continuation
// 明示継続 `k` 形式 (一般形, one-shot, non-tail 呼び出し可)。
// canonical な `resume` との規約は docs/mut-effect-plan.md「継続呼び出し規約」(#627)。
effect Emit {
  Emit(Int) -> Unit
}

// Sum emitted values: 10 + 20 + 30 + 0 = 60
let count = handle {
  perform Emit::Emit(10)
  perform Emit::Emit(20)
  perform Emit::Emit(30)
  0
} with Emit {
  Emit(v, k) => v + k(0)
}
count

__DATA__
{"last": "60"}
