// ADR-0021: Mut effect via CPS continuation
// Stateful accumulation without mutable state in handler scope
effect Emit {
  Emit(Int) -> Unit
}

// Count: how many values were emitted
let count = handle {
  perform Emit::Emit(10)
  perform Emit::Emit(20)
  perform Emit::Emit(30)
  0
} {
  Emit::Emit(v, k) => 1 + k(0)
}

// Sum: accumulate emitted values
let sum = handle {
  perform Emit::Emit(10)
  perform Emit::Emit(20)
  perform Emit::Emit(30)
  0
} {
  Emit::Emit(v, k) => v + k(0)
}

// count=3, sum=60
// Test count only (sum tested separately in effect_cps_collect_array)
count

__DATA__
{"last": "0"}
