// #3440: exported functions with parameter defaults, imported by
// param_default_import_test.vibe.

export fn greet(name: String, times: Int = 1) -> String {
  "\{name} x\{times}"
}

// A default that reads an earlier parameter is evaluated in the callee, so it
// sees the importer's argument.
export fn span(start: Int, end: Int = start + 10) -> Int {
  end - start
}

fn two(x: Int, y: Int = 1, z: Int = 100) -> Int {
  x + y + z
}

// The export-list spelling publishes the same header.
export {
  two
}

// A default and a plain optional on one header: only the default refuses a
// written `None`, so the bits must line up with the right parameter.
export fn mixed(a: Int, b?: Int, c: Int = 5) -> String {
  let shown = match b {
    Some(v) => Int::to_string(v),
    None => "none"
  }
  "\{a} \{shown} \{c}"
}
