// #3440: an imported function's parameter defaults apply exactly as in the
// defining module. Before, exporting such a function was refused, because an
// importer could not tell a default from a plain `x?`.

import ./lib.vibe {
  greet, greet as hello, mixed, span, two
}

import ./facade.vibe {
  greet as relayed, greet_once
}

test "an imported default is taken when the argument is omitted" {
  inspect(greet("hi"), content = "hi x1")
  inspect(greet("hi", 3), content = "hi x3")
}

test "an imported default can be passed by label" {
  inspect(greet(name = "hi", times = 4), content = "hi x4")
}

test "an imported default that reads an earlier parameter sees the argument" {
  inspect(span(5), content = "10")
  inspect(span(5, 8), content = "3")
}

test "a function exported by list keeps its defaults" {
  inspect(two(1), content = "102")
  inspect(two(1, 2), content = "103")
  inspect(two(1, z = 0), content = "2")
}

test "a default and a plain optional on one imported header" {
  inspect(mixed(1), content = "1 none 5")
  inspect(mixed(1, None), content = "1 none 5")
  inspect(mixed(1, Some(2), 3), content = "1 2 3")
}

test "an aliased import keeps the default" {
  inspect(hello("hey"), content = "hey x1")
}

test "a re-exported function keeps the default" {
  inspect(relayed("yo"), content = "yo x1")
  inspect(relayed(name = "yo", times = 2), content = "yo x2")
  inspect(greet_once("so"), content = "so x1")
}
