// #2978: `Double::to_int` truncates toward zero inside the Int range and
// saturates outside it -- `Int::max_value` above, `Int::min_value` below, and
// `0` for NaN. It used to answer `0` for every out-of-range value.
test "Double::to_int saturates" {
  let big = 1000000000000000000000000000000.0
  let z = 0.0
  inspect(Double::to_int(2.5), "2")
  inspect(Double::to_int(-2.5), "-2")
  inspect(Double::to_int(big), "4611686018427387903")
  inspect(Double::to_int(0.0 - big), "-4611686018427387904")
  inspect(Double::to_int(4611686018427387904.0), "4611686018427387903")
  inspect(Double::to_int(z / z), "0")
  inspect(Double::to_int(1.0 / z), "4611686018427387903")
}
