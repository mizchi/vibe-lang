test "array builder collect" {
  let b = ArrayBuilder::new()
  let _ = (ArrayBuilder::push(b, value = 10))
  let _ = (ArrayBuilder::push(b, value = 20))
  let _ = (ArrayBuilder::push(b, value = 30))
  let arr = ArrayBuilder::freeze(b)
  inspect(Array::get(arr, at = 0) + Array::get(arr, at = 1) + Array::get(arr, at = 2), "60")
}
