// Structural derive (#638): `derive(Ord)` / `derive(Show)` on a struct generate
// the structural free functions `Type::compare` (lexicographic over fields,
// returning -1 / 0 / 1) and `Type::to_string`. `Eq` is accepted as a no-op
// marker (structural `==` is a runtime builtin), and multiple derives may be
// listed together. Hash / Default and enums are deferred slices.

//# Types

struct Point { x: Int; y: Int } derive(Eq, Ord, Show)

//# Tests

test "derive(Ord): lexicographic compare returns -1 / 0 / 1" {
  assert_eq(Point::compare(Point::{ x: 1, y: 1 }, Point::{ x: 1, y: 2 }), 0 - 1)
  assert_eq(Point::compare(Point::{ x: 2, y: 0 }, Point::{ x: 1, y: 9 }), 1)
  assert_eq(Point::compare(Point::{ x: 5, y: 5 }, Point::{ x: 5, y: 5 }), 0)
}

test "derive(Show): structural to_string" {
  // `assert` + structural `==` (not assert_eq, which compares strings by
  // identity and so does not match a freshly-computed string against a literal).
  assert(Point::to_string(Point::{ x: 7, y: 9 }) == "Point { x: 7, y: 9 }")
  assert_eq(String::length(Point::to_string(Point::{ x: 7, y: 9 })), 20)
}
