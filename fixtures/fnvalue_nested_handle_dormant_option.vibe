effect Ask {
  Get() -> Int
}

fn inner_handled() -> Int with Ask {
  handle {
    perform Ask::Get()
  } with { Ask::Get() => resume(42) }
}

fn outer(f: () -> Int with Ask) -> Int {
  handle {
    f()
  } with { Ask::Get() => resume(1) }
}

export fn main() -> Int {
  let unused = Some(() -> Int {
    outer(inner_handled)
  })
  outer(() -> Int with Ask {
    perform Ask::Get()
  })
}
