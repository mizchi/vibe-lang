// Dependency of reexport_alias_companion_test.vibe (#3837). `Other` is
// declared before `P` with the same field set, so a value that lost `P`'s
// name could only be matched by shape -- and would match `Other` first.

export struct Other {
  x: Int
} derive (Show)

export struct P {
  x: Int
} derive (Show)

export fn Other::get(_ o: Other) -> String {
  "Other"
}

export fn P::get(_ p: P) -> String {
  "P \{p.x}"
}

export fn make(x: Int) -> P {
  P::{ x: x }
}

export enum Color {
  Red;
  Green
}

export fn Color::code(_ c: Color) -> Int {
  match c {
    Red => 1,
    Green => 2
  }
}
