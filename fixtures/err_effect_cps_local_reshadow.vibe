// #1720: an older step-local proof must not survive a same-named opaque bind.
effect Ask {
  Get(Int) -> Int
}

fn maker() -> () -> Int with Ask {
  () -> Int with Ask {
    perform Ask::Get(1)
  }
}

let _start = () -> Int {
  let pick = () -> Int with Ask {
    perform Ask::Get(2)
  }
  handle {
    let seed = perform Ask::Get(0)
    let pick = maker()
    let a = pick()
    seed + a * 10
  } with Ask {
    Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
