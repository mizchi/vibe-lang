// #3730: an applied bound keeps `Int32` while it is checked, so an impl
// written for `Tag[Int32]` satisfies a `Tag[Int32]` bound (it is not judged as
// `Tag[Int]`).
trait Tag[A] {}

struct P { x: Int }

impl Tag[Int32] for P

fn tagged[T: Tag[Int32]](_ v: T) -> Int {
  1
}

test "an impl at Tag[Int32] satisfies a Tag[Int32] bound" {
  inspect(tagged(P::{ x: 4 }), content = "1")
}
