// #3126: a program that divides Doubles as well as Ints. A Double `/` never
// traps, so the location pass skips one whose operand is a Double by its own
// syntax -- and must still place the Int division beside them.
// Pinned by the early gate: this program must FAIL at run time with that line.

fn scale(n: Int, d: Float64) -> Float64 {
  let acc = Int::to_float64(n) / 10000.0
  let half = (if n > 0 { 3.0 } else { 2.0 }) / 2.0
  acc + half + -Int::to_float64(n) / d
}

fn quotient(a: Int, b: Int) -> Int {
  let q = a
  q / b
}

fn main allows Console {
  println("before \{Float64::to_int(scale(40000, 4.0))}")
  println("after \{quotient(7, 0)}")
}
