// #3029: a generic struct payload's exception kind keeps its type argument.
// `throw(Box::{ value: 1 })` from a function declaring
// `Exception[Box[Int]]` used to be refused as requiring `Exception[Box]`.
struct Box[T] {
  value: T
}

fn fail_box() -> Int with Exception[Box[Int]] {
  throw(Box::{ value: 41 })
}

test "a generic struct payload is thrown under its full kind" {
  let r = handle {
    fail_box()
  } with {
    Exception[Box[Int]]::Throw(b) => b.value + 1
  }
  inspect(r, "42")
}
