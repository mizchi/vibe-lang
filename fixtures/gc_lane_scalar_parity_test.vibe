// #2404 / #2405 / #2407: three places the wasm-gc lane answered differently
// from the linear lane on ORDINARY values. Every assertion here must hold on
// BOTH lanes, which is the point -- each of these compiled and ran on linear
// and either trapped, refused to compile, or answered wrongly on gc.
//
// Run on both lanes by tests/gates/early/run.sh. A gc-only or linear-only
// run would miss exactly the divergence this file exists to catch.

// #2404: a labeled parameter is parsed with the marker ON THE NAME (`x~`)
// while the body says `x`. The gc backend bound the raw name, so this fn
// reported "internal compiler error: `x` (gc ident) reached code generation
// unresolved ... please report the source" for a valid program.
//
// Subtraction, not addition, so a reordering bug cannot pass (CLAUDE.md).
fn labeled_sub(x~: Int, y~: Int) -> Int {
  x - y
}

// The same for an optional parameter, which carries `x?`.
fn optional_sub(x?: Int, y?: Int) -> Int {
  match x {
    Some(a) => match y {
      Some(b) => a - b,
      None => a
    },
    None => 0
  }
}

//# Misc

test "#2404 a labeled parameter binds the name the body uses" {
  assert(labeled_sub(x = 10, y = 3) == 7)
  assert(labeled_sub(y = 3, x = 10) == 7)
  assert(optional_sub(x = 10, y = 3) == 7)
  // A lambda is a SEPARATE binding site, and its free-variable scan is a
  // third. With only the first fixed, the body's `x` became a bogus capture
  // and the call returned 0 with no diagnostic.
  let f = (x~: Int, y~: Int) -> Int {
    x - y
  }
  assert(f(x = 10, y = 3) == 7)
  assert(f(x = 3, y = 10) == 0 - 7)
}

test "#2422 a let rec lambda binds its labeled parameter" {
  // The ELetRec branch rescans the body with `collect_free_vars` to find the
  // self-capture, and it passed the RAW parameter names (`n~`) as the bound
  // set. The body's `n` was therefore not bound, became a bogus capture, every
  // later capture shifted, and `self_cap_idx` named the wrong slot -- the
  // self-closure was stored outside its environment and the call trapped with
  // "uninitialized element" on gc while running fine on linear.
  let rec countdown = (n~: Int) -> Int {
    if n <= 0 {
      0
    } else {
      countdown(n = n - 1)
    }
  }
  assert(countdown(n = 5) == 0)
  // Subtraction, so a reordering bug cannot pass, and two labels so the
  // capture list has something to shift.
  let rec sub_until = (a~: Int, b~: Int) -> Int {
    if a <= b {
      a - b
    } else {
      sub_until(a = a - 1, b = b)
    }
  }
  assert(sub_until(a = 5, b = 3) == 0)
  // The unlabeled control, which worked before and must keep working.
  let rec plain = (n: Int) -> Int {
    if n <= 0 {
      0
    } else {
      plain(n - 1)
    }
  }
  assert(plain(5) == 0)
}

test "#2405 a large Int renders as a number, not as an empty string" {
  // `__to_string` resolves to a builtin that decides Int-vs-String by a
  // heuristic on the bit pattern. `64 << 32` reads as (ptr 64, len 0), so it
  // was returned unchanged and rendered as "" on the gc lane.
  assert(__to_string(274877906944) == "274877906944")
  assert(__to_string(64<<32) == "274877906944")
  assert(__to_string(1<<40) == "1099511627776")
  // A bare ident has no shape to classify, so it needs the slot log rather
  // than the expression test -- this case survived the first fix.
  let x = 274877906944
  assert(__to_string(x) == "274877906944")
  let y = 0 - 274877906944
  assert(__to_string(y) == "-274877906944")
  // Controls: the small values that always worked, and zero.
  assert(__to_string(123) == "123")
  assert(__to_string(0) == "0")
  assert(__to_string(0 - 7) == "-7")
}

test "#2405 the int slot log does not swallow the other types" {
  // Bool and Int share this lane's representation, so a boolish binding must
  // keep its own classification or `true` renders as "1".
  let b = 1 < 2
  assert(__to_string(b) == "true")
  let c = 3 < 2
  assert(__to_string(c) == "false")
  let s = "hi"
  assert(__to_string(s) == "hi")
  let d = 1.5
  assert(__to_string(d) == "1.5")
}

test "#2405 a slot reused by a sibling scope is not read stale" {
  // The two branches bind DIFFERENT `v`s to the same reused slot. Reading the
  // else branch through the then branch's log entry would render a string as
  // a number.
  let r = if 1 < 2 {
    let v = 274877906944
    __to_string(v)
  } else {
    let v = "str"
    __to_string(v)
  }
  assert(r == "274877906944")
  let r2 = if 1 > 2 {
    let v = 274877906944
    __to_string(v)
  } else {
    let v = "str"
    __to_string(v)
  }
  assert(r2 == "str")
}

// #2405 follow-up: the integer renderer is emitted ONCE per module as a shared
// body and called, instead of inlined at every statically-int call site (that
// cost int_wrap +23% of its wasm). The body is pushed between the 56
// unconditional builtin bodies and the two conditional region-arena ones, so a
// module holding BOTH has to resolve all three indices correctly -- and a
// mis-derived index is a call into someone else's code, which builds fine and
// only shows up here.
fn region_len(n: Int) -> Int {
  region r {
    let xs = MutList::empty(r)
    let mut i = 0
    while i < n {
      MutList::push(xs, i * 2)
      i = i + 1
    }
    MutList::length(xs)
  }
}

/// #2422: a large Int reaching `__to_string` / `eq` through an annotated
/// parameter rather than a literal. Both lanes classify an ident through a
/// slot log, and both logs seeded Float and Bool params but not Int ones.
fn via_param(n: Int) -> String {
  __to_string(n)
}

fn eq_params(a: Int, b: Int) -> Bool {
  eq(a, b)
}

fn via_string(s: String) -> String {
  __to_string(s)
}

fn via_bool(b: Bool) -> String {
  __to_string(b)
}

fn via_double(d: Double) -> String {
  __to_string(d)
}

test "#2422 a large Int survives every binding form" {
  // Each of these reached the runtime string-pointer heuristic before, on one
  // lane or both, and rendered garbage or the empty string. Measured on the
  // committed seed: every one of them, so none is new here.
  assert(via_param(274877906944) == "274877906944")
  assert(!eq_params(64<<32, 65<<32))
  assert(eq_params(64<<32, 64<<32))
  let mut m = 64<<32
  assert(__to_string(m) == "274877906944")
  m = m + 1
  assert(__to_string(m) == "274877906945")
  let x = 64<<32
  let y = x
  let z = y
  assert(__to_string(y) == "274877906944")
  assert(__to_string(z) == "274877906944")
  // A LAMBDA parameter is a separate seeding site from a top-level one, on
  // both lanes.
  let lam = (n: Int) -> String {
    __to_string(n)
  }
  assert(lam(274877906944) == "274877906944")
  // The other annotated types must keep their own classification: Bool and
  // Int share this lane's representation, so a Bool read as an Int prints 1.
  assert(via_string("hi") == "hi")
  assert(via_bool(true) == "true")
  assert(via_double(1.5) == "1.5")
  let lam_b = (b: Bool) -> String {
    __to_string(b)
  }
  assert(lam_b(true) == "true")
  let lam_d = (d: Double) -> String {
    __to_string(d)
  }
  assert(lam_d(1.5) == "1.5")
}

/// #2423: a `let mut` CAPTURED BY A CLOSURE is the one binding form neither
/// test above reaches. `#2422 a large Int survives every binding form` pins an
/// uncaptured `let mut`, and `#2424 .. the binding forms the slot log never
/// seeded` pins a captured plain `let` -- this is the intersection, and it is
/// the shape #2423 was filed about.
///
/// It is different in kind, not just in spelling. A captured `let mut` does
/// not hold its value in a local at all: it becomes a heap ref cell and the
/// local holds the cell's ADDRESS, so every read is a load. That is why the
/// slot log could never classify it -- the thing in the slot is a pointer, and
/// calling a pointer an Int is the confusion the log exists to prevent. #2423
/// proposed a second log keyed on "slot holds a cell whose CONTENT is an Int".
///
/// What actually closed it is #2424's channel: the checker hands codegen the
/// type it already computed for the render argument, so where the value LIVES
/// stops mattering. Measured on the committed seed, both reads below render
/// the EMPTY STRING on linear and on gc; on the current compiler both answer,
/// on all three lanes this file runs.
test "#2423 a large Int survives a let mut captured by a closure" {
  let mut c = 64<<32
  let f = () -> Int {
    c
  }
  // Through the closure, and directly -- the seed rendered both as "".
  // Spelled with `inspect` per the snapshot policy: it desugars to the same
  // `__to_string` this test is about, so the oracle is unchanged, and the
  // expectations become refreshable by `vibe test --update`.
  //
  // NO TWO `inspect` rows in this test may share an expected literal.
  // `find_content_arg_span` (compiler/inspect_update.vibe) scans from offset
  // 0 and patches the FIRST `inspect(` whose content argument equals the
  // diagnosed expected text -- it has no idea which call failed. Two rows
  // with the same literal therefore cannot converge under
  // `vibe test --update`: the patcher rewrites the first, the next run fails
  // on the row it just broke, and the two ping-pong. So the closure read and
  // the direct read are taken at DIFFERENT values, and a second cell carries
  // the two orderings the first cannot.
  inspect(f(), content = "274877906944")
  // After a mutation, so the cell is read back rather than folded.
  c = c + 1
  inspect(c, content = "274877906945")
  // The second cell: direct read first, closure read after ITS mutation, so
  // both shapes are covered on both sides of a write.
  let mut k = 100<<32
  let fk = () -> Int {
    k
  }
  inspect(k, content = "429496729600")
  k = k + 2
  inspect(fk(), content = "429496729602")
  // The same capture through `eq`, the other spelling of the classifier. Two
  // conditions have to hold at once for these rows to be able to FAIL, and
  // each was measured by running the rows alone against the committed seed.
  //
  // (1) NEITHER operand may be a literal. The linear `eq` gate is a
  //     disjunction (the reason is spelled out at the `irc_ret_big` block
  //     below), so `eq(f(), 274877906945)` is satisfied by the literal alone
  //     and never asks about the captured cell.
  // (2) The two values must have the SAME low 32 bits. With the
  //     classification lost, `eq` falls back to the string comparison, which
  //     reads a value as (ptr<<32)|len -- so unequal low words are unequal
  //     "lengths" and it returns false immediately, which is the answer these
  //     rows want. Measured: with both low words 1 the fallback goes on to
  //     compare one byte at two different addresses and gets the right answer
  //     by luck, so only low word 0 on both sides is reliably red -- there the
  //     fallback compares two EMPTY strings, calls them equal, and `!eq`
  //     traps.
  //
  // Hence the second mutation: it puts `c` back on a zero low word while
  // still leaving the cell read back rather than folded, and the render
  // assertions above already cover the sharper low-word-1 case.
  c = c + ((1<<32) - 1)
  inspect(c, content = "279172874240")
  let mut c2 = 66<<32
  let g = () -> Int {
    c2
  }
  // Each `eq` is snapshotted through a String-valued branch rather than handed
  // to `inspect` directly. That spelling was forced when `__to_string` of an
  // `eq` RESULT answered "false" on linear and "0" on gc; #2464 has since fixed
  // that, and the row below pins the fix directly. The branch stays because it
  // asks about `eq` and NOTHING else -- it is false on a wrong comparison
  // whatever the renderer does -- so the two questions are pinned separately
  // instead of one row standing for both. Each pair of branch strings is
  // unique for the no-shared-literal reason above.
  // Both call-shaped.
  inspect(if eq(f(), g()) {
    "f=g"
  } else {
    "f!=g"
  }, content = "f!=g")
  inspect(if eq(f(), f()) {
    "f=f"
  } else {
    "f!=f"
  }, content = "f=f")
  // One call-shaped, one a bare ref-cell read.
  inspect(if eq(f(), c) {
    "f=c"
  } else {
    "f!=c"
  }, content = "f=c")
  inspect(if eq(f(), c2) {
    "f=c2"
  } else {
    "f!=c2"
  }, content = "f!=c2")
  // Both bare ref-cell reads.
  inspect(if eq(c, c2) {
    "c=c2"
  } else {
    "c!=c2"
  }, content = "c!=c2")
  inspect(if eq(c, c) {
    "c=c"
  } else {
    "c!=c"
  }, content = "c=c")
  // Controls: the classifier must not start answering Int for every captured
  // cell. A captured `let mut` of another type keeps its own rendering.
  let mut s = "hi"
  let fs = () -> String {
    s
  }
  inspect(fs(), content = "hi")
  let mut d = 1.5
  let fd = () -> Double {
    d
  }
  inspect(fd(), content = "1.5")
  // A captured `let mut` Bool. This row was LEFT OUT when the test landed,
  // because `__to_string` of a Bool produced by a lambda whose `let` is inside
  // a function body rendered "1" on both lanes and on the seed -- #2462. The
  // typed-lowering Bool channel (tag 5) closed it, so the row is here now, and
  // it is the shape no syntactic rule could reach: the lambda's declared return
  // type lives on an ELet-bound EFn, and `collect_fn_returns` walks statements.
  let mut bl = 1 < 2
  let fb = () -> Bool {
    bl
  }
  inspect(fb(), content = "true")
  bl = 1 > 2
  inspect(fb(), content = "false")
  // #2464: a Bool-returning BUILTIN call as a render argument. The gc lane
  // rendered this "0" where linear rendered "false" -- a regression against the
  // committed seed, and exactly the divergence this three-lane file exists to
  // catch. Both halves of the channel are exercised: the value below is a
  // builtin call result, and the `eq` rows above are the same classifier asked
  // through a different consumer.
  inspect(eq(1, 2), content = "false")
  inspect(eq(2, 2), content = "true")
  inspect(not(eq(1, 2)), content = "true")
}

test "#2405 polymorphic arithmetic is not assumed to be Int" {
  // `+ - * /` are resolved from the OPERANDS by the checker (Int, then Double,
  // then String for `+`, then a user impl), so the operator alone says
  // nothing. The gc scalar predicate answered Int for all four when it was
  // first copied over; the Codex review on #2422 caught it.
  //
  // No String `+` reaches codegen today -- `desugar_trait_dicts` rewrites
  // every measured shape into `String::concat` -- so these are the reachable
  // half, plus the concat forms as the control that they stay right.
  assert(__to_string(1.5 + 2.5) == "4")
  assert(__to_string(2.5 * 2.0) == "5")
  assert(__to_string(1.5 - 0.5) == "1")
  assert(eq("a" + "b", "ab"))
  assert(!eq("a" + "b", "ba"))
  assert(("a" + "b") == "ab")
  assert(__to_string("a" + "b") == "ab")
  let sa = "x"
  let sb = "y"
  assert(eq(sa + sb, "xy"))
  assert(__to_string(sa + sb) == "xy")
  // Int arithmetic over int-bound locals still resolves, which is what keeps
  // the shared renderer reachable for the eight sites in bench/exec/int_wrap.
  let i = 64<<32
  let j = 1
  assert(__to_string(i + j) == "274877906945")
  assert(__to_string(i * 1) == "274877906944")
}

test "#2405 the shared renderer and the region arena bodies coexist" {
  assert(region_len(5) == 5)
  assert(__to_string(64<<32) == "274877906944")
  assert(__to_string(region_len(3) * 1) == "3")
  let big = 1<<40
  assert(__to_string(big) == "1099511627776")
  assert(region_len(7) == 7)
}

test "#2407 eq answers on two distinct large Ints" {
  // The gc `eq` arm sent every non-bit-identical pair to `String::equals`,
  // which reads its operands as `(ptr << 32) | len` fat pointers -- an
  // out-of-bounds load for an Int whose high word is a plausible address.
  assert(!eq(64<<32, 65<<32))
  assert(eq(64<<32, 64<<32))
  assert(!eq((0 - (64<<32)) - 1, (0 - (65<<32)) - 1))
  assert(!eq(0 - 274877906945, 0 - 279172874241))
  // UNARY negation, which is a different AST node from the binary subtraction
  // above and slipped through it (#2422 review). `bc_expr_is_intish` answered
  // `!`/`~` and nothing else for a unary operator, so `-x` fell to the string
  // fallback even though `bc_expr_is_floatish` had recursed for `-` all along.
  assert(!eq(-(64<<32), -(65<<32)))
  assert(eq(-(64<<32), -(64<<32)))
  // Through a chain, and with the operand itself an int-bound name.
  assert(!eq(-(-(64<<32)), -(-(65<<32))))
  let big = 64<<32
  assert(!eq(-big, -(65<<32)))
  // Unary `-` over small values, which worked before for the same accidental
  // reason the small positive ones did.
  assert(!eq(-5, -6))
  // Through BINDINGS, which is a separate path: the call-site classifier reads
  // a bare ident from the slot log, and the log is written by a predicate that
  // had the same unary gap. `eq` over two let-bound negated Ints reached the
  // string fallback (#2422 review).
  let na = -(64<<32)
  let nb = -(65<<32)
  assert(!eq(na, nb))
  assert(eq(na, na))
  assert(__to_string(na) == "-274877906944")
  // Small values, which always worked because the bogus address happened to
  // be in bounds.
  assert(!eq(1, 2))
  assert(eq(3, 3))
  // A genuinely string `eq` still compares content.
  assert(eq("ab", "ab"))
  assert(!eq("ab", "ac"))
  // `eq` and `==` must answer the same on every one of these.
  assert(eq(64<<32, 65<<32) == ((64<<32) == (65<<32)))
  assert(eq(3, 3) == (3 == 3))
}

/// #2426: `Double` equality reached no float comparison on the gc lane.
/// `emit_gc_eq_value` routes on `gc_expr_is_intish` and otherwise falls
/// through to the `eq` builtin, and neither consults `gc_expr_is_floatish` --
/// which the neighbouring `<` `>` `<=` `>=` lowering has consulted all along,
/// with a comment naming `-0.0` as one of the values a raw bit compare
/// misranks.
///
/// That left two silent wrong answers, and this pair of helpers covers the
/// second one, where the operand arrives through a parameter rather than as a
/// literal:
///
///   * The `eq` builtin's fallback reads each operand as a `(ptr << 32) | len`
///     fat pointer. `-0.0` has bit 63 set, so its implied pointer is far out
///     of bounds, the "both operands look like strings" guard answers no, and
///     the result is "not equal" -- while IEEE 754 says `+0.0 == -0.0` is
///     true. The linear lane agrees with IEEE; only gc disagreed.
///   * `gc_expr_is_intish` answers true for `+ - * /` from the OPERATOR alone,
///     so two float arithmetic operands took a raw `i64.eq` over their f64
///     bits instead. `1.5 + 2.5 == 4.0` was right only because equal Doubles
///     have equal bit patterns -- an accident, not a routing.
fn dbl_eq(a: Double, b: Double) -> Bool {
  a == b
}

fn dbl_ne(a: Double, b: Double) -> Bool {
  a != b
}

/// A division the compiler cannot fold, so `dz(0.0, 0.0)` really is a NaN
/// produced at run time.
fn dz(a: Double, b: Double) -> Double {
  a / b
}

test "#2426 Double equality follows IEEE 754, not the bit pattern" {
  // The pair whose bit patterns differ ONLY in the sign bit -- which is what a
  // raw i64 compare distinguishes and an f64 compare does not.
  assert(0.0 == -0.0)
  assert(-0.0 == 0.0)
  assert(!(0.0 != -0.0))
  // Through names, either side, and both sides at once: the operand shapes
  // that reach the classifier as a bare ident rather than a literal.
  let a = 0.0
  let b = -0.0
  assert(a == -0.0)
  assert(0.0 == b)
  assert(a == b)
  assert(!(a != b))
  // Through an annotated parameter, the binding form the slot log seeds
  // separately from a `let`.
  assert(dbl_eq(0.0, -0.0))
  assert(!dbl_ne(0.0, -0.0))
  // `-0.0` arising from ARITHMETIC rather than from the literal, which is how
  // it turns up in real code (an underflowing negative product), and the
  // branch on it that used to be taken wrongly.
  let z = 0.0 * -1.0
  assert(z == 0.0)
  if z == 0.0 {
    assert(true)
  } else {
    assert(false)
  }
  // Ordinary Double equality, which was already right and must stay right --
  // including the arithmetic operands that `gc_expr_is_intish` claimed.
  assert(1.5 == 1.5)
  assert(!(1.5 == 2.5))
  assert(-1.5 == -1.5)
  assert(!(-1.5 == 1.5))
  assert(1.5 + 2.5 == 4.0)
  assert(!(1.5 + 2.5 == 4.5))
  assert(2.5 * 2.0 == 5.0)
  assert(1.5 != 2.5)
  assert(dbl_eq(1.5, 1.5))
  assert(!dbl_eq(1.5, 2.5))
  // A `while` condition is a third call site into the same routing, next to
  // the plain expression and the `if` above.
  let mut n = 3.0
  let mut steps = 0
  while n != 0.0 {
    n = n - 1.0
    steps = steps + 1
  }
  assert(steps == 3)
  // NaN is the other value IEEE 754 separates from a bit compare, and in the
  // opposite direction: two NaNs have IDENTICAL bits and are still not equal.
  // Measured on main's gc stage2, both inversions were live -- `nan == nan`
  // answered true and `nan != nan` answered false -- while linear answered
  // both the IEEE way. `!=` gets this from the callers' `eqz` over the same
  // `f64.eq`, so it needs no arm of its own.
  let nan = dz(0.0, 0.0)
  assert(!(nan == nan))
  assert(nan != nan)
  assert(!(nan == 1.5))
  assert(nan != 1.5)
  assert(!dbl_eq(nan, nan))
  assert(dbl_ne(nan, nan))
  // The Int and String sides of the same routing are untouched: a float guard
  // that also swallowed these would trade one silent wrong answer for another.
  assert(0 == 0)
  assert(!(0 == 1))
  assert((64<<32) == (64<<32))
  assert(!((64<<32) == (65<<32)))
  assert("ab" == "ab")
  assert(!("ab" == "ac"))
  assert(true == true)
  assert(!(true == false))
}

/// #2426 follow-up (Codex review on #2430): the BUILTIN `eq` is the other
/// spelling of `==`, and it was routed on raw bits after `==` stopped being.
/// Two operands, one concept -- the repository's rule is that these may not
/// answer differently.
fn eq_dbl(a: Double, b: Double) -> Bool {
  eq(a, b)
}

test "#2426 the eq builtin answers on Doubles, not on their bits" {
  // The sharpest case, and it is NOT signed zero: on the gc lane `eq` fell
  // through to the content fall-back, which reads each operand as
  // `(ptr << 32) | len`. A Double's low 32 bits are its mantissa TAIL, which
  // is zero for every round value -- so `0.0` and `1.5` both decoded as
  // zero-length strings and `String::equals` called them EQUAL. Measured on
  // 978ccefc4, gc: `eq(0.0, 1.5)` answered true, for two ordinary distinct
  // Doubles, with no diagnostic.
  assert(!eq(0.0, 1.5))
  assert(!eq(2.0, 4.0))
  assert(!eq(1.0, 8.0))
  // Signed zero, where the linear lane's arm was RC-only: its own comment
  // gave the reason as "non-RC matches the existing `==` behavior", and `==`
  // had just stopped behaving that way.
  assert(eq(0.0, -0.0))
  assert(eq(-0.0, 0.0))
  // NaN, the opposite direction: identical bits, and still not equal.
  let nan2 = dz(0.0, 0.0)
  assert(!eq(nan2, nan2))
  assert(!eq(nan2, 1.5))
  // Ordinary equal Doubles, which must keep answering true.
  assert(eq(1.5, 1.5))
  let da = 1.5
  let db = 1.5
  assert(eq(da, db))
  let dz1 = 0.0
  let dz2 = -0.0
  assert(eq(dz1, dz2))
  assert(!eq(dz1, 1.5))
  // Through annotated parameters, the binding form each lane seeds
  // separately from a `let`.
  assert(eq_dbl(0.0, -0.0))
  assert(!eq_dbl(0.0, 1.5))
  assert(eq_dbl(1.5, 1.5))
  // The two spellings must agree, which is the property this test exists for.
  assert(eq(0.0, -0.0) == (0.0 == -0.0))
  assert(eq(0.0, 1.5) == (0.0 == 1.5))
  assert(eq(2.0, 4.0) == (2.0 == 4.0))
  assert(eq(1.5, 1.5) == (1.5 == 1.5))
  assert(eq(nan2, nan2) == (nan2 == nan2))
  assert(eq(da, db) == (da == db))
  // And the Int and String sides of `eq` keep their own routing: a float arm
  // that swallowed them would trade one silent wrong answer for another.
  assert(eq(3, 3) == (3 == 3))
  assert(eq(64<<32, 65<<32) == ((64<<32) == (65<<32)))
  assert(eq("ab", "ab"))
  assert(!eq("ab", "ac"))
  assert(eq(true, true))
  assert(!eq(true, false))
}

/// #2426 follow-up (Codex review on #2430): a Double that arrives through a
/// JOIN -- an `if`, a `match`, a block -- was invisible to every float
/// classifier, so the binding was never logged and `==` fell back to a raw
/// bit compare. Measured before the fix, on ALL THREE lanes including RC:
/// the `if`, `match` and block forms each answered `0.0 == -0.0` false and
/// `nan == nan` true, while the same values written as literals answered
/// correctly. The linear lane's `expr_is_boolish` has classified joins since
/// #825; the float twin never got the arms.
///
/// `jcond` keeps the condition out of reach of constant folding, so the join
/// is a real one at run time.
fn jcond(n: Int) -> Bool {
  n > 0
}

fn jpick(n: Int) -> Int {
  n
}

test "#2426 a Double keeps its type through a join" {
  // if
  let ia = if jcond(1) {
    0.0
  } else {
    1.0
  }
  let ib = if jcond(1) {
    -0.0
  } else {
    1.0
  }
  assert(ia == ib)
  assert(eq(ia, ib))
  assert(!(ia == 1.5))
  // match
  let ma = match jpick(1) {
    1 => 0.0,
    _ => 1.0
  }
  let mb = match jpick(1) {
    1 => -0.0,
    _ => 1.0
  }
  assert(ma == mb)
  assert(eq(ma, mb))
  // A block, which reaches the classifier as a `let` wrapper rather than as a
  // sequence. `(-0.0)` is parenthesized on purpose: a `-` at the START of a
  // line continues the previous line's expression, so the bare form here
  // parses as `jcond(1) - 0.0` and the checker rejects it -- measured, and
  // exactly what `binop_mismatch_msg`'s Unit-left-operand hint describes.
  let ba = {
    let _bu = jcond(1)
    0.0
  }
  let bb = {
    let _bu2 = jcond(1)
    (-0.0)
  }
  assert(ba == bb)
  assert(eq(ba, bb))
  // A join arm that ends in its OWN binder. The body is a bare `EIdent`, so a
  // plain body recursion answers "not a Double" -- the name has no slot at
  // classification time. Answered without an environment: the `let`
  // immediately above the identifier binds that exact name, so no inner scope
  // intervenes and no outer binding of the name is reachable (Codex review on
  // #2432).
  let la = if jcond(1) {
    let lx = 0.0
    lx
  } else {
    let lx = 1.0
    lx
  }
  let lb2 = if jcond(1) {
    let ly = (-0.0)
    ly
  } else {
    let ly = 1.0
    ly
  }
  assert(la == lb2)
  assert(eq(la, lb2))
  assert(!(la == 1.5))
  // NOT asserted, deliberately, and measured: ONE HOP FURTHER
  // (`let x = 0.0; let z = x; z` in each arm) still compares by raw bits on
  // all three lanes. That shape cannot be answered from syntax alone -- it
  // needs the binding's TYPE -- and carrying an environment through the
  // descent instead is the design CLAUDE.md records going silently wrong (an
  // outer `let v = 1` read for an inner `v` of another type). #2424.
  // NaN through a join, the other direction: identical bits, not equal.
  let na = if jcond(1) {
    dz(0.0, 0.0)
  } else {
    1.0
  }
  assert(!(na == na))
  assert(na != na)
  assert(!eq(na, na))
  // Ordinary Doubles through a join still compare as Doubles.
  let pa = if jcond(1) {
    1.5
  } else {
    2.5
  }
  let pb = if jcond(1) {
    1.5
  } else {
    9.5
  }
  assert(pa == pb)
  assert(!(pa == 2.5))
  // A join whose branches are NOT Doubles must keep its own routing: AND
  // semantics means one non-float way out leaves the whole join unfloatish,
  // and a float arm that swallowed these would trade one silent wrong answer
  // for another.
  let sa = if jcond(1) {
    64<<32
  } else {
    1
  }
  assert(sa == 64<<32)
  assert(!(sa == 65<<32))
  let sb = if jcond(1) {
    "hi"
  } else {
    "there"
  }
  assert(sb == "hi")
  assert(!(sb == "there"))
  let sc = if jcond(1) {
    true
  } else {
    false
  }
  assert(sc == true)
  assert(!(sc == false))
  // NOT asserted here, deliberately: `__to_string` of a join. Measured on
  // this compiler, `let sa = if c { 64<<32 } else { 1 }` renders as the
  // EMPTY STRING on all three lanes, and a Bool join renders as `1` on gc,
  // because the Int and Bool classifiers have the same missing join arms this
  // test adds to the float one. Those are #2424's subject -- one classifier
  // enumerating binding forms -- and closing them means routing on the
  // checked type, not adding a fourth arm here. Pinning the wrong answer
  // would be worse than leaving the row out: this file's contract is that
  // every assertion in it holds on every lane.
}

/// #2424: the render channel. `__to_string` decides Int-vs-String from a
/// HEURISTIC ON THE BIT PATTERN, because no type reaches its lowering, and
/// both lanes rescued it by classifying the argument syntactically from a slot
/// log seeded at binding sites. Correctness was therefore exactly the set of
/// binding forms someone remembered to seed; everything else rendered the
/// EMPTY STRING with no diagnostic. Every row below did, on both lanes,
/// measured on `7f7fa8a57`.
///
/// They answer now because the checker hands codegen the type it already
/// computed: render / `eq` argument offsets whose checked type is `Int`, on
/// #2429's typed-lowering channel as tag 3.
fn irc_ret_big() -> Int {
  64<<32
}

test "#2424 a large Int survives the binding forms the slot log never seeded" {
  // A match binding: the type comes from the scrutinee's enum, which the slot
  // log never sees.
  let o = Some(64<<32)
  match o {
    Some(v) => assert(__to_string(v) == "274877906944"),
    None => assert(false)
  }
  // A for-in element: from the iterable.
  let xs: Array[Int] = [64<<32]
  for x in xs {
    assert(__to_string(x) == "274877906944")
  }
  // A closure capture: the binding is in the enclosing frame, and a lambda
  // compiles into its own.
  let big = 64<<32
  let f = () -> String {
    __to_string(big)
  }
  assert(f() == "274877906944")
  // A call result -- `Array::get` from the array's element type, a user
  // function from its declared return type.
  assert(__to_string(Array::get(xs, 0)) == "274877906944")
  assert(__to_string(irc_ret_big()) == "274877906944")
  // Through `eq`, the other spelling that reads the same classifier.
  assert(!eq(Array::get(xs, 0), 65<<32))
  assert(eq(Array::get(xs, 0), 64<<32))
  // BOTH operands call-shaped. The two lines above cannot reach this case:
  // the linear `eq` gate is a disjunction, so a literal `65<<32` operand
  // satisfies it on its own and the call-shaped one is never asked about.
  // With both sides calls, the syntactic classifier answers false for each,
  // the bound `eq` and its string fallback take over, and two DISTINCT large
  // Ints compared equal (measured: this assertion trapped on linear while gc,
  // whose classifier already read the checked offsets, answered correctly).
  let ys: Array[Int] = [65<<32]
  assert(!eq(Array::get(xs, 0), Array::get(ys, 0)))
  assert(eq(Array::get(xs, 0), irc_ret_big()))
  // The controls: the classifier must not start answering Int for everything.
  let s = "hi"
  assert(__to_string(s) == "hi")
  let b = 1 < 2
  assert(__to_string(b) == "true")
  let d = 1.5
  assert(__to_string(d) == "1.5")
  assert(__to_string(123) == "123")
  assert(__to_string(0) == "0")
}

/// #2424, the projection row -- the last one an offset table can reach at all
/// (the erased type variable goes through a witness, not an offset). It stayed
/// open for a reason worth stating: the key was wrong, not missing.
///
/// `parse_postfix` builds `EDot(expr, field, callee_offset(expr), field_off)`,
/// so the node offset of `t.0` is the RECEIVER's start -- the same offset the
/// name `t` already owns. Keyed on that, the checker sees two typed
/// occurrences (the tuple and the `Int`) and the producer refuses an offset
/// whose occurrences disagree; that refusal was correct, because a consumer
/// keyed on offset alone would then have rendered the TUPLE `t` through the
/// integer renderer.
///
/// The fix is the fourth field, which `EDot` has carried since #645: the
/// field-name token's own offset, unique to the projection, and already
/// carrying the projection's type in the occurrence table (it was added for
/// hover on a field name). Producer and both consumers now agree that this is
/// the key -- one function, `typed_lowering_arg_offset` in
/// @vibe/compiler/core, because a key the producer writes and a consumer does
/// not read is not a diagnostic, it is silence.
fn irc_ret_pair() -> (Int, Int) {
  (64<<32, 1)
}

struct IrcBox {
  big: Int;
  label: String;
  small: Int
}

test "#2424 a large Int survives a projection out of a tuple or a struct" {
  let t = (64<<32, 1)
  assert(__to_string(t.0) == "274877906944")
  // Second position, so an implementation that always read element 0 fails.
  let u = (1, 64<<32)
  assert(__to_string(u.1) == "274877906944")
  // A projection off a CALL: the receiver is an ECall, whose own offset is in
  // the table under a different key, and the projection still answers.
  assert(__to_string(irc_ret_pair().0) == "274877906944")
  // Nested: both `EDot` nodes share the receiver's node offset and differ only
  // in the field-name offset, which is exactly what the key has to separate.
  let n = ((64<<32, 1), 2)
  assert(__to_string(n.0.0) == "274877906944")
  // A declared struct field, the other projection spelling.
  let b = IrcBox::{ big: 64<<32, label: "hi", small: 7 }
  assert(__to_string(b.big) == "274877906944")
  // Through `eq`, with BOTH operands projections -- the gate is a disjunction,
  // so a case where only one side is a projection cannot reach this.
  let v = (65<<32, 1)
  assert(!eq(t.0, v.0))
  assert(eq(t.0, irc_ret_pair().0))
  // The controls: a projection must not be classified `Int` for being one.
  assert(__to_string(b.label) == "hi")
  assert(__to_string(t.1) == "1")
  assert(__to_string(b.small) == "7")
}

/// #2424, the Double half of the same row. The float classifier had no
/// projection arm either, for the same structural reason: `float_call_offsets`
/// is keyed by CALL offsets, so a projection had no key in it at all.
///
/// Measured before this change, one file per row, on the stage2 that closed the
/// Int half: `__to_string(b.ratio)` on `DblBox::{ ratio: 1.5 }` printed `256`
/// on the RC lane and TRAPPED on gc, while the identical Double reached through
/// a tuple element, a plain `let` or a call result printed `1.5`. It answers now
/// through tag 4 -- the render/`eq` argument offsets the checker typed `Double`,
/// keyed by the same `typed_lowering_arg_offset` the Int half uses.
struct DblBox {
  ratio: Double;
  label: String;
  count: Int
}

fn dbl_ret_box() -> DblBox {
  DblBox::{ ratio: 1.5, label: "hi", count: 7 }
}

test "#2424 a Double survives a projection out of a struct or a tuple" {
  let b = DblBox::{ ratio: 1.5, label: "hi", count: 7 }
  assert(__to_string(b.ratio) == "1.5")
  // Off a CALL result, so the receiver's own offset is a different key.
  assert(__to_string(dbl_ret_box().ratio) == "1.5")
  // The tuple spelling, which already answered and must keep answering.
  let t = (1.5, 2)
  assert(__to_string(t.0) == "1.5")
  // Through `eq`, with both operands projections.
  let c = DblBox::{ ratio: 2.5, label: "hi", count: 7 }
  assert(!eq(b.ratio, c.ratio))
  assert(eq(b.ratio, dbl_ret_box().ratio))
  // The controls: a projection must not be classified `Double` for being one.
  assert(__to_string(b.label) == "hi")
  assert(__to_string(b.count) == "7")
  assert(__to_string(t.1) == "2")
}
