// #2404 / #2405 / #2407: three places the wasm-gc lane answered differently
// from the linear lane on ORDINARY values. Every assertion here must hold on
// BOTH lanes, which is the point -- each of these compiled and ran on linear
// and either trapped, refused to compile, or answered wrongly on gc.
//
// Run on both lanes by tests/gates/early/run.sh. A gc-only or linear-only
// run would miss exactly the divergence this file exists to catch.

// #2404: a labeled parameter is parsed with the marker ON THE NAME (`x~`)
// while the body says `x`. The gc backend bound the raw name, so this fn
// reported "internal compiler error: `x` (gc ident) reached code generation
// unresolved ... please report the source" for a valid program.
//
// Subtraction, not addition, so a reordering bug cannot pass (CLAUDE.md).
fn labeled_sub(x~: Int, y~: Int) -> Int {
  x - y
}

// The same for an optional parameter, which carries `x?`.
fn optional_sub(x?: Int, y?: Int) -> Int {
  match x {
    Some(a) => match y {
      Some(b) => a - b,
      None => a
    },
    None => 0
  }
}

//# Misc

test "#2404 a labeled parameter binds the name the body uses" {
  assert(labeled_sub(x = 10, y = 3) == 7)
  assert(labeled_sub(y = 3, x = 10) == 7)
  assert(optional_sub(x = 10, y = 3) == 7)
  // A lambda is a SEPARATE binding site, and its free-variable scan is a
  // third. With only the first fixed, the body's `x` became a bogus capture
  // and the call returned 0 with no diagnostic.
  let f = (x~: Int, y~: Int) -> Int {
    x - y
  }
  assert(f(x = 10, y = 3) == 7)
  assert(f(x = 3, y = 10) == 0 - 7)
}

test "#2422 a let rec lambda binds its labeled parameter" {
  // The ELetRec branch rescans the body with `collect_free_vars` to find the
  // self-capture, and it passed the RAW parameter names (`n~`) as the bound
  // set. The body's `n` was therefore not bound, became a bogus capture, every
  // later capture shifted, and `self_cap_idx` named the wrong slot -- the
  // self-closure was stored outside its environment and the call trapped with
  // "uninitialized element" on gc while running fine on linear.
  let rec countdown = (n~: Int) -> Int {
    if n <= 0 {
      0
    } else {
      countdown(n = n - 1)
    }
  }
  assert(countdown(n = 5) == 0)
  // Subtraction, so a reordering bug cannot pass, and two labels so the
  // capture list has something to shift.
  let rec sub_until = (a~: Int, b~: Int) -> Int {
    if a <= b {
      a - b
    } else {
      sub_until(a = a - 1, b = b)
    }
  }
  assert(sub_until(a = 5, b = 3) == 0)
  // The unlabeled control, which worked before and must keep working.
  let rec plain = (n: Int) -> Int {
    if n <= 0 {
      0
    } else {
      plain(n - 1)
    }
  }
  assert(plain(5) == 0)
}

test "#2405 a large Int renders as a number, not as an empty string" {
  // `__to_string` resolves to a builtin that decides Int-vs-String by a
  // heuristic on the bit pattern. `64 << 32` reads as (ptr 64, len 0), so it
  // was returned unchanged and rendered as "" on the gc lane.
  assert(__to_string(274877906944) == "274877906944")
  assert(__to_string(64<<32) == "274877906944")
  assert(__to_string(1<<40) == "1099511627776")
  // A bare ident has no shape to classify, so it needs the slot log rather
  // than the expression test -- this case survived the first fix.
  let x = 274877906944
  assert(__to_string(x) == "274877906944")
  let y = 0 - 274877906944
  assert(__to_string(y) == "-274877906944")
  // Controls: the small values that always worked, and zero.
  assert(__to_string(123) == "123")
  assert(__to_string(0) == "0")
  assert(__to_string(0 - 7) == "-7")
}

test "#2405 the int slot log does not swallow the other types" {
  // Bool and Int share this lane's representation, so a boolish binding must
  // keep its own classification or `true` renders as "1".
  let b = 1 < 2
  assert(__to_string(b) == "true")
  let c = 3 < 2
  assert(__to_string(c) == "false")
  let s = "hi"
  assert(__to_string(s) == "hi")
  let d = 1.5
  assert(__to_string(d) == "1.5")
}

test "#2405 a slot reused by a sibling scope is not read stale" {
  // The two branches bind DIFFERENT `v`s to the same reused slot. Reading the
  // else branch through the then branch's log entry would render a string as
  // a number.
  let r = if 1 < 2 {
    let v = 274877906944
    __to_string(v)
  } else {
    let v = "str"
    __to_string(v)
  }
  assert(r == "274877906944")
  let r2 = if 1 > 2 {
    let v = 274877906944
    __to_string(v)
  } else {
    let v = "str"
    __to_string(v)
  }
  assert(r2 == "str")
}

// #2405 follow-up: the integer renderer is emitted ONCE per module as a shared
// body and called, instead of inlined at every statically-int call site (that
// cost int_wrap +23% of its wasm). The body is pushed between the 56
// unconditional builtin bodies and the two conditional region-arena ones, so a
// module holding BOTH has to resolve all three indices correctly -- and a
// mis-derived index is a call into someone else's code, which builds fine and
// only shows up here.
fn region_len(n: Int) -> Int {
  region r {
    let xs = MutList::empty(r)
    let mut i = 0
    while i < n {
      MutList::push(xs, i * 2)
      i = i + 1
    }
    MutList::length(xs)
  }
}

/// #2422: a large Int reaching `__to_string` / `eq` through an annotated
/// parameter rather than a literal. Both lanes classify an ident through a
/// slot log, and both logs seeded Float and Bool params but not Int ones.
fn via_param(n: Int) -> String {
  __to_string(n)
}

fn eq_params(a: Int, b: Int) -> Bool {
  eq(a, b)
}

fn via_string(s: String) -> String {
  __to_string(s)
}

fn via_bool(b: Bool) -> String {
  __to_string(b)
}

fn via_double(d: Double) -> String {
  __to_string(d)
}

test "#2422 a large Int survives every binding form" {
  // Each of these reached the runtime string-pointer heuristic before, on one
  // lane or both, and rendered garbage or the empty string. Measured on the
  // committed seed: every one of them, so none is new here.
  assert(via_param(274877906944) == "274877906944")
  assert(!eq_params(64<<32, 65<<32))
  assert(eq_params(64<<32, 64<<32))
  let mut m = 64<<32
  assert(__to_string(m) == "274877906944")
  m = m + 1
  assert(__to_string(m) == "274877906945")
  let x = 64<<32
  let y = x
  let z = y
  assert(__to_string(y) == "274877906944")
  assert(__to_string(z) == "274877906944")
  // A LAMBDA parameter is a separate seeding site from a top-level one, on
  // both lanes.
  let lam = (n: Int) -> String {
    __to_string(n)
  }
  assert(lam(274877906944) == "274877906944")
  // The other annotated types must keep their own classification: Bool and
  // Int share this lane's representation, so a Bool read as an Int prints 1.
  assert(via_string("hi") == "hi")
  assert(via_bool(true) == "true")
  assert(via_double(1.5) == "1.5")
  let lam_b = (b: Bool) -> String {
    __to_string(b)
  }
  assert(lam_b(true) == "true")
  let lam_d = (d: Double) -> String {
    __to_string(d)
  }
  assert(lam_d(1.5) == "1.5")
}

test "#2405 polymorphic arithmetic is not assumed to be Int" {
  // `+ - * /` are resolved from the OPERANDS by the checker (Int, then Double,
  // then String for `+`, then a user impl), so the operator alone says
  // nothing. The gc scalar predicate answered Int for all four when it was
  // first copied over; the Codex review on #2422 caught it.
  //
  // No String `+` reaches codegen today -- `desugar_trait_dicts` rewrites
  // every measured shape into `String::concat` -- so these are the reachable
  // half, plus the concat forms as the control that they stay right.
  assert(__to_string(1.5 + 2.5) == "4")
  assert(__to_string(2.5 * 2.0) == "5")
  assert(__to_string(1.5 - 0.5) == "1")
  assert(eq("a" + "b", "ab"))
  assert(!eq("a" + "b", "ba"))
  assert(("a" + "b") == "ab")
  assert(__to_string("a" + "b") == "ab")
  let sa = "x"
  let sb = "y"
  assert(eq(sa + sb, "xy"))
  assert(__to_string(sa + sb) == "xy")
  // Int arithmetic over int-bound locals still resolves, which is what keeps
  // the shared renderer reachable for the eight sites in bench/exec/int_wrap.
  let i = 64<<32
  let j = 1
  assert(__to_string(i + j) == "274877906945")
  assert(__to_string(i * 1) == "274877906944")
}

test "#2405 the shared renderer and the region arena bodies coexist" {
  assert(region_len(5) == 5)
  assert(__to_string(64<<32) == "274877906944")
  assert(__to_string(region_len(3) * 1) == "3")
  let big = 1<<40
  assert(__to_string(big) == "1099511627776")
  assert(region_len(7) == 7)
}

test "#2407 eq answers on two distinct large Ints" {
  // The gc `eq` arm sent every non-bit-identical pair to `String::equals`,
  // which reads its operands as `(ptr << 32) | len` fat pointers -- an
  // out-of-bounds load for an Int whose high word is a plausible address.
  assert(!eq(64<<32, 65<<32))
  assert(eq(64<<32, 64<<32))
  assert(!eq((0 - (64<<32)) - 1, (0 - (65<<32)) - 1))
  assert(!eq(0 - 274877906945, 0 - 279172874241))
  // UNARY negation, which is a different AST node from the binary subtraction
  // above and slipped through it (#2422 review). `bc_expr_is_intish` answered
  // `!`/`~` and nothing else for a unary operator, so `-x` fell to the string
  // fallback even though `bc_expr_is_floatish` had recursed for `-` all along.
  assert(!eq(-(64<<32), -(65<<32)))
  assert(eq(-(64<<32), -(64<<32)))
  // Through a chain, and with the operand itself an int-bound name.
  assert(!eq(-(-(64<<32)), -(-(65<<32))))
  let big = 64<<32
  assert(!eq(-big, -(65<<32)))
  // Unary `-` over small values, which worked before for the same accidental
  // reason the small positive ones did.
  assert(!eq(-5, -6))
  // Through BINDINGS, which is a separate path: the call-site classifier reads
  // a bare ident from the slot log, and the log is written by a predicate that
  // had the same unary gap. `eq` over two let-bound negated Ints reached the
  // string fallback (#2422 review).
  let na = -(64<<32)
  let nb = -(65<<32)
  assert(!eq(na, nb))
  assert(eq(na, na))
  assert(__to_string(na) == "-274877906944")
  // Small values, which always worked because the bogus address happened to
  // be in bounds.
  assert(!eq(1, 2))
  assert(eq(3, 3))
  // A genuinely string `eq` still compares content.
  assert(eq("ab", "ab"))
  assert(!eq("ab", "ac"))
  // `eq` and `==` must answer the same on every one of these.
  assert(eq(64<<32, 65<<32) == ((64<<32) == (65<<32)))
  assert(eq(3, 3) == (3 == 3))
}

/// #2426: `Double` equality reached no float comparison on the gc lane.
/// `emit_gc_eq_value` routes on `gc_expr_is_intish` and otherwise falls
/// through to the `eq` builtin, and neither consults `gc_expr_is_floatish` --
/// which the neighbouring `<` `>` `<=` `>=` lowering has consulted all along,
/// with a comment naming `-0.0` as one of the values a raw bit compare
/// misranks.
///
/// That left two silent wrong answers, and this pair of helpers covers the
/// second one, where the operand arrives through a parameter rather than as a
/// literal:
///
///   * The `eq` builtin's fallback reads each operand as a `(ptr << 32) | len`
///     fat pointer. `-0.0` has bit 63 set, so its implied pointer is far out
///     of bounds, the "both operands look like strings" guard answers no, and
///     the result is "not equal" -- while IEEE 754 says `+0.0 == -0.0` is
///     true. The linear lane agrees with IEEE; only gc disagreed.
///   * `gc_expr_is_intish` answers true for `+ - * /` from the OPERATOR alone,
///     so two float arithmetic operands took a raw `i64.eq` over their f64
///     bits instead. `1.5 + 2.5 == 4.0` was right only because equal Doubles
///     have equal bit patterns -- an accident, not a routing.
fn dbl_eq(a: Double, b: Double) -> Bool {
  a == b
}

fn dbl_ne(a: Double, b: Double) -> Bool {
  a != b
}

/// A division the compiler cannot fold, so `dz(0.0, 0.0)` really is a NaN
/// produced at run time.
fn dz(a: Double, b: Double) -> Double {
  a / b
}

test "#2426 Double equality follows IEEE 754, not the bit pattern" {
  // The pair whose bit patterns differ ONLY in the sign bit -- which is what a
  // raw i64 compare distinguishes and an f64 compare does not.
  assert(0.0 == -0.0)
  assert(-0.0 == 0.0)
  assert(!(0.0 != -0.0))
  // Through names, either side, and both sides at once: the operand shapes
  // that reach the classifier as a bare ident rather than a literal.
  let a = 0.0
  let b = -0.0
  assert(a == -0.0)
  assert(0.0 == b)
  assert(a == b)
  assert(!(a != b))
  // Through an annotated parameter, the binding form the slot log seeds
  // separately from a `let`.
  assert(dbl_eq(0.0, -0.0))
  assert(!dbl_ne(0.0, -0.0))
  // `-0.0` arising from ARITHMETIC rather than from the literal, which is how
  // it turns up in real code (an underflowing negative product), and the
  // branch on it that used to be taken wrongly.
  let z = 0.0 * -1.0
  assert(z == 0.0)
  if z == 0.0 {
    assert(true)
  } else {
    assert(false)
  }
  // Ordinary Double equality, which was already right and must stay right --
  // including the arithmetic operands that `gc_expr_is_intish` claimed.
  assert(1.5 == 1.5)
  assert(!(1.5 == 2.5))
  assert(-1.5 == -1.5)
  assert(!(-1.5 == 1.5))
  assert(1.5 + 2.5 == 4.0)
  assert(!(1.5 + 2.5 == 4.5))
  assert(2.5 * 2.0 == 5.0)
  assert(1.5 != 2.5)
  assert(dbl_eq(1.5, 1.5))
  assert(!dbl_eq(1.5, 2.5))
  // A `while` condition is a third call site into the same routing, next to
  // the plain expression and the `if` above.
  let mut n = 3.0
  let mut steps = 0
  while n != 0.0 {
    n = n - 1.0
    steps = steps + 1
  }
  assert(steps == 3)
  // NaN is the other value IEEE 754 separates from a bit compare, and in the
  // opposite direction: two NaNs have IDENTICAL bits and are still not equal.
  // Measured on main's gc stage2, both inversions were live -- `nan == nan`
  // answered true and `nan != nan` answered false -- while linear answered
  // both the IEEE way. `!=` gets this from the callers' `eqz` over the same
  // `f64.eq`, so it needs no arm of its own.
  let nan = dz(0.0, 0.0)
  assert(!(nan == nan))
  assert(nan != nan)
  assert(!(nan == 1.5))
  assert(nan != 1.5)
  assert(!dbl_eq(nan, nan))
  assert(dbl_ne(nan, nan))
  // The Int and String sides of the same routing are untouched: a float guard
  // that also swallowed these would trade one silent wrong answer for another.
  assert(0 == 0)
  assert(!(0 == 1))
  assert((64<<32) == (64<<32))
  assert(!((64<<32) == (65<<32)))
  assert("ab" == "ab")
  assert(!("ab" == "ac"))
  assert(true == true)
  assert(!(true == false))
}

/// #2426 follow-up (Codex review on #2430): the BUILTIN `eq` is the other
/// spelling of `==`, and it was routed on raw bits after `==` stopped being.
/// Two operands, one concept -- the repository's rule is that these may not
/// answer differently.
fn eq_dbl(a: Double, b: Double) -> Bool {
  eq(a, b)
}

test "#2426 the eq builtin answers on Doubles, not on their bits" {
  // The sharpest case, and it is NOT signed zero: on the gc lane `eq` fell
  // through to the content fall-back, which reads each operand as
  // `(ptr << 32) | len`. A Double's low 32 bits are its mantissa TAIL, which
  // is zero for every round value -- so `0.0` and `1.5` both decoded as
  // zero-length strings and `String::equals` called them EQUAL. Measured on
  // 978ccefc4, gc: `eq(0.0, 1.5)` answered true, for two ordinary distinct
  // Doubles, with no diagnostic.
  assert(!eq(0.0, 1.5))
  assert(!eq(2.0, 4.0))
  assert(!eq(1.0, 8.0))
  // Signed zero, where the linear lane's arm was RC-only: its own comment
  // gave the reason as "non-RC matches the existing `==` behavior", and `==`
  // had just stopped behaving that way.
  assert(eq(0.0, -0.0))
  assert(eq(-0.0, 0.0))
  // NaN, the opposite direction: identical bits, and still not equal.
  let nan2 = dz(0.0, 0.0)
  assert(!eq(nan2, nan2))
  assert(!eq(nan2, 1.5))
  // Ordinary equal Doubles, which must keep answering true.
  assert(eq(1.5, 1.5))
  let da = 1.5
  let db = 1.5
  assert(eq(da, db))
  let dz1 = 0.0
  let dz2 = -0.0
  assert(eq(dz1, dz2))
  assert(!eq(dz1, 1.5))
  // Through annotated parameters, the binding form each lane seeds
  // separately from a `let`.
  assert(eq_dbl(0.0, -0.0))
  assert(!eq_dbl(0.0, 1.5))
  assert(eq_dbl(1.5, 1.5))
  // The two spellings must agree, which is the property this test exists for.
  assert(eq(0.0, -0.0) == (0.0 == -0.0))
  assert(eq(0.0, 1.5) == (0.0 == 1.5))
  assert(eq(2.0, 4.0) == (2.0 == 4.0))
  assert(eq(1.5, 1.5) == (1.5 == 1.5))
  assert(eq(nan2, nan2) == (nan2 == nan2))
  assert(eq(da, db) == (da == db))
  // And the Int and String sides of `eq` keep their own routing: a float arm
  // that swallowed them would trade one silent wrong answer for another.
  assert(eq(3, 3) == (3 == 3))
  assert(eq(64<<32, 65<<32) == ((64<<32) == (65<<32)))
  assert(eq("ab", "ab"))
  assert(!eq("ab", "ac"))
  assert(eq(true, true))
  assert(!eq(true, false))
}
