let fail = () -> Int with { Error } {
  throw("original")
  0
}

let wrap = () -> Int with { Error } {
  let x = handle {
    fail()
  } {
    Error(msg) => throw(String::concat("wrapped: ", msg))
  }
  x
}

let result = handle {
  wrap()
} {
  Error(msg) => String::length(msg)
}
result

__DATA__
{"last": "17"}
