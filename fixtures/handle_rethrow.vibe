let fail = () -> Int with Error {
  throw("original")
  0
}

let wrap = () -> Int with Error {
  let x = handle {
    fail()
  } with Error {
    Throw(msg) => throw(String::concat("wrapped: ", msg))
  }
  x
}

let result = handle {
  wrap()
} with Error {
  Throw(msg) => String::length(msg)
}
result

__DATA__
{"last": "17"}
