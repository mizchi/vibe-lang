import ./typecheck/callback_row_producer_alias_dep_ok.vibe {
  type Pts, effect Box, producer as alias_producer
}
import ./typecheck/callback_row_producer_constructor_dep_ok.vibe {
  effect Kb, producer as bag_producer, struct Bag
}

test "a readable imported producer alias delivers its String" {
  let result = handle {
    alias_producer()
  } with { Box::Put(p) => resume(String::length(p)) }
  assert_eq(result, 3)
}

test "an imported constructor producer delivers its Bag" {
  let result = handle {
    bag_producer()
  } with { Kb::Put(p) => {
    let value: Bag[Int] = p; resume(value.v)
  } }
  assert_eq(result, 42)
}
