// #1536 (a) v8: a compound `while` condition. The let chain the linearization
// produces goes INSIDE the loop closure, so the condition is re-evaluated on
// every check -- three operations for two iterations. Hoisting it out of the
// loop instead would run the operation once and never terminate (or exit
// immediately), so the 23 is the pin that it stayed in.
effect Ask {
  Next() -> Int
}

let calls = [
  0
]

let _start = () -> Int {
  handle {
    let mut count = 0
    while perform Ask::Next() > 0 {
      count = count + 1
    }
    count * 10 + Array::get(calls, 0)
  } with Ask {
    Next() => {
      let c = Array::get(calls, 0) + 1
      Array::set(calls, 0, c)
      let k = resume
      k(3 - c)
    }
  }
}
_start()

__DATA__
{
  "last": "23"
}
