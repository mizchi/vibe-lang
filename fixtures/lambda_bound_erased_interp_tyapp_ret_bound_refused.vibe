//# #2745: the same container-returning lambda, through a NAME.
//
// Self-probed alongside Codex's round-17 finding, and it failed the same way:
// `{ let xs = pack(a); Array::get(xs, 0) }` printed a 3-digit pointer decimal.
//
// The two spellings reach the answer by different routes -- this one records
// `array_elem_key` at the binding and reads it back, the inline one asks the
// callee directly -- so they are pinned separately. Round 15's `__index` bug
// was exactly a pair like this where only one spelling had been taught.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let pack = [U](u: U) -> Array[U] {
      [u]
    }
    "\{ { let xs = pack(a)
    Array::get(xs, 0) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
