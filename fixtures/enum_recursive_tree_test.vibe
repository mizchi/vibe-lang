enum Tree {
  Leaf(Int);
  Node(Tree, Tree)
}

test "enum recursive tree" {
  let rec sum_tree = (t: Tree) -> Int {
    match t {
      Leaf(n) => n,
      Node(l, r) => sum_tree(l) + sum_tree(r)
    }
  }
  let tree = Node(Node(Leaf(1), Leaf(2)), Node(Leaf(3), Leaf(4)))
  inspect(sum_tree(tree), "10")
}
