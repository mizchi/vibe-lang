// ADR-0124 (#4082): two packages each declare `extern effect S3`. A program
// binds one host provider per effect name, so a program that imports both
// is refused, naming both packages and the edit (host-provided-effects.md
// §1). It used to build into one `vibe:effect:./S3` import, so the
// operations of both packages reached whichever provider was bound.
import ./modules/extern_same_name_pkg_a {
  S3, call_a
}

import ./modules/extern_same_name_pkg_b {
  call_b
}

fn main() -> Unit allows Console + S3 {
  println(call_a(k = "x"))
  println(call_b(k = "y"))
}
