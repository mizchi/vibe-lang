// #3017: a throw payload's exception kind comes from the checker's inferred
// type when its syntax does not name one -- a builtin call's result, an
// unannotated `let`, a field projection. Each is an `Int`, so the kinded
// `Exception[Int]` arm catches it.
struct P {
  code: Int
}

fn from_builtin() -> Int {
  handle {
    throw(String::length("abcd"))
  } with { Exception[Int]::Throw(n) => n * 100 }
}

fn from_let() -> Int {
  handle {
    let m = String::length("abcd")
    throw(m)
  } with { Exception[Int]::Throw(n) => n * 100 }
}

fn from_field() -> Int {
  handle {
    let p = P::{ code: 9 }
    throw(p.code)
  } with { Exception[Int]::Throw(n) => n * 100 }
}

test "throw payload kind from the checker's type" {
  inspect(from_builtin(), "400")
  inspect(from_let(), "400")
  inspect(from_field(), "900")
}
