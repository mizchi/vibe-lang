import @vibe/builtin {
  String
}

test "std alias string short api" {
  let a = "" |> String::is_empty
  let b = "hello world" |> String::contains("lo wo")
  let c = "foo bar foo" |> String::replace_all("foo", "x")
  inspect(if a && b && String::equals(c, "x bar x") {
    "ok"
  } else {
    "ng"
  }, "ok")
}
