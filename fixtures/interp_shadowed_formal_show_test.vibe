// #3434: a `let` that shadows a parameter typed by a `Show`-bound formal
// renders through the witness of the type the shadow actually has. The
// shadow's own type comes from the checker; the outer binding's entry is
// masked, so the head is read from the checker's row rather than from it.

trait Show {
  to_string(Self) -> String
}

struct Point {
  value: Int
}

struct Label {
  text: String
}

impl Show for Point {
  to_string(point: Point) -> String {
    "point=\{point.value}"
  }
}

impl Show for Label {
  to_string(label: Label) -> String {
    "label=\{label.text}"
  }
}

fn same_formal[T: Show](x: T, c: Bool) -> String {
  let x = if c {
    x
  } else {
    x
  }
  "\{x}"
}

fn other_formal[T: Show, U: Show](x: T, y: U) -> String {
  let x = y
  "\{x}"
}

test "a shadow that keeps the formal renders through its witness" {
  inspect(same_formal(Point::{ value: 4 }, true), content = "point=4")
  inspect(same_formal(Label::{ text: "a" }, false), content = "label=a")
}

test "a shadow of another formal renders through that formal's witness" {
  inspect(other_formal(Point::{ value: 4 }, Label::{ text: "b" }), content = "label=b")
}
