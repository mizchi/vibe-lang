//# Codex round 10 on #2456: an enum formal forwarded only to an UNOBSERVED
//# parameter of a generic struct -- `struct Phantom[X] { tag: Int }`,
//# `enum Wrap[T] { W(Phantom[T]); Empty }`. The struct's specialised
//# comparator reads only `tag`, so `Wrap::equals` is fully structural
//# whatever `T` is. The payload-safety check consults the struct's observed
//# formals: a sentinel in an unobserved argument position does not count.
//# Measured on the stage2 at e35b3b6: this program trapped.

struct Phantom[X] {
  tag: Int
} derive (Eq)

enum Wrap[T] {
  W(Phantom[T]);
  Empty
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W(Phantom::{ tag: v }))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let empties = []
  Array::push(empties, Empty)
  assert(left == right)
  assert(left != other)
  assert(left != empties)
  0
}
