// Codex P1 on #1655: suspend-CPS loop control continuations must be fresh
// against user bindings and references in both the loop body and its tail.
// Site 1 would otherwise mint exactly these three spellings; in particular,
// the synthetic exit-value parameter could capture the tail's Int value.
effect Ask {
  Get(Int) -> Int
}

let _start = () -> Int {
  handle {
    let __scps_lp1 = 1
    let __scps_lpk1 = 2
    let __scps_lpv1 = 3
    let mut i = 0
    while i < 1 {
      let v = perform Ask::Get(i)
      i = i + v
      if i >= 1 { break } else { continue }
    }
    __scps_lp1 * 100 + __scps_lpk1 * 10 + __scps_lpv1
  } with Ask {
    Get(n) => {
      let k = resume
      k(n + 1)
    }
  }
}

test "loop control continuation names are fresh" {
  inspect(_start(), "123")
}
