// #1973: was fixtures/effect_generic_state.vibe + __DATA__.last "()".
// The generated assertion trapped because that last value was stale: this
// handler always resumes Get with 0 and does not thread Put, so count_up
// returns 0.

effect State[S] {
  Get -> S;
  Put(S) -> Unit
}

fn count_up() -> Int with State {
  let n = perform State::Get
  perform State::Put(n + 1)
  perform State::Get
}

test "generic State handle returns the resumed Get value" {
  let result = handle {
    count_up()
  } with {
    State::Get => resume(0);
    State::Put(_v) => resume(0)
  }
  inspect(result, "0")
}
