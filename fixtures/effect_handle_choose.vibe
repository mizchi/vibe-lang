// Non-determinism effect: choose from alternatives
effect Choose {
  Pick(Int) -> Int
}

let result = handle {
  let a = perform Choose::Pick(3)
  let b = perform Choose::Pick(5)
  a + b
} {
  Choose::Pick(n) => resume(n * 2)
}
// Pick(3) → 6, Pick(5) → 10, result = 16
result

__DATA__
{"error_contains": "Unit"}
