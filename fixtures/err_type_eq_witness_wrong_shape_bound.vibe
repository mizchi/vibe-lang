// #3350: an `Eq` whose `equals` is not `(Self, Self) -> Bool` supplies no
// witness for `==`, so `[T: Eq]` at a struct is refused like a marker `Eq`.
//
// `Eq` here is not a marker -- it declares a method -- so the #2612 guard,
// which tested marker-ness, stood down. The desugar does not dispatch to an
// `equals(Int, Int)` (fixtures/eq_bound_witness_shape_test.vibe), so `x == y`
// lowered to the builtin comparison: REFERENCE identity on a `Pt`. Measured
// on the #3327 stage2 (43ee1c792): this checked clean, and the same shape
// with an unrelated method (`tag(Self) -> Int`) answered `false` for two
// equal `Pt`.

trait Eq {
  equals(Int, Int) -> Bool
}

struct Pt {
  v: Int
}

impl Eq for Pt {
  equals(a: Int, b: Int) -> Bool {
    a == b
  }
}

fn same[T: Eq](x: T, y: T) -> Bool {
  x == y
}

fn main() -> Unit allows Console {
  println(__to_string(same(Pt::{ v: 1 }, Pt::{ v: 1 })))
}
