import @vibe/builtin {
  cmp_eq, num_add
}

trait Weird {
  add(Self, Self) -> Self;
  equals(Self, Self) -> Bool
}
impl Weird for Float32 {
  add(a: Float32, b: Float32) -> Float32 {
    99.0f
  }
  equals(a: Float32, b: Float32) -> Bool {
    false
  }
}
fn sum[T: Add + Weird](a: T, b: T) -> T {
  a + b
}
fn equal[T: Eq + Weird](a: T, b: T) -> Bool {
  a == b
}

test "an unrelated scalar method does not replace a builtin witness" {
  inspect(sum(a = 0.1f, b = 0.2f), content = "0.3")
  inspect(equal(a = 0.1f, b = 0.1f), content = "true")
  inspect(num_add(a = 0.1f, b = 0.2f), content = "0.3")
  inspect(num_add(a = 1.5, b = 2.25), content = "3.75")
  inspect(cmp_eq(a = 0.1f, b = 0.1f), content = "true")
  inspect(Float32::add(a = 0.1f, b = 0.2f), content = "99")
  inspect(Float32::equals(a = 0.1f, b = 0.1f), content = "false")
}
