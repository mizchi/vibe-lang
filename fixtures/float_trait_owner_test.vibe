import @vibe/builtin {
  cmp_eq, num_add
}

trait Weird {
  add(Self, Self) -> Self;
  equals(Self, Self) -> Bool
}
impl Weird for Float {
  add(a: Float, b: Float) -> Float {
    99.0f
  }
  equals(a: Float, b: Float) -> Bool {
    false
  }
}
fn sum[T: Add + Weird](a: T, b: T) -> T {
  a + b
}
fn equal[T: Eq + Weird](a: T, b: T) -> Bool {
  a == b
}

test "an unrelated scalar method does not replace a builtin witness" {
  inspect(sum(0.1f, 0.2f), content = "0.3")
  inspect(equal(0.1f, 0.1f), content = "true")
  inspect(num_add(0.1f, 0.2f), content = "0.3")
  inspect(num_add(1.5, 2.25), content = "3.75")
  inspect(cmp_eq(0.1f, 0.1f), content = "true")
  inspect(Float::add(0.1f, 0.2f), content = "99")
  inspect(Float::equals(0.1f, 0.1f), content = "false")
}
