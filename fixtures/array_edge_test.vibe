//# Misc

test "empty array" {
  let arr: Array[Int] = []
  assert(Array::length(arr) == 0)
}

test "single element array" {
  let arr = [42]
  assert(Array::length(arr) == 1)
  assert(arr[0] == 42)
}

test "array map empty" {
  let arr: Array[Int] = []
  let result = Array::map(arr, x -> x + 1)
  assert(Array::length(result) == 0)
}

test "array filter all" {
  let arr = [1, 2, 3]
  let result = Array::filter(arr, _ -> true)
  assert(Array::length(result) == 3)
}

test "array filter none" {
  let arr = [1, 2, 3]
  let result = Array::filter(arr, _ -> false)
  assert(Array::length(result) == 0)
}

test "array fold empty" {
  let arr: Array[Int] = []
  let result = Array::fold(arr, 100, _ + _)
  assert(result == 100)
}

test "array fold product" {
  let arr = [1, 2, 3, 4]
  let product = Array::fold(arr, 1, _ * _)
  assert(product == 24)
}

test "array nested" {
  let outer = [[1, 2], [3, 4], [5, 6]]
  assert(Array::length(outer) == 3)
  assert(outer[0][0] == 1)
  assert(outer[1][1] == 4)
  assert(outer[2][0] == 5)
}

test "array large" {
  let mut i = 0
  let b = ArrayBuilder::new()
  while i < 100 {
    ArrayBuilder::push(b, i)
    i += 1
  }
  let arr = ArrayBuilder::freeze(b)
  assert(Array::length(arr) == 100)
  assert(arr[0] == 0)
  assert(arr[99] == 99)
}

test "array slice" {
  let arr = [10, 20, 30, 40, 50]
  let s = arr[1: 4]
  assert(Array::length(s) == 3)
  assert(s[0] == 20)
  assert(s[1] == 30)
  assert(s[2] == 40)
}

test "array contains" {
  assert(Array::any([1, 2, 3], x -> x == 2))
  assert(not(Array::any([1, 2, 3], x -> x == 5)))
}

test "array map chain" {
  let result = Array::map(
    Array::map([1, 2, 3], x -> x * 2),
    x -> x + 1
  )
  assert(result[0] == 3)
  assert(result[1] == 5)
  assert(result[2] == 7)
}

test "for-in collect" {
  let arr = [1, 2, 3, 4, 5]
  let doubled = for x in arr { x * 2 }
  assert(doubled[0] == 2)
  assert(doubled[4] == 10)
  assert(Array::length(doubled) == 5)
}

test "array index boundary" {
  let arr = [10, 20, 30]
  assert(arr[0] == 10)
  assert(arr[2] == 30)
}

test "array spread" {
  let xs = [2, 3, 4]
  let arr = [1, ...xs, 5]
  assert(Array::length(arr) == 5)
  assert(arr[0] == 1)
  assert(arr[1] == 2)
  assert(arr[2] == 3)
  assert(arr[3] == 4)
  assert(arr[4] == 5)
}

test "array spread empty" {
  let xs: Array[Int] = []
  let arr = [1, ...xs, 2]
  assert(Array::length(arr) == 2)
  assert(arr[0] == 1)
  assert(arr[1] == 2)
}

test "array spread only" {
  let xs = [10, 20, 30]
  let arr = [...xs]
  assert(Array::length(arr) == 3)
  assert(arr[0] == 10)
  assert(arr[2] == 30)
}
