// #3082: a `derive (Show)` generic struct whose instantiation this site cannot
// recover renders only through its derived renderer, which erases the formal:
// before the fix the field below printed `Box { v: 1 }` for a `Box[Bool]`.
// Refused, naming the annotation that fixes it.
struct Box[T] {
  v: T
} derive (Show)

struct Outer {
  b: Box[Bool]
}

export let _start: () -> Int = () -> {
  let o = Outer::{ b: Box::{ v: true } }
  let s = "field=\{o.b}"
  String::length(s)
}
