// Handler ordering semantics — nested handle with Exception + effect
// Ported from koka/test/algeff/effs2.kk
// Counter outside Error: effect handled, then error caught
effect Counter {
  Inc -> Unit;
  Val -> Int;
}

let result = handle {
  handle {
    perform Counter::Inc
    perform Counter::Inc
    let c = perform Counter::Val
    if c > 1 {
      throw("too many")
    } else {
      c
    }
  } with {
    Exception::Throw(_msg) => -1
  }
} with {
  Counter::Inc => resume(0);
  Counter::Val => resume(5)
}
// Val returns 5, 5 > 1 → throw → catch → -1
result

__DATA__
{"last": "-1"}
