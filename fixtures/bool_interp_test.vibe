// #1527: a Bool reaching `"\{...}"` through a call or a typed name printed
// `1`/`0` -- Bool and Int share the tagged-int runtime representation, and the
// codegen boolish classifiers only knew literals, comparisons and builtins.
// The desugar now rewrites the rendering type-directed (fn_returns /
// var_types / struct field heads), once, for every backend.

//# Types

struct Flag { on: Bool }

//# Tests

test "Bool from a function call renders true/false" {
  assert("\{yes()}" == "true")
  assert("\{no()}" == "false")
}

test "Bool from a let-bound call renders true/false" {
  let f = yes()
  let g = no()
  assert("\{f}" == "true")
  assert("\{g}" == "false")
}

test "Bool struct field projection renders true/false" {
  let s = Flag::{ on: false }
  assert("\{s.on}" == "false")
  let t = Flag::{ on: true }
  assert("\{t.on}" == "true")
}

test "Bool literals and let-bound literals keep rendering" {
  let b = true
  assert("\{true}" == "true")
  assert("\{false}" == "false")
  assert("\{b}" == "true")
}

test "comparisons and mixed text keep rendering" {
  assert("\{1 == 1}" == "true")
  assert("a \{yes()} b" == "a true b")
}

//# Functions

fn yes() -> Bool {
  true
}

fn no() -> Bool {
  false
}
