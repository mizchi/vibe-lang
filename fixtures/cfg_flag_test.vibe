// #cfg fixture: `dev_only` exists ONLY when the `dev` flag is active
// (VIBE_CFG=dev). Compiled without the flag, the statement is parsed and
// dropped before checking, so it contributes zero bytes to the output.

#cfg(dev)
let dev_only = (x) -> x + 100

let base = (x) -> x + 1

#cfg(dev)
let main = () -> Int {
  dev_only(base(1))
}

#cfg(release)
let main = () -> Int {
  base(1)
}
