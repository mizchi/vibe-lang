// #1722 boundary monomorphization, second export spelling.
//
// `export let f = ...` sets a flag on the declaration; `let f = ...` followed by
// `export { f }` records the export in a separate statement and leaves that flag
// false. Both mean exported, and the reference lane has one predicate that knows
// it -- but the twin pass originally checked the flag directly, so this spelling
// silently got no twin and the component just fell back to tagged i64 with
// nothing to indicate why.
//
// The assertions are the identity ones: `bump2` mutates through the boundary
// twice and reading through the ORIGINAL binding has to show both.

let bump2: (Array[Int]) -> Array[Int] = (values) -> {
  Array::set(values, 0, Array::get(values, 0) + 1)
  values
}

export {
  bump2
}

test "the export-list spelling is monomorphized too" {
  let xs = [
    1,
    2
  ]
  let out = bump2(bump2(xs))
  inspect(Array::get(out, 0), "3")
  inspect(Array::get(xs, 0), "3")
  inspect(Array::get(out, 1), "2")
}
