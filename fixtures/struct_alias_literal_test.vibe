//# #3837: a struct literal through a type alias builds the aliased struct.
//# `type M = L`, `import ./dep { P as Q }` and an alias re-exported by
//# another module all register the name as an alias, and `Q::{ .. }` used to
//# answer "`Q` is not a struct" while `fn f(p: Q)` and `Q::get(p)` worked.
//# The literal writes its fields out of order on purpose: each must land in
//# its declared slot.

import ./_struct_alias_literal_dep.vibe {
  P, P as Q
}

import ./_struct_alias_literal_reexport_dep.vibe {
  R
}

struct L {
  a: Int;
  b: String
} derive (Eq, Show)

type M = L

struct Box[T] {
  v: T
} derive (Eq, Show)

type B[T] = Box[T]

test "an import alias of a struct builds the struct" {
  let q = Q::{ z: true, y: "why", x: 7 }
  inspect(q.x, content = "7")
  inspect(q.y, content = "why")
  inspect(q.z, content = "true")
  inspect(Q::get(q), content = "7")
  inspect(q == P::{ x: 7, y: "why", z: true }, content = "true")
}

test "a re-exported alias of a struct builds the struct" {
  let r = R::{ y: "re", x: 3, z: false }
  inspect(r.x, content = "3")
  inspect(r.y, content = "re")
  inspect(r == P::{ x: 3, y: "re", z: false }, content = "true")
}

test "a local alias builds the struct, a generic rename too" {
  let m = M::{ b: "bee", a: 3 }
  inspect(m.a, content = "3")
  inspect(m == L::{ a: 3, b: "bee" }, content = "true")
  let b: Box[Int] = B::{ v: 5 }
  inspect(b.v, content = "5")
}
