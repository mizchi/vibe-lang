// #1861 third batch. Same both-lanes contract as the other parity fixtures:
// the gate runs this on gc AND linear, because the property is that they
// agree, not that gc compiles.
//
// The lambda-body block is not decoration -- a dispatch arm is only half of
// serving a builtin by spelling on the gc lane; the same name must be in
// `gc_direct_abi_names()` or the capture scan collects it as a free variable
// and codegen dies (#1809, and again while #1861 landed).
test "Map::has" {
  let m = Map::from_pairs([
    ("a", 1),
    ("b", 2)
  ])
  assert_true(Map::has(m, "a"))
  assert_true(!Map::has(m, "zz"))
  assert_true(!Map::has(Map::new(), "a"))
}

test "Path::to_string and is_absolute" {
  assert_true(Path::to_string("/x/y") == "/x/y")
  assert_true(Path::is_absolute("/x"))
  assert_true(!Path::is_absolute("x/y"))
}

test "String::to_bytes" {
  // returns nominal ByteStream; the backend's materialized representation is
  // not exposed through Array builtins.
  let b = for x in String::to_bytes("hi") {
    x
  }
  assert_true(Array::length(b) == 2)
  assert_true(Array::get(b, 0) == 104)
  assert_true(Array::get(b, 1) == 105)
  let e = for x in String::to_bytes("") {
    x
  }
  assert_true(Array::length(e) == 0)
}

test "inside a lambda body" {
  let f = (m) -> {
    Map::has(m, "k")
  }
  assert_true(f(Map::from_pairs([
    ("k", 1)
  ])))
  let g = (s) -> {
    Array::length(for x in String::to_bytes(s) {
      x
    })
  }
  assert_true(g("abc") == 3)
  let h = (p) -> {
    Path::is_absolute(p)
  }
  assert_true(h("/z"))
}
