// #4065: an alias of the closure stored in an array, then read back.
// Data holds a handle-bound closure at its evidence arity, and a row-free
// parameter calls it at its plain arity, so handing it to one is refused at
// build time, as #1261 refuses the bare name (see
// err_effect_needing_value_for_binder.vibe).
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let a = g
    let xs = [a]
    apply(f = Array::get(xs, at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
