// ADR-0071 step 3 (docs/effectset.md, #755): a VALID `effectset` (no
// cycle, no operation-name collision) is now accepted and its members are
// expanded into any `with EffectsetName` row item that references it,
// before the existing string-label-based containment machinery
// (decl_authorizes_effect et al., unmodified) runs.
//
// `outer` declares `with AskAll` where `effectset AskAll = { Ask::Get }`
// -- its own row is expanded to `Ask::Get` (checker_stmt.vibe's
// es_expand_stmts_effect_rows) BEFORE the transitive call-graph check runs,
// so calling `read_one()` (which requires `Ask::Get`) is authorized. Without
// expansion this would be a compile error: the literal string "AskAll"
// does not equal "Ask::Get", and outer's declared row would need to spell
// out the operation directly.
//
// `main`'s own `with Ask + Ask::Get` is unrelated to effectset
// expansion -- it satisfies a separate, pre-existing checker requirement
// that a `handle ... with Effect` expression's enclosing declared row
// authorize the whole effect name in addition to whatever the handled body
// transitively requires.
effect Ask {
  Get -> Int
}

effectset AskAll = { Ask::Get }

let read_one = () -> Int with Ask::Get {
  perform Ask::Get
}

let outer = () -> Int with AskAll {
  read_one()
}

export let main = () -> Int with Ask + Ask::Get {
  handle {
    outer()
  } with Ask {
    Get => resume(42)
  }
}

__DATA__
{"last": "42"}
