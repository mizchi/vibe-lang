// Dependency of exception_kind_cross_module_ctor_test.vibe: an exported
// constructor whose callback row names its kind through the private alias
// `E`, and an exported alias whose function row does the same.
export enum IoErr {
  NotFound(String)
}

type E = IoErr

export enum Job {
  Run(() -> Int with Exception[E])
}

export type Callback = () -> Int with Exception[E]

export fn run_job(j: Job) -> Int {
  match j {
    Run(f) => handle { f() } with {
      Exception[E]::Throw(e) => match e {
        NotFound(s) => String::length(s)
      }
    }
  }
}

export fn run_callback(f: Callback) -> Int {
  handle { f() } with {
    Exception[E]::Throw(e) => match e {
      NotFound(s) => String::length(s) + 100
    }
  }
}
