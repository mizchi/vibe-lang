// CPS-based handler: accumulate via continuation
// handler receives (value, k) where k is the rest of the computation
effect Yield {
  Yield(Int) -> Unit
}

let result = handle {
  perform Yield::Yield(1)
  perform Yield::Yield(2)
  perform Yield::Yield(3)
  0
} with Yield {
  Yield(v, k) => v + k(0)
}
// CPS: 1 + (2 + (3 + 0)) = 6
result

__DATA__
{"last": "6"}
