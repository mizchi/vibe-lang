// #1967: was fixtures/generic_filter.vibe + __DATA__.last "false".

fn any[A](pred: (A) -> Bool, xs: Array[A]) -> Bool {
  if pred(xs[0]) {
    true
  } else if pred(xs[1]) {
    true
  } else if pred(xs[2]) {
    true
  } else {
    false
  }
}

fn is_even(x: Int) -> Bool {
  x % 2 == 0
}

test "generic any over an all-odd array is false" {
  inspect(any(is_even, [
    1,
    3,
    5
  ]), "false")
}
