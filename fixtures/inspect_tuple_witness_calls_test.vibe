// #3614: a tuple literal of witness-threaded generic calls handed straight to
// `inspect` failed wasm validation; the rendering rewrite copied the subject
// without threading the dictionaries its calls take.

fn f[T: Eq](a: T, b: T) -> Bool {
  a == b
}

struct Pt {
  x: Int
  y: Int
} derive (Eq, Show)

test "tuple literal of witness calls" {
  inspect((f(1, 1), f(1, 2)), "(true, false)")
}

test "nested tuple and array" {
  inspect(((f(true, true), 1), [f(2, 3), f(4, 4)]), "((true, 1), [false, true])")
}

test "witness call over a derived struct" {
  let p = Pt::{ x: 1, y: 2 }
  inspect((f(p, Pt::{ x: 1, y: 2 }), f(p, Pt::{ x: 2, y: 2 })), "(true, false)")
}

test "interpolated tuple" {
  inspect("\{(f(1, 1), f(1, 2))}", "(true, false)")
}

test "bound tuple control" {
  let t = (f(1, 1), f(1, 2))
  inspect(t, "(true, false)")
}
