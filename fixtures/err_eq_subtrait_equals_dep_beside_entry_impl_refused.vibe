// #3587: the dependency's `impl [T] Key for Box[T]` writes `equals` (under
// `trait Key: Eq`) and this entry adds `impl [T] Eq for Box[T]`. Each module
// checks clean on its own -- the dependency never sees the entry's impl, and
// the entry is told only of `Key` impls -- yet `[U: Eq]` and `[T: Key]` ran
// different `equals` on the same value: this answered `eq=true key=false`.
// Refused at link time, naming both impls.

import ./modules/eq_subtrait_dep_key_equals.vibe {
  trait Key, struct Box, via_key
}

impl [T] Eq for Box[T] {
  equals(self, o: Box[T]) -> Bool {
    true
  }
}

fn via_eq[U: Eq](a: U, b: U) -> Bool {
  U::equals(a, b)
}

test "one equals for Box through every bound" {
  let p: Box[Int] = Box::{ v: 1 }
  inspect("eq=\{via_eq(p, p)} key=\{via_key(p, p)}", content = "eq=true key=true")
}
