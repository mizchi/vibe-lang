// #3551 review: an impl of an imported trait whose method signature names a
// dependency type. Spelled through an import of that type, the impl is held
// to it and answers; a type the dependency does not export is met by leaving
// the parameter unannotated, which keeps the method generic over it. The
// refused forms are the `fixtures/typecheck/impl_trait_dep_type_*_reject.vibe`
// rows.
import ./_impl_trait_dep_type_dep.vibe {
  call_it, call_sealed, struct Hidden, trait Sealed, trait Tr
}

struct P {
  k: String
}

impl Tr for P {
  make(x: Hidden) -> P {
    P::{ k: x.s }
  }
  show(self) -> String {
    "k=\{self.k}"
  }
}

struct Q {
  n: Int
}

impl Sealed for Q {
  seal(x) -> Q {
    Q::{ n: 7 }
  }
  open_it(self) -> String {
    "n=\{self.n}"
  }
}

test "an impl spelling the imported type receives the caller's value" {
  inspect(call_it(P::{ k: "" }), "k=hello")
}

test "an impl generic over an unexported type answers" {
  inspect(call_sealed(Q::{ n: 0 }), "n=7")
}
