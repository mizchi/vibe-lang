//# #2745: `xs[0]`, which parses to `__index`.
//
// Codex, P1 round 15 on #2761. Measured on `1164350`: `{ let xs = [[a]];
// let ys = xs[0]; ys[0] }` printed a 3-digit pointer decimal, while the
// `Array::get` spelling of the same program was refused.
//
// Round 13 added the element-slot copy under the name `Array::get` only. The
// rest of this file spells the pair `(cn == "Array::get" || cn == "__index")`
// -- `infer_arg_type_name` does, and so do three other sites -- so the new arm
// was the one place that knew half of one operation. Surface syntax and the
// builtin are the same projection, and naming only one of them is how a route
// stays open behind a fix that looks complete.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let xs = [[a]]
    let ys = xs[0]
    ys[0] } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
