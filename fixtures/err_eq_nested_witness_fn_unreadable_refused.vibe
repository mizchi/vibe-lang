// A formal read only from a function argument's result (#3302): an
// unannotated lambda does not say what `T` is, so the call is refused with
// the edit rather than given a guessed witness.
fn via_fn[T: Eq](make: () -> T) -> Bool {
  make() == make()
}

export let _start: () -> Int = () -> {
  if via_fn(() -> 1.5) {
    1
  } else {
    0
  }
}
