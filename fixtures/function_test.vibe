//# Functions

fn fib(n: Int) -> Int {
  if n <= 1 {
    n
  } else fib(n - 1) + fib(n - 2)
}

fn double(x: Int) -> Int {
  x * 2
}

fn add_pair(a: Int, b: Int) -> Int {
  a + b
}

fn identity[T](x: T) -> T {
  x
}

fn factorial(n: Int) -> Int {
  if n < 2 {
    1
  } else n * factorial(n - 1)
}

fn make_adder(n: Int) -> (Int) -> Int {
  (x) -> { x + n }
}

//# Misc

test "simple function" {
  assert(double(21) == 42)
  assert(add_pair(3, 4) == 7)
}

test "recursive factorial" {
  assert(factorial(0) == 1)
  assert(factorial(1) == 1)
  assert(factorial(5) == 120)
  assert(factorial(10) == 3628800)
}

test "recursive fibonacci" {
  assert(fib(0) == 0)
  assert(fib(1) == 1)
  assert(fib(5) == 5)
  assert(fib(10) == 55)
}

test "generic identity" {
  assert(identity(42) == 42)
  assert(identity("hello") == "hello")
  assert(identity(true) == true)
}

test "closure" {
  let add5 = make_adder(5)
  let add10 = make_adder(10)
  assert(add5(3) == 8)
  assert(add10(3) == 13)
}

test "lambda expression" {
  let f: (Int) -> Int = (x) -> { x + 1 }
  assert(f(41) == 42)
}

test "short lambda" {
  let doubled = Array::r#map([
    1,
    2,
    3
  ], x -> x * 2)
  assert(doubled[0] == 2)
  assert(doubled[1] == 4)
  assert(doubled[2] == 6)
}

test "higher order function" {
  let apply: ((Int) -> Int, Int) -> Int = (f, x) -> { f(x) }
  assert(apply(double, 5) == 10)
}

test "immediately invoked lambda" {
  let result = ((x) -> { x * x })(7)
  assert(result == 49)
}
