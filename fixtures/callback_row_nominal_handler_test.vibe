// #3372: compatible handlers consume the producer's real nominal payload.
import ./typecheck/callback_row_handler_nominal_dep_ok.vibe {
  Wrap, effect Box, enum_producer, generic_producer, producer, use_pt, use_shade
}

test "an imported struct payload is consumed without a type import" {
  let r = handle {
    producer()
  } with { Box::Put(n) => resume(use_pt(n)) }
  inspect(r, "42")
}

test "an imported enum payload is consumed without a type import" {
  let r = handle {
    enum_producer()
  } with { Box::Put(n) => resume(use_shade(n)) }
  inspect(r, "42")
}

test "a generic producer's handler reads the concrete nested String payload" {
  let r = handle {
    generic_producer("abc")
  } with { Box::Put(n) => {
    let q: Wrap[String] = n; resume(String::length(q.v))
  } }
  inspect(r, "3")
}
