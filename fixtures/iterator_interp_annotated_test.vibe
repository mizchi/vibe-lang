import @vibe/builtin {
  trait Iterator
}

test "annotated map result interpolates by content" {
  let mapped: Array[Int] = Iterator::map([1, 2, 3], (x: Int) -> Int {
    x * 2
  })
  inspect("mapped = \{mapped}", content = "mapped = [2, 4, 6]")
}

test "annotated filter result interpolates by content" {
  let filtered: Array[Int] = Iterator::filter([1, 2, 3], (x: Int) -> Bool {
    x > 1
  })
  inspect("filtered = \{filtered}", content = "filtered = [2, 3]")
}
