//# #2745: a TOP-LEVEL generic returning an array of its own formal.
//
// Codex, P1 round 25 on #2761. Measured on `d69127c`:
// `fn pack[U](u: U) -> Array[U]` then `Array::get(pack(a), 0)` printed a
// 3-digit pointer decimal -- while the LOCAL spelling, which round 17 closed,
// was refused.
//
// `fn_returns` stores only a return's HEAD, which is enough for a bare `-> U`
// (the head IS the formal, re-spelled by #2141) and says nothing for an
// aggregate. So this is the sixth time in this PR that one of a pair was closed
// and the other left open: `xs[0]` vs `Array::get` (15), a call inline vs named
// (17), a constructor inline vs named (21), an aggregate argument written vs
// named (23), `if` vs `match` (24), and now local vs top-level.
//
// The fix records the SAME marker a local lambda records, under a reserved
// `fn_returns` key, so `dtd_interp_lamret_slot_of` asks one question of both
// tables and the readers need no arm of their own.

struct Qt {
  w: Int
}

fn pack[U](u: U) -> Array[U] {
  [u]
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{Array::get(pack(a), 0)}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
