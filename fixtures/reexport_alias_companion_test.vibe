//# #3837: a type a facade re-exports under another name (`import { P as R }`
//# then `export { R }`) reaches its companions through that name. `R::get(r)`
//# used to check clean and then stop linear code generation ("`R::get`
//# reached code generation unresolved"; gc refused `r: R` as an unknown type),
//# and an enum's `Hue::code` was an unknown name although the facade
//# published it. A same-shaped `Other` comes first in the dependency, so a
//# value that lost its struct's name would print and dispatch as `Other`.

import ./_reexport_alias_companion_facade.vibe {
  R, Hue, Other, Tagged, make
}

import ./_reexport_alias_companion_facade2.vibe {
  S
}

fn read(r: R) -> String {
  R::get(r)
}

fn read_again(s: S) -> String {
  S::get(s)
}

test "a re-exported struct alias reaches its companions" {
  let o: Other = Other::{ x: 0 }
  let r = make(3)
  inspect(read(r), content = "P 3")
  inspect("\{r}", content = "P { x: 3 }")
  inspect(Other::get(o), content = "Other")
}

test "through a second facade that renames it again" {
  inspect(read_again(make(4)), content = "P 4")
}

test "a re-exported enum alias reaches its companions" {
  inspect(Hue::code(Hue::Green), content = "2")
  inspect(Hue::code(Hue::Red), content = "1")
}

test "a re-exported declared alias keeps its own companions" {
  inspect(Tagged::tag(), content = "Tagged")
}
