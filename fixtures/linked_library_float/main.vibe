// #3625: the entry of the linked debug build; see lib.vibe. Each check is
// one bit, so the answer names what failed: 65535 when every one holds, on
// `vibe build --debug` and on the default build alike.
//
// The entry compiles alone, so its own check sees `third`, `big`, `one`,
// `dthird` and `dsum` as unknown; their types come from the import-resolving
// check `build --debug` runs first. Without them `big() + one()` was added as
// Int bits and an imported Double rendered as an integer.
//
// The same answers, as snapshot tests on the default build:
// linked_float_test.vibe.

import ./lib.vibe {
  big, bump, dsum, dthird, one, third, trait_added, trait_equal, trait_rounded, trait_shown
}

fn bit(c: Bool, w: Int) -> Int {
  if c {
    w
  } else {
    0
  }
}

export let _start = () -> Int {
  let a = 1.0f / 3.0f
  let mut s = 16777216.0f
  s += 1.0f
  let t = third()
  // #3456: an untyped shadow that changes the type renders by its own type.
  let b = 7
  let b = if b > 3 {
    "seven"
  } else {
    "small"
  }
  bit(c = "\{a}" == "0.33333334", w = 1) + bit(c = 16777217.0f == 16777216.0f, w = 2) + bit(c = 16777216.0f + 1.0f == 16777216.0f, w = 4) + bit(c = s == 16777216.0f, w = 8) + bit(c = "\{third()}" == "0.33333334", w = 16) + bit(c = bump(16777216.0f) == 16777216.0f, w = 32) + bit(c = big() + one() == big(), w = 64) + bit(c = t == a, w = 128) + bit(c = "\{dthird()}" == "0.3333333333333333", w = 256) + bit(c = "\{t}" == "0.33333334", w = 512) + bit(c = "\{b}" == "seven", w = 1024) + bit(c = dsum() + 1.0 == 3.5, w = 2048) + bit(c = trait_added() == 0.3f, w = 4096) + bit(c = trait_rounded() == 0.0f, w = 8192) + bit(c = trait_equal(), w = 16384) + bit(c = trait_shown(), w = 32768)
}
