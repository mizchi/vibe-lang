// #3625: the entry of the linked debug build; see lib.vibe. Each check is
// one bit, so the answer names what failed: 4095 when every one holds, on
// `vibe build --debug` and on the default build alike.
//
// The entry compiles alone, so its own check sees `third`, `big`, `one`,
// `dthird` and `dsum` as unknown; their types come from the import-resolving
// check `build --debug` runs first. Without them `big() + one()` was added as
// Int bits and an imported Double rendered as an integer.

import ./lib.vibe { third, bump, big, one, dthird, dsum }

fn bit(c: Bool, w: Int) -> Int {
  if c {
    w
  } else {
    0
  }
}

export let _start = () -> Int {
  let a = 1.0f / 3.0f
  let mut s = 16777216.0f
  s += 1.0f
  let t = third()
  // #3456: an untyped shadow that changes the type renders by its own type.
  let b = 7
  let b = if b > 3 {
    "seven"
  } else {
    "small"
  }
  bit("\{a}" == "0.33333334", 1) + bit(16777217.0f == 16777216.0f, 2) + bit(16777216.0f + 1.0f == 16777216.0f, 4) + bit(s == 16777216.0f, 8) + bit("\{third()}" == "0.33333334", 16) + bit(bump(16777216.0f) == 16777216.0f, 32) + bit(big() + one() == big(), 64) + bit(t == a, 128) + bit("\{dthird()}" == "0.3333333333333333", 256) + bit("\{t}" == "0.33333334", 512) + bit("\{b}" == "seven", 1024) + bit(dsum() + 1.0 == 3.5, 2048)
}
