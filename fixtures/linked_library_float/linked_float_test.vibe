// #3625: the answers `main.vibe` encodes as a bitmask for the
// `build --debug` gate (tests/gates/early/extended_derive.sh), as snapshot
// tests the unit runner discovers. `vibe test` runs the default build; the
// gate keeps exercising the linked debug lane, which has no test-block runner.

import ./lib.vibe { third, bump, big, one, dthird, dsum }

test "Float arithmetic rounds to f32 through an imported library" {
  let a = 1.0f / 3.0f
  inspect(a, content = "0.33333334")
  inspect(16777217.0f == 16777216.0f, content = "true")
  inspect(16777216.0f + 1.0f == 16777216.0f, content = "true")
  let mut s = 16777216.0f
  s += 1.0f
  inspect(s == 16777216.0f, content = "true")
  inspect(third(), content = "0.33333334")
  inspect(bump(16777216.0f) == 16777216.0f, content = "true")
  inspect(big() + one() == big(), content = "true")
  inspect(third() == a, content = "true")
}

test "an imported Double renders and adds as a Double" {
  inspect(dthird(), content = "0.3333333333333333")
  inspect(dsum() + 1.0 == 3.5, content = "true")
}

test "an untyped shadow that changes the type renders by its own type" {
  let b = 7
  let b = if b > 3 {
    "seven"
  } else {
    "small"
  }
  inspect(b, content = "seven")
}
