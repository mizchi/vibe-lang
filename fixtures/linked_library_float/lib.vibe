// #3625: a library module `vibe build --debug` compiles on its own
// (`compile_file_wasi_library`). Its `Float` arithmetic -- a binop and a
// compound assignment -- must be rounded to f32 there, as on the default
// build; the lane used to parse without offsets and refuse the program.

export fn third() -> Float {
  1.0f / 3.0f
}

export fn bump(x: Float) -> Float {
  let mut s = x
  s += 1.0f
  s
}

export fn big() -> Float {
  16777216.0f
}

export fn one() -> Float {
  1.0f
}

export fn dthird() -> Double {
  1.0 / 3.0
}

export fn dsum() -> Double {
  2.5
}

// #3625: method witnesses also survive the per-library compilation.
export fn trait_sum[T: Add](a: T, b: T) -> T {
  a + b
}
fn trait_same[T: Eq](a: T, b: T) -> Bool {
  a == b
}
fn trait_keep[T: Show](a: T) -> T {
  a
}

export fn trait_rounded() -> Float {
  trait_sum(trait_sum(16777216.0f, 1.0f), -16777216.0f)
}
export fn trait_equal() -> Bool {
  trait_same(0.1f, 0.1f)
}
export fn trait_shown() -> Bool {
  "\{trait_keep(0.1f)}" == "0.1"
}

export fn trait_added() -> Float {
  trait_sum(0.1f, 0.2f)
}
