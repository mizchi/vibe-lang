// #3625: a library module `vibe build --debug` compiles on its own
// (`compile_file_wasi_library`). Its `Float` arithmetic -- a binop and a
// compound assignment -- must be rounded to f32 there, as on the default
// build; the lane used to parse without offsets and refuse the program.

export fn third() -> Float {
  1.0f / 3.0f
}

export fn bump(x: Float) -> Float {
  let mut s = x
  s += 1.0f
  s
}

export fn big() -> Float {
  16777216.0f
}

export fn one() -> Float {
  1.0f
}

export fn dthird() -> Double {
  1.0 / 3.0
}

export fn dsum() -> Double {
  2.5
}
