// Effect inference: multiple effects inferred
effect Log { Info(String) -> Unit }
effect Db { Query(String) -> String }

// Both Log and Db inferred from inline performs
let result = handle {
  handle {
    perform Log::Info("start")
    let data = perform Db::Query("SELECT 1")
    String::length(data)
  } { Db::Query(_sql) => resume("result") }
} { Log::Info(_msg) => resume(0) }
result

