struct Slot {
  mut callback: () -> Array[Int]
}

fn build() -> Slot {
  let outer = Slot::{
    callback: () -> Array[Int] {
      []
    }
  }
  let _ = region r {
    let values = MutList::empty(r)
    outer.callback = () -> Array[Int] {
      MutList::to_array(values)
    }
    0
  }
  outer
}

test "outer fields cannot retain region-backed closures" {
  let _ = build()
}
