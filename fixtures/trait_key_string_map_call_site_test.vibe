//# Codex on #3956: impls of one trait at `StringMap[Int]` and at `Int`, chosen
//# by the argument's type. The impl's key is canonical (`Map[String, Int]`), so
//# the request the call's annotated argument spells is put in the same
//# spelling before the candidates are narrowed; before, the checker accepted
//# the call and witness generation reported it ambiguous.

trait It[A] {
  pass(Self, A) -> Int
}

struct P {
  n: Int
}

impl It[StringMap[Int]] for P {
  pass(self, m) -> Int {
    self.n + 10
  }
}

impl It[Int] for P {
  pass(self, x) -> Int {
    self.n + x
  }
}

test "dispatch by argument" {
  let p = P::{ n: 1 }
  let m: StringMap[Int] = Map::new()
  inspect(It::pass(p, m), content = "11")
  inspect(It::pass(p, 5), content = "6")
}

type Counts = StringMap[Int]

test "dispatch by an argument annotated through an alias" {
  let p = P::{ n: 2 }
  let m: Counts = Map::new()
  inspect(It::pass(p, m), content = "12")
}
