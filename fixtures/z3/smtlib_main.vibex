// @vibex/z3 over the real z3.wasm (scripts/fetch_z3_wasm.sh): solve
// x > 3 /\ x < 5 through SMT-LIB2. Built and inspected by
// scripts/test_z3_binding_gate.sh.
import @vibex/z3 {
  Context, full_version
}

fn main() -> Unit allows Console + Exception {
  println(full_version())
  let ctx = Context::new()
  print(Context::eval_smtlib2(ctx, "(declare-const x Int)(assert (> x 3))(assert (< x 5))(check-sat)(get-model)"))
  Context::close(ctx)
}
