import @vibe/builtin {
  Array::iter, AsyncIter::collect, AsyncIter::filter, AsyncIter::take, trait Mappable
}

test "Array enters the canonical pull pipeline without a sync Iter twin" {
  let values = [1, 2, 3, 4, 5, 6]
  |> Array::iter
  |> AsyncIter::filter((x: Int) -> Bool {
    x % 2 == 0
  })
  |> Mappable::map((x: Int) -> Int {
    x * 10
  })
  |> AsyncIter::take(2)
  |> AsyncIter::collect
  assert_eq(values, [20, 40])
}
