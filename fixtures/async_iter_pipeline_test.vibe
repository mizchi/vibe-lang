import @vibe/builtin {
  Array::iter, AsyncIter::collect, AsyncIter::filter, AsyncIter::map, AsyncIter::take
}

test "Array enters the canonical pull pipeline without a sync Iter twin" {
  let values = [1, 2, 3, 4, 5, 6]
  |> Array::iter
  |> AsyncIter::filter(pred = (x: Int) -> Bool {
    x % 2 == 0
  })
  |> AsyncIter::map(f = (x: Int) -> Int {
    x * 10
  })
  |> AsyncIter::take(n = 2)
  |> AsyncIter::collect
  assert_eq(values, [20, 40])
}
