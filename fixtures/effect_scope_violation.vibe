// Scope violation: with { A } does NOT grant access to B
effect A { OpA -> Int }
effect B { OpB -> Int }

// This function declares with { A } but tries to use B → should work
// because handle provides B
let result = handle {
  let a = handle {
    perform A::OpA
  } { A::OpA => resume(10) }
  let b = handle {
    perform B::OpB
  } { B::OpB => resume(20) }
  a + b
} {
  A::OpA => resume(0),
  B::OpB => resume(0)
}
result

__DATA__
{"last": "30"}
