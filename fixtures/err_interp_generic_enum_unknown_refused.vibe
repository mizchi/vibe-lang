// #3074: a `derive (Show)` generic enum whose type arguments this site cannot
// recover renders only through its derived renderer, which erases the formal:
// before the fix this printed `GA(1)` for `GA(true)`. Inside a generic
// function the argument is a formal, so nothing can recover it. Refused,
// naming the annotation that fixes it.
enum G[T] {
  GA(T);
  GB
} derive (Show)

fn show_it[T](g: G[T]) -> String {
  "\{g}"
}

export let _start: () -> Int = () -> {
  String::length(show_it(GA(true)))
}
