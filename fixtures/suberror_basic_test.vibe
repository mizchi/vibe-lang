// #1973: was fixtures/suberror_basic.vibe + __DATA__.last "10".
// `suberror` is still top-level syntax; the generated unit lane rejected
// the fixture because the debt generator wrapped the declaration as an
// expression inside the test block.

suberror AppError {
  NotFound(String);
  InvalidInput(String)
}

fn validate(n: Int) -> Int with Exception {
  if n < 0 {
    throw(InvalidInput("negative"))
  }
  n * 2
}

test "suberror validate doubles a non-negative input" {
  let result = handle {
    validate(5)
  } with Exception {
    Throw(_) => 0 - 1
  }
  inspect(result, "10")
}
