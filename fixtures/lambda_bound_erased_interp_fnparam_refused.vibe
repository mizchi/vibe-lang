//# #2745: a FUNCTION-VALUED parameter whose declared return is the formal.
//
// Codex, P1 round 20 on #2761. Measured on `c0e164c`:
// `[T](a: T, f: (T) -> T) { "\{f(a)}" }` printed a 3-digit pointer decimal.
//
// Leaf inference cannot infer a call through a parameter, and every route this
// pass had for "what does calling this name return" was built for a LOCAL
// LAMBDA -- recorded at its binding. A parameter has no binding to record at,
// but it does have a declared type, and that type says the answer outright.
//
// So this records a different marker from the local-lambda ones: not "returns
// argument k" but "returns a value of the type spelled R". There is no
// argument to map to and none is needed. The marker is resolved through the
// SAME guard the leaf applies -- a name is a name, and `Int` must not be read
// as a type parameter, which is how round 17's first cut made the compiler
// reject its own sources.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T, f: (T) -> T) -> String {
    "\{f(a)}"
  }
  inner(Qt::{ w: 5 }, (v: Qt) -> Qt {
    v
  })
}

export fn _start() -> Int {
  String::length(outer(7))
}
