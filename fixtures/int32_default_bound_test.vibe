// #3824 (ADR-0122): `[T: Default]` at `Int32` / `UInt32` is served by the
// shipped `Default`'s `Int` impl. Both erase to `Int`, and `Int::default()`
// is `0`, in range for both. Only the `@vibe/core` declaration is borrowed;
// a program's own `Default` is refused
// (fixtures/typecheck/err_type_int32_default_program_trait.vibe).
// Runs on linear and on wasm-gc:
//   VIBE_TEST_BACKEND=gc vibe test fixtures/int32_default_bound_test.vibe
import @vibe/core {
  Default
}

fn fresh[T: Default](_ witness: T) -> T {
  T::default()
}

test "Int32 and UInt32 default to 0" {
  let a: Int32 = -7
  let z: Int32 = fresh(a)
  inspect(z, content = "0")
  let b: UInt32 = 4294967295
  let w: UInt32 = fresh(b)
  inspect(w, content = "0")
}

test "the default is an ordinary Int32" {
  let a: Int32 = 2147483647
  let z: Int32 = fresh(a)
  let one: Int32 = 1
  inspect(z + one, content = "1")
  inspect(Int32::to_int(fresh(a)), content = "0")
}
