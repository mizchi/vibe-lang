// #3443: `Box` imported under an alias and, again, through a re-export of
// the same module. The two imports were taken for a name collision, whose
// fallback copies only value definitions, so the alias was dropped and
// `B::plain` reached code generation unresolved ("internal compiler error").
import ./import_alias_reexport_dep.vibe { Box as B }
import ./import_alias_reexport_facade.vibe { Box as C }

test "an aliased type's companion beside a re-exported import" {
  inspect(B::plain(3).n, "3")
  inspect(C::plain(4).n, "4")
}
