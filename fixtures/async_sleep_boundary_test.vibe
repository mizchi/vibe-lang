/// ADR-0089 Decision 1, increment 1 (#1218): an entry whose row carries
/// `Async` gets (a) a synthesized top-level `sleep` that IS
/// `perform Async::Suspend(-ms)` (shadowing the opaque nominal-row builtin
/// via the prefer-bound rule) and (b) an entry-boundary tail-resumptive
/// Async handler that settles the debt with the row-free `sleep_blocking`
/// host call. Observable behavior must match the old blocking builtin:
/// the program completes normally and returns its value.
///
/// The call goes through a wrapper fn (like lib/@vibe/time::sleep_ms) so
/// the boundary's evidence threading is exercised transitively, not just
/// on a direct perform in the handle body.
fn nap_twice(ms: Int) -> Unit with Async {
  sleep(ms)
  sleep(0)
  ()
}

fn main() -> Int with Async {
  nap_twice(10)
  42
}
