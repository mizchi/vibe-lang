// #3152: a closure bound by a local `let` and passed to `TaskGroup::spawn` by
// name is checked like the literal. Its captures are recorded where the `let`
// is written; before the fix a name was opaque to the check and this spawn
// ran with a plain outer `Array` captured.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    let work = () -> {
      Array::set(seen, at = 0, value = 1)
      0
    }
    TaskHandle::join(TaskGroup::spawn(n, f = work))
  })
  ()
}
