fn maybe_return(callback: () -> Array[Int]) -> () -> Array[Int] {
  if true {
    return () -> Array[Int] {
      callback()
    }
  }
  () -> Array[Int] {
    [
    ]
  }
}

test "explicit return paths preserve callback provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    maybe_return(() -> Array[Int] {
      MutList::to_array(values)
    })
  }
  let _ = escaped()
}
