// #3571: the entry writes its own `fn Int::shout` and imports a module that
// writes a private one. The dependency is merged first, so the entry's own
// call ran the dependency's definition. Refused, naming both definitions.

import ./modules/qualified_fn_overlap_a.vibe {
  a_name
}

fn Int::shout(x: Int) -> String {
  "from-entry"
}

test "the entry keeps its own qualified function" {
  inspect("\{a_name()} \{Int::shout(1)}", content = "from-a from-entry")
}
