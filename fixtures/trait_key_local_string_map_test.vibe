//# #3947 (Codex on #3956): a program's own `struct StringMap[T]` owns that
//# spelling (#2263), so `Tag[StringMap[Int]]` and the builtin
//# `Tag[Map[String, Int]]` are two impls. Canonicalizing trait keys once
//# resolved `StringMap[Int]` to the builtin `Map[String, Int]` in the
//# lowering, collapsed both impls to one key, and `builtin` answered `1`.

struct StringMap[T] {
  v: T
}

trait Tag[A] {
  tag(Self) -> Int
}

struct Note {
  n: Int
}

impl Tag[StringMap[Int]] for Note {
  tag(self) -> Int {
    1
  }
}

impl Tag[Map[String, Int]] for Note {
  tag(self) -> Int {
    2
  }
}

fn own[V: Tag[StringMap[Int]]](_ v: V) -> Int {
  V::tag(v)
}

fn builtin[V: Tag[Map[String, Int]]](_ v: V) -> Int {
  V::tag(v)
}

test "own StringMap" {
  inspect(own(Note::{ n: 0 }), content = "1")
  inspect(builtin(Note::{ n: 0 }), content = "2")
}
