let parse_int = (s: String) -> Int with Exception {
  if s == "42" { 42 }
  else if s == "0" { 0 }
  else { throw(String::concat("not a number: ", s)) }
}

let safe_parse = (s: String) -> Int {
  handle {
    parse_int(s)
  } with Exception {
    Throw(_) => -1
  }
}

let a = safe_parse("42")
let b = safe_parse("bad")
a + b

__DATA__
{"last": "41"}
