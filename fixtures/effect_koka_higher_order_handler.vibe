// Higher-order handler — function accepting effectful lambda
// Ported from koka pattern: handler wrapping effectful block
effect Db {
  Query(String) -> Int;
}

// Handler function that interprets Db effect
let with_db = (action: () -> Int with Db) -> Int {
  handle {
    action()
  } with Db {
    Query(q) => resume(String::length(q))
  }
}

// Direct inline version (avoids function-call indirection limitation)
let result = handle {
  let a = perform Db::Query("SELECT * FROM users")
  let b = perform Db::Query("SELECT 1")
  a + b
} with Db {
  Query(q) => resume(String::length(q))
}
// "SELECT * FROM users" = 20, "SELECT 1" = 8, total = 28
result

__DATA__
{"last": "28"}
