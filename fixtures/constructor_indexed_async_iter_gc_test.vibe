trait Mappable[F[_]] {
  map[A, B](F[A], (A) -> B) -> F[B]
}

struct AsyncIter[T] {
  values: Array[T]
}

fn AsyncIter::map[A, B](src: AsyncIter[A], f: (A) -> B) -> AsyncIter[B] {
  AsyncIter::{
    values: Array::map(src.values, f)
  }
}

impl Mappable[AsyncIter] for AsyncIter {
  map(xs: AsyncIter[A], f: (A) -> B) -> AsyncIter[B] {
    AsyncIter::map(xs, f)
  }
}

test "user-defined constructor maps through a constructor-indexed witness" {
  let values = AsyncIter::{
    values: [1, 2]
  } |> Mappable::map((x) -> {
    x + 1
  }) |> Mappable::map((x) -> {
    x * 2
  })
  inspect(Array::length(values.values), "2")
  inspect(Array::get(values.values, 0), "4")
  inspect(Array::get(values.values, 1), "6")
}
