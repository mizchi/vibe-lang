// #3327: a bound that extends a marker `Eq`, at a type with the subtrait's
// impl and NO `impl Eq` -- supertraits are not enforced on an impl, so this is
// a legal program up to the call. Measured on main at 5f4de5023 it checked
// clean and answered `false` for two equal `Pt`.
//
// The refusal must not claim an `impl Eq for Pt` was written. `Pt` satisfies
// `Eq` through `impl Key for Pt`, and the message says exactly that; the text
// this shape would have shared before said "an `impl Eq for Pt` IS declared
// by the prelude", which is false twice over.

trait Eq {}

trait Key: Eq {}

struct Pt {
  v: Int
}

impl Key for Pt {}

fn same[T: Key](x: T, y: T) -> Bool {
  x == y
}

fn main() -> Unit allows Console {
  println(__to_string(same(Pt::{ v: 1 }, Pt::{ v: 1 })))
}
