// #1967: was fixtures/jsonl.vibe + __DATA__.last "3".
// Json::parse_lines / Json::stringify_lines are not builtins and are not
// exported by @vibe/json. Parse each line with Json::parse, then
// stringify/parse again so the claimed count still holds after a round-trip.

import @vibe/json {
  Json
}

import ../lib/@vibe/builtin {
  Lines::parse
}

test "jsonl parse each line keeps count 3" {
  let text = "{\"a\":1}\n{\"b\":2}\n{\"c\":3}"
  let lines = Lines::parse(text)
  inspect(Array::length(lines), "3")
  let a = Json::parse(Array::get(lines, 0))
  let b = Json::parse(Array::get(lines, 1))
  let c = Json::parse(Array::get(lines, 2))
  inspect(Json::stringify(a), "{\"a\":1}")
  inspect(Json::stringify(b), "{\"b\":2}")
  inspect(Json::stringify(c), "{\"c\":3}")
  let a2 = Json::parse(Json::stringify(a))
  let b2 = Json::parse(Json::stringify(b))
  let c2 = Json::parse(Json::stringify(c))
  inspect(Json::stringify(a2), "{\"a\":1}")
  inspect(Json::stringify(b2), "{\"b\":2}")
  inspect(Json::stringify(c2), "{\"c\":3}")
}
