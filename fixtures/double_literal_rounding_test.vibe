// #3543 item 2: a float literal is the double nearest its decimal digits,
// ties to the even significand -- the same bits `Double::parse` answers for
// the same text (#2652). Each row prints the literal's bits and then
// `Double::parse`'s, as `hi:lo` (the upper and lower 32 bits); the expected
// bits are Python's `float()` (correctly rounded) for the text.
//
// Before the fix the lexer's own slow path (a 31-digit double-double) gave a
// different answer from `Double::parse` on five of these rows, silently:
//   - the 309-digit integer just below DBL_MAX + half an ulp lexed to
//     `Infinity` (2146435072:0) instead of DBL_MAX;
//   - just above half the smallest subnormal lexed to 0;
//   - just above 1 + half an ulp lexed to 1.0;
//   - the exact midpoints `1 + 3 * 2^-53` and `2^-1000 + 3 * 2^-1053` rounded
//     to the odd neighbour.
// The other rows (DBL_MAX written out, the smallest subnormal, the exact
// midpoints that tie to zero or to 1.0, ordinary literals, the fast path)
// keep the answer they had.

fn bits(d: Double) -> String {
  "\{Double::to_i64_bits_hi(d)}:\{Double::to_i64_bits_lo(d)}"
}

fn same(lit: Double, text: String) -> String {
  let parsed = match Double::parse(text) {
    Some(d) => bits(d),
    None => "None"
  }
  "\{bits(lit)} \{parsed}"
}

test "ordinary 0.1" {
  inspect(same(0.1, "0.1"), content = "1069128089:2576980378 1069128089:2576980378")
}

test "ordinary 1.5" {
  inspect(same(1.5, "1.5"), content = "1073217536:0 1073217536:0")
}

test "ordinary 3.141592653589793" {
  inspect(same(3.141592653589793, "3.141592653589793"), content = "1074340347:1413754136 1074340347:1413754136")
}

test "ordinary 0.30000000000000004" {
  inspect(same(0.30000000000000004, "0.30000000000000004"), content = "1070805811:858993460 1070805811:858993460")
}

test "ordinary 123456789012345678.0" {
  inspect(same(123456789012345678.0, "123456789012345678.0"), content = "1132161460:3127054133 1132161460:3127054133")
}

test "ordinary 2.2250738585072014" {
  inspect(same(2.2250738585072014, "2.2250738585072014"), content = "1073859827:2246822048 1073859827:2246822048")
}

test "integer halfway 2^53+1 ties to even" {
  inspect(same(9007199254740993.0, "9007199254740993.0"), content = "1128267776:0 1128267776:0")
}

test "integer halfway 2^53+3 ties to even" {
  inspect(same(9007199254740995.0, "9007199254740995.0"), content = "1128267776:2 1128267776:2")
}

test "exact expansion of 0.1" {
  inspect(same(0.1000000000000000055511151231257827021181583404541015625, "0.1000000000000000055511151231257827021181583404541015625"), content = "1069128089:2576980378 1069128089:2576980378")
}

test "DBL_MAX shortest digits written out" {
  inspect(same(.0, ".0"), content = "2146435071:4294967295 2146435071:4294967295")
}

test "DBL_MAX exact" {
  inspect(same(.0, ".0"), content = "2146435071:4294967295 2146435071:4294967295")
}

test "just below DBL_MAX + half ulp rounds to DBL_MAX" {
  inspect(same(.0, ".0"), content = "2146435071:4294967295 2146435071:4294967295")
}

test "DBL_MAX + half ulp ties to even, which overflows" {
  inspect(same(.0, ".0"), content = "2146435072:0 2146435072:0")
}

test "DBL_MAX shortest digits plus one in the last place" {
  inspect(same(.0, ".0"), content = "2146435071:4294967295 2146435071:4294967295")
}

test "smallest subnormal exact" {
  inspect(same(0., "0."), content = "0:1 0:1")
}

test "smallest subnormal shortest digits" {
  inspect(same(0., "0."), content = "0:1 0:1")
}

test "half the smallest subnormal ties to zero" {
  inspect(same(0., "0."), content = "0:0 0:0")
}

test "just above half the smallest subnormal" {
  inspect(same(0., "0."), content = "0:1 0:1")
}

test "largest subnormal exact" {
  inspect(same(0., "0."), content = "1048575:4294967295 1048575:4294967295")
}

test "smallest normal exact" {
  inspect(same(0., "0."), content = "1048576:0 1048576:0")
}

test "halfway between largest subnormal and smallest normal" {
  inspect(same(0., "0."), content = "1048576:0 1048576:0")
}

test "1 + half ulp ties to even" {
  inspect(same(1.00000000000000011102230246251565404236316680908203125, "1.00000000000000011102230246251565404236316680908203125"), content = "1072693248:0 1072693248:0")
}

test "just above 1 + half ulp" {
  inspect(same(1.000000000000000111022302462515654042363166809082031251, "1.000000000000000111022302462515654042363166809082031251"), content = "1072693248:1 1072693248:1")
}

test "just below 1 + half ulp" {
  inspect(same(1.000000000000000111022302462515654042363166809082031249999999, "1.000000000000000111022302462515654042363166809082031249999999"), content = "1072693248:0 1072693248:0")
}

test "1 + 3 half ulps ties to even" {
  inspect(same(1.00000000000000033306690738754696212708950042724609375, "1.00000000000000033306690738754696212708950042724609375"), content = "1072693248:2 1072693248:2")
}

test "1e23 is not representable" {
  inspect(same(100000000000000000000000.0, "100000000000000000000000.0"), content = "1152724226:3353430774 1152724226:3353430774")
}

test "halfway on the 2^-1052 grid" {
  inspect(same(0., "0."), content = "24117248:2 24117248:2")
}

test "f suffix" {
  inspect(same(Float::to_double(2.5f), "2.5"), content = "1074003968:0 1074003968:0")
}
