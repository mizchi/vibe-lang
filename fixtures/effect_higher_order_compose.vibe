// Higher-order: compose two effect handlers into one runner
effect Logger {
  Log(String) -> Unit
}

effect Config {
  Get(String) -> String
}

// Provide Logger handler
let with_logger = (f: () -> Int with Logger) -> Int {
  handle { f() } with Logger { Log(_msg) => resume(0) }
}

// Provide Config handler
let with_config = (f: () -> Int with Config) -> Int {
  handle { f() } with Config { Get(_key) => resume("default_value") }
}

// Compose: Logger around Config
// The inner function uses both effects
let result = with_logger(() -> Int with Logger {
  perform Logger::Log("starting")
  let val = with_config(() -> Int with Config {
    let v = perform Config::Get("app.name")
    String::length(v)
  })
  perform Logger::Log("done")
  val
})
// "default_value" → length 13
result

__DATA__
{"last": "13"}
