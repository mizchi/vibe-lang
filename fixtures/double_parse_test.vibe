//# Misc
// #841 (item E1): Double::parse was declared as a builtin signature but had
// no checker registration and no codegen -- calling it anywhere failed with
// "unknown name: Double::parse". Fixed in checker/builtins_misc.vibe
// (lookup_int_parse, now also handling "Double::parse") and
// codegen/common_base/double_parse_expr.vibe.
//
// #2652: the parser is the Double runtime prelude's `__vibe_double_parse`
// now (codegen/common_base/double_runtime.vibe): correctly rounded, with
// scientific notation, so the two magnitude guards the first version needed
// are gone. They rejected inputs whose integer digits exceeded Int::max_value
// with None, to stay clear of a mutable-Double corruption near 2^62 (#1050,
// since fixed by #1068) -- a `None` for a value the type can hold was itself
// a wrong answer, and the exact parser has no Int accumulator to protect.
// fixtures/double_to_string_test.vibe carries the exhaustive tables.

test "Double::parse valid decimal" {
  let Some(v) = Double::parse("3.14")
  assert(v > 3.139 && v < 3.141)
}

test "Double::parse negative" {
  let Some(v) = Double::parse("-0.5")
  assert(v > -0.51 && v < -0.49)
}

test "Double::parse leading plus" {
  let Some(v) = Double::parse("+2.5")
  assert(v > 2.49 && v < 2.51)
}

test "Double::parse integer only" {
  let Some(v) = Double::parse("42")
  assert(v > 41.9 && v < 42.1)
}

test "Double::parse trailing dot" {
  let Some(v) = Double::parse("5.")
  assert(v > 4.9 && v < 5.1)
}

test "Double::parse leading dot" {
  let Some(v) = Double::parse(".5")
  assert(v > 0.49 && v < 0.51)
}

test "Double::parse zero" {
  let Some(v) = Double::parse("0")
  assert(v == 0.0)
}

test "Double::parse small fraction" {
  let Some(v) = Double::parse("0.001")
  assert(v > 0.0009 && v < 0.0011)
}

test "Double::parse empty string" {
  let result = Double::parse("")
  assert(result is None)
}

test "Double::parse invalid chars" {
  let result = Double::parse("abc")
  assert(result is None)
}

test "Double::parse sign only" {
  let result = Double::parse("-")
  assert(result is None)
}

test "Double::parse two dots" {
  let result = Double::parse("1.2.3")
  assert(result is None)
}

test "Double::parse at the old Int::max_value boundary" {
  let Some(v) = Double::parse("2305843009213693951")
  // The nearest double is 2305843009213693952; its shortest round-trip
  // spelling is the one below (the same digits JavaScript prints).
  inspect(Double::to_string(v), content = "2305843009213694000")
}

test "Double::parse beyond the old magnitude guard is the rounded value, not None (#2652)" {
  let Some(v) = Double::parse("9999999999999999999")
  inspect(Double::to_string(v), content = "10000000000000000000")
}

test "Double::parse of a very long digit string is the rounded value, not None (#2652)" {
  let Some(v) = Double::parse("99999999999999999999999999999999999999.5")
  inspect(Double::to_string(v), content = "1e+38")
}

test "Double::parse reads scientific notation (#2652)" {
  let Some(v) = Double::parse("1e10")
  inspect(Double::to_string(v), content = "10000000000")
  let Some(w) = Double::parse("-2.5E-3")
  inspect(Double::to_string(w), content = "-0.0025")
  assert(Double::parse("1e") is None)
  assert(Double::parse("e5") is None)
}
