// Codex on #3021: a handler arm's kind that names a type formal is a type,
// even when an effect of the same name is in scope.
effect Ask {
  Get() -> Int
}

fn first[Ask](x: Ask, g: (Ask) -> Int) -> Int {
  handle { throw([x]) } with { Exception[Array[Ask]]::Throw(e) => g(Array::get(e, 0)) }
}

test "a formal shadows a same-named effect in an arm's kind" {
  inspect(first(41, (n) -> n + 1), content = "42")
}
