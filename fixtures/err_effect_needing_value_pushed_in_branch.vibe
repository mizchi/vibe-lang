// #4065: the closure pushed into an array in one branch of an `if`, then read
// back after the `if`. The branch may have run, so the read may be the closure
// at its evidence arity, and handing it to a row-free parameter is refused at
// build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    if Array::length(xs) > 0 {
      Array::push(xs, value = g)
    } else {
      ()
    }
    apply(f = Array::get(xs, at = 1))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
