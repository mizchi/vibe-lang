//# Codex round 7 on #2456: a generic enum whose payloads do not mention its
//# formals -- `enum Marker[T] { Mark(Int); Empty }`, a phantom parameter --
//# has a derived `Marker::equals` that is fully structural: each payload is
//# a concrete type `eq_for_typed` compares exactly. The generic-enum
//# fail-closed rule applies only when a formal (or another unsupported
//# payload) can reach the erased comparator, so this one ANSWERS, and the
//# `Int` payload is exact for `64 << 32` vs `65 << 32`.

enum Marker[T] {
  Mark(Int);
  Empty
}

fn fill(xs: Array[Marker[String]], v: Int) -> Unit {
  Array::push(xs, Mark(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let empties = []
  Array::push(empties, Empty)
  assert(left == right)
  assert(left != other)
  assert(left != empties)
  0
}
