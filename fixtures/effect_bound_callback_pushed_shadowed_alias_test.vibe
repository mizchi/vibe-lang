// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    let ys = xs
    let zs = xs
    let xs = [() -> 9]
    Array::push(ys, value = g)
    apply(f = Array::get(zs, at = 1)) + Array::length(xs)
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through pushed shadowed alias" {
  inspect(result(), content = "107")
}
