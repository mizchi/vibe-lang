// #3523: `sleep_wait` called by the entry directly and through a top-level
// `Async` function. Both trapped on an unhandled `Async::Suspend` before the
// entry got a boundary of its own. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh (want 5).
import @vibe/concurrent/experimental {
  sleep_wait
}

fn work() -> Int with Async {
  sleep_wait(1)
  4
}

fn main() -> Int allows Async {
  sleep_wait(1)
  work() + 1
}
