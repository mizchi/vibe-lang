// Logger effect: collect log messages via handler
effect Logger {
  Info(String) -> Unit;
  Warn(String) -> Unit
}

let result = handle {
  perform Logger::Info("starting")
  let x = 40 + 2
  perform Logger::Warn("done")
  x
} with {
  Logger::Info(_msg) => resume(0);
  Logger::Warn(_msg) => resume(0)
}
result

__DATA__
{"last": "42"}
