// #4172: building the string borrows the builder array. The resulting
// string still uses the bump heap, so the gate allows room for that text.

fn nonempty_builder() -> Int {
  let builder = StringBuilder::new()
  StringBuilder::push(builder, value = "ab")
  StringBuilder::push(builder, value = "cd")
  String::length(StringBuilder::build(builder)) - 4
}

fn empty_builders() -> Int {
  let builder = StringBuilder::new()
  let named = StringBuilder::freeze(builder)
  let temporary = StringBuilder::build(StringBuilder::new())
  String::length(named) + String::length(temporary)
}

fn main() -> Int {
  let mut i = 0
  let mut result = 0
  while i < 20000 {
    result = result + nonempty_builder() + empty_builders()
    i = i + 1
  }
  result
}

test "building leaves a named builder usable and its previous result stable" {
  let builder = StringBuilder::new()
  StringBuilder::push(builder, value = "ab")
  let first = StringBuilder::build(builder)
  StringBuilder::push(builder, value = "cd")
  inspect(first, content = "ab")
  inspect(StringBuilder::freeze(builder), content = "abcd")
  inspect(empty_builders(), content = "0")
}
