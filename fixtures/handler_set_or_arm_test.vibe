// #3339: a handler-set arm may join qualified operations with `|`, like the
// header form's `A(_) | B(_)`. It was refused with "handler-set arms must
// name a fully qualified operation".
effect Ab {
  A(Int) -> Int
  B(Int) -> Int
}

fn work() -> Int with Ab {
  perform Ab::A(1) + perform Ab::B(2)
}

test "both operations take the joined arm" {
  let r = handle {
    work()
  } with {
    Ab::A(_) | Ab::B(_) => resume(7)
  }
  inspect(r, "14")
}
