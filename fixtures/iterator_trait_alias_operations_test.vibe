import @vibe/builtin {
  trait Iterator as Iter
}

struct PairIter {
  first: Int;
  second: Int
}

impl Iter[Int] for PairIter {
  iter_length(_self) -> Int {
    2
  }
  iter_get(self, index) -> Int {
    if index == 0 {
      self.first
    } else {
      self.second
    }
  }
}

test "a trait alias exposes operations for every Iterator implementation" {
  let array_values = Iter::map([1, 2], (x: Int) -> Int {
    x + 1
  })
  assert_eq(array_values, [2, 3])
  let string_values = Iter::map("ab", (code: Int) -> Int {
    code + 1
  })
  assert_eq(string_values, [98, 99])
  let custom_values = Iter::map(PairIter::{ first: 3, second: 4 }, (x: Int) -> Int {
    x * 10
  })
  assert_eq(custom_values, [30, 40])
}
