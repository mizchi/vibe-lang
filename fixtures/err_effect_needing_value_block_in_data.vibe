// #4065: the closure as the result of a block, inside a branch stored in an
// array. A block's value is its result, so the array holds the closure and
// reading it into a row-free parameter is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let flag = true
    let xs = [if flag {
      let marker = 0
      g
    } else {
      () -> 7
    }]
    apply(f = Array::get(xs, at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
