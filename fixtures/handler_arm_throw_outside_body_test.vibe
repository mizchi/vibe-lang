// #3540: a handler arm's `throw` belongs to the code around its `handle`, so
// an exception handler INSIDE the handled body must not catch it. A
// tail-resumptive arm used to be lowered in place -- run as the evidence
// closure inside the function that performs -- and an exception is one wasm
// tag caught by the dynamically innermost handler. So `body`'s
// `Exception[Int]` arm caught the `Ask` arm's `throw("not an int")` and
// doubled the string's pointer: `r=274877906954` where the outer
// `Exception[String]` arm must answer -1. Such a handle now runs its arms at
// the handle (the suspend driver), after the body has left its own handlers.
effect Ask {
  Get() -> Int
}

fn body() -> Int with Ask {
  handle {
    perform Ask::Get() + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
}

fn plain() -> Int with Ask {
  perform Ask::Get() + 1
}

fn caught_outside(log: Array[String]) -> Int {
  handle {
    handle {
      body()
    } with { Ask::Get() => throw("not an int") }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -1
  } }
}

// The arm throws on one branch and resumes on the other.
fn sometimes(n: Int, log: Array[String]) -> Int {
  handle {
    handle {
      body() + body()
    } with { Ask::Get() => if n > 5 {
      throw("too big")
    } else {
      resume(n)
    } }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -1
  } }
}

// Controls with no exception handler between the perform and the handle:
// the arm stays on the in-place lowering and its throw reaches the outer arm.
fn no_inner_handler(log: Array[String]) -> Int {
  handle {
    handle {
      plain()
    } with { Ask::Get() => throw("from arm") }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -2
  } }
}

fn direct_perform(log: Array[String]) -> Int {
  handle {
    handle {
      perform Ask::Get() + 1
    } with { Ask::Get() => throw("direct") }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -3
  } }
}

// A sibling exception arm of the same handle does not catch the arm's throw.
// Since #3583 the set is lowered as an exception handler inside the `Ask`
// handle, so the driver above runs the `Ask` arm; it refuses a sibling arm
// that hands a local to a call, so this one only answers (-4 if it caught).
fn sibling_exception_arm(log: Array[String]) -> Int {
  handle {
    handle {
      perform Ask::Get() + 1
    } with { Ask::Get() => throw("from arm"); Exception[String]::Throw(_m) => -4 }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -5
  } }
}

// An exception the BODY throws is still caught by the body's handler.
fn body_throw_caught_inside() -> Int {
  handle {
    handle {
      handle {
        let v = perform Ask::Get()
        throw(v)
      } with { Exception[Int]::Throw(code) => code * 2 }
    } with { Ask::Get() => resume(21) }
  } with { Exception[String]::Throw(_) => -1 }
}

// `return` and `break` in an arm that performs nothing keep working.
fn arm_return() -> Int {
  let r = handle {
    plain()
  } with { Ask::Get() => return 42 }
  r * 10
}

fn arm_break() -> Int {
  let mut i = 0
  let mut acc = 0
  while i < 10 {
    i = i + 1
    let v = handle {
      perform Ask::Get() * 100
    } with { Ask::Get() => if i == 3 {
      break
    } else {
      resume(i)
    } }
    acc = acc + v
  }
  acc
}

test "an exception handler inside the body does not catch the arm's throw" {
  let log: Array[String] = []
  inspect(caught_outside(log), "-1")
  inspect(log, "[outer caught not an int]")
}

test "an arm that throws on one branch and resumes on the other" {
  let log: Array[String] = []
  inspect(sometimes(2, log), "6")
  inspect(sometimes(9, log), "-1")
  inspect(log, "[outer caught too big]")
}

test "with no handler in between the throw reaches the outer arm" {
  let log: Array[String] = []
  inspect(no_inner_handler(log), "-2")
  inspect(direct_perform(log), "-3")
  inspect(log, "[outer caught from arm, outer caught direct]")
}

test "a sibling exception arm does not catch the arm's throw" {
  let log: Array[String] = []
  inspect(sibling_exception_arm(log), "-5")
  inspect(log, "[outer caught from arm]")
}

test "the body's own throw is still caught inside" {
  inspect(body_throw_caught_inside(), "42")
}

// The driver steps `body` inside a closure, so its exception arm sits in a
// lambda; the arm's payload binder is the arm's own, not a capture (the gc
// lane stopped with "`code` reached code generation unresolved").
fn thrower(n: Int) -> Int with Exception[Int] {
  if n > 3 {
    throw(n)
  } else {
    n
  }
}

test "an exception arm inside a lambda binds its payload" {
  let f = (n: Int) -> handle {
    thrower(n) + 1
  } with { Exception[Int]::Throw(code) => code * 2 }
  inspect(f(2), "3")
  inspect(f(5), "10")
}

test "return and break arms" {
  inspect(arm_return(), "42")
  inspect(arm_break(), "300")
}

// An arm calling a local lambda is judged by that lambda. A pure one keeps
// the in-place lowering, even beside an exception arm the driver cannot take
// (this was refused, with a message about a throw the program cannot make).
fn pure_local_call() -> Int {
  let pick = (x: Int) -> x + 1
  handle {
    body()
  } with { Ask::Get() => resume(pick(10)); Exception[String]::Throw(_) => -4 }
}

// One that throws still runs the arm at the handle.
fn throwing_local_call(log: Array[String]) -> Int {
  handle {
    let boom = (m: String) -> Int {
      throw(m)
    }
    handle {
      body()
    } with { Ask::Get() => resume(boom("from a local")) }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -6
  } }
}

test "an arm calling a local lambda" {
  let log: Array[String] = []
  inspect(pure_local_call(), "12")
  inspect(throwing_local_call(log), "-6")
  inspect(log, "[outer caught from a local]")
}

// A handle over two effects whose `Note` arm throws: only a perform of
// `Note` runs that arm, so an exception handler around a perform of `Ask`
// does not matter. This was refused, because every handled effect was checked
// once any arm could throw.
effect Note {
  Put() -> Int
}

fn two_effects(log: Array[String]) -> Int {
  handle {
    handle {
      let x = handle {
        perform Ask::Get() + 1
      } with { Exception[Int]::Throw(code) => code * 2 }
      x + perform Note::Put()
    } with { Note::Put() => throw("from Note"); Ask::Get() => resume(5) }
  } with { Exception[String]::Throw(m) => {
    Array::push(log, "outer caught \{m}")
    -7
  } }
}

test "only a throwing arm's own effect is checked" {
  let log: Array[String] = []
  inspect(two_effects(log), "-7")
  inspect(log, "[outer caught from Note]")
}
