// `Bytes::index_of` (#2345 step 2) -- the SAME windowed search as
// `String::index_of`, reached through a Bytes prologue instead of a String one.
//
// Import-free on purpose so the wasm-gc lane, which compiles one file as
// self-contained, can run it:
//
//   vibe test fixtures/bytes_index_of_test.vibe
//   VIBE_TEST_BACKEND=gc vibe test fixtures/bytes_index_of_test.vibe
//
// The last block is the one that matters most: it asserts Bytes and String
// agree ON THE SAME INPUTS. They share the search loop, so a divergence there
// means the prologue populated the locals wrongly -- which is the only part
// that differs between the two, and the only thing this step could break.
//
// The 16-byte cases are not decoration either. The loop skips a whole window
// when no candidate byte is present, so a needle landing exactly on a window
// boundary, or past several empty windows, exercises the skip path rather
// than the scalar tail.

fn mk(s: String) -> Bytes {
  let b = Bytes::new()
  let n = String::length(s)
  let mut i = 0
  while i < n {
    Bytes::push(b, String::char_code_at(s, i))
    i = i + 1
  }
  b
}

test "Bytes::index_of — 基本" {
  assert_eq(Bytes::index_of(mk("hello world"), mk("world")), 6)
  assert_eq(Bytes::index_of(mk("hello world"), mk("hello")), 0)
  assert_eq(Bytes::index_of(mk("hello world"), mk("zzz")), -1)
}

test "Bytes::index_of — 境界" {
  // 空 needle は 0
  assert_eq(Bytes::index_of(mk("abc"), mk("")), 0)
  // needle が haystack より長い
  assert_eq(Bytes::index_of(mk("ab"), mk("abc")), -1)
  // 末尾一致
  assert_eq(Bytes::index_of(mk("abcdef"), mk("f")), 5)
  // 空 haystack
  assert_eq(Bytes::index_of(mk(""), mk("a")), -1)
}

test "Bytes::index_of — SIMD ウィンドウ境界(16 バイト)をまたぐ" {
  let hay = mk("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaab")
  assert_eq(Bytes::index_of(hay, mk("b")), 32)
  let hay2 = mk("xxxxxxxxxxxxxxxxNEEDLExxxx")
  assert_eq(Bytes::index_of(hay2, mk("NEEDLE")), 16)
}

test "String::index_of と同じ答えを返す" {
  assert_eq(Bytes::index_of(mk("abcabcabc"), mk("cab")), String::index_of("abcabcabc", "cab"))
  assert_eq(Bytes::index_of(mk("mississippi"), mk("issi")), String::index_of("mississippi", "issi"))
  assert_eq(Bytes::index_of(mk("aaa"), mk("aab")), String::index_of("aaa", "aab"))
}
