// An entry's own qualified function wins over the capability builtin, both
// for a direct call and for a first-class value. The path must never be read.
fn Fs::readdir(path: String) -> Int {
  100 + String::length(path)
}

test "an explicit entry function shadows native directory listing" {
  assert_eq(Fs::readdir("abc"), 103)
}

test "an explicit directory-listing shadow survives a value alias" {
  let list = Fs::readdir
  assert_eq(list("abcd"), 104)
}
