import ./gc_import_call_offset_collision_other_dep.vibe {
  imported_float_text as imported_float_text_a
}
import ././gc_import_call_offset_collision_other_dep.vibe {
  imported_float_text as imported_float_text_b
}
import ./gc_import_call_offset_collision_dep.vibe {
  imported_int_text
}

let int_source = () -> Int { 42 }

test "merged files keep call-result offsets disjoint" {
  let n = int_source()
  let f = imported_float_text_a()
  let other = imported_float_text_b()
  let imported_int = imported_int_text()
  assert(n == 42)
  inspect(f, content="1.5")
  inspect(other, content="1.5")
  inspect(imported_int, content="7")
  inspect(n, content="42")
}
