// #4065: the closure pushed into an array through an alias of it, then read
// back through the original name. Both names share the array, so the read is
// the closure at its evidence arity and handing it to a row-free parameter is
// refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    let ys = xs
    Array::push(ys, value = g)
    apply(f = Array::get(xs, at = 1))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
