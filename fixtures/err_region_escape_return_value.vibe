// ADR-0090 Phase 1 (red-first): a region-typed value may not escape via the
// region expression's result. Expected once `region r { }` lands:
//   error_contains: "region"
// (gate-only fixture: not *_test.vibe, so the unit battery skips it until
// the parser/checker slices land and compiler_gate wires it.)
enum Unused {
  U0
}

fn probe() -> Int {
  region r {
    let l = MutList::empty[Int](r)
    MutList::push(l, 1)
    l
  }
  0
}
