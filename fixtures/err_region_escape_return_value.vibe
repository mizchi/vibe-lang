// ADR-0090 Phase 1: a region-typed value may not escape via the region
// expression's result.
//   error_contains: "region escapes its scope"
// (gate-only fixture: not *_test.vibe -- wired into compiler_gate.sh's
// ADR-0090 section. Note: explicit type application on the MutList
// builtins -- `MutList::empty[Int](r)` -- is not supported in this slice;
// the wrapper hides the builtin name from the checker's ECall dispatch, so
// the element type stays inferred/tolerant.)
enum Unused {
  U0
}

fn probe() -> Int {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, 1)
    l
  }
  0
}
