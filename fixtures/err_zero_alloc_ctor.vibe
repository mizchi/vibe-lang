// ADR-0091 Phase 1 (red-first): a @zero_alloc function whose call tree
// allocates must be rejected with the allocation site named. Expected once
// the attribute + per-fn allocation summaries land:
//   error_contains: "zero_alloc"
enum Box {
  MkBox(Int)
}

@zero_alloc
fn hot(n: Int) -> Int {
  let b = MkBox(n)
  match b {
    MkBox(v) => v + 1
  }
}
