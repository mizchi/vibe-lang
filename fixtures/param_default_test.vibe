// #3120: a parameter default `x: T = value`. The body sees `T`; an omitted
// trailing argument takes the default, evaluated in the callee on each call.

fn greet(name: String, times: Int = 1) -> String {
  "\{name} x\{times}"
}

fn span(start: Int, end: Int = start + 10) -> Int {
  end - start
}

fn two(x: Int, y: Int = 1, z: Int = 100) -> Int {
  x + y + z
}

fn labeled(x~: Int, by: Int = 2) -> Int {
  x * by
}

fn fresh_len(xs: Array[Int] = []) -> Int {
  Array::push(xs, 7)
  Array::length(xs)
}

fn mixed(a: Int, b?: Int, c: Int = 5) -> String {
  let shown = match b {
    Some(v) => Int::to_string(v),
    None => "none"
  }
  "\{a} \{shown} \{c}"
}

test "an omitted argument takes the default" {
  inspect(greet("hi"), content = "hi x1")
}

test "a supplied argument replaces the default" {
  inspect(greet("hi", 3), content = "hi x3")
}

test "a default reads the parameters before it" {
  inspect(span(5), content = "10")
  inspect(span(5, 8), content = "3")
}

test "several defaults fill a partial suffix" {
  inspect(two(0), content = "101")
  inspect(two(0, 2), content = "102")
  inspect(two(0, 2, 3), content = "5")
}

test "a default by label" {
  inspect(labeled(x = 3), content = "6")
  inspect(labeled(x = 3, by = 5), content = "15")
}

test "the default is evaluated on every call" {
  inspect(fresh_len(), content = "1")
  inspect(fresh_len(), content = "1")
  inspect(fresh_len([1, 2]), content = "3")
}

test "a default after an optional parameter keeps both meanings" {
  inspect(mixed(1), content = "1 none 5")
  inspect(mixed(1, 2), content = "1 2 5")
  inspect(mixed(1, 2, 3), content = "1 2 3")
}

fn keyword_named(r#match: Int = 1) -> Int {
  r#match + 1
}

test "a keyword-named parameter may carry a default" {
  inspect(keyword_named(), content="2")
  inspect(keyword_named(5), content="6")
}

fn maybe(x: Option[Int] = Some(1)) -> Option[Int] {
  x
}

test "an Option-typed default takes a bound Option value as given" {
  let none: Option[Int] = None
  let two: Option[Int] = Some(2)
  inspect(maybe(), content="Some(1)")
  inspect(maybe(none), content="None")
  inspect(maybe(two), content="Some(2)")
}

// A program's own unwrap of an `x?` parameter has the same shape as the
// default lowering; it is not a default, so a written `Some(..)` stays legal.
fn hand_unwrapped(x?: Int) -> Int {
  let x: Int = match x {
    Some(v) => v,
    None => 1
  }
  x
}

test "a hand-written optional unwrap still takes a written Some" {
  inspect(hand_unwrapped(), content="1")
  inspect(hand_unwrapped(Some(2)), content="2")
  inspect(hand_unwrapped(3), content="3")
}

test "a lambda that calls a defaulted function keeps the call direct" {
  let pass_through = (v: Option[Int]) -> maybe(v)
  let use_default = () -> maybe()
  inspect(pass_through(None), content="None")
  inspect(use_default(), content="Some(1)")
}

fn digits(a: Int = 1, b: Int = 2, c: Int = 3) -> Int {
  a * 100 + b * 10 + c
}

fn opt_digits(a?: Int, b?: Int, c?: Int) -> String {
  let av = match a {
    Some(v) => Int::to_string(v),
    None => "-"
  }
  let bv = match b {
    Some(v) => Int::to_string(v),
    None => "-"
  }
  let cv = match c {
    Some(v) => Int::to_string(v),
    None => "-"
  }
  "\{av}\{bv}\{cv}"
}

// Codex on #3438: a fully labeled call that omits optional parameters is
// placed by its labels, with `None` in each omitted slot. Before, it was bound
// by position: `digits(b = 4, a = 5)` answered 453.
test "labels are placed by name when trailing defaults are omitted" {
  inspect(digits(b = 4, a = 5), content = "543")
  inspect(digits(c = 6, a = 5), content = "526")
  inspect(digits(b = 4), content = "143")
}

test "labels are placed by name around omitted optional parameters" {
  inspect(opt_digits(b = 4, a = 5), content = "54-")
  inspect(opt_digits(a = 5, c = 6), content = "5-6")
  inspect(opt_digits(c = 6), content = "--6")
}

test "a local optional lambda places its labels by name" {
  let f = (a?: Int, b?: Int, c?: Int) -> String {
    let av = match a {
      Some(v) => Int::to_string(v),
      None => "-"
    }
    let bv = match b {
      Some(v) => Int::to_string(v),
      None => "-"
    }
    let cv = match c {
      Some(v) => Int::to_string(v),
      None => "-"
    }
    "\{av}\{bv}\{cv}"
  }
  inspect(f(b = 4, a = 5), content = "54-")
  inspect(f(c = 6), content = "--6")
}
