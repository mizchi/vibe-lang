//# Codex on #3995: `type A[T] = T` beside a top-level `type T = A[Int]`. The
//# `T` in `A`'s body is `A`'s parameter, not the alias `T`, so the size count
//# finds no cycle, both aliases are canonicalized, and `impl Mark[T]` meets a
//# bound spelled `Mark[Int]`.
type A[T] = T

type T = A[Int]

trait Mark[X] {
  mark(Self) -> Int
}

struct Note {
  n: Int
}

impl Mark[T] for Note {
  mark(self) -> Int {
    self.n
  }
}

fn marked[V: Mark[Int]](_ v: V) -> Int {
  V::mark(v)
}

test "an alias parameter spelled like another alias" {
  inspect(marked(Note::{ n: 6 }), content = "6")
}
