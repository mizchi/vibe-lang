// Phase 2: HTTP handler with string params for WASI P3 adapter compose.
// handler(method, url) returns status code based on method/url.
// Note: use string_equals() instead of == for wasm string comparison.
export let handler = (method: String, url: String) -> Int {
  if string_equals(method, "GET") {
    if string_equals(url, "/") { 200 } else { 404 }
  } else {
    405
  }
}
handler("GET", "/")
