//# #2745: a RECORD bound to a name, then destructured.
//
// Codex, P1 round 9 on #2761. Measured: `{ let r = Box1::{ value: a };
// match r { Box1::{ value } => value } }` with `a: T` printed `252`.
//
// This is the THIRD aggregate kind, and it should have landed with the other
// two. The patterns that take an aggregate apart are exactly `PTuple` /
// `PCtor` / `PStruct` -- the `Pat` enum says so -- and the previous commit
// closed the first two while the `PStruct` arm sat in the same function.
// Recording all three closes the set against the enum rather than one kind per
// review round, which is the discipline the rest of this walk already follows
// and which I did not apply here.
//
// A record's fields are NAMED, so they cannot use the positional index keys and
// an alias copies them by PREFIX rather than by probing an index range. The
// `$` separator is what keeps `__Vfield$r$v` from being a prefix of
// `__Vfield$r2$v`.
//
// The recorded struct must equal the pattern's, the same check the constructor
// route makes and for the same reason: without it, a pattern would take an
// unrelated aggregate's fields apart.

struct Qt {
  w: Int
}

struct Box1[U] {
  value: U
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let r = Box1::{ value: a }
    match r {
      Box1::{ value } => value
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
