// #3152: a closure PARAMETER whose captures the check cannot see is refused
// at the spawn, with the edit that fixes it. `go` takes its `TaskGroup` last,
// so it is not spawn-shaped and its callers are not checked; before the fix
// the plain outer `Array` captured at the call below crossed the boundary.
import @vibe/concurrent {
  TaskError, TaskGroup, TaskHandle
}

fn go[rg, e](work: () -> Int with Exception + e, n: TaskGroup[rg, e]) -> Int with Exception[TaskError] + e {
  TaskHandle::join(TaskGroup::spawn(n, work))
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> go(() -> {
    Array::set(seen, 0, 1)
    0
  }, n))
  ()
}
