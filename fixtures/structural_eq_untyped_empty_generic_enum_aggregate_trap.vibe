//# Codex round 5 on #2456, the fail-closed side for any generic enum: a
//# `Wrap[Array[Int]]` payload would be compared by reference by the derived
//# `Wrap::equals`, so once both sides are non-empty the comparison must TRAP
//# rather than answer `false` for equal content.

enum Wrap[T] {
  W(T);
  Empty
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W([v, v + 1]))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
