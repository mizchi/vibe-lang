enum Color { Red; Green; Blue } derive(Eq)

let _start = () -> {
  let mut score = 0
  if Color::Red == Color::Red { score = score + 1 }
  if !(Color::Red == Color::Blue) { score = score + 1 }
  if !(Color::Green == Color::Blue) { score = score + 1 }
  if Color::Blue == Color::Blue { score = score + 1 }
  score
}
