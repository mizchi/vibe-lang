// #1973: was fixtures/suberror_catch.vibe + __DATA__.last "-1".
// Same hoist as suberror_basic_test: `suberror` stays at the top level.

suberror MathError {
  DivByZero
}

fn safe_div(a: Int, b: Int) -> Int with Exception {
  if b == 0 {
    throw(DivByZero)
  }
  a / b
}

test "suberror catch maps DivByZero to -1" {
  let result = handle {
    safe_div(10, 0)
  } with {
    Exception::Throw(_) => 0 - 1
  }
  inspect(result, "-1")
}
