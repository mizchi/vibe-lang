// #3125: a renamed import of `TaskGroup::spawn` keeps its `Spawnable` capture
// check. The check follows the callee's type, not the spelling written at the
// call, so `sp(n, ...)` is judged like `TaskGroup::spawn(n, ...)`.
import @vibe/concurrent {
  TaskGroup, TaskGroup::spawn as sp, TaskHandle
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    let h = sp(n, () -> {
      Array::set(seen, 0, 1)
      0
    })
    TaskHandle::join(h)
  })
  ()
}
