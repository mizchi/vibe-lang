// #3551: a `derive (Hash)` type with a field of a declared type that only
// derives `Show`. The derived key used that field's `to_string`, which is not
// injective: `Inner { a: "p, b: q", b: "r" }` and `Inner { a: "p", b: "q, b:
// r" }` both render `Inner { a: p, b: q, b: r }`, so two different `Outer`
// values shared one key and `Map::set_by` / `get_by` aliased them. The derive
// is refused, naming the edit.

struct Inner {
  a: String;
  b: String
} derive(Eq, Show)

struct Outer {
  i: Inner
} derive(Eq, Hash)

export let _start: () -> Int = () -> {
  0
}
