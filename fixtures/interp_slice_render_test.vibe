// #3080: a slice written with the index syntax (`xs[a:b]`, which parses to
// `__slice`) renders by content, exactly like `Array::slice(xs, a, b)` and
// like an annotated binding. Before the fix normalize resolved no shape for
// it, and both lanes printed a heap address (`inspect(xs[1:2], "[1]")`
// answered `308` on linear and `844` on gc). The gate runs this file on the
// linear and gc lanes.

test "index-form slice renders by content" {
  let xs = [3, 1, 2]
  inspect(xs[1:2], "[1]")
  inspect(xs[0:3], "[3, 1, 2]")
  inspect(xs[:2], "[3, 1]")
  inspect(xs[1:], "[1, 2]")
  inspect(xs[2:1], "[]")
}

test "index-form slice inside an interpolation" {
  let xs = [3, 1, 2]
  inspect("s=\{xs[0:2]} n=\{Array::length(xs[1:])}", "s=[3, 1] n=2")
}

test "index-form slice of strings and of arrays" {
  let names = ["a", "b", "c"]
  inspect(names[1:3], "[b, c]")
  let grid = [[1, 2], [3]]
  inspect(grid[0:1], "[[1, 2]]")
}

test "the spelled-out call and a string slice are unchanged" {
  let xs = [3, 1, 2]
  inspect(Array::slice(xs, 1, 2), "[1]")
  let s = "abcdef"
  inspect(s[1:3], "bc")
  inspect("<\{s[0:2]}>", "<ab>")
}
