// #3187: a bound on a prelude trait is satisfied at every scalar the prelude
// declares an impl for, in a program that imports nothing.
//
// The checker does not read `@vibe/builtin/builtin_traits.vibe`; it seeds a
// copy of its impls (`register_builtin_traits_for`). The copy had no `Signed`
// and no `Default` rows, so every call below was refused with
// ``no impl `Signed` for `Int` `` / ``no impl `Default` for `Int` `` while
// the prelude says both impls exist. `Eq for Char` was missing too; it
// happened to be satisfied anyway because `Char` is a transparent `Int`.
// builtin_trait_seed_parity_test.vibe now keeps the two tables equal. The
// refusals that remain are pinned by fixtures/typecheck/
// {signed_bound_string,default_dispatch_without_core,
// default_own_trait_withholds_seed}_reject.vibe.

fn keep_signed[T: Signed](x: T) -> T {
  x
}

fn keep_default[T: Default](x: T) -> T {
  x
}

fn same[T: Eq](a: T, b: T) -> Bool {
  a == b
}

test "Signed is satisfied at Int and Double" {
  inspect(keep_signed(-3), "-3")
  inspect(keep_signed(40 - 42), "-2")
  inspect(keep_signed(2.5), "2.5")
}

test "Default is satisfied at Int, Double, Bool and String" {
  inspect(keep_default(7), "7")
  inspect(keep_default(0.5), "0.5")
  inspect(keep_default(true), "true")
  inspect(keep_default("xyz"), "xyz")
}

test "Eq is satisfied at Char and compares by value" {
  let a: Char = 'a'
  let b: Char = 'b'
  inspect(same(a, a), "true")
  inspect(same(a, b), "false")
}
