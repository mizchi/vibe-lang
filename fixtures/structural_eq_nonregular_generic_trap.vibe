//# Mixed regular and growing generic recursion must terminate and fail closed.

struct Mixed[T] {
  value: T;
  same: Option[Mixed[T]];
  grow: Option[Mixed[Array[T]]]
} derive (Eq)

export fn _start() -> Int {
  let left = Mixed[Int]::{
    value: 1,
    same: Some(Mixed[Int]::{ value: 2, same: None, grow: None }),
    grow: Some(Mixed[Array[Int]]::{ value: [3], same: None, grow: None })
  }
  let right = Mixed[Int]::{
    value: 1,
    same: Some(Mixed[Int]::{ value: 2, same: None, grow: None }),
    grow: Some(Mixed[Array[Int]]::{ value: [3], same: None, grow: None })
  }
  if left == right {
    1
  } else {
    0
  }
}
