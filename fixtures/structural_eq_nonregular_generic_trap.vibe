//# Cross-head regular and growing recursion must terminate and fail closed.

struct MixedA[T] {
  value: T;
  same: Option[MixedA[T]];
  grow: Option[MixedB[Array[T]]]
} derive (Eq)

struct MixedB[T] {
  value: T;
  same: Option[MixedB[T]];
  next: Option[MixedA[T]]
} derive (Eq)

export fn _start() -> Int {
  let left = MixedA[Int]::{
    value: 1,
    same: Some(MixedA[Int]::{ value: 2, same: None, grow: None }),
    grow: Some(MixedB[Array[Int]]::{ value: [3], same: None, next: None })
  }
  let right = MixedA[Int]::{
    value: 1,
    same: Some(MixedA[Int]::{ value: 2, same: None, grow: None }),
    grow: Some(MixedB[Array[Int]]::{ value: [3], same: None, next: None })
  }
  if left == right {
    1
  } else {
    0
  }
}
