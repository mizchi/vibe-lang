//# Mutually non-regular generic recursion must terminate and fail closed.

struct Left[T] {
  value: T;
  next: Option[Right[Array[T]]]
} derive (Eq)

struct Right[T] {
  value: T;
  next: Option[Left[Array[T]]]
} derive (Eq)

export fn _start() -> Int {
  let left = Left[Int]::{
    value: 1,
    next: Some(Right[Array[Int]]::{
      value: [2],
      next: Some(Left[Array[Array[Int]]]::{ value: [[3]], next: None })
    })
  }
  let right = Left[Int]::{
    value: 1,
    next: Some(Right[Array[Int]]::{
      value: [2],
      next: Some(Left[Array[Array[Int]]]::{ value: [[3]], next: None })
    })
  }
  if left == right {
    1
  } else {
    0
  }
}
