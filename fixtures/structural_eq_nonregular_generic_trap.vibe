//# Non-regular generic recursion must terminate specialization and fail closed.

struct Loop[T] {
  value: T;
  next: Option[Loop[Array[T]]]
} derive (Eq)

export fn _start() -> Int {
  let left = Loop[Int]::{
    value: 1,
    next: Some(Loop[Array[Int]]::{ value: [2], next: None })
  }
  let right = Loop[Int]::{
    value: 1,
    next: Some(Loop[Array[Int]]::{ value: [2], next: None })
  }
  if left == right {
    1
  } else {
    0
  }
}
