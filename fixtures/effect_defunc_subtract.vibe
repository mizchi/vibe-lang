// Defunctionalize with subtraction: v - k(0)
effect Yield { Yield(Int) -> Unit }

let result = handle {
  perform Yield::Yield(100)
  perform Yield::Yield(30)
  perform Yield::Yield(7)
  0
} { Yield::Yield(v, k) => v - k(0) }
// 100 - (30 - (7 - 0)) = 100 - (30 - 7) = 100 - 23 = 77
result

__DATA__
{"last": "77"}
