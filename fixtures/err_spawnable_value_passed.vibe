// #3125: handing `TaskGroup::spawn` on as a value hides the closure it will
// be applied to from the `Spawnable` capture check, which runs at a call.
// Before the fix `apply2` ran the plain-`Array` capture below; the value is
// now refused where it is taken, with the edit that fixes it.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn apply2[A, B, C](f: (A, B) -> C, a: A, b: B) -> C {
  f(a, b)
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    let h = apply2(TaskGroup::spawn, n, () -> {
      Array::set(seen, 0, 1)
      0
    })
    TaskHandle::join(h)
  })
  ()
}
