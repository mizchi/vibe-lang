import @vibe/builtin {
  cmp_eq, num_add, to_string
}

test "the imported builtin traits preserve binary32 semantics" {
  inspect(cmp_eq(0.1f, 0.1f), content = "true")
  inspect(cmp_eq(0.1f, 0.2f), content = "false")
  inspect(num_add(0.1f, 0.2f), content = "0.3")
  inspect(num_add(num_add(16777216.0f, 1.0f), -16777216.0f), content = "0")
  inspect(cmp_eq(1.5, 1.5), content = "true")
  inspect(to_string(0.1f), content = "0.1")
}
