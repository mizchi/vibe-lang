import @vibe/builtin {
  cmp_eq, num_add, to_string
}

test "the imported builtin traits preserve binary32 semantics" {
  inspect(cmp_eq(a = 0.1f, b = 0.1f), content = "true")
  inspect(cmp_eq(a = 0.1f, b = 0.2f), content = "false")
  inspect(num_add(a = 0.1f, b = 0.2f), content = "0.3")
  inspect(num_add(a = num_add(a = 16777216.0f, b = 1.0f), b = -16777216.0f), content = "0")
  inspect(cmp_eq(a = 1.5, b = 1.5), content = "true")
  inspect(to_string(0.1f), content = "0.1")
}
