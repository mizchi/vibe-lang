// #1938: nesting another closure must not erase capture provenance.
//   error_contains: "region escapes its scope"
fn build() -> () -> () -> Array[Int] {
  region r {
    let values = MutList::empty(r)
    () -> () -> Array[Int] {
      () -> Array[Int] {
        MutList::to_array(values)
      }
    }
  }
}
