//# #2745: a function-valued parameter returning a TUPLE of the formal.
//
// Found by probing the neighbour of round 23's `Array[T]` report, in the same
// commit. Measured on `c799c16`: `[T](a: T, f: (T) -> (T, Int))` then
// `{ let p = f(a); p.0 }` printed a 3-digit pointer decimal, exactly as the
// `Array[T]` spelling did.
//
// Both are the same fact -- a parameter's annotation names the shape of what it
// returns -- so they land together rather than one per review round. Positions
// the annotation gives a concrete name stay renderable: it is the guard in
// `dtd_interp_lamret_src_formal` that decides erasure, not the recording, which
// is why every position is recorded and `fnparam_tup_other_slot` still prints.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T, f: (T) -> (T, Int)) -> String {
    "\{ { let p = f(a)
    p.0 } }"
  }
  inner(Qt::{ w: 5 }, (v: Qt) -> (Qt, Int) {
    (v, 0)
  })
}

export fn _start() -> Int {
  String::length(outer(7))
}
