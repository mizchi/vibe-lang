//# #3297: `==` on two `Ok` / `Err` values whose payload is typed by an
//# `Eq`-bounded formal, with no complete type for the comparison. `a` and `b`
//# are `Res[t, T]` with `t` free, so the checker records no row, the witness
//# route cannot read the unknown `Ok` slot, and the ladder reached its
//# `Ok` / `Err` match, which compares each payload with the raw `==` --
//# reference identity for the `derive (Eq)` struct the test passes. Measured
//# before the refusal, the comparison compiled clean and answered `false` for
//# equal values. The edit the refusal names, annotating the bindings
//# (`eq_derived_generic_annotated_witness_test.vibe`), compares the payload
//# through `T`'s witness.

enum Res[T, E] {
  Ok(T);
  Err(E)
}

struct Pt {
  x: Int;
  tags: Array[Int]
} derive (Eq)

fn same_err[T: Eq](x: T, y: T) -> Bool {
  let a = Err(x)
  let b = Err(y)
  a == b
}

test "equal payloads" {
  inspect(same_err(Pt::{ x: 1, tags: [1] }, Pt::{ x: 1, tags: [1] }), "true")
}
