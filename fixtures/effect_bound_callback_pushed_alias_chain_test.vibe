// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    let a0 = xs
    let a1 = a0
    let a2 = a1
    let a3 = a2
    let a4 = a3
    let a5 = a4
    let a6 = a5
    let a7 = a6
    let a8 = a7
    let a9 = a8
    let a10 = a9
    let a11 = a10
    let a12 = a11
    let a13 = a12
    let a14 = a13
    let a15 = a14
    let a16 = a15
    let a17 = a16
    let a18 = a17
    let a19 = a18
    Array::push(a19, value = g)
    apply(f = Array::get(xs, at = 1))
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through pushed alias chain" {
  inspect(result(), content = "106")
}
