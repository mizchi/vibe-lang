// ADR-0090 (#1274 Codex P1): the region token is unforgeable. Calling
// MutList::empty with anything but the `region r { ... }` binder's own
// skolem-typed token is a STATIC error -- otherwise `MutList::empty(0)`
// would install a skolem-free phantom the escape scan can never see.
//   error_contains: "region token"
fn probe() -> Int {
  let l = MutList::empty(0)
  MutList::push(l, 1)
  0
}
