// HTTP server: request + auth routing (simplified, no string concat)
effect HttpReq { Method -> String; Url -> String }
effect Auth { Verify(String) -> Bool }

// Authenticated GET /api → 200
let test1 = handle {
  handle {
    let url = perform HttpReq::Url
    if String::equals(url, "/api") {
      let ok = perform Auth::Verify("token")
      if ok { 200 } else { 401 }
    } else if String::equals(url, "/") {
      200
    } else { 404 }
  } with {
    Auth::Verify(_t) => resume(true)
  }
} with {
  HttpReq::Method => resume("GET");
  HttpReq::Url => resume("/api")
}

// Unauthenticated GET /api → 401
let test2 = handle {
  handle {
    let url = perform HttpReq::Url
    if String::equals(url, "/api") {
      let ok = perform Auth::Verify("token")
      if ok { 200 } else { 401 }
    } else { 404 }
  } with {
    Auth::Verify(_t) => resume(false)
  }
} with {
  HttpReq::Method => resume("GET");
  HttpReq::Url => resume("/api")
}

test1 + test2

__DATA__
{"last": "601"}
