// #3137: a discarded `for` whose body is a heap binding keeps the RC heap
// frontier bounded.
//
// A `for` at the head of a sequence drops each body value without releasing
// it, while the Perceus plan counted a bare name there as an owning use, so
// `d` below lost its scope-end drop and leaked whole on every call -- and the
// same held for a bare `d` statement. Before the fix this fixture grew
// `__heap_ptr` by 448,084 B over its 2000 calls, linearly (224,084 B at
// 1000); with it, 196 B. The gate compiles it under VIBE_RC=1 and bounds the growth
// (tests/gates/mid/run.sh, 40f0f); the same gate checks the answer on the
// bump, rc, shadow and gc lanes, and the shadow lane traps on the drop of a
// freed block. What each rewritten shape still reads after its loop is pinned
// by fixtures/rc_forin_discard_body_test.vibe.
//
// #3162: the same leak held for a `handle` at the head of a sequence (its
// body and each handler arm are the handle's value, which the sequence drops
// unreleased) and for a `while` body (dropped after every iteration). Unfixed,
// those three shapes added 672,000 B over the 2000 calls (224,000 B each).
//
// `main` sums, per call, the payload's second element from the loop body (1),
// from the sequence head (i), from the handled body (1), from the handler arm
// (1) and from the while body (1): 2000 * 4 + 1999 * 2000 / 2 = 2007000.

enum D {
  A(Array[Int])
}

fn second(d: D) -> Int {
  match d {
    A(xs) => Array::get(xs, 1)
  }
}

fn in_loop(ns: Array[Int]) -> Int {
  let d = A([0, 1])
  for x in ns {
    d
  }
  second(d)
}

fn at_head(n: Int) -> Int {
  let d = A([n, n])
  d
  second(d)
}

fn may_throw(n: Int) -> Int with Exception {
  if n < 0 {
    throw("negative")
  } else {
    n
  }
}

fn in_handle_body(n: Int) -> Int {
  let d = A([n, 1])
  handle {
    may_throw(n)
    d
  } with {
    Exception::Throw(_) => A([0, 0])
  }
  second(d)
}

fn in_handle_arm(n: Int) -> Int {
  let d = A([n, 1])
  handle {
    may_throw(0 - 1 - n)
    A([0, 0])
  } with {
    Exception::Throw(_) => d
  }
  second(d)
}

fn in_while(n: Int) -> Int {
  let d = A([n, 1])
  let mut k = 0
  while k < 2 {
    k = k + 1
    d
  }
  second(d)
}

export fn main() -> Int {
  let ns = [1, 2, 3, 4]
  let mut i = 0
  let mut acc = 0
  while i < 2000 {
    acc = acc + in_loop(ns) + at_head(i) + in_handle_body(i) + in_handle_arm(i) + in_while(i)
    i = i + 1
  }
  acc
}
