import ./import_kind_phase1/reexport.vibe {
  PublicChoice
}

fn choice_label(choice: PublicChoice) -> String {
  match choice {
    PublicChoice::First => "first",
    PublicChoice::Second => "second"
  }
}

test "constructors through a re-exported enum alias" {
  inspect(choice_label(PublicChoice::First), "first")
  inspect(choice_label(PublicChoice::Second), "second")
}
