// Generalized defunctionalization: any f(v, k(base))
effect Yield { Yield(Int) -> Unit }

// Sum: v + k(0) → 10 + 20 + 30 + 0 = 60
let sum = handle {
  perform Yield::Yield(10)
  perform Yield::Yield(20)
  perform Yield::Yield(30)
  0
} { Yield::Yield(v, k) => v + k(0) }
sum

__DATA__
{"last": "60"}
