import @vibe/builtin {
  Array::flatmap as standard_flatmap, trait Iterator
}

fn Array::flatmap[A, B](_xs: Array[A], _f: (A) -> Array[B]) -> Array[B] {
  [77]
}

test "entry Array flatmap stays separate from the Iterator specialization" {
  let direct = Array::flatmap([1, 2], (x: Int) -> Array[Int] {
    [x]
  })
  inspect(Array::length(direct), "1")
  inspect(Array::get(direct, 0), "77")
  let specialized = standard_flatmap([1, 2], (x: Int) -> Array[Int] {
    [x, x]
  })
  inspect(Array::length(specialized), "4")
  inspect(Array::get(specialized, 3), "2")
  let iterated = Iterator::flatmap([1, 2], (x: Int) -> Array[Int] {
    [x, x]
  })
  inspect(Array::length(iterated), "4")
  inspect(Array::get(iterated, 0), "1")
  inspect(Array::get(iterated, 1), "1")
  inspect(Array::get(iterated, 2), "2")
  inspect(Array::get(iterated, 3), "2")
}
