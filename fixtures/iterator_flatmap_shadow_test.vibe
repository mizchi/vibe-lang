import @vibe/builtin {
  Array::flatmap as standard_flatmap, trait Iterator
}

fn Array::flatmap[A, B](_ _xs: Array[A], _f: (A) -> Array[B]) -> Array[B] {
  [77]
}

test "entry Array flatmap stays separate from the Iterator specialization" {
  let direct = Array::flatmap([1, 2], _f = (x: Int) -> Array[Int] {
    [x]
  })
  inspect(Array::length(direct), "1")
  inspect(Array::get(direct, at = 0), "77")
  let specialized = standard_flatmap([1, 2], f = (x: Int) -> Array[Int] {
    [x, x]
  })
  inspect(Array::length(specialized), "4")
  inspect(Array::get(specialized, at = 3), "2")
  let iterated = Iterator::flatmap(xs = [1, 2], f = (x: Int) -> Array[Int] {
    [x, x]
  })
  inspect(Array::length(iterated), "4")
  inspect(Array::get(iterated, at = 0), "1")
  inspect(Array::get(iterated, at = 1), "1")
  inspect(Array::get(iterated, at = 2), "2")
  inspect(Array::get(iterated, at = 3), "2")
}
