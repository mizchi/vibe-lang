// #1967: was fixtures/trait_bound_multi_basic.vibe + __DATA__.last "ok".
// Current Show resolution has no impl Show for String. The multi-bound
// is expressed with local traits only.

trait LocalEq
trait LocalShow
impl LocalEq for String
impl LocalShow for String

fn id[T: LocalEq + LocalShow](x: T) -> T {
  x
}

test "LocalEq plus LocalShow bound accepts String" {
  inspect(id("ok"), "ok")
}
