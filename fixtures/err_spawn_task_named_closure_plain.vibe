// #3517: a task closure bound by `let` and passed to `TaskGroup::spawn` by
// name is refused the same way. Before the fix the sum below answered 1598
// (measured on the committed seed) where 42 + 6 is right: the `Async` closure returned a step and the pure one
// a number. Compiled and refused by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn work() -> Int with Async {
  5
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let pure_task = () -> {
      21 * 2
    }
    let async_task = () -> {
      work() + 1
    }
    let h1 = TaskGroup::spawn(g, pure_task)
    let h2 = TaskGroup::spawn(g, async_task)
    TaskHandle::join(h1) + TaskHandle::join(h2)
  })
}
