//# #3288: `==` on a generic enum one of whose parameters is a type
//# CONSTRUCTOR (`F[_]`). The argument for that parameter is a constructor
//# (`Option`, `Array`, a declared generic type), never a value type, and the
//# comparator substitutes it as the head of the payload's application. Before
//# the fix the comparison fell back to the derived `Kinded::equals`, which
//# compares the `T` payload by identity: two equal values answered `false`,
//# annotated or not.

enum Kinded[T, F[_]] {
  KOk(T);
  KErr(F[Int])
}

enum Kinded2[T, G[_, _]] {
  AOk(T);
  AErr(G[Int, String])
}

enum Pair2[A, B] {
  P2(A, B)
}

struct Bx[T] {
  v: T
}

struct KSt[F[_], A] {
  value: F[A]
} derive (Eq)

struct Phantom[G[_]] {
  n: Int
} derive (Eq)

enum Onward[T, F[_]] {
  OA(T);
  OB(Phantom[F])
}

type AppInt[H[_]] = H[Int]

enum ViaAlias[T, F[_]] {
  VA(T);
  VB(AppInt[F])
}

test "annotated with a builtin constructor, the value payload" {
  let a: Kinded[Array[Int], Option] = KOk([1, 2])
  let b: Kinded[Array[Int], Option] = KOk([1, 2])
  let c: Kinded[Array[Int], Option] = KOk([1, 3])
  inspect(a == b, "true")
  inspect(a != b, "false")
  inspect(a == c, "false")
  inspect(a != c, "true")
}

test "annotated with a builtin constructor, the constructor payload" {
  let a: Kinded[Array[Int], Option] = KErr(Some(1))
  let b: Kinded[Array[Int], Option] = KErr(Some(1))
  let c: Kinded[Array[Int], Option] = KErr(None)
  let d: Kinded[Array[Int], Option] = KOk([1])
  inspect(a == b, "true")
  inspect(a == c, "false")
  inspect(a == d, "false")
  let e: Kinded[Array[Int], Array] = KErr([1, 2])
  let f: Kinded[Array[Int], Array] = KErr([1, 2])
  let g: Kinded[Array[Int], Array] = KErr([2, 1])
  inspect(e == f, "true")
  inspect(e == g, "false")
}

test "annotated with a declared constructor" {
  let a: Kinded[Array[Int], Bx] = KErr(Bx::{ v: 5 })
  let b: Kinded[Array[Int], Bx] = KErr(Bx::{ v: 5 })
  let c: Kinded[Array[Int], Bx] = KErr(Bx::{ v: 6 })
  inspect(a == b, "true")
  inspect(a == c, "false")
  let d: Kinded[Array[Int], Bx] = KOk([1, 2])
  let e: Kinded[Array[Int], Bx] = KOk([1, 2])
  inspect(d == e, "true")
}

test "unannotated, the constructor argument unconstrained" {
  let a = KOk([1, 2])
  let b = KOk([1, 2])
  let c = KOk([1, 3])
  inspect(a == b, "true")
  inspect(a != b, "false")
  inspect(a == c, "false")
}

test "unannotated, the constructor argument inferred from the payload" {
  let a = KErr([1, 2])
  let b = KErr([1, 2])
  let c = KErr([1, 3])
  inspect(a == b, "true")
  inspect(a == c, "false")
  let s1 = KErr(Some(4))
  let s2 = KErr(Some(4))
  inspect(s1 == s2, "true")
}

test "a constructor parameter of arity two" {
  let a = AOk([1, 2])
  let b = AOk([1, 2])
  let c = AOk([2, 2])
  inspect(a == b, "true")
  inspect(a == c, "false")
  let p: Kinded2[Array[Int], Pair2] = AErr(P2(1, "x"))
  let q: Kinded2[Array[Int], Pair2] = AErr(P2(1, "x"))
  let r: Kinded2[Array[Int], Pair2] = AErr(P2(1, "y"))
  inspect(p == q, "true")
  inspect(p == r, "false")
}

test "nested inside another container" {
  let a = Some(KOk([1, 2]))
  let b = Some(KOk([1, 2]))
  let c = Some(KOk([1, 9]))
  inspect(a == b, "true")
  inspect(a == c, "false")
  let xs: Array[Kinded[Array[Int], Option]] = [KOk([1]), KErr(Some(2))]
  let ys: Array[Kinded[Array[Int], Option]] = [KOk([1]), KErr(Some(2))]
  let zs: Array[Kinded[Array[Int], Option]] = [KOk([1]), KErr(Some(3))]
  inspect(xs == ys, "true")
  inspect(xs == zs, "false")
}

test "a generic struct with a constructor parameter" {
  let a = KSt[Option, Array[Int]]::{ value: Some([1, 2]) }
  let b = KSt[Option, Array[Int]]::{ value: Some([1, 2]) }
  let c = KSt[Option, Array[Int]]::{ value: Some([1, 3]) }
  inspect(a == b, "true")
  inspect(a == c, "false")
  let d: KSt[Option, Array[Int]] = KSt::{ value: Some([1, 2]) }
  let e: KSt[Option, Array[Int]] = KSt::{ value: Some([1, 2]) }
  let f: KSt[Option, Array[Int]] = KSt::{ value: None }
  inspect(d == e, "true")
  inspect(d == f, "false")
}

// The unconstrained constructor is filled with `Unit`, which has the wrong kind
// for `F`. It lives only inside the generated comparators, which are not
// type-checked again, and every application of it is rewritten to `Unit`.
// These two rows pin that comparator generation still succeeds when the
// placeholder is passed on unapplied (Codex on #3296) or through an alias.
// `OB` is constructible with `F` free, because `Phantom` holds no `G` data.
test "a free constructor passed on to another declaration" {
  let a = OA([1, 2])
  let b = OA([1, 2])
  let c = OA([1, 3])
  inspect(a == b, "true")
  inspect(a == c, "false")
  let p = OB(Phantom::{ n: 1 })
  let q = OB(Phantom::{ n: 1 })
  let r = OB(Phantom::{ n: 2 })
  inspect(p == q, "true")
  inspect(p == r, "false")
}

test "a constructor parameter passed through a type alias" {
  let a = VA([1, 2])
  let b = VA([1, 2])
  inspect(a == b, "true")
  let s: ViaAlias[Array[Int], Option] = VB(Some(1))
  let t: ViaAlias[Array[Int], Option] = VB(Some(1))
  let u: ViaAlias[Array[Int], Option] = VB(None)
  inspect(s == t, "true")
  inspect(s == u, "false")
}
