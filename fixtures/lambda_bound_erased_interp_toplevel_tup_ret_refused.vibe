//# #2745: a TOP-LEVEL generic returning a tuple of its own formal.
//
// Found by probing the neighbour of round 25's `Array[U]` report, in the same
// commit. Measured on `3913a8a`: `fn pack2[U](u: U) -> (U, Int)` then
// `{ let p = pack2(a); p.0 }` printed a 3-digit pointer decimal.
//
// It lands with the array spelling rather than one round later because it is
// the same fact -- a top-level generic's return shape was simply not recorded
// -- and the marker that carries one carries the other. Looking for the sibling
// spelling BEFORE moving on is the only answer I have found to the pattern this
// PR keeps repeating.

struct Qt {
  w: Int
}

fn pack2[U](u: U) -> (U, Int) {
  (u, 0)
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let p = pack2(a)
    p.0 } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
