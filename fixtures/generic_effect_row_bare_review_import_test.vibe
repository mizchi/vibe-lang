// #3340: a published bare row and its exported alias carry String payloads.
import ./typecheck/generic_effect_row_bare_review_dep_ok.vibe {
  effect Box, put_string, put_string_alias
}

fn run_str(f: () -> Int with Box[String]) -> Int {
  handle {
    f()
  } with { Box::Put(s) => resume(String::length(s) + 39) }
}

test "an imported bare callback retains its String payload" {
  inspect(run_str(put_string), "42")
}

test "an imported alias retains its String payload" {
  inspect(run_str(put_string_alias), "42")
}
