// ADR-0068 `Send`: closures (captured environment, task-affine evidence)
// are NOT Send — they cannot cross a task/channel boundary as a message.
let want_send = [T: Send](x: T) -> T { x }

fn main {
  let f: () -> Int = () -> { 1 }
  let _ = want_send(f)
  ()
}

