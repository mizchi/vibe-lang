// Multi-param generic effect: Store[K, V]
effect Store[K, V] {
  Get(K) -> V;
  Set(K, V) -> Unit;
  Has(K) -> Bool
}

// String → Int store
let result = handle {
  let has = perform Store::Has("key")
  if has {
    perform Store::Get("key")
  } else {
    perform Store::Set("key", 42)
    42
  }
} with {
  Store::Get(_k) => resume(0);
  Store::Set(_k, _v) => resume(0);
  Store::Has(_k) => resume(false)
}
result

__DATA__
{"last": "42"}
