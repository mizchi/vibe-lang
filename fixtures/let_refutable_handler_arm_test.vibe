// Codex on #3628: a refutable `let` inside a resuming handler arm gets a
// generated mismatch arm, and the resume check read it as a branch ending in
// a plain value, so this valid arm was refused ("must pass its value back
// with resume(...) on every branch"). The generated arm traps, so it is not
// a branch that returns.
effect Ask {
  Get() -> Int
}

fn ask_plus_one() -> Int {
  handle {
    perform Ask::Get() + 1
  } with {
    Ask::Get() => {
      let Some(v) = Some(41)
      resume(v)
    }
  }
}

test "a refutable let inside a resuming handler arm" {
  inspect(ask_plus_one(), content = "42")
}
