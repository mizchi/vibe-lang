// #3548: interpolating a builtin call's `Option` result renders it. `vibe
// check` passed this while `vibe run` refused it in codegen ("cannot
// interpolate the result of `Int::parse`"), because the interpolation pass
// read the checker's row only for a generic renderer and left an `Option`
// row to the codegen's refusal, which `vibe check` never runs.
test "a builtin's Option result interpolates" {
  inspect("\{Int::parse("4")}", content = "Some(4)")
  inspect("\{Int::parse("x")}", content = "None")
}

test "the same result through a binding agrees" {
  let v = Int::parse("4")
  inspect("\{v}", content = "Some(4)")
}
