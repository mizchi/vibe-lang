//# #2745: a pattern binder naming the WHOLE tuple keeps its element shape.
//
// Self-probed after Codex's round 7, and fixed in the same commit. A `PBind`
// took the scrutinee's formal but not its element shape, so the tuple lost that
// shape crossing one match arm: `match (a, 1) { p => match p { (b, _) => b } }`
// with `a: T` printed `252`.
//
// The same recorder the let-forms use now carries the shape across, so the two
// routes to a named tuple -- `let p = (a, 1)` and `match (a, 1) { p => .. }` --
// answer identically. That is the point: a second route to one fact is how the
// two answers drift apart.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{match (a, 1) {
      p => match p {
        (b, _) => b
      }
    }}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
