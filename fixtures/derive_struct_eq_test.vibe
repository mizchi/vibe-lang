struct Point { x: Int; y: Int } derive (Eq)

test "derive struct eq" {
  let _start = () -> {
    let a = Point::{ x: 1, y: 2 }
    let b = Point::{ x: 1, y: 2 }
    let c = Point::{ x: 3, y: 4 }
    let mut score = 0
    if a == b {
      score = score + 1
    }
    if !(a == c) {
      score = score + 1
    }
    score
  }
  inspect(_start(), "2")
}
