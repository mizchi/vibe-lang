//# #2745: a call to a LOCAL generic lambda.
//
// Codex, P1 round 15 on #2761. Measured on `1164350`:
// `let idf = [U](u: U) -> U { u }; "\{idf(a)}"` printed a 3-digit pointer
// decimal.
//
// The call arm consulted `fn_returns`, which holds TOP-LEVEL functions, so the
// local lambda's return read as `U` -- a binder that is not in scope at the
// call site at all -- and fell to the leaf. The lambda's return formal is now
// recorded at its BINDING, with the index of the parameter it is spelled at,
// so the call answers with that argument's classification.
//
// Recorded in the same key family as everything else, which means a rebinding
// masks it and an alias inherits it: `let g = idf; g(a)` answers too, with no
// arm of its own.
//
// Round 5 closed this for a TOP-LEVEL generic (`wrap_it`). Ten rounds later the
// local spelling of the same shape was still open, which is the argument of
// #2773 in one line.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let idf = [U](u: U) -> U {
      u
    }
    "\{idf(a)}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
