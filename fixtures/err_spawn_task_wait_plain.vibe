// #3517 (P0 regression): a `TaskGroup::spawn` task runs to completion, so it
// cannot suspend. A `_wait` operation in its closure made the prepass compile
// the closure to return a step, and the scheduler called it under the plain
// convention: this program checked clean and `main` answered 1324 (a heap
// pointer, measured on the committed seed) where the task's value is 100.
// The edit is `TaskGroup::spawn_suspend`. Compiled and refused by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle, sleep_wait
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn(g, () -> {
      sleep_wait(10)
      100
    })
    TaskHandle::join(a)
  })
}
