// #1938: capture provenance survives arbitrary alias depth.
//   error_contains: "region escapes its scope"
fn build() -> () -> Array[Int] {
  region r {
    let first = MutList::empty(r)
    let second = first
    let third = second
    () -> Array[Int] {
      MutList::to_array(third)
    }
  }
}
