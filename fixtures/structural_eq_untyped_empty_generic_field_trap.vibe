//# ADR-0097 fail-closed: a NON-generic struct whose declared field reaches an
//# unsafe generic instantiation.
//#
//# `Outer` takes no type parameters, so its shape is the bare name and carries
//# no generic leaf -- nothing about the shape says anything is wrong. But
//# `Outer::equals` calls `Box::equals`, which raw-compares the field that came
//# from `T`, so two equal `Outer` values answer `false`. Measured on this
//# build: the bare `a == b`, the annotated `Array[Outer]` and a second level of
//# nesting all answer `false`, so this is #2195 reached through a field, not
//# something #2157 introduces. Which is the point: an unannotated binding must
//# not adopt the name and arrive there.
//#
//# `dtd_eq_unsafe_types` marks `Outer` (and `Deep`, on the next round of the
//# fixpoint), `adoptable_eq_name` rejects it, and `==` traps.

struct Box[T] {
  value: T
} derive (Eq)

struct Outer {
  box: Box[Array[Int]]
} derive (Eq)

export fn _start() -> Int {
  let left = []
  Array::push(left, Outer::{
    box: Box[Array[Int]]::{
      value: [1, 2]
    }
  })
  let right = []
  Array::push(right, Outer::{
    box: Box[Array[Int]]::{
      value: [1, 2]
    }
  })
  if left == right {
    1
  } else {
    0
  }
}
