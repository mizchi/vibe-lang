// #3593 controls: an imported function that throws while it runs and returns
// a struct whose field closure does not throw may be called inside a
// `handle` whose value outlives it, by name, by a renamed import or through
// a type companion. fixtures/typecheck/handle_bound_closure_exception_field_import*_reject.vibe
// hold the refusals, for a field closure that does throw.
import ./modules/handle_bound_closure_field_dep.vibe {
  Box, fallback, mk_ok, mk_ok as make_ok
}

fn by_name(n: Int) -> Int {
  let b = handle {
    mk_ok(n)
  } with { Exception[Int]::Throw(c) => fallback(c) }
  let f = b.f
  f()
}

fn by_renamed_import() -> Int {
  let b = handle {
    make_ok(4)
  } with { Exception[Int]::Throw(c) => fallback(c) }
  let f = b.f
  f()
}

fn by_companion() -> Int {
  let b = handle {
    Box::empty()
  } with { Exception[Int]::Throw(c) => fallback(c) }
  let f = b.f
  f()
}

test "an imported field closure that does not throw leaves the handle" {
  inspect(by_name(5), content = "6")
  inspect(by_name(-3), content = "-3")
  inspect(by_renamed_import(), content = "5")
  inspect(by_companion(), content = "0")
}
