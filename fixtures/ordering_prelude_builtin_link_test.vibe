// #3042 (ADR-0118): `@vibe/builtin` declares the prelude `Ordering` itself
// (lib/@vibe/builtin/ordering.vibe). A program that links it AND derives `Ord`
// must still see one enum: the library's `Less` from `int_compare` and the
// derived `compare`'s `Less` are the same constructor.

import @vibe/builtin {
  Ordering::reverse, Ordering::to_int, int_compare
}

struct P { x: Int } derive (Ord)

test "the library's Ordering and the derived one are one enum" {
  let lib = int_compare(1, 2)
  let derived = P::compare(P::{ x: 1 }, P::{ x: 2 })
  inspect(lib, "Less")
  inspect(derived, "Less")
  inspect(lib == derived, "true")
  inspect(Ordering::reverse(derived), "Greater")
  inspect(Ordering::to_int(derived), "-1")
  let label = match derived {
    Less => "less",
    Equal => "equal",
    Greater => "greater"
  }
  inspect(label, "less")
}
