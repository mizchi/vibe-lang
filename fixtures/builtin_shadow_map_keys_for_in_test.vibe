// #3132 / #3148: `for k in m` over a Map is lowered to a loop over the
// BUILTIN `Map::keys(m)`. A program may define its own `Map::keys`; its own
// calls reach it, but the lowering is a compiler-synthesized reference and
// must not. It used to be spelled as a bare name, which the builtin-shadowing
// rename captured, so the loop iterated whatever the program's function
// returned.

fn Map::keys(m: StringMap[Int]) -> Array[String] {
  let _ = m
  ["shadow"]
}

fn join_keys(m: StringMap[Int]) -> String {
  let mut out = ""
  for k in m {
    out = String::concat(out, k)
  }
  out
}

test "for over a Map iterates the builtin keys" {
  let m: StringMap[Int] = Map::from_pairs([("a", 1), ("b", 2)])
  inspect(join_keys(m), content = "ab")
}

test "the program's own call still reaches its Map::keys" {
  let m: StringMap[Int] = Map::from_pairs([("a", 1)])
  let ks: Array[String] = Map::keys(m)
  inspect(ks, content = "[shadow]")
}
