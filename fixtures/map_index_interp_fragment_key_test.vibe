fn first(xs: Array[Int]) -> Int { xs[0] }

// #3133 review: an index written inside an interpolation is parsed from the
// fragment's own tokens, and a location there is anchored at the OUTER file's
// token with the same index before it is remapped to its real place. The `[`
// key of `xs[k]` skipped that remap, so it named whatever token of the file
// had the same index. Here the fragment's `[` is its 15th token, and the 15th
// token of this file is the `[` of `xs[0]` on the first line: the Map index
// and the Array index shared one key. The key is now remapped with every other
// location inside the fragment.

type Env = StringMap[Int]

fn pick(a: Env, b: Env, c: Env, d: Env, e: Env, f: Env) -> Env {
  let _ = a
  let _ = b
  let _ = c
  let _ = d
  let _ = e
  f
}

fn render(m: Env, k: String) -> String {
  "v=\{pick(m, m, m, m, m, m)[k]}"
}

test "an index inside an interpolation keeps its own receiver type" {
  let m: Env = Map::set(Map::set(Map::new(), "a", 11), "b", 22)
  inspect(render(m, "b"), content = "v=22")
  inspect(first([4, 5, 6]), content = "4")
}
