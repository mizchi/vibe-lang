//# Misc

// #784 / Codex #785 P1 regression: interpolating a bool in a file that does NOT
// itself contain the string literals "true"/"false" must still compile. The
// bool→string path synthesizes those EString nodes during codegen, after the
// string table is collected, so the collector seeds them whenever __to_string is
// used. Asserting via String::length (not `== "true"`) keeps the literals out of
// this file's source so the seeding path is actually exercised.

test "bool interp without source literal compiles and runs" {
  assert(String::length("\{1 < 2}") == 4)
  assert(String::length("\{1 > 2}") == 5)
  assert(String::length("prefix \{5 == 5} suffix") == 18)
}

// #815: `is` expressions (all-Bool-arm match desugar) and rewritten
// structural `==` (`__arr_equals__*` / `T::equals` calls) must interpolate
// as true/false, not the raw 0/1 runtime representation.
test "is-expression interpolates as bool (#815)" {
  let opt: Option[Int] = None
  assert("\{opt is None}" == "true")
  assert("\{opt is Some(_)}" == "false")
  let b = opt is None
  assert("\{b}" == "true")
}

test "structural array equality interpolates as bool (#815)" {
  assert("\{[1, 2] == [1, 2]}" == "true")
  assert("\{[1] == [9]}" == "false")
}

test "structural inequality (not-wrap) interpolates as bool (#815)" {
  assert("\{[1, 2] != [1, 2]}" == "false")
  assert("\{[1] != [9]}" == "true")
}

test "annotated let binding interpolates as bool (#815)" {
  // The Bool annotation parses to the `((__asc: Bool) -> __asc)(e)`
  // ascription marker; the slot must be logged boolish even though the
  // wrapped value is opaque to the syntactic classifier.
  let f = (n: Int) -> Bool { n > 3 }
  let b: Bool = f(5)
  assert("\{b}" == "true")
  let c: Bool = f(1)
  assert("\{c}" == "false")
}

// #950: calls to bool-returning BUILTINS (String::contains etc.) must
// interpolate as true/false via the builtin's declared return type
// (cc_builtin_call_ret_kind), both directly and through an unannotated let
// (kind-3 slot log). Previously both printed the raw 1/0.
test "builtin bool call interpolates as bool (#950)" {
  assert("\{String::contains("hello", "ell")}" == "true")
  assert("\{String::contains("hello", "xyz")}" == "false")
  assert("\{String::starts_with("hello", "he")}" == "true")
  assert("\{String::ends_with("hello", "lo")}" == "true")
  let b = String::contains("hello", "ell")
  assert("\{b}" == "true")
  let c = String::ends_with("hello", "he")
  assert("\{c}" == "false")
}

// #950: `String::join([], sep)` returns the packed empty-string encoding 0
// (ptr 0, len 0). The __to_string runtime string-pointer heuristic requires
// ptr >= 64, so this legal empty string used to render as Int "0". The
// String-typed segment now takes the identity path (kind-2 slot log /
// declared builtin return type), so it renders as the empty string.
test "empty join interpolates as empty string (#950)" {
  let e: Array[String] = []
  let j = String::join(e, "-")
  assert(String::length(j) == 0)
  assert("[\{j}]" == "[]")
  assert("[\{String::join(e, "-")}]" == "[]")
  assert("[\{String::join(["a", "b"], "-")}]" == "[a-b]")
}
