//# #3551 review: a bare `continue` ends its statement at a newline, whatever
//# the next line opens with. A line opening with `[` or a tight prefix
//# operator used to continue the `continue` expression: `continue` then `[1]`
//# read as an index into `continue` and the build refused it ("cannot tell
//# whether this index reads a Map or an Array"). Only `(` keeps reading as
//# `continue`'s arguments.

fn skip_with_array(n: Int) -> Int {
  let mut i = 0
  let mut s = 0
  while i < n {
    i = i + 1
    if i > 1 {
      continue
      [1]
    }
    s = s + i
  }
  s
}

fn skip_with_negation(n: Int) -> Int {
  let mut i = 0
  let mut s = 0
  while i < n {
    i = i + 1
    if i > 1 {
      continue
      -1
    }
    s = s + i
  }
  s
}

fn skip_with_statement(n: Int) -> Int {
  let mut i = 0
  let mut s = 0
  while i < n {
    i = i + 1
    if i > 1 {
      continue
      let unused = 1
    }
    s = s + i
  }
  s
}

test "a line after a bare `continue` is a new statement" {
  inspect(skip_with_array(3), "1")
  inspect(skip_with_negation(3), "1")
  inspect(skip_with_statement(3), "1")
}
