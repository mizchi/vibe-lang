// Issue #10: let rec with large function body and many captured helpers
// Mimics vibe/x/markdown parse_blocks pattern

let is_zero = (n: Int) -> Bool { n == 0 }
let is_positive = (n: Int) -> Bool { n > 0 }
let is_negative = (n: Int) -> Bool { n < 0 }
let abs_val = (n: Int) -> Int { if n < 0 { 0 - n } else { n } }
let clamp = (n: Int, lo: Int, hi: Int) -> Int {
  if n < lo { lo } else if n > hi { hi } else { n }
}
let max_val = (a: Int, b: Int) -> Int { if a > b { a } else { b } }

let rec process = (items: Array[Int], idx: Int, acc: Int) -> Int {
  if idx >= Array::length(items) {
    acc
  } else {
    let item = Array::get(items, idx)

    // Use various captured helpers
    if is_zero(item) {
      process(items, idx + 1, acc)
    } else if is_positive(item) {
      let clamped = clamp(item, 0, 100)
      process(items, idx + 1, acc + clamped)
    } else if is_negative(item) {
      let absolute = abs_val(item)
      let m = max_val(absolute, 10)
      process(items, idx + 1, acc + m)
    } else {
      process(items, idx + 1, acc + item)
    }
  }
}

// Call from multiple paths
let direct = process([1, 2, 3, 0, 4], 0, 0)

let via_wrapper = ((arr: Array[Int]) -> Int {
  process(arr, 0, 0)
})([10, 20, 30])

direct + via_wrapper

__DATA__
{"last": "70"}
