//# #2745: a local generic lambda bound with `let rec`.
//
// Codex, P1 round 18 on #2761. Measured on `c0147ca`:
// `let rec idf = [U](u: U) -> U { u }` then `"\{idf(a)}"` printed a 3-digit
// pointer decimal, while the same lambda bound with plain `let` was refused.
//
// Round 15 wired the return record into `ELet` and `ELetMut` and not `ELetRec`
// -- I looked at that arm, judged a recursive generic lambda rare, and moved
// on. "Rare" is not a reason: the three let-forms are one binding construct
// spelled three ways, and a rule that holds for two of them holds for all
// three. Seeded on the RECURSIVE environment, which is the one both the value
// and the body are rewritten in.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let rec idf = [U](u: U) -> U {
      u
    }
    "\{idf(a)}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
