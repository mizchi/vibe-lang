// #3717: nonlinear integer arithmetic the solver cannot settle in time is
// `unknown`, which fails like an unproved obligation (scripts/check_prove.sh).
// Fermat's last theorem for n = 3, bounded so no product overflows. The bound
// is 10^5, not 10^6: at 10^6 z3 took 4.2 s of its 5 s to prove `b * b * b`
// does not overflow, so a loaded machine reported that as `unknown` too.

fn fermat3(a: Int, b: Int, c: Int) -> Bool where {
  requires: a > 0 && b > 0 && c > 0 && a < 100000 && b < 100000 && c < 100000,
  ensures: result,
} {
  a * a * a + b * b * b != c * c * c
}
