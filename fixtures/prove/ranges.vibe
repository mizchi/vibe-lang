// #3719: `Int::range_all` / `Int::range_any` from `@vibe/builtin` are
// quantifiers over an index range, so a contract states what an index owes
// its neighbour. The first three are proved; the last two are not.

import @vibe/builtin {
  Int::range_all, Int::range_any
}

// Sorted pairs give the first pair.
fn first_pair_sorted(xs: Array[Int]) -> Bool where {
  requires: Array::length(xs) >= 2 && Int::range_all(0, Array::length(xs) - 1, f = (i) -> xs[i] <= xs[i + 1]),
  ensures: result,
} {
  xs[0] <= xs[1]
}

// One index is the witness.
fn has_zero(xs: Array[Int]) -> Bool where {
  requires: Array::length(xs) > 2 && xs[2] == 0,
  ensures: Int::range_any(0, Array::length(xs), f = (i) -> xs[i] == 0),
} {
  true
}

// An empty range holds of anything.
fn empty_range(n: Int) -> Bool where { requires: n >= 0 && n <= 1000, ensures: result } {
  Int::range_all(n, n, f = (i) -> false)
}

// The last index reads one past the end.
fn off_by_one(xs: Array[Int]) -> Bool where { ensures: true } {
  Int::range_all(0, Array::length(xs), f = (i) -> xs[i] <= xs[i + 1])
}

// Some index is positive; the first need not be.
fn any_not_first(xs: Array[Int]) -> Int where {
  requires: Array::length(xs) > 0 && Int::range_any(0, Array::length(xs), f = (i) -> xs[i] > 0),
  ensures: result > 0,
} {
  xs[0]
}
