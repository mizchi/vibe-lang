// #3717: every obligation here is proved, so `vibe check --prove` prints
// nothing and exits 0 (scripts/check_prove.sh).

fn clamp_low(x: Int) -> Int where { requires: x > 0 - 1000000, ensures: result >= 0 } {
  if x < 0 {
    return 0
  } else {
    ()
  }
  x
}

fn add_small(a: Int, b: Int) -> Int where {
  requires: a >= 0 && a <= 1000 && b >= 0 && b <= 1000,
  ensures: result >= a,
} {
  a + b
}

// Calls are modular: `add_small`'s `requires` is owed here and its `ensures`
// assumed.
fn use_add(c: Int) -> Int where { requires: c >= 0 && c <= 10, ensures: result >= 0 } {
  add_small(a = c, b = c)
}

fn max2(a: Int, b: Int) -> Int where { ensures: result >= a && result >= b } {
  if a > b {
    a
  } else {
    b
  }
}
