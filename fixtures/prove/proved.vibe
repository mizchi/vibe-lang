// #3717: every obligation here is proved, so `vibe check --prove` prints
// nothing and exits 0 (scripts/check_prove.sh).

fn clamp_low(x: Int) -> Int where { requires: x > 0 - 1000000, ensures: result >= 0 } {
  if x < 0 {
    return 0
  } else {
    ()
  }
  x
}

fn add_small(a: Int, b: Int) -> Int where {
  requires: a >= 0 && a <= 1000 && b >= 0 && b <= 1000,
  ensures: result >= a,
} {
  a + b
}

// Calls are modular: `add_small`'s `requires` is owed here and its `ensures`
// assumed.
fn use_add(c: Int) -> Int where { requires: c >= 0 && c <= 10, ensures: result >= 0 } {
  add_small(a = c, b = c)
}

fn max2(a: Int, b: Int) -> Int where { ensures: result >= a && result >= b } {
  if a > b {
    a
  } else {
    b
  }
}

// `/` and `%` truncate toward zero, as the runtime does: `-7 / 2` is `-3`,
// so `result * 2 >= x` holds for a negative `x` (a floored quotient, `-4`,
// would break it), and a negative dividend leaves a remainder `<= 0`.
fn neg_half(x: Int) -> Int where { requires: x < 0 && x > 0 - 1000, ensures: result * 2 >= x && result <= 0 } {
  x / 2
}

fn neg_rem(x: Int) -> Int where { requires: x < 0 && x > 0 - 1000, ensures: result <= 0 && result > 0 - 3 } {
  x % 3
}

// The divisor is owed non-zero, and the code after the operator may assume it.
fn share(total: Int, n: Int) -> Int where { requires: n > 0 && total >= 0 && total <= 1000, ensures: result <= total } {
  total / n
}

// `>>` is an arithmetic shift, a FLOORED quotient: `-7 >> 2` is `-2`, so
// `result * 4 <= x` holds (a truncated `-1` would break it). `<<` by a
// constant is a multiplication.
fn quarter(x: Int) -> Int where { requires: x < 0 && x > 0 - 1000, ensures: result * 4 <= x } {
  x >> 2
}

fn times8(x: Int) -> Int where { requires: x >= 0 && x <= 1000, ensures: result == x * 8 } {
  x << 3
}

// A contracted `while` is proved by induction: the invariants hold on entry
// and after each iteration, and the measure stays non-negative and drops.
// Past the loop, the invariants hold and the condition is false.
fn count_to(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: result == n } {
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= n,
    decreases: n - i,
  } {
    i += 1
  }
  i
}

fn sum_below(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: result >= 0 } {
  let mut acc = 0
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= n && acc >= 0 && acc <= i * 1000,
    decreases: n - i,
  } {
    if i > 5 {
      acc = acc + i
    } else {
      ()
    }
    i = i + 1
  }
  acc
}

// #3717: an `Array[Int]` is read through its length and `Array::get` /
// `xs[i]`, each owing an index inside the length.
fn first_or_zero(xs: Array[Int]) -> Int where { ensures: Array::length(xs) > 0 || result == 0 } {
  if Array::length(xs) > 0 {
    xs[0]
  } else {
    0
  }
}

fn literal_reads() -> Int where { ensures: result == 23 } {
  Array::length([1, 2, 3]) + Array::get([10, 20, 30], at = 1)
}

fn last(xs: Array[Int]) -> Int where { requires: Array::length(xs) > 0, ensures: true } {
  xs[Array::length(xs) - 1]
}

fn walk(xs: Array[Int]) -> Int where { ensures: result == Array::length(xs) } {
  let mut i = 0
  while i < Array::length(xs) where {
    invariant: 0 <= i && i <= Array::length(xs),
    decreases: Array::length(xs) - i,
  } {
    if xs[i] > 0 {
      i = i + 1
    } else {
      i = i + 1
    }
  }
  i
}

// `break` leaves without a checkpoint, so the path past the loop is the
// state it broke in; `continue` runs the checkpoint again, like the end of
// the body, and owes the invariants and a smaller measure.
fn find_negative(xs: Array[Int]) -> Int where { ensures: result >= 0 - 1 && result < Array::length(xs) } {
  let mut i = 0
  let mut found = 0 - 1
  while i < Array::length(xs) where {
    invariant: 0 <= i && i <= Array::length(xs) && found == 0 - 1,
    decreases: Array::length(xs) - i,
  } {
    if xs[i] < 0 {
      found = i
      break
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn count_odd(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: result >= 0 && result <= n } {
  let mut i = 0
  let mut c = 0
  while i < n where {
    invariant: 0 <= i && i <= n && 0 <= c && c <= i,
    decreases: n - i,
  } {
    i = i + 1
    if i % 2 == 0 {
      continue
    } else {
      ()
    }
    c = c + 1
  }
  c
}

// #3717: a contracted `for` over an `Array[Int]` is proved like a `while`:
// the checkpoint holds on entry and after every iteration, one ended by
// `continue` included. Its clauses are read in the loop's scope, so they
// speak of the bindings around the loop, never the element.
fn best_of(xs: Array[Int]) -> Int where { ensures: result >= 0 } {
  let mut best = 0
  for x in xs where { invariant: best >= 0 } {
    if x > best {
      best = x
    } else {
      ()
    }
  }
  best
}

fn best_at_even(xs: Array[Int]) -> Int where { ensures: result >= 0 } {
  let mut best = 0
  for i, x in xs where { invariant: best >= 0 } {
    if i % 2 == 1 {
      continue
    } else {
      ()
    }
    if x > best {
      best = x
    } else {
      ()
    }
  }
  best
}

// A `for` measure drops on each iteration; `break` leaves without a check.
fn burn(xs: Array[Int], fuel: Int) -> Int where { requires: fuel >= 0, ensures: result >= 0 } {
  let mut f = fuel
  for x in xs where { invariant: f >= 0, decreases: f } {
    if f == 0 {
      break
    } else {
      ()
    }
    f = f - 1
  }
  f
}

// A `for` without a contract ends, and its index is below the length.
fn reread(xs: Array[Int]) -> Int where { ensures: result == 0 } {
  for i, x in xs {
    let y = xs[i]
    ()
  }
  0
}

// `loop` is a contracted `while true`; `break v` and `continue(..)` assign
// its result and its parameters.
fn countdown(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: result == 0 } {
  loop (k = n) where { invariant: k >= 0, decreases: k } {
    if k == 0 {
      break k
    } else {
      continue(k - 1)
    }
  }
}

// #3717: a local array no other name holds is written in place: an index
// write owes an index below the length and replaces that element, and
// `Array::push` appends one.
fn patched() -> Int where { ensures: result == 9 } {
  let xs = [1, 2, 3]
  xs[1] = 7
  Array::set(xs, at = 2, value = 2)
  xs[1] + xs[2]
}

fn grown(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: result == n } {
  let out = []
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= n && Array::length(out) == i,
    decreases: n - i,
  } {
    Array::push(out, value = i)
    i = i + 1
  }
  Array::length(out)
}

fn filled(xs: Array[Int]) -> Int where { ensures: result >= 0 } {
  let ys = [0, 0]
  for x in xs where { invariant: Array::length(ys) == 2 && ys[0] >= 0 } {
    if x > ys[0] {
      ys[0] = x
    } else {
      ()
    }
  }
  ys[0]
}

// A push whose value pushes too lands after it, as at runtime: `[0, 5, 2]`.
fn nested_push() -> Int where { ensures: result == 3 } {
  let xs = [0]
  Array::push(xs, value = {
    Array::push(xs, value = 5)
    2
  })
  Array::length(xs)
}

// A read sees the array as its index left it: the push makes index 1 exist.
fn index_grows() -> Int where { ensures: result == 5 } {
  let xs = [0]
  xs[{
    Array::push(xs, value = 5)
    1
  }]
}

// #3827: `Int32` / `UInt32` are 32-bit SMT words, so `+ - *` wrap and the
// bitwise operators are exact; comparisons, `/`, `%` and `>>` read the bits
// signed on `Int32` and unsigned on `UInt32`. A literal written beside a
// word is that word.
fn xor_twice(x: Int32, k: Int32) -> Int32 where { ensures: result == x } {
  (x ^ k) ^ k
}

fn wrap_top(x: Int32) -> Int where { requires: x == 2147483647, ensures: result == -2147483648 } {
  Int32::to_int(x + 1)
}

fn unsigned_wrap(x: UInt32) -> Int where { requires: x == 4294967295, ensures: result == 0 } {
  UInt32::to_int(x + 1)
}

fn wrapped_local() -> Int where { ensures: result == -2147483648 } {
  let y: Int32 = 2147483647
  Int32::to_int(y + 1)
}

fn top_bit(x: UInt32) -> Bool where { ensures: result == (UInt32::to_int(x) >= 2147483648) } {
  (x >> 31) == 1
}

fn min_over_minus_one(x: Int32) -> Int32 where { requires: x == -2147483648, ensures: result == x } {
  x / -1
}

fn signed_lt(x: Int32) -> Bool where { ensures: result == (Int32::to_int(x) < 0) } {
  x < 0
}

fn word_call(x: Int32) -> Int32 where { ensures: result == x } {
  xor_twice(x, 5)
}

// A literal passed to a conversion is the word it takes.
fn literal_words() -> Bool where { ensures: result } {
  Int32::to_int(-5) == -5 && UInt32::to_int(4294967295) == 4294967295
}

// A literal returned, in a branch, or assigned where a word is expected is
// that word.
fn word_zero_result() -> Int32 where { ensures: result == 0 } {
  0
}

fn word_branch(c: Bool, x: UInt32) -> UInt32 where { ensures: result == x || result == 7 } {
  if c {
    x
  } else {
    7
  }
}

fn word_assign() -> Int32 where { ensures: result == -3 } {
  let mut y: Int32 = 0
  y = -3
  y
}

// #3719: `Array::all` / `Array::any` with a lambda written at the call are
// quantifiers over the array's indices, so a contract can state a property
// of every element in the spelling the runtime already evaluates.
fn first_nonneg(xs: Array[Int]) -> Int where {
  requires: Array::length(xs) > 0 && Array::all(xs, f = (x) -> x >= 0),
  ensures: result >= 0,
} {
  xs[0]
}

fn has_nonneg(xs: Array[Int]) -> Bool where {
  requires: Array::length(xs) > 0 && xs[0] >= 0,
  ensures: Array::any(xs, f = (x) -> x >= 0),
} {
  true
}

fn widened(xs: Array[Int]) -> Bool where {
  requires: Array::all(xs, f = (x) -> x < 10),
  ensures: result,
} {
  Array::all(xs, f = (x) -> x < 100)
}

// The predicate's own overflow obligation is owed for every element, and
// the `requires` bounds every element.
fn succ_small(xs: Array[Int]) -> Bool where {
  requires: Array::all(xs, f = (x) -> x < 1000),
  ensures: result,
} {
  Array::all(xs, f = (x) -> x + 1 > x)
}

// A predicate with branches is the disjunction of its paths.
fn clipped(xs: Array[Int]) -> Bool where {
  requires: Array::all(xs, f = (x) -> if x > 0 {
    x < 10
  } else {
    x > 0 - 10
  }),
  ensures: result,
} {
  Array::all(xs, f = (x) -> x < 10 && x > 0 - 10)
}
