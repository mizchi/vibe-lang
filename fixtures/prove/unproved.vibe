// #3717: each function breaks one obligation, and the report names it with
// a counterexample (scripts/check_prove.sh).

// The ensures is false for every input.
fn dec(x: Int) -> Int where { requires: x > 0, ensures: result > x } {
  x - 1
}

// The ensures holds over the integers, but `x + 1` overflows the 63-bit
// `Int` at its maximum.
fn inc(x: Int) -> Int where { requires: x >= 0, ensures: result > x } {
  x + 1
}

fn half(x: Int) -> Int where { requires: x >= 0, ensures: result >= 0 } {
  x
}

// `half`'s requires is not met for a negative argument.
fn call_half(y: Int) -> Int where { ensures: result >= 0 } {
  half(x = y)
}

// The body's `let x = 0` shadows the parameter; `ensures` still reads the
// parameter, as the runtime check does, so `f(1)` breaks it.
fn shadowed(x: Int) -> Int where { ensures: result == x } {
  let x = 0
  x
}

// A `let` inside a branch ends with the branch: the final `x` is the
// parameter again, so `ensures: result == 0` fails for a nonzero argument.
fn branch_scope(x: Int) -> Int where { ensures: result == 0 } {
  let y = if true {
    let x = 0
    x
  } else {
    0
  }
  x + y
}

enum Coin {
  Heads;
  Tails(Int)
}

// `Tails` carries any `Int`, so a payload of 0 or less breaks the claim.
fn coin_value(c: Coin) -> Int where { ensures: result > 0 } {
  match c {
    Heads => 1,
    Tails(n) => n
  }
}

// A value no arm matches traps at run time: `x` is never 0 here, so the
// only arm never runs and the `match` does not cover the reachable values.
fn uncovered(x: Int) -> Int where { requires: x != 0, ensures: false } {
  match x {
    0 => 1
  }
}

// Nothing rules out `d == 0`, which aborts, nor `MIN / -1`, which leaves the
// range.
fn ratio(x: Int, d: Int) -> Int where { ensures: true } {
  x / d
}

struct Boxed {
  n: Int
}

// What a branch learns stays on that branch. Reading `p.n` bounds
// `x + MAX`, which holds where `x == 0`; assumed for every path, it would
// rule out `x = 1` and leave the `else` claim vacuous.
fn field_branch(x: Int) -> Int where { requires: x >= 0, ensures: result == 0 } {
  if x == 0 {
    let p = Boxed::{ n: x + 4611686018427387903 }
    let m = p.n
    m - m
  } else {
    1
  }
}

enum Held {
  Held(Int)
}

// The same holds for a pattern: matching `Held(m)` bounds the payload only on
// the branch that matches it.
fn pattern_branch(x: Int) -> Int where { requires: x >= 0, ensures: result == 0 } {
  if x == 0 {
    match Held(x + 4611686018427387903) {
      Held(m) => m - m
    }
  } else {
    1
  }
}

// `<<` wraps at run time, so the shift owes the overflow obligation.
fn doubled(x: Int) -> Int where { ensures: true } {
  x << 1
}

// `i <= 10` holds on entry but not after the iteration that moves `i` to 11.
fn count_up(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: true } {
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= 10,
    decreases: n - i,
  } {
    i = i + 1
  }
  i
}

// `n` does not drop, so nothing bounds the iteration count.
fn stuck(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: true } {
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= n,
    decreases: n,
  } {
    i = i + 1
  }
  i
}

// The condition assigns `i`, so `i` varies across iterations even though
// the body never touches it. The loop leaves with `i == 3`.
fn cond_step(n: Int) -> Int where { requires: n == 0, ensures: result == 0 } {
  let mut i = n
  while {
    i += 1
    i < 3
  } where {
    invariant: 0 <= i && i <= 3,
    decreases: 3 - i,
  } {
    ()
  }
  i
}

// Nothing says `xs` has two elements, and `i` may be past the end.
fn second(xs: Array[Int]) -> Int where { ensures: true } {
  xs[1]
}

fn get_at(xs: Array[Int], i: Int) -> Int where { requires: i >= 0, ensures: true } {
  Array::get(xs, at = i)
}

// A `continue` that skips the step leaves the measure where it was.
fn stall(n: Int) -> Int where { requires: n >= 0 && n <= 1000, ensures: true } {
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= n,
    decreases: n - i,
  } {
    if i == 3 {
      continue
    } else {
      ()
    }
    i = i + 1
  }
  i
}

// The element may be negative, so the invariant does not survive.
fn last_of(xs: Array[Int]) -> Int where { ensures: true } {
  let mut last = 0
  for x in xs where { invariant: last >= 0 } {
    last = x
  }
  last
}

// Without an invariant, nothing is known of what the body assigns.
fn plain(xs: Array[Int]) -> Int where { ensures: result == 0 } {
  let mut n = 0
  for x in xs {
    n = 0
  }
  n
}

// A `continue` that skips the step leaves the measure where it was.
fn idle(xs: Array[Int], fuel: Int) -> Int where { requires: fuel >= 0, ensures: true } {
  let mut f = fuel
  for x in xs where { invariant: f >= 0, decreases: f } {
    if x > 0 {
      continue
    } else {
      ()
    }
    if f == 0 {
      break
    } else {
      ()
    }
    f = f - 1
  }
  f
}

// The loop's measure does not drop when `k` is negative.
fn wander(n: Int) -> Int where { requires: n <= 1000, ensures: true } {
  loop (k = n) where { invariant: k <= 1000, decreases: k } {
    if k == 0 {
      break k
    } else {
      continue(k - 1)
    }
  }
}

// #3717: the write is past the end.
fn past_end() -> Int where { ensures: true } {
  let xs = [1, 2]
  xs[2] = 5
  0
}

// The element was overwritten.
fn overwritten() -> Int where { ensures: result == 1 } {
  let xs = [1, 2]
  xs[0] = 3
  xs[0]
}

// A loop that pushes and says nothing of the length knows nothing of it.
fn length_kept(n: Int) -> Int where { requires: n >= 1 && n <= 10, ensures: result == 0 } {
  let out = []
  let mut i = 0
  while i < n where { invariant: 0 <= i && i <= n, decreases: n - i } {
    Array::push(out, value = 1)
    i = i + 1
  }
  Array::length(out)
}

// The value writes `xs[1]` before the outer write lands; it holds 7.
fn nested_write() -> Int where { ensures: result == 0 } {
  let xs = [0, 0]
  Array::set(xs, at = 0, value = {
    xs[1] = 7
    1
  })
  xs[1]
}

// The index writes `xs[0]` before the read; it reads 7.
fn read_after_index_write() -> Int where { ensures: result == 0 } {
  let xs = [0]
  Array::get(xs, at = {
    xs[0] = 7
    0
  })
}

// #3827: `x + 1` wraps at `Int32`'s maximum.
fn word_next(x: Int32) -> Int32 where { ensures: result > x } {
  x + 1
}

// The local's `+ 1` wraps to the minimum, which is not positive.
fn word_local_wraps(x: Int) -> Int where { ensures: result > 0 } {
  let y: Int32 = 2147483647
  Int32::to_int(y + 1)
}

fn word_udiv(x: UInt32, d: UInt32) -> UInt32 where { ensures: true } {
  x / d
}

// A `UInt32` above 2^31 - 1 is not below it.
fn word_unsigned_low(x: UInt32) -> Bool where { ensures: result } {
  x < 2147483648
}

// The checker joins the branches at `Int32`, so the literal branch's `y + 1`
// wraps to the minimum and the comparison is false.
fn word_join(c: Bool, x: Int32) -> Bool where { requires: !c, ensures: result } {
  let y = if c {
    x
  } else {
    2147483647
  }
  y + 1 > y
}

// #3719: nothing says every element is non-negative.
fn claims_nonneg(xs: Array[Int]) -> Int where { ensures: Array::all(xs, f = (x) -> x >= 0) } {
  0
}

// Some element is non-negative; the first need not be.
fn any_is_not_first(xs: Array[Int]) -> Int where {
  requires: Array::length(xs) > 0 && Array::any(xs, f = (x) -> x >= 0),
  ensures: result >= 0,
} {
  xs[0]
}

// `x + 1` overflows at the largest `Int`, whichever element holds it.
fn succ_any(xs: Array[Int]) -> Bool where { ensures: true } {
  Array::all(xs, f = (x) -> x + 1 > x)
}

// #3717: a struct counterexample names its fields, so it reads as the
// argument a call would pass.
fn boxed_positive(b: Boxed) -> Int where { ensures: result > 0 } {
  b.n
}

// #3719: each push adds a 1, which breaks the quantified invariant on the
// first iteration, so it is not kept.
fn not_all_zero(n: Int) -> Int where { requires: n >= 1 && n <= 100, ensures: true } {
  let xs: Array[Int] = []
  let mut i = 0
  while i < n where {
    invariant: 0 <= i && i <= n && Array::length(xs) == i && Array::all(xs, f = (x) -> x == 0),
    decreases: n - i,
  } {
    Array::push(xs, value = 1)
    i = i + 1
  }
  0
}
