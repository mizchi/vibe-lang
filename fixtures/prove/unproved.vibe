// #3717: each function breaks one obligation, and the report names it with
// a counterexample (scripts/check_prove.sh).

// The ensures is false for every input.
fn dec(x: Int) -> Int where { requires: x > 0, ensures: result > x } {
  x - 1
}

// The ensures holds over the integers, but `x + 1` overflows the 63-bit
// `Int` at its maximum.
fn inc(x: Int) -> Int where { requires: x >= 0, ensures: result > x } {
  x + 1
}

fn half(x: Int) -> Int where { requires: x >= 0, ensures: result >= 0 } {
  x
}

// `half`'s requires is not met for a negative argument.
fn call_half(y: Int) -> Int where { ensures: result >= 0 } {
  half(x = y)
}

// The body's `let x = 0` shadows the parameter; `ensures` still reads the
// parameter, as the runtime check does, so `f(1)` breaks it.
fn shadowed(x: Int) -> Int where { ensures: result == x } {
  let x = 0
  x
}

// A `let` inside a branch ends with the branch: the final `x` is the
// parameter again, so `ensures: result == 0` fails for a nonzero argument.
fn branch_scope(x: Int) -> Int where { ensures: result == 0 } {
  let y = if true {
    let x = 0
    x
  } else {
    0
  }
  x + y
}
