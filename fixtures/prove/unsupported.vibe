// #3717: a construct outside the provable fragment is reported, never
// skipped (scripts/check_prove.sh).

fn sum_to(n: Int) -> Int where { requires: n >= 0, ensures: result >= 0 } {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + i
    i = i + 1
  }
  acc
}

fn first(xs: Array[Bool]) -> Int where { ensures: result >= 0 } {
  0
}

// Mutual recursion: each would assume the other's `ensures: false` and so
// "prove" its own. Both are refused instead.
fn ping(x: Int) -> Int where { ensures: false } {
  pong(x = x)
}

fn pong(x: Int) -> Int where { ensures: false } {
  ping(x = x)
}

// A callee without a contract is not assumed to return: this helper never
// does, so `calls_helper` would otherwise be "proved".
fn spin(x: Int) -> Int {
  while true {
    ()
  }
  x
}

fn calls_helper(x: Int) -> Int where { ensures: result == 0 } {
  let _ = spin(x = x)
  0
}

enum Holder[T] {
  Held(T)
}

// A generic enum is not a datatype of the fragment yet.
fn held(h: Holder[Int]) -> Int where { ensures: true } {
  0
}

struct Odd {
  n: Int
}

fn Odd::equals(a: Odd, b: Odd) -> Bool {
  false
}

// `==` runs `Odd::equals`, which the prover does not read, so a claim
// through it is not proved structurally.
fn same(p: Odd) -> Bool where { ensures: result } {
  p == p
}

// A shift by a count that is not a constant from 0 to 62 answers irregularly
// at run time (`1 << 63` is 0), so it is not encoded.
fn shift_by(x: Int, k: Int) -> Int where { ensures: true } {
  x << k
}

// A clause that returns leaves the function at run time, with a value no
// `ensures` is checked against.
fn leaves(x: Int) -> Bool where { ensures: !result } {
  while false where {
    invariant: {
      return true
    },
    decreases: 0,
  } {
    ()
  }
  false
}

// Arrays are read, not compared: their contents past the length are not
// modelled.
fn same_arrays(a: Array[Int], b: Array[Int]) -> Bool where { ensures: true } {
  a == b
}

// A program may define its own `Array::length`, and a direct call reaches it;
// with no contract, the call cannot be checked modularly.
fn Array::length(xs: Array[Int]) -> Int {
  77
}

fn own_length() -> Int where { ensures: result == 1 } {
  Array::length([0])
}

// #3717: a write is admitted only on a local array no other name holds. A
// parameter's caller would see it.
fn param_write(xs: Array[Int]) -> Int where { ensures: true } {
  Array::push(xs, value = 1)
  0
}

// `ys` is a second name for the array.
fn aliased() -> Int where { ensures: result == 1 } {
  let xs = [1]
  let ys = xs
  xs[0] = 2
  ys[0]
}

// A `for` reads its iterand as the body writes it.
fn iterated() -> Int where { ensures: true } {
  let xs = [1]
  for x in xs {
    Array::push(xs, value = x)
  }
  0
}

// Two bindings of the name.
fn rebound() -> Int where { ensures: true } {
  let xs = [1]
  let xs = [2]
  xs[0] = 3
  0
}

// #3827: `Int::to_int32` answers an `Option`, which is not modelled.
fn checked_word(x: Int) -> Int where { ensures: true } {
  match Int::to_int32(x) {
    Some(_) => 1,
    None => 0
  }
}

// #3719: a quantified predicate is a lambda written at the call.
fn is_pos(x: Int) -> Bool where { ensures: result == (x > 0) } {
  x > 0
}

fn named_pred(xs: Array[Int]) -> Bool where { ensures: true } {
  Array::all(xs, f = is_pos)
}

// A call inside the predicate has one fresh result, not one per element.
fn called_pred(xs: Array[Int]) -> Bool where { ensures: true } {
  Array::all(xs, f = (x) -> is_pos(x))
}

// A predicate that assigns what it captures.
fn counting_pred(xs: Array[Int]) -> Int where { ensures: true } {
  let mut n = 0
  let _ = Array::all(xs, f = (x) -> {
    n = n + 1
    x > 0
  })
  n
}
