// #3717: a construct outside the provable fragment is reported, never
// skipped (scripts/check_prove.sh).

fn sum_to(n: Int) -> Int where { requires: n >= 0, ensures: result >= 0 } {
  let mut acc = 0
  let mut i = 0
  while i < n {
    acc = acc + i
    i = i + 1
  }
  acc
}

fn first(xs: Array[Int]) -> Int where { ensures: result >= 0 } {
  0
}

// Mutual recursion: each would assume the other's `ensures: false` and so
// "prove" its own. Both are refused instead.
fn ping(x: Int) -> Int where { ensures: false } {
  pong(x)
}

fn pong(x: Int) -> Int where { ensures: false } {
  ping(x)
}

// A callee without a contract is not assumed to return: this helper never
// does, so `calls_helper` would otherwise be "proved".
fn spin(x: Int) -> Int {
  while true {
    ()
  }
  x
}

fn calls_helper(x: Int) -> Int where { ensures: result == 0 } {
  let _ = spin(x)
  0
}

enum Holder[T] {
  Held(T)
}

// A generic enum is not a datatype of the fragment yet.
fn held(h: Holder[Int]) -> Int where { ensures: true } {
  0
}

struct Odd {
  n: Int
}

fn Odd::equals(a: Odd, b: Odd) -> Bool {
  false
}

// `==` runs `Odd::equals`, which the prover does not read, so a claim
// through it is not proved structurally.
fn same(p: Odd) -> Bool where { ensures: result } {
  p == p
}

// A shift by a count that is not a constant from 0 to 62 answers irregularly
// at run time (`1 << 63` is 0), so it is not encoded.
fn shift_by(x: Int, k: Int) -> Int where { ensures: true } {
  x << k
}

// A clause that returns leaves the function at run time, with a value no
// `ensures` is checked against.
fn leaves(x: Int) -> Bool where { ensures: !result } {
  while false where {
    invariant: {
      return true
    },
    decreases: 0,
  } {
    ()
  }
  false
}
