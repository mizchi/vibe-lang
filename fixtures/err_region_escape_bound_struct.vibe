struct BoundSlot {
  callback: () -> Array[Int]
}

test "bound nominal values preserve field provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    let slot = BoundSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }
    slot
  }
  let _ = escaped.callback()
}
