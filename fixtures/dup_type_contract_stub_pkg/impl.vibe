// #3036 (Codex on #3076): this sibling already has the contract's `Err`
// through the generated stub, and imports dup_type_b_dep_ok's different
// `Err { name: String }` beside it. With the stub exempt, the external `Err`
// silently shadowed the contract's: `make` compiled against it, and a caller
// reading the contract's `e.code` got a string's pointer back.
import ../typecheck/dup_type_b_dep_ok.vibe { Err }

export fn make() -> Err {
  Err::{ name: "x" }
}
