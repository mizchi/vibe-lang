// #1725 / ADR-0090: a region value may not escape inside a CLOSURE either.
//   error_contains: "region escapes its scope"
// (gate-only fixture: not *_test.vibe -- wired into compiler_gate.sh's
// ADR-0090 section, section 75.)
//
// The result type here is `() -> Array[Int]`, which mentions no region
// skolem -- types do not record captures -- so the return-position escape
// check that err_region_escape_return_value.vibe pins cannot see this. The
// taint sits in the closure's captured environment. Harmless while MutList
// is a checker-only phantom; a use-after-free the moment ADR-0090's arena +
// watermark release lands, and the silent-wrong kind of unsafe (reading
// freed memory does not reliably trap).
enum Unused {
  U0
}

fn build() -> () -> Array[Int] {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, 7)
    MutList::push(l, 8)
    () -> Array[Int] {
      MutList::to_array(l)
    }
  }
}
