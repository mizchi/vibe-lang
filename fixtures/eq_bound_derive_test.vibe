// #2523 / ADR-0097: a `[T: Eq]` bound compares a `derive (Eq)` struct by
// CONTENT, and every scalar too.
//
// Both routes used to end badly. `derive (Eq)` alone did not satisfy the bound
// (``no impl `Eq` for `Pt` ``), and adding `impl Eq for Pt` replaced that error
// with reference identity -- measured on the production linear/RC lane, two
// EQUAL distinct `Pt` answered `false` and the same object answered `true`,
// while `p1 == p2` at a concrete site and `Pt::equals(p1, p2)` both answered
// `true`. The comparator existed; the bound never reached it, because the
// prelude's `Eq` was a MARKER trait with no method to dispatch through.
//
// It carries `equals(Self, Self) -> Bool` now: the checker registers it
// method-bearing, the lowering injects the same signature when a program
// actually carries an `Eq` bound, and `derive (Eq)` registers `impl Eq for T`
// the way `derive (Hash)` already did.
//
// `Double` is here deliberately. It carries a marker impl like the other four
// scalars, so #2612's guard admitted it while the erased comparison read the
// BOX rather than the number: `bare(1.5, 1.5)` answered `false` (#2895).
// Through a real witness it answers `true`.

struct Pt {
  v: Int
} derive (Eq)

fn bare[T: Eq](x: T, y: T) -> Bool {
  x == y
}

fn b2s(_ b: Bool) -> String {
  if b {
    "t"
  } else {
    "f"
  }
}

test "a bounded == at a derived struct compares by content" {
  let p1 = Pt::{ v: 1 }
  let p2 = Pt::{ v: 1 }
  let p3 = Pt::{ v: 2 }
  inspect(String::concat(b2s(bare(x = p1, y = p2)), String::concat(b2s(bare(x = p1, y = p1)), b2s(bare(x = p1, y = p3)))), "ttf")
}

test "a bounded == at each scalar is right, Double included" {
  let rows = [
    b2s(bare(x = 1, y = 1)),
    b2s(bare(x = 1, y = 2)),
    b2s(bare(x = "a", y = "a")),
    b2s(bare(x = "a", y = "b")),
    b2s(bare(x = true, y = true)),
    b2s(bare(x = true, y = false)),
    b2s(bare(x = 1.5, y = 1.5)),
    b2s(bare(x = 1.5, y = 2.5)),
    b2s(bare(x = 0.0, y = 0.0)),
    b2s(bare(x = 'x', y = 'x')),
    b2s(bare(x = 'x', y = 'y'))
  ]
  inspect(String::join(rows, sep = ""), "tftftftfttf")
}

// #3008: a `derive (Eq)` GENERIC struct through the bound. Its derived
// `equals` is generated once with the formal erased, so the witness compared a
// `Box[Double]` / `Box[Pt]` / `Box[Array[Int]]` field by reference (`false` for
// equal values) while the direct `==` answered `true`. The witness for a
// concrete instantiation is now the per-instantiation comparator the direct
// `==` uses (#2195).
struct GBox[T] {
  v: T
} derive (Eq)

test "a bounded == at a generic derived struct compares by content" {
  let rows = [
    b2s(bare(x = GBox::{ v: 1 }, y = GBox::{ v: 1 })),
    b2s(bare(x = GBox::{ v: "a" }, y = GBox::{ v: "a" })),
    b2s(bare(x = GBox::{ v: 1.5 }, y = GBox::{ v: 1.5 })),
    b2s(bare(x = GBox::{ v: 1.5 }, y = GBox::{ v: 2.5 })),
    b2s(bare(x = GBox::{ v: Pt::{ v: 1 } }, y = GBox::{ v: Pt::{ v: 1 } })),
    b2s(bare(x = GBox::{ v: [1] }, y = GBox::{ v: [1] })),
    b2s(bare(x = GBox::{ v: [1] }, y = GBox::{ v: [2] }))
  ]
  inspect(String::join(rows, sep = ""), "tttfttf")
}
