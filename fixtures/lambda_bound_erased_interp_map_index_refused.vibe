//# #2745: the `m["k"]` spelling of a map read.
//
// Found by probing the neighbour of round 26's `Map::get` report, in the same
// commit. Measured on `3913a8a`: `{ let m = Map::set(Map::new(), "k", a);
// m["k"] }` printed a 3-digit pointer decimal too.
//
// `__index` WAS already named -- and it read an ARRAY's element key, which a
// map binding never filled, so naming the operation was not the same as
// answering for it. The map binding now records its value under that same key,
// which is what makes both spellings answer alike.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let m = Map::set(Map::new(), "k", a)
    m["k"] } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
