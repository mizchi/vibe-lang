// Scenario 6: a user effect's arm cannot drop the continuation.
//
// A tail-resumptive arm hands its value back with `resume(..)`; the handled
// body then continues with it. Writing the bare value (`Abort::Stop => -1`)
// used to mean the same thing silently and read like an abort; since #2969 it
// is refused (fixtures/typecheck/handler_arm_bare_tail_value_reject.vibe), so
// the arm says what it does.

effect Abort {
  Stop -> Int
}

// x = -1, x + 100 = 99

test "effect handle resumes, it does not drop the continuation" {
  let result = handle {
    let x = perform Abort::Stop
    x + 100
  } with { Abort::Stop => resume(-1) }
  inspect(result, "99")
}
