// Scenario 6: Handle arm without explicit resume

// In tail-resumptive runtime, the arm's return value IS the resume value.

// So `Abort::Stop => -1` behaves like `Abort::Stop => resume(-1)`.

effect Abort {
  Stop -> Int
}

// x = -1, x + 100 = 99

test "effect handle drop continuation" {
  let result = handle {
    let x = perform Abort::Stop
    x + 100
  } with { Abort::Stop => -1 }
  inspect(result, "99")
}
