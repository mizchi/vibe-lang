// #3523: an `Async` entry that calls an `Async` closure of its own, with no
// `sleep` and no host future anywhere in the program. The entry had no
// boundary handler then, so the closure, step-compiled for `Async`, handed
// its step object back as the value: `r` was 1044 where 5 is right. The
// entry now gets the suspend-class boundary whenever it reaches an `Async`
// function itself. Executed by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh (want 5).
import @vibe/concurrent/experimental {
  sleep_wait
}

fn main() -> Int allows Async {
  let f = () -> Int with Async {
    sleep_wait(1)
    5
  }
  f()
}
