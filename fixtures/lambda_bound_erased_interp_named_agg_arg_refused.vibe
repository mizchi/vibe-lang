//# #2745: an aggregate argument reached through a NAME.
//
// Codex, P1 round 23 on #2761. Measured on `c799c16`:
// `fn fst[U](p: (U, Int)) -> U` called as `let p = (a, 0); fst(p)` printed a
// 3-digit pointer decimal, while the inline `fst((a, 0))` spelling -- fixed one
// round earlier -- was refused.
//
// Round 22 taught the argument scan to look INSIDE an aggregate written at the
// site and stopped there, so a name classified as "" (a tuple is not itself a
// formal) and the elements the binding had already recorded were never
// consulted. Written and named are one question, and the recorder had written
// the answer down: the scan now reads the slots.
//
// This is the fourth time in this PR that closing a route for a literal left
// its bound spelling open (rounds 15, 17, 21, 23), which is the argument of
// #2773 stated as a count rather than an opinion.

struct Qt {
  w: Int
}

fn fst[U](p: (U, Int)) -> U {
  p.0
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let p = (a, 0)
    fst(p) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
