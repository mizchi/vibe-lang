// #2872 case (1): a bodyless `impl` of a method-bearing trait, where there is
// no `<Type>::<method>` of ANY kind to fall back to, is refused at build time
// with a message that LEADS with the edit.
//
// `Int::hello` is neither a user function nor a builtin, so the witness
// dictionary for `Int` was left with a hole and the call site was emitted one
// argument short. Measured against a stage2 built from main at 3017a67:
//
//   vibe check -> clean, exit 0
//   run        -> viberun: from_file: failed to compile: wasm[0]::function[4]
//
// The wasm VALIDATOR rejected the module, after `vibe check` certified it --
// AGENTS.md names exactly that shape (型検査を通り抜けて codegen で初めて落ちる)
// as evidence an implementation detail is leaking into the language.
//
// Refused, not answered: there is nothing to answer WITH. The GREEN side --
// a bodyless impl whose fallback DOES resolve, to a builtin or to a derived
// user function -- is `fixtures/bodyless_impl_witness_test.vibe`.

trait Greet {
  hello(Self) -> Int
}

impl Greet for Int

fn call_it[T: Greet](x: T) -> Int {
  T::hello(x)
}

export fn main() -> Int {
  call_it(7)
}
