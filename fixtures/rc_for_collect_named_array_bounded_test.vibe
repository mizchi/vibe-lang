// #3219: a collected for result owns each borrowed element it pushes, while
// the named input array still releases its own storage after the loop.
fn one_round(_ n: Int) -> Int {
  let xs = [[n], [n + 1]]
  let ys = for x in xs { x }
  Array::get(Array::get(ys, at = 0), at = 0) + Array::get(Array::get(ys, at = 1), at = 0)
}
export fn main() -> Int {
  let mut i = 0
  let mut sum = 0
  while i < 2000 {
    sum = sum + one_round(i)
    i = i + 1
  }
  sum
}
