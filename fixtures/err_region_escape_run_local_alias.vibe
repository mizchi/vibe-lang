// #3155: a local `let` alias of `TaskGroup::run` keeps its region-escape
// check. Returning the group's own `TaskHandle` out of the body through the
// alias is refused exactly like the literal spelling
// (err_region_escape_return.vibe) and the renamed import
// (err_region_escape_run_rename.vibe); region_ok_run_local_alias.vibe is the
// alias used legally.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Unit allows Exception {
  let nursery = TaskGroup::run
  let h = nursery((g) -> TaskGroup::spawn(g, () -> 41))
  let _v = TaskHandle::join(h)
  ()
}
