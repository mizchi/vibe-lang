// #3287: `same_opt` receives `T` nested in `Option[T]`, so each call has to
// read `T` from an argument to pass the `Eq` witness. A generic call's result
// declares only its formal, so nothing here says what `T` is. The build names
// the edit -- bind the argument with an annotation -- instead of emitting the
// call short its dictionary, which fails wasm validation.
fn same_opt[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  a == b
}

fn ident[A](x: A) -> A {
  x
}

export let _start: () -> Int = () -> {
  if same_opt(ident(Some(1.5)), ident(Some(1.5))) {
    1
  } else {
    0
  }
}
