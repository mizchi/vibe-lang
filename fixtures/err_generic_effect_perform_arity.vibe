// #1340 (ADR-0071): THE #1218 hole. A generic effect used to skip
// registration entirely (checker_stmt.vibe registered only zero-param
// effects), so this 3-argument perform against a 0-arity operation
// compiled silently. Generic effects now register with their type params
// and every perform is checked against the instantiated signature.
effect State[S] {
  Get() -> S;
  Put(S) -> Unit
}

let main = () -> Int with State {
  perform State::Get(1, 2, 3)
}
