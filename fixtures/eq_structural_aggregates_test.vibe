// #672 / #683: structural ==/!= over aggregates, runtime-verified on BOTH
// backends. Covers the shapes the landed #672 support handles: comparisons
// where AT LEAST ONE side is a tuple / ctor literal (the structural
// comparator needs a statically-known shape). Run on the wasm-gc lane via
//   VIBE_TEST_CLI_WASM=<stage2> VIBE_TEST_BACKEND=gc \
//     bash scripts/vibe_test.sh fixtures/eq_structural_aggregates.vibe
// (the gc selfbuild gate does exactly this — scripts/test_gc_selfbuild.sh).
//
// #724 (rounds 1+2 landed): `a == b` compares structurally when either
// side's shape is statically known — let-bound aggregate literals (round
// 1: per-slot shape log), `let a = f(..)` via f's DECLARED return type,
// and signature/annotation-typed params (round 2: agg_ret table +
// param seeding; enum-typed values use a runtime argc@4 walk since the
// variant is dynamic). REMAINING GAP: match binds, unannotated shapes,
// and NESTED aggregate elements inside a structural walk still fall back
// to the generic runtime `eq` (pointer compare for aggregates).

struct PtEq {
  px: Int;
  py: String
}

enum ShapeEq {
  SCircleEq(Int);
  SRectEq(Int, Int);
  SEmptyEq
}

let mk_pt: (Int, String) -> PtEq = (a, b) -> {
  PtEq::{ px: a, py: b }
}

let pt_eq_param: (PtEq, PtEq) -> Int = (p, q) -> {
  if p == q {
    1
  } else {
    0
  }
}

let mk_shape: (Int) -> ShapeEq = (n) -> {
  if n == 0 {
    SEmptyEq
  } else if n == 1 {
    SCircleEq(7)
  } else {
    SRectEq(3, 4)
  }
}

test "tuple structural eq (literal one side)" {
  let a = (1, "x", 2)
  assert(a == (1, "x", 2))
  assert(a != (1, "y", 2))
  assert((1, "x", 2) == a)
}

test "tuple structural eq (both sides bound, #724)" {
  let a = (1, "x", 2)
  let b = (1, "x", 2)
  let c = (1, "y", 2)
  assert(a == b)
  assert(a != c)
  let alias = a
  assert(alias == b)
}

test "ctor structural eq (both sides bound, #724)" {
  let a = SRectEq(3, 4)
  let b = SRectEq(3, 4)
  let c = SRectEq(3, 5)
  let e1 = SEmptyEq
  let e2 = SEmptyEq
  assert(a == b)
  assert(a != c)
  assert(a != e1)
  assert(e1 == e2)
}

test "record structural eq (both sides bound, #724)" {
  let a = PtEq::{ px: 5, py: "p" }
  let b = PtEq::{ py: "p", px: 5 }
  let c = PtEq::{ px: 5, py: "q" }
  assert(a == b)
  assert(a != c)
}

// NOTE: whole-value comparison of NESTED aggregates (`a == ((1,2),("s",3))`)
// is also part of the known gap above — the structural walk compares
// nested elements through the generic runtime `eq` (pointer compare).
// Compare the inner aggregates one level at a time instead.
test "nested tuple structural eq via projections" {
  let a = ((1, 2), ("s", 3))
  assert(a.0 == (1, 2))
  assert(a.1 == ("s", 3))
  assert(a.0 != (1, 9))
}

test "struct value from a call vs record literal" {
  let a = mk_pt(5, "p")
  assert(a == PtEq::{ px: 5, py: "p" })
  assert(a != PtEq::{ px: 5, py: "q" })
}

test "payload ctor structural eq" {
  let a = mk_shape(2)
  let b = SRectEq(3, 4)
  let c = SRectEq(3, 5)
  assert(a == b)
  assert(a != c)
}

test "nullary ctor eq and cross-variant neq" {
  assert(mk_shape(0) == SEmptyEq)
  assert(mk_shape(1) != SEmptyEq)
  assert(mk_shape(1) == SCircleEq(7))
  assert(mk_shape(1) != SCircleEq(8))
}

test "option structural eq (scalar payload, literal one side)" {
  let a = Some(41)
  assert(a == Some(41))
  assert(a != Some(42))
  assert(a != None)
  let s = Some("k")
  assert(s == Some("k"))
  assert(s != Some("j"))
}

test "call-result structural eq via declared return types (#724)" {
  let a = mk_pt(5, "p")
  let b = mk_pt(5, "p")
  let c = mk_pt(6, "p")
  assert(a == b)
  assert(a != c)
  let s1 = mk_shape(2)
  let s2 = mk_shape(2)
  let s3 = mk_shape(1)
  let s4 = mk_shape(0)
  let s5 = mk_shape(0)
  assert(s1 == s2)
  assert(s1 != s3)
  assert(s4 == s5)
  assert(s3 != s4)
}

test "param structural eq via signature types (#724)" {
  assert_eq(pt_eq_param(mk_pt(9, "z"), mk_pt(9, "z")), 1)
  assert_eq(pt_eq_param(mk_pt(9, "z"), mk_pt(9, "w")), 0)
}

test "eq result feeds control flow" {
  let xs = [mk_shape(0), mk_shape(1), mk_shape(2)]
  let mut hits = 0
  for s in xs {
    if s == SCircleEq(7) {
      hits = hits + 1
    } else {
      0
    }
  }
  assert_eq(hits, 1)
}
