// #1081 step 3: a `TaskGroup::run` body must not return a value that still
// depends on its own region -- here the raw `TaskHandle[r, Int]` obtained
// inside the nursery. Must be a STATIC error (region escapes its scope),
// not merely a runtime concern.
import @vibe/concurrent { TaskGroup }

fn main() -> Unit with Exception {
  let _r = TaskGroup::run((n) -> {
    TaskGroup::spawn(n, () -> { 1 })
  })
  ()
}
