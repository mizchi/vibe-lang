// #2066: a vibe `String` is bytes, but a WIT `string` is UTF-8. The argument
// crosses the boundary unchanged, and the canonical ABI refuses a sequence
// that is not UTF-8 with the byte offset it failed at, so the call fails
// closed rather than delivering a different string. `String::from_byte` also
// pins #3136: before it, this entry did not compile ("this handle cannot see
// what one call in its body performs"), because the purity table matched
// `from_byte` by its spelling and not as the `from_char_code` builtin it
// aliases. Compiled and executed (and refused at run time) by
// scripts/test_wit_async_import_component_gate.sh.
import ./client_bindings.vibe {
  fetch
}

let run: () -> Int with Async = () -> {
  let bad = String::concat("ab", String::from_byte(255))
  let r = await(fetch(bad))
  HostResponse::status(r)
}
