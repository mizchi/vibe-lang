//# Types

enum Color {
  Red;
  Green;
  Blue
} derive(Eq)

struct Point {
  x: Int; y: Int
} derive(Eq)

//# Functions

fn run() -> Int {
  0
}

//# Misc

test "to_string_zero" {
  assert(__to_string(0) == "0")
}

test "to_string_positive" {
  assert(__to_string(42) == "42")
}

test "to_string_negative" {
  assert(__to_string(-7) == "-7")
}

test "to_string_large" {
  assert(__to_string(999999) == "999999")
}

test "to_string_string_passthrough" {
  assert(__to_string("hello") == "hello")
}

test "map_empty_keys" {
  let m = {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
  assert(Array::length(Map::keys(m)) == 0)
}

test "map_set_get" {
  let m = Map::from_pairs([("a", 1)])
  assert(Map::get(m, "a") == 1)
}

test "map_builder_set" {
  let b = MapBuilder::new()
  MapBuilder::set(b, "x", 10)
  MapBuilder::set(b, "y", 20)
  let m = MapBuilder::freeze(b)
  assert(Map::get(m, "x") == 10)
  assert(Map::get(m, "y") == 20)
}

test "map_has_key" {
  let m = Map::from_pairs([("a", 1)])
  assert(Map::has_key(m, "a"))
  assert(not(Map::has_key(m, "z")))
}

test "string_eq_if" {
  let s = "hello"
  if s == "hello" {
    assert(true)
  } else {
    assert(false)
  }
}

test "string_neq_if" {
  let s = "hello"
  if s != "world" {
    assert(true)
  } else {
    assert(false)
  }
}

test "string_eq_while" {
  let arr = ["a", "b", "c"]
  let found = Array::any(arr, x -> x == "b")
  assert(found)
}

test "or_pattern_int" {
  let r = match 2 {
    1|2|3 => true,
    _ => false
  }
  assert(r)
}

test "or_pattern_int_miss" {
  let r = match 5 {
    1|2|3 => true,
    _ => false
  }
  assert(not(r))
}

test "or_pattern_ctor" {
  let r = match Some(3) {
    Some(1)|Some(2)|Some(3) => true,
    _ => false
  }
  assert(r)
}

test "or_pattern_ctor_miss" {
  let r = match Some(9) {
    Some(1)|Some(2)|Some(3) => false,
    _ => true
  }
  assert(r)
}

test "match_string_pattern" {
  let r = match "hello" {
    "hello" => 1,
    "world" => 2,
    _ => 0
  }
  assert(r == 1)
}

test "match_string_pattern_miss" {
  let r = match "foo" {
    "hello" => 1,
    "world" => 2,
    _ => 0
  }
  assert(r == 0)
}

test "tuple_destructure" {
  let (a, b) = (10, 20)
  assert(a + b == 30)
}

test "nested_tuple_destructure" {
  let (a, (b, c)) = (1, (2, 3))
  assert(a + b + c == 6)
}

test "record_destructure" {
  let r = record {
    x: 10,
    y: 20
  }
  let record {
    x: a,
    y: b
  } = r
  assert(a + b == 30)
}

test "throw_handle" {
  let fail_fn: () -> Int with Exception = () -> {
    throw("error")
  }
  let r = handle {
    fail_fn()
  } with {
    Exception::Throw(_) => 42
  }
  assert(r == 42)
}

test "interp_var" {
  let x = 42
  let msg = "val: \{x}"
  assert(msg == "val: 42")
}

test "interp_expr" {
  let msg = "sum: \{add(1, 2)}"
  assert(msg == "sum: 3")
}

test "array_reverse" {
  let r = Array::reverse([
    1,
    2,
    3
  ])
  assert(Array::get(r, 0) == 3)
  assert(Array::get(r, 2) == 1)
}

test "array_concat" {
  let r = Array::concat([
    1,
    2
  ], [
    3,
    4
  ])
  assert(Array::length(r) == 4)
  assert(Array::get(r, 0) == 1)
  assert(Array::get(r, 3) == 4)
}

test "array_find_basic" {
  let arr = [
    10,
    20,
    30
  ]
  assert(Array::get(arr, 1) == 20)
  assert(Array::length(arr) == 3)
}

test "struct_create_access" {
  let p = Point::{
    x: 10, y: 20
  }
  assert(p.x == 10)
  assert(p.y == 20)
}

test "struct_field_fn" {
  let p = Point::{
    x: 3, y: 4
  }
  let dist_sq = p.x * p.x + p.y * p.y
  assert(dist_sq == 25)
}

test "enum_ctor_match" {
  let c = Green
  let r = match c {
    Red => 1,
    Green => 2,
    Blue => 3,
    _ => 0
  }
  assert(r == 2)
}

test "enum_some_none" {
  let x = Some(42)
  let y: Int? = None
  let r1 = if x is Some(v) { v } else { 0 }
  let r2 = if y is Some(v) { v } else { -1 }
  assert(r1 == 42)
  assert(r2 == -1)
}
