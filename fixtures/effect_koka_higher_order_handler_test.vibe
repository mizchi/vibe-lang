// #1973: was fixtures/effect_koka_higher_order_handler.vibe + __DATA__.last "28"
// (stale length count; honest runtime is 27).
// Higher-order handler — function accepting effectful lambda
// Ported from koka pattern: handler wrapping effectful block
effect Db {
  Query(String) -> Int;
}

fn with_db(action: () -> Int with Db) -> Int {
  handle {
    action()
  } with {
    Db::Query(q) => resume(String::length(q))
  }
}

fn koka_higher_order_handler() -> Int {
  // Direct inline version (avoids function-call indirection limitation)
  handle {
    let a = perform Db::Query("SELECT * FROM users")
    let b = perform Db::Query("SELECT 1")
    a + b
  } with {
    Db::Query(q) => resume(String::length(q))
  }
}

// The old last "28" counted "SELECT * FROM users" as 20; it is 19, so 19+8=27.
test "inline Db handler sums query lengths to 27" {
  inspect(koka_higher_order_handler(), "27")
}
