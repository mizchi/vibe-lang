// #3551 review: one module writes `impl [T] Name for Box[T]`, another
// `impl Name for Box[Int]`. Their methods are named apart, so the name
// comparison let both through, and BOTH modules' `Box[Int]` calls ran the
// specialized impl -- this printed `from-int from-int`. One file holding both
// is refused by the checker; across modules it is refused here, naming both.

import ./modules/impl_overlap_generic_a.vibe {
  generic_name
}

import ./modules/impl_overlap_box_int.vibe {
  box_int_name
}

test "both modules keep their own impl" {
  inspect("\{generic_name()} \{box_int_name()}", "from-generic from-int")
}
