// Polysemy-style Writer effect — tell accumulates

// Ported from polysemy test/WriterSpec.hs

// Note: mutable accumulator shared via tail-resumptive is not possible,

// so we test the simpler pattern: tell as side-effect, body returns value

effect Writer {
  Tell(String) -> Unit;
}

test "effect polysemy writer censor" {
  let result = handle {
    perform Writer::Tell("hello ")
    perform Writer::Tell("world")
    42
  } with { Writer::Tell(_msg) => resume(0) }
  inspect(result, "42")
}
