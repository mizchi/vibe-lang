// ADR-0091 (#1274 Codex P1): a parameter shadowing an allocation-free
// top-level fn is an INDIRECT callee -- the supplied implementation may
// allocate, so the zero_alloc walker must not resolve the call to the
// clean top-level body by name.
//   error_contains: "zero_alloc"
fn clean() -> Int {
  1
}

#zero_alloc
fn hot(clean: () -> Int) -> Int {
  clean()
}
