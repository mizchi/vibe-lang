// #2996: `Int::min_value` (-2^62) is writable as a literal. Its magnitude is
// one past the positive bound, so it lexes only when a `-` precedes it; under
// the 63-bit wrap (#1877) both the unary and the binary reading of that `-`
// are exact.
test "the minimum Int is a literal" {
  let m = -4611686018427387904
  inspect(m == -4611686018427387903 - 1, "true")
  inspect(m, "-4611686018427387904")
  inspect(5 - 4611686018427387904, "-4611686018427387899")
  inspect(m < -4611686018427387903, "true")
}
