// #1541 element types: the native array's cells are `(mut i64)` holding
// ordinary tagged values -- the same bytes linear memory would hold. So the
// element TYPE never changed the representation; only `Array[Int]` happened to
// be recognized. `Array[String]` and `Array[Bool]` cross the same reference
// lane, with identity preserved through the callee parameter.
//
// The allowlist stays an allowlist because generic binders are erased before
// codegen: after the strip pass, `Array[T]`'s element is spelled `TyName("T")`
// and cannot be told apart from a concrete type of that name. Nested arrays
// are excluded for the root reason instead -- a cell holding a reference is
// exactly what an i64 cell cannot do.

fn set_second_word(words: Array[String]) -> Unit {
  Array::set(words, 1, "beta")
}

fn clear_first_flag(flags: Array[Bool]) -> Unit {
  Array::set(flags, 0, false)
}

test "gc direct array reference carries String and Bool elements" {
  let words = [
    "alpha",
    "?"
  ]
  set_second_word(words)
  inspect(Array::get(words, 0), "alpha")
  inspect(Array::get(words, 1), "beta")
  let flags = [
    true,
    true
  ]
  clear_first_flag(flags)
  inspect(Array::get(flags, 0), "false")
  inspect(Array::get(flags, 1), "true")
}
