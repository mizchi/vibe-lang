//# ADR-0097 fail-closed, the shape #2192 narrowed BACK to a trap.
//#
//# `pushed_value_shape` reads only the value's own syntax, with empty
//# environments, so a pushed IDENTIFIER resolves to nothing: reading its type
//# from the scan's environment is what leaked an outer binding's type into a
//# shadowing scope and answered `false` for two equal arrays. Here the pushed
//# value is a name, so both bindings keep the `[__EqEmpty]` sentinel and `==`
//# must trap once both are non-empty -- never fall back to identity or to a
//# length-only answer. `let left: Array[Array[Int]] = []` is what makes it
//# valid, and a literal push (`Array::push(left, [1, 2])`) resolves without one.

export fn _start() -> Int {
  let v = [1, 2]
  let left = []
  Array::push(left, v)
  let right = []
  Array::push(right, v)
  if left == right {
    1
  } else {
    0
  }
}
