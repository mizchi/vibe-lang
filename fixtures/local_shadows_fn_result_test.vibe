// #3024: a local binding named like a top-level function is that binding.
// Its call result must not be typed by the top-level function's declared
// result: `helper() + 2` used to lower to `String::concat` because the
// top-level `helper` returns a String, and printed a pointer-shaped integer.
fn helper() -> String {
  "x"
}

fn let_shadow() -> Int {
  let helper = () -> 5
  helper() + 2
}

fn let_bound_result() -> Int {
  let helper = () -> 5
  let a = helper()
  a + 2
}

fn mut_shadow() -> Int {
  let mut helper = () -> 1
  helper = () -> 5
  helper() + 2
}

fn param_shadow(helper: () -> Int) -> Int {
  helper() + 2
}

fn interp_shadow() -> String {
  let helper = () -> 5
  "\{helper() + 1}"
}

test "a local lambda shadows a String-returning top-level function" {
  inspect(let_shadow(), "7")
  inspect(let_bound_result(), "7")
  inspect(mut_shadow(), "7")
  inspect(param_shadow(() -> 5), "7")
  inspect(interp_shadow(), "6")
}

test "the top-level function is still a String where it is not shadowed" {
  inspect(helper() + "y", "xy")
}
