// #1261 positive counterpart of err_effect_needing_value_escape.vibe: the
// SAME program with the rows written out. Once the receiving parameter's
// type carries `Async`, edp_row_typed_param_names sees it, the call through
// `f` gets the evidence dict prepended like any other needing call, and the
// two sides agree on the arity. Nothing else about the program changes --
// this is the fix-it the rejection's message points at.
effect Async {
  Suspend(Int) -> Int
}

fn apply1(f: (x: Int) -> Int with Async) -> Int with Async {
  f(1)
}

let _start = () -> Int {
  handle {
    apply1((x: Int) -> Int with Async {
      perform Async::Suspend(x)
    })
  } with Async {
    Suspend(t) => resume(t + 41)
  }
}

test "effect_needing_value_annotated.vibe produces its recorded value" {
  // #1571: the bare `_start()` call and the `__DATA__` tail collapsed
  // into this block. `vibe test --update` rewrites the literal.
  inspect(_start(), "42")
}
