// #705 regression: under VIBE_RC=1 a Bool is a tagged scalar (true = 1<<1).
// The `eq`/`not` builtins must tag their i64 result like the comparison binops
// do, or `not(false) == true` compares untagged 1 against the tagged `true`
// literal 2 and the assertion's `unreachable` fires. Passes on bump (untagged)
// and under RC (tagged) alike.

test "not result compares equal to bool literal" {
  let ok = not(false)
  assert(ok == true)
  assert(not(true) == false)
}

test "eq result compares equal to bool literal" {
  let e = eq(1, 1)
  assert(e == true)
  assert(eq(1, 2) == false)
}
