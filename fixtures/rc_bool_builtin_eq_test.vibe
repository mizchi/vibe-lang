// #705 regression: under VIBE_RC=1 a Bool is a tagged scalar (true = 1<<1).
// The inline `not` builtin must tag its i64 result like the comparison binops
// do, or `not(false) == true` compares untagged 1 against the tagged `true`
// literal 2 and the assertion's `unreachable` fires (this was the
// vibe/x/quickcheck/quickcheck_effect_test trap). Passes on bump (untagged)
// and under RC (tagged) alike.
//
// An `eq(..)` on non-scalar operands resolves to the bound `eq` helper rather
// than the inline arm; since #3615 the call site tags that helper's raw 0/1 as
// well (`cc_builtin_returns_raw_bool`), so it compares equal to a literal too.

test "not result compares equal to bool literal" {
  let ok = not(false)
  assert(ok == true)
  assert(not(true) == false)
}

test "not in boolean expressions" {
  let a = not(false)
  let b = not(false)
  assert(not(a) == false)
  assert(a && b)
}

test "bound eq and String::equals results compare equal to bool literals" {
  let s = String::concat("a", "b")
  assert(eq(s, "ab") == true)
  assert(eq(s, "a") == false)
  assert(String::equals(s, "ab") == true)
  assert(String::equals(s, "a") == false)
}
