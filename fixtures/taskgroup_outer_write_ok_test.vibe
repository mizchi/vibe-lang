// #3276: a `TaskGroup::run` body is checked inside the group's region, and a
// write that stores the group's own token in a location declared before the
// body is refused (fixtures/typecheck/taskgroup_escape_*_reject.vibe). These
// are the uses that must stay legal, measured by their answers:
//
// - joined RESULTS written to outer locations of every declared shape: an
//   annotated array, an open array, a generic struct field, a `let mut`;
// - handles and endpoints kept in locals created inside the body -- an array,
//   a struct, a `let mut` -- and joined there;
// - a nested group storing an OUTER group's handle in a local of the outer
//   body: that local is inside the outer group, so nothing escapes.
import @vibe/concurrent { TaskGroup, TaskHandle, Channel, Sender, Receiver }

struct Cell[T] {
  mut v: Option[T]
}

fn outer_writes() -> String with Exception {
  let results: Array[Int] = []
  let open_results = []
  let c = Cell::{ v: None }
  let mut total = 0
  let mut last: Option[Int] = None
  let r = TaskGroup::run((n) -> {
    let hs = []
    let mut i = 0
    while i < 3 {
      let k = i
      Array::push(hs, value = TaskGroup::spawn(n, f = () -> { k * 10 }))
      i = i + 1
    }
    let local_cell = Cell::{ v: None }
    local_cell.v = Some(TaskGroup::spawn(n, f = () -> { 5 }))
    let mut local_slot = None
    local_slot = Some(TaskGroup::spawn(n, f = () -> { 6 }))
    for h in hs {
      let v = TaskHandle::join(h)
      Array::push(results, value = v)
      Array::push(open_results, value = v + 1)
      total = total + v
    }
    match local_cell.v {
      Some(h) => c.v = Some(TaskHandle::join(h)),
      None => ()
    }
    match local_slot {
      Some(h) => last = Some(TaskHandle::join(h)),
      None => ()
    }
    let (tx, rx) = Channel::bounded(n = n, capacity = 4)
    let _p = TaskGroup::spawn(n, f = () -> {
      Sender::send(tx, v = 7)
      Sender::release(tx)
      0
    })
    let got = match Receiver::recv(rx) {
      Some(x) => x,
      None => 0
    }
    let outer_local = []
    let inner = TaskGroup::run((m) -> {
      Array::push(outer_local, value = TaskGroup::spawn(n, f = () -> { 100 }))
      TaskHandle::join(TaskGroup::spawn(m, f = () -> { 1 }))
    })
    let from_outer = TaskHandle::join(Array::get(outer_local, at = 0))
    got + inner + from_outer
  })
  let cv = match c.v {
    Some(x) => x,
    None => 0 - 1
  }
  let lv = match last {
    Some(x) => x,
    None => 0 - 1
  }
  "r=\{r} results=\{Array::length(results)} open=\{Array::length(open_results)} total=\{total} c=\{cv} last=\{lv}"
}

test "joined results and body-local handles stay legal around a task group" allows Exception {
  inspect(outer_writes(), "r=108 results=3 open=3 total=30 c=5 last=6")
}

// #3343: a call inside the body that hands the group's token to a function or
// `let`-bound closure re-checks the callee under the group's region
// (fixtures/typecheck/taskgroup_escape_{helper,prebound,named,..}_reject.vibe).
// These calls keep nothing past the group and must stay legal: a helper that
// only reads its argument, helpers that store a JOINED result in an outer
// location, a generic helper, a method and a closure storing a handle in a
// location created inside the body, a body passed by name that stores a
// joined result, a nested group storing the OUTER group's handle, through a
// helper, in a local of the outer body, and a handle handed to a callback
// that joins it -- through a helper, and through a closure that captured the
// group. Results are checked too (Codex on #3359): a generic helper that
// hands the handle back keeps its region in the result type, and a struct
// built from a JOINED value -- returned by a helper, or written directly --
// carries no handle.
fn peek(_ h: TaskHandle[Int]) -> Int with Exception {
  TaskHandle::join(h)
}

fn put[T](c: Cell[T], v: T) -> Unit {
  c.v = Some(v)
}

fn Cell::keep[T](_ self: Cell[T], v: T) -> Unit {
  self.v = Some(v)
}

fn keep_joined(c: Cell[Int], h: TaskHandle[Int]) -> Unit with Exception {
  c.v = Some(TaskHandle::join(h))
}

fn keep_joined_generic[T](c: Cell[T], h: TaskHandle[T]) -> Unit with Exception {
  c.v = Some(TaskHandle::join(h))
}

fn apply_to[T, U](h: T, f: (T) -> U) -> U {
  f(h)
}

fn id[T](_ x: T) -> T {
  x
}

struct Summary {
  total: Int
}

fn summarize(_ h: TaskHandle[Int]) -> Summary with Exception {
  Summary::{ total: TaskHandle::join(h) }
}

fn summary_total(_ c: Cell[Summary]) -> Int {
  match c.v {
    Some(sv) => sv.total,
    None => 0 - 1
  }
}

fn cell_value(_ c: Cell[Int]) -> Int {
  match c.v {
    Some(x) => x,
    None => 0 - 1
  }
}

fn helper_calls() -> String with Exception {
  let a = Cell::{ v: None }
  let b: Cell[Int] = Cell::{ v: None }
  let g: Cell[Int] = Cell::{ v: None }
  let named: Cell[Int] = Cell::{ v: None }
  let s1: Cell[Summary] = Cell::{ v: None }
  let s2: Cell[Summary] = Cell::{ v: None }
  let mut total = 0
  let note = (x) -> {
    total = total + x
  }
  let r = TaskGroup::run((n) -> {
    let local = Cell::{ v: None }
    put(c = local, v = TaskGroup::spawn(n, f = () -> { 40 }))
    let joined = match local.v {
      Some(lh) => peek(lh),
      None => 0
    }
    put(c = a, v = joined + 1)
    keep_joined(c = b, h = TaskGroup::spawn(n, f = () -> { 2 }))
    keep_joined_generic(c = g, h = TaskGroup::spawn(n, f = () -> { 3 }))
    note(joined)
    let by_method = Cell::{ v: None }
    by_method.keep(v = TaskGroup::spawn(n, f = () -> { 4 }))
    let stash_local = (x) -> {
      local.v = Some(x)
    }
    stash_local(TaskGroup::spawn(n, f = () -> { 5 }))
    let outer_local = Cell::{ v: None }
    let inner = TaskGroup::run((m) -> {
      put(c = outer_local, v = TaskGroup::spawn(n, f = () -> { 100 }))
      TaskHandle::join(TaskGroup::spawn(m, f = () -> { 1 }))
    })
    let from_outer = match outer_local.v {
      Some(oh) => TaskHandle::join(oh),
      None => 0
    }
    let from_method = match by_method.v {
      Some(mh) => TaskHandle::join(mh),
      None => 0
    }
    let from_stash = match local.v {
      Some(sh) => TaskHandle::join(sh),
      None => 0
    }
    let via_callback = apply_to(h = TaskGroup::spawn(n, f = () -> { 6 }), f = (x) -> {
      TaskHandle::join(x)
    })
    let with_group = (f) -> {
      f(TaskGroup::spawn(n, f = () -> { 8 }))
    }
    let via_captured = with_group((x) -> {
      TaskHandle::join(x)
    })
    let via_id = TaskHandle::join(id(TaskGroup::spawn(n, f = () -> { 9 })))
    s1.v = Some(summarize(TaskGroup::spawn(n, f = () -> { 11 })))
    s2.v = Some(Summary::{ total: TaskHandle::join(TaskGroup::spawn(n, f = () -> { 12 })) })
    inner + from_outer + from_method + from_stash + via_callback + via_captured + via_id
  })
  let body = (n) -> {
    let h = TaskGroup::spawn(n, f = () -> { 7 })
    named.v = Some(TaskHandle::join(h))
    1
  }
  let r2 = TaskGroup::run(body)
  "r=\{r} r2=\{r2} a=\{cell_value(a)} b=\{cell_value(b)} g=\{cell_value(g)} named=\{cell_value(named)} total=\{total} s1=\{summary_total(s1)} s2=\{summary_total(s2)}"
}

test "helpers and closures that keep nothing past the group stay legal" allows Exception {
  inspect(helper_calls(), "r=133 r2=1 a=41 b=2 g=3 named=7 total=40 s1=11 s2=12")
}

// #3343 (Codex on #3359): a value whose type does not show the group's region
// -- a handle a helper returns under `TaskHandle[Int]` (as `start` does in
// fixtures/async_spawn_host_futures/stream_folded_spawn.vibe), a struct or an
// enum built from one, handed back by an explicit `return` or not -- carries
// the region of every value it was made from. It is refused only where it
// would outlive the group (the `taskgroup_escape_*_reject` rows); joined,
// matched or handed to a helper that keeps a joined result, inside the body,
// it stays legal. So does a box of the OUTER group's handle written to a
// local of the outer body from a nested group, a closure that captured only a
// joined result, and a closure made before the group, each written outside.
struct Box {
  h: TaskHandle[Int]
}

enum Slot {
  Has(TaskHandle[Int]);
  Empty
}

fn start(g: TaskGroup, k: Int) -> TaskHandle[Int] {
  TaskGroup::spawn(g, f = () -> { k })
}

fn boxit(_ h: TaskHandle[Int]) -> Box {
  return Box::{ h: h }
}

fn wrap(h: TaskHandle[Int], keep: Bool) -> Slot {
  if keep {
    return Has(h)
  } else {
    ()
  }
  Empty
}

fn unbox(_ b: Box) -> Int with Exception {
  TaskHandle::join(b.h)
}

fn keep_unboxed(c: Cell[Int], b: Box) -> Unit with Exception {
  c.v = Some(TaskHandle::join(b.h))
}

fn erased_in_body() -> String with Exception {
  let kept: Cell[Int] = Cell::{ v: None }
  let fs: Cell[() -> Int] = Cell::{ v: None }
  let pre_fs: Cell[() -> Int] = Cell::{ v: None }
  let pre = () -> { 9 }
  let r = TaskGroup::run((n) -> {
    let t = start(g = n, k = 1)
    let b = boxit(TaskGroup::spawn(n, f = () -> { 2 }))
    let s = match wrap(h = start(g = n, k = 3), keep = true) {
      Has(h) => TaskHandle::join(h),
      Empty => 0
    }
    keep_unboxed(c = kept, b = Box::{ h: start(g = n, k = 4) })
    let local_box = Cell::{ v: None }
    local_box.v = Some(boxit(start(g = n, k = 5)))
    let from_local = match local_box.v {
      Some(lb) => unbox(lb),
      None => 0
    }
    let outer_local_box: Cell[Box] = Cell::{ v: None }
    let inner = TaskGroup::run((m) -> {
      outer_local_box.v = Some(Box::{ h: TaskGroup::spawn(n, f = () -> { 6 }) })
      TaskHandle::join(TaskGroup::spawn(m, f = () -> { 10 }))
    })
    let from_outer = match outer_local_box.v {
      Some(ob) => unbox(ob),
      None => 0
    }
    let j = TaskHandle::join(start(g = n, k = 7))
    fs.v = Some(() -> { j + 1 })
    pre_fs.v = Some(pre)
    TaskHandle::join(t) + unbox(b) + s + from_local + inner + from_outer
  })
  let f = match fs.v {
    Some(ff) => ff(),
    None => 0 - 1
  }
  let p = match pre_fs.v {
    Some(pf) => pf(),
    None => 0 - 1
  }
  let k = match kept.v {
    Some(x) => x,
    None => 0 - 1
  }
  "r=\{r} kept=\{k} f=\{f} pre=\{p}"
}

test "values whose type hides the group's region stay legal inside the body" allows Exception {
  inspect(erased_in_body(), "r=27 kept=4 f=8 pre=9")
}

// #3343 (Codex on #3359): the same values built through a branch, a `match`
// arm, or two structs deep, and a helper that recurses with the callback it
// was handed (which keeps nothing), stay legal while they stay in the body
// (fixtures/typecheck/taskgroup_escape_{branch_tail,match_tail,nested_tail,
// recursive_callback}_reject.vibe return or keep them outside).
struct Wrapper {
  inner: Box
}

fn ignore(_ h: TaskHandle[Int]) -> Unit {
  let _ = h
  ()
}

fn walk_cb(cb: (TaskHandle[Int]) -> Unit, h: TaskHandle[Int], first: Bool) -> Unit {
  if first {
    walk_cb(cb = cb, h = h, first = false)
  } else {
    cb(h)
  }
}

fn nested_and_branches(_ flag: Bool) -> String with Exception {
  let r = TaskGroup::run((n) -> {
    let picked = if flag {
      Box::{ h: start(g = n, k = 1) }
    } else {
      Box::{ h: start(g = n, k = 2) }
    }
    let matched = match Some(3) {
      Some(k) => Box::{ h: start(g = n, k = k) },
      None => Box::{ h: start(g = n, k = 0) }
    }
    let w = Wrapper::{ inner: Box::{ h: start(g = n, k = 4) } }
    let h5 = start(g = n, k = 5)
    walk_cb(cb = ignore, h = h5, first = true)
    unbox(picked) + unbox(matched) + unbox(w.inner) + TaskHandle::join(h5)
  })
  "r=\{r}"
}

test "branch, match and nested values and a recursive callback stay legal inside the body" allows Exception {
  inspect(nested_and_branches(true), "r=13")
}

// #3343 (Codex on #3359): a binding made in the body carries what is written
// into it later -- a field write, `Array::push` / `Array::set`, an
// assignment, a helper handed it (fixtures/typecheck/taskgroup_escape_local_*
// _reject.vibe return or store such bindings outside). Joined inside the
// body they stay legal, and so does a container of closures that captured
// only joined values, returned from the body.
struct HandleSlot {
  mut h: Option[TaskHandle[Int]]
}

fn fill_slot(s: HandleSlot, h: TaskHandle[Int]) -> Unit {
  s.h = Some(h)
}

fn slot_value(_ s: HandleSlot) -> Int with Exception {
  match s.h {
    Some(h) => TaskHandle::join(h),
    None => 0
  }
}

fn local_writes() -> String with Exception {
  let fs = TaskGroup::run((n) -> {
    let s = HandleSlot::{ h: None }
    s.h = Some(start(g = n, k = 1))
    let filled = HandleSlot::{ h: None }
    fill_slot(s = filled, h = start(g = n, k = 2))
    let hs: Array[TaskHandle[Int]] = []
    Array::push(hs, value = start(g = n, k = 3))
    Array::set(hs, at = 0, value = start(g = n, k = 4))
    let mut later = None
    later = Some(start(g = n, k = 5))
    let from_later = match later {
      Some(h) => TaskHandle::join(h),
      None => 0
    }
    let total = slot_value(s) + slot_value(filled) + TaskHandle::join(Array::get(hs, at = 0)) + from_later
    let out = []
    Array::push(out, value = () -> total)
    out
  })
  "f=\{(Array::get(fs, 0))()}"
}

test "writes into a binding made in the body stay legal while it stays there" allows Exception {
  inspect(local_writes(), "f=12")
}

// #3343 (Codex on #3359): a helper handed an outer group's handle and an
// inner group's, recursing with the two swapped, is checked once for each
// order; storing either in a cell made inside the inner body keeps nothing
// past either group (fixtures/typecheck/
// taskgroup_escape_recursive_region_swap_reject.vibe stores the inner one in
// a cell of the outer body).
fn keep_swapped(c: Cell[TaskHandle[Int]], a: TaskHandle[Int], b: TaskHandle[Int], again: Bool) -> Unit {
  if again {
    keep_swapped(c = c, a = b, b = a, again = false)
  } else {
    c.v = Some(a)
  }
}

fn swapped_regions() -> String with Exception {
  let r = TaskGroup::run((n) -> {
    let inner = TaskGroup::run((m) -> {
      let c: Cell[TaskHandle[Int]] = Cell::{ v: None }
      keep_swapped(c = c, a = TaskGroup::spawn(n, f = () -> { 1 }), b = TaskGroup::spawn(m, f = () -> { 41 }), again = true)
      match c.v {
        Some(h) => TaskHandle::join(h),
        None => 0 - 1
      }
    })
    inner + 1
  })
  "r=\{r}"
}

test "a recursion that swaps handles between groups stays legal while it stores them locally" allows Exception {
  inspect(swapped_regions(), "r=42")
}

// An expression call's consumed argument is not its result. Keep the same
// result provenance that a named helper records after joining its handle.
fn expression_result() -> Int with Exception {
  let outside: Cell[Cell[TaskHandle[Int]]] = Cell::{ v: None }
  let _ = TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, f = () -> 42)
    outside.v = Some(((h: TaskHandle[Int]) -> Cell[TaskHandle[Int]] with Exception {
      TaskHandle::join(h)
      Cell::{ v: None }
    })(h))
    0
  })
  match outside.v {
    Some(b) => match b.v {
      None => 42,
      Some(_) => 0
    },
    None => 0
  }
}

test "an immediately invoked lambda may return an empty box after consuming a handle" allows Exception {
  inspect(expression_result(), "42")
}
