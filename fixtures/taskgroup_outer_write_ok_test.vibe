// #3276: a `TaskGroup::run` body is checked inside the group's region, and a
// write that stores the group's own token in a location declared before the
// body is refused (fixtures/typecheck/taskgroup_escape_*_reject.vibe). These
// are the uses that must stay legal, measured by their answers:
//
// - joined RESULTS written to outer locations of every declared shape: an
//   annotated array, an open array, a generic struct field, a `let mut`;
// - handles and endpoints kept in locals created inside the body -- an array,
//   a struct, a `let mut` -- and joined there;
// - a nested group storing an OUTER group's handle in a local of the outer
//   body: that local is inside the outer group, so nothing escapes.
import @vibe/concurrent { TaskGroup, TaskHandle, Channel, Sender, Receiver }

struct Cell[T] {
  mut v: Option[T]
}

fn outer_writes() -> String with Exception {
  let results: Array[Int] = []
  let open_results = []
  let c = Cell::{ v: None }
  let mut total = 0
  let mut last: Option[Int] = None
  let r = TaskGroup::run((n) -> {
    let hs = []
    let mut i = 0
    while i < 3 {
      let k = i
      Array::push(hs, TaskGroup::spawn(n, () -> { k * 10 }))
      i = i + 1
    }
    let local_cell = Cell::{ v: None }
    local_cell.v = Some(TaskGroup::spawn(n, () -> { 5 }))
    let mut local_slot = None
    local_slot = Some(TaskGroup::spawn(n, () -> { 6 }))
    for h in hs {
      let v = TaskHandle::join(h)
      Array::push(results, v)
      Array::push(open_results, v + 1)
      total = total + v
    }
    match local_cell.v {
      Some(h) => c.v = Some(TaskHandle::join(h)),
      None => ()
    }
    match local_slot {
      Some(h) => last = Some(TaskHandle::join(h)),
      None => ()
    }
    let (tx, rx) = Channel::bounded(n, 4)
    let _p = TaskGroup::spawn(n, () -> {
      Sender::send(tx, 7)
      Sender::release(tx)
      0
    })
    let got = match Receiver::recv(rx) {
      Some(x) => x,
      None => 0
    }
    let outer_local = []
    let inner = TaskGroup::run((m) -> {
      Array::push(outer_local, TaskGroup::spawn(n, () -> { 100 }))
      TaskHandle::join(TaskGroup::spawn(m, () -> { 1 }))
    })
    let from_outer = TaskHandle::join(Array::get(outer_local, 0))
    got + inner + from_outer
  })
  let cv = match c.v {
    Some(x) => x,
    None => 0 - 1
  }
  let lv = match last {
    Some(x) => x,
    None => 0 - 1
  }
  "r=\{r} results=\{Array::length(results)} open=\{Array::length(open_results)} total=\{total} c=\{cv} last=\{lv}"
}

test "joined results and body-local handles stay legal around a task group" allows Exception {
  inspect(outer_writes(), "r=108 results=3 open=3 total=30 c=5 last=6")
}

// #3343: a call inside the body that hands the group's token to a function or
// `let`-bound closure re-checks the callee under the group's region
// (fixtures/typecheck/taskgroup_escape_{helper,prebound,named,..}_reject.vibe).
// These calls keep nothing past the group and must stay legal: a helper that
// only reads its argument, helpers that store a JOINED result in an outer
// location, a generic helper, a method and a closure storing a handle in a
// location created inside the body, a body passed by name that stores a
// joined result, a nested group storing the OUTER group's handle, through a
// helper, in a local of the outer body, and a handle handed to a callback
// that joins it -- through a helper, and through a closure that captured the
// group. Results are checked too (Codex on #3359): a generic helper that
// hands the handle back keeps its region in the result type, and a struct
// built from a JOINED value -- returned by a helper, or written directly --
// carries no handle.
fn peek(h: TaskHandle[Int]) -> Int with Exception {
  TaskHandle::join(h)
}

fn put[T](c: Cell[T], v: T) -> Unit {
  c.v = Some(v)
}

fn Cell::keep[T](self: Cell[T], v: T) -> Unit {
  self.v = Some(v)
}

fn keep_joined(c: Cell[Int], h: TaskHandle[Int]) -> Unit with Exception {
  c.v = Some(TaskHandle::join(h))
}

fn keep_joined_generic[T](c: Cell[T], h: TaskHandle[T]) -> Unit with Exception {
  c.v = Some(TaskHandle::join(h))
}

fn apply_to[T, U](h: T, f: (T) -> U) -> U {
  f(h)
}

fn id[T](x: T) -> T {
  x
}

struct Summary {
  total: Int
}

fn summarize(h: TaskHandle[Int]) -> Summary with Exception {
  Summary::{ total: TaskHandle::join(h) }
}

fn summary_total(c: Cell[Summary]) -> Int {
  match c.v {
    Some(sv) => sv.total,
    None => 0 - 1
  }
}

fn cell_value(c: Cell[Int]) -> Int {
  match c.v {
    Some(x) => x,
    None => 0 - 1
  }
}

fn helper_calls() -> String with Exception {
  let a = Cell::{ v: None }
  let b: Cell[Int] = Cell::{ v: None }
  let g: Cell[Int] = Cell::{ v: None }
  let named: Cell[Int] = Cell::{ v: None }
  let s1: Cell[Summary] = Cell::{ v: None }
  let s2: Cell[Summary] = Cell::{ v: None }
  let mut total = 0
  let note = (x) -> {
    total = total + x
  }
  let r = TaskGroup::run((n) -> {
    let local = Cell::{ v: None }
    put(local, TaskGroup::spawn(n, () -> { 40 }))
    let joined = match local.v {
      Some(lh) => peek(lh),
      None => 0
    }
    put(a, joined + 1)
    keep_joined(b, TaskGroup::spawn(n, () -> { 2 }))
    keep_joined_generic(g, TaskGroup::spawn(n, () -> { 3 }))
    note(joined)
    let by_method = Cell::{ v: None }
    by_method.keep(TaskGroup::spawn(n, () -> { 4 }))
    let stash_local = (x) -> {
      local.v = Some(x)
    }
    stash_local(TaskGroup::spawn(n, () -> { 5 }))
    let outer_local = Cell::{ v: None }
    let inner = TaskGroup::run((m) -> {
      put(outer_local, TaskGroup::spawn(n, () -> { 100 }))
      TaskHandle::join(TaskGroup::spawn(m, () -> { 1 }))
    })
    let from_outer = match outer_local.v {
      Some(oh) => TaskHandle::join(oh),
      None => 0
    }
    let from_method = match by_method.v {
      Some(mh) => TaskHandle::join(mh),
      None => 0
    }
    let from_stash = match local.v {
      Some(sh) => TaskHandle::join(sh),
      None => 0
    }
    let via_callback = apply_to(TaskGroup::spawn(n, () -> { 6 }), (x) -> {
      TaskHandle::join(x)
    })
    let with_group = (f) -> {
      f(TaskGroup::spawn(n, () -> { 8 }))
    }
    let via_captured = with_group((x) -> {
      TaskHandle::join(x)
    })
    let via_id = TaskHandle::join(id(TaskGroup::spawn(n, () -> { 9 })))
    s1.v = Some(summarize(TaskGroup::spawn(n, () -> { 11 })))
    s2.v = Some(Summary::{ total: TaskHandle::join(TaskGroup::spawn(n, () -> { 12 })) })
    inner + from_outer + from_method + from_stash + via_callback + via_captured + via_id
  })
  let body = (n) -> {
    let h = TaskGroup::spawn(n, () -> { 7 })
    named.v = Some(TaskHandle::join(h))
    1
  }
  let r2 = TaskGroup::run(body)
  "r=\{r} r2=\{r2} a=\{cell_value(a)} b=\{cell_value(b)} g=\{cell_value(g)} named=\{cell_value(named)} total=\{total} s1=\{summary_total(s1)} s2=\{summary_total(s2)}"
}

test "helpers and closures that keep nothing past the group stay legal" allows Exception {
  inspect(helper_calls(), "r=133 r2=1 a=41 b=2 g=3 named=7 total=40 s1=11 s2=12")
}

// #3343 (Codex on #3359): a value whose type does not show the group's region
// -- a handle a helper returns under `TaskHandle[Int]` (as `start` does in
// fixtures/async_spawn_host_futures/stream_folded_spawn.vibe), a struct or an
// enum built from one, handed back by an explicit `return` or not -- carries
// the region of every value it was made from. It is refused only where it
// would outlive the group (the `taskgroup_escape_*_reject` rows); joined,
// matched or handed to a helper that keeps a joined result, inside the body,
// it stays legal. So does a box of the OUTER group's handle written to a
// local of the outer body from a nested group, a closure that captured only a
// joined result, and a closure made before the group, each written outside.
struct Box {
  h: TaskHandle[Int]
}

enum Slot {
  Has(TaskHandle[Int]);
  Empty
}

fn start(g: TaskGroup, k: Int) -> TaskHandle[Int] {
  TaskGroup::spawn(g, () -> { k })
}

fn boxit(h: TaskHandle[Int]) -> Box {
  return Box::{ h: h }
}

fn wrap(h: TaskHandle[Int], keep: Bool) -> Slot {
  if keep {
    return Has(h)
  } else {
    ()
  }
  Empty
}

fn unbox(b: Box) -> Int with Exception {
  TaskHandle::join(b.h)
}

fn keep_unboxed(c: Cell[Int], b: Box) -> Unit with Exception {
  c.v = Some(TaskHandle::join(b.h))
}

fn erased_in_body() -> String with Exception {
  let kept: Cell[Int] = Cell::{ v: None }
  let fs: Cell[() -> Int] = Cell::{ v: None }
  let pre_fs: Cell[() -> Int] = Cell::{ v: None }
  let pre = () -> { 9 }
  let r = TaskGroup::run((n) -> {
    let t = start(n, 1)
    let b = boxit(TaskGroup::spawn(n, () -> { 2 }))
    let s = match wrap(start(n, 3), true) {
      Has(h) => TaskHandle::join(h),
      Empty => 0
    }
    keep_unboxed(kept, Box::{ h: start(n, 4) })
    let local_box = Cell::{ v: None }
    local_box.v = Some(boxit(start(n, 5)))
    let from_local = match local_box.v {
      Some(lb) => unbox(lb),
      None => 0
    }
    let outer_local_box: Cell[Box] = Cell::{ v: None }
    let inner = TaskGroup::run((m) -> {
      outer_local_box.v = Some(Box::{ h: TaskGroup::spawn(n, () -> { 6 }) })
      TaskHandle::join(TaskGroup::spawn(m, () -> { 10 }))
    })
    let from_outer = match outer_local_box.v {
      Some(ob) => unbox(ob),
      None => 0
    }
    let j = TaskHandle::join(start(n, 7))
    fs.v = Some(() -> { j + 1 })
    pre_fs.v = Some(pre)
    TaskHandle::join(t) + unbox(b) + s + from_local + inner + from_outer
  })
  let f = match fs.v {
    Some(ff) => ff(),
    None => 0 - 1
  }
  let p = match pre_fs.v {
    Some(pf) => pf(),
    None => 0 - 1
  }
  let k = match kept.v {
    Some(x) => x,
    None => 0 - 1
  }
  "r=\{r} kept=\{k} f=\{f} pre=\{p}"
}

test "values whose type hides the group's region stay legal inside the body" allows Exception {
  inspect(erased_in_body(), "r=27 kept=4 f=8 pre=9")
}

// #3343 (Codex on #3359): the same values built through a branch, a `match`
// arm, or two structs deep, and a helper that recurses with the callback it
// was handed (which keeps nothing), stay legal while they stay in the body
// (fixtures/typecheck/taskgroup_escape_{branch_tail,match_tail,nested_tail,
// recursive_callback}_reject.vibe return or keep them outside).
struct Wrapper {
  inner: Box
}

fn ignore(h: TaskHandle[Int]) -> Unit {
  let _ = h
  ()
}

fn walk_cb(cb: (TaskHandle[Int]) -> Unit, h: TaskHandle[Int], first: Bool) -> Unit {
  if first {
    walk_cb(cb, h, false)
  } else {
    cb(h)
  }
}

fn nested_and_branches(flag: Bool) -> String with Exception {
  let r = TaskGroup::run((n) -> {
    let picked = if flag {
      Box::{ h: start(n, 1) }
    } else {
      Box::{ h: start(n, 2) }
    }
    let matched = match Some(3) {
      Some(k) => Box::{ h: start(n, k) },
      None => Box::{ h: start(n, 0) }
    }
    let w = Wrapper::{ inner: Box::{ h: start(n, 4) } }
    let h5 = start(n, 5)
    walk_cb(ignore, h5, true)
    unbox(picked) + unbox(matched) + unbox(w.inner) + TaskHandle::join(h5)
  })
  "r=\{r}"
}

test "branch, match and nested values and a recursive callback stay legal inside the body" allows Exception {
  inspect(nested_and_branches(true), "r=13")
}
