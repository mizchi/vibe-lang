// #3189 review (Codex): the `__hs_` prefix is the compiler's. The host
// stream reader the linked lowering injects is named `__hs_next`, with its
// finisher `__hs_fin`, and is called and pruned by those names. A program's
// own top-level `__hs_fin` shared the name with the injected one, so the
// injected reader could call the program's function, and the prune kept
// both. `vibe check` refuses the spelling at the binder, with the edit first
// (tests/gates/late/run.sh pins the message).
fn __hs_fin(s: Array[Int], v: Int) -> Int {
  Array::get(s, 0) + v + 100
}

export fn main() -> Int {
  __hs_fin([3, 0], 1)
}
