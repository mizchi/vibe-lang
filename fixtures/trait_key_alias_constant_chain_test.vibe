//# Codex on #3995: `A0[T] = (Int, Int)` ignores its argument, so the chain
//# `Ai[T] = A0[A(i-1)[T]]` is `(Int, Int)` at every depth. A size estimate
//# that multiplied a body by its argument counted `A11` past the checker's
//# alias limit and left `impl Mark[A11[Int]]` as written, while the bound
//# `Mark[(Int, Int)]` was expanded. The count follows substitution, so both
//# spell `Mark[(Int, Int)]`.
type A0[T] = (Int, Int)

type A1[T] = A0[A0[T]]

type A2[T] = A0[A1[T]]

type A3[T] = A0[A2[T]]

type A4[T] = A0[A3[T]]

type A5[T] = A0[A4[T]]

type A6[T] = A0[A5[T]]

type A7[T] = A0[A6[T]]

type A8[T] = A0[A7[T]]

type A9[T] = A0[A8[T]]

type A10[T] = A0[A9[T]]

type A11[T] = A0[A10[T]]

trait Mark[X] {
  mark(Self) -> Int
}

struct Note {
  n: Int
}

impl Mark[A11[Int]] for Note {
  mark(self) -> Int {
    self.n
  }
}

fn marked[T: Mark[(Int, Int)]](_ t: T) -> Int {
  T::mark(t)
}

test "an alias chain that ignores its argument" {
  inspect(marked(Note::{ n: 4 }), content = "4")
}
