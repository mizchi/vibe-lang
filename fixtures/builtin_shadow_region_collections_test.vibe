// #3185: a program's own function of a frozen-array conversion or a
// `MutList` / `MutBytes` constructor or exit answers the calls the program
// wrote, on every lane. The checker typed these calls as the builtin while
// wasm-gc called the program's function, and the linear lane rewrote them to
// the builtin ahead of the function table (`compile_call`'s region arms), so
// the two lanes disagreed with each other and linear disagreed with the
// declaration. Each function here answers a type its builtin never does, so a
// call typed as the builtin is refused and a call reaching the builtin
// answers a different value.

fn FrozenArray::from_array(xs: Array[Int]) -> String {
  "own from_array \{Array::length(xs)}"
}

fn FrozenArray::to_array(n: Int) -> Int {
  n * 7
}

fn MutList::empty(n: Int) -> String {
  "own MutList::empty \{n}"
}

fn MutList::freeze(n: Int) -> Int {
  n * 3
}

fn MutList::to_array(n: Int) -> String {
  "own MutList::to_array \{n}"
}

fn MutBytes::empty(n: Int) -> String {
  "own MutBytes::empty \{n}"
}

fn MutBytes::to_bytes(n: Int) -> Int {
  n - 11
}

test "the program's own frozen-array conversions answer" {
  inspect(FrozenArray::from_array([1, 2, 3]), content = "own from_array 3")
  inspect(FrozenArray::to_array(3), content = "21")
}

test "the program's own MutList constructor and exits answer" {
  inspect(MutList::empty(4), content = "own MutList::empty 4")
  inspect(MutList::freeze(5), content = "15")
  inspect(MutList::to_array(6), content = "own MutList::to_array 6")
}

test "the program's own MutBytes constructor and exit answer" {
  inspect(MutBytes::empty(7), content = "own MutBytes::empty 7")
  inspect(MutBytes::to_bytes(4), content = "-7")
}
