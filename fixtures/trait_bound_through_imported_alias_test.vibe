//# #3947: the alias, the impl and the trait come from another module; a bound
//# spelled through the alias or through the expanded type finds that impl.

import ./modules/trait_bound_alias_provider.vibe {
  Alias, Note, Value
}

fn through_int[V: Value[Int]](_ v: V) -> Int {
  V::value(v)
}

fn through_alias[V: Value[Alias]](_ v: V) -> Int {
  V::value(v)
}

test "cross-module" {
  inspect(through_int(Note::{ n: 4 }), content = "4")
  inspect(through_alias(Note::{ n: 5 }), content = "5")
}
