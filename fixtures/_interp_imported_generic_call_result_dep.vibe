// Dependency module for `interp_imported_generic_call_result_test.vibe`
// (#3570): generic functions whose bound threads a witness dictionary, so a
// call to one is complete only once the desugarer has added that argument.
//
// `_`-prefixed, so it is excluded from automatic build roots but stays
// reachable as an explicit relative import target (ADR-0070).

export fn find_eq[T: Eq](xs: Array[T], want: T) -> Option[T] {
  let mut i = 0
  let mut found: Option[T] = None
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if x == want {
      found = Some(x)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

export fn positions_eq[T: Eq](xs: Array[T], want: T) -> Array[Int] {
  let out: Array[Int] = []
  let mut i = 0
  while i < Array::length(xs) {
    if Array::get(xs, i) == want {
      Array::push(out, i)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

export fn count_eq[T: Eq](xs: Array[T], want: T) -> (Int, Int) {
  (Array::length(positions_eq(xs, want)), Array::length(xs))
}
