// #3551 review: the dependency of `impl_trait_dep_type_test.vibe`. A
// trait whose method signature names this module's `Hidden`, and a generic
// caller that hands its implementation one.
export struct Hidden {
  s: String
}

struct Secret {
  s: String
}

export trait Tr {
  make(Hidden) -> Self
  show(Self) -> String
}

export fn call_it[T: Tr](seed: T) -> String {
  let t: T = T::make(Hidden::{ s: "hello" })
  T::show(t)
}

// `Secret` is not exported, so an importer cannot spell it.
export trait Sealed {
  seal(Secret) -> Self
  open_it(Self) -> String
}

export fn call_sealed[T: Sealed](seed: T) -> String {
  let t: T = T::seal(Secret::{ s: "sealed" })
  T::open_it(t)
}
