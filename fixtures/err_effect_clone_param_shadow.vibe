// #1720: a CPS clone seeds every final parameter, not only CPS/inert ones.
// Two safe call sites keep this slot outside the narrow all-literal inert proof;
// the ordinary param still masks the same-named top-level function.
effect Ask {
  Get(Int) -> Int
}

fn pick() -> Int {
  5
}

fn apply(pick: () -> Int) -> Int with Ask {
  let seed = perform Ask::Get(0)
  seed + pick()
}

let _start = () -> Int {
  handle {
    let a = apply(() -> Int {
      7
    })
    let b = apply(pick)
    a + b
  } with Ask {
    Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
