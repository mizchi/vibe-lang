//# #3923 (Codex on #3930): a dependency's exact-shaped `Ordering` stands for
//# the prelude on the wasm-gc lane's merged check, and keeps the derives it
//# wrote itself: the dependency's own `Ordering::default()` still resolves,
//# and the importer gets the prelude's `to_string`.

import ./modules/ordering_exact_shape_default_dep.vibe {
  fallback, sign_of
}

test "the dependency keeps its own derives" {
  inspect(Ordering::to_string(sign_of(0 - 5)), content = "Less")
  inspect(Ordering::to_string(fallback()), content = "Less")
}
