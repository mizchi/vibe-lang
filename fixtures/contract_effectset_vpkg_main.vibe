// ADR-0071 (#755) step 5: consumes fixtures/contract_effectset_vpkg/ (an
// index.vpkg contract declaring both `effect Ask` and `effectset AskAll`
// alongside a bodyless `fn read_one`) through the ordinary package-import
// path, proving `effectset` declarations survive the contract facade
// end to end -- not just parse. Not wired into the __DATA__ single-file
// runtime-fixture harness (it needs the sibling contract_effectset_vpkg/
// package directory); compiled directly by compiler_gate.sh instead, same
// as fixtures/effect_handle_replay_corruption.vibe and friends.
import ./contract_effectset_vpkg { read_one }

// The imported helper exposes Ask; the real entry discharges it (#1683).
export let main = () -> Int {
  handle {
    read_one()
  } with Ask {
    Get => resume(42)
  }
}
