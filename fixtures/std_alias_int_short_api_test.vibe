// #1967: was fixtures/std_alias_int_short_api.vibe + __DATA__.last "ok".
// Stale `import { abs, clamp, is_even }` plus pipe. Current Int::abs /
// Int::clamp / Int::is_even keep the claimed "ok".

import ../lib/@vibe/prelude {
  Int::abs, Int::clamp, Int::is_even
}

test "Int abs clamp is_even keep ok" {
  let a = Int::abs(-5)
  let b = Int::clamp(12, 0, 9)
  let c = Int::is_even(4)
  if eq(a, 5) && eq(b, 9) && c {
    inspect("ok", "ok")
  } else {
    inspect("ng", "ok")
  }
}
