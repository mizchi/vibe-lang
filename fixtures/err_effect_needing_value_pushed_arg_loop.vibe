// #4065: an argument block stores the handle-bound closure inside a loop and
// then reads it back. The read hands the closure at its evidence arity to a
// row-free parameter, which is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    apply(f = {
      for i in [0] {
        Array::push(xs, value = g)
      }
      ()
      Array::get(xs, at = 1)
    })
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
