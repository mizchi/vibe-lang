// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    loop (f = () -> 7, n = 0) {
      if n > 0 {
        break(apply(f = f))
      } else {
        continue(Array::get([g], at = 0), n + 1)
      }
    }
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
