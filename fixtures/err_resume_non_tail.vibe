// #942 (ADR-0050) non-regression pin for ADR-0076 Phase 3a: making
// `resume` legal as a first-class VALUE must not loosen the DIRECT call
// form -- a non-tail `resume(...)` call is still rejected (it is the
// tail-resumptive fast-path eligibility signal). Post-processing belongs
// to the value form (`let k = resume` -- fixtures/
// effect_resume_value_postprocess.vibe).
effect Ask {
  Get(Int) -> Int
}

let _start = () -> Int {
  handle {
    perform Ask::Get(1)
  } with {
    Ask::Get(t) => {
      let r = resume(t + 1)
      r + 7
    }
  }
}
_start()
