// #4065: a `loop` parameter rebound by `continue` to the handle-bound closure,
// then handed to a row-free parameter on the next pass. The parameter starts
// plain, but the second pass reads the closure at its evidence arity, so it
// is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    loop (f = () -> 7, n = 0) {
      if n > 0 {
        break(apply(f = f))
      } else {
        continue(Array::get([g], at = 0), n + 1)
      }
    }
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
