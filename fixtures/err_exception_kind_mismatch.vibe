// ADR-0085 Phase 3 (#1344): `Exception[E1]` does not authorize a throw of kind
// `E2`. This is the whole point of typed exceptions -- without it the row says
// which failures a function has, but the checker lets any of them through.
enum IoError {
  NotFound(String)
}

enum ParseError {
  Eof
}

let boom = () -> Int with Exception[ParseError] {
  throw(NotFound("cfg"))
}

let main = () -> Int {
  handle {
    boom()
  } with Exception {
    Throw(_e) => 42
  }
}
