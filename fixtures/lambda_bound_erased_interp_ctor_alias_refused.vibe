//# #2745: a CONSTRUCTOR bound to a name, then destructured.
//
// Codex, P1 round 8 on #2761, and the route I had listed in #2773 as knowingly
// open -- so this closes a gap I had documented rather than one I missed.
// Measured: `{ let x = B(a); match x { B(b) => b } }` with `a: T` printed
// `252`.
//
// Round 6 paired a `PCtor` against an INLINE `ECall` only, because an inline
// call carries its constructor in the expression. A name does not, so the
// binding now records the constructor's NAME beside the payloads and the
// pattern requires it to match. Without that check, `match x { Some(b) => b }`
// would take an unrelated aggregate's elements apart.
//
// Only a constructor-SHAPED callee is recorded: an ordinary call's result is
// not its arguments, and a `PCtor` pattern naming a lowercase function does not
// exist, so recording one could only mispair.

struct Qt {
  w: Int
}

enum Box1[U] {
  B(U)
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let bx = B(a)
    match bx {
      B(b) => b
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
