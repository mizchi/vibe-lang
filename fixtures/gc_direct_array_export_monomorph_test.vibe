// #1722 boundary monomorphization (ADR-0095 §7.1, decided by measurement in
// #1701). This file used to be `gc_direct_array_abi_export_fallback_test.vibe`
// and pinned the OPPOSITE behaviour: piping a private reference through an
// exported declaration cleared the whole component to tagged i64.
//
// Monomorphization is exactly the lifting of that restriction. The compiler now
// emits a private twin of the exported body; the export keeps the i64 signature
// a host ABI needs and the internal call resolves to the twin. So the reference
// survives the crossing and the island stays up -- the alloc count moved 0 -> 1
// on purpose.

export let exported_array_identity: (Array[Int]) -> Array[Int] = (values) -> values

let internal_array_identity: (Array[Int]) -> Array[Int] = (values) -> values

test "gc direct array ABI falls back for an exported declaration" {
  let values = internal_array_identity([
    40,
    2
  ])
  assert(Array::get(exported_array_identity(values), 1) == 2)
}
