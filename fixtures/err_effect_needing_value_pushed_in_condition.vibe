// #4065: the closure stored into an array by the condition of an `if` whose
// branch then reads it back, as an argument. The condition runs before either
// branch, so the selected branch hands the closure at its evidence arity to a
// row-free parameter, which is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    apply(f = if {
      Array::set(xs, at = 0, value = g)
      true
    } {
      Array::get(xs, at = 0)
    } else {
      () -> 8
    })
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
