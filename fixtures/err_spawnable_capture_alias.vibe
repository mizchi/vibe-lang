// #3125: aliasing TaskGroup::spawn must not skip the Spawnable capture
// check. The literal spelling of this program is err_spawnable_capture_array.vibe.
import @vibe/concurrent { TaskGroup }

fn main() -> Unit allows Exception {
  let seen = [0]
  let sp = TaskGroup::spawn
  let sp2 = sp
  let _r = TaskGroup::run((n) -> {
    sp2(n, () -> {
      Array::set(seen, 0, 1)
      0
    })
  })
  ()
}
