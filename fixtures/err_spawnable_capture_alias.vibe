// #3125: the `Spawnable` capture check keyed on the SPELLING
// `TaskGroup::spawn`, so binding the function to a name first skipped it:
// this program compiled and ran a capture the direct call refuses. The check
// now follows the callee's type, so the alias is refused with the direct
// call's diagnostic (err_spawnable_capture_array.vibe is the direct spelling).
import @vibe/concurrent { TaskGroup, TaskHandle }

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    let sp = TaskGroup::spawn
    let h = sp(n, () -> {
      Array::set(seen, 0, 1)
      0
    })
    TaskHandle::join(h)
  })
  ()
}
