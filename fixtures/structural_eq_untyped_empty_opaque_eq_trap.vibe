//# ADR-0097 fail-closed, the shape that is left after #2157.
//#
//# An unannotated `let xs = []` normally takes its element type from the
//# `Array::push(xs, v)` calls in its own scope. Here both arrays are filled
//# inside a function they are merely passed to, so there is no push in scope to
//# read and no element comparator to select. Once BOTH are non-empty, `==` must
//# trap rather than fall back to identity or to a length-only answer. Adding an
//# element annotation (`let left: Array[Int] = []`) is what makes it valid.

fn fill(xs: Array[Int], v: Int) -> Unit {
  Array::push(xs, v)
}

export fn _start() -> Int {
  let left = [
  ]
  fill(left, 1)
  let right = [
  ]
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
