// #1976/#2376: referencing an imported name in direct wasm-gc single-file
// mode. The import-resolving test lane works; this explicit direct mode does
// not load the dependency, so what is pinned is WHAT IT SAYS.
//
// It used to answer with the codegen internal error ("this is a bug in the
// compiler and not in your program -- please report the source that triggers
// it"), which is false here and sent readers to file reports for a documented
// lane limitation. Three separate wrong explanations reached the docs while
// that message hid the cause (#1929).
import ./gc_import_diag_dep.vibe {
  gc_import_diag_helper
}

export fn main() -> Int {
  gc_import_diag_helper(21)
}
