// #1720: surface loop parameters lower to local binders before suspend CPS;
// that lowered binder must mask an older inert-local proof.
effect Ask {
  Get(Int) -> Int
}

fn maker() -> () -> Int with Ask {
  () -> Int with Ask {
    perform Ask::Get(1)
  }
}

let _start = () -> Int {
  handle {
    let seed = perform Ask::Get(0)
    let pick = () -> Int {
      5
    }
    loop (pick = maker()) {
      let out = seed + pick()
      break out
    }
  } with Ask {
    Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
