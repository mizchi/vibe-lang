// #3004: the builtin `[T: Show]` bound is satisfied at the scalars its prelude
// declares (`impl Show for Int`, `String`, ...), the same as at a
// `derive (Show)` struct. It used to answer ``no impl `Show` for `Int` ``.
struct Pt {
  x: Int
} derive (Show)

fn render[T: Show](x: T) -> String {
  "\{x}"
}

test "the builtin Show bound holds at a scalar and at a derived struct" {
  inspect(render(41), "41")
  inspect(render("abc"), "abc")
  inspect(render(true), "true")
  inspect(render(Pt::{ x: 1 }), "Pt { x: 1 }")
}
