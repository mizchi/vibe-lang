//# #2745: an assignment's value is its CONTINUATION.
//
// Codex, P1 round 4 on #2761. `EAssign` / `EAssignOp` carry their result in the
// continuation, exactly as `ESeq` does, and the walk had arms for one and not the
// others -- so `{ let mut b = a; b = a; b }` fell to the leaf at the assignment,
// which reported nothing. Measured: printed `260`.
//
// This one is why the walk is now enumerated from the AST rather than extended
// whenever a round finds another form. `ELoop` is named explicitly too, with its
// answer ("" -- its value arrives through a `break` this walk does not follow), so
// a reader can see it was decided rather than forgotten.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let mut b = a; b = a; b } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
