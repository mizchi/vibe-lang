test "Double compound assignment uses floating arithmetic" {
  let mut x = Int::to_float64(2) + 0.5
  x += 1.0
  inspect(Float64::to_int(x * 10.0), "35")
  let y = 0.5
  x -= y
  inspect(Float64::to_int(x * 10.0), "30")
  x *= 2.0
  inspect(Float64::to_int(x * 10.0), "60")
  x /= 4.0
  inspect(Float64::to_int(x * 10.0), "15")
}

test "Double compound assignment in a captured mutable cell" {
  let mut x = 1.0
  let bump = () -> Unit {
    x += 0.5
  }
  bump()
  inspect(Float64::to_int(x * 10.0), "15")
}

test "Double compound assignment with captured target and operand" {
  let mut x = 1.0
  let delta = 0.5
  let bump = () -> Unit {
    x += delta
  }
  bump()
  inspect(Float64::to_int(x * 10.0), "15")
}

fn add_assign_params(x: Float64, delta: Float64) -> Float64 {
  let mut value = x
  value += delta
  value
}

test "Double compound assignment with named operands" {
  inspect(Float64::to_int(add_assign_params(x = 2.5, delta = 1.0) * 10.0), "35")
}
