let a = 1000000000
let b = 1000000000000
assert(eq(a, 1000000000))
assert(eq(b, 1000000000000))
// boundary: Int::max_value 2^62 - 1 (#1877: 63-bit range; this fixture is
// compiled by the freshly built stage2, so the new literal bound applies)
let max_val = 4611686018427387903
assert(eq(max_val, 4611686018427387903))
let old_boundary = 2305843009213693951
assert(eq(old_boundary + 1, 2305843009213693952))

