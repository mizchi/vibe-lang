// #3092: a `derive (Show)` type whose parameter no field reads (a phantom
// `T`) renders its fields, so instantiating that parameter at a function or
// `Bytes` is no reason to refuse the interpolation. The refusal side is
// `err_derive_show_generic_fn_arg_refused.vibe`.
struct Label[T] {
  text: String
} derive (Show)

fn inc(x: Int) -> Int {
  x + 1
}

test "phantom function argument renders the fields" {
  let l: Label[(Int) -> Int] = Label::{ text: "inc" }
  inspect("\{l}", "Label { text: inc }")
  inspect(inc(1), 2)
}

test "phantom Bytes argument renders the fields" {
  let l: Label[Bytes] = Label::{ text: "raw" }
  inspect("\{l}", "Label { text: raw }")
}
