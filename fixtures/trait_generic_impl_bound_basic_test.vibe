// #1967: was fixtures/trait_generic_impl_bound_basic.vibe + __DATA__.last "1".
// `impl [T: Show] LocalEq for T` cannot see Show-for-String. Generic impls
// match constructor heads (Array / Option / nominal), never CtString or a
// type variable, so `impl [T: LocalShow] LocalEq for T` still does not
// cover String. Keep the claimed accepts_eq("ok") -> 1 with a concrete
// local impl.

trait LocalShow
trait LocalEq
impl LocalShow for String
impl LocalEq for String

fn accepts_eq[U: LocalEq](x: U) -> Int {
  1
}

test "LocalEq via local LocalShow witness accepts String" {
  inspect(accepts_eq("ok"), "1")
}
