// #731 (ADR-0064 §7 Phase 1): where-contract desugar. requires conditions
// assert at function entry; ensures conditions bind the function value as
// `result` and assert at exit. Satisfying calls pass silently (this file);
// a violating call traps — covered by gate step 6d, since a trap would
// fail this whole test file.

fn clamp(x: Int, lo: Int, hi: Int) -> Int where {
  requires: lo <= hi,
  ensures: result >= lo,
  ensures: result <= hi,
} {
  if x < lo { lo } else if x > hi { hi } else x
}

fn half_pos(_ x: Int) -> Int where {
  requires: x > 0,
} {
  x / 2
}

fn plain(_ x: Int) -> Int { x + 1 }

// #3715: every exit checks `ensures`, so these early returns are checked too;
// they satisfy it, so the calls below return normally. A violating early
// return traps -- gate step 6d (b2).
fn first_positive(_ xs: Array[Int]) -> Int where { ensures: result >= 0 } {
  for x in xs {
    if x > 0 {
      return x
    } else {
      ()
    }
  }
  0
}

fn sign_of(_ x: Int) -> Int where { ensures: result >= 0 - 1, ensures: result <= 1 } {
  match x {
    0 => return 0,
    _ => ()
  }
  if x < 0 {
    return 0 - 1
  } else {
    ()
  }
  1
}

// The body's `let x = 0` shadows the parameter; `ensures` reads the
// parameter `x` at every exit, the early one included.
fn at_least(_ x: Int) -> Int where { ensures: result >= x } {
  let x = 0
  if x == 0 {
    return 1000
  } else {
    ()
  }
  x
}

// A lambda's `return` leaves the lambda, not `outer`, so it is not checked
// against `outer`'s `ensures` (it returns -1).
fn outer(_ n: Int) -> Int where { ensures: result >= 0 } {
  let neg = (k: Int) -> Int {
    return 0 - k
  }
  neg(n) + n + n
}

// The generated checker's name is fresh for each function, so a parameter
// spelled like it is still the parameter.
fn hygiene(_ __vibe_ensures: Int) -> Int where { ensures: result > 0 } {
  __vibe_ensures
}

fn pick[T](a: T, b: T, first: Bool) -> T where { ensures: true } {
  if first {
    return a
  } else {
    ()
  }
  b
}

// A clause is parsed with the token offsets, so a labeled call in it finds
// the argument placement the checker recorded at that call. Before, every
// call in a clause had offset -1 and this file did not compile ("missing or
// invalid checker argument placement for `Array::get`").
fn scaled(_ x: Int, by: Int) -> Int {
  x * by
}

fn head_doubled(_ xs: Array[Int]) -> Int where {
  requires: Array::length(xs) > 0 && Array::get(xs, at = 0) >= 0,
  ensures: result == scaled(Array::get(xs, at = 0), by = 2),
} {
  2 * xs[0]
}

test "where contracts hold on satisfying calls (#731)" {
  assert_eq(clamp(x = 5, lo = 0, hi = 10), 5)
  assert_eq(clamp(x = 0 - 3, lo = 0, hi = 10), 0)
  assert_eq(clamp(x = 99, lo = 0, hi = 10), 10)
  assert_eq(half_pos(8), 4)
  assert_eq(plain(41), 42)
}

test "every exit checks ensures, and a satisfying early return passes (#3715)" {
  assert_eq(first_positive([0 - 1, 0, 7, 9]), 7)
  assert_eq(first_positive([0 - 1]), 0)
  assert_eq(sign_of(0), 0)
  assert_eq(sign_of(0 - 4), 0 - 1)
  assert_eq(sign_of(9), 1)
  assert_eq(at_least(5), 1000)
  assert_eq(outer(3), 3)
  assert_eq(pick(a = 1, b = 2, first = true), 1)
  assert_eq(pick(a = 1, b = 2, first = false), 2)
  assert_eq(hygiene(4), 4)
}

test "a labeled call inside a clause compiles and is checked" {
  assert_eq(head_doubled([3, 9]), 6)
  assert_eq(head_doubled([0]), 0)
}
