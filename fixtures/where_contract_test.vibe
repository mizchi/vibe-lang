// #731 (ADR-0064 §7 Phase 1): where-contract desugar. requires conditions
// assert at function entry; ensures conditions bind the function value as
// `result` and assert at exit. Satisfying calls pass silently (this file);
// a violating call traps — covered by gate step 6d, since a trap would
// fail this whole test file.

fn clamp(x: Int, lo: Int, hi: Int) -> Int where {
  requires: lo <= hi,
  ensures: result >= lo,
  ensures: result <= hi,
} {
  if x < lo { lo } else if x > hi { hi } else x
}

fn half_pos(x: Int) -> Int where {
  requires: x > 0,
} {
  x / 2
}

fn plain(x: Int) -> Int { x + 1 }

test "where contracts hold on satisfying calls (#731)" {
  assert_eq(clamp(5, 0, 10), 5)
  assert_eq(clamp(0 - 3, 0, 10), 0)
  assert_eq(clamp(99, 0, 10), 10)
  assert_eq(half_pos(8), 4)
  assert_eq(plain(41), 42)
}
