// #2978: a shift count saturates at 63, the Int's width. Wasm reduces the
// count mod 64 -- the width of the i64 representation -- so `1 << 63` was 0 and
// `1 << 64` came back as 1. A count of 63 or more, or a negative one, now
// shifts everything out: `<<` gives 0 and `>>` gives the sign (0 or -1).
fn shl(x: Int, n: Int) -> Int {
  x << n
}

fn shr(x: Int, n: Int) -> Int {
  x >> n
}

test "left shifts saturate at the Int width" {
  inspect(shl(1, 62), "-4611686018427387904")
  inspect(shl(1, 63), "0")
  inspect(shl(1, 64), "0")
  inspect(shl(1, 65), "0")
  inspect(shl(1, 0 - 1), "0")
  inspect(shl(3, 2), "12")
}

test "right shifts saturate to the sign" {
  inspect(shr(0 - 1, 63), "-1")
  inspect(shr(0 - 1, 64), "-1")
  inspect(shr(8, 64), "0")
  inspect(shr(8, 0 - 1), "0")
  inspect(shr(0 - 8, 1), "-4")
  inspect(shr(8, 2), "2")
}
