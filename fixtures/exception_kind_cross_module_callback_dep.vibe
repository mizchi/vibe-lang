// Dependency of exception_kind_cross_module_callback_test.vibe: a function
// whose CALLBACK parameter's row spells its kind through an alias the
// importer never sees.
export enum IoErr {
  NotFound(String)
}

type E = IoErr

export fn run_or_zero(f: () -> Int with Exception[E]) -> Int {
  handle { f() } with { Exception[E]::Throw(_) => 0 }
}
