// #3042 (ADR-0115): two modules that both use the prelude `Ordering` without
// declaring it share ONE enum in the linked program. The checker checks each
// module against the same declaration, and the lowering appends it to the
// merged program once, so a `Less` built in the dependency is the `Less` this
// module matches on.

import ./modules/ordering_prelude_dep.vibe {
  Version, newest_first
}

fn label(o: Ordering) -> String {
  match o {
    Less => "less",
    Equal => "equal",
    Greater => "greater"
  }
}

test "an Ordering built in another module matches here" {
  let old = Version::{ major: 1, minor: 2 }
  let new = Version::{ major: 1, minor: 9 }
  inspect(label(Version::compare(old, new)), "less")
  inspect(label(Version::compare(new, old)), "greater")
  inspect(label(Version::compare(old, old)), "equal")
  inspect(label(newest_first(old, new)), "greater")
  inspect(newest_first(new, old) == Less, "true")
}
