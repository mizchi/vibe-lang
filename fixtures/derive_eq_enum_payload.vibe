// derive(Eq) for enum with payloads
enum Shape {
  Circle(Int);
  Rect(Int, Int)
} derive(Eq)

let _start = () -> {
  let a = Circle(5)
  let b = Circle(5)
  let c = Rect(3, 4)
  let d = Circle(6)
  let mut score = 0
  if a == b { score = score + 1 }
  if not(a == c) { score = score + 1 }
  if not(a == d) { score = score + 1 }
  if c == Rect(3, 4) { score = score + 1 }
  score
}
_start()

