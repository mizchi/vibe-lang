//# #2745: an array element that is a constructor reached through a NAME.
//
// Codex, P1 round 21 on #2761. Measured on `b1c3a60`:
// `let av = A(a); let xs = [av, B(0)]`, read out and matched on `A`, printed a
// 3-digit pointer decimal.
//
// Round 18 gave each constructor in an array its own sub-slot and asked "is
// this element a constructor CALL". That is a different question from "what
// constructor does this element have", and the two agree only for the inline
// spelling: `av` is a name, so it got no sub-slot, while `B(0)` did and
// overwrote the shared slot's shape.
//
// One question, one answer: `dtd_interp_ctor_name_of` reads the constructor
// off a call or off a name's recorded shape, so both spellings record alike.
//
// The `B` arm THROWS, as in the round-18 fixture: an arm mentioning the formal
// would refuse this file on its own and the fixture would then pass whatever
// the `A` arm did.

struct Qt {
  w: Int
}

enum Wrap[V] {
  A(V);
  B(Int)
}

fn outer[T](x: T) -> String with Exception {
  let inner = [T](a: T) -> String with Exception {
    "\{ { let av = A(a)
    let xs = [av, B(0)]
    let v = Array::get(xs, 0)
    match v {
      A(b) => b,
      B(_) => throw("no")
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int allows Exception {
  String::length(outer(7))
}
