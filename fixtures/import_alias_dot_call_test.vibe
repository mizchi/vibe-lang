//# #3890: a dot-call on a value whose type was imported under another name
//# reaches the type's own method. After `import { SB as BQ }` the method is
//# bound as `BQ::get`, and `b.get()` answered "no method `get` on `SB`:
//# declare a top-level `fn SB::get(...)`" -- a method that exists. The
//# dependencies declare a same-shaped struct first, so a call dispatched by
//# field set would answer for that one instead.

import ./_struct_alias_literal_shapes_dep.vibe {
  SA, SB as BQ
}

import ./_reexport_alias_companion_facade.vibe {
  R, Other, make
}

fn mk(_ v: Int) -> BQ {
  BQ::{ v: v }
}

test "a dot-call through an import alias reaches the type's method" {
  let a = SA::{ v: 0 }
  let b = BQ::{ v: 4 }
  inspect(b.get(), content = "SB")
  inspect(mk(5).get(), content = "SB")
  inspect(a.get(), content = "SA")
}

test "a dot-call through a re-exported alias reaches the type's method" {
  let o: Other = Other::{ x: 0 }
  let r: R = make(x = 3)
  inspect(r.get(), content = "P 3")
  inspect(make(x = 4).get(), content = "P 4")
  inspect(o.get(), content = "Other")
}
