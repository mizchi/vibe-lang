// #1868: fused SIMD scan for the sparse events in a string body. The builtin
// returns the first quote, backslash, or ASCII control byte, or len.

fn scalar_scan(s: String, pos: Int, len: Int) -> Int {
  let mut i = pos
  let mut done = false
  while i < len && !done {
    let c = String::char_code_at(s, i)
    if c == 34 || c == 92 || c < 32 {
      done = true
    } else {
      i = i + 1
    }
  }
  i
}

#zero_alloc
fn special_scan(s: String, pos: Int, len: Int) -> Int {
  simd_scan_string_special_str(s, pos, len)
}

// The registry is the zero-allocation source of truth for both String SIMD
// scanners; this also closes the older simd_scan_alnum_str allowlist gap.
#zero_alloc
fn alnum_scan(s: String, pos: Int, len: Int) -> Int {
  simd_scan_alnum_str(s, pos, len)
}

fn same_as_scalar(s: String, pos: Int) -> Bool {
  let len = String::length(s)
  special_scan(s, pos, len) == scalar_scan(s, pos, len)
}

test "short and non-zero-offset tails match scalar scan" {
  assert_eq(alnum_scan("identifier!", 0, 11), 10)
  assert(same_as_scalar("plain text", 0))
  assert(same_as_scalar("prefix\\tail", 3))
  assert(same_as_scalar("prefix\"tail", 6))
}

test "full SIMD chunks find quote and backslash boundaries" {
  assert(same_as_scalar("abcdefghijklmnop\"tail", 0))
  assert(same_as_scalar("abcdefghijklmnopqrstuvwxyzABCDE\\tail", 0))
  assert(same_as_scalar("0123456789abcdef0123456789abcdefplain", 0))
}

test "control bytes and UTF-8 byte offsets match scalar scan" {
  assert(same_as_scalar("abcdefghijklmnopqrstu\nrest", 0))
  assert(same_as_scalar("日本語の長い文字列abcdef\\tail", 0))
  assert(same_as_scalar("abc\0def", 0))
}
