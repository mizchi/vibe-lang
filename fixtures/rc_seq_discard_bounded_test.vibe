enum Discarded {
  Item(Array[Int])
}

fn make_discarded(n: Int) -> Discarded {
  Item([n, 1])
}

fn discard_call_result(n: Int) -> Int {
  if n % 2 == 0 {
    make_discarded(n)
  } else {
    make_discarded(n + 1)
  }
  1
}

test "a discarded heap result does not change the following value" {
  inspect(discard_call_result(5), "1")
}

export fn main() -> Int {
  let mut i = 0
  let mut total = 0
  while i < 2000 {
    total = total + discard_call_result(i)
    i = i + 1
  }
  total
}
