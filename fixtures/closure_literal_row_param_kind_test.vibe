// #3013 control: a closure literal that throws the PARAMETER's kind is accepted
// and answers through the callee's arm.
fn takes_int(f: () -> Int with Exception[Int]) -> Int {
  handle {
    f()
  } with { Exception[Int]::Throw(n) => n + 1000 }
}

fn g() -> Int with Exception[String] {
  takes_int(() -> Int { throw(7) })
}

test "a literal throwing the parameter's kind reaches the callee's arm" {
  let r = handle {
    g()
  } with { Exception[String]::Throw(s) => String::length(s) }
  inspect(r, "1007")
}
