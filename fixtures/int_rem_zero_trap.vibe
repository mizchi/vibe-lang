// #3126: `Int` `%` by zero names the operation and the operator's
// `path:line:col` before it traps, on linear and on gc. Pinned by the early
// gate: this program must FAIL at run time with that line.

fn remainder(a: Int, b: Int) -> Int {
  let r = a
  r % b
}

fn main allows Console {
  println("before")
  println("after \{remainder(7, 0)}")
}
