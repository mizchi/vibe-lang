// #4065: an alias of a binding that is later shadowed still shares that
// binding's array. Storing the handle-bound closure through `ys` reaches the
// first `xs`, and a second alias of it (`zs`, bound before the shadowing)
// reads it back, so handing that element to a row-free parameter is refused
// at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    let ys = xs
    let zs = xs
    let xs = [() -> 9]
    Array::push(ys, value = g)
    apply(f = Array::get(zs, at = 1)) + Array::length(xs)
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
