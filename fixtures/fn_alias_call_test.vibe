// Top-level `let f = g` function aliases (lib/@vibe/builtin/float.vibe exports its
// whole API this way). The backend fn tables registered such lets as 0-param
// thunks, so calling through the alias emitted N args against a 0-param
// function — invalid wasm for ANY arity/type. Fixed by retargeting alias
// references to the final EFn def (rewrite_top_level_fn_alias_refs).

let base_add2: (Int, Int) -> Int = (a, b) -> {
  a + b * 10
}

export let alias_add2: (Int, Int) -> Int = base_add2

export let chained_add2: (Int, Int) -> Int = alias_add2

test "call through a top-level fn alias" {
  assert_eq(alias_add2(1, 2), 21)
}

test "call through an alias-of-alias chain" {
  assert_eq(chained_add2(3, 4), 43)
}
