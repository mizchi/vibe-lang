// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    let mut total = 0
    for i in [0, 1] {
      total = total + apply(f = Array::get(xs, at = 0))
      Array::set(xs, at = 0, value = g)
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through pushed loop carried" {
  inspect(result(), content = "213")
}
