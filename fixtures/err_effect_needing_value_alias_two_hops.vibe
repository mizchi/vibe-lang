// #4065: an alias of an alias of the closure, stored in an array and read
// back. Each hop is followed, so the read is the closure itself and handing it
// to a row-free parameter is refused at build time (the one-hop form is
// err_effect_needing_value_alias_in_data.vibe).
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let a = g
    let b = a
    let xs = [b]
    apply(f = Array::get(xs, at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
