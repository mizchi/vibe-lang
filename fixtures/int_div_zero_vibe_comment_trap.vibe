// vibe: a user comment that merely starts like the loader's markers.
// #3126 review: the file is the user's own, so its division by zero is still
// located. Only the loader's exact marker lines mark a synthesized source.

fn quotient(a: Int, b: Int) -> Int {
  let q = a
  q / b
}

fn main allows Console {
  println("before")
  println("after \{quotient(7, 0)}")
}
