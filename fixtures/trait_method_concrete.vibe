// #641 Phase 1 acceptance: method-bearing trait *syntax* with concrete-receiver
// dispatch. The trait declaration stays a marker (its body is skipped); each
// `impl` method is desugared at parse time into a qualified free function
// `Type::method`, so `Point::measure(p)` / `Point::scale(p, k)` resolve by name
// with no new checker or codegen work (see docs/method-bearing-traits-plan.md).
//
// Runs on the seed bumped to carry the PR-1 parser change (#641 Phase 1).
// `self` needs no receiver-type annotation — field-access inference resolves it.

struct Point { x: Int; y: Int }

trait Measurable {
  measure(Self) -> Int
  scale(Self, Int) -> Self
}

impl Measurable for Point {
  measure(self) -> Int { self.x + self.y }
  scale(self, k) -> Point { Point::{ x: self.x * k, y: self.y * k } }
}

test "concrete-receiver trait method dispatch" {
  let p = Point::{ x: 20, y: 1 }
  assert_eq(Point::measure(p), 21)
  let q = Point::scale(p, 2)
  assert_eq(Point::measure(q), 42)
}

test "Self-returning method chains" {
  let p = Point::{ x: 3, y: 4 }
  assert_eq(Point::measure(Point::scale(Point::scale(p, 2), 3)), 42)
}
