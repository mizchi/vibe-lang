// #3219: an immutable shadow inside a mutable binding's body has its own
// Perceus dup budget. The outer mutable-use marker cannot retain the shadow.
enum D { A(Array[Int]) }
fn use(d: D) -> Int { match d { A(xs) => Array::get(xs, 0) } }
fn one(n: Int) -> Int {
  let mut x = A([n])
  let y = {
    let x = A([n + 1])
    use(x) + use(x)
  }
  y + use(x)
}
export fn main() -> Int {
  let mut i = 0
  let mut sum = 0
  while i < 2000 {
    sum = sum + one(i)
    i = i + 1
  }
  sum
}
