//# Functions

// #2158 on the wasm-gc lane (#2156 review). The linear fix recorded declared
// `-> Double` / `-> Float` return types on CompileCtx; the gc lane has its own
// CompileCtxGc and its own two copies of the floatish classifier, so it went
// on rendering a Double that arrived through a CALL as its raw f64 bits.
// Fixing only linear meant `float_return_to_string_test.vibe` asserted the bug
// was gone while `VIBE_TEST_BACKEND=gc` still printed a wrong number.
//
// This file is written so it runs on BOTH lanes: no imports, so the gc
// backend's one-file-at-a-time compilation is satisfied.
//
// It is named in TWO places, because a fixture that only the linear lane runs
// would assert this bug fixed while never touching either gc classifier:
// scripts/test_gc_selfbuild.sh's fixture list, and the `gc-gate` CI job. There
// is no filename-pattern selection for gc -- the gc fixture set is an explicit
// list, so a new file joins it by being added, not by being named a
// particular way. (An earlier draft of this comment claimed a
// `fixtures/*_gc_test.vibe` selection existed. It does not; #2156 review
// caught it, and the file was running on linear only.)

fn half(x: Double) -> Double {
  x / 2.0
}

fn halff(x: Float) -> Float {
  x / 2.0
}

fn quarter(x: Double) -> Double {
  half(half(x))
}

fn count(n: Int) -> Int {
  n + 1
}

fn value() -> Double {
  2.5
}

type AliasedDouble = Double

type AliasedTwice = AliasedDouble

fn aliased() -> AliasedDouble {
  2.5
}

fn aliased_twice() -> AliasedTwice {
  2.5
}

// #2166: the parameterized-alias gap, on the gc lane too. Both lanes read the
// SAME table (compute_float_returning_names), so the fix that made
// `Box[Double]` resolve is shared -- but that is exactly the assumption the
// #2158 split disproved once already, so it is measured here rather than
// inferred from the linear file. Before the fix: 384 on both lanes.
type BoxGc[T] = T

fn via_generic_gc() -> BoxGc[Double] {
  2.5
}

// `f64`/`f32` have always resolved to Double; the old name scan listed only
// "Double" and "Float", so these rendered raw bits on both lanes.
fn as_f64_gc() -> f64 {
  2.5
}

fn as_f32_gc() -> f32 {
  2.5
}

// #2178: a type parameter shadowing a `Double` alias, in RETURN position.
// `shadowed_return` returns the type VARIABLE, not a float. The gc entry runs
// `strip_generic_type_params` before codegen, so the float table was built
// from an EFn whose type params had already been zeroed -- the name then
// resolved through the alias to Double and `__to_string(shadowed_return(7))`
// rendered the tagged Int as f64 bits, printing 0. Linear prints 7.
//
// The value was never wrong (`shadowed_return(7) == 7` held on gc too); only
// the render was, because on this lane the static classification is the ONLY
// signal.
type ShadowedDouble = Double

fn shadowed_return[ShadowedDouble](x: Int) -> ShadowedDouble {
  x
}

// The control that must KEEP being classified: a generic function whose
// return really is Double. Excluding every generic fn would have traded this
// bug for its mirror image.
fn generic_returns_double[T](x: T) -> Double {
  2.5
}

//# Tests

test "#2158 gc: a call to a `-> Double` function stringifies as a Double" {
  assert_true(__to_string(half(5.0)) == "2.5")
}

test "#2158 gc: a let bound to a `-> Double` call stringifies as a Double" {
  let a = half(5.0)
  assert_true(__to_string(a) == "2.5")
}

test "#2158 gc: `-> Float` is classified the same way" {
  assert_true(__to_string(halff(5.0)) == "2.5")
}

test "#2158 gc: a `-> Double` function calling another one" {
  assert_true(__to_string(quarter(10.0)) == "2.5")
}

test "#2158 gc: a `-> Int` function is NOT reclassified as a float" {
  assert_true(__to_string(count(41)) == "42")
}

test "#2156 review gc: the top-level name still resolves" {
  assert_true(__to_string(value()) == "2.5")
}

// The linear fixture's companion case -- a LOCAL binding shadowing a
// top-level `-> Double` function -- is deliberately absent here. It cannot be
// written on the gc lane yet: calling a local lambda that shadows a top-level
// function name traps on gc regardless of any float involvement. Measured on
// stage2 both with and WITHOUT this commit's change, so it is pre-existing and
// unrelated to the float-return table:
//
//   fn value() -> Int { 9 }
//   let value = () -> Int { 1 }
//   value() == 1        // gc: trap `unreachable`;  linear: ok
//   let value = 1       // gc: ok -- a non-function shadow is fine
//
// Filed as #2160. The guard itself IS shared: gc_fn_returns_float takes
// local_names for the same reason its linear twin does, so when that gc bug is
// fixed this case can be added here unchanged.

test "#2156 review gc: a `type` alias onto Double is classified" {
  assert_true(__to_string(aliased()) == "2.5")
}

test "#2156 review gc: an alias chain is followed" {
  assert_true(__to_string(aliased_twice()) == "2.5")
}

test "#2166 gc: a parameterized alias onto Double is classified" {
  assert_true(__to_string(via_generic_gc()) == "2.5")
}

test "#2166 gc: the f64 and f32 spellings are floats" {
  assert_true(__to_string(as_f64_gc()) == "2.5")
  assert_true(__to_string(as_f32_gc()) == "2.5")
}

test "#2178 gc: a return type parameter shadows a Double alias" {
  assert_true(__to_string(shadowed_return(7)) == "7")
}

test "#2178 gc: a generic function really returning Double still is one" {
  assert_true(__to_string(generic_returns_double(1)) == "2.5")
}
