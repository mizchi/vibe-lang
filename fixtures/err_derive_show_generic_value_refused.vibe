// Codex on #3627: `G::to_string` taken as a VALUE skips the direct-call
// specialization (#3559), so calling it rendered `G[Double]`'s elements
// through the erased formal: `G { w: [284, 356] }`. Refused with the edit.
struct G[T] {
  w: Array[T]
} derive (Show)

export let _start: () -> Int = () -> {
  let render: (G[Double]) -> String = G::to_string
  let _ = render(G::{ w: [1.5, 2.5] })
  0
}
