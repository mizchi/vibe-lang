// #3191: a named array used as a for iterable must release its owned storage
// after the loop. The loop body reads all three elements on every round.
fn one_round() -> Int {
  let xs = [1, 2, 3]
  let mut sum = 0
  for x in xs {
    sum = sum + x
  }
  sum
}

export fn main() -> Int {
  let mut i = 0
  let mut total = 0
  while i < 2000 {
    total = total + one_round()
    i = i + 1
  }
  total
}
