fn invoke_nested(callback: () -> () -> Array[Int]) -> () -> Array[Int] {
  callback()
}

test "callback return values retain parameter provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    invoke_nested(() -> () -> Array[Int] {
      () -> Array[Int] {
        MutList::to_array(values)
      }
    })
  }
  let _ = escaped()
}
