// #1967: was fixtures/prelude_to_string_parenthesized_literal_method.vibe
// + __DATA__.last "4". Pipe/dot `to_string` on Double is rejected.
// Current `Double::to_string` / `__to_string` keep length("true") as 4.

test "to_string of true has length 4" {
  inspect(Double::to_string(3.14), "3.14")
  inspect(__to_string(true), "true")
  inspect(String::length(__to_string(true)), "4")
}
