// #2913: `Map::iter_length` was admitted by the checker and emitted nowhere.
// `Map::iter_get` -- its neighbour in the same table -- is real: the lowering
// builds calls to it, so it is NOT refused. Only the phantom is.
fn main() -> Unit allows Console {
  let m = Map::new()
  println(Int::to_string(Map::iter_length(m)))
}
