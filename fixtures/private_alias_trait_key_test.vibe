//# #3958: impls in another module whose trait key and bounds spell a private
//# alias keep dispatching once the merge renames the alias per file: a direct
//# call, a bound through the alias, and a generic impl bounded by it.

import ./modules/private_alias_trait_key_provider.vibe {
  bounded, direct, generic_impl
}

test "a private alias in an impl's trait key and bounds" {
  inspect(direct(3), content = "3")
  inspect(bounded(4), content = "4")
  inspect(generic_impl(5), content = "50")
}
