// #3068: an `Option[Int]` produced by a builtin call inside the
// interpolation. Normalize cannot resolve the call's shape, so the render
// reached the runtime heuristic; linear refused it (#2987) while the gc lane
// printed an allocation address (`809`). Both lanes now refuse the build;
// `let v: Option[Int] = Int::parse("42")` then `\{v}` renders `Some(42)`.
export let _start: () -> Int = () -> {
  let s = "\{Int::parse("42")}"
  String::length(s)
}
