//# #2737: the refusal keys on the BINDER, not on a spelling collision.
//
// #2737 was filed as a shadowing bug, and the first fix was to stop
// `find_dict_for_method` from matching an enclosing binder's dictionary by
// spelling. That closes one route into the hole and leaves the hole: a lambda
// binder spelled differently from every enclosing one never matched any
// dictionary in the first place, so it fell straight through to the same
// unresolved name.
//
// Measured on main at 8f70aa1, `U::equals(a, b)` inside `[U: Eq]` with `outer`
// instantiated at `Pt` answered `true` -- the same wrong answer as the shadowed
// spelling, reached without any shadowing. There is also no enclosing generic
// needed: the `main` call below has one only so this file and the shadowed one
// differ in exactly one character of the binder.
//
// So the condition is "this formal's own binder declared a bound promising the
// method, and no dictionary can serve it", which is why the check reads the
// INNERMOST binder's bound (`dtd_scope_formal_bounds`) rather than asking whether
// a spelling repeats.

trait Eq {
  equals(Self, Self) -> Bool
}

struct Pt {
  v: Int
}

impl Eq for Pt {
  equals(a: Pt, b: Pt) -> Bool {
    a.v == b.v
  }
}

impl Eq for Int {
  equals(a: Int, b: Int) -> Bool {
    a == b
  }
}

fn outer_unshadowed[T: Eq](x: T, y: T) -> Bool {
  let inner = [U: Eq](a: U, b: U) -> Bool {
    U::equals(a, b)
  }
  inner(7, 8)
}

export fn _start() -> Int {
  if outer_unshadowed(Pt::{ v: 1 }, Pt::{ v: 2 }) {
    1
  } else {
    0
  }
}
