// #1722 boundary monomorphization: the identity half.
//
// Monomorphization won over a materializing conversion point on two counts
// (#1701): it measured 76 percentage points cheaper, and -- decisive -- a
// materializing point COPIES, so a caller stops seeing mutations made through
// the boundary. Nothing here is copied: the export and its twin share one body,
// so there is exactly one array.
//
// That is what the second assertion checks. `bump` mutates through the boundary
// twice; reading through the ORIGINAL binding has to show both. A copying
// conversion point passes the first assertion and fails the second.

export let bump: (Array[Int]) -> Array[Int] = (values) -> {
  Array::set(values, 0, Array::get(values, 0) + 1)
  values
}

test "an internal call to an exported transform keeps one array" {
  let xs = [
    1,
    2
  ]
  let out = bump(bump(xs))
  inspect(Array::get(out, 0), "3")
  inspect(Array::get(xs, 0), "3")
  inspect(Array::get(out, 1), "2")
}
