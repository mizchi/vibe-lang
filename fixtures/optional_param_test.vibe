// #1500: optional parameters end to end -- omitted, supplied positionally,
// supplied by label, and two optionals with a partial suffix.
fn d(x: Int, z?: Int) -> String {
  match z {
    Some(v) => Int::to_string(v),
    None => "none"
  }
}

fn labeled(x~: Int, z?: Int) -> String {
  match z {
    Some(v) => Int::to_string(v + x),
    None => "none"
  }
}

fn two(x: Int, y?: Int, z?: Int) -> Int {
  let a = match y {
    Some(v) => v,
    None => 0
  }
  let b = match z {
    Some(v) => v,
    None => 0
  }
  x + a + b
}

test "optional parameter may be omitted" {
  assert(d(1) == "none")
}

test "optional parameter supplied positionally is wrapped" {
  assert(d(1, 10) == "10")
}

test "optional parameter supplied by label" {
  assert(labeled(x = 1, z = 10) == "11")
  assert(labeled(x = 1) == "none")
}

test "a partial suffix of optionals is filled" {
  assert(two(1) == 1)
  assert(two(1, 2) == 3)
  assert(two(1, 2, 3) == 6)
}

test "a block-local lambda optional may be omitted" {
  let o = (a: Int, b?: Int) -> Int {
    match b {
      Some(v) => a + v,
      None => a
    }
  }
  assert(o(7) == 7)
  assert(o(7, 5) == 12)
}
