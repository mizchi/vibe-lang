//# Codex round 5 on #2456: the rule for a source-owned generic enum is the
//# same whatever it is called. `Wrap[Int]` elements filled through a
//# function answer through the derived `Wrap::equals`, whose raw word `==`
//# on the `Int` payload is content equality.

enum Wrap[T] {
  W(T);
  Empty
}

fn fill(xs: Array[Wrap[Int]], v: Int) -> Unit {
  Array::push(xs, W(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  let other = []
  fill(other, 2)
  let empties = []
  Array::push(empties, Empty)
  assert(left == right)
  assert(left != other)
  assert(left != empties)
  0
}
