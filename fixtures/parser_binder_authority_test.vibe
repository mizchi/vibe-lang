test "placeholder insertion retains argument marks beside shorthand" {
  let source = "let f = () -> { g(((q) -> { q })(1) + _, x -> x) }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "4")
      match (Array::get(rows, at = 1), Array::get(rows, at = 2), Array::get(rows, at = 3)) {
        (Synthetic(param, _), SourceToken(q, qs, qe), SourceToken(x, xs, xe)) => {
          inspect(param, "__ph0")
          inspect(q, "q")
          inspect(String::substring(source, start = qs, end = qe), "q")
          inspect(x, "x")
          inspect(String::substring(source, start = xs, end = xe), "x")
        },
        _ => inspect(false, "true")
      }
    },
    None => inspect(false, "true")
  }
}

test "binder spans are UTF-8 byte offsets and shadowing rows stay distinct" {
  let source = "let x = \"é\"\nlet x = 2"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "2")
      match (Array::get(rows, at = 0), Array::get(rows, at = 1)) {
        (SourceToken(left, ls, le), SourceToken(right, rs, re)) => {
          inspect(left, "x")
          inspect(right, "x")
          inspect(ls != rs, "true")
          inspect(String::substring(source, start = ls, end = le), "x")
          inspect(String::substring(source, start = rs, end = re), "x")
        },
        _ => inspect(false, "true")
      }
    },
    None => inspect(false, "true")
  }
}

test "supported declaration and import rows publish in final AST order" {
  let source = "import ./dep.vibe { Thing as Local }\ntype Box[T] = T\neffectset Audit = { Log }\nresource Posts : S3::Bucket\nextern let %read_file: (String) -> String"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "6")
      let expected = [
        "Local",
        "Box",
        "T",
        "Audit",
        "Posts",
        "%read_file"
      ]
      let mut i = 0
      while i < Array::length(rows) {
        match Array::get(rows, at = i) {
          SourceToken(name, _, _) => inspect(name == Array::get(expected, at = i), "true"),
          _ => inspect(false, "true")
        }
        i = i + 1
      }
    },
    None => inspect(false, "true")
  }
}

