test "interpolation binder spans remain absolute source bytes" {
  let source = "let f = (x) -> { \"é=\\{((y) -> { y })(x)}\" }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      match Array::get(rows, at = 2) {
        SourceToken(name, start, end) => {
          inspect(name, "y")
          inspect(String::substring(source, start = start, end = end), "y")
          inspect(start > 20, "true")
        },
        _ => inspect(false, "true")
      }
    },
    None => inspect(false, "true")
  }
}

test "binder capture contexts own isolated mutable row stores" {
  let first = binder_capture_context(starts = [
    0
  ], ends = [
    1
  ])
  let second = binder_capture_context(starts = [
    0
  ], ends = [
    1
  ])
  binder_capture_source(context = Some(first), name = "a", first_token = 0, last_token = 0)
  inspect(Array::length(binder_capture_rows(first)), "1")
  inspect(Array::length(binder_capture_rows(second)), "0")
  binder_capture_source(context = Some(second), name = "b", first_token = 0, last_token = 0)
  inspect(Array::length(binder_capture_rows(first)), "1")
  inspect(Array::length(binder_capture_rows(second)), "1")
}

test "row segment discard retains later rows and poisons malformed marks" {
  let context = binder_capture_context(starts = [
    0,
    2,
    4
  ], ends = [
    1,
    3,
    5
  ])
  binder_capture_source(context = Some(context), name = "a", first_token = 0, last_token = 0)
  binder_capture_source(context = Some(context), name = "b", first_token = 1, last_token = 1)
  binder_capture_source(context = Some(context), name = "c", first_token = 2, last_token = 2)
  binder_capture_discard_segment(context = Some(context), start = 1, end = 2)
  let rows = binder_capture_rows(context)
  inspect(Array::length(rows), "2")
  match (Array::get(rows, at = 0), Array::get(rows, at = 1)) {
    (SourceToken(a, _, _), SourceToken(c, _, _)) => {
      inspect(a, "a")
      inspect(c, "c")
    },
    _ => inspect(false, "true")
  }
  binder_capture_discard_segment(context = Some(context), start = 0, end = 3)
  inspect(binder_capture_is_eligible(context), "false")
  binder_capture_discard_segment(context = None, start = -1, end = 999)
}

test "unsupported and forged lanes fail closed" {
  let unsupported = [
    "struct Cell { value: Int }"
  ]
  for source in unsupported {
    inspect(match parse_source_located_with_binder_authority(source) {
      Some(_) => true,
      None => false
    }, "false")
  }
  let source = "let x = 1"
  let forged = binder_capture_context(starts = [
    0
  ], ends = [
    99
  ])
  binder_capture_source(context = Some(forged), name = "x", first_token = 0, last_token = 0)
  // The forged context cannot be passed to the source-owning entry.
  inspect(match parse_source_located_with_binder_authority(source) {
    Some(_) => true,
    None => false
  }, "true")
}

test "contract rows follow lowered requires checker result ensures body order" {
  // #3715: `ensures` is checked by a closure bound before the body, so its
  // name and its `result` parameter are the two synthetic rows, and the
  // conditions' rows precede the body's.
  let source = "fn f(x: Int) -> Int where { requires: ((r) -> { r })(true), ensures: ((e) -> { e })(true) } { ((b) -> { b })(x) }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "7")
      let expected = [
        "f",
        "x",
        "r",
        "__vibe_ensures",
        "result",
        "e",
        "b"
      ]
      let mut i = 0
      for row in rows {
        match row {
          SourceToken(name, start, end) => {
            inspect(name == Array::get(expected, at = i), "true")
            inspect(String::substring(source, start = start, end = end), name)
          },
          Synthetic(name, _) => {
            inspect(i == 3 || i == 4, "true")
            inspect(name == Array::get(expected, at = i), "true")
          }
        }
        i = i + 1
      }
    },
    None => inspect(false, "true")
  }
}

test "a loop contract keeps the issue's while authority" {
  // #3789: a loop `where` clause used to make the whole file's authority
  // unavailable.
  inspect(rendered_rows("fn f(n: Int) -> Int {\n  let mut i = 0\n  while i < n where { invariant: i <= n } {\n    i = i + 1\n  }\n  i\n}"), "some: f@3 n@5 i@32 ~__vibe_clause")
}

test "contracted while rows follow measure cells clauses condition body order" {
  // #3789: the lowering binds the measure cells around the loop, then
  // checks every invariant and then the measure (`<stem>_dec_now`), each
  // through a `__vibe_clause` lambda, ahead of the condition. The clauses
  // were written invariant, decreases, invariant.
  inspect(rendered_rows("fn f(n: Int) -> Int {\n  let mut i = 0\n  while ((c) -> { c })(i < n) where { invariant: ((a) -> { a })(i <= n), decreases: ((d) -> { d })(n - i), invariant: ((b) -> { b })(i >= 0) } {\n    let s = i\n    i = s + 1\n  }\n  i\n}"), "some: f@3 n@5 i@32 ~__loop_17_dec_prev ~__loop_17_dec_seen ~__vibe_clause a@89 ~__vibe_clause b@158 ~__loop_17_dec_now ~__vibe_clause d@124 c@48 s@191")
}

test "nested contracted while rows stay inside the outer body" {
  inspect(rendered_rows("let f = (n: Int) -> { let mut i = 0\n while i < n where { invariant: i <= n } { let mut j = 0\n while j < i where { decreases: i - j } { j = j + 1 }\n i = i + 1 }\n i }"), "some: f@4 n@9 i@30 ~__vibe_clause j@87 ~__loop_36_dec_prev ~__loop_36_dec_seen ~__loop_36_dec_now ~__vibe_clause")
}

test "contracted for rows follow cells checkpoint clauses head body value body order" {
  // #3789: a `for` checkpoint is a closure (`<stem>_check`) bound before the
  // loop, and the body's value is kept in `<stem>_body`. `for k, v` binds
  // the value before the index.
  inspect(rendered_rows("let f = (xs: Array[Int]) -> { let mut t = 0\n for k, v in xs where { decreases: ((d) -> { d })(10 - t), invariant: ((a) -> { a })(t >= 0) } { let w = v\n t = t + w + k }\n t }"), "some: f@4 xs@9 t@38 ~__loop_20_dec_prev ~__loop_20_dec_seen ~__loop_20_check ~__vibe_clause a@116 ~__loop_20_dec_now ~__vibe_clause d@81 v@52 k@49 ~__loop_20_body w@145")
  inspect(rendered_rows("let f = (xs: Array[Int]) -> { let mut t = 0\n for x in ((ys) -> { ys })(xs) where { invariant: t >= 0 } { if x > 0 { continue } else { () }\n t = t + x }\n t }"), "some: f@4 xs@9 t@38 ~__loop_20_check ~__vibe_clause x@49 ys@56 ~__loop_20_body")
}

test "contracted loop rows place the contract between loop result and body" {
  // #3789: a `loop` lowers to `while true`, so it has no head; with
  // parameters, `__loop_result` comes after them and before the contract.
  inspect(rendered_rows("let f = () -> { let mut i = 0\n loop where { invariant: ((a) -> { a })(i >= 0), decreases: 10 - i } { let j = i\n if j > 5 { break } else { () }\n i = j + 1 } }"), "some: f@4 i@24 ~__loop_13_dec_prev ~__loop_13_dec_seen ~__vibe_clause a@57 ~__loop_13_dec_now ~__vibe_clause j@105")
  inspect(rendered_rows("let f = () -> { loop (i = 0) where { invariant: ((a) -> { a })(i >= 0), decreases: 10 - i } { if i > 5 { break(i) } else { continue(((c) -> { c })(i + 1)) } } }"), "some: f@4 i@22 ~__loop_result ~__loop1_7_dec_prev ~__loop1_7_dec_seen ~__vibe_clause a@50 ~__loop1_7_dec_now ~__vibe_clause ~__lt0 c@134")
}

test "block-local nested record destructuring rows mirror every lowered slot" {
  let source = "let f = () -> { let record { x: a, y: (b, c) } = record { x: 1, y: (2, 3) }; a + b + c }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "6")
      let expected = [
        "f",
        "__rec_destr",
        "a",
        "__rec_sub_1",
        "b",
        "c"
      ]
      let mut i = 0
      for row in rows {
        match row {
          SourceToken(name, start, end) => {
            inspect(name == Array::get(expected, at = i), "true")
            inspect(String::substring(source, start = start, end = end), name)
          },
          Synthetic(name, _) => inspect(name == Array::get(expected, at = i), "true")
        }
        i = i + 1
      }
    },
    None => inspect(false, "true")
  }
}

test "inactive cfg rollback discards rows and restores eligibility" {
  let source = "#cfg(dev)\nstruct Hidden { value: Int }\n#cfg(dev)\nlet hidden = (leaked) -> { leaked }\nlet live = (kept) -> { kept }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "2")
      match (Array::get(rows, at = 0), Array::get(rows, at = 1)) {
        (SourceToken(first, fs, fe), SourceToken(second, ss, se)) => {
          inspect(first, "live")
          inspect(second, "kept")
          inspect(String::substring(source, start = fs, end = fe), "live")
          inspect(String::substring(source, start = ss, end = se), "kept")
        },
        _ => inspect(false, "true")
      }
    },
    None => inspect(false, "true")
  }
}

