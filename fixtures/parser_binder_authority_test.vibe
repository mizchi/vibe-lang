//# Imports

import ../lib/@vibe/parser {
  SourceBinder,
  binder_capture_context,
  binder_capture_discard_segment,
  binder_capture_is_eligible,
  binder_capture_rows,
  binder_capture_source,
  located_program_binder_authority_program,
  located_program_binder_authority_rows,
  parse_source_located_with_binder_authority,
  validate_program_binder_rows
}

//# Functions

/// The published rows of `source` on one line: `name@start` for a source row,
/// `~name` for a synthetic one, or `none` when no authority is published. A
/// source row whose span does not spell its name renders as `!name`.
fn rendered_rows(_ source: String) -> String with Exception {
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let mut out = "some:"
      for row in located_program_binder_authority_rows(authority) {
        out = match row {
          SourceToken(name, start, end) => if String::substring(source, start = start, end = end) == name {
            "\{out} \{name}@\{start}"
          } else {
            "\{out} !\{name}"
          },
          Synthetic(name, _) => "\{out} ~\{name}"
        }
      }
      out
    },
    None => "none"
  }
}

//# Tests

test "source-owning binder authority publishes exact supported rows" {
  let source = "let f = (x) -> { x }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "2")
      match Array::get(rows, at = 0) {
        SourceToken(name, start, end) => {
          inspect(name, "f")
          inspect(String::substring(source, start = start, end = end), "f")
        },
        _ => inspect(false, "true")
      }
      match Array::get(rows, at = 1) {
        SourceToken(name, start, end) => {
          inspect(name, "x")
          inspect(String::substring(source, start = start, end = end), "x")
        },
        _ => inspect(false, "true")
      }
    },
    None => inspect(false, "true")
  }
}

test "call shorthand lambda captures its source binder" {
  let source = "let f = (xs) -> { map(xs, x -> x) }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "3")
      let expected = [
        "f",
        "xs",
        "x"
      ]
      let mut i = 0
      for row in rows {
        match row {
          SourceToken(name, start, end) => {
            inspect(name == Array::get(expected, at = i), "true")
            inspect(String::substring(source, start = start, end = end), name)
          },
          _ => inspect(false, "true")
        }
        i = i + 1
      }
    },
    None => inspect(false, "true")
  }
}

test "UTF-8 call arguments preserve shorthand authority order and exact spans" {
  let source = "// é\nlet f = () -> { use(((p) -> { p })(1), x -> { let inner = ((q) -> { q })(x); inner }, ((r) -> { r })(2)) }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "6")
      let expected_names = [
        "f",
        "p",
        "x",
        "inner",
        "q",
        "r"
      ]
      let expected_starts = [
        10,
        28,
        45,
        56,
        66,
        94
      ]
      let expected_ends = [
        11,
        29,
        46,
        61,
        67,
        95
      ]
      let mut i = 0
      for row in rows {
        match row {
          SourceToken(name, start, end) => {
            inspect(name == Array::get(expected_names, at = i), "true")
            inspect(start == Array::get(expected_starts, at = i), "true")
            inspect(end == Array::get(expected_ends, at = i), "true")
            inspect(String::substring(source, start = start, end = end), name)
          },
          _ => inspect(false, "true")
        }
        i = i + 1
      }
    },
    None => inspect(false, "true")
  }
}

