    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "2")
      match (Array::get(rows, at = 0), Array::get(rows, at = 1)) {
        (SourceToken(first, fs, fe), SourceToken(second, ss, se)) => {
          inspect(first, "before")
          inspect(second, "after")
          inspect(String::substring(source, start = fs, end = fe), "before")
          inspect(String::substring(source, start = ss, end = se), "after")
        },
        _ => inspect(false, "true")
      }
    },
    None => inspect(false, "true")
  }
}

