    None => inspect(false, "true")
  }
}

test "nested guard fallback and continuation rows compose in final AST order" {
  let source = "let f = (a, b, c) -> { guard a is Some(x) else { guard b is Some(y) else { return ((fb_inner) -> { fb_inner })(-1) }; return ((fb_outer) -> { fb_outer })(y) }; guard c is Some(z) else { return ((cont_fb) -> { cont_fb })(-2) }; let done = ((cont) -> { cont })(x + z); done }"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let rows = located_program_binder_authority_rows(authority)
      inspect(Array::length(rows), "12")
      let expected_names = [
        "f",
        "a",
        "b",
        "c",
        "x",
        "z",
        "done",
        "cont",
        "cont_fb",
        "y",
        "fb_outer",
        "fb_inner"
      ]
      let expected_starts = [
        4,
        9,
        12,
        15,
        39,
        176,
        231,
        240,
        195,
        65,
        127,
