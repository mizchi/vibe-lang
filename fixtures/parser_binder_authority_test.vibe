test "deliberately unsupported binder lanes remain unavailable" {
  let unsupported = [
    "enum Choice { A; B }",
    "struct Cell { value: Int }",
    "let f = (x) -> { match x { Some(a) | None => a } }"
  ]
  for source in unsupported {
    inspect(match parse_source_located_with_binder_authority(source) {
      Some(_) => true,
      None => false
    }, "false")
  }
}

test "validator rejects missing extra reordered and invalid spans" {
  let source = "let x = 1"
  match parse_source_located_with_binder_authority(source) {
    Some(authority) => {
      let program = located_program_binder_authority_program(authority)
      inspect(validate_program_binder_rows(program = program, rows = [
      ], source = source), "false")
      inspect(validate_program_binder_rows(program = program, rows = [
        SourceToken("x", 4, 5),
        SourceToken("extra", 0, 3)
      ], source = source), "false")
      inspect(validate_program_binder_rows(program = program, rows = [
        SourceToken("x", 0, 3)
      ], source = source), "false")
      inspect(validate_program_binder_rows(program = program, rows = [
        SourceToken("x", 4, 4)
      ], source = source), "false")
      inspect(validate_program_binder_rows(program = program, rows = [
        SourceToken("x", 4, 99)
      ], source = source), "false")
    },
    None => inspect(false, "true")
  }
}
