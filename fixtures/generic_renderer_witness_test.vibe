trait Show {
  to_string(Self) -> String
}

struct Point { value: Int }

impl Show for Point {
  to_string(point: Point) -> String {
    "point=\{point.value}"
  }
}

fn bounded[T: Show](value: T) -> String {
  "value=\{value}"
}

fn explicit[T](value: T, render: (T) -> String) -> String {
  "value=\{render(value)}"
}

fn shim[T](value: T) -> String {
  "\{value}"
}

test "#2840: a method-bearing Show witness renders the value" {
  inspect(bounded(Point::{ value: 5 }), "value=point=5")
}

test "#2840: an explicit renderer works for both objects and Bool" {
  inspect(explicit(Point::{ value: 5 }, Point::to_string), "value=point=5")
  inspect(explicit(true, (value: Bool) -> String {
    if value {
      "yes"
    } else {
      "no"
    }
  }), "value=yes")
}

test "#2840: direct shim calls still use the concrete argument type" {
  inspect(shim(Point::{ value: 5 }), "point=5")
  inspect(shim(true), "true")
}
