trait Show {
  to_string(Self) -> String
}

struct Point { value: Int }

impl Show for Point {
  to_string(point: Point) -> String {
    "point=\{point.value}"
  }
}

fn bounded[T: Show](value: T) -> String {
  "value=\{value}"
}

fn explicit[T](value: T, render: (T) -> String) -> String {
  "value=\{render(value)}"
}

fn shim[T](value: T) -> String {
  "\{value}"
}

test "#2840: a method-bearing Show witness renders the value" {
  inspect(bounded(Point::{ value: 5 }), "value=point=5")
}

test "#2840: an explicit renderer works for both objects and Bool" {
  inspect(explicit(Point::{ value: 5 }, Point::to_string), "value=point=5")
  inspect(explicit(true, (value: Bool) -> String {
    if value {
      "yes"
    } else {
      "no"
    }
  }), "value=yes")
}

test "#2840: direct shim calls still use the concrete argument type" {
  inspect(shim(Point::{ value: 5 }), "point=5")
  inspect(shim(true), "true")
}

fn array_shim[T](values: Array[T]) -> String {
  "\{values}"
}

test "#2840: a direct array shim expands with its concrete element type" {
  inspect(array_shim([true, false]), "[true, false]")
  inspect(array_shim([Point::{ value: 5 }]), "[point=5]")
}

fn array_bounded[T: Show](values: Array[T]) -> String {
  "values=\{values}"
}

// A bare parameter carries the dictionary for wrapper shapes beyond Array[T].
fn tuple_bounded[T: Show](anchor: T, values: (T, Bool)) -> String {
  "values=\{values}"
}

fn option_bounded[T: Show](anchor: T, value: Option[T]) -> String {
  "value=\{value}"
}

fn nested_bounded[T: Show](anchor: T, values: Array[(T, Bool)]) -> String {
  "values=\{values}"
}

test "#2840: wrapper expansion renders elements through their witness" {
  let point = Point::{ value: 5 }
  inspect(array_bounded([point]), "values=[point=5]")
  inspect(tuple_bounded(point, (point, false)), "values=(point=5, false)")
  inspect(option_bounded(point, Some(point)), "value=Some(point=5)")
  inspect(nested_bounded(point, [(point, true)]), "values=[(point=5, true)]")
}
