//# Functions

// HOF with function-typed parameters
fn apply_int(f: (Int) -> Int, x: Int) -> Int { f(x) }

fn make_greeter(greeting: String) -> (String) -> String {
  (name) -> { String::concat(String::concat(greeting, " "), name) }
}

fn compose(f: (Int) -> Int, g: (Int) -> Int) -> (Int) -> Int {
  (x) -> { f(g(x)) }
}

fn twice(f: (Int) -> Int, x: Int) -> Int { f(f(x)) }

//# Misc

test "HOF with Int args" {
  let double: (Int) -> Int = (x) -> { x * 2 }
  let result = apply_int(double, 21)
  assert(result == 42)
}

test "function returning function" {
  let hello = make_greeter("hello")
  let hi = make_greeter("hi")
  assert(hello("world") == "hello world")
  assert(hi("there") == "hi there")
}

test "function composition" {
  let add1: (Int) -> Int = (x) -> { x + 1 }
  let mul2: (Int) -> Int = (x) -> { x * 2 }
  let add1_then_mul2 = compose(mul2, add1)
  let mul2_then_add1 = compose(add1, mul2)
  assert(add1_then_mul2(3) == 8)
  assert(mul2_then_add1(3) == 7)
}

test "apply function twice" {
  let add3: (Int) -> Int = (x) -> { x + 3 }
  assert(twice(add3, 10) == 16)
}

test "HOF with lambda" {
  let result = apply_int((x: Int) -> Int { x * x }, 7)
  assert(result == 49)
}

test "Array::map as HOF" {
  let double: (Int) -> Int = (x) -> { x * 2 }
  let arr = Array::map([1, 2, 3], double)
  assert(arr[0] == 2)
  assert(arr[1] == 4)
  assert(arr[2] == 6)
}

test "Array::filter with predicate" {
  let evens = Array::filter([1, 2, 3, 4, 5, 6], x -> x % 2 == 0)
  assert(Array::length(evens) == 3)
  assert(evens[0] == 2)
  assert(evens[1] == 4)
}

test "Array::fold with function" {
  let sum = Array::fold([1, 2, 3, 4], 0, (a, b) -> a + b)
  assert(sum == 10)
}

test "Array::any predicate" {
  assert(Array::any([1, 2, 3], x -> x == 2) == true)
  assert(Array::any([1, 2, 3], x -> x == 5) == false)
}

test "Array::all predicate" {
  assert(Array::all([2, 4, 6], x -> x % 2 == 0) == true)
  assert(Array::all([2, 3, 6], x -> x % 2 == 0) == false)
}

test "chained Array ops" {
  let arr = [1, 2, 3, 4, 5, 6, 7, 8]
  let evens = Array::filter(arr, x -> x % 2 == 0)
  let doubled = Array::map(evens, x -> x * 2)
  assert(doubled[0] == 4)
  assert(doubled[1] == 8)
  assert(doubled[2] == 12)
  assert(doubled[3] == 16)
}

test "HOF with String type" {
  let apply: ((String) -> String, String) -> String = (f, x) -> f(x)
  let exclaim: (String) -> String = (s) -> String::concat(s, "!")
  assert(apply(exclaim, "hello") == "hello!")
}

test "HOF with Bool return" {
  let check: ((Int) -> Bool, Int) -> Bool = (f, x) -> f(x)
  let is_positive: (Int) -> Bool = (x) -> x > 0
  assert(check(is_positive, 5))
  assert(not(check(is_positive, -1)))
}
