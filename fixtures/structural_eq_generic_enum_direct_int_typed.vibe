//# #2457 row 4, closed by #2467: `let a: Wrap[Int] = W(64 << 32)` compared
//# through the derived `Wrap::equals`, whose formal-typed payload went through
//# the erased `==` -- the generic `eq` builtin, whose string fall-back read
//# `64 << 32` and `65 << 32` as EQUAL. Measured on the stage2 from main at
//# 7018aca: `a == b` below answered `true`; at 50801e0 (after #2471) the same
//# compare trapped, fail-closed. The specialized `Wrap::equals__Int` compares
//# the payload as an exact i64 equality and answers.

enum Wrap[T] {
  W(T);
  Empty
}

export fn _start() -> Int {
  let a: Wrap[Int] = W(64 << 32)
  let b: Wrap[Int] = W(65 << 32)
  let c: Wrap[Int] = W(64 << 32)
  let e: Wrap[Int] = Empty
  assert(a != b)
  assert(a == c)
  assert(a != e)
  assert(e == e)
  0
}
