// A generic whose bound is supplied as a witness at each call cannot be named
// as a value: the reference carries no witness, and the module it produced
// failed wasm validation (`not enough arguments on the stack for call`).
fn same[T: Eq](x: T, y: T) -> Bool {
  x == y
}

export let _start: () -> Int = () -> {
  let g = same
  if g(1, 1) {
    1
  } else {
    0
  }
}
