// #2971: a nested container renders every level. Every non-tuple composite
// shape used to take the ARRAY renderer, so the `Option` element of an
// `Array[Option[Int]]` was walked with `Array::length` / `Array::get`:
// `[None, Some(0), Some(1)]` rendered `[[], [0], [0]]` and
// `Option[Option[Int]]` rendered `Some(536)`.
//
// #2993: a `Double` inside a container renders as a number. The element is a
// synthesized binder whose type only this pass knew, so codegen printed the
// boxed Double's address (`[352, 360]`).

test "nested Option and Array[Option] render every level" {
  let a: Option[Option[Int]] = Some(Some(1))
  let n: Option[Option[Int]] = Some(None)
  let xs: Array[Option[Int]] = [None, Some(0), Some(1)]
  let t: (Option[Int], Int) = (Some(3), 4)
  inspect("\{a}", "Some(Some(1))")
  inspect("\{n}", "Some(None)")
  inspect("\{xs}", "[None, Some(0), Some(1)]")
  inspect("\{t}", "(Some(3), 4)")
}

test "a Double inside a container renders as a number" {
  let ds: Array[Double] = [0.5, 2.25]
  let od: Option[Double] = Some(3.25)
  inspect("\{[1.5, 2.25]}", "[1.5, 2.25]")
  inspect("\{(1.5, true)}", "(1.5, true)")
  inspect("\{ds}", "[0.5, 2.25]")
  inspect("\{od}", "Some(3.25)")
}
