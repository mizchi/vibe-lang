// #2760: an owning mutable slot assigned a WRAPPER whose result spine ends in
// a borrow.
//
// The assignment lowering decided whether a replacement value borrows by
// reading its TOP node -- a projection, or a direct call with a borrow
// contract. A wrapper (a block, i.e. an `ELet` / `ESeq` chain) is neither, so
// no retain was emitted while the slot stayed owning. Its drop then released
// an element the container still owns, and the next read of that element
// answered with whatever allocation reused the freed block.
//
// Measured before the fix: `770` on `VIBE_RC=0` and **`850`** on the default
// RC lane, no trap. `850` reads the second `total(Array::get(xs, 0))` as 15 --
// the filler -- instead of 7.
//
// The lanes must agree, which is what each case here asserts: every expected
// value is the bump lane's answer.
enum Node {
  Leaf(Int);
  Pair(Node, Node)
}

struct Holder {
  node: Node
}

fn total(n: Node) -> Int {
  match n {
    Pair(a, b) => total(a) + total(b),
    Leaf(v) => v
  }
}

// The issue's shape: a block around a borrow-returning builtin.
fn assign_wrapped_call(xs: Array[Node]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let k = 0
    Array::get(xs, k)
  }
  let r = total(x)
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(Array::get(xs, 0)) * 10 + total(filler) * 0
}

// The other unowned leaf kind, through the same wrapper: a PROJECTION. Both
// are enumerated by one spine walk rather than one kind per review round.
fn assign_wrapped_proj(h: Holder) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let k = 0
    h.node
  }
  let r = total(x)
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(h.node) * 10 + total(filler) * 0
}

// An `ESeq` spine reaches the same leaf without binding anything, so the walk
// must not depend on a binder being present.
fn assign_seq_call(xs: Array[Node]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    0
    Array::get(xs, 0)
  }
  let r = total(x)
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(Array::get(xs, 0)) * 10 + total(filler) * 0
}

// The guard against the fix going too wide: a wrapper whose spine ends in an
// allocation made at the site owns its value, so retaining it here would leak.
// The answer is the same either way -- this case is carried by the leak bound
// in fixtures/rc_reclaim_leak_test.vibe, and stands here so the value side of
// the contract names it too.
fn assign_wrapped_alloc(xs: Array[Node]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let k = 5
    Pair(Leaf(k), Leaf(k + 1))
  }
  let r = total(x)
  r * 100 + total(Array::get(xs, 0)) * 10
}

// SELF-MENTIONING wrappers. `is_self` is `assign_value_mentions` -- the value
// has `x` as a free variable, ANY mention -- and on that path the assignment
// arm deliberately keeps main's answer (see its comment). Two reviews on #2783
// read that branch as a hole, so the shapes they named are pinned here as the
// answers they actually give rather than left as an argument: if anyone widens
// `is_self` later, these rows say what moved.
//
// Measured on `6507c60` on the patched AND the unpatched compiler, RC and bump
// lanes, agreeing -- which is why neither is a `_refused`-style guard: there is
// no corruption in THESE two to bound.
//
// A third shape from the same review lives in
// fixtures/rc_wrapper_assign_self_borrow_test.vibe: a borrow-only self-use with
// no later read of the slot, which corrupted the free list identically on the
// patched and unpatched compilers here, so it was #2786's bug rather than
// #2760's and got its own repro. Its own file, because the damage surfaces on a
// LATER allocation -- a case that shares a file with a shape that damaged the
// heap fails the same way on fixed and broken compilers, which reads as a Red
// and proves nothing.
//
// The two shapes below are the ones that stay here. This comment used to call
// `total(x)` an OWNING self-use "so the budget re-application has a dup to
// spend", and both halves are measured false: `total`'s parameter is
// borrow-inferred (`vibe rc-classify` gives it a nonzero borrow mask, and
// reading an element twice across an allocation answers 7 both times on both
// lanes), and the plan carries no dup for `x` in the shape that has no later
// read. What makes these two balanced is the plan, not the position of the
// mention -- see `assign_slot_short_after_store` in
// codegen/expr/compile_expr_tail.vibe.

// A self-use at a consuming-looking position that is in fact borrowed. The plan
// budgets `x dup 1` here and the later `total(x)` spends it.
fn assign_self_owning_use(xs: Array[Node]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let t0 = total(x)
    Array::get(xs, t0 - 3)
  }
  let r = total(x)
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(Array::get(xs, 0)) * 10 + total(filler) * 0
}

// A BORROW-ONLY self-use of an array slot, with a later read. Same defect as
// #2786's repro -- it corrupted the free list here too until that issue was
// fixed -- kept because the answer is the contract this file asserts.
fn assign_self_borrow_use(xss: Array[Array[Node]]) -> Int {
  let mut x = [Leaf(1)]
  x = {
    Array::length(x)
    Array::get(xss, 0)
  }
  let r = total(Array::get(x, 0))
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(Array::get(Array::get(xss, 0), 0)) * 10 + total(filler) * 0
}

// The suppression that keeps the retain from being stacked on the inner
// lowering's own promotion must establish that the binder ACQUIRED an owned
// reference, not merely that the spine bound the name. Here the binder is
// ITSELF a borrow, so `classify_let_value_heap` leaves it at `rc_kind == 0`:
// no scope-end drop, so no promotion, so no earlier retain to duplicate.
//
// Measured on a stage2 built from the PR head, with the name-only test: `850`
// on the RC lane against the bump lane's `770` -- the second read of the
// element answers with the filler, 15, instead of 7, because the owning slot's
// drop released a reference `xss` still owns. Found by review on #2790.
fn assign_borrow_bound_binder(xss: Array[Array[Node]]) -> Int {
  let mut x = Pair(Leaf(1), Leaf(2))
  x = {
    let ys = Array::get(xss, 0)
    Array::get(ys, 0)
  }
  let r = total(x)
  let filler = Pair(Leaf(7), Leaf(8))
  r * 100 + total(Array::get(Array::get(xss, 0), 0)) * 10 + total(filler) * 0
}

test "2760 a wrapped borrow-returning call assigned into an owning slot" {
  let xs = [Pair(Leaf(3), Leaf(4))]
  inspect(assign_wrapped_call(xs), content = "770")
}

test "2760 a wrapped projection assigned into an owning slot" {
  let h = Holder::{ node: Pair(Leaf(3), Leaf(4)) }
  inspect(assign_wrapped_proj(h), content = "770")
}

test "2760 an ESeq spine reaches the same leaf" {
  let xs = [Pair(Leaf(3), Leaf(4))]
  inspect(assign_seq_call(xs), content = "770")
}

test "2760 a wrapped allocation still owns its value" {
  let xs = [Pair(Leaf(3), Leaf(4))]
  inspect(assign_wrapped_alloc(xs), content = "1170")
}

test "2760 a self-mentioning wrapper with an owning use keeps main's answer" {
  let xs = [Pair(Leaf(3), Leaf(4))]
  inspect(assign_self_owning_use(xs), content = "770")
}

test "2760 a borrow-only self-use, with a later read of the slot" {
  let xss = [[Pair(Leaf(3), Leaf(4))]]
  inspect(assign_self_borrow_use(xss), content = "770")
}

test "2760 a wrapper binder that is itself a borrow retains nothing to reuse" {
  let xss = [[Pair(Leaf(3), Leaf(4))]]
  inspect(assign_borrow_bound_binder(xss), content = "770")
}
