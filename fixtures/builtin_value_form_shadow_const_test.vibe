// #2442: a module-level int CONSTANT named `eq` still wins over the builtin.
//
// Its own file, because a top-level `let eq = 5` shadows the builtin for the
// whole module -- in `builtin_value_form_test.vibe` it would silently change
// what every value-form test there is reading.
//
// This is one of the two shapes that made admitting a bare builtin name more
// than "teach the lambda-site planner scope". Codegen's `EIdent` ladder is
// `locals -> consts -> constructors -> VALUE FORM -> func table`, and the
// value-form arm used to sit directly under the locals -- safe only while no
// bare name had a value form, since nothing local, constant or constructor can
// be spelled `A::b`. Left there, this file would read `eq` as an
// eta-expansion of the builtin instead of as 5: a WRONG answer, where the old
// restriction gave a refusal.
//
// Measured against a stage2 with the arm back above the constants: this file
// fails. That is the red test for the reorder.

let eq: Int = 5

test "#2442 a module-level constant named `eq` shadows the builtin" {
  inspect(eq, "5")
  let f = eq
  inspect(f, "5")
}
