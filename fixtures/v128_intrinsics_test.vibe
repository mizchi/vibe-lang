// #536: first-class WebAssembly 128-bit SIMD (V128) intrinsics. A V128 is a
// tagged pointer to a 16-byte heap box; each intrinsic lowers to wasm v128
// instructions (codegen inline in compile_call.vibe, non-RC linear backend).
// These tests build 16-byte Bytes, run lane-wise ops, and read results back via
// i8x16.bitmask. A bitmask bit `i` is set iff lane `i`'s comparison matched
// (the lane is 0xFF, whose MSB is 1).

//# Types

// Build a 16-byte Bytes whose byte i is `space` (32) where bit i of `mask` is
// set, otherwise `other`.
let make16: (Int, Int, Int) -> Bytes = (mask, space, other) -> {
  let b = Bytes::new()
  let mut i = 0
  while i < 16 {
    let bit = (mask >> i) & 1
    if bit == 1 {
      Bytes::push(b, space)
    } else {
      Bytes::push(b, other)
    }
    i = i + 1
  }
  b
}

// Build a 16-byte Bytes where every byte equals `v`.
let fill16: (Int) -> Bytes = (v) -> {
  let b = Bytes::new()
  let mut i = 0
  while i < 16 {
    Bytes::push(b, v)
    i = i + 1
  }
  b
}

// Build a 16-byte Bytes with ASCII digits '0'..'9' at positions 0..9 and 'A'
// (65) elsewhere.
let make16_digits: () -> Bytes = () -> {
  let b = Bytes::new()
  let mut i = 0
  while i < 16 {
    if i < 10 {
      Bytes::push(b, 48 + i)
    } else {
      Bytes::push(b, 65)
    }
    i = i + 1
  }
  b
}

//# Tests

test "v128_load + v128_eq_i8x16 + v128_splat + v128_bitmask: find spaces" {
  // bytes: spaces at positions 0,2,5,15 (mask 0b1000000000100101 = 0x8025).
  let want = 0x8025
  let data = make16(want, 32, 65)
  let v = v128_load(data, 0)
  let spaces = v128_splat_i8x16(32)
  let eq = v128_eq_i8x16(v, spaces)
  let mask = v128_bitmask_i8x16(eq)
  assert_eq(mask, want)
}

test "v128_and / v128_or / v128_not lane logic" {
  // a: spaces at even bits 0..14 (0x5555); b: spaces at 0..7 (0x00FF).
  let a = v128_eq_i8x16(v128_load(make16(0x5555, 32, 1), 0), v128_splat_i8x16(32))
  let b = v128_eq_i8x16(v128_load(make16(0x00FF, 32, 1), 0), v128_splat_i8x16(32))
  // and: 0x5555 & 0x00FF = 0x0055
  assert_eq(v128_bitmask_i8x16(v128_and(a, b)), 0x0055)
  // or: 0x5555 | 0x00FF = 0x55FF
  assert_eq(v128_bitmask_i8x16(v128_or(a, b)), 0x55FF)
  // not(a): every lane flips 0x00<->0xFF, so the 16-bit mask is the complement
  // of 0x5555 within 16 lanes = 0xAAAA.
  assert_eq(v128_bitmask_i8x16(v128_not(a)), 0xAAAA)
}

test "v128_le_u_i8x16 / v128_ge_u_i8x16: digit range check" {
  // bytes: '0'..'9' at positions 0..9 (0x03FF), 'A'(65) elsewhere.
  let data = make16_digits()
  let v = v128_load(data, 0)
  // ge '0' (48): positions 0..9 are digits (>=48); 'A'=65 also >= 48, so ge is
  // all lanes -> 0xFFFF.
  let ge0 = v128_ge_u_i8x16(v, v128_splat_i8x16(48))
  assert_eq(v128_bitmask_i8x16(ge0), 0xFFFF)
  // le '9' (57): digits 0..9 are <= 57; 'A'=65 is NOT, so le mask = 0x03FF.
  let le9 = v128_le_u_i8x16(v, v128_splat_i8x16(57))
  assert_eq(v128_bitmask_i8x16(le9), 0x03FF)
  // is-digit = ge0 & le9 = 0x03FF.
  assert_eq(v128_bitmask_i8x16(v128_and(ge0, le9)), 0x03FF)
}

test "v128_any_true: true when any lane set, false on all-zero" {
  let some = v128_eq_i8x16(v128_load(make16(0x0001, 32, 1), 0), v128_splat_i8x16(32))
  assert(v128_any_true(some))
  // No byte equals 32 -> all-zero v128.
  let none = v128_eq_i8x16(v128_load(fill16(7), 0), v128_splat_i8x16(32))
  assert(not(v128_any_true(none)))
}

test "v128_all_true_i8x16: true only when every lane set" {
  // every byte == 9 -> eq with splat(9) is all 0xFF lanes -> all_true.
  let allmatch = v128_eq_i8x16(v128_load(fill16(9), 0), v128_splat_i8x16(9))
  assert(v128_all_true_i8x16(allmatch))
  // one byte differs -> not all lanes set.
  let onediff = v128_eq_i8x16(v128_load(make16(0xFFFE, 9, 8), 0), v128_splat_i8x16(9))
  assert(not(v128_all_true_i8x16(onediff)))
}

test "v128_store round-trips through a Bytes payload" {
  let src = make16(0x1234, 32, 7)
  let v = v128_load(src, 0)
  // store into a fresh 16-byte buffer at offset 0, reload, compare equal lanes.
  let dst = fill16(0)
  v128_store(dst, 0, v)
  let v2 = v128_load(dst, 0)
  // eq lane-wise: identical copies -> every lane 0xFF -> all_true and mask 0xFFFF.
  let eq = v128_eq_i8x16(v, v2)
  assert(v128_all_true_i8x16(eq))
  assert_eq(v128_bitmask_i8x16(eq), 0xFFFF)
}
