// #3152: `Parallel::map` runs its closure in the group, so its call sites get
// the same `Spawnable` check as `TaskGroup::spawn` (it has spawn's shape: a
// `TaskGroup` first, a closure last). It used to hand its closure to spawn by
// name, which the check could not see, so this capture of a plain `Array` ran.
import @vibe/concurrent {
  Parallel, TaskGroup
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> Parallel::map(n, [1, 2], (x) -> {
    Array::set(seen, 0, x)
    x
  }))
  ()
}
