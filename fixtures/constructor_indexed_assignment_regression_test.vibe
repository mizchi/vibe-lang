trait Mappable[F[_]] {
  map[A, B](F[A], (A) -> B) -> F[B]
}

impl Mappable[Array] for Array {
  map(xs: Array[A], f: (A) -> B) -> Array[B] {
    Array::map(xs, f)
  }
}

test "assigned constructor evidence reaches the continuation" {
  let identity = (x) -> {
    x
  }
  let mut xs = identity([1])
  xs = [2, 3]
  let values = Mappable::map(xs, (x) -> {
    x + 1
  })
  assert_eq(values, [3, 4])
}
