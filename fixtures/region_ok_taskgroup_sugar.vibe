// #1081 step 4 (surface polish): `taskgroup { g => body }` is pure parser
// sugar for `TaskGroup::run((g) -> { body })` -- no dedicated AST node, no
// desugar pass, no checker special-casing (the parser emits the exact same
// ECall/EFn shape a hand-written `TaskGroup::run(...)` call already
// produces). This fixture pins that the sugar compiles, runs, and returns
// the same result a hand-written call would.
import @vibex/concurrent { TaskGroup, TaskHandle }

let _start = () -> Int {
  let result = taskgroup { g => {
    let h = TaskGroup::spawn(g, () -> { 40 })
    match TaskHandle::join(h) {
      Ok(v) => v + 2,
      Err(_) => 0 - 1
    }
  } }
  match result {
    Ok(v) => v,
    Err(_) => 0 - 1
  }
}
_start()

