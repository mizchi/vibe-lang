// #1967: was fixtures/int_large_literal.vibe. The 2^62-1 / 2^61+1 literals
// are the 63-bit contract already pinned by lexer_test
// (`lex_decimal_int_overflow_rejected`). This file keeps the in-range
// values that fixture also claimed, which the seed can compile.

test "in-range large Int literals" {
  inspect(1000000000, "1000000000")
  inspect(1000000000000, "1000000000000")
  inspect(2305843009213693951, "2305843009213693951")
}
