//# Codex round 13 on #2456: a generic enum whose payload is ANOTHER generic
//# enum applied to its formal -- `enum Inner[X] { Mark(Int); Hole }`,
//# `enum Outer[T] { Wrap(Inner[T]); Nothing }`. The derived `Inner::equals`
//# never reads `X`, so `Outer[Array[Int]]` is fully structural: the formal
//# walk consults the inner enum's observed positions the way it already did
//# for a generic struct, instead of treating every argument as read.
//# Measured on 614f808: the direct compare (which answered on the baseline)
//# and the untyped-empty compare both trapped; both ANSWER now, and the
//# `Int` payload is exact for `64 << 32` vs `65 << 32`.

enum Inner[X] {
  Mark(Int);
  Hole
}

enum Outer[T] {
  Wrap(Inner[T]);
  Nothing
}

fn fill(xs: Array[Outer[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, Wrap(Mark(v)))
}

fn mk(v: Int) -> Outer[Array[Int]] {
  Wrap(Mark(v))
}

export fn _start() -> Int {
  let left = []
  fill(left, 64 << 32)
  let right = []
  fill(right, 64 << 32)
  let other = []
  fill(other, 65 << 32)
  let holes = []
  Array::push(holes, Wrap(Hole))
  assert(left == right)
  assert(left != other)
  assert(left != holes)
  let a = mk(1)
  let b = mk(1)
  let c = mk(2)
  assert(a == b)
  assert(a != c)
  0
}
