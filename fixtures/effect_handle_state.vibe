// Stateful effect handler using State[Int]
effect State {
  Get -> Int;
  Put(Int) -> Unit
}

let counter = () -> Int with { State } {
  let n = perform State::Get
  perform State::Put(n + 1)
  perform State::Get
}

// Handle with initial state = 10
let result = handle {
  counter()
} {
  State::Get => resume(10),
  State::Put(_v) => resume(0)
}
result

__DATA__
{"last": "10"}
