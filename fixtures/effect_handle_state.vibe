// State effect with Get/Put inlined by handler
effect State {
  Get -> Int;
  Put(Int) -> Unit
}

let result = handle {
  let n = perform State::Get
  perform State::Put(n + 1)
  perform State::Get
} with {
  State::Get => resume(10);
  State::Put(_v) => resume(0)
}
result

__DATA__
{"last": "10"}
