//# #3301 (Codex on #3337): the edit the copy-limit refusal names has to work.
//# `fixtures/typecheck/handler_or_pattern_nested_copies_reject.vibe` nests ten
//# levels of two-operation or-pattern arms, each inside a closure, and is
//# refused at the ninth `handle`, whose arm body would expand 512 times. That closure does not help: it is written inside the arm, so it is
//# copied with it. Moving the ninth level into the top-level `deeper`, and
//# the tenth into `deepest`, leaves
//# each copy a call, and the program compiles and answers what the ten levels
//# would.

effect E0 {
  A0 -> Int
  B0 -> Int
}

effect E1 {
  A1 -> Int
  B1 -> Int
}

effect E2 {
  A2 -> Int
  B2 -> Int
}

effect E3 {
  A3 -> Int
  B3 -> Int
}

effect E4 {
  A4 -> Int
  B4 -> Int
}

effect E5 {
  A5 -> Int
  B5 -> Int
}

effect E6 {
  A6 -> Int
  B6 -> Int
}

effect E7 {
  A7 -> Int
  B7 -> Int
}

effect E8 {
  A8 -> Int
  B8 -> Int
}

effect E9 {
  A9 -> Int
  B9 -> Int
}

fn deepest() -> Int {
  handle {
    perform E9::A9 + perform E9::B9
  } with E9 {
    A9|B9 => {
      let f = () -> 1; resume(f() + 1)
    }
  }
}

fn deeper() -> Int {
  handle {
    perform E8::A8 + perform E8::B8
  } with E8 {
    A8|B8 => {
      let f = () -> deepest(); resume(f() + 1)
    }
  }
}

fn nested() -> Int {
  handle {
    perform E0::A0 + perform E0::B0
  } with E0 {
    A0|B0 => {
      let f = () -> handle {
        perform E1::A1 + perform E1::B1
      } with E1 {
        A1|B1 => {
          let f = () -> handle {
            perform E2::A2 + perform E2::B2
          } with E2 {
            A2|B2 => {
              let f = () -> handle {
                perform E3::A3 + perform E3::B3
              } with E3 {
                A3|B3 => {
                  let f = () -> handle {
                    perform E4::A4 + perform E4::B4
                  } with E4 {
                    A4|B4 => {
                      let f = () -> handle {
                        perform E5::A5 + perform E5::B5
                      } with E5 {
                        A5|B5 => {
                          let f = () -> handle {
                            perform E6::A6 + perform E6::B6
                          } with E6 {
                            A6|B6 => {
                              let f = () -> handle {
                                perform E7::A7 + perform E7::B7
                              } with E7 {
                                A7|B7 => {
                                  let f = () -> deeper(); resume(f() + 1)
                                }
                              }; resume(f() + 1)
                            }
                          }; resume(f() + 1)
                        }
                      }; resume(f() + 1)
                    }
                  }; resume(f() + 1)
                }
              }; resume(f() + 1)
            }
          }; resume(f() + 1)
        }
      }; resume(f() + 1)
    }
  }
}

test "the copy-limit refusal's edit compiles: the last handle in a top-level fn" {
  inspect(nested(), "3070")
}
