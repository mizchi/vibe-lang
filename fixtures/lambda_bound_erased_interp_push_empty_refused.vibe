//# #2745: an array built by PUSH from an empty literal.
//
// Self-probed while checking what #2773 still lists as open, in round 23.
// Measured on `51b84d7`: `{ let xs = []; Array::push(xs, a);
// Array::get(xs, 0) }` compiled and `_start` returned **3** -- a 3-digit
// pointer decimal on a program that had just passed every gate in this PR.
//
// `let xs = []` records no element, because there is none to read, so the
// pushes were the only thing that could say what the array holds and nothing
// looked at them. That the route was found by construction rather than by a
// report is the point: the supply of T-typed expressions this pass cannot
// classify keeps shrinking, and the one I reached for to build an opaque
// initializer turned out to be a live silent-wrong of its own.
//
// The rule is the one ADR-0097's untyped-empty scan already uses for structural
// `==` (#2157): an empty literal's element comes from the `Array::push(xs, v)`
// calls in the binding's own scope. It only ADDS -- a push turns "no answer"
// into "erased" and never the reverse -- so no ordering between two pushes can
// turn a refusal off, and `push_empty_concrete` in the green control is the
// twin that fails if a concrete push starts refusing.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let xs = []
    Array::push(xs, a)
    Array::get(xs, 0) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
