//# #2745: a function value selected by a MATCH.
//
// Codex, P1 round 24 on #2761. Measured on `d69127c`:
// `let g = match true { true => f, false => f }`, with `f: (T) -> T` a
// parameter, then `g(a)` printed a 3-digit pointer decimal.
//
// Round 22 gave `dtd_interp_lamret_of_value` the `EIf` descent for exactly this
// reason -- a value that merely PASSES A FUNCTION THROUGH must not lose what
// the function knew -- and `match` is the other spelling of it. Closing one of
// a pair and leaving the other is the shape this PR keeps repeating: `xs[0]`
// vs `Array::get` in round 15, a literal vs a name in rounds 17, 21 and 23.
//
// `match_alias_concrete` in the green control selects a concrete `(Int) -> Int`
// the same way and must still render.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T, f: (T) -> T) -> String {
    let g = match true {
      true => f,
      false => f
    }
    "\{g(a)}"
  }
  inner(Qt::{ w: 5 }, (v: Qt) -> Qt {
    v
  })
}

export fn _start() -> Int {
  String::length(outer(7))
}
