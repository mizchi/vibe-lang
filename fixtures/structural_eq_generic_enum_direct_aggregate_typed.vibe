//# #2467: a source-owned generic ENUM compared DIRECTLY (annotated bindings,
//# not the untyped-empty arm) with an aggregate argument. This used to TRAP
//# (Codex round 5 on #2456: the derived `Map::equals` compared the `K`
//# payload by reference). A concrete instantiation now takes a comparator
//# specialized with its arguments (`Map::equals__<key>`), so the `Array[Int]`
//# payload compares by content: two separately allocated equal payloads
//# answer `true`, a different one `false`.

enum Map[K, V] {
  Entry(K, V)
}

export fn _start() -> Int {
  let a: Map[Array[Int], Int] = Entry([1, 2], 1)
  let b: Map[Array[Int], Int] = Entry([1, 2], 1)
  let c: Map[Array[Int], Int] = Entry([1, 3], 1)
  let d: Map[Array[Int], Int] = Entry([1, 2], 2)
  assert(a == b)
  assert(a != c)
  assert(a != d)
  0
}
