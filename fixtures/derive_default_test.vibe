// `derive(Default)` (#638): generates `Type::default() -> Type`, a field-wise
// (struct) / first-variant (enum) default. Per-type defaults: Int -> 0,
// Double -> 0.0, Bool -> false, String -> "", Option[_] -> None,
// Array[_] -> empty, and a nested derive(Default) struct/enum -> Nested::default().

//# Types

struct Inner { n: Int; tag: String } derive(Eq, Default)

struct Config {
  count: Int;
  ratio: Double;
  enabled: Bool;
  label: String;
  maybe: Option[Int];
  items: Array[Int];
  inner: Inner
} derive(Eq, Default)

enum Mode {
  Auto(Int);
  Manual;
  Off
} derive(Eq, Default)

//# Tests

test "derive(Default) on a struct: per-field defaults" {
  let c = Config::default()
  assert_eq(c.count, 0)
  assert(c.ratio == 0.0)
  assert(not(c.enabled))
  assert(c.label == "")
  assert(Array::length(c.items) == 0)
  match c.maybe {
    None => assert(true),
    Some(_) => assert(false)
  }
}

test "derive(Default): nested struct default" {
  let c = Config::default()
  assert_eq(c.inner.n, 0)
  assert(c.inner.tag == "")
  assert(Inner::default() == Inner::{ n: 0, tag: "" })
}

test "derive(Default): whole-struct default equals a hand-built default" {
  let c = Config::default()
  // A whole-struct `==` between a `default()` call result and a literal now
  // compares STRUCTURALLY across every field kind — including the `Array[Int]`
  // and `Option[Int]` fields that previously compared by pointer identity
  // (#695). The `default()` call's return type resolves through the generated
  // `Config::default`, so the `==` dispatch picks `Config::equals`.
  assert(c == Config::{
    count: 0,
    ratio: 0.0,
    enabled: false,
    label: "",
    maybe: None,
    items: [],
    inner: Inner::{ n: 0, tag: "" }
  })
}

test "derive(Default) on an enum: first variant with defaulted payload" {
  // First variant is Auto(Int), so default is Auto(0).
  assert(Mode::default() == Auto(0))
  assert(not(Mode::default() == Manual))
  assert(not(Mode::default() == Off))
}
