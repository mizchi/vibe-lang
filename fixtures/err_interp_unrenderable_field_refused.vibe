// #2986: an `Array` read from a struct field reached codegen's `__to_string`
// lowering unexpanded -- normalize could not resolve its shape -- and printed
// its address (`292`). The checker types the field; the build is refused.
struct Bx {
  tags: Array[Int]
}

export let _start: () -> Int = () -> {
  let bx = Bx::{ tags: [1, 2] }
  let s = "\{bx.tags}"
  String::length(s)
}
