// #3571: the green side of the qualified-function overlap refusal
// (fixtures/err_qualified_fn_overlap_*_refused.vibe). Two modules' private
// plain `fn shout` -- the edit the refusal names -- each stay their own module's
// in either import order, and one module's private `fn Int::yell`, the only
// definition of that name, is accepted and answers both spellings.

import ./modules/qualified_fn_plain_b.vibe {
  b_name
}

import ./modules/qualified_fn_plain_a.vibe {
  a_name
}

test "each module keeps its own private plain function" {
  inspect("\{a_name()} | \{b_name()}", content = "from-a from-a yell-a yell-a | from-b from-b")
}
