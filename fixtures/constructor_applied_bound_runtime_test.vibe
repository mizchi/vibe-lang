trait Accepts[A] {
  accept(A) -> Int
}

impl Accepts[Array[Int]] for Array {
  accept(xs: Array[Int]) -> Int {
    Array::length(xs)
  }
}

fn accept[F[_]: Accepts[F[Int]]](xs: F[Int]) -> Int {
  F::accept(xs)
}

type Apply[F[_], A] = F[A]

fn accept_alias[F[_]: Accepts[Apply[F, Int]]](xs: Apply[F, Int]) -> Int {
  F::accept(xs)
}

trait Pairs[F[_], G[_]] {
  pair[A](F[A], G[A]) -> Int
}

impl Pairs[Array, Option] for Array {
  pair(xs: Array[A], ys: Option[A]) -> Int {
    match ys {
      Some(_) => Array::length(xs) + 1,
      None => Array::length(xs)
    }
  }
}

fn pair_size[F[_]: Pairs[F, G], G[_], A](xs: F[A], ys: G[A]) -> Int {
  F::pair(xs, ys)
}

test "applied constructor bounds lower through the specialized witness" {
  assert_eq(accept([1, 2]), 2)
}

test "applied constructor bound aliases lower through the canonical witness" {
  assert_eq(accept_alias([1, 2, 3]), 3)
}

test "all constructor formals specialize an applied witness" {
  assert_eq(pair_size([1, 2], Some(3)), 3)
}
