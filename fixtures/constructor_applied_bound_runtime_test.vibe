trait Accepts[A] {
  accept(A) -> Int
}

impl Accepts[Array[Int]] for Array {
  accept(xs: Array[Int]) -> Int {
    Array::length(xs)
  }
}

fn accept[F[_]: Accepts[F[Int]]](xs: F[Int]) -> Int {
  F::accept(xs)
}

test "applied constructor bounds lower through the specialized witness" {
  assert_eq(accept([1, 2]), 2)
}
