import ../lib/@vibe/builtin {
  String::replace, String::to_upper, String::to_lower
}

//# Misc

test "empty string operations" {
  assert(String::length("") == 0)
  assert(String::concat("", "") == "")
  assert(String::concat("", "a") == "a")
  assert(String::concat("a", "") == "a")
  assert(String::trim("") == "")
  assert(String::contains("", needle = "") == true)
  assert(String::starts_with("", prefix = "") == true)
  assert(String::ends_with("", suffix = "") == true)
}

test "escape sequences in strings" {
  let nl = "a\nb"
  assert(String::length(nl) == 3)
  let tab = "a\tb"
  assert(String::length(tab) == 3)
  let cr = "a\rb"
  assert(String::length(cr) == 3)
  let quote = "a\"b"
  assert(String::length(quote) == 3)
  let backslash = "a\\b"
  assert(String::length(backslash) == 3)
}

test "string interpolation expressions" {
  let x = 10
  let y = 20
  assert("sum=\{x + y}" == "sum=30")
  assert("neg=\{0 - x}" == "neg=-10")
}

test "string interpolation nested" {
  let arr = [1, 2, 3]
  let len = Array::length(arr)
  assert("len=\{len}" == "len=3")
}

test "single char strings" {
  assert(String::length("a") == 1)
  assert("a" == "a")
  assert("a" != "b")
  assert(String::char_code_at("A", at = 0) == 65)
  assert(String::char_code_at("Z", at = 0) == 90)
}

test "string comparison" {
  assert("abc" == "abc")
  assert("abc" != "def")
  assert("" == "")
  assert("a" != "")
}

test "string split edge cases" {
  let parts = String::split("hello", sep = "x")
  assert(Array::length(parts) == 1)
  assert(parts[0] == "hello")
}

test "string index_of edge cases" {
  assert(String::index_of("", needle = "a") == -1)
  assert(String::index_of("a", needle = "a") == 0)
  assert(String::index_of("abc", needle = "c") == 2)
}

test "string repeated operations" {
  let s = "hello"
  let upper = String::to_upper(s)
  let lower = String::to_lower(upper)
  assert(lower == "hello")
}

test "string replace no match" {
  assert(String::replace("hello", pattern = "xyz", replacement = "abc") == "hello")
}

test "string substring boundary" {
  let s = "hello"
  assert(String::substring(s, start = 0, end = 0) == "")
  assert(String::substring(s, start = 0, end = 1) == "h")
  assert(String::substring(s, start = 4, end = 5) == "o")
}
