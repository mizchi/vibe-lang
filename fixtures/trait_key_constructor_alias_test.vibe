// #3995: impl registration and bound lookup preserve a bare alias constructor.
type Vec[T] = Array[T]
trait Functor[F[_]] {
  tag(Self) -> Int
}
struct Note { n: Int }
impl Functor[Vec] for Note {
  tag(self) -> Int {
    self.n
  }
}
fn tagged[T: Functor[Vec]](_ value: T) -> Int {
  T::tag(value)
}
test "a higher-kinded impl matches its bound through an alias constructor" {
  inspect(tagged(Note::{ n: 37 }), content = "37")
}
