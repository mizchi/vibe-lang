// Generic Reader effect: read-only access to a value of type T
effect Reader[T] {
  Ask -> T
}

// Int reader
let get_int = handle {
  let x = perform Reader::Ask
  x + 10
} { Reader::Ask => resume(42) }

// String reader
let get_str = handle {
  let s = perform Reader::Ask
  String::length(s)
} { Reader::Ask => resume("hello") }

get_int + get_str

__DATA__
{"last": "57"}
