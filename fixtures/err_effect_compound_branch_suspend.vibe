// #1536 (a) v8 boundary: linearization only walks positions every execution
// reaching the compound also reaches. A suspension inside an `if` BRANCH is not
// one of them -- naming it would run the operation on the path that does not
// select that branch -- so it stays fail-closed.
effect Ask {
  Get(Int) -> Int
}

let _start = () -> Int {
  handle {
    let mut value = 0
    value = 1 + (if value == 0 {
      perform Ask::Get(1)
    } else {
      0
    })
    value
  } with Ask {
    Get(n) => {
      let k = resume
      k(n)
    }
  }
}
_start()

__DATA__
{
  "error_contains": "let/seq/tail/branch-tail spine"
}
