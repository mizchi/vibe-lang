// ADR-0076 Phase 3a (#817): post-processing after a resume via the VALUE
// form. The direct call form `let r = resume(v)` stays rejected (#942 --
// non-tail), but binding `resume` first makes the continuation an ordinary
// closure: the arm drives the rest of the body synchronously and then
// keeps computing with the result.
effect Ask {
  Get(Int) -> Int
}

let _start = () -> Int {
  handle {
    let a = perform Ask::Get(1)
    a * 10
  } with Ask {
    Get(t) => {
      let k = resume
      let r = k(t + 100)
      r + 7
    }
  }
}

test "effect_resume_value_postprocess.vibe produces its recorded value" {
  // #1571: the bare `_start()` call and the `__DATA__` tail collapsed
  // into this block. `vibe test --update` rewrites the literal.
  inspect(_start(), "1017")
}
