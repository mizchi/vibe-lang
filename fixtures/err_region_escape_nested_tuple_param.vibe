fn first_callback(pair: (() -> Array[Int], Int)) -> () -> Array[Int] {
  pair.0
}

test "tuple-nested callback parameters retain provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    first_callback((() -> Array[Int] {
      MutList::to_array(values)
    }, 0))
  }
  let _ = escaped()
}
