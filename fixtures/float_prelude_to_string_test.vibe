// #3625 item 2: the prelude declares `impl Show for Float`, so the imported
// `to_string` takes a `Float` and renders its shortest f32 digits.

import @vibe/builtin {
  to_string
}

test "the imported to_string renders a Float as an f32" {
  inspect(to_string(0.1f), content = "0.1")
  inspect(to_string(1.0f / 3.0f), content = "0.33333334")
  inspect(to_string(16777217.0f), content = "16777216")
  inspect(to_string(-0.0f), content = "-0")
}
