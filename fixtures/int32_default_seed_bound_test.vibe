// #3824: the seeded builtin `Default` (no import) satisfies `[T: Default]`
// at `Int32` / `UInt32` too; a program that names `T::default()` imports
// `@vibe/core` (fixtures/int32_default_bound_test.vibe).
fn keep[T: Default](_ x: T) -> T {
  x
}

test "a Default bound at Int32 / UInt32 without an import" {
  let a: Int32 = 5
  inspect(keep(a), content = "5")
  let b: UInt32 = 4294967295
  inspect(keep(b), content = "4294967295")
}
