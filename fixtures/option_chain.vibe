let find = (arr: Array[Int], target: Int) -> Option[Int] {
  let mut i = 0
  let mut result: Option[Int] = None
  while i < Array::length(arr) {
    if Array::get(arr, i) == target {
      result = Some(i)
      break
    }
    i = i + 1
  }
  result
}

let r = match find([10, 20, 30], 20) {
  Some(i) => i,
  None => -1
}
r

