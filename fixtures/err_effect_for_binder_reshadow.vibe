// #1720: a for element binder masks an older inert-local proof.
effect Ask {
  Get(Int) -> Int
}

fn maker() -> () -> Int with Ask {
  () -> Int with Ask {
    perform Ask::Get(1)
  }
}

let _start = () -> Int {
  handle {
    let seed = perform Ask::Get(0)
    let pick = () -> Int {
      5
    }
    let mut out = seed
    for pick in [
      maker()
    ] {
      out = out + pick()
    }
    out
  } with {
    Ask::Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
