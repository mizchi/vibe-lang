// A collected for-in owns its output even when it contains views of the input.
fn keep(_ xs: Array[Array[Int]]) -> Array[Array[Int]] {
  xs
}

fn collect_rows(_ rows: Array[Array[Int]], _ take: Bool, _ empty: Bool) -> Int {
  let result = for row in rows {
    if empty {
      break
    } else ()
    row
  }
  if take {
    let saved = keep(result)
    if Array::length(saved) > 0 {
      Array::get(Array::get(saved, at = 1), at = 0)
    } else {
      0
    }
  } else {
    1
  }
}

fn round(_ i: Int) -> Int {
  let rows = [[i], [i + 1]]
  let take = i % 2 == 0
  let empty = i % 3 == 0
  let count = collect_rows(rows, take, empty)
  let churn = [[i + 3], [i + 4]]
  let expected = if take {
    if empty {
      0
    } else {
      i + 1
    }
  } else {
    1
  }
  if count == expected && Array::get(Array::get(rows, at = 1), at = 0) == i + 1 && Array::get(Array::get(churn, at = 0), at = 0) == i + 3 {
    0
  } else {
    1
  }
}

fn main() -> Int {
  let mut i = 0
  let mut errors = 0
  while i < 2000 {
    errors = errors + round(i)
    i = i + 1
  }
  errors
}

test "releasing a partial comprehension preserves its shared elements" {
  inspect(main(), content = "0")
}
