import @vibex/immut {
  ImmutMap,
  ImmutMap::empty,
  MapHamt,
  MapHamt::set,
  MapHamt::size
}

test "ImmutMap annotation stays compatible with MapHamt across index.vpkg" {
  let old: ImmutMap[Int] = ImmutMap::empty()
  let current: MapHamt[Int] = MapHamt::set(old, "one", 1)
  inspect(MapHamt::size(current), "1")
}
