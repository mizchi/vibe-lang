// ADR-0085 Phase 3 (#1344 follow-up): the payload kind of a LOCAL binder.
// `let e = NotFound(..)` then `throw(e)` must require the same
// `Exception[IoError]` an inline `throw(NotFound(..))` does. This is the shape
// #1324's migration produces (`let e = ..; Err(e)` becoming `let e = ..;
// throw(e)`), so while it stayed unresolved most of that migration was exempt
// from the very check the migration exists to gain.
enum IoError {
  NotFound(String)
}

enum ParseError {
  Eof
}

let boom = () -> Int with { Exception[ParseError] } {
  let e = NotFound("cfg")
  throw(e)
}

let main = () -> Int {
  handle {
    boom()
  } with Error {
    Throw(_e) => 42
  }
}

__DATA__
{"error_contains": "missing { Exception[IoError] }"}
