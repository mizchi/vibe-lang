// `f64` / `f32` are aliases of `Double` / `Float`. `i32` was a third one,
// for the 63-bit `Int`, until #3727 made it an unknown type
// (fixtures/typecheck/err_type_i32_not_an_int_alias.vibe).
test "type wasm primitive aliases" {
  let id_f64 = (x: f64) -> f64 {
    x
  }
  let id_f32 = (x: f32) -> f32 {
    x
  }
  inspect(id_f64(1.25), "1.25")
  inspect(id_f32(2.5f), "2.5")
}
