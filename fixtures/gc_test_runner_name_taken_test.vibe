//# #3922: on the wasm-gc lane, a test file with no `main` runs its tests
//# through a synthesized runner that the module exports as `_start`. The
//# runner used to be bound as `_start` too, so a program's own `_start` was
//# refused as declared twice. It now takes the first spelling the program
//# leaves free, here past both `_start` and `_start_`.

let _start = () -> Int {
  1
}

let _start_ = () -> Int {
  2
}

test "a program may declare _start and _start_" {
  inspect(_start() + _start_(), content = "3")
}
