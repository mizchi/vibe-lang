// Nested effect handlers: inner handler shadows outer for same effect
effect Counter {
  Next -> Int
}

let result = handle {
  let a = perform Counter::Next
  let b = handle {
    perform Counter::Next
  } with Counter {
    Next => resume(100)
  }
  a + b
} with Counter {
  Next => resume(1)
}
// outer Next → 1, inner Next → 100, result = 101
result

__DATA__
{"last": "101"}
