fn direct_identity[T](value: T) -> T {
  value
}

test "call-shaped destinations preserve the outer lifetime" {
  let outer: Array[() -> Array[Int]] = []
  let _ = region r {
    let values = MutList::empty(r)
    Array::push(direct_identity(outer), () -> Array[Int] {
      MutList::to_array(values)
    })
    0
  }
}
