// #2997: slicing clamps its bounds into range and an end before the start is
// the empty slice; single-element indexing traps instead (not pinned here).
test "string slices clamp" {
  inspect("abcdef"[2:10], "cdef")
  inspect("abcdef"[1:3], "bc")
  inspect(String::substring("abcdef", 2, 100), "cdef")
  inspect(String::length(String::substring("abc", 2, 1)), "0")
}

test "array slices clamp" {
  inspect(Array::slice([3, 1, 2], 0 - 1, 2), "[3, 1]")
  inspect(Array::slice([3, 1, 2], 0, 10), "[3, 1, 2]")
  inspect(Array::length(Array::slice([3, 1, 2], 2, 1)), "0")
  // #3078: the gc lane did not clamp; the gate runs this file on gc too.
  inspect(Array::slice([3, 1, 2], 0 - 5, 0 - 1), "[]")
  inspect(Array::slice([3, 1, 2], 1, 3), "[1, 2]")
  inspect(Array::length(Array::slice([3, 1, 2], 7, 9)), "0")
  inspect(Array::slice(["a", "b"], 0 - 1, 1), "[a]")
}

// #3078: the other two spellings of an array slice reach the gc lane by
// other routes (the `[a:b]` index form lowers through `__slice`, a function
// value through the builtin body), and both must clamp too.
test "array slice spellings clamp" {
  let xs = [3, 1, 2]
  let lo = 0 - 1
  let r: Array[Int] = xs[lo:2]
  inspect(r, "[3, 1]")
  let r2: Array[Int] = xs[1:10]
  inspect(r2, "[1, 2]")
  let f = Array::slice
  let r3: Array[Int] = f(xs, lo, 2)
  inspect(r3, "[3, 1]")
}
