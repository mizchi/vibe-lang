// #1536 boundary: assignment RHS support is limited to the direct recognized
// suspension itself. A compound-assignment RHS that merely contains a perform
// stays rejected; accepting it would require general nested-expression CPS.
effect Ask {
  Get(Int) -> Int
}

let _start = () -> Int {
  handle {
    let mut value = 0
    value += perform Ask::Get(1) + 1
    value
  } with Ask {
    Get(n) => {
      let k = resume
      k(n)
    }
  }
}
_start()

__DATA__
{
  "error_contains": "let/seq/tail/branch-tail spine"
}
