fn keep_record[T](value: T) -> T {
  value
}

test "record-nested callback parameters retain provenance" {
  let escaped = region r {
    let values = MutList::empty(r)
    keep_record(value = record {
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    })
  }
  let _ = escaped.callback()
}
