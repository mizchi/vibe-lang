// #1967: was fixtures/show_to_string_method.vibe + __DATA__.last "1".
// Bare `to_string(v)` / Int::to_string as a dot-call is rejected.
// Current `Int::to_string` keeps length("1") as 1.

test "Int to_string of 1 has length 1" {
  let v = 1
  let n = String::length(Int::to_string(v))
  inspect(n, "1")
}
