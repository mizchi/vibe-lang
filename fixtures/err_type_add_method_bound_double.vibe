// #3350: `+` on an erased formal lowers to `__generic_add` whatever `Add`
// declares, so a program's `Add` with a method is judged like the marker.
//
// Measured on the #3327 stage2 (43ee1c792): this checked clean and
// `add2(1.5, 2.25)` answered `0` -- the raw add of two boxes -- because the
// #3158 guard stood down for an `Add` that declares `plus`.

trait Add {
  plus(Self, Self) -> Self
}

impl Add for Float64 {
  plus(a: Float64, b: Float64) -> Float64 {
    a + b
  }
}

fn add2[T: Add](a: T, b: T) -> T {
  a + b
}

fn main() -> Unit allows Console {
  println(__to_string(add2(a = 1.5, b = 2.25)))
}
