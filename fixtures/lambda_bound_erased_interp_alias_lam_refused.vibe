//# #2745: a local generic lambda reached through an ALIAS.
//
// Codex, P1 round 18 on #2761. Measured on `c0147ca`:
// `let idf = [U](u: U) -> U { u }; let g = idf` then `"\{g(a)}"` printed a
// 3-digit pointer decimal.
//
// I had claimed on the round-15 thread that an alias inherits this record
// "with no arm of its own", because `__Vlamret$` is one of the families the
// alias copy carries. That is true of an alias written INSIDE an interpolation,
// which the shape recorder handles -- and a `let g = idf` at statement level
// never reaches that recorder. It comes through `dtd_interp_bind_lamret`, whose
// only non-lambda arm was the MASK. So the claim was right about one route and
// stated about both, which is the same mistake as arguing from a premise that
// holds for one slot to a conclusion about two.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let idf = [U](u: U) -> U {
      u
    }
    let g = idf
    "\{g(a)}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
