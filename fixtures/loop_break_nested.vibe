// Nested loop with break(value) — inner loop returns via break
let _start = () -> {
  let mut total = 0
  let mut i = 1
  while i <= 3 {
    let partial = loop (j = 0, acc = 0) {
      if j >= i { break(acc) }
      continue(j + 1, acc + j)
    }
    total = total + partial
    i = i + 1
  }
  total
}
_start()

