// #635/#1324: the `?` railway operator over Option.
//
// `opt?` yields the inner value on `Some` and early-`return None` on `None`.
// #1324 removed `Result` from the language, so `?` no longer type-directs
// between two monads — `Option` is the only one it lowers to.

let half = (n: Int) -> Option[Int] {
  if n % 2 == 0 { Some(n / 2) } else { None }
}
let sum_halves = (a: Int, b: Int) -> Option[Int] {
  let x = half(n = a)?
  let y = half(n = b)?
  Some(x + y)
}

test "? on Option: all Some yields inner values" {
  match sum_halves(a = 8, b = 4) {
    Some(v) => assert_eq(v, 6),
    None => assert_eq(1, 2)
  }
}
test "? on Option: None early-returns None" {
  match sum_halves(a = 8, b = 3) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
  match sum_halves(a = 7, b = 4) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
}
