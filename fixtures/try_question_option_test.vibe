// #635: the `?` railway operator generalized to Option (and Result unchanged).
//
// `opt?` yields the inner value on `Some` and early-`return None` on `None`.
// `res?` yields the inner value on `Ok` and early-`return Err(e)` on `Err`.
// The lowering is type-directed by the operand's head type, picked in the
// pre-check railway desugar. `Option` is a builtin; `Result` is declared
// locally (mirroring the prelude `enum Result[T, E] { Ok(T); Err(E) }`).
enum Result[T, E] {
  Ok(T);
  Err(E)
}

let half = (n: Int) -> Option[Int] {
  if n % 2 == 0 { Some(n / 2) } else { None }
}
let sum_halves = (a: Int, b: Int) -> Option[Int] {
  let x = half(a)?
  let y = half(b)?
  Some(x + y)
}

let checked = (n: Int) -> Result[Int, String] {
  if n >= 0 { Ok(n) } else { Err("neg") }
}
let sum_checked = (a: Int, b: Int) -> Result[Int, String] {
  let x = checked(a)?
  let y = checked(b)?
  Ok(x + y)
}

test "? on Option: all Some yields inner values" {
  match sum_halves(8, 4) {
    Some(v) => assert_eq(v, 6),
    None => assert_eq(1, 2)
  }
}
test "? on Option: None early-returns None" {
  match sum_halves(8, 3) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
  match sum_halves(7, 4) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
}
test "? on Result: all Ok yields inner values" {
  match sum_checked(2, 3) {
    Ok(v) => assert_eq(v, 5),
    Err(_) => assert_eq(1, 2)
  }
}
test "? on Result: Err early-returns Err" {
  match sum_checked(2, 0 - 1) {
    Ok(_) => assert_eq(1, 2),
    Err(e) => assert_eq(e, "neg")
  }
}
