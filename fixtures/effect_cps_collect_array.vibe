// CPS-based handler: collect yielded values into array
effect Yield {
  Yield(Int) -> Unit
}

let result = handle {
  perform Yield::Yield(10)
  perform Yield::Yield(20)
  perform Yield::Yield(30)
  0
} {
  Yield::Yield(v, k) => v + k(0)
}
// 10 + 20 + 30 + 0 = 60
result

__DATA__
{"error_contains": "BadCall"}
