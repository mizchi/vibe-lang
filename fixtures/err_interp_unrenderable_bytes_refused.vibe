// #2987: `Bytes` has no renderer and nothing can be derived for a builtin, so
// interpolating one printed its allocation address (`show=840`). Refused at
// check time, naming the conversion to write instead.
export let _start: () -> Int = () -> {
  let b = Bytes::new()
  Bytes::push(b, 65)
  let s = "show=\{b}"
  String::length(s)
}
