// JSON serialization and round-trip
let obj = Json::parse("{\"x\":1,\"y\":\"hello\",\"z\":true}")
let s = Json::stringify(obj)
let obj2 = Json::parse(s)
let x = Json::number(Json::get(obj2, "x"))
let y = Json::string(Json::get(obj2, "y"))
let z = Json::bool(Json::get(obj2, "z"))
z

