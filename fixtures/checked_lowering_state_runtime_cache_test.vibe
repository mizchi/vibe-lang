import @vibe/compiler/runtime {
  ensure_module_typed_lowering_offsets_for_source,
  module_typed_eq_rows_for_path,
  module_typed_lowering_bind_source,
  module_typed_lowering_memo_put,
  module_typed_lowering_memo_reset,
  module_typed_lowering_offsets_for_source
}
import @vibe/checker/lowering {
  bind_checked_lowering_source, checked_eq_rows_for_path, checked_lowering_for_source, record_checked_lowering, reset_checked_lowering_memo
}

test "runtime publication and checker queries share one source-bound lowering owner" {
  module_typed_lowering_memo_reset()
  module_typed_lowering_memo_put(path = "from-runtime", fingerprint = "first", offsets = [80], eq_offs = [11], eq_keys = ["Int"])
  module_typed_lowering_bind_source(path = "from-runtime", fingerprint = "first", source = "first source")
  assert(checked_lowering_for_source(path = "from-runtime", source = "first source") == Some([
    80
  ]))
  assert(checked_eq_rows_for_path("from-runtime") == Some(([11], ["Int"])))
  reset_checked_lowering_memo()
  assert(module_typed_lowering_offsets_for_source(path = "from-runtime", source = "first source") == None)
}

test "checker publication and runtime acceptance use the same fingerprint and source witness" {
  reset_checked_lowering_memo()
  record_checked_lowering(path = "from-checker", fingerprint = "first", offsets = [88], eq_offs = [12], eq_keys = ["Int"])
  bind_checked_lowering_source(path = "from-checker", fingerprint = "first", source = "first source")
  assert(module_typed_lowering_offsets_for_source(path = "from-checker", source = "first source") == Some([
    88
  ]))
  assert(module_typed_eq_rows_for_path("from-checker") == Some(([12], ["Int"])))
  record_checked_lowering(path = "from-checker", fingerprint = "second", offsets = [96], eq_offs = [], eq_keys = [])
  assert(module_typed_lowering_offsets_for_source(path = "from-checker", source = "first source") == None)
  assert(ensure_module_typed_lowering_offsets_for_source(path = "alias", fingerprint = "second", source = "second source"))
  assert(checked_lowering_for_source(path = "alias", source = "second source") == Some([96]))
  module_typed_lowering_memo_reset()
  assert(checked_lowering_for_source(path = "alias", source = "second source") == None)
}
