// #3517: `Parallel::map` runs each element's task to completion like
// `TaskGroup::spawn`, so its closure is refused the same way when it uses
// `Async`. Before the fix this compiled clean and answered 5737 (measured on
// the committed seed) where 10 + 20 + 30 = 60 is right. Compiled and refused by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent {
  TaskGroup, Parallel
}

fn work(x: Int) -> Int with Async {
  x * 10
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let ys = Parallel::map(g, [1, 2, 3], (x: Int) -> {
      work(x)
    })
    Array::get(ys, 0) + Array::get(ys, 1) + Array::get(ys, 2)
  })
}
