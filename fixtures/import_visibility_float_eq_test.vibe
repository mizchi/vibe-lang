// #716 confirmed repro: `import ./lib/@vibe/builtin/float.vibe { eq }` must bind
// `eq` to float.vibe's typed eq, not the builtin scalar fast-path. Needs all
// three fixes: import-visibility renaming (#716), top-level fn-alias call
// support (float.vibe's `export let eq = float_eq`), and float-param
// tracking for the f64 compare under RC.

import ../lib/@vibe/builtin {
  eq
}

test "imported float.vibe eq computes float equality (#716)" {
  assert(eq(1.5, 1.5))
  assert(!(eq(0.3, 0.4)))
}
