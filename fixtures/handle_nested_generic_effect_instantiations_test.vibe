// #3022 review: a nested handle discharges its own body, so an inner
// `State[String]` handler inside an outer `State[Int]` one is not checked
// against the outer instantiation.
effect State[S] {
  Get() -> S
}

fn get_int() -> Int with State[Int] {
  perform State::Get()
}

fn get_str() -> String with State[String] {
  perform State::Get()
}

fn nested() -> Int {
  handle {
    let s = handle {
      get_str()
    } with { State::Get() => resume("abc") }
    get_int() + String::length(s)
  } with { State::Get() => resume(1) }
}

test "nested handles of one generic effect at two instantiations" {
  inspect(nested(), "4")
}
