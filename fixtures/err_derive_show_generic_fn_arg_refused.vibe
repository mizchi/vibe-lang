// #3092: a `derive (Show)` generic struct instantiated at a function type
// (`B[(Int) -> Int]`) rendered the payload's table index (`B { v: 1 }`). The
// checker walks a nominal type's arguments, so the interpolation is refused.
struct B[T] {
  v: T
} derive (Show)

fn inc(x: Int) -> Int {
  x + 1
}

export let _start: () -> Int = () -> {
  let b: B[(Int) -> Int] = B::{ v: inc }
  let s = "b=\{b}"
  String::length(s)
}
