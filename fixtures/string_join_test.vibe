// String::join: join array of strings with separator

test "string join" {
  let parts = ["hello", "world", "foo"]
  let joined = String::join(parts, sep = ", ")
  let split_back = String::split(joined, sep = ", ")
  let rejoined = String::join(split_back, sep = "-")
  inspect(rejoined, "hello-world-foo")
}
