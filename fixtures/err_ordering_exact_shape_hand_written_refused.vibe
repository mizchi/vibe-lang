// #3042 (Codex on #3063): the importer is checked against the prelude's
// `Ordering::compare -> Ordering`, while the dependency wrote its own
// `compare -> Int`. The lowering refuses the pair instead of linking one to
// the other (tests/gates/early/run.sh).
import ./modules/ordering_exact_shape_hand_written_dep.vibe { sign_of }

fn main() -> Unit {
  let _ = Ordering::compare(sign_of(1), sign_of(0 - 1))
}
