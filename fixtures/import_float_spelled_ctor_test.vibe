// Importing a constructor spelled `Double` / `Float` imports that
// constructor. The import item is kept as written: reading it as the float
// type's canonical `Float64` / `Float32` (#3728) made this import fail with
// `imported name 'Float64' is not exported`.
import ./_import_float_spelled_ctor_dep.vibe { Token, Double, Float, weight }

test "a constructor spelled like a float type imports as that constructor" {
  let d: Token = Double(21)
  let f: Token = Float
  inspect(weight(d), content = "42")
  inspect(weight(f), content = "1")
  let label = match d {
    Double(n) => "double \{n}",
    _ => "other"
  }
  inspect(label, content = "double 21")
}
