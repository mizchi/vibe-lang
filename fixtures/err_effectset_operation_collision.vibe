// ADR-0071 step 2 (docs/effectset.md, #755): operation and effectset names
// share the effect-row member namespace ("同じ effect に Read operation と
// Env::Read effectset を同時に宣言するなど、参照が曖昧になる定義は reject
// する"). `Env::Read` here is ambiguous between the `Read` operation of
// `Env` and this qualified effectset -- must be rejected.
effect Env {
  Read -> Int
}

effectset Env::Read = { Env::Read }
