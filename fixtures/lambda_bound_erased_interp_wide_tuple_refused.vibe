//# #2745: a tuple with TEN elements.
//
// Codex, P1 round 16 on #2761. Measured on `d45378d`: a ten-element tuple
// bound to a name and destructured blanked every binder, and the extracted `T`
// printed a 3-digit pointer decimal.
//
// `digit_str` SATURATES at 9, so index 9 and above would have shared a key.
// The recorder stopped at index 8 to keep keys distinct and
// `dtd_interp_tuple_elems_known` rejected every arity above nine, which was
// documented as this walk's fail-open answer -- and fail-open here means a
// pointer rendered, not a program refused.
//
// The cap was avoidable the whole time: `idx_str`, already in this file, writes
// multi-digit indices distinctly. Both caps are gone, and
// `dtd_interp_index_of_field` PARSES rather than comparing against the nine
// saturating spellings, so the inverse is total over what `idx_str` writes.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let p = (1, 2, 3, 4, 5, 6, 7, 8, 9, a)
    match p {
      (_, _, _, _, _, _, _, _, _, b) => b
    } } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
