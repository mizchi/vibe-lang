let inner = () -> Int with { Error } {
  throw("inner error")
}
let outer = () -> String with { Error } {
  let _ = handle {
    inner()
  } {
    Error(msg) => throw(String::concat("wrapped: ", msg))
  }
  "unreachable"
}
let result = handle {
  outer()
} {
  Error(msg) => msg
}
result

__DATA__
{"last": "\"wrapped: inner error\""}
