let inner = () -> Int with Exception {
  throw("inner error")
}
let outer = () -> String with Exception {
  let _ = handle {
    inner()
  } with Exception {
    Throw(msg) => throw(String::concat("wrapped: ", msg))
  }
  "unreachable"
}
let result = handle {
  outer()
} with Exception {
  Throw(msg) => msg
}
result

__DATA__
{"last": "\"wrapped: inner error\""}
