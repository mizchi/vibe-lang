import ../lib/@vibe/core {
  inspect
}

// ADR-0071 step 3 (docs/effectset.md, #755): effectset row expansion also
// covers a function PARAMETER's own function-typed row (the #885
// callback-overlay case), not just a function's own top-level declared
// row. `run_with`'s parameter `f: () -> Int with AskAll` gets expanded
// (checker_stmt.vibe's es_expand_top_value, walking `params`) before TWO
// separate checks run: the type-level argument-compatibility subtyping
// check (checker.vibe's effect_row_dropped, comparing `read_one`'s actual
// `() -> Int with Ask::Get` type against the parameter's expected
// type) and the perform-effect leak-through check (checker_effects.vibe's
// #885 callback overlay, requiring `run_with` itself to authorize what its
// parameter may perform). Both were originally comparing raw,
// non-expanded row strings ("AskAll" vs "Ask::Get" -- never equal); moving
// the expansion to run once, early, in check_program (before check_stmts)
// fixed the type-level check, and es_expand_top_value fixed the perform
// leak-through check.
effect Ask {
  Get -> Int
}

effectset AskAll = {
  Ask::Get
}

let run_with = (f: () -> Int with AskAll) -> Int with AskAll {
  f()
}

let read_one = () -> Int with Ask::Get {
  perform Ask::Get
}

export let main = () -> Int with Ask + Ask::Get {
  handle {
    run_with(read_one)
  } with Ask {
    Get => resume(42)
  }
}

test "effectset expansion covers a callback parameter's own row" {
  // #1571: expectation lives beside the code (updatable via `vibe test
  // --update`) instead of in a `__DATA__` tail. The wrapping handle is
  // required because a test block's own row cannot authorize `Ask`;
  // `main` discharges the effect itself, so the outer arm can never fire
  // (resume(0) is deliberately NOT the expected value: the inner handler
  // must win). Calling a self-discharging fn from under another handle for
  // the same effect was rejected before #1595.
  handle {
    inspect(main(), "42")
  } with Ask {
    Get => resume(0)
  }
}
