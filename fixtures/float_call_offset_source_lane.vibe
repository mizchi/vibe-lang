//# Functions

// #2158: the checker's per-call-site Double answer reaching the LINEAR
// backend's floatish classifiers, via CompileCtx.float_call_offsets.
//
// Everything `compute_float_returning_names` can answer is keyed by the
// CALLEE'S NAME, so it only ever speaks about a direct call to a top-level
// `fn` carrying a literal `-> Double` return annotation. The shapes below have
// no such name to key on, or a name whose declared return type is not Double,
// and every one of them rendered the f64 bits as a plausible-looking integer.
// Measured on stage2 at `56f7a942`, before the offset channel:
//
//   let f = () -> { 2.5 }; f()                      -> 300
//   id(2.5)          where `fn id[T](v: T) -> T`    -> 328
//   let g = dbl; g(1.25)                            -> 500
//   Array::get(arr(), 0)  where arr() -> Array[..]  -> 658
//   let lam = (v: Double) -> Double { .. }; lam(..) -> 864
//
// THIS FILE MUST BE COMPILED THROUGH THE SINGLE-SOURCE LANE
// (`compile_source_wasi_only`), which is the linear entry that supplies the
// offsets -- it is the one that already runs a whole-program `check_program`,
// so the observation costs no extra pass. `scripts/vibe_test.sh` and
// `scripts/unit_test_runner.sh` both set VIBE_FS_COMPILE=1 and would take the
// FS merge lane instead, where this channel is NOT wired (see
// `compile_file_fs_mode`'s comment for the measurement that says why). That is
// why the file is named without a `_test` suffix -- the `*_test.vibe` glob
// would route it to the wrong lane -- and why it is run by an explicit block
// in tests/gates/late/run.sh instead.
//
// The gc lane's copy of the same shapes lives in
// fixtures/float_return_to_string_gc_test.vibe.

fn dbl(x: Double) -> Double {
  x * 2.0
}

fn id[T](v: T) -> T {
  v
}

fn arr() -> Array[Double] {
  [2.5, 3.5]
}

fn int_pair() -> (Int, Int) {
  (3, 4)
}

fn declared(b: Bool) -> Double {
  if b {
    6.5
  } else {
    7.5
  }
}

//# Tests

test "#2158 offsets: an inferred lambda's result" {
  // No declared return type anywhere -- nothing for a signature scan to read.
  let f = () -> {
    2.5
  }
  assert_true(__to_string(f()) == "2.5")
}

test "#2158 offsets: a generic instantiated at Double" {
  // `id` is declared `-> T`. A per-DECLARATION answer has to be wrong for one
  // of these two call sites whichever way it goes; only a per-CALL-SITE type
  // is right for both.
  assert_true(__to_string(id(2.5)) == "2.5")
  assert_true(__to_string(id(1)) == "1")
}

test "#2158 offsets: a call through a local alias" {
  // `dbl`'s `-> Double` is real, but the name at the call site is `g`.
  let g = dbl
  assert_true(__to_string(g(1.25)) == "2.5")
}

test "#2158 offsets: a call through an annotated lambda binding" {
  let lam = (v: Double) -> Double {
    v * 2.5
  }
  assert_true(__to_string(lam(1.0)) == "2.5")
}

test "#2158 offsets: Array::get on an Array[Double]" {
  // A builtin: no user declaration to scan, and the element type is only
  // known after inference.
  assert_true(__to_string(Array::get(arr(), 0)) == "2.5")
}

test "#2158 offsets: the shape the name table already covered still works" {
  // A control. The offset term is ADDITIVE -- it can add a Double
  // classification and never remove one -- so this must keep passing.
  assert_true(__to_string(declared(true)) == "6.5")
}

test "#2158 offsets: an Int-returning call is NOT reclassified" {
  // The other direction. The checker records these results as Int, so their
  // offsets never enter the table. A table that over-approximated here would
  // read a tagged integer as an f64 and print garbage for 7.
  assert_true(__to_string(int_pair().0 + int_pair().1) == "7")
  assert_true(__to_string(int_pair().0) == "3")
}

test "#2231: a call whose callee is not a name at all" {
  // The ECall offset is the key `float_call_offsets` uses, and the checker
  // records an occurrence only when it is >= 0. `callee_offset` returns -1 for
  // a callee that is not a name, an `EDot` or a call -- so an
  // immediately-invoked lambda had no offset to be recorded under, and the
  // Double it returns printed its raw f64 bits (`372`). The call node now
  // falls back to the offset of the `(` that opens its argument list, which no
  // other call node can share.
  //
  // The callee's OWN offset is still preferred where it exists: `[@off=N:M]`
  // diagnostics point at the callee (#1514), the better edit point.
  assert_true(__to_string((() -> {
    2.5
  })()) == "2.5")
}

test "#2158 offsets: a parenthesised callee is still a name" {
  // #2226 review asked for the offset lookup to be hoisted above
  // `if is_eident(callee)`, since the table is keyed by the CALL NODE and
  // knows nothing about the callee. That is done, and this row is what the
  // hoist buys today: parentheses do not change the AST, so this was always an
  // `EIdent` callee -- it is the control that says the hoist did not break the
  // shapes that already worked.
  let f = () -> {
    2.5
  }
  assert_true(__to_string((f)()) == "2.5")
}

// #2231: a call whose callee IS, or roots at, another call.
//
// These printed raw f64 bits until `call_site_offset` (parser_expr_core.vibe).
// The cause was not a missing offset -- `build_call_expr` took the callee's,
// and for these shapes the callee's offset IS the inner call's, so the outer
// and inner nodes keyed the SAME entry in `float_call_offsets`.
//
// This comment used to say the checker "does not record that call as a primary
// CallResult", and used `(mkh().f)()` alone as the evidence, which pointed at
// the callee being a field. Measuring more shapes killed that reading: an `if`
// EXPRESSION receiver works (it lends no offset, so the `(` fallback gives the
// call a unique one), and `mkf()()` fails with no dot anywhere. Whether the
// callee is a name was never the variable; whether it owns its offset was.
//
// Measured on stage2 `fix2231_4d336bf7`, before -> after:
//
//   h.f()                    2.5  ->  2.5   receiver is a binding
//   o.h.f()                  2.5  ->  2.5   receiver is a nested field
//   (if c { h } else { h }).f()
//                            2.5  ->  2.5   receiver is an if EXPRESSION
//   mkh().f()                868  ->  2.5
//   (mkh().f)()              908  ->  2.5
//   mkf()()                  936  ->  2.5   no dot at all
//   idh(mkh()).f()           976  ->  2.5
//   Array::get(hs, 0).f()   1004  ->  2.5
struct FloatBox {
  get: () -> Double
}

fn mk_box() -> FloatBox {
  FloatBox::{
    get: () -> {
      2.5
    }
  }
}

fn mk_thunk() -> (() -> Double) {
  () -> {
    2.5
  }
}

fn box_id(b: FloatBox) -> FloatBox {
  b
}

test "#2231 offsets: a call whose callee is itself a call" {
  // No dot: the outer call's callee is the inner call. Nothing here is a name,
  // a field, or a parenthesis -- the shape is the whole finding.
  assert_true(__to_string(mk_thunk()()) == "2.5")
}

test "#2231 offsets: a dot-call whose receiver is a call" {
  assert_true(__to_string(mk_box().get()) == "2.5")
  assert_true(__to_string((mk_box().get)()) == "2.5")
  assert_true(__to_string(box_id(mk_box()).get()) == "2.5")
  let boxes = [mk_box()]
  assert_true(__to_string(Array::get(boxes, 0).get()) == "2.5")
}

test "#2231 offsets: the shapes that already worked still do" {
  // The controls. Each has a receiver that does NOT root at a call, so each
  // keeps the historical callee-start offset -- if `call_site_offset` widened
  // to every callee these would still pass, which is why the failing rows
  // above are the ones that carry the claim, and these only guard against a
  // regression in the other direction.
  let b = mk_box()
  assert_true(__to_string(b.get()) == "2.5")
  let outer = (b, 1)
  assert_true(__to_string(outer.0.get()) == "2.5")
  assert_true(__to_string((if true {
    b
  } else {
    b
  }).get()) == "2.5")
}
