// #1902: fused String-native SIMD scan for a line-comment terminator.
// The builtin returns the LF byte offset, or len when the suffix has no LF.

fn scalar_scan(s: String, pos: Int, len: Int) -> Int {
  let mut i = pos
  while i < len && String::char_code_at(s, at = i) != 10 {
    i = i + 1
  }
  i
}

#zero_alloc
fn line_end_scan(s: String, pos: Int, len: Int) -> Int {
  simd_scan_line_end_str(s, pos, len)
}

fn same_as_scalar(s: String, pos: Int) -> Bool {
  let len = String::length(s)
  line_end_scan(s = s, pos = pos, len = len) == scalar_scan(s = s, pos = pos, len = len)
}

test "short tails and EOF match scalar scan" {
  assert(same_as_scalar(s = "short comment", pos = 0))
  assert(same_as_scalar(s = "abc\nrest", pos = 0))
  assert(same_as_scalar(s = "prefix\nrest", pos = 3))
}

test "full SIMD chunks find LF boundaries" {
  assert(same_as_scalar(s = "abcdefghijklmnop\nrest", pos = 0))
  assert(same_as_scalar(s = "abcdefghijklmnopqrstuvwxyzABCDE\nrest", pos = 0))
  assert(same_as_scalar(s = "0123456789abcdef0123456789abcdefplain", pos = 0))
}

test "UTF-8 byte offsets and non-zero starts match scalar scan" {
  assert(same_as_scalar(s = "日本語の長いコメントabcdefghijklmnop\nrest", pos = 0))
  assert(same_as_scalar(s = "prefix: abcdefghijklmnopqrstuvwxyz\nrest", pos = 8))
}
