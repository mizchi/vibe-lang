// #3073 control: nested `derive (Ord)` / `derive (Show)` keep working. The
// refusal only fires when a field's declared type provides no `compare` /
// `to_string`.
struct Inner {
  x: Int
} derive (Ord, Show)

enum Kind {
  Small;
  Big(Inner)
} derive (Ord, Show)

struct Outer {
  inner: Inner;
  kind: Kind
} derive (Ord, Show)

fn rank(o: Ordering) -> String {
  match o {
    Less => "less",
    Equal => "equal",
    Greater => "greater"
  }
}

test "nested derive (Ord) compares field by field" {
  let a = Outer::{ inner: Inner::{ x: 1 }, kind: Small }
  let b = Outer::{ inner: Inner::{ x: 2 }, kind: Small }
  let c = Outer::{ inner: Inner::{ x: 1 }, kind: Big(Inner::{ x: 0 }) }
  inspect("\{rank(Outer::compare(a, b))} \{rank(Outer::compare(b, a))} \{rank(Outer::compare(a, c))} \{rank(Outer::compare(a, a))}", content = "less greater less equal")
}

test "nested derive (Show) renders field by field" {
  let c = Outer::{ inner: Inner::{ x: 1 }, kind: Big(Inner::{ x: 0 }) }
  inspect("\{c}", content = "Outer { inner: Inner { x: 1 }, kind: Big(Inner { x: 0 }) }")
}
