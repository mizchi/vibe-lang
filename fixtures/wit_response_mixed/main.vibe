// #2066: a WIT response and a scalar WIT future from ONE interface, in flight
// together. The interface's instance type declares `async func() ->
// response` and `async func() -> s64`, the adapter decodes each call's result
// slot by its kind, and the two land in one producer delay. 200 + (1+2+3) + 5 = 211. Compiled, validated and executed
// by scripts/test_wit_async_import_component_gate.sh.
import ./client_bindings.vibe {
  fetch_a, pending_count
}

fn body_sum(body: HostStream) -> Int with Async {
  let mut total = 0
  for b in body {
    total = total + b
  }
  total
}

let run: () -> Int with Async = () -> {
  let r = fetch_a()
  let n = pending_count()
  let resp = await(r)
  let count = await(n)
  HostResponse::status(resp) + body_sum(HostResponse::body(resp)) + count
}
