// A handle-bound closure keeps its handler and can be called through this data path.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn result() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let mut f = () -> 7
    let mut n = 0
    let mut total = 0
    while n < 2 {
      if n > 0 {
        total = apply(f = f)
      }
      f = Array::get([g], at = 0)
      n = n + 1
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}

test "handle-bound callback through assigned in loop" {
  inspect(result(), content = "106")
}
