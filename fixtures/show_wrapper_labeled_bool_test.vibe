// ADR-0120 Phase 4 requires the label on `show(value = ..)`. A Bool argument
// passed with a label to a Show wrapper was keyed by its label node, so the
// render row was missed and `show(value = l())` printed `1`.

fn show(value: Bool) -> String {
  __to_string(value)
}

fn show2(_ value: Bool) -> String {
  __to_string(value)
}

test "a labeled Bool argument of a Show wrapper renders as a Bool" {
  let l = () -> Bool { 1 < 2 }
  inspect(show(value = l()), content = "true")
  inspect(show2(l()), content = "true")
}
