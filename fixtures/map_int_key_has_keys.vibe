// Map with Int keys: has_key and keys operations
let _start = () -> {
  let b = MapBuilder::new()
  MapBuilder::set(b, 10, 100)
  MapBuilder::set(b, 20, 200)
  MapBuilder::set(b, 30, 300)
  let m = MapBuilder::freeze(b)
  let has10 = Map::has_key(m, 10)
  let has99 = Map::has_key(m, 99)
  let ks = Map::keys(m)
  let count = Array::length(ks)
  if has10 && not(has99) && count == 3 { 1 } else { 0 }
}
_start()

