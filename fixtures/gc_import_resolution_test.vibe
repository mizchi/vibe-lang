// #2376: the wasm-gc test lane resolves the same filesystem module graph as
// the linear lane. This one non-trait fixture covers selective imports, local
// aliases, and a re-export facade without relying on a GC-only builtin gap.

import ./import_visibility_facade.vibe {
  pick as facade_pick
}

import ./import_visibility_dep_b.vibe {
  pick as direct_pick
}

test "wasm-gc resolves ordinary imports, aliases, and re-exports" {
  assert_eq(facade_pick(), 1)
  assert_eq(direct_pick(), 2)
}
