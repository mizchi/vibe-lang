// #3156 review: a bound that extends `Send` (`trait Work: Send`) is Send
// inside the generic body (region_ok_spawnable_supertrait_send.vibe), so its
// instantiation must be Send as well. `impl Work for Array[Int]` is a legal
// declaration -- supertraits are not enforced on an impl -- but using
// `Array[Int]` at a `[T: Work]` bound is refused: `Array` is not Send. Before
// this, the call compiled.

trait Work: Send {
  weight(Self) -> Int
}

impl Work for Array[Int] {
  weight(self: Array[Int]) -> Int {
    Array::length(self)
  }
}

fn w[T: Work](x: T) -> Int {
  Work::weight(x)
}

export let main = () -> Int {
  w([1, 2])
}
