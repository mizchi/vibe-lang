import @vibe/compiler/loader {
  parse_program_located_shared, parse_program_located_shared_ran_parser
}

fn main() -> Int allows Exception {
  let mut statements = 0
  let mut i = 0
  while i < 21 {
    let rows = parse_program_located_shared(path = "one.vibe", source = "let one = 1")
    assert(parse_program_located_shared_ran_parser() == (i == 0))
    statements = statements + Array::length(rows)
    i = i + 1
  }
  statements
}
