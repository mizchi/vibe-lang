import @vibe/compiler/loader {
  parse_program_located_shared, parse_program_located_shared_ran_parser
}

fn read_repeatedly(path: String, source: String) -> Int with Exception {
  let mut statements = 0
  let mut i = 0
  while i < 21 {
    let rows = parse_program_located_shared(path = path, source = source)
    assert(parse_program_located_shared_ran_parser() == (i == 0))
    statements = statements + Array::length(rows)
    i = i + 1
  }
  statements
}

fn main() -> Int allows Exception {
  let plain = read_repeatedly(path = "one.vibe", source = "let one = 1")
  // Three declarations followed by the qualified-pattern, test-row and positional-parameter markers.
  let marked = read_repeatedly(path = "marked.vibe", source = "enum Color { Red }\nfn choose(_ c: Color) -> Int { match c { Color::Red => 1 } }\ntest \"row\" allows Exception { assert(true) }")
  assert(plain == 21)
  assert(marked == 126)
  plain + marked
}
