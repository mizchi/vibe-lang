// #3350: an `Eq` that declares methods but no `equals(Self, Self) -> Bool`
// supplies no witness for `==`, so `[T: Eq]` at a struct is refused.
//
// The #2612 guard refused a MARKER `Eq` -- one with no methods -- and stood
// down for any `Eq` with a method. But `==` dispatches only through `equals`
// (`dtd_eq_witness_dict`), so here it lowered to the builtin comparison:
// measured on the #3327 stage2 (43ee1c792), this checked clean and answered
// `false` for two equal `Pt`.

trait Eq {
  tag(Self) -> Int
}

struct Pt {
  v: Int
}

impl Eq for Pt {
  tag(a: Pt) -> Int {
    a.v
  }
}

fn same[T: Eq](x: T, y: T) -> Bool {
  x == y
}

fn main() -> Unit allows Console {
  println(__to_string(same(Pt::{ v: 1 }, Pt::{ v: 1 })))
}
