//# A `let mut` binding needs the same fail-closed sentinel as `let`: after the
//# initially untyped empty array becomes non-empty, `==` must not use identity.

export fn _start() -> Int {
  let mut left = [
  ]
  Array::push(left, 1)
  let mut right = [
  ]
  Array::push(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
