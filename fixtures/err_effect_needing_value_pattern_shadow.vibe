// #4065: a pattern binder that shares a name the scrutinee reads. A pattern's
// binders scope over the arm, not over the rest of the pattern, so `x` reads
// the outer `data` (an alias of the closure), not the `data` the same pattern
// binds beside it; `x` holds the closure and handing it to a row-free
// parameter is refused at build time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let pure = () -> 7
    let data = g
    match (pure, data) {
      (data, x) => apply(f = x)
    }
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
