// #1081 step 3 (ADR-0068 region generativity): a plain, non-escaping
// nursery use must keep compiling and running exactly as before regions
// existed. This is the positive regression pin alongside the two negative
// fixtures (err_region_escape_return.vibe, err_region_escape_outer_mut.vibe).
import @vibex/concurrent { TaskGroup, TaskHandle }

let _start = () -> Int with Exception {
  TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> { 40 })
    let v = TaskHandle::join(h)
    v + 2
  })
}
_start()

