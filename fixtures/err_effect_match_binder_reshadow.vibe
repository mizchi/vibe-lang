// #1720: a match-pattern binder masks an older inert-local proof.
effect Ask {
  Get(Int) -> Int
}

enum Box {
  Box(() -> Int with Ask)
}

fn maker() -> () -> Int with Ask {
  () -> Int with Ask {
    perform Ask::Get(1)
  }
}

let _start = () -> Int {
  handle {
    let seed = perform Ask::Get(0)
    let pick = () -> Int {
      5
    }
    match Box(maker()) {
      Box(pick) => seed + pick()
    }
  } with {
    Ask::Get(n) => {
      let k = resume
      k(n + 10)
    }
  }
}
