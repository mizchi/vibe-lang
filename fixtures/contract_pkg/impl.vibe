// Implementation of ../contract_pkg/index.vibei (#729). Declared defs are
// exported (transitional, until #732 removes the export keyword); helpers
// stay unexported and package-private.

export fn add(x: Int, y: Int) -> Int { x + y }

export fn scale(k~: Int, v~: Int) -> Int { k * v }

export fn clamp(x: Int, lo: Int, hi: Int) -> Int {
  if x < lo { lo } else if x > hi { hi } else x
}

fn helper_unexported(x: Int) -> Int { x + 99 }
