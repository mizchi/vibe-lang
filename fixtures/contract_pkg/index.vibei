// #729 (ADR-0063 Phase C): a contract package. The top level of this file
// IS the package's public API: transparent type definitions (the definition
// is the contract), opaque type declarations (implemented + exported by an
// implementation file, shape hidden by convention until type-level sealing
// lands), bodyless fn declarations, and the implementation files that
// provide them.

import ./impl.vibe {}

struct Point {
  x: Int;
  y: Int
}

opaque type Counter

fn add(x: Int, y: Int) -> Int
fn scale(k~: Int, v~: Int) -> Int
fn clamp(x: Int, lo: Int, hi: Int) -> Int where {
  requires: lo <= hi,
}
fn point_sum(p: Point) -> Int
fn counter_new(n: Int) -> Counter
fn counter_get(c: Counter) -> Int
