// #729 (ADR-0063 Phase C-2): a contract package. The top level of this file
// IS the package's public API: bodyless fn declarations + the implementation
// files that provide them. The loader conformance-checks and desugars this
// to facade re-exports, so importers see exactly the declared surface.

import ./impl.vibe {}

fn add(x: Int, y: Int) -> Int
fn scale(k~: Int, v~: Int) -> Int
fn clamp(x: Int, lo: Int, hi: Int) -> Int where {
  requires: lo <= hi,
}
