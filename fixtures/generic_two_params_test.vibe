// #1967: was fixtures/generic_two_params.vibe + __DATA__.last (1, "hello").

fn pair[A, B](a: A, b: B) -> (A, B) {
  (a, b)
}

test "generic pair keeps both arguments" {
  let value = pair(a = 1, b = "hello")
  match value {
    (n, s) => {
      inspect(n, "1")
      inspect(s, "hello")
    }
  }
}
