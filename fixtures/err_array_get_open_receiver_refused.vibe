// #3145: a builtin `Array::*` reader whose Array argument's type never
// resolves is refused at build time. `c` is an erased type parameter, and the
// call to `first` sits ABOVE its declaration, so it was checked against the
// hoisted signature `[T](T) -> Int`, which knows nothing of the body -- handed
// a Map, `Array::get` read the map's backing store by position
// (`Array::get: index 0 out of bounds`). The edit is an annotation, or the
// `Map::` operation for a Map. (Declared first, the call would be a type
// error instead: fixtures/typecheck/array_reader_formal_scheme_reject.vibe.)

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  first(m)
}

fn first[T](c: T) -> Int {
  Array::get(c, 0)
}
