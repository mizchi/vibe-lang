// #3145: a builtin `Array::*` reader whose Array argument's type never
// resolves is refused at build time. `c` is an erased type parameter, so the
// one body serves every caller -- and handed a Map, `Array::get` reads the
// map's backing store by position (`Array::get: index 0 out of bounds`). The
// edit is an annotation, or the `Map::` operation for a Map.

fn first[T](c: T) -> Int {
  Array::get(c, 0)
}

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::new(), "a", 1)
  first(m)
}
