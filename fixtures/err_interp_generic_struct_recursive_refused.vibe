// #3082: a recursive `derive (Show)` generic struct at an argument other than
// `Int` / `String` cannot be rendered by content through its erased renderer
// (before the fix, generating the render overflowed the compiler's stack).
// Refused, naming the edit.
struct L[T] {
  head: T;
  rest: Option[L[T]]
} derive (Show)

export let _start: () -> Int = () -> {
  let l: L[Bool] = L::{ head: true, rest: None }
  let s = "l=\{l}"
  String::length(s)
}
