// #635/#1324: `let*` is the Option railway.
//
// `Option` is a builtin (Some/None). #1324 removed `Result` from the language,
// so `let*` no longer type-directs between two monads — it always lowers to
// `match { Some(x) => rest, None => None }`.

// Option railway: `let* x = opt` unwraps `Some`, short-circuits the block with
// `None`.
let half = (n: Int) -> Option[Int] {
  if n % 2 == 0 { Some(n / 2) } else { None }
}
let chain_opt = (a: Int, b: Int) -> Option[Int] {
  let* x = half(a)
  let* y = half(b)
  Some(x + y)
}

test "let* on Option: all Some" {
  match chain_opt(8, 4) {
    Some(v) => assert_eq(v, 6),
    None => assert_eq(1, 2)
  }
}
test "let* on Option: short-circuits to None" {
  match chain_opt(8, 3) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
  match chain_opt(7, 4) {
    Some(_) => assert_eq(1, 2),
    None => assert_eq(0, 0)
  }
}
