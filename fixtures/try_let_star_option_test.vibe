// #635/#1324/#3044: `let*` is the Option railway for a BLOCK.
//
// `let* x = opt` unwraps `Some` and binds `x`; on `None` the enclosing block
// evaluates to `None` and the function carries on after it. `?` (see
// try_question_option_test.vibe) returns `None` from the whole FUNCTION.
// That exit target is the one difference and the reason both spellings exist
// (ADR-0117): in a function body's own top-level block they leave the same
// place, `?` is the one spelling there, and `vibe check` warns on a `let*`.

let half = (n: Int) -> Option[Int] {
  if n % 2 == 0 {
    Some(n / 2)
  } else {
    None
  }
}

// `let*` in a nested block of a function that returns `Int`: `?` could not
// be written here at all.
fn halves_or_zero(a: Int, b: Int) -> Int {
  let total = {
    let* x = half(a)
    let* y = half(b)
    Some(x + y)
  }
  match total {
    Some(t) => t,
    None => 0
  }
}

// The same nested block inside an Option-returning function: the `None`
// stops at the block, so the code after it still runs.
fn block_exit(a: Int) -> Option[Int] {
  let r = {
    let* x = half(a)
    Some(x)
  }
  Some(match r {
    Some(v) => v,
    None => 100
  })
}

// The contrast: `?` in the same position leaves the function.
fn function_exit(a: Int) -> Option[Int] {
  let r = {
    let x = half(a)?
    Some(x)
  }
  Some(match r {
    Some(v) => v,
    None => 100
  })
}

test "let* in a nested block of an Int function" {
  inspect(halves_or_zero(8, 4), content = "6")
  inspect(halves_or_zero(8, 3), content = "0")
  inspect(halves_or_zero(7, 4), content = "0")
}

test "let* exits the block, ? exits the function" {
  inspect(block_exit(4), content = "Some(2)")
  inspect(block_exit(3), content = "Some(100)")
  inspect(function_exit(4), content = "Some(2)")
  inspect(function_exit(3), content = "None")
}
