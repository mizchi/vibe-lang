trait Mappable[F[_]] {
  map[A, B](F[A], (A) -> B) -> F[B]
}

impl Mappable[Array] for Array {
  map(xs: Array[A], f: (A) -> B) -> Array[B] {
    Array::map(xs, f)
  }
}

impl Mappable[Option] for Option {
  map(xs: Option[A], f: (A) -> B) -> Option[B] {
    match xs {
      Some(value) => Some(f(value)),
      None => None
    }
  }
}

type Apply[F[_], A] = F[A]

fn map[F[_]: Mappable[F], A, B](xs: F[A], f: (A) -> B) -> F[B] {
  F::map(xs, f)
}

fn mapped[F[_]: Mappable[F], A, B](xs: Apply[F, A], f: (A) -> B) -> Apply[F, B] {
  F::map(xs, f)
}

fn mapped_again[F[_]: Mappable[F], A, B](xs: Apply[F, A], f: (A) -> B) -> Apply[F, B] {
  mapped(xs, f)
}

struct Mapper {}

fn Mapper::apply[F[_]: Mappable[F], A, B](self: Mapper, xs: F[A], f: (A) -> B) -> F[B] {
  let _ = self
  F::map(xs, f)
}

fn choose_right[F[_]: Mappable[F], G[_]: Mappable[G], A](left: F[A], right: G[A]) -> G[A] {
  let _ = left
  right
}

test "wasm-gc maps Array through a constructor-indexed witness" {
  let values = [1, 2] |> map((x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "wasm-gc maps Option through a constructor-indexed witness" {
  let value = Some(3) |> map((x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(value, Some(8))
}

test "nested calls follow the constructor named by the return type" {
  let value = choose_right([1], Some(3)) |> map((x) -> {
    x + 1
  })
  assert_eq(value, Some(4))
}

test "let bindings preserve a recovered constructor witness" {
  let values = map([1, 2], (x) -> {
    x + 1
  })
  let doubled = map(values, (x) -> {
    x * 2
  })
  assert_eq(doubled, [4, 6])
}

test "conditional receivers recover an agreed constructor witness" {
  let values = map(if true {
    [1, 2]
  } else {
    [3, 4]
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}

test "match receivers recover an agreed constructor witness" {
  let values = map(match true {
    true => [1, 2],
    false => [3, 4]
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}

test "return aliases preserve a recovered constructor witness" {
  let values = mapped([1, 2], (x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "aliased constructor parameters forward generic witnesses" {
  let values = mapped_again([1, 2], (x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "block receivers recover constructors from let bindings" {
  let values = map({
    let xs = [1, 2]
    xs
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}

test "sequence receivers recover the result constructor" {
  let values = map({
    0;
    [1, 2]
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}

test "match payload binders preserve the result constructor" {
  let source = Some([1, 2])
  let values = map(match source {
    Some(xs) => xs,
    None => []
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}

test "assignment receivers recover the continuation constructor" {
  let values = map({
    let mut xs = [1]
    xs = [2, 3]
    xs
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [3, 4])
}

test "recursive-let receivers recover the continuation constructor" {
  let values = map({
    let rec identity = (x: Int) -> Int {
      x
    }
    [identity(1), identity(2)]
  }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}

test "method-style generic calls preserve the constructor witness" {
  let mapper = Mapper::{}
  let values = map(mapper.apply([1, 2], (x) -> {
    x + 1
  }), (x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "handled receivers recover an agreed constructor witness" {
  let values = map(handle {
    [1, 2]
  } with { Exception::Throw(_) => [] }, (x) -> {
    x + 1
  })
  assert_eq(values, [2, 3])
}
