trait Mappable[F[_]] {
  map[A, B](F[A], (A) -> B) -> F[B]
}

impl Mappable[Array] for Array {
  map(xs: Array[A], f: (A) -> B) -> Array[B] {
    Array::map(xs, f)
  }
}

impl Mappable[Option] for Option {
  map(xs: Option[A], f: (A) -> B) -> Option[B] {
    match xs {
      Some(value) => Some(f(value)),
      None => None
    }
  }
}

fn map[F[_]: Mappable[F], A, B](xs: F[A], f: (A) -> B) -> F[B] {
  F::map(xs, f)
}

test "wasm-gc maps Array through a constructor-indexed witness" {
  let values = [1, 2] |> map((x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(values, [4, 6])
}

test "wasm-gc maps Option through a constructor-indexed witness" {
  let value = Some(3) |> map((x) -> {
    x + 1
  }) |> map((x) -> {
    x * 2
  })
  assert_eq(value, Some(8))
}
