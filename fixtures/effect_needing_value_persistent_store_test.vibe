// #4065: `Map::set` is persistent -- it returns a new map and leaves its
// receiver as it was -- so storing the handle-bound closure through it does
// not put the closure in the receiver. Reading a plain closure out of the
// receiver and handing it to a row-free parameter compiles and runs.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn persistent_set() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let m: Map[String, () -> Int] = Map::set(Map::new(), key = "plain", value = () -> 42)
    let bound = Map::set(m, key = "bound", value = g)
    let kept = apply(f = Map::get(m, key = "plain"))
    kept + Map::size(bound)
  } with {
    Ask::Get() => resume(5)
  }
}

test "a persistent store does not put the closure in its receiver" {
  inspect(persistent_set(), content = "144")
}
