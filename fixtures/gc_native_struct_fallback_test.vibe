// #1702 fallback pair for fixtures/gc_native_struct_local_test.vibe.
//
// A native wasm-gc struct carries no ctor tag -- the binding site fixes its
// exact struct, so the tag dispatch `EDot` normally does is unnecessary there.
// That is precisely why the value must never reach anything that would look for
// a tag. Every shape below keeps the ordinary linear-memory layout.

struct Point {
  x: Int;
  mut v: Int
}

// Returned: the record becomes a value crossing the tagged-i64 ABI.
fn escaping() -> Point {
  let q = Point::{
    x: 1,
    v: 2
  }
  q
}

// Passed to a function: same crossing, one step earlier.
fn read_x(p: Point) -> Int {
  p.x
}

fn handed_over() -> Int {
  let h = Point::{
    x: 3,
    v: 4
  }
  read_x(h)
}

// Field STORE lowers through `__set_field`, whose receiver is an ordinary
// value, not a struct.get receiver.
fn stored() -> Int {
  let m = Point::{
    x: 5,
    v: 0
  }
  m.v = 9
  m.v
}

// Captured by a closure: the capture crosses the universal i64 closure ABI.
fn captured() -> Int {
  let c = Point::{
    x: 6,
    v: 7
  }
  let peek = () -> c.x
  peek()
}

test "records that leave field-read position keep the linear layout" {
  inspect(escaping().x, "1")
  inspect(handed_over(), "3")
  inspect(stored(), "9")
  inspect(captured(), "6")
}
