// #1967: was fixtures/from_to_lines.vibe + __DATA__.last "true".
// Bare Lines::parse reaches codegen unresolved on seed. Import the
// prelude implementation (String::split / String::join).

import ../lib/@vibe/builtin {
  Lines::parse, Lines::stringify
}

test "Lines parse stringify round-trip equals the input" {
  let text = "line1\nline2\nline3"
  let lines = Lines::parse(text)
  let count = Array::length(lines)
  let back = Lines::stringify(lines)
  inspect(count, "3")
  inspect(String::equals(text, back), "true")
}
