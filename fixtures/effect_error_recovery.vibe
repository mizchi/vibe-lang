// Error recovery: throw + catch combined with effect
effect Validate { Check(String) -> Bool }

// Happy: validate → true → 42
let happy = handle {
  let ok = perform Validate::Check("input")
  if ok { 42 } else { throw("fail"); 0 }
} {
  Validate::Check(_s) => resume(true),
  Error(_msg) => -1
}

// Error: validate → false → throw → catch → -1
let err = handle {
  let ok = perform Validate::Check("input")
  if ok { 42 } else { throw("fail"); 0 }
} {
  Validate::Check(_s) => resume(false),
  Error(_msg) => -1
}

happy + err

__DATA__
{"last": "41"}
