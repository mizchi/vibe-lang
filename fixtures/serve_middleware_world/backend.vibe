// #2066: the backend the middleware fixture forwards to -- an ordinary
// `vibe serve` handler, composed on its own into a component exporting
// `wasi:http/handler`. It names what reached it, so the middleware's answer
// shows the request went through. Served by
// scripts/test_serve_body_stream_gate.sh.
export let handler = (method: String, url: String, headers: String, body: String) -> String {
  "200\n\nbackend saw \{method} \{url}"
}
