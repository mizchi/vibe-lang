// #3523 (Codex on #3524): a top-level `Async` function passed BY NAME to
// `TaskGroup::spawn`. The scheduler calls its plain original, so its
// `sleep_wait` reached no handler and trapped at run time. It is refused like
// a task closure that uses `Async`. Compiled and refused by
// tests/gates/late/adr_0068_taskgroup_g_body_syntax_sugar.sh.
import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle, sleep_wait
}

fn work() -> Int with Async {
  sleep_wait(10)
  100
}

fn main() -> Int allows Async + Exception {
  TaskGroup::run((g) -> {
    let h = TaskGroup::spawn(g, work)
    TaskHandle::join(h)
  })
}
