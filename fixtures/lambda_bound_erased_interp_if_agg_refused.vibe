//# #2745: an aggregate selected by a value-preserving WRAPPER.
//
// Codex, P1 round 25 on #2761. Measured on `d69127c`:
// `{ let p = if c { (a, 0) } else { (a, 1) }; p.0 }` printed a 3-digit pointer
// decimal. The shape recorder read a tuple LITERAL and nothing else, so a
// tuple that arrives through a branch recorded no shape at all and the
// projection had nothing to read.
//
// The FIRST branch that records a shape wins and the rest are not consulted.
// Recording them all would let a branch this pass happens not to classify blank
// a slot an earlier branch filled, and a blank slot here is a POINTER PRINTED
// rather than a program refused -- the expensive direction. One informative
// branch suffices precisely because the branches share a checked type.
//
// `if_agg_other_slot` in the green control reads a non-formal position out of
// the same shape and must still render.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T, c: Bool) -> String {
    "\{ { let p = if c {
      (a, 0)
    } else {
      (a, 1)
    }
    p.0 } }"
  }
  inner(Qt::{ w: 5 }, true)
}

export fn _start() -> Int {
  String::length(outer(7))
}
