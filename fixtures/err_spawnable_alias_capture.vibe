// #3125: err_spawnable_capture_array.vibe through a local alias of
// `TaskGroup::spawn`. The `Spawnable` check used to key off the callee's
// spelling, so this program compiled and ran a spawn capturing a plain outer
// `Array` that the literal spelling refuses. Both spellings must answer alike.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> {
    let sp = TaskGroup::spawn
    let h = sp(n, () -> {
      Array::set(seen, 0, 1)
      0
    })
    TaskHandle::join(h)
  })
  ()
}
