// #3003: a generic function may throw its own erased parameter. The throw
// site's synthesized render (for an erased `Exception::Throw(m)` arm) used to
// refuse it with the INTERPOLATION message, while `throw([x])` compiled. Both
// compile now, and the erased payload renders as a placeholder naming its type.
fn boom[T](x: T) -> Int with Exception {
  throw(x)
}

fn boom_list[T](x: T) -> Int with Exception {
  throw([x])
}

test "throwing an erased formal compiles and is caught" {
  let a = handle {
    boom(41)
  } with { Exception::Throw(_e) => 7 }
  let b = handle {
    boom_list(41)
  } with { Exception::Throw(_e) => 8 }
  inspect(a + b, "15")
}
