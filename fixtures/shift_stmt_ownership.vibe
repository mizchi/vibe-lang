import @vibe/compiler/core { Expr, Stmt }
import @vibe/parser { shift_stmts_offsets }

fn exercise(_ rounds: Int) -> Array[Stmt] {
  let input = [SLet(false, false, "value", None, EIdent("x", 3)), SEnum(false, "Flag", [], [], [])]
  let mut i = 0
  while i < rounds {
    let shifted = shift_stmts_offsets(stmts = input, delta = i + 7)
    assert_eq(Array::length(shifted), 2)
    match Array::get(shifted, at = 0) {
      SLet(_, _, _, _, EIdent(_, off)) => assert_eq(off, i + 10),
      _ => assert(false)
    }
    match Array::get(shifted, at = 1) {
      SEnum(_, name, _, _, _) => assert_eq(name, "Flag"),
      _ => assert(false)
    }
    i = i + 1
  }
  match Array::get(input, at = 0) {
    SLet(_, _, _, _, EIdent(_, off)) => assert_eq(off, 3),
    _ => assert(false)
  }
  input
}
fn main() -> Array[Array[Stmt]] allows Exception {
  let once = exercise(1)
  let many = exercise(20)
  let shifted = shift_stmts_offsets(stmts = many, delta = 9)
  [once, many, shifted]
}
