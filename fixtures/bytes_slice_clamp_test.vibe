// #3549: `Bytes::slice(b, start, end)` clamps its range exactly like
// `Array::slice`: start into [0, length], then end into [start, length]. An
// out-of-range bound truncates and an inverted range is empty. Before, the
// two disagreed on the same five elements: a negative start compared as an
// unsigned number, so `Bytes::slice(c, -2, 3)` was empty where
// `Array::slice` gives three elements, and an end past the length trapped
// `Bytes::get: index 5 out of bounds` where `Array::slice` truncates.
//
// Each case is asserted against `Array::slice` on the same values as well as
// against its literal answer, so the two cannot drift apart again. The wasm-gc
// lane runs this file in the 40h8 suite of
// tests/gates/mid/6b_40_wasm_gc_region_arena_reclamation.sh.

fn bytes_slice(b: Bytes, start: Int, end: Int) -> Array[Int] {
  let out: Array[Int] = Bytes::to_array(Bytes::slice(b, start, end))
  out
}

fn same_as_array(b: Bytes, start: Int, end: Int) -> Bool {
  let a: Array[Int] = Bytes::to_array(b)
  bytes_slice(b, start, end) == Array::slice(a, start, end)
}

test "an in-range slice copies [start, end)" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(c, 1, 4), content = "[98, 99, 100]")
  inspect(bytes_slice(c, 0, 5), content = "[97, 98, 99, 100, 101]")
  inspect(same_as_array(c, 1, 4), content = "true")
}

test "a negative start clamps to 0" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(c, -2, 3), content = "[97, 98, 99]")
  inspect(Bytes::length(Bytes::slice(c, -2, 3)), content = "3")
  inspect(same_as_array(c, -2, 3), content = "true")
  inspect(bytes_slice(c, -10, 10), content = "[97, 98, 99, 100, 101]")
  inspect(same_as_array(c, -10, 10), content = "true")
}

test "an end past the length clamps to the length" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(c, 2, 7), content = "[99, 100, 101]")
  inspect(same_as_array(c, 2, 7), content = "true")
  // 2^32 + 2: compared as a full Int, so it cannot wrap into range (#3543)
  inspect(bytes_slice(c, 0, 4294967298), content = "[97, 98, 99, 100, 101]")
  inspect(same_as_array(c, 0, 4294967298), content = "true")
}

test "an empty or inverted range is empty" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(c, 3, 1), content = "[]")
  inspect(same_as_array(c, 3, 1), content = "true")
  inspect(bytes_slice(c, 2, 2), content = "[]")
  inspect(bytes_slice(c, 5, 5), content = "[]")
  inspect(bytes_slice(c, 7, 9), content = "[]")
  inspect(same_as_array(c, 7, 9), content = "true")
  inspect(bytes_slice(c, -5, -1), content = "[]")
  inspect(same_as_array(c, -5, -1), content = "true")
  inspect(bytes_slice(c, 4294967296, 4294967298), content = "[]")
}

test "slicing an empty buffer is empty" {
  let e = Bytes::new()
  inspect(bytes_slice(e, -1, 3), content = "[]")
  inspect(bytes_slice(e, 0, 0), content = "[]")
  inspect(same_as_array(e, -1, 3), content = "true")
}

test "the slice is a copy" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  let s = Bytes::slice(c, -1, 2)
  Bytes::set(s, 0, 120)
  inspect(Bytes::get(c, 0), content = "97")
  inspect(Bytes::get(s, 0), content = "120")
}
