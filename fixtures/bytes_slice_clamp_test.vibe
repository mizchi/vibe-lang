// #3549: `Bytes::slice(b, start, end)` clamps its range exactly like
// `Array::slice`: start into [0, length], then end into [start, length]. An
// out-of-range bound truncates and an inverted range is empty. Before, the
// two disagreed on the same five elements: a negative start compared as an
// unsigned number, so `Bytes::slice(c, -2, 3)` was empty where
// `Array::slice` gives three elements, and an end past the length trapped
// `Bytes::get: index 5 out of bounds` where `Array::slice` truncates.
//
// Each case is asserted against `Array::slice` on the same values as well as
// against its literal answer, so the two cannot drift apart again. The wasm-gc
// lane runs this file in the 40h8 suite of
// tests/gates/mid/6b_40_wasm_gc_region_arena_reclamation.sh.

fn bytes_slice(b: Bytes, start: Int, end: Int) -> Array[Int] {
  let out: Array[Int] = Bytes::to_array(Bytes::slice(b, start = start, end = end))
  out
}

fn same_as_array(b: Bytes, start: Int, end: Int) -> Bool {
  let a: Array[Int] = Bytes::to_array(b)
  bytes_slice(b = b, start = start, end = end) == Array::slice(a, start = start, end = end)
}

test "an in-range slice copies [start, end)" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(b = c, start = 1, end = 4), content = "[98, 99, 100]")
  inspect(bytes_slice(b = c, start = 0, end = 5), content = "[97, 98, 99, 100, 101]")
  inspect(same_as_array(b = c, start = 1, end = 4), content = "true")
}

test "a negative start clamps to 0" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(b = c, start = -2, end = 3), content = "[97, 98, 99]")
  inspect(Bytes::length(Bytes::slice(c, start = -2, end = 3)), content = "3")
  inspect(same_as_array(b = c, start = -2, end = 3), content = "true")
  inspect(bytes_slice(b = c, start = -10, end = 10), content = "[97, 98, 99, 100, 101]")
  inspect(same_as_array(b = c, start = -10, end = 10), content = "true")
}

test "an end past the length clamps to the length" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(b = c, start = 2, end = 7), content = "[99, 100, 101]")
  inspect(same_as_array(b = c, start = 2, end = 7), content = "true")
  // 2^32 + 2: compared as a full Int, so it cannot wrap into range (#3543)
  inspect(bytes_slice(b = c, start = 0, end = 4294967298), content = "[97, 98, 99, 100, 101]")
  inspect(same_as_array(b = c, start = 0, end = 4294967298), content = "true")
}

test "an empty or inverted range is empty" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  inspect(bytes_slice(b = c, start = 3, end = 1), content = "[]")
  inspect(same_as_array(b = c, start = 3, end = 1), content = "true")
  inspect(bytes_slice(b = c, start = 2, end = 2), content = "[]")
  inspect(bytes_slice(b = c, start = 5, end = 5), content = "[]")
  inspect(bytes_slice(b = c, start = 7, end = 9), content = "[]")
  inspect(same_as_array(b = c, start = 7, end = 9), content = "true")
  inspect(bytes_slice(b = c, start = -5, end = -1), content = "[]")
  inspect(same_as_array(b = c, start = -5, end = -1), content = "true")
  inspect(bytes_slice(b = c, start = 4294967296, end = 4294967298), content = "[]")
}

test "slicing an empty buffer is empty" {
  let e = Bytes::new()
  inspect(bytes_slice(b = e, start = -1, end = 3), content = "[]")
  inspect(bytes_slice(b = e, start = 0, end = 0), content = "[]")
  inspect(same_as_array(b = e, start = -1, end = 3), content = "true")
}

test "the slice is a copy" {
  let c = Bytes::from_array([97, 98, 99, 100, 101])
  let s = Bytes::slice(c, start = -1, end = 2)
  Bytes::set(s, at = 0, value = 120)
  inspect(Bytes::get(c, at = 0), content = "97")
  inspect(Bytes::get(s, at = 0), content = "120")
}
