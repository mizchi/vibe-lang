//# Generic derived equality uses each concrete field type.

struct Box[T] {
  value: T
} derive (Eq)

struct Outer {
  box: Box[Array[Int]]
} derive (Eq)

struct Deep {
  outer: Outer
} derive (Eq)

struct Leaf[T] {
  value: T
} derive (Eq)

struct Holder[T] {
  values: Array[T]
} derive (Eq)

fn equality_snapshot(value: Bool) -> String {
  if value {
    "true"
  } else {
    "false"
  }
}

test "explicit generic Bytes fields compare structurally" {
  inspect(equality_snapshot(Box[Bytes]::{ value: Bytes::from_array([1, 2]) } == Box[Bytes]::{
    value: Bytes::from_array([1, 2])
  }), content = "true")
}

test "explicit generic Double fields compare structurally" {
  inspect(equality_snapshot(Box[Double]::{ value: 1.5 } == Box[Double]::{
    value: 1.5
  }), content = "true")
}

test "generic aggregate fields compare structurally" {
  let a = Box::{ value: [1, 2] }
  let b = Box::{ value: [1, 2] }
  inspect(equality_snapshot(a == b), content = "true")
}

test "generic aggregate equality stays structural through fields" {
  let a = Deep::{ outer: Outer::{ box: Box::{ value: [1, 2] } } }
  let b = Deep::{ outer: Outer::{ box: Box::{ value: [1, 2] } } }
  inspect(equality_snapshot(a == b), content = "true")
}

test "array and generic comparator worklists reach a fixpoint" {
  let a = Holder[Leaf[Array[Int]]]::{ values: [Leaf::{ value: [1, 2] }] }
  let b = Holder[Leaf[Array[Int]]]::{ values: [Leaf::{ value: [1, 2] }] }
  inspect(equality_snapshot(a == b), content = "true")
}

test "untyped empty bindings adopt concrete generic equality" {
  let arrays_left = []
  let arrays_right = []
  Array::push(arrays_left, Box[Array[Int]]::{ value: [1, 2] })
  Array::push(arrays_right, Box[Array[Int]]::{ value: [1, 2] })
  inspect(equality_snapshot(arrays_left == arrays_right), content = "true")
  let doubles_left = []
  let doubles_right = []
  Array::push(doubles_left, Box[Double]::{ value: 1.5 })
  Array::push(doubles_right, Box[Double]::{ value: 1.5 })
  inspect(equality_snapshot(doubles_left == doubles_right), content = "true")
  let deep_left = []
  let deep_right = []
  Array::push(deep_left, Deep::{ outer: Outer::{ box: Box::{ value: [1, 2] } } })
  Array::push(deep_right, Deep::{ outer: Outer::{ box: Box::{ value: [1, 2] } } })
  inspect(equality_snapshot(deep_left == deep_right), content = "true")
}
