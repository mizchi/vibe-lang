// A qualified generic whose bound is supplied at each call, named as a value:
// the reference carries no witness, the same as an unqualified one.
fn Util::same[T: Eq](x: T, y: T) -> Bool {
  x == y
}

export let _start: () -> Int = () -> {
  let g = Util::same
  if g(1, 1) {
    1
  } else {
    0
  }
}
