// `Int::parse` accepts exactly the Int range, both ends included.
fn shown(o: Option[Int]) -> String {
  match o {
    Some(v) => Int::to_string(v),
    None => "None"
  }
}

test "the range ends round-trip" {
  inspect(shown(Int::parse("4611686018427387903")), "4611686018427387903")
  inspect(shown(Int::parse("-4611686018427387904")), "-4611686018427387904")
  inspect(shown(Int::parse(Int::to_string(-4611686018427387904))), "-4611686018427387904")
}

test "one past either end is None" {
  inspect(shown(Int::parse("4611686018427387904")), "None")
  inspect(shown(Int::parse("-4611686018427387905")), "None")
  inspect(shown(Int::parse("99999999999999999999")), "None")
}

test "ordinary values and malformed input" {
  inspect(shown(Int::parse("42")), "42")
  inspect(shown(Int::parse("-42")), "-42")
  inspect(shown(Int::parse("0")), "0")
  inspect(shown(Int::parse("-0")), "0")
  inspect(shown(Int::parse("-4294967296")), "-4294967296")
  inspect(shown(Int::parse("")), "None")
  inspect(shown(Int::parse("-")), "None")
  inspect(shown(Int::parse("12a")), "None")
}
