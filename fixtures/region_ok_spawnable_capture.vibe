// #1081 step 3 Phase B (Spawnable[r] capture check): a spawn closure
// capturing a SAME-REGION Sender endpoint (from this same nursery's own
// Channel::bounded) is Spawnable-legal -- the exact case the roadmap calls
// out as inexpressible without regions. Positive regression pin alongside
// the two negative fixtures (err_spawnable_capture_array.vibe,
// err_spawnable_capture_cross_region.vibe).
import @vibex/concurrent { TaskGroup, TaskHandle, Channel, Sender, Receiver }

let _start = () -> Int with Exception {
  TaskGroup::run((n) -> {
    let (tx, rx) = Channel::bounded(n, 1)
    let t = TaskGroup::spawn(n, () -> {
      Sender::send(tx, 42)
      Sender::release(tx)
      0
    })
    let _ = TaskHandle::join(t)
    match Receiver::recv(rx) {
      Some(v) => v,
      None => 0 - 1
    }
  })
}
_start()

