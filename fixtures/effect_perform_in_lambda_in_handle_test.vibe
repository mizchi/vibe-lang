// Scenario 7: Perform inside a lambda inside handle body

// The lambda must carry `with Ask` to perform the effect

effect Ask {
  Question(String) -> String
}

test "effect perform in lambda in handle" {
  let result = handle {
    let ask_name = () -> String with Ask {
      perform Ask::Question("name?")
    }
    let name = ask_name()
    String::length(name)
  } with { Ask::Question(_q) => resume("Bob") }
  inspect(result, "3")
}
