// #3092: a `derive (Show)` struct with a function field rendered the field
// through `__to_string`, which printed its table index (`C { f: 1 }`).
// Refused, naming the edit.
struct C {
  f: (Int) -> Int
} derive (Show)

fn inc(x: Int) -> Int {
  x + 1
}

export let _start: () -> Int = () -> {
  let c = C::{ f: inc }
  let s = "c=\{c}"
  String::length(s)
}
