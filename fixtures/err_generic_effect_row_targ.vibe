// #1340 (ADR-0071): a bracketed row item naming a NON-generic effect is a
// definition-site error (geff_validate_row_targs, checker_stmt.vibe) — the
// instantiation cannot mean anything.
effect Log {
  Emit(Int) -> Unit
}

let f = () -> Int with { Log[Int] } {
  42
}

let main = () -> Int {
  f()
}

__DATA__
{"error_contains": "effect Log declares no type parameters"}
