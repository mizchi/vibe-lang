struct BoundSlot {
  callback: () -> Array[Int]
}

test "bound named structs preserve field provenance" {
  let _ = region r {
    let values = MutList::empty(r)
    let slot = BoundSlot::{
      callback: () -> Array[Int] {
        MutList::to_array(values)
      }
    }
    let alias = slot
    alias
  }
}
