let classify = (pair: (Int, Int)) -> String {
  match pair {
    (0, 0) => "origin",
    (0, _) => "y-axis",
    (_, 0) => "x-axis",
    (x, y) if x == y => "diagonal",
    _ => "other"
  }
}
let a = classify((0, 0))
let b = classify((0, 5))
let c = classify((3, 0))
let d = classify((4, 4))
let e = classify((1, 2))
String::concat(String::concat(String::concat(String::concat(a, ","), String::concat(b, ",")), String::concat(c, ",")), String::concat(d, String::concat(",", e)))

__DATA__
{"last": "\"origin,y-axis,x-axis,diagonal,other\""}
