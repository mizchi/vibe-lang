import ../lib/@vibe/builtin {
  Int::abs, Int::clamp, Int::is_even, Int::is_odd, Int::max, Int::min, Int::signum
}

//# Misc

test "Int::parse valid" {
  let result = Int::parse("42")
  assert(result is Some(_))
  let Some(v) = result
  assert(v == 42)
}

test "Int::parse zero" {
  let Some(v) = Int::parse("0")
  assert(v == 0)
}

test "Int::parse negative" {
  let Some(v) = Int::parse("-7")
  assert(v == -7)
}

test "Int::parse invalid" {
  let result = Int::parse("abc")
  assert(result is None)
}

test "Int::parse empty string" {
  let result = Int::parse("")
  assert(result is None)
}

test "Int::abs" {
  assert(Int::abs(5) == 5)
  assert(Int::abs(-5) == 5)
  assert(Int::abs(0) == 0)
}

test "Int::max Int::min" {
  assert(Int::max(3, 7) == 7)
  assert(Int::min(3, 7) == 3)
  assert(Int::max(-1, -5) == -1)
  assert(Int::min(-1, -5) == -5)
}

test "Int::clamp" {
  assert(Int::clamp(5, 0, 10) == 5)
  assert(Int::clamp(-5, 0, 10) == 0)
  assert(Int::clamp(15, 0, 10) == 10)
}

test "Int::is_even Int::is_odd" {
  assert(Int::is_even(4))
  assert(not(Int::is_even(3)))
  assert(Int::is_odd(3))
  assert(not(Int::is_odd(4)))
  assert(Int::is_even(0))
}

test "Int::signum" {
  assert(Int::signum(10) == 1)
  assert(Int::signum(-10) == -1)
  assert(Int::signum(0) == 0)
}
