// Combining Error (throw/catch) with user-defined effect

effect Validator {
  IsValid(String) -> Bool
}

test "effect handle error and effect" {
  let validate = handle {
    handle {
      let input = "hello"
      let valid = perform Validator::IsValid(input)
      if valid {
        String::length(input)
      } else {
        throw("invalid input")
        0
      }
    } with { Validator::IsValid(_s) => resume(true) }
  } with { Exception::Throw(_msg) => -1 }
  inspect(validate, "5")
}
