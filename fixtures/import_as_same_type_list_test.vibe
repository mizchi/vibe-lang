//# #3972: an `as` item names a type an earlier item of the same import list
//# already brought in, directly (`S, S as T`) or as an alias's target
//# (`Alias as CA, S as T` with `type Alias = S`). The renamed type was unknown;
//# each list now binds every local name it spells.

import ./modules/import_as_decl_provider.vibe {
  Alias as CA, S as T, mk
}

import ./modules/import_as_decl_provider.vibe {
  S, S as U
}

import ./modules/import_as_decl_provider.vibe {
  Alias, S as V
}

struct Holder {
  t: T;
  ca: CA;
  u: U;
  s: S;
  v: V;
  alias: Alias
}

test "every local name of a list that names one type twice" {
  let h = Holder::{ t: mk(), ca: mk(), u: mk(), s: mk(), v: mk(), alias: mk() }
  inspect(h.t.v + h.ca.v + h.u.v + h.s.v + h.v.v + h.alias.v, content = "30")
}
