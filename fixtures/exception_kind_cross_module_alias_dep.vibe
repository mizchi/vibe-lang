// Dependency of exception_kind_cross_module_alias_test.vibe: a function whose
// row spells its exception kind through a PARAMETERIZED alias the importer
// never imports.
export enum IoErr {
  NotFound(String)
}

export type Es[T] = Array[T]

export fn fail(n: Int) -> Int with Exception[Es[IoErr]] {
  if n > 0 {
    throw([NotFound("a"), NotFound("b")])
  } else {
    0
  }
}
