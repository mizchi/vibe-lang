//# #3149: an imported value's free type variable (`shared_empty :
//# Array[?t4]`) is not renamed on import, so the importer's own fresh
//# variables must start above it. They did not: the fresh payload variable of
//# `None` reached the same id and was bound to the array's element type, and
//# this correct call was a type error (`expected Option[String], got
//# Option[(String, Array[String])]`).
import ./none_imported_free_var_support.vibe { shared_empty }

fn take(a: Array[(String, Array[String])], b: Option[String]) -> Int {
  let extra = match b {
    Some(s) => String::length(s),
    None => 0
  }
  Array::length(a) + extra
}

test "a None beside an imported free-variable value keeps its own type" {
  inspect(take(shared_empty, None), content="0")
  inspect(take(shared_empty, Some("abc")), content="3")
}
