trait Measurable {
  measure(Self) -> Int
}

impl Measurable for Int {
  measure(self) -> Int {
    self
  }
}

trait Sized: Measurable {
  bump(Self) -> Int
}

impl Sized for Int {
  bump(self) -> Int {
    self + 1
  }
}

test "trait namespace operation dispatches" {
  inspect(Measurable::measure(42), "42")
}

test "subtrait namespace dispatches inherited operations" {
  inspect(Sized::measure(20) + Sized::bump(20), "41")
}
