trait Measurable {
  measure(Self) -> Int
}

impl Measurable for Int {
  measure(self) -> Int {
    self
  }
}

trait Sized: Measurable {
  bump(Self) -> Int
}

trait InheritedOnly: Measurable {
}

impl Sized for Int {
  bump(self) -> Int {
    self + 1
  }
}

impl InheritedOnly for Int {
}

test "trait namespace operation dispatches" {
  inspect(Measurable::measure(42), "42")
}

test "subtrait namespace dispatches inherited operations" {
  inspect(Sized::measure(20) + Sized::bump(20), "41")
}

test "inherited-only subtrait namespace dispatches" {
  inspect(InheritedOnly::measure(42), "42")
}
