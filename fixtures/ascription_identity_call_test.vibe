struct Box { values: Array[Int]; name: String }
type Thunk = () -> Int with Exception
fn projected(_ box: Box) -> Array[Int] {
  let values: Array[Int] = box.values
  values
}
fn id[T](_ x: T) -> T {
  x
}
fn borrowed_identity(_ x: Array[Int]) -> Array[Int] {
  x
}
fn make_values() -> Array[Int] {
  let values: Array[Int] = []
  Array::push(values, value = 17)
  values
}
test "ascription scalar kinds survive" {
  let d: Float64 = id(1.5)
  let d2: Float64 = id(2.5)
  let s: String = id("value")
  let yes: Bool = id(true)
  let mut no: Bool = id(false)
  no = !no
  inspect(d + d2, content = "4")
  inspect(s, content = "value")
  inspect(yes && no, content = "true")
}
test "ascription owns projected and borrowed heap results" {
  let box = Box::{ values: [4, 9], name: "kept" }
  let result: Array[Int] = projected(box)
  inspect(Array::get(result, at = 1), content = "9")
  inspect(box.name, content = "kept")
  let input = [3, 8]
  let alias: Array[Int] = borrowed_identity(input)
  inspect(Array::get(alias, at = 0) + Array::get(input, at = 1), content = "11")
  inspect(Array::get(make_values(), at = 0), content = "17")
}
test "ascribed function values keep their effect rows" {
  let action: Thunk = () -> Int {
    throw("value")
  }
  let result = handle {
    action()
  } with { Exception::Throw(value) => String::length(value) }
  inspect(result, content = "5")
}

test "ordinary lookalike lambdas retain their body and captured values" {
  let outer = 19
  let changed = ((__asc: Int) -> __asc + 2)(5)
  let captured = ((__asc: Int) -> outer)(5)
  let explicit_identity = ((__asc: Int) -> Int {
    __asc
  })(11)
  let ordinary_identity = ((value: Int) -> value)(13)
  inspect(changed, content = "7")
  inspect(captured, content = "19")
  inspect(explicit_identity, content = "11")
  inspect(ordinary_identity, content = "13")
}

test "ascription arguments run once and borrowed loop values remain live" {
  let cell: Array[Int] = [0]
  let result: Int = {
    Array::set(cell, at = 0, value = Array::get(cell, at = 0) + 1); 23
  }
  inspect(result, content = "23")
  inspect(Array::get(cell, at = 0), content = "1")
  let values = [[2, 3], [5, 7]]
  let mut total = 0
  for value in values {
    let alias: Array[Int] = value
    total = total + Array::get(alias, at = 0) + Array::get(value, at = 1)
  }
  inspect(total, content = "17")
  inspect(Array::get(Array::get(values, at = 1), at = 1), content = "7")
}

fn consume_alias(_ value: Array[Int]) -> Int {
  let owner = [value]
  Array::get(Array::get(owner, at = 0), at = 0)
}

fn ascribed_cell_if(_ use_cell: Bool) -> Int {
  let mut cell = [29]
  let read = () -> Int {
    Array::get(cell, at = 0)
  }
  let alias: Array[Int] = if use_cell {
    cell
  } else {
    [7]
  }
  let consumed = consume_alias(alias)
  consumed + read()
}

fn ascribed_cell_match(_ use_cell: Bool) -> Int {
  let mut cell = [29]
  let read = () -> Int {
    Array::get(cell, at = 0)
  }
  let alias: Array[Int] = match use_cell {
    true => cell,
    false => [7]
  }
  let consumed = consume_alias(alias)
  consumed + read()
}

fn ascribed_cell_block(_ use_cell: Bool) -> Int {
  let mut cell = [29]
  let read = () -> Int {
    Array::get(cell, at = 0)
  }
  let alias: Array[Int] = {
    let local = 7
    if use_cell {
      cell
    } else {
      [local]
    }
  }
  let consumed = consume_alias(alias)
  consumed + read()
}

test "ascribed compound captured-cell results own their reference" {
  inspect(ascribed_cell_if(true), content = "58")
  inspect(ascribed_cell_if(false), content = "36")
  inspect(ascribed_cell_match(true), content = "58")
  inspect(ascribed_cell_match(false), content = "36")
  inspect(ascribed_cell_block(true), content = "58")
  inspect(ascribed_cell_block(false), content = "36")
}

fn __ascription_argdup(_ n: Int) -> Int {
  n + 1
}

test "ascription scratch slots cannot shadow a source function" {
  let holder = Box::{ values: [6, 7], name: "kept" }
  let alias: Array[Int] = holder.values
  inspect(Array::get(alias, at = 1), content = "7")
  inspect(__ascription_argdup(3), content = "4")
}

test "ordinary Bool parameter does not classify an Int result" {
  let value = ((__asc: Bool) -> Int {
    42
  })(true)
  inspect(value, content = "42")
}

test "ordinary String parameter does not classify an Int result" {
  let value = ((__asc: String) -> Int {
    43
  })("input")
  inspect(value, content = "43")
}

test "ordinary lambda result annotations describe their own scalar kind" {
  let yes = ((__asc: Int) -> Bool {
    __asc > 0
  })(1)
  let text = ((__asc: Int) -> String {
    "result"
  })(1)
  let real = ((__asc: Bool) -> Float64 {
    1.5
  })(true)
  inspect(yes, content = "true")
  inspect(text, content = "result")
  inspect(real, content = "1.5")
  assert(real == 1.5)
}

test "a generic result named Bool is not the builtin Bool" {
  let value = ([Bool](__asc: (Int, Bool)) -> Bool {
    __asc.1
  })((0, 42))
  inspect(value, content = "42")
}

test "a generic result named String is not the builtin String" {
  let value = ([String](__asc: (Int, String)) -> String {
    __asc.1
  })((0, 43))
  inspect(value, content = "43")
}
