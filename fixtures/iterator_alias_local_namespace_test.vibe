import @vibe/builtin {
  trait Iterator as Iter
}

fn Iterator::map(xs: Array[Int], _f: (Int) -> Int) -> Array[Int] {
  [77]
}

test "an aliased standard Iterator does not authorize a local canonical helper" {
  let local = Iterator::map(xs = [1, 2], _f = (x: Int) -> Int {
    x + 1
  })
  assert_eq(local, [77])
  let standard = Iter::map(xs = [1, 2], f = (x: Int) -> Int {
    x + 1
  })
  assert_eq(standard, [2, 3])
}
