import @vibe/builtin {
  trait Iterator
}

struct Triple[T] {
  first: T;
  second: T;
  third: T
}

impl [T] Iterator[T] for Triple[T] {
  iter_length(_self) -> Int {
    3
  }
  iter_get(self, index) -> T {
    if index == 0 {
      self.first
    } else if index == 1 {
      self.second
    } else {
      self.third
    }
  }
}

test "Array gains Iterator operations from the trait import" {
  let values = [1, 2, 3]
  |> Iterator::map((x: Int) -> Int {
    x + 1
  })
  |> Iterator::filter((x: Int) -> Bool {
    x % 2 == 0
  })
  assert_eq(values, [2, 4])
  assert_eq(values |> Iterator::fold(0, (acc, x) -> {
    acc + x
  }), 6)
}

test "a user Iterator impl gains the same operation family" {
  let values = Triple::{ first: 1, second: 2, third: 3 }
  |> Iterator::map((x: Int) -> Int {
    x * 10
  })
  assert_eq(values, [10, 20, 30])
}
