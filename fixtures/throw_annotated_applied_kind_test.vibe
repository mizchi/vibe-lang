// #3022 review: an annotated payload names its WHOLE type as its exception
// kind. `xs: Array[Int]` used to record only the head `Array`, so a row
// declaring `Exception[Array[Int]]` was refused as missing `Exception[Array]`
// -- even though an annotation is the edit the unresolved-kind refusal asks for.
fn fail_param(xs: Array[Int]) -> Int with Exception[Array[Int]] {
  throw(xs)
}

fn fail_ascribed(n: Int) -> Int with Exception[Option[Int]] {
  let v: Option[Int] = Some(n)
  throw(v)
}

test "an annotated applied payload is thrown under its full kind" {
  let r = handle {
    fail_param([4, 5, 6])
  } with {
    Exception[Array[Int]]::Throw(xs) => Array::length(xs)
  }
  inspect(r, "3")
  let m = handle {
    fail_ascribed(9)
  } with {
    Exception[Option[Int]]::Throw(o) => match o {
      Some(x) => x
      None => 0
    }
  }
  inspect(m, "9")
}
