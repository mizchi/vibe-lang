// #3551: two modules each write `impl Child for Int` (`trait Child: Base`)
// and its inherited method as `fn Int::get`, with a binding in `Base`'s
// namespace between the two. The overlap check ended each impl's run at that
// binding, read both `Int::get` as plain definitions and checked neither, so
// this built and printed `from-a from-a` (`from-b from-b` with the imports
// swapped). It is refused, naming both impls.

import ./modules/impl_overlap_inherited_a.vibe {
  inherited_a_name
}

import ./modules/impl_overlap_inherited_b.vibe {
  inherited_b_name
}

test "both modules keep their own method" {
  inspect("\{inherited_a_name()} \{inherited_b_name()}", "from-a from-b")
}
