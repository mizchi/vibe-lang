// #4065: the closure stored into an array late in a loop body, after a read of the same array: the next iteration's
// read is the closure. That read hands the closure
// at its evidence arity to a row-free parameter, which is refused at build
// time.
effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

let _start = () -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = [() -> 7]
    let mut total = 0
    for i in [0, 1] {
      total = total + apply(f = Array::get(xs, at = 0))
      Array::set(xs, at = 0, value = g)
    }
    total
  } with {
    Ask::Get() => resume(5)
  }
}
_start()
