// Koka-style State effect (get/set) — tail-resumptive inline handler

// Ported from koka/test/algeff/effs2.kk

// Note: performs must be directly in handle body (no function call indirection)

effect State {
  Get -> Int;
  Set(Int) -> Unit;
}

test "effect koka state" {
  let result = handle {
    let i = perform State::Get
    perform State::Set(i + 1)
    let j = perform State::Get
    perform State::Set(j + 1)
    perform State::Get
  } with { State::Get => resume(0); State::Set(_v) => resume(0) }
  inspect(result, "0")
}
