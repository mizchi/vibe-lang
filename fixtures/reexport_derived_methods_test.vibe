// A type re-exported through a facade keeps the methods `derive` generated
// for it -- `compare` (derive Ord binds it without an impl), `to_string` and
// `equals` -- while a hand-written `Ver::helper` the facade does not list is
// not published (#3172 review).

import ./modules/reexport_derived_facade.vibe {
  Ver
}

fn label(o: Ordering) -> String {
  match o {
    Less => "less",
    Equal => "equal",
    Greater => "greater"
  }
}

test "derived methods travel with a re-exported type" {
  let a = Ver::{ major: 1, minor: 2 }
  let b = Ver::{ major: 1, minor: 9 }
  inspect(label(Ver::compare(a, b)), "less")
  inspect(Ver::equals(a, a), "true")
  inspect(Ver::equals(a, b), "false")
}
