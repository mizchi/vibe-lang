// #3007: `derive (Show)` on a GENERIC struct renders the field at its real
// type. The derived `to_string` is generated once with the formal erased, so
// every instantiation but Int / String printed a pointer
// (`Box::{ v: 1.5 }` -> `Box { v: 268 }`). An interpolation that knows the
// instantiation now renders field by field with the argument substituted.
struct Pt {
  x: Int
} derive (Show)

struct Box[T] {
  v: T
} derive (Show)

test "a generic derived struct renders its field at every instantiation" {
  inspect("\{Box::{ v: 1 }}", "Box { v: 1 }")
  inspect("\{Box::{ v: "s" }}", "Box { v: s }")
  inspect("\{Box::{ v: 1.5 }}", "Box { v: 1.5 }")
  inspect("\{Box::{ v: Some(1) }}", "Box { v: Some(1) }")
  inspect("\{Box::{ v: Pt::{ x: 3 } }}", "Box { v: Pt { x: 3 } }")
  inspect("\{Box::{ v: (1, 2) }}", "Box { v: (1, 2) }")
  inspect("\{Box::{ v: Box::{ v: 2 } }}", "Box { v: Box { v: 2 } }")
  inspect("\{Box::{ v: [1, 2] }}", "Box { v: [1, 2] }")
}

test "an annotated generic binding renders at its annotation" {
  let b: Box[Array[Int]] = Box::{ v: [1, 2] }
  inspect("\{b}", "Box { v: [1, 2] }")
}
