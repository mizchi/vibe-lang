// ADR-0068 `Send` marker: structural acceptance. `Send` is compiler-judged
// (docs/concurrency.md "`Send` と capture safety") — primitives, tuples,
// Option/Result, and immutable structs/enums built from Send components
// all satisfy a `[T: Send]` bound, including a generic struct instantiated
// with a Send argument and a recursive enum (coinductive handling).
struct Pt { x: Int; y: Int }

struct BoxT[T] { v: T }

enum MyList {
  LNil;
  LCons(Int, MyList)
}

let want_send = [T: Send](x: T) -> T { x }

let _start = () -> Int {
  let a = want_send(40)
  let _b = want_send("s")
  let _c = want_send((1, "x", true))
  let _d = want_send(Some(2))
  let e = want_send(Pt::{ x: 1, y: 1 })
  let _f = want_send(BoxT::{ v: 3 })
  let _g = want_send(LCons(1, LNil))
  let ok: Result[Int, String] = Ok(1)
  let _h = want_send(ok)
  a + e.x + e.y
}
_start()

