// ADR-0120 Phase 4: a call to a declaration labels its arguments, so the
// argument-position sugar has to survive a label. Before this, `f = x -> x + 1`
// did not parse ("expected ) but got ->"), `f = _ * 2` was refused ("`_` is not
// a value here"), and `b = _` after `|>` was not a pipe hole.

fn pair(_ a: Int, b: Int) -> Int {
  a * 10 + b
}

fn twice(f: (Int) -> Int, n: Int) -> Int {
  f(f(n))
}

test "a labeled argument takes an arrow lambda" {
  let ys = Array::map([1, 2], f = x -> x + 1)
  inspect(Array::get(ys, at = 1), content = "3")
  inspect(twice(f = n -> n * 3, n = 1), content = "9")
}

test "a labeled argument takes an operator section" {
  let ys = Array::map([1, 2], f = _ * 2)
  inspect(Array::get(ys, at = 1), content = "4")
  inspect(Array::fold([1, 2, 3], init = 0, f = _ + _), content = "6")
}

test "a labeled pipe hole takes the piped value under its label" {
  inspect(3 |> pair(1, b = _), content = "13")
  inspect([1, 2, 3] |> Array::fold(_, init = 0, f = _ + _), content = "6")
}
