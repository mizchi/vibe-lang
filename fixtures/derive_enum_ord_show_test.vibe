// Structural derive (#638) on an ENUM: `derive(Ord)` generates `E::compare`
// (lexicographic: variant order first, then payload, returning the prelude
// `Ordering`, #3042) and
// `derive(Show)` generates `E::to_string` (`Name` for a nullary variant,
// `Name(p0, p1)` for a payload variant, shown structurally). Multiple derives
// listed together work; `Eq` stays a structural marker.

//# Types

enum Shape {
  Circle(Int);
  Rect(Int, Int);
  Dot
} derive(Eq, Ord, Show)

//# Tests

test "derive(Ord) on enum: variant order dominates payload" {
  // Circle(_) < Rect(_, _) < Dot by declaration order.
  inspect(Shape::compare(Circle(99), Rect(0, 0)), "Less")
  inspect(Shape::compare(Rect(0, 0), Circle(99)), "Greater")
  inspect(Shape::compare(Dot, Circle(0)), "Greater")
  inspect(Shape::compare(Circle(0), Dot), "Less")
}

test "derive(Ord) on enum: same variant compares payload lexicographically" {
  inspect(Shape::compare(Circle(1), Circle(2)), "Less")
  inspect(Shape::compare(Circle(5), Circle(5)), "Equal")
  inspect(Shape::compare(Rect(1, 9), Rect(1, 2)), "Greater")
  inspect(Shape::compare(Rect(1, 2), Rect(1, 2)), "Equal")
  inspect(Shape::compare(Dot, Dot), "Equal")
}

test "derive(Show) on enum: structural to_string" {
  assert(Shape::to_string(Circle(7)) == "Circle(7)")
  assert(Shape::to_string(Rect(3, 4)) == "Rect(3, 4)")
  assert(Shape::to_string(Dot) == "Dot")
}

test "derive(Eq) on enum still works structurally" {
  assert(Circle(1) == Circle(1))
  assert(Rect(1, 2) == Rect(1, 2))
  assert(not(Circle(1) == Circle(2)))
  assert(not(Circle(1) == Dot))
}
