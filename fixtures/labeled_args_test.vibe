//# Functions

fn add(x: Int, y: Int) -> Int { x + y }

fn make_rect(width: Int, height: Int) -> Int {
  width * height
}

fn greet(name: String, greeting: String) -> String {
  String::concat(String::concat(greeting, " "), name)
}

//# Misc

test "labeled args basic" {
  assert(add(x=10, y=20) == 30)
}

test "labeled args any order" {
  assert(add(x=10, y=20) == 30)
}

test "labeled args with named rect" {
  let area = make_rect(width=5, height=3)
  assert(area == 15)
}

test "labeled args reversed order" {
  let area = make_rect(width=6, height=4)
  assert(area == 24)
}

test "labeled args with String" {
  let msg = greet(name="world", greeting="hello")
  assert(msg == "hello world")
}

test "labeled args reversed String" {
  let msg = greet(name="there", greeting="hi")
  assert(msg == "hi there")
}
