trait Add {
  add(Self, Self) -> Self
}
impl Add for Float32 {
  add(a: Float32, b: Float32) -> Float32 {
    a + b + 1.0f
  }
}
fn sum[T: Add](a: T, b: T) -> T {
  a + b
}
test "an explicit Add implementation overrides the scalar default" {
  inspect(sum(a = 1.0f, b = 2.0f), content = "4")
}

struct Digits { value: Int }
impl Add for Digits {
  add(a: Digits, b: Digits) -> Digits {
    Digits::{ value: a.value * 100 + b.value }
  }
}
fn combine[T: Add](a: T, b: T) -> T {
  a + b
}
fn twice[T: Add](a: T, b: T) -> T {
  let mut out = a
  out += b
  out += b
  out
}
test "custom Add returns a boxed Self and preserves argument order" {
  let r: Digits = combine(a = Digits::{ value: 12 }, b = Digits::{ value: 7 })
  inspect(r.value, content = "1207")
  let s: Digits = twice(a = Digits::{ value: 12 }, b = Digits::{ value: 7 })
  inspect(s.value, content = "120707")
}
