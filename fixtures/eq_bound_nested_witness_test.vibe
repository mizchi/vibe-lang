//# #3287: `==` inside a generic body on a value whose type mentions an
//# `Eq`-bounded formal. A generic body is lowered once, so the formal's
//# positions compare through the witness dictionary the caller passes.
//#
//# Before the fix two things went wrong together. A formal that appeared only
//# nested in the parameters (`a: Option[T]`) was threaded no witness at all, so
//# even a bare `x == y` on two `T` values reached through a match compared by
//# identity. And an aggregate around a formal (`Option[T]`, `(T, Int)`,
//# `Array[T]`, a generic enum) compared its formal leaves with a raw `==`,
//# where only a bare `T` operand used the witness. A boxed `Double` and any
//# aggregate answered `false` for two equal values.

enum Res[T, E] {
  Ok(T);
  Err(E)
}

struct Pt {
  x: Int;
  ys: Array[Int]
} derive (Eq)

struct Box[T] {
  v: T
} derive (Eq)

fn same_opt[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  a == b
}

fn differ_opt[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  a != b
}

fn same_res[T: Eq](a: Res[Array[Int], T], b: Res[Array[Int], T]) -> Bool {
  a == b
}

fn same_tuple[T: Eq](a: (T, Int), b: (T, Int)) -> Bool {
  a == b
}

fn same_bare[T: Eq](a: T, b: T) -> Bool {
  a == b
}

fn same_arr[T: Eq](a: Array[T], b: Array[T]) -> Bool {
  a == b
}

fn same_box[T: Eq](a: Box[T], b: Box[T]) -> Bool {
  a == b
}

fn payloads_equal[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => x == y,
    (None, None) => true,
    _ => false
  }
}

fn payloads_equal_qualified[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => T::equals(x, y),
    (None, None) => true,
    _ => false
  }
}

fn forward[U: Eq](a: Option[U], b: Option[U]) -> Bool {
  same_opt(a = a, b = b)
}

fn rebuilt[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  match (a, b) {
    (Some(x), Some(y)) => Some(x) == Some(y),
    _ => false
  }
}

struct Holder {
  o: Option[Float64]
}

// A formal reached only through a function's result (Codex on #3302): the
// call reads `T` off the function argument's type, and a call through the
// parameter has the type its annotation declares.
fn via_fn[T: Eq](_ make: () -> T) -> Bool {
  make() == make()
}

fn via_fn_opt[T: Eq](_ make: () -> Option[T]) -> Bool {
  make() == make()
}

fn with_carrier[T: Eq](x: T, make: () -> T) -> Bool {
  make() == make()
}

// The `Option` argument is `None` here, but the function argument still
// produces values of `T`, so `T` must be read from it, not filled in.
fn mixed[T: Eq](a: Option[T], make: () -> T) -> Bool {
  Some(make()) == Some(make())
}

fn forward_fn[U: Eq](_ mk: () -> U) -> Bool {
  via_fn(mk)
}

fn d() -> Float64 {
  1.5
}

fn make_pt() -> Pt {
  Pt::{ x: 1, ys: [2] }
}

fn make_box() -> Box[Float64] {
  Box::{ v: 1.5 }
}

fn annotated_let[T: Eq](a: Option[T], b: Option[T]) -> Bool {
  let c: Option[T] = a
  c == b
}

test "Option[T] at Double and at a derive(Eq) struct" {
  inspect(same_opt(a = Some(1.5), b = Some(1.5)), "true")
  inspect(same_opt(a = Some(1.5), b = Some(2.5)), "false")
  inspect(same_opt(a = Some(Pt::{ x: 1, ys: [2] }), b = Some(Pt::{ x: 1, ys: [2] })), "true")
  inspect(same_opt(a = Some(Pt::{ x: 1, ys: [2] }), b = Some(Pt::{ x: 1, ys: [3] })), "false")
  inspect(same_opt(a = Some(7), b = Some(7)), "true")
  inspect(same_opt(a = Some(7), b = None), "false")
  inspect(differ_opt(a = Some(1.5), b = Some(1.5)), "false")
  inspect(differ_opt(a = Some(1.5), b = Some(2.5)), "true")
}

test "a generic enum whose other argument is concrete" {
  inspect(same_res(a = Err(1.5), b = Err(1.5)), "true")
  inspect(same_res(a = Err(1.5), b = Err(2.5)), "false")
  inspect(same_res(a = Ok([1, 2]), b = Ok([1, 2])), "true")
  inspect(same_res(a = Ok([1, 2]), b = Ok([1, 3])), "false")
  inspect(same_res(a = Ok([1, 2]), b = Err(1.5)), "false")
}

test "a tuple, an array and a generic struct around the formal" {
  inspect(same_tuple(a = (1.5, 1), b = (1.5, 1)), "true")
  inspect(same_tuple(a = (1.5, 1), b = (1.5, 2)), "false")
  inspect(same_arr(a = [1.5, 2.5], b = [1.5, 2.5]), "true")
  inspect(same_arr(a = [1.5, 2.5], b = [1.5, 3.5]), "false")
  inspect(same_arr(a = [Pt::{ x: 1, ys: [2] }], b = [Pt::{ x: 1, ys: [2] }]), "true")
  inspect(same_box(a = Box::{ v: 1.5 }, b = Box::{ v: 1.5 }), "true")
  inspect(same_box(a = Box::{ v: 1.5 }, b = Box::{ v: 2.5 }), "false")
  inspect(same_bare(a = 1.5, b = 1.5), "true")
}

test "a bare formal reached through a match uses the witness" {
  inspect(payloads_equal(a = Some(1.5), b = Some(1.5)), "true")
  inspect(payloads_equal(a = Some(Pt::{ x: 1, ys: [2] }), b = Some(Pt::{ x: 1, ys: [2] })), "true")
  inspect(payloads_equal(a = Some(1.5), b = Some(2.5)), "false")
  inspect(payloads_equal_qualified(a = Some(1.5), b = Some(1.5)), "true")
  inspect(payloads_equal_qualified(a = Some(1.5), b = Some(2.5)), "false")
}

test "forwarded, rebuilt and annotated operands" {
  inspect(forward(a = Some(1.5), b = Some(1.5)), "true")
  inspect(forward(a = Some(1.5), b = Some(2.5)), "false")
  inspect(rebuilt(a = Some(1.5), b = Some(1.5)), "true")
  inspect(rebuilt(a = Some(1.5), b = Some(2.5)), "false")
  inspect(annotated_let(a = Some(1.5), b = Some(1.5)), "true")
  inspect(annotated_let(a = Some(1.5), b = Some(2.5)), "false")
}

test "arguments read from a field and from an array element" {
  let h = Holder::{ o: Some(1.5) }
  let k = Holder::{ o: Some(1.5) }
  inspect(same_opt(a = h.o, b = k.o), "true")
  let xs: Array[Option[Float64]] = [Some(1.5), Some(1.5), Some(2.5)]
  inspect(same_opt(a = Array::get(xs, at = 0), b = Array::get(xs, at = 1)), "true")
  inspect(same_opt(a = Array::get(xs, at = 0), b = Array::get(xs, at = 2)), "false")
}

// Each argument is a constructor literal whose variant holds no value of the
// formal, so nothing of type `T` reaches the callee and any `Eq` witness is
// sound for it.
test "calls that carry no value of the formal" {
  inspect(same_opt(a = None, b = None), "true")
  inspect(same_res(a = Ok([1, 2]), b = Ok([1, 2])), "true")
}

test "a formal reached only through a function result" {
  inspect(via_fn(d), "true")
  inspect(via_fn(() -> Float64 { 2.5 }), "true")
  inspect(via_fn_opt(() -> Option[Float64] { Some(1.5) }), "true")
  inspect(with_carrier(x = 7.5, make = d), "true")
  inspect(forward_fn(d), "true")
  inspect(via_fn(make_pt), "true")
  inspect(via_fn(make_box), "true")
}

test "a function argument is read when the data argument holds no value" {
  inspect(mixed(a = None, make = d), "true")
}

test "a local generic lambda over Option[T]" {
  let same = [T: Eq](a: Option[T], b: Option[T]) -> Bool {
    a == b
  }
  inspect(same(Some(1.5), Some(1.5)), "true")
  inspect(same(Some(1.5), Some(2.5)), "false")
  inspect(same(Some(Pt::{ x: 1, ys: [2] }), Some(Pt::{ x: 1, ys: [2] })), "true")
}
