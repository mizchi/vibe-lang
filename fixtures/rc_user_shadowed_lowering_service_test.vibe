// A source definition with the service's spelling uses the ordinary call ABI.
fn compiler_lowering_run(value: Int) -> Int {
  value * 3 - 7
}

fn main() -> Int {
  let global_answer = compiler_lowering_run(5)
  let local_answer = local_call()
  let parameter_answer = parameter_call((value: Int) -> Int {
    value * 3 - 7
  })
  if global_answer == 8 && local_answer == 8 && parameter_answer == 8 {
    8
  } else {
    0
  }
}

fn local_call() -> Int {
  let compiler_lowering_run = (value: Int) -> Int {
    value * 3 - 7
  }
  compiler_lowering_run(5)
}

fn parameter_call(compiler_lowering_run: (Int) -> Int) -> Int {
  compiler_lowering_run(5)
}
