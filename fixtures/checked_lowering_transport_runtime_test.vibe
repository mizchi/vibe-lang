import @vibe/checker/transport {
  decode_checked_lowering, encode_checked_lowering
}
import @vibe/compiler/runtime {
  module_typed_lowering_text, parse_module_typed_lowering_offsets_text
}

test "runtime keeps checked lowering bytes and decoded rows" {
  let encoded = encode_checked_lowering([3, 10], [4], ["Array[String]"])
  let legacy = module_typed_lowering_text([3, 10], [4], ["Array[String]"])
  assert(legacy == encoded)
  match (parse_module_typed_lowering_offsets_text(legacy), decode_checked_lowering(encoded)) {
    (Some((a, b, c)), Some((x, y, z))) => {
      assert(a == x)
      assert(b == y)
      assert(c == z)
    },
    _ => assert(false)
  }
}

test "runtime preserves malformed lowering refusal" {
  let encoded = encode_checked_lowering([3, 10], [4], ["Array[String]"])
  let changed = String::concat(encoded, "unexpected\n")
  assert(changed != encoded)
  match (parse_module_typed_lowering_offsets_text(changed), decode_checked_lowering(changed)) {
    (None, None) => (),
    _ => assert(false)
  }
}
