// #3156 review: an annotated alias of `TaskGroup::spawn` is accepted as an
// alias (region_ok_spawnable_annotated_alias.vibe), and a call through it is
// still Send-checked: this closure captures a plain `Array`, which the
// literal spelling refuses (err_spawnable_capture_array.vibe).
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn go[rg, e](n: TaskGroup[rg, e], seen: Array[Int]) -> Int with Exception {
  let sp: (TaskGroup[rg, e], () -> Int) -> TaskHandle[rg, e, Int] = TaskGroup::spawn
  let h = sp(n, () -> {
    Array::set(seen, 0, 1)
    0
  })
  TaskHandle::join(h)
}

fn main() -> Unit allows Exception {
  let seen = [0]
  let _r = TaskGroup::run((n) -> go(n, seen))
  ()
}
