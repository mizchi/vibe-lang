// ? operator: propagate Error effect
let safe_div = (a: Int, b: Int) -> Int with Exception {
  if b == 0 { throw("division by zero") }
  a / b
}

let compute = (x: Int) -> Int with Exception {
  let a = safe_div(x, 2)?
  a + 1
}

let result = handle { compute(10) } with Exception { Throw(_) => -1 }
result

