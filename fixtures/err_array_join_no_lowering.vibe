// #2900: `Array::join` was declared by the checker and implemented nowhere --
// not in the registry, not in either backend's call ladder, not exported by
// `@vibe/builtin`. A call type-checked clean and then died in codegen with
// `reached code generation unresolved`, a message that blames the compiler and
// asks the reader to report a bug in their own correct-looking program. It is
// refused here instead, and the message names what to write.
fn main() -> Unit allows Console {
  let xs = ["a", "b"]
  println(Array::join(xs, ","))
}
