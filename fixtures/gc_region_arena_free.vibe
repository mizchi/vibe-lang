// ADR-0090 (#1262): `region r { .. }` on the wasm-gc lane.
//
// The linear lane has two tiers -- source-level rewrites, and on top of them
// an arena (watermark save/restore + segment allocator) for bulk release.
// CORRECTNESS lives entirely in the first tier; the arena is the reclamation
// optimization. This fixture pins the first tier on both lanes, so the gc
// lane runs regions correctly while the arena stays a separate question.
//
// The checks are the ones the rewrites can get wrong:
//
//   - `MutList::to_array` / `freeze` must COPY, not alias. An alias would
//     observe later pushes, and with an arena the region release would leave
//     the escaping array dangling. `copy_is_a_copy` pushes AFTER copying out
//     and asserts the copy did not grow -- an identity cast passes every
//     other check here.
//   - a region INSIDE A LAMBDA, and a NESTED region (whose inner body is
//     itself a lambda). `__region_run` is a reserved dunder the parser emits,
//     and the gc capture scan collected it as a free variable until it was
//     listed with the other parser-emitted dunders -- so both of these died
//     one lambda deep while a top-level region worked.
//   - a lambda that captures a real local AND runs a region, so excluding
//     `__region_run` from the capture set cannot be excluding too much.

fn copy_is_a_copy() -> Int {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, 1)
    let copied = MutList::to_array(l)
    MutList::push(l, 2)
    // 1 * 10 + 2: the copy stayed at one element while the list grew.
    Array::length(copied) * 10 + MutList::length(l)
  }
}

fn freeze_reads_back() -> Int {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, 9)
    Array::get(MutList::freeze(l), 0)
  }
}

fn get_and_length() -> Int {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, 5)
    MutList::push(l, 6)
    MutList::length(l) * 10 + MutList::get(l, 1)
  }
}

fn nested_regions() -> Int {
  region outer {
    let l = MutList::empty(outer)
    MutList::push(l, 1)
    let inner = region r {
      let m = MutList::empty(r)
      MutList::push(m, 2)
      MutList::push(m, 3)
      MutList::length(m)
    }
    MutList::length(l) * 10 + inner
  }
}

fn region_in_a_lambda() -> Int {
  let bonus = 5
  let f = () -> Int {
    region r {
      let l = MutList::empty(r)
      MutList::push(l, 1)
      MutList::length(l) + bonus
    }
  }
  f()
}

// A region whose result is a SCALAR: nothing escapes, so a lowering that
// dropped the body's value entirely would still typecheck.
fn scalar_result() -> Int {
  region r {
    let l = MutList::empty(r)
    MutList::push(l, 7)
    42
  }
}

export let main = () -> Int {
  copy_is_a_copy() * 100000000 + freeze_reads_back() * 10000000 + get_and_length() * 100000 + nested_regions() * 1000 + region_in_a_lambda() * 100 + scalar_result()
}

// The expectation lives HERE, not in compiler_gate.sh: `vibe test --update`
// maintains it, and running this fixture on its own says whether it holds.
// The gate's own job is the part a snapshot cannot express -- that the two
// backends agree -- so it runs this same block on both lanes rather than
// re-stating the number.
//
// 12 (copy stayed at 1 while the list grew to 2) / 9 / 26 / 12 / 6 / 42.
test "regions run the same on both backends" {
  inspect(copy_is_a_copy(), "12")
  inspect(freeze_reads_back(), "9")
  inspect(get_and_length(), "26")
  inspect(nested_regions(), "12")
  inspect(region_in_a_lambda(), "6")
  inspect(scalar_result(), "42")
  inspect(main(), "1292612642")
}
