// Structural `==`/`!=` for aggregate operands (#672): tuples, structs, payload
// constructors, and nullary enums — element-wise (recursively for nested), for
// literal operands AND for both-non-literal variables. Returns 1 iff every case
// is correct.
enum Color {
  Red;
  Green;
  Blue
}

struct P {
  x: Int;
  y: Int
}

let all_true = () -> Int {
  let mut ok = 1
  // nullary enum
  if Red == Red { () } else { ok = 0 }
  if Red == Green { ok = 0 } else { () }
  // tuple literals (+ mixed type, + !=)
  if (1, 2) == (1, 2) { () } else { ok = 0 }
  if (1, 2) == (1, 3) { ok = 0 } else { () }
  if (1, "b") == (1, "b") { () } else { ok = 0 }
  if (1, 2) != (1, 9) { () } else { ok = 0 }
  // struct / payload-ctor literals
  if P::{ x: 1, y: 2 } == P::{ x: 1, y: 2 } { () } else { ok = 0 }
  if P::{ x: 1, y: 2 } == P::{ x: 9, y: 2 } { ok = 0 } else { () }
  if Some(1) == Some(1) { () } else { ok = 0 }
  if Some(1) == Some(2) { ok = 0 } else { () }
  if Some(1) == None { ok = 0 } else { () }
  // nested literals (recursive)
  if ((1, 2), 3) == ((1, 2), 3) { () } else { ok = 0 }
  if ((1, 2), 3) == ((1, 9), 3) { ok = 0 } else { () }
  if Some((1, 2)) == Some((1, 2)) { () } else { ok = 0 }
  // both-non-literal variables: tuple, struct, payload-ctor, nested
  let t1 = (1, 2)
  let t2 = (1, 2)
  if t1 == t2 { () } else { ok = 0 }
  let p1 = P::{ x: 3, y: 4 }
  let p2 = P::{ x: 3, y: 4 }
  if p1 == p2 { () } else { ok = 0 }
  let s1 = Some(7)
  let s2 = Some(7)
  if s1 == s2 { () } else { ok = 0 }
  let n1 = ((1, 2), 3)
  let n2 = ((1, 2), 3)
  if n1 == n2 { () } else { ok = 0 }
  let n3 = ((1, 2), 9)
  if n1 == n3 { ok = 0 } else { () }
  ok
}

all_true()

__DATA__
{"last": "1"}
