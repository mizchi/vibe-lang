// Structural `==`/`!=` for aggregate operands (#672). These cases — where at
// least one operand is a literal, plus nullary enums — lower to an element-wise
// structural comparison (not a pointer compare). The remaining gap is `a == b`
// where BOTH operands are non-literal aggregates (needs operand types in
// codegen); see #672.
enum Color {
  Red;
  Green;
  Blue
}

struct P {
  x: Int;
  y: Int
}

let all_true = () -> Int {
  let mut ok = 1
  // nullary enum
  if Red == Red { () } else { ok = 0 }
  if Red == Green { ok = 0 } else { () }
  // tuple literal == tuple literal
  if (1, 2) == (1, 2) { () } else { ok = 0 }
  if (1, 2) == (1, 3) { ok = 0 } else { () }
  // mixed-type tuple
  if (1, "b") == (1, "b") { () } else { ok = 0 }
  // var == literal (one literal operand drives the structural compare)
  let t = (1, 2)
  if t == (1, 2) { () } else { ok = 0 }
  if (1, 2) == t { () } else { ok = 0 }
  // struct literal == struct literal
  if P::{ x: 1, y: 2 } == P::{ x: 1, y: 2 } { () } else { ok = 0 }
  if P::{ x: 1, y: 2 } == P::{ x: 9, y: 2 } { ok = 0 } else { () }
  // != duals
  if (1, 2) != (1, 2) { ok = 0 } else { () }
  if (1, 2) != (1, 9) { () } else { ok = 0 }
  ok
}

all_true()

__DATA__
{"last": "1"}
