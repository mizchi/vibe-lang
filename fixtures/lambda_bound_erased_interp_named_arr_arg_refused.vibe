//# #2745: an ARRAY argument reached through a name.
//
// Found by probing the neighbour of round 23's named-tuple report, in the same
// commit. Measured on `c799c16`: `fn head_of[U](xs: Array[U]) -> U` called as
// `let xs = [a]; head_of(xs)` printed a 3-digit pointer decimal.
//
// The tuple and the array are one question with two key families, so the slot
// read that fixed the tuple reads `__arrelem$` too. That family needs the guard
// the leaf applies: `array_elem_key` stores a real TYPE NAME (`Int` for an
// `Array[Int]`), not only an erased formal, and returning it unguarded is what
// made the compiler reject its own sources in round 17. `named_arr_arg_concrete`
// in the green control is the concrete twin that catches it going the other way.

struct Qt {
  w: Int
}

fn head_of[U](xs: Array[U]) -> U {
  Array::get(xs, 0)
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let xs = [a]
    head_of(xs) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
