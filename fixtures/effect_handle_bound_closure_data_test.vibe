// #4065: a handle-bound closure (one that performs an effect the enclosing
// `handle` answers) taken out of a container or a binder and handed to an
// ordinary function, inside that handle. Each shape used to trap with
// `indirect call type mismatch` in `apply`; the closure is now stored as data
// in its row-free form, closing over the handler in scope. Each shape is its
// own function, so no other shape's direct argument puts its statement on the
// rewrite's path.

effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn direct() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    apply(f = g)
  } with {
    Ask::Get() => resume(5)
  }
}

fn via_for() -> Int {
  let mut total = 0
  handle {
    let g = () -> perform Ask::Get() + 1
    for x in [g] {
      total = total + apply(f = x)
    }
    ()
  } with {
    Ask::Get() => resume(5)
  }
  total
}

fn via_some() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    match Some(g) {
      Some(x) => apply(f = x),
      None => 0
    }
  } with {
    Ask::Get() => resume(5)
  }
}

fn via_get_literal() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    apply(f = Array::get([g], at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}

fn via_array_binding() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs = [g]
    let x = Array::get(xs, at = 0)
    apply(f = x)
  } with {
    Ask::Get() => resume(5)
  }
}

fn via_tuple() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let pair = (g, 1)
    apply(f = pair.0) + pair.1
  } with {
    Ask::Get() => resume(5)
  }
}

fn via_push() -> Int {
  handle {
    let g = () -> perform Ask::Get() + 1
    let xs: Array[() -> Int] = []
    Array::push(xs, value = g)
    apply(f = Array::get(xs, at = 0))
  } with {
    Ask::Get() => resume(5)
  }
}

test "a handle-bound closure passed directly" {
  inspect(direct(), "106")
}

test "a handle-bound closure read from an array literal by for" {
  inspect(via_for(), "106")
}

test "a handle-bound closure read out of Some by match" {
  inspect(via_some(), "106")
}

test "a handle-bound closure read with Array::get from a literal" {
  inspect(via_get_literal(), "106")
}

test "a handle-bound closure read from an array binding" {
  inspect(via_array_binding(), "106")
}

test "a handle-bound closure read from a tuple" {
  inspect(via_tuple(), "107")
}

test "a handle-bound closure stored with Array::push" {
  inspect(via_push(), "106")
}
