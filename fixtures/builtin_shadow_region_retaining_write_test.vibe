// #3255: a program's own function of a retaining builtin's spelling is judged
// by its body inside a region, not as the builtin. This `Array::push` keeps
// nothing, so handing it a region value is fine; before, the checker refused
// both calls below as a container write that lets the region escape.

fn Array::push(_ xs: Array[MutList[Int]], value: MutList[Int]) -> Int {
  let _ = xs
  MutList::length(value) * 10
}

fn by_name() -> Int {
  let sink: Array[MutList[Int]] = []
  region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 3)
    MutList::push(cell, 4)
    Array::push(sink, value = cell) + Array::length(sink)
  }
}

fn by_dot() -> Int {
  let sink: Array[MutList[Int]] = []
  region r {
    let cell = MutList::empty(r)
    MutList::push(cell, 5)
    sink.push(value = cell) + Array::length(sink)
  }
}

test "a program's own Array::push answers inside a region" {
  inspect(by_name(), content = "20")
  inspect(by_dot(), content = "10")
}
