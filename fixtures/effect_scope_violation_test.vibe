// Scope violation: with A does NOT grant access to B

effect A {
  OpA -> Int
}

effect B {
  OpB -> Int
}

// This function declares with A but tries to use B → should work

// because handle provides B

test "effect scope violation" {
  let a = handle {
    perform A::OpA
  } with { A::OpA => resume(10) }
  let b = handle {
    perform B::OpB
  } with { B::OpB => resume(20) }
  let result = a + b
  inspect(result, "30")
}
