// `_test.vibe`-suffixed -- must be EXCLUDED from implicit membership.
// Exports a name not declared in index.vpkg; if wrongly swept in, this
// causes a conformance violation. (Not discovered by unit_test_runner.sh's
// own `find examples lib -name '*_test.vibe'` scan since it lives under
// fixtures/, not examples/ or lib/.)
export fn test_only_helper(x: Int) -> Int { x }
