//# Codex round 10 on #2456, the other side: the formal forwarded to an
//# OBSERVED parameter of a generic struct -- `struct Box[X] { v: X }`,
//# `enum Wrap[T] { W(Box[T]); Empty }`. The struct's comparator reads `v`,
//# whose type is the enum's erased formal, so once both sides are non-empty
//# the comparison must TRAP rather than compare two arrays by reference.

struct Box[X] {
  v: X
} derive (Eq)

enum Wrap[T] {
  W(Box[T]);
  Empty
}

fn fill(xs: Array[Wrap[Array[Int]]], v: Int) -> Unit {
  Array::push(xs, W(Box::{ v: [v, v + 1] }))
}

export fn _start() -> Int {
  let left = []
  fill(left, 1)
  let right = []
  fill(right, 1)
  if left == right {
    1
  } else {
    0
  }
}
