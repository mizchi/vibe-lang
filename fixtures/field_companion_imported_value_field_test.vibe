//# #3915: a field holding a value may share its name with a companion when
//# the struct is imported, as when it is declared in the same file (#3896):
//# the field is read as `g.size` and the companion is called as `G::size(g)`.

import ./_field_companion_imported_dep.vibe {
  G
}

fn G::size(_ g: G) -> Int {
  g.size * 10
}

test "an imported value field and a companion of one name" {
  let g = G::{ get: () -> "field", size: 3 }
  inspect(g.size, content = "3")
  inspect(G::size(g), content = "30")
}
