//# #2745: a tuple return carrying TWO DIFFERENT formals.
//
// Codex, P1 round 23 on #2761. Measured on `c799c16`:
// `let pair2 = [U, V](u: U, v: V) -> (U, V) { (u, v) }` then
// `{ let p = pair2(0, a); p.1 }` printed a 3-digit pointer decimal.
//
// Round 21 recorded ONE argument index for the whole tuple and kept only the
// positions that agreed with it, so `V` -- a second formal at a second
// parameter -- was silently dropped and position 1 came back unknown. One index
// per tuple was never the fact; it was the fact the case that prompted the arm
// happened to have, which is the same mistake as round 16's "elements share a
// type" and round 13's "assignments agree on erasure": a justification correct
// about a different property than the one it is used for.
//
// Each position now carries its own SOURCE, and a source is either an argument
// index or a declared type name -- one spelling, so a function-valued
// parameter's tuple return goes in the same slots.
//
// `tuple_ret_other_slot` and `tuple_ret2_second_formal` in the green control
// read a NON-formal and a concrete second position, which is what fails if this
// over-refuses.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    let pair2 = [U, V](u: U, v: V) -> (U, V) {
      (u, v)
    }
    "\{ { let p = pair2(0, a)
    p.1 } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
