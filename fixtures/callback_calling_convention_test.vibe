effect Ask {
  Get() -> Int
}

fn apply(f: () -> Int) -> Int {
  f() + 100
}

fn apply_row(f: () -> Int with Ask) -> Int with Ask {
  f() + 1000
}

export fn by_name() -> Int {
  let mut total = 0
  let k = 3
  handle {
    let g = () -> perform Ask::Get() + k
    total = apply(f = g)
    ()
  } with { Ask::Get() => resume(5) }
  total
}

export fn literal() -> Int {
  let mut total = 0
  let k = 3
  handle {
    total = apply(f = () -> perform Ask::Get() + k)
    ()
  } with { Ask::Get() => resume(5) }
  total
}

export fn pure_data() -> Int {
  let mut total = 0
  handle {
    let xs = [() -> 7]
    let x = Array::get(xs, at = 0)
    total = apply_row(f = x)
    ()
  } with { Ask::Get() => resume(5) }
  total
}

fn ask_at_call() -> Int with Ask {
  perform Ask::Get()
}

fn declared_row_from_data() -> Int {
  handle {
    let callbacks = [ask_at_call]
    let callback = Array::get(callbacks, at = 0)
    handle {
      apply_row(f = callback)
    } with { Ask::Get() => resume(7) }
  } with { Ask::Get() => resume(5) }
}

test "#4138: a capturing callback passed by name keeps its handler" {
  inspect(by_name(), content = "108")
}

test "#4138: a capturing literal callback keeps its handler" {
  inspect(literal(), content = "108")
}

test "#4132: a row-free function read out of an array can fill a row slot" {
  inspect(pure_data(), content = "1007")
}

test "#4132: a declared row function read out of an array uses the handler at the call" {
  inspect(declared_row_from_data(), content = "1007")
}

test "#4132: adapting a callback read evaluates the argument once" {
  let callbacks = [() -> 7]
  let mut reads = 0
  let pick = () -> {
    reads += 1
    Array::get(callbacks, at = 0)
  }
  let total = handle {
    apply_row(f = pick())
  } with { Ask::Get() => resume(5) }
  inspect(total, content = "1007")
  inspect(reads, content = "1")
}

test "#4132: a bound row-free callback can be forwarded by name" {
  let f = () -> 7
  let total = handle {
    apply_row(f = f)
  } with { Ask::Get() => resume(5) }
  inspect(total, content = "1007")
}

test "tuple projection" {
  let total = handle {
    let pair = (() -> 7, 0)
    apply_row(f = pair.0)
  } with { Ask::Get() => resume(5) }
  inspect(total, content = "1007")
}

test "match binder" {
  let total = handle {
    match Some(() -> 7) {
      Some(f) => apply_row(f = f),
      None => 0
    }
  } with { Ask::Get() => resume(5) }
  inspect(total, content = "1007")
}

test "explicit row carried into a nested handler" {
  let total = handle {
    let callback = () -> Int with Ask {
      perform Ask::Get()
    }
    let callbacks = [callback]
    let selected = Array::get(callbacks, at = 0)
    handle {
      apply_row(f = selected)
    } with { Ask::Get() => resume(7) }
  } with { Ask::Get() => resume(5) }
  inspect(total, content = "1007")
}

fn apply_through(_ run: (() -> Int with Ask) -> Int with Ask, _ f: () -> Int) -> Int with Ask {
  run(f)
}

fn consume(_ f: () -> Int with Ask) -> Int with Ask {
  f()
}

test "adapting a conditional evaluates its condition once" {
  let first = () -> 7
  let second = () -> 8
  let mut visits = 0
  let value = handle {
    let _ = consume(ask_at_call)
    consume(if {
      visits += 1; visits == 1
    } {
      first
    } else {
      second
    })
  } with { Ask::Get() => resume(5) }
  inspect(value, content = "7")
  inspect(visits, content = "1")
}

test "a function parameter can receive a row-free callback" {
  let f = () -> 8
  let value = handle {
    let _ = consume(ask_at_call)
    apply_through(consume, f)
  } with { Ask::Get() => resume(5) }
  inspect(value, content = "8")
}
