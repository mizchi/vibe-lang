// #3444: a top-level `fn` or `let` in the ENTRY module that shares a name with
// a function of a dependency it imports. The checker typed `g(1)` against the
// local `fn g(n: Int) -> Int`, but the program ran the imported `g`: the
// answer was its String read as an Int (`1082331758593`). The local runs now.
// Since #3549 importing a name AND declaring it is refused
// (fixtures/typecheck/import_decl_clash_*_reject.vibe), so the dependency's
// `g` and `h` come in under aliases here, beside the local `g` and `h`.
import ./plaindep.vibe { g as dep_g, h as dep_h, uses_own_g }

fn g(n: Int) -> Int {
  n + 100
}

let h = (n: Int) -> n * 2

test "a local fn shadowing an import runs the local" {
  inspect(g(1), content = "101")
}

test "a local let shadowing an import runs the local" {
  inspect(h(21), content = "42")
}

test "the imported module still calls its own g" {
  inspect(uses_own_g("a"), content = "a!")
}

test "the aliased imports still reach the dependency" {
  inspect(dep_g("b"), content = "b!")
  inspect(dep_h("c"), content = "c?")
}
