// #3444: a top-level `fn` or `let` in the ENTRY module that shares a name with
// an import. The checker typed `g(1)` against the local `fn g(n: Int) -> Int`,
// but the program ran the imported `g`: the answer was its String read as an
// Int (`1082331758593`). The local wins at run time now, as it already did
// in a dependency module.
import ./plaindep.vibe { g, h, uses_own_g }

fn g(n: Int) -> Int {
  n + 100
}

let h = (n: Int) -> n * 2

test "a local fn shadowing an import runs the local" {
  inspect(g(1), content = "101")
}

test "a local let shadowing an import runs the local" {
  inspect(h(21), content = "42")
}

test "the imported module still calls its own g" {
  inspect(uses_own_g("a"), content = "a!")
}
