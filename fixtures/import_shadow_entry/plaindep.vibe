// #3444: imported by import_shadow_entry_test.vibe, which declares its own
// `g` and `h` beside these (imported there under aliases).
export fn g(_ name: String) -> String {
  "\{name}!"
}

export fn h(_ name: String) -> String {
  "\{name}?"
}

export fn uses_own_g(_ name: String) -> String {
  g(name)
}
