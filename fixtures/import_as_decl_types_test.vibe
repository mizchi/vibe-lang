//# #3954: an importer's own declarations name an `as`-renamed import, a struct
//# or a type alias, in a struct field, an enum payload, a trait method
//# signature and an effect operation.

// One `as` item per import statement: two in one list lose the second
// (#3972).
import ./modules/import_as_decl_provider.vibe {
  S as T, mk
}

import ./modules/import_as_decl_provider.vibe {
  Alias as CA
}

struct Holder {
  value: CA
}

struct Pair {
  left: T;
  right: CA
}

enum Slot {
  Full(T);
  Empty
}

trait Reads {
  read(Self) -> CA
}

impl Reads for Holder {
  read(self) -> CA {
    self.value
  }
}

fn slot_v(_ s: Slot) -> Int {
  match s {
    Full(t) => t.v,
    Empty => 0
  }
}

test "a struct field typed by an as-renamed alias" {
  let h = Holder::{ value: mk() }
  inspect(h.value.v, content = "5")
}

test "struct fields typed by an as-renamed struct and alias" {
  let p = Pair::{ left: mk(), right: mk() }
  inspect(p.left.v + p.right.v, content = "10")
}

test "an enum payload typed by an as-renamed struct" {
  inspect(slot_v(Full(mk())), content = "5")
  inspect(slot_v(Empty), content = "0")
}

test "a trait method returning an as-renamed alias" {
  inspect(Reads::read(Holder::{ value: mk() }).v, content = "5")
}
