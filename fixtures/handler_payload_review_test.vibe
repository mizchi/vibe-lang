effect CharPayload {
  P(Char) -> Int
}
effect GenericPayload[T] {
  P(T) -> Int
}
effect Pick {
  P(Int) -> Int; Q(Int) -> Int
}
fn char_advice() -> Int {
  handle {
    perform CharPayload::P('a')
  } with { CharPayload::P(v) => if v == 97 {
    resume(42)
  } else {
    resume(0)
  } }
}
fn generic_advice() -> Int {
  handle {
    perform GenericPayload::P("x")
  } with { GenericPayload::P(v) => if v == "x" {
    resume(42)
  } else {
    resume(0)
  } }
}
fn consolidated_advice(x: Int) -> Int {
  handle {
    perform Pick::P(x)
  } with { Pick::P(v) => if v == 1 {
    resume(100)
  } else {
    resume(5)
  }; Pick::Q(_) => resume(7) }
}
test "the Char comparison advised by the diagnostic runs" {
  assert_eq(char_advice(), 42)
}
test "the instantiated generic comparison runs" {
  assert_eq(generic_advice(), 42)
}
test "consolidation preserves both literal and fallback results" {
  assert_eq(consolidated_advice(1), 100)
  assert_eq(consolidated_advice(3), 5)
}
