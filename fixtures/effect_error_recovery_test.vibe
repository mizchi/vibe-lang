// Error recovery: throw + catch combined with effect

effect Validate {
  Check(String) -> Bool
}

// Happy: validate → true → 42

// Error: validate → false → throw → catch → -1

test "effect error recovery" {
  let happy = handle {
    handle {
      let ok = perform Validate::Check("input")
      if ok {
        42
      } else {
        throw("fail"); 0
      }
    } with { Validate::Check(_s) => resume(true) }
  } with { Exception::Throw(_msg) => -1 }
  let err = handle {
    handle {
      let ok = perform Validate::Check("input")
      if ok {
        42
      } else {
        throw("fail"); 0
      }
    } with { Validate::Check(_s) => resume(false) }
  } with { Exception::Throw(_msg) => -1 }
  inspect(happy + err, "41")
}
