//# #2745: a nested array whose FIRST element carries nothing.
//
// Codex, P1 round 16 on #2761. Measured on `d45378d`:
// `{ let xs = [[], [a]]; let ys = Array::get(xs, 1); Array::get(ys, 0) }`
// printed a 3-digit pointer decimal.
//
// Round 13 gave an array's element a slot of its own and recorded it from
// `es[0]` alone. The CLASSIFICATION scan two lines above it already read every
// element and took the first non-empty; the shape read one. Two answers to one
// question, in the same arm, differing only in how far they looked.
//
// The slot is masked once and then merged over every element in order, so a
// later element fills what an earlier one left absent. An array's elements
// share a type, so merging cannot mix incompatible shapes, and a later element
// winning a key it shares with an earlier one is the fail-CLOSED direction.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{ { let xs = [[], [a]]
    let ys = Array::get(xs, 1)
    Array::get(ys, 0) } }"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
