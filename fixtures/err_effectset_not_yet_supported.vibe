// ADR-0071 step 2 (docs/effectset.md, #755): `effectset Name = { ... }`
// parses (lib/@vibe/parser/parser.vibe's parse_effectset_stmt) and
// round-trips through the printer, but resolution -- expanding member
// effect/operation/effectset references, cycle and member-collision
// detection, and actually authorizing a `with { EffectsetName }` row item
// against it -- is not implemented yet (that is step 2's resolver work and
// step 3's checker work). The checker explicitly rejects any `effectset`
// declaration for now (checker_stmt.vibe's SEffectSet case) rather than
// silently accepting an unvalidated, unusable declaration.
effect Ask {
  Get -> Int
}

effectset AskAll = { Ask }

__DATA__
{"error_contains": "effectset 'AskAll' is not yet supported"}
