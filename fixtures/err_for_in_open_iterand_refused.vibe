// #3148: a `for` whose iterand's type never resolves is REFUSED at build time.
// `c` is an erased type parameter and the call sits ABOVE `count`, so it was
// checked against the hoisted signature -- the loop reads its iterand as an
// Array, so handed a two-entry map it ran zero times and `count` answered 0,
// with nothing at build time. The edit is an annotation, or `Map::keys(m)`
// for a Map.
// The caller used to sit ABOVE the declaration; since #3378 that shape is
// refused at the declaration, so the caller is below it and `count` is
// exported: a caller through its contract is still only told `[T](T) -> Int`, so
// the loop over the formal is refused here.

export fn count[T](c: T) -> Int {
  let mut n = 0
  for x in c {
    n = n + 1
  }
  n
}

export let _start: () -> Int = () -> {
  count([1, 2])
}
