// #3148: a `for` whose iterand's type never resolves is REFUSED at build time.
// `c` is an erased type parameter, so the one lowering serves every caller --
// and the loop reads its iterand as an Array: handed a two-entry map it ran
// zero times and `count` answered 0, with nothing at build time. The edit is
// an annotation, or `Map::keys(m)` for a Map.

fn count[T](c: T) -> Int {
  let mut n = 0
  for x in c {
    n = n + 1
  }
  n
}

export let _start: () -> Int = () -> {
  let m: StringMap[Int] = Map::set(Map::set(Map::new(), "a", 1), "b", 2)
  count(m)
}
