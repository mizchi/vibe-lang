// Implementation of ../contract_pkg_vpkg/index.vpkg (#897). Declared fns and
// the opaque Counter are exported (transitional, until #732 removes the
// export keyword); helpers stay unexported and package-private. `Point` is
// defined in the contract itself -- referenced here by name (types are
// global in the merged program).

export struct Counter {
  n: Int
}

export fn add(x: Int, y: Int) -> Int { x + y }

export fn scale(k~: Int, v~: Int) -> Int { k * v }

export fn clamp(x: Int, lo: Int, hi: Int) -> Int {
  if x < lo { lo } else if x > hi { hi } else x
}

export fn point_sum(p: Point) -> Int { p.x + p.y }

export fn counter_new(n: Int) -> Counter {
  Counter::{ n: n }
}

export fn counter_get(c: Counter) -> Int { c.n }

fn helper_unexported(x: Int) -> Int { x + 99 }

export let answer: Int = 42
