// #897 (ADR-0070 Phase 1): the SAME contract grammar as ../contract_pkg's
// index.vibei, spelled `index.vpkg` -- the target extension `index.vibei`
// is being renamed to (76 directories, migrated in later phases). This
// fixture proves the loader accepts `.vpkg` as an alternate spelling of
// `.vibei` end-to-end (candidate resolution, conformance desugar, facade
// generation), not just `.vibei`.

import ./impl.vibe {}

struct Point {
  x: Int;
  y: Int
}

opaque type Counter

fn add(x: Int, y: Int) -> Int
fn scale(k~: Int, v~: Int) -> Int
fn clamp(x: Int, lo: Int, hi: Int) -> Int where {
  requires: lo <= hi,
}
fn point_sum(p: Point) -> Int
fn counter_new(n: Int) -> Counter
fn counter_get(c: Counter) -> Int

// #752 (ADR-0065): a bodyless VALUE declaration -- the definition lives in
// the implementation file, fingerprinted as `val Int`.
let answer: Int
