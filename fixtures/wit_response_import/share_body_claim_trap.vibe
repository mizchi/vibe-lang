// #2066: a route the spawn capture check cannot see (Codex on #3091): a
// closure RETURNED by a function hides the response future it captured, and
// no value in the spawning scope has a type that mentions a response. The
// two spawns hand one response body to two tasks. The adapter's one-time claim answers
// the first `HostResponse::body` and traps on the second, so the program
// fails instead of splitting the body between two readers. Compiled and run
// by scripts/test_wit_async_import_component_gate.sh, which expects a trap.
import ./client_bindings.vibe {
  fetch_a
}

import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn drain(s: HostStream) -> Int with Async {
  let mut total = 0
  for b in s {
    total = total + b
  }
  total
}

fn reader(pending: Future[HostResponse]) -> () -> Int with Async {
  () -> Int with Async {
    drain(HostResponse::body(await(pending)))
  }
}

let run: () -> Int with Async + Exception = () -> {
  let w = reader(fetch_a())
  TaskGroup::run((g) -> {
    let a = TaskGroup::spawn_suspend(g, w)
    let b = TaskGroup::spawn_suspend(g, w)
    TaskHandle::join(a) * 1000 + TaskHandle::join(b)
  })
}
