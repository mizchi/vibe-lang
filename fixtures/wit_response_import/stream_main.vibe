// #2066: a WIT response and a runner-private named host stream in ONE
// component. The body reads through the same stream canon pair the named
// stream uses, and `stream<u8>` is declared once for both; the named stream
// adds only its getter's functype. 200 + (1 + 2 + 3) + (10 + 15 + 17) = 248.
// Compiled and executed by scripts/test_wit_async_import_component_gate.sh.
import ./client_bindings.vibe {
  fetch_a
}

fn drain(s: HostStream) -> Int with Async {
  let mut total = 0
  for b in s {
    total = total + b
  }
  total
}

let run: () -> Int with Async = () -> {
  let pending = fetch_a()
  let side = drain(host_stream_named("body"))
  let resp = await(pending)
  HostResponse::status(resp) + drain(HostResponse::body(resp)) + side
}
