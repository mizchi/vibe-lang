// #3131 (Codex on #3091): the response half of
// fixtures/wit_future_import/drop_many.vibe. 600 responses dropped unawaited
// filled the adapter's 512 result slots, and a reclaimed response that had
// landed owns a body stream, which the reclaim drops with it. The awaited
// `fetch_b` then answers its status, 204. Executed by
// scripts/test_wit_async_import_component_gate.sh.
import ./client_bindings.vibe {
  fetch_a, fetch_b
}

let run: () -> Int with Async + Exception = () -> {
  let mut i = 0
  while i < 600 {
    let _ = fetch_a()
    i = i + 1
  }
  let r = await(fetch_b())
  host_stream_close(HostResponse::body(r))
  HostResponse::status(r)
}
