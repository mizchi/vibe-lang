// #2066: a closure bound to a name by a local `let` captures a response
// future. Spawning `worker` twice would hand the response body's one end to
// both tasks (Codex on #3091). The captures recorded for the `let` are judged
// at the spawn, and the captured future is refused with the edit that fixes
// it. Compiled and refused by scripts/test_wit_async_import_component_gate.sh.
import ./client_bindings.vibe {
  fetch_a
}

import @vibe/concurrent/experimental {
  TaskGroup, TaskHandle
}

let run: () -> Int with Async + Exception = () -> {
  let pending = fetch_a()
  TaskGroup::run((g) -> {
    let worker = () -> Int with Async + Exception {
      HostResponse::status(await(pending))
    }
    let a = TaskGroup::spawn_suspend(g, worker)
    let b = TaskGroup::spawn_suspend(g, worker)
    TaskHandle::join(a) + TaskHandle::join(b)
  })
}
