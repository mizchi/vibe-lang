// Lazy iterator combinators on the method-bearing `Iter` trait (#636).
//
// A lazy `Stream` is a struct holding a `pull` closure (spike G-1: closures in
// struct fields) plus its current state; `impl Iter for Stream` makes it a
// first-class iterator, so `for x in stream` and the generic combinators all
// work. map / filter are lazy (they wrap the source's pull); fold / sum / count
// are eager consumers driven by the `for` desugar. No compiler support beyond
// the trait machinery is needed — this is the trait-based replacement for the
// `() -> Option[T]` function-iterator in prelude/lazy_iter.vibe (whose prelude
// migration is gated on the seed bump that activates trait-method syntax).

//# Types

trait Iter[T] {
  next(Self) -> Option[(T, Self)]
}

// `pull(state) -> Option[(element, next_state)]`; the element/state are erased
// to Int here (the uniform tagged representation makes the encoding general).
struct Stream {
  pull: (Int) -> Option[(Int, Int)];
  state: Int
}

//# Functions

impl Iter for Stream {
  next(self) -> Option[(Int, Stream)] {
    match (self.pull)(self.state) {
      Some(p) => {
        let (v, ns) = p
        Some((v, Stream::{ pull: self.pull, state: ns }))
      },
      None => None
    }
  }
}

// Constructors / combinators.
let range = (lo: Int, hi: Int) -> Stream {
  Stream::{ pull: (s) -> { if s < hi { Some((s, s + 1)) } else { None } }, state: lo }
}

let smap = (s: Stream, f: (Int) -> Int) -> Stream {
  Stream::{ pull: (st) -> {
    match (s.pull)(st) {
      Some(p) => {
        let (v, ns) = p
        Some((f(v), ns))
      },
      None => None
    }
  }, state: s.state }
}

let sfilter = (s: Stream, pred: (Int) -> Bool) -> Stream {
  Stream::{ pull: (st) -> {
    let mut cur = st
    let mut result = None
    let mut go = true
    while go {
      match (s.pull)(cur) {
        Some(p) => {
          let (v, ns) = p
          if pred(v) {
            result = Some((v, ns))
            go = false
          } else {
            cur = ns
          }
        },
        None => {
          go = false
        }
      }
    }
    result
  }, state: s.state }
}

// Eager consumer driven by the `for x in <iterator>` desugar.
let sfold = (s: Stream, init: Int, f: (Int, Int) -> Int) -> Int {
  let mut acc = init
  for x in s {
    acc = f(acc, x)
  }
  acc
}

let ssum = (s: Stream) -> Int {
  sfold(s = s, init = 0, f = (a, b) -> { a + b })
}

let scount = (s: Stream) -> Int {
  sfold(s = s, init = 0, f = (a, _) -> { a + 1 })
}

let is_even = (x: Int) -> Bool {
  x - (x / 2) * 2 == 0
}

//# Tests

test "range + fold/sum/count" {
  assert_eq(ssum(s = range(lo = 1, hi = 5)), 10)
  assert_eq(scount(s = range(lo = 0, hi = 7)), 7)
  assert_eq(sfold(s = range(lo = 1, hi = 4), init = 1, f = (a, b) -> { a * b }), 6)
}

test "lazy map" {
  assert_eq(ssum(s = smap(s = range(lo = 1, hi = 5), f = (x) -> { x * 2 })), 20)
  assert_eq(scount(s = smap(s = range(lo = 0, hi = 9), f = (x) -> { x + 100 })), 9)
}

test "lazy filter" {
  assert_eq(ssum(s = sfilter(s = range(lo = 1, hi = 10), pred = is_even)), 20)
  assert_eq(scount(s = sfilter(s = range(lo = 1, hi = 10), pred = is_even)), 4)
}

test "chained map |> filter |> fold" {
  // (1..6) -> *3 -> keep even -> sum : 3,6,9,12,15 -> even {6,12} -> 18
  let s = sfilter(s = smap(s = range(lo = 1, hi = 6), f = (x) -> { x * 3 }), pred = is_even)
  assert_eq(ssum(s = s), 18)
}
