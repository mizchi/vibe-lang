//# #2745: an erased value read back out of a MAP.
//
// Codex, P1 round 26 on #2761. Measured on `3913a8a`:
// `"\{Map::get(Map::set(Map::new(), "k", a), "k")}"` printed a 3-digit pointer
// decimal. `Map::get` is a builtin, so it is absent from `fn_returns`, and the
// call classifier named only `Array::get` and `__index`.
//
// That is the SEVENTH time in this PR that one of a pair was closed and the
// other left open. "What does reading this container give?" is one question, so
// a map's value now goes in the SAME slot an array's element does and
// `dtd_interp_reads_element` names all three spellings in one place.

struct Qt {
  w: Int
}

fn outer[T](x: T) -> String {
  let inner = [T](a: T) -> String {
    "\{Map::get(Map::set(Map::new(), "k", a), "k")}"
  }
  inner(Qt::{ w: 5 })
}

export fn _start() -> Int {
  String::length(outer(7))
}
