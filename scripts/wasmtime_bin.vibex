// vibex pilot port of scripts/wasmtime_bin.sh (#848-style .vibex pilot).
//
// Resolve which `wasmtime` binary to use, in priority order:
//   1. $WASMTIME_BIN, if set (explicit override always wins)
//   2. if VIBE_USE_WASMTIME_SUBMODULE=1: the deps/wasmtime submodule build
//      (release, then debug), or an error if neither is built
//   3. `wasmtime` on $PATH
//   4. fallback to the deps/wasmtime submodule build even without opt-in
//   5. an error: wasmtime not found anywhere
//
// Usage: vibe run scripts/wasmtime_bin.vibex   (prints the resolved path)
//
// CAVEAT (#865, found while verifying this file): `scripts/vibe_run.sh`
// always compiles through the frozen `bootstrap/seed/` compiler, which is
// several days stale relative to current source and does not yet recognize
// the `Stderr` builtin this file now uses (nor, independently, several
// pre-#865 builtins this file already relied on -- reproduced against the
// UNMODIFIED pre-#865 cache_clean.vibex too, so this is a pre-existing
// bootstrap-seed-staleness gap, not something #865 introduced). Until the
// seed is bumped, actually running this file end-to-end requires compiling
// with a freshly-built stage2/stage3 instead of the frozen seed.
//
// Differences from scripts/wasmtime_bin.sh, a consequence of the current
// stdlib/runtime surface (see the pilot report):
//   * executable-bit checks (`[ -x path ]`) are approximated with
//     Fs::exists (there is no file-permission query builtin yet); a
//     same-named non-executable file at that exact path would be a false
//     positive, which does not occur in practice for cargo build output.
//   * #865 closed the other two gaps this file used to document: the
//     "not found" error paths now print to STDERR (the new Stderr builtin)
//     and the process now exits 1 on failure through the explicit Process
//     effect --
//     matching scripts/wasmtime_bin.sh's `... >&2; exit 1` exactly. Every
//     current bash caller already treats a wasmtime_bin.sh failure as
//     non-fatal (`scripts/wasmtime_bin.sh 2>/dev/null || command -v
//     wasmtime || true`), so this is a like-for-like behavior match rather
//     than a call-site behavior change.

fn command_v(name: String) -> String with Process {
  let lines = sh_lines("command -v \{name}")
  if Array::length(lines) == 0 {
    ""
  }
  else {
    let first = Array::get(lines, 0)
    if String::starts_with(first, "error:") {
      ""
    } else first
  }
}

let local_release = "deps/wasmtime/target/release/wasmtime"
let local_debug = "deps/wasmtime/target/debug/wasmtime"

fn resolve_submodule_opt_in() -> Int with Fs + Stdout + Stderr {
  if Fs::exists(local_release) {
    Stdout::write_stream("\{local_release}\n")
    0
  }
  else if Fs::exists(local_debug) {
    Stdout::write_stream("\{local_debug}\n")
    0
  }
  else {
    Stderr::write_stream("VIBE_USE_WASMTIME_SUBMODULE=1 but deps/wasmtime wasmtime binary is not built.\n")
    Stderr::write_stream("Run: pkf run build-wasmtime-submodule\n")
    1
  }
}

fn resolve_default() -> Int with Fs + Process + Stdout + Stderr {
  let found = command_v("wasmtime")
  if found != "" {
    Stdout::write_stream("\{found}\n")
    0
  }
  else if Fs::exists(local_release) {
    Stdout::write_stream("\{local_release}\n")
    0
  }
  else if Fs::exists(local_debug) {
    Stdout::write_stream("\{local_debug}\n")
    0
  }
  else {
    Stderr::write_stream("wasmtime not found (system PATH and deps/wasmtime build).\n")
    Stderr::write_stream("Install wasmtime or run: pkf run wasmtime-submodule-init && pkf run build-wasmtime-submodule\n")
    1
  }
}

fn main with Fs + Env + Process + Stdout + Stderr {
  let code = if Env::get("WASMTIME_BIN") != "" {
    let override_bin = Env::get("WASMTIME_BIN")
    Stdout::write_stream("\{override_bin}\n")
    0
  }
  else if Env::get("VIBE_USE_WASMTIME_SUBMODULE") == "1" {
    resolve_submodule_opt_in()
  }
  else {
    resolve_default()
  }
  if code != 0 {
    vibe_process_exit_raw(code)
  } else {
    ()
  }
}
