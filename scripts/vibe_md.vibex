// scripts/vibe_md.vibex — native vibe port of scripts/vibe_md.py (#1142/#1137).
//
// Extracts ```vibe fenced code blocks from a *.vibe.md file, compiles+runs
// each one with the selfhost stage2 compiler, and for ```vibe run blocks
// embeds the captured stdout into an adjacent ```output block -- so a
// *.vibe.md file's prose, code and shown results cannot drift apart.
//
// Usage (run from the repo root):
//   bash scripts/vibe_md.sh check <file.vibe.md> [more...]
//   bash scripts/vibe_md.sh write <file.vibe.md> [more...]
//   bash scripts/vibe_md.sh fmt <file.vibe.md> [more...]
//   bash scripts/vibe_md.sh fmt-check <file.vibe.md> [more...]
//
// `fmt`/`fmt-check` run each ```vibe code block (check/run/skip -- anything
// that is actual vibe source, not a ```output block) through the selfhost
// CST-token formatter (scripts/vibe_fmt.sh --stdout, i.e. the SAME formatter
// `pkf run fmt` applies to lib/**/*.vibe) and either rewrite the block in
// place (`fmt`) or fail if it isn't already a fixpoint (`fmt-check`, mirrors
// scripts/check_vibe_fmt.sh's contract but for markdown-embedded code).
// Unlike `check`/`write`, `fmt`/`fmt-check` never compile or execute a
// block's code, so they need no compiler wasm -- scripts/vibe_fmt.sh always
// builds its formatter entry from the committed seed.
//
// NOT run through scripts/vibe_run.sh (the usual .vibex launcher): its
// `--invoke main` path double-executes `main` for any entry other than
// `_start` (wasm_vibe_host_runner.js's pre-invoke step runs `_start` for
// initialization, and a normal `entry=main` program's own `_start` already
// calls `main` per the WASI convention, so `--invoke main` runs it again on
// top of that -- reproduces with any .vibex tool run through vibe_run.sh,
// e.g. scripts/cache_clean.vibex, so it's a launcher/runner-level issue, not
// specific to this file). scripts/vibe_md.sh instead builds this file to a
// cached wasm and invokes `_start` directly, which runs the program exactly
// once.
//
// Block classification (info string on the opening ```vibe fence), same
// convention as scripts/vibe_md.py / scripts/doctest_extract_run.sh:
//   ```vibe        compile-check only (entry __no_entry__)         [default]
//   ```vibe run    compile (entry main) + execute; stdout captured
//   ```vibe skip   excluded from verification
//   ```vibe run standalone
//                  a `run` block kept OUT of the merged module (#819) and
//                  compiled on its own. Use it when a block must not share a
//                  compilation with its siblings; the merged path already
//                  opts out automatically for anything it cannot express
//                  (see the "#819: merged compile" section below).
//
// #819 content-addressed cache: a ```vibe run block always compiles (its
// own tiny source may import stdlib/support files whose content this tool
// has no cheap way to hash up front), but deterministic compilation already
// folds that block's source + all its transitive deps + the compiler build
// into the compiled wasm's bytes -- so sha256(compiled wasm) is a sound
// cache key for the EXECUTE step, exactly mirroring the pure-test cache
// `vibe test` already ships (ADR-0026, runtime/vibe's $tcache/<hash>.pass:
// same "hash the deterministic output, not the inputs" trick, there gating
// re-running an assertion, here gating re-capturing stdout) -- PROVIDED the
// block is actually pure. Byte-identical compiled wasm does NOT imply
// byte-identical stdout when the entry performs Fs/Env/Http/Process/etc:
// same wasm, different host state, different output (Codex review, PR
// #1214). So the compiler is asked (VIBE_ENTRY_TESTMETA_OUT, backed by
// checker/checker_effects.vibe's file_entry_cacheable) whether `main`'s
// only reachable effects are Stdout/Error/Async, and the cache is only
// read/written when it says yes -- everything else always re-executes,
// same as an uncached run. A hit skips the `_start` subprocess entirely and
// reuses the previously-captured stdout. Cache dir: $VIBE_MD_CACHE (default
// _build/doctest_cache); set VIBE_MD_NO_CACHE=1 to bypass. ```vibe
// (check-mode) blocks have no execute step to skip and are unaffected.
//
// Design differences from scripts/vibe_md.py, forced by vibe's actual
// capabilities rather than an exact translation:
//   * vibe has NO symlink-creation builtin. The Python version placed
//     extracted block sources in a throwaway scratch dir and symlinked
//     `lib` + the doc's own siblings into it so relative imports would
//     resolve. Checked the real tutorial content instead of assuming: every
//     import in docs/tutorial/*.vibe.md is either package-style (`@vibe/...`,
//     which `resolve_import_path_candidates` resolves against the WASI
//     preopen ROOT independent of the importing file's own directory -- no
//     symlink involved at all) or a literal sibling-relative path
//     (`./support/mathx.vibe`, `./subdir`) that already exists on disk next
//     to the .md file. So this version extracts each block's scratch source
//     DIRECTLY INTO THE SAME DIRECTORY as the .md file (basename+block-
//     index+line-qualified name, cleaned up after) instead of a separate
//     workdir -- siblings
//     resolve natively, package imports resolve via the preopen root as
//     always, and no symlink is ever needed. A literal `./lib/...`-style
//     import (not used by any current tutorial content) would not resolve
//     under this scheme; that is a known, accepted gap, not an oversight.
//   * no in-process wasm execution or Fs::mtime/stat capability exists in
//     vibe's stdlib yet, so both "run the compiled wasm and capture stdout"
//     and "find the newest stage2 generation by mtime" still shell out via
//     `@vibe/process`'s `sh_capture` (`{ Process }` effect) -- same
//     mechanism scripts/run_wasm_vibe_host_runner.sh itself needs, and the
//     exact `ls -dt ... | head -1` idiom already used by this repo's own
//     gate scripts for the identical "newest generation" lookup.
//   * TaskGroup (#1081/ADR-0068) was deliberately NOT used for concurrent
//     block processing: `TaskGroup::spawn`'s closure parameter is fixed to
//     `with Error` (not row-polymorphic like `TaskGroup::run`'s own
//     body), so a spawned task cannot itself perform `Process`/`Fs` --
//     confirmed against the real lib/@vibex/concurrent/index.vpkg contract
//     before writing this file, not assumed. Parallelizing block processing
//     is tracked as separate follow-up work once that constraint is lifted.
//   * no diff library exists in the vibe stdlib -- a stale ```output
//     mismatch prints the expected and actual blocks in full rather than a
//     unified diff (scripts/vibe_md.py used Python's `difflib`).

import @vibe/process { Process, sh_capture }

// ---------- fence scanning primitives ----------

fn is_space_or_tab(c: Int) -> Bool {
  c == 32 || c == 9
}

fn count_leading_backticks(line: String) -> Int {
  let len = String::length(line)
  let mut i = 0
  while i < len && String::char_code_at(line, i) == 96 {
    i = i + 1
  }
  i
}

// #1142's #1161-equivalent CommonMark rule: a closing fence needs AT LEAST
// as many backticks as the opening one (a longer run still closes it), not
// an exact-length match, and nothing but trailing whitespace may follow.
fn is_closing_fence(line: String, min_backticks: Int) -> Bool {
  let n = count_leading_backticks(line)
  if n < min_backticks {
    false
  } else {
    let len = String::length(line)
    let mut i = n
    let mut ok = true
    while i < len {
      if !is_space_or_tab(String::char_code_at(line, i)) {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

fn skip_ws(s: String, from: Int) -> Int {
  let len = String::length(s)
  let mut i = from
  while i < len && is_space_or_tab(String::char_code_at(s, i)) {
    i = i + 1
  }
  i
}

fn read_token_end(s: String, from: Int) -> Int {
  let len = String::length(s)
  let mut i = from
  while i < len && !is_space_or_tab(String::char_code_at(s, i)) {
    i = i + 1
  }
  i
}

// Splits the text after an opening fence's backticks into (lang, arg),
// mirroring scripts/vibe_md.py's `^(`{3,})\s*(\S*)\s*(.*)$`.
fn parse_fence_info(rest: String) -> (String, String) {
  let start = skip_ws(rest, 0)
  let lang_end = read_token_end(rest, start)
  let lang = String::substring(rest, start, lang_end)
  let arg_start = skip_ws(rest, lang_end)
  let arg = String::trim(String::substring(rest, arg_start, String::length(rest)))
  (lang, arg)
}

// ---------- block / token model ----------

struct Block {
  lang: String;
  mut mode: String; // "check" | "run" | "skip" | "output" | "other"
  start_line: Int;
  mut code_lines: Array[String];
  open_line: String;
  close_line: String;
  mut has_actual_stdout: Bool;
  mut actual_stdout: String;
  mut paired_output: Int; // token index of paired ```output block, or -1
  mut has_replacement: Bool;
  mut replacement_lines: Array[String];
  mut has_fmt_replacement: Bool;
  mut fmt_lines: Array[String]
}

fn new_block(lang: String, arg: String, start_line: Int, code_lines: Array[String], open_line: String, close_line: String) -> Block {
  let mode = if lang == "vibe" {
    if String::starts_with(arg, "run") {
      "run"
    } else if String::starts_with(arg, "skip") {
      "skip"
    } else {
      "check"
    }
  } else if lang == "output" {
    "output"
  } else {
    "other"
  }
  Block::{
    lang: lang,
    mode: mode,
    start_line: start_line,
    code_lines: code_lines,
    open_line: open_line,
    close_line: close_line,
    has_actual_stdout: false,
    actual_stdout: "",
    paired_output: -1,
    has_replacement: false,
    replacement_lines: array_empty(),
    has_fmt_replacement: false,
    fmt_lines: array_empty(),
  }
}

enum Token {
  TText(String);
  TBlock(Block)
}

fn array_empty[T]() -> Array[T] {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

// ---------- markdown -> tokens ----------

// An unterminated fence uses the built-in `Error` effect (`throw`) rather
// than a custom effect -- distinct from a block that compiled/ran and
// failed verification, but no new effect vocabulary is needed for it.
fn parse_blocks(text: String) -> Array[Token] with Error {
  let lines = splitlines_like(text)
  let n = Array::length(lines)
  let tokens = ArrayBuilder::new()
  let mut i = 0
  while i < n {
    let line = Array::get(lines, i)
    let backticks = count_leading_backticks(line)
    if backticks < 3 {
      ArrayBuilder::push(tokens, TText(line))
      i = i + 1
    } else {
      let rest = String::substring(line, backticks, String::length(line))
      let (lang, arg) = parse_fence_info(rest)
      let start_line = i + 2 // 1-based line number of the first code line
      let body = ArrayBuilder::new()
      let mut j = i + 1
      let mut closed = false
      while j < n && !closed {
        if is_closing_fence(Array::get(lines, j), backticks) {
          closed = true
        } else {
          ArrayBuilder::push(body, Array::get(lines, j))
          j = j + 1
        }
      }
      if !closed {
        // An unterminated fence silently dropped to plain text would let an
        // editing mistake (deleted closing ```) remove a ```vibe run block
        // from verification instead of failing loudly.
        throw("unterminated ``` fence starting at line \{i + 1} (lang=\{lang}): no matching closing fence found")
      } else {
        ()
      }
      let close_line = Array::get(lines, j)
      let blk = new_block(lang, arg, start_line, ArrayBuilder::freeze(body), line, close_line)
      ArrayBuilder::push(tokens, TBlock(blk))
      i = j + 1
    }
  }
  ArrayBuilder::freeze(tokens)
}

fn is_blank(s: String) -> Bool {
  String::trim(s) == ""
}

// Forward scan: pair each run-mode block with an immediately following
// (blank text lines only in between) unconsumed ```output block, recording
// the OUTPUT TOKEN'S INDEX on the run block's `paired_output` field.
fn link_run_output_pairs(tokens: Array[Token]) -> Unit {
  let n = Array::length(tokens)
  let consumed = ArrayBuilder::new()
  let mut consumed_arr = array_empty()
  let mut idx = 0
  while idx < n {
    match Array::get(tokens, idx) {
      TBlock(blk) => {
        if blk.mode == "run" {
          let mut j = idx + 1
          let mut scanning = true
          while j < n && scanning {
            match Array::get(tokens, j) {
              TText(t) => {
                if is_blank(t) {
                  j = j + 1
                } else {
                  scanning = false
                }
              },
              TBlock(_) => { scanning = false }
            }
          }
          if j < n {
            match Array::get(tokens, j) {
              TBlock(ob) => {
                if ob.mode == "output" && !array_contains_int(consumed_arr, j) {
                  blk.paired_output = j
                  ArrayBuilder::push(consumed, j)
                  consumed_arr = ArrayBuilder::freeze(consumed)
                } else {
                  ()
                }
              },
              TText(_) => ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
      },
      TText(_) => ()
    }
    idx = idx + 1
  }
}

fn array_contains_int(arr: Array[Int], v: Int) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == v {
      found = true
    }
    i = i + 1
  }
  found
}

fn join_lines(lines: Array[String]) -> String {
  let n = Array::length(lines)
  if n == 0 {
    ""
  } else {
    String::concat(String::join(lines, "\n"), "\n")
  }
}

// A ```output block is line-based markdown text: reading it back can never
// distinguish "last line ends with \n" from "last line doesn't" --
// reconstruction always adds a trailing \n. Normalize actual stdout the
// same way (append one if missing, unless empty) so a program whose last
// stdout_write omits the trailing newline still round-trips write -> check
// as a stable PASS.
fn normalize_trailing_newline(s: String) -> String {
  let len = String::length(s)
  if len == 0 {
    s
  } else if String::char_code_at(s, len - 1) == 10 {
    s
  } else {
    String::concat(s, "\n")
  }
}

// Matches Python's `str.splitlines()`: unlike a plain split on "\n", a
// trailing newline does not produce a trailing empty-string element (so
// "a\n" -> ["a"], not ["a", ""]). Used to turn captured stdout back into
// markdown lines for a rewritten ```output block without introducing a
// spurious blank line before the closing fence.
fn splitlines_like(s: String) -> Array[String] {
  if s == "" {
    array_empty()
  } else {
    let parts = String::split(s, "\n")
    let n = Array::length(parts)
    if n > 0 && Array::get(parts, n - 1) == "" {
      Array::slice(parts, 0, n - 1)
    } else {
      parts
    }
  }
}

// ---------- process execution ----------

fn shq(s: String) -> String {
  // single-quote for a POSIX shell word; repo paths never contain a literal
  // single quote, so no escaping beyond wrapping is needed here.
  String::concat("'", String::concat(s, "'"))
}

// Newest-first candidate scan, skipping any generation directory whose
// stage2.wasm is missing or empty (an interrupted/still-running selfhost
// build) rather than picking the newest DIRECTORY unconditionally -- matches
// scripts/vibe_md.py's resolve_stage2, which filtered candidates the same
// way before sorting by mtime.
fn resolve_stage2() -> String with Process + Env + Fs {
  let env_val = Env::get("VIBE_MD_STAGE2")
  if String::length(env_val) > 0 {
    env_val
  } else {
    let r = sh_capture("ls -dt _build/selfhost/generations/*/ 2>/dev/null")
    let dirs = splitlines_like(r.stdout)
    let n = Array::length(dirs)
    let mut i = 0
    let mut found = ""
    while i < n && found == "" {
      let dir = String::trim(Array::get(dirs, i))
      if dir != "" {
        let candidate = String::concat(dir, "stage2.wasm")
        if file_nonempty(candidate) {
          found = candidate
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    if found != "" {
      found
    } else {
      "bootstrap/seed/compiler.wasm"
    }
  }
}

fn file_nonempty(path: String) -> Bool with Fs {
  if Fs::exists(path) {
    Bytes::length(Fs::read_bytes(path)) > 0
  } else {
    false
  }
}

fn first_nonblank_line(s: String) -> String {
  let lines = String::split(s, "\n")
  let n = Array::length(lines)
  let mut i = 0
  let mut out = ""
  while i < n && out == "" {
    let l = String::trim(Array::get(lines, i))
    if l != "" {
      out = l
    }
    i = i + 1
  }
  out
}

// Result of processing one code block: appended in document order for the
// final report and exit-code decision.
struct BlockResult {
  label: String;
  status: String; // "PASS" | "FAIL" | "SKIP" | "WROTE"
  reason: String
}

// Per-block compile/run subprocess deadline, seconds (matches
// scripts/vibe_md.py's VIBE_MD_TIMEOUT, default 120): without it a hung or
// infinite-looping tutorial block ties up sh_capture (and therefore the CI
// job running it) with no per-block failure ever produced.
fn md_timeout_secs() -> String with Env {
  let v = String::trim(Env::get("VIBE_MD_TIMEOUT"))
  if String::length(v) > 0 {
    v
  } else {
    "120"
  }
}

// #819 doctest cache directory + opt-out, same env-var-with-default shape as
// md_timeout_secs above.
fn doctest_cache_dir() -> String with Env {
  let v = String::trim(Env::get("VIBE_MD_CACHE"))
  if String::length(v) > 0 {
    v
  } else {
    "_build/doctest_cache"
  }
}

fn doctest_no_cache() -> Bool with Env {
  String::trim(Env::get("VIBE_MD_NO_CACHE")) == "1"
}

// Portable single-file sha256 (macOS ships `shasum`, not `sha256sum`) --
// same fallback runtime/vibe's own `_sha256_file` uses for the `vibe test`
// pure-test cache.
fn sha256_file(path: String) -> String with Process {
  let cmd = "if command -v sha256sum >/dev/null 2>&1; then sha256sum \{shq(path)} | cut -d' ' -f1; else shasum -a 256 \{shq(path)} | awk '{print $1}'; fi"
  let r = sh_capture(cmd)
  String::trim(r.stdout)
}

/// A token unique to THIS process, memoized (module-level `let` = initialized
/// once). Used to name the cache's temp file; `$$` in the `sh -c` is that
/// shell's pid, which is unique per invocation of this tool.
let doctest_tmp_tag_cell = Array::slice([
  ""
], 0, 0)

fn doctest_tmp_tag() -> String with Process {
  if Array::length(doctest_tmp_tag_cell) > 0 {
    Array::get(doctest_tmp_tag_cell, 0)
  } else {
    let t = String::trim(sh_capture("echo $$").stdout)
    Array::push(doctest_tmp_tag_cell, t)
    t
  }
}

/// Publish a cache entry ATOMICALLY (write to a process-unique temp, then
/// rename over the final name).
///
/// A plain `Fs::write_file` was fine while this tool processed one doc at a
/// time. `scripts/vibe_md.sh` now runs one process PER DOC in parallel, and
/// the cache key is the compiled wasm's hash -- so two docs containing the
/// SAME block source key to the SAME file, and two workers can write it at
/// once. An interleaved write leaves a truncated or mixed entry, which a
/// later run reads back AS THE BLOCK'S STDOUT: a silently wrong PASS or FAIL,
/// the worst failure shape this cache could have. `rename` within one
/// directory is atomic, so a reader sees either the old entry or a complete
/// new one.
fn write_doctest_cache(cache_path: String, content: String) -> Unit with Fs + Process {
  let dir = dirname(cache_path)
  let _ = sh_capture("mkdir -p \{shq(dir)}")
  let tmp = "\{cache_path}.tmp\{doctest_tmp_tag()}"
  Fs::write_file(tmp, content)
  Fs::rename(tmp, cache_path)
}

fn run_one_block(cwd: String, compiler: String, md_path: String, md_dir: String, scratch_name: String, blk: Block, mode: String) -> BlockResult with Fs + Process + Env {
  let label = "\{md_path}:\{blk.start_line}"
  if blk.mode == "skip" {
    BlockResult::{ label: label, status: "SKIP", reason: "" }
  } else {
    let src = "\{md_dir}/\{scratch_name}.vibe"
    let out = "\{md_dir}/\{scratch_name}.wasm"
    let diag = "\{out}.diag"
    let entry_meta = "\{out}.entrymeta"
    Fs::write_file(src, join_lines(blk.code_lines))
    let entry = if blk.mode == "run" {
      "main"
    } else {
      "__no_entry__"
    }
    // #819 (Codex review, PR #1214): only requested for `run` blocks -- ask
    // the compiler whether `main`'s only reachable effects are Stdout/Error/
    // Async (see run_one_block's use of entry_meta below for why this is
    // required, not just the compiled wasm's own hash).
    let meta_env = if blk.mode == "run" {
      "VIBE_ENTRY_TESTMETA_OUT=\{shq(entry_meta)} "
    } else {
      ""
    }
    let timeout_secs = md_timeout_secs()
    let compile_cmd = "timeout \{timeout_secs} env VIBE_PREOPEN_DIR=\{shq(cwd)} VIBE_FS_COMPILE=1 VIBE_IMPORT_ABI=raw \{meta_env}bash scripts/run_wasm_vibe_host_runner.sh --invoke cli_main \{shq(compiler)} \{shq(src)} \{shq(out)} \{shq(entry)}"
    let cr = sh_capture(compile_cmd)
    let compiled = cr.exit_code == 0 && file_nonempty(out)
    if !compiled {
      let reason = if cr.exit_code == 124 {
        "timeout after \{timeout_secs}s"
      } else if Fs::exists(diag) {
        first_nonblank_line(Fs::read_file(diag))
      } else {
        let combined = String::concat(cr.stdout, cr.stderr)
        first_nonblank_line(combined)
      }
      let shown = if reason == "" {
        "compile failure"
      } else {
        reason
      }
      cleanup_one(src, out, diag)
      BlockResult::{ label: label, status: "FAIL", reason: "[compile] \{shown}" }
    } else if blk.mode == "check" {
      cleanup_one(src, out, diag)
      BlockResult::{ label: label, status: "PASS", reason: "" }
    } else {
      // #819 (Codex review, PR #1214): the compiled wasm's bytes alone are
      // NOT a sound cache-eligibility signal -- a block that performs Fs/
      // Env/Http/Process effects compiles to the SAME wasm every time (its
      // literal source is unchanged) but can legitimately produce DIFFERENT
      // stdout across runs, so blindly trusting sha256(compiled wasm) would
      // let `check` silently accept stale output and `write` freeze a
      // snapshot of impure output forever. entry_meta (written by the
      // compiler above via VIBE_ENTRY_TESTMETA_OUT, entry_cacheable_for_fs /
      // file_entry_cacheable) reports whether `main`'s only reachable
      // effects are Stdout/Error/Async -- only THEN is sha256(compiled wasm)
      // sound (see the file header comment for why the hash itself, once
      // purity is established, is a sound key). Read before cleanup_one
      // below removes `out`/`entry_meta`.
      let entry_cacheable = Fs::exists(entry_meta) && String::trim(Fs::read_file(entry_meta)) == "1"
      let use_cache = !doctest_no_cache() && entry_cacheable
      let key = if use_cache {
        sha256_file(out)
      } else {
        ""
      }
      let cache_path = if key != "" {
        "\{doctest_cache_dir()}/\{key}.out"
      } else {
        ""
      }
      let cached = if cache_path != "" && Fs::exists(cache_path) {
        Some(Fs::read_file(cache_path))
      } else {
        None
      }
      match cached {
        Some(actual) => {
          cleanup_one(src, out, diag)
          blk.has_actual_stdout = true
          blk.actual_stdout = actual
          if mode == "write" {
            BlockResult::{ label: label, status: "WROTE", reason: " (cached)" }
          } else {
            BlockResult::{ label: label, status: "PENDING_OUTPUT_CHECK", reason: " (cached)" }
          }
        },
        None => {
          let run_cmd = "timeout \{timeout_secs} env VIBE_PREOPEN_DIR=\{shq(cwd)} bash scripts/run_wasm_vibe_host_runner.sh --invoke _start \{shq(out)}"
          let rr = sh_capture(run_cmd)
          cleanup_one(src, out, diag)
          if rr.exit_code != 0 {
            let reason = if rr.exit_code == 124 {
              "timeout after \{timeout_secs}s"
            } else {
              first_nonblank_line(rr.stderr)
            }
            let shown = if reason == "" {
              "runtime failure"
            } else {
              reason
            }
            BlockResult::{ label: label, status: "FAIL", reason: "[run] \{shown}" }
          } else {
            let actual = normalize_trailing_newline(rr.stdout)
            blk.has_actual_stdout = true
            blk.actual_stdout = actual
            if cache_path != "" {
              write_doctest_cache(cache_path, actual)
            } else {
              ()
            }
            if mode == "write" {
              BlockResult::{ label: label, status: "WROTE", reason: "" }
            } else {
              BlockResult::{ label: label, status: "PENDING_OUTPUT_CHECK", reason: "" }
            }
          }
        }
      }
    }
  }
}

// Formats one code block's source through scripts/vibe_fmt.sh --stdout (the
// same selfhost CST-token formatter `pkf run fmt` applies to lib/**/*.vibe)
// and either stages the replacement (`mode == "fmt"`, consumed by
// rewrite_text via blk.fmt_lines) or reports a FAIL (`mode == "fmt-check"`)
// when the block isn't already a fixpoint. Unlike run_one_block, this never
// compiles or executes the block, so it needs no compiler wasm argument.
fn run_fmt_block(md_path: String, md_dir: String, scratch_name: String, blk: Block, mode: String) -> BlockResult with Fs + Process + Env {
  let label = "\{md_path}:\{blk.start_line}"
  let src = "\{md_dir}/\{scratch_name}.vibe"
  let original = join_lines(blk.code_lines)
  Fs::write_file(src, original)
  let timeout_secs = md_timeout_secs()
  let fmt_cmd = "timeout \{timeout_secs} bash scripts/vibe_fmt.sh --stdout \{shq(src)}"
  let r = sh_capture(fmt_cmd)
  if Fs::exists(src) {
    Fs::remove(src)
  } else {
    ()
  }
  if r.exit_code != 0 {
    let reason = if r.exit_code == 124 {
      "timeout after \{timeout_secs}s"
    } else {
      first_nonblank_line(String::concat(r.stdout, r.stderr))
    }
    let shown = if reason == "" {
      "fmt failure"
    } else {
      reason
    }
    BlockResult::{ label: label, status: "FAIL", reason: "[fmt] \{shown}" }
  } else {
    let formatted = r.stdout
    if formatted == original {
      BlockResult::{ label: label, status: "PASS", reason: "" }
    } else if mode == "fmt" {
      blk.has_fmt_replacement = true
      blk.fmt_lines = splitlines_like(formatted)
      BlockResult::{ label: label, status: "WROTE", reason: "" }
    } else {
      BlockResult::{ label: label, status: "FAIL", reason: "[fmt] not formatted (run `bash scripts/vibe_md.sh fmt` to fix)" }
    }
  }
}

fn cleanup_one(src: String, out: String, diag: String) -> Unit with Fs {
  let funcmap = "\{out}.funcmap"
  let entry_meta = "\{out}.entrymeta"
  if Fs::exists(src) {
    Fs::remove(src)
  } else {
    ()
  }
  if Fs::exists(out) {
    Fs::remove(out)
  } else {
    ()
  }
  if Fs::exists(diag) {
    Fs::remove(diag)
  } else {
    ()
  }
  if Fs::exists(entry_meta) {
    Fs::remove(entry_meta)
  } else {
    ()
  }
  if Fs::exists(funcmap) {
    Fs::remove(funcmap)
  } else {
    ()
  }
}

fn sanitize_base(name: String) -> String {
  let len = String::length(name)
  let mut i = 0
  let sb = StringBuilder::new()
  while i < len {
    let c = String::char_code_at(name, i)
    let ok = (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
    if ok {
      StringBuilder::push(sb, String::from_char_code(c))
    } else {
      StringBuilder::push(sb, "_")
    }
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

fn pad2(n: Int) -> String {
  if n < 10 {
    "0\{n}"
  } else {
    "\{n}"
  }
}

// ---------- #819: merged compile ----------
//
// The measured cost of a doc run is compilation, not execution: on
// docs/tutorial/*.vibe.md (28 runnable blocks) a cold pass took ~11.0s and a
// fully cache-warm pass still took ~8.7s, because the output cache (#1214)
// only skips the EXECUTE step -- every block was still compiled from scratch.
// Merging the blocks of one .md into ONE module turns N compiles into 1.
//
// The three design questions #819 left open, and what this answers:
//
//   * namespacing -- every tutorial block declares its own `main` (and often
//     its own `add`/`fact`/...), so a naive text concatenation would collide
//     immediately. Instead each block is written out as its own .vibe FILE and
//     the driver imports them, which hands the whole problem to the module
//     system's existing per-module mangling (`main_exp_..._b01_vibe`). No
//     renaming pass of our own, and no new collision rules to specify.
//   * ordering / cross-block dependencies -- blocks stay independent modules,
//     so a block can NOT see the previous block's definitions. That matches
//     the corpus (every block re-imports what it needs and is compilable on
//     its own, which is also what makes it a good doc example). A doc that
//     wants to build on an earlier block opts that block out; making later
//     blocks implicitly see earlier ones would require exporting every
//     top-level name and would change what a block means when read in
//     isolation.
//   * opt-out -- ```vibe run standalone``` keeps a block on its own compile.
//     `new_block` already classifies any `run`-prefixed argument as mode
//     "run" and `Block.open_line` retains the full fence line, so this needs
//     no parser change.
//
// Per-block failure attribution survives merging because codegen exports one
// `__test_<name>` per `test {}` block and the runner invokes it without
// pre-running `_start` (also #819) -- so each block still runs alone, in its
// own process, and its stdout is its own.
//
// The output cache is deliberately NOT used on the merged path: its key is
// sha256(the block's own compiled wasm), which no longer exists once N blocks
// share one module, and its soundness gate (VIBE_ENTRY_TESTMETA_OUT reporting
// whether `main`'s reachable effects are Stdout/Error/Async) is per-entry.
// The cache bought ~2.1s of execute time; merging removes ~8s of compile
// time, so the merged path is well ahead without it. VIBE_MD_NO_MERGE=1
// restores the per-block compile.

fn merge_disabled() -> Bool with Env {
  String::trim(Env::get("VIBE_MD_NO_MERGE")) == "1"
}

/// True when `line` is the top-level declaration head of a Unit-returning
/// `main` (`fn main {`, `fn main with Stdout {`). A `->` on the line means a
/// declared return type: `_start` prints such an entry's Int via print_int,
/// while the merged `test {}` wrapper would drop it, so those blocks stay on
/// the standalone path rather than silently losing a line of output.
fn is_unit_main_head(line: String) -> Bool {
  if !String::starts_with(line, "fn main") {
    false
  } else if String::contains(line, "->") {
    false
  } else {
    let rest = String::trim(String::substring(line, 7, String::length(line)))
    String::starts_with(rest, "{") || String::starts_with(rest, "with")
  }
}

/// Index of the block's Unit-`main` declaration line, or -1.
fn block_unit_main_line(blk: Block) -> Int {
  let n = Array::length(blk.code_lines)
  let mut i = 0
  let mut found = 0 - 1
  while i < n {
    if found < 0 && is_unit_main_head(Array::get(blk.code_lines, i)) {
      found = i
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn block_mergeable(blk: Block) -> Bool {
  blk.mode == "run" && !String::contains(blk.open_line, "standalone") && block_unit_main_line(blk) >= 0
}

/// The block's own source with its `main` exported, so the merged driver can
/// import it. Nothing else about the block is rewritten.
fn block_source_exported(blk: Block) -> String {
  let idx = block_unit_main_line(blk)
  let n = Array::length(blk.code_lines)
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < n {
    let line = Array::get(blk.code_lines, i)
    if i == idx {
      ArrayBuilder::push(b, "export \{line}")
    } else {
      ArrayBuilder::push(b, line)
    }
    i = i + 1
  }
  join_lines(ArrayBuilder::freeze(b))
}

fn merge_test_name(block_no: Int) -> String {
  "b\{pad2(block_no)}"
}

fn merge_src_path(md_dir: String, base: String, block_no: Int) -> String {
  "\{md_dir}/.vibe_md_merge_\{base}_\{merge_test_name(block_no)}.vibe"
}

fn merge_driver_path(md_dir: String, base: String) -> String {
  "\{md_dir}/.vibe_md_merge_\{base}.vibe"
}

fn merge_wasm_path(md_dir: String, base: String) -> String {
  "\{md_dir}/.vibe_md_merge_\{base}.wasm"
}

/// Writes one .vibe per mergeable block plus the driver that imports them all
/// and wraps each in a `test {}` block (which codegen turns into an exported
/// `__test_<name>`).
fn write_merged_sources(md_dir: String, base: String, blocks: Array[Block], nos: Array[Int]) -> Unit with Fs {
  let k = Array::length(nos)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < k {
    let no = Array::get(nos, i)
    let name = merge_test_name(no)
    Fs::write_file(merge_src_path(md_dir, base, no), block_source_exported(Array::get(blocks, i)))
    StringBuilder::push(sb, "import ./.vibe_md_merge_\{base}_\{name}.vibe {\n  main as \{name}_main\n}\n")
    i = i + 1
  }
  StringBuilder::push(sb, "\n")
  let mut j = 0
  while j < k {
    let name = merge_test_name(Array::get(nos, j))
    StringBuilder::push(sb, "test \"\{name}\" {\n  \{name}_main()\n}\n\n")
    j = j + 1
  }
  Fs::write_file(merge_driver_path(md_dir, base), StringBuilder::freeze(sb))
}

/// One compile for the whole file. Returns false on any failure, in which
/// case every block falls back to its own standalone compile -- a merged
/// compile error names the merged driver, not the offending block, so the
/// fallback is also how a real error gets attributed.
fn compile_merged(cwd: String, compiler: String, md_dir: String, base: String) -> Bool with Process + Env + Fs {
  let src = merge_driver_path(md_dir, base)
  let out = merge_wasm_path(md_dir, base)
  let timeout_secs = md_timeout_secs()
  let cmd = "timeout \{timeout_secs} env VIBE_PREOPEN_DIR=\{shq(cwd)} VIBE_FS_COMPILE=1 VIBE_IMPORT_ABI=raw bash scripts/run_wasm_vibe_host_runner.sh --invoke cli_main \{shq(compiler)} \{shq(src)} \{shq(out)} '__no_entry__'"
  let cr = sh_capture(cmd)
  cr.exit_code == 0 && file_nonempty(out)
}

fn run_merged_block(cwd: String, md_path: String, md_dir: String, base: String, blk: Block, block_no: Int, mode: String) -> BlockResult with Fs + Process + Env {
  let label = "\{md_path}:\{blk.start_line}"
  let timeout_secs = md_timeout_secs()
  let target = "__test_\{merge_test_name(block_no)}"
  let run_cmd = "timeout \{timeout_secs} env VIBE_PREOPEN_DIR=\{shq(cwd)} bash scripts/run_wasm_vibe_host_runner.sh --invoke \{shq(target)} \{shq(merge_wasm_path(md_dir, base))}"
  let rr = sh_capture(run_cmd)
  if rr.exit_code != 0 {
    let reason = if rr.exit_code == 124 {
      "timeout after \{timeout_secs}s"
    } else {
      first_nonblank_line(rr.stderr)
    }
    let shown = if reason == "" {
      "runtime failure"
    } else {
      reason
    }
    BlockResult::{ label: label, status: "FAIL", reason: "[run] \{shown}" }
  } else {
    blk.has_actual_stdout = true
    blk.actual_stdout = normalize_trailing_newline(rr.stdout)
    if mode == "write" {
      BlockResult::{ label: label, status: "WROTE", reason: "" }
    } else {
      BlockResult::{ label: label, status: "PENDING_OUTPUT_CHECK", reason: "" }
    }
  }
}

fn cleanup_merged(md_dir: String, base: String, nos: Array[Int]) -> Unit with Fs {
  let k = Array::length(nos)
  let mut i = 0
  while i < k {
    let p = merge_src_path(md_dir, base, Array::get(nos, i))
    if Fs::exists(p) {
      Fs::remove(p)
    } else {
      ()
    }
    i = i + 1
  }
  let out = merge_wasm_path(md_dir, base)
  cleanup_one(merge_driver_path(md_dir, base), out, "\{out}.diag")
}

// ---------- top-level per-file processing ----------

struct FileOutcome {
  tokens: Array[Token];
  results: Array[BlockResult]
}

fn dirname(path: String) -> String {
  let idx = String::last_index_of(path, "/")
  if idx < 0 {
    "."
  } else {
    String::substring(path, 0, idx)
  }
}

fn basename_no_ext(path: String) -> String {
  let slash = String::last_index_of(path, "/")
  let name = if slash < 0 {
    path
  } else {
    String::substring(path, slash + 1, String::length(path))
  }
  let dot = String::last_index_of(name, ".")
  if dot < 0 {
    name
  } else {
    String::substring(name, 0, dot)
  }
}

fn process_file(md_path: String, cwd: String, compiler: String, mode: String) -> FileOutcome with Fs + Process + Error + Env {
  let text = Fs::read_file(md_path)
  let tokens = parse_blocks(text)
  link_run_output_pairs(tokens)
  let md_dir = dirname(md_path)
  let base = sanitize_base(basename_no_ext(md_path))
  let results = ArrayBuilder::new()
  let n = Array::length(tokens)
  // #819 pass 1: which blocks join the merged module. Two or more, otherwise
  // merging costs an extra driver compile to save nothing.
  let mb = ArrayBuilder::new()
  let mn = ArrayBuilder::new()
  let mut p1 = 0
  let mut p1_no = 0
  while p1 < n {
    match Array::get(tokens, p1) {
      TBlock(blk) => if blk.mode == "check" || blk.mode == "run" || blk.mode == "skip" {
        p1_no = p1_no + 1
        if block_mergeable(blk) {
          ArrayBuilder::push(mb, blk)
          ArrayBuilder::push(mn, p1_no)
        } else {
          ()
        }
      } else {
        ()
      },
      TText(_) => ()
    }
    p1 = p1 + 1
  }
  let merged_blocks = ArrayBuilder::freeze(mb)
  let merged_nos = ArrayBuilder::freeze(mn)
  let merged_ok = if Array::length(merged_nos) >= 2 && !merge_disabled() {
    write_merged_sources(md_dir, base, merged_blocks, merged_nos)
    compile_merged(cwd, compiler, md_dir, base)
  } else {
    false
  }
  let mut i = 0
  let mut block_no = 0
  while i < n {
    match Array::get(tokens, i) {
      TBlock(blk) => {
        if blk.mode == "check" || blk.mode == "run" || blk.mode == "skip" {
          block_no = block_no + 1
          let scratch_name = ".vibe_md_scratch_\{base}_b\{pad2(block_no)}_L\{blk.start_line}"
          let r = if merged_ok && array_contains_int(merged_nos, block_no) {
            run_merged_block(cwd, md_path, md_dir, base, blk, block_no, mode)
          } else {
            run_one_block(cwd, compiler, md_path, md_dir, scratch_name, blk, mode)
          }
          if r.status == "PENDING_OUTPUT_CHECK" {
            let expected_opt = if blk.paired_output >= 0 {
              match Array::get(tokens, blk.paired_output) {
                TBlock(ob) => Some(join_lines(ob.code_lines)),
                TText(_) => None
              }
            } else {
              None
            }
            match expected_opt {
              None => ArrayBuilder::push(results, BlockResult::{ label: r.label, status: "FAIL", reason: "[output] missing ```output block after ```vibe run (run `write` mode to generate it)" }),
              Some(expected) => {
                if expected == blk.actual_stdout {
                  ArrayBuilder::push(results, BlockResult::{ label: r.label, status: "PASS", reason: r.reason })
                } else {
                  ArrayBuilder::push(results, BlockResult::{ label: r.label, status: "FAIL", reason: "[output] embedded output is stale\n--- expected (```output) ---\n\{expected}--- actual (stdout) ---\n\{blk.actual_stdout}" })
                }
              }
            }
          } else {
            ArrayBuilder::push(results, r)
          }
        } else {
          ()
        }
      },
      TText(_) => ()
    }
    i = i + 1
  }
  cleanup_merged(md_dir, base, merged_nos)
  FileOutcome::{ tokens: tokens, results: ArrayBuilder::freeze(results) }
}

// fmt/fmt-check counterpart of process_file: no compiler wasm, no
// execution, no ```output pairing -- just every vibe-source block
// (check/run/skip) through run_fmt_block.
fn process_file_fmt(md_path: String, mode: String) -> FileOutcome with Fs + Process + Error + Env {
  let text = Fs::read_file(md_path)
  let tokens = parse_blocks(text)
  let md_dir = dirname(md_path)
  let base = sanitize_base(basename_no_ext(md_path))
  let results = ArrayBuilder::new()
  let n = Array::length(tokens)
  let mut i = 0
  let mut block_no = 0
  while i < n {
    match Array::get(tokens, i) {
      TBlock(blk) => {
        if blk.mode == "check" || blk.mode == "run" || blk.mode == "skip" {
          block_no = block_no + 1
          let scratch_name = ".vibe_md_scratch_\{base}_b\{pad2(block_no)}_L\{blk.start_line}"
          let r = run_fmt_block(md_path, md_dir, scratch_name, blk, mode)
          ArrayBuilder::push(results, r)
        } else {
          ()
        }
      },
      TText(_) => ()
    }
    i = i + 1
  }
  FileOutcome::{ tokens: tokens, results: ArrayBuilder::freeze(results) }
}

// A ```output block paired to a run block gets its content replaced IN
// PLACE at its own token position (rather than re-emitted inline from the
// run block's branch) -- reordering would separate it from the blank line
// that used to precede it. The run block (always earlier in document
// order) stashes the new content on its paired output block's
// `replacement_lines` mut field; by the time this loop reaches that output
// token, the replacement is already there (mirrors scripts/vibe_md.py's
// `_replacement` attribute trick).
fn stage_replacements(tokens: Array[Token]) -> Unit {
  let n = Array::length(tokens)
  let mut i = 0
  while i < n {
    match Array::get(tokens, i) {
      TBlock(blk) => {
        if blk.mode == "run" && blk.has_actual_stdout {
          if blk.paired_output >= 0 {
            match Array::get(tokens, blk.paired_output) {
              TBlock(ob) => {
                ob.has_replacement = true
                ob.replacement_lines = splitlines_like(blk.actual_stdout)
              },
              TText(_) => ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
      },
      TText(_) => ()
    }
    i = i + 1
  }
}

fn rewrite_text(tokens: Array[Token]) -> String {
  stage_replacements(tokens)
  let out = ArrayBuilder::new()
  let n = Array::length(tokens)
  let mut i = 0
  while i < n {
    match Array::get(tokens, i) {
      TText(l) => ArrayBuilder::push(out, l),
      TBlock(blk) => {
        if blk.mode == "output" && blk.has_replacement {
          ArrayBuilder::push(out, blk.open_line)
          push_all(out, blk.replacement_lines)
          ArrayBuilder::push(out, blk.close_line)
        } else {
          let code_out = if blk.has_fmt_replacement {
            blk.fmt_lines
          } else {
            blk.code_lines
          }
          ArrayBuilder::push(out, blk.open_line)
          push_all(out, code_out)
          ArrayBuilder::push(out, blk.close_line)
          if blk.mode == "run" && blk.has_actual_stdout && blk.paired_output < 0 {
            ArrayBuilder::push(out, "")
            ArrayBuilder::push(out, "```output")
            push_all(out, splitlines_like(blk.actual_stdout))
            ArrayBuilder::push(out, "```")
          } else {
            ()
          }
        }
      }
    }
    i = i + 1
  }
  String::concat(String::join(ArrayBuilder::freeze(out), "\n"), "\n")
}

fn push_all[T](b: ArrayBuilder[T], items: Array[T]) -> Unit {
  let n = Array::length(items)
  let mut i = 0
  while i < n {
    ArrayBuilder::push(b, Array::get(items, i))
    i = i + 1
  }
}

// ---------- entry ----------

fn report(results: Array[BlockResult], mode: String) -> Int with Stdout {
  let n = Array::length(results)
  let mut i = 0
  let mut fail = 0
  let mut skip = 0
  while i < n {
    let r = Array::get(results, i)
    if r.status == "SKIP" {
      skip = skip + 1
      Stdout::write_stream("SKIP  \{r.label}\n")
    } else if r.status == "FAIL" {
      fail = fail + 1
      Stdout::write_stream("FAIL  \{r.label} \{r.reason}\n")
    } else if r.status == "WROTE" {
      Stdout::write_stream("WROTE \{r.label}\{r.reason}\n")
    } else {
      // #819: r.reason carries " (cached)" here when run_one_block served
      // this block's stdout from the doctest content-addressed cache
      // instead of re-executing it.
      Stdout::write_stream("PASS  \{r.label}\{r.reason}\n")
    }
    i = i + 1
  }
  Stdout::write_stream("\nvibe_md: \{n} blocks -- \{n - fail - skip} pass, \{fail} fail, \{skip} skip\n")
  fail
}

// fmt/fmt-check need no compiler wasm at all (scripts/vibe_fmt.sh always
// builds its formatter entry from the committed seed) -- kept as a separate
// entry point from run_mode rather than threading an unused `compiler`
// resolution through the check/write path.
fn run_mode_fmt(mode: String, files: Array[String]) -> Int with Fs + Env + Process + Stdout + Stderr {
  Stdout::write_stream("vibe_md: mode=\{mode}\n")
  let all_results = ArrayBuilder::new()
  let mut i = 0
  let mut hard_fail = -1
  while i < Array::length(files) && hard_fail < 0 {
    let md_path = Array::get(files, i)
    if !Fs::exists(md_path) {
      Stderr::write_stream("vibe_md: no such file: \{md_path}\n")
      hard_fail = 2
    } else {
      handle {
        let outcome = process_file_fmt(md_path, mode)
        if mode == "fmt" {
          Fs::write_file(md_path, rewrite_text(outcome.tokens))
        } else {
          ()
        }
        push_all(all_results, outcome.results)
      } with Error {
        Throw(msg) => {
          Stderr::write_stream("vibe_md: \{md_path}: \{msg}\n")
          hard_fail = 2
        }
      }
    }
    i = i + 1
  }
  if hard_fail >= 0 {
    hard_fail
  } else {
    let fail_count = report(ArrayBuilder::freeze(all_results), mode)
    if fail_count > 0 {
      1
    } else {
      0
    }
  }
}

fn run_mode(mode: String, files: Array[String]) -> Int with Fs + Env + Process + Stdout + Stderr {
  let cwd = Fs::getcwd()
  let compiler = resolve_stage2()
  if !file_nonempty(compiler) {
    Stderr::write_stream("vibe_md: compiler wasm not found: \{compiler}\n")
    2
  } else {
    Stdout::write_stream("vibe_md: mode=\{mode} compiler=\{compiler}\n")
    let all_results = ArrayBuilder::new()
    let mut i = 0
    let mut hard_fail = -1
    while i < Array::length(files) && hard_fail < 0 {
      let md_path = Array::get(files, i)
      if !Fs::exists(md_path) {
        Stderr::write_stream("vibe_md: no such file: \{md_path}\n")
        hard_fail = 2
      } else {
        handle {
          let outcome = process_file(md_path, cwd, compiler, mode)
          if mode == "write" {
            Fs::write_file(md_path, rewrite_text(outcome.tokens))
          } else {
            ()
          }
          push_all(all_results, outcome.results)
        } with Error {
          Throw(msg) => {
            Stderr::write_stream("vibe_md: \{md_path}: \{msg}\n")
            hard_fail = 2
          }
        }
      }
      i = i + 1
    }
    if hard_fail >= 0 {
      hard_fail
    } else {
      let fail_count = report(ArrayBuilder::freeze(all_results), mode)
      if fail_count > 0 {
        1
      } else {
        0
      }
    }
  }
}

fn usage() -> String {
  "usage: vibe run scripts/vibe_md.vibex -- (check|write|fmt|fmt-check) <file.vibe.md>...\n"
}

fn is_known_mode(mode: String) -> Bool {
  mode == "check" || mode == "write" || mode == "fmt" || mode == "fmt-check"
}

fn main with Fs + Env + Process + Stdout + Stderr {
  let argc = Env::args_len()
  let code = if argc < 2 {
    Stderr::write_stream(usage())
    2
  } else {
    let mode = Env::args_get(0)
    if !is_known_mode(mode) {
      Stderr::write_stream(usage())
      2
    } else {
      let files = ArrayBuilder::new()
      let mut i = 1
      while i < argc {
        ArrayBuilder::push(files, Env::args_get(i))
        i = i + 1
      }
      if mode == "fmt" || mode == "fmt-check" {
        run_mode_fmt(mode, ArrayBuilder::freeze(files))
      } else {
        run_mode(mode, ArrayBuilder::freeze(files))
      }
    }
  }
  if code != 0 {
    vibe_process_exit_raw(code)
  } else {
    ()
  }
}
