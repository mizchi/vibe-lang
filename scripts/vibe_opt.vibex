// vibe-opt — standalone wasm size optimizer entry (#1107 Phase 2).
//
// The in-house optimizer (lib/@vibe/optimizer, docs/wasm-opt-dogfood.md) is
// deliberately NOT linked into the compiler: coupling it in costs ~700KB of
// compiler size and the frozen bootstrap seed cannot self-compile the pair
// (the known ADR-0070 constraint). Instead this file is the root of an
// INDEPENDENT artifact, `vibe-opt.wasm`, built by scripts/build_vibe_opt.sh
// and invoked by `vibe build --minify` (runtime/vibe) as a post-processing
// step over an already-compiled executable.
//
// Usage (as a wasm program under the node host runner or vibewt):
//   vibe-opt <input.wasm> <output.wasm>
//
// Reads the module, runs minify_converge (true DCE with renumbering, constant
// folding, single-call-site inlining, table/global/tag DCE — every pass is a
// pure Bytes -> Bytes transform), writes the result, and reports the size
// delta to stdout. Exit codes: 0 ok, 2 usage error, 1 read/size failure.
// A minified output LARGER than the input never happens (converge keeps the
// smaller of before/after each pass), but the guard below keeps the artifact
// honest if a pass regresses: on any anomaly the INPUT bytes are written
// through unchanged so a broken optimizer can never corrupt a build.

// #1109-1: `--single-round` runs ONE minify round instead of converging
// in-process. The optimizer allocates through the bump allocator and never
// frees, so 16 converge rounds over a 1.4MB module exhaust wasm memory —
// scripts/minify_wasm.sh loops single-round invocations instead (each run is
// a fresh instance, so memory resets between rounds). `--keep-exports a,b,c`
// filters the export section down to the named entries FIRST, so a library
// build (e.g. the vibec core, where every sibling export roots its own call
// graph) can be DCE'd down to one entry point's reachable set.
import @vibe/optimizer {
  filter_exports, minify, minify_converge
}

fn collect_args() -> Array[String] with { Env } {
  let out = Array::slice([
    ""
  ], 0, 0)
  let argc = Env::args_len()
  let mut i = 0
  while i < argc {
    Array::push(out, Env::args_get(i))
    i = i + 1
  }
  out
}

// Both hosts (vibewt and the node runner) exclude the program path from
// Env::args_get — index 0 is already the first user argument.
fn user_arg(args: Array[String], index: Int) -> String {
  if index < Array::length(args) {
    args[index]
  } else {
    ""
  }
}

fn run_opt(input_path: String, output_path: String, single_round: Bool, keep_exports: String) -> Int with { Fs, Stdout, Stderr } {
  let input = Fs::read_bytes(input_path)
  let before = Bytes::length(input)
  if before == 0 {
    Stderr::write_stream("vibe-opt: empty or unreadable input: \{input_path}\n")
    1
  }
  else {
    let filtered = if keep_exports == "" {
      input
    } else {
      filter_exports(input, String::split(keep_exports, ","))
    }
    let minified = if single_round {
      minify(filtered)
    } else {
      minify_converge(filtered)
    }
    let after = Bytes::length(minified)
    // Anomaly guard: never emit something bigger than the (filtered) input
    // or an obviously-truncated module (below the 8-byte wasm header).
    let out_bytes = if after >= 8 && after <= Bytes::length(filtered) {
      minified
    } else {
      filtered
    }
    Fs::write_bytes(output_path, out_bytes)
    let written = Bytes::length(out_bytes)
    Stdout::write_stream("vibe-opt: \{input_path} \{before}B -> \{output_path} \{written}B\n")
    0
  }
}

fn main with { Fs, Env, Process, Stdout, Stderr } {
  let args = collect_args()
  let mut input_path = ""
  let mut output_path = ""
  let mut single_round = false
  let mut keep_exports = ""
  let argc = Array::length(args)
  let mut ai = 0
  while ai < argc {
    let a = args[ai]
    if a == "--single-round" {
      single_round = true
    } else if a == "--keep-exports" && ai + 1 < argc {
      keep_exports = args[ai + 1]
      ai = ai + 1
    } else if input_path == "" {
      input_path = a
    } else if output_path == "" {
      output_path = a
    } else {
      ()
    }
    ai = ai + 1
  }
  let code = if input_path == "" || output_path == "" {
    Stderr::write_stream("usage: vibe-opt [--single-round] [--keep-exports a,b,c] <input.wasm> <output.wasm>\n")
    2
  }
  else {
    run_opt(input_path, output_path, single_round, keep_exports)
  }
  if code != 0 {
    vibe_process_exit_raw(code)
  } else {
    ()
  }
}
