// vibe-opt — standalone wasm size optimizer entry (#1107 Phase 2).
//
// The in-house optimizer (lib/@vibe/optimizer, docs/wasm-opt-dogfood.md) is
// deliberately NOT linked into the compiler: coupling it in costs ~700KB of
// compiler size and the frozen bootstrap seed cannot self-compile the pair
// (the known ADR-0070 constraint). Instead this file is the root of an
// INDEPENDENT artifact, `vibe-opt.wasm`, built by scripts/build_vibe_opt.sh
// and invoked by `vibe build --minify` (runtime/vibe) as a post-processing
// step over an already-compiled executable.
//
// Usage (as a wasm program under the node host runner or viberun):
//   vibe-opt <input.wasm> <output.wasm>
//
// Reads the module, runs minify_converge (true DCE with renumbering, constant
// folding, single-call-site inlining, table/global/tag DCE — every pass is a
// pure Bytes -> Bytes transform), writes the result, and reports the size
// delta to stdout. Exit codes: 0 ok, 2 usage error, 1 read/size failure.
// A minified output LARGER than the input never happens (converge keeps the
// smaller of before/after each pass), but the guard below keeps the artifact
// honest if a pass regresses: on any anomaly the INPUT bytes are written
// through unchanged so a broken optimizer can never corrupt a build.

// #1109-1: `--single-round` runs ONE minify round instead of converging
// in-process. The optimizer allocates through the bump allocator and never
// frees, so 16 converge rounds over a 1.4MB module exhaust wasm memory —
// scripts/minify_wasm.sh loops single-round invocations instead (each run is
// a fresh instance, so memory resets between rounds). `--keep-exports a,b,c`
// filters the export section down to the named entries FIRST, so a library
// build (e.g. the vibec core, where every sibling export roots its own call
// graph) can be DCE'd down to one entry point's reachable set.
import @vibe/optimizer {
  call_forwarding, coalesce_locals, dce, dce_remove, directize,
  drop_unused_globals, drop_unused_tables, drop_unused_tags,
  eliminate_dead_stores, filter_exports, fold_table_size, inline_calls,
  inline_empty_calls, minify, minify_converge, optimize_code_section,
  propagate_local_copies, remove_dead_blocks, remove_empty_sections,
  remove_unused_types, strip_custom_sections, binary_size
}

// #1109: run exactly ONE named pass (minify's pipeline order) so the driver
// can put each pass in its own process — a full round over a 4.9MB module
// exhausts the 4GB wasm address space under the bump allocator, but any
// single pass fits comfortably. "dce_auto" replicates minify's size-guarded
// choice between dce_remove (physical removal) and dce (stubbing).
// Unknown names return the input unchanged (the driver treats that as a
// hard error by name-checking first).
fn run_single_pass(input: Bytes, pass: String) -> Bytes {
  if pass == "strip_custom_sections" {
    strip_custom_sections(input)
  } else if pass == "directize" {
    directize(input)
  } else if pass == "call_forwarding" {
    call_forwarding(input)
  } else if pass == "fold_table_size" {
    fold_table_size(input)
  } else if pass == "eliminate_dead_stores" {
    eliminate_dead_stores(input)
  } else if pass == "optimize_code_section" {
    optimize_code_section(input)
  } else if pass == "inline_empty_calls" {
    inline_empty_calls(input)
  } else if pass == "inline_calls" {
    inline_calls(input)
  } else if pass == "remove_dead_blocks" {
    remove_dead_blocks(input)
  } else if pass == "drop_unused_tables" {
    drop_unused_tables(input)
  } else if pass == "dce_auto" {
    let removed = dce_remove(input)
    if binary_size(removed) < binary_size(input) {
      removed
    } else {
      dce(input)
    }
  } else if pass == "drop_unused_globals" {
    drop_unused_globals(input)
  } else if pass == "drop_unused_tags" {
    drop_unused_tags(input)
  } else if pass == "propagate_local_copies" {
    propagate_local_copies(input)
  } else if pass == "coalesce_locals" {
    coalesce_locals(input)
  } else if pass == "remove_unused_types" {
    remove_unused_types(input)
  } else if pass == "remove_empty_sections" {
    remove_empty_sections(input)
  } else {
    input
  }
}

fn collect_args() -> Array[String] with { Env } {
  let out = Array::slice([
    ""
  ], 0, 0)
  let argc = Env::args_len()
  let mut i = 0
  while i < argc {
    Array::push(out, Env::args_get(i))
    i = i + 1
  }
  out
}

// Both hosts (viberun and the node runner) exclude the program path from
// Env::args_get — index 0 is already the first user argument.
fn user_arg(args: Array[String], index: Int) -> String {
  if index < Array::length(args) {
    args[index]
  } else {
    ""
  }
}

fn run_opt(input_path: String, output_path: String, single_round: Bool, keep_exports: String, pass: String) -> Int with { Fs, Stdout, Stderr } {
  let input = Fs::read_bytes(input_path)
  let before = Bytes::length(input)
  if before == 0 {
    Stderr::write_stream("vibe-opt: empty or unreadable input: \{input_path}\n")
    1
  }
  else {
    let filtered = if keep_exports == "" {
      input
    } else {
      filter_exports(input, String::split(keep_exports, ","))
    }
    let minified = if pass != "" {
      run_single_pass(filtered, pass)
    } else if single_round {
      minify(filtered)
    } else {
      minify_converge(filtered)
    }
    let after = Bytes::length(minified)
    // Anomaly guard: never emit an obviously-truncated module (below the
    // 8-byte wasm header). Whole-pipeline modes additionally reject growth;
    // --pass mode must NOT (a single pass may legitimately grow — e.g.
    // inline_calls before the DCE that pays it off — and the DRIVER compares
    // sizes per ROUND, not per pass).
    let grew_ok = pass != ""
    let out_bytes = if after >= 8 && (grew_ok || after <= Bytes::length(filtered)) {
      minified
    } else {
      filtered
    }
    Fs::write_bytes(output_path, out_bytes)
    let written = Bytes::length(out_bytes)
    Stdout::write_stream("vibe-opt: \{input_path} \{before}B -> \{output_path} \{written}B\n")
    0
  }
}

fn main with { Fs, Env, Process, Stdout, Stderr } {
  let args = collect_args()
  let mut input_path = ""
  let mut output_path = ""
  let mut single_round = false
  let mut keep_exports = ""
  let mut pass = ""
  let argc = Array::length(args)
  let mut ai = 0
  while ai < argc {
    let a = args[ai]
    if a == "--single-round" {
      single_round = true
    } else if a == "--keep-exports" && ai + 1 < argc {
      keep_exports = args[ai + 1]
      ai = ai + 1
    } else if a == "--pass" && ai + 1 < argc {
      pass = args[ai + 1]
      ai = ai + 1
    } else if input_path == "" {
      input_path = a
    } else if output_path == "" {
      output_path = a
    } else {
      ()
    }
    ai = ai + 1
  }
  let code = if input_path == "" || output_path == "" {
    Stderr::write_stream("usage: vibe-opt [--single-round] [--pass <name>] [--keep-exports a,b,c] <input.wasm> <output.wasm>\n")
    2
  }
  else {
    run_opt(input_path, output_path, single_round, keep_exports, pass)
  }
  if code != 0 {
    vibe_process_exit_raw(code)
  } else {
    ()
  }
}
