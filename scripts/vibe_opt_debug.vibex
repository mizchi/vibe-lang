// Debug helper for lib/@vibe/optimizer (#1107 Phase 2): apply the minify
// pipeline one pass at a time, writing each intermediate module to
// <prefix>.NN.wasm so a shell loop can find the first stage whose output
// stops validating / running correctly. Not part of any gate — a bisection
// tool kept next to vibe_opt.vibex for optimizer debugging.
//
// Usage: vibe-opt-debug <input.wasm> <out_prefix>

import @vibe/optimizer {
  binary_size,
  call_forwarding,
  coalesce_locals,
  dce,
  dce_remove,
  directize,
  drop_unused_globals,
  drop_unused_tables,
  drop_unused_tags,
  eliminate_dead_stores,
  fold_table_size,
  inline_calls,
  inline_empty_calls,
  optimize_code_section,
  propagate_local_copies,
  remove_dead_blocks,
  remove_empty_sections,
  remove_unused_types,
  strip_custom_sections
}

fn collect_args() -> Array[String] with Env {
  let out = Array::slice([""], start = 0, end = 0)
  let argc = Env::args_len()
  let mut i = 0
  while i < argc {
    Array::push(out, value = Env::args_get(i))
    i = i + 1
  }
  out
}

fn write_stage(prefix: String, idx: Int, name: String, bytes: Bytes) -> Unit with Fs + Console {
  let path = "\{prefix}.\{idx}.wasm"
  Fs::write_bytes(path, bytes = bytes)
  Console::write_stream("stage \{idx} \{name}: \{Bytes::length(bytes)}B -> \{path}\n")
}

fn main allows Fs + Env + Console {
  let args = collect_args()
  if Array::length(args) < 2 {
    Stderr::write_stream("usage: vibe-opt-debug <input.wasm> <out_prefix>\n")
  }
  else {
    let input = Fs::read_bytes(args[0])
    let prefix = args[1]
    let s1 = strip_custom_sections(input)
    write_stage(prefix = prefix, idx = 1, name = "strip_custom_sections", bytes = s1)
    let s2 = directize(s1)
    write_stage(prefix = prefix, idx = 2, name = "directize", bytes = s2)
    let s3 = call_forwarding(s2)
    write_stage(prefix = prefix, idx = 3, name = "call_forwarding", bytes = s3)
    let s3t = fold_table_size(s3)
    write_stage(prefix = prefix, idx = 4, name = "fold_table_size", bytes = s3t)
    let s3d = eliminate_dead_stores(s3t)
    write_stage(prefix = prefix, idx = 5, name = "eliminate_dead_stores", bytes = s3d)
    let s4a = optimize_code_section(s3d)
    write_stage(prefix = prefix, idx = 6, name = "optimize_code_section", bytes = s4a)
    let s4b = inline_empty_calls(s4a)
    write_stage(prefix = prefix, idx = 7, name = "inline_empty_calls", bytes = s4b)
    let s4c = inline_calls(s4b)
    write_stage(prefix = prefix, idx = 8, name = "inline_calls", bytes = s4c)
    let s4d = remove_dead_blocks(s4c)
    write_stage(prefix = prefix, idx = 9, name = "remove_dead_blocks", bytes = s4d)
    let s4 = drop_unused_tables(s4d)
    write_stage(prefix = prefix, idx = 10, name = "drop_unused_tables", bytes = s4)
    // The same size guard as `minify`: keep physical removal only when it
    // shrinks the module, else fall back to `dce`. A stage the real pipeline
    // would discard must not be the one a bisection blames.
    let s5_removed = dce_remove(s4)
    let keep_removed = binary_size(s5_removed) < binary_size(s4)
    let s5 = if keep_removed {
      s5_removed
    } else {
      dce(s4)
    }
    let s5_name = if keep_removed {
      "dce_remove"
    } else {
      "dce"
    }
    write_stage(prefix = prefix, idx = 11, name = s5_name, bytes = s5)
    let s5g = drop_unused_globals(s5)
    write_stage(prefix = prefix, idx = 12, name = "drop_unused_globals", bytes = s5g)
    let s5t = drop_unused_tags(s5g)
    write_stage(prefix = prefix, idx = 13, name = "drop_unused_tags", bytes = s5t)
    let s5p = propagate_local_copies(s5t)
    write_stage(prefix = prefix, idx = 14, name = "propagate_local_copies", bytes = s5p)
    let s6 = coalesce_locals(s5p)
    write_stage(prefix = prefix, idx = 15, name = "coalesce_locals", bytes = s6)
    let s7 = remove_unused_types(s6)
    write_stage(prefix = prefix, idx = 16, name = "remove_unused_types", bytes = s7)
    let s8 = remove_empty_sections(s7)
    write_stage(prefix = prefix, idx = 17, name = "remove_empty_sections", bytes = s8)
  }
}
