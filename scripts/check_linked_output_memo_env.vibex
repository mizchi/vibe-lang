// The linked-output memo replays a compiled module when the compile's whole
// input identity matches (#2825,
// lib/@vibe/compiler/entry/compiler/file_compile/linked_output_memo.vibe). An
// environment variable that changes the output but is missing from the key
// would replay a module built for another setting -- silently wrong, which is
// the worst way this project can break. So the key's variable list is checked,
// not trusted:
//
//   bash scripts/vibe_run.sh scripts/check_linked_output_memo_env.vibex -- [--root DIR] [--memo FILE]
//
// Every variable NAME the compiler's code mentions -- a `"VIBE_..."` string
// literal anywhere outside a comment line, or the literal argument of
// `Env::get` / `read_env` -- has
// to be in `linked_output_memo_env_names` (part of the key) or in
// `linked_output_memo_env_exempt` (with a reason the value cannot reach the
// module), and in exactly one of them. A name in neither fails the gate, named
// with a file that mentions it.
//
// Scanned: every `.vibe` / `.vpkg` under `<root>/lib/@vibe`, except the
// generated bundles (copies of the same sources) and test / bench files, which
// no compile runs. A name built at run time by concatenation is invisible to a
// scan, so the scan also fails on a `"VIBE_` literal that ends right after the
// prefix's underscore -- that is the only shape such a construction can take
// -- unless it is followed by `*` (a glob in a message).
//
// --root DIR scans another tree, and --memo FILE reads the lists from another
// file (the self-test's).

import @vibe/builtin {
  String::index_of_from
}
import @vibe/process {
  exit
}
import @vibex/shell {
  find, sort_str
}

fn option(name: String, fallback: String) -> String with Env {
  let mut out = fallback
  let mut i = 0
  while i + 1 < Env::args_len() {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn under(root: String, rel: String) -> String {
  if root == "." {
    rel
  } else {
    "\{root}/\{rel}"
  }
}

fn is_name_char(c: Char) -> Bool {
  (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn is_generated(path: String) -> Bool {
  String::ends_with(path, "/compiler_sources_bundle.vibe") || String::ends_with(path, "/cli_adapter_bundle.vibe") || String::ends_with(path, "/selfbuild_runtime_entry_bundle.vibe") || String::ends_with(path, "/_cli_adapter_module_source.vibe")
}

fn is_test_or_bench(path: String) -> Bool {
  String::contains(path, "/tests/") || String::ends_with(path, "_test.vibe") || String::ends_with(path, "_bench.vibe")
}

/// The name that starts at `at`, the longest run of name characters.
fn name_at(text: String, at: Int) -> String {
  let mut k = at
  while k < String::length(text) && is_name_char(String::byte_at(text, k)) {
    k = k + 1
  }
  String::substring(text, at, k)
}

/// `"NAME"` right after `prefix` (an `Env::get(` or `read_env(` call), each
/// occurrence. `name = ` labels the argument in the labeled-call spelling.
fn literal_args_after(text: String, prefix: String, out: Array[String]) -> Unit {
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, prefix, from)
    if at < 0 {
      going = false
    } else {
      let mut k = at + String::length(prefix)
      if String::starts_with(String::substring(text, k, String::length(text)), "name = ") {
        k = k + 7
      } else {
        ()
      }
      if k < String::length(text) && String::byte_at(text, k) == '"' {
        let name = name_at(text, k + 1)
        if name != "" && k + 1 + String::length(name) < String::length(text) && String::byte_at(text, k + 1 + String::length(name)) == '"' {
          Array::push(out, name)
        } else {
          ()
        }
      } else {
        ()
      }
      from = at + 1
    }
  }
}

/// Every `"VIBE_...` literal's name, and every bare `"VIBE_` prefix (a name
/// assembled at run time), which is pushed to `prefixes`.
fn vibe_literals(text: String, out: Array[String], prefixes: Array[String]) -> Unit {
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, "\"VIBE_", from)
    if at < 0 {
      going = false
    } else {
      let name = name_at(text, at + 1)
      let after = at + 1 + String::length(name)
      let next = if after < String::length(text) {
        String::byte_at(text, after)
      } else {
        ' '
      }
      if String::ends_with(name, "_") && next == '"' {
        Array::push(prefixes, name)
      } else if String::ends_with(name, "_") && next == '*' {
        ()
      } else {
        Array::push(out, name)
      }
      from = at + 1
    }
  }
}

/// The string literals between the line that opens `fn <fname>()` and the
/// next line that is only `]`.
fn listed(memo_text: String, fname: String) -> Array[String] {
  let out: Array[String] = []
  let lines = String::split(memo_text, "\n")
  let mut inside = false
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if !inside && String::starts_with(line, "export fn \{fname}()") {
      inside = true
    } else if inside && String::trim(line) == "]" {
      inside = false
    } else if inside {
      let t = String::trim(line)
      if String::starts_with(t, "\"") {
        Array::push(out, name_at(t, 1))
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

/// The file without its comment lines: a `Env::get("A", "B")` quoted in a
/// doc comment is not a read.
fn code_lines(text: String) -> String {
  let kept: Array[String] = []
  let lines = String::split(text, "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if !String::starts_with(String::trim(line), "//") {
      Array::push(kept, line)
    } else {
      ()
    }
    i = i + 1
  }
  String::join(kept, "\n")
}

fn contains(xs: Array[String], x: String) -> Bool {
  let mut i = 0
  let mut found = false
  while !found && i < Array::length(xs) {
    if Array::get(xs, i) == x {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

fn main allows Env + Fs + Console::write_stream + Stderr::write_stream + Process {
  let root = option("--root", ".")
  let memo = option("--memo", under(root, "lib/@vibe/compiler/entry/compiler/file_compile/linked_output_memo.vibe"))
  let lib = under(root, "lib/@vibe")
  if !Fs::is_dir(lib) || !Fs::exists(memo) {
    Stderr::write_stream("check-linked-output-memo-env: needs \{lib} and \{memo}\n")
    exit(1)
  } else {
    let memo_text = Fs::read_file(memo)
    let keyed = listed(memo_text, "linked_output_memo_env_names")
    let exempt = listed(memo_text, "linked_output_memo_env_exempt")
    let problems: Array[String] = []
    if Array::length(keyed) < 10 || Array::length(exempt) < 1 {
      // The lists' shape changed and this gate can no longer read them.
      Array::push(problems, "\{memo}: could not read the two variable lists (\{Array::length(keyed)} keyed, \{Array::length(exempt)} exempt)")
    } else {
      ()
    }
    let mut x = 0
    while x < Array::length(exempt) {
      let name = Array::get(exempt, x)
      if contains(keyed, name) {
        Array::push(problems, "\{name} is both part of the key and exempt from it; it is one or the other")
      } else {
        ()
      }
      x = x + 1
    }
    let collected: Array[String] = []
    let entries = find(lib)
    let mut e = 0
    while e < Array::length(entries) {
      let entry = Array::get(entries, e)
      if !entry.is_dir && (String::ends_with(entry.name, ".vibe") || String::ends_with(entry.name, ".vpkg")) && !is_generated(entry.path) && !is_test_or_bench(entry.path) {
        Array::push(collected, entry.path)
      } else {
        ()
      }
      e = e + 1
    }
    let files = sort_str(collected)
    let seen: Array[String] = []
    let mut f = 0
    while f < Array::length(files) {
      let path = Array::get(files, f)
      let text = code_lines(Fs::read_file(path))
      let names: Array[String] = []
      let prefixes: Array[String] = []
      vibe_literals(text, names, prefixes)
      literal_args_after(text, "Env::get(", names)
      literal_args_after(text, "read_env(", names)
      let mut p = 0
      while p < Array::length(prefixes) {
        Array::push(problems, "\{path}: the literal \"\{Array::get(prefixes, p)}\" looks like the start of a variable name built at run time, which no scan can classify; spell the names out")
        p = p + 1
      }
      let mut n = 0
      while n < Array::length(names) {
        let name = Array::get(names, n)
        if !contains(seen, name) {
          Array::push(seen, name)
          if !contains(keyed, name) && !contains(exempt, name) {
            Array::push(problems, "\{name} (mentioned in \{path}) is neither part of the memo key nor exempt from it")
          } else {
            ()
          }
        } else {
          ()
        }
        n = n + 1
      }
      f = f + 1
    }
    if Array::length(problems) > 0 {
      let mut b = 0
      while b < Array::length(problems) {
        Stderr::write_stream("\{Array::get(problems, b)}\n")
        b = b + 1
      }
      Stderr::write_stream("check-linked-output-memo-env: FAIL: \{Array::length(problems)} problem(s).\n")
      Stderr::write_stream("  Add each variable to linked_output_memo_env_names in \{memo} -- the safe default:\n")
      Stderr::write_stream("  a variable in the key costs a cache miss when it changes. Exempt it only when its\n")
      Stderr::write_stream("  value cannot reach the compiled module, and say why in that function's comment.\n")
      exit(1)
    } else {
      Console::write_stream("check-linked-output-memo-env: ok (\{Array::length(seen)} variable name(s) in \{Array::length(files)} file(s), \{Array::length(keyed)} keyed, \{Array::length(exempt)} exempt)\n")
    }
  }
}
