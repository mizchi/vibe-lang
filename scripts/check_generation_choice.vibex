// A step that runs a compiler names it; it does not pick the newest one (#3830, #3866).
//
//   bash scripts/vibe_run.sh scripts/check_generation_choice.vibex -- [--root DIR]
//
// `ls -dt _build/selfhost/generations/*/ | head -1` answers "which generation
// directory was touched last", which is not the question "which compiler did
// this run build". On a reused workspace an unrelated generation can be newer,
// and a concurrent build touches directories; a step that asks by mtime then
// measures, certifies or ships whichever compiler that is, and says nothing.
// #3810 took the bootstrap lane off it, #3830 the workflow steps, and #3866
// the scripts, tasks and eval drivers. A script whose caller named no compiler
// asks `resolve_stage2_generation` (scripts/resolve_stage2.sh): the generation
// built from HEAD, else the newest one WITH a NOTE on stderr.
//
// Refused: a line that runs `ls` with an option word carrying `t` (`-t`,
// `-dt`, `-td`, `-1t`, ...) and names `selfhost/generations`, in
//   - `.github/workflows/*.yml`;
//   - `tests/gates/*.sh` and `tests/gates/*/*.sh` (the lane sources);
//   - `scripts/*.sh`, `scripts/*.vibex` and `scripts/pkfire/*.pkl`;
//   - `Taskfile.pkl`;
//   - `tests/fuzz/*.sh`, `eval/*/*.sh` and `eval/*/*/*.sh`.
// Comment lines (first non-blank characters `#` or `//`) are prose and are
// skipped. This file and its self-test are not scanned: both spell the
// pattern on purpose.
//
// `scripts/generation_choice_allowlist.txt` names the files that may still do
// it, each with its reason. It may only shrink: an entry whose file no longer
// has a finding fails, so the list cannot outlive what it excuses.
//
// Seeing nothing is not clean: an empty workflow, lane or scripts set fails.
//
// --root DIR checks another tree (the self-test's).

import @vibe/builtin {
  String::index_of_from
}
import @vibe/process {
  exit
}
import @vibex/shell {
  ls, sort_str
}

fn option(name: String, fallback: String) -> String with Env {
  let mut out = fallback
  let mut i = 0
  while i + 1 < Env::args_len() {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn under(root: String, rel: String) -> String {
  if root == "." {
    rel
  } else {
    "\{root}/\{rel}"
  }
}

/// The files directly in `rel` whose name ends in `suffix`, as `rel/name`.
fn files_in(root: String, rel: String, suffix: String) -> Array[String] with Fs {
  let out: Array[String] = []
  if Fs::is_dir(under(root, rel)) {
    let entries = ls(under(root, rel))
    let mut i = 0
    while i < Array::length(entries) {
      let entry = Array::get(entries, i)
      if !entry.is_dir && String::ends_with(entry.name, suffix) {
        Array::push(out, "\{rel}/\{entry.name}")
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  out
}

/// The directories directly in `rel`, as `rel/name`.
fn dirs_in(root: String, rel: String) -> Array[String] with Fs {
  let out: Array[String] = []
  if Fs::is_dir(under(root, rel)) {
    let entries = ls(under(root, rel))
    let mut i = 0
    while i < Array::length(entries) {
      let entry = Array::get(entries, i)
      if entry.is_dir {
        Array::push(out, "\{rel}/\{entry.name}")
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  out
}

fn append_all(out: Array[String], more: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(more) {
    Array::push(out, Array::get(more, i))
    i = i + 1
  }
}

/// `rel/*suffix` and `rel/*/*suffix`.
fn files_two_deep(root: String, rel: String, suffix: String) -> Array[String] with Fs {
  let out = files_in(root, rel, suffix)
  let subs = dirs_in(root, rel)
  let mut i = 0
  while i < Array::length(subs) {
    append_all(out, files_in(root, Array::get(subs, i), suffix))
    i = i + 1
  }
  out
}

/// `rel/*/*suffix` and `rel/*/*/*suffix`.
fn files_under_subdirs(root: String, rel: String, suffix: String) -> Array[String] with Fs {
  let out: Array[String] = []
  let subs = dirs_in(root, rel)
  let mut i = 0
  while i < Array::length(subs) {
    append_all(out, files_two_deep(root, Array::get(subs, i), suffix))
    i = i + 1
  }
  out
}

fn contains(xs: Array[String], x: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) && !found {
    if Array::get(xs, i) == x {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn is_comment(line: String) -> Bool {
  let t = String::trim(line)
  String::starts_with(t, "#") || String::starts_with(t, "//")
}

/// Does the option word starting at `at` (just after `ls -`) carry `t`?
fn mtime_flags(line: String, at: Int) -> Bool {
  let mut t = false
  let mut i = at
  let mut going = true
  while going && i < String::length(line) {
    let c = String::substring(line, i, i + 1)
    if c == "t" {
      t = true
      i = i + 1
    } else if c == " " || c == "\t" {
      going = false
    } else {
      i = i + 1
    }
  }
  t
}

/// An `ls -<flags>` with `t`, on a line that names the generations directory.
fn picks_newest_generation(line: String) -> Bool {
  if is_comment(line) || String::index_of_from(line, "selfhost/generations", 0) < 0 {
    false
  } else {
    let mut found = false
    let mut from = 0
    let mut going = true
    while going && !found {
      let at = String::index_of_from(line, "ls -", from)
      if at < 0 {
        going = false
      } else {
        let prev = if at == 0 {
          " "
        } else {
          String::substring(line, at - 1, at)
        }
        let starts_word = prev == " " || prev == "(" || prev == "\t" || prev == "`" || prev == "\""
        if starts_word && mtime_flags(line, at + 4) {
          found = true
        } else {
          from = at + 1
        }
      }
    }
    found
  }
}

/// The allowlisted paths: the first field of each non-blank, non-`#` line.
fn read_allowlist(root: String, rel: String) -> Array[String] with Fs {
  let out: Array[String] = []
  if Fs::exists(under(root, rel)) {
    let lines = String::split(Fs::read_file(under(root, rel)), "\n")
    let mut i = 0
    while i < Array::length(lines) {
      let line = String::trim(Array::get(lines, i))
      if line != "" && !String::starts_with(line, "#") {
        let tab = String::index_of_from(line, "\t", 0)
        let space = String::index_of_from(line, " ", 0)
        let cut = if tab >= 0 && (space < 0 || tab < space) {
          tab
        } else {
          space
        }
        if cut >= 0 {
          Array::push(out, String::substring(line, 0, cut))
        } else {
          Array::push(out, line)
        }
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  out
}

fn main allows Env + Fs + Console::write_stream + Stderr::write_stream + Process::exit {
  let root = option("--root", ".")
  let allowlist_path = "scripts/generation_choice_allowlist.txt"
  let workflows = sort_str(files_in(root, ".github/workflows", ".yml"))
  let lanes = sort_str(files_two_deep(root, "tests/gates", ".sh"))
  let scripts: Array[String] = []
  append_all(scripts, files_in(root, "scripts", ".sh"))
  append_all(scripts, files_in(root, "scripts", ".vibex"))
  let script_count = Array::length(scripts)
  append_all(scripts, files_in(root, "scripts/pkfire", ".pkl"))
  let others: Array[String] = []
  if Fs::exists(under(root, "Taskfile.pkl")) {
    Array::push(others, "Taskfile.pkl")
  } else {
    ()
  }
  append_all(others, files_in(root, "tests/fuzz", ".sh"))
  append_all(others, files_under_subdirs(root, "eval", ".sh"))
  let mut bad = 0
  if Array::length(workflows) == 0 {
    Stderr::write_stream("[generation-choice] FAIL: no .github/workflows/*.yml found under \{root} -- nothing checked is not clean\n")
    bad = bad + 1
  } else {
    ()
  }
  if Array::length(lanes) == 0 {
    Stderr::write_stream("[generation-choice] FAIL: no tests/gates lane source found under \{root} -- nothing checked is not clean\n")
    bad = bad + 1
  } else {
    ()
  }
  if script_count == 0 {
    Stderr::write_stream("[generation-choice] FAIL: no scripts/*.sh or scripts/*.vibex found under \{root} -- nothing checked is not clean\n")
    bad = bad + 1
  } else {
    ()
  }
  let excluded = ["scripts/check_generation_choice.vibex", "scripts/check_generation_choice_test.sh"]
  let allowed = read_allowlist(root, allowlist_path)
  let excused: Array[String] = []
  let files: Array[String] = []
  append_all(files, workflows)
  append_all(files, lanes)
  append_all(files, sort_str(scripts))
  append_all(files, sort_str(others))
  let mut scanned = 0
  let mut f = 0
  while f < Array::length(files) {
    let path = Array::get(files, f)
    if contains(excluded, path) {
      ()
    } else {
      scanned = scanned + 1
      let lines = String::split(Fs::read_file(under(root, path)), "\n")
      let mut n = 0
      while n < Array::length(lines) {
        let line = Array::get(lines, n)
        if picks_newest_generation(line) {
          if contains(allowed, path) {
            if contains(excused, path) {
              ()
            } else {
              Array::push(excused, path)
            }
          } else {
            Stderr::write_stream("[generation-choice] FAIL: \{path}:\{n + 1}: picks the newest generation by mtime: \{String::trim(line)}\n")
            bad = bad + 1
          }
        } else {
          ()
        }
        n = n + 1
      }
    }
    f = f + 1
  }
  let mut a = 0
  while a < Array::length(allowed) {
    let entry = Array::get(allowed, a)
    if contains(excused, entry) {
      ()
    } else {
      Stderr::write_stream("[generation-choice] FAIL: \{allowlist_path}: \{entry} no longer picks by mtime (or is not scanned) -- delete its entry\n")
      bad = bad + 1
    }
    a = a + 1
  }
  if bad > 0 {
    Stderr::write_stream("  Name the compiler instead: pass the stage2 the job restored, build with\n")
    Stderr::write_stream("  --out-dir \"$(bash scripts/generations.sh out-dir)\" and read that directory,\n")
    Stderr::write_stream("  or, as a fallback when no compiler was named, ask\n")
    Stderr::write_stream("  `resolve_stage2_generation <label> <root>` from scripts/resolve_stage2.sh (#3866).\n")
    exit(1)
  } else {
    Console::write_stream("[generation-choice] ok (\{scanned} files: \{Array::length(workflows)} workflows, \{Array::length(lanes)} lane sources; \{Array::length(allowed)} allowlisted)\n")
  }
}
