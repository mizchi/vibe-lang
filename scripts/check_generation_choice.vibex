// A step that runs a compiler names it; it does not pick the newest one (#3830).
//
//   bash scripts/vibe_run.sh scripts/check_generation_choice.vibex -- [--root DIR]
//
// `ls -dt _build/selfhost/generations/*/ | head -1` answers "which generation
// directory was touched last", which is not the question "which compiler did
// this run build". On a reused workspace an unrelated generation can be newer,
// and a concurrent build touches directories; a step that asks by mtime then
// measures, certifies or ships whichever compiler that is, and says nothing.
// #3810 took the bootstrap lane off it (it now names its generation directory
// before the selfbuild) and #3830 took eight workflow steps off it (they pass
// the compiler the job restored, or a directory named before the build).
//
// Refused: a line in `.github/workflows/*.yml` or a lane source under
// `tests/gates/` (`*.sh` there and one directory down) that runs `ls` with an
// option word carrying both `d` and `t` (`-dt`, `-td`, `-tdr`, ...) over
// `selfhost/generations`. Comment lines (first non-blank character `#`) are
// prose and are skipped. scripts/ is not scanned: several tools there keep the
// newest generation as their LAST fallback after an explicit override, which
// is a different contract from a step whose answer is the newest one.
//
// Seeing nothing is not clean: no workflow file or no lane source found fails.
//
// --root DIR checks another tree (the self-test's).

import @vibe/builtin {
  String::index_of_from
}
import @vibe/process {
  exit
}
import @vibex/shell {
  ls, sort_str
}

fn option(name: String, fallback: String) -> String with Env {
  let mut out = fallback
  let mut i = 0
  while i + 1 < Env::args_len() {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn under(root: String, rel: String) -> String {
  if root == "." {
    rel
  } else {
    "\{root}/\{rel}"
  }
}

/// The files directly in `rel` whose name ends in `suffix`, as `rel/name`.
fn files_in(root: String, rel: String, suffix: String) -> Array[String] with Fs {
  let out: Array[String] = []
  if Fs::is_dir(under(root, rel)) {
    let entries = ls(under(root, rel))
    let mut i = 0
    while i < Array::length(entries) {
      let entry = Array::get(entries, i)
      if !entry.is_dir && String::ends_with(entry.name, suffix) {
        Array::push(out, "\{rel}/\{entry.name}")
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  out
}

/// `rel/*.sh` and `rel/*/*.sh`.
fn lane_sources(root: String, rel: String) -> Array[String] with Fs {
  let out = files_in(root, rel, ".sh")
  if Fs::is_dir(under(root, rel)) {
    let entries = ls(under(root, rel))
    let mut i = 0
    while i < Array::length(entries) {
      let entry = Array::get(entries, i)
      if entry.is_dir {
        let inner = files_in(root, "\{rel}/\{entry.name}", ".sh")
        let mut j = 0
        while j < Array::length(inner) {
          Array::push(out, Array::get(inner, j))
          j = j + 1
        }
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  out
}

fn is_comment(line: String) -> Bool {
  String::starts_with(String::trim(line), "#")
}

/// Does the option word starting at `at` (just after `ls -`) carry both `d` and `t`?
fn mtime_dir_flags(line: String, at: Int) -> Bool {
  let mut d = false
  let mut t = false
  let mut i = at
  let mut going = true
  while going && i < String::length(line) {
    let c = String::substring(line, i, i + 1)
    if c == "d" {
      d = true
      i = i + 1
    } else if c == "t" {
      t = true
      i = i + 1
    } else if c == " " || c == "\t" {
      going = false
    } else {
      i = i + 1
    }
  }
  d && t
}

/// An `ls -<flags>` with both `d` and `t`, on a line that names the
/// generations directory.
fn picks_newest_generation(line: String) -> Bool {
  if is_comment(line) || String::index_of_from(line, "selfhost/generations", 0) < 0 {
    false
  } else {
    let mut found = false
    let mut from = 0
    let mut going = true
    while going && !found {
      let at = String::index_of_from(line, "ls -", from)
      if at < 0 {
        going = false
      } else {
        let prev = if at == 0 {
          " "
        } else {
          String::substring(line, at - 1, at)
        }
        let starts_word = prev == " " || prev == "(" || prev == "\t" || prev == "`"
        if starts_word && mtime_dir_flags(line, at + 4) {
          found = true
        } else {
          from = at + 1
        }
      }
    }
    found
  }
}

fn main allows Env + Fs + Console::write_stream + Stderr::write_stream + Process::exit {
  let root = option("--root", ".")
  let workflows = sort_str(files_in(root, ".github/workflows", ".yml"))
  let lanes = sort_str(lane_sources(root, "tests/gates"))
  let mut bad = 0
  if Array::length(workflows) == 0 {
    Stderr::write_stream("[generation-choice] FAIL: no .github/workflows/*.yml found under \{root} -- nothing checked is not clean\n")
    bad = bad + 1
  } else {
    ()
  }
  if Array::length(lanes) == 0 {
    Stderr::write_stream("[generation-choice] FAIL: no tests/gates lane source found under \{root} -- nothing checked is not clean\n")
    bad = bad + 1
  } else {
    ()
  }
  let files: Array[String] = []
  let mut w = 0
  while w < Array::length(workflows) {
    Array::push(files, Array::get(workflows, w))
    w = w + 1
  }
  let mut l = 0
  while l < Array::length(lanes) {
    Array::push(files, Array::get(lanes, l))
    l = l + 1
  }
  let mut f = 0
  while f < Array::length(files) {
    let path = Array::get(files, f)
    let lines = String::split(Fs::read_file(under(root, path)), "\n")
    let mut n = 0
    while n < Array::length(lines) {
      let line = Array::get(lines, n)
      if picks_newest_generation(line) {
        Stderr::write_stream("[generation-choice] FAIL: \{path}:\{n + 1}: picks the newest generation by mtime: \{String::trim(line)}\n")
        bad = bad + 1
      } else {
        ()
      }
      n = n + 1
    }
    f = f + 1
  }
  if bad > 0 {
    Stderr::write_stream("  Name the compiler instead: pass the stage2 the job restored, or build with\n")
    Stderr::write_stream("  --out-dir \"$(bash scripts/generations.sh out-dir)\" and read that directory (#3830).\n")
    exit(1)
  } else {
    Console::write_stream("[generation-choice] ok (\{Array::length(workflows)} workflows, \{Array::length(lanes)} lane sources)\n")
  }
}
