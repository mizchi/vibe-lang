// vibec componentizer (#1107 Phase 5, the implementation shape of #857).
//
// Wraps an already-compiled vibec CORE module (the compiler's pure
// string-based compile surface, `compile_cli_request(source, request) ->
// String` from lib/@vibe/compiler/cli_direct_component_entry.vibe) into a
// wasm COMPONENT exporting canonical-ABI `compile: func(source: string,
// request: string) -> string` — the host-independent face that runs the same
// under wasmtime, jco/node, and a browser. Driven by scripts/build_vibec.sh;
// same script-tool pattern as scripts/vibe_opt.vibex (no compiler-adapter
// surface growth, and the frozen seed needs no new env mode to build it).
//
// Usage: vibec-componentize <core.wasm> <out.component.wasm>

import @vibe/compiler/entry/source_compile/wasi_only {
  comp_emit_component_wasm_string_handler_stubbed
}

fn main with { Fs, Env, Stdout, Stderr, Process } {
  let argc = Env::args_len()
  if argc < 2 {
    Stderr::write_stream("usage: vibec-componentize <core.wasm> <out.component.wasm>\n")
    vibe_process_exit_raw(2)
  } else {
    let core_path = Env::args_get(0)
    let out_path = Env::args_get(1)
    let core = Fs::read_bytes(core_path)
    if Bytes::length(core) == 0 {
      Stderr::write_stream("vibec-componentize: empty or unreadable core: \{core_path}\n")
      vibe_process_exit_raw(1)
    } else {
      let code = handle {
        let component = comp_emit_component_wasm_string_handler_stubbed(core, "compile_cli_request", "compile", [
          "source", "request"
        ])
        Fs::write_bytes(out_path, component)
        Stdout::write_stream("vibec: \{core_path} \{Bytes::length(core)}B -> \{out_path} \{Bytes::length(component)}B\n")
        0
      } with Error {
        Throw(msg) => {
          Stderr::write_stream("vibec-componentize: \{msg}\n")
          1
        }
      }
      if code != 0 {
        vibe_process_exit_raw(code)
      } else {
        ()
      }
    }
  }
}
