// #2905: a user-callable capability spelling must reserve the import it
// lowers onto. `linked_compile.vibe` maps builtin names onto host-import
// indices. Those indices are the import only when the import is reserved;
// unreserved, they fall back to a never-called stub of a different arity, so
// the program compiles clean and emits a module that does not validate.
//
// Scope matches the gate this replaced (`check_import_reservation.py`):
// registry names only, `Provider::lower_snake_op` spellings only, and only
// indices that are conditionally reserved. Paths are overridable so the red
// test can point at a mutated copy.
//
//   bash scripts/vibe_run.sh scripts/check_import_reservation.vibex

import @vibe/builtin {
  String::index_of_from
}
import @vibe/console {
  eprintln
}
import @vibe/process {
  exit
}
import @vibex/shell {
  env_or, sort_str
}

fn byte_at(s: String, i: Int) -> Int {
  String::char_code_at(s, at = i)
}

fn is_ws(c: Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn is_upper(c: Int) -> Bool {
  c >= 65 && c <= 90
}

fn is_lower(c: Int) -> Bool {
  c >= 97 && c <= 122
}

fn is_digit(c: Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_alnum(c: Int) -> Bool {
  is_upper(c = c) || is_lower(c = c) || is_digit(c = c)
}

fn is_ident(c: Int) -> Bool {
  is_alnum(c = c) || c == 95
}

fn die(message: String) -> Unit with Stderr + Process {
  eprintln("import-reservation: " + message)
  exit(1)
}

fn has(xs: Array[String], want: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, at = i) == want {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn user_spelling(name: String) -> Bool {
  // ^[A-Z][A-Za-z0-9]*::[a-z][a-z0-9_]*$
  let n = String::length(name)
  let mut ok = n >= 4 && is_upper(c = byte_at(s = name, i = 0))
  let mut i = 1
  while ok && i < n && is_alnum(c = byte_at(s = name, i = i)) {
    i = i + 1
  }
  if ok {
    if i + 2 >= n || byte_at(s = name, i = i) != 58 || byte_at(s = name, i = i + 1) != 58 || !is_lower(c = byte_at(s = name, i = i + 2)) {
      ok = false
    } else {
      let mut j = i + 3
      while ok && j < n {
        let c = byte_at(s = name, i = j)
        if is_lower(c = c) || is_digit(c = c) || c == 95 {
          j = j + 1
        } else {
          ok = false
        }
      }
    }
  } else {
    ()
  }
  ok
}

fn quoted_ending_at(text: String, end: Int) -> String {
  // `end` is the index of the closing quote. Walk back to the opening one.
  let mut k = end - 1
  while k >= 0 && byte_at(s = text, i = k) != 34 {
    k = k - 1
  }
  if k < 0 {
    ""
  } else {
    String::substring(text, start = k + 1, end = end)
  }
}

fn registry_names(text: String) -> Array[String] with Stderr + Process {
  let out: Array[String] = []
  // Anchor on `CtFn(` and walk BACK over whitespace to the comma, then to
  // the closing quote. The literal `", CtFn("` marker silently skipped a row
  // formatted with a newline, a tab or two spaces after the comma, and the
  // drift guard below only fires when EVERY row is lost -- so a skipped row's
  // capability went unchecked while the gate stayed green (#3167 review).
  let marker = "CtFn("
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, sub = marker, start = i)
    if hit < 0 {
      i = -1
    } else {
      let mut c = hit - 1
      while c >= 0 && is_ws(c = byte_at(s = text, i = c)) {
        c = c - 1
      }
      let mut j = c - 1
      while j >= 0 && is_ws(c = byte_at(s = text, i = j)) {
        j = j - 1
      }
      if c >= 0 && byte_at(s = text, i = c) == 44 && j >= 0 && byte_at(s = text, i = j) == 34 {
        let name = quoted_ending_at(text = text, end = j)
        let mut k = j - String::length(name) - 2
        while k >= 0 && is_ws(c = byte_at(s = text, i = k)) {
          k = k - 1
        }
        if k >= 0 && byte_at(s = text, i = k) == 40 && String::length(name) > 0 {
          Array::push(out, value = name)
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + String::length(marker)
    }
  }
  if Array::length(out) == 0 {
    die(message = "could not parse any registry rows; the parser has drifted")
  } else {
    ()
  }
  out
}

fn read_ident_ending(text: String, end: Int) -> String {
  // `end` is one past the ident. Walk back over ident characters.
  let mut k = end - 1
  while k >= 0 && is_ident(c = byte_at(s = text, i = k)) {
    k = k - 1
  }
  String::substring(text, start = k + 1, end = end)
}

fn skip_ws_back(text: String, end: Int) -> Int {
  let mut j = end
  while j >= 0 && is_ws(c = byte_at(s = text, i = j)) {
    j = j - 1
  }
  j
}

fn conditional_indices(text: String) -> Array[String] with Stderr + Process {
  // `let <name>_idx = if <name>_import_idx >= 0`
  let out: Array[String] = []
  let marker = "_import_idx"
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, sub = marker, start = i)
    if hit < 0 {
      i = -1
    } else {
      let import_ident = read_ident_ending(text = text, end = hit + String::length(marker))
      let ident_start = hit + String::length(marker) - String::length(import_ident)
      let before_ident = skip_ws_back(text = text, end = ident_start - 1)
      if before_ident >= 1 && byte_at(s = text, i = before_ident) == 102 && byte_at(s = text, i = before_ident - 1) == 105 {
        // `if` — and the character before `i` is not an ident char.
        let i_at = before_ident - 1
        let boundary_ok = i_at == 0 || !is_ident(c = byte_at(s = text, i = i_at - 1))
        if boundary_ok && String::ends_with(import_ident, suffix = "_import_idx") {
          let before_if = skip_ws_back(text = text, end = i_at - 1)
          if before_if >= 0 && byte_at(s = text, i = before_if) == 61 {
            let before_eq = skip_ws_back(text = text, end = before_if - 1)
            let idx_ident = read_ident_ending(text = text, end = before_eq + 1)
            let idx_start = before_eq + 1 - String::length(idx_ident)
            let before_idx = skip_ws_back(text = text, end = idx_start - 1)
            if String::ends_with(idx_ident, suffix = "_idx") && before_idx >= 2 && byte_at(s = text, i = before_idx) == 116 && byte_at(s = text, i = before_idx - 1) == 101 && byte_at(s = text, i = before_idx - 2) == 108 {
              let let_at = before_idx - 2
              let let_boundary = let_at == 0 || !is_ident(c = byte_at(s = text, i = let_at - 1))
              let after_import = hit + String::length(marker)
              let mut p = after_import
              let n = String::length(text)
              while p < n && is_ws(c = byte_at(s = text, i = p)) {
                p = p + 1
              }
              if let_boundary && p + 2 < n && byte_at(s = text, i = p) == 62 && byte_at(s = text, i = p + 1) == 61 {
                let mut q = p + 2
                while q < n && is_ws(c = byte_at(s = text, i = q)) {
                  q = q + 1
                }
                if q < n && byte_at(s = text, i = q) == 48 {
                  Array::push(out, value = idx_ident)
                } else {
                  ()
                }
              } else {
                ()
              }
            } else {
              ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + String::length(marker)
    }
  }
  if Array::length(out) == 0 {
    die(message = "could not parse any conditionally-reserved import indices; the parser has drifted")
  } else {
    ()
  }
  out
}

fn reserved_names(text: String) -> Array[String] with Stderr + Process {
  let out: Array[String] = []
  let marker = "Map::has_key(used_builtin_names,"
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, sub = marker, start = i)
    if hit < 0 {
      i = -1
    } else {
      let mut p = hit + String::length(marker)
      let n = String::length(text)
      while p < n && is_ws(c = byte_at(s = text, i = p)) {
        p = p + 1
      }
      // The first Map argument is positional; the second is either a bare
      // string or `key =` followed by that string. Other labels stay unread
      // so a misspelled reservation cannot certify the mapped capability.
      if p + 3 <= n && String::substring(text, start = p, end = p + 3) == "key" {
        let mut eq = p + 3
        while eq < n && is_ws(c = byte_at(s = text, i = eq)) {
          eq = eq + 1
        }
        if eq < n && byte_at(s = text, i = eq) == 61 {
          p = eq + 1
          while p < n && is_ws(c = byte_at(s = text, i = p)) {
            p = p + 1
          }
        } else {
          ()
        }
      } else {
        ()
      }
      if p < n && byte_at(s = text, i = p) == 34 {
        let close = String::index_of_from(text, sub = "\"", start = p + 1)
        if close > p {
          Array::push(out, value = String::substring(text, start = p + 1, end = close))
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + String::length(marker)
    }
  }
  if Array::length(out) == 0 {
    die(message = "could not parse any reservation predicates; the parser has drifted")
  } else {
    ()
  }
  out
}

fn mapped_names(text: String) -> Array[String] {
  // Each row is `name\tindex`, for `"name" => some_idx,`.
  let out: Array[String] = []
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, sub = "=>", start = i)
    if hit < 0 {
      i = -1
    } else {
      let before = skip_ws_back(text = text, end = hit - 1)
      if before >= 0 && byte_at(s = text, i = before) == 34 {
        let name = quoted_ending_at(text = text, end = before)
        let mut p = hit + 2
        let n = String::length(text)
        while p < n && is_ws(c = byte_at(s = text, i = p)) {
          p = p + 1
        }
        let mut q = p
        while q < n && is_ident(c = byte_at(s = text, i = q)) {
          q = q + 1
        }
        let index = String::substring(text, start = p, end = q)
        let mut r = q
        while r < n && is_ws(c = byte_at(s = text, i = r)) {
          r = r + 1
        }
        if String::length(name) > 0 && String::ends_with(index, suffix = "_idx") && r < n && byte_at(s = text, i = r) == 44 {
          Array::push(out, value = name + "\t" + index)
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + 2
    }
  }
  out
}

fn field(row: String, which: Int) -> String {
  let tab = String::index_of(row, needle = "\t")
  if which == 0 {
    String::substring(row, start = 0, end = tab)
  } else {
    String::substring(row, start = tab + 1, end = String::length(row))
  }
}

// The manifest is the compiler's source inventory; read every linked module.
// An overridden path remains a single mutation fixture for the gate self-test.
fn linked_source(path: String) -> String with Fs {
  let original = Fs::read_file(path)
  if path != "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe" {
    original
  } else {
    let rows = String::split(Fs::read_file("lib/@vibe/compiler/compiler_sources_manifest.tsv"), sep = "\n")
    let mut source = original
    let mut i = 0
    while i < Array::length(rows) {
      let row = Array::get(rows, at = i)
      let tab = String::index_of(row, needle = "\t")
      if tab >= 0 {
        let module_path = String::substring(row, start = tab + 1, end = String::length(row))
        if String::starts_with(module_path, prefix = "codegen/wasi/linked_compile_") {
          source = source + "\n" + Fs::read_file("lib/@vibe/compiler/" + module_path)
        }
      }
      i = i + 1
    }
    source
  }
}

fn main() -> Unit allows Env + Fs + Console + Process {
  let linked_path = env_or(name = "VIBE_IMPORT_RESERVATION_LINKED", fallback = "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe")
  let registry_path = env_or(name = "VIBE_IMPORT_RESERVATION_REGISTRY", fallback = "lib/@vibe/compiler/core/builtin_registry.vibe")
  let linked = linked_source(path = linked_path)
  let registry_text = Fs::read_file(registry_path)
  let mapped = mapped_names(text = linked)
  if Array::length(mapped) == 0 {
    die(message = "no user-callable mapped name was checked at all; the parser has drifted")
  } else {
    let conditional = conditional_indices(text = linked)
    let mut registry: Array[String] = []
    let mut registry_loaded = false
    let mut reserved: Array[String] = []
    let mut reserved_loaded = false
    let mut checked = 0
    let bad: Array[String] = []
    let mut i = 0
    while i < Array::length(mapped) {
      let row = Array::get(mapped, at = i)
      let name = field(row = row, which = 0)
      let index = field(row = row, which = 1)
      if has(xs = conditional, want = index) {
        if !registry_loaded {
          registry = registry_names(text = registry_text)
          registry_loaded = true
        } else {
          ()
        }
        if has(xs = registry, want = name) && user_spelling(name = name) {
          if !reserved_loaded {
            reserved = reserved_names(text = linked)
            reserved_loaded = true
          } else {
            ()
          }
          checked = checked + 1
          if !has(xs = reserved, want = name) {
            Array::push(bad, value = name + "\t" + index)
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    if checked == 0 {
      die(message = "no user-callable mapped name was checked at all; the parser has drifted")
    } else if Array::length(bad) > 0 {
      let bad_sorted = sort_str(bad)
      let mut lines = "a user-callable capability is mapped onto a conditionally-reserved import\nit never reserves, so a program using only that spelling builds clean and\nemits a module that does not validate (#2905):"
      let mut b = 0
      while b < Array::length(bad_sorted) {
        let row = Array::get(bad_sorted, at = b)
        lines = lines + "\n  " + field(row = row, which = 0) + " lowers onto " + field(row = row, which = 1) + " but never reserves it"
        b = b + 1
      }
      die(message = lines)
    } else {
      println("import-reservation: ok (" + __to_string(checked) + " user-callable spellings all reserve the import they lower onto)")
    }
  }
}
