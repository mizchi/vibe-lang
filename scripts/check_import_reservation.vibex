// #2905: a user-callable capability spelling must reserve the import it
// lowers onto. `linked_compile.vibe` maps builtin names onto host-import
// indices. Those indices are the import only when the import is reserved;
// unreserved, they fall back to a never-called stub of a different arity, so
// the program compiles clean and emits a module that does not validate.
//
// Scope matches the gate this replaced (`check_import_reservation.py`):
// registry names only, `Provider::lower_snake_op` spellings only, and only
// indices that are conditionally reserved. Paths are overridable so the red
// test can point at a mutated copy.
//
//   bash scripts/vibe_run.sh scripts/check_import_reservation.vibex

import @vibe/builtin { String::index_of_from }
import @vibe/console { eprintln }
import @vibe/process { exit }
import @vibex/shell { env_or, sort_str }

fn byte_at(s: String, i: Int) -> Int {
  String::char_code_at(s, i)
}

fn is_ws(c: Int) -> Bool {
  c == 32 || c == 9 || c == 10 || c == 13
}

fn is_upper(c: Int) -> Bool {
  c >= 65 && c <= 90
}

fn is_lower(c: Int) -> Bool {
  c >= 97 && c <= 122
}

fn is_digit(c: Int) -> Bool {
  c >= 48 && c <= 57
}

fn is_alnum(c: Int) -> Bool {
  is_upper(c) || is_lower(c) || is_digit(c)
}

fn is_ident(c: Int) -> Bool {
  is_alnum(c) || c == 95
}

fn die(message: String) -> Unit with Stderr + Process {
  eprintln("import-reservation: " + message)
  exit(1)
}

fn has(xs: Array[String], want: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == want {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn user_spelling(name: String) -> Bool {
  // ^[A-Z][A-Za-z0-9]*::[a-z][a-z0-9_]*$
  let n = String::length(name)
  let mut ok = n >= 4 && is_upper(byte_at(name, 0))
  let mut i = 1
  while ok && i < n && is_alnum(byte_at(name, i)) {
    i = i + 1
  }
  if ok {
    if i + 2 >= n || byte_at(name, i) != 58 || byte_at(name, i + 1) != 58 || !is_lower(byte_at(name, i + 2)) {
      ok = false
    } else {
      let mut j = i + 3
      while ok && j < n {
        let c = byte_at(name, j)
        if is_lower(c) || is_digit(c) || c == 95 {
          j = j + 1
        } else {
          ok = false
        }
      }
    }
  } else {
    ()
  }
  ok
}

fn quoted_ending_at(text: String, end: Int) -> String {
  // `end` is the index of the closing quote. Walk back to the opening one.
  let mut k = end - 1
  while k >= 0 && byte_at(text, k) != 34 {
    k = k - 1
  }
  if k < 0 {
    ""
  } else {
    String::substring(text, k + 1, end)
  }
}

fn registry_names(text: String) -> Array[String] with Stderr + Process {
  let out: Array[String] = []
  let marker = ", CtFn("
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, marker, i)
    if hit < 0 {
      i = -1
    } else {
      let mut j = hit - 1
      while j >= 0 && is_ws(byte_at(text, j)) {
        j = j - 1
      }
      if j >= 0 && byte_at(text, j) == 34 {
        let name = quoted_ending_at(text, j)
        let mut k = j - String::length(name) - 2
        while k >= 0 && is_ws(byte_at(text, k)) {
          k = k - 1
        }
        if k >= 0 && byte_at(text, k) == 40 && String::length(name) > 0 {
          Array::push(out, name)
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + String::length(marker)
    }
  }
  if Array::length(out) == 0 {
    die("could not parse any registry rows; the parser has drifted")
  } else {
    ()
  }
  out
}

fn read_ident_ending(text: String, end: Int) -> String {
  // `end` is one past the ident. Walk back over ident characters.
  let mut k = end - 1
  while k >= 0 && is_ident(byte_at(text, k)) {
    k = k - 1
  }
  String::substring(text, k + 1, end)
}

fn skip_ws_back(text: String, end: Int) -> Int {
  let mut j = end
  while j >= 0 && is_ws(byte_at(text, j)) {
    j = j - 1
  }
  j
}

fn conditional_indices(text: String) -> Array[String] with Stderr + Process {
  // `let <name>_idx = if <name>_import_idx >= 0`
  let out: Array[String] = []
  let marker = "_import_idx"
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, marker, i)
    if hit < 0 {
      i = -1
    } else {
      let import_ident = read_ident_ending(text, hit + String::length(marker))
      let ident_start = hit + String::length(marker) - String::length(import_ident)
      let before_ident = skip_ws_back(text, ident_start - 1)
      if before_ident >= 1 && byte_at(text, before_ident) == 102 && byte_at(text, before_ident - 1) == 105 {
        // `if` — and the character before `i` is not an ident char.
        let i_at = before_ident - 1
        let boundary_ok = i_at == 0 || !is_ident(byte_at(text, i_at - 1))
        if boundary_ok && String::ends_with(import_ident, "_import_idx") {
          let before_if = skip_ws_back(text, i_at - 1)
          if before_if >= 0 && byte_at(text, before_if) == 61 {
            let before_eq = skip_ws_back(text, before_if - 1)
            let idx_ident = read_ident_ending(text, before_eq + 1)
            let idx_start = before_eq + 1 - String::length(idx_ident)
            let before_idx = skip_ws_back(text, idx_start - 1)
            if String::ends_with(idx_ident, "_idx") && before_idx >= 2 && byte_at(text, before_idx) == 116 && byte_at(text, before_idx - 1) == 101 && byte_at(text, before_idx - 2) == 108 {
              let let_at = before_idx - 2
              let let_boundary = let_at == 0 || !is_ident(byte_at(text, let_at - 1))
              let after_import = hit + String::length(marker)
              let mut p = after_import
              let n = String::length(text)
              while p < n && is_ws(byte_at(text, p)) {
                p = p + 1
              }
              if let_boundary && p + 2 < n && byte_at(text, p) == 62 && byte_at(text, p + 1) == 61 {
                let mut q = p + 2
                while q < n && is_ws(byte_at(text, q)) {
                  q = q + 1
                }
                if q < n && byte_at(text, q) == 48 {
                  Array::push(out, idx_ident)
                } else {
                  ()
                }
              } else {
                ()
              }
            } else {
              ()
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + String::length(marker)
    }
  }
  if Array::length(out) == 0 {
    die("could not parse any conditionally-reserved import indices; the parser has drifted")
  } else {
    ()
  }
  out
}

fn reserved_names(text: String) -> Array[String] with Stderr + Process {
  let out: Array[String] = []
  let marker = "Map::has_key(used_builtin_names,"
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, marker, i)
    if hit < 0 {
      i = -1
    } else {
      let mut p = hit + String::length(marker)
      let n = String::length(text)
      while p < n && is_ws(byte_at(text, p)) {
        p = p + 1
      }
      if p < n && byte_at(text, p) == 34 {
        let close = String::index_of_from(text, "\"", p + 1)
        if close > p {
          Array::push(out, String::substring(text, p + 1, close))
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + String::length(marker)
    }
  }
  if Array::length(out) == 0 {
    die("could not parse any reservation predicates; the parser has drifted")
  } else {
    ()
  }
  out
}

fn mapped_names(text: String) -> Array[String] {
  // Each row is `name\tindex`, for `"name" => some_idx,`.
  let out: Array[String] = []
  let mut i = 0
  while i >= 0 {
    let hit = String::index_of_from(text, "=>", i)
    if hit < 0 {
      i = -1
    } else {
      let before = skip_ws_back(text, hit - 1)
      if before >= 0 && byte_at(text, before) == 34 {
        let name = quoted_ending_at(text, before)
        let mut p = hit + 2
        let n = String::length(text)
        while p < n && is_ws(byte_at(text, p)) {
          p = p + 1
        }
        let mut q = p
        while q < n && is_ident(byte_at(text, q)) {
          q = q + 1
        }
        let index = String::substring(text, p, q)
        let mut r = q
        while r < n && is_ws(byte_at(text, r)) {
          r = r + 1
        }
        if String::length(name) > 0 && String::ends_with(index, "_idx") && r < n && byte_at(text, r) == 44 {
          Array::push(out, name + "\t" + index)
        } else {
          ()
        }
      } else {
        ()
      }
      i = hit + 2
    }
  }
  out
}

fn field(row: String, which: Int) -> String {
  let tab = String::index_of(row, "\t")
  if which == 0 {
    String::substring(row, 0, tab)
  } else {
    String::substring(row, tab + 1, String::length(row))
  }
}

fn main() -> Unit allows Env + Fs + Console + Stderr + Process {
  let linked_path = env_or("VIBE_IMPORT_RESERVATION_LINKED", "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe")
  let registry_path = env_or("VIBE_IMPORT_RESERVATION_REGISTRY", "lib/@vibe/compiler/core/builtin_registry.vibe")
  let linked = Fs::read_file(linked_path)
  let registry_text = Fs::read_file(registry_path)
  let mapped = mapped_names(linked)
  if Array::length(mapped) == 0 {
    die("no user-callable mapped name was checked at all; the parser has drifted")
  } else {
    let conditional = conditional_indices(linked)
    let mut registry: Array[String] = []
    let mut registry_loaded = false
    let mut reserved: Array[String] = []
    let mut reserved_loaded = false
    let mut checked = 0
    let bad: Array[String] = []
    let mut i = 0
    while i < Array::length(mapped) {
      let row = Array::get(mapped, i)
      let name = field(row, 0)
      let index = field(row, 1)
      if has(conditional, index) {
        if !registry_loaded {
          registry = registry_names(registry_text)
          registry_loaded = true
        } else {
          ()
        }
        if has(registry, name) && user_spelling(name) {
          if !reserved_loaded {
            reserved = reserved_names(linked)
            reserved_loaded = true
          } else {
            ()
          }
          checked = checked + 1
          if !has(reserved, name) {
            Array::push(bad, name + "\t" + index)
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      i = i + 1
    }
    if checked == 0 {
      die("no user-callable mapped name was checked at all; the parser has drifted")
    } else if Array::length(bad) > 0 {
      let bad_sorted = sort_str(bad)
      let mut lines = "a user-callable capability is mapped onto a conditionally-reserved import\nit never reserves, so a program using only that spelling builds clean and\nemits a module that does not validate (#2905):"
      let mut b = 0
      while b < Array::length(bad_sorted) {
        let row = Array::get(bad_sorted, b)
        lines = lines + "\n  " + field(row, 0) + " lowers onto " + field(row, 1) + " but never reserves it"
        b = b + 1
      }
      die(lines)
    } else {
      println("import-reservation: ok (" + __to_string(checked) + " user-callable spellings all reserve the import they lower onto)")
    }
  }
}
