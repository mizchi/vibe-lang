// #906: same shape as main.vibe, but calls mid_value with the WRONG
// argument type. mid_value's signature only exists because leaf.vibe's
// checked environment reached mid.vibe -- so this is a TWO-HOP proof that
// the discovery walker's DAG-based scheduling (leaf before mid before this
// file) actually installs each real signature, not just each name, across
// more than one edge. A single-hop version of this proof already exists in
// scripts/module_job_dir_test.sh; this fixture is the on-disk,
// multi-hop, real-project version driven by parallel_project_driver.mjs.
import ./leaf.vibe {
  leaf_value
}

import ./mid.vibe {
  mid_value
}

export fn main_value() -> Int {
  leaf_value(1) + mid_value("not an int")
}
