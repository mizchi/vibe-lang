// #906: leaf of a small on-disk fixture DAG for
// scripts/parallel_project_driver.mjs. No imports.
export fn leaf_value(n: Int) -> Int {
  n + 10
}

// Second export used only by main_repeated_import.vibe, which imports this
// file through two SEPARATE `import` statements (one per name). See that
// file for why.
export fn leaf_double(n: Int) -> Int {
  n * 2
}
