// #906: middle of a diamond -- imported by both main.vibe and (directly)
// alongside leaf.vibe, so leaf.vibe is reachable from main.vibe via two
// paths. Discovery must dedupe leaf.vibe by resolved path, not walk it
// (and re-typecheck it) once per importer.
import ./leaf.vibe {
  leaf_value
}

export fn mid_value(n: Int) -> Int {
  leaf_value(n) + 5
}
