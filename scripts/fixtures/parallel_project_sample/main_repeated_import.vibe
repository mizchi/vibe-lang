// #1126 Codex review: a module that imports the SAME file through two
// separate `import` statements is valid vibe, and the serial compiler
// accepts it -- but collect_import_deps_from_stmts (loader/header_cache.
// vibe) does not dedupe, so VIBE_LIST_DEPS reports leaf.vibe TWICE for
// this file. A discovery driver that fed that raw list straight into the
// scheduler's (deduped-by-construction) dependency edges would throw
// "duplicate dependency" and be unable to check this file at all, even
// though nothing here is actually wrong.
import ./leaf.vibe {
  leaf_value
}

import ./leaf.vibe {
  leaf_double
}

export fn main_value() -> Int {
  leaf_value(1) + leaf_double(2)
}
