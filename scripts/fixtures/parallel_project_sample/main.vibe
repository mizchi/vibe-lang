// #906: entry point completing the diamond -- imports leaf.vibe directly
// AND mid.vibe (which itself imports leaf.vibe). A discovery walker that
// deduped by (importer, raw import text) instead of by resolved path would
// see two distinct "leaf.vibe" edges here and could double-schedule it.
import ./leaf.vibe {
  leaf_value
}

import ./mid.vibe {
  mid_value
}

export fn main_value() -> Int {
  leaf_value(1) + mid_value(2)
}
