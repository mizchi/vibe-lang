// Every scripts/**/*.vibex declares the least authority it runs with, and
// dropping any of it is refused before the tool runs (#3676):
//
//   bash scripts/vibe_run.sh scripts/check_vibex_grants.vibex -- <cli.wasm> [file.vibex ...]
//   bash scripts/vibe_run.sh scripts/check_vibex_grants.vibex -- --list
//
// Run from the repository root. For each `fn ... allows <row>` declaration
// (every scripts/**/*.vibex by default):
//
// 1. The file checks clean as written.
// 2. Each label in the row is needed: with that label removed (the last one
//    becomes `allows ()`), `vibe check` must refuse the file. A label the file
//    still checks clean without is authority it does not use -- `Stderr` next
//    to `Console` is one, since `Console` already authorizes it.
// 3. The refusal is actionable: an `effect row mismatch` that names what is
//    missing and the edit (`hint: change 'allows ...' to ...`, or
//    `hint: declare 'fn main allows ...'` once the row is empty).
// 4. A whole capability is not granted where some of its operations are all
//    the file uses: removing `Fs` must be refused for `Fs` itself, not only for
//    `Fs::read_bytes`. `Console` counts the legacy tty labels as its own.
// 5. Every label is judged against what the refusal names. A refusal that
//    names neither the label nor an operation of it fails -- which is how an
//    effectset grant ends, since the compiler names its members: a grant
//    under scripts/ spells its members instead.
//
// The declarations come from the compiler (`vibe symbols`, function rows), not
// from a text pattern: a header is read from the function's name to the `{`
// that opens its body, across lines and past `//` comments. A `main` whose row
// cannot be read fails; it is never left unchecked. The default corpus leaves
// out this gate's own file (a gate must not see itself); its grant is checked
// by naming it, as the self-test does. A probe is
// the file with one label removed, written next to it (its relative imports
// must still resolve) under a dot-name and removed afterwards. The checks run
// four at a time through one generated job script.

import @vibe/builtin {
  String::index_of_from, String::replace_all
}
import @vibe/process {
  exit, sh_capture
}
import @vibex/shell {
  find, sort_str
}

struct Clause {
  file: String;
  name: String;
  line: Int;
  row_start: Int;
  row_end: Int;
  labels: Array[String]
}

struct Job {
  file: String;
  probe: String;
  line: Int;
  label: String
}

//# Arguments and files

fn arg(i: Int) -> String with Env {
  if i < Env::args_len() {
    Env::args_get(i)
  } else {
    ""
  }
}

fn shell_quote(s: String) -> String {
  "'" + String::replace_all(s, "'", "'\\''") + "'"
}

fn basename(path: String) -> String {
  let parts = String::split(path, "/")
  Array::get(parts, Array::length(parts) - 1)
}

fn dirname(path: String) -> String {
  let base = basename(path)
  if String::length(path) == String::length(base) {
    "."
  } else {
    String::substring(path, 0, String::length(path) - String::length(base) - 1)
  }
}

/// This gate's own file: never in the corpus it sweeps by default (a gate
/// must not be able to see itself). Its grant is checked by naming it
/// explicitly, which scripts/check_vibex_grants_test.sh does.
fn self_path() -> String {
  "scripts/check_vibex_grants.vibex"
}

/// Every scripts/**/*.vibex, without the dot-named probes and without this
/// gate.
fn default_files() -> Array[String] with Fs {
  let out: Array[String] = []
  let entries = find("scripts")
  let mut i = 0
  while i < Array::length(entries) {
    let e = Array::get(entries, i)
    if !e.is_dir && String::ends_with(e.path, ".vibex") && !String::starts_with(basename(e.path), ".") && e.path != self_path() {
      Array::push(out, e.path)
    } else {
      ()
    }
    i = i + 1
  }
  sort_str(out)
}

//# Declarations

fn is_space(c: Int) -> Bool {
  c == ' ' || c == '\t' || c == '\n' || c == '\r'
}

fn is_word(c: Int) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

fn line_of(src: String, at: Int) -> Int {
  let mut n = 1
  let mut i = 0
  while i < at && i < String::length(src) {
    if String::byte_at(src, i) == '\n' {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

/// The `allows` row of the function whose name ends at `name_end`, as the
/// byte range of its text. `allows` is found in the header (before the first
/// `{` at bracket depth 0, skipping `//` comments and string literals); the
/// row itself is then read by its own grammar (`row_end`), so whatever follows
/// it -- a `where` contract, the body -- is never part of it. `(-1, -1)` when
/// the header has no row, or one this grammar cannot read.
fn row_of(src: String, name_end: Int) -> (Int, Int) {
  let n = String::length(src)
  let mut depth = 0
  let mut i = name_end
  let mut row = -1
  let mut stop = -1
  while stop < 0 && i < n {
    let c = String::byte_at(src, i)
    if c == '/' && i + 1 < n && String::byte_at(src, i + 1) == '/' {
      while i < n && String::byte_at(src, i) != '\n' {
        i = i + 1
      }
    } else if c == '"' {
      i = i + 1
      while i < n && String::byte_at(src, i) != '"' {
        if String::byte_at(src, i) == '\\' {
          i = i + 1
        } else {
          ()
        }
        i = i + 1
      }
    } else if c == '(' || c == '[' {
      depth = depth + 1
    } else if c == ')' || c == ']' {
      depth = depth - 1
    } else if c == '{' && depth == 0 {
      stop = i
    } else if depth == 0 && c == 'a' && row < 0 && i > 0 && i + 6 <= n && String::substring(src, i, i + 6) == "allows" && !is_word(String::byte_at(src, i - 1)) && (i + 6 >= n || !is_word(String::byte_at(src, i + 6))) {
      row = i + 6
    } else {
      ()
    }
    i = i + 1
  }
  if row < 0 || stop < 0 {
    (-1, -1)
  } else {
    let s = skip_blank(src, row)
    let e = row_end(src, s)
    if e < 0 {
      (-1, -1)
    } else {
      (s, e)
    }
  }
}

/// The first byte at or after `i` that is not whitespace or in a `//` comment.
fn skip_blank(src: String, from: Int) -> Int {
  let n = String::length(src)
  let mut i = from
  let mut moved = true
  while moved {
    moved = false
    while i < n && is_space(String::byte_at(src, i)) {
      i = i + 1
      moved = true
    }
    if i + 1 < n && String::byte_at(src, i) == '/' && String::byte_at(src, i + 1) == '/' {
      while i < n && String::byte_at(src, i) != '\n' {
        i = i + 1
      }
      moved = true
    } else {
      ()
    }
  }
  i
}

fn is_ident_start(c: Int) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

/// One label from `i`: `Name`, `Name::op`, `Name[args]`, each with an optional
/// `?` grade. Its end, or -1 when no label starts at `i`.
fn label_end(src: String, from: Int) -> Int {
  let n = String::length(src)
  if from >= n || !is_ident_start(String::byte_at(src, from)) {
    -1
  } else {
    let mut i = from
    let mut more = true
    while more {
      while i < n && is_word(String::byte_at(src, i)) {
        i = i + 1
      }
      if i + 2 < n && String::byte_at(src, i) == ':' && String::byte_at(src, i + 1) == ':' && is_ident_start(String::byte_at(src, i + 2)) {
        i = i + 2
      } else {
        more = false
      }
    }
    if i < n && String::byte_at(src, i) == '[' {
      let mut depth = 0
      let mut closed = false
      while i < n && !closed {
        let c = String::byte_at(src, i)
        if c == '[' {
          depth = depth + 1
        } else if c == ']' {
          depth = depth - 1
          closed = depth == 0
        } else {
          ()
        }
        i = i + 1
      }
    } else {
      ()
    }
    let after = skip_blank(src, i)
    if after < n && String::byte_at(src, after) == '?' {
      after + 1
    } else {
      i
    }
  }
}

/// The end of the row that starts at `from`: `()`, or labels joined by `+`.
/// -1 when the text there is not a row.
fn row_end(src: String, from: Int) -> Int {
  let n = String::length(src)
  if from < n && String::byte_at(src, from) == '(' {
    let close = skip_blank(src, from + 1)
    if close < n && String::byte_at(src, close) == ')' {
      close + 1
    } else {
      -1
    }
  } else {
    let mut end = label_end(src, from)
    let mut going = end >= 0
    while going {
      let next = skip_blank(src, end)
      if next < n && String::byte_at(src, next) == '+' {
        let e = label_end(src, skip_blank(src, next + 1))
        if e < 0 {
          end = -1
          going = false
        } else {
          end = e
        }
      } else {
        going = false
      }
    }
    end
  }
}

/// The row's text without its `//` comments.
fn strip_comments(row: String) -> String {
  let lines = String::split(row, "\n")
  let kept: Array[String] = []
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    let at = String::index_of(line, "//")
    if at < 0 {
      Array::push(kept, line)
    } else {
      Array::push(kept, String::substring(line, 0, at))
    }
    i = i + 1
  }
  String::join(kept, " ")
}

/// A label as the compiler spells it in a diagnostic: whitespace carries no
/// meaning inside one (`Fs ?` is `Fs?`), so none is kept.
fn canonical(label: String) -> String {
  let out = StringBuilder::new()
  let mut i = 0
  while i < String::length(label) {
    let c = String::byte_at(label, i)
    if !is_space(c) {
      StringBuilder::push(out, String::from_byte(c))
    } else {
      ()
    }
    i = i + 1
  }
  StringBuilder::freeze(out)
}

fn row_labels(written: String) -> Array[String] {
  let out: Array[String] = []
  let row = strip_comments(written)
  if String::trim(row) != "()" {
    let parts = String::split(row, "+")
    let mut i = 0
    while i < Array::length(parts) {
      let p = canonical(Array::get(parts, i))
      if p != "" {
        Array::push(out, p)
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
  out
}

/// The row with `label` removed; `()` when nothing is left.
fn row_without(labels: Array[String], label: String) -> String {
  let kept: Array[String] = []
  let mut i = 0
  while i < Array::length(labels) {
    if Array::get(labels, i) != label {
      Array::push(kept, Array::get(labels, i))
    } else {
      ()
    }
    i = i + 1
  }
  if Array::length(kept) == 0 {
    "()"
  } else {
    String::join(kept, " + ")
  }
}

/// The function rows (LSP kind 12) of `vibe symbols --with-path`, as
/// `path name kind start end [doc]`: each one's `allows` clause, kept even
/// when the row is `()` (it is read; it has no label to probe). The second
/// result names each `main` whose row could not be read, which must fail
/// rather than leave the file unchecked.
fn clauses_of(symbols: String) -> (Array[Clause], Array[String]) with Fs {
  let out: Array[Clause] = []
  let unread: Array[String] = []
  let lines = String::split(symbols, "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let f = String::split(Array::get(lines, i), " ")
    if Array::length(f) >= 5 && Array::get(f, 2) == "12" {
      let path = Array::get(f, 0)
      let name = Array::get(f, 1)
      let src = Fs::read_file(path)
      let (s, e) = row_of(src, parse_int(Array::get(f, 4)))
      if s >= 0 {
        Array::push(out, Clause::{
          file: path,
          name: name,
          line: line_of(src, s),
          row_start: s,
          row_end: e,
          labels: row_labels(String::substring(src, s, e))
        })
      } else if name == "main" {
        Array::push(unread, "\{path}:\{line_of(src, parse_int(Array::get(f, 3)))}")
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  (out, unread)
}

fn parse_int(s: String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < String::length(s) && String::byte_at(s, i) >= '0' && String::byte_at(s, i) <= '9' {
    v = v * 10 + (String::byte_at(s, i) - '0')
    i = i + 1
  }
  v
}

//# Verdicts

/// The labels a refusal names as missing, across all its diagnostics.
fn missing_labels(out: String) -> Array[String] {
  let found: Array[String] = []
  let mut at = String::index_of(out, "missing { ")
  while at >= 0 {
    let from = at + 10
    let close = String::index_of_from(out, " }", from)
    if close < 0 {
      at = -1
    } else {
      let parts = String::split(String::substring(out, from, close), ",")
      let mut i = 0
      while i < Array::length(parts) {
        Array::push(found, String::trim(Array::get(parts, i)))
        i = i + 1
      }
      at = String::index_of_from(out, "missing { ", close)
    }
  }
  found
}

fn contains(xs: Array[String], x: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) {
    if Array::get(xs, i) == x {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// A label or a missing item without its optional grade: `Fs?` is `Fs`,
/// `Fs::read_file?` is `Fs::read_file` (ADR-0088). The width comparison is
/// between providers and their operations, whatever the grade.
fn ungraded(s: String) -> String {
  if String::ends_with(s, "?") {
    String::substring(s, 0, String::length(s) - 1)
  } else {
    s
  }
}

fn in_family(item: String, label: String) -> Bool {
  if label == "Console" {
    in_family(item, "Stdin") || in_family(item, "Stdout") || in_family(item, "Stderr") || item == "Console" || String::starts_with(item, "Console[")
  } else {
    item == label || String::starts_with(item, label + "[")
  }
}

fn op_of(item: String, label: String) -> Bool {
  if label == "Console" {
    String::starts_with(item, "Console::") || String::starts_with(item, "Stdin::") || String::starts_with(item, "Stdout::") || String::starts_with(item, "Stderr::")
  } else {
    String::starts_with(item, label + "::")
  }
}

/// Whether a diagnostic carries the edit: a `hint:` line that names the
/// `allows` row to write -- `change 'allows ...' to ...`, or, once the row is
/// empty, `declare 'fn main allows ...'`.
fn hint_names_allows(out: String) -> Bool {
  let lines = String::split(out, "\n")
  let mut found = false
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if String::index_of(line, "hint:") >= 0 && String::index_of(line, "allows") >= 0 {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The verdict on one probe: "" when the label is needed at its width, else
/// the failure line.
fn verdict(job: Job, rc: Int, out: String) -> String {
  let at = "\{job.file}:\{job.line}"
  if rc == 0 {
    "FAIL \{at}: `\{job.label}` is not needed -- the file checks clean without it; drop it from `allows`"
  } else if String::index_of(out, "effect row mismatch") < 0 || !hint_names_allows(out) {
    let first = Array::get(String::split(out, "\n"), 0)
    "FAIL \{at}: dropping `\{job.label}` was refused, but not as a missing grant with an edit to make:\n       \{first}"
  } else {
    let missing = missing_labels(out)
    let (coarse, ops) = matched(missing, job.label)
    label_verdict(at, job.label, missing, coarse, ops)
  }
}

/// What the refusal asks for, read against one label: whether it names the
/// label itself (any grade), and which of its operations it names.
fn matched(missing: Array[String], label: String) -> (Bool, Array[String]) {
  let base = ungraded(label)
  let ops: Array[String] = []
  let mut coarse = false
  let mut i = 0
  while i < Array::length(missing) {
    let item = Array::get(missing, i)
    if in_family(ungraded(item), base) {
      coarse = true
    } else if op_of(ungraded(item), base) && !contains(ops, item) {
      Array::push(ops, item)
    } else {
      ()
    }
    i = i + 1
  }
  (coarse, ops)
}

/// A refusal that names neither the label nor an operation of it says nothing
/// about the label, and fails rather than pass unread. That is also how an
/// effectset grant ends: the compiler expands a set before admission, so its
/// refusal names members, never the set. This gate does not re-derive that
/// expansion (it would be a second, drifting copy of the checker's); a grant
/// under scripts/ spells its members, and the failure says so. A capability
/// where only operations are named is wider than its use.
fn label_verdict(at: String, label: String, missing: Array[String], coarse: Bool, ops: Array[String]) -> String {
  if !coarse && Array::length(ops) == 0 {
    "FAIL \{at}: dropping `\{label}` was refused, but the refusal names neither it nor an operation of it (missing: \{String::join(missing, ", ")}). If `\{label}` is an effectset, write its members in `allows` instead: this gate judges each granted label against what the compiler asks for"
  } else if !coarse && String::index_of(ungraded(label), "::") < 0 {
    "FAIL \{at}: `\{label}` is wider than its use -- the file needs only `\{String::join(sort_str(ops), " + ")}`"
  } else {
    ""
  }
}

//# Running the checks

fn check_command(cli: String, path: String) -> String {
  "VIBE_CLI_WASM=\{shell_quote(cli)} VIBE_RUNNER=scripts/viberun_node.sh bash runtime/vibe check \{shell_quote(path)}"
}

/// Runs `vibe check` on every path, four at a time, and returns each one's
/// (exit status, output) in order.
fn check_all(cli: String, paths: Array[String], work: String) -> Array[(Int, String)] with Fs + Process {
  let script = StringBuilder::new()
  let mut i = 0
  while i < Array::length(paths) {
    StringBuilder::push(script, "( \{check_command(cli, Array::get(paths, i))} > \{work}/\{i}.out 2>&1; echo $? > \{work}/\{i}.rc ) &\n")
    if i % 4 == 3 {
      StringBuilder::push(script, "wait\n")
    } else {
      ()
    }
    i = i + 1
  }
  StringBuilder::push(script, "wait\n")
  Fs::write_file("\{work}/jobs.sh", StringBuilder::freeze(script))
  let _ = sh_capture("bash \{shell_quote(work + "/jobs.sh")}")
  let out: Array[(Int, String)] = []
  let mut j = 0
  while j < Array::length(paths) {
    let rc_path = "\{work}/\{j}.rc"
    let rc = if Fs::is_file(rc_path) {
      parse_int(String::trim(Fs::read_file(rc_path)))
    } else {
      -1
    }
    let text = if Fs::is_file("\{work}/\{j}.out") {
      Fs::read_file("\{work}/\{j}.out")
    } else {
      ""
    }
    Array::push(out, (rc, text))
    j = j + 1
  }
  out
}

fn unread_files(unread: Array[String]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(unread) {
    Array::push(out, Array::get(String::split(Array::get(unread, i), ":"), 0))
    i = i + 1
  }
  out
}

fn run(cli: String, files: Array[String]) -> Int with Env + Fs + Process + Console {
  // VIBE_GRANTS_TAG keeps concurrent runs (the self-test beside the gate
  // lane) out of each other's work directory and probe names.
  let tag = if Env::get("VIBE_GRANTS_TAG") == "" {
    "run"
  } else {
    Env::get("VIBE_GRANTS_TAG")
  }
  let work = "_build/vibex_grants.\{tag}"
  Fs::remove_tree(work)
  Fs::mkdir_p(work)
  let mut failures = 0
  // 1. As written.
  let written = check_all(cli, files, work)
  let checked: Array[String] = []
  let mut i = 0
  while i < Array::length(files) {
    let (rc, out) = Array::get(written, i)
    if rc != 0 {
      Stderr::write_stream("FAIL \{Array::get(files, i)}: does not check clean as written:\n       \{Array::get(String::split(out, "\n"), 0)}\n")
      failures = failures + 1
    } else {
      Array::push(checked, Array::get(files, i))
    }
    i = i + 1
  }
  // 2-4. One probe per label.
  let quoted: Array[String] = []
  let mut q = 0
  while q < Array::length(checked) {
    Array::push(quoted, shell_quote(Array::get(checked, q)))
    q = q + 1
  }
  let (clauses, unread) = if Array::length(checked) > 0 {
    let sym = sh_capture("VIBE_CLI_WASM=\{shell_quote(cli)} VIBE_RUNNER=scripts/viberun_node.sh bash runtime/vibe symbols --with-path \{String::join(quoted, " ")}")
    if sym.exit_code != 0 {
      Stderr::write_stream("FAIL: vibe symbols did not read the files:\n\{sym.stderr}\n")
      failures = failures + 1
    } else {
      ()
    }
    clauses_of(sym.stdout)
  } else {
    ([], [])
  }
  let jobs: Array[Job] = []
  let probes: Array[String] = []
  let mut c = 0
  while c < Array::length(clauses) {
    let cl = Array::get(clauses, c)
    let src = Fs::read_file(cl.file)
    let mut l = 0
    while l < Array::length(cl.labels) {
      let label = Array::get(cl.labels, l)
      let probe = "\{dirname(cl.file)}/.grant_probe_\{tag}_\{Array::length(jobs)}_\{basename(cl.file)}"
      Fs::write_file(probe, String::substring(src, 0, cl.row_start) + row_without(cl.labels, label) + String::substring(src, cl.row_end, String::length(src)))
      Array::push(jobs, Job::{
        file: cl.file,
        probe: probe,
        line: cl.line,
        label: label
      })
      Array::push(probes, probe)
      l = l + 1
    }
    c = c + 1
  }
  let results = check_all(cli, probes, work)
  let mut p = 0
  while p < Array::length(jobs) {
    let (rc, out) = Array::get(results, p)
    let v = verdict(Array::get(jobs, p), rc, out)
    if v != "" {
      Stderr::write_stream("\{v}\n")
      failures = failures + 1
    } else {
      ()
    }
    Fs::remove(Array::get(probes, p))
    p = p + 1
  }
  // An entry this gate could not read the row of is not checked, so it fails
  // here rather than pass with no probe; so does a file with no entry at all.
  let mut u = 0
  while u < Array::length(unread) {
    Stderr::write_stream("FAIL \{Array::get(unread, u)}: the `allows` row of `main` could not be read\n")
    failures = failures + 1
    u = u + 1
  }
  let mut f = 0
  while f < Array::length(checked) {
    let path = Array::get(checked, f)
    let mut has = false
    let mut k = 0
    while k < Array::length(clauses) {
      let cl = Array::get(clauses, k)
      if cl.file == path && cl.name == "main" {
        has = true
      } else {
        ()
      }
      k = k + 1
    }
    if !has && !contains(unread_files(unread), path) {
      Stderr::write_stream("FAIL \{path}: no `fn main ... allows` entry was found to check\n")
      failures = failures + 1
    } else {
      ()
    }
    f = f + 1
  }
  Fs::remove_tree(work)
  if failures == 0 {
    Console::write_stream("[vibex-grants] ok (\{Array::length(files)} files, \{Array::length(jobs)} grant labels: each one needed, and dropping it is refused with the edit)\n")
    0
  } else {
    1
  }
}

fn main allows Env + Fs + Process + Console {
  let cli = arg(0)
  if cli == "--list" {
    // The default corpus, one path per line: what the self-test reads to
    // prove this gate is not in it.
    Console::write_stream(String::join(default_files(), "\n") + "\n")
  } else if cli == "" || !Fs::is_file(cli) {
    Stderr::write_stream("usage: check_vibex_grants.vibex <cli.wasm> [file.vibex ...] (from the repository root)\n")
    exit(2)
  } else if !Fs::is_file("runtime/vibe") {
    Stderr::write_stream("check_vibex_grants.vibex: run from the repository root\n")
    exit(2)
  } else {
    let given: Array[String] = []
    let mut i = 1
    while i < Env::args_len() {
      Array::push(given, Env::args_get(i))
      i = i + 1
    }
    let files = if Array::length(given) > 0 {
      given
    } else {
      default_files()
    }
    if run(cli, files) != 0 {
      exit(1)
    } else {
      ()
    }
  }
}
