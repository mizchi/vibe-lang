// The AST binary ABI's tag tables must describe THIS compiler's AST (#2510).
// #3672 ported this gate from check_ast_binary_tags.sh.
//
//   bash scripts/vibe_run.sh scripts/check_ast_binary_tags.vibex -- [--root DIR]
//
// They did not. docs/internal/compiler/ast_binary_abi.md shipped tag tables for
// the retired MoonBit host's AST -- `Int` / `Float` / `Record` / `Map` / `Set` /
// `ArrayBuilder`, plus whole enums (`ModuleRef`, `ParamLabel`, `EffectAtom`)
// this compiler has never had. `src/` was removed in #594; the tables outlived
// it by a year because nothing compared them to anything. Implementing that
// document would have encoded a shape the compiler does not have.
//
// Tag assignment is a FORWARD-COMPATIBILITY CONTRACT: the format promises a new
// variant takes a new tag and an old consumer raises UnknownTag rather than
// misreading. A table that names variants the AST does not have, or omits ones
// it does, breaks that promise silently -- an encoder written from it produces
// bytes no reader can interpret, and nothing fails until something reads them.
//
// So this checks what must hold forever, for TypeExpr, Pat, ImportKind, Expr
// and Stmt:
//   - each enum's doc section (`### <Enum> tags`) exists, and its
//     "(N variants)" count is N
//   - every declared variant has exactly one row, signature for signature
//   - every row names a variant that is actually declared
//   - tags are unique within a table
//
// It deliberately does NOT require tag == declaration position. Today they
// coincide because the tables were assigned in declaration order in one pass,
// but the contract is that a tag is FROZEN: a variant inserted mid-list later
// must take the next free tag, which would make the positions disagree while
// the format stays correct.
//
// A declared variant is a line of `export enum <Enum> {` ... `}` in
// lib/@vibe/ast/index.vpkg with its `//` comment, a trailing `;` and the
// surrounding blanks removed, and inner blank runs collapsed to one space. A
// row is a `| 0x..` line of the section, read up to the next `##` / `###`
// heading: its first cell is the tag and its second, without backticks, the
// signature. --root DIR checks another tree (the self-test's).

import @vibe/builtin {
  String::index_of_from
}
import @vibe/process {
  exit
}

fn option(name: String, fallback: String) -> String with Env {
  let mut out = fallback
  let mut i = 0
  while i + 1 < Env::args_len() {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn vpkg_rel() -> String {
  "lib/@vibe/ast/index.vpkg"
}

fn doc_rel() -> String {
  "docs/internal/compiler/ast_binary_abi.md"
}

fn under(root: String, rel: String) -> String {
  if root == "." {
    rel
  } else {
    "\{root}/\{rel}"
  }
}

fn is_blank(c: Char) -> Bool {
  c == ' ' || c == '\t'
}

/// Blank runs collapsed to one space, and the ends trimmed.
fn squeeze(s: String) -> String {
  let mut out = ""
  let mut pending = false
  let mut i = 0
  while i < String::length(s) {
    let c = String::byte_at(s, at = i)
    if is_blank(c = c) {
      pending = true
    } else {
      if pending && out != "" {
        out = out + " "
      } else {
        ()
      }
      pending = false
      out = out + String::substring(s, start = i, end = i + 1)
    }
    i = i + 1
  }
  out
}

fn without_backticks(s: String) -> String {
  let mut out = ""
  let mut i = 0
  while i < String::length(s) {
    if String::byte_at(s, at = i) != '`' {
      out = out + String::substring(s, start = i, end = i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn lines_of(text: String) -> Array[String] {
  let lines = String::split(text, sep = "\n")
  if Array::length(lines) > 0 && Array::get(lines, at = Array::length(lines) - 1) == "" {
    Array::slice(lines, start = 0, end = Array::length(lines) - 1)
  } else {
    lines
  }
}

/// The declared variants of `export enum <name> {`, in order.
fn variants(vpkg: Array[String], name: String) -> Array[String] {
  let opener = "export enum \{name} {"
  let out: Array[String] = []
  let mut inside = false
  let mut i = 0
  while i < Array::length(vpkg) {
    let line = Array::get(vpkg, at = i)
    if String::starts_with(line, prefix = opener) {
      inside = true
    } else if inside && String::starts_with(line, prefix = "}") {
      inside = false
    } else if inside {
      let cut = String::index_of_from(line, sub = "//", start = 0)
      let code = if cut >= 0 {
        String::substring(line, start = 0, end = cut)
      } else {
        line
      }
      // `;[ \t]*$`: a trailing semicolon, and the blanks after it.
      let mut end = String::length(code)
      while end > 0 && is_blank(c = String::byte_at(code, at = end - 1)) {
        end = end - 1
      }
      let body = if end > 0 && String::byte_at(code, at = end - 1) == ';' {
        String::substring(code, start = 0, end = end - 1)
      } else {
        code
      }
      let v = squeeze(s = body)
      if v != "" {
        Array::push(out, value = v)
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn has_section(doc: Array[String], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(doc) {
    if String::starts_with(Array::get(doc, at = i), prefix = "### \{name} tags") {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// The (tag, signature) rows of `### <name> tags`.
fn rows(doc: Array[String], name: String) -> Array[(String, String)] {
  let out: Array[(String, String)] = []
  let mut inside = false
  let mut i = 0
  while i < Array::length(doc) {
    let line = Array::get(doc, at = i)
    if String::starts_with(line, prefix = "### \{name} tags") {
      inside = true
    } else if inside && (String::starts_with(line, prefix = "###") || String::starts_with(line, prefix = "## ")) {
      inside = false
    } else if inside && String::starts_with(line, prefix = "| 0x") {
      let cells = String::split(line, sep = "|")
      let tag = squeeze(s = Array::get(cells, at = 1))
      let sig = if Array::length(cells) > 2 {
        squeeze(s = without_backticks(s = Array::get(cells, at = 2)))
      } else {
        ""
      }
      Array::push(out, value = (tag, sig))
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn is_digits(s: String) -> Bool {
  let mut ok = String::length(s) > 0
  let mut i = 0
  while i < String::length(s) {
    let c = String::byte_at(s, at = i)
    if c < '0' || c > '9' {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// N from the first heading spelled exactly `### <name> tags (N variants)`,
/// or "".
fn declared_count(doc: Array[String], name: String) -> String {
  let prefix = "### \{name} tags ("
  let suffix = " variants)"
  let mut out = ""
  let mut i = 0
  while i < Array::length(doc) && out == "" {
    let line = Array::get(doc, at = i)
    if String::starts_with(line, prefix = prefix) && String::ends_with(line, suffix = suffix) && String::length(line) > String::length(prefix) + String::length(suffix) {
      let n = String::substring(line, start = String::length(prefix), end = String::length(line) - String::length(suffix))
      if is_digits(s = n) {
        out = n
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn count_of(xs: Array[String], x: String) -> Int {
  let mut n = 0
  let mut i = 0
  while i < Array::length(xs) {
    if Array::get(xs, at = i) == x {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

fn fail_line(msg: String) -> Unit with Stderr::write_stream {
  Stderr::write_stream("[ast-binary-tags] FAIL: \{msg}\n")
}

/// Checks one enum; true when it holds.
fn check_enum(vpkg: Array[String], vpkg_path: String, doc: Array[String], name: String) -> Bool with Stderr::write_stream {
  let src = variants(vpkg = vpkg, name = name)
  if Array::length(src) == 0 {
    fail_line(msg = "no 'export enum \{name}' found in \{vpkg_path}")
    false
  } else if !has_section(doc = doc, name = name) {
    fail_line(msg = "docs/internal/compiler/ast_binary_abi.md has no '### \{name} tags' section")
    false
  } else {
    let mut ok = true
    let declared = declared_count(doc = doc, name = name)
    if declared == "" {
      fail_line(msg = "'### \{name} tags' heading must end with '(N variants)'")
      ok = false
    } else if declared != "\{Array::length(src)}" {
      fail_line(msg = "\{name} heading says \{declared} variants, \{vpkg_path} declares \{Array::length(src)}")
      ok = false
    } else {
      ()
    }
    let table = rows(doc = doc, name = name)
    let tags: Array[String] = []
    let sigs: Array[String] = []
    let mut i = 0
    while i < Array::length(table) {
      let (tag, sig) = Array::get(table, at = i)
      Array::push(tags, value = tag)
      Array::push(sigs, value = sig)
      i = i + 1
    }
    let reported: Array[String] = []
    let mut t = 0
    while t < Array::length(tags) {
      let tag = Array::get(tags, at = t)
      if count_of(xs = tags, x = tag) > 1 && count_of(xs = reported, x = tag) == 0 {
        fail_line(msg = "\{name} has a duplicate tag \{tag}")
        Array::push(reported, value = tag)
        ok = false
      } else {
        ()
      }
      t = t + 1
    }
    let mut v = 0
    while v < Array::length(src) {
      let variant = Array::get(src, at = v)
      let in_doc = count_of(xs = sigs, x = variant)
      if in_doc == 0 {
        fail_line(msg = "\{name} variant declared in \{vpkg_path} has no row: \{variant}")
        ok = false
      } else if in_doc != count_of(xs = src, x = variant) {
        fail_line(msg = "\{name} variant has \{in_doc} rows, expected \{count_of(xs = src, x = variant)}: \{variant}")
        ok = false
      } else {
        ()
      }
      v = v + 1
    }
    let mut r = 0
    while r < Array::length(sigs) {
      let sig = Array::get(sigs, at = r)
      if count_of(xs = src, x = sig) == 0 {
        fail_line(msg = "\{name} row names no declared variant: \{sig}")
        ok = false
      } else {
        ()
      }
      r = r + 1
    }
    ok
  }
}

fn main allows Env + Fs::is_file + Fs::read_file + Console::write_stream + Stderr::write_stream + Process::exit {
  let root = option(name = "--root", fallback = ".")
  let vpkg_path = under(root = root, rel = vpkg_rel())
  let doc_path = under(root = root, rel = doc_rel())
  if !Fs::is_file(vpkg_path) {
    fail_line(msg = "missing \{vpkg_path}")
    exit(1)
  } else if !Fs::is_file(doc_path) {
    fail_line(msg = "missing \{doc_path}")
    exit(1)
  } else {
    let vpkg = lines_of(text = Fs::read_file(vpkg_path))
    let doc = lines_of(text = Fs::read_file(doc_path))
    let enums = ["TypeExpr", "Pat", "ImportKind", "Expr", "Stmt"]
    let mut ok = true
    let mut e = 0
    while e < Array::length(enums) {
      if !check_enum(vpkg = vpkg, vpkg_path = vpkg_path, doc = doc, name = Array::get(enums, at = e)) {
        ok = false
      } else {
        ()
      }
      e = e + 1
    }
    if ok {
      Console::write_stream("[ast-binary-tags] ok\n")
    } else {
      exit(1)
    }
  }
}
