// Split a test file list across shards by weight. Heavier files go first;
// each one lands in the lightest shard, and a tie keeps the lower shard
// index. Within a shard the original order is restored.
//
//   bash scripts/vibe_run.sh scripts/select_test_shard.vibex -- \
//     --index 0 --total 4 --root . --weights weights.json -- a.vibe b.vibe
//   bash scripts/vibe_run.sh scripts/select_test_shard.vibex -- --self-test
//
// A missing weights file is an empty map. A negative or unreadable weight
// is ignored and the file weighs 1000. A file under --root is stored
// relative to it, with backslashes turned into slashes.

import @vibe/builtin { String::compare, String::replace_all }
import @vibe/json {
  Json, Json::get_opt, Json::keys, Json::number, Json::parse, Json::string, Json::type_of
}
import @vibex/argparse { after_dash, flag, option }
import @vibex/tasks { die }

struct ShardItem {
  file: String;
  key: String;
  original: Int;
  weight: Float64
}

fn require_int(name: String, raw: String) -> Int with Stderr + Process {
  if raw == "" {
    die("missing " + name)
    0
  } else {
    match Int::parse(raw) {
      Some(n) => n,
      None => {
        die("invalid " + name + ": " + raw)
        0
      }
    }
  }
}

/// An absolute path with `.` and `..` segments and repeated slashes folded,
/// as `path.resolve` did in the Node original. A relative path is returned
/// unchanged. Without this `--root sub/..` resolved to `/repo/sub/..`, which
/// is not a prefix of `/repo/a_test.vibe`, so the file kept an absolute key
/// and silently took the default weight (#3167 review).
fn canonical_abs(path: String) -> String {
  if !String::starts_with(path, prefix = "/") {
    path
  } else {
    let parts = String::split(path, sep = "/")
    let kept: Array[String] = []
    let mut i = 0
    while i < Array::length(parts) {
      let seg = Array::get(parts, at = i)
      if seg == "" || seg == "." {
        ()
      } else if seg == ".." {
        if Array::length(kept) > 0 {
          Array::truncate(kept, length = Array::length(kept) - 1)
        } else {
          ()
        }
      } else {
        Array::push(kept, value = seg)
      }
      i = i + 1
    }
    let mut out = ""
    let mut k = 0
    while k < Array::length(kept) {
      out = out + "/" + Array::get(kept, at = k)
      k = k + 1
    }
    if out == "" { "/" } else { out }
  }
}

fn normalize_path(raw_file: String, root: String) -> String {
  let file = canonical_abs(path = raw_file)
  let rel = if root != "" && String::starts_with(file, prefix = "/") && String::starts_with(root, prefix = "/") {
    relative_to(root = canonical_abs(path = root), file = file)
  } else {
    file
  }
  String::replace_all(rel, pattern = "\\", replacement = "/")
}

/// `path.relative(root, file)` for two canonical absolute paths: the shared
/// leading segments drop, and each remaining root segment becomes `..`. A file
/// OUTSIDE the root keeps a relative key (`../other/a_test.vibe`) rather than
/// staying absolute, which matched no weight and silently took the default
/// (#3167 review).
fn relative_to(root: String, file: String) -> String {
  let rs = abs_segments(path = root)
  let fs = abs_segments(path = file)
  let mut common = 0
  while common < Array::length(rs) && common < Array::length(fs) && Array::get(rs, at = common) == Array::get(fs, at = common) {
    common = common + 1
  }
  let parts: Array[String] = []
  let mut i = common
  while i < Array::length(rs) {
    Array::push(parts, value = "..")
    i = i + 1
  }
  let mut j = common
  while j < Array::length(fs) {
    Array::push(parts, value = Array::get(fs, at = j))
    j = j + 1
  }
  let mut out = ""
  let mut k = 0
  while k < Array::length(parts) {
    out = if k == 0 { Array::get(parts, at = k) } else { out + "/" + Array::get(parts, at = k) }
    k = k + 1
  }
  out
}

fn abs_segments(path: String) -> Array[String] {
  let out: Array[String] = []
  let raw = String::split(path, sep = "/")
  let mut i = 0
  while i < Array::length(raw) {
    let seg = Array::get(raw, at = i)
    if seg != "" { Array::push(out, value = seg) } else { () }
    i = i + 1
  }
  out
}

/// The directory keys are made relative to. The Node original resolved
/// `--root` against the working directory and defaulted it to the working
/// directory itself; without that, an absolute file list keeps absolute keys,
/// no key in the weights file matches, and every file silently weighs the
/// default -- round-robin wearing a weighted name. `--root .` (the documented
/// spelling) needed the same resolution to match an absolute path at all.
fn resolve_root(opt: String, cwd: String) -> String {
  if opt == "" {
    canonical_abs(path = cwd)
  } else if String::starts_with(opt, prefix = "/") {
    canonical_abs(path = opt)
  } else {
    canonical_abs(path = cwd + "/" + opt)
  }
}

/// Every token before `--` must be one of this tool's options. The lookups
/// (`option`, `flag`) each ask for one name and ignore the rest, so a typo
/// such as `--weigths w.json` used to leave weighting silently OFF; the Node
/// original rejected unknown arguments (#3167 review). Returns the first
/// offending token, or "" when the command line is well formed.
fn first_unknown_arg(args: Array[String]) -> String {
  let valued = ["--index", "--total", "--root", "--weights"]
  let mut bad = ""
  let mut i = 0
  while i < Array::length(args) && bad == "" {
    let a = Array::get(args, at = i)
    if a == "--" {
      i = Array::length(args)
    } else if a == "--self-test" {
      i = i + 1
    } else if edp_contains(xs = valued, x = a) {
      if i + 1 < Array::length(args) {
        i = i + 2
      } else {
        bad = a + " (missing value)"
      }
    } else if String::contains(a, needle = "=") && edp_contains(xs = valued, x = String::substring(a, start = 0, end = String::index_of(a, needle = "="))) {
      i = i + 1
    } else {
      bad = a
    }
  }
  bad
}

fn edp_contains(xs: Array[String], x: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) && !found {
    if Array::get(xs, at = i) == x { found = true } else { () }
    i = i + 1
  }
  found
}

fn process_args() -> Array[String] with Env {
  let out: Array[String] = []
  let mut i = 0
  while i < Env::args_len() {
    Array::push(out, value = Env::args_get(i))
    i = i + 1
  }
  out
}

fn weight_num(v: Json) -> Float64 {
  let parsed = match Json::type_of(v) {
    "number" => Some(Json::number(v)),
    "string" => Float64::parse(Json::string(v)),
    _ => None
  }
  match parsed {
    Some(n) => if n >= 0.0 && is_finite(d = n) { n } else { 0.0 - 1.0 },
    None => 0.0 - 1.0
  }
}

/// `Double::parse("Infinity")` answers +inf, and an infinite weight gives its
/// bin an infinite load, pushing every later file elsewhere. The Node original
/// kept only `Number.isFinite` weights. `inf - inf` is NaN and NaN is not
/// equal to itself, so this is false for both infinities and for NaN.
fn is_finite(d: Float64) -> Bool {
  d - d == 0.0
}

fn show_weight(w: Float64) -> String {
  let as_int = Float64::to_int(w)
  if Int::to_float64(as_int) == w {
    __to_string(as_int)
  } else {
    __to_string(w)
  }
}

fn load_weight_keys(path: String) -> Array[String] with Fs + Stderr + Process {
  if path == "" || !Fs::exists(path) {
    []
  } else {
    let parsed = Json::parse(Fs::read_file(path))
    if Json::type_of(parsed) != "object" {
      die("weights file must be a JSON object: " + path)
      []
    } else {
      let raw = Json::keys(parsed)
      let out: Array[String] = []
      let mut i = 0
      while i < Array::length(raw) {
        Array::push(out, value = String::replace_all(Array::get(raw, at = i), pattern = "\\", replacement = "/"))
        i = i + 1
      }
      out
    }
  }
}

fn load_weight_values(path: String, keys: Array[String]) -> Array[Float64] with Fs {
  let out: Array[Float64] = []
  if path == "" || !Fs::exists(path) {
    out
  } else {
    let parsed = Json::parse(Fs::read_file(path))
    // `keys` holds one slash-normalized key per raw JSON key, in the same
    // order (load_weight_keys), so each value is read by its RAW key at the
    // same index. Reconstructing the raw spelling from the normalized one
    // found `a/b` and `a\\b` but not a mixed `a\\b/c`, whose weight then
    // silently became the default (#3167 review).
    let raw = Json::keys(parsed)
    let mut i = 0
    while i < Array::length(keys) && i < Array::length(raw) {
      let value = match Json::get_opt(parsed, key = Array::get(raw, at = i)) {
        Some(v) => v,
        None => Json::parse("null")
      }
      Array::push(out, value = weight_num(v = value))
      i = i + 1
    }
    out
  }
}

/// The Node original normalized every key into one object, so of two raw
/// keys that normalize alike (`dir\\f.vibe` and `dir/f.vibe`) the LATER one
/// won, and a key match beat a match on the file as written
/// (`weights[key] ?? weights[file]`). Invalid values were never stored, so
/// they cannot shadow a valid earlier entry. Search from the end for each
/// spelling in that order (#3167 review).
fn last_weight(keys: Array[String], values: Array[Float64], want: String) -> Float64 {
  let mut i = Array::length(keys) - 1
  let mut found = 0.0 - 1.0
  while i >= 0 && found < 0.0 {
    if Array::get(keys, at = i) == want {
      found = Array::get(values, at = i)
    } else {
      ()
    }
    i = i - 1
  }
  found
}

fn weight_for(keys: Array[String], values: Array[Float64], key: String, file: String) -> Float64 {
  let by_key = last_weight(keys = keys, values = values, want = key)
  if by_key >= 0.0 {
    by_key
  } else {
    let by_file = last_weight(keys = keys, values = values, want = file)
    if by_file >= 0.0 { by_file } else { 1000.0 }
  }
}

fn heavier(a: Float64, b: Float64) -> Bool {
  a > b
}

fn before(a: ShardItem, b: ShardItem) -> Bool {
  if heavier(a = a.weight, b = b.weight) {
    true
  } else if heavier(a = b.weight, b = a.weight) {
    false
  } else {
    match String::compare(a.key, b = b.key) {
      Less => true,
      Greater => false,
      Equal => a.original < b.original
    }
  }
}

fn sort_by_weight(xs: Array[ShardItem]) -> Unit {
  let mut i = 1
  while i < Array::length(xs) {
    let key = Array::get(xs, at = i)
    let mut j = i
    while j > 0 && before(a = key, b = Array::get(xs, at = j - 1)) {
      Array::set(xs, at = j, value = Array::get(xs, at = j - 1))
      j = j - 1
    }
    Array::set(xs, at = j, value = key)
    i = i + 1
  }
}

fn sort_by_origin(xs: Array[ShardItem]) -> Unit {
  let mut i = 1
  while i < Array::length(xs) {
    let key = Array::get(xs, at = i)
    let mut j = i
    while j > 0 && key.original < Array::get(xs, at = j - 1).original {
      Array::set(xs, at = j, value = Array::get(xs, at = j - 1))
      j = j - 1
    }
    Array::set(xs, at = j, value = key)
    i = i + 1
  }
}

fn select_shard(files: Array[String], index: Int, total: Int, root: String, keys: Array[String], values: Array[Float64]) -> Array[String] with Stderr + Process {
  if index < 0 {
    die("invalid shard index: " + __to_string(index))
  } else if total <= 0 {
    die("invalid shard total: " + __to_string(total))
  } else if index >= total {
    die("shard index must be less than total: " + __to_string(index) + "/" + __to_string(total))
  } else {
    ()
  }
  let items: Array[ShardItem] = []
  let mut i = 0
  while i < Array::length(files) {
    let file = Array::get(files, at = i)
    let key = normalize_path(raw_file = file, root = root)
    Array::push(items, value = ShardItem::{
      file: file,
      key: key,
      original: i,
      weight: weight_for(keys = keys, values = values, key = key, file = file)
    })
    i = i + 1
  }
  sort_by_weight(xs = items)
  let bins: Array[Array[ShardItem]] = []
  let loads: Array[Float64] = []
  let mut b = 0
  while b < total {
    Array::push(bins, value = [])
    Array::push(loads, value = 0.0)
    b = b + 1
  }
  let mut k = 0
  while k < Array::length(items) {
    let item = Array::get(items, at = k)
    let mut best = 0
    let mut t = 1
    while t < total {
      if heavier(a = Array::get(loads, at = best), b = Array::get(loads, at = t)) {
        best = t
      } else {
        ()
      }
      t = t + 1
    }
    Array::push(Array::get(bins, at = best), value = item)
    Array::set(loads, at = best, value = Array::get(loads, at = best) + item.weight)
    k = k + 1
  }
  let chosen = Array::get(bins, at = index)
  sort_by_origin(xs = chosen)
  let out: Array[String] = []
  let mut c = 0
  while c < Array::length(chosen) {
    Array::push(out, value = Array::get(chosen, at = c).file)
    c = c + 1
  }
  out
}

fn expect(cond: Bool, message: String) -> Unit with Stderr + Process {
  if cond { () } else { die("select-test-shard: " + message) }
}

fn joined(xs: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(xs) {
    if i > 0 { out = out + "," } else { () }
    out = out + Array::get(xs, at = i)
    i = i + 1
  }
  out
}

fn kept_weights(path: String) -> String with Fs + Stderr + Process {
  let keys = load_weight_keys(path = path)
  let values = load_weight_values(path = path, keys = keys)
  let mut out = ""
  let mut i = 0
  while i < Array::length(keys) {
    let w = Array::get(values, at = i)
    if w >= 0.0 {
      if out != "" { out = out + "," } else { () }
      out = out + Array::get(keys, at = i) + "=" + show_weight(w = w)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn self_test() -> Unit with Fs + Console + Stderr + Process {
  let root = "/tmp/repo"
  expect(
    cond = normalize_path(raw_file = root + "/lib/@vibe/compiler/a_test.vibe", root = root) == "lib/@vibe/compiler/a_test.vibe",
    message = "absolute path stays relative"
  )
  // No --root, or `--root .`, means the working directory, so an absolute
  // file list still yields the relative keys the weights file uses.
  expect(cond = resolve_root(opt = "", cwd = root) == root, message = "an omitted --root is the working directory")
  expect(cond = resolve_root(opt = ".", cwd = root) == root, message = "--root . is the working directory")
  expect(cond = resolve_root(opt = "sub", cwd = root) == root + "/sub", message = "a relative --root resolves against the working directory")
  expect(cond = resolve_root(opt = "/abs", cwd = root) == "/abs", message = "an absolute --root is kept")
  expect(cond = resolve_root(opt = "sub/..", cwd = root) == root, message = "dot segments in --root are folded")
  expect(cond = resolve_root(opt = "./a/./b/../c/", cwd = root) == root + "/a/c", message = "./, . and .. fold like path.resolve")
  expect(
    cond = normalize_path(raw_file = root + "/x/../lib/y_test.vibe", root = resolve_root(opt = "sub/..", cwd = root)) == "lib/y_test.vibe",
    message = "a file and a root with dot segments still meet on a relative key"
  )
  // A file outside the root gets a `..` key, as path.relative gave it.
  expect(cond = normalize_path(raw_file = "/repo/other/a_test.vibe", root = "/repo/sub") == "../other/a_test.vibe", message = "outside the root: " + normalize_path(raw_file = "/repo/other/a_test.vibe", root = "/repo/sub"))
  expect(cond = normalize_path(raw_file = "/repo/sub/x/a_test.vibe", root = "/repo/sub") == "x/a_test.vibe", message = "inside the root stays a plain relative key")
  expect(cond = normalize_path(raw_file = "rel/a_test.vibe", root = "/repo") == "rel/a_test.vibe", message = "a relative file is kept as written")
  // Unknown arguments are refused instead of silently switching weighting off.
  expect(cond = first_unknown_arg(args = ["--index", "0", "--total", "2", "--weights", "w.json", "--", "a.vibe"]) == "", message = "a well-formed line is accepted")
  expect(cond = first_unknown_arg(args = ["--index=0", "--total=2", "--root=.", "--", "--weigths"]) == "", message = "= forms are accepted; tokens after -- are files")
  expect(cond = first_unknown_arg(args = ["--index", "0", "--weigths", "w.json"]) == "--weigths", message = "a misspelled option is named")
  expect(cond = first_unknown_arg(args = ["--index", "0", "stray"]) == "stray", message = "a stray positional before -- is refused")
  expect(cond = first_unknown_arg(args = ["--index"]) == "--index (missing value)", message = "an option with no value is refused")
  expect(
    cond = normalize_path(raw_file = root + "/lib/x_test.vibe", root = resolve_root(opt = "", cwd = root)) == "lib/x_test.vibe",
    message = "an absolute file under the default root gets a relative key"
  )
  let files = ["a_test.vibe", "b_test.vibe", "c_test.vibe", "d_test.vibe", "e_test.vibe"]
  let keys = ["a_test.vibe", "b_test.vibe", "c_test.vibe", "d_test.vibe", "e_test.vibe"]
  let values = [1.0, 10.0, 9.0, 1.0, 1.0]
  expect(cond = joined(xs = select_shard(files = files, index = 0, total = 2, root = "", keys = keys, values = values)) == "b_test.vibe,d_test.vibe", message = "shard 0")
  expect(cond = joined(xs = select_shard(files = files, index = 1, total = 2, root = "", keys = keys, values = values)) == "a_test.vibe,c_test.vibe,e_test.vibe", message = "shard 1")
  expect(cond = Array::length(load_weight_keys(path = "/tmp/missing-selfhost-weights.json")) == 0, message = "missing weights file is empty")
  let dir = "_build/select-test-shard-selftest"
  if Fs::exists(dir) { Fs::remove_tree(dir) } else { () }
  Fs::mkdir_p(dir)
  let wpath = dir + "/weights.json"
  Fs::write_file(wpath, contents = "{\"keep\":3,\"nested\\\\path\":2,\"negative\":-1,\"stringy\":\"4\",\"bad\":\"nan\",\"inf\":\"Infinity\",\"neginf\":\"-Infinity\"}\n")
  let got = kept_weights(path = wpath)
  expect(cond = String::contains(got, needle = "keep=3"), message = "keep: " + got)
  expect(cond = String::contains(got, needle = "nested/path=2"), message = "nested: " + got)
  expect(cond = String::contains(got, needle = "stringy=4"), message = "stringy: " + got)
  expect(cond = !String::contains(got, needle = "negative"), message = "negative was kept: " + got)
  expect(cond = !String::contains(got, needle = "bad"), message = "nan was kept: " + got)
  expect(cond = !String::contains(got, needle = "inf"), message = "an infinite weight was kept: " + got)
  // A key mixing both separators keeps its weight.
  let mixed_path = dir + "/mixed.json"
  Fs::write_file(mixed_path, contents = "{\"dir\\\\sub/file.vibe\":7}\n")
  let mixed = kept_weights(path = mixed_path)
  expect(cond = mixed == "dir/sub/file.vibe=7", message = "mixed-separator key lost its weight: " + mixed)
  // Two raw keys normalizing alike: the later one wins, like the Node
  // original's object. An invalid later value does not shadow a valid one,
  // and a key match beats a match on the file as written.
  let dup_path = dir + "/dup.json"
  Fs::write_file(dup_path, contents = "{\"dir\\\\f.vibe\":1,\"dir/f.vibe\":10,\"dir/g.vibe\":5,\"dir\\\\g.vibe\":-1,\"/abs/dir/h.vibe\":3,\"dir/h.vibe\":6}\n")
  let dup_keys = load_weight_keys(path = dup_path)
  let dup_values = load_weight_values(path = dup_path, keys = dup_keys)
  expect(cond = weight_for(keys = dup_keys, values = dup_values, key = "dir/f.vibe", file = "dir/f.vibe") == 10.0, message = "the later of two alike keys must win")
  expect(cond = weight_for(keys = dup_keys, values = dup_values, key = "dir/g.vibe", file = "dir/g.vibe") == 5.0, message = "an invalid later value shadowed a valid one")
  expect(cond = weight_for(keys = dup_keys, values = dup_values, key = "dir/h.vibe", file = "/abs/dir/h.vibe") == 6.0, message = "the normalized key must beat the file as written")
  let frac_path = dir + "/frac.json"
  Fs::write_file(frac_path, contents = "{\"a_test.vibe\":0.9,\"b_test.vibe\":0.8,\"c_test.vibe\":0.1}\n")
  let frac_files = ["a_test.vibe", "b_test.vibe", "c_test.vibe"]
  let frac_keys = load_weight_keys(path = frac_path)
  let frac_values = load_weight_values(path = frac_path, keys = frac_keys)
  expect(cond = joined(xs = select_shard(files = frac_files, index = 0, total = 2, root = "", keys = frac_keys, values = frac_values)) == "a_test.vibe", message = "fractional shard 0")
  expect(cond = joined(xs = select_shard(files = frac_files, index = 1, total = 2, root = "", keys = frac_keys, values = frac_values)) == "b_test.vibe,c_test.vibe", message = "fractional shard 1")
  Fs::remove_tree(dir)
  println("select-test-shard: ok")
}

fn main() -> Unit allows Env + Fs + Console + Process {
  if flag("--self-test") {
    self_test()
  } else {
    let unknown = first_unknown_arg(args = process_args())
    if unknown != "" {
      die("select-test-shard: unknown argument: " + unknown + " (expected --index N --total N [--root DIR] [--weights FILE] -- FILES...)")
    } else {
      ()
    }
    let index = require_int(name = "--index", raw = option("--index"))
    let total = require_int(name = "--total", raw = option("--total"))
    let root = resolve_root(opt = option("--root"), cwd = Fs::getcwd())
    let weights = option("--weights")
    let keys = load_weight_keys(path = weights)
    let chosen = select_shard(files = after_dash(), index = index, total = total, root = root, keys = keys, values = load_weight_values(path = weights, keys = keys))
    let mut i = 0
    while i < Array::length(chosen) {
      println(Array::get(chosen, at = i))
      i = i + 1
    }
  }
}
