checkTaskfileFmt = new pkf.Task {
  name = "check-taskfile-fmt"
  description = "pkl formatting of the task definitions (mirrors the `validate Pkl configs` CI job)"
  cmd = "pkf format --check Taskfile.pkl scripts/pkfire/common.pkl scripts/pkfire/quality_tasks.pkl"
