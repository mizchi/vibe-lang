// Independent validation tasks; dependency orchestration lives in Taskfile.pkl.
import "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.14.2#/Taskfile.pkl" as pkf

import "common.pkl" as common

local vibeSources = common.vibeSources
local scriptSources = common.scriptSources
local compilerProbeInputs = common.compilerProbeInputs

formalCheck = new pkf.Task {
  name = "formal-check"
  description = "prove the Lean models and verify committed Oracle corpora"
  cmd = "formal/check-oracle.sh"
  inputs {
    "formal/**/*.lean"
    "formal/oracle/**"
    "formal/examples/**"
    "formal/check-oracle.sh"
    "formal/lakefile.toml"
    "formal/lake-manifest.json"
    "formal/lean-toolchain"
  }
}

formalIncrementalCheck = new pkf.Task {
  name = "formal-incremental-check"
  description = "prove the bounded Lean incremental invalidation model"
  cmd = "cd formal && lake build --wfail VibeFormal.Proofs.IncrementalCorrect"
  inputs {
    "formal/VibeFormal/Compiler/Incremental.lean"
    "formal/VibeFormal/Proofs/IncrementalCorrect.lean"
    "formal/lakefile.toml"
    "formal/lake-manifest.json"
    "formal/lean-toolchain"
  }
}

testIncrementalInvalidationOracle = new pkf.Task {
  name = "test-incremental-invalidation-oracle"
