checkDocCommands = new pkf.Task {
  name = "check-doc-commands"
  description = "commands shown in docs name tasks, scripts and env vars that exist"
  cmd = "bash scripts/check_doc_commands.sh"
  // Everything this gate READS, on both sides of the comparison: the documents
  // it scans and the tree it resolves their references against. Under the
  // default inputs it saw the documents but not tests/**, eval/** or
  // install/**, so every VIBE_* lookup came back empty and 38 live variables
  // were reported as unread -- the gate failing loudly rather than passing
  // vacuously, but wrong either way.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "Taskfile.pkl"
    "*.md"
    "docs/**/*.md"
    "book/**/*.md"
    // Every README in the tree, wherever it lives -- the gate now scans them
    // all (#2138 review), so lib/@vibe/compiler/README.md going stale must
    // invalidate this task the same way docs/ does. compilerProbeInputs covers
    // lib/**/*.vibe but not lib/**/README.md.
    "**/README.md"
    // The launcher IS the verb list: the gate parses `vibe help` and the
    // dispatch case out of it, so adding or removing a command has to
    // re-run this comparison.
    "runtime/vibe"
    // Every glob the script SCANS, not a subset of it (#2138 review): it reads
    // .js/.ts/.toml/.md under these roots too, so an env-var reader removed
    // from scripts/wasm_vibe_host_runner.js would otherwise replay the old
    // verdict. Inputs may over-approximate; they may never under-.
    "scripts/**"
    "tests/**"
    "eval/**"
    "install/**"
    "scripts/doc_commands_allowlist.tsv"
  }
}

