}

checkTaskInputs = new pkf.Task {
  name = "check-task-inputs"
  description = "a task that runs the compiler keys on the compiler"
  cmd = "bash scripts/check_task_inputs.sh"
  inputs {
    ...scriptSources
    "Taskfile.pkl"
  }
}

checkFuzzCompilerIdentity = new pkf.Task {
  name = "check-fuzz-compiler-identity"
  description =
    "the fuzz harness resolves its compiler strictly (HEAD's generation or a named artifact) instead of picking the newest by mtime"
  cmd = "bash scripts/check_fuzz_compiler_identity.sh"
  // Both probes die at compiler RESOLUTION and never compile anything, but
  // `check_task_inputs.sh` reads the reachable scripts, and run_fuzz.sh does
  // name the wasm runner. Spelling the extra inputs out must ADD to the
  // defaults rather than replace them: a hand-written `new Task` inherits
  // nothing, so an inputs list without this spread is a NARROWER cache key
  // than no list at all, and a compiler change would replay a stale pass.
  // Same reasoning as check-fuzz-stale-findings: one of this gate's probes
  // mutates run_fuzz.sh so that it PROCEEDS, so the fuzzer's own dependencies
  // are reachable from this task and belong in its key.
  inputs {
    ...compilerProbeInputs
    "tests/fuzz/run_fuzz.sh"
    // The gate reads BOTH entry points to the oracle since #2959, so both
    // belong in its key. Measured with it missing: after a warm cache, an
    // edit putting classify.sh back on the mtime default replayed
    // `check-fuzz-compiler-identity: ok` from cache, while running the
    // script directly rejected the same tree.
    "tests/fuzz/classify.sh"
    "tests/fuzz/gen_program.py"
    "tests/fuzz/lib_oracle.sh"
    "scripts/run_wasm_vibe_host_runner.sh"
    "scripts/wasm_vibe_host_runner.js"
    "scripts/wasm_vibe_host_runtime.js"
    "scripts/resolve_stage2.sh"
    "scripts/check_fuzz_compiler_identity.sh"
    "scripts/check_fuzz_compiler_identity_test.sh"
  }
}

checkFuzzClassify = new pkf.Task {
  name = "check-fuzz-classify"
  description =
    "classify.sh reports an unlocated or invented-token diagnostic (DIAG_NO_LOCATION / DIAG_INTERNAL_TOKEN) and a wrong answer every lane shares (ORACLE_*) instead of passing them (#2979)"
  cmd = "bash tests/fuzz/classify_test.sh"
  // The compiler and both runtimes are STUBS here, so the verdict under test
  // is fixed; but lib_oracle.sh names the real wasm runner as its default, so
  // the compiler inputs stay in the key rather than argue about reachability.
  inputs {
    ...compilerProbeInputs
    "tests/fuzz/classify.sh"
    "tests/fuzz/classify_test.sh"
    "tests/fuzz/lib_oracle.sh"
    "scripts/resolve_stage2.sh"
    "scripts/run_wasm_vibe_host_runner.sh"
    "scripts/wasm_vibe_host_runner.js"
    "scripts/wasm_vibe_host_runtime.js"
  }
}

