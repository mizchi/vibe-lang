testCoverageScripts = new pkf.Task {
  name = "test-coverage-scripts"
  cmd =
    "node --test scripts/coverage_suite_next_branches.test.mjs && python3 scripts/coverage_suite_report_test.py && bash scripts/vibe_run.sh scripts/coverage_tracks.vibex -- --self-test && bash scripts/vibe_run.sh scripts/select_test_shard.vibex -- --self-test && bash scripts/coverage_wasm_std_test.sh && bash tests/gates/tooling-accounting/coverage/coverage_drivers_test.sh && bash tests/gates/tooling-accounting/coverage/coverage_pipeline_contract_test.sh"
  // Runs a wrapper under tests/gates/** that invokes the compiler, so the
  // compiler identity is part of the answer (#2138 review, #2165).
  inputs {
    ...compilerProbeInputs
    "scripts/**/*.mjs"
    "scripts/coverage_suite_report.py"
    "scripts/coverage_suite_report_test.py"
    "scripts/coverage_tracks.vibex"
    "scripts/select_test_shard.vibex"
    // The runner vibe_run.sh executes the .vibex self-tests through.
    "scripts/wasm_vibe_host_runner.js"
    "scripts/wasm_vibe_host_runtime.js"
    "scripts/coverage_corpus.sh"
    ...scriptSources
    "scripts/coverage_drivers.sh"
    "scripts/coverage_local_merge_run.sh"
    "tests/gates/tooling-accounting/coverage/coverage_drivers_test.sh"
    "tests/gates/tooling-accounting/coverage/coverage_pipeline_contract_test.sh"
  }
}

testPickCliFreshness = new pkf.Task {
  name = "test-pick-cli-freshness"
  description =
    "runtime/vibe uses the AOT .cwasm only when neither the runner nor the compiler wasm is newer than it (Codex review of #2858)"
  cmd = "bash scripts/test_pick_cli_freshness.sh"
  // The gate drives a fake toolchain layout through the launcher and never
  // executes a wasm; its verdict depends on the launcher and the script.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "runtime/vibe"
  }
}

testPickCliFreshnessSelfTest = new pkf.Task {
  name = "test-pick-cli-freshness-self-test"
  description =
    "mutates pick_cli's freshness comparisons out of runtime/vibe and asserts test-pick-cli-freshness goes red"
  cmd = "bash scripts/test_pick_cli_freshness_test.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "runtime/vibe"
  }
}

testReleaseInstall = new pkf.Task {
  name = "test-release-install"
  description =
    "release install and update against a synthetic file:// release: install.sh --version with bash+curl+tar, vibe self update, tampered assets refused (#2678)"
  cmd = "bash tests/integration/install/release_install_test.sh"
  inputs {
    "tests/integration/install/release_install_test.sh"
    "install/install.sh"
    "runtime/vibe"
    "scripts/vibe_pkg.sh"
    "scripts/parallel_warm_pool.sh"
  }
}

testSeedAssetIdentity = new pkf.Task {
  name = "test-seed-asset-identity"
  description =
    "red/green for the seed-manifest identity guard: a manifest naming another seed must not ship under this tag"
  cmd = "bash scripts/build_compiler_seed_assets_test.sh"
  // The scratch tree holds a fake artifact and no generate_bundle.sh, so this
  // verdict does not actually depend on compiler identity -- but the guard it
  // copies does reach the compiler lexically, and check-task-inputs refuses to
  // guess. Over-approximate rather than assert the exemption: the run is 0.1s.
  inputs {
    ...compilerProbeInputs
    "scripts/build_compiler_seed_assets_test.sh"
    "scripts/build_compiler_seed_assets.sh"
  }
}

testReleaseBody = new pkf.Task {
  name = "test-release-body"
  description =
    "red/green for the release-body builder: relative links absolutized at the tag, an unresolvable or escaping link refused"
  cmd = "bash scripts/build_release_body_test.sh"
  inputs {
    "scripts/build_release_body_test.sh"
    "scripts/build_release_body.sh"
  }
}

testReleaseAssetsArgs = new pkf.Task {
  name = "test-release-assets-args"
  description =
    "red/green for the release asset builder's tag validation: a pre-release tag is accepted, junk and a launcher/tag disagreement are refused"
  cmd = "bash scripts/build_release_assets_test.sh"
  inputs {
    // The cases stop at argument handling and never reach a compiler, but the
    // script under test does; an exemption asserted here is the gate's own
    // failure mode, and replaying a 0.4s test costs less than being wrong.
    ...compilerProbeInputs
    "scripts/build_release_assets_test.sh"
    "scripts/build_release_assets.sh"
  }
}

testVibeLibrary = new pkf.Task {
  name = "test-library"
  // Smoke-run the selfhost-CLI-compilable subset of library `*_test.vibe`
  // (lib/@vibex/wasm, lib/@vibe/builtin). The selfhost-only gate only covers the
  // compiler self-compile, so this is the regression net for library modules
  // (the MoonBit-host flaker suite was retired in #594). Allow-list lives in the
  // script; also run in cli-install CI and the `cli` selfhost-gate shard.
  cmd = "bash scripts/test_vibe_library.sh"
  cache = false
}

testLocal = new pkf.Task {
  name = "test-local"
  description = "affected local tests via flaker"
  cmd = "scripts/flaker_run.sh $@"
  acceptsArgs = true
  cache = false
}

testAffected = new pkf.Task {
  name = "test-affected"
  description = "tests reachable from the change via the real import graph (#988)"
  cmd = "bash scripts/test_affected.sh $@"
  acceptsArgs = true
  cache = false
}

testCompareCompilerMemory = new pkf.Task {
  name = "test-compare-compiler-memory"
  cmd = "node --test scripts/compare_compiler_memory.test.mjs"
  cache = false
}

testEditCycleKpi = new pkf.Task {
  name = "test-edit-cycle-kpi"
  description =
    "validate incremental harness units: KPI telemetry, phase summaries, cache artifact reading"
  cmd =
    "node --test scripts/edit_cycle_kpi.test.mjs scripts/incremental_phase_summary.test.mjs scripts/cache_artifacts.test.mjs"
  cache = false
}

checkTaskEnv = new pkf.Task {
  name = "check-task-env"
  description = "internal: report the LD_LIBRARY_PATH a task inherits, and run a system binary"
  cmd =
    "printf 'task-env: LD_LIBRARY_PATH=%s\\n' \"${LD_LIBRARY_PATH:-}\"; sort --version >/dev/null 2>&1 && echo 'task-env: sort ok' || echo 'task-env: sort FAILED'"
  cache = false
  visibility = "internal"
}

testCheckedModuleCacheParity = new pkf.Task {
  name = "test-checked-module-cache-parity"
  description =
    "compare checked-module cache output and diagnostics; --units adds the complete unit corpus"
  cmd = "bash scripts/checked_module_cache_parity.sh $@"
  acceptsArgs = true
  cache = false
}

testSelfhostUnit = new pkf.Task {
  name = "test-unit"
  description = "run every discovered *_test.vibe through the selfhost compiler (#531/#535)"
  cmd = "bash scripts/unit_test_runner.sh $@"
  acceptsArgs = true
  cache = false
}

checkTutorialTranslationParity = new pkf.Task {
  name = "check-tutorial-translation-parity"
  description =
    "every original tour chapter in book/en has a book/ja translation, and each pair runs the same programs"
  cmd = "bash scripts/check_tutorial_translation_parity.sh"
  // vibe_md.sh proves each file on its own; this is the part it cannot see.
  // Two files that run the same programs record the same ```output blocks, so
  // comparing those catches code drift between a chapter and its translation
  // without diffing sources, which legitimately differ in their comments.
  cache = false
}
