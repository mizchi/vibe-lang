// #1556: print the two coverage tracks side by side, and ratchet each.
//
// in-process is what the compiled tests execute. self-compile is what the
// compiler executes while compiling a corpus. Neither number includes the
// other, so a missing report is a failed check, not a quiet pass.
//
//   bash scripts/vibe_run.sh scripts/coverage_tracks.vibex -- [--check]
//   bash scripts/vibe_run.sh scripts/coverage_tracks.vibex -- --self-test
//
// Paths and floors are the same env names the shell suite already uses,
// plus VIBE_COVERAGE_TRACK_SUITE / VIBE_COVERAGE_TRACK_CORPUS so a check
// can point at a fixture without editing the defaults.

import @vibe/builtin { String::pad_right }
import @vibe/console { eprintln }
import @vibe/json { Json, Json::bool, Json::get_opt, Json::number, Json::parse, Json::type_of }
import @vibe/process { exit }
import @vibex/shell { env_or }
import @vibex/argparse { flag }
import @vibex/tasks { die }

struct Track {
  name: String;
  what: String;
  hit: Int;
  total: Int;
  rate: Float64;
  exact: Bool;
  min_rate: Float64
}

/// A floor from the environment: unset or blank means the default, and
/// anything else must parse. A typo such as `40,03` used to fall back to the
/// default -- for the self-compile floor that is 0.0, so a ratchet someone
/// set was silently switched off. The Python original raised on it.
fn parse_floor(raw: String, fallback: Float64) -> Option[Float64] {
  let text = String::trim(raw)
  if text == "" {
    Some(fallback)
  } else {
    Float64::parse(text)
  }
}

fn env_double(name: String, fallback: Float64) -> Float64 with Env + Stderr + Process {
  let raw = Env::get(name)
  match parse_floor(raw = raw, fallback = fallback) {
    Some(v) => v,
    None => {
      die("[coverage-tracks] " + name + "='" + raw + "' is not a number; unset it for the default")
      fallback
    }
  }
}

fn read_obj(path: String) -> Option[Json] with Fs {
  if !Fs::exists(path) {
    None
  } else {
    let parsed = Json::parse(Fs::read_file(path))
    if Json::type_of(parsed) == "object" {
      Some(parsed)
    } else {
      None
    }
  }
}

fn obj_field(obj: Json, key: String) -> Option[Json] {
  match Json::get_opt(obj, key = key) {
    Some(v) => if Json::type_of(v) == "object" { Some(v) } else { None },
    None => None
  }
}

fn num_or(obj: Json, key: String, fallback: Float64) -> Float64 {
  match Json::get_opt(obj, key = key) {
    Some(v) => if Json::type_of(v) == "number" { Json::number(v) } else { fallback },
    None => fallback
  }
}

fn bool_or(obj: Json, key: String, fallback: Bool) -> Bool {
  match Json::get_opt(obj, key = key) {
    Some(v) => if Json::type_of(v) == "boolean" { Json::bool(v) } else { fallback },
    None => fallback
  }
}

/// Python's default `str` of a coverage rate: one decimal when the
/// hundredths digit is 0 (`57.0`, `10.0`), otherwise two (`57.88`, `40.03`).
fn format_rate(d: Float64) -> String {
  let neg = d < 0.0
  let abs = if neg { 0.0 - d } else { d }
  let scaled = Float64::to_int(abs * 100.0 + 0.5)
  let whole = scaled / 100
  let frac = scaled % 100
  let frac_s = if frac % 10 == 0 {
    __to_string(frac / 10)
  } else if frac < 10 {
    "0" + __to_string(frac)
  } else {
    __to_string(frac)
  }
  let body = __to_string(whole) + "." + frac_s
  if neg { "-" + body } else { body }
}

/// hit/total as a percentage rounded to hundredths, half to even, DEFINED on
/// the exact ratio: the percentage in hundredths is hit*10000/total, and a
/// tie is a remainder of exactly half the divisor.
///
/// This is a deliberate rebaseline, not a port. The replaced script computed
/// `round(hit / total * 100, 2)`, whose answer at an exact midpoint depends on
/// which way the binary intermediate happened to round: 1/32 is exactly
/// 3.125 and went to even (3.12), but 23/160 is exactly 14.375 and went DOWN
/// (14.37), because 23/160*100 is 14.374999999999998 as a Double. Matching
/// that needs the Double's bits, which this language does not expose, and it
/// would make the gate's answer a property of float rounding rather than of
/// the counts. The two definitions differ only at exact midpoints, by 0.01;
/// the floors CI uses are the defaults (57.0 and 0.0, whole numbers) and no
/// workflow or task sets a two-decimal one, so no current verdict moves.
/// Adding 0.5 instead (the first port) rounded every tie up, 1/32 to 3.13.
fn pct(hit: Int, total: Int) -> Float64 {
  if total <= 0 {
    0.0
  } else {
    // The printed rate is this rounded value, and so is the one compared to
    // the floor, or a 40.029 that prints as 40.03 fails a 40.03 floor.
    let num = hit * 10000
    let q = num / total
    let twice_r = (num - q * total) * 2
    let hundredths = if twice_r > total {
      q + 1
    } else if twice_r == total && q % 2 == 1 {
      q + 1
    } else {
      q
    }
    Int::to_float64(hundredths) / 100.0
  }
}

fn push_track(out: Array[Track], name: String, what: String, hit: Int, total: Int, rate: Float64, exact: Bool, min_rate: Float64) -> Unit {
  Array::push(out, value = Track::{ name: name, what: what, hit: hit, total: total, rate: rate, exact: exact, min_rate: min_rate })
}

fn load_tracks(suite_path: String, corpus_path: String, min_in: Float64, min_self: Float64) -> Array[Track] with Fs {
  let out: Array[Track] = []
  match read_obj(path = suite_path) {
    Some(suite) => match obj_field(obj = suite, key = "branch_union") {
      Some(b) => push_track(out = out, name = "in-process", what = "branches the compiled test programs execute", hit = Float64::to_int(num_or(obj = b, key = "hit", fallback = 0.0)), total = Float64::to_int(num_or(obj = b, key = "total", fallback = 0.0)), rate = num_or(obj = b, key = "rate", fallback = 0.0), exact = bool_or(obj = b, key = "exact", fallback = true), min_rate = min_in),
      None => ()
    },
    None => ()
  }
  match read_obj(path = corpus_path) {
    Some(corpus) => match obj_field(obj = corpus, key = "branch") {
      Some(b) => {
        let hit = Float64::to_int(num_or(obj = b, key = "hit", fallback = 0.0))
        let total = Float64::to_int(num_or(obj = b, key = "total", fallback = 0.0))
        push_track(out = out, name = "self-compile", what = "compiler branches executed while compiling a corpus", hit = hit, total = total, rate = pct(hit = hit, total = total), exact = true, min_rate = min_self)
      },
      None => ()
    },
    None => ()
  }
  out
}

fn max_name(rows: Array[Track]) -> Int {
  let mut w = 0
  let mut i = 0
  while i < Array::length(rows) {
    let n = String::length(Array::get(rows, at = i).name)
    if n > w { w = n } else { () }
    i = i + 1
  }
  w
}

fn rate_below(rate: Float64, floor: Float64) -> Bool {
  // Not `rate < floor` at the call. In `report` that expression answered
  // false for 10.0 and 57.0, while the same comparison with the two values
  // bound as parameters answered true. The parameters are what make the
  // lowering see two Doubles.
  rate < floor
}

fn row_line(row: Track, width: Int) -> String {
  let note = if row.exact { "" } else { "  (LOWER BOUND)" }
  "[coverage-tracks] " + String::pad_right(row.name, target_len = width, pad_char = " ") + "  branches " + __to_string(row.hit) + "/" + __to_string(row.total) + " (" + format_rate(d = row.rate) + "%)  min " + format_rate(d = row.min_rate) + "%" + note + "  <- " + row.what
}

fn has_track(rows: Array[Track], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(rows) {
    if Array::get(rows, at = i).name == name { found = true } else { () }
    i = i + 1
  }
  found
}

/// Prints the report and returns the process status: 0 ok, 1 floor missed,
/// 2 nothing was measured.
fn report(rows: Array[Track], check: Bool) -> Int with Console {
  if Array::length(rows) == 0 {
    2
  } else {
    let width = max_name(rows = rows)
    let mut i = 0
    while i < Array::length(rows) {
      println(row_line(row = Array::get(rows, at = i), width = width))
      i = i + 1
    }
    if !has_track(rows = rows, name = "in-process") {
      println("[coverage-tracks] " + String::pad_right("in-process", target_len = width, pad_char = " ") + "  NOT MEASURED in this run")
    } else { () }
    if !has_track(rows = rows, name = "self-compile") {
      println("[coverage-tracks] " + String::pad_right("self-compile", target_len = width, pad_char = " ") + "  NOT MEASURED in this run")
    } else { () }
    if !check {
      0
    } else {
      let mut failed = false
      let mut missing = ""
      if !has_track(rows = rows, name = "in-process") {
        missing = "in-process"
      } else { () }
      if !has_track(rows = rows, name = "self-compile") {
        missing = if missing == "" { "self-compile" } else { missing + ", self-compile" }
      } else { () }
      let mut j = 0
      while j < Array::length(rows) {
        let row = Array::get(rows, at = j)
        if !row.exact {
          println("[coverage-tracks] WARN: " + row.name + " ratchet skipped (value is a lower bound)")
        } else if rate_below(rate = row.rate, floor = row.min_rate) {
          println("[coverage-tracks] GATE FAIL: " + row.name + " branch coverage " + format_rate(d = row.rate) + "% < min " + format_rate(d = row.min_rate) + "%")
          failed = true
        } else { () }
        j = j + 1
      }
      if missing != "" {
        println("[coverage-tracks] GATE FAIL: missing track(s): " + missing)
        failed = true
      } else { () }
      if failed {
        1
      } else {
        println("[coverage-tracks] gate ok")
        0
      }
    }
  }
}

fn expect(cond: Bool, message: String) -> Unit with Stderr + Process {
  if cond { () } else { die("coverage-tracks: " + message) }
}

fn self_test() -> Unit with Fs + Console + Stderr + Process {
  let base = "_build/coverage-tracks-selftest"
  if Fs::exists(base) { Fs::remove_tree(base) } else { () }
  Fs::mkdir_p(base)
  let suite = base + "/suite.json"
  let corpus = base + "/corpus.json"
  let low = base + "/low.json"
  let bound = base + "/bound.json"
  Fs::write_file(suite, contents = "{\"branch_union\":{\"hit\":26894,\"total\":46469,\"rate\":57.88,\"exact\":true}}\n")
  Fs::write_file(corpus, contents = "{\"files\":12,\"branch\":{\"hit\":10703,\"total\":26738}}\n")
  Fs::write_file(low, contents = "{\"branch_union\":{\"hit\":100,\"total\":1000,\"rate\":10.0,\"exact\":true}}\n")
  Fs::write_file(bound, contents = "{\"branch_union\":{\"hit\":100,\"total\":1000,\"rate\":10.0,\"exact\":false}}\n")
  let min_in = 57.0
  let min_self = 0.0
  expect(cond = report(rows = load_tracks(suite_path = suite, corpus_path = corpus, min_in = min_in, min_self = min_self), check = false) == 0, message = "both tracks should print")
  expect(cond = report(rows = load_tracks(suite_path = suite, corpus_path = corpus, min_in = min_in, min_self = min_self), check = true) == 0, message = "both floors clear")
  expect(cond = report(rows = load_tracks(suite_path = low, corpus_path = corpus, min_in = min_in, min_self = min_self), check = true) == 1, message = "10% must miss the in-process floor")
  expect(cond = report(rows = load_tracks(suite_path = suite, corpus_path = base + "/absent.json", min_in = min_in, min_self = min_self), check = true) == 1, message = "a missing track must fail the check")
  expect(cond = report(rows = load_tracks(suite_path = base + "/no-suite.json", corpus_path = base + "/no-corpus.json", min_in = min_in, min_self = min_self), check = true) == 2, message = "nothing measured is status 2")
  expect(cond = report(rows = load_tracks(suite_path = bound, corpus_path = corpus, min_in = min_in, min_self = min_self), check = true) == 0, message = "a lower bound skips its ratchet")
  let only = load_tracks(suite_path = base + "/no-suite.json", corpus_path = corpus, min_in = min_in, min_self = min_self)
  expect(cond = Array::length(only) == 1, message = "corpus alone is one track")
  expect(cond = Array::get(only, at = 0).name == "self-compile", message = "the one track is self-compile")
  expect(cond = format_rate(d = Array::get(only, at = 0).rate) == "40.03", message = "10703/26738 is 40.03, got " + format_rate(d = Array::get(only, at = 0).rate))
  expect(cond = !rate_below(rate = Array::get(only, at = 0).rate, floor = 40.03), message = "the printed 40.03 meets a 40.03 floor")
  // Ties go to even, as Python's round(x, 2) does: 1/32 is exactly 3.125.
  expect(cond = format_rate(d = pct(hit = 1, total = 32)) == "3.12", message = "1/32 rounds half to even (3.12), got " + format_rate(d = pct(hit = 1, total = 32)))
  expect(cond = rate_below(rate = pct(hit = 1, total = 32), floor = 3.13), message = "3.12 must miss a 3.13 floor")
  expect(cond = format_rate(d = pct(hit = 3, total = 32)) == "9.38", message = "3/32 is 9.375, which rounds to even 9.38, got " + format_rate(d = pct(hit = 3, total = 32)))
  // The rebaseline, pinned: Python read 23/160 as 14.37 through a binary
  // intermediate (14.374999999999998); the exact ratio is a tie, and even is 14.38.
  expect(cond = format_rate(d = pct(hit = 23, total = 160)) == "14.38", message = "23/160 is exactly 14.375, half to even 14.38, got " + format_rate(d = pct(hit = 23, total = 160)))
  expect(cond = format_rate(d = pct(hit = 0, total = 0)) == "0.0", message = "an empty corpus is 0.0")
  // A floor that is set must parse; unset or blank is the default.
  expect(cond = parse_floor(raw = "", fallback = 57.0) == Some(57.0), message = "blank floor is the default")
  expect(cond = parse_floor(raw = " 40.03 ", fallback = 0.0) == Some(40.03), message = "a padded floor parses")
  expect(cond = parse_floor(raw = "40,03", fallback = 0.0) == None, message = "a malformed floor is refused, not replaced by the default")
  expect(cond = format_rate(d = 57.88) == "57.88", message = "57.88")
  expect(cond = format_rate(d = 57.0) == "57.0", message = "57.0")
  expect(cond = format_rate(d = 0.0) == "0.0", message = "0.0")
  Fs::remove_tree(base)
  println("coverage-tracks: ok")
}

fn main() -> Unit allows Env + Fs + Console + Process {
  if flag("--self-test") {
    self_test()
  } else {
    let suite = env_or(name = "VIBE_COVERAGE_TRACK_SUITE", fallback = "_build/coverage/selfhost-suite/selfhost_suite.report.json")
    let corpus = env_or(name = "VIBE_COVERAGE_TRACK_CORPUS", fallback = "_build/coverage/selfhost-corpus/merged.json")
    let rows = load_tracks(suite_path = suite, corpus_path = corpus, min_in = env_double(name = "VIBE_TRACK_MIN_IN_PROCESS_RATE", fallback = 57.0), min_self = env_double(name = "VIBE_TRACK_MIN_SELF_COMPILE_RATE", fallback = 0.0))
    if Array::length(rows) == 0 {
      eprintln("[coverage-tracks] neither track has a report; run 'pkf run coverage' and/or 'pkf run coverage-corpus' first")
      exit(2)
    } else {
      let status = report(rows = rows, check = flag("--check"))
      if status != 0 { exit(status) } else { () }
    }
  }
}
