// #1556: print the two coverage tracks side by side, and ratchet each.
//
// in-process is what the compiled tests execute. self-compile is what the
// compiler executes while compiling a corpus. Neither number includes the
// other, so a missing report is a failed check, not a quiet pass.
//
//   bash scripts/vibe_run.sh scripts/coverage_tracks.vibex -- [--check]
//   bash scripts/vibe_run.sh scripts/coverage_tracks.vibex -- --self-test
//
// Paths and floors are the same env names the shell suite already uses,
// plus VIBE_COVERAGE_TRACK_SUITE / VIBE_COVERAGE_TRACK_CORPUS so a check
// can point at a fixture without editing the defaults.

import @vibe/builtin { String::pad_right }
import @vibe/console { eprintln }
import @vibe/json { Json, Json::bool, Json::get_opt, Json::number, Json::parse, Json::type_of }
import @vibe/process { exit }
import @vibex/shell { env_or }
import @vibex/argparse { flag }
import @vibex/tasks { die }

struct Track {
  name: String;
  what: String;
  hit: Int;
  total: Int;
  rate: Double;
  exact: Bool;
  min_rate: Double
}

/// A floor from the environment: unset or blank means the default, and
/// anything else must parse. A typo such as `40,03` used to fall back to the
/// default -- for the self-compile floor that is 0.0, so a ratchet someone
/// set was silently switched off. The Python original raised on it.
fn parse_floor(raw: String, fallback: Double) -> Option[Double] {
  let text = String::trim(raw)
  if text == "" {
    Some(fallback)
  } else {
    Double::parse(text)
  }
}

fn env_double(name: String, fallback: Double) -> Double with Env + Stderr + Process {
  let raw = Env::get(name)
  match parse_floor(raw, fallback) {
    Some(v) => v,
    None => {
      die("[coverage-tracks] " + name + "='" + raw + "' is not a number; unset it for the default")
      fallback
    }
  }
}

fn read_obj(path: String) -> Option[Json] with Fs {
  if !Fs::exists(path) {
    None
  } else {
    let parsed = Json::parse(Fs::read_file(path))
    if Json::type_of(parsed) == "object" {
      Some(parsed)
    } else {
      None
    }
  }
}

fn obj_field(obj: Json, key: String) -> Option[Json] {
  match Json::get_opt(obj, key) {
    Some(v) => if Json::type_of(v) == "object" { Some(v) } else { None },
    None => None
  }
}

fn num_or(obj: Json, key: String, fallback: Double) -> Double {
  match Json::get_opt(obj, key) {
    Some(v) => if Json::type_of(v) == "number" { Json::number(v) } else { fallback },
    None => fallback
  }
}

fn bool_or(obj: Json, key: String, fallback: Bool) -> Bool {
  match Json::get_opt(obj, key) {
    Some(v) => if Json::type_of(v) == "boolean" { Json::bool(v) } else { fallback },
    None => fallback
  }
}

/// Python's default `str` of a coverage rate: one decimal when the
/// hundredths digit is 0 (`57.0`, `10.0`), otherwise two (`57.88`, `40.03`).
fn format_rate(d: Double) -> String {
  let neg = d < 0.0
  let abs = if neg { 0.0 - d } else { d }
  let scaled = Double::to_int(abs * 100.0 + 0.5)
  let whole = scaled / 100
  let frac = scaled % 100
  let frac_s = if frac % 10 == 0 {
    __to_string(frac / 10)
  } else if frac < 10 {
    "0" + __to_string(frac)
  } else {
    __to_string(frac)
  }
  let body = __to_string(whole) + "." + frac_s
  if neg { "-" + body } else { body }
}

/// hit/total as a percentage rounded to hundredths, half to even -- Python's
/// `round(x, 2)`, which the replaced script used. Computed on the integers:
/// the percentage in hundredths is hit*10000/total exactly, so a tie is a
/// remainder of exactly half the divisor and needs no reasoning about how a
/// Double represents 3.125. Adding 0.5 instead rounded 1/32 up to 3.13, and a
/// 3.13 floor then passed a rate Python reported as 3.12.
fn pct(hit: Int, total: Int) -> Double {
  if total <= 0 {
    0.0
  } else {
    // The printed rate is this rounded value, and so is the one compared to
    // the floor, or a 40.029 that prints as 40.03 fails a 40.03 floor.
    let num = hit * 10000
    let q = num / total
    let twice_r = (num - q * total) * 2
    let hundredths = if twice_r > total {
      q + 1
    } else if twice_r == total && q % 2 == 1 {
      q + 1
    } else {
      q
    }
    Int::to_double(hundredths) / 100.0
  }
}

fn push_track(out: Array[Track], name: String, what: String, hit: Int, total: Int, rate: Double, exact: Bool, min_rate: Double) -> Unit {
  Array::push(out, Track::{ name: name, what: what, hit: hit, total: total, rate: rate, exact: exact, min_rate: min_rate })
}

fn load_tracks(suite_path: String, corpus_path: String, min_in: Double, min_self: Double) -> Array[Track] with Fs {
  let out: Array[Track] = []
  match read_obj(suite_path) {
    Some(suite) => match obj_field(suite, "branch_union") {
      Some(b) => push_track(out, "in-process", "branches the compiled test programs execute", Double::to_int(num_or(b, "hit", 0.0)), Double::to_int(num_or(b, "total", 0.0)), num_or(b, "rate", 0.0), bool_or(b, "exact", true), min_in),
      None => ()
    },
    None => ()
  }
  match read_obj(corpus_path) {
    Some(corpus) => match obj_field(corpus, "branch") {
      Some(b) => {
        let hit = Double::to_int(num_or(b, "hit", 0.0))
        let total = Double::to_int(num_or(b, "total", 0.0))
        push_track(out, "self-compile", "compiler branches executed while compiling a corpus", hit, total, pct(hit, total), true, min_self)
      },
      None => ()
    },
    None => ()
  }
  out
}

fn max_name(rows: Array[Track]) -> Int {
  let mut w = 0
  let mut i = 0
  while i < Array::length(rows) {
    let n = String::length(Array::get(rows, i).name)
    if n > w { w = n } else { () }
    i = i + 1
  }
  w
}

fn rate_below(rate: Double, floor: Double) -> Bool {
  // Not `rate < floor` at the call. In `report` that expression answered
  // false for 10.0 and 57.0, while the same comparison with the two values
  // bound as parameters answered true. The parameters are what make the
  // lowering see two Doubles.
  rate < floor
}

fn row_line(row: Track, width: Int) -> String {
  let note = if row.exact { "" } else { "  (LOWER BOUND)" }
  "[coverage-tracks] " + String::pad_right(row.name, width, " ") + "  branches " + __to_string(row.hit) + "/" + __to_string(row.total) + " (" + format_rate(row.rate) + "%)  min " + format_rate(row.min_rate) + "%" + note + "  <- " + row.what
}

fn has_track(rows: Array[Track], name: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(rows) {
    if Array::get(rows, i).name == name { found = true } else { () }
    i = i + 1
  }
  found
}

/// Prints the report and returns the process status: 0 ok, 1 floor missed,
/// 2 nothing was measured.
fn report(rows: Array[Track], check: Bool) -> Int with Console {
  if Array::length(rows) == 0 {
    2
  } else {
    let width = max_name(rows)
    let mut i = 0
    while i < Array::length(rows) {
      println(row_line(Array::get(rows, i), width))
      i = i + 1
    }
    if !has_track(rows, "in-process") {
      println("[coverage-tracks] " + String::pad_right("in-process", width, " ") + "  NOT MEASURED in this run")
    } else { () }
    if !has_track(rows, "self-compile") {
      println("[coverage-tracks] " + String::pad_right("self-compile", width, " ") + "  NOT MEASURED in this run")
    } else { () }
    if !check {
      0
    } else {
      let mut failed = false
      let mut missing = ""
      if !has_track(rows, "in-process") {
        missing = "in-process"
      } else { () }
      if !has_track(rows, "self-compile") {
        missing = if missing == "" { "self-compile" } else { missing + ", self-compile" }
      } else { () }
      let mut j = 0
      while j < Array::length(rows) {
        let row = Array::get(rows, j)
        if !row.exact {
          println("[coverage-tracks] WARN: " + row.name + " ratchet skipped (value is a lower bound)")
        } else if rate_below(row.rate, row.min_rate) {
          println("[coverage-tracks] GATE FAIL: " + row.name + " branch coverage " + format_rate(row.rate) + "% < min " + format_rate(row.min_rate) + "%")
          failed = true
        } else { () }
        j = j + 1
      }
      if missing != "" {
        println("[coverage-tracks] GATE FAIL: missing track(s): " + missing)
        failed = true
      } else { () }
      if failed {
        1
      } else {
        println("[coverage-tracks] gate ok")
        0
      }
    }
  }
}

fn expect(cond: Bool, message: String) -> Unit with Stderr + Process {
  if cond { () } else { die("coverage-tracks: " + message) }
}

fn self_test() -> Unit with Fs + Console + Stderr + Process {
  let base = "_build/coverage-tracks-selftest"
  if Fs::exists(base) { Fs::remove_tree(base) } else { () }
  Fs::mkdir_p(base)
  let suite = base + "/suite.json"
  let corpus = base + "/corpus.json"
  let low = base + "/low.json"
  let bound = base + "/bound.json"
  Fs::write_file(suite, "{\"branch_union\":{\"hit\":26894,\"total\":46469,\"rate\":57.88,\"exact\":true}}\n")
  Fs::write_file(corpus, "{\"files\":12,\"branch\":{\"hit\":10703,\"total\":26738}}\n")
  Fs::write_file(low, "{\"branch_union\":{\"hit\":100,\"total\":1000,\"rate\":10.0,\"exact\":true}}\n")
  Fs::write_file(bound, "{\"branch_union\":{\"hit\":100,\"total\":1000,\"rate\":10.0,\"exact\":false}}\n")
  let min_in = 57.0
  let min_self = 0.0
  expect(report(load_tracks(suite, corpus, min_in, min_self), false) == 0, "both tracks should print")
  expect(report(load_tracks(suite, corpus, min_in, min_self), true) == 0, "both floors clear")
  expect(report(load_tracks(low, corpus, min_in, min_self), true) == 1, "10% must miss the in-process floor")
  expect(report(load_tracks(suite, base + "/absent.json", min_in, min_self), true) == 1, "a missing track must fail the check")
  expect(report(load_tracks(base + "/no-suite.json", base + "/no-corpus.json", min_in, min_self), true) == 2, "nothing measured is status 2")
  expect(report(load_tracks(bound, corpus, min_in, min_self), true) == 0, "a lower bound skips its ratchet")
  let only = load_tracks(base + "/no-suite.json", corpus, min_in, min_self)
  expect(Array::length(only) == 1, "corpus alone is one track")
  expect(Array::get(only, 0).name == "self-compile", "the one track is self-compile")
  expect(format_rate(Array::get(only, 0).rate) == "40.03", "10703/26738 is 40.03, got " + format_rate(Array::get(only, 0).rate))
  expect(!rate_below(Array::get(only, 0).rate, 40.03), "the printed 40.03 meets a 40.03 floor")
  // Ties go to even, as Python's round(x, 2) does: 1/32 is exactly 3.125.
  expect(format_rate(pct(1, 32)) == "3.12", "1/32 rounds half to even (3.12), got " + format_rate(pct(1, 32)))
  expect(rate_below(pct(1, 32), 3.13), "3.12 must miss a 3.13 floor")
  expect(format_rate(pct(3, 32)) == "9.38", "3/32 is 9.375, which rounds to even 9.38, got " + format_rate(pct(3, 32)))
  expect(format_rate(pct(0, 0)) == "0.0", "an empty corpus is 0.0")
  // A floor that is set must parse; unset or blank is the default.
  expect(parse_floor("", 57.0) == Some(57.0), "blank floor is the default")
  expect(parse_floor(" 40.03 ", 0.0) == Some(40.03), "a padded floor parses")
  expect(parse_floor("40,03", 0.0) == None, "a malformed floor is refused, not replaced by the default")
  expect(format_rate(57.88) == "57.88", "57.88")
  expect(format_rate(57.0) == "57.0", "57.0")
  expect(format_rate(0.0) == "0.0", "0.0")
  Fs::remove_tree(base)
  println("coverage-tracks: ok")
}

fn main() -> Unit allows Env + Fs + Console + Stderr + Process {
  if flag("--self-test") {
    self_test()
  } else {
    let suite = env_or("VIBE_COVERAGE_TRACK_SUITE", "_build/coverage/selfhost-suite/selfhost_suite.report.json")
    let corpus = env_or("VIBE_COVERAGE_TRACK_CORPUS", "_build/coverage/selfhost-corpus/merged.json")
    let rows = load_tracks(suite, corpus, env_double("VIBE_TRACK_MIN_IN_PROCESS_RATE", 57.0), env_double("VIBE_TRACK_MIN_SELF_COMPILE_RATE", 0.0))
    if Array::length(rows) == 0 {
      eprintln("[coverage-tracks] neither track has a report; run 'pkf run coverage' and/or 'pkf run coverage-corpus' first")
      exit(2)
    } else {
      let status = report(rows, flag("--check"))
      if status != 0 { exit(status) } else { () }
    }
  }
}
