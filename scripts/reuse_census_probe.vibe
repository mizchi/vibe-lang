//# Reuse census probe (ADR-0092 / #2389). Run through scripts/reuse_census.sh.
//#
//# Classifies every `match <ident>` constructor arm of ONE flat source file
//# whose scrutinee carries a planned drop -- the gate the RC codegen's reuse
//# fusion opens on -- by the planner's own admission rule, and prints one
//# tab-separated row per arm. The source is normalized exactly as the RC
//# codegen plans it (shadow uniquify + scrutinee lift, rc_query.vibe's
//# convention), and the plan is built with the same whole-program tables.
//#
//# Row: FN SCRUTINEE CTOR ARITY spine=<tail kind of the let spine>
//#      wide=<tail kind past every straight-line wrapper> br=<all|some|none|->
//#      modes=<one char per pattern arg: c raw transfer, b borrow-only,
//#      m held (consumed once with reads), k held (consumed 2+), _ wild>
//#      alias=<y|n> scrut=<y|n> blk=<y|n> any=<y|n> verdict=<...>
//# verdict: PAIRED (the planner emits a candidate row; the codegen may still
//# decline a float source field or a non-constructor callee), nested_pat,
//# no_site (no same-arity constructor-like call outside lambda interiors),
//# blocker, alias, scrut_reused. Constructor-ness is by spelling here, as in
//# the planner.

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, expr_children
}

import @vibe/compiler/syntax {
  lex, parse_program
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars, compute_borrow_param_user_fns, compute_may_return_view_fns, md_consume_count_pre, md_shadow_zeroed_bmasks
}

import @vibe/compiler/perceus {
  PerceusAction,
  build_perceus_plan_with_params,
  compute_borrow_returning_names,
  pa_is_alias_dup,
  pa_is_drop,
  reuse_arm_has_blocker,
  reuse_arm_has_ctor_site,
  reuse_bind_mode
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Constructor-like callee: the last `::` segment starts with A-Z (the
/// planner's reuse_ctor_like).
fn ctor_like(f: String) -> Bool {
  let n = String::length(f)
  let mut i = 0
  let mut start = 0
  while i < n {
    if String::char_code_at(f, i) == 58 {
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  if start < n {
    let c = String::char_code_at(f, start)
    c >= 65 && c <= 90
  } else {
    false
  }
}

fn spine_tail(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => spine_tail(b),
    _ => e
  }
}

/// Peel every wrapper the ordinary codegen treats as a straight-line prefix.
fn wide_tail(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => wide_tail(b),
    ELetMut(_, _, b, _) => wide_tail(b),
    ELetRec(_, _, b) => wide_tail(b),
    ESeq(_, b) => wide_tail(b),
    EAssign(_, _, b) => wide_tail(b),
    EAssignOp(_, _, _, b) => wide_tail(b),
    _ => e
  }
}

fn tail_kind(t: Expr, arity: Int) -> String {
  match t {
    ECall(callee, args, _) => match callee {
      EIdent(f, _) => if ctor_like(f) {
        if Array::length(args) == arity {
          "ctor_same"
        } else {
          "ctor_diff"
        }
      } else {
        "call"
      },
      _ => "call_indirect"
    },
    EIf(_, _, _) => "if",
    EMatch(_, _) => "match",
    EIdent(_, _) => "ident",
    ERecord(_, _, _) => "record",
    ETuple(_) => "tuple",
    _ => "other"
  }
}

/// Every branch-leaf tail of a nested if/match tree (through wide spines).
fn leaves(t: Expr, arity: Int, tot: Array[Int], hit: Array[Int]) -> Unit {
  let w = wide_tail(t)
  match w {
    EIf(_, a, b) => {
      leaves(a, arity, tot, hit)
      leaves(b, arity, tot, hit)
    },
    EMatch(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        leaves(ab, arity, tot, hit)
        i = i + 1
      }
    },
    _ => {
      Array::set(tot, 0, Array::get(tot, 0) + 1)
      if tail_kind(w, arity) == "ctor_same" {
        Array::set(hit, 0, Array::get(hit, 0) + 1)
      } else {
        ()
      }
    }
  }
}

fn branch_info(t: Expr, arity: Int) -> String {
  let tot = [0]
  let hit = [0]
  leaves(t, arity, tot, hit)
  let h = Array::get(hit, 0)
  let n = Array::get(tot, 0)
  if h == 0 {
    "none"
  } else if h == n {
    "all"
  } else {
    "some"
  }
}

fn occurrences(e: Expr, name: String) -> Int {
  match e {
    EIdent(n, _) => if n == name {
      1
    } else {
      0
    },
    _ => {
      let kids = expr_children(e)
      let mut acc = 0
      let mut i = 0
      while i < Array::length(kids) {
        acc = acc + occurrences(Array::get(kids, i), name)
        i = i + 1
      }
      acc
    }
  }
}

fn yn(b: Bool) -> String {
  if b {
    "y"
  } else {
    "n"
  }
}

fn classify_arm(fname: String, sname: String, pat: Pat, abody: Expr, alias_names: Array[String], bfns: Array[String], bmasks: Array[Int]) -> Unit with Stdout {
  match pat {
    PCtor(cname, pargs) => {
      let arity = Array::length(pargs)
      if arity >= 1 {
        let mut pat_ok = true
        let mut i = 0
        while i < arity {
          match Array::get(pargs, i) {
            PBind(_) => (),
            PWild => (),
            _ => pat_ok = false
          }
          i = i + 1
        }
        let spine_kind = tail_kind(spine_tail(abody), arity)
        let wt = wide_tail(abody)
        let wide_kind = tail_kind(wt, arity)
        let binfo = if wide_kind == "if" || wide_kind == "match" {
          branch_info(wt, arity)
        } else {
          "-"
        }
        let any_site = reuse_arm_has_ctor_site(abody, arity)
        let blocker = reuse_arm_has_blocker(abody)
        let no_params: Array[String] = []
        let no_fns: Array[String] = []
        let scrut_free = name_in(collect_free_vars(abody, no_params, no_fns), sname)
        let zb = md_shadow_zeroed_bmasks(abody, bfns, bmasks)
        let modes = StringBuilder::new()
        let mut alias = false
        let mut j = 0
        while j < arity {
          match Array::get(pargs, j) {
            PBind(bn) => {
              let mode = reuse_bind_mode(abody, bn, bfns, zb)
              let m = if mode == 1 {
                "c"
              } else if mode == 0 {
                "b"
              } else if md_consume_count_pre(abody, bn, bfns, zb) == 1 {
                "m"
              } else {
                "k"
              }
              if name_in(alias_names, bn) {
                alias = true
              } else {
                ()
              }
              StringBuilder::push(modes, m)
            },
            PWild => StringBuilder::push(modes, "_"),
            _ => StringBuilder::push(modes, "?")
          }
          j = j + 1
        }
        let verdict = if !pat_ok {
          "nested_pat"
        } else if !any_site {
          "no_site"
        } else if blocker {
          "blocker"
        } else if alias {
          "alias"
        } else if scrut_free {
          "scrut_reused"
        } else {
          "PAIRED"
        }
        let line = StringBuilder::new()
        StringBuilder::push(line, fname)
        StringBuilder::push(line, "\t")
        StringBuilder::push(line, sname)
        StringBuilder::push(line, "\t")
        StringBuilder::push(line, cname)
        StringBuilder::push(line, "\t")
        StringBuilder::push(line, __to_string(arity))
        StringBuilder::push(line, "\tspine=")
        StringBuilder::push(line, spine_kind)
        StringBuilder::push(line, "\twide=")
        StringBuilder::push(line, wide_kind)
        StringBuilder::push(line, "\tbr=")
        StringBuilder::push(line, binfo)
        StringBuilder::push(line, "\tmodes=")
        StringBuilder::push(line, StringBuilder::freeze(modes))
        StringBuilder::push(line, "\talias=")
        StringBuilder::push(line, yn(alias))
        StringBuilder::push(line, "\tscrut=")
        StringBuilder::push(line, yn(scrut_free))
        StringBuilder::push(line, "\tblk=")
        StringBuilder::push(line, yn(blocker))
        StringBuilder::push(line, "\tany=")
        StringBuilder::push(line, yn(any_site))
        StringBuilder::push(line, "\tverdict=")
        StringBuilder::push(line, verdict)
        println(StringBuilder::freeze(line))
      } else {
        ()
      }
    },
    _ => ()
  }
}

fn walk(fname: String, e: Expr, drop_names: Array[String], alias_names: Array[String], bfns: Array[String], bmasks: Array[Int]) -> Unit with Stdout {
  match e {
    // A lambda's body is planned (and fused) in its own frame; its arms
    // are not this function's.
    EFn(_, _, _, _, _, _) => (),
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sname, _) => if name_in(drop_names, sname) {
          let mut ai = 0
          while ai < Array::length(arms) {
            let (apat, abody) = Array::get(arms, ai)
            classify_arm(fname, sname, apat, abody, alias_names, bfns, bmasks)
            ai = ai + 1
          }
        } else {
          ()
        },
        _ => ()
      }
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        walk(fname, Array::get(kids, i), drop_names, alias_names, bfns, bmasks)
        i = i + 1
      }
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        walk(fname, Array::get(kids, i), drop_names, alias_names, bfns, bmasks)
        i = i + 1
      }
    }
  }
}

fn census(source: String) -> Unit with Exception + Stdout {
  let stmts = parse_program(lex(source))
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts, "main", linked, iw_names, iw_wats, array_empty(), array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, 0))
  } else {
    ()
  }
  let borrow_ret = sorted_names_of(compute_borrow_returning_names(stmts))
  let masks: Array[Int] = []
  let exclude = ["main", "_start", "cli_main"]
  let borrow_param = compute_borrow_param_user_fns(stmts, exclude, masks)
  let view_ret = sorted_names_of(compute_may_return_view_fns(stmts))
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          let seen: Array[String] = []
          let norm = lift_match_scrutinees(uniquify_shadowed_bindings_fresh(value, uq_shadow_counter, seen), m_scrut_counter)
          match norm {
            EFn(_, _, nparams, _, _, nbody) => {
              let plan = build_perceus_plan_with_params(nparams, nbody, borrow_ret, borrow_param, masks, view_ret)
              let drop_names: Array[String] = []
              let alias_names: Array[String] = []
              let mut k = 0
              while k < Array::length(plan) {
                let a = Array::get(plan, k)
                if pa_is_drop(a) {
                  Array::push(drop_names, a.name)
                } else {
                  ()
                }
                if pa_is_alias_dup(a) {
                  Array::push(alias_names, a.name)
                } else {
                  ()
                }
                k = k + 1
              }
              walk(name, nbody, drop_names, alias_names, borrow_param, masks)
            },
            _ => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

test "reuse census" {
  // scripts/reuse_census.sh stages the input here.
  let src = Fs::read_file("_build/reuse_census/input.vibe")
  census(src)
}
