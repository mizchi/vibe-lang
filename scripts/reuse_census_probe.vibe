//# Reuse census probe (ADR-0092 / #2389). Run through scripts/reuse_census.sh.
//#
//# Classifies every `match <ident>` constructor arm of ONE flat source file
//# whose scrutinee carries a planned drop -- the gate the RC codegen's reuse
//# fusion opens on -- by the planner's own admission rule, and prints one
//# tab-separated row per arm. The source is normalized exactly as the RC
//# codegen plans it (shadow uniquify + scrutinee lift, rc_query.vibe's
//# convention), and the plan is built with the same whole-program tables.
//#
//# Row: FN SCRUTINEE CTOR ARITY spine=<tail kind of the let spine>
//#      wide=<tail kind past every straight-line wrapper> br=<all|some|none|->
//#      modes=<one char per pattern arg: c raw transfer, b borrow-only,
//#      m held (consumed once with reads), k held (consumed 2+), _ wild>
//#      alias=<y|n> scrut=<y|n> blk=<y|n> any=<y|n> verdict=<...>
//# verdict: PAIRED (the planner emits a candidate row; the codegen may still
//# decline a float source field or a non-constructor callee), nested_pat,
//# no_site (no same-arity constructor-like call outside lambda interiors),
//# blocker, alias, scrut_reused. Constructor-ness is by spelling here, as in
//# the planner.

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, call_placement_checked_rows, expr_children, restore_call_placements
}

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  collect_free_vars, compute_borrow_param_user_fns, compute_may_return_view_fns, md_consume_count_pre, md_shadow_zeroed_bmasks
}

import @vibe/compiler/perceus {
  PerceusAction,
  build_perceus_plan_with_params,
  compute_borrow_returning_names,
  pa_is_alias_dup,
  pa_is_drop,
  reuse_arm_has_blocker,
  reuse_arm_has_ctor_site,
  reuse_bind_mode
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, at = i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Constructor-like callee: the last `::` segment starts with A-Z (the
/// planner's reuse_ctor_like).
fn ctor_like(f: String) -> Bool {
  let n = String::length(f)
  let mut i = 0
  let mut start = 0
  while i < n {
    if String::char_code_at(f, at = i) == 58 {
      start = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  if start < n {
    let c = String::char_code_at(f, at = start)
    c >= 65 && c <= 90
  } else {
    false
  }
}

fn spine_tail(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => spine_tail(e = b),
    _ => e
  }
}

/// Peel every wrapper the ordinary codegen treats as a straight-line prefix.
fn wide_tail(e: Expr) -> Expr {
  match e {
    ELet(_, _, b, _) => wide_tail(e = b),
    ELetMut(_, _, b, _) => wide_tail(e = b),
    ELetRec(_, _, b) => wide_tail(e = b),
    ESeq(_, b) => wide_tail(e = b),
    EAssign(_, _, b, _) => wide_tail(e = b),
    EAssignOp(_, _, _, b, _) => wide_tail(e = b),
    _ => e
  }
}

fn tail_kind(t: Expr, arity: Int) -> String {
  match t {
    ECall(callee, args, _, _) => match callee {
      EIdent(f, _) => if ctor_like(f = f) {
        if Array::length(args) == arity {
          "ctor_same"
        } else {
          "ctor_diff"
        }
      } else {
        "call"
      },
      _ => "call_indirect"
    },
    EIf(_, _, _) => "if",
    EMatch(_, _) => "match",
    EIdent(_, _) => "ident",
    ERecord(_, _, _) => "record",
    ETuple(_) => "tuple",
    _ => "other"
  }
}

/// Every branch-leaf tail of a nested if/match tree (through wide spines).
fn leaves(t: Expr, arity: Int, tot: Array[Int], hit: Array[Int]) -> Unit {
  let w = wide_tail(e = t)
  match w {
    EIf(_, a, b) => {
      leaves(t = a, arity = arity, tot = tot, hit = hit)
      leaves(t = b, arity = arity, tot = tot, hit = hit)
    },
    EMatch(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, at = i)
        leaves(t = ab, arity = arity, tot = tot, hit = hit)
        i = i + 1
      }
    },
    _ => {
      Array::set(tot, at = 0, value = Array::get(tot, at = 0) + 1)
      if tail_kind(t = w, arity = arity) == "ctor_same" {
        Array::set(hit, at = 0, value = Array::get(hit, at = 0) + 1)
      } else {
        ()
      }
    }
  }
}

fn branch_info(t: Expr, arity: Int) -> String {
  let tot = [0]
  let hit = [0]
  leaves(t = t, arity = arity, tot = tot, hit = hit)
  let h = Array::get(hit, at = 0)
  let n = Array::get(tot, at = 0)
  if h == 0 {
    "none"
  } else if h == n {
    "all"
  } else {
    "some"
  }
}

fn occurrences(e: Expr, name: String) -> Int {
  match e {
    EIdent(n, _) => if n == name {
      1
    } else {
      0
    },
    _ => {
      let kids = expr_children(e)
      let mut acc = 0
      let mut i = 0
      while i < Array::length(kids) {
        acc = acc + occurrences(e = Array::get(kids, at = i), name = name)
        i = i + 1
      }
      acc
    }
  }
}

fn yn(b: Bool) -> String {
  if b {
    "y"
  } else {
    "n"
  }
}

fn classify_arm(fname: String, sname: String, pat: Pat, abody: Expr, alias_names: Array[String], bfns: Array[String], bmasks: Array[Int]) -> Unit with Console {
  match pat {
    PCtor(cname, pargs) => {
      let arity = Array::length(pargs)
      if arity >= 1 {
        let mut pat_ok = true
        let mut i = 0
        while i < arity {
          match Array::get(pargs, at = i) {
            PBind(_) => (),
            PWild => (),
            _ => pat_ok = false
          }
          i = i + 1
        }
        let spine_kind = tail_kind(t = spine_tail(e = abody), arity = arity)
        let wt = wide_tail(e = abody)
        let wide_kind = tail_kind(t = wt, arity = arity)
        let binfo = if wide_kind == "if" || wide_kind == "match" {
          branch_info(t = wt, arity = arity)
        } else {
          "-"
        }
        let any_site = reuse_arm_has_ctor_site(e = abody, arity = arity)
        let blocker = reuse_arm_has_blocker(abody)
        let no_params: Array[String] = []
        let no_fns: Array[String] = []
        let scrut_free = name_in(arr = collect_free_vars(body = abody, param_names = no_params, fn_names = no_fns), s = sname)
        let zb = md_shadow_zeroed_bmasks(e = abody, bfns = bfns, bmasks = bmasks)
        let modes = StringBuilder::new()
        let mut alias = false
        let mut j = 0
        while j < arity {
          match Array::get(pargs, at = j) {
            PBind(bn) => {
              let mode = reuse_bind_mode(arm_body = abody, bn = bn, borrow_param_fns = bfns, bmasks = zb)
              let m = if mode == 1 {
                "c"
              } else if mode == 0 {
                "b"
              } else if md_consume_count_pre(e = abody, name = bn, bfns = bfns, bmasks_zeroed = zb) == 1 {
                "m"
              } else {
                "k"
              }
              if name_in(arr = alias_names, s = bn) {
                alias = true
              } else {
                ()
              }
              StringBuilder::push(modes, value = m)
            },
            PWild => StringBuilder::push(modes, value = "_"),
            _ => StringBuilder::push(modes, value = "?")
          }
          j = j + 1
        }
        let verdict = if !pat_ok {
          "nested_pat"
        } else if !any_site {
          "no_site"
        } else if blocker {
          "blocker"
        } else if alias {
          "alias"
        } else if scrut_free {
          "scrut_reused"
        } else {
          "PAIRED"
        }
        let line = StringBuilder::new()
        StringBuilder::push(line, value = fname)
        StringBuilder::push(line, value = "\t")
        StringBuilder::push(line, value = sname)
        StringBuilder::push(line, value = "\t")
        StringBuilder::push(line, value = cname)
        StringBuilder::push(line, value = "\t")
        StringBuilder::push(line, value = __to_string(arity))
        StringBuilder::push(line, value = "\tspine=")
        StringBuilder::push(line, value = spine_kind)
        StringBuilder::push(line, value = "\twide=")
        StringBuilder::push(line, value = wide_kind)
        StringBuilder::push(line, value = "\tbr=")
        StringBuilder::push(line, value = binfo)
        StringBuilder::push(line, value = "\tmodes=")
        StringBuilder::push(line, value = StringBuilder::freeze(modes))
        StringBuilder::push(line, value = "\talias=")
        StringBuilder::push(line, value = yn(b = alias))
        StringBuilder::push(line, value = "\tscrut=")
        StringBuilder::push(line, value = yn(b = scrut_free))
        StringBuilder::push(line, value = "\tblk=")
        StringBuilder::push(line, value = yn(b = blocker))
        StringBuilder::push(line, value = "\tany=")
        StringBuilder::push(line, value = yn(b = any_site))
        StringBuilder::push(line, value = "\tverdict=")
        StringBuilder::push(line, value = verdict)
        println(StringBuilder::freeze(line))
      } else {
        ()
      }
    },
    _ => ()
  }
}

fn walk(fname: String, e: Expr, drop_names: Array[String], alias_names: Array[String], bfns: Array[String], bmasks: Array[Int]) -> Unit with Console {
  match e {
    // A lambda's body is planned (and fused) in its own frame; its arms
    // are not this function's.
    EFn(_, _, _, _, _, _) => (),
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sname, _) => if name_in(arr = drop_names, s = sname) {
          let mut ai = 0
          while ai < Array::length(arms) {
            let (apat, abody) = Array::get(arms, at = ai)
            classify_arm(fname = fname, sname = sname, pat = apat, abody = abody, alias_names = alias_names, bfns = bfns, bmasks = bmasks)
            ai = ai + 1
          }
        } else {
          ()
        },
        _ => ()
      }
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        walk(fname = fname, e = Array::get(kids, at = i), drop_names = drop_names, alias_names = alias_names, bfns = bfns, bmasks = bmasks)
        i = i + 1
      }
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        walk(fname = fname, e = Array::get(kids, at = i), drop_names = drop_names, alias_names = alias_names, bfns = bfns, bmasks = bmasks)
        i = i + 1
      }
    }
  }
}

fn census(source: String) -> Unit with Exception + Console {
  let (toks, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = toks, starts = starts, source = source)
  // The lowering prelude requires the checker's argument placement on every
  // labeled call (ADR-0120); `vibe rc-plan` restores it the same way.
  let _ = check_program(stmts)
  restore_call_placements(stmts = stmts, rows = call_placement_checked_rows())
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts = stmts, entry_name = "main", linked_imports = linked, iw_names = iw_names, iw_wats = iw_wats, checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, at = 0))
  } else {
    ()
  }
  let borrow_ret = sorted_names_of(compute_borrow_returning_names(stmts))
  let masks: Array[Int] = []
  let exclude = ["main", "_start", "cli_main"]
  let borrow_param = compute_borrow_param_user_fns(stmts = stmts, exclude = exclude, out_masks = masks)
  let view_ret = sorted_names_of(compute_may_return_view_fns(stmts))
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          let seen: Array[String] = []
          let norm = lift_match_scrutinees(expr = uniquify_shadowed_bindings_fresh(expr = value, counter = uq_shadow_counter, seen = seen), counter = m_scrut_counter)
          match norm {
            EFn(_, _, nparams, _, _, nbody) => {
              let plan = build_perceus_plan_with_params(params = nparams, body = nbody, borrow_ret_names = borrow_ret, borrow_param_fns = borrow_param, borrow_param_masks = masks, view_ret_fns = view_ret)
              let drop_names: Array[String] = []
              let alias_names: Array[String] = []
              let mut k = 0
              while k < Array::length(plan) {
                let a = Array::get(plan, at = k)
                if pa_is_drop(a) {
                  Array::push(drop_names, value = a.name)
                } else {
                  ()
                }
                if pa_is_alias_dup(a) {
                  Array::push(alias_names, value = a.name)
                } else {
                  ()
                }
                k = k + 1
              }
              walk(fname = name, e = nbody, drop_names = drop_names, alias_names = alias_names, bfns = borrow_param, bmasks = masks)
            },
            _ => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

test "reuse census" {
  // scripts/reuse_census.sh stages the input here.
  let src = Fs::read_file("_build/reuse_census/input.vibe")
  census(source = src)
}
