// Allocation volume for one ordinary FS compile. The caller isolates the
// process, source tree and persistent cache. Profiler::heap_bytes measures
// allocated bytes in the compile, not a live-set size.
import @vibe/compiler/entry/compiler/file_compile {
  compile_file_fs_mode_rc_body_cached_split
}
import @vibe/compiler/codegen/wasi {
  prelude_split_last_module_count
}

fn main() -> Unit allows Env + Exception + Fs + Profiler::heap_bytes + Stdout {
  if Env::args_len() != 4 {
    throw("usage: prelude_split_memory.vibex <root.vibe> <entry> whole|split <output.wasm>")
  } else {
    ()
  }
  let root = Env::args_get(0)
  let entry = Env::args_get(1)
  let lane = Env::args_get(2)
  let output = Env::args_get(3)
  if lane != "whole" && lane != "split" {
    throw("choose whole or split for the prelude lane")
  } else {
    ()
  }
  let before = Profiler::heap_bytes()
  let bytes = compile_file_fs_mode_rc_body_cached_split(root, entry, "off", lane == "split")
  let allocated = Profiler::heap_bytes() - before
  let modules = prelude_split_last_module_count()
  if lane == "split" && modules < 2 {
    throw("choose a root whose production prelude actually splits into multiple modules")
  } else {
    ()
  }
  Fs::write_bytes(output, bytes)
  println("prelude-split-memory lane=\{lane} modules=\{modules} heap_delta=\{allocated} wasm_bytes=\{Bytes::length(bytes)}")
}
