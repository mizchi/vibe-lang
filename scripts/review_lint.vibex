// Review-derived structural lint runner.
//
// Semantic rules belong in `vibe check`. This executable owns only repository
// architecture patterns expressible through `vibe grep`; keep the pattern,
// capture interpretation, diagnostic, and exit policy together here.
//
// Usage:
//   vibe run scripts/review_lint.vibex -- --root lib/@vibe/compiler
//   vibe run scripts/review_lint.vibex -- --root <staged-snapshot> --vibe runtime/vibe
//   vibe run scripts/review_lint.vibex -- --self-test

import @vibe/json {
  Json
}
import @vibe/process {
  sh_capture
}

fn shell_quote(s: String) -> String {
  // Repository and mktemp paths cannot contain a single quote in the
  // pre-commit driver. Keeping quoting here makes spaces harmless.
  "'" + s + "'"
}

fn arg_value(name: String, fallback: String) -> String with Env {
  let argc = Env::args_len()
  let mut i = 0
  let mut out = fallback
  while i + 1 < argc {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
      i = argc
    } else {
      i = i + 1
    }
  }
  out
}

fn has_arg(name: String) -> Bool with Env {
  let argc = Env::args_len()
  let mut i = 0
  let mut found = false
  while i < argc {
    if Env::args_get(i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn starts_with_synthetic_literal(text: String) -> Bool {
  String::starts_with(text, "\"__")
}

fn source_line(path: String, line: Int) -> String with Fs {
  if !Fs::exists(path) || line <= 0 {
    ""
  } else {
    let lines = String::split(Fs::read_file(path), "\n")
    if line > Array::length(lines) {
      ""
    } else {
      Array::get(lines, line - 1)
    }
  }
}

fn is_allowed(path: String, line: Int) -> Bool with Fs {
  String::contains(source_line(path, line), "review-lint: allow-fixed-synthetic-name")
}

fn is_transform_path(path: String) -> Bool {
  String::contains(path, "/compiler/normalize/") ||
  String::contains(path, "/compiler/codegen/") ||
  String::contains(path, "/compiler/loader/")
}

fn is_production_compiler_path(path: String) -> Bool {
  !String::ends_with(path, "_test.vibe") && !String::contains(path, "/tests/")
}

fn binder_ctor(name: String) -> Bool {
  name == "ELet" || name == "ELetMut" || name == "ELetRec" || name == "PBind"
}

fn report_finding(path: String, line: Int, text: String, message: String) -> Unit with Stderr {
  let end_line = line + Array::length(String::split(text, "\n")) - 1
  // The pre-commit driver consumes this record before rendering a diagnostic.
  // A dedicated prefix and explicit source span distinguish lint findings from
  // bootstrap/compiler failures emitted by the runner itself.
  let record = "review-lint:finding\t" + path + "\t" + Int::to_string(line) + "\t" + Int::to_string(end_line) + "\t" + message + "\n"
  Stderr::write_stream(record)
}

fn report_hits(raw: String, filter_ctor: Bool, emit: Bool) -> Int with Fs + Stderr {
  let hits = Json::parse(raw)
  let mut i = 0
  let mut count = 0
  while i < Json::length(hits) {
    let hit = Json::index(hits, i)
    let captures = Json::field(hit, "captures")
    let name = Json::string(Json::field(Json::field(captures, "name"), "text"))
    let ctor_ok = if filter_ctor {
      binder_ctor(Json::string(Json::field(Json::field(captures, "ctor"), "text")))
    } else {
      true
    }
    let path = Json::string(Json::field(hit, "path"))
    let line = Double::to_int(Json::number(Json::field(hit, "line")))
    if ctor_ok && is_transform_path(path) && starts_with_synthetic_literal(name) && !is_allowed(path, line) {
      let text = Json::string(Json::field(hit, "text"))
      if emit {
        report_finding(path, line, text, "fixed synthetic binder: " + text)
      } else {
        ()
      }
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

fn is_operator_binding(name: String) -> Bool {
  name == "_" || name == "op" || name == "pop" || name == "top" ||
  name == "operator" || String::ends_with(name, "_op")
}

// #1657: Expr::EAssignOp is positional (target, operator, value, cont).
// Constrain the second-field binder vocabulary so `(op, name, ...)` and
// `(_, name, ...)` cannot silently interpret the operator as the target.
fn report_assign_op_hits(raw: String, emit: Bool) -> Int with Stderr {
  let hits = Json::parse(raw)
  let mut i = 0
  let mut count = 0
  while i < Json::length(hits) {
    let hit = Json::index(hits, i)
    let captures = Json::field(hit, "captures")
    let operator = Json::string(Json::field(Json::field(captures, "operator"), "text"))
    if !is_operator_binding(operator) {
      let path = Json::string(Json::field(hit, "path"))
      let line = Double::to_int(Json::number(Json::field(hit, "line")))
      let text = Json::string(Json::field(hit, "text"))
      if emit {
        report_finding(
          path,
          line,
          text,
          "EAssignOp second field is the operator, but is bound as '" + operator + "': " + text
        )
      } else {
        ()
      }
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

// #1289: substring membership grants Async to NotAsync / AsyncLike. This also
// guards non-checker compiler paths, one of which had reintroduced the bug.
fn report_async_substring_hits(raw: String, emit: Bool) -> Int with Stderr {
  let hits = Json::parse(raw)
  let mut i = 0
  let mut count = 0
  while i < Json::length(hits) {
    let hit = Json::index(hits, i)
    let path = Json::string(Json::field(hit, "path"))
    if is_production_compiler_path(path) {
      let line = Double::to_int(Json::number(Json::field(hit, "line")))
      let text = Json::string(Json::field(hit, "text"))
      if emit {
        report_finding(
          path,
          line,
          text,
          "Async effect membership must be exact; use effect_row_contains_label instead of String::contains: " + text
        )
      } else {
        ()
      }
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

// #1809: the gc backend intercepts builtins by SPELLING in `compile_call_gc`
// before ordinary func-table dispatch, and the lambda capture scan has to know
// that same set -- a name it does not know is collected as a free variable of
// the closure and dies in `emit_lambda_closure_gc` with "reached code
// generation unresolved". The two copies drifted once already (the capture
// scan carried 6 of ~60 names), and the failure only shows one lambda deep, so
// every top-level fixture stayed green.
//
// The set now lives once, in `gc_direct_abi_names()`. This rule keeps the
// dispatch chain from growing past it: every `fname == "..."` literal in
// backend_call.vibe must appear in that file.
// The marker is looked for in a small window, not on the hit line alone. The
// vibe formatter relocates a trailing `//` comment onto the FOLLOWING line, so
// a strictly-hit-line key (what the fixed-synthetic-name rule uses) silently
// stops matching the first time anyone runs `pkf run fmt` -- and a suppression
// that stops suppressing turns into a spurious finding, not a missed one, so
// it would at least be loud. The window keeps it correct either way.
fn gc_drift_suppressed(path: String, line: Int) -> Bool with Fs {
  let marker = "review-lint: allow-gc-direct-abi-unlisted"
  String::contains(source_line(path, line), marker) ||
  String::contains(source_line(path, line + 1), marker) ||
  String::contains(source_line(path, line - 1), marker)
}

fn report_gc_direct_abi_drift(raw: String, names_source: String, emit: Bool) -> Int with Fs + Stderr {
  let hits = Json::parse(raw)
  let mut i = 0
  let mut count = 0
  while i < Json::length(hits) {
    let hit = Json::index(hits, i)
    let path = Json::string(Json::field(hit, "path"))
    let literal = Json::string(Json::field(Json::field(Json::field(hit, "captures"), "name"), "text"))
    // `literal` still carries its quotes, and the single list stores quoted
    // strings too, so a containment test cannot match a bare substring of a
    // longer name (`"Map::get"` never matches `"MapBuilder::get"`).
    let line = Double::to_int(Json::number(Json::field(hit, "line")))
    // Not every spelling in the chain belongs in the list. `FrozenArray`'s two
    // conversions have real func-table bodies -- the branch rewrites a call
    // that already resolves, so `globals` keeps the capture scan off them and
    // listing them would instead claim a user declaration with those names is
    // unsafe. Measured before suppressing, not assumed.
    let suppressed = gc_drift_suppressed(path, line)
    if String::contains(path, "codegen/gc/backend_call.vibe") && !suppressed && !String::contains(names_source, literal) {
      if emit {
        report_finding(
          path,
          line,
          Json::string(Json::field(hit, "text")),
          "gc dispatches " + literal + " by spelling but gc_direct_abi_names() does not list it; the lambda capture scan will collect it as a free variable and codegen will fail on it"
        )
      } else {
        ()
      }
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

fn run_grep(vibe: String, root: String, pattern: String) -> (Int, String) with Process {
  let cmd = shell_quote(vibe) + " grep --json --pattern " + shell_quote(pattern) + " " + shell_quote(root)
  let result = sh_capture(cmd)
  if result.exit_code != 0 {
    (result.exit_code, result.stderr)
  } else {
    (0, result.stdout)
  }
}

fn gc_direct_abi_names_source(root: String) -> String with Fs {
  // `--root` arrives in two shapes: the package subtree (`lib/@vibe/compiler`)
  // when run by hand, and a REPO-ROOT-shaped staged snapshot from
  // lint_review_regressions.sh. Try both, then fall back to the working tree.
  //
  // The fallback is the point, not a convenience. The snapshot only
  // materializes STAGED paths, so a commit that adds a dispatch spelling to
  // backend_call.vibe without touching the list -- exactly what this rule
  // exists to catch -- would leave the list file absent and the rule would
  // skip itself. Reading the working tree gives the authoritative list
  // regardless of what happens to be staged.
  let suffix = "/codegen/gc/backend_direct_abi_names.vibe"
  let in_subtree = root + suffix
  let in_snapshot = root + "/lib/@vibe/compiler" + suffix
  let in_worktree = "lib/@vibe/compiler" + suffix
  if Fs::exists(in_subtree) {
    Fs::read_file(in_subtree)
  } else if Fs::exists(in_snapshot) {
    Fs::read_file(in_snapshot)
  } else if Fs::exists(in_worktree) {
    // Genuinely absent from every candidate means the gc backend is not in
    // this tree at all, so there is no list to stay in sync with.
    Fs::read_file(in_worktree)
  } else {
    ""
  }
}


// #1976: the gc lane does NOT serve the bare-name builtins (`add`, `sub`,
// `mul`, `lt`, `path`, `map`). They are the `gc-hijack-risk` rows of
// scripts/builtin_parity_classification.tsv: linear guards them with
// `!prefer_bound_call` so a user's own binding is not hijacked, and this lane
// has no such guard, so porting them would reintroduce #832.
//
// The consequence is easy to walk into. Porting a builtin to the gc lane by
// copying its linear twin's SYNTHESIZED AST brings those names along --
// `String::to_bytes`'s lowering is built from `lt` and `add` -- and the copy
// dies at compile time with
//
//     `lt` (local, @gc_call) reached code generation unresolved
//
// which reads as a compiler bug rather than "this lane does not have that
// name". Measured: that is exactly how it presented while #1861 landed. The
// fix is to spell the operation with operators (`<`, `+`), which both lanes
// always have.
//
// The name set is READ FROM THE LEDGER rather than restated here. The ledger is
// already gate-enforced (check_builtin_parity.sh), so there is one source of
// truth and a name that stops being hijack-risk stops being linted the same
// day it is ported.
fn gc_hijack_risk_names_source(root: String) -> String with Fs {
  // Same three-candidate lookup as gc_direct_abi_names_source, and for the same
  // reason: the staged snapshot only materializes `lib/@vibe/compiler/**`, so
  // the ledger is never in it and the working tree is the authoritative copy.
  let suffix = "scripts/builtin_parity_classification.tsv"
  let in_snapshot = root + "/" + suffix
  if Fs::exists(in_snapshot) {
    Fs::read_file(in_snapshot)
  } else if Fs::exists(suffix) {
    Fs::read_file(suffix)
  } else {
    ""
  }
}

/// The quoted bare names the gc lane must not reference, from the ledger.
/// A row qualifies when its category is `gc-hijack-risk` AND its name has no
/// `::` -- the category is about bare names, and a qualified name could never
/// be a user binding anyway (the parser rejects `let Foo::bar = ..`).
fn gc_hijack_risk_quoted(ledger: String) -> Array[String] {
  let out = ArrayBuilder::new()
  let lines = String::split(ledger, "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let cols = String::split(Array::get(lines, i), "\t")
    if Array::length(cols) >= 3 {
      let name = Array::get(cols, 0)
      if Array::get(cols, 2) == "gc-hijack-risk" && !String::contains(name, "::") {
        ArrayBuilder::push(out, "\"" + name + "\"")
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

fn gc_bare_suppressed(path: String, line: Int) -> Bool with Fs {
  let marker = "review-lint: allow-gc-bare-builtin"
  String::contains(source_line(path, line), marker) ||
  String::contains(source_line(path, line + 1), marker) ||
  String::contains(source_line(path, line - 1), marker)
}

fn report_gc_bare_builtin_hits(raw: String, ledger: String, emit: Bool) -> Int with Fs + Stderr {
  let banned = gc_hijack_risk_quoted(ledger)
  let hits = Json::parse(raw)
  let mut i = 0
  let mut count = 0
  while i < Json::length(hits) {
    let hit = Json::index(hits, i)
    let path = Json::string(Json::field(hit, "path"))
    let literal = Json::string(Json::field(Json::field(Json::field(hit, "captures"), "name"), "text"))
    let line = Double::to_int(Json::number(Json::field(hit, "line")))
    let mut banned_hit = false
    let mut b = 0
    while b < Array::length(banned) {
      if literal == Array::get(banned, b) {
        banned_hit = true
      } else {
        ()
      }
      b = b + 1
    }
    if banned_hit && String::contains(path, "codegen/gc/") && !gc_bare_suppressed(path, line) {
      if emit {
        report_finding(
          path,
          line,
          Json::string(Json::field(hit, "text")),
          "the gc lane does not serve the bare builtin " + literal + " (a gc-hijack-risk row in scripts/builtin_parity_classification.tsv); a synthesized AST referencing it fails with `(local, @gc_call) reached code generation unresolved` -- use the operator form instead"
        )
      } else {
        ()
      }
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count
}

fn lint(root: String, vibe: String) -> Int with Fs + Process + Stderr {
  let patterns = [
    "$(ctor:id)($(name:const), $(rest:args))",
    "SLet($(a:arg), $(b:arg), $(name:const), $(rest:args))",
    "EAssignOp($(target:arg), $(operator:id), $(rest:args))",
    "String::contains($(row:exp), \"Async\")",
    "fname == $(name:const)",
    "EIdent($(name:const), $(rest:args))"
  ]
  let mut i = 0
  let mut violations = 0
  let mut failed = false
  while i < Array::length(patterns) {
    let (code, output) = run_grep(vibe, root, Array::get(patterns, i))
    if code != 0 {
      Stderr::write_stream("review-lint: vibe grep failed: " + output + "\n")
      failed = true
    } else {
      if i < 2 {
        violations = violations + report_hits(output, i == 0, true)
      } else if i == 2 {
        violations = violations + report_assign_op_hits(output, true)
      } else if i == 3 {
        violations = violations + report_async_substring_hits(output, true)
      } else if i == 4 {
        let names_source = gc_direct_abi_names_source(root)
        if names_source == "" {
          ()
        } else {
          violations = violations + report_gc_direct_abi_drift(output, names_source, true)
        }
      } else {
        let ledger = gc_hijack_risk_names_source(root)
        if ledger == "" {
          ()
        } else {
          violations = violations + report_gc_bare_builtin_hits(output, ledger, true)
        }
      }
    }
    i = i + 1
  }
  if failed {
    2
  } else if violations > 0 {
    Stderr::write_stream("review-lint: found " + Int::to_string(violations) + " structural regression(s)\n")
    1
  } else {
    0
  }
}

// The list stores quoted strings, so `"Map::get"` must not be satisfied by
// `"MapBuilder::get"` appearing in the file.
fn gc_names_sample() -> String {
  "  [\n    \"Array::length\",\n    \"MapBuilder::get\",\n    \"Map::get\"\n  ]"
}

fn gc_dispatch_hit(literal: String) -> String {
  "[{\"path\":\"/repo/lib/@vibe/compiler/codegen/gc/backend_call.vibe\",\"line\":9,\"text\":\"fname == " + literal + "\",\"captures\":{\"name\":{\"text\":\"" + literal + "\"}}}]"
}

// Written to disk rather than pointed at a repository line: keying the
// self-test to a line number in backend_call.vibe would make it fail whenever
// that file grows a line, which tests the wrong thing.
fn gc_write_suppression_probe(path: String, with_marker: Bool) -> Unit with Fs {
  let body = if with_marker {
    "fname == \"Whatever::nope\"\n// review-lint: allow-gc-direct-abi-unlisted\n"
  } else {
    "fname == \"Whatever::nope\"\n// ordinary comment\n"
  }
  Fs::write_file(path, body)
}

fn gc_probe_hit(path: String) -> String {
  "[{\"path\":\"" + path + "\",\"line\":1,\"text\":\"fname == \\\"Whatever::nope\\\"\",\"captures\":{\"name\":{\"text\":\"\\\"Whatever::nope\\\"\"}}}]"
}

fn gc_other_file_hit() -> String {
  "[{\"path\":\"/repo/lib/@vibe/compiler/codegen/expr/compile_call.vibe\",\"line\":9,\"text\":\"fname == \\\"Nope::nope\\\"\",\"captures\":{\"name\":{\"text\":\"\\\"Nope::nope\\\"\"}}}]"
}

fn gc_ledger_sample() -> String {
  // Shaped like the real ledger: name<TAB>lane<TAB>category<TAB>note.
  // `Array::map` is present as a NON-hijack row so the self-test proves the
  // category filter, and `map` as a hijack row so it proves the bare-name one.
  "map\tlinear-only\tgc-hijack-risk\tbare alias\nlt\tlinear-only\tgc-hijack-risk\tbare alias\nArray::map\tlinear-only\tgc-hof-gap\tnot a bare name\nInt::parse\tlinear-only\tgc-unported\tunrelated"
}

fn gc_ident_hit(path: String, literal: String) -> String {
  "[{\"path\":\"" + path + "\",\"line\":1,\"text\":\"EIdent(" + literal + ", -1)\",\"captures\":{\"name\":{\"text\":\"" + literal + "\"}}}]"
}

fn gc_write_bare_probe(path: String, with_marker: Bool) -> Unit with Fs {
  let body = if with_marker {
    "EIdent(\"lt\", -1)\n// review-lint: allow-gc-bare-builtin\n"
  } else {
    "EIdent(\"lt\", -1)\n// ordinary comment\n"
  }
  Fs::write_file(path, body)
}

fn self_test() -> Int with Fs + Stderr {
  let raw = "[{\"path\":\"/repo/lib/@vibe/compiler/normalize/pass.vibe\",\"line\":1,\"text\":\"ELet(\\\"__tmp\\\", e, e, -1)\",\"captures\":{\"name\":{\"text\":\"\\\"__tmp\\\"\"}}}]"
  let bad_assign = "[{\"path\":\"/repo/lib/@vibe/compiler/runtime/grep.vibe\",\"line\":2,\"text\":\"EAssignOp(_, name, v, b)\",\"captures\":{\"operator\":{\"text\":\"name\"}}}]"
  let good_assign = "[{\"path\":\"/repo/lib/@vibe/compiler/runtime/grep.vibe\",\"line\":2,\"text\":\"EAssignOp(name, op, v, b)\",\"captures\":{\"operator\":{\"text\":\"op\"}}}]"
  let bad_async = "[{\"path\":\"/repo/lib/@vibe/compiler/entry/preprocess.vibe\",\"line\":3,\"text\":\"String::contains(row, Async)\",\"captures\":{}}]"
  let gc_names_sample = gc_names_sample()
  // The probes carry "codegen/gc/backend_call.vibe" in their path so the rule's
  // file filter accepts them, while living under _build.
  let probe_marked = "_build/_review_lint_probe/codegen/gc/backend_call.vibe"
  let probe_plain = "_build/_review_lint_probe_plain/codegen/gc/backend_call.vibe"
  gc_write_suppression_probe(probe_marked, true)
  gc_write_suppression_probe(probe_plain, false)
  let bare_marked = "_build/_review_lint_bare_marked/codegen/gc/backend_call.vibe"
  let bare_plain = "_build/_review_lint_bare_plain/codegen/gc/backend_call.vibe"
  gc_write_bare_probe(bare_marked, true)
  gc_write_bare_probe(bare_plain, false)
  let gc_ledger = gc_ledger_sample()
  if !starts_with_synthetic_literal("\"__tmp\"") {
    Stderr::write_stream("review-lint self-test: synthetic literal was not recognized\n")
    1
  } else if starts_with_synthetic_literal("\"user\"") {
    Stderr::write_stream("review-lint self-test: ordinary literal was rejected\n")
    1
  } else if report_hits(raw, false, false) != 1 {
    Stderr::write_stream("review-lint self-test: JSON finding was not reported\n")
    1
  } else if report_assign_op_hits(bad_assign, false) != 1 || report_assign_op_hits(good_assign, false) != 0 {
    Stderr::write_stream("review-lint self-test: EAssignOp field-order rule failed\n")
    1
  } else if report_async_substring_hits(bad_async, false) != 1 {
    Stderr::write_stream("review-lint self-test: Async substring rule failed\n")
    1
  } else if report_gc_direct_abi_drift(gc_dispatch_hit("\\\"Array::brand_new\\\""), gc_names_sample, false) != 1 {
    Stderr::write_stream("review-lint self-test: gc direct-ABI drift was not reported\n")
    1
  } else if report_gc_direct_abi_drift(gc_dispatch_hit("\\\"Array::length\\\""), gc_names_sample, false) != 0 {
    Stderr::write_stream("review-lint self-test: a listed gc dispatch name was reported as drift\n")
    1
  } else if report_gc_direct_abi_drift(gc_dispatch_hit("\\\"Map::get\\\""), gc_names_sample, false) != 0 {
    Stderr::write_stream("review-lint self-test: quoted containment matched a longer name\n")
    1
  } else if report_gc_direct_abi_drift(gc_other_file_hit(), gc_names_sample, false) != 0 {
    Stderr::write_stream("review-lint self-test: a comparison outside backend_call.vibe was reported\n")
    1
  } else if report_gc_direct_abi_drift(gc_probe_hit(probe_marked), gc_names_sample, false) != 0 {
    Stderr::write_stream("review-lint self-test: the reasoned suppression marker was ignored\n")
    1
  } else if report_gc_direct_abi_drift(gc_probe_hit(probe_plain), gc_names_sample, false) != 1 {
    Stderr::write_stream("review-lint self-test: an unmarked comparison was suppressed anyway\n")
    1
  } else if !String::contains(gc_direct_abi_names_source("/nonexistent-staged-snapshot"), "\"Array::length\"") {
    // The staged snapshot only materializes staged paths, so the rule has to
    // reach the working tree to stay armed when only backend_call.vibe is
    // staged -- the very commit shape it exists to catch.
    Stderr::write_stream("review-lint self-test: the list lookup did not fall back to the working tree\n")
    1
  } else if gc_direct_abi_names_source("/nonexistent") == "" {
    Stderr::write_stream("review-lint self-test: the list lookup returned empty and would skip the rule\n")
    1
  } else if report_gc_bare_builtin_hits(gc_ident_hit("/repo/lib/@vibe/compiler/codegen/gc/backend_call.vibe", "\\\"lt\\\""), gc_ledger, false) != 1 {
    Stderr::write_stream("review-lint self-test: a gc bare-builtin reference was not reported\n")
    1
  } else if report_gc_bare_builtin_hits(gc_ident_hit("/repo/lib/@vibe/compiler/codegen/gc/backend_call.vibe", "\\\"Array::map\\\""), gc_ledger, false) != 0 {
    // Served on gc, and not a bare name -- the category filter must exclude it.
    Stderr::write_stream("review-lint self-test: a non-hijack ledger row was reported\n")
    1
  } else if report_gc_bare_builtin_hits(gc_ident_hit("/repo/lib/@vibe/compiler/codegen/gc/backend_call.vibe", "\\\"helper\\\""), gc_ledger, false) != 0 {
    Stderr::write_stream("review-lint self-test: an ordinary identifier was reported\n")
    1
  } else if report_gc_bare_builtin_hits(gc_ident_hit("/repo/lib/@vibe/compiler/codegen/expr/compile_call.vibe", "\\\"lt\\\""), gc_ledger, false) != 0 {
    // The LINEAR lane serves these; only codegen/gc/ is constrained.
    Stderr::write_stream("review-lint self-test: a linear-lane reference was reported\n")
    1
  } else if report_gc_bare_builtin_hits(gc_ident_hit(bare_marked, "\\\"lt\\\""), gc_ledger, false) != 0 {
    Stderr::write_stream("review-lint self-test: the gc bare-builtin suppression marker was ignored\n")
    1
  } else if report_gc_bare_builtin_hits(gc_ident_hit(bare_plain, "\\\"lt\\\""), gc_ledger, false) != 1 {
    Stderr::write_stream("review-lint self-test: an unmarked gc bare-builtin reference was suppressed anyway\n")
    1
  } else if Array::length(gc_hijack_risk_quoted(gc_ledger)) != 2 {
    Stderr::write_stream("review-lint self-test: the ledger parse did not find exactly the bare hijack rows\n")
    1
  } else if gc_hijack_risk_names_source("/nonexistent-staged-snapshot") == "" {
    // Must reach the working tree, same as the direct-ABI list lookup.
    Stderr::write_stream("review-lint self-test: the ledger lookup did not fall back to the working tree\n")
    1
  } else {
    0
  }
}

fn main with Env + Fs + Process + Stdout + Stderr {
  let code = if has_arg("--self-test") {
    self_test()
  } else {
    let root = arg_value("--root", "lib/@vibe/compiler")
    let vibe = arg_value("--vibe", "runtime/vibe")
    lint(root, vibe)
  }
  if code == 0 {
    Stdout::write_stream("review-lint: ok\n")
  } else {
    vibe_process_exit_raw(code)
  }
}
