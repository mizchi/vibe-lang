// Tutorials and examples call the eager collection operations through
// `Iterator::*`, never `Array::*` (ADR-0099; #3672 ported this from
// check_canonical_iterator_calls.sh):
//
//   bash scripts/vibe_run.sh scripts/check_canonical_iterator_calls.vibex -- [--root DIR]
//
// It reads every `*.vibe.md` under book/ and every `*.vibe` under examples/
// and refuses a line that names `Array::map`, `filter`, `flatmap`, `fold`,
// `find`, `any` or `all` not followed by an identifier character.
// `Array::iter` is not listed: its one signature, `(Array[T]) -> AsyncIter[T]`,
// is the AsyncIter entry and has no `Iterator::*` spelling, and the legacy
// two-argument form no longer type-checks, so the book's blocks reject it
// already. A line scan cannot tell the two apart (#3553 review).
//
// A tree with no such file fails: nothing scanned is not clean. --root DIR
// checks another tree (the self-test's).

import @vibe/builtin {
  String::index_of_from
}
import @vibe/process {
  exit
}
import @vibex/shell {
  find, sort_str
}

fn option(name: String, fallback: String) -> String with Env {
  let mut out = fallback
  let mut i = 0
  while i + 1 < Env::args_len() {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn legacy_names() -> Array[String] {
  ["map", "filter", "flatmap", "fold", "find", "any", "all"]
}

fn is_ident_byte(c: Char) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
}

/// Whether `name` is spelled at `at` in `line` and ends there: the next byte
/// is not an identifier character, or the line ends.
fn names_at(line: String, at: Int, name: String) -> Bool {
  let end = at + String::length(name)
  if end > String::length(line) {
    false
  } else if String::substring(line, at, end) != name {
    false
  } else {
    end == String::length(line) || !is_ident_byte(String::byte_at(line, end))
  }
}

/// Whether the line calls one of the legacy `Array::*` operations.
fn has_legacy_call(line: String) -> Bool {
  let marker = "Array::"
  let names = legacy_names()
  let mut found = false
  let mut from = 0
  let mut going = true
  while going && !found {
    let hit = String::index_of_from(line, marker, from)
    if hit < 0 {
      going = false
    } else {
      let at = hit + String::length(marker)
      let mut k = 0
      while k < Array::length(names) {
        if names_at(line, at, Array::get(names, k)) {
          found = true
        } else {
          ()
        }
        k = k + 1
      }
      from = at
    }
  }
  found
}

/// The files under `root/dir` whose name ends with `suffix`, relative to root.
fn corpus(root: String, dir: String, suffix: String, out: Array[String]) -> Unit with Fs {
  let base = "\{root}/\{dir}"
  if Fs::is_dir(base) {
    let entries = find(base)
    let prefix = "\{root}/"
    let mut i = 0
    while i < Array::length(entries) {
      let entry = Array::get(entries, i)
      if !entry.is_dir && String::ends_with(entry.name, suffix) {
        let p = entry.path
        Array::push(out, if String::starts_with(p, prefix) {
          String::substring(p, String::length(prefix), String::length(p))
        } else {
          p
        })
      } else {
        ()
      }
      i = i + 1
    }
  } else {
    ()
  }
}

fn main allows Env + Fs + Console::write_stream + Stderr::write_stream + Process {
  let root = option("--root", ".")
  let collected: Array[String] = []
  corpus(root, "book", ".vibe.md", collected)
  corpus(root, "examples", ".vibe", collected)
  let files = sort_str(collected)
  if Array::length(files) == 0 {
    Stderr::write_stream("canonical Iterator calls: FAIL: no *.vibe.md under \{root}/book and no *.vibe under \{root}/examples, so nothing was checked\n")
    exit(1)
  } else {
    let findings: Array[String] = []
    let mut i = 0
    while i < Array::length(files) {
      let rel = Array::get(files, i)
      let lines = String::split(Fs::read_file("\{root}/\{rel}"), "\n")
      let mut n = 0
      while n < Array::length(lines) {
        let line = Array::get(lines, n)
        if has_legacy_call(line) {
          Array::push(findings, "\{rel}:\{n + 1}:\{line}")
        } else {
          ()
        }
        n = n + 1
      }
      i = i + 1
    }
    if Array::length(findings) > 0 {
      Stderr::write_stream("canonical Iterator calls: tutorials and examples must use Iterator::* and import trait Iterator:\n")
      let mut k = 0
      while k < Array::length(findings) {
        Stderr::write_stream("\{Array::get(findings, k)}\n")
        k = k + 1
      }
      exit(1)
    } else {
      Console::write_stream("canonical Iterator calls: ok (\{Array::length(files)} files)\n")
    }
  }
}
