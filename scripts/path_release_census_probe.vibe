//# Per-path release census (#2389). Run through scripts/path_release_census.sh.
//#
//# Classifies every `let` the Perceus planner emits a `PaPathDrop` row for --
//# a binding whose scope-end drop a branch merge planned away because SOME
//# branch spends its initial reference -- by the SHAPE OF ITS VALUE, which is
//# what the RC `let` lowering gates the guarded drop on
//# (compile_expr_tail.vibe's `path_value_ok`).
//#
//# The question it answers: how many of those bindings does the admission rule
//# accept, how much of that the recursive result-spine read is responsible
//# for, and -- for the ones it declines -- what the disqualifying leaf is, so
//# the next slice is chosen from a population rather than guessed at.
//#
//# Row: FN NAME top=<value's own node kind> flat=<y|n> spine=<y|n>
//#      nleaves=N kinds=<comma-separated leaf kinds, sorted and deduplicated>
//#      verdict=<FLAT|SPINE|<first leaf kind that is not site-allocated>>
//#
//# FLAT  = the value node is itself an owned leaf, so a flat test admits it.
//# SPINE = every leaf of the result spine is owned but the value node is not
//#         one, so only the recursive read admits it.
//# other = the leaf kind that disqualifies it, which is what a further slice
//#         would have to answer for.
//#
//# An OWNED leaf is an allocation made at the site (tuple / record / array
//# literal / constructor call) or a call to a named function whose declared
//# return type is heap and which neither borrow set claims -- the shipped
//# admission rule (`path_value_owned`, compile_expr_tail.vibe).
//#
//# Constructor-ness is by declaration here -- every `SEnum` / `SSuberror`
//# variant name and every `SStruct` name of the input, which is exactly what
//# `linked_compile.vibe` pushes into the codegen's `CtorTable`; the codegen
//# consults the table, this consults the decls.

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, call_placement_checked_rows, expr_children, is_borrow_ret_builtin, restore_call_placements
}

import @vibe/compiler/checker {
  check_program
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  compute_borrow_param_user_fns, compute_may_return_view_fns
}

import @vibe/compiler/perceus {
  build_perceus_plan_with_params,
  compute_borrow_returning_names,
  compute_heap_returning,
  compute_scalar_returning_names,
  pa_is_path_drop,
  type_expr_is_heap
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, at = i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Leaf kind of one result-spine leaf. Only the first four are allocations
/// made at the site, which is what the guarded drop needs the value to be.
fn pat_bound_names(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, value = n),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        pat_bound_names(p = Array::get(ps, at = i), out = out)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        pat_bound_names(p = Array::get(ps, at = i), out = out)
        i = i + 1
      }
    },
    POr(a, b) => {
      pat_bound_names(p = a, out = out)
      pat_bound_names(p = b, out = out)
    },
    PStruct(_, fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fp) = Array::get(fs, at = i)
        pat_bound_names(p = fp, out = out)
        i = i + 1
      }
    },
    _ => ()
  }
}

fn leaf_kind(e: Expr, ctors: Array[String], bound: Array[String], borrow_ret: Array[String], view_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    ETuple(_) => "tuple",
    ERecord(_, _, _) => "record",
    EArray(_) => "array",
    ECall(callee, _, _, _) => match callee {
      EIdent(f, _) => if name_in(arr = ctors, s = f) {
        "ctor"
      } else if !name_in(arr = bound, s = f) && name_in(arr = heap_ret, s = f) && !is_borrow_ret_builtin(f) && !name_in(arr = borrow_ret, s = f) && !name_in(arr = view_ret, s = f) {
        "call_heap_ret"
      } else {
        "call"
      },
      _ => "call_indirect"
    },
    EIdent(_, _) => "ident",
    EDot(_, _, _, _) => "proj",
    EInt(_) => "lit",
    EFloat(_) => "lit",
    EString(_, _) => "lit",
    EBool(_) => "lit",
    EUnit => "unit",
    EBinOp(_, _, _, _) => "binop",
    EUnaryOp(_, _) => "unop",
    EFn(_, _, _, _, _, _) => "lambda",
    EMap(_) => "map",
    EStringInterp(_) => "interp",
    EReturn(_) => "xfer",
    EBreak(_) => "xfer",
    EContinue(_) => "xfer",
    EWhile(_, _) => "loop",
    EForIn(_, _, _, _) => "loop",
    ELoop(_, _) => "loop",
    EHandle(_, _) => "handle",
    _ => "other"
  }
}

/// Callee spelling of a call-shaped leaf, so the declined call class can be
/// read by callee rather than counted as one lump. "-" for anything else.
fn leaf_callee(e: Expr) -> String {
  match e {
    ECall(callee, _, _, _) => match callee {
      EIdent(f, _) => f,
      _ => "<indirect>"
    },
    _ => "-"
  }
}

/// What the DECLARED contract of a call-shaped leaf's callee says about its
/// result: the three sets `classify_let_value_heap` already consults
/// (compile_expr_tail.vibe), plus "unresolved" for the callee it falls back to
/// its "any ECall is heap" over-approximation for.
fn call_contract(e: Expr, bound: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    ECall(callee, _, _, _) => match callee {
      EIdent(f, _) => if name_in(arr = bound, s = f) {
        "local"
      } else if is_borrow_ret_builtin(f) || name_in(arr = borrow_ret, s = f) {
        "borrow_ret"
      } else if name_in(arr = view_ret, s = f) {
        "view_ret"
      } else if name_in(arr = scalar_ret, s = f) {
        "scalar_ret"
      } else if name_in(arr = heap_ret, s = f) {
        "heap_ret"
      } else {
        "unresolved"
      },
      _ => "indirect"
    },
    _ => "-"
  }
}

fn owned_leaf(k: String) -> Bool {
  k == "tuple" || k == "record" || k == "array" || k == "ctor" || k == "call_heap_ret"
}

/// Every leaf of the value's RESULT spine, CLASSIFIED WHERE IT SITS: the walk
/// carries the scope down with it, so a call under `{ let mk = ...; mk(xs) }`
/// is read with `mk` bound exactly as `path_value_owned` reads it. Collecting
/// the leaves first and classifying them afterwards cannot do that -- the
/// binder is gone by then -- which is why the kind, the callee and the
/// contract are all produced here rather than by the caller. Mirrors
/// `value_has_borrowed_branch_tail`'s recursion (compile_expr_tail.vibe), the
/// existing precedent for reading a `let` value this way.
fn spine_walk(e: Expr, scope: Array[String], ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String], out_kinds: Array[String], out_callees: Array[String], out_contracts: Array[String]) -> Unit {
  match e {
    EIf(_, t, el) => {
      spine_walk(e = t, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts)
      spine_walk(e = el, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts)
    },
    EMatch(_, arms) => if Array::length(arms) == 0 {
      Array::push(out_kinds, value = "unit")
      Array::push(out_callees, value = "-")
      Array::push(out_contracts, value = "-")
    } else {
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, at = i)
        let mark = Array::length(scope)
        pat_bound_names(p = ap, out = scope)
        spine_walk(e = ab, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts)
        Array::truncate(scope, length = mark)
        i = i + 1
      }
    },
    ELet(n, _, b, _) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts)
      Array::truncate(scope, length = mark)
    },
    ELetMut(n, _, b, _) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts)
      Array::truncate(scope, length = mark)
    },
    ELetRec(n, _, b) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts)
      Array::truncate(scope, length = mark)
    },
    ESeq(_, b) => spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts),
    EAssign(_, _, b, _) => spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts),
    EAssignOp(_, _, _, b, _) => spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = out_kinds, out_callees = out_callees, out_contracts = out_contracts),
    _ => {
      Array::push(out_kinds, value = leaf_kind(e = e, ctors = ctors, bound = scope, borrow_ret = borrow_ret, view_ret = view_ret, heap_ret = heap_ret))
      Array::push(out_callees, value = leaf_callee(e = e))
      Array::push(out_contracts, value = call_contract(e = e, bound = scope, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret))
    }
  }
}

fn top_kind(e: Expr, ctors: Array[String], bound: Array[String], borrow_ret: Array[String], view_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    EIf(_, _, _) => "if",
    EMatch(_, _) => "match",
    ELet(_, _, _, _) => "let",
    ELetMut(_, _, _, _) => "letmut",
    ELetRec(_, _, _) => "letrec",
    ESeq(_, _) => "seq",
    EAssign(_, _, _, _) => "assign",
    EAssignOp(_, _, _, _, _) => "assignop",
    _ => leaf_kind(e = e, ctors = ctors, bound = bound, borrow_ret = borrow_ret, view_ret = view_ret, heap_ret = heap_ret)
  }
}

/// Find the `let` named `name`, report its value, and snapshot the names in
/// scope AT THAT SITE. The planner runs on a body
/// `uniquify_shadowed_bindings_fresh` already made unique, so at most one
/// `let` in the function carries the name.
///
/// The scope is per-site rather than per-function: `compile_match` truncates
/// `local_names` between arms and after the match, and `for`-in does the same,
/// so a binder in an unrelated arm is NOT in scope at this call and must not
/// make the probe report a global call as locally bound. A lambda is skipped
/// entirely -- its body is planned in its own frame, so a `let` inside one is
/// not a row of this function's plan (the exclusion
/// scripts/reuse_census_probe.vibe already makes for arms).
fn find_let_value(e: Expr, name: String, scope: Array[String], out: Array[Expr], out_scope: Array[String]) -> Unit {
  match e {
    EFn(_, _, _, _, _, _) => (),
    ELet(n, v, b, _) => {
      // The value is compiled before its own binder is in scope.
      find_let_value(e = v, name = name, scope = scope, out = out, out_scope = out_scope)
      if n == name {
        Array::push(out, value = v)
        let mut si = 0
        while si < Array::length(scope) {
          Array::push(out_scope, value = Array::get(scope, at = si))
          si = si + 1
        }
      } else {
        ()
      }
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      find_let_value(e = b, name = name, scope = scope, out = out, out_scope = out_scope)
      Array::truncate(scope, length = mark)
    },
    ELetMut(n, v, b, _) => {
      find_let_value(e = v, name = name, scope = scope, out = out, out_scope = out_scope)
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      find_let_value(e = b, name = name, scope = scope, out = out, out_scope = out_scope)
      Array::truncate(scope, length = mark)
    },
    ELetRec(n, v, b) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      find_let_value(e = v, name = name, scope = scope, out = out, out_scope = out_scope)
      find_let_value(e = b, name = name, scope = scope, out = out, out_scope = out_scope)
      Array::truncate(scope, length = mark)
    },
    EMatch(sc, arms) => {
      find_let_value(e = sc, name = name, scope = scope, out = out, out_scope = out_scope)
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, at = i)
        let mark = Array::length(scope)
        pat_bound_names(p = ap, out = scope)
        find_let_value(e = ab, name = name, scope = scope, out = out, out_scope = out_scope)
        Array::truncate(scope, length = mark)
        i = i + 1
      }
    },
    EForIn(n, io, seq, body) => {
      find_let_value(e = seq, name = name, scope = scope, out = out, out_scope = out_scope)
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      match io {
        Some(i2) => Array::push(scope, value = i2),
        None => ()
      }
      find_let_value(e = body, name = name, scope = scope, out = out, out_scope = out_scope)
      Array::truncate(scope, length = mark)
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        find_let_value(e = Array::get(kids, at = i), name = name, scope = scope, out = out, out_scope = out_scope)
        i = i + 1
      }
    }
  }
}

fn yn(b: Bool) -> String {
  if b {
    "y"
  } else {
    "n"
  }
}

fn uniq_sorted(xs: Array[String]) -> String {
  let seen: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, at = i)
    if name_in(arr = seen, s = x) {
      ()
    } else {
      Array::push(seen, value = x)
    }
    i = i + 1
  }
  let s = sorted_names_of(seen)
  let sb = StringBuilder::new()
  let mut j = 0
  while j < Array::length(s) {
    if j > 0 {
      StringBuilder::push(sb, value = ",")
    } else {
      ()
    }
    StringBuilder::push(sb, value = Array::get(s, at = j))
    j = j + 1
  }
  StringBuilder::freeze(sb)
}

fn report(fname: String, name: String, value: Expr, ctors: Array[String], row_scope: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> Unit with Console {
  let kinds: Array[String] = []
  let callees: Array[String] = []
  let contracts: Array[String] = []
  spine_walk(e = value, scope = row_scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out_kinds = kinds, out_callees = callees, out_contracts = contracts)
  let flat = owned_leaf(k = leaf_kind(e = value, ctors = ctors, bound = row_scope, borrow_ret = borrow_ret, view_ret = view_ret, heap_ret = heap_ret))
  let mut all_site = Array::length(kinds) > 0
  let mut first_bad = ""
  let mut bad_at = 0 - 1
  let mut i = 0
  while i < Array::length(kinds) {
    let k = Array::get(kinds, at = i)
    if owned_leaf(k = k) {
      ()
    } else {
      all_site = false
      if first_bad == "" {
        first_bad = k
        bad_at = i
      } else {
        ()
      }
    }
    i = i + 1
  }
  let verdict = if flat {
    "FLAT"
  } else if all_site {
    "SPINE"
  } else if first_bad == "" {
    "empty"
  } else {
    first_bad
  }
  // The callee and contract come from the LEAF that disqualified the binding,
  // classified in ITS scope: for `{ let k = 0; unknown(k) }` the value node is
  // an `ELet` and would report "-", which would drop exactly the wrapped-call
  // population the spine read exists to look at.
  let callee = if bad_at >= 0 {
    Array::get(callees, at = bad_at)
  } else {
    leaf_callee(e = value)
  }
  let contract = if bad_at >= 0 {
    Array::get(contracts, at = bad_at)
  } else {
    call_contract(e = value, bound = row_scope, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
  }
  let line = StringBuilder::new()
  StringBuilder::push(line, value = fname)
  StringBuilder::push(line, value = "\t")
  StringBuilder::push(line, value = name)
  StringBuilder::push(line, value = "\ttop=")
  StringBuilder::push(line, value = top_kind(e = value, ctors = ctors, bound = row_scope, borrow_ret = borrow_ret, view_ret = view_ret, heap_ret = heap_ret))
  StringBuilder::push(line, value = "\tflat=")
  StringBuilder::push(line, value = yn(b = flat))
  StringBuilder::push(line, value = "\tspine=")
  StringBuilder::push(line, value = yn(b = all_site))
  StringBuilder::push(line, value = "\tnleaves=")
  StringBuilder::push(line, value = __to_string(Array::length(kinds)))
  StringBuilder::push(line, value = "\tkinds=")
  StringBuilder::push(line, value = uniq_sorted(xs = kinds))
  StringBuilder::push(line, value = "\tverdict=")
  StringBuilder::push(line, value = verdict)
  StringBuilder::push(line, value = "\tcallee=")
  StringBuilder::push(line, value = callee)
  StringBuilder::push(line, value = "\tcontract=")
  StringBuilder::push(line, value = contract)
  println(StringBuilder::freeze(line))
}

fn param_annotation(params: Array[(String, Option[TypeExpr])], name: String) -> Option[Option[TypeExpr]] {
  let mut i = 0
  let mut found: Option[Option[TypeExpr]] = None
  while i < Array::length(params) {
    let (pn, pt) = Array::get(params, at = i)
    if pn == name {
      found = Some(pt)
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn collect_ctor_names(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(_, _, _, variants, _) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, at = v)
          Array::push(out, value = vn)
          v = v + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, at = v)
          Array::push(out, value = vn)
          v = v + 1
        }
      },
      SStruct(_, sname, _, _, _, _) => Array::push(out, value = sname),
      SModule(_, _, inner) => collect_ctor_names(stmts = inner, out = out),
      _ => ()
    }
    i = i + 1
  }
}

fn census(source: String) -> Unit with Exception + Console {
  let (toks, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = toks, starts = starts, source = source)
  // The lowering prelude requires the checker's argument placement on every
  // labeled call (ADR-0120); `vibe rc-plan` restores it the same way.
  let _ = check_program(stmts)
  restore_call_placements(stmts = stmts, rows = call_placement_checked_rows())
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts = stmts, entry_name = "main", linked_imports = linked, iw_names = iw_names, iw_wats = iw_wats, checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, at = 0))
  } else {
    ()
  }
  let ctors: Array[String] = []
  collect_ctor_names(stmts = stmts, out = ctors)
  let borrow_ret = sorted_names_of(compute_borrow_returning_names(stmts))
  let masks: Array[Int] = []
  let exclude = ["main", "_start", "cli_main"]
  let borrow_param = compute_borrow_param_user_fns(stmts = stmts, exclude = exclude, out_masks = masks)
  let view_ret = sorted_names_of(compute_may_return_view_fns(stmts))
  let scalar_ret = sorted_names_of(compute_scalar_returning_names(stmts))
  let heap_ret = sorted_names_of(compute_heap_returning(stmts))
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          let seen: Array[String] = []
          let norm = lift_match_scrutinees(expr = uniquify_shadowed_bindings_fresh(expr = value, counter = uq_shadow_counter, seen = seen), counter = m_scrut_counter)
          match norm {
            EFn(_, _, nparams, _, _, nbody) => {
              let plan = build_perceus_plan_with_params(params = nparams, body = nbody, borrow_ret_names = borrow_ret, borrow_param_fns = borrow_param, borrow_param_masks = masks, view_ret_fns = view_ret)
              // This function's own parameters. Everything else in scope at a
              // row is accumulated per site by find_let_value, because
              // compile_match and for-in truncate `local_names` at their
              // boundaries -- a binder in an unrelated arm is not in scope at
              // this call.
              let params0: Array[String] = []
              let mut pi = 0
              while pi < Array::length(nparams) {
                let (pn, _) = Array::get(nparams, at = pi)
                Array::push(params0, value = pn)
                pi = pi + 1
              }
              let mut k = 0
              while k < Array::length(plan) {
                let a = Array::get(plan, at = k)
                if pa_is_path_drop(a) {
                  let found: Array[Expr] = []
                  let row_scope: Array[String] = []
                  let seed: Array[String] = []
                  let mut si = 0
                  while si < Array::length(params0) {
                    Array::push(seed, value = Array::get(params0, at = si))
                    si = si + 1
                  }
                  find_let_value(e = nbody, name = a.name, scope = seed, out = found, out_scope = row_scope)
                  if Array::length(found) == 1 {
                    report(fname = name, name = a.name, value = Array::get(found, at = 0), ctors = ctors, row_scope = row_scope, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
                  } else {
                    // Not a `let` in this body: a parameter (split by whether
                    // its annotation is heap, the codegen's own test), or a
                    // pattern bind / an ambiguous name.
                    let verdict = match param_annotation(params = nparams, name = a.name) {
                      Some(ot) => if type_expr_is_heap(ot) {
                        "param_heap"
                      } else {
                        "param_scalar"
                      },
                      None => "not_a_let"
                    }
                    println(String::concat(String::concat(String::concat(String::concat(name, "\t"), a.name), "\ttop=-\tflat=n\tspine=n\tnleaves=0\tkinds=\tverdict="), verdict))
                  }
                } else {
                  ()
                }
                k = k + 1
              }
            },
            _ => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

test "path release census" {
  // scripts/path_release_census.sh stages the input here.
  let src = Fs::read_file("_build/path_release_census/input.vibe")
  census(source = src)
}
