//# Per-path release census (#2389). Run through scripts/path_release_census.sh.
//#
//# Classifies every `let` the Perceus planner emits a `PaPathDrop` row for --
//# a binding whose scope-end drop a branch merge planned away because SOME
//# branch spends its initial reference -- by the SHAPE OF ITS VALUE, which is
//# what the RC `let` lowering gates the guarded drop on
//# (compile_expr_tail.vibe's `path_value_ok`).
//#
//# The question it answers: how many of those bindings does the admission rule
//# accept, how much of that the recursive result-spine read is responsible
//# for, and -- for the ones it declines -- what the disqualifying leaf is, so
//# the next slice is chosen from a population rather than guessed at.
//#
//# Row: FN NAME top=<value's own node kind> flat=<y|n> spine=<y|n>
//#      nleaves=N kinds=<comma-separated leaf kinds, sorted and deduplicated>
//#      verdict=<FLAT|SPINE|<first leaf kind that is not site-allocated>>
//#
//# FLAT  = the value node is itself an owned leaf, so a flat test admits it.
//# SPINE = every leaf of the result spine is owned but the value node is not
//#         one, so only the recursive read admits it.
//# other = the leaf kind that disqualifies it, which is what a further slice
//#         would have to answer for.
//#
//# An OWNED leaf is an allocation made at the site (tuple / record / array
//# literal / constructor call) or a call to a named function whose declared
//# return type is heap and which neither borrow set claims -- the shipped
//# admission rule (`path_value_owned`, compile_expr_tail.vibe).
//#
//# Constructor-ness is by declaration here (every `SEnum` / `SSuberror`
//# variant name of the input), the same set the codegen's `CtorTable` holds
//# for this source; the codegen consults the table, this consults the decls.

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, expr_children, is_borrow_ret_builtin
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  compute_borrow_param_user_fns, compute_may_return_view_fns
}

import @vibe/compiler/perceus {
  build_perceus_plan_with_params, compute_borrow_returning_names, compute_heap_returning, compute_scalar_returning_names, pa_is_path_drop
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Leaf kind of one result-spine leaf. Only the first four are allocations
/// made at the site, which is what the guarded drop needs the value to be.
fn leaf_kind(e: Expr, ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    ETuple(_) => "tuple",
    ERecord(_, _, _) => "record",
    EArray(_) => "array",
    ECall(callee, _, _) => match callee {
      EIdent(f, _) => if name_in(ctors, f) {
        "ctor"
      } else if name_in(heap_ret, f) && !is_borrow_ret_builtin(f) && !name_in(borrow_ret, f) && !name_in(view_ret, f) {
        "call_heap_ret"
      } else {
        "call"
      },
      _ => "call_indirect"
    },
    EIdent(_, _) => "ident",
    EDot(_, _, _, _) => "proj",
    EInt(_) => "lit",
    EFloat(_) => "lit",
    EString(_) => "lit",
    EBool(_) => "lit",
    EUnit => "unit",
    EBinOp(_, _, _, _) => "binop",
    EUnaryOp(_, _) => "unop",
    EFn(_, _, _, _, _, _) => "lambda",
    EMap(_) => "map",
    EStringInterp(_) => "interp",
    EReturn(_) => "xfer",
    EBreak(_) => "xfer",
    EContinue(_) => "xfer",
    EWhile(_, _) => "loop",
    EForIn(_, _, _, _) => "loop",
    ELoop(_, _) => "loop",
    EHandle(_, _) => "handle",
    _ => "other"
  }
}

/// Callee spelling of a call-shaped leaf, so the declined call class can be
/// read by callee rather than counted as one lump. "-" for anything else.
fn leaf_callee(e: Expr) -> String {
  match e {
    ECall(callee, _, _) => match callee {
      EIdent(f, _) => f,
      _ => "<indirect>"
    },
    _ => "-"
  }
}

/// What the DECLARED contract of a call-shaped leaf's callee says about its
/// result: the three sets `classify_let_value_heap` already consults
/// (compile_expr_tail.vibe), plus "unresolved" for the callee it falls back to
/// its "any ECall is heap" over-approximation for.
fn call_contract(e: Expr, borrow_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    ECall(callee, _, _) => match callee {
      EIdent(f, _) => if is_borrow_ret_builtin(f) || name_in(borrow_ret, f) {
        "borrow_ret"
      } else if name_in(scalar_ret, f) {
        "scalar_ret"
      } else if name_in(heap_ret, f) {
        "heap_ret"
      } else {
        "unresolved"
      },
      _ => "indirect"
    },
    _ => "-"
  }
}

fn owned_leaf(k: String) -> Bool {
  k == "tuple" || k == "record" || k == "array" || k == "ctor" || k == "call_heap_ret"
}

/// Every leaf of the value's RESULT spine: what the binding is actually
/// handed, looked at through the wrappers that do not change it. Mirrors
/// `value_has_borrowed_branch_tail`'s recursion (compile_expr_tail.vibe),
/// which is the existing precedent for reading a `let` value this way.
fn spine_leaves(e: Expr, ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], heap_ret: Array[String], out: Array[String]) -> Unit {
  match e {
    EIf(_, t, el) => {
      spine_leaves(t, ctors, borrow_ret, view_ret, heap_ret, out)
      spine_leaves(el, ctors, borrow_ret, view_ret, heap_ret, out)
    },
    EMatch(_, arms) => if Array::length(arms) == 0 {
      Array::push(out, "empty_match")
    } else {
      let mut i = 0
      while i < Array::length(arms) {
        let (_, ab) = Array::get(arms, i)
        spine_leaves(ab, ctors, borrow_ret, view_ret, heap_ret, out)
        i = i + 1
      }
    },
    ELet(_, _, b, _) => spine_leaves(b, ctors, borrow_ret, view_ret, heap_ret, out),
    ELetMut(_, _, b, _) => spine_leaves(b, ctors, borrow_ret, view_ret, heap_ret, out),
    ELetRec(_, _, b) => spine_leaves(b, ctors, borrow_ret, view_ret, heap_ret, out),
    ESeq(_, b) => spine_leaves(b, ctors, borrow_ret, view_ret, heap_ret, out),
    EAssign(_, _, b) => spine_leaves(b, ctors, borrow_ret, view_ret, heap_ret, out),
    EAssignOp(_, _, _, b) => spine_leaves(b, ctors, borrow_ret, view_ret, heap_ret, out),
    _ => Array::push(out, leaf_kind(e, ctors, borrow_ret, view_ret, heap_ret))
  }
}

fn top_kind(e: Expr, ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    EIf(_, _, _) => "if",
    EMatch(_, _) => "match",
    ELet(_, _, _, _) => "let",
    ELetMut(_, _, _, _) => "letmut",
    ELetRec(_, _, _) => "letrec",
    ESeq(_, _) => "seq",
    EAssign(_, _, _) => "assign",
    EAssignOp(_, _, _, _) => "assignop",
    _ => leaf_kind(e, ctors, borrow_ret, view_ret, heap_ret)
  }
}

/// Find the `let` named `name` and report its value. The planner runs on a
/// body `uniquify_shadowed_bindings_fresh` already made unique, so at most one
/// `let` in the function carries the name.
fn find_let_value(e: Expr, name: String, out: Array[Expr]) -> Unit {
  match e {
    ELet(n, v, b, _) => {
      if n == name {
        Array::push(out, v)
      } else {
        ()
      }
      find_let_value(v, name, out)
      find_let_value(b, name, out)
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        find_let_value(Array::get(kids, i), name, out)
        i = i + 1
      }
    }
  }
}

fn yn(b: Bool) -> String {
  if b {
    "y"
  } else {
    "n"
  }
}

fn uniq_sorted(xs: Array[String]) -> String {
  let seen: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if name_in(seen, x) {
      ()
    } else {
      Array::push(seen, x)
    }
    i = i + 1
  }
  let s = sorted_names_of(seen)
  let sb = StringBuilder::new()
  let mut j = 0
  while j < Array::length(s) {
    if j > 0 {
      StringBuilder::push(sb, ",")
    } else {
      ()
    }
    StringBuilder::push(sb, Array::get(s, j))
    j = j + 1
  }
  StringBuilder::freeze(sb)
}

fn report(fname: String, name: String, value: Expr, ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> Unit with Stdout {
  let leaves: Array[String] = []
  spine_leaves(value, ctors, borrow_ret, view_ret, heap_ret, leaves)
  let flat = owned_leaf(leaf_kind(value, ctors, borrow_ret, view_ret, heap_ret))
  let mut all_site = Array::length(leaves) > 0
  let mut first_bad = ""
  let mut i = 0
  while i < Array::length(leaves) {
    let k = Array::get(leaves, i)
    if owned_leaf(k) {
      ()
    } else {
      all_site = false
      if first_bad == "" {
        first_bad = k
      } else {
        ()
      }
    }
    i = i + 1
  }
  let verdict = if flat {
    "FLAT"
  } else if all_site {
    "SPINE"
  } else if first_bad == "" {
    "empty"
  } else {
    first_bad
  }
  let line = StringBuilder::new()
  StringBuilder::push(line, fname)
  StringBuilder::push(line, "\t")
  StringBuilder::push(line, name)
  StringBuilder::push(line, "\ttop=")
  StringBuilder::push(line, top_kind(value, ctors, borrow_ret, view_ret, heap_ret))
  StringBuilder::push(line, "\tflat=")
  StringBuilder::push(line, yn(flat))
  StringBuilder::push(line, "\tspine=")
  StringBuilder::push(line, yn(all_site))
  StringBuilder::push(line, "\tnleaves=")
  StringBuilder::push(line, __to_string(Array::length(leaves)))
  StringBuilder::push(line, "\tkinds=")
  StringBuilder::push(line, uniq_sorted(leaves))
  StringBuilder::push(line, "\tverdict=")
  StringBuilder::push(line, verdict)
  StringBuilder::push(line, "\tcallee=")
  StringBuilder::push(line, leaf_callee(value))
  StringBuilder::push(line, "\tcontract=")
  StringBuilder::push(line, call_contract(value, borrow_ret, scalar_ret, heap_ret))
  println(StringBuilder::freeze(line))
}

fn collect_ctor_names(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, variants, _) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, v)
          Array::push(out, vn)
          v = v + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, v)
          Array::push(out, vn)
          v = v + 1
        }
      },
      SModule(_, _, inner) => collect_ctor_names(inner, out),
      _ => ()
    }
    i = i + 1
  }
}

fn census(source: String) -> Unit with Exception + Stdout {
  let (toks, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(toks, starts, source)
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts, "main", linked, iw_names, iw_wats, array_empty(), array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, 0))
  } else {
    ()
  }
  let ctors: Array[String] = []
  collect_ctor_names(stmts, ctors)
  let borrow_ret = sorted_names_of(compute_borrow_returning_names(stmts))
  let masks: Array[Int] = []
  let exclude = ["main", "_start", "cli_main"]
  let borrow_param = compute_borrow_param_user_fns(stmts, exclude, masks)
  let view_ret = sorted_names_of(compute_may_return_view_fns(stmts))
  let scalar_ret = sorted_names_of(compute_scalar_returning_names(stmts))
  let heap_ret = sorted_names_of(compute_heap_returning(stmts))
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          let seen: Array[String] = []
          let norm = lift_match_scrutinees(uniquify_shadowed_bindings_fresh(value, uq_shadow_counter, seen), m_scrut_counter)
          match norm {
            EFn(_, _, nparams, _, _, nbody) => {
              let plan = build_perceus_plan_with_params(nparams, nbody, borrow_ret, borrow_param, masks, view_ret)
              let mut k = 0
              while k < Array::length(plan) {
                let a = Array::get(plan, k)
                if pa_is_path_drop(a) {
                  let found: Array[Expr] = []
                  find_let_value(nbody, a.name, found)
                  if Array::length(found) == 1 {
                    report(name, a.name, Array::get(found, 0), ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
                  } else {
                    // Not a `let` in this body (a pattern bind or a parameter),
                    // or -- never observed -- an ambiguous name.
                    println(String::concat(String::concat(String::concat(name, "\t"), a.name), "\ttop=-\tflat=n\tspine=n\tnleaves=0\tkinds=\tverdict=not_a_let"))
                  }
                } else {
                  ()
                }
                k = k + 1
              }
            },
            _ => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

test "path release census" {
  // scripts/path_release_census.sh stages the input here.
  let src = Fs::read_file("_build/path_release_census/input.vibe")
  census(src)
}
