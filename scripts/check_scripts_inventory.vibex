// Every file under scripts/ is registered in scripts/inventory.tsv, and
// scripts/README.md names nothing that is not there (#3675, #2001 Phase 4):
//
//   bash scripts/vibe_run.sh scripts/check_scripts_inventory.vibex -- [--root DIR] [--list]
//
// The inventory is one row per file, five tab-separated fields:
//
//   path      relative to scripts/
//   category  gate | self-test | build | release | host-adapter | tool |
//             scaffolding | data | config | doc
//   entry     what runs it: a path (a task file, a workflow, the script that
//             calls it), `glob:<path>` for a driver that discovers it by
//             pattern, or `manual` for a tool a person runs
//   host      for a shell / JS / Python script, why it is not a .vibex (what
//             it launches), or `#NNNN`, the issue that will port it; `-` for
//             a .vibex and for a file that is not a script
//   removal   when the file can go, or `-`
//
// Lines starting with `#` are comments. The gate refuses:
//
// - a file under scripts/ with no row (`__pycache__` and dot-named files are
//   not files of the tree);
// - a row for a file that is not there, a duplicate row, a malformed row, an
//   unknown category;
// - an entry that names a file that is not there;
// - a non-.vibex script with no host reason and no migration issue;
// - a name in scripts/README.md that resolves to nothing. It reads what
//   check_scripts_readme.sh read: a backticked token ending in a script or
//   data extension, or containing `*`; one brace group; a name under
//   scripts/, under one scripts/<subdir>/, or from the repository root.
//   Nested braces, and a README with no names at all, fail rather than pass
//   unread.
//
// The inventory is migration scaffolding: it shrinks with scripts/.
//
// --root DIR checks the scripts/ of another tree (the self-test's, or a copy
// of the pre-commit staged snapshot); --repo DIR is where a root-relative name
// resolves -- an entry such as `Taskfile.pkl`, a README path such as
// `install/install.sh` -- and defaults to --root. --list prints each README
// name and what it resolved to.

import @vibe/builtin {
  String::replace_all
}
import @vibe/process {
  exit
}
import @vibex/shell {
  find, sort_str
}

struct Row {
  line: Int;
  path: String;
  category: String;
  entry: String;
  host: String
}

//# Arguments

fn arg(i: Int) -> String with Env {
  if i < Env::args_len() {
    Env::args_get(i)
  } else {
    ""
  }
}

fn option(name: String, fallback: String) -> String with Env {
  let mut out = fallback
  let mut i = 0
  while i < Env::args_len() {
    if Env::args_get(i) == name {
      out = arg(i = i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn has_flag(name: String) -> Bool with Env {
  let mut found = false
  let mut i = 0
  while i < Env::args_len() {
    if Env::args_get(i) == name {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

//# Strings

fn contains(xs: Array[String], x: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) {
    if Array::get(xs, at = i) == x {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn ends_with_any(s: String, exts: Array[String]) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(exts) {
    if String::ends_with(s, suffix = Array::get(exts, at = i)) {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn script_exts() -> Array[String] {
  [".sh", ".mjs", ".js", ".cjs", ".py", ".vibex"]
}

fn named_exts() -> Array[String] {
  [".sh", ".mjs", ".js", ".cjs", ".py", ".vibex", ".tsv", ".txt"]
}

fn categories() -> Array[String] {
  [
    "gate",
    "self-test",
    "build",
    "release",
    "host-adapter",
    "tool",
    "scaffolding",
    "data",
    "config",
    "doc"
  ]
}

fn basename(path: String) -> String {
  let parts = String::split(path, sep = "/")
  Array::get(parts, at = Array::length(parts) - 1)
}

fn is_digits(s: String) -> Bool {
  let mut ok = String::length(s) > 0
  let mut i = 0
  while i < String::length(s) {
    let c = String::byte_at(s, at = i)
    if c < '0' || c > '9' {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

//# The tree

/// Every file under `<root>/scripts`, relative to it, sorted.
fn tree_files(root: String) -> Array[String] with Fs {
  let base = "\{root}/scripts/"
  let out: Array[String] = []
  let entries = find("\{root}/scripts")
  let mut i = 0
  while i < Array::length(entries) {
    let e = Array::get(entries, at = i)
    let rel = String::substring(e.path, start = String::length(base), end = String::length(e.path))
    let skipped = String::starts_with(e.name, prefix = ".") || String::index_of(rel, needle = "__pycache__") >= 0 || String::index_of(rel, needle = "/.") >= 0
    if !e.is_dir && !skipped {
      Array::push(out, value = rel)
    } else {
      ()
    }
    i = i + 1
  }
  sort_str(out)
}

//# The inventory

/// The rows, and a failure line for each one that does not parse.
fn read_rows(text: String) -> (Array[Row], Array[String]) {
  let rows: Array[Row] = []
  let fails: Array[String] = []
  let lines = String::split(text, sep = "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, at = i)
    if line != "" && !String::starts_with(line, prefix = "#") {
      let f = String::split(line, sep = "\t")
      if Array::length(f) != 5 {
        Array::push(fails, value = "inventory.tsv:\{i + 1}: expected 5 tab-separated fields (path, category, entry, host, removal), got \{Array::length(f)}")
      } else {
        Array::push(rows, value = Row::{
          line: i + 1,
          path: Array::get(f, at = 0),
          category: Array::get(f, at = 1),
          entry: Array::get(f, at = 2),
          host: Array::get(f, at = 3)
        })
      }
    } else {
      ()
    }
    i = i + 1
  }
  (rows, fails)
}

fn check_rows(repo: String, rows: Array[Row], files: Array[String]) -> Array[String] with Fs {
  let fails: Array[String] = []
  let seen: Array[String] = []
  let mut i = 0
  while i < Array::length(rows) {
    let r = Array::get(rows, at = i)
    let at = "inventory.tsv:\{r.line}: `\{r.path}`"
    if contains(xs = seen, x = r.path) {
      Array::push(fails, value = "\{at} has a second row; keep one")
    } else {
      Array::push(seen, value = r.path)
    }
    if !contains(xs = files, x = r.path) {
      Array::push(fails, value = "\{at} is not under scripts/; delete its row (git history is the archive)")
    } else {
      ()
    }
    if !contains(xs = categories(), x = r.category) {
      Array::push(fails, value = "\{at} has category `\{r.category}`; use one of \{String::join(categories(), sep = ", ")}")
    } else {
      ()
    }
    if r.entry == "" {
      Array::push(fails, value = "\{at} has no entry; name what runs it, `glob:<driver>`, or `manual`")
    } else if r.entry != "manual" {
      let target = if String::starts_with(r.entry, prefix = "glob:") {
        String::substring(r.entry, start = 5, end = String::length(r.entry))
      } else {
        r.entry
      }
      if !Fs::is_file("\{repo}/\{target}") && !Fs::is_file("\{repo}/scripts/\{target}") {
        Array::push(fails, value = "\{at} names entry `\{r.entry}`, and `\{target}` is not there")
      } else {
        ()
      }
    } else {
      ()
    }
    let is_script = ends_with_any(s = r.path, exts = script_exts())
    if is_script && !String::ends_with(r.path, suffix = ".vibex") {
      if r.host == "" || r.host == "-" {
        Array::push(fails, value = "\{at} is a non-.vibex script with no host reason; say what it launches that a .vibex cannot, or name the issue that will port it (`#NNNN`)")
      } else if String::starts_with(r.host, prefix = "#") && !is_digits(s = String::substring(r.host, start = 1, end = String::length(r.host))) {
        Array::push(fails, value = "\{at} has host `\{r.host}`, which is neither a reason nor an issue number")
      } else {
        ()
      }
    } else {
      ()
    }
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(files) {
    let f = Array::get(files, at = j)
    if !contains(xs = seen, x = f) {
      Array::push(fails, value = "scripts/\{f} has no row in scripts/inventory.tsv; add one (path, category, entry, host, removal)")
    } else {
      ()
    }
    j = j + 1
  }
  fails
}

//# scripts/README.md

fn is_token_char(c: Int, first: Bool) -> Bool {
  let word = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '@' || c == '*'
  if first {
    word
  } else {
    word || c == '{' || c == '}' || c == ',' || c == '.' || c == '/' || c == '-'
  }
}

fn is_token(s: String) -> Bool {
  let mut ok = String::length(s) > 0
  let mut i = 0
  while i < String::length(s) {
    if !is_token_char(c = String::byte_at(s, at = i), first = i == 0) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// Whether the last path segment carries an extension (`.x` at its end).
fn has_extension(s: String) -> Bool {
  let base = basename(path = s)
  let dot = String::index_of(base, needle = ".")
  dot >= 0 && dot < String::length(base) - 1 && is_ext_tail(s = String::substring(base, start = dot + 1, end = String::length(base)))
}

fn is_ext_tail(s: String) -> Bool {
  // The text after the LAST dot is alphanumeric.
  let parts = String::split(s, sep = ".")
  let last = Array::get(parts, at = Array::length(parts) - 1)
  let mut ok = String::length(last) > 0
  let mut i = 0
  while i < String::length(last) {
    let c = String::byte_at(last, at = i)
    if !((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9')) {
      ok = false
    } else {
      ()
    }
    i = i + 1
  }
  ok
}

/// `(line, token)` for each name the README writes.
fn readme_names(text: String) -> Array[(Int, String)] {
  let out: Array[(Int, String)] = []
  let lines = String::split(text, sep = "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let spans = String::split(Array::get(lines, at = i), sep = "`")
    let mut k = 1
    while k < Array::length(spans) - 1 {
      let tok = String::trim(Array::get(spans, at = k))
      if is_token(s = tok) {
        if ends_with_any(s = tok, exts = named_exts()) {
          Array::push(out, value = (i + 1, tok))
        } else if String::index_of(tok, needle = "*") >= 0 && !has_extension(s = String::replace_all(tok, pattern = "*", replacement = "")) {
          Array::push(out, value = (i + 1, tok))
        } else {
          ()
        }
      } else {
        ()
      }
      k = k + 2
    }
    i = i + 1
  }
  out
}

fn count_of(s: String, c: Int) -> Int {
  let mut n = 0
  let mut i = 0
  while i < String::length(s) {
    if String::byte_at(s, at = i) == c {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

/// One brace group, expanded; nested or unbalanced braces are `[]`.
fn expand(tok: String) -> Array[String] {
  let opens = count_of(s = tok, c = '{')
  let close = count_of(s = tok, c = '}')
  if opens == 0 && close == 0 {
    [tok]
  } else if opens != 1 || close != 1 || String::index_of(tok, needle = "{") > String::index_of(tok, needle = "}") {
    []
  } else {
    let a = String::index_of(tok, needle = "{")
    let b = String::index_of(tok, needle = "}")
    let head = String::substring(tok, start = 0, end = a)
    let tail = String::substring(tok, start = b + 1, end = String::length(tok))
    let alts = String::split(String::substring(tok, start = a + 1, end = b), sep = ",")
    let out: Array[String] = []
    let mut i = 0
    while i < Array::length(alts) {
      Array::push(out, value = head + Array::get(alts, at = i) + tail)
      i = i + 1
    }
    out
  }
}

/// Whether `s` matches `pat`, where `*` (and `**`) is any run of characters
/// within one path segment, as Python's non-recursive `glob` reads them.
fn glob_match(pat: String, s: String) -> Bool {
  glob_from(pat = pat, p = 0, s = s, i = 0)
}

fn glob_from(pat: String, p: Int, s: String, i: Int) -> Bool {
  if p == String::length(pat) {
    i == String::length(s)
  } else if String::byte_at(pat, at = p) == '*' {
    let mut q = p
    while q < String::length(pat) && String::byte_at(pat, at = q) == '*' {
      q = q + 1
    }
    let mut j = i
    let mut found = false
    let mut going = true
    while going && !found {
      if glob_from(pat = pat, p = q, s = s, i = j) {
        found = true
      } else if j < String::length(s) && String::byte_at(s, at = j) != '/' {
        j = j + 1
      } else {
        going = false
      }
    }
    found
  } else if i < String::length(s) && String::byte_at(pat, at = p) == String::byte_at(s, at = i) {
    glob_from(pat = pat, p = p + 1, s = s, i = i + 1)
  } else {
    false
  }
}

/// Where a literal name lives, relative to the root, or "".
fn resolve(root: String, repo: String, name: String, files: Array[String]) -> String with Fs {
  if Fs::is_file("\{root}/scripts/\{name}") {
    "scripts/\{name}"
  } else if Fs::is_file("\{root}/\{name}") || Fs::is_file("\{repo}/\{name}") {
    name
  } else if String::index_of(name, needle = "/") < 0 {
    let mut found = ""
    let mut i = 0
    while i < Array::length(files) && found == "" {
      let f = Array::get(files, at = i)
      let parts = String::split(f, sep = "/")
      if Array::length(parts) == 2 && Array::get(parts, at = 1) == name {
        found = "scripts/\{f}"
      } else {
        ()
      }
      i = i + 1
    }
    found
  } else {
    ""
  }
}

fn matches(pattern: String, files: Array[String]) -> Int {
  let mut n = 0
  let mut i = 0
  while i < Array::length(files) {
    let f = Array::get(files, at = i)
    if glob_match(pat = pattern, s = f) || glob_match(pat = pattern, s = "scripts/\{f}") {
      n = n + 1
    } else {
      ()
    }
    i = i + 1
  }
  n
}

/// The README failures, and how many literal names and patterns it read.
fn check_readme(root: String, repo: String, files: Array[String], list: Bool) -> (Array[String], Int, Int) with Fs + Console {
  let fails: Array[String] = []
  let path = "\{root}/scripts/README.md"
  let names = if Fs::is_file(path) {
    readme_names(text = Fs::read_file(path))
  } else {
    []
  }
  let mut literals = 0
  let mut globs = 0
  if Array::length(names) == 0 {
    Array::push(fails, value = "scripts/README.md: no script name parsed out of it. The check would pass by seeing nothing, so it fails instead; check that names are still written in backticks")
  } else {
    let mut i = 0
    while i < Array::length(names) {
      let (line, tok) = Array::get(names, at = i)
      let members = expand(tok = tok)
      if Array::length(members) == 0 {
        Array::push(fails, value = "scripts/README.md:\{line}: `\{tok}` has nested or unbalanced braces, which this gate does not read; spell the names out, or use one brace group")
      } else {
        let mut m = 0
        while m < Array::length(members) {
          let name = Array::get(members, at = m)
          if String::index_of(name, needle = "*") >= 0 {
            globs = globs + 1
            let hits = matches(pattern = name, files = files)
            if list {
              Console::write_stream("\{tok}\t\{name}\t\{hits} match(es)\n")
            } else {
              ()
            }
            if hits == 0 {
              Array::push(fails, value = "scripts/README.md:\{line}: `\{tok}` -- the pattern `\{name}` matches no file under scripts/; repoint it, or delete the mention")
            } else {
              ()
            }
          } else {
            literals = literals + 1
            let where_ = resolve(root = root, repo = repo, name = name, files = files)
            if list {
              Console::write_stream("\{tok}\t\{name}\t\{if where_ == "" { "(missing)" } else { where_ }}\n")
            } else {
              ()
            }
            if where_ == "" {
              let from = if name == tok {
                ""
              } else {
                " (from `\{tok}`)"
              }
              Array::push(fails, value = "scripts/README.md:\{line}: names `\{name}`\{from}, and nothing is there; repoint it to the script's current name, or delete the mention")
            } else {
              ()
            }
          }
          m = m + 1
        }
      }
      i = i + 1
    }
  }
  (fails, literals, globs)
}

//# Main

fn main allows Env + Fs + Console + Process::exit {
  let root = option(name = "--root", fallback = ".")
  let repo = option(name = "--repo", fallback = root)
  let list = has_flag(name = "--list")
  if !Fs::is_dir("\{root}/scripts") {
    Stderr::write_stream("scripts-inventory: \{root}/scripts is not a directory\n")
    exit(2)
  } else {
    let files = tree_files(root = root)
    let inventory = "\{root}/scripts/inventory.tsv"
    let (rows, parse_fails) = if Fs::is_file(inventory) {
      read_rows(text = Fs::read_file(inventory))
    } else {
      ([], ["scripts/inventory.tsv is missing"])
    }
    let (readme_fails, literals, globs) = check_readme(root = root, repo = repo, files = files, list = list)
    if list {
      ()
    } else {
      let fails: Array[String] = []
      let parts = [parse_fails, check_rows(repo = repo, rows = rows, files = files), readme_fails]
      let mut p = 0
      while p < Array::length(parts) {
        let part = Array::get(parts, at = p)
        let mut q = 0
        while q < Array::length(part) {
          Array::push(fails, value = Array::get(part, at = q))
          q = q + 1
        }
        p = p + 1
      }
      if Array::length(fails) > 0 {
        let mut k = 0
        while k < Array::length(fails) {
          Stderr::write_stream("scripts-inventory: FAIL: \{Array::get(fails, at = k)}\n")
          k = k + 1
        }
        Stderr::write_stream("scripts-inventory: \{Array::length(fails)} problem(s)\n")
        exit(1)
      } else {
        Console::write_stream("scripts-inventory: ok (\{Array::length(files)} files registered; \{literals} names and \{globs} patterns in scripts/README.md resolve)\n")
      }
    }
  }
}
