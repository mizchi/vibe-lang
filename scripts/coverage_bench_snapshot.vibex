// Compact coverage snapshot stored on the bench-data branch. Only the
// union metrics are kept: an entry-weighted rate gets worse every time a
// test is added, which reads as a regression when coverage grew.
//
//   bash scripts/vibe_run.sh scripts/coverage_bench_snapshot.vibex -- report.json [prev.json]
//   bash scripts/vibe_run.sh scripts/coverage_bench_snapshot.vibex -- --self-test
//
// GITHUB_SHA and GITHUB_RUN_NUMBER are copied through. A corrupt previous
// snapshot leaves `prev` null instead of blocking the current one.

import @vibe/json {
  Json, Json::bool, Json::get_opt, Json::number, Json::parse, Json::stringify, Json::string, Json::type_of
}
import @vibe/time { now_utc_iso }
import @vibex/argparse { arg, flag }
import @vibex/tasks { die }

fn is_num(v: Json) -> Bool {
  Json::type_of(v) == "number"
}

fn num_field(obj: Json, key: String) -> Option[Float64] {
  match Json::get_opt(obj, key = key) {
    Some(v) => if is_num(v = v) { Some(Json::number(v)) } else { None },
    None => None
  }
}

fn obj_field(obj: Json, key: String) -> Option[Json] {
  match Json::get_opt(obj, key = key) {
    Some(v) => if Json::type_of(v) == "object" { Some(v) } else { None },
    None => None
  }
}

fn jnum(n: Float64) -> Json {
  JNum(n)
}

fn jstr(s: String) -> Json {
  JStr(s)
}

fn union_metrics(block: Json) -> Option[Json] {
  match num_field(obj = block, key = "hit") {
    Some(hit) => match num_field(obj = block, key = "total") {
      Some(total) => match num_field(obj = block, key = "rate") {
        Some(rate) => Some(JObj(Map::from_pairs([
          ("hit", jnum(n = hit)),
          ("total", jnum(n = total)),
          ("rate", jnum(n = rate))
        ]))),
        None => None
      },
      None => None
    },
    None => None
  }
}

fn branch_metrics(block: Json) -> Option[Json] {
  match num_field(obj = block, key = "hit") {
    Some(hit) => match num_field(obj = block, key = "total") {
      Some(total) => match num_field(obj = block, key = "rate") {
        Some(rate) => {
          let exact = match Json::get_opt(block, key = "exact") {
            Some(v) => if Json::type_of(v) == "boolean" { Json::bool(v) } else { true },
            None => true
          }
          Some(JObj(Map::from_pairs([
            ("hit", jnum(n = hit)),
            ("total", jnum(n = total)),
            ("rate", jnum(n = rate)),
            ("exact", JBool(exact))
          ])))
        },
        None => None
      },
      None => None
    },
    None => None
  }
}

fn opt_num(obj: Json, key: String) -> Json {
  match num_field(obj = obj, key = key) {
    Some(n) => jnum(n = n),
    None => JNull
  }
}

fn opt_str(obj: Json, key: String) -> Json {
  match Json::get_opt(obj, key = key) {
    Some(v) => if Json::type_of(v) == "string" && Json::string(v) != "" { jstr(s = Json::string(v)) } else { JNull },
    None => JNull
  }
}

fn prev_of(path: String) -> Json with Fs {
  if path == "" || !Fs::exists(path) {
    JNull
  } else {
    let parsed = Json::parse(Fs::read_file(path))
    match obj_field(obj = parsed, key = "function_union") {
      Some(fu) => match obj_field(obj = parsed, key = "branch_union") {
        Some(bu) => match num_field(obj = fu, key = "rate") {
          Some(fr) => match num_field(obj = bu, key = "rate") {
            Some(br) => JObj(Map::from_pairs([
              ("commit", opt_str(obj = parsed, key = "commit")),
              ("date", opt_str(obj = parsed, key = "date")),
              ("function_union_rate", jnum(n = fr)),
              ("branch_union_rate", jnum(n = br))
            ])),
            None => JNull
          },
          None => JNull
        },
        None => JNull
      },
      None => JNull
    }
  }
}

fn snapshot(report: Json, prev_path: String, commit: String, run_number: String, date: String) -> Json with Fs + Stderr + Process {
  match obj_field(obj = report, key = "function_union") {
    None => {
      die("coverage_bench_snapshot: suite report has no usable function_union — refusing to emit a partial snapshot")
      JNull
    },
    Some(fu) => match union_metrics(block = fu) {
      None => {
        die("coverage_bench_snapshot: suite report has no usable function_union — refusing to emit a partial snapshot")
        JNull
      },
      Some(function_union) => match obj_field(obj = report, key = "branch_union") {
        None => {
          die("coverage_bench_snapshot: suite report has no usable branch_union — refusing to emit a partial snapshot")
          JNull
        },
        Some(bu) => match branch_metrics(block = bu) {
          None => {
            die("coverage_bench_snapshot: suite report has no usable branch_union — refusing to emit a partial snapshot")
            JNull
          },
          Some(branch_union) => {
            let run = match Int::parse(run_number) {
              Some(n) => jnum(n = Int::to_float64(n)),
              None => JNull
            }
            JObj(Map::from_pairs([
              ("schema", jnum(n = 1.0)),
              ("commit", jstr(s = commit)),
              ("run_number", run),
              ("date", jstr(s = date)),
              ("function_union", function_union),
              ("branch_union", branch_union),
              ("entries_total", opt_num(obj = report, key = "entries_total")),
              ("entries_passed", opt_num(obj = report, key = "entries_passed")),
              ("case_rate", opt_num(obj = report, key = "case_rate")),
              ("prev", prev_of(path = prev_path))
            ]))
          }
        }
      }
    }
  }
}

fn expect(cond: Bool, message: String) -> Unit with Stderr + Process {
  if cond { () } else { die("coverage-bench-snapshot: " + message) }
}

fn hundredths(n: Float64) -> Int {
  Float64::to_int(n * 100.0 + 0.5)
}

fn self_test() -> Unit with Fs + Console + Stderr + Process {
  let dir = "_build/coverage-bench-snapshot-selftest"
  if Fs::exists(dir) { Fs::remove_tree(dir) } else { () }
  Fs::mkdir_p(dir)
  let report_path = dir + "/report.json"
  Fs::write_file(report_path, contents = "{\"function_union\":{\"hit\":12950,\"total\":14995,\"rate\":86.36},\"branch_union\":{\"hit\":26442,\"total\":45986,\"rate\":57.5,\"exact\":true},\"entries_total\":582,\"entries_passed\":582,\"case_rate\":100}\n")
  let prev_path = dir + "/prev.json"
  Fs::write_file(prev_path, contents = "{\"commit\":\"prevsha\",\"date\":\"2026-08-14T00:00:00Z\",\"function_union\":{\"hit\":1,\"total\":2,\"rate\":86},\"branch_union\":{\"hit\":1,\"total\":2,\"rate\":57.07}}\n")
  let doc = snapshot(report = Json::parse(Fs::read_file(report_path)), prev_path = prev_path, commit = "abc123def456", run_number = "1234", date = "2026-09-26T00:00:00Z")
  expect(cond = Json::string(match Json::get_opt(doc, key = "commit") { Some(v) => v, None => JNull }) == "abc123def456", message = "commit")
  match Json::get_opt(doc, key = "run_number") {
    Some(v) => expect(cond = hundredths(n = Json::number(v)) == 123400, message = "run_number"),
    None => die("coverage-bench-snapshot: missing run_number")
  }
  match Json::get_opt(doc, key = "branch_union") {
    Some(b) => {
      expect(cond = hundredths(n = Json::number(match Json::get_opt(b, key = "rate") { Some(v) => v, None => JNull })) == 5750, message = "branch rate")
      expect(cond = Json::bool(match Json::get_opt(b, key = "exact") { Some(v) => v, None => JNull }), message = "exact")
    },
    None => die("coverage-bench-snapshot: missing branch_union")
  }
  match Json::get_opt(doc, key = "prev") {
    Some(p) => {
      expect(cond = Json::string(match Json::get_opt(p, key = "commit") { Some(v) => v, None => JNull }) == "prevsha", message = "prev commit")
      expect(cond = hundredths(n = Json::number(match Json::get_opt(p, key = "branch_union_rate") { Some(v) => v, None => JNull })) == 5707, message = "prev branch rate")
    },
    None => die("coverage-bench-snapshot: missing prev")
  }
  let bare = snapshot(report = Json::parse(Fs::read_file(report_path)), prev_path = "", commit = "abc", run_number = "", date = "2026-09-26T00:00:00Z")
  expect(cond = Json::type_of(match Json::get_opt(bare, key = "prev") { Some(v) => v, None => JNull }) == "null", message = "no prev")
  expect(cond = Json::type_of(match Json::get_opt(bare, key = "run_number") { Some(v) => v, None => JNull }) == "null", message = "no run number")
  Fs::write_file(dir + "/bad.json", contents = "{ not json")
  let corrupt = snapshot(report = Json::parse(Fs::read_file(report_path)), prev_path = dir + "/bad.json", commit = "abc", run_number = "1", date = "2026-09-26T00:00:00Z")
  expect(cond = Json::type_of(match Json::get_opt(corrupt, key = "prev") { Some(v) => v, None => JNull }) == "null", message = "corrupt prev")
  let broken = Json::parse("{\"function_union\":{\"hit\":1,\"total\":2,\"rate\":1},\"branch_union\":{\"rate\":57.5}}")
  match obj_field(obj = broken, key = "branch_union") {
    Some(b) => expect(cond = match branch_metrics(block = b) { Some(_) => false, None => true }, message = "a rate without hit/total is not a snapshot"),
    None => die("coverage-bench-snapshot: broken fixture was not an object")
  }
  Fs::remove_tree(dir)
  println("coverage-bench-snapshot: ok")
}

fn main() -> Unit allows Env + Fs + Console + Process {
  if flag("--self-test") {
    self_test()
  } else {
    let report_path = arg(0)
    if report_path == "" {
      die("usage: coverage_bench_snapshot.vibex <suite_report.json> [prev_snapshot.json]")
    } else if !Fs::exists(report_path) {
      die("coverage_bench_snapshot: no such file: " + report_path)
    } else {
      let doc = snapshot(report = Json::parse(Fs::read_file(report_path)), prev_path = arg(1), commit = Env::get("GITHUB_SHA"), run_number = Env::get("GITHUB_RUN_NUMBER"), date = now_utc_iso())
      println(Json::stringify(doc))
    }
  }
}
