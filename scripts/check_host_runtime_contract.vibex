// Fail-closed drift check for the documented `vibe.*` core import contract.
// #3672 ported this gate from check_host_runtime_contract.py.
//
//   bash scripts/vibe_run.sh scripts/check_host_runtime_contract.vibex -- [--root DIR]
//   bash scripts/vibe_run.sh scripts/check_host_runtime_contract.vibex -- --check-signatures FILE
//
// docs/generated/host-runtime-contract.json is the contract. This gate reads
// it and holds four implementations to it:
//
//   * the linear-lane emitter (codegen/wasi/linked_compile.vibe's source
//     group): every static `vibe.*` import with its core type id, every
//     dynamic `<prefix><name>` import pattern, and -- #1962 criterion 4 --
//     which builtin each import is bound to, through the registry-name ->
//     index match, the index reservation and the emission;
//   * viberun (runtime/viberun/src/main.rs's group): every provider by name,
//     and (#1346) each provider closure's callable type against the emitter's;
//   * the node runner (scripts/wasm_vibe_host_runner.js's group): every
//     provider by name;
//   * the wasm-gc backend (codegen/gc/backend_body.vibe's group), which
//     hand-maintains FOUR parallel lists plus an import-vector header (#2759):
//     use_host, host_defs, host_imports, hbo and the header must agree with
//     each other, positionally, and with the contract's types and signatures;
//
// and canonical_builtin_name_ladder (core/builtin_name.vibe): every operation
// row names its builtin mechanically and reaches a static import.
//
// Every extraction pins the shape it reads and FAILS when it cannot read it:
// a provider closure, a list or a row this cannot parse is exactly where a
// drift would hide, so it is reported, never skipped.
//
// --root DIR checks another tree (the self-test's). --check-signatures FILE
// parses each line of FILE as a coreTypeSignatures entry and prints
// `<params> <ret>` or `REJECT`, one per line -- the strict signature parser,
// asked many questions in one run.

import @vibe/builtin {
  String::index_of_from, String::replace_all, String::to_lower
}
import @vibe/json {
  Json, parse
}
import @vibe/process {
  exit
}
import @vibex/shell {
  sort_str
}
import ./source_group.vibe {
  read_source_group
}

struct Def {
  name: String;
  index: Int;
  params: Int;
  ret: Int
}

struct Imp {
  name: String;
  type_id: String
}

struct Dyn {
  prefix: String;
  names_array: String;
  type_id: String
}

struct Pair {
  left: String;
  right: String
}

// --- small helpers ----------------------------------------------------------

fn option(name: String, fallback: String) -> String with Env::args_get + Env::args_len {
  let mut out = fallback
  let mut i = 0
  while i + 1 < Env::args_len() {
    if Env::args_get(i) == name {
      out = Env::args_get(i + 1)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn under(root: String, rel: String) -> String {
  if root == "." {
    rel
  } else {
    "\{root}/\{rel}"
  }
}

fn die(message: String) -> Unit with Stderr::write_stream + Process::exit {
  Stderr::write_stream("host-runtime-contract: \{message}\n")
  exit(1)
}

fn rest_of(s: String, at: Int) -> String {
  String::substring(s, start = at, end = String::length(s))
}

fn has_at(s: String, at: Int, lit: String) -> Bool {
  at >= 0 && at <= String::length(s) && String::starts_with(rest_of(s = s, at = at), prefix = lit)
}

fn is_space(c: Char) -> Bool {
  let code = Char::to_int(c)
  c == ' ' || (code >= 9 && code <= 13)
}

fn skip_spaces(s: String, at: Int) -> Int {
  let mut k = at
  while k < String::length(s) && is_space(c = String::byte_at(s, at = k)) {
    k = k + 1
  }
  k
}

/// `\s*\n\s*` at `at` (a whitespace run holding a newline, maximal because
/// what follows is not whitespace): the end, or -1.
fn newline_gap(s: String, at: Int) -> Int {
  let end = skip_spaces(s = s, at = at)
  let mut saw = false
  let mut k = at
  while k < end {
    if String::byte_at(s, at = k) == '\n' {
      saw = true
    } else {
      ()
    }
    k = k + 1
  }
  if saw {
    end
  } else {
    -1
  }
}

fn is_digit(c: Char) -> Bool {
  c >= '0' && c <= '9'
}

fn is_word(c: Char) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || is_digit(c = c) || c == '_'
}

fn is_upper(c: Char) -> Bool {
  c >= 'A' && c <= 'Z'
}

fn word_end(s: String, at: Int) -> Int {
  let mut k = at
  while k < String::length(s) && is_word(c = String::byte_at(s, at = k)) {
    k = k + 1
  }
  k
}

fn digits_end(s: String, at: Int) -> Int {
  let mut k = at
  while k < String::length(s) && is_digit(c = String::byte_at(s, at = k)) {
    k = k + 1
  }
  k
}

fn to_int(digits: String) -> Int {
  let mut v = 0
  let mut i = 0
  while i < String::length(digits) {
    v = v * 10 + (Char::to_int(String::byte_at(digits, at = i)) - 48)
    i = i + 1
  }
  v
}

fn contains(xs: Array[String], x: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(xs) && !found {
    if Array::get(xs, at = i) == x {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

/// Sorted, without repeats.
fn set_of(xs: Array[String]) -> Array[String] {
  let sorted = sort_str(xs)
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(sorted) {
    let x = Array::get(sorted, at = i)
    if Array::length(out) == 0 || Array::get(out, at = Array::length(out) - 1) != x {
      Array::push(out, value = x)
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn minus(xs: Array[String], ys: Array[String]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    if !contains(xs = ys, x = Array::get(xs, at = i)) {
      Array::push(out, value = Array::get(xs, at = i))
    } else {
      ()
    }
    i = i + 1
  }
  set_of(xs = out)
}

fn intersect(xs: Array[String], ys: Array[String]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    if contains(xs = ys, x = Array::get(xs, at = i)) {
      Array::push(out, value = Array::get(xs, at = i))
    } else {
      ()
    }
    i = i + 1
  }
  set_of(xs = out)
}

fn concat_all(xs: Array[String], ys: Array[String]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    Array::push(out, value = Array::get(xs, at = i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(ys) {
    Array::push(out, value = Array::get(ys, at = j))
    j = j + 1
  }
  out
}

fn lookup(pairs: Array[Pair], key: String) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(pairs) {
    let p = Array::get(pairs, at = i)
    if p.left == key {
      out = p.right
    } else {
      ()
    }
    i = i + 1
  }
  out
}

fn has_key(pairs: Array[Pair], key: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(pairs) {
    if Array::get(pairs, at = i).left == key {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn keys_of(pairs: Array[Pair]) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Array::length(pairs) {
    Array::push(out, value = Array::get(pairs, at = i).left)
    i = i + 1
  }
  set_of(xs = out)
}

/// Python's repr of a str: single quotes unless the text holds one and no
/// double quote.
fn py_str(s: String) -> String {
  let has_single = String::index_of_from(s, sub = "'", start = 0) >= 0
  let has_double = String::index_of_from(s, sub = "\"", start = 0) >= 0
  let quote = if has_single && !has_double {
    "\""
  } else {
    "'"
  }
  let escaped = String::replace_all(String::replace_all(String::replace_all(String::replace_all(s, pattern = "\\", replacement = "\\\\"), pattern = "\n", replacement = "\\n"), pattern = "\t", replacement = "\\t"), pattern = "\r", replacement = "\\r")
  let body = if quote == "'" {
    String::replace_all(escaped, pattern = "'", replacement = "\\'")
  } else {
    escaped
  }
  "\{quote}\{body}\{quote}"
}

fn py_list(xs: Array[String]) -> String {
  let parts: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    Array::push(parts, value = py_str(s = Array::get(xs, at = i)))
    i = i + 1
  }
  "[\{String::join(parts, sep = ", ")}]"
}

fn int_list(xs: Array[Int]) -> String {
  let parts: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    Array::push(parts, value = "\{Array::get(xs, at = i)}")
    i = i + 1
  }
  "[\{String::join(parts, sep = ", ")}]"
}

fn dyn_dict(xs: Array[Dyn]) -> String {
  let parts: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    let d = Array::get(xs, at = i)
    Array::push(parts, value = "\{py_str(s = d.prefix)}: (\{py_str(s = d.names_array)}, \{py_str(s = d.type_id)})")
    i = i + 1
  }
  "{\{String::join(parts, sep = ", ")}}"
}

/// Every `<head>X"` with X non-empty and quote-free, as `re.findall` reads it.
fn quoted_after(text: String, head: String) -> Array[String] {
  let out: Array[String] = []
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, sub = head, start = from)
    if at < 0 {
      going = false
    } else {
      let start = at + String::length(head)
      let close = String::index_of_from(text, sub = "\"", start = start)
      if close < 0 {
        going = false
      } else if close > start {
        Array::push(out, value = String::substring(text, start = start, end = close))
        from = close + 1
      } else {
        from = at + 1
      }
    }
  }
  out
}

/// The positions `^` matches at under re.M: 0 and every position after a
/// newline.
fn line_starts(text: String) -> Array[Int] {
  let out: Array[Int] = [0]
  let mut from = 0
  let mut going = true
  while going {
    let nl = String::index_of_from(text, sub = "\n", start = from)
    if nl < 0 {
      going = false
    } else {
      Array::push(out, value = nl + 1)
      from = nl + 1
    }
  }
  out
}

// --- manifest ---------------------------------------------------------------

fn json_strings(j: Json) -> Array[String] {
  let out: Array[String] = []
  let mut i = 0
  while i < Json::length(j) {
    Array::push(out, value = Json::string(Json::index(j, idx = i)))
    i = i + 1
  }
  out
}

fn json_pairs(j: Json) -> Array[Pair] {
  let out: Array[Pair] = []
  if Json::type_of(j) == "object" {
    let keys = Json::keys(j)
    let mut i = 0
    while i < Array::length(keys) {
      let k = Array::get(keys, at = i)
      Array::push(out, value = Pair::{
        left: k,
        right: Json::string(Json::field(j, key = k))
      })
      i = i + 1
    }
  } else {
    ()
  }
  out
}

fn parse_manifest(text: String) -> (Bool, Json) {
  handle {
    let (j, consumed) = parse(text)
    let rest = String::trim(rest_of(s = text, at = consumed))
    (rest == "" && Json::type_of(j) == "object", j)
  } with { Exception::Throw(_) => (false, Json::parse("null")) }
}

// --- emitter ----------------------------------------------------------------

/// `emit_name(import_content, "vibe")` NEWLINE: the end, or -1.
fn vibe_anchor_end(text: String, at: Int) -> Int {
  let anchor = "emit_name(import_content, \"vibe\")"
  if has_at(s = text, at = at, lit = anchor) {
    newline_gap(s = text, at = at + String::length(anchor))
  } else {
    -1
  }
}

/// NEWLINE `bytebuf_push(import_content, 0)` NEWLINE
/// `leb128_encode_u32(import_content, TYPE)` from `at`: the type, stripped, or
/// "" when the shape does not match.
fn import_tail(text: String, at: Int) -> String {
  let a = newline_gap(s = text, at = at)
  let push = "bytebuf_push(import_content, 0)"
  if a < 0 || !has_at(s = text, at = a, lit = push) {
    ""
  } else {
    let b = newline_gap(s = text, at = a + String::length(push))
    let leb = "leb128_encode_u32(import_content, "
    if b < 0 || !has_at(s = text, at = b, lit = leb) {
      ""
    } else {
      let start = b + String::length(leb)
      let close = String::index_of_from(text, sub = ")", start = start)
      if close > start {
        String::trim(String::substring(text, start = start, end = close))
      } else {
        ""
      }
    }
  }
}

fn emitter_imports(text: String) -> Array[Pair] with Stderr::write_stream + Process::exit {
  let found: Array[Pair] = []
  let anchor = "emit_name(import_content, \"vibe\")"
  let head = "emit_name(import_content, \""
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, sub = anchor, start = from)
    if at < 0 {
      going = false
    } else {
      let p = vibe_anchor_end(text = text, at = at)
      let mut matched = false
      if p >= 0 && has_at(s = text, at = p, lit = head) {
        let start = p + String::length(head)
        let close = String::index_of_from(text, sub = "\"", start = start)
        if close > start && has_at(s = text, at = close, lit = "\")") {
          let type_id = import_tail(text = text, at = close + 2)
          if type_id != "" {
            let name = String::substring(text, start = start, end = close)
            if has_key(pairs = found, key = name) {
              die(message = "duplicate static emitter import: \{name}")
            } else {
              ()
            }
            Array::push(found, value = Pair::{ left: name, right: type_id })
            matched = true
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      from = if matched {
        at + String::length(anchor)
      } else {
        at + 1
      }
    }
  }
  if Array::length(found) == 0 {
    die(message = "could not parse any compiler-emitted vibe imports")
  } else {
    ()
  }
  found
}

fn is_ident_start(c: Char) -> Bool {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

/// `[A-Za-z_][A-Za-z0-9_]*` at `at`: the end, or -1.
fn ident_end(s: String, at: Int) -> Int {
  if at < String::length(s) && is_ident_start(c = String::byte_at(s, at = at)) {
    word_end(s = s, at = at + 1)
  } else {
    -1
  }
}

/// Generated `<prefix><Array::get(names, i)>` import descriptors.
fn emitter_dynamic_imports(text: String) -> Array[Dyn] with Stderr::write_stream + Process::exit {
  let found: Array[Dyn] = []
  let anchor = "emit_name(import_content, \"vibe\")"
  let head = "emit_name(import_content, String::concat(\""
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, sub = anchor, start = from)
    if at < 0 {
      going = false
    } else {
      let p = vibe_anchor_end(text = text, at = at)
      let mut matched = false
      if p >= 0 && has_at(s = text, at = p, lit = head) {
        let start = p + String::length(head)
        let close = String::index_of_from(text, sub = "\"", start = start)
        let mut k = if close > start && has_at(s = text, at = close, lit = "\",") {
          skip_spaces(s = text, at = close + 2)
        } else {
          -1
        }
        let mut names_array = ""
        if k >= 0 && has_at(s = text, at = k, lit = "Array::get(") {
          let n0 = k + 11
          let n1 = ident_end(s = text, at = n0)
          if n1 > 0 && has_at(s = text, at = n1, lit = ",") {
            names_array = String::substring(text, start = n0, end = n1)
            let i0 = skip_spaces(s = text, at = n1 + 1)
            let i1 = ident_end(s = text, at = i0)
            k = if i1 > 0 && has_at(s = text, at = i1, lit = ")))") {
              i1 + 3
            } else {
              -1
            }
          } else {
            k = -1
          }
        } else {
          k = -1
        }
        if k >= 0 {
          let type_id = import_tail(text = text, at = k)
          if type_id != "" {
            let prefix = String::substring(text, start = start, end = close)
            let mut d = 0
            while d < Array::length(found) {
              if Array::get(found, at = d).prefix == prefix {
                die(message = "duplicate dynamic emitter import prefix: \{prefix}")
              } else {
                ()
              }
              d = d + 1
            }
            Array::push(found, value = Dyn::{
              prefix: prefix,
              names_array: names_array,
              type_id: type_id
            })
            matched = true
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      from = if matched {
        at + String::length(anchor)
      } else {
        at + 1
      }
    }
  }
  found
}

fn same_dyn(a: Array[Dyn], b: Array[Dyn]) -> Bool {
  let mut same = Array::length(a) == Array::length(b)
  let mut i = 0
  while same && i < Array::length(a) {
    let x = Array::get(a, at = i)
    let mut hit = false
    let mut j = 0
    while j < Array::length(b) {
      let y = Array::get(b, at = j)
      if y.prefix == x.prefix && y.names_array == x.names_array && y.type_id == x.type_id {
        hit = true
      } else {
        ()
      }
      j = j + 1
    }
    same = hit
    i = i + 1
  }
  same
}

fn validate_emitter_contract(manifest: Json, text: String) -> (Array[Pair], Array[Dyn]) with Stderr::write_stream + Process::exit {
  let emitted = emitter_imports(text = text)
  let types_json = Json::field(manifest, key = "importTypes")
  if Json::type_of(types_json) != "object" {
    die(message = "manifest importTypes must map each static import to its type id")
  } else {
    ()
  }
  let expected = json_pairs(j = types_json)
  let emitted_keys = keys_of(pairs = emitted)
  let expected_keys = keys_of(pairs = expected)
  let changed: Array[String] = []
  let both = intersect(xs = emitted_keys, ys = expected_keys)
  let mut c = 0
  while c < Array::length(both) {
    let n = Array::get(both, at = c)
    if lookup(pairs = emitted, key = n) != lookup(pairs = expected, key = n) {
      Array::push(changed, value = n)
    } else {
      ()
    }
    c = c + 1
  }
  let missing = minus(xs = expected_keys, ys = emitted_keys)
  let extra = minus(xs = emitted_keys, ys = expected_keys)
  if Array::length(missing) > 0 || Array::length(extra) > 0 || Array::length(changed) > 0 || Array::length(emitted) != Array::length(expected) {
    die(message = "emitter signature drift: missing=\{py_list(xs = missing)} extra=\{py_list(xs = extra)} changed=\{py_list(xs = set_of(xs = changed))}")
  } else {
    ()
  }
  let patterns = Json::field(manifest, key = "componentAdapterPatterns")
  if Json::type_of(patterns) != "array" {
    die(message = "manifest componentAdapterPatterns must be a list")
  } else {
    ()
  }
  let expected_dynamic: Array[Dyn] = []
  let mut i = 0
  while i < Json::length(patterns) {
    let item = Json::index(patterns, idx = i)
    let keys = set_of(xs = Json::keys(item))
    if Json::type_of(item) != "object" || String::join(keys, sep = ",") != "namesArray,pattern,prefix,type" {
      die(message = "each componentAdapterPatterns entry must contain pattern, prefix, namesArray, and type")
    } else {
      ()
    }
    let pattern = Json::string(Json::field(item, key = "pattern"))
    let prefix = Json::string(Json::field(item, key = "prefix"))
    if pattern != "\{prefix}<name>" {
      die(message = "dynamic manifest pattern disagrees with prefix: \{pattern}")
    } else {
      ()
    }
    let mut d = 0
    while d < Array::length(expected_dynamic) {
      if Array::get(expected_dynamic, at = d).prefix == prefix {
        die(message = "duplicate manifest dynamic prefix: \{prefix}")
      } else {
        ()
      }
      d = d + 1
    }
    Array::push(expected_dynamic, value = Dyn::{
      prefix: prefix,
      names_array: Json::string(Json::field(item, key = "namesArray")),
      type_id: Json::string(Json::field(item, key = "type"))
    })
    i = i + 1
  }
  let dynamic = emitter_dynamic_imports(text = text)
  if !same_dyn(a = dynamic, b = expected_dynamic) {
    die(message = "dynamic emitter drift: expected=\{dyn_dict(xs = expected_dynamic)} actual=\{dyn_dict(xs = dynamic)}")
  } else {
    ()
  }
  (emitted, dynamic)
}

// --- viberun ----------------------------------------------------------------

fn rust_imports(text: String) -> Array[String] with Stderr::write_stream + Process::exit {
  let out: Array[String] = []
  let head = "linker.func_wrap("
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, sub = head, start = from)
    if at < 0 {
      going = false
    } else {
      let q = skip_spaces(s = text, at = at + String::length(head))
      if has_at(s = text, at = q, lit = "\"vibe\",") {
        let n = skip_spaces(s = text, at = q + 7)
        if has_at(s = text, at = n, lit = "\"") {
          let close = String::index_of_from(text, sub = "\"", start = n + 1)
          if close > n + 1 {
            Array::push(out, value = String::substring(text, start = n + 1, end = close))
            from = close + 1
          } else {
            from = at + 1
          }
        } else {
          from = at + 1
        }
      } else {
        from = at + 1
      }
    }
  }
  if Array::length(out) == 0 {
    die(message = "could not parse any viberun vibe providers")
  } else {
    ()
  }
  set_of(xs = out)
}

fn is_rust_name(c: Char) -> Bool {
  is_word(c = c) || c == '$' || c == '-'
}

fn is_core_type(t: String) -> Bool {
  t == "i32" || t == "i64" || t == "f32" || t == "f64"
}

/// Split on commas at bracket depth 0.
///
/// A naive split shreds `Caller<'_, HostState>` -- measured, it turned 51
/// parseable providers into 49 unparseable ones, and an "unparseable" provider
/// is one this check silently says nothing about.
fn split_top_level(text: String) -> Array[String] {
  let out: Array[String] = []
  let mut depth = 0
  let mut run = 0
  let mut i = 0
  while i < String::length(text) {
    let c = String::byte_at(text, at = i)
    if c == '<' || c == '(' || c == '[' {
      depth = depth + 1
    } else if c == '>' || c == ')' || c == ']' {
      depth = depth - 1
    } else {
      ()
    }
    if c == ',' && depth == 0 {
      Array::push(out, value = String::substring(text, start = run, end = i))
      run = i + 1
    } else {
      ()
    }
    i = i + 1
  }
  let last = String::substring(text, start = run, end = String::length(text))
  if String::trim(last) != "" {
    Array::push(out, value = last)
  } else {
    ()
  }
  out
}

/// Core param types of a func_wrap closure, or None when not fully understood.
/// `Caller<'_, HostState>` is the host context, not a wasm parameter.
fn rust_params(params: String) -> (Bool, Array[String]) {
  let out: Array[String] = []
  let mut ok = true
  let parts = split_top_level(text = params)
  let mut i = 0
  while ok && i < Array::length(parts) {
    let part = String::trim(Array::get(parts, at = i))
    if part == "" || String::index_of_from(part, sub = "Caller<", start = 0) >= 0 {
      ()
    } else {
      // `:\s*([A-Za-z0-9_]+)\s*$`: a trailing word, then blanks, then `:`.
      let n = String::length(part)
      let mut s = n
      while s > 0 && is_word(c = String::byte_at(part, at = s - 1)) {
        s = s - 1
      }
      let mut c = s
      while c > 0 && is_space(c = String::byte_at(part, at = c - 1)) {
        c = c - 1
      }
      let ty = String::substring(part, start = s, end = n)
      if s < n && c > 0 && String::byte_at(part, at = c - 1) == ':' && is_core_type(t = ty) {
        Array::push(out, value = ty)
      } else {
        ok = false
      }
    }
    i = i + 1
  }
  (ok, out)
}

/// The closure's core result, `()` for none, or "" when not understood.
fn rust_result(ret: String) -> String {
  let arrow = String::index_of_from(ret, sub = "->", start = 0)
  let dropped = if arrow >= 0 {
    "\{String::substring(ret, start = 0, end = arrow)}\{rest_of(s = ret, at = arrow + 2)}"
  } else {
    ret
  }
  let value = String::trim(dropped)
  let unwrapped = if String::starts_with(value, prefix = "Result<") && String::ends_with(value, suffix = ">") && String::length(value) >= 8 {
    String::trim(String::substring(value, start = 7, end = String::length(value) - 1))
  } else {
    value
  }
  if unwrapped == "" || unwrapped == "()" {
    "()"
  } else if is_core_type(t = unwrapped) {
    unwrapped
  } else {
    ""
  }
}

/// After the closing `|` at `at`: `\s*(->\s*[^{]+?)?\s*\{`. The end and the
/// return spelling ("" for none), or -1.
fn closure_tail(text: String, at: Int) -> (Int, String) {
  let s = skip_spaces(s = text, at = at)
  if has_at(s = text, at = s, lit = "->") {
    let brace = String::index_of_from(text, sub = "{", start = s + 2)
    let ws = skip_spaces(s = text, at = s + 2)
    if brace > ws {
      let mut e = brace
      while e > ws && is_space(c = String::byte_at(text, at = e - 1)) {
        e = e - 1
      }
      (brace + 1, String::substring(text, start = s, end = e))
    } else if has_at(s = text, at = s, lit = "{") {
      (s + 1, "")
    } else {
      (-1, "")
    }
  } else if has_at(s = text, at = s, lit = "{") {
    (s + 1, "")
  } else {
    (-1, "")
  }
}

/// #1346: compare the PROVIDER's callable types against the emitter's.
///
/// Presence-by-name catches a provider that is missing and says nothing about
/// one present with the wrong arity or result type -- a mismatch wasmtime
/// reports at link time as an opaque signature error.
///
/// The closure is the first `|PARAMS|` within 4000 bytes of the provider's
/// name, followed by an optional `-> RET` and the body's `{`.
fn validate_rust_signatures(text: String, types: Array[Pair], sigs: Array[Pair]) -> Int with Stderr::write_stream + Process::exit {
  let mut checked = 0
  let mismatches: Array[String] = []
  let unreadable: Array[String] = []
  let n = String::length(text)
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, sub = "func_wrap(", start = from)
    if at < 0 {
      going = false
    } else {
      let mut end = -1
      let q = skip_spaces(s = text, at = at + 10)
      if has_at(s = text, at = q, lit = "\"vibe\"") {
        let c1 = skip_spaces(s = text, at = q + 6)
        let n0 = if has_at(s = text, at = c1, lit = ",") {
          skip_spaces(s = text, at = c1 + 1)
        } else {
          -1
        }
        if n0 >= 0 && has_at(s = text, at = n0, lit = "\"") {
          let mut n1 = n0 + 1
          while n1 < n && is_rust_name(c = String::byte_at(text, at = n1)) {
            n1 = n1 + 1
          }
          let c2 = if n1 > n0 + 1 && has_at(s = text, at = n1, lit = "\"") {
            skip_spaces(s = text, at = n1 + 1)
          } else {
            -1
          }
          if c2 >= 0 && has_at(s = text, at = c2, lit = ",") {
            let name = String::substring(text, start = n0 + 1, end = n1)
            let gap0 = c2 + 1
            let mut g = gap0
            while end < 0 && g <= gap0 + 4000 && g < n {
              if String::byte_at(text, at = g) == '|' {
                let close = String::index_of_from(text, sub = "|", start = g + 1)
                if close > g {
                  let (tail_end, ret) = closure_tail(text = text, at = close + 1)
                  if tail_end >= 0 {
                    end = tail_end
                    let (ok, parsed) = rust_params(params = String::substring(text, start = g + 1, end = close))
                    let result = rust_result(ret = ret)
                    if !ok || result == "" {
                      Array::push(unreadable, value = name)
                    } else {
                      let ty = if has_key(pairs = types, key = name) {
                        lookup(pairs = types, key = name)
                      } else {
                        "None"
                      }
                      if has_key(pairs = sigs, key = ty) {
                        let expected = lookup(pairs = sigs, key = ty)
                        let actual = "(\{String::join(parsed, sep = ", ")}) -> \{result}"
                        if actual != expected {
                          Array::push(mismatches, value = "\{name}: viberun \{actual} vs emitter \{expected}")
                        } else {
                          ()
                        }
                        checked = checked + 1
                      } else {
                        ()
                      }
                    }
                  } else {
                    ()
                  }
                } else {
                  ()
                }
              } else {
                ()
              }
              g = g + 1
            }
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      from = if end >= 0 {
        end
      } else {
        at + 1
      }
    }
  }
  if Array::length(unreadable) > 0 {
    die(message = "viberun provider signatures not understood: \{py_list(xs = sort_str(unreadable))}")
  } else {
    ()
  }
  if Array::length(mismatches) > 0 {
    die(message = "viberun provider signatures disagree with the emitter: \{String::join(sort_str(mismatches), sep = "; ")}")
  } else {
    ()
  }
  if checked == 0 {
    die(message = "no viberun provider signature could be compared; the parser has drifted")
  } else {
    ()
  }
  checked
}

// --- node runner ------------------------------------------------------------

/// `^\s*(?:\["NAME"\]|NAME)\s*\([^\n]*\)\s*\{` under re.M: the method names.
fn node_imports(text: String) -> Array[String] with Stderr::write_stream + Process::exit {
  let out: Array[String] = []
  let starts = line_starts(text = text)
  let n = String::length(text)
  let mut s = 0
  while s < Array::length(starts) {
    let p = skip_spaces(s = text, at = Array::get(starts, at = s))
    let mut name = ""
    let mut k = -1
    if has_at(s = text, at = p, lit = "[\"") {
      let close = String::index_of_from(text, sub = "\"", start = p + 2)
      if close > p + 2 && has_at(s = text, at = close, lit = "\"]") {
        name = String::substring(text, start = p + 2, end = close)
        k = close + 2
      } else {
        ()
      }
    } else if p < n && is_ident_start(c = String::byte_at(text, at = p)) {
      let mut e = p + 1
      while e < n && (is_word(c = String::byte_at(text, at = e)) || String::byte_at(text, at = e) == '-') {
        e = e + 1
      }
      name = String::substring(text, start = p, end = e)
      k = e
    } else {
      ()
    }
    if k >= 0 {
      let o = skip_spaces(s = text, at = k)
      if has_at(s = text, at = o, lit = "(") {
        let eol0 = String::index_of_from(text, sub = "\n", start = o)
        let eol = if eol0 < 0 {
          n
        } else {
          eol0
        }
        let mut hit = false
        let mut c = eol - 1
        while !hit && c > o {
          if String::byte_at(text, at = c) == ')' && has_at(s = text, at = skip_spaces(s = text, at = c + 1), lit = "{") {
            hit = true
          } else {
            ()
          }
          c = c - 1
        }
        if hit {
          Array::push(out, value = name)
        } else {
          ()
        }
      } else {
        ()
      }
    } else {
      ()
    }
    s = s + 1
  }
  if Array::length(out) == 0 {
    die(message = "could not parse any node-runner methods")
  } else {
    ()
  }
  set_of(xs = out)
}

// --- wasm-gc backend --------------------------------------------------------

/// Every `("NAME", D, D[, D, D])` -- `arity` integers -- in a block.
fn gc_tuples(body: String, arity: Int) -> Array[(String, Array[Int])] {
  let out: Array[(String, Array[Int])] = []
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(body, sub = "(\"", start = from)
    if at < 0 {
      going = false
    } else {
      let close = String::index_of_from(body, sub = "\"", start = at + 2)
      let ints: Array[Int] = []
      let mut k = if close > at + 2 {
        close + 1
      } else {
        -1
      }
      let mut c = 0
      while k >= 0 && c < arity {
        if has_at(s = body, at = k, lit = ",") {
          let d = skip_spaces(s = body, at = k + 1)
          let e = digits_end(s = body, at = d)
          if e > d {
            Array::push(ints, value = to_int(digits = String::substring(body, start = d, end = e)))
            k = e
          } else {
            k = -1
          }
        } else {
          k = -1
        }
        c = c + 1
      }
      if k >= 0 && has_at(s = body, at = k, lit = ")") {
        Array::push(out, value = (String::substring(body, start = at + 2, end = close), ints))
        from = k + 1
      } else {
        from = at + 1
      }
    }
  }
  out
}

fn gc_block(text: String, marker: String) -> String with Stderr::write_stream + Process::exit {
  let start = String::index_of_from(text, sub = marker, start = 0)
  let end = if start < 0 {
    -1
  } else {
    String::index_of_from(text, sub = "\n    ]", start = start)
  }
  if end < 0 {
    die(message = "could not find the gc backend's \{String::trim(marker)}")
  } else {
    ()
  }
  String::substring(text, start = start, end = end)
}

/// The FOUR parallel lists the wasm-gc backend hand-maintains, plus its
/// import-vector header. Moving one without the others is silently wrong.
fn gc_lists(text: String) -> (Array[String], Array[Def], Array[Imp], Int, Int) with Stderr::write_stream + Process::exit {
  let chain_at = String::index_of_from(text, sub = "let use_host = ", start = 0)
  if chain_at < 0 {
    die(message = "could not find the gc backend's use_host chain")
  } else {
    ()
  }
  let eol0 = String::index_of_from(text, sub = "\n", start = chain_at)
  let eol = if eol0 < 0 {
    String::length(text)
  } else {
    eol0
  }
  let chain = String::substring(text, start = chain_at + 15, end = eol)
  // `Map::has_key\(used_builtins, "([^"]+)"\)`: the name and its `")`.
  let use_host_names: Array[String] = []
  let head = "Map::has_key(used_builtins, \""
  let mut uf = 0
  let mut ugoing = true
  while ugoing {
    let at = String::index_of_from(chain, sub = head, start = uf)
    if at < 0 {
      ugoing = false
    } else {
      let start = at + String::length(head)
      let close = String::index_of_from(chain, sub = "\"", start = start)
      if close > start && has_at(s = chain, at = close, lit = "\")") {
        Array::push(use_host_names, value = String::substring(chain, start = start, end = close))
        uf = close + 2
      } else {
        uf = at + 1
      }
    }
  }
  if Array::length(use_host_names) == 0 {
    die(message = "gc use_host chain matched no builtin names")
  } else {
    ()
  }
  let hbo_head = "let hbo = if use_host {"
  let mut hbo = -1
  let mut hf = 0
  let mut hgoing = true
  while hgoing {
    let at = String::index_of_from(text, sub = hbo_head, start = hf)
    if at < 0 {
      hgoing = false
    } else {
      let d = newline_gap(s = text, at = at + String::length(hbo_head))
      let e = if d >= 0 {
        digits_end(s = text, at = d)
      } else {
        -1
      }
      if e > d && d >= 0 {
        hbo = to_int(digits = String::substring(text, start = d, end = e))
        hgoing = false
      } else {
        hf = at + 1
      }
    }
  }
  if hbo < 0 {
    die(message = "could not find the gc backend's hbo base offset")
  } else {
    ()
  }
  let header_head = "bytebuf_push_vec_header(imp_content, "
  let mut header = -1
  let mut vf = 0
  let mut vgoing = true
  while vgoing {
    let at = String::index_of_from(text, sub = header_head, start = vf)
    if at < 0 {
      vgoing = false
    } else {
      let d = at + String::length(header_head)
      let e = digits_end(s = text, at = d)
      if e > d && has_at(s = text, at = e, lit = ")") {
        header = to_int(digits = String::substring(text, start = d, end = e))
        vgoing = false
      } else {
        vf = at + 1
      }
    }
  }
  if header < 0 {
    die(message = "could not find the gc backend's import vector header")
  } else {
    ()
  }
  let defs_raw = gc_tuples(body = gc_block(text = text, marker = "let host_defs = ["), arity = 3)
  let imports_raw = gc_tuples(body = gc_block(text = text, marker = "let host_imports = ["), arity = 1)
  let defs: Array[Def] = []
  let mut i = 0
  while i < Array::length(defs_raw) {
    let (name, ints) = Array::get(defs_raw, at = i)
    Array::push(defs, value = Def::{
      name: name,
      params: Array::get(ints, at = 0),
      index: Array::get(ints, at = 1),
      ret: Array::get(ints, at = 2)
    })
    i = i + 1
  }
  let imports: Array[Imp] = []
  let mut j = 0
  while j < Array::length(imports_raw) {
    let (name, ints) = Array::get(imports_raw, at = j)
    Array::push(imports, value = Imp::{ name: name, type_id: "\{Array::get(ints, at = 0)}" })
    j = j + 1
  }
  if Array::length(defs) == 0 || Array::length(imports) == 0 {
    die(message = "gc host_defs or host_imports matched no entries")
  } else {
    ()
  }
  (use_host_names, defs, imports, hbo, header)
}

/// Console write spellings are a second name for the Stdout import, not a new
/// wasm function. They repeat that import's index in host_defs so codegen can
/// look the name up, and they do not count toward hbo or the import vector.
fn gc_stdout_alias_of(name: String) -> String {
  if name == "Console::write_stream" {
    "Stdout::write_stream"
  } else if name == "Console::write_char" {
    "Stdout::write_char"
  } else {
    ""
  }
}

/// `use_host` names the builtin a USER can write; `host_defs` registers the
/// name codegen lowers it to. Measured: `vibe_fs_read_dir_raw` is `unknown
/// name` from user code while `vibe_process_exit_raw` resolves (it needs
/// { Process }), which is why only one of the two raw names appears in both.
fn gc_lowered_alias(name: String) -> String {
  if name == "Fs::readdir" {
    "vibe_fs_read_dir_raw"
  } else {
    name
  }
}

/// `host_defs` spells a builtin the vibe way and `host_imports` spells the
/// wasm import it binds to. The mapping is mechanical -- `::` to `_`,
/// lowercased -- except for these, which predate that convention. Declared
/// rather than derived so a rename FAILS instead of being accepted; it exists
/// to make a same-signature REORDER detectable (Codex on #2765: swapping
/// `fs_is_dir` and `fs_is_file`, both ABI type 3, made the module call
/// `is_file` for `Fs::is_dir`).
fn gc_import_name_for(name: String) -> String {
  if name == "Env::get" {
    "env-get"
  } else if name == "Env::args_len" {
    "args-len"
  } else if name == "Env::args_get" {
    "args-get"
  } else if name == "Profiler::now_us" {
    "profile-now-us"
  } else if name == "vibe_fs_read_dir_raw" {
    "fs_read_dir_nul"
  } else if name == "vibe_process_exit_raw" {
    "process_exit"
  } else {
    String::to_lower(String::replace_all(name, pattern = "::", replacement = "_"))
  }
}

fn gc_import_rows(defs: Array[Def]) -> Array[Def] with Stderr::write_stream + Process::exit {
  let seen: Array[Def] = []
  let imports: Array[Def] = []
  let taken: Array[Int] = []
  let mut i = 0
  while i < Array::length(defs) {
    let d = Array::get(defs, at = i)
    let canonical = gc_stdout_alias_of(name = d.name)
    if canonical != "" {
      let mut ok = false
      let mut s = 0
      while s < Array::length(seen) {
        let o = Array::get(seen, at = s)
        if o.name == canonical {
          ok = o.index == d.index && o.params == d.params && o.ret == d.ret
        } else {
          ()
        }
        s = s + 1
      }
      if !ok {
        die(message = "gc host_defs \{py_str(s = d.name)} must alias \{canonical} (same index, params, and ret); got index \{d.index}, params=\{d.params}, ret=\{d.ret}")
      } else {
        ()
      }
    } else {
      let mut dup = false
      let mut t = 0
      while t < Array::length(taken) {
        if Array::get(taken, at = t) == d.index {
          dup = true
        } else {
          ()
        }
        t = t + 1
      }
      if dup {
        die(message = "gc host_defs \{py_str(s = d.name)} repeats import index \{d.index}, and it is not a stdout write alias")
      } else {
        ()
      }
      Array::push(seen, value = d)
      Array::push(taken, value = d.index)
      Array::push(imports, value = d)
    }
    i = i + 1
  }
  imports
}

/// `(i64, i64) -> ()` and `() -> i64`, and nothing else: the parameter count
/// and whether it returns, or -1 when the entry is not an ABI signature.
///
/// The value types are the four wasm NUMERIC types and nothing else: this
/// boundary passes tagged scalars, so a vector or reference type would
/// describe a call the runtime cannot make (Codex on #2770: an identifier
/// class accepted `(i65) -> i64` and `(string) -> bool`). The whole entry must
/// match (Codex on #2768: `()`, `""`, `(i64)`, `i64 -> i64` and
/// `(i64) => i64` all used to produce a shape).
fn signature_shape(raw: String) -> (Int, Int) {
  let s = String::trim(raw)
  let n = String::length(s)
  if !has_at(s = s, at = 0, lit = "(") {
    (-1, -1)
  } else {
    let mut p = skip_spaces(s = s, at = 1)
    let mut params = 0
    let mut ok = true
    if !has_at(s = s, at = p, lit = ")") {
      let mut going = true
      while ok && going {
        let t = String::substring(s, start = p, end = if p + 3 <= n {
          p + 3
        } else {
          n
        })
        if is_core_type(t = t) {
          params = params + 1
          let q = skip_spaces(s = s, at = p + 3)
          if has_at(s = s, at = q, lit = ",") {
            p = skip_spaces(s = s, at = q + 1)
          } else if has_at(s = s, at = q, lit = ")") {
            p = q
            going = false
          } else {
            ok = false
          }
        } else {
          ok = false
        }
      }
    } else {
      ()
    }
    if !ok || !has_at(s = s, at = p, lit = ")") {
      (-1, -1)
    } else {
      let a = skip_spaces(s = s, at = p + 1)
      if !has_at(s = s, at = a, lit = "->") {
        (-1, -1)
      } else {
        let r = skip_spaces(s = s, at = a + 2)
        let rhs = rest_of(s = s, at = r)
        let unit_ret = if has_at(s = s, at = r, lit = "(") {
          String::trim(rest_of(s = s, at = r + 1)) == ")"
        } else {
          false
        }
        if unit_ret {
          // `rhs.strip() == "()"` decides `ret`: `( )` parses and still counts
          // as returning, as the Python parser had it.
          (params, if String::trim(rhs) == "()" {
            0
          } else {
            1
          })
        } else if is_core_type(t = rhs) {
          (params, 1)
        } else {
          (-1, -1)
        }
      }
    }
  }
}

fn validate_gc_lists(manifest_names: Array[String], text: String, import_types: Array[Pair], core_sigs: Array[Pair]) -> Int with Stderr::write_stream + Process::exit {
  let (use_host, defs, imports, hbo, header) = gc_lists(text = text)
  let def_names_all: Array[String] = []
  let mut i = 0
  while i < Array::length(defs) {
    Array::push(def_names_all, value = Array::get(defs, at = i).name)
    i = i + 1
  }
  let def_names = set_of(xs = def_names_all)
  let rows = gc_import_rows(defs = defs)
  // Compared as SETS: `host_defs` is append-only by its own rule while
  // `use_host` is a boolean OR chain, so the two orders legitimately diverge.
  let lowered_all: Array[String] = []
  let mut u = 0
  while u < Array::length(use_host) {
    Array::push(lowered_all, value = gc_lowered_alias(name = Array::get(use_host, at = u)))
    u = u + 1
  }
  let lowered = set_of(xs = lowered_all)
  let missing = minus(xs = def_names, ys = lowered)
  let extra = minus(xs = lowered, ys = def_names)
  if Array::length(missing) > 0 || Array::length(extra) > 0 {
    die(message = "gc use_host/host_defs drift: missing=\{py_list(xs = missing)} extra=\{py_list(xs = extra)}")
  } else {
    ()
  }
  // Import indices ARE the call indices, so the non-alias rows must be 1..n
  // in order.
  let indices: Array[Int] = []
  let mut in_order = true
  let mut r = 0
  while r < Array::length(rows) {
    let idx = Array::get(rows, at = r).index
    Array::push(indices, value = idx)
    if idx != r + 1 {
      in_order = false
    } else {
      ()
    }
    r = r + 1
  }
  if !in_order {
    die(message = "gc host_defs indices are not 1..\{Array::length(rows)} in order: \{int_list(xs = indices)}")
  } else {
    ()
  }
  if Array::length(imports) != Array::length(rows) {
    die(message = "gc host_imports has \{Array::length(imports)} entries for \{Array::length(rows)} host imports")
  } else {
    ()
  }
  // POSITIONAL, not just equal-length: import order fixes the wasm function
  // indices that host_defs's absolute call indices address (Codex on #2765).
  let mut p = 0
  while p < Array::length(rows) {
    let def_name = Array::get(rows, at = p).name
    let import_name = Array::get(imports, at = p).name
    let expected = gc_import_name_for(name = def_name)
    if expected != import_name {
      die(message = "gc host_imports[\{p + 1}] is \{py_str(s = import_name)}, expected \{py_str(s = expected)} for host_defs entry \{py_str(s = def_name)} (add an exception to gc_import_name_for in scripts/check_host_runtime_contract.vibex if this rename is intended)")
    } else {
      ()
    }
    p = p + 1
  }
  // hbo is an OFFSET, not a name: corrupt it and nothing is missing, every
  // generated body index simply shifts. It gets its own assertion.
  if hbo != Array::length(rows) {
    die(message = "gc hbo is \{hbo} for \{Array::length(rows)} host imports")
  } else {
    ()
  }
  if header != hbo + 1 {
    die(message = "gc import vector header is \{header}, expected hbo + 1 = \{hbo + 1} (wasi fd_write is the extra entry)")
  } else {
    ()
  }
  let import_names_all: Array[String] = []
  let mut m = 0
  while m < Array::length(imports) {
    Array::push(import_names_all, value = Array::get(imports, at = m).name)
    m = m + 1
  }
  let unknown = minus(xs = set_of(xs = import_names_all), ys = manifest_names)
  if Array::length(unknown) > 0 {
    die(message = "gc host_imports names absent from the host-runtime contract: \{py_list(xs = unknown)}")
  } else {
    ()
  }
  // The ABI type id decides the wasm signature the generated call is checked
  // against. A missing importTypes entry fails CLOSED: band membership does
  // not imply an importTypes row.
  let mut t = 0
  while t < Array::length(imports) {
    let imp = Array::get(imports, at = t)
    if !has_key(pairs = import_types, key = imp.name) {
      die(message = "gc host_imports \{py_str(s = imp.name)} declares ABI type \{imp.type_id}, but the contract has no importTypes entry for it")
    } else if lookup(pairs = import_types, key = imp.name) != imp.type_id {
      die(message = "gc host_imports \{py_str(s = imp.name)} declares ABI type \{imp.type_id}, but the contract says \{lookup(pairs = import_types, key = imp.name)}")
    } else {
      ()
    }
    t = t + 1
  }
  // host_defs's `params` and `ret` feed fn_param_counts and fn_returns_list
  // independently of the import's type id, so either can drift while the
  // import still declares the old signature (Codex on #2765, third round).
  let mut s = 0
  while s < Array::length(rows) && s < Array::length(imports) {
    let d = Array::get(rows, at = s)
    let imp = Array::get(imports, at = s)
    if !has_key(pairs = core_sigs, key = imp.type_id) {
      die(message = "gc host_imports \{py_str(s = imp.name)} uses ABI type \{imp.type_id}, which the contract does not describe")
    } else {
      ()
    }
    let signature = lookup(pairs = core_sigs, key = imp.type_id)
    let (want_params, want_ret) = signature_shape(raw = signature)
    if want_params < 0 {
      die(message = "host-runtime contract coreTypeSignatures entry is not an ABI signature: \{py_str(s = signature)}")
    } else {
      ()
    }
    if d.params != want_params || d.ret != want_ret {
      die(message = "gc host_defs \{py_str(s = d.name)} declares \{d.params} param(s)/ret=\{d.ret}, but its import \{py_str(s = imp.name)} is ABI type \{imp.type_id} = \{py_str(s = signature)} (\{want_params} param(s)/ret=\{want_ret})")
    } else {
      ()
    }
    s = s + 1
  }
  Array::length(rows)
}

// --- linear lane: one operation identity (#1962 criterion 4) ----------------
//
// The algebraic operation (`Fs::ReadFile`), the capability builtin
// (`Fs::read_file`) and the core import (`vibe.fs_read_file`) are three
// spellings of one operation, and each hop is hand-written:
// canonical_builtin_name's ladder, then linked_compile's registry-name ->
// index match, then the import it reserves and emits. Comparing the SET of
// emitted imports pinned none of the hops, so swapping two same-typed rows
// (`"Fs::is_dir" => fs_is_file_idx`) passed.
//
// A binding is recovered structurally: `"B" => y_idx`, `let y_idx = if
// x_import_idx >= 0 {`, and the `if x_import_idx >= 0 { emit_name(..,
// "vibe") emit_name(.., "NAME")` block. NAME must be B's mechanical import
// name, or a declared exception below -- declared, so a rename FAILS.

fn linear_exceptions() -> Array[Pair] {
  [
    Pair::{ left: "Env::get", right: "env-get" },
    Pair::{ left: "Env::args_len", right: "args-len" },
    Pair::{ left: "Env::args_get", right: "args-get" },
    Pair::{ left: "Profiler::now_us", right: "profile-now-us" },
    Pair::{ left: "Profiler::NowUs", right: "profile-now-us" },
    Pair::{ left: "Profiler::heap_bytes", right: "profile-heap-bytes" },
    Pair::{ left: "Profiler::HeapBytes", right: "profile-heap-bytes" },
    Pair::{ left: "sleep_blocking", right: "sleep" },
    Pair::{ left: "Console::read_stream", right: "stdin_read_stream" },
    Pair::{ left: "Console::read_char", right: "stdin_read_char" },
    Pair::{ left: "Console::write_stream", right: "stdout_write_stream" },
    Pair::{ left: "Console::write_char", right: "stdout_write_char" },
    Pair::{ left: "Console::write_err_stream", right: "stderr_write_stream" },
    Pair::{ left: "Console::write_err_char", right: "stderr_write_char" },
    Pair::{ left: "vibe_fs_read_dir_raw", right: "fs_read_dir_nul" },
    Pair::{ left: "Stdin::read_via_stream", right: "stdin_provider_acquire" },
    Pair::{ left: "StdinStream::next", right: "stdin_provider_read" },
    Pair::{ left: "StdinStream::close", right: "stdin_provider_close" }
  ]
}

/// The import a builtin binds to when no exception is declared.
fn linear_import_name_for(builtin: String) -> String {
  let exceptions = linear_exceptions()
  if has_key(pairs = exceptions, key = builtin) {
    lookup(pairs = exceptions, key = builtin)
  } else if String::starts_with(builtin, prefix = "vibe_") && String::ends_with(builtin, suffix = "_raw") && String::length(builtin) >= 9 {
    let core = String::substring(builtin, start = 5, end = String::length(builtin) - 4)
    if String::starts_with(core, prefix = "hf_sleep_") {
      "host_sleep_\{rest_of(s = core, at = 9)}"
    } else if String::starts_with(core, prefix = "hf_arg_") {
      "host_arg_\{rest_of(s = core, at = 7)}"
    } else if String::starts_with(core, prefix = "hf_") {
      "host_future_\{rest_of(s = core, at = 3)}"
    } else if String::starts_with(core, prefix = "hs_") {
      "host_stream_\{rest_of(s = core, at = 3)}"
    } else {
      core
    }
  } else {
    String::to_lower(String::replace_all(builtin, pattern = "::", replacement = "_"))
  }
}

/// A `\w+<suffix>` identifier at `at`: its end, or -1 (at least one word
/// character before the suffix).
fn suffixed_ident(s: String, at: Int, suffix: String) -> Int {
  let e = word_end(s = s, at = at)
  if e - at > String::length(suffix) && String::ends_with(String::substring(s, start = at, end = e), suffix = suffix) {
    e
  } else {
    -1
  }
}

/// The matches of a line-anchored pattern, non-overlapping, as `re.findall`
/// with re.M visits them: `matcher` gets the position after `^\s*` and returns
/// the end of its match (or -1) and its captures.
fn line_anchored(text: String, matcher: (String, Int) -> (Int, Array[String])) -> Array[Array[String]] {
  let out: Array[Array[String]] = []
  let starts = line_starts(text = text)
  let mut from = 0
  let mut s = 0
  while s < Array::length(starts) {
    let start = Array::get(starts, at = s)
    if start >= from {
      let (end, caps) = matcher(text, skip_spaces(s = text, at = start))
      if end >= 0 {
        Array::push(out, value = caps)
        from = end
      } else {
        ()
      }
    } else {
      ()
    }
    s = s + 1
  }
  out
}

/// `let X_import_idx = if COND {`
fn match_reservation(text: String, p: Int) -> (Int, Array[String]) {
  if !has_at(s = text, at = p, lit = "let ") {
    (-1, [])
  } else {
    let e = suffixed_ident(s = text, at = p + 4, suffix = "_import_idx")
    if e < 0 || !has_at(s = text, at = e, lit = " = if ") {
      (-1, [])
    } else {
      let c = e + 6
      let mut k = c
      while k < String::length(text) && String::byte_at(text, at = k) != '{' && String::byte_at(text, at = k) != '\n' {
        k = k + 1
      }
      if k > c && has_at(s = text, at = k, lit = "{") {
        (k + 1, [String::substring(text, start = p + 4, end = e)])
      } else {
        (-1, [])
      }
    }
  }
}

/// `let Y_idx = if X_import_idx >= 0 {`
fn match_index(text: String, p: Int) -> (Int, Array[String]) {
  if !has_at(s = text, at = p, lit = "let ") {
    (-1, [])
  } else {
    let e = suffixed_ident(s = text, at = p + 4, suffix = "_idx")
    if e < 0 || !has_at(s = text, at = e, lit = " = if ") {
      (-1, [])
    } else {
      let v = e + 6
      let f = suffixed_ident(s = text, at = v, suffix = "_import_idx")
      if f >= 0 && has_at(s = text, at = f, lit = " >= 0 {") {
        (f + 7, [
          String::substring(text, start = p + 4, end = e),
          String::substring(text, start = v, end = f)
        ])
      } else {
        (-1, [])
      }
    }
  }
}

/// `"B" => Y_idx,`
fn match_binding(text: String, p: Int) -> (Int, Array[String]) {
  if !has_at(s = text, at = p, lit = "\"") {
    (-1, [])
  } else {
    let close = String::index_of_from(text, sub = "\"", start = p + 1)
    if close <= p + 1 || !has_at(s = text, at = close, lit = "\" => ") {
      (-1, [])
    } else {
      let v = close + 5
      let e = suffixed_ident(s = text, at = v, suffix = "_idx")
      if e >= 0 && has_at(s = text, at = e, lit = ",") {
        (e + 1, [
          String::substring(text, start = p + 1, end = close),
          String::substring(text, start = v, end = e)
        ])
      } else {
        (-1, [])
      }
    }
  }
}

/// `if X_import_idx >= 0 {` NEWLINE `emit_name(import_content, "vibe")`
/// NEWLINE `emit_name(import_content, "NAME")`, anywhere: (X, NAME) in order.
fn emits(text: String) -> Array[Pair] {
  let out: Array[Pair] = []
  let mut from = 0
  let mut going = true
  while going {
    let at = String::index_of_from(text, sub = "if ", start = from)
    if at < 0 {
      going = false
    } else {
      let mut end = -1
      let e = suffixed_ident(s = text, at = at + 3, suffix = "_import_idx")
      if e >= 0 && has_at(s = text, at = e, lit = " >= 0 {") {
        let a = newline_gap(s = text, at = e + 7)
        let p = if a >= 0 {
          vibe_anchor_end(text = text, at = a)
        } else {
          -1
        }
        let head = "emit_name(import_content, \""
        if p >= 0 && has_at(s = text, at = p, lit = head) {
          let start = p + String::length(head)
          let close = String::index_of_from(text, sub = "\"", start = start)
          if close > start && has_at(s = text, at = close, lit = "\")") {
            Array::push(out, value = Pair::{
              left: String::substring(text, start = at + 3, end = e),
              right: String::substring(text, start = start, end = close)
            })
            end = close + 2
          } else {
            ()
          }
        } else {
          ()
        }
      } else {
        ()
      }
      from = if end >= 0 {
        end
      } else {
        at + 1
      }
    }
  }
  out
}

fn linear_bindings(text: String) -> Array[Pair] with Stderr::write_stream + Process::exit {
  let reserved_caps = line_anchored(text = text, matcher = match_reservation)
  let reserved: Array[String] = []
  let mut r = 0
  while r < Array::length(reserved_caps) {
    Array::push(reserved, value = Array::get(Array::get(reserved_caps, at = r), at = 0))
    r = r + 1
  }
  let index_caps = line_anchored(text = text, matcher = match_index)
  let idx_of: Array[Pair] = []
  let mut x = 0
  while x < Array::length(index_caps) {
    let caps = Array::get(index_caps, at = x)
    Array::push(idx_of, value = Pair::{
      left: Array::get(caps, at = 0),
      right: Array::get(caps, at = 1)
    })
    x = x + 1
  }
  let emitted = emits(text = text)
  if Array::length(reserved) == 0 || Array::length(emitted) == 0 {
    die(message = "linear lane: import reservation or emission shape changed; binding check cannot read it")
  } else {
    ()
  }
  let emitted_vars: Array[String] = []
  let mut v = 0
  while v < Array::length(emitted) {
    Array::push(emitted_vars, value = Array::get(emitted, at = v).left)
    v = v + 1
  }
  let reserved_emitted: Array[String] = []
  let mut w = 0
  while w < Array::length(reserved) {
    if contains(xs = emitted_vars, x = Array::get(reserved, at = w)) {
      Array::push(reserved_emitted, value = Array::get(reserved, at = w))
    } else {
      ()
    }
    w = w + 1
  }
  if String::join(reserved_emitted, sep = "\n") != String::join(emitted_vars, sep = "\n") {
    die(message = "linear lane: imports are emitted in a different order from their index reservation")
  } else {
    ()
  }
  let out: Array[Pair] = []
  let bindings = line_anchored(text = text, matcher = match_binding)
  let mut b = 0
  while b < Array::length(bindings) {
    let caps = Array::get(bindings, at = b)
    let builtin = Array::get(caps, at = 0)
    let idx = Array::get(caps, at = 1)
    if has_key(pairs = idx_of, key = idx) {
      let var = lookup(pairs = idx_of, key = idx)
      if !has_key(pairs = emitted, key = var) {
        die(message = "linear lane: `\{builtin}` is bound through \{var}, which emits no vibe import")
      } else {
        ()
      }
      Array::push(out, value = Pair::{ left: builtin, right: lookup(pairs = emitted, key = var) })
    } else {
      ()
    }
    b = b + 1
  }
  if Array::length(out) == 0 {
    die(message = "linear lane: no builtin -> import bindings found")
  } else {
    ()
  }
  out
}

fn validate_linear_bindings(text: String) -> Array[Pair] with Stderr::write_stream + Process::exit {
  let bindings = linear_bindings(text = text)
  let mut i = 0
  while i < Array::length(bindings) {
    let b = Array::get(bindings, at = i)
    let expected = linear_import_name_for(builtin = b.left)
    if b.right != expected {
      die(message = "linear lane: `\{b.left}` is bound to vibe.\{b.right}, expected vibe.\{expected}")
    } else {
      ()
    }
    i = i + 1
  }
  let stale = minus(xs = keys_of(pairs = linear_exceptions()), ys = keys_of(pairs = bindings))
  if Array::length(stale) > 0 {
    die(message = "linear_exceptions() in scripts/check_host_runtime_contract.vibex names builtins with no binding: \{py_list(xs = stale)}")
  } else {
    ()
  }
  bindings
}

/// `"Effect::Op" => "builtin",`
fn match_ladder_row(text: String, p: Int) -> (Int, Array[String]) {
  let n = String::length(text)
  if !has_at(s = text, at = p, lit = "\"") || p + 1 >= n || !is_upper(c = String::byte_at(text, at = p + 1)) {
    (-1, [])
  } else {
    let e1 = word_end(s = text, at = p + 2)
    if !has_at(s = text, at = e1, lit = "::") || e1 + 2 >= n || !is_upper(c = String::byte_at(text, at = e1 + 2)) {
      (-1, [])
    } else {
      let e2 = word_end(s = text, at = e1 + 3)
      if !has_at(s = text, at = e2, lit = "\" => \"") {
        (-1, [])
      } else {
        let b0 = e2 + 6
        let close = String::index_of_from(text, sub = "\"", start = b0)
        if close > b0 && has_at(s = text, at = close, lit = "\",") {
          (close + 2, [
            String::substring(text, start = p + 1, end = e2),
            String::substring(text, start = b0, end = close)
          ])
        } else {
          (-1, [])
        }
      }
    }
  }
}

/// `IsDir` -> `is_dir`: an underscore before every capital but the first,
/// lowercased.
fn snake(name: String) -> String {
  let out = StringBuilder::new()
  let mut i = 0
  while i < String::length(name) {
    let c = String::byte_at(name, at = i)
    if i > 0 && is_upper(c = c) {
      StringBuilder::push(out, value = "_")
    } else {
      ()
    }
    StringBuilder::push(out, value = String::substring(name, start = i, end = i + 1))
    i = i + 1
  }
  String::to_lower(StringBuilder::freeze(out))
}

fn validate_operation_ladder(text: String, bound: Array[Pair]) -> Int with Stderr::write_stream + Process::exit {
  let start = String::index_of_from(text, sub = "fn canonical_builtin_name_ladder", start = 0)
  if start < 0 {
    die(message = "canonical_builtin_name_ladder not found")
  } else {
    ()
  }
  let body = rest_of(s = text, at = start)
  let end0 = String::index_of_from(body, sub = "\n}\n", start = 0)
  let end = if end0 < 0 {
    String::length(body) - 1
  } else {
    end0
  }
  let rows = line_anchored(text = String::substring(body, start = 0, end = end), matcher = match_ladder_row)
  if Array::length(rows) == 0 {
    die(message = "canonical_builtin_name_ladder has no operation rows")
  } else {
    ()
  }
  let bound_names = keys_of(pairs = bound)
  let mut i = 0
  while i < Array::length(rows) {
    let row = Array::get(rows, at = i)
    let op = Array::get(row, at = 0)
    let builtin = Array::get(row, at = 1)
    let sep = String::index_of_from(op, sub = "::", start = 0)
    let effect = String::substring(op, start = 0, end = sep)
    let name = rest_of(s = op, at = sep + 2)
    let expected = if op == "Fs::ReadDir" {
      "Fs::readdir"
    } else {
      "\{effect}::\{snake(name = name)}"
    }
    if builtin != expected {
      die(message = "operation ladder: `\{op}` maps to `\{builtin}`, expected `\{expected}`")
    } else {
      ()
    }
    // compile_call.vibe lowers `Fs::readdir` to the raw read before the
    // import is chosen.
    let target = if builtin == "Fs::readdir" {
      "vibe_fs_read_dir_raw"
    } else {
      builtin
    }
    if !contains(xs = bound_names, x = target) {
      die(message = "operation ladder: `\{op}` -> `\{builtin}` reaches no vibe import on the linear lane")
    } else {
      ()
    }
    i = i + 1
  }
  Array::length(rows)
}

// --- main -------------------------------------------------------------------

/// ADR-0120: the emitter helpers the matchers above read have a stable
/// positional ABI, and a call may spell each argument with its parameter
/// label. These are the labels each helper's argument slots may carry; an
/// empty entry is a positional slot.
fn call_labels(callee: String) -> Array[String] {
  if callee == "emit_name" {
    ["buf", "name"]
  } else if callee == "bytebuf_push" {
    ["buf", "byte"]
  } else if callee == "bytebuf_push_vec_header" {
    ["buf", "count"]
  } else if callee == "leb128_encode_u32" {
    ["buf", "value"]
  } else if callee == "Array::get" {
    ["", "at"]
  } else if callee == "Map::has_key" {
    ["", "key"]
  } else {
    []
  }
}

/// The end of the vibe token at `at` (`at` is not whitespace): a string or
/// char literal, a `::`-qualified identifier, `==`, `=>`, or one byte.
fn token_end(s: String, at: Int) -> Int {
  let n = String::length(s)
  let c = String::byte_at(s, at = at)
  if c == '"' || c == '\'' {
    let mut k = at + 1
    while k < n && String::byte_at(s, at = k) != c {
      if String::byte_at(s, at = k) == '\\' {
        k = k + 2
      } else {
        k = k + 1
      }
    }
    if k < n {
      k + 1
    } else {
      n
    }
  } else if is_ident_start(c = c) {
    let mut k = word_end(s = s, at = at)
    while has_at(s = s, at = k, lit = "::") && k + 2 < n && is_ident_start(c = String::byte_at(s, at = k + 2)) {
      k = word_end(s = s, at = k + 2)
    }
    k
  } else if has_at(s = s, at = at, lit = "==") || has_at(s = s, at = at, lit = "=>") {
    at + 2
  } else {
    at + 1
  }
}

/// `text` with the known argument labels of `call_labels` removed, so each
/// call reads in its positional spelling. Only a label that names the slot
/// it sits in is removed: a wrong label, or any label of another callee,
/// stays in place and still fails the match that reads it. Comments are not
/// tokens, so a label written inside one is never removed.
fn without_argument_labels(text: String) -> String {
  let n = String::length(text)
  let starts: Array[Int] = []
  let words: Array[String] = []
  let mut k = skip_spaces(s = text, at = 0)
  while k < n {
    if has_at(s = text, at = k, lit = "//") {
      while k < n && String::byte_at(text, at = k) != '\n' {
        k = k + 1
      }
    } else {
      let e = token_end(s = text, at = k)
      Array::push(starts, value = k)
      Array::push(words, value = String::substring(text, start = k, end = e))
      k = e
    }
    k = skip_spaces(s = text, at = k)
  }
  // One frame per open delimiter: its opener, the callee of a `(`, the
  // argument index, and whether the next token heads an argument.
  let opener: Array[String] = []
  let callee: Array[String] = []
  let arg: Array[Int] = []
  let head: Array[Bool] = []
  let mut depth = 0
  let cuts: Array[(Int, Int)] = []
  let count = Array::length(words)
  let mut i = 0
  while i < count {
    let w = Array::get(words, at = i)
    if w == ")" || w == "]" || w == "}" {
      let opener_of = if w == ")" {
        "("
      } else if w == "]" {
        "["
      } else {
        "{"
      }
      if depth > 0 && Array::get(opener, at = depth - 1) == opener_of {
        depth = depth - 1
      } else {
        ()
      }
    } else if depth > 0 && w == "," && Array::get(opener, at = depth - 1) == "(" {
      Array::set(arg, at = depth - 1, value = Array::get(arg, at = depth - 1) + 1)
      Array::set(head, at = depth - 1, value = true)
    } else {
      if depth > 0 && Array::get(head, at = depth - 1) {
        let labels = call_labels(callee = Array::get(callee, at = depth - 1))
        let a = Array::get(arg, at = depth - 1)
        if a < Array::length(labels) && Array::get(labels, at = a) == w && w != "" && i + 2 < count && Array::get(words, at = i + 1) == "=" {
          Array::push(cuts, value = (Array::get(starts, at = i), Array::get(starts, at = i + 2)))
        } else {
          ()
        }
        Array::set(head, at = depth - 1, value = false)
      } else {
        ()
      }
      if w == "(" || w == "[" || w == "{" {
        let name = if w == "(" && i > 0 {
          Array::get(words, at = i - 1)
        } else {
          ""
        }
        if depth < Array::length(opener) {
          Array::set(opener, at = depth, value = w)
          Array::set(callee, at = depth, value = name)
          Array::set(arg, at = depth, value = 0)
          Array::set(head, at = depth, value = true)
        } else {
          Array::push(opener, value = w)
          Array::push(callee, value = name)
          Array::push(arg, value = 0)
          Array::push(head, value = true)
        }
        depth = depth + 1
      } else {
        ()
      }
    }
    i = i + 1
  }
  let out = StringBuilder::new()
  let mut from = 0
  let mut c = 0
  while c < Array::length(cuts) {
    let (cut_start, cut_end) = Array::get(cuts, at = c)
    StringBuilder::push(out, value = String::substring(text, start = from, end = cut_start))
    from = cut_end
    c = c + 1
  }
  StringBuilder::push(out, value = String::substring(text, start = from, end = n))
  StringBuilder::freeze(out)
}

fn read_group(path: String) -> String with Fs::is_file + Fs::read_file + Stderr::write_stream + Process::exit {
  let (text, missing) = read_source_group(path = path)
  if missing != "" {
    die(message = "\{missing} is part of the source group of \{path} and does not exist")
  } else {
    ()
  }
  text
}

fn check_signatures(path: String) -> Unit with Fs::is_file + Fs::read_file + Console::write_stream + Stderr::write_stream + Process::exit {
  if !Fs::is_file(path) {
    die(message = "no such file: \{path}")
  } else {
    ()
  }
  let lines = String::split(Fs::read_file(path), sep = "\n")
  let mut i = 0
  while i < Array::length(lines) {
    // A trailing newline ends the file; it is not an empty entry.
    if i + 1 < Array::length(lines) || Array::get(lines, at = i) != "" {
      let (params, ret) = signature_shape(raw = Array::get(lines, at = i))
      if params < 0 {
        Console::write_stream("REJECT\n")
      } else {
        Console::write_stream("\{params} \{ret}\n")
      }
    } else {
      ()
    }
    i = i + 1
  }
}

fn main allows Env::args_get + Env::args_len + Fs::is_file + Fs::read_file + Console::write_stream + Stderr::write_stream + Process::exit {
  let sig_file = option(name = "--check-signatures", fallback = "")
  if sig_file != "" {
    check_signatures(path = sig_file)
    exit(0)
  } else {
    ()
  }
  let root = option(name = "--root", fallback = ".")
  let manifest_path = under(root = root, rel = "docs/generated/host-runtime-contract.json")
  let emitter_path = under(root = root, rel = "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe")
  let rust_path = under(root = root, rel = "runtime/viberun/src/main.rs")
  let node_path = under(root = root, rel = "scripts/wasm_vibe_host_runner.js")
  let gc_path = under(root = root, rel = "lib/@vibe/compiler/codegen/gc/backend_body.vibe")
  let ladder_path = under(root = root, rel = "lib/@vibe/compiler/core/builtin_name.vibe")
  if !Fs::is_file(manifest_path) {
    die(message = "invalid manifest: cannot read \{manifest_path}")
  } else {
    ()
  }
  let (parsed, manifest) = parse_manifest(text = Fs::read_file(manifest_path))
  if !parsed {
    die(message = "invalid manifest: \{manifest_path} is not a JSON object")
  } else {
    ()
  }
  let band_keys = [
    "portableCore",
    "nodeCoreOnly",
    "viberunDebugOnly",
    "viberunCoreOnly",
    "componentAdapterOnly"
  ]
  let present = Json::keys(manifest)
  let absent = minus(xs = band_keys, ys = present)
  if Array::length(absent) > 0 {
    die(message = "manifest missing keys: \{py_list(xs = absent)}")
  } else {
    ()
  }
  let mut all_names: Array[String] = []
  let bands: Array[Array[String]] = []
  let mut k = 0
  while k < Array::length(band_keys) {
    let key = Array::get(band_keys, at = k)
    let names = set_of(xs = json_strings(j = Json::field(manifest, key = key)))
    let overlap = intersect(xs = all_names, ys = names)
    if Array::length(overlap) > 0 {
      die(message = "imports occur in multiple bands (\{key}): \{py_list(xs = overlap)}")
    } else {
      ()
    }
    all_names = set_of(xs = concat_all(xs = all_names, ys = names))
    Array::push(bands, value = names)
    k = k + 1
  }
  let portable = Array::get(bands, at = 0)
  let node_only = Array::get(bands, at = 1)
  let debug_only = Array::get(bands, at = 2)
  let native_only = Array::get(bands, at = 3)
  let adapter_only = Array::get(bands, at = 4)
  let emitter_text = without_argument_labels(text = read_group(path = emitter_path))
  let (emitted, dynamic) = validate_emitter_contract(manifest = manifest, text = emitter_text)
  let emitted_names = keys_of(pairs = emitted)
  let missing = minus(xs = all_names, ys = emitted_names)
  let extra = minus(xs = emitted_names, ys = all_names)
  if Array::length(missing) > 0 || Array::length(extra) > 0 {
    die(message = "emitter bands drift: missing=\{py_list(xs = missing)} extra=\{py_list(xs = extra)}")
  } else {
    ()
  }
  let sigs = json_pairs(j = Json::field(manifest, key = "coreTypeSignatures"))
  let import_types = json_pairs(j = Json::field(manifest, key = "importTypes"))
  let unknown_types: Array[String] = []
  let mut e = 0
  while e < Array::length(emitted) {
    let t = Array::get(emitted, at = e).right
    if !has_key(pairs = sigs, key = t) {
      Array::push(unknown_types, value = t)
    } else {
      ()
    }
    e = e + 1
  }
  let mut d = 0
  while d < Array::length(dynamic) {
    let t = Array::get(dynamic, at = d).type_id
    if !has_key(pairs = sigs, key = t) {
      Array::push(unknown_types, value = t)
    } else {
      ()
    }
    d = d + 1
  }
  if Array::length(unknown_types) > 0 {
    die(message = "emitter uses undocumented type indices: \{py_list(xs = set_of(xs = unknown_types))}")
  } else {
    ()
  }
  let rust_text = read_group(path = rust_path)
  let rust = rust_imports(text = rust_text)
  let rust_sig_count = validate_rust_signatures(text = rust_text, types = import_types, sigs = sigs)
  let node = node_imports(text = read_group(path = node_path))
  let lacks_rust = minus(xs = portable, ys = rust)
  if Array::length(lacks_rust) > 0 {
    die(message = "viberun lacks portable imports: \{py_list(xs = lacks_rust)}")
  } else {
    ()
  }
  let lacks_node = minus(xs = portable, ys = node)
  if Array::length(lacks_node) > 0 {
    die(message = "node runner lacks portable imports: \{py_list(xs = lacks_node)}")
  } else {
    ()
  }
  let lacks_node_only = minus(xs = node_only, ys = node)
  if Array::length(lacks_node_only) > 0 {
    die(message = "node runner lacks node-only imports: \{py_list(xs = lacks_node_only)}")
  } else {
    ()
  }
  let lacks_debug = minus(xs = debug_only, ys = rust)
  if Array::length(lacks_debug) > 0 {
    die(message = "viberun lacks debug imports: \{py_list(xs = lacks_debug)}")
  } else {
    ()
  }
  let lacks_native = minus(xs = native_only, ys = rust)
  if Array::length(lacks_native) > 0 {
    die(message = "viberun lacks native core imports: \{py_list(xs = lacks_native)}")
  } else {
    ()
  }
  let leaked = intersect(xs = native_only, ys = node)
  if Array::length(leaked) > 0 {
    die(message = "native-core-only imports leaked into the node provider: \{py_list(xs = leaked)}")
  } else {
    ()
  }
  if Array::length(intersect(xs = adapter_only, ys = concat_all(xs = rust, ys = node))) > 0 {
    die(message = "component-adapter-only imports leaked into a standalone provider")
  } else {
    ()
  }
  let gc_count = validate_gc_lists(manifest_names = all_names, text = without_argument_labels(text = read_group(path = gc_path)), import_types = import_types, core_sigs = sigs)
  let bound = validate_linear_bindings(text = emitter_text)
  if !Fs::is_file(ladder_path) {
    die(message = "canonical_builtin_name_ladder not found")
  } else {
    ()
  }
  let ladder_count = validate_operation_ladder(text = Fs::read_file(ladder_path), bound = bound)
  // The binding count is of distinct builtins, as `dict(bindings)` counted.
  Console::write_stream("host-runtime-contract: ok (\{Array::length(emitted)} static imports; \{Array::length(dynamic)} dynamic patterns; \{Array::length(portable)} portable; \{gc_count} gc host imports; \{rust_sig_count} viberun signatures match the emitter; \{Array::length(keys_of(pairs = bound))} linear builtin bindings; \{ladder_count} operations reach their import)\n")
}
