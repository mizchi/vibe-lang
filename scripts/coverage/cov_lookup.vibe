import ../../lib/@vibe/compiler/checker/builtins_array.vibe {
  lookup_array
}

import ../../lib/@vibe/compiler/checker/builtins_system.vibe {
  lookup_io_b
}

// #cov lookup driver: lookup_array / lookup_io_b are name->Type builtin
// dispatch chains; the corpus only uses a few of the builtins, leaving
// most Some-arms dark. Call each directly with every dispatched name.
let cov_lk_arr: (String) -> Int = (n) -> { match lookup_array(n) { Some(_) => 1, None => 0 } }
let cov_lk_io: (String) -> Int = (n) -> { match lookup_io_b(n) { Some(_) => 1, None => 0 } }

export let cov_lookup_main: () -> Int = () -> {
  let mut acc = 0
  let arr = Array::slice([""], 0, 0)
  Array::push(arr, "Array::push"); Array::push(arr, "Array::slice"); Array::push(arr, "Array::push_all")
  Array::push(arr, "Array::truncate"); Array::push(arr, "Array::concat"); Array::push(arr, "Array::map")
  Array::push(arr, "Array::fold"); Array::push(arr, "Array::filter"); Array::push(arr, "Array::foreach")
  Array::push(arr, "Array::reverse"); Array::push(arr, "Array::any"); Array::push(arr, "Array::find")
  Array::push(arr, "Array::sort"); Array::push(arr, "Array::contains"); Array::push(arr, "Array::join")
  Array::push(arr, "Array::all"); Array::push(arr, "Array::nope")
  let mut i = 0
  while i < Array::length(arr) { acc = acc + cov_lk_arr(Array::get(arr, i)); i = i + 1 }
  let io = Array::slice([""], 0, 0)
  Array::push(io, "Stdout::write_char"); Array::push(io, "Stdout::write_stream")
  Array::push(io, "Env::get"); Array::push(io, "Env::args_len"); Array::push(io, "Env::args_get")
  Array::push(io, "Profiler::now_us"); Array::push(io, "sleep"); Array::push(io, "Path::resolve")
  Array::push(io, "Lines::parse"); Array::push(io, "Lines::stringify")
  Array::push(io, "IO::nope")
  let mut j = 0
  while j < Array::length(io) { acc = acc + cov_lk_io(Array::get(io, j)); j = j + 1 }
  acc
}
