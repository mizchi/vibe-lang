
// #cov parser-internals #3: parse_type_impl across modes x type forms, parse_pattern
// exotic forms, parse_export_stmt export forms, parse_one_param labeled/optional/
// typed params. All called directly with lexed tokens.
let p5_ty: (String, Int) -> Int = (s, m) -> {
  handle { let r = parse_type_impl(lex(s), 0, m); match r.0 { _ => 1 } } with Exception { Throw(_) => 0 }
}
let p5_pat: (String) -> Int = (s) -> {
  handle { let r = parse_pattern(lex(s), 0); match r.0 { _ => 1 } } with Exception { Throw(_) => 0 }
}
let p5_exp: (String) -> Int = (s) -> {
  handle { let r = parse_export_stmt(lex(s), 1); match r.0 { _ => 1 } } with Exception { Throw(_) => 0 }
}
let p5_param: (String) -> Int = (s) -> {
  handle { let r = parse_one_param(lex(s), 0); match r.0 { _ => 1 } } with Exception { Throw(_) => 0 }
}

let p5_types: () -> Int = () -> {
  let mut acc = 0
  let forms = Array::slice([""], 0, 0)
  Array::push(forms, "Int"); Array::push(forms, "Array[Int]"); Array::push(forms, "(Int, Bool)")
  Array::push(forms, "(Int) -> Bool"); Array::push(forms, "Option[Int]"); Array::push(forms, "Map[String, Int]")
  Array::push(forms, "(Int, Bool) -> Unit"); Array::push(forms, "Result[Int, String]"); Array::push(forms, "()")
  let mut m = 0
  while m < 4 {
    let mut i = 0
    while i < Array::length(forms) { acc = acc + p5_ty(Array::get(forms, i), m); i = i + 1 }
    m = m + 1
  }
  acc
}
let p5_patterns: () -> Int = () -> {
  let mut acc = 0
  acc = acc + p5_pat("_") + p5_pat("x") + p5_pat("1") + p5_pat("\"s\"") + p5_pat("true") + p5_pat("false")
  acc = acc + p5_pat("(a, b)") + p5_pat("(a, b, c)") + p5_pat("()")
  acc = acc + p5_pat("Some(x)") + p5_pat("None") + p5_pat("Cons(h, t)") + p5_pat("Node(Leaf(x), r)")
  acc = acc + p5_pat("1 | 2 | 3") + p5_pat("A | B | C")
  acc = acc + p5_pat("S { x, y }") + p5_pat("S { x: a, y: _ }") + p5_pat("S { }")
  acc = acc + p5_pat("0 - 5")
  acc
}
let p5_exports: () -> Int = () -> {
  let mut acc = 0
  acc = acc + p5_exp("export { a }") + p5_exp("export { a, b }") + p5_exp("export { a as b }")
  acc = acc + p5_exp("export { a, b as c, d }") + p5_exp("export { }")
  acc = acc + p5_exp("export let x: () -> Int = () -> { 1 }")
  acc
}
let p5_params: () -> Int = () -> {
  let mut acc = 0
  acc = acc + p5_param("x") + p5_param("x: Int") + p5_param("x: Array[Int]")
  acc = acc + p5_param("x~: Int") + p5_param("x?: Int") + p5_param("_: Int")
  acc = acc + p5_param("x: (Int) -> Bool")
  acc
}

export let cov_parser5_main: () -> Int = () -> {
  p5_types() + p5_patterns() + p5_exports() + p5_params()
}
