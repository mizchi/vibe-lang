//# Borrow-spine census (#2733). Run through scripts/borrow_spine_census.sh.
//#
//# `classify_let_value_heap` (codegen/expr/compile_expr_tail.vibe) decides
//# whether a `let` binding holds a heap value the scope must release. It reads
//# the callee of a CALL value, but only when the value node IS the call: wrap
//# the same call in a block and the arm that catches it sets `rc_kind = 2`
//# unconditionally. `value_has_borrowed_branch_tail` does recurse through
//# blocks, but is consulted only for an if/match value node, and
//# `pctx_mark_view_call` matches only an `ECall`. So a block whose result is a
//# borrowed view is classified as owned and its scope-end drop frees an
//# element the array still owns.
//#
//# This counts the population that misclassification can reach, so the fix is
//# scoped from a measurement rather than a guess. One row per `let` whose
//# value is a WRAPPER -- a block (`let` / `;` / assignment chain) or an
//# if/match -- classified by what its result spine actually hands back.
//#
//# Row: FN NAME top=<value node kind> leaves=<n> kinds=<sorted, deduplicated>
//#      verdict=<worst leaf kind>
//#
//# Leaf kinds, worst first: borrow_call (a borrow-returning builtin or a
//# #707 fn -- the corruption class), view_call (#768 may-return-view),
//# local_call (a callee bound here: a parameter or a local closure, so there
//# is no contract to read at all), indirect (a non-ident callee, likewise),
//# proj (an `EDot` -- the direct form dups, the wrapped form does not),
//# unresolved_call, scalar_call, heap_call, alloc, ident, other.

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, expr_children, is_borrow_ret_builtin
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  compute_borrow_param_user_fns, compute_may_return_view_fns
}

import @vibe/compiler/perceus {
  compute_borrow_returning_names, compute_heap_returning, compute_scalar_returning_names
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, at = i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn pat_bound_names(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, value = n),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        pat_bound_names(p = Array::get(ps, at = i), out = out)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        pat_bound_names(p = Array::get(ps, at = i), out = out)
        i = i + 1
      }
    },
    POr(a, b) => {
      pat_bound_names(p = a, out = out)
      pat_bound_names(p = b, out = out)
    },
    PStruct(_, fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fp) = Array::get(fs, at = i)
        pat_bound_names(p = fp, out = out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Severity order, so a row's verdict is its worst leaf.
fn leaf_rank(k: String) -> Int {
  if k == "borrow_call" {
    0
  } else if k == "view_call" {
    1
  } else if k == "local_call" {
    2
  } else if k == "indirect" {
    3
  } else if k == "proj" {
    4
  } else if k == "unresolved_call" {
    5
  } else if k == "scalar_call" {
    6
  } else if k == "heap_call" {
    7
  } else if k == "alloc" {
    8
  } else if k == "ident" {
    9
  } else {
    10
  }
}

fn leaf_kind(e: Expr, ctors: Array[String], scope: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    ETuple(_) => "alloc",
    EArray(_) => "alloc",
    ERecord(_, _, _) => "alloc",
    EDot(_, _, _, _) => "proj",
    EIdent(_, _) => "ident",
    ECall(callee, _, _, _) => match callee {
      EIdent(f, _) => if name_in(arr = ctors, s = f) {
        "alloc"
      } else if name_in(arr = scope, s = f) {
        "local_call"
      } else if is_borrow_ret_builtin(f) || name_in(arr = borrow_ret, s = f) {
        "borrow_call"
      } else if name_in(arr = view_ret, s = f) {
        "view_call"
      } else if name_in(arr = scalar_ret, s = f) {
        "scalar_call"
      } else if name_in(arr = heap_ret, s = f) {
        "heap_call"
      } else {
        "unresolved_call"
      },
      _ => "indirect"
    },
    _ => "other"
  }
}

/// The result spine of a `let` VALUE, classified where each leaf sits.
fn spine_walk(e: Expr, scope: Array[String], ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String], out: Array[String]) -> Unit {
  match e {
    EIf(_, t, el) => {
      spine_walk(e = t, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out)
      spine_walk(e = el, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out)
    },
    EMatch(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, at = i)
        let mark = Array::length(scope)
        pat_bound_names(p = ap, out = scope)
        spine_walk(e = ab, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out)
        Array::truncate(scope, length = mark)
        i = i + 1
      }
    },
    ELet(n, _, b, _) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out)
      Array::truncate(scope, length = mark)
    },
    ELetMut(n, _, b, _) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out)
      Array::truncate(scope, length = mark)
    },
    ELetRec(n, _, b) => {
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out)
      Array::truncate(scope, length = mark)
    },
    ESeq(_, b) => spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out),
    EAssign(_, _, b, _) => spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out),
    EAssignOp(_, _, _, b, _) => spine_walk(e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = out),
    _ => Array::push(out, value = leaf_kind(e = e, ctors = ctors, scope = scope, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret))
  }
}

/// The wrapper kinds this census is about: a value node that is NOT the thing
/// being classified. `block` is the class with no guard at all today;
/// `if`/`match` at least reach `value_has_borrowed_branch_tail`.
fn wrapper_kind(e: Expr) -> String {
  match e {
    ELet(_, _, _, _) => "block",
    ELetMut(_, _, _, _) => "block",
    ELetRec(_, _, _) => "block",
    ESeq(_, _) => "block",
    EAssign(_, _, _, _) => "block",
    EAssignOp(_, _, _, _, _) => "block",
    EIf(_, _, _) => "if",
    EMatch(_, _) => "match",
    _ => "-"
  }
}

fn uniq_sorted(xs: Array[String]) -> String {
  let seen: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, at = i)
    if name_in(arr = seen, s = x) {
      ()
    } else {
      Array::push(seen, value = x)
    }
    i = i + 1
  }
  let s = sorted_names_of(seen)
  let sb = StringBuilder::new()
  let mut j = 0
  while j < Array::length(s) {
    if j > 0 {
      StringBuilder::push(sb, value = ",")
    } else {
      ()
    }
    StringBuilder::push(sb, value = Array::get(s, at = j))
    j = j + 1
  }
  StringBuilder::freeze(sb)
}

/// One census row for a wrapper-valued binding, classified by its result
/// spine's worst leaf. Shared by the `ELet` and `ELetMut` arms: the codegen
/// rule this measures does not distinguish them.
fn emit_census_row(fname: String, n: String, v: Expr, scope: Array[String], ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> Unit with Console {
  let wk = wrapper_kind(e = v)
  if wk == "-" {
    ()
  } else {
    let kinds: Array[String] = []
    spine_walk(e = v, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret, out = kinds)
    let mut worst = "other"
    let mut worst_rank = 99
    let mut i = 0
    while i < Array::length(kinds) {
      let k = Array::get(kinds, at = i)
      if leaf_rank(k = k) < worst_rank {
        worst_rank = leaf_rank(k = k)
        worst = k
      } else {
        ()
      }
      i = i + 1
    }
    let line = StringBuilder::new()
    StringBuilder::push(line, value = fname)
    StringBuilder::push(line, value = "\t")
    StringBuilder::push(line, value = n)
    StringBuilder::push(line, value = "\ttop=")
    StringBuilder::push(line, value = wk)
    StringBuilder::push(line, value = "\tleaves=")
    StringBuilder::push(line, value = __to_string(Array::length(kinds)))
    StringBuilder::push(line, value = "\tkinds=")
    StringBuilder::push(line, value = uniq_sorted(xs = kinds))
    StringBuilder::push(line, value = "\tverdict=")
    StringBuilder::push(line, value = worst)
    println(StringBuilder::freeze(line))
  }
}

fn walk_lets(fname: String, e: Expr, scope: Array[String], ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> Unit with Console {
  match e {
    // A lambda body is classified in its own frame.
    EFn(_, _, _, _, _, _) => (),
    ELet(n, v, b, _) => {
      emit_census_row(fname = fname, n = n, v = v, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      walk_lets(fname = fname, e = v, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      walk_lets(fname = fname, e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      Array::truncate(scope, length = mark)
    },
    // `classify_let_value_heap` applies the wrapper rule to a `let mut` too
    // (tag 11), so a census that walked past one understated the population
    // it reports. Same row, same classification.
    ELetMut(n, v, b, _) => {
      emit_census_row(fname = fname, n = n, v = v, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      walk_lets(fname = fname, e = v, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      walk_lets(fname = fname, e = b, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      Array::truncate(scope, length = mark)
    },
    EMatch(sc, arms) => {
      walk_lets(fname = fname, e = sc, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, at = i)
        let mark = Array::length(scope)
        pat_bound_names(p = ap, out = scope)
        walk_lets(fname = fname, e = ab, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
        Array::truncate(scope, length = mark)
        i = i + 1
      }
    },
    EForIn(n, io, seq, body, _) => {
      walk_lets(fname = fname, e = seq, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      let mark = Array::length(scope)
      Array::push(scope, value = n)
      match io {
        Some(i2) => Array::push(scope, value = i2),
        None => ()
      }
      walk_lets(fname = fname, e = body, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
      Array::truncate(scope, length = mark)
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        walk_lets(fname = fname, e = Array::get(kids, at = i), scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
        i = i + 1
      }
    }
  }
}

fn collect_ctor_names(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SEnum(_, _, _, variants, _) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, at = v)
          Array::push(out, value = vn)
          v = v + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, at = v)
          Array::push(out, value = vn)
          v = v + 1
        }
      },
      SStruct(_, sname, _, _, _, _) => Array::push(out, value = sname),
      SModule(_, _, inner) => collect_ctor_names(stmts = inner, out = out),
      _ => ()
    }
    i = i + 1
  }
}

fn census(source: String) -> Unit with Exception + Console {
  let (toks, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(tokens = toks, starts = starts, source = source)
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts = stmts, entry_name = "main", linked_imports = linked, iw_names = iw_names, iw_wats = iw_wats, checker_eq_offsets = array_empty(), checker_eq_type_keys = array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, at = 0))
  } else {
    ()
  }
  let ctors: Array[String] = []
  collect_ctor_names(stmts = stmts, out = ctors)
  let borrow_ret = sorted_names_of(compute_borrow_returning_names(stmts))
  let masks: Array[Int] = []
  let exclude = ["main", "_start", "cli_main"]
  let _bp = compute_borrow_param_user_fns(stmts = stmts, exclude = exclude, out_masks = masks)
  let view_ret = sorted_names_of(compute_may_return_view_fns(stmts))
  let scalar_ret = sorted_names_of(compute_scalar_returning_names(stmts))
  let heap_ret = sorted_names_of(compute_heap_returning(stmts))
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, at = i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          let seen: Array[String] = []
          let norm = lift_match_scrutinees(expr = uniquify_shadowed_bindings_fresh(expr = value, counter = uq_shadow_counter, seen = seen), counter = m_scrut_counter)
          match norm {
            EFn(_, _, nparams, _, _, nbody) => {
              let scope: Array[String] = []
              let mut pi = 0
              while pi < Array::length(nparams) {
                let (pn, _) = Array::get(nparams, at = pi)
                Array::push(scope, value = pn)
                pi = pi + 1
              }
              walk_lets(fname = name, e = nbody, scope = scope, ctors = ctors, borrow_ret = borrow_ret, view_ret = view_ret, scalar_ret = scalar_ret, heap_ret = heap_ret)
            },
            _ => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

test "borrow spine census" {
  // scripts/borrow_spine_census.sh stages the input here.
  let src = Fs::read_file("_build/borrow_spine_census/input.vibe")
  census(source = src)
}
