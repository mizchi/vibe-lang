//# Borrow-spine census (#2733). Run through scripts/borrow_spine_census.sh.
//#
//# `classify_let_value_heap` (codegen/expr/compile_expr_tail.vibe) decides
//# whether a `let` binding holds a heap value the scope must release. It reads
//# the callee of a CALL value, but only when the value node IS the call: wrap
//# the same call in a block and the arm that catches it sets `rc_kind = 2`
//# unconditionally. `value_has_borrowed_branch_tail` does recurse through
//# blocks, but is consulted only for an if/match value node, and
//# `pctx_mark_view_call` matches only an `ECall`. So a block whose result is a
//# borrowed view is classified as owned and its scope-end drop frees an
//# element the array still owns.
//#
//# This counts the population that misclassification can reach, so the fix is
//# scoped from a measurement rather than a guess. One row per `let` whose
//# value is a WRAPPER -- a block (`let` / `;` / assignment chain) or an
//# if/match -- classified by what its result spine actually hands back.
//#
//# Row: FN NAME top=<value node kind> leaves=<n> kinds=<sorted, deduplicated>
//#      verdict=<worst leaf kind>
//#
//# Leaf kinds, worst first: borrow_call (a borrow-returning builtin or a
//# #707 fn -- the corruption class), view_call (#768 may-return-view),
//# local_call (a callee bound here: a parameter or a local closure, so there
//# is no contract to read at all), indirect (a non-ident callee, likewise),
//# proj (an `EDot` -- the direct form dups, the wrapped form does not),
//# unresolved_call, scalar_call, heap_call, alloc, ident, other.

import @vibe/core {
  array_empty, sorted_names_of
}

import @vibe/compiler/core {
  Expr, Pat, Stmt, TypeExpr, expr_children, is_borrow_ret_builtin
}

import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

import @vibe/compiler/normalize {
  lift_match_scrutinees, uniquify_shadowed_bindings_fresh
}

import @vibe/compiler/codegen/wasi {
  effect_lowering_prelude
}

import @vibe/compiler/codegen/common_analysis {
  compute_borrow_param_user_fns, compute_may_return_view_fns
}

import @vibe/compiler/perceus {
  compute_borrow_returning_names, compute_heap_returning, compute_scalar_returning_names
}

fn name_in(arr: Array[String], s: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

fn pat_bound_names(p: Pat, out: Array[String]) -> Unit {
  match p {
    PBind(n) => Array::push(out, n),
    PCtor(_, ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        pat_bound_names(Array::get(ps, i), out)
        i = i + 1
      }
    },
    PTuple(ps) => {
      let mut i = 0
      while i < Array::length(ps) {
        pat_bound_names(Array::get(ps, i), out)
        i = i + 1
      }
    },
    POr(a, b) => {
      pat_bound_names(a, out)
      pat_bound_names(b, out)
    },
    PStruct(_, fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fp) = Array::get(fs, i)
        pat_bound_names(fp, out)
        i = i + 1
      }
    },
    _ => ()
  }
}

/// Severity order, so a row's verdict is its worst leaf.
fn leaf_rank(k: String) -> Int {
  if k == "borrow_call" {
    0
  } else if k == "view_call" {
    1
  } else if k == "local_call" {
    2
  } else if k == "indirect" {
    3
  } else if k == "proj" {
    4
  } else if k == "unresolved_call" {
    5
  } else if k == "scalar_call" {
    6
  } else if k == "heap_call" {
    7
  } else if k == "alloc" {
    8
  } else if k == "ident" {
    9
  } else {
    10
  }
}

fn leaf_kind(e: Expr, ctors: Array[String], scope: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> String {
  match e {
    ETuple(_) => "alloc",
    EArray(_) => "alloc",
    ERecord(_, _, _) => "alloc",
    EDot(_, _, _, _) => "proj",
    EIdent(_, _) => "ident",
    ECall(callee, _, _) => match callee {
      EIdent(f, _) => if name_in(ctors, f) {
        "alloc"
      } else if name_in(scope, f) {
        "local_call"
      } else if is_borrow_ret_builtin(f) || name_in(borrow_ret, f) {
        "borrow_call"
      } else if name_in(view_ret, f) {
        "view_call"
      } else if name_in(scalar_ret, f) {
        "scalar_call"
      } else if name_in(heap_ret, f) {
        "heap_call"
      } else {
        "unresolved_call"
      },
      _ => "indirect"
    },
    _ => "other"
  }
}

/// The result spine of a `let` VALUE, classified where each leaf sits.
fn spine_walk(e: Expr, scope: Array[String], ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String], out: Array[String]) -> Unit {
  match e {
    EIf(_, t, el) => {
      spine_walk(t, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out)
      spine_walk(el, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out)
    },
    EMatch(_, arms) => {
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let mark = Array::length(scope)
        pat_bound_names(ap, scope)
        spine_walk(ab, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out)
        Array::truncate(scope, mark)
        i = i + 1
      }
    },
    ELet(n, _, b, _) => {
      let mark = Array::length(scope)
      Array::push(scope, n)
      spine_walk(b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out)
      Array::truncate(scope, mark)
    },
    ELetMut(n, _, b, _) => {
      let mark = Array::length(scope)
      Array::push(scope, n)
      spine_walk(b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out)
      Array::truncate(scope, mark)
    },
    ELetRec(n, _, b) => {
      let mark = Array::length(scope)
      Array::push(scope, n)
      spine_walk(b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out)
      Array::truncate(scope, mark)
    },
    ESeq(_, b) => spine_walk(b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out),
    EAssign(_, _, b) => spine_walk(b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out),
    EAssignOp(_, _, _, b) => spine_walk(b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, out),
    _ => Array::push(out, leaf_kind(e, ctors, scope, borrow_ret, view_ret, scalar_ret, heap_ret))
  }
}

/// The wrapper kinds this census is about: a value node that is NOT the thing
/// being classified. `block` is the class with no guard at all today;
/// `if`/`match` at least reach `value_has_borrowed_branch_tail`.
fn wrapper_kind(e: Expr) -> String {
  match e {
    ELet(_, _, _, _) => "block",
    ELetMut(_, _, _, _) => "block",
    ELetRec(_, _, _) => "block",
    ESeq(_, _) => "block",
    EAssign(_, _, _) => "block",
    EAssignOp(_, _, _, _) => "block",
    EIf(_, _, _) => "if",
    EMatch(_, _) => "match",
    _ => "-"
  }
}

fn uniq_sorted(xs: Array[String]) -> String {
  let seen: Array[String] = []
  let mut i = 0
  while i < Array::length(xs) {
    let x = Array::get(xs, i)
    if name_in(seen, x) {
      ()
    } else {
      Array::push(seen, x)
    }
    i = i + 1
  }
  let s = sorted_names_of(seen)
  let sb = StringBuilder::new()
  let mut j = 0
  while j < Array::length(s) {
    if j > 0 {
      StringBuilder::push(sb, ",")
    } else {
      ()
    }
    StringBuilder::push(sb, Array::get(s, j))
    j = j + 1
  }
  StringBuilder::freeze(sb)
}

fn walk_lets(fname: String, e: Expr, scope: Array[String], ctors: Array[String], borrow_ret: Array[String], view_ret: Array[String], scalar_ret: Array[String], heap_ret: Array[String]) -> Unit with Stdout {
  match e {
    // A lambda body is classified in its own frame.
    EFn(_, _, _, _, _, _) => (),
    ELet(n, v, b, _) => {
      let wk = wrapper_kind(v)
      if wk == "-" {
        ()
      } else {
        let kinds: Array[String] = []
        spine_walk(v, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret, kinds)
        let mut worst = "other"
        let mut worst_rank = 99
        let mut i = 0
        while i < Array::length(kinds) {
          let k = Array::get(kinds, i)
          if leaf_rank(k) < worst_rank {
            worst_rank = leaf_rank(k)
            worst = k
          } else {
            ()
          }
          i = i + 1
        }
        let line = StringBuilder::new()
        StringBuilder::push(line, fname)
        StringBuilder::push(line, "\t")
        StringBuilder::push(line, n)
        StringBuilder::push(line, "\ttop=")
        StringBuilder::push(line, wk)
        StringBuilder::push(line, "\tleaves=")
        StringBuilder::push(line, __to_string(Array::length(kinds)))
        StringBuilder::push(line, "\tkinds=")
        StringBuilder::push(line, uniq_sorted(kinds))
        StringBuilder::push(line, "\tverdict=")
        StringBuilder::push(line, worst)
        println(StringBuilder::freeze(line))
      }
      walk_lets(fname, v, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      let mark = Array::length(scope)
      Array::push(scope, n)
      walk_lets(fname, b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      Array::truncate(scope, mark)
    },
    ELetMut(n, v, b, _) => {
      walk_lets(fname, v, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      let mark = Array::length(scope)
      Array::push(scope, n)
      walk_lets(fname, b, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      Array::truncate(scope, mark)
    },
    EMatch(sc, arms) => {
      walk_lets(fname, sc, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      let mut i = 0
      while i < Array::length(arms) {
        let (ap, ab) = Array::get(arms, i)
        let mark = Array::length(scope)
        pat_bound_names(ap, scope)
        walk_lets(fname, ab, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
        Array::truncate(scope, mark)
        i = i + 1
      }
    },
    EForIn(n, io, seq, body) => {
      walk_lets(fname, seq, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      let mark = Array::length(scope)
      Array::push(scope, n)
      match io {
        Some(i2) => Array::push(scope, i2),
        None => ()
      }
      walk_lets(fname, body, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
      Array::truncate(scope, mark)
    },
    _ => {
      let kids = expr_children(e)
      let mut i = 0
      while i < Array::length(kids) {
        walk_lets(fname, Array::get(kids, i), scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
        i = i + 1
      }
    }
  }
}

fn collect_ctor_names(stmts: Array[Stmt], out: Array[String]) -> Unit {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, variants, _) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, v)
          Array::push(out, vn)
          v = v + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut v = 0
        while v < Array::length(variants) {
          let (vn, _) = Array::get(variants, v)
          Array::push(out, vn)
          v = v + 1
        }
      },
      SStruct(_, sname, _, _, _, _) => Array::push(out, sname),
      SModule(_, _, inner) => collect_ctor_names(inner, out),
      _ => ()
    }
    i = i + 1
  }
}

fn census(source: String) -> Unit with Exception + Stdout {
  let (toks, starts, _ends) = lex_with_offsets(source)
  let stmts = parse_program_located(toks, starts, source)
  let linked: Array[(String, String, Int, Int)] = []
  let iw_names: Array[String] = []
  let iw_wats: Array[String] = []
  let errs = effect_lowering_prelude(stmts, "main", linked, iw_names, iw_wats, array_empty(), array_empty())
  if Array::length(errs) > 0 {
    throw(Array::get(errs, 0))
  } else {
    ()
  }
  let ctors: Array[String] = []
  collect_ctor_names(stmts, ctors)
  let borrow_ret = sorted_names_of(compute_borrow_returning_names(stmts))
  let masks: Array[Int] = []
  let exclude = ["main", "_start", "cli_main"]
  let _bp = compute_borrow_param_user_fns(stmts, exclude, masks)
  let view_ret = sorted_names_of(compute_may_return_view_fns(stmts))
  let scalar_ret = sorted_names_of(compute_scalar_returning_names(stmts))
  let heap_ret = sorted_names_of(compute_heap_returning(stmts))
  let uq_shadow_counter = [0]
  let m_scrut_counter = [0]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, value) => match value {
        EFn(_, _, _, _, _, _) => {
          let seen: Array[String] = []
          let norm = lift_match_scrutinees(uniquify_shadowed_bindings_fresh(value, uq_shadow_counter, seen), m_scrut_counter)
          match norm {
            EFn(_, _, nparams, _, _, nbody) => {
              let scope: Array[String] = []
              let mut pi = 0
              while pi < Array::length(nparams) {
                let (pn, _) = Array::get(nparams, pi)
                Array::push(scope, pn)
                pi = pi + 1
              }
              walk_lets(name, nbody, scope, ctors, borrow_ret, view_ret, scalar_ret, heap_ret)
            },
            _ => ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

test "borrow spine census" {
  // scripts/borrow_spine_census.sh stages the input here.
  let src = Fs::read_file("_build/borrow_spine_census/input.vibe")
  census(src)
}
