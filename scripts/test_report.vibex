// scripts/test_report.vibex -- the condensed failure report for
// scripts/vibe_test.sh (#3674). The report itself is @vibe/testreport, the
// same implementation the launcher's `vibe test` reaches through the
// `vibe test-report` CLI command. This entry point exists because
// vibe_test.sh compiles with the committed seed, which may predate that
// command; the seed compiles this file and the library from source.
//
//   test_report.vibex script   <stdout> <stderr> <funcmap> <base> <source>
//   test_report.vibex launcher <stderr> <funcmap> <base> <pre_abort 0|1>
//
// A file argument that does not exist reads as empty, which is how a
// missing `.funcmap` or source degrades: bare frames, raw offsets.

import ../lib/@vibe/testreport {
  launcher_trap_report, script_failure_report
}

fn arg(i: Int) -> String with Env {
  if i < Env::args_len() {
    Env::args_get(i)
  } else {
    ""
  }
}

fn read_or_empty(path: String) -> String with Fs {
  if path != "" && Fs::is_file(path) {
    Fs::read_file(path)
  } else {
    ""
  }
}

fn main() -> Unit allows Env + Fs + Console {
  let mode = arg(0)
  if mode == "script" {
    print(script_failure_report(read_or_empty(arg(1)), read_or_empty(arg(2)), read_or_empty(arg(3)), arg(4), read_or_empty(arg(5))))
  } else if mode == "launcher" {
    print(launcher_trap_report(read_or_empty(arg(1)), read_or_empty(arg(2)), arg(3), arg(4) == "1"))
  } else {
    print("usage: test_report.vibex script <stdout> <stderr> <funcmap> <base> <source> | launcher <stderr> <funcmap> <base> <pre_abort>\n")
  }
}
