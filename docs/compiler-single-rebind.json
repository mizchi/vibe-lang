  "measurement_harness": "import hashlib, json, os, pathlib, re, statistics, subprocess, time\n\nroot = pathlib.Path.cwd()\nwork = root / '_build/rc2803/metrics'\nenv = {k: v for k, v in os.environ.items() if not k.startswith(('VIBE_', 'NODE_'))}\nenv.update(VIBE_PREOPEN_DIR=str(root), VIBE_IMPORT_ABI='raw', VIBE_WASM_MEMORY_STATS='1')\nreport = {\n    'issue': 2803,\n    'baseline_commit': '17874c5d82626dafb3a2d5b37d6eba99328f9977',\n    'protocol': 'Three sequential alternating AB/BA pairs per compiler runtime. Full CLI source as input, RC output, a fresh cache per pair and variant, cold then warm in separate processes. Compiler/cache/output paths have equal lengths across variants. Checked-module, AST and codegen-body caches disabled; production module caches enabled. Node 24.21.0 through the repository wrapper (exnref, stack-size=4000; wasm-inlining flag unsupported). heap_ptr is allocator high-water; RSS is the process reading at completion, not peak RSS.',\n    'compilers': {}, 'selfhost': [],\n    'leak_validation': json.loads((root / '_build/rc2803/validation.json').read_text()),\n}\nfor runtime in ['bump', 'rc']:\n    for side in 'ab':\n        p = work / f'{side}-{runtime}.wasm'\n        report['compilers'][f'{side}-{runtime}'] = {'sha256': hashlib.sha256(p.read_bytes()).hexdigest(), 'bytes': p.stat().st_size}\nhashes = {}\nfor runtime in ['bump', 'rc']:\n    for round in range(3):\n        for side in ('ab' if round % 2 == 0 else 'ba'):\n            folder = work / f'{runtime}-{round}-{side}'\n            folder.mkdir()  # Refuse to reuse a previously warmed measurement.\n            for temperature in ['cold', 'warm']:\n                out = folder / 'out.wasm'\n                extra = {'VIBE_FS_COMPILE': '1', 'VIBE_BACKEND': 'wasi', 'VIBE_RC': '1', 'VIBE_CHECKED_MODULE_CACHE': 'off', 'VIBE_EXPERIMENTAL_AST_CACHE': '0', 'VIBE_CODEGEN_BODY_CACHE': 'off', 'VIBE_WASM_NAMES': '0', 'VIBE_BUILD_CACHE_DIR': str(folder / 'cache')}\n                args = ['bash'