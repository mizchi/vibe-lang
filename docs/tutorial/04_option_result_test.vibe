// Tutorial 04 -- Option and the railway operators (`let*`, `?`).

fn half(n: Int) -> Option[Int] {
  if n % 2 == 0 { Some(n / 2) } else { None }
}

fn sum_halves(a: Int, b: Int) -> Option[Int] {
  let* x = half(a)
  let* y = half(b)
  Some(x + y)
}

fn first_half(a: Int, b: Int) -> Option[Int] {
  let x = half(a)?
  let _unused = half(b)?
  Some(x)
}

fn unwrap_or(o: Option[Int], fallback: Int) -> Int {
  match o {
    Some(v) => v,
    None => fallback
  }
}

test "Option basics" {
  assert_eq(unwrap_or(half(10), -1), 5)
  assert_eq(unwrap_or(half(3), -1), -1)
}

test "let* binds Some and short-circuits on None" {
  assert_eq(unwrap_or(sum_halves(4, 6), -1), 5)
  assert_eq(unwrap_or(sum_halves(4, 3), -1), -1)
}

test "? unwraps or early-returns None" {
  assert_eq(unwrap_or(first_half(4, 6), -1), 2)
  assert_eq(unwrap_or(first_half(4, 3), -1), -1)
}

test "is-expression as a quick Option test" {
  assert(half(10) is Some(_))
  assert(half(3) is None)
}
