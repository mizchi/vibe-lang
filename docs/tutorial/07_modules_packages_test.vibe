// Tutorial 07 — modules and packages: relative imports and @scope/name
// package imports (resolved via .vibe/store -> workspace lib/ -> VIBE_LIB,
// ADR-0065). Run from the repo root (or any workspace with @vibe/core
// materialized, e.g. after the curl installer).

import ./support/mathx.vibe { triple }

import @vibe/core { sha1, hex_encode }

test "relative file import" {
  assert_eq(triple(14), 42)
}

test "package import: @vibe/core" {
  assert_eq(String::length(sha1("vibe")), 40)
  assert(hex_encode("hi") == "6869")
}
