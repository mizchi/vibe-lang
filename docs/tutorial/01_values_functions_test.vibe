// Tutorial 01 — values, types, functions. Every example in the chapter doc
// lives here as a test block: `vibe test docs/tutorial/01_values_functions_test.vibe`

fn add(x: Int, y: Int) -> Int { x + y }

fn fact(n: Int) -> Int {
  if n < 2 { 1 } else { n * fact(n - 1) }
}

fn identity[T](x: T) -> T { x }

let inc: (Int) -> Int = (x) -> { x + 1 }

let scaled: (x~: Int, y~: Int) -> Int = (x~, y~) -> { x * 10 + y }

test "values and literal types" {
  let x: Int = 42
  let d: Double = 3.14
  let b: Bool = true
  let s = "answer \{x}"
  assert(s == "answer 42")
  assert_eq(x, 42)
  assert(b)
  assert(d > 3.0)
  let c = 'A'
  assert_eq(c, 65)
}

test "mut is block-scoped" {
  let y = {
    let mut v = 0
    v += 1
    v + 1
  }
  assert_eq(y, 2)
}

test "fn sugar, recursion, generics, let-form, labeled args" {
  assert_eq(add(40, 2), 42)
  assert_eq(fact(5), 120)
  assert_eq(identity(7), 7)
  assert_eq(inc(41), 42)
  assert_eq(scaled(x=4, y=2), 42)
}

test "lambda shorthand and placeholders" {
  let xs = [1, 2, 3]
  let doubled = Array::map(xs, _ * 2)
  assert_eq(Array::get(doubled, 2), 6)
  assert_eq(Array::fold(xs, 0, _ + _), 6)
}
