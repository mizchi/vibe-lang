// Tutorial 06 — tests: `test "name" { ... }` blocks, assert / assert_eq,
// run with `vibe test <file>`.

fn wordish_length(s: String) -> Int {
  String::length(String::trim(s))
}

test "assert_eq for numbers, assert for booleans" {
  assert_eq(1 + 1, 2)
  assert(2 < 3)
}

test "string assertions: use assert with ==" {
  let s = String::concat("vi", "be")
  assert(s == "vibe")
  assert(String::starts_with(s, "vi"))
}

test "a small unit under test" {
  assert_eq(wordish_length("  hello  "), 5)
  assert_eq(wordish_length(""), 0)
}
