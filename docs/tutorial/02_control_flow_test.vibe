// Tutorial 02 — control flow: if / while / loop / for-in / return / pipe.

fn find_first_neg(arr: Array[Int]) -> Int {
  let mut i = 0
  while i < Array::length(arr) {
    if Array::get(arr, i) < 0 { return i }
    i = i + 1
  }
  // NOTE: a bare `-1` here would parse as a binary minus against the while
  // block -- spell the trailing negative as `return -1`.
  return -1
}

test "if is an expression" {
  let v = if 1 < 2 { "yes" } else { "no" }
  assert(v == "yes")
}

test "while + early return" {
  assert_eq(find_first_neg([3, 1, -2, 5]), 2)
  assert_eq(find_first_neg([1, 2]), -1)
}

test "loop: parameterized tail recursion with break/continue" {
  let sum = loop (i = 0, acc = 0) {
    if i >= 10 { break acc }
    continue(i + 1, acc + i)
  }
  assert_eq(sum, 45)
}

test "for-in collects into an Array" {
  let doubled = for x in [1, 2, 3] { x * 2 }
  assert_eq(Array::get(doubled, 1), 4)
  let with_index = for i, x in [10, 20] { i + x }
  assert_eq(Array::get(with_index, 1), 21)
}

test "pipe operator" {
  let n = "  hi  " |> String::trim |> String::length
  assert_eq(n, 2)
  assert_eq([1, 2, 3] |> Array::length, 3)
  let xs = [1, 2, 3] |> Array::map(_, _ * 2)
  assert_eq(Array::get(xs, 0), 2)
}
