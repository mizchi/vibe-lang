// Tutorial 03 — data: tuples, arrays, records, maps, structs, enums,
// builders, and pattern matching.

struct Point { x: Int; y: Int } derive(Eq, Ord, Show)

enum Shape {
  Circle(Int);
  Rect(Int, Int)
}

fn area(s: Shape) -> Int {
  match s {
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h
  }
}

test "tuples, arrays, records" {
  let t = (1, "two", true)
  assert_eq(t.0, 1)
  assert(t.1 == "two")
  let a = [1, 2, 3]
  assert_eq(a[0], 1)
  assert_eq(Array::length(a), 3)
  // Anonymous records: destructuring works with any field names; dot
  // access currently resolves only against field names some struct
  // declares, so prefer destructuring for ad-hoc records.
  let record { name: n, ver: v } = record { name: "vibe", ver: 1 }
  assert(n == "vibe")
  assert_eq(v, 1)
}

test "structs and derives" {
  let p = Point::{ x: 1, y: 2 }
  assert_eq(p.x, 1)
  assert_eq(Point::compare(p, Point::{ x: 1, y: 3 }), -1)
  let shown = Point::to_string(p)
  assert(String::contains(shown, "x: 1"))
}

test "enums and match" {
  assert_eq(area(Circle(2)), 12)
  assert_eq(area(Rect(6, 7)), 42)
}

test "match: guards, or-patterns, literals" {
  let classify: (Int) -> String = (n) -> {
    match n {
      0 => "zero",
      1 | 2 => "small",
      x if x < 0 => "negative",
      _ => "big"
    }
  }
  assert(classify(0) == "zero")
  assert(classify(2) == "small")
  assert(classify(-5) == "negative")
  assert(classify(99) == "big")
}

test "destructuring let and is-expressions" {
  let (a, b) = (1, 2)
  assert_eq(a + b, 3)
  let opt = Some(41)
  if opt is Some(w) {
    assert_eq(w, 41)
  }
  assert(opt is Some(_))
}

test "ArrayBuilder for accumulation" {
  let arr = {
    let bld = ArrayBuilder::new()
    ArrayBuilder::push(bld, 1)
    ArrayBuilder::push(bld, 2)
    ArrayBuilder::freeze(bld)
  }
  assert_eq(Array::length(arr), 2)
  assert_eq(Array::get(arr, 1), 2)
}
