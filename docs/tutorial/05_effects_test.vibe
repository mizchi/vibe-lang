// Tutorial 05 — effects: pure by default, `with { ... }` rows, the Error
// boundary, and user-defined algebraic effects with `handle` / `resume`.

fn risky(x: Int) -> Int with { Error } {
  if x == 0 { throw("division by zero") }
  100 / x
}

effect Ask {
  Value(String) -> Int
}

fn answer_of(q: String) -> Int with { Ask } {
  perform Ask::Value(q) + 1
}

fn apply_twice(f~: (Int) -> Int with { e }, x~: Int) -> Int with { e } {
  f(f(x))
}

test "error boundary with handle" {
  let safe = handle { risky(0) } with Error { Throw(_msg) => -1 }
  assert_eq(safe, -1)
  let fine = handle { risky(4) } with Error { Throw(_msg) => -1 }
  assert_eq(fine, 25)
}

test "user effect: perform + handle + resume" {
  let v = handle { answer_of("life") } with Ask {
    Value(_q) => resume(41)
  }
  assert_eq(v, 42)
}

test "effect polymorphism: the row is a variable" {
  assert_eq(apply_twice(f=(n) -> n * 2, x=10), 40)
}
