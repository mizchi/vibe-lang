  "measurement_harness": "import hashlib, json, os, pathlib, re, statistics, subprocess, time\nroot=pathlib.Path.cwd(); work=root/'_build/rc2754/metrics'; work.mkdir(exist_ok=True)\nenv={k:v for k,v in os.environ.items() if not k.startswith(('VIBE_','NODE_'))}\nenv.update(VIBE_PREOPEN_DIR=str(root),VIBE_IMPORT_ABI='raw',VIBE_WASM_MEMORY_STATS='1')\nreport={'protocol':'Three alternating AB/BA pairs; sequential on the same host. Parser: RC output, 50 iterations after setup and 3 warmups. Selfhost: full CLI input, RC output, fresh cache per runtime/pair/variant, cold then warm in separate processes; checker/AST/body caches disabled, production module caches enabled. Repository Node wrapper with its probed default flags.','compilers':{},'parser':[],'selfhost':[]}\nfor runtime in ['bump','rc']:\n for side in 'ab':\n  p=work/f'{side}-{runtime}.wasm'; report['compilers'][f'{side}-{runtime}']={'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'bytes':p.stat().st_size}\ndef run(args,extra,log):\n t=time.monotonic();p=subprocess.run(['bash','scripts/run_wasm_vibe_host_runner.sh',*args],env={**env,**extra},capture_output=True,text=True,timeout=240)\n wall=time.monotonic()-t;log.write_text(p.stdout+p.stderr);p.check_returncode()\n stats=re.findall(r'\\[wasm-memory\\][^\\n]+',p.stderr)[-1]\n return wall,{k:int(v) for k,v in re.findall(r'(pages|bytes|heap_ptr|rss)=([0-9]+)',stats)},p.stdout\nfor round in range(3):\n for side in ('ab' if round%2==0 else 'ba'):\n  for name in re.findall(r'^bench \"([^\"]+)\"', (root/'lib/@vibe/compiler/parser_bench.vibe').read_text(),re.M):\n   wall,stats,out=run(['--invoke','__bench_'+name,'--bench-count','50','--bench-warmup','3','--bench-setup','_start',str(work/f'{side}-parser.wasm')],{},work/f'parser-{round}-{side}-{name}.log')\n   row={'round':round,'variant':side,'name':name,'wall_s':wall,'guest_us':float(out.strip().splitlines()[-1]),**stats};report['parser'].append(row)\n  print('parser',round,side,flush=True)\n(root/'_build/rc2754/metrics.json').write_text(json.dumps(report,indent=2)+'\\n')\nfor runtime in ['bump','rc']:\n for round in range(3):\n  for side in ('ab' if round%2==0 else 'ba'):\n   folder=work/f'{runtime}-{round}-{side}';folder.mkdir(exist_ok=True)\n   for temp in ['cold','warm']:\n    out=folder/'out.wasm'\n    wall,stats,_=run(['--invoke','cli_main',str(work/f'{side}-{runtime}.wasm'),'lib/@vibe/cli/entry.vibe',str(out),'cli_main'],{'VIBE_FS_COMPILE':'1','VIBE_BACKEND':'wasi','VIBE_RC':'1','VIBE_CHECKED_MODULE_CACHE':'off','VIBE_EXPERIMENTAL_AST_CACHE':'0','VIBE_CODEGEN_BODY_CACHE':'off','VIBE_WASM_NAMES':'0','VIBE_BUILD_CACHE_DIR':str(folder/'cache')},folder/f'{temp}.log')\n    row={'runtime':runtime,'round':round,'variant':side,'temperature':temp,'wall_s':wall,'output_bytes':out.stat().st_size,'output_sha256':hashlib.sha256(out.read_bytes()).hexdigest(),**stats};report['selfhost'].append(row)\n    (root/'_build/rc2754/metrics.json').write_text(json.dumps(report,indent=2)+'\\n'); print(json.dumps(row),flush=True)\nprint('DONE',flush=True)\n",
  "notes": [
