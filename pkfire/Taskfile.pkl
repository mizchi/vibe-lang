// === Per-package test tasks for differential execution ===
//
// See `pkf affected --since=origin/main 'test:*'` for diff-aware runs.
// Task name flattens `/` to `-` so a single `test:*` glob covers every
// per-package task (pkf glob does not traverse `/`). The qualified moon
// package name keeps `/` as-is.

local packages: List<String> =
  List(
    "backend",
    "benches",
    "capability",
    "checker",
    "cmd/fbgen",
    "cmd/parser_contract",
    "cmd/typecheck_fixture",
    "cmd/vibe",
    "cmd/vibe_check_wasi",
    "cmd/vibe_compile_wasi",
    "cmd/vibe_wasm",
    "cmd/vibe_wite_optimize_wasi",
    "cmd/warning_fixture",
    "codebase",
    "codegen",
    "core",
    "frontend",
    "fs",
    "io",
    "lib",
    "loader",
    "lsp",
    "parser",
    "pipeline",
    "profiler",
    "runtime",
    "runtime_compile",
    "tests",
    "x/fp",
    "x/module_graph",
    "x/scoped_map",
    "x/threads",
  )

local function pkgTask(pkg: String): Task = new Task {
  name = "test:\(pkg.replaceAll("/", "-"))"
  cmd = "moon test --target native -p mizchi/vibe/\(pkg)"
  inputs {
    "moon.mod.json"
    "src/\(pkg)/**/*.mbt"
    "src/\(pkg)/moon.pkg"
  }
}

local pkgTests: List<Task> = packages.map((p) -> pkgTask(p))

