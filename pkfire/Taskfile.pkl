/// pkfire Taskfile for vibe-lang
///
/// Mirrors the justfile entry points contributors use day-to-day with
/// typed dependencies and Bazel-style content-addressed caching. Simple
/// recipes are inlined; complex multi-line shell stays in the justfile
/// and is invoked via `just <name>`.
///
/// Usage:
///   pkf list                                  # show tasks
///   pkf run check                             # type check (cached)
///   pkf run test                              # check then full test
///   pkf affected --since=origin/main 'test:*' # diff-aware package tests
///   pkf graph --format tree                   # visualize dependencies
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

// --- justfile variables, mirrored as Pkl locals ---

local target: String = read?("env:VIBE_TARGET")?.text ?? "js"
local moonWarnList: String = read?("env:VIBE_MOON_WARN_LIST")?.text ?? "-1-6-7-9-20-24-29"

local moonSources: Listing<String> = new {
  "moon.mod.json"
  "moon.pkg.json"
  "src/**/*.mbt"
  "src/**/moon.pkg.json"
  "vibe/**/*.mbt"
  "vibe/**/moon.pkg.json"
  "vibe/**/*.vibe"
}

local scriptSources: Listing<String> = new { "scripts/**/*.sh"; "scripts/**/*.mjs" }

// --- helper factories ---

/// Wrap a multi-line / variable-heavy justfile recipe. The justfile stays
/// canonical; pkf only adds the cache / affected / graph layer.
local function justTask(taskName: String): Task = new Task {
  name = taskName
  cmd = "just \(taskName)"
  inputs { ...moonSources; ...scriptSources; "fixtures/**/*"; "justfile" }
}

/// Single-script wrapper — common pattern in the justfile.
local function scriptTask(taskName: String, script: String): Task = new Task {
  name = taskName
  cmd = "bash \(script)"
  inputs { ...moonSources; ...scriptSources }
}

// === Quick Commands (AGENTS.md "Quick Commands") ===

local fmt = new Task {
  name = "fmt"
  cmd = "moon fmt"
  inputs { ...moonSources }
  cache = false
}

local info = new Task {
  name = "info"
  cmd = "moon info"
  inputs { ...moonSources }
  outputs { "**/*.mbti" }
}

local check = new Task {
  name = "check"
  cmd = "moon check --deny-warn --warn-list '\(moonWarnList)' --target \(target)"
  inputs { ...moonSources }
}

