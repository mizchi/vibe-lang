struct Box[T] {
  value: T
} derive (Eq)

fn main with Console {
  let xs = []
  let ys = []
  Array::push(xs, Box::{ value: [1, 2] })
  Array::push(ys, Box::{ value: [1, 2] })
  println("generic struct literal = \{xs == ys}")
  let ns = []
  let ms = []
  Array::push(ns, -1)
  Array::push(ms, -1)
  println("negative literal       = \{ns == ms}")
}
