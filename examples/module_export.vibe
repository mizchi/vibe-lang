//# Functions

let pi: Int = 3

let add = (a: Int, b: Int) -> Int {
  a + b
}

let mul = (a: Int, b: Int) -> Int {
  a * b
}

let sub = (a: Int, b: Int) -> Int {
  a - b
}

let double = (x: Int) -> Int {
  mul(x, 2)
}

let square = (x: Int) -> Int {
  mul(x, x)
}

//# Misc

export {
  add, sub, mul, pi, double, square
}

test "add" {
  assert(add(1, 2) == 3)
}

test "sub" {
  assert(sub(5, 3) == 2)
}

test "mul" {
  assert(mul(3, 4) == 12)
}

test "double" {
  assert(double(5) == 10)
}

test "square" {
  assert(square(4) == 16)
}

export {
  pi, add, mul, sub, double, square
}
