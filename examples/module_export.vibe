//# Functions

let pi: Int = 3

fn add(a: Int, b: Int) -> Int {
  a + b
}

fn mul(a: Int, b: Int) -> Int {
  a * b
}

fn sub(a: Int, b: Int) -> Int {
  a - b
}

fn double(_ x: Int) -> Int {
  mul(a = x, b = 2)
}

fn square(_ x: Int) -> Int {
  mul(a = x, b = x)
}

//# Misc

export {
  add, sub, mul, pi, double, square
}

test "add" {
  assert(add(a = 1, b = 2) == 3)
}

test "sub" {
  assert(sub(a = 5, b = 3) == 2)
}

test "mul" {
  assert(mul(a = 3, b = 4) == 12)
}

test "double" {
  assert(double(5) == 10)
}

test "square" {
  assert(square(4) == 16)
}

export {
  pi, add, mul, sub, double, square
}
