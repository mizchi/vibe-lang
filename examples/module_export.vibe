//# Functions

let pi: Int = 3

let add: (Int, Int) -> Int = (a, b) -> {
  a + b
}

let mul: (Int, Int) -> Int = (a, b) -> {
  a * b
}

let sub: (Int, Int) -> Int = (a, b) -> {
  a - b
}

let double: (Int) -> Int = (x) -> {
  mul(x, 2)
}

let square: (Int) -> Int = (x) -> {
  mul(x, x)
}

//# Misc

export {
  add, sub, mul, pi, double, square
}

test "add" {
  assert(add(1, 2) == 3)
}

test "sub" {
  assert(sub(5, 3) == 2)
}

test "mul" {
  assert(mul(3, 4) == 12)
}

test "double" {
  assert(double(5) == 10)
}

test "square" {
  assert(square(4) == 16)
}

export {
  pi, add, mul, sub, double, square
}
