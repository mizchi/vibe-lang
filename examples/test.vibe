//# Misc

test "add" {
  assert(eq(add(1, 2), 3))
}

test "if" {
  assert(eq(if true {
    1
  } else 2, 1))
}

test "pipe" {
  assert(eq(1|>add(2), 3))
}

test "string_eq" {
  assert("hello" == "hello")
  assert(not("hello" == "world"))
}

test "literal match" {
  assert(eq(match 1 {
    1 => 1,
    _ => 0
  }, 1))
}
