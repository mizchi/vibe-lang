//# Functions

// fail: () -> Int with {Error}
let fail: () -> Int with { Error } = () -> {
  throw("assert")
  1
}

// apply: ((Int) -> Int with {$e4}, Int) -> Int with {$e4}
let apply: [e]((Int) -> Int with { e }, Int) -> Int with { e } = (f, x) -> {
  f(x)
}

// chain: ((Int) -> Int with {$e5}, (Int) -> Int with {$e5}, Int) -> Int with {$e5}
let chain: [e]((Int) -> Int with { e }, (Int) -> Int with { e }, Int) -> Int with { e } = (f, g, x) -> {
  add(f(x), g(x))
}

let pure_id: (Int) -> Int = (x) -> {
  x
}

let use_pure: (Int) -> Int = (x) -> {
  apply(pure_id, x)
}

// effectful: (Int) -> Int with {Error}
let effectful: (Int) -> Int with { Error } = (x) -> {
  x
}

let handled: (Int) -> Int = (x) -> {
  handle {
    effectful(x)
  } with Error {
    Throw(_) => 0
  }
}

// apply_ok: (Int) -> Int with {Error}
let apply_ok: (Int) -> Int with { Error } = (x) -> {
  apply(effectful, x)
}

// chain_ok: (Int) -> Int with {Error}
let chain_ok: (Int) -> Int with { Error } = (x) -> {
  chain(effectful, effectful, x)
}

let handled_error: Int = handle {
  fail()
} with Error {
  Throw(_) => 99
}

//# Misc

test "effects basic" {
  assert(handled(3) == 3)
}

test "effects catch" {
  assert(handled_error == 99)
}

test "effects higher-order" {
  assert(apply_ok(5) == 5)
}

test "effects chain" {
  assert(chain_ok(2) == 4)
}

test "effects pure" {
  assert(use_pure(4) == 4)
}
