//# Functions

// fail: () -> Int with Exception
fn fail() -> Int with Exception {
  throw("assert")
  1
}

// apply: ((Int) -> Int with $e4, Int) -> Int with $e4
fn apply[e](f: (Int) -> Int with e, x: Int) -> Int with e {
  f(x)
}

// chain: ((Int) -> Int with $e5, (Int) -> Int with $e5, Int) -> Int with $e5
fn chain[e](f: (Int) -> Int with e, g: (Int) -> Int with e, x: Int) -> Int with e {
  add(f(x), g(x))
}

fn pure_id(x: Int) -> Int {
  x
}

fn use_pure(x: Int) -> Int {
  apply(pure_id, x)
}

// effectful: (Int) -> Int with Exception
fn effectful(x: Int) -> Int with Exception {
  x
}

fn handled(x: Int) -> Int {
  handle {
    effectful(x)
  } with Exception {
    Throw(_) => 0
  }
}

// apply_ok: (Int) -> Int with Exception
fn apply_ok(x: Int) -> Int with Exception {
  apply(effectful, x)
}

// chain_ok: (Int) -> Int with Exception
fn chain_ok(x: Int) -> Int with Exception {
  chain(effectful, effectful, x)
}

let handled_error: Int = handle {
  fail()
} with Exception {
  Throw(_) => 99
}

//# Misc

test "effects basic" {
  assert(handled(3) == 3)
}

test "effects catch" {
  assert(handled_error == 99)
}

test "effects higher-order" {
  assert(apply_ok(5) == 5)
}

test "effects chain" {
  assert(chain_ok(2) == 4)
}

test "effects pure" {
  assert(use_pure(4) == 4)
}
