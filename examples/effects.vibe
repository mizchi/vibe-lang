
let fail = () -> Int with { Error } {
  throw("assert")
  1
}
let apply = (f: (x: Int) -> Int with { e }, x: Int) -> Int with { e } {
  f(x)
}
let chain = (f: (x: Int) -> Int with { e }, g: (x: Int) -> Int with { e }, x: Int,) -> Int with { e } {
  add(f(x), g(x))
}
let pure_id = (x: Int) -> Int {
  x
}
let use_pure = (x: Int) -> Int {
  apply(pure_id, x)
}
let effectful = (x: Int) -> Int with { Error } {
  x
}
let handled = (x: Int) -> Int {
  handle {
    effectful(x)
  } {
    Error(_) => 0
  }
}
let apply_ok = (x: Int) -> Int with { Error } {
  apply(effectful, x)
}
let chain_ok = (x: Int) -> Int with { Error } {
  chain(effectful, effectful, x)
}
let handled_error: Int = handle {
  fail()
} {
  Error(_) => 99
}
test "effects basic" {
  assert(eq(handled(3), 3))
}
test "effects catch" {
  assert(eq(handled_error, 99))
}
test "effects higher-order" {
  assert(eq(apply_ok(5), 5))
}
test "effects chain" {
  assert(eq(chain_ok(2), 4))
}
test "effects pure" {
  assert(eq(use_pure(4), 4))
}
