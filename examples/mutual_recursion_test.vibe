//# Functions

let rec is_even: (Int) -> Bool = (n) -> {
  if n == 0 { true } else { is_odd(n - 1) }
}
let rec is_odd: (Int) -> Bool = (n) -> {
  if n == 0 { false } else { is_even(n - 1) }
}

//# Misc

test "mutual recursion even" {
  assert(is_even(0))
  assert(is_even(4))
  assert(is_even(10))
}

test "mutual recursion odd" {
  assert(is_odd(1))
  assert(is_odd(3))
  assert(is_odd(9))
}

test "mutual recursion mixed" {
  assert(not(is_even(1)))
  assert(not(is_odd(0)))
  assert(not(is_even(7)))
  assert(not(is_odd(8)))
}
