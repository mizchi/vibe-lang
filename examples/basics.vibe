//# Types

type Pair = (Int, Int)

enum MaybeInt {
  Hit(Int);
  Miss
}

//# Functions

// inc: (Int) -> Int
let inc = (x: Int) -> Int {
  x + 1
}

// fact: (Int) -> Int
let rec fact = (n: Int) -> Int {
  if n < 2 {
    1
  } else {
    n * fact(n - 1)
  }
}

// classify: (Int) -> String
let classify = (x: Int) -> String {
  if x > 0 {
    "pos"
  } else {
    if x == 0 {
      "zero"
    } else {
      "neg"
    }
  }
}

// if_value: Int
let if_value: Int = if true {
  1
} else {
  2
}

// pair_sum: ((Int, Int)) -> Int
let pair_sum = (p: Pair) -> Int {
  p.0 + p.1
}

// map_value: Map[Int]
let map_value: Map[Int] = map {
  a: 1,
  "b": 2
}

// pair_value: (Int, Int)
let pair_value: (Int, Int) = (10, 20)

// pipe_value: Int
let pipe_value: Int = mul(add(1, 2), 3)

// array_value: Array[Int]
let array_value: Array[Int] = [
  1,
  2,
  3
]

// block_value: Int
let block_value: Int = {
  let base = 40
  base + 2
}

// maybe_to_int: () -> Int
let maybe_to_int = (x: MaybeInt) -> Int {
  match x {
    Hit(v) => v,
    Miss => 0,
  }
}

let record_value = record {
  x: 3,
  y: 4
}

//# Misc

test "number ops" {
  assert(eq(inc(41), 42))
  assert(eq(fact(5), 120))
  assert(eq(10 % 3, 1))
}

test "pipe and if" {
  assert(eq(pipe_value, 9))
  assert(eq(if_value, 1))
}

test "tuple and record" {
  let (a, b) = pair_value
  let record {
    x,
    y
  } = record_value
  assert(eq(a + b, 30))
  assert(eq(pair_sum(pair_value), 30))
  assert(eq(x + y, 7))
}

test "array and map" {
  assert(eq(array_length(array_value), 3))
  assert(eq(array_value[0], 1))
  assert(eq(array_get(array_value, 2), 3))
  assert(eq(map_get(map_value, "a"), 1))
}

test "match enum" {
  assert(eq(maybe_to_int(Hit(42)), 42))
  assert(eq(maybe_to_int(Miss), 0))
}

test "string basics" {
  let name = "vibe"
  let msg = "hello \(name)"
  assert(string_equals(msg, "hello vibe"))
  assert(eq(msg.string_length(), 10))
}

test "while and mut" {
  let mut i = 0
  let mut sum = 0
  while i <= 4 {
    sum += i
    i += 1
  }
  assert(eq(sum, 10))
}

test "lambda and placeholder" {
  let doubled = array_map([
    1,
    2,
    3
  ], x -> x * 2)
  let total = array_fold([
    1,
    2,
    3,
    4
  ], 0, _ + _)
  assert(eq(doubled[0], 2))
  assert(eq(doubled[2], 6))
  assert(eq(total, 10))
}

test "control flow helpers" {
  assert(string_equals(classify(3), "pos"))
  assert(string_equals(classify(0), "zero"))
  assert(string_equals(classify(-3), "neg"))
  assert(eq(block_value, 42))
}
