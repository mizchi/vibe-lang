import @vibe/builtin {
  trait Iterator
}

//# Types

type Pair = (Int, Int)

enum MaybeInt {
  Hit(Int);
  Miss
}

//# Functions

fn inc(x: Int) -> Int {
  x + 1
}

fn fact(n: Int) -> Int {
  if n < 2 {
    1
  } else n * fact(n - 1)
}

fn classify(x: Int) -> String {
  if x > 0 {
    "pos"
  } else if x == 0 {
    "zero"
  } else "neg"
}

let if_value: Int = if true {
  1
} else 2

fn pair_sum(p: Pair) -> Int {
  p.0 + p.1
}

let map_value: Map[String, Int] = Map::from_pairs([("a", 1), ("b", 2)])

let pair_value: (Int, Int) = (10, 20)

let pipe_value: Int = mul(add(1, 2), 3)

let array_value: Array[Int] = [1, 2, 3]

let block_value: Int = {
  let base = 40
  base + 2
}

fn maybe_to_int(x: MaybeInt) -> Int {
  match x {
    Hit(v) => v,
    Miss => 0,
  }
}

let record_value = record {
  x: 3,
  y: 4
}

//# Misc

test "number ops" {
  assert(inc(41) == 42)
  assert(fact(5) == 120)
  assert(10 % 3 == 1)
}

test "pipe and if" {
  assert(pipe_value == 9)
  assert(if_value == 1)
}

test "tuple and record" {
  let (a, b) = pair_value
  let record {
    x,
    y
  } = record_value
  assert(a + b == 30)
  assert(pair_sum(pair_value) == 30)
  assert(x + y == 7)
}

test "array and map" {
  assert(Array::length(array_value) == 3)
  assert(array_value[0] == 1)
  assert(Array::get(array_value, 2) == 3)
  assert(Map::get(map_value, "a") == 1)
}

test "match enum" {
  assert(maybe_to_int(Hit(42)) == 42)
  assert(maybe_to_int(Miss) == 0)
}

test "string basics" {
  let name = "vibe"
  let msg = "hello \{name}"
  assert(msg == "hello vibe")
  assert((msg |> String::length()) == 10)
}

test "while and mut" {
  let mut i = 0
  let mut sum = 0
  while i <= 4 {
    sum += i
    i += 1
  }
  assert(sum == 10)
}

test "lambda and placeholder" {
  let doubled = Iterator::map([1, 2, 3], x -> x * 2)
  let total = Iterator::fold([1, 2, 3, 4], 0, _ + _)
  assert(doubled[0] == 2)
  assert(doubled[2] == 6)
  assert(total == 10)
}

test "control flow helpers" {
  assert(classify(3) == "pos")
  assert(classify(0) == "zero")
  assert(classify(-3) == "neg")
  assert(block_value == 42)
}
