//# Types

enum Color { Red; Green; Blue }
struct Point { x: Int; y: Int }

//# __to_string edge cases

test "to_string_zero" {
  assert(__to_string(0) == "0")
}

test "to_string_positive" {
  assert(__to_string(42) == "42")
}

test "to_string_negative" {
  assert(__to_string(-7) == "-7")
}

test "to_string_large" {
  assert(__to_string(999999) == "999999")
}

test "to_string_string_passthrough" {
  assert(__to_string("hello") == "hello")
}

//# Map operations

test "map_empty_keys" {
  let m = {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
  assert(Array::length(Map::keys(m)) == 0)
}

test "map_set_get" {
  let m = map { "a": 1 }
  assert(Map::get(m, "a") == 1)
}

test "map_set_immutable" {
  let m1 = map { "a": 1 }
  let m2 = Map::set(m1, "b", 2)
  assert(Map::get(m1, "a") == 1)
  assert(Array::length(Map::keys(m1)) == 1)
  assert(Map::get(m2, "b") == 2)
  assert(Array::length(Map::keys(m2)) == 2)
}

test "map_set_overwrite" {
  let m1 = map { "a": 1 }
  let m2 = Map::set(m1, "a", 99)
  assert(Map::get(m2, "a") == 99)
  assert(Array::length(Map::keys(m2)) == 1)
}

test "map_builder_set" {
  let b = MapBuilder::new()
  MapBuilder::set(b, "x", 10)
  MapBuilder::set(b, "y", 20)
  let m = MapBuilder::freeze(b)
  assert(Map::get(m, "x") == 10)
  assert(Map::get(m, "y") == 20)
}

test "map_has_key" {
  let m = map { "a": 1 }
  assert(Map::has_key(m, "a"))
  assert(not(Map::has_key(m, "z")))
}

//# String equality in conditions

test "string_eq_if" {
  let s = "hello"
  if s == "hello" {
    assert(true)
  } else {
    assert(false)
  }
}

test "string_neq_if" {
  let s = "hello"
  if s != "world" {
    assert(true)
  } else {
    assert(false)
  }
}

test "string_eq_while" {
  let arr = ["a", "b", "c"]
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == "b" {
      found = true
    }
    i = i + 1
  }
  assert(found)
}

//# Pattern matching

test "or_pattern_int" {
  let r = match 2 {
    1|2|3 => true,
    _ => false
  }
  assert(r)
}

test "or_pattern_int_miss" {
  let r = match 5 {
    1|2|3 => true,
    _ => false
  }
  assert(not(r))
}

test "or_pattern_ctor" {
  let r = match Some(3) {
    Some(1)|Some(2)|Some(3) => true,
    _ => false
  }
  assert(r)
}

test "or_pattern_ctor_miss" {
  let r = match Some(9) {
    Some(1)|Some(2)|Some(3) => false,
    _ => true
  }
  assert(r)
}

test "match_string_pattern" {
  let r = match "hello" {
    "hello" => 1,
    "world" => 2,
    _ => 0
  }
  assert(r == 1)
}

test "match_string_pattern_miss" {
  let r = match "foo" {
    "hello" => 1,
    "world" => 2,
    _ => 0
  }
  assert(r == 0)
}

test "tuple_destructure" {
  let (a, b) = (10, 20)
  assert(a + b == 30)
}

test "nested_tuple_destructure" {
  let (a, (b, c)) = (1, (2, 3))
  assert(a + b + c == 6)
}

test "record_destructure" {
  let r = record { x: 10, y: 20 }
  let record { x: a, y: b } = r
  assert(a + b == 30)
}

//# Effects

test "throw_handle" {
  let fail_fn = () -> Int with { Error } {
    throw("error")
  }
  let r = handle {
    fail_fn()
  } {
    Error(_) => 42
  }
  assert(r == 42)
}

//# String interpolation

test "interp_var" {
  let x = 42
  let msg = "val: \(x)"
  assert(msg == "val: 42")
}

test "interp_expr" {
  let msg = "sum: \(add(1, 2))"
  assert(msg == "sum: 3")
}

//# Cross-module (import resolved at compile time)
// These rely on the cross-module import resolution working

//# Array operations

test "array_reverse" {
  let r = Array::reverse([1, 2, 3])
  assert(Array::get(r, 0) == 3)
  assert(Array::get(r, 2) == 1)
}

test "array_concat" {
  let r = Array::concat([1, 2], [3, 4])
  assert(Array::length(r) == 4)
  assert(Array::get(r, 0) == 1)
  assert(Array::get(r, 3) == 4)
}

test "array_find_basic" {
  let arr = [10, 20, 30]
  assert(Array::get(arr, 1) == 20)
  assert(Array::length(arr) == 3)
}

//# Struct

test "struct_create_access" {
  let p = Point::{ x: 10, y: 20 }
  assert(p.x == 10)
  assert(p.y == 20)
}

test "struct_field_fn" {
  let p = Point::{ x: 3, y: 4 }
  let dist_sq = p.x * p.x + p.y * p.y
  assert(dist_sq == 25)
}

//# Enum

test "enum_ctor_match" {
  let c = Green
  let r = match c {
    Red => 1,
    Green => 2,
    Blue => 3,
    _ => 0
  }
  assert(r == 2)
}

test "enum_some_none" {
  let x = Some(42)
  let y = None
  let r1 = match x { Some(v) => v, _ => 0 }
  let r2 = match y { Some(v) => v, _ => -1 }
  assert(r1 == 42)
  assert(r2 == -1)
}

let run = () -> Int { 0 }
