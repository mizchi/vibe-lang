//# Types

enum Expr {
  Num(Int);
  Add(Expr, Expr);
  Neg(Expr)
} derive(Eq)

enum Result[T] {
  Ok(T);
  Err(String)
} derive(Eq)

struct Pair { fst: Int; snd: Int } derive(Eq)

//# Functions

let rec eval_expr: (Expr) -> Int = (e) -> {
  match e {
    Expr::Num(n) => n,
    Expr::Add(a, b) => eval_expr(a) + eval_expr(b),
    Expr::Neg(a) => 0 - eval_expr(a)
  }
}

//# Misc

test "nested enum pattern" {
  let e = Expr::Add(Expr::Num(1), Expr::Neg(Expr::Num(2)))
  assert(eval_expr(e) == -1)
}

test "nested Option pattern" {
  let x: Option[Option[Int]] = Some(Some(42))
  let result = match x {
    Some(Some(v)) => v,
    Some(None) => -1,
    None => -2
  }
  assert(result == 42)
}

test "nested Option None case" {
  let x: Option[Option[Int]] = Some(None)
  let result = match x {
    Some(Some(v)) => v,
    Some(None) => -1,
    None => -2
  }
  assert(result == -1)
}

test "or-pattern with binding" {
  let classify: (Int) -> String = (n) -> {
    match n {
      1|2|3 => "small",
      4|5|6 => "medium",
      _ => "large"
    }
  }
  assert(classify(2) == "small")
  assert(classify(5) == "medium")
  assert(classify(100) == "large")
}

test "match with guard" {
  let abs_val: (Int) -> Int = (n) -> {
    match n {
      x if x < 0 => 0 - x,
      x => x
    }
  }
  assert(abs_val(5) == 5)
  assert(abs_val(-3) == 3)
  assert(abs_val(0) == 0)
}

test "tuple destructuring" {
  let (a, b, c) = (10, 20, 30)
  assert(a == 10)
  assert(b == 20)
  assert(c == 30)
}

test "struct pattern match" {
  let p = Pair::{ fst: 3, snd: 4 }
  let Pair::{ fst, snd } = p
  assert(fst == 3)
  assert(snd == 4)
}

test "is expression with binding" {
  let x: Option[Int] = Some(42)
  let result = if x is Some(v) { v } else { 0 }
  assert(result == 42)
}

test "is expression false case" {
  let x: Option[Int] = None
  let result = if x is Some(v) { v } else { -1 }
  assert(result == -1)
}

test "is expression Bool" {
  let x: Option[Int] = Some(1)
  let y: Option[Int] = None
  assert(x is Some(_))
  assert(y is None)
}

test "match Result enum" {
  let ok: Result[Int] = Result::Ok(42)
  let err: Result[Int] = Result::Err("oops")
  let val1 = match ok {
    Result::Ok(v) => v,
    Result::Err(_) => -1
  }
  let val2 = match err {
    Result::Ok(v) => v,
    Result::Err(_) => -1
  }
  assert(val1 == 42)
  assert(val2 == -1)
}

test "match string literal" {
  let greet: (String) -> String = (lang) -> {
    match lang {
      "en" => "hello",
      "ja" => "こんにちは",
      "de" => "hallo",
      _ => "hi"
    }
  }
  assert(greet("en") == "hello")
  assert(greet("ja") == "こんにちは")
  assert(greet("xx") == "hi")
}

test "deeply nested pattern" {
  let x = Some(Some(Some(1)))
  let result = match x {
    Some(Some(Some(v))) => v,
    _ => 0
  }
  assert(result == 1)
}
