//# Misc

test "set new and size" {
  let s = Set::new()
  assert(Set::size(s) == 0)
}

test "set add duplicate" {
  let s0 = Set::new()
  let s1 = Set::add(s0, 5)
  let s2 = Set::add(s1, 5)
  assert(Set::size(s2) == 1)
}

test "set immutability" {
  let s1 = Set::add(Set::new(), 1)
  let s2 = Set::add(s1, 2)
  assert(Set::size(s1) == 1)
  assert(Set::size(s2) == 2)
}

test "set contains" {
  let s = Set::add(Set::add(Set::new(), 10), 20)
  assert(Set::contains(s, 10))
  assert(Set::contains(s, 20))
  assert(not(Set::contains(s, 30)))
}

test "set remove" {
  let s = Set::add(Set::add(Set::new(), 1), 2)
  let s2 = Set::remove(s, 1)
  assert(not(Set::contains(s2, 1)))
  assert(Set::contains(s2, 2))
  assert(Set::size(s2) == 1)
}

test "set remove nonexistent" {
  let s = Set::add(Set::new(), 5)
  let s2 = Set::remove(s, 999)
  assert(Set::size(s2) == 1)
  assert(Set::contains(s2, 5))
}

test "set from_array" {
  let s = Set::from_array([1, 2, 3, 2, 1])
  assert(Set::size(s) == 3)
  assert(Set::contains(s, 1))
  assert(Set::contains(s, 2))
  assert(Set::contains(s, 3))
}

test "set to_array" {
  let s = Set::add(Set::add(Set::add(Set::new(), 10), 20), 30)
  let arr = Set::to_array(s)
  assert(Array::length(arr) == 3)
  assert(Array::any(arr, x -> x == 10))
  assert(Array::any(arr, x -> x == 20))
  assert(Array::any(arr, x -> x == 30))
}

test "set empty" {
  let s: Set[Int] = Set::new()
  assert(Set::size(s) == 0)
  assert(not(Set::contains(s, 0)))
  let arr = Set::to_array(s)
  assert(Array::length(arr) == 0)
}

test "set multiple adds" {
  let mut s = Set::new()
  let mut i = 0
  while i < 20 {
    s = Set::add(s, i)
    i += 1
  }
  assert(Set::size(s) == 20)
  assert(Set::contains(s, 0))
  assert(Set::contains(s, 19))
  assert(not(Set::contains(s, 20)))
}

test "set string keys" {
  let s = Set::from_array(["hello", "world", "hello"])
  assert(Set::size(s) == 2)
  assert(Set::contains(s, "hello"))
  assert(Set::contains(s, "world"))
  assert(not(Set::contains(s, "missing")))
}
