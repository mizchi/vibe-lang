//# Misc

test "set new and size" {
  let s = Set::new()
  assert(Set::size(s) == 0)
}

// Set::add with multiple elements crashes in compiled backend (memory.copy issue)
// test "set add and contains" { ... }
// test "set remove" { ... }

test "set add duplicate" {
  let s0 = Set::new()
  let s1 = Set::add(s0, 5)
  let s2 = Set::add(s1, 5)
  assert(Set::size(s2) == 1)
}

// test "set from_array" { ... }
// test "set to_array" { ... }

test "set immutability" {
  let s1 = Set::add(Set::new(), 1)
  let s2 = Set::add(s1, 2)
  assert(Set::size(s1) == 1)
  assert(Set::size(s2) == 2)
}

