//# Types

enum Json {
  JNull;
  JBool(Bool);
  JNum(Double);
  JStr(String);
  JArr(Array[Json]);
  JObj(Map[String, Json])
} derive(Eq)

//# Functions

let item = "{\"id\":1,\"name\":\"alice\",\"active\":true,\"score\":123.456e-2,\"tags\":[\"vibe\",\"bench\",\"json\"],\"meta\":{\"a\":1,\"b\":2,\"c\":[1,2,3]}}"

fn is_ws(c: Int) -> Bool {
  c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

fn skip_ws(s: String, len: Int, i: Int) -> Int {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_ws(c) {
      skip_ws(s, len, i + 1)
    } else i
  } else i
}

fn is_digit(c: Int) -> Bool {
  c >= '0' && c < ':'
}

fn join_items(it: String, n: Int) -> String {
  if n <= 1 {
    it
  } else String::concat(it, String::concat(",", join_items(it, n - 1)))
}

let json_large = String::concat("{\"items\":[", String::concat(join_items(item, 8), "],\"ok\":true,\"version\":1}"))

let json_small = "{\"ok\":true}"

let json_medium = "{\"users\":[{\"id\":1,\"name\":\"alice\",\"tags\":[\"x\",\"y\",\"z\"],\"active\":true},{\"id\":2,\"name\":\"bob\",\"tags\":[],\"active\":false}],\"config\":{\"retry\":3,\"ratio\":0.125,\"title\":\"hello\\nworld\"},\"nil\":null}"

fn parse_string(s: String, len: Int, i: Int) -> (String, Int) with Error {
  if i >= len {
    throw("unexpected eof")
  }
  else if String::char_code_at(s, i) != '"' {
    throw("expected string")
  }
  else {
    let rec scan: (Int, Int, String) -> (String, Int) with Error = (idx, start, acc) -> {
      if idx >= len {
        throw("unterminated string")
      }
      else {
        let c = String::char_code_at(s, idx)
        if c < ' ' {
          throw("invalid string")
        }
        else if c == '"' {
          let chunk = String::substring(s, start, idx)
          (String::concat(acc, chunk), idx + 1)
        }
        else if c == '\\' {
          let chunk = String::substring(s, start, idx)
          let next = idx + 1
          if next >= len {
            throw("unterminated string")
          }
          else {
            let esc = String::char_code_at(s, next)
            let escaped = if esc == '"' {
              "\""
            } else if esc == '\\' {
              "\\"
            } else if esc == '/' {
              "/"
            } else if esc == 'n' {
              "\n"
            } else if esc == 't' {
              "\t"
            } else throw("invalid escape")
            scan(next + 1, next + 1, String::concat(String::concat(acc, chunk), escaped))
          }
        }
        else scan(idx + 1, start, acc)
      }
    }
    scan(i + 1, i + 1, "")
  }
}

fn apply_exponent(value: Double, exp: Int) -> Double {
  if exp == 0 {
    value
  }
  else if exp < 0 {
    apply_exponent(value / 10.0, exp + 1)
  }
  else apply_exponent(value * 10.0, exp - 1)
}

fn digit_to_double(c: Int) -> Double {
  Int::to_double(c - '0')
}

fn parse_fraction(s: String, len: Int, i: Int, acc: Double, scale: Double, seen: Bool) -> (Double, Int) with Error {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_digit(c) {
      parse_fraction(s, len, i + 1, acc + digit_to_double(c) / scale, scale * 10.0, true)
    } else if seen {
      (acc, i)
    } else throw("expected fraction")
  } else if seen {
    (acc, i)
  } else throw("expected fraction")
}

fn parse_digits_int(s: String, len: Int, i: Int, acc: Int) -> (Int, Int) {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_digit(c) {
      parse_digits_int(s, len, i + 1, acc * 10 + (c - '0'))
    } else (acc, i)
  } else (acc, i)
}

fn starts_with_from(s: String, len: Int, i: Int, word: String, wi: Int, wlen: Int) -> Bool {
  if wi >= wlen {
    true
  }
  else {
    let si = i + wi
    if si >= len {
      false
    }
    else if String::char_code_at(s, si) == String::char_code_at(word, wi) {
      starts_with_from(s, len, i, word, wi + 1, wlen)
    }
    else false
  }
}

fn starts_with(s: String, len: Int, i: Int, word: String) -> Bool {
  let wlen = String::length(word)
  i + wlen <= len && starts_with_from(s, len, i, word, 0, wlen)
}

fn parse_digits_double(s: String, len: Int, i: Int, acc: Double, seen: Bool) -> (Double, Int) with Error {
  if i < len {
    let c = String::char_code_at(s, i)
    if is_digit(c) {
      parse_digits_double(s, len, i + 1, acc * 10.0 + digit_to_double(c), true)
    } else if seen {
      (acc, i)
    } else throw("expected digit")
  } else if seen {
    (acc, i)
  } else throw("expected digit")
}

fn parse_int_part(s: String, len: Int, i: Int) -> (Double, Int) with Error {
  if i < len {
    let c = String::char_code_at(s, i)
    if c == '0' {
      let next = i + 1
      if next < len && is_digit(String::char_code_at(s, next)) {
        throw("leading zero")
      } else (0.0, next)
    }
    else if is_digit(c) {
      parse_digits_double(s, len, i, 0.0, false)
    }
    else throw("expected digit")
  } else throw("expected digit")
}

fn parse_exponent_if_any(s: String, len: Int, i: Int, value: Double) -> (Double, Int) with Error {
  let parse_exp: (Int, Int) -> (Double, Int) with Error = (exp_sign, exp_idx) -> {
    if exp_idx < len && is_digit(String::char_code_at(s, exp_idx)) {
      let (exp, exp_next) = parse_digits_int(s, len, exp_idx, 0)
      let signed_exp = if exp_sign < 0 {
        0 - exp
      } else exp
      (apply_exponent(value, signed_exp), exp_next)
    } else throw("expected exponent")
  }
  if i < len {
    let c = String::char_code_at(s, i)
    if c == 'e' || c == 'E' {
      let exp_start = i + 1
      if exp_start < len {
        let sign_char = String::char_code_at(s, exp_start)
        if sign_char == '-' {
          parse_exp(-1, exp_start + 1)
        } else if sign_char == '+' {
          parse_exp(1, exp_start + 1)
        } else parse_exp(1, exp_start)
      } else throw("expected exponent")
    } else (value, i)
  } else (value, i)
}

fn parse_fraction_if_any(s: String, len: Int, i: Int, value: Double) -> (Double, Int) with Error {
  if i < len && String::char_code_at(s, i) == '.' {
    let (frac, next) = parse_fraction(s, len, i + 1, 0.0, 10.0, false)
    (value + frac, next)
  } else (value, i)
}

fn parse_number_body(s: String, len: Int, idx: Int, sign: Double) -> (Json, Int) with Error {
  let (int_part, next) = parse_int_part(s, len, idx)
  let (with_frac, next_frac) = parse_fraction_if_any(s, len, next, int_part)
  let (with_exp, next_exp) = parse_exponent_if_any(s, len, next_frac, with_frac)
  (JNum(with_exp * sign), next_exp)
}

fn parse_number(s: String, len: Int, i: Int) -> (Json, Int) with Error {
  if i >= len {
    throw("expected number")
  } else if String::char_code_at(s, i) == '-' {
    parse_number_body(s, len, i + 1, -1.0)
  } else parse_number_body(s, len, i, 1.0)
}

fn parse_value(s: String, len: Int, i: Int) -> (Json, Int) with Error {
  let parse_array: (Int) -> (Json, Int) with Error = (i) -> {
    {
      let idx = skip_ws(s, len, i + 1)
      if idx < len {
        if String::char_code_at(s, idx) == ']' {
          (JArr(ArrayBuilder::freeze(ArrayBuilder::new())), idx + 1)
        } else {
          let builder = ArrayBuilder::new()
          let rec parse_items: (Int) -> (Json, Int) with Error = (i) -> {
            let (value, next) = parse_value(s, len, i)
            ArrayBuilder::push(builder, value)
            let next_idx = skip_ws(s, len, next)
            if next_idx < len {
              let ch = String::char_code_at(s, next_idx)
              if ch == ',' {
                parse_items(next_idx + 1)
              } else if ch == ']' {
                (JArr(ArrayBuilder::freeze(builder)), next_idx + 1)
              } else throw("expected , or ]")
            } else throw("expected , or ]")
          }
          parse_items(idx)
        }
      } else throw("unexpected eof")
    }
  }
  let parse_object: (Int) -> (Json, Int) with Error = (i) -> {
    {
      let idx = skip_ws(s, len, i + 1)
      if idx < len {
        if String::char_code_at(s, idx) == '}' {
          (JObj(MapBuilder::freeze(MapBuilder::new())), idx + 1)
        } else {
          let builder = MapBuilder::new()
          let rec parse_members: (Int) -> (Json, Int) with Error = (i) -> {
            let (key, next) = parse_string(s, len, i)
            let colon_idx = skip_ws(s, len, next)
            if colon_idx >= len || String::char_code_at(s, colon_idx) != ':' {
              throw("expected :")
            } else {
              let (value, next_val) = parse_value(s, len, colon_idx + 1)
              MapBuilder::set(builder, key, value)
              let next_idx = skip_ws(s, len, next_val)
              if next_idx < len {
                let ch = String::char_code_at(s, next_idx)
                if ch == ',' {
                  parse_members(next_idx + 1)
                } else if ch == '}' {
                  (JObj(MapBuilder::freeze(builder)), next_idx + 1)
                } else throw("expected , or }")
              } else throw("expected , or }")
            }
          }
          parse_members(idx)
        }
      } else throw("unexpected eof")
    }
  }
  let idx = skip_ws(s, len, i)
  if idx >= len {
    throw("unexpected eof")
  }
  else {
    let c = String::char_code_at(s, idx)
    if c == 'n' {
      if starts_with(s, len, idx, "null") {
        (JNull, idx + 4)
      } else throw("expected null")
    }
    else if c == 't' {
      if starts_with(s, len, idx, "true") {
        (JBool(true), idx + 4)
      } else throw("expected true")
    }
    else if c == 'f' {
      if starts_with(s, len, idx, "false") {
        (JBool(false), idx + 5)
      } else throw("expected false")
    }
    else if c == '"' {
      let (value, next) = parse_string(s, len, idx)
      (JStr(value), next)
    }
    else if c == '[' {
      parse_array(idx)
    }
    else if c == '{' {
      parse_object(idx)
    }
    else if c == '-' || is_digit(c) {
      parse_number(s, len, idx)
    }
    else throw("unexpected token")
  }
}

fn parse(s: String) -> (Json, Int) with Error {
  let len = String::length(s)
  let (value, next) = parse_value(s, len, 0)
  let end = skip_ws(s, len, next)
  if end == len {
    (value, end)
  } else throw("trailing input")
}

fn parse_ok(s: String) -> Bool {
  handle {
    let (_, end) = parse(s)
    end == String::length(s)
  } with Error {
    Throw(_) => false
  }
}

//# Misc

test "json_parse_null" {
  assert(parse_ok("null"))
}
