//# Misc

test "array literal and length" {
  let arr = [1, 2, 3]
  assert(Array::length(arr) == 3)
}

test "array get" {
  let arr = [10, 20, 30]
  assert(Array::get(arr, 0) == 10)
  assert(Array::get(arr, 1) == 20)
  assert(Array::get(arr, 2) == 30)
}

test "array index syntax" {
  let arr = [10, 20, 30]
  assert(arr[0] == 10)
  assert(arr[1] == 20)
  assert(arr[2] == 30)
}

test "array push" {
  let arr = array_new()
  Array::push(arr, 1)
  Array::push(arr, 2)
  Array::push(arr, 3)
  assert(Array::length(arr) == 3)
  assert(arr[0] == 1)
  assert(arr[2] == 3)
}

test "array set" {
  let arr = [1, 2, 3]
  Array::set(arr, 1, 99)
  assert(arr[1] == 99)
}

test "array slice" {
  let arr = [1, 2, 3, 4, 5]
  let sliced = Array::slice(arr, 1, 4)
  assert(Array::length(sliced) == 3)
  assert(Array::get(sliced, 0) == 2)
  assert(Array::get(sliced, 2) == 4)
}

// Skipped: string array literal hits array_new arity in compiled backend
// test "array of strings" { ... }

test "array empty" {
  let arr: Array[Int] = []
  assert(Array::length(arr) == 0)
}

test "array map" {
  let arr = [1, 2, 3]
  let doubled = Array::r#map(arr, x -> x * 2)
  assert(doubled[0] == 2)
  assert(doubled[1] == 4)
  assert(doubled[2] == 6)
}

test "array push_all" {
  let a = [1, 2]
  let b = [3, 4]
  Array::push_all(a, b)
  assert(Array::length(a) == 4)
  assert(a[2] == 3)
  assert(a[3] == 4)
}

test "array truncate" {
  let arr = [1, 2, 3, 4, 5]
  Array::truncate(arr, 3)
  assert(Array::length(arr) == 3)
  assert(arr[2] == 3)
}

test "for-in array" {
  let arr = [1, 2, 3]
  let result = for x in arr {
    x * 10
  }
  assert(Array::length(result) == 3)
  assert(result[0] == 10)
  assert(result[1] == 20)
  assert(result[2] == 30)
}
