//# Functions

let double: (Int) -> Int = (x) -> x * 2
let add1: (Int) -> Int = (x) -> x + 1
let negate: (Int) -> Int = (x) -> 0 - x

//# Misc

test "basic pipe" {
  let result = 5 |> double
  assert(result == 10)
}

test "pipe chain" {
  let result = 3 |> double |> add1
  assert(result == 7)
}

test "pipe with String::trim" {
  let result = "  hello  " |> String::trim
  assert(result == "hello")
}

test "pipe chain with String" {
  let len = "  hello  " |> String::trim |> String::length
  assert(len == 5)
}

test "pipe into named function" {
  let add8: (Int) -> Int = (x) -> x + 8
  let result = 42 |> add8
  assert(result == 50)
}

test "long pipe chain" {
  let result = 1 |> add1 |> double |> add1 |> double |> negate
  assert(result == -10)
}

test "pipe with Array::length" {
  let arr = [1, 2, 3, 4, 5]
  let len = arr |> Array::length
  assert(len == 5)
}

test "pipe with String::length" {
  let s = "hello"
  let len = s |> String::length
  assert(len == 5)
}

test "pipe with String::concat" {
  let s = "hello"
  let result = s |> String::concat(" world")
  assert(result == "hello world")
}

test "pipe chain String ops" {
  let s = "  Hello World  "
  let result = s |> String::trim |> String::length
  assert(result == 11)
}
