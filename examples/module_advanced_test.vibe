//# Types

module StringUtils {
  export let repeat: (String, Int) -> String = (s, n) -> {
    let mut result = ""
    let mut i = 0
    while i < n {
      result = result + s
      i += 1
    }
    result
  }
  export let is_empty: (String) -> Bool = (s) -> String::length(s) == 0
  export let reverse: (String) -> String = (s) -> {
    let len = String::length(s)
    let mut result = ""
    let mut i = len - 1
    while i >= 0 {
      result = result + String::from_char_code(String::char_code_at(s, i))
      i -= 1
    }
    result
  }
}

module Counter {
  export let make: () -> ((() -> Unit), (() -> Unit), (() -> Int)) = () -> {
    let mut count = 0
    let inc: () -> Unit = () -> { count += 1 }
    let dec: () -> Unit = () -> { count -= 1 }
    let get: () -> Int = () -> { count }
    (inc, dec, get)
  }
}

module MathUtils {
  export let abs: (Int) -> Int = (x) -> if x < 0 { 0 - x } else { x }
  export let sign: (Int) -> Int = (x) -> {
    if x > 0 { 1 } else if x < 0 { -1 } else { 0 }
  }
  export let pow: (Int, Int) -> Int = (base, exp) -> {
    loop (e = exp, acc = 1) {
      if e <= 0 { break(acc) }
      continue(e - 1, acc * base)
    }
  }
  export let is_even: (Int) -> Bool = (x) -> x % 2 == 0
  export let is_odd: (Int) -> Bool = (x) -> x % 2 != 0
}

//# Misc

test "module string repeat" {
  assert(StringUtils::repeat("ab", 3) == "ababab")
  assert(StringUtils::repeat("x", 0) == "")
  assert(StringUtils::repeat("hi", 1) == "hi")
}

test "module string is_empty" {
  assert(StringUtils::is_empty(""))
  assert(not(StringUtils::is_empty("a")))
}

test "module string reverse" {
  assert(StringUtils::reverse("hello") == "olleh")
  assert(StringUtils::reverse("a") == "a")
  assert(StringUtils::reverse("") == "")
  assert(StringUtils::reverse("ab") == "ba")
}

test "module counter" {
  let (inc, dec, get) = Counter::make()
  assert(get() == 0)
  inc()
  inc()
  inc()
  assert(get() == 3)
  dec()
  assert(get() == 2)
}

test "module math abs" {
  assert(MathUtils::abs(-5) == 5)
  assert(MathUtils::abs(5) == 5)
  assert(MathUtils::abs(0) == 0)
}

test "module math sign" {
  assert(MathUtils::sign(10) == 1)
  assert(MathUtils::sign(-10) == -1)
  assert(MathUtils::sign(0) == 0)
}

test "module math pow" {
  assert(MathUtils::pow(2, 0) == 1)
  assert(MathUtils::pow(2, 10) == 1024)
  assert(MathUtils::pow(3, 3) == 27)
  assert(MathUtils::pow(5, 1) == 5)
}

test "module math is_even is_odd" {
  assert(MathUtils::is_even(4))
  assert(not(MathUtils::is_even(3)))
  assert(MathUtils::is_odd(3))
  assert(not(MathUtils::is_odd(4)))
  assert(MathUtils::is_even(0))
}

test "module cross-call" {
  let x = -42
  let abs_x = MathUtils::abs(x)
  let s = StringUtils::repeat(Int::to_string(abs_x), 2)
  assert(s == "4242")
}
