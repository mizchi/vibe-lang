// Example HTTP handler for `just serve` / `vibe serve`
//
// Usage:
//   just serve examples/http_handler.vibe
//   # => http://127.0.0.1:8080
//
// Protocol:
//   handler(method, url) -> Int  (HTTP status code)
//   handler(method, url) -> String  (response body, status 200)

export fn handler(method: String, url: String) -> Int {
  if String::equals(method, "GET") {
    if String::equals(url, "/") { 200 }
    else if String::equals(url, "/health") { 200 }
    else { 404 }
  } else {
    405
  }
}

// Compile-time smoke of the export (top-level bare expressions are rejected
// since ADR-0069; `vibe serve` invokes the `handler` export directly).
let _smoke = handler("GET", "/")
