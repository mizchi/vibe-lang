//# Types

struct Point {
  x: Int; y: Int
}

struct Named {
  name: String; value: Int
}

//# Misc

test "record literal and field access" {
  let p = Point::{ x: 3, y: 4 }
  assert(p.x == 3)
  assert(p.y == 4)
}

test "anonymous record" {
  let r = record { x: 10, y: 20 }
  assert(r.x == 10)
  assert(r.y == 20)
}

test "record destructure in let" {
  let record { x: a, y: b } = record { x: 5, y: 15 }
  assert(a + b == 20)
}

test "record match" {
  let p = Point::{ x: 10, y: 20 }
  let result = match p {
    Point::{ x, y } => x + y,
    _ => 0
  }
  assert(result == 30)
}

test "anonymous record match" {
  let r = record { x: 10, y: 20 }
  let record { x: a, y: b } = r
  assert(a + b == 30)
}

test "record with string field" {
  let n = Named::{ name: "test", value: 42 }
  assert(n.name == "test")
  assert(n.value == 42)
}

test "nested record in tuple" {
  let t = (1, record { x: 2, y: 3 })
  let (a, r) = t
  assert(a == 1)
  assert(r.x == 2)
  assert(r.y == 3)
}

test "record in option" {
  let opt = Some(record { x: 10, y: 20 })
  let result = match opt {
    Some(v) => v.x + v.y,
    _ => 0
  }
  assert(result == 30)
}
