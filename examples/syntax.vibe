//# Types

enum Result[T] {
  Ok(T);
  Err
}

type IntResult = Result[Int]

struct Point {
  x: Int; y: Int
}

trait Eq

impl Eq for Int

impl [T: Eq] Eq for Array[T]

//# Functions

let add2 = (x: Int) -> Int {
  add(x, 2)
}

let rec fact = (n: Int) -> Int {
  if lt(n, 2) {
    1
  } else mul(n, fact(sub(n, 1)))
}

let pair = (1, 2)

let point = Point::{
  x: 3, y: 4
}

let add_i32 = (a: i32, b: i32) -> i32 {
  a + b
}

let labeled = (x: Int, y~: String, z?: Bool) {
  y
}

let half_f64 = (x: f64) -> f64 {
  x / 2.0
}

let identity = [T](x: T) -> T {
  x
}

let if_value = if true {
  1
} else 2

let safe_div = (a: Int, b: Int) -> Int with { Error } {
  if eq(b, 0) {
    throw("division by zero")
  } else a / b
}

let effectful = (s: String) -> Int with { Error } {
  String::length(s)
}

let make_pair = [A, B](a: A, b: B) -> (A, B) {
  (a, b)
}

let map_value = map {
  a: 1,
  "b": 2
}

let point_sum = match point {
  Point::{
    x, y
  } => add(x, y),
  _ => 0
}

let scale_f32 = (x: f32, k: f32) -> f32 {
  x * k
}

let swap_pair = [A, B](p: (A, B)) -> (B, A) {
  (p.1, p.0)
}

let label_call = labeled(1, y = "ok")

let path_value = path("examples/syntax.vibe")

let pipe_basic = 1|>add(2)|>mul(3)

let pipe_ident = "hello"|>String::length

let trait_keep = [T](x: T: Eq) -> T {
  x
}

let array_value = [
  1,
  2,
  3
]

let block_value = {
  let x = 1
  add(x, 2)
}

let built_array = {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, 1)
  ArrayBuilder::push(b, 2)
  ArrayBuilder::freeze(b)
}

let float_value = 1.25f

let float_sum = add(float_value, 2.0f)

let match_guard = match 1 {
  v if lt(v, 2) => 1,
  _ => 0
}

let match_tuple = match pair {
  (a, b) => add(a, b),
  _ => 0
}

let match_value = match Ok(1) {
  Ok(v) => v,
  Err => 0
}

let safe_div_or = (a: Int, b: Int, fallback: Int) -> Int {
  handle {
    safe_div(a, b)
  } {
    Error(_) => fallback
  }
}

let trait_keep2 = [T](x: T: Eq + Show) -> T {
  x
}

let effect_apply = (f: (x: Int) -> Int with { e }, x: Int) -> Int with { e } {
  f(x)
}

let record_value = record {
  a: 1,
  b: 2
}

let match_record = match record_value {
  record {
    a: v
  } => v,
  _ => 0
}

let effectful_int = (x: Int) -> Int with { Error } {
  x
}

let effectful_call = (s: String) -> Int with { Error } {
  effectful(s)
}

let trait_identity = [T: Eq](x: T) -> T {
  x
}

let trait_array = trait_identity([
  1,
  2,
  3
])

let trait_value = trait_identity(42)

let effectful_apply = (x: Int) -> Int with { Error } {
  effect_apply(effectful_int, x)
}

let trait_identity2 = [T: Eq + Show](x: T) -> T {
  x
}

let trait_value2 = trait_identity2(42)

let trait_keep_value = trait_keep(7)

let match_literal_int = match 2 {
  1 => 10,
  2 => 20,
  _ => 0
}

let match_literal_str = match "ok" {
  "ok" => 1,
  _ => 0
}

let trait_keep_value2 = trait_keep2(7)

let match_literal_bool = match true {
  true => 1,
  _ => 0
}

let match_literal_float = match 1.5f {
  1.5f => 1,
  _ => 0
}

let match_literal_double = match 1.5 {
  1.5 => 1,
  _ => 0
}

//# Misc

test "match value" {
  assert(match_value == 1)
}

test "match tuple" {
  assert(match_tuple == 3)
}

test "match record" {
  assert(match_record == 1)
}

test "match guard" {
  assert(match_guard == 1)
}

test "match literal int" {
  assert(match_literal_int == 20)
}

test "match literal str" {
  assert(match_literal_str == 1)
}

test "match literal float" {
  assert(match_literal_float == 1)
}

test "match literal double" {
  assert(match_literal_double == 1)
}

test "match literal bool" {
  assert(match_literal_bool == 1)
}

test "built array" {
  assert(Array::length(built_array) == 2)
}

test "Int::to_double" {
  assert(Int::to_double(42) == 42.0)
}

test "Double::to_int" {
  assert(Double::to_int(3.14) == 3)
}

test "Int::to_float" {
  assert(Int::to_float(42) == 42.0f)
}

test "Float::to_int" {
  assert(Float::to_int(3.14f) == 3)
}

test "Float::to_double" {
  assert(Float::to_double(1.5f) == 1.5)
}

test "Double::to_float" {
  assert(Double::to_float(1.5) == 1.5f)
}

test "label_call" {
  assert(label_call == "ok")
}

test "effect_apply" {
  assert(effectful_apply(7) == 7)
}

test "generic_identity_int" {
  assert(identity(42) == 42)
}

test "generic_identity_string" {
  assert(identity("ok") == "ok")
}

test "generic_make_pair" {
  let p = make_pair(10, "x")
  assert(p.0 == 10)
  assert(p.1 == "x")
}

test "generic_swap_pair" {
  let p = swap_pair(make_pair(1, "left"))
  assert(p.0 == "left")
  assert(p.1 == 1)
}

test "trait_bound_generic" {
  assert(trait_value == 42)
}

test "trait_bound_inline_param" {
  assert(trait_keep_value == 7)
}

test "trait_bound_multi_generic" {
  assert(trait_value2 == 42)
}

test "trait_bound_multi_inline_param" {
  assert(trait_keep_value2 == 7)
}

test "trait_bound_generic_impl" {
  assert(Array::length(trait_array) == 3)
}

test "struct_field_access" {
  assert(point.x == 3)
  assert(point.y == 4)
}

test "struct_match" {
  assert(point_sum == 7)
}

test "error_try_success" {
  assert(safe_div_or(8, 2, -1) == 4)
}

test "error_try_catch" {
  assert(safe_div_or(8, 0, -1) == -1)
}

test "wasm_alias_i32" {
  assert(add_i32(40, 2) == 42)
}

test "wasm_alias_f32" {
  assert(scale_f32(1.5f, 2.0f) == 3.0f)
}

test "wasm_alias_f64" {
  assert(half_f64(7.0) == 3.5)
}

test "Array::concat" {
  let a = Array::concat([
    1,
    2
  ], [
    3,
    4
  ])
  assert(Array::length(a) == 4)
  assert(Array::get(a, 0) == 1)
  assert(Array::get(a, 3) == 4)
}

test "Array::reverse" {
  let r = Array::reverse([
    1,
    2,
    3
  ])
  assert(Array::get(r, 0) == 3)
  assert(Array::get(r, 2) == 1)
}

test "Map::keys" {
  let m = map {
    a: 1,
    b: 2
  }
  let k = Map::keys(m)
  assert(Array::length(k) == 2)
}

test "Map::has_key" {
  let m = map {
    x: 10
  }
  assert(Map::has_key(m, "x"))
  assert(not(Map::has_key(m, "y")))
}

test "Array::slice" {
  let s = Array::slice([
    10,
    20,
    30,
    40
  ], 1, 3)
  assert(Array::length(s) == 2)
  assert(Array::get(s, 0) == 20)
  assert(Array::get(s, 1) == 30)
}

test "string_interp_int" {
  let n = 42
  let msg = "value: \(n)"
  assert(msg == "value: 42")
}

test "string_interp_expr" {
  let msg = "sum: \(add(1, 2))"
  assert(msg == "sum: 3")
}

test "line_comment" {
  let x = 1
  assert(x == 1)
}

test "Array::any" {
  assert(Array::any([
    1,
    2,
    4
  ], (x: Int) -> Bool {
    x > 3
  }))
  assert(not(Array::any([
    1,
    2,
    3
  ], (x: Int) -> Bool {
    x > 5
  })))
}

test "Array::all" {
  assert(Array::all([
    1,
    2,
    3
  ], (x: Int) -> Bool {
    x > 0
  }))
  assert(not(Array::all([
    1,
    2,
    3
  ], (x: Int) -> Bool {
    x > 1
  })))
}

test "Array::find" {
  let found = Array::find([
    1,
    2,
    3,
    4
  ], (x: Int) -> Bool {
    x > 2
  })
  match found {
    Some(v) => assert(v == 3),
    None => assert(false)
  }
  let not_found = Array::find([
    1,
    2,
    3
  ], (x: Int) -> Bool {
    x > 10
  })
  match not_found {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "compound_add" {
  let mut x = 10
  x += 5
  assert(x == 15)
}

test "compound_sub" {
  let mut x = 10
  x -= 3
  assert(x == 7)
}

test "compound_mul" {
  let mut x = 3
  x *= 4
  assert(x == 12)
}

test "compound_div" {
  let mut x = 20
  x /= 4
  assert(x == 5)
}

test "compound_mod" {
  let mut x = 10
  x %= 3
  assert(x == 1)
}

test "record_shorthand" {
  let x = 1
  let y = 2
  let r = record {
    x,
    y
  }
  let record {
    x: a,
    y: b
  } = r
  assert(a + b == 3)
}

test "record_shorthand_pat" {
  let r = record {
    x: 10,
    y: 20
  }
  let record {
    x,
    y
  } = r
  assert(x + y == 30)
}

test "or_pattern_enum" {
  enum Color {
    Red;
    Green;
    Blue
  }
  let warm = (c: Color) -> Bool {
    match c {
      Red|Green => true,
      _ => false
    }
  }
  assert(warm(Red))
  assert(warm(Green))
  assert(not(warm(Blue)))
}

test "or_pattern_int" {
  let x = match 2 {
    1|2|3 => true,
    _ => false
  }
  assert(x)
}

test "method_chain" {
  let s = "hello world"
  let sub = s|>String::substring(0, 5)
  assert((sub|>String::length()) == 5)
}

test "index_array" {
  let a = [
    10,
    20,
    30
  ]
  assert(a[0] == 10)
  assert(a[2] == 30)
}

test "index_chain" {
  let a = [
    [
      1,
      2
    ],
    [
      3,
      4
    ]
  ]
  let b = a[1]
  assert(b[0] == 3)
}

test "modulo_neg" {
  assert(-7 % 3 == -1)
}

test "cmp_neq" {
  assert(1 != 2)
}

test "cmp_gt" {
  assert(3 > 2)
}

test "cmp_gte" {
  assert(3 >= 3)
}

test "cmp_lte" {
  assert(2 <= 3)
}

test "arrow_fn_basic" {
  let double = (x: Int) -> Int {
    x + x
  }
  assert(double(5) == 10)
}

test "arrow_fn_no_ret_type" {
  let inc = (x: Int) {
    x + 1
  }
  assert(inc(3) == 4)
}

test "arrow_fn_multi_params" {
  let add2 = (x: Int, y: Int) -> Int {
    x + y
  }
  assert(add2(3, 4) == 7)
}

test "arrow_fn_in_hof" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], (x: Int) -> Int {
    x * 2
  })
  assert(Array::get(xs, 0) == 2)
  assert(Array::get(xs, 2) == 6)
}

test "arrow_fn_in_hof_no_ret" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], (x: Int) {
    x * 2
  })
  assert(Array::get(xs, 0) == 2)
  assert(Array::get(xs, 2) == 6)
}

test "lambda_single_param_arrow" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], x -> x + 1)
  assert(Array::get(xs, 0) == 2)
  assert(Array::get(xs, 2) == 4)
}

test "lambda_paren_expr_body" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], (x) -> x * 2)
  assert(Array::get(xs, 2) == 6)
}

test "lambda_paren_block_body" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], (x) {
    x + 1
  })
  assert(Array::get(xs, 0) == 2)
}

test "lambda_multi_param_inferred" {
  let result = Array::fold([
    1,
    2,
    3
  ], 0, (acc, x) -> acc + x)
  assert(result == 6)
}

test "lambda_nested_inferred" {
  let xs = Array::r#map(Array::r#map([
    1,
    2,
    3
  ], x -> x + 1), x -> x * 2)
  assert(Array::get(xs, 0) == 4)
  assert(Array::get(xs, 1) == 6)
}

test "placeholder_simple" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], _ * 2)
  assert(Array::get(xs, 0) == 2)
  assert(Array::get(xs, 2) == 6)
}

test "placeholder_two_params" {
  let result = Array::fold([
    1,
    2,
    3
  ], 0, _ + _)
  assert(result == 6)
}

test "placeholder_nested_call" {
  let xs = Array::r#map([
    1,
    2,
    3
  ], add(_, 10))
  assert(Array::get(xs, 0) == 11)
  assert(Array::get(xs, 2) == 13)
}
