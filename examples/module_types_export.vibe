//# Types

export enum Color {
  Red;
  Green;
  Blue
}

export enum Maybe[T] {
  Just(T);
  Nothing
}

export type IntPair = (Int, Int)

//# Functions

export let is_red: (Color) -> Bool = (c) -> {
  match c {
    Red => true,
    _ => false
  }
}

export let make_pair: (Int, Int) -> IntPair = (a, b) -> {
  (a, b)
}

//# Misc

test "Color enum" {
  assert(is_red(Red))
  assert(not(is_red(Blue)))
}

test "Maybe enum" {
  let x = Just(42)
  let result = match x {
    Just(v) => v,
    Nothing => 0
  }
  assert(eq(result, 42))
}

test "IntPair type alias" {
  let p = make_pair(10, 20)
  let (a, b) = p
  assert(eq(a + b, 30))
}
