//# Misc

test "let pat else with Some" {
  let x: Option[Int] = Some(42)
  let Some(v) = x else { 0 }
  assert(v == 42)
}

test "let pat else with None" {
  let x: Option[Int] = None
  let Some(v) = x else { 0 }
  // When None, the else branch returns 0 but v is not bound
  // This tests the fallback behavior
  assert(v == 0)
}

test "let pat else tuple" {
  let x: Option[(Int, Int)] = Some((1, 2))
  let Some((a, b)) = x else { (0, 0) }
  assert(a == 1)
  assert(b == 2)
}

test "let pat else in function" {
  let get_or_default = (opt: Option[Int], def: Int) -> Int {
    let Some(v) = opt else { def }
    v
  }
  assert(get_or_default(Some(42), 0) == 42)
  assert(get_or_default(None, -1) == -1)
}
