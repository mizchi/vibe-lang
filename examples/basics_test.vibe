//# Misc

test "integer literals" {
  assert(0 == 0)
  assert(42 == 42)
  assert(-1 == -1)
}

test "arithmetic add sub" {
  assert(1 + 2 == 3)
  assert(10 - 3 == 7)
  assert(0 + 0 == 0)
  assert(100 - 100 == 0)
}

test "arithmetic mul div mod" {
  assert(4 * 5 == 20)
  assert(10 / 3 == 3)
  assert(10 % 3 == 1)
  assert(0 * 999 == 0)
  assert(7 % 7 == 0)
}

test "comparison operators" {
  assert(1 < 2)
  assert(2 > 1)
  assert(3 <= 3)
  assert(3 >= 3)
  assert(not(1 > 2))
  assert(not(2 < 1))
}

test "equality operators" {
  assert(42 == 42)
  assert(not(42 == 43))
  assert(42 != 43)
  assert(not(42 != 42))
}

test "boolean literals and ops" {
  assert(true)
  assert(not(false))
  assert(true == true)
  assert(false == false)
  assert(true != false)
}

test "let binding" {
  let x = 10
  let y = 20
  assert(x + y == 30)
}

test "let mut binding" {
  let mut x = 0
  x = 5
  assert(x == 5)
  x += 3
  assert(x == 8)
}

test "nested let" {
  let a = {
    let b = 10
    b + 5
  }
  assert(a == 15)
}

test "negative numbers" {
  assert(-1 + 1 == 0)
  assert(-10 * 2 == -20)
  assert(-10 / 2 == -5)
}

test "hex literals" {
  assert(0xFF == 255)
  assert(0x10 == 16)
}

test "string interpolation" {
  let name = "vibe"
  let msg = "hello \(name)"
  assert(msg == "hello vibe")
}

// Unit comparison not supported in compiled backend
// test "unit value" { let x = (); assert(x == ()) }

test "tuple basics" {
  let t = (1, 2, 3)
  assert(t.0 == 1)
  assert(t.1 == 2)
  assert(t.2 == 3)
}

test "tuple destructure" {
  let (a, b) = (10, 20)
  assert(a == 10)
  assert(b == 20)
}

test "bitwise operators" {
  assert((3 & 1) == 1)
  assert((2 | 1) == 3)
  assert((3 ^ 1) == 2)
  assert((1 << 3) == 8)
  assert((8 >> 2) == 2)
}

test "pipe operator" {
  let result = 1|>add(2)|>mul(3)
  assert(result == 9)
}
