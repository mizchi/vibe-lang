//# Misc

// #784: interpolating / __to_string-ing a statically-boolean expression yields
// "true"/"false", not the integer "1"/"0" (Bool and Int share the tagged-int
// runtime representation, so the generic integer path used to print 1/0).

test "bool literal to string" {
  assert("\{true}" == "true")
  assert("\{false}" == "false")
}

test "comparison to string" {
  assert("\{1 < 2}" == "true")
  assert("\{5 == 6}" == "false")
  assert("\{3 >= 3}" == "true")
  assert("\{4 != 4}" == "false")
}

test "logical to string" {
  assert("\{!(1 == 1)}" == "false")
  assert("\{1 == 1 && 2 == 2}" == "true")
  assert("\{1 == 2 || 3 == 3}" == "true")
}

test "int and string interpolation unaffected" {
  assert("\{42}" == "42")
  assert("\{3 + 4}" == "7")
  assert("\{1 << 40}" == "1099511627776")
  assert("\{String::concat("a", "b")}" == "ab")
}
