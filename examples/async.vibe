//# Functions

let async_id: (Int) -> Int with { Async } = (x) -> {
  x
}

let async_abs: (Int) -> Int with { Async } = (x) -> {
  if x < 0 {
    0 - x
  } else x
}

let async_add: (Int, Int) -> Int with { Async } = (a, b) -> {
  a + b
}

let async_safe_div: (Int, Int) -> Int with { Async, Error } = (a, b) -> {
  if b == 0 {
    throw("division by zero")
  } else a / b
}

//# Misc
// Tests consolidated to stay within selfhost compiler resource limits

test "async_identity_and_abs" {
  assert(eq(async_id(42), 42))
  assert(eq(async_abs(-7), 7))
}

test "async_arithmetic" {
  assert(eq(async_add(10, 32), 42))
  assert(eq(async_safe_div(84, 2), 42))
}

test "async_error_handling" {
  let result = handle {
    async_safe_div(10, 0)
  } with Error {
    Throw(_) => -1
  }
  assert(eq(result, -1))
}
