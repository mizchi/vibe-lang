//# Types

struct UserId {
  value: Int;
}

type HashSet = Map[String, Bool]

// The `[K: Show]` bounds below are satisfied for the key types this file
// actually uses. Without this instance `hash_key(1)` is `no impl `Show` for
// `Int``, which is what the file did before it was type-checked by anything.
impl Show for Int

//# Functions

fn hash_key[K: Show](key: K) -> String {
  __to_string(key)
}

fn set_size(s: HashSet) -> Int {
  Array::length(Map::keys(s))
}

fn set_empty() -> HashSet {
  {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
}

fn map_get_by[K: Show, V](m: Map[String, V], key: K) -> V? {
  let skey = hash_key(key)
  if Map::has_key(m, skey) {
    Some(Map::get(m, skey))
  } else None
}

fn map_set_by[K: Show, V](m: Map[String, V], key: K, value: V) -> Map[String, V] {
  Map::set(m, hash_key(key), value)
}

fn set_add_by[K: Show](s: HashSet, key: K) -> HashSet {
  map_set_by(s, key, true)
}

fn user_id_key(id: UserId) -> String {
  __to_string(id.value)
}

fn map_get_with[K, V](m: Map[String, V], key: K, key_to_string: (K) -> String) -> V? {
  let skey = key_to_string(key)
  if Map::has_key(m, skey) {
    Some(Map::get(m, skey))
  } else None
}

fn map_set_with[K, V](m: Map[String, V], key: K, value: V, key_to_string: (K) -> String) -> Map[String, V] {
  Map::set(m, key_to_string(key), value)
}

fn set_add_with[K](s: HashSet, key: K, key_to_string: (K) -> String) -> HashSet {
  map_set_with(s, key, true, key_to_string)
}

fn set_remove_by[K: Show](s: HashSet, key: K) -> HashSet {
  let skey = hash_key(key)
  let b = MapBuilder::new()
  let ks = Map::keys(s)
  for k in ks {
    if k != skey {
      MapBuilder::set(b, k, true)
    }
  }
  MapBuilder::freeze(b)
}

fn build_user_map() -> Map[String, String] {
  let mut users: Map[String, String] = {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
  users = map_set_with(users, UserId::{
    value: 1
  }, "alice", user_id_key)
  users = map_set_with(users, UserId::{
    value: 2
  }, "bob", user_id_key)
  users
}

fn build_user_set() -> HashSet {
  let mut s = set_empty()
  s = set_add_with(s, UserId::{
    value: 1
  }, user_id_key)
  s = set_add_with(s, UserId::{
    value: 2
  }, user_id_key)
  s = set_add_with(s, UserId::{
    value: 2
  }, user_id_key)
  s
}

fn set_contains_by[K: Show](s: HashSet, key: K) -> Bool {
  Map::has_key(s, hash_key(key))
}

fn set_remove_with[K](s: HashSet, key: K, key_to_string: (K) -> String) -> HashSet {
  let skey = key_to_string(key)
  let b = MapBuilder::new()
  let ks = Map::keys(s)
  for k in ks {
    if k != skey {
      MapBuilder::set(b, k, true)
    }
  }
  MapBuilder::freeze(b)
}

fn set_contains_with[K](s: HashSet, key: K, key_to_string: (K) -> String) -> Bool {
  Map::has_key(s, key_to_string(key))
}

fn map_get_or_else_by[K: Show, V](m: Map[String, V], key: K, default: () -> V) -> V {
  if map_get_by(m, key) is Some(v) { v } else { default() }
}

fn map_get_or_else_with[K, V](m: Map[String, V], key: K, key_to_string: (K) -> String, default: () -> V) -> V {
  if map_get_with(m, key, key_to_string) is Some(v) { v } else { default() }
}

//# Misc

test "map trait pattern with hash-bound key" {
  let scores: Map[String, Int] = Map::from_pairs([("1", 10), ("2", 20)])
  match map_get_by(scores, 1) {
    Some(v) => assert(v == 10),
    None => assert(false)
  }
  let fallback = map_get_or_else_by(scores, 999, () -> { -1 })
  assert(fallback == -1)
  let scores2 = map_set_by(scores, 3, 30)
  assert(Array::length(Map::keys(scores2)) == 3)
}

test "set trait pattern with hash-bound key" {
  let mut s = set_empty()
  s = set_add_by(s, 1)
  s = set_add_by(s, 2)
  s = set_add_by(s, 2)
  assert(set_size(s) == 2)
  assert(set_contains_by(s, 1))
  let s2 = set_remove_by(s, 2)
  assert(not(set_contains_by(s2, 2)))
}

test "map/set custom key adapter pattern" {
  let users = build_user_map()
  match map_get_with(users, UserId::{
    value: 1
  }, user_id_key) {
    Some(name) => assert(name == "alice"),
    None => assert(false)
  }
  let fallback = map_get_or_else_with(users, UserId::{
    value: 999
  }, user_id_key, () -> { "guest" })
  assert(fallback == "guest")
  let s = build_user_set()
  assert(set_size(s) == 2)
  assert(set_contains_with(s, UserId::{
    value: 1
  }, user_id_key))
  let s2 = set_remove_with(s, UserId::{
    value: 2
  }, user_id_key)
  assert(not(set_contains_with(s2, UserId::{
    value: 2
  }, user_id_key)))
}

test "Map::set builtin creates new map" {
  let m: Map[String, Int] = Map::from_pairs([("a", 1)])
  let m2 = Map::set(m, "b", 2)
  assert(Map::get(m2, "a") == 1)
  assert(Map::get(m2, "b") == 2)
  assert(Array::length(Map::keys(m)) == 1)
  assert(Array::length(Map::keys(m2)) == 2)
}
