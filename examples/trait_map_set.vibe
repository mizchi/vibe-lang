//# Types

struct UserId {
  value: Int;
}

type HashSet = Map[String, Bool]

//# Functions

let hash_key: [K: Show](K) -> String = (key) -> {
  __to_string(key)
}

let set_size: (HashSet) -> Int = (s) -> {
  Array::length(Map::keys(s))
}

let set_empty: () -> HashSet = () -> {
  {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
}

let map_get_by: [K: Show, V](Map[String, V], K) -> V? = (m, key) -> {
  let skey = hash_key(key)
  if Map::has_key(m, skey) {
    Some(Map::get(m, skey))
  } else None
}

let map_set_by: [K: Show, V](Map[String, V], K, V) -> Map[String, V] = (m, key, value) -> {
  Map::set(m, hash_key(key), value)
}

let set_add_by: [K: Show](HashSet, K) -> HashSet = (s, key) -> {
  map_set_by(s, key, true)
}

let user_id_key: (UserId) -> String = (id) -> {
  __to_string(id.value)
}

let map_get_with: [K, V](Map[String, V], K, (K) -> String) -> V? = (m, key, key_to_string) -> {
  let skey = key_to_string(key)
  if Map::has_key(m, skey) {
    Some(Map::get(m, skey))
  } else None
}

let map_set_with: [K, V](Map[String, V], K, V, (K) -> String) -> Map[String, V] = (m, key, value, key_to_string) -> {
  Map::set(m, key_to_string(key), value)
}

let set_add_with: [K](HashSet, K, (K) -> String) -> HashSet = (s, key, key_to_string) -> {
  map_set_with(s, key, true, key_to_string)
}

let set_remove_by: [K: Show](HashSet, K) -> HashSet = (s, key) -> {
  let skey = hash_key(key)
  let b = MapBuilder::new()
  let ks = Map::keys(s)
  for k in ks {
    if k != skey {
      MapBuilder::set(b, k, true)
    }
  }
  MapBuilder::freeze(b)
}

let build_user_map: () -> Map[String, String] = () -> {
  let mut users: Map[String, String] = {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
  users = map_set_with(users, UserId::{
    value: 1
  }, "alice", user_id_key)
  users = map_set_with(users, UserId::{
    value: 2
  }, "bob", user_id_key)
  users
}

let build_user_set: () -> HashSet = () -> {
  let mut s = set_empty()
  s = set_add_with(s, UserId::{
    value: 1
  }, user_id_key)
  s = set_add_with(s, UserId::{
    value: 2
  }, user_id_key)
  s = set_add_with(s, UserId::{
    value: 2
  }, user_id_key)
  s
}

let set_contains_by: [K: Show](HashSet, K) -> Bool = (s, key) -> {
  Map::has_key(s, hash_key(key))
}

let set_remove_with: [K](HashSet, K, (K) -> String) -> HashSet = (s, key, key_to_string) -> {
  let skey = key_to_string(key)
  let b = MapBuilder::new()
  let ks = Map::keys(s)
  for k in ks {
    if k != skey {
      MapBuilder::set(b, k, true)
    }
  }
  MapBuilder::freeze(b)
}

let set_contains_with: [K](HashSet, K, (K) -> String) -> Bool = (s, key, key_to_string) -> {
  Map::has_key(s, key_to_string(key))
}

let map_get_or_else_by: [K: Show, V](Map[String, V], K, () -> V) -> V = (m, key, default) -> {
  if map_get_by(m, key) is Some(v) { v } else { default() }
}

let map_get_or_else_with: [K, V](Map[String, V], K, (K) -> String, () -> V) -> V = (m, key, key_to_string, default) -> {
  if map_get_with(m, key, key_to_string) is Some(v) { v } else { default() }
}

//# Misc

test "map trait pattern with hash-bound key" {
  let scores: Map[String, Int] = map {
    "1": 10,
    "2": 20
  }
  match map_get_by(scores, 1) {
    Some(v) => assert(v == 10),
    None => assert(false)
  }
  let fallback = map_get_or_else_by(scores, 999, () -> { -1 })
  assert(fallback == -1)
  let scores2 = map_set_by(scores, 3, 30)
  assert(Array::length(Map::keys(scores2)) == 3)
}

test "set trait pattern with hash-bound key" {
  let mut s = set_empty()
  s = set_add_by(s, 1)
  s = set_add_by(s, 2)
  s = set_add_by(s, 2)
  assert(set_size(s) == 2)
  assert(set_contains_by(s, 1))
  let s2 = set_remove_by(s, 2)
  assert(not(set_contains_by(s2, 2)))
}

test "map/set custom key adapter pattern" {
  let users = build_user_map()
  match map_get_with(users, UserId::{
    value: 1
  }, user_id_key) {
    Some(name) => assert(name == "alice"),
    None => assert(false)
  }
  let fallback = map_get_or_else_with(users, UserId::{
    value: 999
  }, user_id_key, () -> { "guest" })
  assert(fallback == "guest")
  let s = build_user_set()
  assert(set_size(s) == 2)
  assert(set_contains_with(s, UserId::{
    value: 1
  }, user_id_key))
  let s2 = set_remove_with(s, UserId::{
    value: 2
  }, user_id_key)
  assert(not(set_contains_with(s2, UserId::{
    value: 2
  }, user_id_key)))
}

test "Map::set builtin creates new map" {
  let m: Map[String, Int] = map {
    "a": 1
  }
  let m2 = Map::set(m, "b", 2)
  assert(Map::get(m2, "a") == 1)
  assert(Map::get(m2, "b") == 2)
  assert(Array::length(Map::keys(m)) == 1)
  assert(Array::length(Map::keys(m2)) == 2)
}
