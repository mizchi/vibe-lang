//# Types

struct UserId {
  value: Int;
}

type MutSet = Map[String, Bool]

// Generic keys carry a real rendering method in their witness dictionary.
trait Key {
  to_string(Self) -> String
}

impl Key for Int {
  to_string(value: Int) -> String {
    __to_string(value)
  }
}

//# Functions

fn hash_key[K: Key](_ key: K) -> String {
  K::to_string(key)
}

fn set_size(_ s: MutSet) -> Int {
  Array::length(Map::keys(s))
}

fn set_empty() -> MutSet {
  {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
}

fn map_get_by[K: Key, V](m: Map[String, V], key: K) -> V? {
  let skey = hash_key(key)
  if Map::has_key(m, key = skey) {
    Some(Map::get(m, key = skey))
  } else None
}

fn map_set_by[K: Key, V](m: Map[String, V], key: K, value: V) -> Map[String, V] {
  Map::set(m, key = hash_key(key), value = value)
}

fn set_add_by[K: Key](s: MutSet, key: K) -> MutSet {
  map_set_by(m = s, key = key, value = true)
}

fn user_id_key(_ id: UserId) -> String {
  __to_string(id.value)
}

fn map_get_with[K, V](m: Map[String, V], key: K, key_to_string: (K) -> String) -> V? {
  let skey = key_to_string(key)
  if Map::has_key(m, key = skey) {
    Some(Map::get(m, key = skey))
  } else None
}

fn map_set_with[K, V](m: Map[String, V], key: K, value: V, key_to_string: (K) -> String) -> Map[String, V] {
  Map::set(m, key = key_to_string(key), value = value)
}

fn set_add_with[K](s: MutSet, key: K, key_to_string: (K) -> String) -> MutSet {
  map_set_with(m = s, key = key, value = true, key_to_string = key_to_string)
}

fn set_remove_by[K: Key](s: MutSet, key: K) -> MutSet {
  let skey = hash_key(key)
  let b = MapBuilder::new()
  let ks = Map::keys(s)
  for k in ks {
    if k != skey {
      MapBuilder::set(b, key = k, value = true)
    }
  }
  MapBuilder::freeze(b)
}

fn build_user_map() -> Map[String, String] {
  let mut users: Map[String, String] = {
    let b = MapBuilder::new()
    MapBuilder::freeze(b)
  }
  users = map_set_with(m = users, key = UserId::{
    value: 1
  }, value = "alice", key_to_string = user_id_key)
  users = map_set_with(m = users, key = UserId::{
    value: 2
  }, value = "bob", key_to_string = user_id_key)
  users
}

fn build_user_set() -> MutSet {
  let mut s = set_empty()
  s = set_add_with(s = s, key = UserId::{
    value: 1
  }, key_to_string = user_id_key)
  s = set_add_with(s = s, key = UserId::{
    value: 2
  }, key_to_string = user_id_key)
  s = set_add_with(s = s, key = UserId::{
    value: 2
  }, key_to_string = user_id_key)
  s
}

fn set_contains_by[K: Key](s: MutSet, key: K) -> Bool {
  Map::has_key(s, key = hash_key(key))
}

fn set_remove_with[K](s: MutSet, key: K, key_to_string: (K) -> String) -> MutSet {
  let skey = key_to_string(key)
  let b = MapBuilder::new()
  let ks = Map::keys(s)
  for k in ks {
    if k != skey {
      MapBuilder::set(b, key = k, value = true)
    }
  }
  MapBuilder::freeze(b)
}

fn set_contains_with[K](s: MutSet, key: K, key_to_string: (K) -> String) -> Bool {
  Map::has_key(s, key = key_to_string(key))
}

fn map_get_or_else_by[K: Key, V](m: Map[String, V], key: K, default: () -> V) -> V {
  if map_get_by(m = m, key = key) is Some(v) {
    v
  } else {
    default()
  }
}

fn map_get_or_else_with[K, V](m: Map[String, V], key: K, key_to_string: (K) -> String, default: () -> V) -> V {
  if map_get_with(m = m, key = key, key_to_string = key_to_string) is Some(v) {
    v
  } else {
    default()
  }
}

//# Misc

test "map trait pattern with hash-bound key" {
  let scores: Map[String, Int] = Map::from_pairs([("1", 10), ("2", 20)])
  match map_get_by(m = scores, key = 1) {
    Some(v) => assert(v == 10),
    None => assert(false)
  }
  let fallback = map_get_or_else_by(m = scores, key = 999, default = () -> {
    -1
  })
  assert(fallback == -1)
  let scores2 = map_set_by(m = scores, key = 3, value = 30)
  assert(Array::length(Map::keys(scores2)) == 3)
}

test "set trait pattern with hash-bound key" {
  let mut s = set_empty()
  s = set_add_by(s = s, key = 1)
  s = set_add_by(s = s, key = 2)
  s = set_add_by(s = s, key = 2)
  assert(set_size(s) == 2)
  assert(set_contains_by(s = s, key = 1))
  let s2 = set_remove_by(s = s, key = 2)
  assert(not(set_contains_by(s = s2, key = 2)))
}

test "map/set custom key adapter pattern" {
  let users = build_user_map()
  match map_get_with(m = users, key = UserId::{
    value: 1
  }, key_to_string = user_id_key) {
    Some(name) => assert(name == "alice"),
    None => assert(false)
  }
  let fallback = map_get_or_else_with(m = users, key = UserId::{
    value: 999
  }, key_to_string = user_id_key, default = () -> {
    "guest"
  })
  assert(fallback == "guest")
  let s = build_user_set()
  assert(set_size(s) == 2)
  assert(set_contains_with(s = s, key = UserId::{
    value: 1
  }, key_to_string = user_id_key))
  let s2 = set_remove_with(s = s, key = UserId::{
    value: 2
  }, key_to_string = user_id_key)
  assert(not(set_contains_with(s = s2, key = UserId::{
    value: 2
  }, key_to_string = user_id_key)))
}

test "Map::set builtin creates new map" {
  let m: Map[String, Int] = Map::from_pairs([("a", 1)])
  let m2 = Map::set(m, key = "b", value = 2)
  assert(Map::get(m2, key = "a") == 1)
  assert(Map::get(m2, key = "b") == 2)
  assert(Array::length(Map::keys(m)) == 1)
  assert(Array::length(Map::keys(m2)) == 2)
}
