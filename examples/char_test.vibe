//# Misc

test "char literal" {
  let c: Char = 'A'
  assert(c == 'A')
  assert(c != 'B')
}

test "char comparison" {
  assert('A' < 'B')
  assert('Z' > 'A')
  assert('a' > 'Z')
  assert('0' < '9')
}

test "char equality" {
  let a = 'x'
  let b = 'x'
  let c = 'y'
  assert(a == b)
  assert(a != c)
}

test "char to int" {
  assert('A' == 65)
  assert('a' == 97)
  assert('0' == 48)
  assert(' ' == 32)
}

test "char from_char_code" {
  assert(String::from_char_code(65) == "A")
  assert(String::from_char_code(48) == "0")
  assert(String::from_char_code(10) == "\n")
}

test "char char_code_at" {
  assert(String::char_code_at("Hello", 0) == 72)
  assert(String::char_code_at("Hello", 1) == 101)
  assert(String::char_code_at("Hello", 4) == 111)
}

test "char in string interpolation" {
  let c = 'A'
  let s = "\{c}"
  assert(s == "65")
}

test "char arithmetic" {
  let c = 'A'
  let next = c + 1
  assert(next == 66)
  assert(next == 'B')
}

test "char in array" {
  let chars = ['H', 'i', '!']
  assert(Array::length(chars) == 3)
  assert(chars[0] == 72)
  assert(chars[1] == 'i')
}

test "char range check" {
  let is_digit: (Char) -> Bool = (c) -> c >= '0' && c <= '9'
  let is_upper: (Char) -> Bool = (c) -> c >= 'A' && c <= 'Z'
  let is_lower: (Char) -> Bool = (c) -> c >= 'a' && c <= 'z'
  assert(is_digit('5'))
  assert(not(is_digit('x')))
  assert(is_upper('M'))
  assert(not(is_upper('m')))
  assert(is_lower('m'))
  assert(not(is_lower('M')))
}

test "char match" {
  let classify: (Char) -> String = (c) -> {
    match c {
      'a'|'e'|'i'|'o'|'u' => "vowel",
      _ => "other"
    }
  }
  assert(classify('a') == "vowel")
  assert(classify('e') == "vowel")
  assert(classify('x') == "other")
}

test "char escape sequences" {
  let newline = '\n'
  let tab = '\t'
  let backslash = '\\'
  let quote = '\''
  assert(newline == 10)
  assert(tab == 9)
  assert(backslash == 92)
  assert(quote == 39)
}
