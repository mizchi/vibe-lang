//# Types

enum Eff {
  Ask(Int);
  Log(String);
}

//# Functions

// fail: () -> Int with {Error}
let fail: () -> Int with { Error } = () -> {
  throw("division by zero")
}

let recover: (Int) -> Int = (fallback) -> {
  handle {
    fail()
  } with Error {
    Throw(_) => fallback
  }
}

// ask_once: () -> Int with {Ask}
let ask_once: () -> Int with { Ask } = () -> {
  perform(Ask(41))
}

let multi_layer: () -> Int = () -> {
  handle {
    handle {
      add(10, perform(Log("start")))
    } with Log {
      Log(_) => resume(perform(Ask(32)))
    }
  } with Ask {
    Ask(_) => resume(33)
  }
}

let ask_plus_one: () -> Int = () -> {
  handle {
    add(1, ask_once())
  } with Ask {
    Ask(_) => resume(42)
  }
}

let main: () -> Int = () -> {
  add(ask_plus_one(), multi_layer())
}

//# Misc

test "perform+handle typed payload" {
  assert(ask_plus_one() == 43)
}

test "perform+handle multi-layer" {
  assert(multi_layer() == 43)
}

test "throw is still handled by Error" {
  assert(recover(7) == 7)
}
