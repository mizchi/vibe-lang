//# Misc

test "double literal" {
  let d = 3.14
  assert(d == 3.14)
}

test "double arithmetic" {
  let a = 1.5
  let b = 2.5
  assert(a + b == 4.0)
  assert(b - a == 1.0)
  assert(a * b == 3.75)
}

test "double comparison" {
  assert(1.0 < 2.0)
  assert(2.0 > 1.0)
  assert(1.0 <= 1.0)
  assert(1.0 >= 1.0)
  assert(1.0 != 2.0)
}

test "double negation" {
  let x = 5.0
  let y = -x
  assert(y == -5.0)
}

test "float literal" {
  let f = 1.5f
  assert(f == 1.5f)
}

test "double to int" {
  let d = 42.9
  let n = Double::to_int(d)
  assert(n == 42)
}

test "int to double" {
  let n = 42
  let d = Int::to_double(n)
  assert(d == 42.0)
}

test "double division" {
  let a = 10.0
  let b = 4.0
  assert(a / b == 2.5)
}

test "double abs" {
  assert(Double::abs(-3.14) == 3.14)
  assert(Double::abs(3.14) == 3.14)
  assert(Double::abs(0.0) == 0.0)
}

test "double floor ceil" {
  assert(Double::floor(3.7) == 3.0)
  assert(Double::ceil(3.2) == 4.0)
  assert(Double::floor(-1.5) == -2.0)
  assert(Double::ceil(-1.5) == -1.0)
}

test "double max min" {
  assert(Double::max(1.0, 2.0) == 2.0)
  assert(Double::min(1.0, 2.0) == 1.0)
}

test "double to string" {
  let s = Double::to_string(3.14)
  assert(String::length(s) > 0)
}

test "float arithmetic" {
  let a = 1.5f
  let b = 2.5f
  assert(a + b == 4.0f)
  assert(b - a == 1.0f)
  assert(a * b == 3.75f)
}

test "float comparison" {
  assert(1.0f < 2.0f)
  assert(2.0f > 1.0f)
  assert(1.0f <= 1.0f)
  assert(1.0f >= 1.0f)
  assert(1.0f != 2.0f)
}

test "float negation" {
  let x = 5.0f
  let y = -x
  assert(y == -5.0f)
}

test "int to float" {
  let n = 42
  let f = Int::to_float(n)
  assert(f == 42.0f)
}

test "float to int" {
  let f = 42.9f
  let n = Float::to_int(f)
  assert(n == 42)
}

test "float to double" {
  let f = 1.5f
  let d = Float::to_double(f)
  assert(d == 1.5)
}

test "double to float" {
  let d = 1.5
  let f = Double::to_float(d)
  assert(f == 1.5f)
}

test "float to string" {
  let s = Float::to_string(3.14f)
  assert(String::length(s) > 0)
}
