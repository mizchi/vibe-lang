//# Misc

test "double literal" {
  let d = 3.14
  assert(d == 3.14)
}

test "double arithmetic" {
  let a = 1.5
  let b = 2.5
  assert(a + b == 4.0)
  assert(b - a == 1.0)
  assert(a * b == 3.75)
}

test "double comparison" {
  assert(1.0 < 2.0)
  assert(2.0 > 1.0)
  assert(1.0 <= 1.0)
  assert(1.0 >= 1.0)
  assert(1.0 != 2.0)
}

test "double negation" {
  let x = 5.0
  let y = -x
  assert(y == -5.0)
}

test "float literal" {
  let f = 1.5f
  assert(f == 1.5f)
}

test "double to int" {
  let d = 42.9
  let n = Double::to_int(d)
  assert(n == 42)
}

test "int to double" {
  let n = 42
  let d = Int::to_double(n)
  assert(d == 42.0)
}
