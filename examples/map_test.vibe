//# Misc

test "map literal" {
  let m = map { "a": 1, "b": 2, "c": 3 }
  assert(m["a"] == 1)
  assert(m["b"] == 2)
  assert(m["c"] == 3)
}

test "map empty" {
  let m: Map[String, Int] = map {}
  assert(Map::size(m) == 0)
}

test "map size" {
  let m = map { "x": 10, "y": 20 }
  assert(Map::size(m) == 2)
}

test "map has" {
  let m = map { "key": 42 }
  assert(Map::has(m, "key"))
  assert(not(Map::has(m, "missing")))
}

test "map set and get" {
  let m = map { "a": 1 }
  Map::set(m, "b", 2)
  assert(m["b"] == 2)
  assert(Map::size(m) == 2)
}

test "map overwrite" {
  let m = map { "k": 1 }
  Map::set(m, "k", 99)
  assert(m["k"] == 99)
  assert(Map::size(m) == 1)
}

test "map delete" {
  let m = map { "a": 1, "b": 2 }
  Map::delete(m, "a")
  assert(not(Map::has(m, "a")))
  assert(Map::size(m) == 1)
}

test "map keys" {
  let m = map { "x": 1, "y": 2 }
  let ks = Map::keys(m)
  assert(Array::length(ks) == 2)
  assert(Array::any(ks, k -> k == "x"))
  assert(Array::any(ks, k -> k == "y"))
}

test "map values" {
  let m = map { "a": 10, "b": 20 }
  let vs = Map::values(m)
  assert(Array::length(vs) == 2)
  assert(Array::any(vs, v -> v == 10))
  assert(Array::any(vs, v -> v == 20))
}
