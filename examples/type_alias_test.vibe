//# Types

type Pair = (Int, Int)
type StringPair = (String, String)
type IntArray = Array[Int]

//# Misc

test "type alias for tuple" {
  let p: Pair = (1, 2)
  assert(p.0 == 1)
  assert(p.1 == 2)
}

test "type alias for string tuple" {
  let p: StringPair = ("hello", "world")
  assert(p.0 == "hello")
  assert(p.1 == "world")
}

test "type alias for array" {
  let xs: IntArray = [1, 2, 3]
  assert(Array::length(xs) == 3)
  assert(xs[0] == 1)
}

test "type alias in function param" {
  let sum_pair: (Pair) -> Int = (p) -> { p.0 + p.1 }
  assert(sum_pair((3, 4)) == 7)
}

test "type alias in function return" {
  let make_pair: (Int) -> Pair = (x) -> { (x, x * 2) }
  let p = make_pair(5)
  assert(p.0 == 5)
  assert(p.1 == 10)
}
