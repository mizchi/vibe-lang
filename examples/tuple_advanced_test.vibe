//# Misc

test "tuple pattern in match" {
  let classify: ((Int, Int)) -> String = (t) -> {
    match t {
      (0, 0) => "origin",
      (0, _) => "y-axis",
      (_, 0) => "x-axis",
      _ => "general"
    }
  }
  assert(classify((0, 0)) == "origin")
  assert(classify((0, 5)) == "y-axis")
  assert(classify((3, 0)) == "x-axis")
  assert(classify((1, 2)) == "general")
}

test "tuple 5 elements" {
  let t = (1, 2, 3, 4, 5)
  assert(t.0 == 1)
  assert(t.1 == 2)
  assert(t.2 == 3)
  assert(t.3 == 4)
  assert(t.4 == 5)
}

test "tuple destructuring 4" {
  let (a, b, c, d) = (10, 20, 30, 40)
  assert(a + b + c + d == 100)
}

test "tuple in array" {
  let arr = [(1, "one"), (2, "two"), (3, "three")]
  assert(arr[0].0 == 1)
  assert(arr[0].1 == "one")
  assert(arr[2].0 == 3)
  assert(arr[2].1 == "three")
}

test "tuple with option" {
  let t: (Option[Int], Option[String]) = (Some(42), Some("hi"))
  let (a, b) = t
  assert(a == Some(42))
  assert(b == Some("hi"))
}

test "tuple of tuples" {
  let t = ((1, 2), (3, 4), (5, 6))
  assert(t.0.0 + t.1.0 + t.2.0 == 9)
  assert(t.0.1 + t.1.1 + t.2.1 == 12)
}

test "tuple swap function" {
  let swap: [A, B]((A, B)) -> (B, A) = (t) -> (t.1, t.0)
  let (a, b) = swap((1, "hello"))
  assert(a == "hello")
  assert(b == 1)
}

test "tuple map first" {
  let map_fst: [A, B, C]((A, B), (A) -> C) -> (C, B) = (t, f) -> (f(t.0), t.1)
  let result = map_fst((5, "hi"), x -> x * 2)
  assert(result.0 == 10)
  assert(result.1 == "hi")
}

test "tuple in for-in" {
  let pairs = [(1, 10), (2, 20), (3, 30)]
  let sums = for p in pairs { p.0 + p.1 }
  assert(sums[0] == 11)
  assert(sums[1] == 22)
  assert(sums[2] == 33)
}

test "tuple mixed types" {
  let t = (42, "hello", true, 3.14)
  assert(t.0 == 42)
  assert(t.1 == "hello")
  assert(t.2 == true)
  assert(t.3 == 3.14)
}

test "tuple match with guard" {
  let classify: ((Int, Int)) -> String = (t) -> {
    match t {
      (x, y) if x == y => "equal",
      (x, y) if x > y => "first larger",
      _ => "second larger"
    }
  }
  assert(classify((5, 5)) == "equal")
  assert(classify((10, 3)) == "first larger")
  assert(classify((3, 10)) == "second larger")
}

test "tuple unit" {
  let t = (42, ())
  assert(t.0 == 42)
  assert(t.1 == ())
}

test "tuple as function return multiple" {
  let divmod: (Int, Int) -> (Int, Int) = (a, b) -> (a / b, a % b)
  let (q, r) = divmod(17, 5)
  assert(q == 3)
  assert(r == 2)
}
