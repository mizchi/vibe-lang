//# Types

struct Vec2 { x: Int; y: Int }

enum Color { Red; Green; Blue }

//# Functions

fn sum_loop(n: Int) -> Int {
  loop (i = 0, acc = 0) {
    if i >= n { break(acc) }
    continue(i + 1, acc + i)
  }
}

fn vec2_sum(p: Vec2) -> Int {
  let Vec2::{ x, y } = p
  x + y
}

fn classify_color(c: Color) -> Int {
  match c {
    Red => 1,
    Green => 2,
    Blue => 3,
  }
}

//# Misc

test "loop_break_value" {
  assert(eq(sum_loop(10), 45))
  assert(eq(sum_loop(0), 0))
  assert(eq(sum_loop(5), 10))
}

test "struct_destruct" {
  let a = Vec2::{ x: 3, y: 4 }
  let b = Vec2::{ x: 10, y: 20 }
  assert(eq(vec2_sum(a), 7))
  assert(eq(vec2_sum(b), 30))
}

test "enum_match_and_map_int_keys" {
  assert(eq(classify_color(Red), 1))
  assert(eq(classify_color(Blue), 3))
  let m = MapBuilder::new()
  MapBuilder::set(m, 1, 100)
  MapBuilder::set(m, 2, 200)
  let frozen = MapBuilder::freeze(m)
  assert(eq(Map::get(frozen, 1), 100))
  assert(eq(Map::get(frozen, 2), 200))
}
