//# Misc

test "for-in basic" {
  let xs = [1, 2, 3]
  let doubled = for x in xs { x * 2 }
  assert(doubled[0] == 2)
  assert(doubled[1] == 4)
  assert(doubled[2] == 6)
}

test "for-in with index" {
  let xs = ["a", "b", "c"]
  let indexed = for i, x in xs { (i, x) }
  assert(indexed[0] == (0, "a"))
  assert(indexed[1] == (1, "b"))
  assert(indexed[2] == (2, "c"))
}

test "for-in empty" {
  let xs: Array[Int] = []
  let result = for x in xs { x * 2 }
  assert(Array::length(result) == 0)
}

test "for-in preserves length" {
  let xs = [10, 20, 30, 40, 50]
  let result = for x in xs { x + 1 }
  assert(Array::length(result) == 5)
}

test "for-in with string ops" {
  let names = ["alice", "bob"]
  let upper = for name in names { String::length(name) }
  assert(upper[0] == 5)
  assert(upper[1] == 3)
}

test "for-in nested" {
  let xs = [1, 2, 3]
  let result = for x in xs {
    let ys = for y in xs { x + y }
    ys[0]
  }
  assert(result[0] == 2)
  assert(result[1] == 3)
  assert(result[2] == 4)
}
