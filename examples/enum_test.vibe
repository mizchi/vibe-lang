//# Types

enum Color {
  Red;
  Green;
  Blue
}

enum Shape {
  Circle(Int);
  Rect(Int, Int);
  Empty
}

//# Functions

let shape_area: (Shape) -> Int = (s) -> {
  match s {
    Circle(r) => r * r,
    Rect(w, h) => w * h,
    Empty => 0
  }
}

let color_to_int: (Color) -> Int = (c) -> {
  match c {
    Red => 0,
    Green => 1,
    Blue => 2
  }
}

//# Misc

test "enum constructor" {
  assert(color_to_int(Red) == 0)
  assert(color_to_int(Green) == 1)
  assert(color_to_int(Blue) == 2)
}

test "enum with payload" {
  assert(shape_area(Circle(5)) == 25)
  assert(shape_area(Rect(3, 4)) == 12)
  assert(shape_area(Empty) == 0)
}

test "option some none" {
  let x = Some(42)
  let y: Option[Int] = None
  let get_or = (opt: Option[Int], default: Int) -> Int {
    match opt {
      Some(v) => v,
      None => default
    }
  }
  assert(get_or(x, 0) == 42)
  assert(get_or(y, 99) == 99)
}

test "nested option" {
  let x = Some(Some(10))
  let result = match x {
    Some(inner) => match inner {
      Some(v) => v,
      None => 0
    },
    None => -1
  }
  assert(result == 10)
}

test "option in match with wildcard" {
  let x = Some(5)
  let result = match x {
    Some(1)|Some(2)|Some(5) => "matched",
    _ => "miss"
  }
  assert(result == "matched")
}

test "enum match exhaustive" {
  let c = Green
  let name = match c {
    Red => "red",
    Green => "green",
    Blue => "blue"
  }
  assert(name == "green")
}

test "let pattern with some" {
  let opt = Some(42)
  let Some(x) = opt
  assert(x == 42)
}
