//# Misc

test "loop with break value" {
  let mut result = 0
  loop (i = 0, acc = 0) {
    if i >= 10 {
      result = acc
      break
    }
    continue(i + 1, acc + i)
  }
  assert(result == 45)
}

test "loop countdown" {
  let mut result = 0
  loop (n = 100) {
    if n <= 0 {
      result = 0
      break
    }
    if n == 1 {
      result = 1
      break
    }
    continue(n - 2)
  }
  assert(result == 1)
}

test "loop single param" {
  let mut result = 0
  loop (i = 1) {
    if i > 100 {
      result = i
      break
    }
    continue(i * 2)
  }
  assert(result == 128)
}

test "for-in with index" {
  let arr = ["a", "b", "c"]
  let result = for i, _x in arr {
    i
  }
  assert(result[0] == 0)
  assert(result[1] == 1)
  assert(result[2] == 2)
}

test "for-in map transform" {
  let arr = [1, 2, 3, 4, 5]
  let squares = for x in arr {
    x * x
  }
  assert(squares[0] == 1)
  assert(squares[1] == 4)
  assert(squares[2] == 9)
  assert(squares[3] == 16)
  assert(squares[4] == 25)
}

test "for-in over empty array" {
  let arr: Array[Int] = []
  let result = for x in arr {
    x + 1
  }
  assert(Array::length(result) == 0)
}

test "while with break" {
  let mut i = 0
  let mut found = -1
  let arr = [10, 20, 30, 40, 50]
  while i < Array::length(arr) {
    if arr[i] == 30 {
      found = i
      break
    }
    i += 1
  }
  assert(found == 2)
}

test "nested while loops" {
  let mut sum = 0
  let mut i = 0
  while i < 3 {
    let mut j = 0
    while j < 3 {
      sum += 1
      j += 1
    }
    i += 1
  }
  assert(sum == 9)
}

test "while with continue" {
  let mut sum = 0
  let mut i = 0
  while i < 10 {
    i += 1
    if i % 2 == 0 {
      continue
    }
    sum += i
  }
  assert(sum == 25)
}
