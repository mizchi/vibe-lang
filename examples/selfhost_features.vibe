// Selfhost compiler feature test: struct destructuring, loop, enum, match

struct Vec2 { x: Int; y: Int }

enum Color { Red; Green; Blue }

let sum_loop: (Int) -> Int = (n) -> {
  loop (i = 0, acc = 0) {
    if i >= n { break(acc) }
    continue(i + 1, acc + i)
  }
}

let vec2_sum: (Vec2) -> Int = (p) -> {
  let Vec2::{ x, y } = p
  x + y
}

let classify_color: (Color) -> Int = (c) -> {
  match c {
    Red => 1,
    Green => 2,
    Blue => 3,
  }
}

let main: () -> Int = () -> {
  let a = Vec2::{ x: 3, y: 4 }
  let sum = vec2_sum(a)
  let loop_val = sum_loop(10)
  let color_val = classify_color(Red)
  if sum == 7 && loop_val == 45 && color_val == 1 { 0 } else { 1 }
}
