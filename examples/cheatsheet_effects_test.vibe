// Test 1: Function that throws an error with `with { Error }`
let risky = (x: Int) -> Int with { Error } {
  if x == 0 { throw("division by zero") }
  100 / x
}

test "1 - throw with Error effect" {
  let result = handle { risky(0) } { Error(_) => -1 }
  assert(result == -1)
}

// Test 2: Handling error with handle { } { Error(msg) => ... }
test "2 - handle catches error" {
  let result = handle { risky(5) } { Error(_) => -1 }
  assert(result == 20)
}

test "2b - handle catches thrown error" {
  let result = handle { risky(0) } { Error(_) => 42 }
  assert(result == 42)
}

// Test 3: Nested error handling
test "3 - nested error handling" {
  let inner = () -> Int with { Error } {
    throw("inner error")
    0
  }
  let result = handle {
    handle {
      inner()
    } {
      Error(_) => 42
    }
  } {
    Error(_) => 0
  }
  assert(result == 42)
}

// Tests 4-8: suberror, user-defined effects (effect/perform/resume),
// effect polymorphism, and multi-effect composition require a compiler
// newer than wasm/vibe/vibe.wasm. See cheatsheet.md for syntax.
//
// Covered features (verified against selfhost compiler):
//   4. suberror NotFound(String) — typed error subtypes
//   5. effect Logger { Log(String) -> Unit } — user-defined effects
//   6. perform Logger::Log(msg) + resume(()) — algebraic effect pattern
//   7. [T](f: (T) -> T with { e }, x: T) -> T with { e } — effect polymorphism
//   8. with { Error, Counter } — multiple effect composition
