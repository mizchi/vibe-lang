//# Functions

// table: String
let table: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

// to_b64: (Int) -> String
let to_b64 = (i: Int) -> String {
  table.string_substring(i, i + 1)
}

// encode_pair: (Int, Int) -> String
let encode_pair = (a: Int, b: Int) -> String {
  let c0 = to_b64(a / 4)
  let x1 = a % 4 * 16
  let y1 = b / 16
  let c1 = to_b64(x1 + y1)
  let c2 = to_b64(b % 16 * 4)
  c0.string_concat(c1).string_concat(c2).string_concat("=")
}

// encode_single: (Int) -> String
let encode_single = (a: Int) -> String {
  let c0 = to_b64(a / 4)
  let c1 = to_b64(a % 4 * 16)
  c0.string_concat(c1).string_concat("==")
}

// encode_triplet: (Int, Int, Int) -> String
let encode_triplet = (a: Int, b: Int, c: Int) -> String {
  let c0 = to_b64(a / 4)
  let x1 = a % 4 * 16
  let y1 = b / 16
  let c1 = to_b64(x1 + y1)
  let x2 = b % 16 * 4
  let y2 = c / 64
  let c2 = to_b64(x2 + y2)
  let c3 = to_b64(c % 64)
  c0.string_concat(c1).string_concat(c2).string_concat(c3)
}

// enc_loop: (String, Int, String) -> String
let rec enc_loop = (s: String, i: Int, out: String) -> String {
  let len = s.string_length()
  if i + 3 <= len {
    let j = i + 1
    let k = i + 2
    let a = s.string_char_code_at(i)
    let b = s.string_char_code_at(j)
    let c = s.string_char_code_at(k)
    enc_loop(s, i + 3, out.string_concat(encode_triplet(a, b, c)))
  } else if i + 2 <= len {
    let j = i + 1
    let a = s.string_char_code_at(i)
    let b = s.string_char_code_at(j)
    out.string_concat(encode_pair(a, b))
  } else if i + 1 <= len {
    let a = s.string_char_code_at(i)
    out.string_concat(encode_single(a))
  } else {
    out
  }
}

// encode: (String) -> String
export let encode = (s: String) -> String {
  enc_loop(s, 0, "")
}

//# Misc

test "encode 3 bytes" {
  assert(string_equals(encode("Man"), "TWFu"))
}

test "encode 2 bytes padding" {
  assert(string_equals(encode("Ma"), "TWE="))
}

test "encode 1 byte padding" {
  assert(string_equals(encode("M"), "TQ=="))
}

test "encode empty" {
  assert(string_equals(encode(""), ""))
}

test "encode longer string" {
  assert(string_equals(encode("Hello World"), "SGVsbG8gV29ybGQ="))
}

test "encode example" {
  assert(string_equals(encode("Man"), "TWFu"))
}

export {
  encode
}
