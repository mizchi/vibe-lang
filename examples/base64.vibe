//# Functions

let table: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

let to_b64: (Int) -> String = (i) -> {
  table|>String::substring(i, i + 1)
}

let encode_pair: (Int, Int) -> String = (a, b) -> {
  let c0 = to_b64(a / 4)
  let x1 = a % 4 * 16
  let y1 = b / 16
  let c1 = to_b64(x1 + y1)
  let c2 = to_b64(b % 16 * 4)
  c0|>String::concat(c1)|>String::concat(c2)|>String::concat("=")
}

let encode_single: (Int) -> String = (a) -> {
  let c0 = to_b64(a / 4)
  let c1 = to_b64(a % 4 * 16)
  c0|>String::concat(c1)|>String::concat("==")
}

let encode_triplet: (Int, Int, Int) -> String = (a, b, c) -> {
  let c0 = to_b64(a / 4)
  let x1 = a % 4 * 16
  let y1 = b / 16
  let c1 = to_b64(x1 + y1)
  let x2 = b % 16 * 4
  let y2 = c / 64
  let c2 = to_b64(x2 + y2)
  let c3 = to_b64(c % 64)
  c0|>String::concat(c1)|>String::concat(c2)|>String::concat(c3)
}

let rec enc_loop: (String, Int, String) -> String = (s: String, i: Int, out: String) -> String {
  let len = s|>String::length()
  if i + 3 <= len {
    let j = i + 1
    let k = i + 2
    let a = s|>String::char_code_at(i)
    let b = s|>String::char_code_at(j)
    let c = s|>String::char_code_at(k)
    enc_loop(s, i + 3, out|>String::concat(encode_triplet(a, b, c)))
  } else if i + 2 <= len {
    let j = i + 1
    let a = s|>String::char_code_at(i)
    let b = s|>String::char_code_at(j)
    out|>String::concat(encode_pair(a, b))
  } else if i + 1 <= len {
    let a = s|>String::char_code_at(i)
    out|>String::concat(encode_single(a))
  } else out
}

export let encode: (String) -> String = (s) -> {
  enc_loop(s, 0, "")
}

//# Misc

test "encode 3 bytes" {
  assert(encode("Man") == "TWFu")
}

test "encode 2 bytes padding" {
  assert(encode("Ma") == "TWE=")
}

test "encode 1 byte padding" {
  assert(encode("M") == "TQ==")
}

test "encode empty" {
  assert(encode("") == "")
}

test "encode longer string" {
  assert(encode("Hello World") == "SGVsbG8gV29ybGQ=")
}

test "encode example" {
  assert(encode("Man") == "TWFu")
}
