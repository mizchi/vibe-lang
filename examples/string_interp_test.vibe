//# Misc

test "interpolation with int" {
  let x = 42
  assert("\(x)" == "42")
}

test "interpolation with string" {
  let name = "world"
  assert("hello \(name)!" == "hello world!")
}

test "interpolation with expression" {
  let x = 3
  let y = 4
  assert("\(x + y)" == "7")
}

test "interpolation with function call" {
  let arr = [1, 2, 3]
  assert("len=\(Array::length(arr))" == "len=3")
}

test "interpolation multiple" {
  let a = 1
  let b = 2
  let c = 3
  assert("\(a),\(b),\(c)" == "1,2,3")
}

test "interpolation with bool" {
  let b = true
  assert("\(b)" == "true")
}

test "interpolation with comparison" {
  let x = 10
  assert("\(x > 5)" == "true")
  assert("\(x < 5)" == "false")
}

test "interpolation nested string concat" {
  let first = "hello"
  let second = "world"
  assert("\(first) \(second)" == "hello world")
}

test "interpolation in longer string" {
  let x = 42
  assert("the answer is \(x) indeed" == "the answer is 42 indeed")
}

test "interpolation with negation" {
  let x = -5
  assert("val=\(x)" == "val=-5")
}

test "interpolation with multiplication" {
  let x = 6
  let y = 7
  assert("result=\(x * y)" == "result=42")
}

test "interpolation empty prefix" {
  let x = 99
  assert("\(x) bottles" == "99 bottles")
}

test "interpolation empty suffix" {
  let x = 42
  assert("answer=\(x)" == "answer=42")
}

test "interpolation with zero" {
  assert("\(0)" == "0")
}

test "interpolation with string length" {
  let s = "hello"
  assert("length is \(String::length(s))" == "length is 5")
}
