//# Functions

let make_counter = () -> (() -> Int) {
  let mut count = 0
  () -> Int {
    count += 1
    count
  }
}

let make_adder = (n: Int) -> (Int) -> Int {
  (x: Int) -> Int { x + n }
}

//# Misc

test "closure captures immutable" {
  let x = 10
  let f = () -> Int { x + 5 }
  assert(f() == 15)
}

test "closure captures parameter" {
  let add5 = make_adder(5)
  let add10 = make_adder(10)
  assert(add5(3) == 8)
  assert(add10(3) == 13)
  assert(add5(0) == 5)
}

test "closure captures mutable" {
  let mut x = 0
  let inc = () -> Unit { x += 1 }
  inc()
  inc()
  inc()
  assert(x == 3)
}

test "counter closure" {
  let c = make_counter()
  assert(c() == 1)
  assert(c() == 2)
  assert(c() == 3)
}

test "independent counters" {
  let c1 = make_counter()
  let c2 = make_counter()
  assert(c1() == 1)
  assert(c1() == 2)
  assert(c2() == 1)
  assert(c1() == 3)
  assert(c2() == 2)
}

test "closure in array" {
  let fns = [
    make_adder(1),
    make_adder(10),
    make_adder(100)
  ]
  assert(fns[0](5) == 6)
  assert(fns[1](5) == 15)
  assert(fns[2](5) == 105)
}

test "nested closure" {
  let outer = 10
  let f = () -> (Int) -> Int {
    let inner = 20
    (x: Int) -> Int { x + outer + inner }
  }
  let g = f()
  assert(g(5) == 35)
}

test "closure over loop variable" {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < 3 {
    let captured = i
    ArrayBuilder::push(b, () -> Int { captured })
    i += 1
  }
  let fns = ArrayBuilder::freeze(b)
  assert(fns[0]() == 0)
  assert(fns[1]() == 1)
  assert(fns[2]() == 2)
}
