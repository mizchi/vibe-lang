test "string + string" {
  assert(String::equals("hello" + " world", "hello world"))
}

test "string + variable" {
  let a = "foo"
  let b = "bar"
  assert(String::equals(a + b, "foobar"))
}

test "string + chain" {
  let result = "a" + "b" + "c"
  assert(String::equals(result, "abc"))
}

test "string + in interpolation" {
  let name = "vibe"
  let msg = "hello " + name + "!"
  assert(String::equals(msg, "hello vibe!"))
}
