//# Imports

import ./module_export.vibe {
  add, double, mul, pi, square
}

//# Functions

let result1 = add(a = 10, b = 20)

let result2 = mul(a = 3, b = 4)

let result3 = double(pi)

let result4 = square(5)

fn sum_of_squares(a: Int, b: Int) -> Int {
  add(a = square(a), b = square(b))
}

//# Misc

test "imported add" {
  assert(result1 == 30)
}

test "imported mul" {
  assert(result2 == 12)
}

test "imported double with pi" {
  assert(result3 == 6)
}

test "imported square" {
  assert(result4 == 25)
}

test "composed sum_of_squares" {
  assert(sum_of_squares(a = 3, b = 4) == 25)
}
