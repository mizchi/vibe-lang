//# Misc

test "closure captures multiple vars" {
  let a = 10
  let b = 20
  let c = 30
  let f = () -> Int { a + b + c }
  assert(f() == 60)
}

test "closure captures mutable and reads" {
  let mut count = 0
  let inc = () -> Unit { count += 1 }
  let get = () -> Int { count }
  inc()
  inc()
  inc()
  assert(get() == 3)
}

test "closure in higher order function" {
  let multiplier = 3
  let result = Array::map([1, 2, 3, 4], x -> x * multiplier)
  assert(result[0] == 3)
  assert(result[1] == 6)
  assert(result[2] == 9)
  assert(result[3] == 12)
}

test "closure returned from function" {
  let make_adder: (Int) -> (Int) -> Int = (n) -> {
    (x: Int) -> Int { x + n }
  }
  let add5 = make_adder(5)
  let add10 = make_adder(10)
  assert(add5(3) == 8)
  assert(add10(3) == 13)
  assert(add5(add10(0)) == 15)
}

test "closure chain" {
  let make_chain: () -> (Int) -> Int = () -> {
    let mut total = 0
    (x: Int) -> Int {
      total += x
      total
    }
  }
  let chain = make_chain()
  assert(chain(10) == 10)
  assert(chain(20) == 30)
  assert(chain(5) == 35)
}

test "closure in array map filter" {
  let threshold = 3
  let arr = [1, 2, 3, 4, 5, 6]
  let filtered = Array::filter(arr, x -> x > threshold)
  let doubled = Array::map(filtered, x -> x * 2)
  assert(Array::length(doubled) == 3)
  assert(doubled[0] == 8)
  assert(doubled[1] == 10)
  assert(doubled[2] == 12)
}

test "closure captures string" {
  let prefix = "hello"
  let greet = (name: String) -> String { prefix + " " + name }
  assert(greet("world") == "hello world")
  assert(greet("vibe") == "hello vibe")
}

test "closure captures enum" {
  let default_val: Option[Int] = Some(42)
  let get_or = (opt: Option[Int]) -> Int {
    match opt {
      Some(v) => v,
      None => match default_val {
        Some(d) => d,
        None => 0
      }
    }
  }
  assert(get_or(Some(10)) == 10)
  assert(get_or(None) == 42)
}

test "closure captures array" {
  let items = [10, 20, 30]
  let get_item = (i: Int) -> Int { items[i] }
  assert(get_item(0) == 10)
  assert(get_item(1) == 20)
  assert(get_item(2) == 30)
}

test "nested closures deep" {
  let x = 1
  let f = () -> (() -> (() -> Int)) {
    let y = 2
    () -> (() -> Int) {
      let z = 3
      () -> Int { x + y + z }
    }
  }
  assert(f()()() == 6)
}

test "closure in fold" {
  let offset = 100
  let result = Array::fold([1, 2, 3, 4, 5], 0, (acc, x) -> acc + x + offset)
  assert(result == 515)
}

test "immediate lambda call" {
  let result = ((x: Int) -> Int { x * 2 })(21)
  assert(result == 42)
}

test "closure over loop iteration var" {
  let b = ArrayBuilder::new()
  let mut i = 0
  while i < 5 {
    let val = i * 10
    ArrayBuilder::push(b, () -> Int { val })
    i += 1
  }
  let fns = ArrayBuilder::freeze(b)
  assert(fns[0]() == 0)
  assert(fns[1]() == 10)
  assert(fns[2]() == 20)
  assert(fns[3]() == 30)
  assert(fns[4]() == 40)
}

test "closure as predicate" {
  let min_val = 3
  let max_val = 7
  let in_range = (x: Int) -> Bool { x >= min_val && x <= max_val }
  let arr = [1, 2, 3, 4, 5, 6, 7, 8, 9]
  let filtered = Array::filter(arr, in_range)
  assert(Array::length(filtered) == 5)
  assert(filtered[0] == 3)
  assert(filtered[4] == 7)
}
