//# Types

module Math {
  export let abs = (x: Int) -> Int { if x < 0 { 0 - x } else { x } }
  export let max = (a: Int, b: Int) -> Int { if a > b { a } else { b } }
  export let min = (a: Int, b: Int) -> Int { if a < b { a } else { b } }
  export let clamp = (x: Int, lo: Int, hi: Int) -> Int {
    if x < lo { lo } else if x > hi { hi } else { x }
  }
}

//# Misc

test "module basic access" {
  assert(Math::abs(-5) == 5)
  assert(Math::abs(5) == 5)
  assert(Math::abs(0) == 0)
}

test "module max/min" {
  assert(Math::max(3, 7) == 7)
  assert(Math::max(7, 3) == 7)
  assert(Math::min(3, 7) == 3)
  assert(Math::min(7, 3) == 3)
}

test "module clamp" {
  assert(Math::clamp(5, 0, 10) == 5)
  assert(Math::clamp(-5, 0, 10) == 0)
  assert(Math::clamp(15, 0, 10) == 10)
}

test "module function composition" {
  let x = Math::abs(Math::min(-3, -7))
  assert(x == 7)
}
