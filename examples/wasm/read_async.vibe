// Real async DATA read: `Stdin::read_char()` (selfhost) compiles to a
// value-returning `vibe.stdin_read_char () -> i64` host import. The async host
// suspends the guest per read and delivers a value — the HTTP-body / stdin
// async-source pattern (docs/spec/wasi-p3-async.md §2.3). Run:
//   tools/async_host/target/debug/vibe-recv-host <wasm>   # -> run() = 42
export fn run() -> Int with Stdin {
  let a = Stdin::read_char()
  let b = Stdin::read_char()
  let c = Stdin::read_char()
  a + b + c
}
