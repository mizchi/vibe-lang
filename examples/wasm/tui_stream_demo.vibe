// Stream-based pseudo TUI demo for wasm component runtime.
// Run:
//   printf 'hello\nworld\n' | just component-run examples/wasm/tui_stream_demo.vibe
//
// Notes:
// - Uses stdin/stdout stream builtins.
// - In many hosts stdin is line-buffered, so input arrives after Enter.
// - This demo avoids alternate-screen so output is visible in all terminals.

let stdin_read: (Int) -> String with { Stdin } = (max_bytes) -> {
  {
    Stdin::read_stream(max_bytes)
  }
}

let stdout_write: (String) -> Unit with { Stdout } = (s) -> {
  {
    Stdout::write_stream(s)
  }
}

let stdout_writeln: (String) -> Unit with { Stdout } = (s) -> {
  {
    Stdout::write_stream(s)
    Stdout::write_char(10)
  }
}

let main: () -> Int with { Stdin, Stdout } = () -> {
  {
    // Read first byte to suppress duplicate output when host invokes twice.
    let first = Stdin::read_char()
    if first < 0 {
      0
    } else {
      stdout_writeln("vibe stream tui demo")
      stdout_writeln("input is read in chunks from stdin")
      stdout_writeln("")
      stdout_write("input> ")
      Stdout::write_char(first)
      let chunk = stdin_read(127)
      stdout_writeln("")
      stdout_writeln("")
      stdout_writeln("last chunk:")
      stdout_write("> ")
      Stdout::write_char(first)
      stdout_write(chunk)
      stdout_writeln("")
      stdout_writeln("")
      stdout_writeln("send multiple lines to observe redraw")
      0
    }
  }
}

main()
