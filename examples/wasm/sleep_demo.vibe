// Sleep demo for WASM host runtime
// Compile: just run compile --wasm examples/sleep_demo.vibe -o /tmp/sleep_demo.wasm
// Run: tools/async_host/target/release/vibe-async-host /tmp/sleep_demo.wasm

// Simple sleep test - sleeps for 100ms
fn sleep_test() -> Int with Async {
  sleep(100)
  42
}

// Sleep twice
fn sleep_twice() -> Int with Async {
  sleep(50)
  sleep(50)
  1
}

// Sleep with computation
fn sleep_and_compute(x: Int) -> Int with Async {
  sleep(10)
  x * 2
}

// Main entry point
{
  let r1 = sleep_test()
  let r2 = sleep_twice()
  let r3 = sleep_and_compute(21)
  r1 + r2 + r3
}
