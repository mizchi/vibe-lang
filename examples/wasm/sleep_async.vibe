// Real async vibe program: `sleep(ms)` (Async) compiles to a `vibe.sleep` host
// import. Run with the async host so the call genuinely suspends/resumes the
// guest fiber (docs/spec/wasi-p3-async.md §2.3):
//   vibe compile (selfhost) -> core wasm importing vibe.sleep
//   tools/async_host/target/debug/vibe-sleep-host <wasm>   # -> run() = 42
export fn run() -> Int with Async {
  sleep(20)
  42
}
