//# Misc

test "deeply nested if-else" {
  let classify = (n: Int) -> String {
    if n < 0 {
      "negative"
    } else if n == 0 {
      "zero"
    } else if n < 10 {
      "small"
    } else if n < 100 {
      "medium"
    } else {
      "large"
    }
  }
  assert(classify(-1) == "negative")
  assert(classify(0) == "zero")
  assert(classify(5) == "small")
  assert(classify(50) == "medium")
  assert(classify(100) == "large")
}

test "match on boolean" {
  let to_str = (b: Bool) -> String {
    match b {
      true => "yes",
      false => "no"
    }
  }
  assert(to_str(true) == "yes")
  assert(to_str(false) == "no")
}

test "match on int literal" {
  let day = (n: Int) -> String {
    match n {
      1 => "mon",
      2 => "tue",
      3 => "wed",
      _ => "other"
    }
  }
  assert(day(1) == "mon")
  assert(day(3) == "wed")
  assert(day(7) == "other")
}

test "nested option" {
  let x: Option[Option[Int]] = Some(Some(42))
  let result = match x {
    Some(Some(n)) => n,
    Some(None) => -1,
    None => -2
  }
  assert(result == 42)
}

test "option chain with match" {
  let x: Option[Int] = Some(5)
  let y: Option[Int] = None
  let sum = match (x, y) {
    (Some(a), Some(b)) => a + b,
    (Some(a), None) => a,
    (None, Some(b)) => b,
    (None, None) => 0
  }
  assert(sum == 5)
}

test "string equality" {
  let a = "hello"
  let b = "hello"
  let c = "world"
  assert(a == b)
  assert(a != c)
}

test "empty string" {
  let s = ""
  assert(String::length(s) == 0)
  assert(s == "")
}

test "large integer arithmetic" {
  let a = 1000000
  let b = 2000000
  assert(a + b == 3000000)
  assert(a * 3 == 3000000)
}

test "modulo negative" {
  // Test modulo behavior with negative numbers
  let x = -7 % 3
  // MoonBit/vibe follows truncated division (like C)
  assert(x == -1 || x == 2) // implementation-defined
}

test "boolean operators" {
  assert(true && true)
  assert(not(true && false))
  assert(true || false)
  assert(not(false || false))
  assert(not(false))
  assert(!false)
}

test "comparison chaining" {
  let x = 5
  let in_range = x >= 0 && x <= 10
  assert(in_range)
  let out_range = x < 0 || x > 10
  assert(not(out_range))
}

test "unit value" {
  let u = ()
  assert(u == ())
}

test "if as expression with complex bodies" {
  let x = 5
  let result = if x > 0 {
    let a = x * x
    a + 1
  } else {
    let b = 0 - x
    b * b
  }
  assert(result == 26)
}
