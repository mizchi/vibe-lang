// ============================================================
// cheatsheet_types_test.vibe
// Tests type definitions and data manipulation based solely
// on docs/cheatsheet.md
// ============================================================

//# Types

// 1. Type alias
type Pair = (Int, Int)

// 2a. Enum with no payload
enum Color { Red; Green; Blue } derive(Eq)

// 2b. Enum with payload
enum Shape { Circle(Int); Rect(Int, Int); Empty }

// 2c. Generic enum
enum Maybe[T] { Just(T); Nothing }

// 3. Struct with derive(Eq)
struct Point { x: Int; y: Int } derive(Eq)

//# Tests

// --- 1. Type alias ---
test "type alias" {
  let p: Pair = (10, 20)
  assert_eq(p.0, 10)
  assert_eq(p.1, 20)
}

// --- 2a. Enum with no payload ---
test "enum no payload" {
  let c = Green
  let result = match c {
    Red => 0,
    Green => 1,
    Blue => 2,
  }
  assert_eq(result, 1)
}

// --- 2b. Enum with payload ---
test "enum with payload" {
  let s = Circle(5)
  let area = match s {
    Circle(r) => r * r,
    Rect(w, h) => w * h,
    Empty => 0,
  }
  assert_eq(area, 25)
}

// --- 2c. Generic enum ---
test "generic enum" {
  let x = Just(42)
  let y: Maybe[Int] = Nothing
  let get_or = (m: Maybe[Int], default: Int) -> Int {
    match m {
      Just(v) => v,
      Nothing => default,
    }
  }
  assert_eq(get_or(x, 0), 42)
  assert_eq(get_or(y, 99), 99)
}

// --- 3. Struct with derive(Eq), literal, field access, pattern ---
test "struct literal and field access" {
  let p = Point::{ x: 3, y: 4 }
  assert_eq(p.x, 3)
  assert_eq(p.y, 4)
}

test "struct derive Eq" {
  let a = Point::{ x: 1, y: 2 }
  let b = Point::{ x: 1, y: 2 }
  assert_eq(a, b)
}

test "struct pattern" {
  let p = Point::{ x: 10, y: 20 }
  let Point::{ x, y } = p
  assert_eq(x, 10)
  assert_eq(y, 20)
}

test "struct pattern in match" {
  let p = Point::{ x: 5, y: 7 }
  let sum = match p {
    Point::{ x, y } => x + y,
    _ => 0,
  }
  assert_eq(sum, 12)
}

// --- 4. Tuple creation, index, destructuring ---
test "tuple creation and index" {
  let t = (1, "two", true)
  assert_eq(t.0, 1)
  assert_eq(t.1, "two")
  assert_eq(t.2, true)
}

test "tuple destructuring" {
  let (a, b, c) = (10, 20, 30)
  assert_eq(a, 10)
  assert_eq(b, 20)
  assert_eq(c, 30)
}

// --- 5. Record creation and field access ---
test "record creation and field access" {
  let r = record { name: "vibe", ver: 1 }
  assert_eq(r.name, "vibe")
  assert_eq(r.ver, 1)
}

// --- 6. Map creation and index access ---
test "map creation and index" {
  let m = map { "key": 42 }
  assert_eq(m["key"], 42)
}

// --- 7. Array operations ---
test "array create and index" {
  let a = [1, 2, 3]
  assert_eq(a[0], 1)
  assert_eq(a[1], 2)
  assert_eq(a[2], 3)
}

test "array for-in" {
  let arr = [1, 2, 3]
  let doubled = for x in arr { x * 2 }
  assert_eq(doubled, [2, 4, 6])
}

test "array pipe with length" {
  let arr = [10, 20, 30]
  let len = arr |> Array::length
  assert_eq(len, 3)
}

test "array map" {
  let arr = [1, 2, 3]
  let doubled = Array::map(arr, x -> x * 2)
  assert_eq(doubled, [2, 4, 6])
}

// --- 8. Nested pattern matching ---
test "nested pattern enum in tuple" {
  let t = (Some(42), "hello")
  let result = match t {
    (Some(v), _) => v,
    _ => 0,
  }
  assert_eq(result, 42)
}

test "nested pattern struct in option" {
  let opt = Some(Point::{ x: 10, y: 20 })
  let result = match opt {
    Some(p) => p.x + p.y,
    None => 0,
  }
  assert_eq(result, 30)
}

// --- 9. Or-pattern and guard in match ---
test "or-pattern" {
  let classify = (c: Color) -> String {
    match c {
      Red | Blue => "not green",
      Green => "green",
    }
  }
  assert_eq(classify(Red), "not green")
  assert_eq(classify(Blue), "not green")
  assert_eq(classify(Green), "green")
}

test "match guard" {
  let classify = (x: Int) -> String {
    match x {
      x if x > 0 => "positive",
      0 => "zero",
      _ => "negative",
    }
  }
  assert_eq(classify(5), "positive")
  assert_eq(classify(0), "zero")
  assert_eq(classify(-3), "negative")
}

// --- 10. is expression ---
test "is expression with binding" {
  let opt: Option[Int] = Some(42)
  let result = if opt is Some(v) { v } else { 0 }
  assert_eq(result, 42)
}

test "is expression bool" {
  let opt: Option[Int] = None
  assert_eq(opt is None, true)
  assert_eq(opt is Some(_), false)
}
