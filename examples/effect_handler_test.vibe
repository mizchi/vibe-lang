//# Effects

effect State {
  Get() -> Int;
  Set(Int) -> Unit
}

effect Logger {
  Log(String) -> Unit
}

effect Reader {
  Read() -> String
}

//# Functions

let stateful_inc: () -> Int with { State } = () -> {
  let current = perform State::Get()
  perform State::Set(current + 1)
  current + 1
}

let log_msg: (String) -> Unit with { Logger } = (msg) -> {
  perform Logger::Log(msg)
}

//# Misc

test "state effect get/set" {
  let mut state = 0
  let result = handle {
    perform State::Set(10)
    perform State::Get()
  } {
    State::Get() => { resume(state) },
    State::Set(v) => { state = v; resume(()) }
  }
  assert(result == 10)
  assert(state == 10)
}

test "state effect increment" {
  let mut state = 0
  let result = handle {
    stateful_inc()
  } {
    State::Get() => { resume(state) },
    State::Set(v) => { state = v; resume(()) }
  }
  assert(result == 1)
  assert(state == 1)
}

test "state effect multiple operations" {
  let mut state = 0
  handle {
    perform State::Set(5)
    let a = perform State::Get()
    perform State::Set(a * 2)
    let b = perform State::Get()
    assert(b == 10)
  } {
    State::Get() => { resume(state) },
    State::Set(v) => { state = v; resume(()) }
  }
}

test "logger effect collect messages" {
  let mut logs = ArrayBuilder::new()
  handle {
    log_msg("hello")
    log_msg("world")
    log_msg("!")
  } {
    Logger::Log(msg) => {
      ArrayBuilder::push(logs, msg)
      resume(())
    }
  }
  let result = ArrayBuilder::freeze(logs)
  assert(Array::length(result) == 3)
  assert(result[0] == "hello")
  assert(result[1] == "world")
  assert(result[2] == "!")
}

test "nested effect handlers" {
  let mut state = 0
  let mut logs = ArrayBuilder::new()
  handle {
    handle {
      perform State::Set(42)
      perform Logger::Log("set to 42")
      let v = perform State::Get()
      perform Logger::Log("got \(v)")
    } {
      State::Get() => { resume(state) },
      State::Set(v) => { state = v; resume(()) }
    }
  } {
    Logger::Log(msg) => {
      ArrayBuilder::push(logs, msg)
      resume(())
    }
  }
  assert(state == 42)
  let log_arr = ArrayBuilder::freeze(logs)
  assert(Array::length(log_arr) == 2)
}

suberror KeyNotFound(String)
suberror KeyInvalid(String)

test "error with suberror types" {
  let lookup: (String) -> Int with { Error } = (key) -> {
    if key == "" { throw(KeyInvalid("empty key")) }
    if key == "missing" { throw(KeyNotFound(key)) }
    42
  }

  let r1 = handle { lookup("ok") } { Error(_) => -1 }
  assert(r1 == 42)

  let r2 = handle { lookup("") } { Error(_) => -1 }
  assert(r2 == -1)

  let r3 = handle { lookup("missing") } { Error(_) => -1 }
  assert(r3 == -1)
}

test "error ? propagation chain" {
  let step1: (Int) -> Int with { Error } = (x) -> {
    if x < 0 { throw("negative") }
    x + 10
  }
  let step2: (Int) -> Int with { Error } = (x) -> {
    let a = step1(x)?
    let b = step1(a)?
    a + b
  }
  let ok = handle { step2(5) } { Error(_) => -1 }
  assert(ok == 40)
  let err = handle { step2(-1) } { Error(_) => -1 }
  assert(err == -1)
}

test "handle returns value on success" {
  let f: () -> Int with { Error } = () -> 42
  let result = handle { f() } { Error(_) => 0 }
  assert(result == 42)
}

test "reader effect" {
  let inputs = ["hello", "world"]
  let mut idx = 0
  let result = handle {
    let a = perform Reader::Read()
    let b = perform Reader::Read()
    a + " " + b
  } {
    Reader::Read() => {
      let v = inputs[idx]
      idx += 1
      resume(v)
    }
  }
  assert(result == "hello world")
}

test "effect handler with loop" {
  let mut state = 0
  handle {
    let mut i = 0
    while i < 5 {
      let cur = perform State::Get()
      perform State::Set(cur + i)
      i += 1
    }
  } {
    State::Get() => { resume(state) },
    State::Set(v) => { state = v; resume(()) }
  }
  assert(state == 10)
}

test "error in match arm" {
  let process: (Option[Int]) -> Int with { Error } = (opt) -> {
    match opt {
      Some(x) if x > 0 => x * 2,
      Some(_) => throw("non-positive"),
      None => throw("missing")
    }
  }
  let r1 = handle { process(Some(5)) } { Error(_) => -1 }
  assert(r1 == 10)
  let r2 = handle { process(Some(-1)) } { Error(_) => -1 }
  assert(r2 == -1)
  let r3 = handle { process(None) } { Error(_) => -1 }
  assert(r3 == -1)
}
