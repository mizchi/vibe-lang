//# Functions

// might_fail: (Int) -> Int with {Error}
let might_fail: (Int) -> Int with { Error } = (x) -> {
  if x == 0 {
    throw("zero error")
  } else x
}

//# Misc

test "handle error recovery" {
  let result = handle {
    might_fail(0)
  } {
    Error(_) => 99
  }
  assert(result == 99)
}

test "handle success passthrough" {
  let result = handle {
    might_fail(42)
  } {
    Error(_) => 0
  }
  assert(result == 42)
}

test "throw and handle" {
  let safe_div = (a: Int, b: Int) -> Int {
    handle {
      if b == 0 {
        throw("div by zero")
        0
      } else a / b
    } {
      Error(_) => -1
    }
  }
  assert(safe_div(10, 2) == 5)
  assert(safe_div(10, 0) == -1)
}

test "nested handle" {
  let inner = () -> Int with { Error } {
    throw("inner")
    0
  }
  let outer = handle {
    handle {
      inner()
    } {
      Error(_) => 42
    }
  } {
    Error(_) => 0
  }
  assert(outer == 42)
}

test "error does not propagate past handle" {
  let f = () -> Int with { Error } {
    throw("oops")
    0
  }
  let result = handle {
    f() + 10
  } {
    Error(_) => 100
  }
  assert(result == 100)
}
