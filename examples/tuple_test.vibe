//# Misc

test "tuple 2-element" {
  let t = (1, 2)
  assert(t.0 == 1)
  assert(t.1 == 2)
}

test "tuple 3-element" {
  let t = (10, "hello", true)
  assert(t.0 == 10)
  assert(t.1 == "hello")
  assert(t.2 == true)
}

test "tuple 4-element" {
  let t = (1, 2, 3, 4)
  assert(t.0 == 1)
  assert(t.3 == 4)
}

test "tuple destructuring 2" {
  let (a, b) = (42, 99)
  assert(a == 42)
  assert(b == 99)
}

test "tuple destructuring 3" {
  let (x, y, z) = (1, 2, 3)
  assert(x + y + z == 6)
}

test "tuple in function return" {
  let swap = (a: Int, b: Int) -> (Int, Int) { (b, a) }
  let (x, y) = swap(1, 2)
  assert(x == 2)
  assert(y == 1)
}

test "tuple comparison" {
  assert((1, 2) == (1, 2))
  assert((1, 2) != (2, 1))
  assert((1, "a") == (1, "a"))
}

test "nested tuple" {
  let t = ((1, 2), (3, 4))
  assert(t.0.0 == 1)
  assert(t.0.1 == 2)
  assert(t.1.0 == 3)
  assert(t.1.1 == 4)
}

test "tuple as function arg" {
  let sum_pair = (p: (Int, Int)) -> Int { p.0 + p.1 }
  assert(sum_pair((3, 4)) == 7)
}

test "tuple with Option" {
  let t: (Int, Option[Int]) = (1, Some(2))
  assert(t.0 == 1)
  let v = match t.1 {
    Some(x) => x,
    None => 0
  }
  assert(v == 2)
}
