//# Types

enum Shape {
  Circle(Int)
  Rect(Int, Int)
  Triangle(Int, Int, Int)
}

//# Misc

test "is expression with binding" {
  let x: Option[Int] = Some(42)
  let result = if x is Some(v) { v } else { 0 }
  assert(result == 42)
}

test "is expression false case" {
  let x: Option[Int] = None
  let result = if x is Some(v) { v } else { -1 }
  assert(result == -1)
}

test "is expression as boolean" {
  let x: Option[Int] = Some(1)
  let y: Option[Int] = None
  assert(x is Some(_))
  assert(y is None)
}

test "is expression with enum" {
  let s = Circle(5)
  let area = if s is Circle(r) { r * r * 3 } else { 0 }
  assert(area == 75)
}

test "is expression enum negative" {
  let s = Rect(3, 4)
  assert(not(s is Circle(_)))
}

test "is in while condition" {
  let items: Array[Option[Int]] = [Some(1), Some(2), None, Some(4)]
  let mut sum = 0
  let mut i = 0
  while i < Array::length(items) {
    if items[i] is Some(v) {
      sum += v
    }
    i += 1
  }
  assert(sum == 7)
}
