//# Misc

test "let mut basic" {
  let mut x = 0
  x = 42
  assert(x == 42)
}

test "let mut increment" {
  let mut count = 0
  count += 1
  count += 1
  count += 1
  assert(count == 3)
}

test "let mut in while" {
  let mut i = 0
  let mut sum = 0
  while i < 10 {
    sum += i
    i += 1
  }
  assert(sum == 45)
  assert(i == 10)
}

test "let mut reassign" {
  let mut s = "hello"
  s = "world"
  assert(s == "world")
}

test "let mut with array" {
  let mut total = 0
  let arr = [
    1,
    2,
    3,
    4,
    5
  ]
  let mut idx = 0
  while idx < Array::length(arr) {
    total += arr[idx]
    idx += 1
  }
  assert(total == 15)
}

test "nested mut scopes" {
  let mut a = 1
  let result = {
    let mut b = 10
    b += a
    b
  }
  assert(result == 11)
  assert(a == 1)
}

test "mut in if branches" {
  let mut x = 0
  if true {
    x = 10
  } else {
    x = 20
  }
  assert(x == 10)
}

test "mut accumulator pattern" {
  let mut product = 1
  let mut i = 1
  while i <= 5 {
    product = product * i
    i += 1
  }
  assert(product == 120)
}

test "mut string builder pattern" {
  let sb = StringBuilder::new()
  StringBuilder::push(sb, "hello")
  StringBuilder::push(sb, " ")
  StringBuilder::push(sb, "world")
  let result = StringBuilder::freeze(sb)
  assert(result == "hello world")
}

test "mut flag pattern" {
  let arr = [
    3,
    1,
    4,
    1,
    5
  ]
  let mut found = false
  let mut idx = 0
  while idx < Array::length(arr) {
    if arr[idx] == 4 {
      found = true
    } else ()
    idx += 1
  }
  assert(found)
}
