//# Misc

test "loop as expression with break value" {
  let result = loop (i = 0) {
    if i >= 5 { break(i * 10) }
    continue(i + 1)
  }
  assert(result == 50)
}

test "loop three params" {
  let result = loop (i = 0, sum = 0, product = 1) {
    if i >= 5 { break((sum, product)) }
    continue(i + 1, sum + i, product * (i + 1))
  }
  assert(result.0 == 10)
  assert(result.1 == 120)
}

test "loop with string accumulation" {
  let result = loop (i = 0, acc = "") {
    if i >= 3 { break(acc) }
    continue(i + 1, acc + Int::to_string(i))
  }
  assert(result == "012")
}

test "loop fibonacci" {
  let fib = loop (n = 10, a = 0, b = 1) {
    if n == 0 { break(a) }
    continue(n - 1, b, a + b)
  }
  assert(fib == 55)
}

test "loop gcd" {
  let gcd = loop (a = 48, b = 18) {
    if b == 0 { break(a) }
    continue(b, a % b)
  }
  assert(gcd == 6)
}

test "loop early break" {
  let result = loop (i = 0) {
    if i == 0 { break(42) }
    continue(i + 1)
  }
  assert(result == 42)
}

test "loop with array building" {
  let b = ArrayBuilder::new()
  loop (i = 1) {
    if i > 5 { break }
    ArrayBuilder::push(b, i * i)
    continue(i + 1)
  }
  let arr = ArrayBuilder::freeze(b)
  assert(Array::length(arr) == 5)
  assert(arr[0] == 1)
  assert(arr[1] == 4)
  assert(arr[2] == 9)
  assert(arr[3] == 16)
  assert(arr[4] == 25)
}

test "loop power" {
  let pow = loop (base = 2, exp = 10, acc = 1) {
    if exp == 0 { break(acc) }
    continue(base, exp - 1, acc * base)
  }
  assert(pow == 1024)
}

test "loop count digits" {
  let digits = loop (n = 12345, count = 0) {
    if n == 0 { break(count) }
    continue(n / 10, count + 1)
  }
  assert(digits == 5)
}

test "loop with option result" {
  let find_first_even: (Array[Int]) -> Option[Int] = (arr) -> {
    loop (i = 0) {
      if i >= Array::length(arr) { break(None) }
      if arr[i] % 2 == 0 { break(Some(arr[i])) }
      continue(i + 1)
    }
  }
  assert(find_first_even([1, 3, 4, 6]) == Some(4))
  assert(find_first_even([1, 3, 5]) == None)
}

test "nested while with break" {
  let mut found_i = -1
  let mut found_j = -1
  let mut i = 0
  while i < 5 {
    let mut j = 0
    while j < 5 {
      if i * 5 + j == 13 {
        found_i = i
        found_j = j
        break
      }
      j += 1
    }
    if found_i >= 0 { break }
    i += 1
  }
  assert(found_i == 2)
  assert(found_j == 3)
}

test "while with compound condition" {
  let mut x = 100
  let mut steps = 0
  while x > 1 && steps < 1000 {
    if x % 2 == 0 {
      x = x / 2
    } else {
      x = x * 3 + 1
    }
    steps += 1
  }
  assert(x == 1)
  assert(steps > 0)
}

// #808: break/continue inside a match arm inside `loop` must get the loop
// desugar (payload threading). Before the fix, `continue(i + 1)` in an arm
// looped without updating `i` (compile-clean infinite loop) and `break v`
// dropped its value.
test "break/continue inside match arm (#808)" {
  let r = loop (i = 0) {
    if i >= 10 { break -1 }
    match i {
      v if v > 2 => break v,
      _ => continue(i + 1)
    }
  }
  assert(r == 3)
}

test "multi-param continue inside match arm (#808)" {
  let r = loop (i = 0, acc = 0) {
    if i >= 5 { break acc }
    match i % 2 {
      0 => continue(i + 1, acc + i),
      _ => continue(i + 1, acc)
    }
  }
  assert(r == 6)
}

test "nested loop keeps its own params under match desugar (#808)" {
  let r = loop (i = 0) {
    if i >= 3 { break i * 10 }
    let inner = loop (j = 0) {
      match j {
        2 => break j,
        _ => continue(j + 1)
      }
    }
    continue(i + inner - 1)
  }
  assert(r == 30)
}
