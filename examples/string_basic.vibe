//# Functions

let s: String = string_concat("he", "llo")

let sub: String = string_substring(s, 1, 4)

let ok: Bool = sub == "ell"

let len: Int = string_length(sub)

let code: Int = string_char_code_at(sub, 0)

//# Misc

test "string length" {
  assert(len == 3)
}

test "string equals" {
  assert(ok)
}

test "string code" {
  assert(code == 101)
}

test "string substring" {
  assert(sub == "ell")
}

test "string_split" {
  let parts = string_split("a,b,c", ",")
  assert(array_length(parts) == 3)
  assert(array_get(parts, 0) == "a")
  assert(array_get(parts, 2) == "c")
}

test "string_index_of" {
  assert(string_index_of("hello", "ll") == 2)
  assert(string_index_of("hello", "xyz") == -1)
}

test "string_contains" {
  assert(string_contains("hello world", "world"))
  assert(not(string_contains("hello", "xyz")))
}

test "string_trim" {
  let trimmed = string_trim("  hello  ")
  assert(trimmed == "hello")
}
