//# Functions

let s: String = String::concat("he", "llo")

let sub: String = String::substring(s, 1, 4)

let ok: Bool = sub == "ell"

let len: Int = String::length(sub)

let code: Int = String::char_code_at(sub, 0)

//# Misc

test "string length" {
  assert(len == 3)
}

test "string equals" {
  assert(ok)
}

test "string code" {
  assert(code == 101)
}

test "string substring" {
  assert(sub == "ell")
}

test "String::split" {
  let parts = String::split("a,b,c", ",")
  assert(Array::length(parts) == 3)
  assert(Array::get(parts, 0) == "a")
  assert(Array::get(parts, 2) == "c")
}

test "String::index_of" {
  assert(String::index_of("hello", "ll") == 2)
  assert(String::index_of("hello", "xyz") == -1)
}

test "String::contains" {
  assert(String::contains("hello world", "world"))
  assert(not(String::contains("hello", "xyz")))
}

test "String::trim" {
  let trimmed = String::trim("  hello  ")
  assert(trimmed == "hello")
}

test "string slice s[i:j]" {
  let s = "hello"
  assert(s[1: 4] == "ell")
}

test "string slice s[:j]" {
  let s = "hello"
  assert(s[: 3] == "hel")
}

test "string slice s[i:]" {
  let s = "hello"
  assert(s[2:] == "llo")
}

test "raw string no escape" {
  let s = "hello\\nworld"
  assert(String::length(s) == 12)
}

test "string == equality" {
  assert("hello" == "hello")
  assert(not("hello" == "world"))
  let a = "foo"
  let b = "foo"
  assert(a == b)
}

test "string != inequality" {
  assert("hello" != "world")
  assert(not("hello" != "hello"))
  let a = "bar"
  let b = "baz"
  assert(a != b)
}

test "String::join" {
  let parts = [
    "hello",
    "world",
    "vibe"
  ]
  let joined = String::join(parts, ", ")
  assert(joined == "hello, world, vibe")
  let empty_join = String::join([
  ], "-")
  assert(empty_join == "")
  let single = String::join([
    "only"
  ], ",")
  assert(single == "only")
}

test "String::to_upper" {
  assert(String::to_upper("hello") == "HELLO")
  assert(String::to_upper("Hello World") == "HELLO WORLD")
  assert(String::to_upper("") == "")
  assert(String::to_upper("ABC") == "ABC")
}

test "String::to_lower" {
  assert(String::to_lower("HELLO") == "hello")
  assert(String::to_lower("Hello World") == "hello world")
  assert(String::to_lower("") == "")
  assert(String::to_lower("abc") == "abc")
}

test "String::split edge cases" {
  let empty_parts = String::split("", ",")
  assert(Array::length(empty_parts) == 1)
  assert(Array::get(empty_parts, 0) == "")
  let no_sep = String::split("hello", ",")
  assert(Array::length(no_sep) == 1)
  assert(Array::get(no_sep, 0) == "hello")
}
