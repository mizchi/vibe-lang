// ==========================================================
// Cheat Sheet Evaluation Test
// Exercises as many vibe language features as possible,
// written solely from docs/cheatsheet.md
// ==========================================================

//# Types

enum Shape {
  Circle(Int);
  Rect(Int, Int)
}

struct Point { x: Int; y: Int }

// --- 1. Basic types ---
test "basic types" {
  let x: Int = 42
  let _f: Float = 1.5f
  let _d: Double = 3.14
  let s: String = "hello"
  let _c: Char = 'A'
  let b: Bool = true
  let _u: Unit = ()
  assert(x == 42)
  assert(b == true)
  assert(s == "hello")
}

// --- 2. let / let mut / let rec ---
test "let and let mut" {
  let x = 10
  let mut y = 0
  y += x
  assert(y == 10)
}

test "let rec" {
  let rec fact = (n: Int) -> Int {
    if n < 2 { 1 } else { n * fact(n - 1) }
  }
  assert(fact(5) == 120)
}

// --- 3. Generic functions with trait bounds ---
test "generic function" {
  let identity = [T](x: T) -> T { x }
  assert(identity(42) == 42)
  assert(identity("hi") == "hi")
}

// --- 4. Pipe operator ---
test "pipe operator" {
  let a = [1, 2, 3]
  let len = a |> Array::length
  assert(len == 3)
}

// --- 5. Pattern matching ---
test "match with guard" {
  let classify = (x: Int) -> String {
    match x {
      x if x > 0 => "positive",
      0 => "zero",
      _ => "negative",
    }
  }
  assert(classify(5) == "positive")
  assert(classify(0) == "zero")
  assert(classify(-3) == "negative")
}

// or-pattern tested below using Shape enum

test "is expression" {
  let opt = Some(42)
  let result = if opt is Some(v) { v } else { 0 }
  assert(result == 42)

  let is_none = opt is None
  assert(is_none == false)
}

test "destructuring let tuple" {
  let (a, b) = (1, 2)
  assert(a == 1)
  assert(b == 2)
}

// --- 6. Enum definition with payloads + matching ---
test "enum with payloads" {
  let area = (s: Shape) -> Int {
    match s {
      Circle(r) => r * r * 3,
      Rect(w, h) => w * h,
    }
  }
  assert(area(Shape::Circle(2)) == 12)
  assert(area(Shape::Rect(3, 4)) == 12)
}

// --- 7. Struct definition + field access + struct pattern ---
test "struct field access" {
  let p = Point::{ x: 3, y: 4 }
  assert(p.x == 3)
  assert(p.y == 4)
}

test "struct pattern" {
  let p = Point::{ x: 10, y: 20 }
  let Point::{ x, y } = p
  assert(x == 10)
  assert(y == 20)
}

// --- 8. for-in loop (collecting into array) ---
test "for-in loop" {
  let arr = [1, 2, 3]
  let doubled = for x in arr { x * 2 }
  assert(doubled[0] == 2)
  assert(doubled[1] == 4)
  assert(doubled[2] == 6)
}

test "for-in with index" {
  let arr = [10, 20, 30]
  let indexed = for i, x in arr { i + x }
  assert(indexed[0] == 10)
  assert(indexed[1] == 21)
  assert(indexed[2] == 32)
}

// --- 9. while loop with mut ---
test "while loop" {
  let mut sum = 0
  let mut i = 1
  while i <= 10 {
    sum += i
    i += 1
  }
  assert(sum == 55)
}

// --- 10. loop with break/continue ---
test "loop with break and continue" {
  let mut result = 0
  loop (i = 0, sum = 0) {
    if i >= 10 { result = sum; break }
    continue(i + 1, sum + i)
  }
  assert(result == 45)
}

// --- 11. Error effects: throw + handle ---
test "error effects" {
  let risky = (x: Int) -> Int with { Error } {
    if x == 0 { throw("division by zero") }
    100 / x
  }
  let safe = handle { risky(0) } { Error(_msg) => -1 }
  assert(safe == -1)
  let ok = handle { risky(10) } { Error(_msg) => -1 }
  assert(ok == 10)
}

// --- 12. ? operator ---
test "question mark operator" {
  let risky = (x: Int) -> Int with { Error } {
    if x == 0 { throw("oops") }
    x * 10
  }
  let wrapper = (x: Int) -> Int with { Error } {
    let v = risky(x)?
    v + 1
  }
  let result = handle { wrapper(5) } { Error(_) => -1 }
  assert(result == 51)
  let fail = handle { wrapper(0) } { Error(_) => -1 }
  assert(fail == -1)
}

// --- 13. String interpolation ---
test "string interpolation" {
  let name = "vibe"
  let greeting = "hello \(name)"
  assert(greeting == "hello vibe")
  let x = 42
  let s = "val=\(x)"
  assert(s == "val=42")
}

// --- 14. Array, Tuple, Record, Map usage ---
test "array operations" {
  let a = [1, 2, 3]
  assert(a[0] == 1)
  assert(Array::length(a) == 3)
  let mapped = Array::map(a, _ * 2)
  assert(mapped[0] == 2)
  assert(mapped[1] == 4)
  assert(mapped[2] == 6)
}

test "tuple access" {
  let t = (1, "two", true)
  assert(t.0 == 1)
  assert(t.1 == "two")
  assert(t.2 == true)
}

test "record" {
  let r = record { name: "vibe", ver: 1 }
  assert(r.name == "vibe")
  assert(r.ver == 1)
}

test "map" {
  let m = map { "key": 42 }
  assert(m["key"] == 42)
}

// --- 15. Builder pattern (ArrayBuilder) ---
test "array builder" {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, 10)
  ArrayBuilder::push(b, 20)
  ArrayBuilder::push(b, 30)
  let arr = ArrayBuilder::freeze(b)
  assert(arr[0] == 10)
  assert(arr[1] == 20)
  assert(arr[2] == 30)
}

// --- 16. Lambda shorthand (placeholder _) ---
test "lambda shorthand" {
  let xs = [1, 2, 3, 4, 5]
  let evens = Array::filter(xs, _ % 2 == 0)
  assert(evens[0] == 2)
  assert(evens[1] == 4)
  assert(Array::length(evens) == 2)
  let sum = Array::fold(xs, 0, _ + _)
  assert(sum == 15)
}

// --- 17. test blocks with assert (this whole file is test blocks) ---
test "assert sanity" {
  assert(1 + 1 == 2)
}

// --- Bonus: if expression ---
test "if expression" {
  let v = if true { 1 } else { 2 }
  assert(v == 1)
}
