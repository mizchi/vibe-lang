//# Misc

test "if else basic" {
  let x = if true {
    1
  } else 2
  assert(x == 1)
  let y = if false {
    1
  } else 2
  assert(y == 2)
}

test "if else chain" {
  let classify = (n: Int) -> String {
    if n > 0 {
      "pos"
    } else if n == 0 {
      "zero"
    } else "neg"
  }
  assert(classify(5) == "pos")
  assert(classify(0) == "zero")
  assert(classify(-3) == "neg")
}

test "while loop" {
  let mut i = 0
  let mut sum = 0
  while i < 5 {
    sum += i
    i += 1
  }
  assert(sum == 10)
}

test "while countdown" {
  let mut n = 10
  while n > 0 {
    n = n - 1
  }
  assert(n == 0)
}

test "match int" {
  let x = 42
  let result = match x {
    0 => "zero",
    42 => "answer",
    _ => "other"
  }
  assert(result == "answer")
}

test "match wildcard" {
  let x = 999
  let result = match x {
    _ => "always"
  }
  assert(result == "always")
}

test "match bool" {
  let result = match true {
    true => 1,
    false => 0
  }
  assert(result == 1)
}

test "match string" {
  let s = "hello"
  let result = match s {
    "hello" => 1,
    "world" => 2,
    _ => 0
  }
  assert(result == 1)
}

test "match or pattern" {
  let x = 2
  let result = match x {
    1|2|3 => "small",
    _ => "big"
  }
  assert(result == "small")
}

test "nested match" {
  let x = Some(42)
  let result = match x {
    Some(n) => match n {
      42 => "found",
      _ => "other"
    },
    _ => "none"
  }
  assert(result == "found")
}

test "match as expression" {
  let msg = match 3 % 2 {
    0 => "even",
    _ => "odd"
  }
  assert(msg == "odd")
}

test "for-in produces array" {
  let arr = [
    1,
    2,
    3
  ]
  let result = for x in arr {
    x + 10
  }
  assert(result[0] == 11)
  assert(result[1] == 12)
  assert(result[2] == 13)
}

test "block expression" {
  let val = {
    let a = 10
    let b = 20
    a + b
  }
  assert(val == 30)
}
