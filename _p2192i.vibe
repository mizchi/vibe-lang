fn mk2(a: Int, b: Int) -> Array[Int] {
  [a, b]
}

fn main with Console {
  let v = 1
  let flag = true

  // (a) inner shadow bound by an `if` (Codex's shape), element = Array[Int]
  let as1 = []
  let as2 = []
  let v = if flag { mk2(1, 2) } else { mk2(3, 4) }
  Array::push(as1, v)
  let v = if flag { mk2(1, 2) } else { mk2(3, 4) }
  Array::push(as2, v)
  println("if-shadow nested   = \{as1 == as2}")

  // (b) closure parameter shadowing the outer Int, element = Array[Int]
  let bs1 = []
  let bs2 = []
  let f = (v: Array[Int]) -> Unit { Array::push(bs1, v) }
  let g = (v: Array[Int]) -> Unit { Array::push(bs2, v) }
  f(mk2(1, 2))
  g(mk2(1, 2))
  println("closure-param nest = \{bs1 == bs2}")

  // control: the same, with different content -- must be false
  let cs1 = []
  let cs2 = []
  let h = (v: Array[Int]) -> Unit { Array::push(cs1, v) }
  let k = (v: Array[Int]) -> Unit { Array::push(cs2, v) }
  h(mk2(1, 2))
  k(mk2(9, 9))
  println("differ control     = \{cs1 == cs2}")
}
