    if [ "$test_backend" = "gc" ] || [ "$t_exact" = "0" ]; then
      echo "[vibe-test] $t_pass passed, $t_fail failed ($total_files files)"
    else
      echo "[vibe-test] $t_pass passed, $t_fail failed ($total_files files, $t_tests tests)"
      if [ "$t_notest" -gt 0 ]; then
        echo "[vibe-test] note: $t_notest file(s) with no tests found"
      fi
