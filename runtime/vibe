#!/usr/bin/env bash
# vibe — host launcher. Argument parsing and compiler work live in lib/@vibe/cli.
#
# `vibe help` prints the block below (content-anchored: from `# Subcommands:`
# to the `vibe help` line), with no compiler wasm and no runner -- explaining
# a command is the one thing that has to keep working when the toolchain does
# not. docs/user/reference/cli-commands.md names this as the authoritative
# command list, so a new verb is documented HERE.
#
# Subcommands:
#   vibe run     <file.vibex> [-- args]   compile fixed `main`, then run
#   vibe run --trace <file.vibex>         run + print the function-call trace
#                                         (each entry annotated with file:line)
#   vibe run --break <fn>[,<fn>...] <file.vibex>
#                                         pause at each named function's entry,
#                                         print the call stack, then continue.
#                                         At a pause type a step command (stdin):
#                                           s/step  = step into next function
#                                           n/next  = step over (same/shallower)
#                                           o/finish= finish current frame
#                                           c/empty = continue
#                                           q/quit  = abort the run
#   vibe run --mem <file.vibex>           run + report bump-heap usage (peak /
#                                         total allocated) to stderr after exit
#   vibe run --alloc-site[=N] <file.vibex>  run + report per-line alloc
#                                         attribution (top N sites) to stderr
#   vibe profile <file.vibex> [--out FILE] [--interval-us N]
#                                         capture a Wasmtime guest CPU profile
#   vibe compile <file.vibe> [-o <out>]   compile to a .wasm (default:
#                                         .vibe/build/out/<name>.wasm)
#   vibe compile --wit <file.vibe>        emit the WIT world for the file's
#                                         effect surface (docs/internal/design/effect-wit-mapping.md)
#   vibe compile --component <file.vibe>  emit a command component from the
#                                         module's `vibe_command` export
#   vibe build   <file.vibe> [-o <out>]   alias of compile
#   vibe build --debug <file.vibe>        the linked debug lane
#   vibe compile|build --minify ...       post-optimize the output with the
#                                         standalone vibe-opt.wasm artifact
#                                         (scripts/build_vibe_opt.sh, #1107)
#   vibe serve   <handler.vibe> [--port N] compile + compose with the wasi-http
#                                         P3 adapter + `wasmtime serve` (#537)
#   vibe check [--single-file] [--json] <file.vibe>
#                                         parse + typecheck. Diagnostics go to
#                                         stdout, one per line; clean = EMPTY
#                                         output + exit 0, anything reported =
#                                         exit 1. Imports are resolved from the
#                                         FS unless --single-file (buffer scope,
#                                         what an editor with unsaved text
#                                         needs). --json needs --single-file.
#   vibe check --profile-tsv F --profile-callstack F <file.vibe>
#                                         also write the check's timing sidecars
#   vibe type-at <file.vibe> <line> <col> print the inferred type at a position
#   vibe doc-at  <file.vibe> <line> <col> print the `///` doc comment at a position (#854)
#   vibe binding-at <file.vibe> <line> <col> print binding occurrence spans (START END per line)
#   vibe symbols [--with-path] <path>...  print declaration outline (NAME KIND START END [DOC] per line;
#                                       a directory / several paths / --with-path prefix each line with PATH)
#   vibe symbols --legend                 print KIND NAME table (LSP SymbolKind + 27 Test / 28 Bench, v2 2026-09-12)
#   vibe escapes [--strict] <file.vibe>   print the `let mut` bindings a closure
#                                         captures -- the ones codegen boxes into
#                                         a heap ref cell instead of a wasm local
#                                         (NAME START END per line; empty = none)
#   vibe rc-classify <file.vibe>          print RC classifier sets, one
#                                         `NAME SET[,SET...]` line per user
#                                         function (empty = no special sets)
#   vibe rc-plan [--fn NAME] <file.vibe>  print the Perceus plan, one
#                                         `FN BINDING ACTION COUNT` line
#                                         (empty = no actions)
#   vibe allocs <file.vibe>               print possible heap-allocation sites
#                                         (FN KIND OFFSET per line; empty = none)
#   vibe deps [--direct] <file.vibe>      print the resolved import closure, one
#                                         path per line, dependency first (#988).
#                                         The loader's OWN collection (what the
#                                         build compiles), so it cannot drift
#                                         from real resolution. Errors are fatal
#                                         (a truncated list is a wrong answer).
#                                         --direct = one hop only; use it to
#                                         build an index, since a cache over
#                                         direct edges invalidates per file.
#   vibe diagnostics <file.vibe>          DEPRECATED (#1567): use
#                                         `vibe check --single-file`. Kept
#                                         unchanged (raw lines, always exit 0)
#                                         for the editors already on it.
#   vibe grep --pattern '<pat>' [paths]   AST pattern search (#1572). Metavars
#                                         are `$(name:kind)`, kind = exp / id /
#                                         const / arg / args / pat / type.
#                                         Type-aware filters (these resolve
#                                         imports like `vibe check` does):
#                                           --where '$x : Array[Int]'  inferred type
#                                           --where '$f = Iterator::map' resolved name
#                                           --where-row '$f with Async'  effect row
#                                           --only-ill-typed / --only-well-typed
#                                         --json for machine-readable output
#                                         (`vibe grep --help` for the full list)
#   vibe fmt     [--check|--stdout] <file.vibe|file.vpkg>
#                                         format a source file in place with the
#                                         canonical CST-token formatter
#                                         (--check: exit 1 if not formatted;
#                                          --stdout: print, don't write)
#   vibe normalize [--check|--stdout] <file.vibe>
#                                         canonicalize a source file in place
#                                         (--check: exit 1 if not normalized;
#                                          --stdout: print, don't write)
#   vibe test    [--jobs N] <file_test.vibe|dir>...
#                                         compile + run test {} blocks
#                                         (a directory expands to *_test.vibe;
#                                         --jobs N runs N files concurrently)
#   vibe test --update <file_test.vibe|dir>... auto-patch stale inspect(value,
#                                         content) snapshots to the actual
#                                         value on a failing run, then
#                                         recompile+rerun (#1061)
#   vibe bench   <file.vibe> [--iters N] [--warmup N] [--guest-profile DIR]
#                                         run bench {} blocks; report ns/op
#                                         (min/p50/p95/mean), ops/sec, bytes/op
#   vibe shell   [file.vibe]              interactive compiled REPL: declarations
#                                         accumulate, each line recompiles+runs
#                                         (type :help inside for commands)
#   vibe hash    [--write] <pkg_dir|index.vpkg>
#                                         print the package / contract hashes
#                                         (--write: rewrite `generated_hash =`)
#   vibe new     [--name @scope/name] <dir>
#                                         scaffold a project: main.vibex, a
#                                         root index.vpkg (the project marker
#                                         and manifest) and a .gitignore
#   vibe root                             print the project root
#   vibe clean   [--all]                  remove .vibe/build (--all: .vibe/store too)
#   vibe add     <source-spec>            fetch a package into .vibe/store/ and
#                                         pin it in the root index.vpkg
#                                         (github:owner/repo[/dir]@<ref> or
#                                         git:<url>@<ref>[#<dir>]; a semver
#                                         constraint ref picks the highest tag)
#   vibe fetch                            restore .vibe/store/ from the pins
#                                         (cache first, else the pinned source)
#   vibe pkg     publish <pkg_dir>        publish a package: semver gate, CAS,
#                                         transparency-log record (#805)
#   vibe pkg     install <name>@<ver> [--store] [--allow-yanked]
#                                         materialize a published version
#                                         (verifies the log inclusion proof)
#   vibe pkg     add <source-spec> [#pkg:b3:<64hex>]
#                                         fetch straight from git into
#                                         $VIBE_HOME/lib, hash-verified (no
#                                         manifest edit; `vibe add` is the
#                                         project lane)
#   vibe pkg     yank <name>@<ver>        mark a version yanked (append-only)
#   vibe pkg     update <name> [--store]  switch to the newest non-yanked
#                                         version, showing the contract diff
#   vibe lsp     [--selfhost]             start the stdio LSP server (the node
#                                         server; --selfhost: the embedded one)
#   vibe context-pack [--out FILE]        emit cheatsheet + verified golden
#                                         examples as one file (AI-harness context, #820)
#   vibe version                          print toolchain versions
#   vibe toolchain list                   installed toolchains, the default marked
#   vibe toolchain default <name>         select the default toolchain
#   vibe toolchain remove <name>          delete a toolchain (never the default)
#   vibe self update [<version>|latest] [--no-default] [--force]
#                                         install a release toolchain (download,
#                                         verify, precompile) and make it default
#   vibe self update --cli-wasm <path>    refresh compiler wasm + rebuild .cwasm
#   vibe self uninstall [--purge]         remove toolchains/, bin/, env, toolchain
#                                         (--purge: cache/, lib/ and log/ too)
#   vibe help                             this message
set -euo pipefail
VIBE_VERSION="0.1.0-dev"
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
LAUNCHER="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"
SELF="$(cd -P "$(dirname "$LAUNCHER")" && pwd)"
TOOLCHAIN_DIR="$(dirname "$SELF")"
if [ "$(basename "$(dirname "$TOOLCHAIN_DIR")")" = "toolchains" ]; then
  INSTALLED_TOOLCHAIN=1
  TOOLCHAIN_NAME="$(basename "$TOOLCHAIN_DIR")"
  VIBE_HOME="${VIBE_HOME:-$(dirname "$(dirname "$TOOLCHAIN_DIR")")}"
else
  INSTALLED_TOOLCHAIN=0
  TOOLCHAIN_NAME=""
  if [ "$(basename "$SELF")" = "bin" ] && [ -f "$TOOLCHAIN_DIR/lib/vibe-cli.wasm" ]; then
    echo "vibe: $TOOLCHAIN_DIR is a flat pre-#755 install (bin/vibe next to lib/vibe-cli.wasm), which this toolchain no longer runs from; remove it and reinstall with install/install.sh (docs/install.md)" >&2
    exit 1
  fi
  VIBE_HOME="${VIBE_HOME:-$TOOLCHAIN_DIR}"
fi
RUNNER="${VIBE_RUNNER:-$TOOLCHAIN_DIR/bin/viberun}"
CLI_WASM="${VIBE_CLI_WASM:-$TOOLCHAIN_DIR/lib/vibe-cli.wasm}"
CLI_CWASM="${VIBE_CLI_CWASM:-$TOOLCHAIN_DIR/lib/vibe-cli.cwasm}"
if [ "$INSTALLED_TOOLCHAIN" = 1 ] && [ -z "${VIBE_LIB:-}" ]; then
  export VIBE_LIB="$TOOLCHAIN_DIR/lib:$VIBE_HOME/lib"
fi
die() { echo "vibe: $*" >&2; exit 1; }
_sha256_file() {
  if sha256sum </dev/null >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
# The wasm this launcher hands its argv to. ONE artifact answers both shapes:
# `cli_adapter.vibe`'s `cli_main` reads argv[0] and routes a VERB to the
# dispatcher, falling through to the positional `<input> <output> <entry>` plus
# VIBE_* selectors for everything else. So `VIBE_CLI_WASM=<stage2>` keeps
# meaning what it has always meant to the ~12 scripts and the CI shards that
# set it, and there is no second artifact to find.
#
# The AOT .cwasm is used only when NOTHING it depends on is newer than it:
# neither the runner (viberun deserializes the image unsafely, and one built
# by a different wasmtime is undefined behaviour) nor the portable wasm (a
# wasm refreshed without re-precompiling leaves the image stale). `! -nt`
# also accepts an equal-mtime image built right after the wasm. The guard was
# lost when the verbs moved and a stale image was chosen because it existed
# (Codex review of #2858); scripts/test_pick_cli_freshness.sh pins it.
pick_cli() {
  [ -n "${VIBE_CLI_WASM:-}" ] && [ -f "$VIBE_CLI_WASM" ] && { printf '%s' "$VIBE_CLI_WASM"; return; }
  if [ -f "$CLI_CWASM" ] && [ ! "$RUNNER" -nt "$CLI_CWASM" ] && \
     { [ ! -f "$CLI_WASM" ] || [ ! "$CLI_WASM" -nt "$CLI_CWASM" ]; }; then
    printf '%s' "$CLI_CWASM"
  elif [ -f "$CLI_WASM" ]; then
    printf '%s' "$CLI_WASM"
  else
    die "compiler wasm not found: $CLI_WASM (run 'vibe self update')"
  fi
}
manifest_field_of() { [ -f "$1" ] && sed -n "s/^  \"$2\": \"\(.*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
manifest_field() { manifest_field_of "$TOOLCHAIN_DIR/manifest.json" "$1"; }
default_toolchain_name() {
  [ -n "${VIBE_TOOLCHAIN:-}" ] && { printf '%s' "$VIBE_TOOLCHAIN"; return; }
  [ -f "$VIBE_HOME/toolchain" ] && sed -n '1p' "$VIBE_HOME/toolchain" | tr -d '[:space:]'
}
valid_toolchain_name() { case "$1" in ""|.|..|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
VIBE_RELEASE_URL_DEFAULT="https://github.com/mizchi/vibe-lang/releases/download"
release_fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$2" "$1"
  else die "vibe self update: curl or wget is required to download $1"
  fi
}
release_target() {
  local os arch; os="$(uname -s)"; arch="$(uname -m)"
  case "$arch" in arm64|aarch64) arch="aarch64" ;; x86_64|amd64) arch="x86_64" ;; esac
  case "$os" in Linux) printf '%s-unknown-linux-gnu' "$arch" ;; Darwin) printf '%s-apple-darwin' "$arch" ;;
    *) die "vibe self update: no prebuilt runner for $os/$arch" ;; esac
}
release_manifest_field() { sed -n "s/^  \"$2\": \"\([^\"]*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
release_manifest_asset() { sed -n "s/^    \"$2\": \"\([0-9a-f]*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
release_manifest_runner() { sed -n "s/^    \"$2\": \"\([^\"]*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
release_manifest_targets() { sed -n '/^  "runners": {/,/^  }/p' "$1" | sed -n 's/^    "\([^"]*\)".*/\1/p' | tr '\n' ' '; }
json_safe() { printf '%s' "$1" | tr -d '"\\\n'; }
write_toolchain_manifest() {
  printf '{\n  "version": "%s",\n  "toolchain": "%s",\n  "source": "%s",\n  "ref": "%s",\n  "commit": "%s",\n  "installed_at": "%s",\n  "runner_sha256": "%s",\n  "compiler_sha256": "%s",\n  "wasmtime": "%s"\n}\n' \
    "$(json_safe "$2")" "$(json_safe "$3")" "$(json_safe "$4")" "$(json_safe "$5")" "$(json_safe "$6")" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)" \
    "$(_sha256_file "$1/bin/viberun" 2>/dev/null || true)" \
    "$(_sha256_file "$1/lib/vibe-cli.wasm" 2>/dev/null || true)" \
    "$(json_safe "$7")" > "$1/manifest.json"
}
install_release_toolchain() {
  local want="$1" set_default="$2" force="$3"
  local base="${VIBE_RELEASE_URL:-$VIBE_RELEASE_URL_DEFAULT}"
  local dl tag version manifest target runner_name tc_name wasm_name asset sha want_sha staging
  command -v tar >/dev/null 2>&1 || die "vibe self update: tar is required"
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
    || die "vibe self update: sha256sum or shasum is required to verify the release assets"
  if [ "$want" = "latest" ]; then
    dl="$VIBE_HOME/cache/downloads/latest"; mkdir -p "$dl"
    release_fetch "${base%/download}/latest/download/release-manifest.json" "$dl/release-manifest.json" \
      || die "vibe self update: cannot fetch the latest release manifest"
    version="$(release_manifest_field "$dl/release-manifest.json" version)"
    [ -n "$version" ] || die "vibe self update: latest manifest names no version"
    echo "vibe: latest release is $version"
  else version="${want#v}"; fi
  valid_toolchain_name "$version" || die "vibe self update: invalid version '$version'"
  tag="v$version"
  [ -e "$VIBE_HOME/toolchains/$version" ] && [ "$force" != 1 ] \
    && die "toolchain '$version' is already installed (\`vibe self update $version --force\` reinstalls)"
  dl="$VIBE_HOME/cache/downloads/$tag"; mkdir -p "$dl"; manifest="$dl/release-manifest.json"
  release_fetch "$base/$tag/release-manifest.json" "$manifest" \
    || die "vibe self update: cannot fetch $base/$tag/release-manifest.json (is $version a published release?)"
  [ "$(release_manifest_field "$manifest" version)" = "$version" ] \
    || die "vibe self update: the manifest at $base/$tag names version '$(release_manifest_field "$manifest" version)', not $version"
  target="$(release_target)"
  runner_name="$(release_manifest_runner "$manifest" "$target")"
  [ -n "$runner_name" ] || die "vibe self update: release $tag ships no runner for $target (it ships: $(release_manifest_targets "$manifest")); install from a checkout instead (install/install.sh --ref $tag)"
  tc_name="$(release_manifest_field "$manifest" toolchain)"
  wasm_name="$(release_manifest_field "$manifest" compiler_wasm)"
  [ -n "$tc_name" ] && [ -n "$wasm_name" ] || die "vibe self update: the release manifest lists no toolchain bundle or compiler wasm"
  for asset in "$runner_name" "$tc_name" "$wasm_name"; do
    want_sha="$(release_manifest_asset "$manifest" "$asset")"
    [ -n "$want_sha" ] || die "vibe self update: the release manifest has no sha256 for $asset"
    if [ ! -f "$dl/$asset" ] || [ "$(_sha256_file "$dl/$asset")" != "$want_sha" ]; then
      echo "vibe: downloading $asset"
      release_fetch "$base/$tag/$asset" "$dl/$asset.part" || { rm -f "$dl/$asset.part"; die "vibe self update: download failed: $base/$tag/$asset"; }
      mv "$dl/$asset.part" "$dl/$asset"
    fi
    sha="$(_sha256_file "$dl/$asset")"
    [ "$sha" = "$want_sha" ] || { rm -f "$dl/$asset"; die "vibe self update: $asset does not match the release manifest (sha256 $sha, manifest $want_sha); nothing was installed"; }
  done
  staging="$VIBE_HOME/toolchains/.staging-$version-$$"
  rm -rf "$staging"; mkdir -p "$staging/bin" "$staging/lib"
  tar -xzf "$dl/$tc_name" -C "$staging" && tar -xzf "$dl/$runner_name" -C "$staging/bin" \
    || { rm -rf "$staging"; die "vibe self update: cannot unpack release assets"; }
  [ -f "$staging/bin/viberun" ] && [ -f "$staging/bin/vibe" ] \
    || { rm -rf "$staging"; die "vibe self update: assets missing bin/viberun or bin/vibe"; }
  chmod 0755 "$staging/bin/viberun" "$staging/bin/vibe"
  cp "$dl/$wasm_name" "$staging/lib/vibe-cli.wasm"
  "$staging/bin/viberun" --precompile "$staging/lib/vibe-cli.wasm" -o "$staging/lib/vibe-cli.cwasm" \
    || { rm -rf "$staging"; die "vibe self update: viberun --precompile failed"; }
  write_toolchain_manifest "$staging" "$version" "$version" "release" "$tag" \
    "$(release_manifest_field "$manifest" commit)" "$(release_manifest_field "$manifest" wasmtime)"
  rm -rf "$VIBE_HOME/toolchains/$version"
  mv "$staging" "$VIBE_HOME/toolchains/$version"
  echo "vibe: installed toolchain $version -> $VIBE_HOME/toolchains/$version"
  if [ "$set_default" = 1 ]; then
    printf '%s\n' "$version" > "$VIBE_HOME/toolchain"
    echo "vibe: default toolchain -> $version"
  fi
}
find_pkg_sh() {
  local cand
  for cand in "$TOOLCHAIN_DIR/lib/vibe_pkg.sh" "$SELF/../scripts/vibe_pkg.sh"; do
    [ -f "$cand" ] && { printf '%s' "$cand"; return; }; done
  die "vibe_pkg.sh not found"
}
manifest_add_pin() {
  local file="$1" name="$2" ver="$3" hash="$4" src="$5" tmp
  tmp="$(mktemp -t vibe-manifest-XXXXXX)"
  if awk -v name="$name" -v ver="$ver" -v hash="$hash" -v src="$src" '
    function entry() { return "  " name " : " ver }
    function pin() { return "require " name " " ver " = #" hash " from " src }
    function flush_missing() {
      if (!did_deps) { print "deps = {"; print entry(); print "}"; did_deps = 1 }
      if (!did_pin) { print pin(); did_pin = 1 }
    }
    BEGIN { in_deps = 0; did_deps = 0; did_pin = 0; in_header = 1 }
    {
      line = $0
      if (!in_header) { print line; next }
      t = line; sub(/[[:space:]]+$/, "", t)
      if (in_deps) {
        if (t ~ /^[[:space:]]*}$/) { in_deps = 0; print line; next }
        n = index(t, ":")
        key = (n > 0) ? substr(t, 1, n - 1) : t
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        if (key == name) next
        print line; next
      }
      if (t == "deps = {}") { print "deps = {"; print entry(); print "}"; did_deps = 1; next }
      if (t == "deps = {") { print line; print entry(); in_deps = 1; did_deps = 1; next }
      if (t ~ /^require[[:space:]]/) {
        split(t, r, /[[:space:]]+/)
        if (r[2] == name) { if (!did_pin) { print pin(); did_pin = 1 }; next }
        print line; next
      }
      if (t ~ /^generated_hash[[:space:]]*=/) { flush_missing(); in_header = 0; print line; next }
      if (t ~ /^(name|version|main)([[:space:]]*=|[[:space:]])/ || t ~ /^description[[:space:]]*=/ || t ~ /^[[:space:]]+#\|/ || t == "") { print line; next }
      flush_missing(); in_header = 0; print line
    }
    END { if (in_header) flush_missing() }
  ' "$file" > "$tmp"; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"; return 1
  fi
}
# $1 = captured stderr, $2 = 1 when the guest's last stdout line was the
# assert abort marker: the trap that follows is the assert aborting through a
# deliberate `unreachable`, and once the assert block tells the story echoing
# that trap reads as a second, unexplained failure (#2202). Any other trap is
# real and printed.
condense_test_trap() {
  local errf="$1" pre_abort="${2:-0}" out
  [ -s "$errf" ] || return 0
  out="$(awk -v pre_abort="$pre_abort" '
    function pct(s) { gsub("%20"," ",s); gsub("%25","%",s); return s }
    !seen && match($0, /at __test_/) { r=substr($0,RSTART+length("at __test_")); if (match(r,/ \(wasm:/)) { f=substr(r,1,RSTART-1); if(f!="") seen=1 } }
    !seen && match($0, /<unknown>!__test_/) { f=substr($0,RSTART+length("<unknown>!__test_")); sub(/[[:space:]]+$/,"",f); if(f!="") seen=1 }
    !why && /RuntimeError:|wasm trap:/ { why=$0; sub(/^[[:space:]]+|[0-9]+: |viberun: /,"",why) }
    END {
      if (f!="") print "       failing test: " pct(f)
      if (why!="" && !(pre_abort == 1 && why ~ /unreachable/)) print "       trap: " why
    }
  ' "$errf")"
  # Nothing recognizable (a runner or instantiation failure, an unexpected
  # message): replay the raw stream rather than leave `FAIL <file>` alone
  # with no reason -- information is never lost. An assert abort whose only
  # stderr was the suppressed trap replays nothing, by design: the assert
  # block on stdout already tells the story.
  if [ -n "$out" ]; then
    printf '%s\n' "$out"
  elif ! { [ "$pre_abort" = 1 ] && grep -q "unreachable" "$errf"; }; then
    sed 's/^/       /' "$errf"
  fi
}
INVOKE_DIR="${VIBE_INVOKE_DIR:-$(pwd -P)}"
project_root() {
  local d="$INVOKE_DIR" found=""
  while :; do
    [ -f "$d/index.vpkg" ] && found="$d"
    [ -e "$d/.git" ] || [ "$d" = "/" ] && break
    d="$(dirname "$d")"; done
  printf '%s' "${found:-$INVOKE_DIR}"
}
PROJECT_ROOT="$(project_root)"
BUILD_DIR="${VIBE_BUILD_DIR:-$PROJECT_ROOT/.vibe/build}"
case "$BUILD_DIR" in /*) ;; *) BUILD_DIR="$INVOKE_DIR/$BUILD_DIR" ;; esac
if [ -n "${VIBE_BUILD_DIR:-}" ] && [ -z "${VIBE_BUILD_CACHE_DIR:-}" ]; then
  export VIBE_BUILD_CACHE_DIR="$BUILD_DIR/cache"
fi
