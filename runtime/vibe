      # `wac plug` does not fail on the wrong one -- it promotes the unsatisfied
      # edge to a root import (#1796), so the mistake would surface as a
      # mysterious runtime failure instead of here.
      body_stream="$(sed -n '6p' "$plan")"
      # The dispatcher made both paths relative to the PROJECT ROOT, where it
      # ran; this arm runs from the invoking directory (Codex review of #2858).
      case "$wasm" in /*) ;; *) wasm="$PROJECT_ROOT/$wasm" ;; esac
      case "$adapter" in ''|/*) ;; *) adapter="$PROJECT_ROOT/$adapter" ;; esac
      [ -n "$adapter" ] || adapter="${VIBE_HTTP_ADAPTER:-}"
      if [ -z "$adapter" ]; then
        if [ "$body_stream" = 1 ]; then
          for cand in "$TOOLCHAIN_DIR/lib/vibe_http_p3_body_stream_adapter.component.wasm" \
                      "$PROJECT_ROOT/_build/http_adapter/vibe_http_p3_body_stream_adapter.component.wasm"; do
            [ -f "$cand" ] && { adapter="$cand"; break; }
          done
          [ -n "$adapter" ] || die "serve: this handler takes the body as a stream, which needs the stream-body P3 adapter; build it with 'VIBE_HTTP_ADAPTER_BODY_STREAM=1 scripts/build_wasi_http_p3_full_adapter.sh _build/http_adapter/vibe_http_p3_body_stream_adapter.component.wasm' (needs cargo + wasm-tools) or pass --adapter / set VIBE_HTTP_ADAPTER"
        else
          for cand in "$TOOLCHAIN_DIR/lib/vibe_http_p3_full_adapter.component.wasm" \
                      "$PROJECT_ROOT/_build/http_adapter/vibe_http_p3_full_adapter.component.wasm"; do
            [ -f "$cand" ] && { adapter="$cand"; break; }
          done
          [ -n "$adapter" ] || die "serve: P3 HTTP adapter not found; build it with scripts/build_wasi_http_p3_full_adapter.sh (needs cargo + wasm-tools) or pass --adapter / set VIBE_HTTP_ADAPTER"
        fi
      fi
      [ -f "$adapter" ] || die "serve: adapter not found: $adapter"
      command -v wac >/dev/null 2>&1 || die "serve: 'wac' not found (cargo install wac-cli)"
      command -v wasmtime >/dev/null 2>&1 || die "serve: 'wasmtime' not found (https://wasmtime.dev)"
      composed="${wasm%.component.wasm}.serve.wasm"
      wac plug --plug "$wasm" "$adapter" -o "$composed" || die "serve: wac plug failed"
      echo "composed -> $composed"
      echo "serving http://$addr/ (Ctrl-C to stop)"
      exec wasmtime serve -Sp3 -Shttp -W exceptions=y -W concurrency-support=y -W component-model-async=y -W component-model-async-stackful=y --addr "$addr" "$composed"
      ;;
    *) die "unsupported host action: $kind" ;;
  esac
}
# --- semver constraint resolution for `vibe add` -----------------------------
# A ref such as `^1.2`, `~1.2.3`, `>=1.0`, `1.x` or `*` is resolved against the
# remote's tags (`git ls-remote --tags`) to the highest satisfying tag BEFORE the
# fetch; a bare exact version (1.2.3) or any non-semver string (a branch, a
# commit) is passed through literally. Host-side because it needs `git`.
ver_parts() {
  local v="${1#[vV]}"; v="${v%%+*}"; v="${v%%-*}"
  local IFS=.; set -- $v; echo "${1:-0} ${2:-0} ${3:-0}"
}
ver_cmp() {
  local a b; a="$(ver_parts "$1")"; b="$(ver_parts "$2")"
  local a1 a2 a3 b1 b2 b3
  read -r a1 a2 a3 <<EOF
$a
EOF
  read -r b1 b2 b3 <<EOF
$b
EOF
  local p
  for p in "$a1 $b1" "$a2 $b2" "$a3 $b3"; do
    set -- $p
    [ "$1" -lt "$2" ] && { echo -1; return; }
    [ "$1" -gt "$2" ] && { echo 1; return; }
  done
  echo 0
}
ver_ge() { [ "$(ver_cmp "$1" "$2")" != "-1" ]; }
ver_gt() { [ "$(ver_cmp "$1" "$2")" = "1" ]; }
ver_lt() { [ "$(ver_cmp "$1" "$2")" = "-1" ]; }
ver_le() { [ "$(ver_cmp "$1" "$2")" != "1" ]; }
ver_satisfies() {
  local v="$1" c="$2" maj min pat base
  case "$c" in ""|"*"|x|X) return 0 ;; esac
  case "$c" in
    ^*) base="${c#^}"; read -r maj min pat <<EOF
$(ver_parts "$base")
EOF
        ver_ge "$v" "$base" || return 1
        if [ "$maj" -gt 0 ]; then ver_lt "$v" "$((maj+1)).0.0"
        elif [ "$min" -gt 0 ]; then ver_lt "$v" "0.$((min+1)).0"
        else ver_lt "$v" "0.0.$((pat+1))"; fi ;;
    ~*) base="${c#\~}"; read -r maj min pat <<EOF
$(ver_parts "$base")
EOF
        ver_ge "$v" "$base" && ver_lt "$v" "$maj.$((min+1)).0" ;;
    ">="*) ver_ge "$v" "${c#>=}" ;;
    "<="*) ver_le "$v" "${c#<=}" ;;
    ">"*)  ver_gt "$v" "${c#>}" ;;
    "<"*)  ver_lt "$v" "${c#<}" ;;
    "="*)  [ "$(ver_cmp "$v" "${c#=}")" = "0" ] ;;
    *)
      case "$c" in
        *.*.*) [ "$(ver_cmp "$v" "$c")" = "0" ] ;;
        *.*)   read -r maj min pat <<EOF
$(ver_parts "$c")
EOF
               ver_ge "$v" "$maj.$min.0" && ver_lt "$v" "$maj.$((min+1)).0" ;;
        *)     case "$c" in *[!0-9]*) return 1 ;; esac
               ver_ge "$v" "$c.0.0" && ver_lt "$v" "$((c+1)).0.0" ;;
      esac ;;
  esac
}
# Is $1 a semver constraint (vs a plain branch / commit / exact tag)?
is_constraint() {
  case "$1" in
    "*"|x|X) return 0 ;;
    ^*|\~*|">="*|"<="*|">"*|"<"*|"="*) return 0 ;;
    *[!0-9.vV]*) return 1 ;;
    *.*.*) return 1 ;;
    *.*|[0-9]*) return 0 ;;
    *) return 1 ;;
  esac
}
resolve_git_constraint() {
  local remote="$1" constraint="$2" best="" bestv="" tag v
  while IFS= read -r tag; do
    [ -n "$tag" ] || continue
    case "$tag" in *'^{}'*) continue ;; esac
    v="${tag#[vV]}"
    case "$v" in ''|*[!0-9.]*) continue ;; esac
    if ver_satisfies "$v" "$constraint"; then
      if [ -z "$best" ] || ver_gt "$v" "$bestv"; then best="$tag"; bestv="$v"; fi
    fi
  done <<EOF
$(git ls-remote --tags --refs "$remote" 2>/dev/null | sed 's#.*refs/tags/##')
EOF
  [ -n "$best" ] && printf '%s' "$best"
}
# The compiler adapter's positional protocol is selected by VIBE_* MODE
# variables (VIBE_HASH, VIBE_CHECK_ONLY, ...). A verb selects its own mode, so
# one of those inherited from the caller's shell must not reach the runner
# (scripts/test_vibe_allocs_launcher.sh pins it). Public knobs -- VIBE_RC,
# VIBE_UNSTABLE, VIBE_TEST_BACKEND, VIBE_BENCH_BACKEND, VIBE_WASM_NAMES,
# VIBE_BUILD_CACHE_DIR -- are the verbs' own inputs and pass through.
ADAPTER_MODE_CLEARS="-u VIBE_FS_COMPILE -u VIBE_CHECK_ONLY -u VIBE_LSP -u VIBE_HASH -u VIBE_HASH_WRITE
  -u VIBE_MISSING_VPKG_SCAN -u VIBE_DEPS_MISSING_SCAN -u VIBE_FILL_PINS -u VIBE_PUBLISH_CHECK
  -u VIBE_MODULE_JOB_DIR -u VIBE_PUBLISH_ENV_CACHE -u VIBE_LIST_DEPS -u VIBE_MODULE_PLAN
  -u VIBE_NORMALIZE -u VIBE_FMT -u VIBE_INSPECT_UPDATE -u VIBE_INSPECT_UPDATE_STDOUT -u VIBE_TYPE_AT -u VIBE_DOC_AT
  -u VIBE_BINDING_AT -u VIBE_SYMBOLS -u VIBE_ESCAPES -u VIBE_ESCAPES_STRICT -u VIBE_ALLOCS
  -u VIBE_DEPS -u VIBE_DEPS_DIRECT -u VIBE_GREP -u VIBE_GREP_JSON -u VIBE_RC_CLASSIFY -u VIBE_RC_PLAN -u VIBE_RC_PLAN_FN
  -u VIBE_DIAGNOSTICS -u VIBE_DIAGNOSTICS_JSON -u VIBE_EMIT_COVERAGE_DRIVER_SOURCE -u VIBE_EMIT_MERGED_SOURCE
  -u VIBE_EMIT_WIT -u VIBE_SERVE_COMPONENT -u VIBE_EMIT_MODULE_SOURCE -u VIBE_COVERAGE -u VIBE_DEBUG -u VIBE_DEBUG_BREAK
  -u VIBE_TESTMETA_OUT -u VIBE_ENTRY_TESTMETA_OUT -u VIBE_ARTIFACT_INPUT_TRACE_OUT -u VIBE_ARTIFACT_INPUT_TRACE_NONCE"
invoke_cli() {
  local plan cli status=0 verb="${1:-}" json=0 arg
  cli="$(pick_cli)"; plan="$(mktemp -t vibe-host-action-XXXXXX)"
  rm -f "$plan.diag"
  # shellcheck disable=SC2086
  ( cd "$PROJECT_ROOT" && env $ADAPTER_MODE_CLEARS VIBE_HOST_ACTION_OUT="$plan" VIBE_CRASH_DIAG_OUT="$plan.diag" \
      VIBE_BUILD_DIR="$BUILD_DIR" VIBE_INVOKE_DIR="$INVOKE_DIR" \
      "$RUNNER" "$cli" "$@" ) || status=$?
  # #946(4): a host-level crash of the COMPILER -- a native stack overflow on
  # a pathologically deep expression -- is written by the runner to
  # $plan.diag (VIBE_CRASH_DIAG_OUT), since nothing inside the guest can
  # catch it. It is a diagnostic, never "clean": `vibe check` / `vibe
  # diagnostics` report on stdout (their report channel), every other verb on
  # stderr, and the verb fails.
  if [ -s "$plan.diag" ]; then
    for arg in "$@"; do [ "$arg" = "--json" ] && json=1; done
    status=1
    case "$verb" in
      check|diagnostics)
        # The crash text never went through the CLI, so in --json mode it is
        # wrapped into a one-entry LSP array rather than leaking raw text to a
        # JSON consumer. `vibe diagnostics` keeps its frozen contract: raw
        # lines, exit 0 (docs/spec/1.0-freeze.md).
        if [ "$json" = 1 ]; then
          printf '[{"range":{"start":{"line":0,"character":0},"end":{"line":0,"character":1}},"severity":1,"source":"vibe","message":"%s"}]\n' \
            "$(sed 's/\\/\\\\/g; s/"/\\"/g' "$plan.diag" | tr '\n' ' ')"
        elif [ "$verb" = check ]; then
          sed 's/^/error: /' "$plan.diag"
        else
          cat "$plan.diag"
        fi
        [ "$verb" = diagnostics ] && status=0 ;;
      *) sed 's/^/error: /' "$plan.diag" >&2 ;;
    esac
    rm -f "$plan" "$plan.diag"; return "$status"
  fi
  # The CLI exits 0/1/2 and says why on stderr; anything else is the RUNNER
  # dying underneath it (a crash, a signal), which must not read as a clean
  # or as an explained verdict (scripts/test_vibe_allocs_launcher.sh).
  if [ "$status" -gt 2 ] && [ ! -s "$plan" ]; then
    echo "error: vibe $1 runner failed with status $status" >&2
  fi
  if [ -s "$plan" ] && [ "$(sed -n '1p' "$plan")" = "vibe-host-action-v1" ]; then
    execute_host_action "$plan" || status=$?
  fi
  rm -f "$plan"; return "$status"
}
# vibe grep [flags] --pattern '<pattern>' [paths...]        (#1572)
# 
# Structural AST search. Metavariables are `$(name:kind)`, kind = exp / id / const / arg / args / pat / type.
# `$(_:kind)` is anonymous.
# Unlike moongrep / ast-grep, the filters run on the
# CHECKER's answers, not on the grammar alone:
#   --where '$x : Array[Int]'    the capture's INFERRED type (`_` wildcard)
#   --where '$f = Iterator::map' the capture's RESOLVED name (sees through
#                                `import { Iterator as It }`)
#   --where-row '$f with Async' / '$f without Async'
#                                the capture's effect ROW
#   --only-ill-typed / --only-well-typed
#                                keep matches in declarations that do (not)
#                                type-check
# Any of those switches the sweep into the typed tier, which resolves
# imports through the same walk `vibe check` uses -- `vibe diagnostics`'s
# import-blind false positives are not reproduced here.
# 
# Output is one match per line, `path:line:col: <matched text>` followed by
# tab-separated `$var=<capture>`; `--json` emits the same matches as a JSON
# array (each capture carrying its inferred type when the typed tier ran).
# Empty output = no match. A report, not a failure: only a bad pattern or a
# bad filter is an error.
# END grep help
grep_help_requested() {
  local a
  for a in "$@"; do
    case "$a" in --help|-h) return 0 ;; --) return 1 ;; esac
  done
  return 1
}
cmd="${1:-help}"; shift || true
case "$cmd" in
  new)
    nname=""; [ "${1:-}" = "--name" ] && { nname="${2:-}"; shift 2; }
    [ "$#" -eq 1 ] || die "usage: vibe new [--name @scope/name] <dir>"
    ndir="$1"; [ -e "$ndir" ] && die "already exists: $ndir"
    if [ -n "$nname" ]; then case "$nname" in @*/*) ;; *) die "vibe new: --name must be @scope/name, got: $nname" ;; esac; fi
    mkdir -p "$ndir"
    printf 'fn main allows Console {\n  println("42")\n}\n' > "$ndir/main.vibex"
    pkg_name="$(basename -- "$ndir" | LC_ALL=C sed -e 's/[^A-Za-z0-9_-]/-/g')"
    [ -n "$nname" ] || nname="@local/$pkg_name"
    printf 'name = %s\nversion = 0.1.0\ndescription =\n  #|%s, a vibe program\ndeps = {}\n\ngenerated_hash =\n' "$nname" "$pkg_name" > "$ndir/index.vpkg"
    printf '.vibe/\n' > "$ndir/.gitignore"
    echo "created $ndir (run: vibe run $ndir/main.vibex)"
    ;;
  root) [ "$#" -eq 0 ] || die "usage: vibe root"; printf '%s\n' "$PROJECT_ROOT" ;;
  clean)
    clean_all=0
    for clean_arg in "$@"; do
      case "$clean_arg" in --all) clean_all=1 ;; *) die "usage: vibe clean [--all]" ;; esac
    done
    cleaned=""
    if [ -e "$BUILD_DIR" ]; then rm -rf "$BUILD_DIR"; cleaned="$cleaned $(display_path "$BUILD_DIR")"; fi
    if [ "$clean_all" = 1 ] && [ -e "$PROJECT_ROOT/.vibe/store" ]; then
      rm -rf "$PROJECT_ROOT/.vibe/store"; cleaned="$cleaned .vibe/store"
    fi
    if [ -n "$cleaned" ]; then echo "cleaned:$cleaned"
    else echo "nothing to clean under $PROJECT_ROOT"; fi
    ;;
  version|--version|-V)
    # An installed toolchain answers from its manifest.json (#2677) -- version,
    # source, ref, commit and install date on the first line, the shape
    # tests/integration/install/*_test.sh assert; a checkout launcher has no
    # manifest and answers from its own version constant.
    if [ -f "$TOOLCHAIN_DIR/manifest.json" ]; then
      mf_version="$(manifest_field version)"; mf_source="$(manifest_field source)"; mf_ref="$(manifest_field ref)"
      mf_commit="$(manifest_field commit)"; mf_date="$(manifest_field installed_at)"
      echo "vibe ${mf_version:-$VIBE_VERSION} (toolchain ${TOOLCHAIN_NAME:-?}: ${mf_source:-?} ${mf_ref:-?}@${mf_commit:0:12}, installed ${mf_date:-?})"
    else echo "vibe $VIBE_VERSION (selfhost launcher, checkout)"; fi
    echo "toolchain:   $TOOLCHAIN_DIR"; echo "runner:      $RUNNER"
    [ -x "$RUNNER" ] && "$RUNNER" --version 2>/dev/null || true
    echo "compiler:    $(pick_cli 2>/dev/null || echo '<missing>')"
    ;;
  context-pack)
    cpout="-"; [ "${1:-}" = "--out" ] && { cpout="${2:?}"; shift 2; }
    cpasset="$TOOLCHAIN_DIR/lib/context-pack.md"; cpgen="$TOOLCHAIN_DIR/scripts/gen_context_pack.sh"
    if [ -f "$cpasset" ]; then [ "$cpout" = "-" ] && cat "$cpasset" || cp "$cpasset" "$cpout"
    elif [ -f "$cpgen" ]; then [ "$cpout" = "-" ] && bash "$cpgen" "$TOOLCHAIN_DIR" || bash "$cpgen" "$TOOLCHAIN_DIR" > "$cpout"
    else die "vibe context-pack: no asset $cpasset and no generator $cpgen"; fi
    ;;
  toolchain)
    tsub="${1:-list}"; shift || true
    case "$tsub" in
      list)
        [ "$#" -eq 0 ] || die "usage: vibe toolchain list"
        tdefault="$(default_toolchain_name)"; tfound=0
        for d in "$VIBE_HOME/toolchains"/*/; do
          [ -d "$d" ] || continue
          tfound=1; tn="$(basename "$d")"; tv="$(manifest_field_of "${d}manifest.json" version)"
          tmark=" "; [ "$tn" = "$tdefault" ] && tmark="*"
          printf '%s %s\t%s\n' "$tmark" "$tn" "${tv:-?}"
        done
        [ "$tfound" = 1 ] || die "no toolchains installed under $VIBE_HOME/toolchains (install/install.sh puts one there)"
        ;;
      default)
        [ "$#" -eq 1 ] || die "usage: vibe toolchain default <name>"
        tn="$1"; valid_toolchain_name "$tn" || die "invalid toolchain name '$tn'"
        [ -x "$VIBE_HOME/toolchains/$tn/bin/vibe" ] || die "toolchain '$tn' is not installed (vibe toolchain list)"
        printf '%s\n' "$tn" > "$VIBE_HOME/toolchain"; echo "vibe: default toolchain -> $tn"
        ;;
      remove)
        [ "$#" -eq 1 ] || die "usage: vibe toolchain remove <name>"
        tn="$1"; valid_toolchain_name "$tn" || die "invalid toolchain name '$tn'"
        [ -d "$VIBE_HOME/toolchains/$tn" ] || die "toolchain '$tn' is not installed (vibe toolchain list)"
        [ "$tn" != "$(default_toolchain_name)" ] || die "toolchain '$tn' is the default; pick another with \`vibe toolchain default <name>\` first"
        [ "$tn" != "$TOOLCHAIN_NAME" ] || die "toolchain '$tn' is the one running this command"
        rm -rf "$VIBE_HOME/toolchains/$tn"; echo "vibe: removed toolchain $tn"
        ;;
      *) die "usage: vibe toolchain list | default <name> | remove <name>" ;;
    esac
    ;;
  self)
    sub="${1:-}"; shift || true
    case "$sub" in
      update)
        new_wasm=""; want=""; set_default=1; force=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --cli-wasm) new_wasm="${2:-}"; shift 2 ;;
            --no-default) set_default=0; shift ;;
            --force) force=1; shift ;;
            -*) die "unknown self update flag: $1" ;;
            *) [ -z "$want" ] || die "usage: vibe self update [<version>|latest] [--no-default] [--force]"; want="$1"; shift ;;
          esac
        done
        if [ -n "$new_wasm" ]; then
          [ -z "$want" ] || die "vibe self update: --cli-wasm swaps the compiler of the current toolchain and takes no version"
          [ -f "$new_wasm" ] || die "not found: $new_wasm"
          mkdir -p "$(dirname "$CLI_WASM")"
          cp -f "$new_wasm" "$CLI_WASM"
          echo "vibe: updated compiler wasm -> $CLI_WASM"
          "$RUNNER" --precompile "$CLI_WASM" -o "$CLI_CWASM"
          echo "vibe: rebuilt AOT compiler -> $CLI_CWASM"
        else
          install_release_toolchain "${want:-latest}" "$set_default" "$force"
        fi
        ;;
      uninstall)
        # Destructive: only an optional `--purge` is accepted, and anything
        # else (a typo, an extra word) refuses before the first rm -rf.
        purge=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --purge) purge=1; shift ;;
            *) die "unknown self uninstall flag: $1 (usage: vibe self uninstall [--purge])" ;;
          esac
        done
        [ "$INSTALLED_TOOLCHAIN" = 1 ] || die "vibe self uninstall: this launcher runs from a checkout ($TOOLCHAIN_DIR), not from an installed toolchain; nothing to remove"
        if [ "$VIBE_HOME" = "$HOME/.vibe" ]; then
          for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
            [ -f "$rc" ] && grep -qsF '. "$HOME/.vibe/env"' "$rc" || continue
            grep -vF '. "$HOME/.vibe/env"' "$rc" > "$rc.vibe-uninstall.tmp" && mv "$rc.vibe-uninstall.tmp" "$rc"
          done
        fi
        rm -rf "$VIBE_HOME/toolchains" "$VIBE_HOME/bin" "$VIBE_HOME/env" "$VIBE_HOME/toolchain"
        echo "vibe: removed $VIBE_HOME/{toolchains,bin,env,toolchain}"
        if [ "$purge" = 1 ]; then
          rm -rf "$VIBE_HOME/cache" "$VIBE_HOME/lib" "$VIBE_HOME/log"; rmdir "$VIBE_HOME" 2>/dev/null || true
        else echo "vibe: kept $VIBE_HOME/{cache,lib,log}"; fi
        ;;
      *) die "usage: vibe self update [<version>|latest] [--no-default] [--force] | vibe self update --cli-wasm <path> | vibe self uninstall [--purge]" ;;
    esac
    ;;
  add)
    [ "$#" -eq 1 ] || die "usage: vibe add <source-spec>   (github:owner/repo[/dir]@<ref> | git:<url>@<ref>[#<dir>])"
    aspec="$1"; case "$aspec" in -*) die "usage: vibe add <source-spec>" ;; esac
    # The manifest, the store and vibe_pkg.sh's paths are the PROJECT's, so
    # this arm runs from the root whatever directory it was invoked in.
    cd "$PROJECT_ROOT"
    [ -f index.vpkg ] || die "vibe add: no index.vpkg at the project root ($PROJECT_ROOT); \`vibe new\` writes one"
    # A semver constraint ref (^1.2, ~1.2.3, >=1.0, 1.x, *) resolves to the
    # highest matching tag here, and the spec handed on names that tag.
    aremote=""; aref=""; ahead=""; atail=""
    case "$aspec" in
      github:*)
        arest="${aspec#github:}"
        case "$arest" in *@*) ;; *) die "vibe add: a github spec needs @<ref>: $aspec" ;; esac
        aref="${arest##*@}"; apath="${arest%@*}"
        aowner="${apath%%/*}"; arr="${apath#*/}"; arepo="${arr%%/*}"
        [ -n "$aowner" ] && [ -n "$arepo" ] && [ "$arr" != "$apath" ] || die "vibe add: malformed github spec (owner/repo[/dir]@<ref>): $aspec"
        aremote="https://github.com/$aowner/$arepo.git"; ahead="github:$apath@"
        ;;
      git:*)
        arest="${aspec#git:}"
        case "$arest" in *"#"*) atail="#${arest##*#}"; arest="${arest%#*}" ;; esac
        case "$arest" in *@*) ;; *) die "vibe add: a git spec needs <url>@<ref>: $aspec" ;; esac
        aref="${arest##*@}"; aremote="${arest%@*}"
        [ -n "$aremote" ] || die "vibe add: malformed git spec (git:<url>@<ref>[#<dir>]): $aspec"
        ahead="git:$aremote@"
        ;;
      *) die "vibe add: unknown source spec, expected github:owner/repo[/dir]@<ref> or git:<url>@<ref>[#<dir>]: $aspec" ;;
    esac
    [ -n "$aref" ] || die "vibe add: empty ref in $aspec"
    command -v git >/dev/null 2>&1 || die "vibe add: git is required"
    if is_constraint "$aref"; then
      aresolved="$(resolve_git_constraint "$aremote" "$aref")"
      [ -n "$aresolved" ] || die "vibe add: no tag on $aremote satisfies '$aref'"
      echo "resolved $aref -> $aresolved"
      aspec="$ahead$aresolved$atail"
    fi
    pkg_sh="$(find_pkg_sh)" || exit 1
    cli="$(pick_cli)"; aout="$(mktemp -t vibe-add-XXXXXX)"
    if ! env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" \
        bash "$pkg_sh" add "$aspec" --store > "$aout"; then
      grep -v $'^added\t' "$aout" || true; rm -f "$aout"; die "vibe add: fetch failed for $aspec"
    fi
    grep -v $'^added\t' "$aout" || true
    aline="$(grep $'^added\t' "$aout" | tail -n 1)"; rm -f "$aout"
    [ -n "$aline" ] || die "vibe add: no 'added' record came back for $aspec"
    IFS=$'\t' read -r _ aname aver ahash _ _ apinned <<EOF
$aline
EOF
    manifest_add_pin index.vpkg "$aname" "$aver" "$ahash" "$apinned" \
      || die "vibe add: could not write the pin into index.vpkg"
    "$LAUNCHER" fmt "$PROJECT_ROOT/index.vpkg" >/dev/null 2>&1 || \
      echo "note: vibe fmt declined to canonicalize index.vpkg; the pin was written as-is" >&2
    echo "added $aname $aver -> $(display_path "$PROJECT_ROOT/.vibe/store/$aname")"
    env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" \
      bash "$pkg_sh" fetch-pins index.vpkg --store \
      || die "vibe add: $aname is installed and pinned, but a dependency of its own could not be fetched"
    ;;
  fetch)
    [ "$#" -eq 0 ] || die "usage: vibe fetch   (restores .vibe/store/ from the pins in the root index.vpkg)"
    cd "$PROJECT_ROOT"
    [ -f index.vpkg ] || die "vibe fetch: no index.vpkg at the project root ($PROJECT_ROOT); \`vibe add <source-spec>\` records the pins this restores"
    pkg_sh="$(find_pkg_sh)" || exit 1
    cli="$(pick_cli)"
    exec env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" \
      bash "$pkg_sh" fetch-pins index.vpkg --store
    ;;
  pkg)
    pkg_sh="$(find_pkg_sh)" || exit 1
    cli="$(pick_cli)"
    exec env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" bash "$pkg_sh" "$@"
    ;;
  shell)
    repl_dir="$(mktemp -d -t vibe-shell-XXXXXX)"; trap 'rm -rf "$repl_dir"' EXIT
    repl_buf="$repl_dir/session.vibe"; : > "$repl_buf"
    [ -d "$TOOLCHAIN_DIR/lib/@vibe" ] && ln -sfn "$TOOLCHAIN_DIR/lib" "$repl_dir/lib"
    # A declaration joins the session buffer only if the WHOLE buffer still
    # compiles with it: the candidate is compiled with an anchor entry and the
    # append is rolled back on failure, so one malformed line cannot poison
    # every later expression until `:clear` (Codex review of #2858).
    repl_validate() {
      local f="$repl_dir/__validate__.vibe" w="$repl_dir/__validate__.wasm"
      { cat "$repl_buf"; printf 'export let __repl_anchor__: () -> Int = () -> { 0 }\n'; } > "$f"
      invoke_cli compile "$f" -o "$w" --entry __repl_anchor__ >/dev/null
    }
    # `:load <file>` appends a file's declarations, validated the same way and
    # rolled back on failure; `:type <expr>` asks `vibe type-at` about the
    # expression bound at the end of the buffer.
    repl_load() {
      local lf="$1"
      [ -f "$lf" ] || { echo "vibe shell: not found: $lf" >&2; return 0; }
      cp "$repl_buf" "$repl_buf.bak"
      cat "$lf" >> "$repl_buf"; printf '\n' >> "$repl_buf"
      if repl_validate; then rm -f "$repl_buf.bak"; echo "loaded $lf"
      else mv -f "$repl_buf.bak" "$repl_buf"; echo "vibe shell: load rejected (buffer unchanged): $lf" >&2; fi
    }
    repl_type() {
      local expr="$1" f="$repl_dir/__type__.vibe" tline tout
      cp "$repl_buf" "$f"
      tline=$(( $(wc -l < "$f") + 1 ))
      printf 'let __repl_t__ = (%s)\n' "$expr" >> "$f"
      tout="$(invoke_cli type-at "$f" "$tline" 5 2>/dev/null || true)"
      if [ -n "$tout" ]; then printf '%s\n' "$tout"
      else echo "vibe shell: could not infer a type for: $expr" >&2; fi
    }
    if [ "$#" -ge 1 ]; then
      [ -f "$1" ] || die "not found: $1"
      cat "$1" >> "$repl_buf"; printf '\n' >> "$repl_buf"
      repl_validate || die "shell: preloaded file does not compile: $1"
    fi
    while IFS= read -r -p 'vibe> ' repl_line; do
      t="${repl_line#"${repl_line%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
      [ -n "$t" ] || continue
      case "$t" in
        :q|:quit) break ;;
        :help)
          cat <<'REPL_HELP'
vibe shell — compiled REPL (accumulate + recompile; no interpreter)
  :help            show this help
  :quit, :q        exit
  :list            print the session buffer (accumulated declarations)
  :clear           reset the session buffer
  :load <file>     append a file's declarations to the buffer (validated)
  :type <expr>     print the inferred type of an expression
Any line starting with a declaration keyword (fn/let/struct/enum/type/
import/effect/impl/trait/export/suberror/test) is appended to the session
buffer; the append is validated by a full recompile and rolled back on
error. Any other line is compiled as an expression against the buffer and
executed. Declarations must fit on one line.
REPL_HELP
          ;;
        :list) cat "$repl_buf" ;;
        :clear) : > "$repl_buf"; echo "session cleared" ;;
        :load) echo "usage: :load <file.vibe>" >&2 ;;
        :load\ *) repl_load "${t#:load }" ;;
        :type) echo "usage: :type <expr>" >&2 ;;
        :type\ *) repl_type "${t#:type }" ;;
        :*) echo "vibe shell: unknown command: ${t%% *} (try :help)" >&2 ;;
        fn\ *|let\ *|struct\ *|enum\ *|type\ *|import\ *|effect\ *|impl\ *|trait\ *|export\ *|suberror\ *|test\ *|//*)
          cp "$repl_buf" "$repl_buf.bak"
          printf '%s\n' "$repl_line" >> "$repl_buf"
          if repl_validate; then rm -f "$repl_buf.bak"
          else mv -f "$repl_buf.bak" "$repl_buf"; echo "vibe shell: declaration rejected (buffer unchanged)" >&2; fi ;;
        *)
          { cat "$repl_buf"; printf 'export let __repl_main__: () -> Int = () -> { (%s) }\n' "$t"; } > "$repl_dir/eval.vibe"
          # The compile's own `compiled a -> b` report is not the expression's
          # value; only the program's output belongs on the session's stdout.
          if invoke_cli compile "$repl_dir/eval.vibe" -o "$repl_dir/eval.wasm" --entry __repl_main__ >/dev/null 2>"$repl_dir/eval.err1"; then
            ( cd "$INVOKE_DIR" && exec "$RUNNER" "$repl_dir/eval.wasm" ) || echo "vibe shell: runtime error (exit $?)" >&2
          else
            # Int expressions print; anything else (a String, a Unit-returning
            # effectful call, a row the Int wrapper does not fit) is retried
            # in an UNANNOTATED wrapper so its row is inferred, and evaluated
            # for its effects with an honest notice. Richer printing waits on
            # the println-in-FS-mode gap (#805 follow-ups).
            { cat "$repl_buf"; printf 'export let __repl_main__ = () -> {\n  let _ = (\n%s\n  )\n  ()\n}\n' "$t"; } > "$repl_dir/eval.vibe"
            if invoke_cli compile "$repl_dir/eval.vibe" -o "$repl_dir/eval.wasm" --entry __repl_main__ >/dev/null 2>&1; then
              echo "vibe shell: non-Int value; evaluated for effects only (use :type to inspect)" >&2
              ( cd "$INVOKE_DIR" && exec "$RUNNER" "$repl_dir/eval.wasm" ) || echo "vibe shell: runtime error (exit $?)" >&2
            else
              cat "$repl_dir/eval.err1" >&2
            fi
          fi
          ;;
      esac
    done
    ;;
  rc-classify|rc-plan)
    # `--help` / `-h` is answered HERE, like `grep --help` below:
    # scripts/test_vibe_rc_help.sh runs it with a dummy runner and FAILS if the
    # runner is invoked. The dispatcher prints the same three lines for a
    # caller that reaches it another way (lib/@vibe/compiler/user_dispatch.vibe).
    case "${1:-}" in
      --help|-h)
        if [ "$cmd" = rc-classify ]; then
          printf '%s\n' 'usage: vibe rc-classify <file.vibe>' \
            'NAME SET[,SET...] per user function. Empty output = no special sets.' \
            'Sets: borrow_ret, borrow_param, view_ret, scalar_ret.'
        else
          printf '%s\n' 'usage: vibe rc-plan [--fn NAME] <file.vibe>' \
            'FN BINDING ACTION COUNT per collapsed Perceus action.' \
            'Empty output = no actions. ACTION is dup, drop, or alias_dup.'
        fi
        exit 0 ;;
    esac
    invoke_cli "$cmd" "$@"
    ;;
  symbols)
    # `--legend` and `--help`/`-h` are answered HERE, with no compiler wasm and
    # without starting the runner -- the same contract as `grep --help` above.
    # The KIND table is VERSIONED (v2 / 2026-09-12, #2632), so it is a fact
    # about the launcher's own agreement with its callers, and
    # scripts/test_vibe_symbols.sh reads it straight out of a source checkout
    # before it installs anything. Every other word of `symbols` is parsed in
    # the dispatcher.
    case "${1:-}" in
      --legend)
        printf '%s\n' \
          '2 Module' \
          '6 Method' \
          '10 Enum' \
          '11 Interface' \
          '12 Function' \
          '13 Variable' \
          '23 Struct' \
          '24 Event' \
          '26 TypeParameter' \
          '27 Test' \
          '28 Bench'
        exit 0
        ;;
      --help|-h)
        printf '%s\n' \
          'usage: vibe symbols [--with-path] <file.vibe|dir>...' \
          '       vibe symbols --legend' \
          'Prints NAME KIND START END [DOC] per declaration.' \
          'With several paths, a directory, or --with-path, each line gains a leading PATH field.' \
          'DOC is the `///` doc comment, omitted when there is none; newlines in it are escaped as \n.' \
          'KIND integers are LSP SymbolKind, plus 27 Test / 28 Bench for a block label (legend v2); print the table with `vibe symbols --legend`.'
        exit 0
        ;;
    esac
    invoke_cli symbols "$@"
    ;;
  grep)
    # `vibe grep --help` is answered HERE, with no compiler wasm and without
    # starting the runner. Two gates pin that and neither can be satisfied from
    # inside the CLI: scripts/test_vibe_grep_help.sh runs it with a dummy
    # runner and FAILS if the runner is invoked, and
    # scripts/session_start_grep_test.sh runs it with VIBE_CLI_WASM naming a
    # file that does not exist. Explaining a flag is the one thing that has to
    # keep working when the toolchain does not, so it stays host-side; every
    # other word of `grep` is parsed in lib/@vibe/cli. The text above is the
    # user-facing help, printed by the same content-anchored `sed` main used.
    if grep_help_requested "$@"; then
      sed -n '/^# vibe grep \[flags\]/,/^# END grep help/p' "$LAUNCHER" | sed '/^# END grep help/d; s/^# \{0,1\}//'
      exit 0
    fi
    invoke_cli grep "$@"
    ;;
  help|--help|-h)
    # Content-anchored (not fixed line numbers): the whole Subcommands block
    # up to the `vibe help` line, so a newly documented subcommand cannot fall
    # outside a stale range (Codex review, PR #925). No wasm, no runner.
    sed -n '/^# Subcommands:/,/^#   vibe help /p' "$LAUNCHER" | sed 's/^# \{0,1\}//'
    ;;
  test)
    # A directory argument is expanded HERE with find(1), which does not
    # follow directory symlinks: the guest's `Fs::is_dir` does, so its own
    # walk (kept for direct callers of the dispatcher) could leave the
    # requested tree, find the same test twice through a link, or recurse
    # into a link back to an ancestor until it failed (Codex review of
    # #2858). The launcher expanded with find before the verbs moved; the
    # dispatcher sorts the whole list, so the report order is unchanged.
    tflags=(); tfiles=(); tjobflag=(); tprev=""; tjobs=""; tupdate=0
    for targ in "$@"; do
      if [ "$tprev" = "--jobs" ]; then tjobs="$targ"; tjobflag=(--jobs "$targ"); tprev=""; continue; fi
      case "$targ" in
        --jobs) tprev="$targ" ;;
        --update) tupdate=1; tflags+=("$targ") ;;
        -*) tflags+=("$targ") ;;
        *)
          if [ -d "$targ" ]; then
            tfound=0
            while IFS= read -r tfile; do tfiles+=("$tfile"); tfound=1; done < <(find "$targ" -type f -name '*_test.vibe' | LC_ALL=C sort)
            [ "$tfound" = 1 ] || die "vibe test: no test files found under $targ"
          else
            tfiles+=("$targ")
          fi ;;
      esac
    done
    # A trailing `--jobs` with no value is forwarded where the user wrote it,
    # after the files, so the dispatcher refuses it (`test: missing value
    # after --jobs`) instead of the run silently proceeding at the default job
    # count (Codex review of #2858).
    ttrail=(); if [ -n "$tprev" ]; then ttrail=("$tprev"); fi
    # `--jobs N` with several files: N dispatcher processes, each COMPILING
    # and running a contiguous share of the files, so compile-bound suites --
    # the part the option was introduced for -- get the concurrency asked for
    # (Codex review of #2858). Each share reports its verdicts into its own
    # results file; the shares are replayed in file order and summarized once.
    # `--update` stays serial (its re-run re-enters one file at a time), and an
    # invalid `--jobs` value is left to the dispatcher to refuse.
    case "$tjobs" in ''|*[!0-9]*|0) tjobs=1 ;; esac
    if [ "$tjobs" -gt 1 ] && [ "${#tfiles[@]}" -gt 1 ] && [ "$tupdate" = 0 ]; then
      tdir="$(mktemp -d -t vibe-test-jobs-XXXXXX)"
      tshare=$(( (${#tfiles[@]} + tjobs - 1) / tjobs )); tk=0; ti=0
      for tfile in "${tfiles[@]}"; do
        printf '%s\n' "$tfile" >> "$tdir/chunk.$tk"
        ti=$((ti + 1)); [ "$ti" -ge "$tshare" ] && { tk=$((tk + 1)); ti=0; }
      done
      tk=0
      while [ -f "$tdir/chunk.$tk" ]; do
        (
          cfiles=(); while IFS= read -r cf; do cfiles+=("$cf"); done < "$tdir/chunk.$tk"
          VIBE_TEST_NESTED=1 VIBE_TEST_RESULTS="$tdir/results.$tk" \
            invoke_cli test ${tflags[@]+"${tflags[@]}"} "${cfiles[@]}" >"$tdir/out.$tk" 2>"$tdir/err.$tk"
          echo $? >"$tdir/rc.$tk"
        ) &
        tk=$((tk + 1))
      done
      wait
      textra=0; tk=0; : > "$tdir/results"
      while [ -f "$tdir/chunk.$tk" ]; do
        [ -s "$tdir/out.$tk" ] && cat "$tdir/out.$tk"
        [ -s "$tdir/err.$tk" ] && cat "$tdir/err.$tk" >&2
        [ -s "$tdir/results.$tk" ] && cat "$tdir/results.$tk" >> "$tdir/results"
        # A share that failed without a verdict for each of its files was
        # refused by the dispatcher (a missing file, a bad flag): one failure
        # the per-file records cannot carry.
        trecorded=0; [ -s "$tdir/results.$tk" ] && trecorded="$(grep -c . "$tdir/results.$tk" || true)"
        if [ "$(cat "$tdir/rc.$tk" 2>/dev/null)" != 0 ] && [ "${trecorded:-0}" -lt "$(grep -c . "$tdir/chunk.$tk" || true)" ]; then
          textra=$((textra + 1))
        fi
        tk=$((tk + 1))
      done
      tstatus=0; host_test_summary "$tdir/results" "$textra" || tstatus=1
      rm -rf "$tdir"
      exit "$tstatus"
    fi
    invoke_cli test ${tflags[@]+"${tflags[@]}"} ${tjobflag[@]+"${tjobflag[@]}"} ${tfiles[@]+"${tfiles[@]}"} ${ttrail[@]+"${ttrail[@]}"}
    ;;
  lsp)
    # The node server (clients/js/lsp_server.js) stays the default: it carries
    # call hierarchy, the graph visualizer and whole-workspace symbols, which
    # the embedded server in lib/@vibe/lsp still documents as deferred. It is
    # JSON-RPC plumbing that drives this same launcher's `vibe check` /
    # `type-at` / etc. for the actual compile. `--selfhost` selects the
    # embedded server through the verb dispatcher instead.
    for lsp_arg in "$@"; do
      if [ "$lsp_arg" = "--selfhost" ]; then
        invoke_cli lsp "$@"
        exit $?
      fi
    done
    server="$TOOLCHAIN_DIR/lib/lsp_server.js"
    [ -f "$server" ] || server="$SELF/../clients/js/lsp_server.js"
    [ -f "$server" ] || server="$SELF/../../clients/js/lsp_server.js"
    [ -f "$server" ] || die "lsp server not found (looked in $TOOLCHAIN_DIR/lib and repo clients/js)"
    command -v node >/dev/null 2>&1 || die "node is required for 'vibe lsp'"
    exec env VIBE_BIN="$LAUNCHER" node "$server" "$@"
    ;;
  *)
    set -- "$cmd" "$@"
    invoke_cli "$@"
    ;;
esac
