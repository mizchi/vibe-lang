# Appends ` (<base>:<line>)` to every stderr line whose frame names a function
# in the `.funcmap` sidecar (`name<TAB>declLine` per line): the `trace: ` and
# `  at ` frames of a trace dump and the `<unknown>!name` frames of a wasmtime
# backtrace. Lookup is one `_fmln_<name>` variable per entry (bash 3.2 has no
# associative arrays); names are validated to `[A-Za-z_][A-Za-z0-9_]*` before
# they reach `eval`. Runs in the backgrounded subshell host_run_guest starts,
# so the variables never leak into the launcher's scope.
#   $1 = funcmap path ("" / missing => pass input through unannotated)
#   $2 = entry source basename
annotate_run_stream() {
  local fm="$1" base="$2"
  local _nm _ln line rest name varname hit tab
  tab="$(printf '\t')"
  if [ -n "$fm" ] && [ -s "$fm" ]; then
    while IFS="$tab" read -r _nm _ln || [ -n "$_nm" ]; do
      _ln="${_ln%%[[:space:]]*}"
      case "$_nm" in [A-Za-z_]*) ;; *) continue ;; esac
      case "$_nm" in *[!A-Za-z0-9_]*) continue ;; esac
      case "$_ln" in ""|*[!0-9]*) continue ;; esac
      eval "_fmln_${_nm}=${_ln}"
    done < "$fm"
  fi
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "trace: "*) rest="${line#trace: }"; name="${rest%%[[:space:]]*}" ;;
      "  at "*)   rest="${line#  at }";   name="${rest%%[[:space:]]*}" ;;
      *"!"*)      rest="${line#*!}";      name="${rest%%[[:space:]]*}" ;;
      *)          printf '%s\n' "$line"; continue ;;
    esac
    hit=""
    case "$name" in
      [A-Za-z_]*) case "$name" in *[!A-Za-z0-9_]*) name="" ;; esac ;;
      *) name="" ;;
    esac
    if [ -n "$name" ]; then
      varname="_fmln_${name}"
      if [ -n "${!varname+x}" ]; then hit="${!varname}"; fi
    fi
    if [ -n "$hit" ]; then
      printf '%s (%s:%s)\n' "$line" "$base" "$hit"
    else
      printf '%s\n' "$line"
    fi
  done
}
# Counts the `__test_` functions in a compiled test wasm. Assigns n_tests and
# n_tests_exact directly (a `$()` subshell would drop both). Exact when the
# count came from the name section's function-name subsection; 0 when it is
# the raw-occurrence fallback (no python3, or a stripped name section), which
# over-counts -- a test name appears in more than one wasm section -- and is
# good enough only for the zero/nonzero "(no tests found)" note.
host_count_tests() {
  local wasm="$1" n="" g
  n_tests_exact=0
  if command -v python3 >/dev/null 2>&1; then
    n="$(python3 - "$wasm" 2>/dev/null <<'PY' || true
import sys
b = open(sys.argv[1], "rb").read()
def uleb(i):
    r = s = 0
    while True:
        x = b[i]; i += 1
        r |= (x & 0x7F) << s
        if not (x & 0x80):
            return r, i
        s += 7
i, count = 8, 0
while i < len(b):
    sid = b[i]; i += 1
    size, i = uleb(i)
    end = i + size
    if sid == 0:
        nlen, j = uleb(i)
        if b[j:j + nlen] == b"name":
            j += nlen
            while j < end:
                subid = b[j]; j += 1
                ssize, j = uleb(j)
                send = j + ssize
                if subid == 1:
                    cnt, k = uleb(j)
                    for _ in range(cnt):
                        _, k = uleb(k)
                        ln, k = uleb(k)
                        if b[k:k + ln].startswith(b"__test_"):
                            count += 1
                        k += ln
                j = send
    i = end
print(count)
PY
)"
  fi
  case "$n" in ''|*[!0-9]*) n="" ;; esac
  [ -n "$n" ] && n_tests_exact=1
  if [ -z "$n" ] || [ "$n" = 0 ]; then
    g="$({ grep -ao '__test_' "$wasm" 2>/dev/null || true; } | wc -l | tr -d '[:space:]')"
    case "$g" in ''|*[!0-9]*) g=0 ;; esac
    if [ "$g" -gt 0 ] || [ -z "$n" ]; then
      [ "$g" -gt 0 ] && n_tests_exact=0
      n="$g"
    fi
  fi
  n_tests="$n"
}
# One `verdict<TAB>tests<TAB>exact` row per test file, appended to the results
# file the run-tests arm owns (VIBE_TEST_RESULTS), from which the summary's
# test total is read. A background batch job and a nested --update re-run
# reach the same file through the environment.
host_test_record() {
  [ -n "${VIBE_TEST_RESULTS:-}" ] || return 0
