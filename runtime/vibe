#!/usr/bin/env bash
# vibe — host launcher. Argument parsing and compiler work live in lib/@vibe/cli.
set -euo pipefail
VIBE_VERSION="0.1.0-dev"
_src="${BASH_SOURCE[0]}"
while [ -L "$_src" ]; do
  _dir="$(cd -P "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  case "$_src" in /*) ;; *) _src="$_dir/$_src" ;; esac
done
LAUNCHER="$(cd -P "$(dirname "$_src")" && pwd)/$(basename "$_src")"
SELF="$(cd -P "$(dirname "$LAUNCHER")" && pwd)"
TOOLCHAIN_DIR="$(dirname "$SELF")"
if [ "$(basename "$(dirname "$TOOLCHAIN_DIR")")" = "toolchains" ]; then
  INSTALLED_TOOLCHAIN=1
  TOOLCHAIN_NAME="$(basename "$TOOLCHAIN_DIR")"
  VIBE_HOME="${VIBE_HOME:-$(dirname "$(dirname "$TOOLCHAIN_DIR")")}"
else
  INSTALLED_TOOLCHAIN=0
  TOOLCHAIN_NAME=""
  if [ "$(basename "$SELF")" = "bin" ] && [ -f "$TOOLCHAIN_DIR/lib/vibe-cli.wasm" ]; then
    echo "vibe: $TOOLCHAIN_DIR is a flat pre-#755 install (bin/vibe next to lib/vibe-cli.wasm), which this toolchain no longer runs from; remove it and reinstall with install/install.sh (docs/install.md)" >&2
    exit 1
  fi
  VIBE_HOME="${VIBE_HOME:-$TOOLCHAIN_DIR}"
fi
RUNNER="${VIBE_RUNNER:-$TOOLCHAIN_DIR/bin/viberun}"
CLI_WASM="${VIBE_CLI_WASM:-$TOOLCHAIN_DIR/lib/vibe-cli.wasm}"
CLI_CWASM="${VIBE_CLI_CWASM:-$TOOLCHAIN_DIR/lib/vibe-cli.cwasm}"
if [ "$INSTALLED_TOOLCHAIN" = 1 ] && [ -z "${VIBE_LIB:-}" ]; then
  export VIBE_LIB="$TOOLCHAIN_DIR/lib:$VIBE_HOME/lib"
fi
die() { echo "vibe: $*" >&2; exit 1; }
_sha256_file() {
  if sha256sum </dev/null >/dev/null 2>&1; then sha256sum "$1" | cut -d' ' -f1
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}
pick_cli() {
  local cand
  [ -n "${VIBE_CLI_WASM:-}" ] && [ -f "$VIBE_CLI_WASM" ] && { printf '%s' "$VIBE_CLI_WASM"; return; }
  for cand in "$TOOLCHAIN_DIR/lib/vibe-user-cli.wasm" "$TOOLCHAIN_DIR/_build/cli/vibe-user-cli.wasm" "$CLI_CWASM" "$CLI_WASM"; do
    [ -f "$cand" ] && { printf '%s' "$cand"; return; }
  done
  die "compiler wasm not found: $CLI_WASM"
}
manifest_field_of() { [ -f "$1" ] && sed -n "s/^  \"$2\": \"\(.*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
manifest_field() { manifest_field_of "$TOOLCHAIN_DIR/manifest.json" "$1"; }
default_toolchain_name() {
  [ -n "${VIBE_TOOLCHAIN:-}" ] && { printf '%s' "$VIBE_TOOLCHAIN"; return; }
  [ -f "$VIBE_HOME/toolchain" ] && sed -n '1p' "$VIBE_HOME/toolchain" | tr -d '[:space:]'
}
valid_toolchain_name() { case "$1" in ""|.|..|*[!A-Za-z0-9._-]*) return 1 ;; *) return 0 ;; esac; }
VIBE_RELEASE_URL_DEFAULT="https://github.com/mizchi/vibe-lang/releases/download"
release_fetch() {
  if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$2" "$1"
  else die "vibe self update: curl or wget is required to download $1"
  fi
}
release_target() {
  local os arch; os="$(uname -s)"; arch="$(uname -m)"
  case "$arch" in arm64|aarch64) arch="aarch64" ;; x86_64|amd64) arch="x86_64" ;; esac
  case "$os" in Linux) printf '%s-unknown-linux-gnu' "$arch" ;; Darwin) printf '%s-apple-darwin' "$arch" ;;
    *) die "vibe self update: no prebuilt runner for $os/$arch" ;; esac
}
release_manifest_field() { sed -n "s/^  \"$2\": \"\([^\"]*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
release_manifest_asset() { sed -n "s/^    \"$2\": \"\([0-9a-f]*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
release_manifest_runner() { sed -n "s/^    \"$2\": \"\([^\"]*\)\",\{0,1\}\$/\1/p" "$1" | sed -n '1p'; }
release_manifest_targets() { sed -n '/^  "runners": {/,/^  }/p' "$1" | sed -n 's/^    "\([^"]*\)".*/\1/p' | tr '\n' ' '; }
json_safe() { printf '%s' "$1" | tr -d '"\\\n'; }
write_toolchain_manifest() {
  printf '{\n  "version": "%s",\n  "toolchain": "%s",\n  "source": "%s",\n  "ref": "%s",\n  "commit": "%s",\n  "installed_at": "%s",\n  "runner_sha256": "%s",\n  "compiler_sha256": "%s",\n  "wasmtime": "%s"\n}\n' \
    "$(json_safe "$2")" "$(json_safe "$3")" "$(json_safe "$4")" "$(json_safe "$5")" "$(json_safe "$6")" \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)" \
    "$(_sha256_file "$1/bin/viberun" 2>/dev/null || true)" \
    "$(_sha256_file "$1/lib/vibe-cli.wasm" 2>/dev/null || true)" \
    "$(json_safe "$7")" > "$1/manifest.json"
}
install_release_toolchain() {
  local want="$1" set_default="$2" force="$3"
  local base="${VIBE_RELEASE_URL:-$VIBE_RELEASE_URL_DEFAULT}"
  local dl tag version manifest target runner_name tc_name wasm_name asset sha want_sha staging
  command -v tar >/dev/null 2>&1 || die "vibe self update: tar is required"
  command -v sha256sum >/dev/null 2>&1 || command -v shasum >/dev/null 2>&1 \
    || die "vibe self update: sha256sum or shasum is required to verify the release assets"
  if [ "$want" = "latest" ]; then
    dl="$VIBE_HOME/cache/downloads/latest"; mkdir -p "$dl"
    release_fetch "${base%/download}/latest/download/release-manifest.json" "$dl/release-manifest.json" \
      || die "vibe self update: cannot fetch the latest release manifest"
    version="$(release_manifest_field "$dl/release-manifest.json" version)"
    [ -n "$version" ] || die "vibe self update: latest manifest names no version"
    echo "vibe: latest release is $version"
  else version="${want#v}"; fi
  valid_toolchain_name "$version" || die "vibe self update: invalid version '$version'"
  tag="v$version"
  [ -e "$VIBE_HOME/toolchains/$version" ] && [ "$force" != 1 ] \
    && die "toolchain '$version' is already installed (\`vibe self update $version --force\` reinstalls)"
  dl="$VIBE_HOME/cache/downloads/$tag"; mkdir -p "$dl"; manifest="$dl/release-manifest.json"
  release_fetch "$base/$tag/release-manifest.json" "$manifest" \
    || die "vibe self update: cannot fetch $base/$tag/release-manifest.json"
  [ "$(release_manifest_field "$manifest" version)" = "$version" ] \
    || die "vibe self update: manifest version mismatch"
  runner_name="$(release_manifest_runner "$manifest" "$(release_target)")"
  [ -n "$runner_name" ] || die "vibe self update: no runner for $(release_target)"
  tc_name="$(release_manifest_field "$manifest" toolchain)"
  wasm_name="$(release_manifest_field "$manifest" compiler_wasm)"
  [ -n "$tc_name" ] && [ -n "$wasm_name" ] || die "vibe self update: manifest lists no toolchain/wasm"
  for asset in "$runner_name" "$tc_name" "$wasm_name"; do
    want_sha="$(release_manifest_asset "$manifest" "$asset")"
    [ -n "$want_sha" ] || die "vibe self update: no sha256 for $asset"
    if [ ! -f "$dl/$asset" ] || [ "$(_sha256_file "$dl/$asset")" != "$want_sha" ]; then
      echo "vibe: downloading $asset"
      release_fetch "$base/$tag/$asset" "$dl/$asset.part" || { rm -f "$dl/$asset.part"; die "vibe self update: download failed: $asset"; }
      mv "$dl/$asset.part" "$dl/$asset"
    fi
    [ "$(_sha256_file "$dl/$asset")" = "$want_sha" ] || { rm -f "$dl/$asset"; die "vibe self update: $asset sha256 mismatch"; }
  done
  staging="$VIBE_HOME/toolchains/.staging-$version-$$"
  rm -rf "$staging"; mkdir -p "$staging/bin" "$staging/lib"
  tar -xzf "$dl/$tc_name" -C "$staging" && tar -xzf "$dl/$runner_name" -C "$staging/bin" \
    || { rm -rf "$staging"; die "vibe self update: cannot unpack release assets"; }
  [ -f "$staging/bin/viberun" ] && [ -f "$staging/bin/vibe" ] \
    || { rm -rf "$staging"; die "vibe self update: assets missing bin/viberun or bin/vibe"; }
  chmod 0755 "$staging/bin/viberun" "$staging/bin/vibe"
  cp "$dl/$wasm_name" "$staging/lib/vibe-cli.wasm"
  "$staging/bin/viberun" --precompile "$staging/lib/vibe-cli.wasm" -o "$staging/lib/vibe-cli.cwasm" \
    || { rm -rf "$staging"; die "vibe self update: viberun --precompile failed"; }
  write_toolchain_manifest "$staging" "$version" "$version" "release" "$tag" \
    "$(release_manifest_field "$manifest" commit)" "$(release_manifest_field "$manifest" wasmtime)"
  rm -rf "$VIBE_HOME/toolchains/$version"
  mv "$staging" "$VIBE_HOME/toolchains/$version"
  echo "vibe: installed toolchain $version -> $VIBE_HOME/toolchains/$version"
  if [ "$set_default" = 1 ]; then
    printf '%s\n' "$version" > "$VIBE_HOME/toolchain"
    echo "vibe: default toolchain -> $version"
  fi
}
find_pkg_sh() {
  local cand
  for cand in "$TOOLCHAIN_DIR/lib/vibe_pkg.sh" "$SELF/../scripts/vibe_pkg.sh"; do
    [ -f "$cand" ] && { printf '%s' "$cand"; return; }; done
  die "vibe_pkg.sh not found"
}
manifest_add_pin() {
  local file="$1" name="$2" ver="$3" hash="$4" src="$5" tmp
  tmp="$(mktemp -t vibe-manifest-XXXXXX)"
  if awk -v name="$name" -v ver="$ver" -v hash="$hash" -v src="$src" '
    function entry() { return "  " name " : " ver }
    function pin() { return "require " name " " ver " = #" hash " from " src }
    function flush_missing() {
      if (!did_deps) { print "deps = {"; print entry(); print "}"; did_deps = 1 }
      if (!did_pin) { print pin(); did_pin = 1 }
    }
    BEGIN { in_deps = 0; did_deps = 0; did_pin = 0; in_header = 1 }
    {
      line = $0
      if (!in_header) { print line; next }
      t = line; sub(/[[:space:]]+$/, "", t)
      if (in_deps) {
        if (t ~ /^[[:space:]]*}$/) { in_deps = 0; print line; next }
        n = index(t, ":")
        key = (n > 0) ? substr(t, 1, n - 1) : t
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", key)
        if (key == name) next
        print line; next
      }
      if (t == "deps = {}") { print "deps = {"; print entry(); print "}"; did_deps = 1; next }
      if (t == "deps = {") { print line; print entry(); in_deps = 1; did_deps = 1; next }
      if (t ~ /^require[[:space:]]/) {
        split(t, r, /[[:space:]]+/)
        if (r[2] == name) { if (!did_pin) { print pin(); did_pin = 1 }; next }
        print line; next
      }
      if (t ~ /^generated_hash[[:space:]]*=/) { flush_missing(); in_header = 0; print line; next }
      if (t ~ /^(name|version|main)([[:space:]]*=|[[:space:]])/ || t ~ /^description[[:space:]]*=/ || t ~ /^[[:space:]]+#\|/ || t == "") { print line; next }
      flush_missing(); in_header = 0; print line
    }
    END { if (in_header) flush_missing() }
  ' "$file" > "$tmp"; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp"; return 1
  fi
}
condense_test_trap() {
  local errf="$1"
  [ -s "$errf" ] || return 0
  awk '
    function pct(s) { gsub("%20"," ",s); gsub("%25","%",s); return s }
    !seen && match($0, /at __test_/) { r=substr($0,RSTART+length("at __test_")); if (match(r,/ \(wasm:/)) { f=substr(r,1,RSTART-1); if(f!="") seen=1 } }
    !seen && match($0, /<unknown>!__test_/) { f=substr($0,RSTART+length("<unknown>!__test_")); sub(/[[:space:]]+$/,"",f); if(f!="") seen=1 }
    !why && /RuntimeError:|wasm trap:/ { why=$0; sub(/^[[:space:]]+|[0-9]+: |viberun: /,"",why) }
    END { if (f!="") print "       failing test: " pct(f); if (why!="") print "       trap: " why }
  ' "$errf"
}
INVOKE_DIR="${VIBE_INVOKE_DIR:-$(pwd -P)}"
project_root() {
  local d="$INVOKE_DIR" found=""
  while :; do
    [ -f "$d/index.vpkg" ] && found="$d"
    [ -e "$d/.git" ] || [ "$d" = "/" ] && break
    d="$(dirname "$d")"; done
  printf '%s' "${found:-$INVOKE_DIR}"
}
PROJECT_ROOT="$(project_root)"
BUILD_DIR="${VIBE_BUILD_DIR:-$PROJECT_ROOT/.vibe/build}"
case "$BUILD_DIR" in /*) ;; *) BUILD_DIR="$INVOKE_DIR/$BUILD_DIR" ;; esac
if [ -n "${VIBE_BUILD_DIR:-}" ] && [ -z "${VIBE_BUILD_CACHE_DIR:-}" ]; then
  export VIBE_BUILD_CACHE_DIR="$BUILD_DIR/cache"
fi
display_path() { case "$1" in "$PROJECT_ROOT"/*) printf '%s' "${1#"$PROJECT_ROOT"/}" ;; *) printf '%s' "$1" ;; esac; }
case "${1:-help}" in
  context-pack|self|toolchain|root|clean|new|help|--help|-h|version|--version|-V) ;;
  *) [ -x "$RUNNER" ] || die "runner not found or not executable: $RUNNER" ;;
esac
host_run_guest() {
  local wasm="$1" trace="$2" brk="$3" mem="$4" msamp="$5" asite="$6" atop="$7" gprof="$8" gint="$9"
  shift 9
  local envp=()
  [ "$trace" = 1 ] && envp+=("VIBE_TRACE_OUT=1")
  [ -n "$brk" ] && envp+=("VIBE_BREAK=$brk")
  [ "$mem" = 1 ] && envp+=("VIBE_MEM=1")
  [ -n "$msamp" ] && envp+=("VIBE_MEM_SAMPLE_MS=$msamp")
  [ "$asite" = 1 ] && envp+=("VIBE_ALLOC_SITE=1")
  [ -n "$atop" ] && envp+=("VIBE_ALLOC_SITE_TOP=$atop")
  [ -n "$gprof" ] && envp+=("VIBE_GUEST_PROFILE=$gprof" "VIBE_GUEST_PROFILE_INTERVAL_US=$gint")
  [ -s "$wasm.funcmap" ] && envp+=("VIBE_FUNCMAP=$wasm.funcmap")
  ( cd "$INVOKE_DIR" && exec env ${envp[@]+"${envp[@]}"} "$RUNNER" "$wasm" "$@" )
}
execute_host_action() {
  local plan="$1" kind src wasm addr adapter line
  kind="$(sed -n '2p' "$plan")"
  case "$kind" in
    run-guest)
      wasm="$(sed -n '3p' "$plan")"
      local args=()
      while IFS= read -r line; do args+=("$line"); done < <(sed -n '13,$p' "$plan")
      host_run_guest "$wasm" "$(sed -n '5p' "$plan")" "$(sed -n '6p' "$plan")" \
        "$(sed -n '7p' "$plan")" "$(sed -n '8p' "$plan")" "$(sed -n '9p' "$plan")" \
        "$(sed -n '10p' "$plan")" "$(sed -n '11p' "$plan")" "$(sed -n '12p' "$plan")" \
        ${args[@]+"${args[@]}"}
      ;;
    run-guest-profile)
      src="$(sed -n '3p' "$plan")"; profile_out="$(sed -n '4p' "$plan")"; interval="$(sed -n '5p' "$plan")"
      local pargs=(); while IFS= read -r line; do pargs+=("$line"); done < <(sed -n '6,$p' "$plan")
      [ "$src" -ef "$profile_out" ] && die "profile: --out must not alias the source"
      case "$src" in /*) ;; *) src="$PWD/$src" ;; esac
      case "$profile_out" in /*) ;; *) profile_out="$PWD/$profile_out" ;; esac
      VIBE_INVOKE_DIR="$INVOKE_DIR" exec "$0" run --guest-profile="$profile_out" --guest-profile-interval-us="$interval" \
        "$src" -- ${pargs[@]+"${pargs[@]}"}
      ;;
    minify)
      out="$(sed -n '3p' "$plan")"; opt_wasm="${VIBE_OPT_WASM:-}"
      for cand in "$opt_wasm" "$TOOLCHAIN_DIR/lib/vibe-opt.wasm" "$PWD/_build/vibe-opt.wasm"; do
        [ -n "$cand" ] && [ -f "$cand" ] && { opt_wasm="$cand"; break; }
      done
      [ -f "${opt_wasm:-}" ] || die "--minify: vibe-opt.wasm not found"
      "$RUNNER" "$opt_wasm" "$out" "$out" || die "--minify failed for $out"
      ;;
    run-tests)
      t_fail=0; t_pass=0; update="$(sed -n '3p' "$plan")"
      while IFS= read -r rec; do
        [ -n "$rec" ] || continue
        src="${rec%%	*}"; wasm="${rec#*	}"; errf="$(mktemp -t vibe-test-err-XXXXXX)"
        if ( cd "$INVOKE_DIR" && exec "$RUNNER" "$wasm" ) 2>"$errf"; then
          echo "ok   $src"; t_pass=$((t_pass+1))
        else
          echo "FAIL $src"; condense_test_trap "$errf"
          [ "$update" = 1 ] && invoke_cli inspect-update "$src" "$errf" || true
          t_fail=$((t_fail+1))
        fi
        rm -f "$errf"
      done < <(sed -n '5,$p' "$plan")
      echo "[vibe-test] $t_pass passed, $t_fail failed"; [ "$t_fail" -eq 0 ]
      ;;
    run-benches)
      wasm="$(sed -n '4p' "$plan")"; be=("VIBE_BENCH_LABEL=$(basename "$(sed -n '3p' "$plan")")")
      it="$(sed -n '5p' "$plan")"; wu="$(sed -n '6p' "$plan")"; gp="$(sed -n '7p' "$plan")"
      [ "$it" != 0 ] && [ -n "$it" ] && be+=("VIBE_BENCH_ITERS=$it")
      [ "$wu" != 0 ] && [ -n "$wu" ] && be+=("VIBE_BENCH_WARMUP=$wu")
      if [ -n "$gp" ]; then mkdir -p "$gp"; be+=("VIBE_BENCH_GUEST_PROFILE_DIR=$(cd "$gp" && pwd -P)" "VIBE_GUEST_PROFILE_INTERVAL_US=$(sed -n '8p' "$plan")"); fi
      ( cd "$INVOKE_DIR" && exec env "${be[@]}" "$RUNNER" --bench "$wasm" )
      ;;
    wasmtime-serve)
      wasm="$(sed -n '3p' "$plan")"; addr="$(sed -n '4p' "$plan")"; adapter="$(sed -n '5p' "$plan")"
      for cand in "$adapter" "$TOOLCHAIN_DIR/lib/vibe_http_p3_full_adapter.component.wasm" \
                  "$PWD/_build/http_adapter/vibe_http_p3_full_adapter.component.wasm"; do
        [ -n "$cand" ] && [ -f "$cand" ] && { adapter="$cand"; break; }
      done
      [ -f "${adapter:-}" ] || die "serve: P3 HTTP adapter not found"
      command -v wac >/dev/null && command -v wasmtime >/dev/null || die "serve: wac and wasmtime are required"
      composed="${wasm%.component.wasm}.serve.wasm"
      wac plug --plug "$wasm" "$adapter" -o "$composed" || die "serve: wac plug failed"
      echo "serving http://$addr/"; exec wasmtime serve -Sp3 -Shttp -W exceptions=y -W concurrency-support=y -W component-model-async=y -W component-model-async-stackful=y --addr "$addr" "$composed"
      ;;
    *) die "unsupported host action: $kind" ;;
  esac
}
invoke_cli() {
  local plan cli status=0
  cli="$(pick_cli)"; plan="$(mktemp -t vibe-host-action-XXXXXX)"
  ( cd "$PROJECT_ROOT" && env VIBE_HOST_ACTION_OUT="$plan" VIBE_BUILD_DIR="$BUILD_DIR" VIBE_INVOKE_DIR="$INVOKE_DIR" \
      "$RUNNER" "$cli" "$@" ) || status=$?
  if [ -s "$plan" ] && [ "$(sed -n '1p' "$plan")" = "vibe-host-action-v1" ]; then
    execute_host_action "$plan" || status=$?
  fi
  rm -f "$plan"; return "$status"
}
cmd="${1:-help}"; shift || true
case "$cmd" in
  new)
    nname=""; [ "${1:-}" = "--name" ] && { nname="${2:-}"; shift 2; }
    [ "$#" -eq 1 ] || die "usage: vibe new [--name @scope/name] <dir>"
    ndir="$1"; [ -e "$ndir" ] && die "already exists: $ndir"
    if [ -n "$nname" ]; then case "$nname" in @*/*) ;; *) die "vibe new: --name must be @scope/name, got: $nname" ;; esac; fi
    mkdir -p "$ndir"
    printf 'fn main allows Console {\n  println("42")\n}\n' > "$ndir/main.vibex"
    pkg_name="$(basename -- "$ndir" | LC_ALL=C sed -e 's/[^A-Za-z0-9_-]/-/g')"
    [ -n "$nname" ] || nname="@local/$pkg_name"
    printf 'name = %s\nversion = 0.1.0\ndescription =\n  #|%s, a vibe program\ndeps = {}\n\ngenerated_hash =\n' "$nname" "$pkg_name" > "$ndir/index.vpkg"
    printf '.vibe/\n' > "$ndir/.gitignore"
    echo "created $ndir (run: vibe run $ndir/main.vibex)"
    ;;
  root) [ "$#" -eq 0 ] || die "usage: vibe root"; printf '%s\n' "$PROJECT_ROOT" ;;
  clean)
    clean_all=0
    for clean_arg in "$@"; do
      case "$clean_arg" in --all) clean_all=1 ;; *) die "usage: vibe clean [--all]" ;; esac
    done
    cleaned=""
    if [ -e "$BUILD_DIR" ]; then rm -rf "$BUILD_DIR"; cleaned="$cleaned $(display_path "$BUILD_DIR")"; fi
    if [ "$clean_all" = 1 ] && [ -e "$PROJECT_ROOT/.vibe/store" ]; then
      rm -rf "$PROJECT_ROOT/.vibe/store"; cleaned="$cleaned .vibe/store"
    fi
    if [ -n "$cleaned" ]; then echo "cleaned:$cleaned"
    else echo "nothing to clean under $PROJECT_ROOT"; fi
    ;;
  version|--version|-V)
    if [ -f "$TOOLCHAIN_DIR/manifest.json" ]; then echo "vibe $(manifest_field version) (toolchain ${TOOLCHAIN_NAME:-?})"
    else echo "vibe $VIBE_VERSION (selfhost launcher, checkout)"; fi
    echo "toolchain:   $TOOLCHAIN_DIR"; echo "runner:      $RUNNER"
    [ -x "$RUNNER" ] && "$RUNNER" --version 2>/dev/null || true
    echo "compiler:    $(pick_cli 2>/dev/null || echo '<missing>')"
    ;;
  context-pack)
    cpout="-"; [ "${1:-}" = "--out" ] && { cpout="${2:?}"; shift 2; }
    cpasset="$TOOLCHAIN_DIR/lib/context-pack.md"; cpgen="$TOOLCHAIN_DIR/scripts/gen_context_pack.sh"
    if [ -f "$cpasset" ]; then [ "$cpout" = "-" ] && cat "$cpasset" || cp "$cpasset" "$cpout"
    elif [ -f "$cpgen" ]; then [ "$cpout" = "-" ] && bash "$cpgen" "$TOOLCHAIN_DIR" || bash "$cpgen" "$TOOLCHAIN_DIR" > "$cpout"
    else die "vibe context-pack: no asset $cpasset and no generator $cpgen"; fi
    ;;
  toolchain)
    tsub="${1:-list}"; shift || true
    case "$tsub" in
      list)
        [ "$#" -eq 0 ] || die "usage: vibe toolchain list"
        tdefault="$(default_toolchain_name)"; tfound=0
        for d in "$VIBE_HOME/toolchains"/*/; do
          [ -d "$d" ] || continue
          tfound=1; tn="$(basename "$d")"; tv="$(manifest_field_of "${d}manifest.json" version)"
          tmark=" "; [ "$tn" = "$tdefault" ] && tmark="*"
          printf '%s %s\t%s\n' "$tmark" "$tn" "${tv:-?}"
        done
        [ "$tfound" = 1 ] || die "no toolchains installed under $VIBE_HOME/toolchains (install/install.sh puts one there)"
        ;;
      default)
        [ "$#" -eq 1 ] || die "usage: vibe toolchain default <name>"
        tn="$1"; valid_toolchain_name "$tn" || die "invalid toolchain name '$tn'"
        [ -x "$VIBE_HOME/toolchains/$tn/bin/vibe" ] || die "toolchain '$tn' is not installed (vibe toolchain list)"
        printf '%s\n' "$tn" > "$VIBE_HOME/toolchain"; echo "vibe: default toolchain -> $tn"
        ;;
      remove)
        [ "$#" -eq 1 ] || die "usage: vibe toolchain remove <name>"
        tn="$1"; valid_toolchain_name "$tn" || die "invalid toolchain name '$tn'"
        [ -d "$VIBE_HOME/toolchains/$tn" ] || die "toolchain '$tn' is not installed (vibe toolchain list)"
        [ "$tn" != "$(default_toolchain_name)" ] || die "toolchain '$tn' is the default; pick another with \`vibe toolchain default <name>\` first"
        [ "$tn" != "$TOOLCHAIN_NAME" ] || die "toolchain '$tn' is the one running this command"
        rm -rf "$VIBE_HOME/toolchains/$tn"; echo "vibe: removed toolchain $tn"
        ;;
      *) die "usage: vibe toolchain list | default <name> | remove <name>" ;;
    esac
    ;;
  self)
    sub="${1:-}"; shift || true
    case "$sub" in
      update)
        new_wasm=""; want=""; set_default=1; force=0
        while [ "$#" -gt 0 ]; do
          case "$1" in
            --cli-wasm) new_wasm="${2:-}"; shift 2 ;;
            --no-default) set_default=0; shift ;;
            --force) force=1; shift ;;
            -*) die "unknown self update flag: $1" ;;
            *) [ -z "$want" ] || die "usage: vibe self update [<version>|latest] [--no-default] [--force]"; want="$1"; shift ;;
          esac
        done
        if [ -n "$new_wasm" ]; then
          [ -z "$want" ] || die "vibe self update: --cli-wasm swaps the compiler of the current toolchain and takes no version"
          [ -f "$new_wasm" ] || die "not found: $new_wasm"
          mkdir -p "$(dirname "$CLI_WASM")"
          cp -f "$new_wasm" "$CLI_WASM"
          echo "vibe: updated compiler wasm -> $CLI_WASM"
          "$RUNNER" --precompile "$CLI_WASM" -o "$CLI_CWASM"
          echo "vibe: rebuilt AOT compiler -> $CLI_CWASM"
        else
          install_release_toolchain "${want:-latest}" "$set_default" "$force"
        fi
        ;;
      uninstall)
        purge=0; [ "${1:-}" = "--purge" ] && purge=1
        [ "$INSTALLED_TOOLCHAIN" = 1 ] || die "vibe self uninstall: checkout launcher, nothing to remove"
        if [ "$VIBE_HOME" = "$HOME/.vibe" ]; then
          for rc in "$HOME/.profile" "$HOME/.bashrc" "$HOME/.zshrc"; do
            [ -f "$rc" ] && grep -qsF '. "$HOME/.vibe/env"' "$rc" || continue
            grep -vF '. "$HOME/.vibe/env"' "$rc" > "$rc.vibe-uninstall.tmp" && mv "$rc.vibe-uninstall.tmp" "$rc"
          done
        fi
        rm -rf "$VIBE_HOME/toolchains" "$VIBE_HOME/bin" "$VIBE_HOME/env" "$VIBE_HOME/toolchain"
        echo "vibe: removed $VIBE_HOME/{toolchains,bin,env,toolchain}"
        if [ "$purge" = 1 ]; then
          rm -rf "$VIBE_HOME/cache" "$VIBE_HOME/lib" "$VIBE_HOME/log"; rmdir "$VIBE_HOME" 2>/dev/null || true
        else echo "vibe: kept $VIBE_HOME/{cache,lib,log}"; fi
        ;;
      *) die "usage: vibe self update [<version>|latest] [--no-default] [--force] | vibe self update --cli-wasm <path> | vibe self uninstall [--purge]" ;;
    esac
    ;;
  add)
    [ "$#" -eq 1 ] || die "usage: vibe add <source-spec>   (github:owner/repo[/dir]@<ref> | git:<url>@<ref>[#<dir>])"
    aspec="$1"; case "$aspec" in -*) die "usage: vibe add <source-spec>" ;; esac
    [ -f index.vpkg ] || die "vibe add: no index.vpkg at the project root ($PROJECT_ROOT); \`vibe new\` writes one"
    pkg_sh="$(find_pkg_sh)" || exit 1
    cli="$(pick_cli)"; aout="$(mktemp -t vibe-add-XXXXXX)"
    if ! env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" \
        bash "$pkg_sh" add "$aspec" --store > "$aout"; then
      grep -v $'^added\t' "$aout" || true; rm -f "$aout"; die "vibe add: fetch failed for $aspec"
    fi
    grep -v $'^added\t' "$aout" || true
    aline="$(grep $'^added\t' "$aout" | tail -n 1)"; rm -f "$aout"
    [ -n "$aline" ] || die "vibe add: no 'added' record came back for $aspec"
    IFS=$'\t' read -r _ aname aver ahash _ _ apinned <<EOF
$aline
EOF
    manifest_add_pin index.vpkg "$aname" "$aver" "$ahash" "$apinned" \
      || die "vibe add: could not write the pin into index.vpkg"
    "$LAUNCHER" fmt "$PROJECT_ROOT/index.vpkg" >/dev/null 2>&1 || \
      echo "note: vibe fmt declined to canonicalize index.vpkg; the pin was written as-is" >&2
    echo "added $aname $aver -> $(display_path "$PROJECT_ROOT/.vibe/store/$aname")"
    env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" \
      bash "$pkg_sh" fetch-pins index.vpkg --store \
      || die "vibe add: $aname is installed and pinned, but a dependency of its own could not be fetched"
    ;;
  fetch)
    [ "$#" -eq 0 ] || die "usage: vibe fetch   (restores .vibe/store/ from the pins in the root index.vpkg)"
    [ -f index.vpkg ] || die "vibe fetch: no index.vpkg at the project root ($PROJECT_ROOT); \`vibe add <source-spec>\` records the pins this restores"
    pkg_sh="$(find_pkg_sh)" || exit 1
    cli="$(pick_cli)"
    exec env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" \
      bash "$pkg_sh" fetch-pins index.vpkg --store
    ;;
  pkg)
    pkg_sh="$(find_pkg_sh)" || exit 1
    cli="$(pick_cli)"
    exec env VIBE_PKG_RUNNER="$RUNNER" VIBE_PKG_CLI_WASM="$cli" VIBE_HOME="$VIBE_HOME" bash "$pkg_sh" "$@"
    ;;
  shell)
    repl_dir="$(mktemp -d -t vibe-shell-XXXXXX)"; trap 'rm -rf "$repl_dir"' EXIT
    repl_buf="$repl_dir/session.vibe"; : > "$repl_buf"
    [ -d "$TOOLCHAIN_DIR/lib/@vibe" ] && ln -sfn "$TOOLCHAIN_DIR/lib" "$repl_dir/lib"
    [ "$#" -ge 1 ] && { [ -f "$1" ] || die "not found: $1"; cat "$1" >> "$repl_buf"; }
    while IFS= read -r -p 'vibe> ' repl_line; do
      t="${repl_line#"${repl_line%%[![:space:]]*}"}"; t="${t%"${t##*[![:space:]]}"}"
      [ -n "$t" ] || continue
      case "$t" in
        :q|:quit) break ;;
        :help) echo "vibe shell — :quit :list :clear" ;;
        :list) cat "$repl_buf" ;;
        :clear) : > "$repl_buf" ;;
        :*) echo "vibe shell: unknown command" >&2 ;;
        fn\ *|let\ *|struct\ *|enum\ *|type\ *|import\ *|effect\ *|impl\ *|trait\ *|export\ *|suberror\ *|test\ *|//*)
          printf '%s\n' "$repl_line" >> "$repl_buf" ;;
        *)
          { cat "$repl_buf"; printf 'export let __repl_main__: () -> Int = () -> { (%s) }\n' "$t"; } > "$repl_dir/eval.vibe"
          invoke_cli compile "$repl_dir/eval.vibe" -o "$repl_dir/eval.wasm" --entry __repl_main__ \
            && ( cd "$INVOKE_DIR" && exec "$RUNNER" "$repl_dir/eval.wasm" ) || true
          ;;
      esac
    done
    ;;
  help|--help|-h)
    invoke_cli help
    ;;
  *)
    set -- "$cmd" "$@"
    invoke_cli "$@"
    ;;
esac
