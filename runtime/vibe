    # nameless line with invented numbers. Refuse instead: a bench run that
    # silently measures something other than the benches is worse than no run.
    if [ "${VIBE_BENCH_BACKEND:-linear}" = "gc" ] && ! grep -qa "__bench_" "$out"; then
