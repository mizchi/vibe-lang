package vibe:hostfuturevalueprobe@0.1.0;

world host-future-value-probe {
  // ADR-0089 Decision 2 / step 4 (#1218): the HOST-SUPPLIED future<u32>
  // e2e the future_value probe deferred ("host 側 driver は未作成").
  // Same import shape as future_value/wit, but here the host really owns
  // the write end (a wasmtime FutureReader::new producer that resolves
  // only after a genuine timer suspend), so the guest's future.read
  // stays BLOCKED and waitable-set.wait must deliver the completion in
  // completion order -- the p3 `waitable-set.wait` backend of Decision 1,
  // measured for real instead of via the self-contained rendezvous.
  import get-future: func() -> future<u32>;
  export run: async func() -> u32;
}
