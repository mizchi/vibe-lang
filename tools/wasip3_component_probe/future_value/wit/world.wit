package vibe:futurevalueprobe@0.1.0;

world future-value-probe {
  // A SYNC import returning a future<u32> VALUE: unlike `async func() -> u32`
  // (whose wait is folded into [async-lower], eliding future.new/.read --
  // see ../README.md), the guest receives an explicit future handle it must
  // read itself, which is exactly the shape that forces literal future.*
  // canon built-ins onto the wire (ADR-0089 Part B step 1, #1218).
  import get-future: func() -> future<u32>;
  export run: async func() -> u32;
}
