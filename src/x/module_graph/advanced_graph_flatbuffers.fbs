namespace vibe;

table FbString {
  value: string;
}

table FbDef {
  def_id: int;
  name: int;
  kind: int;
  signature: int;
  path: int;
  start: int;
  end: int;
  module_hash: int;
}

table FbIndexEntry {
  key: int;
  values: [int];
}

table FbIndex {
  schema_version: int;
  base_commit: int;
  created_at: int;
  features: [int];
  chunk_roots: [int];
  defs: [FbDef];
  symbol_index: [FbIndexEntry];
  type_index: [FbIndexEntry];
  strings: [FbString];
}

table FbDelta {
  schema_version: int;
  base_schema_version: int;
  base_base_commit: int;
  base_created_at: int;
  base_features: [int];
  base_chunk_roots: [int];
  target_schema_version: int;
  target_base_commit: int;
  target_created_at: int;
  target_features: [int];
  target_chunk_roots: [int];
  removed_def_ids: [int];
  upsert_defs: [FbDef];
  symbol_upserts: [FbIndexEntry];
  symbol_removes: [int];
  type_upserts: [FbIndexEntry];
  type_removes: [int];
  strings: [FbString];
}

