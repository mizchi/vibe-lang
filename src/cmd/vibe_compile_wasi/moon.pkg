import {
  "mizchi/wite",
  "mizchi/wite/bundle" @wite_bundle,
  "mizchi/vibe/io",
  "mizchi/vibe/loader",
  "mizchi/vibe/profiler",
  "mizchi/vibe/runtime",
  "mizchi/vibe/runtime_compile",
  "moonbitlang/core/bench",
  "moonbitlang/x/sys",
}

warnings = "-29"

options(
  "is-main": true,
  targets: {
    "main.mbt": [ "wasm" ],
    "main_js.mbt": [ "js" ],
    "main_native.mbt": [ "native" ],
    "main_wbtest.mbt": [ "wasm" ],
  },
)
