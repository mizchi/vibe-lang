import {
  "mizchi/xsh/checker" as @checker,
  "mizchi/xsh/core" as @core,
  "mizchi/xsh/io" as @io,
  "mizchi/xsh/loader" as @loader,
  "mizchi/xsh/parser" as @parser,
  "mizchi/xsh/xsh" as @xsh_lib,
  "moonbitlang/core/json" as @json,
  "moonbitlang/x/sys" as @sys,
}

options(
  "is-main": true,
  targets: {
    "main.mbt": [ "wasm" ],
    "main_js.mbt": [ "js" ],
    "main_native.mbt": [ "native" ],
    "main_wbtest.mbt": [ "wasm" ],
  },
)