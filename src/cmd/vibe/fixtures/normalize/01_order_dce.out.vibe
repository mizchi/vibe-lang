//# Imports

use ./dep.vibe { dep }

//# Types

trait Eq

impl Eq for Int

//# Functions

declare export let run: () -> Int

declare export let run_io: () -> Int with {Error}

let helper = () -> Int { 1 }

run = () -> Int { helper() }

run_io = () -> Int with {Error} { run() }

//# Misc

export { run, run_io }
