import {
  "mizchi/x/http" @http,
  "moonbitlang/async/io" @async_io,
  "moonbitlang/async" @async,
  "moonbitlang/core/ref" @ref,
}

options(
  targets: {
    "http_impl.mbt": [ "native" ],
    "http_js.mbt": [ "js" ],
    "http_wasm.mbt": [ "wasm" ],
    "sleep_js.mbt": [ "js" ],
    "sleep_native.mbt": [ "native" ],
    "sleep_wasm.mbt": [ "wasm" ],
    "tcp_js.mbt": [ "js" ],
    "tcp_native.mbt": [ "native" ],
    "tcp_wasm.mbt": [ "wasm" ],
  },
)
