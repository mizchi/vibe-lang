import {
  "mizchi/x/http" @http,
  "moonbitlang/async/io" @async_io,
  "moonbitlang/async/process" @async_process,
  "moonbitlang/async" @async,
  "moonbitlang/core/ref" @ref,
}

options(
  "native-stub": [ "exec_popen.c", "tcp_stub.c" ],
  targets: {
    "exec_impl.mbt": [ "native" ],
    "exec_stub.mbt": [ "js", "wasm", "wasm-gc" ],
    "http_impl.mbt": [ "native" ],
    "http_js.mbt": [ "js" ],
    "http_wasm.mbt": [ "wasm", "wasm-gc" ],
    "sleep_js.mbt": [ "js" ],
    "sleep_native.mbt": [ "native" ],
    "sleep_wasm.mbt": [ "wasm", "wasm-gc" ],
    "tcp_js.mbt": [ "js" ],
    "tcp_native.mbt": [ "native" ],
    "tcp_wasm.mbt": [ "wasm", "wasm-gc" ],
  },
)
