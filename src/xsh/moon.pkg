import {
  "mizchi/bit" as @bit,
  "mizchi/cst" as @cst,
  "mizchi/ripple" as @ripple,
  "mizchi/xsh/capability" as @capability,
  "mizchi/xsh/codegen" as @codegen,
  "mizchi/xsh/core" as @core,
  "mizchi/xsh/checker" as @checker,
  "mizchi/xsh/parser" as @parser,
  "moonbitlang/core/encoding/utf8" as @utf8,
  "moonbitlang/core/strconv" as @strconv,
  "moonbitlang/x/fs" as @os_fs,
  "moonbitlang/x/path" as @path,
  "moonbitlang/core/json" as @json,
  "moonbitlang/core/bench" as @bench,
}

options(
  targets: {
    "sleep_js.mbt": [ "js" ],
    "sleep_native.mbt": [ "native" ],
    "sleep_wasm.mbt": [ "wasm" ],
  },
)