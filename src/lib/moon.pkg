import {
  "mizchi/vibe/checker" @checker,
  "mizchi/vibe/core" @core,
  "mizchi/vibe/fs" @vibe_fs,
  "mizchi/vibe/frontend" @frontend,
  "mizchi/vibe/parser" @parser,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/ref" @ref,
}

options(
  link: {
    "wasm-gc": {
      "export-memory-name": "memory",
      "exports": [
        "vibe_check",
        "vibe_init",
        "vibe_check_project",
        "vibe_format",
        "vibe_ide_outline",
        "vibe_ide_peek_def",
        "vibe_ide_search",
      ],
    },
  },
  targets: { "lib.mbt": [ "wasm-gc" ], "lib_wbtest.mbt": [ "wasm-gc" ] },
)
