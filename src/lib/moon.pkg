import {
  "mizchi/xsh/checker" @checker,
  "mizchi/xsh/core" @core,
  "mizchi/xsh/fs" @xsh_fs,
  "mizchi/xsh/frontend" @frontend,
  "mizchi/xsh/parser" @parser,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/ref" @ref,
}

options(
  link: {
    "wasm-gc": {
      "export-memory-name": "memory",
      "exports": [
        "xsh_check",
        "xsh_init",
        "xsh_check_project",
        "xsh_format",
        "xsh_ide_outline",
        "xsh_ide_peek_def",
        "xsh_ide_search",
      ],
    },
  },
  targets: { "lib.mbt": [ "wasm-gc" ], "lib_wbtest.mbt": [ "wasm-gc" ] },
)
