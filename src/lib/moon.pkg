import {
  "mizchi/vibe/checker",
  "mizchi/vibe/core",
  "mizchi/vibe/fs" @vibe_fs,
  "mizchi/vibe/frontend",
  "mizchi/vibe/parser",
  "moonbitlang/core/json",
  "moonbitlang/core/ref",
}

warnings = "-29"

options(
  link: {
    "wasm-gc": {
      "export-memory-name": "memory",
      "exports": [
        "vibe_check",
        "vibe_init",
        "vibe_check_project",
        "vibe_format",
        "vibe_ide_outline",
        "vibe_ide_peek_def",
        "vibe_ide_search",
      ],
    },
  },
  targets: {
    "lib.mbt": [ "wasm-gc" ],
    "lib_wbtest.mbt": [ "wasm-gc" ],
    "report_json.mbt": [ "wasm-gc" ],
  },
)
