{
  "name": "vscode-vibe",
  "displayName": "Vibe Language",
  "description": "Syntax highlighting and language support for the Vibe programming language",
  "version": "0.1.0",
  "publisher": "mizchi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizchi/vibe-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vibe"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "configuration": {
      "title": "Vibe",
      "properties": {
        "vibe.serverPath": {
          "type": "string",
          "default": "vibe",
          "description": "Path to the `vibe` launcher used to start the LSP server (`vibe lsp`)."
        }
      }
    },
    "languages": [
      {
        "id": "vibe",
        "aliases": [
          "Vibe",
          "vibe"
        ],
        "extensions": [
          ".vibe"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vibe",
        "scopeName": "source.vibe",
        "path": "./syntaxes/vibe.tmLanguage.json"
      }
    ]
  }
}
