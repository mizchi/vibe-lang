{
  "name": "vscode-vibe",
  "displayName": "Vibe Language",
  "description": "Syntax highlighting and language support for the Vibe programming language",
  "version": "0.1.0",
  "publisher": "mizchi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mizchi/vibe-lang"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vibe",
        "aliases": [
          "Vibe",
          "vibe"
        ],
        "extensions": [
          ".vibe"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vibe",
        "scopeName": "source.vibe",
        "path": "./syntaxes/vibe.tmLanguage.json"
      }
    ]
  }
}
