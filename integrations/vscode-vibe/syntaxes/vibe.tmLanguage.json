{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vibe",
  "scopeName": "source.vibe",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.vibe",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.raw.vibe",
          "begin": "r\"",
          "end": "\"",
          "patterns": []
        },
        {
          "name": "string.quoted.double.vibe",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.vibe",
              "match": "\\\\[\"\\\\ntr0]"
            },
            {
              "name": "meta.interpolation.vibe",
              "begin": "\\\\\\(",
              "end": "\\)",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.vibe" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.vibe" }
              },
              "patterns": [
                { "include": "source.vibe" }
              ]
            },
            {
              "name": "meta.interpolation.vibe",
              "begin": "\\\\\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.vibe" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.vibe" }
              },
              "patterns": [
                { "include": "source.vibe" }
              ]
            }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.vibe",
          "match": "'(\\\\['\\\\.ntr0]|[^'\\\\])'",
          "captures": {
            "1": { "name": "constant.character.vibe" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.vibe",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.float.vibe",
          "match": "\\b[0-9]+\\.[0-9]+f?\\b"
        },
        {
          "name": "constant.numeric.integer.vibe",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.vibe",
          "match": "\\b(if|else|while|for|in|loop|do|match|break|continue|return|handle|with|throw|raise|yield)\\b"
        },
        {
          "name": "keyword.declaration.vibe",
          "match": "\\b(let|fn|rec|type|struct|enum|trait|impl|module|open)\\b"
        },
        {
          "name": "keyword.other.vibe",
          "match": "\\b(export|import|declare|test|bench|derive|as|mut|suberror|from)\\b"
        },
        {
          "name": "constant.language.boolean.vibe",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "variable.language.vibe",
          "match": "\\b(not)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.vibe",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        },
        {
          "name": "entity.name.namespace.vibe",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.vibe",
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.vibe" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.vibe",
          "match": "->|=>"
        },
        {
          "name": "keyword.operator.pipe.vibe",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.comparison.vibe",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.logical.vibe",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.bitwise.vibe",
          "match": "<<|>>|&|\\||\\^|~"
        },
        {
          "name": "keyword.operator.assignment.vibe",
          "match": "\\+=|-=|\\*=|/=|%=|="
        },
        {
          "name": "keyword.operator.arithmetic.vibe",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.namespace.vibe",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.vibe",
          "match": "\\.\\.\\.?"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.vibe",
          "match": "[,;]"
        },
        {
          "name": "punctuation.accessor.vibe",
          "match": "\\."
        },
        {
          "name": "punctuation.section.braces.begin.vibe",
          "match": "\\{"
        },
        {
          "name": "punctuation.section.braces.end.vibe",
          "match": "\\}"
        },
        {
          "name": "punctuation.section.brackets.begin.vibe",
          "match": "\\["
        },
        {
          "name": "punctuation.section.brackets.end.vibe",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.vibe",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.vibe",
          "match": "\\)"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.vibe",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
