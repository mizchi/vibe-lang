let step_a: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 3), 7) % 104729 }
}

let step_b: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 5), 11) % 104729 }
}

let step_c: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 7), 13) % 104729 }
}

let step_d: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 11), 17) % 104729 }
}

let step_e: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 13), 19) % 104729 }
}

let step_f: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 17), 23) % 104729 }
}

let step_g: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 19), 29) % 104729 }
}

let step_h: (Int) -> Int with Exception = (x) -> {
  if x < 0 { throw("negative")} else { add(mul(x, 23), 31) % 104729 }
}

let chain8: (Int) -> Int with Exception = (x) -> {
  let a = step_a(x)
  let b = step_b(a)
  let c = step_c(b)
  let d = step_d(c)
  let e = step_e(d)
  let f = step_f(e)
  let g = step_g(f)
  step_h(g)
}

let compose_ab: (Int) -> Int with Exception = (x) -> {
  add(step_a(x), step_b(x)) % 104729
}

let compose_cd: (Int) -> Int with Exception = (x) -> {
  add(step_c(x), step_d(x)) % 104729
}

let compose_ef: (Int) -> Int with Exception = (x) -> {
  add(step_e(x), step_f(x)) % 104729
}

let compose_gh: (Int) -> Int with Exception = (x) -> {
  add(step_g(x), step_h(x)) % 104729
}

let compose_all: (Int) -> Int with Exception = (x) -> {
  let ab = compose_ab(x)
  let cd = compose_cd(ab)
  let ef = compose_ef(cd)
  compose_gh(ef)
}

let chain8_safe: (Int) -> Int = (x) -> {
  let abs_x = if x < 0 { mul(x, -1) } else { x }
  let a = add(mul(abs_x, 3), 7) % 104729
  let b = add(mul(a, 5), 11) % 104729
  let c = add(mul(b, 7), 13) % 104729
  let d = add(mul(c, 11), 17) % 104729
  let e = add(mul(d, 13), 19) % 104729
  let f = add(mul(e, 17), 23) % 104729
  let g = add(mul(f, 19), 29) % 104729
  add(mul(g, 23), 31) % 104729
}

let compose_all_safe: (Int) -> Int = (x) -> {
  let abs_x = if x < 0 { mul(x, -1) } else { x }
  let ab = add(add(mul(abs_x, 3), 7), add(mul(abs_x, 5), 11)) % 104729
  let cd = add(add(mul(ab, 7), 13), add(mul(ab, 11), 17)) % 104729
  let ef = add(add(mul(cd, 13), 19), add(mul(cd, 17), 23)) % 104729
  add(add(mul(ef, 19), 29), add(mul(ef, 23), 31)) % 104729
}

// Module-level `let mut` is not assignable from bench blocks;
// memoized module-level Array cells carry the cross-iteration state.
let seed_cell = [42]

bench "effect_chain" {
  Array::set(seed_cell, 0, chain8_safe(Array::get(seed_cell, 0)))
  let _ = 1000003 / (add(1, Array::get(seed_cell, 0) % 1000))
}

bench "effect_compose" {
  Array::set(seed_cell, 0, compose_all_safe(Array::get(seed_cell, 0)))
  let _ = 1000003 / (add(1, Array::get(seed_cell, 0) % 1000))
}
