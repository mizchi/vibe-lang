let step_a = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 3), 7) % 104729 }
}

let step_b = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 5), 11) % 104729 }
}

let step_c = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 7), 13) % 104729 }
}

let step_d = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 11), 17) % 104729 }
}

let step_e = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 13), 19) % 104729 }
}

let step_f = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 17), 23) % 104729 }
}

let step_g = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 19), 29) % 104729 }
}

let step_h = (x: Int) -> Int with {Error} {
  if x < 0 { raise "negative" } else { add(mul(x, 23), 31) % 104729 }
}

let chain8 = (x: Int) -> Int with {Error} {
  let a = step_a(x)
  let b = step_b(a)
  let c = step_c(b)
  let d = step_d(c)
  let e = step_e(d)
  let f = step_f(e)
  let g = step_g(f)
  step_h(g)
}

let compose_ab = (x: Int) -> Int with {Error} {
  add(step_a(x), step_b(x)) % 104729
}

let compose_cd = (x: Int) -> Int with {Error} {
  add(step_c(x), step_d(x)) % 104729
}

let compose_ef = (x: Int) -> Int with {Error} {
  add(step_e(x), step_f(x)) % 104729
}

let compose_gh = (x: Int) -> Int with {Error} {
  add(step_g(x), step_h(x)) % 104729
}

let compose_all = (x: Int) -> Int with {Error} {
  let ab = compose_ab(x)
  let cd = compose_cd(ab)
  let ef = compose_ef(cd)
  compose_gh(ef)
}

let chain8_safe = (x: Int) -> Int {
  let abs_x = if x < 0 { mul(x, -1) } else { x }
  let a = add(mul(abs_x, 3), 7) % 104729
  let b = add(mul(a, 5), 11) % 104729
  let c = add(mul(b, 7), 13) % 104729
  let d = add(mul(c, 11), 17) % 104729
  let e = add(mul(d, 13), 19) % 104729
  let f = add(mul(e, 17), 23) % 104729
  let g = add(mul(f, 19), 29) % 104729
  add(mul(g, 23), 31) % 104729
}

let compose_all_safe = (x: Int) -> Int {
  let abs_x = if x < 0 { mul(x, -1) } else { x }
  let ab = add(add(mul(abs_x, 3), 7), add(mul(abs_x, 5), 11)) % 104729
  let cd = add(add(mul(ab, 7), 13), add(mul(ab, 11), 17)) % 104729
  let ef = add(add(mul(cd, 13), 19), add(mul(cd, 17), 23)) % 104729
  add(add(mul(ef, 19), 29), add(mul(ef, 23), 31)) % 104729
}

let mut seed = 42

bench "effect_chain" {
  seed = chain8_safe(seed)
  let _ = div(1000003, add(1, seed % 1000))
}

bench "effect_compose" {
  seed = compose_all_safe(seed)
  let _ = div(1000003, add(1, seed % 1000))
}
