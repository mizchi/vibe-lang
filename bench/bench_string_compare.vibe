// String lex compare throughput (SIMD common-prefix skip). `<` is the
// codegen primitive behind String::compare (prelude: a<b / a>b).
let rec repeat : (String, Int) -> String = (s, n) -> { if n == 0 { "" } else { String::concat(s, repeat(s, n - 1)) } }
// 1024B, differ only in the last byte: maximal common prefix scanned.
let a = String::concat(repeat("0123456789abcdef", 63), "0123456789abcdeA")
let b = String::concat(repeat("0123456789abcdef", 63), "0123456789abcdeB")
let rec lt_count : (String, String, Int, Int) -> Int = (x, y, n, acc) -> {
  if n == 0 { acc } else { lt_count(x, y, n - 1, acc + (if x < y { 1 } else { 0 })) }
}
bench "lex_lt/1024B-diff-last" { let _ = lt_count(a, b, 300, 0) }
