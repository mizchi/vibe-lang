let mix1: (Int) -> Int = (x) -> {
  add(mul(x, 3), 11)
}

let mix2: (Int) -> Int = (x) -> {
  add(mul(x, 5), 17)
}

let mix3: (Int) -> Int = (x) -> {
  add(mul(x, 7), 23)
}

let mix4: (Int) -> Int = (x) -> {
  add(mul(x, 11), 29)
}

let mix5: (Int) -> Int = (x) -> {
  add(mul(x, 13), 31)
}

let mix6: (Int) -> Int = (x) -> {
  add(mul(x, 17), 37)
}

let mix7: (Int) -> Int = (x) -> {
  add(mul(x, 19), 41)
}

let mix8: (Int) -> Int = (x) -> {
  add(mul(x, 23), 43)
}

let pipeline: (Int) -> Int = (x) -> {
  let a = mix1(x) % 104729
  let b = mix2(a) % 104729
  let c = mix3(b) % 104729
  let d = mix4(c) % 104729
  let e = mix5(d) % 104729
  let f = mix6(e) % 104729
  let g = mix7(f) % 104729
  mix8(g) % 104729
}

let pair_mix: (Int, Int) -> Int = (a, b) -> {
  let x = a % b
  let y = add(mul(x, 97), mul(a, 13))
  y % 104729
}

// Module-level `let mut` is not assignable from bench blocks;
// memoized module-level Array cells carry the cross-iteration seeds.
let seed_a_cell = [17]
let seed_b_cell = [123456]

bench "pipeline_a" {
  Array::set(seed_a_cell, 0, pipeline(Array::get(seed_a_cell, 0)))
  let _ = 1000003 / add(1, Array::get(seed_a_cell, 0) % 1000)
}

bench "pipeline_b" {
  Array::set(seed_b_cell, 0, pipeline(add(Array::get(seed_b_cell, 0), 97)))
  let _ = 1000003 / add(1, Array::get(seed_b_cell, 0) % 1000)
}

bench "pair_mix_ab" {
  Array::set(seed_a_cell, 0, pair_mix(Array::get(seed_a_cell, 0), add(Array::get(seed_b_cell, 0), 1)))
  Array::set(seed_b_cell, 0, pair_mix(Array::get(seed_b_cell, 0), add(Array::get(seed_a_cell, 0), 1)))
  let _ = 1000003 / add(1, Array::get(seed_a_cell, 0) % 1000)
}

bench "cross_mix" {
  let x = pipeline(add(Array::get(seed_a_cell, 0), Array::get(seed_b_cell, 0)))
  Array::set(seed_a_cell, 0, x)
  Array::set(seed_b_cell, 0, pair_mix(Array::get(seed_b_cell, 0), add(x, 1)))
  let _ = 1000003 / add(1, Array::get(seed_b_cell, 0) % 1000)
}
