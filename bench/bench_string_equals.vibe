let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s = s, n = sub(n, 1)))
  }
}

let rec eq_loop: (String, String, Int, Int) -> Int = (a, b, i, acc) -> {
  if eq(i, 0) {
    acc
  } else {
    let ok = String::equals(a, b)
    let next = if ok { add(acc, 1) } else { acc }
    eq_loop(a = a, b = b, i = sub(i, 1), acc = next)
  }
}

let base = repeat(s = "abcd", n = 80)
let same = String::concat(base, "z")
let diff = String::concat(base, "y")
let a = eq_loop(a = same, b = same, i = 200, acc = 0)
let b = eq_loop(a = same, b = diff, i = 200, acc = 0)
let main = () -> Int {
  add(a, b)
}
