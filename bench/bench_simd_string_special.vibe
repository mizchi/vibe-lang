// #1868 Phase 1: isolate the fused scanner before wiring it into the lexer.
// Both lanes scan the same 1 KiB ordinary prefix and stop at the final quote.

fn make_long_string() -> String {
  let mut s = ""
  let mut i = 0
  while i < 64 {
    s = s + "abcdefghijklmnop"
    i = i + 1
  }
  s + "\""
}

fn scalar_scan(s: String, len: Int) -> Int {
  let mut i = 0
  let mut done = false
  while i < len && !done {
    let c = String::char_code_at(s, i)
    if c == 34 || c == 92 || c < 32 {
      done = true
    } else {
      i = i + 1
    }
  }
  i
}

let source = make_long_string()
let source_len = String::length(source)
let sink = [
  0
]

bench "string_special_1kb_simd" {
  Array::set(sink, 0, simd_scan_string_special_str(source, 0, source_len))
}

bench "string_special_1kb_scalar" {
  Array::set(sink, 0, scalar_scan(source, source_len))
}
