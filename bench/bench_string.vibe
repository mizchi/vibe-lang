let rec repeat = (s: String, n: Int) -> String {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s, sub(n, 1)))
  }
}

let rec sum_codes = (s: String, i: Int, acc: Int) -> Int {
  if lt(i, String::length(s)) {
    let code = String::char_code_at(s, i)
    sum_codes(s, add(i, 1), add(acc, code))
  } else {
    acc
  }
}

let base = "abcdefghijklmnopqrstuvwxyz"
let s = repeat(base, 40)
let t = String::substring(s, 5, sub(String::length(s), 5))
let u = String::concat(t, s)
let sum = sum_codes(u, 0, 0)
let ok = String::equals(u, u)
if ok { sum } else { 0 }
