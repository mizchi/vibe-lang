let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s = s, n = sub(n, 1)))
  }
}

let rec sum_codes: (String, Int, Int) -> Int = (s, i, acc) -> {
  if lt(i, String::length(s)) {
    let code = String::char_code_at(s, at = i)
    sum_codes(s = s, i = add(i, 1), acc = add(acc, code))
  } else {
    acc
  }
}

let base = "abcdefghijklmnopqrstuvwxyz"
let s = repeat(s = base, n = 40)
let t = String::substring(s, start = 5, end = sub(String::length(s), 5))
let u = String::concat(t, s)
let sum = sum_codes(s = u, i = 0, acc = 0)
let ok = String::equals(u, u)
let main = () -> Int {
  if ok { sum } else { 0 }
}
