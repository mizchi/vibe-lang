let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s = s, n = sub(n, 1)))
  }
}

let rec concat_loop: (String, Int) -> String = (s, i) -> {
  if eq(i, 0) {
    s
  } else {
    concat_loop(s = String::concat(s, "x"), i = sub(i, 1))
  }
}

let base = repeat(s = "abcdef", n = 40)
let out = concat_loop(s = base, i = 200)
let main = () -> Int {
  String::length(out)
}
