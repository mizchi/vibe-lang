let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s, sub(n, 1)))
  }
}

let rec concat_loop: (String, Int) -> String = (s, i) -> {
  if eq(i, 0) {
    s
  } else {
    concat_loop(String::concat(s, "x"), sub(i, 1))
  }
}

let base = repeat("abcdef", 40)
let out = concat_loop(base, 200)
let main = () -> Int {
  String::length(out)
}
