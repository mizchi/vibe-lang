// #1701: what does the reference lane actually buy at a boundary?
//
// The conversion-point decision (reference lane <-> tagged i64) has no cost
// evidence behind it -- ADR-0095 §7 open question 3 was never collected, because
// until #1541 landed nothing crossed a boundary on the reference lane at all.
// Now something does, so a baseline is measurable: run the SAME source on the
// linear lane and on the gc lane and compare.
//
//   vibe bench bench/regression/gc_boundary_bench.vibe                      # linear
//   VIBE_BENCH_BACKEND=gc vibe bench bench/regression/gc_boundary_bench.vibe # wasm-gc
//
// The shape here is deliberately the one #1541 ADMITS -- `let`-bound
// non-generic functions with concrete `Array[Int]` signatures and straight-line
// bodies -- so the gc numbers are the lane working rather than a silent
// fallback. That is a real constraint, not a stylistic choice: written the
// obvious way (a `while` loop carrying the array across the boundary) the lane
// declines and both backends run identical linear code, which measures nothing.
// Verify with `VIBE_BACKEND=gc` + `array.new_default` before trusting a delta.

let bump_first: (Array[Int]) -> Array[Int] = (values) -> {
  Array::set(values, 0, Array::get(values, 0) + 1)
  values
}

let sum_three: (Array[Int]) -> Int = (values) -> {
  Array::get(values, 0) + Array::get(values, 1) + Array::get(values, 2)
}

// One literal crossing six boundaries: three arguments in, three results out.
bench "boundary_cross_6" {
  let values = [
    1,
    2,
    3
  ]
  let _ = sum_three(bump_first(bump_first(bump_first(values))))
}

// Same crossings, but the literal is aliased first so the alias boundary
// (#1541 Phase B) is on the path too.
bench "boundary_alias_cross_6" {
  let values = [
    1,
    2,
    3
  ]
  let alias = values
  let _ = sum_three(bump_first(bump_first(bump_first(alias))))
}
