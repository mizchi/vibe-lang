// Construct the byte corpus before timing the fingerprint scanner.
import @vibe/cache {
  compact_string_fingerprint
}

fn corpus(repeats: Int) -> String {
  let mut source = "0123456789abcdef"
  let mut i = 0
  while i < repeats {
    source = String::concat(source, source)
    i = i + 1
  }
  source
}

let source_1k = corpus(6)
let source_64k = corpus(12)
let source_1m = corpus(16)

bench "compact_fingerprint_1k" {
  assert(String::length(compact_string_fingerprint(source_1k)) > 0)
}

bench "compact_fingerprint_64k" {
  assert(String::length(compact_string_fingerprint(source_64k)) > 0)
}

bench "compact_fingerprint_1m" {
  assert(String::length(compact_string_fingerprint(source_1m)) > 0)
}
