//# Browser checker baseline: parser-only ownerless root.
//
// This is a fixed build input, not a package boundary or public API.

import @vibe/parser {
  lex, parse_program
}

export fn main() -> Int {
  handle {
    let program = parse_program(lex("let answer: Int = 42"))
    Array::length(program)
  } with {
    Exception::Throw(_) => -1
  }
}
