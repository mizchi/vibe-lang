//# Browser checker baseline: current checker ownerless root.
//
// This is a fixed build input, not a package boundary or public API.

import @vibe/compiler/checker {
  check_program
}

import @vibe/parser {
  lex, parse_program
}

export fn main() -> Int {
  handle {
    let program = parse_program(lex("let answer: Int = 42"))
    let _ = check_program(program)
    0
  } with Exception {
    Throw(_) => -1
  }
}
