let mut sink = 0

bench "char_to_int_builtin" {
  sink = sink + char_to_int('Z')
}

bench "char_to_int_string_bridge" {
  sink = sink + string_char_code_at("Z", 0)
}

bench "char_from_int_builtin" {
  let ch = char_from_int(90)
  if ch == 'Z' {
    sink = sink + 1
  } else {
    sink = sink + 0
  }
}

bench "char_from_int_string_bridge" {
  let s = string_from_char_code(90)
  if string_equals(s, "Z") {
    sink = sink + 1
  } else {
    sink = sink + 0
  }
}
