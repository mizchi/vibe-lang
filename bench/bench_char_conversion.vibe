//# Functions

let mut sink = 0

let make_codes: (Int) -> Array[Int] = (n) -> {
  let acc = Array::slice([
    0
  ], 0, 0)
  let mut i = 0
  while i < n {
    Array::push(acc, 65 + (i % 26))
    i = i + 1
  }
  acc
}

let fcc_build: (Int) -> String = (n) -> {
  String::from_char_codes(make_codes(n))
}

let concat_build: (Int) -> String = (n) -> {
  let codes = make_codes(n)
  let mut acc = ""
  let mut i = 0
  while i < n {
    acc = String::concat(acc, String::from_char_code(Array::get(codes, i)))
    i = i + 1
  }
  acc
}

//# Misc

bench "char_to_int_builtin" {
  sink = sink + Char::to_int('Z')
}

bench "char_to_int_string_bridge" {
  sink = sink + String::char_code_at("Z", 0)
}

bench "char_from_int_builtin" {
  let ch = Char::from_int(90)
  if ch == 'Z' {
    sink = sink + 1
  } else {
    sink = sink + 0
  }
}

bench "char_from_int_string_bridge" {
  let s = String::from_char_code(90)
  if String::equals(s, "Z") {
    sink = sink + 1
  } else {
    sink = sink + 0
  }
}

bench "string_from_char_codes_4" {
  let s = String::from_char_codes([
    65,
    66,
    67,
    68
  ])
  sink = sink + String::char_code_at(s, 3)
}

bench "string_from_char_code_concat_4" {
  let s = String::concat(String::concat(String::from_char_code(65), String::from_char_code(66)), String::concat(String::from_char_code(67), String::from_char_code(68)))
  sink = sink + String::char_code_at(s, 3)
}

bench "string_from_char_codes_16" {
  let s = String::from_char_codes([
    65,
    66,
    67,
    68,
    69,
    70,
    71,
    72,
    73,
    74,
    75,
    76,
    77,
    78,
    79,
    80
  ])
  sink = sink + String::char_code_at(s, 15)
}

bench "fcc/n=4" {
  sink = sink + String::length(fcc_build(4))
}

bench "concat_tower/n=4" {
  sink = sink + String::length(concat_build(4))
}

bench "fcc/n=16" {
  sink = sink + String::length(fcc_build(16))
}

bench "concat_tower/n=16" {
  sink = sink + String::length(concat_build(16))
}

bench "fcc/n=64" {
  sink = sink + String::length(fcc_build(64))
}

bench "concat_tower/n=64" {
  sink = sink + String::length(concat_build(64))
}

bench "fcc/n=256" {
  sink = sink + String::length(fcc_build(256))
}

bench "concat_tower/n=256" {
  sink = sink + String::length(concat_build(256))
}
