let mut sink = 0

bench "char_to_int_builtin" {
  sink = sink + Char::to_int('Z')
}

bench "char_to_int_string_bridge" {
  sink = sink + String::char_code_at("Z", 0)
}

bench "char_from_int_builtin" {
  let ch = Char::from_int(90)
  if ch == 'Z' {
    sink = sink + 1
  } else {
    sink = sink + 0
  }
}

bench "char_from_int_string_bridge" {
  let s = String::from_char_code(90)
  if String::equals(s, "Z") {
    sink = sink + 1
  } else {
    sink = sink + 0
  }
}

bench "string_from_char_codes_4" {
  let s = String::from_char_codes([65, 66, 67, 68])
  sink = sink + String::char_code_at(s, 3)
}

bench "string_from_char_code_concat_4" {
  let s = String::concat(
    String::concat(String::from_char_code(65), String::from_char_code(66)),
    String::concat(String::from_char_code(67), String::from_char_code(68))
  )
  sink = sink + String::char_code_at(s, 3)
}

bench "string_from_char_codes_16" {
  let s = String::from_char_codes([
    65, 66, 67, 68, 69, 70, 71, 72, 73, 74, 75, 76, 77, 78, 79, 80
  ])
  sink = sink + String::char_code_at(s, 15)
}
