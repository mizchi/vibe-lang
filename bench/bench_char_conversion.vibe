//# Functions

// Module-level `let mut` is not assignable from bench blocks;
// a memoized module-level Array cell serves as the fold-defeating Array::get(sink_cell, 0).
let sink_cell = [0]

let make_codes: (Int) -> Array[Int] = (n) -> {
  let acc = Array::slice([
    0
  ], start = 0, end = 0)
  let mut i = 0
  while i < n {
    Array::push(acc, value = 65 + (i % 26))
    i = i + 1
  }
  acc
}

let from_codes: (Array[Int]) -> String = (codes) -> {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(codes) {
    StringBuilder::push(sb, value = String::from_char_code(Array::get(codes, at = i)))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

// String::from_char_codes is host-era; build via StringBuilder instead.
let fcc_build: (Int) -> String = (n) -> {
  let codes = make_codes(n = n)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(codes) {
    StringBuilder::push(sb, value = String::from_char_code(Array::get(codes, at = i)))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

let concat_build: (Int) -> String = (n) -> {
  let codes = make_codes(n = n)
  let mut acc = ""
  let mut i = 0
  while i < n {
    acc = String::concat(acc, String::from_char_code(Array::get(codes, at = i)))
    i = i + 1
  }
  acc
}

//# Misc

bench "char_to_int_builtin" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + Char::to_int('Z'))
}

bench "char_to_int_string_bridge" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::char_code_at("Z", at = 0))
}

bench "char_from_int_builtin" {
  let ch = Char::from_int(90)
  if Char::to_int(ch) == 90 {
    Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + 1)
  } else {
    Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + 0)
  }
}

bench "char_from_int_string_bridge" {
  let s = String::from_char_code(90)
  if String::equals(s, "Z") {
    Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + 1)
  } else {
    Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + 0)
  }
}

bench "string_from_char_codes_4" {
  let s = from_codes(codes = [
    65,
    66,
    67,
    68
  ])
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::char_code_at(s, at = 3))
}

bench "string_from_char_code_concat_4" {
  let s = String::concat(String::concat(String::from_char_code(65), String::from_char_code(66)), String::concat(String::from_char_code(67), String::from_char_code(68)))
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::char_code_at(s, at = 3))
}

bench "string_from_char_codes_16" {
  let s = from_codes(codes = [
    65,
    66,
    67,
    68,
    69,
    70,
    71,
    72,
    73,
    74,
    75,
    76,
    77,
    78,
    79,
    80
  ])
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::char_code_at(s, at = 15))
}

bench "fcc/n=4" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(fcc_build(n = 4)))
}

bench "concat_tower/n=4" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(concat_build(n = 4)))
}

bench "fcc/n=16" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(fcc_build(n = 16)))
}

bench "concat_tower/n=16" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(concat_build(n = 16)))
}

bench "fcc/n=64" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(fcc_build(n = 64)))
}

bench "concat_tower/n=64" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(concat_build(n = 64)))
}

bench "fcc/n=256" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(fcc_build(n = 256)))
}

bench "concat_tower/n=256" {
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + String::length(concat_build(n = 256)))
}
