let classify_int = (x: Int) -> Int {
  let tag = x % 8
  match tag {
    0 => mul(x, 2) % 104729,
    1 => add(x, 100) % 104729,
    2 => sub(mul(x, 3), 7) % 104729,
    3 => add(mul(x, 5), 50) % 104729,
    4 => mul(add(x, 1), 5) % 104729,
    5 => add(mul(x, 7), 13) % 104729,
    6 => sub(mul(x, 11), 23) % 104729,
    _ => add(x, 42) % 104729
  }
}

let dispatch_pair = (x: Int, y: Int) -> Int {
  let tx = x % 4
  match tx {
    0 => add(x, mul(y, 3)) % 104729,
    1 => mul(x, add(y, 7)) % 104729,
    2 => sub(mul(x, 5), y) % 104729,
    _ => add(mul(x, 2), mul(y, 11)) % 104729
  }
}

let nested_dispatch = (x: Int, y: Int) -> Int {
  let tx = x % 4
  let ty = y % 4
  match tx {
    0 => match ty {
      0 => add(x, y) % 104729,
      1 => mul(x, add(y, 1)) % 104729,
      2 => add(mul(x, 3), y) % 104729,
      _ => sub(mul(x, 5), y) % 104729
    },
    1 => match ty {
      0 => sub(mul(x, 2), y) % 104729,
      1 => add(x, mul(y, 7)) % 104729,
      2 => mul(add(x, y), 3) % 104729,
      _ => add(x, sub(y, 1)) % 104729
    },
    2 => match ty {
      0 => mul(x, add(y, 3)) % 104729,
      1 => sub(x, mul(y, 2)) % 104729,
      2 => add(mul(x, 11), mul(y, 13)) % 104729,
      _ => mul(sub(x, y), 7) % 104729
    },
    _ => match ty {
      0 => add(mul(x, 7), y) % 104729,
      1 => sub(x, add(y, 10)) % 104729,
      2 => mul(add(x, 1), add(y, 1)) % 104729,
      _ => add(x, add(y, 42)) % 104729
    }
  }
}

let abs_mod = (x: Int, m: Int) -> Int {
  let r = x % m
  if r < 0 { add(r, m) } else { r }
}

let mut seed_x = 17
let mut seed_y = 31

bench "match_dispatch" {
  seed_x = classify_int(seed_x)
  seed_y = dispatch_pair(seed_x, seed_y)
  let _ = div(1000003, add(1, abs_mod(seed_x, 1000)))
}

bench "nested_branch" {
  seed_x = nested_dispatch(seed_x, seed_y)
  seed_y = nested_dispatch(seed_y, seed_x)
  seed_x = classify_int(seed_x)
  seed_y = classify_int(seed_y)
  let _ = div(1000003, add(1, abs_mod(add(seed_x, seed_y), 1000)))
}
