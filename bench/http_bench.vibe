
// Run with: pkf run bench-http (starts tests/http_echo_server.py).
// #1508: public client builtins are direct host imports. Each block declares
// only the client operations it performs; the default test/bench row supplies
// Env for the worktree-local echo-server port.

fn echo_base_url() -> String with Env {
  let port = Env::get("VIBE_HTTP_ECHO_PORT")
  let effective_port = if String::length(port) > 0 { port } else { "18281" }
  String::concat("http://127.0.0.1:", effective_port)
}

bench "http_get_hello" with Http::request + Http::response_status + Http::response_body + Http::close {
  let h = Http::request("GET", String::concat(echo_base_url(), "/hello"), "", "")
  let _ = Http::response_status(h)
  let _ = Http::response_body(h)
  Http::close(h)
}

bench "http_post_echo_small" with Http::request + Http::response_status + Http::response_body + Http::close {
  let h = Http::request("POST", String::concat(echo_base_url(), "/echo"), "", "hello")
  let _ = Http::response_status(h)
  let _ = Http::response_body(h)
  Http::close(h)
}

bench "http_post_echo_1kb" with Http::request + Http::response_status + Http::response_body + Http::close {
  let payload = ""
  let h = Http::request("POST", String::concat(echo_base_url(), "/echo"), "", payload)
  let _ = Http::response_status(h)
  let _ = Http::response_body(h)
  Http::close(h)
}

bench "http_get_headers" with Http::request + Http::response_status + Http::response_body + Http::close {
  let h = Http::request("GET", String::concat(echo_base_url(), "/headers"), "X-Custom: test-value", "")
  let _ = Http::response_status(h)
  let _ = Http::response_body(h)
  Http::close(h)
}
