
// Requires: python3 tests/http_echo_server.py 18281
// Uses builtins directly (http_request etc.) since bench/ can't import vibe/http

bench "http_get_hello" {
  let h = http_request("GET", "http://127.0.0.1:18281/hello", "", "")
  let _ = http_response_status(h)
  let _ = http_response_body(h)
  http_close(h)
}

bench "http_post_echo_small" {
  let h = http_request("POST", "http://127.0.0.1:18281/echo", "", "hello")
  let _ = http_response_status(h)
  let _ = http_response_body(h)
  http_close(h)
}

bench "http_post_echo_1kb" {
  let payload = ""
  let h = http_request("POST", "http://127.0.0.1:18281/echo", "", payload)
  let _ = http_response_status(h)
  let _ = http_response_body(h)
  http_close(h)
}

bench "http_get_headers" {
  let h = http_request("GET", "http://127.0.0.1:18281/headers", "X-Custom: test-value", "")
  let _ = http_response_status(h)
  let _ = http_response_body(h)
  http_close(h)
}
