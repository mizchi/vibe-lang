// bench/exec scenario: Bytes + bit manipulation — base64 encode of a
// generated byte buffer, shift/mask heavy inner loop.
// Deterministic output; see bench/exec/README.md.

fn b64_char(v: Int) -> Int {
  if v < 26 {
    65 + v
  } else if v < 52 {
    97 + v - 26
  } else if v < 62 {
    48 + v - 52
  } else if v == 62 {
    43
  } else {
    47
  }
}

fn encode(data: Bytes) -> String {
  let out = Bytes::new()
  let n = Bytes::length(data)
  let mut i = 0
  while i + 2 < n {
    let b0 = Bytes::get(data, i)
    let b1 = Bytes::get(data, i + 1)
    let b2 = Bytes::get(data, i + 2)
    let group = ((b0<<16)|(b1<<8))|b2
    Bytes::push(out, b64_char((group>>18)&63))
    Bytes::push(out, b64_char((group>>12)&63))
    Bytes::push(out, b64_char((group>>6)&63))
    Bytes::push(out, b64_char(group&63))
    i = i + 3
  }
  let mut s = ""
  let m = Bytes::length(out)
  let mut j = 0
  while j < m {
    s = String::concat(s, String::from_char_code(Bytes::get(out, j)))
    j = j + 1
  }
  s
}

let main = () -> Int with Stdout {
  let data = Bytes::new()
  let mut seed = 7
  let mut i = 0
  while i < 1500 {
    seed = (seed * 48271) % 2147483647
    Bytes::push(data, seed % 256)
    i = i + 1
  }
  let encoded = encode(data)
  let mut h = 0
  let mut k = 0
  while k < String::length(encoded) {
    h = (h * 33 + String::char_code_at(encoded, k)) % 1000000007
    k = k + 1
  }
  println(Int::to_string(Bytes::length(data)))
  println(Int::to_string(String::length(encoded)))
  println(String::substring(encoded, 0, 24))
  println(Int::to_string(h))
  0
}
