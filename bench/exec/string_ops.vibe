// bench/exec scenario: string workload — growth by concat, substring/index_of
// scanning, split/join round-trip. Deterministic output; see bench/exec/README.md.

fn checksum(_ s: String) -> Int {
  let mut h = 7
  let mut i = 0
  let n = String::length(s)
  while i < n {
    h = (h * 31 + String::char_code_at(s, at = i)) % 1000000007
    i = i + 1
  }
  h
}

fn build_words(_ n: Int) -> String {
  let mut s = ""
  let mut i = 0
  while i < n {
    s = String::concat(s, "w")
    s = String::concat(s, Int::to_string(i % 97))
    s = String::concat(s, ",")
    i = i + 1
  }
  s
}

fn scan_needles(_ s: String) -> Int {
  let mut found = 0
  let mut probe = 0
  while probe < 90 {
    let needle = String::concat("w", Int::to_string(probe))
    if String::index_of(s, needle = needle) >= 0 {
      found = found + 1
    }
    probe = probe + 3
  }
  found
}

let main = () -> Int with Console {
  let s = build_words(400)
  let parts = String::split(s, sep = ",")
  let mut sub_hash = 0
  let mut i = 0
  while i + 8 < String::length(s) {
    sub_hash = (sub_hash + checksum(String::substring(s, start = i, end = i + 8))) % 1000000007
    i = i + 61
  }
  println(Int::to_string(String::length(s)))
  println(Int::to_string(Array::length(parts)))
  println(Int::to_string(scan_needles(s)))
  println(Int::to_string(sub_hash))
  println(Int::to_string(checksum(s)))
  0
}
