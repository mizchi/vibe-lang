// bench/exec scenario: closures + higher-order functions — map/filter/fold
// pipelines with capturing lambdas, indirect calls through function values.
// Deterministic output; see bench/exec/README.md.

fn apply_n(f: (Int) -> Int, x: Int, n: Int) -> Int {
  let mut acc = x
  let mut i = 0
  while i < n {
    acc = f(acc)
    i = i + 1
  }
  acc
}

let main = () -> Int with Stdout {
  let xs: Array[Int] = [
  ]
  let mut i = 0
  while i < 2000 {
    Array::push(xs, i)
    i = i + 1
  }
  let offset = 3
  let shifted = Array::map(xs, (x) -> Int {
    x * 2 + offset
  })
  let kept = Array::filter(shifted, (x) -> Bool {
    x % 7 != 0
  })
  let total = Array::fold(kept, 0, (acc, x) -> Int {
    (acc + x) % 1000000007
  })
  let step = (x: Int) -> Int {
    (x * 31 + 1) % 65536
  }
  let walked = apply_n(step, 1, 5000)
  let evens = for x in kept {
    x % 2
  }
  let even_sum = Array::fold(evens, 0, (a, b) -> Int {
    a + b
  })
  println(Int::to_string(Array::length(shifted)))
  println(Int::to_string(Array::length(kept)))
  println(Int::to_string(total))
  println(Int::to_string(walked))
  println(Int::to_string(even_sum))
  0
}
