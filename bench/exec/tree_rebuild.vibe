// bench/exec scenario: functional-but-in-place tree rebuilds (ADR-0092 /
// #2389 Perceus reuse). Every transform below decomposes a unique tree with
// `match` and rebuilds a same-size node; on the RC lane the reuse fusion
// rewrites the block in place instead of drop + fresh alloc. The shapes are
// the ones the fusion tiers distinguish:
//   incr_tail   the constructor is the arm's tail (narrow fusion)
//   mirror      the constructor sits in an `if` branch (wide fusion, the
//               consumer is not the tail; both branches consume)
//   clamp       one branch rebuilds at the SAME size, the other at a
//               different size (the token is released on that path)
//   weigh       a held bind: `l` is read (borrow) and stored (consume)
//   incr_shared the SAME rebuild as incr_tail but the caller keeps the
//               source alive, so every uniqueness test fails and the arm
//               takes the shared path (dup + fresh alloc) -- the control
// Deterministic output; see bench/exec/README.md.

enum Tree {
  Leaf(Int);
  Node(Tree, Tree)
}

fn build(depth: Int, salt: Int) -> Tree {
  if depth <= 0 {
    Leaf((salt * 48271) % 2147483647 % 1000)
  } else {
    Node(build(depth = depth - 1, salt = salt * 2 + 1), build(depth = depth - 1, salt = salt * 3 + 2))
  }
}

fn checksum(t: Tree, acc: Int) -> Int {
  match t {
    Leaf(v) => (acc * 31 + v) % 1000000007,
    Node(l, r) => checksum(t = r, acc = checksum(t = l, acc = acc))
  }
}

fn incr_tail(_ t: Tree) -> Tree {
  match t {
    Leaf(v) => Leaf((v + 1) % 1000),
    Node(l, r) => {
      let l2 = incr_tail(l)
      let r2 = incr_tail(r)
      Node(l2, r2)
    }
  }
}

fn mirror(t: Tree, d: Int) -> Tree {
  match t {
    Leaf(v) => Leaf((v + 3) % 1000),
    Node(l, r) => {
      let l2 = mirror(t = l, d = d + 1)
      let r2 = mirror(t = r, d = d + 1)
      if d % 2 == 0 {
        Node(r2, l2)
      } else {
        Node(l2, r2)
      }
    }
  }
}

fn clamp(t: Tree, d: Int) -> Tree {
  match t {
    Leaf(v) => Leaf((v + 7) % 1000),
    Node(l, r) => {
      let l2 = clamp(t = l, d = d - 1)
      let r2 = clamp(t = r, d = d - 1)
      if d > 0 {
        Node(l2, r2)
      } else {
        Leaf(checksum(t = l2, acc = checksum(t = r2, acc = 0)) % 1000)
      }
    }
  }
}

fn weigh(_ t: Tree) -> Tree {
  match t {
    Leaf(v) => Leaf((v + 11) % 1000),
    Node(l, r) => {
      let w = checksum(t = l, acc = 0)
      let r2 = weigh(r)
      if w % 2 == 0 {
        Node(l, r2)
      } else {
        Node(r2, l)
      }
    }
  }
}

let main = () -> Int with Console {
  let mut total = 0
  let mut round = 1
  while round <= 12 {
    // unique chains: every rebuild's input dies at the rebuild
    let a = incr_tail(incr_tail(incr_tail(build(depth = 11, salt = round))))
    total = (total + checksum(t = a, acc = 0)) % 1000000007
    let b = mirror(t = mirror(t = mirror(t = build(depth = 11, salt = round + 100), d = 0), d = 1), d = 0)
    total = (total + checksum(t = b, acc = 0)) % 1000000007
    let c = clamp(t = clamp(t = build(depth = 11, salt = round + 200), d = 8), d = 6)
    total = (total + checksum(t = c, acc = 0)) % 1000000007
    let e = weigh(weigh(weigh(build(depth = 11, salt = round + 300))))
    total = (total + checksum(t = e, acc = 0)) % 1000000007
    // shared control: `s` stays alive across the rebuild, so nothing reuses
    let s = build(depth = 11, salt = round + 400)
    let u = incr_tail(incr_tail(incr_tail(s)))
    total = (total + checksum(t = s, acc = 0) + checksum(t = u, acc = 0)) % 1000000007
    round = round + 1
  }
  println(Int::to_string(total))
  0
}
