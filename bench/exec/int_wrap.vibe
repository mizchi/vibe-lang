// bench/exec scenario: Int overflow wrap — #1877 pinned Int arithmetic to
// 62-bit two's-complement wrap on every backend; this scenario keeps the
// contract parity-guarded (linear vs gc stdout must stay identical) and
// makes the renormalization cost visible in the fuel numbers.
// Deterministic output; see bench/exec/README.md.

fn opaque(x: Int) -> Int {
  x + 0
}

let main = () -> Int {
  let b60 = opaque(1152921504606846976)
  let max = opaque(2305843009213693951)
  println(Int::to_string(b60 + b60))
  println(Int::to_string(max + max))
  println(Int::to_string(b60 * opaque(3)))
  println(Int::to_string(b60 * opaque(4)))
  println(Int::to_string(0 - max - max))
  println(Int::to_string(max<<opaque(1)))
  // A 64-bit-style LCG now has defined wrap semantics: iterate it hard and
  // fold the trajectory into a checksum every lane must agree on.
  let mut h = opaque(88172645463325252)
  let mut acc = 0
  let mut i = 0
  while i < 50000 {
    h = h * 6364136223846793 + 1442695040888963
    acc = (acc + (h % 1000003)) % 1000000007
    i = i + 1
  }
  println(Int::to_string(h))
  println(Int::to_string(acc))
  0
}
