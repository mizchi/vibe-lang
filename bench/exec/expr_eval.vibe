// bench/exec scenario: algebraic data types + recursive interpreter — a small
// expression tree built programmatically, evaluated by structural match.
// Deterministic output; see bench/exec/README.md.

enum Expr {
  Num(Int);
  Add(Expr, Expr);
  Mul(Expr, Expr);
  Neg(Expr);
  IfPos(Expr, Expr, Expr)
}

fn build(depth: Int, salt: Int) -> Expr {
  if depth <= 0 {
    Num((salt * 7 + 3) % 101 - 50)
  } else {
    let l = build(depth - 1, salt * 2 + 1)
    let r = build(depth - 1, salt * 3 + 2)
    let pick = salt % 4
    if pick == 0 {
      Add(l, r)
    } else if pick == 1 {
      Mul(l, Num(salt % 5 - 2))
    } else if pick == 2 {
      Neg(Add(l, r))
    } else {
      IfPos(l, r, Neg(r))
    }
  }
}

fn eval(e: Expr) -> Int {
  match e {
    Num(v) => v,
    Add(a, b) => (eval(a) + eval(b)) % 1000000007,
    Mul(a, b) => (eval(a) * eval(b)) % 1000000007,
    Neg(a) => 0 - eval(a),
    IfPos(c, t, f) => if eval(c) > 0 {
      eval(t)
    } else {
      eval(f)
    }
  }
}

fn size(e: Expr) -> Int {
  match e {
    Num(_) => 1,
    Add(a, b) => 1 + size(a) + size(b),
    Mul(a, b) => 1 + size(a) + size(b),
    Neg(a) => 1 + size(a),
    IfPos(c, t, f) => 1 + size(c) + size(t) + size(f)
  }
}

let main = () -> Int {
  let mut total = 0
  let mut nodes = 0
  let mut salt = 1
  while salt <= 40 {
    let e = build(9, salt)
    total = (total + eval(e)) % 1000000007
    nodes = nodes + size(e)
    salt = salt + 1
  }
  println(Int::to_string(nodes))
  println(Int::to_string(total))
  0
}
