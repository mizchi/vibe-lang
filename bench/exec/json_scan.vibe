// bench/exec scenario: byte-level scanning/parsing — a hand-rolled tokenizer
// over generated JSON-shaped text (NOT the selfhost parser; this represents
// user-written parsing code). Deterministic output; see bench/exec/README.md.

fn build_doc(n: Int) -> String {
  let mut s = "["
  let mut i = 0
  while i < n {
    if i > 0 {
      s = String::concat(s, ",")
    }
    s = String::concat(s, "{\"id\":")
    s = String::concat(s, Int::to_string(i))
    s = String::concat(s, ",\"tag\":\"item-")
    s = String::concat(s, Int::to_string(i % 13))
    s = String::concat(s, "\",\"on\":")
    if i % 3 == 0 {
      s = String::concat(s, "true")
    } else {
      s = String::concat(s, "false")
    }
    s = String::concat(s, "}")
    i = i + 1
  }
  String::concat(s, "]")
}

let main = () -> Int with Stdout {
  let doc = build_doc(300)
  let n = String::length(doc)
  let mut i = 0
  let mut depth = 0
  let mut max_depth = 0
  let mut strings = 0
  let mut numbers = 0
  let mut bools = 0
  let mut digit_sum = 0
  while i < n {
    let c = String::char_code_at(doc, i)
    if c == 123 || c == 91 {
      depth = depth + 1
      if depth > max_depth {
        max_depth = depth
      }
      i = i + 1
    } else if c == 125 || c == 93 {
      depth = depth - 1
      i = i + 1
    } else if c == 34 {
      let mut j = i + 1
      while String::char_code_at(doc, j) != 34 {
        j = j + 1
      }
      strings = strings + 1
      i = j + 1
    } else if c >= 48 && c <= 57 {
      let mut v = 0
      let mut j2 = i
      while j2 < n && String::char_code_at(doc, j2) >= 48 && String::char_code_at(doc, j2) <= 57 {
        v = v * 10 + (String::char_code_at(doc, j2) - 48)
        j2 = j2 + 1
      }
      numbers = numbers + 1
      digit_sum = (digit_sum + v) % 1000000007
      i = j2
    } else if c == 116 || c == 102 {
      bools = bools + 1
      let mut j3 = i
      while j3 < n && String::char_code_at(doc, j3) >= 97 && String::char_code_at(doc, j3) <= 122 {
        j3 = j3 + 1
      }
      i = j3
    } else {
      i = i + 1
    }
  }
  println(Int::to_string(n))
  println(Int::to_string(max_depth))
  println(Int::to_string(strings))
  println(Int::to_string(numbers))
  println(Int::to_string(bools))
  println(Int::to_string(digit_sum))
  0
}
