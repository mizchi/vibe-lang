// bench/exec scenario: memory-heavy flag table — Sieve of Eratosthenes over
// Bytes with a growth loop, then prime gap statistics.
// Deterministic output; see bench/exec/README.md.

let main = () -> Int {
  let limit = 20000
  let flags = Bytes::new()
  let mut i = 0
  while i <= limit {
    Bytes::push(flags, 1)
    i = i + 1
  }
  Bytes::set(flags, 0, 0)
  Bytes::set(flags, 1, 0)
  let mut p = 2
  while p * p <= limit {
    if Bytes::get(flags, p) == 1 {
      let mut q = p * p
      while q <= limit {
        Bytes::set(flags, q, 0)
        q = q + p
      }
    }
    p = p + 1
  }
  let mut count = 0
  let mut last = 0
  let mut max_gap = 0
  let mut sum = 0
  let mut k = 2
  while k <= limit {
    if Bytes::get(flags, k) == 1 {
      count = count + 1
      sum = (sum + k) % 1000000007
      if last > 0 && k - last > max_gap {
        max_gap = k - last
      }
      last = k
    }
    k = k + 1
  }
  println(Int::to_string(count))
  println(Int::to_string(last))
  println(Int::to_string(max_gap))
  println(Int::to_string(sum))
  0
}
