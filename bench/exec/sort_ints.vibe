// bench/exec scenario: array sort + binary search — LCG-generated ints,
// recursive quicksort with Array::get/set swaps, then membership queries.
// Deterministic output; see bench/exec/README.md.

// MINSTD Lehmer generator: products stay far below the 62-bit Int range, so
// the sequence is identical on every backend (no overflow wrap in sight).
fn lcg_next(_ seed: Int) -> Int {
  (seed * 48271) % 2147483647
}

fn quicksort(xs: Array[Int], lo: Int, hi: Int) -> Unit {
  if lo < hi {
    let pivot = Array::get(xs, at = hi)
    let mut store = lo
    let mut i = lo
    while i < hi {
      if Array::get(xs, at = i) < pivot {
        let tmp = Array::get(xs, at = store)
        Array::set(xs, at = store, value = Array::get(xs, at = i))
        Array::set(xs, at = i, value = tmp)
        store = store + 1
      }
      i = i + 1
    }
    let tmp2 = Array::get(xs, at = store)
    Array::set(xs, at = store, value = Array::get(xs, at = hi))
    Array::set(xs, at = hi, value = tmp2)
    quicksort(xs = xs, lo = lo, hi = store - 1)
    quicksort(xs = xs, lo = store + 1, hi = hi)
  }
}

fn binary_search(xs: Array[Int], key: Int) -> Bool {
  let mut lo = 0
  let mut hi = Array::length(xs) - 1
  let mut hit = false
  while lo <= hi {
    let mid = (lo + hi) / 2
    let v = Array::get(xs, at = mid)
    if v == key {
      hit = true
      lo = hi + 1
    } else if v < key {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  hit
}

let main = () -> Int with Console {
  let xs: Array[Int] = [
  ]
  let mut seed = 42
  let mut i = 0
  while i < 1200 {
    seed = lcg_next(seed)
    Array::push(xs, value = seed % 10000)
    i = i + 1
  }
  quicksort(xs = xs, lo = 0, hi = Array::length(xs) - 1)
  let mut inversions = 0
  let mut j = 1
  while j < Array::length(xs) {
    if Array::get(xs, at = j - 1) > Array::get(xs, at = j) {
      inversions = inversions + 1
    }
    j = j + 1
  }
  let mut hits = 0
  let mut probe = 0
  while probe < 10000 {
    if binary_search(xs = xs, key = probe) {
      hits = hits + 1
    }
    probe = probe + 7
  }
  println(Int::to_string(Array::length(xs)))
  println(Int::to_string(inversions))
  println(Int::to_string(Array::get(xs, at = 0)))
  println(Int::to_string(Array::get(xs, at = 1199)))
  println(Int::to_string(hits))
  0
}
