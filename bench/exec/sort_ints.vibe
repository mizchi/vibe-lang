// bench/exec scenario: array sort + binary search — LCG-generated ints,
// recursive quicksort with Array::get/set swaps, then membership queries.
// Deterministic output; see bench/exec/README.md.

// MINSTD Lehmer generator: products stay far below the 62-bit Int range, so
// the sequence is identical on every backend (no overflow wrap in sight).
fn lcg_next(seed: Int) -> Int {
  (seed * 48271) % 2147483647
}

fn quicksort(xs: Array[Int], lo: Int, hi: Int) -> Unit {
  if lo < hi {
    let pivot = Array::get(xs, hi)
    let mut store = lo
    let mut i = lo
    while i < hi {
      if Array::get(xs, i) < pivot {
        let tmp = Array::get(xs, store)
        Array::set(xs, store, Array::get(xs, i))
        Array::set(xs, i, tmp)
        store = store + 1
      }
      i = i + 1
    }
    let tmp2 = Array::get(xs, store)
    Array::set(xs, store, Array::get(xs, hi))
    Array::set(xs, hi, tmp2)
    quicksort(xs, lo, store - 1)
    quicksort(xs, store + 1, hi)
  }
}

fn binary_search(xs: Array[Int], key: Int) -> Bool {
  let mut lo = 0
  let mut hi = Array::length(xs) - 1
  let mut hit = false
  while lo <= hi {
    let mid = (lo + hi) / 2
    let v = Array::get(xs, mid)
    if v == key {
      hit = true
      lo = hi + 1
    } else if v < key {
      lo = mid + 1
    } else {
      hi = mid - 1
    }
  }
  hit
}

let main = () -> Int with Stdout {
  let xs: Array[Int] = [
  ]
  let mut seed = 42
  let mut i = 0
  while i < 1200 {
    seed = lcg_next(seed)
    Array::push(xs, seed % 10000)
    i = i + 1
  }
  quicksort(xs, 0, Array::length(xs) - 1)
  let mut inversions = 0
  let mut j = 1
  while j < Array::length(xs) {
    if Array::get(xs, j - 1) > Array::get(xs, j) {
      inversions = inversions + 1
    }
    j = j + 1
  }
  let mut hits = 0
  let mut probe = 0
  while probe < 10000 {
    if binary_search(xs, probe) {
      hits = hits + 1
    }
    probe = probe + 7
  }
  println(Int::to_string(Array::length(xs)))
  println(Int::to_string(inversions))
  println(Int::to_string(Array::get(xs, 0)))
  println(Int::to_string(Array::get(xs, 1199)))
  println(Int::to_string(hits))
  0
}
