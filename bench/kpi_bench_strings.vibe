let chunk = String::concat("ab", String::concat("cd", "ef"))

let rec build_str: (Int, String) -> String = (n, acc) -> {
  if eq(n, 0) {
    acc
  } else {
    build_str(n = sub(n, 1), acc = String::concat(acc, chunk))
  }
}

let rec search_count: (String, String, Int, Int, Int, Int, Int) -> Int = (hay, needle, pos, ni, hlen, nlen, count) -> {
  if add(pos, nlen) > hlen {
    count
  } else if ni >= nlen {
    search_count(hay = hay, needle = needle, pos = add(pos, nlen), ni = 0, hlen = hlen, nlen = nlen, count = add(count, 1))
  } else if String::char_code_at(hay, at = add(pos, ni)) == String::char_code_at(needle, at = ni) {
    search_count(hay = hay, needle = needle, pos = pos, ni = add(ni, 1), hlen = hlen, nlen = nlen, count = count)
  } else {
    search_count(hay = hay, needle = needle, pos = add(pos, 1), ni = 0, hlen = hlen, nlen = nlen, count = count)
  }
}

let slice_and_measure: (String) -> Int = (s) -> {
  let len = String::length(s)
  let quarter = ((len) / (4))
  let half = ((len) / (2))
  let s1 = String::substring(s, start = 0, end = quarter)
  let s2 = String::substring(s, start = quarter, end = half)
  let s3 = String::substring(s, start = half, end = add(half, quarter))
  let s4 = String::substring(s, start = add(half, quarter), end = len)
  let joined = String::concat(String::concat(s1, s2), String::concat(s3, s4))
  String::length(joined)
}

// Module-level `let mut` is not assignable from bench blocks;
// a memoized module-level Array cell serves as the fold-defeating sink.
let sink_cell = [0]

bench "string_build" {
  let s = build_str(n = 10, acc = "")
  let s2 = String::concat(s, s)
  Array::set(sink_cell, at = 0, value = add(Array::get(sink_cell, at = 0), String::length(s2)))
}

bench "string_search" {
  let hay = build_str(n = 10, acc = "")
  let hlen = String::length(hay)
  let nlen = String::length("cd")
  let count = search_count(hay = hay, needle = "cd", pos = 0, ni = 0, hlen = hlen, nlen = nlen, count = 0)
  Array::set(sink_cell, at = 0, value = add(Array::get(sink_cell, at = 0), slice_and_measure(s = hay)))
  Array::set(sink_cell, at = 0, value = add(Array::get(sink_cell, at = 0), count))
}
