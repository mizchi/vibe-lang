let chunk = string_concat("ab", string_concat("cd", "ef"))

let rec build_str = (n: Int, acc: String) -> String {
  if eq(n, 0) {
    acc
  } else {
    build_str(sub(n, 1), string_concat(acc, chunk))
  }
}

let rec search_count = (hay: String, needle: String, pos: Int, ni: Int, hlen: Int, nlen: Int, count: Int) -> Int {
  if add(pos, nlen) > hlen {
    count
  } else if ni >= nlen {
    search_count(hay, needle, add(pos, nlen), 0, hlen, nlen, add(count, 1))
  } else if string_char_code_at(hay, add(pos, ni)) == string_char_code_at(needle, ni) {
    search_count(hay, needle, pos, add(ni, 1), hlen, nlen, count)
  } else {
    search_count(hay, needle, add(pos, 1), 0, hlen, nlen, count)
  }
}

let slice_and_measure = (s: String) -> Int {
  let len = string_length(s)
  let quarter = div(len, 4)
  let half = div(len, 2)
  let s1 = string_substring(s, 0, quarter)
  let s2 = string_substring(s, quarter, half)
  let s3 = string_substring(s, half, add(half, quarter))
  let s4 = string_substring(s, add(half, quarter), len)
  let joined = string_concat(string_concat(s1, s2), string_concat(s3, s4))
  string_length(joined)
}

let mut sink = 0

bench "string_build" {
  let s = build_str(10, "")
  let s2 = string_concat(s, s)
  sink = add(sink, string_length(s2))
}

bench "string_search" {
  let hay = build_str(10, "")
  let hlen = string_length(hay)
  let nlen = string_length("cd")
  let count = search_count(hay, "cd", 0, 0, hlen, nlen, 0)
  sink = add(sink, slice_and_measure(hay))
  sink = add(sink, count)
}
