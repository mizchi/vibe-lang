let chunk = String::concat("ab", String::concat("cd", "ef"))

let rec build_str: (Int, String) -> String = (n, acc) -> {
  if eq(n, 0) {
    acc
  } else {
    build_str(sub(n, 1), String::concat(acc, chunk))
  }
}

let rec search_count: (String, String, Int, Int, Int, Int, Int) -> Int = (hay, needle, pos, ni, hlen, nlen, count) -> {
  if add(pos, nlen) > hlen {
    count
  } else if ni >= nlen {
    search_count(hay, needle, add(pos, nlen), 0, hlen, nlen, add(count, 1))
  } else if String::char_code_at(hay, add(pos, ni)) == String::char_code_at(needle, ni) {
    search_count(hay, needle, pos, add(ni, 1), hlen, nlen, count)
  } else {
    search_count(hay, needle, add(pos, 1), 0, hlen, nlen, count)
  }
}

let slice_and_measure: (String) -> Int = (s) -> {
  let len = String::length(s)
  let quarter = div(len, 4)
  let half = div(len, 2)
  let s1 = String::substring(s, 0, quarter)
  let s2 = String::substring(s, quarter, half)
  let s3 = String::substring(s, half, add(half, quarter))
  let s4 = String::substring(s, add(half, quarter), len)
  let joined = String::concat(String::concat(s1, s2), String::concat(s3, s4))
  String::length(joined)
}

let mut sink = 0

bench "string_build" {
  let s = build_str(10, "")
  let s2 = String::concat(s, s)
  sink = add(sink, String::length(s2))
}

bench "string_search" {
  let hay = build_str(10, "")
  let hlen = String::length(hay)
  let nlen = String::length("cd")
  let count = search_count(hay, "cd", 0, 0, hlen, nlen, 0)
  sink = add(sink, slice_and_measure(hay))
  sink = add(sink, count)
}
