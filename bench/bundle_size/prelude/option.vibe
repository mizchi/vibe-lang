//# Types

export trait Eq

impl Eq for Int

impl Eq for Float

impl Eq for Double

impl Eq for Bool

impl Eq for String

impl [T: Eq] Eq for Option[T]

//# Functions

export let or: [T](Option[T], Option[T]) -> Option[T] = (a, b) -> {
  match a {
    Some(_) => a,
    _ => b
  }
}

export let and: [A, B](Option[A], Option[B]) -> Option[B] = (a, b) -> {
  match a {
    Some(_) => b,
    _ => None
  }
}

export let zip: [A, B](Option[A], Option[B]) -> Option[(A, B)] = (a, b) -> {
  match (a, b) {
    (Some(x), Some(y)) => Some((x, y)),
    _ => None
  }
}

export let equals: [T: Eq](Option[T], Option[T]) -> Bool = (a, b) -> {
  match (a, b) {
    (Some(x), Some(y)) => x == y,
    (None, None) => true,
    _ => false
  }
}

export let filter: [T](Option[T], (x: T) -> Bool) -> Option[T] = (opt, pred) -> {
  match opt {
    Some(v) => if pred(v) {
      Some(v)
    } else None
    ,
    _ => None
  }
}

export let map_or: [A, B](Option[A], B, (x: A) -> B) -> B = (opt, default, f) -> {
  match opt {
    Some(v) => f(v),
    _ => default
  }
}

export let flatmap: [A, B](Option[A], (x: A) -> Option[B]) -> Option[B] = (opt, f) -> {
  match opt {
    Some(v) => f(v),
    _ => None
  }
}

export let flatten: [T](Option[Option[T]]) -> Option[T] = (opt) -> {
  match opt {
    Some(inner) => inner,
    _ => None
  }
}

export let is_some: [T](Option[T]) -> Bool = (opt) -> {
  match opt {
    Some(_) => true,
    _ => false
  }
}

export let is_none: [T](Option[T]) -> Bool = (opt) -> {
  not(is_some(opt))
}

export let map_opt: [A, B](Option[A], (x: A) -> B) -> Option[B] = (opt, f) -> {
  match opt {
    Some(v) => Some(f(v)),
    _ => None
  }
}

export let or_else: [T](Option[T], () -> Option[T]) -> Option[T] = (a, fallback) -> {
  match a {
    Some(_) => a,
    _ => fallback()
  }
}

export let zip_sum: (Option[Int], Option[Int]) -> Option[Int] = (a, b) -> {
  match zip(a, b) {
    Some((x, y)) => Some(x + y),
    _ => None
  }
}

export let unwrap_or: [T](Option[T], T) -> T = (opt, default) -> {
  match opt {
    Some(v) => v,
    _ => default
  }
}

export let unwrap_or_else: [T](Option[T], () -> T) -> T = (opt, fallback) -> {
  match opt {
    Some(v) => v,
    _ => fallback()
  }
}

export let Option::or: [T](Option[T], Option[T]) -> Option[T] = (a, b) -> {
  or(a, b)
}

export let Option::and: [A, B](Option[A], Option[B]) -> Option[B] = (a, b) -> {
  and(a, b)
}

export let Option::zip: [A, B](Option[A], Option[B]) -> Option[(A, B)] = (a, b) -> {
  zip(a, b)
}

export let Option::equals: [T: Eq](Option[T], Option[T]) -> Bool = (a, b) -> {
  equals(a, b)
}

export let Option::filter: [T](Option[T], (x: T) -> Bool) -> Option[T] = (opt, pred) -> {
  filter(opt, pred)
}

export let Option::map_or: [A, B](Option[A], B, (x: A) -> B) -> B = (opt, default, f) -> {
  map_or(opt, default, f)
}

export let Option::flatmap: [A, B](Option[A], (x: A) -> Option[B]) -> Option[B] = (opt, f) -> {
  flatmap(opt, f)
}

export let Option::flatten: [T](Option[Option[T]]) -> Option[T] = (opt) -> {
  flatten(opt)
}

export let Option::is_none: [T](Option[T]) -> Bool = (opt) -> {
  is_none(opt)
}

export let Option::is_some: [T](Option[T]) -> Bool = (opt) -> {
  is_some(opt)
}

export let Option::map_opt: [A, B](Option[A], (x: A) -> B) -> Option[B] = (opt, f) -> {
  map_opt(opt, f)
}

export let Option::or_else: [T](Option[T], () -> Option[T]) -> Option[T] = (a, fallback) -> {
  or_else(a, fallback)
}

export let Option::zip_sum: (Option[Int], Option[Int]) -> Option[Int] = (a, b) -> {
  zip_sum(a, b)
}

export let Option::unwrap_or: [T](Option[T], T) -> T = (opt, default) -> {
  unwrap_or(opt, default)
}

export let Option::unwrap_or_else: [T](Option[T], () -> T) -> T = (opt, fallback) -> {
  unwrap_or_else(opt, fallback)
}
