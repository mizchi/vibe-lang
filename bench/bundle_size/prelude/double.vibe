//# Functions

export let Double::abs: (Double) -> Double = (x) -> {
  if x < 0.0 {
    0.0 - x
  } else x
}

export let abs: (Double) -> Double = Double::abs

export let Double::max: (Double, Double) -> Double = (a, b) -> {
  if a > b {
    a
  } else b
}

export let max: (Double, Double) -> Double = Double::max

export let Double::min: (Double, Double) -> Double = (a, b) -> {
  if a < b {
    a
  } else b
}

export let min: (Double, Double) -> Double = Double::min

let double_cube: (Double) -> Double = (x) -> {
  x * x * x
}

export let cube: (Double) -> Double = double_cube

let double_lerp: (Double, Double, Double) -> Double = (a, b, t) -> {
  a + (b - a) * t
}

export let lerp: (Double, Double, Double) -> Double = double_lerp

let double_clamp: (Double, Double, Double) -> Double = (x, min_val, max_val) -> {
  if x < min_val {
    min_val
  }
  else if x > max_val {
    max_val
  }
  else x
}

export let clamp: (Double, Double, Double) -> Double = double_clamp

let double_is_nan: (Double) -> Bool = (x) -> {
  not(x == x)
}

export let is_nan: (Double) -> Bool = double_is_nan

let double_signum: (Double) -> Double = (x) -> {
  if x < 0.0 {
    -1.0
  }
  else if x > 0.0 {
    1.0
  }
  else 0.0
}

export let signum: (Double) -> Double = double_signum

let double_square: (Double) -> Double = (x) -> {
  x * x
}

export let square: (Double) -> Double = double_square

let double_int_max: Int = 2305843009213693951

let double_int_min: Int = 0 - 2305843009213693951 - 1

let double_approx_eq: (Double, Double, Double) -> Bool = (a, b, eps) -> {
  Double::abs(a - b) <= eps
}

export let approx_eq: (Double, Double, Double) -> Bool = double_approx_eq

let double_int_max_value: Double = Int::to_double(double_int_max)

let double_int_min_value: Double = Int::to_double(double_int_min)

let double_to_int_saturating: (Double) -> Int = (x) -> {
  if x >= double_int_max_value {
    double_int_max
  }
  else if x <= double_int_min_value {
    double_int_min
  }
  else Double::to_int(x)
}

export let Double::ceil: (Double) -> Double = (x) -> {
  if x >= double_int_max_value {
    double_int_max_value
  } else {
    let i = double_to_int_saturating(x)
    let d = Int::to_double(i)
    if d < x {
      Int::to_double(i + 1)
    } else d
  }
}

export let ceil: (Double) -> Double = Double::ceil

export let Double::floor: (Double) -> Double = (x) -> {
  if x <= double_int_min_value {
    double_int_min_value
  } else {
    let i = double_to_int_saturating(x)
    let d = Int::to_double(i)
    if d > x {
      Int::to_double(i - 1)
    } else d
  }
}

export let floor: (Double) -> Double = Double::floor

let double_round: (Double) -> Double = (x) -> {
  if x >= 0.0 {
    Double::floor(x + 0.5)
  } else Double::ceil(x - 0.5)
}

export let round: (Double) -> Double = double_round

let double_trunc: (Double) -> Double = (x) -> {
  Int::to_double(double_to_int_saturating(x))
}

export let trunc: (Double) -> Double = double_trunc

let double_fract: (Double) -> Double = (x) -> {
  x - double_trunc(x)
}

export let fract: (Double) -> Double = double_fract

export let Double::cube: (Double) -> Double = (x) -> {
  double_cube(x)
}

export let Double::lerp: (Double, Double, Double) -> Double = (a, b, t) -> {
  double_lerp(a, b, t)
}

export let Double::clamp: (Double, Double, Double) -> Double = (x, min_val, max_val) -> {
  double_clamp(x, min_val, max_val)
}

export let Double::fract: (Double) -> Double = (x) -> {
  double_fract(x)
}

export let Double::round: (Double) -> Double = (x) -> {
  double_round(x)
}

export let Double::trunc: (Double) -> Double = (x) -> {
  double_trunc(x)
}

export let Double::is_nan: (Double) -> Bool = (x) -> {
  double_is_nan(x)
}

export let Double::signum: (Double) -> Double = (x) -> {
  double_signum(x)
}

export let Double::square: (Double) -> Double = (x) -> {
  double_square(x)
}

export let Double::approx_eq: (Double, Double, Double) -> Bool = (a, b, eps) -> {
  double_approx_eq(a, b, eps)
}
