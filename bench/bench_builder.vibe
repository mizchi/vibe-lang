let rec build: (Int, ArrayBuilder[Int]) -> ArrayBuilder[Int] = (n, b) -> {
  if eq(n, 0) {
    b
  } else {
    {
      ArrayBuilder::push(b, value = n)
      build(n = sub(n, 1), b = b)
    }
  }
}

let result = {
  let b = ArrayBuilder::new()
  let out = build(n = 200, b = b)
  ArrayBuilder::freeze(out)
}
let main = () -> Array[Int] {
  result
}
