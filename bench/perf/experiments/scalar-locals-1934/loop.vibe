struct Counter { mut value: Int; flag: Bool }

fn compute(_ n: Int) -> Int {
  let p = Counter::{ value: n, flag: true }
  p.value = p.value + 7
  if p.flag { p.value * 3 - n } else { 0 - 1000 }
}

fn main allows Console + Profiler::heap_bytes {
  let before = Profiler::heap_bytes()
  let mut sum = 0
  let mut i = 0
  while i < 10000 {
    sum = sum + compute(i)
    i = i + 1
  }
  let allocated = Profiler::heap_bytes() - before
  println("\{sum} \{allocated}")
}
