+  } with { Exception::Throw(msg) => msg }
+  inspect(error, "linear string writer: insufficient reserved capacity")
+  assert_eq(Bytes::length(full), 64)
+  assert_eq(Bytes::get(full, 63), 97)
+  for index in [0, 127, 128, 16383, 16384, 1152921504606846976] {
+    let ordinary = Bytes::new()
+    ast_binary_write_varint(ordinary, 1152921504606846976)
+    ast_binary_write_varint(ordinary, index)
+    let encoded = Bytes::with_capacity(64)
+    linear_write_string_index(encoded, index)
+    assert_eq(Bytes::length(encoded), Bytes::length(ordinary))
+    i = 0
+    while i < Bytes::length(ordinary) {
+      assert_eq(Bytes::get(encoded, i), Bytes::get(ordinary, i)); i = i + 1
+    }
+  }
+}
