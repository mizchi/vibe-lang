import @vibe/compiler/cache/policy {
  CheckedModuleCacheConfig
}
import @vibe/compiler/cache {
  persistent_artifact_cache_path_in_namespace, set_persistent_cache_cfg_flags, store_persistent_artifact_in_namespace
}
import @vibe/compiler/config {
  target_cfg_from_csv, target_cfg_namespace
}
import @vibe/compiler/checker {
  check_program_result, typing_semantics_seed
}
import @vibe/compiler/checker/artifacts/module {
  CheckedModuleArtifact, checked_module_input_fingerprint, encode_checked_module_artifact
}
import @vibe/compiler/runtime/checked_module_cache {
  checked_module_artifact_stmts_configured,
  checked_module_cache_input_identity_in_namespace,
  checked_module_cache_reset_in_namespace,
  checked_module_cache_stats,
  commit_checked_module_artifact_configured,
  load_checked_module_artifact_configured,
  set_checked_module_cache_mode
}
import @vibe/compiler/syntax {
  lex_with_offsets, parse_program_located
}

fn probe_fresh(source: String, identity: Bytes) -> CheckedModuleArtifact with Exception {
  let (tokens, offsets, _) = lex_with_offsets(source)
  let parsed_stmts = parse_program_located(tokens = tokens, starts = offsets, source = source)
  CheckedModuleArtifact::{
    input_identity: identity,
    parsed_stmts,
    checked_program: check_program_result(parsed_stmts),
    lowering_offsets: [],
    eq_offsets: [],
    eq_keys: []
  }
}

fn main allows Env + Fs + Exception + Console {
  let path = Env::get("CHECKED_POLICY_SOURCE")
  let source = Fs::read_file(path)
  let mode = Env::get("CHECKED_POLICY_MODE")
  let namespace = target_cfg_namespace(target_cfg_from_csv(Env::get("CHECKED_POLICY_FLAGS")))
  set_persistent_cache_cfg_flags("poison")
  set_checked_module_cache_mode(if mode == "on" {
    "off"
  } else {
    "on"
  })
  checked_module_cache_reset_in_namespace(namespace = namespace)
  let identity = checked_module_cache_input_identity_in_namespace(path = path, source = source, semantics_seed = typing_semantics_seed(), deps = [
  ], namespace = namespace)
  let key = persistent_artifact_cache_path_in_namespace(kind = "checked-module-v1", entry_name = path, fingerprint = checked_module_input_fingerprint(identity), namespace = namespace)
  let captures = [0]
  handle {
    let previous = load_checked_module_artifact_configured(path = path, input_identity = identity, namespace = namespace)
    let (artifact, fresh) = match previous {
      Some(loaded) => (loaded, false),
      None => (probe_fresh(source = source, identity = identity), true)
    }
    if Env::get("CHECKED_POLICY_POISON") == "1" {
      let different = CheckedModuleArtifact::{
        input_identity: identity,
        parsed_stmts: [],
        checked_program: artifact.checked_program,
        lowering_offsets: artifact.lowering_offsets,
        eq_offsets: artifact.eq_offsets,
        eq_keys: artifact.eq_keys
      }
      store_persistent_artifact_in_namespace(kind = "checked-module-v1", entry_name = path, fingerprint = checked_module_input_fingerprint(identity), bytes = encode_checked_module_artifact(different), namespace = namespace)
      println("poison\t\{key}")
    } else {
      commit_checked_module_artifact_configured(path = path, source = source, artifact = artifact, fresh = fresh, namespace = namespace)
      let handoff = match checked_module_artifact_stmts_configured(path = path, source = source, namespace = namespace) {
        Some(stmts) => Array::length(stmts),
        None => -1
      }
      let stats = checked_module_cache_stats()
      println("checked-policy\t\{fresh}\t\{handoff}\t\{stats.0}\t\{stats.1}\t\{stats.2}\t\{Array::get(captures, at = 0)}\t\{key}")
    }
  } with { CheckedModuleCacheConfig::Mode() => {
    Array::set(captures, at = 0, value = Array::get(captures, at = 0) + 1)
    resume(mode)
  } }
}
