
let table: String = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
let to_b64: (Int) -> String = (i) -> {
  String::substring(table, start = i, end = i + 1)
}
let encode_pair: (Int, Int) -> String = (a, b) -> {
  let c0 = to_b64(i = a / 4)
  let x1 = a % 4 * 16
  let y1 = b / 16
  let c1 = to_b64(i = x1 + y1)
  let c2 = to_b64(i = b % 16 * 4)
  String::concat(String::concat(String::concat(c0, c1), c2), "=")
}
let encode_single: (Int) -> String = (a) -> {
  let c0 = to_b64(i = a / 4)
  let c1 = to_b64(i = a % 4 * 16)
  String::concat(String::concat(c0, c1), "==")
}
let encode_triplet: (Int, Int, Int) -> String = (a, b, c) -> {
  let c0 = to_b64(i = a / 4)
  let x1 = a % 4 * 16
  let y1 = b / 16
  let c1 = to_b64(i = x1 + y1)
  let x2 = b % 16 * 4
  let y2 = c / 64
  let c2 = to_b64(i = x2 + y2)
  let c3 = to_b64(i = c % 64)
  String::concat(String::concat(String::concat(c0, c1), c2), c3)
}
let rec enc_loop: (String, Int, String) -> String = (s, i, out) -> {
  let len = String::length(s)
  if i + 3 <= len {
    let j = i + 1
    let k = i + 2
    let a = String::char_code_at(s, at = i)
    let b = String::char_code_at(s, at = j)
    let c = String::char_code_at(s, at = k)
    enc_loop(s = s, i = i + 3, out = String::concat(out, encode_triplet(a = a, b = b, c = c)))
  } else if i + 2 <= len {
    let j = i + 1
    let a = String::char_code_at(s, at = i)
    let b = String::char_code_at(s, at = j)
    String::concat(out, encode_pair(a = a, b = b))
  } else if i + 1 <= len {
    let a = String::char_code_at(s, at = i)
    String::concat(out, encode_single(a = a))
  } else {
    out
  }
}
export let encode: (String) -> String = (s) -> {
  enc_loop(s = s, i = 0, out = "")
}
test "encode 3 bytes" {
  assert(String::equals(encode(s = "Man"), "TWFu"))
}
test "encode 2 bytes padding" {
  assert(String::equals(encode(s = "Ma"), "TWE="))
}
test "encode 1 byte padding" {
  assert(String::equals(encode(s = "M"), "TQ=="))
}
test "encode empty" {
  assert(String::equals(encode(s = ""), ""))
}
test "encode longer string" {
  assert(String::equals(encode(s = "Hello World"), "SGVsbG8gV29ybGQ="))
}
test "encode example" {
  assert(String::equals(encode(s = "Man"), "TWFu"))
}
