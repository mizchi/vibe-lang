
let pi: Int = 3
let add: (Int, Int) -> Int = (a, b) -> {
  a + b
}
let mul: (Int, Int) -> Int = (a, b) -> {
  a * b
}
let sub: (Int, Int) -> Int = (a, b) -> {
  a - b
}
let double: (Int) -> Int = (x) -> {
  mul(a = x, b = 2)
}
let square: (Int) -> Int = (x) -> {
  mul(a = x, b = x)
}
export {
  add, sub, mul, pi, double, square
}
test "add" {
  assert(eq(add(a = 1, b = 2), 3))
}
test "sub" {
  assert(eq(sub(a = 5, b = 3), 2))
}
test "mul" {
  assert(eq(mul(a = 3, b = 4), 12))
}
test "double" {
  assert(eq(double(x = 5), 10))
}
test "square" {
  assert(eq(square(x = 4), 16))
}
