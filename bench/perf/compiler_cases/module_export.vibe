
let pi: Int = 3
let add: (Int, Int) -> Int = (a, b) -> {
  a + b
}
let mul: (Int, Int) -> Int = (a, b) -> {
  a * b
}
let sub: (Int, Int) -> Int = (a, b) -> {
  a - b
}
let double: (Int) -> Int = (x) -> {
  mul(x, 2)
}
let square: (Int) -> Int = (x) -> {
  mul(x, x)
}
export {
  add, sub, mul, pi, double, square
}
test "add" {
  assert(eq(add(1, 2), 3))
}
test "sub" {
  assert(eq(sub(5, 3), 2))
}
test "mul" {
  assert(eq(mul(3, 4), 12))
}
test "double" {
  assert(eq(double(5), 10))
}
test "square" {
  assert(eq(square(4), 16))
}
