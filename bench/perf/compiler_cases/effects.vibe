
let fail: () -> Int with Exception = () -> {
  assert(false)
  1
}
let apply: [e]((Int) -> Int with e, Int) -> Int with e = (f, x) -> {
  f(x)
}
let chain: [e](
  (Int) -> Int with e,
  (Int) -> Int with e,
  Int,
) -> Int with e = (f, g, x) -> {
  add(f(x), g(x))
}
let pure_id: (Int) -> Int = (x) -> {
  x
}
let use_pure: (Int) -> Int = (x) -> {
  apply(f = pure_id, x = x)
}
let effectful: (Int) -> Int with Exception = (x) -> {
  x
}
let handled: (Int) -> Int = (x) -> {
  handle {
    effectful(x = x)
  } with {
    Exception::Throw(_) => 0
  }
}
let apply_ok: (Int) -> Int with Exception = (x) -> {
  apply(f = effectful, x = x)
}
let chain_ok: (Int) -> Int with Exception = (x) -> {
  chain(f = effectful, g = effectful, x = x)
}
let handled_error: Int = handle {
  fail()
} with {
  Exception::Throw(_) => 99
}
test "effects basic" {
  assert(eq(handled(x = 3), 3))
}
test "effects catch" {
  assert(eq(handled_error, 99))
}
test "effects higher-order" {
  assert(eq(apply_ok(x = 5), 5))
}
test "effects chain" {
  assert(eq(chain_ok(x = 2), 4))
}
test "effects pure" {
  assert(eq(use_pure(x = 4), 4))
}
