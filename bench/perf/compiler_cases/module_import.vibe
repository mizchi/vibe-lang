
import ./module_export.vibe {
  add, mul, pi, double, square
}
let result1 = add(a = 10, b = 20)
let result2 = mul(a = 3, b = 4)
let result3 = double(x = pi)
let result4 = square(x = 5)
let sum_of_squares: (Int, Int) -> Int = (a, b) -> {
  add(a = square(x = a), b = square(x = b))
}
test "imported add" {
  assert(eq(result1, 30))
}
test "imported mul" {
  assert(eq(result2, 12))
}
test "imported double with pi" {
  assert(eq(result3, 6))
}
test "imported square" {
  assert(eq(result4, 25))
}
test "composed sum_of_squares" {
  assert(eq(sum_of_squares(a = 3, b = 4), 25))
}
