  "harnesses": {
    "measure.py": "import os,subprocess,json,hashlib,time,resource\nfrom pathlib import Path\nlab=Path(__file__).resolve().parent;corpus=lab/'corpus'\nenv={k:v for k,v in os.environ.items() if not k.startswith('VIBE_')}\nenv.update(VIBE_LIB=str(corpus/'lib'),VIBE_PREOPEN_DIR=str(corpus),VIBE_RC='1',VIBE_FS_COMPILE='1',VIBE_IMPORT_ABI='raw',VIBE_CHECKED_MODULE_CACHE='off',VIBE_CODEGEN_BODY_CACHE='off',VIBE_DISABLE_PERSISTENT_ARTIFACT_CACHE='1',VIBE_NATIVE_CACHE_DIR=str(lab/'native-cache'))\nrows=[];receipts={key:{n:hashlib.sha256((lab/key/n).read_bytes()).hexdigest() for n in ['compiler.wasm','viberun']} for key in ['a','b']}\ndef corpus_hash():\n h=hashlib.sha256()\n for p in sorted((corpus/'lib').rglob('*')):\n  if p.is_file():h.update(str(p.relative_to(corpus)).encode()+b'\\0'+p.read_bytes())\n return h.hexdigest()\nreceipts['corpus_sha256']=corpus_hash()\n# Prime native machine-code caches independently of the fresh guest caches.\nfor key in ['a','b']:\n subprocess.run([str(lab/key/'viberun'),str(lab/key/'compiler.wasm')],cwd=corpus,env=env,stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=120)\nfor subject,source,entry in [('compiler','lib/@vibe/compiler/tests/codegen_lexer_test.vibe','__no_entry__'),('cli','lib/@vibe/cli/entry.vibe','cli_main')]:\n for rnd in range(4):\n  for key in (['a','b'] if rnd%2==0 else ['b','a']):\n   private=lab/f'measure-{subject}-{rnd}-{key}';private.mkdir()\n   current=env|dict(VIBE_BUILD_CACHE_DIR=str(private/'cache'))\n   for temperature in ['cold','warm']:\n    dest=private/f'{temperature}.wasm'\n    started=time.monotonic();u0=resource.getrusage(resource.RUSAGE_CHILDREN)\n    with (private/f'{temperature}.log').open('w') as log:\n     p=subprocess.Popen([str(lab/key/'viberun'),str(lab/key/'compiler.wasm'),source,str(dest),entry],cwd=corpus,env=current,stdout=log,stderr=log)\n     peak=0\n     while p.poll() is None:\n      try:peak=max(peak,int(Path(f'/proc/{p.pid}/statm').read_text().split()[1])*os.sysconf('SC_PAGE_SIZE'))\n      except FileNotFoundError:pass\n      time.sleep(.02)\n      assert time.monotonic()-started<300\n    wall=time.monotonic()-started;u1=resource.getrusage(resource.RUSAGE_CHILDREN)\n    assert p.returncode==0,(subject,key,rnd,temperature)\n    rows.append(dict(subject=subject,variant=key,round=rnd,temperature=temperature,wall_s=wall,user_cpu_s=u1.ru_utime-u0.ru_utime,system_cpu_s=u1.ru_stime-u0.ru_stime,peak_rss_bytes=peak,wasm_sha256=hashlib.sha256(dest.read_bytes()).hexdigest()))\n    (lab/'measurement.json').write_text(json.dumps(dict(receipts=receipts,protocol='N4 ABBA pairs, identical frozen corpus; isolated parsed-source cache per pair; checked/body/artifact caches off; native JIT primed; RC1 whole FS compile; RSS20ms; no concurrent work.',samples=rows),indent=2)+'\\n')\n    print(subject,key,rnd,temperature,f'{wall:.4f}s',f'{peak/2**20:.1f}MiB',flush=True)\n   assert len({r['wasm_sha256'] for r in rows if r['subject']==subject})==1\nassert corpus_hash()==receipts['corpus_sha256']\nprint('All32 results match; corpus unchanged.',flush=True)\n",
    "profile.py": "import os,subprocess,json,hashlib,sys\nfrom pathlib import Path\nlab=Path(__file__).resolve().parent;corpus=lab/'corpus';key=sys.argv[1];image=lab/key\nclean={k:v for k,v in os.environ.items() if not k.startswith('VIBE_')}\nclean.update(VIBE_LIB=str(corpus/'lib'),VIBE_PREOPEN_DIR=str(corpus),VIBE_RC='1',VIBE_FS_COMPILE='1',VIBE_IMPORT_ABI='raw',VIBE_CHECKED_MODULE_CACHE='off',VIBE_CODEGEN_BODY_CACHE='off',VIBE_DISABLE_PERSISTENT_ARTIFACT_CACHE='1',VIBE_NATIVE_CACHE_DIR=str(lab/'native-cache'))\nfor subject,source,entry in [('compiler','lib/@vibe/compiler/tests/codegen_lexer_test.vibe','__no_entry__'),('cli','lib/@vibe/cli/entry.vibe','cli_main')]:\n out=lab/f'profile-{key}-{subject}';out.mkdir()\n env=clean|dict(VIBE_BUILD_CACHE_DIR=str(out/'cache'))\n hashes=[]\n for n in range(4):\n  e=env.copy()\n  if n:e['VIBE_GUEST_PROFILE']=str(out/f'{n}.json')\n  dest=out/f'{n}.wasm'\n  with (out/f'{n}.log').open('w') as log:\n   subprocess.run([str(image/'viberun'),str(image/'compiler.wasm'),source,str(dest),entry],cwd=corpus,env=e,stdout=log,stderr=log,check=True,timeout=300)\n  hashes.append(hashlib.sha256(dest.read_bytes()).hexdigest())\n  print(key,subject,n,'warm profile' if n else 'cold priming',flush=True)\n assert len(set(hashes))==1\n",
    "summarize-cpu.py": "import json,collections\nfrom pathlib import Path\nlab=Path(__file__).resolve().parent;result={}\nfor key in ['a','b']:\n result[key]={}\n for subject in ['compiler','cli']:\n  counts=collections.Counter();self_counts=collections.Counter();total=0\n  for p in sorted((lab/f'profile-{key}-{subject}').glob('[123].json')):\n   t=json.loads(p.read_text())['threads'][0];st=t['stackTable'];ft=t['frameTable'];f=t['funcTable'];names=t['stringArray']\n   for stack in t['samples']['stack']:\n    if stack is None:continue\n    total+=1;seen=set();self_counts[names[f['name'][ft['func'][st['frame'][stack]]]]]+=1\n    while stack is not None:\n     seen.add(names[f['name'][ft['func'][st['frame'][stack]]]])\n     stack=st['prefix'][stack]\n    counts.update(seen)\n  targets=['edp_params_of_fn','edp_indexed_params_of_fn','edp_fn_statement_index','edp_stamp_slot_rows','evidence_dict_pass_with_roots','LinkedFunctionPlan::emit']\n  result[key][subject]=dict(total_samples=total,inclusive={name:dict(samples=sum(v for n,v in counts.items() if n==name or n.startswith(name+'_exp_')),percent=100*sum(v for n,v in counts.items() if n==name or n.startswith(name+'_exp_'))/total) for name in targets},top_self=[dict(name=n,samples=v,percent=100*v/total) for n,v in self_counts.most_common(25)])\n(lab/'cpu-summary.json').write_text(json.dumps(result,indent=2)+'\\n')\nfor key,subjects in result.items():\n for subject,d in subjects.items():print(key,subject,{n:round(v['percent'],2) for n,v in d['inclusive'].items()})\n"
  }
