let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s = s, n = sub(n, 1)))
  }
}

let rec slice_loop: (String, Int, Int) -> Int = (s, i, acc) -> {
  if eq(i, 0) {
    acc
  } else {
    let len = String::length(s)
    let a = 5
    let b = sub(len, 5)
    let t = String::substring(s, start = a, end = b)
    slice_loop(s = s, i = sub(i, 1), acc = add(acc, String::length(t)))
  }
}

let base = repeat(s = "abcdefghijklmnopqrstuvwxyz", n = 20)
let main = () -> Int {
  slice_loop(s = base, i = 200, acc = 0)
}
