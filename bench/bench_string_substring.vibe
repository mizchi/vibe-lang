let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s, sub(n, 1)))
  }
}

let rec slice_loop: (String, Int, Int) -> Int = (s, i, acc) -> {
  if eq(i, 0) {
    acc
  } else {
    let len = String::length(s)
    let a = 5
    let b = sub(len, 5)
    let t = String::substring(s, a, b)
    slice_loop(s, sub(i, 1), add(acc, String::length(t)))
  }
}

let base = repeat("abcdefghijklmnopqrstuvwxyz", 20)
let main = () -> Int {
  slice_loop(base, 200, 0)
}
