let mix_01 = (x: Int) -> Int { add(mul(x, 3), 11) % 104729 }
let mix_02 = (x: Int) -> Int { add(mul(x, 5), 17) % 104729 }
let mix_03 = (x: Int) -> Int { add(mul(x, 7), 23) % 104729 }
let mix_04 = (x: Int) -> Int { add(mul(x, 11), 29) % 104729 }
let mix_05 = (x: Int) -> Int { add(mul(x, 13), 31) % 104729 }
let mix_06 = (x: Int) -> Int { add(mul(x, 17), 37) % 104729 }
let mix_07 = (x: Int) -> Int { add(mul(x, 19), 41) % 104729 }
let mix_08 = (x: Int) -> Int { add(mul(x, 23), 43) % 104729 }
let mix_09 = (x: Int) -> Int { add(mul(x, 29), 47) % 104729 }
let mix_10 = (x: Int) -> Int { add(mul(x, 31), 53) % 104729 }
let mix_11 = (x: Int) -> Int { add(mul(x, 37), 59) % 104729 }
let mix_12 = (x: Int) -> Int { add(mul(x, 41), 61) % 104729 }
let mix_13 = (x: Int) -> Int { add(mul(x, 43), 67) % 104729 }
let mix_14 = (x: Int) -> Int { add(mul(x, 47), 71) % 104729 }
let mix_15 = (x: Int) -> Int { add(mul(x, 53), 73) % 104729 }
let mix_16 = (x: Int) -> Int { add(mul(x, 59), 79) % 104729 }
let mix_17 = (x: Int) -> Int { add(mul(x, 61), 83) % 104729 }
let mix_18 = (x: Int) -> Int { add(mul(x, 67), 89) % 104729 }
let mix_19 = (x: Int) -> Int { add(mul(x, 71), 97) % 104729 }
let mix_20 = (x: Int) -> Int { add(mul(x, 73), 101) % 104729 }
let mix_21 = (x: Int) -> Int { add(mul(x, 79), 103) % 104729 }
let mix_22 = (x: Int) -> Int { add(mul(x, 83), 107) % 104729 }
let mix_23 = (x: Int) -> Int { add(mul(x, 89), 109) % 104729 }
let mix_24 = (x: Int) -> Int { add(mul(x, 97), 113) % 104729 }
let mix_25 = (x: Int) -> Int { add(mul(x, 101), 127) % 104729 }
let mix_26 = (x: Int) -> Int { add(mul(x, 103), 131) % 104729 }
let mix_27 = (x: Int) -> Int { add(mul(x, 107), 137) % 104729 }
let mix_28 = (x: Int) -> Int { add(mul(x, 109), 139) % 104729 }
let mix_29 = (x: Int) -> Int { add(mul(x, 113), 149) % 104729 }
let mix_30 = (x: Int) -> Int { add(mul(x, 127), 151) % 104729 }
let mix_31 = (x: Int) -> Int { add(mul(x, 131), 157) % 104729 }
let mix_32 = (x: Int) -> Int { add(mul(x, 137), 163) % 104729 }

let pipe_a = (x: Int) -> Int {
  mix_08(mix_07(mix_06(mix_05(mix_04(mix_03(mix_02(mix_01(x))))))))
}

let pipe_b = (x: Int) -> Int {
  mix_16(mix_15(mix_14(mix_13(mix_12(mix_11(mix_10(mix_09(x))))))))
}

let pipe_c = (x: Int) -> Int {
  mix_24(mix_23(mix_22(mix_21(mix_20(mix_19(mix_18(mix_17(x))))))))
}

let pipe_d = (x: Int) -> Int {
  mix_32(mix_31(mix_30(mix_29(mix_28(mix_27(mix_26(mix_25(x))))))))
}

let deep_pipe = (x: Int) -> Int {
  pipe_d(pipe_c(pipe_b(pipe_a(x))))
}

let fan_out = (x: Int) -> Int {
  let a = pipe_a(x)
  let b = pipe_b(x)
  let c = pipe_c(x)
  let d = pipe_d(x)
  add(add(a, b), add(c, d)) % 104729
}

let mut seed = 42

bench "deep_pipeline" {
  seed = deep_pipe(seed)
  let _ = div(1000003, add(1, seed % 1000))
}

bench "wide_fan_out" {
  seed = fan_out(seed)
  let _ = div(1000003, add(1, seed % 1000))
}
