let mix_01: (Int) -> Int = (x) -> { add(mul(x, 3), 11) % 104729 }
let mix_02: (Int) -> Int = (x) -> { add(mul(x, 5), 17) % 104729 }
let mix_03: (Int) -> Int = (x) -> { add(mul(x, 7), 23) % 104729 }
let mix_04: (Int) -> Int = (x) -> { add(mul(x, 11), 29) % 104729 }
let mix_05: (Int) -> Int = (x) -> { add(mul(x, 13), 31) % 104729 }
let mix_06: (Int) -> Int = (x) -> { add(mul(x, 17), 37) % 104729 }
let mix_07: (Int) -> Int = (x) -> { add(mul(x, 19), 41) % 104729 }
let mix_08: (Int) -> Int = (x) -> { add(mul(x, 23), 43) % 104729 }
let mix_09: (Int) -> Int = (x) -> { add(mul(x, 29), 47) % 104729 }
let mix_10: (Int) -> Int = (x) -> { add(mul(x, 31), 53) % 104729 }
let mix_11: (Int) -> Int = (x) -> { add(mul(x, 37), 59) % 104729 }
let mix_12: (Int) -> Int = (x) -> { add(mul(x, 41), 61) % 104729 }
let mix_13: (Int) -> Int = (x) -> { add(mul(x, 43), 67) % 104729 }
let mix_14: (Int) -> Int = (x) -> { add(mul(x, 47), 71) % 104729 }
let mix_15: (Int) -> Int = (x) -> { add(mul(x, 53), 73) % 104729 }
let mix_16: (Int) -> Int = (x) -> { add(mul(x, 59), 79) % 104729 }
let mix_17: (Int) -> Int = (x) -> { add(mul(x, 61), 83) % 104729 }
let mix_18: (Int) -> Int = (x) -> { add(mul(x, 67), 89) % 104729 }
let mix_19: (Int) -> Int = (x) -> { add(mul(x, 71), 97) % 104729 }
let mix_20: (Int) -> Int = (x) -> { add(mul(x, 73), 101) % 104729 }
let mix_21: (Int) -> Int = (x) -> { add(mul(x, 79), 103) % 104729 }
let mix_22: (Int) -> Int = (x) -> { add(mul(x, 83), 107) % 104729 }
let mix_23: (Int) -> Int = (x) -> { add(mul(x, 89), 109) % 104729 }
let mix_24: (Int) -> Int = (x) -> { add(mul(x, 97), 113) % 104729 }
let mix_25: (Int) -> Int = (x) -> { add(mul(x, 101), 127) % 104729 }
let mix_26: (Int) -> Int = (x) -> { add(mul(x, 103), 131) % 104729 }
let mix_27: (Int) -> Int = (x) -> { add(mul(x, 107), 137) % 104729 }
let mix_28: (Int) -> Int = (x) -> { add(mul(x, 109), 139) % 104729 }
let mix_29: (Int) -> Int = (x) -> { add(mul(x, 113), 149) % 104729 }
let mix_30: (Int) -> Int = (x) -> { add(mul(x, 127), 151) % 104729 }
let mix_31: (Int) -> Int = (x) -> { add(mul(x, 131), 157) % 104729 }
let mix_32: (Int) -> Int = (x) -> { add(mul(x, 137), 163) % 104729 }

let pipe_a: (Int) -> Int = (x) -> {
  mix_08(x = mix_07(x = mix_06(x = mix_05(x = mix_04(x = mix_03(x = mix_02(x = mix_01(x = x))))))))
}

let pipe_b: (Int) -> Int = (x) -> {
  mix_16(x = mix_15(x = mix_14(x = mix_13(x = mix_12(x = mix_11(x = mix_10(x = mix_09(x = x))))))))
}

let pipe_c: (Int) -> Int = (x) -> {
  mix_24(x = mix_23(x = mix_22(x = mix_21(x = mix_20(x = mix_19(x = mix_18(x = mix_17(x = x))))))))
}

let pipe_d: (Int) -> Int = (x) -> {
  mix_32(x = mix_31(x = mix_30(x = mix_29(x = mix_28(x = mix_27(x = mix_26(x = mix_25(x = x))))))))
}

let deep_pipe: (Int) -> Int = (x) -> {
  pipe_d(x = pipe_c(x = pipe_b(x = pipe_a(x = x))))
}

let fan_out: (Int) -> Int = (x) -> {
  let a = pipe_a(x = x)
  let b = pipe_b(x = x)
  let c = pipe_c(x = x)
  let d = pipe_d(x = x)
  add(add(a, b), add(c, d)) % 104729
}

// Module-level `let mut` is not assignable from bench blocks;
// memoized module-level Array cells carry the cross-iteration state.
let seed_cell = [42]

bench "deep_pipeline" {
  Array::set(seed_cell, at = 0, value = deep_pipe(x = Array::get(seed_cell, at = 0)))
  let _ = 1000003 / (add(1, Array::get(seed_cell, at = 0) % 1000))
}

bench "wide_fan_out" {
  Array::set(seed_cell, at = 0, value = fan_out(x = Array::get(seed_cell, at = 0)))
  let _ = 1000003 / (add(1, Array::get(seed_cell, at = 0) % 1000))
}
