// Microbench: linear scan over Array[String] vs hand-rolled hash
// bucket lookup. Self-contained — no compiler imports —
// so vibe bench's compile-lite calibration handles it.
//
// Builds N=100 names of length ~3 chars, looks up the LAST inserted
// name (worst-case for linear scan), MIDDLE one (average for linear
// scan), and a MISSING one (full walk). Each `bench {}` block does
// one lookup; vibe bench picks iteration count automatically.

let n_entries = 100

let bucket_count = 32

let make_names: () -> Array[String] = () -> {
  let names = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < n_entries {
    let mut buf = "f"
    let h = i / 26
    let l = i % 26
    buf = String::concat(buf, String::from_char_code(97 + h))
    buf = String::concat(buf, String::from_char_code(97 + l))
    Array::push(names, buf)
    i = i + 1
  }
  names
}

let names = make_names()

let target_last = Array::get(names, n_entries - 1)

let target_mid = Array::get(names, n_entries / 2)

let target_missing = "zzzz"

let lookup_linear: (Array[String], String) -> Int = (xs, key) -> {
  let len = Array::length(xs)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(xs, i) == key {
      found = i
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

let str_hash: (String) -> Int = (s) -> {
  let len = String::length(s)
  let mut h = 5381
  let mut i = 0
  while i < len {
    h = ((h * 33) + String::char_code_at(s, i)) & 0x3fffffff
    i = i + 1
  }
  h
}

// Bucket arrays kept as plain top-level Array[Array[String]] so that
// vibe bench calibration can pick them up. (Wrapping them in a struct
// makes the struct invisible to the per-bench-body calibrate compile.)
let make_buckets_keys: () -> Array[Array[String]] = () -> {
  let outer = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let mut b = 0
  while b < bucket_count {
    Array::push(outer, Array::slice([
      ""
    ], 0, 0))
    b = b + 1
  }
  outer
}

let make_buckets_vals: () -> Array[Array[Int]] = () -> {
  let outer = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let mut b = 0
  while b < bucket_count {
    Array::push(outer, Array::slice([
      0
    ], 0, 0))
    b = b + 1
  }
  outer
}

let bucket_keys = make_buckets_keys()

let bucket_vals = make_buckets_vals()

let _populate_buckets: () -> Int = () -> {
  let mut i = 0
  let len = Array::length(names)
  while i < len {
    let key = Array::get(names, i)
    let h = str_hash(key) % bucket_count
    Array::push(Array::get(bucket_keys, h), key)
    Array::push(Array::get(bucket_vals, h), i)
    i = i + 1
  }
  len
}

let _populated = _populate_buckets()

let lookup_hashed: (String) -> Int = (key) -> {
  let h = str_hash(key) % bucket_count
  let keys = Array::get(bucket_keys, h)
  let vals = Array::get(bucket_vals, h)
  let len = Array::length(keys)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(keys, i) == key {
      found = Array::get(vals, i)
      i = len
    } else {
      i = i + 1
    }
  }
  found
}

bench "linear/last" {
  let _ = lookup_linear(names, target_last)
}

bench "linear/mid" {
  let _ = lookup_linear(names, target_mid)
}

bench "linear/missing" {
  let _ = lookup_linear(names, target_missing)
}

bench "hashed/last" {
  let _ = lookup_hashed(target_last)
}

bench "hashed/mid" {
  let _ = lookup_hashed(target_mid)
}

bench "hashed/missing" {
  let _ = lookup_hashed(target_missing)
}
