let rec build_with_concat: (Int, Array[Int]) -> Array[Int] = (n, acc) -> {
  if n <= 0 {
    acc
  } else {
    build_with_concat(n = n - 1, acc = Array::concat(acc, [
      n
    ]))
  }
}

let rec build_with_builder: (Int, ArrayBuilder[Int]) -> Array[Int] = (n, b) -> {
  if n <= 0 {
    {
      ArrayBuilder::freeze(b)
    }
  } else {
    {
      ArrayBuilder::push(b, value = n)
      build_with_builder(n = n - 1, b = b)
    }
  }
}

// Module-level `let mut` is not assignable from bench blocks;
// a memoized module-level Array cell serves as the fold-defeating sink.
let sink_cell = [0]

bench "array_concat_append_10" {
  let xs = build_with_concat(n = 10, acc = [
  ])
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + Array::length(xs))
}

bench "array_builder_push_10" {
  let xs = {
    build_with_builder(n = 10, b = ArrayBuilder::new())
  }
  Array::set(sink_cell, at = 0, value = Array::get(sink_cell, at = 0) + Array::length(xs))
}
