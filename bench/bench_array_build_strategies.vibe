let rec build_with_concat: (Int, Array[Int]) -> Array[Int] = (n, acc) -> {
  if n <= 0 {
    acc
  } else {
    build_with_concat(n - 1, Array::concat(acc, [
      n
    ]))
  }
}

let rec build_with_builder: (Int, ArrayBuilder[Int]) -> Array[Int] = (n, b) -> {
  if n <= 0 {
    {
      ArrayBuilder::freeze(b)
    }
  } else {
    {
      ArrayBuilder::push(b, n)
      build_with_builder(n - 1, b)
    }
  }
}

// Module-level `let mut` is not assignable from bench blocks on selfhost;
// a memoized module-level Array cell serves as the fold-defeating sink.
let sink_cell = [0]

bench "array_concat_append_10" {
  let xs = build_with_concat(10, [
  ])
  Array::set(sink_cell, 0, Array::get(sink_cell, 0) + Array::length(xs))
}

bench "array_builder_push_10" {
  let xs = {
    build_with_builder(10, ArrayBuilder::new())
  }
  Array::set(sink_cell, 0, Array::get(sink_cell, 0) + Array::length(xs))
}
