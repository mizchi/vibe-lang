// #1056 binary-size regression bench: higher-order functions / closures
// invoked through an indirect call. See bench/binary_size/README.md.

fn apply(f: (Int) -> Int, x: Int) -> Int {
  f(x)
}

let main = () -> Int {
  let offset = 1
  let add1 = (x: Int) -> Int { x + offset }
  let double = (x: Int) -> Int { x * 2 }
  let a = apply(add1, 10)
  let b = apply(double, 10)
  a + b
}
