// #1056 binary-size regression bench: algebraic data type (variant) match
// plus floating-point arithmetic. See bench/binary_size/README.md.
//
// NOTE: the variant payload is `Int` (radius/side scaled by 100), not
// `Double` — a `Double`-typed enum constructor field matched back out traps
// with "memory access out of bounds" on the default (bump, no RC) backend
// even in the smallest repro (a single-variant enum, one field, one match
// arm; see the #1056 PR discussion). That is a pre-existing codegen bug
// unrelated to Perceus RC and out of scope here; tracked separately. This
// program still exercises match-on-variant and float arithmetic, just not
// float payloads flowing through an enum constructor.

enum Shape {
  Circle(Int);
  Rect(Int, Int)
}

fn area(s: Shape) -> Double {
  match s {
    Circle(r) => 3.14159 * Int::to_double(r) * Int::to_double(r) / 10000.0,
    Rect(w, h) => Int::to_double(w) * Int::to_double(h) / 10000.0
  }
}

let main = () -> Int {
  let shapes = [Circle(200), Rect(300, 400), Circle(150)]
  let mut total = 0.0
  let mut i = 0
  while i < Array::length(shapes) {
    total = total + area(Array::get(shapes, i))
    i = i + 1
  }
  Double::to_int(total)
}
