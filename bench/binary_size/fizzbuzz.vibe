// #1056 binary-size regression bench: iterative loop with conditionals
// (1..100 FizzBuzz). See bench/binary_size/README.md.

fn fizzbuzz_line(n: Int) -> String {
  if n % 15 == 0 {
    "FizzBuzz"
  } else if n % 3 == 0 {
    "Fizz"
  } else if n % 5 == 0 {
    "Buzz"
  } else {
    Int::to_string(n)
  }
}

let main = () -> Int with Stdout {
  let mut i = 1
  while i <= 100 {
    println(fizzbuzz_line(i))
    i = i + 1
  }
  0
}
