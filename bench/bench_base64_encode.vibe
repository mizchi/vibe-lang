// Base64 encode throughput benchmark (pure vibe)

let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

let to_b64: (String, Int) -> String = (table, i) -> {
  String::substring(table, i, add(i, 1))
}

let encode_triplet: (String, Int, Int, Int) -> String = (table, a, b, c) -> {
  let c0 = to_b64(table, div(a, 4))
  let x1 = mul(a % 4, 16)
  let y1 = div(b, 16)
  let c1 = to_b64(table, add(x1, y1))
  let x2 = mul(b % 16, 4)
  let y2 = div(c, 64)
  let c2 = to_b64(table, add(x2, y2))
  let c3 = to_b64(table, c % 64)
  String::concat(String::concat(String::concat(c0, c1), c2), c3)
}

let encode_pair: (String, Int, Int) -> String = (table, a, b) -> {
  let c0 = to_b64(table, div(a, 4))
  let x1 = mul(a % 4, 16)
  let y1 = div(b, 16)
  let c1 = to_b64(table, add(x1, y1))
  let c2 = to_b64(table, mul(b % 16, 4))
  String::concat(String::concat(String::concat(c0, c1), c2), "=")
}

let encode_single: (String, Int) -> String = (table, a) -> {
  let c0 = to_b64(table, div(a, 4))
  let c1 = to_b64(table, mul(a % 4, 16))
  String::concat(String::concat(c0, c1), "==")
}

let rec encode_loop: (String, String, Int, String) -> String = (table, s, i, out) -> {
  let len = String::length(s)
  if lt(add(i, 2), len) {
    let j = add(i, 1)
    let k = add(i, 2)
    let a = String::char_code_at(s, i)
    let b = String::char_code_at(s, j)
    let c = String::char_code_at(s, k)
    let next = String::concat(out, encode_triplet(table, a, b, c))
    encode_loop(table, s, add(i, 3), next)
  } else if lt(add(i, 1), len) {
    let j = add(i, 1)
    let a = String::char_code_at(s, i)
    let b = String::char_code_at(s, j)
    String::concat(out, encode_pair(table, a, b))
  } else if lt(i, len) {
    let a = String::char_code_at(s, i)
    String::concat(out, encode_single(table, a))
  } else {
    out
  }
}

let encode: (String, String) -> String = (table, s) -> {
  encode_loop(table, s, 0, "")
}

let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s, sub(n, 1)))
  }
}

let rec bench_loop: (String, String, Int, Int) -> Int = (table, payload, n, acc) -> {
  if eq(n, 0) {
    acc
  } else {
    let encoded = encode(table, payload)
    bench_loop(table, payload, sub(n, 1), add(acc, String::length(encoded)))
  }
}

let payload = repeat("abcdefghijklmnopqrstuvwxyz0123456789", 8)
bench_loop(table, payload, 10, 0)
