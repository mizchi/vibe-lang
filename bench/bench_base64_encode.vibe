// Base64 encode throughput benchmark (pure vibe)

let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

let to_b64: (String, Int) -> String = (table, i) -> {
  String::substring(table, start = i, end = ((i) + (1)))
}

let encode_triplet: (String, Int, Int, Int) -> String = (table, a, b, c) -> {
  let c0 = to_b64(table = table, i = ((a) / (4)))
  let x1 = ((a % 4) * (16))
  let y1 = ((b) / (16))
  let c1 = to_b64(table = table, i = ((x1) + (y1)))
  let x2 = ((b % 16) * (4))
  let y2 = ((c) / (64))
  let c2 = to_b64(table = table, i = ((x2) + (y2)))
  let c3 = to_b64(table = table, i = c % 64)
  String::concat(String::concat(String::concat(c0, c1), c2), c3)
}

let encode_pair: (String, Int, Int) -> String = (table, a, b) -> {
  let c0 = to_b64(table = table, i = ((a) / (4)))
  let x1 = ((a % 4) * (16))
  let y1 = ((b) / (16))
  let c1 = to_b64(table = table, i = ((x1) + (y1)))
  let c2 = to_b64(table = table, i = ((b % 16) * (4)))
  String::concat(String::concat(String::concat(c0, c1), c2), "=")
}

let encode_single: (String, Int) -> String = (table, a) -> {
  let c0 = to_b64(table = table, i = ((a) / (4)))
  let c1 = to_b64(table = table, i = ((a % 4) * (16)))
  String::concat(String::concat(c0, c1), "==")
}

let rec encode_loop: (String, String, Int, String) -> String = (table, s, i, out) -> {
  let len = String::length(s)
  if lt(((i) + (2)), len) {
    let j = ((i) + (1))
    let k = ((i) + (2))
    let a = String::char_code_at(s, at = i)
    let b = String::char_code_at(s, at = j)
    let c = String::char_code_at(s, at = k)
    let next = String::concat(out, encode_triplet(table = table, a = a, b = b, c = c))
    encode_loop(table = table, s = s, i = ((i) + (3)), out = next)
  } else if lt(((i) + (1)), len) {
    let j = ((i) + (1))
    let a = String::char_code_at(s, at = i)
    let b = String::char_code_at(s, at = j)
    String::concat(out, encode_pair(table = table, a = a, b = b))
  } else if lt(i, len) {
    let a = String::char_code_at(s, at = i)
    String::concat(out, encode_single(table = table, a = a))
  } else {
    out
  }
}

let encode: (String, String) -> String = (table, s) -> {
  encode_loop(table = table, s = s, i = 0, out = "")
}

let rec repeat: (String, Int) -> String = (s, n) -> {
  if eq(n, 0) {
    ""
  } else {
    String::concat(s, repeat(s = s, n = ((n) - (1))))
  }
}

let rec bench_loop: (String, String, Int, Int) -> Int = (table, payload, n, acc) -> {
  if eq(n, 0) {
    acc
  } else {
    let encoded = encode(table = table, s = payload)
    bench_loop(table = table, payload = payload, n = ((n) - (1)), acc = (acc + String::length(encoded)))
  }
}

let payload = repeat(s = "abcdefghijklmnopqrstuvwxyz0123456789", n = 8)
let main = () -> Int {
  bench_loop(table = table, payload = payload, n = 10, acc = 0)
}
