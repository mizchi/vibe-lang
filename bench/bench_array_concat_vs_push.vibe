// Microbench: O(N²) `Array::concat(acc, [x])` accumulator vs O(N)
// `Array::push(acc, x)` in-place. Mirrors the pattern that commit
// (TBD) refactored in monoify.vibe / runtime/eval_loader/index.vibe /
// runtime/index.vibe.

let n_small = 32

let n_mid = 128

let n_large = 512

// O(N^2): each Array::concat(acc, [x]) allocates a new array of len
// N+1 and copies all N elements over.
let concat_build: (Int) -> Array[Int] = (n) -> {
  let mut acc = Array::slice([0], 0, 0)
  let mut i = 0
  while i < n {
    acc = Array::concat(acc, [i])
    i = i + 1
  }
  acc
}

// O(N): in-place amortized append.
let push_build: (Int) -> Array[Int] = (n) -> {
  let acc = Array::slice([0], 0, 0)
  let mut i = 0
  while i < n {
    Array::push(acc, i)
    i = i + 1
  }
  acc
}

bench "concat/n=32" {
  let _ = Array::length(concat_build(n_small))
}

bench "concat/n=128" {
  let _ = Array::length(concat_build(n_mid))
}

bench "concat/n=512" {
  let _ = Array::length(concat_build(n_large))
}

bench "push/n=32" {
  let _ = Array::length(push_build(n_small))
}

bench "push/n=128" {
  let _ = Array::length(push_build(n_mid))
}

bench "push/n=512" {
  let _ = Array::length(push_build(n_large))
}
