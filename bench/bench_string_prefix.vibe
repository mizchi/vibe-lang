// String::starts_with / ends_with throughput (SIMD prefix/suffix compare).
let rec repeat : (String, Int) -> String = (s, n) -> { if n == 0 { "" } else { String::concat(s, repeat(s, n - 1)) } }
let h = repeat("0123456789abcdef", 64)        // 1024B
let pre = repeat("0123456789abcdef", 63)       // 1008B prefix that matches
let suf = repeat("0123456789abcdef", 63)       // matches as suffix too
let rec sw_count : (String, String, Int, Int) -> Int = (s, p, n, acc) -> {
  if n == 0 { acc } else { sw_count(s, p, n - 1, acc + (if String::starts_with(s, p) { 1 } else { 0 })) }
}
let rec ew_count : (String, String, Int, Int) -> Int = (s, p, n, acc) -> {
  if n == 0 { acc } else { ew_count(s, p, n - 1, acc + (if String::ends_with(s, p) { 1 } else { 0 })) }
}
bench "starts_with/1008B-match" { let _ = sw_count(h, pre, 300, 0) }
bench "ends_with/1008B-match" { let _ = ew_count(h, suf, 300, 0) }
