test "collide match scrutinee" {
  let id = (x) -> { x }
  let n = id(3)
  let q = id(String::concat("y", ""))
  let r = (match n + 1 {
    v => __to_string(v)
  }) + q
  inspect(r, "4y")
}

test "collide block first stmt" {
  let id = (x) -> { x }
  let n = id(3)
  let p = id(String::concat("x", ""))
  let q = id(String::concat("y", ""))
  let r = ({
    n + 1
    p
  }) + q
  inspect(r, "xy")
}
