local selfhostPostGenerationGate = new Task {
  name = "post-generation-gate"
  description = "internal: complete selfhost operation gates that must run after stage generation"
  // EVERY lane in GATE_LANES (tests/gates/lib.sh), minus bootstrap, which
  // the generation step ahead of this task already ran. An enumeration is a
  // place a lane can go dark -- adding `selftests` without this line left the
  // gate self-test ratchet unrun on the documented `pkf run full-gate` path
  // while CI still selected it (#2650 review). check_gate_lane_coverage.sh
  // now rejects an enumeration that is missing a lane.
  cmd = "bash scripts/compiler_gate.sh early mid late selftests"
  cache = false
  visibility = "internal"
  inputs {
    ...vibeSources
    ...scriptSources
    "bench/perf/kpi_cases.txt"
    "scripts/corpus_baseline.txt"
  }
  deps { selfhostGenerationGate }
}

// #2877: the canary the LD_LIBRARY_PATH gate reads. Internal, and it must
// stay a REAL task -- the property being measured is what a pkf task inherits,
// so asking anything other than pkf would be testing a different environment.
// `sort` is the binary the original instance broke on; any system binary that
// reaches the dynamic loader would do.
local checkTaskEnv = new Task {
  name = "check-task-env"
  description = "internal: report the LD_LIBRARY_PATH a task inherits, and run a system binary"
  cmd =
    "printf 'task-env: LD_LIBRARY_PATH=%s\\n' \"${LD_LIBRARY_PATH:-}\"; sort --version >/dev/null 2>&1 && echo 'task-env: sort ok' || echo 'task-env: sort FAILED'"
  cache = false
  visibility = "internal"
}

local checkTaskEnvSanitized =
  scriptTask("check-task-env-sanitized", "scripts/check_task_env_sanitized.sh")

