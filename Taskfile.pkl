// === Test suites ===

local test = new Task {
  name = "test"
  // selfhost-only (#594): the MoonBit-host test suite (scripts/pkfire/test_suite.sh)
  // was retired with src/. Run the selfhost-only gate as the test
  // entry until selfhost unit-test running is ported (#594).
  cmd = "bash scripts/compiler_gate.sh"
  cache = false
  deps { testParallelSchedulerPrototype }
}

local testVibeLibrary = new Task {
  name = "test-library"
  // Smoke-run the selfhost-CLI-compilable subset of library `*_test.vibe`
  // (lib/@vibex/wasm, lib/@vibe/prelude). The selfhost-only gate only covers the
  // compiler self-compile, so this is the regression net for library modules
  // (the MoonBit-host flaker suite was retired in #594). Allow-list lives in the
  // script; also run in cli-install CI and the `cli` selfhost-gate shard.
  cmd = "bash scripts/test_vibe_library.sh"
  cache = false
}

local testLocal = new Task {
  name = "test-local"
  description = "affected local tests via flaker"
  cmd = "scripts/flaker_run.sh $@"
  acceptsArgs = true
  cache = false
}

// #988: affected tests from the compiler's OWN resolved import graph, no
// flaker involved. `test-local` picks by DIRECTORY (flaker.toml's `simple`
// resolver), which misses every test importing the change from elsewhere --
// editing lib/@vibe/compiler/core/types.vibe reaches 217 of 575 entries and
// selects 0. This walks `vibe deps` edges upward instead, and falls back to
// the full battery whenever it cannot prove an answer.
local testAffected = new Task {
  name = "test-affected"
  description = "tests reachable from the change via the real import graph (#988)"
  cmd = "bash scripts/test_affected.sh $@"
  acceptsArgs = true
  cache = false
}

local testFull = new Task {
  name = "test-full"
  description =
    "alias for test (heavy-wasm sub-suite retired: scripts/pkfire/test_wasm_heavy.sh no longer exists, #851)"
  deps { test }
}

