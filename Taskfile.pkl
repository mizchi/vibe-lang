local clean = new Task {
  name = "clean"
  cmd = "moon clean"
  cache = false
}

// Reclaim the persistent build cache (#631). `_build/vibe_*` entries are
// content-addressed and never deleted in place, so orphans accumulate as
// source/codegen changes re-key them; this is the explicit GC path. cache=false
// so it always runs. See docs/build-cache.md.
local cacheClean = new Task {
  name = "cache-clean"
  cmd = "bash scripts/cache_clean.sh"
  cache = false
}

local showWasmtimeBin = scriptTask("show-wasmtime-bin", "scripts/wasmtime_bin.sh")

