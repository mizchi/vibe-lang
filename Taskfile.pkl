local selfhostPerfKpi = new Task {
  name = "perf-kpi"
  description = "selfhost operation gate: perf KPI with cutover thresholds"
  cmd =
    "VIBE_PERF_COMPILER_KIND=cli-core VIBE_PERF_CHECKER_KIND=cli-core VIBE_PERF_COMPILE_DAEMON=1 VIBE_PERF_CHECK_DAEMON=1 VIBE_PERF_RUNS=3 VIBE_PERF_MAX_COMPILE_RATIO=2.5 VIBE_PERF_MAX_CHECK_RATIO=1.33 VIBE_PERF_CASES_FILE=bench/selfhost_perf/kpi_cases.txt scripts/bench_selfhost_perf.sh"
  inputs { ...moonSources; ...scriptSources; "bench/selfhost_perf/kpi_cases.txt" }
}

local selfhostRssKpi = new Task {
