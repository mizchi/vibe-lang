// === Release aggregates ===

local doctest = new Task {
  name = "doctest"
  description = "compile-check ```vibe blocks in docs via the selfhost stage2 doctest harness"
  cmd =
    "bash scripts/doctest_extract_run.sh README.md docs/user/reference/cheatsheet.md docs/user/reference/vibe.md docs/user/reference/syntax.md docs/user/reference/stable-surface.md docs/user/reference/host-abi.md docs/internal/design/component-lazy-dispatch.md docs/internal/design/decisions.md docs/internal/design/builtin-ssot-design.md docs/internal/design/memory-contract.md docs/internal/design/profiling.md docs/internal/design/rc-cutover-readiness.md docs/internal/design/rc-port.md docs/internal/design/show-trait-design.md docs/internal/design/simd-api-design.md docs/internal/design/structured-shell-design.md docs/internal/design/test-example-capabilities.md docs/internal/design/uniform-value-repr.md docs/internal/design/wasi-p3-async.md"
  // README.md is in the list because it was NOT, and its headline sample rotted
  // unnoticed: #1324 removed `Result` from the language and the sample kept
  // using bare `Ok`/`Err`, so the repo's most-read example failed to compile
  // (`unknown name: Err`) with nothing checking it.
  //
  // The task itself then repeated that lesson one level up: it was defined but
  // wired into NOTHING, so #1429 (braced effect row removed) and #1461 (`Error`
  // retired as a row spelling) migrated only lib/** and the docs kept the dead
  // syntax. It surfaced only when the seed bump to
  // console-exception-rowvar-2026-08-06 moved the seed past the removal (#1497).
  // It is now a release-check dep AND a compiler-gate CI step, where it runs
  // with DOCTEST_REQUIRE_STAGE2=1 against the freshly-built stage2.
  //
  // stage2 resolution depends on _build/selfhost state (falls back to the
  // committed seed), so skip pkfire caching to avoid stale green. The fallback
  // is why the CI step sets DOCTEST_REQUIRE_STAGE2=1: the seed is the previous
  // bootstrap tag and still accepts syntax the current compiler rejects, so a
  // seed-driven run reports green on rotted docs. Locally the fallback stays
  // permitted -- a dev without a stage2 still gets a useful (if weaker) check.
  cache = false
}

local doctestGated = new Task {
  name = "doctest-gated"
  description =
    "doctest against a stage2 built for THIS checkout (release-check / CI form; refuses the seed)"
  cmd =
    "DOCTEST_REQUIRE_STAGE2=1 bash scripts/doctest_extract_run.sh README.md docs/user/reference/cheatsheet.md docs/user/reference/vibe.md docs/user/reference/syntax.md docs/user/reference/stable-surface.md docs/user/reference/host-abi.md docs/internal/design/component-lazy-dispatch.md docs/internal/design/decisions.md docs/internal/design/builtin-ssot-design.md docs/internal/design/memory-contract.md docs/internal/design/profiling.md docs/internal/design/rc-cutover-readiness.md docs/internal/design/rc-port.md docs/internal/design/show-trait-design.md docs/internal/design/simd-api-design.md docs/internal/design/structured-shell-design.md docs/internal/design/test-example-capabilities.md docs/internal/design/uniform-value-repr.md docs/internal/design/wasi-p3-async.md"
  // Plain `doctest` resolves whatever stage2 happens to be lying in _build and
  // falls back to the committed seed. As a release-check dep that is unsound
  // twice over: pkfire runs sibling deps concurrently, so it could read a
  // half-built or stale generation, and the seed fallback is the exact blind
  // spot that let the #1429/#1461 syntax removals rot the docs unnoticed
  // (#1497). Depending on `generation` orders the stage2 build first, and
  // DOCTEST_REQUIRE_STAGE2=1 turns a missing stage2 into a failure instead of
  // a quiet downgrade to the previous bootstrap tag's grammar.
  cache = false
  deps { selfhostGeneration }
}

local checkExamplesTypecheck = new Task {
  name = "check-examples-typecheck"
  description =
    "type-check every examples/*.vibe against a stage2 built for THIS checkout (ratchet)"
  cmd = "bash scripts/check_examples_typecheck.sh"
  // Same rationale as `doctest-gated`: the script needs a stage2 for this
  // checkout and REFUSES the committed seed (previous bootstrap tag, still
  // accepts removed syntax), so order the build first rather than race it.
  cache = false
  deps { selfhostGeneration }
}

local checkPlaygroundPresets = new Task {
  name = "check-playground-presets"
  description = "type-check the vibe source of every playground preset (embedded in main.ts)"
  cmd = "bash scripts/check_playground_presets.sh"
  // Same rationale as `doctest-gated` / `check-examples-typecheck`: needs a
  // stage2 for this checkout and refuses the committed seed, so order the
  // build first rather than race it.
  cache = false
  deps { selfhostGeneration }
}

local vibeMdTutorial = new Task {
  name = "vibe-md-tutorial"
  description =
    "run ```vibe run blocks in book/**/*.vibe.md and verify embedded ```output matches (#1142)"
  cmd = "bash scripts/vibe_md.sh check book/en/*.vibe.md book/ja/*.vibe.md"
  // Developer convenience task: like plain `doctest`, this may fall back to
  // the committed seed when no stage2 exists. The release/CI gate below must
  // instead prove the docs against a compiler built from this checkout.
  cache = false
}

local vibeMdTutorialGated = new Task {
  name = "vibe-md-tutorial-gated"
  description =
    "tutorial executable-docs check against a stage2 built for THIS checkout (release-check / CI form)"
  cmd =
    "gen=\"$(ls -dt _build/selfhost/generations/*/ | head -1)\"; VIBE_MD_COMPILER=\"${gen}stage2.wasm\" VIBE_MD_STAGE2=\"${gen}stage2.wasm\" bash scripts/vibe_md.sh check book/en/*.vibe.md book/ja/*.vibe.md"
  // Build and run both the markdown tool and its extracted blocks with the
  // checkout's stage2. Naming both variables is deliberate: VIBE_MD_COMPILER
  // selects the compiler for vibe_md.vibex itself, while VIBE_MD_STAGE2 is
  // consumed by that tool for each tutorial block. Neither can fall back to
  // the committed seed.
  cache = false
  deps { selfhostGeneration }
}

local checkTutorialTranslationParity = new Task {
  name = "check-tutorial-translation-parity"
  description =
    "every original tour chapter in book/en has a book/ja translation, and each pair runs the same programs"
  cmd = "bash scripts/check_tutorial_translation_parity.sh"
  // vibe_md.sh proves each file on its own; this is the part it cannot see.
  // Two files that run the same programs record the same ```output blocks, so
  // comparing those catches code drift between a chapter and its translation
  // without diffing sources, which legitimately differ in their comments.
  cache = false
}

local checkBookConsole = new Task {
  name = "check-book-console"
  description =
    "prove book ch12's ```console transcripts by running the real launcher `vibe test` against the chapter's own source (book-review round 3)"
  cmd = "bash scripts/check_book_console.sh"
  // ```console blocks were the only output in the book's own format no gate
  // verified: doctest compiles ```vibe blocks and vibe-md checks ```output
  // pairs, but a CLI transcript needs the VERB run for real. Which compiler
  // answers is resolve_stage2's question (the #2138 rule): the HEAD-named
  // generation, never the newest directory by mtime -- a reused workspace
  // can hold a newer generation from an unrelated checkout.
  cache = false
  deps { selfhostGeneration }
}

local testCheckBookConsole = new Task {
  name = "test-check-book-console"
  description = "red/green for check-book-console: mutate the chapter, assert the gate fails"
  cmd = "bash scripts/check_book_console_test.sh"
  // Deliberately NOT deps { selfhostGeneration }: the cases hand the gate a
  // stub compiler, so the transcripts fail identically for every case and what
  // each asserts is the message its mutation adds on top -- extraction, ja/en
  // parity, and whether the chapter's documented 42 -> 43 edit still applies.
  // All three are decidable without a compiler, which is what keeps this at
  // ~1s so check_gate_self_tests.sh can run it on every gate pass.
  cache = false
}

local vibeMdFmtCheck = new Task {
  name = "vibe-md-fmt-check"
  description =
    "check that ```vibe code blocks in *.vibe.md docs are a fixpoint of the selfhost CST formatter"
  cmd = "bash scripts/vibe_md.sh fmt-check book/en/*.vibe.md book/ja/*.vibe.md"
  // informational, not enforced anywhere: the formatter's always-expanded-block
  // style (one import per line, every `if`/`fn` body on its own lines) fights
  // the compact, hand-tuned prose style these docs use for readability, so
  // this is NOT wired into release-check/full-gate the way check-vibe-fmt is
  // for lib/**/*.vibe. Run `pkf run vibe-md-fmt` to see/apply what it would
  // change for a specific file.
  cache = false
}

local vibeMdFmt = new Task {
  name = "vibe-md-fmt"
  description =
    "rewrite ```vibe code blocks in *.vibe.md docs in place via the selfhost CST formatter"
  cmd = "bash scripts/vibe_md.sh fmt \"$@\""
  acceptsArgs = true
  cache = false
}

local bookBuild = new Task {
  name = "book"
  description = "render book/ to _build/book/index.html via lib/@vibex/book"
  cmd = "bash scripts/vibe_book.sh"
  cache = false
}

local releaseSelfhostGates = new Task {
  name = "release-gates"
  description = "pre-release selfhost sign-off"
  // selfhost-only (#594): the component/preview2/parity/cutover gates compared
  // against the MoonBit host (retired with src/). The canonical gate
  // is scripts/compiler_gate.sh.
  cmd = "bash scripts/compiler_gate.sh"
  cache = false
}

local selfhostGate = new Task {
  name = "full-gate"
  description = "complete selfhost sign-off: staged seed->stage3 generation + post-generation gates"
  deps { selfhostPostGenerationGate }
}

local selfhostOnlyGate = scriptTask("compiler-gate", "scripts/compiler_gate.sh")

local releaseCheck = new Task {
  name = "release-check"
  description =
    "selfhost-only sign-off: bundle/module-source sync + seed->stage1->stage2->stage3 fixpoint + compile/run validation"
  deps {
    selfhostOnlyGate
    checkVibeFmt
    testEnsureEntryWasm
    testEnsureSeed
    testSeedAssetIdentity
    testReleaseBody
    testReleaseAssetsArgs
    checkBuiltinSpelling
    checkGrepNamedUnparseable
    checkArrayArgHead
    checkBuiltinArity
    checkImportedLexLocated
    checkVibexEntryLex
    checkReleaseDraftPromote
    checkFuzzCompilerIdentity
    checkSingleSourceLexDiag
    checkTaskfileFmt
    // These ran ONLY from the local pre-commit hook -- CI never invoked them.
    // That made the hook the single enforcement point, so #1729 (a stale
    // baseline failing untouched code) pushed everyone to `--no-verify` and
    // took the ratchet off entirely. A gate with one bypassable checkpoint is
    // not a gate.
    //
    // `lint-review-regressions` is deliberately NOT here: it lints
    // `git diff --cached`, so outside a pre-commit run there is nothing staged
    // and it passes vacuously. Its self-test is the part that carries meaning
    // away from the hook.
    lintArchitectureDebt
    // Registered but depended on by nothing until #2252, so it ran nowhere --
    // and in that time its allowlist file went missing, leaving the lint
    // failing on the tree with no one to see it. Same failure mode the
    // `testWasmValidateParity` comment below describes.
    lintTrackedExperimentNames
    // #2877: the nix wrapper leaks LD_LIBRARY_PATH into every task, and the
    // `defaults.env` row that clears it fails SILENTLY when removed -- tasks
    // keep running, some just stop seeing their own inputs. Depended on here
    // so the row has something watching it.
    checkTaskEnvSanitized
    checkGateWiring
    testCheckGateWiring
    checkGatePortability
    testCheckGatePortability
    checkGeneratedStampReport
    testCheckGeneratedStampReport
    checkBenchCorpus
    testCheckBenchCorpus
    checkBodyCacheDiscard
    testCheckBodyCacheDiscard
    checkDaemonMemoryDiagnostic
    testCheckDaemonMemoryDiagnostic
    checkTreesitterArtifacts
    testCheckTreesitterArtifacts
    checkTreesitterWasmCorpus
    testCheckTreesitterWasmCorpus
    checkDocPathCitations
    testDocPathCitations
    checkDocClassification
    testDocClassification
    testLintArchitecture
    testLintReviewRegressions
    testSessionStartGrep
    testVibeGrepBin
    testCheckBuiltinEmits
    testPreCommit
    testCheckMethodStyleNaming
    checkMethodStyleNaming
    testNormalizerScalarScan
    testCheckCanonicalIteratorCalls
    checkCanonicalIteratorCalls
    testCheckAstBinaryTags
    checkAstBinaryTags
    testCheckFreezeSurface
    checkFreezeSurface
    testCheckVersionLadder
    checkVersionLadder
    testCheckBookLinks
    checkBookLinks
    checkBookOrder
    checkBookSkipBlocks
    testVibeMdGuard
    checkSourceRangeContract
    testCheckSourceRangeContract
    checkDeclarationScale
    checkCliLineTermination
    checkCheatsheetSignatures
    checkBuiltinShadowing
    testCheckBuiltinShadowing
    checkDocumentedDecls
    testCheckDocumentedDecls
    checkGrepMemoryBudget
    testCheckGrepMemoryBudget
    checkGrepChunkedSweep
    testCheckGrepChunkedSweep
    checkGrepDriverParity
    testCheckGrepDriverParity
    checkPackageSiblingScope
    checkDocCommands
    checkRcDefault
    checkLambdaBoundRefusal
    testCheckLambdaBoundRefusal
    checkExportRefusal
    testCheckExportRefusal
    checkBodylessImplRefusal
    testCheckBodylessImplRefusal
    checkTelemetrySidecarGuards
    testCheckTelemetrySidecarGuards
    checkHostRemoveParity
    checkHostSemanticParity
    testCheckHostRemoveParity
    testCheckHostSemanticParity
    checkGcHostImportCounts
    testCheckGcHostImportCounts
    checkImportReservation
    testCheckImportReservation
    testCheckHostRuntimeContract
    testProfileCompile
    checkCompileOnlyLanes
    testCheckCompileOnlyLanes
    checkTaskInputs
    testCheckTaskInputs
    doctestGated
    vibeMdTutorialGated
    checkTutorialTranslationParity
    checkBookConsole
    testCheckBookConsole
    checkExamplesTypecheck
    checkPlaygroundPresets
    // Skips itself when wasm-tools is absent (it is the oracle), so this
    // cannot break a machine that lacks it -- but on one that has it, local
    // sign-off catches an undeclared proposal before CI does. The enforcing
    // copy is the gc-gate job in .github/workflows/ci.yml, which installs
    // wasm-tools; a task that is only registered runs nowhere.
    testWasmValidateParity
    // Registered since it was written and depended on by nothing, so it ran
    // nowhere -- the same shape the two comments above describe. #2361 added
    // the assertion that a program which does not compile explains itself on
    // stderr, which is worth exactly as much as the number of places that
    // assertion runs.
    testVibeRun
    testRelocCrossbuild
  }
}

local checkRelease = new Task {
  name = "check-release"
  description = "alias for release-check"
  deps { releaseCheck }
}

