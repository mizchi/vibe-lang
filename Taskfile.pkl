// #529 artifact-layer contract gate: dist (host-compiled shipping) and stage2
// (self-reproduced) compilers must agree on the vibe.abi custom section and
// behaviour of emitted program wasm. The two compiler binaries are byte-
// different by design; equivalence is a contract, not byte unification.
local testSelfhostDistStage2Parity =
  scriptTask("test-dist-stage2-parity", "scripts/test_dist_stage2_parity.sh")

// === Codegen / wasm / wasmtime ===

// Reclaim the persistent build cache (#631). `_build/vibe_*` entries are
// content-addressed and never deleted in place, so orphans accumulate as
// source/codegen changes re-key them; this is the explicit GC path. cache=false
// so it always runs. See docs/build-cache.md.
local cacheClean = new Task {
  name = "cache-clean"
  cmd = "bash scripts/cache_clean.sh"
  cache = false
}

local showWasmtimeBin = scriptTask("show-wasmtime-bin", "scripts/wasmtime_bin.sh")

local showWasmtimeFlags = new Task {
  name = "show-wasmtime-flags"
  cmd =
    #"echo "VIBE_WASMTIME_WASM_FLAGS=${VIBE_WASMTIME_WASM_FLAGS:-unknown-imports-default=y}"; echo "VIBE_WASMTIME_WASI_FLAGS=${VIBE_WASMTIME_WASI_FLAGS:-}""#
  cache = false
}

local wasmtimeSubmoduleInit = new Task {
  name = "wasmtime-submodule-init"
  cmd = "git submodule update --init deps/wasmtime"
  cache = false
}

local wasmtimeSubmoduleUpdate = new Task {
  name = "wasmtime-submodule-update"
  cmd = "git submodule update --remote deps/wasmtime"
  cache = false
}

local buildWasmtimeSubmodule = new Task {
  name = "build-wasmtime-submodule"
  cmd = "bash scripts/pkfire/build_wasmtime_submodule.sh ${1:-release}"
  acceptsArgs = true
  inputs { ".gitmodules"; "scripts/pkfire/build_wasmtime_submodule.sh" }
}

local wasmtimeSubmodule = new Task {
  name = "wasmtime-submodule"
  cmd = "bash scripts/pkfire/wasmtime_submodule.sh $@"
  acceptsArgs = true
  cache = false
}

local wasmtimeX64 = new Task {
  name = "wasmtime-x64"
  cmd = "bash scripts/pkfire/wasmtime_container.sh $@"
  acceptsArgs = true
  cache = false
}

local experimentalWasmtimeStackSwitching = new Task {
  name = "experimental_wasmtime_stack_switching"
  cmd = "bash scripts/pkfire/wasmtime_container.sh --stack-switching $@"
  acceptsArgs = true
  cache = false
}

local wasmtimeStackSwitching = new Task {
  name = "wasmtime-stack-switching"
  description = "alias for experimental_wasmtime_stack_switching"
  cmd = "bash scripts/pkfire/wasmtime_container.sh --stack-switching $@"
  acceptsArgs = true
  cache = false
}

local buildAsyncHost = new Task {
  name = "build-async-host"
  cmd = "cargo build --release --manifest-path tools/async_host/Cargo.toml"
  inputs { "tools/async_host/**/*" }
  outputs { "tools/async_host/target/release/vibe-async-host" }
}

local runWasmAsync = new Task {
  name = "run-wasm-async"
  cmd = "tools/async_host/target/release/vibe-async-host $@"
  acceptsArgs = true
  deps { buildAsyncHost }
  cache = false
}

local adr = new Task {
  name = "adr"
  cmd = "bash scripts/pkfire/adr_new.sh \"$@\""
  acceptsArgs = true
  cache = false
}

// === Release aggregates ===

local doctest = new Task {
  name = "doctest"
  description = "compile-check ```vibe blocks in docs via the selfhost stage2 doctest harness"
  cmd =
    "bash scripts/doctest_extract_run.sh docs/cheatsheet.md docs/vibe.md docs/language-tour/*.md"
  // stage2 resolution depends on _build/selfhost state (falls back to the
  // committed seed), so skip pkfire caching to avoid stale green.
  cache = false
}

local vibeMdTutorial = new Task {
  name = "vibe-md-tutorial"
  description =
    "run ```vibe run blocks in docs/tutorial/*.vibe.md and verify embedded ```output matches (#1142)"
  cmd = "bash scripts/vibe_md.sh check docs/tutorial/*.vibe.md"
  // same rationale as `doctest`: stage2 resolution depends on _build/selfhost
  // state, so skip pkfire caching to avoid stale green.
  cache = false
}

local vibeMdFmtCheck = new Task {
  name = "vibe-md-fmt-check"
  description =
    "check that ```vibe code blocks in *.vibe.md docs are a fixpoint of the selfhost CST formatter"
  cmd = "bash scripts/vibe_md.sh fmt-check docs/tutorial/*.vibe.md docs/language-tour/*.vibe.md"
  // informational, not enforced anywhere: the formatter's always-expanded-block
  // style (one import per line, every `if`/`fn` body on its own lines) fights
  // the compact, hand-tuned prose style these docs use for readability, so
  // this is NOT wired into release-check/full-gate the way check-vibe-fmt is
  // for lib/**/*.vibe. Run `pkf run vibe-md-fmt` to see/apply what it would
  // change for a specific file.
  cache = false
}

local vibeMdFmt = new Task {
  name = "vibe-md-fmt"
  description =
    "rewrite ```vibe code blocks in *.vibe.md docs in place via the selfhost CST formatter"
  cmd = "bash scripts/vibe_md.sh fmt \"$@\""
  acceptsArgs = true
  cache = false
}

local releaseSelfhostGates = new Task {
  name = "release-gates"
  description = "pre-release selfhost sign-off"
  // selfhost-only (#594): the component/preview2/parity/cutover gates compared
  // against the MoonBit host (retired with src/). The canonical gate
  // is scripts/compiler_gate.sh.
  cmd = "bash scripts/compiler_gate.sh"
  cache = false
}

local selfhostGate = new Task {
  name = "full-gate"
  description = "complete selfhost sign-off: staged seed->stage3 generation + post-generation gates"
  deps { selfhostPostGenerationGate }
}

local selfhostOnlyGate = scriptTask("compiler-gate", "scripts/compiler_gate.sh")

local releaseCheck = new Task {
  name = "release-check"
  description =
    "selfhost-only sign-off: bundle/module-source sync + seed->stage1->stage2->stage3 fixpoint + compile/run validation"
  deps {
    selfhostOnlyGate
    checkVibeFmt
    checkMethodStyleNaming
    // NOTE: `doctest` (docs ```vibe compile check) is intentionally NOT yet a
    // release-check dep — this sandbox cannot evaluate the pkfire graph
    // (package fetch 403), so the wiring is unverified. Run `pkf run doctest`
    // standalone or wire it as an independent CI step first; promote to a dep
    // here once `pkf run release-check` is confirmed green with it.
  }
}

local checkRelease = new Task {
  name = "check-release"
  description = "alias for release-check"
  deps { releaseCheck }
}

