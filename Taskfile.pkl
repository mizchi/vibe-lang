}

// === HTTP / selfhost gates ===

// Selfhost unit-test runner (#531/#535): compile+run the allowlisted
// *_test.vibe corpus through the selfhost compiler. `--scan` reports drift,
// `--update-allowlist` ratchets the allowlist.
local testSelfhostUnit = new Task {
  name = "test-unit"
  description = "run allowlisted *_test.vibe through the selfhost compiler (#531/#535)"
  cmd = "bash scripts/unit_test_runner.sh $@"
  acceptsArgs = true
  cache = false
}

// Phase 2 of the selfhost Perceus RC port (docs/spec/selfhost-rc-port.md):
// unit-test the ported analysis pass in isolation via the native vibe CLI.

// Phase 1 safety net for the selfhost RC port (docs/spec/selfhost-rc-port.md):
// compile heap-object source programs with the selfhost backend, run them on
// wasmtime, and check results — locks current heap layouts before the uniform
// object-header change.

// Reliable verification loop for the selfhost Perceus RC work (ADR-0055):
// runs the heap-e2e correctness gate from a UNIQUELY-NAMED copy (so the
// pure-test result cache is never stale) AND asserts RC reclamation is ~0
// bytes/iter for tuple/record/enum/array. See the script header for the
// caching/sandbox traps this avoids.

// ADR-0055 #493: whole-compiler self-compile through stage1, both backends,
// asserting RC-vs-default parity (RC adds no compile gap at full compiler scale).
// Auto-upgrades to a full whole-compiler-under-RC green signal once the shared
// default-path ceiling is lifted. See docs/spec/selfhost-rc-cutover-readiness.md.
local testSelfhostRcBootstrap =
  scriptTask("test-rc-bootstrap", "scripts/test_rc_bootstrap.sh")

// #538: wasm-gc selfbuild frontier report (informational; always exits 0).
local testGcSelfbuild = scriptTask("test-gc-selfbuild", "scripts/test_gc_selfbuild.sh")

local testSelfhostWasiSelfbuildKpi = new Task {
  name = "test-wasi-selfbuild-kpi"
  cmd =
    "VIBE_SELFBUILD_STRICT_RECURSIVE=1 VIBE_SELFBUILD_REQUIRE_TRUE_RECURSIVE=1 VIBE_SELFBUILD_MAX_TOTAL_SEC=\"${1:-300}\" scripts/test_selfhost_wasi_selfbuild.sh"
  acceptsArgs = true
  inputs { ...moonSources; ...scriptSources }
}

