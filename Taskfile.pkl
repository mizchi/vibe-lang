// Uncached for the same reason as bench-module-job-pool below: the assertion
// is that what the warm-pool coordinator publishes does not depend on how much
// of it ran at once, and re-running that on an unchanged tree is the point.
local testParallelWarmPool = new Task {
  name = "test-warm-pool"
  description =
    "warm-pool coordinator: byte-identical publish at -P 1/2/4/8, peak workers within the -P bound, no leaked workers"
  cmd = "bash scripts/test_parallel_warm_pool_gate.sh"
  cache = false
  inputs { ...moonSources; ...scriptSources }
}

// Uncached for the same reason as test-warm-pool: the assertion is that the
// store the walk reaches does not depend on the schedule it took to get
// there, and re-running that on an unchanged tree is the point. #1259 --
// this is the first check that runs the REAL compile path against
// formal/VibeFormal/Compiler/Scheduler.lean rather than a synthetic worker.
local testSchedulerTraceOracle = new Task {
  name = "test-scheduler-oracle"
  description =
    "#1239 step 8: the real walk's trace satisfies Scheduler.lean's Project/Ready/Complete, and reaches the same store under permuted schedules"
  cmd = "bash scripts/scheduler_trace_oracle.sh"
  cache = false
  inputs { ...moonSources; ...scriptSources }
}

// Uncached (like kpi-selfcompile) because neither of the two things this
// asserts is a function of the file inputs. The hard assertion is a race
// detector -- outcome/fingerprint/env must stay byte-identical at -P 1/2/4/8 --
// and re-running it on an unchanged tree is exactly the point. The speedup
// floor depends on host cores and load, and the VIBE_JOBPOOL_BENCH_* overrides
// are invisible to the input set, so a cache hit would report success for a
// configuration it never measured.
local benchModuleJobPool = new Task {
  name = "bench-module-job-pool"
  description =
    "module-job process pool: determinism at -P 1/2/4/8 (gate) + parallel speedup (measured)"
  cmd = "bash scripts/bench_module_job_pool.sh"
  cache = false
  inputs { ...moonSources; ...scriptSources }
}

