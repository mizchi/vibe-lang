    "book/**/*.md"
  }
}
// The book's ```vibe skip blocks each claim a rejection and quote a
// diagnostic, and the doctest harness cannot look at them -- it runs `vibe
// run` blocks and skips these by definition. One had rotted into
// demonstrating the fix instead of the failure (#2156 review). Needs a
// compiler, so callers that build a stage2 should hand it over via
// VIBE_SKIP_BLOCK_CLI_WASM. Not `scriptTask`, same reason as its siblings.
local checkBookSkipBlocks = new Task {
  name = "check-book-skip-blocks"
  description = "every ```vibe skip block is still rejected, with its quoted diagnostic"
  cmd = "bash scripts/check_book_skip_blocks.sh"
  // vibeSources too: the ANSWER comes from the compiler, so a compiler change
  // can start accepting a skip block or reword its diagnostic without touching
  // a script or a chapter. Without this the cache key is unchanged and
  // release-check replays a pass that recompiled nothing (#2156 review) --
  // the same "a cached pass has checked nothing" reasoning that keeps this
  // out of scriptTask, one level up.
  inputs {
    ...scriptSources
    ...compilerProbeInputs
    "book/**/*.md"
  }
  // Same reason as check-rc-default and check-package-sibling-scope: the
  // verdict is the current compiler's, so the current compiler has to exist
  // before this runs. As siblings in release-check's deps this could go first
  // and answer from the seed (#2156 review).
  deps { selfhostGeneration }
}
// Two doctest harnesses answer differently on the same document; the guard in
// scripts/vibe_md.sh keeps a prose doc from reaching the *.vibe.md one.
local testVibeMdGuard = new Task {
  name = "test-vibe-md-guard"
  description = "the doctest guard, and that one compiler resolution decides a run"
  cmd = "VIBE_MD_GUARD_REQUIRE_COMPILER=1 bash scripts/vibe_md_guard_test.sh"
  // compilerProbeInputs + deps, for the same reason as check-book-skip-blocks
  // above: cases 6-8 ASK THE COMPILER (case 8 compiles a wrong import kind
  // twice and asserts the two lanes agree), so a compiler change can flip the
  // answer without touching a script -- and as a release-check sibling this
  // could otherwise run first, find no compiler, and exit 0 having skipped the
  // three cases it exists for (#2190 review).
  inputs {
    ...scriptSources
    ...compilerProbeInputs
  }
  deps { selfhostGeneration }
}
// ADR-0108 / docs/user/reference/source-range-contract.md: six editor-query surfaces share one
// position unit. A surface that switched units would fail SILENTLY (a wrong
// column answers about an earlier position, and empty reads as clean).
local checkSourceRangeContract =
  scriptTask("check-source-ranges", "scripts/check_source_range_contract.sh")
local testCheckSourceRangeContract =
  scriptTask("test-check-source-ranges", "scripts/check_source_range_contract_test.sh")
// #2134: the host's JS stack, not the compiler, caps how many top-level
// declarations a module may have (~1300 on node's default). A VALID file
// simply stopped compiling. The gate generates unique content every run --
// a successful compile caches a row keyed by source, so a fixed corpus would
// pass forever after its own first green run, fix or no fix.
// #2133: the line-oriented queries joined records with "\n" instead of
// terminating them, so a shell `while read` dropped the last record and
// concatenating two answers merged one record into another -- silently. Empty
// must stay byte-empty, which is what rules out the naive always-append fix.
// #2121: AGENTS.md sends every reader to the cheatsheet first, and doctest
// only compiles its ```vibe blocks -- it is blind to a table. This checks the
// Signature reference against the CHECKER's builtin table: arity per entry,
// plus that the import caveat names exactly the documented non-builtins.
// docs/internal/project/adding-modules.md, enforced: a package's files do NOT share a scope.
// Export, contract entry and an explicit ./import are all required, and each
// omission fails differently -- so two of the three gives an error that does
// not name the third. Checked because the cost it reveals (every shared helper
// becomes public surface) belongs in a split's plan, not its last commit.
// A task that RUNS the compiler must have the compiler in its cache key.
// `scriptTask` gets that by default; a hand-written `new Task` spells `inputs`
// out to ADD something and can end up REPLACING the defaults instead, leaving a
// task that passes from cache after the very change it exists to catch. That
// happened three times on one branch -- twice by me, once caught in review --
// which is what makes it a gate rather than a note.
// Taskfile.pkl is this gate's SUBJECT, so it is an input -- the same rule the
// gate itself enforces, which it was breaking (#2138 review). A task added with
// incomplete inputs would otherwise pass on a replayed verdict.
local checkTaskInputs = new Task {
  name = "check-task-inputs"
  description = "a task that runs the compiler keys on the compiler"
  cmd = "bash scripts/check_task_inputs.sh"
  inputs {
    ...scriptSources
    "Taskfile.pkl"
  }
}
local testCheckTaskInputs =
  scriptTask("test-check-task-inputs", "scripts/check_task_inputs_test.sh")
// Every command a document SHOWS a reader must name things that exist.
// check-doc-path-citations covers backticked paths in PROSE and does not look
// inside fenced blocks -- which is where the commands are, and where the
// getting-started chapter told newcomers to run `bash scripts/install.sh`
// against an installer that lives at install/install.sh.
// Which backend is the linear default, asked of the COMPILER. Three places
// recorded an answer and disagreed -- AGENTS.md and ADR-0055 said the cutover
// happened, docs/internal/design/rc-cutover-readiness.md still told the reader to hold it.
// Nothing checked which was true, so nothing corrected the one that was not.
local checkRcDefault = new Task {
  name = "check-rc-default"
  description = "the compiler's linear default backend, and the document that names it, agree"
  cmd = "bash scripts/check_rc_default.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "docs/internal/design/rc-cutover-readiness.md"
  }
  deps { selfhostGeneration }
}
// #2737: a witness dispatch on a bound declared by a LAMBDA binder is refused.
// Only a top-level generic is threaded, so `[T: Eq]` on a lambda binder is
// accepted by the parser and the checker and honoured by nothing -- and the
// fallthrough was not a worse answer but undefined behaviour (an unresolved name
// lowered to a table call on a bogus index; the erased representation printed for
// an interpolation). Asked of the running compiler, message included.
// #2934 (0.1.0-rc.0 bug hunt): a builtin the CHECKER admits must be lowered
// under the SPELLING it was admitted under. `HostStream::close` and
// `host_stream_close` share a signature and both type-check clean; only the
// bare one was in the default lane's dispatch, so the namespaced one died with
// `reached code generation unresolved` -- a message telling the reader to
// report a compiler bug for an operation that simply was not wired up. Same
// shape as #2913 (`map_has`) and #2900 (four `Array::` names).
// #2940: `vibe grep` answered "no matches" (exit 0, empty stdout) for a file
// named on the command line that it could not parse, where `vibe check` on the
// same file exits 1 with a located diagnostic. Naming a file is asking about
// that file. The SWEEP case is deliberately unchanged (#1943), and the test
// carries that as a control alongside a no-match control -- without them,
// "refuse whenever stdout is empty" would pass the red case.
// #2936: the `Array::` builtins check their receiver AND their callback.
// `Array::map(xs, 0)` -- forgetting the closure -- type-checked clean and
// emitted a module that would not load, with no source location. Two holes:
// six names have a dedicated checker arm ahead of the general one that owns
// the receiver check, and the non-receiver head table deliberately skipped
// higher-order arguments. Carries controls both ways: the names that were
// never broken must still refuse, and real higher-order code must still
// compile AND run with the right answers -- otherwise "refuse everything"
// passes the red rows.
// #2941: `builtin_fixed_arity` falls back to the registry, which answers -1
// for a name with no row -- "no certain arity, tolerate". Eleven names landed
// there, so any argument count reached codegen: `Path::resolve("/a", "b")`
// was clean at `vibe check` and then `reached code generation unresolved`,
// telling the reader to report a compiler bug for one argument too many.
// Carries the other half as a control: each name at its DECLARED arity must
// still be accepted and still run, since a wrong arity in the table would
// reject correct code while every red row still passed.
local checkBuiltinArity = new Task {
  name = "check-builtin-arity"
  description =
    "builtins enforce their argument count, and the declared arity still compiles and runs"
  cmd = "bash scripts/builtin_arity_test.sh"
  inputs {
    ...compilerProbeInputs
    "scripts/builtin_arity_test.sh"
  }
  deps { selfhostGeneration }
}
local checkArrayArgHead = new Task {
  name = "check-array-arg-head"
