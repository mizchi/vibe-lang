local checkDocCommands = new Task {
  name = "check-doc-commands"
  description = "commands shown in docs name tasks, scripts and env vars that exist"
  cmd = "bash scripts/check_doc_commands.sh"
  // Everything this gate READS, on both sides of the comparison: the documents
  // it scans and the tree it resolves their references against. Under the
  // default inputs it saw the documents but not tests/**, eval/** or
  // install/**, so every VIBE_* lookup came back empty and 38 live variables
  // were reported as unread -- the gate failing loudly rather than passing
  // vacuously, but wrong either way.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "Taskfile.pkl"
    "*.md"
    "docs/**/*.md"
    "book/**/*.md"
    // Every README in the tree, wherever it lives -- the gate now scans them
    // all (#2138 review), so lib/@vibe/compiler/README.md going stale must
    // invalidate this task the same way docs/ does. compilerProbeInputs covers
    // lib/**/*.vibe but not lib/**/README.md.
    "**/README.md"
    // The launcher IS the verb list: the gate parses `vibe help` and the
    // dispatch case out of it, so adding or removing a command has to
    // re-run this comparison.
    "runtime/vibe"
    // Every glob the script SCANS, not a subset of it (#2138 review): it reads
    // .js/.ts/.toml/.md under these roots too, so an env-var reader removed
    // from scripts/wasm_vibe_host_runner.js would otherwise replay the old
    // verdict. Inputs may over-approximate; they may never under-.
    "scripts/**"
    "tests/**"
    "eval/**"
    "install/**"
    "scripts/doc_commands_allowlist.tsv"
  }
}
local checkPackageSiblingScope = new Task {
  name = "check-package-sibling-scope"
  description = "export + contract entry + explicit ./import are all required to reach a sibling"
  cmd = "bash scripts/check_package_sibling_scope.sh"
  inputs { ...compilerProbeInputs; ...scriptSources }
  // Same reason as check-cheatsheet-signatures: the verdicts are the current
  // compiler's, so it has to be the current compiler that answers.
  deps { selfhostGeneration }
}
// NOT `scriptTask`: the document under test and the probe are inputs too.
// `scriptSources` globs scripts/**/*.{sh,mjs,vibex} and `vibeSources` globs
// lib/**, so neither docs/user/reference/cheatsheet.md nor a `.vibe` probe living in scripts/
// is hashed. Without them, editing the signature table replays a cached "ok"
// and this gate answers a stale question -- about the one file it exists to
// watch. Same reason testDocPathCitations spells its inputs out.
local checkCheatsheetSignatures = new Task {
  name = "check-cheatsheet-signatures"
  description = "the cheatsheet's Signature reference matches the checker's builtin table"
  cmd = "bash scripts/check_cheatsheet_signatures.sh"
  // BOTH sides of the comparison are inputs. Listing only the document was
  // half a fix: `lookup_builtin` lives in lib/**, so a change to the builtin
  // tables without touching these three files would have replayed the old
  // verdict -- the compiler-side drift this task exists to catch, passing.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "docs/user/reference/cheatsheet.md"
    "scripts/cheatsheet_signature_probe.vibe"
  }
  // The oracle must be THIS checkout's compiler. Without the dep both scripts
  // pick the newest existing generation, or fall back to the committed seed --
  // so on a clean run they can answer from the seed while stage2 is still
  // building, and on a reused workspace from an unrelated generation.
  deps { selfhostGeneration }
}
// NOT `scriptTask`: the ALLOWLIST is an input too. Without it, editing the
// exemption list replays a cached "ok" -- the list would stop being checked by
// the one gate that reads it, which is how an allowlist goes stale unnoticed
// (#2138 review, same reason as checkCheatsheetSignatures above).
local checkBuiltinShadowing = new Task {
  name = "check-builtin-shadowing"
  description = "no file under lib/** defines a name the builtin registry owns (#2378)"
  cmd = "bash scripts/check_builtin_shadowing.sh"
  inputs {
