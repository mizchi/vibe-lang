local testVibeGrepBin = scriptTask("test-vibe-grep-bin", "scripts/vibe_grep_bin_test.sh")
local checkBuiltinEmits = scriptTask("check-builtin-emits", "scripts/check_builtin_emits.sh")
local testCheckBuiltinEmits =
  scriptTask("test-check-builtin-emits", "scripts/check_builtin_emits_test.sh")
local testPreCommit = scriptTask("test-pre-commit", "scripts/precommit_test.sh")
local testReviewLintVibex = new Task {
  name = "test-review-lint-vibex"
  description = "run the review-derived vibe grep rule engine self-test"
  cmd = "bash scripts/vibe_run.sh scripts/review_lint.vibex -- --self-test"
  inputs { ...vibeSources; ...scriptSources }
  cache = false
}
// NOT scriptTask: that factory keys on compiler sources plus
// `scripts/**/*.{sh,mjs,vibex}`, and this lint reads neither of those things.
// It walks the git index for every probe-like path under `scripts/` AND
// `.github/` at any extension, and it reads
// `scripts/tracked_experiment_name_allowlist.txt` -- so a new
// `.github/cache_probe.yml`, a new `scripts/new_probe.vibe`, or an edit to the
// allowlist leaves the key unchanged and a cached `ok` can replay over a tree
// nobody inspected (#2248 review).
//
// Declaring those paths would work, but it is the same shape of bookkeeping
// that just went wrong: the input list has to be re-derived every time the
// scan widens. The lint is 0.15s. Not caching it cannot be wrong, and this
// PR's own rule is to remove the structure that needs the bookkeeping rather
// than to keep the bookkeeping correct.
local lintTrackedExperimentNames = new Task {
  name = "lint-tracked-experiment-names"
  description = "tracked throwaway/probe-like filenames need an explicit allowlist entry"
  cmd = "bash scripts/lint_tracked_experiment_names.sh"
  cache = false
}
// These four read GENERATED ARTIFACTS, which `scriptTask` does not key on: its
// inputs are the compiler identity plus `scripts/**`, so a changed wasm, corpus
// or loader manifest is invisible to the cache and a stale verdict could replay
// (#2422 review). That is the #2165 defect aimed at data instead of at the
// compiler -- a task still passing, from cache, after the very change it exists
// to catch. So they are spelled out, and each keys on what it actually reads.
// `compilerProbeInputs` is kept as the safe over-approximation the ratchet
// wants: a needless re-run costs time, an under-approximation costs a wrong
// answer.
local treesitterArtifactInputs: Listing<String> = new {
  "integrations/treesitter-vibe/generated.sha256"
  "integrations/treesitter-vibe/src/parser.c"
  "playground/public/tree-sitter-vibe.wasm"
  "integrations/zed-vibe/grammars/vibe.wasm"
}
// The corpus gate additionally parses with the loader the playground pins, and
// its self-test drives a committed stale artifact.
local treesitterCorpusInputs: Listing<String> = new {
  ...treesitterArtifactInputs
  "integrations/treesitter-vibe/test/corpus/*.txt"
  "integrations/treesitter-vibe/test/fixtures/*.wasm"
  "playground/package.json"
  "playground/pnpm-lock.yaml"
}
local checkTreesitterArtifacts = new Task {
  name = "check-treesitter-artifacts"
  description = "the tree-sitter C parser and both wasm artifacts move together, at ABI 15"
  cmd = "bash scripts/check_treesitter_artifacts.sh"
  inputs { ...compilerProbeInputs; ...scriptSources; ...treesitterArtifactInputs }
}
local testCheckTreesitterArtifacts = new Task {
  name = "test-check-treesitter-artifacts"
  description = "red test: the artifact-pairing gate must reject a half-rebuilt tree"
  cmd = "bash scripts/check_treesitter_artifacts_test.sh"
  inputs { ...compilerProbeInputs; ...scriptSources; ...treesitterArtifactInputs }
}
local checkTreesitterWasmCorpus = new Task {
  name = "check-treesitter-wasm-corpus"
  description = "each committed tree-sitter wasm parses the corpus the way the grammar says"
  cmd = "bash scripts/check_treesitter_wasm_corpus.sh"
  inputs { ...compilerProbeInputs; ...scriptSources; ...treesitterCorpusInputs }
}
local testCheckTreesitterWasmCorpus = new Task {
  name = "test-check-treesitter-wasm-corpus"
  description = "red test: the corpus gate must reject a stale wasm, and the stamper must refuse it"
  cmd = "bash scripts/check_treesitter_wasm_corpus_test.sh"
  inputs { ...compilerProbeInputs; ...scriptSources; ...treesitterCorpusInputs }
}
// #2580: a gate that runs nowhere is indistinguishable from a passing one.
// Three went dark before anything checked; this resolves reachability from the
// workflows through pkf tasks and the script graph.
local checkGateWiring = scriptTask("check-gate-wiring", "scripts/check_gate_wiring.sh")
local testCheckGateWiring =
  scriptTask("test-check-gate-wiring", "scripts/check_gate_wiring_test.sh")
local checkGatePortability =
  scriptTask("check-gate-portability", "scripts/check_gate_portability.sh")
local testCheckGatePortability =
  scriptTask("test-check-gate-portability", "scripts/check_gate_portability_test.sh")
// The "say what moved" report in ensure_generated.sh must not be able to kill
// the regeneration it explains: `printf | head` takes SIGPIPE on a diff larger
// than the pipe buffer, and pipefail + set -e turned that into exit 141 with no
// artifacts written. It failed only in the large case -- a fresh clone or a
// seed bump -- which is exactly when regeneration is needed.
local checkGeneratedStampReport =
  scriptTask("check-generated-stamp-report", "scripts/check_generated_stamp_report.sh")
local testCheckGeneratedStampReport =
  scriptTask("test-check-generated-stamp-report", "scripts/check_generated_stamp_report_test.sh")
// #2865: the lex/parse series read the live compiler sources, so a PR that
// edited the checker moved the INPUT of the benchmark that measures the parser
// (+17.3% B/op on one such PR, compiler held fixed). The corpus is frozen under
// bench/perf/corpus/; this keeps it frozen and keeps the benches pointed at it.
local checkBenchCorpus = scriptTask("check-bench-corpus", "scripts/check_bench_corpus.sh")
local testCheckBenchCorpus =
  scriptTask("test-check-bench-corpus", "scripts/check_bench_corpus_test.sh")
// #2873: a compile that will not READ its body cache must say so. The OUT
// cache is the second of the `body_cache_in, body_cache_out` pair, and an
// INLINE `codegen_body_cache_new()` there is provably unread -- the caller
// never bound it -- so every row `record` fills is allocated and, on the bump
// lane, never reclaimed.
// #2876: several compiler-sized compiles in one `--daemon` walk the
// never-freed bump allocator into the wasm32 ceiling, and what surfaced was a
// bare `unreachable` in 1us with no `.diag` -- the shape a caller reserves for
// "the compiler died". The gate asks the same arithmetic of the same code with
// a 60-byte hand-encoded module, so it costs ~1s instead of two 4 GB compiles.
local checkDaemonMemoryDiagnostic =
  scriptTask("check-daemon-memory-diagnostic", "scripts/check_daemon_memory_diagnostic.sh")
local testCheckDaemonMemoryDiagnostic =
  scriptTask(
    "test-check-daemon-memory-diagnostic",
    "scripts/check_daemon_memory_diagnostic_test.sh",
  )
local checkBodyCacheDiscard =
  scriptTask("check-body-cache-discard", "scripts/check_body_cache_discard.sh")
local testCheckBodyCacheDiscard =
  scriptTask("test-check-body-cache-discard", "scripts/check_body_cache_discard_test.sh")
local testLintTrackedExperimentNames =
  scriptTask("test-lint-tracked-experiment-names", "scripts/lint_tracked_experiment_names_test.sh")
// The bundles and the flat module source are no longer committed, so there is
// nothing to check them AGAINST -- `ensure-generated` produces them instead.
// (Was: check-bundle-sync + check-module-source-sync, which regenerated the
// same artifacts purely to diff them against the tracked copies.)
local checkSelfhostPortableBoundary =
  scriptTask("check-portable-boundary", "scripts/check_portable_boundary.sh")
// #2577: the gate had rotted to an `index.vibe` / `with { Error }` shape two
// ADRs old and reported a missing boundary that was intact in the contract
// beside it. The self-test pins that it can still fail -- and that a doc
// comment naming a native entry point is not a leak, which is what the repair
// had to distinguish.
local testSelfhostPortableBoundary =
  scriptTask("test-portable-boundary", "scripts/check_portable_boundary_test.sh")
local checkHostRuntimeContract = new Task {
  name = "check-host-runtime-contract"
  description = "fail-closed conformance check for the documented vibe.* core host ABI"
  cmd =
    "python3 scripts/check_host_runtime_contract.py && python3 tests/gates/tooling-accounting/host-runtime/host_runtime_contract_test.py"
  inputs {
    "docs/generated/host-runtime-contract.json"
    "scripts/check_host_runtime_contract.py"
    "tests/gates/tooling-accounting/host-runtime/host_runtime_contract_test.py"
    "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe"
    "lib/@vibe/compiler/codegen/gc/backend_body.vibe"
    "runtime/viberun/src/main.rs"
    "scripts/wasm_vibe_host_runner.js"
  }
}
// #2825 step 1 (docs/internal/design/capability-host-contract.md). ADR-0088's amendment makes
// `perform?` an instantiate-time branch, so a module declares the ungranted
// arm's host import and a host has to be able to WITHHOLD a capability: link
// something of the right type, and trap if it is called. Neither runner could
// express that -- the node runner answered `0` for any `vibe.*` field it did
// not implement, which is the silent-wrong end of the design policy.
//
// Not `scriptTask`: `scriptSources` globs `.sh` / `.mjs` / `.vibex`, so the
// runner this test runs, withholds against, and MUTATES for its red case is
// not in the shared key -- an edit to it would replay this task's cached pass
// (Codex on #2844, P2). Named explicitly, the way `check-host-runtime-contract`
// already names it, and the two shared spreads are kept: spelling `inputs` out
// to ADD one path and losing the defaults is the #2138 mistake.
local checkCapabilityPreflight = new Task {
  name = "check-capability-preflight"
  description = "ADR-0088 L1 flags and the L3 entry preflight are reachable from a real run (#2828)"
  cmd = "bash scripts/check_capability_preflight.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
  }
  // The gate RUNS a program through the launcher and asserts which authority
  // it is refused, so the compiler it asks has to be the checkout's
  // (AGENTS.md, "Which compiler answered?"). Without this dep it would resolve
  // the newest generation on disk -- which, on a reused workspace, is how a
  // gate reports green about a ladder that is not connected in this tree.
  deps { selfhostGeneration }
}

local testCapabilityPreflight = new Task {
  name = "test-capability-preflight"
  description = "red test: a compiler without the connected ladder FAILS check-capability-preflight"
  cmd = "bash scripts/check_capability_preflight_test.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
  }
  deps { selfhostGeneration }
}

local testHostAsyncImportUnsupported = new Task {
  name = "test-host-async-import-unsupported"
  description = "an async host import this runner does not implement is refused, not answered 0"
  cmd = "bash scripts/host_async_import_unsupported_test.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "scripts/wasm_vibe_host_runner.js"
  }
  deps { selfhostGeneration }
}

local testHostCapabilityWithhold = new Task {
  name = "test-host-capability-withhold"
  description = "a withheld capability links a trapping stub, and the trap is proven to fire"
  cmd = "bash scripts/host_capability_withhold_test.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "scripts/wasm_vibe_host_runner.js"
    // Mirror what `ensure_viberun.sh`'s `src_hash` hashes -- every file under
    // src/ plus both manifests -- so the two cannot disagree about which
    // binary this gate is entitled to replay a verdict for. Keying on
    // src/main.rs alone left a wasmtime bump (exactly the kind of change that
    // can move `Linker` shadowing behaviour, which the stub depends on)
    // outside the key (Codex on #2844, P2).
    //
    // Measured, and worth knowing before trusting any of this: TODAY THIS
    // TASK IS NEVER CACHED. Two consecutive runs with nothing changed both
    // report `2 task(s) · 2 ran`, because `selfhostGeneration` below is
    // `cache = false` and a dependent of an always-running task runs too. So
    // the replay above is currently unreachable, and this list is describing
    // what WOULD decide the answer rather than closing a live hole. It is
    // spelled out anyway: the day that dep goes away, an input list that was
    // a subset of `src_hash` becomes a wrong answer, and nothing would say
    // so.
    "runtime/viberun/src/**"
    "runtime/viberun/Cargo.toml"
    "runtime/viberun/Cargo.lock"
  }
  // The script compiles a probe program and asserts what it imports, so the
  // compiler it asks has to be the checkout's (AGENTS.md, "Which compiler
  // answered?"). With this dep present, `resolve_stage2_strict` finds HEAD's
  // generation and never has to settle for a newer unrelated one.
  deps { selfhostGeneration }
}
// The probe reads what a host did with a withheld import off a real artifact.
// Its own unit tests build modules by hand, so a failure is about the probe
// and not about whatever the compiler emitted that day.
local testHostCapabilityProbe = new Task {
  name = "test-host-capability-probe"
  description = "unit-test the host capability probe: refused vs a silent answer vs a trapping stub"
  cmd = "node --test scripts/host_capability_probe.test.mjs"
  cache = false
}
local checkVibeFmt = scriptTask("check-vibe-fmt", "scripts/check_vibe_fmt.sh")
// The `validate Pkl configs` CI job runs `pkf format --check Taskfile.pkl`,
// and that was the ONLY place it ran: `release-check` checks .vibe formatting
// but nothing checked this file, so a Taskfile edit that the pkl formatter
// would rewrite (it wraps a long `description =` onto its own line) passed
// every local gate and failed in CI. Registered here so the same answer is
// available before pushing. No pkl-missing guard: `pkf` cannot read this file
// without pkl in the first place.
local checkTaskfileFmt = new Task {
  name = "check-taskfile-fmt"
  description = "pkl formatting of Taskfile.pkl (mirrors the `validate Pkl configs` CI job)"
  cmd = "pkf format --check Taskfile.pkl"
  inputs { "Taskfile.pkl" }
}
// #1587: every fixture carrying `test` blocks is run by some lane, or listed
// with a reason. Registered standalone (~2s, pure shell) so it can be run
// against a fixture rename on its own; NOT a release-check dep, because
// compiler_gate.sh runs it up front, before the selfbuild.
local checkFixtureExecution =
  scriptTask("check-fixture-execution", "scripts/check_fixture_execution.sh")
// NOT `scriptTask`: this gate DERIVES its expectations from two documents, and
// `scriptSources`/`vibeSources` hash neither. With a cached pass, a CI run that
// restores ~/.cache/pkfire would replay it after a cheatsheet edit -- the gate
// answering about a document it did not read (#2138 review).
local checkFreezeSurface = new Task {
  name = "check-freeze-surface"
  description = "the frozen surface list resolves, and matches the cheatsheet's Key Builtins"
  cmd = "bash scripts/check_freeze_surface.sh"
  // ADDITIVE, not a replacement: this gate asks the COMPILER whether every
  // promised symbol still resolves, so the compiler identity is half the
  // question. Swapping the default inputs for the documents alone would let a
  // compiler change drop a frozen builtin behind a cached pass -- the same
  // under-invalidation as the doc-only case, pointed the other way. Inputs may
  // over-approximate (a needless re-run is free); they may never under-.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "docs/user/reference/stable-surface.md"
    "docs/user/reference/cheatsheet.md"
  }
}
// ADR-0109: one version number, checked wherever it is written (launcher,
// release notes, roadmap ladder, stable-surface doc). Pure text -- no compiler.
// The book is the onboarding surface; a broken chapter link ends a reader's
// visit. Pure text -- no compiler.
// NOT `scriptTask`: the book IS the subject. A cached pass replayed after a
// chapter edit is a link check that never saw the links (#2138 review).
local checkBookLinks = new Task {
  name = "check-book-links"
  description = "every relative link in book/ resolves"
  cmd = "bash scripts/check_book_links.sh"
  // Pure text -- no compiler -- so lib/** genuinely is not an input here.
  inputs {
    ...scriptSources
    "book/**/*.md"
  }
}
local testCheckBookLinks = scriptTask("test-check-book-links", "scripts/check_book_links_test.sh")
// A resolving link and a correct one are different questions. check-book-links
// answers the first; this answers the second, against book/SUMMARY.md as the
// single reading order -- headings numbered by position, and Previous/Next
// naming the SUMMARY neighbours, in BOTH languages.
// NOT `scriptTask`, for the same reason as check-book-links: the book is the
// subject, so a cached pass replayed after a chapter edit checks nothing.
local checkBookOrder = new Task {
  name = "check-book-order"
  description = "chapter headings and Previous/Next follow book/SUMMARY.md, en and ja"
  cmd = "bash scripts/check_book_order.sh"
  inputs {
