// #529 artifact-layer contract gate: dist (host-compiled shipping) and stage2
// (self-reproduced) compilers must agree on the vibe.abi custom section and
// behaviour of emitted program wasm. The two compiler binaries are byte-
// different by design; equivalence is a contract, not byte unification.
local testSelfhostDistStage2Parity =
  scriptTask("test-dist-stage2-parity", "scripts/test_dist_stage2_parity.sh")

local releaseSelfhostBootstrapGates = new Task {
  name = "release-bootstrap-gates"
  description = "stage1/stage2 artifact health + checker parity"
  // #851: dropped testSelfhostBootstrap / testSelfhostCheckBootstrapParity —
  // both were MoonBit-host comparison gates (scripts/test_selfhost_bootstrap_gate.sh,
  // scripts/test_selfhost_check_parity.sh) retired with src/ (#594; see the
  // "retired with src/" comment in scripts/trial_gate.sh for the same
  // pattern). testSelfhostWasiSelfbuildKpi remains, though note (out of scope
  // for this pass) it still shells out to the now-missing
  // scripts/test_selfhost_wasi_selfbuild.sh internally.
  deps { testSelfhostWasiSelfbuildKpi }
}

