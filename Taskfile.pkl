  cmd = "bash scripts/lint_architecture_debt.sh"
  inputs {
    ...vibeSources
    ...scriptSources
    "scripts/architecture_debt_rules.tsv"
    "scripts/architecture_debt_allowlist.txt"
  }
}
local testLintArchitecture =
  scriptTask("test-lint-architecture", "scripts/lint_architecture_debt_test.sh")
local lintReviewRegressions =
  scriptTask("lint-review-regressions", "scripts/lint_review_regressions.sh")
local testLintReviewRegressions =
  scriptTask("test-lint-review-regressions", "scripts/lint_review_regressions_test.sh")
local lintGuestProfileContract =
  scriptTask("lint-guest-profile-contract", "scripts/lint_guest_profile_contract.sh")
local testLintGuestProfileContract =
  scriptTask("test-lint-guest-profile-contract", "scripts/lint_guest_profile_contract_test.sh")
local testSessionStartGrep =
  scriptTask("test-session-start-grep", "scripts/session_start_grep_test.sh")
local testPreCommit = scriptTask("test-pre-commit", "scripts/precommit_test.sh")
local testReviewLintVibex = new Task {
  name = "test-review-lint-vibex"
  description = "run the review-derived vibe grep rule engine self-test"
  cmd = "bash scripts/vibe_run.sh scripts/review_lint.vibex -- --self-test"
  inputs { ...vibeSources; ...scriptSources }
  cache = false
}
local lintTrackedExperimentNames =
  scriptTask("lint-tracked-experiment-names", "scripts/lint_tracked_experiment_names.sh")
local checkGatePortability =
  scriptTask("check-gate-portability", "scripts/check_gate_portability.sh")
local testCheckGatePortability =
  scriptTask("test-check-gate-portability", "scripts/check_gate_portability_test.sh")
local testLintTrackedExperimentNames =
  scriptTask("test-lint-tracked-experiment-names", "scripts/lint_tracked_experiment_names_test.sh")
// The bundles and the flat module source are no longer committed, so there is
// nothing to check them AGAINST -- `ensure-generated` produces them instead.
// (Was: check-bundle-sync + check-module-source-sync, which regenerated the
// same artifacts purely to diff them against the tracked copies.)
local checkSelfhostPortableBoundary =
  scriptTask("check-portable-boundary", "scripts/check_portable_boundary.sh")
local checkHostRuntimeContract = new Task {
  name = "check-host-runtime-contract"
  description = "fail-closed conformance check for the documented vibe.* core host ABI"
  cmd =
    "python3 scripts/check_host_runtime_contract.py && python3 tests/gates/tooling-accounting/host-runtime/host_runtime_contract_test.py"
  inputs {
    "docs/wasm/host-runtime-contract.json"
    "scripts/check_host_runtime_contract.py"
    "tests/gates/tooling-accounting/host-runtime/host_runtime_contract_test.py"
    "lib/@vibe/compiler/codegen/wasi/linked_compile.vibe"
    "runtime/viberun/src/main.rs"
    "scripts/wasm_vibe_host_runner.js"
  }
}
local checkVibeFmt = scriptTask("check-vibe-fmt", "scripts/check_vibe_fmt.sh")
// The `validate Pkl configs` CI job runs `pkf format --check Taskfile.pkl`,
// and that was the ONLY place it ran: `release-check` checks .vibe formatting
// but nothing checked this file, so a Taskfile edit that the pkl formatter
// would rewrite (it wraps a long `description =` onto its own line) passed
// every local gate and failed in CI. Registered here so the same answer is
// available before pushing. No pkl-missing guard: `pkf` cannot read this file
// without pkl in the first place.
local checkTaskfileFmt = new Task {
  name = "check-taskfile-fmt"
  description = "pkl formatting of Taskfile.pkl (mirrors the `validate Pkl configs` CI job)"
  cmd = "pkf format --check Taskfile.pkl"
  inputs { "Taskfile.pkl" }
}
// #1587: every fixture carrying `test` blocks is run by some lane, or listed
// with a reason. Registered standalone (~2s, pure shell) so it can be run
// against a fixture rename on its own; NOT a release-check dep, because
// compiler_gate.sh runs it up front, before the selfbuild.
local checkFixtureExecution =
  scriptTask("check-fixture-execution", "scripts/check_fixture_execution.sh")
// NOT `scriptTask`: this gate DERIVES its expectations from two documents, and
// `scriptSources`/`vibeSources` hash neither. With a cached pass, a CI run that
// restores ~/.cache/pkfire would replay it after a cheatsheet edit -- the gate
// answering about a document it did not read (#2138 review).
local checkFreezeSurface = new Task {
  name = "check-freeze-surface"
  description = "the frozen surface list resolves, and matches the cheatsheet's Key Builtins"
  cmd = "bash scripts/check_freeze_surface.sh"
  // ADDITIVE, not a replacement: this gate asks the COMPILER whether every
  // promised symbol still resolves, so the compiler identity is half the
  // question. Swapping the default inputs for the documents alone would let a
  // compiler change drop a frozen builtin behind a cached pass -- the same
  // under-invalidation as the doc-only case, pointed the other way. Inputs may
  // over-approximate (a needless re-run is free); they may never under-.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "docs/spec/stable-surface.md"
    "docs/cheatsheet.md"
  }
}
// ADR-0109: one version number, checked wherever it is written (launcher,
// release notes, roadmap ladder, stable-surface doc). Pure text -- no compiler.
// The book is the onboarding surface; a broken chapter link ends a reader's
// visit. Pure text -- no compiler.
// NOT `scriptTask`: the book IS the subject. A cached pass replayed after a
// chapter edit is a link check that never saw the links (#2138 review).
local checkBookLinks = new Task {
  name = "check-book-links"
  description = "every relative link in book/ resolves"
  cmd = "bash scripts/check_book_links.sh"
  // Pure text -- no compiler -- so lib/** genuinely is not an input here.
  inputs {
    ...scriptSources
    "book/**/*.md"
  }
}
local testCheckBookLinks = scriptTask("test-check-book-links", "scripts/check_book_links_test.sh")
// A resolving link and a correct one are different questions. check-book-links
// answers the first; this answers the second, against book/SUMMARY.md as the
// single reading order -- headings numbered by position, and Previous/Next
// naming the SUMMARY neighbours, in BOTH languages.
// NOT `scriptTask`, for the same reason as check-book-links: the book is the
// subject, so a cached pass replayed after a chapter edit checks nothing.
local checkBookOrder = new Task {
  name = "check-book-order"
  description = "chapter headings and Previous/Next follow book/SUMMARY.md, en and ja"
  cmd = "bash scripts/check_book_order.sh"
  inputs {
    ...scriptSources
    "book/**/*.md"
  }
}
// The book's ```vibe skip blocks each claim a rejection and quote a
// diagnostic, and the doctest harness cannot look at them -- it runs `vibe
// run` blocks and skips these by definition. One had rotted into
// demonstrating the fix instead of the failure (#2156 review). Needs a
// compiler, so callers that build a stage2 should hand it over via
// VIBE_SKIP_BLOCK_CLI_WASM. Not `scriptTask`, same reason as its siblings.
local checkBookSkipBlocks = new Task {
  name = "check-book-skip-blocks"
  description = "every ```vibe skip block is still rejected, with its quoted diagnostic"
  cmd = "bash scripts/check_book_skip_blocks.sh"
  // vibeSources too: the ANSWER comes from the compiler, so a compiler change
  // can start accepting a skip block or reword its diagnostic without touching
  // a script or a chapter. Without this the cache key is unchanged and
  // release-check replays a pass that recompiled nothing (#2156 review) --
  // the same "a cached pass has checked nothing" reasoning that keeps this
  // out of scriptTask, one level up.
  inputs {
    ...scriptSources
    ...compilerProbeInputs
    "book/**/*.md"
  }
  // Same reason as check-rc-default and check-package-sibling-scope: the
  // verdict is the current compiler's, so the current compiler has to exist
  // before this runs. As siblings in release-check's deps this could go first
  // and answer from the seed (#2156 review).
  deps { selfhostGeneration }
}
// Two doctest harnesses answer differently on the same document; the guard in
// scripts/vibe_md.sh keeps a prose doc from reaching the *.vibe.md one.
local testVibeMdGuard = new Task {
  name = "test-vibe-md-guard"
  description = "the doctest guard, and that one compiler resolution decides a run"
  cmd = "VIBE_MD_GUARD_REQUIRE_COMPILER=1 bash scripts/vibe_md_guard_test.sh"
  // compilerProbeInputs + deps, for the same reason as check-book-skip-blocks
  // above: cases 6-8 ASK THE COMPILER (case 8 compiles a wrong import kind
  // twice and asserts the two lanes agree), so a compiler change can flip the
  // answer without touching a script -- and as a release-check sibling this
  // could otherwise run first, find no compiler, and exit 0 having skipped the
  // three cases it exists for (#2190 review).
  inputs {
    ...scriptSources
    ...compilerProbeInputs
  }
  deps { selfhostGeneration }
}
// ADR-0108 / docs/source-range-contract.md: six editor-query surfaces share one
// position unit. A surface that switched units would fail SILENTLY (a wrong
// column answers about an earlier position, and empty reads as clean).
local checkSourceRangeContract =
  scriptTask("check-source-ranges", "scripts/check_source_range_contract.sh")
local testCheckSourceRangeContract =
  scriptTask("test-check-source-ranges", "scripts/check_source_range_contract_test.sh")
// #2134: the host's JS stack, not the compiler, caps how many top-level
// declarations a module may have (~1300 on node's default). A VALID file
// simply stopped compiling. The gate generates unique content every run --
// a successful compile caches a row keyed by source, so a fixed corpus would
// pass forever after its own first green run, fix or no fix.
// #2133: the line-oriented queries joined records with "\n" instead of
// terminating them, so a shell `while read` dropped the last record and
// concatenating two answers merged one record into another -- silently. Empty
// must stay byte-empty, which is what rules out the naive always-append fix.
// #2121: AGENTS.md sends every reader to the cheatsheet first, and doctest
// only compiles its ```vibe blocks -- it is blind to a table. This checks the
// Signature reference against the CHECKER's builtin table: arity per entry,
// plus that the import caveat names exactly the documented non-builtins.
// docs/adding-modules.md, enforced: a package's files do NOT share a scope.
// Export, contract entry and an explicit ./import are all required, and each
// omission fails differently -- so two of the three gives an error that does
// not name the third. Checked because the cost it reveals (every shared helper
// becomes public surface) belongs in a split's plan, not its last commit.
// A task that RUNS the compiler must have the compiler in its cache key.
// `scriptTask` gets that by default; a hand-written `new Task` spells `inputs`
// out to ADD something and can end up REPLACING the defaults instead, leaving a
// task that passes from cache after the very change it exists to catch. That
// happened three times on one branch -- twice by me, once caught in review --
// which is what makes it a gate rather than a note.
// Taskfile.pkl is this gate's SUBJECT, so it is an input -- the same rule the
// gate itself enforces, which it was breaking (#2138 review). A task added with
// incomplete inputs would otherwise pass on a replayed verdict.
local checkTaskInputs = new Task {
  name = "check-task-inputs"
  description = "a task that runs the compiler keys on the compiler"
  cmd = "bash scripts/check_task_inputs.sh"
  inputs {
    ...scriptSources
    "Taskfile.pkl"
  }
}
local testCheckTaskInputs =
  scriptTask("test-check-task-inputs", "scripts/check_task_inputs_test.sh")
// Every command a document SHOWS a reader must name things that exist.
// check-doc-path-citations covers backticked paths in PROSE and does not look
// inside fenced blocks -- which is where the commands are, and where the
// getting-started chapter told newcomers to run `bash scripts/install.sh`
// against an installer that lives at install/install.sh.
// Which backend is the linear default, asked of the COMPILER. Three places
// recorded an answer and disagreed -- AGENTS.md and ADR-0055 said the cutover
// happened, docs/spec/rc-cutover-readiness.md still told the reader to hold it.
// Nothing checked which was true, so nothing corrected the one that was not.
local checkRcDefault = new Task {
  name = "check-rc-default"
  description = "the compiler's linear default backend, and the document that names it, agree"
  cmd = "bash scripts/check_rc_default.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "docs/spec/rc-cutover-readiness.md"
  }
  deps { selfhostGeneration }
}
local checkDocCommands = new Task {
  name = "check-doc-commands"
  description = "commands shown in docs name tasks, scripts and env vars that exist"
  cmd = "bash scripts/check_doc_commands.sh"
  // Everything this gate READS, on both sides of the comparison: the documents
  // it scans and the tree it resolves their references against. Under the
  // default inputs it saw the documents but not tests/**, eval/** or
  // install/**, so every VIBE_* lookup came back empty and 38 live variables
  // were reported as unread -- the gate failing loudly rather than passing
  // vacuously, but wrong either way.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "Taskfile.pkl"
    "*.md"
    "docs/**/*.md"
    "book/**/*.md"
    // Every README in the tree, wherever it lives -- the gate now scans them
    // all (#2138 review), so lib/@vibe/compiler/README.md going stale must
    // invalidate this task the same way docs/ does. compilerProbeInputs covers
    // lib/**/*.vibe but not lib/**/README.md.
    "**/README.md"
    // The launcher IS the verb list: the gate parses `vibe help` and the
    // dispatch case out of it, so adding or removing a command has to
    // re-run this comparison.
    "runtime/vibe"
    // Every glob the script SCANS, not a subset of it (#2138 review): it reads
    // .js/.ts/.toml/.md under these roots too, so an env-var reader removed
    // from scripts/wasm_vibe_host_runner.js would otherwise replay the old
    // verdict. Inputs may over-approximate; they may never under-.
    "scripts/**"
    "tests/**"
    "eval/**"
    "install/**"
    "scripts/doc_commands_allowlist.tsv"
  }
}
local checkPackageSiblingScope = new Task {
  name = "check-package-sibling-scope"
  description = "export + contract entry + explicit ./import are all required to reach a sibling"
  cmd = "bash scripts/check_package_sibling_scope.sh"
  inputs { ...compilerProbeInputs; ...scriptSources }
  // Same reason as check-cheatsheet-signatures: the verdicts are the current
  // compiler's, so it has to be the current compiler that answers.
  deps { selfhostGeneration }
}
// NOT `scriptTask`: the document under test and the probe are inputs too.
// `scriptSources` globs scripts/**/*.{sh,mjs,vibex} and `vibeSources` globs
// lib/**, so neither docs/cheatsheet.md nor a `.vibe` probe living in scripts/
// is hashed. Without them, editing the signature table replays a cached "ok"
// and this gate answers a stale question -- about the one file it exists to
// watch. Same reason testDocPathCitations spells its inputs out.
local checkCheatsheetSignatures = new Task {
  name = "check-cheatsheet-signatures"
  description = "the cheatsheet's Signature reference matches the checker's builtin table"
  cmd = "bash scripts/check_cheatsheet_signatures.sh"
  // BOTH sides of the comparison are inputs. Listing only the document was
  // half a fix: `lookup_builtin` lives in lib/**, so a change to the builtin
  // tables without touching these three files would have replayed the old
  // verdict -- the compiler-side drift this task exists to catch, passing.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "docs/cheatsheet.md"
    "scripts/cheatsheet_signature_probe.vibe"
  }
  // The oracle must be THIS checkout's compiler. Without the dep both scripts
  // pick the newest existing generation, or fall back to the committed seed --
  // so on a clean run they can answer from the seed while stage2 is still
  // building, and on a reused workspace from an unrelated generation.
  deps { selfhostGeneration }
}
