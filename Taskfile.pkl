local testInstallHelloSmoke = new Task {
  name = "test-install-hello-smoke"
  description = "the documented first program, DERIVED from the documents that teach it"
  cmd = "bash scripts/test_vibe_install_hello.sh"
  // The documented program is written for the compiler this checkout builds
  // (`fn main allows ..`, ADR-0088), so the smoke resolves that generation's
  // stage2 (scripts/resolve_stage2.sh) and must run after it exists.
  deps { selfhostGeneration }
  // The sharpest case for spelling these out. #2121 found this gate green
  // while the documented program was broken, because it RESTATED the program
  // instead of reading it; the fix was to derive it from the documents. If
  // those documents are not inputs, a cached pass replays after a doc edit
  // and the derivation never re-runs -- undoing that fix invisibly.
  // Documents AND compiler: this one installs and RUNS the compiler, so lib/**
  // decides the answer as much as the documents do. #2121 found this gate
  // green while the documented program was broken, because it RESTATED the
  // program instead of reading it; leaving either side out of the cache key
  // undoes that fix invisibly.
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "README.md"
    "docs/user/getting-started/install.md"
    "docs/user/reference/cheatsheet.md"
    "book/en/01_getting_started.vibe.md"
  }
}
