    "node scripts/coverage_suite_next_branches.mjs \"${1:-_build/coverage/selfhost-suite/selfhost_suite.report.json}\" --format \"${VIBE_SUITE_NEXT_BRANCHES_FORMAT:-text}\""
  acceptsArgs = true
  inputs { "scripts/coverage_suite_next_branches.mjs" }
}

