// #2834: the seed-release workflow's Adopt step inherits `seed.name` from
// whichever source_ref was dispatched -- `generations.sh adopt` rewrites it
// only when given --name. A dispatch whose source_ref predates the bump
// commit therefore publishes a manifest naming the PREVIOUS seed under the new
// tag. Nothing in-tree reads that field, so only a guard can catch it; this is
// the red/green that proves the guard fires. Inputs are just the guard and its
// test -- it runs against a scratch tree and never touches the compiler.
local testSeedAssetIdentity = new Task {
  name = "test-seed-asset-identity"
  description =
    "red/green for the seed-manifest identity guard: a manifest naming another seed must not ship under this tag"
  cmd = "bash scripts/build_compiler_seed_assets_test.sh"
  // The scratch tree holds a fake artifact and no generate_bundle.sh, so this
  // verdict does not actually depend on compiler identity -- but the guard it
  // copies does reach the compiler lexically, and check-task-inputs refuses to
  // guess. Over-approximate rather than assert the exemption: the run is 0.1s.
  inputs {
    ...compilerProbeInputs
    "scripts/build_compiler_seed_assets_test.sh"
    "scripts/build_compiler_seed_assets.sh"
  }
}
// The release BODY is built from the shipped release notes rather than from
// `generate_release_notes` (72 merged PRs for 0.1.0). Its links are relative
// -- written to be read inside docs/ -- so they are absolutized at the tag,
// and a link that does not resolve is refused: this repository publishes
// immutable releases, so a dead link in a body is permanent. Nothing else
// runs build_release_body.sh; release.yml invokes it only on a `v*` tag push,
// which is the one moment it must not be the first execution.
local testReleaseBody = new Task {
  name = "test-release-body"
  description =
    "red/green for the release-body builder: relative links absolutized at the tag, an unresolvable or escaping link refused"
  cmd = "bash scripts/build_release_body_test.sh"
  inputs {
    "scripts/build_release_body_test.sh"
    "scripts/build_release_body.sh"
  }
}
// #2914: `vibe grep` answered `exit 0` with no output for a tree-wide typed
// sweep that was in fact TRAPPING (`RuntimeError: memory access out of
// bounds`). The runner recorded the failure with `status=$?` inside
// `if ! cmd; then`, where `$?` is the status of the `!`-inverted pipeline --
// 0 exactly when the command failed. "It broke" and "the answer is none"
// therefore shared a spelling, in a tool whose whole job is answering
// questions about a corpus. Stub-runner cases, so no compiler is needed.
// The asset builder's TAG GRAMMAR. `^[0-9]+\.[0-9]+\.[0-9]+$` rejected every
// pre-release, so `v0.1.0-rc.0` died on release.yml's FIRST job -- at the tag,
// which is the one moment the workflow cannot be rehearsed, while
// check_version_ladder.sh had accepted that spelling all along. Argument
// handling only: the build itself is ~4 minutes and needs a compiler.
local testReleaseAssetsArgs = new Task {
  name = "test-release-assets-args"
  description =
    "red/green for the release asset builder's tag validation: a pre-release tag is accepted, junk and a launcher/tag disagreement are refused"
  cmd = "bash scripts/build_release_assets_test.sh"
  inputs {
    // The cases stop at argument handling and never reach a compiler, but the
    // script under test does; an exemption asserted here is the gate's own
    // failure mode, and replaying a 0.4s test costs less than being wrong.
    ...compilerProbeInputs
    "scripts/build_release_assets_test.sh"
    "scripts/build_release_assets.sh"
  }
}
