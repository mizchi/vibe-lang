/// pkfire Taskfile for vibe-lang
///
/// Canonical task definitions for vibe-lang. Replaces the previous
/// `justfile`. Simple recipes are inlined; multi-line shell lives in
/// `scripts/pkfire/*.sh` and is invoked directly (no `just` wrapper).
///
/// Usage:
///   pkf list                                  # show tasks
///   pkf run test                              # full test suite
///   pkf run test-local                        # affected local tests via flaker
///   pkf graph --format tree                   # visualize dependencies
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

// --- Configuration (env vars, mirroring the former justfile defaults) ---

// selfhost sources: top-level vibe/ was dissolved into lib/ (#766 Phase 2-4).
// The MoonBit-host globs (moon.mod, src/**/*.mbt, src/**/moon.pkg) were
// dropped with the rest of the retired host — they matched nothing.
local vibeSources: Listing<String> = new {
  "lib/**/*.vibe"
  "lib/**/*.vibei"
}

local scriptSources: Listing<String> = new {
  "scripts/**/*.sh"
  "scripts/**/*.mjs"
}

// --- Helper factories ---

/// Single-script wrapper — common pattern.
local function scriptTask(taskName: String, script: String): Task = new Task {
  name = taskName
  cmd = "bash \(script)"
  inputs { ...vibeSources; ...scriptSources }
}

// === Quick Commands ===

local fmt = new Task {
  name = "fmt"
  // selfhost-only: `moon fmt` (.mbt) retired with src/ (#594). Formats every
  // tracked lib/**/*.vibe file in place via the selfhost CST-token formatter
  // (scripts/vibe_fmt_apply.sh), skipping the small set of auto-generated
  // bundle files in scripts/vibe_fmt_allowlist.txt. `pkf run check-vibe-fmt`
  // is the read-only CI-enforced counterpart (--check, fails on drift).
  cmd = "bash scripts/vibe_fmt_apply.sh"
  cache = false
}

// git pre-commit hook target (wire with `pkf hooks install`). Formatting staged
// sources used `moon fmt` on .mbt; retired with src/ (#594). No-op until a
// selfhost fmt/normalize is available (#594).
local preCommit = new Task {
  name = "pre-commit"
  description = "git pre-commit: no-op (selfhost fmt/normalize pending, #594)"
  cmd = "true"
  cache = false
}

local formalCheck = new Task {
  name = "formal-check"
  description = "prove the Lean models and verify committed Oracle corpora"
  cmd = "formal/check-oracle.sh"
  inputs {
    "formal/**/*.lean"
    "formal/oracle/**"
    "formal/examples/**"
    "formal/check-oracle.sh"
    "formal/lakefile.toml"
    "formal/lake-manifest.json"
    "formal/lean-toolchain"
  }
}

local formalIncrementalCheck = new Task {
  name = "formal-incremental-check"
  description = "prove the bounded Lean incremental invalidation model"
  cmd = "cd formal && lake build --wfail VibeFormal.Proofs.IncrementalCorrect"
  inputs {
    "formal/VibeFormal/Compiler/Incremental.lean"
    "formal/VibeFormal/Proofs/IncrementalCorrect.lean"
    "formal/lakefile.toml"
    "formal/lake-manifest.json"
    "formal/lean-toolchain"
  }
}

local testIncrementalInvalidationOracle = new Task {
  name = "test-incremental-invalidation-oracle"
  description = "regenerate and validate the bounded Lean incremental invalidation corpus"
  cmd = "formal/check-incremental-oracle.sh"
  inputs {
    "formal/IncrementalOracleMain.lean"
    "formal/VibeFormal/Compiler/Incremental.lean"
    "formal/VibeFormal/Proofs/IncrementalCorrect.lean"
    "formal/oracle/incremental-invalidation.tsv"
    "formal/check-incremental-oracle.sh"
    "scripts/incremental_invalidation_oracle.mjs"
  }
}

