  name = "playground-build"
  cmd =
    #"cp _build/wasm-gc/release/build/lib/lib.wasm playground/public/vibe-runtime.wasm && cd playground && VITE_BASE=/vibe-lang/ VITE_VIBE_BUILD_LABEL=$(git rev-parse --short HEAD) pnpm build"#
  inputs { "playground/**/*" }
  outputs { "playground/dist/**" }
  deps { buildIntegrationDenoWasm }
}

// === Per-package test tasks for differential execution ===

local function pkgTask(pkg: String): Task = new Task {
  name = Packages.taskName(pkg)
  cmd = "moon test --target native -p mizchi/vibe/\(pkg)"
  inputs {
    "moon.mod"
    "src/\(pkg)/**/*.mbt"
    "src/\(pkg)/moon.pkg"
  }
}

local pkgTests: List<Task> = Packages.all.map((p) -> pkgTask(p))

