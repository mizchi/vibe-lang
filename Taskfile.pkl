// #2758: one declared builtin, two host implementations that disagreed.
// `Fs::remove` was `rmSync(.., { recursive: true, force: true })` in the JS
// runner and `fs::remove_file` in the Rust one, so clearing a path that
// happened to name a directory destroyed a tree under `vibe test` and trapped
// under `vibe run`. `fixtures/gc_host_builtins.vibe` pins linear-vs-gc
// agreement for this class of bug; nothing pinned JS-vs-Rust. Asked of both
// RUNNING runners rather than read off either source.
local checkHostRemoveParity = new Task {
  name = "check-host-remove-parity"
  description =
    "the JS and Rust runners agree: Fs::remove is non-recursive on both, Fs::remove_tree is recursive on both"
  cmd = "bash scripts/check_host_remove_parity.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "runtime/viberun/src/main.rs"
  }
  deps { selfhostGeneration }
}
// NOT scriptTask: that factory supplies inputs but no `deps`, and this
// companion's GREEN phase compiles a program calling `Fs::remove_tree`. Run
// directly, or concurrently as a release-check dependency on a clean or reused
// workspace, it would find no generation and fall back to the committed seed --
// which predates the builtin -- or pick up an unrelated generation and certify
// the wrong compiler (Codex on #2823). Same dependency and same artifact
// channel as the gate it tests.
local testCheckHostRemoveParity = new Task {
  name = "test-check-host-remove-parity"
  description = "red test: the parity gate FAILS when the JS runner's fs_remove is recursive again"
  cmd = "bash scripts/check_host_remove_parity_test.sh"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "runtime/viberun/src/main.rs"
  }
  deps { selfhostGeneration }
}
