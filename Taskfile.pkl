  scriptTask("refresh-selfhost-batch-weights", "scripts/refresh_selfhost_batch_weight_seed.sh")
local testSelfhostBatchWeights =
  scriptTask("test-selfhost-batch-weights", "scripts/refresh_selfhost_batch_weight_seed_test.sh")
