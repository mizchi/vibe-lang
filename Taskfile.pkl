// Selfhost unit-test runner (#531/#535): compile+run every discovered
// *_test.vibe (examples/, lib/, fixtures/) through the selfhost compiler --
// no allowlist file (#1231), just a small documented EXCLUDE_PATTERNS list
// in the script itself. `--scan` reports pass/fail for everything discovered,
// including excluded files (to check if an exclusion can be dropped).
local testSelfhostUnit = new Task {
  name = "test-unit"
  description = "run every discovered *_test.vibe through the selfhost compiler (#531/#535)"
  cmd = "bash scripts/unit_test_runner.sh $@"
  acceptsArgs = true
  cache = false
}

// Phase 2 of the selfhost Perceus RC port (docs/spec/selfhost-rc-port.md):
// unit-test the ported analysis pass in isolation via the native vibe CLI.

// Phase 1 safety net for the selfhost RC port (docs/spec/selfhost-rc-port.md):
// compile heap-object source programs with the selfhost backend, run them on
// wasmtime, and check results — locks current heap layouts before the uniform
// object-header change.

// Reliable verification loop for the selfhost Perceus RC work (ADR-0055):
// runs the heap-e2e correctness gate from a UNIQUELY-NAMED copy (so the
// pure-test result cache is never stale) AND asserts RC reclamation is ~0
// bytes/iter for tuple/record/enum/array. See the script header for the
// caching/sandbox traps this avoids.

// ADR-0055 #493: whole-compiler self-compile through stage1, both backends,
// asserting RC-vs-default parity (RC adds no compile gap at full compiler scale).
// Auto-upgrades to a full whole-compiler-under-RC green signal once the shared
// default-path ceiling is lifted. See docs/spec/rc-cutover-readiness.md.
local testSelfhostRcBootstrap = scriptTask("test-rc-bootstrap", "scripts/test_rc_bootstrap.sh")

// #538: wasm-gc selfbuild frontier report (informational; always exits 0).
local testGcSelfbuild = scriptTask("test-gc-selfbuild", "scripts/test_gc_selfbuild.sh")

// Runs the private struct.new/array.new smoke through the wasmtime-backed
// viberun host without changing the user-value ABI.
local testGcNativeAllocProbe = new Task {
  name = "test-gc-native-alloc-probe"
  cmd = "bash scripts/test_gc_native_alloc_probe.sh \"$@\""
  acceptsArgs = true
  cache = false
  deps { selfhostGeneration }
}

// #1696: the exported entry's result must not depend on VIBE_RC. compiler_gate
// pins VIBE_RC=0, so nothing there reaches the RC lane; this runs it directly.
local testRcEntryResultParity = new Task {
  name = "test-rc-entry-result-parity"
  cmd = "bash scripts/test_rc_entry_result_parity.sh \"$@\""
  acceptsArgs = true
  cache = false
  deps { selfhostGeneration }
}

// Characterizes the current gc lane's guest-linear bump high-water; this is
// opt-in because it is not a Wasmtime tracing-GC liveness test.
local testGcHeapAccounting = new Task {
  name = "test-gc-heap-accounting"
  cmd = "bash scripts/test_gc_heap_accounting.sh \"$@\""
  acceptsArgs = true
  cache = false
  deps { selfhostGeneration }
}

// Two questions about this compiler's own wasm output, sharing one corpus
// because compiling the fixtures is the expensive part:
//   - does @vibex/wasm_parser's validator agree with `wasm-tools validate`
//     (never rejecting what it accepts), and does it read every instruction?
//   - does used_by_codegen() still name every proposal the output requires?
// Skips itself when wasm-tools is absent, since it is the oracle.
local testWasmValidateParity = new Task {
  name = "test-wasm-validate-parity"
  cmd = "bash scripts/test_wasm_validate_parity.sh \"$@\""
  acceptsArgs = true
  cache = false
  deps { selfhostGeneration }
}

