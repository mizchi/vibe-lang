/// pkfire Taskfile for vibe-lang
///
/// Canonical task definitions for vibe-lang. Replaces the previous
/// `justfile`. Simple recipes are inlined; multi-line shell lives in
/// `scripts/pkfire/*.sh` and is invoked directly (no `just` wrapper).
///
/// Usage:
///   pkf list                                  # show tasks
///   pkf run check                             # type check (cached)
///   pkf run test                              # full test suite
///   pkf run test-local                        # affected local tests via flaker
///   pkf affected --since=origin/main 'test:*' # diff-aware package tests
///   pkf graph --format tree                   # visualize dependencies
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.10.0#/Taskfile.pkl"

// Shared canonical package list, used to generate one test:<pkg> task per
// package (see `pkgTests` below).
import "pkspec/Packages.pkl"

// --- Configuration (env vars, mirroring the former justfile defaults) ---

local target: String = read?("env:VIBE_TARGET")?.text ?? "js"
local moonWarnList: String = read?("env:VIBE_MOON_WARN_LIST")?.text ?? "-1-6-7-9-20-24-29"

local moonSources: Listing<String> = new {
  "moon.mod"
  "src/**/*.mbt"
  "src/**/moon.pkg"
  // selfhost sources: top-level vibe/ was dissolved into lib/ (#766 Phase 2-4)
  "lib/**/*.vibe"
  "lib/**/*.vibei"
}

local scriptSources: Listing<String> = new {
  "scripts/**/*.sh"
  "scripts/**/*.mjs"
}

// --- Helper factories ---

/// Single-script wrapper — common pattern.
local function scriptTask(taskName: String, script: String): Task = new Task {
  name = taskName
  cmd = "bash \(script)"
  inputs { ...moonSources; ...scriptSources }
}

// === Quick Commands ===

local fmt = new Task {
  name = "fmt"
  // selfhost-only: `moon fmt` (.mbt) retired with src/ (#594). A selfhost `fmt`
  // is not yet ported (#594), so this is a no-op placeholder for now.
  cmd = "true"
  cache = false
}

// git pre-commit hook target (wire with `pkf hooks install`). Formatting staged
// sources used `moon fmt` on .mbt; retired with src/ (#594). No-op until a
// selfhost fmt/normalize is available (#594).
local preCommit = new Task {
  name = "pre-commit"
  description = "git pre-commit: no-op (selfhost fmt/normalize pending, #594)"
  cmd = "true"
  cache = false
}

local info = new Task {
  name = "info"
  cmd = "moon info"
  inputs { ...moonSources }
  outputs { "**/*.mbti" }
}

local check = new Task {
  name = "check"
  cmd = "moon check --deny-warn --warn-list '\(moonWarnList)' --target \(target)"
  inputs { ...moonSources }
}

local checkLockClean = new Task {
  name = "check-lock-clean"
  cmd = "scripts/check_lock_clean.sh"
  inputs { "index.lock"; "**/index.lock"; "scripts/check_lock_clean.sh" }
}

