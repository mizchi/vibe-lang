// === Bench ===

local benchHttp = scriptTask("bench-http", "scripts/bench_http.sh")
local benchCmdLatency = scriptTask("bench-cmd-latency", "scripts/bench_cmd_latency.sh")

// Peak-RSS gate for the selfhost cutover (#402). Measures host-native vs
// selfhost wasmtime-AOT (cwasm) peak RSS for compile/check on the KPI cases.
// `--gate` fails if a TOTAL ratio exceeds VIBE_RSS_MAX_RATIO (2.0).

// wasmtime-AOT variant of bench-selfhost-perf. Builds the viberun host
// (runtime/viberun), pre-compiles stage1 wasm → cwasm, and reuses
// the same harness. Selfhost compile ratio drops ~5× on examples/basics.vibe
// (6.30 → 1.21) versus the moonrun-backed default (TODO #295).

// Output parity gate: moonrun and viberun must produce byte-identical
// stage1 compile output on the default case set. Catches regressions in the
// wasmtime host shim before they show up as ratio noise (TODO #295).

// Import-surface drift guard. Dumps moon `--target wasm` imports from the
// stage1 compile + check artifacts and diffs against
// `runtime/viberun/expected_imports.txt`. Catches new moonbit
// toolchain imports before they trap at runtime under viberun
// (TODO #295).

// Daemon-mode parity gate (#400): viberun --daemon and one-shot
// invocations must produce byte-identical check output across the
// bench cases. Catches cache-poisoning / state-leak regressions in
// the new long-running mode before they ship.
local testMoonrunWtDaemonParity = new Task {
  name = "test-moonrun-wt-daemon-parity"
  cmd = "scripts/test_moonrun_wt_daemon_parity.sh $@"
  acceptsArgs = true
  inputs {
    ...moonSources
    ...scriptSources
    "bench/perf/cases.txt"
    "runtime/viberun/**/*"
  }
}

