/// pkfire Taskfile for vibe-lang
///
/// Canonical task definitions for vibe-lang. Replaces the previous
/// `justfile`. Simple recipes are inlined; multi-line shell lives in
/// `scripts/pkfire/*.sh` and is invoked directly (no `just` wrapper).
///
/// Usage:
///   pkf list                                  # show tasks
///   pkf run test                              # full test suite
///   pkf run test-local                        # affected local tests via flaker
///   pkf graph --format tree                   # visualize dependencies
amends "package://pkg.pkl-lang.org/github.com/mizchi/pkfire/pkfire@0.14.2#/Taskfile.pkl"

// --- Configuration (env vars, mirroring the former justfile defaults) ---

// #2877: clear the nix wrapper's LD_LIBRARY_PATH for every task.
//
// `/root/.nix-profiles/pkfire/bin/pkf` is a nix wrapper that does
// `export LD_LIBRARY_PATH=/nix/store/...-openssl-3.6.3/lib` before exec'ing
// the real binary. The export is not scoped to the wrapped binary, so every
// task inherits it, and a system binary that reaches the dynamic loader then
// resolves out of the nix closure while linked against the system glibc:
//
//   sort: /lib/x86_64-linux-gnu/libc.so.6: version `GLIBC_ABI_DT_X86_64_PLT'
//         not found (required by /nix/store/...-glibc-2.42-67/lib/libdl.so.2)
//
// `/usr/bin/sort` then exits non-zero writing nothing, so a `find | sort`
// expansion comes back EMPTY. Measured: `pkf run test-vibe-test` failed at
// `vibe_test.sh did not accept a directory` while `bash
// scripts/vibe_test_smoke.sh` passed on the same tree -- a gate answering
// differently on two invocations, which is the #2252 shape that gets a gate
// exempted rather than fixed.
//
// Cleared HERE rather than in each script: the issue lists sanitizing ~80
// entry points as the option where nothing stops the 81st from missing it.
// `defaults.env` is project-level and overlays every task, so one row covers
// tasks that do not exist yet. An EMPTY value is what the loader wants --
// glibc reads it as "no extra directories", measured against `sort --version`
// -- and pkfire's env is an overlay, so there is no "unset" to ask for.
//
// The real fix is upstream: pkfire's nix packaging should scope the variable
// to the wrapped binary (`makeWrapper --prefix` on the binary, not an exported
// variable a child inherits). This is the stopgap the issue asks for, and it
// stops being needed the moment the wrapper is fixed -- harmlessly, since an
// empty value is what a clean environment already looks like.
defaults {
  env {
    ["LD_LIBRARY_PATH"] = ""
  }
}

// selfhost sources: top-level vibe/ was dissolved into lib/ (#766 Phase 2-4).
// The MoonBit-host globs (moon.mod, src/**/*.mbt, src/**/moon.pkg) were
// dropped with the rest of the retired host — they matched nothing.
local vibeSources: Listing<String> = new {
  "lib/**/*.vibe"
  "lib/**/*.vibei"
  // #2138 review: a `.vpkg` is a package CONTRACT -- it decides what a package
  // exports and therefore whether a dependent compiles at all. Leaving it out
  // meant no task in this file invalidated on a contract edit: removing
  // `lookup_builtin` from checker/index.vpkg changes whether a probe compiles,
  // and every cached verdict would have been replayed over it.
  "lib/**/*.vpkg"
}

local scriptSources: Listing<String> = new {
  "scripts/**/*.sh"
  "scripts/**/*.mjs"
  "scripts/**/*.vibex"
}

// Inputs shared by cached tasks whose verdict can come from the checkout
// compiler. `vibeSources` covers the selfhost source, while the seed manifest selects the
// bootstrap compiler that builds stage2. Omitting either can replay a cached
// pass for a different compiler (#2165).
local compilerProbeInputs: Listing<String> = new {
  ...vibeSources
  "bootstrap/seed.json"
}

// --- Helper factories ---

/// Single-script wrapper — common pattern.
local function scriptTask(taskName: String, script: String): Task = new Task {
  name = taskName
  cmd = "bash \(script)"
  // Some wrappers reach the compiler indirectly. Keying the shared factory on
  // the complete compiler identity is a safe over-approximation and prevents
  // those dynamic calls from bypassing the hand-written-task ratchet (#2165).
  inputs { ...compilerProbeInputs; ...scriptSources }
}

// CI-only slices use fixed artifact paths so pkfire can hash the exact stage2
// they consume and safely replay successful verdicts from its CAS.
local ciCompilerGatePreflight = new Task {
  name = "ci-compiler-gate-preflight"
  description = "stage-independent compiler-gate preflight"
  cmd =
    "bash tests/gates/bootstrap/preflight.sh && mkdir -p _build/pkfire && printf 'ok\\n' > _build/pkfire/ci-compiler-gate-preflight.ok"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "tests/gates/**/*.sh"
    "tests/gates/registry.tsv"
    "fixtures/**/*.vibe"
  }
  outputs { "_build/pkfire/ci-compiler-gate-preflight.ok" }
}

local ciCheckExamplesTypecheck = new Task {
  name = "ci-check-examples-typecheck"
  description = "type-check examples against CI's content-addressed stage2"
  cmd =
    "EXAMPLES_STAGE2=_build/_ci_shard_gen/stage2.wasm bash scripts/check_examples_typecheck.sh && mkdir -p _build/pkfire && printf 'ok\\n' > _build/pkfire/ci-check-examples-typecheck.ok"
  inputs {
    ...compilerProbeInputs
    ...scriptSources
    "examples/**/*.vibe"
    "install/**/*"
    "_build/_ci_shard_gen/stage2.wasm"
  }
  outputs { "_build/pkfire/ci-check-examples-typecheck.ok" }
}

// === Quick Commands ===

local fmt = new Task {
  name = "fmt"
  // selfhost-only: `moon fmt` (.mbt) retired with src/ (#594). Formats every
  // tracked lib/**/*.vibe file in place via the selfhost CST-token formatter
  // (scripts/vibe_fmt_apply.sh), skipping the small set of auto-generated
  // bundle files in scripts/vibe_fmt_allowlist.txt. `pkf run check-vibe-fmt`
  // is the read-only CI-enforced counterpart (--check, fails on drift).
  cmd = "bash scripts/vibe_fmt_apply.sh"
  cache = false
}

// git pre-commit hook target (wire with `pkf hooks install`). Keep this fast:
// review-derived structural ratchets plus repository hygiene checks only.
local preCommit = new Task {
  name = "pre-commit"
  description = "git pre-commit: review-derived structural lint gates"
  cmd = "bash scripts/precommit.sh"
  cache = false
}

