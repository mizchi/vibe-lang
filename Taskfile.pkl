local ensureGenerated = new Task {
  name = "ensure-generated"
  description =
    "regenerate the five generated compiler artifacts if the (seed, source) fingerprint moved (no-op otherwise)"
  cmd = "bash scripts/ensure_generated.sh $@"
  acceptsArgs = true
  // Uncached on purpose: the script does its own fingerprinting and is ~1s
  // warm, and a pkfire cache hit here would be a second staleness oracle to
  // keep in agreement with the first.
  cache = false
  inputs { "scripts/ensure_generated.sh"; "scripts/generate_bundle.sh" }
}

local selfhostGeneration = new Task {
  name = "generation"
  description = "Rust-style stage0(seed) -> stage1 -> stage2 selfhost compiler build"
  cmd = "bash scripts/generations.sh build $@"
  acceptsArgs = true
  cache = false
  inputs {
    ...vibeSources
    ...scriptSources
    "bootstrap/seed.json"
