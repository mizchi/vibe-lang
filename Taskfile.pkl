  scriptTask("check-selfhost-portable-boundary", "scripts/check_selfhost_portable_boundary.sh")
local testSelfhostBundleSync =
  scriptTask("test-selfhost-bundle-sync", "scripts/check_selfhost_bundle_sync_test.sh")
local testGenerateSelfhostBundle =
