}

local testLockClean = scriptTask("test-lock-clean", "scripts/check_lock_clean_test.sh")
// Not `scriptTask`: the rules table and the baseline are inputs too, and
// `scriptSources` only globs scripts/**/*.sh. Without them, editing the
// allowlist replays a cached "ok" and the ratchet answers a stale question.
local testDocPathCitations = new Task {
  name = "test-doc-path-citations"
  description = "self-test for the doc path-citation check (fixed cases, synthetic tree)"
  cmd = "bash scripts/check_doc_path_citations_test.sh"
  inputs {
    "scripts/check_doc_path_citations.sh"
    "scripts/check_doc_path_citations_test.sh"
  }
}

local checkDocPathCitations = new Task {
  name = "check-doc-path-citations"
  description = "every backticked file path in docs/ resolves, or is recorded as debt"
  cmd = "bash scripts/check_doc_path_citations.sh"
  // Ratchet, same shape as the architecture-debt one: the allowlist is an input
  // so that editing it re-asks the question instead of replaying a cached "ok".
  inputs {
    "docs/**/*.md"
    "scripts/check_doc_path_citations.sh"
    "scripts/doc_path_citation_allowlist.txt"
  }
}

local lintArchitectureDebt = new Task {
