}

// Explicit artifacts; opt-in only. Measurement results must never be cached.
local compareCompilerMemory = new Task {
  name = "compare-compiler-memory"
  description =
    "Compare two compiler artifacts with isolated cold/warm caches, wall time and memory readings"
  cmd = "node scripts/compare_compiler_memory.mjs \"$@\""
  acceptsArgs = true
  cache = false
}

// Same rule as above: opt-in, never cached. This one varies the checked-module
// cache mode rather than the compiler, which is the comparison #1959 makes
// default-on promotion conditional on.
local checkedModuleCacheCost = new Task {
  name = "measure-checked-module-cache-cost"
  description =
    "Measure wall time and heap of VIBE_CHECKED_MODULE_CACHE off vs on, cold and warm, on compiler-sized closures"
  cmd = "bash scripts/checked_module_cache_cost.sh $@"
  acceptsArgs = true
  cache = false
  // The measurement resolves HEAD's generation strictly and refuses every
  // fallback, so without this it would not run at all in a fresh workspace --
  // and WITH the old lenient resolution it ran against whichever generation
  // happened to be newest (#2836 section 1).
  deps { selfhostGeneration }
}

