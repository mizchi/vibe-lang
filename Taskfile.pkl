}

local selfhostPostGenerationGate = new Task {
  name = "post-generation-gate"
  description = "internal: complete selfhost operation gates that must run after stage generation"
  cmd = "bash scripts/gate.sh --post-generation"
  cache = false
  visibility = "internal"
  inputs {
    ...moonSources
    ...scriptSources
    "bench/selfhost_perf/kpi_cases.txt"
    "scripts/corpus_baseline.txt"
  }
  deps { selfhostGenerationGate }
}

// #851: scripts/bench_bundle_size.sh and scripts/bench_compiler_bundle_size.sh
// no longer exist and have no found replacement (unlike most other entries in
// this cleanup, these are NOT superseded by a renamed script — see final
// report). NOTE: scripts/monitor_wasm_bundle_size.sh (bench-bundle-size-monitor
// / -strict below) shells out to both of these missing scripts directly, so
// those two tasks are *also* currently broken; that is flagged for follow-up
// but left as-is here since it is a real `cmd`, not a scriptTask() entry in
// scope for this pass.

local benchBundleSizeMonitor =
  scriptTask("bench-bundle-size-monitor", "scripts/monitor_wasm_bundle_size.sh")

local benchBundleSizeMonitorStrict = new Task {
  name = "bench-bundle-size-monitor-strict"
  cmd = "VIBE_WASM_BUNDLE_MONITOR_STRICT_PRODUCT=1 scripts/monitor_wasm_bundle_size.sh"
