  description = "run the selfhost coverage suite using a stage2 built for this checkout"
  cmd = "bash scripts/coverage_suite.sh"
  cache = false
  deps { selfhostGeneration }
}

// #1556: the SECOND track. `coverage-suite` measures what the compiled test
// programs execute, which is structurally blind to compiler passes -- a pass
// that runs while COMPILING a test lives in the uninstrumented stage2. This
// one instruments the COMPILER and runs it over a corpus of real programs, so
// parser/checker/codegen are what it sees. Neither track subsumes the other;
// `coverage-tracks` prints both. Slow (one instrumented compile per file), so
// it is not a dep of `coverage`.
local coverageCorpus = new Task {
  name = "coverage-corpus"
  description =
    "compiler-side (self-compile) branch coverage over a corpus of .vibe programs (#1556 track B)"
  cmd = "bash scripts/coverage_corpus.sh $@"
  acceptsArgs = true
  cache = false
}

local coverageTracks = new Task {
  name = "coverage-tracks"
  description = "print both coverage tracks (in-process / self-compile) side by side (#1556)"
  cmd = "python3 scripts/coverage_tracks.py $@"
  acceptsArgs = true
  cache = false
}

local coverageSelfhostSuiteNextBranches = new Task {
  name = "coverage-suite-next-branches"
