fn mk(a: String, b: String) -> String {
  String::concat(a, b)
}

fn main with Console {
  let v = 1
  let xs = []
  let ys = []
  let flag = true
  let v = if flag { mk("ab", "c") } else { mk("a", "bc") }
  Array::push(xs, v)
  let v = if flag { mk("a", "bc") } else { mk("ab", "c") }
  Array::push(ys, v)
  println("uninferable shadow = \{xs == ys}")
}
