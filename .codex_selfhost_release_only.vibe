import ./vibe/compiler/entry/source_compile/wasi_only {
  compile_source_wasi_only
}

export let compile_release_file = (input_path: String, entry_name: String) -> Bytes with { Error, Fs } {
  let source = perform Fs::ReadFile(input_path)
  compile_source_wasi_only(source, entry_name)
}

export let cli_main = () -> Int {
  0
}
