fn mk(a: String, b: String) -> String {
  String::concat(a, b)
}

fn main with Console {
  let v = 1
  let src = [mk("ab", "c"), mk("a", "bc")]

  // (a) match expression
  let as1 = []
  let as2 = []
  let v = match 0 { _ => mk("ab", "c") }
  Array::push(as1, v)
  let v = match 0 { _ => mk("a", "bc") }
  Array::push(as2, v)
  println("match shadow      = \{as1 == as2}")

  // (b) element read out of an array
  let bs1 = []
  let bs2 = []
  let v = Array::get(src, 0)
  Array::push(bs1, v)
  let v = Array::get(src, 1)
  Array::push(bs2, v)
  println("array-get shadow  = \{bs1 == bs2}")

  // (c) result of calling a locally bound closure
  let cs1 = []
  let cs2 = []
  let f = (a: String) -> String { a }
  let v = f(mk("ab", "c"))
  Array::push(cs1, v)
  let v = f(mk("a", "bc"))
  Array::push(cs2, v)
  println("closure-ret shadow= \{cs1 == cs2}")

  println("outer v is \{v}")
}
