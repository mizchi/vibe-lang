// ch11: a require pin at the top of a .vibex is a header, not a #cfg
// directive. check and the compile lane already blanked it (#2227).
// `vibe run` parsed the raw bytes in its preflight and answered
// `unknown # directive: pkg` while check was clean. The preflight now
// blanks the same way, so run, check and the compile lane agree: this
// file compiles, prints below, and both directives exit 0.
//! cli: run
//! cli: check
require @vibe/core 0.2.0 = #pkg:sha1:0000000000000000000000000000000000000000

fn main allows Console {
  println("pin head parsed")
}
