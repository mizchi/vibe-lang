// ch12 (round 2, R2-7 / #2228): the failing-file report -- names the
// test and both sides, still no line number (#2202). Round 2 measured
// the launcher printing the assert detail BEFORE its FAIL line; #2228
// reordered it to the script lane's format (FAIL first, 7-space
// detail, summary last), so both directive runs below now print the
// same block. The failing assertion is deliberate; a "failing test:"
// line (and the launcher lane's exit 1) is this probe's expected data,
// not a harness error.
//! cli: test
fn double(n: Int) -> Int {
  n * 2
}

test "double works" {
  assert_eq(double(21), 43)
}
