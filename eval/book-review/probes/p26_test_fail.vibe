// ch12 (round 2, R2-7): the failing-file report -- names the test and
// both sides, still no line number (#2202). On the launcher lane the
// assert detail prints BEFORE the FAIL line (#2228). The failing
// assertion below is deliberate; a "failing test:" line is this
// probe's expected data, not a harness error.
fn double(n: Int) -> Int {
  n * 2
}

test "double works" {
  assert_eq(double(21), 43)
}
