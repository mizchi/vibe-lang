// ch12 (round 2, R2-7): the failing-file report -- names the test and
// both sides, still no line number (#2202). On the launcher lane the
// assert detail prints BEFORE the FAIL line (#2228) -- the directive
// below runs that lane too, so both orderings land in one report. The
// failing assertion is deliberate; a "failing test:" line (and the
// launcher lane's exit 1) is this probe's expected data, not a
// harness error.
//! cli: test
fn double(n: Int) -> Int {
  n * 2
}

test "double works" {
  assert_eq(double(21), 43)
}
