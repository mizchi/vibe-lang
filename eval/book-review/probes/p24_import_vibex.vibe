// ch01 (round 1 D7, round 2 R2-1): "a .vibex is an executable root,
// which other files cannot import" -- measure the import-side
// enforcement. Expected: rejected at 1:1 with ".vibex is an executable
// root and cannot be imported". The dep file also carries an
// `export fn`, which ADR-0075 says a .vibex does not have -- yet it
// checks and runs standalone (#2229); the export is unreachable either
// way, as this probe's rejection shows.
import ./p24_import_vibex_dep.vibex { helper }

fn main with Console {
  println("\{helper()}")
}
