// ch13 (finding D12): the book never says what Array::get / xs[i] do
// out of range. Triage-critical: a silent sentinel or garbage would be
// P0 (silently wrong); a trap is P1. Doc expectation: none — that is
// the finding.
fn main with Console {
  let xs = [
    1,
    2,
    3
  ]
  println("before")
  println("get(10) = \{Array::get(xs, 10)}")
  println("after")
}
