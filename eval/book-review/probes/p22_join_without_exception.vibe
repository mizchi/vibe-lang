// not `with`. The chapter quotes the allows spelling.
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main allows Console {
  let answer = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> {
      21 * 2
    })
    TaskHandle::join(h)
  })
  println("answer = \{answer}")
}
