// ch17 (round 1 D9, round 2 R2-3): the chapter's example row is
// `with Console + Exception` and never says why. TaskHandle::join is
// declared `-> T with Exception[TaskError] + e` (lib/@vibe/concurrent/
// index.vpkg), so omitting Exception from main must be rejected.
// Expected: located mismatch naming { Exception[TaskError] } with the
// hint "add 'with Console + Exception[TaskError]' to 'main'".
import @vibe/concurrent {
  TaskGroup, TaskHandle
}

fn main with Console {
  let answer = TaskGroup::run((n) -> {
    let h = TaskGroup::spawn(n, () -> {
      21 * 2
    })
    TaskHandle::join(h)
  })
  println("answer = \{answer}")
}
