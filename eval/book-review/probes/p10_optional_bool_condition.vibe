// ch03 (optional arguments): "`if flag` where `flag?: Bool` is a type
// error". The body sees Option[Bool]. The diagnostic names that type
// and the edit: match it, or pass a Bool. It anchors on `flag`.
// The compile sidecar strips the offset marker; vibe check prints it.
//! cli: check
fn f(flag?: Bool) -> Int {
  if flag {
    1
  } else {
    0
  }
}

fn main allows Console {
  println("\{f(true)}")
}
