// ch16 (round 2, R2-8): a generic T with no Eq witness is a compile
// error, quoted in the book. Expected: rejected with
// "no impl `Eq` for `Array[Int]`" -- verbatim, and (still) with no
// source position, the #2198 family's shape.
fn eq2[T: Eq](a: T, b: T) -> Bool { a == b }

fn main with Console {
  println("\{eq2([1], [1])}")
}
