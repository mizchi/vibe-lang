// ch02/ch07: "add a variant and the errors point at every match that
// now has a hole" / "the compiler tells you which function is now
// incomplete". Measure: does the diagnostic name the missing variant
// and the location of the match?
enum Shape {
  Circle(Int);
  Rect(Int, Int);
  Triangle(Int, Int)
}

fn area(s: Shape) -> Int {
  match s {
    Circle(r) => 3 * r * r,
    Rect(w, h) => w * h
  }
}

fn main with Console {
  println("\{area(Circle(2))}")
}
