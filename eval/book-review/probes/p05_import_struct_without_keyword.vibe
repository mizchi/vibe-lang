// ch13 vs ch15 (finding D6): ch13 imports `{ struct MutMap }` with a
// keyword, ch15 imports `{ Default }` without one. What happens when the
// keyword is omitted for a struct? Measure the diagnostic: does it say
// to write `struct MutMap`?
import @vibe/core {
  MutMap
}

fn main with Console {
  let m: MutMap[String, Int] = MutMap::new_string()
  MutMap::set(m, "a", 1)
  println("size = \{MutMap::size(m)}")
}
