// ch14 (round 2, R2-8): "for i, x in xs binds the index too" is stated
// outside any run block. Measure it: the loop collects, and the index
// is bound. Expected output: ys[2] = 32.
fn main with Console {
  let xs = [10, 20, 30]
  let ys = for i, x in xs {
    i + x
  }
  println("ys[2] = \{Array::get(ys, 2)}")
}
