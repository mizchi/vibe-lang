// ch15 (finding D13, follow-up to p14): p14 shows a bare fn cannot omit
// `-> T`. But `fn main with Console` omits it everywhere in the book.
// Is main special, or does a `with` clause make the return annotation
// optional for any fn?
fn shout(msg: String) with Console {
  println(msg)
}

fn main with Console {
  shout("hi")
}
