// ch02 vs ch08 (finding D1): ch02 uses throw("..."), ch08 only
// perform Exception::Throw("..."). Are they the same thing? This probe
// uses both in one program and handles both the same way.
fn f(x: Int) -> Int with Exception {
  if x == 0 {
    throw("via throw")
  }
  x
}

fn g(x: Int) -> Int with Exception {
  if x == 0 {
    perform Exception::Throw("via perform")
  }
  x
}

fn run(h~: (Int) -> Int with Exception, x~: Int) -> String {
  handle {
    "ok \{h(x)}"
  } with Exception {
    Throw(m) => "caught: \{m}"
  }
}

fn main with Console {
  println(run(h=f, x=0))
  println(run(h=g, x=0))
  println(run(h=f, x=5))
}
