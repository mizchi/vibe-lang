// ch04 vs ch08/ch10 (finding D2): ch04 writes `return -1`, but ch08/ch10
// write `0 - 1` in match/handler arms. Question: is `-1` accepted as a
// match-arm body? Doc expectation: it should be (nothing says otherwise).
fn pick(o: Option[Int]) -> Int {
  match o {
    Some(v) => v,
    None => -1
  }
}

fn main with Console {
  println("\{pick(None)} \{pick(Some(2))}")
}
