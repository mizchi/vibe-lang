// ch12 (finding D14): the shown failure output has no file:line. With
// two asserts in one test, does the report say which one fired?
// Run via: vibe test (scripts/vibe_test.sh) rather than the compile lane.
fn double(n: Int) -> Int {
  n * 2
}

test "which assert fired" {
  assert_eq(double(21), 42)
  assert_eq(double(2), 5)
}
