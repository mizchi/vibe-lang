// ch12 (round 2, R2-7): the passing-file report. The book's console
// block quotes scripts/vibe_test.sh (`ok   <file>` + a `[vibe-test]`
// summary line); the LAUNCHER's `vibe test` verb prints `ok:   <file>`
// with no summary at all (#2228). This probe runs on the repo script
// lane via run_probes.sh; re-run `vibe test <this file>` through an
// installed launcher to re-measure the divergence.
fn double(n: Int) -> Int {
  n * 2
}

test "double works" {
  assert_eq(double(21), 42)
}
