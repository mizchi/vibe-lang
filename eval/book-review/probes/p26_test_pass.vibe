// ch12 (round 2, R2-7): the passing-file report. The book's console
// block quotes scripts/vibe_test.sh (`ok   <file>` + a `[vibe-test]`
// summary line); the LAUNCHER's `vibe test` verb prints `ok:   <file>`
// with no summary at all (#2228). run_probes.sh runs BOTH: the repo
// script lane first, then the launcher verb via the directive below,
// so the two reporters' divergence is reproduced side by side.
//! cli: test
fn double(n: Int) -> Int {
  n * 2
}

test "double works" {
  assert_eq(double(21), 42)
}
