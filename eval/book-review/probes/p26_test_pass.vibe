// ch12 (round 2, R2-7 / #2228): the passing-file report. Round 2
// measured two reporters disagreeing: scripts/vibe_test.sh printed
// `ok   <file>` + a `[vibe-test]` summary while the launcher verb
// printed `ok:   <file>` with no summary. #2228 unified them on the
// script lane's format (the one the book documents), so run_probes.sh's
// two runs -- the script lane first, then the launcher verb via the
// directive below -- now print the same report.
//! cli: test
fn double(n: Int) -> Int {
  n * 2
}

test "double works" {
  assert_eq(double(21), 42)
}
