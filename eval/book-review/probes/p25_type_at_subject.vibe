// ch18 (round 2, R2-6): the book's editor-query example. The chapter
// used to claim `vibe type-at hello.vibe 5 4` answers for `add`;
// measured, 5:4 sits on `main` (the book's file starts at `fn add`,
// where the pairs are 1:4 and 5:4). The directives below run the real
// verbs against THIS file via run_probes.sh; expected answers:
//   symbols       -> add 12 <s> <e> / main 12 <s> <e>  (KIND 12 = Function)
//   type-at 12 4  -> (Int, Int) -> Int       (on the name `add`)
//   type-at 16 4  -> () -> () with Console   (on `main`)
//! cli: symbols
//! cli: type-at 12 4
//! cli: type-at 16 4
fn add(x: Int, y: Int) -> Int {
  x + y
}

fn main with Console {
  println("\{add(2, 40)}")
}
