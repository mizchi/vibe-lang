// ch05/ch20 (finding D4): interpolating a struct without derive(Show)
// "is a compile error" (#1445). Measure the diagnostic: does it name
// derive(Show) as the edit, and does it carry a position?
struct Point {
  x: Int; y: Int
}

fn main with Console {
  let p = Point::{
    x: 3, y: 4
  }
  println("\{p}")
}
