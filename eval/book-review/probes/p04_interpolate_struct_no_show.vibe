// ch05/ch20: interpolating a struct without derive(Show) is a compile
// error and names `derive(Show)`. vibe check anchors `p` at line 13:14.
// The compile sidecar stays positionless.
//! cli: check
struct Point {
  x: Int; y: Int
}

fn main allows Console {
  let p = Point::{
    x: 3, y: 4
  }
  println("\{p}")
}
