// ch13 (round 2, R2-8): "builders finish with ::freeze for ArrayBuilder
// and MapBuilder". Measure MapBuilder's actual surface: `::new()` (a
// `::new_string()` spelling does NOT exist on MapBuilder -- the keyed
// constructors are MutMap's), `::set`, `::freeze` into a persistent
// Map. Expected output: map size = 1.
fn main with Console {
  let mb = MapBuilder::new()
  MapBuilder::set(mb, "k", 1)
  let m = MapBuilder::freeze(mb)
  println("map size = \{Map::size(m)}")
}
