// ch03 vs ch05 (finding D3): ch03 says indexing a string gives "its code
// point"; ch05 says s[i] is the byte. For "é" these disagree: code point
// 233, first byte 195. Also: what does String::from_char_code do above
// 127 — byte or code point? Doc expectation (ch05): s[0] of "é" is 195.
fn main with Console {
  let s = "é"
  println("len = \{String::length(s)}")
  println("s[0] = \{s[0]}")
  println("s[1] = \{s[1]}")
  println("from_char_code(233) = \{String::from_char_code(233)}")
  println("from_char_code(s[0]) = \{String::from_char_code(s[0])}")
}
