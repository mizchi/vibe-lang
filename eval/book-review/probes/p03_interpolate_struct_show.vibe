// ch05 (finding D4): the book claims derive(Show) makes a struct
// interpolatable, but its example never writes \{p} — it calls
// Point::to_string(p). Doc expectation: this prints Point { x: 3, y: 4 }.
struct Point {
  x: Int; y: Int
} derive (Show)

fn main with Console {
  let p = Point::{
    x: 3, y: 4
  }
  println("\{p}")
}
