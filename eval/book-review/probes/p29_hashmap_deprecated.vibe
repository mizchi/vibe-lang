// ch13 (round 2, R2-8): "if you meet HashMap in older code it is a
// transparent alias of MutMap; vibe check warns on the old function
// names". Measure: this file compiles and runs (alias transparent);
// `vibe check` on it prints one located warning PER USE:
//   warning: line N:col M: 'HashMap' is deprecated: use MutMap
// (note warnings spell the position `line N:col M:` where errors
// write `line N:M:` -- recorded in rounds/2026-08-22-r2.md).
import @vibe/core { HashMap }

fn main with Console {
  let m: HashMap[String, Int] = HashMap::new_string()
  HashMap::set(m, "a", 1)
  println("size = \{HashMap::size(m)}")
}
