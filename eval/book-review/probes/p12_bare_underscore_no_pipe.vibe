// ch04 (finding D14): "a bare `_` marks the pipe slot; `_` inside a
// larger expression is a lambda section." What is a bare `_` argument
// with no pipe in sight? The book does not say.
fn main with Console {
  let xs = [
    1,
    2,
    3
  ]
  let ys = Array::map(_, _ * 2)
  println("\{Array::get(ys(xs), 0)}")
}
