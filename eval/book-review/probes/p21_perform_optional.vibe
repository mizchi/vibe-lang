// ch09: `perform? Fs::read_file` on an optional grant. Round 2 expected
// an up-front rejection (#2145). Measured 2026-09-24 on stage2 built
// from 0f0ba364e: the program compiles and prints "not granted", which
// is what the chapter's own run block records. The rejection quote in
// this header was the stale half.
fn main allows Console + Fs::read_file? {
  let a = perform? Fs::read_file("config.json")
  match a {
    NotGranted => println("not granted"),
    Errored(_) => println("errored"),
    Granted(_) => println("granted")
  }
}
