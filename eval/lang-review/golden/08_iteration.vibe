let main: () -> Unit with Stdout = () -> {
  // (a) indexed for-in
  let xs = ["a", "b", "c"]
  for i, x in xs {
    print("\{i}:\{x} ")
  }
  println("")

  // (b) String iteration.
  // NOTE: `for c in "abc" { ... }` compiles but silently iterates ZERO times
  // (no type error, no runtime error). Workaround: index with char_code_at.
  let s = "abc"
  let mut sum = 0
  let mut i = 0
  while i < String::length(s) {
    sum = sum + String::char_code_at(s, i)
    i = i + 1
  }
  println("sum=\{sum}")
}
