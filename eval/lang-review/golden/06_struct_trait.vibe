import ../../../lib/@vibe/prelude { stdout_write }

struct Point { x: Int; y: Int } derive(Eq)

trait Show

impl Show for Point

let Point::to_string: (Point) -> String = (p) -> { "(\{p.x}, \{p.y})" }

let main: () -> Unit with Stdout = () -> {
  let a = Point::{ x: 1, y: 2 }
  let b = Point::{ x: 1, y: 2 }
  if a == b {
    stdout_write("eq: true\n")
  } else {
    stdout_write("eq: false\n")
  }
  stdout_write("\{Point::to_string(a)}\n")
}
