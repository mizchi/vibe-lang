struct Point { x: Int; y: Int } derive(Eq)

trait Show

impl Show for Point

let Point::to_string: (Point) -> String = (p) -> { "(\{p.x}, \{p.y})" }

let main: () -> Unit with Stdout = () -> {
  let a = Point::{ x: 1, y: 2 }
  let b = Point::{ x: 1, y: 2 }
  if a == b {
    println("eq: true")
  } else {
    println("eq: false")
  }
  println("\{Point::to_string(a)}")
}
