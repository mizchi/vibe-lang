import ../../../lib/@vibe/prelude { stdout_write }

fn fizzbuzz(n: Int) -> String {
  if n % 15 == 0 { "FizzBuzz" }
  else if n % 3 == 0 { "Fizz" }
  else if n % 5 == 0 { "Buzz" }
  else { Int::to_string(n) }
}

let main: () -> Unit with Stdout = () -> {
  let mut i = 1
  while i <= 15 {
    stdout_write("\{fizzbuzz(i)}\n")
    i = i + 1
  }
}
