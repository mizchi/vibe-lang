import ../../../lib/@vibe/prelude { stdout_write }

fn parse_int(s: String) -> Int {
  let n = String::length(s)
  let mut i = 0
  let mut acc = 0
  while i < n {
    acc = acc * 10 + (String::char_code_at(s, i) - 48)
    i = i + 1
  }
  acc
}

let main: () -> Unit with Stdout = () -> {
  let data = "apple,3\nbanana,5\ncherry,2"
  let lines = String::split(data, "\n")
  let mut total = 0
  for line in lines {
    let parts = String::split(line, ",")
    let name = parts[0]
    let count = parse_int(parts[1])
    stdout_write("\{name}: \{count}\n")
    total = total + count
  }
  stdout_write("total=\{total}\n")
}
