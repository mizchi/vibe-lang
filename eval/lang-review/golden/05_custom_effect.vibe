import ../../../lib/@vibe/prelude { stdout_write }

effect Logger {
  Log(String) -> Unit
}

let body: () -> Unit with Logger = () -> {
  perform Logger::Log("a")
  perform Logger::Log("b")
  perform Logger::Log("c")
}

let main: () -> Unit with Stdout = () -> {
  let b = ArrayBuilder::new()
  handle { body() } with Logger {
    Log(msg) => {
      ArrayBuilder::push(b, msg)
      resume(())
    }
  }
  let logs = ArrayBuilder::freeze(b)
  let joined = String::join(logs, ",")
  stdout_write("logs=\{Array::length(logs)}: \{joined}\n")
}
