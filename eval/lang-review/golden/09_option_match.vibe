import ../../../lib/@vibe/prelude { stdout_write }

// NOTE: the natural version — `match xs[i] { v if v > 5 => break Some(v),
// _ => continue(i + 1) }` inside `loop` — COMPILES but HANGS at runtime
// (break/continue in match arms inside loop miscompile to an infinite loop).
// Workaround: keep break/continue directly in the loop body.
fn first_gt5(xs: Array[Int]) -> Option[Int] {
  loop (i = 0) {
    if i >= Array::length(xs) { break None }
    if xs[i] > 5 { break Some(xs[i]) }
    continue(i + 1)
  }
}

fn describe(xs: Array[Int]) -> String {
  match first_gt5(xs) {
    Some(v) if v > 5 => "found: \{v}",   // guard arm
    Some(v) => "found (small): \{v}",
    None => "none",
  }
}

let main: () -> Unit with Stdout = () -> {
  stdout_write("\{describe([1, 3, 7, 9])}\n")
  stdout_write("\{describe([1, 2])}\n")
}
