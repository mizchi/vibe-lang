import ../../../lib/@vibe/prelude { stdout_write }

enum Tree {
  Leaf(Int);
  Node(Tree, Tree);
}

fn sum(t: Tree) -> Int {
  match t {
    Leaf(v) => v,
    Node(l, r) => sum(l) + sum(r),
  }
}

let main: () -> Unit with Stdout = () -> {
  let t = Node(Node(Leaf(1), Leaf(2)), Leaf(3))
  stdout_write("sum=\{sum(t)}\n")
}
