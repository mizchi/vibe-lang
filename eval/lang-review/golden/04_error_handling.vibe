import ../../../lib/@vibe/prelude/io.vibe { stdout_write }

fn parse_int(s: String) -> Result[Int, String] {
  let n = String::length(s)
  if n == 0 { return Err("invalid int: \(s)") }
  let mut i = 0
  let mut acc = 0
  let mut ok = true
  while i < n {
    let c = String::char_code_at(s, i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    } else {
      ok = false
    }
    i = i + 1
  }
  if ok { Ok(acc) } else { Err("invalid int: \(s)") }
}

// `?` railway: Err early-returns from the enclosing function
fn parse_doubled(s: String) -> Result[Int, String] {
  let v = parse_int(s)?
  Ok(v * 2)
}

fn report(s: String) -> String {
  match parse_int(s) {
    Ok(v) => "parsed: \(v)",
    Err(e) => "error: \(e)",
  }
}

let main: () -> Unit with { Stdout } = () -> {
  stdout_write("\(report("42"))\n")
  stdout_write("\(report("abc"))\n")
  match parse_doubled("21") {
    Ok(v) => stdout_write("doubled: \(v)\n"),
    Err(e) => stdout_write("error: \(e)\n"),
  }
}
