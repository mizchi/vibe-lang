// #1324: failure is carried by the effect row, not a `Result` return. The
// success value flows straight through, so stages chain without `and_then`
// and without a per-call `match`.
fn parse_int(s: String) -> Int with Exception[String] {
  let n = String::length(s)
  if n == 0 { throw("invalid int: \{s}") }
  let mut i = 0
  let mut acc = 0
  let mut ok = true
  while i < n {
    let c = String::char_code_at(s, i)
    if c >= 48 && c <= 57 {
      acc = acc * 10 + (c - 48)
    } else {
      ok = false
    }
    i = i + 1
  }
  if ok { acc } else { throw("invalid int: \{s}") }
}

// The failure propagates on its own — no `?` and no early-return spelling.
fn parse_doubled(s: String) -> Int with Exception[String] {
  parse_int(s) * 2
}

fn report(s: String) -> String {
  handle {
    "parsed: \{parse_int(s)}"
  } with {
    Exception[String]::Throw(e) => "error: \{e}"
  }
}

let main: () -> Unit with Stdout = () -> {
  print("\{report("42")}\n")
  print("\{report("abc")}\n")
  let doubled = handle {
    "doubled: \{parse_doubled("21")}"
  } with {
    Exception[String]::Throw(e) => "error: \{e}"
  }
  println("\{doubled}")
}
