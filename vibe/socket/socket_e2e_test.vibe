
use ./socket.vibe { tcp_connect, tcp_read, tcp_write, tcp_close }

// Requires echo server: python3 tests/echo_server.py 18234

test "tcp echo round-trip" {
  let handle = tcp_connect("127.0.0.1", 18234)
  tcp_write(handle, "hello vibe socket")
  let response = tcp_read(handle, 1024)
  assert(response == "hello vibe socket")
  tcp_close(handle)
}

test "tcp multiple writes" {
  let h = tcp_connect("127.0.0.1", 18234)
  tcp_write(h, "AAA")
  let r1 = tcp_read(h, 1024)
  assert(r1 == "AAA")
  tcp_write(h, "BBB")
  let r2 = tcp_read(h, 1024)
  assert(r2 == "BBB")
  tcp_close(h)
}

test "tcp empty string write" {
  let h = tcp_connect("127.0.0.1", 18234)
  tcp_write(h, "x")
  let r = tcp_read(h, 1024)
  assert(r == "x")
  tcp_close(h)
}
