//# Imports

import ./tcp.vibe {
  tcp_close, tcp_connect, tcp_read, tcp_write
}

//# Misc

test "tcp echo round-trip" {
  let fd = tcp_connect("127.0.0.1", 18234)
  tcp_write(fd, "hello vibe socket")
  let response = tcp_read(fd, 1024)
  assert(response == "hello vibe socket")
  tcp_close(fd)
}

test "tcp multiple writes" {
  let h = tcp_connect("127.0.0.1", 18234)
  tcp_write(h, "AAA")
  let r1 = tcp_read(h, 1024)
  assert(r1 == "AAA")
  tcp_write(h, "BBB")
  let r2 = tcp_read(h, 1024)
  assert(r2 == "BBB")
  tcp_close(h)
}

test "tcp empty string write" {
  let h = tcp_connect("127.0.0.1", 18234)
  tcp_write(h, "x")
  let r = tcp_read(h, 1024)
  assert(r == "x")
  tcp_close(h)
}
