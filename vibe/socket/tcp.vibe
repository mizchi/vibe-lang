//# Functions

// tcp_read: (Int, Int) -> String with {Net}
export let tcp_read = (fd: Int, max_bytes: Int) -> String {
  perform Socket::Read(fd, max_bytes)
}

// tcp_close: (Int) -> Unit with {Net}
export let tcp_close = (fd: Int) -> Unit {
  perform Socket::Close(fd)
}

// tcp_write: (Int, String) -> Unit with {Net}
export let tcp_write = (fd: Int, data: String) -> Unit {
  perform Socket::Write(fd, data)
}

// tcp_connect: (String, Int) -> Int with {Net}
export let tcp_connect = (host: String, port: Int) -> Int {
  perform Socket::Connect(host, port)
}
