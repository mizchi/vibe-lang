//# Functions

// tcp_read: (Int, Int) -> String with {Net}
export let tcp_read = (fd: Int, max_bytes: Int) -> String with { Net } {
  Socket::tcp_read(fd, max_bytes)
}

// tcp_close: (Int) -> Unit with {Net}
export let tcp_close = (fd: Int) -> Unit with { Net } {
  Socket::tcp_close(fd)
}

// tcp_write: (Int, String) -> Unit with {Net}
export let tcp_write = (fd: Int, data: String) -> Unit with { Net } {
  Socket::tcp_write(fd, data)
}

// tcp_connect: (String, Int) -> Int with {Net}
export let tcp_connect = (host: String, port: Int) -> Int with { Net } {
  Socket::tcp_connect(host, port)
}
