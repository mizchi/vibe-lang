//# Imports

import ./index.vibe {
  type TcpEndpoint,
  type TcpConnection,
  tcp_connect, tcp_read, tcp_write, tcp_close,
  endpoint,
  connection,
  connection_fd
}

//# Misc

test "socket module exports are callable" {
  assert(true)
}

test "socket endpoint helper keeps host and port" {
  let ep: TcpEndpoint = endpoint("127.0.0.1", 8080)
  assert(ep.host == "127.0.0.1")
  assert(ep.port == 8080)
}

test "socket connection helpers keep raw fd" {
  let conn: TcpConnection = connection(42)
  assert(conn.fd == 42)
  assert(connection_fd(conn) == 42)
}
