
declare export let tcp_connect: (String, Int) -> Int with { Net }
declare export let tcp_read: (Int, Int) -> String with { Net }
declare export let tcp_write: (Int, String) -> Unit with { Net }
declare export let tcp_close: (Int) -> Unit with { Net }
tcp_connect = (host: String, port: Int) -> Int with { Net } {
  do {
    socket_tcp_connect(host, port)
  }
}
tcp_read = (handle: Int, max_bytes: Int) -> String with { Net } {
  do {
    socket_tcp_read(handle, max_bytes)
  }
}
tcp_write = (handle: Int, data: String) -> Unit with { Net } {
  do {
    socket_tcp_write(handle, data)
  }
}
tcp_close = (handle: Int) -> Unit with { Net } {
  do {
    socket_tcp_close(handle)
  }
}
