
export let tcp_read = (handle: Int, max_bytes: Int) -> String with {
  Net
} {
  do {
    socket_tcp_read(handle, max_bytes)
  }
}
export let tcp_close = (handle: Int) -> Unit with {
  Net
} {
  do {
    socket_tcp_close(handle)
  }
}
export let tcp_write = (handle: Int, data: String) -> Unit with {
  Net
} {
  do {
    socket_tcp_write(handle, data)
  }
}
export let tcp_connect = (host: String, port: Int) -> Int with {
  Net
} {
  do {
    socket_tcp_connect(host, port)
  }
}
