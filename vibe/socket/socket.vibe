//# Types

export struct TcpEndpoint {
  host: String;
  port: Int
}

export struct TcpConnection {
  fd: Int
}

//# Functions

export let endpoint = (host: String, port: Int) -> TcpEndpoint {
  TcpEndpoint::{
    host: host,
    port: port
  }
}

// tcp_read: (Int, Int) -> String with {Net}
export let tcp_read = (fd: Int, max_bytes: Int) -> String with { Net } {
  socket_tcp_read(fd, max_bytes)
}

// read: (TcpConnection, Int) -> String with {Net}
export let read = (conn: TcpConnection, max_bytes: Int) -> String with { Net } {
  tcp_read(conn.fd, max_bytes)
}

// tcp_close: (Int) -> Unit with {Net}
export let tcp_close = (fd: Int) -> Unit with { Net } {
  socket_tcp_close(fd)
}

// close: (TcpConnection) -> Unit with {Net}
export let close = (conn: TcpConnection) -> Unit with { Net } {
  tcp_close(conn.fd)
}

// tcp_write: (Int, String) -> Unit with {Net}
export let tcp_write = (fd: Int, data: String) -> Unit with { Net } {
  socket_tcp_write(fd, data)
}

// write: (TcpConnection, String) -> Unit with {Net}
export let write = (conn: TcpConnection, data: String) -> Unit with { Net } {
  tcp_write(conn.fd, data)
}

export let connection = (fd: Int) -> TcpConnection {
  TcpConnection::{
    fd: fd
  }
}

// tcp_connect: (String, Int) -> Int with {Net}
export let tcp_connect = (host: String, port: Int) -> Int with { Net } {
  socket_tcp_connect(host, port)
}

// connect: (TcpEndpoint) -> TcpConnection with {Net}
export let connect = (target: TcpEndpoint) -> TcpConnection with { Net } {
  connection(tcp_connect(target.host, target.port))
}

export let connection_fd = (conn: TcpConnection) -> Int {
  conn.fd
}
