//# Imports

import ./tcp.vibe {
  tcp_close, tcp_connect, tcp_read, tcp_write
}

//# Types

export struct TcpEndpoint {
  host: String;
  port: Int
}

export struct TcpConnection {
  fd: Int
}

//# Functions

// read: (TcpConnection, Int) -> String with { Socket }
export let read: (TcpConnection, Int) -> String with { Socket } = (conn, max_bytes) -> {
  tcp_read(conn.fd, max_bytes)
}

// close: (TcpConnection) -> Unit with { Socket }
export let close: (TcpConnection) -> Unit with { Socket } = (conn) -> {
  tcp_close(conn.fd)
}

// write: (TcpConnection, String) -> Unit with { Socket }
export let write: (TcpConnection, String) -> Unit with { Socket } = (conn, data) -> {
  tcp_write(conn.fd, data)
}

export let endpoint: (String, Int) -> TcpEndpoint = (host, port) -> {
  TcpEndpoint::{
    host: host,
    port: port
  }
}

export let connection: (Int) -> TcpConnection = (fd) -> {
  TcpConnection::{
    fd: fd
  }
}

// connect: (TcpEndpoint) -> TcpConnection with { Socket }
export let connect: (TcpEndpoint) -> TcpConnection with { Socket } = (target) -> {
  connection(tcp_connect(target.host, target.port))
}

export let connection_fd: (TcpConnection) -> Int = (conn) -> {
  conn.fd
}
