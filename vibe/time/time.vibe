//# Functions

// sleep_ms: (Int) -> Unit with {Async}
export let sleep_ms = (ms: Int) -> Unit with { Async } {
  sleep(ms)
}

let first_line = (lines: Array[String]) -> String {
  if array_length(lines) == 0 {
    ""
  } else array_get(lines, 0)
}

// now_utc_iso: () -> String with {Process}
export let now_utc_iso = () -> String with { Process } {
  let lines = sh_lines("date -u +%Y-%m-%dT%H:%M:%SZ")
  first_line(lines)
}

// now_local_date: () -> String with {Process}
export let now_local_date = () -> String with { Process } {
  let lines = sh_lines("date +%Y-%m-%d")
  first_line(lines)
}
