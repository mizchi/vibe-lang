
let first_line = (lines: Array[String]) -> String {
  if array_length(lines) == 0 {
    ""
  } else {
    array_get(lines, 0)
  }
}
export let now_utc_iso = () -> String with {
  Process
} {
  let lines = do {
    sh_lines("date -u +%Y-%m-%dT%H:%M:%SZ")
  }
  first_line(lines)
}
export let now_local_date = () -> String with {
  Process
} {
  let lines = do {
    sh_lines("date +%Y-%m-%d")
  }
  first_line(lines)
}
export let sleep_ms = (ms: Int) -> Unit with {
  Async
} {
  do {
    sleep(ms)
  }
}
export {
  now_utc_iso, now_local_date, sleep_ms
}
