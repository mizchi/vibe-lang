
use ./index.vibe {
  now_utc_iso, now_local_date, sleep_ms
}
test "time index exports core symbols" {
  let iso = do {
    now_utc_iso()
  }
  assert(eq(string_length(iso), 20))
  assert(eq(string_char_code_at(iso, 4), 45))
  assert(eq(string_char_code_at(iso, 7), 45))
  assert(eq(string_char_code_at(iso, 10), 84))
  assert(eq(string_char_code_at(iso, 13), 58))
  assert(eq(string_char_code_at(iso, 16), 58))
  assert(eq(string_char_code_at(iso, 19), 90))

  let date = do {
    now_local_date()
  }
  assert(eq(string_length(date), 10))
  assert(eq(string_char_code_at(date, 4), 45))
  assert(eq(string_char_code_at(date, 7), 45))

  let _sleep_fn = sleep_ms
  assert(true)
}
