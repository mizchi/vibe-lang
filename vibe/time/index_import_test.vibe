//# Imports

import .{
  now_local_date, now_utc_iso, sleep_ms
}

//# Misc

test "time index exports core symbols" {
  let iso = now_utc_iso()
  assert(eq(String::length(iso), 20))
  assert(eq(String::char_code_at(iso, 4), 45))
  assert(eq(String::char_code_at(iso, 7), 45))
  assert(eq(String::char_code_at(iso, 10), 84))
  assert(eq(String::char_code_at(iso, 13), 58))
  assert(eq(String::char_code_at(iso, 16), 58))
  assert(eq(String::char_code_at(iso, 19), 90))
  let date = now_local_date()
  assert(eq(String::length(date), 10))
  assert(eq(String::char_code_at(date, 4), 45))
  assert(eq(String::char_code_at(date, 7), 45))
  let _sleep_fn = sleep_ms
  assert(true)
}
