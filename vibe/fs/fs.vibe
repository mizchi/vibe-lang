
declare export let read_file: (String) -> String with { Fs }
declare export let write_file: (String, String) -> Unit with { Fs }
declare export let exists: (String) -> Bool with { Fs }
read_file = (path: String) -> String with { Fs } {
  do {
    fs_read_file(path)
  }
}
write_file = (path: String, content: String) -> Unit with { Fs } {
  do {
    fs_write_file(path, content)
  }
}
exists = (path: String) -> Bool with { Fs } {
  do {
    fs_exists(path)
  }
}
