
use ./fs.vibe { read_file, write_file, exists }

test "write_file and read_file" {
  let path = "/tmp/vibe_fs_test.txt"
  do {
    write_file(path, "hello vibe")
  }
  let content = do {
    read_file(path)
  }
  assert(string_equals(content, "hello vibe"))
}

test "exists returns true for existing file" {
  let path = "/tmp/vibe_fs_test_exists.txt"
  do {
    write_file(path, "test")
  }
  let result = do {
    exists(path)
  }
  assert(result)
}

test "exists returns false for nonexistent file" {
  let result = do {
    exists("/tmp/vibe_fs_nonexistent_file_12345")
  }
  assert(not(result))
}
