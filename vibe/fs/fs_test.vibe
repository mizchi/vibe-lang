//# Imports

import ./fs.vibe {
  exists, read_file, stat_token, write_file
}

//# Misc

test "write_file and read_file" {
  let path = "/tmp/vibe_fs_test.txt"
  write_file(path, "hello vibe")
  let content = read_file(path)
  assert(String::equals(content, "hello vibe"))
}

test "exists returns true for existing file" {
  let path = "/tmp/vibe_fs_test_exists.txt"
  write_file(path, "test")
  let result = exists(path)
  assert(result)
}

test "exists returns false for nonexistent file" {
  let result = exists("/tmp/vibe_fs_nonexistent_file_12345")
  assert(not(result))
}

test "stat_token is stable for unchanged file" {
  let path = "/tmp/vibe_fs_test_stat_token_stable.txt"
  write_file(path, "a")
  let token1 = stat_token(path)
  let token2 = stat_token(path)
  assert(eq(token1, token2))
}

test "stat_token changes after write" {
  let path = "/tmp/vibe_fs_test_stat_token_changed.txt"
  write_file(path, "a")
  let token1 = stat_token(path)
  write_file(path, "longer content")
  let token2 = stat_token(path)
  assert(not(eq(token1, token2)))
}
