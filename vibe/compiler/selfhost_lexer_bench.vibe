    probe_lex_parser_vibe()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/lex_synthetic_keyword_heavy" {
  let _ = handle {
    probe_lex_synthetic_keyword_heavy()
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/lex_token_payload_walk" {
