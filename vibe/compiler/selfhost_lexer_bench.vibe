//# Imports

import ./lexer_hotspot_probe.vibe {
  probe_lex_checker_vibe,
  probe_lex_lexer_vibe,
  probe_lex_parser_vibe,
  probe_lex_synthetic_keyword_heavy,
  probe_lex_token_payload_walk
}

bench "selfhost/lex_lexer_vibe" {
  let _ = handle {
    probe_lex_lexer_vibe()
  } with Error {
    Throw(_) => 0
  }
}

