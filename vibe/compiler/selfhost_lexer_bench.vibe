//# Imports

import ./lexer_hotspot_probe.vibe {
  load_lexer_source_fixture,
  probe_lex_repeat_count,
  probe_lex_token_count,
  probe_lex_total_token_length
}

//# Misc

let (
  lexer_source,
  checker_source,
  parser_source,
  synthetic_source
) = load_lexer_source_fixture()

bench "selfhost/lex_lexer_vibe" {
  let _ = handle {
    probe_lex_token_count(lexer_source)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/lex_checker_vibe" {
  let _ = handle {
    probe_lex_token_count(checker_source)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/lex_parser_vibe" {
  let _ = handle {
    probe_lex_token_count(parser_source)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/lex_synthetic_keyword_heavy" {
  let _ = handle {
    probe_lex_repeat_count(synthetic_source, 32)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/lex_token_payload_walk" {
  let _ = handle {
    probe_lex_total_token_length(lexer_source)
  } with Error {
    Throw(_) => 0
  }
}
