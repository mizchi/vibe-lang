//# Imports

import ./ast.vibe {
  Expr, Stmt, TypeExpr
}

import ./checker_effects.vibe {
  EffectError, check_perform_effects_expr, check_perform_effects_stmt
}

//# Functions

let is_perform_err: (EffectError) -> Bool = (e) -> {
  match e {
    EEPerformUndeclaredEffect(_, _) => true,
    _ => false
  }
}

// `perform EffName::Op(arg)` reaches the checker as
// ECall(EIdent("perform"), [ECall(EIdent("EffName::Op"), [arg])]).
let perform_op: (String, Expr) -> Expr = (op, arg) -> {
  ECall(EIdent("perform", -1), [
    ECall(EIdent(op, -1), [
      arg
    ], -1)
  ], -1)
}

let fn_with: (Option[String], Expr) -> Expr = (effect, body) -> {
  EFn(Array::slice([
    ""
  ], 0, 0), Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0), Array::slice([
    ("x", None)
  ], 0, 0), None, effect, body)
}

let no_labels: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

//# Misc

test "perform of undeclared effect reports error" {
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), no_labels(), false)
  assert(Array::length(errors) > 0)
  assert(is_perform_err(Array::get(errors, 0)))
}

test "perform of declared effect is OK" {
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), [
    "Stdout"
  ], false)
  assert(eq(Array::length(errors), 0))
}

test "perform of a different declared effect still reports error" {
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), [
    "Stdin"
  ], false)
  assert(Array::length(errors) > 0)
}

test "perform inside a handle is allowed regardless of declaration" {
  let inner = perform_op("Console::Print", EString("hi"))
  let handle_expr = EHandle(inner, [
    (PBind("k"), EInt(0))
  ])
  let errors = check_perform_effects_expr(handle_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "perform via EFn with declared effect is OK" {
  let fn_expr = fn_with(Some("Stdout"), perform_op("Stdout::WriteStream", EString("hi")))
  let errors = check_perform_effects_expr(fn_expr, no_labels(), false)
  assert(eq(Array::length(errors), 0))
}

test "perform via EFn without the effect reports error" {
  let fn_expr = fn_with(None, perform_op("Stdout::WriteStream", EString("hi")))
  let errors = check_perform_effects_expr(fn_expr, no_labels(), false)
  assert(Array::length(errors) > 0)
}

test "effect-variable declaration authorizes any perform" {
  // `with { e }` (a polymorphic effect variable) authorizes performing anything
  // under the current representation (row-tail unification is future work).
  let errors = check_perform_effects_expr(perform_op("Stdout::WriteStream", EString("hi")), [
    "e"
  ], false)
  assert(eq(Array::length(errors), 0))
}

test "SLet signature effect authorizes perform in its body" {
  let body = fn_with(None, perform_op("Fs::ReadFile", EString("p")))
  let sig = TyFn([
    TyName("String")
  ], TyName("String"), Some("Error, Fs"))
  let stmt = SLet(false, false, "read", Some(sig), body)
  let errors = check_perform_effects_stmt(stmt)
  assert(eq(Array::length(errors), 0))
}

test "SLet without the effect flags perform in its body" {
  let body = fn_with(None, perform_op("Fs::ReadFile", EString("p")))
  let sig = TyFn([
    TyName("String")
  ], TyName("String"), Some("Error"))
  let stmt = SLet(false, false, "read", Some(sig), body)
  let errors = check_perform_effects_stmt(stmt)
  assert(Array::length(errors) > 0)
}
