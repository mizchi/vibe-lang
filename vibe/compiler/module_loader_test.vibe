  assert(has_source_path(sources, "vibe/compiler/syntax/printer.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/float_format.vibe"))
  assert(has_source_path(sources, "vibe/compiler/bytebuf.vibe"))
  assert(has_source_path(sources, "vibe/compiler/ast.vibe"))
  assert(has_source_path(sources, "vibe/compiler/types.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/builtins.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker_resolve.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker_pattern.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker_stmt.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/builtins.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker_resolve.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker_pattern.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker_stmt.vibe"))
