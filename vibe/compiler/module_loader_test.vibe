  assert(has_source_path(sources, "vibe/compiler/codegen/common_analysis/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/expr/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/builtin_bodies/index.vibe"))
