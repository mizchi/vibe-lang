//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./types.vibe {
  Type, TypeEnv, env_bind, types_equal
}

import ./checker_test_support.vibe {
  check
}

//# Misc

test "literal int" {
  assert(types_equal(check(EInt(42), EnvEmpty), CtInt))
}

test "literal string" {
  assert(types_equal(check(EString("hello"), EnvEmpty), CtString))
}

test "literal bool" {
  assert(types_equal(check(EBool(true), EnvEmpty), CtBool))
}

test "literal float" {
  assert(types_equal(check(EFloat(3.14), EnvEmpty), CtDouble))
}

test "unit" {
  assert(types_equal(check(EUnit, EnvEmpty), CtUnit))
}

test "ident from env" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  assert(types_equal(check(EIdent("x"), env), CtInt))
}

test "ident builtin" {
  let ty = check(EIdent("String::concat"), EnvEmpty)
  assert(types_equal(ty, CtFn([
    CtString,
    CtString
  ], CtString, false)))
}

test "ident unknown" {
  assert(types_equal(check(EIdent("nonexistent"), EnvEmpty), CtUnknown))
}

test "let binding" {
  let expr = ELet("x", EInt(1), EIdent("x"))
  assert(types_equal(check(expr, EnvEmpty), CtInt))
}

test "seq returns last" {
  let expr = ESeq(EInt(1), EString("hello"))
  assert(types_equal(check(expr, EnvEmpty), CtString))
}

test "if returns then type" {
  let expr = EIf(EBool(true), EInt(42), EInt(0))
  assert(types_equal(check(expr, EnvEmpty), CtInt))
}

test "binop comparison" {
  let expr = EBinOp("==", EInt(1), EInt(2))
  assert(types_equal(check(expr, EnvEmpty), CtBool))
}

test "binop arithmetic" {
  let expr = EBinOp("+", EInt(1), EInt(2))
  assert(types_equal(check(expr, EnvEmpty), CtInt))
}

test "unary not" {
  let expr = EUnaryOp("!", EBool(true))
  assert(types_equal(check(expr, EnvEmpty), CtBool))
}
