import ./ast.vibe { Expr, Pat, TypeExpr, Stmt }
import ./types.vibe { Type, TypeDef, TypeEnv, env_bind, types_equal, Subst }
import ./checker.vibe { check_expr }

let empty_defs = () -> Array[TypeDef] {
  array_slice([TDAlias("_dummy", CtUnit)], 0, 0)
}

let check = (expr: Expr, env: TypeEnv) -> Type {
  let (ty, _, _) = check_expr(expr, env, empty_defs(), SubstEmpty, 0)
  ty
}

test "literal int" {
  assert(types_equal(check(EInt(42), EnvEmpty), CtInt))
}

test "literal string" {
  assert(types_equal(check(EString("hello"), EnvEmpty), CtString))
}

test "literal bool" {
  assert(types_equal(check(EBool(true), EnvEmpty), CtBool))
}

test "literal float" {
  assert(types_equal(check(EFloat(3.14), EnvEmpty), CtDouble))
}

test "unit" {
  assert(types_equal(check(EUnit, EnvEmpty), CtUnit))
}

test "ident from env" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  assert(types_equal(check(EIdent("x"), env), CtInt))
}

test "ident builtin" {
  let ty = check(EIdent("string_concat"), EnvEmpty)
  assert(types_equal(ty, CtFn([CtString, CtString], CtString, false)))
}

test "ident unknown" {
  assert(types_equal(check(EIdent("nonexistent"), EnvEmpty), CtUnknown))
}

test "let binding" {
  let expr = ELet("x", EInt(1), EIdent("x"))
  assert(types_equal(check(expr, EnvEmpty), CtInt))
}

test "seq returns last" {
  let expr = ESeq(EInt(1), EString("hello"))
  assert(types_equal(check(expr, EnvEmpty), CtString))
}

test "if returns then type" {
  let expr = EIf(EBool(true), EInt(42), EInt(0))
  assert(types_equal(check(expr, EnvEmpty), CtInt))
}

test "binop comparison" {
  let expr = EBinOp("==", EInt(1), EInt(2))
  assert(types_equal(check(expr, EnvEmpty), CtBool))
}

test "binop arithmetic" {
  let expr = EBinOp("+", EInt(1), EInt(2))
  assert(types_equal(check(expr, EnvEmpty), CtInt))
}

test "unary not" {
  let expr = EUnaryOp("!", EBool(true))
  assert(types_equal(check(expr, EnvEmpty), CtBool))
}

test "call returns fn return type" {
  let env = env_bind(EnvEmpty, "f", CtFn([CtInt], CtString, false))
  let expr = ECall(EIdent("f"), [EInt(42)])
  assert(types_equal(check(expr, env), CtString))
}

test "while returns unit" {
  let expr = EWhile(EBool(true), EInt(1))
  assert(types_equal(check(expr, EnvEmpty), CtUnit))
}

test "for-in returns array" {
  let env = env_bind(EnvEmpty, "xs", CtArray(CtInt))
  let expr = EForIn("x", EIdent("xs"), EString("a"))
  assert(types_equal(check(expr, env), CtArray(CtString)))
}

test "match returns first arm type" {
  let expr = EMatch(EInt(1), [(PInt(1), EString("one")), (PWild, EString("other"))])
  assert(types_equal(check(expr, EnvEmpty), CtString))
}

test "pipe returns fn return type" {
  let env = env_bind(EnvEmpty, "f", CtFn([CtInt], CtString, false))
  let expr = EPipe(EInt(42), EIdent("f"))
  assert(types_equal(check(expr, env), CtString))
}

test "fn typed param binds in body" {
  let expr = EFn([("x", Some(TyName("Int")))], None, None, EIdent("x"))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(params, ret, he) => {
      assert(types_equal(ret, CtInt))
      assert(not(he))
    },
    _ => assert(false)
  }
}

test "fn untyped param with usage" {
  let body = EBinOp("+", EIdent("x"), EInt(1))
  let expr = EFn([("x", None)], None, None, body)
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, _) => assert(types_equal(ret, CtInt)),
    _ => assert(false)
  }
}

test "fn multiple params typed" {
  let body = EBinOp("+", EIdent("x"), EInt(1))
  let expr = EFn([("x", Some(TyName("Int"))), ("y", Some(TyName("String")))], None, None, body)
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(params, ret, _) => {
      assert(types_equal(ret, CtInt))
      assert(eq(array_length(params), 2))
      assert(types_equal(array_get(params, 0), CtInt))
      assert(types_equal(array_get(params, 1), CtString))
    },
    _ => assert(false)
  }
}

test "fn with effect flag" {
  let expr = EFn([("x", None)], None, Some("Error"), EInt(1))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, he) => {
      assert(types_equal(ret, CtInt))
      assert(he)
    },
    _ => assert(false)
  }
}

test "fn without effect flag" {
  let expr = EFn([("x", None)], None, None, EInt(1))
  let ty = check(expr, EnvEmpty)
  match ty {
    CtFn(_, ret, he) => {
      assert(types_equal(ret, CtInt))
      assert(not(he))
    },
    _ => assert(false)
  }
}
