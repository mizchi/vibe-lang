import ./ast.vibe { Expr, Pat, TypeExpr, Stmt }
import ./types.vibe { Type, TypeDef, TypeEnv, env_bind, types_equal }
import ./checker.vibe { check_expr }

let empty_defs = () -> Array[TypeDef] {
  array_slice([TDAlias("_dummy", CtUnit)], 0, 0)
}

test "literal int" {
  let ty = check_expr(EInt(42), EnvEmpty, empty_defs())
  assert(types_equal(ty, CtInt))
}

test "literal string" {
  let ty = check_expr(EString("hello"), EnvEmpty, empty_defs())
  assert(types_equal(ty, CtString))
}

test "literal bool" {
  let ty = check_expr(EBool(true), EnvEmpty, empty_defs())
  assert(types_equal(ty, CtBool))
}

test "literal float" {
  let ty = check_expr(EFloat(3.14), EnvEmpty, empty_defs())
  assert(types_equal(ty, CtDouble))
}

test "unit" {
  let ty = check_expr(EUnit, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtUnit))
}

test "ident from env" {
  let env = env_bind(EnvEmpty, "x", CtInt)
  let ty = check_expr(EIdent("x"), env, empty_defs())
  assert(types_equal(ty, CtInt))
}

test "ident builtin" {
  let ty = check_expr(EIdent("string_concat"), EnvEmpty, empty_defs())
  assert(types_equal(ty, CtFn([CtString, CtString], CtString, false)))
}

test "ident unknown" {
  let ty = check_expr(EIdent("nonexistent"), EnvEmpty, empty_defs())
  assert(types_equal(ty, CtUnknown))
}

test "let binding" {
  let expr = ELet("x", EInt(1), EIdent("x"))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtInt))
}

test "seq returns last" {
  let expr = ESeq(EInt(1), EString("hello"))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtString))
}

test "if returns then type" {
  let expr = EIf(EBool(true), EInt(42), EInt(0))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtInt))
}

test "binop comparison" {
  let expr = EBinOp("==", EInt(1), EInt(2))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtBool))
}

test "binop arithmetic" {
  let expr = EBinOp("+", EInt(1), EInt(2))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtInt))
}

test "unary not" {
  let expr = EUnaryOp("!", EBool(true))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtBool))
}

test "call returns fn return type" {
  let env = env_bind(EnvEmpty, "f", CtFn([CtInt], CtString, false))
  let expr = ECall(EIdent("f"), [EInt(42)])
  let ty = check_expr(expr, env, empty_defs())
  assert(types_equal(ty, CtString))
}

test "while returns unit" {
  let expr = EWhile(EBool(true), EInt(1))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtUnit))
}

test "for-in returns array" {
  let env = env_bind(EnvEmpty, "xs", CtArray(CtInt))
  let expr = EForIn("x", EIdent("xs"), EString("a"))
  let ty = check_expr(expr, env, empty_defs())
  assert(types_equal(ty, CtArray(CtString)))
}

test "match returns first arm type" {
  let expr = EMatch(EInt(1), [(PInt(1), EString("one")), (PWild, EString("other"))])
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtString))
}

test "pipe returns fn return type" {
  let env = env_bind(EnvEmpty, "f", CtFn([CtInt], CtString, false))
  let expr = EPipe(EInt(42), EIdent("f"))
  let ty = check_expr(expr, env, empty_defs())
  assert(types_equal(ty, CtString))
}

test "fn typed param binds in body" {
  let empty_params = array_slice([CtUnknown], 0, 0)
  let expr = EFn([("x", Some(TyName("Int")))], None, None, EIdent("x"))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtFn(empty_params, CtInt, false)))
}

test "fn untyped param stays unknown" {
  let empty_params = array_slice([CtUnknown], 0, 0)
  let expr = EFn([("x", None)], None, None, EIdent("x"))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtFn(empty_params, CtUnknown, false)))
}

test "fn multiple params typed" {
  let empty_params = array_slice([CtUnknown], 0, 0)
  let body = EBinOp("+", EIdent("x"), EInt(1))
  let expr = EFn([("x", Some(TyName("Int"))), ("y", Some(TyName("String")))], None, None, body)
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtFn(empty_params, CtInt, false)))
}

test "fn with effect flag" {
  let empty_params = array_slice([CtUnknown], 0, 0)
  let expr = EFn([("x", None)], None, Some("Error"), EInt(1))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtFn(empty_params, CtInt, true)))
}

test "fn without effect flag" {
  let empty_params = array_slice([CtUnknown], 0, 0)
  let expr = EFn([("x", None)], None, None, EInt(1))
  let ty = check_expr(expr, EnvEmpty, empty_defs())
  assert(types_equal(ty, CtFn(empty_params, CtInt, false)))
}
