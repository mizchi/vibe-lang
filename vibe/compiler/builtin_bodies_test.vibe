//# Imports

import ./codegen / builtin_bodies / bodies_core_a1a1_str_eq.vibe {
  gen_str_eq_body
}

import ./codegen / builtin_bodies / bodies_core_a1a2.vibe {
  gen_arr_get_body, gen_arr_len_body, gen_str_len_body
}

import ./codegen / builtin_bodies / bodies_core_b.vibe {
  static_arr_get_body, static_arr_len_body, static_str_eq_body, static_str_len_body
}

//# Functions

let rec bytes_equal = (left: Bytes, right: Bytes, i: Int) -> Bool {
  if i >= Bytes::length(left) {
    true
  } else if Bytes::get(left, i) != Bytes::get(right, i) {
    false
  } else {
    bytes_equal(left, right, i + 1)
  }
}

let expect_same_bytes = (left: Bytes, right: Bytes) -> Unit {
  assert(Bytes::length(left) == Bytes::length(right))
  assert(bytes_equal(left, right, 0))
}

//# Misc

test "static str_eq body matches generated body" {
  expect_same_bytes(static_str_eq_body(), gen_str_eq_body())
}

test "static arr_len body matches generated body" {
  expect_same_bytes(static_arr_len_body(), gen_arr_len_body())
}

test "static arr_get body matches generated body" {
  expect_same_bytes(static_arr_get_body(), gen_arr_get_body())
}

test "static str_len body matches generated body" {
  expect_same_bytes(static_str_len_body(), gen_str_len_body())
}
