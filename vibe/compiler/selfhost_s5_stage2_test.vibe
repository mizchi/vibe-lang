//# Imports

import ./index.vibe {
  selfbuild_compile_stage2
}

//# Misc

test "S5: write stage2.wasm via selfbuild" {
  let bytes = selfbuild_compile_stage2()
  Fs::write_bytes("_build/bench/selfhost_wasi_selfbuild/index_stage2.wasm", bytes)
  assert(bytes[0] == 0)
  assert(bytes[1] == 97)
  assert(bytes[2] == 115)
  assert(bytes[3] == 109)
  assert(Bytes::length(bytes) > 64)
}
