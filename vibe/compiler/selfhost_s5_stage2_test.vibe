//# Imports

import ./codegen.vibe {
  compile_wasi_module
}

import ./selfhost_s5_test_support.vibe {
  load_selfhost_merged
}

//# Tests

test "S5: write stage2.wasm via selfbuild" {
  let bytes = compile_wasi_module(load_selfhost_merged(), "selfbuild_entry")
  Fs::write_bytes("_build/bench/selfhost_wasi_selfbuild/index_stage2.wasm", bytes)
  assert(Bytes::length(bytes) > 300000)
}
