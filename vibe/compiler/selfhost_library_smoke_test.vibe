//# Imports

import ../collection/maps.vibe {
  get, has_key
}

import ../json/index.vibe {
  Json, json_as_num, parse, stringify
}

import ../prelude/result.vibe {
  Result
}

import ../sha1/sha1.vibe {
  sha1
}

import ../x/base64/index.vibe {
  decode, encode
}

import ../x/fmt/index.vibe {
  format, i, join, s
}

import ../x/semver/semver.vibe {
  Semver, Semver::major, Semver::minor, Semver::patch, Semver::to_string, bump_minor
}

//# Misc

test "selfhost library smoke: base64 and sha1" {
  let payload = "selfhost libraries"
  assert(decode(encode(payload)) == payload)
  assert(sha1("abc") == "a9993e364706816aba3e25717850c26c9cd0d89d")
}

test "selfhost library smoke: fmt and collection maps" {
  let title = format("{} #{}", [
    s("case"),
    i(7)
  ])
  assert(title == "case #7")
  assert(join([
    "a",
    "b",
    "c"
  ], ":") == "a:b:c")
  let m: Map[String, Int] = map {
    "a": 1,
    "b": 2
  }
  assert(has_key(m, "b"))
  match get(m, "b") {
    Some(v) => assert(v == 2),
    None => assert(false)
  }
}

test "selfhost library smoke: json stringify" {
  let encoded = stringify(JArr([
    JNum(1.0),
    JStr("two"),
    JBool(true)
  ]))
  assert(encoded == "[1,\"two\",true]")
}

test "selfhost library smoke: json parse" {
  match parse("1.25e2") {
    Result::Ok((json_value, _)) =>
    match json_as_num(json_value) {
      Result::Ok(value) => assert(value == 125.0),
      Result::Err(_) => assert(false)
    },
    Result::Err(_) => assert(false)
  }
}

test "selfhost library smoke: semver fully qualified method" {
  let stable = Semver(1, 2, 3, "")
  assert(Semver::major(stable) == 1)
  assert(Semver::minor(stable) == 2)
  assert(Semver::patch(stable) == 3)
  assert(Semver::to_string(bump_minor(stable)) == "1.3.0")
}
