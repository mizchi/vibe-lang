test "tuple destructuring basic" {
  let t = ("hello", "world")
  let (a, b) = t
  assert(string_equals(a, "hello"))
  assert(string_equals(b, "world"))
}

test "tuple destructuring from array" {
  let arr = [("path1", "source1"), ("path2", "source2")]
  let (_, src) = array_get(arr, 0)
  assert(string_equals(src, "source1"))
}

test "tuple destructuring underscore skip" {
  let arr = [("path1", "source1")]
  let (p, s) = array_get(arr, 0)
  assert(string_equals(p, "path1"))
  assert(string_equals(s, "source1"))
}
