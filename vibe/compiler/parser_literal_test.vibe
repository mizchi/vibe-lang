//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse array" {
  let result = handle {
    parse_print("[1, 2, 3]")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "[1, 2, 3]"))
}

test "parse tuple" {
  let result = handle {
    parse_print("(1, 2)")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1, 2)"))
}

test "parse unit" {
  let result = handle {
    parse_print("()")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "()"))
}
