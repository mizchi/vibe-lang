//# Imports

import ./codegen_test_support.vibe {
  assert_wasm, compile_wasi, compile_wasi_gc
}

//# Misc

test "gc: Bytes::from_array and Bytes::to_array" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::from_array([10, 20, 30])\n  let arr = Bytes::to_array(bytes)\n  Array::get(arr, 1)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: Bytes::push append concat slice" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::new()\n  Bytes::push(bytes, 65)\n  Bytes::append(bytes, Bytes::from_array([66, 67]))\n  let merged = Bytes::concat(bytes, Bytes::from_array([68]))\n  let sliced = Bytes::slice(merged, 1, 4)\n  Bytes::get(sliced, 1)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: Bytes index and slice syntax" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::from_array([65, 66, 67, 68])\n  let sliced = bytes[1:4]\n  sliced[1]\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: Bytes slice to end syntax" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::from_array([65, 66, 67, 68])\n  let sliced = bytes[1:]\n  sliced[2]\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: Bytes::blit and Bytes::fill" {
  let source = "let main = () -> Int {\n  let dst = Bytes::new()\n  Bytes::fill(dst, 65, 2)\n  Bytes::blit(dst, Bytes::from_array([66, 67, 68]), 1, 3)\n  Bytes::get(dst, 3)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "wasi: Bytes::from_array length get" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::from_array([10, 20, 30])\n  if Bytes::length(bytes) == 3 { Bytes::get(bytes, 1) } else { 0 }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Bytes::push append concat slice" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::new()\n  Bytes::push(bytes, 65)\n  Bytes::append(bytes, Bytes::from_array([66, 67]))\n  let merged = Bytes::concat(bytes, Bytes::from_array([68]))\n  let sliced = Bytes::slice(merged, 1, 4)\n  Bytes::get(sliced, 1)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Bytes index and slice syntax" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::from_array([65, 66, 67, 68])\n  let sliced = bytes[1:4]\n  sliced[1]\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Bytes slice to end syntax" {
  let source = "let main = () -> Int {\n  let bytes = Bytes::from_array([65, 66, 67, 68])\n  let sliced = bytes[1:]\n  sliced[2]\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}
