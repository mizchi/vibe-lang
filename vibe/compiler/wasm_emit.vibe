export let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {
  bytebuf_push(buf, 96)
  leb128_encode_u32(buf, param_count)
  let mut i = 0
  while i < param_count {
    bytebuf_push(buf, 126)
    i = i + 1
  }
  leb128_encode_u32(buf, result_count)
  let mut j = 0
  while j < result_count {
    bytebuf_push(buf, 126)
    j = j + 1
  }
}

