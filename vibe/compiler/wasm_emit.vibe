//# Imports

import ./bytebuf.vibe {
  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32
}

//# Functions

export let emit_br = (buf: Array[Int], label: Int) -> Unit {
  bytebuf_push(buf, 12)
  leb128_encode_u32(buf, label)
}

export let emit_end = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 11)
}

export let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {
  bytebuf_push(buf, 16)
  leb128_encode_u32(buf, func_idx)
}

export let emit_drop = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 26)
}

export let emit_else = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 5)
}

export let emit_name = (buf: Array[Int], name: String) -> Unit {
  let name_len = String::length(name)
  leb128_encode_u32(buf, name_len)
  let mut i = 0
  while i < name_len {
    bytebuf_push(buf, String::char_code_at(name, i))
    i = i + 1
  }
}

export let emit_br_if = (buf: Array[Int], label: Int) -> Unit {
  bytebuf_push(buf, 13)
  leb128_encode_u32(buf, label)
}

export let emit_f64_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 97)
}

export let emit_f64_ge = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 102)
}

export let emit_f64_gt = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 100)
}

export let emit_f64_le = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 101)
}

export let emit_f64_lt = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 99)
}

export let emit_f64_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 98)
}

export let emit_header = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 97)
  bytebuf_push(buf, 115)
  bytebuf_push(buf, 109)
  bytebuf_push(buf, 1)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
}

export let emit_i64_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 81)
}

export let emit_i64_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 82)
}

export let emit_i64_or = (buf: Array[Int]) -> Unit {
