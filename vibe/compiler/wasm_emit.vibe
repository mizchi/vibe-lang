// WASM binary emitter — generates minimal valid .wasm modules
// Uses bytebuf.vibe for byte-level binary construction

import ./bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes,
  bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

// === Emit helpers ===

// Emit WASM magic number and version
export let emit_header = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 97)   // 'a'
  bytebuf_push(buf, 115)  // 's'
  bytebuf_push(buf, 109)  // 'm'
  bytebuf_push(buf, 1)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
}

// Encode a function type: (i64 x param_count) -> (i64 x result_count)
export let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {
  bytebuf_push(buf, 96)  // 0x60 = func type marker
  leb128_encode_u32(buf, param_count)
  let mut i = 0
  while i < param_count {
    bytebuf_push(buf, 126)  // i64
    i = i + 1
  }
  leb128_encode_u32(buf, result_count)
  let mut j = 0
  while j < result_count {
    bytebuf_push(buf, 126)  // i64
    j = j + 1
  }
}

// Emit type section with multiple function types
// type_defs: flat array of [param_count, result_count, param_count, result_count, ...]
export let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {
  let count = array_length(type_defs) / 2
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_func_type(content, array_get(type_defs, i * 2), array_get(type_defs, (i * 2) + 1))
    i = i + 1
  }
  bytebuf_push_section(out, 1, content)
}

// Emit type section with a single function type (convenience)
export let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {
  emit_type_section_multi(out, [param_count, result_count])
}

// Emit function section — maps function indices to type indices
export let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, array_length(type_indices))
  let mut i = 0
  while i < array_length(type_indices) {
    leb128_encode_u32(content, array_get(type_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 3, content)
}

// Helper: emit a name string (length-prefixed ASCII)
export let emit_name = (buf: Array[Int], name: String) -> Unit {
  let name_len = string_length(name)
  leb128_encode_u32(buf, name_len)
  let mut i = 0
  while i < name_len {
    bytebuf_push(buf, string_char_code_at(name, i))
    i = i + 1
  }
}

// Emit export section with multiple exports
// names: array of export names, func_indices: matching array of function indices
export let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {
  let count = array_length(names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_name(content, array_get(names, i))
    bytebuf_push(content, 0)  // export kind: function
    leb128_encode_u32(content, array_get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 7, content)
}

// Emit export section — single export (convenience)
export let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {
  emit_export_section_multi(out, [name], [func_idx])
}

// Emit memory section: 1 memory with min pages, no max
export let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 memory
  bytebuf_push(content, 0)  // limits: no max
  leb128_encode_u32(content, min_pages)
  bytebuf_push_section(out, 5, content)
}

// Emit a code section with function bodies
// Each body is pre-encoded instructions (without end opcode)
export let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, array_length(bodies))
  let mut i = 0
  while i < array_length(bodies) {
    let body = array_get(bodies, i)
    let func_buf = bytebuf_new()
    leb128_encode_u32(func_buf, 0)  // 0 local declarations
    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)  // end opcode
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_array(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}

// Emit code section with local declarations
// local_decls: array of [count, valtype] pairs per function (flat)
// For now: emit one block of count locals of type i64
export let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, array_length(bodies))
  let mut i = 0
  while i < array_length(bodies) {
    let body = array_get(bodies, i)
    let num_locals = array_get(local_counts, i)
    let func_buf = bytebuf_new()
    if num_locals == 0 {
      leb128_encode_u32(func_buf, 0)  // 0 local decl blocks
    } else {
      leb128_encode_u32(func_buf, 1)  // 1 local decl block
      leb128_encode_u32(func_buf, num_locals)
      bytebuf_push(func_buf, 126)  // i64
    }
    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)  // end
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_array(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}

// === Instruction emitters ===

export let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 32)  // local.get
  leb128_encode_u32(buf, idx)
}

export let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 33)  // local.set
  leb128_encode_u32(buf, idx)
}

export let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 34)  // local.tee
  leb128_encode_u32(buf, idx)
}

export let emit_i64_const = (buf: Array[Int], value: Int) -> Unit {
  bytebuf_push(buf, 66)  // i64.const
  leb128_encode_s64(buf, value)
}

export let emit_i64_add = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 124)
}

export let emit_i64_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 125)
}

export let emit_i64_mul = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 126)
}

export let emit_i64_div_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 127)
}

export let emit_i64_rem_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 129)  // 0x81
}

export let emit_i64_and = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 131)  // 0x83
}

export let emit_i64_or = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 132)  // 0x84
}

export let emit_i64_xor = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 133)  // 0x85
}

export let emit_i64_shl = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 134)  // 0x86
}

export let emit_i64_shr_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 135)  // 0x87
}

export let emit_i64_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 81)  // 0x51
}

export let emit_i64_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 82)  // 0x52
}

export let emit_i64_lt_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 83)  // 0x53
}

export let emit_i64_gt_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 85)  // 0x55
}

export let emit_i64_le_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 87)  // 0x57
}

export let emit_i64_ge_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 89)  // 0x59
}

export let emit_i64_eqz = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 80)  // 0x50
}

export let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {
  bytebuf_push(buf, 16)  // call
  leb128_encode_u32(buf, func_idx)
}

export let emit_drop = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 26)  // drop
}

export let emit_return = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 15)  // return
}

// Control flow: block types
// 0x40 = void block, 0x7E = i64 block
export let emit_block_void = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 2)   // block
  bytebuf_push(buf, 64)  // 0x40 = void
}

export let emit_block_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 2)   // block
  bytebuf_push(buf, 126) // 0x7E = i64
}

export let emit_loop_void = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 3)   // loop
  bytebuf_push(buf, 64)  // void
}

export let emit_if_void = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 4)   // if
  bytebuf_push(buf, 64)  // void
}

export let emit_if_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 4)   // if
  bytebuf_push(buf, 126) // i64
}

export let emit_else = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 5)   // else
}

export let emit_end = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 11)  // end
}

export let emit_br = (buf: Array[Int], label: Int) -> Unit {
  bytebuf_push(buf, 12)  // br
  leb128_encode_u32(buf, label)
}

export let emit_br_if = (buf: Array[Int], label: Int) -> Unit {
  bytebuf_push(buf, 13)  // br_if
  leb128_encode_u32(buf, label)
}

// i64.extend_i32_s — extend i32 comparison result to i64
export let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 172)  // 0xAC
}

// i32.wrap_i64 — truncate i64 to i32
export let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 167)  // 0xA7
}

// === i32 instructions (needed for WASI APIs) ===

export let emit_i32_const = (buf: Array[Int], value: Int) -> Unit {
  bytebuf_push(buf, 65)  // i32.const
  leb128_encode_s64(buf, value)  // sleb128 works for i32 too
}

export let emit_i32_add = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 106)  // 0x6A
}

export let emit_i32_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 54)  // 0x36 i32.store
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_i32_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 40)  // 0x28 i32.load
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 58)  // 0x3A i32.store8
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 45)  // 0x2D i32.load8_u
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

// === Section emitters: Import, Data, Global ===

// Emit raw func type with explicit valtype arrays
// param_types/result_types: arrays of valtype ints (126=i64, 127=i32)
export let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {
  bytebuf_push(buf, 96)  // 0x60
  leb128_encode_u32(buf, array_length(param_types))
  let mut i = 0
  while i < array_length(param_types) {
    bytebuf_push(buf, array_get(param_types, i))
    i = i + 1
  }
  leb128_encode_u32(buf, array_length(result_types))
  let mut j = 0
  while j < array_length(result_types) {
    bytebuf_push(buf, array_get(result_types, j))
    j = j + 1
  }
}

// Emit import section: import a function
// module_name, field_name: import path, type_idx: type index
export let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 import
  emit_name(content, module_name)
  emit_name(content, field_name)
  bytebuf_push(content, 0)  // import kind: function
  leb128_encode_u32(content, type_idx)
  bytebuf_push_section(out, 2, content)  // section id 2 = import
}

// Emit data section: place byte data at a memory offset
// segments: array of [offset, data_buf] pairs
export let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 data segment
  // Active data segment: memory index 0
  bytebuf_push(content, 0)  // flags: active, memory 0
  // Offset expression: i32.const <offset>, end
  emit_i32_const(content, offset)
  emit_end(content)
  // Data bytes
  leb128_encode_u32(content, array_length(data))
  bytebuf_push_array(content, data)
  bytebuf_push_section(out, 11, content)  // section id 11 = data
}

// Emit global section: one mutable i32 global with initial value
export let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)  // 1 global
  bytebuf_push(content, 127)  // i32
  bytebuf_push(content, 1)    // mutable
  emit_i32_const(content, init_value)
  emit_end(content)
  bytebuf_push_section(out, 6, content)  // section id 6 = global
}

export let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 35)  // global.get
  leb128_encode_u32(buf, idx)
}

export let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 36)  // global.set
  leb128_encode_u32(buf, idx)
}

// Emit export for memory
export let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, name)
  bytebuf_push(content, 2)  // export kind: memory
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, 7, content)
}

// Emit combined export section: functions + optional memory
export let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {
  let count = array_length(fn_names) + 1
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  // Function exports
  let mut i = 0
  while i < array_length(fn_names) {
    emit_name(content, array_get(fn_names, i))
    bytebuf_push(content, 0)  // function
    leb128_encode_u32(content, array_get(fn_indices, i))
    i = i + 1
  }
  // Memory export
  emit_name(content, mem_name)
  bytebuf_push(content, 2)  // memory
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, 7, content)
}

// === High-level: build a complete module ===

// Build a minimal WASM module with one exported function: add(i64, i64) -> i64
export let build_add_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, [0])
  emit_export_section(out, "add", 0)
  let body = bytebuf_new()
  emit_local_get(body, 0)
  emit_local_get(body, 1)
  emit_i64_add(body)
  emit_code_section(out, [body])
  bytebuf_to_bytes(out)
}

// Build a module with internal call: square(x) = x*x, sum_sq(a,b) = square(a) + square(b)
export let build_call_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // 2 types: type0 = (i64) -> (i64), type1 = (i64, i64) -> (i64)
  emit_type_section_multi(out, [1, 1, 2, 1])

  // 2 functions: func0=square(type0), func1=sum_sq(type1)
  emit_function_section(out, [0, 1])

  // export both
  emit_export_section_multi(out, ["square", "sum_sq"], [0, 1])

  // square: x * x
  let sq_body = bytebuf_new()
  emit_local_get(sq_body, 0)
  emit_local_get(sq_body, 0)
  emit_i64_mul(sq_body)

  // sum_sq: square(a) + square(b)
  let ss_body = bytebuf_new()
  emit_local_get(ss_body, 0)
  emit_call(ss_body, 0)  // call square
  emit_local_get(ss_body, 1)
  emit_call(ss_body, 0)  // call square
  emit_i64_add(ss_body)

  emit_code_section(out, [sq_body, ss_body])
  bytebuf_to_bytes(out)
}

// Build a module with add, sub, mul exported (all using same type: (i64, i64) -> i64)
export let build_arithmetic_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // 1 type: (i64, i64) -> (i64)
  emit_type_section(out, 2, 1)

  // 3 functions, all type 0
  emit_function_section(out, [0, 0, 0])

  // 3 exports
  emit_export_section_multi(out, ["add", "sub", "mul"], [0, 1, 2])

  // 3 function bodies
  let add_body = bytebuf_new()
  emit_local_get(add_body, 0)
  emit_local_get(add_body, 1)
  emit_i64_add(add_body)

  let sub_body = bytebuf_new()
  emit_local_get(sub_body, 0)
  emit_local_get(sub_body, 1)
  emit_i64_sub(sub_body)

  let mul_body = bytebuf_new()
  emit_local_get(mul_body, 0)
  emit_local_get(mul_body, 1)
  emit_i64_mul(mul_body)

  emit_code_section(out, [add_body, sub_body, mul_body])
  bytebuf_to_bytes(out)
}

// Build fibonacci module: fib(n) iterative
// params: n (local 0)
// locals: a (local 1), b (local 2), tmp (local 3)
// Algorithm: a=0, b=1, while(n>0) { tmp=a+b; a=b; b=tmp; n=n-1 }; return a
export let build_fibonacci_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // type0: (i64) -> (i64)
  emit_type_section(out, 1, 1)
  emit_function_section(out, [0])
  emit_export_section(out, "fib", 0)

  let b = bytebuf_new()
  // local 0 = n (param), locals 1=a, 2=b, 3=tmp

  // a = 0
  emit_i64_const(b, 0)
  emit_local_set(b, 1)
  // b = 1
  emit_i64_const(b, 1)
  emit_local_set(b, 2)

  // block $break
  emit_block_void(b)
    // loop $continue
    emit_loop_void(b)
      // if n <= 0, break
      emit_local_get(b, 0)
      emit_i64_const(b, 0)
      emit_i64_le_s(b)
      emit_br_if(b, 1)  // br $break (label 1 = outer block)

      // tmp = a + b
      emit_local_get(b, 1)
      emit_local_get(b, 2)
      emit_i64_add(b)
      emit_local_set(b, 3)
      // a = b
      emit_local_get(b, 2)
      emit_local_set(b, 1)
      // b = tmp
      emit_local_get(b, 3)
      emit_local_set(b, 2)
      // n = n - 1
      emit_local_get(b, 0)
      emit_i64_const(b, 1)
      emit_i64_sub(b)
      emit_local_set(b, 0)

      // br $continue (label 0 = loop)
      emit_br(b, 0)
    emit_end(b)  // end loop
  emit_end(b)    // end block

  // return a
  emit_local_get(b, 1)

  emit_code_section_with_locals(out, [b], [3])
  bytebuf_to_bytes(out)
}

// Build factorial module: fact(n) iterative
// params: n (local 0), locals: result (local 1)
// Algorithm: result=1, while(n>1) { result=result*n; n=n-1 }; return result
export let build_factorial_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  emit_type_section(out, 1, 1)
  emit_function_section(out, [0])
  emit_export_section(out, "fact", 0)

  let b = bytebuf_new()
  // result = 1
  emit_i64_const(b, 1)
  emit_local_set(b, 1)

  // block $break
  emit_block_void(b)
    // loop $continue
    emit_loop_void(b)
      // if n <= 1, break
      emit_local_get(b, 0)
      emit_i64_const(b, 1)
      emit_i64_le_s(b)
      emit_br_if(b, 1)

      // result = result * n
      emit_local_get(b, 1)
      emit_local_get(b, 0)
      emit_i64_mul(b)
      emit_local_set(b, 1)

      // n = n - 1
      emit_local_get(b, 0)
      emit_i64_const(b, 1)
      emit_i64_sub(b)
      emit_local_set(b, 0)

      emit_br(b, 0)
    emit_end(b)
  emit_end(b)

  // return result
  emit_local_get(b, 1)

  emit_code_section_with_locals(out, [b], [1])
  bytebuf_to_bytes(out)
}

// Build a WASI hello world module
// Imports fd_write from wasi_snapshot_preview1, writes "hello world\n" to stdout
export let build_hello_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // Type section:
  //   type0: fd_write(i32, i32, i32, i32) -> i32
  //   type1: _start() -> void
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])
  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))
  bytebuf_push_section(out, 1, type_content)

  // Import section: fd_write from wasi_snapshot_preview1 (func index 0)
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)

  // Function section: _start is func index 1 (after 1 import), type 1
  emit_function_section(out, [1])

  // Memory section: 1 page
  emit_memory_section(out, 1)

  // Export section: _start + memory
  emit_exports_with_memory(out, ["_start"], [1], "memory", 0)

  // Code section: _start body (must come before data section)
  // Setup iovec at memory[0]: {ptr=8, len=12}
  // Then call fd_write(1, 0, 1, 100)
  //   fd=1 (stdout), iovs_ptr=0, iovs_count=1, nwritten_ptr=100
  let b = bytebuf_new()

  // mem[0] = 8 (iovec.buf pointer)
  emit_i32_const(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)

  // mem[4] = 12 (iovec.buf_len)
  emit_i32_const(b, 4)
  emit_i32_const(b, 12)
  emit_i32_store(b, 2, 0)

  // call fd_write(1, 0, 1, 100)
  emit_i32_const(b, 1)    // fd = stdout
  emit_i32_const(b, 0)    // iovs ptr
  emit_i32_const(b, 1)    // iovs count
  emit_i32_const(b, 100)  // nwritten ptr
  emit_call(b, 0)         // call fd_write (import index 0)
  emit_drop(b)            // discard return value

  emit_code_section(out, [b])

  // Data section: "hello world\n" at offset 8
  let hello_data = bytebuf_new()
  bytebuf_push(hello_data, 104)  // h
  bytebuf_push(hello_data, 101)  // e
  bytebuf_push(hello_data, 108)  // l
  bytebuf_push(hello_data, 108)  // l
  bytebuf_push(hello_data, 111)  // o
  bytebuf_push(hello_data, 32)   // ' '
  bytebuf_push(hello_data, 119)  // w
  bytebuf_push(hello_data, 111)  // o
  bytebuf_push(hello_data, 114)  // r
  bytebuf_push(hello_data, 108)  // l
  bytebuf_push(hello_data, 100)  // d
  bytebuf_push(hello_data, 10)   // \n
  emit_data_section(out, 8, hello_data)

  bytebuf_to_bytes(out)
}

// === String data helpers ===

// Convert a string to a byte array (ASCII only)
export let string_to_data = (s: String) -> Array[Int] {
  let buf = bytebuf_new()
  let len = string_length(s)
  let mut i = 0
  while i < len {
    bytebuf_push(buf, string_char_code_at(s, i))
    i = i + 1
  }
  buf
}

// Emit data section with multiple segments
export let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {
  let count = array_length(offsets)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    bytebuf_push(content, 0)  // active, memory 0
    emit_i32_const(content, array_get(offsets, i))
    emit_end(content)
    let data = array_get(datas, i)
    leb128_encode_u32(content, array_length(data))
    bytebuf_push_array(content, data)
    i = i + 1
  }
  bytebuf_push_section(out, 11, content)
}

// Build a WASI module that prints a custom string
export let build_print_string_module = (msg: String) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)

  // Types: fd_write(i32,i32,i32,i32)->i32, _start()->void
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])
  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))
  bytebuf_push_section(out, 1, type_content)

  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  emit_function_section(out, [1])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, ["_start"], [1], "memory", 0)

  // String data at offset 16 (leave 0-15 for iovec + nwritten)
  let str_data = string_to_data(msg)
  let str_len = array_length(str_data)

  // Code: setup iovec and call fd_write
  let b = bytebuf_new()
  // iovec[0].buf = 16
  emit_i32_const(b, 0)
  emit_i32_const(b, 16)
  emit_i32_store(b, 2, 0)
  // iovec[0].len = str_len
  emit_i32_const(b, 4)
  emit_i32_const(b, str_len)
  emit_i32_store(b, 2, 0)
  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)

  emit_code_section(out, [b])
  emit_data_section(out, 16, str_data)
  bytebuf_to_bytes(out)
}
