}

export let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 32)
  leb128_encode_u32(buf, idx)
}

export let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 33)
  leb128_encode_u32(buf, idx)
