export let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 34)
  leb128_encode_u32(buf, idx)
}

export let emit_loop_void = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 3)
  bytebuf_push(buf, 64)
}

export let string_to_data = (s: String) -> Array[Int] {
  let buf = bytebuf_new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    bytebuf_push(buf, String::char_code_at(s, i))
    i = i + 1
  }
  buf
}

export let emit_block_void = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 2)
  bytebuf_push(buf, 64)
}

export let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 35)
  leb128_encode_u32(buf, idx)
}

export let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {
  bytebuf_push(buf, 36)
  leb128_encode_u32(buf, idx)
}

export let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 58)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_struct_get = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {
  bytebuf_push(buf, 251)
  leb128_encode_u32(buf, 2)
  leb128_encode_u32(buf, type_idx)
  leb128_encode_u32(buf, field_idx)
}

export let emit_struct_new = (buf: Array[Int], type_idx: Int) -> Unit {
  bytebuf_push(buf, 251)
  leb128_encode_u32(buf, 0)
  leb128_encode_u32(buf, type_idx)
}

export let emit_struct_set = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {
  bytebuf_push(buf, 251)
  leb128_encode_u32(buf, 5)
  leb128_encode_u32(buf, type_idx)
  leb128_encode_u32(buf, field_idx)
}

export let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 45)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let func_buf = bytebuf_new()
    leb128_encode_u32(func_buf, 0)
    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_array(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}

export let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  emit_i32_const(content, offset)
  emit_end(content)
  leb128_encode_u32(content, Array::length(data))
  bytebuf_push_array(content, data)
  bytebuf_push_section(out, 11, content)
}

export let emit_exports_full = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {
  let count = Array::length(fn_names) + 1 + Array::length(global_names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, 0)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  emit_name(content, mem_name)
  bytebuf_push(content, 2)
  leb128_encode_u32(content, mem_idx)
  let mut gi = 0
  while gi < Array::length(global_names) {
    emit_name(content, Array::get(global_names, gi))
    bytebuf_push(content, 3)
    leb128_encode_u32(content, Array::get(global_indices, gi))
    gi = gi + 1
  }
  bytebuf_push_section(out, 7, content)
}

export let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 167)
}

export let emit_call_indirect = (buf: Array[Int], type_idx: Int) -> Unit {
  bytebuf_push(buf, 17)
  leb128_encode_u32(buf, type_idx)
  bytebuf_push(buf, 0)
}

export let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, name)
  bytebuf_push(content, 2)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, 7, content)
}

export let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {
  bytebuf_push(buf, 96)
  leb128_encode_u32(buf, Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    bytebuf_push(buf, Array::get(param_types, i))
    i = i + 1
  }
  leb128_encode_u32(buf, Array::length(result_types))
  let mut j = 0
  while j < Array::length(result_types) {
    bytebuf_push(buf, Array::get(result_types, j))
    j = j + 1
  }
}

export let emit_f64_const_bits = (buf: Array[Int], bits: Int) -> Unit {
  bytebuf_push(buf, 68)
  bytebuf_push(buf, bits&255)
  bytebuf_push(buf, (bits>>8)&255)
  bytebuf_push(buf, (bits>>16)&255)
  bytebuf_push(buf, (bits>>24)&255)
  bytebuf_push(buf, (bits>>32)&255)
  bytebuf_push(buf, (bits>>40)&255)
  bytebuf_push(buf, (bits>>48)&255)
  bytebuf_push(buf, (bits>>56)&255)
}

export let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, min_pages)
  bytebuf_push_section(out, 5, content)
}

export let emit_i64_trunc_f64_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 176)
}

export let emit_struct_type_raw = (buf: Array[Int], field_types: Array[Int], field_muts: Array[Int]) -> Unit {
  bytebuf_push(buf, 95)
  leb128_encode_u32(buf, Array::length(field_types))
  let mut i = 0
  while i < Array::length(field_types) {
    bytebuf_push(buf, Array::get(field_types, i))
    bytebuf_push(buf, Array::get(field_muts, i))
    i = i + 1
  }
}

export let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(type_indices))
  let mut i = 0
  while i < Array::length(type_indices) {
    leb128_encode_u32(content, Array::get(type_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 3, content)
}

export let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 172)
}

export let emit_f64_convert_i64_s = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 185)
}

export let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {
  let count = Array::length(offsets)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    bytebuf_push(content, 0)
    emit_i32_const(content, Array::get(offsets, i))
    emit_end(content)
    let data = Array::get(datas, i)
    leb128_encode_u32(content, Array::length(data))
    bytebuf_push_array(content, data)
    i = i + 1
  }
  bytebuf_push_section(out, 11, content)
}

export let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {
  let count = Array::length(type_defs) / 2
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))
    i = i + 1
  }
  bytebuf_push_section(out, 1, content)
}

export let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {
  emit_type_section_multi(out, [
    param_count,
    result_count
  ])
}

export let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {
  let count = Array::length(fn_names) + 1
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, 0)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  emit_name(content, mem_name)
  bytebuf_push(content, 2)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, 7, content)
}

export let emit_f64_reinterpret_i64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 191)
}

export let emit_i64_reinterpret_f64 = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 189)
}

export let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, module_name)
  emit_name(content, field_name)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, type_idx)
  bytebuf_push_section(out, 2, content)
}

export let build_hello_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, 1, type_content)
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  emit_function_section(out, [
    1
  ])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, [
    "_start"
  ], [
    1
  ], "memory", 0)
  let b = bytebuf_new()
  emit_i32_const(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 12)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 100)
  emit_call(b, 0)
  emit_drop(b)
  emit_code_section(out, [
    b
  ])
  let hello_data = bytebuf_new()
  bytebuf_push(hello_data, 104)
  bytebuf_push(hello_data, 101)
  bytebuf_push(hello_data, 108)
  bytebuf_push(hello_data, 108)
  bytebuf_push(hello_data, 111)
  bytebuf_push(hello_data, 32)
  bytebuf_push(hello_data, 119)
  bytebuf_push(hello_data, 111)
  bytebuf_push(hello_data, 114)
  bytebuf_push(hello_data, 108)
  bytebuf_push(hello_data, 100)
  bytebuf_push(hello_data, 10)
  emit_data_section(out, 8, hello_data)
  bytebuf_to_bytes(out)
}

export let build_print_string_module = (msg: String) -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, 1, type_content)
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  emit_function_section(out, [
    1
  ])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, [
    "_start"
  ], [
    1
  ], "memory", 0)
  let str_data = string_to_data(msg)
  let str_len = Array::length(str_data)
  let b = bytebuf_new()
  emit_i32_const(b, 0)
  emit_i32_const(b, 16)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, str_len)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  emit_code_section(out, [
    b
  ])
  emit_data_section(out, 16, str_data)
  bytebuf_to_bytes(out)
}

export let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {
  let count = Array::length(names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, 0)
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 7, content)
}

export let build_call_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section_multi(out, [
    1,
    1,
    2,
    1
  ])
  emit_function_section(out, [
    0,
    1
  ])
  emit_export_section_multi(out, [
    "square",
    "sum_sq"
  ], [
    0,
    1
  ])
  let sq_body = bytebuf_new()
  emit_local_get(sq_body, 0)
  emit_local_get(sq_body, 0)
  emit_i64_mul(sq_body)
  let ss_body = bytebuf_new()
  emit_local_get(ss_body, 0)
  emit_call(ss_body, 0)
  emit_local_get(ss_body, 1)
  emit_call(ss_body, 0)
  emit_i64_add(ss_body)
  emit_code_section(out, [
    sq_body,
    ss_body
  ])
  bytebuf_to_bytes(out)
}

export let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {
  emit_export_section_multi(out, [
    name
  ], [
    func_idx
  ])
}

export let build_add_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "add", 0)
  let body = bytebuf_new()
  emit_local_get(body, 0)
  emit_local_get(body, 1)
  emit_i64_add(body)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

export let build_arithmetic_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, [
    0,
    0,
    0
  ])
  emit_export_section_multi(out, [
    "add",
    "sub",
    "mul"
  ], [
    0,
    1,
    2
  ])
  let add_body = bytebuf_new()
  emit_local_get(add_body, 0)
  emit_local_get(add_body, 1)
  emit_i64_add(add_body)
  let sub_body = bytebuf_new()
  emit_local_get(sub_body, 0)
  emit_local_get(sub_body, 1)
  emit_i64_sub(sub_body)
  let mul_body = bytebuf_new()
  emit_local_get(mul_body, 0)
  emit_local_get(mul_body, 1)
  emit_i64_mul(mul_body)
  emit_code_section(out, [
    add_body,
    sub_body,
    mul_body
  ])
  bytebuf_to_bytes(out)
}

export let emit_table_section_funcref = (out: Array[Int], num_entries: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 112)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, num_entries)
  bytebuf_push_section(out, 4, content)
}

export let emit_element_section_active = (out: Array[Int], func_indices: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  emit_i32_const(content, 0)
  emit_end(content)
  leb128_encode_u32(content, Array::length(func_indices))
  let mut i = 0
  while i < Array::length(func_indices) {
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 9, content)
}

export let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 127)
  bytebuf_push(content, 1)
  emit_i32_const(content, init_value)
  emit_end(content)
  bytebuf_push_section(out, 6, content)
}

export let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let num_locals = Array::get(local_counts, i)
    let func_buf = bytebuf_new()
    if num_locals == 0 {
      leb128_encode_u32(func_buf, 0)
    } else {
      leb128_encode_u32(func_buf, 1)
      leb128_encode_u32(func_buf, num_locals)
      bytebuf_push(func_buf, 126)
    }
    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_array(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}

export let build_factorial_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 1, 1)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "fact", 0)
  let b = bytebuf_new()
  emit_i64_const(b, 1)
  emit_local_set(b, 1)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 1)
  emit_i64_le_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 1)
  emit_local_get(b, 0)
  emit_i64_mul(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, 0)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_code_section_with_locals(out, [
    b
  ], [
    1
  ])
  bytebuf_to_bytes(out)
}

export let build_fibonacci_module = () -> Bytes {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 1, 1)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "fib", 0)
  let b = bytebuf_new()
  emit_i64_const(b, 0)
  emit_local_set(b, 1)
  emit_i64_const(b, 1)
  emit_local_set(b, 2)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_le_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 1)
  emit_local_get(b, 2)
  emit_i64_add(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_set(b, 1)
  emit_local_get(b, 3)
  emit_local_set(b, 2)
  emit_local_get(b, 0)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, 0)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_code_section_with_locals(out, [
    b
  ], [
    3
  ])
  bytebuf_to_bytes(out)
}
