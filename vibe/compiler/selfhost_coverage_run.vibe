//# Imports

import ./index.vibe {
  compiler_lex, compiler_parse, compiler_parse_program, compiler_print_expr, compiler_print_program, token_to_string
}

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

let expr_tokens = compiler_lex("1 + 2 * 3")
let expr_ast = compiler_parse(expr_tokens)
let expr_text = compiler_print_expr(expr_ast)

let prog_tokens = compiler_lex("let x = 1\nlet y = x + 2")
let prog_ast = compiler_parse_program(prog_tokens)
let prog_text = compiler_print_program(prog_ast)

let first_tok = array_get(expr_tokens, 0)
let first_tok_name = token_to_string(first_tok)
let eval_text = run_and_lookup("let result = 40 + 2", "result")
let eval_match_text = run_and_lookup("export enum Value {\n  VInt(Int);\n  VString(String);\n  VBool(Bool);\n  VUnit\n}\nlet v = VInt(42)\nlet result = match v {\n  VInt(n) => n,\n  _ => 0\n}", "result")
let eval_handle_text = run_and_lookup("let result = handle { throw(\"oops\") } { Error(msg) => msg }", "result")
let eval_loop_text = run_and_lookup("let mut i = 0\nwhile true {\n  i = i + 1\n  if i == 5 {\n    break\n  }\n}\nlet result = i", "result")
let eval_array_builder_text = run_and_lookup("let b = array_builder()\nlet mut i = 0\nwhile i < 3 { array_builder_push(b, i); i = i + 1 }\nlet result = array_builder_freeze(b)", "result")

let import_sources = [
  ("main.vibe", "import ./vals.vibe { Val, VInt, VStr, val_to_str }\nlet v = VInt(77)\nlet result = val_to_str(v)"),
  ("vals.vibe", "export enum Val {\n  VInt(Int);\n  VStr(String)\n}\nexport let val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s\n  }\n}")
]
let eval_import_text = run_with_imports(import_sources, "main.vibe", "result")

let import_sources_3file = [
  ("main.vibe", "import ./i.vibe { ev }\nimport ./a.vibe { E, N, A }\nlet result = ev(A(N(3), N(4)))"),
  ("a.vibe", "export enum E { N(Int); A(E, E) }"),
  ("i.vibe", "import ./a.vibe { E, N, A }\nexport let rec ev = (e: E) -> Int {\n  match e { N(n) => n, A(l, r) => ev(l) + ev(r) }\n}")
]
let eval_import_3file_text = run_with_imports(import_sources_3file, "main.vibe", "result")

let coverage_selfhost_checksum =
  string_length(expr_text) +
  string_length(prog_text) +
  string_length(first_tok_name) +
  string_length(eval_text) +
  string_length(eval_match_text) +
  string_length(eval_handle_text) +
  string_length(eval_loop_text) +
  string_length(eval_array_builder_text) +
  string_length(eval_import_text) +
  string_length(eval_import_3file_text)

let _keep = coverage_selfhost_checksum
