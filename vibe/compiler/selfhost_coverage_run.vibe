//# Imports

import ./eval_stmt_test_support.vibe {
  run_source, run_source_with_imports
}

import ./index.vibe {
  compiler_lex, compiler_parse, compiler_parse_program, compiler_print_expr, compiler_print_program, token_to_string
}

//# Functions

let eval_text = run_source("let result = 40 + 2", "result")

let expr_tokens = compiler_lex("1 + 2 * 3")

let expr_ast = compiler_parse(expr_tokens)

let expr_text = compiler_print_expr(expr_ast)

let first_tok = Array::get(expr_tokens, 0)

let prog_tokens = compiler_lex("let x = 1\nlet y = x + 2")

let prog_ast = compiler_parse_program(prog_tokens)

let prog_text = compiler_print_program(prog_ast)

let eval_call_text = run_source("let inc = (x) -> x + 1\nlet result = inc(5)", "result")

let eval_loop_text = run_source("let mut i = 0\nwhile true {\n  i = i + 1\n  if i == 5 {\n    break\n  }\n}\nlet result = i", "result")

let first_tok_name = token_to_string(first_tok)

let import_sources = [
  ("main.vibe", "import ./vals.vibe { Val, VInt, VStr, val_to_str }\nlet v = VInt(77)\nlet result = val_to_str(v)"),
  ("vals.vibe", "export enum Val {\n  VInt(Int);\n  VStr(String)\n}\nexport let val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s\n  }\n}")
]

let eval_match_text = run_source("export enum Value {\n  VInt(Int);\n  VString(String);\n  VBool(Bool);\n  VUnit\n}\nlet v = VInt(42)\nlet result = match v {\n  VInt(n) => n,\n  _ => 0\n}", "result")

let eval_handle_text = run_source("let result = handle { throw(\"oops\") } { Error(msg) => msg }", "result")

let eval_import_text = run_source_with_imports(import_sources, "main.vibe", "result")

let eval_for_map_text = run_source("let doubled = for x in [1, 2, 3] { x * 2 }\nlet result = Array::get(doubled, 1)", "result")

let eval_if_else_text = run_source("let x = if true { 10 } else { 20 }\nlet result = x", "result")

let eval_continue_text = run_source("let mut sum = 0\nlet mut i = 0\nwhile i < 5 {\n  i = i + 1\n  if i == 3 {\n    continue\n  }\n  sum = sum + i\n}\nlet result = sum", "result")

let eval_throw_fn_text = run_source("let fail = (msg: String) -> Int with {Error} { throw(msg) }\nlet result = handle { fail(\"bad\") } { Error(msg) => msg }", "result")

let eval_ends_with_text = run_source("let p1 = \"foo.vibe\"\nlet p2 = \"bar.txt\"\nlet r1 = String::ends_with(p1, \".vibe\")\nlet r2 = String::ends_with(p2, \".vibe\")\nlet result = if r1 { if r2 { \"bad\" } else { \"ok\" } } else { \"bad\" }", "result")

let eval_factorial_text = run_source("let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }\nlet result = fact(5)", "result")

let eval_substring_text = run_source("let path = \"dir/sub/file.vibe\"\nlet idx = String::last_index_of(path, \"/\")\nlet dir = path[0:idx]\nlet result = dir", "result")

let import_sources_3file = [
  ("main.vibe", "import ./i.vibe { ev }\nimport ./a.vibe { E, N, A }\nlet result = ev(A(N(3), N(4)))"),
  ("a.vibe", "export enum E { N(Int); A(E, E) }"),
  ("i.vibe", "import ./a.vibe { E, N, A }\nexport let rec ev = (e: E) -> Int {\n  match e { N(n) => n, A(l, r) => ev(l) + ev(r) }\n}")
]

let eval_break_value_text = run_source("let result = while true {\n  break 42\n}", "result")

let eval_token_array_text = run_source("enum Tok { TNum(Int); TPlus; TEof }\nlet toks = [TNum(3), TPlus, TNum(42), TEof]\nlet len = Array::length(toks)\nlet mut i = 0\nlet mut acc = 0\nwhile i < len { let t = Array::get(toks, i); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; i = i + 1 }\nlet result = acc", "result")

let eval_import_3file_text = run_source_with_imports(import_sources_3file, "main.vibe", "result")

let eval_number_parse_text = run_source("let s = \"123\"\nlet len = String::length(s)\nlet mut i = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); num = num * 10 + (c - 48); i = i + 1 }\nlet result = num", "result")

let eval_array_builder_text = run_source("let b = ArrayBuilder::new()\nlet mut i = 0\nwhile i < 3 { ArrayBuilder::push(b, i); i = i + 1 }\nlet result = ArrayBuilder::freeze(b)", "result")

let eval_char_classify_text = run_source("let is_digit = (c: Int) -> Bool { c >= 48 && c <= 57 }\nlet is_space = (c: Int) -> Bool { c == 32 }\nlet is_plus = (c: Int) -> Bool { c == 43 }\nlet r1 = is_digit(51)\nlet r2 = is_space(32)\nlet r3 = is_plus(43)\nlet result = if r1 { if r2 { if r3 { \"ok\" } else { \"bad3\" } } else { \"bad2\" } } else { \"bad1\" }", "result")

let eval_handle_passthrough_text = run_source("let result = handle { 42 } { Error(_) => 0 }", "result")

let import_sources_token_pipeline = [
  ("tok.vibe", "export enum Tok { TNum(Int); TPlus; TEof }"),
  ("lex.vibe", "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nexport let is_digit = (c: Int) -> Int { if c >= 48 && c <= 57 { 1 } else { 0 } }"),
  ("main.vibe", "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nimport ./lex.vibe { is_digit }\nlet s = \"7+8+5\"\nlet len = String::length(s)\nlet b = ArrayBuilder::new()\nlet mut i = 0\nlet mut mode = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); let d = is_digit(c); let act = mode * 2 + d; if act == 1 { mode = 1; num = c - 48; i = i + 1 } else { 0 }; if act == 3 { num = num * 10 + (c - 48); i = i + 1 } else { 0 }; if act == 2 { let tok = TNum(num); ArrayBuilder::push(b, tok); mode = 0; num = 0 } else { 0 }; if act == 0 && c == 43 { ArrayBuilder::push(b, TPlus); i = i + 1 } else { 0 }; if act == 0 && c != 43 { i = i + 1 } else { 0 } }\nlet flush = if mode == 1 { let tok = TNum(num); ArrayBuilder::push(b, tok) } else { 0 }\nArrayBuilder::push(b, TEof)\nlet toks = ArrayBuilder::freeze(b)\nlet tlen = Array::length(toks)\nlet mut j = 0\nlet mut acc = 0\nwhile j < tlen { let t = Array::get(toks, j); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; j = j + 1 }\nlet result = acc")
]

let eval_import_token_pipeline_text = run_source_with_imports(import_sources_token_pipeline, "main.vibe", "result")

let eval_recursive_value_to_string_text = run_source("export enum Val {\n  VInt(Int);\n  VStr(String);\n  VBool(Bool);\n  VUnit\n}\nlet rec val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s,\n    VBool(b) => if b { \"true\" } else { \"false\" },\n    VUnit => \"()\"\n  }\n}\nlet result = val_to_str(VInt(99))", "result")

// Additional coverage workloads — exercise more compiler branches (trimmed for compile time)

let eval_while_mutable_text = run_source("let f = () -> {\n  let mut i = 0\n  let mut acc = 0\n  while i < 5 { acc = acc + i; i = i + 1 }\n  acc\n}\nlet result = f()", "result")

let eval_hex_literal_text = run_source("let result = 0xFF", "result")

let eval_string_eq_text = run_source("let result = if \"hello\" == \"hello\" { 1 } else { 0 }", "result")

let eval_closure_text = run_source("let base = 100\nlet add = (x: Int) -> Int { x + base }\nlet result = add(42)", "result")

let eval_pipe_text = run_source("let double = (x: Int) -> Int { x * 2 }\nlet result = 5 |> double", "result")

let eval_struct_text = run_source("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 3, y: 4 }\nlet result = p.x + p.y", "result")

let eval_wildcard_match_text = run_source("enum V { A(Int); B(String); C }\nlet f = (v: V) -> Int {\n  match v { A(n) => n, _ => 0 }\n}\nlet result = f(A(42)) + f(B(\"x\")) + f(C)", "result")

let eval_for_in_text = run_source("let items = [10, 20, 30]\nlet doubled = for x in items { x * 2 }\nlet result = Array::get(doubled, 1)", "result")

let coverage_selfhost_checksum = String::length(expr_text) + String::length(prog_text) + String::length(first_tok_name) + String::length(eval_text) + String::length(eval_match_text) + String::length(eval_handle_text) + String::length(eval_handle_passthrough_text) + String::length(eval_loop_text) + String::length(eval_continue_text) + String::length(eval_break_value_text) + String::length(eval_throw_fn_text) + String::length(eval_call_text) + String::length(eval_factorial_text) + String::length(eval_for_map_text) + String::length(eval_if_else_text) + String::length(eval_recursive_value_to_string_text) + String::length(eval_substring_text) + String::length(eval_ends_with_text) + String::length(eval_char_classify_text) + String::length(eval_number_parse_text) + String::length(eval_array_builder_text) + String::length(eval_token_array_text) + String::length(eval_import_text) + String::length(eval_import_3file_text) + String::length(eval_import_token_pipeline_text) + String::length(eval_while_mutable_text) + String::length(eval_hex_literal_text) + String::length(eval_string_eq_text) + String::length(eval_closure_text) + String::length(eval_pipe_text) + String::length(eval_struct_text) + String::length(eval_wildcard_match_text) + String::length(eval_for_in_text)

let _keep = coverage_selfhost_checksum
