//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_stmt.vibe {
  check_program
}

import ./codegen.vibe {
  compile_module, compile_wasi_module
}

import ./lexer.vibe {
  lex
}

import ./module_loader.vibe {
  check_module, collect_all_sources_fs, collect_merged_stmts
}

import ./parser.vibe {
  parse_program
}

import ./types.vibe {
  Type, TypeEnv
}

//# Functions

export let compile_source = (source: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_module(stmts)
}

export let compile_file_fs = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {
  let sources = collect_all_sources_fs(entry_path)
  let main_source = Fs::read_file(entry_path)
  let checked_cache = Array::slice([
    ("", EnvEmpty)
  ], 0, 0)
  let empty_loading = Array::slice([
    ""
  ], 0, 0)
  let _ = check_module(main_source, entry_path, sources, empty_loading, checked_cache)
  let merged_stmts = collect_merged_stmts(sources)
  compile_wasi_module(merged_stmts, entry_name)
}

export let compile_source_wasi = (source: String, entry_name: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_wasi_module(stmts, entry_name)
}

export let compile_with_modules = (main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with { Error } {
  let checked_cache = Array::slice([
    ("", EnvEmpty)
  ], 0, 0)
  let empty_loading = Array::slice([
    ""
  ], 0, 0)
  let _ = check_module(main_source, main_path, sources, empty_loading, checked_cache)
  let tokens = lex(main_source)
  let stmts = parse_program(tokens)
  compile_module(stmts)
}

