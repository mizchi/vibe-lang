//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse call" {
  let result = handle {
    parse_print("f(1, 2)")
  } {
    Error(e) => "ERROR: \{e}"
  }
  assert(result == "f(1, 2)")
}

test "parse call no args" {
  let result = handle {
    parse_print("f()")
  } {
    Error(e) => "ERROR: \{e}"
  }
  assert(result == "f()")
}

test "parse dot" {
  let result = handle {
    parse_print("a.b.c")
  } {
    Error(e) => "ERROR: \{e}"
  }
  assert(result == "a.b.c")
}

test "parse namespace call" {
  let result = handle {
    parse_print("String::length(s)")
  } {
    Error(e) => "ERROR: \{e}"
  }
  assert(result == "String::length(s)")
}
