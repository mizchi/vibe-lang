//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse add" {
  let result = handle {
    parse_print("1 + 2")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1 + 2)"))
}

test "parse mul" {
  let result = handle {
    parse_print("3 * 4")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(3 * 4)"))
}

test "parse precedence" {
  let result = handle {
    parse_print("1 + 2 * 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(1 + (2 * 3))"))
}

test "parse left assoc" {
  let result = handle {
    parse_print("1 + 2 + 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((1 + 2) + 3)"))
}

test "parse parens" {
  let result = handle {
    parse_print("(1 + 2) * 3")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "((1 + 2) * 3)"))
}

test "parse unary minus" {
  let result = handle {
    parse_print("-1")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(-1)"))
}

test "parse unary not" {
  let result = handle {
    parse_print("!x")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "(!x)"))
}
