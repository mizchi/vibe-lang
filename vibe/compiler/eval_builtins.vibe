//# Imports

import ./values.vibe {
  Value, value_to_string
}

//# Functions

let empty_values = () -> Array[Value] {
  Array::slice([
    VUnit
  ], 0, 0)
}

let empty_record_fields = () -> Array[(String, Value)] {
  Array::slice([
    ("", VUnit)
  ], 0, 0)
}

let rec map_find_index = (fields: Array[(String, Value)], key: String, i: Int) -> Int {
  if i >= Array::length(fields) {
    -1
  }
  else {
    let (field_name, _) = Array::get(fields, i)
    if field_name == key {
      i
    }
    else {
      map_find_index(fields, key, i + 1)
    }
  }
}

let map_get_value = (fields: Array[(String, Value)], key: String) -> Value {
  let idx = map_find_index(fields, key, 0)
  if idx < 0 {
    VUnit
  }
  else {
    let (_, value) = Array::get(fields, idx)
    value
  }
}

let map_has_key = (fields: Array[(String, Value)], key: String) -> Bool {
  map_find_index(fields, key, 0) >= 0
}

let map_keys = (fields: Array[(String, Value)]) -> Array[Value] {
  let out = empty_values()
  let mut i = 0
  while i < Array::length(fields) {
    let (key, _) = Array::get(fields, i)
    Array::push(out, VString(key))
    i = i + 1
  }
  out
}

let map_set_value = (fields: Array[(String, Value)], key: String, value: Value) -> Array[(String, Value)] {
  let idx = map_find_index(fields, key, 0)
  if idx < 0 {
    Array::concat(fields, [
      (key, value)
    ])
  }
  else {
    let before = Array::slice(fields, 0, idx)
    let after = Array::slice(fields, idx + 1, Array::length(fields))
    Array::concat(Array::concat(before, [
      (key, value)
    ]), after)
  }
}

let eval_array = (name: String, args: Array[Value]) -> Option[Value] {
  if name == "Array::length" {
    let arr = Array::get(args, 0)
    match arr {
      VArray(elems) => Some(VInt(Array::length(elems))),
      _ => Some(VInt(0))
    }
  }
  else if name == "Array::get" {
    let arr = Array::get(args, 0)
    let idx = Array::get(args, 1)
    match arr {
      VArray(elems) => match idx {
        VInt(i) => Some(Array::get(elems, i)),
        _ => Some(VUnit)
      },
      _ => Some(VUnit)
    }
  }
  else if name == "Array::slice" {
    let arr = Array::get(args, 0)
    let start_v = Array::get(args, 1)
    let end_v = Array::get(args, 2)
    match arr {
      VArray(elems) => match start_v {
        VInt(s) => match end_v {
          VInt(e) => Some(VArray(Array::slice(elems, s, e))),
          _ => Some(VArray(elems))
        },
        _ => Some(VArray(elems))
      },
      _ => Some(VUnit)
    }
  }
  else if name == "Array::concat" {
    let arr1 = Array::get(args, 0)
    let arr2 = Array::get(args, 1)
    match arr1 {
      VArray(e1) => match arr2 {
        VArray(e2) => Some(VArray(Array::concat(e1, e2))),
        _ => Some(VArray(e1))
      },
      _ => Some(VUnit)
    }
  }
  else None
}

let eval_bytes = (name: String, args: Array[Value]) -> Option[Value] {
  if name == "Bytes::new" {
    Some(VBytes(Array::slice([
      0
    ], 0, 0)))
  }
  else if name == "Bytes::length" {
    let b = Array::get(args, 0)
    match b {
      VBytes(data) => Some(VInt(Array::length(data))),
      _ => Some(VInt(0))
    }
  }
  else if name == "Bytes::get" {
    let b = Array::get(args, 0)
    let idx = Array::get(args, 1)
    match b {
      VBytes(data) => match idx {
        VInt(i) => Some(VInt(Array::get(data, i))),
        _ => Some(VInt(0))
      },
      _ => Some(VInt(0))
    }
  }
  else if name == "Bytes::set" {
    Some(VUnit)
  }
  else if name == "Bytes::push" {
    Some(VUnit)
  }
  else if name == "Bytes::concat" {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VBytes(da) => match b {
        VBytes(db) => Some(VBytes(Array::concat(da, db))),
        _ => Some(VBytes(da))
      },
      _ => Some(VBytes(Array::slice([
        0
      ], 0, 0)))
    }
  }
  else if name == "Bytes::slice" {
    let b = Array::get(args, 0)
    let start_v = Array::get(args, 1)
    let end_v = Array::get(args, 2)
    match b {
      VBytes(data) => match start_v {
        VInt(s) => match end_v {
          VInt(e) => Some(VBytes(Array::slice(data, s, e))),
          _ => Some(VBytes(data))
        },
        _ => Some(VBytes(data))
      },
      _ => Some(VBytes(Array::slice([
        0
      ], 0, 0)))
    }
  }
  else if name == "Bytes::from_array" {
    let arr = Array::get(args, 0)
    match arr {
      VArray(elems) => {
        let len = Array::length(elems)
        let result = for elem in elems {
          match elem {
            VInt(n) => n,
            _ => 0
          }
        }
        Some(VBytes(result))
      },
      _ => Some(VBytes(Array::slice([
        0
      ], 0, 0)))
    }
  }
  else if name == "Bytes::to_array" {
    let b = Array::get(args, 0)
    match b {
      VBytes(data) => {
        let result = for d in data {
          VInt(d)
        }
        Some(VArray(result))
      },
      _ => Some(VArray(Array::slice([
        VUnit
      ], 0, 0)))
    }
  }
  else None
}

let eval_string = (name: String, args: Array[Value]) -> Option[Value] {
  if name == "String::concat" {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VString(sa) => match b {
        VString(sb) => Some(VString(String::concat(sa, sb))),
        _ => Some(VString(sa))
      },
      _ => Some(VString(""))
    }
  }
  else if name == "String::length" {
    let s = Array::get(args, 0)
    match s {
      VString(sv) => Some(VInt(String::length(sv))),
      _ => Some(VInt(0))
    }
  }
  else if name == "String::equals" {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VString(sa) => match b {
        VString(sb) => Some(VBool(sa == sb)),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if name == "String::from_char_code" {
    let code = Array::get(args, 0)
    match code {
      VInt(c) => Some(VString(String::from_char_code(c))),
      _ => Some(VString(""))
    }
  }
  else if name == "String::char_code_at" {
    let s = Array::get(args, 0)
    let idx = Array::get(args, 1)
    match s {
      VString(sv) => match idx {
        VInt(i) => Some(VInt(String::char_code_at(sv, i))),
        _ => Some(VInt(0))
      },
      _ => Some(VInt(0))
    }
  }
  else if name == "String::substring" {
    let s = Array::get(args, 0)
    let start = Array::get(args, 1)
    let end_v = Array::get(args, 2)
    match s {
      VString(sv) => match start {
        VInt(si) => match end_v {
          VInt(ei) => Some(VString(sv[si:ei])),
          _ => Some(VString(sv))
        },
        _ => Some(VString(sv))
      },
      _ => Some(VString(""))
    }
  }
  else if name == "String::index_of" {
    let s = Array::get(args, 0)
    let sub = Array::get(args, 1)
    match s {
      VString(sv) => match sub {
        VString(subv) => Some(VInt(String::index_of(sv, subv))),
        _ => Some(VInt(-1))
      },
      _ => Some(VInt(-1))
    }
  }
  else if name == "String::last_index_of" {
    let s = Array::get(args, 0)
    let sub = Array::get(args, 1)
    match s {
      VString(sv) => match sub {
        VString(subv) => Some(VInt(String::last_index_of(sv, subv))),
        _ => Some(VInt(-1))
      },
      _ => Some(VInt(-1))
    }
  }
  else if name == "String::starts_with" {
    let s = Array::get(args, 0)
    let prefix = Array::get(args, 1)
    match s {
      VString(sv) => match prefix {
        VString(pv) => Some(VBool(String::starts_with(sv, pv))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if name == "String::ends_with" {
    let s = Array::get(args, 0)
    let suffix = Array::get(args, 1)
    match s {
      VString(sv) => match suffix {
        VString(sfx) => Some(VBool(String::ends_with(sv, sfx))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else None
}

let eval_arithmetic_alias = (name: String, args: Array[Value]) -> Option[Value] {
  let op = if name == "add" {
    Some("+")
  }
  else if name == "sub" {
    Some("-")
  }
  else if name == "mul" {
    Some("*")
  }
  else if name == "div" {
    Some("/")
  }
  else if name == "mod" {
    Some("%")
  }
  else None
  match op {
    Some(op) => {
      let lhs = Array::get(args, 0)
      let rhs = Array::get(args, 1)
      if String::equals(op, "+") {
        match lhs {
          VInt(a) => match rhs {
            VInt(b) => Some(VInt(a + b)),
            _ => Some(VUnit)
          },
          VFloat(a) => match rhs {
            VFloat(b) => Some(VFloat(a + b)),
            _ => Some(VUnit)
          },
          VString(a) => match rhs {
            VString(b) => Some(VString(String::concat(a, b))),
            _ => Some(VUnit)
          },
          _ => Some(VUnit)
        }
      }
      else if String::equals(op, "-") {
        match lhs {
          VInt(a) => match rhs {
            VInt(b) => Some(VInt(a - b)),
            _ => Some(VUnit)
          },
          VFloat(a) => match rhs {
            VFloat(b) => Some(VFloat(a - b)),
            _ => Some(VUnit)
          },
          _ => Some(VUnit)
        }
      }
      else if String::equals(op, "*") {
        match lhs {
          VInt(a) => match rhs {
            VInt(b) => Some(VInt(a * b)),
            _ => Some(VUnit)
          },
          VFloat(a) => match rhs {
            VFloat(b) => Some(VFloat(a * b)),
            _ => Some(VUnit)
          },
          _ => Some(VUnit)
        }
      }
      else if String::equals(op, "/") {
        match lhs {
          VInt(a) => match rhs {
            VInt(b) => Some(VInt(a / b)),
            _ => Some(VUnit)
          },
          VFloat(a) => match rhs {
            VFloat(b) => Some(VFloat(a / b)),
            _ => Some(VUnit)
          },
          _ => Some(VUnit)
        }
      }
      else {
        match lhs {
          VInt(a) => match rhs {
            VInt(b) => Some(VInt(a % b)),
            _ => Some(VUnit)
          },
          _ => Some(VUnit)
        }
      }
    },
    None => None
  }
}

let eval_misc = (name: String, args: Array[Value]) -> Option[Value] {
  match eval_arithmetic_alias(name, args) {
    Some(v) => Some(v),
    None => if name == "eq" {
      let a = Array::get(args, 0)
      let b = Array::get(args, 1)
      match a {
        VInt(ai) => match b {
          VInt(bi) => Some(VBool(eq(ai, bi))),
          _ => Some(VBool(false))
        },
        _ => Some(VBool(false))
      }
    }
    else if name == "not" {
      let a = Array::get(args, 0)
      match a {
        VBool(bv) => Some(VBool(not(bv))),
        _ => Some(VBool(false))
      }
    }
    else if name == "__to_string" || name == "to_string" {
      let a = Array::get(args, 0)
      Some(VString(value_to_string(a)))
    }
    else if name == "print" {
      Some(VUnit)
    }
    else if name == "println" {
      Some(VUnit)
    }
    else if name == "sh" {
      Some(VUnit)
    }
    else if name == "assert" {
      let a = Array::get(args, 0)
      match a {
        VBool(bv) => {
          assert(bv)
          Some(VUnit)
        },
        _ => Some(VUnit)
      }
    }
    else if name == "Int::to_double" {
      let a = Array::get(args, 0)
      match a {
        VInt(n) => Some(VFloat(Int::to_double(n))),
        _ => Some(VFloat(0.0))
      }
    }
    else if name == "Double::to_int" {
      let a = Array::get(args, 0)
      match a {
        VFloat(f) => Some(VInt(Double::to_int(f))),
        _ => Some(VInt(0))
      }
    }
    else if name == "Double::to_i64_bits" {
      let a = Array::get(args, 0)
      match a {
        VFloat(f) => Some(VInt(Double::to_i64_bits(f))),
        _ => Some(VInt(0))
      }
    }
    else if name == "Double::from_i64_bits" {
      let a = Array::get(args, 0)
      match a {
        VInt(n) => Some(VFloat(Double::from_i64_bits(n))),
        _ => Some(VFloat(0.0))
      }
    }
    else if name == "__index" {
      let container = Array::get(args, 0)
      let idx = Array::get(args, 1)
      match container {
        VArray(elems) => match idx {
          VInt(i) => Some(Array::get(elems, i)),
          _ => Some(VUnit)
        },
        VString(s) => match idx {
          VInt(i) => Some(VString(String::substring(s, i, i + 1))),
          _ => Some(VUnit)
        },
        _ => Some(VUnit)
      }
    }
    else if name == "__slice" {
      let container = Array::get(args, 0)
      let start_v = Array::get(args, 1)
      let end_v = Array::get(args, 2)
      match container {
        VArray(elems) => match start_v {
          VInt(s) => match end_v {
            VInt(e) => Some(VArray(Array::slice(elems, s, e))),
            _ => Some(VArray(elems))
          },
          _ => Some(VArray(elems))
        },
        VString(s) => match start_v {
          VInt(s_idx) => match end_v {
            VInt(e_idx) => Some(VString(String::substring(s, s_idx, e_idx))),
            _ => Some(VString(s))
          },
          _ => Some(VString(s))
        },
        _ => Some(VUnit)
      }
    }
    else if name == "Map::get" {
      let map_v = Array::get(args, 0)
      let key_v = Array::get(args, 1)
      match map_v {
        VRecord(fields) => match key_v {
          VString(key) => Some(map_get_value(fields, key)),
          _ => Some(VUnit)
        },
        _ => Some(VUnit)
      }
    }
    else if name == "map_has" || name == "Map::has_key" {
      let map_v = Array::get(args, 0)
      let key_v = Array::get(args, 1)
      match map_v {
        VRecord(fields) => match key_v {
          VString(key) => Some(VBool(map_has_key(fields, key))),
          _ => Some(VBool(false))
        },
        _ => Some(VBool(false))
      }
    }
    else if name == "Map::keys" {
      let map_v = Array::get(args, 0)
      match map_v {
        VRecord(fields) => Some(VArray(map_keys(fields))),
        _ => Some(VArray(empty_values()))
      }
    }
    else if name == "Map::set" {
      let map_v = Array::get(args, 0)
      let key_v = Array::get(args, 1)
      let value_v = Array::get(args, 2)
      match map_v {
        VRecord(fields) => match key_v {
          VString(key) => Some(VRecord(map_set_value(fields, key, value_v))),
          _ => Some(VRecord(fields))
        },
        _ => match key_v {
          VString(key) => Some(VRecord([
            (key, value_v)
          ])),
          _ => Some(VRecord(empty_record_fields()))
        }
      }
    }
    else if name == "ArrayBuilder::new" {
      Some(VUnit)
    }
    else if name == "ArrayBuilder::push" {
      Some(VUnit)
    }
    else if name == "ArrayBuilder::freeze" {
      Some(VUnit)
    }
    else None
  }
}

export let eval_builtin_call = (name: String, args: Array[Value]) -> Option[Value] {
  match eval_array(name, args) {
    Some(v) => Some(v),
    None => match eval_string(name, args) {
      Some(v) => Some(v),
      None => match eval_bytes(name, args) {
        Some(v) => Some(v),
        None => eval_misc(name, args)
      }
    }
  }
}
