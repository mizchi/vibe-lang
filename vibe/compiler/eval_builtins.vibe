import ./values.vibe { Value, value_to_string }

//# Builtin function evaluation for interpreter

// Use anchor to prevent unused-import silent failure
let _anchor_val = (v: Value) -> Value { v }

let eval_array = (name: String, args: Array[Value]) -> Option[Value] {
  if string_equals(name, "array_length") {
    let arr = array_get(args, 0)
    match arr {
      VArray(elems) => Some(VInt(array_length(elems))),
      _ => Some(VInt(0))
    }
  }
  else if string_equals(name, "array_get") {
    let arr = array_get(args, 0)
    let idx = array_get(args, 1)
    match arr {
      VArray(elems) => match idx {
        VInt(i) => Some(array_get(elems, i)),
        _ => Some(VUnit)
      },
      _ => Some(VUnit)
    }
  }
  else if string_equals(name, "array_slice") {
    let arr = array_get(args, 0)
    let start_v = array_get(args, 1)
    let end_v = array_get(args, 2)
    match arr {
      VArray(elems) => match start_v {
        VInt(s) => match end_v {
          VInt(e) => Some(VArray(array_slice(elems, s, e))),
          _ => Some(VArray(elems))
        },
        _ => Some(VArray(elems))
      },
      _ => Some(VUnit)
    }
  }
  else if string_equals(name, "array_concat") {
    let arr1 = array_get(args, 0)
    let arr2 = array_get(args, 1)
    match arr1 {
      VArray(e1) => match arr2 {
        VArray(e2) => Some(VArray(array_concat(e1, e2))),
        _ => Some(VArray(e1))
      },
      _ => Some(VUnit)
    }
  }
  else None
}

let eval_string = (name: String, args: Array[Value]) -> Option[Value] {
  if string_equals(name, "string_concat") {
    let a = array_get(args, 0)
    let b = array_get(args, 1)
    match a {
      VString(sa) => match b {
        VString(sb) => Some(VString(string_concat(sa, sb))),
        _ => Some(VString(sa))
      },
      _ => Some(VString(""))
    }
  }
  else if string_equals(name, "string_length") {
    let s = array_get(args, 0)
    match s {
      VString(sv) => Some(VInt(string_length(sv))),
      _ => Some(VInt(0))
    }
  }
  else if string_equals(name, "string_equals") {
    let a = array_get(args, 0)
    let b = array_get(args, 1)
    match a {
      VString(sa) => match b {
        VString(sb) => Some(VBool(string_equals(sa, sb))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if string_equals(name, "string_from_char_code") {
    let code = array_get(args, 0)
    match code {
      VInt(c) => Some(VString(string_from_char_code(c))),
      _ => Some(VString(""))
    }
  }
  else if string_equals(name, "string_char_code_at") {
    let s = array_get(args, 0)
    let idx = array_get(args, 1)
    match s {
      VString(sv) => match idx {
        VInt(i) => Some(VInt(string_char_code_at(sv, i))),
        _ => Some(VInt(0))
      },
      _ => Some(VInt(0))
    }
  }
  else if string_equals(name, "string_substring") {
    let s = array_get(args, 0)
    let start = array_get(args, 1)
    let end_v = array_get(args, 2)
    match s {
      VString(sv) => match start {
        VInt(si) => match end_v {
          VInt(ei) => Some(VString(string_substring(sv, si, ei))),
          _ => Some(VString(sv))
        },
        _ => Some(VString(sv))
      },
      _ => Some(VString(""))
    }
  }
  else if string_equals(name, "string_index_of") {
    let s = array_get(args, 0)
    let sub = array_get(args, 1)
    match s {
      VString(sv) => match sub {
        VString(subv) => Some(VInt(string_index_of(sv, subv))),
        _ => Some(VInt(-1))
      },
      _ => Some(VInt(-1))
    }
  }
  else if string_equals(name, "string_last_index_of") {
    let s = array_get(args, 0)
    let sub = array_get(args, 1)
    match s {
      VString(sv) => match sub {
        VString(subv) => Some(VInt(string_last_index_of(sv, subv))),
        _ => Some(VInt(-1))
      },
      _ => Some(VInt(-1))
    }
  }
  else if string_equals(name, "string_starts_with") {
    let s = array_get(args, 0)
    let prefix = array_get(args, 1)
    match s {
      VString(sv) => match prefix {
        VString(pv) => Some(VBool(string_starts_with(sv, pv))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if string_equals(name, "string_ends_with") {
    let s = array_get(args, 0)
    let suffix = array_get(args, 1)
    match s {
      VString(sv) => match suffix {
        VString(sfx) => Some(VBool(string_ends_with(sv, sfx))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else None
}

let eval_misc = (name: String, args: Array[Value]) -> Option[Value] {
  if string_equals(name, "eq") {
    let a = array_get(args, 0)
    let b = array_get(args, 1)
    match a {
      VInt(ai) => match b {
        VInt(bi) => Some(VBool(eq(ai, bi))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if string_equals(name, "not") {
    let a = array_get(args, 0)
    match a {
      VBool(bv) => Some(VBool(not(bv))),
      _ => Some(VBool(false))
    }
  }
  else if string_equals(name, "__to_string") {
    let a = array_get(args, 0)
    Some(VString(value_to_string(a)))
  }
  else if string_equals(name, "print") {
    Some(VUnit)
  }
  else if string_equals(name, "println") {
    Some(VUnit)
  }
  else if string_equals(name, "assert") {
    let a = array_get(args, 0)
    match a {
      VBool(bv) => {
        assert(bv)
        Some(VUnit)
      },
      _ => Some(VUnit)
    }
  }
  else if string_equals(name, "int_to_double") {
    let a = array_get(args, 0)
    match a {
      VInt(n) => Some(VFloat(int_to_double(n))),
      _ => Some(VFloat(0.0))
    }
  }
  else if string_equals(name, "array_builder") {
    // handled in eval.vibe
    Some(VUnit)
  }
  else if string_equals(name, "array_builder_push") {
    // handled in eval.vibe
    Some(VUnit)
  }
  else if string_equals(name, "array_builder_freeze") {
    // handled in eval.vibe
    Some(VUnit)
  }
  else None
}

let eval_bytes = (name: String, args: Array[Value]) -> Option[Value] {
  if string_equals(name, "bytes_new") {
    Some(VBytes(array_slice([0], 0, 0)))
  }
  else if string_equals(name, "bytes_length") {
    let b = array_get(args, 0)
    match b {
      VBytes(data) => Some(VInt(array_length(data))),
      _ => Some(VInt(0))
    }
  }
  else if string_equals(name, "bytes_get") {
    let b = array_get(args, 0)
    let idx = array_get(args, 1)
    match b {
      VBytes(data) => match idx {
        VInt(i) => Some(VInt(array_get(data, i))),
        _ => Some(VInt(0))
      },
      _ => Some(VInt(0))
    }
  }
  else if string_equals(name, "bytes_set") {
    // stub: array mutation not available in vibe
    Some(VUnit)
  }
  else if string_equals(name, "bytes_push") {
    // stub: array mutation not available in vibe
    Some(VUnit)
  }
  else if string_equals(name, "bytes_concat") {
    let a = array_get(args, 0)
    let b = array_get(args, 1)
    match a {
      VBytes(da) => match b {
        VBytes(db) => Some(VBytes(array_concat(da, db))),
        _ => Some(VBytes(da))
      },
      _ => Some(VBytes(array_slice([0], 0, 0)))
    }
  }
  else if string_equals(name, "bytes_slice") {
    let b = array_get(args, 0)
    let start_v = array_get(args, 1)
    let end_v = array_get(args, 2)
    match b {
      VBytes(data) => match start_v {
        VInt(s) => match end_v {
          VInt(e) => Some(VBytes(array_slice(data, s, e))),
          _ => Some(VBytes(data))
        },
        _ => Some(VBytes(data))
      },
      _ => Some(VBytes(array_slice([0], 0, 0)))
    }
  }
  else if string_equals(name, "bytes_from_array") {
    let arr = array_get(args, 0)
    match arr {
      VArray(elems) => {
        let len = array_length(elems)
        let result = for elem in elems {
          match elem {
            VInt(n) => n,
            _ => 0
          }
        }
        Some(VBytes(result))
      },
      _ => Some(VBytes(array_slice([0], 0, 0)))
    }
  }
  else if string_equals(name, "bytes_to_array") {
    let b = array_get(args, 0)
    match b {
      VBytes(data) => {
        let result = for d in data {
          VInt(d)
        }
        Some(VArray(result))
      },
      _ => Some(VArray(array_slice([VUnit], 0, 0)))
    }
  }
  else None
}

export let eval_builtin_call = (name: String, args: Array[Value]) -> Option[Value] {
  match eval_array(name, args) {
    Some(v) => Some(v),
    None => match eval_string(name, args) {
      Some(v) => Some(v),
      None => match eval_bytes(name, args) {
        Some(v) => Some(v),
        None => eval_misc(name, args)
      }
    }
  }
}
