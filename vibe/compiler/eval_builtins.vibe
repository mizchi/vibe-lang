//# Imports

import ./values.vibe {
  Value, value_to_string
}

//# Functions

let eval_misc = (name: String, args: Array[Value]) -> Option[Value] {
  if String::equals(name, "eq") {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VInt(ai) => match b {
        VInt(bi) => Some(VBool(eq(ai, bi))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if String::equals(name, "not") {
    let a = Array::get(args, 0)
    match a {
      VBool(bv) => Some(VBool(not(bv))),
      _ => Some(VBool(false))
    }
  }
  else if String::equals(name, "__to_string") {
    let a = Array::get(args, 0)
    Some(VString(value_to_string(a)))
  }
  else if String::equals(name, "print") {
    Some(VUnit)
  }
  else if String::equals(name, "println") {
    Some(VUnit)
  }
  else if String::equals(name, "assert") {
    let a = Array::get(args, 0)
    match a {
      VBool(bv) => {
        assert(bv)
        Some(VUnit)
      },
      _ => Some(VUnit)
    }
  }
  else if String::equals(name, "Int::to_double") {
    let a = Array::get(args, 0)
    match a {
      VInt(n) => Some(VFloat(Int::to_double(n))),
      _ => Some(VFloat(0.0))
    }
  }
  else if String::equals(name, "Double::to_int") {
    let a = Array::get(args, 0)
    match a {
      VFloat(f) => Some(VInt(Double::to_int(f))),
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "Double::to_i64_bits") {
    let a = Array::get(args, 0)
    match a {
      VFloat(f) => Some(VInt(Double::to_i64_bits(f))),
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "Double::from_i64_bits") {
    let a = Array::get(args, 0)
    match a {
      VInt(n) => Some(VFloat(Double::from_i64_bits(n))),
      _ => Some(VFloat(0.0))
    }
  }
  else if String::equals(name, "ArrayBuilder::new") {
    Some(VUnit)
  }
  else if String::equals(name, "ArrayBuilder::push") {
    Some(VUnit)
  }
  else if String::equals(name, "ArrayBuilder::freeze") {
    Some(VUnit)
  }
  else None
}

let eval_array = (name: String, args: Array[Value]) -> Option[Value] {
  if String::equals(name, "Array::length") {
    let arr = Array::get(args, 0)
    match arr {
      VArray(elems) => Some(VInt(Array::length(elems))),
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "Array::get") {
    let arr = Array::get(args, 0)
    let idx = Array::get(args, 1)
    match arr {
      VArray(elems) => match idx {
        VInt(i) => Some(Array::get(elems, i)),
        _ => Some(VUnit)
      },
      _ => Some(VUnit)
    }
  }
  else if String::equals(name, "Array::slice") {
    let arr = Array::get(args, 0)
    let start_v = Array::get(args, 1)
    let end_v = Array::get(args, 2)
    match arr {
      VArray(elems) => match start_v {
        VInt(s) => match end_v {
          VInt(e) => Some(VArray(Array::slice(elems, s, e))),
          _ => Some(VArray(elems))
        },
        _ => Some(VArray(elems))
      },
      _ => Some(VUnit)
    }
  }
  else if String::equals(name, "Array::concat") {
    let arr1 = Array::get(args, 0)
    let arr2 = Array::get(args, 1)
    match arr1 {
      VArray(e1) => match arr2 {
        VArray(e2) => Some(VArray(Array::concat(e1, e2))),
        _ => Some(VArray(e1))
      },
      _ => Some(VUnit)
    }
  }
  else None
}

let eval_bytes = (name: String, args: Array[Value]) -> Option[Value] {
  if String::equals(name, "Bytes::new") {
    Some(VBytes(Array::slice([
      0
    ], 0, 0)))
  }
  else if String::equals(name, "Bytes::length") {
    let b = Array::get(args, 0)
    match b {
      VBytes(data) => Some(VInt(Array::length(data))),
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "Bytes::get") {
    let b = Array::get(args, 0)
    let idx = Array::get(args, 1)
    match b {
      VBytes(data) => match idx {
        VInt(i) => Some(VInt(Array::get(data, i))),
        _ => Some(VInt(0))
      },
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "Bytes::set") {
    Some(VUnit)
  }
  else if String::equals(name, "Bytes::push") {
    Some(VUnit)
  }
  else if String::equals(name, "Bytes::concat") {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VBytes(da) => match b {
        VBytes(db) => Some(VBytes(Array::concat(da, db))),
        _ => Some(VBytes(da))
      },
      _ => Some(VBytes(Array::slice([
        0
      ], 0, 0)))
    }
  }
  else if String::equals(name, "Bytes::slice") {
    let b = Array::get(args, 0)
    let start_v = Array::get(args, 1)
    let end_v = Array::get(args, 2)
    match b {
      VBytes(data) => match start_v {
        VInt(s) => match end_v {
          VInt(e) => Some(VBytes(Array::slice(data, s, e))),
          _ => Some(VBytes(data))
        },
        _ => Some(VBytes(data))
      },
      _ => Some(VBytes(Array::slice([
        0
      ], 0, 0)))
    }
  }
  else if String::equals(name, "Bytes::from_array") {
    let arr = Array::get(args, 0)
    match arr {
      VArray(elems) => {
        let len = Array::length(elems)
        let result = for elem in elems {
          match elem {
            VInt(n) => n,
            _ => 0
          }
        }
        Some(VBytes(result))
      },
      _ => Some(VBytes(Array::slice([
        0
      ], 0, 0)))
    }
  }
  else if String::equals(name, "Bytes::to_array") {
    let b = Array::get(args, 0)
    match b {
      VBytes(data) => {
        let result = for d in data {
          VInt(d)
        }
        Some(VArray(result))
      },
      _ => Some(VArray(Array::slice([
        VUnit
      ], 0, 0)))
    }
  }
  else None
}

let eval_string = (name: String, args: Array[Value]) -> Option[Value] {
  if String::equals(name, "String::concat") {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VString(sa) => match b {
        VString(sb) => Some(VString(String::concat(sa, sb))),
        _ => Some(VString(sa))
      },
      _ => Some(VString(""))
    }
  }
  else if String::equals(name, "String::length") {
    let s = Array::get(args, 0)
    match s {
      VString(sv) => Some(VInt(String::length(sv))),
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "String::equals") {
    let a = Array::get(args, 0)
    let b = Array::get(args, 1)
    match a {
      VString(sa) => match b {
        VString(sb) => Some(VBool(String::equals(sa, sb))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if String::equals(name, "String::from_char_code") {
    let code = Array::get(args, 0)
    match code {
      VInt(c) => Some(VString(String::from_char_code(c))),
      _ => Some(VString(""))
    }
  }
  else if String::equals(name, "String::char_code_at") {
    let s = Array::get(args, 0)
    let idx = Array::get(args, 1)
    match s {
      VString(sv) => match idx {
        VInt(i) => Some(VInt(String::char_code_at(sv, i))),
        _ => Some(VInt(0))
      },
      _ => Some(VInt(0))
    }
  }
  else if String::equals(name, "String::substring") {
    let s = Array::get(args, 0)
    let start = Array::get(args, 1)
    let end_v = Array::get(args, 2)
    match s {
      VString(sv) => match start {
        VInt(si) => match end_v {
          VInt(ei) => Some(VString(String::substring(sv, si, ei))),
          _ => Some(VString(sv))
        },
        _ => Some(VString(sv))
      },
      _ => Some(VString(""))
    }
  }
  else if String::equals(name, "String::index_of") {
    let s = Array::get(args, 0)
    let sub = Array::get(args, 1)
    match s {
      VString(sv) => match sub {
        VString(subv) => Some(VInt(String::index_of(sv, subv))),
        _ => Some(VInt(-1))
      },
      _ => Some(VInt(-1))
    }
  }
  else if String::equals(name, "String::last_index_of") {
    let s = Array::get(args, 0)
    let sub = Array::get(args, 1)
    match s {
      VString(sv) => match sub {
        VString(subv) => Some(VInt(String::last_index_of(sv, subv))),
        _ => Some(VInt(-1))
      },
      _ => Some(VInt(-1))
    }
  }
  else if String::equals(name, "String::starts_with") {
    let s = Array::get(args, 0)
    let prefix = Array::get(args, 1)
    match s {
      VString(sv) => match prefix {
        VString(pv) => Some(VBool(String::starts_with(sv, pv))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else if String::equals(name, "String::ends_with") {
    let s = Array::get(args, 0)
    let suffix = Array::get(args, 1)
    match s {
      VString(sv) => match suffix {
        VString(sfx) => Some(VBool(String::ends_with(sv, sfx))),
        _ => Some(VBool(false))
      },
      _ => Some(VBool(false))
    }
  }
  else None
}

export let eval_builtin_call = (name: String, args: Array[Value]) -> Option[Value] {
  match eval_array(name, args) {
    Some(v) => Some(v),
    None => match eval_string(name, args) {
      Some(v) => Some(v),
      None => match eval_bytes(name, args) {
        Some(v) => Some(v),
        None => eval_misc(name, args)
      }
    }
  }
}
