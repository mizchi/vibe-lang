//# Imports

import ./lexer.vibe {
  lex
}

import ./ast.vibe {
  Stmt
}

import ./parser.vibe {
  parse_program
}

import ./checker_stmt.vibe {
  check_stmts
}

import ./eval_loader.vibe {
  collect_exports, contains_str, source_lookup, load_and_parse
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup
}

//# Path helpers (inline to avoid cross-module import issues)

let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  }
  else {
    String::substring(file_path, 0, idx)
  }
}

let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  if len >= 3 {
    if String::equals(String::substring(raw_path, 0, 3), "../") {
      let rest = String::substring(raw_path, 3, len)
      let parent = dir_of(base_dir)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if String::equals(parent, "") {
        resolved
      } else {
        String::concat(parent, String::concat("/", resolved))
      }
    }
    else if String::equals(String::substring(raw_path, 0, 2), "./") {
      let rest = String::substring(raw_path, 2, len)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if String::equals(base_dir, "") {
        resolved
      } else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    }
    else {
      raw_path
    }
  }
  else if len >= 2 {
    if String::equals(String::substring(raw_path, 0, 2), "./") {
      let rest = String::substring(raw_path, 2, len)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if String::equals(base_dir, "") {
        resolved
      } else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    }
    else {
      raw_path
    }
  }
  else {
    raw_path
  }
}

let join_path = (base_dir: String, rel_path: String) -> String {
  if String::equals(base_dir, "") {
    rel_path
  } else {
    String::concat(base_dir, String::concat("/", rel_path))
  }
}

let strip_trailing_cr = (line: String) -> String {
  let len = String::length(line)
  if len > 0 && String::char_code_at(line, len - 1) == 13 {
    String::substring(line, 0, len - 1)
  } else {
    line
  }
}

let find_char = (s: String, target: Int) -> Int {
  let len = String::length(s)
  let mut i = 0
  let mut result = -1
  while i < len {
    if String::char_code_at(s, i) == target {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

let parse_source_manifest_paths = (manifest_source: String) -> Array[String] with { Error } {
  let paths = Array::slice([""], 0, 0)
  let len = String::length(manifest_source)
  let mut line_start = 0
  let mut i = 0
  while i <= len {
    if i == len || String::char_code_at(manifest_source, i) == 10 {
      let raw_line = strip_trailing_cr(String::substring(manifest_source, line_start, i))
      let line_len = String::length(raw_line)
      if line_len > 0 && String::char_code_at(raw_line, 0) != 35 {
        let tab_idx = find_char(raw_line, 9)
        if tab_idx < 0 || tab_idx + 1 >= line_len {
          throw(String::concat("invalid source manifest row: ", raw_line))
        }
        Array::push(paths, String::substring(raw_line, tab_idx + 1, line_len))
      }
      line_start = i + 1
    }
    i = i + 1
  }
  paths
}

let is_manifest_root_entry = (entry_path: String) -> Bool {
  String::equals(entry_path, "index.vibe") || String::ends_with(entry_path, "/index.vibe")
}

let try_collect_manifest_sources_fs = (entry_path: String) -> Option[Array[(String, String)]] with { Error, Fs } {
  if !(is_manifest_root_entry(entry_path)) {
    None
  } else {
    let base_dir = dir_of(entry_path)
    let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
    if !(Fs::exists(manifest_path)) {
      None
    } else {
      let rel_paths = parse_source_manifest_paths(Fs::read_file(manifest_path))
      let sources = Array::slice([("", "")], 0, 0)
      let mut full_paths = Array::slice([""], 0, 0)
      let mut i = 0
      while i < Array::length(rel_paths) {
        Array::push(full_paths, join_path(base_dir, Array::get(rel_paths, i)))
        i = i + 1
      }
      if !(contains_str(full_paths, entry_path)) {
        None
      } else {
        let mut j = 0
        while j < Array::length(full_paths) {
          let path = Array::get(full_paths, j)
          Array::push(sources, (path, Fs::read_file(path)))
          j = j + 1
        }
        Some(sources)
      }
    }
  }
}

//# Helper functions

// Cache lookup helper
let cache_lookup = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while i < len {
    if done {
      i = len
    } else {
      let (p, e) = Array::get(cache, i)
      if String::equals(p, path) {
        result = Some(e)
        done = true
      }
      i = i + 1
    }
  }
  result
}

// Bind imported names from a checked module's env
let rec bind_checked_imports = (
  names: Array[(String, Option[String])],
  i: Int,
  env: TypeEnv,
  mod_env: TypeEnv,
  exports: Array[String]
) -> TypeEnv {
  if i >= Array::length(names) {
    env
  } else {
    let (name, alias) = Array::get(names, i)
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let new_env = if contains_str(exports, name) {
      match env_lookup(mod_env, name) {
        Some(ty) => env_bind(env, bound_name, ty),
        None => env
      }
    } else {
      env
    }
    bind_checked_imports(names, i + 1, new_env, mod_env, exports)
  }
}

//# Module Loader

// Check a module and return its TypeEnv, resolving imports recursively.
// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).
export let rec check_module = (
  source: String,
  path: String,
  sources: Array[(String, String)],
  loading: Array[String],
  checked_cache: Array[(String, TypeEnv)]
) -> TypeEnv with { Error } {
  // Check cache first
  let cached = cache_lookup(checked_cache, path)
  match cached {
    Some(env) => env,
    None => {
      // Cycle detection
      if contains_str(loading, path) {
        throw(String::concat("import cycle detected: ", path))
      }
      let tokens = lex(source)
      let stmts = parse_program(tokens)
      let base_dir = dir_of(path)
      let new_loading = Array::concat(loading, [path])

      // Resolve imports using while loop
      let mut import_env = EnvEmpty
      let mut ri = 0
      while ri < Array::length(stmts) {
        let stmt = Array::get(stmts, ri)
        import_env = match stmt {
          SImport(raw_path, names) => {
            let resolved = resolve_path(base_dir, raw_path)
            match source_lookup(sources, resolved) {
              None => throw(String::concat("module not found: ", resolved)),
              Some(mod_source) => {
                // Recursively check the imported module
                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)
                let exports = {
                  let mod_tokens = lex(mod_source)
                  let mod_stmts = parse_program(mod_tokens)
                  collect_exports(mod_stmts)
                }
                // Bind exported names into current env
                bind_checked_imports(names, 0, import_env, mod_env, exports)
              }
            }
          },
          _ => import_env
        }
        ri = ri + 1
      }

      // Type-check with imported env
      let empty_defs = Array::slice([TDAlias("_dummy", CtUnit)], 0, 0)
      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0)

      // Cache result
      Array::push(checked_cache, (path, env))
      env
    }
  }
}

//# FS-based source collection

let rec collect_sources_rec = (
  path: String,
  sources: Array[(String, String)],
  visited: Array[String]
) -> Unit with { Error, Fs } {
  if contains_str(visited, path) {
    ()
  }
  else {
    Array::push(visited, path)
    let source = Fs::read_file(path)
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let base_dir = dir_of(path)
    // First, recurse into dependencies (imports and re-exports)
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SImport(raw_path, _) => {
          let resolved = resolve_path(base_dir, raw_path)
          collect_sources_rec(resolved, sources, visited)
        },
        SReExport(raw_path, _) => {
          let resolved = resolve_path(base_dir, raw_path)
          collect_sources_rec(resolved, sources, visited)
        },
        _ => ()
      }
      i = i + 1
    }
    // Then add this module (dependencies come first)
    Array::push(sources, (path, source))
  }
}

// Recursively collect all source files from filesystem, following imports and re-exports.
// Returns Array[(path, source)] in dependency order (dependencies first).
export let collect_all_sources_fs = (entry_path: String) -> Array[(String, String)] with { Error, Fs } {
  match try_collect_manifest_sources_fs(entry_path) {
    Some(sources) => sources,
    None => {
      let sources = Array::slice([("", "")], 0, 0)
      let visited = Array::slice([""], 0, 0)
      collect_sources_rec(entry_path, sources, visited)
      sources
    }
  }
}

//# Module bundling — merge stmts from all modules in dependency order

// Given all sources (in dependency order), parse and merge their statements.
// Skips SImport, SReExport (already resolved). Keeps all definitions.
export let collect_merged_stmts = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {
  let merged = Array::slice([SExport(["_dummy"])], 0, 0)
  let mut si = 0
  while si < Array::length(sources) {
    let (_, src) = Array::get(sources, si)
    let stmts = load_and_parse(src)
    let mut j = 0
    while j < Array::length(stmts) {
      let stmt = Array::get(stmts, j)
      match stmt {
        SImport(_, _) => (),
        SReExport(_, _) => (),
        _ => Array::push(merged, stmt)
      }
      j = j + 1
    }
    si = si + 1
  }
  merged
}
