//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_let_simple" {
  assert(ps("let x = 1") == "let x = 1")
}

test "stmt_let_typed" {
  assert(ps("let x: Int = 1") == "let x: Int = 1")
}

test "stmt_let_rec" {
  assert(ps("let rec f = 1") == "let rec f = 1")
}

test "stmt_let_rec_typed" {
  assert(ps("let rec f: Int = 1") == "let rec f: Int = 1")
}
