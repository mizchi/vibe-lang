test "stmt_program_import_export" {
  let result = pp("import ./ast.vibe { Expr }\nexport ./ast.vibe { Expr }\nexport let x = 1")
  assert(String::equals(result, "import ./ast.vibe { Expr }\nexport ./ast.vibe { Expr }\nexport let x = 1"))
}
