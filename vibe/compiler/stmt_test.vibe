  assert(String::equals(result, "suberror AppError(String)"))
}

test "stmt_suberror_variants" {
  let result = ps("suberror AppError { NotFound; Invalid(String) }")
  assert(String::equals(result, "suberror AppError { NotFound; Invalid(String) }"))
}

test "stmt_export_suberror" {
  let result = ps("export suberror AppError(String)")
  assert(String::equals(result, "export suberror AppError(String)"))
}

test "stmt_extern_let_percent_symbol" {
  let result = ps("extern let %read_file: (String) -> String")
  assert(String::equals(result, "extern let %read_file: (String) -> String"))
}

test "stmt_import_keyword" {
  let result = ps("import ./ast.vibe { Expr, Pat }")
  assert(String::equals(result, "import ./ast.vibe { Expr, Pat }"))
}

test "stmt_export_path" {
  let result = ps("export ./ast.vibe { Expr, Pat }")
  assert(String::equals(result, "export ./ast.vibe { Expr, Pat }"))
}

test "stmt_export_path_alias" {
  let result = ps("export ./token.vibe { Token, token_to_string }")
  assert(String::equals(result, "export ./token.vibe { Token, token_to_string }"))
