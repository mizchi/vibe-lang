//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  Expr, Pat, Stmt, TypeExpr, parse_program, parse_stmt, parse_type
}

import ./printer.vibe {
  print_program, print_stmt, print_type_expr
}

import ./token.vibe {
  Token
}

//# Functions

let pp = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } {
    Error(msg) => String::concat("ERROR: ", msg)
  }
}

let ps = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let (stmt, _) = parse_stmt(tokens, 0)
    print_stmt(stmt)
  } {
    Error(msg) => String::concat("ERROR: ", msg)
  }
}

let pt = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let (ty, _) = parse_type(tokens, 0)
    print_type_expr(ty)
  } {
    Error(msg) => String::concat("ERROR: ", msg)
  }
}

let _token_anchor = (t: Token) -> Token {
  t
}

//# Misc

test "type_name" {
  assert(String::equals(pt("Int"), "Int"))
}

test "type_unit" {
  assert(String::equals(pt("()"), "()"))
}

test "type_app_single" {
  assert(String::equals(pt("Array[Int]"), "Array[Int]"))
}

test "type_app_multi" {
  assert(String::equals(pt("Map[String, Int]"), "Map[String, Int]"))
}

test "type_fn" {
  assert(String::equals(pt("(Int) -> String"), "(Int) -> String"))
}

test "type_fn_multi_params" {
  assert(String::equals(pt("(Int, String) -> Bool"), "(Int, String) -> Bool"))
}

test "type_fn_unit_param" {
  assert(String::equals(pt("() -> Int"), "() -> Int"))
}

test "type_tuple" {
  assert(String::equals(pt("(Int, String)"), "(Int, String)"))
}

test "type_nested" {
  assert(String::equals(pt("Array[Option[Int]]"), "Array[Option[Int]]"))
}

test "type_fn_returning_fn" {
  assert(String::equals(pt("(Int) -> (String) -> Bool"), "(Int) -> (String) -> Bool"))
}

test "stmt_let_simple" {
  assert(String::equals(ps("let x = 1"), "let x = 1"))
}

test "stmt_let_typed" {
  assert(String::equals(ps("let x: Int = 1"), "let x: Int = 1"))
}

test "stmt_let_rec" {
  assert(String::equals(ps("let rec f = 1"), "let rec f = 1"))
}

test "stmt_let_rec_typed" {
  assert(String::equals(ps("let rec f: Int = 1"), "let rec f: Int = 1"))
}

test "stmt_let_mut" {
  assert(String::equals(ps("let mut x = 0"), "let mut x = 0"))
}

test "stmt_let_mut_typed" {
  assert(String::equals(ps("let mut x: Int = 0"), "let mut x: Int = 0"))
}

test "stmt_export_let" {
  assert(String::equals(ps("export let x = 1"), "export let x = 1"))
}

test "stmt_export_let_rec" {
  assert(String::equals(ps("export let rec f = 1"), "export let rec f = 1"))
}

test "stmt_enum_simple" {
  assert(String::equals(ps("enum Color { Red; Green; Blue }"), "enum Color { Red; Green; Blue }"))
}

test "stmt_enum_with_args" {
  assert(String::equals(ps("enum Option { Some(Int); None }"), "enum Option { Some(Int); None }"))
}

test "stmt_enum_exported" {
  assert(String::equals(ps("export enum Color { Red; Green }"), "export enum Color { Red; Green }"))
}

test "stmt_struct" {
  assert(String::equals(ps("struct Point { x: Int; y: Int }"), "struct Point { x: Int; y: Int }"))
}

test "stmt_struct_exported" {
  assert(String::equals(ps("export struct Point { x: Int }"), "export struct Point { x: Int }"))
}

test "stmt_type_alias" {
  assert(String::equals(ps("type Name = String"), "type Name = String"))
}

test "stmt_type_alias_exported" {
  assert(String::equals(ps("export type Pair = (Int, String)"), "export type Pair = (Int, String)"))
}

test "stmt_trait" {
  assert(String::equals(ps("trait Show"), "trait Show"))
}

test "stmt_impl" {
  assert(String::equals(pp("impl Show for Int"), "impl Show for Int"))
}

test "stmt_impl_type_params_rejected" {
  let result = pp("impl [A: Show] Show for Int")
  assert(String::equals(result, "ERROR: impl type parameters are not supported yet"))
}

test "stmt_use_removed" {
  let result = ps("use ./foo.vibe { Bar }")
  assert(String::equals(result, "ERROR: 'use' syntax is removed; use 'import <module-ref> { ... }'"))
}

test "stmt_import_basic" {
  assert(String::equals(ps("import ./foo.vibe { Bar }"), "import ./foo.vibe { Bar }"))
}

test "stmt_test" {
  let result = ps("test \"hello\" { 1 }")
  assert(String::equals(result, "test \"hello\" { 1 }"))
}

test "stmt_bench" {
  let result = ps("bench \"perf\" { 1 }")
  assert(String::equals(result, "bench \"perf\" { 1 }"))
}

test "stmt_export_names" {
  assert(String::equals(ps("export { foo, bar }"), "export { foo, bar }"))
}

test "stmt_expr" {
  assert(String::equals(ps("1 + 2"), "(1 + 2)"))
}

test "program_simple" {
  let src = "let x = 1\nlet y = 2"
  let result = pp(src)
  assert(String::equals(result, "let x = 1\nlet y = 2"))
}

test "program_enum_and_fn" {
  let src = "enum Bool { True; False }\nlet f = 1"
  let result = pp(src)
  assert(String::equals(result, "enum Bool { True; False }\nlet f = 1"))
}

test "stmt_let_fn_typed" {
  let result = ps("let f: (Int) -> String = 1")
  assert(String::equals(result, "let f: (Int) -> String = 1"))
}

test "stmt_let_fn_value" {
  let result = ps("let f = (x: Int) -> 1")
  assert(String::equals(result, "let f = (x: Int) -> 1"))
}

test "stmt_let_fn_arrow_untyped" {
  let result = ps("let f = (x) -> x")
  assert(String::equals(result, "let f = (x) -> x"))
}

test "stmt_let_fn_block_typed" {
  let result = ps("let f = (x: Int) { x }")
  assert(String::equals(result, "let f = (x: Int) -> x"))
}

test "stmt_let_fn_tuple_return_with_nested_if_tuple" {
  let src = "let f = () -> (Int, Int) { let g = (idx: Int) -> (Int, Int) { if true { (idx, idx) } else { (idx, idx) } }; g(1) }"
  let ok = handle {
    let _ = parse_program(lex(src))
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "stmt_let_fn_tuple_return_with_nested_if_tuple_no_semi" {
  let src = "let f = () -> (Int, Int) { let g = (idx: Int) -> (Int, Int) { if true { (idx, idx) } else { (idx, idx) } } g(1) }"
  let ok = handle {
    let _ = parse_program(lex(src))
    true
  } {
    Error(_) => false
  }
  assert(ok)
}

test "stmt_nested_lambda_tuple_if_regression_matrix" {
  let c1 = handle {
    let _ = parse_program(lex("let g = (idx: Int) -> (Int, Int) { if true { (idx, idx) } else { (idx, idx) } }"))
    true
  } {
    Error(_) => false
  }
  let c2 = handle {
    let _ = parse_program(lex("let f = () -> (Int, Int) { let g = (idx: Int) -> (Int, Int) { (idx, idx) } g(1) }"))
    true
  } {
    Error(_) => false
  }
  let c3 = handle {
    let _ = parse_program(lex("let f = () -> (Int, Int) { let g = (idx: Int) -> (Int, Int) { if true { (idx, idx) } else { (idx, idx) } } g(1) }"))
    true
  } {
    Error(_) => false
  }
  assert(c1 && c2 && c3)
}

test "stmt_enum_multi_args" {
  let result = ps("enum Expr { EBinOp(String, Expr, Expr); EInt(Int) }")
  assert(String::equals(result, "enum Expr { EBinOp(String, Expr, Expr); EInt(Int) }"))
}

test "stmt_struct_complex_types" {
  let result = ps("struct Config { items: Array[String]; handler: (Int) -> Bool }")
  assert(String::equals(result, "struct Config { items: Array[String]; handler: (Int) -> Bool }"))
}

test "stmt_type_alias_fn" {
  let result = ps("type Handler = (String, Int) -> Bool")
  assert(String::equals(result, "type Handler = (String, Int) -> Bool"))
}

test "stmt_export_trait" {
  assert(String::equals(ps("export trait Eq"), "export trait Eq"))
}

test "program_import_then_let" {
  let src = "import ./foo.vibe { Bar, Baz }\nlet x = 1"
  let result = pp(src)
  assert(String::equals(result, "import ./foo.vibe { Bar, Baz }\nlet x = 1"))
}

test "program_full" {
  let src = "enum Color { Red; Blue }\nexport let name = \"hello\"\nexport { name }"
  let result = pp(src)
  assert(String::equals(result, "enum Color { Red; Blue }\nexport let name = \"hello\"\nexport { name }"))
}

test "stmt_suberror_single_payload" {
