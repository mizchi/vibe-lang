//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  Pat, Expr, TypeExpr, Stmt, parse_type, parse_stmt, parse_program
}

import ./printer.vibe {
  print_type_expr, print_stmt, print_program
}

//# Functions

let pp = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } {
    Error(msg) => string_concat("ERROR: ", msg)
  }
}

let ps = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let (stmt, _) = parse_stmt(tokens, 0)
    print_stmt(stmt)
  } {
    Error(msg) => string_concat("ERROR: ", msg)
  }
}

let pt = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let (ty, _) = parse_type(tokens, 0)
    print_type_expr(ty)
  } {
    Error(msg) => string_concat("ERROR: ", msg)
  }
}

//# Misc

test "type_name" {
  assert(string_equals(pt("Int"), "Int"))
}

test "type_unit" {
  assert(string_equals(pt("()"), "()"))
}

test "type_app_single" {
  assert(string_equals(pt("Array[Int]"), "Array[Int]"))
}

test "type_app_multi" {
  assert(string_equals(pt("Map[String, Int]"), "Map[String, Int]"))
}

test "type_fn" {
  assert(string_equals(pt("(Int) -> String"), "(Int) -> String"))
}

test "type_fn_multi_params" {
  assert(string_equals(pt("(Int, String) -> Bool"), "(Int, String) -> Bool"))
}

test "type_fn_unit_param" {
  assert(string_equals(pt("() -> Int"), "() -> Int"))
}

test "type_tuple" {
  assert(string_equals(pt("(Int, String)"), "(Int, String)"))
}

test "type_nested" {
  assert(string_equals(pt("Array[Option[Int]]"), "Array[Option[Int]]"))
}

test "type_fn_returning_fn" {
  assert(string_equals(pt("(Int) -> (String) -> Bool"), "(Int) -> (String) -> Bool"))
}

test "stmt_let_simple" {
  assert(string_equals(ps("let x = 1"), "let x = 1"))
}

test "stmt_let_typed" {
  assert(string_equals(ps("let x: Int = 1"), "let x: Int = 1"))
}

test "stmt_let_rec" {
  assert(string_equals(ps("let rec f = 1"), "let rec f = 1"))
}

test "stmt_let_rec_typed" {
  assert(string_equals(ps("let rec f: Int = 1"), "let rec f: Int = 1"))
}

test "stmt_let_mut" {
  assert(string_equals(ps("let mut x = 0"), "let mut x = 0"))
}

test "stmt_let_mut_typed" {
  assert(string_equals(ps("let mut x: Int = 0"), "let mut x: Int = 0"))
}

test "stmt_export_let" {
  assert(string_equals(ps("export let x = 1"), "export let x = 1"))
}

test "stmt_export_let_rec" {
  assert(string_equals(ps("export let rec f = 1"), "export let rec f = 1"))
}

test "stmt_enum_simple" {
  assert(string_equals(ps("enum Color { Red; Green; Blue }"), "enum Color { Red; Green; Blue }"))
}

test "stmt_enum_with_args" {
  assert(string_equals(ps("enum Option { Some(Int); None }"), "enum Option { Some(Int); None }"))
}

test "stmt_enum_exported" {
  assert(string_equals(ps("export enum Color { Red; Green }"), "export enum Color { Red; Green }"))
}

test "stmt_struct" {
  assert(string_equals(ps("struct Point { x: Int; y: Int }"), "struct Point { x: Int; y: Int }"))
}

test "stmt_struct_exported" {
  assert(string_equals(ps("export struct Point { x: Int }"), "export struct Point { x: Int }"))
}

test "stmt_type_alias" {
  assert(string_equals(ps("type Name = String"), "type Name = String"))
}

test "stmt_type_alias_exported" {
  assert(string_equals(ps("export type Pair = (Int, String)"), "export type Pair = (Int, String)"))
}

test "stmt_trait" {
  assert(string_equals(ps("trait Show"), "trait Show"))
}

test "stmt_impl" {
  assert(string_equals(ps("impl Show for Int"), "impl Show for Int"))
}

test "stmt_use" {
  assert(string_equals(ps("use ./foo.vibe { Bar }"), "use ./foo.vibe { Bar }"))
}

test "stmt_use_with_alias" {
  assert(string_equals(ps("use ./foo.vibe { Bar as B }"), "use ./foo.vibe { Bar as B }"))
}

test "stmt_use_multi" {
  assert(string_equals(ps("use ./foo.vibe { A, B, C }"), "use ./foo.vibe { A, B, C }"))
}

test "stmt_test" {
  let result = ps("test \"hello\" { 1 }")
  assert(string_equals(result, "test \"hello\" { 1 }"))
}

test "stmt_bench" {
  let result = ps("bench \"perf\" { 1 }")
  assert(string_equals(result, "bench \"perf\" { 1 }"))
}

test "stmt_export_names" {
  assert(string_equals(ps("export { foo, bar }"), "export { foo, bar }"))
}

test "stmt_expr" {
  assert(string_equals(ps("1 + 2"), "(1 + 2)"))
}

test "program_simple" {
  let src = "let x = 1\nlet y = 2"
  let result = pp(src)
  assert(string_equals(result, "let x = 1\nlet y = 2"))
}

test "program_enum_and_fn" {
  let src = "enum Bool { True; False }\nlet f = 1"
  let result = pp(src)
  assert(string_equals(result, "enum Bool { True; False }\nlet f = 1"))
}

test "stmt_let_fn_typed" {
  let result = ps("let f: (Int) -> String = 1")
  assert(string_equals(result, "let f: (Int) -> String = 1"))
}

test "stmt_let_fn_value" {
  let result = ps("let f = (x: Int) -> 1")
  assert(string_equals(result, "let f = (x: Int) -> 1"))
}

test "stmt_let_fn_arrow_untyped" {
  let result = ps("let f = (x) -> x")
  assert(string_equals(result, "let f = (x) -> x"))
}

test "stmt_let_fn_block_typed" {
  let result = ps("let f = (x: Int) { x }")
  assert(string_equals(result, "let f = (x: Int) -> x"))
}

test "stmt_enum_multi_args" {
  let result = ps("enum Expr { EBinOp(String, Expr, Expr); EInt(Int) }")
  assert(string_equals(result, "enum Expr { EBinOp(String, Expr, Expr); EInt(Int) }"))
}

test "stmt_struct_complex_types" {
  let result = ps("struct Config { items: Array[String]; handler: (Int) -> Bool }")
  assert(string_equals(result, "struct Config { items: Array[String]; handler: (Int) -> Bool }"))
}

test "stmt_type_alias_fn" {
  let result = ps("type Handler = (String, Int) -> Bool")
  assert(string_equals(result, "type Handler = (String, Int) -> Bool"))
}

test "stmt_export_trait" {
  assert(string_equals(ps("export trait Eq"), "export trait Eq"))
}

test "program_use_then_let" {
  let src = "use ./foo.vibe { Bar, Baz }\nlet x = 1"
  let result = pp(src)
  assert(string_equals(result, "use ./foo.vibe { Bar, Baz }\nlet x = 1"))
}

test "program_full" {
  let src = "enum Color { Red; Blue }\nexport let name = \"hello\"\nexport { name }"
  let result = pp(src)
  assert(string_equals(result, "enum Color { Red; Blue }\nexport let name = \"hello\"\nexport { name }"))
}
