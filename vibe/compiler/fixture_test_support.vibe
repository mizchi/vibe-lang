//# Imports

import ../../lib/@vibe/json {
  Json, json_as_arr, json_as_bool, json_as_obj, json_as_str, parse
}

import ../prelude/result.vibe {
  Result
}

import ../../lib/@vibe/module {
  dir_of, resolve_path
}

import ../shell {
  split, trim
}

import ./core {
  Stmt
}

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./printer.vibe {
  print_program
}

import ./runtime {
  db_new, db_set_source, db_typecheck
}

//# Types

export struct FixtureSpec {
  last: Option[String];
  effects: Option[Array[String]];
  error_contains: Option[String];
  todo: Bool;
  skip: Bool;
  version_refs: Map[String, String];
  symbol_refs: Map[String, String]
}

//# Functions

let pp: (String) -> String = (src) -> {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } with Error {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}

let json_get: (Map[String, Json], String) -> Option[Json] = (obj, key) -> {
  if Map::has_key(obj, key) {
    Some(Map::get(obj, key))
  } else None
}

export let parse_ok: (String) -> Bool = (src) -> {
  let output = pp(src)
  if String::length(output) > 6 && output[0:6] == "ERROR:" {
    false
  } else true
}

let join_lines: (Array[String]) -> String = (lines) -> {
  let len = Array::length(lines)
  let rec go: (Int, String) -> String = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = Array::get(lines, i)
      let merged = if i == 0 {
        next
      } else {
        String::concat(String::concat(acc, "\n"), next)
      }
      go(i + 1, merged)
    }
  }
  go(0, "")
}

export let roundtrip_ok: (String) -> Bool = (src) -> {
  let output1 = pp(src)
  if String::length(output1) > 6 && output1[0:6] == "ERROR:" {
    false
  } else {
    let output2 = pp(output1)
    output1 == output2
  }
}

let seed_type_db: (Array[(String, String)]) -> TypeDb = (sources) -> {
  let mut db = db_new()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    db = db_set_source(db, path, source)
    i = i + 1
  }
  db
}

let sort_strings: (Array[String]) -> Unit = (items) -> {
  let len = Array::length(items)
  if len < 2 {
    ()
  } else {
    let mut i = 0
    while i + 1 < len {
      let mut min_index = i
      let mut j = i + 1
      while j < len {
        let left = Array::get(items, j)
        let right = Array::get(items, min_index)
        if left < right {
          min_index = j
        }
        j = j + 1
      }
      if min_index != i {
        let tmp = Array::get(items, i)
        Array::set(items, i, Array::get(items, min_index))
        Array::set(items, min_index, tmp)
      }
      i = i + 1
    }
  }
}

let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let split_fixture: (String, String) -> (String, String) with { Error } = (source, path) -> {
  let lines = split(source, "\n")
  let script_lines = ArrayBuilder::new()
  let data_lines = ArrayBuilder::new()
  let mut in_data = false
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if trim(line) == "__DATA__" {
      in_data = true
    } else if in_data {
      ArrayBuilder::push(data_lines, line)
    } else {
      ArrayBuilder::push(script_lines, line)
    }
    i = i + 1
  }
  if in_data {
    (join_lines(ArrayBuilder::freeze(script_lines)), join_lines(ArrayBuilder::freeze(data_lines)))
  } else {
    throw(String::concat(String::concat("[", path), "] missing __DATA__ section"))
  }
}

let import_ref_name: (String, String) -> Option[String] = (raw_path, prefix) -> {
  let prefix_len = String::length(prefix)
  let raw_len = String::length(raw_path)
  if raw_len >= prefix_len && raw_path[0:prefix_len] == prefix {
    Some(raw_path[prefix_len:raw_len])
  } else None
}

let json_expect_bool: (Json) -> Bool with { Error } = (json) -> {
  match json_as_bool(json) {
    Result::Ok(value) => value,
    Result::Err(msg) => throw(msg)
  }
}

let json_expect_obj: (Json) -> Map[String, Json] with { Error } = (json) -> {
  match json_as_obj(json) {
    Result::Ok(value) => value,
    Result::Err(msg) => throw(msg)
  }
}

let json_expect_str: (Json) -> String with { Error } = (json) -> {
  match json_as_str(json) {
    Result::Ok(value) => value,
    Result::Err(msg) => throw(msg)
  }
}

let json_expect_arr: (Json) -> Array[Json] with { Error } = (json) -> {
  match json_as_arr(json) {
    Result::Ok(value) => value,
    Result::Err(msg) => throw(msg)
  }
}

let parse_json_root: (String) -> Json with { Error } = (source) -> {
  match parse(source) {
    Result::Ok((root, _)) => root,
    Result::Err(msg) => throw(msg)
  }
}

let json_bool_field: (Map[String, Json], String) -> Bool with { Error } = (obj, key) -> {
  match json_get(obj, key) {
    Some(JNull) => false,
    Some(json) => json_expect_bool(json),
    None => false
  }
}

let empty_string_map: () -> Map[String, String] = () -> {
  let b = MapBuilder::new()
  MapBuilder::freeze(b)
}

let json_string_field: (Map[String, Json], String, String) -> Option[String] with { Error } = (obj, key, _path) -> {
  match json_get(obj, key) {
    Some(JNull) => None,
    Some(json) => Some(json_expect_str(json)),
    None => None
  }
}

let empty_string_pairs: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let rec append_import_paths: (Array[Stmt], Array[String]) -> Array[String] = (stmts, acc) -> {
  let mut out = acc
  let mut i = 0
  while i < Array::length(stmts) {
    out = match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::concat(out, [
        raw_path
      ]),
      SReExport(raw_path, _) => Array::concat(out, [
        raw_path
      ]),
      SModule(_, _, body) => append_import_paths(body, out),
      _ => out
    }
    i = i + 1
  }
  out
}

let json_string_map_field: (Map[String, Json], String) -> Map[String, String] with { Error } = (obj, key) -> {
  match json_get(obj, key) {
    Some(JNull) => empty_string_map(),
    Some(json) => {
      let raw = json_expect_obj(json)
      let out = MapBuilder::new()
      let keys = Map::keys(raw)
      let mut i = 0
      while i < Array::length(keys) {
        let name = Array::get(keys, i)
        MapBuilder::set(out, name, json_expect_str(Map::get(raw, name)))
        i = i + 1
      }
      MapBuilder::freeze(out)
    },
    None => empty_string_map()
  }
}

let source_pairs_has_path: (Array[(String, String)], String) -> Bool = (pairs, path) -> {
  let rec go: (Int) -> Bool = (i) -> {
    if i >= Array::length(pairs) {
      false
    } else {
      let (p, _) = Array::get(pairs, i)
      if p == path {
        true
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

let resolve_import_fs_path: (String, String) -> Option[String] = (from_path, raw_path) -> {
  let raw_index = String::concat(raw_path, "/index.vibe")
  if perform Fs::IsFile(raw_path) {
    Some(raw_path)
  } else if perform Fs::IsFile(raw_index) {
    Some(raw_index)
  } else {
    let resolved = resolve_path(dir_of(from_path), raw_path)
    let resolved_index = String::concat(resolved, "/index.vibe")
    if perform Fs::IsFile(resolved) {
      Some(resolved)
    } else if perform Fs::IsFile(resolved_index) {
      Some(resolved_index)
    } else {
      let len = String::length(raw_path)
      let root_raw = if len >= 2 && raw_path[0:2] == "./" {
        raw_path[2:len]
      } else {
        raw_path
      }
      let root_index = String::concat(root_raw, "/index.vibe")
      if perform Fs::IsFile(root_raw) {
        Some(root_raw)
      } else if perform Fs::IsFile(root_index) {
        Some(root_index)
      } else None
    }
  }
}

let json_string_array_field: (Map[String, Json], String) -> Option[Array[String]] with { Error } = (obj, key) -> {
  match json_get(obj, key) {
    Some(JNull) => None,
    Some(json) => {
      let items = json_expect_arr(json)
      let out = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(items) {
        ArrayBuilder::push(out, json_expect_str(Array::get(items, i)))
        i = i + 1
      }
      Some(ArrayBuilder::freeze(out))
    },
    None => None
  }
}

export let parse_fixture_spec: (String, String) -> FixtureSpec with { Error } = (data, path) -> {
  let root = parse_json_root(data)
  let obj = json_expect_obj(root)
  let error_contains = match json_string_field(obj, "error_contains", path) {
    Some(value) => Some(value),
    None => json_string_field(obj, "compile_error", path)
  }
  FixtureSpec::{
    last: json_string_field(obj, "last", path),
    effects: json_string_array_field(obj, "effects"),
    error_contains: error_contains,
    todo: json_bool_field(obj, "todo") || json_bool_field(obj, "TODO"),
    skip: json_bool_field(obj, "skip"),
    version_refs: json_string_map_field(obj, "version_refs"),
    symbol_refs: json_string_map_field(obj, "symbol_refs")
  }
}

let resolve_ref_import_path: (String, String, FixtureSpec) -> String with { Error, Fs } = (current_path, raw_path, spec) -> {
  match import_ref_name(raw_path, "version@") {
    Some(name) => if Map::has_key(spec.version_refs, name) {
      let target = Map::get(spec.version_refs, name)
      match resolve_import_fs_path(current_path, target) {
        Some(path) => path,
        None => throw(String::concat("unresolved version ref target: ", target))
      }
    } else {
      throw(String::concat("missing version ref: ", name))
    },
    None => match import_ref_name(raw_path, "symbol@") {
      Some(name) => if Map::has_key(spec.symbol_refs, name) {
        let target = Map::get(spec.symbol_refs, name)
        match resolve_import_fs_path(current_path, target) {
          Some(path) => path,
          None => throw(String::concat("unresolved symbol ref target: ", target))
        }
      } else {
        throw(String::concat("missing symbol ref: ", name))
      },
      None => raw_path
    }
  }
}

let rec rewrite_ref_stmts: (Array[Stmt], String, FixtureSpec) -> Array[Stmt] with { Error, Fs } = (stmts, current_path, spec) -> {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let next = match Array::get(stmts, i) {
      SImport(raw_path, names) => SImport(resolve_ref_import_path(current_path, raw_path, spec), names),
      SReExport(raw_path, names) => SReExport(resolve_ref_import_path(current_path, raw_path, spec), names),
      SModule(exported, name, body) => SModule(exported, name, rewrite_ref_stmts(body, current_path, spec)),
      stmt => stmt
    }
    ArrayBuilder::push(out, next)
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

let rewrite_ref_import_line: (String, String, FixtureSpec) -> String with { Error, Fs } = (line, current_path, spec) -> {
  let version_idx = String::index_of(line, "version@")
  let symbol_idx = String::index_of(line, "symbol@")
  let marker_idx = if version_idx >= 0 {
    version_idx
  } else {
    symbol_idx
  }
  if marker_idx < 0 {
    line
  } else {
    let marker = if version_idx >= 0 {
      "version@"
    } else {
      "symbol@"
    }
    let marker_len = String::length(marker)
    let rest = line[marker_idx + marker_len:String::length(line)]
    let brace_idx = String::index_of(rest, "{")
    if brace_idx < 0 {
      line
    } else {
      let ref_name = trim(rest[0:brace_idx])
      let raw_path = String::concat(marker, ref_name)
      let resolved = resolve_ref_import_path(current_path, raw_path, spec)
      let before = line[0:marker_idx]
      let after = rest[brace_idx:String::length(rest)]
      String::concat(before, String::concat(resolved, after))
    }
  }
}

let rewrite_ref_imports_in_source: (String, String, FixtureSpec) -> String with { Error, Fs } = (source, current_path, spec) -> {
  let lines = split(source, "\n")
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(lines) {
    ArrayBuilder::push(out, rewrite_ref_import_line(Array::get(lines, i), current_path, spec))
    i = i + 1
  }
  join_lines(ArrayBuilder::freeze(out))
}

let strip_fixture_data_if_present: (String) -> String = (source) -> {
  let lines = split(source, "\n")
  let script_lines = ArrayBuilder::new()
  let mut i = 0
  let mut in_data = false
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if trim(line) == "__DATA__" {
      in_data = true
    } else if not(in_data) {
      ArrayBuilder::push(script_lines, line)
    }
    i = i + 1
  }
  if in_data {
    join_lines(ArrayBuilder::freeze(script_lines))
  } else {
    source
  }
}

let rewrite_fixture_source: (String, String, FixtureSpec) -> String with { Error, Fs } = (path, source, spec) -> {
  let source1 = rewrite_ref_imports_in_source(strip_fixture_data_if_present(source), path, spec)
  let stmts = parse_program(lex(source1))
  let rewritten = rewrite_ref_stmts(stmts, path, spec)
  print_program(rewritten)
}

let rec load_fixture_sources: (String, FixtureSpec, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (path, spec, loaded) -> {
  if source_pairs_has_path(loaded, path) {
    loaded
  } else {
    let source = perform Fs::ReadFile(path)
    let rewritten_source = rewrite_fixture_source(path, source, spec)
    let next_loaded = Array::concat(loaded, [
      (path, rewritten_source)
    ])
    let stmts = parse_program(lex(rewritten_source))
    let import_paths = append_import_paths(stmts, empty_strings())
    let mut out = next_loaded
    let mut i = 0
    while i < Array::length(import_paths) {
      match resolve_import_fs_path(path, Array::get(import_paths, i)) {
        Some(dep_path) => {
          out = load_fixture_sources(dep_path, spec, out)
        },
        None => ()
      }
      i = i + 1
    }
    out
  }
}

let load_real_fixture_sources: (String) -> Array[(String, String)] with { Fs, Error } = (path) -> {
  let source = perform Fs::ReadFile(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  load_fixture_sources(path, spec, empty_string_pairs())
}

let rewrite_real_fixture_source: (String) -> String with { Fs, Error } = (path) -> {
  let source = perform Fs::ReadFile(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  rewrite_fixture_source(path, source, spec)
}

let typecheck_real_fixture_selfhost: (String) -> Unit with { Fs, Error } = (path) -> {
  let sources = load_real_fixture_sources(path)
  let _checked = db_typecheck(seed_type_db(sources), path)
  ()
}
