//# Imports

import ../json {
  Json, json_as_arr, json_as_bool, json_as_obj, json_as_str, parse
}

import ../module {
  dir_of, resolve_path
}

import ../shell {
  split, trim
}

import ./core {
  Expr, Pat, Stmt
}

import ./eval_stmt.vibe {
  eval_with_imports_lookup
}

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./printer.vibe {
  print_program
}

import ./runtime / eval_loader {
  source_lookup
}

import ./runtime {
  db_new, db_set_source, db_typecheck
}

//# Types

export struct FixtureSpec {
  last: Option[String];
  effects: Option[Array[String]];
  error_contains: Option[String];
  todo: Bool;
  skip: Bool;
  version_refs: Map[String, String];
  symbol_refs: Map[String, String]
}

//# Functions

export let pp = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } {
    Error(msg) => "ERROR: \{msg}"
  }
}

let json_get = (obj: Map[String, Json], key: String) -> Option[Json] {
  if Map::has_key(obj, key) {
    Some(Map::get(obj, key))
  } else None
}

export let parse_ok = (src: String) -> Bool {
  let output = pp(src)
  if String::length(output) > 6 && String::substring(output, 0, 6) == "ERROR:" {
    false
  } else true
}

let join_lines = (lines: Array[String]) -> String {
  let len = Array::length(lines)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let next = Array::get(lines, i)
      let merged = if i == 0 {
        next
      } else {
        "\{acc}\n\{next}"
      }
      go(i + 1, merged)
    }
  }
  go(0, "")
}

export let roundtrip_ok = (src: String) -> Bool {
  let output1 = pp(src)
  if String::length(output1) > 6 && String::substring(output1, 0, 6) == "ERROR:" {
    false
  } else {
    let output2 = pp(output1)
    output1 == output2
  }
}

let seed_type_db = (sources: Array[(String, String)]) -> TypeDb {
  let mut db = db_new()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    db = db_set_source(db, path, source)
    i = i + 1
  }
  db
}

let sort_strings = (items: Array[String]) -> Unit {
  let len = Array::length(items)
  if len < 2 {
    ()
  } else {
    let mut i = 0
    while i + 1 < len {
      let mut min_index = i
      let mut j = i + 1
      while j < len {
        let left = Array::get(items, j)
        let right = Array::get(items, min_index)
        if left < right {
          min_index = j
        }
        j = j + 1
      }
      if min_index != i {
        let tmp = Array::get(items, i)
        Array::set(items, i, Array::get(items, min_index))
        Array::set(items, min_index, tmp)
      }
      i = i + 1
    }
  }
}

let empty_strings = () -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

let split_fixture = (source: String, path: String) -> (String, String)with { Error } {
  let lines = split(source, "\n")
  let script_lines = ArrayBuilder::new()
  let data_lines = ArrayBuilder::new()
  let mut in_data = false
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if trim(line) == "__DATA__" {
      in_data = true
    } else if in_data {
      ArrayBuilder::push(data_lines, line)
    } else {
      ArrayBuilder::push(script_lines, line)
    }
    i = i + 1
  }
  if in_data {
    (join_lines(ArrayBuilder::freeze(script_lines)), join_lines(ArrayBuilder::freeze(data_lines)))
  } else {
    throw("[\{path}] missing __DATA__ section")
  }
}

let import_ref_name = (raw_path: String, prefix: String) -> Option[String] {
  let prefix_len = String::length(prefix)
  let raw_len = String::length(raw_path)
  if raw_len >= prefix_len && String::substring(raw_path, 0, prefix_len) == prefix {
    Some(String::substring(raw_path, prefix_len, raw_len))
  } else None
}

let json_bool_field = (obj: Map[String, Json], key: String) -> Bool with { Error } {
  match json_get(obj, key) {
    Some(JNull) => false,
    Some(json) => json_as_bool(json),
    None => false
  }
}

let string_array_eq = (a: Array[String], b: Array[String]) -> Bool {
  let len = Array::length(a)
  if len != Array::length(b) {
    false
  } else {
    let rec go = (i: Int) -> Bool {
      if i >= len {
        true
      } else if Array::get(a, i) == Array::get(b, i) {
        go(i + 1)
      } else false
    }
    go(0)
  }
}

let empty_string_map = () -> Map[String, String] {
  let b = MapBuilder::new()
  MapBuilder::freeze(b)
}

let json_string_field = (obj: Map[String, Json], key: String, _path: String) -> Option[String] with { Error } {
  match json_get(obj, key) {
    Some(JNull) => None,
    Some(json) => Some(json_as_str(json)),
    None => None
  }
}

let empty_string_pairs = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let rec append_import_paths = (stmts: Array[Stmt], acc: Array[String]) -> Array[String] {
  let mut out = acc
  let mut i = 0
  while i < Array::length(stmts) {
    out = match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::concat(out, [
        raw_path
      ]),
      SReExport(raw_path, _) => Array::concat(out, [
        raw_path
      ]),
      SModule(_, _, body) => append_import_paths(body, out),
      _ => out
    }
    i = i + 1
  }
  out
}

let json_string_map_field = (obj: Map[String, Json], key: String) -> Map[String, String] with { Error } {
  match json_get(obj, key) {
    Some(JNull) => empty_string_map(),
    Some(json) => {
      let raw = json_as_obj(json)
      let out = MapBuilder::new()
      let keys = Map::keys(raw)
      let mut i = 0
      while i < Array::length(keys) {
        let name = Array::get(keys, i)
        MapBuilder::set(out, name, json_as_str(Map::get(raw, name)))
        i = i + 1
      }
      MapBuilder::freeze(out)
    },
    None => empty_string_map()
  }
}

let source_pairs_has_path = (pairs: Array[(String, String)], path: String) -> Bool {
  let rec go = (i: Int) -> Bool {
    if i >= Array::length(pairs) {
      false
    } else {
      let (p, _) = Array::get(pairs, i)
      if p == path {
        true
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

let resolve_import_fs_path = (from_path: String, raw_path: String) -> Option[String] with { Fs } {
  let raw_index = "\{raw_path}/index.vibe"
  if Fs::is_file(raw_path) {
    Some(raw_path)
  } else if Fs::is_file(raw_index) {
    Some(raw_index)
  } else {
    let resolved = resolve_path(dir_of(from_path), raw_path)
    let resolved_index = "\{resolved}/index.vibe"
    if Fs::is_file(resolved) {
      Some(resolved)
    } else if Fs::is_file(resolved_index) {
      Some(resolved_index)
    } else {
      let len = String::length(raw_path)
      let root_raw = if len >= 2 && String::substring(raw_path, 0, 2) == "./" {
        String::substring(raw_path, 2, len)
      } else {
        raw_path
      }
      let root_index = "\{root_raw}/index.vibe"
      if Fs::is_file(root_raw) {
        Some(root_raw)
      } else if Fs::is_file(root_index) {
        Some(root_index)
      } else None
    }
  }
}

let json_string_array_field = (obj: Map[String, Json], key: String) -> Option[Array[String]] with { Error } {
  match json_get(obj, key) {
    Some(JNull) => None,
    Some(json) => {
      let items = json_as_arr(json)
      let out = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(items) {
        ArrayBuilder::push(out, json_as_str(Array::get(items, i)))
        i = i + 1
      }
      Some(ArrayBuilder::freeze(out))
    },
    None => None
  }
}

export let parse_fixture_spec = (data: String, path: String) -> FixtureSpec with { Error } {
  let (root, _) = parse(data)
  let obj = json_as_obj(root)
  let error_contains = match json_string_field(obj, "error_contains", path) {
    Some(value) => Some(value),
    None => json_string_field(obj, "compile_error", path)
  }
  FixtureSpec::{
    last: json_string_field(obj, "last", path),
    effects: json_string_array_field(obj, "effects"),
    error_contains: error_contains,
    todo: json_bool_field(obj, "todo") || json_bool_field(obj, "TODO"),
    skip: json_bool_field(obj, "skip"),
    version_refs: json_string_map_field(obj, "version_refs"),
    symbol_refs: json_string_map_field(obj, "symbol_refs")
  }
}

export let list_root_fixture_paths = (fixture_dir: String) -> Array[String] with { Fs } {
  let names = Fs::readdir(fixture_dir)
  let files = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(names) {
    let name = Array::get(names, i)
    let path = "\{fixture_dir}/\{name}"
    if Fs::is_file(path) && String::ends_with(path, ".vibe") {
      ArrayBuilder::push(files, path)
    }
    i = i + 1
  }
  let sorted = ArrayBuilder::freeze(files)
  sort_strings(sorted)
  sorted
}

let resolve_ref_import_path = (current_path: String, raw_path: String, spec: FixtureSpec) -> String with { Error, Fs } {
  match import_ref_name(raw_path, "version@") {
    Some(name) => if Map::has_key(spec.version_refs, name) {
      let target = Map::get(spec.version_refs, name)
      match resolve_import_fs_path(current_path, target) {
        Some(path) => path,
        None => throw("unresolved version ref target: \{target}")
      }
    } else {
      throw("missing version ref: \{name}")
    },
    None => match import_ref_name(raw_path, "symbol@") {
      Some(name) => if Map::has_key(spec.symbol_refs, name) {
        let target = Map::get(spec.symbol_refs, name)
        match resolve_import_fs_path(current_path, target) {
          Some(path) => path,
          None => throw("unresolved symbol ref target: \{target}")
        }
      } else {
        throw("missing symbol ref: \{name}")
      },
      None => raw_path
    }
  }
}

let rec rewrite_ref_stmts = (stmts: Array[Stmt], current_path: String, spec: FixtureSpec) -> Array[Stmt] with { Error, Fs } {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let next = match Array::get(stmts, i) {
      SImport(raw_path, names) => SImport(resolve_ref_import_path(current_path, raw_path, spec), names),
      SReExport(raw_path, names) => SReExport(resolve_ref_import_path(current_path, raw_path, spec), names),
      SModule(exported, name, body) => SModule(exported, name, rewrite_ref_stmts(body, current_path, spec)),
      stmt => stmt
    }
    ArrayBuilder::push(out, next)
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

let rewrite_ref_import_line = (line: String, current_path: String, spec: FixtureSpec) -> String with { Error, Fs } {
  let version_idx = String::index_of(line, "version@")
  let symbol_idx = String::index_of(line, "symbol@")
  let marker_idx = if version_idx >= 0 {
    version_idx
  } else {
    symbol_idx
  }
  if marker_idx < 0 {
    line
  } else {
    let marker = if version_idx >= 0 {
      "version@"
    } else {
      "symbol@"
    }
    let marker_len = String::length(marker)
    let rest = String::substring(line, marker_idx + marker_len, String::length(line))
    let brace_idx = String::index_of(rest, "{")
    if brace_idx < 0 {
      line
    } else {
      let ref_name = trim(String::substring(rest, 0, brace_idx))
      let raw_path = "\{marker}\{ref_name}"
      let resolved = resolve_ref_import_path(current_path, raw_path, spec)
      let before = String::substring(line, 0, marker_idx)
      let after = String::substring(rest, brace_idx, String::length(rest))
      "\{before}\{resolved}\{after}"
    }
  }
}

let rewrite_last_stmt_binding = (stmts: Array[Stmt], name: String) -> Array[Stmt] {
  let len = Array::length(stmts)
  if len == 0 {
    stmts
  } else {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      let stmt = Array::get(stmts, i)
      if i + 1 == len {
        match stmt {
          SExpr(expr) => ArrayBuilder::push(out, SLet(false, false, name, None, expr)),
          _ => ArrayBuilder::push(out, stmt)
        }
      } else {
        ArrayBuilder::push(out, stmt)
      }
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
}

let rec collect_expr_shell_effects = (expr: Expr) -> Array[String] {
  let rec collect_expr_array = (items: Array[Expr]) -> Array[String] {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(items) {
      let nested = collect_expr_shell_effects(Array::get(items, i))
      let mut j = 0
      while j < Array::length(nested) {
        ArrayBuilder::push(out, Array::get(nested, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
  let rec collect_arm_array = (arms: Array[(Pat, Expr)]) -> Array[String] {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(arms) {
      let (_, body) = Array::get(arms, i)
      let nested = collect_expr_shell_effects(body)
      let mut j = 0
      while j < Array::length(nested) {
        ArrayBuilder::push(out, Array::get(nested, j))
        j = j + 1
      }
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
  match expr {
    EInt(_) => empty_strings(),
    EFloat(_) => empty_strings(),
    EString(_) => empty_strings(),
    EBool(_) => empty_strings(),
    EIdent(_) => empty_strings(),
    EUnit => empty_strings(),
    ETuple(items) => collect_expr_array(items),
    EArray(items) => collect_expr_array(items),
    ERecord(fields) => {
      let exprs = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_expr) = Array::get(fields, i)
        ArrayBuilder::push(exprs, field_expr)
        i = i + 1
      }
      collect_expr_array(ArrayBuilder::freeze(exprs))
    },
    EIf(cond, then_expr, else_expr) => Array::concat(collect_expr_shell_effects(cond), Array::concat(collect_expr_shell_effects(then_expr), collect_expr_shell_effects(else_expr))),
    ELet(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    ELetRec(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    ELetMut(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    EAssign(_, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    EAssignOp(_, _, value, body) => Array::concat(collect_expr_shell_effects(value), collect_expr_shell_effects(body)),
    ESeq(left, right) => Array::concat(collect_expr_shell_effects(left), collect_expr_shell_effects(right)),
    EMatch(target, arms) => Array::concat(collect_expr_shell_effects(target), collect_arm_array(arms)),
    EHandle(target, arms) => Array::concat(collect_expr_shell_effects(target), collect_arm_array(arms)),
    EWhile(cond, body) => Array::concat(collect_expr_shell_effects(cond), collect_expr_shell_effects(body)),
    ELoop(params, body) => {
      let init_exprs = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        ArrayBuilder::push(init_exprs, init)
        i = i + 1
      }
      Array::concat(collect_expr_array(ArrayBuilder::freeze(init_exprs)), collect_expr_shell_effects(body))
    },
    EForIn(_, _, iter_expr, body) => Array::concat(collect_expr_shell_effects(iter_expr), collect_expr_shell_effects(body)),
    ECall(callee, args) => {
      let arg_effects = collect_expr_array(args)
      let call_effects = match callee {
        EIdent(name) => if name == "sh" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            EString(cmd) => [
              "ShellExec(\"\{cmd}\")"
            ],
            _ => empty_strings()
          }
        } else {
          empty_strings()
        },
        _ => empty_strings()
      }
      Array::concat(collect_expr_shell_effects(callee), Array::concat(arg_effects, call_effects))
    },
    EBinOp(_, left, right) => Array::concat(collect_expr_shell_effects(left), collect_expr_shell_effects(right)),
    EUnaryOp(_, inner) => collect_expr_shell_effects(inner),
    EFn(_, _, _, _, _, _) => empty_strings(),
    EDot(inner, _) => collect_expr_shell_effects(inner),
    ELabeledArg(_, _, inner) => collect_expr_shell_effects(inner),
    EThrow(inner) => collect_expr_shell_effects(inner),
    EBreak(Some(inner)) => collect_expr_shell_effects(inner),
    EBreak(None) => empty_strings(),
    EContinue(items) => collect_expr_array(items),
    EMap(fields) => {
      let exprs = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(fields) {
        let (_, field_expr) = Array::get(fields, i)
        ArrayBuilder::push(exprs, field_expr)
        i = i + 1
      }
      collect_expr_array(ArrayBuilder::freeze(exprs))
    },
    ESpread(inner) => collect_expr_shell_effects(inner),
    EStringInterp(_) => []
  }
}

let collect_stmt_shell_effects = (stmts: Array[Stmt]) -> Array[String] {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let nested = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_expr_shell_effects(expr),
      SLetMut(_, _, expr) => collect_expr_shell_effects(expr),
      STest(_, expr) => collect_expr_shell_effects(expr),
      SBench(_, expr) => collect_expr_shell_effects(expr),
      SExpr(expr) => collect_expr_shell_effects(expr),
      SModule(_, _, body) => collect_stmt_shell_effects(body),
      _ => empty_strings()
    }
    let mut j = 0
    while j < Array::length(nested) {
      ArrayBuilder::push(out, Array::get(nested, j))
      j = j + 1
    }
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

let rewrite_ref_imports_in_source = (source: String, current_path: String, spec: FixtureSpec) -> String with { Error, Fs } {
  let lines = split(source, "\n")
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(lines) {
    ArrayBuilder::push(out, rewrite_ref_import_line(Array::get(lines, i), current_path, spec))
    i = i + 1
  }
  join_lines(ArrayBuilder::freeze(out))
}

let strip_fixture_data_if_present = (source: String) -> String {
  let lines = split(source, "\n")
  let script_lines = ArrayBuilder::new()
  let mut i = 0
  let mut in_data = false
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    if trim(line) == "__DATA__" {
      in_data = true
    } else if not(in_data) {
      ArrayBuilder::push(script_lines, line)
    }
    i = i + 1
  }
  if in_data {
    join_lines(ArrayBuilder::freeze(script_lines))
  } else {
    source
  }
}

let rewrite_fixture_source = (path: String, source: String, spec: FixtureSpec) -> String with { Error, Fs } {
  let source1 = rewrite_ref_imports_in_source(strip_fixture_data_if_present(source), path, spec)
  let stmts = parse_program(lex(source1))
  let rewritten = rewrite_ref_stmts(stmts, path, spec)
  print_program(rewritten)
}

let rec load_fixture_sources = (path: String, spec: FixtureSpec, loaded: Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } {
  if source_pairs_has_path(loaded, path) {
    loaded
  } else {
    let source = Fs::read_file(path)
    let rewritten_source = rewrite_fixture_source(path, source, spec)
    let next_loaded = Array::concat(loaded, [
      (path, rewritten_source)
    ])
    let stmts = parse_program(lex(rewritten_source))
    let import_paths = append_import_paths(stmts, empty_strings())
    let mut out = next_loaded
    let mut i = 0
    while i < Array::length(import_paths) {
      match resolve_import_fs_path(path, Array::get(import_paths, i)) {
        Some(dep_path) => {
          out = load_fixture_sources(dep_path, spec, out)
        },
        None => ()
      }
      i = i + 1
    }
    out
  }
}

export let load_real_fixture_sources = (path: String) -> Array[(String, String)] with { Fs, Error } {
  let source = Fs::read_file(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  load_fixture_sources(path, spec, empty_string_pairs())
}

export let eval_real_fixture_last = (path: String) -> String with { Fs, Error } {
  let sources = load_real_fixture_sources(path)
  let _checked = db_typecheck(seed_type_db(sources), path)
  let main_source = match source_lookup(sources, path) {
    Some(src) => src,
    None => throw("missing main source: \{path}")
  }
  let lookup_name = "__fixture_last"
  let stmts = parse_program(lex(main_source))
  eval_with_imports_lookup(rewrite_last_stmt_binding(stmts, lookup_name), sources, dir_of(path), lookup_name)
}

export let run_real_fixture_selfhost = (path: String) -> Unit with { Fs, Error } {
  let source = Fs::read_file(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  let error_text = handle {
    if spec.skip {
      ()
    } else {
      let sources = load_fixture_sources(path, spec, empty_string_pairs())
      let _checked = db_typecheck(seed_type_db(sources), path)
      let main_source = match source_lookup(sources, path) {
        Some(src) => src,
        None => throw("missing main source: \{path}")
      }
      let stmts = parse_program(lex(main_source))
      let actual_effects = collect_stmt_shell_effects(stmts)
      let lookup_name = "__fixture_last"
      let actual_last = eval_with_imports_lookup(rewrite_last_stmt_binding(stmts, lookup_name), sources, dir_of(path), lookup_name)
      match spec.error_contains {
        Some(expect) => throw("expected error containing: \{expect}"),
        None => ()
      }
      match spec.last {
        Some(expect) => if actual_last == expect {
          ()
        } else {
          throw("last mismatch: expected \{expect}, got \{actual_last}")
        },
        None => ()
      }
      match spec.effects {
        Some(expect) => if string_array_eq(expect, actual_effects) {
          ()
        } else {
          throw("effects mismatch in \{path}")
        },
        None => ()
      }
    }
    ""
  } {
    Error(msg) => msg
  }
  if spec.todo {
    if error_text == "" {
      throw("[\{path}] TODO fixture passed (remove TODO flag)")
    }
  } else if String::length(error_text) > 0 {
    match spec.error_contains {
      Some(expect) => if String::contains(error_text, expect) {
        ()
      } else {
        throw("error mismatch in \{path}: \{error_text}")
      },
      None => throw("unexpected error in \{path}: \{error_text}")
    }
  }
}

export let rewrite_real_fixture_source = (path: String) -> String with { Fs, Error } {
  let source = Fs::read_file(path)
  let (_script, data) = split_fixture(source, path)
  let spec = parse_fixture_spec(data, path)
  rewrite_fixture_source(path, source, spec)
}

export let run_preloaded_fixture_selfhost = (path: String, spec_data: String, sources: Array[(String, String)]) -> Unit with { Error } {
  let spec = parse_fixture_spec(spec_data, path)
  let error_text = handle {
    let _checked = db_typecheck(seed_type_db(sources), path)
    let main_source = match source_lookup(sources, path) {
      Some(src) => src,
      None => throw("missing main source: \{path}")
    }
    let stmts = parse_program(lex(main_source))
    let actual_effects = collect_stmt_shell_effects(stmts)
    let lookup_name = "__fixture_last"
    let actual_last = eval_with_imports_lookup(rewrite_last_stmt_binding(stmts, lookup_name), sources, dir_of(path), lookup_name)
    match spec.error_contains {
      Some(expect) => throw("expected error containing: \{expect}"),
      None => ()
    }
    match spec.last {
      Some(expect) => if actual_last == expect {
        ()
      } else {
        throw("last mismatch: expected \{expect}, got \{actual_last}")
      },
      None => ()
    }
    match spec.effects {
      Some(expect) => if string_array_eq(expect, actual_effects) {
        ()
      } else {
        throw("effects mismatch in \{path}")
      },
      None => ()
    }
    ""
  } {
    Error(msg) => msg
  }
  if spec.todo {
    if error_text == "" {
      throw("[\{path}] TODO fixture passed (remove TODO flag)")
    }
  } else if String::length(error_text) > 0 {
    match spec.error_contains {
      Some(expect) => if String::contains(error_text, expect) {
        ()
      } else {
        throw("error mismatch in \{path}: \{error_text}")
      },
      None => throw("unexpected error in \{path}: \{error_text}")
    }
  }
}

export let typecheck_real_fixture_selfhost = (path: String) -> Unit with { Fs, Error } {
  let sources = load_real_fixture_sources(path)
  let _checked = db_typecheck(seed_type_db(sources), path)
  ()
}
