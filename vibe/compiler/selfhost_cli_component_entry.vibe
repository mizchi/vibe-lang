//# Imports

import ./checker {
  check_program
}

import ./codegen {
  compile_wasi_module
}

import ./entry / source_compile {
  compile_source_wasi
}

import ./syntax {
  lex, parse_program
}

//# Functions

export let compile_cli_request = (source: String, request: String) -> Int {
  handle {
    let request_len = String::length(request)
    if request == "probe:const" {
      1
    }
    else if request == "probe:lex-fixed" {
      let _ = lex("let answer = () -> Int { 40 + 2 }")
      1
    }
    else if request == "probe:parse-fixed" {
      let _ = parse_program(lex("let answer = () -> Int { 40 + 2 }"))
      1
    }
    else if request == "probe:check-fixed" {
      let stmts = parse_program(lex("let answer = () -> Int { 40 + 2 }"))
      let _ = check_program(stmts)
      1
    }
    else if request == "probe:compile-inline-fixed-len" {
      let stmts = parse_program(lex("let answer = () -> Int { 40 + 2 }"))
      let _ = check_program(stmts)
      let bytes = compile_wasi_module(stmts, "answer")
      Bytes::length(bytes)
    }
    else if request == "probe:compile-inline-dynamic-len" {
      let stmts = parse_program(lex(source))
      let _ = check_program(stmts)
      let bytes = compile_wasi_module(stmts, "answer")
      Bytes::length(bytes)
    }
    else if request == "probe:compile-fixed-len" {
      let bytes = compile_source_wasi("let answer = () -> Int { 40 + 2 }", "answer")
      Bytes::length(bytes)
    }
    else if request == "probe:compile-dynamic-source-len" {
      let bytes = compile_source_wasi(source, "answer")
      Bytes::length(bytes)
    }
    else if request_len >= 4 && String::substring(request, 0, 4) == "len:" {
      let entry_name = String::substring(request, 4, request_len)
      let bytes = compile_source_wasi(source, entry_name)
      Bytes::length(bytes)
    }
    else if request_len >= 6 && String::substring(request, 0, 6) == "chunk:" {
      let mut sep = -1
      let mut i = 6
      while i < request_len && sep == -1 {
        if String::char_code_at(request, i) == 58 {
          sep = i
        } else {
          i = i + 1
        }
      }
      if sep == -1 {
        0
      } else {
        let entry_name = String::substring(request, 6, sep)
        let mut chunk_index = 0
        let mut j = sep + 1
        while j < request_len {
          let c = String::char_code_at(request, j)
          if c < 48 || c > 57 {
            throw("invalid int")
          } else {
            chunk_index = chunk_index * 10 + (c - 48)
            j = j + 1
          }
        }
        let bytes = compile_source_wasi(source, entry_name)
        let bytes_len = Bytes::length(bytes)
        let start = chunk_index * 7
        let mut out = 0
        let mut shift = 0
        let mut k = 0
        while k < 7 && start + k < bytes_len {
          out = out|(Bytes::get(bytes, start + k)<<shift)
          k = k + 1
          shift = shift + 8
        }
        out
      }
    }
    else {
      0
    }
  } {
    Error(_) => -1
  }
}
