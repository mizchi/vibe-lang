//# Imports

import ./types.vibe {
  Type, types_equal
}

import ./checker_builtins.vibe {
  infer_array_get, infer_array_element, infer_array_slice,
  infer_array_length, infer_string_op, infer_map_op,
  infer_builtin_call
}

//# Tests

test "infer_array_get with CtArray(CtInt) returns CtInt" {
  let result = infer_array_get(CtArray(CtInt))
  assert(types_equal(result, CtInt))
}

test "infer_array_get with non-array returns CtUnknown" {
  let result = infer_array_get(CtString)
  assert(types_equal(result, CtUnknown))
}

test "infer_array_element with CtArray(CtString) returns CtString" {
  let result = infer_array_element(CtArray(CtString))
  assert(types_equal(result, CtString))
}

test "infer_array_slice with CtArray(CtInt) returns CtArray(CtInt)" {
  let result = infer_array_slice(CtArray(CtInt))
  assert(types_equal(result, CtArray(CtInt)))
}

test "infer_array_length returns CtInt" {
  let result = infer_array_length()
  assert(types_equal(result, CtInt))
}

test "infer_string_op string_length returns CtInt" {
  let result = infer_string_op("string_length")
  assert(types_equal(result, CtInt))
}

test "infer_string_op string_concat returns CtString" {
  let result = infer_string_op("string_concat")
  assert(types_equal(result, CtString))
}

test "infer_string_op string_equals returns CtBool" {
  let result = infer_string_op("string_equals")
  assert(types_equal(result, CtBool))
}

test "infer_map_op map_has returns CtBool" {
  let result = infer_map_op("map_has")
  assert(types_equal(result, CtBool))
}

test "infer_map_op map_keys returns CtArray(CtString)" {
  let result = infer_map_op("map_keys")
  assert(types_equal(result, CtArray(CtString)))
}

test "infer_builtin_call array_get with CtArray(CtInt)" {
  let result = infer_builtin_call("array_get", [CtArray(CtInt), CtInt])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call array_length returns CtInt" {
  let result = infer_builtin_call("array_length", [CtArray(CtString)])
  assert(types_equal(result, CtInt))
}

test "infer_builtin_call string_equals returns CtBool" {
  let result = infer_builtin_call("string_equals", [CtString, CtString])
  assert(types_equal(result, CtBool))
}

test "infer_builtin_call print returns CtUnit" {
  let result = infer_builtin_call("print", [CtString])
  assert(types_equal(result, CtUnit))
}

test "infer_builtin_call eq returns CtBool" {
  let result = infer_builtin_call("eq", [CtInt, CtInt])
  assert(types_equal(result, CtBool))
}

test "infer_builtin_call unknown_fn returns CtUnknown" {
  let result = infer_builtin_call("unknown_fn", [CtInt])
  assert(types_equal(result, CtUnknown))
}
