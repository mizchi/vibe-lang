//# Imports

import ./types.vibe {
  Type
}

//# Functions

export let infer_map_op = (op_name: String) -> Type {
  if String::equals(op_name, "Map::get") {
    CtUnknown
  }
  else if String::equals(op_name, "map_has") {
    CtBool
  }
  else if String::equals(op_name, "Map::keys") {
    CtArray(CtString)
  }
  else if String::equals(op_name, "MapBuilder::new") {
    CtUnknown
  }
  else if String::equals(op_name, "MapBuilder::set") {
    CtUnit
  }
  else if String::equals(op_name, "MapBuilder::freeze") {
    CtUnknown
  }
  else CtUnknown
}

export let infer_array_get = (array_ty: Type) -> Type {
  match array_ty {
    CtArray(elem) => elem,
    _ => CtUnknown
  }
}

export let infer_string_op = (op_name: String) -> Type {
  if String::equals(op_name, "String::length") {
    CtInt
  }
  else if String::equals(op_name, "String::concat") {
    CtString
  }
  else if String::equals(op_name, "String::equals") {
    CtBool
  }
  else if String::equals(op_name, "string_slice") {
    CtString
  }
  else if String::equals(op_name, "string_char_at") {
    CtString
  }
  else if String::equals(op_name, "String::index_of") {
    CtInt
  }
  else if String::equals(op_name, "String::contains") {
    CtBool
  }
  else if String::equals(op_name, "String::starts_with") {
    CtBool
  }
  else if String::equals(op_name, "String::ends_with") {
    CtBool
  }
  else CtUnknown
}

export let infer_array_slice = (array_ty: Type) -> Type {
  match array_ty {
    CtArray(_) => array_ty,
    _ => CtUnknown
  }
}

export let infer_array_length = () -> Type {
  CtInt
}

export let infer_builtin_call = (name: String, arg_types: Array[Type]) -> Type {
  if String::equals(name, "array_new") {
    CtArray(CtUnknown)
  }
  else if String::equals(name, "Array::get") {
    if Array::length(arg_types) > 0 {
      infer_array_get(Array::get(arg_types, 0))
    } else CtUnknown
  }
  else if String::equals(name, "Array::length") {
    CtInt
  }
  else if String::equals(name, "Array::push") {
    CtUnit
  }
  else if String::equals(name, "Array::slice") {
    if Array::length(arg_types) > 0 {
      infer_array_slice(Array::get(arg_types, 0))
    } else CtUnknown
  }
  else if String::equals(name, "Array::set") {
    CtUnit
  }
  else if String::equals(name, "Array::concat") {
    if Array::length(arg_types) > 0 {
      let first = Array::get(arg_types, 0)
      match first {
        CtArray(_) => first,
        _ => CtUnknown
      }
    } else CtUnknown
  }
  else if String::equals(name, "String::length") {
    CtInt
  }
  else if String::equals(name, "String::concat") {
    CtString
  }
  else if String::equals(name, "String::equals") {
    CtBool
  }
  else if String::equals(name, "string_slice") {
    CtString
  }
  else if String::equals(name, "String::substring") {
    CtString
  }
  else if String::equals(name, "string_char_at") {
    CtString
  }
  else if String::equals(name, "String::index_of") {
    CtInt
  }
  else if String::equals(name, "String::last_index_of") {
    CtInt
  }
  else if String::equals(name, "String::contains") {
    CtBool
  }
  else if String::equals(name, "String::starts_with") {
    CtBool
  }
  else if String::equals(name, "String::ends_with") {
    CtBool
  }
  else if String::equals(name, "String::from_char_code") {
    CtString
  }
  else if String::equals(name, "String::char_code_at") {
    CtInt
  }
  else if String::equals(name, "Map::get") {
    CtUnknown
  }
  else if String::equals(name, "map_has") {
    CtBool
  }
  else if String::equals(name, "Map::keys") {
    CtArray(CtString)
  }
  else if String::equals(name, "MapBuilder::new") {
    CtUnknown
  }
  else if String::equals(name, "MapBuilder::set") {
    CtUnit
  }
  else if String::equals(name, "MapBuilder::freeze") {
    CtUnknown
  }
  else if String::equals(name, "FixedArray::make") {
    CtUnknown
  }
  else if String::equals(name, "FixedArray::length") {
    CtInt
  }
  else if String::equals(name, "FixedArray::get") {
    if Array::length(arg_types) > 0 {
      infer_array_get(Array::get(arg_types, 0))
    } else CtUnknown
  }
  else if String::equals(name, "FixedArray::set") {
    CtUnit
  }
  else if String::equals(name, "FixedArray::unsafe_set") {
    CtUnit
  }
  else if String::equals(name, "FixedArray::blit") {
    CtUnit
  }
  else if String::equals(name, "int_to_string") {
    CtString
  }
  else if String::equals(name, "__to_string") {
    CtString
  }
  else if String::equals(name, "Int::to_double") {
    CtDouble
  }
  else if String::equals(name, "Double::to_int") {
    CtInt
  }
  else if String::equals(name, "print") {
    CtUnit
  }
  else if String::equals(name, "println") {
    CtUnit
  }
  else if String::equals(name, "assert") {
    CtUnit
  }
  else if String::equals(name, "eq") {
    CtBool
  }
  else if String::equals(name, "not") {
    CtBool
  }
  else if String::equals(name, "sh") {
    CtString
  }
  else if String::equals(name, "sh_lines") {
    CtArray(CtString)
  }
  else if String::equals(name, "Path::to_string") {
    CtString
  }
  else if String::equals(name, "Path::is_absolute") {
    CtBool
  }
  else if String::equals(name, "PromptText::new") {
    CtString
  }
  else if String::equals(name, "Stdin::read_char") {
    CtInt
  }
  else if String::equals(name, "Stdin::read_stream") {
    CtString
  }
  else if String::equals(name, "Stdout::write_char") {
    CtUnit
  }
  else if String::equals(name, "Stdout::write_stream") {
    CtUnit
  }
  else if String::equals(name, "Env::get") {
    CtString
  }
  else if String::equals(name, "Env::args_len") {
    CtInt
  }
  else if String::equals(name, "Env::args_get") {
    CtString
  }
  else if String::equals(name, "sleep") {
    CtUnit
  }
  else if String::equals(name, "Path::resolve") {
    CtString
  }
  else if String::equals(name, "Fs::read_file") {
    CtString
  }
  else if String::equals(name, "Fs::write_file") {
    CtUnit
  }
  else if String::equals(name, "Fs::read_bytes") {
    CtBytes
  }
  else if String::equals(name, "Fs::write_bytes") {
    CtUnit
  }
  else if String::equals(name, "Fs::exists") {
    CtBool
  }
  else if String::equals(name, "Fs::stat_token") {
    CtInt
  }
  else if String::equals(name, "Fs::readdir") {
    CtArray(CtString)
  }
  else if String::equals(name, "Fs::is_dir") {
    CtBool
  }
  else if String::equals(name, "Fs::is_file") {
    CtBool
  }
  else if String::equals(name, "Fs::mkdir") {
    CtUnit
  }
  else if String::equals(name, "Fs::getcwd") {
    CtString
  }
  else if String::equals(name, "Fs::chdir") {
    CtUnit
  }
  else if String::equals(name, "Fs::remove") {
    CtUnit
  }
  else if String::equals(name, "Fs::copy") {
    CtUnit
  }
  else if String::equals(name, "Fs::append") {
    CtUnit
  }
  else if String::equals(name, "Socket::tcp_connect") {
    CtUnknown
  }
  else if String::equals(name, "Socket::tcp_read") {
    CtString
  }
  else if String::equals(name, "Socket::tcp_write") {
    CtInt
  }
  else if String::equals(name, "Socket::tcp_close") {
    CtUnit
  }
  else if String::equals(name, "Http::request") {
    CtUnknown
  }
  else if String::equals(name, "Http::response_status") {
    CtInt
  }
  else if String::equals(name, "Http::response_header") {
    CtString
  }
  else if String::equals(name, "Http::response_body") {
    CtString
  }
  else if String::equals(name, "Http::close") {
    CtUnit
  }
  else if String::equals(name, "Http::listen") {
    CtUnknown
  }
  else if String::equals(name, "Http::accept") {
    CtUnknown
  }
  else if String::equals(name, "Http::request_method") {
    CtString
  }
  else if String::equals(name, "Http::request_header") {
    CtString
  }
  else if String::equals(name, "Http::respond") {
    CtUnit
  }
  else CtUnknown
}

export let infer_array_element = (array_ty: Type) -> Type {
  match array_ty {
    CtArray(elem) => elem,
    _ => CtUnknown
  }
}
