//# Imports

import ./types.vibe {
  Type
}

//# Functions

export let infer_array_get = (array_ty: Type) -> Type {
  match array_ty {
    CtArray(elem) => elem,
    _ => CtUnknown
  }
}

export let infer_array_element = (array_ty: Type) -> Type {
  match array_ty {
    CtArray(elem) => elem,
    _ => CtUnknown
  }
}

export let infer_array_slice = (array_ty: Type) -> Type {
  match array_ty {
    CtArray(_) => array_ty,
    _ => CtUnknown
  }
}

export let infer_array_length = () -> Type {
  CtInt
}

export let infer_string_op = (op_name: String) -> Type {
  if string_equals(op_name, "string_length") {
    CtInt
  }
  else if string_equals(op_name, "string_concat") {
    CtString
  }
  else if string_equals(op_name, "string_equals") {
    CtBool
  }
  else if string_equals(op_name, "string_slice") {
    CtString
  }
  else if string_equals(op_name, "string_char_at") {
    CtString
  }
  else if string_equals(op_name, "string_index_of") {
    CtInt
  }
  else if string_equals(op_name, "string_contains") {
    CtBool
  }
  else if string_equals(op_name, "string_starts_with") {
    CtBool
  }
  else if string_equals(op_name, "string_ends_with") {
    CtBool
  }
  else CtUnknown
}

export let infer_map_op = (op_name: String) -> Type {
  if string_equals(op_name, "map_get") {
    CtUnknown
  }
  else if string_equals(op_name, "map_has") {
    CtBool
  }
  else if string_equals(op_name, "map_keys") {
    CtArray(CtString)
  }
  else if string_equals(op_name, "map_builder") {
    CtUnknown
  }
  else if string_equals(op_name, "map_builder_set") {
    CtUnit
  }
  else if string_equals(op_name, "map_builder_freeze") {
    CtUnknown
  }
  else CtUnknown
}

export let infer_builtin_call = (name: String, arg_types: Array[Type]) -> Type {
  if string_equals(name, "array_get") {
    if array_length(arg_types) > 0 {
      infer_array_get(array_get(arg_types, 0))
    } else CtUnknown
  }
  else if string_equals(name, "array_length") {
    CtInt
  }
  else if string_equals(name, "array_push") {
    CtUnit
  }
  else if string_equals(name, "array_slice") {
    if array_length(arg_types) > 0 {
      infer_array_slice(array_get(arg_types, 0))
    } else CtUnknown
  }
  else if string_equals(name, "array_set") {
    CtUnit
  }
  else if string_equals(name, "array_concat") {
    if array_length(arg_types) > 0 {
      let first = array_get(arg_types, 0)
      match first {
        CtArray(_) => first,
        _ => CtUnknown
      }
    } else CtUnknown
  }
  else if string_equals(name, "string_length") {
    CtInt
  }
  else if string_equals(name, "string_concat") {
    CtString
  }
  else if string_equals(name, "string_equals") {
    CtBool
  }
  else if string_equals(name, "string_slice") {
    CtString
  }
  else if string_equals(name, "string_substring") {
    CtString
  }
  else if string_equals(name, "string_char_at") {
    CtString
  }
  else if string_equals(name, "string_index_of") {
    CtInt
  }
  else if string_equals(name, "string_last_index_of") {
    CtInt
  }
  else if string_equals(name, "string_contains") {
    CtBool
  }
  else if string_equals(name, "string_starts_with") {
    CtBool
  }
  else if string_equals(name, "string_ends_with") {
    CtBool
  }
  else if string_equals(name, "string_from_char_code") {
    CtString
  }
  else if string_equals(name, "string_char_code_at") {
    CtInt
  }
  else if string_equals(name, "map_get") {
    CtUnknown
  }
  else if string_equals(name, "map_has") {
    CtBool
  }
  else if string_equals(name, "map_keys") {
    CtArray(CtString)
  }
  else if string_equals(name, "map_builder") {
    CtUnknown
  }
  else if string_equals(name, "map_builder_set") {
    CtUnit
  }
  else if string_equals(name, "map_builder_freeze") {
    CtUnknown
  }
  else if string_equals(name, "int_to_string") {
    CtString
  }
  else if string_equals(name, "__to_string") {
    CtString
  }
  else if string_equals(name, "int_to_double") {
    CtDouble
  }
  else if string_equals(name, "double_to_int") {
    CtInt
  }
  else if string_equals(name, "print") {
    CtUnit
  }
  else if string_equals(name, "println") {
    CtUnit
  }
  else if string_equals(name, "assert") {
    CtUnit
  }
  else if string_equals(name, "eq") {
    CtBool
  }
  else if string_equals(name, "not") {
    CtBool
  }
  else if string_equals(name, "sh") {
    CtString
  }
  else if string_equals(name, "sh_lines") {
    CtArray(CtString)
  }
  else if string_equals(name, "path_to_string") {
    CtString
  }
  else if string_equals(name, "path_is_absolute") {
    CtBool
  }
  else if string_equals(name, "prompt_text") {
    CtString
  }
  else if string_equals(name, "stdin_read_char") {
    CtInt
  }
  else if string_equals(name, "stdin_read_stream") {
    CtString
  }
  else if string_equals(name, "stdout_write_char") {
    CtUnit
  }
  else if string_equals(name, "stdout_write_stream") {
    CtUnit
  }
  else if string_equals(name, "env_get") {
    CtString
  }
  else if string_equals(name, "sleep") {
    CtUnit
  }
  else if string_equals(name, "dynamic_path_resolve") {
    CtString
  }
  else if string_equals(name, "fs_read_file") {
    CtString
  }
  else if string_equals(name, "fs_write_file") {
    CtUnit
  }
  else if string_equals(name, "fs_read_bytes") {
    CtBytes
  }
  else if string_equals(name, "fs_write_bytes") {
    CtUnit
  }
  else if string_equals(name, "fs_exists") {
    CtBool
  }
  else if string_equals(name, "fs_readdir") {
    CtArray(CtString)
  }
  else if string_equals(name, "fs_is_dir") {
    CtBool
  }
  else if string_equals(name, "fs_is_file") {
    CtBool
  }
  else if string_equals(name, "fs_mkdir") {
    CtUnit
  }
  else if string_equals(name, "fs_getcwd") {
    CtString
  }
  else if string_equals(name, "fs_chdir") {
    CtUnit
  }
  else if string_equals(name, "fs_remove") {
    CtUnit
  }
  else if string_equals(name, "fs_copy") {
    CtUnit
  }
  else if string_equals(name, "fs_append") {
    CtUnit
  }
  else if string_equals(name, "socket_tcp_connect") {
    CtUnknown
  }
  else if string_equals(name, "socket_tcp_read") {
    CtString
  }
  else if string_equals(name, "socket_tcp_write") {
    CtInt
  }
  else if string_equals(name, "socket_tcp_close") {
    CtUnit
  }
  else if string_equals(name, "http_request") {
    CtUnknown
  }
  else if string_equals(name, "http_response_status") {
    CtInt
  }
  else if string_equals(name, "http_response_header") {
    CtString
  }
  else if string_equals(name, "http_response_body") {
    CtString
  }
  else if string_equals(name, "http_close") {
    CtUnit
  }
  else if string_equals(name, "http_listen") {
    CtUnknown
  }
  else if string_equals(name, "http_accept") {
    CtUnknown
  }
  else if string_equals(name, "http_request_method") {
    CtString
  }
  else if string_equals(name, "http_request_header") {
    CtString
  }
  else if string_equals(name, "http_respond") {
    CtUnit
  }
  else CtUnknown
}
