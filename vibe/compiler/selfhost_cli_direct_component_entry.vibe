//# Imports

import ./entry / compiler / fs_compile {
  compile_with_closure_sources_wasi_mode_uncached
}

//# Functions

let cached_compile_key = Array::slice([""], 0, 0)

let cached_compile_len = Array::slice([0], 0, 0)

let cached_compile_bytes = Bytes::new()

let hex_chunk_size = 1024

let find_colon = (s: String, start: Int, end_: Int) -> Int {
  let mut out = -1
  let mut i = start
  while i < end_ && out == -1 {
    if String::char_code_at(s, i) == 58 {
      out = i
    } else {
      i = i + 1
    }
  }
  out
}

let parse_decimal_int = (s: String, start: Int, end_: Int) -> Int with { Error } {
  let mut out = 0
  let mut i = start
  while i < end_ {
    let c = String::char_code_at(s, i)
    if c < 48 || c > 57 {
      throw("invalid int")
    } else {
      out = out * 10 + (c - 48)
      i = i + 1
    }
  }
  out
}

let hex_digit = (n: Int) -> String {
  if n < 10 {
    String::from_char_code(48 + n)
  } else {
    String::from_char_code(87 + n)
  }
}

let dirname = (path: String) -> String {
  let len = String::length(path)
  let mut last_slash = -1
  let mut i = 0
  while i < len {
    if String::char_code_at(path, i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  if last_slash <= 0 {
    "."
  } else {
    path[0:last_slash]
  }
}

let relativize_path = (root_dir: String, path: String) -> String {
  let root_len = String::length(root_dir)
  let path_len = String::length(path)
  if root_len == 0 || root_dir == "." {
    path
  } else if path_len == root_len {
    path
  } else if path_len > root_len &&
    path[0:root_len] == root_dir &&
    String::char_code_at(path, root_len) == 47 {
    path[root_len + 1:path_len]
  } else {
    path
  }
}

let nibble_from_hex_char = (c: Int) -> Int with { Error } {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    throw("invalid hex digit")
  }
}

let decode_hex_payload = (hex: String) -> String with { Error } {
  let len = String::length(hex)
  if len % 2 != 0 {
    throw("invalid hex length")
  } else {
    let out = StringBuilder::new()
    let mut i = 0
    while i < len {
      let hi = nibble_from_hex_char(String::char_code_at(hex, i))
      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))
      StringBuilder::push(out, String::from_char_code(hi * 16 + lo))
      i = i + 2
    }
    StringBuilder::freeze(out)
  }
}

let cache_key_for = (source: String, entry_name: String, mode: String) -> String {
  String::concat(
    mode,
    String::concat("|", String::concat(entry_name, String::concat("|", source)))
  )
}

let cache_key_matches = (cache_key: String) -> Bool {
  Array::length(cached_compile_key) > 0 && Array::get(cached_compile_key, 0) == cache_key
}

let remember_compiled_bytes = (cache_key: String, bytes: Bytes) -> Int {
  let byte_len = Bytes::length(bytes)
  if Array::length(cached_compile_key) == 0 {
    Array::push(cached_compile_key, cache_key)
  } else {
    Array::set(cached_compile_key, 0, cache_key)
  }
  if Array::length(cached_compile_len) == 0 {
    Array::push(cached_compile_len, byte_len)
  } else {
    Array::set(cached_compile_len, 0, byte_len)
  }
  let mut i = 0
  while i < byte_len {
    let byte = Bytes::get(bytes, i)
    if i < Bytes::length(cached_compile_bytes) {
      Bytes::set(cached_compile_bytes, i, byte)
    } else {
      Bytes::push(cached_compile_bytes, byte)
    }
    i = i + 1
  }
  byte_len
}

let ensure_compiled = (source: String, entry_name: String, mode: String) -> Int with { Error } {
  let cache_key = cache_key_for(source, entry_name, mode)
  if cache_key_matches(cache_key) {
    Array::get(cached_compile_len, 0)
  } else {
    let payload = decode_hex_payload(source)
    let parts = String::split(payload, String::from_char_code(0))
    if Array::length(parts) < 2 || Array::length(parts) % 2 != 0 {
      throw("invalid closure payload")
    } else {
      let main_path = Array::get(parts, 0)
      let main_source = Array::get(parts, 1)
      let root_dir = dirname(main_path)
      let normalized_main_path = relativize_path(root_dir, main_path)
      let sources = Array::slice([("", "")], 0, 0)
      let mut i = 2
      while i + 1 < Array::length(parts) {
        Array::push(
          sources,
          (relativize_path(root_dir, Array::get(parts, i)), Array::get(parts, i + 1))
        )
        i = i + 2
      }
      let bytes = compile_with_closure_sources_wasi_mode_uncached(
        main_source,
        normalized_main_path,
        sources,
        entry_name,
        mode
      )
      remember_compiled_bytes(cache_key, bytes)
    }
  }
}

let encode_cached_hex_chunk = (start: Int, count: Int) -> String {
  let out = StringBuilder::new()
  let mut i = 0
  while i < count {
    let byte = Bytes::get(cached_compile_bytes, start + i)
    StringBuilder::push(out, hex_digit((byte>>4)&15))
    StringBuilder::push(out, hex_digit(byte&15))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

export let compile_cli_request = (source: String, request: String) -> String {
  handle {
    let request_len = String::length(request)
    if request == "probe-part-count" {
      let payload = decode_hex_payload(source)
      __to_string(Array::length(String::split(payload, String::from_char_code(0))))
    }
    else if request == "probe-main-source-len" {
      let payload = decode_hex_payload(source)
      let parts = String::split(payload, String::from_char_code(0))
      if Array::length(parts) < 2 {
        ""
      } else {
        __to_string(String::length(Array::get(parts, 1)))
      }
    }
    else if request_len >= 9 && request[0:9] == "len-mode:" {
      let sep = find_colon(request, 9, request_len)
      if sep == -1 {
        ""
      } else {
        let mode = request[9:sep]
        let entry_name = request[sep + 1:request_len]
        __to_string(ensure_compiled(source, entry_name, mode))
      }
    }
    else if request_len >= 15 && request[0:15] == "hex-chunk-mode:" {
      let mode_sep = find_colon(request, 15, request_len)
      if mode_sep == -1 {
        ""
      } else {
        let entry_sep = find_colon(request, mode_sep + 1, request_len)
        if entry_sep == -1 {
          ""
        } else {
          let mode = request[15:mode_sep]
          let entry_name = request[mode_sep + 1:entry_sep]
          let chunk_index = parse_decimal_int(request, entry_sep + 1, request_len)
          let byte_len = ensure_compiled(source, entry_name, mode)
          let start = chunk_index * hex_chunk_size
          if start < 0 || start >= byte_len {
            ""
          } else {
            let remaining = byte_len - start
            let count = if remaining < hex_chunk_size {
              remaining
            } else {
              hex_chunk_size
            }
            encode_cached_hex_chunk(start, count)
          }
        }
      }
    }
    else {
      ""
    }
  } {
    Error(_) => ""
  }
}
