import ./entry/compiler/fs_compile/index.vibe {
  compile_with_closure_sources_wasi_mode_cached
}

import ./runtime/index.vibe {
  db_new
}

let hex_digit = (n: Int) -> String {
  if n < 10 {
    String::from_char_code(48 + n)
  } else {
    String::from_char_code(87 + n)
  }
}

let encode_bytes_hex = (bytes: Bytes) -> String {
  let len = Bytes::length(bytes)
  let mut out = ""
  let mut i = 0
  while i < len {
    let byte = Bytes::get(bytes, i)
    out = String::concat(out, hex_digit((byte >> 4) & 15))
    out = String::concat(out, hex_digit(byte & 15))
    i = i + 1
  }
  out
}

export let compile_cli_hex = (source: String, entry_name: String, mode: String) -> String {
  handle {
    let parts = String::split(source, String::from_char_code(0))
    if Array::length(parts) < 2 || Array::length(parts) % 2 != 0 {
      ""
    } else {
      let main_path = Array::get(parts, 0)
      let main_source = Array::get(parts, 1)
      let sources = Array::slice([("", "")], 0, 0)
      let mut i = 2
      while i + 1 < Array::length(parts) {
        Array::push(sources, (Array::get(parts, i), Array::get(parts, i + 1)))
        i = i + 2
      }
      let (bytes, _) = compile_with_closure_sources_wasi_mode_cached(
        db_new(),
        main_source,
        main_path,
        sources,
        entry_name,
        mode
      )
      encode_bytes_hex(bytes)
    }
  } {
    Error(_) => ""
  }
}

0
