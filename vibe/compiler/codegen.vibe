// AST-to-WASM codegen — compiles vibe AST to WASM binary
// Supports: Int arithmetic, let/mut/assign, functions, if/else, while, calls,
// strings (packed i64 refs), tuples (heap), arrays (heap), match expressions

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,
  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

import ./wasm_emit.vibe {
  emit_header,
  emit_type_section, emit_type_section_multi,
  emit_function_section, emit_export_section, emit_export_section_multi,
  emit_code_section, emit_code_section_with_locals,
  emit_name, emit_func_type_raw,
  emit_import_section_func, emit_memory_section,
  emit_exports_with_memory, emit_data_section, emit_data_section_multi,
  emit_local_get, emit_local_set, emit_local_tee,
  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,
  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,
  emit_i64_shl, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,
  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,
  emit_i64_extend_i32_s, emit_i32_wrap_i64,
  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,
  emit_i32_store8, emit_i32_load8_u,
  emit_call, emit_drop, emit_return,
  emit_block_void, emit_block_i64, emit_loop_void,
  emit_if_void, emit_if_i64, emit_else, emit_end,
  emit_br, emit_br_if,
  emit_global_section_i32_mut, emit_global_get, emit_global_set,
  string_to_data
}

// === Additional i32/i64 ops not in wasm_emit ===

let emit_i32_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 107)  // 0x6B
}

let emit_i32_mul = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 108)  // 0x6C
}

let emit_i32_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 71)  // 0x47
}

let emit_i32_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 70)  // 0x46
}

let emit_i32_ge_u = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 79)  // 0x4F
}

let emit_i32_eqz = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 69)  // 0x45
}

let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 55)  // 0x37
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 41)  // 0x29
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

let emit_i64_extend_i32_u = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 173)  // 0xAD
}

let emit_memory_copy = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 252)  // 0xFC prefix
  leb128_encode_u32(buf, 10)  // memory.copy
  bytebuf_push(buf, 0)  // src memory
  bytebuf_push(buf, 0)  // dst memory
}

// === Compilation context ===

let resolve_local = (names: Array[String], name: String) -> Int with { Error } {
  let len = array_length(names)
  let rec search = (i: Int) -> Int with { Error } {
    if i < 0 {
      throw(string_concat("undefined variable: ", name))
    }
    if string_equals(array_get(names, i), name) {
      i
    } else search(i - 1)
  }
  search(len - 1)
}

// Resolve function: returns (func_index, param_count, has_return)
let resolve_func = (fn_names: Array[String], fn_indices: Array[Int], fn_params: Array[Int], fn_returns: Array[Int], name: String) -> (Int, Int, Int) with { Error } {
  let len = array_length(fn_names)
  let rec search = (i: Int) -> (Int, Int, Int) with { Error } {
    if i >= len {
      throw(string_concat("undefined function: ", name))
    }
    if string_equals(array_get(fn_names, i), name) {
      (array_get(fn_indices, i), array_get(fn_params, i), array_get(fn_returns, i))
    } else search(i + 1)
  }
  search(0)
}

// === String table ===

let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}

let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {
  match expr {
    EString(s) => {
      let mut found = false
      let mut i = 0
      while i < array_length(out) {
        if string_equals(array_get(out, i), s) {
          found = true
        }
        i = i + 1
      }
      if !found { array_push(out, s) }
      0
    },
    EBinOp(_, lhs, rhs) => {
      collect_strings_expr(lhs, out)
      collect_strings_expr(rhs, out)
    },
    EUnaryOp(_, operand) => collect_strings_expr(operand, out),
    EIf(cond, then_e, else_e) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(then_e, out)
      collect_strings_expr(else_e, out)
    },
    ECall(callee, args) => {
      collect_strings_expr(callee, out)
      let mut i = 0
      while i < array_length(args) {
        collect_strings_expr(array_get(args, i), out)
        i = i + 1
      }
      0
    },
    ELet(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetRec(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetMut(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssign(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssignOp(_, _, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ESeq(first, second) => {
      collect_strings_expr(first, out)
      collect_strings_expr(second, out)
    },
    EWhile(cond, body) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(body, out)
    },
    EForIn(_, iter_e, body) => {
      collect_strings_expr(iter_e, out)
      collect_strings_expr(body, out)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        collect_strings_expr(array_get(elems, i), out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        collect_strings_expr(array_get(elems, i), out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_strings_expr(scrutinee, out)
      let mut i = 0
      while i < array_length(arms) {
        let (_, arm_expr) = array_get(arms, i)
        collect_strings_expr(arm_expr, out)
        i = i + 1
      }
      0
    },
    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),
    _ => 0
  }
}

let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {
  let out = array_slice([""], 0, 0)
  let mut i = 0
  while i < array_length(stmts) {
    match array_get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),
      _ => 0
    }
    i = i + 1
  }
  out
}

let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {
  let rec search = (i: Int) -> Int with { Error } {
    if i >= array_length(strs) {
      throw(string_concat("string not in table: ", s))
    }
    if string_equals(array_get(strs, i), s) {
      i
    } else search(i + 1)
  }
  search(0)
}

// Find the index of the first catch-all pattern in match arms
// Returns num_arms if no catch-all found
let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {
  let num = array_length(arms)
  let rec search = (idx: Int) -> Int {
    if idx >= num { num }
    else {
      let (p, _) = array_get(arms, idx)
      let is_catch = match p {
        PWild => true,
        PBind(_) => true,
        PTuple(_) => true,
        PCtor(_, args) => array_length(args) == 0,
        _ => false
      }
      if is_catch { idx } else search(idx + 1)
    }
  }
  search(0)
}

// === Expression compiler ===

let rec compile_expr = (
  buf: Array[Int],
  expr: Expr,
  local_names: Array[String],
  next_local: Int,
  fn_names: Array[String],
  fn_indices: Array[Int],
  fn_params: Array[Int],
  fn_returns: Array[Int],
  str_strs: Array[String],
  str_offsets: Array[Int],
  str_lengths: Array[Int],
  ld: Int  // loop depth: -1 = not in loop, 0+ = depth from while's loop block
) -> Int with { Error } {
  // shorthand for recursive call
  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {
    compile_expr(b, e, ln, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths, d)
  }
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b_val) => {
      emit_i64_const(buf, if b_val { 1 } else { 0 })
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(str_strs, s)
      emit_str_ref(buf, array_get(str_offsets, idx), array_get(str_lengths, idx))
      next_local
    },
    EIdent(name) => {
      let idx = resolve_local(local_names, name)
      emit_local_get(buf, idx)
      next_local
    },
    EBinOp(op, lhs, rhs) => {
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      if string_equals(op, "+") { emit_i64_add(buf) }
      else if string_equals(op, "-") { emit_i64_sub(buf) }
      else if string_equals(op, "*") { emit_i64_mul(buf) }
      else if string_equals(op, "/") { emit_i64_div_s(buf) }
      else if string_equals(op, "%") { emit_i64_rem_s(buf) }
      else if string_equals(op, "&") { emit_i64_and(buf) }
      else if string_equals(op, "|") { emit_i64_or(buf) }
      else if string_equals(op, "^") { emit_i64_xor(buf) }
      else if string_equals(op, "<<") { emit_i64_shl(buf) }
      else if string_equals(op, ">>") { emit_i64_shr_s(buf) }
      else if string_equals(op, "==") { emit_i64_eq(buf); emit_i64_extend_i32_s(buf) }
      else if string_equals(op, "!=") { emit_i64_ne(buf); emit_i64_extend_i32_s(buf) }
      else if string_equals(op, "<") { emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf) }
      else if string_equals(op, ">") { emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf) }
      else if string_equals(op, "<=") { emit_i64_le_s(buf); emit_i64_extend_i32_s(buf) }
      else if string_equals(op, ">=") { emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf) }
      else if string_equals(op, "&&") { emit_i64_and(buf) }
      else if string_equals(op, "||") { emit_i64_or(buf) }
      else { throw(string_concat("unsupported binop: ", op)) }
      nl2
    },
    EUnaryOp(op, operand) => {
      if string_equals(op, "-") {
        emit_i64_const(buf, 0)
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_sub(buf)
        nl
      } else if string_equals(op, "!") {
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_eqz(buf)
        emit_i64_extend_i32_s(buf)
        nl
      } else {
        throw(string_concat("unsupported unary op: ", op))
      }
    },
    EIf(cond, then_e, else_e) => {
      let nl1 = ce(buf, cond, local_names, next_local, ld)
      emit_i32_wrap_i64(buf)
      emit_if_i64(buf)
      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }
      let nl2 = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      let nl3 = ce(buf, else_e, local_names, nl2, ld_inner)
      emit_end(buf)
      nl3
    },
    ECall(callee, args) => {
      match callee {
        EIdent(fname) => {
          let (fidx, _, has_ret) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, fname)
          let mut nl = next_local
          let mut ci = 0
          while ci < array_length(args) {
            nl = ce(buf, array_get(args, ci), local_names, nl, ld)
            ci = ci + 1
          }
          emit_call(buf, fidx)
          if has_ret == 0 {
            emit_i64_const(buf, 0)
          }
          nl
        },
        _ => throw("only direct function calls supported")
      }
    },
    ELet(name, value, body) => {
      let local_idx = next_local
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      array_push(local_names, name)
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    ELetRec(name, value, body) => {
      // Same as ELet for codegen (recursion handled by function-level indices)
      let local_idx = next_local
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      array_push(local_names, name)
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    ELetMut(name, value, body) => {
      let local_idx = next_local
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      array_push(local_names, name)
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name)
      let nl = ce(buf, value, local_names, next_local, ld)
      emit_local_set(buf, idx)
      ce(buf, body, local_names, nl, ld)
    },
    EAssignOp(name, op, value, body) => {
      // name = name op value
      let idx = resolve_local(local_names, name)
      emit_local_get(buf, idx)
      let nl = ce(buf, value, local_names, next_local, ld)
      if string_equals(op, "+") { emit_i64_add(buf) }
      else if string_equals(op, "-") { emit_i64_sub(buf) }
      else if string_equals(op, "*") { emit_i64_mul(buf) }
      else if string_equals(op, "/") { emit_i64_div_s(buf) }
      else if string_equals(op, "%") { emit_i64_rem_s(buf) }
      else { throw(string_concat("unsupported assign op: ", op)) }
      emit_local_set(buf, idx)
      ce(buf, body, local_names, nl, ld)
    },
    ESeq(first, second) => {
      let nl = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl, ld)
    },
    ETuple(elems) => {
      // Allocate N*8 bytes on heap, store each element as i64
      let num_elems = array_length(elems)
      let alloc_size = num_elems * 8
      // ptr_local stores heap ptr as i64 (user locals are i64)
      let ptr_local = next_local
      let mut nl = next_local + 1
      // ptr = heap_ptr as i64; heap_ptr += alloc_size
      emit_global_get(buf, 0)  // i32
      emit_i64_extend_i32_u(buf)  // -> i64
      emit_local_tee(buf, ptr_local)  // save as i64
      emit_i32_wrap_i64(buf)  // back to i32 for arithmetic
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      // Store each element
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)  // ptr as i32 for store
        nl = ce(buf, array_get(elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      // Return ptr as i64 (already stored as i64)
      emit_local_get(buf, ptr_local)
      array_push(local_names, "__tuple_ptr")
      nl
    },
    EMatch(scrutinee, arms) => {
      // Compile scrutinee, store in temp local
      let scrut_local = next_local
      let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)
      emit_local_set(buf, scrut_local)
      array_push(local_names, "__match_scrut")
      // Compile match arms as nested if-else
      // We build this iteratively: for each arm, emit condition check + body
      // Last arm (or PWild/PBind) just emits body directly
      let num_arms = array_length(arms)
      // Find first catch-all index using helper defined before compile_expr
      let catchall_idx = find_catchall_idx(arms)
      let num_cond_arms = catchall_idx
      // Emit nested if-else: each conditional arm opens if+else, closed after
      let mut ai = 0
      while ai < num_cond_arms {
        let (p, _) = array_get(arms, ai)
        match p {
          PInt(n) => {
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, n)
            emit_i64_eq(buf)
            emit_if_i64(buf)
            0
          },
          PBool(bv) => {
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, if bv { 1 } else { 0 })
            emit_i64_eq(buf)
            emit_if_i64(buf)
            0
          },
          _ => 0
        }
        // Compile arm body (inside ai+1 levels of if blocks)
        let (_, arm_body) = array_get(arms, ai)
        let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }
        ce(buf, arm_body, local_names, nl1, ld_arm)
        // Open else for next arm
        emit_else(buf)
        ai = ai + 1
      }
      // Compile catchall arm (or unreachable)
      // NOTE: Use array_length(local_names) instead of mutable final_nl
      // inside match arms (quirk #13b: mutable scalars don't propagate out of match)
      let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }
      if catchall_idx < num_arms {
        let (cp, cbody) = array_get(arms, catchall_idx)
        match cp {
          PBind(bname) => {
            let bind_local = array_length(local_names)
            emit_local_get(buf, scrut_local)
            emit_local_set(buf, bind_local)
            array_push(local_names, bname)
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
            0
          },
          PCtor(cname, cargs) => {
            if array_length(cargs) == 0 {
              let bind_local2 = array_length(local_names)
              emit_local_get(buf, scrut_local)
              emit_local_set(buf, bind_local2)
              array_push(local_names, cname)
              ce(buf, cbody, local_names, array_length(local_names), ld_catch)
            } else { 0 }
            0
          },
          PTuple(pats) => {
            // Destructure tuple: scrutinee is i64 (ptr as i64)
            let ptr_local2 = array_length(local_names)
            emit_local_get(buf, scrut_local)
            emit_local_set(buf, ptr_local2)  // keep as i64
            array_push(local_names, "__tup_ptr2")
            let mut pi2 = 0
            while pi2 < array_length(pats) {
              let tp = array_get(pats, pi2)
              match tp {
                PBind(pname) => {
                  let field_l = array_length(local_names)
                  emit_local_get(buf, ptr_local2)
                  emit_i32_wrap_i64(buf)  // ptr as i32 for load
                  emit_i64_load(buf, 3, pi2 * 8)
                  emit_local_set(buf, field_l)
                  array_push(local_names, pname)
                  0
                },
                PWild => 0,
                _ => throw("unsupported pattern in tuple destructure")
              }
              pi2 = pi2 + 1
            }
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
            0
          },
          _ => {
            // PWild or other catch-all
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
            0
          }
        }
      } else {
        // No catch-all: unreachable
        bytebuf_push(buf, 0)  // unreachable
        0
      }
      let final_nl = array_length(local_names)
      // Close all the if-else blocks
      let mut ci2 = 0
      while ci2 < num_cond_arms {
        emit_end(buf)
        ci2 = ci2 + 1
      }
      final_nl
    },
    EArray(elems) => {
      // Compile [a, b, c] as: let arr = array_new(); array_push(arr, a); ...
      let (arr_new_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_new")
      let (arr_push_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      array_push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < array_length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, array_get(elems, ei), local_names, nl, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    },
    EForIn(var_name, iter_expr, body) => {
      // for x in arr { body } => let arr = iter; let mut i = 0; while i < array_length(arr) { let x = array_get(arr, i); body; i = i + 1 }
      let (arr_len_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_length")
      let (arr_get_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_get")
      // Compile iterator and store
      let arr_local = next_local
      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)
      emit_local_set(buf, arr_local)
      array_push(local_names, "__for_arr")
      // Counter local
      let i_local = nl1
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      array_push(local_names, "__for_i")
      let nl2 = nl1 + 1
      // block { loop {
      emit_block_void(buf)
        emit_loop_void(buf)
          // if i >= array_length(arr) then break
          emit_local_get(buf, i_local)
          emit_local_get(buf, arr_local)
          emit_call(buf, arr_len_idx)
          emit_i64_ge_s(buf)
          emit_i64_extend_i32_s(buf)
          emit_i32_wrap_i64(buf)
          emit_br_if(buf, 1)
          // let var_name = array_get(arr, i)
          let var_local = nl2
          emit_local_get(buf, arr_local)
          emit_local_get(buf, i_local)
          emit_call(buf, arr_get_idx)
          emit_local_set(buf, var_local)
          array_push(local_names, var_name)
          let nl3 = nl2 + 1
          // body
          let nl4 = ce(buf, body, local_names, nl3, 0)
          emit_drop(buf)
          // i = i + 1
          emit_local_get(buf, i_local)
          emit_i64_const(buf, 1)
          emit_i64_add(buf)
          emit_local_set(buf, i_local)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl4
    },
    EWhile(cond, body) => {
      // block @break { loop @continue { cond; br_if 1; body; br 0 } }
      // Inside body: ld=0. EBreak => br (ld+1), EContinue => br ld
      emit_block_void(buf)
        emit_loop_void(buf)
          let nl1 = ce(buf, cond, local_names, next_local, 0)
          emit_i64_eqz(buf)
          emit_br_if(buf, 1)
          let nl2 = ce(buf, body, local_names, nl1, 0)
          emit_drop(buf)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
    },
    EBreak(_) => {
      // br to block (break target): loop is at ld, block is at ld+1
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
    },
    EContinue(_) => {
      // br to loop header (continue target): loop is at ld
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    EThrow(msg_expr) => {
      // Compile msg, then unreachable
      let nl = ce(buf, msg_expr, local_names, next_local, ld)
      emit_drop(buf)
      bytebuf_push(buf, 0)  // unreachable
      nl
    },
    _ => throw("unsupported expression in codegen")
  }
}


// === Module compiler (non-WASI, for --invoke) ===

export let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {
  let fn_names_list = array_slice([""], 0, 0)
  let fn_param_counts = array_slice([0], 0, 0)
  let export_names = array_slice([""], 0, 0)
  let export_indices = array_slice([0], 0, 0)

  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(is_export, _, name, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, _) => {
            let cur_idx = array_length(fn_names_list)
            array_push(fn_names_list, name)
            array_push(fn_param_counts, array_length(params))
            if is_export {
              array_push(export_names, name)
              array_push(export_indices, cur_idx)
            }
            0
          },
          _ => 0
        }
      },
      _ => 0
    }
    i = i + 1
  }

  let num_funcs = array_length(fn_names_list)
  if num_funcs == 0 {
    throw("no functions found to compile")
  }

  let fn_indices_list = array_slice([0], 0, 0)
  let fn_returns_list = array_slice([0], 0, 0)
  let mut fi = 0
  while fi < num_funcs {
    array_push(fn_indices_list, fi)
    array_push(fn_returns_list, 1)
    fi = fi + 1
  }

  let type_defs = array_slice([0], 0, 0)
  let mut ti = 0
  while ti < num_funcs {
    array_push(type_defs, array_get(fn_param_counts, ti))
    array_push(type_defs, 1)
    ti = ti + 1
  }

  let type_indices = array_slice([0], 0, 0)
  let mut tii = 0
  while tii < num_funcs {
    array_push(type_indices, tii)
    tii = tii + 1
  }

  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)
  let local_counts = array_slice([0], 0, 0)
  let mut bi = 0
  while bi < num_funcs {
    let stmt = find_func_stmt(stmts, array_get(fn_names_list, bi))
    match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, body) => {
            let body_buf = bytebuf_new()
            let local_names = array_slice([""], 0, 0)
            let mut pi = 0
            while pi < array_length(params) {
              let (pname, _) = array_get(params, pi)
              array_push(local_names, pname)
              pi = pi + 1
            }
            let param_count = array_length(params)
            let empty_strs = array_slice([""], 0, 0)
            let empty_offs = array_slice([0], 0, 0)
            let empty_lens = array_slice([0], 0, 0)
            let final_nl = compile_expr(
              body_buf, body, local_names,
              param_count,
              fn_names_list, fn_indices_list, fn_param_counts, fn_returns_list,
              empty_strs, empty_offs, empty_lens,
              -1
            )
            array_push(bodies, body_buf)
            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
            array_push(local_counts, extra)
          },
          _ => throw("expected function")
        }
      },
      _ => throw("expected let statement")
    }
    bi = bi + 1
  }

  let out = bytebuf_new()
  emit_header(out)
  emit_type_section_multi(out, type_defs)
  emit_function_section(out, type_indices)

  if array_length(export_names) > 0 {
    emit_export_section_multi(out, export_names, export_indices)
  }

  emit_code_section_with_locals(out, bodies, local_counts)
  bytebuf_to_bytes(out)
}

// === WASI Module compiler ===
// Memory layout:
//   0-7: iovec struct
//   8-11: nwritten
//   16-47: digit buffer (itoa + newline)
//   48-63: reserved
//   64+: string literal data
//   after strings: heap (bump allocator, global 0 = heap_ptr)

// Generate __print_i64 body (func 1)
// Param: 0=val(i64)
// Extra locals (i32 first, then i64): 1=is_neg(i32), 2=pos(i32), 3=digit(i32), 4=abs_val(i64)
let gen_print_i64_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
    emit_i64_const(b, 0)
    emit_local_get(b, 0)
    emit_i64_sub(b)
  emit_else(b)
    emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 48)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
    emit_loop_void(b)
      emit_local_get(b, 4)
      emit_i64_eqz(b)
      emit_br_if(b, 1)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_rem_s(b)
      emit_i32_wrap_i64(b)
      emit_local_set(b, 3)
      emit_local_get(b, 2)
      emit_local_get(b, 3)
      emit_i32_const(b, 48)
      emit_i32_add(b)
      emit_i32_store8(b, 0, 0)
      emit_local_get(b, 2)
      emit_i32_const(b, 1)
      emit_i32_sub(b)
      emit_local_set(b, 2)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_div_s(b)
      emit_local_set(b, 4)
      emit_br(b, 0)
    emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 45)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

// Generate __print_str body (func 2)
// local 0: packed(i64), local 1: offset(i32), local 2: length(i32)
let gen_print_str_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_i32_const(b, 0)
  emit_local_get(b, 1)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_local_get(b, 2)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

// Generate __str_len body (func 3): (packed: i64) -> i64
// Returns lower 32 bits as i64
let gen_str_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)  // 0xFFFFFFFF
  emit_i64_and(b)
  b
}

// Generate __str_eq body (func 4): (a: i64, b: i64) -> i64
// Compare string contents byte-by-byte
// locals: 0=a(i64), 1=b(i64), 2=len_a(i32), 3=len_b(i32),
//         4=off_a(i32), 5=off_b(i32), 6=i(i32)
let gen_str_eq_body = () -> Array[Int] {
  let b = bytebuf_new()
  // len_a = a & 0xFFFFFFFF
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // len_b = b & 0xFFFFFFFF
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // if len_a != len_b, return 0
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_ne(b)
  emit_if_i64(b)
    emit_i64_const(b, 0)
  emit_else(b)
    // off_a = (a >> 32) as i32
    emit_local_get(b, 0)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 4)
    // off_b = (b >> 32) as i32
    emit_local_get(b, 1)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 5)
    // i = 0
    emit_i32_const(b, 0)
    emit_local_set(b, 6)
    // loop: compare bytes
    emit_block_i64(b)
      emit_block_void(b)
        emit_loop_void(b)
          // if i >= len_a, break (all matched)
          emit_local_get(b, 6)
          emit_local_get(b, 2)
          emit_i32_ge_u(b)
          emit_br_if(b, 1)  // break to inner block_void
          // if mem[off_a+i] != mem[off_b+i], return 0
          emit_local_get(b, 4)
          emit_local_get(b, 6)
          emit_i32_add(b)
          emit_i32_load8_u(b, 0, 0)
          emit_local_get(b, 5)
          emit_local_get(b, 6)
          emit_i32_add(b)
          emit_i32_load8_u(b, 0, 0)
          emit_i32_ne(b)
          emit_if_void(b)
            emit_i64_const(b, 0)
            emit_br(b, 3)  // break to block_i64 with 0
          emit_end(b)
          // i++
          emit_local_get(b, 6)
          emit_i32_const(b, 1)
          emit_i32_add(b)
          emit_local_set(b, 6)
          emit_br(b, 0)  // continue loop
        emit_end(b)
      emit_end(b)
      // All bytes matched
      emit_i64_const(b, 1)
    emit_end(b)
  emit_end(b)
  b
}

// Generate __str_concat body (func 5): (a: i64, b: i64) -> i64
// Allocate new string, copy bytes, return packed ref
// locals: 0=a(i64), 1=b(i64), 2=len_a(i32), 3=len_b(i32),
//         4=off_a(i32), 5=off_b(i32), 6=new_ptr(i32), 7=new_len(i32)
let gen_str_concat_body = () -> Array[Int] {
  let b = bytebuf_new()
  // len_a = a & 0xFFFFFFFF
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // len_b
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // off_a = (a >> 32) as i32
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  // off_b
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  // new_len = len_a + len_b
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  // new_ptr = heap_ptr; heap_ptr += new_len
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // memory.copy(new_ptr, off_a, len_a)
  emit_local_get(b, 6)  // dest
  emit_local_get(b, 4)  // src
  emit_local_get(b, 2)  // len
  emit_memory_copy(b)
  // memory.copy(new_ptr + len_a, off_b, len_b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)   // dest = new_ptr + len_a
  emit_local_get(b, 5)  // src
  emit_local_get(b, 3)  // len
  emit_memory_copy(b)
  // Return packed ref: (new_ptr << 32) | new_len
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

// Generate __arr_new body (func 6): () -> i64
// Create empty array: [cap=8(i32), len=0(i32), data_ptr(i32)]
// Header: 12 bytes. Data: cap * 8 bytes.
// Returns header ptr as i64.
let gen_arr_new_body = () -> Array[Int] {
  let b = bytebuf_new()
  // local 0: header_ptr (i32)
  // Allocate header (12 bytes) + data (8*8 = 64 bytes) = 76 bytes
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // header[0] = cap = 8
  emit_local_get(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  // header[4] = len = 0
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  // header[8] = data_ptr = header_ptr + 12
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  // Return header_ptr as i64
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

// Generate __arr_len body (func 7): (arr: i64) -> i64
// Read header[4] = length
let gen_arr_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)  // header[4] = length
  emit_i64_extend_i32_u(b)
  b
}

// Generate __arr_get body (func 8): (arr: i64, idx: i64) -> i64
// Read data[idx * 8]
// local 0: arr(i64), local 1: idx(i64), local 2: data_ptr(i32)
let gen_arr_get_body = () -> Array[Int] {
  let b = bytebuf_new()
  // data_ptr = header[8]
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  // load data_ptr + idx*8
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  // i32.shl
  bytebuf_push(b, 116)  // 0x74 i32.shl
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  b
}

// Generate __arr_push body (func 9): (arr: i64, val: i64) -> void
// Append val to array, grow if needed
// local 0: arr(i64), local 1: val(i64), local 2: hdr(i32),
// local 3: cap(i32), local 4: len(i32), local 5: data_ptr(i32),
// local 6: new_data(i32), local 7: new_cap(i32)
let gen_arr_push_body = () -> Array[Int] {
  let b = bytebuf_new()
  // hdr = arr as i32
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // cap = hdr[0]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  // len = hdr[4]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  // data_ptr = hdr[8]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  // if len >= cap: grow
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_if_void(b)
    // new_cap = cap * 2
    emit_local_get(b, 3)
    emit_i32_const(b, 2)
    emit_i32_mul(b)
    emit_local_set(b, 7)
    // new_data = alloc(new_cap * 8)
    emit_global_get(b, 0)
    emit_local_tee(b, 6)
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_add(b)
    emit_global_set(b, 0)
    // memory.copy(new_data, data_ptr, len * 8)
    emit_local_get(b, 6)
    emit_local_get(b, 5)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    // update header
    emit_local_get(b, 2)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 0)  // cap = new_cap
    emit_local_get(b, 2)
    emit_local_get(b, 6)
    emit_i32_store(b, 2, 8)  // data_ptr = new_data
    // update local
    emit_local_get(b, 6)
    emit_local_set(b, 5)
  emit_end(b)
  // data[len] = val
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 1)
  emit_i64_store(b, 3, 0)
  // len++
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 4)
  b
}

// Generate __arr_set body (func 10): (arr: i64, idx: i64, val: i64) -> void
// local 0: arr(i64), local 1: idx(i64), local 2: val(i64), local 3: data_ptr(i32)
let gen_arr_set_body = () -> Array[Int] {
  let b = bytebuf_new()
  // data_ptr = header[8]
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  // data[idx*8] = val
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 2)
  emit_i64_store(b, 3, 0)
  b
}

// === Builtin registry ===
// Each builtin: (name, gen_body_fn_result, num_extra_locals, local_types_descriptor, param_count, has_return)
// local_types_descriptor: 0 = all i64, 1 = custom (handled in code section)

// Builtin descriptor indices (after fd_write import at func 0):
// func 1: __print_i64 — (i64) -> void, 4 mixed locals
// func 2: __print_str — (i64) -> void, 2 i32 locals
// func 3: __str_len — (i64) -> i64, 0 extra
// func 4: __str_eq — (i64,i64) -> i64, 5 i32 locals
// func 5: __str_concat — (i64,i64) -> i64, 6 i32 locals
// func 6: __arr_new — () -> i64, 1 i32 local
// func 7: __arr_len — (i64) -> i64, 0 extra
// func 8: __arr_get — (i64,i64) -> i64, 1 i32 local
// func 9: __arr_push — (i64,i64) -> void, 6 i32 locals
// func 10: __arr_set — (i64,i64,i64) -> void, 1 i32 local

export let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {
  // Collect user functions
  let fn_names_list = array_slice([""], 0, 0)
  let fn_param_counts = array_slice([0], 0, 0)

  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(_, _, name, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, _) => {
            array_push(fn_names_list, name)
            array_push(fn_param_counts, array_length(params))
            0
          },
          _ => 0
        }
      },
      _ => 0
    }
    i = i + 1
  }

  let num_user_funcs = array_length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }

  // Find entry function
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if string_equals(array_get(fn_names_list, ei), entry_name) {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  if entry_user_idx < 0 {
    throw(string_concat("entry function not found: ", entry_name))
  }

  // String table
  let str_strs = collect_strings_stmts(stmts)
  let num_strings = array_length(str_strs)
  let data_base = 64
  let str_offsets = array_slice([0], 0, 0)
  let str_lengths = array_slice([0], 0, 0)
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = array_get(str_strs, si)
    let slen = string_length(s)
    array_push(str_offsets, str_pos)
    array_push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  // Align heap start to 8 bytes
  let heap_start = ((str_pos + 7) / 8) * 8

  // Function layout:
  // func 0: fd_write (import)
  // func 1-10: generated builtins (10 funcs)
  // func 11..11+N-1: user functions
  // func 11+N: _start
  let num_generated = 10
  let func_offset = 1 + num_generated  // = 11

  // Register user-callable builtins
  // print_int -> func 1, print_str -> func 2
  // string_length -> func 3, string_equals -> func 4, string_concat -> func 5
  // array_new -> func 6, array_length -> func 7, array_get -> func 8
  // array_push -> func 9, array_set -> func 10
  array_push(fn_names_list, "print_int")
  array_push(fn_param_counts, 1)
  array_push(fn_names_list, "print_str")
  array_push(fn_param_counts, 1)
  array_push(fn_names_list, "string_length")
  array_push(fn_param_counts, 1)
  array_push(fn_names_list, "string_equals")
  array_push(fn_param_counts, 2)
  array_push(fn_names_list, "string_concat")
  array_push(fn_param_counts, 2)
  array_push(fn_names_list, "array_new")
  array_push(fn_param_counts, 0)
  array_push(fn_names_list, "array_length")
  array_push(fn_param_counts, 1)
  array_push(fn_names_list, "array_get")
  array_push(fn_param_counts, 2)
  array_push(fn_names_list, "array_push")
  array_push(fn_param_counts, 2)
  array_push(fn_names_list, "array_set")
  array_push(fn_param_counts, 3)

  // Build fn_indices and fn_returns
  let fn_indices_list = array_slice([0], 0, 0)
  let fn_returns_list = array_slice([0], 0, 0)
  let mut fi = 0
  while fi < num_user_funcs {
    array_push(fn_indices_list, fi + func_offset)
    array_push(fn_returns_list, 1)
    fi = fi + 1
  }
  // Builtin indices and returns
  array_push(fn_indices_list, 1)   // print_int
  array_push(fn_returns_list, 0)
  array_push(fn_indices_list, 2)   // print_str
  array_push(fn_returns_list, 0)
  array_push(fn_indices_list, 3)   // string_length
  array_push(fn_returns_list, 1)
  array_push(fn_indices_list, 4)   // string_equals
  array_push(fn_returns_list, 1)
  array_push(fn_indices_list, 5)   // string_concat
  array_push(fn_returns_list, 1)
  array_push(fn_indices_list, 6)   // array_new
  array_push(fn_returns_list, 1)
  array_push(fn_indices_list, 7)   // array_length
  array_push(fn_returns_list, 1)
  array_push(fn_indices_list, 8)   // array_get
  array_push(fn_returns_list, 1)
  array_push(fn_indices_list, 9)   // array_push
  array_push(fn_returns_list, 0)
  array_push(fn_indices_list, 10)  // array_set
  array_push(fn_returns_list, 0)

  // === Type section ===
  // type 0: fd_write (i32,i32,i32,i32) -> (i32)
  // type 1: (i64) -> () [print_int, print_str]
  // type 2: () -> () [_start]
  // type 3: (i64) -> (i64) [string_length, array_length]
  // type 4: (i64,i64) -> (i64) [string_equals, string_concat, array_get]
  // type 5: () -> (i64) [array_new]
  // type 6: (i64,i64) -> () [array_push]
  // type 7: (i64,i64,i64) -> () [array_set]
  // type 8+: user function types
  let num_base_types = 8
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, num_base_types + num_user_funcs)

  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write
  emit_func_type_raw(type_content, [126], array_slice([0], 0, 0))  // type 1: (i64)->()
  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))  // type 2: ()->()
  emit_func_type_raw(type_content, [126], [126])  // type 3: (i64)->(i64)
  emit_func_type_raw(type_content, [126, 126], [126])  // type 4: (i64,i64)->(i64)
  emit_func_type_raw(type_content, array_slice([0], 0, 0), [126])  // type 5: ()->(i64)
  emit_func_type_raw(type_content, [126, 126], array_slice([0], 0, 0))  // type 6: (i64,i64)->()
  emit_func_type_raw(type_content, [126, 126, 126], array_slice([0], 0, 0))  // type 7: (i64,i64,i64)->()

  let mut uti = 0
  while uti < num_user_funcs {
    let pc = array_get(fn_param_counts, uti)
    let param_types = array_slice([0], 0, 0)
    let mut pti = 0
    while pti < pc {
      array_push(param_types, 126)
      pti = pti + 1
    }
    emit_func_type_raw(type_content, param_types, [126])
    uti = uti + 1
  }

  let out = bytebuf_new()
  emit_header(out)
  bytebuf_push_section(out, 1, type_content)

  // === Import section ===
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)

  // === Function section ===
  // func 1: __print_i64 -> type 1
  // func 2: __print_str -> type 1
  // func 3: __str_len -> type 3
  // func 4: __str_eq -> type 4
  // func 5: __str_concat -> type 4
  // func 6: __arr_new -> type 5
  // func 7: __arr_len -> type 3
  // func 8: __arr_get -> type 4
  // func 9: __arr_push -> type 6
  // func 10: __arr_set -> type 7
  // func 11..11+N-1: user funcs -> type 8+i
  // func 11+N: _start -> type 2
  let func_type_indices = array_slice([0], 0, 0)
  array_push(func_type_indices, 1)  // __print_i64
  array_push(func_type_indices, 1)  // __print_str
  array_push(func_type_indices, 3)  // __str_len
  array_push(func_type_indices, 4)  // __str_eq
  array_push(func_type_indices, 4)  // __str_concat
  array_push(func_type_indices, 5)  // __arr_new
  array_push(func_type_indices, 3)  // __arr_len
  array_push(func_type_indices, 4)  // __arr_get
  array_push(func_type_indices, 6)  // __arr_push
  array_push(func_type_indices, 7)  // __arr_set
  let mut fti = 0
  while fti < num_user_funcs {
    array_push(func_type_indices, num_base_types + fti)
    fti = fti + 1
  }
  array_push(func_type_indices, 2)  // _start
  emit_function_section(out, func_type_indices)

  // === Memory section ===
  emit_memory_section(out, 1)

  // === Global section: heap_ptr ===
  emit_global_section_i32_mut(out, heap_start)

  // === Export section ===
  let start_func_idx = func_offset + num_user_funcs
  emit_exports_with_memory(out, ["_start"], [start_func_idx], "memory", 0)

  // === Code section ===
  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)
  // bodies_meta: parallel array of (num_i32_locals, num_i64_locals) for manual local encoding
  // We'll encode locals manually for all functions
  let meta_i32 = array_slice([0], 0, 0)  // num i32 extra locals per body
  let meta_i64 = array_slice([0], 0, 0)  // num i64 extra locals per body

  // Body 0: __print_i64
  array_push(bodies, gen_print_i64_body())
  array_push(meta_i32, 3)  // is_neg, pos, digit
  array_push(meta_i64, 1)  // abs_val

  // Body 1: __print_str
  array_push(bodies, gen_print_str_body())
  array_push(meta_i32, 2)
  array_push(meta_i64, 0)

  // Body 2: __str_len
  array_push(bodies, gen_str_len_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)

  // Body 3: __str_eq
  array_push(bodies, gen_str_eq_body())
  array_push(meta_i32, 5)  // len_a, len_b, off_a, off_b, i
  array_push(meta_i64, 0)

  // Body 4: __str_concat
  array_push(bodies, gen_str_concat_body())
  array_push(meta_i32, 6)  // len_a, len_b, off_a, off_b, new_ptr, new_len
  array_push(meta_i64, 0)

  // Body 5: __arr_new
  array_push(bodies, gen_arr_new_body())
  array_push(meta_i32, 1)  // header_ptr
  array_push(meta_i64, 0)

  // Body 6: __arr_len
  array_push(bodies, gen_arr_len_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)

  // Body 7: __arr_get
  array_push(bodies, gen_arr_get_body())
  array_push(meta_i32, 1)  // data_ptr
  array_push(meta_i64, 0)

  // Body 8: __arr_push
  array_push(bodies, gen_arr_push_body())
  array_push(meta_i32, 6)  // hdr, cap, len, data_ptr, new_data, new_cap
  array_push(meta_i64, 0)

  // Body 9: __arr_set
  array_push(bodies, gen_arr_set_body())
  array_push(meta_i32, 1)  // data_ptr
  array_push(meta_i64, 0)

  // Compile user function bodies
  let mut bi = 0
  while bi < num_user_funcs {
    let stmt = find_func_stmt(stmts, array_get(fn_names_list, bi))
    match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, body) => {
            let body_buf = bytebuf_new()
            let local_names = array_slice([""], 0, 0)
            let mut pi = 0
            while pi < array_length(params) {
              let (pname, _) = array_get(params, pi)
              array_push(local_names, pname)
              pi = pi + 1
            }
            let param_count = array_length(params)
            let final_nl = compile_expr(
              body_buf, body, local_names,
              param_count,
              fn_names_list, fn_indices_list, fn_param_counts, fn_returns_list,
              str_strs, str_offsets, str_lengths,
              -1
            )
            array_push(bodies, body_buf)
            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
            array_push(meta_i32, 0)
            array_push(meta_i64, extra)
          },
          _ => throw("expected function")
        }
      },
      _ => throw("expected let statement")
    }
    bi = bi + 1
  }

  // _start body
  let start_body = bytebuf_new()
  let entry_func_idx = entry_user_idx + func_offset
  let entry_params = array_get(fn_param_counts, entry_user_idx)
  if entry_params != 0 {
    throw("WASI entry function must take 0 parameters")
  }
  emit_call(start_body, entry_func_idx)
  emit_call(start_body, 1)  // __print_i64
  array_push(bodies, start_body)
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)

  // === Encode code section manually (mixed local types) ===
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, array_length(bodies))

  let mut ci = 0
  while ci < array_length(bodies) {
    let body = array_get(bodies, ci)
    let func_buf = bytebuf_new()
    let ni32 = array_get(meta_i32, ci)
    let ni64 = array_get(meta_i64, ci)

    if ni32 == 0 {
      if ni64 == 0 {
        leb128_encode_u32(func_buf, 0)  // no locals
      } else {
        leb128_encode_u32(func_buf, 1)  // 1 group
        leb128_encode_u32(func_buf, ni64)
        bytebuf_push(func_buf, 126)  // i64
      }
    } else {
      if ni64 == 0 {
        leb128_encode_u32(func_buf, 1)
        leb128_encode_u32(func_buf, ni32)
        bytebuf_push(func_buf, 127)  // i32
      } else {
        leb128_encode_u32(func_buf, 2)  // 2 groups
        leb128_encode_u32(func_buf, ni32)
        bytebuf_push(func_buf, 127)  // i32
        leb128_encode_u32(func_buf, ni64)
        bytebuf_push(func_buf, 126)  // i64
      }
    }

    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)  // end
    leb128_encode_u32(code_content, bytebuf_length(func_buf))
    bytebuf_push_array(code_content, func_buf)
    ci = ci + 1
  }

  bytebuf_push_section(out, 10, code_content)

  // === Data section ===
  if num_strings > 0 {
    let data_offsets = array_slice([0], 0, 0)
    let data_bufs = array_slice([array_slice([0], 0, 0)], 0, 0)
    let mut di = 0
    while di < num_strings {
      array_push(data_offsets, array_get(str_offsets, di))
      array_push(data_bufs, string_to_data(array_get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }

  bytebuf_to_bytes(out)
}

// Find the SLet statement for a given function name
let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {
  let rec search = (i: Int) -> Stmt with { Error } {
    if i >= array_length(stmts) {
      throw(string_concat("function not found: ", name))
    }
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => {
        if string_equals(sname, name) {
          stmt
        } else search(i + 1)
      },
      _ => search(i + 1)
    }
  }
  search(0)
}
