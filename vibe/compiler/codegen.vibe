// AST-to-WASM codegen — compiles vibe AST to WASM binary
// Subset: Int arithmetic, let bindings, functions, if/else, while, calls

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,
  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

import ./wasm_emit.vibe {
  emit_header,
  emit_type_section, emit_type_section_multi,
  emit_function_section, emit_export_section, emit_export_section_multi,
  emit_code_section, emit_code_section_with_locals,
  emit_name, emit_func_type_raw,
  emit_import_section_func, emit_memory_section,
  emit_exports_with_memory, emit_data_section, emit_data_section_multi,
  emit_local_get, emit_local_set, emit_local_tee,
  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,
  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,
  emit_i64_shl, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,
  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,
  emit_i64_extend_i32_s, emit_i32_wrap_i64,
  emit_i32_const, emit_i32_store, emit_i32_add,
  emit_i32_store8, emit_i32_load8_u,
  emit_call, emit_drop, emit_return,
  emit_block_void, emit_block_i64, emit_loop_void,
  emit_if_void, emit_if_i64, emit_else, emit_end,
  emit_br, emit_br_if,
  emit_global_section_i32_mut, emit_global_get, emit_global_set,
  string_to_data
}

// === Compilation context ===

// A local variable entry: (name, local_index)
// locals_env is a flat array of (String, Int) pairs stored as parallel arrays
// func_env maps function names to (func_index, param_count)

// Resolve a local variable name to its WASM local index
let resolve_local = (names: Array[String], name: String) -> Int with { Error } {
  let len = array_length(names)
  // Search backwards for most recent binding (shadowing)
  let rec search = (i: Int) -> Int with { Error } {
    if i < 0 {
      throw(string_concat("undefined variable: ", name))
    }
    if string_equals(array_get(names, i), name) {
      i
    } else search(i - 1)
  }
  search(len - 1)
}

// Resolve a function name to (func_index, param_count, has_return)
// has_return: 1 = returns i64, 0 = void
let resolve_func = (fn_names: Array[String], fn_indices: Array[Int], fn_params: Array[Int], fn_returns: Array[Int], name: String) -> (Int, Int, Int) with { Error } {
  let len = array_length(fn_names)
  let rec search = (i: Int) -> (Int, Int, Int) with { Error } {
    if i >= len {
      throw(string_concat("undefined function: ", name))
    }
    if string_equals(array_get(fn_names, i), name) {
      (array_get(fn_indices, i), array_get(fn_params, i), array_get(fn_returns, i))
    } else search(i + 1)
  }
  search(0)
}

// === String table ===

// Pack a string reference as i64: (offset << 32) | length
let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}

// Collect all unique string literals from an expression (recursive walk)
let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {
  match expr {
    EString(s) => {
      let mut found = false
      let mut i = 0
      while i < array_length(out) {
        if string_equals(array_get(out, i), s) {
          found = true
        }
        i = i + 1
      }
      if !found { array_push(out, s) }
      0
    },
    EBinOp(_, lhs, rhs) => {
      collect_strings_expr(lhs, out)
      collect_strings_expr(rhs, out)
    },
    EUnaryOp(_, operand) => collect_strings_expr(operand, out),
    EIf(cond, then_e, else_e) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(then_e, out)
      collect_strings_expr(else_e, out)
    },
    ECall(callee, args) => {
      collect_strings_expr(callee, out)
      let mut i = 0
      while i < array_length(args) {
        collect_strings_expr(array_get(args, i), out)
        i = i + 1
      }
      0
    },
    ELet(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetRec(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetMut(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssign(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ESeq(first, second) => {
      collect_strings_expr(first, out)
      collect_strings_expr(second, out)
    },
    EWhile(cond, body) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(body, out)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        collect_strings_expr(array_get(elems, i), out)
        i = i + 1
      }
      0
    },
    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),
    _ => 0
  }
}

// Collect strings from all function bodies in stmts
let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {
  let out = array_slice([""], 0, 0)
  let mut i = 0
  while i < array_length(stmts) {
    match array_get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),
      _ => 0
    }
    i = i + 1
  }
  out
}

// Look up a string in the table, return its index
let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {
  let rec search = (i: Int) -> Int with { Error } {
    if i >= array_length(strs) {
      throw(string_concat("string not in table: ", s))
    }
    if string_equals(array_get(strs, i), s) {
      i
    } else search(i + 1)
  }
  search(0)
}

// === Expression compiler ===

// Compile an expression to WASM instructions in buf
// str_strs: pre-collected unique strings
// str_offsets: memory offset for each string
// str_lengths: byte length for each string
let rec compile_expr = (
  buf: Array[Int],
  expr: Expr,
  local_names: Array[String],
  next_local: Int,
  fn_names: Array[String],
  fn_indices: Array[Int],
  fn_params: Array[Int],
  fn_returns: Array[Int],
  str_strs: Array[String],
  str_offsets: Array[Int],
  str_lengths: Array[Int]
) -> Int with { Error } {
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b) => {
      emit_i64_const(buf, if b { 1 } else { 0 })
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(str_strs, s)
      emit_str_ref(buf, array_get(str_offsets, idx), array_get(str_lengths, idx))
      next_local
    },
    EIdent(name) => {
      let idx = resolve_local(local_names, name)
      emit_local_get(buf, idx)
      next_local
    },
    EBinOp(op, lhs, rhs) => {
      let nl1 = compile_expr(buf, lhs, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      let nl2 = compile_expr(buf, rhs, local_names, nl1, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      if string_equals(op, "+") {
        emit_i64_add(buf)
      } else if string_equals(op, "-") {
        emit_i64_sub(buf)
      } else if string_equals(op, "*") {
        emit_i64_mul(buf)
      } else if string_equals(op, "/") {
        emit_i64_div_s(buf)
      } else if string_equals(op, "%") {
        emit_i64_rem_s(buf)
      } else if string_equals(op, "&") {
        emit_i64_and(buf)
      } else if string_equals(op, "|") {
        emit_i64_or(buf)
      } else if string_equals(op, "^") {
        emit_i64_xor(buf)
      } else if string_equals(op, "<<") {
        emit_i64_shl(buf)
      } else if string_equals(op, ">>") {
        emit_i64_shr_s(buf)
      } else if string_equals(op, "==") {
        emit_i64_eq(buf)
        emit_i64_extend_i32_s(buf)
      } else if string_equals(op, "!=") {
        emit_i64_ne(buf)
        emit_i64_extend_i32_s(buf)
      } else if string_equals(op, "<") {
        emit_i64_lt_s(buf)
        emit_i64_extend_i32_s(buf)
      } else if string_equals(op, ">") {
        emit_i64_gt_s(buf)
        emit_i64_extend_i32_s(buf)
      } else if string_equals(op, "<=") {
        emit_i64_le_s(buf)
        emit_i64_extend_i32_s(buf)
      } else if string_equals(op, ">=") {
        emit_i64_ge_s(buf)
        emit_i64_extend_i32_s(buf)
      } else if string_equals(op, "&&") {
        // logical and: (lhs != 0) & (rhs != 0) extended
        // Already have lhs and rhs on stack as i64
        // But we need short-circuit... for now just use bitwise and
        emit_i64_and(buf)
      } else if string_equals(op, "||") {
        emit_i64_or(buf)
      } else {
        throw(string_concat("unsupported binop: ", op))
      }
      nl2
    },
    EUnaryOp(op, operand) => {
      if string_equals(op, "-") {
        emit_i64_const(buf, 0)
        let nl = compile_expr(buf, operand, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
        emit_i64_sub(buf)
        nl
      } else if string_equals(op, "!") {
        let nl = compile_expr(buf, operand, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
        emit_i64_eqz(buf)
        emit_i64_extend_i32_s(buf)
        nl
      } else {
        throw(string_concat("unsupported unary op: ", op))
      }
    },
    EIf(cond, then_e, else_e) => {
      let nl1 = compile_expr(buf, cond, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      // Condition is i64 (nonzero = true), need i32 for if
      emit_i32_wrap_i64(buf)
      emit_if_i64(buf)
      let nl2 = compile_expr(buf, then_e, local_names, nl1, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      emit_else(buf)
      let nl3 = compile_expr(buf, else_e, local_names, nl2, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      emit_end(buf)
      nl3
    },
    ECall(callee, args) => {
      match callee {
        EIdent(fname) => {
          let (fidx, _, has_ret) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, fname)
          let mut nl = next_local
          let mut i = 0
          while i < array_length(args) {
            nl = compile_expr(buf, array_get(args, i), local_names, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
            i = i + 1
          }
          emit_call(buf, fidx)
          if has_ret == 0 {
            emit_i64_const(buf, 0)
          }
          nl
        },
        _ => throw("only direct function calls supported")
      }
    },
    ELet(name, value, body) => {
      // Allocate a new local for this let binding
      let local_idx = next_local
      let nl = compile_expr(buf, value, local_names, next_local + 1, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      emit_local_set(buf, local_idx)
      // Extend local_names with the new binding
      array_push(local_names, name)
      let nl2 = compile_expr(buf, body, local_names, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      nl2
    },
    ELetMut(name, value, body) => {
      let local_idx = next_local
      let nl = compile_expr(buf, value, local_names, next_local + 1, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      emit_local_set(buf, local_idx)
      array_push(local_names, name)
      let nl2 = compile_expr(buf, body, local_names, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      nl2
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name)
      let nl = compile_expr(buf, value, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      emit_local_set(buf, idx)
      compile_expr(buf, body, local_names, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
    },
    ESeq(first, second) => {
      let nl = compile_expr(buf, first, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
      emit_drop(buf)
      compile_expr(buf, second, local_names, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
    },
    EWhile(cond, body) => {
      // block $break { loop $loop { br_if (cond==0) $break; body; drop; br $loop } }
      // Result: i64(0) = unit
      emit_block_void(buf)
        emit_loop_void(buf)
          // Check condition
          let nl1 = compile_expr(buf, cond, local_names, next_local, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
          emit_i64_eqz(buf)  // returns i32
          emit_br_if(buf, 1)  // if zero, break to outer block
          // Execute body
          let nl2 = compile_expr(buf, body, local_names, nl1, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths)
          emit_drop(buf)
          emit_br(buf, 0)  // continue loop
        emit_end(buf)
      emit_end(buf)
      // Push unit value (0)
      emit_i64_const(buf, 0)
      nl2
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    _ => throw("unsupported expression in codegen")
  }
}

// === Module compiler ===

// Compile a list of top-level function definitions to a WASM module
// Each SLet with EFn becomes a WASM function
// Only export=true functions are exported
export let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {
  // First pass: collect function signatures
  let fn_names_list = array_slice([""], 0, 0)
  let fn_param_counts = array_slice([0], 0, 0)
  let export_names = array_slice([""], 0, 0)
  let export_indices = array_slice([0], 0, 0)

  // Collect all function definitions
  // Note: use array_length(fn_names_list) as func_idx since match forks scope
  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(is_export, _, name, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, _) => {
            let cur_idx = array_length(fn_names_list)
            array_push(fn_names_list, name)
            array_push(fn_param_counts, array_length(params))
            if is_export {
              array_push(export_names, name)
              array_push(export_indices, cur_idx)
            }
            0
          },
          _ => 0
        }
      },
      _ => 0
    }
    i = i + 1
  }

  let num_funcs = array_length(fn_names_list)
  if num_funcs == 0 {
    throw("no functions found to compile")
  }

  // Build func indices and returns arrays
  let fn_indices_list = array_slice([0], 0, 0)
  let fn_returns_list = array_slice([0], 0, 0)
  let mut fi = 0
  while fi < num_funcs {
    array_push(fn_indices_list, fi)
    array_push(fn_returns_list, 1)  // all user functions return i64
    fi = fi + 1
  }

  // Second pass: build type section and compile bodies
  // For now: each function has its own type = (i64 x params) -> (i64)
  let type_defs = array_slice([0], 0, 0)
  let mut ti = 0
  while ti < num_funcs {
    array_push(type_defs, array_get(fn_param_counts, ti))
    array_push(type_defs, 1)  // always return i64
    ti = ti + 1
  }

  // Type indices: func i uses type i (1:1 mapping)
  let type_indices = array_slice([0], 0, 0)
  let mut tii = 0
  while tii < num_funcs {
    array_push(type_indices, tii)
    tii = tii + 1
  }

  // Compile function bodies
  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)
  let local_counts = array_slice([0], 0, 0)
  let mut bi = 0
  while bi < num_funcs {
    let stmt = find_func_stmt(stmts, array_get(fn_names_list, bi))
    match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, body) => {
            let body_buf = bytebuf_new()
            // Build local names: params first
            let local_names = array_slice([""], 0, 0)
            let mut pi = 0
            while pi < array_length(params) {
              let (pname, _) = array_get(params, pi)
              array_push(local_names, pname)
              pi = pi + 1
            }
            let param_count = array_length(params)
            let empty_strs = array_slice([""], 0, 0)
            let empty_offs = array_slice([0], 0, 0)
            let empty_lens = array_slice([0], 0, 0)
            let final_nl = compile_expr(
              body_buf, body, local_names,
              param_count,
              fn_names_list, fn_indices_list, fn_param_counts, fn_returns_list,
              empty_strs, empty_offs, empty_lens
            )
            array_push(bodies, body_buf)
            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
            array_push(local_counts, extra)
          },
          _ => throw("expected function")
        }
      },
      _ => throw("expected let statement")
    }
    bi = bi + 1
  }

  // Emit module
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section_multi(out, type_defs)
  emit_function_section(out, type_indices)

  if array_length(export_names) > 0 {
    emit_export_section_multi(out, export_names, export_indices)
  }

  emit_code_section_with_locals(out, bodies, local_counts)
  bytebuf_to_bytes(out)
}

// === WASI Module compiler ===
// Generates a WASI-compatible module with _start that calls an entry function
// and prints the result to stdout.
//
// Module layout:
//   func 0: fd_write (imported from wasi_snapshot_preview1)
//   func 1: __print_i64 (internal, generated)
//   func 2..N+1: user functions
//   func N+2: _start (calls entry function + __print_i64)
//
// Memory layout:
//   0-7: iovec struct
//   8-11: nwritten
//   16-47: digit buffer (32 bytes for itoa + newline)

// Emit i32.sub (opcode 0x6B) - not in wasm_emit yet
let emit_i32_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 107)  // 0x6B
}

// Generate __print_i64 function body
// Takes i64, converts to decimal string, writes to stdout via fd_write
// Uses memory[16..47] as scratch buffer, \n at 47
// locals: 0=val(i64), 1=is_neg(i32), 2=pos(i32), 3=abs_val(i64), 4=digit(i32)
let gen_print_i64_body = () -> Array[Int] {
  let b = bytebuf_new()

  // pos = 46
  emit_i32_const(b, 46)
  emit_local_set(b, 2)

  // mem[47] = '\n'
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)

  // is_neg = (val < 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)

  // abs_val = is_neg ? -val : val
  emit_local_get(b, 1)
  emit_if_i64(b)
    emit_i64_const(b, 0)
    emit_local_get(b, 0)
    emit_i64_sub(b)
  emit_else(b)
    emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 3)

  // if abs_val == 0: write '0' and decrement pos
  emit_local_get(b, 3)
  emit_i64_eqz(b)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 48)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)

  // while abs_val > 0: extract digits
  emit_block_void(b)
    emit_loop_void(b)
      emit_local_get(b, 3)
      emit_i64_eqz(b)
      emit_br_if(b, 1)

      // digit = abs_val % 10
      emit_local_get(b, 3)
      emit_i64_const(b, 10)
      emit_i64_rem_s(b)
      emit_i32_wrap_i64(b)
      emit_local_set(b, 4)

      // mem[pos] = digit + '0'
      emit_local_get(b, 2)
      emit_local_get(b, 4)
      emit_i32_const(b, 48)
      emit_i32_add(b)
      emit_i32_store8(b, 0, 0)

      // pos = pos - 1
      emit_local_get(b, 2)
      emit_i32_const(b, 1)
      emit_i32_sub(b)
      emit_local_set(b, 2)

      // abs_val = abs_val / 10
      emit_local_get(b, 3)
      emit_i64_const(b, 10)
      emit_i64_div_s(b)
      emit_local_set(b, 3)

      emit_br(b, 0)
    emit_end(b)
  emit_end(b)

  // if is_neg: write '-'
  emit_local_get(b, 1)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 45)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)

  // iovec.buf = pos + 1
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)

  // iovec.len = 47 - pos
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)

  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)

  b
}

// Generate __print_str function body
// Takes i64 packed ref = (offset << 32) | length
// Unpacks to offset (i32) and length (i32), writes to stdout via fd_write
// local 0: packed (i64 param)
// local 1: offset (i32)
// local 2: length (i32)
let gen_print_str_body = () -> Array[Int] {
  let b = bytebuf_new()

  // offset = (packed >> 32) as i32
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)

  // length = packed as i32 (low 32 bits)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)

  // iovec[0].buf = offset
  emit_i32_const(b, 0)
  emit_local_get(b, 1)
  emit_i32_store(b, 2, 0)

  // iovec[0].len = length
  emit_i32_const(b, 4)
  emit_local_get(b, 2)
  emit_i32_store(b, 2, 0)

  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)

  b
}

export let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {
  // Collect user functions
  let fn_names_list = array_slice([""], 0, 0)
  let fn_param_counts = array_slice([0], 0, 0)

  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(_, _, name, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, _) => {
            array_push(fn_names_list, name)
            array_push(fn_param_counts, array_length(params))
            0
          },
          _ => 0
        }
      },
      _ => 0
    }
    i = i + 1
  }

  let num_user_funcs = array_length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }

  // Find entry function index (among user funcs)
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if string_equals(array_get(fn_names_list, ei), entry_name) {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  if entry_user_idx < 0 {
    throw(string_concat("entry function not found: ", entry_name))
  }

  // Module function indices:
  // 0 = fd_write (import)
  // 1 = __print_i64 (generated)
  // 2..num_user_funcs+1 = user functions
  // num_user_funcs+2 = _start

  // === String table ===
  let str_strs = collect_strings_stmts(stmts)
  let num_strings = array_length(str_strs)
  let data_base = 64  // strings start at memory offset 64
  let str_offsets = array_slice([0], 0, 0)
  let str_lengths = array_slice([0], 0, 0)
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = array_get(str_strs, si)
    let slen = string_length(s)
    array_push(str_offsets, str_pos)
    array_push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }

  // === Function layout ===
  // func 0: fd_write (import)
  // func 1: __print_i64 (generated)
  // func 2: __print_str (generated) — takes i64 packed ref, writes to stdout
  // func 3..N+2: user functions
  // func N+3: _start
  let import_count = 1
  let generated_count = 2  // __print_i64, __print_str
  let func_offset = import_count + generated_count  // = 3

  // Register builtins in fn env so user code can call print_int/print_str
  array_push(fn_names_list, "print_int")
  array_push(fn_param_counts, 1)
  array_push(fn_names_list, "print_str")
  array_push(fn_param_counts, 1)

  // Build fn_indices and fn_returns for resolve_func
  let fn_indices_list = array_slice([0], 0, 0)
  let fn_returns_list = array_slice([0], 0, 0)
  let mut fi = 0
  while fi < num_user_funcs {
    array_push(fn_indices_list, fi + func_offset)
    array_push(fn_returns_list, 1)  // user functions return i64
    fi = fi + 1
  }
  // print_int -> func 1 (void), print_str -> func 2 (void)
  array_push(fn_indices_list, 1)
  array_push(fn_returns_list, 0)  // print_int is void
  array_push(fn_indices_list, 2)
  array_push(fn_returns_list, 0)  // print_str is void

  // === Type section ===
  // type 0: fd_write (i32,i32,i32,i32) -> (i32)
  // type 1: __print_i64 (i64) -> ()  — also used for __print_str
  // type 2: _start () -> ()
  // type 3+: user function types
  let type_content = bytebuf_new()
  let num_types = 3 + num_user_funcs
  bytebuf_push_vec_header(type_content, num_types)

  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write
  emit_func_type_raw(type_content, [126], array_slice([0], 0, 0))  // type 1: (i64)->()
  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))  // type 2: ()->()

  let mut uti = 0
  while uti < num_user_funcs {
    let pc = array_get(fn_param_counts, uti)
    let param_types = array_slice([0], 0, 0)
    let mut pti = 0
    while pti < pc {
      array_push(param_types, 126)
      pti = pti + 1
    }
    emit_func_type_raw(type_content, param_types, [126])
    uti = uti + 1
  }

  let out = bytebuf_new()
  emit_header(out)
  bytebuf_push_section(out, 1, type_content)

  // === Import section ===
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)

  // === Function section ===
  let func_type_indices = array_slice([0], 0, 0)
  array_push(func_type_indices, 1)  // func 1: __print_i64 -> type 1
  array_push(func_type_indices, 1)  // func 2: __print_str -> type 1 (same sig)
  let mut fti = 0
  while fti < num_user_funcs {
    array_push(func_type_indices, 3 + fti)
    fti = fti + 1
  }
  array_push(func_type_indices, 2)  // _start -> type 2
  emit_function_section(out, func_type_indices)

  // === Memory section ===
  emit_memory_section(out, 1)

  // === Export section ===
  let start_func_idx = func_offset + num_user_funcs
  emit_exports_with_memory(out, ["_start"], [start_func_idx], "memory", 0)

  // === Code section ===
  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)
  let local_counts = array_slice([0], 0, 0)

  // Body 0: __print_i64
  let print_i64_body = gen_print_i64_body()
  array_push(bodies, print_i64_body)
  array_push(local_counts, 4)  // mixed-type locals handled in manual code section

  // Body 1: __print_str
  // Takes i64 packed = (offset << 32 | length), writes to stdout
  let print_str_body = gen_print_str_body()
  array_push(bodies, print_str_body)
  array_push(local_counts, 2)  // 2 extra locals: offset(i32), length(i32)

  // Compile user function bodies
  let mut bi = 0
  while bi < num_user_funcs {
    let stmt = find_func_stmt(stmts, array_get(fn_names_list, bi))
    match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, body) => {
            let body_buf = bytebuf_new()
            let local_names = array_slice([""], 0, 0)
            let mut pi = 0
            while pi < array_length(params) {
              let (pname, _) = array_get(params, pi)
              array_push(local_names, pname)
              pi = pi + 1
            }
            let param_count = array_length(params)
            let final_nl = compile_expr(
              body_buf, body, local_names,
              param_count,
              fn_names_list, fn_indices_list, fn_param_counts, fn_returns_list,
              str_strs, str_offsets, str_lengths
            )
            array_push(bodies, body_buf)
            let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
            array_push(local_counts, extra)
          },
          _ => throw("expected function")
        }
      },
      _ => throw("expected let statement")
    }
    bi = bi + 1
  }

  // Body N+2: _start
  let start_body = bytebuf_new()
  let entry_func_idx = entry_user_idx + func_offset
  let entry_params = array_get(fn_param_counts, entry_user_idx)
  if entry_params != 0 {
    throw("WASI entry function must take 0 parameters")
  }
  emit_call(start_body, entry_func_idx)
  emit_call(start_body, 1)  // __print_i64
  array_push(bodies, start_body)
  array_push(local_counts, 0)

  // === Code section (manual, mixed local types) ===
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, array_length(bodies))

  let mut ci = 0
  while ci < array_length(bodies) {
    let body = array_get(bodies, ci)
    let func_buf = bytebuf_new()

    if ci == 0 {
      // __print_i64: is_neg(i32), pos(i32), abs_val(i64), digit(i32)
      leb128_encode_u32(func_buf, 4)
      leb128_encode_u32(func_buf, 1)
      bytebuf_push(func_buf, 127)  // i32
      leb128_encode_u32(func_buf, 1)
      bytebuf_push(func_buf, 127)  // i32
      leb128_encode_u32(func_buf, 1)
      bytebuf_push(func_buf, 126)  // i64
      leb128_encode_u32(func_buf, 1)
      bytebuf_push(func_buf, 127)  // i32
    } else if ci == 1 {
      // __print_str: offset(i32), length(i32)
      leb128_encode_u32(func_buf, 1)
      leb128_encode_u32(func_buf, 2)
      bytebuf_push(func_buf, 127)  // 2 x i32
    } else {
      let num_locals = array_get(local_counts, ci)
      if num_locals == 0 {
        leb128_encode_u32(func_buf, 0)
      } else {
        leb128_encode_u32(func_buf, 1)
        leb128_encode_u32(func_buf, num_locals)
        bytebuf_push(func_buf, 126)  // i64
      }
    }

    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)  // end
    leb128_encode_u32(code_content, bytebuf_length(func_buf))
    bytebuf_push_array(code_content, func_buf)
    ci = ci + 1
  }

  bytebuf_push_section(out, 10, code_content)

  // === Data section (string literals) ===
  if num_strings > 0 {
    let data_offsets = array_slice([0], 0, 0)
    let data_bufs = array_slice([array_slice([0], 0, 0)], 0, 0)
    let mut di = 0
    while di < num_strings {
      array_push(data_offsets, array_get(str_offsets, di))
      array_push(data_bufs, string_to_data(array_get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }

  bytebuf_to_bytes(out)
}

// Find the SLet statement for a given function name
let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {
  let rec search = (i: Int) -> Stmt with { Error } {
    if i >= array_length(stmts) {
      throw(string_concat("function not found: ", name))
    }
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => {
        if string_equals(sname, name) {
          stmt
        } else search(i + 1)
      },
      _ => search(i + 1)
    }
  }
  search(0)
}
