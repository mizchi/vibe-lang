// AST-to-WASM codegen (linear memory backend)
// Supports: Int arithmetic, let/mut/assign, functions, if/else, while, calls,
// strings (packed i64 refs), tuples (heap), arrays (heap), match expressions, closures

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,
  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

import ./wasm_emit.vibe {
  emit_header,
  emit_type_section, emit_type_section_multi,
  emit_function_section, emit_export_section, emit_export_section_multi,
  emit_code_section, emit_code_section_with_locals,
  emit_name, emit_func_type_raw,
  emit_import_section_func, emit_memory_section,
  emit_exports_with_memory, emit_data_section, emit_data_section_multi,
  emit_local_get, emit_local_set, emit_local_tee,
  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,
  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,
  emit_i64_shl, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,
  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,
  emit_i64_extend_i32_s, emit_i32_wrap_i64,
  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,
  emit_i32_store8, emit_i32_load8_u,
  emit_call, emit_drop, emit_return,
  emit_block_void, emit_block_i64, emit_loop_void,
  emit_if_void, emit_if_i64, emit_else, emit_end,
  emit_br, emit_br_if,
  emit_global_section_i32_mut, emit_global_get, emit_global_set,
  string_to_data,
  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,
  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,
  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,
  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,
  emit_call_indirect, emit_table_section_funcref, emit_element_section_active
}

import ./codegen_common.vibe {
  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz,
  emit_i64_store, emit_i64_load, emit_i64_extend_i32_u, emit_memory_copy,
  resolve_local, resolve_func,
  emit_str_ref, collect_strings_stmts,
  array_contains_str, collect_free_vars, is_mut_captured_in,
  str_table_lookup, find_catchall_idx,
  lookup_ctor,
  emit_binop_op, emit_assignop_op, emit_closure_resolve, emit_closure_call_tail,
  get_match_scrutinee, get_match_arms,
  get_arm_pat, get_arm_body,
  get_ptuple_pats, get_pbind_name,
  get_pctor_name, get_pctor_args,
  get_pint_value, get_pbool_value, get_pstring_value,
  is_ptuple, is_pwild, is_pbind, is_pint, is_pbool, is_pctor, is_pstring,
  get_etuple_elems, is_etuple,
  get_eint_value, get_ebool_value, get_efloat_value, get_estring_value,
  get_eident_name, get_ecall_callee, get_ecall_args,
  get_ebinop_op, get_ebinop_lhs, get_ebinop_rhs,
  get_eif_cond, get_eif_then, get_eif_else,
  get_elet_name, get_elet_val, get_elet_body,
  get_eletrec_name, get_eletrec_val, get_eletrec_body,
  get_eletmut_name, get_eletmut_val, get_eletmut_body,
  get_eassign_name, get_eassign_val, get_eassign_body,
  get_eassignop_name, get_eassignop_op, get_eassignop_val, get_eassignop_body,
  get_eseq_first, get_eseq_second,
  get_ewhile_cond, get_ewhile_body,
  get_eunaryop_op, get_eunaryop_expr,
  get_eforin_name, get_eforin_iter, get_eforin_body,
  get_earray_elems, get_ethrow_expr,
  get_efn_params, get_efn_body,
  is_eident, is_efn,
  expr_tag,
  is_slet, get_slet_name, get_slet_expr
}

// === Expression compiler ===

let rec compile_expr = (
  buf: Array[Int],
  expr: Expr,
  local_names: Array[String],
  next_local: Int,
  fn_names: Array[String],
  fn_indices: Array[Int],
  fn_params: Array[Int],
  fn_returns: Array[Int],
  str_strs: Array[String],
  str_offsets: Array[Int],
  str_lengths: Array[Int],
  ld: Int,  // loop depth: -1 = not in loop, 0+ = depth from while's loop block
  lambda_bodies: Array[Array[Int]],
  lambda_param_counts: Array[Int],
  lambda_captures: Array[Array[String]],
  lambda_meta_i32: Array[Int],
  lambda_meta_i64: Array[Int],
  num_user_funcs: Int,
  func_offset: Int,
  ref_cell_names: Array[String],
  ctor_names: Array[String],
  ctor_tags: Array[Int],
  ctor_field_counts: Array[Int]
) -> Int with { Error } {
  // shorthand for recursive call
  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {
    compile_expr(b, e, ln, nl, fn_names, fn_indices, fn_params, fn_returns, str_strs, str_offsets, str_lengths, d, lambda_bodies, lambda_param_counts, lambda_captures, lambda_meta_i32, lambda_meta_i64, num_user_funcs, func_offset, ref_cell_names, ctor_names, ctor_tags, ctor_field_counts)
  }
  let __tag = expr_tag(expr)
  if __tag == 0 {
      // EInt
      let n = get_eint_value(expr)
      emit_i64_const(buf, n)
      next_local
  } else if __tag == 1 {
      // EBool
      let b_val = get_ebool_value(expr)
      emit_i64_const(buf, if b_val { 1 } else { 0 })
      next_local
  } else if __tag == 2 {
      // EFloat
      let v = get_efloat_value(expr)
      let bits = double_to_i64_bits(v)
      emit_f64_const_bits(buf, bits)
      emit_i64_reinterpret_f64(buf)
      next_local
  } else if __tag == 3 {
      // EString
      let s = get_estring_value(expr)
      let idx = str_table_lookup(str_strs, s)
      emit_str_ref(buf, array_get(str_offsets, idx), array_get(str_lengths, idx))
      next_local
  } else if __tag == 4 {
      // EIdent
      let name = get_eident_name(expr)
      // Try local first, then check if it's a top-level function as value
      let len = array_length(local_names)
      let mut __tl_i = len - 1
      let mut __tl_result = -1
      while __tl_i >= 0 {
        if string_equals(array_get(local_names, __tl_i), name) {
          __tl_result = __tl_i
          __tl_i = -1  // break
        } else {
          __tl_i = __tl_i - 1
        }
      }
      let local_idx = __tl_result
      if local_idx >= 0 {
        if array_contains_str(ref_cell_names, name) {
          emit_local_get(buf, local_idx)
          emit_i32_wrap_i64(buf)
          emit_i64_load(buf, 3, 0)
        } else {
          emit_local_get(buf, local_idx)
        }
        next_local
      } else {
        let ctor_idx = lookup_ctor(ctor_names, name, 0)
        if ctor_idx >= 0 {
          let tag_c = array_get(ctor_tags, ctor_idx)
          let ptr_l = next_local
          array_push(local_names, "__ctor_ptr")
          emit_global_get(buf, 0)
          emit_i64_extend_i32_u(buf)
          emit_local_set(buf, ptr_l)
          emit_global_get(buf, 0)
          emit_i32_const(buf, 8)
          emit_i32_add(buf)
          emit_global_set(buf, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, tag_c)
          emit_i32_store(buf, 2, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, 0)
          emit_i32_store(buf, 2, 4)
          emit_local_get(buf, ptr_l)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          next_local + 1
        } else {
        let fn_len = array_length(fn_names)
        let mut __tf_j = 0
        let mut __tf_result = -1
        while __tf_j < fn_len {
          if string_equals(array_get(fn_names, __tf_j), name) {
            __tf_result = __tf_j
            __tf_j = fn_len  // break
          } else {
            __tf_j = __tf_j + 1
          }
        }
        if __tf_result < 0 {
            let mut diag = string_concat("undefined variable (ident): ", name)
            diag = string_concat(diag, " | locals=[")
            let mut di = 0
            while di < len {
              if di > 0 { diag = string_concat(diag, ",") }
              diag = string_concat(diag, array_get(local_names, di))
              di = di + 1
            }
            diag = string_concat(diag, "]")
            throw(diag)
        }
        let fni = __tf_result
        let fidx = array_get(fn_indices, fni)
        let table_slot = fidx - func_offset
        emit_i64_const(buf, (table_slot << 2) | 2)
        next_local
        }
      }
  } else if __tag == 5 {
      // EBinOp
      let op = get_ebinop_op(expr)
      let lhs = get_ebinop_lhs(expr)
      let rhs = get_ebinop_rhs(expr)
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_binop_op(buf, op)
      nl2
  } else if __tag == 6 {
      // EUnaryOp
      let op = get_eunaryop_op(expr)
      let operand = get_eunaryop_expr(expr)
      if string_equals(op, "-") {
        emit_i64_const(buf, 0)
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_sub(buf)
        nl
      } else if string_equals(op, "!") {
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_eqz(buf)
        emit_i64_extend_i32_s(buf)
        nl
      } else {
        throw(string_concat("unsupported unary op: ", op))
      }
  } else if __tag == 7 {
      // EIf
      let cond = get_eif_cond(expr)
      let then_e = get_eif_then(expr)
      let else_e = get_eif_else(expr)
      let nl1 = ce(buf, cond, local_names, next_local, ld)
      emit_i32_wrap_i64(buf)
      emit_if_i64(buf)
      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }
      let names_len_before = array_length(local_names)
      let nl2 = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      array_truncate(local_names, names_len_before)
      let nl3 = ce(buf, else_e, local_names, nl1, ld_inner)
      emit_end(buf)
      if nl2 > nl3 { nl2 } else { nl3 }
  } else if __tag == 8 {
      // ECall
      let callee = get_ecall_callee(expr)
      let args = get_ecall_args(expr)
      if is_eident(callee) {
          let fname = get_eident_name(callee)
          // Check if this is an enum constructor call
          let ctor_lookup_idx = lookup_ctor(ctor_names, fname, 0)
          if ctor_lookup_idx >= 0 {
            // Enum constructor: allocate heap object [tag_i32 | field_count_i32 | fields...]
            let tag = array_get(ctor_tags, ctor_lookup_idx)
            let fc = array_get(ctor_field_counts, ctor_lookup_idx)
            let obj_size = 8 + fc * 8  // 4 bytes tag + 4 bytes fc + 8 bytes per field
            // Save heap ptr as i64
            let ptr_local = next_local
            array_push(local_names, "__ctor_ptr")
            emit_global_get(buf, 0)
            emit_i64_extend_i32_u(buf)
            emit_local_set(buf, ptr_local)
            // Advance heap ptr
            emit_global_get(buf, 0)
            emit_i32_const(buf, obj_size)
            emit_i32_add(buf)
            emit_global_set(buf, 0)
            // Store tag at offset 0
            emit_local_get(buf, ptr_local)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, tag)
            emit_i32_store(buf, 2, 0)
            // Store field count at offset 4
            emit_local_get(buf, ptr_local)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, fc)
            emit_i32_store(buf, 2, 4)
            // Compile and store each field
            let mut nl_c = next_local + 1
            let mut fi_c = 0
            while fi_c < array_length(args) {
              nl_c = ce(buf, array_get(args, fi_c), local_names, nl_c, ld)
              let val_local = nl_c
              array_push(local_names, "__ctor_val")
              emit_local_set(buf, val_local)
              nl_c = nl_c + 1
              // Store field at offset 8 + fi_c * 8
              emit_local_get(buf, ptr_local)
              emit_i32_wrap_i64(buf)
              emit_local_get(buf, val_local)
              emit_i64_store(buf, 3, 8 + fi_c * 8)
              fi_c = fi_c + 1
            }
            // Return ptr | 1 (tag_obj)
            emit_local_get(buf, ptr_local)
            emit_i64_const(buf, 1)
            emit_i64_or(buf)
            nl_c
          }
          else {
          // Try direct call first
          let fn_len2 = array_length(fn_names)
          let mut __tr_j = 0
          let mut __tr_result = -1
          while __tr_j < fn_len2 {
            if string_equals(array_get(fn_names, __tr_j), fname) {
              __tr_result = __tr_j
              __tr_j = fn_len2  // break
            } else {
              __tr_j = __tr_j + 1
            }
          }
          let fn_idx_in_list = __tr_result
          if fn_idx_in_list >= 0 {
            // Direct call to known function
            let fidx = array_get(fn_indices, fn_idx_in_list)
            let has_ret = array_get(fn_returns, fn_idx_in_list)
            let mut nl = next_local
            let mut ci = 0
            while ci < array_length(args) {
              nl = ce(buf, array_get(args, ci), local_names, nl, ld)
              ci = ci + 1
            }
            // In WASI mode, user funcs have env param — push 0
            if func_offset > 0 {
              if fidx >= func_offset {
                emit_i64_const(buf, 0)
              }
            }
            emit_call(buf, fidx)
            if has_ret == 0 {
              emit_i64_const(buf, 0)
            }
            nl
          } else {
            // fname is a local variable holding a closure/fn value — indirect call
            let local_idx2 = resolve_local(local_names, fname)
            let num_args = array_length(args)
            // We need temp locals for fn_val, table_slot, env
            let fn_val_local = next_local
            let slot_local = next_local + 1
            let env_local = next_local + 2
            let mut nl = next_local + 3
            array_push(local_names, "__fn_val")
            array_push(local_names, "__slot")
            array_push(local_names, "__env")
            emit_local_get(buf, local_idx2)
            emit_local_set(buf, fn_val_local)
            emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
            let mut ci = 0
            while ci < num_args {
              nl = ce(buf, array_get(args, ci), local_names, nl, ld)
              ci = ci + 1
            }
            emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
            nl
          }
          } // close ctor_lookup else
      } else {
          // Callee is an arbitrary expression (e.g. result of another call)
          let num_args = array_length(args)
          let fn_val_local = next_local
          let slot_local = next_local + 1
          let env_local = next_local + 2
          let mut nl = next_local + 3
          array_push(local_names, "__fn_val")
          array_push(local_names, "__slot")
          array_push(local_names, "__env")
          nl = ce(buf, callee, local_names, nl, ld)
          emit_local_set(buf, fn_val_local)
          emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
          let mut ci = 0
          while ci < num_args {
            nl = ce(buf, array_get(args, ci), local_names, nl, ld)
            ci = ci + 1
          }
          emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
          nl
      }
  } else if __tag == 9 {
      // ELet
      let name = get_elet_name(expr)
      let value = get_elet_val(expr)
      let body = get_elet_body(expr)
      let local_idx = next_local
      array_push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
  } else if __tag == 10 {
      // ELetRec
      let name = get_eletrec_name(expr)
      let value = get_eletrec_val(expr)
      let body = get_eletrec_body(expr)
      let local_idx = next_local
      array_push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      // Backpatch self-reference in closure for recursive let rec
      if is_efn(value) {
          let params = get_efn_params(value)
          let fn_body = get_efn_body(value)
          let param_names_bp = array_slice([""], 0, 0)
          let mut bpi = 0
          while bpi < array_length(params) {
            let (pn, _) = array_get(params, bpi)
            array_push(param_names_bp, pn)
            bpi = bpi + 1
          }
          let caps = collect_free_vars(fn_body, param_names_bp, array_concat(fn_names, ctor_names))
          let mut self_cap_idx = -1
          let mut bci = 0
          while bci < array_length(caps) {
            if string_equals(array_get(caps, bci), name) {
              self_cap_idx = bci
            }
            bci = bci + 1
          }
          if self_cap_idx >= 0 {
            emit_local_get(buf, local_idx)
            emit_i64_const(buf, -4)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, local_idx)
            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
          }
          0
      } else { 0 }
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
  } else if __tag == 11 {
      // ELetMut
      let name = get_eletmut_name(expr)
      let value = get_eletmut_val(expr)
      let body = get_eletmut_body(expr)
      let local_idx = next_local
      array_push(local_names, name)
      if is_mut_captured_in(body, name) {
        array_push(ref_cell_names, name)
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_tee(buf, local_idx)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 8)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_i64_store(buf, 3, 0)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      } else {
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_local_set(buf, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      }
  } else if __tag == 12 {
      // EAssign
      let name = get_eassign_name(expr)
      let value = get_eassign_val(expr)
      let body = get_eassign_body(expr)
      let idx = resolve_local(local_names, name)
      if array_contains_str(ref_cell_names, name) {
        emit_local_get(buf, idx)
        emit_i32_wrap_i64(buf)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_i64_store(buf, 3, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
  } else if __tag == 13 {
      // EAssignOp
      let name = get_eassignop_name(expr)
      let op = get_eassignop_op(expr)
      let value = get_eassignop_val(expr)
      let body = get_eassignop_body(expr)
      let idx = resolve_local(local_names, name)
      if array_contains_str(ref_cell_names, name) {
        emit_local_get(buf, idx)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, idx)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 0)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_i64_store(buf, 3, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
  } else if __tag == 14 {
      // ESeq
      let first = get_eseq_first(expr)
      let second = get_eseq_second(expr)
      let nl = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl, ld)
  } else if __tag == 15 {
      // ETuple
      let __tuple_elems = get_etuple_elems(expr)
      // Allocate N*8 bytes on heap, store each element as i64
      let num_elems = array_length(__tuple_elems)
      let alloc_size = num_elems * 8
      // ptr_local stores heap ptr as i64 (user locals are i64)
      let ptr_local = next_local
      array_push(local_names, "__tuple_ptr")
      let mut nl = next_local + 1
      // ptr = heap_ptr as i64; heap_ptr += alloc_size
      emit_global_get(buf, 0)  // i32
      emit_i64_extend_i32_u(buf)  // -> i64
      emit_local_tee(buf, ptr_local)  // save as i64
      emit_i32_wrap_i64(buf)  // back to i32 for arithmetic
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      // Store each element
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)  // ptr as i32 for store
        nl = ce(buf, array_get(__tuple_elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      // Return ptr as i64 (already stored as i64)
      emit_local_get(buf, ptr_local)
      nl
  } else if __tag == 16 {
      // EMatch
      let __match_scrutinee = get_match_scrutinee(expr)
      let __match_arms = get_match_arms(expr)
      // Compile scrutinee, store in temp local
      let scrut_local = next_local
      // Push name BEFORE compiling scrutinee so temp locals don't shift indices
      array_push(local_names, "__match_scrut")
      let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ld)
      emit_local_set(buf, scrut_local)
      // Compile match arms as nested if-else
      // We build this iteratively: for each arm, emit condition check + body
      // Last arm (or PWild/PBind) just emits body directly
      let num_arms = array_length(__match_arms)
      let catchall_idx = find_catchall_idx(__match_arms)
      let num_cond_arms = catchall_idx
      // Emit nested if-else: each conditional arm opens if+else, closed after
      let mut ai = 0
      let mut max_nl = nl1
      let names_len_at_match = array_length(local_names)
      while ai < num_cond_arms {
        // Truncate local_names so each arm starts fresh
        array_truncate(local_names, names_len_at_match)
        let __cond_p = get_arm_pat(array_get(__match_arms, ai))
        let __cond_done = if is_pint(__cond_p) {
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, get_pint_value(__cond_p))
          emit_i64_eq(buf)
          emit_if_i64(buf)
          0
        } else { if is_pbool(__cond_p) {
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, if get_pbool_value(__cond_p) { 1 } else { 0 })
          emit_i64_eq(buf)
          emit_if_i64(buf)
          0
        } else { if is_pctor(__cond_p) {
          let cname_cond = get_pctor_name(__cond_p)
          let ctor_ci = lookup_ctor(ctor_names, cname_cond, 0)
          let expected_tag = if ctor_ci >= 0 { array_get(ctor_tags, ctor_ci) } else { -1 }
          emit_local_get(buf, scrut_local)
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
          emit_i32_wrap_i64(buf)
          emit_i32_load(buf, 2, 0)
          emit_i32_const(buf, expected_tag)
          emit_i32_eq(buf)
          emit_if_i64(buf)
          0
        } else { if is_pstring(__cond_p) {
          let sval = get_pstring_value(__cond_p)
          let str_idx = str_table_lookup(str_strs, sval)
          if str_idx >= 0 {
            emit_local_get(buf, scrut_local)
            emit_str_ref(buf, array_get(str_offsets, str_idx), array_get(str_lengths, str_idx))
            emit_call(buf, 4)
            emit_i64_const(buf, 1)
            emit_i64_eq(buf)
            emit_if_i64(buf)
          }
          0
        } else { 0 } } } }
        // Compile arm body — for PCtor, bind fields first
        let __arm_body = get_arm_body(array_get(__match_arms, ai))
        let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }
        let arm_nl = if is_pctor(__cond_p) {
          let cargs_bind = get_pctor_args(__cond_p)
          let mut cbi = 0
          while cbi < array_length(cargs_bind) {
            let __sub_p = array_get(cargs_bind, cbi)
            if is_pbind(__sub_p) {
              let pname = get_pbind_name(__sub_p)
              let fl = array_length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + cbi * 8)
              emit_local_set(buf, fl)
              array_push(local_names, pname)
            }
            cbi = cbi + 1
          }
          ce(buf, __arm_body, local_names, array_length(local_names), ld_arm)
        } else {
          ce(buf, __arm_body, local_names, nl1, ld_arm)
        }
        if arm_nl > max_nl { max_nl = arm_nl }
        // Open else for next arm
        emit_else(buf)
        ai = ai + 1
      }
      // Compile catchall arm (or unreachable)
      array_truncate(local_names, names_len_at_match)
      let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }
      let catch_nl = if catchall_idx < num_arms {
        let __catch_arm = array_get(__match_arms, catchall_idx)
        let __catch_p = get_arm_pat(__catch_arm)
        let __catch_body = get_arm_body(__catch_arm)
        0
        if is_pbind(__catch_p) {
          let bname = get_pbind_name(__catch_p)
          let bind_local = array_length(local_names)
          emit_local_get(buf, scrut_local)
          emit_local_set(buf, bind_local)
          array_push(local_names, bname)
          ce(buf, __catch_body, local_names, array_length(local_names), ld_catch)
        } else { if is_pctor(__catch_p) {
          let cargs = get_pctor_args(__catch_p)
          let mut cbi2 = 0
          while cbi2 < array_length(cargs) {
            let __sub_p2 = array_get(cargs, cbi2)
            if is_pbind(__sub_p2) {
              let pname = get_pbind_name(__sub_p2)
              let fl2 = array_length(local_names)
              emit_local_get(buf, scrut_local)
              emit_i64_const(buf, -2)
              emit_i64_and(buf)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, 8 + cbi2 * 8)
              emit_local_set(buf, fl2)
              array_push(local_names, pname)
            }
            cbi2 = cbi2 + 1
          }
          ce(buf, __catch_body, local_names, array_length(local_names), ld_catch)
        } else { if is_ptuple(__catch_p) {
          let pats = get_ptuple_pats(__catch_p)
          let ptr_local2 = array_length(local_names)
          emit_local_get(buf, scrut_local)
          emit_local_set(buf, ptr_local2)
          array_push(local_names, "__tup_ptr2")
          let mut pi2 = 0
          while pi2 < array_length(pats) {
            let __tp = array_get(pats, pi2)
            if is_pbind(__tp) {
              let pname = get_pbind_name(__tp)
              let field_l = array_length(local_names)
              emit_local_get(buf, ptr_local2)
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, pi2 * 8)
              emit_local_set(buf, field_l)
              array_push(local_names, pname)
              0
            } else { if is_pwild(__tp) {
              0
            } else {
              throw("unsupported pattern in tuple destructure")
            } }
            pi2 = pi2 + 1
          }
          ce(buf, __catch_body, local_names, array_length(local_names), ld_catch)
        } else {
          ce(buf, __catch_body, local_names, array_length(local_names), ld_catch)
        } } }
      } else {
        bytebuf_push(buf, 0)  // unreachable
        0
      }
      if catch_nl > max_nl { max_nl = catch_nl }
      // Close all the if-else blocks
      let mut ci2 = 0
      while ci2 < num_cond_arms {
        emit_end(buf)
        ci2 = ci2 + 1
      }
      max_nl
  } else if __tag == 17 {
      // EArray
      let elems = get_earray_elems(expr)
      // Compile [a, b, c] as: let arr = array_new(); array_push(arr, a); ...
      let (arr_new_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_new")
      let (arr_push_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      array_push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < array_length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, array_get(elems, ei), local_names, nl, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
  } else if __tag == 18 {
      // EForIn
      let var_name = get_eforin_name(expr)
      let iter_expr = get_eforin_iter(expr)
      let body = get_eforin_body(expr)
      // for x in arr { body } => let arr = iter; let mut i = 0; while i < array_length(arr) { let x = array_get(arr, i); body; i = i + 1 }
      let (arr_len_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_length")
      let (arr_get_idx, _, _) = resolve_func(fn_names, fn_indices, fn_params, fn_returns, "array_get")
      // Compile iterator and store
      let arr_local = next_local
      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)
      emit_local_set(buf, arr_local)
      array_push(local_names, "__for_arr")
      // Counter local
      let i_local = nl1
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      array_push(local_names, "__for_i")
      let nl2 = nl1 + 1
      // block { loop {
      emit_block_void(buf)
        emit_loop_void(buf)
          // if i >= array_length(arr) then break
          emit_local_get(buf, i_local)
          emit_local_get(buf, arr_local)
          emit_call(buf, arr_len_idx)
          emit_i64_ge_s(buf)
          emit_i64_extend_i32_s(buf)
          emit_i32_wrap_i64(buf)
          emit_br_if(buf, 1)
          // let var_name = array_get(arr, i)
          let var_local = nl2
          emit_local_get(buf, arr_local)
          emit_local_get(buf, i_local)
          emit_call(buf, arr_get_idx)
          emit_local_set(buf, var_local)
          array_push(local_names, var_name)
          let nl3 = nl2 + 1
          // body (ld+1 for break/continue label offsets inside loop)
          let nl4 = ce(buf, body, local_names, nl3, ld + 1)
          emit_drop(buf)
          // i = i + 1
          emit_local_get(buf, i_local)
          emit_i64_const(buf, 1)
          emit_i64_add(buf)
          emit_local_set(buf, i_local)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl4
  } else if __tag == 19 {
      // EWhile
      let cond = get_ewhile_cond(expr)
      let body = get_ewhile_body(expr)
      emit_block_void(buf)
        emit_loop_void(buf)
          let nl1 = ce(buf, cond, local_names, next_local, ld + 1)
          emit_i64_eqz(buf)
          emit_br_if(buf, 1)
          let nl2 = ce(buf, body, local_names, nl1, ld + 1)
          emit_drop(buf)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
  } else if __tag == 20 {
      // EBreak
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
  } else if __tag == 21 {
      // EContinue
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
  } else if __tag == 22 {
      // EUnit
      emit_i64_const(buf, 0)
      next_local
  } else if __tag == 23 {
      // EThrow
      let msg_expr = get_ethrow_expr(expr)
      let nl = ce(buf, msg_expr, local_names, next_local, ld)
      emit_drop(buf)
      bytebuf_push(buf, 0)  // unreachable
      nl
  } else if __tag == 24 {
      // EFn
      let params = get_efn_params(expr)
      let fn_body = get_efn_body(expr)
      let param_names_arr = array_slice([""], 0, 0)
      let mut pi = 0
      while pi < array_length(params) {
        let (pname, _) = array_get(params, pi)
        array_push(param_names_arr, pname)
        pi = pi + 1
      }
      let fn_and_ctor = array_concat(fn_names, ctor_names)
      let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)
      let num_captures = array_length(captures)
      let user_params = array_length(params)

      let lam_buf = bytebuf_new()
      let lam_locals = array_slice([""], 0, 0)
      let mut lpi = 0
      while lpi < user_params {
        let (lpname, _) = array_get(params, lpi)
        array_push(lam_locals, lpname)
        lpi = lpi + 1
      }
      array_push(lam_locals, "__env")
      let env_param_idx = user_params
      let lam_nl_start = user_params + 1

      let lam_ref_cells = array_slice([""], 0, 0)
      let mut ci3 = 0
      let mut lam_nl = lam_nl_start
      while ci3 < num_captures {
        let cap_local = lam_nl
        let cap_name = array_get(captures, ci3)
        emit_local_get(lam_buf, env_param_idx)
        emit_i32_wrap_i64(lam_buf)
        emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
        emit_local_set(lam_buf, cap_local)
        array_push(lam_locals, cap_name)
        if array_contains_str(ref_cell_names, cap_name) {
          array_push(lam_ref_cells, cap_name)
        }
        lam_nl = lam_nl + 1
        ci3 = ci3 + 1
      }

      let final_lam_nl = compile_expr(
        lam_buf, fn_body, lam_locals, lam_nl,
        fn_names, fn_indices, fn_params, fn_returns,
        str_strs, str_offsets, str_lengths, -1,
        lambda_bodies, lambda_param_counts, lambda_captures,
        lambda_meta_i32, lambda_meta_i64, num_user_funcs, func_offset,
        lam_ref_cells, ctor_names, ctor_tags, ctor_field_counts
      )

      let lambda_idx = array_length(lambda_bodies)
      array_push(lambda_bodies, lam_buf)
      array_push(lambda_param_counts, user_params + 1)
      array_push(lambda_captures, captures)
      let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }
      array_push(lambda_meta_i32, 0)
      array_push(lambda_meta_i64, extra_lam)

      let table_slot = num_user_funcs + lambda_idx
      if num_captures == 0 {
        emit_i64_const(buf, (table_slot << 2) | 2)
        next_local
      } else {
        let alloc_size = 8 + num_captures * 8
        let ptr_local = next_local
        let mut nl2 = next_local + 1
        array_push(local_names, "__closure_ptr")
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_tee(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, alloc_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, table_slot)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, num_captures)
        emit_i32_store(buf, 2, 4)
        let mut csi = 0
        while csi < num_captures {
          let cap_name = array_get(captures, csi)
          let cap_idx = resolve_local(local_names, cap_name)
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, cap_idx)
          emit_i64_store(buf, 3, 8 + csi * 8)
          csi = csi + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl2
      }
  } else {
      throw("unsupported expression in codegen")
  }
}


// === Module compiler (non-WASI, for --invoke) ===

export let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {
  let fn_names_list = array_slice([""], 0, 0)
  let fn_param_counts = array_slice([0], 0, 0)
  let export_names = array_slice([""], 0, 0)
  let export_indices = array_slice([0], 0, 0)
  let fn_bodies_list = array_slice([EInt(0)], 0, 0)
  let fn_param_names_list = array_slice([array_slice([""], 0, 0)], 0, 0)

  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(is_export, _, name, _, expr) => {
        match expr {
          EFn(_, _, params, _, _, body) => {
            let cur_idx = array_length(fn_names_list)
            array_push(fn_names_list, name)
            array_push(fn_param_counts, array_length(params))
            array_push(fn_bodies_list, body)
            let pnames = array_slice([""], 0, 0)
            let mut pi = 0
            while pi < array_length(params) {
              let (pname, _) = array_get(params, pi)
              array_push(pnames, pname)
              pi = pi + 1
            }
            array_push(fn_param_names_list, pnames)
            if is_export {
              array_push(export_names, name)
              array_push(export_indices, cur_idx)
            }
            0
          },
          _ => 0
        }
      },
      _ => 0
    }
    i = i + 1
  }

  let num_funcs = array_length(fn_names_list)
  if num_funcs == 0 {
    throw("no functions found to compile")
  }

  let fn_indices_list = array_slice([0], 0, 0)
  let fn_returns_list = array_slice([0], 0, 0)
  let mut fi = 0
  while fi < num_funcs {
    array_push(fn_indices_list, fi)
    array_push(fn_returns_list, 1)
    fi = fi + 1
  }

  let type_defs = array_slice([0], 0, 0)
  let mut ti = 0
  while ti < num_funcs {
    array_push(type_defs, array_get(fn_param_counts, ti))
    array_push(type_defs, 1)
    ti = ti + 1
  }

  let type_indices = array_slice([0], 0, 0)
  let mut tii = 0
  while tii < num_funcs {
    array_push(type_indices, tii)
    tii = tii + 1
  }

  // Lambda accumulators (not used in non-WASI compile_module for now)
  let lambda_bodies_m = array_slice([array_slice([0], 0, 0)], 0, 0)
  let lambda_param_counts_m = array_slice([0], 0, 0)
  let lambda_captures_m = array_slice([array_slice([""], 0, 0)], 0, 0)
  let lambda_meta_i32_m = array_slice([0], 0, 0)
  let lambda_meta_i64_m = array_slice([0], 0, 0)

  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)
  let local_counts = array_slice([0], 0, 0)
  let mut bi = 0
  while bi < num_funcs {
    let body = array_get(fn_bodies_list, bi)
    let param_names = array_get(fn_param_names_list, bi)
    let body_buf = bytebuf_new()
    let local_names = array_slice([""], 0, 0)
    let mut pi = 0
    while pi < array_length(param_names) {
      array_push(local_names, array_get(param_names, pi))
      pi = pi + 1
    }
    let param_count = array_length(param_names)
    let empty_strs = array_slice([""], 0, 0)
    let empty_offs = array_slice([0], 0, 0)
    let empty_lens = array_slice([0], 0, 0)
    let final_nl = compile_expr(
      body_buf, body, local_names,
      param_count,
      fn_names_list, fn_indices_list, fn_param_counts, fn_returns_list,
      empty_strs, empty_offs, empty_lens,
      -1,
      lambda_bodies_m, lambda_param_counts_m, lambda_captures_m,
      lambda_meta_i32_m, lambda_meta_i64_m, num_funcs, 0,
      array_slice([""], 0, 0),
      array_slice([""], 0, 0), array_slice([0], 0, 0), array_slice([0], 0, 0)
    )
    array_push(bodies, body_buf)
    let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
    array_push(local_counts, extra)
    bi = bi + 1
  }

  let out = bytebuf_new()
  emit_header(out)
  emit_type_section_multi(out, type_defs)
  emit_function_section(out, type_indices)

  if array_length(export_names) > 0 {
    emit_export_section_multi(out, export_names, export_indices)
  }

  emit_code_section_with_locals(out, bodies, local_counts)
  bytebuf_to_bytes(out)
}

// === WASI Module compiler ===
// Memory layout:
//   0-7: iovec struct
//   8-11: nwritten
//   16-47: digit buffer (itoa + newline)
//   48-63: reserved
//   64+: string literal data
//   after strings: heap (bump allocator, global 0 = heap_ptr)

// Generate __print_i64 body (func 1)
// Param: 0=val(i64)
// Extra locals (i32 first, then i64): 1=is_neg(i32), 2=pos(i32), 3=digit(i32), 4=abs_val(i64)
let gen_print_i64_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
    emit_i64_const(b, 0)
    emit_local_get(b, 0)
    emit_i64_sub(b)
  emit_else(b)
    emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 48)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
    emit_loop_void(b)
      emit_local_get(b, 4)
      emit_i64_eqz(b)
      emit_br_if(b, 1)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_rem_s(b)
      emit_i32_wrap_i64(b)
      emit_local_set(b, 3)
      emit_local_get(b, 2)
      emit_local_get(b, 3)
      emit_i32_const(b, 48)
      emit_i32_add(b)
      emit_i32_store8(b, 0, 0)
      emit_local_get(b, 2)
      emit_i32_const(b, 1)
      emit_i32_sub(b)
      emit_local_set(b, 2)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_div_s(b)
      emit_local_set(b, 4)
      emit_br(b, 0)
    emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 45)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

// Generate __print_str body (func 2)
// local 0: packed(i64), local 1: offset(i32), local 2: length(i32)
let gen_print_str_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_i32_const(b, 0)
  emit_local_get(b, 1)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_local_get(b, 2)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

// Generate __str_len body (func 3): (packed: i64) -> i64
// Returns lower 32 bits as i64
let gen_str_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)  // 0xFFFFFFFF
  emit_i64_and(b)
  b
}

// Generate __str_eq body (func 4): (a: i64, b: i64) -> i64
// Compare string contents byte-by-byte
// locals: 0=a(i64), 1=b(i64), 2=len_a(i32), 3=len_b(i32),
//         4=off_a(i32), 5=off_b(i32), 6=i(i32)
let gen_str_eq_body = () -> Array[Int] {
  let b = bytebuf_new()
  // len_a = a & 0xFFFFFFFF
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // len_b = b & 0xFFFFFFFF
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // if len_a != len_b, return 0
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_ne(b)
  emit_if_i64(b)
    emit_i64_const(b, 0)
  emit_else(b)
    // off_a = (a >> 32) as i32
    emit_local_get(b, 0)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 4)
    // off_b = (b >> 32) as i32
    emit_local_get(b, 1)
    emit_i64_const(b, 32)
    emit_i64_shr_s(b)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 5)
    // i = 0
    emit_i32_const(b, 0)
    emit_local_set(b, 6)
    // loop: compare bytes
    emit_block_i64(b)
      emit_block_void(b)
        emit_loop_void(b)
          // if i >= len_a, break (all matched)
          emit_local_get(b, 6)
          emit_local_get(b, 2)
          emit_i32_ge_u(b)
          emit_br_if(b, 1)  // break to inner block_void
          // if mem[off_a+i] != mem[off_b+i], return 0
          emit_local_get(b, 4)
          emit_local_get(b, 6)
          emit_i32_add(b)
          emit_i32_load8_u(b, 0, 0)
          emit_local_get(b, 5)
          emit_local_get(b, 6)
          emit_i32_add(b)
          emit_i32_load8_u(b, 0, 0)
          emit_i32_ne(b)
          emit_if_void(b)
            emit_i64_const(b, 0)
            emit_br(b, 3)  // break to block_i64 with 0
          emit_end(b)
          // i++
          emit_local_get(b, 6)
          emit_i32_const(b, 1)
          emit_i32_add(b)
          emit_local_set(b, 6)
          emit_br(b, 0)  // continue loop
        emit_end(b)
      emit_end(b)
      // All bytes matched
      emit_i64_const(b, 1)
    emit_end(b)
  emit_end(b)
  b
}

// Generate __str_concat body (func 5): (a: i64, b: i64) -> i64
// Allocate new string, copy bytes, return packed ref
// locals: 0=a(i64), 1=b(i64), 2=len_a(i32), 3=len_b(i32),
//         4=off_a(i32), 5=off_b(i32), 6=new_ptr(i32), 7=new_len(i32)
let gen_str_concat_body = () -> Array[Int] {
  let b = bytebuf_new()
  // len_a = a & 0xFFFFFFFF
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // len_b
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // off_a = (a >> 32) as i32
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  // off_b
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  // new_len = len_a + len_b
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_add(b)
  emit_local_set(b, 7)
  // new_ptr = heap_ptr; heap_ptr += new_len
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_local_get(b, 7)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // memory.copy(new_ptr, off_a, len_a)
  emit_local_get(b, 6)  // dest
  emit_local_get(b, 4)  // src
  emit_local_get(b, 2)  // len
  emit_memory_copy(b)
  // memory.copy(new_ptr + len_a, off_b, len_b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_add(b)   // dest = new_ptr + len_a
  emit_local_get(b, 5)  // src
  emit_local_get(b, 3)  // len
  emit_memory_copy(b)
  // Return packed ref: (new_ptr << 32) | new_len
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 7)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

// Generate __arr_new body (func 6): () -> i64
// Create empty array: [cap=8(i32), len=0(i32), data_ptr(i32)]
// Header: 12 bytes. Data: cap * 8 bytes.
// Returns header ptr as i64.
let gen_arr_new_body = () -> Array[Int] {
  let b = bytebuf_new()
  // local 0: header_ptr (i32)
  // Allocate header (12 bytes) + data (8*8 = 64 bytes) = 76 bytes
  emit_global_get(b, 0)
  emit_local_tee(b, 0)
  emit_i32_const(b, 76)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // header[0] = cap = 8
  emit_local_get(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  // header[4] = len = 0
  emit_local_get(b, 0)
  emit_i32_const(b, 0)
  emit_i32_store(b, 2, 4)
  // header[8] = data_ptr = header_ptr + 12
  emit_local_get(b, 0)
  emit_local_get(b, 0)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_i32_store(b, 2, 8)
  // Return header_ptr as i64
  emit_local_get(b, 0)
  emit_i64_extend_i32_u(b)
  b
}

// Generate __arr_len body (func 7): (arr: i64) -> i64
// Read header[4] = length
let gen_arr_len_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 4)  // header[4] = length
  emit_i64_extend_i32_u(b)
  b
}

// Generate __arr_get body (func 8): (arr: i64, idx: i64) -> i64
// Read data[idx * 8]
// local 0: arr(i64), local 1: idx(i64), local 2: data_ptr(i32)
let gen_arr_get_body = () -> Array[Int] {
  let b = bytebuf_new()
  // data_ptr = header[8]
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  // load data_ptr + idx*8
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  // i32.shl
  bytebuf_push(b, 116)  // 0x74 i32.shl
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  b
}

// Generate __arr_push body (func 9): (arr: i64, val: i64) -> void
// Append val to array, grow if needed
// local 0: arr(i64), local 1: val(i64), local 2: hdr(i32),
// local 3: cap(i32), local 4: len(i32), local 5: data_ptr(i32),
// local 6: new_data(i32), local 7: new_cap(i32)
let gen_arr_push_body = () -> Array[Int] {
  let b = bytebuf_new()
  // hdr = arr as i32
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // cap = hdr[0]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 0)
  emit_local_set(b, 3)
  // len = hdr[4]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  // data_ptr = hdr[8]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 5)
  // if len >= cap: grow
  emit_local_get(b, 4)
  emit_local_get(b, 3)
  emit_i32_ge_u(b)
  emit_if_void(b)
    // new_cap = cap * 2
    emit_local_get(b, 3)
    emit_i32_const(b, 2)
    emit_i32_mul(b)
    emit_local_set(b, 7)
    // new_data = alloc(new_cap * 8)
    emit_global_get(b, 0)
    emit_local_tee(b, 6)
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_add(b)
    emit_global_set(b, 0)
    // memory.copy(new_data, data_ptr, len * 8)
    emit_local_get(b, 6)
    emit_local_get(b, 5)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_memory_copy(b)
    // update header
    emit_local_get(b, 2)
    emit_local_get(b, 7)
    emit_i32_store(b, 2, 0)  // cap = new_cap
    emit_local_get(b, 2)
    emit_local_get(b, 6)
    emit_i32_store(b, 2, 8)  // data_ptr = new_data
    // update local
    emit_local_get(b, 6)
    emit_local_set(b, 5)
  emit_end(b)
  // data[len] = val
  emit_local_get(b, 5)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 1)
  emit_i64_store(b, 3, 0)
  // len++
  emit_local_get(b, 2)
  emit_local_get(b, 4)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 4)
  b
}

// Generate __arr_set body (func 10): (arr: i64, idx: i64, val: i64) -> void
// local 0: arr(i64), local 1: idx(i64), local 2: val(i64), local 3: data_ptr(i32)
let gen_arr_set_body = () -> Array[Int] {
  let b = bytebuf_new()
  // data_ptr = header[8]
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 3)
  // data[idx*8] = val
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 2)
  emit_i64_store(b, 3, 0)
  b
}

// Generate __arr_slice body: (arr: i64, start: i64, end: i64) -> i64
// Creates new array with elements from start to end
// locals: 0=arr(i64), 1=start(i64), 2=end(i64), 3=hdr(i32), 4=src_data(i32),
//   5=new_len(i32), 6=new_hdr(i32), 7=new_data(i32), 8=cap(i32)
let gen_arr_slice_body = () -> Array[Int] {
  let b = bytebuf_new()
  // hdr = arr as i32
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // src_data = hdr[8]
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 4)
  // new_len = end - start (as i32)
  emit_local_get(b, 2)
  emit_i32_wrap_i64(b)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_sub(b)
  emit_local_set(b, 5)
  // cap = new_len + 8 (always at least 8, avoids 0-size alloc)
  emit_local_get(b, 5)
  emit_i32_const(b, 8)
  emit_i32_add(b)
  emit_local_set(b, 8)
  // Allocate header (12 bytes) + data (cap * 8 bytes)
  emit_global_get(b, 0)
  emit_local_tee(b, 6)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl (cap * 8)
  emit_i32_add(b)  // 12 + cap * 8
  emit_i32_add(b)  // heap_ptr + alloc_size
  emit_global_set(b, 0)
  // Set header: cap
  emit_local_get(b, 6)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  // Set header: len = new_len
  emit_local_get(b, 6)
  emit_local_get(b, 5)
  emit_i32_store(b, 2, 4)
  // new_data = new_hdr + 12
  emit_local_get(b, 6)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 7)
  // Set header: data_ptr = new_data
  emit_local_get(b, 6)
  emit_local_get(b, 7)
  emit_i32_store(b, 2, 8)
  // memory.copy(new_data, src_data + start*8, new_len*8)
  emit_local_get(b, 7)
  emit_local_get(b, 4)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_memory_copy(b)
  // Return new_hdr as i64
  emit_local_get(b, 6)
  emit_i64_extend_i32_u(b)
  b
}

// Generate __arr_concat body: (arr1: i64, arr2: i64) -> i64
// Creates new array with all elements from both arrays
// locals: 0=arr1(i64), 1=arr2(i64), 2=hdr1(i32), 3=hdr2(i32),
//   4=len1(i32), 5=len2(i32), 6=data1(i32), 7=data2(i32),
//   8=total_len(i32), 9=new_hdr(i32), 10=new_data(i32)
let gen_arr_concat_body = () -> Array[Int] {
  let b = bytebuf_new()
  // hdr1 = arr1 as i32
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // hdr2 = arr2 as i32
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // len1 = hdr1[4]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 4)
  // len2 = hdr2[4]
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 4)
  emit_local_set(b, 5)
  // data1 = hdr1[8]
  emit_local_get(b, 2)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 6)
  // data2 = hdr2[8]
  emit_local_get(b, 3)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 7)
  // total_len = len1 + len2
  emit_local_get(b, 4)
  emit_local_get(b, 5)
  emit_i32_add(b)
  emit_local_set(b, 8)
  // Allocate new array: header (12) + total_len * 8
  emit_global_get(b, 0)
  emit_local_tee(b, 9)
  emit_i32_const(b, 12)
  emit_local_get(b, 8)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // Set header: cap = total_len
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 0)
  // Set header: len = total_len
  emit_local_get(b, 9)
  emit_local_get(b, 8)
  emit_i32_store(b, 2, 4)
  // new_data = new_hdr + 12
  emit_local_get(b, 9)
  emit_i32_const(b, 12)
  emit_i32_add(b)
  emit_local_set(b, 10)
  // Set header: data_ptr = new_data
  emit_local_get(b, 9)
  emit_local_get(b, 10)
  emit_i32_store(b, 2, 8)
  // memory.copy(new_data, data1, len1*8)
  emit_local_get(b, 10)
  emit_local_get(b, 6)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_memory_copy(b)
  // memory.copy(new_data + len1*8, data2, len2*8)
  emit_local_get(b, 10)
  emit_local_get(b, 4)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_i32_add(b)
  emit_local_get(b, 7)
  emit_local_get(b, 5)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)  // i32.shl
  emit_memory_copy(b)
  // Return new_hdr as i64
  emit_local_get(b, 9)
  emit_i64_extend_i32_u(b)
  b
}

// Generate __str_char_code_at body (func 13): (s: i64, idx: i64) -> i64
// Extract offset from packed string, load byte at offset+idx
// locals: 0=s(i64), 1=idx(i64), 2=offset(i32)
let gen_str_char_code_at_body = () -> Array[Int] {
  let b = bytebuf_new()
  // offset = (s >> 32) as i32
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  // result = mem[offset + idx] as i64
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i64_extend_i32_u(b)
  b
}

// Generate __str_from_char_code body (func 14): (code: i64) -> i64
// Allocate 1 byte on heap, store char, return packed i64
// locals: 0=code(i64), 1=ptr(i32)
let gen_str_from_char_code_body = () -> Array[Int] {
  let b = bytebuf_new()
  // ptr = heap_ptr
  emit_global_get(b, 0)
  emit_local_tee(b, 1)
  // heap_ptr += 1
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_global_set(b, 0)
  // mem[ptr] = code as byte
  emit_local_get(b, 1)
  emit_local_get(b, 0)
  emit_i32_wrap_i64(b)
  emit_i32_store8(b, 0, 0)
  // return (ptr << 32) | 1
  emit_local_get(b, 1)
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_i64_const(b, 1)
  emit_i64_or(b)
  b
}

// Generate __str_substring body (func 15): (s: i64, start: i64, end: i64) -> i64
// Return packed i64 with new_offset = old_offset + start, new_len = end - start
// locals: 0=s(i64), 1=start(i64), 2=end(i64), 3=old_offset(i32), 4=new_len(i32)
let gen_str_substring_body = () -> Array[Int] {
  let b = bytebuf_new()
  // old_offset = (s >> 32) as i32
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  // new_len = (end - start) as i32
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  emit_i64_sub(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  // new_offset = old_offset + start as i32
  emit_local_get(b, 3)
  emit_local_get(b, 1)
  emit_i32_wrap_i64(b)
  emit_i32_add(b)
  // return (new_offset << 32) | new_len
  emit_i64_extend_i32_u(b)
  emit_i64_const(b, 32)
  emit_i64_shl(b)
  emit_local_get(b, 4)
  emit_i64_extend_i32_u(b)
  emit_i64_or(b)
  b
}

// Generate __identity body (func 16): (val: i64) -> i64
// Just returns the argument unchanged (used for array_builder_freeze)
let gen_identity_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  b
}

// Generate __double_to_int body (func 11): (val: i64) -> i64
// Reinterpret i64 bits as f64, then truncate to i64
let gen_double_to_int_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_reinterpret_i64(b)
  emit_i64_trunc_f64_s(b)
  b
}

// Generate __int_to_double body (func 12): (val: i64) -> i64
// Convert i64 to f64, then reinterpret as i64 bits
let gen_int_to_double_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_f64_convert_i64_s(b)
  emit_i64_reinterpret_f64(b)
  b
}

// === Builtin registry ===
// Builtin descriptor indices (after fd_write import at func 0):
// func 1: __print_i64 — (i64) -> void, 4 mixed locals
// func 2: __print_str — (i64) -> void, 2 i32 locals
// func 3: __str_len — (i64) -> i64, 0 extra
// func 4: __str_eq — (i64,i64) -> i64, 5 i32 locals
// func 5: __str_concat — (i64,i64) -> i64, 6 i32 locals
// func 6: __arr_new — () -> i64, 1 i32 local
// func 7: __arr_len — (i64) -> i64, 0 extra
// func 8: __arr_get — (i64,i64) -> i64, 1 i32 local
// func 9: __arr_push — (i64,i64) -> void, 6 i32 locals
// func 10: __arr_set — (i64,i64,i64) -> void, 1 i32 local
// func 11: __double_to_int — (i64) -> i64, 0 extra
// func 12: __int_to_double — (i64) -> i64, 0 extra
// func 13: __str_char_code_at — (i64,i64) -> i64, 1 i32 local
// func 14: __str_from_char_code — (i64) -> i64, 1 i32 local
// func 15: __str_substring — (i64,i64,i64) -> i64, 2 i32 locals
// func 16: __identity — (i64) -> i64, 0 extra [array_builder_freeze]

export let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {
  // Collect user functions
  let fn_names_list = array_slice([""], 0, 0)
  let fn_param_counts = array_slice([0], 0, 0)

  // Store stmt indices for body extraction during compilation
  let fn_stmt_indices = array_slice([0], 0, 0)

  let mut i = 0
  while i < array_length(stmts) {
    let stmt = array_get(stmts, i)
    if is_slet(stmt) {
      let name = get_slet_name(stmt)
      let expr = get_slet_expr(stmt)
      if is_efn(expr) {
        let params = get_efn_params(expr)
        array_push(fn_names_list, name)
        array_push(fn_param_counts, array_length(params))
        array_push(fn_stmt_indices, i)
      }
    }
    i = i + 1
  }

  // Collect enum variant constructors (start with built-in Option: None=0, Some=1)
  let ctor_names_list = array_slice(["None", "Some"], 0, 2)
  let ctor_tags_list = array_slice([0, 1], 0, 2)
  let ctor_field_counts_list = array_slice([0, 1], 0, 2)
  let mut ctor_next_tag = 2
  let mut ei2 = 0
  while ei2 < array_length(stmts) {
    match array_get(stmts, ei2) {
      SEnum(_, _, variants) => {
        let mut vi = 0
        while vi < array_length(variants) {
          let (vname, vfields) = array_get(variants, vi)
          array_push(ctor_names_list, vname)
          array_push(ctor_tags_list, ctor_next_tag)
          array_push(ctor_field_counts_list, array_length(vfields))
          ctor_next_tag = ctor_next_tag + 1
          vi = vi + 1
        }
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }

  let num_user_funcs = array_length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }

  // Find entry function
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if string_equals(array_get(fn_names_list, ei), entry_name) {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  if entry_user_idx < 0 {
    throw(string_concat("entry function not found: ", entry_name))
  }

  // String table
  let str_strs = collect_strings_stmts(stmts)
  let num_strings = array_length(str_strs)
  let data_base = 64
  let str_offsets = array_slice([0], 0, 0)
  let str_lengths = array_slice([0], 0, 0)
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = array_get(str_strs, si)
    let slen = string_length(s)
    array_push(str_offsets, str_pos)
    array_push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  // Align heap start to 8 bytes
  let heap_start = ((str_pos + 7) / 8) * 8

  // Function layout:
  // func 0: fd_write (import)
  // func 1-18: generated builtins (18 funcs)
  // func 19..19+N-1: user functions
  // func 19+N: _start
  let num_generated = 18
  let func_offset = 1 + num_generated  // = 19

  // Builtin table: (name, param_count, wasm_func_idx, has_return)
  // To add a new builtin: add one entry here + one gen_*_body() push below
  let builtin_defs = [
    ("print_int",           1, 1,  0),
    ("print_str",           1, 2,  0),
    ("string_length",       1, 3,  1),
    ("string_equals",       2, 4,  1),
    ("string_concat",       2, 5,  1),
    ("array_new",           0, 6,  1),
    ("array_length",        1, 7,  1),
    ("array_get",           2, 8,  1),
    ("array_push",          2, 9,  0),
    ("array_set",           3, 10, 0),
    ("double_to_int",       1, 11, 1),
    ("int_to_double",       1, 12, 1),
    ("string_char_code_at", 2, 13, 1),
    ("string_from_char_code", 1, 14, 1),
    ("string_substring",    3, 15, 1),
    // Aliases (point to existing wasm funcs)
    ("array_builder",       0, 6,  1),
    ("array_builder_push",  2, 9,  0),
    ("array_builder_freeze", 1, 16, 1),
    ("array_slice",         3, 17, 1),
    ("array_concat",        2, 18, 1)
  ]
  let mut __bi = 0
  while __bi < array_length(builtin_defs) {
    let (bname, bparams, _, _) = array_get(builtin_defs, __bi)
    array_push(fn_names_list, bname)
    array_push(fn_param_counts, bparams)
    __bi = __bi + 1
  }

  // Build fn_indices and fn_returns
  let fn_indices_list = array_slice([0], 0, 0)
  let fn_returns_list = array_slice([0], 0, 0)
  let mut fi = 0
  while fi < num_user_funcs {
    array_push(fn_indices_list, fi + func_offset)
    array_push(fn_returns_list, 1)
    fi = fi + 1
  }
  // Builtin indices and returns (from builtin_defs table)
  let mut __bi2 = 0
  while __bi2 < array_length(builtin_defs) {
    let (_, _, bwasm_idx, breturns) = array_get(builtin_defs, __bi2)
    array_push(fn_indices_list, bwasm_idx)
    array_push(fn_returns_list, breturns)
    __bi2 = __bi2 + 1
  }

  // === Type section ===
  // type 0: fd_write (i32,i32,i32,i32) -> (i32)
  // type 1: (i64) -> () [print_int, print_str]
  // type 2: () -> () [_start]
  // type 3: (i64) -> (i64) [string_length, array_length, str_from_char_code]
  // type 4: (i64,i64) -> (i64) [string_equals, string_concat, array_get, str_char_code_at]
  // type 5: () -> (i64) [array_new]
  // type 6: (i64,i64) -> () [array_push]
  // type 7: (i64,i64,i64) -> () [array_set]
  // type 8: (i64,i64,i64) -> (i64) [str_substring]
  // type 9+: closure call types
  let num_base_types = 9

  // Lambda accumulators (populated during compilation)
  let lambda_bodies_w = array_slice([array_slice([0], 0, 0)], 0, 0)
  let lambda_param_counts_w = array_slice([0], 0, 0)
  let lambda_captures_w = array_slice([array_slice([""], 0, 0)], 0, 0)
  let lambda_meta_i32 = array_slice([0], 0, 0)
  let lambda_meta_i64 = array_slice([0], 0, 0)

  // === Code section bodies ===
  let bodies = array_slice([array_slice([0], 0, 0)], 0, 0)
  let meta_i32 = array_slice([0], 0, 0)
  let meta_i64 = array_slice([0], 0, 0)

  // Builtin bodies
  array_push(bodies, gen_print_i64_body())
  array_push(meta_i32, 3)
  array_push(meta_i64, 1)
  array_push(bodies, gen_print_str_body())
  array_push(meta_i32, 2)
  array_push(meta_i64, 0)
  array_push(bodies, gen_str_len_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)
  array_push(bodies, gen_str_eq_body())
  array_push(meta_i32, 5)
  array_push(meta_i64, 0)
  array_push(bodies, gen_str_concat_body())
  array_push(meta_i32, 6)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_new_body())
  array_push(meta_i32, 1)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_len_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_get_body())
  array_push(meta_i32, 1)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_push_body())
  array_push(meta_i32, 6)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_set_body())
  array_push(meta_i32, 1)
  array_push(meta_i64, 0)
  array_push(bodies, gen_double_to_int_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)
  array_push(bodies, gen_int_to_double_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)
  array_push(bodies, gen_str_char_code_at_body())
  array_push(meta_i32, 1)
  array_push(meta_i64, 0)
  array_push(bodies, gen_str_from_char_code_body())
  array_push(meta_i32, 1)
  array_push(meta_i64, 0)
  array_push(bodies, gen_str_substring_body())
  array_push(meta_i32, 2)
  array_push(meta_i64, 0)
  array_push(bodies, gen_identity_body())
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_slice_body())
  array_push(meta_i32, 6)
  array_push(meta_i64, 0)
  array_push(bodies, gen_arr_concat_body())
  array_push(meta_i32, 9)
  array_push(meta_i64, 0)

  // Compile user function bodies (lambdas accumulated here)
  // In WASI mode, all user funcs get an extra __env param (i64) for table compatibility
  let mut bi = 0
  while bi < num_user_funcs {
    // Extract body and params from original stmts via stmt index
    let __bi_stmt = array_get(stmts, array_get(fn_stmt_indices, bi))
    let __bi_expr = get_slet_expr(__bi_stmt)
    let __bi_params = get_efn_params(__bi_expr)
    let body = get_efn_body(__bi_expr)
    let body_buf = bytebuf_new()
    let local_names = array_slice([""], 0, 0)
    let mut pi = 0
    while pi < array_length(__bi_params) {
      let (pname, _) = array_get(__bi_params, pi)
      array_push(local_names, pname)
      pi = pi + 1
    }
    // Add __env param (unused, but needed for table calling convention)
    array_push(local_names, "__env")
    let param_count = array_length(__bi_params) + 1  // includes __env
    let final_nl = compile_expr(
      body_buf, body, local_names,
      param_count,
      fn_names_list, fn_indices_list, fn_param_counts, fn_returns_list,
      str_strs, str_offsets, str_lengths,
      -1,
      lambda_bodies_w, lambda_param_counts_w, lambda_captures_w,
      lambda_meta_i32, lambda_meta_i64, num_user_funcs, func_offset,
      array_slice([""], 0, 0),
      ctor_names_list, ctor_tags_list, ctor_field_counts_list
    )
    array_push(bodies, body_buf)
    let extra = if final_nl > param_count { final_nl - param_count } else { 0 }
    array_push(meta_i32, 0)
    array_push(meta_i64, extra)
    bi = bi + 1
  }

  let num_lambdas = array_length(lambda_bodies_w)

  // _start body
  let start_body = bytebuf_new()
  let entry_func_idx = entry_user_idx + func_offset
  let entry_params = array_get(fn_param_counts, entry_user_idx)
  if entry_params != 0 {
    throw("WASI entry function must take 0 parameters")
  }
  emit_i64_const(start_body, 0)  // env=0 for user func
  emit_call(start_body, entry_func_idx)
  emit_call(start_body, 1)  // __print_i64
  array_push(bodies, start_body)
  array_push(meta_i32, 0)
  array_push(meta_i64, 0)

  // Append lambda bodies after _start
  let mut li = 0
  while li < num_lambdas {
    array_push(bodies, array_get(lambda_bodies_w, li))
    array_push(meta_i32, array_get(lambda_meta_i32, li))
    array_push(meta_i64, array_get(lambda_meta_i64, li))
    li = li + 1
  }

  // Determine max closure call arity needed (user_params, i.e. N where sig is (i64^(N+1))->i64)
  // Closure call types: for each arity N (0,1,2,...,max_arity), type = (i64^(N+1)) -> i64
  // These start at type index = num_base_types + num_user_funcs
  let mut max_closure_arity = -1
  // Check all lambda param counts (which include +1 for env)
  let mut lai = 0
  while lai < num_lambdas {
    let lpc = array_get(lambda_param_counts_w, lai) - 1  // user_params = total - 1 (env)
    if lpc > max_closure_arity {
      max_closure_arity = lpc
    }
    lai = lai + 1
  }
  // Also check user funcs that might be used as values (they get env=0 appended)
  // Their call_indirect arity = their param_count
  let mut uai = 0
  while uai < num_user_funcs {
    let upc = array_get(fn_param_counts, uai)
    if upc > max_closure_arity {
      max_closure_arity = upc
    }
    uai = uai + 1
  }
  let num_closure_types = if max_closure_arity >= 0 { max_closure_arity + 1 } else { 0 }

  // === Type section ===
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)

  emit_func_type_raw(type_content, [127, 127, 127, 127], [127])  // type 0: fd_write
  emit_func_type_raw(type_content, [126], array_slice([0], 0, 0))  // type 1: (i64)->()
  emit_func_type_raw(type_content, array_slice([0], 0, 0), array_slice([0], 0, 0))  // type 2: ()->()
  emit_func_type_raw(type_content, [126], [126])  // type 3: (i64)->(i64)
  emit_func_type_raw(type_content, [126, 126], [126])  // type 4: (i64,i64)->(i64)
  emit_func_type_raw(type_content, array_slice([0], 0, 0), [126])  // type 5: ()->(i64)
  emit_func_type_raw(type_content, [126, 126], array_slice([0], 0, 0))  // type 6: (i64,i64)->()
  emit_func_type_raw(type_content, [126, 126, 126], array_slice([0], 0, 0))  // type 7: (i64,i64,i64)->()
  emit_func_type_raw(type_content, [126, 126, 126], [126])  // type 8: (i64,i64,i64)->(i64)

  // Closure call types: (i64^(N+1)) -> i64 for N = 0..max_closure_arity
  // Used for both user funcs (with env) and lambdas
  let mut cti = 0
  while cti < num_closure_types {
    let num_params = cti + 1  // N user params + 1 env
    let ct_params = array_slice([0], 0, 0)
    let mut cpti = 0
    while cpti < num_params {
      array_push(ct_params, 126)
      cpti = cpti + 1
    }
    emit_func_type_raw(type_content, ct_params, [126])
    cti = cti + 1
  }

  let out = bytebuf_new()
  emit_header(out)
  bytebuf_push_section(out, 1, type_content)

  // === Import section ===
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)

  // === Function section ===
  // func 1-18: builtins, func 19..19+N-1: user, func 19+N: _start, func 19+N+1...: lambdas
  let func_type_indices = array_slice([0], 0, 0)
  array_push(func_type_indices, 1)  // __print_i64
  array_push(func_type_indices, 1)  // __print_str
  array_push(func_type_indices, 3)  // __str_len
  array_push(func_type_indices, 4)  // __str_eq
  array_push(func_type_indices, 4)  // __str_concat
  array_push(func_type_indices, 5)  // __arr_new
  array_push(func_type_indices, 3)  // __arr_len
  array_push(func_type_indices, 4)  // __arr_get
  array_push(func_type_indices, 6)  // __arr_push
  array_push(func_type_indices, 7)  // __arr_set
  array_push(func_type_indices, 3)  // __double_to_int
  array_push(func_type_indices, 3)  // __int_to_double
  array_push(func_type_indices, 4)  // __str_char_code_at
  array_push(func_type_indices, 3)  // __str_from_char_code
  array_push(func_type_indices, 8)  // __str_substring
  array_push(func_type_indices, 3)  // __identity (array_builder_freeze)
  array_push(func_type_indices, 8)  // __arr_slice (i64,i64,i64) -> (i64)
  array_push(func_type_indices, 4)  // __arr_concat (i64,i64) -> (i64)
  // User funcs: type = closure call type for their arity (includes env)
  let mut fti = 0
  while fti < num_user_funcs {
    let upc = array_get(fn_param_counts, fti)
    array_push(func_type_indices, num_base_types + upc)
    fti = fti + 1
  }
  array_push(func_type_indices, 2)  // _start
  // Lambda function type indices
  let mut lfi = 0
  while lfi < num_lambdas {
    let lam_user_params = array_get(lambda_param_counts_w, lfi) - 1
    array_push(func_type_indices, num_base_types + lam_user_params)
    lfi = lfi + 1
  }
  emit_function_section(out, func_type_indices)

  // === Table section (if closures exist) ===
  let total_table_entries = num_user_funcs + num_lambdas
  if total_table_entries > 0 {
    emit_table_section_funcref(out, total_table_entries)
  }

  // === Memory section ===
  emit_memory_section(out, 1)

  // === Global section: heap_ptr ===
  emit_global_section_i32_mut(out, heap_start)

  // === Export section ===
  let start_func_idx = func_offset + num_user_funcs
  emit_exports_with_memory(out, ["_start"], [start_func_idx], "memory", 0)

  // === Element section (if closures exist) ===
  if total_table_entries > 0 {
    let table_func_indices = array_slice([0], 0, 0)
    // User funcs: table slot i -> func index func_offset+i
    let mut tei = 0
    while tei < num_user_funcs {
      array_push(table_func_indices, func_offset + tei)
      tei = tei + 1
    }
    // Lambda funcs: table slot num_user_funcs+j -> func index start_func_idx+1+j
    let mut tej = 0
    while tej < num_lambdas {
      array_push(table_func_indices, start_func_idx + 1 + tej)
      tej = tej + 1
    }
    emit_element_section_active(out, table_func_indices)
  }

  // === Encode code section manually (mixed local types) ===
  let code_content = bytebuf_new()
  bytebuf_push_vec_header(code_content, array_length(bodies))

  let mut ci = 0
  while ci < array_length(bodies) {
    let body = array_get(bodies, ci)
    let func_buf = bytebuf_new()
    let ni32 = array_get(meta_i32, ci)
    let ni64 = array_get(meta_i64, ci)

    if ni32 == 0 {
      if ni64 == 0 {
        leb128_encode_u32(func_buf, 0)  // no locals
      } else {
        leb128_encode_u32(func_buf, 1)  // 1 group
        leb128_encode_u32(func_buf, ni64)
        bytebuf_push(func_buf, 126)  // i64
      }
    } else {
      if ni64 == 0 {
        leb128_encode_u32(func_buf, 1)
        leb128_encode_u32(func_buf, ni32)
        bytebuf_push(func_buf, 127)  // i32
      } else {
        leb128_encode_u32(func_buf, 2)  // 2 groups
        leb128_encode_u32(func_buf, ni32)
        bytebuf_push(func_buf, 127)  // i32
        leb128_encode_u32(func_buf, ni64)
        bytebuf_push(func_buf, 126)  // i64
      }
    }

    bytebuf_push_array(func_buf, body)
    bytebuf_push(func_buf, 11)  // end
    leb128_encode_u32(code_content, bytebuf_length(func_buf))
    bytebuf_push_array(code_content, func_buf)
    ci = ci + 1
  }

  bytebuf_push_section(out, 10, code_content)

  // === Data section ===
  if num_strings > 0 {
    let data_offsets = array_slice([0], 0, 0)
    let data_bufs = array_slice([array_slice([0], 0, 0)], 0, 0)
    let mut di = 0
    while di < num_strings {
      array_push(data_offsets, array_get(str_offsets, di))
      array_push(data_bufs, string_to_data(array_get(str_strs, di)))
      di = di + 1
    }
    emit_data_section_multi(out, data_offsets, data_bufs)
  }

  bytebuf_to_bytes(out)
}
