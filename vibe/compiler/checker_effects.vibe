//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./builtins.vibe {
  lookup_builtin
}

import ./types.vibe {
  Type, TypeEnv, env_lookup
}

//# Types

export enum EffectError {
  EEThrowOutsideEffect(String);
  EEEffectfulCallOutsideEffect(String)
}

//# Functions

let is_effectful_type = (ty: Type) -> Bool {
  match ty {
    CtFn(_, _, has_effect) => has_effect,
    _ => false
  }
}

let is_effectful_builtin = (name: String) -> Bool {
  String::equals(name, "throw")
  || String::equals(name, "sh")
  || String::equals(name, "sh_lines")
  || String::equals(name, "Fs::read_file")
  || String::equals(name, "Fs::write_file")
  || String::equals(name, "Fs::exists")
  || String::equals(name, "Fs::readdir")
  || String::equals(name, "Fs::is_dir")
  || String::equals(name, "Fs::mkdir")
  || String::equals(name, "Fs::mkdir_p")
  || String::equals(name, "Fs::getcwd")
  || String::equals(name, "Fs::chdir")
  || String::equals(name, "Fs::remove")
  || String::equals(name, "Fs::is_file")
  || String::equals(name, "Fs::copy")
  || String::equals(name, "Fs::rename")
  || String::equals(name, "Fs::append")
  || String::equals(name, "Fs::write_bytes")
  || String::equals(name, "Env::get")
  || String::equals(name, "Http::request")
  || String::equals(name, "Http::listen")
}

let is_effectful_name = (name: String, env: TypeEnv) -> Bool {
  if is_effectful_builtin(name) {
    true
  } else {
    match env_lookup(env, name) {
      Some(ty) => is_effectful_type(ty),
      None => match lookup_builtin(name) {
        Some(ty) => is_effectful_type(ty),
        None => false
      }
    }
  }
}

export let rec check_effects_expr = (expr: Expr, env: TypeEnv, in_effect: Bool) -> Array[EffectError] {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  match expr {
    EThrow(_) => {
      if !in_effect {
        Array::push(errors, EEThrowOutsideEffect("throw"))
      }
      errors
    },
    EHandle(body, arms) => {
      let body_errs = check_effects_expr(body, env, true)
      let mut i = 0
      while i < Array::length(body_errs) {
        Array::push(errors, Array::get(body_errs, i))
        i = i + 1
      }
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        let arm_errs = check_effects_expr(arm_body, env, in_effect)
        let mut j = 0
        while j < Array::length(arm_errs) {
          Array::push(errors, Array::get(arm_errs, j))
          j = j + 1
        }
        ai = ai + 1
      }
      errors
    },
    ECall(callee, args) => {
      match callee {
        EIdent(name) => if !in_effect && is_effectful_name(name, env) {
          Array::push(errors, EEEffectfulCallOutsideEffect(name))
        }
        ,
        _ => ()
      }
      let ce = check_effects_expr(callee, env, in_effect)
      let mut i = 0
      while i < Array::length(ce) {
        Array::push(errors, Array::get(ce, i))
        i = i + 1
      }
      let mut ai = 0
      while ai < Array::length(args) {
        let ae = check_effects_expr(Array::get(args, ai), env, in_effect)
        let mut j = 0
        while j < Array::length(ae) {
          Array::push(errors, Array::get(ae, j))
          j = j + 1
        }
        ai = ai + 1
      }
      errors
    },
    EFn(_, _, _, _, effect, body) => {
      let fn_in_effect = match effect {
        Some(_) => true,
        None => false
      }
      let body_errs = check_effects_expr(body, env, fn_in_effect)
      let mut i = 0
      while i < Array::length(body_errs) {
        Array::push(errors, Array::get(body_errs, i))
        i = i + 1
      }
      errors
    },
    ELet(_, val, body) => {
      let ve = check_effects_expr(val, env, in_effect)
      let be = check_effects_expr(body, env, in_effect)
      let mut i = 0
      while i < Array::length(ve) {
        Array::push(errors, Array::get(ve, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(be) {
        Array::push(errors, Array::get(be, i))
        i = i + 1
      }
      errors
    },
    ELetRec(_, val, body) => {
      let ve = check_effects_expr(val, env, in_effect)
      let be = check_effects_expr(body, env, in_effect)
      let mut i = 0
      while i < Array::length(ve) {
        Array::push(errors, Array::get(ve, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(be) {
        Array::push(errors, Array::get(be, i))
        i = i + 1
      }
      errors
    },
    ELetMut(_, val, body) => {
      let ve = check_effects_expr(val, env, in_effect)
      let be = check_effects_expr(body, env, in_effect)
      let mut i = 0
      while i < Array::length(ve) {
        Array::push(errors, Array::get(ve, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(be) {
        Array::push(errors, Array::get(be, i))
        i = i + 1
      }
      errors
    },
    ESeq(a, b) => {
      let ae = check_effects_expr(a, env, in_effect)
      let be = check_effects_expr(b, env, in_effect)
      let mut i = 0
      while i < Array::length(ae) {
        Array::push(errors, Array::get(ae, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(be) {
        Array::push(errors, Array::get(be, i))
        i = i + 1
      }
      errors
    },
    EIf(cond, then_e, else_e) => {
      let ce = check_effects_expr(cond, env, in_effect)
      let te = check_effects_expr(then_e, env, in_effect)
      let ee = check_effects_expr(else_e, env, in_effect)
      let mut i = 0
      while i < Array::length(ce) {
        Array::push(errors, Array::get(ce, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(te) {
        Array::push(errors, Array::get(te, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(ee) {
        Array::push(errors, Array::get(ee, i))
        i = i + 1
      }
      errors
    },
    EMatch(scrutinee, arms) => {
      let se = check_effects_expr(scrutinee, env, in_effect)
      let mut i = 0
      while i < Array::length(se) {
        Array::push(errors, Array::get(se, i))
        i = i + 1
      }
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        let ae = check_effects_expr(arm_body, env, in_effect)
        let mut j = 0
        while j < Array::length(ae) {
          Array::push(errors, Array::get(ae, j))
          j = j + 1
        }
        ai = ai + 1
      }
      errors
    },
    EWhile(cond, body) => {
      let ce = check_effects_expr(cond, env, in_effect)
      let be = check_effects_expr(body, env, in_effect)
      let mut i = 0
      while i < Array::length(ce) {
        Array::push(errors, Array::get(ce, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(be) {
        Array::push(errors, Array::get(be, i))
        i = i + 1
      }
      errors
    },
    EForIn(_, iter, body) => {
      let ie = check_effects_expr(iter, env, in_effect)
      let be = check_effects_expr(body, env, in_effect)
      let mut i = 0
      while i < Array::length(ie) {
        Array::push(errors, Array::get(ie, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(be) {
        Array::push(errors, Array::get(be, i))
        i = i + 1
      }
      errors
    },
    EBinOp(_, left, right) => {
      let le = check_effects_expr(left, env, in_effect)
      let re = check_effects_expr(right, env, in_effect)
      let mut i = 0
      while i < Array::length(le) {
        Array::push(errors, Array::get(le, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(re) {
        Array::push(errors, Array::get(re, i))
        i = i + 1
      }
      errors
    },
    EUnaryOp(_, operand) => check_effects_expr(operand, env, in_effect),
    EAssign(_, val, cont) => {
      let ve = check_effects_expr(val, env, in_effect)
      let ce = check_effects_expr(cont, env, in_effect)
      let mut i = 0
      while i < Array::length(ve) {
        Array::push(errors, Array::get(ve, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(ce) {
        Array::push(errors, Array::get(ce, i))
        i = i + 1
      }
      errors
    },
    EAssignOp(_, _, val, cont) => {
      let ve = check_effects_expr(val, env, in_effect)
      let ce = check_effects_expr(cont, env, in_effect)
      let mut i = 0
      while i < Array::length(ve) {
        Array::push(errors, Array::get(ve, i))
        i = i + 1
      }
      i = 0
      while i < Array::length(ce) {
        Array::push(errors, Array::get(ce, i))
        i = i + 1
      }
      errors
    },
    EDot(obj, _) => check_effects_expr(obj, env, in_effect),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)
        let mut j = 0
        while j < Array::length(ee) {
          Array::push(errors, Array::get(ee, j))
          j = j + 1
        }
        ei = ei + 1
      }
      errors
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)
        let mut j = 0
        while j < Array::length(ee) {
          Array::push(errors, Array::get(ee, j))
          j = j + 1
        }
        ei = ei + 1
      }
      errors
    },
    ERecord(fields) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        let fe = check_effects_expr(fval, env, in_effect)
        let mut j = 0
        while j < Array::length(fe) {
          Array::push(errors, Array::get(fe, j))
          j = j + 1
        }
        fi = fi + 1
      }
      errors
    },
    _ => errors
  }
}

export let check_effects_stmt = (stmt: Stmt, env: TypeEnv) -> Array[EffectError] {
  match stmt {
    SLet(_, _, _, _, body) => check_effects_expr(body, env, false),
    SLetMut(_, _, body) => check_effects_expr(body, env, false),
    STest(_, body) => check_effects_expr(body, env, false),
    SBench(_, body) => check_effects_expr(body, env, false),
    SExpr(e) => check_effects_expr(e, env, false),
    _ => Array::slice([
      EEThrowOutsideEffect("")
    ], 0, 0)
  }
}

export let check_effects_stmts = (stmts: Array[Stmt], env: TypeEnv) -> Array[EffectError] {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let se = check_effects_stmt(Array::get(stmts, i), env)
    let mut j = 0
    while j < Array::length(se) {
      Array::push(errors, Array::get(se, j))
      j = j + 1
    }
    i = i + 1
  }
  errors
}

export let effect_error_to_string = (err: EffectError) -> String {
  match err {
    EEThrowOutsideEffect(msg) => String::concat("throw outside effectful context: ", msg),
    EEEffectfulCallOutsideEffect(name) => String::concat("effectful call outside effectful context: ", name)
  }
}
