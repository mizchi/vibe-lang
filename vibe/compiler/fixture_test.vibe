//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  Pat, Expr, TypeExpr, Stmt, parse_program
}

import ./printer.vibe {
  print_program
}

//# Functions

let pp = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } {
    Error(msg) => string_concat("ERROR: ", msg)
  }
}

let parse_ok = (src: String) -> Bool {
  let output = pp(src)
  if string_length(output) > 6 && string_equals(string_substring(output, 0, 6), "ERROR:") {
    false
  } else true
}

let roundtrip_ok = (src: String) -> Bool {
  let output1 = pp(src)
  if string_length(output1) > 6 && string_equals(string_substring(output1, 0, 6), "ERROR:") {
    false
  } else {
    let output2 = pp(output1)
    string_equals(output1, output2)
  }
}

//# Misc

test "fixture_01_parse" {
  let src = "let dead = () -> Int { 0 }\nuse ./dep.vibe { dep }\ntrait Eq\nimpl Eq for Int\ntype Alias = Int\nlet helper = () -> Int { 1 }\nexport let run = () -> Int { helper() }\nexport let run_io = () -> Int with {Error} { run() }\nexport { run, run_io }"
  assert(parse_ok(src))
}

test "fixture_01_roundtrip" {
  let src = "let dead = () -> Int { 0 }\nuse ./dep.vibe { dep }\ntrait Eq\nimpl Eq for Int\ntype Alias = Int\nlet helper = () -> Int { 1 }\nexport let run = () -> Int { helper() }\nexport let run_io = () -> Int with {Error} { run() }\nexport { run, run_io }"
  assert(roundtrip_ok(src))
}

test "fixture_02_parse" {
  let src = "let helper = () -> Int { 1 + 2 }\nlet value = helper()\nexport let run = () -> Int { value }\nexport { run }"
  assert(parse_ok(src))
}

test "fixture_02_roundtrip" {
  let src = "let helper = () -> Int { 1 + 2 }\nlet value = helper()\nexport let run = () -> Int { value }\nexport { run }"
  assert(roundtrip_ok(src))
}

test "fixture_03_parse" {
  let src = "export module math {\nlet dead = () -> Int { 0 }\nlet helper = () -> Int { 1 }\ntype Alias = Int\nexport let run = () -> Int { helper() }\nexport let run_io = () -> Int with {Error} { run() }\n}"
  assert(parse_ok(src))
}

test "fixture_03_roundtrip" {
  let src = "export module math {\nlet dead = () -> Int { 0 }\nlet helper = () -> Int { 1 }\ntype Alias = Int\nexport let run = () -> Int { helper() }\nexport let run_io = () -> Int with {Error} { run() }\n}"
  assert(roundtrip_ok(src))
}

test "fixture_04_parse" {
  let src = "let answer = 40 + 2\nlet id = (x: Int) -> Int { x }\nexport let run = () -> Int { answer }\nexport let keep = () -> Int { id(1) }\nexport { run, keep }"
  assert(parse_ok(src))
}

test "fixture_04_roundtrip" {
  let src = "let answer = 40 + 2\nlet id = (x: Int) -> Int { x }\nexport let run = () -> Int { answer }\nexport let keep = () -> Int { id(1) }\nexport { run, keep }"
  assert(roundtrip_ok(src))
}

test "fixture_05_parse" {
  let src = "export struct Pair {\nleft: Int,\nright: Int\n}\nexport enum Choice {\nA,\nB(Int)\n}\nexport { Pair, Choice }"
  assert(parse_ok(src))
}

test "fixture_05_roundtrip" {
  let src = "export struct Pair {\nleft: Int,\nright: Int\n}\nexport enum Choice {\nA,\nB(Int)\n}\nexport { Pair, Choice }"
  assert(roundtrip_ok(src))
}

test "fixture_06_parse" {
  let src = "let sum = (x~: Int, y~: Int) -> Int { x + y }\nexport let run = () -> Int { sum(x~=1, y?=2) }\nexport { run }"
  assert(parse_ok(src))
}

test "fixture_06_roundtrip" {
  let src = "let sum = (x~: Int, y~: Int) -> Int { x + y }\nexport let run = () -> Int { sum(x~=1, y?=2) }\nexport { run }"
  assert(roundtrip_ok(src))
}

test "fixture_selfhost_token_parse" {
  let src = "export enum Token {\nTInt(Int);\nTFloat(Double);\nTString(String);\nTIdent(String);\nTLet;\nTBreak;\nTThrow;\nTRaise;\nTEof\n}\nexport let token_to_string = (t: Token) -> String {\nmatch t {\nTInt(n) => \"TInt\",\nTFloat(n) => \"TFloat\",\nTString(s) => \"TString\",\nTIdent(s) => \"TIdent\",\nTLet => \"TLet\",\nTBreak => \"TBreak\",\nTThrow => \"TThrow\",\nTRaise => \"TRaise\",\nTEof => \"TEof\"\n}\n}"
  assert(parse_ok(src))
}

test "fixture_selfhost_token_roundtrip" {
  let src = "export enum Token {\nTInt(Int);\nTFloat(Double);\nTString(String);\nTIdent(String);\nTLet;\nTBreak;\nTThrow;\nTRaise;\nTEof\n}\nexport let token_to_string = (t: Token) -> String {\nmatch t {\nTInt(n) => \"TInt\",\nTFloat(n) => \"TFloat\",\nTString(s) => \"TString\",\nTIdent(s) => \"TIdent\",\nTLet => \"TLet\",\nTBreak => \"TBreak\",\nTThrow => \"TThrow\",\nTRaise => \"TRaise\",\nTEof => \"TEof\"\n}\n}"
  assert(roundtrip_ok(src))
}

test "fixture_selfhost_import_export_parse" {
  let src = "export ./ast.vibe { Expr, Pat, Stmt, TypeExpr }\nimport ./ast.vibe { Expr, Pat, Stmt, TypeExpr }\nimport ./token.vibe { Token }\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\nif pos < 0 { TEof } else TEof\n}"
  assert(parse_ok(src))
}

test "fixture_selfhost_import_export_roundtrip" {
  let src = "export ./ast.vibe { Expr, Pat, Stmt, TypeExpr }\nimport ./ast.vibe { Expr, Pat, Stmt, TypeExpr }\nimport ./token.vibe { Token }\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\nif pos < 0 { TEof } else TEof\n}"
  assert(roundtrip_ok(src))
}

test "fixture_selfhost_throw_handle_parse" {
  let src = "let lex_string = (s: String, len: Int, i: Int) -> (Token, Int) with {Error} {\nlet rec scan = (idx: Int) -> (String, Int) with {Error} {\nif idx >= len { throw(\"unterminated string\") } else (\"ok\", idx)\n}\nlet (value, end) = scan(i + 1)\n(TString(value), end)\n}"
  assert(parse_ok(src))
}

test "fixture_selfhost_throw_handle_roundtrip" {
  let src = "let lex_string = (s: String, len: Int, i: Int) -> (Token, Int) with {Error} {\nlet rec scan = (idx: Int) -> (String, Int) with {Error} {\nif idx >= len { throw(\"unterminated string\") } else (\"ok\", idx)\n}\nlet (value, end) = scan(i + 1)\n(TString(value), end)\n}"
  assert(roundtrip_ok(src))
}

test "fixture_selfhost_while_mut_parse" {
  let src = "export let lex = (source: String) -> Array[Token] with {Error} {\nlet len = 10\nlet b = array_builder()\nlet mut pos = 0\nwhile pos < len {\nlet tok = TInt(1)\narray_builder_push(b, tok)\npos = pos + 1\n}\narray_builder_push(b, TEof)\narray_builder_freeze(b)\n}"
  assert(parse_ok(src))
}

test "fixture_selfhost_while_mut_roundtrip" {
  let src = "export let lex = (source: String) -> Array[Token] with {Error} {\nlet len = 10\nlet b = array_builder()\nlet mut pos = 0\nwhile pos < len {\nlet tok = TInt(1)\narray_builder_push(b, tok)\npos = pos + 1\n}\narray_builder_push(b, TEof)\narray_builder_freeze(b)\n}"
  assert(roundtrip_ok(src))
}

test "fixture_selfhost_nested_let_rec_parse" {
  let src = "export let rec parse_impl = (tokens: Array[Int], pos: Int, mode: Int) -> (Int, Int) with {Error} {\nlet rec parse_rest = (tokens: Array[Int], pos: Int, b: Array[Int]) -> (Array[Int], Int) with {Error} {\nif pos > 0 { (b, pos) } else parse_rest(tokens, pos + 1, b)\n}\nlet parse_primary = (tokens: Array[Int], pos: Int) -> (Int, Int) with {Error} {\nparse_impl(tokens, pos, mode + 1)\n}\nif mode >= 10 {\nparse_primary(tokens, pos)\n} else {\nlet (left, n1) = parse_impl(tokens, pos, mode + 1)\n(left, n1)\n}\n}"
  assert(parse_ok(src))
}

test "fixture_selfhost_nested_let_rec_roundtrip" {
  let src = "export let rec parse_impl = (tokens: Array[Int], pos: Int, mode: Int) -> (Int, Int) with {Error} {\nlet rec parse_rest = (tokens: Array[Int], pos: Int, b: Array[Int]) -> (Array[Int], Int) with {Error} {\nif pos > 0 { (b, pos) } else parse_rest(tokens, pos + 1, b)\n}\nlet parse_primary = (tokens: Array[Int], pos: Int) -> (Int, Int) with {Error} {\nparse_impl(tokens, pos, mode + 1)\n}\nif mode >= 10 {\nparse_primary(tokens, pos)\n} else {\nlet (left, n1) = parse_impl(tokens, pos, mode + 1)\n(left, n1)\n}\n}"
  assert(roundtrip_ok(src))
}
