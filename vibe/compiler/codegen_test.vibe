// === For-in loop ===

test "wasi: for-in sum" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30]\n  let mut sum = 0\n  for x in arr {\n    sum = sum + x\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_forin_sum.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_forin_sum.wasm")
}

test "wasi: for-in with array_push" {
  let source = "let main = () -> Int {\n  let src = [1, 2, 3]\n  let dst = array_new()\n  for x in src {\n    array_push(dst, x * 10)\n  }\n  array_get(dst, 2)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_forin_push.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_forin_push.wasm")
}

// === Break / Continue ===

test "wasi: break from while" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut result = 0\n  while i < 100 {\n    if i == 5 { break }\n    result = result + i\n    i = i + 1\n  }\n  result\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_break.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_break.wasm")
}

test "wasi: continue in while" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut sum = 0\n  while i < 10 {\n    i = i + 1\n    if i % 2 == 0 { continue }\n    sum = sum + i\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_continue.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_continue.wasm")
}

test "wasi: break in nested if" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut r = 0\n  while i < 100 {\n    if i > 3 {\n      if i > 5 { break }\n      r = r + i\n    }\n    i = i + 1\n  }\n  r\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_break_nested.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_break_nested.wasm")
}

test "wasi: for-in with break" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30, 40, 50]\n  let mut sum = 0\n  for x in arr {\n    if x > 30 { break }\n    sum = sum + x\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_forin_break.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_forin_break.wasm")
}

// === Edge cases ===

test "wasi: empty array" {
  let source = "let main = () -> Int {\n  let arr = []\n  array_length(arr)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_empty_arr.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_empty_arr.wasm")
}

test "wasi: nested while loops" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 0\n  while i < 3 {\n    let mut j = 0\n    while j < 3 {\n      sum = sum + 1\n      j = j + 1\n    }\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_nested_while.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_nested_while.wasm")
}

test "wasi: nested function calls" {
  let source = "let add = (a: Int, b: Int) -> Int { a + b }\nlet mul = (a: Int, b: Int) -> Int { a * b }\nlet main = () -> Int { add(mul(3, 4), mul(5, 6)) }"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_nested_call.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_nested_call.wasm")
}

test "wasi: match with function call in arm" {
  let source = "let double = (x: Int) -> Int { x * 2 }\nlet f = (x: Int) -> Int {\n  match x {\n    0 => 0,\n    _ => double(x)\n  }\n}\nlet main = () -> Int { f(21) }"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_match_call.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_match_call.wasm")
}

test "wasi: fibonacci iterative" {
  let source = "let main = () -> Int {\n  let mut a = 0\n  let mut b = 1\n  let mut i = 0\n  while i < 10 {\n    let t = b\n    b = a + b\n    a = t\n    i = i + 1\n  }\n  a\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_fib_iter.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_fib_iter.wasm")
}

test "wasi: complex expression" {
  let source = "let main = () -> Int {\n  let x = (3 + 4) * 2\n  let y = x / 7 + x % 7\n  y\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_complex_expr.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_complex_expr.wasm")
}

test "wasi: string equality in if" {
  let source = "let main = () -> Int {\n  let s = \"hello\"\n  if string_equals(s, \"hello\") { 1 } else { 0 }\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_str_eq_if.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_str_eq_if.wasm")
}

// === Closure / Lambda ===

test "wasi: closure no capture" {
  let source = "let main = () -> Int {\n  let f = (x: Int) -> Int { x + 1 }\n  f(5)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_closure_nocap.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_closure_nocap.wasm")
}

test "wasi: closure simple capture" {
  let source = "let main = () -> Int {\n  let n = 10\n  let f = (x: Int) -> Int { x + n }\n  f(5)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_closure_cap.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_closure_cap.wasm")
}

test "wasi: function as value" {
  let source = "let double = (x: Int) -> Int { x * 2 }\nlet main = () -> Int {\n  let f = double\n  f(21)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_fn_value.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_fn_value.wasm")
}

test "wasi: higher-order function" {
  let source = "let apply = (f: (Int) -> Int, x: Int) -> Int { f(x) }\nlet inc = (x: Int) -> Int { x + 1 }\nlet main = () -> Int { apply(inc, 41) }"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_higher_order.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_higher_order.wasm")
}

test "wasi: closure multiple captures" {
  let source = "let main = () -> Int {\n  let a = 10\n  let b = 20\n  let f = (x: Int) -> Int { x + a + b }\n  f(5)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_closure_multicap.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_closure_multicap.wasm")
}

test "wasi: nested closure" {
  let source = "let main = () -> Int {\n  let a = 10\n  let make_adder = (n: Int) -> (Int) -> Int {\n    (x: Int) -> Int { x + n }\n  }\n  let add10 = make_adder(a)\n  add10(32)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_closure_nested.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_closure_nested.wasm")
}

// === Float / Double ===

test "wasi: double_to_int basic" {
  let source = "let main = () -> Int {\n  double_to_int(3.7)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_d2i.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_d2i.wasm")
}

test "wasi: int_to_double round-trip" {
  let source = "let main = () -> Int {\n  double_to_int(int_to_double(42))\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_i2d_rt.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_i2d_rt.wasm")
}

test "wasi: double_to_int negative" {
  let source = "let main = () -> Int {\n  double_to_int(-2.9)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_d2i_neg.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_d2i_neg.wasm")
}

test "wasi: float arithmetic via int_to_double" {
  let source = "let main = () -> Int {\n  let a = int_to_double(10)\n  let b = int_to_double(3)\n  double_to_int(a)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_float_arith.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_float_arith.wasm")
}
