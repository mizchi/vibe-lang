test "wasi: closure let-in-else-if with recursive call" {
  // Closer to lex_string: multiple lets in else-if, then recursive call using those locals
  let source = "let f = (s: String, len: Int) -> Int {\n  let rec scan = (idx: Int, acc: Int) -> Int {\n    if idx >= len { acc }\n    else {\n      let c = String::char_code_at(s, idx)\n      if c == 97 {\n        let chunk = 10\n        chunk + acc\n      } else if c == 98 {\n        let chunk = 20\n        let next = idx + 1\n        scan(next, acc + chunk)\n      } else scan(idx + 1, acc)\n    }\n  }\n  scan(0, 0)\n}\nlet main = () -> Int {\n  f(\"b\", 1)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: closure let-escaped-if-throw then recursive" {
  // Even closer to lex_string: let escaped = if ... else throw; then scan(... chunk ...)
  let source = "let f = (s: String, len: Int) -> Int {\n  let rec scan = (idx: Int, acc: Int) -> Int with { Error } {\n    if idx >= len { acc }\n    else {\n      let c = String::char_code_at(s, idx)\n      if c == 97 {\n        let chunk = 10\n        chunk + acc\n      } else if c == 98 {\n        let chunk = 20\n        let next = idx + 1\n        let esc = String::char_code_at(s, next)\n        let escaped = if esc == 110 { 30 } else throw(\"invalid\")\n        scan(next, acc + chunk + escaped)\n      } else scan(idx + 1, acc)\n    }\n  }\n  scan(0, 0)\n}\nlet main = () -> Int {\n  f(\"bn\", 2)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: closure with String::concat in recursive call" {
  // Exact pattern: scan(next+1, next+1, String::concat(String::concat(acc, chunk), escaped))
  let source = "let f = (s: String, len: Int) -> String with { Error } {\n  let rec scan = (idx: Int, start: Int, acc: String) -> String with { Error } {\n    if idx >= len { acc }\n    else {\n      let c = String::char_code_at(s, idx)\n      if c == 97 {\n        let chunk = String::substring(s, start, idx)\n        String::concat(acc, chunk)\n      } else if c == 98 {\n        let chunk = String::substring(s, start, idx)\n        let next = idx + 1\n        let esc = String::char_code_at(s, next)\n        let escaped = if esc == 110 { \"N\" } else throw(\"invalid\")\n        scan(next + 1, next + 1, String::concat(String::concat(acc, chunk), escaped))\n      } else scan(idx + 1, start, acc)\n    }\n  }\n  scan(0, 0, \"\")\n}\nlet main = () -> Int {\n  String::length(f(\"bna\", 3))\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "debug: free vars of closure with tuple" {
  let source = "let f = (x: Int) -> (Int, Int) {\n  let rec go = (i: Int) -> (Int, Int) {\n    if i == 0 {\n      let a = 10;\n      (a, 20)\n    } else {\n      let a = 30\n      go(a)\n    }\n  }\n  go(x)\n}"
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  // stmts[0] = SLet("f", EFn(..., body_of_f))
  // body_of_f = ELetRec("go", EFn(..., body_of_go), ...)
  // We need to extract body_of_go's fn_body
  let stmt0 = Array::get(stmts, 0)
  match stmt0 {
    SLet(_, _, _, _, fn_expr) => match fn_expr {
      EFn(_, _, _, _, _, f_body) => match f_body {
        ELetRec(_, go_fn, _) => match go_fn {
          EFn(_, _, params, _, _, go_body) => {
            let param_names = Array::slice([
              ""
            ], 0, 0)
            let mut pi = 0
            while pi < Array::length(params) {
              let (pname, _) = Array::get(params, pi)
              Array::push(param_names, pname)
              pi = pi + 1
            }
            let fn_names = Array::slice([
              ""
            ], 0, 0)
            let fv = collect_free_vars(go_body, param_names, fn_names)
            // fv should be ["x", "go"] or similar - should NOT contain "a"
            let mut result = "free_vars=["
            let mut fi = 0
            while fi < Array::length(fv) {
              if fi > 0 {
                result = String::concat(result, ",")
              }
              result = String::concat(result, Array::get(fv, fi))
              fi = fi + 1
            }
            result = String::concat(result, "]")
            // Verify "a" is NOT in free vars (it's defined inside the body)
            let mut has_a = false
            let mut ai = 0
            while ai < Array::length(fv) {
              if String::equals(Array::get(fv, ai), "a") {
                has_a = true
              }
              ai = ai + 1
            }
            if has_a {
              throw(String::concat("BUG: 'a' in free vars! ", result))
            }
          },
          _ => throw("expected EFn for go")
        },
        _ => throw("expected ELetRec")
      },
      _ => throw("expected EFn for f")
    },
    _ => throw("expected SLet")
  }
}

