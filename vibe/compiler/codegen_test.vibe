  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: lex_string pattern (simplified)" {
  // Simplified version of lexer.vibe lex_string pattern
  let source = "let lex_str = (s: String, len: Int, start: Int) -> (String, Int) with { Error } {\n  let rec scan = (idx: Int, start: Int, acc: String) -> (String, Int) with { Error } {\n    if idx >= len {\n      throw(\"unterminated\")\n    }\n    let c = String::char_code_at(s, idx)\n    if c == 34 {\n      let chunk = String::substring(s, start, idx);\n      (String::concat(acc, chunk), idx + 1)\n    } else if c == 92 {\n      let chunk = String::substring(s, start, idx)\n      let next = idx + 1\n      if next >= len {\n        throw(\"unterminated escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      let escaped = if esc == 110 { String::from_char_code(10) } else throw(\"invalid escape\")\n      scan(next + 1, next + 1, String::concat(String::concat(acc, chunk), escaped))\n    } else scan(idx + 1, start, acc)\n  }\n  scan(start + 1, start + 1, \"\")\n}\nlet main = () -> Int {\n  let (result, _) = lex_str(\"\\\"hi\\\"\", 4, 0);\n  String::length(result)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

