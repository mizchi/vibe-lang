//# Imports

import ./codegen.vibe {
  compile_module, compile_wasi_module
}

import ./codegen_common.vibe {
  collect_free_vars
}

import ./codegen_gc.vibe {
  compile_wasi_module_gc
}

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

//# Functions

let assert_wasm = (bytes: Bytes) -> Int {
  assert(Bytes::length(bytes) > 8)
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
  0
}

let compile_wasi = (source: String, entry: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  compile_wasi_module(stmts, entry)
}

let compile_source = (source: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  compile_module(stmts)
}

let compile_wasi_gc = (source: String, entry: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  compile_wasi_module_gc(stmts, entry)
}

let compile_wasi_with_imports = (import_sources: Array[String], source: String, entry: String) -> Bytes with { Error } {
  let all_stmts = ArrayBuilder::new()
  let mut ii = 0
  while ii < Array::length(import_sources) {
    let itokens = lex(Array::get(import_sources, ii))
    let istmts = parse_program(itokens)
    let mut si = 0
    while si < Array::length(istmts) {
      let s = Array::get(istmts, si)
      match s {
        SEnum(_, _, _) => {
          ArrayBuilder::push(all_stmts, s)
          0
        },
        _ => 0
      }
      si = si + 1
    }
    ii = ii + 1
  }
  let main_tokens = lex(source)
  let main_stmts = parse_program(main_tokens)
  let mut mi = 0
  while mi < Array::length(main_stmts) {
    ArrayBuilder::push(all_stmts, Array::get(main_stmts, mi))
    mi = mi + 1
  }
  compile_wasi_module(ArrayBuilder::freeze(all_stmts), entry)
}

let compile_wasi_with_full_imports = (import_sources: Array[String], source: String, entry: String) -> Bytes with { Error } {
  let all_stmts = ArrayBuilder::new()
  let mut ii = 0
  while ii < Array::length(import_sources) {
    let itokens = lex(Array::get(import_sources, ii))
    let istmts = parse_program(itokens)
    let mut si = 0
    while si < Array::length(istmts) {
      let s = Array::get(istmts, si)
      match s {
        SImport(_, _) => 0,
        _ => {
          ArrayBuilder::push(all_stmts, s)
          0
        }
      }
      si = si + 1
    }
    ii = ii + 1
  }
  let main_tokens = lex(source)
  let main_stmts = parse_program(main_tokens)
  let mut mi = 0
  while mi < Array::length(main_stmts) {
    ArrayBuilder::push(all_stmts, Array::get(main_stmts, mi))
    mi = mi + 1
  }
  compile_wasi_module(ArrayBuilder::freeze(all_stmts), entry)
}

//# Misc

test "codegen: add function" {
  let source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: sub function" {
  let source = "export let sub = (a: Int, b: Int) -> Int { a - b }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: mul function" {
  let source = "export let mul = (a: Int, b: Int) -> Int { a * b }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: if-else" {
  let source = "export let max = (a: Int, b: Int) -> Int { if a > b { a } else { b } }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: local let" {
  let source = "export let f = (x: Int) -> Int { let y = x + 1\ny * 2 }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: multi-function with internal call" {
  let source = "let square = (x: Int) -> Int { x * x }\nexport let sum_sq = (a: Int, b: Int) -> Int { square(a) + square(b) }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: recursive fibonacci" {
  let source = "export let rec fib = (n: Int) -> Int {\n  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }\n}"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: recursive factorial" {
  let source = "export let rec fact = (n: Int) -> Int {\n  if n <= 1 { 1 } else { n * fact(n - 1) }\n}"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: while loop (factorial)" {
  let source = "export let fact = (n: Int) -> Int {\n  let mut result = 1\n  let mut i = n\n  while i > 1 {\n    result = result * i\n    i = i - 1\n  }\n  result\n}"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "wasi: simple constant" {
  let source = "let main = () -> Int { 42 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: arithmetic" {
  let source = "let main = () -> Int { 3 + 4 * 5 }"
  let bytes = compile_wasi(source, "main")
