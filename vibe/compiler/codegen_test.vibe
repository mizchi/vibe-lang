test "wasi: for-in sum" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30]\n  let mut sum = 0\n  for x in arr {\n    sum = sum + x\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: for-in with Array::push" {
  let source = "let main = () -> Int {\n  let src = [1, 2, 3]\n  let dst = array_new()\n  for x in src {\n    Array::push(dst, x * 10)\n  }\n  Array::get(dst, 2)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: break from while" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut result = 0\n  while i < 100 {\n    if i == 5 { break }\n    result = result + i\n    i = i + 1\n  }\n  result\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: continue in while" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut sum = 0\n  while i < 10 {\n    i = i + 1\n    if i % 2 == 0 { continue }\n    sum = sum + i\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: break in nested if" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut r = 0\n  while i < 100 {\n    if i > 3 {\n      if i > 5 { break }\n      r = r + i\n    }\n    i = i + 1\n  }\n  r\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: for-in with break" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30, 40, 50]\n  let mut sum = 0\n  for x in arr {\n    if x > 30 { break }\n    sum = sum + x\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: empty array" {
  let source = "let main = () -> Int {\n  let arr = []\n  Array::length(arr)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: nested while loops" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 0\n  while i < 3 {\n    let mut j = 0\n    while j < 3 {\n      sum = sum + 1\n      j = j + 1\n    }\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: nested function calls" {
  let source = "let add = (a: Int, b: Int) -> Int { a + b }\nlet mul = (a: Int, b: Int) -> Int { a * b }\nlet main = () -> Int { add(mul(3, 4), mul(5, 6)) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: match with function call in arm" {
  let source = "let double = (x: Int) -> Int { x * 2 }\nlet f = (x: Int) -> Int {\n  match x {\n    0 => 0,\n    _ => double(x)\n  }\n}\nlet main = () -> Int { f(21) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: fibonacci iterative" {
  let source = "let main = () -> Int {\n  let mut a = 0\n  let mut b = 1\n  let mut i = 0\n  while i < 10 {\n    let t = b\n    b = a + b\n    a = t\n    i = i + 1\n  }\n  a\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: complex expression" {
  let source = "let main = () -> Int {\n  let x = (3 + 4) * 2\n  let y = x / 7 + x % 7\n  y\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

