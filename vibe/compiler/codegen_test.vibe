import ./codegen_test_support.vibe {
  compile_source,
  assert_wasm,
  compile_wasi,
  compile_wasi_gc
}


test "codegen: add function" {
  let source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: sub function" {
  let source = "export let sub = (a: Int, b: Int) -> Int { a - b }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: mul function" {
  let source = "export let mul = (a: Int, b: Int) -> Int { a * b }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: if-else" {
  let source = "export let max = (a: Int, b: Int) -> Int { if a > b { a } else { b } }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: local let" {
  let source = "export let f = (x: Int) -> Int { let y = x + 1\ny * 2 }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: multi-function with internal call" {
  let source = "let square = (x: Int) -> Int { x * x }\nexport let sum_sq = (a: Int, b: Int) -> Int { square(a) + square(b) }"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: recursive fibonacci" {
  let source = "export let rec fib = (n: Int) -> Int {\n  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }\n}"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: recursive factorial" {
  let source = "export let rec fact = (n: Int) -> Int {\n  if n <= 1 { 1 } else { n * fact(n - 1) }\n}"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

test "codegen: while loop (factorial)" {
  let source = "export let fact = (n: Int) -> Int {\n  let mut result = 1\n  let mut i = n\n  while i > 1 {\n    result = result * i\n    i = i - 1\n  }\n  result\n}"
  let bytes = compile_source(source)
  assert_wasm(bytes)
}

// === WASI module tests ===

test "wasi: simple constant" {
  let source = "let main = () -> Int { 42 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: arithmetic" {
  let source = "let main = () -> Int { 3 + 4 * 5 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: fibonacci" {
  let source = "let rec fib = (n: Int) -> Int {\n  if n <= 1 { n } else { fib(n - 1) + fib(n - 2) }\n}\nlet main = () -> Int { fib(10) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: negative number" {
  let source = "let main = () -> Int { -123 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: zero" {
  let source = "let main = () -> Int { 0 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: factorial" {
  let source = "let rec fact = (n: Int) -> Int {\n  if n <= 1 { 1 } else { n * fact(n - 1) }\n}\nlet main = () -> Int { fact(12) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === print_int / print_str builtin tests ===

test "wasi: print_int builtin" {
  let source = "let main = () -> Int {\n  print_int(42)\n  print_int(-7)\n  0\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: print_str builtin" {
  let source = "let main = () -> Int {\n  print_str(\"hello world\")\n  0\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: print_str and print_int mixed" {
  let source = "let main = () -> Int {\n  print_str(\"result: \")\n  print_int(123)\n  0\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === String builtins ===

test "wasi: String::length" {
  let source = "let main = () -> Int { String::length(\"hello\") }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: String::equals true" {
  let source = "let main = () -> Int { if String::equals(\"abc\", \"abc\") { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: String::equals false" {
  let source = "let main = () -> Int { if String::equals(\"abc\", \"def\") { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: String::concat" {
  let source = "let main = () -> Int {\n  print_str(String::concat(\"hello \", \"world\"))\n  0\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === Array builtins ===

test "wasi: array basic" {
  let source = "let main = () -> Int {\n  let arr = array_new()\n  Array::push(arr, 10)\n  Array::push(arr, 20)\n  Array::push(arr, 30)\n  Array::get(arr, 1)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Array::length" {
  let source = "let main = () -> Int {\n  let arr = array_new()\n  Array::push(arr, 1)\n  Array::push(arr, 2)\n  Array::push(arr, 3)\n  Array::length(arr)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Array::set" {
  let source = "let main = () -> Int {\n  let arr = array_new()\n  Array::push(arr, 10)\n  Array::push(arr, 20)\n  Array::set(arr, 0, 99)\n  Array::get(arr, 0)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === Tuple ===

test "wasi: tuple destructure" {
  let source = "let f = () -> (Int, Int) { (3, 4) }\nlet main = () -> Int {\n  match f() {\n    (a, b) => a + b\n  }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === Closure / Lambda ===

test "wasi: closure no capture" {
  let source = "let main = () -> Int {\n  let f = (x: Int) -> Int { x + 1 }\n  f(5)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: closure simple capture" {
  let source = "let main = () -> Int {\n  let n = 10\n  let f = (x: Int) -> Int { x + n }\n  f(5)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: function as value" {
  let source = "let double = (x: Int) -> Int { x * 2 }\nlet main = () -> Int {\n  let f = double\n  f(21)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: higher-order function" {
  let source = "let apply = (f: (Int) -> Int, x: Int) -> Int { f(x) }\nlet inc = (x: Int) -> Int { x + 1 }\nlet main = () -> Int { apply(inc, 41) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: closure multiple captures" {
  let source = "let main = () -> Int {\n  let a = 10\n  let b = 20\n  let f = (x: Int) -> Int { x + a + b }\n  f(5)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: nested closure" {
  let source = "let main = () -> Int {\n  let a = 10\n  let make_adder = (n: Int) -> (Int) -> Int {\n    (x: Int) -> Int { x + n }\n  }\n  let add10 = make_adder(a)\n  add10(32)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === Mutable Capture ===

test "wasi: closure mutable capture" {
  // let mut n = 0; let inc = () -> Int { n = n + 1; n }; inc(); inc() → 2
  let source = "let main = () -> Int {\n  let mut n = 0\n  let inc = () -> Int { n = n + 1\n  n }\n  inc()\n  inc()\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: closure mutable capture shared" {
  // Two closures share the same mutable variable
  let source = "let main = () -> Int {\n  let mut n = 0\n  let inc = () -> Int { n = n + 1\n  n }\n  let get = () -> Int { n }\n  inc()\n  inc()\n  inc()\n  get()\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === Float / Double ===

test "wasi: Double::to_int basic" {
  let source = "let main = () -> Int {\n  Double::to_int(3.7)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Int::to_double round-trip" {
  let source = "let main = () -> Int {\n  Double::to_int(Int::to_double(42))\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: Double::to_int negative" {
  let source = "let main = () -> Int {\n  Double::to_int(-2.9)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: float arithmetic via Int::to_double" {
  let source = "let main = () -> Int {\n  let a = Int::to_double(10)\n  let b = Int::to_double(3)\n  Double::to_int(a)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === String builtins ===

test "wasi: String::char_code_at" {
  let source = "let main = () -> Int {\n  let s = \"hello\"\n  String::char_code_at(s, 1)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: String::from_char_code" {
  let source = "let main = () -> Int {\n  let s = String::from_char_code(65)\n  String::char_code_at(s, 0)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: String::substring" {
  let source = "let main = () -> Int {\n  let s = \"hello world\"\n  let sub = String::substring(s, 6, 11)\n  String::length(sub)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: String::substring content" {
  let source = "let main = () -> Int {\n  let s = \"abcdef\"\n  let sub = String::substring(s, 2, 5)\n  String::char_code_at(sub, 0)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

// === GC Backend ===

test "gc: basic add" {
  let source = "let main = () -> Int { 3 + 4 }"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: let bindings" {
  let source = "let main = () -> Int {\n  let a = 10\n  let b = a + 5\n  b * 2\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: if else" {
  let source = "let main = () -> Int {\n  let x = 5\n  if x > 3 { 10 } else { 20 }\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: while loop" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 1\n  while i <= 10 {\n    sum = sum + i\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: function call" {
  let source = "let add = (a: Int, b: Int) -> Int { a + b }\nlet main = () -> Int { add(3, 4) }"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: match expression" {
  let source = "let f = (x: Int) -> Int {\n  match x {\n    0 => 10,\n    1 => 20,\n    _ => 30\n  }\n}\nlet main = () -> Int { f(1) }"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: string length" {
  let source = "let main = () -> Int {\n  let s = \"hello\"\n  String::length(s)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: let mut and assign" {
  let source = "let main = () -> Int {\n  let mut x = 10\n  x = x + 5\n  x\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: fibonacci iterative" {
  let source = "let main = () -> Int {\n  let mut a = 0\n  let mut b = 1\n  let mut i = 0\n  while i < 10 {\n    let t = b\n    b = a + b\n    a = t\n    i = i + 1\n  }\n  a\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

// === GC Backend: Closures ===

test "gc: closure no capture" {
  let source = "let main = () -> Int {\n  let f = (x: Int) -> Int { x + 1 }\n  f(5)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: closure simple capture" {
  let source = "let main = () -> Int {\n  let n = 10\n  let f = (x: Int) -> Int { x + n }\n  f(5)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: function as value" {
  let source = "let double = (x: Int) -> Int { x * 2 }\nlet main = () -> Int {\n  let f = double\n  f(21)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: higher-order function" {
  let source = "let apply = (f: (Int) -> Int, x: Int) -> Int { f(x) }\nlet inc = (x: Int) -> Int { x + 1 }\nlet main = () -> Int { apply(inc, 41) }"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: nested closure" {
  let source = "let main = () -> Int {\n  let a = 10\n  let make_adder = (n: Int) -> (Int) -> Int {\n    (x: Int) -> Int { x + n }\n  }\n  let add10 = make_adder(a)\n  add10(32)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: mutable capture" {
  let source = "let main = () -> Int {\n  let mut n = 0\n  let inc = () -> Int { n = n + 1\n  n }\n  inc()\n  inc()\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: mutable capture shared" {
  let source = "let main = () -> Int {\n  let mut n = 0\n  let inc = () -> Int { n = n + 1\n  n }\n  let get = () -> Int { n }\n  inc()\n  inc()\n  inc()\n  get()\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: String::char_code_at" {
  let source = "let main = () -> Int {\n  String::char_code_at(\"hello\", 1)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: String::substring" {
  let source = "let main = () -> Int {\n  let sub = String::substring(\"abcdef\", 2, 5)\n  String::char_code_at(sub, 0)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "wasi: ArrayBuilder::new" {
  let source = "let main = () -> Int {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, 10)\n  ArrayBuilder::push(b, 20)\n  ArrayBuilder::push(b, 30)\n  let arr = ArrayBuilder::freeze(b)\n  Array::get(arr, 1)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: ArrayBuilder::new length" {
  let source = "let main = () -> Int {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, 1)\n  ArrayBuilder::push(b, 2)\n  ArrayBuilder::push(b, 3)\n  let arr = ArrayBuilder::freeze(b)\n  Array::length(arr)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "gc: ArrayBuilder::new" {
  let source = "let main = () -> Int {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, 10)\n  ArrayBuilder::push(b, 20)\n  ArrayBuilder::push(b, 30)\n  let arr = ArrayBuilder::freeze(b)\n  Array::get(arr, 1)\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "wasi: enum constructor 0-arg" {
  let source = "enum Color { Red; Green; Blue }\nlet main = () -> Int {\n  let c = Green\n  match c {\n    Red => 1,\n    Green => 2,\n    Blue => 3\n  }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: enum constructor with args" {
  let source = "enum MyOpt { None; Some(Int) }\nlet main = () -> Int {\n  let x = Some(42)\n  match x {\n    Some(n) => n,\n    None => 0\n  }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: enum Option pattern" {
  let source = "enum MyOpt { None; Some(Int) }\nlet main = () -> Int {\n  let x = None\n  match x {\n    Some(n) => n,\n    None => 99\n  }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "gc: enum constructor 0-arg" {
  let source = "enum Color { Red; Green; Blue }\nlet main = () -> Int {\n  let c = Green\n  match c {\n    Red => 1,\n    Green => 2,\n    Blue => 3\n  }\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "gc: enum constructor with args" {
  let source = "enum MyOpt { None; Some(Int) }\nlet main = () -> Int {\n  let x = Some(42)\n  match x {\n    Some(n) => n,\n    None => 0\n  }\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}

test "wasi: cross-enum ctor tag uniqueness" {
  let source = "enum Color { Red; Green; Blue }\nenum Shape { Circle; Square; Triangle }\nlet main = () -> Int {\n  let c = Red\n  let s = Circle\n  let cv = match c {\n    Red => 10,\n    Green => 20,\n    Blue => 30\n  }\n  let sv = match s {\n    Circle => 1,\n    Square => 2,\n    Triangle => 3\n  }\n  cv + sv\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "gc: cross-enum ctor tag uniqueness" {
  let source = "enum Color { Red; Green; Blue }\nenum Shape { Circle; Square; Triangle }\nlet main = () -> Int {\n  let c = Red\n  let s = Circle\n  let cv = match c {\n    Red => 10,\n    Green => 20,\n    Blue => 30\n  }\n  let sv = match s {\n    Circle => 1,\n    Square => 2,\n    Triangle => 3\n  }\n  cv + sv\n}"
  let bytes = compile_wasi_gc(source, "main")
  assert_wasm(bytes)
}
