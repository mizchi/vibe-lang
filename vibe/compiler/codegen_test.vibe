test "wasi: lexer.vibe import - compile only" {
  let token_source = Fs::read_file("vibe/compiler/token.vibe")
  let lexer_source = Fs::read_file("vibe/compiler/lexer.vibe")
  let main_source = "let main = () -> Int {\n  let tokens = lex(\"42\")\n  Array::length(tokens)\n}"
  let all_stmts = ArrayBuilder::new()
  let tk_tokens = lex(token_source)
  let tk_stmts = parse_program(tk_tokens)
  let mut ti = 0
  while ti < Array::length(tk_stmts) {
    match Array::get(tk_stmts, ti) {
      SEnum(_, _, _) => {
        ArrayBuilder::push(all_stmts, Array::get(tk_stmts, ti)); 0
      },
      _ => 0
    }
    ti = ti + 1
  }
  let lx_tokens = lex(lexer_source)
  let lx_stmts = parse_program(lx_tokens)
  let mut li = 0
  while li < Array::length(lx_stmts) {
    match Array::get(lx_stmts, li) {
      SImport(_, _) => 0,
      SLet(_, _, name, _, _) => if String::equals(name, "lex_ok") {
        0
      }
      else {
        ArrayBuilder::push(all_stmts, Array::get(lx_stmts, li)); 0
      }
      ,
      _ => {
        ArrayBuilder::push(all_stmts, Array::get(lx_stmts, li)); 0
      }
    }
    li = li + 1
  }
  let mn_tokens = lex(main_source)
  let mn_stmts = parse_program(mn_tokens)
  let mut mi = 0
  while mi < Array::length(mn_stmts) {
    ArrayBuilder::push(all_stmts, Array::get(mn_stmts, mi))
    mi = mi + 1
  }
  let bytes = compile_wasi_module(ArrayBuilder::freeze(all_stmts), "main")
  assert_wasm(bytes)
}

test "wasi: struct create and field access" {
  let bytes = compile_wasi("struct Point { x: Int; y: Int }\nexport let main = () -> Int { let p = Point::{ x: 10, y: 20 }; p.x + p.y }", "main")
  assert_wasm(bytes)
}

test "wasi: struct field order independence" {
  let bytes = compile_wasi("struct Point { x: Int; y: Int }\nexport let main = () -> Int { let p = Point::{ y: 99, x: 1 }; p.x }", "main")
  assert_wasm(bytes)
}

test "gc: struct create and field access" {
  let bytes = compile_wasi_gc("struct Point { x: Int; y: Int }\nexport let main = () -> Int { let p = Point::{ x: 5, y: 15 }; p.x + p.y }", "main")
  assert_wasm(bytes)
}
