test "wasi: factorial" {
  let source = "let rec fact = (n: Int) -> Int {\n  if n <= 1 { 1 } else { n * fact(n - 1) }\n}\nlet main = () -> Int { fact(12) }"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_wasi_fact.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_wasi_fact.wasm")
}

// === print_int / print_str builtin tests ===

test "wasi: print_int builtin" {
  let source = "let main = () -> Int {\n  print_int(42)\n  print_int(-7)\n  0\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_print_int.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_print_int.wasm")
}

