test "wasi: array sum loop" {
  let source = "let main = () -> Int {\n  let arr = array_new()\n  Array::push(arr, 10)\n  Array::push(arr, 20)\n  Array::push(arr, 30)\n  let mut sum = 0\n  let mut i = 0\n  while i < Array::length(arr) {\n    sum = sum + Array::get(arr, i)\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

