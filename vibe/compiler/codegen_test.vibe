// === Multiple match arms with fallthrough ===

test "wasi: match many arms" {
  let source = "let f = (x: Int) -> Int {\n  match x {\n    0 => 10,\n    1 => 20,\n    2 => 30,\n    3 => 40,\n    _ => 50\n  }\n}\nlet main = () -> Int { f(3) }"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_matchmany.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_matchmany.wasm")
}

// === Nested let + complex expressions ===

test "wasi: nested let bindings" {
  let source = "let main = () -> Int {\n  let a = 10\n  let b = a + 5\n  let c = b * 2\n  c + a\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_nested_let.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_nested_let.wasm")
}

test "wasi: while with mutation" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 1\n  while i <= 10 {\n    sum = sum + i\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_while_sum.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_while_sum.wasm")
}

// === String + array combined ===

test "wasi: string in array workflow" {
  let source = "let main = () -> Int {\n  let s = string_concat(\"hello \", \"world\")\n  string_length(s)\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_str_chain.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_str_chain.wasm")
}

test "wasi: array sum loop" {
  let source = "let main = () -> Int {\n  let arr = array_new()\n  array_push(arr, 10)\n  array_push(arr, 20)\n  array_push(arr, 30)\n  let mut sum = 0\n  let mut i = 0\n  while i < array_length(arr) {\n    sum = sum + array_get(arr, i)\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  fs_write_bytes("/tmp/test_cg_arr_sum.wasm", bytes)
  sh("wasmtime run /tmp/test_cg_arr_sum.wasm")
}

