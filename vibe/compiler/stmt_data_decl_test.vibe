//# Imports

import ./stmt_test_support.vibe {
  ps
}

//# Misc

test "stmt_enum_simple" {
  assert(ps("enum Color { Red; Green; Blue }") == "enum Color { Red; Green; Blue }")
}

test "stmt_enum_with_args" {
  assert(ps("enum Option { Some(Int); None }") == "enum Option { Some(Int); None }")
}

test "stmt_enum_exported" {
  assert(ps("export enum Color { Red; Green }") == "export enum Color { Red; Green }")
}

test "stmt_struct" {
  assert(ps("struct Point { x: Int; y: Int }") == "struct Point { x: Int; y: Int }")
}

test "stmt_struct_exported" {
  assert(ps("export struct Point { x: Int }") == "export struct Point { x: Int }")
}
