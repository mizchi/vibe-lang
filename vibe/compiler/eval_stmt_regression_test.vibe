//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval_stmt.vibe {
  eval_stmts
}

import ./values.vibe {
  ValEnv, Value, empty_module_ctx, val_env_lookup, value_to_string, values_equal
}

//# Functions

let _a1 = (e: Expr) -> Expr {
  e
}

let _a2 = (p: Pat) -> Pat {
  p
}

let _a3 = (t: TypeExpr) -> TypeExpr {
  t
}

let _a4 = (s: Stmt) -> Stmt {
  s
}

let no_tp = Array::slice([
  ""
], 0, 0)

let no_tb = Array::slice([
  ("", no_tp)
], 0, 0)

let eval_program = (stmts: Array[Stmt]) -> ValEnv {
  handle {
    eval_stmts(stmts, 0, VEnvEmpty, empty_module_ctx())
  } {
    Error(_) => VEnvEmpty
  }
}

let eval_and_lookup = (stmts: Array[Stmt], name: String) -> String {
  let env = eval_program(stmts)
  match val_env_lookup(env, name) {
    Some(v) => value_to_string(v),
    None => "<not found>"
  }
}

//# Misc

test "eval let rec factorial" {
  let fn_body = EIf(EBinOp("<=", EIdent("n"), EInt(1)), EInt(1), EBinOp("*", EIdent("n"), ECall(EIdent("fact"), [
    EBinOp("-", EIdent("n"), EInt(1))
  ])))
  let fn_expr = EFn(no_tp, no_tb, [
    ("n", None)
  ], None, None, fn_body)
  let stmts = [
    SLet(false, true, "fact", None, fn_expr),
    SLet(false, false, "result", None, ECall(EIdent("fact"), [
      EInt(5)
    ]))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "result") {
    Some(v) => assert_true(values_equal(v, VInt(120))),
    None => assert_true(false)
  }
}

test "eval enum match E2E" {
  let variants = [
    ("Some", [
      TyName("Int")
    ]),
    ("None", Array::slice([
      TyUnit
    ], 0, 0))
  ]
  let match_expr = EMatch(EIdent("val"), [
    (PCtor("Some", [
      PBind("x")
    ]), EIdent("x")),
    (PCtor("None", Array::slice([
      PWild
    ], 0, 0)), EInt(0))
  ])
  let stmts = [
    SEnum(false, "MyOpt", variants),
    SLet(false, false, "val", None, ECall(EIdent("Some"), [
      EInt(99)
    ])),
    SLet(false, false, "result", None, match_expr)
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "result") {
    Some(v) => assert_true(values_equal(v, VInt(99))),
    None => assert_true(false)
  }
}

test "eval_and_lookup" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  assert_eq(eval_and_lookup(stmts, "x"), "42")
}

test "eval_and_lookup not found" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  assert_eq(eval_and_lookup(stmts, "y"), "<not found>")
}
