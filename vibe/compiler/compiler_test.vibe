//# Imports

import ./compiler.vibe {
  compile_source, compile_source_wasi
}

//# Helpers

let assert_wasm_magic = (bytes: Bytes) -> Unit {
  // WASM magic number: \0asm
  assert(bytes_get(bytes, 0) == 0)
  assert(bytes_get(bytes, 1) == 97)   // 'a'
  assert(bytes_get(bytes, 2) == 115)  // 's'
  assert(bytes_get(bytes, 3) == 109)  // 'm'
}

//# Tests

test "compile_source: simple int expression produces valid WASM" {
  let bytes = compile_source("let x = 42")
  assert_wasm_magic(bytes)
}

test "compile_source: function definition produces valid WASM" {
  let bytes = compile_source("let add = (a: Int, b: Int) -> Int { a + b }")
  assert_wasm_magic(bytes)
}

test "compile_source: if expression produces valid WASM" {
  let bytes = compile_source("let f = (x: Int) -> Int { if x > 0 { x } else { 0 - x } }")
  assert_wasm_magic(bytes)
}

test "compile_source_wasi: produces valid WASM with entry" {
  let bytes = compile_source_wasi("let main = () -> Int { 0 }", "main")
  assert_wasm_magic(bytes)
}

test "compile_source: enum definition produces valid WASM" {
  let bytes = compile_source("enum Color { Red; Green; Blue }\nlet c = Red")
  assert_wasm_magic(bytes)
}

test "compile_source: while loop produces valid WASM" {
  let bytes = compile_source("let f = () -> Int { let mut i = 0\nwhile i < 10 { i = i + 1 }\ni }")
  assert_wasm_magic(bytes)
}

test "compile_source: nested tuple destructuring across recursive calls" {
  let source = "let rec f = (expr: Int, env: Int, defs: Int, s: Int, c: Int) -> (Int, Int, Int) {\n  let cond = expr\n  let then_e = env\n  let else_e = defs\n  let (_, s1, c1) = f(cond, env, defs, s, c)\n  let (tt, s2, c2) = f(then_e, env, defs, s1, c1)\n  let (_, s3, c3) = f(else_e, env, defs, s2, c2)\n  (tt, s3, c3)\n}"
  let bytes = compile_source(source)
  assert_wasm_magic(bytes)
}
