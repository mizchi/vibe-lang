//# Imports

import ./compiler.vibe {
  compile_source, compile_source_wasi, prepare_modules_cached, compile_with_modules_cached,
  compile_file_fs_module_cached
}

import ./type_db.vibe {
  db_new, db_typecheck_count, db_parse_count, db_merge_count
}

//# Helpers

let assert_wasm_magic = (bytes: Bytes) -> Unit {
  // WASM magic number: \0asm
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)   // 'a'
  assert(Bytes::get(bytes, 2) == 115)  // 's'
  assert(Bytes::get(bytes, 3) == 109)  // 'm'
}

let string_to_bytes = (s: String) -> Bytes {
  let out = Array::slice([0], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

//# Tests

test "compile_source: simple int expression produces valid WASM" {
  let bytes = compile_source("let x = 42")
  assert_wasm_magic(bytes)
}

test "compile_source: function definition produces valid WASM" {
  let bytes = compile_source("let add = (a: Int, b: Int) -> Int { a + b }")
  assert_wasm_magic(bytes)
}

test "compile_source: if expression produces valid WASM" {
  let bytes = compile_source("let f = (x: Int) -> Int { if x > 0 { x } else { 0 - x } }")
  assert_wasm_magic(bytes)
}

test "compile_source_wasi: produces valid WASM with entry" {
  let bytes = compile_source_wasi("let main = () -> Int { 0 }", "main")
  assert_wasm_magic(bytes)
}

test "compile_source: enum definition produces valid WASM" {
  let bytes = compile_source("enum Color { Red; Green; Blue }\nlet c = Red")
  assert_wasm_magic(bytes)
}

test "compile_source: while loop produces valid WASM" {
  let bytes = compile_source("let f = () -> Int { let mut i = 0\nwhile i < 10 { i = i + 1 }\ni }")
  assert_wasm_magic(bytes)
}

test "compile_source: nested tuple destructuring across recursive calls" {
  let source = "let rec f = (expr: Int, env: Int, defs: Int, s: Int, c: Int) -> (Int, Int, Int) {\n  let cond = expr\n  let then_e = env\n  let else_e = defs\n  let (_, s1, c1) = f(cond, env, defs, s, c)\n  let (tt, s2, c2) = f(then_e, env, defs, s1, c1)\n  let (_, s3, c3) = f(else_e, env, defs, s2, c2)\n  (tt, s3, c3)\n}"
  let bytes = compile_source(source)
  assert_wasm_magic(bytes)
}

test "prepare_modules_cached: warm prepare reuses typecheck cache" {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let db1 = prepare_modules_cached(db_new(), "main.vibe", main_source, sources)
  let count1 = db_typecheck_count(db1)
  let db2 = prepare_modules_cached(db1, "main.vibe", main_source, sources)
  assert(eq(db_typecheck_count(db2), count1))
}

test "compile_with_modules_cached: warm compile reuses parsed modules" {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let (bytes1, db1) = compile_with_modules_cached(
    db_new(),
    main_source,
    "main.vibe",
    sources
  )
  assert_wasm_magic(bytes1)
  let parse_count1 = db_parse_count(db1)
  let (_, db2) = compile_with_modules_cached(db1, main_source, "main.vibe", sources)
  assert(eq(db_parse_count(db2), parse_count1))
}

test "compile_file_fs_module_cached: warm compile reuses merged module cache" {
  let helper_path = "/tmp/vibe_compiler_cache_helper.vibe"
  let main_path = "/tmp/vibe_compiler_cache_main.vibe"
  Fs::write_bytes(
    helper_path,
    string_to_bytes("export let add = (a: Int, b: Int) -> Int { a + b }")
  )
  Fs::write_bytes(
    main_path,
    string_to_bytes(
      "import ./vibe_compiler_cache_helper.vibe { add }\nlet run = () -> Int { add(1, 2) }"
    )
  )
  let (bytes1, db1) = compile_file_fs_module_cached(db_new(), main_path)
  assert_wasm_magic(bytes1)
  let merge_count1 = db_merge_count(db1)
  let (_, db2) = compile_file_fs_module_cached(db1, main_path)
  assert(eq(db_merge_count(db2), merge_count1))
}
