//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_resolve.vibe {
  resolve_type_expr
}

import ./types.vibe {
  Type, TypeDef, types_equal
}

//# Functions

let empty_defs: () -> Array[TypeDef] = () -> {
  Array::slice([
    TDAlias("_dummy", Array::slice([""], 0, 0), CtUnit)
  ], 0, 0)
}

//# Misc

test "resolve TyUnit" {
  let ty = resolve_type_expr(TyUnit, empty_defs())
  assert(types_equal(ty, CtUnit))
}

test "resolve TyName Int" {
  let ty = resolve_type_expr(TyName("Int"), empty_defs())
  assert(types_equal(ty, CtInt))
}

test "resolve TyName String" {
  let ty = resolve_type_expr(TyName("String"), empty_defs())
  assert(types_equal(ty, CtString))
}

test "resolve TyApp Array[Int]" {
  let ty = resolve_type_expr(TyApp("Array", [
    TyName("Int")
  ]), empty_defs())
  assert(types_equal(ty, CtArray(CtInt)))
}

test "resolve TyApp Option[String]" {
  let ty = resolve_type_expr(TyApp("Option", [
    TyName("String")
  ]), empty_defs())
  assert(types_equal(ty, CtOption(CtString)))
}

test "resolve TyTuple" {
  let ty = resolve_type_expr(TyTuple([
    TyName("Int"),
    TyName("Bool")
  ]), empty_defs())
  assert(types_equal(ty, CtTuple([
    CtInt,
    CtBool
  ])))
}

test "resolve TyFn" {
  let ty = resolve_type_expr(TyFn([
    TyName("Int")
  ], TyName("String"), None), empty_defs())
  assert(types_equal(ty, CtFn([
    CtInt
  ], CtString, None)))
}

test "resolve enum typedef" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let defs = [
    TDEnum("Color", Array::slice([""], 0, 0), [
      ("Red", no_args),
      ("Blue", no_args)
    ])
  ]
  let ty = resolve_type_expr(TyName("Color"), defs)
  assert(types_equal(ty, CtEnum("Color")))
}
