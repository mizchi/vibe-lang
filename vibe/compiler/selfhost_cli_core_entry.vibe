//# Imports

import ./entry / source_compile / wasi_only {
  compile_source_wasi_only
}

import ./core/ast.vibe {
  Expr, Stmt
}

import ./syntax/lexer.vibe {
  lex
}

import ./syntax/parser.vibe {
  parse_program
}

import ./codegen/wasi/index.vibe {
  compile_wasi_module_linked_impl
}

//# Functions

let empty_stmt_array = () -> Array[Stmt] {
  Array::slice([SExpr(EInt(0))], 0, 0)
}

let empty_source_pairs = () -> Array[(String, String)] {
  Array::slice([("", "")], 0, 0)
}

let empty_linked_imports = () -> Array[(String, String, Int, Int)] {
  Array::slice([("", "", 0, 0)], 0, 0)
}

let read_arg = (index: Int) -> String {
  if perform Env::ArgsLen > index {
    perform Env::ArgsGet(index)
  } else {
    ""
  }
}

let linked_output_dir = (output_path: String) -> String {
  let len = String::length(output_path)
  if len >= 5 && output_path[len - 5:len] == ".wasm" {
    String::concat(output_path[0:len - 5], ".debug")
  } else {
    String::concat(output_path, ".debug")
  }
}

let dir_of_path = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 { "" }
  else { file_path[0:idx] }
}

let normalize_path = (path: String) -> String {
  let parts = Array::slice([""], 0, 0)
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    if i == len || String::char_code_at(path, i) == 47 {
      let part = path[start:i]
      if String::length(part) == 0 || part == "." {
        ()
      } else if part == ".." {
        if Array::length(parts) > 0 {
          parts = Array::slice(parts, 0, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  let mut out = ""
  i = 0
  while i < Array::length(parts) {
    if i > 0 {
      out = String::concat(out, "/")
    }
    out = String::concat(out, Array::get(parts, i))
    i = i + 1
  }
  out
}

let resolve_import_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  let joined = if len >= 2 && raw_path[0:2] == "./" {
    if base_dir == "" { raw_path }
    else { String::concat(base_dir, String::concat("/", raw_path)) }
  } else if len >= 3 && raw_path[0:3] == "../" {
    if base_dir == "" { raw_path }
    else { String::concat(base_dir, String::concat("/", raw_path)) }
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") { normalized }
  else { String::concat(normalized, ".vibe") }
}

let contains_path = (visited: Array[String], path: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(visited) && !found {
    if Array::get(visited, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let array_contains_name = (arr: Array[String], name: String) -> Bool {
  let mut found = false
  let mut i = 0
  while i < Array::length(arr) && !found {
    if Array::get(arr, i) == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let get_export_name = (items: Array[(String, Option[String])], name: String) -> String {
  let mut result = name
  let mut i = 0
  while i < Array::length(items) {
    let (iname, irename) = Array::get(items, i)
    if iname == name {
      match irename {
        Some(alias) => { result = alias }
        None => ()
      }
    }
    i = i + 1
  }
  result
}

let path_to_module_name = (path: String) -> String {
  let len = String::length(path)
  let mut last_slash = -1
  let mut i = 0
  while i < len {
    if String::char_code_at(path, i) == 47 {
      last_slash = i
    }
    i = i + 1
  }
  let base = if last_slash >= 0 {
    path[last_slash + 1:len]
  } else {
    path
  }
  let base_len = String::length(base)
  if String::ends_with(base, ".vibe") {
    base[0:base_len - 5]
  } else {
    base
  }
}

let rec resolve_reexport_chain = (
  source_path: String,
  items: Array[(String, Option[String])],
  module_name: String,
  linked_imports: Array[(String, String, Int, Int)],
  type_stmts: Array[Stmt],
  depth: Int
) -> Unit with { Error, Fs } {
  if depth > 10 { () }
  else {
    let source = perform Fs::ReadFile(source_path)
    let stmts = parse_program(lex(source))
    let source_dir = dir_of_path(source_path)
    let wanted_names = Array::slice([""], 0, 0)
    let mut wi = 0
    while wi < Array::length(items) {
      let (name, _) = Array::get(items, wi)
      Array::push(wanted_names, name)
      wi = wi + 1
    }
    let mut si = 0
    while si < Array::length(stmts) {
      match Array::get(stmts, si) {
        SLet(true, _, name, _, EFn(_, _, params, _, _, _)) => {
          if array_contains_name(wanted_names, name) {
            let export_name = get_export_name(items, name)
            Array::push(
              linked_imports,
              (module_name, export_name, Array::length(params), 1)
            )
          }
        },
        SEnum(true, name, _) => {
          if array_contains_name(wanted_names, name) {
            Array::push(type_stmts, Array::get(stmts, si))
          }
        },
        SReExport(raw_path, inner_items) => {
          let filtered = Array::slice([("", None)], 0, 0)
          let mut fi = 0
          while fi < Array::length(inner_items) {
            let (iname, irename) = Array::get(inner_items, fi)
            if array_contains_name(wanted_names, iname) {
              Array::push(filtered, (iname, irename))
            }
            fi = fi + 1
          }
          if Array::length(filtered) > 0 {
            let resolved = resolve_import_path(source_dir, raw_path)
            resolve_reexport_chain(
              resolved,
              filtered,
              module_name,
              linked_imports,
              type_stmts,
              depth + 1
            )
          }
        },
        _ => ()
      }
      si = si + 1
    }
  }
}

let rec collect_library_stmts_recursive = (
  path: String,
  merged: Array[Stmt],
  visited: Array[String]
) -> Unit with { Error, Fs } {
  if contains_path(visited, path) { () }
  else {
    Array::push(visited, path)
    let source = perform Fs::ReadFile(path)
    let stmts = parse_program(lex(source))
    let base_dir = dir_of_path(path)
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SImport(raw_path, _) => {
          let resolved = resolve_import_path(base_dir, raw_path)
          collect_library_stmts_recursive(resolved, merged, visited)
        },
        SReExport(raw_path, _) => {
          let resolved = resolve_import_path(base_dir, raw_path)
          collect_library_stmts_recursive(resolved, merged, visited)
        },
        _ => ()
      }
      i = i + 1
    }
    let mut j = 0
    while j < Array::length(stmts) {
      match Array::get(stmts, j) {
        SImport(_, _) => (),
        SReExport(_, _) => (),
        SAliasDecl(_, _) => (),
        _ => Array::push(merged, Array::get(stmts, j))
      }
      j = j + 1
    }
  }
}

let append_non_import_stmts = (dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    match Array::get(src, i) {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(dst, Array::get(src, i))
    }
    i = i + 1
  }
}

let append_library_entry = (stmts: Array[Stmt]) -> Unit {
  let empty_tp = Array::slice([""], 0, 0)
  let empty_bounds = Array::slice([("", Array::slice([""], 0, 0))], 0, 0)
  let empty_params = Array::slice([("", None)], 0, 0)
  Array::push(
    stmts,
    SLet(
      false,
      false,
      "__library_entry",
      None,
      EFn(empty_tp, empty_bounds, empty_params, None, None, EInt(0))
    )
  )
}

let compile_release_file = (input_path: String, entry_name: String) -> Bytes with { Error, Fs } {
  let source = perform Fs::ReadFile(input_path)
  compile_source_wasi_only(source, entry_name)
}

let build_linked_debug_entry = (
  input_path: String,
  entry_name: String
) -> (Bytes, Array[(String, String)]) with { Error, Fs } {
  let entry_source = perform Fs::ReadFile(input_path)
  let entry_stmts = parse_program(lex(entry_source))
  let entry_dir = dir_of_path(input_path)
  let dep_paths = Array::slice([""], 0, 0)
  let mut ei = 0
  while ei < Array::length(entry_stmts) {
    match Array::get(entry_stmts, ei) {
      SImport(raw_path, items) => {
        if Array::length(items) > 0 {
          let resolved = resolve_import_path(entry_dir, raw_path)
          if !contains_path(dep_paths, resolved) {
            Array::push(dep_paths, resolved)
          }
        }
      },
      SReExport(raw_path, _) => {
        let resolved = resolve_import_path(entry_dir, raw_path)
        if !contains_path(dep_paths, resolved) {
          Array::push(dep_paths, resolved)
        }
      },
      _ => ()
    }
    ei = ei + 1
  }
  let linked_imports = empty_linked_imports()
  let linked_dep_specs = empty_source_pairs()
  let resolved_type_stmts = empty_stmt_array()
  let mut di = 0
  while di < Array::length(dep_paths) {
    let dep_path = Array::get(dep_paths, di)
    let dep_source = perform Fs::ReadFile(dep_path)
    let dep_stmts = parse_program(lex(dep_source))
    let module_name = path_to_module_name(dep_path)
    let dep_dir = dir_of_path(dep_path)
    let mut has_linked = false
    let mut dsi = 0
    while dsi < Array::length(dep_stmts) {
      match Array::get(dep_stmts, dsi) {
        SLet(true, _, name, _, EFn(_, _, params, _, _, _)) => {
          Array::push(
            linked_imports,
            (module_name, name, Array::length(params), 1)
          )
          has_linked = true
        },
        SReExport(raw_path, items) => {
          let resolved = resolve_import_path(dep_dir, raw_path)
          resolve_reexport_chain(
            resolved,
            items,
            module_name,
            linked_imports,
            resolved_type_stmts,
            0
          )
          has_linked = true
        },
        SEnum(true, _, _) => {
          Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))
        },
        _ => ()
      }
      dsi = dsi + 1
    }
    if has_linked {
      Array::push(linked_dep_specs, (module_name, dep_path))
    }
    di = di + 1
  }
  let main_stmts = empty_stmt_array()
  let mut ti = 0
  while ti < Array::length(resolved_type_stmts) {
    Array::push(main_stmts, Array::get(resolved_type_stmts, ti))
    ti = ti + 1
  }
  append_non_import_stmts(main_stmts, entry_stmts)
  let bytes = compile_wasi_module_linked_impl(
    main_stmts,
    entry_name,
    empty_source_pairs(),
    linked_imports,
    false
  )
  (bytes, linked_dep_specs)
}

let compile_debug_library = (dep_path: String) -> Bytes with { Error, Fs } {
  let merged = empty_stmt_array()
  let visited = Array::slice([""], 0, 0)
  collect_library_stmts_recursive(dep_path, merged, visited)
  append_library_entry(merged)
  compile_wasi_module_linked_impl(
    merged,
    "__library_entry",
    empty_source_pairs(),
    empty_linked_imports(),
    true
  )
}

let write_linked_debug_build = (
  input_path: String,
  output_path: String,
  entry_name: String
) -> Unit with { Error, Fs } {
  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(
    input_path,
    entry_name
  )
  Fs::write_bytes(output_path, entry_bytes)
  let output_dir = linked_output_dir(output_path)
  let mut i = 0
  while i < Array::length(linked_dep_specs) {
    let (module_name, dep_path) = Array::get(linked_dep_specs, i)
    let lib_output_path = String::concat(
      output_dir,
      String::concat("/", String::concat(module_name, ".wasm"))
    )
    let lib_bytes = compile_debug_library(dep_path)
    Fs::write_bytes(lib_output_path, lib_bytes)
    i = i + 1
  }
}

let cli_main = () -> Int with { Error, Fs, Env } {
  let input_path = read_arg(0)
  let output_path = read_arg(1)
  let entry_name = read_arg(2)
  let mode = read_arg(3)
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else if mode == "" || mode == "release" || mode == "no-dce" || mode == "mvp" {
    let bytes = compile_release_file(input_path, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
  else if mode == "debug" {
    write_linked_debug_build(input_path, output_path, entry_name)
    0
  }
  else {
    1
  }
}

export let probe_arg0_len = () -> Int {
  String::length(read_arg(0))
}

export let probe_arg1_len = () -> Int {
  String::length(read_arg(1))
}

export let probe_arg2_len = () -> Int {
  String::length(read_arg(2))
}

export let probe_arg3_len = () -> Int {
  String::length(read_arg(3))
}

export let probe_args_len = () -> Int {
  perform Env::ArgsLen
}

export let probe_source_len = () -> Int with { Error, Fs, Env } {
  let source = perform Fs::ReadFile(read_arg(0))
  String::length(source)
}

export let probe_compile_len = () -> Int with { Error, Fs, Env } {
  let source = perform Fs::ReadFile(read_arg(0))
  let bytes = compile_source_wasi_only(source, read_arg(2))
  Bytes::length(bytes)
}

export let probe_compile_file_len = () -> Int with { Error, Fs, Env } {
  let bytes = compile_release_file(read_arg(0), read_arg(2))
  Bytes::length(bytes)
}

export let probe_compile_linked_file_len = () -> Int with { Error, Fs, Env } {
  let (bytes, _) = build_linked_debug_entry(read_arg(0), read_arg(2))
  Bytes::length(bytes)
}

export let probe_compile_library_len = () -> Int with { Error, Fs, Env } {
  let bytes = compile_debug_library(read_arg(0))
  Bytes::length(bytes)
}

cli_main()
