//# Imports

import ./entry / source_compile / wasi_only {
  compile_source_wasi_only
}

//# Functions

let read_arg = (index: Int) -> String with { Env } {
  if Env::args_len() > index {
    Env::args_get(index)
  } else {
    ""
  }
}

let cli_main = () -> Int with { Error, Fs, Env } {
  let input_path = read_arg(0)
  let output_path = read_arg(1)
  let entry_name = read_arg(2)
  if String::equals(input_path, "") {
    1
  }
  else if String::equals(output_path, "") {
    1
  }
  else if String::equals(entry_name, "") {
    1
  }
  else {
    let source = Fs::read_file(input_path)
    let bytes = compile_source_wasi_only(source, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
}

export let probe_arg0_len = () -> Int with { Env } {
  String::length(read_arg(0))
}

export let probe_arg1_len = () -> Int with { Env } {
  String::length(read_arg(1))
}

export let probe_arg2_len = () -> Int with { Env } {
  String::length(read_arg(2))
}

export let probe_args_len = () -> Int with { Env } {
  Env::args_len()
}

export let probe_source_len = () -> Int with { Error, Fs, Env } {
  let source = Fs::read_file(read_arg(0))
  String::length(source)
}

export let probe_compile_len = () -> Int with { Error, Fs, Env } {
  let source = Fs::read_file(read_arg(0))
  let bytes = compile_source_wasi_only(source, read_arg(2))
  Bytes::length(bytes)
}

cli_main()
