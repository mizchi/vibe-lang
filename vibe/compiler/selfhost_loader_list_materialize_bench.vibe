//# Imports

import ./loader_hotspot_probe.vibe {
  load_selfhost_loader_hotspot_fixture
}

bench "selfhost/loader_manifest_list_filter_linear" {
  let (
    _selfhost_base_dir,
    _selfhost_manifest_rows,
    selfhost_preloaded_sources,
    _selfhost_needed_sources,
    selfhost_needed_paths
  ) = load_selfhost_loader_hotspot_fixture()
  let filtered_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(selfhost_preloaded_sources) {
    let (path, source) = Array::get(selfhost_preloaded_sources, i)
    let mut found = false
    let mut pi = 0
    while pi < Array::length(selfhost_needed_paths) {
      if Array::get(selfhost_needed_paths, pi) == path {
        found = true
        pi = Array::length(selfhost_needed_paths)
      } else {
        pi = pi + 1
      }
    }
    if found {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  let _ = Array::length(filtered_sources)
}

bench "selfhost/loader_manifest_list_filter_indexed" {
  let (
    _selfhost_base_dir,
    _selfhost_manifest_rows,
    selfhost_preloaded_sources,
    _selfhost_needed_sources,
    selfhost_needed_paths
  ) = load_selfhost_loader_hotspot_fixture()
  let builder = MapBuilder::new()
  let mut pi = 0
  while pi < Array::length(selfhost_needed_paths) {
    MapBuilder::set(builder, Array::get(selfhost_needed_paths, pi), true)
    pi = pi + 1
  }
  let needed_path_index = MapBuilder::freeze(builder)
  let filtered_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(selfhost_preloaded_sources) {
    let (path, source) = Array::get(selfhost_preloaded_sources, i)
    if Map::has_key(needed_path_index, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  let _ = Array::length(filtered_sources)
}
