//# Imports

import ./codegen.vibe {
  compile_wasi_module
}

import ./selfhost_s5_test_support.vibe {
  load_selfhost_merged
}

//# Tests

test "S5: deterministic output (two compiles match)" {
  let merged1 = load_selfhost_merged()
  let bytes1 = compile_wasi_module(merged1, "run")
  let merged2 = load_selfhost_merged()
  let bytes2 = compile_wasi_module(merged2, "run")
  assert(Bytes::length(bytes1) == Bytes::length(bytes2))
  let mut i = 0
  while i < 100 {
    assert(Bytes::get(bytes1, i) == Bytes::get(bytes2, i))
    i = i + 1
  }
}
