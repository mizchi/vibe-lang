import ./path.vibe {
  dir_of, resolve_path
}

test "dir_of extracts parent directory" {
  assert(string_equals(dir_of("a/b/c.vibe"), "a/b"))
  assert(string_equals(dir_of("main.vibe"), ""))
}

test "resolve_path resolves local relative paths" {
  assert(string_equals(resolve_path("a/b", "./mod"), "a/b/mod.vibe"))
  assert(string_equals(resolve_path("a/b", "../mod"), "a/mod.vibe"))
}

test "resolve_path keeps non-local namespace" {
  assert(string_equals(resolve_path("a/b", "std/prelude"), "std/prelude"))
}
