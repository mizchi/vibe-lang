//# Imports

import ./ast.vibe {
  Expr, Stmt, TypeExpr
}

import ./codegen.vibe {
  compile_module
}

//# Functions

let empty_type_params: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let empty_type_bounds: () -> Array[(String, Array[String])] = () -> {
  Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
}

let int_param: (String) -> (String, Option[TypeExpr]) = (name) -> {
  (name, Some(TyName("Int")))
}

let build_lambda: (Int) -> Expr = (i) -> {
  let param_name = String::concat("y_", __to_string(i))
  EFn(
    empty_type_params(),
    empty_type_bounds(),
    [
      int_param(param_name)
    ],
    Some(TyName("Int")),
    None,
    EBinOp("+", EIdent("x", -1), EIdent(param_name, -1))
  )
}

let build_lambda_chain_body: (Int) -> Expr = (n) -> {
  let mut i = n
  let mut body = EInt(0)
  while i > 0 {
    body = ELet(String::concat("f_", __to_string(i)), build_lambda(i), body)
    i = i - 1
  }
  ELet("x", EInt(1), body)
}

let build_lambda_chain_module: (Int) -> Array[Stmt] = (n) -> {
  [
    SLet(
      true,
      false,
      "main",
      None,
      EFn(
        empty_type_params(),
        empty_type_bounds(),
        Array::slice([
          ("", None)
        ], 0, 0),
        Some(TyName("Int")),
        None,
        build_lambda_chain_body(n)
      )
    )
  ]
}

let helper_name: (Int) -> String = (i) -> {
  String::concat("helper_", __to_string(i))
}

let build_helper_stmt: (Int) -> Stmt = (i) -> {
  SLet(
    false,
    false,
    helper_name(i),
    None,
    EFn(
      empty_type_params(),
      empty_type_bounds(),
      [
        int_param("z")
      ],
      Some(TyName("Int")),
      None,
      EIdent("z", -1)
    )
  )
}

let build_lambda_chain_module_with_helpers: (Int, Int) -> Array[Stmt] = (helper_count, lambda_count) -> {
  let stmts = Array::slice([
    SExport([
      "_dummy"
    ])
  ], 0, 0)
  let mut hi = 0
  while hi < helper_count {
    Array::push(stmts, build_helper_stmt(hi))
    hi = hi + 1
  }
  let main_stmts = build_lambda_chain_module(lambda_count)
  Array::push(stmts, Array::get(main_stmts, 0))
  stmts
}

//# Misc

let lambda_chain_64 = build_lambda_chain_module(64)
let lambda_chain_helpers_128_64 = build_lambda_chain_module_with_helpers(128, 64)

bench "selfhost/codegen_lambda_chain_64" {
  let bytes = compile_module(lambda_chain_64)
  let _ = Bytes::length(bytes)
}

bench "selfhost/codegen_lambda_chain_helpers_128_64" {
  let bytes = compile_module(lambda_chain_helpers_128_64)
  let _ = Bytes::length(bytes)
}
