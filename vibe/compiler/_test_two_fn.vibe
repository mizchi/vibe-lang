//# Imports

import ./ast.vibe {
  Expr, Pat, TypeExpr
}

//# Functions

let join = (arr: Array[String], sep: String) -> String {
  let len = Array::length(arr)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let s = if i > 0 {
        String::concat(String::concat(acc, sep), Array::get(arr, i))
      } else Array::get(arr, i)
      go(i + 1, s)
    }
  }
  go(0, "")
}

export let rec print_pat = (p: Pat) -> String {
  match p {
    PWild => "_",
    PBind(name) => name,
    PInt(n) => __to_string(n),
    PString(s) => String::concat("\"", String::concat(s, "\"")),
    PBool(b) => if b {
      "true"
    } else "false",
    PCtor(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        print_pat(arg)
      }
      String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))
    },
    PTuple(elems) => {
      let parts = for elem in elems {
        print_pat(elem)
      }
      String::concat("(", String::concat(join(parts, ", "), ")"))
    },
    POr(left, right) => String::concat(print_pat(left), String::concat(" | ", print_pat(right)))
  }
}

let map_to_strings = (exprs: Array[Expr], f: (Expr) -> String) -> Array[String] {
  for expr in exprs {
    f(expr)
  }
}

let rec print_type_expr = (ty: TypeExpr) -> String {
  match ty {
    TyName(name) => name,
    TyUnit => "()",
    TyApp(name, args) => {
      let parts = for arg in args {
        print_type_expr(arg)
      }
      String::concat(name, String::concat("[", String::concat(join(parts, ", "), "]")))
    },
    TyFn(params, ret) => {
      let parts = for param in params {
        print_type_expr(param)
      }
      String::concat("(", String::concat(join(parts, ", "), String::concat(") -> ", print_type_expr(ret))))
    },
    TyTuple(elems) => {
      let parts = for elem in elems {
        print_type_expr(elem)
      }
      String::concat("(", String::concat(join(parts, ", "), ")"))
    }
  }
}

export let rec print_expr = (e: Expr) -> String {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => __to_string(n),
    EString(s) => String::concat("\"", String::concat(s, "\"")),
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name) => name,
    EUnit => "()",
    ETuple(elems) => String::concat("(", String::concat(join(map_to_strings(elems, print_expr), ", "), ")")),
    EArray(elems) => String::concat("[", String::concat(join(map_to_strings(elems, print_expr), ", "), "]")),
    ERecord(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        String::concat(name, String::concat(": ", print_expr(val)))
      }
      String::concat("{ ", String::concat(join(parts, ", "), " }"))
    },
    EIf(cond, then_e, else_e) => String::concat("if ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(then_e), String::concat(" } else { ", String::concat(print_expr(else_e), " }")))))),
    ELet(name, val, body) => String::concat("let ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body)))))),
    ELetRec(name, val, body) => String::concat("let rec ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body)))))),
    ELetMut(name, val, body) => String::concat("let mut ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body)))))),
    EAssign(name, val, body) => String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", print_expr(body))))),
    EAssignOp(name, op, val, body) => String::concat(name, String::concat(" ", String::concat(op, String::concat("= ", String::concat(print_expr(val), String::concat("; ", print_expr(body))))))),
    ESeq(a, b) => String::concat(print_expr(a), String::concat("; ", print_expr(b))),
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_pat(pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("match ", String::concat(print_expr(scrutinee), String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    EHandle(body, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_pat(pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("handle { ", String::concat(print_expr(body), String::concat(" } { ", String::concat(join(parts, ", "), " }"))))
    },
    EWhile(cond, body) => String::concat("while ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(body), " }")))),
    EForIn(name, index_name, iterable, body) => String::concat("for ", String::concat(match index_name { Some(index_name) => String::concat(index_name, String::concat(", ", name)), None => name }, String::concat(" in ", String::concat(print_expr(iterable), String::concat(" { ", String::concat(print_expr(body), " }")))))),
    ECall(callee, args) => String::concat(print_expr(callee), String::concat("(", String::concat(join(map_to_strings(args, print_expr), ", "), ")"))),
    EBinOp(op, left, right) => String::concat("(", String::concat(print_expr(left), String::concat(" ", String::concat(op, String::concat(" ", String::concat(print_expr(right), ")")))))),
    EUnaryOp(op, expr) => String::concat("(", String::concat(op, String::concat(print_expr(expr), ")"))),
    EFn(_, _, params, ret_ty, effect, body) => {
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => String::concat(name, String::concat(": ", print_type_expr(ty))),
          None => name
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => {
          let eff_str = match effect {
            Some(e) => String::concat(" with {", String::concat(e, "}")),
            None => ""
          }
          String::concat(") -> ", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(" { ", String::concat(print_expr(body), " }")))))
        },
        None => String::concat(") -> ", print_expr(body))
      }
      String::concat("(", String::concat(join(parts, ", "), ret_str))
    },
    EDot(expr, field) => String::concat(print_expr(expr), String::concat(".", field)),
    ELabeledArg(name, modifier, val) => String::concat(name, String::concat("=", print_expr(val))),
    EMap(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        String::concat(name, String::concat(": ", print_expr(val)))
      }
      String::concat("Map { ", String::concat(join(parts, ", "), " }"))
    },
    ESpread(e) => String::concat("...", print_expr(e))
  }
}
