import ../json/index.vibe {
  Json, parse, stringify
}

import ../shell/index.vibe {
  join_str, split, trim
}

export struct CoverageCaseInput {
  report_path: String;
  report_json: String
}

export struct CaseStats {
  point_total: Int;
  point_hit: Int;
  line_total: Int;
  line_hit: Int;
  branch_total: Int;
  branch_hit: Int
}

export struct CoverageCase {
  report_path: String;
  entry_path: String;
  execution_ok: Bool;
  execution_error: String;
  stats: CaseStats;
  point_rate: Double;
  line_rate: Double;
  branch_rate: Double
}

export struct SuiteStats {
  point_total: Int;
  point_hit: Int;
  line_total: Int;
  line_hit: Int;
  branch_total: Int;
  branch_hit: Int
}

export struct SuiteReport {
  case_count: Int;
  trap_case_count: Int;
  stats: SuiteStats;
  point_rate: Double;
  line_rate: Double;
  branch_rate: Double;
  cases: Array[CoverageCase]
}

export struct KpiResult {
  ok: Bool;
  point_rate: Double;
  line_rate: Double;
  branch_rate: Double;
  min_point_rate: Option[Double];
  min_line_rate: Option[Double];
  min_branch_rate: Option[Double];
  has_thresholds: Bool;
  failures: Array[String]
}

struct PointEntry {
  key: String;
  kind: String;
  hit: Bool
}

struct PointSummary {
  point_total: Int;
  point_hit: Int;
  line_point_total: Int;
  line_point_hit: Int;
  branch_total: Int;
  branch_hit: Int
}

struct ParsedCoverageCase {
  entry_path: String;
  execution_ok: Bool;
  execution_error: String;
  point_entries: Array[PointEntry];
  point_total: Int;
  point_hit: Int;
  line_total: Int;
  line_hit: Int;
  branch_total: Int;
  branch_hit: Int
}

let empty_point_entries = () -> Array[PointEntry] {
  Array::slice([
    PointEntry::{ key: "", kind: "", hit: false }
  ], 0, 0)
}

let rate_percent = (hit: Int, total: Int) -> Double {
  if total <= 0 {
    0.0
  } else {
    (Int::to_double(hit) * 100.0) / Int::to_double(total)
  }
}

let format_fixed2 = (value: Double) -> String {
  let scaled = Double::to_int(value * 100.0 + 0.5)
  let whole = scaled / 100
  let frac = scaled - whole * 100
  let frac_text = if frac < 10 {
    String::concat("0", __to_string(frac))
  } else {
    __to_string(frac)
  }
  String::concat(String::concat(__to_string(whole), "."), frac_text)
}

let percent_text = (hit: Int, total: Int) -> String {
  format_fixed2(rate_percent(hit, total))
}

let obj_get_opt = (obj: Json, key: String) -> Option[Json] {
  match obj {
    JObj(m) => if Map::has_key(m, key) {
      Some(Map::get(m, key))
    } else None,
    _ => None
  }
}

let obj_get_str_or = (obj: Json, key: String, fallback: String) -> String {
  match obj_get_opt(obj, key) {
    Some(JStr(value)) => value,
    _ => fallback
  }
}

let obj_get_bool_or = (obj: Json, key: String, fallback: Bool) -> Bool {
  match obj_get_opt(obj, key) {
    Some(JBool(value)) => value,
    _ => fallback
  }
}

let obj_get_num_or = (obj: Json, key: String, fallback: Int) -> Int {
  match obj_get_opt(obj, key) {
    Some(JNum(value)) => Double::to_int(value),
    _ => fallback
  }
}

let json_int_text = (value: Json) -> String {
  match value {
    JNum(n) => __to_string(Double::to_int(n)),
    _ => ""
  }
}

let obj_get_int_text = (obj: Json, key: String) -> String {
  match obj_get_opt(obj, key) {
    Some(value) => json_int_text(value),
    None => ""
  }
}

let point_signature = (entry_path: String, point_obj: Json) -> String {
  let kind = obj_get_str_or(point_obj, "kind", "")
  if String::length(kind) == 0 {
    ""
  } else {
    let id_text = obj_get_int_text(point_obj, "id")
    if String::length(id_text) > 0 {
      id_text
    } else {
      let line_text = obj_get_int_text(point_obj, "line")
      let span_start = match obj_get_opt(point_obj, "span") {
        Some(span_obj) => obj_get_int_text(span_obj, "start"),
        None => ""
      }
      let span_end = match obj_get_opt(point_obj, "span") {
        Some(span_obj) => obj_get_int_text(span_obj, "end"),
        None => ""
      }
      let start_line = match obj_get_opt(point_obj, "range") {
        Some(range_obj) => match obj_get_opt(range_obj, "start") {
          Some(start_obj) => obj_get_int_text(start_obj, "line"),
          None => ""
        },
        None => ""
      }
      let start_char = match obj_get_opt(point_obj, "range") {
        Some(range_obj) => match obj_get_opt(range_obj, "start") {
          Some(start_obj) => obj_get_int_text(start_obj, "character"),
          None => ""
        },
        None => ""
      }
      let end_line = match obj_get_opt(point_obj, "range") {
        Some(range_obj) => match obj_get_opt(range_obj, "end") {
          Some(end_obj) => obj_get_int_text(end_obj, "line"),
          None => ""
        },
        None => ""
      }
      let end_char = match obj_get_opt(point_obj, "range") {
        Some(range_obj) => match obj_get_opt(range_obj, "end") {
          Some(end_obj) => obj_get_int_text(end_obj, "character"),
          None => ""
        },
        None => ""
      }
      String::concat(
        String::concat(
          String::concat(
            String::concat(
              String::concat(
                String::concat(
                  String::concat(
                    String::concat(
                      String::concat(
                        String::concat(
                          String::concat(
                            String::concat(
                              String::concat(
                                String::concat(
                                  String::concat(
                                    String::concat(entry_path, ":"),
                                    kind
                                  ),
                                  ":"
                                ),
                                line_text
                              ),
                              ":"
                            ),
                            span_start
                          ),
                          ":"
                        ),
                        span_end
                      ),
                      ":"
                    ),
                    start_line
                  ),
                  ":"
                ),
                start_char
              ),
              ":"
            ),
            end_line
          ),
          ":"
        ),
        end_char
      )
    }
  }
}

let concat_point_entries = (a: Array[PointEntry], b: Array[PointEntry]) -> Array[PointEntry] {
  let out = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(a) {
    ArrayBuilder::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    ArrayBuilder::push(out, Array::get(b, j))
    j = j + 1
  }
  ArrayBuilder::freeze(out)
}

let compact_point_entries = (raw: String, kind: String) -> Array[PointEntry] {
  if String::length(raw) == 0 {
    empty_point_entries()
  } else {
    let out = ArrayBuilder::new()
    let items = split(raw, ",")
    let mut i = 0
    while i < Array::length(items) {
      let item = trim(Array::get(items, i))
      if String::length(item) > 0 {
        let parts = split(item, ":")
        if Array::length(parts) >= 2 {
          let pid = Array::get(parts, 0)
          let hit = String::equals(Array::get(parts, 1), "1")
          if String::length(pid) > 0 {
            ArrayBuilder::push(
              out,
              PointEntry::{ key: pid, kind: kind, hit: hit }
            )
          }
        }
      }
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
}

let collect_point_entries = (raw_obj: Json) -> Array[PointEntry] with { Error } {
  let entry_path = obj_get_str_or(raw_obj, "entry_path", "")
  let line_points = obj_get_str_or(raw_obj, "line_points", "")
  let branch_points = obj_get_str_or(raw_obj, "branch_points", "")
  if String::length(line_points) > 0 || String::length(branch_points) > 0 {
    concat_point_entries(
      compact_point_entries(line_points, "line"),
      compact_point_entries(branch_points, "branch")
    )
  } else {
    match obj_get_opt(raw_obj, "points") {
      Some(JArr(points)) => {
        let out = ArrayBuilder::new()
        let mut i = 0
        while i < Array::length(points) {
          let point_value = Array::get(points, i)
          match point_value {
            JStr(raw) => {
              let parts = split(raw, "|")
              if Array::length(parts) >= 3 {
                let pid = Array::get(parts, 0)
                let kind = Array::get(parts, 1)
                let hit = String::equals(Array::get(parts, 2), "1")
                if String::length(pid) > 0 && String::length(kind) > 0 {
                  ArrayBuilder::push(
                    out,
                    PointEntry::{ key: pid, kind: kind, hit: hit }
                  )
                }
              }
            }
            _ => {
              let key = point_signature(entry_path, point_value)
              if String::length(key) > 0 {
                let kind = obj_get_str_or(point_value, "kind", "unknown")
                let hit = obj_get_bool_or(point_value, "hit", false)
                ArrayBuilder::push(
                  out,
                  PointEntry::{ key: key, kind: kind, hit: hit }
                )
              }
            }
          }
          i = i + 1
        }
        ArrayBuilder::freeze(out)
      }
      _ => empty_point_entries()
    }
  }
}

let summarize_point_entries = (entries: Array[PointEntry]) -> Option[PointSummary] {
  if Array::length(entries) == 0 {
    None
  } else {
    let kind_builder = MapBuilder::new()
    let hit_builder = MapBuilder::new()
    let mut i = 0
    while i < Array::length(entries) {
      let entry = Array::get(entries, i)
      MapBuilder::set(kind_builder, entry.key, entry.kind)
      MapBuilder::set(hit_builder, entry.key, false)
      i = i + 1
    }
    let mut j = 0
    while j < Array::length(entries) {
      let entry = Array::get(entries, j)
      if entry.hit {
        MapBuilder::set(hit_builder, entry.key, true)
      }
      j = j + 1
    }
    let kind_map: Map[String, String] = MapBuilder::freeze(kind_builder)
    let hit_map: Map[String, Bool] = MapBuilder::freeze(hit_builder)
    let keys = Map::keys(kind_map)
    let mut point_total = 0
    let mut point_hit = 0
    let mut line_point_total = 0
    let mut line_point_hit = 0
    let mut branch_total = 0
    let mut branch_hit = 0
    let mut k = 0
    while k < Array::length(keys) {
      let key = Array::get(keys, k)
      let kind = Map::get(kind_map, key)
      let hit = Map::get(hit_map, key)
      point_total = point_total + 1
      if hit {
        point_hit = point_hit + 1
      }
      if String::equals(kind, "line") {
        line_point_total = line_point_total + 1
        if hit {
          line_point_hit = line_point_hit + 1
        }
      } else {
        branch_total = branch_total + 1
        if hit {
          branch_hit = branch_hit + 1
        }
      }
      k = k + 1
    }
    Some(
      PointSummary::{
        point_total: point_total,
        point_hit: point_hit,
        line_point_total: line_point_total,
        line_point_hit: line_point_hit,
        branch_total: branch_total,
        branch_hit: branch_hit
      }
    )
  }
}

let normalize_line_stats = (raw_obj: Json, stats_obj: Json) -> (Int, Int) with { Error } {
  match obj_get_opt(raw_obj, "lines") {
    Some(JArr(lines)) => {
      let mut line_total = 0
      let mut line_hit = 0
      let mut i = 0
      while i < Array::length(lines) {
        let line_obj = Array::get(lines, i)
        let excluded = obj_get_bool_or(line_obj, "excluded", false)
        if not(excluded) {
          line_total = line_total + 1
          let hit = obj_get_bool_or(line_obj, "hit", false)
          if hit {
            line_hit = line_hit + 1
          }
        }
        i = i + 1
      };
      (line_total, line_hit)
    }
    _ =>
      (
        obj_get_num_or(stats_obj, "line_total", 0),
        obj_get_num_or(stats_obj, "line_hit", 0)
      )
  }
}

export let parse_line_list = (content: String) -> Array[String] {
  let out = ArrayBuilder::new()
  let lines = split(content, "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let line = trim(Array::get(lines, i))
    if String::length(line) > 0 {
      ArrayBuilder::push(out, line)
    }
    i = i + 1
  }
  ArrayBuilder::freeze(out)
}

let parse_int_or = (raw: String, fallback: Int) -> Int {
  handle {
    Int::parse(raw)
  } {
    Error(_) => fallback
  }
}

let parse_custom_case_input = (input: CoverageCaseInput) -> ParsedCoverageCase {
  let mut entry_path = ""
  let mut execution_ok = true
  let mut execution_error = ""
  let mut point_total = 0
  let mut point_hit = 0
  let mut line_total = 0
  let mut line_hit = 0
  let mut branch_total = 0
  let mut branch_hit = 0
  let mut line_points = ""
  let mut branch_points = ""
  let lines = split(input.report_json, "\n")
  let mut i = 0
  while i < Array::length(lines) {
    let line = Array::get(lines, i)
    let parts = split(line, "\t")
    if Array::length(parts) >= 2 {
      let key = Array::get(parts, 0)
      let value = Array::get(parts, 1)
      if String::equals(key, "entry_path") {
        entry_path = value
      } else if String::equals(key, "execution_ok") {
        execution_ok = String::equals(value, "1") || String::equals(value, "true")
      } else if String::equals(key, "execution_error") {
        execution_error = value
      } else if String::equals(key, "point_total") {
        point_total = parse_int_or(value, 0)
      } else if String::equals(key, "point_hit") {
        point_hit = parse_int_or(value, 0)
      } else if String::equals(key, "line_total") {
        line_total = parse_int_or(value, 0)
      } else if String::equals(key, "line_hit") {
        line_hit = parse_int_or(value, 0)
      } else if String::equals(key, "branch_total") {
        branch_total = parse_int_or(value, 0)
      } else if String::equals(key, "branch_hit") {
        branch_hit = parse_int_or(value, 0)
      } else if String::equals(key, "line_points") {
        line_points = value
      } else if String::equals(key, "branch_points") {
        branch_points = value
      }
    }
    i = i + 1
  }
  ParsedCoverageCase::{
    entry_path: entry_path,
    execution_ok: execution_ok,
    execution_error: execution_error,
    point_entries: concat_point_entries(
      compact_point_entries(line_points, "line"),
      compact_point_entries(branch_points, "branch")
    ),
    point_total: point_total,
    point_hit: point_hit,
    line_total: line_total,
    line_hit: line_hit,
    branch_total: branch_total,
    branch_hit: branch_hit
  }
}

let parse_json_case_input = (input: CoverageCaseInput) -> ParsedCoverageCase with { Error } {
  let (raw_obj, _) = parse(input.report_json)
  let stats_obj = match obj_get_opt(raw_obj, "stats") {
    Some(value) => value,
    None => raw_obj
  }
  let point_entries = collect_point_entries(raw_obj)
  let point_summary_opt = summarize_point_entries(point_entries)
  let point_total = match point_summary_opt {
    Some(summary) => summary.point_total
    None => obj_get_num_or(stats_obj, "point_total", 0)
  }
  let point_hit = match point_summary_opt {
    Some(summary) => summary.point_hit
    None => obj_get_num_or(stats_obj, "point_hit", 0)
  }
  let branch_total = match point_summary_opt {
    Some(summary) => summary.branch_total
    None => obj_get_num_or(stats_obj, "branch_total", 0)
  }
  let branch_hit = match point_summary_opt {
    Some(summary) => summary.branch_hit
    None => obj_get_num_or(stats_obj, "branch_hit", 0)
  }
  let (case_line_total, case_line_hit) = normalize_line_stats(raw_obj, stats_obj)
  let execution_obj = match obj_get_opt(raw_obj, "execution") {
    Some(value) => value,
    None => raw_obj
  }
  ParsedCoverageCase::{
    entry_path: obj_get_str_or(raw_obj, "entry_path", ""),
    execution_ok: obj_get_bool_or(execution_obj, "ok", true),
    execution_error: obj_get_str_or(execution_obj, "error", ""),
    point_entries: point_entries,
    point_total: point_total,
    point_hit: point_hit,
    line_total: case_line_total,
    line_hit: case_line_hit,
    branch_total: branch_total,
    branch_hit: branch_hit
  }
}

let parse_case_input = (input: CoverageCaseInput) -> ParsedCoverageCase with { Error } {
  if String::starts_with(input.report_json, "format\tvibe-wasm-source-coverage-v4\n") {
    parse_custom_case_input(input)
  } else {
    parse_json_case_input(input)
  }
}

export let build_suite_report_from_json_texts = (inputs: Array[CoverageCaseInput]) -> SuiteReport with { Error } {
  let mut line_total = 0
  let mut line_hit = 0
  let mut fallback_point_total = 0
  let mut fallback_point_hit = 0
  let mut fallback_branch_total = 0
  let mut fallback_branch_hit = 0
  let mut has_point_map = false
  let mut trap_case_count = 0

  let global_point_entries_builder = ArrayBuilder::new()
  let cases_builder = ArrayBuilder::new()

  let mut i = 0
  while i < Array::length(inputs) {
    let input = Array::get(inputs, i)
    let parsed = parse_case_input(input)
    let point_entries = parsed.point_entries
    let point_total = parsed.point_total
    let point_hit = parsed.point_hit
    let branch_total = parsed.branch_total
    let branch_hit = parsed.branch_hit

    if Array::length(point_entries) > 0 {
      has_point_map = true
      let mut j = 0
      while j < Array::length(point_entries) {
        ArrayBuilder::push(
          global_point_entries_builder,
          Array::get(point_entries, j)
        )
        j = j + 1
      }
    } else {
      fallback_point_total = fallback_point_total + point_total
      fallback_point_hit = fallback_point_hit + point_hit
      fallback_branch_total = fallback_branch_total + branch_total
      fallback_branch_hit = fallback_branch_hit + branch_hit
    }

    let case_line_total = parsed.line_total
    let case_line_hit = parsed.line_hit
    line_total = line_total + case_line_total
    line_hit = line_hit + case_line_hit

    let execution_ok = parsed.execution_ok
    if not(execution_ok) {
      trap_case_count = trap_case_count + 1
    }
    let execution_error = parsed.execution_error

    let case_stats = CaseStats::{
      point_total: point_total,
      point_hit: point_hit,
      line_total: case_line_total,
      line_hit: case_line_hit,
      branch_total: branch_total,
      branch_hit: branch_hit
    }

    ArrayBuilder::push(
      cases_builder,
      CoverageCase::{
        report_path: input.report_path,
        entry_path: parsed.entry_path,
        execution_ok: execution_ok,
        execution_error: execution_error,
        stats: case_stats,
        point_rate: rate_percent(point_hit, point_total),
        line_rate: rate_percent(case_line_hit, case_line_total),
        branch_rate: rate_percent(branch_hit, branch_total)
      }
    )

    i = i + 1
  }

  let global_summary_opt = if has_point_map {
    summarize_point_entries(ArrayBuilder::freeze(global_point_entries_builder))
  } else None

  let total_point_total = match global_summary_opt {
    Some(summary) => summary.point_total + fallback_point_total
    None => fallback_point_total
  }
  let total_point_hit = match global_summary_opt {
    Some(summary) => summary.point_hit + fallback_point_hit
    None => fallback_point_hit
  }
  let total_branch_total = match global_summary_opt {
    Some(summary) => summary.branch_total + fallback_branch_total
    None => fallback_branch_total
  }
  let total_branch_hit = match global_summary_opt {
    Some(summary) => summary.branch_hit + fallback_branch_hit
    None => fallback_branch_hit
  }

  let stats = SuiteStats::{
    point_total: total_point_total,
    point_hit: total_point_hit,
    line_total: line_total,
    line_hit: line_hit,
    branch_total: total_branch_total,
    branch_hit: total_branch_hit
  }
  let cases = ArrayBuilder::freeze(cases_builder)

  SuiteReport::{
    case_count: Array::length(cases),
    trap_case_count: trap_case_count,
    stats: stats,
    point_rate: rate_percent(stats.point_hit, stats.point_total),
    line_rate: rate_percent(stats.line_hit, stats.line_total),
    branch_rate: rate_percent(stats.branch_hit, stats.branch_total),
    cases: cases
  }
}

export let evaluate_kpi = (
  report: SuiteReport,
  min_point_rate: Option[Double],
  min_line_rate: Option[Double],
  min_branch_rate: Option[Double]
) -> KpiResult {
  let point_ok = match min_point_rate {
    Some(min) => report.point_rate >= min,
    None => true
  }
  let line_ok = match min_line_rate {
    Some(min) => report.line_rate >= min,
    None => true
  }
  let branch_ok = match min_branch_rate {
    Some(min) => report.branch_rate >= min,
    None => true
  }

  let failures_builder = ArrayBuilder::new()

  if not(point_ok) {
    let min = match min_point_rate {
      Some(v) => v,
      None => 0.0
    }
    ArrayBuilder::push(
      failures_builder,
      String::concat(
        String::concat(
          String::concat(
            String::concat("point_coverage ", format_fixed2(report.point_rate)),
            "% < "
          ),
          format_fixed2(min)
        ),
        "%"
      )
    )
  }

  if not(line_ok) {
    let min = match min_line_rate {
      Some(v) => v,
      None => 0.0
    }
    ArrayBuilder::push(
      failures_builder,
      String::concat(
        String::concat(
          String::concat(
            String::concat("line_coverage ", format_fixed2(report.line_rate)),
            "% < "
          ),
          format_fixed2(min)
        ),
        "%"
      )
    )
  }

  if not(branch_ok) {
    let min = match min_branch_rate {
      Some(v) => v,
      None => 0.0
    }
    ArrayBuilder::push(
      failures_builder,
      String::concat(
        String::concat(
          String::concat(
            String::concat("branch_coverage ", format_fixed2(report.branch_rate)),
            "% < "
          ),
          format_fixed2(min)
        ),
        "%"
      )
    )
  }

  let failures = ArrayBuilder::freeze(failures_builder)
  let has_point_threshold = match min_point_rate {
    Some(_) => true,
    None => false
  }
  let has_line_threshold = match min_line_rate {
    Some(_) => true,
    None => false
  }
  let has_branch_threshold = match min_branch_rate {
    Some(_) => true,
    None => false
  }

  KpiResult::{
    ok: point_ok && line_ok && branch_ok,
    point_rate: report.point_rate,
    line_rate: report.line_rate,
    branch_rate: report.branch_rate,
    min_point_rate: min_point_rate,
    min_line_rate: min_line_rate,
    min_branch_rate: min_branch_rate,
    has_thresholds: has_point_threshold || has_line_threshold || has_branch_threshold,
    failures: failures
  }
}

export let build_summary_text = (report: SuiteReport, kpi: KpiResult) -> String {
  let lines = ArrayBuilder::new()
  ArrayBuilder::push(lines, "vibe selfhost suite coverage")
  ArrayBuilder::push(lines, String::concat("cases: ", __to_string(report.case_count)))
  ArrayBuilder::push(
    lines,
    String::concat(
      String::concat(
        String::concat(
          String::concat(
            String::concat("points: ", __to_string(report.stats.point_hit)),
            "/"
          ),
          __to_string(report.stats.point_total)
        ),
        " ("
      ),
      String::concat(percent_text(report.stats.point_hit, report.stats.point_total), "%)")
    )
  )
  ArrayBuilder::push(
    lines,
    String::concat(
      String::concat(
        String::concat(
          String::concat(
            String::concat("lines: ", __to_string(report.stats.line_hit)),
            "/"
          ),
          __to_string(report.stats.line_total)
        ),
        " ("
      ),
      String::concat(percent_text(report.stats.line_hit, report.stats.line_total), "%)")
    )
  )
  ArrayBuilder::push(
    lines,
    String::concat(
      String::concat(
        String::concat(
          String::concat(
            String::concat("branches: ", __to_string(report.stats.branch_hit)),
            "/"
          ),
          __to_string(report.stats.branch_total)
        ),
        " ("
      ),
      String::concat(percent_text(report.stats.branch_hit, report.stats.branch_total), "%)")
    )
  )
  ArrayBuilder::push(lines, String::concat("traps: ", __to_string(report.trap_case_count)))

  if kpi.has_thresholds {
    let kpi_line = if kpi.ok {
      "kpi: ok"
    } else {
      "kpi: fail"
    }
    ArrayBuilder::push(lines, kpi_line)
    if not(kpi.ok) && Array::length(kpi.failures) > 0 {
      ArrayBuilder::push(
        lines,
        String::concat("kpi_failures: ", join_str(kpi.failures, " | "))
      )
    }
  }

  String::concat(join_str(ArrayBuilder::freeze(lines), "\n"), "\n")
}

let int_json = (value: Int) -> Json {
  JNum(Int::to_double(value))
}

let double_json = (value: Double) -> Json {
  JNum(value)
}

let bool_json = (value: Bool) -> Json {
  JBool(value)
}

let string_json = (value: String) -> Json {
  JStr(value)
}

let option_double_json = (value: Option[Double]) -> Json {
  match value {
    Some(v) => double_json(v),
    None => JNull
  }
}

let case_json = (case: CoverageCase) -> Json {
  let stats_obj_b = MapBuilder::new()
  MapBuilder::set(stats_obj_b, "point_total", int_json(case.stats.point_total))
  MapBuilder::set(stats_obj_b, "point_hit", int_json(case.stats.point_hit))
  MapBuilder::set(stats_obj_b, "line_total", int_json(case.stats.line_total))
  MapBuilder::set(stats_obj_b, "line_hit", int_json(case.stats.line_hit))
  MapBuilder::set(stats_obj_b, "branch_total", int_json(case.stats.branch_total))
  MapBuilder::set(stats_obj_b, "branch_hit", int_json(case.stats.branch_hit))

  let rates_obj_b = MapBuilder::new()
  MapBuilder::set(rates_obj_b, "point", double_json(case.point_rate))
  MapBuilder::set(rates_obj_b, "line", double_json(case.line_rate))
  MapBuilder::set(rates_obj_b, "branch", double_json(case.branch_rate))

  let obj_b = MapBuilder::new()
  MapBuilder::set(obj_b, "report_path", string_json(case.report_path))
  MapBuilder::set(obj_b, "entry_path", string_json(case.entry_path))
  MapBuilder::set(obj_b, "execution_ok", bool_json(case.execution_ok))
  MapBuilder::set(obj_b, "execution_error", string_json(case.execution_error))
  MapBuilder::set(obj_b, "stats", JObj(MapBuilder::freeze(stats_obj_b)))
  MapBuilder::set(obj_b, "rates", JObj(MapBuilder::freeze(rates_obj_b)))
  JObj(MapBuilder::freeze(obj_b))
}

export let suite_report_json = (report: SuiteReport, kpi: KpiResult) -> String {
  let stats_obj_b = MapBuilder::new()
  MapBuilder::set(stats_obj_b, "point_total", int_json(report.stats.point_total))
  MapBuilder::set(stats_obj_b, "point_hit", int_json(report.stats.point_hit))
  MapBuilder::set(stats_obj_b, "line_total", int_json(report.stats.line_total))
  MapBuilder::set(stats_obj_b, "line_hit", int_json(report.stats.line_hit))
  MapBuilder::set(stats_obj_b, "branch_total", int_json(report.stats.branch_total))
  MapBuilder::set(stats_obj_b, "branch_hit", int_json(report.stats.branch_hit))

  let rates_obj_b = MapBuilder::new()
  MapBuilder::set(rates_obj_b, "point", double_json(report.point_rate))
  MapBuilder::set(rates_obj_b, "line", double_json(report.line_rate))
  MapBuilder::set(rates_obj_b, "branch", double_json(report.branch_rate))

  let exec_obj_b = MapBuilder::new()
  MapBuilder::set(exec_obj_b, "trap_case_count", int_json(report.trap_case_count))

  let kpi_thresholds_b = MapBuilder::new()
  MapBuilder::set(
    kpi_thresholds_b,
    "min_point_rate",
    option_double_json(kpi.min_point_rate)
  )
  MapBuilder::set(
    kpi_thresholds_b,
    "min_line_rate",
    option_double_json(kpi.min_line_rate)
  )
  MapBuilder::set(
    kpi_thresholds_b,
    "min_branch_rate",
    option_double_json(kpi.min_branch_rate)
  )

  let failures_b = ArrayBuilder::new()
  let mut i = 0
  while i < Array::length(kpi.failures) {
    ArrayBuilder::push(failures_b, string_json(Array::get(kpi.failures, i)))
    i = i + 1
  }

  let kpi_obj_b = MapBuilder::new()
  MapBuilder::set(kpi_obj_b, "ok", bool_json(kpi.ok))
  MapBuilder::set(kpi_obj_b, "point_rate", double_json(kpi.point_rate))
  MapBuilder::set(kpi_obj_b, "line_rate", double_json(kpi.line_rate))
  MapBuilder::set(kpi_obj_b, "branch_rate", double_json(kpi.branch_rate))
  MapBuilder::set(
    kpi_obj_b,
    "thresholds",
    JObj(MapBuilder::freeze(kpi_thresholds_b))
  )
  MapBuilder::set(kpi_obj_b, "has_thresholds", bool_json(kpi.has_thresholds))
  MapBuilder::set(kpi_obj_b, "failures", JArr(ArrayBuilder::freeze(failures_b)))

  let cases_b = ArrayBuilder::new()
  let mut j = 0
  while j < Array::length(report.cases) {
    ArrayBuilder::push(cases_b, case_json(Array::get(report.cases, j)))
    j = j + 1
  }

  let root_b = MapBuilder::new()
  MapBuilder::set(root_b, "format", string_json("vibe-selfhost-suite-coverage-v1"))
  MapBuilder::set(root_b, "case_count", int_json(report.case_count))
  MapBuilder::set(root_b, "execution", JObj(MapBuilder::freeze(exec_obj_b)))
  MapBuilder::set(root_b, "stats", JObj(MapBuilder::freeze(stats_obj_b)))
  MapBuilder::set(root_b, "rates", JObj(MapBuilder::freeze(rates_obj_b)))
  MapBuilder::set(root_b, "cases", JArr(ArrayBuilder::freeze(cases_b)))
  MapBuilder::set(root_b, "kpi", JObj(MapBuilder::freeze(kpi_obj_b)))

  stringify(JObj(MapBuilder::freeze(root_b)))
}
