//# Imports

import ../syntax {
  lex,
  print_program,
  print_stmt,
  print_type_expr
}

import ../parser.vibe {
  parse_program, parse_stmt, parse_type
}


//# Functions

export let pp: (String) -> String = (src) -> {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } with Error {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}

export let ps: (String) -> String = (src) -> {
  handle {
    let tokens = lex(src)
    let (stmt, _) = parse_stmt(tokens, [], 0)
    print_stmt(stmt)
  } with Error {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}

export let pt: (String) -> String = (src) -> {
  handle {
    let tokens = lex(src)
    let (ty, _) = parse_type(tokens, 0)
    print_type_expr(ty)
  } with Error {
    Throw(msg) => String::concat("ERROR: ", msg)
  }
}
