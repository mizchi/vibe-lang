//# Imports

import ../ast.vibe {
  Stmt
}

import ../module_loader.vibe {
  collect_merged_stmts
}

import ../selfhost_sources_bundle.vibe {
  selfhost_sources
}

//# Functions

export let load_selfhost_sources: () -> Array[(String, String)] = () -> {
  selfhost_sources()
}

export let load_selfhost_merged: () -> Array[Stmt] with { Error } = () -> {
  collect_merged_stmts(load_selfhost_sources())
}
