//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip throw" {
  let ok = handle {
    roundtrip("throw(\"error\")")
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip if without else" {
  let ok = handle {
    roundtrip("if true { 1 }")
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip handle expression" {
  let ok = handle {
    roundtrip("handle { throw(\"oops\") } with Error { Throw(msg) => msg }")
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}

test "roundtrip escaped string variants" {
  let ok = handle {
    roundtrip("\"a\\r\\\\\\\"\"")
  } with Error {
    Throw(_) => false
  }
  assert(ok)
}
