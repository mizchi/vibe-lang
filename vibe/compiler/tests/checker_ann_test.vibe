//# Imports

import ../ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ../checker/checker_resolve.vibe {
  resolve_type_expr
}

import ../types.vibe {
  Type, TypeDef, types_equal
}

//# Functions

let empty_defs: () -> Array[TypeDef] = () -> {
  Array::slice([
    TDAlias("_dummy", Array::slice([""], 0, 0), CtUnit)
  ], 0, 0)
}

//# Misc

test "resolve_type_expr TyUnit" {
  let ty = resolve_type_expr(TyUnit, empty_defs())
  assert(types_equal(ty, CtUnit))
}

test "resolve_type_expr TyName Int" {
  let ty = resolve_type_expr(TyName("Int"), empty_defs())
  assert(types_equal(ty, CtInt))
}

test "resolve_type_expr TyName String" {
  let ty = resolve_type_expr(TyName("String"), empty_defs())
  assert(types_equal(ty, CtString))
}

test "resolve_type_expr TyName Bool" {
  let ty = resolve_type_expr(TyName("Bool"), empty_defs())
  assert(types_equal(ty, CtBool))
}

test "resolve_type_expr TyFn resolves correctly" {
  let ty = resolve_type_expr(TyFn([
    TyName("Int")
  ], TyName("String"), None), empty_defs())
  assert(types_equal(ty, CtFn([
    CtInt
  ], CtString, None)))
}

test "resolve_type_expr TyApp Array" {
  let ty = resolve_type_expr(TyApp("Array", [
    TyName("Int")
  ]), empty_defs())
  assert(types_equal(ty, CtArray(CtInt)))
}

test "resolve_type_expr TyTuple" {
  let ty = resolve_type_expr(TyTuple([
    TyName("Int"),
    TyName("String")
  ]), empty_defs())
  assert(types_equal(ty, CtTuple([
    CtInt,
    CtString
  ])))
}
