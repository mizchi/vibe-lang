//# Imports

import ../syntax {
  lex,
  print_expr
}

import ../parser.vibe {
  parse
}


//# Functions

export let roundtrip: (String) -> Bool with { Error } = (src) -> {
  let printed1 = print_expr(parse(lex(src)))
  let printed2 = print_expr(parse(lex(printed1)))
  printed1 == printed2
}

export let roundtrip_eq: (String, String) -> Bool with { Error } = (src, expected) -> {
  let printed = print_expr(parse(lex(src)))
  printed == expected
}
