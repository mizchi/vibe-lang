//# Imports

import ../lexer.vibe {
  lex
}

import ../parser.vibe {
  parse_ok
}

//# Misc

test "parse raise error" {
  let ok = parse_ok(lex("raise \"error\""))
  assert(ok == false)
}

test "parse return ok" {
  // `return` is now a supported statement (#492), so `return 1` parses.
  let ok = parse_ok(lex("return 1"))
  assert(ok)
}

test "parse do error" {
  let ok = parse_ok(lex("do { 1 }"))
  assert(ok == false)
}

test "parse loop ok" {
  let ok = parse_ok(lex("loop { 1 }"))
  assert(ok)
}

test "parse yield error" {
  let ok = parse_ok(lex("yield 1"))
  assert(ok == false)
}

test "parse declare error" {
  let ok = parse_ok(lex("declare let x: Int"))
  assert(ok == false)
}
