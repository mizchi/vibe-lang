//# Imports

import ../cache / persistent_cache.vibe {
  build_fs_compile_wasi_artifact_fingerprint, persistent_artifact_cache_path
}

import ../entry / compiler / fs_compile {
  compile_file_fs_cached
}

import ../module_loader.vibe {
  collect_source_groups_fs
}

import ../type_db.vibe {
  db_codegen_count, db_new
}

//# Functions

let string_to_bytes: (String) -> Bytes = (s) -> {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

let remove_file_if_exists: (String) -> Unit with { Fs } = (path) -> {
  if Fs::exists(path) {
    Fs::remove(path)
  } else {
    ()
  }
}

//# Misc

test "compile_file_fs_cached: fresh db reuses persistent fs artifact cache" {
  let main_path = "/tmp/vibe_compiler_persistent_fs_compile_main.vibe"
  let source = "let _start: () -> Int = () -> { 40 + 2 }"
  Fs::write_bytes(main_path, string_to_bytes(source))
  let source_groups = collect_source_groups_fs(main_path)
  let cache_path = persistent_artifact_cache_path("fs-compile-wasi", "_start", build_fs_compile_wasi_artifact_fingerprint(source_groups, "_start"))
  remove_file_if_exists(cache_path)
  let (_, db1) = compile_file_fs_cached(db_new(), main_path, "_start")
  assert(db_codegen_count(db1) > 0)
  let (_, db2) = compile_file_fs_cached(db_new(), main_path, "_start")
  assert(eq(db_codegen_count(db2), 0))
}
