//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_capture.vibe {
  analyze_captures, analyze_captures_stmts, check_mut_capture, collect_free_vars, collect_mut_bindings, collect_mut_bindings_stmts
}

//# Functions

let contains_str: (Array[String], String) -> Bool = (arr, s) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    }
    i = i + 1
  }
  found
}

let empty_bounds: () -> Array[(String, Array[String])] = () -> {
  Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
}

let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let empty_tparams: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

//# Misc

test "free_vars: EIdent with no bound returns name" {
  let result = collect_free_vars(EIdent("x"), empty_strings())
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "x")
}

test "free_vars: EIdent with name bound returns empty" {
  let result = collect_free_vars(EIdent("x"), [
    "x"
  ])
  assert(eq(Array::length(result), 0))
}

test "free_vars: ELet body has name bound" {
  // let x = 1 in x  =>  x is bound in body, no free vars
  let expr = ELet("x", EInt(1), EIdent("x"))
  let result = collect_free_vars(expr, empty_strings())
  assert(eq(Array::length(result), 0))
}

test "free_vars: ELet body references unbound var" {
  // let x = 1 in y  =>  y is free
  let expr = ELet("x", EInt(1), EIdent("y"))
  let result = collect_free_vars(expr, empty_strings())
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "y")
}

test "free_vars: EFn params bound in body" {
  // (a) -> a  =>  no free vars
  let expr = EFn(empty_tparams(), empty_bounds(), [
    ("a", None)
  ], None, None, EIdent("a"))
  let result = collect_free_vars(expr, empty_strings())
  assert(eq(Array::length(result), 0))
}

test "free_vars: EFn body references free var" {
  // (a) -> b  =>  b is free
  let expr = EFn(empty_tparams(), empty_bounds(), [
    ("a", None)
  ], None, None, EIdent("b"))
  let result = collect_free_vars(expr, empty_strings())
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "b")
}

test "free_vars: EForIn binds name in body" {
  // for x in iter { x }
  let expr = EForIn("x", None, EIdent("iter"), EIdent("x"))
  let result = collect_free_vars(expr, empty_strings())
  // iter is free, x is bound
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "iter")
}

test "mut_bindings: finds ELetMut names" {
  let expr = ELetMut("x", EInt(0), ELetMut("y", EInt(1), EUnit))
  let result = collect_mut_bindings(expr)
  assert(eq(Array::length(result), 2))
  assert(contains_str(result, "x"))
  assert(contains_str(result, "y"))
}

test "mut_bindings: no muts returns empty" {
  let expr = ELet("x", EInt(1), EIdent("x"))
  let result = collect_mut_bindings(expr)
  assert(eq(Array::length(result), 0))
}

test "check_mut_capture: detects captured mut variable" {
  // fn body references 'x', which is mutable in outer scope
  let fn_body = EIdent("x")
  let outer_muts = [
    "x"
  ]
  let result = check_mut_capture(fn_body, outer_muts)
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "x")
}

test "check_mut_capture: no muts captured returns empty" {
  // fn body references 'y', but only 'x' is mutable
  let fn_body = EIdent("y")
  let outer_muts = [
    "x"
  ]
  let result = check_mut_capture(fn_body, outer_muts)
  assert(eq(Array::length(result), 0))
}

test "analyze_captures: detects lambda capturing mut" {
  // let mut x = 0 in (() -> x)
  let expr = ELetMut("x", EInt(0), EFn(empty_tparams(), empty_bounds(), Array::slice([
    ("a", None)
  ], 0, 0), None, None, EIdent("x")))
  let result = analyze_captures(expr)
  assert(eq(Array::length(result), 1))
  let (desc, name) = Array::get(result, 0)
  assert(desc == "lambda")
  assert(name == "x")
}

test "analyze_captures: clean code returns empty" {
  // let x = 1 in (() -> 42)
  let expr = ELet("x", EInt(1), EFn(empty_tparams(), empty_bounds(), Array::slice([
    ("a", None)
  ], 0, 0), None, None, EInt(42)))
  let result = analyze_captures(expr)
  assert(eq(Array::length(result), 0))
}

test "mut_bindings_stmts: finds SLetMut" {
  let stmts = [
    SLetMut("x", None, EInt(0)),
    SLet(false, false, "y", None, EInt(1)),
    SLetMut("z", None, EInt(2))
  ]
  let result = collect_mut_bindings_stmts(stmts)
  assert(eq(Array::length(result), 2))
  assert(contains_str(result, "x"))
  assert(contains_str(result, "z"))
}

test "analyze_captures_stmts: detects mut capture across statements" {
  let stmts = [
    SLetMut("counter", None, EInt(0)),
    SLet(false, false, "inc", None, EFn(empty_tparams(), empty_bounds(), Array::slice([
      ("a", None)
    ], 0, 0), None, None, EIdent("counter")))
  ]
  let result = analyze_captures_stmts(stmts)
  assert(eq(Array::length(result), 1))
  let (desc, name) = Array::get(result, 0)
  assert(desc == "lambda")
  assert(name == "counter")
}

test "analyze_captures_stmts: no captures returns empty" {
  let stmts = [
    SLet(false, false, "x", None, EInt(1)),
    SLet(false, false, "y", None, EInt(2))
  ]
  let result = analyze_captures_stmts(stmts)
  assert(eq(Array::length(result), 0))
}

test "nested closure captures outer free var" {
  // let y = 1 in (a) -> ((b) -> y)
  // The outer lambda should have y as a free var
  let inner_fn = EFn(empty_tparams(), empty_bounds(), [
    ("b", None)
  ], None, None, EIdent("y"))
  let outer_fn = EFn(empty_tparams(), empty_bounds(), [
    ("a", None)
  ], None, None, inner_fn)
  let expr = ELet("y", EInt(1), outer_fn)
  let result = collect_free_vars(outer_fn, empty_strings())
  // outer lambda body references y through inner lambda; y is free in outer
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "y")
}

test "closure captures const: free var even if value is literal" {
  // let n = 5 in let f: () -> n
  // n is a free var inside the lambda
  let lambda = EFn(empty_tparams(), empty_bounds(), Array::slice([
    ("a", None)
  ], 0, 0), None, None, EIdent("n"))
  let result = collect_free_vars(lambda, empty_strings())
  assert(eq(Array::length(result), 1))
  assert(Array::get(result, 0) == "n")
}

test "multiple captures: all free vars collected" {
  // let a = 2 in let b = 3 in let f = (x) -> x * a + b
  // Both a and b are free vars in f
  let body = EBinOp("+", EBinOp("*", EIdent("x"), EIdent("a")), EIdent("b"))
  let lambda = EFn(empty_tparams(), empty_bounds(), [
    ("x", None)
  ], None, None, body)
  let result = collect_free_vars(lambda, empty_strings())
  assert(eq(Array::length(result), 2))
  assert(contains_str(result, "a"))
  assert(contains_str(result, "b"))
}

test "nested mut capture: inner lambda captures outer mut" {
  // let mut x = 0 in let outer = () -> (let inner = () -> x)
  // inner lambda has x as free var, and x is mut => analyze_captures flags it
  let inner_fn = EFn(empty_tparams(), empty_bounds(), Array::slice([
    ("a", None)
  ], 0, 0), None, None, EIdent("x"))
  let outer_fn = EFn(empty_tparams(), empty_bounds(), Array::slice([
    ("a", None)
  ], 0, 0), None, None, inner_fn)
  let expr = ELetMut("x", EInt(0), outer_fn)
  let result = analyze_captures(expr)
  assert(eq(Array::length(result), 1))
  let (desc, name) = Array::get(result, 0)
  assert(desc == "lambda")
  assert(name == "x")
}
