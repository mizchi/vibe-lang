//# Types

export enum Type {
  CtInt;
  CtDouble;
  CtBool;
  CtString;
  CtChar;
  CtUnit;
  CtTuple(Array[Type]);
  CtArray(Type);
  CtOption(Type);
  CtFn(Array[Type], Type, Bool);
  CtEnum(String);
  CtStruct(String);
  CtBytes;
  CtNamed(String, Array[Type]);
  CtVar(Int);
  CtForAll(Array[Int], Array[(Int, Array[String])], Type);
  CtUnknown
}

export enum TypeDef {
  TDEnum(String, Array[(String, Array[Type])]);
  TDStruct(String, Array[(String, Type)]);
  TDAlias(String, Type)
}

export enum TypeEnv {
  EnvEmpty;
  EnvBind(String, Type, TypeEnv);
  EnvTraitDef(String, Array[String], Bool, TypeEnv);
  EnvTraitImpl(String, Type, TypeEnv);
  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv)
}

export enum Subst {
  SubstEmpty;
  SubstBind(Int, Type, Subst);
  SubstBound(Int, Array[String], Subst)
}

//# Functions

export let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {
  EnvBind(name, ty, env)
}

export let fresh_var = (c: Int) -> (Type, Int) {
  (CtVar(c), c + 1)
}

export let rec occurs_in = (id: Int, ty: Type) -> Bool {
  let rec check_list = (types: Array[Type], i: Int) -> Bool {
    if i >= array_length(types) {
      false
    }
    else if occurs_in(id, array_get(types, i)) {
      true
    }
    else check_list(types, i + 1)
  }
  match ty {
    CtVar(vid) => eq(id, vid),
    CtFn(params, ret, _) => check_list(params, 0) || occurs_in(id, ret),
    CtArray(elem) => occurs_in(id, elem),
    CtOption(elem) => occurs_in(id, elem),
    CtTuple(elems) => check_list(elems, 0),
    CtForAll(_, _, body) => occurs_in(id, body),
    _ => false
  }
}

export let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {
  match env {
    EnvEmpty => None,
    EnvBind(n, ty, rest) => if string_equals(n, name) {
      Some(ty)
    } else env_lookup(rest, name),
    EnvTraitDef(_, _, _, rest) => env_lookup(rest, name),
    EnvTraitImpl(_, _, rest) => env_lookup(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => env_lookup(rest, name)
  }
}

let join_types = (arr: Array[String], sep: String) -> String {
  let len = array_length(arr)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let s = if i > 0 {
        string_concat(string_concat(acc, sep), array_get(arr, i))
      } else array_get(arr, i)
      go(i + 1, s)
    }
  }
  go(0, "")
}

export let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {
  let len = array_length(bindings)
  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {
    if i >= len {
      acc
    } else {
      let (name, ty) = array_get(bindings, i)
      go(i + 1, EnvBind(name, ty, acc))
    }
  }
  go(0, env)
}

export let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {
  let len = array_length(defs)
  let rec go = (i: Int) -> Option[TypeDef] {
    if i >= len {
      None
    } else {
      let d = array_get(defs, i)
      let dname = match d {
        TDEnum(n, _) => n,
        TDStruct(n, _) => n,
        TDAlias(n, _) => n
      }
      if string_equals(dname, name) {
        Some(d)
      } else go(i + 1)
    }
  }
  go(0)
}

let rec subst_bounds = (s: Subst, id: Int) -> Array[String] {
  match s {
    SubstEmpty => array_slice([
      ""
    ], 0, 0),
    SubstBind(_, _, rest) => subst_bounds(rest, id),
    SubstBound(bid, bounds, rest) => if eq(bid, id) {
      bounds
    } else subst_bounds(rest, id)
  }
}

export let rec subst_lookup = (s: Subst, id: Int) -> Option[Type] {
  match s {
    SubstEmpty => None,
    SubstBind(i, ty, rest) => if eq(i, id) {
      Some(ty)
    } else subst_lookup(rest, id),
    SubstBound(_, _, rest) => subst_lookup(rest, id)
  }
}

export let rec subst_apply = (s: Subst, ty: Type) -> Type {
  match ty {
    CtVar(_) => {
      let mut cur = ty
      let mut out = ty
      let mut done = false
      let mut seen = array_slice([
        0
      ], 0, 0)
      let rec seen_has = (arr: Array[Int], v: Int, i: Int) -> Bool {
        if i >= array_length(arr) {
          false
        } else if eq(array_get(arr, i), v) {
          true
        } else {
          seen_has(arr, v, i + 1)
        }
      }
      while not(done) {
        match cur {
          CtVar(vid) => {
            if seen_has(seen, vid, 0) {
              out = cur
              done = true
            } else {
              seen = array_concat(seen, [
                vid
              ])
              match subst_lookup(s, vid) {
                Some(next) => {
                  cur = next
                  out = next
                },
                None => {
                  out = cur
                  done = true
                }
              }
            }
          },
          _ => {
            out = subst_apply(s, cur)
            done = true
          }
        }
      }
      out
    },
    CtFn(params, ret, he) => {
      let rp = for p in params {
        subst_apply(s, p)
      }
      CtFn(rp, subst_apply(s, ret), he)
    },
    CtArray(elem) => CtArray(subst_apply(s, elem)),
    CtOption(elem) => CtOption(subst_apply(s, elem)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_apply(s, e)
    }),
    CtForAll(_, _, _) => ty,
    _ => ty
  }
}

export let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {
  let empty = array_slice([
    ""
  ], 0, 0)
  match env {
    EnvEmpty => empty,
    EnvBind(_, _, rest) => trait_supers(rest, name),
    EnvTraitDef(tname, supers, _, rest) => if string_equals(tname, name) {
      supers
    } else trait_supers(rest, name),
    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name)
  }
}

let rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {
  if i >= array_length(arr) {
    false
  }
  else if eq(array_get(arr, i), val) {
    true
  }
  else array_has_int(arr, val, i + 1)
}

export let collect_tvars = (ty: Type) -> Array[Int] {
  let rec go = (t: Type, acc: Array[Int]) -> Array[Int] {
    match t {
      CtVar(id) => if array_has_int(acc, id, 0) {
        acc
      } else array_concat(acc, [
        id
      ]),
      CtFn(params, ret, _) => {
        let plen = array_length(params)
        let rec do_params = (i: Int, a: Array[Int]) -> Array[Int] {
          if i >= plen {
            a
          }
          else do_params(i + 1, go(array_get(params, i), a))
        }
        go(ret, do_params(0, acc))
      },
      CtArray(elem) => go(elem, acc),
      CtOption(elem) => go(elem, acc),
      CtTuple(elems) => {
        let elen = array_length(elems)
        let rec do_elems = (i: Int, a: Array[Int]) -> Array[Int] {
          if i >= elen {
            a
          }
          else do_elems(i + 1, go(array_get(elems, i), a))
        }
        do_elems(0, acc)
      },
      CtForAll(_, _, body) => go(body, acc),
      _ => acc
    }
  }
  let empty = array_slice([
    0
  ], 0, 0)
  go(ty, empty)
}

export let generalize = (s: Subst, ty: Type) -> Type {
  let resolved = subst_apply(s, ty)
  let tvars = collect_tvars(resolved)
  if eq(array_length(tvars), 0) {
    resolved
  }
  else {
    let empty_vb = array_slice([
      (0, array_slice([
        ""
      ], 0, 0))
    ], 0, 0)
    let vlen = array_length(tvars)
    let rec collect_bounds = (i: Int, acc: Array[(Int, Array[String])]) -> Array[(Int, Array[String])] {
      if i >= vlen {
        acc
      }
      else {
        let vid = array_get(tvars, i)
        let bounds = subst_bounds(s, vid)
        if eq(array_length(bounds), 0) {
          collect_bounds(i + 1, acc)
        } else {
          collect_bounds(i + 1, array_concat(acc, [
            (vid, bounds)
          ]))
        }
      }
    }
    let var_bounds = collect_bounds(0, empty_vb)
    CtForAll(tvars, var_bounds, resolved)
  }
}

export let rec trait_defined = (env: TypeEnv, name: String) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_defined(rest, name),
    EnvTraitDef(tname, _, _, rest) => if string_equals(tname, name) {
      true
    } else trait_defined(rest, name),
    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name)
  }
}

export let rec type_to_string = (ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "()",
    CtBytes => "Bytes",
    CtVar(id) => string_concat("?t", __to_string(id)),
    CtForAll(vars, _, body) => {
      let vlen = array_length(vars)
      let rec join_vars = (i: Int, acc: String) -> String {
        if i >= vlen {
          acc
        }
        else {
          let v = string_concat("?t", __to_string(array_get(vars, i)))
          let next = if i > 0 {
            string_concat(string_concat(acc, " "), v)
          } else v
          join_vars(i + 1, next)
        }
      }
      string_concat("forall ", string_concat(join_vars(0, ""), string_concat(". ", type_to_string(body))))
    },
    CtUnknown => "?",
    CtArray(elem) => string_concat("Array[", string_concat(type_to_string(elem), "]")),
    CtOption(elem) => string_concat("Option[", string_concat(type_to_string(elem), "]")),
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, args) => if eq(array_length(args), 0) {
      name
    } else {
      let parts = for arg in args {
        type_to_string(arg)
      }
      string_concat(name, string_concat("[", string_concat(join_types(parts, ", "), "]")))
    }
    ,
    CtTuple(elems) => {
      let parts = for e in elems {
        type_to_string(e)
      }
      string_concat("(", string_concat(join_types(parts, ", "), ")"))
    },
    CtFn(params, ret, has_error) => {
      let parts = for p in params {
        type_to_string(p)
      }
      let base = string_concat("(", string_concat(join_types(parts, ", "), string_concat(") -> ", type_to_string(ret))))
      if has_error {
        string_concat(base, " with {Error}")
      } else base
    }
  }
}

export let rec types_equal = (a: Type, b: Type) -> Bool {
  let rec string_array_equal = (left: Array[String], right: Array[String], i: Int) -> Bool {
    if i >= array_length(left) {
      true
    } else if not(string_equals(array_get(left, i), array_get(right, i))) {
      false
    } else {
      string_array_equal(left, right, i + 1)
    }
  }

  let rec type_array_equal = (left: Array[Type], right: Array[Type], i: Int) -> Bool {
    if i >= array_length(left) {
      true
    } else if not(types_equal(array_get(left, i), array_get(right, i))) {
      false
    } else {
      type_array_equal(left, right, i + 1)
    }
  }

  let rec forall_bounds_equal = (
    left: Array[(Int, Array[String])],
    right: Array[(Int, Array[String])],
    i: Int,
  ) -> Bool {
    if i >= array_length(left) {
      true
    } else {
      let (lvar, lbounds) = array_get(left, i)
      let (rvar, rbounds) = array_get(right, i)
      if not(eq(lvar, rvar)) {
        false
      } else if not(eq(array_length(lbounds), array_length(rbounds))) {
        false
      } else if not(string_array_equal(lbounds, rbounds, 0)) {
        false
      } else {
        forall_bounds_equal(left, right, i + 1)
      }
    }
  }

  match a {
    CtInt => match b {
      CtInt => true,
      _ => false
    },
    CtDouble => match b {
      CtDouble => true,
      _ => false
    },
    CtBool => match b {
      CtBool => true,
      _ => false
    },
    CtString => match b {
      CtString => true,
      _ => false
    },
    CtChar => match b {
      CtChar => true,
      _ => false
    },
    CtUnit => match b {
      CtUnit => true,
      _ => false
    },
    CtBytes => match b {
      CtBytes => true,
      _ => false
    },
    CtUnknown => match b {
      CtUnknown => true,
      _ => false
    },
    CtVar(aid) => match b {
      CtVar(bid) => eq(aid, bid),
      _ => false
    },
    CtArray(aelem) => match b {
      CtArray(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtOption(aelem) => match b {
      CtOption(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtEnum(aname) => match b {
      CtEnum(bname) => string_equals(aname, bname),
      _ => false
    },
    CtStruct(aname) => match b {
      CtStruct(bname) => string_equals(aname, bname),
      _ => false
    },
    CtNamed(aname, aargs) => match b {
      CtNamed(bname, bargs) =>
        if not(string_equals(aname, bname)) {
          false
        } else if not(eq(array_length(aargs), array_length(bargs))) {
          false
        } else {
          type_array_equal(aargs, bargs, 0)
        },
      _ => false
    },
    CtTuple(aelems) => match b {
      CtTuple(belems) =>
        if not(eq(array_length(aelems), array_length(belems))) {
          false
        } else {
          type_array_equal(aelems, belems, 0)
        },
      _ => false
    },
    CtFn(aparams, aret, ahas_error) => match b {
      CtFn(bparams, bret, bhas_error) =>
        if not(eq(array_length(aparams), array_length(bparams))) {
          false
        } else if ahas_error {
          if not(bhas_error) {
            false
          } else if not(type_array_equal(aparams, bparams, 0)) {
            false
          } else {
            types_equal(aret, bret)
          }
        } else if bhas_error {
          false
        } else if not(type_array_equal(aparams, bparams, 0)) {
          false
        } else {
          types_equal(aret, bret)
        },
      _ => false
    },
    CtForAll(avars, abounds, abody) => match b {
      CtForAll(bvars, bbounds, bbody) => {
        let rec var_list_equal = (i: Int) -> Bool {
          if i >= array_length(avars) {
            true
          } else if not(eq(array_get(avars, i), array_get(bvars, i))) {
            false
          } else {
            var_list_equal(i + 1)
          }
        }
        if not(eq(array_length(avars), array_length(bvars))) {
          false
        } else if not(eq(array_length(abounds), array_length(bbounds))) {
          false
        } else if not(var_list_equal(0)) {
          false
        } else if not(forall_bounds_equal(abounds, bbounds, 0)) {
          false
        } else {
          types_equal(abody, bbody)
        }
      },
      _ => false
    }
  }
}

export let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {
  let rec unify_list = (pa: Array[Type], pb: Array[Type], i: Int, acc: Subst) -> Option[Subst] {
    if i >= array_length(pa) {
      Some(acc)
    }
    else match unify(array_get(pa, i), array_get(pb, i), acc) {
      Some(s2) => unify_list(pa, pb, i + 1, s2),
      None => None
    }
  }
  let ta = subst_apply(s, a)
  let tb = subst_apply(s, b)
  if types_equal(ta, tb) {
    Some(s)
  }
  else match ta {
    CtVar(id) => if occurs_in(id, tb) {
      None
    } else Some(SubstBind(id, tb, s)),
    _ => match tb {
      CtVar(id) => if occurs_in(id, ta) {
        None
      } else Some(SubstBind(id, ta, s)),
      _ => match ta {
        CtUnknown => Some(s),
        _ => match tb {
          CtUnknown => Some(s),
          _ => match ta {
            CtArray(ea) => match tb {
              CtArray(eb) => unify(ea, eb, s),
              _ => None
            },
            CtOption(ea) => match tb {
              CtOption(eb) => unify(ea, eb, s),
              _ => None
            },
            CtFn(pa, ra, _) => match tb {
              CtFn(pb, rb, _) => if not(eq(array_length(pa), array_length(pb))) {
                None
              }
              else match unify_list(pa, pb, 0, s) {
                Some(s2) => unify(ra, rb, s2),
                None => None
              }
              ,
              _ => None
            },
            CtTuple(ea) => match tb {
              CtTuple(eb) => if not(eq(array_length(ea), array_length(eb))) {
                None
              }
              else unify_list(ea, eb, 0, s)
              ,
              _ => None
            },
            _ => None
          }
        }
      }
    }
  }
}

export let resolve_builtin = (name: String) -> Option[Type] {
  if string_equals(name, "Int") {
    Some(CtInt)
  }
  else if string_equals(name, "Double") {
    Some(CtDouble)
  }
  else if string_equals(name, "Bool") {
    Some(CtBool)
  }
  else if string_equals(name, "String") {
    Some(CtString)
  }
  else if string_equals(name, "Char") {
    Some(CtChar)
  }
  else if string_equals(name, "Unit") {
    Some(CtUnit)
  }
  else if string_equals(name, "Bytes") {
    Some(CtBytes)
  }
  else None
}

export let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {
  SubstBound(id, bounds, s)
}

let empty_var_bounds: Array[(Int, Array[String])] = array_slice([
  (0, array_slice([
    ""
  ], 0, 0))
], 0, 0)

export let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {
  match ty {
    CtForAll(bound_vars, var_bounds, body) => {
      let blen = array_length(bound_vars)
      let rec build_subst = (i: Int, acc: Subst, nc: Int) -> (Subst, Int) {
        if i >= blen {
          (acc, nc)
        }
        else {
          let old_id = array_get(bound_vars, i)
          build_subst(i + 1, SubstBind(old_id, CtVar(nc), acc), nc + 1)
        }
      }
      let (inst_s, c1) = build_subst(0, SubstEmpty, c)
      // Remap var_bounds: old_id -> new_id
      let vblen = array_length(var_bounds)
      let rec remap_bounds = (i: Int, acc: Array[(Int, Array[String])]) -> Array[(Int, Array[String])] {
        if i >= vblen {
          acc
        }
        else {
          let (old_id, bounds) = array_get(var_bounds, i)
          let new_id = match subst_lookup(inst_s, old_id) {
            Some(t) => match t {
              CtVar(nid) => nid,
              _ => old_id
            },
            None => old_id
          }
          remap_bounds(i + 1, array_concat(acc, [
            (new_id, bounds)
          ]))
        }
      }
      let new_bounds = remap_bounds(0, empty_var_bounds)
      (subst_apply(inst_s, body), c1, new_bounds)
    },
    _ => (ty, c, empty_var_bounds)
  }
}

export let types_compatible = (expected: Type, actual: Type) -> Bool {
  match expected {
    CtUnknown => true,
    _ => match actual {
      CtUnknown => true,
      _ => types_equal(expected, actual)
    }
  }
}

export let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitImpl(tname, target, rest) => if string_equals(tname, trait_name) {
      if types_equal(target, new_target) {
        true
      }
      else impls_overlap_for(rest, trait_name, new_target)
    } else impls_overlap_for(rest, trait_name, new_target)
    ,
    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target)
  }
}

export let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {
  // DFS: sub's supers include super_name, or any of sub's supers is a subtrait of super_name
  if string_equals(sub, super_name) {
    true
  }
  else {
    let supers = trait_supers(env, sub)
    let slen = array_length(supers)
    let rec check = (i: Int) -> Bool {
      if i >= slen {
        false
      }
      else {
        let s = array_get(supers, i)
        if string_equals(s, super_name) {
          true
        }
        else if trait_is_subtrait(env, s, super_name) {
          true
        }
        else check(i + 1)
      }
    }
    check(0)
  }
}

export let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {
  let resolved = subst_apply(s, ty)
  let rec check_env = (e: TypeEnv) -> Bool {
    match e {
      EnvEmpty => false,
      EnvBind(_, _, rest) => check_env(rest),
      EnvTraitDef(_, _, _, rest) => check_env(rest),
      EnvTraitImpl(tname, target, rest) => if string_equals(tname, trait_name) {
        if types_equal(target, resolved) {
          true
        }
        else check_env(rest)
      } else check_env(rest)
      ,
      EnvTraitImplGen(_, _, _, _, rest) => check_env(rest)
    }
  }
  if check_env(env) {
    true
  }
  else {
    // Check supertrait: if trait_name has subtrait impls
    let supers = trait_supers(env, trait_name)
    let slen = array_length(supers)
    if eq(slen, 0) {
      false
    }
    else {
      // Type implements trait_name if it implements all supers? No — reversed:
      // If T implements sub-trait B where B: A, then T also implements A
      // So check all traits that the type implements and see if any is a subtrait of trait_name
      let rec check_super = (e2: TypeEnv) -> Bool {
        match e2 {
          EnvEmpty => false,
          EnvBind(_, _, rest) => check_super(rest),
          EnvTraitDef(_, _, _, rest) => check_super(rest),
          EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {
            if trait_is_subtrait(env, tname, trait_name) {
              true
            }
            else check_super(rest)
          } else check_super(rest)
          ,
          EnvTraitImplGen(_, _, _, _, rest) => check_super(rest)
        }
      }
      check_super(env)
    }
  }
}
