//# Type Definitions

export enum Type {
  CtInt;
  CtDouble;
  CtBool;
  CtString;
  CtChar;
  CtUnit;
  CtTuple(Array[Type]);
  CtArray(Type);
  CtOption(Type);
  CtFn(Array[Type], Type, Bool);
  CtEnum(String);
  CtStruct(String);
  CtBytes;
  CtNamed(String, Array[Type]);
  CtVar(Int);
  CtUnknown
}

export enum TypeDef {
  TDEnum(String, Array[(String, Array[Type])]);
  TDStruct(String, Array[(String, Type)]);
  TDAlias(String, Type)
}

export enum TypeEnv {
  EnvEmpty;
  EnvBind(String, Type, TypeEnv)
}

//# TypeEnv Functions

export let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {
  match env {
    EnvEmpty => None,
    EnvBind(n, ty, rest) => if string_equals(n, name) {
      Some(ty)
    } else env_lookup(rest, name)
  }
}

export let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {
  EnvBind(name, ty, env)
}

export let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {
  let len = array_length(bindings)
  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {
    if i >= len {
      acc
    } else {
      let (name, ty) = array_get(bindings, i)
      go(i + 1, EnvBind(name, ty, acc))
    }
  }
  go(0, env)
}

//# Helper: find_typedef

export let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {
  let len = array_length(defs)
  let rec go = (i: Int) -> Option[TypeDef] {
    if i >= len {
      None
    } else {
      let d = array_get(defs, i)
      let dname = match d {
        TDEnum(n, _) => n,
        TDStruct(n, _) => n,
        TDAlias(n, _) => n
      }
      if string_equals(dname, name) {
        Some(d)
      } else go(i + 1)
    }
  }
  go(0)
}

//# Type Resolution helpers

export let resolve_builtin = (name: String) -> Option[Type] {
  if string_equals(name, "Int") { Some(CtInt) }
  else if string_equals(name, "Double") { Some(CtDouble) }
  else if string_equals(name, "Bool") { Some(CtBool) }
  else if string_equals(name, "String") { Some(CtString) }
  else if string_equals(name, "Char") { Some(CtChar) }
  else if string_equals(name, "Unit") { Some(CtUnit) }
  else if string_equals(name, "Bytes") { Some(CtBytes) }
  else None
}

//# Type Printing

let join_types = (arr: Array[String], sep: String) -> String {
  let len = array_length(arr)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let s = if i > 0 {
        string_concat(string_concat(acc, sep), array_get(arr, i))
      } else array_get(arr, i)
      go(i + 1, s)
    }
  }
  go(0, "")
}

export let rec type_to_string = (ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "()",
    CtBytes => "Bytes",
    CtVar(id) => string_concat("?t", __to_string(id)),
    CtUnknown => "?",
    CtArray(elem) => string_concat("Array[", string_concat(type_to_string(elem), "]")),
    CtOption(elem) => string_concat("Option[", string_concat(type_to_string(elem), "]")),
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, args) => {
      if eq(array_length(args), 0) {
        name
      } else {
        let parts = for arg in args {
          type_to_string(arg)
        }
        string_concat(name, string_concat("[", string_concat(join_types(parts, ", "), "]")))
      }
    },
    CtTuple(elems) => {
      let parts = for e in elems {
        type_to_string(e)
      }
      string_concat("(", string_concat(join_types(parts, ", "), ")"))
    },
    CtFn(params, ret, has_error) => {
      let parts = for p in params {
        type_to_string(p)
      }
      let base = string_concat("(", string_concat(join_types(parts, ", "), string_concat(") -> ", type_to_string(ret))))
      if has_error {
        string_concat(base, " with {Error}")
      } else base
    }
  }
}

//# Type Equality & Compatibility

export let types_equal = (a: Type, b: Type) -> Bool {
  string_equals(type_to_string(a), type_to_string(b))
}

export let types_compatible = (expected: Type, actual: Type) -> Bool {
  match expected {
    CtUnknown => true,
    _ => match actual {
      CtUnknown => true,
      _ => types_equal(expected, actual)
    }
  }
}

//# Substitution (HM type inference)

export enum Subst {
  SubstEmpty;
  SubstBind(Int, Type, Subst)
}

export let rec subst_lookup = (s: Subst, id: Int) -> Option[Type] {
  match s {
    SubstEmpty => None,
    SubstBind(i, ty, rest) => if eq(i, id) { Some(ty) } else subst_lookup(rest, id)
  }
}

export let rec subst_apply = (s: Subst, ty: Type) -> Type {
  match ty {
    CtVar(id) => match subst_lookup(s, id) {
      Some(t) => subst_apply(s, t),
      None => ty
    },
    CtFn(params, ret, he) => {
      let rp = for p in params { subst_apply(s, p) }
      CtFn(rp, subst_apply(s, ret), he)
    },
    CtArray(elem) => CtArray(subst_apply(s, elem)),
    CtOption(elem) => CtOption(subst_apply(s, elem)),
    CtTuple(elems) => CtTuple(for e in elems { subst_apply(s, e) }),
    _ => ty
  }
}

//# Occurs check

export let rec occurs_in = (id: Int, ty: Type) -> Bool {
  let rec check_list = (types: Array[Type], i: Int) -> Bool {
    if i >= array_length(types) { false }
    else if occurs_in(id, array_get(types, i)) { true }
    else check_list(types, i + 1)
  }
  match ty {
    CtVar(vid) => eq(id, vid),
    CtFn(params, ret, _) => check_list(params, 0) || occurs_in(id, ret),
    CtArray(elem) => occurs_in(id, elem),
    CtOption(elem) => occurs_in(id, elem),
    CtTuple(elems) => check_list(elems, 0),
    _ => false
  }
}

//# Unification

export let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {
  let rec unify_list = (pa: Array[Type], pb: Array[Type], i: Int, acc: Subst) -> Option[Subst] {
    if i >= array_length(pa) { Some(acc) }
    else match unify(array_get(pa, i), array_get(pb, i), acc) {
      Some(s2) => unify_list(pa, pb, i + 1, s2),
      None => None
    }
  }
  let ta = subst_apply(s, a)
  let tb = subst_apply(s, b)
  if types_equal(ta, tb) { Some(s) }
  else match ta {
    CtVar(id) => if occurs_in(id, tb) { None } else Some(SubstBind(id, tb, s)),
    _ => match tb {
      CtVar(id) => if occurs_in(id, ta) { None } else Some(SubstBind(id, ta, s)),
      _ => match ta {
        CtUnknown => Some(s),
        _ => match tb {
          CtUnknown => Some(s),
          _ => match ta {
            CtArray(ea) => match tb { CtArray(eb) => unify(ea, eb, s), _ => None },
            CtOption(ea) => match tb { CtOption(eb) => unify(ea, eb, s), _ => None },
            CtFn(pa, ra, _) => match tb {
              CtFn(pb, rb, _) => {
                if not(eq(array_length(pa), array_length(pb))) { None }
                else match unify_list(pa, pb, 0, s) {
                  Some(s2) => unify(ra, rb, s2),
                  None => None
                }
              },
              _ => None
            },
            CtTuple(ea) => match tb {
              CtTuple(eb) => {
                if not(eq(array_length(ea), array_length(eb))) { None }
                else unify_list(ea, eb, 0, s)
              },
              _ => None
            },
            _ => None
          }
        }
      }
    }
  }
}

//# Fresh type variable

export let fresh_var = (c: Int) -> (Type, Int) {
  (CtVar(c), c + 1)
}

