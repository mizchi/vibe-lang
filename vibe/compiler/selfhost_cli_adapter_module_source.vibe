    emit_i32_add(b)
    emit_local_set(b, 5)
  } else {
    emit_global_get(b, 0)
    emit_local_tee(b, 6)
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_add(b)
    emit_global_set(b, 0)
