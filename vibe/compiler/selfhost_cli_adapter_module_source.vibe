export let lookup_builtin: (String) -> Option[Type] = (name) -> {
  let normalized = canonical_builtin_name(name)
  match lookup_array(normalized) {
    Some(t) => Some(t),
    None => match lookup_fixed_array(normalized) {
      Some(t) => Some(t),
      None => match lookup_array_builder(normalized) {
        Some(t) => Some(t),
        None => match lookup_string1(normalized) {
          Some(t) => Some(t),
          None => match lookup_string2(normalized) {
            Some(t) => Some(t),
            None => match lookup_string_builder(normalized) {
              Some(t) => Some(t),
              None => match lookup_bytes(normalized) {
                Some(t) => Some(t),
                None => match lookup_map(normalized) {
                  Some(t) => Some(t),
                  None => match lookup_io(normalized) {
                    Some(t) => Some(t),
                    None => match lookup_fs(normalized) {
                      Some(t) => Some(t),
                      None => match lookup_net(normalized) {
                        Some(t) => Some(t),
                        None => match lookup_misc(normalized) {
                          Some(t) => Some(t),
                          None => lookup_async(normalized)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}




export let rec subst_type_params: (Type, Array[String], Array[Type]) -> Type = (ty, params, args) -> {
  match ty {
    CtNamed(name, targs) => {
      let mut idx = 0 - 1
      let mut i = 0
      while i < Array::length(params) {
        if Array::get(params, i) == name {
          idx = i
        }
        i = i + 1
      }
      if idx >= 0 && idx < Array::length(args) {
        Array::get(args, idx)
      } else {
        CtNamed(name, for a in targs {
          subst_type_params(a, params, args)
        })
      }
    },
    CtArray(e) => CtArray(subst_type_params(e, params, args)),
    CtOption(e) => CtOption(subst_type_params(e, params, args)),
    CtTuple(es) => CtTuple(for e in es {
      subst_type_params(e, params, args)
    }),
    CtFn(ps, ret, eff) => {
      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, subst_type_params(Array::get(types, i), params, args))
          i = i + 1
        }
        out
      }
      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)
    },
    _ => ty
  }
}

export let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {
  match te {
    TyUnit => CtUnit,
    TyName(name) => match resolve_builtin(name) {
      Some(t) => t,
      None => match find_typedef(defs, name) {
        Some(td) => match td {
          TDEnum(n, _, _) => CtEnum(n),
          TDStruct(n, _) => CtStruct(n),
          TDAlias(_, _, t) => t
        },
        None => CtNamed(name, Array::slice([
          CtUnknown
        ], 0, 0))
      }
    },
    TyApp(name, args) => {
      let ra = for a in args {
        resolve_type_expr(a, defs)
      }
      if name == "Array" {
        if Array::length(ra) == 1 {
          CtArray(Array::get(ra, 0))
        }
        else CtNamed(name, ra)
      } else if name == "Option" {
        if Array::length(ra) == 1 {
          CtOption(Array::get(ra, 0))
        }
        else CtNamed(name, ra)
      } else {
        match find_typedef(defs, name) {
          Some(td) => match td {
            TDAlias(_, params, body) => subst_type_params(body, params, ra),
            _ => CtNamed(name, ra)
          },
          None => CtNamed(name, ra)
        }
      }
    },
    TyTuple(elems) => {
      let r = for e in elems {
        resolve_type_expr(e, defs)
      }
      CtTuple(r)
    },
    TyFn(params, ret, effect_name) => {
      let ret_box = Array::slice([
        ret
      ], 0, 1)
      let rp = for p in params {
        resolve_type_expr(p, defs)
      }
      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)
    }
  }
}




let find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {
  let dlen = Array::length(defs)
  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {
    if di >= dlen {
      None
    } else {
      let d = Array::get(defs, di)
      match d {
        TDEnum(enum_name, _, variants) => {
          let vlen = Array::length(variants)
          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {
            if vi >= vlen {
              go_defs(di + 1)
            } else {
              let (vname, vtypes) = Array::get(variants, vi)
              if vname == ctor_name {
                Some((enum_name, vtypes))
              } else {
                go_variants(vi + 1)
              }
            }
          }
          go_variants(0)
        },
        _ => go_defs(di + 1)
      }
    }
  }
  go_defs(0)
}

export let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  match pat {
    PWild => env,
    PBind(name) => env_bind(env, name, scrutinee_ty),
    PInt(_) => env,
    PString(_) => env,
    PBool(_) => env,
    PCtor(name, sub_pats) => {
      let builtin_payload = match scrutinee_ty {
        CtOption(elem) => if name == "Some" {
          Some([
            elem
          ])
        } else if name == "None" {
          Some(Array::slice([
            CtUnknown
          ], 0, 0))
        } else {
          None
        },
        _ => None
      }
      let ctor_payload = match builtin_payload {
        Some(types) => Some(("Option", types)),
        None => find_ctor_in_defs(defs, name)
      }
      match ctor_payload {
        Some(info) => {
          let (enum_name, raw_payload) = info
          let payload_types = match scrutinee_ty {
            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {
              Some(td) => match td {
                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {
                  for pt in raw_payload {
                    subst_type_params(pt, eparams, sargs)
                  }
                } else {
                  raw_payload
                },
                _ => raw_payload
              },
              None => raw_payload
            },
            _ => raw_payload
          }
          let splen = Array::length(sub_pats)
          let ptlen = Array::length(payload_types)
          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let sub_ty = if i < ptlen {
                Array::get(payload_types, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)
              bind_subs(i + 1, next_env)
            }
          }
          bind_subs(0, env)
        },
        None => {
          let splen = Array::length(sub_pats)
          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)
              bind_unknown(i + 1, next_env)
            }
          }
          bind_unknown(0, env)
        }
      }
    },
    PTuple(pats) => {
      let plen = Array::length(pats)
      match scrutinee_ty {
        CtTuple(elem_tys) => {
          let elen = Array::length(elem_tys)
          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let et = if i < elen {
                Array::get(elem_tys, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)
              bind_tuple(i + 1, next_env)
            }
          }
          bind_tuple(0, env)
        },
        _ => {
          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)
              bind_unk(i + 1, next_env)
            }
          }
          bind_unk(0, env)
        }
      }
    },
    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs),
    PStruct(_, fields) => {
      let flen = Array::length(fields)
      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
        if i >= flen {
          acc_env
        } else {
          let (_, fpat) = Array::get(fields, i)
          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs)
          bind_fields(i + 1, next_env)
        }
      }
      bind_fields(0, env)
    }
  }
}







let min_int: (Int, Int) -> Int = (a, b) -> {
  if a < b {
    a
  } else {
    b
  }
}

let prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {
  let out = Array::slice([
    EUnit
  ], 0, 0)
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

let expr_ident_name_or_empty: (Expr) -> String = (expr) -> {
  match expr {
    EIdent(name) => name,
    _ => ""
  }
}

let unify_call_args: (Array[Type], Array[Type], Subst) -> Subst = (param_tys, arg_tys, s) -> {
  let mut out = s
  let mut ui = 0
  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
  while ui < ul {
    out = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), out) {
      Some(su) => su,
      None => out
    }
    ui = ui + 1
  }
  out
}

export let fn_return_env_name: (String) -> String = (name) -> {
  String::concat("__fn_ret__:", name)
}

let direct_builtin_return: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::length" {
    Some(CtInt)
  }
  else if name == "iter_length" || name == "String::iter_length" || name == "Map::iter_length" {
    Some(CtInt)
  }
  else if name == "Array::length" {
    Some(CtInt)
  }
  else if name == "FixedArray::length" {
    Some(CtInt)
  }
  else if name == "String::length" {
    Some(CtInt)
  }
  else if name == "Bytes::get" || name == "String::index_of" || name == "String::char_code_at" || name == "String::last_index_of" || name == "Char::to_int" || name == "Double::to_int" || name == "Double::to_i64_bits" || name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" || name == "Env::args_len" || name == "Stdin::read_char" {
    Some(CtInt)
  }
  else if name == "String::equals" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "Array::any" || name == "Array::all" || name == "Array::contains" || name == "Map::has_key" || name == "map_has" || name == "Path::is_absolute" || name == "Fs::exists" || name == "Fs::is_dir" || name == "Fs::is_file" || name == "eq" || name == "not" {
    Some(CtBool)
  }
  else if name == "String::concat" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::join" || name == "Array::join" || name == "Path::to_string" || name == "Path::resolve" || name == "PromptText::new" || name == "Stdin::read_stream" || name == "Env::get" || name == "Env::args_get" || name == "Fs::read_file" || name == "Fs::getcwd" || name == "sh" || name == "Lines::stringify" || name == "Llm::complete" || name == "Rlm::run" || name == "Rlm::finalize" || name == "__to_string" {
    Some(CtString)
  }
  else if name == "__len" {
    Some(CtInt)
  }
  else if name == "String::iter_get" {
    Some(CtInt)
  }
  else if name == "iter_get" || name == "Map::iter_get" || name == "iter_require" || name == "__neg" {
    Some(CtUnknown)
  }
  else if name == "Bytes::new" || name == "Bytes::concat" || name == "Bytes::slice" || name == "Bytes::from_array" || name == "Fs::read_bytes" {
    Some(CtBytes)
  }
  else if name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "Array::foreach" || name == "FixedArray::set" || name == "FixedArray::blit" || name == "FixedArray::unsafe_set" || name == "Bytes::set" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "Stdout::write_char" || name == "Stdout::write_stream" || name == "sleep" || name == "Fs::copy" || name == "Fs::chdir" || name == "Fs::mkdir" || name == "Fs::append" || name == "Fs::remove" || name == "Fs::write_file" || name == "Fs::write_bytes" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "assert_eq" || name == "__set_field" {
    Some(CtUnit)
  }
  else if name == "Double::from_i64_bits" || name == "Int::to_double" {
    Some(CtDouble)
  }
  else if name == "Char::from_int" {
    Some(CtChar)
  }
  else if name == "Bytes::to_array" {
    Some(CtArray(CtInt))
  }
  else if name == "Map::keys" || name == "sh_lines" || name == "Lines::parse" {
    Some(CtArray(CtString))
  }
  else if name == "Array::slice" || name == "Array::concat" || name == "Array::filter" || name == "Array::reverse" || name == "Array::sort" || name == "FixedArray::make" {
    Some(CtArray(CtUnknown))
  }
  else if name == "Some" || name == "Array::find" {
    Some(CtOption(CtUnknown))
  }
  else {
    None
  }
}

let direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {
  match env_lookup(env, name) {
    Some(_) => None,
    None => direct_builtin_return(name)
  }
}

let is_logic_binop: (String) -> Bool = (op) -> {
  op == "&&"
  || op == "||"
}

let is_order_binop: (String) -> Bool = (op) -> {
  op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
}

let type_name_prefix: (Type) -> String = (ty) -> {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "Unit",
    CtBytes => "Bytes",
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, _) => name,
    _ => ""
  }
}

let is_equality_binop: (String) -> Bool = (op) -> {
  op == "=="
  || op == "!="
}

let unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {
  match unify(left_ty, target_ty, s) {
    Some(s1) => unify(right_ty, target_ty, s1),
    None => None
  }
}

let unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {
  match unify(left_ty, right_ty, s) {
    Some(s1) => Some((subst_apply(s1, left_ty), s1)),
    None => None
  }
}

let infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {
  match unify_same_binop_operands(left_ty, right_ty, s) {
    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {
      Some((resolved, s1))
    } else {
      None
    },
    None => None
  }
}

let infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors) -> {
  if is_logic_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Bool")))
        (CtUnknown, s)
      }
    }
  }
  else if is_equality_binop(op) {
    match unify(left_ty, right_ty, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must have same type")))
        (CtUnknown, s)
      }
    }
  }
  else if is_order_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtBool, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtBool, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, "Ord", s) {
          Some((_, s1)) => (CtBool, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "+" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {
          Some(s1) => (CtString, s1),
          None => match infer_named_trait_binop(env, left_ty, right_ty, "Add", s) {
            Some((resolved, s1)) => (resolved, s1),
            None => {
              Array::push(errors, "type mismatch in '+': operands must be Int, Double, or String")
              (CtUnknown, s)
            }
          }
        }
      }
    }
  }
  else if op == "-"
  || op == "*"
  || op == "/" {
    let trait_name = if op == "-" {
      "Sub"
    } else if op == "*" {
      "Mul"
    } else {
      "Div"
    }
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {
          Some((resolved, s1)) => (resolved, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "%" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, "type mismatch in '%': operands must be Int")
        (CtUnknown, s)
      }
    }
  }
  else if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int")))
        (CtUnknown, s)
      }
    }
  }
  else {
    Array::push(errors, String::concat("unknown operator: ", op))
    (CtUnknown, s)
  }
}

let rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {
  match ty {
    CtNamed(name, args) => {
      let ra = for a in args {
        resolve_tparams_in(a, env)
      }
      match env_lookup(env, name) {
        Some(t) => match t {
          CtVar(_) => t,
          _ => CtNamed(name, ra)
        },
        None => CtNamed(name, ra)
      }
    },
    CtArray(e) => CtArray(resolve_tparams_in(e, env)),
    CtOption(e) => CtOption(resolve_tparams_in(e, env)),
    CtTuple(es) => CtTuple(for e in es {
      resolve_tparams_in(e, env)
    }),
    CtFn(ps, ret, eff) => {
      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, resolve_tparams_in(Array::get(types, i), env))
          i = i + 1
        }
        out
      }
      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)
    },
    _ => ty
  }
}

export let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors) -> {
  match expr {
    EInt(_) => (CtInt, s, c),
    EFloat(_) => (CtDouble, s, c),
    EString(_) => (CtString, s, c),
    EBool(_) => (CtBool, s, c),
    EUnit => (CtUnit, s, c),
    EIdent(name) => match env_lookup(env, name) {
      Some(t) => {
        let (ti, c1, new_bounds) = instantiate(t, c)
        let nblen = Array::length(new_bounds)
        let mut s1 = s
        let mut bi = 0
        while bi < nblen {
          let (vid, bounds) = Array::get(new_bounds, bi)
          if Array::length(bounds) != 0 {
            s1 = subst_add_bound(s1, vid, bounds)
          }
          bi = bi + 1
        }
        (ti, s1, c1)
      },
      None => match lookup_builtin(name) {
        Some(t) => (t, s, c),
        None => {
          Array::push(errors, String::concat("unknown name: ", name))
          (CtUnknown, s, c)
        }
      }
    },
    ESeq(left, right) => {
      let mut s1 = s
      let mut c1 = c
      let (_, ns0, nc0) = check_expr(left, env, defs, s1, c1, errors)
      s1 = ns0
      c1 = nc0
      let mut cur = right
      let mut done = false
      while !done {
        match cur {
          ESeq(next_left, next_right) => {
            let (_, ns, nc) = check_expr(next_left, env, defs, s1, c1, errors)
            s1 = ns
            c1 = nc
            cur = next_right
          },
          _ => {
            done = true
          }
        }
      }
      check_expr(cur, env, defs, s1, c1, errors)
    },
    ELet(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)
      let gen = generalize(s1, vt)
      check_expr(body, env_bind(env, name, gen), defs, s1, c1, errors)
    },
    ELetRec(name, val, body) => {
      let (tv, c1) = fresh_var(c)
      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1, errors)
      let s2 = match unify(tv, vt, s1) {
        Some(su) => su,
        None => s1
      }
      let gen = generalize(s2, tv)
      check_expr(body, env_bind(env, name, gen), defs, s2, c2, errors)
    },
    ELetMut(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)
      check_expr(body, env_bind(env, name, vt), defs, s1, c1, errors)
    },
    EIf(cond, then_e, else_e) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "if condition must be Bool")
      }
      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors)
      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors)
      (tt, s3, c3)
    },
    ECall(callee, args) => match callee {
      EIdent(name) => if name == "perform" {
        if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(_, opargs) => {
              let oalen = Array::length(opargs)
              let mut s1 = s
              let mut c1 = c
              let mut ai = 0
              while ai < oalen {
                let (_, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors)
                s1 = ns
                c1 = nc
                ai = ai + 1
              }
              let (tv, c2) = fresh_var(c1)
              (tv, s1, c2)
            },
            EIdent(_) => {
              let (tv, c2) = fresh_var(c)
              (tv, s, c2)
            },
            other => check_expr(other, env, defs, s, c, errors)
          }
        } else {
          (CtUnknown, s, c)
        }
      } else if name == "resume" {
        let alen = Array::length(args)
        let mut s1 = s
        let mut c1 = c
        let mut ai = 0
        while ai < alen {
          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors)
          s1 = ns
          c1 = nc
          ai = ai + 1
        }
        let (tv, c2) = fresh_var(c1)
        (tv, s1, c2)
      } else if name == "Some" {
        if Array::length(args) == 1 {
          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors)
          (CtOption(subst_apply(s1, at)), s1, c1)
        } else {
          (CtOption(CtUnknown), s, c)
        }
      } else {
        match direct_call_return(env, name) {
          Some(ret_ty) => {
            let alen = Array::length(args)
            let mut ai = 0
            let mut s2 = s
            let mut c2 = c
            while ai < alen {
              let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            (subst_apply(s2, ret_ty), s2, c2)
          },
          None => {
            let (ct, s1, c1) = check_expr(EIdent(name), env, defs, s, c, errors)
            let alen = Array::length(args)
            let arg_tys = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            let mut s2 = s1
            let mut c2 = c1
            while ai < alen {
              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)
              Array::push(arg_tys, at)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat("function arity mismatch for ", String::concat(name, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2)
                let call_ret = Array::get(ret_box, 0)
                (subst_apply(s3, call_ret), s3, c2)
              },
              CtStruct(sname) => (CtStruct(sname), s2, c2),
              _ => (CtUnknown, s2, c2)
            }
          }
        }
      },
      EDot(obj, method) => {
        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)
        let resolved = subst_apply(s1, obj_ty)
        let type_prefix = type_name_prefix(resolved)
        let qualified = String::concat(type_prefix, String::concat("::", method))
        let direct_ret = direct_call_return(env, qualified)
        let method_ty = match env_lookup(env, qualified) {
          Some(t) => {
            let (ti, c2, _) = instantiate(t, c1)
            (ti, s1, c2)
          },
          None => match lookup_builtin(qualified) {
            Some(t) => (t, s1, c1),
            None => (CtUnknown, s1, c1)
          }
        }
        let (mt, s2, c2) = method_ty
        let all_args = prepend_expr(obj, args)
        let alen = Array::length(all_args)
        let arg_tys = Array::slice([
          CtUnknown
        ], 0, 0)
        Array::push(arg_tys, obj_ty)
        let mut ai = 1
        let mut s3 = s2
        let mut c3 = c2
        while ai < alen {
          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors)
          Array::push(arg_tys, at)
          s3 = ns
          c3 = nc
          ai = ai + 1
        }
        let applied_method_ty = match mt {
          CtFn(_, _, _) => mt,
          _ => subst_apply(s3, mt)
        }
        match applied_method_ty {
          CtFn(param_tys, ret, _) => {
            let ret_box = Array::slice([
              ret
            ], 0, 1)
            let call_param_tys = param_tys
            let plen = Array::length(param_tys)
            let alen2 = Array::length(arg_tys)
            if alen2 != plen {
              Array::push(errors, String::concat("function arity mismatch for ", String::concat(qualified, String::concat(": expected ", String::concat(__to_string(plen), String::concat(" args, got ", __to_string(alen2)))))))
            }
            let s4 = unify_call_args(call_param_tys, arg_tys, s3)
            let call_ret = Array::get(ret_box, 0)
            let selected_ret = match direct_ret {
              Some(t) => t,
              None => call_ret
            }
            (subst_apply(s4, selected_ret), s4, c3)
          },
          _ => match direct_ret {
            Some(t) => (t, s3, c3),
            None => (CtUnknown, s3, c3)
          }
        }
      },
      _ => {
        let callee_name0 = expr_ident_name_or_empty(callee)
        if callee_name0 != "" {
          match direct_call_return(env, callee_name0) {
            Some(ret_ty) => {
              let alen = Array::length(args)
              let mut ai = 0
              let mut s2 = s
              let mut c2 = c
              while ai < alen {
                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
              (subst_apply(s2, ret_ty), s2, c2)
            },
            None => {
              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors)
              let alen = Array::length(args)
              let arg_tys = Array::slice([
                CtUnknown
              ], 0, 0)
              let mut ai = 0
              let mut s2 = s1
              let mut c2 = c1
              while ai < alen {
                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)
                Array::push(arg_tys, at)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat("function arity mismatch for ", String::concat(callee_name0, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2)
                let call_ret = Array::get(ret_box, 0)
                (subst_apply(s3, call_ret), s3, c2)
              },
              CtStruct(sname) => (CtStruct(sname), s2, c2),
              _ => (CtUnknown, s2, c2)
            }
            }
          }
        } else {
            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors)
            let alen = Array::length(args)
            let arg_tys = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            let mut s2 = s1
            let mut c2 = c1
            while ai < alen {
              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)
              Array::push(arg_tys, at)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat("function arity mismatch for <expr>: expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2)
                let call_ret = Array::get(ret_box, 0)
                (subst_apply(s3, call_ret), s3, c2)
              },
              CtStruct(sname) => (CtStruct(sname), s2, c2),
              _ => (CtUnknown, s2, c2)
            }
        }
      }
    },
    EBinOp(op, left, right) => {
      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors)
      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors)
      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors)
      (subst_apply(s3, result_ty), s3, c2)
    },
    EUnaryOp(op, operand) => {
      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors)
      if op == "!" {
        match subst_apply(s1, operand_ty) {
          CtBool => (CtBool, s1, c1),
          CtVar(_) => match unify(operand_ty, CtBool, s1) {
            Some(s2) => (CtBool, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else if op == "-" {
        match subst_apply(s1, operand_ty) {
          CtDouble => (CtDouble, s1, c1),
          CtInt => (CtInt, s1, c1),
          CtVar(_) => match unify(operand_ty, CtInt, s1) {
            Some(s2) => (CtInt, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else (CtUnknown, s1, c1)
    },
    EAssign(_, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)
      check_expr(body, env, defs, s1, c1, errors)
    },
    EAssignOp(_, _, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)
      check_expr(body, env, defs, s1, c1, errors)
    },
    EMatch(scrutinee, arms) => {
      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors)
      let alen = Array::length(arms)
      if alen == 0 {
        (CtUnknown, s1, c1)
      }
      else {
        let mut result_ty = CtUnknown
        let mut si = s1
        let mut ci = c1
        let mut ai = 0
        while ai < alen {
          let (pat, body) = Array::get(arms, ai)
          let arm_env = check_pattern(pat, scr_ty, env, defs)
          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors)
          if ai == 0 {
            result_ty = arm_ty
          }
          si = ns
          ci = nc
          ai = ai + 1
        }
        (result_ty, si, ci)
      }
    },
    EHandle(body, _) => check_expr(body, env, defs, s, c, errors),
    EWhile(cond, body) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "while condition must be Bool")
      }
      let (_, s2, c2) = check_expr(body, env, defs, s1, c1, errors)
      (CtUnit, s2, c2)
    },
    ELoop(params, body) => {
      let mut env1 = env
      let mut s1 = s
      let mut c1 = c
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors)
        env1 = env_bind(env1, name, pt)
        s1 = ns
        c1 = nc
        i = i + 1
      }
      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1, errors)
      (CtUnit, s2, c2)
    },
    EForIn(name, index_name, iterable, body) => {
      let (it, s1, c1) = check_expr(iterable, env, defs, s, c, errors)
      let et = match subst_apply(s1, it) {
        CtArray(elem) => elem,
        CtNamed("Stream", args) => if Array::length(args) > 0 {
          Array::get(args, 0)
        } else CtUnknown,
        _ => CtUnknown
      }
      let env2 = env_bind(env, name, et)
      let env3 = match index_name {
        Some(index_name) => env_bind(env2, index_name, CtInt),
        None => env2
      }
      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1, errors)
      (CtArray(bt), s2, c2)
    },
    EDot(obj, field) => {
      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)
      let resolved = subst_apply(s1, obj_ty)
      let field_ty = match resolved {
        CtStruct(sname) => match find_typedef(defs, sname) {
          Some(td) => match td {
            TDStruct(_, fields) => {
              let rec find_field: (Int) -> Type = (i) -> {
                if i >= Array::length(fields) {
                  CtUnknown
                } else {
                  let (fname, ftype) = Array::get(fields, i)
                  if fname == field {
                    ftype
                  } else find_field(i + 1)
                }
              }
              find_field(0)
            },
            _ => CtUnknown
          },
          None => CtUnknown
        },
        _ => CtUnknown
      }
      (field_ty, s1, c1)
    },
    EFn(tparams, tbounds, params, ret_ty, effect, body) => {
      let tplen = Array::length(tparams)
      let mut tp_env = env
      let mut s0 = s
      let mut c0 = c
      let mut tpi = 0
      while tpi < tplen {
        let tpname = Array::get(tparams, tpi)
        match fresh_var(c0) {
          (tv, nc) => {
            let vid = nc - 1
            let tblen = Array::length(tbounds)
            let mut bounds = Array::slice([
              ""
            ], 0, 0)
            let mut tbi = 0
            let mut found_bounds = false
            while tbi < tblen {
              let (bname, blist) = Array::get(tbounds, tbi)
              if !found_bounds && bname == tpname {
                bounds = blist
                found_bounds = true
              }
              tbi = tbi + 1
            }
            s0 = if Array::length(bounds) == 0 {
              s0
            } else subst_add_bound(s0, vid, bounds)
            tp_env = env_bind(tp_env, tpname, tv)
            c0 = nc
          },
          _ => ()
        }
        tpi = tpi + 1
      }
      let plen = Array::length(params)
      let mut fn_env = tp_env
      let mut s1 = s0
      let mut c1 = c0
      let param_types = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut pi = 0
      while pi < plen {
        let (raw_name, ann) = Array::get(params, pi)
        let nlen = String::length(raw_name)
        let name = if nlen > 0 {
          let lc = String::char_code_at(raw_name, nlen - 1)
          if lc == '~' || lc == '?' {
            raw_name[0: nlen - 1]
          } else raw_name
        } else raw_name
        let (pt, ns, nc) = match ann {
          Some(te) => {
            let resolved = resolve_type_expr(te, defs)
            let pt2 = resolve_tparams_in(resolved, fn_env)
            (pt2, s1, c1)
          },
          None => {
            let (tv, nc2) = fresh_var(c1)
            (tv, s1, nc2)
          }
        }
        fn_env = env_bind(fn_env, name, pt)
        Array::push(param_types, pt)
        s1 = ns
        c1 = nc
        pi = pi + 1
      }
      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1, errors)
      let (final_ret, s3) = match ret_ty {
        Some(te) => {
          let resolved = resolve_type_expr(te, defs)
          let resolved_ret = resolve_tparams_in(resolved, fn_env)
          match unify(bt, resolved_ret, s2) {
            Some(ns) => (subst_apply(ns, resolved_ret), ns),
            None => {
              Array::push(errors, String::concat("return type mismatch: expected ", String::concat(type_to_string(resolved_ret), String::concat(", got ", type_to_string(bt)))))
              (CtUnknown, s2)
            }
          }
        },
        None => (subst_apply(s2, bt), s2)
      }
      (CtFn(param_types, final_ret, effect), s3, c2)
    },
    EBreak(opt) => match opt {
      Some(e) => {
        let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)
        (CtUnit, s1, c1)
      },
      None => (CtUnit, s, c)
    },
    EContinue(args) => {
      let alen = Array::length(args)
      let mut s1 = s
      let mut c1 = c
      let mut ai = 0
      while ai < alen {
        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors)
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtUnit, s1, c1)
    },
    ERecord(fields) => {
      let flen = Array::length(fields)
      let mut s1 = s
      let mut c1 = c
      let mut fi = 0
      while fi < flen {
        let (_, fval) = Array::get(fields, fi)
        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1, errors)
        s1 = ns
        c1 = nc
        fi = fi + 1
      }
      (CtUnknown, s1, c1)
    },
    ETuple(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let tys = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut ti = 0
      while ti < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors)
        Array::push(tys, it)
        s1 = ns
        c1 = nc
        ti = ti + 1
      }
      (CtTuple(tys), s1, c1)
    },
    EArray(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let mut elem_ty = CtUnknown
      let mut ai = 0
      while ai < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors)
        if ai == 0 {
          elem_ty = it
        }
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtArray(elem_ty), s1, c1)
    },
    EReturn(e) => {
      let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)
      (CtUnknown, s1, c1)
    },
    _ => (CtUnknown, s, c)
  }
}







let rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {
  if i >= Array::length(cache) {
    None
  }
  else {
    let (cached_name, cached_ty) = Array::get(cache, i)
    if cached_name == name {
      Some(cached_ty)
    }
    else import_cache_lookup(cache, name, i + 1)
  }
}

let bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {
  let env_bindings = env_flat_bindings(env)
  let import_cache = Array::slice([
    ("", CtUnknown)
  ], 0, 0)
  let nlen = Array::length(names)
  let mut i = 0
  let mut acc = env
  while i < nlen {
    let (name, alias) = Array::get(names, i)
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let ty = match import_cache_lookup(import_cache, name, 0) {
      Some(t) => t,
      None => {
        let resolved = match env_lookup_flat(env_bindings, name) {
          Some(t) => t,
          None => CtUnknown
        }
        Array::push(import_cache, (name, resolved))
        resolved
      }
    }
    let acc_with_name = env_bind(acc, bound_name, ty)
    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {
      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),
      None => acc_with_name
    }
    i = i + 1
  }
  acc
}

let annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {
  match ann {
    Some(te) => match te {
      TyFn(params, ret, _) => {
        let ret_box = Array::slice([
          ret
        ], 0, 1)
        let _ = Array::length(params)
        Some(resolve_type_expr(Array::get(ret_box, 0), defs))
      },
      _ => None
    },
    None => None
  }
}

let fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {
  match expr {
    EFn(_, _, _, ret_ty, _, _) => match ret_ty {
      Some(te) => Some(resolve_type_expr(te, defs)),
      None => None
    },
    _ => None
  }
}

let bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {
  env_bind(env, fn_return_env_name(name), ret_ty)
}

let bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {
  match annotation_return_type(ann, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => env
  }
}

let bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {
  match fn_expr_return_type(val, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => bind_annotation_return(env, name, ann, defs)
  }
}

export let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String]) -> (TypeEnv, Subst, Int) = (stmts, i, env, defs, s, c, errors) -> {
  let mut idx = i
  let mut cur_env = env
  let mut cur_s = s
  let mut cur_c = c
  while idx < Array::length(stmts) {
    let env = cur_env
    let s = cur_s
    let c = cur_c
    let stmt = Array::get(stmts, idx)
    let (new_env, s1, c1) = match stmt {
      SLet(_, is_rec, name, ann, val) => {
        let (vt, ns, nc) = if is_rec {
          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors)
        } else {
          check_expr(val, env, defs, s, c, errors)
        }
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => generalize(ns, vt)
        }
        let env1 = env_bind(env, name, t)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetMut(name, ann, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => vt
        }
        let env1 = env_bind(env, name, t)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetPat(pat, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)
        let new_env = match pat {
          PTuple(pats) => match vt {
            CtTuple(types) => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => if pi < Array::length(types) {
                    e = env_bind(e, name, Array::get(types, pi))
                  } else {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            },
            _ => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            }
          },
          PBind(name) => env_bind(env, name, vt),
          PStruct(_, fields) => {
            let mut e = env
            let mut fi = 0
            while fi < Array::length(fields) {
              let (_, fpat) = Array::get(fields, fi)
              match fpat {
                PBind(name) => {
                  e = env_bind(e, name, CtUnknown)
                },
                _ => ()
              }
              fi = fi + 1
            }
            e
          },
          _ => env
        }
        (new_env, ns, nc)
      },
      SEnum(_, name, params, variants) => {
        let param_len = Array::length(params)
        let param_var_ids = Array::slice([
          0
        ], 0, 0)
        let param_var_types = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut pi = 0
        while pi < param_len {
          let vid = c + pi
          Array::push(param_var_ids, vid)
          Array::push(param_var_types, CtVar(vid))
          pi = pi + 1
        }
        let ctor_result_type = if param_len == 0 {
          CtEnum(name)
        } else {
          CtNamed(name, param_var_types)
        }
        let ctor_bounds = Array::slice([
          (0, Array::slice([
            ""
          ], 0, 0))
        ], 0, 0)
        let resolved_variants = Array::slice([
          ("", Array::slice([
            CtUnknown
          ], 0, 0))
        ], 0, 0)
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          let resolved_vtypes = Array::slice([
            CtUnknown
          ], 0, 0)
          let mut ti = 0
          while ti < Array::length(vtypes) {
            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)
            Array::push(resolved_vtypes, vt)
            ti = ti + 1
          }
          Array::push(resolved_variants, (vname, resolved_vtypes))
          vi = vi + 1
        }
        Array::push(defs, TDEnum(name, params, resolved_variants))
        let mut env1 = env_bind(env, name, CtEnum(name))
        let mut ci2 = 0
        while ci2 < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, ci2)
          let ctor_ty = if Array::length(vtypes) == 0 {
            ctor_result_type
          } else {
            let resolved_args = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            while ai < Array::length(vtypes) {
              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)
              Array::push(resolved_args, arg_ty)
              ai = ai + 1
            }
            CtFn(resolved_args, ctor_result_type, None)
          }
          let exported_ctor_ty = if param_len == 0 {
            ctor_ty
          } else {
            CtForAll(param_var_ids, ctor_bounds, ctor_ty)
          }
          env1 = env_bind(env1, vname, exported_ctor_ty)
          match ctor_ty {
            CtFn(_, ret, _) => {
              let exported_ret_ty = if param_len == 0 {
                ret
              } else {
                CtForAll(param_var_ids, ctor_bounds, ret)
              }
              env1 = bind_fn_return(env1, vname, exported_ret_ty)
            },
            _ => ()
          }
          ci2 = ci2 + 1
        }
        (env1, s, c + param_len)
      },
      SStruct(_, name, field_defs) => {
        let resolved_fields = Array::slice([
          ("", CtUnit)
        ], 0, 0)
        let mut fi = 0
        while fi < Array::length(field_defs) {
          let (fname, ftype_expr) = Array::get(field_defs, fi)
          let ftype = resolve_type_expr(ftype_expr, defs)
          Array::push(resolved_fields, (fname, ftype))
          fi = fi + 1
        }
        Array::push(defs, TDStruct(name, resolved_fields))
        let field_types = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut fj = 0
        while fj < Array::length(resolved_fields) {
          let (_, fty) = Array::get(resolved_fields, fj)
          Array::push(field_types, fty)
          fj = fj + 1
        }
        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))
        (bind_fn_return(env1, name, CtStruct(name)), s, c)
      },
      STypeAlias(_, name, params, te) => {
        let t = resolve_type_expr(te, defs)
        Array::push(defs, TDAlias(name, params, t))
        (env_bind(env, name, t), s, c)
      },
      SExternLet(name, te) => {
        let t = resolve_type_expr(te, defs)
        let env1 = env_bind(env, name, t)
        (bind_annotation_return(env1, name, Some(te), defs), s, c)
      },
      STest(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)
        (env, ns, nc)
      },
      SBench(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)
        (env, ns, nc)
      },
      SExpr(expr) => {
        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors)
        (env, ns, nc)
      },
      SModule(_, _, body) => {
        let _ = check_stmts(body, 0, env, defs, s, c, errors)
        (env, s, c)
      },
      SImport(_, names) => (bind_stmt_imports(env, names), s, c)
      ,
      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)
      ,
      SAliasDecl(_, _) => (env, s, c)
      ,
      STrait(_, name, supers) => {
        let is_open = false
        (EnvTraitDef(name, supers, is_open, env), s, c)
      },
      SImpl(_, _, trait_name, type_name) => {
        let target = match resolve_builtin(type_name) {
          Some(t) => t,
          None => CtNamed(type_name, Array::slice([
            CtUnknown
          ], 0, 0))
        }
        (EnvTraitImpl(trait_name, target, env), s, c)
      },
      _ => (env, s, c)
    }
    cur_env = new_env
    cur_s = s1
    cur_c = c1
    idx = idx + 1
  }
  (cur_env, cur_s, cur_c)
}

export let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {
  let empty_defs = Array::slice([
    TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
  ], 0, 0)
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)
  if Array::length(frozen_errors) > 0 {
    throw(Array::get(frozen_errors, 0))
  }
  env
}

export let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {
  match initial_env {
    EnvEmpty => check_program(stmts),
    _ => {
      let empty_defs = Array::slice([
        TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
      ], 0, 0)
      let cached_env = env_cache(initial_env)
      let seeded_raw_env = if trait_defined(cached_env, "Eq") {
        cached_env
      } else {
        register_builtin_traits(cached_env)
      }
      let seeded_env = env_cache(seeded_raw_env)
      let errors = ArrayBuilder::new()
      let frozen_errors = ArrayBuilder::freeze(errors)
      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)
      if Array::length(frozen_errors) > 0 {
        throw(Array::get(frozen_errors, 0))
      }
      env
    }
  }
}



export let emit_end: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, 11)
}

export let emit_i32_const: (Bytes, Int) -> Unit = (buf, value) -> {
  bytebuf_push_opcode_s64(buf, 65, value)
}

export let emit_code_section: (Bytes, Array[Bytes]) -> Unit = (out, bodies) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let func_buf = bytebuf_new()
    leb128_encode_u32(func_buf, 0)
    bytebuf_push_buf(func_buf, body)
    bytebuf_push(func_buf, 11)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_buf(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}

export let emit_memory_section: (Bytes, Int) -> Unit = (out, min_pages) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, min_pages)
  bytebuf_push_section(out, 5, content)
}

export let emit_code_section_with_locals: (Bytes, Array[Bytes], Array[Int]) -> Unit = (out, bodies, local_counts) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let num_locals = Array::get(local_counts, i)
    let func_buf = bytebuf_new()
    if num_locals == 0 {
      leb128_encode_u32(func_buf, 0)
    } else {
      leb128_encode_u32(func_buf, 1)
      leb128_encode_u32(func_buf, num_locals)
      bytebuf_push(func_buf, 126)
    }
    bytebuf_push_buf(func_buf, body)
    bytebuf_push(func_buf, 11)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_buf(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}



export let emit_header: (Bytes) -> Unit = (buf) -> {
  bytebuf_push3(buf, 0, 97, 115)
  bytebuf_push3(buf, 109, 1, 0)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
}



export let emit_func_type: (Bytes, Int, Int) -> Unit = (buf, param_count, result_count) -> {
  bytebuf_push(buf, 96)
  leb128_encode_u32(buf, param_count)
  let mut i = 0
  while i < param_count {
    bytebuf_push(buf, 126)
    i = i + 1
  }
  leb128_encode_u32(buf, result_count)
  let mut j = 0
  while j < result_count {
    bytebuf_push(buf, 126)
    j = j + 1
  }
}

export let emit_type_section_multi: (Bytes, Array[Int]) -> Unit = (out, type_defs) -> {
  let count = Array::length(type_defs) / 2
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))
    i = i + 1
  }
  bytebuf_push_section(out, 1, content)
}

export let emit_type_section: (Bytes, Int, Int) -> Unit = (out, param_count, result_count) -> {
  let type_defs = Array::slice([
    0
  ], 0, 0)
  Array::push(type_defs, param_count)
  Array::push(type_defs, result_count)
  emit_type_section_multi(out, type_defs)
}




export {
  emit_header, emit_func_type, emit_type_section, emit_type_section_multi
}



export let emit_name: (Bytes, String) -> Unit = (buf, name) -> {
  bytebuf_push_string(buf, name)
}

export let emit_function_section: (Bytes, Array[Int]) -> Unit = (out, type_indices) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(type_indices))
  let mut i = 0
  while i < Array::length(type_indices) {
    leb128_encode_u32(content, Array::get(type_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 3, content)
}

export let emit_export_section_multi: (Bytes, Array[String], Array[Int]) -> Unit = (out, names, func_indices) -> {
  let count = Array::length(names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, 0)
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 7, content)
}

export let emit_export_section: (Bytes, String, Int) -> Unit = (out, name, func_idx) -> {
  emit_export_section_multi(out, [
    name
  ], [
    func_idx
  ])
}




export {
