export enum Pat {
  PWild;
  PBind(String);
  PInt(Int);
  PString(String);
  PBool(Bool);
  PCtor(String, Array[Pat]);
  PTuple(Array[Pat]);
  POr(Pat, Pat);
  PStruct(String, Array[(String, Pat)])
}

export enum TypeExpr {
  TyName(String);
  TyApp(String, Array[TypeExpr]);
  TyFn(Array[TypeExpr], TypeExpr, Option[String]);
  TyTuple(Array[TypeExpr]);
  TyUnit
}

export enum Expr {
  EInt(Int);
  EFloat(Double);
  EString(String);
  EBool(Bool);
  EIdent(String);
  ETuple(Array[Expr]);
  EArray(Array[Expr]);
  ERecord(Array[(String, Expr)]);
  EIf(Expr, Expr, Expr);
  ELet(String, Expr, Expr);
  ELetRec(String, Expr, Expr);
  ELetMut(String, Expr, Expr);
  EAssign(String, Expr, Expr);
  EAssignOp(String, String, Expr, Expr);
  ESeq(Expr, Expr);
  EMatch(Expr, Array[(Pat, Expr)]);
  EHandle(Expr, Array[(Pat, Expr)]);
  EWhile(Expr, Expr);
  ELoop(Array[(String, Expr)], Expr);
  EForIn(String, Option[String], Expr, Expr);
  ECall(Expr, Array[Expr]);
  EBinOp(String, Expr, Expr);
  EUnaryOp(String, Expr);
  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);
  EDot(Expr, String);
  ELabeledArg(String, String, Expr);
  EThrow(Expr);
  EReturn(Expr);
  EBreak(Option[Expr]);
  EContinue(Array[Expr]);
  EMap(Array[(String, Expr)]);
  ESpread(Expr);
  EStringInterp(Array[String]);
  EUnit
}

export enum Stmt {
  SLet(Bool, Bool, String, Option[TypeExpr], Expr);
  SLetMut(String, Option[TypeExpr], Expr);
  SEnum(Bool, String, Array[String], Array[(String, Array[TypeExpr])]);
  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);
  SStruct(Bool, String, Array[(String, TypeExpr)]);
  STypeAlias(Bool, String, Array[String], TypeExpr);
  STrait(Bool, String, Array[String]);
  SImpl(Array[String], Array[(String, Array[String])], String, String);
  SExternLet(String, TypeExpr);
  SImport(String, Array[(String, Option[String])]);
  STest(String, Expr);
  SBench(String, Expr);
  SExpr(Expr);
  SExport(Array[String]);
  SReExport(String, Array[(String, Option[String])]);
  SAliasDecl(String, String);
  SLetPat(Pat, Expr);
  SModule(Bool, String, Array[Stmt]);
  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)])
}

export let __to_string: (Int) -> String = (n) -> {
  if n == 0 {
    "0"
  } else {
    let mut val = n
    let mut neg = false
    if val < 0 {
      neg = true
      val = 0 - val
    }
    let digits = Array::slice([
      ""
    ], 0, 0)
    while val > 0 {
      let d = val - (val / 10) * 10
      let ch = if d == 0 {
        "0"
      }
      else if d == 1 {
        "1"
      }
      else if d == 2 {
        "2"
      }
      else if d == 3 {
        "3"
      }
      else if d == 4 {
        "4"
      }
      else if d == 5 {
        "5"
      }
      else if d == 6 {
        "6"
      }
      else if d == 7 {
        "7"
      }
      else if d == 8 {
        "8"
      }
      else {
        "9"
      }
      Array::push(digits, ch)
      val = val / 10
    }
    let mut result = if neg {
      "-"
    } else {
      ""
    }
    let mut i = Array::length(digits) - 1
    while i >= 0 {
      result = String::concat(result, Array::get(digits, i))
      i = i - 1
    }
    result
  }
}

export let bytebuf_new: () -> Bytes = () -> {
  Bytes::new()
}

export let bytebuf_push: (Bytes, Int) -> Unit = (buf, byte) -> {
  Bytes::push(buf, byte)
}

export let bytebuf_push2: (Bytes, Int, Int) -> Unit = (buf, b1, b2) -> {
  bytebuf_push(buf, b1)
  bytebuf_push(buf, b2)
}

export let bytebuf_push3: (Bytes, Int, Int, Int) -> Unit = (buf, b1, b2, b3) -> {
  bytebuf_push(buf, b1)
  bytebuf_push(buf, b2)
  bytebuf_push(buf, b3)
}

export let bytebuf_push9: (Bytes, Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Unit = (buf, b1, b2, b3, b4, b5, b6, b7, b8, b9) -> {
  bytebuf_push(buf, b1)
  bytebuf_push(buf, b2)
  bytebuf_push(buf, b3)
  bytebuf_push(buf, b4)
  bytebuf_push(buf, b5)
  bytebuf_push(buf, b6)
  bytebuf_push(buf, b7)
  bytebuf_push(buf, b8)
  bytebuf_push(buf, b9)
}

export let bytebuf_length: (Bytes) -> Int = (buf) -> {
  Bytes::length(buf)
}

export let bytebuf_push_buf: (Bytes, Bytes) -> Unit = (dst, src) -> {
  Bytes::append(dst, src)
}

export let bytebuf_to_bytes: (Bytes) -> Bytes = (buf) -> {
  buf
}

export let leb128_encode_s32: (Bytes, Int) -> Unit = (buf, value) -> {
  if value >= (0 - 64) && value < 64 {
    Bytes::push(buf, value&127)
  } else {
    if value >= (0 - 8192) && value < 8192 {
      Bytes::push(buf, (value&127)|128)
      Bytes::push(buf, (value>>7)&127)
    } else {
      let mut v = value
      let mut more = true
      while more {
        let byte = v&127
        v = v>>7
        if (v == 0) && (byte&64) == 0 {
          Bytes::push(buf, byte)
          more = false
        } else {
          if (v == 0 - 1) && (byte&64) != 0 {
            Bytes::push(buf, byte)
            more = false
          } else {
            Bytes::push(buf, byte|128)
          }
        }
      }
    }
  }
}

export let leb128_encode_s64: (Bytes, Int) -> Unit = (buf, value) -> {
  leb128_encode_s32(buf, value)
}

export let leb128_encode_u32: (Bytes, Int) -> Unit = (buf, value) -> {
  if value >= 0 && value < 128 {
    Bytes::push(buf, value)
  } else {
    if value >= 128 && value < 16384 {
      Bytes::push(buf, (value&127)|128)
      Bytes::push(buf, (value>>7)&127)
    } else {
      let mut v = value
      let mut more = true
      while more {
        let byte = v&127
        v = (v>>7)&((1<<25) - 1)
        if v == 0 {
          Bytes::push(buf, byte)
          more = false
        } else {
          Bytes::push(buf, byte|128)
        }
      }
    }
  }
}

export let bytebuf_push_string: (Bytes, String) -> Unit = (buf, s) -> {
  let slen = String::length(s)
  leb128_encode_u32(buf, slen)
  let mut i = 0
  while i < slen {
    bytebuf_push(buf, String::char_code_at(s, i))
    i = i + 1
  }
}

export let bytebuf_push_section: (Bytes, Int, Bytes) -> Unit = (out, section_id, content) -> {
  bytebuf_push(out, section_id)
  leb128_encode_u32(out, bytebuf_length(content))
  bytebuf_push_buf(out, content)
}

export let bytebuf_push_opcode_s64: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {
  bytebuf_push(buf, opcode)
  leb128_encode_s32(buf, value)
}

export let bytebuf_push_opcode_u32: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {
  if value >= 0 && value < 128 {
    Bytes::push(buf, opcode)
    Bytes::push(buf, value)
  } else {
    if value >= 128 && value < 16384 {
      Bytes::push(buf, opcode)
      Bytes::push(buf, (value&127)|128)
      Bytes::push(buf, (value>>7)&127)
    } else {
      Bytes::push(buf, opcode)
      leb128_encode_u32(buf, value)
    }
  }
}

export let bytebuf_push_vec_header: (Bytes, Int) -> Unit = (buf, count) -> {
  leb128_encode_u32(buf, count)
}

export let bytebuf_push_opcode_u32_u32: (Bytes, Int, Int, Int) -> Unit = (buf, opcode, a, b) -> {
  bytebuf_push(buf, opcode)
  leb128_encode_u32(buf, a)
  leb128_encode_u32(buf, b)
}



let clone_arr: (Array[String]) -> Array[String] = (arr) -> {
  Array::slice(arr, 0, Array::length(arr))
}

let stmt_name: (Stmt) -> Option[String] = (stmt) -> {
  match stmt {
    SLet(_, _, name, _, _) => Some(name),
    SLetMut(name, _, _) => Some(name),
    _ => None
  }
}

let dce_array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {
  let len = Array::length(arr)
  let rec search: (Int) -> Bool = (i) -> {
    if i >= len {
      false
    }
    else if Array::get(arr, i) == s {
      true
    }
    else search(i + 1)
  }
  search(0)
}

let add_ref: (Array[String], Array[String], String) -> Int = (out, bound, name) -> {
  if not(dce_array_contains_str(bound, name)) {
    if not(dce_array_contains_str(out, name)) {
      Array::push(out, name)
    }
  }
  0
}

let rec collect_pat_bindings: (Pat, Array[String]) -> Int = (pat, bound) -> {
  match pat {
    PWild => 0,
    PBind(name) => {
      Array::push(bound, name)
      0
    },
    PInt(_) => 0,
    PString(_) => 0,
    PBool(_) => 0,
    PCtor(_, pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), bound)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pat_bindings(Array::get(pats, i), bound)
        i = i + 1
      }
      0
    },
    POr(p1, p2) => {
      collect_pat_bindings(p1, bound)
      collect_pat_bindings(p2, bound)
      0
    },
    PStruct(_, _) => 0
  }
}

let rec collect_refs_into: (Expr, Array[String], Array[String]) -> Int = (expr, bound, out) -> {
  match expr {
    EIdent(name) => add_ref(out, bound, name),
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EBreak(_) => 0,
    EContinue(_) => 0,
    EThrow(e) => collect_refs_into(e, bound, out),
    EReturn(e) => collect_refs_into(e, bound, out),
    EUnaryOp(_, e) => collect_refs_into(e, bound, out),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(Array::get(items, i), bound, out)
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        collect_refs_into(Array::get(items, i), bound, out)
        i = i + 1
      }
      0
    },
    ERecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_refs_into(val, bound, out)
        i = i + 1
      }
      0
    },
    EBinOp(_, l, r) => {
      collect_refs_into(l, bound, out)
      collect_refs_into(r, bound, out)
      0
    },
    ECall(callee, args) => {
      collect_refs_into(callee, bound, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_refs_into(Array::get(args, i), bound, out)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      collect_refs_into(cond, bound, out)
      collect_refs_into(then_e, bound, out)
      collect_refs_into(else_e, bound, out)
      0
    },
    ELet(name, val, body) => {
      collect_refs_into(val, bound, out)
      let bound2 = clone_arr(bound)
      Array::push(bound2, name)
      collect_refs_into(body, bound2, out)
      0
    },
    ELetRec(name, val, body) => {
      let bound2 = clone_arr(bound)
      Array::push(bound2, name)
      collect_refs_into(val, bound2, out)
      collect_refs_into(body, bound2, out)
      0
    },
    ELetMut(name, val, body) => {
      collect_refs_into(val, bound, out)
      let bound2 = clone_arr(bound)
      Array::push(bound2, name)
      collect_refs_into(body, bound2, out)
      0
    },
    EAssign(_, val, body) => {
      collect_refs_into(val, bound, out)
      collect_refs_into(body, bound, out)
      0
    },
    EAssignOp(_, _, val, body) => {
      collect_refs_into(val, bound, out)
      collect_refs_into(body, bound, out)
      0
    },
    ESeq(l, r) => {
      collect_refs_into(l, bound, out)
      collect_refs_into(r, bound, out)
      0
    },
    EMatch(scr, arms) => {
      collect_refs_into(scr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        let bound2 = clone_arr(bound)
        collect_pat_bindings(pat, bound2)
        collect_refs_into(body, bound2, out)
        i = i + 1
      }
      0
    },
    EHandle(body_expr, arms) => {
      collect_refs_into(body_expr, bound, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        let bound2 = clone_arr(bound)
        collect_pat_bindings(pat, bound2)
        collect_refs_into(arm_body, bound2, out)
        i = i + 1
      }
      0
    },
    EWhile(cond, body) => {
      collect_refs_into(cond, bound, out)
      collect_refs_into(body, bound, out)
      0
    },
    ELoop(params, body) => {
      let bound2 = clone_arr(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        collect_refs_into(init, bound2, out)
        Array::push(bound2, name)
        i = i + 1
      }
      collect_refs_into(body, bound2, out)
      0
    },
    EForIn(name, index_name, iter, body) => {
      collect_refs_into(iter, bound, out)
      let bound2 = clone_arr(bound)
      Array::push(bound2, name)
      match index_name {
        Some(index_name) => Array::push(bound2, index_name),
        None => ()
      }
      collect_refs_into(body, bound2, out)
      0
    },
    EFn(_, _, params, _, _, body) => {
      let bound2 = clone_arr(bound)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        Array::push(bound2, pname)
        i = i + 1
      }
      collect_refs_into(body, bound2, out)
      0
    },
    EDot(obj, _) => {
      collect_refs_into(obj, bound, out)
      0
    },
    ELabeledArg(_, _, e) => {
      collect_refs_into(e, bound, out)
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, val) = Array::get(fields, i)
        collect_refs_into(val, bound, out)
        i = i + 1
      }
      0
    },
    ESpread(e) => {
      collect_refs_into(e, bound, out)
      0
    },
    EStringInterp(_) => 0
  }
}

let collect_refs: (Expr, Array[String]) -> Array[String] = (expr, bound) -> {
  let out = Array::slice([
    ""
  ], 0, 0)
  collect_refs_into(expr, bound, out)
  out
}

let enqueue_reachable: (Array[String], Array[String], String) -> Unit = (reachable, queue, name) -> {
  if not(dce_array_contains_str(reachable, name)) {
    Array::push(reachable, name)
    Array::push(queue, name)
  }
}

let collect_structural_refs_into_queue: (Stmt, Array[String], Array[String], Array[String]) -> Unit = (stmt, bound, reachable, queue) -> {
  let refs = match stmt {
    STest(_, expr) => collect_refs(expr, bound),
    SBench(_, expr) => collect_refs(expr, bound),
    SExpr(expr) => collect_refs(expr, bound),
    _ => Array::slice([
      ""
    ], 0, 0)
  }
  let mut i = 0
  while i < Array::length(refs) {
    enqueue_reachable(reachable, queue, Array::get(refs, i))
    i = i + 1
  }
}

let is_type_or_structural: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SEnum(_, _, _, _) => true,
    SSuberror(_, _, _) => true,
    SEffectDef(_, _, _, _) => true,
    SStruct(_, _, _) => true,
    STypeAlias(_, _, _, _) => true,
    STrait(_, _, _) => true,
    SImpl(_, _, _, _) => true,
    SExternLet(_, _) => true,
    SImport(_, _) => true,
    SAliasDecl(_, _) => true,
    STest(_, _) => true,
    SBench(_, _) => true,
    SExpr(_) => true,
    SExport(_) => true,
    SReExport(_, _) => true,
    SModule(_, _, _) => true,
    _ => false
  }
}

export let dce_stmts: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, entry_names) -> {
  if Array::length(stmts) == 0 {
    Array::slice(stmts, 0, 0)
  } else {
  let empty_bound = Array::slice([
    ""
  ], 0, 0)
  let def_names = Array::slice([
    ""
  ], 0, 0)
  let def_refs = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt_name(stmt) {
      Some(name) => {
        Array::push(def_names, name)
        let refs = match stmt {
          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),
          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),
          _ => Array::slice([
            ""
          ], 0, 0)
        }
        Array::push(def_refs, refs)
        0
      },
      None => 0
    }
    i = i + 1
  }
  let reachable = Array::slice([
    ""
  ], 0, 0)
  let queue = Array::slice([
    ""
  ], 0, 0)
  let mut j = 0
  while j < Array::length(entry_names) {
    let name = Array::get(entry_names, j)
    enqueue_reachable(reachable, queue, name)
    j = j + 1
  }
  let mut sj = 0
  while sj < Array::length(stmts) {
    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)
    sj = sj + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let current = Array::get(queue, qi)
    qi = qi + 1
    let mut k = 0
    while k < Array::length(def_names) {
      if Array::get(def_names, k) == current {
        let refs = Array::get(def_refs, k)
        let mut r = 0
        while r < Array::length(refs) {
          let dep = Array::get(refs, r)
          if not(dce_array_contains_str(reachable, dep)) {
            Array::push(reachable, dep)
            Array::push(queue, dep)
          }
          r = r + 1
        }
      }
      k = k + 1
    }
  }
  let result = Array::slice([
    Array::get(stmts, 0)
  ], 0, 0)
  let mut m = 0
  while m < Array::length(stmts) {
    let stmt = Array::get(stmts, m)
    if is_type_or_structural(stmt) {
      Array::push(result, stmt)
    } else {
      match stmt_name(stmt) {
        Some(name) => if dce_array_contains_str(reachable, name) {
          Array::push(result, stmt)
        },
        None => Array::push(result, stmt)
      }
    }
    m = m + 1
  }
  result
  }
}

let dce_reachable_names: (Array[Stmt], Array[String]) -> Array[String] = (stmts, entry_names) -> {
  let empty_bound = Array::slice([
    ""
  ], 0, 0)
  let def_names = Array::slice([
    ""
  ], 0, 0)
  let def_refs = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt_name(stmt) {
      Some(name) => {
        Array::push(def_names, name)
        let refs = match stmt {
          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),
          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),
          _ => Array::slice([
            ""
          ], 0, 0)
        }
        Array::push(def_refs, refs)
        0
      },
      None => 0
    }
    i = i + 1
  }
  let reachable = Array::slice([
    ""
  ], 0, 0)
  let queue = Array::slice([
    ""
  ], 0, 0)
  let mut j = 0
  while j < Array::length(entry_names) {
    let name = Array::get(entry_names, j)
    enqueue_reachable(reachable, queue, name)
    j = j + 1
  }
  let mut sj = 0
  while sj < Array::length(stmts) {
    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)
    sj = sj + 1
  }
  let mut qi = 0
  while qi < Array::length(queue) {
    let current = Array::get(queue, qi)
    qi = qi + 1
    let mut k = 0
    while k < Array::length(def_names) {
      if Array::get(def_names, k) == current {
        let refs = Array::get(def_refs, k)
        let mut r = 0
        while r < Array::length(refs) {
          let dep = Array::get(refs, r)
          if not(dce_array_contains_str(reachable, dep)) {
            Array::push(reachable, dep)
            Array::push(queue, dep)
          }
          r = r + 1
        }
      }
      k = k + 1
    }
  }
  reachable
}

let dce_keep_stmt: (Stmt, Array[String]) -> Bool = (stmt, reachable) -> {
  if is_type_or_structural(stmt) {
    true
  } else {
    match stmt_name(stmt) {
      Some(name) => dce_array_contains_str(reachable, name),
      None => true
    }
  }
}

export let dce_keep_flags: (Array[Stmt], Array[String]) -> Array[Bool] = (stmts, entry_names) -> {
  let flags = Array::slice([
    true
  ], 0, 0)
  if Array::length(stmts) == 0 {
    flags
  } else {
    let reachable = dce_reachable_names(stmts, entry_names)
    let mut m = 0
    while m < Array::length(stmts) {
      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), reachable))
      m = m + 1
    }
    flags
  }
}

export enum Type {
  CtInt;
  CtDouble;
  CtBool;
  CtString;
  CtChar;
  CtUnit;
  CtTuple(Array[Type]);
  CtArray(Type);
  CtOption(Type);
  CtFn(Array[Type], Type, Option[String]);
  CtEnum(String);
  CtStruct(String);
  CtBytes;
  CtNamed(String, Array[Type]);
  CtVar(Int);
  CtForAll(Array[Int], Array[(Int, Array[String])], Type);
  CtUnknown
}

export enum TypeDef {
  TDEnum(String, Array[String], Array[(String, Array[Type])]);
  TDStruct(String, Array[(String, Type)]);
  TDAlias(String, Array[String], Type)
}

export enum TypeEnv {
  EnvEmpty;
  EnvBind(String, Type, TypeEnv);
  EnvTraitDef(String, Array[String], Bool, TypeEnv);
  EnvTraitImpl(String, Type, TypeEnv);
  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);
  EnvFlat(Array[(String, Type)]);
  EnvCached(Map[String, Type], TypeEnv)
}

export enum Subst {
  SubstEmpty;
  SubstBind(Int, Type, Subst);
  SubstBound(Int, Array[String], Subst);
  SubstCached(Map[String, Type], Map[String, Array[String]], Subst)
}


export let env_bind: (TypeEnv, String, Type) -> TypeEnv = (env, name, ty) -> {
  match env {
    EnvCached(cache, rest) => EnvCached(cache, EnvBind(name, ty, rest)),
    _ => EnvBind(name, ty, env)
  }
}

export let env_cache: (TypeEnv) -> TypeEnv = (env) -> {
  let is_empty = match env {
    EnvEmpty => true,
    _ => false
  }
  if is_empty {
    EnvEmpty
  } else {
    let names = ArrayBuilder::new()
    let types = ArrayBuilder::new()
    let mut cur = env
    let mut done = false
    while !done {
      match cur {
        EnvEmpty => {
          done = true
        },
        EnvBind(n, ty, rest) => {
          ArrayBuilder::push(names, n)
          ArrayBuilder::push(types, ty)
          cur = rest
        },
        EnvTraitDef(_, _, _, rest) => {
          cur = rest
        },
        EnvTraitImpl(_, _, rest) => {
          cur = rest
        },
        EnvTraitImplGen(_, _, _, _, rest) => {
          cur = rest
        },
        EnvFlat(bindings) => {
          let mut j = 0
          while j < Array::length(bindings) {
            let (n, ty) = Array::get(bindings, j)
            ArrayBuilder::push(names, n)
            ArrayBuilder::push(types, ty)
            j = j + 1
          }
          done = true
        },
        EnvCached(_, rest) => {
          cur = rest
        }
      }
    }
    let na = ArrayBuilder::freeze(names)
    let ta = ArrayBuilder::freeze(types)
    let cache = MapBuilder::new()
    let len = Array::length(na)
    let mut i = 0
    while i < len {
      let idx = len - i - 1
      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))
      i = i + 1
    }
    EnvCached(MapBuilder::freeze(cache), env)
  }
}

export let fresh_var: (Int) -> (Type, Int) = (c) -> {
  (CtVar(c), c + 1)
}

export let rec occurs_in: (Int, Type) -> Bool = (id, ty) -> {
  match ty {
    CtVar(vid) => (id == vid),
    CtFn(params, ret, _) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(params) {
        if occurs_in(id, Array::get(params, i)) {
          found = true
          i = Array::length(params)
        } else {
          i = i + 1
        }
      }
      found || occurs_in(id, ret)
    },
    CtArray(elem) => occurs_in(id, elem),
    CtOption(elem) => occurs_in(id, elem),
    CtTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if occurs_in(id, Array::get(elems, i)) {
          found = true
          i = Array::length(elems)
        } else {
          i = i + 1
        }
      }
      found
    },
    CtForAll(_, _, body) => occurs_in(id, body),
    _ => false
  }
}

export let env_lookup: (TypeEnv, String) -> Option[Type] = (env, name) -> {
  let mut cur = env
  let mut result = None
  let mut done = false
  while !done {
    match cur {
      EnvEmpty => {
        done = true
      },
      EnvBind(n, ty, rest) => if n == name {
        result = Some(ty)
        done = true
      } else {
        cur = rest
      },
      EnvTraitDef(_, _, _, rest) => {
        cur = rest
      },
      EnvTraitImpl(_, _, rest) => {
        cur = rest
      },
      EnvTraitImplGen(_, _, _, _, rest) => {
        cur = rest
      },
      EnvFlat(bindings) => {
        let mut j = 0
        while j < Array::length(bindings) && !done {
          let (n, ty) = Array::get(bindings, j)
          if n == name {
            result = Some(ty)
            done = true
          } else {
            j = j + 1
          }
        }
        if !done {
          done = true
        }
      },
      EnvCached(cache, rest) => if Map::has_key(cache, name) {
        result = Some(Map::get(cache, name))
        done = true
      } else {
        cur = rest
      }
    }
  }
  result
}

export let env_bind_all: (TypeEnv, Array[(String, Type)]) -> TypeEnv = (env, bindings) -> {
  let len = Array::length(bindings)
  let mut i = 0
  let mut acc = env
  while i < len {
    let (name, ty) = Array::get(bindings, i)
    acc = env_bind(acc, name, ty)
    i = i + 1
  }
  acc
}

export let find_typedef: (Array[TypeDef], String) -> Option[TypeDef] = (defs, name) -> {
  let len = Array::length(defs)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let d = Array::get(defs, i)
      let dname = match d {
        TDEnum(n, _, _) => n,
        TDStruct(n, _) => n,
        TDAlias(n, _, _) => n
      }
      if dname == name {
        result = Some(d)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

export let subst_lookup: (Subst, Int) -> Option[Type] = (s, id) -> {
  let mut cur = s
  let mut out = None
  let mut done = false
  let key = __to_string(id)
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(i, ty, rest) => if i == id {
        out = Some(ty)
        done = true
      } else {
        cur = rest
      }
      ,
      SubstBound(_, _, rest) => {
        cur = rest
      },
      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {
        out = Some(Map::get(cache, key))
        done = true
      } else {
        cur = rest
      }
    }
  }
  out
}

export let rec trait_supers: (TypeEnv, String) -> Array[String] = (env, name) -> {
  let empty = Array::slice([
    ""
  ], 0, 0)
  match env {
    EnvEmpty => empty,
    EnvBind(_, _, rest) => trait_supers(rest, name),
    EnvTraitDef(tname, supers, _, rest) => if tname == name {
      supers
    } else trait_supers(rest, name),
    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),
    EnvFlat(_) => empty,
    EnvCached(_, rest) => trait_supers(rest, name)
  }
}

let rec array_has_int: (Array[Int], Int, Int) -> Bool = (arr, val, i) -> {
  if i >= Array::length(arr) {
    false
  }
  else if Array::get(arr, i) == val {
    true
  }
  else array_has_int(arr, val, i + 1)
}

let int_array_has: (Array[Int], Int) -> Bool = (arr, v) -> {
  let slen = Array::length(arr)
  let mut si = 0
  let mut sfound = false
  let mut sdone = false
  while !sdone {
    if si >= slen {
      sdone = true
    } else if Array::get(arr, si) == v {
      sfound = true
      sdone = true
    } else {
      si = si + 1
    }
  }
  sfound
}

export let rec subst_apply: (Subst, Type) -> Type = (s, ty) -> {
  match ty {
    CtInt => ty,
    CtBool => ty,
    CtString => ty,
    CtUnit => ty,
    CtDouble => ty,
    CtChar => ty,
    CtBytes => ty,
    CtUnknown => ty,
    CtVar(_) => {
      let mut cur = ty
      let mut out = ty
      let mut done = false
      let mut seen = Array::slice([
        0
      ], 0, 0)
      while !done {
        match cur {
          CtVar(vid) => if int_array_has(seen, vid) {
            out = cur
            done = true
          } else {
            Array::push(seen, vid)
            match subst_lookup(s, vid) {
              Some(next) => {
                cur = next
                out = next
              },
              None => {
                out = cur
                done = true
              }
            }
          },
          _ => {
            out = subst_apply(s, cur)
            done = true
          }
        }
      }
      out
    },
    CtFn(params, ret, effect_name) => {
      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {
        let out = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut i = 0
        while i < Array::length(items) {
          Array::push(out, subst_apply(s, Array::get(items, i)))
          i = i + 1
        }
        out
      }
      CtFn(apply_params(params), subst_apply(s, ret), effect_name)
    },
    CtArray(elem) => CtArray(subst_apply(s, elem)),
    CtOption(elem) => CtOption(subst_apply(s, elem)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_apply(s, e)
    }),
    CtNamed(name, args) => CtNamed(name, for arg in args {
      subst_apply(s, arg)
    }),
    CtForAll(_, _, _) => ty,
    _ => ty
  }
}

export let rec trait_defined: (TypeEnv, String) -> Bool = (env, name) -> {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => trait_defined(rest, name),
    EnvTraitDef(tname, _, _, rest) => if tname == name {
      true
    } else trait_defined(rest, name),
    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),
    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),
    EnvFlat(_) => false,
    EnvCached(_, rest) => trait_defined(rest, name)
  }
}

export let rec type_to_string: (Type) -> String = (ty) -> {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "()",
    CtBytes => "Bytes",
    CtVar(id) => "?t\{id}",
    CtForAll(vars, _, body) => {
      let vlen = Array::length(vars)
      let mut vi = 0
      let mut vacc = ""
      while vi < vlen {
        let v = String::concat("?t", __to_string(Array::get(vars, vi)))
        let next = if vi > 0 {
          String::concat(vacc, String::concat(" ", v))
        } else v
        vacc = next
        vi = vi + 1
      }
      String::concat("forall ", String::concat(vacc, String::concat(". ", type_to_string(body))))
    },
    CtUnknown => "?",
    CtArray(elem) => String::concat("Array[", String::concat(type_to_string(elem), "]")),
    CtOption(elem) => String::concat("Option[", String::concat(type_to_string(elem), "]")),
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        type_to_string(arg)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, i)))
        } else Array::get(parts, i)
        i = i + 1
      }
      String::concat(name, String::concat("[", String::concat(joined, "]")))
    },
    CtTuple(elems) => {
      let parts = for e in elems {
        type_to_string(e)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, i)))
        } else Array::get(parts, i)
        i = i + 1
      }
      String::concat("(", String::concat(joined, ")"))
    },
    CtFn(params, ret, effect_name) => {
      let parts = for p in params {
        type_to_string(p)
      }
      let mut i = 0
      let mut joined = ""
      while i < Array::length(parts) {
        joined = if i > 0 {
          String::concat(joined, String::concat(", ", Array::get(parts, i)))
        } else Array::get(parts, i)
        i = i + 1
      }
      let ret_text = type_to_string(ret)
      let base = String::concat("(", String::concat(joined, String::concat(") -> ", ret_text)))
      match effect_name {
        Some(name) => String::concat(base, String::concat(" with {", String::concat(name, "}"))),
        None => base
      }
    }
  }
}

let empty_type_args: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

export let env_lookup_flat: (Array[(String, Type)], String) -> Option[Type] = (bindings, name) -> {
  let len = Array::length(bindings)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (n, ty) = Array::get(bindings, i)
      if n == name {
        result = Some(ty)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}

export let resolve_builtin: (String) -> Option[Type] = (name) -> {
  if name == "Int" || name == "i32" {
    Some(CtInt)
  }
  else if name == "Double" || name == "f64" || name == "Float" || name == "f32" {
    Some(CtDouble)
  }
  else if name == "Bool" {
    Some(CtBool)
  }
  else if name == "String" {
    Some(CtString)
  }
  else if name == "Char" {
    Some(CtChar)
  }
  else if name == "Unit" {
    Some(CtUnit)
  }
  else if name == "Bytes" {
    Some(CtBytes)
  }
  else if name == "i64"
  || name == "u8"
  || name == "u16"
  || name == "u32"
  || name == "u64"
  || name == "i16"
  || name == "v128" {
    Some(CtNamed(name, empty_type_args()))
  }
  else None
}

export let subst_add_bound: (Subst, Int, Array[String]) -> Subst = (s, id, bounds) -> {
  SubstBound(id, bounds, s)
}

let empty_var_bounds: () -> Array[(Int, Array[String])] = () -> {
  Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
}

let rec int_bounds_has_id: (Array[(Int, Array[String])], Int, Int) -> Bool = (pairs, id, i) -> {
  if i >= Array::length(pairs) {
    false
  } else {
    let (pid, _) = Array::get(pairs, i)
    if pid == id {
      true
    } else {
      int_bounds_has_id(pairs, id, i + 1)
    }
  }
}

let rec int_bounds_lookup: (Array[(Int, Array[String])], Int, Int) -> Array[String] = (pairs, id, i) -> {
  if i >= Array::length(pairs) {
    Array::slice([
      ""
    ], 0, 0)
  } else {
    let (pid, bounds) = Array::get(pairs, i)
    if pid == id {
      bounds
    } else {
      int_bounds_lookup(pairs, id, i + 1)
    }
  }
}

let rec int_int_lookup_or: (Array[(Int, Int)], Int, Int, Int) -> Int = (pairs, key, fallback, i) -> {
  if i >= Array::length(pairs) {
    fallback
  } else {
    let (k, v) = Array::get(pairs, i)
    if k == key {
      v
    } else {
      int_int_lookup_or(pairs, key, fallback, i + 1)
    }
  }
}

export let instantiate: (Type, Int) -> (Type, Int, Array[(Int, Array[String])]) = (ty, c) -> {
  match ty {
    CtForAll(bound_vars, var_bounds, body) => {
      let blen = Array::length(bound_vars)
      let id_map = Array::slice([
        (0, 0)
      ], 0, 0)
      let mut bi = 0
      let mut bacc = SubstEmpty
      let mut bnc = c
      while bi < blen {
        let old_id = Array::get(bound_vars, bi)
        Array::push(id_map, (old_id, bnc))
        bacc = SubstBind(old_id, CtVar(bnc), bacc)
        bnc = bnc + 1
        bi = bi + 1
      }
      let inst_s = bacc
      let id_map2 = id_map
      let c1 = bnc
      let new_bounds = Array::slice([
        (0, Array::slice([
          ""
        ], 0, 0))
      ], 0, 0)
      for var_bound in var_bounds {
        let (old_id, bounds) = var_bound
        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)
        Array::push(new_bounds, (new_id, bounds))
      };
      (subst_apply(inst_s, body), c1, new_bounds)
    },
    _ => (ty, c, empty_var_bounds())
  }
}

export let rec trait_is_subtrait: (TypeEnv, String, String) -> Bool = (env, sub, super_name) -> {
  if sub == super_name {
    true
  }
  else {
    let supers = trait_supers(env, sub)
    let slen = Array::length(supers)
    let mut si = 0
    let mut sresult = false
    let mut sdone = false
    while !sdone {
      if si >= slen {
        sdone = true
      } else {
        let s = Array::get(supers, si)
        if s == super_name {
          sresult = true
          sdone = true
        } else if trait_is_subtrait(env, s, super_name) {
          sresult = true
          sdone = true
        } else {
          si = si + 1
        }
      }
    }
    sresult
  }
}

let rec collect_tvars_walk: (Type, Array[Int]) -> Int = (t, out) -> {
  match t {
    CtVar(id) => {
      if !array_has_int(out, id, 0) {
        Array::push(out, id)
      }
      0
    },
    CtFn(params, ret, _) => {
      for p in params {
        let _ = collect_tvars_walk(p, out)
      }
      collect_tvars_walk(ret, out)
    },
    CtArray(elem) => collect_tvars_walk(elem, out),
    CtOption(elem) => collect_tvars_walk(elem, out),
    CtTuple(elems) => {
      for e in elems {
        let _ = collect_tvars_walk(e, out)
      }
      0
    },
    CtForAll(_, _, body) => collect_tvars_walk(body, out),
    _ => 0
  }
}

export let collect_tvars: (Type) -> Array[Int] = (ty) -> {
  let out = Array::slice([
    0
  ], 0, 0)
  let _ = collect_tvars_walk(ty, out)
  out
}

let empty_env_bindings: () -> Array[(String, Type)] = () -> {
  Array::slice([
    ("", CtUnknown)
  ], 0, 0)
}

export let env_flat_bindings: (TypeEnv) -> Array[(String, Type)] = (env) -> {
  match env {
    EnvFlat(bindings) => bindings,
    _ => {
      let out = empty_env_bindings()
      let mut cur = env
      let mut done = false
      while !done {
        match cur {
          EnvEmpty => {
            done = true
          },
          EnvBind(name, ty, rest) => {
            Array::push(out, (name, ty))
            cur = rest
          },
          EnvTraitDef(_, _, _, rest) => {
            cur = rest
          },
          EnvTraitImpl(_, _, rest) => {
            cur = rest
          },
          EnvTraitImplGen(_, _, _, _, rest) => {
            cur = rest
          },
          EnvFlat(bindings) => {
            let mut j = 0
            while j < Array::length(bindings) {
              Array::push(out, Array::get(bindings, j))
              j = j + 1
            }
            done = true
          },
          EnvCached(_, rest) => {
            cur = rest
          }
        }
      }
      out
    }
  }
}

let string_array_equal: (Array[String], Array[String]) -> Bool = (left, right) -> {
  let len = Array::length(left)
  let mut i = 0
  let mut result = true
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else if Array::get(left, i) != Array::get(right, i) {
      result = false
      done = true
    } else {
      i = i + 1
    }
  }
  result
}

let option_string_equal: (Option[String], Option[String]) -> Bool = (left, right) -> {
  match left {
    Some(left_name) => match right {
      Some(right_name) => left_name == right_name,
      None => false
    },
    None => match right {
      Some(_) => false,
      None => true
    }
  }
}

let is_effect_var_name: (String) -> Bool = (name) -> {
  String::length(name) == 1 &&
  String::char_code_at(name, 0) >= 97 &&
  String::char_code_at(name, 0) <= 122
}

let effect_names_compatible: (Option[String], Option[String]) -> Bool = (left, right) -> {
  if option_string_equal(left, right) {
    true
  } else {
    match left {
      Some(left_name) => if is_effect_var_name(left_name) {
        true
      } else {
        match right {
          Some(right_name) => is_effect_var_name(right_name),
          None => false
        }
      },
      None => match right {
        Some(right_name) => is_effect_var_name(right_name),
        None => false
      }
    }
  }
}

export let rec types_equal: (Type, Type) -> Bool = (a, b) -> {
  match a {
    CtInt => match b {
      CtInt => true,
      _ => false
    },
    CtDouble => match b {
      CtDouble => true,
      _ => false
    },
    CtBool => match b {
      CtBool => true,
      _ => false
    },
    CtString => match b {
      CtString => true,
      _ => false
    },
    CtChar => match b {
      CtChar => true,
      _ => false
    },
    CtUnit => match b {
      CtUnit => true,
      _ => false
    },
    CtBytes => match b {
      CtBytes => true,
      _ => false
    },
    CtUnknown => match b {
      CtUnknown => true,
      _ => false
    },
    CtVar(aid) => match b {
      CtVar(bid) => (aid == bid),
      _ => false
    },
    CtArray(aelem) => match b {
      CtArray(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtOption(aelem) => match b {
      CtOption(belem) => types_equal(aelem, belem),
      _ => false
    },
    CtEnum(aname) => match b {
      CtEnum(bname) => aname == bname,
      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,
      _ => false
    },
    CtStruct(aname) => match b {
      CtStruct(bname) => aname == bname,
      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,
      _ => false
    },
    CtNamed(aname, aargs) => match b {
      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,
      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,
      CtNamed(bname, bargs) =>
      if aname != bname {
        false
      } else if Array::length(aargs) != Array::length(bargs) {
        false
      } else {
        let tae_len = Array::length(aargs)
        let mut tae_i = 0
        let mut tae_result = true
        let mut tae_done = false
        while !tae_done {
          if tae_i >= tae_len {
            tae_done = true
          } else {
            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {
              tae_i = tae_i + 1
            } else {
              tae_result = false
              tae_done = true
            }
          }
        }
        tae_result
      },
      _ => false
    },
    CtTuple(aelems) => match b {
      CtTuple(belems) =>
      if Array::length(aelems) != Array::length(belems) {
        false
      } else {
        let tae_len2 = Array::length(aelems)
        let mut tae_i2 = 0
        let mut tae_result2 = true
        let mut tae_done2 = false
        while !tae_done2 {
          if tae_i2 >= tae_len2 {
            tae_done2 = true
          } else {
            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {
              tae_i2 = tae_i2 + 1
            } else {
              tae_result2 = false
              tae_done2 = true
            }
          }
        }
        tae_result2
      },
      _ => false
    },
    CtFn(aparams, aret, aeffect) => match b {
      CtFn(bparams, bret, beffect) =>
      if Array::length(aparams) != Array::length(bparams) {
        false
      } else if effect_names_compatible(aeffect, beffect) {
        let tae_len3 = Array::length(aparams)
        let mut tae_i3 = 0
        let mut tae_result3 = true
        let mut tae_done3 = false
        while !tae_done3 {
          if tae_i3 >= tae_len3 {
            tae_done3 = true
          } else {
            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {
              tae_i3 = tae_i3 + 1
            } else {
              tae_result3 = false
              tae_done3 = true
            }
          }
        }
        if tae_result3 {
          types_equal(aret, bret)
        } else {
          false
        }
      } else {
        false
      },
      _ => false
    },
    CtForAll(avars, abounds, abody) => match b {
      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {
        false
      } else if Array::length(abounds) != Array::length(bbounds) {
        false
      } else {
        let vlen = Array::length(avars)
        let mut vi = 0
        let mut vresult = true
        let mut vdone = false
        while !vdone {
          if vi >= vlen {
            vdone = true
          } else if Array::get(avars, vi) != Array::get(bvars, vi) {
            vresult = false
            vdone = true
          } else {
            vi = vi + 1
          }
        }
        if vresult {
          let fbe_len = Array::length(abounds)
          let mut fbe_i = 0
          let mut fbe_result = true
          let mut fbe_done = false
          while !fbe_done {
            if fbe_i >= fbe_len {
              fbe_done = true
            } else {
              let (lvar, lbounds) = Array::get(abounds, fbe_i)
              let (rvar, rbounds) = Array::get(bbounds, fbe_i)
              if lvar != rvar {
                fbe_result = false
                fbe_done = true
              } else if Array::length(lbounds) != Array::length(rbounds) {
                fbe_result = false
                fbe_done = true
              } else {
                if string_array_equal(lbounds, rbounds) {
                  fbe_i = fbe_i + 1
                } else {
                  fbe_result = false
                  fbe_done = true
                }
              }
            }
          }
          if fbe_result {
            types_equal(abody, bbody)
          } else {
            false
          }
        } else {
          false
        }
      }
      ,
      _ => false
    }
  }
}

export let rec unify: (Type, Type, Subst) -> Option[Subst] = (a, b, s) -> {
  let ta = subst_apply(s, a)
  let tb = subst_apply(s, b)
  if types_equal(ta, tb) {
    Some(s)
  }
  else match ta {
    CtVar(id) => if occurs_in(id, tb) {
      None
    } else Some(SubstBind(id, tb, s)),
    _ => match tb {
      CtVar(id) => if occurs_in(id, ta) {
        None
      } else Some(SubstBind(id, ta, s)),
      _ => match ta {
        CtUnknown => Some(s),
        _ => match tb {
          CtUnknown => Some(s),
          _ => match ta {
            CtForAll(_, _, body_a) => match tb {
              CtForAll(_, _, body_b) => unify(body_a, body_b, s),
              _ => unify(body_a, tb, s)
            },
            _ => match tb {
              CtForAll(_, _, body_b) => unify(ta, body_b, s),
              _ => match ta {
                CtArray(ea) => match tb {
                  CtArray(eb) => unify(ea, eb, s),
                  _ => None
                },
                CtOption(ea) => match tb {
                  CtOption(eb) => unify(ea, eb, s),
                  _ => None
                },
                CtFn(pa, ra, aeffect) => match tb {
                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {
                    None
                  }
                  else if !effect_names_compatible(aeffect, beffect) {
                    None
                  }
                  else {
                    let ul_len = Array::length(pa)
                    let mut ul_i = 0
                    let mut ul_acc = s
                    let mut ul_result = Some(s)
                    let mut ul_done = false
                    while !ul_done {
                      if ul_i >= ul_len {
                        ul_result = Some(ul_acc)
                        ul_done = true
                      } else {
                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {
                          Some(s2) => {
                            ul_acc = s2
                            ul_i = ul_i + 1
                          },
                          None => {
                            ul_result = None
                            ul_done = true
                          }
                        }
                      }
                    }
                    match ul_result {
                      Some(s2) => unify(ra, rb, s2),
                      None => None
                    }
                  },
                  _ => None
                },
                CtTuple(ea) => match tb {
                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {
                    None
                  }
                  else {
                    let ul_len2 = Array::length(ea)
                    let mut ul_i2 = 0
                    let mut ul_acc2 = s
                    let mut ul_result2 = Some(s)
                    let mut ul_done2 = false
                    while !ul_done2 {
                      if ul_i2 >= ul_len2 {
                        ul_result2 = Some(ul_acc2)
                        ul_done2 = true
                      } else {
                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {
                          Some(s2) => {
                            ul_acc2 = s2
                            ul_i2 = ul_i2 + 1
                          },
                          None => {
                            ul_result2 = None
                            ul_done2 = true
                          }
                        }
                      }
                    }
                    ul_result2
                  },
                  _ => None
                },
                CtEnum(a_name) => match tb {
                  CtEnum(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  CtNamed(b_name, _) => if a_name == b_name {
                    Some(s)
                  } else None,
                  _ => None
                },
                CtStruct(a_name) => match tb {
                  CtStruct(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  CtNamed(b_name, b_args) => if a_name == b_name && Array::length(b_args) == 0 {
                    Some(s)
                  } else None,
                  _ => None
                },
                CtNamed(a_name, a_args) => match tb {
                  CtEnum(b_name) => if a_name == b_name {
                    Some(s)
                  } else None,
                  CtStruct(b_name) => if a_name == b_name && Array::length(a_args) == 0 {
                    Some(s)
                  } else None,
                  CtNamed(b_name, b_args) => if a_name != b_name {
                    None
                  }
                  else if Array::length(a_args) != Array::length(b_args) {
                    None
                  }
                  else {
                    let ul_len3 = Array::length(a_args)
                    let mut ul_i3 = 0
                    let mut ul_acc3 = s
                    let mut ul_result3 = Some(s)
                    let mut ul_done3 = false
                    while !ul_done3 {
                      if ul_i3 >= ul_len3 {
                        ul_result3 = Some(ul_acc3)
                        ul_done3 = true
                      } else {
                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {
                          Some(s2) => {
                            ul_acc3 = s2
                            ul_i3 = ul_i3 + 1
                          },
                          None => {
                            ul_result3 = None
                            ul_done3 = true
                          }
                        }
                      }
                    }
                    ul_result3
                  },
                  _ => None
                },
                _ => None
              }
            }
          }
        }
      }
    }
  }
}

export let types_compatible: (Type, Type) -> Bool = (expected, actual) -> {
  match expected {
    CtUnknown => true,
    _ => match actual {
      CtUnknown => true,
      _ => types_equal(expected, actual)
    }
  }
}

export let rec impls_overlap_for: (TypeEnv, String, Type) -> Bool = (env, trait_name, new_target) -> {
  match env {
    EnvEmpty => false,
    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      if types_equal(target, new_target) {
        true
      }
      else impls_overlap_for(rest, trait_name, new_target)
    } else impls_overlap_for(rest, trait_name, new_target),
    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),
    EnvFlat(_) => false,
    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)
  }
}

let rec type_implements_check_env: (TypeEnv, String, Type) -> Bool = (e, trait_name, resolved) -> {
  match e {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),
    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),
    EnvTraitImpl(tname, target, rest) => if tname == trait_name {
      if types_equal(target, resolved) {
        true
      }
      else type_implements_check_env(rest, trait_name, resolved)
    } else type_implements_check_env(rest, trait_name, resolved),
    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),
    EnvFlat(_) => false,
    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)
  }
}

let collect_subst_bounds_pairs: (Subst) -> Array[(Int, Array[String])] = (s) -> {
  let out = Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let mut cur = s
  let mut done = false
  while !done {
    match cur {
      SubstEmpty => {
        done = true
      },
      SubstBind(_, _, rest) => {
        cur = rest
      },
      SubstBound(id, bounds, rest) => {
        if !int_bounds_has_id(out, id, 0) {
          Array::push(out, (id, bounds))
        }
        cur = rest
      },
      SubstCached(_, _, rest) => {
        cur = rest
      }
    }
  }
  out
}

export let generalize: (Subst, Type) -> Type = (s, ty) -> {
  let resolved = subst_apply(s, ty)
  let tvars = collect_tvars(resolved)
  if Array::length(tvars) == 0 {
    resolved
  }
  else {
    let bounds_pairs = collect_subst_bounds_pairs(s)
    let var_bounds = Array::slice([
      (0, Array::slice([
        ""
      ], 0, 0))
    ], 0, 0)
    for vid in tvars {
      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)
      if Array::length(bounds) != 0 {
        Array::push(var_bounds, (vid, bounds))
      }
    }
    CtForAll(tvars, var_bounds, resolved)
  }
}

let rec type_implements_check_super: (TypeEnv, TypeEnv, String, Type) -> Bool = (e2, full_env, trait_name, resolved) -> {
  match e2 {
    EnvEmpty => false,
    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {
      if trait_is_subtrait(full_env, tname, trait_name) {
        true
      }
      else type_implements_check_super(rest, full_env, trait_name, resolved)
    } else type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),
    EnvFlat(_) => false,
    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)
  }
}

export let rec type_implements_trait: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, trait_name) -> {
  let resolved = subst_apply(s, ty)
  if type_implements_check_env(env, trait_name, resolved) {
    true
  }
  else {
    let supers = trait_supers(env, trait_name)
    let slen = Array::length(supers)
    if slen == 0 {
      false
    }
    else {
      type_implements_check_super(env, env, trait_name, resolved)
    }
  }
}





export let version = "0.0.1"



export {
  Type, Subst, unify, TypeDef, TypeEnv, env_bind, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, env_cache, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait
}

export {
  Type, Subst, unify, TypeDef, TypeEnv, env_bind, env_cache, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait
}



let one_super: (String) -> Array[String] = (name) -> {
  [
    name
  ]
}

let no_type_args: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

export let satisfies_bound: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, bound) -> {
  type_implements_trait(env, s, ty, bound)
}

export let check_bounds_satisfied: (TypeEnv, Subst, Type, Array[String]) -> Array[String] = (env, s, ty, bounds) -> {
  let result = empty_strings()
  let len = Array::length(bounds)
  let rec go: (Int) -> Int = (i) -> {
    if i >= len {
      0
    } else {
      let bound = Array::get(bounds, i)
      if not(satisfies_bound(env, s, ty, bound)) {
        Array::push(result, bound)
      }
      go(i + 1)
    }
  }
  let _ = go(0)
  result
}

export let register_builtin_traits: (TypeEnv) -> TypeEnv = (env) -> {
  let no_supers = empty_strings()
  let eq_supers = one_super("Eq")
  let i64_type = CtNamed("i64", no_type_args())
  let u8_type = CtNamed("u8", no_type_args())
  let u16_type = CtNamed("u16", no_type_args())
  let u32_type = CtNamed("u32", no_type_args())
  let u64_type = CtNamed("u64", no_type_args())
  let i16_type = CtNamed("i16", no_type_args())
  let e1 = EnvTraitDef("Eq", no_supers, false, env)
  let e2 = EnvTraitDef("Ord", eq_supers, false, e1)
  let e3 = EnvTraitDef("Add", no_supers, false, e2)
  let e4 = EnvTraitDef("Sub", no_supers, false, e3)
  let e5 = EnvTraitDef("Mul", no_supers, false, e4)
  let e6 = EnvTraitDef("Div", no_supers, false, e5)
  let e7 = EnvTraitImpl("Eq", CtInt, e6)
  let e8 = EnvTraitImpl("Eq", CtDouble, e7)
  let e9 = EnvTraitImpl("Eq", CtString, e8)
  let e10 = EnvTraitImpl("Eq", CtBool, e9)
  let e11 = EnvTraitImpl("Ord", CtInt, e10)
  let e12 = EnvTraitImpl("Ord", CtDouble, e11)
  let e13 = EnvTraitImpl("Ord", CtString, e12)
  let e14 = EnvTraitImpl("Add", CtInt, e13)
  let e15 = EnvTraitImpl("Add", CtDouble, e14)
  let e16 = EnvTraitImpl("Sub", CtInt, e15)
  let e17 = EnvTraitImpl("Sub", CtDouble, e16)
  let e18 = EnvTraitImpl("Mul", CtInt, e17)
  let e19 = EnvTraitImpl("Mul", CtDouble, e18)
  let e20 = EnvTraitImpl("Div", CtInt, e19)
  let e21 = EnvTraitImpl("Div", CtDouble, e20)
  let e22 = EnvTraitImpl("Eq", i64_type, e21)
  let e23 = EnvTraitImpl("Eq", u8_type, e22)
  let e24 = EnvTraitImpl("Eq", u16_type, e23)
  let e25 = EnvTraitImpl("Eq", u32_type, e24)
  let e26 = EnvTraitImpl("Eq", u64_type, e25)
  let e27 = EnvTraitImpl("Eq", i16_type, e26)
  let e28 = EnvTraitImpl("Ord", i64_type, e27)
  let e29 = EnvTraitImpl("Ord", u8_type, e28)
  let e30 = EnvTraitImpl("Ord", u16_type, e29)
  let e31 = EnvTraitImpl("Ord", u32_type, e30)
  let e32 = EnvTraitImpl("Ord", u64_type, e31)
  let e33 = EnvTraitImpl("Ord", i16_type, e32)
  let e34 = EnvTraitImpl("Add", i64_type, e33)
  let e35 = EnvTraitImpl("Add", u8_type, e34)
  let e36 = EnvTraitImpl("Add", u16_type, e35)
  let e37 = EnvTraitImpl("Add", u32_type, e36)
  let e38 = EnvTraitImpl("Add", u64_type, e37)
  let e39 = EnvTraitImpl("Add", i16_type, e38)
  let e40 = EnvTraitImpl("Sub", i64_type, e39)
  let e41 = EnvTraitImpl("Sub", u8_type, e40)
  let e42 = EnvTraitImpl("Sub", u16_type, e41)
  let e43 = EnvTraitImpl("Sub", u32_type, e42)
  let e44 = EnvTraitImpl("Sub", u64_type, e43)
  let e45 = EnvTraitImpl("Sub", i16_type, e44)
  let e46 = EnvTraitImpl("Mul", i64_type, e45)
  let e47 = EnvTraitImpl("Mul", u8_type, e46)
  let e48 = EnvTraitImpl("Mul", u16_type, e47)
  let e49 = EnvTraitImpl("Mul", u32_type, e48)
  let e50 = EnvTraitImpl("Mul", u64_type, e49)
  let e51 = EnvTraitImpl("Mul", i16_type, e50)
  let e52 = EnvTraitImpl("Div", i64_type, e51)
  let e53 = EnvTraitImpl("Div", u8_type, e52)
  let e54 = EnvTraitImpl("Div", u16_type, e53)
  let e55 = EnvTraitImpl("Div", u32_type, e54)
  let e56 = EnvTraitImpl("Div", u64_type, e55)
  let e57 = EnvTraitImpl("Div", i16_type, e56)
  e57
}

export let validate_supers_defined: (TypeEnv, Array[String]) -> Array[String] = (env, supers) -> {
  let result = empty_strings()
  let len = Array::length(supers)
  let rec go: (Int) -> Int = (i) -> {
    if i >= len {
      0
    } else {
      let name = Array::get(supers, i)
      if not(trait_defined(env, name)) {
        Array::push(result, name)
      }
      go(i + 1)
    }
  }
  let _ = go(0)
  result
}

export let validate_impl_no_overlap: (TypeEnv, String, Type) -> Bool = (env, trait_name, target) -> {
  not(impls_overlap_for(env, trait_name, target))
}

export let canonical_builtin_name: (String) -> String = (name) -> {
  match name {
    "Fs::ReadFile" => "Fs::read_file",
    "Fs::WriteFile" => "Fs::write_file",
    "Fs::ReadBytes" => "Fs::read_bytes",
    "Fs::WriteBytes" => "Fs::write_bytes",
    "Fs::Exists" => "Fs::exists",
    "Fs::StatToken" => "Fs::stat_token",
    "Fs::ReadDir" => "Fs::readdir",
    "Fs::IsDir" => "Fs::is_dir",
    "Fs::IsFile" => "Fs::is_file",
    "Fs::Mkdir" => "Fs::mkdir",
    "Fs::Getcwd" => "Fs::getcwd",
    "Fs::Chdir" => "Fs::chdir",
    "Fs::Remove" => "Fs::remove",
    "Fs::Copy" => "Fs::copy",
    "Fs::Append" => "Fs::append",
    "Env::Get" => "Env::get",
    "Env::ArgsLen" => "Env::args_len",
    "Env::ArgsGet" => "Env::args_get",
    "Profiler::NowUs" => "Profiler::now_us",
    _ => name
  }
}



let array_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let array_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = array_no_params()
  Array::push(arr, a)
  arr
}

let array_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let array_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_array_get: (String) -> Option[Type] = (name) -> {
  if name == "Array::get" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))
  }
  else None
}

let lookup_array_new: (String) -> Option[Type] = (name) -> {
  if name == "array_new" {
    Some(CtFn(array_no_params(), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_set: (String) -> Option[Type] = (name) -> {
  if name == "Array::set" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_array_push: (String) -> Option[Type] = (name) -> {
  if name == "Array::push" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_array_slice: (String) -> Option[Type] = (name) -> {
  if name == "Array::slice" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_concat: (String) -> Option[Type] = (name) -> {
  if name == "Array::concat" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_map: (String) -> Option[Type] = (name) -> {
  if name == "Array::map" {
    Some(CtFn(
      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnknown, None)),
      CtArray(CtUnknown),
      None
    ))
