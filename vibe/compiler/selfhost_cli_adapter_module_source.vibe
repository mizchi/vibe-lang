let op_i32_eqz = 69
let op_i32_mul = 108
let op_i32_sub = 107
export let emit_i32_eq: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_eq)
}
export let emit_i32_ne: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_ne)
}
export let rec lookup_ctor: (Array[String], String, Int) -> Int = (ctor_names, name, i) -> {
  if i >= Array::length(ctor_names) {
    -1
  }
  else if Array::get(ctor_names, i) == name {
    i
  }
  else lookup_ctor(ctor_names, name, i + 1)
}
let op_i32_ge_u = 79
let op_i32_gt_u = 75
let op_i64_load = 41
export let emit_i32_eqz: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_eqz)
}
export let emit_i32_mul: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_mul)
}
export let emit_i32_sub: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_sub)
}
export let emit_str_ref: (Bytes, Int, Int) -> Unit = (buf, offset, length) -> {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}
export let get_efn_body: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EFn(_, _, _, _, _, body) => body,
    _ => throw("not EFn")
  }
}
export let get_eif_cond: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EIf(c, _, _) => c,
    _ => throw("not EIf")
  }
}
export let get_eif_else: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EIf(_, _, e) => e,
    _ => throw("not EIf")
  }
}
export let get_eif_then: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EIf(_, t, _) => t,
    _ => throw("not EIf")
  }
}
export let get_elet_val: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    ELet(_, val, _) => val,
    _ => throw("not ELet")
  }
}
export let is_ctor_call: (Expr, CtorTable) -> Bool = (value, ct) -> {
  match value {
    ECall(callee, _, _) => match callee {
      EIdent(nm, _) => lookup_ctor(ct.names, nm, 0) >= 0,
      _ => false
    },
    _ => false
  }
}
let op_i64_store = 55
export let resolve_func: (FuncTable, String) -> (Int, Int, Int) with { Error } = (ft, name) -> {
  let len = Array::length(ft.names)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(ft.names, i) == name {
      found = i
      i = len
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("undefined function: ", name))
  };
  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))
}
export let emit_binop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {
  if op == "+" {
    emit_i64_add(buf)
  }
  else if op == "-" {
    emit_i64_sub(buf)
  }
  else if op == "*" {
    emit_i64_mul(buf)
  }
  else if op == "/" {
    emit_i64_div_s(buf)
  }
  else if op == "%" {
    emit_i64_rem_s(buf)
  }
  else if op == "&" {
    emit_i64_and(buf)
  }
  else if op == "|" {
    emit_i64_or(buf)
  }
  else if op == "^" {
    emit_i64_xor(buf)
  }
  else if op == "<<" {
    emit_i64_shl(buf)
  }
  else if op == ">>" {
    emit_i64_shr_s(buf)
  }
  else if op == "==" {
    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "!=" {
    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<" {
    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">" {
    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "<=" {
    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == ">=" {
    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)
  }
  else if op == "&&" {
    emit_i64_and(buf)
  }
  else if op == "||" {
    emit_i64_or(buf)
  }
  else {
    throw(String::concat("unsupported binop: ", op))
  }
}
export let emit_i32_ge_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_ge_u)
}
export let emit_i32_gt_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i32_gt_u)
}
export let emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, op_i64_load)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}
export let get_ebinop_op: (Expr) -> String with { Error } = (expr) -> {
  match expr {
    EBinOp(op, _, _) => op,
    _ => throw("not EBinOp")
  }
}
export let get_elet_body: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    ELet(_, _, body) => body,
    _ => throw("not ELet")
  }
}
export let get_elet_name: (Expr) -> String with { Error } = (expr) -> {
  match expr {
    ELet(name, _, _) => name,
    _ => throw("not ELet")
  }
}
export let get_slet_expr: (Stmt) -> Expr with { Error } = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, expr) => expr,
    _ => throw("not SLet")
  }
}
export let get_slet_name: (Stmt) -> String with { Error } = (stmt) -> {
  match stmt {
    SLet(_, _, name, _, _) => name,
    _ => throw("not SLet")
  }
}
export let get_slet_type: (Stmt) -> Option[TypeExpr] = (stmt) -> {
  match stmt {
    SLet(_, _, _, ty, _) => ty,
    _ => None
  }
}
export let resolve_local: (Array[String], String, String) -> Int with { Error } = (names, name, tag) -> {
  let mut i = Array::length(names) - 1
  let mut result = -1
  while i >= 0 {
    if Array::get(names, i) == name {
      result = i
      i = -1
    } else {
      i = i - 1
    }
  }
  if result < 0 {
    throw(String::concat(String::concat("undefined variable (local): ", name), String::concat(" @", tag)))
  }
  result
}
export let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, op_i64_store)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}
export let emit_box_float: (Bytes, CompileCtx, Int, Int) -> Unit = (buf, ctx, bits_local, box_local) -> {
  emit_local_set(buf, bits_local)
  emit_i64_const(buf, 16)
  emit_call(buf, ctx.rc_alloc_func_idx)
  emit_local_set(buf, box_local)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_store(buf, 2, 0)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 1)
  emit_i32_store(buf, 2, 4)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, bits_local)
  emit_i64_store(buf, 3, 8)
  emit_local_get(buf, box_local)
  emit_i64_const(buf, 8)
  emit_i64_add(buf)
  emit_i64_const(buf, 1)
  emit_i64_or(buf)
}
export let emit_unbox_float: (Bytes) -> Unit = (buf) -> {
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 3, 0)
}
export let fn_type_param_types: (Option[TypeExpr]) -> Option[Array[TypeExpr]] = (ty) -> {
  match ty {
    Some(t) =>
    match t {
      TyFn(args, _, _) => Some(args),
      _ => None
    },
    None => None
  }
}
export let is_nullary_ctor_ident: (Expr, CtorTable) -> Bool = (value, ct) -> {
  match value {
    EIdent(nm, _) => lookup_ctor(ct.names, nm, 0) >= 0,
    _ => false
  }
}
export let name_has_effect_prefix: (String, String) -> Bool = (full, eff) -> {
  let el = String::length(eff)
  let fl = String::length(full)
  if fl < el + 2 {
    false
  } else {
    let mut ok = true
    let mut j = 0
    while j < el {
      if String::char_code_at(full, j) != String::char_code_at(eff, j) {
        ok = false
        j = el
      } else {
        j = j + 1
      }
    }
    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58
  }
}
export let effect_name_to_tag: (Array[String], String) -> Int = (effect_names, full) -> {
  let n = Array::length(effect_names)
  let mut result = 3 + n
  let mut i = 0
  while i < n {
    if name_has_effect_prefix(full, Array::get(effect_names, i)) {
      result = 3 + i
      i = n
    } else {
      i = i + 1
    }
  }
  result
}
export let effect_op_declared_arity: (Array[String], Array[Int], String) -> Int = (keys, arities, full) -> {
  let n = Array::length(keys)
  let mut result = -1
  let mut i = 0
  while i < n {
    if Array::get(keys, i) == full {
      result = Array::get(arities, i)
      i = n
    } else {
      i = i + 1
    }
  }
  result
}
export let emit_heap_grow_after_heap_set: (Bytes, CompileCtx) -> Unit = (buf, ctx) -> {
  if ctx.heap_grow_check_func_idx >= 0 {
    emit_call(buf, ctx.heap_grow_check_func_idx)
  } else {
    ()
  }
}
let empty_expr_array: () -> Array[Expr] = () -> {
  Array::slice([
    EUnit
  ], 0, 0)
}
let empty_str_array: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}
let empty_type_exprs: () -> Array[TypeExpr] = () -> {
  Array::slice([
    TyUnit
  ], 0, 0)
}
let method_names_of_sigs: (Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] = (methods) -> {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(methods) {
    let (mname, _, _) = Array::get(methods, i)
    Array::push(out, mname)
    i = i + 1
  }
  out
}
let str_array_contains: (Array[String], String) -> Bool = (arr, val) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == val {
      found = true
      i = Array::length(arr)
    } else {
      i = i + 1
    }
  }
  found
}
let split_qualified: (String) -> Option[(String, String)] = (name) -> {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let member = String::substring(name, idx + 2, String::length(name))
    Some((head, member))
  }
}
let dict_struct_name: (String) -> String = (trait_name) -> {
  String::concat(trait_name, "Dict")
}
let dict_param_name: (String, String) -> String = (trait_name, tparam) -> {
  String::concat("__dict_", String::concat(trait_name, String::concat("_", tparam)))
}
let collect_method_traits: (Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (stmts) -> {
  let out = Array::slice([
    ("", Array::slice([
      ("", empty_type_exprs(), TyUnit)
    ], 0, 0))
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, _, methods) => if Array::length(methods) > 0 {
        Array::push(out, (tname, methods))
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
let collect_trait_supers: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {
  let out = Array::slice([
    ("", empty_str_array())
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      STrait(_, tname, supers, _) => Array::push(out, (tname, supers)),
      _ => ()
    }
    i = i + 1
  }
  out
}
let lookup_supers: (Array[(String, Array[String])], String) -> Array[String] = (supers_map, name) -> {
  let mut i = 0
  let mut result = empty_str_array()
  while i < Array::length(supers_map) {
    let (tname, supers) = Array::get(supers_map, i)
    if tname == name {
      result = supers
      i = Array::length(supers_map)
    } else {
      i = i + 1
    }
  }
  result
}
let rec flatten_trait_sigs_into: (String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[String], Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit = (tname, traits_raw, supers_map, acc_names, out) -> {
  let supers = lookup_supers(supers_map, tname)
  let mut s = 0
  while s < Array::length(supers) {
    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)
    s = s + 1
  }
  match lookup_trait_sigs(traits_raw, tname) {
    Some(sigs) => {
      let mut i = 0
      while i < Array::length(sigs) {
        let (mname, params, ret) = Array::get(sigs, i)
        if str_array_contains(acc_names, mname) {
          ()
        } else {
          Array::push(acc_names, mname)
          Array::push(out, (mname, params, ret))
        }
        i = i + 1
      }
    },
    None => ()
  }
}
let flatten_traits: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (traits_raw, supers_map) -> {
  let out = Array::slice([
    ("", Array::slice([
      ("", empty_type_exprs(), TyUnit)
    ], 0, 0))
  ], 0, 0)
  let mut i = 0
  while i < Array::length(traits_raw) {
    let (tname, _) = Array::get(traits_raw, i)
    let acc_names = empty_str_array()
    let flat = Array::slice([
      ("", empty_type_exprs(), TyUnit)
    ], 0, 0)
    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)
    Array::push(out, (tname, flat))
    i = i + 1
  }
  out
}
let lookup_trait_sigs: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] = (traits, name) -> {
  let mut i = 0
  let mut result = None
  while i < Array::length(traits) {
    let (tname, sigs) = Array::get(traits, i)
    if tname == name {
      result = Some(sigs)
      i = Array::length(traits)
    } else {
      i = i + 1
    }
  }
  result
}
let collect_struct_field_sets: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {
  let out = Array::slice([
    ("", empty_str_array())
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, fields, _, _) => {
        let names = empty_str_array()
        let mut j = 0
        while j < Array::length(fields) {
          let (fname, _) = Array::get(fields, j)
          Array::push(names, fname)
          j = j + 1
        }
        Array::push(out, (sname, names))
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
let make_dict_struct_stmt: (String, Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt = (trait_name, sigs) -> {
  let fields = Array::slice([
    ("", TyUnit)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(sigs) {
    let (mname, params, ret) = Array::get(sigs, i)
    Array::push(fields, (mname, TyFn(params, ret, None)))
    i = i + 1
  }
  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array())
}
let field_sets_match: (Array[String], Array[String]) -> Bool = (a, b) -> {
  if Array::length(a) != Array::length(b) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(a) {
      if str_array_contains(b, Array::get(a, i)) {
        i = i + 1
      } else {
        ok = false
        i = Array::length(a)
      }
    }
    ok
  }
}
let lookup_var_type: (Array[(String, String)], String) -> Option[String] = (var_types, name) -> {
  let mut i = 0
  let mut result = None
  while i < Array::length(var_types) {
    let (vn, vt) = Array::get(var_types, i)
    if vn == name {
      result = Some(vt)
      i = Array::length(var_types)
    } else {
      i = i + 1
    }
  }
  result
}
let infer_arg_type_name: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Option[String] = (arg, struct_sets, var_types, fn_returns) -> {
  match arg {
    EInt(_) => Some("Int"),
    EBool(_) => Some("Bool"),
    EString(_) => Some("String"),
    EFloat(_) => Some("Double"),
    EArray(_) => Some("Array"),
    EIdent(name, _) => lookup_var_type(var_types, name),
    ECall(callee, _, _) => match callee {
      EIdent(fname, _) => fn_return_type(fn_returns, fname),
      _ => None
    },
    ERecord(fields) => {
      let names = empty_str_array()
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, _) = Array::get(fields, i)
        Array::push(names, fname)
        i = i + 1
      }
      let mut j = 0
      let mut result = None
      while j < Array::length(struct_sets) {
        let (sname, sfields) = Array::get(struct_sets, j)
        if field_sets_match(names, sfields) {
          result = Some(sname)
          j = Array::length(struct_sets)
        } else {
          j = j + 1
        }
      }
      result
    },
    _ => None
  }
}
let empty_threaded: () -> Array[(String, String, Int)] = () -> {
  Array::slice([
    ("", "", 0)
  ], 0, 0)
}
let empty_dict_binds: () -> Array[(String, String, String, Array[String])] = () -> {
  Array::slice([
    ("", "", "", empty_str_array())
  ], 0, 0)
}
let already_threaded: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {
  if Array::length(params) == 0 {
    false
  } else {
    let (pname, _) = Array::get(params, 0)
    String::starts_with(pname, "__dict_")
  }
}
let find_recv_index: (Array[(String, Option[TypeExpr])], String) -> Int = (params, tp) -> {
  let mut i = 0
  let mut idx = -1
  while i < Array::length(params) {
    let (_, ann) = Array::get(params, i)
    match ann {
      Some(TyName(n)) => if n == tp {
        idx = i
        i = Array::length(params)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  idx
}
let qualified_head: (String) -> String = (name) -> {
  match split_qualified(name) {
    Some(parts) => {
      let (head, _) = parts
      head
    },
    None => ""
  }
}
let collect_generic_impl_types: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let out = empty_str_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {
        let mut has_bound = false
        let mut bi = 0
        while bi < Array::length(tbounds) {
          let (_, bs) = Array::get(tbounds, bi)
          let mut bj = 0
          while bj < Array::length(bs) {
            if Array::get(bs, bj) != "" {
              has_bound = true
            } else {
              ()
            }
            bj = bj + 1
          }
          bi = bi + 1
        }
        if has_bound {
          Array::push(out, type_name)
        } else {
          ()
        }
      } else (),
      _ => ()
    }
    i = i + 1
  }
  out
}
let build_gens: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[String]) -> Array[(String, Array[(String, String, Int)])] = (stmts, traits, gimpl_types) -> {
  let out = Array::slice([
    ("", empty_threaded())
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {
          ()
        } else {
          let threaded = empty_threaded()
          let mut bi = 0
          while bi < Array::length(bounds) {
            let (tp, trait_list) = Array::get(bounds, bi)
            let mut ti = 0
            while ti < Array::length(trait_list) {
              let tr = Array::get(trait_list, ti)
              match lookup_trait_sigs(traits, tr) {
                Some(_) => {
                  let ridx = find_recv_index(params, tp)
                  if ridx >= 0 {
                    Array::push(threaded, (tp, tr, ridx))
                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {
                    Array::push(threaded, (tp, tr, 0 - 1))
                  } else {
                    ()
                  }
                },
                None => ()
              }
              ti = ti + 1
            }
            bi = bi + 1
          }
          if Array::length(threaded) > 0 {
            Array::push(out, (fname, threaded))
          } else {
            ()
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
let lookup_gen: (Array[(String, Array[(String, String, Int)])], String) -> Option[Array[(String, String, Int)]] = (gens, name) -> {
  let mut i = 0
  let mut result = None
  while i < Array::length(gens) {
    let (gname, threaded) = Array::get(gens, i)
    if gname == name {
      result = Some(threaded)
      i = Array::length(gens)
    } else {
      i = i + 1
    }
  }
  result
}
let find_dict_for_method: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, head, member) -> {
  let mut i = 0
  let mut result = None
  while i < Array::length(dict_binds) {
    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)
    if tp == head && str_array_contains(methods, member) {
      result = Some(dict_pname)
      i = Array::length(dict_binds)
    } else {
      i = i + 1
    }
  }
  result
}
let find_dict_for_trait: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, tparam, trait_name) -> {
  let mut i = 0
  let mut result = None
  while i < Array::length(dict_binds) {
    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)
    if tp == tparam && tr == trait_name {
      result = Some(dict_pname)
      i = Array::length(dict_binds)
    } else {
      i = i + 1
    }
  }
  result
}
let first_array_elem: (Expr) -> Option[Expr] = (e) -> {
  match e {
    EArray(elems) => if Array::length(elems) > 0 {
      Some(Array::get(elems, 0))
    } else None,
    _ => None
  }
}
let rec build_concrete_dict: (String, String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[(String, String, Int)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String)], Expr) -> Option[Expr] = (cname, trait_name, traits, gens, struct_sets, var_types, fn_returns, arg_expr) -> {
  match lookup_trait_sigs(traits, trait_name) {
    Some(sigs) => {
      let mnames = method_names_of_sigs(sigs)
      let recfields = Array::slice([
        ("", EUnit)
      ], 0, 0)
      let mut mi = 0
      let mut failed = false
      while mi < Array::length(mnames) {
        let m = Array::get(mnames, mi)
        let qm = String::concat(cname, String::concat("::", m))
        if not(fn_exists(fn_returns, qm)) {
          failed = true
        } else {
        match lookup_gen(gens, qm) {
          Some(threaded) => {
            match first_array_elem(arg_expr) {
              Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {
                Some(en) => {
                  let callargs = empty_expr_array()
                  let mut bi = 0
                  let mut subok = true
                  while bi < Array::length(threaded) {
                    let (_, btrait, _) = Array::get(threaded, bi)
                    match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {
                      Some(sd) => Array::push(callargs, sd),
                      None => {
                        subok = false
                      }
                    }
                    bi = bi + 1
                  }
                  if subok {
                    Array::push(callargs, EIdent("__w", -1))
                    let closure = EFn(empty_str_array(), Array::slice([
                      ("", empty_str_array())
                    ], 0, 0), Array::slice([
                      ("__w", None)
                    ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))
                    Array::push(recfields, (m, closure))
                  } else {
                    failed = true
                  }
                },
                None => {
                  failed = true
                }
              },
              None => {
                failed = true
              }
            }
          },
          None => Array::push(recfields, (m, EIdent(qm, -1)))
        }
        }
        mi = mi + 1
      }
      if failed {
        None
      } else {
        Some(ERecord(recfields))
      }
    },
    None => None
  }
}
let synth_dicts: (Array[(String, String, Int)], Array[Expr], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] = (threaded, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) -> {
  let dicts = empty_expr_array()
  let mut ok = true
  let mut bi = 0
  while bi < Array::length(threaded) {
    let (_, trait_name, recv_idx) = Array::get(threaded, bi)
    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {
      let recv_arg = Array::get(orig_args, recv_idx)
      match infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns) {
        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {
          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),
          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {
            Some(dict) => Array::push(dicts, dict),
            None => {
              ok = false
            }
          }
        },
        None => {
          ok = false
        }
      }
    } else {
      ok = false
    }
    bi = bi + 1
  }
  if ok {
    Some(dicts)
  } else {
    None
  }
}
let concat_expr_arrays: (Array[Expr], Array[Expr]) -> Array[Expr] = (a, b) -> {
  let out = empty_expr_array()
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    Array::push(out, Array::get(b, j))
    j = j + 1
  }
  out
}
let seed_var_types: (Array[(String, Option[TypeExpr])], Array[String], Array[(String, String)]) -> Array[(String, String)] = (params, tparams, base) -> {
  let _ = tparams
  let out = Array::slice([
    ("", "")
  ], 0, 0)
  let mut b = 0
  while b < Array::length(base) {
    Array::push(out, Array::get(base, b))
    b = b + 1
  }
  let mut i = 0
  while i < Array::length(params) {
    let (pname, ann) = Array::get(params, i)
    match ann {
      Some(TyName(tn)) => Array::push(out, (pname, tn)),
      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),
      _ => ()
    }
    i = i + 1
  }
  out
}
let collect_fn_returns: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {
  let out = Array::slice([
    ("", "")
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, _, body) => match body {
        EFn(_, _, _, ret, _, _) => {
          let rn = match ret {
            Some(te) => match te {
              TyName(n) => n,
              TyApp(n, _) => n,
              _ => ""
            },
            None => ""
          }
          Array::push(out, (fname, rn))
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
let fn_exists: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(fn_returns) {
    let (n, _) = Array::get(fn_returns, i)
    if n == fname {
      found = true
      i = Array::length(fn_returns)
    } else {
      i = i + 1
    }
  }
  found
}
let fn_return_type: (Array[(String, String)], String) -> Option[String] = (fn_returns, fname) -> {
  let mut i = 0
  let mut result = None
  while i < Array::length(fn_returns) {
    let (n, rt) = Array::get(fn_returns, i)
    if n == fname {
      result = if String::length(rt) == 0 {
        None
      } else Some(rt)
      i = Array::length(fn_returns)
    } else {
      i = i + 1
    }
  }
  result
}
let build_iter_for_with: (String, Expr, Expr, Expr) -> Expr = (name, nextcall, iter, body) -> {
  let some_arm = (PCtor("Some", [
    PTuple([
      PBind(name),
      PBind("__iter_rest")
    ])
  ]), EAssign("__iter_cur", EIdent("__iter_rest", -1), body))
  let none_arm = (PCtor("None", Array::slice([
    PWild
  ], 0, 0)), EAssign("__iter_go", EBool(false), EUnit))
  let loop_body = EMatch(nextcall, [
    some_arm,
    none_arm
  ])
  ELetMut("__iter_cur", iter, ELetMut("__iter_go", EBool(true), EWhile(EIdent("__iter_go", -1), loop_body)))
}
let next_call_for: (String) -> Expr = (ctype) -> {
  ECall(EIdent(String::concat(ctype, "::next"), -1), [
    EIdent("__iter_cur", -1)
  ], -1)
}
let build_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {
  build_iter_for_with(name, next_call_for(ctype), iter, body)
}
let build_await_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {
  let awaited = ECall(EIdent("await", -1), [
    next_call_for(ctype)
  ], -1)
  build_iter_for_with(name, awaited, iter, body)
}
let build_pull_for_in: (String, Option[String], Expr, Expr) -> Expr = (value_name, index_name, iterable, body) -> {
  let some_arm = match index_name {
    Some(ix) => ESeq(body, EAssign(ix, EBinOp("+", EIdent(ix, -1), EInt(1)), EUnit)),
    None => ESeq(body, EUnit)
  }
  let loop_body = EMatch(ECall(EIdent("__pull_next", -1), Array::slice([
    EUnit
  ], 0, 0), -1), [
    (PCtor("Some", [
      PBind(value_name)
    ]), some_arm),
    (PCtor("None", Array::slice([
      PWild
    ], 0, 0)), EAssign("__pull_continue", EBool(false), EUnit))
  ])
  let core_loop = ELetMut("__pull_continue", EBool(true), EWhile(EIdent("__pull_continue", -1), loop_body))
  let with_index = match index_name {
    Some(ix) => ELetMut(ix, EInt(0), core_loop),
    None => core_loop
  }
  ELet("__pull_next", iterable, with_index)
}
let for_await_inner: (Expr) -> Option[Expr] = (iter) -> {
  match iter {
    ECall(callee, args, _) => match callee {
      EIdent(nm, _) => if nm == "__await_iter" && Array::length(args) == 1 {
        Some(Array::get(args, 0))
      } else {
        None
      },
      _ => None
    },
    _ => None
  }
}
let fn_return_is_future: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {
  match fn_return_type(fn_returns, fname) {
    Some(head) => head == "Future",
    None => false
  }
}
let classify_for_await_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns) -> {
  match infer_arg_type_name(inner, struct_sets, var_types, fn_returns) {
    Some(tn) => if fn_exists(fn_returns, String::concat(tn, "::next")) {
      if fn_return_is_future(fn_returns, String::concat(tn, "::next")) {
        build_await_iter_for(name, tn, rinner, rbody)
      } else {
        build_iter_for(name, tn, rinner, rbody)
      }
    } else {
      build_pull_for_in(name, idx, rinner, rbody)
    },
    None => build_pull_for_in(name, idx, rinner, rbody)
  }
}
let classify_sync_for_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns) -> {
  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {
    Some(tn) => if fn_exists(fn_returns, String::concat(tn, "::next")) {
      build_iter_for(name, tn, riter, rbody)
    } else {
      match fn_return_type(fn_returns, String::concat(tn, "::iter")) {
        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, "::iter"), -1), [
          riter
        ], -1), rbody),
        None => EForIn(name, idx, riter, rbody)
      }
    },
    None => EForIn(name, idx, riter, rbody)
  }
}
let extend_var_types: (Array[(String, String)], String, Option[String]) -> Array[(String, String)] = (var_types, name, inferred) -> {
  match inferred {
    Some(tname) => {
      let out = Array::slice([
        ("", "")
      ], 0, 0)
      let mut i = 0
      while i < Array::length(var_types) {
        Array::push(out, Array::get(var_types, i))
        i = i + 1
      }
      Array::push(out, (name, tname))
      out
    },
    None => var_types
  }
}
let rec rewrite_expr: (Expr, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, gens, traits, struct_sets, dict_binds, var_types, fn_returns) -> {
  match expr {
    EIdent(name, off) => match split_qualified(name) {
      Some(parts) => {
        let (head, member) = parts
        match find_dict_for_method(dict_binds, head, member) {
          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1),
          None => expr
        }
      },
      None => expr
    },
    ECall(callee, args, off) => {
      let rwargs = for a in args {
        rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      }
      match callee {
        EIdent(name, coff) => {
          let as_method = match split_qualified(name) {
            Some(parts) => {
              let (head, member) = parts
              find_dict_for_method(dict_binds, head, member)
            },
            None => None
          }
          match as_method {
            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1), rwargs, off),
            None => match lookup_gen(gens, name) {
              Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {
                Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),
                None => ECall(EIdent(name, coff), rwargs, off)
              },
              None => ECall(EIdent(name, coff), rwargs, off)
            }
          }
        },
        EDot(obj, m, doff) => ECall(EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), m, doff), rwargs, off),
        _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)
      }
    },
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EUnit => expr,
    ESpread(_) => expr,
    EStringInterp(_) => expr,
    ETuple(elems) => ETuple(for e in elems {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }),
    EArray(elems) => EArray(for e in elems {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    }),
    ERecord(fields) => {
      let out = Array::slice([
        ("", EUnit)
      ], 0, 0)
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      ERecord(out)
    },
    EMap(fields) => {
      let out = Array::slice([
        ("", EUnit)
      ], 0, 0)
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELet(name, val, body) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))
      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))
    },
    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELetMut(name, val, body) => {
      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))
      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))
    },
    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EMatch(scrut, arms) => {
      let out = Array::slice([
        (PWild, EUnit)
      ], 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)
    },
    EHandle(scrut, arms) => {
      let out = Array::slice([
        (PWild, EUnit)
      ], 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, b) = Array::get(arms, i)
        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))
        i = i + 1
      }
      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)
    },
    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    ELoop(params, body) => ELoop(for param in params {
      let (name, init) = param
      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))
    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EForIn(name, idx, iter, body) => {
      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
      match for_await_inner(iter) {
        Some(inner) => {
          let rinner = rewrite_expr(inner, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          classify_for_await_loop(name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns)
        },
        None => {
          let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
          if Array::length(traits) == 0 {
            EForIn(name, idx, riter, rbody)
          } else {
            classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)
          }
        }
      }
    },
    EBinOp(op, l, r) => EBinOp(op, rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),
    EDot(obj, field, off) => EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), field, off),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EThrow(e) => EThrow(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),
    EBreak(opt) => match opt {
      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),
      None => expr
    },
    EContinue(exprs) => EContinue(for e in exprs {
      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)
    })
  }
}
let member_of: (String) -> String = (name) -> {
  match split_qualified(name) {
    Some(parts) => {
      let (_, member) = parts
      member
    },
    None => name
  }
}
let dict_binds_of: (Array[(String, String, Int)], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] = (threaded, traits) -> {
  let out = empty_dict_binds()
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let methods = match lookup_trait_sigs(traits, trait_name) {
      Some(sigs) => method_names_of_sigs(sigs),
      None => empty_str_array()
    }
    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))
    i = i + 1
  }
  out
}
let thread_dict_params: (Array[(String, String, Int)], Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (threaded, params) -> {
  let result = Array::slice([
    ("", None)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(threaded) {
    let (tp, trait_name, _) = Array::get(threaded, i)
    let dty = TyApp(dict_struct_name(trait_name), [
      TyName(tp)
    ])
    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(params) {
    Array::push(result, Array::get(params, j))
    j = j + 1
  }
  result
}
let rewrite_stmt: (Stmt, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (stmt, gens, traits, struct_sets, fn_returns) -> {
  let no_binds = empty_dict_binds()
  let no_vars = Array::slice([
    ("", "")
  ], 0, 0)
  match stmt {
    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {
      Some(threaded) => match body {
        EFn(tparams, bounds, params, ret, eff, fbody) => {
          let binds = dict_binds_of(threaded, traits)
          let new_params = thread_dict_params(threaded, params)
          let seeded = seed_var_types(params, tparams, no_vars)
          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)
          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))
        },
        _ => stmt
      },
      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns))
    },
    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),
    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),
    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),
    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),
    SModule(exp, name, body) => SModule(exp, name, for s in body {
      rewrite_stmt(s, gens, traits, struct_sets, fn_returns)
    }),
    _ => stmt
  }
}
let qualified_name: (String, String) -> String = (tname, method) -> {
  String::concat(tname, String::concat("::", method))
}
let top_level_fn_exists: (Array[Stmt], String) -> Bool = (stmts, fname) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => if name == fname {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}
let field_show_expr: (String, TypeExpr) -> Expr = (fname, fty) -> {
  let access = EDot(EIdent("self", -1), fname, -1)
  match fty {
    TyName("String") => access,
    _ => ECall(EIdent("__to_string", -1), [
      access
    ], -1)
  }
}
let concat2: (Expr, Expr) -> Expr = (a, b) -> {
  ECall(EIdent("String::concat", -1), [
    a,
    b
  ], -1)
}
let gen_show_fn: (String, Array[(String, TypeExpr)]) -> Stmt = (tname, fields) -> {
  let segs = empty_expr_array()
  Array::push(segs, EString(String::concat(tname, " { ")))
  let mut i = 0
  while i < Array::length(fields) {
    let (fname, fty) = Array::get(fields, i)
    let sep = if i == 0 {
      ""
    } else ", "
    Array::push(segs, EString(String::concat(sep, String::concat(fname, ": "))))
    Array::push(segs, field_show_expr(fname, fty))
    i = i + 1
  }
  Array::push(segs, EString(" }"))
  let mut body = Array::get(segs, Array::length(segs) - 1)
  let mut j = Array::length(segs) - 2
  while j >= 0 {
    body = concat2(Array::get(segs, j), body)
    j = j - 1
  }
  let params = Array::slice([
    ("self", Some(TyName(tname)))
  ], 0, 1)
  let no_tp = Array::slice([
    ""
  ], 0, 0)
  let no_tb = Array::slice([
    ("", no_tp)
  ], 0, 0)
  SLet(false, false, qualified_name(tname, "to_string"), None, EFn(no_tp, no_tb, params, Some(TyName("String")), None, body))
}
let gen_compare_fn: (String, Array[(String, TypeExpr)]) -> Stmt = (tname, fields) -> {
  let neg_one = 0 - 1
  let mut body = EInt(0)
  let mut i = Array::length(fields) - 1
  while i >= 0 {
    let (fname, _) = Array::get(fields, i)
    let af = EDot(EIdent("a", -1), fname, -1)
    let bf = EDot(EIdent("b", -1), fname, -1)
    body = EIf(EBinOp("<", af, bf), EInt(neg_one), EIf(EBinOp(">", af, bf), EInt(1), body))
    i = i - 1
  }
  let params = Array::slice([
    ("a", Some(TyName(tname))),
    ("b", Some(TyName(tname)))
  ], 0, 2)
  let no_tp = Array::slice([
    ""
  ], 0, 0)
  let no_tb = Array::slice([
    ("", no_tp)
  ], 0, 0)
  SLet(false, false, qualified_name(tname, "compare"), None, EFn(no_tp, no_tb, params, Some(TyName("Int")), None, body))
}
export let desugar_derives: (Array[Stmt]) -> Unit = (stmts) -> {
  let gen = empty_stmt_list()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, name, fields, derives, _) => {
        if str_array_contains(derives, "Show") && !top_level_fn_exists(stmts, qualified_name(name, "to_string")) {
          Array::push(gen, gen_show_fn(name, fields))
        } else {
          ()
        }
        if str_array_contains(derives, "Ord") && !top_level_fn_exists(stmts, qualified_name(name, "compare")) {
          Array::push(gen, gen_compare_fn(name, fields))
        } else {
          ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  let mut g = 0
  while g < Array::length(gen) {
    Array::push(stmts, Array::get(gen, g))
    g = g + 1
  }
}
let empty_stmt_list: () -> Array[Stmt] = () -> {
  Array::slice([
    SExport([
      ""
    ])
  ], 0, 0)
}
let struct_decl_exists: (Array[Stmt], String) -> Bool = (stmts, name) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(_, sname, _, _, _) => if sname == name {
        found = true
        i = Array::length(stmts)
      } else {
        i = i + 1
      },
      _ => {
        i = i + 1
      }
    }
  }
  found
}
export let desugar_trait_dicts: (Array[Stmt]) -> Unit = (stmts) -> {
  desugar_derives(stmts)
  let traits_raw = collect_method_traits(stmts)
  let supers_map = collect_trait_supers(stmts)
  let traits = flatten_traits(traits_raw, supers_map)
  let struct_sets = collect_struct_field_sets(stmts)
  let fn_returns = collect_fn_returns(stmts)
  let gimpl_types = collect_generic_impl_types(stmts)
  let gens = build_gens(stmts, traits, gimpl_types)
  let mut i = 0
  while i < Array::length(stmts) {
    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns))
    i = i + 1
  }
  if Array::length(traits_raw) == 0 {
    ()
  } else {
    let mut ti = 0
    while ti < Array::length(traits) {
      let (trait_name, sigs) = Array::get(traits, ti)
      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {
        ()
      } else {
        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))
      }
      ti = ti + 1
    }
  }
}
let op_prefix = 252
export let rec first_offset: (Expr) -> Int = (e) -> {
  match e {
    EIdent(_, off) => off,
    ECall(callee, _, off) => if off >= 0 { off } else { first_offset(callee) },
    EDot(base, _, off) => if off >= 0 { off } else { first_offset(base) },
    EBinOp(_, lhs, _) => first_offset(lhs),
    EUnaryOp(_, inner) => first_offset(inner),
    ELet(_, val, _) => first_offset(val),
    ELetRec(_, val, _) => first_offset(val),
    ELetMut(_, val, _) => first_offset(val),
    EAssign(_, val, _) => first_offset(val),
    EAssignOp(_, _, val, _) => first_offset(val),
    ESeq(first, _) => first_offset(first),
    EIf(cond, _, _) => first_offset(cond),
    EMatch(scrut, _) => first_offset(scrut),
    EThrow(inner) => first_offset(inner),
    EReturn(inner) => first_offset(inner),
    _ => -1
  }
}
export let offset_to_line: (Array[Int], Int) -> Int = (nl, off) -> {
  let n = Array::length(nl)
  let mut i = 0
  let mut count = 0
  while i < n {
    if Array::get(nl, i) < off {
      count = count + 1
    } else {
      ()
    }
    i = i + 1
  }
  count + 1
}
