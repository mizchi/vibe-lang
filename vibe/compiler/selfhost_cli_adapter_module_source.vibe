export let lookup_builtin: (String) -> Option[Type] = (name) -> {
  let normalized = canonical_builtin_name(name)
  match lookup_array(normalized) {
    Some(t) => Some(t),
    None => match lookup_fixed_array(normalized) {
      Some(t) => Some(t),
      None => match lookup_array_builder(normalized) {
        Some(t) => Some(t),
        None => match lookup_string1(normalized) {
          Some(t) => Some(t),
          None => match lookup_string2(normalized) {
            Some(t) => Some(t),
            None => match lookup_string_builder(normalized) {
              Some(t) => Some(t),
              None => match lookup_bytes(normalized) {
                Some(t) => Some(t),
                None => match lookup_map(normalized) {
                  Some(t) => Some(t),
                  None => match lookup_io(normalized) {
                    Some(t) => Some(t),
                    None => match lookup_fs(normalized) {
                      Some(t) => Some(t),
                      None => match lookup_net(normalized) {
                        Some(t) => Some(t),
                        None => match lookup_misc(normalized) {
                          Some(t) => Some(t),
                          None => lookup_async(normalized)
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
export let rec subst_type_params: (Type, Array[String], Array[Type]) -> Type = (ty, params, args) -> {
  match ty {
    CtNamed(name, targs) => {
      let mut idx = 0 - 1
      let mut i = 0
      while i < Array::length(params) {
        if Array::get(params, i) == name {
          idx = i
        }
        i = i + 1
      }
      if idx >= 0 && idx < Array::length(args) {
        Array::get(args, idx)
      } else {
        CtNamed(name, for a in targs {
          subst_type_params(a, params, args)
        })
      }
    },
    CtArray(e) => CtArray(subst_type_params(e, params, args)),
    CtOption(e) => CtOption(subst_type_params(e, params, args)),
    CtTuple(es) => CtTuple(for e in es {
      subst_type_params(e, params, args)
    }),
    CtFn(ps, ret, eff) => {
      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, subst_type_params(Array::get(types, i), params, args))
          i = i + 1
        }
        out
      }
      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)
    },
    _ => ty
  }
}
export let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {
  match te {
    TyUnit => CtUnit,
    TyName(name) => match resolve_builtin(name) {
      Some(t) => t,
      None => match find_typedef(defs, name) {
        Some(td) => match td {
          TDEnum(n, _, _) => CtEnum(n),
          TDStruct(n, _, _) => CtStruct(n),
          TDAlias(_, _, t) => t
        },
        None => CtNamed(name, Array::slice([
          CtUnknown
        ], 0, 0))
      }
    },
    TyApp(name, args) => {
      let ra = for a in args {
        resolve_type_expr(a, defs)
      }
      if name == "Array" {
        if Array::length(ra) == 1 {
          CtArray(Array::get(ra, 0))
        }
        else CtNamed(name, ra)
      } else if name == "Option" {
        if Array::length(ra) == 1 {
          CtOption(Array::get(ra, 0))
        }
        else CtNamed(name, ra)
      } else {
        match find_typedef(defs, name) {
          Some(td) => match td {
            TDAlias(_, params, body) => subst_type_params(body, params, ra),
            _ => CtNamed(name, ra)
          },
          None => CtNamed(name, ra)
        }
      }
    },
    TyTuple(elems) => {
      let r = for e in elems {
        resolve_type_expr(e, defs)
      }
      CtTuple(r)
    },
    TyFn(params, ret, effect_name) => {
      let ret_box = Array::slice([
        ret
      ], 0, 1)
      let rp = for p in params {
        resolve_type_expr(p, defs)
      }
      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)
    }
  }
}
let find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {
  let dlen = Array::length(defs)
  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {
    if di >= dlen {
      None
    } else {
      let d = Array::get(defs, di)
      match d {
        TDEnum(enum_name, _, variants) => {
          let vlen = Array::length(variants)
          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {
            if vi >= vlen {
              go_defs(di + 1)
            } else {
              let (vname, vtypes) = Array::get(variants, vi)
              if vname == ctor_name {
                Some((enum_name, vtypes))
              } else {
                go_variants(vi + 1)
              }
            }
          }
          go_variants(0)
        },
        _ => go_defs(di + 1)
      }
    }
  }
  go_defs(0)
}
export let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef], Array[String]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {
  match pat {
    PWild => env,
    PBind(name) => env_bind(env, name, scrutinee_ty),
    PInt(_) => env,
    PString(_) => env,
    PBool(_) => env,
    PCtor(name, sub_pats) => {
      let builtin_payload = match scrutinee_ty {
        CtOption(elem) => if name == "Some" {
          Some([
            elem
          ])
        } else if name == "None" {
          Some(Array::slice([
            CtUnknown
          ], 0, 0))
        } else {
          None
        },
        _ => None
      }
      let ctor_payload = match builtin_payload {
        Some(types) => Some(("Option", types)),
        None => find_ctor_in_defs(defs, name)
      }
      match ctor_payload {
        Some(info) => {
          let (enum_name, raw_payload) = info
          let payload_types = match scrutinee_ty {
            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {
              Some(td) => match td {
                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {
                  for pt in raw_payload {
                    subst_type_params(pt, eparams, sargs)
                  }
                } else {
                  raw_payload
                },
                _ => raw_payload
              },
              None => raw_payload
            },
            _ => raw_payload
          }
          let splen = Array::length(sub_pats)
          let ptlen = Array::length(payload_types)
          let scalar_scrutinee = match scrutinee_ty {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtString => true,
            CtChar => true,
            CtUnit => true,
            CtBytes => true,
            _ => false
          }
          if scalar_scrutinee {
            Array::push(errors, String::concat("constructor pattern `", String::concat(name, String::concat("` (of ", String::concat(enum_name, ") cannot match a scalar scrutinee")))))
          } else {
            ()
          }
          if enum_name != "Option" && splen != ptlen {
            Array::push(errors, String::concat("constructor pattern `", String::concat(name, String::concat("` expects ", String::concat(__to_string(ptlen), String::concat(" field(s) but binds ", __to_string(splen)))))))
          } else {
            ()
          }
          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let sub_ty = if i < ptlen {
                Array::get(payload_types, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)
              bind_subs(i + 1, next_env)
            }
          }
          bind_subs(0, env)
        },
        None => {
          let splen = Array::length(sub_pats)
          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)
              bind_unknown(i + 1, next_env)
            }
          }
          bind_unknown(0, env)
        }
      }
    },
    PTuple(pats) => {
      let plen = Array::length(pats)
      match scrutinee_ty {
        CtTuple(elem_tys) => {
          let elen = Array::length(elem_tys)
          if plen != elen {
            Array::push(errors, String::concat("tuple pattern binds ", String::concat(__to_string(plen), String::concat(" elements but the value is a ", String::concat(__to_string(elen), "-tuple")))))
          } else {
            ()
          }
          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let et = if i < elen {
                Array::get(elem_tys, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)
              bind_tuple(i + 1, next_env)
            }
          }
          bind_tuple(0, env)
        },
        _ => {
          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)
              bind_unk(i + 1, next_env)
            }
          }
          bind_unk(0, env)
        }
      }
    },
    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),
    PStruct(_, fields) => {
      let flen = Array::length(fields)
      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
        if i >= flen {
          acc_env
        } else {
          let (_, fpat) = Array::get(fields, i)
          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)
          bind_fields(i + 1, next_env)
        }
      }
      bind_fields(0, env)
    }
  }
}
let min_int: (Int, Int) -> Int = (a, b) -> {
  if a < b {
    a
  } else {
    b
  }
}
let off_marker: (Int) -> String = (off) -> {
  if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}
let off_marker_len: (Int, Int) -> String = (off, len) -> {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else {
    off_marker(off)
  }
}
let prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {
  let out = Array::slice([
    EUnit
  ], 0, 0)
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}
let rec subst_self_in_type: (Type, Type) -> Type = (ty, self_ty) -> {
  match ty {
    CtNamed(n, args) => if n == "Self" {
      self_ty
    } else {
      let ra = for a in args {
        subst_self_in_type(a, self_ty)
      }
      CtNamed(n, ra)
    },
    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),
    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_self_in_type(e, self_ty)
    }),
    CtFn(ps, ret, eff) => CtFn(for p in ps {
      subst_self_in_type(p, self_ty)
    }, subst_self_in_type(ret, self_ty), eff),
    _ => ty
  }
}
let rec relax_unknown_named: (Type, Array[TypeDef]) -> Type = (ty, defs) -> {
  match ty {
    CtNamed(n, args) => {
      let known = match find_typedef(defs, n) {
        Some(_) => true,
        None => match resolve_builtin(n) {
          Some(_) => true,
          None => false
        }
      }
      if known {
        CtNamed(n, for a in args {
          relax_unknown_named(a, defs)
        })
      } else {
        CtUnknown
      }
    },
    CtArray(e) => CtArray(relax_unknown_named(e, defs)),
    CtOption(e) => CtOption(relax_unknown_named(e, defs)),
    CtTuple(es) => CtTuple(for e in es {
      relax_unknown_named(e, defs)
    }),
    CtFn(ps, r, eff) => CtFn(for p in ps {
      relax_unknown_named(p, defs)
    }, relax_unknown_named(r, defs), eff),
    _ => ty
  }
}
let resolve_trait_method_ident: (String, TypeEnv, Array[TypeDef], Subst) -> Option[Type] = (name, env, defs, s) -> {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let method = String::substring(name, idx + 2, String::length(name))
    match env_lookup(env, head) {
      Some(head_ty) => match head_ty {
        CtVar(vid) => {
          let bounds = subst_bounds_for(s, vid)
          let self_ty = CtVar(vid)
          let mut result = None
          let mut bi = 0
          while bi < Array::length(bounds) {
            let pending = match result {
              None => true,
              _ => false
            }
            if pending {
              let trait_name = Array::get(bounds, bi)
              match trait_method_sig_deep(env, trait_name, method) {
                Some(sig) => {
                  let (params_te, ret_te) = sig
                  let resolved_params = for pte in params_te {
                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)
                  }
                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)
                  result = Some(CtFn(resolved_params, resolved_ret, None))
                },
                None => ()
              }
            } else {
              ()
            }
            bi = bi + 1
          }
          result
        },
        _ => None
      },
      None => None
    }
  }
}
let expr_ident_name_or_empty: (Expr) -> String = (expr) -> {
  match expr {
    EIdent(name, _) => name,
    _ => ""
  }
}
let rec strip_effects: (Type) -> Type = (ty) -> {
  match ty {
    CtFn(params, ret, _) => {
      let out = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, strip_effects(Array::get(params, i)))
        i = i + 1
      }
      CtFn(out, strip_effects(ret), None)
    },
    CtArray(elem) => CtArray(strip_effects(elem)),
    CtOption(elem) => CtOption(strip_effects(elem)),
    CtTuple(elems) => {
      let out = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, strip_effects(Array::get(elems, i)))
        i = i + 1
      }
      CtTuple(out)
    },
    CtNamed(name, args) => {
      let out = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, strip_effects(Array::get(args, i)))
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => ty
  }
}
let rec type_is_ground: (Type) -> Bool = (t) -> {
  match t {
    CtNamed(_, _) => false,
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground(e),
    CtOption(e) => type_is_ground(e),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}
let rec type_no_named: (Type) -> Bool = (t) -> {
  match t {
    CtNamed(_, _) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_no_named(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_no_named(e),
    CtOption(e) => type_no_named(e),
    CtFn(ps, r, _) => {
      let mut ok = type_no_named(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_no_named(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}
let struct_fields_ground: (Array[(String, Type)]) -> Bool = (dfields) -> {
  let mut ok = true
  let mut i = 0
  while i < Array::length(dfields) {
    let (_, ft) = Array::get(dfields, i)
    if !type_is_ground(ft) {
      ok = false
    }
    i = i + 1
  }
  ok
}
export let check_assignable: (Type, Type, Subst, Array[String], String, Int) -> Subst = (expected, actual, s, errors, what, off) -> {
  match unify(expected, actual, s) {
    Some(su) => su,
    None => {
      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {
        Some(_) => true,
        None => false
      }
      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))
      if structural || !reportable {
        s
      } else {
        Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(", got ", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))
        s
      }
    }
  }
}
let struct_field_names_match: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (declared, actual) -> {
  if Array::length(declared) != Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(declared) {
      let (dn, _) = Array::get(declared, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(actual) {
        let (an, _) = Array::get(actual, j)
        if an == dn {
          found = true
        }
        j = j + 1
      }
      if !found {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}
let lookup_actual_field_ty: (Array[(String, Type)], String) -> Option[Type] = (actual, name) -> {
  let mut i = 0
  let mut out = None
  while i < Array::length(actual) {
    let (an, at) = Array::get(actual, i)
    if an == name {
      out = Some(at)
    }
    i = i + 1
  }
  out
}
let struct_is_strict_superset: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (dfields, actual) -> {
  if Array::length(dfields) <= Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut all_in = true
    while i < Array::length(actual) {
      let (an, _) = Array::get(actual, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(dfields) {
        let (dn, _) = Array::get(dfields, j)
        if dn == an {
          found = true
        } else {
          ()
        }
        j = j + 1
      }
      if !found {
        all_in = false
      } else {
        ()
      }
      i = i + 1
    }
    all_in
  }
}
let check_record_fields: (Array[TypeDef], Array[(String, Type)], Subst, Array[String]) -> Subst = (defs, actual, s, errors) -> {
  let mut matchct = 0
  let mut matched_fields = Array::slice([
    ("", CtUnknown)
  ], 0, 0)
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(_, dfields, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        matched_fields = dfields
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 {
    let mut out = s
    let mut i = 0
    while i < Array::length(matched_fields) {
      let (fname, declared_ty) = Array::get(matched_fields, i)
      match lookup_actual_field_ty(actual, fname) {
        Some(actual_ty) => {
          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat("struct field type mismatch for ", fname), 0 - 1)
        },
        None => ()
      }
      i = i + 1
    }
    out
  } else {
    let mut supct = 0
    let mut sup_name = ""
    let mut sup_fields = Array::slice([
      ("", CtUnknown)
    ], 0, 0)
    let mut dj = 0
    while dj < Array::length(defs) {
      match Array::get(defs, dj) {
        TDStruct(sname, dfields, _) => if struct_is_strict_superset(dfields, actual) {
          supct = supct + 1
          sup_name = sname
          sup_fields = dfields
        },
        _ => ()
      }
      dj = dj + 1
    }
    if supct == 1 {
      let mut fi = 0
      while fi < Array::length(sup_fields) {
        let (dn, _) = Array::get(sup_fields, fi)
        match lookup_actual_field_ty(actual, dn) {
          Some(_) => (),
          None => Array::push(errors, String::concat("missing field `", String::concat(dn, String::concat("` in construction of struct ", sup_name))))
        }
        fi = fi + 1
      }
      s
    } else {
      s
    }
  }
}
let resolve_record_struct_name: (Array[TypeDef], Array[(String, Type)]) -> Option[String] = (defs, actual) -> {
  let mut matchct = 0
  let mut out = None
  let mut ground = false
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(sname, dfields, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        out = Some(sname)
        ground = struct_fields_ground(dfields)
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 && ground {
    out
  } else {
    None
  }
}
let unify_call_args: (Array[Type], Array[Type], Subst, Array[String], String, Int) -> Subst = (param_tys, arg_tys, s, errors, label, off) -> {
  let mut out = s
  let mut ui = 0
  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
  while ui < ul {
    let pty = Array::get(param_tys, ui)
    let aty = Array::get(arg_tys, ui)
    out = if label == "__to_string" {
      match unify(pty, aty, out) {
        Some(su) => su,
        None => out
      }
    } else {
      check_assignable(pty, aty, out, errors, String::concat("argument type mismatch for ", label), off)
    }
    ui = ui + 1
  }
  out
}
export let fn_return_env_name: (String) -> String = (name) -> {
  String::concat("__fn_ret__:", name)
}
let direct_builtin_return: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::length" {
    Some(CtInt)
  }
  else if name == "iter_length" || name == "String::iter_length" || name == "Map::iter_length" {
    Some(CtInt)
  }
  else if name == "Array::length" {
    Some(CtInt)
  }
  else if name == "FixedArray::length" {
    Some(CtInt)
  }
  else if name == "String::length" {
    Some(CtInt)
  }
  else if name == "Bytes::get" || name == "String::index_of" || name == "String::char_code_at" || name == "String::last_index_of" || name == "Char::to_int" || name == "Double::to_int" || name == "Double::to_i64_bits" || name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" || name == "Env::args_len" || name == "Stdin::read_char" {
    Some(CtInt)
  }
  else if name == "String::equals" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "Array::any" || name == "Array::all" || name == "Array::contains" || name == "Map::has_key" || name == "map_has" || name == "Path::is_absolute" || name == "Fs::exists" || name == "Fs::is_dir" || name == "Fs::is_file" || name == "eq" || name == "not" {
    Some(CtBool)
  }
  else if name == "String::concat" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::join" || name == "Array::join" || name == "Path::to_string" || name == "Path::resolve" || name == "PromptText::new" || name == "Stdin::read_stream" || name == "Env::get" || name == "Env::args_get" || name == "Fs::read_file" || name == "Fs::getcwd" || name == "sh" || name == "Lines::stringify" || name == "Llm::complete" || name == "Rlm::run" || name == "Rlm::finalize" || name == "__to_string" {
    Some(CtString)
  }
  else if name == "__len" {
    Some(CtInt)
  }
  else if name == "String::iter_get" {
    Some(CtInt)
  }
  else if name == "iter_get" || name == "Map::iter_get" || name == "iter_require" || name == "__neg" {
    Some(CtUnknown)
  }
  else if name == "Bytes::new" || name == "Bytes::concat" || name == "Bytes::slice" || name == "Bytes::from_array" || name == "Fs::read_bytes" {
    Some(CtBytes)
  }
  else if name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "Array::foreach" || name == "FixedArray::set" || name == "FixedArray::blit" || name == "FixedArray::unsafe_set" || name == "Bytes::set" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "Stdout::write_char" || name == "Stdout::write_stream" || name == "sleep" || name == "Fs::copy" || name == "Fs::chdir" || name == "Fs::mkdir" || name == "Fs::append" || name == "Fs::remove" || name == "Fs::write_file" || name == "Fs::write_bytes" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "assert_eq" || name == "__set_field" {
    Some(CtUnit)
  }
  else if name == "Double::from_i64_bits" || name == "Int::to_double" {
    Some(CtDouble)
  }
  else if name == "Char::from_int" {
    Some(CtChar)
  }
  else if name == "Bytes::to_array" {
    Some(CtArray(CtInt))
  }
  else if name == "Map::keys" || name == "sh_lines" || name == "Lines::parse" {
    Some(CtArray(CtString))
  }
  else if name == "Array::slice" || name == "Array::concat" || name == "Array::filter" || name == "Array::reverse" || name == "Array::sort" || name == "FixedArray::make" {
    Some(CtArray(CtUnknown))
  }
  else if name == "Some" || name == "Array::find" {
    Some(CtOption(CtUnknown))
  }
  else {
    None
  }
}
let direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {
  match env_lookup(env, name) {
    Some(_) => None,
    None => direct_builtin_return(name)
  }
}
let is_logic_binop: (String) -> Bool = (op) -> {
  op == "&&"
  || op == "||"
}
let is_order_binop: (String) -> Bool = (op) -> {
  op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
}
let type_name_prefix: (Type) -> String = (ty) -> {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "Unit",
    CtBytes => "Bytes",
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, _) => name,
    _ => ""
  }
}
let is_equality_binop: (String) -> Bool = (op) -> {
  op == "=="
  || op == "!="
}
let unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {
  match unify(left_ty, target_ty, s) {
    Some(s1) => unify(right_ty, target_ty, s1),
    None => None
  }
}
let unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {
  match unify(left_ty, right_ty, s) {
    Some(s1) => Some((subst_apply(s1, left_ty), s1)),
    None => None
  }
}
let infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {
  match unify_same_binop_operands(left_ty, right_ty, s) {
    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {
      Some((resolved, s1))
    } else {
      None
    },
    None => None
  }
}
let infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String], Array[(Int, Type)]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors, tytab) -> {
  if is_logic_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Bool")))
        (CtUnknown, s)
      }
    }
  }
  else if is_equality_binop(op) {
    match unify(left_ty, right_ty, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must have same type")))
        (CtUnknown, s)
      }
    }
  }
  else if is_order_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtBool, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtBool, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, "Ord", s) {
          Some((_, s1)) => (CtBool, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "+" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {
          Some(s1) => (CtString, s1),
          None => match infer_named_trait_binop(env, left_ty, right_ty, "Add", s) {
            Some((resolved, s1)) => (resolved, s1),
            None => {
              Array::push(errors, "type mismatch in '+': operands must be Int, Double, or String")
              (CtUnknown, s)
            }
          }
        }
      }
    }
  }
  else if op == "-"
  || op == "*"
  || op == "/" {
    let trait_name = if op == "-" {
      "Sub"
    } else if op == "*" {
      "Mul"
    } else {
      "Div"
    }
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {
          Some((resolved, s1)) => (resolved, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "%" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, "type mismatch in '%': operands must be Int")
        (CtUnknown, s)
      }
    }
  }
  else if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int")))
        (CtUnknown, s)
      }
    }
  }
  else {
    Array::push(errors, String::concat("unknown operator: ", op))
    (CtUnknown, s)
  }
}
let rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {
  match ty {
    CtNamed(name, args) => {
      let ra = for a in args {
        resolve_tparams_in(a, env)
      }
      match env_lookup(env, name) {
        Some(t) => match t {
          CtVar(_) => t,
          _ => CtNamed(name, ra)
        },
        None => CtNamed(name, ra)
      }
    },
    CtArray(e) => CtArray(resolve_tparams_in(e, env)),
    CtOption(e) => CtOption(resolve_tparams_in(e, env)),
    CtTuple(es) => CtTuple(for e in es {
      resolve_tparams_in(e, env)
    }),
    CtFn(ps, ret, eff) => {
      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, resolve_tparams_in(Array::get(types, i), env))
          i = i + 1
        }
        out
      }
      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)
    },
    _ => ty
  }
}
let tab_call_ty: (Array[(Int, Type)], Int, Type) -> Type = (tytab, call_off, ty) -> {
  if call_off >= 0 {
    Array::push(tytab, (call_off, ty))
  } else {
    ()
  }
  ty
}
let check_seq_spine: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab, ce) -> {
  let mut cur = expr
  let mut cenv = env
  let mut s1 = s
  let mut c1 = c
  let mut done = false
  let mut result = (CtUnit, s, c)
  while !done {
    match cur {
      ESeq(left, right) => {
        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        cur = right
      },
      ELet(name, val, body) => {
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)
        let gen = generalize(ns, vt)
        cenv = env_bind(cenv, name, gen)
        s1 = ns
        c1 = nc
        cur = body
      },
      ELetMut(name, val, body) => {
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)
        cenv = env_bind(cenv, name, vt)
        s1 = ns
        c1 = nc
        cur = body
      },
      ELetRec(name, val, body) => {
        let (tv, c1b) = fresh_var(c1)
        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)
        let s2 = match unify(tv, vt, ns) {
          Some(su) => su,
          None => ns
        }
        let gen = generalize(s2, tv)
        cenv = env_bind(cenv, name, gen)
        s1 = s2
        c1 = nc
        cur = body
      },
      _ => {
        result = ce(cur, cenv, defs, s1, c1, errors, tytab)
        done = true
      }
    }
  }
  result
}
let field_write_mut_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, tytab, ce) -> {
  if name == "__set_field" && Array::length(args) == 3 {
    match Array::get(args, 1) {
      EString(field) => {
        let throwaway = Array::slice([""], 0, 0)
        let throwtab = Array::slice([(0, CtUnit)], 0, 0)
        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
        match subst_apply(s, obj_ty) {
          CtStruct(sname) => match find_typedef(defs, sname) {
            Some(TDStruct(_, dfields, mut_names)) => {
              let mut found = false
              let mut i = 0
              while i < Array::length(mut_names) {
                if Array::get(mut_names, i) == field {
                  found = true
                } else {
                  ()
                }
                i = i + 1
              }
              if found {
                ()
              } else {
                Array::push(errors, String::concat("cannot assign to non-`mut` field `", String::concat(field, String::concat("` of struct ", sname))))
              }
              let mut fty = CtUnknown
              let mut has_field = false
              let mut fi = 0
              while fi < Array::length(dfields) {
                let (fn2, ft) = Array::get(dfields, fi)
                if fn2 == field {
                  fty = ft
                  has_field = true
                } else {
                  ()
                }
                fi = fi + 1
              }
              if has_field {
                let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)
                let _ = check_assignable(subst_apply(s, fty), subst_apply(s, val_ty), s, errors, String::concat("type mismatch writing field `", String::concat(field, "`")), 0 - 1)
                ()
              } else {
                ()
              }
            },
            _ => ()
          },
          _ => ()
        }
      },
      _ => ()
    }
  } else {
    ()
  }
}
let index_target_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, ce) -> {
  if name == "__index" && Array::length(args) == 2 {
    let throwaway = Array::slice([""], 0, 0)
    let throwtab = Array::slice([(0, CtUnit)], 0, 0)
    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
    let not_indexable = match subst_apply(s, obj_ty) {
      CtInt => true,
      CtDouble => true,
      CtBool => true,
      CtChar => true,
      CtUnit => true,
      _ => false
    }
    if not_indexable {
      Array::push(errors, "cannot index a non-indexable value (expected Array, String, or Bytes)")
    } else {
      ()
    }
  } else {
    ()
  }
}
let rec pat_is_catchall: (Pat) -> Bool = (pat) -> {
  match pat {
    PWild => true,
    PBind(_) => true,
    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),
    _ => false
  }
}
let rec collect_ctor_names_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {
  match pat {
    PCtor(name, _) => Array::push(acc, name),
    POr(l, r) => {
      collect_ctor_names_into(l, acc)
      collect_ctor_names_into(r, acc)
    },
    _ => ()
  }
}
let parse_tuple_index: (String) -> Option[Int] = (s) -> {
  let len = String::length(s)
  if len == 0 {
    None
  } else {
    let mut i = 0
    let mut val = 0
    let mut ok = true
    while i < len {
      let cc = String::char_code_at(s, i)
      if cc >= 48 && cc <= 57 {
        val = val * 10 + (cc - 48)
      } else {
        ok = false
      }
      i = i + 1
    }
    if ok {
      Some(val)
    } else {
      None
    }
  }
}
export let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab) -> {
  match expr {
    EInt(_) => (CtInt, s, c),
    EFloat(_) => (CtDouble, s, c),
    EString(_) => (CtString, s, c),
    EBool(_) => (CtBool, s, c),
    EUnit => (CtUnit, s, c),
    EIdent(name, ident_off) => match env_lookup(env, name) {
      Some(t) => {
        let (ti, c1, new_bounds) = instantiate(t, c)
        let nblen = Array::length(new_bounds)
        let mut s1 = s
        let mut bi = 0
        while bi < nblen {
          let (vid, bounds) = Array::get(new_bounds, bi)
          if Array::length(bounds) != 0 {
            s1 = subst_add_bound(s1, vid, bounds)
          }
          bi = bi + 1
        }
        if ident_off >= 0 {
          Array::push(tytab, (ident_off, ti))
        } else {
          ()
        }
        (ti, s1, c1)
      },
      None => match lookup_builtin(name) {
        Some(t) => {
          if ident_off >= 0 {
            Array::push(tytab, (ident_off, t))
          } else {
            ()
          }
          (t, s, c)
        },
        None => match resolve_trait_method_ident(name, env, defs, s) {
          Some(mty) => {
            if ident_off >= 0 {
              Array::push(tytab, (ident_off, mty))
            } else {
              ()
            }
            (mty, s, c)
          },
          None => {
            Array::push(errors, String::concat(String::concat("unknown name: ", name), off_marker_len(ident_off, String::length(name))))
            (CtUnknown, s, c)
          }
        }
      }
    },
    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELet(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELetMut(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    EIf(cond, then_e, else_e) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "if condition must be Bool")
      }
      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)
      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)
      let rtt = subst_apply(s3, tt)
      let ret = subst_apply(s3, et)
      let s3b = match rtt {
        CtUnit => s3,
        _ => match ret {
          CtUnit => s3,
          _ => check_assignable(rtt, ret, s3, errors, "if branches have incompatible types", 0 - 1)
        }
      }
      (tt, s3b, c3)
    },
    ECall(callee, args, call_off) => match callee {
      EIdent(name, callee_off) => {
        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)
        index_target_check(name, args, env, defs, s, c, errors, check_expr)
        if name == "perform" {
        if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(_, opargs, _) => {
              let oalen = Array::length(opargs)
              let mut s1 = s
              let mut c1 = c
              let mut ai = 0
              while ai < oalen {
                let (_, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)
                s1 = ns
                c1 = nc
                ai = ai + 1
              }
              let (tv, c2) = fresh_var(c1)
              (tv, s1, c2)
            },
            EIdent(_, _) => {
              let (tv, c2) = fresh_var(c)
              (tv, s, c2)
            },
            other => check_expr(other, env, defs, s, c, errors, tytab)
          }
        } else {
          (CtUnknown, s, c)
        }
      } else if name == "resume" {
        let alen = Array::length(args)
        let mut s1 = s
        let mut c1 = c
        let mut ai = 0
        while ai < alen {
          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)
          s1 = ns
          c1 = nc
          ai = ai + 1
        }
        let (tv, c2) = fresh_var(c1)
        (tv, s1, c2)
      } else if name == "Some" {
        if Array::length(args) == 1 {
          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)
        } else {
          (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)
        }
      } else {
        match direct_call_return(env, name) {
          Some(ret_ty) => {
            let alen = Array::length(args)
            let mut ai = 0
            let mut s2 = s
            let mut c2 = c
            while ai < alen {
              let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)
          },
          None => {
            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)
            let alen = Array::length(args)
            let arg_tys = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            let mut s2 = s1
            let mut c2 = c1
            while ai < alen {
              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
              Array::push(arg_tys, at)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(name, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)
                let call_ret = Array::get(ret_box, 0)
                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
              },
              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
              other => {
                let not_callable = match other {
                  CtInt => true,
                  CtDouble => true,
                  CtBool => true,
                  CtString => true,
                  CtChar => true,
                  CtUnit => true,
                  CtBytes => true,
                  CtTuple(_) => true,
                  CtArray(_) => true,
                  _ => false
                }
                if not_callable {
                  Array::push(errors, String::concat(String::concat("calling a non-function value: ", name), off_marker_len(callee_off, String::length(name))))
                } else {
                  ()
                }
                (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
              }
            }
          }
        }
        }
      },
      EDot(obj, method, _) => {
        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)
        let resolved = subst_apply(s1, obj_ty)
        let type_prefix = type_name_prefix(resolved)
        let qualified = String::concat(type_prefix, String::concat("::", method))
        let direct_ret = direct_call_return(env, qualified)
        let method_ty = match env_lookup(env, qualified) {
          Some(t) => {
            let (ti, c2, _) = instantiate(t, c1)
            (ti, s1, c2)
          },
          None => match lookup_builtin(qualified) {
            Some(t) => (t, s1, c1),
            None => (CtUnknown, s1, c1)
          }
        }
        let (mt, s2, c2) = method_ty
        let all_args = prepend_expr(obj, args)
        let alen = Array::length(all_args)
        let arg_tys = Array::slice([
          CtUnknown
        ], 0, 0)
        Array::push(arg_tys, obj_ty)
        let mut ai = 1
        let mut s3 = s2
        let mut c3 = c2
        while ai < alen {
          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)
          Array::push(arg_tys, at)
          s3 = ns
          c3 = nc
          ai = ai + 1
        }
        let applied_method_ty = match mt {
          CtFn(_, _, _) => mt,
          _ => subst_apply(s3, mt)
        }
        match applied_method_ty {
          CtFn(param_tys, ret, _) => {
            let ret_box = Array::slice([
              ret
            ], 0, 1)
            let call_param_tys = param_tys
            let plen = Array::length(param_tys)
            let alen2 = Array::length(arg_tys)
            if alen2 != plen {
              Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(qualified, String::concat(": expected ", String::concat(__to_string(plen), String::concat(" args, got ", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))
            }
            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)
            let call_ret = Array::get(ret_box, 0)
            let selected_ret = match direct_ret {
              Some(t) => t,
              None => call_ret
            }
            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)
          },
          _ => match direct_ret {
            Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),
            None => (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)
          }
        }
      },
      _ => {
        let callee_name0 = expr_ident_name_or_empty(callee)
        if callee_name0 != "" {
          match direct_call_return(env, callee_name0) {
            Some(ret_ty) => {
              let alen = Array::length(args)
              let mut ai = 0
              let mut s2 = s
              let mut c2 = c
              while ai < alen {
                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)
            },
            None => {
              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)
              let alen = Array::length(args)
              let arg_tys = Array::slice([
                CtUnknown
              ], 0, 0)
              let mut ai = 0
              let mut s2 = s1
              let mut c2 = c1
              while ai < alen {
                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                Array::push(arg_tys, at)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(callee_name0, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)
                let call_ret = Array::get(ret_box, 0)
                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
              },
              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
            }
            }
          }
        } else {
            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)
            let alen = Array::length(args)
            let arg_tys = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            let mut s2 = s1
            let mut c2 = c1
            while ai < alen {
              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
              Array::push(arg_tys, at)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for <expr>: expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))), off_marker(call_off)))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, "<expr>", call_off)
                let call_ret = Array::get(ret_box, 0)
                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
              },
              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
            }
        }
      }
    },
    EBinOp(op, left, right) => {
      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)
      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)
      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)
      (subst_apply(s3, result_ty), s3, c2)
    },
    EUnaryOp(op, operand) => {
      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)
      if op == "!" {
        match subst_apply(s1, operand_ty) {
          CtBool => (CtBool, s1, c1),
          CtVar(_) => match unify(operand_ty, CtBool, s1) {
            Some(s2) => (CtBool, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          other => {
            let flag = match other {
              CtUnknown => false,
              _ => type_is_ground(other)
            }
            if flag {
              Array::push(errors, "operand of `!` must be Bool")
            } else {
              ()
            }
            (CtUnknown, s1, c1)
          }
        }
      } else if op == "-" {
        match subst_apply(s1, operand_ty) {
          CtDouble => (CtDouble, s1, c1),
          CtInt => (CtInt, s1, c1),
          CtVar(_) => match unify(operand_ty, CtInt, s1) {
            Some(s2) => (CtInt, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else (CtUnknown, s1, c1)
    },
    EAssign(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)
      let s1b = match env_lookup(env, name) {
        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat("assignment type mismatch for ", name), 0 - 1),
        None => s1
      }
      check_expr(body, env, defs, s1b, c1, errors, tytab)
    },
    EAssignOp(_, _, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)
      check_expr(body, env, defs, s1, c1, errors, tytab)
    },
    EMatch(scrutinee, arms) => {
      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)
      let alen = Array::length(arms)
      if alen == 0 {
        (CtUnknown, s1, c1)
      }
      else {
        let mut result_ty = CtUnknown
        let mut check_arms = false
        let mut si = s1
        let mut ci = c1
        let mut ai = 0
        while ai < alen {
          let (pat, body) = Array::get(arms, ai)
          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)
          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)
          si = ns
          ci = nc
          if ai == 0 {
            result_ty = arm_ty
            check_arms = match subst_apply(si, arm_ty) {
              CtInt => true,
              CtDouble => true,
              CtBool => true,
              CtString => true,
              CtChar => true,
              _ => false
            }
          } else {
            if check_arms {
              let r2 = subst_apply(si, arm_ty)
              si = match r2 {
                CtUnit => si,
                _ => check_assignable(result_ty, r2, si, errors, "match arms have incompatible types", 0 - 1)
              }
            } else {
              ()
            }
          }
          ai = ai + 1
        }
        let enum_name_opt = match subst_apply(si, scr_ty) {
          CtEnum(en) => Some(en),
          CtNamed(en, _) => Some(en),
          _ => None
        }
        match enum_name_opt {
          Some(en) => match find_typedef(defs, en) {
            Some(TDEnum(_, _, variants)) => {
              let mut has_catchall = false
              let covered = Array::slice([
                ""
              ], 0, 0)
              let mut ax = 0
              while ax < Array::length(arms) {
                let (apat, _) = Array::get(arms, ax)
                if pat_is_catchall(apat) {
                  has_catchall = true
                } else {
                  ()
                }
                collect_ctor_names_into(apat, covered)
                ax = ax + 1
              }
              if has_catchall {
                ()
              } else {
                let mut vi = 0
                while vi < Array::length(variants) {
                  let (vname, _) = Array::get(variants, vi)
                  let mut found = false
                  let mut ci2 = 0
                  while ci2 < Array::length(covered) {
                    if Array::get(covered, ci2) == vname {
                      found = true
                    } else {
                      ()
                    }
                    ci2 = ci2 + 1
                  }
                  if found {
                    ()
                  } else {
                    Array::push(errors, String::concat("non-exhaustive match: variant `", String::concat(vname, String::concat("` of enum ", String::concat(en, " is not handled (add it or a `_` arm)")))))
                  }
                  vi = vi + 1
                }
              }
            },
            _ => ()
          },
          None => ()
        }
        (result_ty, si, ci)
      }
    },
    EHandle(body, _) => check_expr(body, env, defs, s, c, errors, tytab),
    EWhile(cond, body) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "while condition must be Bool")
      }
      let (_, s2, c2) = check_expr(body, env, defs, s1, c1, errors, tytab)
      (CtUnit, s2, c2)
    },
    ELoop(params, body) => {
      let mut env1 = env
      let mut s1 = s
      let mut c1 = c
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)
        env1 = env_bind(env1, name, pt)
        s1 = ns
        c1 = nc
        i = i + 1
      }
      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1, errors, tytab)
      (CtUnit, s2, c2)
    },
    EForIn(name, index_name, iterable, body) => {
      let real_iterable = match iterable {
        ECall(callee, args, _) => match callee {
          EIdent(nm, _) => if nm == "__await_iter" && Array::length(args) == 1 {
            Array::get(args, 0)
          } else iterable,
          _ => iterable
        },
        _ => iterable
      }
      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)
      let it_resolved = subst_apply(s1, it)
      let (et, c1b) = match it_resolved {
        CtArray(elem) => (elem, c1),
        CtNamed(nm, args) => if Array::length(args) > 0 {
          (Array::get(args, 0), c1)
        } else if nm == "Stream" || type_name_has_iterator_impl(env, nm) {
          fresh_var(c1)
        } else (CtUnknown, c1),
        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {
          fresh_var(c1)
        } else (CtUnknown, c1),
        other => {
          let flag = match other {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtUnit => true,
            CtChar => true,
            _ => false
          }
          if flag {
            Array::push(errors, "for loop requires an iterable (Array or iterator)")
          } else {
            ()
          }
          (CtUnknown, c1)
        }
      }
      let env2 = env_bind(env, name, et)
      let env3 = match index_name {
        Some(index_name) => env_bind(env2, index_name, CtInt),
        None => env2
      }
      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1b, errors, tytab)
      (CtArray(bt), s2, c2)
    },
    EDot(obj, field, dot_off) => {
      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)
      let resolved = subst_apply(s1, obj_ty)
      let field_ty = match resolved {
        CtStruct(sname) => match find_typedef(defs, sname) {
          Some(td) => match td {
            TDStruct(_, fields, _) => {
              let rec find_field: (Int) -> Option[Type] = (i) -> {
                if i >= Array::length(fields) {
                  None
                } else {
                  let (fname, ftype) = Array::get(fields, i)
                  if fname == field {
                    Some(ftype)
                  } else find_field(i + 1)
                }
              }
              match find_field(0) {
                Some(ft) => ft,
                None => {
                  Array::push(errors, String::concat(String::concat("unknown field '", String::concat(field, String::concat("' on struct ", sname))), off_marker(dot_off)))
                  CtUnknown
                }
              }
            },
            _ => CtUnknown
          },
          None => CtUnknown
        },
        CtTuple(elems) => match parse_tuple_index(field) {
          Some(idx) => if idx >= 0 && idx < Array::length(elems) {
            Array::get(elems, idx)
          } else {
            Array::push(errors, String::concat(String::concat("tuple index ", String::concat(field, String::concat(" out of range for a ", String::concat(__to_string(Array::length(elems)), "-tuple")))), off_marker(dot_off)))
            CtUnknown
          },
          None => CtUnknown
        },
        _ => CtUnknown
      }
      if dot_off >= 0 {
        Array::push(tytab, (dot_off, field_ty))
      } else {
        ()
      }
      (field_ty, s1, c1)
    },
    EFn(tparams, tbounds, params, ret_ty, effect, body) => {
      let tplen = Array::length(tparams)
      let mut tp_env = env
      let mut s0 = s
      let mut c0 = c
      let mut tpi = 0
      while tpi < tplen {
        let tpname = Array::get(tparams, tpi)
        match fresh_var(c0) {
          (tv, nc) => {
            let vid = nc - 1
            let tblen = Array::length(tbounds)
            let mut bounds = Array::slice([
              ""
            ], 0, 0)
            let mut tbi = 0
            let mut found_bounds = false
            while tbi < tblen {
              let (bname, blist) = Array::get(tbounds, tbi)
              if !found_bounds && bname == tpname {
                bounds = blist
                found_bounds = true
              }
              tbi = tbi + 1
            }
            s0 = if Array::length(bounds) == 0 {
              s0
            } else subst_add_bound(s0, vid, bounds)
            tp_env = env_bind(tp_env, tpname, tv)
            c0 = nc
          },
          _ => ()
        }
        tpi = tpi + 1
      }
      let plen = Array::length(params)
      let mut fn_env = tp_env
      let mut s1 = s0
      let mut c1 = c0
      let param_types = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut pi = 0
      while pi < plen {
        let (raw_name, ann) = Array::get(params, pi)
        let nlen = String::length(raw_name)
        let name = if nlen > 0 {
          let lc = String::char_code_at(raw_name, nlen - 1)
          if lc == '~' || lc == '?' {
            raw_name[0: nlen - 1]
          } else raw_name
        } else raw_name
        let (pt, ns, nc) = match ann {
          Some(te) => {
            let resolved = resolve_type_expr(te, defs)
            let pt2 = resolve_tparams_in(resolved, fn_env)
            (pt2, s1, c1)
          },
          None => {
            let (tv, nc2) = fresh_var(c1)
            (tv, s1, nc2)
          }
        }
        fn_env = env_bind(fn_env, name, pt)
        Array::push(param_types, pt)
        s1 = ns
        c1 = nc
        pi = pi + 1
      }
      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1, errors, tytab)
      let (final_ret, s3) = match ret_ty {
        Some(te) => {
          let resolved = resolve_type_expr(te, defs)
          let resolved_ret = resolve_tparams_in(resolved, fn_env)
          match unify(bt, resolved_ret, s2) {
            Some(ns) => (subst_apply(ns, resolved_ret), ns),
            None => {
              Array::push(errors, String::concat("return type mismatch: expected ", String::concat(type_to_string(resolved_ret), String::concat(", got ", type_to_string(bt)))))
              (CtUnknown, s2)
            }
          }
        },
        None => (subst_apply(s2, bt), s2)
      }
      (CtFn(param_types, final_ret, effect), s3, c2)
    },
    EBreak(opt) => match opt {
      Some(e) => {
        let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)
        (CtUnit, s1, c1)
      },
      None => (CtUnit, s, c)
    },
    EContinue(args) => {
      let alen = Array::length(args)
      let mut s1 = s
      let mut c1 = c
      let mut ai = 0
      while ai < alen {
        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtUnit, s1, c1)
    },
    ERecord(fields) => {
      let flen = Array::length(fields)
      let mut s1 = s
      let mut c1 = c
      let field_tys = Array::slice([
        ("", CtUnknown)
      ], 0, 0)
      let mut fi = 0
      while fi < flen {
        let (fname, fval) = Array::get(fields, fi)
        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)
        Array::push(field_tys, (fname, ft))
        s1 = ns
        c1 = nc
        fi = fi + 1
      }
      let s2 = check_record_fields(defs, field_tys, s1, errors)
      let rec_ty = match resolve_record_struct_name(defs, field_tys) {
        Some(sname) => CtStruct(sname),
        None => CtUnknown
      }
      (rec_ty, s2, c1)
    },
    ETuple(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let tys = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut ti = 0
      while ti < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)
        Array::push(tys, it)
        s1 = ns
        c1 = nc
        ti = ti + 1
      }
      (CtTuple(tys), s1, c1)
    },
    EArray(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let mut elem_ty = CtUnknown
      let mut check_elems = false
      let mut ai = 0
      while ai < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        if ai == 0 {
          elem_ty = it
          check_elems = match subst_apply(s1, it) {
            CtInt => true,
            CtDouble => true,
            CtBool => true,
            CtString => true,
            CtChar => true,
            _ => false
          }
        } else {
          if check_elems {
            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, "array elements have incompatible types", 0 - 1)
          } else {
            ()
          }
        }
        ai = ai + 1
      }
      (CtArray(elem_ty), s1, c1)
    },
    EReturn(e) => {
      let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)
      (CtUnknown, s1, c1)
    },
    _ => (CtUnknown, s, c)
  }
}
export {
  check_expr
}
export {
  lookup_builtin
}
export enum EffectError {
  EEThrowOutsideEffect(String);
  EEEffectfulCallOutsideEffect(String);
  EEPerformUndeclaredEffect(String, String);
  EEAssignImmutable(String)
}
export let effect_error_to_string: (EffectError) -> String = (err) -> {
  match err {
    EEThrowOutsideEffect(msg) => String::concat("throw outside effectful context: ", msg),
    EEEffectfulCallOutsideEffect(name) => String::concat("effectful call outside effectful context: ", name),
    EEPerformUndeclaredEffect(op, eff) => String::concat("use of undeclared effect `", String::concat(eff, String::concat("` (", String::concat(op, "); add it to the function's `with { ... }` or wrap in a `handle`")))),
    EEAssignImmutable(name) => String::concat("cannot assign to immutable binding `", String::concat(name, "` (declare it with `let mut`)"))
  }
}
let effect_opt_is_async: (Option[String]) -> Bool = (eff) -> {
  match eff {
    Some(s) => String::contains(s, "Async"),
    None => false
  }
}
let is_async_primitive: (String, TypeEnv) -> Bool = (name, env) -> {
  match env_lookup(env, name) {
    Some(_) => false,
    None => {
      let normalized = canonical_builtin_name(name)
      match lookup_builtin(normalized) {
        Some(ty) => match ty {
          CtFn(_, _, eff) => effect_opt_is_async(eff),
          _ => false
        },
        None => false
      }
    }
  }
}
let append_eff_errs: (Array[EffectError], Array[EffectError]) -> Unit = (dst, src) -> {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}
export let rec check_async_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_async) -> {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => if !in_async && is_async_primitive(name, env) {
          Array::push(errors, EEEffectfulCallOutsideEffect(name))
        }
        ,
        _ => ()
      }
      append_eff_errs(errors, check_async_effects_expr(callee, env, in_async))
      let mut ai = 0
      while ai < Array::length(args) {
        append_eff_errs(errors, check_async_effects_expr(Array::get(args, ai), env, in_async))
        ai = ai + 1
      }
      errors
    },
    EFn(_, _, _, _, effect, body) => {
      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))
      errors
    },
    EHandle(body, arms) => {
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))
        ai = ai + 1
      }
      errors
    },
    ELet(_, val, body) => {
      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      errors
    },
    ELetRec(_, val, body) => {
      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      errors
    },
    ELetMut(_, val, body) => {
      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      errors
    },
    ESeq(a, b) => {
      append_eff_errs(errors, check_async_effects_expr(a, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(b, env, in_async))
      errors
    },
    EIf(cond, then_e, else_e) => {
      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(then_e, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(else_e, env, in_async))
      errors
    },
    EMatch(scrutinee, arms) => {
      append_eff_errs(errors, check_async_effects_expr(scrutinee, env, in_async))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))
        ai = ai + 1
      }
      errors
    },
    EWhile(cond, body) => {
      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      errors
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        append_eff_errs(errors, check_async_effects_expr(init, env, in_async))
        i = i + 1
      }
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      errors
    },
    EForIn(_, _, iter, body) => {
      append_eff_errs(errors, check_async_effects_expr(iter, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))
      errors
    },
    EBinOp(_, left, right) => {
      append_eff_errs(errors, check_async_effects_expr(left, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(right, env, in_async))
      errors
    },
    EReturn(e) => check_async_effects_expr(e, env, in_async),
    EUnaryOp(_, operand) => check_async_effects_expr(operand, env, in_async),
    EThrow(e) => check_async_effects_expr(e, env, in_async),
    EAssign(_, val, cont) => {
      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))
      errors
    },
    EAssignOp(_, _, val, cont) => {
      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))
      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))
      errors
    },
    EDot(obj, _, _) => check_async_effects_expr(obj, env, in_async),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))
        ei = ei + 1
      }
      errors
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))
        ei = ei + 1
      }
      errors
    },
    ERecord(fields) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        append_eff_errs(errors, check_async_effects_expr(fval, env, in_async))
        fi = fi + 1
      }
      errors
    },
    _ => errors
  }
}
let sig_type_is_async: (Option[TypeExpr]) -> Bool = (topt) -> {
  match topt {
    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),
    _ => false
  }
}
let check_async_effects_binding: (Option[TypeExpr], Expr, TypeEnv) -> Array[EffectError] = (ty, body, env) -> {
  let sig_async = sig_type_is_async(ty)
  match body {
    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),
    _ => check_async_effects_expr(body, env, sig_async)
  }
}
export let check_async_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {
  match stmt {
    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),
    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),
    STest(_, body) => check_async_effects_expr(body, env, false),
    SBench(_, body) => check_async_effects_expr(body, env, false),
    SExpr(e) => check_async_effects_expr(e, env, false),
    _ => Array::slice([
      EEThrowOutsideEffect("")
    ], 0, 0)
  }
}
export let check_async_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))
    i = i + 1
  }
  errors
}
let effect_decl_labels: (Option[String]) -> Array[String] = (eff) -> {
  let out = Array::slice([
    ""
  ], 0, 0)
  match eff {
    None => out,
    Some(s) => {
      let raw = String::split(s, ",")
      let mut i = 0
      while i < Array::length(raw) {
        let label = String::trim(Array::get(raw, i))
        if String::length(label) > 0 {
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, j) == label {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, label)
          }
        }
        i = i + 1
      }
      out
    }
  }
}
let label_is_effect_var: (String) -> Bool = (name) -> {
  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122
}
let decl_authorizes_effect: (Array[String], String) -> Bool = (labels, eff_name) -> {
  let mut i = 0
  let mut ok = false
  while i < Array::length(labels) {
    let l = Array::get(labels, i)
    if l == eff_name {
      ok = true
    } else if label_is_effect_var(l) {
      ok = true
    }
    i = i + 1
  }
  ok
}
let effect_name_of_op: (String) -> String = (op_name) -> {
  let idx = String::index_of(op_name, "::")
  if idx > 0 {
    op_name[0:idx]
  } else {
    op_name
  }
}
let builtin_call_effect: (String) -> Option[String] = (name) -> {
  if String::index_of(name, "::") < 0 {
    None
  } else {
    let normalized = canonical_builtin_name(name)
    match lookup_builtin(normalized) {
      Some(ty) => match ty {
        CtFn(_, _, Some(eff)) => if eff == "Error" {
          None
        } else if eff == "Async" {
          None
        } else {
          Some(eff)
        },
        _ => None
      },
      None => None
    }
  }
}
let labels_union: (Array[String], Array[String]) -> Array[String] = (a, b) -> {
  let out = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < Array::length(a) {
    Array::push(out, Array::get(a, i))
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(b) {
    let l = Array::get(b, j)
    let mut seen = false
    let mut k = 0
    while k < Array::length(out) {
      if Array::get(out, k) == l {
        seen = true
      }
      k = k + 1
    }
    if !seen {
      Array::push(out, l)
    }
    j = j + 1
  }
  out
}
let collect_handle_effects: (Array[(Pat, Expr)]) -> Array[String] = (arms) -> {
  let out = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, _) = Array::get(arms, i)
    match pat {
      PCtor(name, _) => {
        let idx = String::index_of(name, "::")
        if idx > 0 {
          let eff = name[0:idx]
          let mut seen = false
          let mut j = 0
          while j < Array::length(out) {
            if Array::get(out, j) == eff {
              seen = true
            }
            j = j + 1
          }
          if !seen {
            Array::push(out, eff)
          }
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
export let rec check_perform_effects_expr: (Expr, Array[String], Bool) -> Array[EffectError] = (expr, declared, in_handle) -> {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  match expr {
    ECall(callee, args, _) => {
      match callee {
        EIdent(name, _) => if name == "perform" && Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(op_callee, _, _) => match op_callee {
              EIdent(op_name, _) => {
                let eff = effect_name_of_op(op_name)
                if !in_handle && !decl_authorizes_effect(declared, eff) {
                  Array::push(errors, EEPerformUndeclaredEffect(op_name, eff))
                }
              },
              _ => ()
            },
            _ => ()
          }
        } else {
          match builtin_call_effect(name) {
            Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {
              Array::push(errors, EEPerformUndeclaredEffect(name, eff))
            },
            None => ()
          }
        }
        ,
        _ => ()
      }
      append_eff_errs(errors, check_perform_effects_expr(callee, declared, in_handle))
      let mut ai = 0
      while ai < Array::length(args) {
        append_eff_errs(errors, check_perform_effects_expr(Array::get(args, ai), declared, in_handle))
        ai = ai + 1
      }
      errors
    },
    EFn(_, _, _, _, effect, body) => {
      append_eff_errs(errors, check_perform_effects_expr(body, effect_decl_labels(effect), false))
      errors
    },
    EHandle(body, arms) => {
      let discharged = collect_handle_effects(arms)
      let body_declared = labels_union(declared, discharged)
      let body_in_handle = if Array::length(discharged) == 0 {
        true
      } else {
        in_handle
      }
      append_eff_errs(errors, check_perform_effects_expr(body, body_declared, body_in_handle))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_perform_effects_expr(arm_body, declared, in_handle))
        ai = ai + 1
      }
      errors
    },
    ELet(_, val, body) => {
      append_eff_errs(errors, check_perform_effects_expr(val, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(body, declared, in_handle))
      errors
    },
    ELetRec(_, val, body) => {
      append_eff_errs(errors, check_perform_effects_expr(val, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(body, declared, in_handle))
      errors
    },
    ELetMut(_, val, body) => {
      append_eff_errs(errors, check_perform_effects_expr(val, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(body, declared, in_handle))
      errors
    },
    ESeq(a, b) => {
      append_eff_errs(errors, check_perform_effects_expr(a, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(b, declared, in_handle))
      errors
    },
    EIf(cond, then_e, else_e) => {
      append_eff_errs(errors, check_perform_effects_expr(cond, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(then_e, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(else_e, declared, in_handle))
      errors
    },
    EMatch(scrutinee, arms) => {
      append_eff_errs(errors, check_perform_effects_expr(scrutinee, declared, in_handle))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_perform_effects_expr(arm_body, declared, in_handle))
        ai = ai + 1
      }
      errors
    },
    EWhile(cond, body) => {
      append_eff_errs(errors, check_perform_effects_expr(cond, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(body, declared, in_handle))
      errors
    },
    ELoop(params, body) => {
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        append_eff_errs(errors, check_perform_effects_expr(init, declared, in_handle))
        i = i + 1
      }
      append_eff_errs(errors, check_perform_effects_expr(body, declared, in_handle))
      errors
    },
    EForIn(_, _, iter, body) => {
      append_eff_errs(errors, check_perform_effects_expr(iter, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(body, declared, in_handle))
      errors
    },
    EBinOp(_, left, right) => {
      append_eff_errs(errors, check_perform_effects_expr(left, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(right, declared, in_handle))
      errors
    },
    EReturn(e) => check_perform_effects_expr(e, declared, in_handle),
    EUnaryOp(_, operand) => check_perform_effects_expr(operand, declared, in_handle),
    EThrow(e) => check_perform_effects_expr(e, declared, in_handle),
    EAssign(_, val, cont) => {
      append_eff_errs(errors, check_perform_effects_expr(val, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(cont, declared, in_handle))
      errors
    },
    EAssignOp(_, _, val, cont) => {
      append_eff_errs(errors, check_perform_effects_expr(val, declared, in_handle))
      append_eff_errs(errors, check_perform_effects_expr(cont, declared, in_handle))
      errors
    },
    EDot(obj, _, _) => check_perform_effects_expr(obj, declared, in_handle),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_perform_effects_expr(Array::get(elems, ei), declared, in_handle))
        ei = ei + 1
      }
      errors
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_perform_effects_expr(Array::get(elems, ei), declared, in_handle))
        ei = ei + 1
      }
      errors
    },
    ERecord(fields) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        append_eff_errs(errors, check_perform_effects_expr(fval, declared, in_handle))
        fi = fi + 1
      }
      errors
    },
    _ => errors
  }
}
let sig_type_effect_labels: (Option[TypeExpr]) -> Array[String] = (topt) -> {
  match topt {
    Some(TyFn(_, _, eff)) => effect_decl_labels(eff),
    _ => effect_decl_labels(None)
  }
}
let check_perform_effects_binding: (Option[TypeExpr], Expr) -> Array[EffectError] = (ty, body) -> {
  let sig_labels = sig_type_effect_labels(ty)
  match body {
    EFn(_, _, _, _, eff, fbody) => check_perform_effects_expr(fbody, labels_union(sig_labels, effect_decl_labels(eff)), false),
    _ => check_perform_effects_expr(body, sig_labels, false)
  }
}
export let check_perform_effects_stmt: (Stmt) -> Array[EffectError] = (stmt) -> {
  match stmt {
    SLet(_, _, _, ty, body) => check_perform_effects_binding(ty, body),
    SLetMut(_, ty, body) => check_perform_effects_binding(ty, body),
    STest(_, body) => check_perform_effects_expr(body, effect_decl_labels(None), false),
    SBench(_, body) => check_perform_effects_expr(body, effect_decl_labels(None), false),
    SExpr(e) => check_perform_effects_expr(e, effect_decl_labels(None), false),
    _ => Array::slice([
      EEThrowOutsideEffect("")
    ], 0, 0)
  }
}
export let check_perform_effects_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    append_eff_errs(errors, check_perform_effects_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  errors
}
let mut_has: (Array[String], String) -> Bool = (xs, n) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(xs) {
    if Array::get(xs, i) == n {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}
let mut_with: (Array[String], String) -> Array[String] = (base, name) -> {
  let out = Array::slice(base, 0, Array::length(base))
  Array::push(out, name)
  out
}
let rec collect_pat_binds_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {
  match pat {
    PBind(name) => Array::push(acc, name),
    PCtor(_, subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    PTuple(subs) => {
      let mut i = 0
      while i < Array::length(subs) {
        collect_pat_binds_into(Array::get(subs, i), acc)
        i = i + 1
      }
    },
    POr(l, r) => {
      collect_pat_binds_into(l, acc)
      collect_pat_binds_into(r, acc)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        collect_pat_binds_into(fp, acc)
        i = i + 1
      }
    },
    _ => ()
  }
}
let mut_with_pat: (Array[String], Pat) -> Array[String] = (base, pat) -> {
  let out = Array::slice(base, 0, Array::length(base))
  collect_pat_binds_into(pat, out)
  out
}
let mut_with_params: (Array[String], Array[(String, Option[TypeExpr])]) -> Array[String] = (base, params) -> {
  let out = Array::slice(base, 0, Array::length(base))
  let mut i = 0
  while i < Array::length(params) {
    let (pname, _) = Array::get(params, i)
    Array::push(out, pname)
    i = i + 1
  }
  out
}
export let rec check_mutability_expr: (Expr, Array[String]) -> Array[EffectError] = (expr, mutable) -> {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  match expr {
    ECall(callee, args, _) => {
      append_eff_errs(errors, check_mutability_expr(callee, mutable))
      let mut ai = 0
      while ai < Array::length(args) {
        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))
        ai = ai + 1
      }
      errors
    },
    EFn(_, _, params, _, _, body) => {
      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))
      errors
    },
    EHandle(body, arms) => {
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))
        ai = ai + 1
      }
      errors
    },
    ELet(_, val, body) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELetRec(_, val, body) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELetMut(name, val, body) => {
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))
      errors
    },
    ESeq(a, b) => {
      append_eff_errs(errors, check_mutability_expr(a, mutable))
      append_eff_errs(errors, check_mutability_expr(b, mutable))
      errors
    },
    EIf(cond, then_e, else_e) => {
      append_eff_errs(errors, check_mutability_expr(cond, mutable))
      append_eff_errs(errors, check_mutability_expr(then_e, mutable))
      append_eff_errs(errors, check_mutability_expr(else_e, mutable))
      errors
    },
    EMatch(scrutinee, arms) => {
      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))
      let mut ai = 0
      while ai < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, ai)
        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))
        ai = ai + 1
      }
      errors
    },
    EWhile(cond, body) => {
      append_eff_errs(errors, check_mutability_expr(cond, mutable))
      append_eff_errs(errors, check_mutability_expr(body, mutable))
      errors
    },
    ELoop(params, body) => {
      let loopmut = Array::slice(mutable, 0, Array::length(mutable))
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        append_eff_errs(errors, check_mutability_expr(init, mutable))
        Array::push(loopmut, pname)
        i = i + 1
      }
      append_eff_errs(errors, check_mutability_expr(body, loopmut))
      errors
    },
    EForIn(name, index_name, iter, body) => {
      append_eff_errs(errors, check_mutability_expr(iter, mutable))
      let base = mut_with(mutable, name)
      let formut = match index_name {
        Some(idx) => mut_with(base, idx),
        None => base
      }
      append_eff_errs(errors, check_mutability_expr(body, formut))
      errors
    },
    EBinOp(_, left, right) => {
      append_eff_errs(errors, check_mutability_expr(left, mutable))
      append_eff_errs(errors, check_mutability_expr(right, mutable))
      errors
    },
    EReturn(e) => check_mutability_expr(e, mutable),
    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),
    EThrow(e) => check_mutability_expr(e, mutable),
    EAssign(name, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(errors, EEAssignImmutable(name))
      } else {
        ()
      }
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(cont, mutable))
      errors
    },
    EAssignOp(name, _, val, cont) => {
      if !mut_has(mutable, name) {
        Array::push(errors, EEAssignImmutable(name))
      } else {
        ()
      }
      append_eff_errs(errors, check_mutability_expr(val, mutable))
      append_eff_errs(errors, check_mutability_expr(cont, mutable))
      errors
    },
    EDot(obj, _, _) => check_mutability_expr(obj, mutable),
    ETuple(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))
        ei = ei + 1
      }
      errors
    },
    EArray(elems) => {
      let mut ei = 0
      while ei < Array::length(elems) {
        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))
        ei = ei + 1
      }
      errors
    },
    ERecord(fields) => {
      let mut fi = 0
      while fi < Array::length(fields) {
        let (_, fval) = Array::get(fields, fi)
        append_eff_errs(errors, check_mutability_expr(fval, mutable))
        fi = fi + 1
      }
      errors
    },
    _ => errors
  }
}
let check_mutability_binding: (Expr) -> Array[EffectError] = (body) -> {
  match body {
    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(Array::slice([
      ""
    ], 0, 0), params)),
    _ => check_mutability_expr(body, Array::slice([
      ""
    ], 0, 0))
  }
}
export let check_mutability_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {
  let errors = Array::slice([
    EEThrowOutsideEffect("")
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body)),
      SLetMut(_, _, body) => append_eff_errs(errors, check_mutability_binding(body)),
      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([
        ""
      ], 0, 0))),
      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([
        ""
      ], 0, 0))),
      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, Array::slice([
        ""
      ], 0, 0))),
      _ => ()
    }
    i = i + 1
  }
  errors
}
let rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {
  if i >= Array::length(cache) {
    None
  }
  else {
    let (cached_name, cached_ty) = Array::get(cache, i)
    if cached_name == name {
      Some(cached_ty)
    }
    else import_cache_lookup(cache, name, i + 1)
  }
}
let bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {
  let env_bindings = env_flat_bindings(env)
  let import_cache = Array::slice([
    ("", CtUnknown)
  ], 0, 0)
  let nlen = Array::length(names)
  let mut i = 0
  let mut acc = env
  while i < nlen {
    let (name, alias) = Array::get(names, i)
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let ty = match import_cache_lookup(import_cache, name, 0) {
      Some(t) => t,
      None => {
        let resolved = match env_lookup_flat(env_bindings, name) {
          Some(t) => t,
          None => CtUnknown
        }
        Array::push(import_cache, (name, resolved))
        resolved
      }
    }
    let acc_with_name = env_bind(acc, bound_name, ty)
    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {
      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),
      None => acc_with_name
    }
    i = i + 1
  }
  acc
}
let annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {
  match ann {
    Some(te) => match te {
      TyFn(params, ret, _) => {
        let ret_box = Array::slice([
          ret
        ], 0, 1)
        let _ = Array::length(params)
        Some(resolve_type_expr(Array::get(ret_box, 0), defs))
      },
      _ => None
    },
    None => None
  }
}
let fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {
  match expr {
    EFn(_, _, _, ret_ty, _, _) => match ret_ty {
      Some(te) => Some(resolve_type_expr(te, defs)),
      None => None
    },
    _ => None
  }
}
let bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {
  env_bind(env, fn_return_env_name(name), ret_ty)
}
let bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {
  match annotation_return_type(ann, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => env
  }
}
let bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {
  match fn_expr_return_type(val, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => bind_annotation_return(env, name, ann, defs)
  }
}
let struct_derives_has: (Array[String], String) -> Bool = (derives, name) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(derives) {
    if Array::get(derives, i) == name {
      found = true
      i = Array::length(derives)
    } else {
      i = i + 1
    }
  }
  found
}
let stmt_is_type_decl: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SEnum(_, _, _, _) => true,
    SSuberror(_, _, _) => true,
    SStruct(_, _, _, _, _) => true,
    STypeAlias(_, _, _, _) => true,
    _ => false
  }
}
let reorder_type_decls_first: (Array[Stmt], Int) -> Array[Stmt] = (stmts, start) -> {
  let out = Array::slice(stmts, 0, start)
  let n = Array::length(stmts)
  let mut i = start
  while i < n {
    let st = Array::get(stmts, i)
    if stmt_is_type_decl(st) {
      Array::push(out, st)
    }
    i = i + 1
  }
  let mut j = start
  while j < n {
    let st = Array::get(stmts, j)
    if !stmt_is_type_decl(st) {
      Array::push(out, st)
    }
    j = j + 1
  }
  out
}
export let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (TypeEnv, Subst, Int) = (raw_stmts, i, env, defs, s, c, errors, tytab) -> {
  let stmts = reorder_type_decls_first(raw_stmts, i)
  let mut idx = i
  let mut cur_env = env
  let mut cur_s = s
  let mut cur_c = c
  let mut hoist_i = idx
  while hoist_i < Array::length(stmts) {
    match Array::get(stmts, hoist_i) {
      SLet(_, _, hname, hann, _) => {
        let ht = match hann {
          Some(hte) => resolve_type_expr(hte, defs),
          None => CtUnknown
        }
        cur_env = env_bind(cur_env, hname, ht)
      },
      _ => ()
    }
    hoist_i = hoist_i + 1
  }
  while idx < Array::length(stmts) {
    let env = cur_env
    let s = cur_s
    let c = cur_c
    let stmt = Array::get(stmts, idx)
    let (new_env, s1, c1) = match stmt {
      SLet(_, is_rec, name, ann, val) => {
        let (vt, ns0, nc) = if is_rec {
          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)
        } else {
          check_expr(val, env, defs, s, c, errors, tytab)
        }
        let ns = match ann {
          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat("binding type mismatch for ", name), 0 - 1),
          None => ns0
        }
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => generalize(ns, vt)
        }
        let env1 = env_bind(env, name, t)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetMut(name, ann, val) => {
        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)
        let ns = match ann {
          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat("binding type mismatch for ", name), 0 - 1),
          None => ns0
        }
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => vt
        }
        let env1 = env_bind(env, name, t)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetPat(pat, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)
        let new_env = match pat {
          PTuple(pats) => match vt {
            CtTuple(types) => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => if pi < Array::length(types) {
                    e = env_bind(e, name, Array::get(types, pi))
                  } else {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            },
            _ => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            }
          },
          PBind(name) => env_bind(env, name, vt),
          PStruct(_, fields) => {
            let mut e = env
            let mut fi = 0
            while fi < Array::length(fields) {
              let (_, fpat) = Array::get(fields, fi)
              match fpat {
                PBind(name) => {
                  e = env_bind(e, name, CtUnknown)
                },
                _ => ()
              }
              fi = fi + 1
            }
            e
          },
          _ => env
        }
        (new_env, ns, nc)
      },
      SEnum(_, name, params, variants) => {
        let param_len = Array::length(params)
        let param_var_ids = Array::slice([
          0
        ], 0, 0)
        let param_var_types = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut pi = 0
        while pi < param_len {
          let vid = c + pi
          Array::push(param_var_ids, vid)
          Array::push(param_var_types, CtVar(vid))
          pi = pi + 1
        }
        let ctor_result_type = if param_len == 0 {
          CtEnum(name)
        } else {
          CtNamed(name, param_var_types)
        }
        let ctor_bounds = Array::slice([
          (0, Array::slice([
            ""
          ], 0, 0))
        ], 0, 0)
        let resolved_variants = Array::slice([
          ("", Array::slice([
            CtUnknown
          ], 0, 0))
        ], 0, 0)
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          let resolved_vtypes = Array::slice([
            CtUnknown
          ], 0, 0)
          let mut ti = 0
          while ti < Array::length(vtypes) {
            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)
            Array::push(resolved_vtypes, vt)
            ti = ti + 1
          }
          Array::push(resolved_variants, (vname, resolved_vtypes))
          vi = vi + 1
        }
        Array::push(defs, TDEnum(name, params, resolved_variants))
        let mut env1 = env_bind(env, name, CtEnum(name))
        let mut ci2 = 0
        while ci2 < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, ci2)
          let ctor_ty = if Array::length(vtypes) == 0 {
            ctor_result_type
          } else {
            let resolved_args = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            while ai < Array::length(vtypes) {
              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)
              Array::push(resolved_args, arg_ty)
              ai = ai + 1
            }
            CtFn(resolved_args, ctor_result_type, None)
          }
          let exported_ctor_ty = if param_len == 0 {
            ctor_ty
          } else {
            CtForAll(param_var_ids, ctor_bounds, ctor_ty)
          }
          env1 = env_bind(env1, vname, exported_ctor_ty)
          match ctor_ty {
            CtFn(_, ret, _) => {
              let exported_ret_ty = if param_len == 0 {
                ret
              } else {
                CtForAll(param_var_ids, ctor_bounds, ret)
              }
              env1 = bind_fn_return(env1, vname, exported_ret_ty)
            },
            _ => ()
          }
          ci2 = ci2 + 1
        }
        (env1, s, c + param_len)
      },
      SStruct(_, name, field_defs, derives, mut_fields) => {
        let resolved_fields = Array::slice([
          ("", CtUnit)
        ], 0, 0)
        let mut fi = 0
        while fi < Array::length(field_defs) {
          let (fname, ftype_expr) = Array::get(field_defs, fi)
          let ftype = resolve_type_expr(ftype_expr, defs)
          Array::push(resolved_fields, (fname, ftype))
          fi = fi + 1
        }
        Array::push(defs, TDStruct(name, resolved_fields, mut_fields))
        let field_types = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut fj = 0
        while fj < Array::length(resolved_fields) {
          let (_, fty) = Array::get(resolved_fields, fj)
          Array::push(field_types, fty)
          fj = fj + 1
        }
        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))
        let env2 = if struct_derives_has(derives, "Ord") {
          env_bind(env1, String::concat(name, "::compare"), CtFn([
            CtStruct(name),
            CtStruct(name)
          ], CtInt, None))
        } else {
          env1
        }
        let env3 = if struct_derives_has(derives, "Show") {
          env_bind(env2, String::concat(name, "::to_string"), CtFn([
            CtStruct(name)
          ], CtString, None))
        } else {
          env2
        }
        (bind_fn_return(env3, name, CtStruct(name)), s, c)
      },
      STypeAlias(_, name, params, te) => {
        let t = resolve_type_expr(te, defs)
        Array::push(defs, TDAlias(name, params, t))
        (env_bind(env, name, t), s, c)
      },
      SExternLet(name, te) => {
        let t = resolve_type_expr(te, defs)
        let env1 = env_bind(env, name, t)
        (bind_annotation_return(env1, name, Some(te), defs), s, c)
      },
      STest(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)
        (env, ns, nc)
      },
      SBench(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)
        (env, ns, nc)
      },
      SExpr(expr) => {
        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)
        (env, ns, nc)
      },
      SModule(_, _, body) => {
        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)
        (env, s, c)
      },
      SImport(_, names) => (bind_stmt_imports(env, names), s, c)
      ,
      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)
      ,
      SAliasDecl(_, _) => (env, s, c)
      ,
      STrait(_, name, supers, methods) => {
        let is_open = false
        (EnvTraitDef(name, supers, is_open, methods, env), s, c)
      },
      SImpl(tparams, tbounds, trait_name, type_name) => {
        let target = match resolve_builtin(type_name) {
          Some(t) => t,
          None => CtNamed(type_name, Array::slice([
            CtUnknown
          ], 0, 0))
        }
        let new_env = if Array::length(tparams) > 0 {
          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)
        } else {
          EnvTraitImpl(trait_name, target, env)
        }
        (new_env, s, c)
      },
      _ => (env, s, c)
    }
    cur_env = new_env
    cur_s = s1
    cur_c = c1
    idx = idx + 1
  }
  (cur_env, cur_s, cur_c)
}
let check_program_bounds: (TypeEnv, Subst, Array[String]) -> Unit = (env, s, errors) -> {
  let pairs = collect_subst_bounds_pairs(s)
  let n = Array::length(pairs)
  let mut i = 0
  while i < n {
    let (vid, bounds) = Array::get(pairs, i)
    let resolved = subst_apply(s, CtVar(vid))
    match resolved {
      CtVar(_) => (),
      CtUnknown => (),
      _ => {
        let bn = Array::length(bounds)
        let mut bi = 0
        while bi < bn {
          let b = Array::get(bounds, bi)
          if b != "" && not(type_implements_trait(env, s, resolved, b)) {
            Array::push(errors, String::concat("no impl `", String::concat(b, String::concat("` for `", String::concat(type_to_string(resolved), "`")))))
          }
          bi = bi + 1
        }
      }
    }
    i = i + 1
  }
}
let collect_async_effect_errors: (Array[Stmt], TypeEnv, Array[String]) -> Unit = (stmts, env, frozen_errors) -> {
  if Array::length(frozen_errors) == 0 {
    let eff_errs = check_async_effects_stmts(stmts, env)
    let mut i = 0
    while i < Array::length(eff_errs) {
      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))
      i = i + 1
    }
    if Array::length(frozen_errors) == 0 {
      let perform_errs = check_perform_effects_stmts(stmts)
      let mut j = 0
      while j < Array::length(perform_errs) {
        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))
        j = j + 1
      }
    }
    if Array::length(frozen_errors) == 0 {
      let mut_errs = check_mutability_stmts(stmts)
      let mut k = 0
      while k < Array::length(mut_errs) {
        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))
        k = k + 1
      }
    }
  }
}
export let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {
  let empty_defs = Array::slice([
    TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
  ], 0, 0)
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let tytab = Array::slice([
    (0, CtUnit)
  ], 0, 0)
  let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
  check_program_bounds(env, final_s, frozen_errors)
  collect_async_effect_errors(stmts, env, frozen_errors)
  if Array::length(frozen_errors) > 0 {
    throw(Array::get(frozen_errors, 0))
  }
  env
}
export let check_program_type_table: (Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } = (stmts) -> {
  let empty_defs = Array::slice([
    TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
  ], 0, 0)
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let tytab = Array::slice([
    (0, CtUnit)
  ], 0, 0)
  handle {
    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
    (tytab, final_s)
  } with Error {
    Throw(_) => (tytab, SubstEmpty)
  }
}
export let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {
  match initial_env {
    EnvEmpty => check_program(stmts),
    _ => {
      let empty_defs = Array::slice([
        TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
      ], 0, 0)
      let cached_env = env_cache(initial_env)
      let seeded_raw_env = if trait_defined(cached_env, "Eq") {
        cached_env
      } else {
        register_builtin_traits(cached_env)
      }
      let seeded_env = env_cache(seeded_raw_env)
      let errors = ArrayBuilder::new()
      let frozen_errors = ArrayBuilder::freeze(errors)
      let tytab = Array::slice([
        (0, CtUnit)
      ], 0, 0)
      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
      collect_async_effect_errors(stmts, env, frozen_errors)
      if Array::length(frozen_errors) > 0 {
        throw(Array::get(frozen_errors, 0))
      }
      env
    }
  }
}
export let emit_end: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, 11)
}
export let emit_i32_const: (Bytes, Int) -> Unit = (buf, value) -> {
  bytebuf_push_opcode_s64(buf, 65, value)
}
export let emit_code_section: (Bytes, Array[Bytes]) -> Unit = (out, bodies) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(bodies))
  let mut i = 0
  while i < Array::length(bodies) {
    let body = Array::get(bodies, i)
    let func_buf = bytebuf_new()
    leb128_encode_u32(func_buf, 0)
    bytebuf_push_buf(func_buf, body)
    bytebuf_push(func_buf, 11)
    leb128_encode_u32(content, bytebuf_length(func_buf))
    bytebuf_push_buf(content, func_buf)
    i = i + 1
  }
  bytebuf_push_section(out, 10, content)
}
export let emit_memory_section: (Bytes, Int) -> Unit = (out, min_pages) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, min_pages)
  bytebuf_push_section(out, 5, content)
}
export let emit_header: (Bytes) -> Unit = (buf) -> {
  bytebuf_push3(buf, 0, 97, 115)
  bytebuf_push3(buf, 109, 1, 0)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
}
export {
  emit_header, emit_func_type, emit_type_section, emit_type_section_multi
}
export let emit_name: (Bytes, String) -> Unit = (buf, name) -> {
  bytebuf_push_string(buf, name)
}
export let emit_function_section: (Bytes, Array[Int]) -> Unit = (out, type_indices) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, Array::length(type_indices))
  let mut i = 0
  while i < Array::length(type_indices) {
    leb128_encode_u32(content, Array::get(type_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 3, content)
}
export let emit_export_section_multi: (Bytes, Array[String], Array[Int]) -> Unit = (out, names, func_indices) -> {
  let count = Array::length(names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    emit_name(content, Array::get(names, i))
    bytebuf_push(content, 0)
    leb128_encode_u32(content, Array::get(func_indices, i))
    i = i + 1
  }
  bytebuf_push_section(out, 7, content)
}
export let emit_export_section: (Bytes, String, Int) -> Unit = (out, name, func_idx) -> {
  emit_export_section_multi(out, [
    name
  ], [
    func_idx
  ])
}
