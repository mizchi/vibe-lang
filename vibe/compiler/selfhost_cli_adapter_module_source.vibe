let op_i64_extend_i32_u = 173


let common_analysis_fresh_string_array: () -> Array[String] = () -> {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

export let rec collect_strings_expr: (Expr, Array[String]) -> Int = (expr, out) -> {
  match expr {
    EString(s) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(out) {
        if Array::get(out, i) == s {
          found = true
        }
        i = i + 1
      }
      if !found {
        Array::push(out, s)
      }
      0
    },
    EBinOp(_, lhs, rhs) => {
      collect_strings_expr(lhs, out)
      collect_strings_expr(rhs, out)
    },
    EUnaryOp(_, operand) => collect_strings_expr(operand, out),
    EIf(cond, then_e, else_e) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(then_e, out)
      collect_strings_expr(else_e, out)
    },
    ECall(callee, args) => {
      collect_strings_expr(callee, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_strings_expr(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    ELet(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetRec(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetMut(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssign(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssignOp(_, _, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ESeq(first, second) => {
      collect_strings_expr(first, out)
      collect_strings_expr(second, out)
    },
    EWhile(cond, body) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(body, out)
    },
    EForIn(_, _, iter_e, body) => {
      collect_strings_expr(iter_e, out)
      collect_strings_expr(body, out)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_strings_expr(Array::get(elems, i), out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_strings_expr(Array::get(elems, i), out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_strings_expr(scrutinee, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_expr) = Array::get(arms, i)
        match pat {
          PString(s) => {
            let mut pf = false
            let mut pi = 0
            while pi < Array::length(out) {
              if Array::get(out, pi) == s {
                pf = true
              }
              pi = pi + 1
            }
            if !pf {
              Array::push(out, s)
            }
            0
          },
          _ => 0
        }
        collect_strings_expr(arm_expr, out)
        i = i + 1
      }
      0
    },
    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),
    EThrow(msg) => collect_strings_expr(msg, out),
    EReturn(msg) => collect_strings_expr(msg, out),
    EStringInterp(parts) => {
      let mut si_p = 0
      while si_p < Array::length(parts) {
        if si_p % 2 == 0 {
          let part = Array::get(parts, si_p)
          if String::length(part) > 0 {
            let mut found = false
            let mut fi2 = 0
            while fi2 < Array::length(out) {
              if Array::get(out, fi2) == part { found = true }
              fi2 = fi2 + 1
            }
            if !found { Array::push(out, part) }
          }
        }
        si_p = si_p + 1
      }
      0
    },
    EHandle(body, arms) => {
      collect_strings_expr(body, out)
      let mut hi = 0
      while hi < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, hi)
        collect_strings_expr(arm_expr, out)
        hi = hi + 1
      }
      0
    },
    EMap(fields) => {
      let mut mi = 0
      while mi < Array::length(fields) {
        let (key, val) = Array::get(fields, mi)
        let mut kf = false
        let mut ki = 0
        while ki < Array::length(out) {
          if Array::get(out, ki) == key { kf = true }
          ki = ki + 1
        }
        if !kf { Array::push(out, key) }
        collect_strings_expr(val, out)
        mi = mi + 1
      }
      0
    },
    ERecord(fields) => {
      let mut ri = 0
      while ri < Array::length(fields) {
        let (_, fval) = Array::get(fields, ri)
        collect_strings_expr(fval, out)
        ri = ri + 1
      }
      0
    },
    EDot(obj, _) => collect_strings_expr(obj, out),
    ELabeledArg(_, _, val) => collect_strings_expr(val, out),
    _ => 0
  }
}

export let get_func_param_names: (Stmt) -> Array[String] with { Error } = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, params, _, _, _) => {
        let names = common_analysis_fresh_string_array()
        let mut i = 0
        while i < Array::length(params) {
          let (pname, _) = Array::get(params, i)
          let plen2 = String::length(pname)
          let clean_name = if plen2 > 0 {
            let last_char = String::char_code_at(pname, plen2 - 1)
            if last_char == '~' || last_char == '?' {
              pname[0:plen2 - 1]
            } else pname
          } else pname
          Array::push(names, clean_name)
          i = i + 1
        }
        names
      },
      _ => throw("get_func_param_names: not a function")
    },
    _ => throw("get_func_param_names: not a let statement")
  }
}

export let collect_strings_stmts: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let out = common_analysis_fresh_string_array()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),
      _ => 0
    }
    i = i + 1
  }
  out
}

export let emit_i64_extend_i32_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, op_i64_extend_i32_u)
}

export let emit_closure_resolve: (Bytes, Int, Int, Int) -> Unit = (buf, fn_val_local, slot_local, env_local) -> {
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 3)
  emit_i64_and(buf)
  emit_i64_const(buf, 2)
  emit_i64_eq(buf)
  emit_if_void(buf)
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 2)
  emit_i64_shr_s(buf)
  emit_local_set(buf, slot_local)
  emit_i64_const(buf, 0)
  emit_local_set(buf, env_local)
  emit_else(buf)
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, -4)
  emit_i64_and(buf)
  emit_local_set(buf, env_local)
  emit_local_get(buf, env_local)
  emit_i32_wrap_i64(buf)
  emit_i32_load(buf, 2, 0)
  emit_i64_extend_i32_u(buf)
  emit_local_set(buf, slot_local)
  emit_end(buf)
}

export let emit_closure_call_tail: (Bytes, Int, Int, Int, Int) -> Unit = (buf, env_local, slot_local, closure_type_base, num_args) -> {
  emit_local_get(buf, env_local)
  emit_local_get(buf, slot_local)
  emit_i32_wrap_i64(buf)
  emit_call_indirect(buf, closure_type_base + num_args)
}

let rec collect_pattern_bindings: (Pat, Array[String]) -> Int = (pat, bindings) -> {
  match pat {
    PBind(name) => {
      Array::push(bindings, name); 0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        collect_pattern_bindings(Array::get(pats, i), bindings)
        i = i + 1
      }
      0
    },
    PCtor(_, args) => {
      let mut i = 0
      while i < Array::length(args) {
        collect_pattern_bindings(Array::get(args, i), bindings)
        i = i + 1
      }
      0
    },
    POr(l, r) => {
      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fpat) = Array::get(fields, i)
        collect_pattern_bindings(fpat, bindings)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

let is_inlined_async_builtin: (String) -> Bool = (name) -> {
  name == "await" || name == "Future::ready" || name == "Task::spawn" || name == "Task::join" || name == "Task::cancel" || name == "Task::race" || name == "Task::timeout" || name == "Stream::empty" || name == "Stream::once" || name == "Stream::map" || name == "Stream::filter" || name == "Stream::fold" || name == "Stream::next" || name == "String::to_bytes" || name == "Stream::to_string"
}

export let rec collect_free_vars_expr: (Expr, Array[String], Array[String], Array[String]) -> Int = (expr, bound, fn_names, out) -> {
  match expr {
    EIdent(name) => if array_contains_str(bound, name) {
      0
    }
    else if array_contains_str(fn_names, name) {
      0
    }
    else if is_inlined_async_builtin(name) {
      0
    }
    else if array_contains_str(out, name) {
      0
    }
    else {
      Array::push(out, name)
      0
    },
    EInt(_) => 0,
    EBool(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EUnit => 0,
    EBinOp(_, lhs, rhs) => {
      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)
    },
    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),
    EIf(cond, then_e, else_e) => {
      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)
    },
    ECall(callee, args) => {
      collect_free_vars_expr(callee, bound, fn_names, out)
      let mut i = 0
      while i < Array::length(args) {
        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)
        i = i + 1
      }
      0
    },
    ELet(name, value, body) => {
      collect_free_vars_expr(value, bound, fn_names, out)
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr(body, bound, fn_names, out)
      Array::truncate(bound, saved)
      0
    },
    ELetRec(name, value, body) => {
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr(value, bound, fn_names, out)
      collect_free_vars_expr(body, bound, fn_names, out)
      Array::truncate(bound, saved)
      0
    },
    ELetMut(name, value, body) => {
      collect_free_vars_expr(value, bound, fn_names, out)
      let saved = Array::length(bound)
      Array::push(bound, name)
      collect_free_vars_expr(body, bound, fn_names, out)
      Array::truncate(bound, saved)
      0
    },
    EAssign(_, value, body) => {
      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)
    },
    EAssignOp(_, _, value, body) => {
      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)
    },
    ESeq(first, second) => {
      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)
    },
    EWhile(cond, body) => {
      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)
    },
    EForIn(var_name, index_name, iter_e, body) => {
      collect_free_vars_expr(iter_e, bound, fn_names, out)
      let saved = Array::length(bound)
      Array::push(bound, var_name)
      match index_name {
        Some(index_name) => Array::push(bound, index_name),
        None => ()
      }
      collect_free_vars_expr(body, bound, fn_names, out)
      Array::truncate(bound, saved)
      0
    },
    ETuple(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < Array::length(elems) {
        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_free_vars_expr(scrutinee, bound, fn_names, out)
      let mut i = 0
      while i < Array::length(arms) {
        let (arm_pat, arm_expr) = Array::get(arms, i)
        let saved = Array::length(bound)
        collect_pattern_bindings(arm_pat, bound)
        collect_free_vars_expr(arm_expr, bound, fn_names, out)
        Array::truncate(bound, saved)
        i = i + 1
      }
      0
    },
    EFn(_, _, params, _, _, body) => {
      let saved = Array::length(bound)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname_raw, _) = Array::get(params, pi)
        let pnl = String::length(pname_raw)
        let pname = if pnl > 0 {
          let plc = String::char_code_at(pname_raw, pnl - 1)
          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw
        } else pname_raw
        Array::push(bound, pname)
        pi = pi + 1
      }
      collect_free_vars_expr(body, bound, fn_names, out)
      Array::truncate(bound, saved)
      0
    },
    EBreak(_) => 0,
    EContinue(_) => 0,
    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),
    EReturn(msg) => collect_free_vars_expr(msg, bound, fn_names, out),
    EHandle(body, arms) => {
      collect_free_vars_expr(body, bound, fn_names, out)
      let mut hi = 0
      while hi < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, hi)
        collect_free_vars_expr(arm_expr, bound, fn_names, out)
        hi = hi + 1
      }
      0
    },
    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),
    ERecord(fields) => {
      let mut ri = 0
      while ri < Array::length(fields) {
        let (_, fval) = Array::get(fields, ri)
        collect_free_vars_expr(fval, bound, fn_names, out)
        ri = ri + 1
      }
      0
    },
    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),
    _ => 0
  }
}

export let collect_free_vars: (Expr, Array[String], Array[String]) -> Array[String] = (body, param_names, fn_names) -> {
  let out = common_analysis_fresh_string_array()
  let bound = Array::slice(param_names, 0, Array::length(param_names))
  collect_free_vars_expr(body, bound, fn_names, out)
  out
}

export let rec proj_root_ident: (Expr) -> String = (e) -> {
  match e {
    EDot(obj, _) => proj_root_ident(obj),
    EIdent(nm) => nm,
    _ => ""
  }
}

export let rec scope_tail_proj_root: (Expr) -> String = (e) -> {
  match e {
    ELet(_, _, b) => scope_tail_proj_root(b),
    ELetMut(_, _, b) => scope_tail_proj_root(b),
    ELetRec(_, _, b) => scope_tail_proj_root(b),
    ESeq(_, b) => scope_tail_proj_root(b),
    EAssign(_, _, b) => scope_tail_proj_root(b),
    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),
    EDot(obj, _) => proj_root_ident(obj),
    _ => ""
  }
}

export let rec is_mut_captured_in: (Expr, String) -> Bool = (expr, name) -> {
  match expr {
    EIdent(_) => false,
    EInt(_) => false,
    EBool(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EUnit => false,
    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),
    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),
    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),
    ECall(callee, args) => if is_mut_captured_in(callee, name) {
      true
    }
    else {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if is_mut_captured_in(Array::get(args, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    ELet(n, value, body) => if n == name {
      is_mut_captured_in(value, name)
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    ELetRec(n, value, body) => if n == name {
      false
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    ELetMut(n, value, body) => if n == name {
      is_mut_captured_in(value, name)
    }
    else {
      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)
    },
    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),
    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),
    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if is_mut_captured_in(Array::get(elems, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if is_mut_captured_in(Array::get(elems, i), name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {
      true
    }
    else {
      let mut i = 0
      let mut found = false
      while i < Array::length(arms) {
        let (_, arm_expr) = Array::get(arms, i)
        if is_mut_captured_in(arm_expr, name) {
          found = true
        }
        i = i + 1
      }
      found
    },
    EFn(_, _, params, _, _, fn_body) => {
      let mut shadowed = false
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, _) = Array::get(params, pi)
        if pname == name {
          shadowed = true
        }
        pi = pi + 1
      }
      if shadowed {
        false
      }
      else {
        let param_names = Array::slice([
          ""
        ], 0, 0)
        let mut pi2 = 0
        while pi2 < Array::length(params) {
          let (pname2, _) = Array::get(params, pi2)
          Array::push(param_names, pname2)
          pi2 = pi2 + 1
        }
        let fv = collect_free_vars(fn_body, param_names, Array::slice([
          ""
        ], 0, 0))
        if array_contains_str(fv, name) {
          true
        }
        else {
          is_mut_captured_in(fn_body, name)
        }
      }
    },
    EBreak(_) => false,
    EContinue(_) => false,
    EThrow(msg) => is_mut_captured_in(msg, name),
    EReturn(msg) => is_mut_captured_in(msg, name),
    _ => false
  }
}





export enum PerceusActionKind {
  PaDup;
  PaDrop;
  PaAliasDup
}

export struct PerceusAction {
  kind: PerceusActionKind;
  name: String
}

struct PCtx {
  mut next_id: Int;
  mut seq_id: Int;
  pctx_names: Array[String];
  uses: Array[Int];
  borrows: Array[Int];
  scalar: Array[Bool];
  remaining: Array[Int];
  actions: Array[PerceusAction]
}

struct HeapInferCtx {
  ctors: Array[String];
  heap_fns: Array[String]
}


let zeros: (Int) -> Array[Int] = (n) -> {
  let out: Array[Int] = [
  ]
  let mut i = 0
  while i < n {
    Array::push(out, 0)
    i = i + 1
  }
  out
}

let int_max: (Int, Int) -> Int = (a, b) -> {
  if a > b {
    a
  } else {
    b
  }
}

let name_in: (Array[String], String) -> Bool = (arr, s) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if Array::get(arr, i) == s {
      found = true
    } else {
      ()
    }
    i = i + 1
  }
  found
}

let pe_push: (PCtx, PerceusActionKind, String) -> Int = (ctx, kind, name) -> {
  Array::push(ctx.actions, PerceusAction::{
    kind: kind, name: name
  })
  0
}

let pe_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    let rem = Array::get(ctx.remaining, id)
    if rem > 1 && !Array::get(ctx.scalar, id) {
      pe_push(ctx, PaDup, name)
    } else {
      0
    }
    if rem > 0 {
      Array::set(ctx.remaining, id, rem - 1)
    }
  }
  0
}

let pctx_new: () -> PCtx = () -> {
  PCtx::{
    next_id: 0,
    seq_id: 0,
    pctx_names: [
    ],
    uses: [
    ],
    borrows: [
    ],
    scalar: [
    ],
    remaining: [
    ],
    actions: [
    ],
  }
}

let copy_ints: (Array[Int]) -> Array[Int] = (src) -> {
  let out: Array[Int] = [
  ]
  let mut i = 0
  while i < Array::length(src) {
    Array::push(out, Array::get(src, i))
    i = i + 1
  }
  out
}

export let pa_is_dup: (PerceusAction) -> Bool = (a) -> {
  match a.kind {
    PaDup => true,
    PaDrop => false,
    PaAliasDup => false
  }
}

let rec pat_names: (Pat, Array[String]) -> Int = (pat, out) -> {
  match pat {
    PBind(name) => {
      Array::push(out, name)
      0
    },
    PCtor(_n, args) => {
      let mut i = 0
      while i < Array::length(args) {
        pat_names(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    PTuple(pats) => {
      let mut i = 0
      while i < Array::length(pats) {
        pat_names(Array::get(pats, i), out)
        i = i + 1
      }
      0
    },
    POr(l, _r) => pat_names(l, out),
    PStruct(_n, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pat_names((Array::get(fields, i)).1, out)
        i = i + 1
      }
      0
    },
    _ => 0
  }
}

export let pa_is_drop: (PerceusAction) -> Bool = (a) -> {
  match a.kind {
    PaDrop => true,
    PaDup => false,
    PaAliasDup => false
  }
}

let pc_declare: (PCtx, String, Bool) -> Int = (ctx, name, scalar) -> {
  let id = ctx.next_id
  Array::push(ctx.pctx_names, name)
  Array::push(ctx.uses, 0)
  Array::push(ctx.borrows, 0)
  Array::push(ctx.scalar, scalar)
  ctx.next_id = id + 1
  id
}

let pe_declare: (PCtx, String) -> Int = (ctx, _name) -> {
  let id = ctx.next_id
  let owning = Array::get(ctx.uses, id)
  let init = if owning == 0 {
    1
  } else {
    owning
  }
  Array::push(ctx.remaining, init)
  ctx.next_id = id + 1
  id
}

let pc_count_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)
  }
  0
}

let pe_scope_end: (PCtx, Int, String) -> Int = (ctx, id, name) -> {
  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {
    pe_push(ctx, PaDrop, name)
    Array::set(ctx.remaining, id, 0)
  }
  0
}

let next_seq_name: (PCtx) -> String = (ctx) -> {
  let nm = "__seq" + __to_string(ctx.seq_id)
  ctx.seq_id = ctx.seq_id + 1
  nm
}

let fn_param_names: (Array[(String, Option[TypeExpr])]) -> Array[String] = (params) -> {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(params) {
    Array::push(out, (Array::get(params, i)).0)
    i = i + 1
  }
  out
}

let is_scalar_expr: (Expr) -> Bool = (e) -> {
  match e {
    EInt(_) => true,
    EBool(_) => true,
    EFloat(_) => true,
    EUnit => true,
    _ => false
  }
}

let pat_shadow_env: (Pat, Map[String, Bool]) -> Map[String, Bool] = (pat, env) -> {
  let names: Array[String] = [
  ]
  pat_names(pat, names)
  let mut env2 = env
  let mut j = 0
  while j < Array::length(names) {
    env2 = Map::set(env2, Array::get(names, j), false)
    j = j + 1
  }
  env2
}

let restore_prefix: (Array[Int], Array[Int]) -> Int = (dst, src) -> {
  let mut i = 0
  while i < Array::length(src) {
    Array::set(dst, i, Array::get(src, i))
    i = i + 1
  }
  0
}

let is_heap_literal: (Expr) -> Bool = (e) -> {
  match e {
    ETuple(_) => true,
    EArray(_) => true,
    ERecord(_) => true,
    _ => false
  }
}

let is_heap_value: (Expr, Map[String, Bool], HeapInferCtx) -> Bool = (e, env, hctx) -> {
  if is_heap_literal(e) {
    true
  } else {
    match e {
      ECall(callee, args) =>
      match callee {
        EIdent(c) =>
        if Map::has_key(env, c) {
          false
        } else {
          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||
          name_in(hctx.heap_fns, c)
        },
        _ => false
      },
      _ => false
    }
  }
}

let arg_class: (Expr, Map[String, Bool], HeapInferCtx) -> Bool = (arg, env, hctx) -> {
  if is_heap_value(arg, env, hctx) {
    true
  } else {
    match arg {
      EIdent(n) => if Map::has_key(env, n) {
        Map::get(env, n)
      } else {
        false
      },
      _ => false
    }
  }
}

let rec analyze_calls: (String, Expr, Map[String, Bool], Array[Array[Bool]], Array[Bool], HeapInferCtx) -> Int = (name, e, env, calls, esc, hctx) -> {
  match e {
    EIdent(n) => {
      if n == name {
        Array::set(esc, 0, true)
      } else {
        ()
      }
      0
    },
    ECall(callee, args) => {
      let is_self = match callee {
        EIdent(cn) => cn == name,
        _ => false
      }
      if is_self {
        let cls: Array[Bool] = [
        ]
        let mut k = 0
        while k < Array::length(args) {
          Array::push(cls, arg_class(Array::get(args, k), env, hctx))
          k = k + 1
        }
        Array::push(calls, cls)
      } else {
        let _ = analyze_calls(name, callee, env, calls, esc, hctx)
        ()
      }
      let mut i = 0
      while i < Array::length(args) {
        analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)
        i = i + 1
      }
      0
    },
    EDot(obj, _) => analyze_calls(name, obj, env, calls, esc, hctx),
    ELet(n, v, b) => {
      analyze_calls(name, v, env, calls, esc, hctx)
      analyze_calls(name, b, Map::set(env, n, is_heap_value(v, env, hctx)), calls, esc, hctx)
      0
    },
    ELetRec(n, v, b) => {
      let env2 = Map::set(env, n, false)
      analyze_calls(name, v, env2, calls, esc, hctx)
      analyze_calls(name, b, env2, calls, esc, hctx)
      0
    },
    ELetMut(n, v, b) => {
      analyze_calls(name, v, env, calls, esc, hctx)
      analyze_calls(name, b, Map::set(env, n, false), calls, esc, hctx)
      0
    },
    EAssign(_, v, c) => {
      analyze_calls(name, v, env, calls, esc, hctx)
      analyze_calls(name, c, env, calls, esc, hctx)
      0
    },
    EAssignOp(_, _, v, c) => {
      analyze_calls(name, v, env, calls, esc, hctx)
      analyze_calls(name, c, env, calls, esc, hctx)
      0
    },
    ESeq(a, b) => {
      analyze_calls(name, a, env, calls, esc, hctx)
      analyze_calls(name, b, env, calls, esc, hctx)
      0
    },
    EIf(c, t, el) => {
      analyze_calls(name, c, env, calls, esc, hctx)
      analyze_calls(name, t, env, calls, esc, hctx)
      analyze_calls(name, el, env, calls, esc, hctx)
      0
    },
    EWhile(c, b) => {
      analyze_calls(name, c, env, calls, esc, hctx)
      analyze_calls(name, b, env, calls, esc, hctx)
      0
    },
    EForIn(v0, ix, it, b) => {
      analyze_calls(name, it, env, calls, esc, hctx)
      let env1 = Map::set(env, v0, false)
      let env2 = match ix {
        Some(ixn) => Map::set(env1, ixn, false),
        None => env1
      }
      analyze_calls(name, b, env2, calls, esc, hctx)
      0
    },
    EBinOp(_, l, r) => {
      analyze_calls(name, l, env, calls, esc, hctx)
      analyze_calls(name, r, env, calls, esc, hctx)
      0
    },
    EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),
    EFn(_, _, params, _, _, b) => {
      let mut env2 = env
      let mut pi = 0
      while pi < Array::length(params) {
        let (pn, _) = Array::get(params, pi)
        env2 = Map::set(env2, pn, false)
        pi = pi + 1
      }
      analyze_calls(name, b, env2, calls, esc, hctx)
      0
    },
    ETuple(xs) => {
      let mut i = 0
      while i < Array::length(xs) {
        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
        i = i + 1
      }
      0
    },
    EArray(xs) => {
      let mut i = 0
      while i < Array::length(xs) {
        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
        i = i + 1
      }
      0
    },
    EMatch(s, arms) => {
      analyze_calls(name, s, env, calls, esc, hctx)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, ab) = Array::get(arms, i)
        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)
        i = i + 1
      }
      0
    },
    EHandle(b, arms) => {
      analyze_calls(name, b, env, calls, esc, hctx)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, ab) = Array::get(arms, i)
        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)
        i = i + 1
      }
      0
    },
    ELoop(ps, b) => {
      let mut env2 = env
      let mut i = 0
      while i < Array::length(ps) {
        let (pn, iv) = Array::get(ps, i)
        analyze_calls(name, iv, env2, calls, esc, hctx)
        env2 = Map::set(env2, pn, false)
        i = i + 1
      }
      analyze_calls(name, b, env2, calls, esc, hctx)
      0
    },
    ERecord(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fv) = Array::get(fs, i)
        analyze_calls(name, fv, env, calls, esc, hctx)
        i = i + 1
      }
      0
    },
    EMap(fs) => {
      let mut i = 0
      while i < Array::length(fs) {
        let (_, fv) = Array::get(fs, i)
        analyze_calls(name, fv, env, calls, esc, hctx)
        i = i + 1
      }
      0
    },
    ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),
    EThrow(x) => analyze_calls(name, x, env, calls, esc, hctx),
    EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),
    ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),
    EBreak(o) =>
    match o {
      Some(x) => analyze_calls(name, x, env, calls, esc, hctx),
      None => 0
    },
    EContinue(xs) => {
      let mut i = 0
      while i < Array::length(xs) {
        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)
        i = i + 1
      }
      0
    },
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EStringInterp(_) => 0,
    EUnit => 0
  }
}

export let pa_is_alias_dup: (PerceusAction) -> Bool = (a) -> {
  match a.kind {
    PaAliasDup => true,
    PaDup => false,
    PaDrop => false
  }
}

let pc_count_borrow: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {
  if Map::has_key(scope, name) {
    let id = Map::get(scope, name)
    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)
  }
  0
}

let rec type_contains_fn: (TypeExpr) -> Bool = (t) -> {
  match t {
    TyFn(_, _, _) => true,
    TyTuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if type_contains_fn(Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyApp(_, args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if type_contains_fn(Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    TyName(_) => false,
    TyUnit => false
  }
}

let all_calls_heap_at: (Int, Array[Array[Bool]]) -> Bool = (idx, calls) -> {
  let mut ci = 0
  let mut all_heap = true
  while ci < Array::length(calls) {
    let cls = Array::get(calls, ci)
    if idx >= Array::length(cls) {
      all_heap = false
    } else if !Array::get(cls, idx) {
      all_heap = false
    } else {
      ()
    }
    ci = ci + 1
  }
  all_heap
}

let type_name_is_heap: (String) -> Bool = (n) -> {
  if String::length(n) == 0 {
    false
  } else {
    let c0 = String::char_code_at(n, 0)
    if c0 < 'A' || c0 > 'Z' {
      false
    } else if n == "Int" || n == "Bool" || n == "Double" || n == "Float" || n == "String" || n == "Bytes" || n == "Char" || n == "Unit" {
      false
    } else {
      true
    }
  }
}

export let type_expr_is_heap: (Option[TypeExpr]) -> Bool = (ot) -> {
  match ot {
    None => false,
    Some(t) =>
    if type_contains_fn(t) {
      false
    } else {
      match t {
        TyTuple(_) => true,
        TyApp(_, _) => true,
        TyName(n) => type_name_is_heap(n),
        TyFn(_, _, _) => false,
        TyUnit => false
      }
    }
  }
}

let collect_ctor_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(_, _, _, variants) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (vn, _) = Array::get(variants, j)
          Array::push(out, vn)
          j = j + 1
        }
      },
      SSuberror(_, _, variants) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (vn, _) = Array::get(variants, j)
          Array::push(out, vn)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

let inferred_heap_type: () -> TypeExpr = () -> {
  TyTuple(Array::slice([
    TyUnit
  ], 0, 0))
}

let fill_lambda_params: (String, Expr, Expr, HeapInferCtx) -> Expr = (name, efn, body, hctx) -> {
  match efn {
    EFn(tps, bounds, params, ret, eff, fnbody) => {
      let calls: Array[Array[Bool]] = [
      ]
      let esc = [
        false
      ]
      let env0: Map[String, Bool] = map {
      }
      analyze_calls(name, body, env0, calls, esc, hctx)
      if Array::get(esc, 0) || Array::length(calls) == 0 {
        efn
      } else {
        let new_params = Array::slice(params, 0, 0)
        let mut pi = 0
        while pi < Array::length(params) {
          let (pname, pty) = Array::get(params, pi)
          let filled = match pty {
            Some(_) => (pname, pty),
            None =>
            if all_calls_heap_at(pi, calls) {
              (pname, Some(inferred_heap_type()))
            } else {
              (pname, pty)
            }
          }
          Array::push(new_params, filled)
          pi = pi + 1
        }
        EFn(tps, bounds, new_params, ret, eff, fnbody)
      }
    },
    _ => efn
  }
}

let rec elaborate_rw: (Expr, HeapInferCtx) -> Expr = (e, hctx) -> {
  match e {
    ELet(n, v, b) => {
      let v2 = elaborate_rw(v, hctx)
      let v3 = fill_lambda_params(n, v2, b, hctx)
      ELet(n, v3, elaborate_rw(b, hctx))
    },
    ELetRec(n, v, b) => {
      let v2 = elaborate_rw(v, hctx)
      let v3 = fill_lambda_params(n, v2, b, hctx)
      ELetRec(n, v3, elaborate_rw(b, hctx))
    },
    ELetMut(n, v, b) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx)),
    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),
    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),
    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),
    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),
    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),
    EFn(tps, bounds, params, ret, eff, fb) =>
    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),
    ECall(callee, args) => {
      let new_args = Array::slice(args, 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))
        i = i + 1
      }
      ECall(elaborate_rw(callee, hctx), new_args)
    },
    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),
    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),
    EDot(o, f) => EDot(elaborate_rw(o, hctx), f),
    ETuple(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      ETuple(ys)
    },
    EArray(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      EArray(ys)
    },
    EMatch(s, arms) => {
      let new_arms = Array::slice(arms, 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))
        i = i + 1
      }
      EMatch(elaborate_rw(s, hctx), new_arms)
    },
    EHandle(b, arms) => {
      let new_arms = Array::slice(arms, 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (p, ab) = Array::get(arms, i)
        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))
        i = i + 1
      }
      EHandle(elaborate_rw(b, hctx), new_arms)
    },
    ELoop(ps, b) => {
      let new_ps = Array::slice(ps, 0, 0)
      let mut i = 0
      while i < Array::length(ps) {
        let (pn, iv) = Array::get(ps, i)
        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))
        i = i + 1
      }
      ELoop(new_ps, elaborate_rw(b, hctx))
    },
    ERecord(fs) => {
      let new_fs = Array::slice(fs, 0, 0)
      let mut i = 0
      while i < Array::length(fs) {
        let (fn0, fv) = Array::get(fs, i)
        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))
        i = i + 1
      }
      ERecord(new_fs)
    },
    EMap(fs) => {
      let new_fs = Array::slice(fs, 0, 0)
      let mut i = 0
      while i < Array::length(fs) {
        let (fn0, fv) = Array::get(fs, i)
        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))
        i = i + 1
      }
      EMap(new_fs)
    },
    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),
    EThrow(x) => EThrow(elaborate_rw(x, hctx)),
    EReturn(x) => EReturn(elaborate_rw(x, hctx)),
    ESpread(x) => ESpread(elaborate_rw(x, hctx)),
    EBreak(o) =>
    match o {
      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),
      None => EBreak(None)
    },
    EContinue(xs) => {
      let ys = Array::slice(xs, 0, 0)
      let mut i = 0
      while i < Array::length(xs) {
        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))
        i = i + 1
      }
      EContinue(ys)
    },
    EInt(_) => e,
    EFloat(_) => e,
    EString(_) => e,
    EBool(_) => e,
    EIdent(_) => e,
    EStringInterp(_) => e,
    EUnit => e
  }
}

let is_borrow_arg0_call: (String) -> Bool = (f) -> {
  f == "__index" || f == "Array::get" || f == "Array::length" || f == "Array::set" || f == "Array::push" || f == "ArrayBuilder::push" || f == "MapBuilder::set" || f == "Map::get" || f == "Map::keys" || f == "Map::has_key" || f == "Map::set"
}

export let rec pc_emit: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x) => pe_use(ctx, scope, x),
    ECall(callee, args) => {
      let is_index = match callee {
        EIdent(f) => is_borrow_arg0_call(f),
        _ => false
      }
      match callee {
        EIdent(_) => 0,
        _ => pc_emit(ctx, scope, callee)
      }
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if is_index && i == 0 {
          match arg {
            EIdent(_) => 0,
            _ => pc_emit(ctx, scope, arg)
          }
        } else {
          pc_emit(ctx, scope, arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field) => match obj {
      EIdent(_) => 0,
      _ => pc_emit(ctx, scope, obj)
    }
    ,
    ELet(name, value, body) => {
      match value {
        EIdent(src) => {
          if Map::has_key(scope, src) {
            let sid = Map::get(scope, src)
            let rem = Array::get(ctx.remaining, sid)
            if rem > 1 && !Array::get(ctx.scalar, sid) {
              pe_push(ctx, PaAliasDup, name)
            } else {
              0
            }
            if rem > 0 {
              Array::set(ctx.remaining, sid, rem - 1)
            }
          } else {
            ()
          }
          0
        },
        _ => pc_emit(ctx, scope, value)
      }
      let id = pe_declare(ctx, name)
      pc_emit(ctx, Map::set(scope, name, id), body)
      pe_scope_end(ctx, id, name)
    },
    ELetMut(name, value, body) => {
      pc_emit(ctx, scope, value)
      let id = pe_declare(ctx, name)
      pc_emit(ctx, Map::set(scope, name, id), body)
      pe_scope_end(ctx, id, name)
    },
    ELetRec(name, value, body) => {
      let id = pe_declare(ctx, name)
      let s2 = Map::set(scope, name, id)
      pc_emit(ctx, s2, value)
      pc_emit(ctx, s2, body)
      pe_scope_end(ctx, id, name)
    },
    EAssign(_name, value, body) => {
      pc_emit(ctx, scope, value)
      pc_emit(ctx, scope, body)
    },
    EAssignOp(_op, _name, value, body) => {
      pc_emit(ctx, scope, value)
      pc_emit(ctx, scope, body)
    },
    ESeq(a, b) => {
      pc_emit(ctx, scope, a)
      let nm = next_seq_name(ctx)
      let id = pe_declare(ctx, nm)
      pc_emit(ctx, scope, b)
      pe_scope_end(ctx, id, nm)
    },
    EBinOp(_op, l, r) => {
      pc_emit(ctx, scope, l)
      pc_emit(ctx, scope, r)
    },
    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_emit(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    ERecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_emit(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_emit(ctx, scope, cond)
      let snap = copy_ints(ctx.remaining)
      pc_emit(ctx, scope, then_e)
      restore_prefix(ctx.remaining, snap)
      pc_emit(ctx, scope, else_e)
      0
    },
    EWhile(cond, body) => {
      pc_emit(ctx, scope, cond)
      pc_emit(ctx, scope, body)
    },
    EReturn(e) => pc_emit(ctx, scope, e),
    EThrow(e) => pc_emit(ctx, scope, e),
    ESpread(e) => pc_emit(ctx, scope, e),
    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),
    EBreak(opt) => match opt {
      Some(e) => pc_emit(ctx, scope, e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(fbody, fn_param_names(params), [
      ])
      let mut i = 0
      while i < Array::length(caps) {
        pe_use(ctx, scope, Array::get(caps, i))
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_emit(ctx, scope, iterable)
      let idv = pe_declare(ctx, value_name)
      let s2 = Map::set(scope, value_name, idv)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pe_declare(ctx, idx)
          Map::set(s2, idx, idi)
        },
        None => s2
      }
      pc_emit(ctx, s3, fbody)
      pe_scope_end(ctx, idv, value_name)
    },
    ELoop(params, lbody) => {
      let mut s = scope
      let pids: Array[Int] = [
      ]
      let pnames: Array[String] = [
      ]
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, i)
        pc_emit(ctx, scope, p.1)
        let pid = pe_declare(ctx, p.0)
        s = Map::set(s, p.0, pid)
        Array::push(pids, pid)
        Array::push(pnames, p.0)
        i = i + 1
      }
      pc_emit(ctx, s, lbody)
      let mut j = 0
      while j < Array::length(pids) {
        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
        j = j + 1
      }
      0
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(_) => 0,
        _ => pc_emit(ctx, scope, scrut)
      }
      let snap = copy_ints(ctx.remaining)
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.remaining, snap)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let pids: Array[Int] = [
        ]
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pe_declare(ctx, nm)
          s = Map::set(s, nm, pid)
          Array::push(pids, pid)
          k = k + 1
        }
        pc_emit(ctx, s, arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
          j = j + 1
        }
        a = a + 1
      }
      0
    },
    EHandle(hbody, arms) => {
      let snap = copy_ints(ctx.remaining)
      pc_emit(ctx, scope, hbody)
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.remaining, snap)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let pids: Array[Int] = [
        ]
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pe_declare(ctx, nm)
          s = Map::set(s, nm, pid)
          Array::push(pids, pid)
          k = k + 1
        }
        pc_emit(ctx, s, arm.1)
        let mut j = 0
        while j < Array::length(pids) {
          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))
          j = j + 1
        }
        a = a + 1
      }
      0
    },
    _ => 0
  }
}

export let rec pc_count: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EStringInterp(_) => 0,
    EIdent(x) => pc_count_use(ctx, scope, x),
    ECall(callee, args) => {
      match callee {
        EIdent(f) => if is_borrow_arg0_call(f) {
          0
        } else {
          pc_count_borrow(ctx, scope, f)
        }
        ,
        _ => pc_count(ctx, scope, callee)
      }
      let is_index = match callee {
        EIdent(f) => is_borrow_arg0_call(f),
        _ => false
      }
      let mut i = 0
      while i < Array::length(args) {
        let arg = Array::get(args, i)
        if is_index && i == 0 {
          match arg {
            EIdent(obj) => pc_count_borrow(ctx, scope, obj),
            _ => pc_count(ctx, scope, arg)
          }
        } else {
          pc_count(ctx, scope, arg)
        }
        i = i + 1
      }
      0
    },
    EDot(obj, _field) => match obj {
      EIdent(x) => pc_count_borrow(ctx, scope, x),
      _ => pc_count(ctx, scope, obj)
    }
    ,
    ELet(name, value, body) => {
      pc_count(ctx, scope, value)
      let id = pc_declare(ctx, name, is_scalar_expr(value))
      pc_count(ctx, Map::set(scope, name, id), body)
    },
    ELetMut(name, value, body) => {
      pc_count(ctx, scope, value)
      let id = pc_declare(ctx, name, is_scalar_expr(value))
      pc_count(ctx, Map::set(scope, name, id), body)
    },
    ELetRec(name, value, body) => {
      let id = pc_declare(ctx, name, false)
      let s2 = Map::set(scope, name, id)
      pc_count(ctx, s2, value)
      pc_count(ctx, s2, body)
    },
    EAssign(_name, value, body) => {
      pc_count(ctx, scope, value)
      pc_count(ctx, scope, body)
    },
    EAssignOp(_op, _name, value, body) => {
      pc_count(ctx, scope, value)
      pc_count(ctx, scope, body)
    },
    ESeq(a, b) => {
      pc_count(ctx, scope, a)
      let nm = next_seq_name(ctx)
      let _id = pc_declare(ctx, nm, is_scalar_expr(a))
      pc_count(ctx, scope, b)
    },
    EBinOp(_op, l, r) => {
      pc_count(ctx, scope, l)
      pc_count(ctx, scope, r)
    },
    EUnaryOp(_op, e) => pc_count(ctx, scope, e),
    ETuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    EArray(items) => {
      let mut i = 0
      while i < Array::length(items) {
        pc_count(ctx, scope, Array::get(items, i))
        i = i + 1
      }
      0
    },
    ERecord(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EMap(fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        pc_count(ctx, scope, (Array::get(fields, i)).1)
        i = i + 1
      }
      0
    },
    EIf(cond, then_e, else_e) => {
      pc_count(ctx, scope, cond)
      let snap_u = copy_ints(ctx.uses)
      let snap_b = copy_ints(ctx.borrows)
      pc_count(ctx, scope, then_e)
      let then_u = copy_ints(ctx.uses)
      let then_b = copy_ints(ctx.borrows)
      restore_prefix(ctx.uses, snap_u)
      restore_prefix(ctx.borrows, snap_b)
      pc_count(ctx, scope, else_e)
      let mut id = 0
      while id < Array::length(snap_u) {
        let base_u = Array::get(snap_u, id)
        let dt = Array::get(then_u, id) - base_u
        let de = Array::get(ctx.uses, id) - base_u
        Array::set(ctx.uses, id, base_u + int_max(dt, de))
        let base_b = Array::get(snap_b, id)
        let dtb = Array::get(then_b, id) - base_b
        let deb = Array::get(ctx.borrows, id) - base_b
        Array::set(ctx.borrows, id, base_b + int_max(dtb, deb))
        id = id + 1
      }
      0
    },
    EWhile(cond, body) => {
      pc_count(ctx, scope, cond)
      pc_count(ctx, scope, body)
    },
    EReturn(e) => pc_count(ctx, scope, e),
    EThrow(e) => pc_count(ctx, scope, e),
    ESpread(e) => pc_count(ctx, scope, e),
    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),
    EBreak(opt) => match opt {
      Some(e) => pc_count(ctx, scope, e),
      None => 0
    }
    ,
    EFn(_tp, _tb, params, _ret, _eff, fbody) => {
      let caps = collect_free_vars(fbody, fn_param_names(params), [
      ])
      let mut i = 0
      while i < Array::length(caps) {
        pc_count_use(ctx, scope, Array::get(caps, i))
        i = i + 1
      }
      0
    },
    EForIn(value_name, index_opt, iterable, fbody) => {
      pc_count(ctx, scope, iterable)
      let idv = pc_declare(ctx, value_name, false)
      let s2 = Map::set(scope, value_name, idv)
      let s3 = match index_opt {
        Some(idx) => {
          let idi = pc_declare(ctx, idx, true)
          Map::set(s2, idx, idi)
        },
        None => s2
      }
      pc_count(ctx, s3, fbody)
    },
    ELoop(params, lbody) => {
      let mut s = scope
      let mut i = 0
      while i < Array::length(params) {
        let p = Array::get(params, i)
        pc_count(ctx, scope, p.1)
        let pid = pc_declare(ctx, p.0, is_scalar_expr(p.1))
        s = Map::set(s, p.0, pid)
        i = i + 1
      }
      pc_count(ctx, s, lbody)
    },
    EMatch(scrut, arms) => {
      match scrut {
        EIdent(sx) => pc_count_borrow(ctx, scope, sx),
        _ => pc_count(ctx, scope, scrut)
      }
      let snap_u = copy_ints(ctx.uses)
      let snap_b = copy_ints(ctx.borrows)
      let max_u = zeros(Array::length(snap_u))
      let max_b = zeros(Array::length(snap_b))
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.uses, snap_u)
        restore_prefix(ctx.borrows, snap_b)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pc_declare(ctx, nm, false)
          s = Map::set(s, nm, pid)
          k = k + 1
        }
        pc_count(ctx, s, arm.1)
        let mut id = 0
        while id < Array::length(snap_u) {
          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)
          if du > Array::get(max_u, id) {
            Array::set(max_u, id, du)
          }
          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)
          if db > Array::get(max_b, id) {
            Array::set(max_b, id, db)
          }
          id = id + 1
        }
        a = a + 1
      }
      restore_prefix(ctx.uses, snap_u)
      restore_prefix(ctx.borrows, snap_b)
      let mut id2 = 0
      while id2 < Array::length(snap_u) {
        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))
        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))
        id2 = id2 + 1
      }
      0
    },
    EHandle(hbody, arms) => {
      let snap_u = copy_ints(ctx.uses)
      let snap_b = copy_ints(ctx.borrows)
      let max_u = zeros(Array::length(snap_u))
      let max_b = zeros(Array::length(snap_b))
      pc_count(ctx, scope, hbody)
      let mut id0 = 0
      while id0 < Array::length(snap_u) {
        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)
        if du > Array::get(max_u, id0) {
          Array::set(max_u, id0, du)
        }
        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)
        if db > Array::get(max_b, id0) {
          Array::set(max_b, id0, db)
        }
        id0 = id0 + 1
      }
      let mut a = 0
      while a < Array::length(arms) {
        let arm = Array::get(arms, a)
        restore_prefix(ctx.uses, snap_u)
        restore_prefix(ctx.borrows, snap_b)
        let pnames: Array[String] = [
        ]
        pat_names(arm.0, pnames)
        let mut s = scope
        let mut k = 0
        while k < Array::length(pnames) {
          let nm = Array::get(pnames, k)
          let pid = pc_declare(ctx, nm, false)
          s = Map::set(s, nm, pid)
          k = k + 1
        }
        pc_count(ctx, s, arm.1)
        let mut id = 0
        while id < Array::length(snap_u) {
          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)
          if du > Array::get(max_u, id) {
            Array::set(max_u, id, du)
          }
          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)
          if db > Array::get(max_b, id) {
            Array::set(max_b, id, db)
          }
          id = id + 1
        }
        a = a + 1
      }
      restore_prefix(ctx.uses, snap_u)
      restore_prefix(ctx.borrows, snap_b)
      let mut id2 = 0
      while id2 < Array::length(snap_u) {
        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))
        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))
        id2 = id2 + 1
      }
      0
    },
    _ => 0
  }
}

export let build_perceus_plan: (Expr) -> Array[PerceusAction] = (body) -> {
  let ctx = pctx_new()
  let empty: Map[String, Int] = map {
  }
  pc_count(ctx, empty, body)
  ctx.next_id = 0
  ctx.seq_id = 0
  pc_emit(ctx, empty, body)
  ctx.actions
}

let collect_heap_ret_fns: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let out: Array[String] = [
  ]
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, fname, oty, _) =>
      match oty {
        Some(ty) =>
        match ty {
          TyFn(_, ret, _) =>
          if type_expr_is_heap(Some(ret)) {
            Array::push(out, fname)
          } else {
            ()
          },
          _ => ()
        },
        None => ()
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

export let elaborate_heap_params: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let hctx = HeapInferCtx::{
    ctors: collect_ctor_names(stmts),
    heap_fns: collect_heap_ret_fns(stmts),
  }
  let out = Array::slice(stmts, 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    let s = Array::get(stmts, i)
    let s2 = match s {
      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),
      SExpr(e) => SExpr(elaborate_rw(e, hctx)),
      _ => s
    }
    Array::push(out, s2)
    i = i + 1
  }
  out
}

let rec expr_projects_or_matches: (String, Expr) -> Bool = (name, e) -> {
  match e {
    EDot(obj, _) =>
    match obj {
      EIdent(n) => n == name,
      _ => expr_projects_or_matches(name, obj)
    },
    EMatch(scrut, arms) => {
      let hit = match scrut {
        EIdent(n) => n == name,
        _ => expr_projects_or_matches(name, scrut)
      }
      if hit {
        true
      } else {
        let mut i = 0
        let mut found = false
        while i < Array::length(arms) {
          let (_, arm_body) = Array::get(arms, i)
          if expr_projects_or_matches(name, arm_body) {
            found = true
          } else {
            ()
          }
          i = i + 1
        }
        found
      }
    },
    EHandle(body, arms) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, body)
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        if expr_projects_or_matches(name, arm_body) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELet(_, val, body) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    ELetRec(_, val, body) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    ELetMut(_, val, body) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),
    EAssign(_, val, cont) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),
    EAssignOp(_, _, val, cont) =>
    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),
    ESeq(a, b) =>
    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),
    EIf(c, t, el) =>
    expr_projects_or_matches(name, c) ||
    expr_projects_or_matches(name, t) ||
    expr_projects_or_matches(name, el),
    EWhile(c, b) =>
    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),
    EForIn(_, _, iter, body) =>
    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),
    ECall(callee, args) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, callee)
      while i < Array::length(args) {
        if expr_projects_or_matches(name, Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EBinOp(_, l, r) =>
    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),
    EUnaryOp(_, o) => expr_projects_or_matches(name, o),
    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_projects_or_matches(name, Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(elems) {
        if expr_projects_or_matches(name, Array::get(elems, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELoop(params, body) => {
      let mut i = 0
      let mut found = expr_projects_or_matches(name, body)
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        if expr_projects_or_matches(name, init) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ERecord(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_projects_or_matches(name, fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EMap(fields) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        if expr_projects_or_matches(name, fval) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),
    EThrow(inner) => expr_projects_or_matches(name, inner),
    EReturn(inner) => expr_projects_or_matches(name, inner),
    ESpread(inner) => expr_projects_or_matches(name, inner),
    EBreak(opt) =>
    match opt {
      Some(inner) => expr_projects_or_matches(name, inner),
      None => false
    },
    EContinue(args) => {
      let mut i = 0
      let mut found = false
      while i < Array::length(args) {
        if expr_projects_or_matches(name, Array::get(args, i)) {
          found = true
        } else {
          ()
        }
        i = i + 1
      }
      found
    },
    EInt(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EBool(_) => false,
    EIdent(_) => false,
    EStringInterp(_) => false,
    EUnit => false
  }
}

export let param_is_heap_in_body: (String, Option[TypeExpr], Expr) -> Bool = (name, otype, body,) -> {
  if type_expr_is_heap(otype) {
    true
  } else {
    match otype {
      None => expr_projects_or_matches(name, body),
      Some(_) => false
    }
  }
}

export let build_perceus_plan_with_params: (Array[(String, Option[TypeExpr])], Expr) -> Array[PerceusAction] = (params, body) -> {
  let ctx = pctx_new()
  let mut scope: Map[String, Int] = map {
  }
  let mut pi = 0
  while pi < Array::length(params) {
    let (pname, ptype) = Array::get(params, pi)
    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))
    scope = Map::set(scope, pname, id)
    pi = pi + 1
  }
  pc_count(ctx, scope, body)
  ctx.next_id = 0
  ctx.seq_id = 0
  let mut scope2: Map[String, Int] = map {
  }
  let param_ids = Array::slice([
    0
  ], 0, 0)
  let mut pj = 0
  while pj < Array::length(params) {
    let (pname, _) = Array::get(params, pj)
    let id = pe_declare(ctx, pname)
    scope2 = Map::set(scope2, pname, id)
    Array::push(param_ids, id)
    pj = pj + 1
  }
  pc_emit(ctx, scope2, body)
  let mut pk = 0
  while pk < Array::length(params) {
    let (pname, _) = Array::get(params, pk)
    pe_scope_end(ctx, Array::get(param_ids, pk), pname)
    pk = pk + 1
  }
  ctx.actions
}




export struct FuncTable {
  names: Array[String];
  indices: Array[Int];
  params: Array[Int];
  returns: Array[Int];
  needs_env: Array[Bool]
}

export struct StrTable {
  strs: Array[String];
  offsets: Array[Int];
  lengths: Array[Int]
}

export struct LambdaTable {
  bodies: Array[Bytes];
  param_counts: Array[Int];
  captures: Array[Array[String]];
  meta_i32: Array[Int];
  meta_i64: Array[Int]
}

export struct CtorTable {
  names: Array[String];
  tags: Array[Int];
  field_counts: Array[Int];
  type_names: Array[String];
  struct_names: Array[String];
  struct_field_names: Array[Array[String]]
}

export struct CompileCtx {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ctor_table: CtorTable;
  thunk_names: Array[String];
  const_int_names: Array[String];
  const_int_values: Array[Int];
  enable_rc: Bool;
  rc_drop_names: Array[String];
  rc_alias_dup_names: Array[String];
  heap_binding_names: Array[String];
  rc_drop_func_idx: Int;
  rc_alloc_func_idx: Int;
  heap_grow_check_func_idx: Int;
  rc_dup_names: Array[String];
  float_local_slots: Array[Int];
  effect_names: Array[String];
  effect_op_keys: Array[String];
  effect_op_arities: Array[Int]
}

export struct CompileCtxGc {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ref_local_indices: Array[Int];
  refcell_type_idx: Int;
  closure_type_base: Int;
  ctor_table: CtorTable
}


export let is_efn: (Expr) -> Bool = (expr) -> {
  match expr {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}

export let is_pint: (Pat) -> Bool = (p) -> {
  match p {
    PInt(_) => true,
    _ => false
  }
}

export let is_slet: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}

export let expr_tag: (Expr) -> Int = (expr) -> {
  match expr {
    EInt(_) => 0,
    EBool(_) => 1,
    EFloat(_) => 2,
    EString(_) => 3,
    EIdent(_) => 4,
    EBinOp(_, _, _) => 5,
    EUnaryOp(_, _) => 6,
    EIf(_, _, _) => 7,
    ECall(_, _) => 8,
    ELet(_, _, _) => 9,
    ELetRec(_, _, _) => 10,
    ELetMut(_, _, _) => 11,
    EAssign(_, _, _) => 12,
    EAssignOp(_, _, _, _) => 13,
    ESeq(_, _) => 14,
    ETuple(_) => 15,
    EMatch(_, _) => 16,
    EArray(_) => 17,
    EForIn(_, _, _, _) => 18,
    EWhile(_, _) => 19,
    EBreak(_) => 20,
    EContinue(_) => 21,
    EUnit => 22,
    EThrow(_) => 23,
    EFn(_, _, _, _, _, _) => 24,
    ELoop(_, _) => 25,
    EReturn(_) => 26,
    _ => -1
  }
}

