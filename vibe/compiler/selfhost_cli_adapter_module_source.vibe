    core_valtype
  ], Array::slice([
    0
  ], 0, 0))
  emit_func_type_raw(tc, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
