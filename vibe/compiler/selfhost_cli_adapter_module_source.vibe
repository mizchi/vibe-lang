  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch
}





let rec desugar_loop_body: (Expr, Array[String]) -> Expr = (expr, param_names) -> {
  match expr {
    EBreak(opt) => match opt {
      Some(val) => EAssign("__loop_result", desugar_loop_body(val, param_names), EBreak(None)),
      None => EBreak(None)
    },
    EContinue(args) => {
      if Array::length(args) == 0 {
        EContinue(args)
      } else {
        let nargs = Array::length(args)
        let nparams = Array::length(param_names)
        if nargs > nparams {
          EContinue(args)
        } else {
        let mut result = EContinue(Array::slice([EUnit], 0, 0))
        let mut ci = nargs - 1
        while ci >= 0 {
          result = EAssign(Array::get(param_names, ci), EIdent(String::concat("__lt", __to_string(ci))), result)
          ci = ci - 1
        }
        let mut ci2 = nargs - 1
        while ci2 >= 0 {
          result = ELet(String::concat("__lt", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result)
          ci2 = ci2 - 1
        }
        result
        }
      }
    },
    EWhile(_, _) => expr,
    ELoop(_, _) => expr,
    EFn(_, _, _, _, _, _) => expr,
    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),
    ELet(n, v, b) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),
    ELetMut(n, v, b) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),
    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),
    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),
    EMatch(_, _) => expr,
    EHandle(_, _) => expr,
    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),
    ECall(_, _) => expr,
    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),
    EThrow(e) => EThrow(desugar_loop_body(e, param_names)),
    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),
    EDot(obj, field) => EDot(desugar_loop_body(obj, param_names), field),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),
    _ => expr
  }
}


let parse_loop_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TLParen => {
      let param_names_b = ArrayBuilder::new()
      let param_inits_b = ArrayBuilder::new()
      let mut cur = pos + 2
      let mut done = false
      while !done {
        match peek(tokens, cur) {
          TRParen => {
            cur = cur + 1
            done = true
          },
          TIdent(name) => {
            let eq_pos = expect_tk(tokens, cur + 1, "=")
            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)
            ArrayBuilder::push(param_names_b, name)
            ArrayBuilder::push(param_inits_b, init)
            match peek(tokens, next_pos) {
              TComma => {
                cur = next_pos + 1
              },
              TRParen => {
                cur = next_pos + 1
                done = true
              },
              _ => throw("expected ',' or ')' in loop params")
            }
          },
          _ => throw("expected loop parameter name or ')'")
        }
      }
      let body_pos = expect_tk(tokens, cur, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, 20)
      let pnames = ArrayBuilder::freeze(param_names_b)
      let pinits = ArrayBuilder::freeze(param_inits_b)
      let transformed_body = desugar_loop_body(body, pnames)
      let while_expr = EWhile(EBool(true), transformed_body)
      let result = ELetMut("__loop_result", EInt(0),
        ESeq(while_expr, EIdent("__loop_result")))
      let mut wrapped = result
      let mut wi = Array::length(pnames) - 1
      while wi >= 0 {
        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped)
        wi = wi - 1
      }
      (wrapped, end_pos)
    },
    _ => {
      let body_pos = expect_tk(tokens, pos + 1, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, 20)
      (EWhile(EBool(true), body), end_pos)
    }
  }
}

let parse_break_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRBrace => (EBreak(None), pos + 1),
    TSemicolon => (EBreak(None), pos + 1),
    TEof => (EBreak(None), pos + 1),
    _ => {
      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)
      (EBreak(Some(expr)), next_pos)
    }
  }
}

let parse_throw_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let open_pos = expect_tk(tokens, pos + 1, "(")
  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)
  let close_pos = expect_tk(tokens, next_pos, ")")
  (EThrow(expr), close_pos)
}

let parse_return_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRBrace => (EReturn(EUnit), pos + 1),
    TSemicolon => (EReturn(EUnit), pos + 1),
    TEof => (EReturn(EUnit), pos + 1),
    _ => {
      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)
      (EReturn(expr), next_pos)
    }
  }
}

let parse_perform_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRParen => (EIdent("perform"), pos + 1),
    TRBracket => (EIdent("perform"), pos + 1),
    TRBrace => (EIdent("perform"), pos + 1),
    TComma => (EIdent("perform"), pos + 1),
    TSemicolon => (EIdent("perform"), pos + 1),
    TEof => (EIdent("perform"), pos + 1),
    _ => {
      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)
      (ECall(EIdent("perform"), [
        arg
      ]), next_pos)
    }
  }
}

let rec parse_array_elems_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TComma => {
      let next_pos = pos + 1
      match peek(tokens, next_pos) {
        TRBracket => (ArrayBuilder::freeze(b), next_pos),
        TDotDotDot => {
          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)
          ArrayBuilder::push(b, ESpread(expr))
          parse_array_elems_rest(tokens, end_pos, b, parse_recur)
        },
        _ => {
          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)
          ArrayBuilder::push(b, expr)
          parse_array_elems_rest(tokens, end_pos, b, parse_recur)
        }
      }
    },
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

let parse_array_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRBracket => (EArray(empty_exprs()), pos + 2),
    TDotDotDot => {
      let b = ArrayBuilder::new()
      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)
      ArrayBuilder::push(b, ESpread(first))
      let (items, end_pos) = parse_array_elems_rest(tokens, next_pos, b, parse_recur)
      let close_pos = expect_tk(tokens, end_pos, "]")
      (EArray(items), close_pos)
    },
    _ => {
      let b = ArrayBuilder::new()
      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)
      ArrayBuilder::push(b, first)
      let (items, end_pos) = parse_array_elems_rest(tokens, next_pos, b, parse_recur)
      let close_pos = expect_tk(tokens, end_pos, "]")
      (EArray(items), close_pos)
    }
  }
}

let rec parse_comma_exprs_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TComma => {
      match peek(tokens, pos + 1) {
        TRParen => (ArrayBuilder::freeze(b), pos + 1),
        _ => {
          let (e, next) = parse_recur(tokens, pos + 1, 0)
          ArrayBuilder::push(b, e)
          parse_comma_exprs_rest(tokens, next, b, parse_recur)
        }
      }
    },
    _ => (ArrayBuilder::freeze(b), pos)
  }
}

let parse_continue_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TLParen => {
      let b = ArrayBuilder::new()
      match peek(tokens, pos + 2) {
        TRParen => (EContinue(empty_exprs()), pos + 3),
        _ => {
          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)
          ArrayBuilder::push(b, first)
          let (args, end_pos) = parse_comma_exprs_rest(tokens, next_pos, b, parse_recur)
          let close_pos = expect_tk(tokens, end_pos, ")")
          (EContinue(args), close_pos)
        }
      }
    },
    _ => (EContinue(empty_exprs()), pos + 1)
  }
}

let parse_control_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos) {
    TLBrace => parse_recur(tokens, pos + 1, 20),
    TIf => parse_recur(tokens, pos + 1, 21),
    TMatch => parse_recur(tokens, pos + 1, 22),
    THandle => parse_recur(tokens, pos + 1, 24),
    TWhile => parse_recur(tokens, pos + 1, 23),
    TFor => parse_recur(tokens, pos + 1, 25),
    TThrow => parse_throw_primary(tokens, pos, parse_recur),
    TBreak => parse_break_primary(tokens, pos, parse_recur),
    TContinue => parse_continue_primary(tokens, pos, parse_recur),
    TRaise => throw("'raise' is deprecated, use 'throw(expr)' instead"),
    TReturn => parse_return_primary(tokens, pos, parse_recur),
    TDo => throw("'do' is reserved; use 'while' or 'for' instead"),
    TLoop => parse_loop_primary(tokens, pos, parse_recur),
    TYield => throw("'yield' is not supported"),
    TDeclare => throw("'declare' is not supported"),
    _ => {
      let prev_name = if pos > 0 {
        tk_name(peek(tokens, pos - 1))
      } else {
        "start"
      }
      let actual = tk_name(peek(tokens, pos))
      let next_name = tk_name(peek(tokens, pos + 1))
      throw("unexpected token at #\{pos}: \{actual} (prev=\{prev_name}, next=\{next_name})")
    }
  }
}

let rec parse_ctor_record_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let colon_pos = expect_tk(tokens, pos + 1, ":")
      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_ctor_record_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in record literal")
      }
    },
    _ => throw("expected field name or '}' in record literal")
  }
}

let parse_generic_fn_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let mut skip_pos = pos + 1
  let mut depth = 1
  while depth > 0 {
    match peek(tokens, skip_pos) {
      TLBracket => {
        depth = depth + 1
      },
      TRBracket => {
        depth = depth - 1
      },
      _ => ()
    }
    skip_pos = skip_pos + 1
  }
  let (params, after_params) = parse_param_list(tokens, skip_pos)
  match peek(tokens, after_params) {
    TThinArrow => {
      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)
      let effect_pair = match peek(tokens, ret_pos) {
        TWith => {
          let with_pos = expect_tk(tokens, ret_pos + 1, "{")
          let effect_name_pair = collect_effect_names(tokens, with_pos, "")
          let effect_name = effect_name_pair.0
          let end_pos = effect_name_pair.1
          (Some(effect_name), end_pos)
        },
        _ => (None, ret_pos)
      }
      let effect = effect_pair.0
      let effect_next = effect_pair.1
      let body_pos = expect_tk(tokens, effect_next, "{")
      let (body, end_pos) = parse_recur(tokens, body_pos, 20)
      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)
    },
    TLBrace => {
      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)
      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)
    },
    _ => throw("expected '->' or '{' after generic function params")
  }
}

let is_generic_fn_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {
  match peek(tokens, pos + 1) {
    TIdent(_) => {
      let mut p = pos + 2
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, p) {
          TLBracket => {
            depth = depth + 1
          },
          TRBracket => {
            depth = depth - 1
          },
          TEof => {
            depth = 0
          },
          _ => ()
        }
        p = p + 1
      }
      match peek(tokens, p) {
        TLParen => true,
        _ => false
      }
    },
    _ => false
  }
}

let parse_bracket_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  if is_generic_fn_start(tokens, pos) {
    parse_generic_fn_primary(tokens, pos, parse_recur)
  } else {
    parse_array_primary(tokens, pos, parse_recur)
  }
}

let rec parse_map_literal_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let colon_pos = expect_tk(tokens, pos + 1, ":")
      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_map_literal_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in map literal")
      }
    },
    TString(skey) => {
      let colon_pos = expect_tk(tokens, pos + 1, ":")
      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)
      ArrayBuilder::push(b, (skey, val))
      match peek(tokens, next_pos) {
        TComma => parse_map_literal_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in map literal")
      }
    },
    _ => throw("expected field name or '}' in map literal")
  }
}

let parse_paren_tuple_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos + 1) {
    TRParen => (EUnit, pos + 2),
    _ => {
      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)
      match peek(tokens, next_pos) {
        TRParen => (first, next_pos + 1),
        TComma => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (items, end_pos) = parse_comma_exprs_rest(tokens, next_pos, b, parse_recur)
          let close_pos = expect_tk(tokens, end_pos, ")")
          (ETuple(items), close_pos)
        },
        _ => throw("expected ')' or ','")
      }
    }
  }
}

let parse_paren_lambda_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let (params, after_params) = parse_param_list(tokens, pos + 1)
  match peek(tokens, after_params) {
    TThinArrow => {
      let after_arrow = after_params + 1
      match peek(tokens, after_arrow) {
        TIdent(_) => {
          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)
          match peek(tokens, ty_pos) {
            TLBrace => {
              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)
              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)
            },
            TWith => {
              let with_pos = expect_tk(tokens, ty_pos + 1, "{")
              let effect_pair = collect_effect_names(tokens, with_pos, "")
              let effect_name = effect_pair.0
              let effect_next = effect_pair.1
              let body_pos = expect_tk(tokens, effect_next, "{")
              let (body, end) = parse_recur(tokens, body_pos, 20)
              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)
            },
            _ => {
              let (body, end) = parse_recur(tokens, after_arrow, 0)
              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
            }
          }
        },
        TLParen => {
          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)
          match peek(tokens, ty_pos) {
            TLBrace => {
              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)
              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)
            },
            TWith => {
              let with_pos = expect_tk(tokens, ty_pos + 1, "{")
              let effect_pair = collect_effect_names(tokens, with_pos, "")
              let effect_name = effect_pair.0
              let effect_next = effect_pair.1
              let body_pos = expect_tk(tokens, effect_next, "{")
              let (body, end) = parse_recur(tokens, body_pos, 20)
              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)
            },
            _ => {
              let (body, end) = parse_recur(tokens, after_arrow, 0)
              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
            }
          }
        },
        _ => {
          let (body, end) = parse_recur(tokens, after_arrow, 0)
          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
        }
      }
    },
    TLBrace => {
      let (body, end) = parse_recur(tokens, after_params + 1, 20)
      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)
    },
    _ => throw("expected '->' or '{' after fn params")
  }
}

let parse_paren_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  if is_lambda_start(tokens, pos + 1) {
    parse_paren_lambda_primary(tokens, pos, parse_recur)
  } else {
    parse_paren_tuple_primary(tokens, pos, parse_recur)
  }
}

let rec parse_record_literal_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    TIdent(fname) => {
      let (val, next_pos) = match peek(tokens, pos + 1) {
        TComma => (EIdent(fname), pos + 1),
        TRBrace => (EIdent(fname), pos + 1),
        _ => {
          let colon_pos = expect_tk(tokens, pos + 1, ":")
          parse_recur(tokens, colon_pos, 0)
        }
      }
      ArrayBuilder::push(b, (fname, val))
      match peek(tokens, next_pos) {
        TComma => parse_record_literal_fields(tokens, next_pos + 1, b, parse_recur),
        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),
        _ => throw("expected ',' or '}' in record literal")
      }
    },
    _ => throw("expected field name or '}' in record literal")
  }
}

let parse_ident_primary: (Array[Token], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, name, parse_recur) -> {
  if name == "true" {
    (EBool(true), pos + 1)
  } else if name == "false" {
    (EBool(false), pos + 1)
  } else if name == "perform" {
    parse_perform_primary(tokens, pos, parse_recur)
  } else if name == "record" {
    match peek(tokens, pos + 1) {
      TLBrace => {
        let b = ArrayBuilder::new()
        let (fields, end_pos) = parse_record_literal_fields(tokens, pos + 2, b, parse_recur)
        (ERecord(fields), end_pos)
      },
      _ => (EIdent(name), pos + 1)
    }
  } else if name == "map" {
    match peek(tokens, pos + 1) {
      TLBrace => {
        let b = ArrayBuilder::new()
        let (fields, end_pos) = parse_map_literal_fields(tokens, pos + 2, b, parse_recur)
        (EMap(fields), end_pos)
      },
      _ => (EIdent(name), pos + 1)
    }
  } else {
    match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (EIdent(String::concat(name, String::concat("::", member))), pos + 3),
        TLBrace => {
          let b = ArrayBuilder::new()
          let (fields, end_pos) = parse_ctor_record_fields(tokens, pos + 3, b, parse_recur)
          (ERecord(fields), end_pos)
        },
        _ => (EIdent(name), pos + 1)
      },
      _ => (EIdent(name), pos + 1)
    }
  }
}

export let parse_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos) {
    TInt(n) => (EInt(n), pos + 1),
    TFloat(n) => (EFloat(n), pos + 1),
    TString(s) => (EString(s), pos + 1),
    TStringInterp(parts) => (EStringInterp(parts), pos + 1),
    TIdent(name) => parse_ident_primary(tokens, pos, name, parse_recur),
    TLParen => parse_paren_primary(tokens, pos, parse_recur),
    TLBracket => parse_bracket_primary(tokens, pos, parse_recur),
    _ => parse_control_primary(tokens, pos, parse_recur)
  }
}






let binop_op: (Token) -> String with { Error } = (tok) -> {
  match tok {
    TOr => "||",
    TAnd => "&&",
    TPipeGt => "|>",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TBitOr => "|",
    TBitXor => "^",
    TBitAnd => "&",
    TLShift => "<<",
    TRShift => ">>",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    _ => throw("internal parser error: not a binary operator")
  }
}

let binop_prec: (Token) -> Int = (tok) -> {
  match tok {
    TOr => 0,
    TAnd => 1,
    TPipeGt => 2,
    TEqEq => 3,
    TNeq => 3,
    TLt => 3,
    TLte => 3,
    TGt => 3,
    TGte => 3,
    TBitOr => 4,
    TBitXor => 5,
    TBitAnd => 6,
    TLShift => 7,
    TRShift => 7,
    TPlus => 8,
    TMinus => 8,
    TStar => 9,
    TSlash => 9,
    TPercent => 9,
    _ => -1
  }
}

let index_expr: (Expr, Expr) -> Expr = (cur_expr, idx) -> {
  let args = empty_exprs()
  Array::push(args, cur_expr)
  Array::push(args, idx)
  ECall(EIdent("__index"), args)
}

let pipe_arg_is_hole: (Expr) -> Bool = (arg) -> {
  match arg {
    EIdent(n) => n == "_",
    _ => false
  }
}

let pipe_desugar: (Expr, Expr) -> Expr = (lhs, rhs) -> {
  match rhs {
    ECall(callee, args) => {
      let mut has_hole = false
      let mut i = 0
      while i < Array::length(args) {
        if pipe_arg_is_hole(Array::get(args, i)) {
          has_hole = true
          i = Array::length(args)
        } else {
          i = i + 1
        }
      }
      if has_hole {
        let out = empty_exprs()
        let mut j = 0
        while j < Array::length(args) {
          let a = Array::get(args, j)
          if pipe_arg_is_hole(a) {
            Array::push(out, lhs)
          } else {
            Array::push(out, a)
          }
          j = j + 1
        }
        ECall(callee, out)
      } else {
        ECall(callee, Array::concat([
          lhs
        ], args))
      }
    },
    _ => ECall(rhs, [
      lhs
    ])
  }
}

let parse_call_arg: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TThinArrow => {
        let (body, end) = parse_recur(tokens, pos + 2, 0)
        (EFn(_no_tp(), _no_tb(), [
          (name, None)
        ], None, None, body), end)
      },
      TTilde => match peek(tokens, pos + 2) {
        TEq => {
          let (val, end) = parse_recur(tokens, pos + 3, 0)
          (ELabeledArg(name, "~", val), end)
        },
        _ => parse_recur(tokens, pos, 0)
      },
      TQuestion => match peek(tokens, pos + 2) {
        TEq => {
          let (val, end) = parse_recur(tokens, pos + 3, 0)
          (ELabeledArg(name, "?", val), end)
        },
        _ => parse_recur(tokens, pos, 0)
      },
      TEq => {
        let (val, end) = parse_recur(tokens, pos + 2, 0)
        (ELabeledArg(name, "~", val), end)
      },
      _ => parse_recur(tokens, pos, 0)
    },
    _ => parse_recur(tokens, pos, 0)
  }
}

let has_placeholder_arg: (Expr) -> Bool = (arg) -> {
  match arg {
    EIdent(n) => n == "_",
    EBinOp(_, l, r) => {
      let left_has = match l {
        EIdent(n) => n == "_",
        _ => false
      }
      let right_has = match r {
        EIdent(n) => n == "_",
        _ => false
      }
      left_has || right_has
    },
    _ => false
  }
}

let slice_from_idx_expr: (Expr, Expr, Expr) -> Expr = (cur_expr, idx, end_expr) -> {
  let args = empty_exprs()
  Array::push(args, cur_expr)
  Array::push(args, idx)
  Array::push(args, end_expr)
  ECall(EIdent("__slice"), args)
}

let has_placeholder_args: (Array[Expr]) -> Bool = (args) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(args) {
    if has_placeholder_arg(Array::get(args, i)) {
      found = true
      i = Array::length(args)
    } else {
      i = i + 1
    }
  }
  found
}

let parse_call_args_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TComma => match peek(tokens, p + 1) {
        TRParen => {
          p = p + 1
          done = true
        },
        _ => {
          let (e, next) = parse_call_arg(tokens, p + 1, parse_recur)
          ArrayBuilder::push(b, e)
          p = next
        }
      }
      ,
      _ => {
        done = true
      }
    }
  }
  (ArrayBuilder::freeze(b), p)
}

let slice_from_zero_expr: (Expr, Expr) -> Expr = (cur_expr, end_expr) -> {
  let args = empty_exprs()
  Array::push(args, cur_expr)
  Array::push(args, EInt(0))
  Array::push(args, end_expr)
  ECall(EIdent("__slice"), args)
}

let wrap_placeholder_arg: (Expr) -> Expr = (arg) -> {
  let mut pc = 0
  let params = Array::slice([
    ("", None)
  ], 0, 0)
  let replaced = match arg {
    EIdent(n) => if n == "_" {
      let pn = "__ph0"
      Array::push(params, (pn, None))
      EIdent(pn)
    } else {
      arg
    }
    ,
    EBinOp(op, l, r) => {
      let nl = match l {
        EIdent(n) => if n == "_" {
          let pn = String::concat("__ph", __to_string(pc))
          Array::push(params, (pn, None))
          pc = pc + 1
          EIdent(pn)
        } else {
          l
        }
        ,
        _ => l
      }
      let nr = match r {
        EIdent(n) => if n == "_" {
          let pn = String::concat("__ph", __to_string(pc))
          Array::push(params, (pn, None))
          pc = pc + 1
          EIdent(pn)
        } else {
          r
        }
        ,
        _ => r
      }
      EBinOp(op, nl, nr)
    },
    _ => arg
  }
  EFn(_no_tp(), _no_tb(), params, None, None, replaced)
}

let has_non_pipe_infix_top: (Array[Token], Int, Int) -> Bool = (tokens, start, end) -> {
  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {
    if i >= end {
      false
    } else {
      let tok = peek(tokens, i)
      if depth == 0 {
        if is_non_pipe_infix(tok) {
          if prev_top_end {
            true
          } else {
            go(i + 1, 0, false)
          }
        } else {
          match tok {
            TLParen => go(i + 1, 1, false),
            TLBracket => go(i + 1, 1, false),
            TLBrace => go(i + 1, 1, false),
            _ => go(i + 1, 0, is_expr_end_token(tok))
          }
        }
      } else {
        match tok {
          TLParen => go(i + 1, depth + 1, prev_top_end),
          TLBracket => go(i + 1, depth + 1, prev_top_end),
          TLBrace => go(i + 1, depth + 1, prev_top_end),
          TRParen => if depth == 1 {
            go(i + 1, 0, true)
          } else {
            go(i + 1, depth - 1, prev_top_end)
          },
          TRBracket => if depth == 1 {
            go(i + 1, 0, true)
          } else {
            go(i + 1, depth - 1, prev_top_end)
          },
          TRBrace => if depth == 1 {
            go(i + 1, 0, true)
          } else {
            go(i + 1, depth - 1, prev_top_end)
          },
          _ => go(i + 1, depth, prev_top_end)
        }
      }
    }
  }
  go(start, 0, false)
}

let desugar_placeholder_args: (Array[Expr]) -> Array[Expr] = (args) -> {
  let out = Array::slice([
    EUnit
  ], 0, 0)
  let mut i = 0
  while i < Array::length(args) {
    let arg = Array::get(args, i)
    if pipe_arg_is_hole(arg) {
      Array::push(out, arg)
    } else if has_placeholder_arg(arg) {
      Array::push(out, wrap_placeholder_arg(arg))
    } else {
      Array::push(out, arg)
    }
    i = i + 1
  }
  out
}

let rec parse_postfix: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, expr, parse_recur) -> {
  match peek(tokens, pos) {
    TLParen => match expr {
      ECall(_, _) => (expr, pos),
      EArray(_) => (expr, pos),
      ETuple(_) => (expr, pos),
      ERecord(_) => (expr, pos),
      EMap(_) => (expr, pos),
      EInt(_) => (expr, pos),
      EFloat(_) => (expr, pos),
      EString(_) => (expr, pos),
      EStringInterp(_) => (expr, pos),
      EBool(_) => (expr, pos),
      EUnit => (expr, pos),
      EWhile(_, _) => (expr, pos),
      EIf(_, _, _) => (expr, pos),
      EMatch(_, _) => (expr, pos),
      ELoop(_, _) => (expr, pos),
      EForIn(_, _, _, _) => (expr, pos),
      EHandle(_, _) => (expr, pos),
      _ => match peek(tokens, pos + 1) {
        TRParen => parse_postfix(tokens, pos + 2, ECall(expr, empty_exprs()), parse_recur),
        _ => {
          let b = ArrayBuilder::new()
          let (first_arg, next_pos) = parse_call_arg(tokens, pos + 1, parse_recur)
          ArrayBuilder::push(b, first_arg)
          let (args, end_pos) = parse_call_args_rest(tokens, next_pos, b, parse_recur)
          let close_pos = expect_tk(tokens, end_pos, ")")
          let call_args = if has_placeholder_args(args) {
            desugar_placeholder_args(args)
          } else {
            args
          }
          parse_postfix(tokens, close_pos, ECall(expr, call_args), parse_recur)
        }
      },
    },
    TLBracket => match peek(tokens, pos + 1) {
      TColon => match peek(tokens, pos + 2) {
        TRBracket => {
          let end_expr = ECall(EIdent("__len"), [
            expr
          ])
          parse_postfix(tokens, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)
        },
        _ => {
          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)
          let close_pos = match peek(tokens, end_next) {
            TRBracket => end_next + 1,
            _ => throw("expected ']'")
          }
          parse_postfix(tokens, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)
        }
      },
      _ => {
        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)
        match peek(tokens, idx_next) {
          TColon => match peek(tokens, idx_next + 1) {
            TRBracket => {
              let end_expr = ECall(EIdent("__len"), [
                expr
              ])
              parse_postfix(tokens, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)
            },
            _ => {
              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)
              let close_pos = match peek(tokens, end_next) {
                TRBracket => end_next + 1,
                _ => throw("expected ']'")
              }
              parse_postfix(tokens, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)
            }
          },
          _ => {
            let close_pos = match peek(tokens, idx_next) {
              TRBracket => idx_next + 1,
              _ => throw("expected ']'")
            }
            parse_postfix(tokens, close_pos, index_expr(expr, idx), parse_recur)
          }
        }
      }
    },
    TDot => match peek(tokens, pos + 1) {
      TIdent(field) => parse_postfix(tokens, pos + 2, EDot(expr, field), parse_recur),
      TInt(idx) => parse_postfix(tokens, pos + 2, EDot(expr, __to_string(idx)), parse_recur),
      _ => (expr, pos)
    },
    _ => (expr, pos)
  }
}

let rec parse_prefix: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  match peek(tokens, pos) {
    TMinus => {
      let (e, next) = parse_prefix(tokens, pos + 1, parse_recur)
      (EUnaryOp("-", e), next)
    },
    TNot => {
      let (e, next) = parse_prefix(tokens, pos + 1, parse_recur)
      (EUnaryOp("!", e), next)
    },
    _ => {
      let (e, next) = parse_primary(tokens, pos, parse_recur)
      parse_postfix(tokens, next, e, parse_recur)
    }
  }
}

let rec parse_infix_loop: (Array[Token], Expr, Int, Int, Int, Bool, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, left, next, min_prec, expr_start, cmp_locked, parse_recur) -> {
  let tok = peek(tokens, next)
  let prec = binop_prec(tok)
  let should_stop = if prec < min_prec {
    true
  } else if cmp_locked {
    prec == 3
  } else {
    false
  }
  if should_stop {
    (left, next)
  } else {
    let is_pipe = match tok {
      TPipeGt => true,
      _ => false
    }
    let op = binop_op(tok)
    if is_pipe {
      if has_non_pipe_infix_top(tokens, expr_start, next) {
        throw("cannot mix '|>' with other infix operators without explicit parentheses")
      }
    }
    let (right0, right_next0) = parse_prefix(tokens, next + 1, parse_recur)
    let (right, rn) = parse_infix_loop(tokens, right0, right_next0, prec + 1, next + 1, false, parse_recur)
    if is_pipe {
      if has_non_pipe_infix_top(tokens, next + 1, rn) {
        throw("cannot mix '|>' with other infix operators without explicit parentheses")
      }
    }
    let combined = if is_pipe {
      pipe_desugar(left, right)
    } else {
      EBinOp(op, left, right)
    }
    let next_cmp_locked = if prec == 3 {
      true
    } else {
      cmp_locked
    }
    parse_infix_loop(tokens, combined, rn, min_prec, expr_start, next_cmp_locked, parse_recur)
  }
}

export let parse_infix_no_is: (Array[Token], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, min_prec, expr_start, parse_recur) -> {
  let (left0, next0) = parse_prefix(tokens, pos, parse_recur)
  parse_infix_loop(tokens, left0, next0, min_prec, expr_start, false, parse_recur)
}

export let parse_infix: (Array[Token], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, min_prec, expr_start, parse_recur) -> {
  let (expr, en) = parse_infix_no_is(tokens, pos, min_prec, expr_start, parse_recur)
  match peek(tokens, en) {
    TIs => {
      let (pat, pn) = parse_pattern(tokens, en + 1)
      (EMatch(expr, [
        (pat, EBool(true)),
        (PWild, EBool(false))
      ]), pn)
    },
    TIdent(kw) => if kw == "is" {
      let (pat, pn) = parse_pattern(tokens, en + 1)
      (EMatch(expr, [
        (pat, EBool(true)),
        (PWild, EBool(false))
      ]), pn)
    } else {
      (expr, en)
    },
    _ => (expr, en)
  }
}






enum BlockStep {
  StepSeq(Expr);
  StepValue(Expr);
  StepLet(String, Expr);
  StepLetMut(String, Expr);
  StepLetRec(String, Expr);
  StepAssign(String, Expr);
  StepAssignOp(String, String, Expr);
  StepPattern(Pat, Expr);
  StepStructDestr(Pat, Expr);
  StepRecordDestr(Pat, Expr);
  StepBind(String, Expr)
}

let rec parse_match_rest: (Array[Token], Int, Expr, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, scrutinee, b, parse_recur) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 2),
      _ => {
        let (pa, paa) = parse_pattern(tokens, pos + 1)
        let a2 = match peek(tokens, paa) {
          TIf => {
            let (_, ga) = parse_recur(tokens, paa + 1, 0)
            expect_tk(tokens, ga, "=>")
          },
          _ => expect_tk(tokens, paa, "=>")
        }
        let (ea, en) = parse_recur(tokens, a2, 0)
        ArrayBuilder::push(b, (pa, ea))
        parse_match_rest(tokens, en, scrutinee, b, parse_recur)
      }
    },
    TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 1),
    _ => {
      let (pa, paa) = parse_pattern(tokens, pos)
      let a2 = match peek(tokens, paa) {
        TIf => {
          let (_, ga) = parse_recur(tokens, paa + 1, 0)
          expect_tk(tokens, ga, "=>")
        },
        _ => expect_tk(tokens, paa, "=>")
      }
      let (ea, en) = parse_recur(tokens, a2, 0)
      ArrayBuilder::push(b, (pa, ea))
      parse_match_rest(tokens, en, scrutinee, b, parse_recur)
    }
  }
}

let rec qualify_handle_arm_pattern: (String, Pat) -> Pat = (effect_name, pat) -> {
  match pat {
    PCtor(name, args) => if String::contains(name, "::") {
      PCtor(name, args)
    } else {
      PCtor(String::concat(effect_name, String::concat("::", name)), args)
    },
    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),
    _ => pat
  }
}

let parse_handle_arm: (Array[Token], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } = (tokens, pos, effect_name, parse_recur) -> {
  let (pat, pat_next) = parse_pattern(tokens, pos)
  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)
  let arrow_pos = expect_tk(tokens, pat_next, "=>")
  let (expr, next) = parse_recur(tokens, arrow_pos, 0)
  ((qualified_pat, expr), next)
}

let rec parse_handle_rest: (Array[Token], Int, Expr, String, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, body, effect_name, b, parse_recur) -> {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),
      _ => {
        let (arm, next) = parse_handle_arm(tokens, pos + 1, effect_name, parse_recur)
        ArrayBuilder::push(b, arm)
        parse_handle_rest(tokens, next, body, effect_name, b, parse_recur)
      }
    },
    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),
    _ => throw("expected ';' or '}' in handle arm list")
  }
}

let parse_block_value_only: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, value_pos, parse_recur) -> {
  let val_pair = parse_recur(tokens, value_pos, 0)
  (val_pair.0, skip_semi(tokens, val_pair.1))
}

let apply_struct_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {
  let val_name = "__struct_destr"
  let mut desugar = rest
  match pat {
    PStruct(_, fields) => {
      let mut di = Array::length(fields) - 1
      while di >= 0 {
        let (fname, fpat) = Array::get(fields, di)
        match fpat {
          PBind(bname) => {
            desugar = ELet(bname, EDot(EIdent(val_name), fname), desugar)
          },
          _ => ()
        }
        di = di - 1
      }
    },
    _ => ()
  }
  ELet(val_name, val, desugar)
}

let apply_record_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {
  let val_name = "__rec_destr"
  let mut desugar = rest
  match pat {
    PTuple(field_pats) => {
      let mut di = Array::length(field_pats) - 1
      while di >= 0 {
        let fp = Array::get(field_pats, di)
        match fp {
          PBind(bname) => {
            desugar = ELet(bname, ECall(EIdent("__rec_field"), [
              EIdent(val_name),
              EInt(di)
            ]), desugar)
          },
          PTuple(sub_pats) => {
            let sub_name = String::concat("__rec_sub_", __to_string(di))
            let mut si = Array::length(sub_pats) - 1
            while si >= 0 {
              match Array::get(sub_pats, si) {
                PBind(sname) => {
                  desugar = ELet(sname, EDot(EIdent(sub_name), __to_string(si)), desugar)
                },
                _ => ()
              }
              si = si - 1
            }
            desugar = ELet(sub_name, ECall(EIdent("__rec_field"), [
              EIdent(val_name),
              EInt(di)
            ]), desugar)
          },
          _ => ()
        }
        di = di - 1
      }
    },
    _ => ()
  }
  ELet(val_name, val, desugar)
}

let apply_block_step: (BlockStep, Expr) -> Expr = (step, rest) -> {
  match step {
    StepSeq(expr) => ESeq(expr, rest),
    StepValue(expr) => expr,
    StepLet(name, val) => ELet(name, val, rest),
    StepLetMut(name, val) => ELetMut(name, val, rest),
    StepLetRec(name, val) => ELetRec(name, val, rest),
    StepAssign(name, val) => EAssign(name, val, rest),
    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),
    StepPattern(pat, val) => EMatch(val, [
      (pat, rest)
    ]),
    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),
    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),
    StepBind(name, val) => EMatch(val, [
      (PCtor("Ok", [
        PBind(name)
      ]), rest),
      (PCtor("Err", [
        PBind("__bind_err")
      ]), ECall(EIdent("Err"), [
        EIdent("__bind_err")
      ]))
    ])
  }
}

let fold_block_steps: (Array[BlockStep]) -> Expr = (steps) -> {
  let mut result = EUnit
  let mut i = Array::length(steps) - 1
  while i >= 0 {
    result = apply_block_step(Array::get(steps, i), result)
    i = i - 1
  }
  result
}

let parse_impl_block: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {
  let steps = ArrayBuilder::new()
  let mut p = pos
  let mut end_pos = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TRBrace => {
        end_pos = p + 1
        done = true
      },
      TEof => throw("unexpected eof in block"),
      TEnum => {
        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)
        match enum_stmt {
          SEnum(_, _, _, variants) => {
            let mut vi = 0
            while vi < Array::length(variants) {
              let (vname, vfields) = Array::get(variants, vi)
              if Array::length(vfields) == 0 {
                ArrayBuilder::push(steps, StepLet(vname, EInt(vi)))
              }
              vi = vi + 1
            }
          },
          _ => ()
        }
        p = enum_end
      },
      TStruct => {
        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)
        p = struct_end
      },
      TLet => {
        let next = p + 1
        match peek(tokens, next) {
          TRec => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq_pos_r = match peek(tokens, next + 2) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)
                  tp
                },
                _ => next + 2
              }
              let eq = expect_tk(tokens, eq_pos_r, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              if next_pos <= eq {
                throw("internal parser error: block let-rec parser did not advance")
              } else {
                ArrayBuilder::push(steps, StepLetRec(name, val))
                p = next_pos
              }
            },
            _ => throw("expected identifier after 'let rec'")
          },
          TMut => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq_pos_m = match peek(tokens, next + 2) {
                TColon => {
                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)
                  tp
                },
                _ => next + 2
              }
              let eq = expect_tk(tokens, eq_pos_m, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              if next_pos <= eq {
                throw("internal parser error: block let-mut parser did not advance")
              } else {
                ArrayBuilder::push(steps, StepLetMut(name, val))
                p = next_pos
              }
            },
            _ => throw("expected identifier after 'let mut'")
          },
          TStar => match peek(tokens, next + 1) {
            TIdent(name) => {
              let eq = expect_tk(tokens, next + 2, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              if next_pos <= eq {
                throw("internal parser error: block let* parser did not advance")
              } else {
                ArrayBuilder::push(steps, StepBind(name, val))
                p = next_pos
              }
            },
            _ => throw("expected identifier after 'let*'")
          },
          TIdent(name) => {
            let after_name = peek(tokens, next + 1)
            let next_is_struct_destr = match after_name {
              TDoubleColon => {
                let fc = String::char_code_at(name, 0)
                if fc >= 65 && fc <= 90 {
                  match peek(tokens, next + 2) {
                    TLBrace => true,
                    _ => false
                  }
                } else {
                  false
                }
              },
              _ => false
            }
            let next_is_record_destr = match after_name {
              TLBrace => name == "record",
              _ => false
            }
            if next_is_struct_destr {
              let (pat, pn) = parse_pattern(tokens, next)
              let eq = expect_tk(tokens, pn, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              ArrayBuilder::push(steps, StepStructDestr(pat, val))
              p = next_pos
            } else if next_is_record_destr {
              let (pat, pn) = parse_pattern(tokens, next)
              let eq = expect_tk(tokens, pn, "=")
              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
              ArrayBuilder::push(steps, StepRecordDestr(pat, val))
              p = next_pos
            } else {
              match after_name {
                TLParen => {
                  let (pat, pn) = parse_pattern(tokens, next)
                  let eq = expect_tk(tokens, pn, "=")
                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
                  if next_pos <= eq {
                    throw("internal parser error: block let-ctor-pat parser did not advance")
                  } else {
                    ArrayBuilder::push(steps, StepPattern(pat, val))
                    p = next_pos
                  }
                },
                _ => {
                  let eq_pos = match after_name {
                    TColon => {
                      let (_, tp) = parse_type_impl(tokens, next + 2, 0)
                      tp
                    },
                    _ => next + 1
                  }
                  let eq = expect_tk(tokens, eq_pos, "=")
                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
                  if next_pos <= eq {
                    throw("internal parser error: block let parser did not advance")
                  } else {
                    ArrayBuilder::push(steps, StepLet(name, val))
                    p = next_pos
                  }
                }
              }
            }
          },
          TLParen => {
            let (pat, pn) = parse_pattern(tokens, next)
            let eq = expect_tk(tokens, pn, "=")
            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)
            if next_pos <= eq {
              throw("internal parser error: block let-pat parser did not advance")
            } else {
              ArrayBuilder::push(steps, StepPattern(pat, val))
              p = next_pos
            }
          },
          _ => throw("expected identifier after 'let'")
        }
      },
      _ => {
        let (e, next) = parse_recur(tokens, p, 0)
        if next <= p {
          throw("internal parser error: block expr parser did not advance")
        } else {
          match peek(tokens, next) {
            TRBrace => {
              ArrayBuilder::push(steps, StepValue(e))
              end_pos = next + 1
              done = true
            },
            TSemicolon => {
              ArrayBuilder::push(steps, StepSeq(e))
              p = next + 1
            },
            TEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssign(name, val))
                p = next_pos
              },
              EDot(obj, field) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                let set_args = empty_exprs()
                Array::push(set_args, obj)
                Array::push(set_args, EString(field))
                Array::push(set_args, val)
                ArrayBuilder::push(steps, StepSeq(ECall(EIdent("__set_field"), set_args)))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TPlusEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "+", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TMinusEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "-", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TStarEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "*", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TSlashEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "/", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            TPercentEq => match e {
              EIdent(name) => {
                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)
                ArrayBuilder::push(steps, StepAssignOp(name, "%", val))
                p = next_pos
              },
              _ => throw("invalid assignment target")
            },
            _ => {
              ArrayBuilder::push(steps, StepSeq(e))
              p = next
            }
          }
        }
      }
    }
  }
  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)
}

let build_pull_for_in: (String, Option[String], Expr, Expr, Int) -> Expr = (value_name, index_name, iterable, body, uid) -> {
  let next_var = "__pull_next_\{uid}"
  let cont_var = "__pull_continue_\{uid}"
  let some_arm = match index_name {
    Some(ix) => ESeq(body, EAssign(ix, EBinOp("+", EIdent(ix), EInt(1)), EUnit)),
    None => ESeq(body, EUnit)
  }
  let loop_body = EMatch(ECall(EIdent(next_var), []), [
    (PCtor("Some", [PBind(value_name)]), some_arm),
    (PCtor("None", []), EAssign(cont_var, EBool(false), EUnit))
  ])
  let core_loop = ELetMut(cont_var, EBool(true), EWhile(EIdent(cont_var), loop_body))
  let with_index = match index_name {
    Some(ix) => ELetMut(ix, EInt(0), core_loop),
    None => core_loop
  }
  ELet(next_var, iterable, with_index)
}

export let parse_impl_dispatch: (Array[Token], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, mode, parse_recur) -> {
  if mode == 20 {
    parse_impl_block(tokens, pos, parse_recur)
  } else if mode == 21 {
    let (cond, cn) = parse_infix_no_is(tokens, pos, 0, pos, parse_recur)
    let mut is_mode = false
    let mut is_pat_val = PWild
    let mut brace_pos = cn
    match peek(tokens, cn) {
      TIs => {
        let (pat, pn) = parse_pattern(tokens, cn + 1)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      TIdent(kw) => if kw == "is" {
        let (pat, pn) = parse_pattern(tokens, cn + 1)
        is_mode = true
        is_pat_val = pat
        brace_pos = pn
      },
      _ => ()
    }
    let br = expect_tk(tokens, brace_pos, "{")
    let (then_e, tn) = parse_recur(tokens, br, 20)
    let (else_e, end_pos) = match peek(tokens, tn) {
      TElse => match peek(tokens, tn + 1) {
        TIf => parse_recur(tokens, tn + 2, 21),
        TLBrace => parse_recur(tokens, tn + 2, 20),
        _ => parse_recur(tokens, tn + 1, 0)
      },
      _ => (EUnit, tn)
    }
    if is_mode {
      (EMatch(cond, [
        (is_pat_val, then_e),
        (PWild, else_e)
      ]), end_pos)
    } else {
      (EIf(cond, then_e, else_e), end_pos)
    }
  } else if mode == 22 {
    let (scrutinee, sn) = parse_recur(tokens, pos, 0)
    let br = expect_tk(tokens, sn, "{")
    match peek(tokens, br) {
      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),
      _ => {
        let b = ArrayBuilder::new()
        let (fp, fa) = parse_pattern(tokens, br)
        let aa = match peek(tokens, fa) {
          TIf => {
            let (_, ga) = parse_recur(tokens, fa + 1, 0)
            expect_tk(tokens, ga, "=>")
          },
          _ => expect_tk(tokens, fa, "=>")
        }
        let (fe, fn1) = parse_recur(tokens, aa, 0)
        ArrayBuilder::push(b, (fp, fe))
        parse_match_rest(tokens, fn1, scrutinee, b, parse_recur)
      }
    }
  } else if mode == 23 {
    let (cond, cn) = parse_recur(tokens, pos, 0)
    let br = expect_tk(tokens, cn, "{")
    let (body, end) = parse_recur(tokens, br, 20)
    (EWhile(cond, body), end)
  } else if mode == 24 {
    let br = expect_tk(tokens, pos, "{")
    let (body, bn) = parse_recur(tokens, br, 20)
    let wp = expect_tk(tokens, bn, "with")
    let (effect_name, effect_next) = match peek(tokens, wp) {
      TIdent(name) => (name, wp + 1),
      _ => throw("expected effect name after 'with'")
    }
    let hb = expect_tk(tokens, effect_next, "{")
    match peek(tokens, hb) {
      TRBrace => (EHandle(body, empty_arms()), hb + 1),
      _ => {
        let b = ArrayBuilder::new()
        let (arm, next) = parse_handle_arm(tokens, hb, effect_name, parse_recur)
        ArrayBuilder::push(b, arm)
        parse_handle_rest(tokens, next, body, effect_name, b, parse_recur)
      }
    }
  } else if mode == 25 {
    let mut start = pos
    let mut is_await = false
    match peek(tokens, pos) {
      TIdent(marker) => if marker == "await" {
        match peek(tokens, pos + 1) {
          TIdent(_) => { start = pos + 1; is_await = true },
          _ => ()
        }
      } else (),
      _ => ()
    }
    match peek(tokens, start) {
      TIdent(first_name) => match peek(tokens, start + 1) {
        TComma => match peek(tokens, start + 2) {
          TIdent(second_name) => {
            let ip = expect_tk(tokens, start + 3, "in")
            match parse_recur(tokens, ip, 0) {
              (iterable, after_iter) => {
                let bb = expect_tk(tokens, after_iter, "{")
                let (body, end) = parse_recur(tokens, bb, 20)
                let loop_expr = if is_await {
                  build_pull_for_in(second_name, Some(first_name), iterable, body, start)
                } else {
                  EForIn(second_name, Some(first_name), iterable, body)
                }
                (loop_expr, end)
              },
              _ => throw("unreachable: parse_recur for for-in")
            }
          },
          _ => throw("expected value binding name after ','")
        },
        _ => {
          let ip = expect_tk(tokens, start + 1, "in")
          match parse_recur(tokens, ip, 0) {
            (iterable, after_iter) => {
              let bb = expect_tk(tokens, after_iter, "{")
              let (body, end) = parse_recur(tokens, bb, 20)
              let loop_expr = if is_await {
                build_pull_for_in(first_name, None, iterable, body, start)
              } else {
                EForIn(first_name, None, iterable, body)
              }
              (loop_expr, end)
            },
            _ => throw("unreachable: parse_recur for for-in")
          }
        }
      }
      ,
      _ => throw("expected identifier after 'for'")
    }
  } else {
    let actual = tk_name(peek(tokens, pos))
    throw("internal parser error: unknown parse mode \{mode} at #\{pos} token=\{actual}")
  }
}







export let parse_impl: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (tokens, pos, mode) -> {
  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {
    if rmode >= 0 && rmode <= 10 {
      parse_infix(rtoks, rpos, rmode, rpos, parse_recur)
    } else {
      parse_impl_dispatch(rtoks, rpos, rmode, parse_recur)
    }
  }
  parse_recur(tokens, pos, mode)
}

export let parse: (Array[Token]) -> Expr with { Error } = (tokens) -> {
  let (e, next) = parse_impl(tokens, 0, 0)
  match peek(tokens, next) {
    TEof => e,
    _ => {
      let actual = tk_name(peek(tokens, next))
      throw("unexpected after expression: \{actual}")
    }
  }
}

export let parse_ok: (Array[Token]) -> Bool = (tokens) -> {
  handle {
    let _ = parse(tokens)
    true
  } with Error {
    Throw(_) => false
  }
}

export let parse_expr: (Array[Token], Int) -> (Expr, Int) with { Error } = (tokens, pos) -> {
  parse_impl(tokens, pos, 0)
}

let parse_type_param_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

let parse_let_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

let parse_let_annotation: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLBracket => {
      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)
      let (ty, next) = parse_type_impl(tokens, after_params, 0)
      (type_params, type_bounds, ty, next)
    },
    _ => {
      let (ty, next) = parse_type_impl(tokens, pos, 0)
      (_no_tp(), _no_tb(), ty, next)
    }
  }
}

let apply_fn_annotation_params: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, param_types) -> {
  if Array::length(params) != Array::length(param_types) {
    params
  } else {
    let out = ArrayBuilder::new()
    let mut i = 0
    while i < Array::length(params) {
      let (name, ann) = Array::get(params, i)
      let next_ann = match ann {
        Some(_) => ann,
        None => Some(Array::get(param_types, i))
      }
      ArrayBuilder::push(out, (name, next_ann))
      i = i + 1
    }
    ArrayBuilder::freeze(out)
  }
}

let apply_generic_fn_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr, Array[TypeExpr], TypeExpr, Option[String]) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val, param_types, ret_ty, effect_name) -> {
  match val {
    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {
      let next_params = apply_fn_annotation_params(params, param_types)
      let next_ret = match ret_opt {
        Some(_) => ret_opt,
        None => Some(ret_ty)
      }
      let next_effect = match effect_opt {
        Some(_) => effect_opt,
        None => effect_name
      }
      let next_type_params = if Array::length(type_params) > 0 {
        type_params
      } else existing_type_params
      let next_type_bounds = if Array::length(type_params) > 0 {
        type_bounds
      } else existing_type_bounds
      let next_ann = if Array::length(type_params) > 0 {
        None
      } else ann
      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))
    },
    _ => (ann, val)
  }
}

let apply_generic_let_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val) -> {
  match ann {
    Some(ann_ty) => match ann_ty {
      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),
      _ => (ann, val)
    },
    _ => (ann, val)
  }
}

let apply_value_bracket_type_params: (Array[String], Array[(String, Array[String])], Expr) -> Expr = (tps, tbs, val) -> {
  if Array::length(tps) == 0 {
    val
  } else {
    match val {
      EFn(existing_tp, existing_tb, params, ret, eff, body) => {
        let next_tp = if Array::length(existing_tp) > 0 {
          existing_tp
        } else tps
        let next_tb = if Array::length(existing_tp) > 0 {
          existing_tb
        } else tbs
        EFn(next_tp, next_tb, params, ret, eff, body)
      },
      _ => val
    }
  }
}

let skip_generic_value_start: (Array[Token], Int) -> Int = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLBracket => match peek(tokens, pos + 1) {
      TIdent(_) => {
        let maybe_generic = match peek(tokens, pos + 2) {
          TRBracket => match peek(tokens, pos + 3) {
            TLParen => true,
            _ => false
          },
          TColon => true,
          TComma => true,
          _ => false
        }
        if maybe_generic {
          let mut scan_pos = pos + 1
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, scan_pos) {
              TLBracket => {
                depth = depth + 1
              },
              TRBracket => {
                depth = depth - 1
              },
              _ => ()
            }
            scan_pos = scan_pos + 1
          }
          scan_pos
        } else {
          pos
        }
      },
      _ => pos
    },
    _ => pos
  }
}

let parse_value_bracket_header: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {
  let skipped = skip_generic_value_start(tokens, pos)
  if skipped == pos {
    (_no_tp(), _no_tb(), pos)
  } else {
    match peek(tokens, pos) {
      TLBracket => {
        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)
        (tps, tbs, skipped)
      },
      _ => (_no_tp(), _no_tb(), skipped)
    }
  }
}

let parse_let_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TRec => {
      let (name, name_next) = parse_binding_name(tokens, pos + 1)
      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {
        TColon => {
          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)
          (tparams, tbounds, Some(ty), tp)
        },
        _ => (_no_tp(), _no_tb(), None, name_next)
      }
      let ep = expect_tk(tokens, eq_pos, "=")
      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)
      let val_pair = parse_impl(tokens, val_start_r, 0)
      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)
      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)
      let val_next = val_pair.1
      (SLet(exported, true, name, final_ty_opt, val), val_next)
    },
    TMut => match peek(tokens, pos + 1) {
      TIdent(name) => {
        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)
            (Some(ty), tp)
          },
          _ => (None, pos + 2)
        }
        let ep = expect_tk(tokens, eq_pos, "=")
        let val_pair = parse_impl(tokens, ep, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        (SLetMut(name, ty_opt, val), val_next)
      },
      _ => throw("expected name after 'let mut'")
    },
    TLParen => {
      let (pat, pat_next) = parse_pattern(tokens, pos)
      let ep = expect_tk(tokens, pat_next, "=")
      let val_pair = parse_impl(tokens, ep, 0)
      let val = val_pair.0
      let val_next = val_pair.1
      (SLetPat(pat, val), val_next)
    },
    TIdent(_name0) => {
      let is_struct_destructure = match peek(tokens, pos + 1) {
        TDoubleColon => match peek(tokens, pos + 2) {
          TLBrace => true,
          _ => false
        },
        _ => false
      }
      if is_struct_destructure {
        let (pat, pat_next) = parse_pattern(tokens, pos)
        let ep = expect_tk(tokens, pat_next, "=")
        let val_pair = parse_impl(tokens, ep, 0)
        let val = val_pair.0
        let val_next = val_pair.1
        (SLetPat(pat, val), val_next)
      } else {
        let (name, name_next) = parse_binding_name(tokens, pos)
        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {
          TColon => {
            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)
            (tparams, tbounds, Some(ty), tp)
          },
          _ => (_no_tp(), _no_tb(), None, name_next)
        }
        let ep = expect_tk(tokens, eq_pos, "=")
        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)
        let val_pair = parse_impl(tokens, val_start, 0)
        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)
        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)
        let val_next = val_pair.1
        (SLet(exported, false, name, final_ty_opt, val), val_next)
      }
    },
    _ => throw("expected name after 'let'")
  }
}


export {
  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name
}

export {
  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch
}






let parser_mode_block = 20

let empty_names: () -> Array[String] = () -> {
  Array::slice([
    "_"
  ], 0, 0)
}

let parse_test_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, br, parser_mode_block);
      (STest(name, body), end)
    },
    _ => throw("expected test name string")
  }
}

let parse_bench_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TString(name) => {
      let br = expect_tk(tokens, pos + 1, "{")
      let (body, end) = parse_impl(tokens, br, parser_mode_block);
      (SBench(name, body), end)
    },
    _ => throw("expected bench name string")
  }
}

let parse_export_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) =>
          (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name in export list")
  }
}

let rec parse_export_names_rest: (Array[Token], Int, ArrayBuilder[String]) -> (Array[String], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      TIdent(_) => {
        let (nm, after) = parse_export_name(tokens, pos + 1)
        ArrayBuilder::push(b, nm)
        parse_export_names_rest(tokens, after, b)
      },
      _ => throw("expected name in export list")
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in export list")
  }
}

let rec parse_import_items_rest: (Array[Token], Int, ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (item, next) = parse_import_item(tokens, pos + 1)
        ArrayBuilder::push(b, item)
        parse_import_items_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or '}' in import list")
  }
}

let parse_import_items: (Array[Token], Int) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRBrace => (empty_import_items(), pos + 1),
    _ => {
      let (first, next) = parse_import_item(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_import_items_rest(tokens, next, b)
    }
  }
}

let parse_import_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {
      let br = expect_tk(tokens, pos + 1, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(name, items), end)
    } else {
      let (path, bp) = collect_import_path(tokens, pos, "")
      match peek(tokens, bp) {
        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {
          let alias_str = String::substring(alias_name, 1, String::length(alias_name))
          (SAliasDecl(alias_str, path), bp + 1)
        } else {
          let br = expect_tk(tokens, bp, "{")
          let (items, end) = parse_import_items(tokens, br);
          (SImport(path, items), end)
        },
        _ => {
          let br = expect_tk(tokens, bp, "{")
          let (items, end) = parse_import_items(tokens, br);
          (SImport(path, items), end)
        }
      }
    },
    _ => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SImport(path, items), end)
    }
  }
}

let rec parse_toplevel_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_toplevel_struct_fields_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_toplevel_struct_fields_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in struct")
  }
}

let parse_toplevel_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), pos + 1),
    _ => {
      let (first, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_toplevel_struct_fields_rest(tokens, next, b)
    }
  }
}

let parse_toplevel_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => {
      let after_name = match peek(tokens, pos + 1) {
        TLBracket => {
          let mut skip = pos + 2
          let mut depth = 1
          while depth > 0 {
            match peek(tokens, skip) {
              TLBracket => {
                depth = depth + 1; skip = skip + 1
              },
              TRBracket => {
                depth = depth - 1; skip = skip + 1
              },
              TEof => {
                depth = 0
              },
              _ => {
                skip = skip + 1
              }
            }
          }
          skip
        },
        _ => pos + 1
      }
      let br = expect_tk(tokens, after_name, "{")
      let (fields, end) = parse_toplevel_struct_fields(tokens, br);
      let final_pos = skip_derive(tokens, end)
      (SStruct(exported, name, fields), final_pos)
    },
    _ => throw("expected struct name")
  }
}

let parse_export_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLet => parse_let_stmt(tokens, pos + 1, true),
    TEnum => parse_enum_stmt(tokens, pos + 1, true),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),
    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),
    TIdent(ident_name) => if ident_name == "effect" {
      parse_effect_stmt(tokens, pos + 1, true)
    } else {
      throw(String::concat("unexpected token in export: ", ident_name))
    },
    TType => parse_type_alias_stmt(tokens, pos + 1, true),
    TTrait => parse_trait_stmt(tokens, pos + 1, true),
    TOpen => match peek(tokens, pos + 1) {
      TTrait => parse_trait_stmt(tokens, pos + 2, true),
      _ => throw("expected 'trait' after 'open'")
    },
    TLBrace => match peek(tokens, pos + 1) {
      TRBrace => (SExport(empty_names()), pos + 2),
      TIdent(_) => {
        let (first, after) = parse_export_name(tokens, pos + 1)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, first)
        let (names, end) = parse_export_names_rest(tokens, after, b);
        (SExport(names), end)
      },
      _ => throw("expected name in export list")
    },
    TDot => {
      let (path, bp) = collect_import_path(tokens, pos, "")
      let br = expect_tk(tokens, bp, "{")
      let (items, end) = parse_import_items(tokens, br);
      (SReExport(path, items), end)
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("unexpected after 'export': \{actual}")
    }
  }
}

let parse_percent_symbol_name: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, label) -> {
  let pp = expect_tk(tokens, pos, "%")
  match peek(tokens, pp) {
    TIdent(name) => ("%\{name}", pp + 1),
    _ => throw("expected \{label} after '%'")
  }
}

let parse_extern_let_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  let lp = expect_tk(tokens, pos, "let")
  let (name, np) = parse_percent_symbol_name(tokens, lp, "extern symbol name")
  let cp = expect_tk(tokens, np, ":")
  let (ty, end) = parse_type(tokens, cp);
  (SExternLet(name, ty), end)
}

let rec parse_module_body_with: ((Array[Token], Int) -> (Stmt, Int) with { Error }, Array[Token], Int, ArrayBuilder[Stmt]) -> (Array[Stmt], Int) with { Error } = (parse_stmt_fn, tokens, pos, b) -> {
  match peek(tokens, pos) {
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => {
      let (stmt, next) = parse_stmt_fn(tokens, pos)
      ArrayBuilder::push(b, stmt)
      parse_module_body_with(parse_stmt_fn, tokens, next, b)
    }
  }
}

export let rec parse_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  let head = peek(tokens, pos)
  match head {
    TLet => parse_let_stmt(tokens, pos + 1, false),
    TExport => match peek(tokens, pos + 1) {
      TModule => match peek(tokens, pos + 2) {
        TIdent(name) => {
          let br = expect_tk(tokens, pos + 3, "{")
          {
            let (stmts, end) = parse_module_body_with(parse_stmt, tokens, br, ArrayBuilder::new());
            (SModule(true, name, stmts), end)
          }
        },
        _ => throw("expected module name")
      },
      _ => parse_export_stmt(tokens, pos + 1)
    },
    TModule => match peek(tokens, pos + 1) {
      TIdent(name) => {
        let br = expect_tk(tokens, pos + 2, "{")
        {
          let (stmts, end) = parse_module_body_with(parse_stmt, tokens, br, ArrayBuilder::new());
          (SModule(false, name, stmts), end)
        }
      },
      _ => throw("expected module name")
    },
    TEnum => parse_enum_stmt(tokens, pos + 1, false),
    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),
    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),
    TType => parse_type_alias_stmt(tokens, pos + 1, false),
    TTrait => parse_trait_stmt(tokens, pos + 1, false),
    TTest => parse_test_stmt(tokens, pos + 1),
    TBench => parse_bench_stmt(tokens, pos + 1),
    TImport => parse_import_stmt(tokens, pos + 1),
    TIdent(name) => match name {
      "effect" => parse_effect_stmt(tokens, pos + 1, false),
      "extern" => parse_extern_let_stmt(tokens, pos + 1),
      "use" => throw("'use' syntax is removed; use 'import <module-ref> { ... }'"),
      _ => {
      let (e, next) = parse_impl(tokens, pos, 0)
      match peek(tokens, next) {
        TEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssign(name, val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TPlusEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "+", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TMinusEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "-", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TStarEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "*", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        TSlashEq => match e {
          EIdent(name) => {
            let (val, vn) = parse_impl(tokens, next + 1, 0)
            (SExpr(EAssignOp(name, "/", val, EUnit)), vn)
          },
          _ => (SExpr(e), next)
        },
        _ => (SExpr(e), next)
      }
      }
    },
    _ => {
      let (e, next) = parse_impl(tokens, pos, 0);
      (SExpr(e), next)
    }
  }
}

export let parse_program: (Array[Token]) -> Array[Stmt] with { Error } = (tokens) -> {
  let b = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      TImpl => {
        let (stmt, next) = parse_impl_stmt_dispatch(tokens, pos + 1)
        ArrayBuilder::push(b, stmt)
        pos = next
      },
      _ => {
        let (stmt, next) = parse_stmt(tokens, pos)
        ArrayBuilder::push(b, stmt)
        pos = next
      }
    }
  }
  ArrayBuilder::freeze(b)
}

export let parse_program_spans: (Array[Token], Array[Int], Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } = (tokens, starts, ends) -> {
  let b = ArrayBuilder::new()
  let span_start = ArrayBuilder::new()
  let span_end = ArrayBuilder::new()
  let mut pos = 0
  let mut done = false
  while !done {
    match peek(tokens, pos) {
      TEof => {
        done = true
      },
      TSemicolon => {
        pos = pos + 1
      },
      TImpl => {
        let st = Array::get(starts, pos)
        let (stmt, next) = parse_impl_stmt_dispatch(tokens, pos + 1)
        ArrayBuilder::push(b, stmt)
        ArrayBuilder::push(span_start, st)
        ArrayBuilder::push(span_end, Array::get(ends, next - 1))
        pos = next
      },
      _ => {
        let st = Array::get(starts, pos)
        let (stmt, next) = parse_stmt(tokens, pos)
        ArrayBuilder::push(b, stmt)
        ArrayBuilder::push(span_start, st)
        ArrayBuilder::push(span_end, Array::get(ends, next - 1))
        pos = next
      }
    }
  }
  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))
}


