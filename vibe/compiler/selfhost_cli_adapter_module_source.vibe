      emit_i64_shr_s(buf)
      emit_i64_eqz(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, cap_local)
      emit_local_get(buf, cap_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 2147483647)
      emit_i32_gt_u(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_call(buf, bl_idx)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_call(buf, al_idx)
      emit_end(buf)
      emit_else(buf)
      emit_local_get(buf, obj_local)
