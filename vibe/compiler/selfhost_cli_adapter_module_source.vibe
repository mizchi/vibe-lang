export {
  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_code_section, emit_type_section, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_export_section_multi, emit_code_section_with_locals
}




let vt_i32 = 127

let sec_data = 11

let type_func = 96

let sec_export = 7

let sec_global = 6

let sec_import = 2

let export_func = 0

let export_memory = 2

let op_global_get = 35

let op_global_set = 36

let op_i32_add = 106

let op_i32_sub = 107

let op_i32_shr_u = 118

let op_i32_gt_u = 75

let op_memory_size = 63

let op_memory_grow = 64

let op_drop = 26

let op_if = 4

let bt_void = 64

export let emit_global_get: (Bytes, Int) -> Unit = (buf, idx) -> {
  bytebuf_push_opcode_u32(buf, op_global_get, idx)
}

export let emit_heap_memory_grow_check: (Bytes) -> Unit = (buf) -> {
  emit_global_get(buf, 0)
  emit_i32_const(buf, 65535)
  bytebuf_push(buf, op_i32_add)
  emit_i32_const(buf, 16)
  bytebuf_push(buf, op_i32_shr_u)
  bytebuf_push2(buf, op_memory_size, 0)
  bytebuf_push(buf, op_i32_gt_u)
  bytebuf_push2(buf, op_if, bt_void)
  emit_global_get(buf, 0)
  emit_i32_const(buf, 65535)
  bytebuf_push(buf, op_i32_add)
  emit_i32_const(buf, 16)
  bytebuf_push(buf, op_i32_shr_u)
  bytebuf_push2(buf, op_memory_size, 0)
  bytebuf_push(buf, op_i32_sub)
  bytebuf_push2(buf, op_memory_grow, 0)
  bytebuf_push(buf, op_drop)
  emit_end(buf)
}

export let emit_global_set: (Bytes, Int) -> Unit = (buf, idx) -> {
  bytebuf_push_opcode_u32(buf, op_global_set, idx)
}

export let emit_data_section: (Bytes, Int, Bytes) -> Unit = (out, offset, data) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push(content, 0)
  emit_i32_const(content, offset)
  emit_end(content)
  leb128_encode_u32(content, Bytes::length(data))
  bytebuf_push_buf(content, data)
  bytebuf_push_section(out, sec_data, content)
}

export let emit_exports_full: (Bytes, Array[String], Array[Int], String, Int, Array[String], Array[Int]) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx, global_names, global_indices) -> {
  let count = Array::length(fn_names) + 1 + Array::length(global_names)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  emit_name(content, mem_name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  let mut gi = 0
  while gi < Array::length(global_names) {
    emit_name(content, Array::get(global_names, gi))
    bytebuf_push(content, 3)
    leb128_encode_u32(content, Array::get(global_indices, gi))
    gi = gi + 1
  }
  bytebuf_push_section(out, sec_export, content)
}

export let emit_export_memory: (Bytes, String, Int) -> Unit = (out, name, mem_idx) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, sec_export, content)
}

export let emit_func_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, param_types, result_types) -> {
  bytebuf_push(buf, type_func)
  leb128_encode_u32(buf, Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    bytebuf_push(buf, Array::get(param_types, i))
    i = i + 1
  }
  leb128_encode_u32(buf, Array::length(result_types))
  let mut j = 0
  while j < Array::length(result_types) {
    bytebuf_push(buf, Array::get(result_types, j))
    j = j + 1
  }
}

export let emit_exports_with_memory: (Bytes, Array[String], Array[Int], String, Int) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx) -> {
  let count = Array::length(fn_names) + 1
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < Array::length(fn_names) {
    emit_name(content, Array::get(fn_names, i))
    bytebuf_push(content, export_func)
    leb128_encode_u32(content, Array::get(fn_indices, i))
    i = i + 1
  }
  emit_name(content, mem_name)
  bytebuf_push(content, export_memory)
  leb128_encode_u32(content, mem_idx)
  bytebuf_push_section(out, sec_export, content)
}

export let emit_import_section_func: (Bytes, String, String, Int) -> Unit = (out, module_name, field_name, type_idx) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  emit_name(content, module_name)
  emit_name(content, field_name)
  bytebuf_push(content, export_func)
  leb128_encode_u32(content, type_idx)
  bytebuf_push_section(out, sec_import, content)
}

export let emit_global_section_i32_mut: (Bytes, Int) -> Unit = (out, init_value) -> {
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, 1)
  bytebuf_push2(content, vt_i32, 1)
  emit_i32_const(content, init_value)
  emit_end(content)
  bytebuf_push_section(out, sec_global, content)
}



let emit_ascii_payload: (Bytes, String) -> Unit = (buf, text) -> {
  let len = String::length(text)
  let mut i = 0
  while i < len {
    bytebuf_push(buf, String::char_code_at(text, i))
    i = i + 1
  }
}

export let emit_vibe_abi_custom_section: (Bytes, String) -> Unit = (out, host_import_abi) -> {
  let content = bytebuf_new()
  bytebuf_push_string(content, "vibe.abi")
  emit_ascii_payload(content, "version=1\n")
  emit_ascii_payload(content, String::concat("host_import_abi=", host_import_abi))
  emit_ascii_payload(content, "\n")
  bytebuf_push_section(out, 0, content)
}





