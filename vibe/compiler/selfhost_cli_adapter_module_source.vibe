export let parse_interp_expr: (Array[Token]) -> Expr with { Error } = (tokens) -> {
  let (stmt, _) = parse_stmt(tokens, 0)
  match stmt {
    SExpr(expr) => expr,
    _ => throw("expected interpolation expression")
  }
}





export let collect_interp_exprs: (Array[String]) -> Array[Expr] with { Error } = (parts) -> {
  let plen = Array::length(parts)
  let exprs = ArrayBuilder::new()
  let mut i = 0
  while i < plen {
    let lit = Array::get(parts, i)
    if String::length(lit) > 0 {
      ArrayBuilder::push(exprs, EString(lit))
    }
    if i + 1 < plen {
      let expr_src = Array::get(parts, i + 1)
      let part_tokens = lex(expr_src)
      let part_expr = parse_interp_expr(part_tokens)
      ArrayBuilder::push(exprs, ECall(EIdent("__to_string"), [
        part_expr
      ]))
    }
    i = i + 2
  }
  ArrayBuilder::freeze(exprs)
}



let concat_exprs: (Expr, Expr) -> Expr = (lhs, rhs) -> {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, lhs)
  ArrayBuilder::push(b, rhs)
  let args = ArrayBuilder::freeze(b)
  ECall(EIdent("String::concat"), args)
}

export let fold_interp_exprs_loop: (Array[Expr], Int, Expr, Int) -> Expr = (result_arr, result_len, result0, j0) -> {
  let mut result = result0
  let mut j = j0
  while j < result_len {
    let rhs = Array::get(result_arr, j)
    result = concat_exprs(result, rhs)
    j = j + 1
  }
  result
}




export let fold_interp_exprs_nonempty: (Array[Expr], Int) -> Expr = (result_arr, result_len) -> {
  let first = Array::get(result_arr, 0)
  fold_interp_exprs_loop(result_arr, result_len, first, 1)
}




export let fold_interp_exprs: (Array[Expr]) -> Expr = (result_arr) -> {
  let result_len = Array::length(result_arr)
  if result_len == 0 {
    EString("")
  } else {
    fold_interp_exprs_nonempty(result_arr, result_len)
  }
}



export {
