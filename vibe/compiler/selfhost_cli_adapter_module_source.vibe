let lookup_array_truncate: (String) -> Option[Type] = (name) -> {
  if name == "Array::truncate" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnit, None))
  }
  else None
}
let lookup_array_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_array_push(name) {
    Some(t) => Some(t),
    None => match lookup_array_slice(name) {
      Some(t) => Some(t),
      None => match lookup_array_push_all(name) {
        Some(t) => Some(t),
        None => match lookup_array_truncate(name) {
          Some(t) => Some(t),
          None => match lookup_array_concat(name) {
            Some(t) => Some(t),
            None => match lookup_array_map(name) {
              Some(t) => Some(t),
              None => match lookup_array_fold(name) {
                Some(t) => Some(t),
                None => match lookup_array_filter(name) {
                  Some(t) => Some(t),
                  None => match lookup_array_foreach(name) {
                    Some(t) => Some(t),
                    None => match lookup_array_reverse(name) {
                      Some(t) => Some(t),
                      None => match lookup_array_any(name) {
                        Some(t) => Some(t),
                        None => match lookup_array_find(name) {
                          Some(t) => Some(t),
                          None => match lookup_array_sort(name) {
                            Some(t) => Some(t),
                            None => match lookup_array_contains(name) {
                              Some(t) => Some(t),
                              None => lookup_array_join(name)
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
export let lookup_array: (String) -> Option[Type] = (name) -> {
  match lookup_array_group_a(name) {
    Some(t) => Some(t),
    None => lookup_array_group_b(name)
  }
}
let async_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}
let lookup_future: (String) -> Option[Type] = (name) -> {
  if name == "await" {
    Some(CtFn([
      CtNamed("Future", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Future::ready" {
    Some(CtFn([
      CtUnknown
    ], CtNamed("Future", [
      CtUnknown
    ]), None))
  } else {
    None
  }
}
let lookup_stream: (String) -> Option[Type] = (name) -> {
  if name == "Stream::empty" {
    Some(CtFn(async_no_params(), CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::once" {
    Some(CtFn([
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::next" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ])
    ], CtNamed("Future", [
      CtOption(CtUnknown)
    ]), Some("Async")))
  } else if name == "Stream::map" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::filter" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::fold" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown,
      CtUnknown
    ], CtNamed("Future", [
      CtUnknown
    ]), Some("Async")))
  } else {
    None
  }
}
let lookup_concurrency: (String) -> Option[Type] = (name) -> {
  if name == "Task::spawn" {
    Some(CtFn([
      CtUnknown
    ], CtNamed("Task", [
      CtUnknown
    ]), Some("Async")))
  } else if name == "Task::join" {
    Some(CtFn([
      CtNamed("Task", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Task::cancel" {
    Some(CtFn([
      CtNamed("Task", [
        CtUnknown
      ])
    ], CtUnit, Some("Async")))
  } else if name == "Task::race" {
    Some(CtFn([
      CtNamed("Task", [
        CtUnknown
      ]),
      CtNamed("Task", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Task::timeout" {
    Some(CtFn([
      CtInt,
      CtUnknown
    ], CtOption(CtUnknown), Some("Async")))
  } else {
    None
  }
}
let lookup_bytestream: (String) -> Option[Type] = (name) -> {
  if name == "String::to_bytes" {
    Some(CtFn([
      CtString
    ], CtNamed("Stream", [
      CtInt
    ]), None))
  } else if name == "Stream::to_string" {
    Some(CtFn([
      CtNamed("Stream", [
        CtInt
      ])
    ], CtString, None))
  } else {
    None
  }
}
export let lookup_async: (String) -> Option[Type] = (name) -> {
  match lookup_future(name) {
    Some(t) => Some(t),
    None => match lookup_stream(name) {
      Some(t) => Some(t),
      None => match lookup_concurrency(name) {
        Some(t) => Some(t),
        None => lookup_bytestream(name)
      }
    }
  }
}
