      emit_i64_eqz(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_load(buf, 2, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, cap_local)
      emit_local_get(buf, cap_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 2147483647)
      emit_i32_gt_u(buf)
      emit_if_i64(buf)
      emit_local_get(buf, obj_local)
      emit_local_get(buf, idx_local)
      emit_call(buf, bg_idx)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_local_get(buf, idx_local)
      emit_call(buf, ag_idx)
      emit_end(buf)
      emit_else(buf)
      emit_local_get(buf, obj_local)
      emit_local_get(buf, idx_local)
      emit_call(buf, sg_idx)
      emit_end(buf)
      nl
    }
    else if fname == "__set_field" {
      let field = get_estring_value(Array::get(args, 1))
      let fc = String::char_code_at(field, 0)
      let is_numeric = fc >= 48 && fc <= 57
      let field_idx = if is_numeric {
        let mut vi = 0
        let mut vp = 0
        while vp < String::length(field) {
          vi = vi * 10 + (String::char_code_at(field, vp) - 48)
          vp = vp + 1
        }
        vi
      } else {
        let mut si_search = 0
        let mut found = -1
        while si_search < Array::length(ctx.ctor_table.struct_names) {
          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)
          let mut fi = 0
          while fi < Array::length(fnames) {
            if Array::get(fnames, fi) == field {
              found = fi
              fi = Array::length(fnames)
            } else {
              fi = fi + 1
            }
          }
          if found >= 0 {
            si_search = Array::length(ctx.ctor_table.struct_names)
          } else {
            si_search = si_search + 1
          }
        }
        if found < 0 {
          throw(String::concat("unknown struct field: ", field))
        }
        found
      }
      let mut nl = next_local
      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)
      let store_off = if is_numeric {
        field_idx * 8
      } else {
        8 + field_idx * 8
      }
      emit_i64_store(buf, 3, store_off)
      emit_i64_const(buf, 0)
      nl
    }
    else {
      if fn_idx_in_list >= 0 {
        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)
        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)
        let needs_env = Array::get(ctx.func_table.needs_env, fn_idx_in_list)
        let mut nl = next_local
        let mut ci = 0
        while ci < Array::length(args) {
          nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)
          ci = ci + 1
        }
        if needs_env {
          emit_i64_const(buf, 0)
        }
        emit_call(buf, fidx)
        if has_ret == 0 {
          emit_i64_const(buf, 0)
        }
        nl
      } else {
        let local_idx2 = if local_idx_hint >= 0 {
          local_idx_hint
        } else {
          resolve_local(local_names, fname, "call")
        }
        let num_args = Array::length(args)
        let fn_val_local = next_local
        let slot_local = next_local + 1
        let env_local = next_local + 2
        let mut nl = next_local + 3
        Array::push(local_names, "__fn_val")
        Array::push(local_names, "__slot")
        Array::push(local_names, "__env")
        emit_local_get(buf, local_idx2)
        emit_local_set(buf, fn_val_local)
        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
        let mut ci = 0
        while ci < num_args {
          nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)
          ci = ci + 1
        }
        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
        nl
      }
    }
  } else {
    let num_args = Array::length(args)
    let fn_val_local = next_local
    let slot_local = next_local + 1
    let env_local = next_local + 2
    let mut nl = next_local + 3
    Array::push(local_names, "__fn_val")
    Array::push(local_names, "__slot")
    Array::push(local_names, "__env")
    nl = ce(buf, callee, local_names, nl, ctx, ld)
    emit_local_set(buf, fn_val_local)
    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
    let mut ci = 0
    while ci < num_args {
      nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)
      ci = ci + 1
    }
    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)
    nl
  }
}










let t6_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_end(buf)
}

export let compile_expr_tail6: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, body, arms, local_names, next_local, ctx, ld, compile_expr) -> {
  if Array::length(arms) > 0 {
    let (catch_pat, fallback_expr) = Array::get(arms, 0)
    let is_error = is_pctor(catch_pat) && get_pctor_name(catch_pat) == "Error::Throw"
    let catch_tag = if is_error {
      2
    } else if is_pctor(catch_pat) {
      effect_name_to_tag(ctx.effect_names, get_pctor_name(catch_pat))
    } else {
      3 + Array::length(ctx.effect_names)
    }
    let uses_frontier = !is_error
    let eff_off = (catch_tag - 3) * 131072
    let g_rbuf = if ctx.enable_rc {
      5
    } else {
      4
    }
    let g_cur = if ctx.enable_rc {
      3
    } else {
      2
    }
    if uses_frontier {
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_const(buf, 0)
      emit_i64_store(buf, 3, 8)
    } else {
      ()
    }
    emit_block_i64(buf)
    emit_loop_void(buf)
    if uses_frontier {
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_const(buf, 0)
      emit_i64_store(buf, 3, 0)
    } else {
      ()
    }
    emit_block_i64(buf)
    bytebuf_push(buf, 31)
    bytebuf_push(buf, 126)
    bytebuf_push(buf, 1)
    bytebuf_push(buf, 0)
    bytebuf_push(buf, catch_tag)
    bytebuf_push(buf, 0)
    let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)
    emit_end(buf)
    emit_br(buf, 2)
    emit_end(buf)
    if is_pctor(catch_pat) {
      let cargs = get_pctor_args(catch_pat)
      let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))
      if decl_arity > 1 {
        let ptr_l = Array::length(local_names)
        emit_local_set(buf, ptr_l)
        Array::push(local_names, "__eff_payload")
        let ncargs = Array::length(cargs)
        let mut ci = 0
        while ci < decl_arity {
          if ci < ncargs {
            let cp = Array::get(cargs, ci)
            if is_pbind(cp) {
              let pname = get_pbind_name(cp)
              let fl = Array::length(local_names)
              emit_local_get(buf, ptr_l)
              if ctx.enable_rc {
                emit_i64_const(buf, -2)
                emit_i64_and(buf)
              } else {
                ()
              }
              emit_i32_wrap_i64(buf)
              emit_i64_load(buf, 3, if ctx.enable_rc {
                8 + ci * 8
              } else {
                ci * 8
              })
              emit_local_set(buf, fl)
              Array::push(local_names, pname)
              if ctx.enable_rc {
                t6_emit_rc_dup_guarded(buf, fl)
              } else {
                ()
              }
            } else if is_pwild(cp) {
              ()
            } else {
              throw("handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)")
            }
          } else {
            ()
          }
          ci = ci + 1
        }
        if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {
          emit_local_get(buf, ptr_l)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
      } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {
        let pname = get_pbind_name(Array::get(cargs, 0))
        let bl = Array::length(local_names)
        emit_local_set(buf, bl)
        Array::push(local_names, pname)
      } else {
        emit_drop(buf)
      }
    } else if is_pbind(catch_pat) {
      let pname = get_pbind_name(catch_pat)
      let bl = Array::length(local_names)
      emit_local_set(buf, bl)
      Array::push(local_names, pname)
    } else {
      emit_drop(buf)
    }
    if uses_frontier {
      emit_global_get(buf, g_rbuf)
      emit_i32_const(buf, eff_off)
      emit_i32_add(buf)
      emit_i64_extend_i32_u(buf)
      emit_global_set(buf, g_cur)
    } else {
      ()
    }
    emit_block_i64(buf)
    bytebuf_push(buf, 31)
    bytebuf_push(buf, 126)
    bytebuf_push(buf, 1)
    bytebuf_push(buf, 0)
    bytebuf_push(buf, 1)
    bytebuf_push(buf, 0)
    let nl2 = compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)
    emit_end(buf)
    emit_br(buf, 2)
    emit_end(buf)
    emit_drop(buf)
    emit_br(buf, 0)
    emit_end(buf)
    bytebuf_push(buf, 0)
    emit_end(buf)
    nl2
  } else {
    compile_expr(buf, body, local_names, next_local, ctx, ld)
  }
}










export let compile_expr_tail7: (Bytes, Array[String], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, parts, local_names, next_local, ctx, ld, compile_expr) -> {
  let make_concat_expr: (Expr, Expr) -> Expr = (lhs, rhs) -> {
    let args = ArrayBuilder::freeze(ArrayBuilder::new())
    Array::push(args, lhs)
    Array::push(args, rhs)
    ECall(EIdent("String::concat"), args)
  }
  let make_to_string_expr: (String) -> Expr = (name) -> {
    let args = ArrayBuilder::freeze(ArrayBuilder::new())
    Array::push(args, EIdent(name))
    ECall(EIdent("__to_string"), args)
  }
  let plen = Array::length(parts)
  let mut result = EString("")
  let mut has_val = false
  let mut si2 = 0
  while si2 < plen {
    let part = Array::get(parts, si2)
    if si2 % 2 == 0 {
      if String::length(part) > 0 {
        if has_val {
          result = make_concat_expr(result, EString(part))
        } else {
          result = EString(part)
          has_val = true
        }
      }
    } else {
      let ep = make_to_string_expr(part)
      if has_val {
        result = make_concat_expr(result, ep)
      } else {
        result = ep
        has_val = true
      }
    }
    si2 = si2 + 1
  }
  compile_expr(buf, result, local_names, next_local, ctx, ld)
}












export let compile_expr_tail5: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  match expr {
    EForIn(_, _, _, _) => throw("unsupported expression in codegen: EForIn"),
    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)
    ,
    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)
    ,
    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)
    ,
    _ => throw("unsupported expression in codegen: unknown")
  }
}











export let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  match expr {
    EDot(obj, field) => {
      let fc = String::char_code_at(field, 0)
      let mut field_idx = if fc >= 48 && fc <= 57 {
        let mut vi = 0
        let mut vp = 0
        while vp < String::length(field) {
          vi = vi * 10 + (String::char_code_at(field, vp) - 48)
          vp = vp + 1
        }
        vi
      } else {
        let mut si_search = 0
        let mut found = -1
        while si_search < Array::length(ctx.ctor_table.struct_names) {
          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)
          let mut fi = 0
          while fi < Array::length(fnames) {
            if Array::get(fnames, fi) == field {
              found = fi
              fi = Array::length(fnames)
            } else {
              fi = fi + 1
            }
          }
          if found >= 0 {
            si_search = Array::length(ctx.ctor_table.struct_names)
          } else {
            si_search = si_search + 1
          }
        }
        if found < 0 {
          throw(String::concat("unknown struct field: ", field))
        }
        found
      }
      let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)
      if fc >= 48 && fc <= 57 {
        if ctx.enable_rc {
          emit_i64_const(buf, -2)
          emit_i64_and(buf)
        }
        emit_i32_wrap_i64(buf)
        let toff = if ctx.enable_rc {
          8 + field_idx * 8
        } else {
          field_idx * 8
        }
        emit_i64_load(buf, 3, toff)
      } else {
        emit_i64_const(buf, -2)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 8 + field_idx * 8)
      }
      nl1
    },
    ERecord(fields) => {
      let flen = Array::length(fields)
      let ptr_local = next_local
      Array::push(local_names, "__rec_ptr")
      if ctx.enable_rc {
        let total = 16 + flen * 8
        emit_i64_const(buf, total)
        emit_call(buf, ctx.rc_alloc_func_idx)
        emit_local_set(buf, ptr_local)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, total)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store(buf, 2, 4)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 1)
        emit_i32_store8(buf, 0, 7)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 0)
        emit_i32_store(buf, 2, 8)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, flen)
        emit_i32_store(buf, 2, 12)
        let mut nl_r = next_local + 1
        let mut ri = 0
        while ri < flen {
          let (_, fexpr) = Array::get(fields, ri)
          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)
          let val_local = nl_r
          Array::push(local_names, "__rec_val")
          emit_local_set(buf, val_local)
          nl_r = nl_r + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 16 + ri * 8)
          ri = ri + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 8)
        emit_i64_add(buf)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_r
      } else {
        let obj_size = 8 + flen * 8
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_set(buf, ptr_local)
        emit_global_get(buf, 0)
        emit_i32_const(buf, obj_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_heap_grow_after_heap_set(buf, ctx)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, 0)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, flen)
        emit_i32_store(buf, 2, 4)
        let mut nl_r = next_local + 1
        let mut ri = 0
        while ri < flen {
          let (_, fexpr) = Array::get(fields, ri)
          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)
          let val_local = nl_r
          Array::push(local_names, "__rec_val")
          emit_local_set(buf, val_local)
          nl_r = nl_r + 1
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, val_local)
          emit_i64_store(buf, 3, 8 + ri * 8)
          ri = ri + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl_r
      }
    },
    EMap(fields) => {
      let flen = Array::length(fields)
      let obj_size = 8 + flen * 2 * 8
      let ptr_local = next_local
      Array::push(local_names, "__map_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 0)
      let mut nl_m = next_local + 1
      let mut mi = 0
      while mi < flen {
        let (key, val_expr) = Array::get(fields, mi)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        let key_idx = str_table_lookup(ctx.str_table.strs, key)
        if key_idx >= 0 {
          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))
        } else {
          emit_i64_const(buf, 0)
        }
        emit_i64_store(buf, 3, 8 + mi * 16)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)
        let val_local = nl_m
        Array::push(local_names, "__map_val")
        emit_local_set(buf, val_local)
        nl_m = nl_m + 1
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + mi * 16 + 8)
        mi = mi + 1
      }
      emit_local_get(buf, ptr_local)
      nl_m
    },
    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}











export let compile_expr_tail3: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  let __tag = expr_tag(expr)
  if __tag == 19 {
    let cond = get_ewhile_cond(expr)
    let body = get_ewhile_body(expr)
    emit_block_void(buf)
    emit_loop_void(buf)
    let w_cond_tag = expr_tag(cond)
    let nl1 = if w_cond_tag == 5 {
      let wcop = get_ebinop_op(cond)
      if wcop == "==" || wcop == "!=" || wcop == "<" || wcop == ">" || wcop == "<=" || wcop == ">=" {
        let wlhs = get_ebinop_lhs(cond)
        let wrhs = get_ebinop_rhs(cond)
        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, ld + 1)
        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, ld + 1)
        if wcop == "==" {
          let (eq_fi3, _, _) = resolve_func(ctx.func_table, "eq")
          emit_call(buf, eq_fi3)
          emit_i32_wrap_i64(buf)
          emit_i32_eqz(buf)
        } else if wcop == "!=" {
          let (eq_fi3, _, _) = resolve_func(ctx.func_table, "eq")
          emit_call(buf, eq_fi3)
          emit_i32_wrap_i64(buf)
        }
        else if wcop == "<" {
          emit_i64_lt_s(buf); emit_i32_eqz(buf)
        }
        else if wcop == ">" {
          emit_i64_gt_s(buf); emit_i32_eqz(buf)
        }
        else if wcop == "<=" {
          emit_i64_le_s(buf); emit_i32_eqz(buf)
        }
        else {
          emit_i64_ge_s(buf); emit_i32_eqz(buf)
        }
        wnl2
      } else {
        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)
        emit_i64_eqz(buf)
        wnl
      }
    } else {
      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)
      emit_i64_eqz(buf)
      wnl
    }
    emit_br_if(buf, 1)
    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, ld + 1)
    emit_drop(buf)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_i64_const(buf, 0)
    nl2
  } else if __tag == 20 {
    emit_br(buf, ld + 1)
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 21 {
    emit_br(buf, ld)
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 22 {
    emit_i64_const(buf, 0)
    next_local
  } else if __tag == 23 {
    let msg_expr = get_ethrow_expr(expr)
    let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)
    bytebuf_push(buf, 8)
    bytebuf_push(buf, 2)
    nl
  } else if __tag == 24 {
    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)
  } else if __tag == 26 {
    let ret_expr = get_ereturn_expr(expr)
    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)
    emit_return(buf)
    nl
  } else {
    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}











export let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  let __tag = expr_tag(expr)
  if __tag == 15 {
    let __tuple_elems = get_etuple_elems(expr)
    let num_elems = Array::length(__tuple_elems)
    let ptr_local = next_local
    Array::push(local_names, "__tuple_ptr")
    let mut nl = next_local + 1
    if ctx.enable_rc {
      let total = 16 + num_elems * 8
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store8(buf, 0, 7)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 3)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, num_elems)
      emit_i32_store(buf, 2, 12)
      let mut tri = 0
      while tri < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = compile_expr(buf, Array::get(__tuple_elems, tri), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, 16 + tri * 8)
        tri = tri + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl
    } else {
      let alloc_size = num_elems * 8
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    }
  } else if __tag == 16 {
    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  } else if __tag == 17 {
    let elems = get_earray_elems(expr)
    let n_elems = Array::length(elems)
    if ctx.enable_rc {
      let cap = if n_elems > 8 {
        n_elems
      } else {
        8
      }
      let total = 20 + cap * 8
      let ptr_local = next_local
      Array::push(local_names, "__arr_ptr")
      let mut nl = next_local + 1
      emit_i64_const(buf, total)
      emit_call(buf, ctx.rc_alloc_func_idx)
      emit_local_set(buf, ptr_local)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, total)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 1)
      emit_i32_store(buf, 2, 4)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 5)
      emit_i32_store8(buf, 0, 7)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, cap)
      emit_i32_store(buf, 2, 8)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, n_elems)
      emit_i32_store(buf, 2, 12)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 20)
      emit_i32_add(buf)
      emit_i32_store(buf, 2, 16)
      let mut ai = 0
      while ai < n_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = compile_expr(buf, Array::get(elems, ai), local_names, nl, ctx, ld)
        emit_i64_store(buf, 3, 20 + ai * 8)
        ai = ai + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 8)
      emit_i64_add(buf)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl
    } else {
      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, "Array::push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      Array::push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < Array::length(elems) {
        emit_local_get(buf, arr_local)
        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    }
  } else if __tag == 18 {
    let names_len_at_forin = Array::length(local_names)
    let var_name = get_eforin_name(expr)
    let iter_expr = get_eforin_iter(expr)
    let body = get_eforin_body(expr)
    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, "array_new")
    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, "Array::length")
    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, "Array::get")
    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, "Array::push")
    let result_local = next_local
    let arr_local = next_local + 1
    let i_local = next_local + 2
    Array::push(local_names, "__forin_res")
    Array::push(local_names, "__forin_arr")
    Array::push(local_names, "__forin_i")
    emit_call(buf, arr_new_fi)
    emit_local_set(buf, result_local)
    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)
    emit_local_set(buf, arr_local)
    emit_i64_const(buf, 0)
    emit_local_set(buf, i_local)
    emit_block_void(buf)
    emit_loop_void(buf)
    emit_local_get(buf, i_local)
    emit_local_get(buf, arr_local)
    emit_call(buf, arr_len_fi)
    emit_i64_ge_s(buf)
    emit_br_if(buf, 1)
    let index_name = get_eforin_index(expr)
    let var_local = match index_name {
      Some(idx_name) => {
        emit_local_get(buf, i_local)
        if ctx.enable_rc {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        }
        emit_local_set(buf, nl1)
        Array::push(local_names, idx_name)
        nl1 + 1
      },
      None => nl1
    }
    emit_local_get(buf, arr_local)
    emit_local_get(buf, i_local)
    emit_call(buf, arr_get_fi)
    emit_local_set(buf, var_local)
    Array::push(local_names, var_name)
    let nl2 = var_local + 1
    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, ld + 1)
    let body_val = nl3
    Array::push(local_names, "__forin_val")
    emit_local_set(buf, body_val)
    emit_local_get(buf, result_local)
    emit_local_get(buf, body_val)
    emit_call(buf, arr_push_fi)
    emit_local_get(buf, i_local)
    emit_i64_const(buf, 1)
    emit_i64_add(buf)
    emit_local_set(buf, i_local)
    emit_br(buf, 0)
    emit_end(buf)
    emit_end(buf)
    emit_local_get(buf, result_local)
    let final_nl = nl3 + 1
    Array::truncate(local_names, names_len_at_forin)
    while Array::length(local_names) < final_nl {
      Array::push(local_names, "")
    }
    final_nl
  } else {
    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}











let is_edot: (Expr) -> Bool = (e) -> {
  match e {
    EDot(_, _) => true,
    _ => false
  }
}

let efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {
  let params = get_efn_params(value)
  let pnames = Array::slice([
    ""
  ], 0, 0)
  let mut pi = 0
  while pi < Array::length(params) {
    let (pn, _) = Array::get(params, pi)
    Array::push(pnames, pn)
    pi = pi + 1
  }
  let caps = collect_free_vars(get_efn_body(value), pnames, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
  Array::length(caps) > 0
}

let slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {
  let arr = ctx.float_local_slots
  let mut j = Array::length(arr) - 1
  let mut result = false
  while j >= 0 {
    let entry = Array::get(arr, j)
    if entry / 2 == slot {
      result = (entry % 2) == 1
      j = -1
    } else {
      j = j - 1
    }
  }
  result
}

export let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {
  let tag = expr_tag(e)
  if tag == 2 {
    true
  } else if tag == 4 {
    let nm = get_eident_name(e)
    let len = Array::length(local_names)
    let mut i = len - 1
    let mut slot = -1
    while i >= 0 {
      if Array::get(local_names, i) == nm {
        slot = i
        i = -1
      } else {
        i = i - 1
      }
    }
    if slot >= 0 {
      slot_is_floatish(ctx, slot)
    } else {
      false
    }
  } else if tag == 5 {
    let op = get_ebinop_op(e)
    if op == "+" || op == "-" || op == "*" || op == "/" || op == "<" || op == ">" || op == "<=" || op == ">=" {
      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 6 {
    let op = get_eunaryop_op(e)
    if op == "-" {
      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)
    } else {
      false
    }
  } else if tag == 8 {
    let callee = get_ecall_callee(e)
    if is_eident(callee) {
      let fname = get_eident_name(callee)
      fname == "Int::to_double" || fname == "Int::to_float" || fname == "Float::to_double" || fname == "Double::to_float" || fname == "Double::from_i64_bits"
    } else {
      false
    }
  } else {
    false
  }
}

let emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_end(buf)
}

let assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {
  let empty1 = Array::slice([
    ""
  ], 0, 0)
  let empty2 = Array::slice([
    ""
  ], 0, 0)
  array_contains_str(collect_free_vars(value, empty1, empty2), name)
}

let rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {
  if !assign_value_mentions(e, name) {
    true
  } else {
    match e {
      EIdent(_) => true,
      EDot(_, _) => proj_root_ident(e) == name,
      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),
      EUnaryOp(_, x) => reassign_carry_safe(x, name),
      _ => false
    }
  }
}

let emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_local_get(buf, local_idx)
  if tagged {
    emit_i64_const(buf, -2)
    emit_i64_and(buf)
  } else {
    ()
  }
  emit_i32_wrap_i64(buf)
}

let emit_rc_dup_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
}

let emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_sub(buf)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 256)
  emit_i32_mul(buf)
  emit_i32_eqz(buf)
  emit_if_void(buf)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_global_get(buf, 2)
  emit_i32_store(buf, 2, 0)
  emit_rc_value_ptr_i32(buf, local_idx, tagged)
  emit_global_set(buf, 2)
  emit_end(buf)
}

let reassign_self_reusable: (Expr, String) -> Bool with { Error } = (value, name) -> {
  if is_etuple(value) {
    let elems = get_etuple_elems(value)
    let mut i = 0
    let mut ok = true
    while i < Array::length(elems) {
      if !reassign_carry_safe(Array::get(elems, i), name) {
        ok = false
      } else {
        ()
      }
      i = i + 1
    }
    ok
  } else {
    false
  }
}

export let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {
  let __tag = expr_tag(expr)
  if __tag == 9 {
    let name = get_elet_name(expr)
    let value = get_elet_val(expr)
    let body = get_elet_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    let val_is_float = expr_is_floatish(value, local_names, ctx)
    if val_is_float {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    let mut rc_kind = 0
    if ctx.enable_rc {
      if val_is_float {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_etuple(value) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_earray(value) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_erecord(value) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_ctor_call(value, ctx.ctor_table) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_nullary_ctor_ident(value, ctx.ctor_table) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else if is_eident(value) {
        let src = get_eident_name(value)
        if array_contains_str(ctx.heap_binding_names, src) {
          rc_kind = 2
          Array::push(ctx.heap_binding_names, name)
          if array_contains_str(ctx.rc_alias_dup_names, name) {
            emit_rc_dup_local(buf, local_idx, true)
          } else {
            ()
          }
        } else {
          ()
        }
      } else if expr_tag(value) == 8 {
        let callee = get_ecall_callee(value)
        let is_borrow_ret = if is_eident(callee) {
          let cn = get_eident_name(callee)
          cn == "Array::get" || cn == "__index" || cn == "Map::get"
        } else {
          false
        }
        if is_borrow_ret {
          ()
        } else {
          rc_kind = 2
          Array::push(ctx.heap_binding_names, name)
        }
      } else if is_edot(value) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
        emit_rc_dup_guarded(buf, local_idx)
      } else if is_efn(value) && efn_is_capturing(value, ctx) {
        rc_kind = 2
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
    } else {
      ()
    }
    if ctx.enable_rc && rc_kind > 0 {
      let mut dbi = 0
      while dbi < Array::length(ctx.rc_dup_names) {
        if Array::get(ctx.rc_dup_names, dbi) == name {
          emit_rc_dup_guarded(buf, local_idx)
        } else {
          ()
        }
        dbi = dbi + 1
      }
    } else {
      ()
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {
      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {
        emit_local_set(buf, nl2)
        emit_rc_dup_guarded(buf, nl2)
        emit_local_get(buf, local_idx)
        emit_call(buf, ctx.rc_drop_func_idx)
        emit_local_get(buf, nl2)
        nl2 + 1
      } else {
        if ctx.rc_drop_func_idx >= 0 {
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else if rc_kind == 1 {
          emit_rc_drop_local(buf, local_idx, false)
        } else {
          emit_rc_drop_local(buf, local_idx, true)
        }
        nl2
      }
    } else {
      nl2
    }
  } else if __tag == 10 {
    let name = get_eletrec_name(expr)
    let value = get_eletrec_val(expr)
    let body = get_eletrec_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
    emit_local_set(buf, local_idx)
    if is_efn(value) {
      let params = get_efn_params(value)
      let fn_body = get_efn_body(value)
      let param_names_bp = Array::slice([
        ""
      ], 0, 0)
      let mut bpi = 0
      while bpi < Array::length(params) {
        let (pn, _) = Array::get(params, bpi)
        Array::push(param_names_bp, pn)
        bpi = bpi + 1
      }
      let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))
      let mut self_cap_idx = -1
      let mut bci = 0
      while bci < Array::length(caps) {
        if Array::get(caps, bci) == name {
          self_cap_idx = bci
        }
        bci = bci + 1
      }
      if self_cap_idx >= 0 {
        emit_local_get(buf, local_idx)
        emit_i64_const(buf, -4)
        emit_i64_and(buf)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, local_idx)
        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
      }
      0
    } else {
      0
    }
    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
    nl2
  } else if __tag == 11 {
    let name = get_eletmut_name(expr)
    let value = get_eletmut_val(expr)
    let body = get_eletmut_body(expr)
    let local_idx = next_local
    Array::push(local_names, name)
    if expr_is_floatish(value, local_names, ctx) {
      Array::push(ctx.float_local_slots, local_idx * 2 + 1)
    } else if slot_is_floatish(ctx, local_idx) {
      Array::push(ctx.float_local_slots, local_idx * 2)
    }
    if is_mut_captured_in(body, name) {
      Array::push(ctx.ref_cell_names, name)
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, local_idx)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 8)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_heap_grow_after_heap_set(buf, ctx)
      emit_local_get(buf, local_idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
      emit_i64_store(buf, 3, 0)
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      nl2
    } else {
      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table) || is_nullary_ctor_ident(value, ctx.ctor_table) || expr_is_floatish(value, local_names, ctx)) {
        Array::push(ctx.heap_binding_names, name)
      } else {
        ()
      }
      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)
      emit_local_set(buf, local_idx)
      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)
      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {
        if scope_tail_proj_root(body) == name {
          emit_local_set(buf, nl2)
          emit_rc_dup_guarded(buf, nl2)
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          emit_local_get(buf, nl2)
          nl2 + 1
        } else {
          emit_local_get(buf, local_idx)
          emit_call(buf, ctx.rc_drop_func_idx)
          nl2
        }
      } else {
        nl2
      }
    }
  } else if __tag == 12 {
    let name = get_eassign_name(expr)
    let value = get_eassign_val(expr)
    let body = get_eassign_body(expr)
    let idx = resolve_local(local_names, name, "assign")
    if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)
      let is_self = assign_value_mentions(value, name)
      if is_heap_mut && is_self && reassign_self_reusable(value, name) {
        let old_temp = next_local
        let scratch = next_local + 1
        let base = next_local + 2
        emit_local_get(buf, idx)
        emit_local_set(buf, old_temp)
        let elems = get_etuple_elems(value)
        let mut ei = 0
        while ei < Array::length(elems) {
          let elem = Array::get(elems, ei)
          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {
            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)
            emit_local_set(buf, scratch)
            emit_rc_dup_guarded(buf, scratch)
          } else {
            ()
          }
          ei = ei + 1
        }
        let nl = compile_expr(buf, value, local_names, base, ctx, ld)
        emit_local_set(buf, idx)
        emit_local_get(buf, old_temp)
        emit_call(buf, ctx.rc_drop_func_idx)
        compile_expr(buf, body, local_names, nl, ctx, ld)
      } else {
        if is_heap_mut && !is_self {
          emit_local_get(buf, idx)
          emit_call(buf, ctx.rc_drop_func_idx)
        } else {
          ()
        }
        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
        emit_local_set(buf, idx)
        if is_heap_mut && !is_self && is_edot(value) {
          emit_rc_dup_guarded(buf, idx)
        } else {
          ()
        }
        compile_expr(buf, body, local_names, nl, ctx, ld)
      }
    }
  } else if __tag == 13 {
    let name = get_eassignop_name(expr)
    let op = get_eassignop_op(expr)
    let value = get_eassignop_val(expr)
    let body = get_eassignop_body(expr)
    let idx = resolve_local(local_names, name, "assignop")
    if array_contains_str(ctx.ref_cell_names, name) {
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_local_get(buf, idx)
      emit_i32_wrap_i64(buf)
      emit_i64_load(buf, 3, 0)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_assignop_op(buf, op)
      emit_i64_store(buf, 3, 0)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    } else {
      emit_local_get(buf, idx)
      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)
      emit_assignop_op(buf, op)
      emit_local_set(buf, idx)
      compile_expr(buf, body, local_names, nl, ctx, ld)
    }
  } else if __tag == 14 {
    let first = get_eseq_first(expr)
    let second = get_eseq_second(expr)
    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)
    emit_drop(buf)
    compile_expr(buf, second, local_names, nl, ctx, ld)
  } else {
    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}











export let rec compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {
  let __tag = expr_tag(expr)
  if __tag == 0 {
    let n = get_eint_value(expr)
    emit_i64_const(buf, n)
    if ctx.enable_rc {
      emit_i64_const(buf, 1)
      emit_i64_shl(buf)
    }
    next_local
  } else if __tag == 1 {
    let b_val = get_ebool_value(expr)
    emit_i64_const(buf, if b_val {
      if ctx.enable_rc {
        2
      } else {
        1
      }
    } else {
      0
    })
    next_local
  } else if __tag == 2 {
    let v = get_efloat_value(expr)
    let lo = Double::to_i64_bits_lo(v)
    let hi = Double::to_i64_bits_hi(v)
    emit_f64_const_lohi(buf, lo, hi)
    emit_i64_reinterpret_f64(buf)
    if ctx.enable_rc {
      Array::push(local_names, "__fbits")
      Array::push(local_names, "__fbox")
      emit_box_float(buf, ctx, next_local, next_local + 1)
      next_local + 2
    } else {
      next_local
    }
  } else if __tag == 3 {
    let s = get_estring_value(expr)
    let idx = str_table_lookup(ctx.str_table.strs, s)
    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))
    next_local
  } else if __tag == 4 {
    let name = get_eident_name(expr)
    let len = Array::length(local_names)
    let mut __tl_i = len - 1
    let mut __tl_result = -1
    while __tl_i >= 0 {
      if Array::get(local_names, __tl_i) == name {
        __tl_result = __tl_i
        __tl_i = -1
      } else {
        __tl_i = __tl_i - 1
      }
    }
    let local_idx = __tl_result
    if local_idx >= 0 {
      if array_contains_str(ctx.ref_cell_names, name) {
        emit_local_get(buf, local_idx)
        emit_i32_wrap_i64(buf)
        emit_i64_load(buf, 3, 0)
      } else {
        emit_local_get(buf, local_idx)
      }
      next_local
    } else {
      let mut __ci_idx = -1
      let __ci_len = Array::length(ctx.const_int_names)
      let mut __ci_j = 0
      while __ci_j < __ci_len {
        if Array::get(ctx.const_int_names, __ci_j) == name {
          __ci_idx = __ci_j
          __ci_j = __ci_len
        } else {
          __ci_j = __ci_j + 1
        }
      }
      if __ci_idx >= 0 {
        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))
        if ctx.enable_rc {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        }
        next_local
      } else {
        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)
        if ctor_idx >= 0 {
          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          Array::push(local_names, "__ctor_ptr")
          if ctx.enable_rc {
            emit_i64_const(buf, 16)
            emit_call(buf, ctx.rc_alloc_func_idx)
            emit_local_set(buf, ptr_l)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 16)
            emit_i32_store(buf, 2, 0)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 1)
            emit_i32_store(buf, 2, 4)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 1)
            emit_i32_store8(buf, 0, 7)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, tag_c)
            emit_i32_store(buf, 2, 8)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 0)
            emit_i32_store(buf, 2, 12)
            emit_local_get(buf, ptr_l)
            emit_i64_const(buf, 8)
            emit_i64_add(buf)
            emit_i64_const(buf, 1)
            emit_i64_or(buf)
            next_local + 1
          } else {
            emit_global_get(buf, 0)
            emit_i64_extend_i32_u(buf)
            emit_local_set(buf, ptr_l)
            emit_global_get(buf, 0)
            emit_i32_const(buf, 8)
            emit_i32_add(buf)
            emit_global_set(buf, 0)
            emit_heap_grow_after_heap_set(buf, ctx)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, tag_c)
            emit_i32_store(buf, 2, 0)
            emit_local_get(buf, ptr_l)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, 0)
            emit_i32_store(buf, 2, 4)
            emit_local_get(buf, ptr_l)
            emit_i64_const(buf, 1)
            emit_i64_or(buf)
            next_local + 1
          }
        } else {
          let fn_len = Array::length(ctx.func_table.names)
          let mut __tf_j = 0
          let mut __tf_result = -1
          while __tf_j < fn_len {
            if Array::get(ctx.func_table.names, __tf_j) == name {
              __tf_result = __tf_j
              __tf_j = fn_len
            } else {
              __tf_j = __tf_j + 1
            }
          }
          if __tf_result < 0 {
            let mut diag = String::concat("undefined variable (ident): ", name)
            diag = String::concat(diag, " | locals=[")
            let mut di = 0
            while di < len {
              if di > 0 {
                diag = String::concat(diag, ",")
              }
              diag = String::concat(diag, Array::get(local_names, di))
              di = di + 1
            }
            diag = String::concat(diag, "]")
            throw(diag)
          }
          let fni = __tf_result
          let fidx = Array::get(ctx.func_table.indices, fni)
          if array_contains_str(ctx.thunk_names, name) {
            emit_i64_const(buf, 0)
            emit_call(buf, fidx)
            next_local
          } else {
            let table_slot = fidx - ctx.func_offset
            emit_i64_const(buf, (table_slot<<2)|2)
            next_local
          }
        }
      }
    }
  } else if __tag == 5 {
    let op = get_ebinop_op(expr)
    let lhs = get_ebinop_lhs(expr)
    let rhs = get_ebinop_rhs(expr)
    if op == "==" {
      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
      let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
      emit_call(buf, eq_fidx)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nl2
    } else if op == "!=" {
      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
      let (eq_fidx, _, _) = resolve_func(ctx.func_table, "eq")
      emit_call(buf, eq_fidx)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nl2
    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {
      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      }
      emit_f64_reinterpret_i64(buf)
      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
      if ctx.enable_rc {
        emit_unbox_float(buf)
      }
      emit_f64_reinterpret_i64(buf)
      if op == "+" || op == "-" || op == "*" || op == "/" {
        if op == "+" {
          emit_f64_add(buf)
        } else if op == "-" {
          emit_f64_sub(buf)
        } else if op == "*" {
          emit_f64_mul(buf)
        } else {
          emit_f64_div(buf)
        }
        emit_i64_reinterpret_f64(buf)
        if ctx.enable_rc {
          Array::push(local_names, "__fbits")
          Array::push(local_names, "__fbox")
          emit_box_float(buf, ctx, nl2, nl2 + 1)
          nl2 + 2
        } else {
          nl2
        }
      } else {
        if op == "<" {
          emit_f64_lt(buf)
        } else if op == ">" {
          emit_f64_gt(buf)
        } else if op == "<=" {
          emit_f64_le(buf)
        } else if op == ">=" {
          emit_f64_ge(buf)
        } else {
          throw(String::concat("unsupported float binop: ", op))
        }
        emit_i64_extend_i32_s(buf)
        if ctx.enable_rc {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        }
        nl2
      }
    } else if ctx.enable_rc {
      if op == "<<" {
        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        emit_i64_shl(buf)
        nl2
      } else if op == ">>" {
        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_i64_const(buf, 1)
        emit_i64_shr_s(buf)
        emit_i64_shr_s(buf)
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
        nl2
      } else {
        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
        emit_binop_op(buf, op)
        if op == "*" {
          emit_i64_const(buf, 1)
          emit_i64_shr_s(buf)
        } else if op == "/" {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        } else if op == "<" || op == ">" || op == "<=" || op == ">=" {
          emit_i64_const(buf, 1)
          emit_i64_shl(buf)
        } else {
          ()
        }
        nl2
      }
    } else {
      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)
      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)
      emit_binop_op(buf, op)
      nl2
    }
  } else if __tag == 6 {
    let op = get_eunaryop_op(expr)
    let operand = get_eunaryop_expr(expr)
    if op == "-" {
      if expr_is_floatish(operand, local_names, ctx) {
        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)
        emit_f64_reinterpret_i64(buf)
        emit_f64_neg(buf)
        emit_i64_reinterpret_f64(buf)
        nl
      } else {
        emit_i64_const(buf, 0)
        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)
        emit_i64_sub(buf)
        nl
      }
    } else if op == "!" {
      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)
      emit_i64_eqz(buf)
      emit_i64_extend_i32_s(buf)
      if ctx.enable_rc {
        emit_i64_const(buf, 1)
        emit_i64_shl(buf)
      }
      nl
    } else {
      throw(String::concat("unsupported unary op: ", op))
    }
  } else if __tag == 7 {
    let cond = get_eif_cond(expr)
    let then_e = get_eif_then(expr)
    let else_e = get_eif_else(expr)
    let cond_tag = expr_tag(cond)
    let nl1 = if cond_tag == 5 {
      let cop = get_ebinop_op(cond)
      if cop == "==" || cop == "!=" || cop == "<" || cop == ">" || cop == "<=" || cop == ">=" {
        let clhs = get_ebinop_lhs(cond)
        let crhs = get_ebinop_rhs(cond)
        if cop == "==" {
          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)
          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)
          let (eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
          emit_call(buf, eq_fi)
          emit_i32_wrap_i64(buf)
          cnl2
        } else if cop == "!=" {
          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)
          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)
          let (eq_fi, _, _) = resolve_func(ctx.func_table, "eq")
          emit_call(buf, eq_fi)
          emit_i32_wrap_i64(buf)
          emit_i32_eqz(buf)
          cnl2
        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {
          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)
          emit_f64_reinterpret_i64(buf)
          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)
          emit_f64_reinterpret_i64(buf)
          if cop == "<" {
            emit_f64_lt(buf)
          }
          else if cop == ">" {
            emit_f64_gt(buf)
          }
          else if cop == "<=" {
            emit_f64_le(buf)
          }
          else {
            emit_f64_ge(buf)
          }
          cnl2
        } else {
          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)
          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)
          if cop == "<" {
            emit_i64_lt_s(buf)
          }
          else if cop == ">" {
            emit_i64_gt_s(buf)
          }
          else if cop == "<=" {
            emit_i64_le_s(buf)
          }
          else {
            emit_i64_ge_s(buf)
          }
          cnl2
        }
      } else {
        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
        emit_i32_wrap_i64(buf)
        cnl
      }
    } else if cond_tag == 1 {
      let b_val = get_ebool_value(cond)
      emit_i32_const(buf, if b_val {
        1
      } else {
        0
      })
      next_local
    } else if cond_tag == 6 {
      let uop = get_eunaryop_op(cond)
      let uoperand = get_eunaryop_expr(cond)
      if uop == "!" {
        let inner_tag = expr_tag(uoperand)
        if inner_tag == 5 {
          let iop = get_ebinop_op(uoperand)
          if iop == "==" || iop == "!=" || iop == "<" || iop == ">" || iop == "<=" || iop == ">=" {
            let ilhs = get_ebinop_lhs(uoperand)
            let irhs = get_ebinop_rhs(uoperand)
            if iop == "==" {
              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)
              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)
              let (eq_fi2, _, _) = resolve_func(ctx.func_table, "eq")
              emit_call(buf, eq_fi2)
              emit_i32_wrap_i64(buf)
              emit_i32_eqz(buf)
              inl2
            } else if iop == "!=" {
              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)
              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)
              let (eq_fi2, _, _) = resolve_func(ctx.func_table, "eq")
              emit_call(buf, eq_fi2)
              emit_i32_wrap_i64(buf)
              emit_i32_eqz(buf)
              emit_i32_eqz(buf)
              inl2
            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {
              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)
              emit_f64_reinterpret_i64(buf)
              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)
              emit_f64_reinterpret_i64(buf)
              if iop == "<" {
                emit_f64_lt(buf)
              }
              else if iop == ">" {
                emit_f64_gt(buf)
              }
              else if iop == "<=" {
                emit_f64_le(buf)
              }
              else {
                emit_f64_ge(buf)
              }
              emit_i32_eqz(buf)
              inl2
            } else {
              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)
              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)
              if iop == "<" {
                emit_i64_lt_s(buf)
              }
              else if iop == ">" {
                emit_i64_gt_s(buf)
              }
              else if iop == "<=" {
                emit_i64_le_s(buf)
              }
              else {
                emit_i64_ge_s(buf)
              }
              emit_i32_eqz(buf)
              inl2
            }
          } else {
            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
            emit_i32_wrap_i64(buf)
            cnl
          }
        } else {
          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
          emit_i32_wrap_i64(buf)
          cnl
        }
      } else {
        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
        emit_i32_wrap_i64(buf)
        cnl
      }
    } else {
      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)
      emit_i32_wrap_i64(buf)
      cnl
    }
    emit_if_i64(buf)
    let ld_inner = if ld >= 0 {
      ld + 1
    } else {
      -1
    }
    let names_len_before = Array::length(local_names)
    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)
    emit_else(buf)
    Array::truncate(local_names, names_len_before)
    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)
    emit_end(buf)
    let max_nl_if = if nl2 > nl3 {
      nl2
    } else {
      nl3
    }
    while Array::length(local_names) < max_nl_if {
      Array::push(local_names, "")
    }
    max_nl_if
  } else if __tag == 8 {
    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)
  } else {
    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)
  }
}






export let compile_module_expr: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {
  let fresh_int_array: () -> Array[Int] = () -> {
    ArrayBuilder::freeze(ArrayBuilder::new())
  }
  let fresh_string_array: () -> Array[String] = () -> {
    ArrayBuilder::freeze(ArrayBuilder::new())
  }
  let fresh_expr_array: () -> Array[Expr] = () -> {
    ArrayBuilder::freeze(ArrayBuilder::new())
  }
  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {
    ArrayBuilder::freeze(ArrayBuilder::new())
  }
  let fresh_string_matrix: () -> Array[Array[String]] = () -> {
    ArrayBuilder::freeze(ArrayBuilder::new())
  }
  let fn_names_list = fresh_string_array()
  let fn_param_counts = fresh_int_array()
  let export_names = fresh_string_array()
  let export_indices = fresh_int_array()
  let fn_bodies_list = fresh_expr_array()
  let fn_param_names_list = fresh_string_matrix()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(is_export, _, name, _, expr) => match expr {
        EFn(_, _, params, _, _, body) => {
          let cur_idx = Array::length(fn_names_list)
          Array::push(fn_names_list, name)
          Array::push(fn_param_counts, Array::length(params))
          Array::push(fn_bodies_list, body)
          let pnames = fresh_string_array()
          let mut pi = 0
          while pi < Array::length(params) {
            let (pname, _) = Array::get(params, pi)
            Array::push(pnames, pname)
            pi = pi + 1
          }
          Array::push(fn_param_names_list, pnames)
          if is_export {
            Array::push(export_names, name)
            Array::push(export_indices, cur_idx)
          }
          0
        },
        _ => 0
      },
      _ => 0
    }
    i = i + 1
  }
  let num_funcs = Array::length(fn_names_list)
  if num_funcs == 0 {
    let out = bytebuf_new()
    let empty_type_defs = fresh_int_array()
    let empty_type_indices = fresh_int_array()
    let empty_body = bytebuf_new()
    let empty_bodies = fresh_bytes_matrix()
    Array::push(empty_bodies, empty_body)
    let empty_local_counts = fresh_int_array()
    Array::push(empty_local_counts, 0)
    emit_header(out)
    emit_type_section_multi(out, empty_type_defs)
    emit_function_section(out, empty_type_indices)
    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)
    bytebuf_to_bytes(out)
  } else {
    let fn_indices_list = fresh_int_array()
    let fn_returns_list = fresh_int_array()
    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())
    let mut fi = 0
    while fi < num_funcs {
      Array::push(fn_indices_list, fi)
      Array::push(fn_returns_list, 1)
      Array::push(fn_needs_env_list, false)
      fi = fi + 1
    }
    let type_defs = fresh_int_array()
    let mut ti = 0
    while ti < num_funcs {
      Array::push(type_defs, Array::get(fn_param_counts, ti))
      Array::push(type_defs, 1)
      ti = ti + 1
    }
    let type_indices = fresh_int_array()
    let mut tii = 0
    while tii < num_funcs {
      Array::push(type_indices, tii)
      tii = tii + 1
    }
    let lt_m = LambdaTable::{
      bodies: fresh_bytes_matrix(),
      param_counts: fresh_int_array(),
      captures: fresh_string_matrix(),
      meta_i32: fresh_int_array(),
      meta_i64: fresh_int_array()
    }
    let empty_str_table = StrTable::{
      strs: fresh_string_array(),
      offsets: fresh_int_array(),
      lengths: fresh_int_array()
    }
    let empty_ctor_table = CtorTable::{
      names: fresh_string_array(),
      tags: fresh_int_array(),
      field_counts: fresh_int_array(),
      type_names: fresh_string_array(),
      struct_names: fresh_string_array(),
      struct_field_names: fresh_string_matrix()
    }
    let empty_thunk_names = fresh_string_array()
    let empty_const_int_names = fresh_string_array()
    let empty_const_int_values = fresh_int_array()
    let empty_rc_drop_names = fresh_string_array()
    let empty_rc_alias_dup_names = fresh_string_array()
    let empty_rc_dup_names = fresh_string_array()
    let bodies = fresh_bytes_matrix()
    let local_counts = fresh_int_array()
    let mut bi = 0
    while bi < num_funcs {
      let body = Array::get(fn_bodies_list, bi)
      let param_names = Array::get(fn_param_names_list, bi)
      let body_buf = bytebuf_new()
      let local_names = fresh_string_array()
      let mut pi = 0
      while pi < Array::length(param_names) {
        Array::push(local_names, Array::get(param_names, pi))
        pi = pi + 1
      }
      let param_count = Array::length(param_names)
      let empty_ref_cells = fresh_string_array()
      let compile_ctx = CompileCtx::{
        func_table: FuncTable::{
          names: fn_names_list,
          indices: fn_indices_list,
          params: fn_param_counts,
          returns: fn_returns_list,
          needs_env: fn_needs_env_list
        },
        str_table: empty_str_table,
        lambda_table: lt_m,
        num_user_funcs: num_funcs, func_offset: 0,
        ref_cell_names: empty_ref_cells,
        ctor_table: empty_ctor_table,
        thunk_names: empty_thunk_names,
        const_int_names: empty_const_int_names,
        const_int_values: empty_const_int_values,
        enable_rc: false,
        rc_drop_names: empty_rc_drop_names,
        rc_alias_dup_names: empty_rc_alias_dup_names,
        heap_binding_names: fresh_string_array(),
        rc_drop_func_idx: -1,
        rc_alloc_func_idx: -1,
        heap_grow_check_func_idx: -1,
        rc_dup_names: empty_rc_dup_names,
        float_local_slots: fresh_int_array(),
        effect_names: fresh_string_array(),
        effect_op_keys: fresh_string_array(),
        effect_op_arities: fresh_int_array()
      }
      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)
      Array::push(bodies, body_buf)
      let extra = if final_nl > param_count {
        final_nl - param_count
      } else {
        0
      }
      Array::push(local_counts, extra)
      bi = bi + 1
    }
    let out = bytebuf_new()
    emit_header(out)
    emit_type_section_multi(out, type_defs)
    emit_function_section(out, type_indices)
    if Array::length(export_names) > 0 {
      emit_export_section_multi(out, export_names, export_indices)
    }
    emit_code_section_with_locals(out, bodies, local_counts)
    bytebuf_to_bytes(out)
  }
}




export {
  compile_expr, compile_module_expr
}






let expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {
  let free_vars = collect_free_vars(expr, Array::slice([
    ""
  ], 0, 0), fn_names)
  let normalized_target = canonical_builtin_name(target)
  let mut i = 0
  let mut found = false
  while i < Array::length(free_vars) && !found {
    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target
    i = i + 1
  }
  found
}

export let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(stmts) && !found {
    found = match Array::get(stmts, i) {
      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),
      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),
      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),
      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),
      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),
      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),
      _ => false
    }
    i = i + 1
  }
  found
}











let wasm_page_size = 65536

let lc_fresh_int_array: () -> Array[Int] = () -> {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let lc_fresh_bool_array: () -> Array[Bool] = () -> {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let lc_fresh_bytes_array: () -> Array[Bytes] = () -> {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let lc_fresh_string_array: () -> Array[String] = () -> {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let lc_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 1)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, 32)
  emit_i64_shr_s(buf)
  emit_i64_eqz(buf)
  emit_if_void(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_local_get(buf, local_idx)
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 4)
  emit_i32_sub(buf)
  emit_i32_load(buf, 2, 0)
  emit_i32_const(buf, 1)
  emit_i32_add(buf)
  emit_i32_store(buf, 2, 0)
  emit_end(buf)
  emit_end(buf)
}

let lc_fresh_string_matrix: () -> Array[Array[String]] = () -> {
  ArrayBuilder::freeze(ArrayBuilder::new())
}

let gen_heap_grow_check_body: () -> Bytes = () -> {
  let b = bytebuf_new()
  emit_heap_memory_grow_check(b)
  b
}

let default_wasi_memory_min_pages = 64

export let wasi_memory_min_pages_for_heap: (Int) -> Int = (heap_start) -> {
  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size
  if needed_pages > default_wasi_memory_min_pages {
    needed_pages
  } else {
    default_wasi_memory_min_pages
  }
}

export let compile_wasi_module_linked_impl: (Array[Stmt], String, Array[(String, String)], Array[(String, String, Int, Int)], Bool, Bool) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, linked_imports, library_mode, enable_rc) -> {
  let fn_names_list = lc_fresh_string_array()
  let fn_param_counts = lc_fresh_int_array()
  let fn_needs_env_list = lc_fresh_bool_array()
  let fn_stmt_indices = lc_fresh_int_array()
  let thunk_names_list = lc_fresh_string_array()
  let const_int_names_list = lc_fresh_string_array()
  let const_int_values_list = lc_fresh_int_array()
  let export_fn_names = lc_fresh_string_array()
  let export_fn_user_indices = lc_fresh_int_array()
  let test_fn_names = lc_fresh_string_array()
  let empty_tp = Array::slice([
    ""
  ], 0, 0)
  let empty_bounds = Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let empty_params = Array::slice([
    ("", None)
  ], 0, 0)
  let mut pi = 0
  while pi < Array::length(stmts) {
    match Array::get(stmts, pi) {
      STest(tname, tbody) => {
        let test_fn = String::concat("__test_", tname)
        Array::push(test_fn_names, test_fn)
        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))
      },
      SBench(bname, bbody) => {
        let bench_fn = String::concat("__bench_", bname)
        Array::push(test_fn_names, bench_fn)
        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))
      },
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {
          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))
        }
        ,
        _ => ()
      },
      _ => ()
    }
    pi = pi + 1
  }
  if Array::length(test_fn_names) > 0 {
    let mut has_entry = false
    let mut ei = 0
    while ei < Array::length(stmts) {
      match Array::get(stmts, ei) {
        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {
          has_entry = true
        },
        _ => ()
      }
      ei = ei + 1
    }
    if !has_entry {
      ()
    }
  }
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if is_slet(stmt) {
      let name = get_slet_name(stmt)
      let expr = get_slet_expr(stmt)
      let is_export = get_slet_export(stmt)
      let user_idx = Array::length(fn_names_list)
      if is_efn(expr) {
        let params = get_efn_params(expr)
        Array::push(fn_names_list, name)
        Array::push(fn_param_counts, Array::length(params))
        Array::push(fn_needs_env_list, true)
        Array::push(fn_stmt_indices, i)
      } else {
        if (expr_tag(expr) == 0) && !is_export {
          Array::push(const_int_names_list, name)
          Array::push(const_int_values_list, get_eint_value(expr))
        } else {
          Array::push(fn_names_list, name)
          Array::push(fn_param_counts, 0)
          Array::push(fn_needs_env_list, true)
          Array::push(fn_stmt_indices, i)
          Array::push(thunk_names_list, name)
        }
      }
      if is_export || library_mode {
        Array::push(export_fn_names, name)
        Array::push(export_fn_user_indices, user_idx)
      }
    }
    i = i + 1
  }
  let ctor_names_list = lc_fresh_string_array()
  Array::push(ctor_names_list, "None")
  Array::push(ctor_names_list, "Some")
  let ctor_tags_list = lc_fresh_int_array()
  Array::push(ctor_tags_list, 0)
  Array::push(ctor_tags_list, 1)
  let ctor_field_counts_list = lc_fresh_int_array()
  Array::push(ctor_field_counts_list, 0)
  Array::push(ctor_field_counts_list, 1)
  let ctor_type_names_list = lc_fresh_string_array()
  Array::push(ctor_type_names_list, "Option")
  Array::push(ctor_type_names_list, "Option")
  let mut type_index = 1
  let mut ei2 = 0
  while ei2 < Array::length(stmts) {
    match Array::get(stmts, ei2) {
      SEnum(_, ename, _, variants) => {
        type_index = type_index + 1
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vfields) = Array::get(variants, vi)
          Array::push(ctor_names_list, vname)
          Array::push(ctor_tags_list, (type_index<<16)|vi)
          Array::push(ctor_field_counts_list, Array::length(vfields))
          Array::push(ctor_type_names_list, ename)
          vi = vi + 1
        }
        0
      },
      SStruct(_, sname, sfields) => {
        type_index = type_index + 1
        Array::push(ctor_names_list, sname)
        Array::push(ctor_tags_list, type_index<<16)
        Array::push(ctor_field_counts_list, Array::length(sfields))
        Array::push(ctor_type_names_list, sname)
        0
      },
      _ => 0
    }
    ei2 = ei2 + 1
  }
  let struct_names = lc_fresh_string_array()
  let struct_field_names = lc_fresh_string_matrix()
  let mut si = 0
  while si < Array::length(stmts) {
    match Array::get(stmts, si) {
      SStruct(_, sname, sfields) => {
        Array::push(struct_names, sname)
        let fnames = lc_fresh_string_array()
        let mut sfi = 0
        while sfi < Array::length(sfields) {
          let (fname, _) = Array::get(sfields, sfi)
          Array::push(fnames, fname)
          sfi = sfi + 1
        }
        Array::push(struct_field_names, fnames)
        ()
      },
      _ => ()
    }
    si = si + 1
  }
  let num_user_funcs = Array::length(fn_names_list)
  if num_user_funcs == 0 {
    throw("no functions found to compile")
  }
  let mut entry_user_idx = -1
  let mut ei = 0
  while ei < num_user_funcs {
    if Array::get(fn_names_list, ei) == entry_name {
      entry_user_idx = ei
    }
    ei = ei + 1
  }
  let str_strs = collect_strings_stmts(stmts)
  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {
    match e {
      EMap(fields) => {
        let mut mi = 0
        while mi < Array::length(fields) {
          let (key, val) = Array::get(fields, mi)
          if !array_contains_str(str_strs, key) {
            Array::push(str_strs, key)
          }
          add_map_keys_expr(val)
          mi = mi + 1
        }
      },
      EStringInterp(parts) => {
        let mut pi3 = 0
        while pi3 < Array::length(parts) {
          if pi3 % 2 == 0 {
            let part = Array::get(parts, pi3)
            if String::length(part) > 0 && !array_contains_str(str_strs, part) {
              Array::push(str_strs, part)
            }
          }
          pi3 = pi3 + 1
        }
      },
      ELet(_, val, body) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ELetMut(_, val, body) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ELetRec(_, val, body) => {
        add_map_keys_expr(val); add_map_keys_expr(body)
      },
      ESeq(a, b) => {
        add_map_keys_expr(a); add_map_keys_expr(b)
      },
      EIf(c, t, e) => {
        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)
      },
      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),
      EHandle(body, _) => add_map_keys_expr(body),
      ECall(callee, args) => {
        add_map_keys_expr(callee)
        let mut ai = 0
        while ai < Array::length(args) {
          add_map_keys_expr(Array::get(args, ai))
          ai = ai + 1
        }
      },
      _ => ()
    }
  }
  let mut __mk = 0
  while __mk < Array::length(stmts) {
    match Array::get(stmts, __mk) {
      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),
      STest(_, expr) => add_map_keys_expr(expr),
      SBench(_, expr) => add_map_keys_expr(expr),
      _ => ()
    }
    __mk = __mk + 1
  }
  if !array_contains_str(str_strs, "") {
    Array::push(str_strs, "")
  }
  let src_str_base = Array::length(str_strs)
  let num_src_pairs = Array::length(selfhost_srcs)
  let mut __src_i = 0
  while __src_i < num_src_pairs {
    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)
    Array::push(str_strs, __src_path)
    Array::push(str_strs, __src_content)
    __src_i = __src_i + 1
  }
  let num_strings = Array::length(str_strs)
  let data_base = 64
  let str_offsets = lc_fresh_int_array()
  let str_lengths = lc_fresh_int_array()
  let mut str_pos = data_base
  let mut si = 0
  while si < num_strings {
    let s = Array::get(str_strs, si)
    let slen = String::length(s)
    Array::push(str_offsets, str_pos)
    Array::push(str_lengths, slen)
    str_pos = str_pos + slen
    si = si + 1
  }
  let heap_start = ((str_pos + 7) / 8) * 8
  let effect_names_list = lc_fresh_string_array()
  let effect_op_keys_list = lc_fresh_string_array()
  let effect_op_arities_list = Array::slice([
    0
  ], 0, 0)
  let mut eff_collect_i = 0
  while eff_collect_i < Array::length(stmts) {
    match Array::get(stmts, eff_collect_i) {
      SEffectDef(_, eff_name, _, ops) => {
        if eff_name != "Error" && !array_contains_str(effect_names_list, eff_name) {
          Array::push(effect_names_list, eff_name)
        } else {
          ()
        }
        let mut op_i = 0
        while op_i < Array::length(ops) {
          let (op_name, op_params, _) = Array::get(ops, op_i)
          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, "::"), op_name))
          Array::push(effect_op_arities_list, Array::length(op_params))
          op_i = op_i + 1
        }
      },
      _ => ()
    }
    eff_collect_i = eff_collect_i + 1
  }
  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072
  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, "Env::get")
  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, "Env::args_len")
  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, "Env::args_get")
  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::read_file")
  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::exists")
  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::stat_token")
  let need_fs_write_file_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::write_file")
  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, "Fs::write_bytes")
  let need_profiler_now_us_builtin = stmts_use_builtin(stmts, fn_names_list, "Profiler::now_us")
  let mut next_import_idx = 1
  let env_get_import_idx = if need_env_get_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let env_args_len_import_idx = if need_env_args_len_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let env_args_get_import_idx = if need_env_args_get_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_read_file_import_idx = if need_fs_read_file_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_exists_import_idx = if need_fs_exists_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_write_file_import_idx = if need_fs_write_file_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {
    let idx = next_import_idx
    next_import_idx = next_import_idx + 1
    idx
  } else {
    -1
  }
  let linked_import_indices = lc_fresh_int_array()
  let linked_import_names = lc_fresh_string_array()
  let mut li_i = 0
  while li_i < Array::length(linked_imports) {
    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)
    Array::push(linked_import_indices, next_import_idx)
    Array::push(linked_import_names, lfn_name)
    next_import_idx = next_import_idx + 1
    li_i = li_i + 1
  }
  let num_imported_funcs = next_import_idx
  let print_int_idx = num_imported_funcs
  let print_str_idx = print_int_idx + 1
  let str_len_idx = print_str_idx + 1
  let str_eq_idx = str_len_idx + 1
  let str_concat_idx = str_eq_idx + 1
  let arr_new_idx = str_concat_idx + 1
  let arr_len_idx = arr_new_idx + 1
  let arr_get_idx = arr_len_idx + 1
  let arr_push_idx = arr_get_idx + 1
  let arr_set_idx = arr_push_idx + 1
  let double_to_int_idx = arr_set_idx + 1
  let int_to_double_idx = double_to_int_idx + 1
  let str_char_code_at_idx = int_to_double_idx + 1
  let str_from_char_code_idx = str_char_code_at_idx + 1
  let str_substring_idx = str_from_char_code_idx + 1
  let identity_idx = str_substring_idx + 1
  let arr_slice_idx = identity_idx + 1
  let arr_concat_idx = arr_slice_idx + 1
  let arr_truncate_idx = arr_concat_idx + 1
  let string_join_idx = arr_truncate_idx + 1
  let fs_read_file_stub_idx = string_join_idx + 1
  let fs_exists_stub_idx = fs_read_file_stub_idx + 1
  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1
  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1
  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1
  let eq_idx = fs_write_bytes_stub_idx + 1
  let string_ends_with_idx = eq_idx + 1
  let string_last_index_of_idx = string_ends_with_idx + 1
  let arr_push_all_idx = string_last_index_of_idx + 1
  let string_index_of_idx = arr_push_all_idx + 1
  let string_contains_idx = string_index_of_idx + 1
  let string_starts_with_idx = string_contains_idx + 1
  let string_split_idx = string_starts_with_idx + 1
  let string_trim_idx = string_split_idx + 1
  let selfhost_sources_idx = string_trim_idx + 1
  let bytes_new_idx = selfhost_sources_idx + 1
  let bytes_len_idx = bytes_new_idx + 1
  let bytes_get_idx = bytes_len_idx + 1
  let bytes_set_idx = bytes_get_idx + 1
  let bytes_push_idx = bytes_set_idx + 1
  let bytes_append_idx = bytes_push_idx + 1
  let bytes_concat_idx = bytes_append_idx + 1
  let bytes_slice_idx = bytes_concat_idx + 1
  let bytes_from_array_idx = bytes_slice_idx + 1
  let bytes_to_array_idx = bytes_from_array_idx + 1
  let rc_drop_idx = bytes_to_array_idx + 1
  let rc_alloc_idx = rc_drop_idx + 1
  let heap_grow_check_idx = if enable_rc {
    rc_alloc_idx + 1
  } else {
    bytes_to_array_idx + 1
  }
  let simd_skip_ws_idx = heap_grow_check_idx + 1
  let simd_scan_alnum_idx = simd_skip_ws_idx + 1
  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1
  let env_get_idx = if env_get_import_idx >= 0 {
    env_get_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let env_args_len_idx = if env_args_len_import_idx >= 0 {
    env_args_len_import_idx
  } else {
    fs_exists_stub_idx
  }
  let env_args_get_idx = if env_args_get_import_idx >= 0 {
    env_args_get_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {
    fs_read_file_import_idx
  } else {
    fs_read_file_stub_idx
  }
  let fs_exists_idx = if fs_exists_import_idx >= 0 {
    fs_exists_import_idx
  } else {
    fs_exists_stub_idx
  }
  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {
    fs_stat_token_import_idx
  } else {
    fs_stat_token_stub_idx
  }
  let fs_write_file_idx = if fs_write_file_import_idx >= 0 {
    fs_write_file_import_idx
  } else {
    fs_write_file_stub_idx
  }
  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {
    fs_write_bytes_import_idx
  } else {
    fs_write_bytes_stub_idx
  }
  let profiler_now_us_idx = if profiler_now_us_import_idx >= 0 {
    profiler_now_us_import_idx
  } else {
    env_args_len_idx
  }
  let max_builtin_func_idx = simd_scan_alnum_str_idx
  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1
  let func_offset = num_imported_funcs + num_generated
  let fn_indices_list = lc_fresh_int_array()
  let fn_returns_list = lc_fresh_int_array()
  let mut fi = 0
  while fi < num_user_funcs {
    Array::push(fn_indices_list, fi + func_offset)
    Array::push(fn_returns_list, 1)
    fi = fi + 1
  }
  let builtin_names_list = lc_fresh_string_array()
  let builtin_param_counts = lc_fresh_int_array()
  let builtin_needs_env_list = lc_fresh_bool_array()
  let builtin_indices_list = lc_fresh_int_array()
  let builtin_returns_list = lc_fresh_int_array()
  Array::push(builtin_names_list, "Env::get")
  Array::push(builtin_param_counts, 1)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, env_get_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Env::args_len")
  Array::push(builtin_param_counts, 0)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, env_args_len_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Env::args_get")
  Array::push(builtin_param_counts, 1)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, env_args_get_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Fs::read_file")
  Array::push(builtin_param_counts, 1)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, fs_read_file_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Fs::exists")
  Array::push(builtin_param_counts, 1)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, fs_exists_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Fs::stat_token")
  Array::push(builtin_param_counts, 1)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, fs_stat_token_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Fs::write_file")
  Array::push(builtin_param_counts, 2)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, fs_write_file_idx)
  Array::push(builtin_returns_list, 0)
  Array::push(builtin_names_list, "Fs::write_bytes")
  Array::push(builtin_param_counts, 2)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, fs_write_bytes_idx)
  Array::push(builtin_returns_list, 0)
  Array::push(builtin_names_list, "Profiler::now_us")
  Array::push(builtin_param_counts, 0)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, profiler_now_us_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "Profiler::NowUs")
  Array::push(builtin_param_counts, 0)
  Array::push(builtin_needs_env_list, false)
  Array::push(builtin_indices_list, profiler_now_us_idx)
  Array::push(builtin_returns_list, 1)
  Array::push(builtin_names_list, "simd_skip_ws")
