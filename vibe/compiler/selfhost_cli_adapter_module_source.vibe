  TDotDot;
  TDotDotDot;
  TStringInterp(Array[String]);
  TEof
}


export let token_to_string: (Token) -> String = (t) -> {
  match t {
    TInt(n) => String::concat("TInt(", String::concat(__to_string(n), ")")),
    TFloat(n) =>
    String::concat("TFloat(", String::concat(double_to_string_compiler(n), ")")),
    TString(s) => String::concat("TString(\"", String::concat(s, "\")")),
    TIdent(s) => String::concat("TIdent(", String::concat(s, ")")),
    TLet => "TLet",
    TRec => "TRec",
    TMut => "TMut",
    TFn => "TFn",
    TIf => "TIf",
    TElse => "TElse",
    TMatch => "TMatch",
    TIs => "TIs",
    TDo => "TDo",
    TEnum => "TEnum",
    TStruct => "TStruct",
    TType => "TType",
    TTrait => "TTrait",
    TImpl => "TImpl",
    TExport => "TExport",
    TTest => "TTest",
    TWhile => "TWhile",
    TFor => "TFor",
    TIn => "TIn",
    TLoop => "TLoop",
    TBreak => "TBreak",
    TContinue => "TContinue",
    TReturn => "TReturn",
    TWith => "TWith",
    THandle => "THandle",
    TThrow => "TThrow",
    TRaise => "TRaise",
    TYield => "TYield",
    TBench => "TBench",
    TDeclare => "TDeclare",
    TAs => "TAs",
    TModule => "TModule",
    TSuberror => "TSuberror",
    TDerive => "TDerive",
    TOpen => "TOpen",
    TImport => "TImport",
    TPlus => "TPlus",
    TMinus => "TMinus",
    TStar => "TStar",
    TSlash => "TSlash",
    TPercent => "TPercent",
    TEqEq => "TEqEq",
    TNeq => "TNeq",
    TLt => "TLt",
    TLte => "TLte",
    TGt => "TGt",
    TGte => "TGte",
    TAnd => "TAnd",
    TOr => "TOr",
    TNot => "TNot",
    TBitAnd => "TBitAnd",
    TBitOr => "TBitOr",
    TBitXor => "TBitXor",
    TLShift => "TLShift",
    TRShift => "TRShift",
    TPipeGt => "TPipeGt",
    TArrow => "TArrow",
    TThinArrow => "TThinArrow",
    TEq => "TEq",
    TDot => "TDot",
    TColon => "TColon",
    TDoubleColon => "TDoubleColon",
    TComma => "TComma",
    TSemicolon => "TSemicolon",
    THash => "THash",
    TTilde => "TTilde",
    TQuestion => "TQuestion",
    TPlusEq => "TPlusEq",
    TMinusEq => "TMinusEq",
    TStarEq => "TStarEq",
    TSlashEq => "TSlashEq",
    TPercentEq => "TPercentEq",
    TLParen => "TLParen",
    TRParen => "TRParen",
