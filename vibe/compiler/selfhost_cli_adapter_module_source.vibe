    emit_local_set(b, 6)
    emit_local_get(b, 6)
    emit_local_get(b, 7)
    emit_i32_const(b, 8)
    emit_i32_mul(b)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 6)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_local_get(b, 5)
    emit_local_get(b, 4)
    emit_i32_const(b, 8)
