let op_i32_eq = 70
let op_i32_ne = 71
export let is_erecord: (Expr) -> Bool = (expr) -> {
  match expr {
    ERecord(_) => true,
    _ => false
  }
}
export let is_pstring: (Pat) -> Bool = (p) -> {
  match p {
    PString(_) => true,
