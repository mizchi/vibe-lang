let async_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let lookup_future: (String) -> Option[Type] = (name) -> {
  if name == "await" {
    Some(CtFn([
      CtNamed("Future", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Future::ready" {
    Some(CtFn([
      CtUnknown
    ], CtNamed("Future", [
      CtUnknown
    ]), None))
  } else {
    None
  }
}

let lookup_stream: (String) -> Option[Type] = (name) -> {
  if name == "Stream::empty" {
    Some(CtFn(async_no_params(), CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::once" {
    Some(CtFn([
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::next" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ])
    ], CtNamed("Future", [
      CtOption(CtUnknown)
    ]), Some("Async")))
  } else if name == "Stream::map" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::filter" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown
    ], CtNamed("Stream", [
      CtUnknown
    ]), None))
  } else if name == "Stream::fold" {
    Some(CtFn([
      CtNamed("Stream", [
        CtUnknown
      ]),
      CtUnknown,
      CtUnknown
    ], CtNamed("Future", [
      CtUnknown
    ]), Some("Async")))
  } else {
    None
  }
}

let lookup_concurrency: (String) -> Option[Type] = (name) -> {
  if name == "Task::spawn" {
    Some(CtFn([
      CtUnknown
    ], CtNamed("Task", [
      CtUnknown
    ]), Some("Async")))
  } else if name == "Task::join" {
    Some(CtFn([
      CtNamed("Task", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Task::cancel" {
    Some(CtFn([
      CtNamed("Task", [
        CtUnknown
      ])
    ], CtUnit, Some("Async")))
  } else if name == "Task::race" {
    Some(CtFn([
      CtNamed("Task", [
        CtUnknown
      ]),
      CtNamed("Task", [
        CtUnknown
      ])
    ], CtUnknown, Some("Async")))
  } else if name == "Task::timeout" {
    Some(CtFn([
      CtInt,
      CtUnknown
    ], CtOption(CtUnknown), Some("Async")))
  } else {
    None
  }
}

let lookup_bytestream: (String) -> Option[Type] = (name) -> {
  if name == "String::to_bytes" {
    Some(CtFn([
      CtString
    ], CtNamed("Stream", [
      CtInt
    ]), None))
  } else if name == "Stream::to_string" {
    Some(CtFn([
      CtNamed("Stream", [
        CtInt
      ])
    ], CtString, None))
  } else {
    None
  }
}

export let lookup_async: (String) -> Option[Type] = (name) -> {
  match lookup_future(name) {
    Some(t) => Some(t),
    None => match lookup_stream(name) {
      Some(t) => Some(t),
      None => match lookup_concurrency(name) {
        Some(t) => Some(t),
        None => lookup_bytestream(name)
      }
    }
  }
}



