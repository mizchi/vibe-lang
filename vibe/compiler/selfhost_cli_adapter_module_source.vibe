let singleton_string_array: (String) -> Array[String] = (v0) -> {
  let values = builders_empty_string_array()
  Array::push(values, v0)
  values
}

export let build_hello_module: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))
  emit_func_type_raw(type_content, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, sec_type, type_content)
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  emit_function_section(out, singleton_int_array(1))
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, singleton_string_array("_start"), singleton_int_array(1), "memory", 0)
  let b = bytebuf_new()
  emit_i32_const(b, 0)
  emit_i32_const(b, 8)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 12)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 100)
  emit_call(b, 0)
  emit_drop(b)
  emit_code_section(out, singleton_bytes_array(b))
  let hello_data = bytebuf_new()
  bytebuf_push(hello_data, 104)
  bytebuf_push(hello_data, 101)
  bytebuf_push(hello_data, 108)
  bytebuf_push(hello_data, 108)
  bytebuf_push(hello_data, 111)
  bytebuf_push(hello_data, 32)
  bytebuf_push(hello_data, 119)
  bytebuf_push(hello_data, 111)
  bytebuf_push(hello_data, 114)
  bytebuf_push(hello_data, 108)
  bytebuf_push(hello_data, 100)
  bytebuf_push(hello_data, 10)
  emit_data_section(out, 8, hello_data)
  bytebuf_to_bytes(out)
}

export let build_arithmetic_module: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, triple_int_array(0, 0, 0))
  emit_export_section_multi(out, triple_string_array("add", "sub", "mul"), triple_int_array(0, 1, 2))
  let add_body = bytebuf_new()
  emit_local_get(add_body, 0)
  emit_local_get(add_body, 1)
  emit_i64_add(add_body)
  let sub_body = bytebuf_new()
  emit_local_get(sub_body, 0)
  emit_local_get(sub_body, 1)
  emit_i64_sub(sub_body)
  let mul_body = bytebuf_new()
  emit_local_get(mul_body, 0)
  emit_local_get(mul_body, 1)
  emit_i64_mul(mul_body)
  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))
  bytebuf_to_bytes(out)
}

export let emit_data_section_multi: (Bytes, Array[Int], Array[Bytes]) -> Unit = (out, offsets, datas) -> {
  let count = Array::length(offsets)
  let content = bytebuf_new()
  bytebuf_push_vec_header(content, count)
  let mut i = 0
  while i < count {
    bytebuf_push(content, 0)
    emit_i32_const(content, Array::get(offsets, i))
    emit_end(content)
    let data = Array::get(datas, i)
    leb128_encode_u32(content, Bytes::length(data))
    bytebuf_push_buf(content, data)
    i = i + 1
  }
  bytebuf_push_section(out, builders_sec_data, content)
}

export let build_print_string_module: (String) -> Bytes = (msg) -> {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))
  emit_func_type_raw(type_content, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, sec_type, type_content)
  emit_import_section_func(out, "wasi_snapshot_preview1", "fd_write", 0)
  emit_function_section(out, singleton_int_array(1))
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, singleton_string_array("_start"), singleton_int_array(1), "memory", 0)
  let str_data = string_to_data(msg)
  let str_len = Bytes::length(str_data)
  let b = bytebuf_new()
  emit_i32_const(b, 0)
  emit_i32_const(b, 16)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, str_len)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  emit_code_section(out, singleton_bytes_array(b))
  emit_data_section(out, 16, str_data)
  bytebuf_to_bytes(out)
}



let simd_prefix = 253

let simd_v128_load = 0
let simd_v128_store = 11

let simd_i8x16_splat = 15

let simd_i8x16_swizzle = 14

let simd_i8x16_eq = 35
let simd_i8x16_le_u = 42
let simd_i8x16_ge_u = 44

let simd_i8x16_sub = 113
let simd_i8x16_min_u = 119

let simd_v128_any_true = 83

let simd_v128_and = 78
let simd_v128_not = 77

let simd_i8x16_all_true = 99
let simd_i8x16_bitmask = 100

let simd_v128_const = 12


export let emit_v128_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_load)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_v128_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_store)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}


export let emit_i8x16_splat: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_splat)
}


export let emit_i8x16_eq: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_eq)
}

export let emit_i8x16_le_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_le_u)
}

export let emit_i8x16_ge_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_ge_u)
}

export let emit_i8x16_swizzle: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_swizzle)
}

export let emit_i8x16_sub: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_sub)
}

export let emit_i8x16_min_u: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_min_u)
}


export let emit_v128_any_true: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_any_true)
}

export let emit_i8x16_all_true: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_all_true)
}

export let emit_i8x16_bitmask: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_i8x16_bitmask)
}


export let emit_v128_and: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_and)
}

export let emit_v128_or: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, 79)
}

export let emit_v128_not: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_not)
}


export let emit_v128_const: (Bytes, Array[Int]) -> Unit = (buf, lanes) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_const)
  let n = Array::length(lanes)
  let mut i = 0
  while i < 16 {
    let b = if i < n {
      Array::get(lanes, i)
    } else {
      0
    }
    bytebuf_push(buf, b & 255)
    i = i + 1
  }
}

export let emit_v128_const_zero: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_const)
  let mut i = 0
  while i < 16 {
    bytebuf_push(buf, 0)
    i = i + 1
  }
}

export let emit_v128_const_splat_byte: (Bytes, Int) -> Unit = (buf, byte_val) -> {
  bytebuf_push(buf, simd_prefix)
  leb128_encode_u32(buf, simd_v128_const)
  let mut i = 0
  while i < 16 {
    bytebuf_push(buf, byte_val & 255)
    i = i + 1
  }
}






export let emit_simd_memcmp_16: (Bytes) -> Unit = (buf) -> {
  emit_local_get(buf, 0)
  emit_i32_wrap_i64(buf)
  emit_v128_load(buf, 0, 0)

  emit_local_get(buf, 1)
  emit_i32_wrap_i64(buf)
  emit_v128_load(buf, 0, 0)

  emit_i8x16_eq(buf)
  emit_i8x16_all_true(buf)
  emit_i64_extend_i32_s(buf)
}


export let emit_simd_find_byte_16: (Bytes) -> Unit = (buf) -> {
  emit_local_get(buf, 0)
  emit_i32_wrap_i64(buf)
  emit_v128_load(buf, 0, 0)

  emit_local_get(buf, 1)
  emit_i32_wrap_i64(buf)
  emit_i8x16_splat(buf)

  emit_i8x16_eq(buf)
  emit_i8x16_bitmask(buf)
  emit_i64_extend_i32_s(buf)
}


export let emit_simd_skip_whitespace_16: (Bytes) -> Unit = (buf) -> {
  emit_local_get(buf, 0)
  emit_i32_wrap_i64(buf)
  emit_v128_load(buf, 0, 0)
  emit_local_set(buf, 2)  // local2 = chunk

  emit_local_get(buf, 2)
  emit_i64_const(buf, 0x20)
  emit_i32_wrap_i64(buf)
  emit_i8x16_splat(buf)
  emit_i8x16_eq(buf)

  emit_local_get(buf, 2)
  emit_i64_const(buf, 0x09)
  emit_i32_wrap_i64(buf)
  emit_i8x16_splat(buf)
  emit_i8x16_eq(buf)

  emit_v128_or(buf)

  emit_local_get(buf, 2)
  emit_i64_const(buf, 0x0A)
  emit_i32_wrap_i64(buf)
  emit_i8x16_splat(buf)
  emit_i8x16_eq(buf)

  emit_v128_or(buf)

  emit_local_get(buf, 2)
  emit_i64_const(buf, 0x0D)
  emit_i32_wrap_i64(buf)
  emit_i8x16_splat(buf)
  emit_i8x16_eq(buf)

  emit_v128_or(buf)

  emit_v128_not(buf)
  emit_i8x16_bitmask(buf)
  emit_i64_extend_i32_s(buf)
}


export let emit_simd_is_identifier_char_16: (Bytes) -> Unit = (buf) -> {
  emit_local_get(buf, 0)
  emit_i32_wrap_i64(buf)
  emit_v128_load(buf, 0, 0)
  emit_local_set(buf, 1)  // local1 = chunk

  emit_local_get(buf, 1)
  emit_i64_const(buf, 0x5F)
  emit_i32_wrap_i64(buf)
  emit_i8x16_splat(buf)
  emit_i8x16_eq(buf)


  emit_i8x16_bitmask(buf)
  emit_i64_extend_i32_s(buf)
}


let emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, 41)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}


export let emit_scalar_memcmp_16_unrolled: (Bytes) -> Unit = (buf) -> {
  emit_local_get(buf, 0)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 0, 0)

  emit_local_get(buf, 1)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 0, 0)

  emit_i64_eq(buf)
  emit_if_i64(buf)
    emit_local_get(buf, 0)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 0, 8)

    emit_local_get(buf, 1)
    emit_i32_wrap_i64(buf)
    emit_i64_load(buf, 0, 8)

    emit_i64_eq(buf)
    emit_i64_extend_i32_s(buf)
  emit_else(buf)
    emit_i64_const(buf, 0)
  emit_end(buf)
}


export let emit_scalar_find_byte_16_unrolled: (Bytes) -> Unit = (buf) -> {
  emit_local_get(buf, 0)
  emit_i32_wrap_i64(buf)
  emit_i32_load8_u(buf, 0, 0)
  emit_i64_extend_i32_s(buf)
  emit_local_get(buf, 1)
  emit_i64_eq(buf)
  emit_if_i64(buf)
    emit_i64_const(buf, 1)
    emit_return(buf)
  emit_else(buf)
    emit_local_get(buf, 0)
    emit_i32_wrap_i64(buf)
    emit_i32_load8_u(buf, 0, 1)
    emit_i64_extend_i32_s(buf)
    emit_local_get(buf, 1)
    emit_i64_eq(buf)
    emit_if_i64(buf)
      emit_i64_const(buf, 2)
      emit_return(buf)
    emit_else(buf)
      emit_local_get(buf, 0)
      emit_i32_wrap_i64(buf)
      emit_i32_load8_u(buf, 0, 2)
      emit_i64_extend_i32_s(buf)
      emit_local_get(buf, 1)
      emit_i64_eq(buf)
      emit_if_i64(buf)
        emit_i64_const(buf, 4)
        emit_return(buf)
      emit_else(buf)
        emit_local_get(buf, 0)
        emit_i32_wrap_i64(buf)
        emit_i32_load8_u(buf, 0, 3)
        emit_i64_extend_i32_s(buf)
        emit_local_get(buf, 1)
        emit_i64_eq(buf)
        emit_if_i64(buf)
          emit_i64_const(buf, 8)
          emit_return(buf)
        emit_else(buf)
          emit_i64_const(buf, 0)
        emit_end(buf)
      emit_end(buf)
    emit_end(buf)
  emit_end(buf)
}







let op_prefix = 252


export let get_ebinop_lhs: (Expr) -> Expr with { Error } = (expr) -> {
  match expr {
    EBinOp(_, lhs, _) => lhs,
    _ => throw("not EBinOp")
  }
}

