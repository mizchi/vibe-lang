  emit_name(ic, "cm")
  emit_name(ic, "task-return")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    2
  ])
  emit_export_section(out, "run", 2)
  let body = bytebuf_new()
  emit_i64_const(body, 0)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 0)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 1)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}
let emit_core_instance_instantiate_args: (Bytes, Int, Array[String], Array[Int]) -> Unit = (buf, module_index, arg_names, arg_instance_indices) -> {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, module_index)
  leb128_encode_u32(content, Array::length(arg_names))
  let mut i = 0
  while i < Array::length(arg_names) {
    emit_name(content, Array::get(arg_names, i))
    bytebuf_push(content, comp_inst_arg_instance)
    leb128_encode_u32(content, Array::get(arg_instance_indices, i))
    i = i + 1
  }
  emit_raw_content(buf, content)
}
let comp_generate_wasi_fd_write_stub: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, tc)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "fd_write", 0)
  let body = bytebuf_new()
  emit_i32_const(body, 0)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}
export let comp_emit_component_wasm_async_trampolined_p1: (Bytes, String, Int) -> Bytes = (main_core_wasm, export_name, comp_result_valtype) -> {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))
  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())
  emit_core_instance_instantiate_section(buf, 2, Array::slice([
    ""
  ], 0, 0))
  emit_core_instance_instantiate_args(buf, 0, [
    "wasi_snapshot_preview1"
  ], [
    0
  ])
  emit_canon_task_return(buf, comp_result_valtype)
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    0
  ])
  emit_alias_section(buf, 1, [
    "run"
  ], [
    core_sort_func
  ])
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "run"
  ], [
    1
  ])
  emit_core_instance_instantiate_args(buf, 1, [
    "main",
    "cm"
  ], [
    3,
    2
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  emit_alias_section(buf, 4, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, 2, 0)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}
let entry_declares_async_int: (Array[Stmt], String) -> Bool = (stmts, entry_name) -> {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, opt_ty, _) => if name == entry_name {
        match opt_ty {
          Some(ty) => match ty {
            TyFn(params, ret, opt_eff) => match opt_eff {
              Some(eff) => if String::contains(eff, "Async") && Array::length(params) == 0 {
                match ret {
                  TyName(rn) => if rn == "Int" {
                    found = true
                  } else {
                    ()
                  },
                  _ => ()
                }
              } else {
                ()
              },
              None => ()
            },
            _ => ()
          },
          None => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}
let maybe_wrap_async_component: (Bytes, Bool) -> Bytes = (bytes, wrap_async) -> {
  if wrap_async {
    comp_emit_component_wasm_async_trampolined_p1(bytes, "run", 120)
  } else {
    bytes
  }
}
export let compile_source_wasi_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)
}
export let compile_source_wasi_only_coverage: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  strip_generic_type_params(stmts)
  compile_wasi_module_coverage_impl(stmts, entry_name)
}
export let compile_source_wasi_only_rc: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)
}
export {
  expand_interp_stmts, compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, strip_generic_type_params
}
let join: (Array[String], String) -> String = (arr, sep) -> {
  let len = Array::length(arr)
  if len == 0 {
    ""
  } else {
    let b = ArrayBuilder::new()
    let mut i = 0
    while i < len {
      if i > 0 {
        ArrayBuilder::push(b, sep)
      }
      ArrayBuilder::push(b, Array::get(arr, i))
      i = i + 1
    }
    String::join(ArrayBuilder::freeze(b), "")
  }
}
let escape_string: (String) -> String = (s) -> {
  let len = String::length(s)
  let b = ArrayBuilder::new()
  let push_chunk: (Int, Int) -> Unit = (start, end) -> {
    if end > start {
      ArrayBuilder::push(b, s[start: end])
    }
  }
  let mut i = 0
  let mut start = 0
  while i < len {
    let c = String::char_code_at(s, i)
    if c == '"' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\\"")
      i = i + 1
      start = i
    } else if c == '\\' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\\\")
      i = i + 1
      start = i
    } else if c == '\n' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\n")
      i = i + 1
      start = i
    } else if c == '\t' {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\t")
      i = i + 1
      start = i
    } else if c == 13 {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\r")
      i = i + 1
      start = i
    } else if c == 0 {
      push_chunk(start, i)
      ArrayBuilder::push(b, "\\0")
      i = i + 1
      start = i
    } else {
      i = i + 1
    }
  }
  push_chunk(start, len)
  String::join(ArrayBuilder::freeze(b), "")
}
export let rec print_pat: (Pat) -> String = (p) -> {
  match p {
    PWild => "_",
    PBind(name) => name,
    PInt(n) => __to_string(n),
    PString(s) => String::concat("\"", String::concat(escape_string(s), "\"")),
    PBool(b) => if b {
      "true"
    } else "false",
    PCtor(name, args) => if Array::length(args) == 0 {
      name
    } else {
      let parts = for arg in args {
        print_pat(arg)
      }
      String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))
    },
    PTuple(elems) => {
      let parts = for elem in elems {
        print_pat(elem)
      }
      String::concat("(", String::concat(join(parts, ", "), ")"))
    },
    POr(left, right) => String::concat(print_pat(left), String::concat(" | ", print_pat(right))),
    PStruct(name, _) => String::concat(name, "::{...}")
  }
}
let handle_effect_name_from_ctor: (String) -> Option[String] = (name) -> {
  let idx = String::last_index_of(name, "::")
  if idx < 0 {
    None
  } else {
    Some(name[0: idx])
  }
}
let rec infer_handle_effect_name_from_pat: (Pat) -> Option[String] = (pat) -> {
  match pat {
    PCtor(name, _) => handle_effect_name_from_ctor(name),
    POr(left, right) => match infer_handle_effect_name_from_pat(left) {
      Some(name) => Some(name),
      None => infer_handle_effect_name_from_pat(right)
    },
    _ => None
  }
}
let infer_handle_effect_name: (Array[(Pat, Expr)]) -> String = (arms) -> {
  let mut i = 0
  let mut effect_name = "Error"
  let mut found = false
  while i < Array::length(arms) && !found {
    let (pat, _) = Array::get(arms, i)
    match infer_handle_effect_name_from_pat(pat) {
      Some(name) => {
        effect_name = name
        found = true
      },
      None => {
        i = i + 1
      }
    }
  }
  effect_name
}
let strip_handle_effect_ctor: (String, String) -> String = (effect_name, ctor_name) -> {
  let prefix = String::concat(effect_name, "::")
  if String::starts_with(ctor_name, prefix) {
    let prefix_len = String::length(prefix)
    let ctor_len = String::length(ctor_name)
    ctor_name[prefix_len: ctor_len]
  } else {
    ctor_name
  }
}
let rec print_handle_pat: (String, Pat) -> String = (effect_name, pat) -> {
  match pat {
    PCtor(name, args) => {
      let short_name = strip_handle_effect_ctor(effect_name, name)
      if Array::length(args) == 0 {
        short_name
      } else {
        let parts = for arg in args {
          print_pat(arg)
        }
        String::concat(short_name, String::concat("(", String::concat(join(parts, ", "), ")")))
      }
    },
    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(" | ", print_handle_pat(effect_name, right))),
    _ => print_pat(pat)
  }
}
let map_to_strings: (Array[Expr], (Expr) -> String) -> Array[String] = (exprs, f) -> {
  for expr in exprs {
    f(expr)
  }
}
export let rec print_type_expr: (TypeExpr) -> String = (ty) -> {
  match ty {
    TyName(name) => name,
    TyUnit => "()",
    TyApp(name, args) => {
      let parts = for arg in args {
        print_type_expr(arg)
      }
      String::concat(name, String::concat("[", String::concat(join(parts, ", "), "]")))
    },
    TyFn(params, ret, effect_name) => {
      let parts = for param in params {
        print_type_expr(param)
      }
      let base = String::concat("(", String::concat(join(parts, ", "), String::concat(") -> ", print_type_expr(ret))))
      match effect_name {
        Some(name) => String::concat(base, String::concat(" with { ", String::concat(name, " }"))),
        None => base
      }
    },
    TyTuple(elems) => {
      let parts = for elem in elems {
        print_type_expr(elem)
      }
      String::concat("(", String::concat(join(parts, ", "), ")"))
    }
  }
}
let print_ctor: (String, Array[TypeExpr]) -> String = (name, args) -> {
  if Array::length(args) == 0 {
    name
  }
  else {
    let parts = for arg in args {
      print_type_expr(arg)
    }
    String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))
  }
}
let print_fn_type_params: (Array[String], Array[(String, Array[String])]) -> String = (type_params, bounds) -> {
  if Array::length(type_params) == 0 {
    ""
  } else {
    let parts = for tp in type_params {
      let mut found = Array::slice([
        ""
      ], 0, 0)
      let mut bi = 0
      while bi < Array::length(bounds) {
        let (bname, blist) = Array::get(bounds, bi)
        if bname == tp {
          found = blist
        }
        bi = bi + 1
      }
      if Array::length(found) == 0 {
        tp
      } else {
        String::concat(tp, String::concat(": ", join(found, " + ")))
      }
    }
    String::concat("[", String::concat(join(parts, ", "), "]"))
  }
}
export let rec print_expr: (Expr) -> String = (e) -> {
  match e {
    EInt(n) => __to_string(n),
    EFloat(n) => double_to_string_compiler(n),
    EString(s) => String::concat("\"", String::concat(escape_string(s), "\"")),
    EBool(b) => if b {
      "true"
    } else "false",
    EIdent(name, _) => name,
    EUnit => "()",
    ETuple(elems) => String::concat("(", String::concat(join(map_to_strings(elems, print_expr), ", "), ")")),
    EArray(elems) => String::concat("[", String::concat(join(map_to_strings(elems, print_expr), ", "), "]")),
    ERecord(fields) => {
      let parts = for field in fields {
        let (name, val) = field
        String::concat(name, String::concat(": ", print_expr(val)))
      }
      String::concat("record { ", String::concat(join(parts, ", "), " }"))
    },
    EIf(cond, then_e, else_e) => match else_e {
      EUnit => String::concat("if ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(then_e), " }")))),
      _ => String::concat("if ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(then_e), String::concat(" } else { ", String::concat(print_expr(else_e), " }"))))))
    },
    ELet(name, val, body) => String::concat("{ let ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    ELetRec(name, val, body) => String::concat("{ let rec ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    ELetMut(name, val, body) => String::concat("{ let mut ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    EAssign(name, val, body) => String::concat("{ ", String::concat(name, String::concat(" = ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))),
    EAssignOp(name, op, val, body) => String::concat("{ ", String::concat(name, String::concat(" ", String::concat(op, String::concat("= ", String::concat(print_expr(val), String::concat("; ", String::concat(print_expr(body), " }")))))))),
    ESeq(a, b) => String::concat("{ ", String::concat(print_expr(a), String::concat("; ", String::concat(print_expr(b), " }")))),
    EMatch(scrutinee, arms) => {
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_pat(pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("match ", String::concat(print_expr(scrutinee), String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    EHandle(body, arms) => {
      let effect_name = infer_handle_effect_name(arms)
      let parts = for arm in arms {
        let (pat, expr) = arm
        String::concat(print_handle_pat(effect_name, pat), String::concat(" => ", print_expr(expr)))
      }
      String::concat("handle { ", String::concat(print_expr(body), String::concat(" } with ", String::concat(effect_name, String::concat(" { ", String::concat(join(parts, "; "), " }"))))))
    },
    EWhile(cond, body) => String::concat("while ", String::concat(print_expr(cond), String::concat(" { ", String::concat(print_expr(body), " }")))),
    ELoop(params, body) => {
      let parts = for param in params {
        let (name, init) = param
        String::concat(name, String::concat(" = ", print_expr(init)))
      }
      String::concat("loop (", String::concat(join(parts, ", "), String::concat(") { ", String::concat(print_expr(body), " }"))))
    },
    EForIn(value_name, index_name, iterable, body) => {
      let binding = match index_name {
        Some(index_name) => String::concat(index_name, String::concat(", ", value_name)),
        None => value_name
      }
      String::concat("for ", String::concat(binding, String::concat(" in ", String::concat(print_expr(iterable), String::concat(" { ", String::concat(print_expr(body), " }"))))))
    },
    ECall(callee, args, _) => match callee {
      EIdent("perform", _) => if Array::length(args) == 1 {
        String::concat("perform ", print_expr(Array::get(args, 0)))
      } else {
        String::concat(print_expr(callee), String::concat("(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")))
      },
      _ => String::concat(print_expr(callee), String::concat("(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")))
    },
    EBinOp(op, left, right) => String::concat("(", String::concat(print_expr(left), String::concat(" ", String::concat(op, String::concat(" ", String::concat(print_expr(right), ")")))))),
    EUnaryOp(op, expr) => String::concat("(", String::concat(op, String::concat(print_expr(expr), ")"))),
    EFn(type_params, bounds, params, ret_ty, effect, body) => {
      let tp_str = print_fn_type_params(type_params, bounds)
      let parts = for param in params {
        let (name, ty_opt) = param
        match ty_opt {
          Some(ty) => String::concat(name, String::concat(": ", print_type_expr(ty))),
          None => name
        }
      }
      let ret_str = match ret_ty {
        Some(rt) => {
          let eff_str = match effect {
            Some(e) => String::concat(" with { ", String::concat(e, " }")),
            None => ""
          }
          String::concat(") -> ", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(" { ", String::concat(print_expr(body), " }")))))
        },
        None => String::concat(") -> { ", String::concat(print_expr(body), " }"))
      }
      String::concat(tp_str, String::concat("(", String::concat(join(parts, ", "), ret_str)))
    },
    EDot(expr, field, _) => String::concat(print_expr(expr), String::concat(".", field)),
    EThrow(e) => String::concat("throw(", String::concat(print_expr(e), ")")),
    EReturn(e) => String::concat("return ", print_expr(e)),
    EBreak(opt) => match opt {
      None => "break",
      Some(v) => String::concat("break ", print_expr(v))
    },
    EContinue(args) => if Array::length(args) == 0 {
      "continue"
    } else String::concat("continue(", String::concat(join(map_to_strings(args, print_expr), ", "), ")")),
    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat("=", print_expr(val))),
    EMap(fields) => if Array::length(fields) == 0 {
      "map {}"
    } else {
      let parts = for field in fields {
        let (k, v) = field
        String::concat(k, String::concat(": ", print_expr(v)))
      }
      String::concat("map { ", String::concat(join(parts, ", "), " }"))
    },
    ESpread(inner) => String::concat("...", print_expr(inner)),
    EStringInterp(parts) => String::concat("\"", String::concat(join(parts, ""), "\""))
  }
}
let print_annotated_let_value: (Option[TypeExpr], Expr) -> String = (ty_opt, val) -> {
  match ty_opt {
    Some(TyFn(_, _, _)) => match val {
      EFn(type_params, bounds, params, _, _, body) => {
        let tp_str = print_fn_type_params(type_params, bounds)
        let parts = for param in params {
          let (name, _) = param
          name
        }
        String::concat(
          tp_str,
          String::concat(
            "(",
            String::concat(
              join(parts, ", "),
              String::concat(") -> { ", String::concat(print_expr(body), " }"))
            )
          )
        )
      },
      _ => print_expr(val)
    },
    _ => print_expr(val)
  }
}
let print_ctor_list: (Array[(String, Array[TypeExpr])]) -> String = (ctors) -> {
  let parts = for ctor in ctors {
    let (name, args) = ctor
    print_ctor(name, args)
  }
  join(parts, "; ")
}
export let rec print_stmt: (Stmt) -> String = (s) -> {
  let prefix: (Bool) -> String = (exported) -> {
    if exported {
      "export "
    } else ""
  }
  match s {
    SLet(exported, is_rec, name, ty_opt, val) => {
      let p = prefix(exported)
      let r = if is_rec {
        "let rec "
      } else "let "
      let t = match ty_opt {
        Some(ty) => String::concat(": ", print_type_expr(ty)),
        None => ""
      }
      String::concat(p, String::concat(r, String::concat(name, String::concat(t, String::concat(" = ", print_annotated_let_value(ty_opt, val))))))
    },
    SLetMut(name, ty_opt, val) => {
      let t = match ty_opt {
        Some(ty) => String::concat(": ", print_type_expr(ty)),
        None => ""
      }
      String::concat("let mut ", String::concat(name, String::concat(t, String::concat(" = ", print_expr(val)))))
    },
    SEnum(exported, name, _, ctors) => String::concat(prefix(exported), String::concat("enum ", String::concat(name, String::concat(" { ", String::concat(print_ctor_list(ctors), " }"))))),
    SSuberror(exported, name, ctors) => {
      let p = prefix(exported)
      if Array::length(ctors) == 1 {
        let (ctor_name, ctor_args) = Array::get(ctors, 0)
        if ctor_name == name {
          let parts = for arg in ctor_args {
            print_type_expr(arg)
          }
          String::concat(p, String::concat("suberror ", String::concat(name, String::concat("(", String::concat(join(parts, ", "), ")")))))
        }
        else String::concat(p, String::concat("suberror ", String::concat(name, String::concat(" { ", String::concat(print_ctor_list(ctors), " }")))))
      } else String::concat(p, String::concat("suberror ", String::concat(name, String::concat(" { ", String::concat(print_ctor_list(ctors), " }")))))
    },
    SStruct(exported, name, fields, derives, mut_names) => {
      let parts = for field in fields {
        let (fn1, ty) = field
        let mut is_mut = false
        let mut mi = 0
        while mi < Array::length(mut_names) {
          if Array::get(mut_names, mi) == fn1 {
            is_mut = true
          }
          mi = mi + 1
        }
        let mp = if is_mut {
          "mut "
        } else {
          ""
        }
        String::concat(mp, String::concat(fn1, String::concat(": ", print_type_expr(ty))))
      }
      let base = String::concat(prefix(exported), String::concat("struct ", String::concat(name, String::concat(" { ", String::concat(join(parts, "; "), " }")))))
      if Array::length(derives) == 0 {
        base
      } else {
        String::concat(base, String::concat(" derive(", String::concat(join(derives, ", "), ")")))
      }
    },
    STypeAlias(exported, name, _, ty) => String::concat(prefix(exported), String::concat("type ", String::concat(name, String::concat(" = ", print_type_expr(ty))))),
    STrait(exported, name, supers, methods) => {
      let base = String::concat(prefix(exported), String::concat("trait ", name))
      let head = if Array::length(supers) == 0 {
        base
      }
      else String::concat(base, String::concat(": ", join(supers, " + ")))
      if Array::length(methods) == 0 {
        head
      } else {
        let method_parts = for m in methods {
          let (method_name, params, ret) = m
          let params_str = if Array::length(params) > 0 {
            String::concat("(", String::concat(join(for pt in params {
              print_type_expr(pt)
            }, ", "), ")"))
          } else ""
          String::concat("  ", String::concat(method_name, String::concat(params_str, String::concat(" -> ", print_type_expr(ret)))))
        }
        String::concat(head, String::concat(" {\n", String::concat(join(method_parts, ";\n"), "\n}")))
      }
    },
    SImpl(tparams, _, trait_name, type_name) => {
      let head = if Array::length(tparams) == 0 {
        "impl "
      } else {
        String::concat("impl [", String::concat(join(tparams, ", "), "] "))
      }
      String::concat(head, String::concat(trait_name, String::concat(" for ", type_name)))
    },
    SExternLet(name, ty) => String::concat("extern let ", String::concat(name, String::concat(": ", print_type_expr(ty)))),
    SImport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => String::concat(name, String::concat(" as ", a)),
          None => name
        }
      }
      String::concat("import ", String::concat(path, String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    STest(name, body) => String::concat("test \"", String::concat(name, String::concat("\" { ", String::concat(print_expr(body), " }")))),
    SBench(name, body) => String::concat("bench \"", String::concat(name, String::concat("\" { ", String::concat(print_expr(body), " }")))),
    SExpr(e) => print_expr(e),
    SExport(names) => String::concat("export { ", String::concat(join(names, ", "), " }")),
    SReExport(path, items) => {
      let parts = for item in items {
        let (name, alias) = item
        match alias {
          Some(a) => String::concat(name, String::concat(" as ", a)),
          None => name
        }
      }
      String::concat("export ", String::concat(path, String::concat(" { ", String::concat(join(parts, ", "), " }"))))
    },
    SAliasDecl(alias_name, source_path) => String::concat("import ", String::concat(source_path, String::concat(" @", alias_name))),
    SLetPat(pat, expr) => String::concat("let ", String::concat(print_pat(pat), String::concat(" = ", print_expr(expr)))),
    SModule(exported, name, stmts) => {
      let parts = for s in stmts {
        print_stmt(s)
      }
      let p = if exported {
        "export "
      } else ""
      String::concat(p, String::concat("module ", String::concat(name, String::concat(" { ", String::concat(join(parts, "\n"), " }")))))
    },
    SEffectDef(exported, name, type_params, ops) => {
      let p = if exported {
        "export "
      } else ""
      let tp = if Array::length(type_params) > 0 {
        String::concat("[", String::concat(join(type_params, ", "), "]"))
      } else ""
      let op_parts = for op in ops {
        let (op_name, params, ret) = op
        let params_str = if Array::length(params) > 0 {
          String::concat("(", String::concat(join(for pt in params {
            print_type_expr(pt)
          }, ", "), ")"))
        } else ""
        String::concat("  ", String::concat(op_name, String::concat(params_str, String::concat(" -> ", print_type_expr(ret)))))
      }
      String::concat(p, String::concat("effect ", String::concat(name, String::concat(tp, String::concat(" {\n", String::concat(join(op_parts, ";\n"), "\n}"))))))
    }
  }
}
export let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {
  let lexed = lex_with_offsets(source)
  let tokens = lexed.0
  let starts = lexed.1
  let ends = lexed.2
  let parsed = parse_program_spans(tokens, starts, ends)
  let stmts = parsed.0
  let span_start = parsed.1
  let span_end = parsed.2
  let keep = dce_keep_flags(stmts, [entry_name])
  let buf = StringBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    if Array::get(keep, i) {
      let s = Array::get(span_start, i)
      let e = Array::get(span_end, i)
      if e > s {
        let snippet = String::substring(source, s, e)
        StringBuilder::push(buf, snippet)
        let n = String::length(snippet)
        if n == 0 || String::char_code_at(snippet, n - 1) != '\n' {
          StringBuilder::push(buf, "\n")
        }
      }
    }
    i = i + 1
  }
  StringBuilder::freeze(buf)
}
export let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {
  let lexed = lex_with_offsets(source)
  let tokens = lexed.0
  let starts = lexed.1
  let ends = lexed.2
  let parsed = parse_program_spans(tokens, starts, ends)
  let stmts = parsed.0
  let span_start = parsed.1
  let buf = StringBuilder::new()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let entry = match stmt {
      SLet(_, _, name, _, expr) => match expr {
        EFn(_, _, _, _, _, _) => {
          let off = Array::get(span_start, i)
          let lc = offset_to_line_col(source, off)
          let line = lc.0
          String::concat(name, String::concat("\t", String::concat(__to_string(line), "\n")))
        },
        _ => ""
      },
      _ => ""
    }
    StringBuilder::push(buf, entry)
    i = i + 1
  }
  StringBuilder::freeze(buf)
}
let empty_aliases: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}
let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}
let empty_import_refs: () -> Array[(String, String, String)] = () -> {
  Array::slice([
    ("", "", "")
  ], 0, 0)
}
let string_array_contains: (Array[String], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
let import_ref_array_contains_local: (Array[(String, String, String)], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let (_, _, local) = Array::get(items, i)
    if local == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
let import_ref_has_other_path_for_original: (Array[(String, String, String)], String, String) -> Bool = (items, raw_path, original) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    let (other_path, other_original, _) = Array::get(items, i)
    if other_original == original && other_path != raw_path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
let lookup_alias: (Array[(String, String)], String) -> Option[String] = (aliases, name) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if alias == name {
      found = Some(original)
      i = Array::length(aliases)
    } else {
      i = i + 1
    }
  }
  found
}
let alias_map_without_name: (Array[(String, String)], String) -> Array[(String, String)] = (aliases, name) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if alias != name {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}
let alias_map_without_names: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (aliases, names) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if !string_array_contains(names, alias) {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}
let rec pat_binds_name: (Pat, String) -> Bool = (pat, name) -> {
  match pat {
    PBind(bound) => bound == name,
    PCtor(_, pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_name(Array::get(pats, i), name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    PTuple(pats) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(pats) && !found {
        if pat_binds_name(Array::get(pats, i), name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),
    PStruct(_, fields) => {
      let mut found = false
      let mut i = 0
      while i < Array::length(fields) && !found {
        let (_, field_pat) = Array::get(fields, i)
        if pat_binds_name(field_pat, name) {
          found = true
        } else {
          i = i + 1
        }
      }
      found
    },
    _ => false
  }
}
let alias_map_without_pat: (Array[(String, String)], Pat) -> Array[(String, String)] = (aliases, pat) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if !pat_binds_name(pat, alias) {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}
let param_binds_name: (Array[(String, Option[TypeExpr])], String) -> Bool = (params, name) -> {
  let mut found = false
  let mut i = 0
  while i < Array::length(params) && !found {
    let (param_name, _) = Array::get(params, i)
    if param_name == name {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
let alias_map_without_params: (Array[(String, String)], Array[(String, Option[TypeExpr])]) -> Array[(String, String)] = (aliases, params) -> {
  let out = empty_aliases()
  let mut i = 0
  while i < Array::length(aliases) {
    let (alias, original) = Array::get(aliases, i)
    if !param_binds_name(params, alias) {
      Array::push(out, (alias, original))
    }
    i = i + 1
  }
  out
}
export let rec rewrite_import_alias_expr: (Expr, Array[(String, String)]) -> Expr = (expr, aliases) -> {
  match expr {
    EIdent(name, _) => match lookup_alias(aliases, name) {
      Some(original) => EIdent(original, -1),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_import_alias_expr(item, aliases)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_import_alias_expr(item, aliases)
    }),
    ERecord(fields) => ERecord(for field in fields {
      let (name, value) = field
      (name, rewrite_import_alias_expr(value, aliases))
    }),
    EIf(cond, then_expr, else_expr) => EIf(
      rewrite_import_alias_expr(cond, aliases),
      rewrite_import_alias_expr(then_expr, aliases),
      rewrite_import_alias_expr(else_expr, aliases)
    ),
    ELet(name, value, body) => ELet(
      name,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    ELetRec(name, value, body) => {
      let body_aliases = alias_map_without_name(aliases, name)
      ELetRec(
        name,
        rewrite_import_alias_expr(value, body_aliases),
        rewrite_import_alias_expr(body, body_aliases)
      )
    },
    ELetMut(name, value, body) => ELetMut(
      name,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    EAssign(name, value, body) => EAssign(
      name,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, aliases)
    ),
    EAssignOp(name, op, value, body) => EAssignOp(
      name,
      op,
      rewrite_import_alias_expr(value, aliases),
      rewrite_import_alias_expr(body, aliases)
    ),
    ESeq(left, right) => ESeq(
      rewrite_import_alias_expr(left, aliases),
      rewrite_import_alias_expr(right, aliases)
    ),
    EMatch(scrutinee, arms) => EMatch(rewrite_import_alias_expr(scrutinee, aliases), for arm in arms {
      let (pat, body) = arm
      (pat, rewrite_import_alias_expr(body, alias_map_without_pat(aliases, pat)))
    }),
    EHandle(body, arms) => EHandle(rewrite_import_alias_expr(body, aliases), for arm in arms {
      let (pat, arm_body) = arm
      (pat, rewrite_import_alias_expr(arm_body, alias_map_without_pat(aliases, pat)))
    }),
    EWhile(cond, body) => EWhile(
      rewrite_import_alias_expr(cond, aliases),
      rewrite_import_alias_expr(body, aliases)
    ),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_import_alias_expr(init, aliases))
      }
      let mut body_aliases = aliases
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        body_aliases = alias_map_without_name(body_aliases, name)
        i = i + 1
      }
      ELoop(out_params, rewrite_import_alias_expr(body, body_aliases))
    },
    EForIn(name, index_name, iter, body) => {
      let body_aliases = match index_name {
        Some(index_name) => alias_map_without_name(alias_map_without_name(aliases, name), index_name),
        None => alias_map_without_name(aliases, name)
      }
      EForIn(
        name,
        index_name,
        rewrite_import_alias_expr(iter, aliases),
        rewrite_import_alias_expr(body, body_aliases)
      )
    },
    ECall(callee, args, off) => ECall(rewrite_import_alias_expr(callee, aliases), for arg in args {
      rewrite_import_alias_expr(arg, aliases)
    }, off),
    EBinOp(op, left, right) => EBinOp(
      op,
      rewrite_import_alias_expr(left, aliases),
      rewrite_import_alias_expr(right, aliases)
    ),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_import_alias_expr(value, aliases)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(
      type_params,
      bounds,
      params,
      ret_ty,
      effect,
      rewrite_import_alias_expr(body, alias_map_without_params(aliases, params))
    ),
    EDot(obj, field, off) => EDot(rewrite_import_alias_expr(obj, aliases), field, off),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_import_alias_expr(body, aliases)),
    EThrow(value) => EThrow(rewrite_import_alias_expr(value, aliases)),
    EReturn(value) => EReturn(rewrite_import_alias_expr(value, aliases)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_import_alias_expr(value, aliases))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_import_alias_expr(value, aliases)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_import_alias_expr(value, aliases))
    }),
    ESpread(value) => ESpread(rewrite_import_alias_expr(value, aliases)),
    _ => expr
  }
}
export let collect_import_aliases: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {
  let aliases = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(_, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let (original, alias_opt) = Array::get(items, j)
          match alias_opt {
            Some(alias) => if alias != original {
              Array::push(aliases, (alias, original))
            },
            None => ()
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  aliases
}
let collect_import_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {
  let refs = empty_import_refs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, items) => {
        let mut j = 0
        while j < Array::length(items) {
          let (original, alias_opt) = Array::get(items, j)
          let local = match alias_opt {
            Some(alias) => alias,
            None => original
          }
          Array::push(refs, (raw_path, original, local))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  refs
}
export let collect_import_alias_collision_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {
  let refs = collect_import_refs(stmts)
  let out = empty_import_refs()
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {
      Array::push(out, (raw_path, original, local))
    }
    i = i + 1
  }
  out
}
export let collect_import_alias_collision_locals: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let refs = collect_import_alias_collision_refs(stmts)
  let out = empty_strings()
  let mut i = 0
  while i < Array::length(refs) {
    let (_, _, local) = Array::get(refs, i)
    if !string_array_contains(out, local) {
      Array::push(out, local)
    }
    i = i + 1
  }
  out
}
export let rec rewrite_import_alias_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, aliases) -> {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(
      exported,
      is_rec,
      name,
      ty,
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    SLetMut(name, ty, body) => SLetMut(
      name,
      ty,
      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))
    ),
    STest(name, body) => STest(name, rewrite_import_alias_expr(body, aliases)),
    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, aliases)),
    SExpr(body) => SExpr(rewrite_import_alias_expr(body, aliases)),
    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, aliases)),
    SModule(exported, name, stmts) => {
      let module_aliases = collect_import_aliases(stmts)
      SModule(exported, name, for inner_stmt in stmts {
        rewrite_import_alias_stmt(inner_stmt, module_aliases)
      })
    },
    _ => stmt
  }
}
export let rec stmts_have_import_deep: (Array[Stmt]) -> Bool = (stmts) -> {
  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {
    match stmt {
      SImport(_, _) => true,
      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),
      _ => false
    }
  }
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) && !found {
    if stmt_has_import_deep(Array::get(stmts, i)) {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
export let append_non_import_stmts_without_alias_rewrite: (Array[Stmt], Array[Stmt]) -> Unit = (merged, stmts) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(merged, stmt)
    }
    i = i + 1
  }
}
export let append_import_alias_rewritten_non_import_stmts_skipping: (Array[Stmt], Array[Stmt], Array[String]) -> Unit = (merged, stmts, skipped_locals) -> {
  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)
  let should_rewrite = Array::length(aliases) > 0
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    match stmt {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, aliases)),
      _ => if should_rewrite {
        Array::push(merged, rewrite_import_alias_stmt(stmt, aliases))
      } else {
        Array::push(merged, stmt)
      }
    }
    i = i + 1
  }
}
export let rewrite_imported_value_stmt_to_local: (Stmt, String, String) -> Option[Stmt] = (stmt, original, local) -> {
  let aliases = Array::slice([
    (original, local)
  ], 0, 1)
  let rewrite_value: (Expr) -> Expr = (expr) -> {
    if original == local {
      expr
    } else {
      rewrite_import_alias_expr(expr, aliases)
    }
  }
  match stmt {
    SLet(_, is_rec, name, ty, body) => if name == original {
      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))
    } else {
      None
    },
    SLetMut(name, ty, body) => if name == original {
      Some(SLetMut(local, ty, rewrite_value(body)))
    } else {
      None
    },
    _ => None
  }
}
let sanitize_namespace_char: (Int) -> String = (code) -> {
  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {
    String::from_char_code(code)
  } else {
    "_"
  }
}
let sanitize_namespace_path: (String) -> String = (path) -> {
  let mut out = ""
  let mut i = 0
  while i < String::length(path) {
    out = String::concat(out, sanitize_namespace_char(String::char_code_at(path, i)))
    i = i + 1
  }
  out
}
let namespace_private_name_with_suffix: (String, String) -> String = (namespace_suffix, name) -> {
  String::concat(name, String::concat("_dep_", namespace_suffix))
}
let namespace_private_name_lazy: (String, String, Array[String]) -> String = (path, name, suffix_box) -> {
  let current = Array::get(suffix_box, 0)
  let suffix = if String::length(current) == 0 {
    let sanitized = sanitize_namespace_path(path)
    Array::set(suffix_box, 0, sanitized)
    sanitized
  } else {
    current
  }
  namespace_private_name_with_suffix(suffix, name)
}
let collect_exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {
        Array::push(names, name)
      },
      SExport(items) => {
        let mut j = 0
        while j < Array::length(items) {
          let name = Array::get(items, j)
          if !string_array_contains(names, name) {
            Array::push(names, name)
          }
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  names
}
let collect_exported_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let names = empty_strings()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SStruct(true, name, _, _, _) => Array::push(names, name),
      SEnum(true, name, _, _) => Array::push(names, name),
      STrait(true, name, _, _) => Array::push(names, name),
      STypeAlias(true, name, _, _) => Array::push(names, name),
      SSuberror(true, name, _) => Array::push(names, name),
      _ => ()
    }
    i = i + 1
  }
  names
}
let qualified_method_of_exported_type: (String, Array[String]) -> Bool = (name, exported_types) -> {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    false
  } else {
    let head = String::substring(name, 0, idx)
    string_array_contains(exported_types, head)
  }
}
let collect_private_value_renames: (String, Array[Stmt], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, namespace_suffix_box, exported) -> {
  let renames = empty_aliases()
  let exported_types = collect_exported_type_names(stmts)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      SLetMut(name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}
let rec rewrite_private_type_expr: (TypeExpr, Array[(String, String)]) -> TypeExpr = (ty, renames) -> {
  match ty {
    TyName(name) => match lookup_alias(renames, name) {
      Some(renamed) => TyName(renamed),
      None => ty
    },
    TyApp(name, args) => {
      let next_name = match lookup_alias(renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      TyApp(next_name, for arg in args {
        rewrite_private_type_expr(arg, renames)
      })
    },
    TyFn(params, ret, effect_name) => TyFn(
      for param in params {
        rewrite_private_type_expr(param, renames)
      },
      rewrite_private_type_expr(ret, renames),
      effect_name
    ),
    TyTuple(items) => TyTuple(for item in items {
      rewrite_private_type_expr(item, renames)
    }),
    TyUnit => ty
  }
}
let rewrite_private_type_opt: (Option[TypeExpr], Array[(String, String)]) -> Option[TypeExpr] = (ty, renames) -> {
  match ty {
    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),
    None => None
  }
}
let rewrite_private_params: (Array[(String, Option[TypeExpr])], Array[(String, String)]) -> Array[(String, Option[TypeExpr])] = (params, type_renames) -> {
  for param in params {
    let (name, ty) = param
    (name, rewrite_private_type_opt(ty, type_renames))
  }
}
let rec rewrite_private_type_ctor_pat: (Pat, Array[(String, String)], Array[(String, String)]) -> Pat = (pat, type_renames, ctor_renames) -> {
  match pat {
    PCtor(name, pats) => {
      let next_name = match lookup_alias(ctor_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PCtor(next_name, for item in pats {
        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
      })
    },
    PTuple(pats) => PTuple(for item in pats {
      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)
    }),
    POr(left, right) => POr(
      rewrite_private_type_ctor_pat(left, type_renames, ctor_renames),
      rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)
    ),
    PStruct(name, fields) => {
      let next_name = match lookup_alias(type_renames, name) {
        Some(renamed) => renamed,
        None => name
      }
      PStruct(next_name, for field in fields {
        let (field_name, field_pat) = field
        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))
      })
    },
    _ => pat
  }
}
let rec rewrite_private_type_ctor_expr: (Expr, Array[(String, String)], Array[(String, String)]) -> Expr = (expr, type_renames, ctor_renames) -> {
  match expr {
    EIdent(name, _) => match lookup_alias(ctor_renames, name) {
      Some(renamed) => EIdent(renamed, -1),
      None => expr
    },
    ETuple(items) => ETuple(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    EArray(items) => EArray(for item in items {
      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)
    }),
    ERecord(fields) => ERecord(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
    }),
    EIf(cond, then_expr, else_expr) => EIf(
      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)
    ),
    ELet(name, value, body) => ELet(
      name,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
    ),
    ELetRec(name, value, body) => {
      let body_ctors = alias_map_without_name(ctor_renames, name)
      ELetRec(
        name,
        rewrite_private_type_ctor_expr(value, type_renames, body_ctors),
        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)
      )
    },
    ELetMut(name, value, body) => ELetMut(
      name,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
    ),
    EAssign(name, value, body) => EAssign(
      name,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)
    ),
    EAssignOp(name, op, value, body) => EAssignOp(
      name,
      op,
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)
    ),
    ESeq(left, right) => ESeq(
      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)
    ),
    EMatch(scrutinee, arms) => EMatch(
      rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames),
      for arm in arms {
        let (pat, body) = arm
        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
        (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
      }
    ),
    EHandle(body, arms) => EHandle(
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames),
      for arm in arms {
        let (pat, arm_body) = arm
        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
        (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
      }
    ),
    EWhile(cond, body) => EWhile(
      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)
    ),
    ELoop(params, body) => {
      let out_params = for param in params {
        let (name, init) = param
        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))
      }
      let mut body_ctors = ctor_renames
      let mut i = 0
      while i < Array::length(params) {
        let (name, _) = Array::get(params, i)
        body_ctors = alias_map_without_name(body_ctors, name)
        i = i + 1
      }
      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))
    },
    EForIn(name, index_name, iter, body) => {
      let body_ctors = match index_name {
        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),
        None => alias_map_without_name(ctor_renames, name)
      }
      EForIn(
        name,
        index_name,
        rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames),
        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)
      )
    },
    ECall(callee, args, off) => ECall(
      rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames),
      for arg in args {
        rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)
      },
      off
    ),
    EBinOp(op, left, right) => EBinOp(
      op,
      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),
      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)
    ),
    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(
      type_params,
      bounds,
      rewrite_private_params(params, type_renames),
      rewrite_private_type_opt(ret_ty, type_renames),
      effect,
      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))
    ),
    EDot(obj, field, off) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off),
    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
    EThrow(value) => EThrow(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    EBreak(value) => match value {
      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),
      None => expr
    },
    EContinue(values) => EContinue(for value in values {
      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)
    }),
    EMap(fields) => EMap(for field in fields {
      let (name, value) = field
      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))
    }),
    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),
    _ => expr
  }
}
let collect_private_type_renames: (String, Array[Stmt], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, namespace_suffix_box, exported) -> {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      SStruct(false, name, _, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      SSuberror(false, name, _) => if !string_array_contains(exported, name) {
        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))
      },
      _ => ()
    }
    i = i + 1
  }
  renames
}
let collect_private_ctor_renames: (String, Array[Stmt], Array[(String, String)], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, type_renames, namespace_suffix_box, exported) -> {
  let renames = empty_aliases()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SEnum(false, type_name, _, ctors) => if !string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))
          j = j + 1
        }
      },
      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {
        let mut j = 0
        while j < Array::length(ctors) {
          let (ctor_name, _) = Array::get(ctors, j)
          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  type_renames
  renames
}
export let rec namespace_private_value_stmts: (String, Array[Stmt]) -> Array[Stmt] = (path, stmts) -> {
  let namespace_private_type_ctor_stmt_local: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {
    match stmt {
      SLet(exported, is_rec, name, ty, body) => SLet(
        exported,
        is_rec,
        name,
        rewrite_private_type_opt(ty, type_renames),
        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
      ),
      SLetMut(name, ty, body) => SLetMut(
        name,
        rewrite_private_type_opt(ty, type_renames),
        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))
      ),
      SEnum(exported, name, params, ctors) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        SEnum(exported, next_name, params, for ctor in ctors {
          let (ctor_name, args) = ctor
          let next_ctor = if exported {
            ctor_name
          } else {
            match lookup_alias(ctor_renames, ctor_name) {
              Some(renamed) => renamed,
              None => ctor_name
            }
          }
          (next_ctor, for arg in args {
            rewrite_private_type_expr(arg, type_renames)
          })
        })
      },
      SSuberror(exported, name, ctors) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        SSuberror(exported, next_name, for ctor in ctors {
          let (ctor_name, args) = ctor
          let next_ctor = if exported {
            ctor_name
          } else {
            match lookup_alias(ctor_renames, ctor_name) {
              Some(renamed) => renamed,
              None => ctor_name
            }
          }
          (next_ctor, for arg in args {
            rewrite_private_type_expr(arg, type_renames)
          })
        })
      },
      SStruct(exported, name, fields, derives, mut_fields) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        SStruct(exported, next_name, for field in fields {
          let (field_name, field_ty) = field
          (field_name, rewrite_private_type_expr(field_ty, type_renames))
        }, derives, mut_fields)
      },
      STypeAlias(exported, name, params, target) => {
        let next_name = if exported {
          name
        } else {
          match lookup_alias(type_renames, name) {
            Some(renamed) => renamed,
            None => name
          }
        }
        STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))
      },
      SImpl(tparams, bounds, trait_name, target_name) => {
        let next_target = match lookup_alias(type_renames, target_name) {
          Some(renamed) => renamed,
          None => target_name
        }
        SImpl(tparams, bounds, trait_name, next_target)
      },
      SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),
      STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
      SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
      SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),
      SLetPat(pat, body) => {
        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)
        SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))
      },
      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),
      SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {
        let (op_name, op_params, ret_ty) = op
        (op_name, for param in op_params {
          rewrite_private_type_expr(param, type_renames)
        }, rewrite_private_type_expr(ret_ty, type_renames))
      }),
      _ => stmt
    }
  }
  let namespace_private_stmt_local: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {
    match stmt {
      SLet(exported, is_rec, name, ty, body) => {
        let next_name = match lookup_alias(renames, name) {
          Some(renamed) => renamed,
          None => name
        }
        SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))
      },
      SLetMut(name, ty, body) => {
        let next_name = match lookup_alias(renames, name) {
          Some(renamed) => renamed,
          None => name
        }
        SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))
      },
      STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),
      SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),
      SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),
      SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),
      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),
      _ => stmt
    }
  }
  let namespace_suffix_box = [""]
  let exported = collect_exported_value_names(stmts)
  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)
  let value_renamed = if Array::length(renames) == 0 {
    stmts
  } else {
    for stmt in stmts {
      namespace_private_stmt_local(stmt, renames)
    }
  }
  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)
  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)
  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {
    value_renamed
  } else {
    for stmt in value_renamed {
      namespace_private_type_ctor_stmt_local(stmt, type_renames, ctor_renames)
    }
  }
}
export let compile_wasi_module: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_impl(stmts, entry_name)
}
export let compile_wasi_module_coverage: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_coverage_impl(stmts, entry_name)
}
export let compile_wasi_module_trace: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {
  compile_wasi_module_trace_impl(stmts, entry_name)
}
export let compile_wasi_module_break: (Array[Stmt], String, DbgProv) -> Bytes with { Error } = (stmts, entry_name, prov) -> {
  compile_wasi_module_break_impl(stmts, entry_name, prov)
}
export let contains_str: (Array[String], String) -> Bool = (arr, target) -> {
  let rec go: (Int) -> Bool = (i) -> {
    if i >= Array::length(arr) {
      false
    }
    else {
      if Array::get(arr, i) == target {
        true
      }
      else {
        go(i + 1)
      }
    }
  }
  go(0)
}
export let collect_exports: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let out = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(true, _, name, _, _) => Array::push(out, name),
      SEnum(true, _, _, variants) => {
        let mut j = 0
        while j < Array::length(variants) {
          let (cname, _) = Array::get(variants, j)
          Array::push(out, cname)
          j = j + 1
        }
      },
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          Array::push(out, Array::get(names, j))
          j = j + 1
        }
      },
      SReExport(_, names) => {
        let mut j = 0
        while j < Array::length(names) {
          let (name, _) = Array::get(names, j)
          Array::push(out, name)
          j = j + 1
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
let has_prefix: (String, String) -> Bool = (line, prefix) -> {
  let prefix_len = String::length(prefix)
  if String::length(line) < prefix_len {
    false
  } else {
    let mut ok = true
    let mut i = 0
    while ok && i < prefix_len {
      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)
      i = i + 1
    }
    ok
  }
}
let strip_trailing_cr: (String) -> String = (line) -> {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0: len - 1]
    } else {
      line
    }
  } else {
    line
  }
}
let parse_persistent_module_header_line: (Array[String], Array[String], String, Bool) -> Bool with { Error } = (deps, exports, line, saw_version) -> {
  if String::length(line) == 0 {
    saw_version
  } else if has_prefix(line, "version\t") {
    let value = line[8: String::length(line)]
    if !(value == "1") {
      throw("invalid persistent module header version")
    }
    true
  } else if has_prefix(line, "dep\t") {
    let value = line[4: String::length(line)]
    if String::length(value) == 0 {
      throw("invalid persistent module header dep row")
    } else {
      Array::push(deps, value)
      saw_version
    }
  } else if has_prefix(line, "export\t") {
    let value = line[7: String::length(line)]
    if String::length(value) == 0 {
      throw("invalid persistent module header export row")
    } else {
      Array::push(exports, value)
      saw_version
    }
  } else {
    throw(String::concat("invalid persistent module header row: ", line))
  }
}
export let persistent_module_header_text: (Array[String], Array[String]) -> String = (deps, exports) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "version\t1\n")
  let mut i = 0
  while i < Array::length(deps) {
    StringBuilder::push(buf, "dep\t")
    StringBuilder::push(buf, Array::get(deps, i))
    StringBuilder::push(buf, "\n")
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(exports) {
    StringBuilder::push(buf, "export\t")
    StringBuilder::push(buf, Array::get(exports, j))
    StringBuilder::push(buf, "\n")
    j = j + 1
  }
  StringBuilder::freeze(buf)
}
export let parse_persistent_module_header_text: (String) -> (Array[String], Array[String]) with { Error } = (raw) -> {
  let deps = Array::slice([
    ""
  ], 0, 0)
  let exports = Array::slice([
    ""
  ], 0, 0)
  let mut saw_version = false
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  while i < len {
    if String::char_code_at(raw, i) == 10 {
      let line = strip_trailing_cr(raw[line_start: i])
      saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)
      line_start = i + 1
    }
    i = i + 1
  }
  let line = strip_trailing_cr(raw[line_start: len])
  saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)
  if !saw_version {
    throw("missing persistent module header version")
  } else {
    (deps, exports)
  }
}
export let compact_string_fingerprint: (String) -> String = (source) -> {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}
let stable_cache_path: (String, String, String) -> String = (prefix, seed, suffix) -> {
  let raw = compact_string_fingerprint(String::concat("persistent-cache-v10|", seed))
  let mut token = ""
  let mut i = 0
  while i < String::length(raw) {
    let c = String::char_code_at(raw, i)
    let piece = if c == 58 {
      "_"
    } else {
      String::from_char_code(c)
    }
    token = String::concat(token, piece)
    i = i + 1
  }
  String::concat("_build/vibe_", String::concat(prefix, String::concat("_", String::concat(token, suffix))))
}
export let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {
  stable_cache_path("selfhost_dep_list", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}
export let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {
  stable_cache_path("selfhost_type_env_v2", fingerprint, ".tsv")
}
export let normalize_persistent_cache_text: (String) -> String = (text) -> {
  let len = String::length(text)
  let mut start = 0
  while start < len && String::char_code_at(text, start) == 0 {
    start = start + 1
  }
  if start == 0 {
    text
  } else {
    text[start: len]
  }
}
export let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {
  stable_cache_path("selfhost_source_list", entry_path, ".tsv")
}
export let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {
  stable_cache_path("selfhost_source_groups", entry_path, ".tsv")
}
export let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {
  stable_cache_path("selfhost_module_header_v2", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}
export let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {
  stable_cache_path("selfhost_manifest_headers", entry_path, ".tsv")
}
export let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {
  stable_cache_path("selfhost_leaf_fp_v2", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}
export let dir_of_path: (String) -> String = (file_path) -> {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else if idx == 0 {
    "/"
  } else {
    file_path[0: idx]
  }
}
export let contains_path: (Array[String], String) -> Bool = (visited, path) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(visited) && !found {
    if Array::get(visited, i) == path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
export let normalize_path: (String) -> String = (path) -> {
  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47
  let mut parts = Array::slice([
    ""
  ], 0, 0)
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_sep = if i == len {
      true
    } else {
      String::char_code_at(path, i) == 47
    }
    if at_sep {
      let part = path[start: i]
      let skip_part = if String::length(part) == 0 {
        true
      } else {
        part == "."
      }
      if skip_part {
        ()
      } else if part == ".." {
        if Array::length(parts) > 0 {
          Array::truncate(parts, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  let buf = StringBuilder::new()
  if is_absolute {
    StringBuilder::push(buf, "/")
  }
  let mut pi = 0
  while pi < Array::length(parts) {
    if pi > 0 {
      StringBuilder::push(buf, "/")
    }
    StringBuilder::push(buf, Array::get(parts, pi))
    pi = pi + 1
  }
  StringBuilder::freeze(buf)
}
let join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {
  if base_dir == "" || base_dir == "/" {
    String::concat(base_dir, raw_path)
  } else {
    String::concat(base_dir, String::concat("/", raw_path))
  }
}
export let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {
  if len >= 2 {
    if raw_path[0: 2] == "./" {
      true
    } else if len >= 3 {
      raw_path[0: 3] == "../"
    } else {
      false
    }
  } else {
    false
  }
}
export let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    normalized
  } else {
    String::concat(normalized, ".vibe")
  }
}
export let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    join_relative_path(base_dir, raw_path)
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    [
      normalized
    ]
  } else {
    [
      String::concat(normalized, ".vibe"),
      String::concat(normalized, "/index.vibe")
    ]
  }
}
let resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  while i < Array::length(candidates) {
    if found == "" {
      let candidate = Array::get(candidates, i)
      if Fs::exists(candidate) {
        found = candidate
      }
    }
    i = i + 1
  }
  if found == "" {
    Array::get(candidates, 0)
  } else {
    found
  }
}
let special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {
  if String::ends_with(path, "selfhost_sources_bundle.vibe") {
    Some((Array::slice([
      ""
    ], 0, 0), [
      "selfhost_sources",
      "selfhost_source_groups"
    ]))
  } else if String::ends_with(path, "selfhost_cli_adapter_bundle.vibe") {
    Some((Array::slice([
      ""
    ], 0, 0), [
      "selfhost_cli_adapter_sources",
      "selfhost_cli_adapter_source_groups",
      "selfhost_cli_adapter_ordered_sources",
      "selfhost_cli_adapter_merged_source",
      "selfhost_cli_adapter_module_source"
    ]))
  } else if String::ends_with(path, "selfbuild_runtime_entry_bundle.vibe") {
    Some((Array::slice([
      ""
    ], 0, 0), [
      "selfbuild_runtime_entry_source"
    ]))
  } else {
    None
  }
}
let collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {
  let deps = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      _ => ()
    }
    i = i + 1
  }
  deps
}
export let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {
  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))
  if Fs::exists(cache_path) {
    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    (parsed.0, parsed.1, parse_count)
  } else {
    let header_result = match special_bundle_header(path) {
      Some((deps, exports)) => (deps, exports, parse_count),
      None => {
        let (tokens, starts, _ends) = lex_with_offsets(source)
        let stmts = handle {
          parse_program_located(tokens, starts, source)
        } with Error {
          Throw(msg) => throw(String::concat(path, String::concat(": ", msg)))
        }
        (collect_import_deps_from_stmts(stmts, dir_of_path(path)), collect_exports(stmts), parse_count + 1)
      }
    }
    let deps = header_result.0
    let exports = header_result.1
    let next_parse_count = header_result.2
    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))
    (deps, exports, next_parse_count)
  }
}
import . / header_cache.vibe {
  load_or_parse_module_header_fs_impl
}
let join_path: (String, String) -> String = (base_dir, rel_path) -> {
  if base_dir == "" {
    rel_path
  } else {
    String::concat(base_dir, String::concat("/", rel_path))
  }
}
let resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {
  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {
    raw_path
  } else {
    let candidates = resolve_import_path_candidates(base_dir, raw_path)
    let mut i = 0
    let mut found = ""
    while i < Array::length(candidates) {
      if found == "" {
        let candidate = Array::get(candidates, i)
        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {
          found = candidate
        }
      }
      i = i + 1
    }
    if found == "" {
      Array::get(candidates, 0)
    } else {
      found
    }
  }
}
let starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {
  match tok {
    TDot => true,
    _ => false
  }
}
let is_ident_char: (Int) -> Bool = (c) -> {
  (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_'
}
let slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {
  let text_len = String::length(text)
  if start + text_len > String::length(s) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while ok && i < text_len {
      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)
      i = i + 1
    }
    ok
  }
}
let starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {
  let keyword_len = String::length(keyword)
  if !(slice_eq_text(s, pos, keyword)) {
    false
  } else {
    let before_ok = if pos == 0 {
      true
    } else {
      !(is_ident_char(String::char_code_at(s, pos - 1)))
    }
    let after_pos = pos + keyword_len
    let after_ok = if after_pos >= String::length(s) {
      true
    } else {
      !(is_ident_char(String::char_code_at(s, after_pos)))
    }
    before_ok && after_ok
  }
}
let skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {
  let mut pos = start
  let mut done = false
  while !done && pos < len {
    let c = String::char_code_at(s, pos)
    if c == ' ' || c == '\n' || c == '\t' || c == '\r' || c == ';' {
      pos = pos + 1
    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {
      pos = pos + 2
      while pos < len && String::char_code_at(s, pos) != '\n' {
        pos = pos + 1
      }
    } else {
      done = true
    }
  }
  pos
}
let scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {
  let mut pos = start
  let mut brace_depth = 0
  let mut in_string = false
  let mut string_quote = 0
  let mut escape = false
  let mut done = false
  while pos < len && !done {
    let c = String::char_code_at(s, pos)
    if in_string {
      if escape {
        escape = false
      } else if c == '\\' {
        escape = true
      } else if c == string_quote {
        in_string = false
      }
      pos = pos + 1
    } else if c == '"' || c == '\'' {
      in_string = true
      string_quote = c
      pos = pos + 1
    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {
      while pos < len && String::char_code_at(s, pos) != '\n' {
        pos = pos + 1
      }
    } else if c == '{' {
      brace_depth = brace_depth + 1
      pos = pos + 1
    } else if c == '}' {
      if brace_depth > 0 {
        brace_depth = brace_depth - 1
      }
      pos = pos + 1
    } else if brace_depth == 0 && (c == '\n' || c == ';') {
      done = true
    } else {
      pos = pos + 1
    }
  }
  pos
}
let skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLBrace => {
      let mut depth = 1
      let mut i = pos + 1
      while depth > 0 {
        match peek(tokens, i) {
          TLBrace => {
            depth = depth + 1
          },
          TRBrace => {
            depth = depth - 1
          },
          TEof => throw("unterminated brace list in manifest import scanner"),
          _ => ()
        }
        i = i + 1
      }
      i
    }
    _ => throw("expected '{' in manifest import scanner")
  }
}
let scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {
  let (raw_path, next_pos) = match peek(tokens, pos) {
    TIdent(name) =>
      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {
        (name, pos + 1)
      } else {
        collect_import_path(tokens, pos, "")
      },
    _ => collect_import_path(tokens, pos, "")
  }
  let after_path = match peek(tokens, next_pos) {
    TIdent(alias_name) =>
      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {
        next_pos + 1
      } else {
        next_pos
      },
    _ => next_pos
  }
  let end_pos = match peek(tokens, after_path) {
    TLBrace => skip_brace_list(tokens, after_path),
    _ => after_path
  }
  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)
}
let collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {
  let deps = Array::slice([""], 0, 0)
  let base_dir = dir_of_path(path)
  let len = String::length(source)
  let mut pos = 0
  let mut done = false
  while !done {
    pos = skip_header_ws_and_comments(source, len, pos)
    if pos >= len {
      done = true
    } else {
      let is_import = starts_with_keyword_at(source, pos, "import")
      let is_export = starts_with_keyword_at(source, pos, "export")
      if !(is_import || is_export) {
        done = true
      } else {
        let stmt_end = scan_header_stmt_end(source, len, pos)
        let stmt_source = source[pos:stmt_end]
        let tokens = lex(stmt_source)
        let stmt_pos = skip_semi(tokens, 0)
        match peek(tokens, stmt_pos) {
          TImport => {
            let (dep_path, _) = scan_header_import_dep(
              tokens,
              stmt_pos + 1,
              base_dir,
              manifest_path_index
            )
            Array::push(deps, dep_path)
          },
          TExport => {
            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {
              let (dep_path, _) = scan_header_import_dep(
                tokens,
                stmt_pos + 1,
                base_dir,
                manifest_path_index
              )
              Array::push(deps, dep_path)
            }
          },
          _ => {
            done = true
          }
        }
        pos = stmt_end
      }
    }
  }
  deps
}
let collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {
  handle {
    collect_manifest_header_deps_from_source(path, source, manifest_path_index)
  } with Error {
    Throw(err) => throw("manifest header scan failed for " + path + ": " + err)
  }
}
let is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {
  String::ends_with(path, "selfhost_sources_bundle.vibe")
}
let should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {
  if Map::has_key(manifest_path_index, dep_path) {
    true
  } else {
    !(is_manifest_external_terminal_dep(dep_path))
  }
}
let load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {
  handle {
    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)
    deps
  } with Error {
    Throw(err) => throw("module header parse failed for " + path + ": " + err)
  }
}
export let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    MapBuilder::set(builder, path, source)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}
let source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {
  if Map::has_key(source_index, path_key) {
    Some(Map::get(source_index, path_key))
  } else {
    None
  }
}
export let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(paths) {
    MapBuilder::set(builder, Array::get(paths, i), true)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}
let empty_path_index: () -> Map[String, Bool] = () -> {
  let builder = MapBuilder::new()
  MapBuilder::freeze(builder)
}
let build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    MapBuilder::set(builder, join_path(base_dir, rel_path), true)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}
let find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {
  let mut base_dir = dir_of_path(entry_path)
  let mut found = None
  let mut done = false
  loop {
    if done {
      break
    }
    let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
    if Fs::exists(manifest_path) {
      found = Some(base_dir)
      done = true
    } else if base_dir == "" {
      done = true
    } else {
      let parent = dir_of_path(base_dir)
      if parent == base_dir {
        done = true
      } else {
        base_dir = parent
      }
    }
  }
  found
}
let strip_trailing_cr: (String) -> String = (line) -> {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0:len - 1]
    } else {
      line
    }
  } else {
    line
  }
}
let find_char: (String, Int) -> Int = (s, target) -> {
  let len = String::length(s)
  let mut i = 0
  let mut result = -1
  while i < len {
    if String::char_code_at(s, i) == target {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}
let split_tsv_fields: (String) -> Array[String] = (line) -> {
  let fields = Array::slice([""], 0, 0)
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start:i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}
let header_value_separator = String::from_char_code(31)
let join_header_values: (Array[String]) -> String = (values) -> {
  let mut out = ""
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      out = String::concat(out, header_value_separator)
    }
    out = String::concat(out, Array::get(values, i))
    i = i + 1
  }
  out
}
let split_header_values: (String) -> Array[String] = (text) -> {
  let values = Array::slice([""], 0, 0)
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start:i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}
let empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {
  Array::slice([("", "", "", "")], 0, 0)
}
let empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}
let ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == group_name {
      found = Some(sources)
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  match found {
    Some(sources) => sources,
    None => {
      let sources = Array::slice([("", "")], 0, 0)
      Array::push(groups, (group_name, sources))
      sources
    }
  }
}
let build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {
  let groups = empty_grouped_sources()
  let mut last_group_name = ""
  let mut last_group_sources = Array::slice([("", "")], 0, 0)
  let mut has_last_group = false
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    match on_path(path) {
      Some(source) => {
        let bucket = if has_last_group && last_group_name == group_name {
          last_group_sources
        } else {
          let ensured = ensure_grouped_source_bucket(groups, group_name)
          last_group_name = group_name
          last_group_sources = ensured
          has_last_group = true
          ensured
        }
        Array::push(bucket, (path, source))
      },
      None => ()
    }
    i = i + 1
  }
  groups
}
let parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {
  let rows = Array::slice([("", "")], 0, 0)
  let len = String::length(manifest_source)
  let mut line_start = 0
  let mut i = 0
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(manifest_source, i) == 10
    }
    if at_line_end {
      let raw_line = strip_trailing_cr(manifest_source[line_start:i])
      let line_len = String::length(raw_line)
      let has_content = line_len > 0
      let is_comment = if has_content {
        String::char_code_at(raw_line, 0) == 35
      } else {
        false
      }
      if has_content {
        if is_comment {
          ()
        } else {
          let tab_idx = find_char(raw_line, 9)
          let invalid_row = if tab_idx < 0 {
            true
          } else {
            tab_idx + 1 >= line_len
          }
          if invalid_row {
            throw(String::concat("invalid source manifest row: ", raw_line))
          }
          let group = raw_line[0:tab_idx]
          let path = raw_line[tab_idx + 1:line_len]
          Array::push(rows, (group, path))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  rows
}
export let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  match find_manifest_base_dir(entry_path) {
    Some(base_dir) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))
      let mut has_entry = false
      let mut i = 0
      while i < Array::length(rows) {
        let (_, rel_path) = Array::get(rows, i)
        let path = join_path(base_dir, rel_path)
        if path == entry_path {
          has_entry = true
        }
        i = i + 1
      }
      if has_entry {
        Some((base_dir, rows))
      } else {
        None
      }
    },
    None => None
  }
}
export let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {
  let full_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    Array::push(full_sources, (path, Fs::read_file(path)))
    i = i + 1
  }
  full_sources
}
let load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {
  let sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    if Map::has_key(needed_path_index, path) {
      Array::push(sources, (path, Fs::read_file(path)))
    }
    i = i + 1
  }
  sources
}
let load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {
  let groups = empty_grouped_sources()
  let mut last_group_name = ""
  let mut last_group_sources = Array::slice([("", "")], 0, 0)
  let mut has_last_group = false
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    if Map::has_key(needed_path_index, path) {
      let bucket = if has_last_group && last_group_name == group_name {
        last_group_sources
      } else {
        let ensured = ensure_grouped_source_bucket(groups, group_name)
        last_group_name = group_name
        last_group_sources = ensured
        has_last_group = true
        ensured
      }
      Array::push(bucket, (path, Fs::read_file(path)))
    }
    i = i + 1
  }
  groups
}
export let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {
  build_grouped_sources_from_manifest_rows_with_lookup(
    base_dir,
    rows,
    (path: String) -> Option[String] {
      source_lookup_in_index(source_index, path)
    }
  )
}
export let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {
  let source_index = build_manifest_source_index(sources)
  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)
}
let parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_manifest_header_cache_rows()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent manifest header cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent manifest header cache version")
          }
        } else if tag == "manifest" {
          if Array::length(fields) != 4 {
            throw("invalid persistent manifest header cache manifest row")
          }
          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
        } else if tag == "header" {
          if version == 1 {
            if Array::length(fields) != 6 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(
              rows,
              (
                Array::get(fields, 1),
                Array::get(fields, 2),
                Array::get(fields, 3),
                Array::get(fields, 4)
              )
            )
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(
              rows,
              (
                Array::get(fields, 1),
                Array::get(fields, 2),
                Array::get(fields, 3),
                Array::get(fields, 4)
              )
            )
          }
        } else {
          throw(String::concat("invalid persistent manifest header cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}
let matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
    } else {
      false
    }
  }
}
let load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {
  let cache_path = persistent_manifest_header_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_manifest_header_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    let manifest_ok = match manifest {
      Some((cached_path, stat_token_text, source_fingerprint)) =>
        cached_path == manifest_path &&
          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),
      None => false
    }
    if !manifest_ok {
      None
    } else {
      let mut valid = true
      let mut i = 0
      while i < Array::length(rows) {
        if valid {
          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)
          if !(Map::has_key(manifest_path_index, path)) {
            valid = false
          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {
            valid = false
          }
        }
        i = i + 1
      }
      if valid {
        Some(rows)
      } else {
        None
      }
    }
  }
}
let build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {
  let mut out = "version\t2\n"
  out = String::concat(
    out,
    String::concat(
      "manifest\t",
      String::concat(
        manifest_path,
        String::concat(
          "\t",
          String::concat(
            __to_string(Fs::stat_token(manifest_path)),
            String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), "\n"))
          )
        )
      )
    )
  )
  let mut i = 0
  while i < Array::length(rows) {
    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)
    out = String::concat(
      out,
      String::concat(
        "header\t",
        String::concat(
          path,
          String::concat(
            "\t",
            String::concat(
              stat_token_text,
              String::concat(
                "\t",
                String::concat(
                  source_fingerprint,
                  String::concat("\t", String::concat(deps_text, "\n"))
                )
              )
            )
          )
        )
      )
    )
    i = i + 1
  }
  out
}
let store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {
  Fs::write_file(
    persistent_manifest_header_cache_path(entry_path),
    build_persistent_manifest_header_cache_text(manifest_path, rows)
  )
}
let manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(rows) {
    let (row_path, _, _, deps_text) = Array::get(rows, i)
    if row_path == path {
      found = Some(split_header_values(deps_text))
      i = Array::length(rows)
    } else {
      i = i + 1
    }
  }
  found
}
let collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let mut scheduled_set = empty_path_index()
  Array::push(worklist, path)
  scheduled_set = Map::set(scheduled_set, path, true)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    if !(contains_path(visited, current)) {
      Array::push(visited, current)
      let deps = match manifest_header_deps_lookup(rows, current) {
        Some(found) => found,
        None => {
          let source = Fs::read_file(current)
          if Map::has_key(manifest_path_index, current) {
            collect_manifest_header_deps_from_source_with_context(
              current,
              source,
              manifest_path_index
            )
          } else {
            load_or_parse_module_header_deps_with_context(current, source)
          }
        }
      }
      let mut dep_i = 0
      while dep_i < Array::length(deps) {
        let dep_path = Array::get(deps, dep_i)
        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
          !Map::has_key(scheduled_set, dep_path) {
          Array::push(worklist, dep_path)
          scheduled_set = Map::set(scheduled_set, dep_path, true)
          work_len = work_len + 1
        }
        dep_i = dep_i + 1
      }
    }
    work_i = work_i + 1
  }
  visited
}
let collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {
  let rows = empty_manifest_header_cache_rows()
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let mut scheduled_set = empty_path_index()
  Array::push(worklist, path)
  scheduled_set = Map::set(scheduled_set, path, true)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    if !(contains_path(visited, current)) {
      Array::push(visited, current)
      let source = Fs::read_file(current)
      let deps = match manifest_header_deps_lookup(rows, current) {
        Some(found) => found,
        None => {
          let parsed_deps = if Map::has_key(manifest_path_index, current) {
            collect_manifest_header_deps_from_source_with_context(
              current,
              source,
              manifest_path_index
            )
          } else {
            load_or_parse_module_header_deps_with_context(current, source)
          }
          Array::push(
            rows,
            (
              current,
              __to_string(Fs::stat_token(current)),
              compact_string_fingerprint(source),
              join_header_values(parsed_deps)
            )
          )
          parsed_deps
        }
      }
      let mut dep_i = 0
      while dep_i < Array::length(deps) {
        let dep_path = Array::get(deps, dep_i)
        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
          !Map::has_key(scheduled_set, dep_path) {
          Array::push(worklist, dep_path)
          scheduled_set = Map::set(scheduled_set, dep_path, true)
          work_len = work_len + 1
        }
        dep_i = dep_i + 1
      }
    }
    work_i = work_i + 1
  }
  (rows, visited)
}
let load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {
  match load_persistent_manifest_header_cache_if_valid(
    entry_path,
    manifest_path,
    manifest_path_index
  ) {
    Some(cached_rows) => cached_rows,
    None => {
      let (built_rows, _) = collect_needed_paths_and_manifest_headers(
        entry_path,
        manifest_path_index
      )
      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)
      built_rows
    }
  }
}
export let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(
        entry_path,
        manifest_path,
        manifest_path_index
      )
      let needed_paths = collect_needed_paths_from_manifest_headers(
        entry_path,
        manifest_path_index,
        header_rows
      )
      let needed_path_index = build_manifest_path_index(needed_paths)
      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)
      Some((manifest_path, sources))
    },
    None => None
  }
}
export let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(
        entry_path,
        manifest_path,
        manifest_path_index
      )
      let needed_paths = collect_needed_paths_from_manifest_headers(
        entry_path,
        manifest_path_index,
        header_rows
      )
      let needed_path_index = build_manifest_path_index(needed_paths)
      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)
      Some((manifest_path, groups))
    },
    None => None
  }
}
let resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  while i < Array::length(candidates) {
    if found == "" {
      let candidate = Array::get(candidates, i)
      let candidate_exists = perform Fs::Exists(candidate)
      if candidate_exists {
        found = candidate
      }
    }
    i = i + 1
  }
  if found == "" {
    Array::get(candidates, 0)
  } else {
    found
  }
}
let join_path: (String, String) -> String = (base_dir, rel_path) -> {
  if base_dir == "" {
    rel_path
  } else {
    String::concat(base_dir, String::concat("/", rel_path))
  }
}
let strip_trailing_cr: (String) -> String = (line) -> {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0:len - 1]
    } else {
      line
    }
  } else {
    line
  }
}
let special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {
  if String::ends_with(path, "selfhost_sources_bundle.vibe") {
    Some((
      Array::slice([""], 0, 0),
      ["selfhost_sources", "selfhost_source_groups"]
    ))
  } else {
    None
  }
}
let split_tsv_fields: (String) -> Array[String] = (line) -> {
  let fields = Array::slice([""], 0, 0)
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start:i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}
let header_value_separator = String::from_char_code(31)
let join_header_values: (Array[String]) -> String = (values) -> {
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      StringBuilder::push(sb, header_value_separator)
    }
    StringBuilder::push(sb, Array::get(values, i))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}
let split_header_values: (String) -> Array[String] = (text) -> {
  let values = Array::slice([""], 0, 0)
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start:i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}
let empty_source_specs: () -> Array[(String, String)] = () -> {
  Array::slice([("", "")], 0, 0)
}
let copy_source_specs: (Array[(String, String)]) -> Array[(String, String)] = (sources) -> {
  let out = empty_source_specs()
  let mut i = 0
  while i < Array::length(sources) {
    Array::push(out, Array::get(sources, i))
    i = i + 1
  }
  out
}
let empty_source_cache_specs: () -> Array[(String, String, String)] = () -> {
  Array::slice([("", "", "")], 0, 0)
}
let empty_group_cache_specs: () -> Array[(String, String, String, String)] = () -> {
  Array::slice([("", "", "", "")], 0, 0)
}
let empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}
let push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {
  let group_count = Array::length(groups)
  let handled_by_tail = if group_count > 0 {
    let (last_name, last_sources) = Array::get(groups, group_count - 1)
    if last_name == group_name {
      Array::push(last_sources, (path, source))
      true
    } else {
      false
    }
  } else {
    false
  }
  if !handled_by_tail {
    let mut i = 0
    let mut found_index = -1
    while i < group_count {
      if found_index == -1 {
        let (name, sources) = Array::get(groups, i)
        if name == group_name {
          Array::push(sources, (path, source))
          found_index = i
        }
      }
      i = i + 1
    }
    if found_index == -1 {
      let sources = Array::slice([("", "")], 0, 0)
      Array::push(sources, (path, source))
      Array::push(groups, (group_name, sources))
    }
  }
}
let empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {
  Array::slice([("", "", "", "")], 0, 0)
}
let parse_persistent_source_list_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } = (raw) -> {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let sources = empty_source_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source list cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent source list cache version")
          }
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "source" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else {
          throw(String::concat("invalid persistent source list cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, sources)
}
let parse_persistent_source_group_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_group_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source group cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent source group cache version")
          }
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "group" {
          if version == 1 {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), "", Array::get(fields, 3)))
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))
          }
        } else {
          throw(String::concat("invalid persistent source group cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}
let matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
    } else {
      false
    }
  }
}
let load_source_if_cached_file_spec_matches: (String, String, String) -> Option[String] with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {
  if !(Fs::exists(path)) {
    None
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        Some(Fs::read_file(path))
      } else if String::length(source_fingerprint) > 0 {
        let source = Fs::read_file(path)
        if compact_string_fingerprint(source) == source_fingerprint {
          Some(source)
        } else {
          None
        }
      } else {
        None
      }
    } else if String::length(source_fingerprint) > 0 {
      let source = Fs::read_file(path)
      if compact_string_fingerprint(source) == source_fingerprint {
        Some(source)
      } else {
        None
      }
    } else {
      None
    }
  }
}
let rec load_cached_sources_rec: (Array[(String, String, String)], Int, Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } = (specs, index, out) -> {
  if index >= Array::length(specs) {
    Some(out)
  } else {
    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        Array::push(out, (path, source))
        load_cached_sources_rec(specs, index + 1, out)
      },
      None => None
    }
  }
}
let rec load_cached_grouped_sources_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        push_grouped_source(out, group_name, path, source)
        load_cached_grouped_sources_rec(rows, index + 1, out)
      },
      None => None
    }
  }
}
let manifest_cache_is_valid: (Option[(String, String, String)]) -> Bool with { Error, Fs } = (manifest) -> {
  match manifest {
    Some((path, stat_token_text, source_fingerprint)) =>
      matches_cached_file_spec(path, stat_token_text, source_fingerprint),
    None => true
  }
}
let load_persistent_sources_cache_if_valid: (String) -> Option[Array[(String, String)]] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs) = parse_persistent_source_list_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_sources_rec(specs, 0, empty_source_specs())
    }
  }
}
let load_persistent_source_groups_cache_if_valid: (String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())
    }
  }
}
let manifest_path_of: (Option[(String, String, String)]) -> Option[String] = (manifest) -> {
  match manifest {
    Some((path, _, _)) => Some(path),
    None => None
  }
}
let load_persistent_source_groups_from_source_list_cache_if_valid: (String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs) = parse_persistent_source_list_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) =>
          match try_load_manifest_rows(entry_path) {
            Some((base_dir, rows)) => {
              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)
              Some((manifest_path_of(manifest), groups))
            },
            None => {
              let groups = empty_grouped_sources()
              Array::push(groups, ("recursive", sources))
              Some((None, groups))
            }
          },
        None => None
      }
    }
  }
}
let build_persistent_sources_cache_text: (Option[String], Array[(String, String)]) -> String with { Error, Fs } = (manifest_path, sources) -> {
  let mut out = "version\t2\n"
  match manifest_path {
    Some(path) => {
      out = String::concat(
        out,
        String::concat(
          "manifest\t",
          String::concat(
            path,
            String::concat(
              "\t",
              String::concat(
                __to_string(Fs::stat_token(path)),
                String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(path)), "\n"))
              )
            )
          )
        )
      )
    },
    None => ()
  }
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    out = String::concat(
      out,
      String::concat(
        "source\t",
        String::concat(
          path,
          String::concat(
            "\t",
            String::concat(
              __to_string(Fs::stat_token(path)),
              String::concat("\t", String::concat(compact_string_fingerprint(source), "\n"))
            )
          )
        )
      )
    )
    i = i + 1
  }
  out
}
let build_persistent_source_groups_cache_text: (Option[String], Array[(String, Array[(String, String)])]) -> String with { Error, Fs } = (manifest_path, groups) -> {
  let mut out = "version\t2\n"
  match manifest_path {
    Some(path) => {
      out = String::concat(
        out,
        String::concat(
          "manifest\t",
          String::concat(
            path,
            String::concat(
              "\t",
              String::concat(
                __to_string(Fs::stat_token(path)),
                String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(path)), "\n"))
              )
            )
          )
        )
      )
    },
    None => ()
  }
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      out = String::concat(
        out,
        String::concat(
          "group\t",
          String::concat(
            group_name,
            String::concat(
              "\t",
              String::concat(
                path,
                String::concat(
                  "\t",
                  String::concat(
                    __to_string(Fs::stat_token(path)),
                    String::concat("\t", String::concat(compact_string_fingerprint(source), "\n"))
                  )
                )
              )
            )
          )
        )
      )
      si = si + 1
    }
    gi = gi + 1
  }
  out
}
let collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {
  let deps = Array::slice([""], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      _ => ()
    }
    i = i + 1
  }
  deps
}
export let load_or_parse_module_header_fs: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {
  load_or_parse_module_header_fs_impl(path, source, parse_count)
}
let store_persistent_sources_cache: (String, Option[String], Array[(String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, sources) -> {
  Fs::write_file(
    persistent_source_list_cache_path(entry_path),
    build_persistent_sources_cache_text(manifest_path, sources)
  )
}
let store_persistent_source_groups_cache: (String, Option[String], Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } = (entry_path, manifest_path, groups) -> {
  Fs::write_file(
    persistent_source_group_cache_path(entry_path),
    build_persistent_source_groups_cache_text(manifest_path, groups)
  )
}
let copy_grouped_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] = (groups) -> {
  let out = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let copied_sources = copy_source_specs(sources)
    Array::push(out, (group_name, copied_sources))
    gi = gi + 1
  }
  out
}
let special_manifest_sources: (String) -> Option[(String, Array[(String, String)])] = (entry_path) -> {
  let _ = entry_path
  None
}
let special_manifest_source_groups: (String) -> Option[(String, Array[(String, Array[(String, String)])])] = (entry_path) -> {
  let _ = entry_path
  None
}
let rec collect_sources_rec: (String, Array[(String, String)], Array[String]) -> Unit with { Error, Fs } = (path, sources, visited) -> {
  if contains_path(visited, path) {
    ()
  }
  else {
    Array::push(visited, path)
    let source = Fs::read_file(path)
    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)
    let mut i = 0
    while i < Array::length(deps) {
      collect_sources_rec(Array::get(deps, i), sources, visited)
      i = i + 1
    }
    Array::push(sources, (path, source))
  }
}
export let collect_all_sources_fs: (String) -> Array[(String, String)] with { Error, Fs } = (entry_path) -> {
  match special_manifest_sources(entry_path) {
    Some((manifest_path, sources)) => {
      let _ = manifest_path
      copy_source_specs(sources)
    },
    None =>
      match load_persistent_sources_cache_if_valid(entry_path) {
        Some(sources) => sources,
        None => {
          match try_collect_manifest_sources_fs(entry_path) {
            Some((manifest_path, sources)) => {
              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)
              sources
            },
            None => {
              match try_load_manifest_rows(entry_path) {
                Some((base_dir, rows)) => {
                  let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)
                  preloaded_sources
                },
                None => {
                  let sources = Array::slice([("", "")], 0, 0)
                  let visited = Array::slice([""], 0, 0)
                  collect_sources_rec(entry_path, sources, visited)
                  store_persistent_sources_cache(entry_path, None, sources)
                  sources
                }
              }
            }
          }
        }
      }
  }
}
export let collect_source_groups_fs: (String) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  match special_manifest_source_groups(entry_path) {
    Some((manifest_path, groups)) => {
      let _ = manifest_path
      copy_grouped_sources(groups)
    },
    None =>
      match load_persistent_source_groups_cache_if_valid(entry_path) {
        Some(groups) => groups,
        None =>
          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {
            Some((manifest_path, groups)) => {
              store_persistent_source_groups_cache(entry_path, manifest_path, groups)
              groups
            },
            None =>
              match try_collect_manifest_source_groups_fs(entry_path) {
                Some((manifest_path, groups)) => {
                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                  groups
                },
                None =>
                  match try_load_manifest_rows(entry_path) {
                    Some((base_dir, rows)) => {
                      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                      let groups = empty_grouped_sources()
                      let mut j = 0
                      while j < Array::length(rows) {
                        let (group_name, rel_path) = Array::get(rows, j)
                        let path = join_path(base_dir, rel_path)
                        let mut found = ""
                        let mut k = 0
                        while k < Array::length(preloaded_sources) {
                          if found == "" {
                            let (source_path, source_text) = Array::get(preloaded_sources, k)
                            if source_path == path {
                              found = source_text
                            }
                          }
                          k = k + 1
                        }
                        if found == "" {
                          ()
                        } else {
                          push_grouped_source(groups, group_name, path, found)
                        }
                        j = j + 1
                      }
                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                      groups
                    },
                    None => {
                      let groups = empty_grouped_sources()
                      let recursive_sources = collect_all_sources_fs(entry_path)
                      Array::push(groups, ("recursive", recursive_sources))
                      store_persistent_source_groups_cache(entry_path, None, groups)
                      groups
                    }
                  }
              }
          }
      }
  }
}
let empty_stmt_array: () -> Array[Stmt] = () -> {
  Array::slice([
    SExpr(EInt(0))
  ], 0, 0)
}
export {
  empty_stmt_array
}
export {
  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid
}
export enum StrMap {
  StrMap(Array[Array[(String, String)]])
}
export enum DepsMap {
  DepsMap(Array[Array[(String, Array[String])]])
}
export enum RippleDb {
  RippleDb(StrMap, StrMap, DepsMap, Array[Int])
}
let nbuckets: () -> Int = () -> {
  256
}
let bucket_mask: () -> Int = () -> {
  255
}
let hash_bucket: (String) -> Int = (key) -> {
  let len = String::length(key)
  let rec go: (Int, Int) -> Int = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let c = String::char_code_at(key, i)
      let mixed = (acc ^ c) * 16777619
      let bounded = mixed & 1073741823
      go(i + 1, bounded)
    }
  }
  let h = go(0, 2166136261 & 1073741823)
  h & bucket_mask()
}
let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}
let empty_string_pairs: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}
let empty_deps_pairs: () -> Array[(String, Array[String])] = () -> {
  Array::slice([
    ("", empty_strings())
  ], 0, 0)
}
let new_string_buckets: () -> Array[Array[(String, String)]] = () -> {
  let n = nbuckets()
  let b = ArrayBuilder::new()
  let rec go: (Int) -> Unit = (i) -> {
    if i >= n {
      ()
    } else {
      ArrayBuilder::push(b, empty_string_pairs())
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(b)
}
let new_deps_buckets: () -> Array[Array[(String, Array[String])]] = () -> {
  let n = nbuckets()
  let b = ArrayBuilder::new()
  let rec go: (Int) -> Unit = (i) -> {
    if i >= n {
      ()
    } else {
      ArrayBuilder::push(b, empty_deps_pairs())
      go(i + 1)
    }
  }
  go(0)
  ArrayBuilder::freeze(b)
}
let strmap_new: () -> StrMap = () -> {
  StrMap(new_string_buckets())
}
let rec assoc_get_string: (Array[(String, String)], String, Int) -> Option[String] = (bucket, key, i) -> {
  if i >= Array::length(bucket) {
    None
  } else {
    let (k, v) = Array::get(bucket, i)
    if k == key {
      Some(v)
    } else {
      assoc_get_string(bucket, key, i + 1)
    }
  }
}
let strmap_get: (StrMap, String) -> Option[String] = (m, key) -> {
  match m {
    StrMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      assoc_get_string(bucket, key, 0)
    }
  }
}
let strmap_set: (StrMap, String, String) -> Unit = (m, key, value) -> {
  match m {
    StrMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      let len = Array::length(bucket)
      let rec go: (Int) -> Unit = (i) -> {
        if i >= len {
          Array::push(bucket, (key, value))
        } else {
          let (k, _) = Array::get(bucket, i)
          if k == key {
            Array::set(bucket, i, (key, value))
          } else {
            go(i + 1)
          }
        }
      }
      go(0)
    }
  }
}
let depsmap_new: () -> DepsMap = () -> {
  DepsMap(new_deps_buckets())
}
let rec assoc_get_deps: (Array[(String, Array[String])], String, Int) -> Option[Array[String]] = (bucket, key, i) -> {
  if i >= Array::length(bucket) {
    None
  } else {
    let (k, v) = Array::get(bucket, i)
    if k == key {
      Some(v)
    } else {
      assoc_get_deps(bucket, key, i + 1)
    }
  }
}
let depsmap_get: (DepsMap, String) -> Option[Array[String]] = (m, key) -> {
  match m {
    DepsMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      assoc_get_deps(bucket, key, 0)
    }
  }
}
let depsmap_set: (DepsMap, String, Array[String]) -> Unit = (m, key, deps) -> {
  match m {
    DepsMap(buckets) => {
      let idx = hash_bucket(key)
      let bucket = Array::get(buckets, idx)
      let len = Array::length(bucket)
      let rec go: (Int) -> Unit = (i) -> {
        if i >= len {
          Array::push(bucket, (key, deps))
        } else {
          let (k, _) = Array::get(bucket, i)
          if k == key {
            Array::set(bucket, i, (key, deps))
          } else {
            go(i + 1)
          }
        }
      }
      go(0)
    }
  }
}
export let ripple_new: () -> RippleDb = () -> {
  let count = ArrayBuilder::new()
  ArrayBuilder::push(count, 0)
  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))
}
export let ripple_get_source: (RippleDb, String) -> Option[String] = (db, path) -> {
  match db {
    RippleDb(sources, _, _, _) => strmap_get(sources, path)
  }
}
export let ripple_get_fingerprint: (RippleDb, String) -> Option[String] = (db, path) -> {
  match db {
    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)
  }
}
export let ripple_get_deps: (RippleDb, String) -> Option[Array[String]] = (db, path) -> {
  match db {
    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)
  }
}
export let ripple_set_source: (RippleDb, String, String) -> RippleDb = (db, path, source) -> {
  match db {
    RippleDb(sources, _, _, _) => {
      strmap_set(sources, path, source)
      db
    }
  }
}
export let ripple_record_eval: (RippleDb, String, String, Array[String]) -> RippleDb = (db, path, fingerprint, deps) -> {
  match db {
    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {
      Some(prev_fp) => if prev_fp == fingerprint {
        db
      } else {
        strmap_set(fingerprints, path, fingerprint)
        depsmap_set(deps_map, path, deps)
        Array::set(count, 0, Array::get(count, 0) + 1)
        db
      },
      None => {
        strmap_set(fingerprints, path, fingerprint)
        depsmap_set(deps_map, path, deps)
        Array::set(count, 0, Array::get(count, 0) + 1)
        db
      }
    }
  }
}
export {
  RippleDb,
  ripple_new,
  ripple_set_source,
  ripple_get_source,
  ripple_get_fingerprint,
  ripple_get_deps,
  ripple_record_eval,
  ripple_eval_count
}
let parse_int_unwrap: (String, Int) -> Int = (raw, fallback) -> {
  let len = String::length(raw)
  let mut result = 0
  let mut i = 0
  let mut neg = false
  let mut valid = true
  if len == 0 { valid = false }
  if valid {
    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }
  }
  while valid {
    if i >= len { break }
    let c = String::char_code_at(raw, i)
    if c < 48 { valid = false }
    else if c > 57 { valid = false }
    else {
      result = result * 10 + (c - 48)
      i = i + 1
    }
  }
  if valid {
    if neg { 0 - result } else result
  } else fallback
}
let serialize_segment: (String) -> String = (text) -> {
  let len = String::length(text)
  let len_str = __to_string(len)
  let colon_text = String::concat(":", text)
  String::concat(len_str, colon_text)
}
let decode_effect_name: (String) -> String = (raw) -> {
  if raw == "" || raw == "0" {
    ""
  } else if raw == "1" {
    "Error"
  } else {
    raw
  }
}
let parse_count_header: (String, Int, Int) -> (Int, Int) with { Error } = (text, pos, terminator) -> {
  let len = String::length(text)
  let mut i = pos
  while i < len && String::char_code_at(text, i) != terminator {
    i = i + 1
  }
  if i >= len {
    throw("invalid persistent type env payload")
  } else {
    let parsed = parse_int_unwrap(text[pos: i], 0)
    (parsed, i + 1)
  }
}
let parse_segment: (String, Int) -> (String, Int) with { Error } = (text, pos) -> {
  let (seg_len, start) = parse_count_header(text, pos, 58)
  let end = start + seg_len
  if end > String::length(text) {
    throw("invalid persistent type env segment")
  } else {
    (text[start: end], end)
  }
}
let parse_int_array: (String, Int) -> (Array[Int], Int) with { Error } = (text, pos) -> {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([
    0
  ], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next_cursor) = parse_segment(text, cursor)
    let parsed_val = parse_int_unwrap(raw, 0)
    Array::push(items, parsed_val)
    cursor = next_cursor
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env int array")
  } else {
    (items, cursor + 1)
  }
}
let parse_string_array: (String, Int) -> (Array[String], Int) with { Error } = (text, pos) -> {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (item, next_cursor) = parse_segment(text, cursor)
    Array::push(items, item)
    cursor = next_cursor
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env string array")
  } else {
    (items, cursor + 1)
  }
}
let parse_bounds_array: (String, Int) -> (Array[(Int, Array[String])], Int) with { Error } = (text, pos) -> {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw_id, next_cursor) = parse_segment(text, cursor)
    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)
    let parsed_id = parse_int_unwrap(raw_id, 0)
    Array::push(items, (parsed_id, bounds))
    cursor = next_cursor2
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env bounds array")
  } else {
    (items, cursor + 1)
  }
}
let rec parse_cached_type: (String, Int) -> (Type, Int) with { Error } = (source, pos) -> {
  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {
    let (count, start) = parse_count_header(text, pos, 91)
    let items = Array::slice([
      CtUnknown
    ], 0, 0)
    let mut i = 0
    let mut cursor = start
    while i < count {
      let (raw, next_cursor) = parse_segment(text, cursor)
      let (item, end_cursor) = parse_cached_type(raw, 0)
      if end_cursor != String::length(raw) {
        throw("invalid persistent type env nested type")
      } else {
        Array::push(items, item)
        cursor = next_cursor
        i = i + 1
      }
    }
    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
      throw("invalid persistent type env type array")
    } else {
      (items, cursor + 1)
    }
  }
  if pos >= String::length(source) {
    throw("invalid persistent type env type")
  } else {
    let tag = String::char_code_at(source, pos)
    match tag {
      73 => (CtInt, pos + 1),
      68 => (CtDouble, pos + 1),
      66 => (CtBool, pos + 1),
      71 => (CtString, pos + 1),
      72 => (CtChar, pos + 1),
      85 => (CtUnit, pos + 1),
      89 => (CtBytes, pos + 1),
      88 => (CtUnknown, pos + 1),
      86 => {
        let (raw, next_pos) = parse_segment(source, pos + 1)
        let var_id = parse_int_unwrap(raw, 0)
        (CtVar(var_id), next_pos)
      },
      69 => {
        let (name, next_pos) = parse_segment(source, pos + 1)
        (CtEnum(name), next_pos)
      },
      82 => {
        let (name, next_pos) = parse_segment(source, pos + 1)
        (CtStruct(name), next_pos)
      },
      65 => {
        let (elem, next_pos) = parse_cached_type(source, pos + 1)
        (CtArray(elem), next_pos)
      },
      79 => {
        let (elem, next_pos) = parse_cached_type(source, pos + 1)
        (CtOption(elem), next_pos)
      },
      84 => {
        let (elems, next_pos) = parse_type_array(source, pos + 1)
        (CtTuple(elems), next_pos)
      },
      70 => {
        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)
        let (params, next_pos2) = parse_type_array(source, next_pos1)
        let (ret, next_pos3) = parse_cached_type(source, next_pos2)
        let eff_raw = decode_effect_name(raw_effect)
        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }
        (CtFn(params, ret, eff_name), next_pos3)
      },
      78 => {
        let (name, next_pos1) = parse_segment(source, pos + 1)
        let (args, next_pos2) = parse_type_array(source, next_pos1)
        (CtNamed(name, args), next_pos2)
      },
      81 => {
        let (vars, next_pos1) = parse_int_array(source, pos + 1)
        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)
        let (body, next_pos3) = parse_cached_type(source, next_pos2)
        (CtForAll(vars, bounds, body), next_pos3)
      },
      _ => throw("invalid persistent type env type tag")
    }
  }
}
let serialize_int_array: (Array[Int]) -> String = (items) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}
let serialize_string_array: (Array[String]) -> String = (items) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}
let serialize_bounds_array: (Array[(Int, Array[String])]) -> String = (items) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (id, bounds) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(__to_string(id)))
    StringBuilder::push(buf, serialize_string_array(bounds))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}
let rec serialize_type: (Type) -> String = (ty) -> {
  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {
    let buf = StringBuilder::new()
    StringBuilder::push(buf, __to_string(Array::length(items)))
    StringBuilder::push(buf, "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))
      i = i + 1
    }
    StringBuilder::push(buf, "]")
    StringBuilder::freeze(buf)
  }
  match ty {
    CtInt => "I",
    CtDouble => "D",
    CtBool => "B",
    CtString => "G",
    CtChar => "H",
    CtUnit => "U",
    CtBytes => "Y",
    CtUnknown => "X",
    CtVar(id) => String::concat("V", serialize_segment(__to_string(id))),
    CtEnum(name) => String::concat("E", serialize_segment(name)),
    CtStruct(name) => String::concat("R", serialize_segment(name)),
    CtArray(elem) => String::concat("A", serialize_type(elem)),
    CtOption(elem) => String::concat("O", serialize_type(elem)),
    CtTuple(elems) => String::concat("T", serialize_type_array(elems)),
    CtFn(params, ret, effect_name) => {
      let eff_str = if effect_name is Some(n) { n } else { "" }
      String::concat("F", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))
    },
    CtNamed(name, args) =>
    String::concat("N", String::concat(serialize_segment(name), serialize_type_array(args))),
    CtForAll(vars, bounds, body) =>
    String::concat("Q", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))
  }
}
export let persistent_dep_list_text: (Array[String]) -> String = (deps) -> {
  if Array::length(deps) == 0 {
    ""
  } else if Array::length(deps) == 1 {
    String::concat("version\t3\n", Array::get(deps, 0))
  } else {
    String::concat("version\t2\n", serialize_string_array(deps))
  }
}
export let load_persistent_dep_list: (String, String) -> Option[Array[String]] with { Error, Fs } = (path, source) -> {
  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    if String::length(text) == 0 {
      Some(Array::slice([
        ""
      ], 0, 0))
    } else {
      let v2_prefix = "version\t2\n"
      let v3_prefix = "version\t3\n"
      let text_len = String::length(text)
      let v2_len = String::length(v2_prefix)
      let v3_len = String::length(v3_prefix)
      if text_len >= v2_len &&
      text[0: v2_len] == v2_prefix {
        let body = text[v2_len: text_len]
        let (deps, end_pos) = parse_string_array(body, 0)
        if end_pos == String::length(body) {
          Some(deps)
        } else {
          throw(String::concat("invalid persistent dep list body: ", cache_path))
        }
      } else if text_len >= v3_len &&
      text[0: v3_len] == v3_prefix {
        let dep = text[v3_len: text_len]
        if String::length(dep) == 0 {
          Some(Array::slice([
            ""
          ], 0, 0))
        } else {
          Some([dep])
        }
      } else {
        throw(String::concat("invalid persistent dep list header: ", cache_path))
      }
    }
  }
}
let rebuild_persistent_type_env: (Array[(String, Type)]) -> TypeEnv = (bindings) -> {
  EnvFlat(bindings)
}
export let load_persistent_type_env: (String) -> Option[TypeEnv] with { Error, Fs } = (fingerprint) -> {
  let path = persistent_type_env_cache_path(fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), "\n")
    let len = Array::length(lines)
    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {
      if index >= len {
        if version_ok {
          Some(rebuild_persistent_type_env(bindings))
        } else {
          None
        }
      } else {
        let line = Array::get(lines, index)
        if String::length(line) == 0 {
          go(index + 1, version_ok, bindings)
        } else {
          let parts = String::split(line, "\t")
          if !version_ok {
            if Array::length(parts) == 2 &&
            Array::get(parts, 0) == "version" &&
            Array::get(parts, 1) == "1" {
              go(index + 1, true, bindings)
            } else {
              throw(String::concat("invalid persistent type env header: ", line))
            }
          } else if Array::length(parts) == 3 && Array::get(parts, 0) == "bind" {
            let raw_type = Array::get(parts, 2)
            let (ty, end_pos) = parse_cached_type(raw_type, 0)
            if end_pos != String::length(raw_type) {
              throw(String::concat("invalid persistent type env bind row: ", line))
            } else {
              Array::push(bindings, (Array::get(parts, 1), ty))
              go(index + 1, true, bindings)
            }
          } else {
            throw(String::concat("invalid persistent type env row: ", line))
          }
        }
      }
    }
    go(0, false, Array::slice([
      ("", CtUnknown)
    ], 0, 0))
  }
}
export let persistent_type_env_cache_text: (TypeEnv) -> String = (env) -> {
  let bindings = env_flat_bindings(env)
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "version\t1\n")
  let mut i = 0
  while i < Array::length(bindings) {
    let (name, ty) = Array::get(bindings, i)
    StringBuilder::push(buf, "bind\t")
    StringBuilder::push(buf, name)
    StringBuilder::push(buf, "\t")
    StringBuilder::push(buf, serialize_type(ty))
    StringBuilder::push(buf, "\n")
    i = i + 1
  }
  StringBuilder::freeze(buf)
}
export let load_persistent_leaf_fingerprint: (String, String) -> Option[String] with { Error, Fs } = (path, source) -> {
  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = "version\t1\n"
    if String::length(text) > String::length(prefix) &&
    text[0: String::length(prefix)] == prefix {
      Some(String::substring(text, String::length(prefix), String::length(text) - 1))
    } else {
      None
    }
  }
}
export let persistent_leaf_fingerprint_text: (String) -> String = (fingerprint) -> {
  String::concat("version\t1\n", String::concat(fingerprint, "\n"))
}
let empty_stack: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}
let empty_dep_fps: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}
let lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (p, env) = Array::get(cache, i)
      if p == path {
        result = Some(env)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}
let resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut selected = ""
  let mut i = 0
  while i < Array::length(candidates) && selected == "" {
    let candidate = Array::get(candidates, i)
    match lookup_env_cache(cache, candidate) {
      Some(_) => {
        selected = candidate
      },
      None => ()
    }
    i = i + 1
  }
  if selected == "" {
    resolve_import_path(base_dir, raw_path)
  } else {
    selected
  }
}
let starts_with_upper: (String) -> Bool = (name) -> {
  if String::length(name) == 0 {
    false
  } else {
    let c = String::char_code_at(name, 0)
    c >= 65 && c <= 90
  }
}
let rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {
  match ty {
    CtEnum(name) => name == type_name,
    CtNamed(name, _) => name == type_name,
    CtFn(_, ret, _) => type_returns_name(ret, type_name),
    CtForAll(_, _, body) => type_returns_name(body, type_name),
    _ => false
  }
}
let bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {
  let mut out = acc
  let mut i = 0
  while i < Array::length(dep_bindings) {
    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)
    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {
      out = env_bind(out, candidate_name, candidate_ty)
    }
    i = i + 1
  }
  out
}
let bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {
  let dep_env = match lookup_env_cache(cache, resolved) {
    Some(e) => e,
    None => EnvEmpty
  }
  let dep_bindings = env_flat_bindings(dep_env)
  let nlen = Array::length(names)
  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {
    if j >= nlen {
      nacc
    } else {
      let (name, alias) = Array::get(names, j)
      let bound_name = match alias {
        Some(a) => a,
        None => name
      }
      let ty = match env_lookup_flat(dep_bindings, name) {
        Some(t) => t,
        None => CtUnknown
      }
      let with_name = env_bind(nacc, bound_name, ty)
      let with_companions = match ty {
        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),
        _ => if starts_with_upper(name) {
          bind_enum_constructor_companions(with_name, dep_bindings, name)
        } else {
          with_name
        }
      }
      bind_names(j + 1, with_companions)
    }
  }
  bind_names(0, acc)
}
let build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {
  let len = Array::length(stmts)
  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, names) => {
          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
          bind_import_names_from_cache(acc, resolved, names, cache)
        },
        SReExport(raw_path, names) => {
          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
          bind_import_names_from_cache(acc, resolved, names, cache)
        },
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, EnvEmpty)
}
let upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {
  let len = Array::length(cache)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    let (p, _) = Array::get(cache, i)
    if p == path {
      Array::set(cache, i, (path, env))
      found = true
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(cache, (path, env))
  }
  cache
}
let ensure_env_cache_for_path: (RippleDb, Array[(String, TypeEnv)], String) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, path) -> {
  match lookup_env_cache(env_cache, path) {
    Some(_) => env_cache,
    None =>
    match ripple_get_fingerprint(rdb, path) {
      Some(fingerprint) =>
      match load_persistent_type_env(fingerprint) {
        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),
        None => env_cache
      },
      None => env_cache
    }
  }
}
let ensure_env_cache_for_paths: (RippleDb, Array[(String, TypeEnv)], Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, paths) -> {
  let mut cache = env_cache
  let mut i = 0
  while i < Array::length(paths) {
    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))
    i = i + 1
  }
  cache
}
let build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let dep_pair = Array::get(dep_fps, i)
    let dep_path = dep_pair.0
    let dep_fp = dep_pair.1
    let next = String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}
let copy_string_array: (Array[String]) -> Array[String] = (items) -> {
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(items)
  while i < len {
    Array::push(out, Array::get(items, i))
    i = i + 1
  }
  out
}
let lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {
  let len = Array::length(pairs)
  let mut i = 0
  let mut result = None
  let mut done = false
  while !done {
    if i >= len {
      done = true
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        result = Some(v)
        done = true
      } else {
        i = i + 1
      }
    }
  }
  result
}
let upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {
  let len = Array::length(pairs)
  let mut i = 0
  let mut found = false
  while i < len && !found {
    let (k, _) = Array::get(pairs, i)
    if k == key {
      Array::set(pairs, i, (key, value))
      found = true
    } else {
      i = i + 1
    }
  }
  if !found {
    Array::push(pairs, (key, value))
  }
  pairs
}
let parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {
  handle {
    let (tokens, starts, _ends) = lex_with_offsets(source)
    parse_program_located(tokens, starts, source)
  } with Error {
    Throw(msg) => throw(String::concat(String::concat(path, ": "), msg))
  }
}
let store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {
  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))
}
let write_persistent_dep_list_if_missing: (String, String, Array[String]) -> Unit with { Fs } = (path, source, deps) -> {
  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(dep_cache_path)) {
    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))
  } else {
    ()
  }
}
let typecheck_ident_run: (String, Int) -> Int = (s, start) -> {
  let len = String::length(s)
  let mut e = start
  let mut go = true
  while go && e < len {
    let c = String::char_code_at(s, e)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    if is_id {
      e = e + 1
    } else {
      go = false
    }
  }
  e
}
let locate_by_marker: (String, String, String) -> String = (source, msg, marker) -> {
  let mi = String::index_of(msg, marker)
  if mi < 0 {
    msg
  } else {
    let sstart = mi + String::length(marker)
    let send = typecheck_ident_run(msg, sstart)
    if send <= sstart {
      msg
    } else {
      let sym = String::substring(msg, sstart, send)
      let off = String::index_of(source, sym)
      if off < 0 {
        msg
      } else {
        let (line, col) = offset_to_line_col(source, off)
        let loc = String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
        String::concat(loc, msg)
      }
    }
  }
}
let locate_type_error_heuristic: (String, String) -> String = (source, msg) -> {
  if String::index_of(msg, "line ") == 0 {
    msg
  } else {
    let with_name = locate_by_marker(source, msg, "unknown name: ")
    if with_name != msg {
      with_name
    } else {
      let with_arity = locate_by_marker(source, msg, "function arity mismatch for ")
      if with_arity != msg {
        with_arity
      } else {
        let with_field = locate_by_marker(source, msg, "unknown field ")
        if with_field != msg {
          with_field
        } else {
          locate_by_marker(source, msg, "unknown constructor ")
        }
      }
    }
  }
}
let offset_line_col_prefix: (String, Int) -> String = (source, off) -> {
  let (line, col) = offset_to_line_col(source, off)
  String::concat("line ", String::concat(__to_string(line), String::concat(":", String::concat(__to_string(col), ": "))))
}
let offset_line_col_range_prefix: (String, Int, Int) -> String = (source, start, endo) -> {
  let (l1, c1) = offset_to_line_col(source, start)
  let (l2, c2) = offset_to_line_col(source, endo)
  if l1 == l2 && endo > start {
    String::concat("line ", String::concat(__to_string(l1), String::concat(":", String::concat(__to_string(c1), String::concat("-", String::concat(__to_string(c2), ": "))))))
  } else {
    offset_line_col_prefix(source, start)
  }
}
let parse_offset_digits: (String, Int, Int) -> Int = (msg, start, end) -> {
  if end <= start {
    -1
  } else {
    let mut i = start
    let mut acc = 0
    let mut ok = true
    while ok && i < end {
      let c = String::char_code_at(msg, i)
      if c >= '0' && c <= '9' {
        acc = acc * 10 + (c - '0')
        i = i + 1
      } else {
        ok = false
      }
    }
    if ok {
      acc
    } else {
      -1
    }
  }
}
let locate_type_error: (String, String) -> String = (source, msg) -> {
  let marker = " [@off="
  let mi = String::index_of(msg, marker)
  if mi < 0 {
    locate_type_error_heuristic(source, msg)
  } else {
    let inner_start = mi + String::length(marker)
    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), "]")
    if rel_end < 0 {
      locate_type_error_heuristic(source, String::substring(msg, 0, mi))
    } else {
      let close = inner_start + rel_end
      let inner = String::substring(msg, inner_start, close)
      let colon = String::index_of(inner, ":")
      let n = if colon < 0 {
        parse_offset_digits(inner, 0, String::length(inner))
      } else {
        parse_offset_digits(inner, 0, colon)
      }
      let m = if colon < 0 {
        -1
      } else {
        parse_offset_digits(inner, colon + 1, String::length(inner))
      }
      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))
      let slen = String::length(source)
      if n >= 0 && n < slen {
        if m > n && m <= slen {
          String::concat(offset_line_col_range_prefix(source, n, m), stripped)
        } else {
          String::concat(offset_line_col_prefix(source, n), stripped)
        }
      } else {
        locate_type_error_heuristic(source, stripped)
      }
    }
  }
}
let finish_typecheck_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, String, Array[String], String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, source, deps, fingerprint) -> {
  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {
    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)
  } else {
    let stmts = parse_program_with_path(path, source)
    let final_parse_count = parse_count + 1
    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)
    let import_env = build_import_env(stmts, dir_of_path(path), import_env_cache)
    let checked_env = handle {
      match import_env {
        EnvEmpty => check_program(stmts),
        _ => check_program_with_env(stmts, import_env)
      }
    } with Error {
      Throw(msg) => throw(String::concat(String::concat(path, ": "), locate_type_error(source, msg)))
    }
    store_persistent_type_env(fingerprint, checked_env)
    if Array::length(deps) == 0 {
      Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))
    } else {
      ()
    }
    let next_env_cache = upsert_env_cache(import_env_cache, path, checked_env)
    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
    (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)
  }
}
let collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(stmts)
  while i < len {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_import_path(base_dir, raw_path)
        if !contains_str(out, resolved) {
          Array::push(out, resolved)
        }
      },
      SReExport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_import_path(base_dir, raw_path)
        if !contains_str(out, resolved) {
          Array::push(out, resolved)
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}
let load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {
  match load_persistent_dep_list(path, source) {
    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),
    None => {
      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)
      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)
    }
  }
}
let resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) =>
    if cached_source == source {
      match ripple_get_deps(rdb, path) {
        Some(deps) => (deps, dep_source_cache, parse_count),
        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
      }
    } else {
      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
    },
    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
  }
}
let rec ensure_fingerprint_fs_go: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {
  if contains_str(stack, path) {
    throw(String::concat("type_db: import cycle detected at ", path))
  } else {
    match ripple_get_source(rdb, path) {
      None => (String::concat("missing:", path), rdb, env_cache, dep_source_cache, parse_count),
      Some(source) => match lookup_string_pair(dep_source_cache, path) {
        Some(cached_source) => if cached_source == source {
          match ripple_get_fingerprint(rdb, path) {
            Some(cached_fingerprint) =>
            (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),
            None => match load_persistent_leaf_fingerprint(path, source) {
              Some(leaf_fingerprint) => {
                write_persistent_dep_list_if_missing(path, source, empty_stack())
                let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)
                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())
                (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)
              },
              None => {
                let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)
                let deps = copy_string_array(deps_raw)
                write_persistent_dep_list_if_missing(path, source, deps)
                let dlen = Array::length(deps)
                let saved_stack_len = Array::length(stack)
                Array::push(stack, path)
                let mut i = 0
                let mut db_after_deps = rdb
                let mut env_cache_after_deps = env_cache
                let mut dep_source_cache_after_deps = next_dep_source_cache
                let mut parse_count_after_deps = initial_parse_count
                let dep_fps = empty_dep_fps()
                while i < dlen {
                  let dep_path = Array::get(deps, i)
                  let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)
                  db_after_deps = next_db
                  env_cache_after_deps = next_env_cache
                  dep_source_cache_after_deps = next_dep_source_cache2
                  parse_count_after_deps = next_parse_count
                  Array::push(dep_fps, (dep_path, dep_fp))
                  i = i + 1
                }
                Array::truncate(stack, saved_stack_len)
                let fingerprint = build_fingerprint(source, dep_fps)
                match ripple_get_fingerprint(db_after_deps, path) {
                  Some(cached_fp) =>
                  if cached_fp == fingerprint {
                    (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)
                  } else {
                    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
                  },
                  None =>
                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
                }
              }
            }
          }
        } else {
          match load_persistent_leaf_fingerprint(path, source) {
            Some(leaf_fingerprint) => {
              write_persistent_dep_list_if_missing(path, source, empty_stack())
              let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)
              let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())
              (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)
            },
            None => {
              let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)
              let deps = copy_string_array(deps_raw)
              write_persistent_dep_list_if_missing(path, source, deps)
              let dlen = Array::length(deps)
              let saved_stack_len = Array::length(stack)
              Array::push(stack, path)
              let mut i = 0
              let mut db_after_deps = rdb
              let mut env_cache_after_deps = env_cache
              let mut dep_source_cache_after_deps = next_dep_source_cache
              let mut parse_count_after_deps = initial_parse_count
              let dep_fps = empty_dep_fps()
              while i < dlen {
                let dep_path = Array::get(deps, i)
                let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)
                db_after_deps = next_db
                env_cache_after_deps = next_env_cache
                dep_source_cache_after_deps = next_dep_source_cache2
                parse_count_after_deps = next_parse_count
                Array::push(dep_fps, (dep_path, dep_fp))
                i = i + 1
              }
              Array::truncate(stack, saved_stack_len)
              let fingerprint = build_fingerprint(source, dep_fps)
              match ripple_get_fingerprint(db_after_deps, path) {
                Some(cached_fp) =>
                if cached_fp == fingerprint {
                  (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)
                } else {
                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
                },
                None =>
                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
              }
            }
          }
        },
        None =>
        match load_persistent_leaf_fingerprint(path, source) {
          Some(leaf_fingerprint) => {
            write_persistent_dep_list_if_missing(path, source, empty_stack())
            let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)
            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())
            (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)
          },
          None => {
            let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)
            let deps = copy_string_array(deps_raw)
            write_persistent_dep_list_if_missing(path, source, deps)
            let dlen = Array::length(deps)
            let saved_stack_len = Array::length(stack)
            Array::push(stack, path)
            let mut i = 0
            let mut db_after_deps = rdb
            let mut env_cache_after_deps = env_cache
            let mut dep_source_cache_after_deps = next_dep_source_cache
            let mut parse_count_after_deps = initial_parse_count
            let dep_fps = empty_dep_fps()
            while i < dlen {
              let dep_path = Array::get(deps, i)
              let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)
              db_after_deps = next_db
              env_cache_after_deps = next_env_cache
              dep_source_cache_after_deps = next_dep_source_cache2
              parse_count_after_deps = next_parse_count
              Array::push(dep_fps, (dep_path, dep_fp))
              i = i + 1
            }
            Array::truncate(stack, saved_stack_len)
            let fingerprint = build_fingerprint(source, dep_fps)
            match ripple_get_fingerprint(db_after_deps, path) {
              Some(cached_fp) =>
              if cached_fp == fingerprint {
                (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)
              } else {
                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
              },
              None =>
              finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
            }
          }
        }
      }
    }
  }
}
export let ensure_fingerprint_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {
  let (fingerprint, next_db, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)
  let final_env_cache = ensure_env_cache_for_path(next_db, next_env_cache, path)
  (fingerprint, next_db, final_env_cache, next_dep_source_cache, next_parse_count)
}
export let collect_all_diagnostics: (String) -> Array[String] with { Error } = (source) -> {
  let (tokens, starts, _ends) = lex_with_offsets(source)
  let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)
  if Array::length(parse_diags) > 0 {
    parse_diags
  } else {
    handle {
      let _env = check_program(stmts)
      Array::slice([
        "_"
      ], 0, 0)
    } with Error {
      Throw(msg) => [
        locate_type_error(source, msg)
      ]
    }
  }
}
enum StringTriple {
  StringTriple(String, String, String)
}
enum TypeDbState {
  TypeDbState(
    RippleDb,
    Array[(String, TypeEnv)],
    Array[(String, String)],
    Array[StringTriple],
    Array[StringTriple],
    Array[StringTriple],
    Int,
    Int,
    Int,
    Int
  )
}
export enum TypeDb {
  TypeDb(TypeDbState)
}
let unwrap_db: (TypeDb) -> TypeDbState = (db) -> {
  match db {
    TypeDb(state) => state
  }
}
let wrap_db: (TypeDbState) -> TypeDb = (state) -> {
  TypeDb(state)
}
let parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {
  handle {
    parse_program(lex(source))
  } with Error {
    Throw(msg) => throw(String::concat(String::concat(path, ": "), msg))
  }
}
let add_dep: (Array[String], String, String) -> Array[String] = (acc, raw_path, base_dir) -> {
  if String::length(raw_path) == 0 {
    acc
  } else {
    let resolved = resolve_import_path(base_dir, raw_path)
    if contains_str(acc, resolved) {
      acc
    } else {
      Array::push(acc, resolved)
      acc
    }
  }
}
let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}
let empty_dep_fps: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}
let empty_env_cache: () -> Array[(String, TypeEnv)] = () -> {
  Array::slice([
    ("", EnvEmpty)
  ], 0, 0)
}
let empty_string_pairs: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}
let empty_string_triples: () -> Array[StringTriple] = () -> {
  Array::slice([
    StringTriple("", "", "")
  ], 0, 0)
}
let empty_stmt_array: () -> Array[Stmt] = () -> {
  Array::slice([
    SExport(["_dummy"])
  ], 0, 0)
}
export let db_new: () -> TypeDb = () -> {
  wrap_db(
    TypeDbState(
      ripple_new(),
      empty_env_cache(),
      empty_string_pairs(),
      empty_string_triples(),
      empty_string_triples(),
      empty_string_triples(),
      0,
      0,
      0,
      0
    )
  )
}
let lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {
  let len = Array::length(pairs)
  let rec go: (Int) -> Option[String] = (i) -> {
    if i >= len {
      None
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        Some(v)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}
let upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {
  let len = Array::length(pairs)
  let b = ArrayBuilder::new()
  let rec build: (Int) -> Array[(String, String)] = (i) -> {
    if i >= len {
      ArrayBuilder::push(b, (key, value))
      ArrayBuilder::freeze(b)
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        build(i + 1)
      } else {
        ArrayBuilder::push(b, (k, v))
        build(i + 1)
      }
    }
  }
  build(0)
}
export let db_set_source: (TypeDb, String, String) -> TypeDb = (db, path, source) -> {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>
      wrap_db(
        TypeDbState(
          ripple_set_source(rdb, path, source),
          env_cache,
          dep_source_cache,
          merged_cache,
          module_source_cache,
          artifact_cache,
          parse_count,
          merge_count,
          module_source_count,
          codegen_count
        )
      )
  }
}
let lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {
  let len = Array::length(cache)
  let rec go: (Int) -> Option[TypeEnv] = (i) -> {
    if i >= len {
      None
    } else {
      let (p, env) = Array::get(cache, i)
      if p == path {
        Some(env)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}
let resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut selected = ""
  let mut i = 0
  while i < Array::length(candidates) && selected == "" {
    let candidate = Array::get(candidates, i)
    match lookup_env_cache(cache, candidate) {
      Some(_) => {
        selected = candidate
      },
      None => ()
    }
    i = i + 1
  }
  if selected == "" {
    resolve_import_path(base_dir, raw_path)
  } else {
    selected
  }
}
let starts_with_upper: (String) -> Bool = (name) -> {
  if String::length(name) == 0 {
    false
  } else {
    let c = String::char_code_at(name, 0)
    c >= 65 && c <= 90
  }
}
let rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {
  match ty {
    CtEnum(name) => name == type_name,
    CtNamed(name, _) => name == type_name,
    CtFn(_, ret, _) => type_returns_name(ret, type_name),
    CtForAll(_, _, body) => type_returns_name(body, type_name),
    _ => false
  }
}
let bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {
  let mut out = acc
  let mut i = 0
  while i < Array::length(dep_bindings) {
    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)
    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {
      out = env_bind(out, candidate_name, candidate_ty)
    }
    i = i + 1
  }
  out
}
let bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {
  let dep_env = match lookup_env_cache(cache, resolved) {
    Some(e) => e,
    None => EnvEmpty
  }
  let dep_bindings = env_flat_bindings(dep_env)
  let nlen = Array::length(names)
  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {
    if j >= nlen {
      nacc
    } else {
      let (name, alias) = Array::get(names, j)
      let bound_name = match alias {
        Some(a) => a,
        None => name
      }
      let ty = match env_lookup_flat(dep_bindings, name) {
        Some(t) => t,
        None => CtUnknown
      }
      let with_name = env_bind(nacc, bound_name, ty)
      let with_companions = match ty {
        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),
        _ => if starts_with_upper(name) {
          bind_enum_constructor_companions(with_name, dep_bindings, name)
        } else {
          with_name
        }
      }
      bind_names(j + 1, with_companions)
    }
  }
  bind_names(0, acc)
}
let build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {
  let len = Array::length(stmts)
  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, names) => {
          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
          bind_import_names_from_cache(acc, resolved, names, cache)
        },
        SReExport(raw_path, names) => {
          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)
          bind_import_names_from_cache(acc, resolved, names, cache)
        },
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, EnvEmpty)
}
let upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {
  let len = Array::length(cache)
  let b = ArrayBuilder::new()
  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {
    if i >= len {
      ArrayBuilder::push(b, (path, env))
      ArrayBuilder::freeze(b)
    } else {
      let (p, e) = Array::get(cache, i)
      if p == path {
        build(i + 1)
      } else {
        ArrayBuilder::push(b, (p, e))
        build(i + 1)
      }
    }
  }
  build(0)
}
let compact_string_fingerprint: (String) -> String = (source) -> {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(
    __to_string(len),
    String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2))))
  )
}
let store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {
  Fs::write_file(
    persistent_type_env_cache_path(fingerprint),
    persistent_type_env_cache_text(env)
  )
}
let build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let dep_pair = Array::get(dep_fps, i)
    let dep_path = dep_pair.0
    let dep_fp = dep_pair.1
    let next = String::concat(
      acc,
      String::concat("|", String::concat(dep_path, String::concat("=", dep_fp)))
    )
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}
let collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {
  let len = Array::length(stmts)
  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, empty_strings())
}
let load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {
  match load_persistent_dep_list(path, source) {
    Some(deps) => (
      deps,
      upsert_string_pair(dep_source_cache, path, source),
      parse_count
    ),
    None => {
      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)
      (
        deps,
        upsert_string_pair(dep_source_cache, path, source),
        next_parse_count
      )
    }
  }
}
let resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) =>
      if cached_source == source {
        match ripple_get_deps(rdb, path) {
          Some(deps) => (deps, dep_source_cache, parse_count),
          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
        }
      } else {
        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
      },
    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
  }
}
export let db_typecheck_fs: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, path) -> {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {
      let (
        _,
        next_rdb,
        next_env_cache,
        next_dep_source_cache,
        next_parse_count
      ) = ensure_fingerprint_fs_impl(
        rdb,
        env_cache,
        dep_source_cache,
        parse_count,
        path,
        empty_strings()
      )
      wrap_db(
        TypeDbState(
          next_rdb,
          next_env_cache,
          next_dep_source_cache,
          merged_cache,
          module_source_cache,
          artifact_cache,
          next_parse_count,
          merge_count,
          module_source_count,
          codegen_count
        )
      )
    }
  }
}
let lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    if path == target_path {
      found = Some(source)
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}
let append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = Array::slice([
    ""
  ], 0, 0)
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !contains_str(emitted, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      match lookup_source_by_path(sources, resolved) {
        Some(source) => {
          let source_stmts = namespace_private_value_stmts(
            resolved,
            parse_program_with_path(resolved, source)
          )
          let mut j = 0
          let mut done = false
          while j < Array::length(source_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
              Some(local_stmt) => {
                Array::push(merged, local_stmt)
                Array::push(emitted, local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
}
export effect Profiler {
  NowUs -> Int
}
let seed_type_db_from_source_groups: (TypeDb, Array[(String, Array[(String, String)])]) -> TypeDb = (db, source_groups) -> {
  let mut seeded = db
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      seeded = db_set_source(seeded, path, source)
      si = si + 1
    }
    gi = gi + 1
  }
  seeded
}
let append_stmt_array: (Array[Stmt], Array[Stmt]) -> Unit = (dst, src) -> {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}
let string_array_contains: (Array[String], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
let lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    if path == target_path {
      found = Some(source)
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}
let parse_program_for_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {
  handle {
    let (tokens, starts, _ends) = lex_with_offsets(source)
    parse_program_located(tokens, starts, source)
  } with Error {
    Throw(msg) => throw(String::concat(String::concat(path, ": "), msg))
  }
}
let append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = Array::slice([
    ""
  ], 0, 0)
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains(emitted, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      match lookup_source_by_path(sources, resolved) {
        Some(source) => {
          let source_stmts = namespace_private_value_stmts(
            resolved,
            parse_program_for_path(resolved, source)
          )
          let mut j = 0
          let mut done = false
          while j < Array::length(source_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
              Some(local_stmt) => {
                Array::push(merged, local_stmt)
                Array::push(emitted, local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
}
let build_merged_stmts_from_sources: (String, Array[(String, String)]) -> Array[Stmt] with { Error } = (entry_path, sources) -> {
  let merged = empty_stmt_array()
  let source_count = Array::length(sources)
  let mut si = 0
  while si < source_count {
    let (path, source) = Array::get(sources, si)
    let stmts = parse_program_for_path(path, source)
    let is_entry_source = if entry_path == "" {
      si == source_count - 1
    } else {
      path == entry_path
    }
    let namespaced_stmts = if is_entry_source {
      stmts
    } else {
      namespace_private_value_stmts(path, stmts)
    }
    if stmts_have_import_deep(stmts) {
      let skipped_locals = collect_import_alias_collision_locals(stmts)
      append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)
      append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)
    } else {
      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)
    }
    si = si + 1
  }
  merged
}
let build_grouped_merged_stmts: (Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } = (source_groups) -> {
  let merged = empty_stmt_array()
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let group_stmts = build_merged_stmts_from_sources("", sources)
    append_stmt_array(merged, group_stmts)
    gi = gi + 1
  }
  merged
}
let path_basename: (String) -> String = (p) -> {
  let n = String::length(p)
  let mut last = 0 - 1
  let mut i = 0
  while i < n {
    if String::char_code_at(p, i) == 47 {
      last = i
    } else {
      ()
    }
    i = i + 1
  }
  String::substring(p, last + 1, n)
}
let file_newline_offsets: (String) -> Array[Int] = (src) -> {
  let arr = Array::slice([
    0
  ], 0, 0)
  let n = String::length(src)
  let mut i = 0
  while i < n {
    if String::char_code_at(src, i) == 10 {
      Array::push(arr, i)
    } else {
      ()
    }
    i = i + 1
  }
  arr
}
let build_grouped_merged_stmts_prov: (Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } = (source_groups) -> {
  let merged = empty_stmt_array()
  let files = Array::slice([
    ""
  ], 0, 0)
  let file_nls = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let stmt_file_id = Array::slice([
    0
  ], 0, 0)
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let (path, source) = Array::get(sources, si)
      let file_id = Array::length(files)
      Array::push(files, path_basename(path))
      Array::push(file_nls, file_newline_offsets(source))
      let before = Array::length(merged)
      let stmts = parse_program_for_path(path, source)
      let is_entry_source = si == source_count - 1
      let namespaced_stmts = if is_entry_source {
        stmts
      } else {
        namespace_private_value_stmts(path, stmts)
      }
      if stmts_have_import_deep(stmts) {
        let skipped_locals = collect_import_alias_collision_locals(stmts)
        append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)
        append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)
      } else {
        append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)
      }
      let after = Array::length(merged)
      let mut k = before
      while k < after {
        Array::push(stmt_file_id, file_id)
        k = k + 1
      }
      si = si + 1
    }
    gi = gi + 1
  }
  (merged, files, file_nls, stmt_file_id)
}
let prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck_fs(seeded, entry_path)
}
export let compile_file_fs_mode: (String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}
export let compile_file_fs_mode_coverage: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_coverage(merged_stmts, entry_name)
}
export let compile_file_fs_mode_trace: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_trace(merged_stmts, entry_name)
}
export let compile_file_fs_mode_break: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)
  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{
    files: dbg_files,
    file_nls: dbg_file_nls,
    stmt_file_id: dbg_stmt_file_id
  })
}
let empty_stmts: () -> Array[Stmt] = () -> {
  Array::slice([
    SExport([])
  ], 0, 0)
}
let empty_strs: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}
let join_module_name: (String, String) -> String = (prefix, name) -> {
  if prefix == "" {
    name
  } else {
    String::concat(prefix, String::concat("::", name))
  }
}
let rec module_value_aliases: (Array[Stmt], String, Array[(String, String)]) -> Int = (body, prefix, out) -> {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, i) {
      SLet(_, _, name, _, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SLetMut(name, _, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SExternLet(name, _) => {
        Array::push(out, (name, join_module_name(prefix, name)))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)
        0
      },
      _ => 0
    }
    i = i + 1
  }
  0
}
let rec flatten_module_body: (Array[Stmt], String, Array[(String, String)], Array[Stmt]) -> Int = (body, prefix, aliases, out) -> {
  let mut i = 0
  while i < Array::length(body) {
    match Array::get(body, i) {
      SLet(exp, is_rec, name, ty, b) => {
        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))
        0
      },
      SLetMut(name, ty, b) => {
        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))
        0
      },
      SExternLet(name, ty) => {
        Array::push(out, SExternLet(join_module_name(prefix, name), ty))
        0
      },
      SModule(_, inner, inner_body) => {
        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)
        0
      },
      other => {
        Array::push(out, other)
        0
      }
    }
    i = i + 1
  }
  0
}
let is_module_stmt: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SModule(_, _, _) => true,
    _ => false
  }
}
let exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let roots = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, _, name, _, _) => if exp || String::contains(name, "::") {
        Array::push(roots, name)
      },
      SLetMut(name, _, _) => if String::contains(name, "::") {
        Array::push(roots, name)
      },
      SExport(names) => {
        let mut j = 0
        while j < Array::length(names) {
          Array::push(roots, Array::get(names, j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  roots
}
let aggregate_export_names: (Array[Stmt]) -> Array[String] = (stmts) -> {
  let names = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SExport(exported) => {
        let mut j = 0
        while j < Array::length(exported) {
          Array::push(names, Array::get(exported, j))
          j = j + 1
        }
        0
      },
      _ => 0
    }
    i = i + 1
  }
  names
}
let str_array_has: (Array[String], String) -> Bool = (arr, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) && !found {
    if Array::get(arr, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}
let promote_aggregate_exports: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, agg) -> {
  let result = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let promoted = match stmt {
      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {
        SLet(true, is_rec, name, ty, body)
      } else {
        stmt
      },
      _ => stmt
    }
    Array::push(result, promoted)
    i = i + 1
  }
  result
}
let rec collect_type_names_into: (TypeExpr, Array[String]) -> Int = (ty, out) -> {
  match ty {
    TyName(n) => {
      Array::push(out, n)
      0
    },
    TyApp(n, args) => {
      Array::push(out, n)
      let mut i = 0
      while i < Array::length(args) {
        let _ = collect_type_names_into(Array::get(args, i), out)
        i = i + 1
      }
      0
    },
    TyFn(params, ret, _) => {
      let mut i = 0
      while i < Array::length(params) {
        let _ = collect_type_names_into(Array::get(params, i), out)
        i = i + 1
      }
      let _ = collect_type_names_into(ret, out)
      0
    },
    TyTuple(items) => {
      let mut i = 0
      while i < Array::length(items) {
        let _ = collect_type_names_into(Array::get(items, i), out)
        i = i + 1
      }
      0
    },
    TyUnit => 0
  }
}
let collect_opt_type_into: (Option[TypeExpr], Array[String]) -> Int = (ty_opt, out) -> {
  match ty_opt {
    Some(ty) => collect_type_names_into(ty, out),
    None => 0
  }
}
let collect_stmt_type_refs_into: (Stmt, Array[String]) -> Int = (stmt, out) -> {
  match stmt {
    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),
    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),
    SExternLet(_, ty) => collect_type_names_into(ty, out),
    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),
    SStruct(_, _, fields, _, _) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fty) = Array::get(fields, i)
        let _ = collect_type_names_into(fty, out)
        i = i + 1
      }
      0
    },
    SEnum(_, _, _, ctors) => {
      let mut i = 0
      while i < Array::length(ctors) {
        let (_, args) = Array::get(ctors, i)
        let mut j = 0
        while j < Array::length(args) {
          let _ = collect_type_names_into(Array::get(args, j), out)
          j = j + 1
        }
        i = i + 1
      }
      0
    },
    SImpl(_, _, _, type_name) => {
      Array::push(out, type_name)
      0
    },
    _ => 0
  }
}
let drop_unused_type_aliases: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let referenced = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)
    i = i + 1
  }
  let result = empty_stmts()
  let mut k = 0
  while k < Array::length(stmts) {
    let stmt = Array::get(stmts, k)
    let keep = match stmt {
      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),
      _ => true
    }
    if keep {
      Array::push(result, stmt)
    }
    k = k + 1
  }
  result
}
let stmt_section: (Stmt) -> Int = (stmt) -> {
  match stmt {
    SImport(_, _) => 0,
    SReExport(_, _) => 0,
    SAliasDecl(_, _) => 0,
    SEnum(_, _, _, _) => 1,
    SSuberror(_, _, _) => 1,
    SStruct(_, _, _, _, _) => 1,
    STypeAlias(_, _, _, _) => 1,
    STrait(_, _, _, _) => 1,
    SImpl(_, _, _, _) => 1,
    SEffectDef(_, _, _, _) => 1,
    SExternLet(_, _) => 1,
    SLet(_, _, _, _, _) => 2,
    SLetMut(_, _, _) => 2,
    SLetPat(_, _) => 2,
    STest(_, _) => 3,
    SBench(_, _) => 3,
    SExport(_) => 9,
    SExpr(_) => 9,
    _ => 9
  }
}
let section_header: (Int) -> String = (section) -> {
  if section == 0 {
    "//# Imports"
  } else if section == 1 {
    "//# Types"
  } else if section == 2 {
    "//# Functions"
  } else {
    "//# Tests"
  }
}
let render_section: (Array[Stmt], Int) -> String = (stmts, section) -> {
  let parts = empty_strs()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if stmt_section(stmt) == section {
      Array::push(parts, print_stmt(stmt))
    }
    i = i + 1
  }
  if Array::length(parts) == 0 {
    ""
  } else {
    let body = String::join(parts, "\n\n")
    String::concat(section_header(section), String::concat("\n\n", body))
  }
}
let normalize_empty_type_exprs: () -> Array[TypeExpr] = () -> {
  Array::slice([
    TyUnit
  ], 0, 0)
}
let all_params_typed: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {
  let mut i = 0
  let mut ok = true
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, i)
    match ty_opt {
      Some(_) => 0,
      None => {
        ok = false
        0
      }
    }
    i = i + 1
  }
  ok
}
let param_type_list: (Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] = (params) -> {
  let out = normalize_empty_type_exprs()
  let mut i = 0
  while i < Array::length(params) {
    let (_, ty_opt) = Array::get(params, i)
    match ty_opt {
      Some(ty) => Array::push(out, ty),
      None => 0
    }
    i = i + 1
  }
  out
}
let strip_param_types: (Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (params) -> {
  let out = Array::slice([
    ("", None)
  ], 0, 0)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    Array::push(out, (name, None))
    i = i + 1
  }
  out
}
let hoist_lambda_let: (Stmt) -> Stmt = (stmt) -> {
  match stmt {
    SLet(exp, is_rec, name, ty, value) => match ty {
      Some(_) => stmt,
      None => match value {
        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {
          None => stmt,
          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {
            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))
          } else {
            stmt
          }
        },
        _ => stmt
      }
    },
    _ => stmt
  }
}
let hoist_lambda_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))
    i = i + 1
  }
  out
}
let fold_int_binop: (String, Int, Int) -> Option[Int] = (op, a, b) -> {
  if op == "+" {
    Some(a + b)
  } else if op == "-" {
    Some(a - b)
  } else if op == "*" {
    Some(a * b)
  } else {
    None
  }
}
let rec fold_expr: (Expr) -> Expr = (expr) -> {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_, _) => expr,
    EUnit => expr,
    EStringInterp(_) => expr,
    ETuple(items) => ETuple(for it in items {
      fold_expr(it)
    }),
    EArray(items) => EArray(for it in items {
      fold_expr(it)
    }),
    ERecord(fields) => ERecord(for f in fields {
      let (n, v) = f
      (n, fold_expr(v))
    }),
    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),
    ELet(n, v, b) => ELet(n, fold_expr(v), fold_expr(b)),
    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),
    ELetMut(n, v, b) => ELetMut(n, fold_expr(v), fold_expr(b)),
    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),
    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),
    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),
    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {
      let (p, e) = a
      (p, fold_expr(e))
    }),
    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),
    ELoop(params, b) => ELoop(for pr in params {
      let (n, init) = pr
      (n, fold_expr(init))
    }, fold_expr(b)),
    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),
    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {
      fold_expr(a)
    }, off),
    EBinOp(op, l, r) => {
      let fl = fold_expr(l)
      let fr = fold_expr(r)
      match fl {
        EInt(a) => match fr {
          EInt(b) => match fold_int_binop(op, a, b) {
            Some(v) => EInt(v),
            None => EBinOp(op, fl, fr)
          },
          _ => EBinOp(op, fl, fr)
        },
        _ => EBinOp(op, fl, fr)
      }
    },
    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),
    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),
    EDot(e, field, off) => EDot(fold_expr(e), field, off),
    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),
    EThrow(e) => EThrow(fold_expr(e)),
    EReturn(e) => EReturn(fold_expr(e)),
    EBreak(opt) => match opt {
      Some(v) => EBreak(Some(fold_expr(v))),
      None => EBreak(None)
    },
    EContinue(args) => EContinue(for a in args {
      fold_expr(a)
    }),
    EMap(fields) => EMap(for f in fields {
      let (k, v) = f
      (k, fold_expr(v))
    }),
    ESpread(e) => ESpread(fold_expr(e))
  }
}
let fold_stmt: (Stmt) -> Stmt = (stmt) -> {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),
    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),
    STest(n, body) => STest(n, fold_expr(body)),
    SBench(n, body) => SBench(n, fold_expr(body)),
    SExpr(e) => SExpr(fold_expr(e)),
    SLetPat(p, body) => SLetPat(p, fold_expr(body)),
    _ => stmt
  }
}
let fold_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, fold_stmt(Array::get(stmts, i)))
    i = i + 1
  }
  out
}
let literal_type: (Expr) -> Option[TypeExpr] = (e) -> {
  match e {
    EInt(_) => Some(TyName("Int")),
    EBool(_) => Some(TyName("Bool")),
    EString(_) => Some(TyName("String")),
    EFloat(_) => Some(TyName("Double")),
    _ => None
  }
}
let annotate_literal_let: (Stmt) -> Stmt = (stmt) -> {
  match stmt {
    SLet(exp, is_rec, name, ty, body) => match ty {
      Some(_) => stmt,
      None => match literal_type(body) {
        Some(t) => SLet(exp, is_rec, name, Some(t), body),
        None => stmt
      }
    },
    _ => stmt
  }
}
let annotate_literal_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let out = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    Array::push(out, annotate_literal_let(Array::get(stmts, i)))
    i = i + 1
  }
  out
}
export let normalize_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {
  let nonmods = empty_stmts()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    if !is_module_stmt(stmt) {
      Array::push(nonmods, stmt)
    }
    i = i + 1
  }
  let result = empty_stmts()
  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))
  Array::push_all(result, live_top)
  let mut m = 0
  while m < Array::length(stmts) {
    match Array::get(stmts, m) {
      SModule(_, name, body) => {
        let live_body = dce_stmts(body, exported_value_names(body))
        let aliases = Array::slice([
          ("", "")
        ], 0, 0)
        let _ = module_value_aliases(live_body, name, aliases)
        let _ = flatten_module_body(live_body, name, aliases, result)
        0
      },
      _ => 0
    }
    m = m + 1
  }
  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))
  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))
}
export let normalize_source: (String) -> String with { Error } = (src) -> {
  let stmts = parse_program(lex(src))
  let kept = normalize_stmts(stmts)
  let sections = empty_strs()
  let mut s = 0
  while s <= 3 {
    let rendered = render_section(kept, s)
    if rendered != "" {
      Array::push(sections, rendered)
    }
    s = s + 1
  }
  String::concat(String::join(sections, "\n\n"), "\n")
}
let line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {
  let len = String::length(source)
  let mut i = 0
  let mut cur_line = 1
  while cur_line < line && i < len {
    if String::char_code_at(source, i) == 10 {
      cur_line = cur_line + 1
    } else {
      ()
    }
    i = i + 1
  }
  let off = i + (col - 1)
  if off < 0 {
    0
  } else if off > len {
    len
  } else {
    off
  }
}
enum IdentHit {
  IdentHit(String, Int)
}
let empty_hits: () -> Array[IdentHit] = () -> {
  Array::slice([
    IdentHit("", -1)
  ], 0, 0)
}
let rec collect_expr: (Expr, Array[IdentHit]) -> Unit = (expr, acc) -> {
  match expr {
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EIdent(name, off) => {
      if off >= 0 {
        Array::push(acc, IdentHit(name, off))
      } else {
        ()
      }
    },
    EUnit => (),
    EStringInterp(_) => (),
    ETuple(items) => collect_exprs(items, acc),
    EArray(items) => collect_exprs(items, acc),
    ERecord(fields) => collect_field_exprs(fields, acc),
    EIf(c, t, e) => {
      collect_expr(c, acc)
      collect_expr(t, acc)
      collect_expr(e, acc)
    },
    ELet(_, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    ELetRec(_, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    ELetMut(_, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    EAssign(_, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    EAssignOp(_, _, v, b) => {
      collect_expr(v, acc)
      collect_expr(b, acc)
    },
    ESeq(a, b) => {
      collect_expr(a, acc)
      collect_expr(b, acc)
    },
    EMatch(s, arms) => {
      collect_expr(s, acc)
      collect_arm_exprs(arms, acc)
    },
    EHandle(s, arms) => {
      collect_expr(s, acc)
      collect_arm_exprs(arms, acc)
    },
    EWhile(c, b) => {
      collect_expr(c, acc)
      collect_expr(b, acc)
    },
    ELoop(params, b) => {
      collect_loop_param_exprs(params, acc)
      collect_expr(b, acc)
    },
    EForIn(_, _, it, b) => {
      collect_expr(it, acc)
      collect_expr(b, acc)
    },
    ECall(callee, args, _) => {
      collect_expr(callee, acc)
      collect_exprs(args, acc)
    },
    EBinOp(_, l, r) => {
      collect_expr(l, acc)
      collect_expr(r, acc)
    },
    EUnaryOp(_, e) => collect_expr(e, acc),
    EFn(_, _, _, _, _, body) => collect_expr(body, acc),
    EDot(e, _, _) => collect_expr(e, acc),
    ELabeledArg(_, _, v) => collect_expr(v, acc),
    EThrow(e) => collect_expr(e, acc),
    EReturn(e) => collect_expr(e, acc),
    EBreak(opt) => match opt {
      Some(v) => collect_expr(v, acc),
      None => ()
    },
    EContinue(args) => collect_exprs(args, acc),
    EMap(fields) => collect_field_exprs(fields, acc),
    ESpread(e) => collect_expr(e, acc)
  }
}
let collect_exprs: (Array[Expr], Array[IdentHit]) -> Unit = (items, acc) -> {
  let mut i = 0
  while i < Array::length(items) {
    collect_expr(Array::get(items, i), acc)
    i = i + 1
  }
}
let collect_field_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (fields, acc) -> {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    collect_expr(v, acc)
    i = i + 1
  }
}
let collect_arm_exprs: (Array[(Pat, Expr)], Array[IdentHit]) -> Unit = (arms, acc) -> {
  let mut i = 0
  while i < Array::length(arms) {
    let (_, e) = Array::get(arms, i)
    collect_expr(e, acc)
    i = i + 1
  }
}
let collect_loop_param_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (params, acc) -> {
  let mut i = 0
  while i < Array::length(params) {
    let (_, init) = Array::get(params, i)
    collect_expr(init, acc)
    i = i + 1
  }
}
let collect_stmt: (Stmt, Array[IdentHit]) -> Unit = (stmt, acc) -> {
  match stmt {
    SLet(_, _, _, _, body) => collect_expr(body, acc),
    SLetMut(_, _, body) => collect_expr(body, acc),
    STest(_, body) => collect_expr(body, acc),
    SBench(_, body) => collect_expr(body, acc),
    SExpr(e) => collect_expr(e, acc),
    SLetPat(_, body) => collect_expr(body, acc),
    SModule(_, _, body) => collect_stmts(body, acc),
    _ => ()
  }
}
let collect_stmts: (Array[Stmt], Array[IdentHit]) -> Unit = (stmts, acc) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    collect_stmt(Array::get(stmts, i), acc)
    i = i + 1
  }
}
let is_boundary_at: (String, Int) -> Bool = (source, off) -> {
  if off < 0 || off >= String::length(source) {
    true
  } else {
    let c = String::char_code_at(source, off)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    !is_id
  }
}
let push_binding_name_hit: (String, Int, Int, String, Array[IdentHit]) -> Unit = (source, start, end, name, acc) -> {
  let nlen = String::length(name)
  if nlen == 0 {
    ()
  } else {
    let limit = if end > String::length(source) { String::length(source) } else { end }
    let mut i = if start < 0 { 0 } else { start }
    let mut found = false
    while !found && i + nlen <= limit {
      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {
        Array::push(acc, IdentHit(name, i))
        found = true
      } else {
        i = i + 1
      }
    }
  }
}
let collect_binding_name_hits: (Array[Stmt], Array[Int], Array[Int], String, Array[IdentHit]) -> Unit = (stmts, span_start, span_end, source, acc) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    let start = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }
    let end = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }
    match Array::get(stmts, i) {
      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),
      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),
      _ => ()
    }
    i = i + 1
  }
}
let pick_ident_at: (Array[IdentHit], Int) -> String = (hits, tgt) -> {
  let mut best_name = ""
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    match Array::get(hits, i) {
      IdentHit(name, off) => {
        let span_end = off + String::length(name)
        if off <= tgt && tgt < span_end && off > best_off {
          best_name = name
          best_off = off
        } else {
          ()
        }
      }
    }
    i = i + 1
  }
  best_name
}
let pick_ident_off: (Array[IdentHit], Int) -> Int = (hits, tgt) -> {
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    match Array::get(hits, i) {
      IdentHit(name, off) => {
        let span_end = off + String::length(name)
        if off <= tgt && tgt < span_end && off > best_off {
          best_off = off
        } else {
          ()
        }
      }
    }
    i = i + 1
  }
  best_off
}
let tytab_lookup: (Array[(Int, Type)], Int) -> Option[Type] = (table, off) -> {
  let mut found = None
  let mut i = 0
  while i < Array::length(table) {
    let (toff, tty) = Array::get(table, i)
    if toff == off {
      found = Some(tty)
    } else {
      ()
    }
    i = i + 1
  }
  found
}
export let type_at_source: (String, Int, Int) -> String = (source, line, col) -> {
  handle {
    let tgt = line_col_to_offset(source, line, col)
    let (tokens, starts, ends) = lex_with_offsets(source)
    let stmts = parse_program_located(tokens, starts, source)
    let hits = empty_hits()
    collect_stmts(stmts, hits)
    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)
    collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)
    let name = pick_ident_at(hits, tgt)
    if name == "" {
      ""
    } else {
      let chosen_off = pick_ident_off(hits, tgt)
      let (table, final_s) = check_program_type_table(stmts)
      let table_hit = if chosen_off >= 0 {
        tytab_lookup(table, chosen_off)
      } else {
        None
      }
      match table_hit {
        Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),
        None => {
          let env = check_program(stmts)
          match env_lookup(env, name) {
            Some(t) => type_to_string(t),
            None => ""
          }
        }
      }
    }
  } with Error {
    Throw(_) => ""
  }
}
let bind_line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {
  let len = String::length(source)
  let mut i = 0
  let mut cur_line = 1
  while cur_line < line && i < len {
    if String::char_code_at(source, i) == 10 {
      cur_line = cur_line + 1
    } else {
      ()
    }
    i = i + 1
  }
  let off = i + (col - 1)
  if off < 0 {
    0
  } else if off > len {
    len
  } else {
    off
  }
}
enum BindHit {
  BindHit(String, Int, Int)
}
let bind_empty_hits: () -> Array[BindHit] = () -> {
  Array::slice([
    BindHit("", -1, 0)
  ], 0, 0)
}
let bind_is_boundary_at: (String, Int) -> Bool = (source, off) -> {
  if off < 0 || off >= String::length(source) {
    true
  } else {
    let c = String::char_code_at(source, off)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    !is_id
  }
}
let bind_find_word: (String, String, Int) -> Int = (source, name, from) -> {
  let nlen = String::length(name)
  if nlen == 0 {
    -1
  } else {
    let limit = String::length(source)
    let mut i = if from < 0 { 0 } else { from }
    let mut found = -1
    while found < 0 && i + nlen <= limit {
      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {
        found = i
      } else {
        i = i + 1
      }
    }
    found
  }
}
struct BindState {
  hits: Array[BindHit];
  scope_names: Array[String];
  scope_ids: Array[Int];
  floor: Array[Int];
  source: String
}
let bind_box_int: (Int) -> Array[Int] = (v) -> {
  let arr = Array::slice([0], 0, 0)
  Array::push(arr, v)
  arr
}
let bind_new_state: (String) -> BindState = (source) -> {
  BindState::{
    hits: bind_empty_hits(),
    scope_names: Array::slice([""], 0, 0),
    scope_ids: Array::slice([0], 0, 0),
    floor: bind_box_int(0),
    source: source
  }
}
let bind_resolve: (BindState, String) -> Int = (st, name) -> {
  let n = Array::length(st.scope_names)
  let mut i = n - 1
  let mut found = 0
  while i >= 0 && found == 0 {
    if Array::get(st.scope_names, i) == name {
      found = Array::get(st.scope_ids, i)
    } else {
      ()
    }
    i = i - 1
  }
  found
}
let bind_pop_scope: (BindState, Int) -> Unit = (st, mark) -> {
  Array::truncate(st.scope_names, mark)
  Array::truncate(st.scope_ids, mark)
}
let bind_recover_binder: (BindState, String) -> Int = (st, name) -> {
  let from = Array::get(st.floor, 0)
  let off = bind_find_word(st.source, name, from)
  let id = if off >= 0 { off + 1 } else { 0 }
  if off >= 0 {
    Array::push(st.hits, BindHit(name, off, id))
    Array::set(st.floor, 0, off + String::length(name))
  } else {
    ()
  }
  id
}
let bind_push_binder: (BindState, String, Int) -> Unit = (st, name, id) -> {
  Array::push(st.scope_names, name)
  Array::push(st.scope_ids, id)
}
let bind_introduce: (BindState, String) -> Unit = (st, name) -> {
  let id = bind_recover_binder(st, name)
  bind_push_binder(st, name, id)
}
let bind_record_ref: (BindState, String, Int) -> Unit = (st, name, off) -> {
  if off >= 0 {
    let key = bind_resolve(st, name)
    Array::push(st.hits, BindHit(name, off, key))
    if off >= Array::get(st.floor, 0) {
      Array::set(st.floor, 0, off + String::length(name))
    } else {
      ()
    }
  } else {
    ()
  }
}
let bind_record_assign_target: (BindState, String) -> Unit = (st, name) -> {
  let key = bind_resolve(st, name)
  let from = Array::get(st.floor, 0)
  let off = bind_find_word(st.source, name, from)
  if off >= 0 {
    Array::push(st.hits, BindHit(name, off, key))
    Array::set(st.floor, 0, off + String::length(name))
  } else {
    ()
  }
}
let rec bind_introduce_pat: (BindState, Pat) -> Unit = (st, pat) -> {
  match pat {
    PWild => (),
    PBind(name) => bind_introduce(st, name),
    PInt(_) => (),
    PString(_) => (),
    PBool(_) => (),
    PCtor(_, sub) => bind_introduce_pats(st, sub),
    PTuple(sub) => bind_introduce_pats(st, sub),
    POr(a, b) => {
      bind_introduce_pat(st, a)
      bind_introduce_pat(st, b)
    },
    PStruct(_, fields) => {
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fp) = Array::get(fields, i)
        bind_introduce_pat(st, fp)
        i = i + 1
      }
    }
  }
}
let bind_introduce_pats: (BindState, Array[Pat]) -> Unit = (st, sub) -> {
  let mut i = 0
  while i < Array::length(sub) {
    bind_introduce_pat(st, Array::get(sub, i))
    i = i + 1
  }
}
let rec bind_walk_expr: (BindState, Expr) -> Unit = (st, expr) -> {
  match expr {
    EInt(_) => (),
    EFloat(_) => (),
    EString(_) => (),
    EBool(_) => (),
    EIdent(name, off) => bind_record_ref(st, name, off),
    EUnit => (),
    EStringInterp(_) => (),
    ETuple(items) => bind_walk_exprs(st, items),
    EArray(items) => bind_walk_exprs(st, items),
    ERecord(fields) => bind_walk_field_exprs(st, fields),
    EIf(c, t, e) => {
      bind_walk_expr(st, c)
      bind_walk_expr(st, t)
      bind_walk_expr(st, e)
    },
    ELet(name, v, b) => {
      let id = bind_recover_binder(st, name)
      bind_walk_expr(st, v)
      let mark = Array::length(st.scope_names)
      bind_push_binder(st, name, id)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    ELetRec(name, v, b) => {
      let mark = Array::length(st.scope_names)
      bind_introduce(st, name)
      bind_walk_expr(st, v)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    ELetMut(name, v, b) => {
      let id = bind_recover_binder(st, name)
      bind_walk_expr(st, v)
      let mark = Array::length(st.scope_names)
      bind_push_binder(st, name, id)
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    EAssign(name, v, b) => {
      bind_record_assign_target(st, name)
      bind_walk_expr(st, v)
      bind_walk_expr(st, b)
    },
    EAssignOp(name, _, v, b) => {
      bind_record_assign_target(st, name)
      bind_walk_expr(st, v)
      bind_walk_expr(st, b)
    },
    ESeq(a, b) => {
      bind_walk_expr(st, a)
      bind_walk_expr(st, b)
    },
    EMatch(s, arms) => {
      bind_walk_expr(st, s)
      bind_walk_arms(st, arms)
    },
    EHandle(s, arms) => {
      bind_walk_expr(st, s)
      bind_walk_arms(st, arms)
    },
    EWhile(c, b) => {
      bind_walk_expr(st, c)
      bind_walk_expr(st, b)
    },
    ELoop(params, b) => {
      let mark = Array::length(st.scope_names)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, init) = Array::get(params, i)
        bind_walk_expr(st, init)
        bind_introduce(st, pname)
        i = i + 1
      }
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    EForIn(name, idx_opt, it, b) => {
      bind_walk_expr(st, it)
      let mark = Array::length(st.scope_names)
      bind_introduce(st, name)
      match idx_opt {
        Some(idx) => bind_introduce(st, idx),
        None => ()
      }
      bind_walk_expr(st, b)
      bind_pop_scope(st, mark)
    },
    ECall(callee, args, _) => {
      bind_walk_expr(st, callee)
      bind_walk_exprs(st, args)
    },
    EBinOp(_, l, r) => {
      bind_walk_expr(st, l)
      bind_walk_expr(st, r)
    },
    EUnaryOp(_, e) => bind_walk_expr(st, e),
    EFn(_, _, params, _, _, body) => {
      let mark = Array::length(st.scope_names)
      let mut i = 0
      while i < Array::length(params) {
        let (pname, _) = Array::get(params, i)
        bind_introduce(st, pname)
        i = i + 1
      }
      bind_walk_expr(st, body)
      bind_pop_scope(st, mark)
    },
    EDot(e, _, _) => bind_walk_expr(st, e),
    ELabeledArg(_, _, v) => bind_walk_expr(st, v),
    EThrow(e) => bind_walk_expr(st, e),
    EReturn(e) => bind_walk_expr(st, e),
    EBreak(opt) => match opt {
      Some(v) => bind_walk_expr(st, v),
      None => ()
    },
    EContinue(args) => bind_walk_exprs(st, args),
    EMap(fields) => bind_walk_field_exprs(st, fields),
    ESpread(e) => bind_walk_expr(st, e)
  }
}
let bind_walk_exprs: (BindState, Array[Expr]) -> Unit = (st, items) -> {
  let mut i = 0
  while i < Array::length(items) {
    bind_walk_expr(st, Array::get(items, i))
    i = i + 1
  }
}
let bind_walk_field_exprs: (BindState, Array[(String, Expr)]) -> Unit = (st, fields) -> {
  let mut i = 0
  while i < Array::length(fields) {
    let (_, v) = Array::get(fields, i)
    bind_walk_expr(st, v)
    i = i + 1
  }
}
let bind_walk_arms: (BindState, Array[(Pat, Expr)]) -> Unit = (st, arms) -> {
  let mut i = 0
  while i < Array::length(arms) {
    let (pat, e) = Array::get(arms, i)
    let mark = Array::length(st.scope_names)
    bind_introduce_pat(st, pat)
    bind_walk_expr(st, e)
    bind_pop_scope(st, mark)
    i = i + 1
  }
}
let bind_record_module_binder: (BindState, String) -> Unit = (st, name) -> {
  let from = Array::get(st.floor, 0)
  let off = bind_find_word(st.source, name, from)
  if off >= 0 {
    Array::push(st.hits, BindHit(name, off, 0))
    Array::set(st.floor, 0, off + String::length(name))
  } else {
    ()
  }
}
let bind_walk_stmt: (BindState, Stmt) -> Unit = (st, stmt) -> {
  match stmt {
    SLet(_, _, name, _, body) => {
      bind_record_module_binder(st, name)
      bind_walk_expr(st, body)
    },
    SLetMut(name, _, body) => {
      bind_record_module_binder(st, name)
      bind_walk_expr(st, body)
    },
    STest(_, body) => bind_walk_expr(st, body),
    SBench(_, body) => bind_walk_expr(st, body),
    SExpr(e) => bind_walk_expr(st, e),
    SLetPat(_, body) => bind_walk_expr(st, body),
    SModule(_, _, body) => bind_walk_stmts(st, body),
    _ => ()
  }
}
let bind_walk_stmts: (BindState, Array[Stmt]) -> Unit = (st, stmts) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    bind_walk_stmt(st, Array::get(stmts, i))
    i = i + 1
  }
}
let bind_pick_at: (Array[BindHit], Int) -> (String, Int) = (hits, tgt) -> {
  let mut best_name = ""
  let mut best_key = 0
  let mut best_off = -1
  let mut i = 0
  while i < Array::length(hits) {
    match Array::get(hits, i) {
      BindHit(name, off, key) => {
        let span_end = off + String::length(name)
        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {
          best_name = name
          best_key = key
          best_off = off
        } else {
          ()
        }
      }
    }
    i = i + 1
  }
  (best_name, best_key)
}
let bind_insert_sorted_unique: (Array[(Int, Int)], Int, Int) -> Unit = (out, start, end) -> {
  let n = Array::length(out)
  let mut dup = false
  let mut idx = n
  let mut j = 0
  while j < n {
    let (s, _) = Array::get(out, j)
    if s == start {
      dup = true
    } else {
      ()
    }
    if s > start && idx == n {
      idx = j
    } else {
      ()
    }
    j = j + 1
  }
  if dup {
    ()
  } else if idx == n {
    Array::push(out, (start, end))
  } else {
    Array::push(out, Array::get(out, n - 1))
    let mut k = n - 1
    while k > idx {
      Array::set(out, k, Array::get(out, k - 1))
      k = k - 1
    }
    Array::set(out, idx, (start, end))
  }
}
let binding_occurrences_impl: (String, Int, Int) -> Array[(Int, Int)] with { Error } = (source, line, col) -> {
  {
    let tgt = bind_line_col_to_offset(source, line, col)
    let (tokens, starts, _ends) = lex_with_offsets(source)
    let stmts = parse_program_located(tokens, starts, source)
    let st = bind_new_state(source)
    bind_walk_stmts(st, stmts)
    let hits = st.hits
    let (name, key) = bind_pick_at(hits, tgt)
    let out = Array::slice([
      (0, 0)
    ], 0, 0)
    if name == "" {
      out
    } else {
      let mut i = 0
      while i < Array::length(hits) {
        match Array::get(hits, i) {
          BindHit(hname, hoff, hkey) => {
            if hname == name && hkey == key && hoff >= 0 {
              bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))
            } else {
              ()
            }
          }
        }
        i = i + 1
      }
      out
    }
  }
}
export let binding_occurrences: (String, Int, Int) -> Array[(Int, Int)] = (source, line, col) -> {
  handle {
    binding_occurrences_impl(source, line, col)
  } with Error {
    Throw(_) => Array::slice([
      (0, 0)
    ], 0, 0)
  }
}
let sym_is_boundary_at: (String, Int) -> Bool = (source, off) -> {
  if off < 0 || off >= String::length(source) {
    true
  } else {
    let c = String::char_code_at(source, off)
    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'
    !is_id
  }
}
let sym_box_int: (Int) -> Array[Int] = (v) -> {
  let arr = Array::slice([0], 0, 0)
  Array::push(arr, v)
  arr
}
let sym_empty_items: () -> Array[(String, Int, Int, Int)] = () -> {
  Array::slice([
    ("", 0, 0, 0)
  ], 0, 0)
}
let sym_emit: (Array[(String, Int, Int, Int)], String, String, Int, Array[Int], Int) -> Unit = (out, source, name, kind, floor, hi) -> {
  let nlen = String::length(name)
  if nlen == 0 {
    ()
  } else {
    let limit = if hi > String::length(source) { String::length(source) } else { hi }
    let mut i = Array::get(floor, 0)
    if i < 0 {
      i = 0
    } else {
      ()
    }
    let mut found = false
    while !found && i + nlen <= limit {
      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {
        Array::push(out, (name, kind, i, i + nlen))
        Array::set(floor, 0, i + nlen)
        found = true
      } else {
        i = i + 1
      }
    }
  }
}
let sym_let_kind: (Expr) -> Int = (body) -> {
  match body {
    EFn(_, _, _, _, _, _) => 12,
    _ => 13
  }
}
let rec sym_walk_stmt: (Array[(String, Int, Int, Int)], String, Stmt, Array[Int], Int) -> Unit = (out, source, stmt, floor, hi) -> {
  match stmt {
    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),
    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),
    SEnum(_, name, _, _) => sym_emit(out, source, name, 10, floor, hi),
    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),
    SStruct(_, name, _, _, _) => sym_emit(out, source, name, 23, floor, hi),
    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),
    STrait(_, name, _, _) => sym_emit(out, source, name, 11, floor, hi),
    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),
    SModule(_, name, body) => {
      sym_emit(out, source, name, 2, floor, hi)
      let mut j = 0
      while j < Array::length(body) {
        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)
        j = j + 1
      }
    },
    _ => ()
  }
}
let symbol_spans_impl: (String) -> Array[(String, Int, Int, Int)] with { Error } = (source) -> {
  {
    let (tokens, starts, ends) = lex_with_offsets(source)
    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)
    let out = sym_empty_items()
    let mut i = 0
    while i < Array::length(span_stmts) {
      let lo = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }
      let hi = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }
      let floor = sym_box_int(lo)
      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)
      i = i + 1
    }
    out
  }
}
export let symbol_spans: (String) -> Array[(String, Int, Int, Int)] = (source) -> {
  handle {
    symbol_spans_impl(source)
  } with Error {
    Throw(_) => Array::slice([
      ("", 0, 0, 0)
    ], 0, 0)
  }
}
let join_lines: (Array[String]) -> String = (items) -> {
  let n = Array::length(items)
  if n == 0 {
    ""
  } else {
    let mut acc = Array::get(items, 0)
    let mut i = 1
    while i < n {
      acc = String::concat(acc, String::concat("\n", Array::get(items, i)))
      i = i + 1
    }
    acc
  }
}
let join_symbol_spans: (Array[(String, Int, Int, Int)]) -> String = (syms) -> {
  let n = Array::length(syms)
  let mut acc = ""
  let mut first = true
  let mut i = 0
  while i < n {
    let (name, kind, s, e) = Array::get(syms, i)
    if String::length(name) == 0 {
      ()
    } else {
      let line = String::concat(name, String::concat(" ", String::concat(__to_string(kind), String::concat(" ", String::concat(__to_string(s), String::concat(" ", __to_string(e)))))))
      if first {
        acc = line
        first = false
      } else {
        acc = String::concat(acc, String::concat("\n", line))
      }
    }
    i = i + 1
  }
  acc
}
let join_binding_occurrences: (Array[(Int, Int)]) -> String = (occ) -> {
  let n = Array::length(occ)
  if n == 0 {
    ""
  } else {
    let (s0, e0) = Array::get(occ, 0)
    let mut acc = String::concat(__to_string(s0), String::concat(" ", __to_string(e0)))
    let mut i = 1
    while i < n {
      let (s, e) = Array::get(occ, i)
      let line = String::concat(__to_string(s), String::concat(" ", __to_string(e)))
      acc = String::concat(acc, String::concat("\n", line))
      i = i + 1
    }
    acc
  }
}
let parse_int_or: (String, Int) -> Int = (s, default) -> {
  let len = String::length(s)
  if len == 0 {
    default
  } else {
    let mut i = 0
    let mut acc = 0
    let mut ok = true
    while ok && i < len {
      let c = String::char_code_at(s, i)
      if c >= '0' && c <= '9' {
        acc = acc * 10 + (c - '0')
        i = i + 1
      } else {
        ok = false
      }
    }
    if ok {
      acc
    } else {
      default
    }
  }
}
let adapter_string_to_bytes: (String) -> Bytes = (s) -> {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}
let read_arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {
  let value = Env::args_get(index)
  if value != "" {
    value
  } else {
    Env::get(env_name)
  }
}
let own_host_string: (String) -> String = (value) -> {
  String::concat("", value)
}
let profile_memory_mark: (Bool) -> Unit with { Env } = (enabled) -> {
  if enabled {
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK")
    ()
  } else {
    ()
  }
}
let compile_source_for_rc_flag: (String, String, String) -> Bytes with { Error } = (source, entry_name, rc_flag) -> {
  if rc_flag == "1" {
    compile_source_wasi_only_rc(source, entry_name)
  } else {
    compile_source_wasi_only(source, entry_name)
  }
}
let emit_compile_diag: (String, String) -> Int with { Fs } = (output_path, msg) -> {
  Fs::write_file(String::concat(output_path, ".diag"), msg)
  1
}
let write_funcmap_sidecar: (String, String) -> Int with { Fs, Error } = (input_path, output_path) -> {
  let src = Fs::read_file(input_path)
  let text = build_funcmap_from_source(src)
  Fs::write_bytes(String::concat(output_path, ".funcmap"), adapter_string_to_bytes(text))
  0
}
export let cli_main: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = own_host_string(read_arg_or_env(0, "VIBE_INPUT"))
  let output_path = own_host_string(read_arg_or_env(1, "VIBE_OUTPUT"))
  let entry_name = own_host_string(read_arg_or_env(2, "VIBE_ENTRY"))
  let mark_memory = Env::get("VIBE_PROFILE_MEMORY_MARKS") == "1"
  if Env::get("VIBE_FS_COMPILE") == "1" {
    return handle {
      let bytes = if Env::get("VIBE_COVERAGE") == "1" {
        compile_file_fs_mode_coverage(input_path, entry_name)
      } else if Env::get("VIBE_DEBUG_BREAK") == "1" {
        compile_file_fs_mode_break(input_path, entry_name)
      } else if Env::get("VIBE_DEBUG") == "1" {
        compile_file_fs_mode_trace(input_path, entry_name)
      } else {
        compile_file_fs_mode(input_path, entry_name, "no-dce")
      }
      Fs::write_bytes(output_path, bytes)
      let _funcmap_rc = handle {
        write_funcmap_sidecar(input_path, output_path)
      } with Error {
        Throw(_) => 0
      }
      0
    } with Error {
      Throw(msg) => emit_compile_diag(output_path, msg)
    }
  }
  if Env::get("VIBE_NORMALIZE") == "1" {
    let normalized = normalize_source(Fs::read_file(input_path))
    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))
    return 0
  }
  if Env::get("VIBE_TYPE_AT") == "1" {
    let src = Fs::read_file(input_path)
    let line = parse_int_or(Env::get("VIBE_TYPE_LINE"), 1)
    let col = parse_int_or(Env::get("VIBE_TYPE_COL"), 1)
    let ty = type_at_source(src, line, col)
    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))
    return 0
  }
  if Env::get("VIBE_BINDING_AT") == "1" {
    let src = Fs::read_file(input_path)
    let line = parse_int_or(Env::get("VIBE_TYPE_LINE"), 1)
    let col = parse_int_or(Env::get("VIBE_TYPE_COL"), 1)
    let occ = binding_occurrences(src, line, col)
    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))
    return 0
  }
  if Env::get("VIBE_SYMBOLS") == "1" {
    let src = Fs::read_file(input_path)
    let syms = symbol_spans(src)
    Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))
    return 0
  }
  if Env::get("VIBE_DIAGNOSTICS") == "1" {
    let src = Fs::read_file(input_path)
    let diags = collect_all_diagnostics(src)
    Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))
    return 0
  }
  let source = Fs::read_file(input_path)
  profile_memory_mark(mark_memory)
  if Env::get("VIBE_EMIT_MODULE_SOURCE") == "1" {
    let module_source = build_module_source_from_source(source, entry_name)
    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))
    profile_memory_mark(mark_memory)
    0
  } else {
    handle {
      let rc_flag = Env::get("VIBE_RC")
      let bytes = if Env::get("VIBE_COVERAGE") == "1" {
        compile_source_wasi_only_coverage(source, entry_name)
      } else {
        compile_source_for_rc_flag(source, entry_name, rc_flag)
      }
      profile_memory_mark(mark_memory)
      Fs::write_bytes(output_path, bytes)
      profile_memory_mark(mark_memory)
      0
    } with Error {
      Throw(msg) => emit_compile_diag(output_path, msg)
    }
  }
}
