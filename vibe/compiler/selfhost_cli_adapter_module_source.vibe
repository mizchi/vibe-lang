let entry_declares_async_int: (Array[Stmt], String) -> Bool = (stmts, entry_name) -> {
  let mut found = false
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(_, _, name, opt_ty, _) => if name == entry_name {
        match opt_ty {
          Some(ty) => match ty {
            TyFn(params, ret, opt_eff) => match opt_eff {
              Some(eff) => if String::contains(eff, "Async") && Array::length(params) == 0 {
                match ret {
                  TyName(rn) => if rn == "Int" {
                    found = true
                  } else {
                    ()
                  },
                  _ => ()
                }
              } else {
                ()
              },
              None => ()
            },
            _ => ()
          },
          None => ()
        }
      } else {
        ()
      },
      _ => ()
    }
    i = i + 1
  }
  found
}

let maybe_wrap_async_component: (Bytes, Bool) -> Bytes = (bytes, wrap_async) -> {
  if wrap_async {
    comp_emit_component_wasm_async_trampolined_p1(bytes, "run", 120)
  } else {
    bytes
  }
}

export let compile_source_wasi_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)
}

export let compile_source_wasi_only_rc: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  let wrap_async = (entry_name == "run") && entry_declares_async_int(stmts, entry_name)
  strip_generic_type_params(stmts)
  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)
}





export {
  expand_interp_stmts, compile_source_wasi_only, compile_source_wasi_only_rc, strip_generic_type_params
}



let read_arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {
  let value = Env::args_get(index)
  if value != "" {
    value
  } else {
    Env::get(env_name)
  }
}

let own_host_string: (String) -> String = (value) -> {
  String::concat("", value)
}

let profile_memory_mark: (Bool) -> Unit with { Env } = (enabled) -> {
  if enabled {
    let _ = Env::get("VIBE_PROFILE_MEMORY_MARK")
    ()
  } else {
    ()
  }
}

let compile_source_for_rc_flag: (String, String, String) -> Bytes with { Error } = (source, entry_name, rc_flag) -> {
  if rc_flag == "1" {
    compile_source_wasi_only_rc(source, entry_name)
  } else {
    compile_source_wasi_only(source, entry_name)
  }
}

export let cli_main: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = own_host_string(read_arg_or_env(0, "VIBE_INPUT"))
  let output_path = own_host_string(read_arg_or_env(1, "VIBE_OUTPUT"))
  let entry_name = own_host_string(read_arg_or_env(2, "VIBE_ENTRY"))
  let mark_memory = Env::get("VIBE_PROFILE_MEMORY_MARKS") == "1"
  let source = Fs::read_file(input_path)
  profile_memory_mark(mark_memory)
  let rc_flag = Env::get("VIBE_RC")
  let bytes = compile_source_for_rc_flag(source, entry_name, rc_flag)
  profile_memory_mark(mark_memory)
  Fs::write_bytes(output_path, bytes)
  profile_memory_mark(mark_memory)
  0
}
