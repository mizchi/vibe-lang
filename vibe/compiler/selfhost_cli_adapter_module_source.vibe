export let resolve_local: (Array[String], String, String) -> Int with { Error } = (names, name, tag) -> {
  let mut i = Array::length(names) - 1
  let mut result = -1
  while i >= 0 {
    if Array::get(names, i) == name {
      result = i
      i = -1
    } else {
      i = i - 1
    }
  }
  if result < 0 {
    throw(String::concat(String::concat("undefined variable (local): ", name), String::concat(" @", tag)))
  }
  result
}

export let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {
  bytebuf_push(buf, op_i64_store)
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_box_float: (Bytes, CompileCtx, Int, Int) -> Unit = (buf, ctx, bits_local, box_local) -> {
  emit_local_set(buf, bits_local)
  emit_i64_const(buf, 16)
  emit_call(buf, ctx.rc_alloc_func_idx)
  emit_local_set(buf, box_local)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 16)
  emit_i32_store(buf, 2, 0)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_i32_const(buf, 1)
  emit_i32_store(buf, 2, 4)
  emit_local_get(buf, box_local)
  emit_i32_wrap_i64(buf)
  emit_local_get(buf, bits_local)
  emit_i64_store(buf, 3, 8)
  emit_local_get(buf, box_local)
  emit_i64_const(buf, 8)
  emit_i64_add(buf)
  emit_i64_const(buf, 1)
  emit_i64_or(buf)
}

export let find_func_stmt: (Array[Stmt], String) -> Stmt with { Error } = (stmts, name) -> {
  let len = Array::length(stmts)
  let mut i = 0
  let mut found = -1
  while i < len {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => if sname == name {
        found = i
        i = len
      },
      _ => ()
    }
    if found < 0 {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("function not found: ", name))
  }
  Array::get(stmts, found)
}

export let emit_unbox_float: (Bytes) -> Unit = (buf) -> {
  emit_i64_const(buf, -2)
  emit_i64_and(buf)
  emit_i32_wrap_i64(buf)
  emit_i64_load(buf, 3, 0)
}

export let fn_type_param_types: (Option[TypeExpr]) -> Option[Array[TypeExpr]] = (ty) -> {
  match ty {
    Some(t) =>
    match t {
      TyFn(args, _, _) => Some(args),
      _ => None
    },
    None => None
  }
}

export let is_nullary_ctor_ident: (Expr, CtorTable) -> Bool = (value, ct) -> {
  match value {
    EIdent(nm) => lookup_ctor(ct.names, nm, 0) >= 0,
    _ => false
  }
}

export let name_has_effect_prefix: (String, String) -> Bool = (full, eff) -> {
  let el = String::length(eff)
  let fl = String::length(full)
  if fl < el + 2 {
    false
  } else {
    let mut ok = true
    let mut j = 0
    while j < el {
      if String::char_code_at(full, j) != String::char_code_at(eff, j) {
        ok = false
        j = el
      } else {
        j = j + 1
      }
    }
    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58
  }
}

export let effect_name_to_tag: (Array[String], String) -> Int = (effect_names, full) -> {
  let n = Array::length(effect_names)
  let mut result = 3 + n
  let mut i = 0
  while i < n {
    if name_has_effect_prefix(full, Array::get(effect_names, i)) {
      result = 3 + i
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

export let effect_op_declared_arity: (Array[String], Array[Int], String) -> Int = (keys, arities, full) -> {
  let n = Array::length(keys)
  let mut result = -1
  let mut i = 0
  while i < n {
    if Array::get(keys, i) == full {
      result = Array::get(arities, i)
      i = n
    } else {
      i = i + 1
    }
  }
  result
}

export let emit_heap_grow_after_heap_set: (Bytes, CompileCtx) -> Unit = (buf, ctx) -> {
  if ctx.heap_grow_check_func_idx >= 0 {
    emit_call(buf, ctx.heap_grow_check_func_idx)
  } else {
    ()
  }
}







export let gen_eq_body: (Int) -> Bytes = (str_eq_idx) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_i64_eq(b)
  emit_if_i64(b)
  emit_i64_const(b, 1)
  emit_else(b)
  emit_local_get(b, 0)
  emit_local_get(b, 1)
  emit_call(b, str_eq_idx)
  emit_end(b)
  b
}







export let gen_str_eq_body: () -> Bytes = () -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 2)
  emit_local_get(b, 1)
  emit_i64_const(b, 4294967295)
  emit_i64_and(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 3)
  emit_local_get(b, 2)
  emit_local_get(b, 3)
  emit_i32_ne(b)
  emit_if_i64(b)
  emit_i64_const(b, 0)
  emit_else(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 4)
  emit_local_get(b, 1)
  emit_i64_const(b, 32)
  emit_i64_shr_s(b)
  emit_i32_wrap_i64(b)
  emit_local_set(b, 5)
  emit_i32_const(b, 0)
  emit_local_set(b, 6)
  emit_block_i64(b)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 6)
  emit_local_get(b, 2)
  emit_i32_ge_u(b)
  emit_br_if(b, 1)
  emit_local_get(b, 4)
  emit_local_get(b, 6)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_local_get(b, 5)
  emit_local_get(b, 6)
  emit_i32_add(b)
  emit_i32_load8_u(b, 0, 0)
  emit_i32_ne(b)
  emit_if_void(b)
  emit_i64_const(b, 0)
  emit_br(b, 3)
  emit_end(b)
  emit_local_get(b, 6)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_local_set(b, 6)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_i64_const(b, 1)
  emit_end(b)
  emit_end(b)
  b
}




export {
  gen_eq_body, gen_str_eq_body
}







export let gen_arr_get_body: (Bool) -> Bytes = (enable_rc) -> {
  let b = bytebuf_new()
  emit_local_get(b, 0)
  if enable_rc {
    emit_i64_const(b, -2)
    emit_i64_and(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_load(b, 2, 8)
  emit_local_set(b, 2)
  emit_local_get(b, 2)
  emit_local_get(b, 1)
  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shr_s(b)
  }
  emit_i32_wrap_i64(b)
  emit_i32_const(b, 3)
  bytebuf_push(b, 116)
  emit_i32_add(b)
  emit_i64_load(b, 3, 0)
  b
}

export let gen_arr_len_body: (Bool) -> Bytes = (enable_rc) -> {
