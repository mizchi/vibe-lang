export let is_efn: (Expr) -> Bool = (expr) -> {
  match expr {
    EFn(_, _, _, _, _, _) => true,
    _ => false
  }
}
export let is_pint: (Pat) -> Bool = (p) -> {
  match p {
    PInt(_) => true,
    _ => false
  }
}
export let is_slet: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}
export let expr_tag: (Expr) -> Int = (expr) -> {
  match expr {
    EInt(_) => 0,
    EBool(_) => 1,
    EFloat(_) => 2,
    EString(_) => 3,
    EIdent(_, _) => 4,
    EBinOp(_, _, _) => 5,
    EUnaryOp(_, _) => 6,
    EIf(_, _, _) => 7,
    ECall(_, _, _) => 8,
    ELet(_, _, _) => 9,
    ELetRec(_, _, _) => 10,
    ELetMut(_, _, _) => 11,
    EAssign(_, _, _) => 12,
    EAssignOp(_, _, _, _) => 13,
    ESeq(_, _) => 14,
    ETuple(_) => 15,
    EMatch(_, _) => 16,
    EArray(_) => 17,
    EForIn(_, _, _, _) => 18,
    EWhile(_, _) => 19,
    EBreak(_) => 20,
    EContinue(_) => 21,
    EUnit => 22,
    EThrow(_) => 23,
    EFn(_, _, _, _, _, _) => 24,
    ELoop(_, _) => 25,
    EReturn(_) => 26,
    _ => -1
  }
}
export let is_pbind: (Pat) -> Bool = (p) -> {
  match p {
    PBind(_) => true,
    _ => false
  }
}
export let is_pbool: (Pat) -> Bool = (p) -> {
