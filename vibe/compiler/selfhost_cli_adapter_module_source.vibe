export let expand_interp_stmts: (Array[Stmt]) -> Unit with { Error } = (stmts) -> {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))
      ,
      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))
      ,
      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))
      ,
      _ => ()
    }
    i = i + 1
  }
}



export let strip_generic_type_params: (Array[Stmt]) -> Unit = (stmts) -> {
  let empty_tp = Array::slice([
    ""
  ], 0, 0)
  let empty_bounds = Array::slice([
    ("", Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {
          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))
        }
        ,
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}



