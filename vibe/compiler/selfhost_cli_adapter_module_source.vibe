export let str_table_lookup: (Array[String], String) -> Int with { Error } = (strs, s) -> {
  let len = Array::length(strs)
  let mut i = 0
  let mut found = -1
  while i < len {
    if Array::get(strs, i) == s {
      found = i
      i = len
    } else {
      i = i + 1
    }
  }
  if found < 0 {
    throw(String::concat("string not in table: ", s))
  }
  found
}

export let find_catchall_idx: (Array[(Pat, Expr)]) -> Int = (arms) -> {
  let num = Array::length(arms)
  let mut idx = 0
  let mut result = num
  while idx < num {
    let (p, _) = Array::get(arms, idx)
    if is_catchall_pat(p) {
      result = idx
      idx = num
    } else {
      idx = idx + 1
    }
  }
  result
}

