    TLBracket => "TLBracket",
    TRBracket => "TRBracket",
    TDotDot => "TDotDot",
    TDotDotDot => "TDotDotDot",
    TStringInterp(_) => "TStringInterp",
    TEof => "TEof"
  }
}



let is_ws: (Int) -> Bool = (c) -> {
  c == ' ' || c == '\n' || c == '\t' || c == '\r'
}

let is_alpha: (Int) -> Bool = (c) -> {
  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

let is_digit: (Int) -> Bool = (c) -> {
  c >= '0' && c <= '9'
}

let is_alnum: (Int) -> Bool = (c) -> {
  is_alpha(c) || is_digit(c)
}

let lex_char: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {
  let start = i + 1
  if start >= len {
    throw("unterminated char literal")
  }
  let c = String::char_code_at(s, start)
  if c == '\\' {
    let esc_pos = start + 1
    if esc_pos >= len {
      throw("unterminated char escape")
    }
    let esc = String::char_code_at(s, esc_pos)
    let val = if esc == 'n' {
      10
    }
    else if esc == 't' {
      9
    }
    else if esc == 'r' {
      13
    }
    else if esc == '\\' {
      92
    }
    else if esc == '\'' {
      39
    }
    else if esc == '0' {
      0
    }
    else throw("invalid char escape")
    let close = esc_pos + 1
    if close >= len || String::char_code_at(s, close) != '\'' {
      throw("expected closing quote for char literal")
    };
    (TInt(val), close + 1)
  } else {
    let close = start + 1
    if close >= len || String::char_code_at(s, close) != '\'' {
      throw("expected closing quote for char literal")
    };
    (TInt(c), close + 1)
  }
}

let slice_eq: (String, Int, Int, String) -> Bool = (source, start, end, text) -> {
  let len = end - start
  let text_len = String::length(text)
  if len != text_len {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while ok && i < text_len {
      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)
      i = i + 1
    }
    ok
  }
}

let is_hex_digit: (Int) -> Bool = (c) -> {
  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}

let keyword_lookup: (String, Int, Int) -> Option[Token] = (source, start, end) -> {
  let len = end - start
  if len == 2 {
    let c0 = String::char_code_at(source, start)
    if c0 == 'f' {
      if slice_eq(source, start, end, "fn") {
        Some(TIdent("fn"))
      } else None
    } else if c0 == 'i' {
      if slice_eq(source, start, end, "if") {
        Some(TIf)
      } else if slice_eq(source, start, end, "in") {
        Some(TIn)
      } else if slice_eq(source, start, end, "is") {
        Some(TIs)
      } else None
    } else if c0 == 'd' {
      if slice_eq(source, start, end, "do") {
        Some(TDo)
      } else None
    } else if c0 == 'a' {
      if slice_eq(source, start, end, "as") {
        Some(TAs)
      } else None
    } else None
  } else if len == 3 {
    let c0 = String::char_code_at(source, start)
    if c0 == 'l' {
      if slice_eq(source, start, end, "let") {
        Some(TLet)
      } else None
    } else if c0 == 'r' {
      if slice_eq(source, start, end, "rec") {
        Some(TRec)
      } else None
    } else if c0 == 'm' {
      if slice_eq(source, start, end, "mut") {
        Some(TMut)
      } else None
    } else if c0 == 'f' {
      if slice_eq(source, start, end, "for") {
        Some(TFor)
      } else None
    } else None
  } else if len == 4 {
    let c0 = String::char_code_at(source, start)
    if c0 == 'e' {
      if slice_eq(source, start, end, "else") {
        Some(TElse)
      } else if slice_eq(source, start, end, "enum") {
        Some(TEnum)
      } else None
    } else if c0 == 't' {
      if slice_eq(source, start, end, "true") {
        Some(TIdent("true"))
      } else if slice_eq(source, start, end, "type") {
        Some(TType)
      } else if slice_eq(source, start, end, "test") {
        Some(TTest)
      } else None
    } else if c0 == 'w' {
      if slice_eq(source, start, end, "with") {
        Some(TWith)
      } else None
    } else if c0 == 'l' {
      if slice_eq(source, start, end, "loop") {
        Some(TLoop)
      } else None
    } else if c0 == 'o' {
      if slice_eq(source, start, end, "open") {
        Some(TOpen)
      } else None
    } else if c0 == 'i' {
      if slice_eq(source, start, end, "impl") {
        Some(TImpl)
      } else None
    } else None
  } else if len == 5 {
    let c0 = String::char_code_at(source, start)
    if c0 == 'f' {
      if slice_eq(source, start, end, "false") {
        Some(TIdent("false"))
      } else None
    } else if c0 == 'm' {
      if slice_eq(source, start, end, "match") {
        Some(TMatch)
      } else None
    } else if c0 == 't' {
      if slice_eq(source, start, end, "trait") {
        Some(TTrait)
      } else if slice_eq(source, start, end, "throw") {
        Some(TThrow)
      } else None
    } else if c0 == 'w' {
      if slice_eq(source, start, end, "while") {
        Some(TWhile)
      } else None
    } else if c0 == 'b' {
      if slice_eq(source, start, end, "break") {
        Some(TBreak)
      } else if slice_eq(source, start, end, "bench") {
        Some(TBench)
      } else None
    } else if c0 == 'r' {
      if slice_eq(source, start, end, "raise") {
        Some(TRaise)
      } else None
    } else if c0 == 'y' {
      if slice_eq(source, start, end, "yield") {
        Some(TYield)
      } else None
    } else None
  } else if len == 6 {
    let c0 = String::char_code_at(source, start)
    if c0 == 's' {
      if slice_eq(source, start, end, "struct") {
        Some(TStruct)
      } else None
    } else if c0 == 'e' {
      if slice_eq(source, start, end, "export") {
        Some(TExport)
      } else None
    } else if c0 == 'r' {
      if slice_eq(source, start, end, "return") {
        Some(TReturn)
      } else None
    } else if c0 == 'h' {
      if slice_eq(source, start, end, "handle") {
        Some(THandle)
      } else None
    } else if c0 == 'm' {
      if slice_eq(source, start, end, "module") {
        Some(TModule)
      } else None
    } else if c0 == 'd' {
      if slice_eq(source, start, end, "derive") {
        Some(TDerive)
      } else None
    } else if c0 == 'i' {
      if slice_eq(source, start, end, "import") {
        Some(TImport)
      } else None
    } else None
  } else if len == 7 {
    if slice_eq(source, start, end, "declare") {
      Some(TDeclare)
    } else None
  } else if len == 8 {
    let c0 = String::char_code_at(source, start)
    if c0 == 'c' {
      if slice_eq(source, start, end, "continue") {
        Some(TContinue)
      } else None
    } else if c0 == 's' {
      if slice_eq(source, start, end, "suberror") {
        Some(TSuberror)
      } else None
    } else None
  } else None
}

let scan_ident_end: (String, Int, Int) -> Int = (s, len, i) -> {
  let mut out = i
  while out < len && is_alnum(String::char_code_at(s, out)) {
    out = out + 1
  }
  out
}

let lex_ident: (String, Int, Int) -> (Token, Int) = (s, len, i) -> {
  let end = scan_ident_end(s, len, i)
  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {
    let ri_start = end + 1
    let ri_end = scan_ident_end(s, len, ri_start)
    (TIdent(s[ri_start: ri_end]), ri_end)
  }
  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '"' {
    let mut ri = end + 1
    while ri < len && String::char_code_at(s, ri) != '"' {
      ri = ri + 1
    }
    (TString(s[end + 1: ri]), if ri >= len {
      ri
    } else {
      ri + 1
    })
  } else {
    match keyword_lookup(s, i, end) {
      Some(tok) => (tok, end),
      None => (TIdent(s[i: end]), end)
    }
  }
}

let scan_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {
  let mut out = i
  while out < len && is_digit(String::char_code_at(s, out)) {
    out = out + 1
  }
  out
}

let scan_interp_end: (String, Int, Int, Int) -> Int with { Error } = (s, len, idx, depth) -> {
  let mut out = idx
  let mut current_depth = depth
  let mut found = -1
  while out < len && found < 0 {
    let c = String::char_code_at(s, out)
    if c == '{' {
      current_depth = current_depth + 1
    } else if c == '}' {
      if current_depth == 1 {
        found = out
      } else {
        current_depth = current_depth - 1
      }
    }
    if found < 0 {
      out = out + 1
    }
  }
  if found >= 0 {
    found
  } else {
    throw("unterminated string interpolation")
  }
}

let parse_frac_digits: (String, Int, Int, Double, Double) -> (Double, Int) = (s, len, i, acc, scale) -> {
  let mut out_i = i
  let mut out_acc = acc
  let mut out_scale = scale
  let mut done = false
  while out_i < len && !done {
    let c = String::char_code_at(s, out_i)
    if is_digit(c) {
      out_acc = out_acc + Int::to_double(c - 48) / out_scale
      out_scale = out_scale * 10.0
      out_i = out_i + 1
    } else {
      done = true
    }
  }
  (out_acc, out_i)
}

let empty_string_array: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let skip_until_newline: (String, Int, Int) -> Int = (s, len, i) -> {
  let mut out = i
  let mut done = false
  while out < len && !done {
    if String::char_code_at(s, out) == '\n' {
      out = out + 1
      done = true
    } else {
      out = out + 1
    }
  }
  out
}

let skip_ws_with_newline: (String, Int, Int) -> (Int, Bool) = (s, len, i) -> {
  let mut out = i
  let mut saw_newline = false
  let mut skipping = true
  while skipping && out < len {
    let c = String::char_code_at(s, out)
    if is_ws(c) {
      if c == '\n' {
        saw_newline = true
      } else {
        ()
      }
      out = out + 1
    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {
      let next = skip_until_newline(s, len, out + 2)
      if next > out + 2 && String::char_code_at(s, next - 1) == '\n' {
        saw_newline = true
      } else {
        ()
      }
      out = next
    } else {
      skipping = false
    }
  }
  (out, saw_newline)
}

let concat_string_parts: (Array[String], String) -> String = (parts, tail) -> {
  let mut out = ""
  let mut i = 0
  while i < Array::length(parts) {
    out = String::concat(out, Array::get(parts, i))
    i = i + 1
  }
  String::concat(out, tail)
}

let lex_string_go: (String, Int, Int, Int, Array[String], Bool, ArrayBuilder[String]) -> (Token, Int) with { Error } = (s, len, idx, start, parts_acc, has_interp, parts) -> {
  let mut current_idx = idx
  let mut current_start = start
  let mut current_parts_acc = parts_acc
  let mut current_has_interp = has_interp
  let mut out_tok = TEof
  let mut out_next = -1
  let mut done = false
  while !done {
    if current_idx >= len {
      throw("unterminated string")
    }
    let c = String::char_code_at(s, current_idx)
    if c == '"' {
      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])
      if current_has_interp {
        ArrayBuilder::push(parts, value)
        out_tok = TStringInterp(ArrayBuilder::freeze(parts))
        out_next = current_idx + 1
      } else {
        out_tok = TString(value)
        out_next = current_idx + 1
      }
      done = true
    } else if c == '\\' {
      let chunk = s[current_start: current_idx]
      let next = current_idx + 1
      if next >= len {
        throw("unterminated string escape")
      }
      let esc = String::char_code_at(s, next)
      if esc == '{' || esc == '(' {
        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))
        let interp_end = if esc == '{' {
          scan_interp_end(s, len, next + 1, 1)
        } else {
          let mut ie = next + 1
          let mut depth = 1
          while ie < len && depth > 0 {
            let ic = String::char_code_at(s, ie)
            if ic == '(' {
              depth = depth + 1
            }
            else if ic == ')' {
              depth = depth - 1
            }
            ie = ie + 1
          }
          ie - 1
        }
        let expr_src = s[next + 1: interp_end]
        ArrayBuilder::push(parts, expr_src)
        current_idx = interp_end + 1
        current_start = interp_end + 1
        current_parts_acc = empty_string_array()
        current_has_interp = true
      } else {
        let escaped = if esc == '"' {
          "\""
        }
        else if esc == '\\' {
          "\\"
        }
        else if esc == 'n' {
          "\n"
        }
        else if esc == 't' {
          "\t"
        }
        else if esc == 'r' {
          String::from_char_code(13)
        }
        else if esc == '0' {
          String::from_char_code(0)
        }
        else throw("invalid escape sequence")
        Array::push(current_parts_acc, chunk)
        Array::push(current_parts_acc, escaped)
        current_idx = next + 1
        current_start = next + 1
      }
    } else {
      current_idx = current_idx + 1
    }
  }
  (out_tok, out_next)
}

let lex_string: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {
  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())
}

let scan_hex_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {
  let mut out = i
  while out < len && is_hex_digit(String::char_code_at(s, out)) {
    out = out + 1
  }
  out
}

let parse_hex_from_string: (String) -> Int = (s) -> {
  let len = String::length(s)
  let mut i = 0
  let mut acc = 0
  while i < len {
    let c = String::char_code_at(s, i)
    let digit = if c >= '0' && c <= '9' {
      c - 48
    } else if c >= 'a' && c <= 'f' {
      c - 87
    } else c - 55
    acc = acc * 16 + digit
    i = i + 1
  }
  acc
}

let parse_int_from_string: (String) -> Int = (s) -> {
  let len = String::length(s)
  let mut i = 0
  let mut acc = 0
  while i < len {
    let c = String::char_code_at(s, i)
    acc = acc * 10 + (c - 48)
    i = i + 1
  }
  acc
}

let lex_decimal: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {
  let int_end = scan_digits_end(s, len, i)
  if int_end == i {
    throw("expected digit")
  }
  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')
  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {
    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {
      let int_str = s[i: int_end]
      let int_val = Int::to_double(parse_int_from_string(int_str))
      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);
      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {
        (TFloat(int_val + frac_val), frac_end + 1)
      } else {
        (TFloat(int_val + frac_val), frac_end)
      }
    } else {
      let int_str = s[i: int_end];
      (TInt(parse_int_from_string(int_str)), int_end)
    }
  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {
    let int_str = s[i: int_end]
    let int_val = Int::to_double(parse_int_from_string(int_str))
    (TFloat(int_val), int_end + 1)
  } else {
    let int_str = s[i: int_end];
    (TInt(parse_int_from_string(int_str)), int_end)
  }
}

let lex_number: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {
  if i + 1 < len && String::char_code_at(s, i) == '0' {
    let next_c = String::char_code_at(s, i + 1)
    if next_c == 'x' || next_c == 'X' {
      let hex_start = i + 2
      let hex_end = scan_hex_digits_end(s, len, hex_start)
      if hex_end == hex_start {
        throw("expected hex digit after 0x")
      }
      let hex_str = s[hex_start: hex_end];
      (TInt(parse_hex_from_string(hex_str)), hex_end)
    } else lex_decimal(s, len, i)
  } else lex_decimal(s, len, i)
}

let is_expr_ending_tok: (Token) -> Bool = (t) -> {
  match t {
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    TIdent(_) => true,
    TInt(_) => true,
    TFloat(_) => true,
    TString(_) => true,
    _ => false
  }
}

let lex_one_token: (String, Int, Int) -> (Token, Int) with { Error } = (source, len, pos) -> {
  let c = String::char_code_at(source, pos)
  if is_alpha(c) {
    lex_ident(source, len, pos)
  } else if is_digit(c) {
    lex_number(source, len, pos)
  } else if c == '"' {
    lex_string(source, len, pos)
  } else if c == '+' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TPlusEq, pos + 2)
    } else (TPlus, pos + 1)
  } else if c == '-' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
      (TThinArrow, pos + 2)
    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TMinusEq, pos + 2)
    } else (TMinus, pos + 1)
  } else if c == '*' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TStarEq, pos + 2)
    } else (TStar, pos + 1)
  } else if c == '/' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TSlashEq, pos + 2)
    } else (TSlash, pos + 1)
  } else if c == '%' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TPercentEq, pos + 2)
    } else (TPercent, pos + 1)
  } else if c == '=' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TEqEq, pos + 2)
    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
      (TArrow, pos + 2)
    } else (TEq, pos + 1)
  } else if c == '!' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TNeq, pos + 2)
    } else (TNot, pos + 1)
  } else if c == '<' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TLte, pos + 2)
    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {
      (TLShift, pos + 2)
    } else (TLt, pos + 1)
  } else if c == '>' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {
      (TGte, pos + 2)
    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
      (TRShift, pos + 2)
    } else (TGt, pos + 1)
  } else if c == '&' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {
      (TAnd, pos + 2)
    } else (TBitAnd, pos + 1)
  } else if c == '|' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {
      (TOr, pos + 2)
    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {
      (TPipeGt, pos + 2)
    } else (TBitOr, pos + 1)
  } else if c == '^' {
    (TBitXor, pos + 1)
  } else if c == '(' {
    (TLParen, pos + 1)
  } else if c == ')' {
    (TRParen, pos + 1)
  } else if c == '{' {
    (TLBrace, pos + 1)
  } else if c == '}' {
    (TRBrace, pos + 1)
  } else if c == '[' {
    (TLBracket, pos + 1)
  } else if c == ']' {
    (TRBracket, pos + 1)
  } else if c == ',' {
    (TComma, pos + 1)
  } else if c == ';' {
    (TSemicolon, pos + 1)
  } else if c == '.' {
    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {
      (TDotDotDot, pos + 3)
    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {
      (TDotDot, pos + 2)
    } else (TDot, pos + 1)
  } else if c == ':' {
    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {
      (TDoubleColon, pos + 2)
    } else (TColon, pos + 1)
  } else if c == '#' {
    (THash, pos + 1)
  } else if c == '~' {
    (TTilde, pos + 1)
  } else if c == '?' {
    (TQuestion, pos + 1)
  } else if c == '@' {
    let mut end = pos + 1
    while end < len && is_alnum(String::char_code_at(source, end)) {
      end = end + 1
    }
    if end > pos + 1 {
      (TIdent(String::substring(source, pos, end)), end)
    } else {
      throw("unexpected '@' without identifier")
    }
  } else if c == '\'' {
    lex_char(source, len, pos)
  } else throw(String::concat("unexpected character: ", String::from_char_code(c)))
}

export let lex_with_offsets: (String) -> (Array[Token], Array[Int], Array[Int]) with { Error } = (source) -> {
  let len = String::length(source)
  {
    let b = ArrayBuilder::new()
    let starts = ArrayBuilder::new()
    let ends = ArrayBuilder::new()
    let mut prev_tok = TEof
    let first_skip = skip_ws_with_newline(source, len, 0)
    let mut pos = first_skip.0
    let mut nl_before = first_skip.1
    while pos < len {
      let c = String::char_code_at(source, pos)
      let (tok, next) = lex_one_token(source, len, pos)
      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {
        ArrayBuilder::push(b, TSemicolon)
        ArrayBuilder::push(starts, pos)
        ArrayBuilder::push(ends, pos)
      } else {
        ()
      }
      ArrayBuilder::push(b, tok)
      ArrayBuilder::push(starts, pos)
      ArrayBuilder::push(ends, next)
      prev_tok = tok
      let skipped = skip_ws_with_newline(source, len, next)
      pos = skipped.0
      nl_before = skipped.1
    }
    ArrayBuilder::push(b, TEof)
    ArrayBuilder::push(starts, len)
    ArrayBuilder::push(ends, len)
    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))
  }
}

export let lex: (String) -> Array[Token] with { Error } = (source) -> {
  let len = String::length(source)
  {
    let b = ArrayBuilder::new()
    let mut prev_tok = TEof
    let first_skip = skip_ws_with_newline(source, len, 0)
    let mut pos = first_skip.0
    let mut nl_before = first_skip.1
    while pos < len {
      let c = String::char_code_at(source, pos)
      let (tok, next) = lex_one_token(source, len, pos)
      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {
        ArrayBuilder::push(b, TSemicolon)
      } else {
        ()
      }
      ArrayBuilder::push(b, tok)
      prev_tok = tok
      let skipped = skip_ws_with_newline(source, len, next)
      pos = skipped.0
      nl_before = skipped.1
    }
    ArrayBuilder::push(b, TEof)
    ArrayBuilder::freeze(b)
  }
}

export let lex_ok: (String) -> Bool = (source) -> {
  handle {
    let _ = lex(source)
    true
  } with Error {
    Throw(_) => false
  }
}




let peek: (Array[Token], Int) -> Token = (tokens, pos) -> {
  if pos < Array::length(tokens) {
    Array::get(tokens, pos)
  } else TEof
}

let _no_tp: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let _no_tb: () -> Array[(String, Array[String])] = () -> {
  Array::slice([
    ("", _no_tp())
  ], 0, 0)
}

let tk_name: (Token) -> String = (tok) -> {
  match tok {
    TInt(_) => "int",
    TFloat(_) => "float",
    TString(_) => "string",
    TStringInterp(_) => "string",
    TIdent(_) => "ident",
    TLet => "let",
    TRec => "rec",
    TMut => "mut",
    TFn => "fn",
    TIf => "if",
    TElse => "else",
    TMatch => "match",
    TIs => "is",
    TDo => "do",
    TEnum => "enum",
    TStruct => "struct",
    TType => "type",
    TTrait => "trait",
    TImpl => "impl",
    TExport => "export",
    TTest => "test",
    TWhile => "while",
    TFor => "for",
    TIn => "in",
    TLoop => "loop",
    TBreak => "break",
    TContinue => "continue",
    TReturn => "return",
    TWith => "with",
    THandle => "handle",
    TThrow => "throw",
    TRaise => "raise",
    TYield => "yield",
    TBench => "bench",
    TDeclare => "declare",
    TAs => "as",
    TModule => "module",
    TSuberror => "suberror",
    TDerive => "derive",
    TOpen => "open",
    TImport => "import",
    TPlus => "+",
    TMinus => "-",
    TStar => "*",
    TSlash => "/",
    TPercent => "%",
    TEqEq => "==",
    TNeq => "!=",
    TLt => "<",
    TLte => "<=",
    TGt => ">",
    TGte => ">=",
    TAnd => "&&",
    TOr => "||",
    TNot => "!",
    TBitAnd => "&",
    TBitOr => "|",
    TBitXor => "^",
    TLShift => "<<",
    TRShift => ">>",
    TPipeGt => "|>",
    TArrow => "=>",
    TThinArrow => "->",
    TEq => "=",
    TDot => ".",
    TColon => ":",
    TDoubleColon => "::",
    TComma => ",",
    TSemicolon => ";",
    THash => "#",
    TTilde => "~",
    TQuestion => "?",
    TPlusEq => "+=",
    TMinusEq => "-=",
    TStarEq => "*=",
    TSlashEq => "/=",
    TPercentEq => "%=",
    TLParen => "(",
    TRParen => ")",
    TLBrace => "{",
    TRBrace => "}",
    TLBracket => "[",
    TRBracket => "]",
    TDotDot => "..",
    TDotDotDot => "...",
    TStringInterp(_) => "string",
    TEof => "eof"
  }
}

let is_tk: (Token, String) -> Bool = (tok, name) -> {
  tk_name(tok) == name
}

let expect_tk: (Array[Token], Int, String) -> Int with { Error } = (tokens, pos, expected) -> {
  if is_tk(peek(tokens, pos), expected) {
    pos + 1
  } else {
    let actual = tk_name(peek(tokens, pos))
    throw("expected \{expected} but got \{actual}")
  }
}

let skip_semi: (Array[Token], Int) -> Int = (tokens, pos) -> {
  match peek(tokens, pos) {
    TSemicolon => pos + 1,
    _ => pos
  }
}

let empty_arms: () -> Array[(Pat, Expr)] = () -> {
  Array::slice([
    (PWild, EUnit)
  ], 0, 0)
}

let empty_pats: () -> Array[Pat] = () -> {
  Array::slice([
    PWild
  ], 0, 0)
}

let empty_ctors: () -> Array[(String, Array[TypeExpr])] = () -> {
  Array::slice([
    ("_", Array::slice([
      TyUnit
    ], 0, 0))
  ], 0, 0)
}

let empty_exprs: () -> Array[Expr] = () -> {
  Array::slice([
    EUnit
  ], 0, 0)
}

export let skip_derive: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TDerive => match peek(tokens, pos + 1) {
      TLParen => {
        match peek(tokens, pos + 2) {
          TIdent(name) => if name != "Eq" {
            throw("unknown derive: \{name}")
          },
          _ => throw("expected derive identifier")
        }
        let mut dp = pos + 2
        let mut dd = true
        while dd {
          match peek(tokens, dp) {
            TRParen => {
              dd = false
            },
            _ => {
              dp = dp + 1
            }
          }
        }
        dp + 1
      },
      _ => pos
    },
    _ => pos
  }
}

let empty_fields: () -> Array[(String, TypeExpr)] = () -> {
  Array::slice([
    ("_", TyUnit)
  ], 0, 0)
}

let empty_params: () -> Array[(String, Option[TypeExpr])] = () -> {
  Array::slice([
    ("", None)
  ], 0, 0)
}

let rec parse_pattern: (Array[Token], Int) -> (Pat, Int) with { Error } = (tokens, pos) -> {
  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {
    match peek(tokens, pos) {
      TComma => {
        let (p, pn) = parse_pattern(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_pat_cont(tokens, pn, b)
      },
      TRParen => (ArrayBuilder::freeze(b), pos + 1),
      _ => throw("expected ',' or ')' in pattern list")
    }
  }
  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {
    match peek(tokens, pos) {
      TRParen => (empty_pats(), pos + 1),
      _ => {
        let (f, fn1) = parse_pattern(tokens, pos)
        let b = ArrayBuilder::new()
        ArrayBuilder::push(b, f)
        parse_pat_cont(tokens, fn1, b)
      }
    }
  }
  let (pat, next) = match peek(tokens, pos) {
    TInt(n) => (PInt(n), pos + 1),
    TFloat(_) => (PWild, pos + 1),
    TString(s) => (PString(s), pos + 1),
    TIdent(name) => {
      let next_is_lbrace = match peek(tokens, pos + 1) {
        TLBrace => true,
        _ => false
      }
      if name == "true" {
        (PBool(true), pos + 1)
      }
      else if name == "false" {
        (PBool(false), pos + 1)
      }
      else if name == "_" {
        (PWild, pos + 1)
      }
      else if name == "record" && next_is_lbrace {
        let mut rp = pos + 2
        let field_pats_b = ArrayBuilder::new()
        let mut rd = true
        while rd {
          match peek(tokens, rp) {
            TRBrace => {
              rd = false
            },
            TIdent(fname) => {
              match peek(tokens, rp + 1) {
                TColon => {
                  let (fp, fnext) = parse_pattern(tokens, rp + 2)
                  ArrayBuilder::push(field_pats_b, fp)
                  rp = fnext
                },
                TComma => {
                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1
                },
                TRBrace => {
                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1
                },
                _ => {
                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1
                }
              }
              match peek(tokens, rp) {
                TComma => {
                  rp = rp + 1
                },
                _ => ()
              }
            },
            _ => {
              rp = rp + 1
            }
          }
        }
        let rp2 = rp + 1
        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)
      }
      else {
        let fc = String::char_code_at(name, 0)
        if fc >= 65 && fc <= 90 {
          match peek(tokens, pos + 1) {
            TLParen => {
              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);
              (PCtor(name, args), end)
            },
            TDoubleColon => match peek(tokens, pos + 2) {
              TLBrace => {
                let mut sp = pos + 3
                let field_pats = ArrayBuilder::new()
                let mut sd = true
                while sd {
                  match peek(tokens, sp) {
                    TRBrace => {
                      sd = false
                    },
                    TIdent(fname) => {
                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))
                      sp = sp + 1
                      match peek(tokens, sp) {
                        TComma => {
                          sp = sp + 1
                        },
                        _ => ()
                      }
                    },
                    _ => {
                      sd = false
                    }
                  }
                }
                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)
              },
              _ => (PCtor(name, empty_pats()), pos + 1)
            },
            _ => (PCtor(name, empty_pats()), pos + 1)
          }
        } else (PBind(name), pos + 1)
      }
    },
    TLParen => match peek(tokens, pos + 1) {
      TRParen => (PTuple(empty_pats()), pos + 2),
      _ => {
        let (f, n1) = parse_pattern(tokens, pos + 1)
        match peek(tokens, n1) {
          TRParen => (f, n1 + 1),
          TComma => {
            let b = ArrayBuilder::new()
            ArrayBuilder::push(b, f)
            let (rest, end) = parse_pat_cont(tokens, n1, b);
            (PTuple(rest), end)
          },
          _ => throw("expected ')' or ',' in pattern")
        }
      }
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("unexpected in pattern: \{actual}")
    }
  }
  match peek(tokens, next) {
    TBitOr => {
      let (right, end) = parse_pattern(tokens, next + 1);
      (POr(pat, right), end)
    },
    _ => (pat, next)
  }
}

let empty_type_exprs: () -> Array[TypeExpr] = () -> {
  Array::slice([
    TyUnit
  ], 0, 0)
}

let skip_braced_body: (Array[Token], Int) -> Int = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLBrace => {
      let mut bp = pos + 1
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, bp) {
          TLBrace => {
            depth = depth + 1
            bp = bp + 1
          },
          TRBrace => {
            depth = depth - 1
            bp = bp + 1
          },
          _ => {
            bp = bp + 1
          }
        }
      }
      bp
    },
    _ => pos
  }
}

let parse_trait_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  let empty_strings = Array::slice([
    "_"
  ], 0, 0)
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TColon => {
        let supers = empty_strings
        let mut p = pos + 2
        let mut done = false
        while !done {
          match peek(tokens, p) {
            TIdent(sname) => match peek(tokens, p + 1) {
              TPlus => {
                Array::push(supers, sname)
                p = p + 2
              },
              _ => {
                Array::push(supers, sname)
                p = p + 1
                done = true
              }
            },
            _ => {
              done = true
            }
          }
        }
        let np = p
        let body_end = skip_braced_body(tokens, np)
        (STrait(exported, name, supers), body_end)
      },
      _ => {
        let body_end = skip_braced_body(tokens, pos + 1)
        (STrait(exported, name, empty_strings), body_end)
      }
    },
    _ => throw("expected trait name")
  }
}

let is_expr_end_token: (Token) -> Bool = (tok) -> {
  match tok {
    TInt(_) => true,
    TFloat(_) => true,
    TString(_) => true,
    TStringInterp(_) => true,
    TIdent(_) => true,
    TRParen => true,
    TRBracket => true,
    TRBrace => true,
    _ => false
  }
}

let is_non_pipe_infix: (Token) -> Bool = (tok) -> {
  match tok {
    TOr => true,
    TAnd => true,
    TEqEq => true,
    TNeq => true,
    TLt => true,
    TLte => true,
    TGt => true,
    TGte => true,
    TBitOr => true,
    TBitXor => true,
    TBitAnd => true,
    TLShift => true,
    TRShift => true,
    TPlus => true,
    TMinus => true,
    TStar => true,
    TSlash => true,
    TPercent => true,
    _ => false
  }
}

let parse_import_item: (Array[Token], Int) -> ((String, Option[String]), Int) with { Error } = (tokens, pos) -> {
  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {
    match peek(tokens, name_pos) {
      TIdent(name) => {
        let (base, after) = match peek(tokens, name_pos + 1) {
          TDoubleColon => match peek(tokens, name_pos + 2) {
            TIdent(member) =>
            (String::concat(name, String::concat("::", member)), name_pos + 3),
            _ => throw("expected qualified member name after '::'")
          },
          _ => (name, name_pos + 1)
        }
        match peek(tokens, after) {
          TAs => match peek(tokens, after + 1) {
            TIdent(alias) => ((base, Some(alias)), after + 2),
            _ => throw("expected alias name after 'as'")
          },
          _ => ((base, None), after)
        }
      },
      _ => throw("expected import item name")
    }
  }
  match peek(tokens, pos) {
    TIdent(_) => parse_import_name(pos),
    TType => parse_import_name(pos + 1),
    TTrait => parse_import_name(pos + 1),
    _ => throw("expected import item name")
  }
}

let empty_import_items: () -> Array[(String, Option[String])] = () -> {
  Array::slice([
    ("_", None)
  ], 0, 0)
}

let parse_binding_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TDoubleColon => match peek(tokens, pos + 2) {
        TIdent(member) => (String::concat(name, String::concat("::", member)), pos + 3),
        _ => throw("expected qualified member name after '::'")
      },
      _ => (name, pos + 1)
    },
    _ => throw("expected name after 'let'")
  }
}

let rec collect_import_path: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {
  match peek(tokens, pos) {
    TLBrace => (acc, pos),
    TDot => collect_import_path(tokens, pos + 1, "\{acc}."),
    TDotDot => collect_import_path(tokens, pos + 1, "\{acc}.."),
    TSlash => collect_import_path(tokens, pos + 1, "\{acc}/"),
    TIdent(name) => collect_import_path(tokens, pos + 1, "\{acc}\{name}"),
    TMinus => collect_import_path(tokens, pos + 1, "\{acc}-"),
    TModule => collect_import_path(tokens, pos + 1, "\{acc}module"),
    TType => collect_import_path(tokens, pos + 1, "\{acc}type"),
    TMatch => collect_import_path(tokens, pos + 1, "\{acc}match"),
    TTest => collect_import_path(tokens, pos + 1, "\{acc}test"),
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("unexpected token in import path: \{actual}")
    }
  }
}

let skip_bracketed_args: (Array[Token], Int) -> Int = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLBracket => {
      let mut bp = pos + 1
      let mut depth = 1
      while depth > 0 {
        match peek(tokens, bp) {
          TLBracket => {
            depth = depth + 1
            bp = bp + 1
          },
          TRBracket => {
            depth = depth - 1
            bp = bp + 1
          },
          TEof => {
            depth = 0
          },
          _ => {
            bp = bp + 1
          }
        }
      }
      bp
    },
    _ => pos
  }
}

let rec collect_effect_names: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {
  match peek(tokens, pos) {
    TRBrace => (acc, pos + 1),
    TIdent(name) => {
      let new_acc = if String::length(acc) == 0 {
        name
      } else "\{acc}, \{name}"
      match peek(tokens, pos + 1) {
        TComma => collect_effect_names(tokens, pos + 2, new_acc),
        TRBrace => (new_acc, pos + 2),
        _ => throw("expected ',' or '}' in effect list")
      }
    },
    _ => throw("expected effect name or '}'")
  }
}

let rec parse_type_impl: (Array[Token], Int, Int) -> (TypeExpr, Int) with { Error } = (tokens, pos, mode) -> {
  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {
    match peek(tokens, pos) {
      TComma => match peek(tokens, pos + 1) {
        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),
        _ => {
          let ts = match peek(tokens, pos + 1) {
            TIdent(_) => match peek(tokens, pos + 2) {
              TColon => pos + 3,
              TTilde => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              TQuestion => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              _ => pos + 1
            },
            _ => pos + 1
          }
          let (ty, next) = parse_type_impl(tokens, ts, 0)
          ArrayBuilder::push(b, ty)
          type_list_rest(tokens, next, b)
        }
      }
      ,
      _ => (ArrayBuilder::freeze(b), pos)
    }
  }
  if mode == 0 {
    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)
    match peek(tokens, atom_next) {
      TThinArrow => {
        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)
        let params = match atom_ty {
          TyUnit => empty_type_exprs(),
          TyTuple(elems) => elems,
          _ => [
            atom_ty
          ]
        }
        let effect_pair = match peek(tokens, rn) {
          TWith => {
            let with_pos = expect_tk(tokens, rn + 1, "{")
            let effect_name_pair = collect_effect_names(tokens, with_pos, "")
            (Some(effect_name_pair.0), effect_name_pair.1)
          },
          _ => (None, rn)
        }
        (TyFn(params, ret, effect_pair.0), effect_pair.1)
      },
      _ => (atom_ty, atom_next)
    }
  } else {
    let (base_ty, base_next) = match peek(tokens, pos) {
      TLParen => match peek(tokens, pos + 1) {
        TRParen => (TyUnit, pos + 2),
        _ => {
          let ty_start = match peek(tokens, pos + 1) {
            TIdent(_) => match peek(tokens, pos + 2) {
              TColon => pos + 3,
              TTilde => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              TQuestion => match peek(tokens, pos + 3) {
                TColon => pos + 4,
                _ => pos + 1
              },
              _ => pos + 1
            },
            _ => pos + 1
          }
          let (first, n1) = parse_type_impl(tokens, ty_start, 0)
          match peek(tokens, n1) {
            TRParen => (first, n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, first)
              let (rest, end) = type_list_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, ")");
              (TyTuple(rest), en)
            },
            _ => throw("expected ')' or ',' in type")
          }
        }
      },
      TIdent(name) => match peek(tokens, pos + 1) {
        TLBracket => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          match peek(tokens, n1) {
            TRBracket => (TyApp(name, [
              first
            ]), n1 + 1),
            TComma => {
              let b = ArrayBuilder::new()
              ArrayBuilder::push(b, first)
              let (rest, end) = type_list_rest(tokens, n1, b)
              let en = expect_tk(tokens, end, "]");
              (TyApp(name, rest), en)
            },
            _ => throw("expected ']' or ',' in type application")
          }
        },
        _ => (TyName(name), pos + 1)
      },
      _ => {
        let actual = tk_name(peek(tokens, pos))
        throw("expected type but got \{actual}")
      }
    }
    match peek(tokens, base_next) {
      TQuestion => (TyApp("Option", [
        base_ty
      ]), base_next + 1),
      _ => (base_ty, base_next)
    }
  }
}

export let parse_type: (Array[Token], Int) -> (TypeExpr, Int) with { Error } = (tokens, pos) -> {
  parse_type_impl(tokens, pos, 0)
}

let parse_one_param: (Array[Token], Int) -> ((String, Option[TypeExpr]), Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TTilde => {
        let labeled_name = "\{name}~"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((labeled_name, Some(ty)), tp)
          },
          _ => ((labeled_name, None), pos + 2)
        }
      },
      TQuestion => {
        let opt_name = "\{name}?"
        match peek(tokens, pos + 2) {
          TColon => {
            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);
            ((opt_name, Some(ty)), tp)
          },
          _ => ((opt_name, None), pos + 2)
        }
      },
      TColon => {
        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);
        let tp2 = match peek(tokens, tp) {
          TColon => {
            let mut bp = tp + 1
            let mut bd = true
            while bd {
              match peek(tokens, bp) {
                TIdent(_) => {
                  bp = bp + 1; match peek(tokens, bp) {
                    TPlus => {
                      bp = bp + 1
                    },
                    _ => {
                      bd = false
                    }
                  }
                },
                _ => {
                  bd = false
                }
              }
            }
            bp
          },
          _ => tp
        }
        ((name, Some(ty)), tp2)
      },
      _ => ((name, None), pos + 1)
    },
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("expected parameter name at #\{pos} token=\{actual}")
    }
  }
}

let rec parse_param_cont: (Array[Token], Int, ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TComma => match peek(tokens, pos + 1) {
      TRParen => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (p, pn) = parse_one_param(tokens, pos + 1)
        ArrayBuilder::push(b, p)
        parse_param_cont(tokens, pn, b)
      }
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => {
      let actual = tk_name(peek(tokens, pos))
      throw("expected ',' or ')' in param list at #\{pos} token=\{actual}")
    }
  }
}

let parse_param_list: (Array[Token], Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRParen => (empty_params(), pos + 1),
    _ => {
      let (f, fn1) = parse_one_param(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, f)
      parse_param_cont(tokens, fn1, b)
    }
  }
}

let parse_struct_field: (Array[Token], Int) -> ((String, TypeExpr), Int) with { Error } = (tokens, pos) -> {
  let p = match peek(tokens, pos) {
    TMut => pos + 1
    _ => pos
  }
  match peek(tokens, p) {
    TIdent(name) => {
      let cn = expect_tk(tokens, p + 1, ":")
      let (ty, next) = parse_type_impl(tokens, cn, 0);
      ((name, ty), next)
    },
    _ => throw("expected field name")
  }
}

let rec is_lambda_start_impl: (Array[Token], Int, Int, Bool) -> Bool = (tokens, pos, depth, has_colon) -> {
  match peek(tokens, pos) {
    TColon => if depth == 0 {
      is_lambda_start_impl(tokens, pos + 1, depth, true)
    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),
    TRParen => if depth == 0 {
      match peek(tokens, pos + 1) {
        TThinArrow => true,
        TLBrace => has_colon,
        _ => false
      }
    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),
    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),
    TEof => false,
    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)
  }
}

let is_lambda_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {
  is_lambda_start_impl(tokens, pos, 0, false)
}

let rec parse_ctor_types_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TComma => {
      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)
      ArrayBuilder::push(b, ty)
      parse_ctor_types_rest(tokens, next, b)
    },
    TRParen => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ',' or ')' in constructor types")
  }
}

let parse_enum_ctor: (Array[Token], Int) -> ((String, Array[TypeExpr]), Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => ((name, empty_type_exprs()), pos + 3),
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, first)
          let (types, end) = parse_ctor_types_rest(tokens, n1, b);
          ((name, types), end)
        }
      },
      _ => ((name, empty_type_exprs()), pos + 1)
    },
    _ => throw("expected constructor name")
  }
}

let rec parse_enum_ctors_rest: (Array[Token], Int, ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)
        ArrayBuilder::push(b, ctor)
        parse_enum_ctors_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in enum")
  }
}

let parse_enum_ctors: (Array[Token], Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRBrace => (empty_ctors(), pos + 1),
    _ => {
      let (first, next) = parse_enum_ctor(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_enum_ctors_rest(tokens, next, b)
    }
  }
}

let parse_enum_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => {
      let (params, after_name) = match peek(tokens, pos + 1) {
        TLBracket => {
          let b = ArrayBuilder::new()
          let mut skip = pos + 2
          let mut depth = 1
          let mut expect_name = true
          while depth > 0 {
            match peek(tokens, skip) {
              TLBracket => {
                depth = depth + 1; skip = skip + 1
              },
              TRBracket => {
                depth = depth - 1; skip = skip + 1
              },
              TComma => {
                if depth == 1 {
                  expect_name = true
                }
                skip = skip + 1
              },
              TIdent(nm) => {
                if depth == 1 && expect_name {
                  ArrayBuilder::push(b, nm)
                  expect_name = false
                }
                skip = skip + 1
              },
              _ => {
                skip = skip + 1
              }
            }
          }
          (ArrayBuilder::freeze(b), skip)
        },
        _ => (Array::slice([
          ""
        ], 0, 0), pos + 1)
      }
      let br = expect_tk(tokens, after_name, "{")
      let (ctors, end) = parse_enum_ctors(tokens, br);
      let final_pos = skip_derive(tokens, end)
      (SEnum(exported, name, params, ctors), final_pos)
    },
    _ => throw("expected enum name")
  }
}

let parse_suberror_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => match peek(tokens, pos + 1) {
      TLParen => match peek(tokens, pos + 2) {
        TRParen => {
          let b = ArrayBuilder::new()
          ArrayBuilder::push(b, (name, empty_type_exprs()))
          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)
        },
        _ => {
          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)
          let args_b = ArrayBuilder::new()
          ArrayBuilder::push(args_b, first)
          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)
          let ctors_b = ArrayBuilder::new()
          ArrayBuilder::push(ctors_b, (name, args))
          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)
        }
      },
      TLBrace => {
        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);
        (SSuberror(exported, name, ctors), end)
      },
      _ => throw("expected '(' or '{' after suberror name")
    },
    _ => throw("expected suberror name")
  }
}

let parse_impl_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {
  let b = ArrayBuilder::new()
  let mut p = pos
  let mut done = false
  while !done {
    match peek(tokens, p) {
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TPlus => {
            p = p + 1
          },
          _ => {
            done = true
          }
        }
      },
      _ => throw("expected trait bound name")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

let parse_impl_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {
  let names = ArrayBuilder::new()
  let bounds = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(names, name)
        p = p + 1
        match peek(tokens, p) {
          TColon => {
            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)
            ArrayBuilder::push(bounds, (name, bound_names))
            p = next
          },
          _ => ()
        }
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in impl type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)
}

let parse_impl_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {
    TLBracket => parse_impl_type_params(tokens, pos + 1),
    _ => (_no_tp(), _no_tb(), pos)
  }
  match peek(tokens, after_tp) {
    TIdent(trait_name) => {
      let fp = expect_tk(tokens, after_tp + 1, "for")
      match peek(tokens, fp) {
        TIdent(type_name) => {
          let after_targs = skip_bracketed_args(tokens, fp + 1)
          let body_end = skip_braced_body(tokens, after_targs)
          (SImpl(type_params, type_bounds, trait_name, type_name), body_end)
        },
        _ => throw("expected type name after 'for'")
      }
    },
    _ => throw("expected trait name after 'impl'")
  }
}

let parse_type_params_list: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {
  let b = ArrayBuilder::new()
  let mut p = pos
  while true {
    match peek(tokens, p) {
      TRBracket => {
        p = p + 1
        break
      },
      TIdent(name) => {
        ArrayBuilder::push(b, name)
        p = p + 1
        match peek(tokens, p) {
          TComma => {
            p = p + 1
          },
          TRBracket => {
            p = p + 1
            break
          },
          _ => throw("expected ',' or ']' in type params")
        }
      },
      _ => throw("expected type parameter name or ']'")
    }
  }
  (ArrayBuilder::freeze(b), p)
}

let parse_effect_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => {
      let (type_params, after_params) = match peek(tokens, pos + 1) {
        TLBracket => parse_type_params_list(tokens, pos + 2),
        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)
      }
      let br = expect_tk(tokens, after_params, "{")
      let ops_b = ArrayBuilder::new()
      let mut p = br
      while true {
        match peek(tokens, p) {
          TRBrace => {
            p = p + 1
            break
          },
          TIdent(op_name) => {
            let (params, after_op_params) = match peek(tokens, p + 1) {
              TLParen => {
                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)
                let params = match params_ty {
                  TyUnit => empty_type_exprs(),
                  TyTuple(elems) => elems,
                  _ => [
                    params_ty
                  ]
                }
                (params, after_paren)
              },
              _ => (empty_type_exprs(), p + 1)
            }
            let arrow_pos = expect_tk(tokens, after_op_params, "->")
            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)
            ArrayBuilder::push(ops_b, (op_name, params, ret_type))
            p = match peek(tokens, after_ret) {
              TSemicolon => after_ret + 1,
              _ => after_ret
            }
          },
          _ => throw("expected effect operation name or '}'")
        }
      }
      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)
    },
    _ => throw("expected effect name")
  }
}

let parse_type_alias_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => {
      let (params, after_name) = match peek(tokens, pos + 1) {
        TLBracket => parse_type_params_list(tokens, pos + 2),
        _ => (Array::slice([
          ""
        ], 0, 0), pos + 1)
      }
      let ep = expect_tk(tokens, after_name, "=")
      let (ty, next) = parse_type_impl(tokens, ep, 0);
      (STypeAlias(exported, name, params, ty), next)
    },
    _ => throw("expected type alias name")
  }
}

let parse_impl_stmt_dispatch: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {
  parse_impl_stmt(tokens, pos)
}

let rec parse_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos, b) -> {
  match peek(tokens, pos) {
    TSemicolon => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_struct_fields_rest(tokens, next, b)
      }
    },
    TComma => match peek(tokens, pos + 1) {
      TRBrace => (ArrayBuilder::freeze(b), pos + 2),
      _ => {
        let (field, next) = parse_struct_field(tokens, pos + 1)
        ArrayBuilder::push(b, field)
        parse_struct_fields_rest(tokens, next, b)
      }
    },
    TRBrace => (ArrayBuilder::freeze(b), pos + 1),
    _ => throw("expected ';', ',' or '}' in struct")
  }
}

let parse_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TRBrace => (empty_fields(), pos + 1),
    _ => {
      let (first, next) = parse_struct_field(tokens, pos)
      let b = ArrayBuilder::new()
      ArrayBuilder::push(b, first)
      parse_struct_fields_rest(tokens, next, b)
    }
  }
}

let parse_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {
  match peek(tokens, pos) {
    TIdent(name) => {
      let after_name = skip_bracketed_args(tokens, pos + 1)
      let br = expect_tk(tokens, after_name, "{")
      let (fields, end) = parse_struct_fields(tokens, br);
      let final_pos = skip_derive(tokens, end)
      (SStruct(exported, name, fields), final_pos)
    },
    _ => throw("expected struct name")
  }
}


