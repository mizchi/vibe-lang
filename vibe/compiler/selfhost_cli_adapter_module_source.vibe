let read_uleb: (Bytes, Int) -> (Int, Int) = (bytes, start) -> {
  let mut value = 0
  let mut shift = 0
  let mut i = start
  let len = Bytes::length(bytes)
  let mut done = false
  while (i < len) && (done == false) {
    let b = Bytes::get(bytes, i)
    value = value|((b&127)<<shift)
    i = i + 1
    if (b&128) == 0 {
      done = true
    } else {
      shift = shift + 7
    }
  }
  (value, i)
}

let section_type = 7

let core_sort_mem = 2

let new_int_array: () -> Array[Int] = () -> {
  Array::slice([
    0
  ], 0, 0)
}

let section_alias = 6

let section_canon = 8

let core_sort_func = 0

let read_name_info: (Bytes, Int) -> (Int, Int) = (bytes, start) -> {
  read_uleb(bytes, start)
}

let skip_name: (Bytes, Int) -> Int = (bytes, start) -> {
  let (name_len, after_len) = read_name_info(bytes, start)
  after_len + name_len
}

let section_export = 11

let section_import = 10

let section_module = 1

let parse_type_sigs: (Bytes, Int, Int, Array[Array[Int]]) -> Unit = (bytes, sec_start, sec_end, out_sigs) -> {
  let mut j = sec_start
  let (type_count, next_j) = read_uleb(bytes, j)
  j = next_j
  let mut t = 0
  while t < type_count {
    if j >= sec_end {
      t = type_count
    }
    else {
      let form = Bytes::get(bytes, j)
      j = j + 1
      if form != 96 {
        t = type_count
      }
      else {
        let sig = new_int_array()
        let (param_count, next_j2) = read_uleb(bytes, j)
        j = next_j2
        Array::push(sig, param_count)
        let mut p = 0
        while p < param_count {
          if j >= sec_end {
            p = param_count
          }
          else {
            Array::push(sig, Bytes::get(bytes, j))
            j = j + 1
            p = p + 1
          }
        }
        let (result_count, next_j3) = read_uleb(bytes, j)
        j = next_j3
        Array::push(sig, result_count)
        let mut rv = 0
        while rv < result_count {
          if j >= sec_end {
            rv = result_count
          }
          else {
            Array::push(sig, Bytes::get(bytes, j))
            j = j + 1
            rv = rv + 1
          }
        }
        Array::push(out_sigs, sig)
        t = t + 1
      }
    }
  }
}

let comp_extern_func = 1

let comp_valtype_f32 = 118

let comp_valtype_f64 = 117

let comp_valtype_s32 = 122

let comp_valtype_s64 = 120

let emit_raw_content: (Bytes, Bytes) -> Unit = (buf, content) -> {
  leb128_encode_u32(buf, Bytes::length(content))
  bytebuf_push_buf(buf, content)
}

let read_name_string: (Bytes, Int) -> String = (bytes, start) -> {
  let (name_len, after_len) = read_name_info(bytes, start)
  let buf = StringBuilder::new()
  let mut i = 0
  while i < name_len {
    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

let skip_wasm_limits: (Bytes, Int, Int) -> Int = (bytes, start, end_pos) -> {
  let mut i = start
  if i >= end_pos {
    end_pos
  }
  else {
    let flags = Bytes::get(bytes, i)
    i = i + 1
    let (min_limit, next_i1) = read_uleb(bytes, i)
    let _ = min_limit
    i = next_i1
    if (flags&1) != 0 {
      let (max_limit, next_i2) = read_uleb(bytes, i)
      let _ = max_limit
      i = next_i2
    }
    if (flags&4) != 0 {
      let (page_size, next_i3) = read_uleb(bytes, i)
      let _ = page_size
      i = next_i3
    }
    if i > end_pos {
      end_pos
    } else {
      i
    }
  }
}

let component_magic_0 = 0

let component_magic_1 = 97

let component_magic_2 = 115

let component_magic_3 = 109

let emit_alias_section: (Bytes, Int, Array[String], Array[Int]) -> Unit = (buf, core_instance_idx, names, sorts) -> {
  let count = Array::length(names)
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_alias)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      bytebuf_push(content, 0)
      bytebuf_push(content, Array::get(sorts, i))
      bytebuf_push(content, 1)
      leb128_encode_u32(content, core_instance_idx)
      emit_name(content, Array::get(names, i))
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

let comp_valtype_string = 115

let component_version_0 = 13

let component_version_1 = 0

let component_version_2 = 1

let component_version_3 = 0

let core_to_comp_valtype: (Int) -> Int = (v) -> {
  if v == 127 {
    comp_valtype_s32
  }
  else {
    if v == 126 {
      comp_valtype_s64
    }
    else {
      if v == 125 {
        comp_valtype_f32
      }
      else {
        if v == 124 {
          comp_valtype_f64
        }
        else {
          0 - 1
        }
      }
    }
  }
}

let emit_canon_lift_func: (Bytes, Int, Int, Int, Int, Int) -> Unit = (content, core_func_idx, type_idx, need_string, memory_idx, realloc_idx) -> {
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, core_func_idx)
  if need_string != 0 {
    leb128_encode_u32(content, 3)
    bytebuf_push(content, 0)
    bytebuf_push(content, 3)
    leb128_encode_u32(content, memory_idx)
    bytebuf_push(content, 4)
    leb128_encode_u32(content, realloc_idx)
  } else {
    leb128_encode_u32(content, 0)
  }
  leb128_encode_u32(content, type_idx)
}

let emit_component_header: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, component_magic_0)
  bytebuf_push(buf, component_magic_1)
  bytebuf_push(buf, component_magic_2)
  bytebuf_push(buf, component_magic_3)
  bytebuf_push(buf, component_version_0)
  bytebuf_push(buf, component_version_1)
  bytebuf_push(buf, component_version_2)
  bytebuf_push(buf, component_version_3)
}

let section_core_instance = 2

let skip_core_import_desc: (Bytes, Int, Int, Int) -> Int = (bytes, start, kind, end_pos) -> {
  let mut i = start
  if kind == 1 {
    if i < end_pos {
      i = i + 1
    }
    i = skip_wasm_limits(bytes, i, end_pos)
  } else {
    if kind == 2 {
      i = skip_wasm_limits(bytes, i, end_pos)
    } else {
      if kind == 3 {
        if (i + 2) <= end_pos {
          i = i + 2
        } else {
          i = end_pos
        }
      } else {
        if kind == 4 {
          if i < end_pos {
            i = i + 1
          }
          let (type_idx, next_i) = read_uleb(bytes, i)
          let _ = type_idx
          i = next_i
        } else {
          i = end_pos
        }
      }
    }
  }
  if i > end_pos {
    end_pos
  } else {
    i
  }
}

let parse_core_exports: (Bytes, Array[String], Array[Int], Array[Array[Int]]) -> Int = (core_wasm, out_names, out_func_indices, out_type_sigs) -> {
  let len = Bytes::length(core_wasm)
  if len < 8 {
    0
  }
  else {
    let type_sigs = Array::slice([
      [
        0
      ]
    ], 0, 0)
    let func_type_indices = new_int_array()
    let mut import_func_count = 0
    let mut i = 8
    let mut export_count = 0
    while i < len {
      let sec_id = Bytes::get(core_wasm, i)
      i = i + 1
      let (sec_size, next_i) = read_uleb(core_wasm, i)
      i = next_i
      let sec_end = i + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id == 1 {
          parse_type_sigs(core_wasm, i, sec_end, type_sigs)
        } else {
          if sec_id == 2 {
            let mut j = i
            let (imp_count, next_j) = read_uleb(core_wasm, j)
            j = next_j
            let mut imp = 0
            while imp < imp_count {
              if j >= sec_end {
                imp = imp_count
              }
              else {
                j = skip_name(core_wasm, j)
                j = skip_name(core_wasm, j)
                if j >= sec_end {
                  imp = imp_count
                }
                else {
                  let kind = Bytes::get(core_wasm, j)
                  j = j + 1
                  if kind == 0 {
                    let (type_idx, next_j2) = read_uleb(core_wasm, j)
                    let _ = type_idx
                    j = next_j2
                    import_func_count = import_func_count + 1
                  } else {
                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)
                  }
                  imp = imp + 1
                }
              }
            }
          } else {
            if sec_id == 3 {
              let mut j = i
              let (func_count, next_j) = read_uleb(core_wasm, j)
              j = next_j
              let mut f = 0
              while f < func_count {
                if j >= sec_end {
                  f = func_count
                }
                else {
                  let (type_idx, next_j2) = read_uleb(core_wasm, j)
                  Array::push(func_type_indices, type_idx)
                  j = next_j2
                  f = f + 1
                }
              }
            } else {
              if sec_id == 7 {
                let mut j = i
                let (exp_count, next_j) = read_uleb(core_wasm, j)
                j = next_j
                let mut e = 0
                while e < exp_count {
                  if j >= sec_end {
                    e = exp_count
                  }
                  else {
                    let name = read_name_string(core_wasm, j)
                    j = skip_name(core_wasm, j)
                    if j >= sec_end {
                      e = exp_count
                    }
                    else {
                      let kind = Bytes::get(core_wasm, j)
                      j = j + 1
                      let (index, next_j2) = read_uleb(core_wasm, j)
                      j = next_j2
                      if kind == 0 {
                        let type_idx = if index < import_func_count {
                          0 - 1
                        }
                        else {
                          let local_idx = index - import_func_count
                          if local_idx < Array::length(func_type_indices) {
                            Array::get(func_type_indices, local_idx)
                          } else {
                            0 - 1
                          }
                        }
                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {
                          Array::push(out_names, name)
                          Array::push(out_func_indices, index)
                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))
                          export_count = export_count + 1
                        }
                      }
                      e = e + 1
                    }
                  }
                }
              }
            }
          }
        }
        i = sec_end
      }
    }
    export_count
  }
}

let parse_core_imports: (Bytes, Array[String], Array[String], Array[Int], Array[Array[Int]]) -> Int = (core_wasm, out_module_names, out_func_names, out_type_indices, out_type_sigs) -> {
  let len = Bytes::length(core_wasm)
  if len < 8 {
    0
  }
  else {
    let mut i = 8
    let mut import_count = 0
    while i < len {
      let sec_id = Bytes::get(core_wasm, i)
      i = i + 1
      let (sec_size, next_i) = read_uleb(core_wasm, i)
      i = next_i
      let sec_end = i + sec_size
      if sec_end > len {
        i = len
      }
      else {
        if sec_id == 1 {
          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)
        } else {
          if sec_id == 2 {
            let mut j = i
            let (imp_count, next_j) = read_uleb(core_wasm, j)
            j = next_j
            let mut imp = 0
            while imp < imp_count {
              if j >= sec_end {
                imp = imp_count
              }
              else {
                let mod_name = read_name_string(core_wasm, j)
                j = skip_name(core_wasm, j)
                let fn_name = read_name_string(core_wasm, j)
                j = skip_name(core_wasm, j)
                if j >= sec_end {
                  imp = imp_count
                }
                else {
                  let kind = Bytes::get(core_wasm, j)
                  j = j + 1
                  if kind == 0 {
                    let (type_idx, next_j2) = read_uleb(core_wasm, j)
                    j = next_j2
                    Array::push(out_module_names, mod_name)
                    Array::push(out_func_names, fn_name)
                    Array::push(out_type_indices, type_idx)
                    import_count = import_count + 1
                  } else {
                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)
                  }
                  imp = imp + 1
                }
              }
            }
          }
        }
        i = sec_end
      }
    }
    import_count
  }
}

let build_import_plan: (Bytes, Array[String], Array[String], Array[Int], Array[String], Array[Int], Array[Array[Int]], Array[Array[String]], Array[Array[Int]]) -> Int = (core_wasm, out_import_names, out_binding_func_names, out_binding_func_indices, out_unique_module_names, out_module_binding_counts, out_comp_params, out_comp_param_names, out_comp_results) -> {
  let imp_module_names = Array::slice([
    ""
  ], 0, 0)
  let imp_func_names = Array::slice([
    ""
  ], 0, 0)
  let imp_type_indices = new_int_array()
  let type_sigs = Array::slice([
    [
      0
    ]
  ], 0, 0)
  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)
  let seen_keys = Array::slice([
    ""
  ], 0, 0)
  let module_idx_map_keys = Array::slice([
    ""
  ], 0, 0)
  let module_idx_map_vals = new_int_array()
  let mut binding_count = 0
  let mut i = 0
  while i < Array::length(imp_module_names) {
    let mod_name = Array::get(imp_module_names, i)
    let fn_name = Array::get(imp_func_names, i)
    let key = "\{mod_name}||\{fn_name}"
    let mut already = false
    let mut s = 0
    while s < Array::length(seen_keys) {
      if Array::get(seen_keys, s) == key {
        already = true
      }
      s = s + 1
    }
    if already == false {
      Array::push(seen_keys, key)
      let type_idx = Array::get(imp_type_indices, i)
      if type_idx < Array::length(type_sigs) {
        let sig = Array::get(type_sigs, type_idx)
        let param_count = Array::get(sig, 0)
        let result_count_index = 1 + param_count
        let result_count = Array::get(sig, result_count_index)
        let comp_params = new_int_array()
        let mut valid = true
        let mut p = 0
        while p < param_count {
          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))
          if cv < 0 {
            valid = false
          }
          else {
            Array::push(comp_params, cv)
          }
          p = p + 1
        }
        let comp_results = new_int_array()
        let mut r = 0
        while r < result_count {
          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))
          if cv < 0 {
            valid = false
          }
          else {
            Array::push(comp_results, cv)
          }
          r = r + 1
        }
        if valid {
          let mut mod_idx = 0 - 1
          let mut mi = 0
          while mi < Array::length(module_idx_map_keys) {
            if Array::get(module_idx_map_keys, mi) == mod_name {
              mod_idx = Array::get(module_idx_map_vals, mi)
            }
            mi = mi + 1
          }
          if mod_idx < 0 {
            mod_idx = Array::length(out_unique_module_names)
            Array::push(out_unique_module_names, mod_name)
            Array::push(out_module_binding_counts, 0)
            Array::push(module_idx_map_keys, mod_name)
            Array::push(module_idx_map_vals, mod_idx)
          }
          let import_name = "import-\{binding_count}"
          Array::push(out_import_names, import_name)
          Array::push(out_binding_func_names, fn_name)
          Array::push(out_binding_func_indices, binding_count)
          Array::push(out_comp_params, comp_params)
          let empty_names = Array::slice([
            ""
          ], 0, 0)
          Array::push(out_comp_param_names, empty_names)
          Array::push(out_comp_results, comp_results)
          let cur = Array::get(out_module_binding_counts, mod_idx)
          Array::set(out_module_binding_counts, mod_idx, cur + 1)
          binding_count = binding_count + 1
        }
      }
    }
    i = i + 1
  }
  binding_count
}

let comp_inst_arg_instance = 18

let emit_canon_lift_section: (Bytes, Int, Int) -> Unit = (buf, core_func_idx, type_idx) -> {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)
  emit_raw_content(buf, content)
}

let emit_canon_lower_section: (Bytes, Int) -> Unit = (buf, count) -> {
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_canon)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      bytebuf_push(content, 1)
      bytebuf_push(content, 0)
      leb128_encode_u32(content, i)
      leb128_encode_u32(content, 0)
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

let emit_comp_import_section: (Bytes, Array[String], Int) -> Unit = (buf, import_names, count) -> {
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_import)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      bytebuf_push(content, 0)
      emit_name(content, Array::get(import_names, i))
      bytebuf_push(content, comp_extern_func)
      leb128_encode_u32(content, i)
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

let emit_core_module_section: (Bytes, Bytes) -> Unit = (buf, core_wasm) -> {
  bytebuf_push(buf, section_module)
  let wasm_len = Bytes::length(core_wasm)
  leb128_encode_u32(buf, wasm_len)
  bytebuf_push_buf(buf, core_wasm)
}

let emit_alias_run_and_memory: (Bytes, Int) -> Unit = (buf, core_instance_idx) -> {
  emit_alias_section(buf, core_instance_idx, [
    "_start",
    "memory"
  ], [
    core_sort_func,
    core_sort_mem
  ])
}

let comp_underscores_to_dashes: (String) -> String = (name) -> {
  let len = String::length(name)
  let mut out = ""
  let mut i = 0
  while i < len {
    let c = String::char_code_at(name, i)
    if c == 95 {
      out = String::concat(out, "-")
    } else {
      out = String::concat(out, String::from_char_code(c))
    }
    i = i + 1
  }
  out
}

let normalize_comp_param_name: (String) -> String = (name) -> {
  comp_underscores_to_dashes(name)
}

let emit_comp_func_type: (Bytes, Array[Int], Array[String], Array[Int], Int) -> Unit = (content, param_types, param_names, result_types, is_async) -> {
  if is_async != 0 {
    bytebuf_push(content, 67)
  } else {
    bytebuf_push(content, 64)
  }
  leb128_encode_u32(content, Array::length(param_types))
  let mut i = 0
  while i < Array::length(param_types) {
    let name = if i < Array::length(param_names) {
      normalize_comp_param_name(Array::get(param_names, i))
    }
    else {
      "p\{i}"
    }
    emit_name(content, name)
    bytebuf_push(content, Array::get(param_types, i))
    i = i + 1
  }
  if Array::length(result_types) == 0 {
    bytebuf_push(content, 1)
    leb128_encode_u32(content, 0)
  } else {
    if Array::length(result_types) == 1 {
      bytebuf_push(content, 0)
      bytebuf_push(content, Array::get(result_types, 0))
    } else {
      bytebuf_push(content, 1)
      leb128_encode_u32(content, Array::length(result_types))
      let mut r = 0
      while r < Array::length(result_types) {
        emit_name(content, "r\{r}")
        bytebuf_push(content, Array::get(result_types, r))
        r = r + 1
      }
    }
  }
}

let emit_comp_type_section: (Bytes, Array[Array[Int]], Array[Array[String]], Array[Array[Int]], Array[Int]) -> Unit = (buf, sigs_params, sigs_param_names, sigs_results, sigs_async) -> {
  let count = Array::length(sigs_params)
  if count == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_type)
    let content = bytebuf_new()
    leb128_encode_u32(content, count)
    let mut i = 0
    while i < count {
      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))
      i = i + 1
    }
    emit_raw_content(buf, content)
  }
}

let emit_comp_type_section_run: (Bytes) -> Unit = (buf) -> {
  bytebuf_push(buf, section_type)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  emit_comp_func_type(content, Array::slice([
    0
  ], 0, 0), Array::slice([
    ""
  ], 0, 0), [
    comp_valtype_s64
  ], 0)
  emit_raw_content(buf, content)
}

let normalize_comp_export_name: (String) -> String = (name) -> {
  comp_underscores_to_dashes(name)
}

let emit_comp_export_section: (Bytes, String, Int) -> Unit = (buf, name, func_idx) -> {
  let export_name = normalize_comp_export_name(name)
  bytebuf_push(buf, section_export)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  emit_name(content, export_name)
  bytebuf_push(content, comp_extern_func)
  leb128_encode_u32(content, func_idx)
  leb128_encode_u32(content, 0)
  emit_raw_content(buf, content)
}

export let comp_generate_string_trampoline: (Int, Int) -> Bytes = (string_param_count, call_run_init) -> {
  let buf = bytebuf_new()
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 97)
  bytebuf_push(buf, 115)
  bytebuf_push(buf, 109)
  bytebuf_push(buf, 1)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
  bytebuf_push(buf, 0)
  let body = bytebuf_new()
  let type_sec = bytebuf_new()
  leb128_encode_u32(type_sec, if call_run_init != 0 {
    4
  } else {
    3
  })
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, string_param_count + 1)
  let mut ti = 0
  while ti < string_param_count {
    bytebuf_push(type_sec, 126)
    ti = ti + 1
  }
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 126)
  bytebuf_push(type_sec, 96)
  bytebuf_push(type_sec, 4)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 127)
  bytebuf_push(type_sec, 96)
  leb128_encode_u32(type_sec, string_param_count * 2)
  let mut ci = 0
  while ci < (string_param_count * 2) {
    bytebuf_push(type_sec, 127)
    ci = ci + 1
  }
  bytebuf_push(type_sec, 1)
  bytebuf_push(type_sec, 126)
  if call_run_init != 0 {
    bytebuf_push(type_sec, 96)
    leb128_encode_u32(type_sec, 0)
    bytebuf_push(type_sec, 1)
    bytebuf_push(type_sec, 126)
  }
  bytebuf_push_section(body, 1, type_sec)
  let import_sec = bytebuf_new()
  leb128_encode_u32(import_sec, if call_run_init != 0 {
    4
  } else {
    3
  })
  emit_name(import_sec, "env")
  emit_name(import_sec, "target_func")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  emit_name(import_sec, "env")
  emit_name(import_sec, "cabi_realloc")
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 1)
  if call_run_init != 0 {
    emit_name(import_sec, "env")
    emit_name(import_sec, "run_init")
    bytebuf_push(import_sec, 0)
    leb128_encode_u32(import_sec, 3)
  }
  emit_name(import_sec, "env")
  emit_name(import_sec, "memory")
  bytebuf_push(import_sec, 2)
  bytebuf_push(import_sec, 0)
  leb128_encode_u32(import_sec, 0)
  bytebuf_push_section(body, 2, import_sec)
  let func_sec = bytebuf_new()
  leb128_encode_u32(func_sec, 1)
  leb128_encode_u32(func_sec, 2)
  bytebuf_push_section(body, 3, func_sec)
  let export_sec = bytebuf_new()
  leb128_encode_u32(export_sec, 1)
  emit_name(export_sec, "canon_func")
  bytebuf_push(export_sec, 0)
  leb128_encode_u32(export_sec, if call_run_init != 0 {
    3
  } else {
    2
  })
  bytebuf_push_section(body, 7, export_sec)
  let code_sec = bytebuf_new()
  leb128_encode_u32(code_sec, 1)
  let func_body = bytebuf_new()
  leb128_encode_u32(func_body, 2)
  leb128_encode_u32(func_body, string_param_count)
  bytebuf_push(func_body, 126)
  leb128_encode_u32(func_body, string_param_count)
  bytebuf_push(func_body, 127)
  if call_run_init != 0 {
    bytebuf_push(func_body, 16)
    leb128_encode_u32(func_body, 2)
    bytebuf_push(func_body, 26)
  }
  let tagged_base = string_param_count * 2
  let obj_base = tagged_base + string_param_count
  let mut si = 0
  while si < string_param_count {
    let ptr_local = si * 2
    let len_local = (si * 2) + 1
    let tagged_local = tagged_base + si
    let obj_local = obj_base + si
    emit_i32_const(func_body, 0)
    emit_i32_const(func_body, 0)
    emit_i32_const(func_body, 4)
    emit_local_get(func_body, len_local)
    emit_i32_const(func_body, 8)
    emit_i32_add(func_body)
    bytebuf_push(func_body, 16)
    leb128_encode_u32(func_body, 1)
    emit_local_set(func_body, obj_local)
    emit_local_get(func_body, obj_local)
    emit_i32_const(func_body, 1)
    emit_i32_store(func_body, 0, 0)
    emit_local_get(func_body, obj_local)
    emit_local_get(func_body, len_local)
    emit_i32_store(func_body, 0, 4)
    emit_local_get(func_body, obj_local)
    emit_i32_const(func_body, 8)
    emit_i32_add(func_body)
    emit_local_get(func_body, ptr_local)
    emit_local_get(func_body, len_local)
    bytebuf_push(func_body, 252)
    leb128_encode_u32(func_body, 10)
    bytebuf_push(func_body, 0)
    bytebuf_push(func_body, 0)
    emit_local_get(func_body, obj_local)
    bytebuf_push(func_body, 173)
    bytebuf_push(func_body, 66)
    leb128_encode_s64(func_body, 1)
    bytebuf_push(func_body, 132)
    emit_local_set(func_body, tagged_local)
    si = si + 1
  }
  let mut ci2 = 0
  while ci2 < string_param_count {
    emit_local_get(func_body, tagged_base + ci2)
    ci2 = ci2 + 1
  }
  emit_i32_const(func_body, 0)
  bytebuf_push(func_body, 16)
  leb128_encode_u32(func_body, 0)
  bytebuf_push(func_body, 11)
  leb128_encode_u32(code_sec, Bytes::length(func_body))
  bytebuf_push_buf(code_sec, func_body)
  bytebuf_push_section(body, 10, code_sec)
  bytebuf_push_buf(buf, body)
  bytebuf_to_bytes(buf)
}

let emit_core_instance_from_exports: (Bytes, Int, Array[Int], Array[String], Array[Int]) -> Unit = (buf, num_modules, module_binding_counts, binding_func_names, binding_func_indices) -> {
  if num_modules == 0 {
    ()
  }
  else {
    bytebuf_push(buf, section_core_instance)
    let content = bytebuf_new()
    leb128_encode_u32(content, num_modules)
    let mut offset = 0
    let mut m = 0
    while m < num_modules {
      let count = Array::get(module_binding_counts, m)
      bytebuf_push(content, 1)
      leb128_encode_u32(content, count)
      let mut b = 0
      while b < count {
        emit_name(content, Array::get(binding_func_names, offset + b))
        bytebuf_push(content, core_sort_func)
        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))
        b = b + 1
      }
      offset = offset + count
      m = m + 1
    }
    emit_raw_content(buf, content)
  }
}

let emit_core_instance_instantiate_section: (Bytes, Int, Array[String]) -> Unit = (buf, module_index, module_names) -> {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, module_index)
  leb128_encode_u32(content, Array::length(module_names))
  let mut i = 0
  while i < Array::length(module_names) {
    emit_name(content, Array::get(module_names, i))
    bytebuf_push(content, comp_inst_arg_instance)
    leb128_encode_u32(content, i)
    i = i + 1
  }
  emit_raw_content(buf, content)
}

export let comp_emit_component_wasm: (Bytes) -> Bytes = (core_wasm) -> {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_instance_instantiate_section(buf, 0, Array::slice([
    ""
  ], 0, 0))
  emit_alias_run_and_memory(buf, 0)
  bytebuf_to_bytes(buf)
}

export let comp_emit_component_wasm_with_lift: (Bytes, String) -> Bytes = (core_wasm, export_name) -> {
  let import_names = Array::slice([
    ""
  ], 0, 0)
  let binding_func_names = Array::slice([
    ""
  ], 0, 0)
  let binding_func_indices = new_int_array()
  let unique_module_names = Array::slice([
    ""
  ], 0, 0)
  let module_binding_counts = new_int_array()
  let comp_params = Array::slice([
    [
      0
    ]
  ], 0, 0)
  let comp_param_names = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let comp_results = Array::slice([
    [
      0
    ]
  ], 0, 0)
  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)
  let main_instance_idx = Array::length(unique_module_names)
  let run_core_func_idx = import_func_count
  let run_type_idx = import_func_count
  let run_func_idx = import_func_count
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  let async_flags = new_int_array()
  let mut af = 0
  while af < import_func_count {
    Array::push(async_flags, 0)
    af = af + 1
  }
  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)
  emit_comp_import_section(buf, import_names, import_func_count)
  emit_canon_lower_section(buf, import_func_count)
  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)
  emit_core_instance_instantiate_section(buf, 0, unique_module_names)
  emit_alias_run_and_memory(buf, main_instance_idx)
  emit_comp_type_section_run(buf)
  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)
  emit_comp_export_section(buf, export_name, run_func_idx)
  bytebuf_to_bytes(buf)
}

export let comp_emit_component_wasm_with_string_lift: (Bytes, String, String, Int, Array[String], Int) -> Bytes = (core_wasm, target_func_name, export_name, string_param_count, param_names, is_async) -> {
  let import_names = Array::slice([
    ""
  ], 0, 0)
  let binding_func_names = Array::slice([
    ""
  ], 0, 0)
  let binding_func_indices = new_int_array()
  let unique_module_names = Array::slice([
    ""
  ], 0, 0)
  let module_binding_counts = new_int_array()
  let comp_params = Array::slice([
    [
      0
    ]
  ], 0, 0)
  let comp_param_names = Array::slice([
    Array::slice([
      ""
    ], 0, 0)
  ], 0, 0)
  let comp_results = Array::slice([
    [
      0
    ]
  ], 0, 0)
  let export_names = Array::slice([
    ""
  ], 0, 0)
  let export_func_indices = new_int_array()
  let export_type_sigs = Array::slice([
    [
      0
    ]
  ], 0, 0)
  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)
  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)
  let mut call_run_init = 0
  let mut ei = 0
  while ei < Array::length(export_names) {
    if Array::get(export_names, ei) == "_start" {
      call_run_init = 1
      ei = Array::length(export_names)
    } else {
      ei = ei + 1
    }
  }
  let has_distinct_run_alias =
  if (call_run_init != 0) && (target_func_name != "_start") {
    1
  } else {
    0
  }
  let main_instance_idx = Array::length(unique_module_names)
  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_core_module_section(buf, trampoline_wasm)
  let async_flags = new_int_array()
  let mut af = 0
  while af < import_func_count {
    Array::push(async_flags, 0)
    af = af + 1
  }
  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)
  emit_comp_import_section(buf, import_names, import_func_count)
  emit_canon_lower_section(buf, import_func_count)
  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)
  emit_core_instance_instantiate_section(buf, 0, unique_module_names)
  let alias_names = Array::slice([
    ""
  ], 0, 0)
  let alias_sorts = new_int_array()
  Array::push(alias_names, target_func_name)
  Array::push(alias_sorts, core_sort_func)
  Array::push(alias_names, "cabi_realloc")
  Array::push(alias_sorts, core_sort_func)
  if has_distinct_run_alias != 0 {
    Array::push(alias_names, "_start")
    Array::push(alias_sorts, core_sort_func)
  }
  Array::push(alias_names, "memory")
  Array::push(alias_sorts, core_sort_mem)
  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)
  let target_func_core_idx = import_func_count
  let cabi_realloc_core_idx = import_func_count + 1
  let run_init_core_idx =
  if call_run_init != 0 {
    if has_distinct_run_alias != 0 {
      import_func_count + 2
    } else {
      target_func_core_idx
    }
  } else {
    0 - 1
  }
  bytebuf_push(buf, section_core_instance)
  let tramp_env = bytebuf_new()
  leb128_encode_u32(tramp_env, 1)
  bytebuf_push(tramp_env, 1)
  leb128_encode_u32(tramp_env, if call_run_init != 0 {
    4
  } else {
    3
  })
  emit_name(tramp_env, "target_func")
  bytebuf_push(tramp_env, core_sort_func)
  leb128_encode_u32(tramp_env, target_func_core_idx)
  emit_name(tramp_env, "cabi_realloc")
  bytebuf_push(tramp_env, core_sort_func)
  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)
  if call_run_init != 0 {
    emit_name(tramp_env, "run_init")
    bytebuf_push(tramp_env, core_sort_func)
    leb128_encode_u32(tramp_env, run_init_core_idx)
  }
  emit_name(tramp_env, "memory")
  bytebuf_push(tramp_env, core_sort_mem)
  leb128_encode_u32(tramp_env, 0)
  emit_raw_content(buf, tramp_env)
  let env_instance_idx = main_instance_idx + 1
  bytebuf_push(buf, section_core_instance)
  let tramp_inst = bytebuf_new()
  leb128_encode_u32(tramp_inst, 1)
  bytebuf_push(tramp_inst, 0)
  leb128_encode_u32(tramp_inst, 1)
  leb128_encode_u32(tramp_inst, 1)
  emit_name(tramp_inst, "env")
  bytebuf_push(tramp_inst, comp_inst_arg_instance)
  leb128_encode_u32(tramp_inst, env_instance_idx)
  emit_raw_content(buf, tramp_inst)
  let trampoline_instance_idx = env_instance_idx + 1
  emit_alias_section(buf, trampoline_instance_idx, [
    "canon_func"
  ], [
    core_sort_func
  ])
  let alias_func_count = if has_distinct_run_alias != 0 {
    3
  } else {
    2
  }
  let canon_func_core_idx = import_func_count + alias_func_count
  bytebuf_push(buf, section_type)
  let type_content = bytebuf_new()
  leb128_encode_u32(type_content, 1)
  if is_async != 0 {
    bytebuf_push(type_content, 67)
  } else {
    bytebuf_push(type_content, 64)
  }
  leb128_encode_u32(type_content, string_param_count)
  let mut pi = 0
  while pi < string_param_count {
    let pname = if pi < Array::length(param_names) {
      normalize_comp_param_name(Array::get(param_names, pi))
    }
    else {
      "p\{pi}"
    }
    emit_name(type_content, pname)
    bytebuf_push(type_content, comp_valtype_string)
    pi = pi + 1
  }
  bytebuf_push(type_content, 0)
  bytebuf_push(type_content, comp_valtype_s64)
  emit_raw_content(buf, type_content)
  let component_type_idx = import_func_count
  bytebuf_push(buf, section_canon)
  let canon_content = bytebuf_new()
  leb128_encode_u32(canon_content, 1)
  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)
  emit_raw_content(buf, canon_content)
  let lifted_func_idx = import_func_count
  emit_comp_export_section(buf, export_name, lifted_func_idx)
  bytebuf_to_bytes(buf)
}

let emit_canon_task_return: (Bytes, Int) -> Unit = (buf, result_valtype) -> {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 9)
  bytebuf_push(content, 0)
  bytebuf_push(content, result_valtype)
  bytebuf_push(content, 0)
  emit_raw_content(buf, content)
}

let emit_canon_lift_async_section: (Bytes, Int, Int) -> Unit = (buf, core_func_idx, type_idx) -> {
  bytebuf_push(buf, section_canon)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, core_func_idx)
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 6)
  leb128_encode_u32(content, type_idx)
  emit_raw_content(buf, content)
}

let emit_comp_async_functype_section: (Bytes, Int) -> Unit = (buf, result_valtype) -> {
  bytebuf_push(buf, section_type)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 67)
  bytebuf_push(content, 0)
  bytebuf_push(content, 0)
  bytebuf_push(content, result_valtype)
  emit_raw_content(buf, content)
}

export let comp_emit_component_wasm_async: (Bytes, String, Int) -> Bytes = (core_wasm, export_name, result_valtype) -> {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, core_wasm)
  emit_canon_task_return(buf, result_valtype)
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    0
  ])
  emit_core_instance_instantiate_section(buf, 0, [
    "cm"
  ])
  emit_comp_async_functype_section(buf, result_valtype)
  emit_alias_section(buf, 1, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, 1, 0)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

let comp_valtype_to_core: (Int) -> Int = (v) -> {
  if v == comp_valtype_s64 {
    126
  }
  else {
    if v == comp_valtype_s32 {
      127
    }
    else {
      if v == comp_valtype_f32 {
        125
      }
      else {
        if v == comp_valtype_f64 {
          124
        }
        else {
          127
        }
      }
    }
  }
}

let comp_generate_async_trampoline: (Int) -> Bytes = (core_valtype) -> {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 3)
  emit_func_type_raw(tc, [
    126
  ], [
    core_valtype
  ])
  emit_func_type_raw(tc, [
    core_valtype
  ], Array::slice([
    0
  ], 0, 0))
  emit_func_type_raw(tc, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, 1, tc)
  let ic = bytebuf_new()
  bytebuf_push_vec_header(ic, 2)
  emit_name(ic, "main")
  emit_name(ic, "run")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 0)
  emit_name(ic, "cm")
  emit_name(ic, "task-return")
  bytebuf_push(ic, 0)
  bytebuf_push(ic, 1)
  bytebuf_push_section(out, 2, ic)
  emit_function_section(out, [
    2
  ])
  emit_export_section(out, "run", 2)
  let body = bytebuf_new()
  emit_i64_const(body, 0)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 0)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 1)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

let emit_core_instance_instantiate_args: (Bytes, Int, Array[String], Array[Int]) -> Unit = (buf, module_index, arg_names, arg_instance_indices) -> {
  bytebuf_push(buf, section_core_instance)
  let content = bytebuf_new()
  leb128_encode_u32(content, 1)
  bytebuf_push(content, 0)
  leb128_encode_u32(content, module_index)
  leb128_encode_u32(content, Array::length(arg_names))
  let mut i = 0
  while i < Array::length(arg_names) {
    emit_name(content, Array::get(arg_names, i))
    bytebuf_push(content, comp_inst_arg_instance)
    leb128_encode_u32(content, Array::get(arg_instance_indices, i))
    i = i + 1
  }
  emit_raw_content(buf, content)
}

export let comp_emit_component_wasm_async_trampolined: (Bytes, String, Int) -> Bytes = (main_core_wasm, export_name, comp_result_valtype) -> {
  let buf = bytebuf_new()
  emit_component_header(buf)
  emit_core_module_section(buf, main_core_wasm)
  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))
  emit_core_instance_instantiate_section(buf, 0, Array::slice([
    ""
  ], 0, 0))
  emit_canon_task_return(buf, comp_result_valtype)
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "task-return"
  ], [
    0
  ])
  emit_alias_section(buf, 0, [
    "run"
  ], [
    core_sort_func
  ])
  emit_core_instance_from_exports(buf, 1, [
    1
  ], [
    "run"
  ], [
    1
  ])
  emit_core_instance_instantiate_args(buf, 1, [
    "main",
    "cm"
  ], [
    2,
    1
  ])
  emit_comp_async_functype_section(buf, comp_result_valtype)
  emit_alias_section(buf, 3, [
    "run"
  ], [
    core_sort_func
  ])
  emit_canon_lift_async_section(buf, 2, 0)
  emit_comp_export_section(buf, export_name, 0)
  bytebuf_to_bytes(buf)
}

