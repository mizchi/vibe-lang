      let single_tuple_param = match sig_args_raw {
        Some(a) => Array::length(ps) == 1 && Array::length(a) > 1,
        None => false
      }
      let np = Array::slice(ps, 0, 0)
      let mut spi = 0
      while spi < Array::length(ps) {
        let (sraw, sty) = Array::get(ps, spi)
        let slen = String::length(sraw)
        let ssn = if slen > 0 {
          let slc = String::char_code_at(sraw, slen - 1)
          if slc == '~' || slc == '?' {
            sraw[0: slen - 1]
          } else {
            sraw
          }
        } else {
          sraw
        }
        let resolved_ty = match sty {
          Some(_) => sty,
          None =>
          match sig_args_raw {
            Some(args) =>
            if single_tuple_param {
              Some(TyTuple(args))
            } else if Array::length(args) == Array::length(ps) {
              Some(Array::get(args, spi))
            } else {
              None
            },
            None => None
          }
        }
        Array::push(np, (ssn, resolved_ty))
        spi = spi + 1
      }
      np
    } else {
