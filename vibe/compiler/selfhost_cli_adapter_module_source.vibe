  if enable_rc {
    emit_i64_const(b, 1)
    emit_i64_shl(b)
  }
  b
}

export let gen_arr_new_body: (Bool, Int) -> Bytes = (enable_rc, rc_alloc_idx) -> {
  let b = bytebuf_new()
  if enable_rc {
    emit_i64_const(b, 84)
    emit_call(b, rc_alloc_idx)
    emit_i32_wrap_i64(b)
    emit_local_set(b, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 84)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 1)
    emit_i32_store(b, 2, 4)
    emit_local_get(b, 0)
    emit_i32_const(b, 5)
    emit_i32_store8(b, 0, 7)
    emit_local_get(b, 0)
    emit_i32_const(b, 8)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 0)
    emit_i32_const(b, 0)
    emit_i32_store(b, 2, 12)
    emit_local_get(b, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 20)
    emit_i32_add(b)
    emit_i32_store(b, 2, 16)
    emit_local_get(b, 0)
    emit_i32_const(b, 8)
    emit_i32_add(b)
    emit_i64_extend_i32_u(b)
    emit_i64_const(b, 1)
    emit_i64_or(b)
  } else {
    emit_global_get(b, 0)
    emit_local_tee(b, 0)
    emit_i32_const(b, 76)
    emit_i32_add(b)
    emit_global_set(b, 0)
    emit_heap_memory_grow_check(b)
    emit_local_get(b, 0)
    emit_i32_const(b, 8)
    emit_i32_store(b, 2, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 0)
    emit_i32_store(b, 2, 4)
    emit_local_get(b, 0)
    emit_local_get(b, 0)
    emit_i32_const(b, 12)
    emit_i32_add(b)
    emit_i32_store(b, 2, 8)
    emit_local_get(b, 0)
    emit_i64_extend_i32_u(b)
  }
  b
}

