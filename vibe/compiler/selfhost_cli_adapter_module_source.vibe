let empty_int_array: () -> Array[Int] = () -> {
  Array::slice([
    0
  ], 0, 0)
}

let pair_int_array: (Int, Int) -> Array[Int] = (v0, v1) -> {
  let values = empty_int_array()
  Array::push(values, v0)
  Array::push(values, v1)
  values
}

let quad_int_array: (Int, Int, Int, Int) -> Array[Int] = (v0, v1, v2, v3) -> {
  let values = empty_int_array()
  Array::push(values, v0)
  Array::push(values, v1)
  Array::push(values, v2)
  Array::push(values, v3)
  values
}

let triple_int_array: (Int, Int, Int) -> Array[Int] = (v0, v1, v2) -> {
  let values = empty_int_array()
  Array::push(values, v0)
  Array::push(values, v1)
  Array::push(values, v2)
  values
}

let empty_bytes_array: () -> Array[Bytes] = () -> {
  Array::slice([
    bytebuf_new()
  ], 0, 0)
}

let pair_bytes_array: (Bytes, Bytes) -> Array[Bytes] = (v0, v1) -> {
  let values = empty_bytes_array()
  Array::push(values, v0)
  Array::push(values, v1)
  values
}

let builders_empty_string_array: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let pair_string_array: (String, String) -> Array[String] = (v0, v1) -> {
  let values = builders_empty_string_array()
  Array::push(values, v0)
  Array::push(values, v1)
  values
}

export let build_call_module: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))
  emit_function_section(out, pair_int_array(0, 1))
  emit_export_section_multi(out, pair_string_array("square", "sum_sq"), pair_int_array(0, 1))
  let sq_body = bytebuf_new()
  emit_local_get(sq_body, 0)
  emit_local_get(sq_body, 0)
  emit_i64_mul(sq_body)
  let ss_body = bytebuf_new()
  emit_local_get(ss_body, 0)
  emit_call(ss_body, 0)
  emit_local_get(ss_body, 1)
  emit_call(ss_body, 0)
  emit_i64_add(ss_body)
  emit_code_section(out, pair_bytes_array(sq_body, ss_body))
  bytebuf_to_bytes(out)
}

let triple_bytes_array: (Bytes, Bytes, Bytes) -> Array[Bytes] = (v0, v1, v2) -> {
  let values = empty_bytes_array()
  Array::push(values, v0)
  Array::push(values, v1)
  Array::push(values, v2)
  values
}

let singleton_int_array: (Int) -> Array[Int] = (v0) -> {
  let values = empty_int_array()
  Array::push(values, v0)
  values
}

let triple_string_array: (String, String, String) -> Array[String] = (v0, v1, v2) -> {
  let values = builders_empty_string_array()
  Array::push(values, v0)
  Array::push(values, v1)
  Array::push(values, v2)
  values
}

let singleton_bytes_array: (Bytes) -> Array[Bytes] = (v0) -> {
  let values = empty_bytes_array()
  Array::push(values, v0)
  values
}

export let build_add_module: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, singleton_int_array(0))
  emit_export_section(out, "add", 0)
  let body = bytebuf_new()
  emit_local_get(body, 0)
  emit_local_get(body, 1)
  emit_i64_add(body)
  emit_code_section(out, singleton_bytes_array(body))
  bytebuf_to_bytes(out)
}

export let build_factorial_module: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 1, 1)
  emit_function_section(out, singleton_int_array(0))
  emit_export_section(out, "fact", 0)
  let b = bytebuf_new()
  emit_i64_const(b, 1)
  emit_local_set(b, 1)
  emit_block_void(b)
  emit_loop_void(b)
  emit_local_get(b, 0)
  emit_i64_const(b, 1)
  emit_i64_le_s(b)
  emit_br_if(b, 1)
  emit_local_get(b, 1)
  emit_local_get(b, 0)
  emit_i64_mul(b)
  emit_local_set(b, 1)
  emit_local_get(b, 0)
  emit_i64_const(b, 1)
  emit_i64_sub(b)
  emit_local_set(b, 0)
  emit_br(b, 0)
  emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))
  bytebuf_to_bytes(out)
}

export let build_fibonacci_module: () -> Bytes = () -> {
