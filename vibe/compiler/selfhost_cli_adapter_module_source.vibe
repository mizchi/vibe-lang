let lookup_string2_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_string_index_of(name) {
    Some(t) => Some(t),
    None => match lookup_string_contains(name) {
      Some(t) => Some(t),
      None => match lookup_string_starts_with(name) {
        Some(t) => Some(t),
        None => lookup_string_ends_with(name)
      }
    }
  }
}

