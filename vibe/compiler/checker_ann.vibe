//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./types.vibe {
  Type, TypeDef, resolve_builtin
}

//# Functions

export let resolve_simple_type = (te: TypeExpr, _defs: Array[TypeDef]) -> Type {
  match te {
    TyUnit => CtUnit,
    TyName(name) => match resolve_builtin(name) {
      Some(t) => t,
      None => CtNamed(name, array_slice([
        CtUnknown
      ], 0, 0))
    }
    ,
    _ => CtUnknown
  }
}
