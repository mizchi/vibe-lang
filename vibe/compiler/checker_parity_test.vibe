  assert(check_source_ok("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 3, y: 4 }\np.x + p.y"))
}

test "parity: labeled function" {
  assert(check_source_ok("let add = (x~: Int, y~: Int) -> Int { x + y }\nadd(x=1, y=2)"))
}

test "parity err: return type mismatch" {
  assert(check_source_err("let f = () -> Int { \"hello\" }"))
}

test "parity err: function arity" {
  assert(check_source_err("let f = (x: Int) -> Int { x }\nf(1, 2)"))
}

test "parity err: while condition not bool" {
