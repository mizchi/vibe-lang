  assert(check_source_ok("let b = Bytes::new()\nBytes::push(b, 65)\nArray::length(Bytes::to_array(b))"))
}

test "parity builtin: Bytes::from_array+to_array" {
  assert(check_source_ok("let b = Bytes::from_array([1, 2, 3])\nlet a = Bytes::to_array(b)\nArray::length(a)"))
}

test "parity builtin: Bytes::concat" {
  assert(check_source_ok("let a = Bytes::from_array([1])\nlet b = Bytes::from_array([2])\nlet c = Bytes::concat(a, b)\nArray::length(Bytes::to_array(c))"))
}

