test "parity builtin: ArrayBuilder::new+push+freeze" {
  assert(check_source_ok("let b = ArrayBuilder::new()\nArrayBuilder::push(b, 42)\nlet arr = ArrayBuilder::freeze(b)\nArray::get(arr, 0)"))
}

test "parity builtin: MapBuilder::new+set+freeze" {
  assert(check_source_ok("let b = MapBuilder::new()\nMapBuilder::set(b, \"key\", 99)\nlet m = MapBuilder::freeze(b)\nMap::get(m, \"key\")"))
}

test "parity builtin: Map::get" {
  assert(check_source_ok("let m = map { \"x\": 42 }\nMap::get(m, \"x\")"))
}

test "parity builtin: Map::keys" {
  assert(check_source_ok("let m = map { \"a\": 1, \"b\": 2 }\nlet keys = Map::keys(m)\nArray::length(keys)"))
}

