  assert(check_source_ok("let mut x = 0\nx = x + 1\nx"))
}

test "parity: nested if-else" {
  assert(check_source_ok("let n = 5\nif n < 0 { -1 } else if n == 0 { 0 } else { 1 }"))
}

test "parity: match with wildcard" {
  assert(check_source_ok("match 42 { 0 => 100, _ => 200 }"))
}

test "parity: match bool" {
  assert(check_source_ok("match true { true => 1, false => 0 }"))
}

test "parity: string concat" {
  assert(check_source_ok("let a = \"hello\"\nlet b = \" world\"\na + b"))
}

test "parity: arithmetic chain" {
  assert(check_source_ok("let x = 1 + 2 * 3 - 4 / 2\nx"))
}

test "parity: comparison chain" {
  assert(check_source_ok("let a = 1 < 2\nlet b = 3 >= 2\nlet c = 4 != 5\nif a && b && c { 1 } else { 0 }"))
}

test "parity: char literal" {
  assert(check_source_ok("let c = 'A'\nChar::to_int(c)"))
}

test "parity: while with break" {
  assert(check_source_ok("let mut i = 0\nwhile true { if i >= 10 { break }\ni = i + 1 }\ni"))
}

test "parity: array push and length" {
  assert(check_source_ok("let arr = [1, 2, 3]\nArray::push(arr, 4)\nArray::length(arr)"))
}

test "parity: array get" {
  assert(check_source_ok("let arr = [10, 20, 30]\nArray::get(arr, 1)"))
}

test "parity: map literal" {
  assert(check_source_ok("let m = map { \"x\": 1, \"y\": 2 }\nMap::get(m, \"x\")"))
}

test "parity: closure capture" {
  assert(check_source_ok("let n = 10\nlet add_n = (x: Int) -> Int { x + n }\nadd_n(5)"))
}

test "parity: recursive enum" {
  assert(check_source_ok("enum List { Nil; Cons(Int, List) }\nlet rec len = (l: List) -> Int { match l { Nil => 0, Cons(_, rest) => 1 + len(rest) } }\nlen(Cons(1, Cons(2, Nil)))"))
}

test "parity: multiple let bindings" {
  assert(check_source_ok("let a = 1\nlet b = 2\nlet c = 3\na + b + c"))
}

test "parity: nested match" {
  assert(check_source_ok("enum Op { Add; Sub }\nlet calc = (op: Op, a: Int, b: Int) -> Int { match op { Add => a + b, Sub => a - b } }\ncalc(Add, 10, 3)"))
}

test "parity: bitwise ops" {
  assert(check_source_ok("let a = 0xFF & 0x0F\nlet b = a | 0x10\nb"))
}

test "parity: handle propagation" {
  assert(check_source_ok("let inner = () -> Int with { Error } { throw(\"err\")\n0 }\nlet outer = () -> Int with { Error } { inner() + 1 }\nlet r = handle { outer() } { Error(_) => -1 }\nr"))
}

test "parity: suberror definition" {
  assert(check_source_ok("suberror AppError { NotFound; InvalidInput(String) }\nlet f = () -> Int with { Error } { throw(NotFound)\n0 }\nhandle { f() } { Error(_) => 42 }"))
}

