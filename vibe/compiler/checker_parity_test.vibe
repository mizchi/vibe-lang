  assert(check_source_ok("match true { true => 1, false => 0 }"))
}

test "parity: match char pattern" {
  assert(check_source_ok("let c = 'a'\nmatch c { 97 => 1, _ => 0 }"))
}

test "parity: match nested enum" {
  assert(check_source_ok("enum Tree { Leaf(Int); Node(Tree, Tree) }\nlet rec depth = (t: Tree) -> Int { match t { Leaf(_) => 1, Node(l, r) => { let dl = depth(l)\nlet dr = depth(r)\nif dl > dr { dl + 1 } else { dr + 1 } } } }\ndepth(Node(Leaf(1), Node(Leaf(2), Leaf(3))))"))
}

test "parity: match wildcard only" {
  assert(check_source_ok("match 42 { _ => 0 }"))
}

test "parity: struct field access" {
  assert(check_source_ok("struct Rect { w: Int; h: Int }\nlet r = Rect::{ w: 10, h: 20 }\nr.w * r.h"))
}

test "parity: struct with multiple fields" {
  assert(check_source_ok("struct Rect { w: Int; h: Int }\nlet r = Rect::{ w: 3, h: 4 }\nr.w + r.h"))
}

test "parity: bitwise and" {
  assert(check_source_ok("let x = 0xFF & 0x0F\nx"))
}

test "parity: bitwise or" {
  assert(check_source_ok("let x = 0xF0 | 0x0F\nx"))
}

test "parity: bitwise xor" {
  assert(check_source_ok("let x = 0xFF ^ 0x0F\nx"))
}

test "parity: bitwise shift" {
  assert(check_source_ok("let x = 1 << 8\nlet y = x >> 4\ny"))
}

test "parity err: bitwise type mismatch" {
  assert(check_source_err("1 & \"hello\""))
}

test "parity err: shift type mismatch" {
  assert(check_source_err("\"hello\" << 1"))
}

test "parity err: xor type mismatch" {
  assert(check_source_err("true ^ 1"))
}

test "parity: let destructure tuple" {
  assert(check_source_ok("let (a, b, c) = (1, 2, 3)\na + b + c"))
}

test "parity: double arithmetic" {
  assert(check_source_ok("let x = 1.5 + 2.5\nlet y = x * 2.0\ny"))
}

test "parity: double comparison" {
  assert(check_source_ok("if 3.14 > 2.71 { 1 } else { 0 }"))
}

test "parity err: double plus string" {
  assert(check_source_err("1.5 + \"hello\""))
}

test "parity: closure capture" {
  assert(check_source_ok("let x = 10\nlet f = (y: Int) -> Int { x + y }\nf(5)"))
}

test "parity: closure mut capture" {
  assert(check_source_ok("let mut count = 0\nlet inc = () -> Unit { count = count + 1 }\ninc()\ncount"))
}

test "parity: generic pair" {
  assert(check_source_ok("let pair = [A, B](a: A, b: B) -> (A, B) { (a, b) }\nlet (x, y) = pair(1, \"hello\")\nx"))
}

test "parity: nested handle" {
  assert(check_source_ok("let inner = () -> Int with { Error } { throw(\"inner\")\n0 }\nlet outer = () -> Int with { Error } { handle { inner() } { Error(_) => throw(\"outer\")\n-1 } }\nhandle { outer() } { Error(_) => 99 }"))
}

test "parity: effect function composition" {
  assert(check_source_ok("let f = (x: Int) -> Int with { Error } { if x < 0 { throw(\"neg\") }\nx * 2 }\nlet g = (x: Int) -> Int with { Error } { f(x) + 1 }\nhandle { g(5) } { Error(_) => -1 }"))
}

test "parity: string concat" {
  assert(check_source_ok("let a = \"hello\"\nlet b = \" world\"\nString::concat(a, b)"))
}

test "parity: string length" {
  assert(check_source_ok("String::length(\"hello world\")"))
}

test "parity: string char_code_at" {
  assert(check_source_ok("String::char_code_at(\"abc\", 0)"))
}

// --- recently added features ---

test "parity: struct destructuring let" {
  assert(check_source_ok("struct Vec2 { x: Int; y: Int }\nlet p = Vec2::{ x: 3, y: 4 }\nlet Vec2::{ x, y } = p\nx + y"))
}

test "parity: derive(Eq) struct" {
  assert(check_source_ok("struct Vec2 { x: Int; y: Int } derive(Eq)\nlet a = Vec2::{ x: 1, y: 2 }\nlet b = Vec2::{ x: 1, y: 2 }\na == b"))
}

test "parity: derive(Eq) enum" {
  assert(check_source_ok("enum Color { Red; Green; Blue } derive(Eq)\nlet a = Red\nlet b = Red\na == b"))
}

test "parity: derive(Eq) enum payload" {
  assert(check_source_ok("enum Shape { Circle(Int); Rect(Int, Int) } derive(Eq)\nCircle(5) == Circle(5)"))
}

test "parity: loop break value" {
  assert(check_source_ok("loop (i = 0, acc = 0) { if i >= 10 { break(acc) }\ncontinue(i + 1, acc + i) }"))
}

test "parity: while break value" {
  assert(check_source_ok("let mut i = 0\nwhile true { if i >= 5 { break }\ni = i + 1 }\ni"))
}

test "parity: map int keys" {
  assert(check_source_ok("let b = MapBuilder::new()\nMapBuilder::set(b, 1, 100)\nlet m = MapBuilder::freeze(b)\nMap::get(m, 1)"))
}

test "parity: map has_key" {
  assert(check_source_ok("let b = MapBuilder::new()\nMapBuilder::set(b, \"key\", 42)\nlet m = MapBuilder::freeze(b)\nMap::has_key(m, \"key\")"))
}

test "parity: map keys" {
  assert(check_source_ok("let b = MapBuilder::new()\nMapBuilder::set(b, \"a\", 1)\nMapBuilder::set(b, \"b\", 2)\nlet m = MapBuilder::freeze(b)\nArray::length(Map::keys(m))"))
}

test "parity: is expression" {
  assert(check_source_ok("let x = Some(42)\nif x is Some(v) { v } else { 0 }"))
}

test "parity: let else" {
  assert(check_source_ok("let x = Some(42)\nlet Some(v) = x else { 0 }\nv"))
}

test "parity: or pattern" {
  assert(check_source_ok("let f = (n: Int) -> Int { match n { 0 | 1 => 0, _ => 1 } }\nf(0) + f(5)"))
}

test "parity: trait impl" {
  assert(check_source_ok("trait Greet { greet(Self) -> Int }\nstruct Dog { age: Int }\nimpl Greet for Dog { let greet = (self: Dog) -> Int { self.age } }\nDog::greet(Dog::{ age: 5 })"))
}

test "parity: for-in map result" {
  assert(check_source_ok("for x in [1, 2, 3] { x * 10 }"))
}

test "parity err: struct field type mismatch" {
  assert(check_source_err("struct Vec2 { x: Int; y: Int }\nVec2::{ x: \"bad\", y: 2 }"))
}

test "parity err: derive unknown" {
  assert(check_source_err("struct Foo { x: Int } derive(Unknown)"))
}
