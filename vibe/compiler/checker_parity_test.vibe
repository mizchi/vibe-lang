test "parity err: while condition not bool" {
  assert(check_source_err("while 42 { 0 }"))
}

test "parity err: logic op non-bool" {
  assert(check_source_err("1 && 2"))
}

test "parity err: subtract string" {
  assert(check_source_err("\"a\" - \"b\""))
}

//# Misc — Extended parity: control flow

test "parity: loop with params" {
  assert(check_source_ok("loop (i = 0, acc = 0) { if i >= 5 { break(acc) } else { continue(i + 1, acc + i) } }"))
}

test "parity: for-in with index" {
  assert(check_source_ok("let arr = [10, 20, 30]\nlet mut total = 0\nfor x, i in arr { total = total + x + i }\ntotal"))
}

test "parity: nested while" {
  assert(check_source_ok("let mut sum = 0\nlet mut i = 0\nwhile i < 3 { let mut j = 0\nwhile j < 3 { sum = sum + 1\nj = j + 1 }\ni = i + 1 }\nsum"))
}

//# Misc — Extended parity: data structures

test "parity: enum with payload" {
  assert(check_source_ok("enum Shape { Circle(Int); Rect(Int, Int); Point }\nlet area = (s: Shape) -> Int { match s { Circle(r) => r * r, Rect(w, h) => w * h, Point => 0 } }\narea(Circle(5))"))
}

test "parity: nested enum match" {
  assert(check_source_ok("enum Tree { Leaf(Int); Node(Tree, Tree) }\nlet rec sum = (t: Tree) -> Int { match t { Leaf(n) => n, Node(l, r) => sum(l) + sum(r) } }\nsum(Node(Leaf(1), Leaf(2)))"))
}

test "parity: record literal" {
  assert(check_source_ok("let p = record { x: 3, y: 4 }\np.x + p.y"))
}

test "parity: array builder" {
  assert(check_source_ok("let b = ArrayBuilder::new()\nArrayBuilder::push(b, 1)\nArrayBuilder::push(b, 2)\nlet arr = ArrayBuilder::freeze(b)\nArray::length(arr)"))
}

test "parity: map builder" {
  assert(check_source_ok("let b = MapBuilder::new()\nMapBuilder::set(b, \"k\", 1)\nlet m = MapBuilder::freeze(b)\nMap::get(m, \"k\")"))
}

//# Misc — Extended parity: functions

test "parity: let rec" {
  assert(check_source_ok("let rec fact = (n: Int) -> Int { if n <= 1 { 1 } else { n * fact(n - 1) } }\nfact(5)"))
}

test "parity: function returning function" {
  assert(check_source_ok("let make_adder = (n: Int) -> (Int) -> Int { (x: Int) -> Int { x + n } }\nlet add5 = make_adder(5)\nadd5(10)"))
}

test "parity: generic pair" {
  assert(check_source_ok("let fst = [A, B](p: (A, B)) -> A { let (a, _) = p\na }\nfst((42, \"hi\"))"))
}

test "parity: pipe operator" {
  assert(check_source_ok("let double = (x: Int) -> Int { x * 2 }\n5 |> double"))
}

test "parity: string interpolation" {
  assert(check_source_ok("let name = \"world\"\nlet s = \"hello \\{name}\"\nString::length(s)"))
}

test "parity: spread array" {
  assert(check_source_ok("let a = [1, 2]\nlet b = [...a, 3]\nArray::length(b)"))
}

//# Misc — Extended parity: builtins

test "parity: String::length" {
  assert(check_source_ok("String::length(\"hello\")"))
}

test "parity: String::contains" {
  assert(check_source_ok("String::contains(\"hello world\", \"world\")"))
}

test "parity: Array::length" {
  assert(check_source_ok("Array::length([1, 2, 3])"))
}

