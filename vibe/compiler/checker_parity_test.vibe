  assert(check_source_ok("let x = 42\nlet s = \"value is \\{__to_string(x)}\"\nString::length(s)"))
}

test "parity: loop with break" {
  assert(check_source_ok("let result = loop (i = 0) { if i >= 5 { break(i) } else { continue(i + 1) } }\nresult"))
}

test "parity: loop multi param" {
  assert(check_source_ok("let result = loop (i = 0, sum = 0) { if i >= 3 { break(sum) } else { continue(i + 1, sum + i) } }\nresult"))
}

test "parity: while break" {
  assert(check_source_ok("let mut i = 0\nwhile true { if i >= 10 { break }\ni = i + 1 }\ni"))
}

test "parity: for-in with map" {
  assert(check_source_ok("let squares = for x in [1, 2, 3] { x * x }\nArray::length(squares)"))
}

test "parity: for-in with index" {
  assert(check_source_ok("let arr = [10, 20, 30]\nlet mut sum = 0\nfor x in arr { sum = sum + x }\nsum"))
