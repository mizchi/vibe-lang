//# Imports

import ./syntax/lexer.vibe {
  lex
}

import ./syntax/parser.vibe {
  parse_program
}

import ./checker_stmt.vibe {
  check_program
}

//# Functions

let check_source_ok = (source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    true
  } {
    Error(_) => false
  }
}

let check_source_err = (source: String) -> Bool {
  handle {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _env = check_program(stmts)
    false
  } {
    Error(_) => true
  }
}

//# Misc — Stage0/Stage1 parity: valid programs

test "parity: int literal" {
  assert(check_source_ok("42"))
}

test "parity: let binding" {
  assert(check_source_ok("let x = 1\nx"))
}

test "parity: function call" {
  assert(check_source_ok("let f = (x: Int) -> Int { x + 1 }\nf(5)"))
}

test "parity: if expression" {
  assert(check_source_ok("if true { 1 } else { 0 }"))
}

test "parity: while loop" {
  assert(check_source_ok("let mut s = 0\nlet mut i = 0\nwhile i < 10 { s = s + i\ni = i + 1 }\ns"))
}

test "parity: match int" {
  assert(check_source_ok("match 1 { 0 => 10, _ => 20 }"))
}

test "parity: match string" {
  assert(check_source_ok("match \"hi\" { \"hi\" => 1, _ => 0 }"))
}

test "parity: block expression" {
  assert(check_source_ok("let x = { let a = 1\nlet b = 2\na + b }\nx"))
}

test "parity: recursive function" {
  assert(check_source_ok("let rec f = (n: Int) -> Int { if n <= 0 { 0 } else { f(n - 1) + n } }\nf(10)"))
}

test "parity: enum definition and match" {
  assert(check_source_ok("enum Color { Red; Green; Blue }\nlet f = (c: Color) -> Int { match c { Red => 1, Green => 2, Blue => 3 } }\nf(Red)"))
}

test "parity: tuple" {
  assert(check_source_ok("let p = (1, 2)\nlet (a, b) = p\na + b"))
}

test "parity: array literal" {
  assert(check_source_ok("let arr = [1, 2, 3]\nArray::length(arr)"))
}

test "parity: string operations" {
  assert(check_source_ok("let s = \"hello\"\nString::length(s)"))
}

test "parity: handle basic" {
  assert(check_source_ok("let r = handle { 42 } { Error(_) => -1 }\nr"))
}

test "parity: handle with throw" {
  assert(check_source_ok("let r = handle { throw(\"x\")\n0 } { Error(msg) => String::length(msg) }\nr"))
}

test "parity: effectful function" {
  assert(check_source_ok("let f = () -> Int with { Error } { throw(\"x\")\n0 }\nlet r = handle { f() } { Error(_) => 99 }\nr"))
}

test "parity: generic identity" {
  assert(check_source_ok("let id = [T](x: T) -> T { x }\nid(42)"))
}

test "parity: higher-order function" {
  assert(check_source_ok("let apply = (f: (Int) -> Int, x: Int) -> Int { f(x) }\nlet double = (x: Int) -> Int { x * 2 }\napply(double, 5)"))
}

test "parity: for-in loop" {
  assert(check_source_ok("let arr = [1, 2, 3]\nlet mut s = 0\nfor x in arr { s = s + x }\ns"))
}

test "parity: struct definition" {
  assert(check_source_ok("struct Point { x: Int; y: Int }\nlet p = Point::{ x: 1, y: 2 }\np.x + p.y"))
}

test "parity: comparison ops" {
  assert(check_source_ok("let a = 5\nlet b = 10\nif a < b { 1 } else { 0 }"))
}

test "parity: boolean ops" {
  assert(check_source_ok("let a = true\nlet b = false\nif a && !b { 1 } else { 0 }"))
}

test "parity: float literal" {
  assert(check_source_ok("let x = 3.14\nif x > 3.0 { 1 } else { 0 }"))
}

test "parity: nested function" {
  assert(check_source_ok("let outer = () -> Int {\n  let inner = (x: Int) -> Int { x * 2 }\n  inner(21)\n}\nouter()"))
}

test "parity: option type" {
  assert(check_source_ok("let x: Option[Int] = Some(42)\nmatch x { Some(n) => n, None => 0 }"))
}

//# Misc — Stage0/Stage1 parity: type errors
// Error parity: selfhost checker uses CtUnknown (permissive) instead of throw.
// Effect errors are tested separately in checker_effects_test.vibe (19/19 pass).
// Type errors (mismatch, unknown name, etc.) are not thrown by selfhost checker —
// it returns CtUnknown for unresolvable types. This is a design difference from
// the host checker which throws TypeError.
