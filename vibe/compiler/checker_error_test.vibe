//# Imports

import ./checker_error.vibe {
  CheckError, add_error, check_error_to_string, format_errors, has_errors, new_errors
}

//# Misc

test "CEUnboundVar format" {
  let msg = check_error_to_string(CEUnboundVar("x"))
  assert(String::equals(msg, "unbound variable: x"))
}

test "CETypeMismatch format" {
  let msg = check_error_to_string(CETypeMismatch("Int", "String"))
  assert(String::equals(msg, "type mismatch: expected Int, got String"))
}

test "CEArityMismatch format" {
  let msg = check_error_to_string(CEArityMismatch("f", 2, 3))
  assert(String::equals(msg, "arity mismatch: f expects 2 args, got 3"))
}

test "CENotCallable format" {
  let msg = check_error_to_string(CENotCallable("42"))
  assert(String::equals(msg, "not callable: 42"))
}

test "CEUnknownField format" {
  let msg = check_error_to_string(CEUnknownField("Point", "z"))
  assert(String::equals(msg, "unknown field z on Point"))
}

test "CEUnknownCtor format" {
  let msg = check_error_to_string(CEUnknownCtor("Foo"))
  assert(String::equals(msg, "unknown constructor: Foo"))
}

test "CEDuplicateDecl format" {
  let msg = check_error_to_string(CEDuplicateDecl("x"))
  assert(String::equals(msg, "duplicate declaration: x"))
}

test "new_errors creates empty list" {
  let errors = new_errors()
  assert(eq(Array::length(errors), 0))
}

test "has_errors false for empty" {
  let errors = new_errors()
  assert(!has_errors(errors))
}

test "add_error and has_errors" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("x"))
  assert(has_errors(errors))
  assert(eq(Array::length(errors), 1))
}

test "add_error multiple" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("x"))
  add_error(errors, CETypeMismatch("Int", "Bool"))
  assert(eq(Array::length(errors), 2))
}

test "format_errors empty" {
  let errors = new_errors()
  let msg = format_errors(errors)
  assert(String::equals(msg, ""))
}

test "format_errors single" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("y"))
  let msg = format_errors(errors)
  assert(String::equals(msg, "unbound variable: y"))
}

test "format_errors multiple joined with newlines" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("x"))
  add_error(errors, CENotCallable("42"))
  add_error(errors, CEDuplicateDecl("foo"))
  let msg = format_errors(errors)
  assert(String::equals(msg, "unbound variable: x\nnot callable: 42\nduplicate declaration: foo"))
}

test "format_errors preserves order" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("alpha"))
  add_error(errors, CETypeMismatch("Bool", "Int"))
  add_error(errors, CEDuplicateDecl("gamma"))
  let msg = format_errors(errors)
  assert(String::equals(msg, "unbound variable: alpha\ntype mismatch: expected Bool, got Int\nduplicate declaration: gamma"))
}

test "check_error_to_string CEUnknownField includes both type and field" {
  let msg = check_error_to_string(CEUnknownField("MyRecord", "missing_field"))
  assert(String::contains(msg, "MyRecord"))
  assert(String::contains(msg, "missing_field"))
}

test "check_error_to_string CEArityMismatch with zero" {
  let msg = check_error_to_string(CEArityMismatch("g", 0, 2))
  assert(String::contains(msg, "g"))
  assert(String::contains(msg, "0"))
  assert(String::contains(msg, "2"))
}

test "add_error preserves all variants" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("a"))
  add_error(errors, CETypeMismatch("Int", "Bool"))
  add_error(errors, CEArityMismatch("f", 1, 2))
  add_error(errors, CENotCallable("99"))
  add_error(errors, CEUnknownField("Rec", "z"))
  add_error(errors, CEUnknownCtor("Bar"))
  add_error(errors, CEDuplicateDecl("dup"))
  assert(eq(Array::length(errors), 7))
}

test "has_errors after adding then checking" {
  let errors = new_errors()
  add_error(errors, CETypeMismatch("String", "Int"))
  assert(has_errors(errors))
  let msg = format_errors(errors)
  assert(!String::equals(msg, ""))
}

test "format_errors with all error types" {
  let errors = new_errors()
  add_error(errors, CEUnboundVar("v"))
  add_error(errors, CETypeMismatch("A", "B"))
  add_error(errors, CEArityMismatch("h", 3, 1))
  add_error(errors, CENotCallable("lit"))
  add_error(errors, CEUnknownField("T", "f"))
  add_error(errors, CEUnknownCtor("C"))
  add_error(errors, CEDuplicateDecl("d"))
  let msg = format_errors(errors)
  assert(String::contains(msg, "unbound variable: v"))
  assert(String::contains(msg, "type mismatch: expected A, got B"))
  assert(String::contains(msg, "arity mismatch: h expects 3 args, got 1"))
  assert(String::contains(msg, "not callable: lit"))
  assert(String::contains(msg, "unknown field f on T"))
  assert(String::contains(msg, "unknown constructor: C"))
  assert(String::contains(msg, "duplicate declaration: d"))
}
