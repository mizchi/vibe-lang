//# Imports

import ./checker_stmt.vibe {
  check_program
}

import ./syntax / lexer.vibe {
  lex
}

import ./syntax / parser.vibe {
  parse_program
}

//# Functions

let check_ok = (source: String) -> Bool {
  handle {
    let _ = check_program(parse_program(lex(source)))
    true
  } with Error {
    Throw(_) => false
  }
}

let check_err = (source: String) -> Bool {
  not(check_ok(source))
}

let assert_all_ok = (sources: Array[String]) -> Unit with { Error } {
  let mut i = 0
  while i < Array::length(sources) {
    let source = Array::get(sources, i)
    if not(check_ok(source)) {
      throw(String::concat("expected ok: ", source))
    }
    i = i + 1
  }
}

let assert_all_err = (sources: Array[String]) -> Unit with { Error } {
  let mut i = 0
  while i < Array::length(sources) {
    let source = Array::get(sources, i)
    if not(check_err(source)) {
      throw(String::concat("expected error: ", source))
    }
    i = i + 1
  }
}

//# Misc

test "Builtin happy-path typechecks" {
  assert_all_ok([
    "String::length(\"hi\")",
    "String::concat(\"a\", \"b\")",
    "String::equals(\"a\", \"b\")",
    "String::contains(\"abc\", \"b\")",
    "String::starts_with(\"abc\", \"a\")",
    "String::ends_with(\"abc\", \"c\")",
    "String::index_of(\"abc\", \"b\")",
    "String::last_index_of(\"abab\", \"ab\")",
    "String::char_code_at(\"a\", 0)",
    "String::from_char_code(65)",
    "String::substring(\"hello\", 1, 3)",
    "String::split(\"a,b\", \",\")",
    "String::trim(\" hi \")",
  ])
  assert_all_ok([
    "Array::length([1, 2])",
    "Array::get([1, 2], 0)",
    "Array::set([1, 2], 0, 9)",
    "let a = [1]\nArray::push(a, 2)",
    "Array::slice([1, 2, 3], 0, 2)",
    "Array::concat([1], [2])",
    "let a = [1]\nArray::push_all(a, [2, 3])",
  ])
  assert_all_ok([
    "ArrayBuilder::new()",
    "let b = ArrayBuilder::new()\nArrayBuilder::push(b, 1)",
    "let b = ArrayBuilder::new()\nArrayBuilder::freeze(b)",
  ])
  assert_all_ok([
    "Map::get(map { \"a\": 1 }, \"a\")",
    "Map::keys(map { \"a\": 1 })",
    "Map::has_key(map { \"a\": 1 }, \"a\")",
    "let m = map { \"a\": 1 }\nMap::set(m, \"b\", 2)",
  ])
  assert_all_ok([
    "MapBuilder::new()",
    "let b = MapBuilder::new()\nMapBuilder::set(b, \"k\", 1)",
    "let b = MapBuilder::new()\nMapBuilder::freeze(b)",
  ])
  assert_all_ok([
    "Bytes::new()",
    "let b = Bytes::new()\nBytes::push(b, 65)",
    "Bytes::from_array([1, 2])",
    "Bytes::to_array(Bytes::from_array([1]))",
    "Bytes::concat(Bytes::from_array([1]), Bytes::from_array([2]))",
    "Bytes::slice(Bytes::from_array([1, 2, 3]), 0, 2)",
  ])
  assert_all_ok([
    "StringBuilder::new()",
    "let b = StringBuilder::new()\nStringBuilder::push(b, \"hi\")",
    "let b = StringBuilder::new()\nStringBuilder::freeze(b)",
  ])
  assert_all_ok([
    "Int::to_double(42)",
    "Double::to_int(3.14)",
    "Char::to_int('A')",
    "Char::from_int(65)",
    "__to_string(42)",
  ])
  assert_all_ok([
    "not(true)",
    "eq(1, 1)",
    "assert(true)",
    "let f = () -> Int with { Error } { throw(\"x\")\n0 }\nhandle { f() } with Error { Throw(_) => 1 }",
  ])
  assert_all_ok([
    "Some(42)",
    "let x: Option[Int] = None\nx",
  ])
  assert_all_ok([
    "let sub_u32 = (a: u32, b: u32) -> u32 { a - b }",
    "let mul_u8 = (a: u8, b: u8) -> u8 { a * b }",
    "let lt_i16 = (a: i16, b: i16) -> Bool { a < b }",
  ])
}

test "Builtin error-paths stay rejected" {
  assert_all_err([
    "let f = (a: i64, b: u32) -> i64 { a + b }",
  ])
}
