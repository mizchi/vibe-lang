}
export let get_efn_body = (expr: Expr) -> Expr with { Error } {
  match expr { EFn(_, _, _, _, _, body) => body, _ => throw("not EFn") }
}
// Expr type checks (only those needed inside match arms)
export let is_eident = (expr: Expr) -> Bool { match expr { EIdent(_) => true, _ => false } }
export let is_efn = (expr: Expr) -> Bool { match expr { EFn(_, _, _, _, _, _) => true, _ => false } }

// Expr tag: returns a numeric tag for dispatch without match in let rec
// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,
// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,
// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,
// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, -1=unknown
export let expr_tag = (expr: Expr) -> Int {
  match expr {
    EInt(_) => 0, EBool(_) => 1, EFloat(_) => 2, EString(_) => 3,
    EIdent(_) => 4, EBinOp(_, _, _) => 5, EUnaryOp(_, _) => 6,
    EIf(_, _, _) => 7, ECall(_, _) => 8, ELet(_, _, _) => 9,
    ELetRec(_, _, _) => 10, ELetMut(_, _, _) => 11, EAssign(_, _, _) => 12,
    EAssignOp(_, _, _, _) => 13, ESeq(_, _) => 14, ETuple(_) => 15,
    EMatch(_, _) => 16, EArray(_) => 17, EForIn(_, _, _) => 18,
    EWhile(_, _) => 19, EBreak(_) => 20, EContinue(_) => 21,
    EUnit => 22, EThrow(_) => 23, EFn(_, _, _, _, _, _) => 24,
    _ => -1
  }
}

// === Stmt extractors ===
export let is_slet = (stmt: Stmt) -> Bool { match stmt { SLet(_, _, _, _, _) => true, _ => false } }
export let get_slet_name = (stmt: Stmt) -> String with { Error } {
  match stmt { SLet(_, _, name, _, _) => name, _ => throw("not SLet") }
}
export let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {
  match stmt { SLet(_, _, _, _, expr) => expr, _ => throw("not SLet") }
}

// === Enum constructor lookup ===

// Returns index into ctor_names array, or -1 if not found
export let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {
  if i >= array_length(ctor_names) { -1 }
  else if string_equals(array_get(ctor_names, i), name) { i }
  else lookup_ctor(ctor_names, name, i + 1)
}
