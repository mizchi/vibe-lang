// Shared utilities for WASM codegen backends (linear memory & wasm-gc)
// AST analysis, string tables, free variable analysis, helper emitters

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./bytebuf.vibe {
  bytebuf_push, leb128_encode_u32
}

import ./wasm_emit.vibe {
  emit_i64_const, emit_i64_shl, emit_i64_or,
  emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s, emit_i64_rem_s,
  emit_i64_and, emit_i64_xor, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_ge_s,
  emit_i64_extend_i32_s, emit_i64_eqz,
  emit_local_get, emit_local_set,
  emit_if_void, emit_else, emit_end,
  emit_i32_wrap_i64, emit_i32_load,
  emit_call_indirect
}

// === Additional i32/i64 ops not in wasm_emit ===

export let emit_i32_sub = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 107)  // 0x6B
}

export let emit_i32_mul = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 108)  // 0x6C
}

export let emit_i32_ne = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 71)  // 0x47
}

export let emit_i32_eq = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 70)  // 0x46
}

export let emit_i32_ge_u = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 79)  // 0x4F
}

export let emit_i32_eqz = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 69)  // 0x45
}

export let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 55)  // 0x37
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {
  bytebuf_push(buf, 41)  // 0x29
  leb128_encode_u32(buf, align)
  leb128_encode_u32(buf, offset)
}

export let emit_i64_extend_i32_u = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 173)  // 0xAD
}

export let emit_memory_copy = (buf: Array[Int]) -> Unit {
  bytebuf_push(buf, 252)  // 0xFC prefix
  leb128_encode_u32(buf, 10)  // memory.copy
  bytebuf_push(buf, 0)  // src memory
  bytebuf_push(buf, 0)  // dst memory
}

// === Shared codegen helpers ===

// Emit WASM instruction for a binary operator
export let emit_binop_op = (buf: Array[Int], op: String) -> Unit with { Error } {
  if string_equals(op, "+") { emit_i64_add(buf) }
  else if string_equals(op, "-") { emit_i64_sub(buf) }
  else if string_equals(op, "*") { emit_i64_mul(buf) }
  else if string_equals(op, "/") { emit_i64_div_s(buf) }
  else if string_equals(op, "%") { emit_i64_rem_s(buf) }
  else if string_equals(op, "&") { emit_i64_and(buf) }
  else if string_equals(op, "|") { emit_i64_or(buf) }
  else if string_equals(op, "^") { emit_i64_xor(buf) }
  else if string_equals(op, "<<") { emit_i64_shl(buf) }
  else if string_equals(op, ">>") { emit_i64_shr_s(buf) }
  else if string_equals(op, "==") { emit_i64_eq(buf); emit_i64_extend_i32_s(buf) }
  else if string_equals(op, "!=") { emit_i64_ne(buf); emit_i64_extend_i32_s(buf) }
  else if string_equals(op, "<") { emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf) }
  else if string_equals(op, ">") { emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf) }
  else if string_equals(op, "<=") { emit_i64_le_s(buf); emit_i64_extend_i32_s(buf) }
  else if string_equals(op, ">=") { emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf) }
  else if string_equals(op, "&&") { emit_i64_and(buf) }
  else if string_equals(op, "||") { emit_i64_or(buf) }
  else { throw(string_concat("unsupported binop: ", op)) }
}

// Emit WASM instruction for an assign operator (+=, -=, etc.)
export let emit_assignop_op = (buf: Array[Int], op: String) -> Unit with { Error } {
  if string_equals(op, "+") { emit_i64_add(buf) }
  else if string_equals(op, "-") { emit_i64_sub(buf) }
  else if string_equals(op, "*") { emit_i64_mul(buf) }
  else if string_equals(op, "/") { emit_i64_div_s(buf) }
  else if string_equals(op, "%") { emit_i64_rem_s(buf) }
  else { throw(string_concat("unsupported assign op: ", op)) }
}

// Resolve closure/fn value tag and fill slot_local/env_local
// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)
export let emit_closure_resolve = (buf: Array[Int], fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {
  emit_local_get(buf, fn_val_local)
  emit_i64_const(buf, 3)
  emit_i64_and(buf)
  emit_i64_const(buf, 2)
  emit_i64_eq(buf)
  emit_if_void(buf)
    // Bare fn: table_slot = fn_val >> 2, env = 0
    emit_local_get(buf, fn_val_local)
    emit_i64_const(buf, 2)
    emit_i64_shr_s(buf)
    emit_local_set(buf, slot_local)
    emit_i64_const(buf, 0)
    emit_local_set(buf, env_local)
  emit_else(buf)
    // Closure: env = fn_val & ~3, slot = i32.load(env, 0)
    emit_local_get(buf, fn_val_local)
    emit_i64_const(buf, -4)
    emit_i64_and(buf)
    emit_local_set(buf, env_local)
    emit_local_get(buf, env_local)
    emit_i32_wrap_i64(buf)
    emit_i32_load(buf, 2, 0)
    emit_i64_extend_i32_u(buf)
    emit_local_set(buf, slot_local)
  emit_end(buf)
}

// Emit the tail of an indirect closure call (push env, push slot, call_indirect)
export let emit_closure_call_tail = (buf: Array[Int], env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {
  emit_local_get(buf, env_local)
  emit_local_get(buf, slot_local)
  emit_i32_wrap_i64(buf)
  emit_call_indirect(buf, closure_type_base + num_args)
}

// === Compilation context ===

export let resolve_local = (names: Array[String], name: String) -> Int with { Error } {
  let len = array_length(names)
  let rec search = (i: Int) -> Int with { Error } {
    if i < 0 {
      throw(string_concat("undefined variable (local): ", name))
    }
    if string_equals(array_get(names, i), name) {
      i
    } else search(i - 1)
  }
  search(len - 1)
}

// Function registry: groups parallel arrays for function metadata
export struct FuncTable {
  names: Array[String];
  indices: Array[Int];
  params: Array[Int];
  returns: Array[Int]
}

// Resolve function: returns (func_index, param_count, has_return)
export let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int) with { Error } {
  let len = array_length(ft.names)
  let rec search = (i: Int) -> (Int, Int, Int) with { Error } {
    if i >= len {
      throw(string_concat("undefined function: ", name))
    }
    if string_equals(array_get(ft.names, i), name) {
      (array_get(ft.indices, i), array_get(ft.params, i), array_get(ft.returns, i))
    } else search(i + 1)
  }
  search(0)
}

// String table: groups string data with their WASM data segment offsets/lengths
export struct StrTable {
  strs: Array[String];
  offsets: Array[Int];
  lengths: Array[Int]
}

// Lambda accumulator: collects compiled lambda bodies and metadata
export struct LambdaTable {
  bodies: Array[Array[Int]];
  param_counts: Array[Int];
  captures: Array[Array[String]];
  meta_i32: Array[Int];
  meta_i64: Array[Int]
}

// Constructor/struct registry: enum variant + struct constructors
export struct CtorTable {
  names: Array[String];
  tags: Array[Int];
  field_counts: Array[Int];
  struct_names: Array[String];
  struct_field_names: Array[Array[String]]
}

// Compilation context: all shared state for compile_expr
export struct CompileCtx {
  func_table: FuncTable;
  str_table: StrTable;
  lambda_table: LambdaTable;
  num_user_funcs: Int;
  func_offset: Int;
  ref_cell_names: Array[String];
  ctor_table: CtorTable
}

// === String table ===

export let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {
  emit_i64_const(buf, offset)
  emit_i64_const(buf, 32)
  emit_i64_shl(buf)
  emit_i64_const(buf, length)
  emit_i64_or(buf)
}

export let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {
  match expr {
    EString(s) => {
      let mut found = false
      let mut i = 0
      while i < array_length(out) {
        if string_equals(array_get(out, i), s) {
          found = true
        }
        i = i + 1
      }
      if !found { array_push(out, s) }
      0
    },
    EBinOp(_, lhs, rhs) => {
      collect_strings_expr(lhs, out)
      collect_strings_expr(rhs, out)
    },
    EUnaryOp(_, operand) => collect_strings_expr(operand, out),
    EIf(cond, then_e, else_e) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(then_e, out)
      collect_strings_expr(else_e, out)
    },
    ECall(callee, args) => {
      collect_strings_expr(callee, out)
      let mut i = 0
      while i < array_length(args) {
        collect_strings_expr(array_get(args, i), out)
        i = i + 1
      }
      0
    },
    ELet(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetRec(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ELetMut(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssign(_, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    EAssignOp(_, _, value, body) => {
      collect_strings_expr(value, out)
      collect_strings_expr(body, out)
    },
    ESeq(first, second) => {
      collect_strings_expr(first, out)
      collect_strings_expr(second, out)
    },
    EWhile(cond, body) => {
      collect_strings_expr(cond, out)
      collect_strings_expr(body, out)
    },
    EForIn(_, iter_e, body) => {
      collect_strings_expr(iter_e, out)
      collect_strings_expr(body, out)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        collect_strings_expr(array_get(elems, i), out)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        collect_strings_expr(array_get(elems, i), out)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      collect_strings_expr(scrutinee, out)
      let mut i = 0
      while i < array_length(arms) {
        let (pat, arm_expr) = array_get(arms, i)
        match pat {
          PString(s) => {
            let mut pf = false
            let mut pi = 0
            while pi < array_length(out) {
              if string_equals(array_get(out, pi), s) { pf = true }
              pi = pi + 1
            }
            if !pf { array_push(out, s) }
            0
          },
          _ => 0
        }
        collect_strings_expr(arm_expr, out)
        i = i + 1
      }
      0
    },
    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),
    EThrow(msg) => collect_strings_expr(msg, out),
    EHandle(body, arms) => {
      collect_strings_expr(body, out)
      let mut hi = 0
      while hi < array_length(arms) {
        let (_, arm_expr) = array_get(arms, hi)
        collect_strings_expr(arm_expr, out)
        hi = hi + 1
      }
      0
    },
    _ => 0
  }
}

export let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {
  let out = array_slice([""], 0, 0)
  let mut i = 0
  while i < array_length(stmts) {
    match array_get(stmts, i) {
      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),
      _ => 0
    }
    i = i + 1
  }
  out
}

// === Free variable analysis ===

export let array_contains_str = (arr: Array[String], s: String) -> Bool {
  let len = array_length(arr)
  let rec search = (i: Int) -> Bool {
    if i >= len { false }
    else if string_equals(array_get(arr, i), s) { true }
    else search(i + 1)
  }
  search(0)
}

// Extract all binding names from a pattern into the given array
let rec collect_pattern_bindings = (pat: Pat, bindings: Array[String]) -> Int {
  match pat {
    PBind(name) => { array_push(bindings, name); 0 },
    PTuple(pats) => {
      let mut i = 0
      while i < array_length(pats) {
        collect_pattern_bindings(array_get(pats, i), bindings)
        i = i + 1
      }
      0
    },
    PCtor(_, args) => {
      let mut i = 0
      while i < array_length(args) {
        collect_pattern_bindings(array_get(args, i), bindings)
        i = i + 1
      }
      0
    },
    POr(l, r) => { collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings) },
    _ => 0
  }
}

export let rec collect_free_vars_expr = (expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {
  let cfv = (e: Expr, b: Array[String]) -> Int {
    collect_free_vars_expr(e, b, fn_names, out)
  }
  match expr {
    EIdent(name) => {
      if !array_contains_str(bound, name) {
        if !array_contains_str(fn_names, name) {
          if !array_contains_str(out, name) {
            array_push(out, name)
          }
        }
      }
      0
    },
    EInt(_) => 0,
    EBool(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EUnit => 0,
    EBinOp(_, lhs, rhs) => { cfv(lhs, bound); cfv(rhs, bound) },
    EUnaryOp(_, operand) => cfv(operand, bound),
    EIf(cond, then_e, else_e) => { cfv(cond, bound); cfv(then_e, bound); cfv(else_e, bound) },
    ECall(callee, args) => {
      cfv(callee, bound)
      let mut i = 0
      while i < array_length(args) {
        cfv(array_get(args, i), bound)
        i = i + 1
      }
      0
    },
    ELet(name, value, body) => {
      cfv(value, bound)
      let b2 = array_slice(bound, 0, array_length(bound))
      array_push(b2, name)
      cfv(body, b2)
    },
    ELetRec(name, value, body) => {
      let b2 = array_slice(bound, 0, array_length(bound))
      array_push(b2, name)
      cfv(value, b2)
      cfv(body, b2)
    },
    ELetMut(name, value, body) => {
      cfv(value, bound)
      let b2 = array_slice(bound, 0, array_length(bound))
      array_push(b2, name)
      cfv(body, b2)
    },
    EAssign(_, value, body) => { cfv(value, bound); cfv(body, bound) },
    EAssignOp(_, _, value, body) => { cfv(value, bound); cfv(body, bound) },
    ESeq(first, second) => { cfv(first, bound); cfv(second, bound) },
    EWhile(cond, body) => { cfv(cond, bound); cfv(body, bound) },
    EForIn(var_name, iter_e, body) => {
      cfv(iter_e, bound)
      let b2 = array_slice(bound, 0, array_length(bound))
      array_push(b2, var_name)
      cfv(body, b2)
    },
    ETuple(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        cfv(array_get(elems, i), bound)
        i = i + 1
      }
      0
    },
    EArray(elems) => {
      let mut i = 0
      while i < array_length(elems) {
        cfv(array_get(elems, i), bound)
        i = i + 1
      }
      0
    },
    EMatch(scrutinee, arms) => {
      cfv(scrutinee, bound)
      let mut i = 0
      while i < array_length(arms) {
        let (arm_pat, arm_expr) = array_get(arms, i)
        let b2 = array_slice(bound, 0, array_length(bound))
        collect_pattern_bindings(arm_pat, b2)
        cfv(arm_expr, b2)
        i = i + 1
      }
      0
    },
    EFn(_, _, params, _, _, body) => {
      let b2 = array_slice(bound, 0, array_length(bound))
      let mut pi = 0
      while pi < array_length(params) {
        let (pname, _) = array_get(params, pi)
        array_push(b2, pname)
        pi = pi + 1
      }
      cfv(body, b2)
    },
    EBreak(_) => 0,
    EContinue(_) => 0,
    EThrow(msg) => cfv(msg, bound),
    EHandle(body, arms) => {
      cfv(body, bound)
      let mut hi = 0
      while hi < array_length(arms) {
        let (_, arm_expr) = array_get(arms, hi)
        cfv(arm_expr, bound)
        hi = hi + 1
      }
      0
    },
    _ => 0
  }
}

export let collect_free_vars = (body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {
  let out = array_slice([""], 0, 0)
  collect_free_vars_expr(body, param_names, fn_names, out)
  out
}

// === Mutable capture analysis ===

// Check if a mutable variable is captured by any nested EFn in the given expression
export let rec is_mut_captured_in = (expr: Expr, name: String) -> Bool {
  match expr {
    EIdent(_) => false,
    EInt(_) => false,
    EBool(_) => false,
    EFloat(_) => false,
    EString(_) => false,
    EUnit => false,
    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),
    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),
    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),
    ECall(callee, args) => {
      if is_mut_captured_in(callee, name) { true }
      else {
        let mut i = 0
        let mut found = false
        while i < array_length(args) {
          if is_mut_captured_in(array_get(args, i), name) { found = true }
          i = i + 1
        }
        found
      }
    },
    ELet(n, value, body) => {
      if string_equals(n, name) { is_mut_captured_in(value, name) }
      else { is_mut_captured_in(value, name) || is_mut_captured_in(body, name) }
    },
    ELetRec(n, value, body) => {
      if string_equals(n, name) { false }
      else { is_mut_captured_in(value, name) || is_mut_captured_in(body, name) }
    },
    ELetMut(n, value, body) => {
      if string_equals(n, name) { is_mut_captured_in(value, name) }
      else { is_mut_captured_in(value, name) || is_mut_captured_in(body, name) }
    },
    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),
    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),
    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),
    EForIn(_, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),
    ETuple(elems) => {
      let mut i = 0
      let mut found = false
      while i < array_length(elems) {
        if is_mut_captured_in(array_get(elems, i), name) { found = true }
        i = i + 1
      }
      found
    },
    EArray(elems) => {
      let mut i = 0
      let mut found = false
      while i < array_length(elems) {
        if is_mut_captured_in(array_get(elems, i), name) { found = true }
        i = i + 1
      }
      found
    },
    EMatch(scrutinee, arms) => {
      if is_mut_captured_in(scrutinee, name) { true }
      else {
        let mut i = 0
        let mut found = false
        while i < array_length(arms) {
          let (_, arm_expr) = array_get(arms, i)
          if is_mut_captured_in(arm_expr, name) { found = true }
          i = i + 1
        }
        found
      }
    },
    EFn(_, _, params, _, _, fn_body) => {
      // Check if name is shadowed by params
      let mut shadowed = false
      let mut pi = 0
      while pi < array_length(params) {
        let (pname, _) = array_get(params, pi)
        if string_equals(pname, name) { shadowed = true }
        pi = pi + 1
      }
      if shadowed { false }
      else {
        // Check if name is free in this EFn
        let param_names = array_slice([""], 0, 0)
        let mut pi2 = 0
        while pi2 < array_length(params) {
          let (pname2, _) = array_get(params, pi2)
          array_push(param_names, pname2)
          pi2 = pi2 + 1
        }
        let fv = collect_free_vars(fn_body, param_names, array_slice([""], 0, 0))
        if array_contains_str(fv, name) { true }
        else {
          // Also check recursively for deeper nesting
          is_mut_captured_in(fn_body, name)
        }
      }
    },
    EBreak(_) => false,
    EContinue(_) => false,
    EThrow(msg) => is_mut_captured_in(msg, name),
    _ => false
  }
}

// === Lookup helpers ===

export let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {
  let rec search = (i: Int) -> Int with { Error } {
    if i >= array_length(strs) {
      throw(string_concat("string not in table: ", s))
    }
    if string_equals(array_get(strs, i), s) {
      i
    } else search(i + 1)
  }
  search(0)
}

// Check if a pattern is unconditionally matching (catch-all)
export let is_catchall_pat = (p: Pat) -> Bool {
  match p {
    PWild => true,
    PBind(_) => true,
    PTuple(pats) => {
      // PTuple is catch-all only if ALL sub-patterns are catch-all
      let mut i = 0
      let mut all_catch = true
      while i < array_length(pats) {
        if !is_catchall_pat(array_get(pats, i)) { all_catch = false }
        i = i + 1
      }
      all_catch
    },
    _ => false
  }
}

// Find the index of the first catch-all pattern in match arms
// Returns num_arms if no catch-all found
export let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {
  let num = array_length(arms)
  let rec search = (idx: Int) -> Int {
    if idx >= num { num }
    else {
      let (p, _) = array_get(arms, idx)
      if is_catchall_pat(p) { idx } else search(idx + 1)
    }
  }
  search(0)
}

// Find the SLet statement for a given function name
export let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {
  let rec search = (i: Int) -> Stmt with { Error } {
    if i >= array_length(stmts) {
      throw(string_concat("function not found: ", name))
    }
    let stmt = array_get(stmts, i)
    match stmt {
      SLet(_, _, sname, _, _) => {
        if string_equals(sname, name) {
          stmt
        } else search(i + 1)
      },
      _ => search(i + 1)
    }
  }
  search(0)
}

// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))
export let get_func_body = (stmt: Stmt) -> Expr with { Error } {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, _, _, _, body) => body,
      _ => throw("get_func_body: not a function")
    },
    _ => throw("get_func_body: not a let statement")
  }
}

// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))
export let get_func_param_names = (stmt: Stmt) -> Array[String] with { Error } {
  match stmt {
    SLet(_, _, _, _, expr) => match expr {
      EFn(_, _, params, _, _, _) => {
        let names = array_slice([""], 0, 0)
        let mut i = 0
        while i < array_length(params) {
          let (pname, _) = array_get(params, i)
          array_push(names, pname)
          i = i + 1
        }
        names
      },
      _ => throw("get_func_param_names: not a function")
    },
    _ => throw("get_func_param_names: not a let statement")
  }
}

// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)
export let get_match_scrutinee = (expr: Expr) -> Expr with { Error } {
  match expr {
    EMatch(scrutinee, _) => scrutinee,
    _ => throw("get_match_scrutinee: not an EMatch")
  }
}

// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)
export let get_match_arms = (expr: Expr) -> Array[(Pat, Expr)] with { Error } {
  match expr {
    EMatch(_, arms) => arms,
    _ => throw("get_match_arms: not an EMatch")
  }
}

// Extract pattern from match arm pair
export let get_arm_pat = (arm: (Pat, Expr)) -> Pat {
  let (p, _) = arm
  p
}

// Extract body from match arm pair
export let get_arm_body = (arm: (Pat, Expr)) -> Expr {
  let (_, b) = arm
  b
}

// Extract sub-patterns from PTuple
export let get_ptuple_pats = (p: Pat) -> Array[Pat] with { Error } {
  match p {
    PTuple(pats) => pats,
    _ => throw("get_ptuple_pats: not a PTuple")
  }
}

// Extract name from PBind
export let get_pbind_name = (p: Pat) -> String with { Error } {
  match p {
    PBind(name) => name,
    _ => throw("get_pbind_name: not a PBind")
  }
}

// Extract PCtor name and args
export let get_pctor_name = (p: Pat) -> String with { Error } {
  match p {
    PCtor(name, _) => name,
    _ => throw("get_pctor_name: not a PCtor")
  }
}

export let get_pctor_args = (p: Pat) -> Array[Pat] with { Error } {
  match p {
    PCtor(_, args) => args,
    _ => throw("get_pctor_args: not a PCtor")
  }
}

// Extract PInt value
export let get_pint_value = (p: Pat) -> Int with { Error } {
  match p {
    PInt(n) => n,
    _ => throw("get_pint_value: not a PInt")
  }
}

// Extract PBool value
export let get_pbool_value = (p: Pat) -> Bool with { Error } {
  match p {
    PBool(v) => v,
    _ => throw("get_pbool_value: not a PBool")
  }
}

// Extract PString value
export let get_pstring_value = (p: Pat) -> String with { Error } {
  match p {
    PString(s) => s,
    _ => throw("get_pstring_value: not a PString")
  }
}

// Extract elements from ETuple
export let get_etuple_elems = (expr: Expr) -> Array[Expr] with { Error } {
  match expr {
    ETuple(elems) => elems,
    _ => throw("get_etuple_elems: not an ETuple")
  }
}

// Check if expr is an ETuple
export let is_etuple = (expr: Expr) -> Bool {
  match expr {
    ETuple(_) => true,
    _ => false
  }
}

// Check pattern type
export let is_ptuple = (p: Pat) -> Bool {
  match p { PTuple(_) => true, _ => false }
}
export let is_pwild = (p: Pat) -> Bool {
  match p { PWild => true, _ => false }
}
export let is_pbind = (p: Pat) -> Bool {
  match p { PBind(_) => true, _ => false }
}
export let is_pint = (p: Pat) -> Bool {
  match p { PInt(_) => true, _ => false }
}
export let is_pbool = (p: Pat) -> Bool {
  match p { PBool(_) => true, _ => false }
}
export let is_pctor = (p: Pat) -> Bool {
  match p { PCtor(_, _) => true, _ => false }
}
export let is_pstring = (p: Pat) -> Bool {
  match p { PString(_) => true, _ => false }
}

// === Expr extraction helpers (to avoid stale match bindings in let rec) ===

