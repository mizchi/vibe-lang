//# Imports

import ./entry/compiler/fs_compile/index.vibe {
  prepare_modules_cached,
  compile_with_modules_cached,
  compile_with_modules_wasi_cached,
  compile_with_source_groups_wasi_cached
}

import ./entry/compiler/file_compile/index.vibe {
  compile_file_fs_module_cached
}

import ./type_db.vibe {
  db_new,
  db_typecheck_count,
  db_parse_count,
  db_merge_count,
  db_module_source_count,
  db_merged_source,
  db_grouped_merged_source,
  db_codegen_count
}

//# Helpers

let string_to_bytes = (s: String) -> Bytes {
  let out = Array::slice([0], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

let empty_sources = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let repeat_string = (fragment: String, count: Int) -> String {
  let mut out = ""
  let mut i = 0
  while i < count {
    out = String::concat(out, fragment)
    i = i + 1
  }
  out
}

let assert_wasm_magic = (bytes: Bytes) -> Unit {
  assert(Bytes::get(bytes, 0) == 0)
  assert(Bytes::get(bytes, 1) == 97)
  assert(Bytes::get(bytes, 2) == 115)
  assert(Bytes::get(bytes, 3) == 109)
}

//# Tests

test "prepare_modules_cached: warm prepare reuses typecheck cache" {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let db1 = prepare_modules_cached(db_new(), "main.vibe", main_source, sources)
  let count1 = db_typecheck_count(db1)
  let db2 = prepare_modules_cached(db1, "main.vibe", main_source, sources)
  assert(eq(db_typecheck_count(db2), count1))
}

test "compile_with_modules_cached: warm compile reuses parsed modules" {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let (_, db1) = compile_with_modules_cached(
    db_new(),
    main_source,
    "main.vibe",
    sources
  )
  let parse_count1 = db_parse_count(db1)
  let (_, db2) = compile_with_modules_cached(db1, main_source, "main.vibe", sources)
  assert(eq(db_parse_count(db2), parse_count1))
}

test "compile_file_fs_module_cached: warm compile reuses merged module cache" {
  let helper_path = "/tmp/vibe_compiler_cache_helper.vibe"
  let main_path = "/tmp/vibe_compiler_cache_main.vibe"
  Fs::write_bytes(
    helper_path,
    string_to_bytes("export let add = (a: Int, b: Int) -> Int { a + b }")
  )
  Fs::write_bytes(
    main_path,
    string_to_bytes(
      "import ./vibe_compiler_cache_helper.vibe { add }\nlet run = () -> Int { add(1, 2) }"
    )
  )
  let (_, db1) = compile_file_fs_module_cached(db_new(), main_path)
  let merge_count1 = db_merge_count(db1)
  let (_, db2) = compile_file_fs_module_cached(db1, main_path)
  assert(eq(db_merge_count(db2), merge_count1))
}

test "compile_file_fs_module_cached: same merged source reuses merge cache across entry paths" {
  let main_path1 = "/tmp/vibe_compiler_merge_cache_same_source_a.vibe"
  let main_path2 = "/tmp/vibe_compiler_merge_cache_same_source_b.vibe"
  let source = "let run = () -> Int { 1 + 2 }"
  Fs::write_bytes(main_path1, string_to_bytes(source))
  Fs::write_bytes(main_path2, string_to_bytes(source))
  let (_, db1) = compile_file_fs_module_cached(db_new(), main_path1)
  let merge_count1 = db_merge_count(db1)
  let (_, db2) = compile_file_fs_module_cached(db1, main_path2)
  assert(eq(db_merge_count(db2), merge_count1))
}

test "db_grouped_merged_source: warm grouped merge reuses cached groups" {
  let groups = [
    ("core", [("helpers.vibe", "export let add = (a: Int, b: Int) -> Int { a + b }")]),
    ("entry", [("main.vibe", "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }")])
  ]
  let (_, _, db1) = db_grouped_merged_source(db_new(), groups)
  let merge_count1 = db_merge_count(db1)
  let (_, _, db2) = db_grouped_merged_source(db1, groups)
  assert(eq(db_merge_count(db2), merge_count1))
}

test "db_grouped_merged_source: changing one group only rebuilds that group and final merge" {
  let groups1 = [
    ("core", [("helpers.vibe", "export let add = (a: Int, b: Int) -> Int { a + b }")]),
    ("entry", [("main.vibe", "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }")])
  ]
  let groups2 = [
    ("core", [("helpers.vibe", "export let add = (a: Int, b: Int) -> Int { a + b }")]),
    ("entry", [("main.vibe", "import ./helpers.vibe { add }\nlet main = () -> Int { add(2, 3) }")])
  ]
  let (_, _, db1) = db_grouped_merged_source(db_new(), groups1)
  let merge_count1 = db_merge_count(db1)
  let (_, _, db2) = db_grouped_merged_source(db1, groups2)
  assert(eq(db_merge_count(db2), merge_count1 + 2))
}

test "db_merged_source: fingerprint stays compact for large sources" {
  let large_source = repeat_string("let value = 42\n", 2048)
  let (_, fingerprint, _) = db_merged_source(
    db_new(),
    "main.vibe",
    [("main.vibe", large_source)]
  )
  assert(String::length(fingerprint) < 64)
}

test "db_grouped_merged_source: grouped fingerprint stays compact for large sources" {
  let large_source = repeat_string("let value = 42\n", 2048)
  let (_, fingerprint, _) = db_grouped_merged_source(
    db_new(),
    [("core", [("main.vibe", large_source)])]
  )
  assert(String::length(fingerprint) < 64)
}

test "compile_with_modules_cached: warm compile reuses compiled artifact cache" {
  let main_source = "let main = () -> Int { 1 + 2 }"
  let sources = empty_sources()
  let (_, db1) = compile_with_modules_cached(
    db_new(),
    main_source,
    "main.vibe",
    sources
  )
  let codegen_count1 = db_codegen_count(db1)
  let (_, db2) = compile_with_modules_cached(db1, main_source, "main.vibe", sources)
  assert(eq(db_codegen_count(db2), codegen_count1))
}

test "compile_with_modules_wasi_cached: multi-module imports compile to valid WASM and reuse codegen cache" {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet run = () -> Int { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let (bytes1, db1) = compile_with_modules_wasi_cached(
    db_new(),
    main_source,
    "main.vibe",
    sources,
    "run"
  )
  assert_wasm_magic(bytes1)
  let codegen_count1 = db_codegen_count(db1)
  let (bytes2, db2) = compile_with_modules_wasi_cached(
    db1,
    main_source,
    "main.vibe",
    sources,
    "run"
  )
  assert_wasm_magic(bytes2)
  assert(eq(db_codegen_count(db2), codegen_count1))
}

test "compile_with_source_groups_wasi_cached: grouped sources reuse grouped merge cache" {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet run = () -> Int { add(1, 2) }"
  let source_groups = [
    ("core", [("helpers.vibe", helper_source)]),
    ("entry", [("main.vibe", main_source)])
  ]
  let (bytes1, db1) = compile_with_source_groups_wasi_cached(
    db_new(),
    main_source,
    "main.vibe",
    source_groups,
    "run"
  )
  assert_wasm_magic(bytes1)
  let merge_count1 = db_merge_count(db1)
  let (bytes2, db2) = compile_with_source_groups_wasi_cached(
    db1,
    main_source,
    "main.vibe",
    source_groups,
    "run"
  )
  assert_wasm_magic(bytes2)
  assert(eq(db_merge_count(db2), merge_count1))
}

