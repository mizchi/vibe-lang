//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_enum_simple" {
  assert(String::equals(ps("enum Color { Red; Green; Blue }"), "enum Color { Red; Green; Blue }"))
}

test "stmt_enum_with_args" {
  assert(String::equals(ps("enum Option { Some(Int); None }"), "enum Option { Some(Int); None }"))
}

test "stmt_enum_exported" {
  assert(String::equals(ps("export enum Color { Red; Green }"), "export enum Color { Red; Green }"))
}

test "stmt_struct" {
  assert(String::equals(ps("struct Point { x: Int; y: Int }"), "struct Point { x: Int; y: Int }"))
}

test "stmt_struct_exported" {
  assert(String::equals(ps("export struct Point { x: Int }"), "export struct Point { x: Int }"))
}

test "stmt_type_alias" {
  assert(String::equals(ps("type Name = String"), "type Name = String"))
}

test "stmt_type_alias_exported" {
  assert(String::equals(ps("export type Pair = (Int, String)"), "export type Pair = (Int, String)"))
}

test "stmt_trait" {
  assert(String::equals(ps("trait Show"), "trait Show"))
}

test "stmt_impl" {
  assert(String::equals(pp("impl Show for Int"), "impl Show for Int"))
}

test "stmt_impl_type_params_rejected" {
  let result = pp("impl [A: Show] Show for Int")
  assert(String::equals(result, "ERROR: impl type parameters are not supported yet"))
}

test "stmt_use_removed" {
  let result = ps("use ./foo.vibe { Bar }")
  assert(String::equals(result, "ERROR: 'use' syntax is removed; use 'import <module-ref> { ... }'"))
}

test "stmt_import_basic" {
  assert(String::equals(ps("import ./foo.vibe { Bar }"), "import ./foo.vibe { Bar }"))
}
