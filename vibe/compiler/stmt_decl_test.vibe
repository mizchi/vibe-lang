//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Enum and import declaration tests

test "stmt_enum_simple" {
  assert(String::equals(ps("enum Color { Red; Green; Blue }"), "enum Color { Red; Green; Blue }"))
}

test "stmt_enum_with_args" {
  assert(String::equals(ps("enum Option { Some(Int); None }"), "enum Option { Some(Int); None }"))
}

test "stmt_enum_exported" {
  assert(String::equals(ps("export enum Color { Red; Green }"), "export enum Color { Red; Green }"))
}

test "stmt_use_removed" {
  let result = ps("use ./foo.vibe { Bar }")
  assert(String::equals(result, "ERROR: 'use' syntax is removed; use 'import <module-ref> { ... }'"))
}

test "stmt_import_basic" {
  assert(String::equals(ps("import ./foo.vibe { Bar }"), "import ./foo.vibe { Bar }"))
}
