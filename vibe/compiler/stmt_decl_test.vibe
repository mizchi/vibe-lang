//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_enum_simple" {
  assert(ps("enum Color { Red; Green; Blue }") == "enum Color { Red; Green; Blue }")
}

test "stmt_enum_with_args" {
  assert(ps("enum Option { Some(Int); None }") == "enum Option { Some(Int); None }")
}

test "stmt_enum_exported" {
  assert(ps("export enum Color { Red; Green }") == "export enum Color { Red; Green }")
}

test "stmt_use_removed" {
  let result = ps("use ./foo.vibe { Bar }")
  assert(result == "ERROR: 'use' syntax is removed; use 'import <module-ref> { ... }'")
}

test "stmt_import_basic" {
  assert(ps("import ./foo.vibe { Bar }") == "import ./foo.vibe { Bar }")
}

test "stmt_export_qualified_let" {
  assert(ps("export let Int::abs = (x: Int) -> Int { x }") == "export let Int::abs = (x: Int) -> Int { x }")
}
