import ./lexer.vibe { lex }
import ./parser.vibe { parse_program }
import ./codegen.vibe { compile_wasi_module }

test "wasi: both tuple match isolated" {
  let source = "let foo = () -> (Int, Int) {\n  let (x, y) = (1, 2);\n  (x, y)\n}\nlet main = () -> Int {\n  let (p, n) = foo();\n  p + n\n}\n"
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let bytes = compile_wasi_module(stmts, "main")
  fs_write_bytes("/tmp/test_both_isolated.wasm", bytes)
  0
}
