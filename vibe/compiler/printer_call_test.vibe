//# Imports

import ./printer_test_support.vibe {
  roundtrip
}

//# Misc

test "roundtrip call" {
  let ok = handle {
    roundtrip("f(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip dot" {
  let ok = handle {
    roundtrip("a.b.c")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip pipe" {
  let ok = handle {
    roundtrip("x |> f |> g")
  } {
    Error(_) => false
  }
  assert(ok)
}
