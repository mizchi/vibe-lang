  handle {
    let expr = EBinOp("*", EInt(6), EInt(7))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(42)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp div" {
  handle {
    let expr = EBinOp("/", EInt(15), EInt(3))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(5)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp mod" {
  handle {
    let expr = EBinOp("%", EInt(17), EInt(5))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(2)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp bitwise and" {
  handle {
    let expr = EBinOp("&", EInt(0xFF), EInt(0x0F))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(0x0F)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp logical and" {
  handle {
    let expr = EBinOp("&&", EBool(true), EBool(false))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(false)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp logical and rejects non-bool operands" {
  let caught = handle {
    let _ = eval_expr(EBinOp("&&", EInt(1), EInt(2)), VEnvEmpty)
    false
  } {
    Error(_) => true
  }
  assert(caught)
}

test "eval BinOp logical or" {
  handle {
    let expr = EBinOp("||", EBool(false), EBool(true))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp neq" {
  handle {
    let expr = EBinOp("!=", EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp gte" {
  handle {
    let expr = EBinOp(">=", EInt(5), EInt(5))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp gt" {
  handle {
    let expr = EBinOp(">", EInt(3), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp string neq" {
  handle {
    let expr = EBinOp("!=", EString("a"), EString("b"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval UnaryOp not" {
  handle {
    let expr = EUnaryOp("!", EBool(true))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(false)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp add rejects mixed types" {
  let caught = handle {
    let _ = eval_expr(EBinOp("+", EInt(1), EString("x")), VEnvEmpty)
    false
  } {
    Error(_) => true
  }
  assert(caught)
}

test "eval UnaryOp negate rejects string" {
  let caught = handle {
    let _ = eval_expr(EUnaryOp("-", EString("x")), VEnvEmpty)
    false
  } {
    Error(_) => true
  }
  assert(caught)
}

test "eval EHandle no error" {
  handle {
    let expr = EHandle(EInt(42), [
      (PBind("_"), EInt(0))
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(42)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval nested ELet" {
  handle {
    // let a = 1; let b = 2; let c = a + b; c
    let expr = ELet("a", EInt(1),
      ELet("b", EInt(2),
        ELet("c", EBinOp("+", EIdent("a"), EIdent("b")),
          EIdent("c"))))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(3)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval match_pattern PInt matches" {
  let result = match_pattern(PInt(42), VInt(42))
  match result {
    Some(_) => assert_true(true),
    None => assert_true(false)
  }
}

test "eval match_pattern PInt no match" {
  let result = match_pattern(PInt(42), VInt(99))
  match result {
    Some(_) => assert_true(false),
    None => assert_true(true)
  }
}

test "eval match_pattern PString matches" {
  let result = match_pattern(PString("hello"), VString("hello"))
  match result {
    Some(_) => assert_true(true),
    None => assert_true(false)
  }
}

test "eval match_pattern PBool matches" {
  let result = match_pattern(PBool(true), VBool(true))
  match result {
    Some(_) => assert_true(true),
    None => assert_true(false)
  }
}

test "eval match_pattern PBool no match" {
  let result = match_pattern(PBool(true), VBool(false))
  match result {
    Some(_) => assert_true(false),
    None => assert_true(true)
  }
}

test "eval match_pattern PWild matches anything" {
  let result = match_pattern(PWild, VInt(999))
  match result {
    Some(_) => assert_true(true),
    None => assert_true(false)
  }
}

test "eval match_pattern PBind captures value" {
  let result = match_pattern(PBind("x"), VInt(42))
  match result {
    Some(bindings) => {
      assert_true(eq(Array::length(bindings), 1))
      let (name, val) = Array::get(bindings, 0)
      assert_eq(name, "x")
      assert_true(values_equal(val, VInt(42)))
    },
    None => assert_true(false)
  }
}
