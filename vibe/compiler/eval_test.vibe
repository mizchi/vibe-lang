import ./ast.vibe { Expr, Pat, TypeExpr, Stmt }
import ./values.vibe { Value, ValEnv, val_env_bind, value_to_string, values_equal }
import ./eval.vibe { eval_expr, match_pattern }

// Anchor imports to prevent silent failure
let _ae = (e: Expr) -> Expr { e }
let _no_tp = array_slice([""], 0, 0)
let _no_tb = array_slice([("", _no_tp)], 0, 0)
let _ap = (p: Pat) -> Pat { p }
let _at = (t: TypeExpr) -> TypeExpr { t }
let _as2 = (s: Stmt) -> Stmt { s }

// --- Literal tests ---

test "eval EInt" {
  let (v, _) = eval_expr(EInt(42), VEnvEmpty)
  assert(values_equal(v, VInt(42)))
}

test "eval EString" {
  let (v, _) = eval_expr(EString("hello"), VEnvEmpty)
  assert(values_equal(v, VString("hello")))
}

test "eval EBool" {
  let (v, _) = eval_expr(EBool(true), VEnvEmpty)
  assert(values_equal(v, VBool(true)))
}

test "eval EUnit" {
  let (v, _) = eval_expr(EUnit, VEnvEmpty)
  assert(values_equal(v, VUnit))
}

test "eval EFloat" {
  let (v, _) = eval_expr(EFloat(3.14), VEnvEmpty)
  assert(string_equals(value_to_string(v), "3.14"))
}

// --- Binding tests ---

test "eval ELet" {
  let expr = ELet("x", EInt(42), EIdent("x"))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(42)))
}

test "eval ELetMut and EAssign" {
  // let mut x = 1; x = 2; x
  let expr = ELetMut("x", EInt(1), EAssign("x", EInt(2), EIdent("x")))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(2)))
}

test "eval ESeq" {
  let expr = ESeq(EInt(1), EInt(2))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(2)))
}

// --- Control flow ---

test "eval EIf true" {
  let expr = EIf(EBool(true), EInt(1), EInt(2))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(1)))
}

test "eval EIf false" {
  let expr = EIf(EBool(false), EInt(1), EInt(2))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(2)))
}

// --- Operators ---

test "eval BinOp add" {
  let expr = EBinOp("+", EInt(3), EInt(4))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(7)))
}

test "eval BinOp compare" {
  let expr = EBinOp("<", EInt(1), EInt(2))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VBool(true)))
}

test "eval BinOp string eq" {
  let expr = EBinOp("==", EString("a"), EString("a"))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VBool(true)))
}

test "eval UnaryOp negate" {
  let expr = EUnaryOp("-", EInt(5))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(0 - 5)))
}

// --- Function ---

test "eval EFn and ECall identity" {
  // let f = (x) -> x; f(42)
  let fn_expr = EFn(_no_tp, _no_tb, [("x", None)], None, None, EIdent("x"))
  let call_expr = ELet("f", fn_expr, ECall(EIdent("f"), [EInt(42)]))
  let (v, _) = eval_expr(call_expr, VEnvEmpty)
  assert(values_equal(v, VInt(42)))
}

test "eval closure captures env" {
  // let a = 10; let f = (x) -> x + a; f(5)
  let fn_body = EBinOp("+", EIdent("x"), EIdent("a"))
  let fn_expr = EFn(_no_tp, _no_tb, [("x", None)], None, None, fn_body)
  let expr = ELet("a", EInt(10),
    ELet("f", fn_expr,
      ECall(EIdent("f"), [EInt(5)])))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(15)))
}

// --- Match ---

test "match literal" {
  // match 1 { 1 => 10, _ => 20 }
  let arms = [(PInt(1), EInt(10)), (PWild, EInt(20))]
  let expr = EMatch(EInt(1), arms)
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(10)))
}

test "match PBind" {
  // match 42 { x => x }
  let arms = [(PBind("x"), EIdent("x"))]
  let expr = EMatch(EInt(42), arms)
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(42)))
}

test "match PCtor" {
  let empty_pats = array_slice([PWild], 0, 0)
  // match Some(42) { Some(x) => x, None => 0 }
  let arms = [(PCtor("Some", [PBind("x")]), EIdent("x")), (PCtor("None", empty_pats), EInt(0))]
  let scrutinee_val = VCtor("Some", [VInt(42)])
  // Use match_pattern directly first
  match match_pattern(PCtor("Some", [PBind("x")]), scrutinee_val) {
    Some(binds) => {
      let (name, val) = array_get(binds, 0)
      assert(string_equals(name, "x"))
      assert(values_equal(val, VInt(42)))
    },
    None => assert(false)
  }
}

// --- Data ---

test "eval ETuple and EDot" {
  // let t = (1, 2); t.0
  let expr = ELet("t", ETuple([EInt(1), EInt(2)]), EDot(EIdent("t"), "0"))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(1)))
}

test "eval EArray" {
  let expr = EArray([EInt(1), EInt(2), EInt(3)])
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(string_equals(value_to_string(v), "[1, 2, 3]"))
}

test "eval ERecord and EDot" {
  let expr = ELet("r", ERecord([("x", EInt(10)), ("y", EInt(20))]), EDot(EIdent("r"), "y"))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(20)))
}

test "eval builtin call" {
  // string_concat("a", "b")
  let expr = ECall(EIdent("string_concat"), [EString("a"), EString("b")])
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VString("ab")))
}

test "eval BinOp multiply" {
  let expr = EBinOp("*", EInt(3), EInt(4))
  let (v, _) = eval_expr(expr, VEnvEmpty)
  assert(values_equal(v, VInt(12)))
}
