test "eval EHandle no error" {
  handle {
    let expr = EHandle(EInt(42), [
      (PBind("_"), EInt(0))
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval nested ELet" {
  handle {
    // let a = 1; let b = 2; let c = a + b; c
    let expr = ELet("a", EInt(1),
      ELet("b", EInt(2),
        ELet("c", EBinOp("+", EIdent("a"), EIdent("b")),
          EIdent("c"))))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(3)))
  } {
    Error(_) => assert(false)
  }
}

test "eval match_pattern PInt matches" {
  let result = match_pattern(PInt(42), VInt(42))
  match result {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "eval match_pattern PInt no match" {
  let result = match_pattern(PInt(42), VInt(99))
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "eval match_pattern PString matches" {
  let result = match_pattern(PString("hello"), VString("hello"))
  match result {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "eval match_pattern PBool matches" {
  let result = match_pattern(PBool(true), VBool(true))
  match result {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "eval match_pattern PBool no match" {
  let result = match_pattern(PBool(true), VBool(false))
  match result {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "eval match_pattern PWild matches anything" {
  let result = match_pattern(PWild, VInt(999))
  match result {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "eval match_pattern PBind captures value" {
  let result = match_pattern(PBind("x"), VInt(42))
  match result {
    Some(bindings) => {
      assert(eq(Array::length(bindings), 1))
      let (name, val) = Array::get(bindings, 0)
      assert(name == "x")
      assert(values_equal(val, VInt(42)))
    },
    None => assert(false)
  }
}
