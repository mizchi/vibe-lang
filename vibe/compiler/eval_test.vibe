//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval.vibe {
  decode_expr, encode_expr, eval_expr, match_pattern
}

import ./values.vibe {
  ValEnv, Value, val_env_bind, value_to_string, values_equal
}

//# Functions

let _ae = (e: Expr) -> Expr {
  e
}

let _ap = (p: Pat) -> Pat {
  p
}

let _at = (t: TypeExpr) -> TypeExpr {
  t
}

let _as2 = (s: Stmt) -> Stmt {
  s
}

let _no_tp = Array::slice([
  ""
], 0, 0)

let _no_tb = Array::slice([
  ("", _no_tp)
], 0, 0)

//# Misc

test "eval EInt" {
  handle {
    let (v, _) = eval_expr(EInt(42), VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EString" {
  handle {
    let (v, _) = eval_expr(EString("hello"), VEnvEmpty)
    assert(values_equal(v, VString("hello")))
  } {
    Error(_) => assert(false)
  }
}

test "eval EBool" {
  handle {
    let (v, _) = eval_expr(EBool(true), VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EUnit" {
  handle {
    let (v, _) = eval_expr(EUnit, VEnvEmpty)
    assert(values_equal(v, VUnit))
  } {
    Error(_) => assert(false)
  }
}

test "eval EFloat" {
  handle {
    let (v, _) = eval_expr(EFloat(3.14), VEnvEmpty)
    assert(value_to_string(v) == "3.14")
  } {
    Error(_) => assert(false)
  }
}

test "eval ELet" {
  handle {
    let expr = ELet("x", EInt(42), EIdent("x"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval ELetMut and EAssign" {
  handle {
    // let mut x = 1; x = 2; x
    let expr = ELetMut("x", EInt(1), EAssign("x", EInt(2), EIdent("x")))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(2)))
  } {
    Error(_) => assert(false)
  }
}

test "eval ESeq" {
  handle {
    let expr = ESeq(EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(2)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EIf true" {
  handle {
    let expr = EIf(EBool(true), EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(1)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EIf false" {
  handle {
    let expr = EIf(EBool(false), EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(2)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp add" {
  handle {
    let expr = EBinOp("+", EInt(3), EInt(4))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(7)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp compare" {
  handle {
    let expr = EBinOp("<", EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp double compare" {
  handle {
    let expr = EBinOp("<", EFloat(1.0), EFloat(2.0))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp string eq" {
  handle {
    let expr = EBinOp("==", EString("a"), EString("a"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval UnaryOp negate" {
  handle {
    let expr = EUnaryOp("-", EInt(5))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(0 - 5)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EFn and ECall identity" {
  handle {
    // let f = (x) -> x; f(42)
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, EIdent("x"))
    let call_expr = ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(42)
    ]))
    let (v, _) = eval_expr(call_expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval closure captures env" {
  handle {
    // let a = 10; let f = (x) -> x + a; f(5)
    let fn_body = EBinOp("+", EIdent("x"), EIdent("a"))
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, fn_body)
    let expr = ELet("a", EInt(10), ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(5)
    ])))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(15)))
  } {
    Error(_) => assert(false)
  }
}

test "encode/decode fn preserves annotations" {
  let expr = EFn([
    "T"
  ], [
    ("T", [
      "Show"
    ])
  ], [
    ("x", Some(TyApp("Option", [
      TyName("Int")
    ]))),
    ("y", None)
  ], Some(TyTuple([
    TyName("String"),
    TyUnit
  ])), Some("Error"), EIdent("x"))
  match decode_expr(encode_expr(expr)) {
    EFn(type_params, bounds, params, ret_ty, effect, body) => {
      assert(eq(Array::length(type_params), 1))
      assert(Array::get(type_params, 0) == "T")
      assert(eq(Array::length(bounds), 1))
      let (bound_name, bound_traits) = Array::get(bounds, 0)
      assert(bound_name == "T")
      assert(eq(Array::length(bound_traits), 1))
      assert(Array::get(bound_traits, 0) == "Show")
      assert(eq(Array::length(params), 2))
      let (param_name, param_ty) = Array::get(params, 0)
      assert(param_name == "x")
      match param_ty {
        Some(inner_ty) => match inner_ty {
          TyApp(name, args) => {
            assert(name == "Option")
            assert(eq(Array::length(args), 1))
            match Array::get(args, 0) {
              TyName(inner) => assert(inner == "Int"),
              _ => assert(false)
            }
          },
          _ => assert(false)
        },
        _ => assert(false)
      }
      let (param2_name, param2_ty) = Array::get(params, 1)
      assert(param2_name == "y")
      match param2_ty {
        None => assert(true),
        _ => assert(false)
      }
      match ret_ty {
        Some(TyTuple(items)) => {
          assert(eq(Array::length(items), 2))
          match Array::get(items, 0) {
            TyName(name) => assert(name == "String"),
            _ => assert(false)
          }
          match Array::get(items, 1) {
            TyUnit => assert(true),
            _ => assert(false)
          }
        },
        _ => assert(false)
      }
      match effect {
        Some(effect_name) => assert(effect_name == "Error"),
        None => assert(false)
      }
      match body {
        EIdent(name) => assert(name == "x"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "encode/decode break preserves payload" {
  match decode_expr(encode_expr(EBreak(Some(EInt(42))))) {
    EBreak(Some(inner)) => match inner {
      EInt(n) => assert(eq(n, 42)),
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "encode/decode continue preserves payloads" {
  match decode_expr(encode_expr(EContinue([
    EInt(1),
    EString("x")
  ]))) {
    EContinue(args) => {
      assert(eq(Array::length(args), 2))
      match Array::get(args, 0) {
        EInt(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      match Array::get(args, 1) {
        EString(s) => assert(s == "x"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}
