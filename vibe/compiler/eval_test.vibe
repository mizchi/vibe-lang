//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval.vibe {
  eval_expr, match_pattern
}

import ./values.vibe {
  ValEnv, Value, val_env_bind, value_to_string, values_equal
}

//# Functions

let _ae = (e: Expr) -> Expr {
  e
}

let _ap = (p: Pat) -> Pat {
  p
}

let _at = (t: TypeExpr) -> TypeExpr {
  t
}

let _as2 = (s: Stmt) -> Stmt {
  s
}

let _no_tp = Array::slice([
  ""
], 0, 0)

let _no_tb = Array::slice([
  ("", _no_tp)
], 0, 0)

//# Misc

test "eval EInt" {
  handle {
    let (v, _) = eval_expr(EInt(42), VEnvEmpty)
    assert_true(values_equal(v, VInt(42)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EString" {
  handle {
    let (v, _) = eval_expr(EString("hello"), VEnvEmpty)
    assert_true(values_equal(v, VString("hello")))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EBool" {
  handle {
    let (v, _) = eval_expr(EBool(true), VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EUnit" {
  handle {
    let (v, _) = eval_expr(EUnit, VEnvEmpty)
    assert_true(values_equal(v, VUnit))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EFloat" {
  handle {
    let (v, _) = eval_expr(EFloat(3.14), VEnvEmpty)
    assert_eq(value_to_string(v),"3.14")
  } {
    Error(_) => assert_true(false)
  }
}

test "eval ELet" {
  handle {
    let expr = ELet("x", EInt(42), EIdent("x"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(42)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval ELetMut and EAssign" {
  handle {
    // let mut x = 1; x = 2; x
    let expr = ELetMut("x", EInt(1), EAssign("x", EInt(2), EIdent("x")))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(2)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval ESeq" {
  handle {
    let expr = ESeq(EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(2)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EIf true" {
  handle {
    let expr = EIf(EBool(true), EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(1)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EIf false" {
  handle {
    let expr = EIf(EBool(false), EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(2)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp add" {
  handle {
    let expr = EBinOp("+", EInt(3), EInt(4))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(7)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp compare" {
  handle {
    let expr = EBinOp("<", EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp double compare" {
  handle {
    let expr = EBinOp("<", EFloat(1.0), EFloat(2.0))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp string eq" {
  handle {
    let expr = EBinOp("==", EString("a"), EString("a"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VBool(true)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval UnaryOp negate" {
  handle {
    let expr = EUnaryOp("-", EInt(5))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(0 - 5)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EFn and ECall identity" {
  handle {
    // let f = (x) -> x; f(42)
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, EIdent("x"))
    let call_expr = ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(42)
    ]))
    let (v, _) = eval_expr(call_expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(42)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval closure captures env" {
  handle {
    // let a = 10; let f = (x) -> x + a; f(5)
    let fn_body = EBinOp("+", EIdent("x"), EIdent("a"))
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, fn_body)
    let expr = ELet("a", EInt(10), ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(5)
    ])))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(15)))
  } {
    Error(_) => assert_true(false)
  }
}


test "eval ETuple" {
  handle {
    let expr = ETuple([EInt(1), EInt(2)])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    match v {
      VTuple(items) => assert_true(eq(Array::length(items), 2)),
      _ => assert_true(false)
    }
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EArray" {
  handle {
    let expr = EArray([EInt(10), EInt(20), EInt(30)])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_eq(value_to_string(v),"[10, 20, 30]")
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EMatch with int patterns" {
  handle {
    let expr = EMatch(EInt(2), [
      (PInt(1), EString("one")),
      (PInt(2), EString("two")),
      (PWild, EString("other"))
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VString("two")))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval EMatch with bind pattern" {
  handle {
    let expr = EMatch(EInt(42), [
      (PBind("x"), EBinOp("+", EIdent("x"), EInt(8)))
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(50)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval ELetRec factorial" {
  handle {
    // let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }; fact(5)
    let fact_body = EIf(
      EBinOp("<=", EIdent("n"), EInt(1)),
      EInt(1),
      EBinOp("*", EIdent("n"), ECall(EIdent("fact"), [EBinOp("-", EIdent("n"), EInt(1))]))
    )
    let fact_fn = EFn(_no_tp, _no_tb, [("n", None)], None, None, fact_body)
    let expr = ELetRec("fact", fact_fn, ECall(EIdent("fact"), [EInt(5)]))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(120)))
  } {
    Error(_) => assert_true(false)
  }
}

test "eval BinOp sub" {
  handle {
    let expr = EBinOp("-", EInt(10), EInt(3))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert_true(values_equal(v, VInt(7)))
  } {
    Error(_) => assert_true(false)
  }
}

