//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval.vibe {
  eval_expr, match_pattern
}

import ./values.vibe {
  ValEnv, Value, val_env_bind, value_to_string, values_equal
}

//# Functions

let _ae = (e: Expr) -> Expr {
  e
}

let _ap = (p: Pat) -> Pat {
  p
}

let _at = (t: TypeExpr) -> TypeExpr {
  t
}

let _as2 = (s: Stmt) -> Stmt {
  s
}

let _no_tp = Array::slice([
  ""
], 0, 0)

let _no_tb = Array::slice([
  ("", _no_tp)
], 0, 0)

//# Misc

test "eval EInt" {
  handle {
    let (v, _) = eval_expr(EInt(42), VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EString" {
  handle {
    let (v, _) = eval_expr(EString("hello"), VEnvEmpty)
    assert(values_equal(v, VString("hello")))
  } {
    Error(_) => assert(false)
  }
}

test "eval EBool" {
  handle {
    let (v, _) = eval_expr(EBool(true), VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EUnit" {
  handle {
    let (v, _) = eval_expr(EUnit, VEnvEmpty)
    assert(values_equal(v, VUnit))
  } {
    Error(_) => assert(false)
  }
}

test "eval EFloat" {
  handle {
    let (v, _) = eval_expr(EFloat(3.14), VEnvEmpty)
    assert(String::equals(value_to_string(v), "3.14"))
  } {
    Error(_) => assert(false)
  }
}

test "eval ELet" {
  handle {
    let expr = ELet("x", EInt(42), EIdent("x"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval ELetMut and EAssign" {
  handle {
    // let mut x = 1; x = 2; x
    let expr = ELetMut("x", EInt(1), EAssign("x", EInt(2), EIdent("x")))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(2)))
  } {
    Error(_) => assert(false)
  }
}

test "eval ESeq" {
  handle {
    let expr = ESeq(EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(2)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EIf true" {
  handle {
    let expr = EIf(EBool(true), EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(1)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EIf false" {
  handle {
    let expr = EIf(EBool(false), EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(2)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp add" {
  handle {
    let expr = EBinOp("+", EInt(3), EInt(4))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(7)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp compare" {
  handle {
    let expr = EBinOp("<", EInt(1), EInt(2))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp string eq" {
  handle {
    let expr = EBinOp("==", EString("a"), EString("a"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VBool(true)))
  } {
    Error(_) => assert(false)
  }
}

test "eval UnaryOp negate" {
  handle {
    let expr = EUnaryOp("-", EInt(5))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(0 - 5)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EFn and ECall identity" {
  handle {
    // let f = (x) -> x; f(42)
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, EIdent("x"))
    let call_expr = ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(42)
    ]))
    let (v, _) = eval_expr(call_expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval closure captures env" {
  handle {
    // let a = 10; let f = (x) -> x + a; f(5)
    let fn_body = EBinOp("+", EIdent("x"), EIdent("a"))
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, fn_body)
    let expr = ELet("a", EInt(10), ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(5)
    ])))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(15)))
  } {
    Error(_) => assert(false)
  }
}

test "match literal" {
  handle {
    // match 1 { 1 => 10, _ => 20 }
    let arms = [
      (PInt(1), EInt(10)),
      (PWild, EInt(20))
    ]
    let expr = EMatch(EInt(1), arms)
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(10)))
  } {
    Error(_) => assert(false)
  }
}

test "match PBind" {
  handle {
    // match 42 { x => x }
    let arms = [
      (PBind("x"), EIdent("x"))
    ]
    let expr = EMatch(EInt(42), arms)
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "match PCtor" {
  let empty_pats = Array::slice([
    PWild
  ], 0, 0)
  // match Some(42) { Some(x) => x, None => 0 }
  let arms = [
    (PCtor("Some", [
      PBind("x")
    ]), EIdent("x")),
    (PCtor("None", empty_pats), EInt(0))
  ]
  let scrutinee_val = VCtor("Some", [
    VInt(42)
  ])
  // Use match_pattern directly first
  match match_pattern(PCtor("Some", [
    PBind("x")
  ]), scrutinee_val) {
    Some(binds) => {
      let (name, val) = Array::get(binds, 0)
      assert(String::equals(name, "x"))
      assert(values_equal(val, VInt(42)))
    },
    None => assert(false)
  }
}

test "eval ETuple and EDot" {
  handle {
    // let t = (1, 2); t.0
    let expr = ELet("t", ETuple([
      EInt(1),
      EInt(2)
    ]), EDot(EIdent("t"), "0"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(1)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EArray" {
  handle {
    let expr = EArray([
      EInt(1),
      EInt(2),
      EInt(3)
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(String::equals(value_to_string(v), "[1, 2, 3]"))
  } {
    Error(_) => assert(false)
  }
}

test "eval ERecord and EDot" {
  handle {
    let expr = ELet("r", ERecord([
      ("x", EInt(10)),
      ("y", EInt(20))
    ]), EDot(EIdent("r"), "y"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(20)))
  } {
    Error(_) => assert(false)
  }
}

test "eval builtin call" {
  handle {
    // String::concat("a", "b")
    let expr = ECall(EIdent("String::concat"), [
      EString("a"),
      EString("b")
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VString("ab")))
  } {
    Error(_) => assert(false)
  }
}

test "eval BinOp multiply" {
  handle {
    let expr = EBinOp("*", EInt(3), EInt(4))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(12)))
  } {
    Error(_) => assert(false)
  }
}

test "eval break in while" {
  handle {
    // let mut i = 0; while true { i = i + 1; if i == 3 { break } }; i
    let body = ESeq(EAssign("i", EBinOp("+", EIdent("i"), EInt(1)), EIf(EBinOp("==", EIdent("i"), EInt(3)), EBreak(None), EUnit)), EUnit)
    let expr = ELetMut("i", EInt(0), ESeq(EWhile(EBool(true), body), EIdent("i")))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(3)))
  } {
    Error(_) => assert(false)
  }
}

test "eval break with value in while" {
  handle {
    // let result = while true { break 42 }; result
    let expr = ELet("result", EWhile(EBool(true), EBreak(Some(EInt(42)))), EIdent("result"))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval continue in while" {
  handle {
    // let mut sum = 0; let mut i = 0; while i < 5 { i = i + 1; if i == 3 { continue }; sum = sum + i }; sum
    let body = EAssign("i", EBinOp("+", EIdent("i"), EInt(1)), EIf(EBinOp("==", EIdent("i"), EInt(3)), EContinue(Array::slice([
      EUnit
    ], 0, 0)), EAssign("sum", EBinOp("+", EIdent("sum"), EIdent("i")), EUnit)))
    let expr = ELetMut("sum", EInt(0), ELetMut("i", EInt(0), ESeq(EWhile(EBinOp("<", EIdent("i"), EInt(5)), body), EIdent("sum"))))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    // sum = 1+2+4+5 = 12 (skip 3)
    assert(values_equal(v, VInt(12)))
  } {
    Error(_) => assert(false)
  }
}

test "eval break in for-in" {
  handle {
    // for x in [10, 20, 30] { if x == 20 { break 99 } else { x } }
    let body = EIf(EBinOp("==", EIdent("x"), EInt(20)), EBreak(Some(EInt(99))), EIdent("x"))
    let expr = EForIn("x", EArray([
      EInt(10),
      EInt(20),
      EInt(30)
    ]), body)
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(99)))
  } {
    Error(_) => assert(false)
  }
}

test "eval continue in for-in" {
  handle {
    // for x in [1, 2, 3, 4] { if x == 2 { continue } else { x } }
    let body = EIf(EBinOp("==", EIdent("x"), EInt(2)), EContinue(Array::slice([
      EUnit
    ], 0, 0)), EIdent("x"))
    let expr = EForIn("x", EArray([
      EInt(1),
      EInt(2),
      EInt(3),
      EInt(4)
    ]), body)
    let (v, _) = eval_expr(expr, VEnvEmpty)
    // result = [1, 3, 4] (skip 2)
    assert(String::equals(value_to_string(v), "[1, 3, 4]"))
  } {
    Error(_) => assert(false)
  }
}

test "eval break propagation through let-seq" {
  handle {
    // while true { let x = 1; break x }
    let body = ELet("x", EInt(1), EBreak(Some(EIdent("x"))))
    let expr = EWhile(EBool(true), body)
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(1)))
  } {
    Error(_) => assert(false)
  }
}
