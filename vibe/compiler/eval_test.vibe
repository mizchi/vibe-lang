}

test "eval UnaryOp negate" {
  handle {
    let expr = EUnaryOp("-", EInt(5))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(0 - 5)))
  } {
    Error(_) => assert(false)
  }
}

test "eval EFn and ECall identity" {
  handle {
    // let f = (x) -> x; f(42)
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, EIdent("x"))
    let call_expr = ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(42)
    ]))
    let (v, _) = eval_expr(call_expr, VEnvEmpty)
    assert(values_equal(v, VInt(42)))
  } {
    Error(_) => assert(false)
  }
}

test "eval closure captures env" {
  handle {
    // let a = 10; let f = (x) -> x + a; f(5)
    let fn_body = EBinOp("+", EIdent("x"), EIdent("a"))
    let fn_expr = EFn(_no_tp, _no_tb, [
      ("x", None)
    ], None, None, fn_body)
    let expr = ELet("a", EInt(10), ELet("f", fn_expr, ECall(EIdent("f"), [
      EInt(5)
    ])))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(15)))
  } {
    Error(_) => assert(false)
  }
}

test "encode/decode fn preserves annotations" {
  let expr = EFn([
    "T"
  ], [
    ("T", [
      "Show"
    ])
  ], [
    ("x", Some(TyApp("Option", [
      TyName("Int")
    ]))),
    ("y", None)
  ], Some(TyTuple([
    TyName("String"),
    TyUnit
  ])), Some("Error"), EIdent("x"))
  match decode_expr(encode_expr(expr)) {
    EFn(type_params, bounds, params, ret_ty, effect, body) => {
      assert(eq(Array::length(type_params), 1))
      assert(Array::get(type_params, 0) == "T")
      assert(eq(Array::length(bounds), 1))
      let (bound_name, bound_traits) = Array::get(bounds, 0)
      assert(bound_name == "T")
      assert(eq(Array::length(bound_traits), 1))
      assert(Array::get(bound_traits, 0) == "Show")
      assert(eq(Array::length(params), 2))
      let (param_name, param_ty) = Array::get(params, 0)
      assert(param_name == "x")
      match param_ty {
        Some(inner_ty) => match inner_ty {
          TyApp(name, args) => {
            assert(name == "Option")
            assert(eq(Array::length(args), 1))
            match Array::get(args, 0) {
              TyName(inner) => assert(inner == "Int"),
              _ => assert(false)
            }
          },
          _ => assert(false)
        },
        _ => assert(false)
      }
      let (param2_name, param2_ty) = Array::get(params, 1)
      assert(param2_name == "y")
      match param2_ty {
        None => assert(true),
        _ => assert(false)
      }
      match ret_ty {
        Some(TyTuple(items)) => {
          assert(eq(Array::length(items), 2))
          match Array::get(items, 0) {
            TyName(name) => assert(name == "String"),
            _ => assert(false)
          }
          match Array::get(items, 1) {
            TyUnit => assert(true),
            _ => assert(false)
          }
        },
        _ => assert(false)
      }
      match effect {
        Some(effect_name) => assert(effect_name == "Error"),
        None => assert(false)
      }
      match body {
        EIdent(name) => assert(name == "x"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "encode/decode break preserves payload" {
  match decode_expr(encode_expr(EBreak(Some(EInt(42))))) {
    EBreak(Some(inner)) => match inner {
      EInt(n) => assert(eq(n, 42)),
      _ => assert(false)
    },
    _ => assert(false)
  }
}

test "encode/decode continue preserves payloads" {
  match decode_expr(encode_expr(EContinue([
    EInt(1),
    EString("x")
  ]))) {
    EContinue(args) => {
      assert(eq(Array::length(args), 2))
      match Array::get(args, 0) {
        EInt(n) => assert(eq(n, 1)),
        _ => assert(false)
      }
      match Array::get(args, 1) {
        EString(s) => assert(s == "x"),
        _ => assert(false)
      }
    },
    _ => assert(false)
  }
}

test "eval ETuple" {
  handle {
    let expr = ETuple([EInt(1), EInt(2)])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    match v {
      VTuple(items) => assert(eq(Array::length(items), 2)),
      _ => assert(false)
    }
  } {
    Error(_) => assert(false)
  }
}

test "eval EArray" {
  handle {
    let expr = EArray([EInt(10), EInt(20), EInt(30)])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(value_to_string(v) == "[10, 20, 30]")
  } {
    Error(_) => assert(false)
  }
}

test "eval EMatch with int patterns" {
  handle {
    let expr = EMatch(EInt(2), [
      (PInt(1), EString("one")),
      (PInt(2), EString("two")),
      (PWild, EString("other"))
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VString("two")))
  } {
    Error(_) => assert(false)
  }
}

test "eval EMatch with bind pattern" {
  handle {
    let expr = EMatch(EInt(42), [
      (PBind("x"), EBinOp("+", EIdent("x"), EInt(8)))
    ])
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(50)))
  } {
    Error(_) => assert(false)
  }
}

test "eval ELetRec factorial" {
  handle {
    // let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }; fact(5)
    let fact_body = EIf(
      EBinOp("<=", EIdent("n"), EInt(1)),
      EInt(1),
      EBinOp("*", EIdent("n"), ECall(EIdent("fact"), [EBinOp("-", EIdent("n"), EInt(1))]))
    )
    let fact_fn = EFn(_no_tp, _no_tb, [("n", None)], None, None, fact_body)
    let expr = ELetRec("fact", fact_fn, ECall(EIdent("fact"), [EInt(5)]))
    let (v, _) = eval_expr(expr, VEnvEmpty)
    assert(values_equal(v, VInt(120)))
  } {
    Error(_) => assert(false)
  }
}

