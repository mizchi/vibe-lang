//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

export let merge_purity = (a: Int, b: Int) -> Int {
  if a > b {
    a
  } else {
    b
  }
}

export let builtin_purity = (name: String) -> Int {
  if String::equals(name, "print")
  || String::equals(name, "println")
  || String::equals(name, "assert")
  || String::equals(name, "throw")
  || String::equals(name, "sh")
  || String::equals(name, "sh_lines")
  || String::equals(name, "Fs::read_file")
  || String::equals(name, "Fs::write_file")
  || String::equals(name, "Fs::exists")
  || String::equals(name, "Fs::stat_token")
  || String::equals(name, "Fs::readdir")
  || String::equals(name, "Fs::is_dir")
  || String::equals(name, "Fs::mkdir")
  || String::equals(name, "Fs::mkdir_p")
  || String::equals(name, "Fs::getcwd")
  || String::equals(name, "Fs::chdir")
  || String::equals(name, "Fs::remove")
  || String::equals(name, "Fs::is_file")
  || String::equals(name, "Fs::copy")
  || String::equals(name, "Fs::rename")
  || String::equals(name, "Fs::append")
  || String::equals(name, "Fs::write_bytes")
  || String::equals(name, "Env::get")
  || String::equals(name, "Env::args_len")
  || String::equals(name, "Env::args_get")
  || String::equals(name, "Http::request")
  || String::equals(name, "Http::listen")
  {
    2
  }
  else if String::equals(name, "Array::push")
  || String::equals(name, "Array::set")
  || String::equals(name, "Bytes::push")
  || String::equals(name, "Bytes::set")
  || String::equals(name, "ArrayBuilder::push")
  || String::equals(name, "StringBuilder::push")
  || String::equals(name, "MapBuilder::set")
  {
    1
  }
  else {
    0
  }
}

export let rec analyze_purity = (expr: Expr) -> Int {
  match expr {
    EInt(_) => 0,
    EFloat(_) => 0,
    EString(_) => 0,
    EBool(_) => 0,
    EUnit => 0,
    EIdent(_) => 0,
    EArray(elems) => {
      let mut result = 0
      let mut i = 0
      while i < Array::length(elems) {
        result = merge_purity(result, analyze_purity(Array::get(elems, i)))
        i = i + 1
      }
      result
    },
    ETuple(elems) => {
      let mut result = 0
      let mut i = 0
      while i < Array::length(elems) {
        result = merge_purity(result, analyze_purity(Array::get(elems, i)))
        i = i + 1
      }
      result
    },
    ERecord(fields) => {
      let mut result = 0
      let mut i = 0
      while i < Array::length(fields) {
        let (_, fval) = Array::get(fields, i)
        result = merge_purity(result, analyze_purity(fval))
        i = i + 1
      }
      result
    },
    ELet(_, val, body) => merge_purity(analyze_purity(val), analyze_purity(body)),
    ELetRec(_, val, body) => merge_purity(analyze_purity(val), analyze_purity(body)),
    ELetMut(_, val, body) => merge_purity(1, merge_purity(analyze_purity(val), analyze_purity(body))),
    EAssign(_, val, cont) => merge_purity(1, merge_purity(analyze_purity(val), analyze_purity(cont))),
    EAssignOp(_, _, val, cont) => merge_purity(1, merge_purity(analyze_purity(val), analyze_purity(cont))),
    ESeq(a, b) => merge_purity(analyze_purity(a), analyze_purity(b)),
    EIf(cond, then_e, else_e) => merge_purity(analyze_purity(cond), merge_purity(analyze_purity(then_e), analyze_purity(else_e))),
    EMatch(scrutinee, arms) => {
      let mut result = analyze_purity(scrutinee)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        result = merge_purity(result, analyze_purity(arm_body))
        i = i + 1
      }
      result
    },
    EHandle(body, arms) => {
      let mut result = analyze_purity(body)
      let mut i = 0
      while i < Array::length(arms) {
        let (_, arm_body) = Array::get(arms, i)
        result = merge_purity(result, analyze_purity(arm_body))
        i = i + 1
      }
      result
    },
    EWhile(cond, body) => merge_purity(1, merge_purity(analyze_purity(cond), analyze_purity(body))),
    ELoop(params, body) => {
      let mut result = 1
      let mut i = 0
      while i < Array::length(params) {
        let (_, init) = Array::get(params, i)
        result = merge_purity(result, analyze_purity(init))
        i = i + 1
      }
      merge_purity(result, analyze_purity(body))
    },
    EForIn(_, _, iter, body) => merge_purity(1, merge_purity(analyze_purity(iter), analyze_purity(body))),
    EBinOp(_, left, right) => merge_purity(analyze_purity(left), analyze_purity(right)),
    EUnaryOp(_, operand) => analyze_purity(operand),
    EFn(_, _, _, _, _, _) => 0,
    ECall(callee, args) => {
      let base = match callee {
        EIdent(name) => builtin_purity(name),
        _ => 2
      }
      let mut args_p = 0
      let mut i = 0
      while i < Array::length(args) {
        args_p = merge_purity(args_p, analyze_purity(Array::get(args, i)))
        i = i + 1
      }
      merge_purity(base, args_p)
    },
    EThrow(_) => 2,
    EDot(obj, _) => analyze_purity(obj),
    EBreak(_) => 1,
    EContinue(_) => 1,
    ELabeledArg(_, _, body) => analyze_purity(body),
    _ => 0
  }
}

export let is_pure = (expr: Expr) -> Bool {
  eq(analyze_purity(expr), 0)
}

export let is_local = (expr: Expr) -> Bool {
  analyze_purity(expr) <= 1
}

export let analyze_stmt_purity = (stmt: Stmt) -> Int {
  match stmt {
    SLet(_, _, _, _, body) => analyze_purity(body),
    SLetMut(_, _, body) => merge_purity(1, analyze_purity(body)),
    STest(_, body) => analyze_purity(body),
    SBench(_, body) => analyze_purity(body),
    SExpr(e) => analyze_purity(e),
    _ => 0
  }
}
