leb128_encode_u32(tag_content, 1)\n    bytebuf_push(tag_content, 0)\n    leb128_encode_u32(tag_content, 1)\n    bytebuf_push_section(out, 13, tag_content)\n  } else {\n    ()\n  }\n  if Array::length(gc_global_names_l) == 0 {\n    emit_global_section_i32_mut(out, heap_start)\n  } else {\n    // global 0: i32 mut heap pointer; globals 1..N: i64 mut computed values.\n    let g_content = bytebuf_new()\n    bytebuf_push_vec_header(g_content, 1 + Array::length(gc_global_names_l))\n    bytebuf_push(g_content, 127)\n    bytebuf_push(g_content, 1)\n    emit_i32_const(g_content, heap_start)\n    emit_end(g_content)\n    let mut ggi = 0\n    while ggi < Array::length(gc_global_names_l) {\n      bytebuf_push(g_content, 126)\n      bytebuf_push(g_content, 1)\n      emit_i64_const(g_content, 0)\n      emit_end(g_content)\n      ggi = ggi + 1\n    }\n    bytebuf_push_section(out, 6, g_content)\n  }\n  let start_func_idx = func_offset + num_user_funcs\n  // #538 P4.5: export the entry function and __heap_ptr alongside _start.\n  // The host runner's raw-ABI string allocation (args-get / env-get /\n  // fs_read_file results) heap-bumps through the exported __heap_ptr global;\n  // without it the runner falls back to an end-of-memory arena that the\n  // guest's own bump allocator grows into and clobbers mid-compile.\n  let export_content = bytebuf_new()\n  let export_entry_too = entry_name != \"_start\"\n  bytebuf_push_vec_header(export_content, if export_entry_too {\n    4\n  } else {\n    3\n  })\n  emit_name(export_content, \"_start\")\n  bytebuf_push(export_content, 0)\n  leb128_encode_u32(export_content, start_func_idx)\n  if export_entry_too {\n    emit_name(export_content, entry_name)\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, entry_func_idx)\n  } else {\n    ()\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  emit_name(export_content, \"__heap_ptr\")\n  bytebuf_push(export_content, 3)\n  leb128_encode_u32(export_content, 0)\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let table_func_indices = Array::slice([\n      0\n    ], 0, 0)\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, start_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\n    let num_ref_locals = Array::length(ref_indices)\n    if num_ref_locals == 0 {\n      if ni32 == 0 {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      }\n    } else {\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if Array::get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        // #538: ref cells are linear-memory cells now; every local is i64.\n        let _ = is_ref\n        bytebuf_push(func_buf, 126)\n        rli = rli + 1\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = Array::slice([\n      0\n    ], 0, 0)\n    let data_bufs = fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n")
}

let cli_adapter_source_106 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_expr.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, mut_needs_ref_cell\n}\n\nimport .. / common_base {\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, expr_tag, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, lookup_ctor, resolve_func, resolve_local, agg_info_of_ident, agg_log_reset_above, agg_ret_lookup, agg_slot_lookup, find_local_slot, struct_field_candidates, struct_field_dispatch_cases, struct_index_by_field_set, struct_tag_by_index\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_len_body, gc_gen_arr_new_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\nimport ./backend_call.vibe {\n  compile_call_gc\n}\n\nimport ./backend_lambda_body.vibe {\n  compile_lambda_gc\n}\n\nimport ./backend_match.vibe {\n  compile_match_gc\n}\n\n//# Functions\n\n// #538 P4.5: shape-based \"definitely scalar\" test for `==`/`!=` operands,\n// mirroring the linear lane's expr_is_intish literal/operator cases (the gc\n// lane has no checker types or local-type tracking, so only shapes count).\n// Anything else routes through the `eq` builtin, whose fall-back compares\n// packed (ptr<<32)|len strings by CONTENT — raw i64.eq made every\n// string-vs-string `==` a pointer compare, so the gc-compiled compiler failed\n// its own types_equal with \"return type mismatch: expected Int, got Int\".\nlet gc_expr_is_intish: (Expr) -> Bool = (e) -> {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EBinOp(op, _, _) => op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" || op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\",\n    EUnaryOp(op, _) => op == \"!\",\n    _ => false\n  }\n}\n\n// #538 P4.5: shape-based \"holds f64 raw bits\" test. Float literals,\n// int->float conversions, arithmetic over a floatish operand, and let-bound\n// locals recorded in ctx.gc_float_locals count; anything else (annotated\n// Double params, tuple-destructured floats) is best-effort untracked.\nlet rec gc_expr_is_floatish: (Expr, CompileCtxGc) -> Bool = (e, ctx) -> {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => array_contains_str(ctx.gc_float_locals, fname),\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(l, ctx) || gc_expr_is_floatish(r, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && gc_expr_is_floatish(x, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\n// #538 P4.5: is `e` syntactically a constructor value (ctor call or nullary\n// ctor ident)? Runtime values carry no type info, so — exactly like the\n// linear lane's emit_eq_value — the SHAPE of a literal operand decides the\n// structural comparison path for `==`/`!=`.\nlet gc_is_ctor_expr: (Expr, CompileCtxGc) -> Bool = (e, ctx) -> {\n  match e {\n    ECall(callee, _, _) => match callee {\n      EIdent(cname, _) => lookup_ctor(ctx.gc_ctor_table.names, cname, 0) >= 0,\n      _ => false\n    },\n    EIdent(iname, _) => lookup_ctor(ctx.gc_ctor_table.names, iname, 0) >= 0,\n    _ => false\n  }\n}\n\n// Structural equality for two tuples (gc layout: raw even ptr, element i at\n// ptr+i*8, no header). Ported from the linear emit_tuple_struct_eq; leaves a\n// raw i64 0/1. `cefn` is compile_expr_gc, threaded to avoid a forward ref.\nlet emit_gc_tuple_struct_eq: (Bytes, Expr, Expr, Int, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, num, local_names, next_local, ctx, ld, cefn) -> {\n  let aptr = next_local\n  Array::push(local_names, \"__gceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_local_set(buf, bptr)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\n// Structural equality for two ctor values (gc layout: value = ptr|1, tag i32\n// at +0, field i at +8+i*8): tags first, then field-wise `eq` (strings compare\n// by content there). The generic `eq` builtin compares ctor POINTERS — fresh\n// allocations are never bit-equal, which made the gc-compiled checker's\n// `Some(av) == rb` effect-row comparison (unify_effects) always false.\nlet emit_gc_ctor_struct_eq: (Bytes, Expr, Expr, Int, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, fc, local_names, next_local, ctx, ld, cefn) -> {\n  let aptr = next_local\n  Array::push(local_names, \"__gcceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__gcceqb\")\n  let nl1 = cefn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    // #724 round 2: DYNAMIC field count (fc 63 sentinel) — see the linear\n    // emit_ctor_struct_eq: equal tags imply equal argc, loop over argc@4.\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__gcceq_res\")\n    Array::push(local_names, \"__gcceq_cnt\")\n    Array::push(local_names, \"__gcceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\n// The equality value for `lhs == rhs` (raw i64 0/1 on the stack): tuple / ctor\n// literals get structural comparison, provably-scalar operands a raw i64.eq,\n// everything else the generic `eq` builtin (bit-equal fast path + string\n// content fall-back). Mirrors the linear lane's emit_eq_value routing.\nlet emit_gc_eq_value: (Bytes, Expr, Expr, Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, cefn) -> {\n  let lhs_is_tuple = match lhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  let rhs_is_tuple = match rhs {\n    ETuple(_) => true,\n    _ => false\n  }\n  // #724: aggregate shape of a bare-ident operand tracked at its `let`\n  // (kind*64+n, or -1) — mirrors the linear backend's emit_eq_value.\n  let lhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.gc_agg_local_slots, rhs, local_names)\n  if lhs_is_tuple || rhs_is_tuple {\n    let num = match lhs {\n      ETuple(les) => Array::length(les),\n      _ => match rhs {\n        ETuple(res) => Array::length(res),\n        _ => 0\n      }\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, num, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    let tn = if lhs_agg / 64 == 1 {\n      lhs_agg % 64\n    } else {\n      rhs_agg % 64\n    }\n    emit_gc_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, cefn)\n  } else if gc_is_ctor_expr(lhs, ctx) || gc_is_ctor_expr(rhs, ctx) {\n    let clit = if gc_is_ctor_expr(lhs, ctx) {\n      lhs\n    } else {\n      rhs\n    }\n    let cfc = match clit {\n      ECall(_, cargs, _) => Array::length(cargs),\n      _ => 0\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    // Tag comparison short-circuits unequal variants before any field read,\n    // so walking the larger tracked field count is safe (see the linear\n    // emit_eq_value for the argument).\n    let lfc = if lhs_agg / 64 == 2 {\n      lhs_agg % 64\n    } else {\n      0\n    }\n    let rfc = if rhs_agg / 64 == 2 {\n      rhs_agg % 64\n    } else {\n      0\n    }\n    let cfc = if lfc > rfc {\n      lfc\n    } else {\n      rfc\n    }\n    emit_gc_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, cefn)\n  } else if gc_expr_is_intish(lhs) || gc_expr_is_intish(rhs) {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = cefn(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = cefn(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nlet rec compile_expr_gc: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\n  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {\n    compile_expr_gc(b, e, ln, nl, ctx, d)\n  }\n  match expr {\n    EInt(n) => {\n      emit_i64_const(buf, n)\n      next_local\n    },\n    EBool(b_val) => {\n      emit_i64_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    },\n    EFloat(v) => {\n      let bits = Double::to_i64_bits(v)\n      emit_f64_const_bits(buf, bits)\n      emit_i64_reinterpret_f64(buf)\n      next_local\n    },\n    EString(s) => {\n      let idx = str_table_lookup(ctx.str_table.strs, s)\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n      next_local\n    },\n    EIdent(name, _) => {\n      let len = Array::length(local_names)\n      let rec try_local: (Int) -> Int = (i) -> {\n        if i < 0 {\n          -1\n        }\n        else if Array::get(local_names, i) == name {\n          i\n        }\n        else try_local(i - 1)\n      }\n      let local_idx = try_local(len - 1)\n      if local_idx >= 0 {\n        if array_contains_str(ctx.ref_cell_names, name) {\n          // #538: ref cells are 8-byte linear-memory cells (NOT wasm-gc\n          // structs): a (ref $t) value cannot cross the i64 world -- storing\n          // a captured cell into a closure env emitted invalid wasm.\n          emit_local_get(buf, local_idx)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 0)\n        } else {\n          emit_local_get(buf, local_idx)\n        }\n        next_local\n      } else {\n        let ctor_idx = lookup_ctor(ctx.gc_ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.gc_ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          // #415: gc-lane heap bump must grow linear memory like the linear\n          // backend does -- without this any allocation past the initial page\n          // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n          emit_heap_memory_grow_check(buf)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n          // #538: module-level literal constants (`let op_call = 16`).\n          let mut const_i = -1\n          let mut __gc = 0\n          while __gc < Array::length(ctx.gc_const_names) {\n            if Array::get(ctx.gc_const_names, __gc) == name {\n              const_i = __gc\n              __gc = Array::length(ctx.gc_const_names)\n            } else {\n              __gc = __gc + 1\n            }\n          }\n          if const_i >= 0 {\n            if Array::get(ctx.gc_const_kinds, const_i) == 1 {\n              let cs = Array::get(ctx.gc_const_svals, const_i)\n              let csi = str_table_lookup(ctx.str_table.strs, cs)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, csi), Array::get(ctx.str_table.lengths, csi))\n            } else {\n              emit_i64_const(buf, Array::get(ctx.gc_const_ivals, const_i))\n            }\n            return next_local\n          }\n          // #538: computed module-level global (mutable i64, init in _start).\n          let mut glob_i = -1\n          let mut __gg = 0\n          while __gg < Array::length(ctx.gc_global_names) {\n            if Array::get(ctx.gc_global_names, __gg) == name {\n              glob_i = __gg\n              __gg = Array::length(ctx.gc_global_names)\n            } else {\n              __gg = __gg + 1\n            }\n          }\n          if glob_i >= 0 {\n            emit_global_get(buf, 1 + glob_i)\n            return next_local\n          }\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut fni = -1\n          let mut __fj = 0\n          while __fj < fn_len {\n            if Array::get(ctx.func_table.names, __fj) == name {\n              fni = __fj\n              __fj = fn_len\n            } else {\n              __fj = __fj + 1\n            }\n          }\n          if fni < 0 {\n            throw(String::concat(\"undefined variable: \", name))\n          }\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n    },\n    EBinOp(op, lhs, rhs) => if op == \"&&\" || op == \"||\" {\n      // Short-circuit lowering (mirrors the linear lane): the emit_binop_op\n      // fallthrough's eager `i64.and`/`i64.or` evaluated BOTH operands, so\n      // `false && inc()` ran inc()'s side effects. gc-lane bools are raw\n      // 1/0 i64s; eqz treats any non-zero as true.\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = ce(buf, rhs, local_names, nl1, ld)\n        emit_else(buf)\n        emit_i64_const(buf, 1)\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" {\n      emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n    } else if op == \"!=\" {\n      let nle = emit_gc_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_gc)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nle\n    } else if (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (gc_expr_is_floatish(lhs, ctx) || gc_expr_is_floatish(rhs, ctx)) {\n      // Float arithmetic: locals hold raw f64 bits in i64; reinterpret both\n      // sides, run the f64 op, reinterpret back. The unconditional i64 ops\n      // below compute garbage on float bits (linear routes these through\n      // expr_is_floatish the same way).\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" {\n        emit_f64_add(buf)\n      } else if op == \"-\" {\n        emit_f64_sub(buf)\n      } else if op == \"*\" {\n        emit_f64_mul(buf)\n      } else {\n        emit_f64_div(buf)\n      }\n      emit_i64_reinterpret_f64(buf)\n      nl2\n    } else if (op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\") && (gc_expr_is_floatish(lhs, ctx) || gc_expr_is_floatish(rhs, ctx)) {\n      // Float ordering: signed-i64 compare of raw f64 bits inverts the order\n      // whenever both sides are negative (and misranks mixed signs vs -0.0),\n      // so route through real f64 comparisons (mirrors the linear lane).\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"<\" {\n        emit_f64_lt(buf)\n      } else if op == \">\" {\n        emit_f64_gt(buf)\n      } else if op == \"<=\" {\n        emit_f64_le(buf)\n      } else {\n        emit_f64_ge(buf)\n      }\n      emit_i64_extend_i32_s(buf)\n      nl2\n    } else {\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\n      emit_binop_op(buf, op)\n      nl2\n    },\n    EUnaryOp(op, operand) => if op == \"-\" && gc_expr_is_floatish(operand, ctx) {\n      // `0 - bits` integer-negates the f64 bit pattern; use f64.neg instead.\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_neg(buf)\n      emit_i64_reinterpret_f64(buf)\n      nl\n    } else if op == \"-\" {\n      emit_i64_const(buf, 0)\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if op == \"!\" {\n      let nl = ce(buf, operand, local_names, next_local, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n    ,\n    EIf(cond, then_e, else_e) => {\n      let nl1 = match cond {\n        EBinOp(cop, clhs, crhs) => if cop == \"==\" {\n          // #538 P4.5: `==`/`!=` route through emit_gc_eq_value (structural\n          // tuple/ctor compare, string content via the `eq` builtin); the\n          // result is shaped back into the raw comparison's i32 0/1.\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          cnl\n        } else if cop == \"!=\" {\n          let cnl = emit_gc_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr_gc)\n          emit_i64_eqz(buf)\n          cnl\n        } else if (cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\") && (gc_expr_is_floatish(clhs, ctx) || gc_expr_is_floatish(crhs, ctx)) {\n          // Same f64-vs-raw-bits ordering fix as the EBinOp float comparison\n          // branch; the fast path leaves the comparison's i32 for the `if`.\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else if cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        } else {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        },\n        EBool(b_val) => {\n          emit_i32_const(buf, if b_val {\n            1\n          } else {\n            0\n          })\n          next_local\n        },\n        _ => {\n          let cnl = ce(buf, cond, local_names, next_local, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      }\n      emit_if_i64(buf)\n      let ld_inner = if ld >= 0 {\n        ld + 1\n      } else {\n        -1\n      }\n      let names_len_before = Array::length(local_names)\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\n      emit_else(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\n      emit_end(buf)\n      Array::truncate(local_names, names_len_before)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_before)\n      let max_nl = if nl_then > nl_else {\n        nl_then\n      } else {\n        nl_else\n      }\n      while Array::length(local_names) < max_nl {\n        Array::push(local_names, \"\")\n      }\n      max_nl\n    },\n    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\n    ELet(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if gc_expr_is_floatish(value, ctx) {\n        Array::push(ctx.gc_float_locals, name)\n      } else {\n        ()\n      }\n      // #724: log this binding's aggregate shape for the structural `==`\n      // comparators — mirrors the linear ELet (compile_expr_tail.vibe).\n      let agg_entry = match value {\n        ETuple(tels) => 64 + Array::length(tels),\n        ERecord(rfields) => 128 + Array::length(rfields),\n        _ => if gc_is_ctor_expr(value, ctx) {\n          match value {\n            ECall(_, cargs, _) => {\n              let fcnt = if Array::length(cargs) == 1 {\n                match Array::get(cargs, 0) {\n                  ERecord(crf) => Array::length(crf),\n                  _ => Array::length(cargs)\n                }\n              } else {\n                Array::length(cargs)\n              }\n              128 + fcnt\n            },\n            _ => 128\n          }\n        } else {\n          match value {\n            EIdent(src_nm, _) => {\n              let src_slot = find_local_slot(local_names, src_nm)\n              if src_slot >= 0 {\n                let src_info = agg_slot_lookup(ctx.gc_agg_local_slots, src_slot)\n                if src_info > 0 {\n                  src_info\n                } else {\n                  0\n                }\n              } else {\n                0\n              }\n            },\n            ECall(vcal, _, _) => match vcal {\n              // #724 round 2: `let a = f(..)` — classify by f's DECLARED\n              // return type. Only for a global fn name (a local shadowing\n              // `f` makes this a closure call of unknown type).\n              EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n                let rinfo = agg_ret_lookup(ctx.gc_agg_ret_names, ctx.gc_agg_ret_infos, cfn)\n                if rinfo > 0 {\n                  rinfo\n                } else {\n                  0\n                }\n              } else {\n                0\n              },\n              _ => 0\n            },\n            _ => 0\n          }\n        }\n      }\n      Array::push(ctx.gc_agg_local_slots, local_idx * 256 + agg_entry)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetRec(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\n      emit_local_set(buf, local_idx)\n      match value {\n        EFn(_, _, params, _, _, fn_body) => {\n          let param_names_bp = Array::slice([\n            \"\"\n          ], 0, 0)\n          let mut bpi = 0\n          while bpi < Array::length(params) {\n            let (pn, _) = Array::get(params, bpi)\n            Array::push(param_names_bp, pn)\n            bpi = bpi + 1\n          }\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.gc_ctor_table.names))\n          let mut self_cap_idx = -1\n          let mut bci = 0\n          while bci < Array::length(caps) {\n            if Array::get(caps, bci) == name {\n              self_cap_idx = bci\n            }\n            bci = bci + 1\n          }\n          if self_cap_idx >= 0 {\n            emit_local_get(buf, local_idx)\n            emit_i64_const(buf, -4)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_local_get(buf, local_idx)\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n          }\n          0\n        },\n        _ => 0\n      }\n      ce(buf, body, local_names, nl, ld)\n    },\n    ELetMut(name, value, body) => {\n      let local_idx = next_local\n      Array::push(local_names, name)\n      if mut_needs_ref_cell(body, name) {\n        Array::push(ctx.ref_cell_names, name)\n        // Linear-memory cell: local = cell address (i64), value stored at +0.\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, local_idx)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_i64_store(buf, 3, 0)\n        Array::push(ctx.ref_local_indices, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      } else {\n        if gc_expr_is_floatish(value, ctx) {\n          Array::push(ctx.gc_float_locals, name)\n        } else {\n          ()\n        }\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\n        emit_local_set(buf, local_idx)\n        let nl2 = ce(buf, body, local_names, nl, ld)\n        nl2\n      }\n    },\n    EAssign(name, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_i64_store(buf, 3, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    EAssignOp(name, op, value, body) => {\n      let idx = resolve_local(local_names, name, \"gc_var\")\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_i64_store(buf, 3, 0)\n        ce(buf, body, local_names, nl, ld)\n      } else {\n        emit_local_get(buf, idx)\n        let nl = ce(buf, value, local_names, next_local, ld)\n        emit_assignop_op(buf, op)\n        emit_local_set(buf, idx)\n        ce(buf, body, local_names, nl, ld)\n      }\n    },\n    ESeq(first, second) => {\n      let nl_s = ce(buf, first, local_names, next_local, ld)\n      emit_drop(buf)\n      ce(buf, second, local_names, nl_s, ld)\n    },\n    ETuple(elems) => {\n      let num_elems = Array::length(elems)\n      let alloc_size = num_elems * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__tuple_ptr\")\n      let mut nl = next_local + 1\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      // #415: gc-lane heap bump must grow linear memory like the linear\n      // backend does -- without this any allocation past the initial page\n      // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n      emit_heap_memory_grow_check(buf)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    },\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\n    EArray(elems) => {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\n        if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    },\n    EForIn(var_name, index_name, iter_expr, body) => {\n      // #538 P4.5: `for x in xs { ... }` is an EXPRESSION (comprehension) —\n      // collect each body value into a fresh result array, exactly like the\n      // linear lane (compile_expr_tail2). The old statement-shaped loop\n      // DROPPED body values and yielded 0, so comprehension mappings like\n      // type_to_string's `let parts = for p in params { type_to_string(p) }`\n      // (and subst_apply's CtFn param map) produced EMPTY arrays when the\n      // gc-compiled compiler ran — every 1+-param function type resolved and\n      // printed as `()`, failing unify with \"expected X, got X\" diagnostics.\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_len_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let names_len_at_forin = Array::length(local_names)\n      let result_local = next_local\n      let arr_local = next_local + 1\n      let i_local = next_local + 2\n      Array::push(local_names, \"__forin_res\")\n      Array::push(local_names, \"__forin_arr\")\n      Array::push(local_names, \"__forin_i\")\n      if ctx.func_offset > 0 && arr_new_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, result_local)\n      let nl1 = ce(buf, iter_expr, local_names, next_local + 3, ld)\n      emit_local_set(buf, arr_local)\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_local)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_local)\n      emit_local_get(buf, arr_local)\n      if ctx.func_offset > 0 && arr_len_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_len_idx)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      let var_local = match index_name {\n        Some(idx_name) => {\n          emit_local_get(buf, i_local)\n          emit_local_set(buf, nl1)\n          Array::push(local_names, idx_name)\n          nl1 + 1\n        },\n        None => nl1\n      }\n      emit_local_get(buf, arr_local)\n      emit_local_get(buf, i_local)\n      if ctx.func_offset > 0 && arr_get_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_get_idx)\n      emit_local_set(buf, var_local)\n      Array::push(local_names, var_name)\n      let nl3 = var_local + 1\n      // Same innermost-loop ld reset as EWhile.\n      let nl4 = ce(buf, body, local_names, nl3, 0)\n      let body_val = nl4\n      Array::push(local_names, \"__forin_val\")\n      emit_local_set(buf, body_val)\n      emit_local_get(buf, result_local)\n      emit_local_get(buf, body_val)\n      if ctx.func_offset > 0 && arr_push_idx >= ctx.func_offset {\n        emit_i64_const(buf, 0)\n      } else {\n        ()\n      }\n      emit_call(buf, arr_push_idx)\n      emit_local_get(buf, i_local)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_local)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, result_local)\n      // Restore the outer name scope (loop-internal binds must not shadow\n      // later lookups) while preserving slot numbering — linear parity.\n      let final_nl = nl4 + 1\n      Array::truncate(local_names, names_len_at_forin)\n      agg_log_reset_above(ctx.gc_agg_local_slots, names_len_at_forin)\n      while Array::length(local_names) < final_nl {\n        Array::push(local_names, \"\")\n      }\n      final_nl\n    },\n    EWhile(cond, body) => {\n      // ld reset: a new loop is the new INNERMOST loop, so break/continue\n      // distances restart at 0 (mirrors the linear EWhile fix — the old\n      // `ld + 1` made an inner `break` jump to the OUTER loop header).\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      let nl1 = match cond {\n        EBinOp(wcop, wlhs, wrhs) => if wcop == \"==\" {\n          // #538 P4.5: same emit_gc_eq_value routing as the EIf fast path;\n          // each branch leaves the raw comparison's i32 0/1 shape so the\n          // shared i32_eqz inversion below applies uniformly.\n          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          wnl\n        } else if wcop == \"!=\" {\n          let wnl = emit_gc_eq_value(buf, wlhs, wrhs, local_names, next_local, ctx, 0, compile_expr_gc)\n          emit_i64_eqz(buf)\n          emit_i32_eqz(buf)\n          wnl\n        } else if (wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\") && (gc_expr_is_floatish(wlhs, ctx) || gc_expr_is_floatish(wrhs, ctx)) {\n          // Same f64-vs-raw-bits ordering fix as the EBinOp/EIf float\n          // comparison branches; leaves the i32 for the shared eqz below.\n          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)\n          emit_f64_reinterpret_i64(buf)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)\n          emit_f64_reinterpret_i64(buf)\n          if wcop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if wcop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n          let wnl1 = ce(buf, wlhs, local_names, next_local, 0)\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, 0)\n          if wcop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if wcop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if wcop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          emit_i32_eqz(buf)\n          wnl2\n        } else {\n          let wnl = ce(buf, cond, local_names, next_local, 0)\n          emit_i64_eqz(buf)\n          wnl\n        },\n        _ => {\n          let wnl = ce(buf, cond, local_names, next_local, 0)\n          emit_i64_eqz(buf)\n          wnl\n        }\n      }\n      emit_br_if(buf, 1)\n      let nl2 = ce(buf, body, local_names, nl1, 0)\n      emit_drop(buf)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl2\n    },\n    EBreak(_) => {\n      emit_br(buf, ld + 1)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EContinue(_) => {\n      emit_br(buf, ld)\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EUnit => {\n      emit_i64_const(buf, 0)\n      next_local\n    },\n    EThrow(msg_expr) => {\n      // #538: real wasm exception (tag 0, (i64) -> ()). The tag section is\n      // emitted whenever stmts_contain_exceptions holds (#721-style gating),\n      // which is guaranteed if this arm is ever reached.\n      let nl = ce(buf, msg_expr, local_names, next_local, ld)\n      bytebuf_push(buf, 8)\n      leb128_encode_u32(buf, 0)\n      nl\n    },\n    EReturn(ret_expr) => {\n      let nl = ce(buf, ret_expr, local_names, next_local, ld)\n      emit_return(buf)\n      nl\n    },\n    EFn(_, _, params, _, _, fn_body) =>\n    compile_lambda_gc(buf, params, fn_body, local_names, next_local, ctx, ld, compile_expr_gc),\n    EDot(obj, field, _) => {\n      // #538: numeric field = tuple index (`t.0`). gc tuples are raw untagged\n      // pointers with elements at i*8 (no header) -- see ETuple above.\n      let fc0 = String::char_code_at(field, 0)\n      if fc0 >= 48 && fc0 <= 57 {\n        let mut tidx = 0\n        let mut tp = 0\n        while tp < String::length(field) {\n          tidx = tidx * 10 + (String::char_code_at(field, tp) - 48)\n          tp = tp + 1\n        }\n        let nl_t = ce(buf, obj, local_names, next_local, ld)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, tidx * 8)\n        return nl_t\n      }\n      // #722: same struct-tag dispatch as the linear EDot path\n      // (compile_expr_tail4.vibe) — static load when every declaring struct\n      // agrees on the slot, runtime dispatch on the value's ctor tag when\n      // they disagree, first candidate as the untagged/legacy fallback.\n      let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n      if Array::length(cands) == 0 {\n        throw(String::concat(\"unknown struct field: \", field))\n      }\n      let (_, idx0) = Array::get(cands, 0)\n      let dispatch = struct_field_dispatch_cases(cands)\n      let nl1 = ce(buf, obj, local_names, next_local, ld)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      if Array::length(dispatch) == 0 {\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        nl1\n      } else {\n        let obj_l = nl1\n        Array::push(local_names, \"__dot_obj\")\n        emit_local_set(buf, obj_l)\n        let mut di = 0\n        while di < Array::length(dispatch) {\n          let (dtag, didx) = Array::get(dispatch, di)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, dtag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + didx * 8)\n          emit_else(buf)\n          di = di + 1\n        }\n        emit_local_get(buf, obj_l)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + idx0 * 8)\n        let mut de = 0\n        while de < Array::length(dispatch) {\n          emit_end(buf)\n          de = de + 1\n        }\n        nl1 + 1\n      }\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      // #722: resolve to a struct by exact field-name set; on a match, lay\n      // out in DECLARED field order and stamp the struct's ctor tag at\n      // value+0 (mirrors the linear backend and the `S::{...}` ctor path) so\n      // the tag-dispatching field access above stays type-correct.\n      let lit_names = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.gc_ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.gc_ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, rec_si)\n        let ordered = Array::slice([\n          (\"\", EUnit)\n        ], 0, 0)\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let obj_size = 8 + flen * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      // #415: gc-lane heap bump must grow linear memory like the linear\n      // backend does -- without this any allocation past the initial page\n      // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, rec_tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 4)\n      let mut nl_r = next_local + 1\n      let mut ri = 0\n      while ri < flen {\n        let (_, fexpr) = Array::get(rec_fields, ri)\n        nl_r = ce(buf, fexpr, local_names, nl_r, ld)\n        let val_local = nl_r\n        Array::push(local_names, \"__rec_val\")\n        emit_local_set(buf, val_local)\n        nl_r = nl_r + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + ri * 8)\n        ri = ri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_r\n    },\n    EHandle(body, harms) => {\n      // #538: Error-effect handler via try_table (no resume/replay: algebraic\n      // user effects still need the linear backend's memo machinery).\n      //   block (result i64)            ;; B_outer: success value\n      //     block (result i64)          ;; B_catch: thrown payload\n      //       try_table (result i64) [catch tag0 -> label 0]\n      //         <body>\n      //       end\n      //       br 1                       ;; success\n      //     end\n      //     <bind Throw(msg); handler>   ;; payload -> handler value\n      //   end\n      if Array::length(harms) == 0 {\n        ce(buf, body, local_names, next_local, ld)\n      } else {\n        let (hpat, hexpr) = Array::get(harms, 0)\n        let mut hpat_ok = false\n        match hpat {\n          PCtor(hname, _) => {\n            if hname == \"Error::Throw\" || hname == \"Throw\" {\n              hpat_ok = true\n            }\n          },\n          _ => ()\n        }\n        if !hpat_ok {\n          throw(\"GC codegen: only `with Error { Throw(..) => .. }` handlers are supported (algebraic effect handlers need the linear backend)\")\n        }\n        emit_block_i64(buf)\n        emit_block_i64(buf)\n        bytebuf_push(buf, 31)\n        bytebuf_push(buf, 126)\n        leb128_encode_u32(buf, 1)\n        bytebuf_push(buf, 0)\n        leb128_encode_u32(buf, 0)\n        leb128_encode_u32(buf, 0)\n        let body_ld = if ld >= 0 {\n          ld + 3\n        } else {\n          -1\n        }\n        let nl_b = ce(buf, body, local_names, next_local, body_ld)\n        emit_end(buf)\n        emit_br(buf, 1)\n        emit_end(buf)\n        // payload (i64) on stack: bind the Throw arg if the pattern names it.\n        let names_before_h = Array::length(local_names)\n        let mut nl_h = nl_b\n        match hpat {\n          PCtor(_, hargs) => {\n            if Array::length(hargs) > 0 {\n              match Array::get(hargs, 0) {\n                PBind(hbname) => {\n                  let hb_l = Array::length(local_names)\n                  emit_local_set(buf, hb_l)\n                  Array::push(local_names, hbname)\n                  if hb_l + 1 > nl_h {\n                    nl_h = hb_l + 1\n                  }\n                },\n                _ => emit_drop(buf)\n              }\n            } else {\n              emit_drop(buf)\n            }\n          },\n          _ => emit_drop(buf)\n        }\n        let harm_ld = if ld >= 0 {\n          ld + 1\n        } else {\n          -1\n        }\n        let nl_h2 = ce(buf, hexpr, local_names, Array::length(local_names), harm_ld)\n        emit_end(buf)\n        Array::truncate(local_names, names_before_h)\n        agg_log_reset_above(ctx.gc_agg_local_slots, names_before_h)\n        if nl_h2 > nl_h {\n          nl_h = nl_h2\n        }\n        nl_h\n      }\n    },\n    ELabeledArg(_, _, lval) => ce(buf, lval, local_names, next_local, ld),\n    EMap(mfields) => {\n      // #538: map literal -> the gc Map block layout used by MapBuilder/Map::*\n      // ([count@0][cap@4][key@8+i*16][val@16+i*16]); keys are string literals.\n      let mflen = Array::length(mfields)\n      let mcap = if mflen > 32 {\n        mflen\n      } else {\n        32\n      }\n      let malloc_size = 8 + mcap * 16\n      let mptr = next_local\n      Array::push(local_names, \"__maplit_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mptr)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, malloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_memory_grow_check(buf)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mflen)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, mptr)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, mcap)\n      emit_i32_store(buf, 2, 4)\n      let mut mnl = next_local + 1\n      let mut mi = 0\n      while mi < mflen {\n        let (mkey, mval) = Array::get(mfields, mi)\n        let mk_idx = str_table_lookup(ctx.str_table.strs, mkey)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        emit_str_ref(buf, Array::get(ctx.str_table.offsets, mk_idx), Array::get(ctx.str_table.lengths, mk_idx))\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, mptr)\n        emit_i32_wrap_i64(buf)\n        mnl = ce(buf, mval, local_names, mnl, ld)\n        emit_i64_store(buf, 3, 16 + mi * 16)\n        mi = mi + 1\n      }\n      emit_local_get(buf, mptr)\n      mnl\n    },\n    EStringInterp(_) => throw(\"GC codegen: EStringInterp must be resolved before codegen (call resolve_interp_stmts first)\"),\n    _ => throw(String::concat(\"unsupported expression in gc codegen: tag \", __to_string(expr_tag(expr))))\n  }\n}\n\n//# Misc\n\nexport {\n  compile_expr_gc\n}\n")
}

let cli_adapter_source_107 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_call.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, find_func_stmt, is_eident, lookup_ctor, resolve_func, resolve_local, struct_field_candidates, struct_field_dispatch_cases\n}\n\nimport .. / .. / builtin_name.vibe {\n  canonical_builtin_name\n}\n\nimport .. / double_to_string_expr.vibe {\n  double_to_string_expr\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_ecall_args, get_ecall_callee, get_eident_name, get_estring_value, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_len_body, gc_gen_arr_new_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\n//# Functions\n\n// #538: call a func-table-RESOLVED index. User functions (>= func_offset)\n// take a trailing closure-env i64 (callers pass 0); builtins/imports do not.\n// The flat bundle defines its own __to_string / String::join / eq etc., so a\n// resolve_func hit is NOT guaranteed to be a builtin -- every resolved call\n// must go through here or a user-shadowed builtin miscompiles with a missing\n// env argument (invalid wasm, \"expected i64 but nothing on stack\").\nlet emit_call_resolved: (Bytes, CompileCtxGc, Int) -> Unit = (buf, ctx, fidx) -> {\n  if ctx.func_offset > 0 && fidx >= ctx.func_offset {\n    emit_i64_const(buf, 0)\n  } else {\n    ()\n  }\n  emit_call(buf, fidx)\n}\n\n// #538 P4.5: resolve to the BUILTIN entry even when the compiled program\n// defines a top-level function of the same name (the compiler bundle has its\n// own `__to_string(Int)`). Builtins are appended AFTER user functions in the\n// func table, so the LAST match is the builtin. Interpolation's `__to_string`\n// must always hit the runtime string-vs-int dispatch body — routing it to the\n// program's decimal-only version rendered interpolated Strings as numbers.\nlet gc_resolve_builtin_last: (FuncTable, String) -> Int = (ft, name) -> {\n  let mut i = Array::length(ft.names) - 1\n  let mut found = -1\n  while i >= 0 {\n    if found < 0 && Array::get(ft.names, i) == name {\n      found = Array::get(ft.indices, i)\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  found\n}\n\n// Local mirror of backend_expr's gc_expr_is_floatish (backend_expr imports\n// this file, so importing it back would cycle — same precedent as the linear\n// lane's cc_expr_is_floatish mirror in expr/compile_call.vibe).\nlet rec bc_expr_is_floatish: (Expr, CompileCtxGc) -> Bool = (e, ctx) -> {\n  match e {\n    EFloat(_) => true,\n    EIdent(fname, _) => array_contains_str(ctx.gc_float_locals, fname),\n    EBinOp(op, l, r) => (op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\") && (bc_expr_is_floatish(l, ctx) || bc_expr_is_floatish(r, ctx)),\n    EUnaryOp(op, x) => op == \"-\" && bc_expr_is_floatish(x, ctx),\n    ECall(fcallee, _, _) => match fcallee {\n      EIdent(cn, _) => cn == \"Int::to_double\" || cn == \"Double::from_i64_bits\" || cn == \"Float::to_double\" || cn == \"Double::to_float\" || cn == \"Int::to_float\",\n      _ => false\n    },\n    _ => false\n  }\n}\n\nlet compile_call_gc: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {\n  match callee {\n    EIdent(fname, _) => {\n      let ctor_lookup_idx = lookup_ctor(ctx.gc_ctor_table.names, fname, 0)\n      if ctor_lookup_idx >= 0 {\n        let tag = Array::get(ctx.gc_ctor_table.tags, ctor_lookup_idx)\n        let fc = Array::get(ctx.gc_ctor_table.field_counts, ctor_lookup_idx)\n        let obj_size = 8 + fc * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        // #415: gc-lane heap bump must grow linear memory like the linear\n        // backend does -- without this any allocation past the initial page\n        // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n        emit_heap_memory_grow_check(buf)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let actual_args = if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ERecord(rec_fields) => {\n              let rec find_sn: (Int) -> Int = (sni) -> {\n                if sni >= Array::length(ctx.gc_ctor_table.struct_names) {\n                  -1\n                }\n                else if Array::get(ctx.gc_ctor_table.struct_names, sni) == fname {\n                  sni\n                }\n                else find_sn(sni + 1)\n              }\n              let sn_idx = find_sn(0)\n              if sn_idx >= 0 {\n                let def_fnames = Array::get(ctx.gc_ctor_table.struct_field_names, sn_idx)\n                let ordered = Array::slice([\n                  EUnit\n                ], 0, 0)\n                let mut oi = 0\n                while oi < Array::length(def_fnames) {\n                  let target_name = Array::get(def_fnames, oi)\n                  let rec find_rf: (Int) -> Expr = (ri) -> {\n                    if ri >= Array::length(rec_fields) {\n                      EUnit\n                    }\n                    else {\n                      let (rfn, rfv) = Array::get(rec_fields, ri)\n                      if rfn == target_name {\n                        rfv\n                      }\n                      else find_rf(ri + 1)\n                    }\n                  }\n                  Array::push(ordered, find_rf(0))\n                  oi = oi + 1\n                }\n                ordered\n              } else {\n                args\n              }\n            },\n            _ => args\n          }\n        } else {\n          args\n        }\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n      else if fname == \"__slice\" {\n        let (ss_idx, _, _) = resolve_func(ctx.func_table, \"String::substring\")\n        let (bs_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::slice\")\n        let (as_idx, _, _) = resolve_func(ctx.func_table, \"Array::slice\")\n        let obj_local = next_local\n        let start_local = next_local + 1\n        let end_local = next_local + 2\n        let ptr_local = next_local + 3\n        let cap_local = next_local + 4\n        Array::push(local_names, \"__slice_obj\")\n        Array::push(local_names, \"__slice_start\")\n        Array::push(local_names, \"__slice_end\")\n        Array::push(local_names, \"__slice_ptr\")\n        Array::push(local_names, \"__slice_cap\")\n        let mut nl = next_local + 5\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, start_local)\n        nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n        emit_local_set(buf, end_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, bs_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, as_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, start_local)\n        emit_local_get(buf, end_local)\n        emit_call_resolved(buf, ctx, ss_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__index\" {\n        let (sg_idx, _, _) = resolve_func(ctx.func_table, \"String::char_code_at\")\n        let (bg_idx, _, _) = resolve_func(ctx.func_table, \"Bytes::get\")\n        let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n        let obj_local = next_local\n        let idx_local = next_local + 1\n        let ptr_local = next_local + 2\n        let cap_local = next_local + 3\n        Array::push(local_names, \"__index_obj\")\n        Array::push(local_names, \"__index_idx\")\n        Array::push(local_names, \"__index_ptr\")\n        Array::push(local_names, \"__index_cap\")\n        let mut nl = next_local + 4\n        nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n        emit_local_set(buf, obj_local)\n        nl = ce(buf, Array::get(args, 1), local_names, nl, ld)\n        emit_local_set(buf, idx_local)\n        emit_local_get(buf, obj_local)\n        emit_i64_const(buf, 32)\n        emit_i64_shr_s(buf)\n        emit_i64_eqz(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, cap_local)\n        emit_local_get(buf, cap_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 2147483647)\n        emit_i32_gt_u(buf)\n        emit_if_i64(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, bg_idx)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, ag_idx)\n        emit_end(buf)\n        emit_else(buf)\n        emit_local_get(buf, obj_local)\n        emit_local_get(buf, idx_local)\n        emit_call_resolved(buf, ctx, sg_idx)\n        emit_end(buf)\n        nl\n      }\n      else if fname == \"__set_field\" {\n        let field = get_estring_value(Array::get(args, 1))\n        let fc = String::char_code_at(field, 0)\n        let is_numeric = fc >= 48 && fc <= 57\n        if is_numeric {\n          let mut vi = 0\n          let mut vp = 0\n          while vp < String::length(field) {\n            vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n            vp = vp + 1\n          }\n          let mut nl = next_local\n          nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n          emit_i64_store(buf, 3, vi * 8)\n          emit_i64_const(buf, 1)\n          nl\n        } else {\n          // #722: same struct-tag dispatch as the linear __set_field — a\n          // same-named `mut` field can live at a different slot in another\n          // struct, and the static first-match store would corrupt it.\n          let cands = struct_field_candidates(ctx.gc_ctor_table, field)\n          if Array::length(cands) == 0 {\n            throw(String::concat(\"unknown struct field: \", field))\n          }\n          let (_, idx0) = Array::get(cands, 0)\n          let dispatch = struct_field_dispatch_cases(cands)\n          if Array::length(dispatch) == 0 {\n            let mut nl = next_local\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            nl = ce(buf, Array::get(args, 2), local_names, nl, ld)\n            emit_i64_store(buf, 3, 8 + idx0 * 8)\n            emit_i64_const(buf, 1)\n            nl\n          } else {\n            let mut nl = next_local\n            nl = ce(buf, Array::get(args, 0), local_names, nl, ld)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            let obj_l = nl\n            Array::push(local_names, \"__setf_obj\")\n            emit_local_set(buf, obj_l)\n            nl = ce(buf, Array::get(args, 2), local_names, nl + 1, ld)\n            let val_l = nl\n            Array::push(local_names, \"_