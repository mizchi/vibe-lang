"//# Imports\n\nimport .. / .. / core {\n  Expr\n}\n\nimport .. / common_base {\n  CompileCtxGc\n}\n\n//# Types\n\nexport type CompileLambdaGcFn = (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\n")
