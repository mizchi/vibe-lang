let cli_adapter_source_112 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_lambda_body.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, TypeExpr\n}\n\nimport .. / common_base {\n  CompileCtxGc\n}\n\nimport ./backend_lambda_collect.vibe {\n  collect_lambda_captures_gc\n}\n\nimport ./backend_lambda_emit.vibe {\n  emit_lambda_closure_gc\n}\n\nimport ./backend_lambda_inner.vibe {\n  compile_lambda_inner_gc\n}\n\nimport ./backend_lambda_record.vibe {\n  record_lambda_meta_gc\n}\n\nimport ./backend_lambda_sig.vibe {\n  CompileLambdaGcFn\n}\n\n//# Functions\n\nexport let compile_lambda_gc: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, Int, CompileLambdaGcFn) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\n}\n")
}

let cli_adapter_source_113 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_lambda_collect.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, TypeExpr\n}\n\nimport .. / common_analysis {\n  collect_free_vars\n}\n\nimport .. / common_base {\n  CompileCtxGc, CtorTable, FuncTable\n}\n\n//# Functions\n\nexport let collect_lambda_captures_gc: (Array[(String, Option[TypeExpr])], Expr, CompileCtxGc) -> (Array[String], Int, Int) = (params, fn_body, ctx) -> {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let func_table = ctx.func_table\n  let ctor_table = ctx.gc_ctor_table\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let mut globals = Array::concat(func_table.names, ctor_table.names)\n  // #538: names that resolve globally must not be captured as env slots --\n  // module-level literal constants and the call-site-only desugar builtins\n  // (handled by name in compile_call_gc, absent from the func table).\n  globals = Array::concat(globals, ctx.gc_const_names)\n  globals = Array::concat(globals, ctx.gc_global_names)\n  globals = Array::concat(globals, [\n    \"__index\",\n    \"__len\",\n    \"__set_field\",\n    \"__set_index\",\n    \"__slice\",\n    \"__rec_field\"\n  ])\n  let captures = collect_free_vars(fn_body, param_names_arr, globals)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  (captures, num_captures, user_params)\n}\n")
}

let cli_adapter_source_114 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_lambda_inner.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, TypeExpr, bytebuf_new\n}\n\nimport .. / common_base {\n  CompileCtxGc, emit_i64_load\n}\n\nimport .. / common_extractors {\n  array_contains_str\n}\n\nimport .. / wasm_emit {\n  emit_i32_wrap_i64, emit_local_get, emit_local_set\n}\n\nimport ./backend_lambda_ctx.vibe {\n  make_lambda_ctx_gc\n}\n\nimport ./backend_lambda_sig.vibe {\n  CompileLambdaGcFn\n}\n\n//# Functions\n\nexport let compile_lambda_inner_gc: (Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtxGc, CompileLambdaGcFn, Int) -> (Bytes, Int) with { Error } = (params, fn_body, captures, user_params, ctx, compile_fn, ld) -> {\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_ref_local_indices = Array::slice([\n    0\n  ], 0, 0)\n  let num_captures = Array::length(captures)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\n  // #744 (gc mirror of the linear lam_float_slots seeding): annotated\n  // Float/Double params join the fresh scope's float tracking, so closure\n  // bodies get real f64 arithmetic/comparisons and the Double __to_string\n  // formatter instead of raw-bits integer ops.\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (lfs_name, lfs_ann) = Array::get(params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_ctx.gc_float_locals, lfs_name)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\n  (lam_buf, final_lam_nl)\n}\n")
}

let cli_adapter_source_115 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_lambda_record.vibe",
"//# Imports\n\nimport .. / common_base {\n  CompileCtxGc, LambdaTable\n}\n\n//# Functions\n\nexport let record_lambda_meta_gc: (CompileCtxGc, Bytes, Int, Array[String], Int) -> Int = (ctx, lam_buf, user_params, captures, final_lam_nl) -> {\n  let lambda_table = ctx.lambda_table\n  let lambda_idx = Array::length(lambda_table.bodies)\n  Array::push(lambda_table.bodies, lam_buf)\n  Array::push(lambda_table.param_counts, user_params + 1)\n  Array::push(lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if final_lam_nl > min_lam_nl {\n    extra_lam = final_lam_nl - min_lam_nl\n  }\n  Array::push(lambda_table.meta_i32, 0)\n  Array::push(lambda_table.meta_i64, extra_lam)\n  lambda_idx\n}\n")
}

