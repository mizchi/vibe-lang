Array::get(args, 0), local_names, next_local, ctx, ld)\n      let box_l = nl\n      let byte_l = nl + 1\n      Array::push(local_names, \"__v128_box\")\n      Array::push(local_names, \"__v128_byte\")\n      // stack: nval (i64). Save it; wrap to i32 only when feeding i8x16.splat.\n      emit_local_set(buf, byte_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, byte_l)\n      // #705: untag n under RC (see v128_load above) -- otherwise the low byte\n      // fed to i8x16.splat is n's tag bit, not n itself (e.g. splat(0xFF)\n      // would broadcast 0xFE).\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i8x16_splat(buf)\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 2\n    }\n    else if !prefer_bound_call && (fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\") {\n      // Binary (V128, V128) -> V128. Load both operands from their boxes, emit\n      // the op, box the result.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let b_l = nl\n      let a_l = nl + 1\n      let box_l = nl + 2\n      Array::push(local_names, \"__v128_b\")\n      Array::push(local_names, \"__v128_a\")\n      Array::push(local_names, \"__v128_box\")\n      emit_local_set(buf, b_l)\n      emit_local_set(buf, a_l)\n      // box-alloc 16\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      // box.store(op(load(a), load(b)))\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, a_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_local_get(buf, b_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      if fname == \"v128_eq_i8x16\" {\n        emit_i8x16_eq(buf)\n      } else if fname == \"v128_le_u_i8x16\" {\n        emit_i8x16_le_u(buf)\n      } else if fname == \"v128_ge_u_i8x16\" {\n        emit_i8x16_ge_u(buf)\n      } else if fname == \"v128_and\" {\n        emit_v128_and(buf)\n      } else {\n        emit_v128_or(buf)\n      }\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(buf, box_l)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"v128_not\" {\n      // v128_not(v) -> V128.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let v_l = nl\n      let box_l = nl + 1\n      Array::push(local_names, \"__v128_v\")\n      Array::push(local_names, \"__v128_box\")\n      emit_local_set(buf, v_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, box_l)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, box_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, v_l)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_not(buf)\n      emit_v128_store(buf, 0, 0)\n      emit_local_get(bu