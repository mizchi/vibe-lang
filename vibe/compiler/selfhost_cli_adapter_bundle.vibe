Option[Type] = (name) -> {\n  match lookup_string_builder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_string_builder_push(name) {\n      Some(t) => Some(t),\n      None => lookup_string_builder_freeze(name)\n    }\n  }\n}\n")
