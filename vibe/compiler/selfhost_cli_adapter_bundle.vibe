net(normalized) {\n                        Some(t) => Some(t),\n                        None => match lookup_misc(normalized) {\n                          Some(t) => Some(t),\n                          None => lookup_async(normalized)\n                        }\n                      }\n                    }\n                  }\n                }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")
