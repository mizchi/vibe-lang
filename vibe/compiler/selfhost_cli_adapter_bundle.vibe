t(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 2)\n  emit_end(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_i64_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 10)\n  emit_i64_rem_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 48)\n  emit_i32_add(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 10)\n  emit_i64_div_s(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_if_void(b)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 45)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 2)\n  emit_end(b)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 47)\n  emit_local_get(b, 2)\n  emit_i32_sub(b)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  b\n}\n\nexport let gen_print_str_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 1)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  b\n}\n\nexport let gen_arr_concat_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 5)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 6)\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 7)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_local_set(b, 8)\n  emit_global_get(b, 0)\n  emit_local_tee(b, 9)\n  emit_i32_const(b, 12)\n  emit_local_get(b, 8)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_i32_add(b)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 9)\n  emit_local_get(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 9)\n  emit_local_get(b, 8)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, 9)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_local_set(b, 10)\n  emit_local_get(b, 9)\n  emit_local_get(b, 10)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 10)\n  emit_local_get(b, 6)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_memory_copy(b)\n  emit_local_get(b, 10)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_i32_add(b)\n  emit_local_get(b, 7)\n  emit_local_get(b, 5)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_memory_copy(b)\n  emit_local_get(b, 9)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gen_str_concat_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_local_set(b, 7)\n  emit_global_get(b, 0)\n  emit_local_tee(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, -8)\n  bytebuf_push(b, 113)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 4)\n  emit_local_get(b, 2)\n  emit_memory_copy(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 2)\n  emit_i32_add(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 3)\n  emit_memory_copy(b)\n  emit_local_get(b, 6)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 7)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\n// String::join(arr, sep): single-allocation O(n) join.\n//\n// Strings are represented inline as the i64 (ptr << 32) | len (see\n// gen_str_concat_body); the bytes live at ptr in the bump heap. The previous\n// implementation accumulated `acc = concat(acc, sep); acc = concat(acc,\n// arr[i])`, which copied the whole prefix each step — O(n^2) time and O(n^2)\n// bump garbage (the streaming bench's dominant cost, and an OOM/out-of-bounds\n// risk at ~4 KB; see scripts/bench_streaming.sh). Instead: pass 1 sums the\n// total length, allocate the result once, pass 2 memcpy's each piece (and the\n// separator) into place — O(n). This also speeds up StringBuilder::freeze,\n// which lowers to String::join(parts, \"\").\n//\n// Locals (params 0=arr, 1=sep are i64): i32 group [2..10] = n, i, total,\n// sep_len, sep_ptr, base, pos, cur_ptr, cur_len; i64 group [11] = cur. Keep\n// meta_i32=9 / meta_i64=1 in linked_compile in sync. arr_len/arr_get use the\n// untagged convention (matching the prior body); ptr/len are extracted exactly\n// as gen_str_concat_body does.\nexport let gen_string_join_body: (Int, Int, Int) -> Bytes = (arr_len_idx, arr_get_idx, str_concat_idx) -> {\n  let _ = str_concat_idx\n  let b = bytebuf_new()\n  // n = arr_len(arr)\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // empty array -> empty string (0)\n  emit_local_get(b, 2)\n  emit_i32_eqz(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  // sep_len = lo32(sep); sep_ptr = hi32(sep)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 6)\n  // pass 1: total = sum of len(arr[i])\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, arr_get_idx)\n  emit_local_set(b, 11)\n  emit_local_get(b, 4)\n  emit_local_get(b, 11)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // total += sep_len * (n - 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  // base = bump(total); pos = base\n  emit_global_get(b, 0)\n  emit_local_tee(b, 7)\n  emit_local_get(b, 4)\n  emit_i32_add(b)\n  emit_i32_const(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, -8)\n  bytebuf_push(b, 113)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 7)\n  emit_local_set(b, 8)\n  // pass 2: copy sep (when i>0) then arr[i] bytes\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  // if i != 0