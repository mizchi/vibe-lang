me) {\n          Some(t) => Some(t),\n          None => lookup_misc_group_e(name)\n        }\n      }\n    }\n  }\n}\n\n\n\nlet no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet one_param: (Type) -> Array[Type] = (a) -> {\n  let arr = no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet two_params: (Type, Type) -> Array[Type] = (a, b) -> {\n  let arr = no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\n  let arr = no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nlet lookup_http_close: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::close\" {\n    Some(CtFn(one_param(CtUnknown), CtUnit, Some(\"HttpServer\")))\n  }\n  else None\n}\n\nlet lookup_http_accept: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::accept\" {\n    Some(CtFn(one_param(CtUnknown), CtUnknown, Some(\"HttpServer\")))\n  }\n  else None\n}\n\nlet lookup_http_listen: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::listen\" {\n    Some(CtFn(two_params(CtString, CtInt), CtUnknown, Some(\"HttpServer\")))\n  }\n  else None\n}\n\nlet lookup_http_request: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::request\" {\n    Some(CtFn(two_params(CtString, CtString), CtUnknown, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_http_respond: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::respond\" {\n    Some(CtFn(three_params(CtUnknown, CtInt, CtString), CtUnit, Some(\"HttpServer\")))\n  }\n  else None\n}\n\nlet lookup_socket_tcp_read: (String) -> Option[Type] = (name) -> {\n  if name == \"Socket::tcp_read\" {\n    Some(CtFn(two_params(CtUnknown, CtInt), CtString, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nlet lookup_socket_tcp_close: (String) -> Option[Type] = (name) -> {\n  if name == \"Socket::tcp_close\" {\n    Some(CtFn(one_param(CtUnknown), CtUnit, Some(\"TcpS