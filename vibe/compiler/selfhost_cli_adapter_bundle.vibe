Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nlet lookup_socket_tcp_write: (String) -> Option[Type] = (name) -> {\n  if name == \"Socket::tcp_write\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtInt, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nlet lookup_http_response_body: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::response_body\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_socket_tcp_connect: (String) -> Option[Type] = (name) -> {\n  if name == \"Socket::tcp_connect\" {\n    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nlet lookup_net_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_socket_tcp_connect(name) {\n    Some(t) => Some(t),\n    None => match lookup_socket_tcp_read(name) {\n      Some(t) => Some(t),\n      None => match lookup_socket_tcp_write(name) {\n        Some(t) => Some(t),\n        None => lookup_socket_tcp_close(name)\n      }\n    }\n  }\n}\n\nlet lookup_http_request_header: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::request_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nlet lookup_net_group_d: (String) -> Option[Type] = (name) -> {\n  match lookup_http_request_header(name) {\n    Some(t) => Some(t),\n    None => lookup_http_respond(name)\n  }\n}\n\nlet lookup_http_request_method: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::request_method\" {\n    Some(CtFn(net_one_param(CtUnknown), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nlet lookup_net_group_c: (String) -> Option[Type] = (name) -> {\n  match lookup_http_close(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_listen(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_accept(name) {\n        Some(t) => Some(t),\n        None => lookup_http_request_method(name)\n      }\n    }\n  }\n}\n\nlet lookup_http_response_header: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::response_header\" {\n    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_http_response_status: (String) -> Option[Type] = (name) -> {\n  if name == \"Http::response_status\" {\n    Some(CtFn(net_one_param(CtUnknown), CtInt, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_net_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_http_request(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_response_status(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_response_header(name) {\n        Some(t) => Some(t),\n        None => lookup_http_response_body(name)\n      }\n    }\n  }\n}\n\nexport let lookup_net: (String) -> Option[Type] = (name) -> {\n  match lookup_net_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_net_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_net_group_c(name) {\n        Some(t) => Some(t),\n        None => lookup_net_group_d(name)\n      }\n    }\n  }\n}\n")
