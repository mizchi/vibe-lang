"//# Imports\n\nimport .. / .. / core {\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string\n}\n\n//# Functions\n\nlet emit_ascii_payload: (Bytes, String) -> Unit = (buf, text) -> {\n  let len = String::length(text)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(text, i))\n    i = i + 1\n  }\n}\n\nexport let emit_vibe_abi_custom_section: (Bytes, String) -> Unit = (out, host_import_abi) -> {\n  let content = bytebuf_new()\n  bytebuf_push_string(content, \"vibe.abi\")\n  emit_ascii_payload(content, \"version=1\\n\")\n  emit_ascii_payload(content, String::concat(\"host_import_abi=\", host_import_abi))\n  emit_ascii_payload(content, \"\\n\")\n  bytebuf_push_section(out, 0, content)\n}\n")
}

