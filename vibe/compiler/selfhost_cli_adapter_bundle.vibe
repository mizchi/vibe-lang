{\n        nl = ce(buf, op_expr, local_names, nl, ctx, ld)\n      } else if expr_tag(op_expr) == 8 {\n        let op_args = get_ecall_args(op_expr)\n        if Array::length(op_args) > 1 {\n          // Multi-value payload (#548): pack all op args into a tuple (one heap\n          // ref threaded as the single thrown value); the handler arm pattern\n          // destructures it element-by-element in compile_expr_tail6.\n          nl = ce(buf, ETuple(op_args), local_names, nl, ctx, ld)\n        } else if Array::length(op_args) > 0 {\n          nl = ce(buf, Array::get(op_args, 0), local_names, nl, ctx, ld)\n        } else {\n          emit_i64_const(buf, 0)\n        }\n      } else {\n        emit_i64_const(buf, 0)\n      }\n      bytebuf_push(buf, 8)\n      bytebuf_push(buf, eff_tag)\n      emit_end(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"path\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"__float_bits\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Int::to_string\" && Array::length(args) == 1 {\n      // Cheatsheet-documented alias of the integer `__to_string` path (the\n      // argument is Int by signature, so the string-pointer heuristic's int\n      // route applies).\n      ce(buf, ECall(EIdent(\"__to_string\", -1), [\n        Array::get(args, 0)\n      ], -1), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Fs::readdir\" && Array::length(args) == 1 {\n      // #729/#730: readdir's surface is Array[String], but the host import\n      // (`__fs_read_dir_raw`, linked_compile) returns the byte-sorted entry\n      // names \"\\n\"-joined as ONE packed string (same ABI as fs_read_file —\n      // no host-side array building, RC/bump agnostic). Lower to ordinary\n      // AST so String::split's codegen does the array work. An empty dir\n      // returns \"\" which must yield [] — but spli