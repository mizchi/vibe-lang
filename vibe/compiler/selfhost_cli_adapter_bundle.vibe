   emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_exists\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_stat_token_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_stat_token\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_write_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  if fs_write_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  if profiler_now_us_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"profile-now-us\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  let mut li_emit = 0\n  while li_emit < Array::length(linked_imports) {\n    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)\n    emit_name(import_content, lmod)\n    emit_name(import_content, lfn)\n    bytebuf_push(import_content, 0)\n    let type_idx = num_base_types + lparams\n    leb128_encode_u32(import_content, type_idx)\n    li_emit = li_emit + 1\n  }\n  bytebuf_push_section(out, 2, import_content)\n  let func_type_indices = lc_fresh_int_array()\n  Array::push(func_type_indices, 1)\n  Array::push(func_type_indices, 1)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 5)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 7)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 8)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 8)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 5)\n  Array::push(func_type_indices, 5)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 7)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 8)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 3)\n  if enable_rc {\n    Array::push(func_type_indices, 1)\n    Array::push(func_type_indices, 3)\n  } else {\n    ()\n  }\n  Array::push(func_type_indices, 2)\n  Array::push(func_type_indices, 8)\n  Array::push(func_type_indices, 8)\n  Array::push(func_type_indices, 8)\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(fn_param_counts, fti)\n    Array::push(func_type_indices, num_base_types + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  Array::push(func_type_indices, 5)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, num_base_types + lam_user_params)\n    lfi = lfi + 1\n  }\n  if Array::length(func_type_indices) != Array::length(bodies) {\n    throw(\"WASI codegen internal error: function section and code section count mismatch\")\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve))\n  let tag_content = bytebuf_new()\n  let num_tags = Array::length(effect_names_list) + 4\n  bytebuf_push_vec_header(tag_content, num_tags)\n  let mut tag_emit_i = 0\n  while tag_emit_i < num_tags {\n    bytebuf_push(tag_content, 0)\n    leb128_encode_u32(tag_content, 1)\n    tag_emit_i = tag_emit_i + 1\n  }\n  bytebuf_push_section(out, 13, tag_content)\n  let global_content = bytebuf_new()\n  if enable_rc {\n    bytebuf_push_vec_header(global_content, 6)\n  } else {\n    bytebuf_push_vec_header(global_content, 5)\n  }\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start + eff_reserve)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  if enable_rc {\n    bytebuf_push(global_content, 127)\n    bytebuf_push(global_content, 1)\n    emit_i32_const(global_content, 0)\n    emit_end(global_content)\n  }\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 126)\n  bytebuf_push(global_content, 1)\n  emit_i64_const(global_content, 0)\n  emit_end(global_content)\n  bytebuf_push(global_content, 127)\n  bytebuf_push(global_content, 1)\n  emit_i32_const(global_content, heap_start)\n  emit_end(global_content)\n  bytebuf_push_section(out, 6, global_content)\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  let all_export_names = lc_fresh_string_array()\n  let all_export_indices = lc_fresh_int_array()\n  if !library_mode {\n    Array::push(all_export_names, \"_start\")\n    Array::push(all_export_indices, start_func_idx)\n  }\n  if !library_mode && !array_contains_str(all_export_names, entry_name) {\n    Array::push(all_export_names, entry_name)\n    Array::push(all_export_indices, entry_func_idx)\n  }\n  let mut exi = 0\n  while exi < Array::length(export_fn_names) {\n    let ename = Array::get(export_fn_names, exi)\n    let skip_export = library_mode && ename == entry_name\n    if !skip_export && !array_contains_str(all_export_names, ename) {\n      Array::push(all_export_names, ename)\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  let export_content = bytebuf_new()\n  let export_count = Array::length(all_export_names) + 1 +\n  (if library_mode {\n    0\n  } else {\n    1 + 1\n  })\n  bytebuf_push_vec_header(export_content, export_count)\n  let mut efi = 0\n  while efi < Array::length(all_export_names) {\n    emit_name(export_content, Array::get(all_export_names, efi))\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\n    efi = efi + 1\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  if !library_mode {\n    emit_name(export_content, \"__heap_ptr\")\n    bytebuf_push(export_content, 3)\n    leb128_encode_u32(export_content, 0)\n    emit_name(export_content, \"error\")\n    bytebuf_push(export_content, 4)\n    leb128_encode_u32(export_content, 0)\n  }\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let table_func_indices = lc_fresh_int_array()\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    if ni32 == 0 {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 0)\n      } else {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n      }\n    } else {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n      } else {\n        leb128_encode_u32(func_buf, 2)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = lc_fresh_int_array()\n    let data_bufs = lc_fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n\nexport let compile_wasi_module_rc_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts_in, entry_name) -> {\n  let stmts = elaborate_heap_params(stmts_in)\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\n    (\"\", \"\")\n  ], 0, 0), Array::slice([\n    (\"\", \"\", 0, 0)\n  ], 0, 0), false, true)\n}\n\nexport let compile_wasi_module_with_sources_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\n    (\"\", \"\", 0, 0)\n  ], 0, 0), false, false)\n}\n\n\n\nexport {\n  compile_wasi_module_linked_impl,\n  compile_wasi_module_with_sources_impl,\n  compile_wasi_module_rc_impl\n}\n\n\nexport let compile_wasi_module_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n}\n\n\n\nlet zero_pad_6: (Int) -> String = (n) -> {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nlet trim_trailing_zeros: (String) -> String = (s) -> {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    s[0: end]\n  }\n}\n\nexport let double_to_string_compiler: (Double) -> String = (d) -> {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if scaled_raw == 1000000 {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if scaled_raw == 1000000 {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if frac_norm == 0 {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n  }\n}\n\n\n\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TIs;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TDotDot;\n  TDotDotDot;\n  TStringInterp(Array[String]);\n  TEof\n}\n\n\nexport let token_to_string: (Token) -> String = (t) -> {\n  match t {\n    TInt(n) => String::concat(\"TInt(\", String::concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    String::concat(\"TFloat(\", String::concat(double_to_string_compiler(n), \")\")),\n    TString(s) => String::concat(\"TString(\\\"\", String::concat(s, \"\\\")\")),\n    TIdent(s) => String::concat(\"TIdent(\", String::concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TIs => \"TIs\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TDotDot => \"TDotDot\",\n    TDotDotDot => \"TDotDotDot\",\n    TStringInterp(_) => \"TStringInterp\",\n    TEof => \"TEof\"\n  }\n}\n\n\n\nlet is_ws: (Int) -> Bool = (c) -> {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha: (Int) -> Bool = (c) -> {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit: (Int) -> Bool = (c) -> {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum: (Int) -> Bool = (c) -> {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet slice_eq: (String, Int, Int, String) -> Bool = (source, start, end, text) -> {\n  let len = end - start\n  let text_len = String::length(text)\n  if len != text_len {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet is_hex_digit: (Int) -> Bool = (c) -> {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup: (String, Int, Int) -> Option[Token] = (source, start, end) -> {\n  let len = end - start\n  if len == 2 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"if\") {\n        Some(TIf)\n      } else if slice_eq(source, start, end, \"in\") {\n        Some(TIn)\n      } else if slice_eq(source, start, end, \"is\") {\n        Some(TIs)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if slice_eq(source, start, end, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'l' {\n      if slice_eq(source, start, end, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if slice_eq(source, start, end, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'e' {\n      if slice_eq(source, start, end, \"else\") {\n        Some(TElse)\n      } else if slice_eq(source, start, end, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if slice_eq(source, start, end, \"type\") {\n        Some(TType)\n      } else if slice_eq(source, start, end, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if slice_eq(source, start, end, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if slice_eq(source, start, end, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"trait\") {\n        Some(TTrait)\n      } else if slice_eq(source, start, end, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if slice_eq(source, start, end, \"break\") {\n        Some(TBreak)\n      } else if slice_eq(source, start, end, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if slice_eq(source, start, end, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 's' {\n      if slice_eq(source, start, end, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if slice_eq(source, start, end, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if slice_eq(source, start, end, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if slice_eq(source, start, end, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'c' {\n      if slice_eq(source, start, end, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if slice_eq(source, start, end, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet scan_ident_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_alnum(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet lex_ident: (String, Int, Int) -> (Token, Int) = (s, len, i) -> {\n  let end = scan_ident_end(s, len, i)\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\n    let ri_start = end + 1\n    let ri_end = scan_ident_end(s, len, ri_start)\n    (TIdent(s[ri_start: ri_end]), ri_end)\n  }\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      ri = ri + 1\n    }\n    (TString(s[end + 1: ri]), if ri >= len {\n      ri\n    } else {\n      ri + 1\n    })\n  } else {\n    match keyword_lookup(s, i, end) {\n      Some(tok) => (tok, end),\n      None => (TIdent(s[i: end]), end)\n    }\n  }\n}\n\nlet scan_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet scan_interp_end: (String, Int, Int, Int) -> Int with { Error } = (s, len, idx, depth) -> {\n  let mut out = idx\n  let mut current_depth = depth\n  let mut found = -1\n  while out < len && found < 0 {\n    let c = String::char_code_at(s, out)\n    if c == '{' {\n      current_depth = current_depth + 1\n    } else if c == '}' {\n      if current_depth == 1 {\n        found = out\n      } else {\n        current_depth = current_depth - 1\n      }\n    }\n    if found < 0 {\n      out = out + 1\n    }\n  }\n  if found >= 0 {\n    found\n  } else {\n    throw(\"unterminated string interpolation\")\n  }\n}\n\nlet parse_frac_digits: (String, Int, Int, Double, Double) -> (Double, Int) = (s, len, i, acc, scale) -> {\n  let mut out_i = i\n  let mut out_acc = acc\n  let mut out_scale = scale\n  let mut done = false\n  while out_i < len && !done {\n    let c = String::char_code_at(s, out_i)\n    if is_digit(c) {\n      out_acc = out_acc + Int::to_double(c - 48) / out_scale\n      out_scale = out_scale * 10.0\n      out_i = out_i + 1\n    } else {\n      done = true\n    }\n  }\n  (out_acc, out_i)\n}\n\nlet empty_string_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet skip_until_newline: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  let mut done = false\n  while out < len && !done {\n    if String::char_code_at(s, out) == '\\n' {\n      out = out + 1\n      done = true\n    } else {\n      out = out + 1\n    }\n  }\n  out\n}\n\nlet skip_ws_with_newline: (String, Int, Int) -> (Int, Bool) = (s, len, i) -> {\n  let mut out = i\n  let mut saw_newline = false\n  let mut skipping = true\n  while skipping && out < len {\n    let c = String::char_code_at(s, out)\n    if is_ws(c) {\n      if c == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = out + 1\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\n      let next = skip_until_newline(s, len, out + 2)\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = next\n    } else {\n      skipping = false\n    }\n  }\n  (out, saw_newline)\n}\n\nlet concat_string_parts: (Array[String], String) -> String = (parts, tail) -> {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(parts) {\n    out = String::concat(out, Array::get(parts, i))\n    i = i + 1\n  }\n  String::concat(out, tail)\n}\n\nlet lex_string_go: (String, Int, Int, Int, Array[String], Bool, ArrayBuilder[String]) -> (Token, Int) with { Error } = (s, len, idx, start, parts_acc, has_interp, parts) -> {\n  let mut current_idx = idx\n  let mut current_start = start\n  let mut current_parts_acc = parts_acc\n  let mut current_has_interp = has_interp\n  let mut out_tok = TEof\n  let mut out_next = -1\n  let mut done = false\n  while !done {\n    if current_idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, current_idx)\n    if c == '\"' {\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\n      if current_has_interp {\n        ArrayBuilder::push(parts, value)\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts))\n        out_next = current_idx + 1\n      } else {\n        out_tok = TString(value)\n        out_next = current_idx + 1\n      }\n      done = true\n    } else if c == '\\\\' {\n      let chunk = s[current_start: current_idx]\n      let next = current_idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '{' || esc == '(' {\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\n        let interp_end = if esc == '{' {\n          scan_interp_end(s, len, next + 1, 1)\n        } else {\n          let mut ie = next + 1\n          let mut depth = 1\n          while ie < len && depth > 0 {\n            let ic = String::char_code_at(s, ie)\n            if ic == '(' {\n              depth = depth + 1\n            }\n            else if ic == ')' {\n              depth = depth - 1\n            }\n            ie = ie + 1\n          }\n          ie - 1\n        }\n        let expr_src = s[next + 1: interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        current_idx = interp_end + 1\n        current_start = interp_end + 1\n        current_parts_acc = empty_string_array()\n        current_has_interp = true\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        Array::push(current_parts_acc, chunk)\n        Array::push(current_parts_acc, escaped)\n        current_idx = next + 1\n        current_start = next + 1\n      }\n    } else {\n      current_idx = current_idx + 1\n    }\n  }\n  (out_tok, out_next)\n}\n\nlet lex_string: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())\n}\n\nlet scan_hex_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet parse_hex_from_string: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let int_str = s[i: int_end]\n      let int_val = Int::to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(int_val + frac_val), frac_end + 1)\n      } else {\n        (TFloat(int_val + frac_val), frac_end)\n      }\n    } else {\n      let int_str = s[i: int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\n    let int_str = s[i: int_end]\n    let int_val = Int::to_double(parse_int_from_string(int_str))\n    (TFloat(int_val), int_end + 1)\n  } else {\n    let int_str = s[i: int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start: hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nlet is_expr_ending_tok: (Token) -> Bool = (t) -> {\n  match t {\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    TIdent(_) => true,\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    _ => false\n  }\n}\n\nexport let lex: (String) -> Array[Token] with { Error } = (source) -> {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, 0)\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = if is_alpha(c) {\n        lex_ident(source, len, pos)\n      } else if is_digit(c) {\n        lex_number(source, len, pos)\n      } else if c == '\"' {\n        lex_string(source, len, pos)\n      } else if c == '+' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPlusEq, pos + 2)\n        } else (TPlus, pos + 1)\n      } else if c == '-' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TThinArrow, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TMinusEq, pos + 2)\n        } else (TMinus, pos + 1)\n      } else if c == '*' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TStarEq, pos + 2)\n        } else (TStar, pos + 1)\n      } else if c == '/' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TSlashEq, pos + 2)\n        } else (TSlash, pos + 1)\n      } else if c == '%' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPercentEq, pos + 2)\n        } else (TPercent, pos + 1)\n      } else if c == '=' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TEqEq, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TArrow, pos + 2)\n        } else (TEq, pos + 1)\n      } else if c == '!' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TNeq, pos + 2)\n        } else (TNot, pos + 1)\n      } else if c == '<' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TLte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n          (TLShift, pos + 2)\n        } else (TLt, pos + 1)\n      } else if c == '>' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TGte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TRShift, pos + 2)\n        } else (TGt, pos + 1)\n      } else if c == '&' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n          (TAnd, pos + 2)\n        } else (TBitAnd, pos + 1)\n      } else if c == '|' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n          (TOr, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TPipeGt, pos + 2)\n        } else (TBitOr, pos + 1)\n      } else if c == '^' {\n        (TBitXor, pos + 1)\n      } else if c == '(' {\n        (TLParen, pos + 1)\n      } else if c == ')' {\n        (TRParen, pos + 1)\n      } else if c == '{' {\n        (TLBrace, pos + 1)\n      } else if c == '}' {\n        (TRBrace, pos + 1)\n      } else if c == '[' {\n        (TLBracket, pos + 1)\n      } else if c == ']' {\n        (TRBracket, pos + 1)\n      } else if c == ',' {\n        (TComma, pos + 1)\n      } else if c == ';' {\n        (TSemicolon, pos + 1)\n      } else if c == '.' {\n        if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n          (TDotDotDot, pos + 3)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n          (TDotDot, pos + 2)\n        } else (TDot, pos + 1)\n      } else if c == ':' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n          (TDoubleColon, pos + 2)\n        } else (TColon, pos + 1)\n      } else if c == '#' {\n        (THash, pos + 1)\n      } else if c == '~' {\n        (TTilde, pos + 1)\n      } else if c == '?' {\n        (TQuestion, pos + 1)\n      } else if c == '@' {\n        let mut end = pos + 1\n        while end < len && is_alnum(String::char_code_at(source, end)) {\n          end = end + 1\n        }\n        if end > pos + 1 {\n          (TIdent(String::substring(source, pos, end)), end)\n        } else {\n          throw(\"unexpected '@' without identifier\")\n        }\n      } else if c == '\\'' {\n        lex_char(source, len, pos)\n      } else throw(String::concat(\"unexpected character: \", String::from_char_code(c)))\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport let lex_ok: (String) -> Bool = (source) -> {\n  handle {\n    let _ = lex(source)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n\n\n\n\nlet peek: (Array[Token], Int) -> Token = (tokens, pos) -> {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb: () -> Array[(String, Array[String])] = () -> {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nlet tk_name: (Token) -> String = (tok) -> {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TIs => \"is\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk: (Token, String) -> Bool = (tok, name) -> {\n  tk_name(tok) == name\n}\n\nlet expect_tk: (Array[Token], Int, String) -> Int with { Error } = (tokens, pos, expected) -> {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"expected \\{expected} but got \\{actual}\")\n  }\n}\n\nlet skip_semi: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms: () -> Array[(Pat, Expr)] = () -> {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats: () -> Array[Pat] = () -> {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nlet empty_ctors: () -> Array[(String, Array[TypeExpr])] = () -> {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs: () -> Array[Expr] = () -> {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nexport let skip_derive: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TDerive => match peek(tokens, pos + 1) {\n      TLParen => {\n        match peek(tokens, pos + 2) {\n          TIdent(name) => if name != \"Eq\" {\n            throw(\"unknown derive: \\{name}\")\n          },\n          _ => throw(\"expected derive identifier\")\n        }\n        let mut dp = pos + 2\n        let mut dd = true\n        while dd {\n          match peek(tokens, dp) {\n            TRParen => {\n              dd = false\n            },\n            _ => {\n              dp = dp + 1\n            }\n          }\n        }\n        dp + 1\n      },\n      _ => pos\n    },\n    _ => pos\n  }\n}\n\nlet empty_fields: () -> Array[(String, TypeExpr)] = () -> {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params: () -> Array[(String, Option[TypeExpr])] = () -> {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern: (Array[Token], Int) -> (Pat, Int) with { Error } = (tokens, pos) -> {\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TFloat(_) => (PWild, pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => {\n      let next_is_lbrace = match peek(tokens, pos + 1) {\n        TLBrace => true,\n        _ => false\n      }\n      if name == \"true\" {\n        (PBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (PBool(false), pos + 1)\n      }\n      else if name == \"_\" {\n        (PWild, pos + 1)\n      }\n      else if name == \"record\" && next_is_lbrace {\n        let mut rp = pos + 2\n        let field_pats_b = ArrayBuilder::new()\n        let mut rd = true\n        while rd {\n          match peek(tokens, rp) {\n            TRBrace => {\n              rd = false\n            },\n            TIdent(fname) => {\n              match peek(tokens, rp + 1) {\n                TColon => {\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\n                  ArrayBuilder::push(field_pats_b, fp)\n                  rp = fnext\n                },\n                TComma => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                TRBrace => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                _ => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                }\n              }\n              match peek(tokens, rp) {\n                TComma => {\n                  rp = rp + 1\n                },\n                _ => ()\n              }\n            },\n            _ => {\n              rp = rp + 1\n            }\n          }\n        }\n        let rp2 = rp + 1\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\n      }\n      else {\n        let fc = String::char_code_at(name, 0)\n        if fc >= 65 && fc <= 90 {\n          match peek(tokens, pos + 1) {\n            TLParen => {\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n              (PCtor(name, args), end)\n            },\n            TDoubleColon => match peek(tokens, pos + 2) {\n              TLBrace => {\n                let mut sp = pos + 3\n                let field_pats = ArrayBuilder::new()\n                let mut sd = true\n                while sd {\n                  match peek(tokens, sp) {\n                    TRBrace => {\n                      sd = false\n                    },\n                    TIdent(fname) => {\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\n                      sp = sp + 1\n                      match peek(tokens, sp) {\n                        TComma => {\n                          sp = sp + 1\n                        },\n                        _ => ()\n                      }\n                    },\n                    _ => {\n                      sd = false\n                    }\n                  }\n                }\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\n              },\n              _ => (PCtor(name, empty_pats()), pos + 1)\n            },\n            _ => (PCtor(name, empty_pats()), pos + 1)\n          }\n        } else (PBind(name), pos + 1)\n      }\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected in pattern: \\{actual}\")\n    }\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet skip_braced_body: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBrace => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nlet parse_trait_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TColon => {\n        let supers = empty_strings\n        let mut p = pos + 2\n        let mut done = false\n        while !done {\n          match peek(tokens, p) {\n            TIdent(sname) => match peek(tokens, p + 1) {\n              TPlus => {\n                Array::push(supers, sname)\n                p = p + 2\n              },\n              _ => {\n                Array::push(supers, sname)\n                p = p + 1\n                done = true\n              }\n            },\n            _ => {\n              done = true\n            }\n          }\n        }\n        let np = p\n        let body_end = skip_braced_body(tokens, np)\n        (STrait(exported, name, supers), body_end)\n      },\n      _ => {\n        let body_end = skip_braced_body(tokens, pos + 1)\n        (STrait(exported, name, empty_strings), body_end)\n      }\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token: (Token) -> Bool = (tok) -> {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix: (Token) -> Bool = (tok) -> {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item: (Array[Token], Int) -> ((String, Option[String]), Int) with { Error } = (tokens, pos) -> {\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\n    match peek(tokens, name_pos) {\n      TIdent(name) => {\n        let (base, after) = match peek(tokens, name_pos + 1) {\n          TDoubleColon => match peek(tokens, name_pos + 2) {\n            TIdent(member) =>\n            (String::concat(name, String::concat(\"::\", member)), name_pos + 3),\n            _ => throw(\"expected qualified member name after '::'\")\n          },\n          _ => (name, name_pos + 1)\n        }\n        match peek(tokens, after) {\n          TAs => match peek(tokens, after + 1) {\n            TIdent(alias) => ((base, Some(alias)), after + 2),\n            _ => throw(\"expected alias name after 'as'\")\n          },\n          _ => ((base, None), after)\n        }\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items: () -> Array[(String, Option[String])] = () -> {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_binding_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet rec collect_import_path: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, \"\\{acc}.\"),\n    TDotDot => collect_import_path(tokens, pos + 1, \"\\{acc}..\"),\n    TSlash => collect_import_path(tokens, pos + 1, \"\\{acc}/\"),\n    TIdent(name) => collect_import_path(tokens, pos + 1, \"\\{acc}\\{name}\"),\n    TMinus => collect_import_path(tokens, pos + 1, \"\\{acc}-\"),\n    TModule => collect_import_path(tokens, pos + 1, \"\\{acc}module\"),\n    TType => collect_import_path(tokens, pos + 1, \"\\{acc}type\"),\n    TMatch => collect_import_path(tokens, pos + 1, \"\\{acc}match\"),\n    TTest => collect_import_path(tokens, pos + 1, \"\\{acc}test\"),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected token in import path: \\{actual}\")\n    }\n  }\n}\n\nlet skip_bracketed_args: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBracket => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nlet rec collect_effect_names: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if String::length(acc) == 0 {\n        name\n      } else \"\\{acc}, \\{name}\"\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec parse_type_impl: (Array[Token], Int, Int) -> (TypeExpr, Int) with { Error } = (tokens, pos, mode) -> {\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let ts = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\n          ArrayBuilder::push(b, ty)\n          type_list_rest(tokens, next, b)\n        }\n      }\n      ,\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  if mode == 0 {\n    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n    match peek(tokens, atom_next) {\n      TThinArrow => {\n        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n        let params = match atom_ty {\n          TyUnit => empty_type_exprs(),\n          TyTuple(elems) => elems,\n          _ => [\n            atom_ty\n          ]\n        }\n        let effect_pair = match peek(tokens, rn) {\n          TWith => {\n            let with_pos = expect_tk(tokens, rn + 1, \"{\")\n            let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n            (Some(effect_name_pair.0), effect_name_pair.1)\n          },\n          _ => (None, rn)\n        }\n        (TyFn(params, ret, effect_pair.0), effect_pair.1)\n      },\n      _ => (atom_ty, atom_next)\n    }\n  } else {\n    let (base_ty, base_next) = match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => (TyUnit, pos + 2),\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          match peek(tokens, n1) {\n            TRParen => (first, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (TyTuple(rest), en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n        }\n      },\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TLBracket => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          match peek(tokens, n1) {\n            TRBracket => (TyApp(name, [\n              first\n            ]), n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \"]\");\n              (TyApp(name, rest), en)\n            },\n            _ => throw(\"expected ']' or ',' in type application\")\n          }\n        },\n        _ => (TyName(name), pos + 1)\n      },\n      _ => {\n        let actual = tk_name(peek(tokens, pos))\n        throw(\"expected type but got \\{actual}\")\n      }\n    }\n    match peek(tokens, base_next) {\n      TQuestion => (TyApp(\"Option\", [\n        base_ty\n      ]), base_next + 1),\n      _ => (base_ty, base_next)\n    }\n  }\n}\n\nexport let parse_type: (Array[Token], Int) -> (TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param: (Array[Token], Int) -> ((String, Option[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TQuestion => {\n        let opt_name = \"\\{name}?\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((opt_name, Some(ty)), tp)\n          },\n          _ => ((opt_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        let tp2 = match peek(tokens, tp) {\n          TColon => {\n            let mut bp = tp + 1\n            let mut bd = true\n            while bd {\n              match peek(tokens, bp) {\n                TIdent(_) => {\n                  bp = bp + 1; match peek(tokens, bp) {\n                    TPlus => {\n                      bp = bp + 1\n                    },\n                    _ => {\n                      bd = false\n                    }\n                  }\n                },\n                _ => {\n                  bd = false\n                }\n              }\n            }\n            bp\n          },\n          _ => tp\n        }\n        ((name, Some(ty)), tp2)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected parameter name at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nlet rec parse_param_cont: (Array[Token], Int, ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (p, pn) = parse_one_param(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_param_cont(tokens, pn, b)\n      }\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected ',' or ')' in param list at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nlet parse_param_list: (Array[Token], Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_struct_field: (Array[Token], Int) -> ((String, TypeExpr), Int) with { Error } = (tokens, pos) -> {\n  let p = match peek(tokens, pos) {\n    TMut => pos + 1\n    _ => pos\n  }\n  match peek(tokens, p) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, p + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec is_lambda_start_impl: (Array[Token], Int, Int, Bool) -> Bool = (tokens, pos, depth, has_colon) -> {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\n  }\n}\n\nlet is_lambda_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\n  is_lambda_start_impl(tokens, pos, 0, false)\n}\n\nlet rec parse_ctor_types_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor: (Array[Token], Int) -> ((String, Array[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest: (Array[Token], Int, ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors: (Array[Token], Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let b = ArrayBuilder::new()\n          let mut skip = pos + 2\n          let mut depth = 1\n          let mut expect_name = true\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TComma => {\n                if depth == 1 {\n                  expect_name = true\n                }\n                skip = skip + 1\n              },\n              TIdent(nm) => {\n                if depth == 1 && expect_name {\n                  ArrayBuilder::push(b, nm)\n                  expect_name = false\n                }\n                skip = skip + 1\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          (ArrayBuilder::freeze(b), skip)\n        },\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      let final_pos = skip_derive(tokens, end)\n      (SEnum(exported, name, params, ctors), final_pos)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_impl_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_impl_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in impl type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_impl_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\n    _ => (_no_tp(), _no_tb(), pos)\n  }\n  match peek(tokens, after_tp) {\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, after_tp + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => {\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\n          let body_end = skip_braced_body(tokens, after_targs)\n          (SImpl(type_params, type_bounds, trait_name, type_name), body_end)\n        },\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet parse_type_params_list: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_effect_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\n      }\n      let br = expect_tk(tokens, after_params, \"{\")\n      let ops_b = ArrayBuilder::new()\n      let mut p = br\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(op_name) => {\n            let (params, after_op_params) = match peek(tokens, p + 1) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), p + 1)\n            }\n            let arrow_pos = expect_tk(tokens, after_op_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected effect operation name or '}'\")\n        }\n      }\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\n    },\n    _ => throw(\"expected effect name\")\n  }\n}\n\nlet parse_type_alias_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let ep = expect_tk(tokens, after_name, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, params, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet parse_impl_stmt_dispatch: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet rec parse_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, end) = parse_struct_fields(tokens, br);\n      let final_pos = skip_derive(tokens, end)\n      (SStruct(exported, name, fields), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\n\nexport {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, skip_derive, skip_semi, tk_name\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\n\n\n\n\nlet rec desugar_loop_body: (Expr, Array[String]) -> Expr = (expr, param_names) -> {\n  match expr {\n    EBreak(opt) => match opt {\n      Some(val) => EAssign(\"__loop_result\", desugar_loop_body(val, param_names), EBreak(None)),\n      None => EBreak(None)\n    },\n    EContinue(args) => {\n      if Array::length(args) == 0 {\n        EContinue(args)\n      } else {\n        let nargs = Array::length(args)\n        let nparams = Array::length(param_names)\n        if nargs > nparams {\n          EContinue(args)\n        } else {\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\n        let mut ci = nargs - 1\n        while ci >= 0 {\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\"__lt\", __to_string(ci))), result)\n          ci = ci - 1\n        }\n        let mut ci2 = nargs - 1\n        while ci2 >= 0 {\n          result = ELet(String::concat(\"__lt\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result)\n          ci2 = ci2 - 1\n        }\n        result\n        }\n      }\n    },\n    EWhile(_, _) => expr,\n    ELoop(_, _) => expr,\n    EFn(_, _, _, _, _, _) => expr,\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\n    ELet(n, v, b) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    ELetMut(n, v, b) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    EMatch(_, _) => expr,\n    EHandle(_, _) => expr,\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\n    ECall(_, _) => expr,\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    EThrow(e) => EThrow(desugar_loop_body(e, param_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\n    EDot(obj, field) => EDot(desugar_loop_body(obj, param_names), field),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    _ => expr\n  }\n}\n\n\nlet parse_loop_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let param_names_b = ArrayBuilder::new()\n      let param_inits_b = ArrayBuilder::new()\n      let mut cur = pos + 2\n      let mut done = false\n      while !done {\n        match peek(tokens, cur) {\n          TRParen => {\n            cur = cur + 1\n            done = true\n          },\n          TIdent(name) => {\n            let eq_pos = expect_tk(tokens, cur + 1, \"=\")\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\n            ArrayBuilder::push(param_names_b, name)\n            ArrayBuilder::push(param_inits_b, init)\n            match peek(tokens, next_pos) {\n              TComma => {\n                cur = next_pos + 1\n              },\n              TRParen => {\n                cur = next_pos + 1\n                done = true\n              },\n              _ => throw(\"expected ',' or ')' in loop params\")\n            }\n          },\n          _ => throw(\"expected loop parameter name or ')'\")\n        }\n      }\n      let body_pos = expect_tk(tokens, cur, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      let pnames = ArrayBuilder::freeze(param_names_b)\n      let pinits = ArrayBuilder::freeze(param_inits_b)\n      let transformed_body = desugar_loop_body(body, pnames)\n      let while_expr = EWhile(EBool(true), transformed_body)\n      let result = ELetMut(\"__loop_result\", EInt(0),\n        ESeq(while_expr, EIdent(\"__loop_result\")))\n      let mut wrapped = result\n      let mut wi = Array::length(pnames) - 1\n      while wi >= 0 {\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped)\n        wi = wi - 1\n      }\n      (wrapped, end_pos)\n    },\n    _ => {\n      let body_pos = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EWhile(EBool(true), body), end_pos)\n    }\n  }\n}\n\nlet parse_break_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EBreak(None), pos + 1),\n    TSemicolon => (EBreak(None), pos + 1),\n    TEof => (EBreak(None), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EBreak(Some(expr)), next_pos)\n    }\n  }\n}\n\nlet parse_throw_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  let open_pos = expect_tk(tokens, pos + 1, \"(\")\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\n  let close_pos = expect_tk(tokens, next_pos, \")\")\n  (EThrow(expr), close_pos)\n}\n\nlet parse_return_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EReturn(EUnit), pos + 1),\n    TSemicolon => (EReturn(EUnit), pos + 1),\n    TEof => (EReturn(EUnit), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EReturn(expr), next_pos)\n    }\n  }\n}\n\nlet parse_perform_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRParen => (EIdent(\"perform\"), pos + 1),\n    TRBracket => (EIdent(\"perform\"), pos + 1),\n    TRBrace => (EIdent(\"perform\"), pos + 1),\n    TComma => (EIdent(\"perform\"), pos + 1),\n    TSemicolon => (EIdent(\"perform\"), pos + 1),\n    TEof => (EIdent(\"perform\"), pos + 1),\n    _ => {\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\n      (ECall(EIdent(\"perform\"), [\n        arg\n      ]), next_pos)\n    }\n  }\n}\n\nlet rec parse_array_elems_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      let next_pos = pos + 1\n      match peek(tokens, next_pos) {\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\n        TDotDotDot => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\n          ArrayBuilder::push(b, ESpread(expr))\n          parse_array_elems_rest(tokens, end_pos, b, parse_recur)\n        },\n        _ => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\n          ArrayBuilder::push(b, expr)\n          parse_array_elems_rest(tokens, end_pos, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nlet parse_array_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBracket => (EArray(empty_exprs()), pos + 2),\n    TDotDotDot => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n      ArrayBuilder::push(b, ESpread(first))\n      let (items, end_pos) = parse_array_elems_rest(tokens, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    },\n    _ => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, first)\n      let (items, end_pos) = parse_array_elems_rest(tokens, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    }\n  }\n}\n\nlet rec parse_comma_exprs_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      match peek(tokens, pos + 1) {\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\n          ArrayBuilder::push(b, e)\n          parse_comma_exprs_rest(tokens, next, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nlet parse_continue_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let b = ArrayBuilder::new()\n      match peek(tokens, pos + 2) {\n        TRParen => (EContinue(empty_exprs()), pos + 3),\n        _ => {\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n          ArrayBuilder::push(b, first)\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (EContinue(args), close_pos)\n        }\n      }\n    },\n    _ => (EContinue(empty_exprs()), pos + 1)\n  }\n}\n\nlet parse_control_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TLBrace => parse_recur(tokens, pos + 1, 20),\n    TIf => parse_recur(tokens, pos + 1, 21),\n    TMatch => parse_recur(tokens, pos + 1, 22),\n    THandle => parse_recur(tokens, pos + 1, 24),\n    TWhile => parse_recur(tokens, pos + 1, 23),\n    TFor => parse_recur(tokens, pos + 1, 25),\n    TThrow => parse_throw_primary(tokens, pos, parse_recur),\n    TBreak => parse_break_primary(tokens, pos, parse_recur),\n    TContinue => parse_continue_primary(tokens, pos, parse_recur),\n    TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n    TReturn => parse_return_primary(tokens, pos, parse_recur),\n    TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n    TLoop => parse_loop_primary(tokens, pos, parse_recur),\n    TYield => throw(\"'yield' is not supported\"),\n    TDeclare => throw(\"'declare' is not supported\"),\n    _ => {\n      let prev_name = if pos > 0 {\n        tk_name(peek(tokens, pos - 1))\n      } else {\n        \"start\"\n      }\n      let actual = tk_name(peek(tokens, pos))\n      let next_name = tk_name(peek(tokens, pos + 1))\n      throw(\"unexpected token at #\\{pos}: \\{actual} (prev=\\{prev_name}, next=\\{next_name})\")\n    }\n  }\n}\n\nlet rec parse_ctor_record_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_ctor_record_fields(tokens, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nlet parse_generic_fn_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  let mut skip_pos = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, skip_pos) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      _ => ()\n    }\n    skip_pos = skip_pos + 1\n  }\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\n      let effect_pair = match peek(tokens, ret_pos) {\n        TWith => {\n          let with_pos = expect_tk(tokens, ret_pos + 1, \"{\")\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n          let effect_name = effect_name_pair.0\n          let end_pos = effect_name_pair.1\n          (Some(effect_name), end_pos)\n        },\n        _ => (None, ret_pos)\n      }\n      let effect = effect_pair.0\n      let effect_next = effect_pair.1\n      let body_pos = expect_tk(tokens, effect_next, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\n    },\n    TLBrace => {\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\n    },\n    _ => throw(\"expected '->' or '{' after generic function params\")\n  }\n}\n\nlet is_generic_fn_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\n  match peek(tokens, pos + 1) {\n    TIdent(_) => {\n      let mut p = pos + 2\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, p) {\n          TLBracket => {\n            depth = depth + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => ()\n        }\n        p = p + 1\n      }\n      match peek(tokens, p) {\n        TLParen => true,\n        _ => false\n      }\n    },\n    _ => false\n  }\n}\n\nlet parse_bracket_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  if is_generic_fn_start(tokens, pos) {\n    parse_generic_fn_primary(tokens, pos, parse_recur)\n  } else {\n    parse_array_primary(tokens, pos, parse_recur)\n  }\n}\n\nlet rec parse_map_literal_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_map_literal_fields(tokens, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in map literal\")\n      }\n    },\n    TString(skey) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (skey, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_map_literal_fields(tokens, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in map literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in map literal\")\n  }\n}\n\nlet parse_paren_tuple_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRParen => (EUnit, pos + 2),\n    _ => {\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      match peek(tokens, next_pos) {\n        TRParen => (first, next_pos + 1),\n        TComma => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (ETuple(items), close_pos)\n        },\n        _ => throw(\"expected ')' or ','\")\n      }\n    }\n  }\n}\n\nlet parse_paren_lambda_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let after_arrow = after_params + 1\n      match peek(tokens, after_arrow) {\n        TIdent(_) => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        TLParen => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        _ => {\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n        }\n      }\n    },\n    TLBrace => {\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n    },\n    _ => throw(\"expected '->' or '{' after fn params\")\n  }\n}\n\nlet parse_paren_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  if is_lambda_start(tokens, pos + 1) {\n    parse_paren_lambda_primary(tokens, pos, parse_recur)\n  } else {\n    parse_paren_tuple_primary(tokens, pos, parse_recur)\n  }\n}\n\nlet rec parse_record_literal_fields: (Array[Token], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname), pos + 1),\n        TRBrace => (EIdent(fname), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_record_literal_fields(tokens, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nlet parse_ident_primary: (Array[Token], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, name, parse_recur) -> {\n  if name == \"true\" {\n    (EBool(true), pos + 1)\n  } else if name == \"false\" {\n    (EBool(false), pos + 1)\n  } else if name == \"perform\" {\n    parse_perform_primary(tokens, pos, parse_recur)\n  } else if name == \"record\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_record_literal_fields(tokens, pos + 2, b, parse_recur)\n        (ERecord(fields), end_pos)\n      },\n      _ => (EIdent(name), pos + 1)\n    }\n  } else if name == \"map\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_map_literal_fields(tokens, pos + 2, b, parse_recur)\n        (EMap(fields), end_pos)\n      },\n      _ => (EIdent(name), pos + 1)\n    }\n  } else {\n    match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member))), pos + 3),\n        TLBrace => {\n          let b = ArrayBuilder::new()\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, pos + 3, b, parse_recur)\n          (ERecord(fields), end_pos)\n        },\n        _ => (EIdent(name), pos + 1)\n      },\n      _ => (EIdent(name), pos + 1)\n    }\n  }\n}\n\nexport let parse_primary: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TInt(n) => (EInt(n), pos + 1),\n    TFloat(n) => (EFloat(n), pos + 1),\n    TString(s) => (EString(s), pos + 1),\n    TStringInterp(parts) => (EStringInterp(parts), pos + 1),\n    TIdent(name) => parse_ident_primary(tokens, pos, name, parse_recur),\n    TLParen => parse_paren_primary(tokens, pos, parse_recur),\n    TLBracket => parse_bracket_primary(tokens, pos, parse_recur),\n    _ => parse_control_primary(tokens, pos, parse_recur)\n  }\n}\n\n\n\n\n\n\nlet binop_op: (Token) -> String with { Error } = (tok) -> {\n  match tok {\n    TOr => \"||\",\n    TAnd => \"&&\",\n    TPipeGt => \"|>\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TBitAnd => \"&\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    _ => throw(\"internal parser error: not a binary operator\")\n  }\n}\n\nlet binop_prec: (Token) -> Int = (tok) -> {\n  match tok {\n    TOr => 0,\n    TAnd => 1,\n    TPipeGt => 2,\n    TEqEq => 3,\n    TNeq => 3,\n    TLt => 3,\n    TLte => 3,\n    TGt => 3,\n    TGte => 3,\n    TBitOr => 4,\n    TBitXor => 5,\n    TBitAnd => 6,\n    TLShift => 7,\n    TRShift => 7,\n    TPlus => 8,\n    TMinus => 8,\n    TStar => 9,\n    TSlash => 9,\n    TPercent => 9,\n    _ => -1\n  }\n}\n\nlet index_expr: (Expr, Expr) -> Expr = (cur_expr, idx) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  ECall(EIdent(\"__index\"), args)\n}\n\nlet pipe_desugar: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  match rhs {\n    ECall(callee, args) => ECall(callee, Array::concat([\n      lhs\n    ], args)),\n    _ => ECall(rhs, [\n      lhs\n    ])\n  }\n}\n\nlet parse_call_arg: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TThinArrow => {\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\n        (EFn(_no_tp(), _no_tb(), [\n          (name, None)\n        ], None, None, body), end)\n      },\n      TTilde => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TQuestion => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"?\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TEq => {\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\n        (ELabeledArg(name, \"~\", val), end)\n      },\n      _ => parse_recur(tokens, pos, 0)\n    },\n    _ => parse_recur(tokens, pos, 0)\n  }\n}\n\nlet has_placeholder_arg: (Expr) -> Bool = (arg) -> {\n  match arg {\n    EIdent(n) => n == \"_\",\n    EBinOp(_, l, r) => {\n      let left_has = match l {\n        EIdent(n) => n == \"_\",\n        _ => false\n      }\n      let right_has = match r {\n        EIdent(n) => n == \"_\",\n        _ => false\n      }\n      left_has || right_has\n    },\n    _ => false\n  }\n}\n\nlet slice_from_idx_expr: (Expr, Expr, Expr) -> Expr = (cur_expr, idx, end_expr) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\"), args)\n}\n\nlet has_placeholder_args: (Array[Expr]) -> Bool = (args) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) {\n    if has_placeholder_arg(Array::get(args, i)) {\n      found = true\n      i = Array::length(args)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet parse_call_args_rest: (Array[Token], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, pos, b, parse_recur) -> {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TComma => match peek(tokens, p + 1) {\n        TRParen => {\n          p = p + 1\n          done = true\n        },\n        _ => {\n          let (e, next) = parse_call_arg(tokens, p + 1, parse_recur)\n          ArrayBuilder::push(b, e)\n          p = next\n        }\n      }\n      ,\n      _ => {\n        done = true\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet slice_from_zero_expr: (Expr, Expr) -> Expr = (cur_expr, end_expr) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, EInt(0))\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\"), args)\n}\n\nlet wrap_placeholder_arg: (Expr) -> Expr = (arg) -> {\n  let mut pc = 0\n  let params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let replaced = match arg {\n    EIdent(n) => if n == \"_\" {\n      let pn = \"__ph0\"\n      Array::push(params, (pn, None))\n      EIdent(pn)\n    } else {\n      arg\n    }\n    ,\n    EBinOp(op, l, r) => {\n      let nl = match l {\n        EIdent(n) => if n == \"_\" {\n          let pn = String::concat(\"__ph\", __to_string(pc))\n          Array::push(params, (pn, None))\n          pc = pc + 1\n          EIdent(pn)\n        } else {\n          l\n        }\n        ,\n        _ => l\n      }\n      let nr = match r {\n        EIdent(n) => if n == \"_\" {\n          let pn = String::concat(\"__ph\", __to_string(pc))\n          Array::push(params, (pn, None))\n          pc = pc + 1\n          EIdent(pn)\n        } else {\n          r\n        }\n        ,\n        _ => r\n      }\n      EBinOp(op, nl, nr)\n    },\n    _ => arg\n  }\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\n}\n\nlet has_non_pipe_infix_top: (Array[Token], Int, Int) -> Bool = (tokens, start, end) -> {\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else {\n            go(i + 1, 0, false)\n          }\n        } else {\n          match tok {\n            TLParen => go(i + 1, 1, false),\n            TLBracket => go(i + 1, 1, false),\n            TLBrace => go(i + 1, 1, false),\n            _ => go(i + 1, 0, is_expr_end_token(tok))\n          }\n        }\n      } else {\n        match tok {\n          TLParen => go(i + 1, depth + 1, prev_top_end),\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\n          TRParen => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBracket => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBrace => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          _ => go(i + 1, depth, prev_top_end)\n        }\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nlet desugar_placeholder_args: (Array[Expr]) -> Array[Expr] = (args) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    if has_placeholder_arg(arg) {\n      Array::push(out, wrap_placeholder_arg(arg))\n    } else {\n      Array::push(out, arg)\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet rec parse_postfix: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, expr, parse_recur) -> {\n  match peek(tokens, pos) {\n    TLParen => match expr {\n      ECall(_, _) => (expr, pos),\n      EArray(_) => (expr, pos),\n      ETuple(_) => (expr, pos),\n      ERecord(_) => (expr, pos),\n      EMap(_) => (expr, pos),\n      EInt(_) => (expr, pos),\n      EFloat(_) => (expr, pos),\n      EString(_) => (expr, pos),\n      EStringInterp(_) => (expr, pos),\n      EBool(_) => (expr, pos),\n      EUnit => (expr, pos),\n      EWhile(_, _) => (expr, pos),\n      EIf(_, _, _) => (expr, pos),\n      EMatch(_, _) => (expr, pos),\n      ELoop(_, _) => (expr, pos),\n      EForIn(_, _, _, _) => (expr, pos),\n      EHandle(_, _) => (expr, pos),\n      _ => match peek(tokens, pos + 1) {\n        TRParen => parse_postfix(tokens, pos + 2, ECall(expr, empty_exprs()), parse_recur),\n        _ => {\n          let b = ArrayBuilder::new()\n          let (first_arg, next_pos) = parse_call_arg(tokens, pos + 1, parse_recur)\n          ArrayBuilder::push(b, first_arg)\n          let (args, end_pos) = parse_call_args_rest(tokens, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          let call_args = if has_placeholder_args(args) {\n            desugar_placeholder_args(args)\n          } else {\n            args\n          }\n          parse_postfix(tokens, close_pos, ECall(expr, call_args), parse_recur)\n        }\n      },\n    },\n    TLBracket => match peek(tokens, pos + 1) {\n      TColon => match peek(tokens, pos + 2) {\n        TRBracket => {\n          let end_expr = ECall(EIdent(\"__len\"), [\n            expr\n          ])\n          parse_postfix(tokens, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\n        },\n        _ => {\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\n          let close_pos = match peek(tokens, end_next) {\n            TRBracket => end_next + 1,\n            _ => throw(\"expected ']'\")\n          }\n          parse_postfix(tokens, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\n        }\n      },\n      _ => {\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\n        match peek(tokens, idx_next) {\n          TColon => match peek(tokens, idx_next + 1) {\n            TRBracket => {\n              let end_expr = ECall(EIdent(\"__len\"), [\n                expr\n              ])\n              parse_postfix(tokens, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            },\n            _ => {\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\n              let close_pos = match peek(tokens, end_next) {\n                TRBracket => end_next + 1,\n                _ => throw(\"expected ']'\")\n              }\n              parse_postfix(tokens, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            }\n          },\n          _ => {\n            let close_pos = match peek(tokens, idx_next) {\n              TRBracket => idx_next + 1,\n              _ => throw(\"expected ']'\")\n            }\n            parse_postfix(tokens, close_pos, index_expr(expr, idx), parse_recur)\n          }\n        }\n      }\n    },\n    TDot => match peek(tokens, pos + 1) {\n      TIdent(field) => parse_postfix(tokens, pos + 2, EDot(expr, field), parse_recur),\n      TInt(idx) => parse_postfix(tokens, pos + 2, EDot(expr, __to_string(idx)), parse_recur),\n      _ => (expr, pos)\n    },\n    _ => (expr, pos)\n  }\n}\n\nlet rec parse_prefix: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TMinus => {\n      let (e, next) = parse_prefix(tokens, pos + 1, parse_recur)\n      (EUnaryOp(\"-\", e), next)\n    },\n    TNot => {\n      let (e, next) = parse_prefix(tokens, pos + 1, parse_recur)\n      (EUnaryOp(\"!\", e), next)\n    },\n    _ => {\n      let (e, next) = parse_primary(tokens, pos, parse_recur)\n      parse_postfix(tokens, next, e, parse_recur)\n    }\n  }\n}\n\nlet rec parse_infix_loop: (Array[Token], Expr, Int, Int, Int, Bool, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, left, next, min_prec, expr_start, cmp_locked, parse_recur) -> {\n  let tok = peek(tokens, next)\n  let prec = binop_prec(tok)\n  let should_stop = if prec < min_prec {\n    true\n  } else if cmp_locked {\n    prec == 3\n  } else {\n    false\n  }\n  if should_stop {\n    (left, next)\n  } else {\n    let is_pipe = match tok {\n      TPipeGt => true,\n      _ => false\n    }\n    let op = binop_op(tok)\n    if is_pipe {\n      if has_non_pipe_infix_top(tokens, expr_start, next) {\n        throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n      }\n    }\n    let (right0, right_next0) = parse_prefix(tokens, next + 1, parse_recur)\n    let (right, rn) = parse_infix_loop(tokens, right0, right_next0, prec + 1, next + 1, false, parse_recur)\n    if is_pipe {\n      if has_non_pipe_infix_top(tokens, next + 1, rn) {\n        throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n      }\n    }\n    let combined = if is_pipe {\n      pipe_desugar(left, right)\n    } else {\n      EBinOp(op, left, right)\n    }\n    let next_cmp_locked = if prec == 3 {\n      true\n    } else {\n      cmp_locked\n    }\n    parse_infix_loop(tokens, combined, rn, min_prec, expr_start, next_cmp_locked, parse_recur)\n  }\n}\n\nexport let parse_infix_no_is: (Array[Token], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, min_prec, expr_start, parse_recur) -> {\n  let (left0, next0) = parse_prefix(tokens, pos, parse_recur)\n  parse_infix_loop(tokens, left0, next0, min_prec, expr_start, false, parse_recur)\n}\n\nexport let parse_infix: (Array[Token], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, min_prec, expr_start, parse_recur) -> {\n  let (expr, en) = parse_infix_no_is(tokens, pos, min_prec, expr_start, parse_recur)\n  match peek(tokens, en) {\n    TIs => {\n      let (pat, pn) = parse_pattern(tokens, en + 1)\n      (EMatch(expr, [\n        (pat, EBool(true)),\n        (PWild, EBool(false))\n      ]), pn)\n    },\n    TIdent(kw) => if kw == \"is\" {\n      let (pat, pn) = parse_pattern(tokens, en + 1)\n      (EMatch(expr, [\n        (pat, EBool(true)),\n        (PWild, EBool(false))\n      ]), pn)\n    } else {\n      (expr, en)\n    },\n    _ => (expr, en)\n  }\n}\n\n\n\n\n\n\nenum BlockStep {\n  StepSeq(Expr);\n  StepValue(Expr);\n  StepLet(String, Expr);\n  StepLetMut(String, Expr);\n  StepLetRec(String, Expr);\n  StepAssign(String, Expr);\n  StepAssignOp(String, String, Expr);\n  StepPattern(Pat, Expr);\n  StepStructDestr(Pat, Expr);\n  StepRecordDestr(Pat, Expr)\n}\n\nlet rec parse_match_rest: (Array[Token], Int, Expr, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, scrutinee, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 2),\n      _ => {\n        let (pa, paa) = parse_pattern(tokens, pos + 1)\n        let a2 = match peek(tokens, paa) {\n          TIf => {\n            let (_, ga) = parse_recur(tokens, paa + 1, 0)\n            expect_tk(tokens, ga, \"=>\")\n          },\n          _ => expect_tk(tokens, paa, \"=>\")\n        }\n        let (ea, en) = parse_recur(tokens, a2, 0)\n        ArrayBuilder::push(b, (pa, ea))\n        parse_match_rest(tokens, en, scrutinee, b, parse_recur)\n      }\n    },\n    TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 1),\n    _ => {\n      let (pa, paa) = parse_pattern(tokens, pos)\n      let a2 = match peek(tokens, paa) {\n        TIf => {\n          let (_, ga) = parse_recur(tokens, paa + 1, 0)\n          expect_tk(tokens, ga, \"=>\")\n        },\n        _ => expect_tk(tokens, paa, \"=>\")\n      }\n      let (ea, en) = parse_recur(tokens, a2, 0)\n      ArrayBuilder::push(b, (pa, ea))\n      parse_match_rest(tokens, en, scrutinee, b, parse_recur)\n    }\n  }\n}\n\nlet rec qualify_handle_arm_pattern: (String, Pat) -> Pat = (effect_name, pat) -> {\n  match pat {\n    PCtor(name, args) => if String::contains(name, \"::\") {\n      PCtor(name, args)\n    } else {\n      PCtor(String::concat(effect_name, String::concat(\"::\", name)), args)\n    },\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\n    _ => pat\n  }\n}\n\nlet parse_handle_arm: (Array[Token], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } = (tokens, pos, effect_name, parse_recur) -> {\n  let (pat, pat_next) = parse_pattern(tokens, pos)\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\n  let arrow_pos = expect_tk(tokens, pat_next, \"=>\")\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\n  ((qualified_pat, expr), next)\n}\n\nlet rec parse_handle_rest: (Array[Token], Int, Expr, String, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, body, effect_name, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n      _ => {\n        let (arm, next) = parse_handle_arm(tokens, pos + 1, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, next, body, effect_name, b, parse_recur)\n      }\n    },\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n    _ => throw(\"expected ';' or '}' in handle arm list\")\n  }\n}\n\nlet parse_block_after_expr: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, e, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (e, pos + 1),\n    TSemicolon => {\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\n      (ESeq(e, rest), end)\n    },\n    TEq => match e {\n      EIdent(name) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssign(name, val, rest), end)\n      },\n      EDot(obj, field) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        let set_args = empty_exprs()\n        Array::push(set_args, obj)\n        Array::push(set_args, EString(field))\n        Array::push(set_args, val)\n        (ESeq(ECall(EIdent(\"__set_field\"), set_args), rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPlusEq => match e {\n      EIdent(name) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"+\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TMinusEq => match e {\n      EIdent(name) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"-\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TStarEq => match e {\n      EIdent(name) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"*\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TSlashEq => match e {\n      EIdent(name) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"/\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPercentEq => match e {\n      EIdent(name) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"%\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    _ => {\n      let (rest, end) = parse_recur(tokens, pos, 20)\n      if end <= pos {\n        throw(\"internal parser error: block continuation did not advance\")\n      } else {\n        (ESeq(e, rest), end)\n      }\n    }\n  }\n}\n\nlet parse_block_value_body: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } = (tokens, eq, parse_recur) -> {\n  let val_pair = parse_recur(tokens, eq, 0)\n  let val = val_pair.0\n  let val_next = val_pair.1\n  let a = skip_semi(tokens, val_next)\n  let (body, end) = parse_recur(tokens, a, 20)\n  (val, body, end, a)\n}\n\nlet parse_block_value_only: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, value_pos, parse_recur) -> {\n  let val_pair = parse_recur(tokens, value_pos, 0)\n  (val_pair.0, skip_semi(tokens, val_pair.1))\n}\n\nlet apply_struct_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\n  let val_name = \"__struct_destr\"\n  let mut desugar = rest\n  match pat {\n    PStruct(_, fields) => {\n      let mut di = Array::length(fields) - 1\n      while di >= 0 {\n        let (fname, fpat) = Array::get(fields, di)\n        match fpat {\n          PBind(bname) => {\n            desugar = ELet(bname, EDot(EIdent(val_name), fname), desugar)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar)\n}\n\nlet apply_record_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\n  let val_name = \"__rec_destr\"\n  let mut desugar = rest\n  match pat {\n    PTuple(field_pats) => {\n      let mut di = Array::length(field_pats) - 1\n      while di >= 0 {\n        let fp = Array::get(field_pats, di)\n        match fp {\n          PBind(bname) => {\n            desugar = ELet(bname, ECall(EIdent(\"__rec_field\"), [\n              EIdent(val_name),\n              EInt(di)\n            ]), desugar)\n          },\n          PTuple(sub_pats) => {\n            let sub_name = String::concat(\"__rec_sub_\", __to_string(di))\n            let mut si = Array::length(sub_pats) - 1\n            while si >= 0 {\n              match Array::get(sub_pats, si) {\n                PBind(sname) => {\n                  desugar = ELet(sname, EDot(EIdent(sub_name), __to_string(si)), desugar)\n                },\n                _ => ()\n              }\n              si = si - 1\n            }\n            desugar = ELet(sub_name, ECall(EIdent(\"__rec_field\"), [\n              EIdent(val_name),\n              EInt(di)\n            ]), desugar)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar)\n}\n\nlet apply_block_step: (BlockStep, Expr) -> Expr = (step, rest) -> {\n  match step {\n    StepSeq(expr) => ESeq(expr, rest),\n    StepValue(expr) => expr,\n    StepLet(name, val) => ELet(name, val, rest),\n    StepLetMut(name, val) => ELetMut(name, val, rest),\n    StepLetRec(name, val) => ELetRec(name, val, rest),\n    StepAssign(name, val) => EAssign(name, val, rest),\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\n    StepPattern(pat, val) => EMatch(val, [\n      (pat, rest)\n    ]),\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest)\n  }\n}\n\nlet fold_block_steps: (Array[BlockStep]) -> Expr = (steps) -> {\n  let mut result = EUnit\n  let mut i = Array::length(steps) - 1\n  while i >= 0 {\n    result = apply_block_step(Array::get(steps, i), result)\n    i = i - 1\n  }\n  result\n}\n\nlet parse_impl_block: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, parse_recur) -> {\n  let steps = ArrayBuilder::new()\n  let mut p = pos\n  let mut end_pos = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBrace => {\n        end_pos = p + 1\n        done = true\n      },\n      TEof => throw(\"unexpected eof in block\"),\n      TEnum => {\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\n        match enum_stmt {\n          SEnum(_, _, _, variants) => {\n            let mut vi = 0\n            while vi < Array::length(variants) {\n              let (vname, vfields) = Array::get(variants, vi)\n              if Array::length(vfields) == 0 {\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi)))\n              }\n              vi = vi + 1\n            }\n          },\n          _ => ()\n        }\n        p = enum_end\n      },\n      TStruct => {\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\n        p = struct_end\n      },\n      TLet => {\n        let next = p + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq_pos_r = match peek(tokens, next + 2) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\n                  tp\n                },\n                _ => next + 2\n              }\n              let eq = expect_tk(tokens, eq_pos_r, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepLetRec(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq_pos_m = match peek(tokens, next + 2) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\n                  tp\n                },\n                _ => next + 2\n              }\n              let eq = expect_tk(tokens, eq_pos_m, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepLetMut(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TIdent(name) => {\n            let after_name = peek(tokens, next + 1)\n            let next_is_struct_destr = match after_name {\n              TDoubleColon => {\n                let fc = String::char_code_at(name, 0)\n                if fc >= 65 && fc <= 90 {\n                  match peek(tokens, next + 2) {\n                    TLBrace => true,\n                    _ => false\n                  }\n                } else {\n                  false\n                }\n              },\n              _ => false\n            }\n            let next_is_record_destr = match after_name {\n              TLBrace => name == \"record\",\n              _ => false\n            }\n            if next_is_struct_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\n              p = next_pos\n            } else if next_is_record_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\n              p = next_pos\n            } else {\n              match after_name {\n                TLParen => {\n                  let (pat, pn) = parse_pattern(tokens, next)\n                  let eq = expect_tk(tokens, pn, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let-ctor-pat parser did not advance\")\n                  } else {\n                    ArrayBuilder::push(steps, StepPattern(pat, val))\n                    p = next_pos\n                  }\n                },\n                _ => {\n                  let eq_pos = match after_name {\n                    TColon => {\n                      let (_, tp) = parse_type_impl(tokens, next + 2, 0)\n                      tp\n                    },\n                    _ => next + 1\n                  }\n                  let eq = expect_tk(tokens, eq_pos, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let parser did not advance\")\n                  } else {\n                    ArrayBuilder::push(steps, StepLet(name, val))\n                    p = next_pos\n                  }\n                }\n              }\n            }\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n            if next_pos <= eq {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              ArrayBuilder::push(steps, StepPattern(pat, val))\n              p = next_pos\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_recur(tokens, p, 0)\n        if next <= p {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else {\n          match peek(tokens, next) {\n            TRBrace => {\n              ArrayBuilder::push(steps, StepValue(e))\n              end_pos = next + 1\n              done = true\n            },\n            TSemicolon => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next + 1\n            },\n            TEq => match e {\n              EIdent(name) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssign(name, val))\n                p = next_pos\n              },\n              EDot(obj, field) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                let set_args = empty_exprs()\n                Array::push(set_args, obj)\n                Array::push(set_args, EString(field))\n                Array::push(set_args, val)\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"__set_field\"), set_args)))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPlusEq => match e {\n              EIdent(name) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"+\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TMinusEq => match e {\n              EIdent(name) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"-\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TStarEq => match e {\n              EIdent(name) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"*\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TSlashEq => match e {\n              EIdent(name) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"/\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPercentEq => match e {\n              EIdent(name) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"%\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            _ => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next\n            }\n          }\n        }\n      }\n    }\n  }\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\n}\n\nexport let parse_impl_dispatch: (Array[Token], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, mode, parse_recur) -> {\n  if mode == 20 {\n    parse_impl_block(tokens, pos, parse_recur)\n  } else if mode == 21 {\n    let (cond, cn) = parse_infix_no_is(tokens, pos, 0, pos, parse_recur)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIs => {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_recur(tokens, br, 20)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_recur(tokens, tn + 2, 21),\n        TLBrace => parse_recur(tokens, tn + 2, 20),\n        _ => parse_recur(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [\n        (is_pat_val, then_e),\n        (PWild, else_e)\n      ]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == 22 {\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (fp, fa) = parse_pattern(tokens, br)\n        let aa = match peek(tokens, fa) {\n          TIf => {\n            let (_, ga) = parse_recur(tokens, fa + 1, 0)\n            expect_tk(tokens, ga, \"=>\")\n          },\n          _ => expect_tk(tokens, fa, \"=>\")\n        }\n        let (fe, fn1) = parse_recur(tokens, aa, 0)\n        ArrayBuilder::push(b, (fp, fe))\n        parse_match_rest(tokens, fn1, scrutinee, b, parse_recur)\n      }\n    }\n  } else if mode == 23 {\n    let (cond, cn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_recur(tokens, br, 20)\n    (EWhile(cond, body), end)\n  } else if mode == 24 {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_recur(tokens, br, 20)\n    let wp = expect_tk(tokens, bn, \"with\")\n    let (effect_name, effect_next) = match peek(tokens, wp) {\n      TIdent(name) => (name, wp + 1),\n      _ => throw(\"expected effect name after 'with'\")\n    }\n    let hb = expect_tk(tokens, effect_next, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (arm, next) = parse_handle_arm(tokens, hb, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, next, body, effect_name, b, parse_recur)\n      }\n    }\n  } else if mode == 25 {\n    let mut start = pos\n    match peek(tokens, pos) {\n      TIdent(marker) => if marker == \"await\" {\n        match peek(tokens, pos + 1) {\n          TIdent(_) => { start = pos + 1 },\n          _ => ()\n        }\n      } else (),\n      _ => ()\n    }\n    match peek(tokens, start) {\n      TIdent(first_name) => match peek(tokens, start + 1) {\n        TComma => match peek(tokens, start + 2) {\n          TIdent(second_name) => {\n            let ip = expect_tk(tokens, start + 3, \"in\")\n            match parse_recur(tokens, ip, 0) {\n              (iterable, after_iter) => {\n                let bb = expect_tk(tokens, after_iter, \"{\")\n                let (body, end) = parse_recur(tokens, bb, 20)\n                (EForIn(second_name, Some(first_name), iterable, body), end)\n              },\n              _ => throw(\"unreachable: parse_recur for for-in\")\n            }\n          },\n          _ => throw(\"expected value binding name after ','\")\n        },\n        _ => {\n          let ip = expect_tk(tokens, start + 1, \"in\")\n          match parse_recur(tokens, ip, 0) {\n            (iterable, after_iter) => {\n              let bb = expect_tk(tokens, after_iter, \"{\")\n              let (body, end) = parse_recur(tokens, bb, 20)\n              (EForIn(first_name, None, iterable, body), end)\n            },\n            _ => throw(\"unreachable: parse_recur for for-in\")\n          }\n        }\n      }\n      ,\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"internal parser error: unknown parse mode \\{mode} at #\\{pos} token=\\{actual}\")\n  }\n}\n\n\n\n\n\n\n\nexport let parse_impl: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (tokens, pos, mode) -> {\n  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {\n    if rmode >= 0 && rmode <= 10 {\n      parse_infix(rtoks, rpos, rmode, rpos, parse_recur)\n    } else {\n      parse_impl_dispatch(rtoks, rpos, rmode, parse_recur)\n    }\n  }\n  parse_recur(tokens, pos, mode)\n}\n\nexport let parse: (Array[Token]) -> Expr with { Error } = (tokens) -> {\n  let (e, next) = parse_impl(tokens, 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => {\n      let actual = tk_name(peek(tokens, next))\n      throw(\"unexpected after expression: \\{actual}\")\n    }\n  }\n}\n\nexport let parse_ok: (Array[Token]) -> Bool = (tokens) -> {\n  handle {\n    let _ = parse(tokens)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n\nexport let parse_expr: (Array[Token], Int) -> (Expr, Int) with { Error } = (tokens, pos) -> {\n  parse_impl(tokens, pos, 0)\n}\n\nlet parse_type_param_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_let_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_let_annotation: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_params, 0)\n      (type_params, type_bounds, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      (_no_tp(), _no_tb(), ty, next)\n    }\n  }\n}\n\nlet apply_fn_annotation_params: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, param_types) -> {\n  if Array::length(params) != Array::length(param_types) {\n    params\n  } else {\n    let out = ArrayBuilder::new()\n    let mut i = 0\n    while i < Array::length(params) {\n      let (name, ann) = Array::get(params, i)\n      let next_ann = match ann {\n        Some(_) => ann,\n        None => Some(Array::get(param_types, i))\n      }\n      ArrayBuilder::push(out, (name, next_ann))\n      i = i + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nlet apply_generic_fn_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr, Array[TypeExpr], TypeExpr, Option[String]) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val, param_types, ret_ty, effect_name) -> {\n  match val {\n    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {\n      let next_params = apply_fn_annotation_params(params, param_types)\n      let next_ret = match ret_opt {\n        Some(_) => ret_opt,\n        None => Some(ret_ty)\n      }\n      let next_effect = match effect_opt {\n        Some(_) => effect_opt,\n        None => effect_name\n      }\n      let next_type_params = if Array::length(type_params) > 0 {\n        type_params\n      } else existing_type_params\n      let next_type_bounds = if Array::length(type_params) > 0 {\n        type_bounds\n      } else existing_type_bounds\n      let next_ann = if Array::length(type_params) > 0 {\n        None\n      } else ann\n      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))\n    },\n    _ => (ann, val)\n  }\n}\n\nlet apply_generic_let_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val) -> {\n  match ann {\n    Some(ann_ty) => match ann_ty {\n      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),\n      _ => (ann, val)\n    },\n    _ => (ann, val)\n  }\n}\n\nlet apply_value_bracket_type_params: (Array[String], Array[(String, Array[String])], Expr) -> Expr = (tps, tbs, val) -> {\n  if Array::length(tps) == 0 {\n    val\n  } else {\n    match val {\n      EFn(existing_tp, existing_tb, params, ret, eff, body) => {\n        let next_tp = if Array::length(existing_tp) > 0 {\n          existing_tp\n        } else tps\n        let next_tb = if Array::length(existing_tp) > 0 {\n          existing_tb\n        } else tbs\n        EFn(next_tp, next_tb, params, ret, eff, body)\n      },\n      _ => val\n    }\n  }\n}\n\nlet skip_generic_value_start: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => match peek(tokens, pos + 1) {\n      TIdent(_) => {\n        let maybe_generic = match peek(tokens, pos + 2) {\n          TRBracket => match peek(tokens, pos + 3) {\n            TLParen => true,\n            _ => false\n          },\n          TColon => true,\n          TComma => true,\n          _ => false\n        }\n        if maybe_generic {\n          let mut scan_pos = pos + 1\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, scan_pos) {\n              TLBracket => {\n                depth = depth + 1\n              },\n              TRBracket => {\n                depth = depth - 1\n              },\n              _ => ()\n            }\n            scan_pos = scan_pos + 1\n          }\n          scan_pos\n        } else {\n          pos\n        }\n      },\n      _ => pos\n    },\n    _ => pos\n  }\n}\n\nlet parse_value_bracket_header: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let skipped = skip_generic_value_start(tokens, pos)\n  if skipped == pos {\n    (_no_tp(), _no_tb(), pos)\n  } else {\n    match peek(tokens, pos) {\n      TLBracket => {\n        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)\n        (tps, tbs, skipped)\n      },\n      _ => (_no_tp(), _no_tb(), skipped)\n    }\n  }\n}\n\nlet parse_let_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n          (tparams, tbounds, Some(ty), tp)\n        },\n        _ => (_no_tp(), _no_tb(), None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)\n      let val_pair = parse_impl(tokens, val_start_r, 0)\n      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n      let val_next = val_pair.1\n      (SLet(exported, true, name, final_ty_opt, val), val_next)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let val_pair = parse_impl(tokens, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetMut(name, ty_opt, val), val_next)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TLParen => {\n      let (pat, pat_next) = parse_pattern(tokens, pos)\n      let ep = expect_tk(tokens, pat_next, \"=\")\n      let val_pair = parse_impl(tokens, ep, 0)\n      let val = val_pair.0\n      let val_next = val_pair.1\n      (SLetPat(pat, val), val_next)\n    },\n    TIdent(_name0) => {\n      let is_struct_destructure = match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TLBrace => true,\n          _ => false\n        },\n        _ => false\n      }\n      if is_struct_destructure {\n        let (pat, pat_next) = parse_pattern(tokens, pos)\n        let ep = expect_tk(tokens, pat_next, \"=\")\n        let val_pair = parse_impl(tokens, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetPat(pat, val), val_next)\n      } else {\n        let (name, name_next) = parse_binding_name(tokens, pos)\n        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n          TColon => {\n            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n            (tparams, tbounds, Some(ty), tp)\n          },\n          _ => (_no_tp(), _no_tb(), None, name_next)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)\n        let val_pair = parse_impl(tokens, val_start, 0)\n        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n        let val_next = val_pair.1\n        (SLet(exported, false, name, final_ty_opt, val), val_next)\n      }\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\n\nexport {\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\n}\n\nexport {\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\n\n\n\n\n\nlet parser_mode_block = 20\n\nlet empty_names: () -> Array[String] = () -> {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet parse_test_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, parser_mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, parser_mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nlet parse_export_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) =>\n          (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name in export list\")\n  }\n}\n\nlet rec parse_export_names_rest: (Array[Token], Int, ArrayBuilder[String]) -> (Array[String], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(_) => {\n        let (nm, after) = parse_export_name(tokens, pos + 1)\n        ArrayBuilder::push(b, nm)\n        parse_export_names_rest(tokens, after, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest: (Array[Token], Int, ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items: (Array[Token], Int) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(name, items), end)\n    } else {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      match peek(tokens, bp) {\n        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\n          let alias_str = String::substring(alias_name, 1, String::length(alias_name))\n          (SAliasDecl(alias_str, path), bp + 1)\n        } else {\n          let br = expect_tk(tokens, bp, \"{\")\n          let (items, end) = parse_import_items(tokens, br);\n          (SImport(path, items), end)\n        },\n        _ => {\n          let br = expect_tk(tokens, bp, \"{\")\n          let (items, end) = parse_import_items(tokens, br);\n          (SImport(path, items), end)\n        }\n      }\n    },\n    _ => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    }\n  }\n}\n\nlet rec parse_toplevel_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_toplevel_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_toplevel_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_toplevel_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_toplevel_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_toplevel_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let mut skip = pos + 2\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TEof => {\n                depth = 0\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          skip\n        },\n        _ => pos + 1\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, end) = parse_toplevel_struct_fields(tokens, br);\n      let final_pos = skip_derive(tokens, end)\n      (SStruct(exported, name, fields), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),\n    TIdent(ident_name) => if ident_name == \"effect\" {\n      parse_effect_stmt(tokens, pos + 1, true)\n    } else {\n      throw(String::concat(\"unexpected token in export: \", ident_name))\n    },\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(_) => {\n        let (first, after) = parse_export_name(tokens, pos + 1)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, first)\n        let (names, end) = parse_export_names_rest(tokens, after, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected after 'export': \\{actual}\")\n    }\n  }\n}\n\nlet parse_percent_symbol_name: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, label) -> {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nlet parse_extern_let_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type(tokens, cp);\n  (SExternLet(name, ty), end)\n}\n\nlet rec parse_module_body_with: ((Array[Token], Int) -> (Stmt, Int) with { Error }, Array[Token], Int, ArrayBuilder[Stmt]) -> (Array[Stmt], Int) with { Error } = (parse_stmt_fn, tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => {\n      let (stmt, next) = parse_stmt_fn(tokens, pos)\n      ArrayBuilder::push(b, stmt)\n      parse_module_body_with(parse_stmt_fn, tokens, next, b)\n    }\n  }\n}\n\nexport let rec parse_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => match peek(tokens, pos + 2) {\n        TIdent(name) => {\n          let br = expect_tk(tokens, pos + 3, \"{\")\n          {\n            let (stmts, end) = parse_module_body_with(parse_stmt, tokens, br, ArrayBuilder::new());\n            (SModule(true, name, stmts), end)\n          }\n        },\n        _ => throw(\"expected module name\")\n      },\n      _ => parse_export_stmt(tokens, pos + 1)\n    },\n    TModule => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let br = expect_tk(tokens, pos + 2, \"{\")\n        {\n          let (stmts, end) = parse_module_body_with(parse_stmt, tokens, br, ArrayBuilder::new());\n          (SModule(false, name, stmts), end)\n        }\n      },\n      _ => throw(\"expected module name\")\n    },\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, pos + 1),\n    TBench => parse_bench_stmt(tokens, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => match name {\n      \"effect\" => parse_effect_stmt(tokens, pos + 1, false),\n      \"extern\" => parse_extern_let_stmt(tokens, pos + 1),\n      \"use\" => throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\"),\n      _ => {\n      let (e, next) = parse_impl(tokens, pos, 0)\n      match peek(tokens, next) {\n        TEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssign(name, val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TPlusEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"+\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TMinusEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"-\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TStarEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"*\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TSlashEq => match e {\n          EIdent(name) => {\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\n            (SExpr(EAssignOp(name, \"/\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        _ => (SExpr(e), next)\n      }\n      }\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nexport let parse_program: (Array[Token]) -> Array[Stmt] with { Error } = (tokens) -> {\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      TImpl => {\n        let (stmt, next) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        ArrayBuilder::push(b, stmt)\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, pos)\n        ArrayBuilder::push(b, stmt)\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\n\nexport {\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n\n\n\n\n\nexport let parse_interp_expr: (Array[Token]) -> Expr with { Error } = (tokens) -> {\n  let (stmt, _) = parse_stmt(tokens, 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n\n\n\n\n\nexport let collect_interp_exprs: (Array[String]) -> Array[Expr] with { Error } = (parts) -> {\n  let plen = Array::length(parts)\n  let exprs = ArrayBuilder::new()\n  let mut i = 0\n  while i < plen {\n    let lit = Array::get(parts, i)\n    if String::length(lit) > 0 {\n      ArrayBuilder::push(exprs, EString(lit))\n    }\n    if i + 1 < plen {\n      let expr_src = Array::get(parts, i + 1)\n      let part_tokens = lex(expr_src)\n      let part_expr = parse_interp_expr(part_tokens)\n      ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\"), [\n        part_expr\n      ]))\n    }\n    i = i + 2\n  }\n  ArrayBuilder::freeze(exprs)\n}\n\n\n\nlet concat_exprs: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, lhs)\n  ArrayBuilder::push(b, rhs)\n  let args = ArrayBuilder::freeze(b)\n  ECall(EIdent(\"String::concat\"), args)\n}\n\nexport let fold_interp_exprs_loop: (Array[Expr], Int, Expr, Int) -> Expr = (result_arr, result_len, result0, j0) -> {\n  let mut result = result0\n  let mut j = j0\n  while j < result_len {\n    let rhs = Array::get(result_arr, j)\n    result = concat_exprs(result, rhs)\n    j = j + 1\n  }\n  result\n}\n\n\n\n\nexport let fold_interp_exprs_nonempty: (Array[Expr], Int) -> Expr = (result_arr, result_len) -> {\n  let first = Array::get(result_arr, 0)\n  fold_interp_exprs_loop(result_arr, result_len, first, 1)\n}\n\n\n\n\nexport let fold_interp_exprs: (Array[Expr]) -> Expr = (result_arr) -> {\n  let result_len = Array::length(result_arr)\n  if result_len == 0 {\n    EString(\"\")\n  } else {\n    fold_interp_exprs_nonempty(result_arr, result_len)\n  }\n}\n\n\n\nexport {\n  fold_interp_exprs\n}\n\n\n\nexport {\n  fold_interp_exprs\n}\n\n\n\n\n\nexport let rewrite_interp_string: (Array[String]) -> Expr with { Error } = (parts) -> {\n  let result_arr = collect_interp_exprs(parts)\n  fold_interp_exprs(result_arr)\n}\n\n\n\nexport {\n  rewrite_interp_string\n}\n\n\n\nexport {\n  rewrite_interp_string\n}\n\n\n\n\nexport let rec rewrite_interp: (Expr) -> Expr with { Error } = (e) -> {\n  match e {\n    EStringInterp(parts) => rewrite_interp_string(parts),\n    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\n    ECall(callee, args) => ECall(rewrite_interp(callee), for arg in args {\n      rewrite_interp(arg)\n    }),\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n\n\n\nexport {\n  rewrite_interp\n}\n\n\n\n\nexport let expand_interp_stmts: (Array[Stmt]) -> Unit with { Error } = (stmts) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n\n\nexport let strip_generic_type_params: (Array[Stmt]) -> Unit = (stmts) -> {\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n\n\n\n\n\n\n\n\n\nlet entry_declares_async_int: (Array[Stmt], String) -> Bool = (stmts, entry_name) -> {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, Some(ty), _) => if name == entry_name {\n        match ty {\n          TyFn(params, ret, Some(eff)) => if String::contains(eff, \"Async\") && Array::length(params) == 0 {\n            match ret {\n              TyName(rn) => if rn == \"Int\" {\n                found = true\n              } else {\n                ()\n              },\n              _ => ()\n            }\n          } else {\n            ()\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet maybe_wrap_async_component: (Bytes, Bool) -> Bytes = (bytes, wrap_async) -> {\n  if wrap_async {\n    comp_emit_component_wasm_async_trampolined_p1(bytes, \"run\", 120)\n  } else {\n    bytes\n  }\n}\n\nexport let compile_source_wasi_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)\n}\n\nexport let compile_source_wasi_only_rc: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)\n}\n\n\n\n\n\nexport {\n  expand_interp_stmts, compile_source_wasi_only, compile_source_wasi_only_rc, strip_generic_type_params\n}\n\n\n\nlet read_arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nlet own_host_string: (String) -> String = (value) -> {\n  String::concat(\"\", value)\n}\n\nlet profile_memory_mark: (Bool) -> Unit with { Env } = (enabled) -> {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\nlet compile_source_for_rc_flag: (String, String, String) -> Bytes with { Error } = (source, entry_name, rc_flag) -> {\n  if rc_flag == \"1\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\nexport let cli_main: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  let rc_flag = Env::get(\"VIBE_RC\")\n  let bytes = compile_source_for_rc_flag(source, entry_name, rc_flag)\n  profile_memory_mark(mark_memory)\n  Fs::write_bytes(output_path, bytes)\n  profile_memory_mark(mark_memory)\n  0\n}\n"
}

export let selfhost_cli_adapter_module_source = () -> String {
  "export enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat);\n  PStruct(String, Array[(String, Pat)])\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr, Option[String]);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr]);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EReturn(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[String], Array[(String, Array[TypeExpr])]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\n  STypeAlias(Bool, String, Array[String], TypeExpr);\n  STrait(Bool, String, Array[String]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SAliasDecl(String, String);\n  SLetPat(Pat, Expr);\n  SModule(Bool, String, Array[Stmt]);\n  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)])\n}\n\nexport let __to_string: (Int) -> String = (n) -> {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n\nexport let bytebuf_new: () -> Bytes = () -> {\n  Bytes::new()\n}\n\nexport let bytebuf_push: (Bytes, Int) -> Unit = (buf, byte) -> {\n  Bytes::push(buf, byte)\n}\n\nexport let bytebuf_push2: (Bytes, Int, Int) -> Unit = (buf, b1, b2) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport let bytebuf_push3: (Bytes, Int, Int, Int) -> Unit = (buf, b1, b2, b3) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport let bytebuf_push9: (Bytes, Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Unit = (buf, b1, b2, b3, b4, b5, b6, b7, b8, b9) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n\nexport let bytebuf_length: (Bytes) -> Int = (buf) -> {\n  Bytes::length(buf)\n}\n\nexport let bytebuf_push_buf: (Bytes, Bytes) -> Unit = (dst, src) -> {\n  Bytes::append(dst, src)\n}\n\nexport let bytebuf_to_bytes: (Bytes) -> Bytes = (buf) -> {\n  buf\n}\n\nexport let leb128_encode_s32: (Bytes, Int) -> Unit = (buf, value) -> {\n  if value >= (0 - 64) && value < 64 {\n    Bytes::push(buf, value&127)\n  } else {\n    if value >= (0 - 8192) && value < 8192 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = v>>7\n        if (v == 0) && (byte&64) == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          if (v == 0 - 1) && (byte&64) != 0 {\n            Bytes::push(buf, byte)\n            more = false\n          } else {\n            Bytes::push(buf, byte|128)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64: (Bytes, Int) -> Unit = (buf, value) -> {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32: (Bytes, Int) -> Unit = (buf, value) -> {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = (v>>7)&((1<<25) - 1)\n        if v == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          Bytes::push(buf, byte|128)\n        }\n      }\n    }\n  }\n}\n\nexport let bytebuf_push_string: (Bytes, String) -> Unit = (buf, s) -> {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section: (Bytes, Int, Bytes) -> Unit = (out, section_id, content) -> {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport let bytebuf_push_opcode_s64: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_opcode_u32: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, opcode)\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, opcode)\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      Bytes::push(buf, opcode)\n      leb128_encode_u32(buf, value)\n    }\n  }\n}\n\nexport let bytebuf_push_vec_header: (Bytes, Int) -> Unit = (buf, count) -> {\n  leb128_encode_u32(buf, count)\n}\n\nexport let bytebuf_push_opcode_u32_u32: (Bytes, Int, Int, Int) -> Unit = (buf, opcode, a, b) -> {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n\n\n\nlet clone_arr: (Array[String]) -> Array[String] = (arr) -> {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name: (Stmt) -> Option[String] = (stmt) -> {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet dce_array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {\n  let len = Array::length(arr)\n  let rec search: (Int) -> Bool = (i) -> {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref: (Array[String], Array[String], String) -> Int = (out, bound, name) -> {\n  if not(dce_array_contains_str(bound, name)) {\n    if not(dce_array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings: (Pat, Array[String]) -> Int = (pat, bound) -> {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    },\n    PStruct(_, _) => 0\n  }\n}\n\nlet rec collect_refs_into: (Expr, Array[String], Array[String]) -> Int = (expr, bound, out) -> {\n  match expr {\n    EIdent(name) => add_ref(out, bound, name),\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out),\n    EReturn(e) => collect_refs_into(e, bound, out),\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs: (Expr, Array[String]) -> Array[String] = (expr, bound) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet enqueue_reachable: (Array[String], Array[String], String) -> Unit = (reachable, queue, name) -> {\n  if not(dce_array_contains_str(reachable, name)) {\n    Array::push(reachable, name)\n    Array::push(queue, name)\n  }\n}\n\nlet collect_structural_refs_into_queue: (Stmt, Array[String], Array[String], Array[String]) -> Unit = (stmt, bound, reachable, queue) -> {\n  let refs = match stmt {\n    STest(_, expr) => collect_refs(expr, bound),\n    SBench(_, expr) => collect_refs(expr, bound),\n    SExpr(expr) => collect_refs(expr, bound),\n    _ => Array::slice([\n      \"\"\n    ], 0, 0)\n  }\n  let mut i = 0\n  while i < Array::length(refs) {\n    enqueue_reachable(reachable, queue, Array::get(refs, i))\n    i = i + 1\n  }\n}\n\nlet is_type_or_structural: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SEnum(_, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SEffectDef(_, _, _, _) => true,\n    SStruct(_, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    STrait(_, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    SAliasDecl(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, entry_names) -> {\n  if Array::length(stmts) == 0 {\n    Array::slice(stmts, 0, 0)\n  } else {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if dce_array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        },\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n  }\n}\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Option[String]);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[String], Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)]);\n  TDAlias(String, Array[String], Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\n  EnvFlat(Array[(String, Type)]);\n  EnvCached(Map[String, Type], TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst);\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst)\n}\n\n\nexport let env_bind: (TypeEnv, String, Type) -> TypeEnv = (env, name, ty) -> {\n  match env {\n    EnvCached(cache, rest) => EnvCached(cache, EnvBind(name, ty, rest)),\n    _ => EnvBind(name, ty, env)\n  }\n}\n\nexport let env_cache: (TypeEnv) -> TypeEnv = (env) -> {\n  let is_empty = match env {\n    EnvEmpty => true,\n    _ => false\n  }\n  if is_empty {\n    EnvEmpty\n  } else {\n    let names = ArrayBuilder::new()\n    let types = ArrayBuilder::new()\n    let mut cur = env\n    let mut done = false\n    while !done {\n      match cur {\n        EnvEmpty => {\n          done = true\n        },\n        EnvBind(n, ty, rest) => {\n          ArrayBuilder::push(names, n)\n          ArrayBuilder::push(types, ty)\n          cur = rest\n        },\n        EnvTraitDef(_, _, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImpl(_, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImplGen(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvFlat(bindings) => {\n          let mut j = 0\n          while j < Array::length(bindings) {\n            let (n, ty) = Array::get(bindings, j)\n            ArrayBuilder::push(names, n)\n            ArrayBuilder::push(types, ty)\n            j = j + 1\n          }\n          done = true\n        },\n        EnvCached(_, rest) => {\n          cur = rest\n        }\n      }\n    }\n    let na = ArrayBuilder::freeze(names)\n    let ta = ArrayBuilder::freeze(types)\n    let cache = MapBuilder::new()\n    let len = Array::length(na)\n    let mut i = 0\n    while i < len {\n      let idx = len - i - 1\n      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))\n      i = i + 1\n    }\n    EnvCached(MapBuilder::freeze(cache), env)\n  }\n}\n\nexport let fresh_var: (Int) -> (Type, Int) = (c) -> {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in: (Int, Type) -> Bool = (id, ty) -> {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let env_lookup: (TypeEnv, String) -> Option[Type] = (env, name) -> {\n  let mut cur = env\n  let mut result = None\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(n, ty, rest) => if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(bindings) => {\n        let mut j = 0\n        while j < Array::length(bindings) && !done {\n          let (n, ty) = Array::get(bindings, j)\n          if n == name {\n            result = Some(ty)\n            done = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !done {\n          done = true\n        }\n      },\n      EnvCached(cache, rest) => if Map::has_key(cache, name) {\n        result = Some(Map::get(cache, name))\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  result\n}\n\nexport let env_bind_all: (TypeEnv, Array[(String, Type)]) -> TypeEnv = (env, bindings) -> {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while i < len {\n    let (name, ty) = Array::get(bindings, i)\n    acc = env_bind(acc, name, ty)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef: (Array[TypeDef], String) -> Option[TypeDef] = (defs, name) -> {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _, _) => n,\n        TDStruct(n, _) => n,\n        TDAlias(n, _, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let subst_lookup: (Subst, Int) -> Option[Type] = (s, id) -> {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  let key = __to_string(id)\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => if i == id {\n        out = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\n        out = Some(Map::get(cache, key))\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let rec trait_supers: (TypeEnv, String) -> Array[String] = (env, name) -> {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\n    EnvFlat(_) => empty,\n    EnvCached(_, rest) => trait_supers(rest, name)\n  }\n}\n\nlet rec array_has_int: (Array[Int], Int, Int) -> Bool = (arr, val, i) -> {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if Array::get(arr, i) == val {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet int_array_has: (Array[Int], Int) -> Bool = (arr, v) -> {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while !sdone {\n    if si >= slen {\n      sdone = true\n    } else if Array::get(arr, si) == v {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nexport let rec subst_apply: (Subst, Type) -> Type = (s, ty) -> {\n  match ty {\n    CtInt => ty,\n    CtBool => ty,\n    CtString => ty,\n    CtUnit => ty,\n    CtDouble => ty,\n    CtChar => ty,\n    CtBytes => ty,\n    CtUnknown => ty,\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while !done {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          },\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, effect_name) => {\n      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(items) {\n          Array::push(out, subst_apply(s, Array::get(items, i)))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(apply_params(params), subst_apply(s, ret), effect_name)\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtNamed(name, args) => CtNamed(name, for arg in args {\n      subst_apply(s, arg)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec trait_defined: (TypeEnv, String) -> Bool = (env, name) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string: (Type) -> String = (ty) -> {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while vi < vlen {\n        let v = String::concat(\"?t\", __to_string(Array::get(vars, vi)))\n        let next = if vi > 0 {\n          String::concat(vacc, String::concat(\" \", v))\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      String::concat(\"forall \", String::concat(vacc, String::concat(\". \", type_to_string(body))))\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => String::concat(\"Array[\", String::concat(type_to_string(elem), \"]\")),\n    CtOption(elem) => String::concat(\"Option[\", String::concat(type_to_string(elem), \"]\")),\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(name, String::concat(\"[\", String::concat(joined, \"]\")))\n    },\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(\"(\", String::concat(joined, \")\"))\n    },\n    CtFn(params, ret, effect_name) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      let ret_text = type_to_string(ret)\n      let base = String::concat(\"(\", String::concat(joined, String::concat(\") -> \", ret_text)))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with {\", String::concat(name, \"}\"))),\n        None => base\n      }\n    }\n  }\n}\n\nlet empty_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nexport let env_lookup_flat: (Array[(String, Type)], String) -> Option[Type] = (bindings, name) -> {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let resolve_builtin: (String) -> Option[Type] = (name) -> {\n  if name == \"Int\" || name == \"i32\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" || name == \"f64\" || name == \"Float\" || name == \"f32\" {\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"i64\"\n  || name == \"u8\"\n  || name == \"u16\"\n  || name == \"u32\"\n  || name == \"u64\"\n  || name == \"i16\"\n  || name == \"v128\" {\n    Some(CtNamed(name, empty_type_args()))\n  }\n  else None\n}\n\nexport let subst_add_bound: (Subst, Int, Array[String]) -> Subst = (s, id, bounds) -> {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds: () -> Array[(Int, Array[String])] = () -> {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet rec int_bounds_has_id: (Array[(Int, Array[String])], Int, Int) -> Bool = (pairs, id, i) -> {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if pid == id {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup: (Array[(Int, Array[String])], Int, Int) -> Array[String] = (pairs, id, i) -> {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if pid == id {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_int_lookup_or: (Array[(Int, Int)], Int, Int, Int) -> Int = (pairs, key, fallback, i) -> {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if k == key {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nexport let instantiate: (Type, Int) -> (Type, Int, Array[(Int, Array[String])]) = (ty, c) -> {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      while bi < blen {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      (subst_apply(inst_s, body), c1, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let rec trait_is_subtrait: (TypeEnv, String, String) -> Bool = (env, sub, super_name) -> {\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while !sdone {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec collect_tvars_walk: (Type, Array[Int]) -> Int = (t, out) -> {\n  match t {\n    CtVar(id) => {\n      if !array_has_int(out, id, 0) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars: (Type) -> Array[Int] = (ty) -> {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nlet empty_env_bindings: () -> Array[(String, Type)] = () -> {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings: (TypeEnv) -> Array[(String, Type)] = (env) -> {\n  match env {\n    EnvFlat(bindings) => bindings,\n    _ => {\n      let out = empty_env_bindings()\n      let mut cur = env\n      let mut done = false\n      while !done {\n        match cur {\n          EnvEmpty => {\n            done = true\n          },\n          EnvBind(name, ty, rest) => {\n            Array::push(out, (name, ty))\n            cur = rest\n          },\n          EnvTraitDef(_, _, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImpl(_, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImplGen(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvFlat(bindings) => {\n            let mut j = 0\n            while j < Array::length(bindings) {\n              Array::push(out, Array::get(bindings, j))\n              j = j + 1\n            }\n            done = true\n          },\n          EnvCached(_, rest) => {\n            cur = rest\n          }\n        }\n      }\n      out\n    }\n  }\n}\n\nlet string_array_equal: (Array[String], Array[String]) -> Bool = (left, right) -> {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else if Array::get(left, i) != Array::get(right, i) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet option_string_equal: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  match left {\n    Some(left_name) => match right {\n      Some(right_name) => left_name == right_name,\n      None => false\n    },\n    None => match right {\n      Some(_) => false,\n      None => true\n    }\n  }\n}\n\nlet is_effect_var_name: (String) -> Bool = (name) -> {\n  String::length(name) == 1 &&\n  String::char_code_at(name, 0) >= 97 &&\n  String::char_code_at(name, 0) <= 122\n}\n\nlet effect_names_compatible: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  if option_string_equal(left, right) {\n    true\n  } else {\n    match left {\n      Some(left_name) => if is_effect_var_name(left_name) {\n        true\n      } else {\n        match right {\n          Some(right_name) => is_effect_var_name(right_name),\n          None => false\n        }\n      },\n      None => match right {\n        Some(right_name) => is_effect_var_name(right_name),\n        None => false\n      }\n    }\n  }\n}\n\nexport let rec types_equal: (Type, Type) -> Bool = (a, b) -> {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,\n      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,\n      CtNamed(bname, bargs) =>\n      if aname != bname {\n        false\n      } else if Array::length(aargs) != Array::length(bargs) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while !tae_done {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else {\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\n              tae_i = tae_i + 1\n            } else {\n              tae_result = false\n              tae_done = true\n            }\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if Array::length(aelems) != Array::length(belems) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while !tae_done2 {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else {\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\n              tae_i2 = tae_i2 + 1\n            } else {\n              tae_result2 = false\n              tae_done2 = true\n            }\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, aeffect) => match b {\n      CtFn(bparams, bret, beffect) =>\n      if Array::length(aparams) != Array::length(bparams) {\n        false\n      } else if effect_names_compatible(aeffect, beffect) {\n        let tae_len3 = Array::length(aparams)\n        let mut tae_i3 = 0\n        let mut tae_result3 = true\n        let mut tae_done3 = false\n        while !tae_done3 {\n          if tae_i3 >= tae_len3 {\n            tae_done3 = true\n          } else {\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\n              tae_i3 = tae_i3 + 1\n            } else {\n              tae_result3 = false\n              tae_done3 = true\n            }\n          }\n        }\n        if tae_result3 {\n          types_equal(aret, bret)\n        } else {\n          false\n        }\n      } else {\n        false\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\n        false\n      } else if Array::length(abounds) != Array::length(bbounds) {\n        false\n      } else {\n        let vlen = Array::length(avars)\n        let mut vi = 0\n        let mut vresult = true\n        let mut vdone = false\n        while !vdone {\n          if vi >= vlen {\n            vdone = true\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\n            vresult = false\n            vdone = true\n          } else {\n            vi = vi + 1\n          }\n        }\n        if vresult {\n          let fbe_len = Array::length(abounds)\n          let mut fbe_i = 0\n          let mut fbe_result = true\n          let mut fbe_done = false\n          while !fbe_done {\n            if fbe_i >= fbe_len {\n              fbe_done = true\n            } else {\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n              if lvar != rvar {\n                fbe_result = false\n                fbe_done = true\n              } else if Array::length(lbounds) != Array::length(rbounds) {\n                fbe_result = false\n                fbe_done = true\n              } else {\n                if string_array_equal(lbounds, rbounds) {\n                  fbe_i = fbe_i + 1\n                } else {\n                  fbe_result = false\n                  fbe_done = true\n                }\n              }\n            }\n          }\n          if fbe_result {\n            types_equal(abody, bbody)\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      }\n      ,\n      _ => false\n    }\n  }\n}\n\nexport let rec unify: (Type, Type, Subst) -> Option[Subst] = (a, b, s) -> {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, aeffect) => match tb {\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\n                    None\n                  }\n                  else if !effect_names_compatible(aeffect, beffect) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while !ul_done {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => unify(ra, rb, s2),\n                      None => None\n                    }\n                  },\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while !ul_done2 {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  },\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, _) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name == b_name && Array::length(b_args) == 0 {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtStruct(b_name) => if a_name == b_name && Array::length(a_args) == 0 {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name != b_name {\n                    None\n                  }\n                  else if Array::length(a_args) != Array::length(b_args) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while !ul_done3 {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  },\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let types_compatible: (Type, Type) -> Bool = (expected, actual) -> {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for: (TypeEnv, String, Type) -> Bool = (env, trait_name, new_target) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nlet rec type_implements_check_env: (TypeEnv, String, Type) -> Bool = (e, trait_name, resolved) -> {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nlet collect_subst_bounds_pairs: (Subst) -> Array[(Int, Array[String])] = (s) -> {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if !int_bounds_has_id(out, id, 0) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let generalize: (Subst, Type) -> Type = (s, ty) -> {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if Array::length(tvars) == 0 {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if Array::length(bounds) != 0 {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nlet rec type_implements_check_super: (TypeEnv, TypeEnv, String, Type) -> Bool = (e2, full_env, trait_name, resolved) -> {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nexport let rec type_implements_trait: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, trait_name) -> {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if slen == 0 {\n      false\n    }\n    else {\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n\n\n\n\n\nexport let version = \"0.0.1\"\n\n\n\nexport {\n  Type, Subst, unify, TypeDef, TypeEnv, env_bind, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, env_cache, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n\nexport {\n  Type, Subst, unify, TypeDef, TypeEnv, env_bind, env_cache, fresh_var, occurs_in, env_lookup, generalize, instantiate, subst_apply, types_equal, env_bind_all, find_typedef, subst_lookup, trait_supers, collect_tvars, trait_defined, type_to_string, env_lookup_flat, resolve_builtin, subst_add_bound, types_compatible, env_flat_bindings, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n\n\n\nlet one_super: (String) -> Array[String] = (name) -> {\n  [\n    name\n  ]\n}\n\nlet no_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nexport let satisfies_bound: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, bound) -> {\n  type_implements_trait(env, s, ty, bound)\n}\n\nexport let check_bounds_satisfied: (TypeEnv, Subst, Type, Array[String]) -> Array[String] = (env, s, ty, bounds) -> {\n  let result = empty_strings()\n  let len = Array::length(bounds)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let bound = Array::get(bounds, i)\n      if not(satisfies_bound(env, s, ty, bound)) {\n        Array::push(result, bound)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let register_builtin_traits: (TypeEnv) -> TypeEnv = (env) -> {\n  let no_supers = empty_strings()\n  let eq_supers = one_super(\"Eq\")\n  let i64_type = CtNamed(\"i64\", no_type_args())\n  let u8_type = CtNamed(\"u8\", no_type_args())\n  let u16_type = CtNamed(\"u16\", no_type_args())\n  let u32_type = CtNamed(\"u32\", no_type_args())\n  let u64_type = CtNamed(\"u64\", no_type_args())\n  let i16_type = CtNamed(\"i16\", no_type_args())\n  let e1 = EnvTraitDef(\"Eq\", no_supers, false, env)\n  let e2 = EnvTraitDef(\"Ord\", eq_supers, false, e1)\n  let e3 = EnvTraitDef(\"Add\", no_supers, false, e2)\n  let e4 = EnvTraitDef(\"Sub\", no_supers, false, e3)\n  let e5 = EnvTraitDef(\"Mul\", no_supers, false, e4)\n  let e6 = EnvTraitDef(\"Div\", no_supers, false, e5)\n  let e7 = EnvTraitImpl(\"Eq\", CtInt, e6)\n  let e8 = EnvTraitImpl(\"Eq\", CtDouble, e7)\n  let e9 = EnvTraitImpl(\"Eq\", CtString, e8)\n  let e10 = EnvTraitImpl(\"Eq\", CtBool, e9)\n  let e11 = EnvTraitImpl(\"Ord\", CtInt, e10)\n  let e12 = EnvTraitImpl(\"Ord\", CtDouble, e11)\n  let e13 = EnvTraitImpl(\"Ord\", CtString, e12)\n  let e14 = EnvTraitImpl(\"Add\", CtInt, e13)\n  let e15 = EnvTraitImpl(\"Add\", CtDouble, e14)\n  let e16 = EnvTraitImpl(\"Sub\", CtInt, e15)\n  let e17 = EnvTraitImpl(\"Sub\", CtDouble, e16)\n  let e18 = EnvTraitImpl(\"Mul\", CtInt, e17)\n  let e19 = EnvTraitImpl(\"Mul\", CtDouble, e18)\n  let e20 = EnvTraitImpl(\"Div\", CtInt, e19)\n  let e21 = EnvTraitImpl(\"Div\", CtDouble, e20)\n  let e22 = EnvTraitImpl(\"Eq\", i64_type, e21)\n  let e23 = EnvTraitImpl(\"Eq\", u8_type, e22)\n  let e24 = EnvTraitImpl(\"Eq\", u16_type, e23)\n  let e25 = EnvTraitImpl(\"Eq\", u32_type, e24)\n  let e26 = EnvTraitImpl(\"Eq\", u64_type, e25)\n  let e27 = EnvTraitImpl(\"Eq\", i16_type, e26)\n  let e28 = EnvTraitImpl(\"Ord\", i64_type, e27)\n  let e29 = EnvTraitImpl(\"Ord\", u8_type, e28)\n  let e30 = EnvTraitImpl(\"Ord\", u16_type, e29)\n  let e31 = EnvTraitImpl(\"Ord\", u32_type, e30)\n  let e32 = EnvTraitImpl(\"Ord\", u64_type, e31)\n  let e33 = EnvTraitImpl(\"Ord\", i16_type, e32)\n  let e34 = EnvTraitImpl(\"Add\", i64_type, e33)\n  let e35 = EnvTraitImpl(\"Add\", u8_type, e34)\n  let e36 = EnvTraitImpl(\"Add\", u16_type, e35)\n  let e37 = EnvTraitImpl(\"Add\", u32_type, e36)\n  let e38 = EnvTraitImpl(\"Add\", u64_type, e37)\n  let e39 = EnvTraitImpl(\"Add\", i16_type, e38)\n  let e40 = EnvTraitImpl(\"Sub\", i64_type, e39)\n  let e41 = EnvTraitImpl(\"Sub\", u8_type, e40)\n  let e42 = EnvTraitImpl(\"Sub\", u16_type, e41)\n  let e43 = EnvTraitImpl(\"Sub\", u32_type, e42)\n  let e44 = EnvTraitImpl(\"Sub\", u64_type, e43)\n  let e45 = EnvTraitImpl(\"Sub\", i16_type, e44)\n  let e46 = EnvTraitImpl(\"Mul\", i64_type, e45)\n  let e47 = EnvTraitImpl(\"Mul\", u8_type, e46)\n  let e48 = EnvTraitImpl(\"Mul\", u16_type, e47)\n  let e49 = EnvTraitImpl(\"Mul\", u32_type, e48)\n  let e50 = EnvTraitImpl(\"Mul\", u64_type, e49)\n  let e51 = EnvTraitImpl(\"Mul\", i16_type, e50)\n  let e52 = EnvTraitImpl(\"Div\", i64_type, e51)\n  let e53 = EnvTraitImpl(\"Div\", u8_type, e52)\n  let e54 = EnvTraitImpl(\"Div\", u16_type, e53)\n  let e55 = EnvTraitImpl(\"Div\", u32_type, e54)\n  let e56 = EnvTraitImpl(\"Div\", u64_type, e55)\n  let e57 = EnvTraitImpl(\"Div\", i16_type, e56)\n  e57\n}\n\nexport let validate_supers_defined: (TypeEnv, Array[String]) -> Array[String] = (env, supers) -> {\n  let result = empty_strings()\n  let len = Array::length(supers)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let name = Array::get(supers, i)\n      if not(trait_defined(env, name)) {\n        Array::push(result, name)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let validate_impl_no_overlap: (TypeEnv, String, Type) -> Bool = (env, trait_name, target) -> {\n  not(impls_overlap_for(env, trait_name, target))\n}\n\nexport let canonical_builtin_name: (String) -> String = (name) -> {\n  match name {\n    \"Fs::ReadFile\" => \"Fs::read_file\",\n    \"Fs::WriteFile\" => \"Fs::write_file\",\n    \"Fs::ReadBytes\" => \"Fs::read_bytes\",\n    \"Fs::WriteBytes\" => \"Fs::write_bytes\",\n    \"Fs::Exists\" => \"Fs::exists\",\n    \"Fs::StatToken\" => \"Fs::stat_token\",\n    \"Fs::ReadDir\" => \"Fs::readdir\",\n    \"Fs::IsDir\" => \"Fs::is_dir\",\n    \"Fs::IsFile\" => \"Fs::is_file\",\n    \"Fs::Mkdir\" => \"Fs::mkdir\",\n    \"Fs::Getcwd\" => \"Fs::getcwd\",\n    \"Fs::Chdir\" => \"Fs::chdir\",\n    \"Fs::Remove\" => \"Fs::remove\",\n    \"Fs::Copy\" => \"Fs::copy\",\n    \"Fs::Append\" => \"Fs::append\",\n    \"Env::Get\" => \"Env::get\",\n    \"Env::ArgsLen\" => \"Env::args_len\",\n    \"Env::ArgsGet\" => \"Env::args_get\",\n    \"Profiler::NowUs\" => \"Profiler::now_us\",\n    _ => name\n  }\n}\n\n\n\nlet array_no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet array_one_param: (Type) -> Array[Type] = (a) -> {\n  let arr = array_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet array_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\n  let arr = array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet array_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\n  let arr = array_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nlet lookup_array_get: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::get\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_array_new: (String) -> Option[Type] = (name) -> {\n  if name == \"array_new\" {\n    Some(CtFn(array_no_params(), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_set: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::set\" {\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_array_push: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::push\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_array_slice: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::slice\" {\n    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_concat: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::concat\" {\n    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_map: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::map\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnknown, None)),\n      CtArray(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_fold: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::fold\" {\n    Some(CtFn(\n      array_three_params(\n        CtArray(CtUnknown),\n        CtUnknown,\n        CtFn(array_two_params(CtUnknown, CtUnknown), CtUnknown, None)\n      ),\n      CtUnknown,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_filter: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::filter\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtArray(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_foreach: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::foreach\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(