let cli_adapter_source_160 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_rewrite_impl.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr\n}\n\nimport ./preprocess_interp_string.vibe {\n  rewrite_interp_string\n}\n\n//# Functions\n\nexport let rec rewrite_interp: (Expr) -> Expr with { Error } = (e) -> {\n  match e {\n    EStringInterp(parts) => rewrite_interp_string(parts),\n    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\n    ECall(callee, args, off) => ECall(rewrite_interp(callee), for arg in args {\n      rewrite_interp(arg)\n    }, off),\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n")
}

let cli_adapter_source_161 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_compile.vibe",
"//# Imports\n\nimport .. / .. / .. / checker / checker_stmt.vibe {\n  check_program\n}\n\nimport .. / .. / .. / codegen / wasi {\n  compile_wasi_module_impl, compile_wasi_module_coverage_impl, compile_wasi_module_rc_impl, compile_wasi_module_rc_shadow_impl\n}\n\nimport .. / .. / .. / syntax / lexer.vibe {\n  lex\n}\n\nimport .. / .. / .. / syntax / parser.vibe {\n  parse_program\n}\n\nimport ./preprocess_interp.vibe {\n  expand_interp_stmts\n}\n\nimport ./preprocess_strip.vibe {\n  strip_generic_type_params\n}\n\nimport .. / .. / .. / core / ast.vibe {\n  Stmt, TypeExpr\n}\n\nimport .. / .. / .. / component_codegen.vibe {\n  comp_emit_component_wasm_async_trampolined_p1\n}\n\n//# Functions\n\n// M1b-2c (docs/spec/wasi-p3-async.md): does the entry declare\n// `() -> Int with { Async }` (no params)? If so its compiled core wasm should be\n// wrapped into an async-lifted WASM component. Detected from the declared TyFn\n// effect annotation (before generic-param stripping).\nlet entry_declares_async_int: (Array[Stmt], String) -> Bool = (stmts, entry_name) -> {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, opt_ty, _) => if name == entry_name {\n        // Flattened patterns: the pinned selfhost seed does not bind variables\n        // inside nested constructor patterns (e.g. `Some(ty)` as a sub-pattern),\n        // so match each Option level separately to stay seed-buildable\n        // (docs/selfhost-bootstrap.md, new-feature rule).\n        match opt_ty {\n          Some(ty) => match ty {\n            TyFn(params, ret, opt_eff) => match opt_eff {\n              Some(eff) => if String::contains(eff, \"Async\") && Array::length(params) == 0 {\n                match ret {\n                  TyName(rn) => if rn == \"Int\" {\n                    found = true\n                  } else {\n                    ()\n                  },\n                  _ => ()\n                }\n              } else {\n                ()\n              },\n              None => ()\n            },\n            _ => ()\n          },\n          None => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Wrap the core wasm into an async component when the entry is async. The\n// trampoline imports/aliases the main export by name \"run\", so this narrow PoC\n// only triggers for an entry named \"run\".\nlet maybe_wrap_async_component: (Bytes, Bool) -> Bytes = (bytes, wrap_async) -> {\n  if wrap_async {\n    comp_emit_component_wasm_async_trampolined_p1(bytes, \"run\", 120)\n  } else {\n    bytes\n  }\n}\n\nexport let compile_source_wasi_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params (see merge_sources.vibe).\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)\n}\n\n// Coverage (#cov): same source pipeline as compile_source_wasi_only but routes\n// through the coverage codegen, so compiling the flat compiler source under\n// VIBE_COVERAGE=1 yields an instrumented compiler (per-function hit bitmap +\n// `vibe_cov` section).\nexport let compile_source_wasi_only_coverage: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_coverage_impl(stmts, entry_name)\n}\n\n// ADR-0055 #493 cutover: same pipeline on the Perceus RC codegen path. Lets the\n// selfbuild / bootstrap / e2e gates compile real programs (incl. the whole\n// compiler) under RC via an env toggle in cli_main — the full-scale validity +\n// correctness signal the memory-limited test probes cannot produce.\nexport let compile_source_wasi_only_rc: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)\n}\n\n// #715 recurrence guard: same RC pipeline, but the produced module carries\n// shadow-liveness instrumentation -- a byte per heap address marking freed\n// blocks, with an `unreachable` trap on the FIRST dup-of-freed or\n// drop-of-freed operation. Turns \"moving target\" free-list corruption into a\n// deterministic trap at the faulting operation. Debug-only (VIBE_RC=shadow):\n// adds a memory-reservation pad and per-dup/drop checks, so never the default.\nexport let compile_source_wasi_only_rc_shadow: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_shadow_impl(stmts, entry_name), wrap_async)\n}\n")
}

let cli_adapter_source_162 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/path_utils.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr, Stmt\n}\n\n//# Functions\n\nlet empty_stmt_array: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExpr(EInt(0))\n  ], 0, 0)\n}\n\n//# Misc\n\nexport {\n  empty_stmt_array\n}\n")
}

let cli_adapter_source_163 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/merge_sources.vibe",
"//# Imports\n\nimport .. / .. / .. / checker / checker_stmt.vibe {\n  check_program\n}\n\nimport .. / .. / .. / codegen / wasi {\n  compile_wasi_module_impl\n}\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr, Stmt\n}\n\nimport .. / .. / .. / module_graph_path.vibe {\n  dir_of_path, path_set_add, path_set_contains, path_set_new, resolve_import_path, resolve_import_path_candidates\n}\n\nimport .. / .. / .. / syntax / lexer.vibe {\n  lex\n}\n\nimport .. / .. / .. / syntax / parser.vibe {\n  parse_program\n}\n\nimport .. / .. / .. / syntax / printer.vibe {\n  print_program\n}\n\nimport .. / .. / .. / syntax / import_alias_rewrite.vibe {\n  ExportRenamePlan,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport ./path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ./preprocess.vibe {\n  expand_interp_stmts, strip_generic_type_params\n}\n\nimport .. / .. / .. / loader / index.vibe {\n  ingest_source_text_fs\n}\n\n//# Functions\n\nlet string_array_contains_local: (Array[String], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #726: directory-style imports (`import ../core { .. }` -> core/index.vibe)\n// need the CANDIDATE list + existence probe; the single-candidate\n// resolve_import_path returns `core.vibe`, which does not exist. Falls back\n// to the first candidate so a genuinely missing import still reports its\n// plain-file path.\nlet resolve_existing_import_path: (String, String, String) -> String with { Fs } = (base_dir, raw_path, self_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    // Skip a candidate that IS the importing file: `export ./codegen` inside\n    // codegen.vibe means the codegen/ directory, never a self-import (which\n    // would only recurse/cycle). Mirrors loader/header_cache.resolve_path_fs.\n    if candidate == self_path {\n      i = i + 1\n    } else if Fs::exists(candidate) {\n      found = candidate\n      i = Array::length(candidates)\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\n// #716: collision-def fallback. `excluded_locals` are the import locals the\n// export-rename plan already rewrites — emitting an inline copy for those too\n// would double-bind the local. The copy gets the target file's export renames\n// applied first, so its body's references to renamed sibling exports stay\n// consistent with the merged program.\nlet append_fs_import_alias_collision_defs: (Array[Stmt], String, Array[Stmt], ExportRenamePlan, Array[String]) -> Unit with { Error, Fs } = (merged, current_path, stmts, plan, excluded_locals) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {\n      let resolved = resolve_existing_import_path(base_dir, raw_path, current_path)\n      // Builtin read + ingest, same as collect_parsed_sources_recursive\n      // (flatten-lane wiring constraint / #741).\n      let source = ingest_source_text_fs(resolved, Fs::read_file(resolved))\n      let source_stmts = namespace_private_value_stmts(\n        resolved,\n        apply_export_renames_stmts(\n          parse_program(lex(source)),\n          export_plan_renames_for(plan, resolved)\n        )\n      )\n      let mut j = 0\n      let mut done = false\n      while j < Array::length(source_stmts) && !done {\n        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n          Some(local_stmt) => {\n            Array::push(merged, local_stmt)\n            Array::push(emitted, local)\n            done = true\n          },\n          None => ()\n        }\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n}\n\n// `visited` is a `path_set` (#533): this recursion runs once per import\n// EDGE, so a linear `contains_path` scan against a visited list that\n// grows to every module of the program was O(edges × modules). The set\n// is membership-only here — file order comes from the recursion itself\n// (dependencies first), so no ordering constraint is lost.\n//\n// #716: the recursion only PARSES and orders the files; appending happens in\n// a second pass once the whole program is known, because the export-rename\n// plan (ambiguous exported names + re-export facades) needs every file's\n// export surface before any file can be rewritten.\nlet rec collect_parsed_sources_recursive: (String, Array[String], Array[Array[Stmt]], Array[Array[String]]) -> Unit with { Error, Fs } = (path, file_paths, file_stmts, visited) -> {\n  if path_set_contains(visited, path) {\n    ()\n  }\n  else {\n    path_set_add(visited, path)\n    // Builtin read, NOT `perform Fs::ReadFile`. The original reason (#737's\n    // deep-continuation resume corruption) no longer reproduces — the\n    // selfhost gate keeps a recursive-perform + in-language-handler canary —\n    // but the FLATTEN lane (the adapter binary run with\n    // VIBE_EMIT_MERGED_SOURCE=1) installs no Fs handler and does not wire\n    // this path's performs to host imports, so a perform here throws an\n    // unhandled effect at flatten time. Mockable reads need that lane's\n    // effect wiring first.\n    // #741: ingestion (require-pin blanking + .vibei contract desugar) applies\n    // in THIS lane too, so a contract package in the graph resolves to its\n    // conformance-checked facade instead of a parse error on bodyless decls.\n    let source = ingest_source_text_fs(path, Fs::read_file(path))\n    let stmts = parse_program(lex(source))\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_existing_import_path(base_dir, raw_path, path)\n          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_existing_import_path(base_dir, raw_path, path)\n          collect_parsed_sources_recursive(resolved, file_paths, file_stmts, visited)\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    Array::push(file_paths, path)\n    Array::push(file_stmts, stmts)\n  }\n}\n\nlet collect_merged_stmts_recursive: (String, Array[Stmt], Array[Array[String]]) -> Unit with { Error, Fs } = (entry_path, merged, visited) -> {\n  let file_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_stmts = Array::slice([\n    empty_stmt_array()\n  ], 0, 0)\n  collect_parsed_sources_recursive(entry_path, file_paths, file_stmts, visited)\n  let plan = build_export_rename_plan(file_paths, file_stmts, entry_path)\n  let mut fi = 0\n  while fi < Array::length(file_paths) {\n    let path = Array::get(file_paths, fi)\n    let stmts = Array::get(file_stmts, fi)\n    let export_renamed = if path == entry_path {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if path == entry_path {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_fs_import_alias_collision_defs(merged, path, stmts, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    fi = fi + 1\n  }\n}\n\n// #726: the merged whole program AS SOURCE TEXT. Resolves imports from the\n// FS, runs the full merge machinery (export-rename plan, private\n// namespacing, import-alias rewriting — the same pipeline the FS compile\n// uses), and prints the merged statements. This replaces the Python\n// flattener in scripts/generate_selfhost_bundle.sh: the old flattener\n// stripped import/export lines and concatenated files verbatim, leaving\n// duplicate top-level defs resolved by fn-table first-match roulette; the\n// merge machinery renames them so the flat source has ZERO duplicates and\n// carries the #716 visibility guarantees. Comments are dropped (printer\n// output) — acceptable for a generated bundle artifact.\nexport let merged_program_source_fs: (String) -> String with { Error, Fs } = (entry_path) -> {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  print_program(stmts)\n}\n\nexport let compile_file_wasi_only: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let stmts = empty_stmt_array()\n  let visited = path_set_new()\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  // Type-check BEFORE stripping generic type params: a generic function like\n  // `[T: Ord](a: T, b: T) -> T { a < b }` only checks if `T` is a bound type\n  // variable. Stripping first leaves `T` a concrete `CtNamed(\"T\")`, so the\n  // Ord-constrained `<` fails to resolve. Stripping happens after the check,\n  // for monomorphic codegen.\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\n//# Misc\n\nexport {\n  collect_merged_stmts_recursive\n}\n\nexport {\n  compile_file_wasi_only, collect_merged_stmts_recursive\n}\n")
}

let cli_adapter_source_164 = () -> (String, String) {
  ("vibe/compiler/entry/compiler/file_compile/index.vibe",
"//# Imports\n\nimport ../../../syntax/lexer.vibe {\n  lex, lex_with_offsets,\n}\n\nimport ../../../syntax/parser.vibe {\n  parse_program, parse_program_located\n}\n\nimport ../../../syntax/import_alias_rewrite.vibe {\n  ExportRenamePlan,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport ../../../codegen/index.vibe {\n  compile_module, compile_wasi_module, compile_wasi_module_rc, compile_wasi_module_coverage, compile_wasi_module_trace, compile_wasi_module_break\n}\n\nimport ../../../codegen/common_base/index.vibe {\n  DbgProv\n}\n\nimport ../../../codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\nimport ../../../loader/index.vibe {\n  collect_source_groups_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\nimport ../../../module_graph_path.vibe {\n  dir_of_path, resolve_import_path\n}\n\nimport ../../../core/dce.vibe {\n  dce_stmts\n}\n\nimport ../../../checker_effects.vibe {\n  file_tests_cacheable\n}\n\nimport ../../source_compile/wasi_only/path_utils.vibe {\n  empty_stmt_array\n}\n\nimport ../../../runtime/index.vibe {\n  TypeDb, db_new, db_set_source, db_typecheck, db_grouped_merged_source,\n  db_typecheck_fs, db_module_source, db_load_artifact, db_store_artifact\n}\n\nimport ../../../cache/persistent_cache.vibe {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_module_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  build_source_groups_fingerprint,\n  load_persistent_artifact,\n  store_persistent_artifact\n}\n\n//# Types\n\nexport effect Profiler {\n  NowUs -> Int\n}\n\n//# Functions\n\nlet profiler_now_us: () -> Int with { Profiler } = () -> {\n  perform Profiler::NowUs\n}\n\nlet elapsed_us_since: (Int) -> Int with { Profiler } = (start_us) -> {\n  let elapsed = profiler_now_us() - start_us\n  if elapsed < 0 {\n    0\n  } else {\n    elapsed\n  }\n}\n\nlet artifact_fingerprint_from_source: (String) -> String = (source) -> {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet seed_type_db_from_source_groups: (TypeDb, Array[(String, Array[(String, String)])]) -> TypeDb = (db, source_groups) -> {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nlet append_stmt_array: (Array[Stmt], Array[Stmt]) -> Unit = (dst, src) -> {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(dst, Array::get(src, i))\n    i = i + 1\n  }\n}\n\nlet flatten_source_groups_local: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (source_groups) -> {\n  let flat = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nlet string_array_contains: (Array[String], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet parse_program_for_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\n  handle {\n    // Interior-line breakpoints (span-arc step5): parse via the span-aware\n    // `parse_program_located` so EIdent nodes carry real source char-offsets\n    // (offset_to_line then maps them to lines for `vibe::dbg_line`). Offsets are\n    // inert for normal codegen (no codegen path reads them), so the default\n    // wasm output is unchanged — only the gated break path consumes them.\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    parse_program_located(tokens, starts, source)\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\n// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`\n// are the locals the export-rename plan already rewrites; the inline copy gets\n// the target file's export renames applied first.\nlet append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)], ExportRenamePlan, Array[String]) -> Unit with { Error } = (merged, current_path, stmts, sources, plan, excluded_locals) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(\n            resolved,\n            apply_export_renames_stmts(\n              parse_program_for_path(resolved, source),\n              export_plan_renames_for(plan, resolved)\n            )\n          )\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\n// #716: parse every source once and build the export-rename plan for the whole\n// program (the merge output of one file depends on the export surfaces of ALL\n// files: ambiguous exported names are renamed at their defs and at importing\n// files' references).\nlet parse_sources_for_merge: (Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } = (sources) -> {\n  let file_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_stmts = Array::slice([\n    empty_stmt_array()\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_for_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\n// One file's contribution to the merged program. `stmts` are the file's parsed\n// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule\n// (entry keeps its private names), and `plan`/`sources` drive the export-name\n// rewriting and the collision-def fallback.\nlet append_merged_stmts_for_file: (Array[Stmt], String, Array[Stmt], Bool, ExportRenamePlan, Array[(String, String)]) -> Unit with { Error } = (merged, path, stmts, is_entry_source, plan, sources) -> {\n  let export_renamed = if is_entry_source {\n    stmts\n  } else {\n    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n  }\n  let namespaced_stmts = if is_entry_source {\n    export_renamed\n  } else {\n    namespace_private_value_stmts(path, export_renamed)\n  }\n  if stmts_have_import_deep(stmts) {\n    let import_renames = collect_import_value_renames(plan, path, stmts)\n    let skipped_locals = collect_import_alias_collision_locals(stmts)\n    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))\n    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n  } else {\n    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n  }\n}\n\nlet build_merged_stmts_from_sources: (String, Array[(String, String)]) -> Array[Stmt] with { Error } = (entry_path, sources) -> {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let (file_paths, file_stmts) = parse_sources_for_merge(sources)\n  let plan_entry = if entry_path == \"\" {\n    if source_count > 0 {\n      Array::get(file_paths, source_count - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)\n    si = si + 1\n  }\n  merged\n}\n\nlet build_grouped_merged_stmts: (Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } = (source_groups) -> {\n  let merged = empty_stmt_array()\n  // #716: the plan spans ALL groups (imports cross group boundaries), so the\n  // flat source list is parsed once here and reused per group.\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  // #740: the is-entry flag must mean \"the LAST file of the WHOLE merge\"\n  // (the plan entry, whose exports stay unrenamed). It was `si ==\n  // source_count - 1` — the last file of EVERY GROUP — so every group\n  // tail (ripple/ripple.vibe, desugar_trait_dict.vibe, ...) skipped its\n  // export renames while callers were rewritten to the renamed names:\n  // \"undefined variable (local): <name>_exp_<path>\" at codegen.\n  let flat_total = Array::length(file_paths)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let path = Array::get(file_paths, flat_idx)\n      let stmts = Array::get(file_stmts, flat_idx)\n      append_merged_stmts_for_file(merged, path, stmts, flat_idx == flat_total - 1, plan, flat_sources)\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  merged\n}\n\n// Interior-line breakpoints (span-arc step5): the basename of a file path (text\n// after the last '/'). Used as the `vibe.dbgfiles` key the runner matches a\n// `--break <file>:<line>` spec against. String::concat-free (substring only).\nlet path_basename: (String) -> String = (p) -> {\n  let n = String::length(p)\n  let mut last = 0 - 1\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(p, i) == 47 {\n      last = i\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  String::substring(p, last + 1, n)\n}\n\n// Interior-line breakpoints: sorted char-offsets of each '\\n' in `src` (local\n// copy of the codegen helper, to avoid an entry->codegen import).\nlet file_newline_offsets: (String) -> Array[Int] = (src) -> {\n  let arr = Array::slice([\n    0\n  ], 0, 0)\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\n// Interior-line breakpoints (span-arc step5, multi-file): like\n// build_grouped_merged_stmts but ALSO records, per merged top-level statement,\n// which SOURCE FILE it came from — so codegen can map each statement's char\n// offset to a line IN ITS OWN FILE (offsets from different files collide after\n// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):\n//   file_basenames[k] / file_newlines[k]  — the k-th distinct source file\n//   stmt_file_id[s]                        — file id of merged top-level stmt s\n// Provenance is captured by measuring the merged-array length delta around each\n// source's append, so it stays aligned no matter how many statements a source\n// contributes; the append calls themselves mirror build_merged_stmts_from_sources\n// exactly, so `merged` is identical to the normal path.\nlet build_grouped_merged_stmts_prov: (Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } = (source_groups) -> {\n  let merged = empty_stmt_array()\n  let files = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_nls = Array::slice([\n    Array::slice([\n      0\n    ], 0, 0)\n  ], 0, 0)\n  let stmt_file_id = Array::slice([\n    0\n  ], 0, 0)\n  // #716: same whole-program plan as build_grouped_merged_stmts, so `merged`\n  // stays identical to the normal (non-break) merge.\n  let flat_sources = flatten_source_groups_local(source_groups)\n  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)\n  let plan_entry = if Array::length(file_paths) > 0 {\n    Array::get(file_paths, Array::length(file_paths) - 1)\n  } else {\n    \"\"\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  let mut flat_idx = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let source_count = Array::length(sources)\n    let mut si = 0\n    while si < source_count {\n      let (path, source) = Array::get(sources, si)\n      let file_id = Array::length(files)\n      Array::push(files, path_basename(path))\n      Array::push(file_nls, file_newline_offsets(source))\n      let before = Array::length(merged)\n      // #740: last-of-WHOLE-merge, not last-of-group (see the note in\n      // build_grouped_merged_stmts).\n      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), flat_idx == Array::length(file_paths) - 1, plan, flat_sources)\n      let after = Array::length(merged)\n      let mut k = before\n      while k < after {\n        Array::push(stmt_file_id, file_id)\n        k = k + 1\n      }\n      flat_idx = flat_idx + 1\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  (merged, files, file_nls, stmt_file_id)\n}\n\nlet prepare_file_fs_from_source_groups_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error } = (db, entry_path, source_groups) -> {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport let prepare_file_fs_cached: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, entry_path) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nexport let compile_file_fs_mode: (String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\n// #701 RC variant: same load/merge as compile_file_fs_mode \"no-dce\" but routes\n// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an\n// import-resolving / `vibe run` program actually honors VIBE_RC. Without this\n// the FS-compile path silently used the bump allocator regardless of VIBE_RC.\nexport let compile_file_fs_mode_rc: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_rc(merged_stmts, entry_name)\n}\n\n// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test\n// cache verdict to `meta_out` (when non-empty) before codegen — computed on the\n// MERGED stmts, so transitive imported-function effect rows are visible. \"1\" =\n// every test block is transitively effect-free → `vibe test` may cache/skip it.\n// Reached only on a successful compile (the program type-checks), so reading the\n// declared effect rows is sound. Env is read by the caller (the CLI adapter),\n// keeping this layer free of the Env effect.\nexport let compile_file_fs_mode_testmeta: (String, String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode, meta_out) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)\n  // but write it only AFTER codegen succeeds, so a failed compile leaves no\n  // stale sidecar.\n  let cacheable = if meta_out != \"\" {\n    file_tests_cacheable(merged_stmts)\n  } else {\n    false\n  }\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  if meta_out != \"\" {\n    Fs::write_file(meta_out, if cacheable {\n      \"1\"\n    } else {\n      \"0\"\n    })\n  } else {\n    ()\n  }\n  bytes\n}\n\n// Coverage (#cov): FS-mode compile with function-level hit instrumentation.\n// Same load/merge as compile_file_fs_mode \"no-dce\" but routes through the\n// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`\n// section. Used by `cli_main` under VIBE_COVERAGE=1.\nexport let compile_file_fs_mode_coverage: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_coverage(merged_stmts, entry_name)\n}\n\n// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call\n// execution-trace instrumentation. Same load/merge as compile_file_fs_mode\n// \"no-dce\" but routes through the trace codegen so the output wasm carries the\n// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under\n// VIBE_DEBUG=1.\nexport let compile_file_fs_mode_trace: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  compile_wasi_module_trace(merged_stmts, entry_name)\n}\n\n// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook\n// instrumentation at each user function entry. Same load/merge as\n// compile_file_fs_mode \"no-dce\" but routes through the break codegen so the\n// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under\n// VIBE_DEBUG_BREAK=1.\nexport let compile_file_fs_mode_break: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so\n  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every\n  // statement boundary, mapping each statement's char offset to a line in its OWN\n  // source file (multi-file: offsets from different files collide). `merged` is\n  // identical to the non-break merge.\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\n    files: dbg_files,\n    file_nls: dbg_file_nls,\n    stmt_file_id: dbg_stmt_file_id\n  })\n}\n\nexport let compile_file_fs_mode_profiled: (String, String, String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (entry_path, entry_name, mode) -> {\n  let total_start = profiler_now_us()\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let load_us = elapsed_us_since(load_start)\n  let type_start = profiler_now_us()\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let _ = next_db\n  let type_us = elapsed_us_since(type_start)\n  let bundle_start = profiler_now_us()\n  let _ = build_source_groups_fingerprint(source_groups)\n  let bundle_us = elapsed_us_since(bundle_start)\n  let parse_start = profiler_now_us()\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\n  let parse_us = elapsed_us_since(parse_start)\n  let compile_start = profiler_now_us()\n  let bytes = if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let compile_us = elapsed_us_since(compile_start)\n  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n}\n\nlet compile_file_fs_mode_cached_slow_profiled: (TypeDb, String, String, String, String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (db, entry_path, entry_name, mode, persistent_artifact_kind) -> {\n  let load_start = profiler_now_us()\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),\n    None => {\n      let load_us = elapsed_us_since(load_start)\n      let type_start = profiler_now_us()\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let type_us = elapsed_us_since(type_start)\n      let bundle_start = profiler_now_us()\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let bundle_us = elapsed_us_since(bundle_start)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),\n        None => {\n          let parse_start = profiler_now_us()\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let parse_us = elapsed_us_since(parse_start)\n          let compile_start = profiler_now_us()\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          let compile_us = elapsed_us_since(compile_start)\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)\n        }\n      }\n    }\n  }\n}\n\nlet compile_file_fs_mode_cached_slow: (TypeDb, String, String, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name, mode, persistent_artifact_kind) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let merge_fingerprint = build_source_groups_fingerprint(source_groups)\n      let artifact_fingerprint = merge_fingerprint\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, next_db),\n        None => {\n          let merged_stmts = build_grouped_merged_stmts(source_groups)\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_mode_cached: (TypeDb, String, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name, mode) -> {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nexport let compile_file_fs_cached: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name) -> {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nexport let compile_file_fs: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_mode_cached_profiled: (TypeDb, String, String, String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (db, entry_path, entry_name, mode) -> {\n  let total_start = profiler_now_us()\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let load_start = profiler_now_us()\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0, elapsed_us_since(total_start)),\n        None => {\n          let prefix_load_us = elapsed_us_since(load_start)\n          let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n          (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n        }\n      },\n    None => {\n      let prefix_load_us = elapsed_us_since(load_start)\n      let (bytes, next_db, load_us, type_us, bundle_us, parse_us, compile_us) = compile_file_fs_mode_cached_slow_profiled(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      (bytes, next_db, prefix_load_us + load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))\n    }\n  }\n}\n\nlet compile_file_fs_module_cached_slow: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\n    \"file-compile-module\",\n    \"\",\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"file-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"file-compile-module\",\n        \"\",\n        build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n\nexport let compile_file_fs_module: (String) -> Bytes with { Error, Fs } = (entry_path) -> {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n")
}

let cli_adapter_source_165 = () -> (String, String) {
  ("vibe/compiler/selfhost_cli_adapter.vibe",
"//# Imports\n\nimport ./entry / source_compile / wasi_only / preprocess.vibe {\n  compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, compile_source_wasi_only_rc_shadow\n}\n\nimport ./entry / source_compile / wasi_only / merge_sources.vibe {\n  merged_program_source_fs\n}\n\nimport ./entry / source_compile / gc_only / index.vibe {\n  compile_source_gc_only\n}\n\nimport ./runtime / module_source.vibe {\n  build_module_source_from_source, build_funcmap_from_source\n}\n\nimport ./loader/index.vibe {\n  contract_package_hashes_fs, fill_require_pins_fs_mode, publish_check_fs\n}\n\nimport ./entry / compiler / file_compile {\n  compile_file_fs_mode, compile_file_fs_mode_rc, compile_file_fs_mode_coverage, compile_file_fs_mode_trace, compile_file_fs_mode_break, compile_file_fs_mode_testmeta\n}\n\nimport ./normalize/index.vibe {\n  normalize_source\n}\n\nimport ./runtime / type_at.vibe {\n  type_at_source\n}\n\nimport ./runtime / binding_at.vibe {\n  binding_occurrences\n}\n\nimport ./runtime / symbol_spans.vibe {\n  symbol_spans\n}\n\nimport ./runtime / typecheck_fs.vibe {\n  collect_all_diagnostics\n}\n\nimport ./wit_gen.vibe {\n  serve_handler_param_names, validate_serve_handler, wit_from_program\n}\n\nimport ./component_codegen.vibe {\n  comp_emit_component_wasm_string_handler\n}\n\nimport ./syntax {\n  lex, parse_program\n}\n\n//# Functions\n\n// Basename of a path without its `.vibe` suffix — the default WIT world name\n// for #537 (`foo/bar_server.vibe` -> `bar_server`, kebab-cased by wit_gen).\nlet adapter_basename_no_vibe: (String) -> String = (path) -> {\n  let len = String::length(path)\n  let mut last_slash = 0 - 1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = path[last_slash + 1: len]\n  let blen = String::length(base)\n  if blen >= 5 && base[blen - 5: blen] == \".vibe\" {\n    base[0: blen - 5]\n  } else {\n    base\n  }\n}\n\n// Join `items` with \"\\n\" using String::concat only (no `+`/interpolation, which\n// can miscodegen NUL in selfhost). Empty array -> \"\".\nlet join_lines: (Array[String]) -> String = (items) -> {\n  let n = Array::length(items)\n  if n == 0 {\n    \"\"\n  } else {\n    // O(N) join via StringBuilder; per-item String::concat was O(N²) (issue #366).\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, Array::get(items, 0))\n    let mut i = 1\n    while i < n {\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, Array::get(items, i))\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\n// Render `vibe symbols` records as one `NAME KIND START END` line per declared\n// symbol (space-separated; KIND/START/END are ints), joined by \"\\n\". Records\n// with an empty name (unrecoverable offset placeholder) are skipped.\n// String::concat + __to_string only (never `+`/interpolation -> NUL miscodegen).\n// Empty -> \"\".\nlet join_symbol_spans: (Array[(String, Int, Int, Int)]) -> String = (syms) -> {\n  let n = Array::length(syms)\n  // O(N) join via StringBuilder; per-record String::concat was O(N²) (issue #366).\n  let acc = StringBuilder::new()\n  let mut first = true\n  let mut i = 0\n  while i < n {\n    let (name, kind, s, e) = Array::get(syms, i)\n    if String::length(name) == 0 {\n      ()\n    } else {\n      let line = String::concat(name, String::concat(\" \", String::concat(__to_string(kind), String::concat(\" \", String::concat(__to_string(s), String::concat(\" \", __to_string(e)))))))\n      if first {\n        StringBuilder::push(acc, line)\n        first = false\n      } else {\n        StringBuilder::push(acc, \"\\n\")\n        StringBuilder::push(acc, line)\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(acc)\n}\n\n// Render `vibe binding-at` occurrences as one `START END` line per span (two\n// space-separated ints), joined by \"\\n\". String::concat + __to_string only\n// (never `+`/interpolation, which miscodegen NUL in selfhost). Empty -> \"\".\nlet join_binding_occurrences: (Array[(Int, Int)]) -> String = (occ) -> {\n  let n = Array::length(occ)\n  if n == 0 {\n    \"\"\n  } else {\n    let (s0, e0) = Array::get(occ, 0)\n    // O(N) join via StringBuilder; per-occurrence String::concat was O(N²) (issue #366).\n    let acc = StringBuilder::new()\n    StringBuilder::push(acc, String::concat(__to_string(s0), String::concat(\" \", __to_string(e0))))\n    let mut i = 1\n    while i < n {\n      let (s, e) = Array::get(occ, i)\n      let line = String::concat(__to_string(s), String::concat(\" \", __to_string(e)))\n      StringBuilder::push(acc, \"\\n\")\n      StringBuilder::push(acc, line)\n      i = i + 1\n    }\n    StringBuilder::freeze(acc)\n  }\n}\n\n// Parse a non-negative decimal int from `s`; on any non-digit (or empty) return\n// `default`. String::concat-safe (no `+`/interpolation): folds digits via\n// `acc * 10 + (c - '0')`.\nlet parse_int_or: (String, Int) -> Int = (s, default) -> {\n  let len = String::length(s)\n  if len == 0 {\n    default\n  } else {\n    let mut i = 0\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < len {\n      let c = String::char_code_at(s, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      default\n    }\n  }\n}\n\nlet adapter_string_to_bytes: (String) -> Bytes = (s) -> {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nlet read_arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nlet own_host_string: (String) -> String = (value) -> {\n  String::concat(\"\", value)\n}\n\nlet profile_memory_mark: (Bool) -> Unit with { Env } = (enabled) -> {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\n// #cfg activation: VIBE_CFG=flag1,flag2 appends `#cfg_enable(flag)` directive\n// lines to the source (appending at the END keeps every original byte offset,\n// so diagnostics/spans are unaffected). parse_program pre-scans for these and\n// keeps the matching `#cfg(flag)` statements; with VIBE_CFG unset, every\n// #cfg-guarded statement is parsed-and-dropped -- zero bytes in the output.\nlet apply_cfg_env: (String, String) -> String = (source, cfg_csv) -> {\n  if cfg_csv == \"\" {\n    source\n  } else {\n    let parts = String::split(cfg_csv, \",\")\n    let mut out = source\n    let mut i = 0\n    while i < Array::length(parts) {\n      let flag = String::trim(Array::get(parts, i))\n      if String::length(flag) > 0 {\n        out = String::concat(out, String::concat(\"\\n#cfg_enable(\", String::concat(flag, \")\")))\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nlet compile_source_for_rc_flag: (String, String, String) -> Bytes with { Error } = (source, entry_name, rc_flag) -> {\n  // ADR-0055 #493 cutover: the Perceus RC codegen (memory-reclaiming linear\n  // backend) is the DEFAULT; set VIBE_RC=0 to opt back into the legacy bump\n  // path. The compiler self-build, bootstrap, and bump-baseline gates pin\n  // VIBE_RC=0 (see scripts/*.sh) so they stay byte-identical on bump.\n  if rc_flag == \"shadow\" {\n    // #715 recurrence guard: RC codegen + shadow-liveness traps (debug builds).\n    compile_source_wasi_only_rc_shadow(source, entry_name)\n  } else if rc_flag != \"0\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\n// On a parse/type/codegen error the checker throws a formatted diagnostic\n// String. Surface it to tooling by writing it to an `<output>.diag` sidecar so\n// the `vibe` launcher can print a real message instead of an opaque wasm trap.\n// Returns a non-zero exit code. (#594 usability / docs/release-roadmap.md.)\nlet emit_compile_diag: (String, String) -> Int with { Fs } = (output_path, msg) -> {\n  Fs::write_file(String::concat(output_path, \".diag\"), msg)\n  1\n}\n\n// debugger テーマ3 / M2: best-effort `.funcmap` sidecar beside the compiled wasm.\n// Maps each ENTRY-file top-level function to its 1-based source line so the\n// `vibe run` launcher can annotate trap backtrace frames with (file:line). The\n// wasm \"name\" section (debugger P0) already names the frames; this adds lines.\n//\n// Best-effort: a failure to build/write the funcmap must NOT fail the compile —\n// the wasm write already returned 0. So we wrap the work in its own handler and\n// swallow any Error::Throw. Entry-file functions only (imported modules: future\n// work).\n// Returns 0 (the value is consumed at the call site so the call is never DCE'd:\n// it is a discarded `Unit` side-effect otherwise, which aggressive DCE in the\n// seed compiler may drop).\nlet write_funcmap_sidecar: (String, String) -> Int with { Fs, Error } = (input_path, output_path) -> {\n  let src = Fs::read_file(input_path)\n  let text = build_funcmap_from_source(src)\n  Fs::write_bytes(String::concat(output_path, \".funcmap\"), adapter_string_to_bytes(text))\n  0\n}\n\n// #537 `vibe compile --wit`: emit the WIT world for the file's effect surface\n// (exported functions -> world exports; their `with { E }` rows -> world\n// imports). Imports resolved from FS. Contract: docs/effect-wit-mapping.md.\n// The Error handle is this function's tail (the proven adapter shape) rather\n// than a `return handle` inside cli_main's dispatch chain.\n// Entry-file-only surface scan (v1): exports and effect declarations are read\n// from the entry file itself; effects declared only in imported modules render\n// as host-capability comments (documented in docs/effect-wit-mapping.md).\nlet adapter_emit_wit: (String, String) -> Int with { Fs, Env } = (input_path, output_path) -> {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    let wit = wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(wit))\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\n// #537 `vibe serve` artifact step: validate the wasi-http P3 handler contract,\n// compile the file, and wrap it into a component exporting\n//   handler: func(method, url, headers, body: string) -> string\n// The runner layer (runtime/vibe serve) composes the result with the P3 HTTP\n// adapter and launches `wasmtime serve` — artifact generation stays in the\n// compiler, serving stays in the runner. VIBE_SERVE_WIT_OUT optionally writes\n// the WIT world sidecar.\nlet adapter_serve_component: (String, String) -> Int with { Fs, Env } = (input_path, output_path) -> {\n  handle {\n    let entry_stmts = parse_program(lex(Fs::read_file(input_path)))\n    validate_serve_handler(entry_stmts)\n    // Dummy entry: the component surface is `handler`, not a command entry.\n    let core = compile_file_fs_mode(input_path, \"__serve_component__\", \"no-dce\")\n    let component = comp_emit_component_wasm_string_handler(core, \"handler\", \"handler\", serve_handler_param_names())\n    Fs::write_bytes(output_path, component)\n    let wit_out = Env::get(\"VIBE_SERVE_WIT_OUT\")\n    if wit_out != \"\" {\n      Fs::write_bytes(wit_out, adapter_string_to_bytes(wit_from_program(entry_stmts, entry_stmts, adapter_basename_no_vibe(input_path))))\n    } else {\n      ()\n    }\n    0\n  } with Error {\n    Throw(msg) => emit_compile_diag(output_path, msg)\n  }\n}\n\nexport let cli_main: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  // #730 (D-2): `vibe hash` — print a contract package's content-addressing\n  // hashes. Input is the package's index.vibei; the output file receives\n  // \"package #pkg:sha1:<hex>\" and \"contract ct:sha1:<hex>\" lines. The\n  // package line is copy-pasteable as a require pin.\n  if Env::get(\"VIBE_HASH\") == \"1\" {\n    return handle {\n      let (pkg_hash, ct_hash) = contract_package_hashes_fs(input_path)\n      Fs::write_file(output_path, \"package #\\{pkg_hash}\\ncontract \\{ct_hash}\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #730 (D-3): `vibe fmt` pin insertion — fill unpinned require lines\n  // OFFLINE from the workspace store and write the completed source to the\n  // output path. Idempotent; pinned form is the canonical form.\n  if Env::get(\"VIBE_FILL_PINS\") == \"1\" {\n    return handle {\n      let filled = fill_require_pins_fs_mode(Fs::read_file(input_path), Env::get(\"VIBE_REPIN\") == \"1\")\n      Fs::write_file(output_path, filled)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #732 (Phase F): `vibe publish` semver gate. input = the NEXT contract;\n  // VIBE_PUBLISH_PREV / _PREV_VERSION / _VERSION describe the previous\n  // release. Writes \"ok\" on an honest bump; a dishonest claim is a diag.\n  if Env::get(\"VIBE_PUBLISH_CHECK\") == \"1\" {\n    return handle {\n      let perrors = publish_check_fs(\n        Env::get(\"VIBE_PUBLISH_PREV\"),\n        input_path,\n        Env::get(\"VIBE_PUBLISH_PREV_VERSION\"),\n        Env::get(\"VIBE_PUBLISH_VERSION\")\n      )\n      if Array::length(perrors) > 0 {\n        throw(String::join(perrors, \"; \"))\n      } else ()\n      Fs::write_file(output_path, \"ok\\n\")\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  } else ()\n  // #594 Stage 3 (debug): file-mode compile resolving imports from the FS.\n  if Env::get(\"VIBE_FS_COMPILE\") == \"1\" {\n    // #cov: `vibe test/run --coverage` sets VIBE_COVERAGE=1 so the user file (and\n    // its imports) is compiled with function/branch hit instrumentation; running\n    // the produced wasm fills the bitmap that the runner reads via VIBE_COV_OUT.\n    return handle {\n      // debugger trace (DAP P1 groundwork): `vibe run --trace` sets VIBE_DEBUG=1\n      // so the user file (and its imports) is compiled with function-call\n      // execution-trace instrumentation; running the produced wasm fills the\n      // in-memory trace log that the runner dumps via VIBE_TRACE_OUT.\n      // The special compile MODES (coverage / debugger break / trace) are\n      // checked first; they are mutually exclusive instrumentation builds and\n      // are unaffected by the RC cutover. The normal compile then defaults to\n      // the Perceus RC backend (#493 cutover, #705 parity) unless VIBE_RC=0\n      // selects the legacy bump path (which carries the #634 testmeta variant).\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_file_fs_mode_coverage(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG_BREAK\") == \"1\" {\n        // debugger breakpoint (DAP P1): `vibe run --break` sets VIBE_DEBUG_BREAK=1\n        // so the user file is compiled with `vibe::dbg_break` host-hook calls at\n        // each user function entry; the runner pauses on the named breakpoints.\n        compile_file_fs_mode_break(input_path, entry_name)\n      } else if Env::get(\"VIBE_DEBUG\") == \"1\" {\n        compile_file_fs_mode_trace(input_path, entry_name)\n      } else if Env::get(\"VIBE_RC\") != \"0\" {\n        // ADR-0055 #493 cutover DEFAULT: RC reclaims memory each iteration; the\n        // legacy bump path leaks until exit. Opt back into bump with VIBE_RC=0.\n        compile_file_fs_mode_rc(input_path, entry_name)\n      } else {\n        // Legacy bump path (VIBE_RC=0). #634 (ADR-0026): only when `vibe test`\n        // requests the pure-test cache verdict (VIBE_TESTMETA_OUT set) do we\n        // route through the variant that ALSO emits the `.testmeta` sidecar\n        // (riding the merged stmts this compile already builds — no extra\n        // parse). Env is read here (this layer has it), keeping the file_compile\n        // layer Env-free.\n        let testmeta_out = Env::get(\"VIBE_TESTMETA_OUT\")\n        if testmeta_out != \"\" {\n          compile_file_fs_mode_testmeta(input_path, entry_name, \"no-dce\", testmeta_out)\n        } else {\n          compile_file_fs_mode(input_path, entry_name, \"no-dce\")\n        }\n      }\n      Fs::write_bytes(output_path, bytes)\n      // Best-effort `.funcmap` sidecar (entry-file top-level funcs -> line). A\n      // failure to build/write it must NOT fail the compile (the wasm is already\n      // written), so swallow any Error::Throw here. The discarded result is bound\n      // so the call is not DCE'd as a dead Unit side-effect.\n      let _funcmap_rc = handle {\n        write_funcmap_sidecar(input_path, output_path)\n      } with Error {\n        Throw(_) => 0\n      }\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // #594 `vibe normalize`: canonicalize a source file (module flatten + DCE +\n  // section layout) and write the result. Same (input, output) interface.\n  if Env::get(\"VIBE_NORMALIZE\") == \"1\" {\n    let normalized = normalize_source(Fs::read_file(input_path))\n    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))\n    return 0\n  }\n  // `vibe type-at`: typed hover (first LSP consumer of real EIdent offsets).\n  // VIBE_TYPE_LINE/COL are 1-based (matching offset_to_line_col). Writes the\n  // inferred type string of the identifier at that position, or empty when there\n  // is no env-visible ident there (see type_at.vibe LIMITATION note).\n  if Env::get(\"VIBE_TYPE_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let ty = type_at_source(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))\n    return 0\n  }\n  // `vibe binding-at`: AST-accurate binding occurrences (scope-precision rename /\n  // references groundwork). VIBE_TYPE_LINE/COL are 1-based. Writes one `START END`\n  // line per source span of the identifier under the cursor, or empty when there\n  // is no identifier there (see binding_at.vibe LIMITATION: name-based, no\n  // shadowing analysis yet).\n  if Env::get(\"VIBE_BINDING_AT\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let line = parse_int_or(Env::get(\"VIBE_TYPE_LINE\"), 1)\n    let col = parse_int_or(Env::get(\"VIBE_TYPE_COL\"), 1)\n    let occ = binding_occurrences(src, line, col)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))\n    return 0\n  }\n  // `vibe symbols`: AST-accurate declaration outline. Writes one\n  // `NAME KIND START END` line per declared symbol (KIND = LSP SymbolKind int,\n  // START/END = char offsets of the name), or empty when the file declares none.\n  // Powers document-outline / go-to-definition without a text-regex scan.\n  if Env::get(\"VIBE_SYMBOLS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let syms = symbol_spans(src)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))\n    return 0\n  }\n  // `vibe diagnostics`: collect ALL syntax errors (recovering parser) or the\n  // single located type error, one per line. A report, not a failure — always\n  // returns 0 (empty output means clean).\n  if Env::get(\"VIBE_DIAGNOSTICS\") == \"1\" {\n    let src = Fs::read_file(input_path)\n    let diags = collect_all_diagnostics(src)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))\n    return 0\n  }\n  // #726: emit the MERGED whole program as source text. `input_path` is an\n  // entry file whose imports resolve from the FS; the output is the flat\n  // source produced by the real merge machinery (export-rename plan +\n  // private namespacing), replacing the Python flattener in\n  // scripts/generate_selfhost_bundle.sh. The flatten step compiles the\n  // COMMITTED flat module source with the seed (the same robust single-file\n  // lane as stage1) and runs this mode on it — the previous standalone-tool\n  // approach FS-compiled the whole 200-file graph with the seed, which hits\n  // a deterministic cold-cache OOB inside the FIXED seed binary\n  // (build_persistent_sources_cache_text; unreachable in this lane).\n  // Adding this adapter -> merge_sources import edge is safe now that the\n  // committed bundle is itself merge-built (zero duplicate defs, no\n  // first-match roulette to reshuffle).\n  if Env::get(\"VIBE_EMIT_MERGED_SOURCE\") == \"1\" {\n    return handle {\n      let merged_src = merged_program_source_fs(input_path)\n      Fs::write_file(output_path, merged_src)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n  // #537 `vibe compile --wit`: emit the WIT world for the file's effect\n  // surface (exported functions -> world exports; their `with { E }` rows ->\n  // world imports). Same (input, output) interface; imports resolved from FS.\n  // Contract: docs/effect-wit-mapping.md.\n  if Env::get(\"VIBE_EMIT_WIT\") == \"1\" {\n    return adapter_emit_wit(input_path, output_path)\n  }\n  // #537 `vibe serve` artifact step: validate the wasi-http P3 handler\n  // contract, compile the file, and wrap it into a component exporting\n  //   handler: func(method, url, headers, body: string) -> string\n  // The runner layer (runtime/vibe serve / scripts) composes the result with\n  // the P3 HTTP adapter and launches `wasmtime serve` — artifact generation\n  // stays in the compiler, serving stays in the runner.\n  if Env::get(\"VIBE_SERVE_COMPONENT\") == \"1\" {\n    return adapter_serve_component(input_path, output_path)\n  }\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  // #594 Stage 1b: emit-module-source mode. VIBE_EMIT_MODULE_SOURCE=1 reuses the\n  // same (input, output, entry) interface but, instead of compiling, writes the\n  // flat module source for `entry_name` (DCE from the entry, surviving statements\n  // emitted as their original source text). This is the selfhost replacement for\n  // the MoonBit host `emit-module-source`, so the flat-source step needs no host.\n  if Env::get(\"VIBE_EMIT_MODULE_SOURCE\") == \"1\" {\n    let module_source = build_module_source_from_source(source, entry_name)\n    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))\n    profile_memory_mark(mark_memory)\n    0\n  } else {\n    // ADR-0055 #493 cutover toggle: VIBE_RC=1 compiles on the Perceus RC codegen\n    // path (Env::get returns \"\" when unset, so default stays the bump path). Lets\n    // the selfbuild/bootstrap/e2e gates exercise the whole compiler under RC.\n    handle {\n      let rc_flag = Env::get(\"VIBE_RC\")\n      // #cfg: activate compile-time flags from VIBE_CFG (see apply_cfg_env).\n      let source_cfg = apply_cfg_env(source, Env::get(\"VIBE_CFG\"))\n      // #cov: function-level coverage build (same source pipeline, instrumented\n      // codegen). Running the produced wasm records which compiler functions ran.\n      let bytes = if Env::get(\"VIBE_COVERAGE\") == \"1\" {\n        compile_source_wasi_only_coverage(source_cfg, entry_name)\n      } else if Env::get(\"VIBE_BACKEND\") == \"gc\" {\n        // wasm-gc backend lane (parity checks / #415). Direct source compile\n        // only; FS-import mode and the special instrumentation modes stay\n        // linear-backend-only.\n        compile_source_gc_only(source_cfg, entry_name)\n      } else {\n        compile_source_for_rc_flag(source_cfg, entry_name, rc_flag)\n      }\n      profile_memory_mark(mark_memory)\n      Fs::write_bytes(output_path, bytes)\n      profile_memory_mark(mark_memory)\n      0\n    } with Error {\n      Throw(msg) => emit_compile_diag(output_path, msg)\n    }\n  }\n}\n")
}

export let selfhost_cli_adapter_sources = () -> Array[(String, String)] {
