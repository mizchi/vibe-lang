)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  // newcap = cap * 2 (local 7)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 2)\n  emit_i32_mul(b)\n  emit_local_set(b, 7)\n  if enable_rc {\n    // ADR-0055 Stage 4: allocate the grown buffer as a HEADERED, reusable block\n    // ([alloc_size@block+0], data_ptr = block+8) via __rc_alloc, so it can be\n    // freed/reused like any block. A raw-bump buffer has no header and leaks both\n    // on every regrow and when the array is dropped.\n    // block_start (local 6) = wrap(__rc_alloc(newcap*8 + 8))\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 6)\n    // alloc_size header at block_start+0 (= newcap*8 + 8)\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // copy old elements into the new buffer's data area (block_start+8)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    // free the OLD buffer if it was a separate (grown) block, i.e. data_ptr\n    // (local 5) != value+12 (the inline buffer at vptr+12). Push its value\n    // pointer onto the free-list head (size@-8, next@-4 are already in place).\n    emit_local_get(b, 5)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_i32_ne(b)\n    emit_if_void(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_global_get(b, 2)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 5)\n    emit_global_set(b, 2)\n    emit_end(b)\n    // capacity = newcap; data_ptr = block_start+8; local5 = block_start+8\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit