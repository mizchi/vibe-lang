it_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let gen_arr_push_body: (Bool, Int, Bool) -> Bytes = (enable_rc, rc_alloc_idx, rc_shadow) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag once at the top\n  // (everything downstream uses local 2 = the wrapped address).\n  if enable_rc {\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_local