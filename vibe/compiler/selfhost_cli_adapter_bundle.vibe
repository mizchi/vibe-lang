"//# Imports\n\nimport .. / core / types.vibe {\n  Type\n}\n\n//# Functions\n\nlet fs_no_params: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet fs_one_param: (Type) -> Array[Type] = (a) -> {\n  let arr = fs_no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet fs_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\n  let arr = fs_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet lookup_fs_copy: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::copy\" {\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_chdir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::chdir\" {\n    Some(CtFn(fs_one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_mkdir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::mkdir\" {\n    Some(CtFn(fs_one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_append: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::append\" {\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_exists: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::exists\" {\n    Some(CtFn(fs_one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_getcwd: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::getcwd\" {\n    Some(CtFn(fs_no_params(), CtString, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_is_dir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::is_dir\" {\n    Some(CtFn(fs_one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_remove: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::remove\" {\n    Some(CtFn(fs_one_param(CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_d: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_remove(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_copy(name) {\n      Some(t) => Some(t),\n      None => lookup_fs_append(name)\n    }\n  }\n}\n\nlet lookup_fs_is_file: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::is_file\" {\n    Some(CtFn(fs_one_param(CtString), CtBool, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_c: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_is_file(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_mkdir(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_getcwd(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_chdir(name)\n      }\n    }\n  }\n}\n\nlet lookup_fs_readdir: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::readdir\" {\n    Some(CtFn(fs_one_param(CtString), CtArray(CtString), Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_read_file: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::read_file\" {\n    Some(CtFn(fs_one_param(CtString), CtString, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_read_bytes: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::read_bytes\" {\n    Some(CtFn(fs_one_param(CtString), CtBytes, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_stat_token: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::stat_token\" {\n    Some(CtFn(fs_one_param(CtString), CtInt, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_fs_exists(name) {\n    Some(t) => Some(t),\n    None => match lookup_fs_stat_token(name) {\n      Some(t) => Some(t),\n      None => match lookup_fs_readdir(name) {\n        Some(t) => Some(t),\n        None => lookup_fs_is_dir(name)\n      }\n    }\n  }\n}\n\nlet lookup_fs_write_file: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs::write_file\" {\n    Some(CtFn(fs_two_params(CtString, CtString), CtUnit, Some(\"Fs\")))\n  }\n  else None\n}\n\nlet lookup_fs_write_bytes: (String) -> Option[Type] = (name) -> {\n  if name == \"Fs: