m_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let norm_params = Array::slice(params, 0, 0)\n  let mut npi = 0\n  while npi < Array::length(params) {\n    let (rawn, pty) = Array::get(params, npi)\n    let rnlen = String::length(rawn)\n    let sn = if rnlen > 0 {\n      let lc = String::char_code_at(rawn, rnlen - 1)\n      if lc == '~' || lc == '?' {\n        rawn[0: rnlen - 1]\n      } else {\n        rawn\n      }\n    } else {\n      rawn\n    }\n    Array::push(norm_params, (sn, pty))\n    npi = npi + 1\n  }\n  let lam_drops = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_alias_dups = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_dups = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_heap_params = Array::slice([\n    \"\"\n  ], 0, 0)\n  if ctx.enable_rc {\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body)\n    let mut ldi = 0\n    while ldi < Array::length(lam_plan) {\n      let lpa = Array::get(lam_plan, ldi)\n      if pa_is_drop(lpa) {\n        Array::push(lam_drops, lpa.name)\n      } else if pa_is_alias_dup(lpa) {\n        Array::push(lam_alias_dups, lpa.name)\n      } else if pa_is_dup(lpa) {\n        Array::push(lam_dups, lpa.name)\n      } else {\n        ()\n      }\n      ldi = ldi + 1\n    }\n    let mut hpi = 0\n    while hpi < Array::length(norm_params) {\n      let (hpn, hpt) = Array::get(norm_params, hpi)\n      if param_is_heap_in_body(hpn, hpt, fn_body) {\n        Array::push(lam_heap_params, hpn)\n      } else {\n        ()\n      }\n      hpi = hpi + 1\n    }\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values,\n    enable_rc: ctx.enable_rc,\n    rc_drop_names: lam_drops,\n    rc_alias_dup_names: lam_alias_dups,\n    heap_binding_names: lam_heap_params,\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\n    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,\n    rc_dup_names: lam_dups,\n    float_local_slots: Array::slice([\n      0\n    ], 0, 0),\n    effect_names: ctx.effect_names,\n    effect_op_keys: ctx.effect_op_keys,\n    effect_op_arities: ctx.effect_op_arities\n  }\n  if ctx.enable_rc {\n    let mut dpi = 0\n    while dpi < Array::length(norm_params) {\n      let (dpn, dpt) = Array::get(norm_params, dpi)\n      if param_is_heap_in_body(dpn, dpt, fn_body) {\n        let mut dcount = 0\n        let mut dqi = 0\n        while dqi < Array::length(lam_dups) {\n          if Array::get(lam_dups, dqi) == dpn {\n            dcount = dcount + 1\n          } else {\n            ()\n          }\n          dqi = dqi + 1\n        }\n        let mut de = 0\n        while de < dcount {\n          lam_emit_rc_dup_guarded(lam_buf, dpi)\n          de = de + 1\n        }\n      } else {\n        ()\n      }\n      dpi = dpi + 1\n    }\n  } else {\n    ()\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let mut tail_lam_nl = final_lam_nl\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n    let tail_root = scope_tail_proj_root(fn_body)\n    let mut need_dup = false\n    let mut ti = 0\n    while ti < Array::length(norm_params) {\n      let (tpn, tpt) = Array::get(norm_params, ti)\n      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\n        need_dup = true\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    let rtemp = final_lam_nl\n    if need_dup {\n      emit_local_set(lam_buf, rtemp)\n      lam_emit_rc_dup_guarded(lam_buf, rtemp)\n      tail_lam_nl = final_lam_nl + 1\n    } else {\n      ()\n    }\n    let mut tj = 0\n    while tj < Array::length(norm_params) {\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\n      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {\n        emit_local_get(lam_buf, tj)\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      tj = tj + 1\n    }\n    if need_dup {\n      emit_local_get(lam_buf, rtemp)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if tail_lam_nl > min_lam_nl {\n    extra_lam = tail_lam_nl - min_lam_nl\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    let cap_off = if ctx.enable_rc {\n      16\n    } else {\n      8\n    }\n    if ctx.enable_rc {\n      let total = 16 + num_captures * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 12)\n    } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8 + num_captures * 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 4)\n    }\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __cap_resolve)\n        emit_i64_store(buf, 3, cap_off + csi * 8)\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, cap_off + csi * 8)\n      }\n      csi = csi + 1\n    }\n    if ctx.enable_rc {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64