STest(String, Expr); SBench(String, Expr); SExpr(Expr); SExport(Array[String]); SReExport(String, Array[(String, Option[String])]); SAliasDecl(String, String); SLetPat(Pat, Expr); SModule(Bool, String, Array[Stmt]); SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)]) }\nexport let __to_string_exp_vibe_compiler_core_polyfill_vibe: (Int) -> String = (n) -> { if (n == 0) { \"0\" } else { { let mut val = n; { let mut neg = false; { if (val < 0) { { neg = true; { val = (0 - val); () } } }; { let digits = Array::slice([\"\"], 0, 0); { while (val > 0) { { let d = (val - ((val / 10) * 10)); { let ch = if (d == 0) { \"0\" } else { if (d == 1) { \"1\" } else { if (d == 2) { \"2\" } else { if (d == 3) { \"3\" } else { if (d == 4) { \"4\" } else { if (d == 5) { \"5\" } else { if (d == 6) { \"6\" } else { if (d == 7) { \"7\" } else { if (d == 8) { \"8\" } else { \"9\" } } } } } } } } }; { Array::push(digits, ch); { val = (val / 10); () } } } } }; { let mut result = if neg { \"-\" } else { \"\" }; { let mut i = (Array::length(digits) - 1); { while (i >= 0) { { result = String::concat(result, Array::get(digits, i)); { i = (i - 1); () } } }; result } } } } } } } } } }\nexport let bytebuf_new_exp_vibe_compiler_core_bytebuf_vibe: () -> Bytes = () -> { Bytes::new() }\nexport let bytebuf_push_exp_vibe_compiler_core_bytebuf_vibe: (Bytes, Int) -> Unit = (buf, byte) -> { Bytes::push(buf, byte) }\nexport let bytebuf_push2_exp_vibe_compiler_core_bytebuf_vibe: (Bytes, Int, Int) -> Unit = (buf, b1, b2) -> { { bytebuf_push_exp_vibe_compiler_core_bytebuf_vibe(buf, b1); bytebuf_push_exp_vibe_compiler_core_bytebuf_vibe(buf, b2) } }\nexport let bytebuf_push3_exp_vibe_compiler_core_bytebuf_vibe: (Bytes, Int, Int, Int) -> Unit = (buf, b1, b2, b3) -> { { bytebuf_push_exp_vibe_compiler_core_bytebuf_vibe(buf, b1); { bytebuf_push_exp_vibe_compiler_core_bytebuf_vibe(buf, b2); bytebuf_push_exp_vibe_compiler_core_bytebuf_vibe(buf, b3) } } }\nexport let bytebuf_push9_exp_vibe