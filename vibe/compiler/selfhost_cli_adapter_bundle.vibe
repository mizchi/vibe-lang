port, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  cc_is_borrow_ret_call, cc_is_loop_borrowed_ident, compile_call\n}\n\nimport ./compile_expr_tail5.vibe {\n  compile_expr_tail5\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n// A field projection `a.f` (EDot) read as a record-field value is a BORROW of\n// the source aggregate. The constructed record OWNS its fields (its drop class\n// recursively drops them), so the borrowed projection must be retained (#704)\n// — otherwise dropping the source frees the value while the new record still\n// points at it. Perceus tracks named bindings but emits no action for bare\n// projections, so this guarded dup is the only owner-increment and does not\n// double-count. Lambda literals (EFn) and other fresh values are already owned.\nlet expr_is_projection: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  match expr {\n    EDot(obj, field, _) => {\n      let fc = String::char_code_at(field, 0)\n      if fc >= 48 && fc <= 57 {\n        // `t.N` tuple projection: purely positional.\n        let mut vi = 0\n        let mut vp = 0\n        while vp < String::length(field) {\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n          vp = vp + 1\n        }\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.\n        if ctx.enable_rc {\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n        }\n        emit_i32_wrap_i64(buf)\n        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.\n        let toff = if ctx.enable_rc {\n          8 + vi * 8\n        } else {\n          vi * 8\n        }\n        emit_i64_load(buf, 3, toff)\n        nl1\n      } else {\n        // #722: name-based struct field access. The slot index depends on\n        // WHICH struct the value is — a same-named field can live at a\n        // different slot in another struct. When every declaring struct\n        // agrees on the slot, load it statically (the common case). When\n        // they disagree, dispatch at runtime on the value's ctor tag\n        // (value+0), falling back to the first-declared struct's slot for\n        // legacy untagged records.\n        let cands = struct_field_candidates(ctx.ctor_table, field)\n        if Array::length(cands) == 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        let (_, idx0) = Array::get(cands, 0)\n        let dispatch = struct_field_dispatch_cases(cands)\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        if Array::length(dispatch) == 0 {\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\n          nl1\n        } else {\n          let obj_l = nl1\n          Array::push(local_names, \"__dot_obj\")\n          emit_local_set(buf, obj_l)\n          let mut di = 0\n          while di < Array::length(dispatch) {\n            let (dtag, didx) = Array::get(dispatch, di)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_load(buf, 2, 0)\n            emit_i32_const(buf, dtag)\n            emit_i32_eq(buf)\n            emit_if_i64(buf)\n            emit_local_get(buf, obj_l)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + didx * 8)\n            emit_else(buf)\n            di = di + 1\n          }\n          emit_local_get(buf, obj_l)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + idx0 * 8)\n          let mut de = 0\n          while de < Array::length(dispatch) {\n            emit_end(buf)\n            de = de + 1\n          }\n          nl1 + 1\n        }\n      }\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      // #722: resolve the record to a struct by exact field-name set and, on a\n      // match, lay it out in the struct's DECLARED field order with the\n      // struct's ctor tag stamped at value+0 — byte-compatible with the\n      // `S::{...}` ctor construction path (which already reorders). This is\n      // what makes the tag-dispatching field access above type-correct for\n      // bare-record construction (hand-built ASTs, name-dropped literals).\n      // Unmatched (anonymous) records keep the legacy literal order + tag 0.\n      let lit_names = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut lni = 0\n      while lni < flen {\n        let (lfn, _) = Array::get(fields, lni)\n        Array::push(lit_names, lfn)\n        lni = lni + 1\n      }\n      let rec_si = struct_index_by_field_set(ctx.ctor_table, lit_names)\n      let rec_tag = if rec_si >= 0 {\n        struct_tag_by_index(ctx.ctor_table, rec_si)\n      } else {\n        0\n      }\n      let rec_fields = if rec_si >= 0 {\n        let def_fnames = Array::get(ctx.ctor_table.struct_field_names, rec_si)\n        let ordered = Array::slice([\n          (\"\", EUnit)\n        ], 0, 0)\n        let mut oi = 0\n        while oi < Array::length(def_fnames) {\n          let target_name = Array::get(def_fnames, oi)\n          let mut ri2 = 0\n          while ri2 < flen {\n            let (rfn, rfv) = Array::get(fields, ri2)\n            if rfn == target_name {\n              Array::push(ordered, (rfn, rfv))\n              ri2 = flen\n            } else {\n              ri2 = ri2 + 1\n            }\n          }\n          oi = oi + 1\n        }\n        ordered\n      } else {\n        fields\n      }\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      if ctx.enable_rc {\n        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):\n        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n        // The record value is (block_start+8) | 1 (records stay tagged), so the\n        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]\n        // [length@ptr+4] and field access stays at +8 (untag cancels the +8\n        // pointer shift). type_id 0 preserves the existing record read semantics.\n        let total = 16 + flen * 8\n        // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a\n        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same\n        // shape the recursive rc_drop loops.\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, rec_tag)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(rec_fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          // #708 follow-up (Codex review): a record field sourced from a\n          // borrow-returning call (Array::get/Map::get/__rec_field/a user\n          // wrapper) is exactly as much a borrow as a bare projection `a.f`\n          // (see the comment above) -- without this retain, dropping the\n          // source container after storing its element into an owning\n          // record double-frees the element once the record is later\n          // dropped too.\n          // #715: also retain a bare-ident field whose binding is borrow-bound\n          // or loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the\n          // ETuple case in compile_expr_tail2.vibe (see the comment there).\n          if ctx.enable_rc && (expr_is_projection(fexpr) || cc_is_borrow_ret_call(fexpr, ctx) || cc_is_loop_borrowed_ident(fexpr, ctx)) {\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + ri * 8)\n          ri = ri + 1\n        }\n        // record value = (block_start + 8) | 1\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      } else {\n        let obj_size = 8 + flen * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, rec_tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(rec_fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      }\n    },\n    EMap(fields) => {\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 2 * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__map_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 0)\n      let mut nl_m = next_local + 1\n      let mut mi = 0\n      while mi < flen {\n        let (key, val_expr) = Array::get(fields, mi)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\n        if key_idx >= 0 {\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\n        let val_local = nl_m\n        Array::push(local_names, \"__map_val\")\n        emit_local_set(buf, val_local)\n        nl_m = nl_m + 1\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\n        mi = mi + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl_m\n    },\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_74 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_expr_tail3.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ereturn_expr, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail4.vibe {\n  compile_expr_tail4\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_expr_tail3: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 19 {\n    let cond = get_ewhile_cond(expr)\n    let body = get_ewhile_body(expr)\n    // #706: the locals live at the loop header are loop-borrowed — a consume of\n    // one inside the cond/body re-executes each iteration and must dup so the\n    // value survives the back-edge. Record them (RC only); restore after. Names\n    // declared inside the body are appended past lb_base and removed by truncate.\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < Array::length(local_names) {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    // ld measures wasm blocks between the current position and the INNERMOST\n    // loop header (EBreak emits `br ld+1`, EContinue `br ld`). A new loop\n    // RESETS that distance to 0 — the previous `ld + 1` only converted the\n    // top-level -1 correctly; for a while nested in another loop it kept\n    // counting from the OUTER loop, so an inner `break` jumped to the outer\n    // loop header (observed as an infinite insertion sort in\n    // fixtures/index_assign_test.vibe).\n    let w_ld_in = 0\n    let w_cond_tag = expr_tag(cond)\n    let nl1 = if w_cond_tag == 5 {\n      let wcop = get_ebinop_op(cond)\n      if wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n        let wlhs = get_ebinop_lhs(cond)\n        let wrhs = get_ebinop_rhs(cond)\n        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, w_ld_in)\n        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, w_ld_in)\n        if wcop == \"<\" {\n          emit_i64_lt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \">\" {\n          emit_i64_gt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \"<=\" {\n          emit_i64_le_s(buf); emit_i32_eqz(buf)\n        }\n        else {\n          emit_i64_ge_s(buf); emit_i32_eqz(buf)\n        }\n        wnl2\n      } else {\n        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n        emit_i64_eqz(buf)\n        wnl\n      }\n    } else {\n      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, w_ld_in)\n      emit_i64_eqz(buf)\n      wnl\n    }\n    emit_br_if(buf, 1)\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, w_ld_in)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_i64_const(buf, 0)\n    nl2\n  } else if __tag == 20 {\n    emit_br(buf, ld + 1)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 21 {\n    emit_br(buf, ld)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 22 {\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 23 {\n    let msg_expr = get_ethrow_expr(expr)\n    let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)\n    bytebuf_push(buf, 8)\n    bytebuf_push(buf, 2)\n    nl\n  } else if __tag == 24 {\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 26 {\n    let ret_expr = get_ereturn_expr(expr)\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\n    emit_return(buf)\n    nl\n  } else {\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_75 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_expr_tail2.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_rc_dup_guarded, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_index, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  cc_is_borrow_ret_call, cc_is_loop_borrowed_ident, compile_call\n}\n\nimport ./compile_expr_tail3.vibe {\n  compile_expr_tail3\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      // RC layout (docs/spec/selfhost-rc-port.md):\n      //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n      // The tuple value is block_start+8 (points at type_id), so the live header\n      // is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0][length@ptr+4] and the\n      // payload stays at ptr+8 (field access is unchanged). ptr_local holds\n      // block_start. type_id 3 = tuple.\n      let total = 16 + num_elems * 8\n      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc) —\n      // exact-fit reuse anywhere in the list, else bump. Replaces the inline\n      // head-only check, which fragmented when interleaved sizes were freed.\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header words at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: uniform drop-class byte in the rc_count word's high\n      // byte (block+7 = value-1). rc stays in the low 24 bits, so dec (full-word\n      // -1) and the `*256 == 0` zero-test ignore this byte. 1 = field-vector\n      // ([?@value+0][count@value+4][fields@value+8+i*8]) — the generic recursive\n      // rc_drop loops `count` fields. (docs/spec/selfhost-uniform-value-repr.md)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        let __tup_elem = Array::get(__tuple_elems, tri)\n        nl = compile_expr(buf, __tup_elem, local_names, nl, ctx, ld)\n        let __tup_val_local = nl\n        Array::push(local_names, \"__tup_val\")\n        emit_local_set(buf, __tup_val_local)\n        nl = nl + 1\n        // #715: a tuple element sourced from a field projection (`a.f`) or a\n        // borrow-returning call (Array::get/Map::get/__rec_field/a user\n        // wrapper) is a BORROWED view of its source, exactly like the same\n        // case already handled for ERecord fields above (#704/#708) --\n        // without this retain, dropping the source after storing its\n        // element into this owning tuple leaves the tuple holding a\n        // dangling reference once the source is freed.\n        //\n        // The same applies to a BARE IDENT element whose binding is itself\n        // borrow-bound (`let pt2 = f(resolved, env)` where `f` returns its\n        // own argument -- the #708 is_borrow_ret_ext piggyback marks such a\n        // name loop-borrowed for the let's body) or live-in to an enclosing\n        // loop (#706): compile_call already dups these at call-argument\n        // positions via cc_is_loop_borrowed_ident, but a tuple literal\n        // stored the bare borrowed ref undup'd, so the true owner's\n        // scope-end drop freed the block the escaping tuple still pointed\n        // at (checker.vibe's `(pt2, s1, c1)` in check_expr's EFn param loop\n        // -- the `enum Shape { Circle }` / `(Int) -> Int` one-line repros'\n        // confirmed UAF site).\n        let __tup_is_proj = match __tup_elem {\n          EDot(_, _, _) => true,\n          _ => false\n        }\n        if ctx.enable_rc && (__tup_is_proj || cc_is_borrow_ret_call(__tup_elem, ctx) || cc_is_loop_borrowed_ident(__tup_elem, ctx)) {\n          emit_rc_dup_guarded(buf, __tup_val_local, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __tup_val_local)\n        emit_i64_store(buf, 3, 16 + tri * 8)\n        tri = tri + 1\n      }\n      // tuple value = (block_start + 8) | 1 (ADR-0055 Stage 2: all heap pointers\n      // are odd so a generic recursive rc_drop can classify fields by `& 1`).\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let alloc_size = num_elems * 8\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    }\n  } else if __tag == 16 {\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n    let elems = get_earray_elems(expr)\n    let n_elems = Array::length(elems)\n    if ctx.enable_rc {\n      // RC array literal: inline-allocate the array object with the tuple-style\n      // RC layout so it drops like a tuple (value = block+8, untagged). Object\n      // layout at the value pointer matches the array runtime\n      // (`[capacity@0][length@4][data_ptr@8][inline_data@12...]`); data_ptr points\n      // at the inline buffer (value+12). capacity defaults to 8 (as array_new)\n      // but is sized up for larger literals so all elements fit inline.\n      // The header behind is [alloc_size@-8][rc_count@-4]; the array runtime\n      // (Array::get / length / push) reads value+0/+4/+8, unchanged.\n      // (docs/spec/selfhost-rc-port.md)\n      let cap = if n_elems > 8 {\n        n_elems\n      } else {\n        8\n      }\n      let total = 20 + cap * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__arr_ptr\")\n      let mut nl = next_local + 1\n      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: drop-class byte (block+7). 5 = array — value+0 is\n      // capacity (not a count) and elements live behind data_ptr@value+8, so the\n      // recursive rc_drop must use the array path, not the field-vector loop.\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 5)\n      emit_i32_store8(buf, 0, 7)\n      // array object at block_start+8 = value: capacity, length, data_ptr\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, cap)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, n_elems)\n      emit_i32_store(buf, 2, 12)\n      // data_ptr = value + 12 = block_start + 20 (inline buffer)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 20)\n      emit_i32_add(buf)\n      emit_i32_store(buf, 2, 16)\n      // store elements at block_start + 20 + i*8\n      let mut ai = 0\n      while ai < n_elems {\n        let __arr_elem = Array::get(elems, ai)\n        nl = compile_expr(buf, __arr_elem, local_names, nl, ctx, ld)\n        let __arr_val_local = nl\n        Array::push(local_names, \"__arr_val\")\n        emit_local_set(buf, __arr_val_local)\n        nl = nl + 1\n        // #715: an array-literal element sourced from a projection, a\n        // borrow-returning call, or a borrow-bound/loop-borrowed bare ident\n        // is a BORROWED view of its source; the array OWNS its elements\n        // (drop class 5 recurses), so retain it or the source's drop frees\n        // the block this array still points at. Same gap/fix as the ETuple\n        // case above (see its comment).\n        let __arr_is_proj = match __arr_elem {\n          EDot(_, _, _) => true,\n          _ => false\n        }\n        if __arr_is_proj || cc_is_borrow_ret_call(__arr_elem, ctx) || cc_is_loop_borrowed_ident(__arr_elem, ctx) {\n          emit_rc_dup_guarded(buf, __arr_val_local, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __arr_val_local)\n        emit_i64_store(buf, 3, 20 + ai * 8)\n        ai = ai + 1\n      }\n      // array value = (block_start + 8) | 1 (ADR-0055 Stage 2b: odd heap pointer)\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    }\n  } else if __tag == 18 {\n    let names_len_at_forin = Array::length(local_names)\n    let var_name = get_eforin_name(expr)\n    let iter_expr = get_eforin_iter(expr)\n    let body = get_eforin_body(expr)\n    // #715: mirror EWhile's (#706) loop-borrowed-names protection. The outer\n    // locals live at loop entry are re-consumed on every iteration via the\n    // back-edge (`br 0`), so a consuming use of one inside the body must dup\n    // to survive past the first iteration. Names declared inside the body\n    // (var_name, index_name, __forin_* temps) are appended past lb_base and\n    // never added here, matching EWhile.\n    let lb_base = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc {\n      let mut lbi = 0\n      while lbi < names_len_at_forin {\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\n        lbi = lbi + 1\n      }\n    } else {\n      ()\n    }\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n    let result_local = next_local\n    let arr_local = next_local + 1\n    let i_local = next_local + 2\n    Array::push(local_names, \"__forin_res\")\n    Array::push(local_names, \"__forin_arr\")\n    Array::push(local_names, \"__forin_i\")\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, result_local)\n    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\n    emit_local_set(buf, arr_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, i_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, i_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, arr_len_fi)\n    // `i_local` is a raw counter (init 0, step 1). Under RC `Array::length`\n    // returns a tagged Int (`len << 1`), so untag it to compare against the raw\n    // counter — otherwise the loop runs twice per element (#704). The index is\n    // re-tagged at the `Array::get` site below.\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shr_s(buf)\n    }\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    // Indexed `for i, x in arr`: bind the loop counter to the user index name\n    // before the value var (gc backend parity — backend_expr.vibe). The counter\n    // `i_local` is a raw i64; under RC ints are `value << 1`, so shift to match\n    // the user-visible Int representation (same as EInt codegen).\n    let index_name = get_eforin_index(expr)\n    let var_local = match index_name {\n      Some(idx_name) => {\n        emit_local_get(buf, i_local)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        emit_local_set(buf, nl1)\n        Array::push(local_names, idx_name)\n        nl1 + 1\n      },\n      None => nl1\n    }\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, i_local)\n    // Re-tag the raw counter to a vibe Int (`i << 1`) so `Array::get` (which\n    // untags its index under RC) reads the correct element (#704).\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    emit_call(buf, arr_get_fi)\n    emit_local_set(buf, var_local)\n    Array::push(local_names, var_name)\n    // #715: `var_name` is bound to `Array::get(arr, i)`'s result every\n    // iteration -- a BORROWED view into `arr_local`, exactly like a\n    // hand-written `let var_name = Array::get(arr, i)` (compile_expr_tail.vibe's\n    // is_borrow_ret handling, which deliberately leaves such a let untracked\n    // and instead dups at each owning consuming use via the loop_borrowed_names\n    // piggyback -- see its #708-follow-up comment). EForIn's implicit bind\n    // skipped that registration entirely, so a body that passes `var_name` to a\n    // function taking ownership of its argument (e.g. a self-recursive call\n    // like `resolve_type_expr(p, defs)`) let the callee drop a reference the\n    // array still owns -- a same-address free while `arr_local` still points at\n    // it, corrupting the free list once `arr_local` is later dropped or reread.\n    // Reuse the same ctx.loop_borrowed_names mechanism (cc_is_loop_borrowed_ident\n    // in compile_call.vibe) so owning uses of `var_name` inside `body` get the\n    // missing dup; the existing `Array::truncate(ctx.loop_borrowed_names, lb_base)`\n    // below already restores the outer state since this push lands after lb_base.\n    if ctx.enable_rc {\n      Array::push(ctx.loop_borrowed_names, var_name)\n    } else {\n      ()\n    }\n    let nl2 = var_local + 1\n    // Same innermost-loop ld reset as EWhile (see compile_expr_tail3).\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, 0)\n    let body_val = nl3\n    Array::push(local_names, \"__forin_val\")\n    emit_local_set(buf, body_val)\n    emit_local_get(buf, result_local)\n    emit_local_get(buf, body_val)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, i_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, i_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\n    emit_local_get(buf, result_local)\n    // Restore the outer scope. The loop's internal bindings (result/arr/i, the\n    // optional index name, the value name, and the body temp) must not leak into\n    // later identifier lookups, which scan local_names from the end and would\n    // otherwise resolve a shadowed outer var to a stale loop slot. Mirror\n    // compile_match: truncate back to the entry length, then pad with placeholders\n    // up to the high-water local count so slot numbering is preserved.\n    let final_nl = nl3 + 1\n    Array::truncate(local_names, names_len_at_forin)\n    while Array::length(local_names) < final_nl {\n      Array::push(local_names, \"\")\n    }\n    final_nl\n  } else {\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_76 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_expr_tail.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, mut_needs_ref_cell, proj_root_ident, scope_tail_proj_root\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, agg_ret_lookup, agg_slot_lookup, find_local_slot, emit_rc_dup_guarded, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_ctor_call, is_earray, is_efn, is_eident, is_erecord, is_etuple, is_nullary_ctor_ident, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, first_offset, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, offset_to_line, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail2.vibe {\n  compile_expr_tail2\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n// ADR-0055 tag repair for compound assignment: under RC both operands are\n// tagged (n<<1), so `+`, `-`, `%` preserve the tag for free, but `*` yields\n// ab<<2 (shift right once) and `/` yields a/b untagged (shift left once).\n// The raw emit_assignop_op alone silently doubled `x *= 2` results under RC.\nlet emit_assignop_rc_tag_fix: (Bytes, Bool, String) -> Unit = (buf, enable_rc, op) -> {\n  if enable_rc && op == \"*\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shr_s(buf)\n  } else if enable_rc && op == \"/\" {\n    emit_i64_const(buf, 1)\n    emit_i64_shl(buf)\n  } else {\n    ()\n  }\n}\n\n\n// Interior-line breakpoints (span-arc step5): when break-mode line instrumentation\n// is active (ctx.dbg_line_idx >= 0), emit `i32.const <line>` + `call dbg_line` for\n// the statement whose value subexpression is `value`, deriving the 1-based source\n// line from the value's first offset. No-op when off or when no offset is found,\n// so the default codegen path is byte-identical. Stack-neutral: dbg_line is\n// `(i32) -> ()`, the i32 const it consumes leaves the stack unchanged.\nlet emit_dbg_line_for: (Bytes, Expr, CompileCtx) -> Unit = (buf, value, ctx) -> {\n  if ctx.dbg_line_idx >= 0 {\n    let off = first_offset(value)\n    if off >= 0 {\n      let line = offset_to_line(ctx.dbg_line_nl, off)\n      emit_i32_const(buf, ctx.dbg_line_file_id)\n      emit_i32_const(buf, line)\n      emit_call(buf, ctx.dbg_line_idx)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nlet is_edot: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _) => true,\n    _ => false\n  }\n}\n\nlet efn_is_capturing: (Expr, CompileCtx) -> Bool with { Error } = (value, ctx) -> {\n  let params = get_efn_params(value)\n  let pnames = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pn, _) = Array::get(params, pi)\n    Array::push(pnames, pn)\n    pi = pi + 1\n  }\n  let caps = collect_free_vars(get_efn_body(value), pnames, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n  Array::length(caps) > 0\n}\n\nlet slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\n// #678: is the local in `slot` known to hold an Int/Bool? Mirrors\n// slot_is_floatish over ctx.int_local_slots (`slot*2 + flag`, most-recent\n// entry wins). The log is pruned at branch/arm boundaries (int_log_reset_above)\n// so a slot reused by a non-`let` binder reads false here rather than a stale\n// `1`. Lets a bare integer variable take the direct-i64 `==` path instead of\n// the string-pointer-misreading `eq` builtin (see expr_is_intish).\nlet slot_is_intish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.int_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\n// Blocker-3 (ADR-0055): does `e` statically evaluate to an f64 bit pattern?\n// Syntactic over-approximation (the AST is untyped): float literals, float\n// arithmetic / comparison over floatish operands, float-producing conversions,\n// and — crucially — a *variable* bound to a floatish value (tracked in\n// ctx.float_local_slots as `let`s compile). This lets `let x = 1.5; x + y`\n// take the f64 path. Shared by compile_expr (binop/unary instruction choice)\n// and the `let` handler below (which populates float_local_slots).\nexport let rec expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    // #744: arithmetic only. A float COMPARISON (`n < 0.0`) yields a Bool —\n    // including `<`/`>`/`<=`/`>=` here marked a let-bound comparison result\n    // as floatish, and a later `neg && ...` on that Bool took the float binop\n    // path and threw \"unsupported float binop: &&\".\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\n// #678: is `e` unambiguously an integer/bool scalar — never a string or float?\n// Such an operand makes `==`/`!=` a direct i64.eq instead of the polymorphic\n// `eq` builtin, whose string fall-back misreads a large integer as a string\n// fat-pointer `(ptr<<32)|len` (two unequal ints with a zero low word compare\n// EQUAL). Integral by SHAPE: literals, bitwise/comparison/logical operators,\n// non-float arithmetic. A bare identifier is integral when its slot was bound\n// to a definitely-integral value (ctx.int_local_slots, the dual of\n// expr_is_floatish) — sound because that log is pruned at every branch/arm\n// boundary (int_log_reset_above), so a slot reused by a non-`let` binder\n// holding a string is never read as int. Unclassified operands (a call return,\n// an untracked param/capture) stay false and fall back to the bounds-guarded\n// `eq` — the narrow remaining residual.\nexport let expr_is_intish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 1 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      slot_is_intish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\" {\n      true\n    } else if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      !expr_is_floatish(e, local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    op == \"!\"\n  } else {\n    false\n  }\n}\n\n\nlet assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {\n  let empty1 = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty2 = Array::slice([\n    \"\"\n  ], 0, 0)\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nlet rec reassign_carry_safe: (Expr, String) -> Bool = (e, name) -> {\n  if !assign_value_mentions(e, name) {\n    true\n  } else {\n    match e {\n      EIdent(_, _) => true,\n      EDot(_, _, _) => proj_root_ident(e) == name,\n      EBinOp(_, l, r) => reassign_carry_safe(l, name) && reassign_carry_safe(r, name),\n      EUnaryOp(_, x) => reassign_carry_safe(x, name),\n      _ => false\n    }\n  }\n}\n\nlet emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\nlet emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block\n  // (see emit_rc_word_inc_saturating) -- never decrement, never free.\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nlet reassign_self_reusable: (Expr, String) -> Bool with { Error } = (value, name) -> {\n  if is_etuple(value) {\n    let elems = get_etuple_elems(value)\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(elems) {\n      if !reassign_carry_safe(Array::get(elems, i), name) {\n        ok = false\n      } else {\n        ()\n      }\n      i = i + 1\n    }\n    ok\n  } else {\n    false\n  }\n}\n\nexport let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_for(buf, value, ctx)\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    let val_is_float = expr_is_floatish(value, local_names, ctx)\n    if val_is_float {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    // #678: log whether this binding holds a definitely-integral value, so a\n    // later bare-ident `==` on it bypasses the string-pointer-misreading `eq`.\n    // Always (re)log when the slot was previously int, so a non-int rebind of a\n    // reused slot overrides the earlier `1`.\n    if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 2 + 1)\n    } else if slot_is_intish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 2)\n    }\n    // #724: log this binding's AGGREGATE shape (tuple arity / ctor-record\n    // field count) so `a == b` with both sides bound takes the structural\n    // comparators. kind*64+n; 0 overrides a reused slot. See\n    // CompileCtx.agg_local_slots.\n    let agg_entry = if is_etuple(value) {\n      64 + Array::length(get_etuple_elems(value))\n    } else if is_ctor_call(value, ctx.ctor_table) {\n      let cargs = get_ecall_args(value)\n      // `S::{ ... }` sugar arrives as ECall(S, [ERecord]) — the runtime\n      // field count is the record's, not the call arity.\n      let fcnt = if Array::length(cargs) == 1 {\n        match Array::get(cargs, 0) {\n          ERecord(rfields) => Array::length(rfields),\n          _ => Array::length(cargs)\n        }\n      } else {\n        Array::length(cargs)\n      }\n      128 + fcnt\n    } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n      128\n    } else if is_erecord(value) {\n      // Records are [tag@0][len@4][fields@8+] since #722, walkable like ctors.\n      match value {\n        ERecord(rfields) => 128 + Array::length(rfields),\n        _ => 0\n      }\n    } else if expr_tag(value) == 8 {\n      // #724 round 2: `let a = f(..)` — classify by f's DECLARED return type\n      // (agg_ret table). Only for a global fn name (a local shadowing `f`\n      // makes this a closure call of unknown type).\n      match get_ecall_callee(value) {\n        EIdent(cfn, _) => if find_local_slot(local_names, cfn) < 0 {\n          let rinfo = agg_ret_lookup(ctx.agg_ret_names, ctx.agg_ret_infos, cfn)\n          if rinfo > 0 {\n            rinfo\n          } else {\n            0\n          }\n        } else {\n          0\n        },\n        _ => 0\n      }\n    } else if is_eident(value) {\n      // Alias of a tracked binding: propagate its shape.\n      let src_slot = find_local_slot(local_names, get_eident_name(value))\n      if src_slot >= 0 {\n        let src_info = agg_slot_lookup(ctx.agg_local_slots, src_slot)\n        if src_info > 0 {\n          src_info\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n    } else {\n      0\n    }\n    Array::push(ctx.agg_local_slots, local_idx * 256 + agg_entry)\n    let mut rc_kind = 0\n    // #708 follow-up: set when this let's value is a borrow-returning call\n    // (`let a = Array::get(...)`) -- see the ELet/expr_tag==8 branch below for\n    // why a bare later reference to `name` needs loop_borrowed_names tracking.\n    let mut is_borrow_ret_ext = false\n    if ctx.enable_rc {\n      if val_is_float {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_etuple(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_earray(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_erecord(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_ctor_call(value, ctx.ctor_table) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_nullary_ctor_ident(value, ctx.ctor_table) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_eident(value) {\n        let src = get_eident_name(value)\n        if array_contains_str(ctx.heap_binding_names, src) {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n          if array_contains_str(ctx.rc_alias_dup_names, name) {\n            // #709 follow-up: `src` landing in heap_binding_names is a\n            // classification heuristic (ECall scalar-return coverage is a\n            // finite whitelist + signature-based inference; see\n            // perceus/index.vibe's compute_scalar_returning_names doc), not a\n            // proof. A misclassified scalar aliased a 2nd+ time reaches here;\n            // the old unguarded emit_rc_dup_local blindly treated its numeric\n            // value as a heap pointer minus 4 and read/wrote that address,\n            // corrupting arbitrary low memory instead of crashing immediately\n            // -- exactly the \"free-list corruption with no local cause\" shape\n            // seen in #709's second, hard-to-localize crash. Every other dup\n            // call site already uses the runtime-tag-checked guarded version;\n            // this was the one remaining unguarded increment.\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      } else if expr_tag(value) == 8 {\n        let callee = get_ecall_callee(value)\n        // #708: this hand-rolled check duplicated (incompletely) the borrow-return\n        // classification compile_call.vibe:64 already gets right. It only\n        // recognized the 3 hardcoded builtins, missing user-defined functions\n        // registered in ctx.borrow_ret_names (e.g. a `peek` wrapper whose body is\n        // `if ... { Array::get(...) } else default`, see #707's\n        // compute_borrow_returning_names). lift_match_scrutinees (normalize)\n        // rewrites every non-trivial match scrutinee into a `let __m_scrut = <call>`\n        // before this file ever sees it, so a match on a borrow-returning wrapper\n        // call landed here too. Missing the ctx.borrow_ret_names check made this\n        // ELet wrongly flag __m_scrut as an owned heap binding (rc_kind=2,\n        // heap_binding_names), and because __m_scrut is a NON-unique synthetic name\n        // shared by every lifted match in the enclosing function, a later drop\n        // scheduled for a *different* lift site's __m_scrut fired here too --\n        // double-decrementing the refcount shared with the live array element the\n        // borrow-returning call actually pointed into (single-slot corruption).\n        let is_borrow_ret = if is_eident(callee) {\n          let cn = get_eident_name(callee)\n          cn == \"Array::get\" || cn == \"__index\" || cn == \"Map::get\" || cn == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, cn)\n        } else {\n          false\n        }\n        // #710: a call whose CALLEE's declared return type is provably scalar\n        // (Int/Bool/Unit, e.g. `build_import_plan(...) -> Int`) owns no heap\n        // reference either -- same as a borrow-returning call, just for a\n        // different reason (nothing to retain a view INTO; there's no heap\n        // object at all). Skipping heap_binding_names here is required, not\n        // just an optimization: see CompileCtx.scalar_ret_names' doc comment\n        // for the memory-OOB crash a misclassified scalar alias causes.\n        //\n        // #709: ctx.scalar_ret_names only covers USER-DEFINED functions (via\n        // compute_scalar_returning_names, which walks declared `-> T`\n        // signatures). A BUILTIN with a provably scalar return type --\n        // `Array::length`/`Bytes::length`/`String::length`/`Map::has_key`, the\n        // scalar comparison/arithmetic builtins (`eq`/`not`/`add`/`sub`/`mul`/\n        // `lt`) -- fell through the same gap: neither borrow-ret nor\n        // scalar-ret, so `let n = Array::length(arr)` got heap_binding_names'd\n        // despite `n` being a plain tagged Int. A later guarded rc_dup/drop on\n        // `n` then untags-and-derefs a small integer as if it were a heap\n        // pointer -- for a small count like an array length, that reads/writes\n        // near a tiny address, a `memory access out of bounds` trap (not a\n        // leak). Recognize the same well-known scalar-returning builtins here.\n        //\n        // #709/#717 follow-up: the bare, unqualified names in that list\n        // (\"add\"/\"sub\"/\"mul\"/\"lt\"/\"eq\"/\"not\") are also legal USER-DEFINED\n        // top-level function names, and vibe lets a user definition shadow\n        // the scalar-arithmetic intrinsic of the same name -- compile_call.vibe\n        // already accounts for this at the CALL site (`prefer_bound_call`,\n        // gating the inline-intrinsic dispatch on the name NOT resolving to a\n        // registered function/local), but this classification never checked\n        // it, so `let s = add(x, y)` for a user `add: (MySet, String) ->\n        // MySet` was misread as the scalar intrinsic and never registered in\n        // heap_binding_names -- silently skipping the rc_dup this binding\n        // needed for its second owning use, leaving a live reference\n        // unbacked and eventually decrementing a free-list node past zero\n        // (set.vibe's own `add`/`contains`/`remove` hit exactly this; #717's\n        // minimal repro). A registered top-level function of that exact name\n        // means it's the user's, not the intrinsic -- defer to\n        // ctx.scalar_ret_names (which correctly reads that function's own\n        // signature) instead of guessing from the bare name.\n        let is_builtin_scalar_ret = if is_eident(callee) {\n          let cn = get_eident_name(callee)\n          // #719 review (Codex): `ctx.func_table.names` also contains the\n          // compiler's OWN always-registered builtin entries -- unlike\n          // \"add\"/\"sub\"/\"mul\"/\"lt\"/\"not\"/\"Map::has_key\"/\"Array::contains\"\n          // (pure inline intrinsics with no backing function unless a user\n          // defines one), \"Array::length\"/\"Bytes::length\"/\"String::length\"/\n          // \"eq\" are unconditionally pushed into fn_names_list/func_table for\n          // EVERY compile (see linked_compile.vibe's builtin_names_list), and\n          // a top-level `let` can never define a name containing `::` anyway.\n          // Treating their mere presence in func_table.names as \"shadowed\"\n          // made `is_user_shadowed` true unconditionally for these four,\n          // silently reverting #709's original fix (Array::length/eq calls\n          // misclassified as heap again). Only the names that can actually\n          // be absent (and thus meaningfully shadowed by a user definition)\n          // need the guard.\n          let is_always_registered = cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"eq\"\n          let is_user_shadowed = !is_always_registered && array_contains_str(ctx.func_table.names, cn)\n          !is_user_shadowed && (cn == \"Array::length\" || cn == \"Bytes::length\" || cn == \"String::length\" || cn == \"Map::has_key\" || cn == \"Array::contains\" || cn == \"eq\" || cn == \"not\" || cn == \"add\" || cn == \"sub\" || cn == \"mul\" || cn == \"lt\")\n        } else {\n          false\n        }\n        let is_scalar_ret = if is_eident(callee) {\n          array_contains_str(ctx.scalar_ret_names, get_eident_name(callee)) || is_builtin_scalar_ret\n        } else {\n          false\n        }\n        if is_borrow_ret || is_scalar_ret {\n          ()\n        } else {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        }\n        // #708 follow-up: a borrow-returning let (`let a = Array::get(xs, i)`)\n        // is deliberately left untracked above (rc_kind stays 0 -- it owns\n        // nothing to drop). But a LATER bare-ident reference to `a` passed\n        // into an owning parameter (`f(a)`) still needs the SAME retain a\n        // direct `f(Array::get(xs, i))` call already gets via\n        // cc_is_borrow_ret_call (compile_call.vibe) -- that check only\n        // inspects the ARGUMENT EXPRESSION'S OWN shape (is it a call?), so it\n        // never fires for a bare EIdent, even though the name's value is\n        // exactly as borrowed. Piggyback on the existing loop_borrowed_names\n        // mechanism (cc_is_loop_borrowed_ident), scoped tightly to this let's\n        // own body via push-before/truncate-after so it never leaks past this\n        // binding's scope: reproduced as `let a = Array::get(plan, i); ...\n        // f(a) && a.field == y ...` inside a `while` loop corrupting the heap\n        // (only outside a loop, or with a non-borrow-bound `a`, it was fine --\n        // Perceus's own multi-use dup accounting for a loop-repeated binding\n        // apparently only budgets for the loop-carried case this mechanism\n        // already exists for).\n        is_borrow_ret_ext = is_borrow_ret\n      } else if is_edot(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n      } else if is_efn(value) {\n        // NOTE: must be a nested `if`, not `is_efn(value) && efn_is_capturing(...)`:\n        // `&&` evaluates both operands, so the `&&` form ran efn_is_capturing\n        // (which calls get_efn_params) on EVERY non-heap `let` value that reached\n        // this arm — e.g. `let o = 5` — throwing \"not EFn\" and breaking RC compile\n        // of any function with a scalar/`if`/`match`-valued `let` (#702 blocker A).\n        // Guarding with is_efn first keeps efn_is_capturing to genuine closures.\n        if efn_is_capturing(value, ctx) {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        } else {\n          ()\n        }\n      } else if expr_tag(value) == 7 {\n        // #715: `let x = if cond { a } else { b }` fell all the way through\n        // this shape-based classification chain (tuple/array/record/ctor\n        // call/EDot/EFn all explicitly handled above) to the silent default\n        // `else { () }`, leaving rc_kind at 0. Since rc_kind gates the ENTIRE\n        // dup-emission loop just below (`if ctx.enable_rc && rc_kind > 0`),\n        // an if/else-valued let NEVER got any of its planned dups emitted at\n        // its declaration site, no matter how many `PaDup` actions the\n        // Perceus plan (perceus/index.vibe) computed for its name -- the\n        // plan and the actual generated code silently disagreed. A binding\n        // used more than once (e.g. `let __bi_expr = if enable_rc {...} else\n        // {...}`, then passed to several accessor calls later) would have 1\n        // reference but N planned consumers, each dropping it via their own\n        // internal parameter cleanup: the first consumer's drop is real, the\n        // second is a same-address double-free (#715's exact signature).\n        // Treat it the same as EDot/ctor-call above: conservatively heap\n        // (the guarded rc_dup/rc_drop already no-op on a genuinely scalar\n        // value, so over-including here is safe, matching the existing\n        // \"leak/no-op at worst, never corrupt\" design used throughout this\n        // file -- see the is_borrow_ret/is_scalar_ret comments above).\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if expr_tag(value) == 16 {\n        // #715 follow-up: same gap as the EIf case just above, for\n        // `let x = match scrutinee { ... }` (EMatch, expr_tag 16) --\n        // extremely common in hand-written parser/checker code (e.g. `let\n        // tok = match peek(...) { ... }`), so a match-valued let used more\n        // than once hit the identical same-address double-free.\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if expr_tag(value) == 9 || expr_tag(value) == 14 {\n        // #715 follow-up: same gap again, for a block-expression-valued let\n        // -- `let x = { let tmp = f(); tmp }` (ELet, expr_tag 9) or\n        // `let x = { f(); g() }` (ESeq, expr_tag 14) as the RHS. Just as\n        // common in hand-written parser/codegen code as the EIf/EMatch cases\n        // above (a multi-statement block used as an expression).\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        // #715 follow-up: `expr_tag` only enumerates a subset of `Expr`\n        // constructors and returns -1 for the rest (EHandle, ELabeledArg,\n        // EMap, ESpread, EStringInterp, EBreak, EContinue, EReturn, EThrow,\n        // EWhile, EForIn, ELoop, ...) -- none of which are covered by the\n        // is_etuple/is_earray/.../is_efn checks above either, so ANY of them\n        // as a let's value silently fell through to no RC treatment, same\n        // bug class as the EIf/EMatch/ELet/ESeq cases already fixed. Rather\n        // than keep enumerating one crash at a time, default the true\n        // catch-all to heap too EXCEPT a bare identifier (`let a = b`, an\n        // ALIAS handled by its own dedicated PaAliasDup mechanism elsewhere\n        // -- see the is_eident-guarded rc_alias_dup_names handling later in\n        // this function; forcing rc_kind here would double-manage it) and\n        // literals (EInt/EBool/EFloat/EString/EUnit -- provably scalar, no\n        // guarded-no-op overhead worth paying on every such binding). Over-\n        // including a genuinely scalar value here is safe: the guarded\n        // rc_dup/rc_drop already no-op on non-heap-tagged values (the same\n        // property every other case in this chain already relies on).\n        let __sf_tag = expr_tag(value)\n        if is_eident(value) || __sf_tag == 0 || __sf_tag == 1 || __sf_tag == 2 || __sf_tag == 3 || __sf_tag == 22 {\n          ()\n        } else {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        }\n      }\n    } else {\n      ()\n    }\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    // #712: this `let` may SHADOW an outer loop-borrowed identifier of the same\n    // name (e.g. `while ... { let x = ...; f(x) }` rebinding `x` inside a loop\n    // whose header already loop-borrowed an outer `x`, #706). cc_is_loop_borrowed_ident\n    // (compile_call.vibe) matches by NAME ONLY, so without this an owning call on\n    // the INNER `x` would be mistaken for a reference to the OUTER loop-carried\n    // one -- a spurious rc_dup now, and (via loop_consumed_names) a spurious extra\n    // epilogue rc_drop for a parameter this `let` never touches. Mask every\n    // existing occurrence of `name` out of loop_borrowed_names for exactly the\n    // scope of `body`, then restore the same count after; membership is all\n    // `array_contains_str` ever tests, so compacting out of order is safe.\n    let mut lb_shadow_removed = 0\n    if ctx.enable_rc {\n      let lb_arr = ctx.loop_borrowed_names\n      let lb_n = Array::length(lb_arr)\n      let mut lb_w = 0\n      let mut lb_i = 0\n      while lb_i < lb_n {\n        let e = Array::get(lb_arr, lb_i)\n        if e == name {\n          lb_shadow_removed = lb_shadow_removed + 1\n        } else {\n          Array::set(lb_arr, lb_w, e)\n          lb_w = lb_w + 1\n        }\n        lb_i = lb_i + 1\n      }\n      Array::truncate(lb_arr, lb_w)\n    } else {\n      ()\n    }\n    // #708 follow-up: scope `name` into loop_borrowed_names for exactly the\n    // extent of `body`'s compilation (push before, truncate after), so a bare\n    // later reference to a borrow-bound name gets the same retain-before-\n    // owning-call treatment a loop-carried parameter already gets. Safe to do\n    // even outside a loop (loop_borrowed_names is otherwise empty there, and\n    // this push/truncate pair never leaks past this let's own body).\n    let lb_mark = Array::length(ctx.loop_borrowed_names)\n    if ctx.enable_rc && is_borrow_ret_ext {\n      Array::push(ctx.loop_borrowed_names, name)\n    } else {\n      ()\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    if ctx.enable_rc && is_borrow_ret_ext {\n      Array::truncate(ctx.loop_borrowed_names, lb_mark)\n    } else {\n      ()\n    }\n    // #712: restore the shadow-masked occurrences now that `body` (the only\n    // scope where `name` shadows the outer loop-borrowed binding) is compiled.\n    let mut lb_restore_i = 0\n    while lb_restore_i < lb_shadow_removed {\n      Array::push(ctx.loop_borrowed_names, name)\n      lb_restore_i = lb_restore_i + 1\n    }\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_local_get(buf, nl2)\n        nl2 + 1\n      } else {\n        if ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else if rc_kind == 1 {\n          emit_rc_drop_local(buf, local_idx, false)\n        } else {\n          emit_rc_drop_local(buf, local_idx, true)\n        }\n        nl2\n      }\n    } else {\n      nl2\n    }\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n      let mut self_cap_idx = -1\n      let mut bci = 0\n      while bci < Array::length(caps) {\n        if Array::get(caps, bci) == name {\n          self_cap_idx = bci\n        }\n        bci = bci + 1\n      }\n      if self_cap_idx >= 0 {\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, -4)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, local_idx)\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n      }\n      0\n    } else {\n      0\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 11 {\n    let name = get_eletmut_name(expr)\n    let value = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    emit_dbg_line_for(buf, value, ctx)\n    Array::push(local_names, name)\n    if expr_is_floatish(value, local_names, ctx) {\n      Array::push(ctx.float_local_slots, local_idx * 2 + 1)\n    } else if slot_is_floatish(ctx, local_idx) {\n      Array::push(ctx.float_local_slots, local_idx * 2)\n    }\n    // #678: track integral mutable bindings too (an Int local stays Int across\n    // reassignments — the checker forbids changing its type), so a bare-ident\n    // `==` on it uses the direct i64 path.\n    if expr_is_intish(value, local_names, ctx) {\n      Array::push(ctx.int_local_slots, local_idx * 2 + 1)\n    } else if slot_is_intish(ctx, local_idx) {\n      Array::push(ctx.int_local_slots, local_idx * 2)\n    }\n    if mut_needs_ref_cell(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      if ctx.enable_rc && ctx.rc_alloc_func_idx >= 0 && ctx.rc_drop_func_idx >= 0 && expr_is_intish(value, local_names, ctx) {\n        // #699 RC-managed ref cell: a captured `let mut` is heap-boxed for\n        // by-reference sharing; under RC make that box an RC object so it is\n        // reclaimed instead of leaking. Layout [alloc_size@0][rc_count@4 +\n        // class8@7][payload@8]; the cell local holds vptr=block+8 (even) so the\n        // read/write/assign-op sites are byte-identical to the raw-box path. The\n        // capturing closure dups it (compile_lambda.vibe) and drops it via the\n        // class-7 owned-capture recursion (gen_rc_drop_body); the defining scope\n        // drops it inline below. Restricted to intish (scalar) values so the\n        // payload is never a heap object that the body could return (no\n        // use-after-free): class-8 payload-drop then stays a no-op.\n        emit_i64_const(buf, 16)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 16)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 8)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_local_set(buf, local_idx)\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n        emit_i64_store(buf, 3, 0)\n        let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        nl2\n      } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n      }\n    } else {\n      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table) || is_nullary_ctor_ident(value, ctx.ctor_table) || expr_is_floatish(value, local_names, ctx)) {\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      // #715: the ELet path (tag 9) emits every dup the Perceus plan budgeted\n      // for a binding (ctx.rc_dup_names) at its declaration site -- this\n      // ELetMut path never did, while the matching scope-end drop below DID\n      // fire. A `let mut found = None; while .. { match found { .. } }; found`\n      // accumulator (checker_effects.vibe's lookup_fn_effs) gets a planned\n      // dup from the #706 borrow-retention bump (the bare `match found`\n      // borrow) plus a planned scope-end drop; with the dup silently skipped,\n      // the tail-returned Option's only reference was consumed by the return\n      // AND by the drop -- the caller's lifted `__m_scrut_N` scrutinee then\n      // recursively re-dropped the freed block (byte-exact double-free\n      // confirmed by the drop-site-stamped shadow diagnostic: first free at\n      // this branch's scope-end drop, second inside\n      // check_perform_effects_expr_tx). The guarded dup no-ops on scalars, so\n      // over-emission for a scalar-planned name is harmless.\n      if ctx.enable_rc {\n        let mut mdbi = 0\n        while mdbi < Array::length(ctx.rc_dup_names) {\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          mdbi = mdbi + 1\n        }\n      } else {\n        ()\n      }\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\n      let is_self = assign_value_mentions(value, name)\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\n        let old_temp = next_local\n        let scratch = next_local + 1\n        let base = next_local + 2\n        emit_local_get(buf, idx)\n        emit_local_set(buf, old_temp)\n        let elems = get_etuple_elems(value)\n        let mut ei = 0\n        while ei < Array::length(elems) {\n          let elem = Array::get(elems, ei)\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\n            emit_local_set(buf, scratch)\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          ei = ei + 1\n        }\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\n        emit_local_set(buf, idx)\n        emit_local_get(buf, old_temp)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      } else {\n        if is_heap_mut && !is_self {\n          emit_local_get(buf, idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n        emit_local_set(buf, idx)\n        if is_heap_mut && !is_self && is_edot(value) {\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n        } else {\n          ()\n        }\n        // #715: the Perceus plan's dup budget for a `let mut` binding\n        // (ctx.rc_dup_names occurrences) is applied ONCE, to the INITIAL value\n        // at the declaration site -- but the scope-end drop and every\n        // remaining owning use consume the binding's CURRENT value. After a\n        // reassignment, the freshly stored value carries only its own single\n        // reference; without re-applying the budget here, the tail use plus\n        // the scope-end drop over-consume it by exactly the planned dup count\n        // (checker_effects.vibe's lookup_fn_effs: `let mut found = None;\n        // ... found = Some(..) ...; found` -- the returned Some was freed by\n        // the binding's scope-end drop while the caller still held it; the\n        // #706 borrow-retention bump from the bare `match found` is what put\n        // the +1 in the budget). Worst case this over-retains (a leak) when\n        // part of the budget was already spent before the reassign -- the\n        // codebase-wide \"leak/no-op at worst, never corrupt\" trade.\n        if ctx.enable_rc && is_heap_mut && !is_self {\n          let mut adbi = 0\n          while adbi < Array::length(ctx.rc_dup_names) {\n            if Array::get(ctx.rc_dup_names, adbi) == name {\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\n            } else {\n              ()\n            }\n            adbi = adbi + 1\n          }\n        } else {\n          ()\n        }\n        compile_expr(buf, body, local_names, nl, ctx, ld)\n      }\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_assignop_rc_tag_fix(buf, ctx.enable_rc, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    emit_dbg_line_for(buf, first, ctx)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_77 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_expr.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, agg_info_of_ident, agg_log_reset_above, cov_emit_branch, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, emit_unbox_float, expr_tag, int_log_reset_above, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_ctor_call, is_efn, is_eident, is_etuple, is_nullary_ctor_ident, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail.vibe {\n  compile_expr_tail, expr_is_floatish, expr_is_intish\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n// #672: emit structural equality for two tuples (non-rc layout: element i at\n// ptr+i*8, value = raw pointer). The arity comes from whichever operand is a\n// tuple literal (the checker guarantees same-arity tuples on both sides).\n// Evaluates each operand to a pointer in a temp local, then ANDs an element-wise\n// generic `eq` over all elements. Produces a raw i64 0/1. `compile_expr_fn` is\n// the main expression compiler, threaded to avoid a forward reference.\nlet emit_tuple_struct_eq: (Bytes, Expr, Expr, Int, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, num, local_names, next_local, ctx, ld, compile_expr_fn) -> {\n  let aptr = next_local\n  Array::push(local_names, \"__eqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__eqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  // RC tuples are tagged (`value = (block_start+8)|1`) and carry an 8-byte\n  // header (type_id/length) before the fields, unlike the bare `i*8`-packed\n  // non-RC layout — untag and skip the header so field reads land on the\n  // actual elements instead of the header words (previously read as if they\n  // were fields 0/1, making equal-valued tuples at different addresses\n  // compare unequal; this is also why the RC path was disabled entirely\n  // before this fix).\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  if ctx.enable_rc {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_local_set(buf, bptr)\n  let field_off = if ctx.enable_rc {\n    8\n  } else {\n    0\n  }\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  emit_i64_const(buf, 1)\n  let mut i = 0\n  while i < num {\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 3, field_off + i * 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    i = i + 1\n  }\n  nl2\n}\n\n// #672: structural equality for two enum constructor values (non-rc layout:\n// value = ptr|1, tag i32 at ptr+0, field i at ptr+8+i*8). One operand is a ctor\n// literal so the field count `fc` is statically known. Compares the runtime\n// tags first (different variants => not equal, e.g. `Circle(5) != Point`), then\n// — when tags match — ANDs an element-wise generic `eq` over the `fc` fields.\n// Flat ctors (Int/String/Bool fields) are correct; nested-ctor fields fall back\n// to `eq` (so recursive types stay non-structural — tracked in #672).\nlet emit_ctor_struct_eq: (Bytes, Expr, Expr, Int, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, fc, local_names, next_local, ctx, ld, compile_expr_fn) -> {\n  let aptr = next_local\n  Array::push(local_names, \"__ceqa\")\n  let bptr = next_local + 1\n  Array::push(local_names, \"__ceqb\")\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, aptr)\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_local_set(buf, bptr)\n  emit_local_get(buf, aptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_local_get(buf, bptr)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_eq(buf)\n  emit_if_i64(buf)\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n  if fc == 63 {\n    // #724 round 2: DYNAMIC field count — fc 63 marks an enum-typed value\n    // whose variant (hence argc) is only known at runtime. Equal tags imply\n    // equal argc, so loop over argc@4 read from the value itself.\n    let res_l = nl2\n    let cnt_l = nl2 + 1\n    let ii_l = nl2 + 2\n    Array::push(local_names, \"__ceq_res\")\n    Array::push(local_names, \"__ceq_cnt\")\n    Array::push(local_names, \"__ceq_i\")\n    emit_i64_const(buf, 1)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load(buf, 2, 4)\n    emit_i64_extend_i32_u(buf)\n    emit_local_set(buf, cnt_l)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, ii_l)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, ii_l)\n    emit_local_get(buf, cnt_l)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    emit_local_get(buf, res_l)\n    emit_local_get(buf, aptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_local_get(buf, bptr)\n    emit_i32_wrap_i64(buf)\n    emit_local_get(buf, ii_l)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 8)\n    emit_i32_mul(buf)\n    emit_i32_add(buf)\n    emit_i64_load(buf, 3, 8)\n    emit_call(buf, eq_fidx)\n    emit_i64_and(buf)\n    emit_local_set(buf, res_l)\n    emit_local_get(buf, ii_l)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, ii_l)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, res_l)\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2 + 3\n  } else {\n    emit_i64_const(buf, 1)\n    let mut i = 0\n    while i < fc {\n      emit_local_get(buf, aptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_local_get(buf, bptr)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 8 + i * 8)\n      emit_call(buf, eq_fidx)\n      emit_i64_and(buf)\n      i = i + 1\n    }\n    emit_else(buf)\n    emit_i64_const(buf, 0)\n    emit_end(buf)\n    nl2\n  }\n}\n\n// #672: emit the equality test for `lhs == rhs`, leaving a raw i64 0/1 on the\n// stack (1 = equal). Routes through the structural comparators when an operand\n// is a tuple / ctor literal (non-rc), else the generic runtime `eq`. Every `==`\n// / `!=` codegen site — the general expression form AND the if / `!`-if / while\n// condition fast-paths — calls this, so structural equality is consistent\n// across all of them (the post-processing each site applies to the 0/1 result —\n// `i32_wrap`/`i32_eqz`/rc-shift — is unchanged).\nlet emit_eq_value: (Bytes, Expr, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, ce) -> {\n  // #724: aggregate shape of a bare-ident operand whose `let` value was a\n  // tuple/ctor/record literal (kind*64+n, or -1) — extends the structural\n  // comparators below to both-sides-bound comparisons.\n  let lhs_agg = agg_info_of_ident(ctx.agg_local_slots, lhs, local_names)\n  let rhs_agg = agg_info_of_ident(ctx.agg_local_slots, rhs, local_names)\n  if is_etuple(lhs) || is_etuple(rhs) {\n    let lit = if is_etuple(lhs) {\n      lhs\n    } else {\n      rhs\n    }\n    emit_tuple_struct_eq(buf, lhs, rhs, Array::length(get_etuple_elems(lit)), local_names, next_local, ctx, ld, ce)\n  } else if lhs_agg / 64 == 1 || rhs_agg / 64 == 1 {\n    // Tracked tuple binding on at least one side; the checker guarantees the\n    // other side is the same tuple type, so its arity matches.\n    let tn = if lhs_agg / 64 == 1 {\n      lhs_agg % 64\n    } else {\n      rhs_agg % 64\n    }\n    emit_tuple_struct_eq(buf, lhs, rhs, tn, local_names, next_local, ctx, ld, ce)\n  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {\n    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {\n      lhs\n    } else {\n      rhs\n    }\n    let cfc = if is_ctor_call(clit, ctx.ctor_table) {\n      Array::length(get_ecall_args(clit))\n    } else {\n      0\n    }\n    emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\n  } else if lhs_agg / 64 == 2 || rhs_agg / 64 == 2 {\n    // Tracked ctor/record binding: values carry [tag@0][argc@4][fields@8+],\n    // so the tag-comparing structural walk applies. When BOTH sides are\n    // tracked as DIFFERENT variants the field counts can differ — walk the\n    // larger count; the tag comparison short-circuits unequal variants\n    // before any field read, and equal tags imply equal counts.\n    let lfc = if lhs_agg / 64 == 2 {\n      lhs_agg % 64\n    } else {\n      0\n    }\n    let rfc = if rhs_agg / 64 == 2 {\n      rhs_agg % 64\n    } else {\n      0\n    }\n    let cfc = if lfc > rfc {\n      lfc\n    } else {\n      rfc\n    }\n    emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\n  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {\n    // A definitely-integer comparison: a direct i64.eq is both faster and\n    // CORRECT for the full value range, sidestepping the `eq` builtin's\n    // string-pointer fall-back. The type checker guarantees the other operand\n    // is the same scalar type, so one intish side is enough.\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n    nl2\n  } else {\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n    emit_call(buf, eq_fidx)\n    nl2\n  }\n}\n\nexport let rec compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      if ctx.enable_rc {\n        2\n      } else {\n        1\n      }\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let lo = Double::to_i64_bits_lo(v)\n    let hi = Double::to_i64_bits_hi(v)\n    emit_f64_const_lohi(buf, lo, hi)\n    emit_i64_reinterpret_f64(buf)\n    if ctx.enable_rc {\n      Array::push(local_names, \"__fbits\")\n      Array::push(local_names, \"__fbox\")\n      emit_box_float(buf, ctx, next_local, next_local + 1)\n      next_local + 2\n    } else {\n      next_local\n    }\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl_result = __tl_i\n        __tl_i = -1\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      let mut __ci_idx = -1\n      let __ci_len = Array::length(ctx.const_int_names)\n      let mut __ci_j = 0\n      while __ci_j < __ci_len {\n        if Array::get(ctx.const_int_names, __ci_j) == name {\n          __ci_idx = __ci_j\n          __ci_j = __ci_len\n        } else {\n          __ci_j = __ci_j + 1\n        }\n      }\n      if __ci_idx >= 0 {\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        next_local\n      } else {\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          if ctx.enable_rc {\n            emit_i64_const(buf, 16)\n            emit_call(buf, ctx.rc_alloc_func_idx)\n            emit_local_set(buf, ptr_l)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 16)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 1)\n            emit_i32_store8(buf, 0, 7)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 8)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 12)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 8)\n            emit_i64_add(buf)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          } else {\n            emit_global_get(buf, 0)\n            emit_i64_extend_i32_u(buf)\n            emit_local_set(buf, ptr_l)\n            emit_global_get(buf, 0)\n            emit_i32_const(buf, 8)\n            emit_i32_add(buf)\n            emit_global_set(buf, 0)\n            emit_heap_grow_after_heap_set(buf, ctx)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, tag_c)\n            emit_i32_store(buf, 2, 0)\n            emit_local_get(buf, ptr_l)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 0)\n            emit_i32_store(buf, 2, 4)\n            emit_local_get(buf, ptr_l)\n            emit_i64_const(buf, 1)\n            emit_i64_or(buf)\n            next_local + 1\n          }\n        } else {\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut __tf_j = 0\n          let mut __tf_result = -1\n          while __tf_j < fn_len {\n            if Array::get(ctx.func_table.names, __tf_j) == name {\n              __tf_result = __tf_j\n              __tf_j = fn_len\n            } else {\n              __tf_j = __tf_j + 1\n            }\n          }\n          if __tf_result < 0 {\n            let mut diag = String::concat(\"undefined variable (ident): \", name)\n            diag = String::concat(diag, \" | locals=[\")\n            let mut di = 0\n            while di < len {\n              if di > 0 {\n                diag = String::concat(diag, \",\")\n              }\n              diag = String::concat(diag, Array::get(local_names, di))\n              di = di + 1\n            }\n            diag = String::concat(diag, \"]\")\n            throw(diag)\n          }\n          let fni = __tf_result\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          if array_contains_str(ctx.thunk_names, name) {\n            emit_i64_const(buf, 0)\n            emit_call(buf, fidx)\n            next_local\n          } else {\n            let table_slot = fidx - ctx.func_offset\n            emit_i64_const(buf, (table_slot<<2)|2)\n            next_local\n          }\n        }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    if op == \"&&\" || op == \"||\" {\n      // Short-circuit lowering. The old eager `i64.and`/`i64.or` (still what\n      // emit_binop_op does) evaluated BOTH operands, so `false && inc()` ran\n      // inc()'s side effects. Bool reprs: false = 0 in both lanes, true = 2\n      // (tagged) under RC / 1 otherwise; eqz treats any non-zero as true.\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      if op == \"&&\" {\n        emit_if_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_else(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_end(buf)\n        nl2\n      } else {\n        emit_if_i64(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_else(buf)\n        emit_i64_const(buf, if ctx.enable_rc {\n          2\n        } else {\n          1\n        })\n        emit_end(buf)\n        nl2\n      }\n    } else if op == \"==\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      // #704: float `==`/`!=` under RC must NOT go through emit_eq_value — under\n      // RC a float is a BOXED heap value, so the generic eq compares box\n      // pointers (always unequal for two distinct boxes), making `0.0 == 0.0`\n      // false. Divert floatish RC `==`/`!=` to the float branch below, which\n      // unboxes and compares values with f64_eq/f64_ne. (Non-RC keeps the raw\n      // i64-bits compare here, so the default path is byte-identical.)\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if op == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nle\n    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      }\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n        if op == \"+\" {\n          emit_f64_add(buf)\n        } else if op == \"-\" {\n          emit_f64_sub(buf)\n        } else if op == \"*\" {\n          emit_f64_mul(buf)\n        } else {\n          emit_f64_div(buf)\n        }\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\n          nl2 + 2\n        } else {\n          nl2\n        }\n      } else {\n        if op == \"==\" {\n          emit_f64_eq(buf)\n        } else if op == \"!=\" {\n          emit_f64_ne(buf)\n        } else if op == \"<\" {\n          emit_f64_lt(buf)\n        } else if op == \">\" {\n          emit_f64_gt(buf)\n        } else if op == \"<=\" {\n          emit_f64_le(buf)\n        } else if op == \">=\" {\n          emit_f64_ge(buf)\n        } else {\n          throw(String::concat(\"unsupported float binop: \", op))\n        }\n        emit_i64_extend_i32_s(buf)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        nl2\n      }\n    } else if ctx.enable_rc {\n      if op == \"<<\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shl(buf)\n        nl2\n      } else if op == \">>\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shr_s(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n        nl2\n      } else {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_binop_op(buf, op)\n        if op == \"*\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shr_s(buf)\n        } else if op == \"/\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else {\n          ()\n        }\n        nl2\n      }\n    } else {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n    }\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      if expr_is_floatish(operand, local_names, ctx) {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        // #745: under RC the operand is a BOXED float — unbox before the\n        // f64.neg and rebox the result, exactly like the float binop path.\n        // Without this, `-1.0` negated the box POINTER and the \"float\" that\n        // escaped was garbage bits.\n        if ctx.enable_rc {\n          emit_unbox_float(buf)\n        }\n        emit_f64_reinterpret_i64(buf)\n        emit_f64_neg(buf)\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl, nl + 1)\n          nl + 2\n        } else {\n          nl\n        }\n      } else {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      }\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        if cop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          cnl2\n        } else if cop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          cnl2\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\n          // #704: unbox boxed floats under RC before reinterpreting as f64, and\n          // handle ==/!= here (f64_eq/f64_ne) so float equality in an if/while\n          // condition compares values, not box pointers.\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"==\" {\n            emit_f64_eq(buf)\n          }\n          else if cop == \"!=\" {\n            emit_f64_ne(buf)\n          }\n          else if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    } else if cond_tag == 6 {\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            if iop == \"==\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if iop == \"!=\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\n              // #704: unbox boxed floats under RC; handle ==/!= via f64_eq/f64_ne.\n              // This arm is `!(ilhs iop irhs)`, so the trailing eqz negates.\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if ctx.enable_rc {\n                emit_unbox_float(buf)\n              } else {\n                ()\n              }\n              emit_f64_reinterpret_i64(buf)\n              if iop == \"==\" {\n                emit_f64_eq(buf)\n              }\n              else if iop == \"!=\" {\n                emit_f64_ne(buf)\n              }\n              else if iop == \"<\" {\n                emit_f64_lt(buf)\n              }\n              else if iop == \">\" {\n                emit_f64_gt(buf)\n              }\n              else if iop == \"<=\" {\n                emit_f64_le(buf)\n              }\n              else {\n                emit_f64_ge(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            } else {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if iop == \"<\" {\n                emit_i64_lt_s(buf)\n              }\n              else if iop == \">\" {\n                emit_i64_gt_s(buf)\n              }\n              else if iop == \"<=\" {\n                emit_i64_le_s(buf)\n              }\n              else {\n                emit_i64_ge_s(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            }\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    // #cov branch: the then-branch was taken.\n    cov_emit_branch(buf, ctx.cov)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    // #678: the then-branch may have logged integral slots >= names_len_before\n    // that the else-branch is about to reuse; drop them so a non-`let` rebind\n    // there is not misread as int.\n    int_log_reset_above(ctx, names_len_before)\n    agg_log_reset_above(ctx.agg_local_slots, names_len_before)\n    // #cov branch: the else-branch was taken.\n    cov_emit_branch(buf, ctx.cov)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

let cli_adapter_source_78 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_module_expr.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Stmt, bytebuf_new, bytebuf_to_bytes\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, cov_disabled\n}\n\nimport .. / wasm_emit {\n  emit_code_section_with_locals, emit_export_section_multi, emit_function_section, emit_header, emit_type_section_multi\n}\n\nimport ./compile_expr.vibe {\n  compile_expr\n}\n\n//# Functions\n\nexport let compile_module_expr: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {\n  let fresh_int_array: () -> Array[Int] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_array: () -> Array[String] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_expr_array: () -> Array[Expr] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fn_names_list = fresh_string_array()\n  let fn_param_counts = fresh_int_array()\n  let export_names = fresh_string_array()\n  let export_indices = fresh_int_array()\n  let fn_bodies_list = fresh_expr_array()\n  let fn_param_names_list = fresh_string_matrix()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let cur_idx = Array::length(fn_names_list)\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_bodies_list, body)\n          let pnames = fresh_string_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pname, _) = Array::get(params, pi)\n            Array::push(pnames, pname)\n            pi = pi + 1\n          }\n          Array::push(fn_param_names_list, pnames)\n          if is_export {\n            Array::push(export_names, name)\n            Array::push(export_indices, cur_idx)\n          }\n          0\n        },\n        _ => 0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  let num_funcs = Array::length(fn_names_list)\n  if num_funcs == 0 {\n    let out = bytebuf_new()\n    let empty_type_defs = fresh_int_array()\n    let empty_type_indices = fresh_int_array()\n    let empty_body = bytebuf_new()\n    let empty_bodies = fresh_bytes_matrix()\n    Array::push(empty_bodies, empty_body)\n    let empty_local_counts = fresh_int_array()\n    Array::push(empty_local_counts, 0)\n    emit_header(out)\n    emit_type_section_multi(out, empty_type_defs)\n    emit_function_section(out, empty_type_indices)\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\n    bytebuf_to_bytes(out)\n  } else {\n    let fn_indices_list = fresh_int_array()\n    let fn_returns_list = fresh_int_array()\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\n    let mut fi = 0\n    while fi < num_funcs {\n      Array::push(fn_indices_list, fi)\n      Array::push(fn_returns_list, 1)\n      Array::push(fn_needs_env_list, false)\n      fi = fi + 1\n    }\n    let type_defs = fresh_int_array()\n    let mut ti = 0\n    while ti < num_funcs {\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\n      Array::push(type_defs, 1)\n      ti = ti + 1\n    }\n    let type_indices = fresh_int_array()\n    let mut tii = 0\n    while tii < num_funcs {\n      Array::push(type_indices, tii)\n      tii = tii + 1\n    }\n    let lt_m = LambdaTable::{\n      bodies: fresh_bytes_matrix(),\n      param_counts: fresh_int_array(),\n      captures: fresh_string_matrix(),\n      meta_i32: fresh_int_array(),\n      meta_i64: fresh_int_array()\n    }\n    let empty_str_table = StrTable::{\n      strs: fresh_string_array(),\n      offsets: fresh_int_array(),\n      lengths: fresh_int_array()\n    }\n    let empty_ctor_table = CtorTable::{\n      names: fresh_string_array(),\n      tags: fresh_int_array(),\n      field_counts: fresh_int_array(),\n      type_names: fresh_string_array(),\n      struct_names: fresh_string_array(),\n      struct_field_names: fresh_string_matrix()\n    }\n    let empty_thunk_names = fresh_string_array()\n    let empty_const_int_names = fresh_string_array()\n    let empty_const_int_values = fresh_int_array()\n    let empty_rc_drop_names = fresh_string_array()\n    let empty_rc_alias_dup_names = fresh_string_array()\n    let empty_rc_dup_names = fresh_string_array()\n    let bodies = fresh_bytes_matrix()\n    let local_counts = fresh_int_array()\n    let mut bi = 0\n    while bi < num_funcs {\n      let body = Array::get(fn_bodies_list, bi)\n      let param_names = Array::get(fn_param_names_list, bi)\n      let body_buf = bytebuf_new()\n      let local_names = fresh_string_array()\n      let mut pi = 0\n      while pi < Array::length(param_names) {\n        Array::push(local_names, Array::get(param_names, pi))\n        pi = pi + 1\n      }\n      let param_count = Array::length(param_names)\n      let empty_ref_cells = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list,\n          indices: fn_indices_list,\n          params: fn_param_counts,\n          returns: fn_returns_list,\n          needs_env: fn_needs_env_list\n        },\n        str_table: empty_str_table,\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: empty_ctor_table,\n        thunk_names: empty_thunk_names,\n        const_int_names: empty_const_int_names,\n        const_int_values: empty_const_int_values,\n        enable_rc: false,\n        rc_shadow: false,\n        rc_drop_names: empty_rc_drop_names,\n        rc_alias_dup_names: empty_rc_alias_dup_names,\n        heap_binding_names: fresh_string_array(),\n        rc_drop_func_idx: -1,\n        rc_alloc_func_idx: -1,\n        heap_grow_check_func_idx: -1,\n        rc_dup_names: empty_rc_dup_names,\n        float_local_slots: fresh_int_array(),\n        int_local_slots: fresh_int_array(),\n        agg_local_slots: fresh_int_array(),\n        agg_ret_names: fresh_string_array(),\n        agg_ret_infos: fresh_int_array(),\n        effect_names: fresh_string_array(),\n        effect_op_keys: fresh_string_array(),\n        effect_op_arities: fresh_int_array(),\n        cov: cov_disabled(),\n        dbg_line_idx: -1,\n        dbg_line_nl: fresh_int_array(),\n        dbg_line_file_id: 0,\n        loop_borrowed_names: fresh_string_array(),\n        loop_consumed_names: fresh_string_array(),\n        borrow_ret_names: fresh_string_array(),\n        scalar_ret_names: fresh_string_array()\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n")
}

