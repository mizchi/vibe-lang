nexport let compile_expr_tail7: (Bytes, Array[String], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, parts, local_names, next_local, ctx, ld, compile_expr) -> {\n  let make_concat_expr: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\n    Array::push(args, lhs)\n    Array::push(args, rhs)\n    ECall(EIdent(\"String::concat\"), args)\n  }\n  let make_to_string_expr: (String) -> Expr = (name) -> {\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\n    Array::push(args, EIdent(name))\n    ECall(EIdent(\"__to_string\"), args)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut si2 = 0\n  while si2 < plen {\n    let part = Array::get(parts, si2)\n    if si2 % 2 == 0 {\n      if String::length(part) > 0 {\n        if has_val {\n          result = make_concat_expr(result, EString(part))\n        } else {\n          result = EString(part)\n          has_val = true\n        }\n      }\n    } else {\n      let ep = make_to_string_expr(part)\n      if has_val {\n        result = make_concat_expr(result, ep)\n      } else {\n        result = ep\n        has_val = true\n      }\n    }\n    si2 = si2 + 1\n  }\n  compile_expr(buf, result, local_names, next_local, ctx, ld)\n}\n\n\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail5: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  match expr {\n    EForIn(_, _, _, _) => throw(\"unsupported expression in codegen: EForIn\"),\n    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)\n    ,\n    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)\n    ,\n    _ => throw(\"unsupported expression in codegen: unknown\")\n  }\n}\n\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  match expr {\n    EDot(obj, field) => {\n      let fc = String::char_code_at(field, 0)\n      let mut field_idx = if fc >= 48 && fc <= 57 {\n        let mut vi = 0\n        let mut vp = 0\n        while vp < String::length(field) {\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n          vp = vp + 1\n        }\n        vi\n      } else {\n        let mut si_search = 0\n        let mut found = -1\n        while si_search < Array::length(ctx.ctor_table.struct_names) {\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)\n          let mut fi = 0\n          while fi < Array::length(fnames) {\n            if Array::get(fnames, fi) == field {\n              found = fi\n              fi = Array::length(fnames)\n            } else {\n              fi = fi + 1\n            }\n          }\n          if found >= 0 {\n            si_search = Array::length(ctx.ctor_table.struct_names)\n          } else {\n            si_search = si_search + 1\n          }\n        }\n        if found < 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        found\n      }\n      let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n      if fc >= 48 && fc <= 57 {\n        if ctx.enable_rc {\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n        }\n        emit_i32_wrap_i64(buf)\n        let toff = if ctx.enable_rc {\n          8 + field_idx * 8\n        } else {\n          field_idx * 8\n        }\n        emit_i64_load(buf, 3, toff)\n      } else {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + field_idx * 8)\n      }\n      nl1\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      if ctx.enable_rc {\n        let total = 16 + flen * 8\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      } else {\n        let obj_size = 8 + flen * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      }\n    },\n    EMap(fields) => {\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 2 * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__map_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 0)\n      let mut nl_m = next_local + 1\n      let mut mi = 0\n      while mi < flen {\n        let (key, val_expr) = Array::get(fields, mi)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\n        if key_idx >= 0 {\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\n        let val_local = nl_m\n        Array::push(local_names, \"__map_val\")\n        emit_local_set(buf, val_local)\n        nl_m = nl_m + 1\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\n        mi = mi + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl_m\n    },\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail3: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 19 {\n    let cond = get_ewhile_cond(expr)\n    let body = get_ewhile_body(expr)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    let w_cond_tag = expr_tag(cond)\n    let nl1 = if w_cond_tag == 5 {\n      let wcop = get_ebinop_op(cond)\n      if wcop == \"==\" || wcop == \"!=\" || wcop == \"<\" || wcop == \">\" || wcop == \"<=\" || wcop == \">=\" {\n        let wlhs = get_ebinop_lhs(cond)\n        let wrhs = get_ebinop_rhs(cond)\n        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, ld + 1)\n        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, ld + 1)\n        if wcop == \"==\" {\n          let (eq_fi3, _, _) = resolve_func(ctx.func_table, \"eq\")\n          emit_call(buf, eq_fi3)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n        } else if wcop == \"!=\" {\n          let (eq_fi3, _, _) = resolve_func(ctx.func_table, \"eq\")\n          emit_call(buf, eq_fi3)\n          emit_i32_wrap_i64(buf)\n        }\n        else if wcop == \"<\" {\n          emit_i64_lt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \">\" {\n          emit_i64_gt_s(buf); emit_i32_eqz(buf)\n        }\n        else if wcop == \"<=\" {\n          emit_i64_le_s(buf); emit_i32_eqz(buf)\n        }\n        else {\n          emit_i64_ge_s(buf); emit_i32_eqz(buf)\n        }\n        wnl2\n      } else {\n        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)\n        emit_i64_eqz(buf)\n        wnl\n      }\n    } else {\n      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)\n      emit_i64_eqz(buf)\n      wnl\n    }\n    emit_br_if(buf, 1)\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, ld + 1)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_i64_const(buf, 0)\n    nl2\n  } else if __tag == 20 {\n    emit_br(buf, ld + 1)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 21 {\n    emit_br(buf, ld)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 22 {\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 23 {\n    let msg_expr = get_ethrow_expr(expr)\n    let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)\n    bytebuf_push(buf, 8)\n    bytebuf_push(buf, 0)\n    nl\n  } else if __tag == 24 {\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 26 {\n    let ret_expr = get_ereturn_expr(expr)\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\n    emit_return(buf)\n    nl\n  } else {\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\n\n\n\n\n\nexport let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      let total = 16 + num_elems * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, tri), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, 16 + tri * 8)\n        tri = tri + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let alloc_size = num_elems * 8\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    }\n  } else if __tag == 16 {\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n    let elems = get_earray_elems(expr)\n    let n_elems = Array::length(elems)\n    if ctx.enable_rc {\n      let cap = if n_elems > 8 {\n        n_elems\n      } else {\n        8\n      }\n      let total = 20 + cap * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__arr_ptr\")\n      let mut nl = next_local + 1\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 5)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, cap)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, n_elems)\n      emit_i32_store(buf, 2, 12)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 20)\n      emit_i32_add(buf)\n      emit_i32_store(buf, 2, 16)\n      let mut ai = 0\n      while ai < n_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(elems, ai), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, 20 + ai * 8)\n        ai = ai + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    }\n  } else if __tag == 18 {\n    let var_name = get_eforin_name(expr)\n    let iter_expr = get_eforin_iter(expr)\n    let body = get_eforin_body(expr)\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n    let result_local = next_local\n    let arr_local = next_local + 1\n    let i_local = next_local + 2\n    Array::push(local_names, \"__forin_res\")\n    Array::push(local_names, \"__forin_arr\")\n    Array::push(local_names, \"__forin_i\")\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, result_local)\n    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\n    emit_local_set(buf, arr_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, i_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, i_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, arr_len_fi)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    let var_local = nl1\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, i_local)\n    emit_call(buf, arr_get_fi)\n    emit_local_set(buf, var_local)\n    Array::push(local_names, var_name)\n    let nl2 = nl1 + 1\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, ld + 1)\n    let body_val = nl3\n    Array::push(local_names, \"__forin_val\")\n    emit_local_set(buf, body_val)\n    emit_local_get(buf, result_local)\n    emit_local_get(buf, body_val)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, i_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, i_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, result_local)\n    nl3 + 1\n  } else {\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\n\n\n\n\n\nlet emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\nlet emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n}\n\nlet emit_rc_dup_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n}\n\nlet emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nlet is_edot: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _) => true,\n    _ => false\n  }\n}\n\nlet rec proj_root_ident: (Expr) -> String = (e) -> {\n  match e {\n    EDot(obj, _) => proj_root_ident(obj),\n    EIdent(nm) => nm,\n    _ => \"\"\n  }\n}\n\nlet rec scope_tail_proj_root: (Expr) -> String = (e) -> {\n  match e {\n    ELet(_, _, b) => scope_tail_proj_root(b),\n    ELetMut(_, _, b) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _) => proj_root_ident(obj),\n    _ => \"\"\n  }\n}\n\nlet assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {\n  let empty1 = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty2 = Array::slice([\n    \"\"\n  ], 0, 0)\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nexport let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    let mut rc_kind = 0\n    if ctx.enable_rc {\n      if is_etuple(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_earray(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_erecord(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_ctor_call(value, ctx.ctor_table) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_eident(value) {\n        let src = get_eident_name(value)\n        if array_contains_str(ctx.heap_binding_names, src) {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n          if array_contains_str(ctx.rc_alias_dup_names, name) {\n            emit_rc_dup_local(buf, local_idx, true)\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      } else if expr_tag(value) == 8 {\n        let callee = get_ecall_callee(value)\n        let is_borrow_ret = if is_eident(callee) {\n          let cn = get_eident_name(callee)\n          cn == \"Array::get\" || cn == \"__index\"\n        } else {\n          false\n        }\n        if is_borrow_ret {\n          ()\n        } else {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        }\n      } else if is_edot(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        emit_rc_dup_guarded(buf, local_idx)\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        emit_rc_dup_guarded(buf, nl2)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_local_get(buf, nl2)\n        nl2 + 1\n      } else {\n        if ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else if rc_kind == 1 {\n          emit_rc_drop_local(buf, local_idx, false)\n        } else {\n          emit_rc_drop_local(buf, local_idx, true)\n        }\n        nl2\n      }\n    } else {\n      nl2\n    }\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n      let mut self_cap_idx = -1\n      let mut bci = 0\n      while bci < Array::length(caps) {\n        if Array::get(caps, bci) == name {\n          self_cap_idx = bci\n        }\n        bci = bci + 1\n      }\n      if self_cap_idx >= 0 {\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, -4)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, local_idx)\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n      }\n      0\n    } else {\n      0\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 11 {\n    let name = get_eletmut_name(expr)\n    let value = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    if is_mut_captured_in(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n    } else {\n      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table)) {\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name) && !assign_value_mentions(value, name) {\n        emit_local_get(buf, idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\n\n\n\n\n\nexport let rec compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\n  let rec expr_is_floatish: (Expr) -> Bool with { Error } = (e) -> {\n    let tag = expr_tag(e)\n    if tag == 2 {\n      true\n    } else if tag == 5 {\n      let op = get_ebinop_op(e)\n      if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n        expr_is_floatish(get_ebinop_lhs(e)) || expr_is_floatish(get_ebinop_rhs(e))\n      } else {\n        false\n      }\n    } else if tag == 6 {\n      let op = get_eunaryop_op(e)\n      if op == \"-\" {\n        expr_is_floatish(get_eunaryop_expr(e))\n      } else {\n        false\n      }\n    } else if tag == 8 {\n      let callee = get_ecall_callee(e)\n      if is_eident(callee) {\n        let fname = get_eident_name(callee)\n        fname == \"Int::to_double\" || fname == \"Double::from_i64_bits\"\n      } else {\n        false\n      }\n    } else {\n      false\n    }\n  }\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      if ctx.enable_rc { 2 } else { 1 }\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let bits = Double::to_i64_bits(v)\n    emit_f64_const_bits(buf, bits)\n    emit_i64_reinterpret_f64(buf)\n    next_local\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl_result = __tl_i\n        __tl_i = -1\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      let mut __ci_idx = -1\n      let __ci_len = Array::length(ctx.const_int_names)\n      let mut __ci_j = 0\n      while __ci_j < __ci_len {\n        if Array::get(ctx.const_int_names, __ci_j) == name {\n          __ci_idx = __ci_j\n          __ci_j = __ci_len\n        } else {\n          __ci_j = __ci_j + 1\n        }\n      }\n      if __ci_idx >= 0 {\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        next_local\n      } else {\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n        if ctor_idx >= 0 {\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n          let ptr_l = next_local\n          Array::push(local_names, \"__ctor_ptr\")\n          emit_global_get(buf, 0)\n          emit_i64_extend_i32_u(buf)\n          emit_local_set(buf, ptr_l)\n          emit_global_get(buf, 0)\n          emit_i32_const(buf, 8)\n          emit_i32_add(buf)\n          emit_global_set(buf, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, tag_c)\n          emit_i32_store(buf, 2, 0)\n          emit_local_get(buf, ptr_l)\n          emit_i32_wrap_i64(buf)\n          emit_i32_const(buf, 0)\n          emit_i32_store(buf, 2, 4)\n          emit_local_get(buf, ptr_l)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          next_local + 1\n        } else {\n          let fn_len = Array::length(ctx.func_table.names)\n          let mut __tf_j = 0\n          let mut __tf_result = -1\n          while __tf_j < fn_len {\n            if Array::get(ctx.func_table.names, __tf_j) == name {\n              __tf_result = __tf_j\n              __tf_j = fn_len\n            } else {\n              __tf_j = __tf_j + 1\n            }\n          }\n          if __tf_result < 0 {\n            let mut diag = String::concat(\"undefined variable (ident): \", name)\n            diag = String::concat(diag, \" | locals=[\")\n            let mut di = 0\n            while di < len {\n              if di > 0 {\n                diag = String::concat(diag, \",\")\n              }\n              diag = String::concat(diag, Array::get(local_names, di))\n              di = di + 1\n            }\n            diag = String::concat(diag, \"]\")\n            throw(diag)\n          }\n          let fni = __tf_result\n          let fidx = Array::get(ctx.func_table.indices, fni)\n          if array_contains_str(ctx.thunk_names, name) {\n            emit_i64_const(buf, 0)\n            emit_call(buf, fidx)\n            next_local\n          } else {\n            let table_slot = fidx - ctx.func_offset\n            emit_i64_const(buf, (table_slot<<2)|2)\n            next_local\n          }\n        }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    if op == \"==\" {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n      emit_call(buf, eq_fidx)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl2\n    } else if op == \"!=\" {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n      emit_call(buf, eq_fidx)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl2\n    } else if expr_is_floatish(lhs) || expr_is_floatish(rhs) {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      emit_f64_reinterpret_i64(buf)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_f64_reinterpret_i64(buf)\n      if op == \"+\" {\n        emit_f64_add(buf)\n        emit_i64_reinterpret_f64(buf)\n      } else if op == \"-\" {\n        emit_f64_sub(buf)\n        emit_i64_reinterpret_f64(buf)\n      } else if op == \"*\" {\n        emit_f64_mul(buf)\n        emit_i64_reinterpret_f64(buf)\n      } else if op == \"/\" {\n        emit_f64_div(buf)\n        emit_i64_reinterpret_f64(buf)\n      } else if op == \"<\" {\n        emit_f64_lt(buf)\n        emit_i64_extend_i32_s(buf)\n      } else if op == \">\" {\n        emit_f64_gt(buf)\n        emit_i64_extend_i32_s(buf)\n      } else if op == \"<=\" {\n        emit_f64_le(buf)\n        emit_i64_extend_i32_s(buf)\n      } else if op == \">=\" {\n        emit_f64_ge(buf)\n        emit_i64_extend_i32_s(buf)\n      } else {\n        throw(String::concat(\"unsupported float binop: \", op))\n      }\n      nl2\n    } else if ctx.enable_rc {\n      if op == \"<<\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shl(buf)\n        nl2\n      } else if op == \">>\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shr_s(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n        nl2\n      } else {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_binop_op(buf, op)\n        if op == \"*\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shr_s(buf)\n        } else if op == \"/\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else {\n          ()\n        }\n        nl2\n      }\n    } else {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n    }\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      if expr_is_floatish(operand) {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_f64_reinterpret_i64(buf)\n        emit_f64_neg(buf)\n        emit_i64_reinterpret_f64(buf)\n        nl\n      } else {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      }\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        if cop == \"==\" {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          let (eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n          emit_call(buf, eq_fi)\n          emit_i32_wrap_i64(buf)\n          cnl2\n        } else if cop == \"!=\" {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          let (eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n          emit_call(buf, eq_fi)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          cnl2\n        } else if expr_is_floatish(clhs) || expr_is_floatish(crhs) {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    } else if cond_tag == 6 {\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            if iop == \"==\" {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              let (eq_fi2, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_call(buf, eq_fi2)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if iop == \"!=\" {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              let (eq_fi2, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_call(buf, eq_fi2)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if expr_is_floatish(ilhs) || expr_is_floatish(irhs) {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              emit_f64_reinterpret_i64(buf)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              emit_f64_reinterpret_i64(buf)\n              if iop == \"<\" {\n                emit_f64_lt(buf)\n              }\n              else if iop == \">\" {\n                emit_f64_gt(buf)\n              }\n              else if iop == \"<=\" {\n                emit_f64_le(buf)\n              }\n              else {\n                emit_f64_ge(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            } else {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if iop == \"<\" {\n                emit_i64_lt_s(buf)\n              }\n              else if iop == \">\" {\n                emit_i64_gt_s(buf)\n              }\n              else if iop == \"<=\" {\n                emit_i64_le_s(buf)\n              }\n              else {\n                emit_i64_ge_s(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            }\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\nexport let compile_module_expr: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {\n  let fresh_int_array: () -> Array[Int] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_array: () -> Array[String] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_expr_array: () -> Array[Expr] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fn_names_list = fresh_string_array()\n  let fn_param_counts = fresh_int_array()\n  let export_names = fresh_string_array()\n  let export_indices = fresh_int_array()\n  let fn_bodies_list = fresh_expr_array()\n  let fn_param_names_list = fresh_string_matrix()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let cur_idx = Array::length(fn_names_list)\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_bodies_list, body)\n          let pnames = fresh_string_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pname, _) = Array::get(params, pi)\n            Array::push(pnames, pname)\n            pi = pi + 1\n          }\n          Array::push(fn_param_names_list, pnames)\n          if is_export {\n            Array::push(export_names, name)\n            Array::push(export_indices, cur_idx)\n          }\n          0\n        },\n        _ => 0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  let num_funcs = Array::length(fn_names_list)\n  if num_funcs == 0 {\n    let out = bytebuf_new()\n    let empty_type_defs = fresh_int_array()\n    let empty_type_indices = fresh_int_array()\n    let empty_body = bytebuf_new()\n    let empty_bodies = fresh_bytes_matrix()\n    Array::push(empty_bodies, empty_body)\n    let empty_local_counts = fresh_int_array()\n    Array::push(empty_local_counts, 0)\n    emit_header(out)\n    emit_type_section_multi(out, empty_type_defs)\n    emit_function_section(out, empty_type_indices)\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\n    bytebuf_to_bytes(out)\n  } else {\n    let fn_indices_list = fresh_int_array()\n    let fn_returns_list = fresh_int_array()\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\n    let mut fi = 0\n    while fi < num_funcs {\n      Array::push(fn_indices_list, fi)\n      Array::push(fn_returns_list, 1)\n      Array::push(fn_needs_env_list, false)\n      fi = fi + 1\n    }\n    let type_defs = fresh_int_array()\n    let mut ti = 0\n    while ti < num_funcs {\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\n      Array::push(type_defs, 1)\n      ti = ti + 1\n    }\n    let type_indices = fresh_int_array()\n    let mut tii = 0\n    while tii < num_funcs {\n      Array::push(type_indices, tii)\n      tii = tii + 1\n    }\n    let lt_m = LambdaTable::{\n      bodies: fresh_bytes_matrix(),\n      param_counts: fresh_int_array(),\n      captures: fresh_string_matrix(),\n      meta_i32: fresh_int_array(),\n      meta_i64: fresh_int_array()\n    }\n    let bodies = fresh_bytes_matrix()\n    let local_counts = fresh_int_array()\n    let mut bi = 0\n    while bi < num_funcs {\n      let body = Array::get(fn_bodies_list, bi)\n      let param_names = Array::get(fn_param_names_list, bi)\n      let body_buf = bytebuf_new()\n      let local_names = fresh_string_array()\n      let mut pi = 0\n      while pi < Array::length(param_names) {\n        Array::push(local_names, Array::get(param_names, pi))\n        pi = pi + 1\n      }\n      let param_count = Array::length(param_names)\n      let empty_strs = fresh_string_array()\n      let empty_offs = fresh_int_array()\n      let empty_lens = fresh_int_array()\n      let empty_ref_cells = fresh_string_array()\n      let empty_ctor_names = fresh_string_array()\n      let empty_ctor_tags = fresh_int_array()\n      let empty_ctor_field_counts = fresh_int_array()\n      let empty_ctor_type_names = fresh_string_array()\n      let empty_ctor_struct_names = fresh_string_array()\n      let empty_ctor_struct_field_names = fresh_string_matrix()\n      let empty_thunk_names = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list,\n          indices: fn_indices_list,\n          params: fn_param_counts,\n          returns: fn_returns_list,\n          needs_env: fn_needs_env_list\n        },\n        str_table: StrTable::{\n          strs: empty_strs, offsets: empty_offs, lengths: empty_lens\n        },\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: CtorTable::{\n          names: empty_ctor_names, tags: empty_ctor_tags, field_counts: empty_ctor_field_counts, type_names: empty_ctor_type_names, struct_names: empty_ctor_struct_names, struct_field_names: empty_ctor_struct_field_names\n        },\n        thunk_names: empty_thunk_names,\n        const_int_names: fresh_string_array(),\n        const_int_values: fresh_int_array(),\n        enable_rc: false,\n        rc_drop_names: fresh_string_array(),\n        rc_alias_dup_names: fresh_string_array(),\n        heap_binding_names: fresh_string_array(),\n        rc_drop_func_idx: -1,\n        rc_alloc_func_idx: -1,\n        rc_dup_names: fresh_string_array()\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n\n\n\n\nexport {\n  compile_expr, compile_module_expr\n}\n\n\n\n\n\n\nlet expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\n\n\n\n\n\n\n\n\n\n\nlet lc_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport let compile_wasi_module_linked_impl: (Array[Stmt], String, Array[(String, String)], Array[(String, String, Int, Int)], Bool, Bool) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, linked_imports, library_mode, enable_rc) -> {\n  let fn_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_param_counts = Array::slice([\n    0\n  ], 0, 0)\n  let fn_needs_env_list = Array::slice([\n    true\n  ], 0, 0)\n  let fn_stmt_indices = Array::slice([\n    0\n  ], 0, 0)\n  let thunk_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let const_int_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let const_int_values_list = Array::slice([\n    0\n  ], 0, 0)\n  let export_fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let export_fn_user_indices = Array::slice([\n    0\n  ], 0, 0)\n  let test_fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let empty_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (expr_tag(expr) == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let struct_field_names = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        Array::push(struct_names, sname)\n        let fnames = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = Array::slice([\n    0\n  ], 0, 0)\n  let str_lengths = Array::slice([\n    0\n  ], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::get\")\n  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\")\n  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\")\n  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\")\n  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\")\n  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\")\n  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\