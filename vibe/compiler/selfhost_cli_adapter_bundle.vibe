arams = misc_no_params()\n    Array::push(set_field_params, CtUnknown)\n    Array::push(set_field_params, CtString)\n    Array::push(set_field_params, CtUnknown)\n    Some(CtFn(set_field_params, CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_print: (String) -> Option[Type] = (name) -> {\n  if name == \"print\" {\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_throw: (String) -> Option[Type] = (name) -> {\n  if name == \"throw\" {\n    Some(CtFn(misc_one_param(CtString), CtUnknown, Some(\"Error\")))\n  }\n  else None\n}\n\nlet misc_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {\n  let arr = misc_no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nlet lookup_slice: (String) -> Option[Type] = (name) -> {\n  if name == \"__slice\" {\n    Some(CtFn(misc_three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_assert: (String) -> Option[Type] = (name) -> {\n  if name == \"assert\" {\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_true\" {\n    Some(CtFn(misc_one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_eq\" {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_println: (String) -> Option[Type] = (name) -> {\n  if name == \"println\" {\n    Some(CtFn(misc_one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_to_string: (String) -> Option[Type] = (name) -> {\n  if name == \"__to_string\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtString, None))\n  }\n  else None\n}\n\nlet lookup_len: (String) -> Option[Type] = (name) -> {\n  if name == \"__len\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_iter_intrinsic: (String) -> Option[Type] = (name) -> {\n  if name == \"iter_require\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtUnknown, None))\n  } else if name == \"iter_length\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  } else if name == \"iter_get\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else if name == \"String::iter_length\" {\n    Some(CtFn(misc_one_param(CtString), CtInt, None))\n  } else if name == \"String::iter_get\" {\n    Some(CtFn(misc_two_params(CtString, CtInt), CtInt, None))\n  } else if name == \"Map::iter_length\" {\n    Some(CtFn(misc_one_param(CtUnknown), CtInt, None))\n  } else if name == \"Map::iter_get\" {\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else {\n    None\n  }\n}\n\nlet lookup_char_to_int: (String) -> Option[Type] = (name) -> {\n  if name == \"Char::to_int\" {\n    Some(CtFn(misc_one_param(CtChar), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_arithmetic_helper(name) {\n    Some(t) => Some(t),\n    None => match lookup_eq(name) {\n      Some(t) => Some(t),\n      None => match lookup_not(name) {\n        Some(t) => Some(t),\n        None => match lookup_neg(name) {\n          Some(t) => Some(t),\n          None => match lookup_to_string(name) {\n            Some(t) => Some(t),\n            None => match lookup_len(name) {\n              Some(t) => Some(t),\n              None => lookup_index(name)\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nlet lookup_misc_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_slice(name) {\n    Some(t) => Some(t),\n    None => match lookup_print(name) {\n      Some(t) => Some(t),\n      None => match lookup_println(name) {\n        Some(t) => Some(t),\n        None => lookup_assert(name)\n      }\n    }\n  }\n}\n\nlet lookup_misc_group_e: (String) -> Option[Type] = (name) -> {\n  if name == \"String::join\" {\n    // (Array[String], String) -> String  (host builtin)\n    Some(CtFn(misc_two_params(CtArray(CtString), CtString), CtString, None))\n  } else if name == \"__rec_field\" {\n    // selfhost record-pattern desugar: __rec_field(record, index) -> field value.\n    // Lenient (field type unknown); only needs to resolve, not constrain.\n    Some(CtFn(misc_two_params(CtUnknown, CtInt), CtUnknown, None))\n  } else {\n    match lookup_iter_intrinsic(name) {\n      Some(t) => Some(t),\n      None => lookup_none(name)\n    }\n  }\n}\n\nlet lookup_char_from_int: (String) -> Option[Type] = (name) -> {\n  if name == \"Char::from_int\" {\n    Some(CtFn(misc_one_param(CtInt), CtChar, None))\n  }\n  else None\n}\n\nlet lookup_double_to_int: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::to_int\" {\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_int_to_double: (String) -> Option[Type] = (name) -> {\n  if name == \"Int::to_double\" {\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_double_to_i64_bits: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" {\n    Some(CtFn(misc_one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_c: (String) -> Option[Type] = (name) -> {\n  match lookup_throw(name) {\n    Some(t) => Some(t),\n    None => match lookup_int_to_double(name) {\n      Some(t) => Some(t),\n      None => match lookup_double_to_int(name) {\n        Some(t) => Some(t),\n        None => lookup_double_to_i64_bits(name)\n      }\n    }\n  }\n}\n\nlet lookup_double_from_i64_bits: (String) -> Option[Type] = (name) -> {\n  if name == \"Double::from_i64_bits\" {\n    Some(CtFn(misc_one_param(CtInt), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_d: (String) -> Option[Type] = (name) -> {\n  match lookup_double_from_i64_bits(name) {\n    Some(t) => Some(t),\n    None => match lookup_char_to_int(name) {\n      Some(t) => Some(t),\n      None => match lookup_char_from_int(name) {\n        Some(t) => Some(t),\n        None => lookup_some(name)\n      }\n    }\n  }\n}\n\nexport let lookup_misc: (String) -> Option[Type] = (name) -> {\n  match lookup_misc_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_misc_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_misc_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_misc_group_d(name) {\n          Some(t) => Some(t),\n          None => lookup_misc_group_e(name)\n        }\n      }\n    }\n  }\n}\n")
