   // permanent).\n    if rc_shadow {\n      emit_local_get(b, 5)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_load8_u(b, 0, 0)\n      emit_if_void(b)\n      bytebuf_push(b, 0)\n      emit_end(b)\n    } else {\n      ()\n    }\n    // #715 recurrence guard (VIBE_RC=shadow): mark the old grown buffer freed.\n    if rc_shadow {\n      emit_local_get(b, 5)\n      emit_i32_const(b, rc_shadow_base())\n      emit_i32_add(b)\n      emit_i32_const(b, 1)\n      emit_i32_store8(b, 0, 0)\n    } else {\n      ()\n    }\n    emit_local_get(b, 5)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_global_get(b, 2)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 5)\n    emit_global_set(b, 2)\n    emit_end(b)\n    // capacity = newcap; data_ptr = block_start+8; local5 = block_start+8\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 5)\n  } else {\n    // non-RC: raw-bump a headerless buffer (never freed — the default path does\n    // not reclaim).\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 6)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 6)\n    emit_local_set(b, 5)\n  }\n  emit_end(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  emit_i64_store(b, 3, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n")
