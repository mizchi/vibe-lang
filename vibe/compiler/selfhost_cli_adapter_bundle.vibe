let cli_adapter_source_43 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/code_helpers.vibe",
"//# Imports\n\nimport .. / .. / core {\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_opcode_s64, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\n//# Functions\n\nexport let emit_end: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, 11)\n}\n\nexport let emit_i32_const: (Bytes, Int) -> Unit = (buf, value) -> {\n  bytebuf_push_opcode_s64(buf, 65, value)\n}\n\nexport let emit_code_section: (Bytes, Array[Bytes]) -> Unit = (out, bodies) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\nexport let emit_memory_section: (Bytes, Int) -> Unit = (out, min_pages) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\nexport let emit_code_section_with_locals: (Bytes, Array[Bytes], Array[Int]) -> Unit = (out, bodies, local_counts) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)\n    } else {\n      leb128_encode_u32(func_buf, 1)\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n")
}

let cli_adapter_source_44 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/extra.vibe",
"//# Imports\n\nimport .. / .. / core {\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push_buf, bytebuf_push_opcode_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport ./base.vibe {\n  emit_end, emit_i32_const, emit_name\n}\n\n//# Functions\n\nlet vt_i32 = 127\n\nlet sec_data = 11\n\nlet type_func = 96\n\nlet sec_export = 7\n\nlet sec_global = 6\n\nlet sec_import = 2\n\nlet export_func = 0\n\nlet export_memory = 2\n\nlet op_global_get = 35\n\nlet op_global_set = 36\n\nlet op_i32_add = 106\n\nlet op_i32_sub = 107\n\nlet op_i32_shr_u = 118\n\nlet op_i32_gt_u = 75\n\nlet op_memory_size = 63\n\nlet op_memory_grow = 64\n\nlet op_drop = 26\n\nlet op_if = 4\n\nlet bt_void = 64\n\nexport let emit_global_get: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\n}\n\nexport let emit_heap_memory_grow_check: (Bytes) -> Unit = (buf) -> {\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65535)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_gt_u)\n  bytebuf_push2(buf, op_if, bt_void)\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65535)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_sub)\n  bytebuf_push2(buf, op_memory_grow, 0)\n  bytebuf_push(buf, op_drop)\n  emit_end(buf)\n}\n\nexport let emit_global_set: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\n}\n\nexport let emit_data_section: (Bytes, Int, Bytes) -> Unit = (out, offset, data) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, offset)\n  emit_end(content)\n  leb128_encode_u32(content, Bytes::length(data))\n  bytebuf_push_buf(content, data)\n  bytebuf_push_section(out, sec_data, content)\n}\n\nexport let emit_exports_full: (Bytes, Array[String], Array[Int], String, Int, Array[String], Array[Int]) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx, global_names, global_indices) -> {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport let emit_export_memory: (Bytes, String, Int) -> Unit = (out, name, mem_idx) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport let emit_func_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, param_types, result_types) -> {\n  bytebuf_push(buf, type_func)\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\nexport let emit_exports_with_memory: (Bytes, Array[String], Array[Int], String, Int) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx) -> {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport let emit_import_section_func: (Bytes, String, String, Int) -> Unit = (out, module_name, field_name, type_idx) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, export_func)\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, sec_import, content)\n}\n\nexport let emit_global_section_i32_mut: (Bytes, Int) -> Unit = (out, init_value) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, vt_i32, 1)\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, sec_global, content)\n}\n")
}

let cli_adapter_source_45 = () -> (String, String) {
