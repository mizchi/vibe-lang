let cli_adapter_source_80 = () -> (String, String) {
  ("vibe/compiler/codegen/wasi/linked_helpers.vibe",
"//# Imports\n\nimport .. / .. / builtin_name.vibe {\n  canonical_builtin_name\n}\n\nimport .. / .. / core {\n  Expr, Stmt\n}\n\nimport .. / common_analysis {\n  collect_free_vars\n}\n\nimport .. / common_extractors {\n  array_contains_str\n}\n\n//# Functions\n\nlet expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n")
}

let cli_adapter_source_81 = () -> (String, String) {
  ("vibe/compiler/codegen/wasi/linked_compile.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / .. / desugar_trait_dict.vibe {\n  desugar_trait_dicts\n}\n\nimport .. / .. / normalize {\n  lift_match_scrutinees, uniquify_shadowed_bindings\n}\n\nimport .. / .. / syntax / import_alias_rewrite.vibe {\n  rewrite_top_level_fn_alias_refs\n}\n\nimport .. / .. / perceus {\n  PerceusAction, build_perceus_plan, build_perceus_plan_with_params, compute_borrow_returning_names, compute_scalar_returning_names, elaborate_heap_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\n}\n\nimport .. / builtin_bodies {\n  gen_arr_concat_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_push_all_body, gen_arr_push_body, gen_arr_set_body, gen_arr_slice_body, gen_arr_truncate_body, gen_bytes_append_body, gen_bytes_concat_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_len_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_rc_alloc_body, gen_rc_drop_body, gen_selfhost_sources_proper_body, gen_selfhost_sources_stub_body, gen_simd_scan_alnum_body, gen_simd_skip_ws_body, gen_str_char_code_at_body, gen_str_concat_body, gen_str_eq_body, gen_str_lex_diff_body, gen_str_from_char_code_body, gen_str_len_body, gen_str_substring_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body, static_arr_get_body, static_arr_len_body, static_arr_set_body, static_arr_truncate_body, static_double_to_int_body, static_fs_stub_body, static_fs_write_bytes_stub_body, static_identity_body, static_int_to_double_body, static_print_i64_body, static_print_str_body, static_str_char_code_at_body, static_str_eq_body, static_str_len_body\n}\n\nimport .. / builtin_registry.vibe {\n  verify_lane_builtins\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root, stmts_contain_exceptions\n}\n\nimport .. / common_base {\n  rc_shadow_reserve,\n  CompileCtx, CovState, CtorTable, DbgProv, FuncTable, LambdaTable, StrTable, agg_info_of_type_expr, compute_agg_returning, emit_rc_dup_guarded, empty_dbg_prov, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, fn_type_param_types, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, get_slet_type, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, build_newline_offsets, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / expr {\n  compile_expr\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i64_store, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, emit_vibe_abi_custom_section, emit_function_name_section, string_to_data\n}\n\nimport ./linked_helpers.vibe {\n  stmts_use_builtin\n}\n\n//# Functions\n\nlet wasm_page_size = 65536\n\nlet lc_fresh_int_array: () -> Array[Int] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_bool_array: () -> Array[Bool] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_bytes_array: () -> Array[Bytes] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_string_array: () -> Array[String] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\n\nlet lc_fresh_string_matrix: () -> Array[Array[String]] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet gen_heap_grow_check_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport let wasi_memory_min_pages_for_heap: (Int) -> Int = (heap_start) -> {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\nexport let compile_wasi_module_linked_impl: (Array[Stmt], String, Array[(String, String)], Array[(String, String, Int, Int)], Bool, Bool, Bool, Bool, Bool, Bool, DbgProv) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, linked_imports, library_mode, enable_rc, coverage, debug_trace, debug_break, rc_shadow, prov) -> {\n  // Method-bearing-trait dictionary passing (#641 PR-3). Universal codegen\n  // convergence point — runs here on the fully merged program before generic\n  // type params are stripped (just below). No-op unless a method-bearing trait\n  // is declared, and idempotent if an earlier pipeline stage already desugared.\n  desugar_trait_dicts(stmts)\n  // Top-level `let f = g` function aliases: retarget references to the final\n  // EFn def so calls do not route through the 0-param thunk registration\n  // below (invalid wasm for any call arity). See import_alias_rewrite.vibe.\n  rewrite_top_level_fn_alias_refs(stmts)\n  // #707: functions whose entire body is transitively a tail-call to a\n  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin\n  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the\n  // whole merged program and threaded into every function's Perceus plan so a\n  // `let v = peek(...)` binding (including the match-scrutinee-lift's\n  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the\n  // same as a direct `let v = Array::get(...)` one.\n  let lc_borrow_ret_names = compute_borrow_returning_names(stmts)\n  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/index.vibe).\n  let lc_scalar_ret_names = compute_scalar_returning_names(stmts)\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let empty_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and\n      // computed here, unconditionally -- so it (like `is_efn(expr)` above)\n      // contributes to `expr`'s always-consumed prefix instead of only being\n      // paid for on the `else` path. This alone still leaves the `else`\n      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the\n      // thunk fallback's 0), so the thunk fallback below also aliases `expr`\n      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries\n      // resolved, `then` and `else` each consume `expr` the same number of\n      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining\n      // count regardless of which branch a given statement actually takes --\n      // previously the merge could permanently assume more consumption than\n      // a commonly-taken branch (int-constant or thunk statements, which are\n      // NOT rare like a false `is_efn` check on a real function body) really\n      // performed, skipping the loop-body scope-end drop and leaking `expr`\n      // (a heap Expr node) on every such statement.\n      let __sf_etag = expr_tag(expr)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (__sf_etag == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          let __sf_thunk_expr = expr\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = lc_fresh_string_array()\n  let struct_field_names = lc_fresh_string_matrix()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = lc_fresh_string_array()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  // #724 round 2: (fn name -> declared aggregate return shape) table so\n  // `let a = f(..)` bindings participate in structural `==` (see\n  // compute_agg_returning in common_base).\n  let lc_agg_ret_names = lc_fresh_string_array()\n  let lc_agg_ret_infos = lc_fresh_int_array()\n  compute_agg_returning(stmts, CtorTable::{\n    names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\n  }, lc_agg_ret_names, lc_agg_ret_infos)\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args, _) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  // Always seed the empty string so codegen that materialises \"\" (e.g.\n  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)\n  // can rely on str_table_lookup(\"\") succeeding even when the source never\n  // mentions \"\" literally.\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = lc_fresh_int_array()\n  let str_lengths = lc_fresh_int_array()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let effect_names_list = lc_fresh_string_array()\n  let effect_op_keys_list = lc_fresh_string_array()\n  let effect_op_arities_list = Array::slice([\n    0\n  ], 0, 0)\n  let mut eff_collect_i = 0\n  while eff_collect_i < Array::length(stmts) {\n    match Array::get(stmts, eff_collect_i) {\n      SEffectDef(_, eff_name, _, ops) => {\n        if eff_name != \"Error\" && !array_contains_str(effect_names_list, eff_name) {\n          Array::push(effect_names_list, eff_name)\n        } else {\n          ()\n        }\n        let mut op_i = 0\n        while op_i < Array::length(ops) {\n          let (op_name, op_params, _) = Array::get(ops, op_i)\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \"::\"), op_name))\n          Array::push(effect_op_arities_list, Array::length(op_params))\n          op_i = op_i + 1\n        }\n      },\n      _ => ()\n    }\n    eff_collect_i = eff_collect_i + 1\n  }\n  // Per-effect region stride (#553). Each effect tag gets a reserved region\n  // below the heap frontier holding the replay-handler control words (+0\n  // perform counter, +8 resume-memo count) and the resume-memo array (+16 +\n  // k*8). The replay model stores one i64 per `perform` resolved within a\n  // `handle`, so the region is O(performs). At 8192 B (1022 entries) a loop\n  // performing more than ~1022-2046 times overflowed the region into the live\n  // heap, where the growing memo chased and clobbered the reused payload-tuple\n  // free block (~8 B/iter past the threshold, ADR-0055). 131072 B (16382\n  // entries) covers the full verify regime (N2=11000) with headroom; programs\n  // performing more than ~16K times within one handle still spill (a hard\n  // bound of the replay-based handler — unbounded performs need a\n  // continuation-based handler). MUST stay in sync with the `* 131072` strides\n  // in compile_call.vibe (perform) and compile_expr_tail6.vibe (handler arm).\n  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072\n  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function\n  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW\n  // the heap frontier, so it never collides with effect words or the live heap.\n  // `cov_base` is a compile-time-constant address baked into each function's\n  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is\n  // byte-identical to the normal build (the self-host fixpoint is unaffected).\n  let cov_count = num_user_funcs\n  let cov_base = heap_start + eff_reserve\n  let cov_reserve = if coverage {\n    ((cov_count + 7) / 8) * 8\n  } else {\n    0\n  }\n  // #cov branch coverage: a second 1-byte-per-branch hit region directly above\n  // the function-hit region. Branch ids are assigned sequentially during codegen\n  // (CovState.next), so the count is not known up front — reserve a fixed cap.\n  // 65536 branches is generous headroom (the whole compiler has a few thousand).\n  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.\n  let cov_branch_cap = 65536\n  let cov_branch_base = cov_base + cov_reserve\n  let cov_branch_reserve = if coverage {\n    cov_branch_cap\n  } else {\n    0\n  }\n  // Function-call execution trace (debugger / DAP P1 groundwork, gated by\n  // `debug_trace`). A dedicated region directly above the coverage regions and\n  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap\n  // log of i32 slots. Each user function's entry, in debug mode, appends its\n  // own user index to the log (counter-bounded). A `vibe.trace` custom section\n  // records the layout + function names so the runner can dump the entry\n  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical\n  // to a normal build (the self-host fixpoint is unaffected).\n  let trace_cap = 4096\n  let trace_counter_addr = cov_branch_base + cov_branch_reserve\n  let trace_log_base = trace_counter_addr + 4\n  let trace_reserve = if debug_trace {\n    4 + trace_cap * 4\n  } else {\n    0\n  }\n  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated\n  // region directly above the trace region holds a 4-byte count cell followed by\n  // a fixed-cap array of i64 slots. At each user function entry, in break mode,\n  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and\n  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The\n  // hook reads them out of guest memory and prints `args: [...]`. A\n  // `vibe.dbgargs` custom section publishes the two addresses to the runner.\n  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a\n  // normal build (the self-host fixpoint is unaffected).\n  let dbgargs_cap = 16\n  let dbgargs_count_addr = trace_counter_addr + trace_reserve\n  let dbgargs_base = dbgargs_count_addr + 8\n  let dbgargs_reserve = if debug_break {\n    8 + dbgargs_cap * 8\n  } else {\n    0\n  }\n  let cov_state = CovState::{\n    enabled: coverage,\n    base: cov_branch_base,\n    cap: cov_branch_cap,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::get\")\n  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\")\n  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\")\n  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\")\n  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\")\n  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\")\n  let need_fs_write_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_file\")\n  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\")\n  // #632: `Fs::read_bytes(path) -> Bytes` — the binary-exact read counterpart of\n  // Fs::write_bytes, a `vibe.fs_read_bytes (i64) -> i64` host import (type 3,\n  // same shape as fs_read_file). Gated on use so non-users reserve no import\n  // (fixpoint-safe). Lets the persistent artifact cache store/load wasm raw.\n  let need_fs_read_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::read_bytes\")\n  // #729/#730: `Fs::readdir(path) -> Array[String]` — a `vibe.fs_read_dir\n  // (i64) -> i64` host import (type 3, same packed-string shape as\n  // fs_read_file: the host returns the byte-sorted entry NAMES \"\\n\"-joined as\n  // ONE string, no host-side array building). compile_call lowers the\n  // Array[String] surface to `String::split` over that string. Gated on use\n  // (fixpoint-safe). Unblocks contract-package sibling auto-discovery and the\n  // global store walk.\n  let need_fs_readdir_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::readdir\")\n  let need_profiler_now_us_builtin = stmts_use_builtin(stmts, fn_names_list, \"Profiler::now_us\")\n  // `sleep(ms)` (Async): a `vibe.sleep (i64) -> ()` host import. The host\n  // implements it as an async function so the guest fiber genuinely\n  // suspends/resumes (docs/spec/wasi-p3-async.md §2.3, examples/async_host).\n  // Gated on use, so programs without `sleep` reserve no import (fixpoint-safe).\n  let need_sleep_builtin = stmts_use_builtin(stmts, fn_names_list, \"sleep\")\n  // `Stdin::read_char() -> Int`: a value-returning `vibe.stdin_read_char () ->\n  // i64` host import. Implemented async by the host (it can suspend the guest\n  // until a char is available), so this is the data-consuming analog of `sleep`\n  // — the shape of a host async source (HTTP body byte, stdin char). Gated on\n  // use (fixpoint-safe).\n  let need_stdin_read_char_builtin = stmts_use_builtin(stmts, fn_names_list, \"Stdin::read_char\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_file_import_idx = if need_fs_write_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #632: reserved immediately after fs_write_bytes; the import emission below\n  // must stay in this same order so the index matches the descriptor.\n  let fs_read_bytes_import_idx = if need_fs_read_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // #729/#730: reserved immediately after fs_read_bytes; the import emission\n  // below must stay in this same order so the index matches the descriptor.\n  let fs_read_dir_import_idx = if need_fs_readdir_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let sleep_import_idx = if need_sleep_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let stdin_read_char_import_idx = if need_stdin_read_char_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // debugger breakpoint (DAP P1): in break mode emit a conditional `vibe::dbg_break`\n  // host import (() -> ()) called at each user-function entry. Default OFF, so\n  // num_imported_funcs / func_offset are unchanged for normal builds (fixpoint).\n  let dbg_break_import_idx = if debug_break {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  // Interior-line breakpoints (span-arc step5): in break mode with per-file\n  // provenance, reserve a `vibe::dbg_line (i32 file_id, i32 line) -> ()` host\n  // import called at each statement boundary. Each function's line is mapped\n  // against ITS OWN source file (prov.file_nls[file_id]) so multi-file entries\n  // work. Gated on `debug_break && prov has files`, so default builds reserve\n  // nothing and stay byte-identical.\n  let dbg_line_on = debug_break && Array::length(prov.files) > 0\n  let dbg_line_import_idx = if dbg_line_on {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let linked_import_indices = lc_fresh_int_array()\n  let linked_import_names = lc_fresh_string_array()\n  let mut li_i = 0\n  while li_i < Array::length(linked_imports) {\n    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)\n    Array::push(linked_import_indices, next_import_idx)\n    Array::push(linked_import_names, lfn_name)\n    next_import_idx = next_import_idx + 1\n    li_i = li_i + 1\n  }\n  let num_imported_funcs = next_import_idx\n  let print_int_idx = num_imported_funcs\n  let print_str_idx = print_int_idx + 1\n  let str_len_idx = print_str_idx + 1\n  let str_eq_idx = str_len_idx + 1\n  let str_concat_idx = str_eq_idx + 1\n  let arr_new_idx = str_concat_idx + 1\n  let arr_len_idx = arr_new_idx + 1\n  let arr_get_idx = arr_len_idx + 1\n  let arr_push_idx = arr_get_idx + 1\n  let arr_set_idx = arr_push_idx + 1\n  let double_to_int_idx = arr_set_idx + 1\n  let int_to_double_idx = double_to_int_idx + 1\n  let str_char_code_at_idx = int_to_double_idx + 1\n  let str_from_char_code_idx = str_char_code_at_idx + 1\n  let str_substring_idx = str_from_char_code_idx + 1\n  let identity_idx = str_substring_idx + 1\n  let arr_slice_idx = identity_idx + 1\n  let arr_concat_idx = arr_slice_idx + 1\n  let arr_truncate_idx = arr_concat_idx + 1\n  let string_join_idx = arr_truncate_idx + 1\n  let fs_read_file_stub_idx = string_join_idx + 1\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\n  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1\n  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1\n  let eq_idx = fs_write_bytes_stub_idx + 1\n  let string_ends_with_idx = eq_idx + 1\n  let string_last_index_of_idx = string_ends_with_idx + 1\n  let arr_push_all_idx = string_last_index_of_idx + 1\n  let string_index_of_idx = arr_push_all_idx + 1\n  let string_contains_idx = string_index_of_idx + 1\n  let string_starts_with_idx = string_contains_idx + 1\n  let string_split_idx = string_starts_with_idx + 1\n  let string_trim_idx = string_split_idx + 1\n  let selfhost_sources_idx = string_trim_idx + 1\n  let bytes_new_idx = selfhost_sources_idx + 1\n  let bytes_len_idx = bytes_new_idx + 1\n  let bytes_get_idx = bytes_len_idx + 1\n  let bytes_set_idx = bytes_get_idx + 1\n  let bytes_push_idx = bytes_set_idx + 1\n  let bytes_append_idx = bytes_push_idx + 1\n  let bytes_concat_idx = bytes_append_idx + 1\n  let bytes_slice_idx = bytes_concat_idx + 1\n  let bytes_from_array_idx = bytes_slice_idx + 1\n  let bytes_to_array_idx = bytes_from_array_idx + 1\n  let rc_drop_idx = bytes_to_array_idx + 1\n  let rc_alloc_idx = rc_drop_idx + 1\n  let heap_grow_check_idx = if enable_rc {\n    rc_alloc_idx + 1\n  } else {\n    bytes_to_array_idx + 1\n  }\n  let simd_skip_ws_idx = heap_grow_check_idx + 1\n  let simd_scan_alnum_idx = simd_skip_ws_idx + 1\n  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1\n  let str_lex_diff_idx = simd_scan_alnum_str_idx + 1\n  let env_get_idx = if env_get_import_idx >= 0 {\n    env_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let env_args_len_idx = if env_args_len_import_idx >= 0 {\n    env_args_len_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let env_args_get_idx = if env_args_get_import_idx >= 0 {\n    env_args_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {\n    fs_read_file_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_exists_idx = if fs_exists_import_idx >= 0 {\n    fs_exists_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {\n    fs_stat_token_import_idx\n  } else {\n    fs_stat_token_stub_idx\n  }\n  let fs_write_file_idx = if fs_write_file_import_idx >= 0 {\n    fs_write_file_import_idx\n  } else {\n    fs_write_file_stub_idx\n  }\n  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 {\n    fs_write_bytes_import_idx\n  } else {\n    fs_write_bytes_stub_idx\n  }\n  // #632: no dedicated stub — when read_bytes is unused the builtin index just\n  // needs SOME valid never-called slot, so reuse the fs_read_file stub (a\n  // `(i64)->i64` placeholder). The real call site only exists when the import is\n  // reserved.\n  let fs_read_bytes_idx = if fs_read_bytes_import_idx >= 0 {\n    fs_read_bytes_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  // #729/#730: like read_bytes, no dedicated stub — unused readdir reuses the\n  // fs_read_file stub (a `(i64)->i64` never-called placeholder).\n  let fs_read_dir_idx = if fs_read_dir_import_idx >= 0 {\n    fs_read_dir_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let profiler_now_us_idx = if profiler_now_us_import_idx >= 0 {\n    profiler_now_us_import_idx\n  } else {\n    env_args_len_idx\n  }\n  // `sleep` call target: the import when reserved, else a never-called stub\n  // (the builtin is only emitted as a call when the program uses `sleep`, which\n  // is exactly when the import is reserved).\n  let sleep_idx = if sleep_import_idx >= 0 {\n    sleep_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let stdin_read_char_idx = if stdin_read_char_import_idx >= 0 {\n    stdin_read_char_import_idx\n  } else {\n    env_args_len_idx\n  }\n  let max_builtin_func_idx = str_lex_diff_idx\n  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1\n  let func_offset = num_imported_funcs + num_generated\n  let fn_indices_list = lc_fresh_int_array()\n  let fn_returns_list = lc_fresh_int_array()\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let builtin_names_list = lc_fresh_string_array()\n  let builtin_param_counts = lc_fresh_int_array()\n  let builtin_needs_env_list = lc_fresh_bool_array()\n  let builtin_indices_list = lc_fresh_int_array()\n  let builtin_returns_list = lc_fresh_int_array()\n  Array::push(builtin_names_list, \"Env::get\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, env_get_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Env::args_len\")\n  Array::push(builtin_param_counts, 0)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, env_args_len_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Env::args_get\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, env_args_get_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Fs::read_file\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_read_file_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Fs::exists\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_exists_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Fs::stat_token\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_stat_token_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Fs::write_file\")\n  Array::push(builtin_param_counts, 2)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_write_file_idx)\n  Array::push(builtin_returns_list, 0)\n  Array::push(builtin_names_list, \"Fs::write_bytes\")\n  Array::push(builtin_param_counts, 2)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_write_bytes_idx)\n  Array::push(builtin_returns_list, 0)\n  Array::push(builtin_names_list, \"Fs::read_bytes\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_read_bytes_idx)\n  Array::push(builtin_returns_list, 1)\n  // #729/#730: the RAW half of Fs::readdir — the direct host-import call\n  // returning the \"\\n\"-joined names string. User code writes Fs::readdir\n  // (Array[String]); compile_call's lowering is the only caller of this name.\n  Array::push(builtin_names_list, \"__fs_read_dir_raw\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, fs_read_dir_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Profiler::now_us\")\n  Array::push(builtin_param_counts, 0)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, profiler_now_us_idx)\n  Array::push(builtin_returns_list, 1)\n  Array::push(builtin_names_list, \"Profiler::NowUs\")\n  Array::push(builtin_param_counts, 0)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, profiler_now_us_idx)\n  Array::push(builtin_returns_list, 1)\n  // `sleep(ms) -> Unit`: 1 i64 arg, void return (like `Fs::write_file`); the\n  // host import suspends the guest (real async).\n  Array::push(builtin_names_list, \"sleep\")\n  Array::push(builtin_param_counts, 1)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, sleep_idx)\n  Array::push(builtin_returns_list, 0)\n  // `Stdin::read_char() -> Int`: 0 args, i64 return (like `Profiler::now_us`);\n  // the host