it_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail3.vibe {\n  compile_expr_tail3\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      // RC layout (docs/spec/selfhost-rc-port.md):\n      //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n      // The tuple value is block_start+8 (points at type_id), so the live header\n      // is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0][length@ptr+4] and the\n      // payload stays at ptr+8 (field access is unchanged). ptr_local holds\n      // block_start. type_id 3 = tuple.\n      let total = 16 + num_elems * 8\n      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc) —\n      // exact-fit reuse anywhere in the list, else bump. Replaces the inline\n      // head-only check, which fragmented when interleaved sizes were freed.\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header words at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: uniform drop-class byte in the rc_count word's high\n      // byte (block+7 = value-1). rc stays in the low 24 bits, so dec (full-word\n      // -1) and the `*256 == 0` zero-test ignore this byte. 1 = field-vector\n      // ([?@value+0][count@value+4][fields@value+8+i*8]) — the generic recursive\n      // rc_drop loops `count` fields. (docs/spec/selfhost-uniform-value-repr.md)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, tri), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, 16 + tri * 8)\n        tri = tri + 1\n      }\n      // tuple value = (block_start + 8) | 1 (ADR-0055 Stage 2: all heap pointers\n      // are odd so a generic recursive rc_drop can classify fields by `& 1`).\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let alloc_size = num_elems * 8\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    }\n  } else if __tag == 16 {\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n    let elems = get_earray_elems(expr)\n    let n_elems = Array::length(elems)\n    if ctx.enable_rc {\n      // RC array literal: inline-allocate the array object with the tuple-style\n      // RC layout so it drops like a tuple (value = block+8, untagged). Object\n      // layout at the value pointer matches the array runtime\n      // (`[capacity@0][length@4][data_ptr@8][inline_data@12...]`); data_ptr points\n      // at the inline buffer (value+12). capacity defaults to 8 (as array_new)\n      // but is sized up for larger literals so all elements fit inline.\n      // The header behind is [alloc_size@-8][rc_count@-4]; the array runtime\n      // (Array::get / length / push) reads value+0/+4/+8, unchanged.\n      // (docs/spec/selfhost-rc-port.md)\n      let cap = if n_elems > 8 {\n        n_elems\n      } else {\n        8\n      }\n      let total = 20 + cap * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__arr_ptr\")\n      let mut nl = next_local + 1\n      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: drop-class byte (block+7). 5 = array — value+0 is\n      // capacity (not a count) and elements live behind data_ptr@value+8, so the\n      // recursive rc_drop must use the array path, not the field-vector loop.\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 5)\n      emit_i32_store8(buf, 0, 7)\n      // array object at block_start+8 = value: capacity, length, data_ptr\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, cap)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, n_elems)\n      emit_i32_store(buf, 2, 12)\n      // data_ptr = value + 12 = block_start + 20 (inline buffer)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 20)\n      emit_i32_add(buf)\n      emit_i32_store(buf, 2, 16)\n      // store elements at block_start + 20 + i*8\n      let mut ai = 0\n      while ai < n_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(elems, ai), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, 20 + ai * 8)\n        ai = ai + 1\n      }\n      // array value = (block_start + 8) | 1 (ADR-0055 Stage 2b: odd heap pointer)\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    }\n  } else if __tag == 18 {\n    let var_name = get_eforin_name(expr)\n    let iter_expr = get_eforin_iter(expr)\n    let body = get_eforin_body(expr)\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n    let result_local = next_local\n    let arr_local = next_local + 1\n    let i_local = next_local + 2\n    Array::push(local_names, \"__forin_res\")\n    Array::push(local_names, \"__forin_arr\")\n    Array::push(local_names, \"__forin_i\")\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, result_local)\n    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\n    emit_local_set(buf, arr_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, i_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, i_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, arr_len_fi)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    let var_local = nl1\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, i_local)\n    emit_call(buf, arr_get_fi)\n    emit_local_set(buf, var_local)\n    Array::push(local_names, var_name)\n    let nl2 = nl1 + 1\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, ld + 1)\n    let body_val = nl3\n    Array::push(local_names, \"__forin_val\")\n    emit_local_set(buf, body_val)\n    emit_local_get(buf, result_local)\n    emit_local_get(buf, body_val)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, i_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, i_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, result_local)\n    nl3 + 1\n  } else {\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

