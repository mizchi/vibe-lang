"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr\n}\n\nimport ./preprocess_interp_string.vibe {\n  rewrite_interp_string\n}\n\n//# Functions\n\nexport let rec rewrite_interp: (Expr) -> Expr with { Error } = (e) -> {\n  match e {\n    EStringInterp(parts) => rewrite_interp_string(parts),\n    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\n    ECall(callee, args) => ECall(rewrite_interp(callee), for arg in args {\n      rewrite_interp(arg)\n    }),\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n")
}

let cli_adapter_source_98 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_compile.vibe",
"//# Imports\n\nimport .. / .. / .. / checker / checker_stmt.vibe {\n  check_program\n}\n\nimport .. / .. / .. / codegen / wasi {\n  compile_wasi_module_impl, compile_wasi_module_rc_impl\n}\n\nimport .. / .. / .. / syntax / lexer.vibe {\n  lex\n}\n\nimport .. / .. / .. / syntax / parser.vibe {\n  parse_program\n}\n\nimport ./preprocess_interp.vibe {\n  expand_interp_stmts\n}\n\nimport ./preprocess_strip.vibe {\n  strip_generic_type_params\n}\n\nimport .. / .. / .. / core / ast.vibe {\n  Stmt, TypeExpr\n}\n\nimport .. / .. / .. / component_codegen.vibe {\n  comp_emit_component_wasm_async_trampolined_p1\n}\n\n//# Functions\n\n// M1b-2c (docs/spec/wasi-p3-async.md): does the entry declare\n// `() -> Int with { Async }` (no params)? If so its compiled core wasm should be\n// wrapped into an async-lifted WASM component. Detected from the declared TyFn\n// effect annotation (before generic-param stripping).\nlet entry_declares_async_int: (Array[Stmt], String) -> Bool = (stmts, entry_name) -> {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, Some(ty), _) => if name == entry_name {\n        match ty {\n          TyFn(params, ret, Some(eff)) => if String::contains(eff, \"Async\") && Array::length(params) == 0 {\n            match ret {\n              TyName(rn) => if rn == \"Int\" {\n                found = true\n              } else {\n                ()\n              },\n              _ => ()\n            }\n          } else {\n            ()\n          },\n          _ => ()\n        }\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Wrap the core wasm into an async component when the entry is async. The\n// trampoline imports/aliases the main export by name \"run\", so this narrow PoC\n// only triggers for an entry named \"run\".\nlet maybe_wrap_async_component: (Bytes, Bool) -> Bytes = (bytes, wrap_async) -> {\n  if wrap_async {\n    comp_emit_component_wasm_async_trampolined_p1(bytes, \"run\", 120)\n  } else {\n    bytes\n  }\n}\n\nexport let compile_source_wasi_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  // Check before stripping generic type params (see merge_sources.vibe).\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_impl(stmts, entry_name), wrap_async)\n}\n\n// ADR-0055 #493 cutover: same pipeline on the Perceus RC codegen path. Lets the\n// selfbuild / bootstrap / e2e gates compile real programs (incl. the whole\n// compiler) under RC via an env toggle in cli_main — the full-scale validity +\n// correctness signal the memory-limited test probes cannot produce.\nexport let compile_source_wasi_only_rc: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wrap_async = (entry_name == \"run\") && entry_declares_async_int(stmts, entry_name)\n  strip_generic_type_params(stmts)\n  maybe_wrap_async_component(compile_wasi_module_rc_impl(stmts, entry_name), wrap_async)\n}\n")
}

let cli_adapter_source_99 = () -> (String, String) {
  ("vibe/compiler/selfhost_cli_adapter.vibe",
"//# Imports\n\nimport ./entry / source_compile / wasi_only / preprocess.vibe {\n  compile_source_wasi_only, compile_source_wasi_only_rc\n}\n\n//# Functions\n\nlet read_arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {\n  let value = Env::args_get(index)\n  if value != \"\" {\n    value\n  } else {\n    Env::get(env_name)\n  }\n}\n\nlet own_host_string: (String) -> String = (value) -> {\n  String::concat(\"\", value)\n}\n\nlet profile_memory_mark: (Bool) -> Unit with { Env } = (enabled) -> {\n  if enabled {\n    let _ = Env::get(\"VIBE_PROFILE_MEMORY_MARK\")\n    ()\n  } else {\n    ()\n  }\n}\n\nlet compile_source_for_rc_flag: (String, String, String) -> Bytes with { Error } = (source, entry_name, rc_flag) -> {\n  if rc_flag == \"1\" {\n    compile_source_wasi_only_rc(source, entry_name)\n  } else {\n    compile_source_wasi_only(source, entry_name)\n  }\n}\n\nexport let cli_main: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = own_host_string(read_arg_or_env(0, \"VIBE_INPUT\"))\n  let output_path = own_host_string(read_arg_or_env(1, \"VIBE_OUTPUT\"))\n  let entry_name = own_host_string(read_arg_or_env(2, \"VIBE_ENTRY\"))\n  let mark_memory = Env::get(\"VIBE_PROFILE_MEMORY_MARKS\") == \"1\"\n  let source = Fs::read_file(input_path)\n  profile_memory_mark(mark_memory)\n  // ADR-0055 #493 cutover toggle: VIBE_RC=1 compiles on the Perceus RC codegen\n  // path (Env::get returns \"\" when unset, so default stays the bump path). Lets\n  // the selfbuild/bootstrap/e2e gates exercise the whole compiler under RC.\n  let rc_flag = Env::get(\"VIBE_RC\")\n  let bytes = compile_source_for_rc_flag(source, entry_name, rc_flag)\n  profile_memory_mark(mark_memory)\n  Fs::write_bytes(output_path, bytes)\n  profile_memory_mark(mark_memory)\n  0\n}\n")
}

