ytebuf_push(buf, 0)\n    bytebuf_push(buf, 0)\n    let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    if is_pctor(catch_pat) {\n      let cargs = get_pctor_args(catch_pat)\n      if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n        let pname = get_pbind_name(Array::get(cargs, 0))\n        let bl = Array::length(local_names)\n        emit_local_set(buf, bl)\n        Array::push(local_names, pname)\n      } else {\n        emit_drop(buf)\n      }\n    } else if is_pbind(catch_pat) {\n      let pname = get_pbind_name(catch_pat)\n      let bl = Array::length(local_names)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      emit_drop(buf)\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    let nl2 = compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n    nl2\n  } else {\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\n  }\n}\n")

