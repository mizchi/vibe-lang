) => Some(t),\n        None => lookup_map_set(name)\n      }\n    }\n  }\n}\n\nlet lookup_mapbuilder_new: (String) -> Option[Type] = (name) -> {\n  if name == \"MapBuilder::new\" {\n    Some(CtFn(map_no_params(), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_mapbuilder_set: (String) -> Option[Type] = (name) -> {\n  if name == \"MapBuilder::set\" {\n    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_mapbuilder_freeze: (String) -> Option[Type] = (name) -> {\n  if name == \"MapBuilder::freeze\" {\n    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_map_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_mapbuilder_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_mapbuilder_set(name) {\n      Some(t) => Some(t),\n      None => match lookup_mapbuilder_freeze(name) {\n        Some(t) => Some(t),\n        None => lookup_map_get(name)\n      }\n    }\n  }\n}\n\nexport let lookup_map: (String) -> Option[Type] = (name) -> {\n  match lookup_map_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_map_group_b(name)\n  }\n}\n")
