"//# Imports\n\nimport .. / .. / core {\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_opcode_s64, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\n//# Functions\n\nexport let emit_end: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, 11)\n}\n\nexport let emit_i32_const: (Bytes, Int) -> Unit = (buf, value) -> {\n  bytebuf_push_opcode_s64(buf, 65, value)\n}\n\nexport let emit_code_section: (Bytes, Array[Bytes]) -> Unit = (out, bodies) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n\nexport let emit_memory_section: (Bytes, Int) -> Unit = (out, min_pages) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, 5, content)\n}\n\nexport let emit_code_section_with_locals: (Bytes, Array[Bytes], Array[Int]) -> Unit = (out, bodies, local_counts) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)\n    } else {\n      leb128_encode_u32(func_buf, 1)\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, 126)\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_buf(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, 10, content)\n}\n")
}

let cli_adapter_source_55 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/extra.vibe",
"//# Imports\n\nimport .. / .. / core {\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push_buf, bytebuf_push_opcode_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport ./base.vibe {\n  emit_end, emit_i32_const, emit_name\n}\n\n//# Functions\n\nlet vt_i32 = 127\n\nlet sec_data = 11\n\nlet type_func = 96\n\nlet sec_export = 7\n\nlet sec_global = 6\n\nlet sec_import = 2\n\nlet export_func = 0\n\nlet export_memory = 2\n\nlet op_global_get = 35\n\nlet op_global_set = 36\n\nlet op_i32_add = 106\n\nlet op_i32_sub = 107\n\nlet op_i32_shr_u = 118\n\nlet op_i32_gt_u = 75\n\nlet op_memory_size = 63\n\nlet op_memory_grow = 64\n\nlet op_drop = 26\n\nlet op_if = 4\n\nlet bt_void = 64\n\nexport let emit_global_get: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\n}\n\nexport let emit_heap_memory_grow_check: (Bytes) -> Unit = (buf) -> {\n  // Grow memory to `(heap_ptr + 65536) >> 16` pages — i.e. ALWAYS at least one\n  // page past `heap_ptr`. The previous `+ 65535` rounded to `ceil(heap_ptr /\n  // 65536)`, which holds only `[0, heap_ptr)`; when `heap_ptr` lands exactly on\n  // a page boundary that leaves `memory_size == heap_ptr`, and an access at\n  // `heap_ptr` (the next slot the bump allocator hands out) traps with\n  // \"memory access out of bounds\". The `+ 65536` reserves a guard page so\n  // `heap_ptr` itself is always addressable. Monotonic: never grows LESS than\n  // before, so it cannot under-allocate.\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65536)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_gt_u)\n  bytebuf_push2(buf, op_if, bt_void)\n  emit_global_get(buf, 0)\n  emit_i32_const(buf, 65536)\n  bytebuf_push(buf, op_i32_add)\n  emit_i32_const(buf, 16)\n  bytebuf_push(buf, op_i32_shr_u)\n  bytebuf_push2(buf, op_memory_size, 0)\n  bytebuf_push(buf, op_i32_sub)\n  bytebuf_push2(buf, op_memory_grow, 0)\n  bytebuf_push(buf, op_drop)\n  emit_end(buf)\n}\n\nexport let emit_global_set: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\n}\n\nexport let emit_data_section: (Bytes, Int, Bytes) -> Unit = (out, offset, data) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, offset)\n  emit_end(content)\n  leb128_encode_u32(content, Bytes::length(data))\n  bytebuf_push_buf(content, data)\n  bytebuf_push_section(out, sec_data, content)\n}\n\nexport let emit_exports_full: (Bytes, Array[String], Array[Int], String, Int, Array[String], Array[Int]) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx, global_names, global_indices) -> {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport let emit_export_memory: (Bytes, String, Int) -> Unit = (out, name, mem_idx) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport let emit_func_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, param_types, result_types) -> {\n  bytebuf_push(buf, type_func)\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\nexport let emit_exports_with_memory: (Bytes, Array[String], Array[Int], String, Int) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx) -> {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\nexport let emit_import_section_func: (Bytes, String, String, Int) -> Unit = (out, module_name, field_name, type_idx) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, export_func)\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, sec_import, content)\n}\n\nexport let emit_global_section_i32_mut: (Bytes, Int) -> Unit = (out, init_value) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, vt_i32, 1)\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, sec_global, content)\n}\n")
}

let cli_adapter_source_56 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/instructions.vibe",
"//# Imports\n\nimport .. / .. / core {\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push9, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_opcode_u32_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\n}\n\nimport ./sections.vibe {\n  emit_end, emit_i32_const\n}\n\n//# Functions\n\nlet op_br = 12\n\nlet op_if = 4\n\nlet bt_i64 = 126\n\nlet bt_void = 64\n\nexport let emit_br: (Bytes, Int) -> Unit = (buf, label) -> {\n  bytebuf_push_opcode_u32(buf, op_br, label)\n}\n\nlet op_call = 16\n\nlet op_drop = 26\n\nlet op_else = 5\n\nlet op_loop = 3\n\nlet op_block = 2\n\nlet op_br_if = 13\n\nexport let emit_call: (Bytes, Int) -> Unit = (buf, func_idx) -> {\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\n}\n\nexport let emit_drop: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_drop)\n}\n\nexport let emit_else: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_else)\n}\n\nlet op_f64_eq = 97\n\nlet op_f64_ge = 102\n\nlet op_f64_gt = 100\n\nlet op_f64_le = 101\n\nlet op_f64_lt = 99\n\nlet op_f64_ne = 98\n\nlet op_i64_eq = 81\n\nlet op_i64_ne = 82\n\nlet op_i64_or = 132\n\nlet op_return = 15\n\nlet sec_table = 4\n\nexport let emit_br_if: (Bytes, Int) -> Unit = (buf, label) -> {\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\n}\n\nlet op_f64_add = 160\n\nlet op_f64_div = 163\n\nlet op_f64_mul = 162\n\nlet op_f64_neg = 154\n\nlet op_f64_sub = 161\n\nlet op_i32_add = 106\n\nlet op_i64_add = 124\n\nlet op_i64_and = 131\n\nlet op_i64_eqz = 80\n\nlet op_i64_mul = 126\n\nlet op_i64_shl = 134\n\nlet op_i64_sub = 125\n\nlet op_i64_xor = 133\n\nexport let emit_f64_eq: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_eq)\n}\n\nexport let emit_f64_ge: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_ge)\n}\n\nexport let emit_f64_gt: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_gt)\n}\n\nexport let emit_f64_le: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_le)\n}\n\nexport let emit_f64_lt: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_lt)\n}\n\nexport let emit_f64_ne: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_ne)\n}\n\nexport let emit_i64_eq: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_eq)\n}\n\nexport let emit_i64_ne: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_ne)\n}\n\nexport let emit_i64_or: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_or)\n}\n\nexport let emit_if_i64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push2(buf, op_if, bt_i64)\n}\n\nexport let emit_return: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_return)\n}\n\nlet op_i32_load = 40\n\nlet op_i64_ge_s = 89\n\nlet op_i64_gt_s = 85\n\nlet op_i64_le_s = 87\n\nlet op_i64_lt_s = 83\n\nlet sec_element = 9\n\nexport let emit_f64_add: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_add)\n}\n\nexport let emit_f64_div: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_div)\n}\n\nexport let emit_f64_mul: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_mul)\n}\n\nexport let emit_f64_neg: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_neg)\n}\n\nexport let emit_f64_sub: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_sub)\n}\n\nexport let emit_i32_add: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_add)\n}\n\nexport let emit_i64_add: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_add)\n}\n\nexport let emit_i64_and: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_and)\n}\n\nexport let emit_i64_eqz: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_eqz)\n}\n\nexport let emit_i64_mul: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_mul)\n}\n\nexport let emit_i64_shl: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_shl)\n}\n\nexport let emit_i64_sub: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_sub)\n}\n\nexport let emit_i64_xor: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_xor)\n}\n\nexport let emit_if_void: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push2(buf, op_if, bt_void)\n}\n\nlet op_i32_store = 54\n\nlet op_i64_const = 66\n\nlet op_i64_div_s = 127\n\nlet op_i64_rem_s = 129\n\nlet op_i64_shr_s = 135\n\nlet op_local_get = 32\n\nlet op_local_set = 33\n\nlet op_local_tee = 34\n\nlet type_funcref = 112\n\nexport let emit_call_ref: (Bytes, Int) -> Unit = (buf, type_idx) -> {\n  bytebuf_push_opcode_u32(buf, 20, type_idx)\n}\n\nexport let emit_i32_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load, align, offset)\n}\n\nexport let emit_i64_ge_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_ge_s)\n}\n\nexport let emit_i64_gt_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_gt_s)\n}\n\nexport let emit_i64_le_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_le_s)\n}\n\nexport let emit_i64_lt_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_lt_s)\n}\n\nexport let emit_ref_func: (Bytes, Int) -> Unit = (buf, func_idx) -> {\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\n}\n\nexport let emit_ref_null: (Bytes, Int) -> Unit = (buf, heap_type_byte) -> {\n  bytebuf_push2(buf, 208, heap_type_byte)\n}\n\nlet op_i32_store8 = 58\n\nexport let emit_block_i64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push2(buf, op_block, bt_i64)\n}\n\nexport let emit_i32_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)\n}\n\nexport let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push_opcode_u32_u32(buf, 55, align, offset)\n}\n\nexport let emit_i64_const: (Bytes, Int) -> Unit = (buf, value) -> {\n  bytebuf_push_opcode_s64(buf, op_i64_const, value)\n}\n\nexport let emit_i64_div_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_div_s)\n}\n\nexport let emit_i64_rem_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_rem_s)\n}\n\nexport let emit_i64_shr_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_shr_s)\n}\n\nexport let emit_local_get: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_local_get, idx)\n}\n\nexport let emit_local_set: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_local_set, idx)\n}\n\nexport let emit_local_tee: (Bytes, Int) -> Unit = (buf, idx) -> {\n  bytebuf_push_opcode_u32(buf, op_local_tee, idx)\n}\n\nexport let emit_loop_void: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push2(buf, op_loop, bt_void)\n}\n\nlet op_i32_load8_u = 45\n\nexport let emit_block_void: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push2(buf, op_block, bt_void)\n}\n\nexport let emit_i32_store8: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)\n}\n\nexport let emit_struct_get: (Bytes, Int, Int) -> Unit = (buf, type_idx, field_idx) -> {\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\nexport let emit_struct_new: (Bytes, Int) -> Unit = (buf, type_idx) -> {\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\n}\n\nexport let emit_struct_set: (Bytes, Int, Int) -> Unit = (buf, type_idx, field_idx) -> {\n  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\nlet op_i32_wrap_i64 = 167\n\nexport let emit_i32_load8_u: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load8_u, align, offset)\n}\n\nlet op_call_indirect = 17\n\nexport let emit_i32_wrap_i64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_wrap_i64)\n}\n\nexport let emit_call_indirect: (Bytes, Int) -> Unit = (buf, type_idx) -> {\n  bytebuf_push_opcode_u32(buf, op_call_indirect, type_idx)\n  bytebuf_push(buf, 0)\n}\n\nlet op_i64_trunc_f64_s = 176\n\nexport let emit_f64_const_bits: (Bytes, Int) -> Unit = (buf, bits) -> {\n  bytebuf_push9(buf, 68, bits&255, (bits>>8)&255, (bits>>16)&255, (bits>>24)&255, (bits>>32)&255, (bits>>40)&255, (bits>>48)&255, (bits>>56)&255)\n}\n\n// Emit f64.const from the f64 pattern split into its low / high 32 bits\n// (little-endian: 4 bytes of lo, then 4 bytes of hi). Each half is 0..2^32-1,\n// so it fits the 62-bit Int — unlike the full pattern, which overflows it\n// (Blocker-2, ADR-0055). Callers obtain lo/hi via Double::to_i64_bits_lo/_hi.\nexport let emit_f64_const_lohi: (Bytes, Int, Int) -> Unit = (buf, lo, hi) -> {\n  bytebuf_push9(buf, 68, lo&255, (lo>>8)&255, (lo>>16)&255, (lo>>24)&255, hi&255, (hi>>8)&255, (hi>>16)&255, (hi>>24)&255)\n}\n\nlet op_i64_extend_i32_s = 172\n\nexport let emit_i64_trunc_f64_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_trunc_f64_s)\n}\n\nexport let emit_struct_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, field_types, field_muts) -> {\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\n  let mut i = 0\n  while i < Array::length(field_types) {\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\n    i = i + 1\n  }\n}\n\nlet op_f64_convert_i64_s = 185\n\nexport let emit_i64_extend_i32_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_extend_i32_s)\n}\n\nexport let emit_f64_convert_i64_s: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_convert_i64_s)\n}\n\nlet op_f64_reinterpret_i64 = 191\n\nlet op_i64_reinterpret_f64 = 189\n\nexport let emit_f64_reinterpret_i64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_reinterpret_i64)\n}\n\nexport let emit_i64_reinterpret_f64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_reinterpret_f64)\n}\n\nexport let emit_table_section_funcref: (Bytes, Int) -> Unit = (out, num_entries) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, type_funcref, 0)\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, sec_table, content)\n}\n\nexport let emit_element_section_active: (Bytes, Array[Int]) -> Unit = (out, func_indices) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, 0)\n  emit_end(content)\n  leb128_encode_u32(content, Array::length(func_indices))\n  let mut i = 0\n  while i < Array::length(func_indices) {\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_element, content)\n}\n")
}

let cli_adapter_source_57 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/builders.vibe",
"//# Imports\n\nimport .. / .. / core {\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_u32\n}\n\nimport ./instructions.vibe {\n  emit_block_void, emit_br, emit_br_if, emit_call, emit_drop, emit_i32_store, emit_i64_add, emit_i64_const, emit_i64_le_s, emit_i64_mul, emit_i64_sub, emit_local_get, emit_local_set, emit_loop_void\n}\n\nimport ./sections.vibe {\n  emit_code_section, emit_code_section_with_locals, emit_data_section, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_func_type_raw, emit_function_section, emit_header, emit_i32_const, emit_import_section_func, emit_memory_section, emit_type_section, emit_type_section_multi\n}\n\n//# Functions\n\nlet builders_vt_i32 = 127\n\nlet builders_sec_data = 11\n\nlet sec_type = 1\n\nexport let string_to_data: (String) -> Bytes = (s) -> {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\nlet empty_int_array: () -> Array[Int] = () -> {\n  Array::slice([\n    0\n  ], 0, 0)\n}\n\nlet pair_int_array: (Int, Int) -> Array[Int] = (v0, v1) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nlet quad_int_array: (Int, Int, Int, Int) -> Array[Int] = (v0, v1, v2, v3) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  Array::push(values, v3)\n  values\n}\n\nlet triple_int_array: (Int, Int, Int) -> Array[Int] = (v0, v1, v2) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet empty_bytes_array: () -> Array[Bytes] = () -> {\n  Array::slice([\n    bytebuf_new()\n  ], 0, 0)\n}\n\nlet pair_bytes_array: (Bytes, Bytes) -> Array[Bytes] = (v0, v1) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nlet builders_empty_string_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet pair_string_array: (String, String) -> Array[String] = (v0, v1) -> {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nexport let build_call_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\n  emit_function_section(out, pair_int_array(0, 1))\n  emit_export_section_multi(out, pair_string_array(\"square\", \"sum_sq\"), pair_int_array(0, 1))\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)\n  emit_i64_add(ss_body)\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\n  bytebuf_to_bytes(out)\n}\n\nlet triple_bytes_array: (Bytes, Bytes, Bytes) -> Array[Bytes] = (v0, v1, v2) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet singleton_int_array: (Int) -> Array[Int] = (v0) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  values\n}\n\nlet triple_string_array: (String, String, String) -> Array[String] = (v0, v1, v2) -> {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet singleton_bytes_array: (Bytes) -> Array[Bytes] = (v0) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  values\n}\n\nexport let build_add_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, singleton_bytes_array(body))\n  bytebuf_to_bytes(out)\n}\n\nexport let build_factorial_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fact\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_mul(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))\n  bytebuf_to_bytes(out)\n}\n\nexport let build_fibonacci_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fib\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 2)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_set(b, 1)\n  emit_local_get(b, 3)\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(3))\n  bytebuf_to_bytes(out)\n}\n\nlet singleton_string_array: (String) -> Array[String] = (v0) -> {\n  let values = builders_empty_string_array()\n  Array::push(values, v0)\n  values\n}\n\nexport let build_hello_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 100)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)\n  bytebuf_push(hello_data, 101)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 32)\n  bytebuf_push(hello_data, 119)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 114)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 100)\n  bytebuf_push(hello_data, 10)\n  emit_data_section(out, 8, hello_data)\n  bytebuf_to_bytes(out)\n}\n\nexport let build_arithmetic_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, triple_int_array(0, 0, 0))\n  emit_export_section_multi(out, triple_string_array(\"add\", \"sub\", \"mul\"), triple_int_array(0, 1, 2))\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\n  bytebuf_to_bytes(out)\n}\n\nexport let emit_data_section_multi: (Bytes, Array[Int], Array[Bytes]) -> Unit = (out, offsets, datas) -> {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Bytes::length(data))\n    bytebuf_push_buf(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, builders_sec_data, content)\n}\n\nexport let build_print_string_module: (String) -> Bytes = (msg) -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let str_data = string_to_data(msg)\n  let str_len = Bytes::length(str_data)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n")
}

let cli_adapter_source_58 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/simd.vibe",
"//# WASM SIMD Instruction Emitters\n//\n// WASM SIMD (128-bit) instructions for v128 operations.\n// Prefix: 0xFD (253) followed by LEB128-encoded sub-opcode.\n//\n// Reference: https://webassembly.github.io/spec/core/binary/instructions.html#simd-instructions\n\nimport ../../core/index.vibe {\n  bytebuf_push, leb128_encode_u32\n}\n\n//# Constants\n\nlet simd_prefix = 253\n\n// Memory ops (prefix + LEB128 opcode + memarg)\nlet simd_v128_load = 0\nlet simd_v128_store = 11\n\n// Splat ops\nlet simd_i8x16_splat = 15\n\n// Shuffle / swizzle (i8x16.swizzle = 0x0E)\nlet simd_i8x16_swizzle = 14\n\n// Comparison ops (spec sub-opcodes, see binary/instructions SIMD table)\nlet simd_i8x16_eq = 35\n// i8x16.le_u = 0x2A, i8x16.ge_u = 0x2C. NB: 38/40 are lt_u/gt_u, not le/ge.\nlet simd_i8x16_le_u = 42\nlet simd_i8x16_ge_u = 44\n\n// i8x16 arithmetic\nlet simd_i8x16_sub = 113\nlet simd_i8x16_min_u = 119\n\n// Boolean reduction\nlet simd_v128_any_true = 83\n\n// Bitwise\nlet simd_v128_and = 78\nlet simd_v128_not = 77\n\n// i8x16 specific\nlet simd_i8x16_all_true = 99\nlet simd_i8x16_bitmask = 100\n\n// v128.const (opcode 12, followed by 16 immediate bytes)\nlet simd_v128_const = 12\n\n//# Memory Instructions\n\n// v128.load memarg  -- load 128 bits from memory\nexport let emit_v128_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n// v128.store memarg  -- store 128 bits to memory\nexport let emit_v128_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n//# Splat Instructions\n\n// i8x16.splat  -- broadcast i32 to all 16 lanes\nexport let emit_i8x16_splat: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_splat)\n}\n\n//# Comparison Instructions\n\n// i8x16.eq  -- lane-wise equality, result: 0xFF or 0x00 per lane\nexport let emit_i8x16_eq: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_eq)\n}\n\n// i8x16.le_u  -- lane-wise unsigned less-or-equal (0xFD 0x2A)\nexport let emit_i8x16_le_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_le_u)\n}\n\n// i8x16.ge_u  -- lane-wise unsigned greater-or-equal (0xFD 0x2C)\nexport let emit_i8x16_ge_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_ge_u)\n}\n\n// i8x16.swizzle  -- byte shuffle of first operand by indices in second (0xFD 0x0E)\nexport let emit_i8x16_swizzle: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_swizzle)\n}\n\n// i8x16.sub  -- lane-wise wrapping subtraction (0xFD 0x71)\nexport let emit_i8x16_sub: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_sub)\n}\n\n// i8x16.min_u  -- lane-wise unsigned minimum (0xFD 0x77)\nexport let emit_i8x16_min_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_min_u)\n}\n\n//# Boolean Reduction\n\n// v128.any_true  -- 1 if any bit is non-zero\nexport let emit_v128_any_true: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_any_true)\n}\n\n// i8x16.all_true  -- 1 if all lanes are non-zero\nexport let emit_i8x16_all_true: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_all_true)\n}\n\n// i8x16.bitmask  -- extract MSB of each lane into i32 bitmask\nexport let emit_i8x16_bitmask: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_i8x16_bitmask)\n}\n\n//# Bitwise Instructions\n\n// v128.and\nexport let emit_v128_and: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_and)\n}\n\n// v128.or  (sub-opcode 0x50 = 80; 0x4F/79 is v128.andnot — see #536)\nexport let emit_v128_or: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, 80)\n}\n\n// v128.not\nexport let emit_v128_not: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_not)\n}\n\n//# v128.const\n\n// v128.const with an explicit 16-byte little-endian immediate (0xFD 0x0C).\n// Shorter arrays are zero-padded; longer arrays are truncated to 16 lanes.\nexport let emit_v128_const: (Bytes, Array[Int]) -> Unit = (buf, lanes) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let n = Array::length(lanes)\n  let mut i = 0\n  while i < 16 {\n    let b = if i < n {\n      Array::get(lanes, i)\n    } else {\n      0\n    }\n    bytebuf_push(buf, b & 255)\n    i = i + 1\n  }\n}\n\n// v128.const -- push 16-byte immediate constant onto stack\n// The 16 bytes are written directly after the opcode.\nexport let emit_v128_const_zero: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  // 16 zero bytes\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, 0)\n    i = i + 1\n  }\n}\n\n// v128.const with all lanes set to the same byte value\nexport let emit_v128_const_splat_byte: (Bytes, Int) -> Unit = (buf, byte_val) -> {\n  bytebuf_push(buf, simd_prefix)\n  leb128_encode_u32(buf, simd_v128_const)\n  let mut i = 0\n  while i < 16 {\n    bytebuf_push(buf, byte_val & 255)\n    i = i + 1\n  }\n}\n")
}

let cli_adapter_source_59 = () -> (String, String) {
  ("vibe/compiler/codegen/wasm_emit/simd_patterns.vibe",
"//# SIMD Higher-Level Patterns\n//\n// Composable SIMD instruction sequences for common compiler operations.\n// Each pattern emits a WASM function body into a bytebuf.\n//\n// Convention: all functions use i64 params/results (vibe's tagged int ABI).\n// Memory addresses are passed as i64 and wrapped to i32 for memory ops.\n\nimport ../../core/index.vibe {\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ./simd.vibe {\n  emit_v128_load, emit_i8x16_splat, emit_i8x16_eq,\n  emit_i8x16_all_true, emit_i8x16_bitmask,\n  emit_v128_and, emit_v128_or, emit_v128_not\n}\n\nimport ./instructions.vibe {\n  emit_local_get, emit_local_set,\n  emit_i32_wrap_i64, emit_i64_extend_i32_s, emit_i64_const,\n  emit_i64_add, emit_i64_eq,\n  emit_i32_load8_u,\n  emit_return,\n  emit_if_i64, emit_else\n}\n\nimport ./code_helpers.vibe {\n  emit_end\n}\n\n//# Pattern: SIMD memcmp_16\n//\n// Compare 16 bytes at two memory addresses using SIMD.\n// Params: local0=addr_a:i64, local1=addr_b:i64\n// Returns: i64 (1 if all 16 bytes equal, 0 otherwise)\n//\n// Instructions (7 total):\n//   local.get 0 / i32.wrap_i64 / v128.load\n//   local.get 1 / i32.wrap_i64 / v128.load\n//   i8x16.eq / i8x16.all_true / i64.extend_i32_s\n\nexport let emit_simd_memcmp_16: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n\n  emit_i8x16_eq(buf)\n  emit_i8x16_all_true(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n//# Pattern: SIMD find_byte_16\n//\n// Find a byte in a 16-byte memory chunk using SIMD.\n// Params: local0=addr:i64, local1=target_byte:i64\n// Returns: i64 bitmask (bit N set if byte at offset N matches)\n//\n// Instructions (7 total):\n//   local.get 0 / i32.wrap_i64 / v128.load\n//   local.get 1 / i32.wrap_i64 / i8x16.splat\n//   i8x16.eq / i8x16.bitmask / i64.extend_i32_s\n\nexport let emit_simd_find_byte_16: (Bytes) -> Unit = (buf) -> {\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n\n  emit_i8x16_eq(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n//# Pattern: SIMD skip_whitespace_16\n//\n// Check a 16-byte chunk for whitespace characters (' ', '\\t', '\\n', '\\r').\n// Params: local0=addr:i64\n// Returns: i64 bitmask of NON-whitespace positions (bit set = not whitespace)\n//\n// Strategy: compare chunk against each whitespace byte, OR the masks,\n// then NOT to get non-whitespace positions, then bitmask.\n//\n// Instructions:\n//   v128.load chunk\n//   4x (i8x16.splat + i8x16.eq) for ' ', '\\t', '\\n', '\\r'\n//   3x v128.or to combine\n//   v128.not → non-whitespace mask\n//   i8x16.bitmask → i32 → i64\n\nexport let emit_simd_skip_whitespace_16: (Bytes) -> Unit = (buf) -> {\n  // Load chunk: local.get 0 / i32.wrap / v128.load\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 2)  // local2 = chunk\n\n  // is_space = i8x16.eq(chunk, splat(0x20))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x20)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: is_space\n\n  // is_tab = i8x16.eq(chunk, splat(0x09))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x09)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: is_space, is_tab\n\n  emit_v128_or(buf)\n  // stack: is_space|is_tab\n\n  // is_nl = i8x16.eq(chunk, splat(0x0A))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0A)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: (is_space|is_tab), is_nl\n\n  emit_v128_or(buf)\n  // stack: is_space|is_tab|is_nl\n\n  // is_cr = i8x16.eq(chunk, splat(0x0D))\n  emit_local_get(buf, 2)\n  emit_i64_const(buf, 0x0D)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: (is_space|is_tab|is_nl), is_cr\n\n  emit_v128_or(buf)\n  // stack: is_ws (all whitespace positions)\n\n  // NOT → non-whitespace, then bitmask\n  emit_v128_not(buf)\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n  // result: bitmask where bit N set = byte N is NOT whitespace\n  // caller uses ctz to find first non-whitespace position\n}\n\n//# Pattern: SIMD in_range_16\n//\n// Check if each byte in a 16-byte chunk is within [low, high] range.\n// Params: local0=addr:i64, local1=low:i64, local2=high:i64\n// Returns: i64 bitmask of bytes OUTSIDE range (bit set = out of range)\n//\n// Uses: v128_le_u_i8x16 is not yet in our emit set, so we use\n// a subtraction trick: (byte - low) <= (high - low) using unsigned comparison.\n// For simplicity, we use splat + eq for exact byte matching instead.\n//\n// Actually: since we don't have le_u yet, provide an alternative pattern\n// that checks membership in a character set via multiple eq + or.\n\nexport let emit_simd_is_identifier_char_16: (Bytes) -> Unit = (buf) -> {\n  // Load chunk\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_v128_load(buf, 0, 0)\n  emit_local_set(buf, 1)  // local1 = chunk\n\n  // Check '_' (0x5F)\n  emit_local_get(buf, 1)\n  emit_i64_const(buf, 0x5F)\n  emit_i32_wrap_i64(buf)\n  emit_i8x16_splat(buf)\n  emit_i8x16_eq(buf)\n  // stack: is_underscore\n\n  // For [a-z], [A-Z], [0-9] we'd need le_u.\n  // Emit the underscore check as a starting point; full range check\n  // requires adding emit_i8x16_le_u to simd.vibe (opcode 0xFD 0x26).\n\n  // For now, bitmask the underscore-only result as a prototype\n  emit_i8x16_bitmask(buf)\n  emit_i64_extend_i32_s(buf)\n}\n\n//# Scalar baselines (for code size comparison)\n\n// i64.load instruction (opcode 0x29 = 41, followed by memarg)\nlet emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, 41)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n//# Scalar memcmp_16 (unrolled, 2x i64.load)\n//\n// Compare 16 bytes as two 8-byte i64 loads.\n// Params: local0=addr_a:i64, local1=addr_b:i64\n// Returns: i64 (1 if equal, 0 otherwise)\n//\n// This is the realistic scalar baseline -- compilers unroll small memcmp\n// into word-sized loads. Still more instructions than SIMD.\n\nexport let emit_scalar_memcmp_16_unrolled: (Bytes) -> Unit = (buf) -> {\n  // Compare first 8 bytes\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n\n  emit_local_get(buf, 1)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 0, 0)\n\n  emit_i64_eq(buf)\n  // if first 8 bytes equal, check second 8 bytes\n  emit_if_i64(buf)\n    emit_local_get(buf, 0)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 0, 8)\n\n    emit_local_get(buf, 1)\n    emit_i32_wrap_i64(buf)\n    emit_i64_load(buf, 0, 8)\n\n    emit_i64_eq(buf)\n    emit_i64_extend_i32_s(buf)\n  emit_else(buf)\n    emit_i64_const(buf, 0)\n  emit_end(buf)\n}\n\n//# Scalar find_byte_16 (unrolled, 4 bytes checked)\n//\n// Check bytes one by one with conditional branches.\n// Params: local0=addr:i64, local1=target_byte:i64\n// Returns: i64 bitmask (1<<pos for first match, 0 if not found)\n//\n// Only checks first 4 bytes for code brevity. A full 16-byte unroll\n// would be 4x larger, making the SIMD advantage even more dramatic.\n\nexport let emit_scalar_find_byte_16_unrolled: (Bytes) -> Unit = (buf) -> {\n  // Byte 0\n  emit_local_get(buf, 0)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load8_u(buf, 0, 0)\n  emit_i64_extend_i32_s(buf)\n  emit_local_get(buf, 1)\n  emit_i64_eq(buf)\n  emit_if_i64(buf)\n    emit_i64_const(buf, 1)\n    emit_return(buf)\n  emit_else(buf)\n    // Byte 1\n    emit_local_get(buf, 0)\n    emit_i32_wrap_i64(buf)\n    emit_i32_load8_u(buf, 0, 1)\n    emit_i64_extend_i32_s(buf)\n    emit_local_get(buf, 1)\n    emit_i64_eq(buf)\n    emit_if_i64(buf)\n      emit_i64_const(buf, 2)\n      emit_return(buf)\n    emit_else(buf)\n      // Byte 2\n      emit_local_get(buf, 0)\n      emit_i32_wrap_i64(buf)\n      emit_i32_load8_u(buf, 0, 2)\n      emit_i64_extend_i32_s(buf)\n      emit_local_get(buf, 1)\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n        emit_i64_const(buf, 4)\n        emit_return(buf)\n      emit_else(buf)\n        // Byte 3\n        emit_local_get(buf, 0)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load8_u(buf, 0, 3)\n        emit_i64_extend_i32_s(buf)\n        emit_local_get(buf, 1)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n          emit_i64_const(buf, 8)\n          emit_return(buf)\n        emit_else(buf)\n          emit_i64_const(buf, 0)\n        emit_end(buf)\n      emit_end(buf)\n    emit_end(buf)\n  emit_end(buf)\n}\n")
}

let cli_adapter_source_60 = () -> (String, String) {
  ("vibe/compiler/codegen/common_base/index.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, __to_string, bytebuf_push, leb128_encode_u32\n}\n\nimport .. / wasm_emit {\n  emit_call, emit_call_indirect, emit_else, emit_end, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_sub, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_load, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_store, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set\n}\n\n//# Types\n\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int];\n  needs_env: Array[Bool]\n}\n\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\nexport struct LambdaTable {\n  bodies: Array[Bytes];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]]\n}\n\n// #cov branch coverage state, threaded via CompileCtx. Linear-backend only;\n// active only when `enabled` (VIBE_COVERAGE=1 build). `base`/`cap` bound a fixed\n// reserved memory region (1 byte per branch id). `next` is a 1-element mutable\n// counter cell assigning sequential branch ids in codegen-traversal order;\n// `cur_fn` is a 1-element cell holding the index of the function currently being\n// compiled (set before each top-level body). `owners` accumulates, per branch\n// id in id order, the owning function index so the report attributes branches to\n// functions (reusing the `vibe_cov` function-name table). When disabled all of\n// this is inert and codegen output is byte-identical to a normal build.\nexport struct CovState {\n  enabled: Bool;\n  base: Int;\n  cap: Int;\n  next: Array[Int];\n  cur_fn: Array[Int];\n  owners: Array[Int]\n}\n\n// A disabled CovState (coverage off): inert, used by the normal compile path and\n// the non-WASI module entry. Fresh 1-element cells keep Array::get safe.\nexport let cov_disabled: () -> CovState = () -> {\n  CovState::{\n    enabled: false,\n    base: 0,\n    cap: 0,\n    next: [\n      0\n    ],\n    cur_fn: [\n      0\n    ],\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n}\n\n// #cov: emit a stack-neutral hit store for one branch target and assign it the\n// next sequential branch id, recording the owning function index. No-op when\n// coverage is off or the fixed-cap region is full. Called at the start of each\n// branch arm's instruction sequence (if/else, match arm), so the store runs\n// only when that branch is actually taken at run time.\nexport let cov_emit_branch: (Bytes, CovState) -> Unit = (buf, cov) -> {\n  if cov.enabled {\n    let id = Array::get(cov.next, 0)\n    if id < cov.cap {\n      Array::set(cov.next, 0, id + 1)\n      Array::push(cov.owners, Array::get(cov.cur_fn, 0))\n      emit_i32_const(buf, cov.base + id)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 0)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  thunk_names: Array[String];\n  const_int_names: Array[String];\n  const_int_values: Array[Int];\n  // Perceus RC mode (docs/spec/selfhost-rc-port.md). When true, heap objects\n  // carry a uniform `[type_id@0][length@4][payload@8...]` header so the (future)\n  // RC drop helper can dispatch and recurse. Default false: layout unchanged.\n  // Threaded as a parameter on the WASI compile path (a module-level flag is\n  // not usable: a getter capturing it is `missing closure env` in the native\n  // CLI codegen, and a cross-module `let` reference is `unknown name`).\n  enable_rc: Bool;\n  // #715 recurrence guard (VIBE_RC=shadow): emit shadow-liveness traps -- a\n  // byte per heap address marks freed blocks; the FIRST dup-of-freed or\n  // drop-of-freed executes `unreachable` instead of silently corrupting the\n  // free list. Debug-only; false (byte-identical output) on normal builds.\n  rc_shadow: Bool;\n  // RC: names of `let` bindings whose value the Perceus analysis says to drop\n  // at scope end (computed per function from build_perceus_plan). compile_expr\n  // emits an rc_drop for a tuple binding whose name appears here.\n  rc_drop_names: Array[String];\n  // RC: alias bindings (`let a = t`) whose source `t` is multiply-used, so the\n  // alias takes a duplicated reference — compile_expr emits an rc_dup of the\n  // source at the alias `let`. (PaAliasDup from the Perceus plan.)\n  rc_alias_dup_names: Array[String];\n  // RC: bindings known at codegen time to hold a heap object (bound to a\n  // tuple/record/enum literal, or an alias of such). Built as `let`s compile.\n  // Gates rc_dup / rc_drop so we never touch a non-heap (e.g. Int-returning\n  // call) binding the static Perceus `scalar` flag over-approximates as heap.\n  heap_binding_names: Array[String];\n  // RC: wasm function index of the generic recursive `__rc_drop` helper\n  // (ADR-0055 Stage 3), or -1 when unavailable (non-RC, or the legacy inline\n  // drop). When >= 0, scope-end drops emit a `call` to it so nested heap is\n  // reclaimed to arbitrary depth.\n  rc_drop_func_idx: Int;\n  // RC: wasm function index of the free-list search allocator `__rc_alloc`\n  // (ADR-0055 Stage 4), or -1 when unavailable (non-RC). When >= 0, heap-object\n  // construction calls it with the block size so an exact-fit free block is found\n  // anywhere in the free-list (not just the head), eliminating the size-ordering\n  // fragmentation a head-only check leaves when interleaved sizes are freed.\n  rc_alloc_func_idx: Int;\n  // Linear-memory backend: wasm function index of `__heap_grow_check`, or -1\n  // when the surrounding module does not define the helper. Bump allocations\n  // call it after updating global 0 so low initial memory can grow on demand.\n  heap_grow_check_func_idx: Int;\n  // RC: names of `let` bindings the Perceus plan marks with a non-alias `PaDup`\n  // (a heap value used in more than one *owning* position, e.g. `let u = (t, t)`\n  // dups `t`). One entry per dup (so a name's multiplicity = its dup budget).\n  // compile_expr emits that many guarded rc_dups at the binding site, giving the\n  // block the extra references its container/owning uses consume — without this\n  // the recursive drop visits the shared child more times than it has refs.\n  // (ADR-0055 Stage 4.)\n  rc_dup_names: Array[String];\n  // Blocker-3 (ADR-0055): append-only log of `slot*2 + flag` entries (flag 1 =\n  // a `let`/`let mut` binding whose value is statically floatish; flag 0 = a\n  // non-float rebind overriding a previously-float slot). The MOST RECENT entry\n  // for a local slot wins, so `expr_is_floatish` can recognise a *variable*\n  // holding a float (`let x = 1.5; x + y` takes the f64 path) while a shadowing\n  // rebind of another type — nested block or if/match branch reusing the slot —\n  // is classified by its own binding. Append-only (not truncated) because the\n  // wasm-gc backend cannot truncate a struct-field array; the log only grows for\n  // float-related bindings, which are rare. Still a syntactic over-\n  // approximation (the AST is untyped): float function params / lambda-captured\n  // floats are not tracked.\n  float_local_slots: Array[Int];\n  // #678: append-only log of `slot*2 + flag` entries, the integer dual of\n  // float_local_slots. flag 1 marks a `let`/`let mut` slot whose value is\n  // statically integral (Int/Bool); flag 0 a non-int rebind overriding a\n  // previously-int slot. Most-recent entry per slot wins, so a bare integer\n  // variable in `==`/`!=` takes the direct `i64.eq` path instead of the\n  // polymorphic `eq` whose string fall-back misreads a large int as a string\n  // fat-pointer (two unequal ints with a zero low word compare EQUAL). UNLIKE\n  // the float log this one IS pruned: `int_log_reset_above` drops entries for\n  // slots a branch/arm is about to reuse, so a slot rebound by a NON-`let`\n  // binder (match-arm / for-in / catch-all pattern var) — which never logs an\n  // entry — is never read as a stale int. Without that pruning a reused slot\n  // holding a string would be misclassified and string `==` would break.\n  int_local_slots: Array[Int];\n  // #724: append-only log of `slot*256 + kind*64 + n` entries tracking\n  // let-bound AGGREGATE literals, so `a == b` with BOTH sides non-literal\n  // bindings can still take the structural comparators (the generic runtime\n  // `eq` pointer-compares tuples, which carry no runtime header to walk).\n  // kind 1 = tuple literal (n = arity), kind 2 = ctor / record literal\n  // (n = field count), kind 0 = non-aggregate rebind overriding a reused\n  // slot. Most-recent entry per slot wins; pruned at the same branch/arm\n  // boundaries as int_local_slots (agg_log_reset_above) so a slot reused by\n  // a non-`let` binder is never read as a stale aggregate. Bindings whose\n  // value shape is not statically known (params, call results, match binds)\n  // are NOT tracked and keep the generic-eq fallback.\n  agg_local_slots: Array[Int];\n  // #724 round 2: program-wide (fn name -> declared aggregate return shape)\n  // parallel arrays (see compute_agg_returning). Shared across functions —\n  // NOT per-function like agg_local_slots.\n  agg_ret_names: Array[String];\n  agg_ret_infos: Array[Int];\n  // #545 nesting: declared effect names (excluding `Error`), in tag-assignment\n  // order. Effect `effect_names[i]` is routed through wasm exception tag `3 + i`\n  // with its own resume frontier; `perform` and `handle` both derive the tag\n  // from this list so a perform reaches its own handler through an unrelated\n  // inner handle (which catches a different tag) and uses an independent\n  // frontier. See effect_name_to_tag.\n  effect_names: Array[String];\n  // #548 multi-value payloads: parallel arrays keyed by full op name\n  // (\"Effect::Op\") giving each effect op's DECLARED parameter count. The handle\n  // arm uses the declared arity (not the pattern arity) to decide whether the\n  // thrown payload is a packed tuple to destructure (arity > 1) or a single\n  // value — so an extra continuation-slot bind like `Question(q, k)` on a\n  // 1-arg op is not mistaken for a 2-tuple. See effect_op_declared_arity.\n  effect_op_keys: Array[String];\n  effect_op_arities: Array[Int];\n  // #cov branch coverage state (linear backend). cov_disabled() when off.\n  cov: CovState;\n  // Interior-line breakpoints (span-arc step5): wasm function index of the\n  // `vibe::dbg_line` host import, or -1 when off (default / non-break /\n  // multi-file). When >= 0, the ELet/ELetMut/ESeq handlers emit\n  // `i32.const <line>` + `call dbg_line_idx` at each statement boundary so the\n  // runner can pause at interior source lines. Default -1: codegen unchanged.\n  dbg_line_idx: Int;\n  // Interior-line breakpoints: sorted newline char-offsets of THIS function's\n  // source file, used to map a statement's char-offset to a 1-based line. Empty\n  // when off.\n  dbg_line_nl: Array[Int];\n  // Interior-line breakpoints (multi-file): the file id of THIS function's source\n  // file (index into `vibe.dbgfiles`), emitted alongside the line so the runner\n  // matches `--break <file>:<line>` against the right file. 0 when off.\n  dbg_line_file_id: Int;\n  // #706 (RC): names live-in to the innermost enclosing `while` loop. A loop body\n  // re-executes, so passing such an owned heap value to a consuming call frees it\n  // on iteration 1 and dangles on the next (use-after-free). compile_call emits a\n  // guarded rc_dup for a bare-ident owning arg whose name is in this set, so each\n  // iteration's consume is balanced and the loop-carried reference survives. The\n  // EWhile codegen sets this to the live-in locals around the body and restores\n  // it after (a shared mutable array; bindings declared inside the body are never\n  // added). Empty outside any loop; rc_dup is a no-op under bump, so the\n  // bump-built selfhost compiler is unaffected.\n  loop_borrowed_names: Array[String];\n  // #706 leak follow-up: append-only per-function log — one entry per loop-\n  // borrowed identifier name each time compile_call emits the protective\n  // rc_dup (see loop_borrowed_names above). That dup+the callee's own internal\n  // drop cancel out across the loop, so the textual occurrence the Perceus plan\n  // treated as \"one real consume\" of the binding actually consumes NOTHING from\n  // it — the plan's `remaining` count is therefore one too low per occurrence,\n  // and it omits the function-exit drop the binding still needs. The function\n  // epilogue (linked_compile.vibe) counts each function param's occurrences in\n  // this log and emits that many EXTRA rc_drop calls, exactly compensating\n  // without touching the plan's borrow/consume decisions anywhere else (so it\n  // cannot perturb a path the plan and codegen already agree on).\n  loop_consumed_names: Array[String];\n  // #707: names of user-defined `let`s whose body provably tail-reaches only\n  // `Array::get`/`Map::get`/`__index` (transitively, through if/match/wrapper\n  // calls to other names already in this list) — computed once per compile via\n  // `compute_borrow_returning_names` over the merged program. compile_call's\n  // `cc_is_borrow_ret_call` treats a call to one of these exactly like a direct\n  // `Array::get`/`Map::get`/`__index` call: its result is a borrowed view of a\n  // heap element (no refcount bump), so passing it into an OWNING position\n  // (ctor field / consuming call arg) needs the same guarded rc_dup or the\n  // element is double-freed when its container is later dropped (e.g. a\n  // `peek(tokens, pos)` wrapper around `Array::get`). Empty outside RC.\n  borrow_ret_names: Array[String];\n  // #710: names of top-level functions whose DECLARED return type (from\n  // their `let f: (...) -> R = ...` signature) is provably scalar (Int/Bool/\n  // Unit) — computed once via `compute_scalar_returning_names` over the\n  // merged program. The ELet ECall branch (compile_expr_tail.vibe) consults\n  // this to skip `heap_binding_names` for `let n = f(...)` when `f` is one of\n  // these: without it, ANY non-borrow-ret call result defaults to heap, so a\n  // binding that is really a plain Int (e.g. `build_import_plan(...) -> Int`)\n  // gets treated as a tagged pointer. If that binding is later aliased more\n  // than once, the Perceus plan schedules a PaAliasDup for it, and\n  // `emit_rc_dup_local` untags-and-derefs the \"pointer\" — for a small int\n  // like 0 that reads/writes near address -4, a `memory access out of\n  // bounds` trap, not a leak. Empty outside RC.\n  scalar_ret_names: Array[String]\n}\n\n// Interior-line breakpoints (span-arc step5, multi-file): per-file provenance the\n// break codegen needs to emit `vibe::dbg_line(<file_id>, <line>)` and a\n// `vibe.dbgfiles` section. `files[k]` is the basename of source file id k;\n// `file_nls[k]` its newline char-offsets; `stmt_file_id[s]` the file id of merged\n// top-level statement s. Empty (via empty_dbg_prov) on non-break builds.\nexport struct DbgProv {\n  files: Array[String];\n  file_nls: Array[Array[Int]];\n  stmt_file_id: Array[Int]\n}\n\nexport let empty_dbg_prov: () -> DbgProv = () -> {\n  DbgProv::{\n    files: Array::slice([\n      \"\"\n    ], 0, 0),\n    file_nls: Array::slice([\n      Array::slice([\n        0\n      ], 0, 0)\n    ], 0, 0),\n    stmt_file_id: Array::slice([\n      0\n    ], 0, 0)\n  }\n}\n\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  // Named gc_ctor_table, NOT ctor_table: codegen resolves record fields by\n  // name-first-match across ALL struct declarations (compile_expr_tail4 EDot),\n  // so a field name shared with CompileCtx at a DIFFERENT position reads the\n  // wrong slot. CompileCtx.ctor_table sits at index 6; this one is index 9 --\n  // sharing the name made every gc-lane ctor lookup read ref_local_indices\n  // (empty) instead of the table. See the field-collision issue for the\n  // root-cause fix direction.\n  gc_ctor_table: CtorTable;\n  // #538: module-level literal constants (`let op_call = 16` etc.). Kind 0 =\n  // Int/Bool (value in gc_const_ivals), kind 1 = String (value in\n  // gc_const_svals, rendered via the string table). All fields gc_-prefixed\n  // for the same collision reason as gc_ctor_table (CompileCtx carries\n  // const_int_names/const_int_values at different slots).\n  gc_const_names: Array[String];\n  gc_const_kinds: Array[Int];\n  gc_const_ivals: Array[Int];\n  gc_const_svals: Array[String];\n  // #538: module-level COMPUTED values (`let t = Bytes::from_array([..])`):\n  // one mutable i64 wasm global each (index 1 + position; global 0 is the\n  // heap pointer), initialized at the top of _start in statement order.\n  gc_global_names: Array[String];\n  // #538 P4.5: locals KNOWN to hold f64 raw bits (shape-tracked at let-bind:\n  // float literal / Int::to_double / float arithmetic). Fresh per function\n  // (like ref_cell_names). Arithmetic on a floatish operand emits real f64\n  // ops — the unconditional i64 ops silently zeroed float-literal parsing\n  // (lexer parse_frac_digits) when the gc-compiled compiler ran. Best-effort:\n  // annotated Double params and tuple-destructured floats are NOT tracked.\n  gc_float_locals: Array[String];\n  // #724: gc twin of CompileCtx.agg_local_slots (same encoding + pruning\n  // discipline) so the gc lane's structural ==/!= also covers non-literal\n  // aggregate bindings. gc_-prefixed per the #722 field-collision convention.\n  gc_agg_local_slots: Array[Int];\n  // #724 round 2: gc twins of agg_ret_names/agg_ret_infos.\n  gc_agg_ret_names: Array[String];\n  gc_agg_ret_infos: Array[Int]\n}\n\n//# Functions\n\n// #678: prune the integer-slot log so it carries NO entry for any slot index\n// >= `floor`. Called right after `local_names` is truncated to `floor` at a\n// branch / match-arm / for-in boundary, where those high slots are about to be\n// reused by the sibling scope. A `let`/`let mut` reusing a slot re-logs its own\n// int-ness, but a NON-`let` binder (match-arm / catch-all / for-in pattern var)\n// logs nothing — so without this prune its slot would still read the previous\n// sibling's stale `int=1` and a string bound there would wrongly take the\n// `i64.eq` path. Compacts the array IN PLACE (entries are unordered, so a plain\n// truncate-by-count will not do): keep entries for slots < floor, then truncate.\n// No temporary allocation — this runs at every branch / arm boundary while\n// compiling, and a fresh array per call piles up on the bump/RC heap during one\n// big function and can trip a heap-marginal compile.\nexport let int_log_reset_above: (CompileCtx, Int) -> Unit = (ctx, floor) -> {\n  let arr = ctx.int_local_slots\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 2 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\n// #724: prune the aggregate-shape log (see CompileCtx.agg_local_slots) at the\n// same branch/arm boundaries as int_log_reset_above — a slot reused by a\n// non-`let` binder must not be read as a stale tuple/ctor, or the structural\n// comparator would walk a non-aggregate value.\nexport let agg_log_reset_above: (Array[Int], Int) -> Unit = (arr, floor) -> {\n  let n = Array::length(arr)\n  let mut w = 0\n  let mut i = 0\n  while i < n {\n    let e = Array::get(arr, i)\n    if e / 256 < floor {\n      Array::set(arr, w, e)\n      w = w + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  Array::truncate(arr, w)\n}\n\n// #724: most-recent aggregate-shape entry for `slot` — `kind*64 + n`\n// (kind 1 = tuple/arity, 2 = ctor/field count), or -1 when untracked /\n// overridden by a non-aggregate rebind.\nexport let agg_slot_lookup: (Array[Int], Int) -> Int = (arr, slot) -> {\n  let mut i = Array::length(arr) - 1\n  let mut out = 0 - 1\n  while i >= 0 {\n    let e = Array::get(arr, i)\n    if e / 256 == slot {\n      out = e % 256\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  if out == 0 {\n    0 - 1\n  } else {\n    out\n  }\n}\n\n// #724 round 2: aggregate-shape classification from a DECLARED TypeExpr —\n// the static dual of the shape log below, used for function RETURN types\n// (`let a = mk_pt(...)` — the value shape is invisible at the ELet, but the\n// callee's signature names it) and annotated params. Same `kind*64 + n`\n// encoding; n = 63 is the \"dynamic field count\" sentinel: enum-typed values\n// have a variant-dependent argc, so the comparator reads argc@4 from the\n// value at runtime instead of unrolling a static count.\nexport let agg_info_of_type_name: (CtorTable, String) -> Int = (ct, tname) -> {\n  let mut si = 0\n  let mut out = 0\n  while si < Array::length(ct.struct_names) {\n    if Array::get(ct.struct_names, si) == tname {\n      out = 128 + Array::length(Array::get(ct.struct_field_names, si))\n      si = Array::length(ct.struct_names)\n    } else {\n      si = si + 1\n    }\n  }\n  if out > 0 {\n    out\n  } else {\n    let mut ti = 0\n    let mut is_enum = false\n    while ti < Array::length(ct.type_names) {\n      if Array::get(ct.type_names, ti) == tname {\n        is_enum = true\n        ti = Array::length(ct.type_names)\n      } else {\n        ti = ti + 1\n      }\n    }\n    if is_enum {\n      128 + 63\n    } else {\n      0\n    }\n  }\n}\n\nexport let agg_info_of_type_expr: (CtorTable, TypeExpr) -> Int = (ct, te) -> {\n  match te {\n    TyTuple(tels) => 64 + Array::length(tels),\n    TyName(tname) => agg_info_of_type_name(ct, tname),\n    TyApp(tname, _) => agg_info_of_type_name(ct, tname),\n    _ => 0\n  }\n}\n\n// #724 round 2: program-wide (fn name -> aggregate return shape) table,\n// filled from each top-level `let f: (..) -> R = (..) -> {..}`'s declared\n// return type (the SLet annotation's TyFn ret, falling back to the EFn's\n// own return annotation). The `==` codegen consults it for `let a = f(..)`\n// bindings. Structural, all-lane-safe knowledge — unannotated returns stay\n// untracked (generic-eq fallback), preserving backend parity.\nexport let compute_agg_returning: (Array[Stmt], CtorTable, Array[String], Array[Int]) -> Unit = (stmts, ct, out_names, out_infos) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ann, value) => match value {\n        EFn(_, _, _, fn_ret, _, _) => {\n          let ret = match ann {\n            Some(at) => match at {\n              TyFn(_, r, _) => Some(r),\n              _ => fn_ret\n            },\n            None => fn_ret\n          }\n          match ret {\n            Some(rte) => {\n              let info = agg_info_of_type_expr(ct, rte)\n              if info > 0 {\n                Array::push(out_names, name)\n                Array::push(out_infos, info)\n              } else {\n                ()\n              }\n            },\n            None => ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nexport let agg_ret_lookup: (Array[String], Array[Int], String) -> Int = (names, infos, fname) -> {\n  let mut i = 0\n  let mut out = 0 - 1\n  while i < Array::length(names) {\n    if Array::get(names, i) == fname {\n      out = Array::get(infos, i)\n      i = Array::length(names)\n    } else {\n      i = i + 1\n    }\n  }\n  out\n}\n\n// #724: non-throwing last-match local lookup (resolve_local throws on a\n// missing name, which is wrong for OPTIONAL classification — a bare ident\n// can name a global function or ctor instead of a local).\nexport let find_local_slot: (Array[String], String) -> Int = (names, name) -> {\n  let mut i = Array::length(names) - 1\n  let mut result = 0 - 1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = 0 - 1\n    } else {\n      i = i - 1\n    }\n  }\n  result\n}\n\n// #724: aggregate-shape info for a bare-ident operand of `==`/`!=`:\n// resolves the ident's CURRENT slot and returns its latest log entry\n// (`kind*64 + n`), or -1 for non-idents / untracked slots.\nexport let agg_info_of_ident: (Array[Int], Expr, Array[String]) -> Int = (arr, e, local_names) -> {\n  match e {\n    EIdent(nm, _) => {\n      let slot = find_local_slot(local_names, nm)\n      if slot >= 0 {\n        agg_slot_lookup(arr, slot)\n      } else {\n        0 - 1\n      }\n    },\n    _ => 0 - 1\n  }\n}\n\nexport let is_efn: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pint: (Pat) -> Bool = (p) -> {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pfloat: (Pat) -> Bool = (p) -> {\n  match p {\n    PFloat(_) => true,\n    _ => false\n  }\n}\n\nexport let is_slet: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let expr_tag: (Expr) -> Int = (expr) -> {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_, _) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _, _) => 8,\n    ELet(_, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EThrow(_) => 23,\n    EFn(_, _, _, _, _, _) => 24,\n    ELoop(_, _) => 25,\n    EReturn(_) => 26,\n    _ => -1\n  }\n}\n\nexport let is_pbind: (Pat) -> Bool = (p) -> {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pbool: (Pat) -> Bool = (p) -> {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pctor: (Pat) -> Bool = (p) -> {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pwild: (Pat) -> Bool = (p) -> {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\nexport let is_earray: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EArray(_) => true,\n    _ => false\n  }\n}\n\nexport let is_eident: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EIdent(_, _) => true,\n    _ => false\n  }\n}\n\nexport let is_etuple: (Expr) -> Bool = (expr) -> {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\nexport let is_ptuple: (Pat) -> Bool = (p) -> {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nlet op_i32_eq = 70\n\nlet op_i32_ne = 71\n\nexport let is_erecord: (Expr) -> Bool = (expr) -> {\n  match expr {\n    ERecord(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pstring: (Pat) -> Bool = (p) -> {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nlet op_i32_eqz = 69\n\nlet op_i32_mul = 108\n\nlet op_i32_sub = 107\n\nexport let emit_i32_eq: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport let emit_i32_ne: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_ne)\n}\n\nexport let get_arm_pat: ((Pat, Expr)) -> Pat = (arm) -> {\n  let (p, _) = arm\n  p\n}\n\nexport let rec lookup_ctor: (Array[String], String, Int) -> Int = (ctor_names, name, i) -> {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if Array::get(ctor_names, i) == name {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\n// #722: candidates for a NAME-based struct field access. Returns\n// (ctor_tag, field_idx) for every struct whose field list contains `field`,\n// in struct-declaration order. Field resolution used to take the FIRST\n// struct containing the name (type-blind), so a same-named field living at\n// a DIFFERENT slot in a later struct silently read the wrong slot — which\n// program shapes hit this depended on the declaration set/order, i.e. the\n// flat-bundle vs FS-linked lane divergence observed in #722. Callers keep\n// the first candidate as the static fast path when every candidate agrees\n// on the slot, and otherwise dispatch at runtime on the value's ctor tag\n// (struct construction — both the `S::{...}` ctor path and the set-matched\n// bare-record path — stamps the struct's unique tag at value+0).\nexport let struct_field_candidates: (CtorTable, String) -> Array[(Int, Int)] = (ct, field) -> {\n  let out = Array::slice([\n    (0, 0)\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(ct.struct_names) {\n    let fnames = Array::get(ct.struct_field_names, si)\n    let mut fi = 0\n    while fi < Array::length(fnames) {\n      if Array::get(fnames, fi) == field {\n        let ci = lookup_ctor(ct.names, Array::get(ct.struct_names, si), 0)\n        let tag = if ci >= 0 {\n          Array::get(ct.tags, ci)\n        } else {\n          -1\n        }\n        Array::push(out, (tag, fi))\n        fi = Array::length(fnames)\n      } else {\n        fi = fi + 1\n      }\n    }\n    si = si + 1\n  }\n  out\n}\n\n// #722: the subset of `candidates` (beyond the first) whose slot index\n// DISAGREES with the first candidate's — exactly the cases the static\n// first-match resolution used to miscompile. Empty result = the static\n// fast path is sound; non-empty = the caller must emit a runtime tag\n// dispatch over these, with candidate 0 as the untagged/legacy fallback.\nexport let struct_field_dispatch_cases: (Array[(Int, Int)]) -> Array[(Int, Int)] = (cands) -> {\n  let (_, idx0) = Array::get(cands, 0)\n  let out = Array::slice([\n    (0, 0)\n  ], 0, 0)\n  let mut i = 1\n  while i < Array::length(cands) {\n    let (tag_i, idx_i) = Array::get(cands, i)\n    if idx_i != idx0 && tag_i >= 0 {\n      Array::push(out, (tag_i, idx_i))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// #722: resolve a bare record literal to a struct by exact field-name-set\n// match (the same rule the checker uses — `S::{...}` drops the name at\n// parse time in some construction paths, and hand-built ASTs build ERecord\n// directly). Returns the struct index or -1. Callers use it to lay the\n// record out in the struct's DECLARED field order and stamp the struct's\n// ctor tag, making bare records byte-compatible with `S::{...}` ctor-path\n// construction (which already reorders to declared order).\nexport let struct_index_by_field_set: (CtorTable, Array[String]) -> Int = (ct, lit_names) -> {\n  let mut si = 0\n  let mut found = -1\n  while si < Array::length(ct.struct_names) {\n    let fnames = Array::get(ct.struct_field_names, si)\n    if Array::length(fnames) == Array::length(lit_names) {\n      let mut all = true\n      let mut fi = 0\n      while fi < Array::length(fnames) {\n        let dn = Array::get(fnames, fi)\n        let mut present = false\n        let mut li = 0\n        while li < Array::length(lit_names) {\n          if Array::get(lit_names, li) == dn {\n            present = true\n            li = Array::length(lit_names)\n          } else {\n            li = li + 1\n          }\n        }\n        if present {\n          fi = fi + 1\n        } else {\n          all = false\n          fi = Array::length(fnames)\n        }\n      }\n      if all {\n        found = si\n        si = Array::length(ct.struct_names)\n      } else {\n        si = si + 1\n      }\n    } else {\n      si = si + 1\n    }\n  }\n  found\n}\n\n// #722: ctor tag for struct index `si`, or 0 (the legacy anonymous-record\n// type id) when the struct is not in the ctor table.\nexport let struct_tag_by_index: (CtorTable, Int) -> Int = (ct, si) -> {\n  let ci = lookup_ctor(ct.names, Array::get(ct.struct_names, si), 0)\n  if ci >= 0 {\n    Array::get(ct.tags, ci)\n  } else {\n    0\n  }\n}\n\nlet op_i32_ge_u = 79\n\nlet op_i32_gt_u = 75\n\nlet op_i64_load = 41\n\nexport let emit_i32_eqz: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_eqz)\n}\n\nexport let emit_i32_mul: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_mul)\n}\n\nexport let emit_i32_sub: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_sub)\n}\n\nexport let emit_str_ref: (Bytes, Int, Int) -> Unit = (buf, offset, length) -> {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\nexport let get_arm_body: ((Pat, Expr)) -> Expr = (arm) -> {\n  let (_, b) = arm\n  b\n}\n\nexport let get_efn_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eif_cond: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_else: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_then: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_elet_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELet(_, val, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let is_ctor_call: (Expr, CtorTable) -> Bool = (value, ct) -> {\n  match value {\n    ECall(callee, _, _) => match callee {\n      EIdent(nm, _) => lookup_ctor(ct.names, nm, 0) >= 0,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nlet op_i64_store = 55\n\nexport let resolve_func: (FuncTable, String) -> (Int, Int, Int) with { Error } = (ft, name) -> {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(ft.names, i) == name {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\nexport let emit_binop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else if op == \"&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"|\" {\n    emit_i64_or(buf)\n  }\n  else if op == \"^\" {\n    emit_i64_xor(buf)\n  }\n  else if op == \"<<\" {\n    emit_i64_shl(buf)\n  }\n  else if op == \">>\" {\n    emit_i64_shr_s(buf)\n  }\n  else if op == \"==\" {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"!=\" {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<\" {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">\" {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<=\" {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">=\" {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"&&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"||\" {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport let emit_i32_ge_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_ge_u)\n}\n\nexport let emit_i32_gt_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_gt_u)\n}\n\nexport let emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, op_i64_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let get_ebinop_op: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_elet_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELet(_, _, body) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_elet_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    ELet(name, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_func_body: (Stmt) -> Expr with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport let get_slet_expr: (Stmt) -> Expr with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_name: (Stmt) -> String with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_type: (Stmt) -> Option[TypeExpr] = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, ty, _) => ty,\n    _ => None\n  }\n}\n\nexport let resolve_local: (Array[String], String, String) -> Int with { Error } = (names, name, tag) -> {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    throw(String::concat(String::concat(\"undefined variable (local): \", name), String::concat(\" @\", tag)))\n  }\n  result\n}\n\nexport let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, op_i64_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let emit_box_float: (Bytes, CompileCtx, Int, Int) -> Unit = (buf, ctx, bits_local, box_local) -> {\n  emit_local_set(buf, bits_local)\n  emit_i64_const(buf, 16)\n  emit_call(buf, ctx.rc_alloc_func_idx)\n  emit_local_set(buf, box_local)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 16)\n  emit_i32_store(buf, 2, 0)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 1)\n  emit_i32_store(buf, 2, 4)\n  emit_local_get(buf, box_local)\n  emit_i32_wrap_i64(buf)\n  emit_local_get(buf, bits_local)\n  emit_i64_store(buf, 3, 8)\n  emit_local_get(buf, box_local)\n  emit_i64_const(buf, 8)\n  emit_i64_add(buf)\n  emit_i64_const(buf, 1)\n  emit_i64_or(buf)\n}\n\nexport let find_func_stmt: (Array[Stmt], String) -> Stmt with { Error } = (stmts, name) -> {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if sname == name {\n        found = i\n        i = len\n      },\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n\nexport let emit_unbox_float: (Bytes) -> Unit = (buf) -> {\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i64_load(buf, 3, 0)\n}\n\n// Push the i64 increment that advances an array INDEX counter by ONE LOGICAL\n// element. Under RC a scalar Int is tagged `n << 1`, and the inline array loops\n// compare their counter against `Array::length` (which returns a tagged length)\n// and feed it to `Array::get` (which untags the index). So the counter must\n// live in tagged space too — stepping by raw 2 (= logical 1). Without RC the\n// counter is a raw index and steps by 1. Using a raw 1 under RC makes the loop\n// run twice per element (each read/processed twice; #704).\nexport let emit_index_one: (Bytes, CompileCtx) -> Unit = (buf, ctx) -> {\n  if ctx.enable_rc {\n    emit_i64_const(buf, 2)\n  } else {\n    emit_i64_const(buf, 1)\n  }\n}\n\n// Guarded rc_dup of the heap value in `local_idx` (no-op for scalars/strings):\n// if it is odd (a heap pointer) with a zero high word (not a string fat\n// pointer), increment its rc_count at block-4. The single canonical copy — the\n// codegen files (compile_expr_tail / _tail4 / _tail6 / compile_match /\n// compile_lambda / compile_call / linked_compile) call this instead of keeping\n// per-file duplicates.\n// #715 recurrence guard: base address of the shadow-liveness byte table\n// (1 byte per heap address at base+vptr) and the reservation pad that keeps\n// it inside linear memory. Only referenced when compiling with rc_shadow.\nexport let rc_shadow_base: () -> Int = () -> {\n  268435456\n}\n\nexport let rc_shadow_reserve: () -> Int = () -> {\n  536870912\n}\n\n// #720: the rc field is the LOW 24 BITS of the rc word (the class id lives in\n// the high byte of the same word at vptr-1). A raw `store(load(addr)+1)` at\n// rc == 0xFFFFFF carries into the class byte and wraps rc to 0 -- a couple of\n// rc ops later the block frees itself with millions of references still\n// outstanding. Hot shared structures (func/ctor tables, analysis accumulator\n// arrays) cross 2^24 refs only on large compiles (the entry-dup budgets leak\n// by design), which made the corruption look layout- and size-dependent.\n// Saturate instead: once rc hits 0xFFFFFF the block is immortal (never\n// incremented, never decremented, never freed -- see gen_rc_drop_body's\n// matching skip). `push_addr` emits the i32 address of the rc word; it is\n// invoked up to three times, so it must be a pure push.\nexport let emit_rc_word_inc_saturating: (Bytes, () -> Unit) -> Unit = (buf, push_addr) -> {\n  push_addr()\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 16777215)\n  // i32.and (0x71) -- no emit_i32_and helper exists\n  bytebuf_push(buf, 113)\n  emit_i32_const(buf, 16777215)\n  emit_i32_ne(buf)\n  emit_if_void(buf)\n  push_addr()\n  push_addr()\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n}\n\nexport let emit_rc_dup_guarded: (Bytes, Int, Bool) -> Unit = (buf, local_idx, rc_shadow) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  // #715 recurrence guard (VIBE_RC=shadow): trap via `unreachable` if the\n  // shadow byte at RC_SHADOW_BASE+vptr says this block was already freed --\n  // a dup-of-freed would otherwise increment the free-list NEXT link.\n  if rc_shadow {\n    emit_local_get(buf, local_idx)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, rc_shadow_base())\n    emit_i32_add(buf)\n    emit_i32_load8_u(buf, 0, 0)\n    emit_if_void(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n  } else {\n    ()\n  }\n  emit_rc_word_inc_saturating(buf, () -> {\n    emit_local_get(buf, local_idx)\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, 4)\n    emit_i32_sub(buf)\n  })\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport let fn_type_param_types: (Option[TypeExpr]) -> Option[Array[TypeExpr]] = (ty) -> {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(args, _, _) => Some(args),\n      _ => None\n    },\n    None => None\n  }\n}\n\nexport let is_nullary_ctor_ident: (Expr, CtorTable) -> Bool = (value, ct) -> {\n  match value {\n    EIdent(nm, _) => lookup_ctor(ct.names, nm, 0) >= 0,\n    _ => false\n  }\n}\n\nexport let name_has_effect_prefix: (String, String) -> Bool = (full, eff) -> {\n  let el = String::length(eff)\n  let fl = String::length(full)\n  if fl < el + 2 {\n    false\n  } else {\n    let mut ok = true\n    let mut j = 0\n    while j < el {\n      if String::char_code_at(full, j) != String::char_code_at(eff, j) {\n        ok = false\n        j = el\n      } else {\n        j = j + 1\n      }\n    }\n    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58\n  }\n}\n\nexport let effect_name_to_tag: (Array[String], String) -> Int = (effect_names, full) -> {\n  let n = Array::length(effect_names)\n  let mut result = 3 + n\n  let mut i = 0\n  while i < n {\n    if name_has_effect_prefix(full, Array::get(effect_names, i)) {\n      result = 3 + i\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport let effect_op_declared_arity: (Array[String], Array[Int], String) -> Int = (keys, arities, full) -> {\n  let n = Array::length(keys)\n  let mut result = -1\n  let mut i = 0\n  while i < n {\n    if Array::get(keys, i) == full {\n      result = Array::get(arities, i)\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// #665: index of a qualified op key (`Eff::Op`) in the global effect_op_keys\n// table — the operation discriminant for multi-operation handler dispatch.\nexport let effect_op_index: (Array[String], String) -> Int = (keys, full) -> {\n  let n = Array::length(keys)\n  let mut result = 0 - 1\n  let mut i = 0\n  while i < n {\n    if Array::get(keys, i) == full {\n      result = i\n      i = n\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport let emit_heap_grow_after_heap_set: (Bytes, CompileCtx) -> Unit = (buf, ctx) -> {\n  if ctx.heap_grow_check_func_idx >= 0 {\n    emit_call(buf, ctx.heap_grow_check_func_idx)\n  } else {\n    ()\n  }\n}\n")
}

let cli_adapter_source_61 = () -> (String, String) {
  ("vibe/compiler/codegen/common_extractors/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\n}\n\nlet op_prefix = 252\n\n//# Functions\n\n// Interior-line breakpoints (span-arc step5): return the first available source\n// char-offset for `e`, walking into the most-representative child until an\n// offset-carrying node is found, or -1 if none. EIdent/ECall/EDot carry real\n// char-offsets; for ECall/EDot prefer the node's own offset, else recurse into\n// the callee/base. A statement's offset is thus derived from its VALUE\n// subexpression. Flat single match, tail-recursive into one child per arm.\nexport let rec first_offset: (Expr) -> Int = (e) -> {\n  match e {\n    EIdent(_, off) => off,\n    ECall(callee, _, off) => if off >= 0 { off } else { first_offset(callee) },\n    EDot(base, _, off) => if off >= 0 { off } else { first_offset(base) },\n    EBinOp(_, lhs, _) => first_offset(lhs),\n    EUnaryOp(_, inner) => first_offset(inner),\n    ELet(_, val, _) => first_offset(val),\n    ELetRec(_, val, _) => first_offset(val),\n    ELetMut(_, val, _) => first_offset(val),\n    EAssign(_, val, _) => first_offset(val),\n    EAssignOp(_, _, val, _) => first_offset(val),\n    ESeq(first, _) => first_offset(first),\n    EIf(cond, _, _) => first_offset(cond),\n    EMatch(scrut, _) => first_offset(scrut),\n    EThrow(inner) => first_offset(inner),\n    EReturn(inner) => first_offset(inner),\n    _ => -1\n  }\n}\n\n// Interior-line breakpoints: convert a 0-based source char-offset to a 1-based\n// line number using a sorted array of newline char-offsets: line = 1 + (count of\n// newline offsets strictly less than `off`). Linear scan (programs are small).\nexport let offset_to_line: (Array[Int], Int) -> Int = (nl, off) -> {\n  let n = Array::length(nl)\n  let mut i = 0\n  let mut count = 0\n  while i < n {\n    if Array::get(nl, i) < off {\n      count = count + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  count + 1\n}\n\n// Interior-line breakpoints: build a sorted array of the char-offsets of each\n// '\\n' in `src`. Empty when `src` is empty.\nexport let build_newline_offsets: (String) -> Array[Int] = (src) -> {\n  let arr = Array::slice([\n    0\n  ], 0, 0)\n  let n = String::length(src)\n  let mut i = 0\n  while i < n {\n    if String::char_code_at(src, i) == 10 {\n      Array::push(arr, i)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  arr\n}\n\nexport let get_ebinop_lhs: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ebinop_rhs: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ecall_args: (Expr) -> Array[Expr] with { Error } = (expr) -> {\n  match expr {\n    ECall(_, args, _) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efn_params: (Expr) -> Array[(String, Option[TypeExpr])] with { Error } = (expr) -> {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eint_value: (Expr) -> Int with { Error } = (expr) -> {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport let get_eseq_first: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\n// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_arms: (Expr) -> Array[(Pat, Expr)] with { Error } = (expr) -> {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\n// Extract name from PBind\nexport let get_pbind_name: (Pat) -> String with { Error } = (p) -> {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport let get_pctor_args: (Pat) -> Array[Pat] with { Error } = (p) -> {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\n// Extract PCtor name and args\nexport let get_pctor_name: (Pat) -> String with { Error } = (p) -> {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\n// Extract PInt value\nexport let get_pint_value: (Pat) -> Int with { Error } = (p) -> {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport let get_pfloat_value: (Pat) -> Double with { Error } = (p) -> {\n  match p {\n    PFloat(v) => v,\n    _ => throw(\"get_pfloat_value: not a PFloat\")\n  }\n}\n\nexport let get_eassign_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_ebool_value: (Expr) -> Bool with { Error } = (expr) -> {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport let get_eforin_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_iter: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_index: (Expr) -> Option[String] with { Error } = (expr) -> {\n  match expr {\n    EForIn(_, index_name, _, _) => index_name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eident_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EIdent(name, _) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport let get_eletmut_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetMut(_, val, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eseq_second: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport let get_ereturn_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EReturn(e) => e,\n    _ => throw(\"not EReturn\")\n  }\n}\n\nexport let get_ethrow_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EThrow(e) => e,\n    _ => throw(\"not EThrow\")\n  }\n}\n\nexport let get_eunaryop_op: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport let get_ewhile_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport let get_ewhile_cond: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\n// Extract PBool value\nexport let get_pbool_value: (Pat) -> Bool with { Error } = (p) -> {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\n// Extract sub-patterns from PTuple\nexport let get_ptuple_pats: (Pat) -> Array[Pat] with { Error } = (p) -> {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport let get_slet_export: (Stmt) -> Bool with { Error } = (stmt) -> {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\n// Check if a pattern is unconditionally matching (catch-all)\nexport let rec is_catchall_pat: (Pat) -> Bool = (p) -> {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    PStruct(_, fields) => {\n      // A struct pattern is irrefutable (catch-all) exactly when every field\n      // sub-pattern is — a struct has a single shape, so the only thing that can\n      // make it refutable is a literal field sub-pattern. (`S::{ x, y }` binds;\n      // `S::{ x: 5 }` is refutable and needs a discriminating test instead.)\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(fields) {\n        let (_, sp) = Array::get(fields, i)\n        if !is_catchall_pat(sp) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\n// Emit WASM instruction for an assign operator (+=, -=, etc.)\nexport let emit_assignop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport let emit_memory_copy: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 10)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\nexport let get_earray_elems: (Expr) -> Array[Expr] with { Error } = (expr) -> {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport let get_eassign_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassign_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassignop_op: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_ecall_callee: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ECall(callee, _, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efloat_value: (Expr) -> Double with { Error } = (expr) -> {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport let get_eletmut_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetMut(_, _, body) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletmut_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    ELetMut(name, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eletrec_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\n// Extract elements from ETuple\nexport let get_etuple_elems: (Expr) -> Array[Expr] with { Error } = (expr) -> {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport let str_table_lookup: (Array[String], String) -> Int with { Error } = (strs, s) -> {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\n// Find the index of the first catch-all pattern in match arms\n// Returns num_arms if no catch-all found\nexport let find_catchall_idx: (Array[(Pat, Expr)]) -> Int = (arms) -> {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport let get_eassignop_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_estring_value: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport let get_eunaryop_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\n// Extract PString value\nexport let get_pstring_value: (Pat) -> String with { Error } = (p) -> {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport let array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let get_eassignop_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_eassignop_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\n// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_scrutinee: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")
}

let cli_adapter_source_62 = () -> (String, String) {
  ("vibe/compiler/codegen/common_analysis/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_and, emit_i64_const, emit_i64_eq, emit_i64_or, emit_i64_shl, emit_i64_shr_s, emit_if_void, emit_local_get, emit_local_set\n}\n\nlet op_i64_extend_i32_u = 173\n\n//# Functions\n\nlet common_analysis_fresh_string_array: () -> Array[String] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\n// Collect string literals appearing anywhere in a pattern, including inside\n// constructor / tuple / or / struct sub-patterns. #603: codegen now tests a\n// `PString` sub-pattern of a `PCtor`, so its literal must be registered in the\n// string table (previously only top-level `PString` arms were collected).\nlet rec collect_strings_pat: (Pat, Array[String]) -> Int = (pat, out) -> {\n  match pat {\n    PString(s) => {\n      let mut pf = false\n      let mut pi = 0\n      while pi < Array::length(out) {\n        if Array::get(out, pi) == s {\n          pf = true\n        }\n        pi = pi + 1\n      }\n      if !pf {\n        Array::push(out, s)\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_strings_pat(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        let _ = collect_strings_pat(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      let _ = collect_strings_pat(l, out)\n      let _ = collect_strings_pat(r, out)\n      0\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        let _ = collect_strings_pat(fp, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport let rec collect_strings_expr: (Expr, Array[String]) -> Int = (expr, out) -> {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args, _) => {\n      collect_strings_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        let _ = collect_strings_pat(pat, out)\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EThrow(msg) => collect_strings_expr(msg, out),\n    EReturn(msg) => collect_strings_expr(msg, out),\n    EStringInterp(parts) => {\n      let mut si_p = 0\n      while si_p < Array::length(parts) {\n        if si_p % 2 == 0 {\n          let part = Array::get(parts, si_p)\n          if String::length(part) > 0 {\n            let mut found = false\n            let mut fi2 = 0\n            while fi2 < Array::length(out) {\n              if Array::get(out, fi2) == part { found = true }\n              fi2 = fi2 + 1\n            }\n            if !found { Array::push(out, part) }\n          }\n        }\n        si_p = si_p + 1\n      }\n      0\n    },\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut mi = 0\n      while mi < Array::length(fields) {\n        let (key, val) = Array::get(fields, mi)\n        let mut kf = false\n        let mut ki = 0\n        while ki < Array::length(out) {\n          if Array::get(out, ki) == key { kf = true }\n          ki = ki + 1\n        }\n        if !kf { Array::push(out, key) }\n        collect_strings_expr(val, out)\n        mi = mi + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_strings_expr(fval, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EDot(obj, _, _) => collect_strings_expr(obj, out),\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\n    _ => 0\n  }\n}\n\n// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\nexport let get_func_param_names: (Stmt) -> Array[String] with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = common_analysis_fresh_string_array()\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          // Strip labeled/optional markers from param names\n          let plen2 = String::length(pname)\n          let clean_name = if plen2 > 0 {\n            let last_char = String::char_code_at(pname, plen2 - 1)\n            if last_char == '~' || last_char == '?' {\n              pname[0:plen2 - 1]\n            } else pname\n          } else pname\n          Array::push(names, clean_name)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\n// #721: does the program reference the exception machinery anywhere? EThrow\n// compiles to `throw 2`, EHandle to try_table over tags 0-3, and effect op\n// performs to `throw <eff_tag>` (guarded separately by the effect declaration\n// list). When NONE of these appear, the tag section and the \"error\" tag\n// export can be omitted entirely -- V8 runs exnref-bearing modules on a\n// slower path, costing pure-compute code ~35% (fib(38): 0.32s with tags vs\n// 0.20s without; wasmtime shows parity, so it is engine behavior, not\n// codegen). Conservative: any EThrow/EHandle at ANY nesting depth counts.\nexport let rec expr_contains_exceptions: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EThrow(_) => true,\n    EHandle(_, _) => true,\n    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),\n    EUnaryOp(_, operand) => expr_contains_exceptions(operand),\n    EIf(cond, then_e, else_e) =>\n    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),\n    ECall(callee, args, _) => {\n      // A bare `resume(..)` call compiles to `throw 1` (continuation resume)\n      // even without a surrounding EHandle in this expression -- a resume\n      // misused outside a handler must still produce a VALID module. A user\n      // function actually named `resume` merely keeps the tags (harmless\n      // over-approximation).\n      let mut found = match callee {\n        EIdent(cname, _) => cname == \"resume\",\n        _ => expr_contains_exceptions(callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ELetMut(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\n    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),\n    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),\n    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(body)\n      while i < Array::length(params) {\n        let (_, iv) = Array::get(params, i)\n        if expr_contains_exceptions(iv) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrut, arms) => {\n      let mut i = 0\n      let mut found = expr_contains_exceptions(scrut)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_contains_exceptions(arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_contains_exceptions(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_contains_exceptions(fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _) => expr_contains_exceptions(obj),\n    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),\n    EReturn(inner) => expr_contains_exceptions(inner),\n    ESpread(inner) => expr_contains_exceptions(inner),\n    EBreak(opt) => match opt {\n      Some(inner) => expr_contains_exceptions(inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_contains_exceptions(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\nexport let rec stmts_contain_exceptions: (Array[Stmt]) -> Bool = (stmts) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SLetPat(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SExpr(expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      STest(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SBench(_, expr) => if expr_contains_exceptions(expr) {\n        found = true\n      } else {\n        ()\n      },\n      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {\n        found = true\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport let collect_strings_stmts: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out = common_analysis_fresh_string_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let emit_i64_extend_i32_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_extend_i32_u)\n}\n\n// Resolve closure/fn value tag and fill slot_local/env_local\n// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\nexport let emit_closure_resolve: (Bytes, Int, Int, Int) -> Unit = (buf, fn_val_local, slot_local, env_local) -> {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  // Bare fn: table_slot = fn_val >> 2, env = 0\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\n// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\nexport let emit_closure_call_tail: (Bytes, Int, Int, Int, Int) -> Unit = (buf, env_local, slot_local, closure_type_base, num_args) -> {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nlet rec collect_pattern_bindings: (Pat, Array[String]) -> Int = (pat, bindings) -> {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        collect_pattern_bindings(fpat, bindings)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n// Inlined async builtins (docs/spec/wasi-p3-async.md) are lowered directly by\n// compile_call rather than living in the func table, so — like operators — they\n// must never be treated as free variables when they appear inside a nested\n// lambda body. Otherwise a thunk such as `() -> { Task::join(t) }` would capture\n// `Task::join` as a closure value and mis-lower the call as an indirect apply.\nlet is_inlined_async_builtin: (String) -> Bool = (name) -> {\n  name == \"await\" || name == \"Future::ready\" || name == \"Task::spawn\" || name == \"Task::join\" || name == \"Task::cancel\" || name == \"Task::race\" || name == \"Task::timeout\" || name == \"Stream::empty\" || name == \"Stream::once\" || name == \"Stream::map\" || name == \"Stream::filter\" || name == \"Stream::fold\" || name == \"Stream::next\" || name == \"String::to_bytes\" || name == \"Stream::to_string\"\n}\n\n// Stack-based free variable analysis: uses in-place push/truncate on bound array\n// to avoid O(n) array copies at every scope boundary. This dramatically reduces\n// heap allocation during meta-circular self-compilation.\nexport let rec collect_free_vars_expr: (Expr, Array[String], Array[String], Array[String]) -> Int = (expr, bound, fn_names, out) -> {\n  match expr {\n    EIdent(name, _) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(fn_names, name) {\n      0\n    }\n    else if is_inlined_async_builtin(name) {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    },\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\n    },\n    ECall(callee, args, _) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(name, value, body) => {\n      // The assignment TARGET is a variable reference too: a lambda whose only\n      // use of an outer `let mut` is `x = 1` (no read) must still capture it —\n      // previously only value/body mentions were collected, so `count += 1` /\n      // write-only assigns in closures failed codegen with\n      // \"undefined variable (local): count\" (and is_mut_captured_in, which\n      // rides this collector, never promoted the cell).\n      if array_contains_str(bound, name) || array_contains_str(fn_names, name) || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EAssignOp(name, _, value, body) => {\n      if array_contains_str(bound, name) || array_contains_str(fn_names, name) || array_contains_str(out, name) {\n        0\n      } else {\n        Array::push(out, name)\n        0\n      }\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname_raw, _) = Array::get(params, pi)\n        let pnl = String::length(pname_raw)\n        let pname = if pnl > 0 {\n          let plc = String::char_code_at(pname_raw, pnl - 1)\n          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw\n        } else pname_raw\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EReturn(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport let collect_free_vars: (Expr, Array[String], Array[String]) -> Array[String] = (body, param_names, fn_names) -> {\n  let out = common_analysis_fresh_string_array()\n  // Make a mutable copy of param_names for stack-based push/truncate\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr(body, bound, fn_names, out)\n  out\n}\n\n// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or\n// \"\" if `e` is not a projection. (ADR-0055 Stage 4: shared with compile_expr_tail\n// so function-tail param drops can detect an escaping projection of a param.)\nexport let rec proj_root_ident: (Expr) -> String = (e) -> {\n  match e {\n    EDot(obj, _, _) => proj_root_ident(obj),\n    EIdent(nm, _) => nm,\n    _ => \"\"\n  }\n}\n\n// If the *tail* (result) expression of a scope is a projection chain, return its\n// root identifier; otherwise \"\". Follows let/seq/assign wrappers to the tail.\nexport let rec scope_tail_proj_root: (Expr) -> String = (e) -> {\n  match e {\n    ELet(_, _, b) => scope_tail_proj_root(b),\n    ELetMut(_, _, b) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _, _) => proj_root_ident(obj),\n    _ => \"\"\n  }\n}\n\n// Check if a mutable variable is captured by any nested EFn in the given expression\nexport let rec is_mut_captured_in: (Expr, String) -> Bool = (expr, name) -> {\n  match expr {\n    EIdent(_, _) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetMut(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, params, _, _, fn_body) => {\n      // Check if name is shadowed by params\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        // Check if name is free in this EFn\n        let param_names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\n          \"\"\n        ], 0, 0))\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          // Also check recursively for deeper nesting\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EThrow(msg) => is_mut_captured_in(msg, name),\n    EReturn(msg) => is_mut_captured_in(msg, name),\n    // #629 step 2: forms that carry sub-expressions which may hold a capturing\n    // closure. Previously these fell through to `_ => false`, so a mut captured\n    // by a closure INSIDE a struct/record literal, handler, loop, projection,\n    // labeled argument, map literal, or spread was not detected — the cell was\n    // left a stack-local and the closure captured it by value (snapshot),\n    // silently losing the shared mutation. Recursing here is always sound\n    // (over-detection only boxes more).\n    ERecord(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if is_mut_captured_in(fval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(entries) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(entries) {\n        let (_, mval) = Array::get(entries, i)\n        if is_mut_captured_in(mval, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EHandle(body, arms) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => if is_mut_captured_in(body, name) {\n      true\n    } else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if is_mut_captured_in(init, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EDot(obj, _, _) => is_mut_captured_in(obj, name),\n    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),\n    ESpread(inner) => is_mut_captured_in(inner, name),\n    _ => false\n  }\n}\n\n// Region-lifetime decision for a `let mut name` cell (#629 region inference).\n// Returns true when the cell must be heap-boxed because its region lifetime can\n// extend beyond the binding block (a capturing closure may escape); false keeps\n// it a plain stack-local (region = lexical block). Both backends gate boxing on\n// this single predicate (linear compile_expr_tail / wasm-gc backend_expr).\n//\n// Step 1 baseline: a mut captured by ANY nested closure is conservatively\n// treated as escaping — identical to the prior `is_mut_captured_in` gate, so\n// behavior is unchanged. Later steps refine this into a real escape analysis\n// (a capture whose closure provably cannot escape its binding scope stays\n// stack-local). The predicate stays conservative: when escape cannot be ruled\n// out it returns true (box), which is always sound.\nexport let mut_needs_ref_cell: (Expr, String) -> Bool = (body, name) -> {\n  is_mut_captured_in(body, name)\n}\n\n// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept\n// in sync with is_borrow_arg0_call in perceus/index.vibe.\nexport let md_is_borrow_arg0_call: (String) -> Bool = (f) -> {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::set\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\nlet md_max: (Int, Int) -> Int = (a, b) -> {\n  if a > b { a } else { b }\n}\n\n// How many times is `name` consumed (owning position) along the LONGEST control\n// path of `e`? Used to balance the rc of a value that is referenced but NOT\n// owned at its definition site — a matched ctor field (a borrowed view sharing\n// the scrutinee's refcount; compile_match) or a captured free variable (a\n// borrowed view of the defining scope's binding; compile_lambda). Each owning\n// consume of such a value decrements a refcount it does not own, so the value\n// must be dup'd once PER consume or it is freed more times than dup'd -> double\n// free. Sequential children SUM; alternative children (if-branches, match/handle\n// arms) take the MAX, so the count is an upper bound on the consumes of any\n// executed path (>= actual everywhere -> never under-dup -> no double free;\n// tight on straight-line code -> no over-dup leak). MUST enumerate every Expr\n// variant (modeled on fold_expr): skipping recursion into a child could miss a\n// real consume and wrongly suppress the dup. A bare `EIdent(name)` passed as\n// arg0 of a borrow-arg0 builtin does not consume (it is read in place).\nexport let rec md_consume_count: (Expr, String) -> Int = (e, name) -> {\n  match e {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(n, _) => if n == name { 1 } else { 0 },\n    ETuple(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_consume_count(Array::get(items, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    EArray(items) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(items) {\n        acc = acc + md_consume_count(Array::get(items, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    ERecord(fields) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EMap(fields) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, v) = Array::get(fields, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EIf(c, t, el) =>\n    md_consume_count(c, name) + md_max(md_consume_count(t, name), md_consume_count(el, name)),\n    ELet(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ELetRec(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ELetMut(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    EAssign(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    EAssignOp(_, _, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\n    ESeq(a, b) => md_consume_count(a, name) + md_consume_count(b, name),\n    EMatch(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_consume_count(v, name))\n        i = i + 1\n      }\n      // A bare `match name { .. }` BORROWS the scrutinee (its fields become\n      // borrowed views reclaimed by the owner's recursive drop); it does not\n      // consume `name`. Counting it as a consume would over-dup a re-matched\n      // borrowed tail (e.g. deeply-nested `match restN`), leaking/corrupting\n      // the chain. A non-ident scrutinee may still consume `name` in a\n      // sub-expression, so recurse there.\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(s, name)\n      }\n      scr + mx\n    },\n    EHandle(s, arms) => {\n      let mut mx = 0\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (_, v) = Array::get(arms, i)\n        mx = md_max(mx, md_consume_count(v, name))\n        i = i + 1\n      }\n      let scr = match s {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(s, name)\n      }\n      scr + mx\n    },\n    EWhile(c, b) => md_consume_count(c, name) + md_consume_count(b, name),\n    ELoop(params, b) => {\n      let mut acc = md_consume_count(b, name)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, v) = Array::get(params, i)\n        acc = acc + md_consume_count(v, name)\n        i = i + 1\n      }\n      acc\n    },\n    EForIn(_, _, it, b) => md_consume_count(it, name) + md_consume_count(b, name),\n    ECall(callee, args, _) => {\n      let borrow0 = match callee {\n        EIdent(f, _) => md_is_borrow_arg0_call(f),\n        _ => false\n      }\n      let start = if borrow0 && Array::length(args) >= 1 {\n        1\n      } else {\n        0\n      }\n      let head = if start == 1 {\n        match Array::get(args, 0) {\n          EIdent(_, _) => 0,\n          _ => md_consume_count(Array::get(args, 0), name)\n        }\n      } else {\n        0\n      }\n      // A bare-ident CALLEE is invoked, not consumed — calling a function or a\n      // captured closure (incl. a recursive closure's own self-reference) does\n      // not drop it. Counting `f(..)` as a consume of `f` over-dups the captured\n      // closure once per call (#705: a nested self-recursive closure's self-\n      // capture corrupted under RC). Only a non-ident callee can consume `name`\n      // in a sub-expression.\n      let callee_c = match callee {\n        EIdent(_, _) => 0,\n        _ => md_consume_count(callee, name)\n      }\n      let mut acc = callee_c + head\n      let mut ri = start\n      while ri < Array::length(args) {\n        acc = acc + md_consume_count(Array::get(args, ri), name)\n        ri = ri + 1\n      }\n      acc\n    },\n    EBinOp(_, l, r) => md_consume_count(l, name) + md_consume_count(r, name),\n    EUnaryOp(_, x) => md_consume_count(x, name),\n    EFn(_, _, _, _, _, body) => md_consume_count(body, name),\n    EDot(x, _, _) => md_consume_count(x, name),\n    ELabeledArg(_, _, v) => md_consume_count(v, name),\n    EThrow(x) => md_consume_count(x, name),\n    EReturn(x) => md_consume_count(x, name),\n    EBreak(opt) => match opt {\n      Some(v) => md_consume_count(v, name),\n      None => 0\n    },\n    EContinue(args) => {\n      let mut acc = 0\n      let mut i = 0\n      while i < Array::length(args) {\n        acc = acc + md_consume_count(Array::get(args, i), name)\n        i = i + 1\n      }\n      acc\n    },\n    ESpread(x) => md_consume_count(x, name)\n  }\n}\n")
}

let cli_adapter_source_63 = () -> (String, String) {
  ("vibe/compiler/perceus/index.vibe",
"//# Imports\n\nimport .. / codegen / common_analysis {\n  collect_free_vars\n}\n\nimport .. / core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Types\n\nexport enum PerceusActionKind {\n  PaDup;\n  PaDrop;\n  // A `dup` attributed to an *alias* binding `let a = t`: the source `t` is\n  // used in more than one owning position, so this alias takes a duplicated\n  // reference. Keyed by the ALIAS name `a` (not the source), which makes it\n  // occurrence-precise without tree-order bookkeeping: the codegen dups the\n  // source exactly at `let a = …`. (docs/spec/selfhost-rc-port.md)\n  PaAliasDup\n}\n\nexport struct PerceusAction {\n  kind: PerceusActionKind;\n  name: String\n}\n\nstruct PCtx {\n  mut next_id: Int;\n  mut seq_id: Int;\n  pctx_names: Array[String];\n  uses: Array[Int];\n  borrows: Array[Int];\n  scalar: Array[Bool];\n  remaining: Array[Int];\n  actions: Array[PerceusAction]\n}\n\nstruct HeapInferCtx {\n  ctors: Array[String];\n  heap_fns: Array[String]\n}\n\n//# Functions\n\nlet zeros: (Int) -> Array[Int] = (n) -> {\n  let out: Array[Int] = [\n  ]\n  let mut i = 0\n  while i < n {\n    Array::push(out, 0)\n    i = i + 1\n  }\n  out\n}\n\nlet int_max: (Int, Int) -> Int = (a, b) -> {\n  if a > b {\n    a\n  } else {\n    b\n  }\n}\n\nlet name_in: (Array[String], String) -> Bool = (arr, s) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet pe_push: (PCtx, PerceusActionKind, String) -> Int = (ctx, kind, name) -> {\n  Array::push(ctx.actions, PerceusAction::{\n    kind: kind, name: name\n  })\n  0\n}\n\nlet pe_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    let rem = Array::get(ctx.remaining, id)\n    if rem > 1 && !Array::get(ctx.scalar, id) {\n      pe_push(ctx, PaDup, name)\n    } else {\n      0\n    }\n    if rem > 0 {\n      Array::set(ctx.remaining, id, rem - 1)\n    }\n  }\n  0\n}\n\nlet pctx_new: () -> PCtx = () -> {\n  PCtx::{\n    next_id: 0,\n    seq_id: 0,\n    pctx_names: [\n    ],\n    uses: [\n    ],\n    borrows: [\n    ],\n    scalar: [\n    ],\n    remaining: [\n    ],\n    actions: [\n    ],\n  }\n}\n\nlet copy_ints: (Array[Int]) -> Array[Int] = (src) -> {\n  let out: Array[Int] = [\n  ]\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(out, Array::get(src, i))\n    i = i + 1\n  }\n  out\n}\n\nexport let pa_is_dup: (PerceusAction) -> Bool = (a) -> {\n  match a.kind {\n    PaDup => true,\n    PaDrop => false,\n    PaAliasDup => false\n  }\n}\n\nlet rec pat_names: (Pat, Array[String]) -> Int = (pat, out) -> {\n  match pat {\n    PBind(name) => {\n      Array::push(out, name)\n      0\n    },\n    PCtor(_n, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, _r) => pat_names(l, out),\n    PStruct(_n, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pat_names((Array::get(fields, i)).1, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport let pa_is_drop: (PerceusAction) -> Bool = (a) -> {\n  match a.kind {\n    PaDrop => true,\n    PaDup => false,\n    PaAliasDup => false\n  }\n}\n\nlet pc_declare: (PCtx, String, Bool) -> Int = (ctx, name, scalar) -> {\n  let id = ctx.next_id\n  Array::push(ctx.pctx_names, name)\n  Array::push(ctx.uses, 0)\n  Array::push(ctx.borrows, 0)\n  Array::push(ctx.scalar, scalar)\n  ctx.next_id = id + 1\n  id\n}\n\nlet pe_declare: (PCtx, String) -> Int = (ctx, _name) -> {\n  let id = ctx.next_id\n  let owning = Array::get(ctx.uses, id)\n  let init = if owning == 0 {\n    1\n  } else {\n    owning\n  }\n  Array::push(ctx.remaining, init)\n  ctx.next_id = id + 1\n  id\n}\n\nlet pc_count_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\n  }\n  0\n}\n\nlet pe_scope_end: (PCtx, Int, String) -> Int = (ctx, id, name) -> {\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\n    pe_push(ctx, PaDrop, name)\n    Array::set(ctx.remaining, id, 0)\n  }\n  0\n}\n\nlet next_seq_name: (PCtx) -> String = (ctx) -> {\n  let nm = \"__seq\" + __to_string(ctx.seq_id)\n  ctx.seq_id = ctx.seq_id + 1\n  nm\n}\n\nlet fn_param_names: (Array[(String, Option[TypeExpr])]) -> Array[String] = (params) -> {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(params) {\n    Array::push(out, (Array::get(params, i)).0)\n    i = i + 1\n  }\n  out\n}\n\nlet is_v128_box_call: (String) -> Bool = (fname) -> {\n  fname == \"v128_load\" || fname == \"v128_splat_i8x16\" || fname == \"v128_eq_i8x16\" || fname == \"v128_le_u_i8x16\" || fname == \"v128_ge_u_i8x16\" || fname == \"v128_and\" || fname == \"v128_or\" || fname == \"v128_not\"\n}\n\nlet array_contains_str_pctx: (Array[String], String) -> Bool = (arr, s) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == s {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// #707: marker prefix (control char, cannot appear in a vibe identifier) used\n// to smuggle the borrow-returning-function-name set through PCtx.pctx_names\n// (a write-only \"declared binding names\" log that nothing else reads --\n// see build_perceus_plan_with_params). A genuine dedicated PCtx field for\n// this was tried and hit an unexplained \"memory access out of bounds\" reading\n// it back specifically when the whole compiler self-compiles under RC\n// (reproduces with the field's content/position/construction all varied;\n// substituting pctx_names for the same read in the same call chain does NOT\n// crash) -- see #707 for the investigation. Piggybacking on the\n// known-safe field sidesteps it.\nlet borrow_ret_marker = \"BR:\"\n\n// #707: is `fname` a call whose return value is a BORROWED VIEW sharing a\n// call argument's refcount, rather than a fresh owned reference -- either one\n// of the 3 builtins that read an element in place, or a user function whose\n// own body is (transitively) nothing but a tail-call to one of those (see\n// compute_borrow_returning_names). Bindings holding such a value must never\n// be dup/drop'd themselves: the compiler-self-hosted-under-RC crash (#707)\n// was exactly this -- `let peek = (toks, pos) -> Array::get(toks, pos)` was\n// NOT recognized as borrow-returning (only a literal `Array::get` callee\n// was), so `let __m_scrut = peek(toks, pos) in match __m_scrut { ... }`\n// (the match-scrutinee-lift's desugaring, see normalize/index.vibe\n// lift_match_scrutinees) planned a drop for `__m_scrut` as if it independently\n// owned a reference -- double-freeing the array element peek merely borrowed.\nlet is_borrow_ret_fname: (PCtx, String) -> Bool = (ctx, fname) -> {\n  fname == \"Array::get\" || fname == \"Map::get\" || fname == \"__index\" || fname == \"__rec_field\" || array_contains_str_pctx(ctx.pctx_names, String::concat(borrow_ret_marker, fname))\n}\n\n// #707: fixed-point closure over top-level function definitions, starting\n// from the 3 borrow-returning builtins: a function whose entire body is\n// (after stripping let/seq/assign wrappers) a single tail-call to an\n// already-known borrow-returning name is itself borrow-returning. Handles\n// arbitrarily deep wrapper chains (`peek` -> `Array::get`,\n// `peek2` -> `peek` -> `Array::get`, ...). Computed once over the whole\n// merged program (see linked_compile.vibe) and threaded into every\n// function's Perceus plan via build_perceus_plan_with_params.\n// #707: does every value `e` can tail-produce come from a known\n// borrow-returning name, or a \"safe to never drop\" fallback? Recurses through\n// let/seq/assign wrappers and BOTH sides of if/match (a bare tail call alone\n// missed `peek`'s actual shape: `if pos < len { Array::get(tokens, pos) }\n// else TEof` -- a bounds-check guard around the real access, with a bare\n// nullary-ctor-ish identifier as the out-of-range fallback). A bare EIdent\n// tail (e.g. a sentinel like TEof) is accepted as safe even though it isn't\n// proven borrow-returning: marking its binding \"never dup/drop\" can at worst\n// leak that one value (the existing runtime dup/drop guards already no-op on\n// non-heap-tagged values), never corrupt -- the failure mode this whole fix\n// targets is a double-free from treating a genuinely-borrowed value as owned,\n// not a leak from treating a small/rare owned value as borrowed.\n// Iterative (NOT self-recursive) worklist walk over child expressions, rather\n// than a `let rec` recursive-descent function. Also: the `ECall` case matches\n// its callee via a NESTED constructor pattern one step at a time (`ECall(e,\n// _, _)` then a separate `match e { EIdent(callee, _) => ... }`), never\n// `ECall(EIdent(callee, _), _, _)` in one pattern. Both of these are\n// load-bearing workarounds, not style: a `let rec` self-recursive version of\n// this walk, AND a single-arm version using the nested `ECall(EIdent(...),\n// _, _)` pattern, each independently reproduce a \"memory access out of\n// bounds\" trap (reproducible under bump too -- not RC-specific) that is only\n// exposed when this function runs over a derive(Ord)-generated `T::compare`\n// body (a chain of `EIf(cmp, EInt(-1/1), ...)` with no further wrapper/call\n// -- e.g. `struct P { x: Int; y: Int } derive(Ord)`). An equivalent shape\n// recursing into an `Array::get` call / `EIdent` sentinel branch (`peek`'s\n// actual body) does not crash either broken variant, and the crash persists\n// even when the offending match arm is never reached at runtime for the\n// crashing input -- so this is a codegen bug in this compiler triggered by\n// those two source *shapes*, not a logic bug in this function's checks.\n// True root cause not isolated; swap either workaround for the \"more natural\"\n// form only after confirming compute_borrow_returning_names_test.vibe (or an\n// equivalent derive(Ord) regression) still passes.\nlet tail_is_borrow_ret_safe: (Array[String], Expr) -> Bool = (known, e0) -> {\n  let worklist = [e0]\n  let mut all_safe = true\n  let mut i = 0\n  while i < Array::length(worklist) {\n    match Array::get(worklist, i) {\n      ELet(_, _, b) => Array::push(worklist, b),\n      ELetMut(_, _, b) => Array::push(worklist, b),\n      ELetRec(_, _, b) => Array::push(worklist, b),\n      ESeq(_, b) => Array::push(worklist, b),\n      EAssign(_, _, b) => Array::push(worklist, b),\n      EAssignOp(_, _, _, b) => Array::push(worklist, b),\n      EIf(_, t, el) => {\n        Array::push(worklist, t)\n        Array::push(worklist, el)\n      },\n      EMatch(_, arms) => {\n        let mut ai = 0\n        while ai < Array::length(arms) {\n          let (_p, ae) = Array::get(arms, ai)\n          Array::push(worklist, ae)\n          ai = ai + 1\n        }\n      },\n      ECall(callee_e, _, _) =>\n      match callee_e {\n        EIdent(callee, _) =>\n        if !array_contains_str_pctx(known, callee) {\n          all_safe = false\n        } else {\n          ()\n        },\n        _ => {\n          all_safe = false\n        }\n      },\n      EIdent(_, _) => (),\n      // #715: a throwing tail (the ubiquitous `match x { Ctor(..) => field, _\n      // => throw(\"not X\") }` shape used by every common_extractors.vibe\n      // accessor) never actually produces a value along that path, so it\n      // cannot violate the borrow-returning invariant -- there is nothing to\n      // mismanage. Without this, EVERY such accessor (get_efn_params,\n      // get_efn_body, get_ecall_args, ...) fell through to the catch-all\n      // below and was rejected solely because of its own error arm, even\n      // though its real (non-throwing) arm is a plain borrowed field\n      // projection. That misclassification made the caller treat the\n      // extracted field as an independently owned value while the\n      // scrutinee's own later structural drop also reclaims it -- a\n      // same-address double-free (the #715 self-hosting free-list\n      // corruption).\n      EThrow(_) => (),\n      _ => {\n        all_safe = false\n      }\n    }\n    i = i + 1\n  }\n  all_safe\n}\n\n// Strip let/seq/assign wrappers, same as tail_is_borrow_ret_safe, to find the\n// expression whose SHAPE decides eligibility at the top level.\nlet rec strip_wrappers_for_borrow_ret: (Expr) -> Expr = (e) -> {\n  match e {\n    ELet(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    ELetMut(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),\n    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),\n    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),\n    _ => e\n  }\n}\n\nexport let compute_borrow_returning_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let known: Array[String] = [\n    \"Array::get\", \"Map::get\", \"__index\", \"__rec_field\"\n  ]\n  let mut changed = true\n  while changed {\n    changed = false\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SLet(_, _, name, _, value) =>\n        if !array_contains_str_pctx(known, name) {\n          match value {\n            EFn(_, _, _, _, _, body) => {\n              // A function is borrow-returning only if its (wrapper-stripped)\n              // top-level shape is itself a call/if/match reaching a known\n              // borrow-return name on every branch -- a BARE identifier tail\n              // at the *top level* (an identity-like function) is NOT eligible\n              // here even though tail_is_borrow_ret_safe accepts a bare ident\n              // as a safe fallback *inside* an if/match branch (e.g. peek's\n              // `else TEof`). This keeps `let f = (x) -> T { x }` (a genuine\n              // passthrough of a normally-owned argument) from being\n              // misclassified as a Array::get-style borrowed view.\n              let top = strip_wrappers_for_borrow_ret(body)\n              let eligible_shape = match top {\n                ECall(_, _, _) => true,\n                EIf(_, _, _) => true,\n                EMatch(_, _) => true,\n                _ => false\n              }\n              if eligible_shape && tail_is_borrow_ret_safe(known, top) {\n                Array::push(known, name)\n                changed = true\n              } else {\n                ()\n              }\n            },\n            _ => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n  }\n  known\n}\n\n// A top-level function's declared return type, from its `let f: (T1,...) ->\n// R = ...` signature -- `None` when untyped (no signature to consult).\nlet fn_sig_return_type: (Option[TypeExpr]) -> Option[TypeExpr] = (ty) -> {\n  match ty {\n    Some(t) =>\n    match t {\n      TyFn(_, ret, _) => Some(ret),\n      _ => None\n    },\n    None => None\n  }\n}\n\n// #710 out-param crash: `let n = f(...)` for a user function `f` whose body\n// is not one of the 3 hardcoded borrow-returning builtins falls through to\n// `heap_binding_names`'s default -- \"any non-borrow-ret call result is heap\"\n// (compile_expr_tail.vibe's ELet ECall branch; see that struct field's own\n// doc comment, which already promises \"we never touch a non-heap (e.g.\n// Int-returning call) binding\"). When `f` actually returns a scalar (Int/\n// Bool/Unit) -- e.g. `build_import_plan(...) -> Int` -- the binding is a\n// plain integer, not a tagged heap pointer. If that binding is later\n// ALIASED more than once (`let a = n; let b = n`), the Perceus plan schedules\n// a PaAliasDup for the 2nd+ alias, and compile_expr_tail.vibe's `is_eident`\n// branch used to call the unguarded `emit_rc_dup_local` on it: untag (AND -2)\n// then read/write 4 bytes before the \"pointer\". For a small scalar like 0\n// that computes a near-null address -- `RuntimeError: memory access out of\n// bounds`, not a leak (component_codegen_test.vibe's \"component async: sync\n// lift\" hit this via `import_func_count` aliased into run_core_func_idx/\n// run_type_idx/run_func_idx). That call site now uses the runtime-tag-checked\n// `emit_rc_dup_guarded` instead (a misclassified scalar is a silent no-op\n// there rather than a wild write) -- this was the one remaining unguarded RC\n// increment anywhere in codegen, so it is now fixed on general principle even\n// though it was empirically NOT the cause of the *other* still-open #709\n// self-hosting crash (a free-list node with corrupted size/next fields,\n// surfacing later inside `fn_type_param_types`'s `__rc_alloc`; confirmed via a\n// differential rebuild that the crash persists byte-for-byte unchanged with\n// this fix in place). Names collected here still matter for perf/precision\n// (avoiding unnecessary heap_binding_names churn) and let the ELet ECall\n// branch skip `heap_binding_names` for a call whose declared return type is\n// provably scalar, matching the exemption the field's own doc comment already\n// describes. Untyped functions are conservatively left out (stay in the\n// existing heap over-approximation) since there is no signature to consult --\n// no longer a correctness cliff-edge now that the alias-dup site is guarded,\n// only a missed optimization.\nexport let compute_scalar_returning_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, ty, value) =>\n      match value {\n        EFn(_, _, _, _, _, _) =>\n        match fn_sig_return_type(ty) {\n          Some(ret) =>\n          if !type_expr_is_heap(Some(ret)) {\n            Array::push(out, name)\n          } else {\n            ()\n          },\n          None => ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet is_scalar_expr: (PCtx, Expr) -> Bool = (ctx, e) -> {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EFloat(_) => true,\n    EUnit => true,\n    // #705: v128_load/splat/binary-op/not return a tagged pointer to a 16-byte\n    // box with NO rc header (type_id/refcount) -- see compile_call.vibe. The\n    // tag makes it look like a heap pointer to the runtime dup/drop guards\n    // (odd low bit), so planning a PaDup/PaDrop for a binding holding one would\n    // make those guards misread the v128 payload bytes as a refcount and\n    // corrupt it (or an adjacent allocation). Treat the binding as scalar\n    // (never dup/drop'd), matching the box's actual bump-only, never-freed\n    // lifetime under both backends.\n    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),\n    _ => false\n  }\n}\n\nlet pat_shadow_env: (Pat, Map[String, Bool]) -> Map[String, Bool] = (pat, env) -> {\n  let names: Array[String] = [\n  ]\n  pat_names(pat, names)\n  let mut env2 = env\n  let mut j = 0\n  while j < Array::length(names) {\n    env2 = Map::set(env2, Array::get(names, j), false)\n    j = j + 1\n  }\n  env2\n}\n\nlet restore_prefix: (Array[Int], Array[Int]) -> Int = (dst, src) -> {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::set(dst, i, Array::get(src, i))\n    i = i + 1\n  }\n  0\n}\n\nlet is_heap_literal: (Expr) -> Bool = (e) -> {\n  match e {\n    ETuple(_) => true,\n    EArray(_) => true,\n    ERecord(_) => true,\n    _ => false\n  }\n}\n\nlet is_heap_value: (Expr, Map[String, Bool], HeapInferCtx) -> Bool = (e, env, hctx) -> {\n  if is_heap_literal(e) {\n    true\n  } else {\n    match e {\n      ECall(callee, args, _) =>\n      match callee {\n        EIdent(c, _) =>\n        if Map::has_key(env, c) {\n          false\n        } else {\n          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||\n          name_in(hctx.heap_fns, c)\n        },\n        _ => false\n      },\n      _ => false\n    }\n  }\n}\n\nlet arg_class: (Expr, Map[String, Bool], HeapInferCtx) -> Bool = (arg, env, hctx) -> {\n  if is_heap_value(arg, env, hctx) {\n    true\n  } else {\n    match arg {\n      EIdent(n, _) => if Map::has_key(env, n) {\n        Map::get(env, n)\n      } else {\n        false\n      },\n      _ => false\n    }\n  }\n}\n\nlet rec analyze_calls: (String, Expr, Map[String, Bool], Array[Array[Bool]], Array[Bool], HeapInferCtx) -> Int = (name, e_in, env_in, calls, esc, hctx) -> {\n  // #556: iterate the let / seq / assign \"spine\" instead of recursing on its\n  // tail, so a deeply-nested (flattened) expression — e.g. the whole compiler\n  // compiled as a single unit under RC — no longer exhausts the wasm stack in\n  // this pass. The shallow side of each spine node is still analyzed\n  // recursively; the visit order and env threading are identical to the former\n  // pure recursion (fixpoint-verified), so the RC analysis result is unchanged.\n  let mut e = e_in\n  let mut env = env_in\n  let mut looping = true\n  while looping {\n    looping = false\n    match e {\n    EIdent(n, _) => {\n      if n == name {\n        Array::set(esc, 0, true)\n      } else {\n        ()\n      }\n      0\n    },\n    ECall(callee, args, _) => {\n      let is_self = match callee {\n        EIdent(cn, _) => cn == name,\n        _ => false\n      }\n      if is_self {\n        let cls: Array[Bool] = [\n        ]\n        let mut k = 0\n        while k < Array::length(args) {\n          Array::push(cls, arg_class(Array::get(args, k), env, hctx))\n          k = k + 1\n        }\n        Array::push(calls, cls)\n      } else {\n        let _ = analyze_calls(name, callee, env, calls, esc, hctx)\n        ()\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),\n    ELet(n, v, b) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      env = Map::set(env, n, is_heap_value(v, env, hctx))\n      e = b\n      looping = true\n    },\n    ELetRec(n, v, b) => {\n      env = Map::set(env, n, false)\n      analyze_calls(name, v, env, calls, esc, hctx)\n      e = b\n      looping = true\n    },\n    ELetMut(n, v, b) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      env = Map::set(env, n, false)\n      e = b\n      looping = true\n    },\n    EAssign(_, v, c) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      e = c\n      looping = true\n    },\n    EAssignOp(_, _, v, c) => {\n      analyze_calls(name, v, env, calls, esc, hctx)\n      e = c\n      looping = true\n    },\n    ESeq(a, b) => {\n      analyze_calls(name, a, env, calls, esc, hctx)\n      e = b\n      looping = true\n    },\n    EIf(c, t, el) => {\n      analyze_calls(name, c, env, calls, esc, hctx)\n      analyze_calls(name, t, env, calls, esc, hctx)\n      analyze_calls(name, el, env, calls, esc, hctx)\n      0\n    },\n    EWhile(c, b) => {\n      analyze_calls(name, c, env, calls, esc, hctx)\n      analyze_calls(name, b, env, calls, esc, hctx)\n      0\n    },\n    EForIn(v0, ix, it, b) => {\n      analyze_calls(name, it, env, calls, esc, hctx)\n      let env1 = Map::set(env, v0, false)\n      let env2 = match ix {\n        Some(ixn) => Map::set(env1, ixn, false),\n        None => env1\n      }\n      analyze_calls(name, b, env2, calls, esc, hctx)\n      0\n    },\n    EBinOp(_, l, r) => {\n      analyze_calls(name, l, env, calls, esc, hctx)\n      analyze_calls(name, r, env, calls, esc, hctx)\n      0\n    },\n    EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),\n    EFn(_, _, params, _, _, b) => {\n      let mut env2 = env\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, _) = Array::get(params, pi)\n        env2 = Map::set(env2, pn, false)\n        pi = pi + 1\n      }\n      analyze_calls(name, b, env2, calls, esc, hctx)\n      0\n    },\n    ETuple(xs) => {\n      let mut i = 0\n      while i < Array::length(xs) {\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EArray(xs) => {\n      let mut i = 0\n      while i < Array::length(xs) {\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(s, arms) => {\n      analyze_calls(name, s, env, calls, esc, hctx)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, ab) = Array::get(arms, i)\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(b, arms) => {\n      analyze_calls(name, b, env, calls, esc, hctx)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, ab) = Array::get(arms, i)\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    ELoop(ps, b) => {\n      let mut env2 = env\n      let mut i = 0\n      while i < Array::length(ps) {\n        let (pn, iv) = Array::get(ps, i)\n        analyze_calls(name, iv, env2, calls, esc, hctx)\n        env2 = Map::set(env2, pn, false)\n        i = i + 1\n      }\n      analyze_calls(name, b, env2, calls, esc, hctx)\n      0\n    },\n    ERecord(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fv) = Array::get(fs, i)\n        analyze_calls(name, fv, env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fv) = Array::get(fs, i)\n        analyze_calls(name, fv, env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),\n    EThrow(x) => analyze_calls(name, x, env, calls, esc, hctx),\n    EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),\n    ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),\n    EBreak(o) =>\n    match o {\n      Some(x) => analyze_calls(name, x, env, calls, esc, hctx),\n      None => 0\n    },\n    EContinue(xs) => {\n      let mut i = 0\n      while i < Array::length(xs) {\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\n        i = i + 1\n      }\n      0\n    },\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EStringInterp(_) => 0,\n    EUnit => 0\n  }\n  }\n  0\n}\n\n// An alias-attributed dup: `let a = t` where `t` is multiply-used and owned.\n// Keyed by the alias name.\nexport let pa_is_alias_dup: (PerceusAction) -> Bool = (a) -> {\n  match a.kind {\n    PaAliasDup => true,\n    PaDup => false,\n    PaDrop => false\n  }\n}\n\nlet pc_count_borrow: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\n  }\n  0\n}\n\nlet rec type_contains_fn: (TypeExpr) -> Bool = (t) -> {\n  match t {\n    TyFn(_, _, _) => true,\n    TyTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if type_contains_fn(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if type_contains_fn(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyName(_) => false,\n    TyUnit => false\n  }\n}\n\nlet all_calls_heap_at: (Int, Array[Array[Bool]]) -> Bool = (idx, calls) -> {\n  let mut ci = 0\n  let mut all_heap = true\n  while ci < Array::length(calls) {\n    let cls = Array::get(calls, ci)\n    if idx >= Array::length(cls) {\n      all_heap = false\n    } else if !Array::get(cls, idx) {\n      all_heap = false\n    } else {\n      ()\n    }\n    ci = ci + 1\n  }\n  all_heap\n}\n\nlet type_name_is_heap: (String) -> Bool = (n) -> {\n  if String::length(n) == 0 {\n    false\n  } else {\n    let c0 = String::char_code_at(n, 0)\n    if c0 < 'A' || c0 > 'Z' {\n      false\n    } else if n == \"Int\" || n == \"Bool\" || n == \"Double\" || n == \"Float\" || n == \"String\" || n == \"Bytes\" || n == \"Char\" || n == \"Unit\" || n == \"V128\" {\n      // #705: V128 is a tagged pointer to a 16-byte box (see compile_call.vibe\n      // v128_load/v128_splat_i8x16/etc), but the box has NO rc header\n      // (type_id/refcount) -- it's a bare payload written directly by\n      // v128.store. Treating it as heap would make Perceus emit __rc_dup /\n      // __rc_drop calls that misread the v128 payload bytes as a type_id and\n      // refcount, corrupting the box (or freeing arbitrary memory at the\n      // implied \"next\"/size fields). Excluding it here keeps V128 boxes exactly\n      // as they behave under the bump backend: forward-only bump allocations\n      // that are simply never reclaimed, not memory-unsafe ones.\n      false\n    } else {\n      true\n    }\n  }\n}\n\nexport let type_expr_is_heap: (Option[TypeExpr]) -> Bool = (ot) -> {\n  match ot {\n    None => false,\n    Some(t) =>\n    match t {\n      // #702: a bare function-typed binding/param is a closure — heap when it\n      // captures (an odd RC block), a scalar constant when it doesn't. Treating\n      // it as heap lets the owning function drop it (__rc_drop's odd-check makes\n      // the non-capturing constant a no-op), reclaiming capturing closures passed\n      // as arguments to higher-order fns instead of leaking them.\n      TyFn(_, _, _) => true,\n      _ =>\n      if type_contains_fn(t) {\n        false\n      } else {\n        match t {\n          TyTuple(_) => true,\n          TyApp(_, _) => true,\n          TyName(n) => type_name_is_heap(n),\n          TyFn(_, _, _) => false,\n          TyUnit => false\n        }\n      }\n    }\n  }\n}\n\nlet collect_ctor_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(_, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      SSuberror(_, _, variants) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (vn, _) = Array::get(variants, j)\n          Array::push(out, vn)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet inferred_heap_type: () -> TypeExpr = () -> {\n  TyTuple(Array::slice([\n    TyUnit\n  ], 0, 0))\n}\n\nlet fill_lambda_params: (String, Expr, Expr, HeapInferCtx) -> Expr = (name, efn, body, hctx) -> {\n  match efn {\n    EFn(tps, bounds, params, ret, eff, fnbody) => {\n      let calls: Array[Array[Bool]] = [\n      ]\n      let esc = [\n        false\n      ]\n      let env0: Map[String, Bool] = map {\n      }\n      analyze_calls(name, body, env0, calls, esc, hctx)\n      if Array::get(esc, 0) || Array::length(calls) == 0 {\n        efn\n      } else {\n        let new_params = Array::slice(params, 0, 0)\n        let mut pi = 0\n        while pi < Array::length(params) {\n          let (pname, pty) = Array::get(params, pi)\n          let filled = match pty {\n            Some(_) => (pname, pty),\n            None =>\n            if all_calls_heap_at(pi, calls) {\n              (pname, Some(inferred_heap_type()))\n            } else {\n              (pname, pty)\n            }\n          }\n          Array::push(new_params, filled)\n          pi = pi + 1\n        }\n        EFn(tps, bounds, new_params, ret, eff, fnbody)\n      }\n    },\n    _ => efn\n  }\n}\n\nlet rec elaborate_rw: (Expr, HeapInferCtx) -> Expr = (e, hctx) -> {\n  match e {\n    ELet(n, v, b) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELet(n, v3, elaborate_rw(b, hctx))\n    },\n    ELetRec(n, v, b) => {\n      let v2 = elaborate_rw(v, hctx)\n      let v3 = fill_lambda_params(n, v2, b, hctx)\n      ELetRec(n, v3, elaborate_rw(b, hctx))\n    },\n    ELetMut(n, v, b) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx)),\n    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\n    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),\n    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),\n    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),\n    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),\n    EFn(tps, bounds, params, ret, eff, fb) =>\n    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),\n    ECall(callee, args, off) => {\n      let new_args = Array::slice(args, 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))\n        i = i + 1\n      }\n      ECall(elaborate_rw(callee, hctx), new_args, off)\n    },\n    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),\n    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),\n    EDot(o, f, off) => EDot(elaborate_rw(o, hctx), f, off),\n    ETuple(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      ETuple(ys)\n    },\n    EArray(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EArray(ys)\n    },\n    EMatch(s, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EMatch(elaborate_rw(s, hctx), new_arms)\n    },\n    EHandle(b, arms) => {\n      let new_arms = Array::slice(arms, 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, ab) = Array::get(arms, i)\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\n        i = i + 1\n      }\n      EHandle(elaborate_rw(b, hctx), new_arms)\n    },\n    ELoop(ps, b) => {\n      let new_ps = Array::slice(ps, 0, 0)\n      let mut i = 0\n      while i < Array::length(ps) {\n        let (pn, iv) = Array::get(ps, i)\n        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))\n        i = i + 1\n      }\n      ELoop(new_ps, elaborate_rw(b, hctx))\n    },\n    ERecord(fs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      ERecord(new_fs)\n    },\n    EMap(fs) => {\n      let new_fs = Array::slice(fs, 0, 0)\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (fn0, fv) = Array::get(fs, i)\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\n        i = i + 1\n      }\n      EMap(new_fs)\n    },\n    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),\n    EThrow(x) => EThrow(elaborate_rw(x, hctx)),\n    EReturn(x) => EReturn(elaborate_rw(x, hctx)),\n    ESpread(x) => ESpread(elaborate_rw(x, hctx)),\n    EBreak(o) =>\n    match o {\n      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),\n      None => EBreak(None)\n    },\n    EContinue(xs) => {\n      let ys = Array::slice(xs, 0, 0)\n      let mut i = 0\n      while i < Array::length(xs) {\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\n        i = i + 1\n      }\n      EContinue(ys)\n    },\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EIdent(_, _) => e,\n    EStringInterp(_) => e,\n    EUnit => e\n  }\n}\n\nlet is_borrow_arg0_call: (String) -> Bool = (f) -> {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::set\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\nexport let rec pc_emit: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pe_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      let is_index = match callee {\n        EIdent(f, _) => is_borrow_arg0_call(f),\n        _ => false\n      }\n      match callee {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(_, _) => 0,\n            _ => pc_emit(ctx, scope, arg)\n          }\n        } else {\n          pc_emit(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _) => match obj {\n      EIdent(_, _) => 0,\n      _ => pc_emit(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body) => {\n      match value {\n        EIdent(src, _) => {\n          if Map::has_key(scope, src) {\n            let sid = Map::get(scope, src)\n            let rem = Array::get(ctx.remaining, sid)\n            if rem > 1 && !Array::get(ctx.scalar, sid) {\n              pe_push(ctx, PaAliasDup, name)\n            } else {\n              0\n            }\n            if rem > 0 {\n              Array::set(ctx.remaining, sid, rem - 1)\n            }\n          } else {\n            ()\n          }\n          0\n        },\n        _ => pc_emit(ctx, scope, value)\n      }\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetMut(name, value, body) => {\n      pc_emit(ctx, scope, value)\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetRec(name, value, body) => {\n      let id = pe_declare(ctx, name)\n      let s2 = Map::set(scope, name, id)\n      pc_emit(ctx, s2, value)\n      pc_emit(ctx, s2, body)\n      pe_scope_end(ctx, id, name)\n    },\n    EAssign(_name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_emit(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let id = pe_declare(ctx, nm)\n      pc_emit(ctx, scope, b)\n      pe_scope_end(ctx, id, nm)\n    },\n    EBinOp(_op, l, r) => {\n      pc_emit(ctx, scope, l)\n      pc_emit(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_emit(ctx, scope, cond)\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, then_e)\n      let then_rem = copy_ints(ctx.remaining)\n      restore_prefix(ctx.remaining, snap)\n      pc_emit(ctx, scope, else_e)\n      // #705: leave the MIN remaining over both branches. A binding consumed in\n      // one branch (e.g. a param threaded into a ctor in the `then`) but not the\n      // other was previously left at the `else` branch's (higher) remaining, so\n      // the scope-end drop fired on a value the taken branch already moved out —\n      // a double free. Min means a binding consumed on ANY path is not\n      // re-dropped (the non-consuming path leaks one ref, which is safe) instead\n      // of the consuming path double-freeing (crash). Prefix-only (outer ids).\n      let mut i = 0\n      while i < Array::length(snap) {\n        if Array::get(then_rem, i) < Array::get(ctx.remaining, i) {\n          Array::set(ctx.remaining, i, Array::get(then_rem, i))\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_emit(ctx, scope, cond)\n      pc_emit(ctx, scope, body)\n    },\n    EReturn(e) => pc_emit(ctx, scope, e),\n    EThrow(e) => pc_emit(ctx, scope, e),\n    ESpread(e) => pc_emit(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_emit(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pe_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_emit(ctx, scope, iterable)\n      let idv = pe_declare(ctx, value_name)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pe_declare(ctx, idx)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_emit(ctx, s3, fbody)\n      pe_scope_end(ctx, idv, value_name)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let pids: Array[Int] = [\n      ]\n      let pnames: Array[String] = [\n      ]\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_emit(ctx, scope, p.1)\n        let pid = pe_declare(ctx, p.0)\n        s = Map::set(s, p.0, pid)\n        Array::push(pids, pid)\n        Array::push(pnames, p.0)\n        i = i + 1\n      }\n      pc_emit(ctx, s, lbody)\n      let mut j = 0\n      while j < Array::length(pids) {\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n        j = j + 1\n      }\n      0\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(_, _) => 0,\n        _ => pc_emit(ctx, scope, scrut)\n      }\n      let snap = copy_ints(ctx.remaining)\n      // #705: track the MIN remaining over all arms (see EIf). An arm that\n      // consumes an outer binding (e.g. a param re-stored into a ctor) leaves it\n      // at a lower remaining; leaving the LAST arm's (higher) value made the\n      // scope-end drop double-free that binding on the arm that consumed it.\n      let minrem = copy_ints(snap)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, hbody)\n      let minrem = copy_ints(ctx.remaining)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = [\n        ]\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        let mut mi = 0\n        while mi < Array::length(snap) {\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\n          } else {\n            ()\n          }\n          mi = mi + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.remaining, minrem)\n      0\n    },\n    _ => 0\n  }\n}\n\nexport let rec pc_count: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x, _) => pc_count_use(ctx, scope, x),\n    ECall(callee, args, _) => {\n      match callee {\n        EIdent(f, _) => if is_borrow_arg0_call(f) {\n          0\n        } else {\n          pc_count_borrow(ctx, scope, f)\n        }\n        ,\n        _ => pc_count(ctx, scope, callee)\n      }\n      let is_index = match callee {\n        EIdent(f, _) => is_borrow_arg0_call(f),\n        _ => false\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),\n            _ => pc_count(ctx, scope, arg)\n          }\n        } else {\n          pc_count(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field, _) => match obj {\n      EIdent(x, _) => pc_count_borrow(ctx, scope, x),\n      _ => pc_count(ctx, scope, obj)\n    }\n    ,\n    ELet(name, value, body) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetMut(name, value, body) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetRec(name, value, body) => {\n      let id = pc_declare(ctx, name, false)\n      let s2 = Map::set(scope, name, id)\n      pc_count(ctx, s2, value)\n      pc_count(ctx, s2, body)\n    },\n    EAssign(_name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_count(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let _id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))\n      pc_count(ctx, scope, b)\n    },\n    EBinOp(_op, l, r) => {\n      pc_count(ctx, scope, l)\n      pc_count(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_count(ctx, scope, cond)\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      pc_count(ctx, scope, then_e)\n      let then_u = copy_ints(ctx.uses)\n      let then_b = copy_ints(ctx.borrows)\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      pc_count(ctx, scope, else_e)\n      let mut id = 0\n      while id < Array::length(snap_u) {\n        let base_u = Array::get(snap_u, id)\n        let dt = Array::get(then_u, id) - base_u\n        let de = Array::get(ctx.uses, id) - base_u\n        Array::set(ctx.uses, id, base_u + int_max(dt, de))\n        let base_b = Array::get(snap_b, id)\n        let dtb = Array::get(then_b, id) - base_b\n        let deb = Array::get(ctx.borrows, id) - base_b\n        Array::set(ctx.borrows, id, base_b + int_max(dtb, deb))\n        id = id + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_count(ctx, scope, cond)\n      pc_count(ctx, scope, body)\n    },\n    EReturn(e) => pc_count(ctx, scope, e),\n    EThrow(e) => pc_count(ctx, scope, e),\n    ESpread(e) => pc_count(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\n    EBreak(opt) => match opt {\n      Some(e) => pc_count(ctx, scope, e),\n      None => 0\n    }\n    ,\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\n      ])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pc_count_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_count(ctx, scope, iterable)\n      let idv = pc_declare(ctx, value_name, false)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pc_declare(ctx, idx, true)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_count(ctx, s3, fbody)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_count(ctx, scope, p.1)\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))\n        s = Map::set(s, p.0, pid)\n        i = i + 1\n      }\n      pc_count(ctx, s, lbody)\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),\n        _ => pc_count(ctx, scope, scrut)\n      }\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      pc_count(ctx, scope, hbody)\n      let mut id0 = 0\n      while id0 < Array::length(snap_u) {\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\n        if du > Array::get(max_u, id0) {\n          Array::set(max_u, id0, du)\n        }\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\n        if db > Array::get(max_b, id0) {\n          Array::set(max_b, id0, db)\n        }\n        id0 = id0 + 1\n      }\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = [\n        ]\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n// #706 follow-up (borrow-after-move): a binding with any BORROW occurrence\n// (ctx.borrows[id] > 0 — computed branch-aware, max-across-if/match-arms,\n// alongside ctx.uses above) must stay alive through that borrow, regardless of\n// whether the borrow comes BEFORE or AFTER the binding's owning (consuming)\n// occurrences. `pc_emit`/`pe_use` only track OWNING occurrences (ctx.uses) when\n// deciding dup vs. free-transfer — borrows are invisible to that decision. If a\n// binding's textually LAST owning occurrence is treated as \"the final, free\n// consume\" (no dup; ownership transfers to the callee) and a borrow occurs\n// AFTER that point, the borrow reads through a reference the callee may already\n// have dropped — a silent use-after-free. This was masked in practice by other\n// RC leaks (loop-consume before #706's core fix; the loop-consume LEAK before\n// its own follow-up fix) that happened to keep the value alive by accident; see\n// #706 for the wat_exports/parse_module_sections repro that exposed it once\n// those leaks were tightened.\n//\n// Fix: bump the binding's counted `uses` by exactly one whenever it has ANY\n// borrow occurrence. This is a pure post-processing step over the FINAL,\n// branch-merge-complete `uses`/`borrows` arrays (called after `pc_count`\n// finishes, before the emission pass begins), so it does not interact with the\n// max-across-branches counting logic itself — it only adjusts the total input\n// the REST of the system (pe_declare's `remaining` init, pc_emit's sequential\n// dup decisions, pe_scope_end's drop decision) already handles correctly for \"K\n// owning occurrences\": with K bumped to K+1, the occurrence that used to be a\n// free-transfer gets a dup like any other, and the binding's normal scope-end\n// drop (already emitted whenever `remaining` ends > 0 — e.g. the existing\n// borrow-only / K=0 baseline) picks up the now-nonzero leftover. No new\n// PerceusAction kind, no change to pc_emit or the codegen dup/drop realization.\n// For a binding with ZERO owning occurrences (pure borrow — the already-correct\n// baseline), this is a no-op: pe_declare already treats uses==0 like uses==1.\nlet pctx_apply_borrow_retention: (PCtx) -> Int = (ctx) -> {\n  let mut bid = 0\n  while bid < ctx.next_id {\n    if Array::get(ctx.borrows, bid) > 0 {\n      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)\n    } else {\n      ()\n    }\n    bid = bid + 1\n  }\n  0\n}\n\n// Build the dup/drop plan for a function body expression.\nexport let build_perceus_plan: (Expr) -> Array[PerceusAction] = (body) -> {\n  let ctx = pctx_new()\n  let empty: Map[String, Int] = map {\n  }\n  pc_count(ctx, empty, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  pc_emit(ctx, empty, body)\n  ctx.actions\n}\n\nlet collect_heap_ret_fns: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out: Array[String] = [\n  ]\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, oty, _) =>\n      match oty {\n        Some(ty) =>\n        match ty {\n          TyFn(_, ret, _) =>\n          if type_expr_is_heap(Some(ret)) {\n            Array::push(out, fname)\n          } else {\n            ()\n          },\n          _ => ()\n        },\n        None => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let elaborate_heap_params: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let hctx = HeapInferCtx::{\n    ctors: collect_ctor_names(stmts),\n    heap_fns: collect_heap_ret_fns(stmts),\n  }\n  let out = Array::slice(stmts, 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let s = Array::get(stmts, i)\n    let s2 = match s {\n      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),\n      SExpr(e) => SExpr(elaborate_rw(e, hctx)),\n      _ => s\n    }\n    Array::push(out, s2)\n    i = i + 1\n  }\n  out\n}\n\nlet rec expr_projects_or_matches: (String, Expr) -> Bool = (name, e) -> {\n  match e {\n    EDot(obj, _, _) =>\n    match obj {\n      EIdent(n, _) => n == name,\n      _ => expr_projects_or_matches(name, obj)\n    },\n    EMatch(scrut, arms) => {\n      let hit = match scrut {\n        EIdent(n, _) => n == name,\n        _ => expr_projects_or_matches(name, scrut)\n      }\n      if hit {\n        true\n      } else {\n        let mut i = 0\n        let mut found = false\n        while i < Array::length(arms) {\n          let (_, arm_body) = Array::get(arms, i)\n          if expr_projects_or_matches(name, arm_body) {\n            found = true\n          } else {\n            ()\n          }\n          i = i + 1\n        }\n        found\n      }\n    },\n    EHandle(body, arms) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(arms) {\n        let (_, arm_body) = Array::get(arms, i)\n        if expr_projects_or_matches(name, arm_body) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(_, val, body) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetRec(_, val, body) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    ELetMut(_, val, body) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\n    EAssign(_, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    EAssignOp(_, _, val, cont) =>\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\n    ESeq(a, b) =>\n    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),\n    EIf(c, t, el) =>\n    expr_projects_or_matches(name, c) ||\n    expr_projects_or_matches(name, t) ||\n    expr_projects_or_matches(name, el),\n    EWhile(c, b) =>\n    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),\n    EForIn(_, _, iter, body) =>\n    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),\n    ECall(callee, args, _) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, callee)\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EBinOp(_, l, r) =>\n    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),\n    EUnaryOp(_, o) => expr_projects_or_matches(name, o),\n    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELoop(params, body) => {\n      let mut i = 0\n      let mut found = expr_projects_or_matches(name, body)\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        if expr_projects_or_matches(name, init) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMap(fields) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(fields) {\n        let (_, fval) = Array::get(fields, i)\n        if expr_projects_or_matches(name, fval) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),\n    EThrow(inner) => expr_projects_or_matches(name, inner),\n    EReturn(inner) => expr_projects_or_matches(name, inner),\n    ESpread(inner) => expr_projects_or_matches(name, inner),\n    EBreak(opt) =>\n    match opt {\n      Some(inner) => expr_projects_or_matches(name, inner),\n      None => false\n    },\n    EContinue(args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if expr_projects_or_matches(name, Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    EInt(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EBool(_) => false,\n    EIdent(_, _) => false,\n    EStringInterp(_) => false,\n    EUnit => false\n  }\n}\n\n// Heap-ness decision for an owned parameter: the type annotation says heap, or\n// (when unannotated) the body proves it via projection/match. Used by the\n// Perceus plan and codegen so an unannotated nested-closure param that is\n// projected no longer leaks its owned argument (ADR-0055 Stage 4).\nexport let param_is_heap_in_body: (String, Option[TypeExpr], Expr) -> Bool = (name, otype, body,) -> {\n  if type_expr_is_heap(otype) {\n    true\n  } else {\n    match otype {\n      None => expr_projects_or_matches(name, body),\n      Some(_) => false\n    }\n  }\n}\n\n// Build the plan for a function whose parameters are owned heap values. Params\n// are declared as bindings (in count + emit lockstep, same ids) so the existing\n// machinery emits a PaDrop for a borrowed-only/unused heap param and a PaDup for\n// one used in multiple owning positions. Heap-ness comes from the param's type\n// annotation (scalar params get scalar=true so they are never dropped).\nexport let build_perceus_plan_with_params: (Array[(String, Option[TypeExpr])], Expr, Array[String]) -> Array[PerceusAction] = (params, body, borrow_ret_names) -> {\n  let ctx = pctx_new()\n  // #707: seed the borrow-returning-function-name set (see is_borrow_ret_fname)\n  // directly into pctx_names, bypassing pc_declare -- these markers are never\n  // looked up by id, only linearly searched by content, so being out of step\n  // with ctx.next_id / uses / scalar / etc. is harmless.\n  let mut bri = 0\n  while bri < Array::length(borrow_ret_names) {\n    Array::push(ctx.pctx_names, String::concat(borrow_ret_marker, Array::get(borrow_ret_names, bri)))\n    bri = bri + 1\n  }\n  let mut scope: Map[String, Int] = map {\n  }\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, ptype) = Array::get(params, pi)\n    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))\n    scope = Map::set(scope, pname, id)\n    pi = pi + 1\n  }\n  pc_count(ctx, scope, body)\n  pctx_apply_borrow_retention(ctx)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  let mut scope2: Map[String, Int] = map {\n  }\n  let param_ids = Array::slice([\n    0\n  ], 0, 0)\n  let mut pj = 0\n  while pj < Array::length(params) {\n    let (pname, _) = Array::get(params, pj)\n    let id = pe_declare(ctx, pname)\n    scope2 = Map::set(scope2, pname, id)\n    Array::push(param_ids, id)\n    pj = pj + 1\n  }\n  pc_emit(ctx, scope2, body)\n  let mut pk = 0\n  while pk < Array::length(params) {\n    let (pname, _) = Array::get(params, pk)\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\n    pk = pk + 1\n  }\n  ctx.actions\n}\n")
}

let cli_adapter_source_64 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/index.vibe",
"export ./core.vibe {\n  compile_expr, compile_module_expr\n}\n")
}

let cli_adapter_source_65 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_match.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, md_consume_count\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_rc_dup_guarded, cov_emit_branch, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, agg_log_reset_above, int_log_reset_above, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pfloat, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local, emit_unbox_float\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pfloat_value, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\n// #613 follow-up: bind every `PBind` reachable under a container pattern\n// (tuple or constructor) at ANY nesting depth, skipping literal / wildcard\n// sub-patterns. `base_local` holds the (possibly tagged) pointer to the\n// container whose fields hold the sub-pattern values. `is_ctor_layout`\n// selects the field layout: a constructor stores its tag at offset 0 and\n// fields at `8 + i*8` with the pointer always tag-cleared; a tuple stores\n// fields at `8 + i*8` (RC, tagged) or `i*8` (non-RC, untagged). Used for\n// conditional match arms whose top pattern is a bare tuple with literal\n// siblings (`(false, n) => ..`), where the binding pass previously emitted\n// nothing and any use of `n` trapped codegen with \"undefined variable\".\n\n// Emit `n` guarded rc_dups of `local_idx` (one per owning consume of a matched\n// field; see md_consume_count). n<=0 emits nothing.\nlet emit_rc_dup_guarded_n: (Bytes, Int, Int, Bool) -> Unit = (buf, local_idx, n, rc_shadow) -> {\n  let mut k = 0\n  while k < n {\n    emit_rc_dup_guarded(buf, local_idx, rc_shadow)\n    k = k + 1\n  }\n}\n\nlet rec bind_match_pat: (Bytes, Int, Pat, Bool, Array[String], CompileCtx, Expr) -> Unit = (buf, base_local, container_pat, is_ctor_layout, local_names, ctx, body) -> {\n  let elems = if is_ctor_layout {\n    get_pctor_args(container_pat)\n  } else {\n    get_ptuple_pats(container_pat)\n  }\n  let mut i = 0\n  while i < Array::length(elems) {\n    let ep = Array::get(elems, i)\n    let off = if is_ctor_layout {\n      8 + i * 8\n    } else if ctx.enable_rc {\n      8 + i * 8\n    } else {\n      i * 8\n    }\n    let clear_tag = is_ctor_layout || ctx.enable_rc\n    if is_pbind(ep) {\n      let nm = get_pbind_name(ep)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      // #715 follow-up: this helper previously bound the field without ever\n      // dup'ing it, regardless of how many owning uses `nm` has in `body` — a\n      // matched field is a borrowed view sharing the container's refcount\n      // (see #702/#705 at the inline call sites in `compile_match`), so an\n      // owning consume plus the container's own recursive drop double-frees\n      // the same block. Mirror the inline sites' guarded per-consume dup.\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, false, local_names, ctx, body)\n    } else if is_pctor(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, true, local_names, ctx, body)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\n// The index of `field` WITHIN the struct named `sname`. A struct value lays its\n// fields out exactly like a constructor — tag/header at 0, field i at `8 + i*8`,\n// pointer tag-cleared — so the offset is `8 + index*8`, identical to what\n// `obj.field` reads. The matched struct name MUST drive the lookup: two structs\n// can share a field name at different positions (`A { x; y }` vs `B { y; x }`),\n// so a name-agnostic \"first struct that declares the field\" scan binds the wrong\n// offset. Only when `sname` is not in the table do we fall back to that scan.\nlet find_struct_index: (CompileCtx, String) -> Int = (ctx, sname) -> {\n  let names = ctx.ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  sidx\n}\n\nlet field_index_in: (Array[String], String) -> Int = (fnames, field) -> {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\nlet struct_field_index: (CompileCtx, String, String) -> Int with { Error } = (ctx, sname, field) -> {\n  let sidx = find_struct_index(ctx, sname)\n  if sidx >= 0 {\n    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    // `sname` not found in the struct table: fall back to the legacy global\n    // first-match scan so unqualified / synthetic names still resolve.\n    let names = ctx.ctor_table.struct_names\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\n// Bind every variable in a struct pattern `S::{ f1: p1, f2: p2, ... }` whose\n// value is the (tagged) struct pointer in `base_local`. Each field is loaded by\n// NAME (offset `8 + struct_field_index*8`), then its sub-pattern is bound:\n// a `PBind` becomes a local; a tuple/constructor sub-pattern recurses through\n// the positional `bind_match_pat`; a nested struct recurses here. Literal /\n// wildcard sub-patterns bind nothing (a struct pattern with a literal field is\n// refutable and is not routed here — see `is_catchall_pat`).\nlet rec bind_struct_pat: (Bytes, Int, String, Array[(String, Pat)], Array[String], CompileCtx, Expr) -> Unit with { Error } = (buf, base_local, sname, fields, local_names, ctx, body) -> {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, subpat) = Array::get(fields, i)\n    let off = 8 + struct_field_index(ctx, sname, fname) * 8\n    if is_pbind(subpat) {\n      let nm = get_pbind_name(subpat)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      // #715 follow-up: same missing-dup gap as `bind_match_pat` above, for an\n      // irrefutable struct-pattern field.\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, false, local_names, ctx, body)\n    } else if is_pctor(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, true, local_names, ctx, body)\n    } else {\n      match subpat {\n        PStruct(__sname, sfields) => {\n          let sl = Array::length(local_names)\n          emit_local_get(buf, base_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, off)\n          emit_local_set(buf, sl)\n          Array::push(local_names, \"__bind_sub\")\n          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx, body)\n        },\n        _ => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  // #613 follow-up: discriminate literal sub-patterns at EVERY nesting level,\n  // not just the top constructor-argument level. `load_field` is a thunk that\n  // pushes the (tagged) value at this position. `emit_pat_test` emits a single\n  // i32 boolean (\"does the value at this position match `sp`?\") with NO trailing\n  // AND, recursing through ctor args, tuple elements, and or-branches. Without\n  // recursing, `N(W(false), n)` matched `N(W(true), _)`, `T((false, n))` matched\n  // `T((true, _))`, and or-branches `(1, _) | (2, _)` / `\"a\" | \"b\"` matched\n  // anything — silent wrong results. Bindings/wildcards always match (push 1).\n  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    match sp {\n      POr(__l, __r) => {\n        // (left matches) OR (right matches) at this same position.\n        emit_pat_test(__l, load_field)\n        emit_pat_test(__r, load_field)\n        bytebuf_push(buf, 114)\n      },\n      _ => {\n        if is_pfloat(sp) {\n          // Bit-exact f64 compare: bump lane holds raw bits, RC lane a boxed\n          // pointer (unbox first). f64.eq gives `==` semantics (0.0 == -0.0).\n          load_field()\n          if ctx.enable_rc {\n            emit_unbox_float(buf)\n          } else {\n            ()\n          }\n          emit_f64_reinterpret_i64(buf)\n          let __pfv = get_pfloat_value(sp)\n          emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__pfv), Double::to_i64_bits_hi(__pfv))\n          emit_f64_eq(buf)\n        } else if is_pint(sp) {\n          load_field()\n          emit_i64_const(buf, get_pint_value(sp))\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pbool(sp) {\n          load_field()\n          emit_i64_const(buf, if get_pbool_value(sp) {\n            1\n          } else {\n            0\n          })\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pstring(sp) {\n          let __sv = get_pstring_value(sp)\n          let __si = str_table_lookup(ctx.str_table.strs, __sv)\n          if __si >= 0 {\n            let (__seq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n            load_field()\n            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n            emit_call(buf, __seq_fi)\n            emit_i32_wrap_i64(buf)\n          } else {\n            // String literal absent from the table: conservatively match (the\n            // prior behavior emitted no test at all).\n            emit_i32_const(buf, 1)\n          }\n        } else if is_pctor(sp) {\n          let __ncname = get_pctor_name(sp)\n          let __nci = lookup_ctor(ctx.ctor_table.names, __ncname, 0)\n          let __ntag = if __nci >= 0 {\n            Array::get(ctx.ctor_table.tags, __nci)\n          } else {\n            -1\n          }\n          load_field()\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, __ntag)\n          emit_i32_eq(buf)\n          let __nargs = get_pctor_args(sp)\n          // #705: payload sub-tests must NOT run when the tag test above\n          // failed. The value may be a different constructor (or a scalar)\n          // whose slot at `8 + k*8` is not a valid value of this ctor's field\n          // type; a nested tag test would dereference that garbage — a\n          // data-dependent OOB that crashed the RC-built compiler's\n          // check_expr / seed_var_types on `Some(TDEnum(..))`-style patterns.\n          // Guard the sub-tests behind the tag test with `if (result i32)`\n          // so the AND short-circuits. Binds/wildcards add no test.\n          let mut __nany = false\n          let mut __nj = 0\n          while __nj < Array::length(__nargs) {\n            let __np = Array::get(__nargs, __nj)\n            if is_pbind(__np) || is_pwild(__np) {\n              ()\n            } else {\n              __nany = true\n            }\n            __nj = __nj + 1\n          }\n          if __nany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __nk = 0\n            while __nk < Array::length(__nargs) {\n              let __nkk = __nk\n              let __np2 = Array::get(__nargs, __nkk)\n              if is_pbind(__np2) || is_pwild(__np2) {\n                ()\n              } else {\n                let __nload: () -> Unit = () -> {\n                  load_field()\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, 8 + __nkk * 8)\n                }\n                emit_pat_test(__np2, __nload)\n                bytebuf_push(buf, 113)\n              }\n              __nk = __nk + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n        } else if is_ptuple(sp) {\n          emit_i32_const(buf, 1)\n          let __tpats = get_ptuple_pats(sp)\n          let mut __tk = 0\n          while __tk < Array::length(__tpats) {\n            let __tkk = __tk\n            let __tload: () -> Unit = () -> {\n              load_field()\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + __tkk * 8\n              } else {\n                __tkk * 8\n              })\n            }\n            emit_pat_test(Array::get(__tpats, __tkk), __tload)\n            bytebuf_push(buf, 113)\n            __tk = __tk + 1\n          }\n        } else {\n          // PBind / PWild: always matches.\n          emit_i32_const(buf, 1)\n        }\n      }\n    }\n  }\n  // AND a position's match test onto the accumulator already on the stack.\n  // Bindings/wildcards add no constraint, so they emit nothing (keeping the\n  // accumulator untouched) rather than `const 1; and`.\n  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    if is_pbind(sp) || is_pwild(sp) {\n      ()\n    } else {\n      emit_pat_test(sp, load_field)\n      bytebuf_push(buf, 113)\n    }\n  }\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    // #678: a previous arm may have logged integral slots >= names_len_at_match\n    // that this arm's pattern binders (non-`let`, so they log nothing) reuse;\n    // drop them so a string bound there is not misread as int by `==`.\n    int_log_reset_above(ctx, names_len_at_match)\n    agg_log_reset_above(ctx.agg_local_slots, names_len_at_match)\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\n    let __cond_done = if is_pfloat(__cond_p) {\n      // Top-level float literal arm (`match d { 0.0 => .. }`): same f64\n      // compare as emit_pat_test's PFloat branch.\n      emit_local_get(buf, scrut_local)\n      if ctx.enable_rc {\n        emit_unbox_float(buf)\n      } else {\n        ()\n      }\n      emit_f64_reinterpret_i64(buf)\n      let __apfv = get_pfloat_value(__cond_p)\n      emit_f64_const_lohi(buf, Double::to_i64_bits_lo(__apfv), Double::to_i64_bits_hi(__apfv))\n      emit_f64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          if ctx.enable_rc { 2 } else { 1 }\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          // #603/#608/#613: the tag test alone is not enough — literal\n          // sub-patterns must be checked at EVERY nesting level, else\n          // `I(1)`/`I(\"x\")` match `I(2)`/`I(\"y\")`, nested `N(W(false),_)` matches\n          // `N(W(true),_)`, and tuple `T((false,_))` matches `T((true,_))`. AND-in\n          // a recursive field-vs-literal test per constructor argument. Bindings\n          // and wildcards add no test. This bug silently broke\n          // `match stmt { SEnum(false, ...) => ... }` in the compiler's own\n          // namespace pass, mis-namespacing exported enums.\n          let __cargs_cond = get_pctor_args(__cond_p)\n          // #705: same short-circuit guard as `emit_pat_test` — payload\n          // sub-tests only run when the arm's tag test matched, else a nested\n          // tag test dereferences a slot that is not a valid tagged value.\n          let mut __cany = false\n          let mut __cj = 0\n          while __cj < Array::length(__cargs_cond) {\n            let __cp = Array::get(__cargs_cond, __cj)\n            if is_pbind(__cp) || is_pwild(__cp) {\n              ()\n            } else {\n              __cany = true\n            }\n            __cj = __cj + 1\n          }\n          if __cany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __ck = 0\n            while __ck < Array::length(__cargs_cond) {\n              let __ckk = __ck\n              let __cload: () -> Unit = () -> {\n                emit_local_get(buf, scrut_local)\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, 8 + __ckk * 8)\n              }\n              emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)\n              __ck = __ck + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, str_eq_fi)\n              emit_i32_wrap_i64(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else if is_ptuple(__cond_p) {\n            // A bare tuple cond pattern (`(false, n) => ..`) has no tag to test;\n            // previously it fell through to `emit_or_check`'s `_ => const 1`,\n            // making the arm UNCONDITIONALLY match — `(false, n)` matched\n            // `(true, 5)` (silent wrong result, the #613 unsoundness for bare\n            // tuples). Start from a `true` accumulator and AND-in a recursive\n            // field-vs-literal test for every literal element (binds/wildcards\n            // add no test, so an all-bind tuple stays always-true).\n            emit_i32_const(buf, 1)\n            let __tpats_cond = get_ptuple_pats(__cond_p)\n            let mut __tck = 0\n            while __tck < Array::length(__tpats_cond) {\n              let __tckk = __tck\n              let __tcload: () -> Unit = () -> {\n                emit_local_get(buf, scrut_local)\n                if ctx.enable_rc {\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                } else {\n                  ()\n                }\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, if ctx.enable_rc {\n                  8 + __tckk * 8\n                } else {\n                  __tckk * 8\n                })\n              }\n              emit_sub_tests(Array::get(__tpats_cond, __tckk), __tcload)\n              __tck = __tck + 1\n            }\n            emit_if_i64(buf)\n            0\n          } else {\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\n              match pat {\n                POr(left, right) => {\n                  emit_or_check(left)\n                  emit_or_check(right)\n                  bytebuf_push(buf, 114)\n                },\n                PInt(n) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, n)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, 1)\n                    emit_i64_shl(buf)\n                  }\n                  emit_i64_eq(buf)\n                },\n                PFloat(fv) => {\n                  // A float or-branch (`0.0|180.0`) previously fell through to\n                  // `_ => const 1` (always-true). Same f64 compare as\n                  // emit_pat_test's PFloat branch.\n                  emit_local_get(buf, scrut_local)\n                  if ctx.enable_rc {\n                    emit_unbox_float(buf)\n                  } else {\n                    ()\n                  }\n                  emit_f64_reinterpret_i64(buf)\n                  emit_f64_const_lohi(buf, Double::to_i64_bits_lo(fv), Double::to_i64_bits_hi(fv))\n                  emit_f64_eq(buf)\n                },\n                PCtor(cname, cargs) => {\n                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)\n                  let ctag = if ci >= 0 {\n                    Array::get(ctx.ctor_table.tags, ci)\n                  } else {\n                    -1\n                  }\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i32_load(buf, 2, 0)\n                  emit_i32_const(buf, ctag)\n                  emit_i32_eq(buf)\n                  if Array::length(cargs) == 1 {\n                    match Array::get(cargs, 0) {\n                      PInt(n) => {\n                        emit_local_get(buf, scrut_local)\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                        emit_i32_wrap_i64(buf)\n                        emit_i64_load(buf, 3, 8)\n                        emit_i64_const(buf, n)\n                        if ctx.enable_rc {\n                          emit_i64_const(buf, 1)\n                          emit_i64_shl(buf)\n                        }\n                        emit_i64_eq(buf)\n                        bytebuf_push(buf, 113)\n                      },\n                      _ => ()\n                    }\n                  }\n                },\n                PBool(b) => {\n                  // An or-branch boolean literal (`true | ..`) previously fell\n                  // through to `_ => const 1` (always-true), so `\"a\"|\"b\"` /\n                  // `(1,_)|(2,_)` / bool ors silently matched everything.\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, if b {\n                    if ctx.enable_rc { 2 } else { 1 }\n                  } else {\n                    0\n                  })\n                  emit_i64_eq(buf)\n                },\n                PString(sv) => {\n                  let __si = str_table_lookup(ctx.str_table.strs, sv)\n                  if __si >= 0 {\n                    let (__eqfi, _, _) = resolve_func(ctx.func_table, \"eq\")\n                    emit_local_get(buf, scrut_local)\n                    emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n                    emit_call(buf, __eqfi)\n                    emit_i32_wrap_i64(buf)\n                  } else {\n                    emit_i32_const(buf, 1)\n                  }\n                },\n                PTuple(tpats) => {\n                  // A tuple or-branch (`(1, _) | (2, _)`): no tag to test, so\n                  // start from `true` and AND-in a field-vs-literal test for\n                  // every literal element (binds/wildcards add none).\n                  emit_i32_const(buf, 1)\n                  let mut __ok = 0\n                  while __ok < Array::length(tpats) {\n                    let __okk = __ok\n                    let __oload: () -> Unit = () -> {\n                      emit_local_get(buf, scrut_local)\n                      if ctx.enable_rc {\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                      } else {\n                        ()\n                      }\n                      emit_i32_wrap_i64(buf)\n                      emit_i64_load(buf, 3, if ctx.enable_rc {\n                        8 + __okk * 8\n                      } else {\n                        __okk * 8\n                      })\n                    }\n                    emit_sub_tests(Array::get(tpats, __okk), __oload)\n                    __ok = __ok + 1\n                  }\n                },\n                _ => emit_i32_const(buf, 1)\n              }\n            }\n            emit_or_check(__cond_p)\n            emit_if_i64(buf)\n            0\n          }\n        }\n      }\n    }\n    // #cov branch: this conditional arm was taken (start of the if-then block).\n    cov_emit_branch(buf, ctx.cov)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      // #703/#705: the #702 dup of a matched heap field must give the binding\n      // ONE owned reference per owning consume in the arm body (see\n      // bind_match_pat's md_consume_count note). Binding is delegated to the\n      // recursive bind_match_pat so nested ctor/tuple sub-patterns bind at ANY\n      // depth — the previous inline loop stopped at depth 2, so the `v` in\n      // `Some(Some(Some(v)))` was never emitted and its use trapped codegen\n      // (resolve_local fails). Discrimination already recurses (#603/#608).\n      bind_match_pat(buf, scrut_local, __cond_p, true, local_names, ctx, __arm_body)\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else if is_ptuple(__cond_p) {\n      // A bare tuple arm pattern with literal siblings (`(false, n) => ..`):\n      // discrimination already tested the literals above, but the binding pass\n      // emitted nothing here, so `n` was undefined. Load the scrutinee tuple\n      // pointer and bind every reachable PBind (skipping literals/wildcards).\n      let tup_ptr = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, tup_ptr)\n      Array::push(local_names, \"__cond_tup\")\n      bind_match_pat(buf, tup_ptr, __cond_p, false, local_names, ctx, __arm_body)\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  // #678: same prune before the catch-all arm's pattern binders reuse the slots.\n  int_log_reset_above(ctx, names_len_at_match)\n  agg_log_reset_above(ctx.agg_local_slots, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let (__catch_p, __catch_body) = __catch_arm\n    0\n    // #cov branch: the catch-all (none of the conditional arms matched). Only a\n    // real decision point when there is at least one conditional arm.\n    if num_cond_arms > 0 {\n      cov_emit_branch(buf, ctx.cov)\n    } else {\n      ()\n    }\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        // #705 dup note as above; recursive bind_match_pat replaces the\n        // depth-1 inline loop (same depth-3 gap as the cond arms).\n        bind_match_pat(buf, scrut_local, __catch_p, true, local_names, ctx, __catch_body)\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          // Recursive bind (was a depth-2 inline loop; nested ctor elements\n          // inside the tuple were never bound).\n          bind_match_pat(buf, ptr_local2, __catch_p, false, local_names, ctx, __catch_body)\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          match __catch_p {\n            PStruct(__sname, __sfields) => {\n              // An irrefutable struct pattern `S::{ x, y }` as the catch-all arm:\n              // bind every field by name from the scrutinee struct pointer.\n              let __sp_ptr = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_local_set(buf, __sp_ptr)\n              Array::push(local_names, \"__struct_ptr\")\n              bind_struct_pat(buf, __sp_ptr, __sname, __sfields, local_names, ctx, __catch_body)\n              ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n            },\n            _ => ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n          }\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n")
}

let cli_adapter_source_66 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_lambda.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / .. / perceus {\n  build_perceus_plan_with_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, md_consume_count, scope_tail_proj_root\n}\n\nimport .. / common_base {\n  emit_rc_word_inc_saturating, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_rc_dup_guarded, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\n\nexport let compile_lambda: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname_raw, _) = Array::get(params, lpi)\n    let lpnlen = String::length(lpname_raw)\n    let lpname = if lpnlen > 0 {\n      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)\n      if lpc == '~' {\n        lpname_raw[0: lpnlen - 1]\n      } else if lpc == '?' {\n        lpname_raw[0: lpnlen - 1]\n      } else {\n        lpname_raw\n      }\n    } else lpname_raw\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    // #699: a captured RC ref cell is stored odd-tagged in the env (so the\n    // closure's class-7 drop classifies and frees it). The inner body uses the\n    // cell as an even vptr (load/store at +0), so untag on load back.\n    if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\n      emit_i64_const(lam_buf, -2)\n      emit_i64_and(lam_buf)\n    }\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    } else {\n      ()\n    }\n    // #705: a captured non-refcell heap var is a BORROWED view of the defining\n    // scope's binding — the env store (below) does NOT bump its rc, and the\n    // body's perceus plan never tracks a free var, so any owning consume inside\n    // the closure decrements a refcount the closure does not own. Left unbalanced\n    // that frees the defining scope's value early (double free / heap cycle when\n    // a recursive closure consumes a captured list each iteration — e.g. a set\n    // op's `contains(b, head)` over a borrowed `b`). Dup the capture once per\n    // owning consume here in the prologue: it runs per invocation, so a recursive\n    // closure consuming the capture each call stays balanced (defining scope\n    // still drops it exactly once). Ref-cell captures (#699) own their cell via\n    // the env store and are reclaimed by the closure's class-7 drop; skip them.\n    if ctx.enable_rc && !array_contains_str(ctx.ref_cell_names, cap_name) {\n      let cap_consumes = md_consume_count(fn_body, cap_name)\n      let mut cdup = 0\n      while cdup < cap_consumes {\n        emit_rc_dup_guarded(lam_buf, cap_local, ctx.rc_shadow)\n        cdup = cdup + 1\n      }\n    } else {\n      ()\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let norm_params = Array::slice(params, 0, 0)\n  let mut npi = 0\n  while npi < Array::length(params) {\n    let (rawn, pty) = Array::get(params, npi)\n    let rnlen = String::length(rawn)\n    let sn = if rnlen > 0 {\n      let lc = String::char_code_at(rawn, rnlen - 1)\n      if lc == '~' || lc == '?' {\n        rawn[0: rnlen - 1]\n      } else {\n        rawn\n      }\n    } else {\n      rawn\n    }\n    Array::push(norm_params, (sn, pty))\n    npi = npi + 1\n  }\n  let lam_drops = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_alias_dups = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_dups = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_heap_params = Array::slice([\n    \"\"\n  ], 0, 0)\n  if ctx.enable_rc {\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body, ctx.borrow_ret_names)\n    let mut ldi = 0\n    while ldi < Array::length(lam_plan) {\n      let lpa = Array::get(lam_plan, ldi)\n      if pa_is_drop(lpa) {\n        Array::push(lam_drops, lpa.name)\n      } else if pa_is_alias_dup(lpa) {\n        Array::push(lam_alias_dups, lpa.name)\n      } else if pa_is_dup(lpa) {\n        Array::push(lam_dups, lpa.name)\n      } else {\n        ()\n      }\n      ldi = ldi + 1\n    }\n    let mut hpi = 0\n    while hpi < Array::length(norm_params) {\n      let (hpn, hpt) = Array::get(norm_params, hpi)\n      if param_is_heap_in_body(hpn, hpt, fn_body) {\n        Array::push(lam_heap_params, hpn)\n      } else {\n        ()\n      }\n      hpi = hpi + 1\n    }\n  }\n  // #744: annotated Float/Double LAMBDA params seed float_local_slots exactly\n  // like top-level fn params do (linked_compile's psi loop) — without this a\n  // local `(v: Double, by: Double) -> Double { v * by }` compiled `v * by` as\n  // an INTEGER multiply of the f64 bits (and under RC compared/box-leaked\n  // pointers), so closure float math was silently garbage.\n  let lam_float_slots = Array::slice([\n    0\n  ], 0, 0)\n  let mut lfs_i = 0\n  while lfs_i < user_params {\n    let (_, lfs_ann) = Array::get(norm_params, lfs_i)\n    match lfs_ann {\n      Some(lfs_ty) => match lfs_ty {\n        TyName(lfs_tn) => if lfs_tn == \"Float\" || lfs_tn == \"Double\" {\n          Array::push(lam_float_slots, lfs_i * 2 + 1)\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      None => ()\n    }\n    lfs_i = lfs_i + 1\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values,\n    enable_rc: ctx.enable_rc,\n    rc_shadow: ctx.rc_shadow,\n    rc_drop_names: lam_drops,\n    rc_alias_dup_names: lam_alias_dups,\n    heap_binding_names: lam_heap_params,\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\n    heap_grow_check_func_idx: ctx.heap_grow_check_func_idx,\n    rc_dup_names: lam_dups,\n    float_local_slots: lam_float_slots,\n    int_local_slots: Array::slice([\n      0\n    ], 0, 0),\n    agg_local_slots: Array::slice([\n      0\n    ], 0, 0),\n    agg_ret_names: ctx.agg_ret_names,\n    agg_ret_infos: ctx.agg_ret_infos,\n    effect_names: ctx.effect_names,\n    effect_op_keys: ctx.effect_op_keys,\n    effect_op_arities: ctx.effect_op_arities,\n    cov: ctx.cov,\n    dbg_line_idx: ctx.dbg_line_idx,\n    dbg_line_nl: ctx.dbg_line_nl,\n    dbg_line_file_id: ctx.dbg_line_file_id,\n    loop_borrowed_names: Array::slice([\n      \"\"\n    ], 0, 0),\n    loop_consumed_names: Array::slice([\n      \"\"\n    ], 0, 0),\n    borrow_ret_names: ctx.borrow_ret_names,\n    scalar_ret_names: ctx.scalar_ret_names\n  }\n  if ctx.enable_rc {\n    let mut dpi = 0\n    while dpi < Array::length(norm_params) {\n      let (dpn, dpt) = Array::get(norm_params, dpi)\n      if param_is_heap_in_body(dpn, dpt, fn_body) {\n        let mut dcount = 0\n        let mut dqi = 0\n        while dqi < Array::length(lam_dups) {\n          if Array::get(lam_dups, dqi) == dpn {\n            dcount = dcount + 1\n          } else {\n            ()\n          }\n          dqi = dqi + 1\n        }\n        let mut de = 0\n        while de < dcount {\n          emit_rc_dup_guarded(lam_buf, dpi, ctx.rc_shadow)\n          de = de + 1\n        }\n      } else {\n        ()\n      }\n      dpi = dpi + 1\n    }\n  } else {\n    ()\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let mut tail_lam_nl = final_lam_nl\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n    let tail_root = scope_tail_proj_root(fn_body)\n    let mut need_dup = false\n    let mut ti = 0\n    while ti < Array::length(norm_params) {\n      let (tpn, tpt) = Array::get(norm_params, ti)\n      if param_is_heap_in_body(tpn, tpt, fn_body) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\n        need_dup = true\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    let rtemp = final_lam_nl\n    if need_dup {\n      emit_local_set(lam_buf, rtemp)\n      emit_rc_dup_guarded(lam_buf, rtemp, ctx.rc_shadow)\n      tail_lam_nl = final_lam_nl + 1\n    } else {\n      ()\n    }\n    let mut tj = 0\n    while tj < Array::length(norm_params) {\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\n      if param_is_heap_in_body(dpn2, dpt2, fn_body) && array_contains_str(lam_drops, dpn2) {\n        emit_local_get(lam_buf, tj)\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      tj = tj + 1\n    }\n    if need_dup {\n      emit_local_get(lam_buf, rtemp)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if tail_lam_nl > min_lam_nl {\n    extra_lam = tail_lam_nl - min_lam_nl\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    let cap_off = if ctx.enable_rc {\n      16\n    } else {\n      8\n    }\n    if ctx.enable_rc {\n      let total = 16 + num_captures * 8\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 7)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 12)\n    } else {\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8 + num_captures * 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, table_slot)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_captures)\n      emit_i32_store(buf, 2, 4)\n    }\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        if ctx.enable_rc && array_contains_str(ctx.ref_cell_names, cap_name) {\n          // #699: own the captured RC ref cell. Store it odd-tagged so the\n          // closure's class-7 drop (gen_rc_drop_body) recognises it as an owned\n          // heap value, and bump its refcount (unguarded — a ref cell is always\n          // heap) so the shared cell survives until BOTH the defining scope and\n          // this closure have dropped it.\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, __cap_resolve)\n          emit_i64_const(buf, 1)\n          emit_i64_or(buf)\n          emit_i64_store(buf, 3, cap_off + csi * 8)\n          emit_rc_word_inc_saturating(buf, () -> {\n            emit_local_get(buf, __cap_resolve)\n            emit_i32_wrap_i64(buf)\n            emit_i32_const(buf, 4)\n            emit_i32_sub(buf)\n          })\n        } else {\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, __cap_resolve)\n          emit_i64_store(buf, 3, cap_off + csi * 8)\n        }\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, cap_off + csi * 8)\n      }\n      csi = csi + 1\n    }\n    if ctx.enable_rc {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n    } else {\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n    }\n    nl2\n  }\n}\n")
}

let cli_adapter_source_67 = () -> (String, String) {
  ("vibe/compiler/codegen/builtin_registry.vibe",
"//# Functions\n\n// #415 B-0: the central declarative registry of func-table builtins across\n// both backends. Row: (name, param_count, returns_value 0|1,\n// in_linear_table, in_gc_table).\n//\n// This B-0 stage does NOT drive codegen — the linear builder\n// (wasi/linked_compile.vibe) and the gc builder (gc/backend_body.vibe) keep\n// their existing registration wiring, but each VERIFIES its built name table\n// against this registry at compile time (verify_lane_builtins below). Adding\n// a builtin to a lane without a registry row — or claiming a lane here\n// without registering it there — fails every build with a named diff instead\n// of silently diverging (the wasm-gc HOF-gap class of regression this issue\n// exists to prevent).\n//\n// Lane semantics:\n// - in_linear_table / in_gc_table refer to the lane's FUNC-TABLE registration\n//   only. A name absent from a lane's table may still be served there by a\n//   callsite lowering (expr/compile_call.vibe, gc/backend_call.vibe) or by\n//   prelude vibe source — B-1 will classify those; B-0 pins what exists.\n// - Host imports (Fs::/Env::/sleep/...) are linear-only by design: the gc\n//   lane is the pure-test lane and gates host builtins out as a group.\nexport let builtin_registry: () -> Array[(String, Int, Int, Bool, Bool)] = () -> {\n  [\n    (\"Env::get\", 1, 1, true, false),\n    (\"Env::args_len\", 0, 1, true, false),\n    (\"Env::args_get\", 1, 1, true, false),\n    (\"Fs::read_file\", 1, 1, true, false),\n    (\"Fs::exists\", 1, 1, true, false),\n    (\"Fs::stat_token\", 1, 1, true, false),\n    (\"Fs::write_file\", 2, 0, true, false),\n    (\"Fs::write_bytes\", 2, 0, true, false),\n    (\"Fs::read_bytes\", 1, 1, true, false),\n    (\"__fs_read_dir_raw\", 1, 1, true, false),\n    (\"Profiler::now_us\", 0, 1, true, false),\n    (\"Profiler::NowUs\", 0, 1, true, false),\n    (\"sleep\", 1, 0, true, false),\n    (\"Stdin::read_char\", 0, 1, true, false),\n    (\"simd_skip_ws\", 3, 1, true, false),\n    (\"simd_scan_alnum\", 3, 1, true, false),\n    (\"simd_scan_alnum_str\", 3, 1, true, false),\n    (\"str_lex_diff\", 2, 1, true, true),\n    (\"print_int\", 1, 0, true, true),\n    (\"print_str\", 1, 0, true, true),\n    (\"String::length\", 1, 1, true, true),\n    (\"String::equals\", 2, 1, true, true),\n    (\"String::concat\", 2, 1, true, true),\n    (\"array_new\", 0, 1, true, true),\n    (\"Array::length\", 1, 1, true, true),\n    (\"Array::get\", 2, 1, true, true),\n    (\"Array::push\", 2, 0, true, true),\n    (\"Array::push_all\", 2, 0, true, true),\n    (\"Array::set\", 3, 0, true, true),\n    (\"Double::to_int\", 1, 1, true, true),\n    (\"Int::to_double\", 1, 1, true, true),\n    (\"String::char_code_at\", 2, 1, true, true),\n    (\"String::from_char_code\", 1, 1, true, true),\n    (\"String::substring\", 3, 1, true, true),\n    (\"Array::truncate\", 2, 0, true, true),\n    (\"String::join\", 2, 1, true, true),\n    (\"eq\", 2, 1, true, true),\n    (\"String::ends_with\", 2, 1, true, true),\n    (\"String::last_index_of\", 2, 1, true, true),\n    (\"String::index_of\", 2, 1, true, true),\n    (\"String::contains\", 2, 1, true, true),\n    (\"String::starts_with\", 2, 1, true, true),\n    (\"String::split\", 2, 1, true, true),\n    (\"String::trim\", 1, 1, true, true),\n    (\"selfhost_sources\", 0, 1, true, false),\n    (\"ArrayBuilder::new\", 0, 1, true, true),\n    (\"ArrayBuilder::push\", 2, 0, true, true),\n    (\"ArrayBuilder::freeze\", 1, 1, true, true),\n    (\"Array::slice\", 3, 1, true, true),\n    (\"Array::concat\", 2, 1, true, true),\n    (\"Bytes::new\", 0, 1, true, true),\n    (\"Bytes::from_array\", 1, 1, true, true),\n    (\"Bytes::to_array\", 1, 1, true, true),\n    (\"Bytes::length\", 1, 1, true, true),\n    (\"Bytes::get\", 2, 1, true, true),\n    (\"Bytes::set\", 3, 0, true, true),\n    (\"Bytes::push\", 2, 0, true, true),\n    (\"Bytes::append\", 2, 0, true, true),\n    (\"Bytes::concat\", 2, 1, true, true),\n    (\"Bytes::slice\", 3, 1, true, true),\n    (\"Double::to_i64_bits\", 1, 1, true, true),\n    (\"__to_string\", 1, 1, true, true),\n    (\"__rc_drop\", 1, 0, true, false),\n    (\"__rc_alloc\", 1, 1, true, false),\n    (\"__heap_grow_check\", 0, 0, true, false),\n    (\"not\", 1, 1, false, true),\n    (\"Bytes::blit\", 4, 0, false, true),\n    (\"Bytes::fill\", 3, 0, false, true),\n    (\"Double::from_i64_bits\", 1, 1, false, true),\n    (\"Double::to_float\", 1, 1, false, true),\n    (\"Float::to_double\", 1, 1, false, true),\n    (\"Char::to_int\", 1, 1, false, true),\n    (\"Char::from_int\", 1, 1, false, true),\n    (\"Int::to_float\", 1, 1, false, true),\n    (\"FixedArray::make\", 2, 1, false, true),\n    (\"FixedArray::length\", 1, 1, false, true),\n    (\"FixedArray::get\", 2, 1, false, true),\n    (\"FixedArray::set\", 3, 0, false, true),\n    (\"FixedArray::unsafe_set\", 3, 0, false, true),\n    (\"FixedArray::blit\", 5, 0, false, true),\n    (\"StringBuilder::new\", 0, 1, false, true),\n    (\"StringBuilder::push\", 2, 0, false, true),\n    (\"StringBuilder::freeze\", 1, 1, false, true),\n    (\"Map::get\", 2, 1, false, true),\n    (\"Map::keys\", 1, 1, false, true),\n    (\"MapBuilder::new\", 0, 1, false, true),\n    (\"MapBuilder::set\", 3, 0, false, true),\n    (\"MapBuilder::freeze\", 1, 1, false, true),\n    (\"assert\", 1, 0, false, true),\n    (\"assert_true\", 1, 0, false, true),\n    (\"assert_eq\", 2, 0, false, true),\n    (\"println\", 1, 0, false, true),\n    (\"print\", 1, 0, false, true),\n    (\"map_has\", 2, 1, false, true)\n  ]\n}\n\n// #415 B-0: assert one lane's registered (names, param_counts, returns)\n// arrays agree with the registry. Called by each backend builder right after\n// it finishes its registration pushes; throws with a named diff on any\n// drift. O(n^2) over ~100 entries at compile start — noise next to a parse.\nexport let verify_lane_builtins: (String, Array[String], Array[Int], Array[Int]) -> Unit with { Error } = (lane, names, param_counts, returns) -> {\n  let is_gc = lane == \"gc\"\n  let reg = builtin_registry()\n  // 1. every registered name must have a matching registry row\n  let mut i = 0\n  while i < Array::length(names) {\n    let n = Array::get(names, i)\n    let mut found = false\n    let mut ri = 0\n    while ri < Array::length(reg) {\n      let (rn, rp, rr, rlin, rgc) = Array::get(reg, ri)\n      if rn == n {\n        found = true\n        let claimed = if is_gc { rgc } else { rlin }\n        if claimed {\n          ()\n        } else {\n          throw(\"builtin registry drift: '\\{n}' is registered by the \\{lane} lane but the registry says it is not in that lane's table (vibe/compiler/codegen/builtin_registry.vibe, #415)\")\n        }\n        if rp == Array::get(param_counts, i) && rr == Array::get(returns, i) {\n          ()\n        } else {\n          throw(\"builtin registry drift: '\\{n}' signature mismatch in the \\{lane} lane — registry says (params=\\{rp}, returns=\\{rr}), lane registered (params=\\{Array::get(param_counts, i)}, returns=\\{Array::get(returns, i)}) (#415)\")\n        }\n        ri = Array::length(reg)\n      } else {\n        ri = ri + 1\n      }\n    }\n    if found {\n      ()\n    } else {\n      throw(\"builtin registry drift: '\\{n}' is registered by the \\{lane} lane but has no row in vibe/compiler/codegen/builtin_registry.vibe (#415) — add one (and decide the other lane explicitly)\")\n    }\n    i = i + 1\n  }\n  // 2. every registry row claiming this lane must actually be registered.\n  // Exemption: the linear lane registers __rc_drop/__rc_alloc only when RC is\n  // enabled (VIBE_RC), so their absence in a bump-mode build is not drift —\n  // they stay direction-1 verified (if registered, the signature must match).\n  let mut ri2 = 0\n  while ri2 < Array::length(reg) {\n    let (rn2, _, _, rlin2, rgc2) = Array::get(reg, ri2)\n    let claimed2 = (if is_gc { rgc2 } else { rlin2 }) && not(String::starts_with(rn2, \"__rc_\"))\n    if claimed2 {\n      let mut found2 = false\n      let mut i2 = 0\n      while i2 < Array::length(names) {\n        if Array::get(names, i2) == rn2 {\n          found2 = true\n          i2 = Array::length(names)\n        } else {\n          i2 = i2 + 1\n        }\n      }\n      if found2 {\n        ()\n      } else {\n        throw(\"builtin registry drift: registry claims '\\{rn2}' is in the \\{lane} lane's table but the lane did not register it (#415)\")\n      }\n    } else {\n      ()\n    }\n    ri2 = ri2 + 1\n  }\n}\n")
}

let cli_adapter_source_68 = () -> (String, String) {
  ("vibe/compiler/codegen/double_to_string_expr.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\n// #744: fixed-precision Double→String, synthesized as ordinary AST and lowered\n// via each backend's `ce` at `__to_string` callsites whose argument is\n// statically floatish (string interpolation of a Double used to stringify the\n// raw f64 bits — `\"\\{42.0}\"` printed \"4631107791820423168\"). Integer part\n// exact; fraction as 15 scaled digits with trailing zeros trimmed (round-trips\n// human-scale values: 3.14 / 0.0125 / -1.5). Same algorithm as vibe/json's\n// format_number. String pieces are built with String::from_char_code so no\n// string-table seeding is needed. Beyond ~9e14 the fraction is meaningless:\n// integer part only. The synthesized code follows ordinary source conventions,\n// so RC boxing, the bump lane's raw bits, and the gc lane's raw bits all work\n// through each backend's normal float codegen paths. Shared by the linear\n// callsite handler (expr/compile_call.vibe) and the gc dispatch\n// (gc/backend_call.vibe) — keep it backend-agnostic.\nexport let double_to_string_expr: (Expr) -> Expr = (arg) -> {\n  let c1: (String, Expr) -> Expr = (f, a0) -> {\n    ECall(EIdent(f, -1), [\n      a0\n    ], -1)\n  }\n  let c2: (String, Expr, Expr) -> Expr = (f, a0, a1) -> {\n    ECall(EIdent(f, -1), [\n      a0,\n      a1\n    ], -1)\n  }\n  let c3: (String, Expr, Expr, Expr) -> Expr = (f, a0, a1, a2) -> {\n    ECall(EIdent(f, -1), [\n      a0,\n      a1,\n      a2\n    ], -1)\n  }\n  let n = EIdent(\"__dts_n\", -1)\n  let neg = EIdent(\"__dts_neg\", -1)\n  let a = EIdent(\"__dts_a\", -1)\n  let ip = EIdent(\"__dts_ip\", -1)\n  let frac = EIdent(\"__dts_frac\", -1)\n  let s0 = EIdent(\"__dts_s0\", -1)\n  let ip2 = EIdent(\"__dts_ip2\", -1)\n  let sc = EIdent(\"__dts_sc\", -1)\n  let istr = EIdent(\"__dts_istr\", -1)\n  let signed = EIdent(\"__dts_signed\", -1)\n  let ds = EIdent(\"__dts_ds\", -1)\n  let endv = EIdent(\"__dts_end\", -1)\n  let big = EIdent(\"__dts_big\", -1)\n  let ch_minus = c1(\"String::from_char_code\", EInt(45))\n  let ch_dot = c1(\"String::from_char_code\", EInt(46))\n  let ch_zero = c1(\"String::from_char_code\", EInt(48))\n  let scale_int = EInt(1000000000000000)\n  // 15 fractional digits: zero-pad to 15, trim trailing zeros, append.\n  let frac_tail = ELetMut(\"__dts_ds\", c1(\"__to_string\", sc), ELetMut(\"__dts_end\", EInt(15), ESeq(EWhile(EBinOp(\"<\", c1(\"String::length\", ds), EInt(15)), EAssign(\"__dts_ds\", c2(\"String::concat\", ch_zero, ds), EUnit)), ESeq(EWhile(EBinOp(\"==\", c2(\"String::char_code_at\", ds, EBinOp(\"-\", endv, EInt(1))), EInt(48)), EAssign(\"__dts_end\", EBinOp(\"-\", endv, EInt(1)), EUnit)), c2(\"String::concat\", signed, c2(\"String::concat\", ch_dot, c3(\"String::substring\", ds, EInt(0), endv)))))))\n  let signed_val = EIf(neg, EIf(EBinOp(\">\", ip2, EInt(0)), c2(\"String::concat\", ch_minus, istr), EIf(EBinOp(\">\", sc, EInt(0)), c2(\"String::concat\", ch_minus, istr), istr)), istr)\n  let small = ELet(\"__dts_ip\", c1(\"Double::to_int\", a), ELet(\"__dts_frac\", EBinOp(\"-\", a, c1(\"Int::to_double\", ip)), ELet(\"__dts_s0\", c1(\"Double::to_int\", EBinOp(\"+\", EBinOp(\"*\", frac, EFloat(1000000000000000.0)), EFloat(0.5))), ELet(\"__dts_ip2\", EIf(EBinOp(\">=\", s0, scale_int), EBinOp(\"+\", ip, EInt(1)), ip), ELet(\"__dts_sc\", EIf(EBinOp(\">=\", s0, scale_int), EInt(0), s0), ELet(\"__dts_istr\", c1(\"__to_string\", ip2), ELet(\"__dts_signed\", signed_val, EIf(EBinOp(\"==\", sc, EInt(0)), signed, frac_tail))))))))\n  let big_case = ELet(\"__dts_big\", c1(\"__to_string\", c1(\"Double::to_int\", a)), EIf(neg, c2(\"String::concat\", ch_minus, big), big))\n  ELet(\"__dts_n\", arg, ELet(\"__dts_neg\", EBinOp(\"<\", n, EFloat(0.0)), ELet(\"__dts_a\", EIf(neg, EBinOp(\"-\", EFloat(0.0), n), n), EIf(EBinOp(\">=\", a, EFloat(900000000000000.0)), big_case, small))))\n}\n")
}

let cli_adapter_source_69 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_call.vibe",
"//# Imports\n\nimport .. / .. / builtin_name.vibe {\n  canonical_builtin_name\n}\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  emit_rc_word_inc_saturating, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_rc_dup_guarded, effect_name_to_tag, effect_op_index, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_index_one, emit_str_ref, emit_unbox_float, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local, struct_field_candidates, struct_field_dispatch_cases\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data, emit_v128_load, emit_v128_store, emit_i8x16_splat, emit_i8x16_eq, emit_i8x16_le_u, emit_i8x16_ge_u, emit_v128_and, emit_v128_or, emit_v128_not, emit_i8x16_bitmask, emit_v128_any_true, emit_i8x16_all_true, emit_v128_const_splat_byte\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\nimport .. / double_to_string_expr.vibe {\n  double_to_string_expr\n}\n\n//# Functions\n\n// A field projection `a.f` (EDot) passed as an argument to an owning user\n// function (which drops its parameters) is a borrow of the source aggregate.\n// Without a retain the callee's param-drop frees it while the source still\n// references it — a double-free that corrupts the free list (e.g. derived\n// `T::equals` passing `a.items` to the consuming `__arr_equals__` helper, #704).\n// Perceus emits no action for bare projections, so this guarded dup is the only\n// owner-increment. Scalars are no-ops; this is NOT applied to borrow-arg0\n// builtins (Array::get/length etc.), which do not drop their argument.\nlet cc_is_projection: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _, _) => true,\n    _ => false\n  }\n}\n\n// #705: a borrow-RETURNING builtin call (`Array::get` / `Map::get` / `__index`)\n// yields a borrowed view of a heap element — its refcount is NOT bumped, like a\n// projection `a.f`. When that result is consumed in an OWNING position (a ctor\n// field, or an owning call arg of a fn that drops its params), it must be\n// rc_dup'd or the container's recursive drop and the consume double-free the\n// same element (e.g. `chk(Array::get(ps, i))` recursing over a heap array, or\n// `validate(s, Map::get(obj, key))`). Scalars are even so the guarded dup is a\n// runtime no-op for `Array[Int]` etc.\nexport let cc_is_borrow_ret_call: (Expr, CompileCtx) -> Bool = (e, ctx) -> {\n  match e {\n    ECall(callee, _, _) =>\n    match callee {\n      EIdent(f, _) => f == \"Array::get\" || f == \"Map::get\" || f == \"__index\" || f == \"__rec_field\" || array_contains_str(ctx.borrow_ret_names, f),\n      _ => false\n    },\n    _ => false\n  }\n}\n\n// Is `e` provably a scalar (Int/Bool) by structure alone — an int/bool literal,\n// a bitwise/shift/comparison/logical binop, or a logical `!`? Conservative: no\n// ident-slot/type lookup and no arith ops (+,-,*,/ can be Float). Used to route\n// an explicit `eq(a, b)` to a direct i64.eq when an operand is provably scalar,\n// matching how the `==` binop dispatches intish operands (emit_eq_value). Without\n// this, `eq(int, int)` falls through to the generic bound `eq` whose\n// `looks_like_string`/str_eq fallback reads OOB on ints resembling fat-pointers\n// (#678 residual) — e.g. leb128's `eq(val, 0)` trapped under RC (#705).\nlet rec cc_arg_is_scalarish: (Expr) -> Bool with { Error } = (e) -> {\n  let t = expr_tag(e)\n  if t == 0 || t == 1 {\n    true\n  } else if t == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\" || op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" || op == \"==\" || op == \"!=\" || op == \"&&\" || op == \"||\"\n  } else if t == 6 {\n    let uop = get_eunaryop_op(e)\n    // `!x` is Bool; `-x` is scalar iff its operand is (so a negative int literal\n    // like `-1`, which parses as unary minus of `1`, is detected as scalar).\n    uop == \"!\" || (uop == \"-\" && cc_arg_is_scalarish(get_eunaryop_expr(e)))\n  } else {\n    false\n  }\n}\n\n// #745: local mirror of compile_expr_tail's expr_is_floatish/slot_is_floatish\n// (importing them here would be a cycle: compile_expr_tail imports this file).\n// Used to route `eq(a, b)` with a float operand onto the unbox + f64.eq path\n// under RC — the scalar i64.eq below compares BOX POINTERS for boxed floats,\n// so `eq(0.0125, 0.0125)` came out false and the assert trapped.\nlet cc_slot_is_floatish: (CompileCtx, Int) -> Bool = (ctx, slot) -> {\n  let arr = ctx.float_local_slots\n  let mut j = Array::length(arr) - 1\n  let mut result = false\n  while j >= 0 {\n    let entry = Array::get(arr, j)\n    if entry / 2 == slot {\n      result = (entry % 2) == 1\n      j = -1\n    } else {\n      j = j - 1\n    }\n  }\n  result\n}\n\nlet rec cc_expr_is_floatish: (Expr, Array[String], CompileCtx) -> Bool with { Error } = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 2 {\n    true\n  } else if tag == 4 {\n    let nm = get_eident_name(e)\n    let len = Array::length(local_names)\n    let mut i = len - 1\n    let mut slot = -1\n    while i >= 0 {\n      if Array::get(local_names, i) == nm {\n        slot = i\n        i = -1\n      } else {\n        i = i - 1\n      }\n    }\n    if slot >= 0 {\n      cc_slot_is_floatish(ctx, slot)\n    } else {\n      false\n    }\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    if op == \"+\" || op == \"-\" || op == \"*\" || op == \"/\" {\n      cc_expr_is_floatish(get_ebinop_lhs(e), local_names, ctx) || cc_expr_is_floatish(get_ebinop_rhs(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 6 {\n    let op = get_eunaryop_op(e)\n    if op == \"-\" {\n      cc_expr_is_floatish(get_eunaryop_expr(e), local_names, ctx)\n    } else {\n      false\n    }\n  } else if tag == 8 {\n    let callee = get_ecall_callee(e)\n    if is_eident(callee) {\n      let fname = get_eident_name(callee)\n      fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_double\" || fname == \"Double::to_float\" || fname == \"Double::from_i64_bits\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\n// #706: is `e` a bare reference to a value live-in to an enclosing loop (and not\n// a `mut` ref-cell, whose reassignment already manages its own drop)? Passing\n// such a value to a consuming (owning) parameter inside the loop frees it on the\n// first iteration; dup'ing at the call site keeps the loop-carried reference\n// alive across the back-edge. rc_dup is a no-op on scalars, so a scalar loop var\n// caught here costs only a wasted (guarded) dup, not a correctness problem.\nexport let cc_is_loop_borrowed_ident: (Expr, CompileCtx) -> Bool = (e, ctx) -> {\n  match e {\n    EIdent(name, _) =>\n    array_contains_str(ctx.loop_borrowed_names, name) && !array_contains_str(ctx.ref_cell_names, name),\n    _ => false\n  }\n}\n\n// Builtins whose arg0 is BORROWED (read in place, not consumed/dropped). Kept in\n// sync with `is_borrow_arg0_call` in perceus/index.vibe — a projection passed as\n// arg0 to one of these must NOT be rc_dup'd at the call site (the callee never\n// drops it, so the dup would leak; #704). Other argument positions are owning.\nlet cc_is_borrow_arg0_call: (String) -> Bool = (f) -> {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\" || f == \"ArrayBuilder::push\" || f == \"StringBuilder::push\" || f == \"MapBuilder::set\" || f == \"Map::get\" || f == \"Map::keys\" || f == \"Map::has_key\" || f == \"Map::set\" || f == \"Bytes::push\" || f == \"Bytes::set\" || f == \"Bytes::get\" || f == \"Bytes::length\" || f == \"__rec_field\"\n}\n\n// #745: retain a borrowed argument that a STORING inline builtin (Map::set /\n// MapBuilder::set key+value) keeps a reference to. The generic owning-call\n// path already dups projection / borrow-returning-call / loop-borrowed args\n// (see the `__argdup` sites below), but the inline-emitted builtins compile\n// their args directly and skipped it — json's `build_json_map` stored\n// `Array::get(vals, i)` un-retained, and once `vals` died the map's entry\n// pointed at freed memory (ctor match on `Map::get` then read garbage).\n// Expects the freshly compiled arg on the wasm stack; leaves it there.\nlet cc_retain_stored_arg: (Bytes, Expr, Array[String], Int, CompileCtx) -> Int with { Error } = (buf, carg, local_names, nl, ctx) -> {\n  let is_loop_borrow = ctx.enable_rc && cc_is_loop_borrowed_ident(carg, ctx)\n  if ctx.enable_rc && (cc_is_projection(carg) || cc_is_borrow_ret_call(carg, ctx) || is_loop_borrow) {\n    // #706 leak follow-up: a loop-borrowed trigger needs the epilogue's\n    // compensating drop, same as the generic path's `__argdup` sites.\n    if is_loop_borrow {\n      Array::push(ctx.loop_consumed_names, get_eident_name(carg))\n    } else {\n      ()\n    }\n    Array::push(local_names, \"__argdup\")\n    emit_local_tee(buf, nl)\n    emit_rc_dup_guarded(buf, nl, ctx.rc_shadow)\n    nl + 1\n  } else {\n    nl\n  }\n}\n\n// #664/#678: is `e` statically — BY SHAPE — a known integer that must NOT be run\n// through `__to_string`'s string-pointer heuristic (which misreads a large int\n// as an empty string)? An Int literal, or a bitwise/shift/mod expression (those\n// operators are never float or string). Bare idents are deliberately excluded:\n// a per-slot \"is int\" log is unsound because slots are reused across scopes\n// without updating it. Covers `\"\\{1 << 40}\"` and integer-literal interpolation.\nlet ts_known_int: (Expr, Array[String], CompileCtx) -> Bool = (e, local_names, ctx) -> {\n  let tag = expr_tag(e)\n  if tag == 0 {\n    true\n  } else if tag == 5 {\n    let op = get_ebinop_op(e)\n    op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" || op == \"%\"\n  } else {\n    false\n  }\n}\n\nexport let compile_call: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {\n  if is_eident(callee) {\n    let fname0 = canonical_builtin_name(get_eident_name(callee))\n    // Stream[T] (docs/spec/wasi-p3-async.md §2.4) is backed by the eager Array\n    // machinery on the linear backend: map/fold reuse the existing inline\n    // Array::map / Array::fold lowering verbatim (same arg order, same value\n    // representation). empty/once/filter are handled explicitly below.\n    let fname = if fname0 == \"Stream::map\" {\n      \"Array::map\"\n    } else if fname0 == \"Stream::fold\" {\n      \"Array::fold\"\n    } else {\n      fname0\n    }\n    let fn_len2 = Array::length(ctx.func_table.names)\n    let mut fn_idx_in_list = -1\n    let mut __tr_j = 0\n    while __tr_j < fn_len2 {\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\n        fn_idx_in_list = __tr_j\n        __tr_j = fn_len2\n      } else {\n        __tr_j = __tr_j + 1\n      }\n    }\n    let mut local_idx_hint = -1\n    let mut li = Array::length(local_names) - 1\n    while li >= 0 {\n      if Array::get(local_names, li) == fname {\n        local_idx_hint = li\n        li = -1\n      } else {\n        li = li - 1\n      }\n    }\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\n    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(rec_fields) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = Array::slice([\n                EUnit\n              ], 0, 0)\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n                let mut found_rfv = EUnit\n                while ri < Array::length(rec_fields) {\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\n                  if rfn == target_name {\n                    found_rfv = rfv\n                    ri = Array::length(rec_fields)\n                  } else {\n                    ri = ri + 1\n                  }\n                }\n                Array::push(ordered, found_rfv)\n                oi = oi + 1\n              }\n              ordered\n            } else {\n              args\n            }\n          },\n          _ => args\n        }\n      } else {\n        args\n      }\n      if ctx.enable_rc {\n        let total = 16 + fc * 8\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          let carg_c = Array::get(actual_args, fi_c)\n          nl_c = ce(buf, carg_c, local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          // A heap field projection `a.f` stored into a constructor is a borrow;\n          // the constructed value OWNS its fields (drop class 1 recurses), so\n          // retain it or the source's drop double-frees it (e.g. `Some(b.items)`\n          // returned while `b` is dropped). Mirrors the ERecord field-store dup\n          // (#704). Perceus emits no action for bare projections.\n          // #715: also retain a bare-ident arg whose binding is borrow-bound or\n          // loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the ETuple\n          // case in compile_expr_tail2.vibe (see the comment there).\n          if ctx.enable_rc && (cc_is_projection(carg_c) || cc_is_borrow_ret_call(carg_c, ctx) || cc_is_loop_borrowed_ident(carg_c, ctx)) {\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\n          } else {\n            ()\n          }\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      } else {\n        let obj_size = 8 + fc * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n    }\n    else if fname == \"eq\" && Array::length(args) == 2 && ctx.enable_rc && (cc_expr_is_floatish(Array::get(args, 0), local_names, ctx) || cc_expr_is_floatish(Array::get(args, 1), local_names, ctx)) {\n      // #745: under RC floats are BOXED — the scalar i64.eq below would\n      // compare box pointers, so `eq(0.0125, 0.0125)` returned false. Take\n      // the same unbox + f64.eq path the `==` binop uses. Non-RC floats are\n      // raw f64 bits in an i64, where bitwise i64.eq matches the existing\n      // `==` behavior, so this branch is RC-only.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_unbox_float(buf)\n      emit_f64_reinterpret_i64(buf)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_unbox_float(buf)\n      emit_f64_reinterpret_i64(buf)\n      emit_f64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      // Tag the Bool like the scalar branch below (ADR-0055).\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n      nl\n    }\n    else if fname == \"eq\" && Array::length(args) == 2 && (!prefer_bound_call || cc_arg_is_scalarish(Array::get(args, 0)) || cc_arg_is_scalarish(Array::get(args, 1))) {\n      // Direct i64.eq for `eq(a, b)` when it is the builtin and at least one\n      // operand is provably scalar. This sidesteps the bound `eq`'s string\n      // fallback, which reads OOB on Int values resembling fat-pointers (#705):\n      // `==` already dispatches intish operands this way via emit_eq_value, and\n      // `eq` must match. A genuinely string/heap `eq` (no scalar operand) still\n      // falls through to the bound call below.\n      //\n      // #710/#711: keeping the scalarish disjunct (not just !prefer_bound_call)\n      // is required -- prefer_bound_call is a global cross-file name match, not\n      // scoped to the calling file (see #711), so dropping it regressed\n      // leb128_test.vibe. Root fix tracked in #711.\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      // ADR-0055: under RC a Bool is a TAGGED scalar (true = 1<<1). The raw\n      // i64.eq result is 0/1 (untagged); tag it so `eq(..) == true`/`if`/derived\n      // comparisons see the same representation as a bool literal (#705 — without\n      // this, `eq(a,b) == true` compared untagged 1 against tagged 2 and failed).\n      // The bump backend leaves bools untagged, so only shift under RC.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"not\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"await\" {\n      // M1b-3b (docs/spec/wasi-p3-async.md): awaiting a ready future yields the\n      // value directly (ready-future fast path). Real blocking future.read for\n      // async sources (host async imports / spawned subtasks) is M1b-3c.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Future::ready\" {\n      // Future::ready(x) carries x directly — no canon future is created for an\n      // already-resolved value.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::spawn\" {\n      // Structured concurrency, synchronous model (docs/spec/wasi-p3-async.md\n      // §2.5): on the single-threaded linear backend a spawned task runs its\n      // thunk eagerly, so the Task[T] value *is* the resolved result. `join`\n      // is then identity and `cancel` a no-op. Real subtask spawn over\n      // waitable-set / future.cancel is documented future work.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let fn_l = nl\n      let slot_l = nl + 1\n      let env_l = nl + 2\n      Array::push(local_names, \"__spawn_fn\")\n      Array::push(local_names, \"__spawn_slot\")\n      Array::push(local_names, \"__spawn_env\")\n      emit_local_set(buf, fn_l)\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 0)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"Task::join\" {\n      // The task already holds its resolved value (eager spawn) — join is the\n      // identity projection onto that value.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::cancel\" {\n      // The eager task has already completed; cancel evaluates the handle for\n      // its effects, drops it, and yields Unit.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_drop(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"Task::race\" {\n      // Both tasks are already resolved under the eager model; race resolves to\n      // the first task's value. (b is evaluated for its effects, then dropped.)\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_drop(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"Stream::empty\" {\n      // Empty stream = empty backing array.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      emit_call(buf, arr_new_fi)\n      next_local\n    }\n    else if !prefer_bound_call && fname == \"Stream::once\" {\n      // Singleton stream = one-element backing array.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let val_l = nl\n      let arr_l = nl + 1\n      Array::push(local_names, \"__once_val\")\n      Array::push(local_names, \"__once_arr\")\n      emit_local_set(buf, val_l)\n      emit_call(buf, arr_new_fi)\n      emit_local_set(buf, arr_l)\n      emit_local_get(buf, arr_l)\n      emit_local_get(buf, val_l)\n      emit_call(buf, arr_push_fi)\n      emit_local_get(buf, arr_l)\n      nl + 2\n    }\n    else if !prefer_bound_call && fname == \"Stream::filter\" {\n      // Eager filter: walk the backing array, keep elements whose predicate is\n      // truthy. Mirrors the Array::map loop but pushes conditionally.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let arr_l = nl\n      let fn_l = nl + 1\n      let res_l = nl + 2\n      let len_l = nl + 3\n      let i_l = nl + 4\n      let slot_l = nl + 5\n      let env_l = nl + 6\n      let elem_l = nl + 7\n      Array::push(local_names, \"__filter_arr\")\n      Array::push(local_names, \"__filter_fn\")\n      Array::push(local_names, \"__filter_res\")\n      Array::push(local_names, \"__filter_len\")\n      Array::push(local_names, \"__filter_i\")\n      Array::push(local_names, \"__filter_slot\")\n      Array::push(local_names, \"__filter_env\")\n      Array::push(local_names, \"__filter_elem\")\n      emit_local_set(buf, fn_l)\n      emit_local_set(buf, arr_l)\n      emit_call(buf, arr_new_fi)\n      emit_local_set(buf, res_l)\n      emit_local_get(buf, arr_l)\n      emit_call(buf, arr_len_fi)\n      emit_local_set(buf, len_l)\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_l)\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_l)\n      emit_local_get(buf, len_l)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      emit_local_get(buf, arr_l)\n      emit_local_get(buf, i_l)\n      emit_call(buf, arr_get_fi)\n      emit_local_set(buf, elem_l)\n      emit_local_get(buf, elem_l)\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 1)\n      emit_i64_const(buf, 0)\n      emit_i64_ne(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, res_l)\n      emit_local_get(buf, elem_l)\n      emit_call(buf, arr_push_fi)\n      emit_end(buf)\n      emit_local_get(buf, i_l)\n      emit_index_one(buf, ctx)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_l)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, res_l)\n      nl + 8\n    }\n    else if !prefer_bound_call && fname == \"Stream::next\" {\n      // Stream::next(s) : Future[Option[T]] (docs/spec §2.4). On the eager\n      // Array-backed model `next` peeks the head: Some(s[0]) if non-empty else\n      // None. Synthesize the Option expression and reuse the existing ctor +\n      // Array::length/get lowering via `ce`. (await unwraps the ready future.)\n      let s_expr = Array::get(args, 0)\n      let synth = ELet(\"__nx_s\", s_expr, EIf(ECall(EIdent(\"lt\", -1), [\n        EInt(0),\n        ECall(EIdent(\"Array::length\", -1), [\n          EIdent(\"__nx_s\", -1)\n        ], -1)\n      ], -1), ECall(EIdent(\"Some\", -1), [\n        ECall(EIdent(\"Array::get\", -1), [\n          EIdent(\"__nx_s\", -1),\n          EInt(0)\n        ], -1)\n      ], -1), ECall(EIdent(\"None\", -1), Array::slice([\n        EUnit\n      ], 0, 0), -1)))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::timeout\" {\n      // Task::timeout(ms, thunk) : Option[T] (docs/spec §2.5). Synchronous eager\n      // model: the thunk always completes, so the result is Some(thunk()); the\n      // deadline is evaluated for its effects then ignored. Synthesized and\n      // lowered via `ce` so the Some ctor + 0-arg closure call reuse existing\n      // lowering.\n      let ms_expr = Array::get(args, 0)\n      let thunk_expr = Array::get(args, 1)\n      let synth = ELet(\"__to_fn\", thunk_expr, ELet(\"__to_ms\", ms_expr, ECall(EIdent(\"Some\", -1), [\n        ECall(EIdent(\"__to_fn\", -1), Array::slice([\n          EUnit\n        ], 0, 0), -1)\n      ], -1)))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"String::to_bytes\" {\n      // String::to_bytes(s) : Stream[Int]  (ByteStream, docs/spec §2.4/§4.1).\n      // Eagerly materialise the string's bytes into the Array that backs a\n      // Stream[Int], so request/response bodies can be consumed with the Stream\n      // combinators. Synthesized as a `let mut arr = []; while i < length(s) {\n      // Array::push(arr, char_code_at(s, i)); i = i + 1 }; arr` loop and lowered\n      // via `ce`, so String::length/char_code_at + the loop counter follow the\n      // same (RC) tagging conventions as ordinary source. char_code_at reads one\n      // byte (i32.load8_u), so this is byte-accurate.\n      let s_expr = Array::get(args, 0)\n      let loop_body = ESeq(ECall(EIdent(\"Array::push\", -1), [\n        EIdent(\"__tb_arr\", -1),\n        ECall(EIdent(\"String::char_code_at\", -1), [\n          EIdent(\"__tb_s\", -1),\n          EIdent(\"__tb_i\", -1)\n        ], -1)\n      ], -1), EAssign(\"__tb_i\", ECall(EIdent(\"add\", -1), [\n        EIdent(\"__tb_i\", -1),\n        EInt(1)\n      ], -1), EUnit))\n      let synth = ELet(\"__tb_s\", s_expr, ELetMut(\"__tb_arr\", EArray(Array::slice([\n        EUnit\n      ], 0, 0)), ELetMut(\"__tb_i\", EInt(0), ESeq(EWhile(ECall(EIdent(\"lt\", -1), [\n        EIdent(\"__tb_i\", -1),\n        ECall(EIdent(\"String::length\", -1), [\n          EIdent(\"__tb_s\", -1)\n        ], -1)\n      ], -1), loop_body), EIdent(\"__tb_arr\", -1)))))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Stream::to_string\" {\n      // Stream::to_string(bs) : String  (ByteStream -> String, docs/spec\n      // §M2c-2). Collect a Stream[Int] of byte codes into a String, e.g. to\n      // build a response body. Synthesized as `let parts = []; while i <\n      // length(bs) { Array::push(parts, String::from_char_code(bs[i])); i = i +\n      // 1 }; String::join(parts, \"\")` and lowered via `ce`. Pushing one-char\n      // pieces and joining once is O(n); the earlier `acc = String::concat(acc,\n      // ...)` accumulator was O(n^2) (each concat copied the whole prefix), the\n      // dominant cost in the streaming bench (4 KB to_string: 1.77s -> see\n      // scripts/bench_streaming.sh). linked_compile always seeds \"\" into the\n      // string table, so the join separator literal resolves.\n      let bs_expr = Array::get(args, 0)\n      let ts_body = ESeq(ECall(EIdent(\"Array::push\", -1), [\n        EIdent(\"__ts_parts\", -1),\n        ECall(EIdent(\"String::from_char_code\", -1), [\n          ECall(EIdent(\"Array::get\", -1), [\n            EIdent(\"__ts_arr\", -1),\n            EIdent(\"__ts_i\", -1)\n          ], -1)\n        ], -1)\n      ], -1), EAssign(\"__ts_i\", ECall(EIdent(\"add\", -1), [\n        EIdent(\"__ts_i\", -1),\n        EInt(1)\n      ], -1), EUnit))\n      let synth = ELet(\"__ts_arr\", bs_expr, ELetMut(\"__ts_parts\", EArray(Array::slice([\n        EUnit\n      ], 0, 0)), ELetMut(\"__ts_i\", EInt(0), ESeq(EWhile(ECall(EIdent(\"lt\", -1), [\n        EIdent(\"__ts_i\", -1),\n        ECall(EIdent(\"Array::length\", -1), [\n          EIdent(\"__ts_arr\", -1)\n        ], -1)\n      ], -1), ts_body), ECall(EIdent(\"String::join\", -1), [\n        EIdent(\"__ts_parts\", -1),\n        EString(\"\")\n      ], -1)))))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"add\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_add(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"sub\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"mul\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_mul(buf)\n      // Under RC, Int values are tagged `(n << 1)`. Multiplying two tagged\n      // operands raw gives `(a*b) << 2` (an extra factor of 2 vs. the `<< 1`\n      // every other Int carries) -- shift right once to correct back, exactly\n      // like the `*` EBinOp path does (compile_expr.vibe `op == \"*\"`) that\n      // this builtin fast path duplicates but had not mirrored.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n      } else {\n        ()\n      }\n      nl\n    }\n    else if !prefer_bound_call && fname == \"lt\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      // Under RC, Bool values are also tagged `(0|1) << 1` (mirrors the `<`\n      // EBinOp path's retag) -- untagged here means callers see 0 (== false\n      // tagged) but a true result reads as