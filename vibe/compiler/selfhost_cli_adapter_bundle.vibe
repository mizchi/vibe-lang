_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n  if use_host {\n    // fd_write + the nine \"vibe\" host imports (types: 3=(i64)->i64,\n    // 5=()->i64, 6=(i64,i64)->()) -- the linear backend's raw tagged ABI.\n    let imp_content = bytebuf_new()\n    bytebuf_push_vec_header(imp_content, 11)\n    emit_name(imp_content, \"wasi_snapshot_preview1\")\n    emit_name(imp_content, \"fd_write\")\n    bytebuf_push(imp_content, 0)\n    leb128_encode_u32(imp_content, 0)\n    let host_imports = [\n      (\"env-get\", 3),\n      (\"args-len\", 5),\n      (\"args-get\", 3),\n      (\"fs_read_file\", 3),\n      (\"fs_exists\", 3),\n      (\"fs_stat_token\", 3),\n      (\"fs_write_file\", 6),\n      (\"fs_write_bytes\", 6),\n      (\"fs_read_bytes\", 3),\n      (\"profile-now-us\", 5)\n    ]\n    let mut __hi = 0\n    while __hi < Array::length(host_imports) {\n      let (hin, hit) = Array::get(host_imports, __hi)\n      emit_name(imp_content, \"vibe\")\n      emit_name(imp_content, hin)\n      bytebuf_push(imp_content, 0)\n      leb128_encode_u32(imp_content, hit)\n      __hi = __hi + 1\n    }\n    bytebuf_push_section(out, 2, imp_content)\n  } else {\n    emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  }\n  let func_type_indices = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(func_type_indices, 1)\n  Array::push(func_type_indices, 1)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 5)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 6)\n  Array::push(func_type_indices, 7)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 4)\n  Array::push(func_type_indices, 3)\n  Array::push(func_type_indices, 8)\n  Array::push(func_type_indices, 3)\n  Ar