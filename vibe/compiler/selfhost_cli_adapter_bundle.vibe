  let cli_adapter_source_65 = ("vibe/compiler/codegen/wasi/linked_helpers.vibe",
"//# Imports\n\nimport .. / .. / builtin_name.vibe {\n  canonical_builtin_name\n}\n\nimport .. / .. / core {\n  Expr, Stmt\n}\n\nimport .. / common_analysis {\n  collect_free_vars\n}\n\nimport .. / common_extractors {\n  array_contains_str\n}\n\n//# Functions\n\nlet expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n")

  let cli_adapter_source_66 = ("vibe/compiler/codegen/wasi/linked_compile.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / .. / perceus {\n  PerceusAction, build_perceus_plan, build_perceus_plan_with_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, type_expr_is_heap\n}\n\nimport .. / builtin_bodies {\n  gen_rc_drop_body, gen_rc_alloc_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_push_body, gen_arr_set_body, gen_bytes_append_body, gen_bytes_concat_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_len_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_selfhost_sources_proper_body, gen_selfhost_sources_stub_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body, static_arr_concat_body, static_arr_get_body, static_arr_len_body, static_arr_new_body, static_arr_push_all_body, static_arr_push_body, static_arr_set_body, static_arr_slice_body, static_arr_truncate_body, static_double_to_int_body, static_fs_stub_body, static_fs_write_bytes_stub_body, static_identity_body, static_int_to_double_body, static_print_i64_body, static_print_str_body, static_str_char_code_at_body, static_str_concat_body, static_str_eq_body, static_str_from_char_code_body, static_str_len_body, static_str_substring_body\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit