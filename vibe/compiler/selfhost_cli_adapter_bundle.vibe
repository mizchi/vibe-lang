 ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\n                }, pte)\n                if pinfo > 0 {\n                  Array::push(gc_agg_slots_f, psi * 256 + pinfo)\n                } else {\n                  ()\n                }\n                match pte {\n                  TyName(ptn) => if ptn == \"Float\" || ptn == \"Double\" {\n                    let (psname, _) = Array::get(params, psi)\n                    Array::push(gc_float_names_f, psname)\n                  } else {\n                    ()\n                  },\n                  _ => ()\n                }\n              },\n              None => ()\n            }\n            psi = psi + 1\n          }\n          let ref_cell_names_f = Array::slice([\n            \"\"\n          ], 0, 0)\n          let ref_local_indices_f = Array::slice([\n            0\n          ], 0, 0)\n          let ft = FuncTable::{\n            names: ft_names,\n            indices: ft_indices,\n            params: ft_params,\n            returns: ft_returns,\n            needs_env: ft_needs_env\n          }\n          let st = StrTable::{\n            strs: str_strs, offsets: str_offsets, lengths: str_lengths\n          }\n          let ct = CtorTable::{\n            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\n          }\n          let func_ctx = CompileCtxGc::{\n            func_table: ft, str_table: st, lambda_table: lt_w,\n            num_user_funcs: num_user_funcs, func_offset: func_offset,\n            ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\n            refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\n            gc_ctor_table: ct,\n            gc_const_names: gc_const_names_l, gc_const_kinds: gc_const_kinds_l,\n            gc_const_ivals: gc_const_ivals_l, gc_const_svals: gc_const_svals_l,\n            gc_global_names: gc_global_names_l,\n            gc_float_locals: gc_float_names_f,\n            gc_agg_local_slots: gc_agg_slots_f,\n            gc_agg_ret_names: gc_agg_ret_names_l,\n            gc_agg_ret_infos: gc_agg_ret_infos_l\n          }\n          let final_nl = compile_expr_gc(body_buf, body, local_names, param_count, func_ctx, -1)\n          Array::push(bodies, body_buf)\n          let extra = if final_nl > param_count {\n            final_nl - param_count\n          } else {\n            0\n          }\n          Array::push(meta_i32, 0)\n          Array::push(meta_i64, extra)\n          Array::push(user_ref_local_indices_all, ref_local_indices_f)\n        },\n        _ => throw(\"expected function\")\n      }\n      ,\n      _ => throw(\"expected let statement\")\n    }\n    bi = bi + 1\n  }\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = Array::get(ft_params, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  // #538: initialize computed module-level globals (statement order) before\n  // the entry runs. Compiled with a fresh local frame; lambdas created here\n  // land in lt_w like any other (num_lambdas is computed AFTER this).\n  let mut start_extra_locals = 0\n  if Array::length(gc_global_names_l) > 0 {\n    let init_ref_cells = Array::slice([\n      \"\"\n    ], 0, 0)\n    let init_ref_idx = Array::slice([\n      0\n    ], 0, 0)\n    let init_ctx = CompileCtxGc::{\n      func_table: FuncTable::{\n        names: ft_names, indices: ft_indices, params: ft_params,\n        returns: ft_returns, needs_env: ft_needs_env\n      },\n      str_table: StrTable::{\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\n      },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: init_ref_cells, ref_local_indices: init_ref_idx,\n      