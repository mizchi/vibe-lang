, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n// #665: bind a multi-operation handler arm's payload from a temp local holding\n// the thrown value (instead of the operand stack), so each arm in the dispatch\n// chain rebinds the same payload per its own pattern. Mirrors the single-arm\n// binding but loads from `raw_l`.\nlet t6_bind_from_raw: (Bytes, Pat, Int, CompileCtx, Array[String]) -> Unit with { Error } = (buf, arm_pat, raw_l, ctx, local_names) -> {\n  if is_pctor(arm_pat) {\n    let cargs = get_pctor_args(arm_pat)\n    let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(arm_pat))\n    if decl_arity > 1 {\n      let ncargs = Array::length(cargs)\n      let mut ci = 0\n      while ci < decl_arity {\n        if ci < ncargs {\n          let cp = Array::get(cargs, ci)\n          if is_pbind(cp) {\n            let pname = get_pbind_name(cp)\n            let fl = Array::length(local_names)\n            emit_local_get(buf, raw_l)\n            if ctx.enable_rc {\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n            } else {\n              ()\n            }\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, if ctx.enable_rc {\n              8 + ci * 8\n            } else {\n              ci * 8\n            })\n            emit_local_set(buf, fl)\n            Array::push(local_names, pname)\n            if ctx.enable_rc {\n              emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n            } else {\n              ()\n            }\n          } else if is_pwild(cp) {\n            ()\n          } else {\n            throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n          }\n        } else {\n          ()\n        }\n        ci = ci + 1\n      }\n      if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n        emit_local_get(buf, raw_l)\n        emit_call(buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n    } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n      let pname = get_pbind_name(Array::get(cargs, 0))\n      let bl = Array::length(local_names)\n      emit_local_get(buf, raw_l)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\n// #665: count the operations declared by `eff_name` in the global op-key table.\nlet t6_effect_op_count: (Array[String], String) -> Int = (op_keys, eff_name) -> {\n  let mut c = 0\n  let mut i = 0\n  while i < Array::length(op_keys) {\n    let k = Array::get(op_keys, i)\n    let sep = String::index_of(k, \"::\")\n    if sep > 0 && k[0:sep] == eff_name {\n      c = c + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  c\n}\n\n\nexport let compile_expr_tail6: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, body, arms, local_names, next_local, ctx, ld, compile_expr) -> {\n  if Array::length(arms) > 0 {\n    let (catch_pat, fallback_expr) = Array::get(arms, 0)\n    let is_error = is_pctor(catch_pat) && get_pctor_name(catch_pat) == \"Error::Throw\"\n    // #665: a handler over a MULTI-operation effect must dispatch the performed\n    // operation (g_op_index) to the matching arm. Single-operation effects and\n    // `Error` keep the original single-arm path unchanged.\n    let handled_eff = if is_pctor(catch_pat) {\n      let op_full = get_pctor_name(catch_pat)\n      let sep = String::index_of(op_full, \"::\")\n      if sep > 0 {\n        op_full[0:sep]\n      } else {\n        \"\"\n      }\n    } else {\n      \"\"\n    }\n    let needs_op_dispatch = !is_error && String::length(handled_eff) > 0 && t6_effect_op_count(ctx.effect_op_keys, handled_eff) > 1\n    let g_op_idx_global = if ctx.enable_rc {\n      6\n    } else {\n      5\n    }\n    let catch_tag = if is_error {\n      2\n    } else if is_pctor(catch_pat) {\n      effect_name_to_tag(ctx.effect_names, get_pctor_name(catch_pat))\n    } else {\n      3 + Array::length(ctx.effect_names)\n    }\n    let uses_frontier = !is_error\n    // #553: per-effect region stride; MUST match eff_reserve in\n    // linked_compile.vibe and compile_call.vibe.\n    let eff_off = (catch_tag - 3) * 131072\n    let g_rbuf = if ctx.enable_rc {\n      5\n    } else {\n      4\n    }\n    let g_cur = if ctx.enable_rc {\n      3\n    } else {\n      2\n    }\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 8)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    emit_loop_void(buf)\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_const(buf, 0)\n      emit_i64_store(buf, 3, 0)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, catch_tag)\n    bytebuf_push(buf, 0)\n    let _nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    let raw_l = Array::length(local_names)\n    if needs_op_dispatch {\n      emit_local_set(buf, raw_l)\n      Array::push(local_names, \"__eff_raw\")\n    } else if is_pctor(catch_pat) {\n      let cargs = get_pctor_args(catch_pat)\n      let decl_arity = effect_op_declared_arity(ctx.effect_op_keys, ctx.effect_op_arities, get_pctor_name(catch_pat))\n      if decl_arity > 1 {\n        let ptr_l = Array::length(local_names)\n        emit_local_set(buf, ptr_l)\n        Array::push(local_names, \"__eff_payload\")\n        let ncargs = Array::length(cargs)\n        let mut ci = 0\n        while ci < decl_arity {\n          if ci < ncargs {\n            let cp = Array::get(cargs, ci)\n            if is_pbind(cp) {\n              let pname = get_pbind_name(cp)\n              let fl = Array::length(local_names)\n              emit_local_get(buf, ptr_l)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              } else {\n                ()\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + ci * 8\n              } else {\n                ci * 8\n              })\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              if ctx.enable_rc {\n                emit_rc_dup_guarded(buf, fl, ctx.rc_shadow)\n              } else {\n                ()\n              }\n            } else if is_pwild(cp) {\n              ()\n            } else {\n              throw(\"handle: only simple bindings or '_' are supported in multi-argument effect op patterns (see #548)\")\n            }\n          } else {\n            ()\n          }\n          ci = ci + 1\n        }\n        if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n          emit_local_get(buf, ptr_l)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else {\n          ()\n        }\n      } else if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n        let pname = get_pbind_name(Array::get(cargs, 0))\n        let bl = Array::length(local_names)\n        emit_local_set(buf, bl)\n        Array::push(local_names, pname)\n      } else {\n        emit_drop(buf)\n      }\n    } else if is_pbind(catch_pat) {\n      let pname = get_pbind_name(catch_pat)\n      let bl = Array::length(local_names)\n      emit_local_set(buf, bl)\n      Array::push(local_names, pname)\n    } else {\n      emit_drop(buf)\n    }\n    if uses_frontier {\n      emit_global_get(buf, g_rbuf)\n      emit_i32_const(buf, eff_off)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_global_set(buf, g_cur)\n    } else {\n      ()\n    }\n    emit_block_i64(buf)\n    bytebuf_push(buf, 31)\n    bytebuf_push(buf, 126)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    bytebuf_push(buf, 1)\n    bytebuf_push(buf, 0)\n    let nl2 = if needs_op_dispatch {\n      // #665: dispatch the unwinding operation (g_op_index) to the matching arm.\n      // No truncation of local_names between arms (avoids reusing wasm-local\n      // indices that a sibling/earlier handler's arm bodies leave live).\n      let mut max_nl = Array::length(local_names)\n      let mut di = 0\n      while di < Array::length(arms) {\n        let (apat, abody) = Array::get(arms, di)\n        let aop = if is_pctor(apat) {\n          effect_op_index(ctx.effect_op_keys, get_pctor_name(apat))\n        } else {\n          0 - 1\n        }\n        emit_global_get(buf, g_op_idx_global)\n        emit_i64_const(buf, aop)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        t6_bind_from_raw(buf, apat, raw_l, ctx, local_names)\n        let anl = compile_expr(buf, abody, local_names, Array::length(local_names), ctx, ld)\n        if anl > max_nl {\n          max_nl = anl\n        } else {\n          ()\n        }\n        emit_else(buf)\n        di = di + 1\n      }\n      bytebuf_push(buf, 0)\n      let mut ce = 0\n      while ce < Array::length(arms) {\n        emit_end(buf)\n        ce = ce + 1\n      }\n      max_nl\n    } else {\n      compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n    }\n    emit_end(buf)\n    emit_br(buf, 2)\n    emit_end(buf)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    bytebuf_push(buf, 0)\n    emit_end(buf)\n    nl2\n  } else {\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\n  }\n}\n")
}

