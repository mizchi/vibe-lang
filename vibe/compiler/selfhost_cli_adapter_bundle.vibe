let cli_adapter_source_28 = () -> (String, String) {
  ("vibe/compiler/checker/checker_resolve.vibe",
"//# Imports\n\nimport .. / core / ast.vibe {\n  TypeExpr\n}\n\nimport .. / core / types.vibe {\n  Type, TypeDef, find_typedef, resolve_builtin\n}\n\n//# Functions\n\n// Substitute a parameterized type alias's formal params with actual type args.\n// The alias body was resolved with its params as free `CtNamed(<param>, _)`\n// names; replace each by the corresponding actual argument (recursively).\nexport let rec subst_type_params: (Type, Array[String], Array[Type]) -> Type = (ty, params, args) -> {\n  match ty {\n    CtNamed(name, targs) => {\n      let mut idx = 0 - 1\n      let mut i = 0\n      while i < Array::length(params) {\n        if Array::get(params, i) == name {\n          idx = i\n        }\n        i = i + 1\n      }\n      if idx >= 0 && idx < Array::length(args) {\n        Array::get(args, idx)\n      } else {\n        CtNamed(name, for a in targs {\n          subst_type_params(a, params, args)\n        })\n      }\n    },\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\n    CtTuple(es) => CtTuple(for e in es {\n      subst_type_params(e, params, args)\n    }),\n    CtFn(ps, ret, eff) => {\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\n    },\n    _ => ty\n  }\n}\n\nexport let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _, _) => CtEnum(n),\n          TDStruct(n, _) => CtStruct(n),\n          TDAlias(_, _, t) => t\n        },\n        None => CtNamed(name, Array::slice([\n          CtUnknown\n        ], 0, 0))\n      }\n    },\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if name == \"Array\" {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if name == \"Option\" {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else {\n        // Expand a parameterized type alias `Foo[A] = Body` applied as `Foo[X]`\n        // by substituting its formal params; otherwise it stays nominal.\n        match find_typedef(defs, name) {\n          Some(td) => match td {\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\n            _ => CtNamed(name, ra)\n          },\n          None => CtNamed(name, ra)\n        }\n      }\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret, effect_name) => {\n      let ret_box = Array::slice([\n        ret\n      ], 0, 1)\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\n    }\n  }\n}\n")
}

let cli_adapter_source_29 = () -> (String, String) {
  ("vibe/compiler/checker/checker_pattern.vibe",
"//# Imports\n\nimport .. / core {\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\n}\n\nimport ./checker_resolve.vibe {\n  subst_type_params\n}\n\n//# Functions\n\nlet find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {\n  let dlen = Array::length(defs)\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, _, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if vname == ctor_name {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\nexport let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => env,\n    PString(_) => env,\n    PBool(_) => env,\n    PCtor(name, sub_pats) => {\n      let builtin_payload = match scrutinee_ty {\n        CtOption(elem) => if name == \"Some\" {\n          Some([\n            elem\n          ])\n        } else if name == \"None\" {\n          Some(Array::slice([\n            CtUnknown\n          ], 0, 0))\n        } else {\n          None\n        },\n        _ => None\n      }\n      let ctor_payload = match builtin_payload {\n        Some(types) => Some((\"Option\", types)),\n        None => find_ctor_in_defs(defs, name)\n      }\n      match ctor_payload {\n        Some(info) => {\n          let (enum_name, raw_payload) = info\n          // Instantiate the variant's field types for a parameterized enum:\n          // substitute the enum's formal params with the scrutinee's actual type\n          // args (e.g. matching `Ok(inner)` on `Result[Result[T,E], E]` types\n          // `inner` as `Result[T,E]`, not the bare enum param).\n          let payload_types = match scrutinee_ty {\n            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {\n              Some(td) => match td {\n                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {\n                  for pt in raw_payload {\n                    subst_type_params(pt, eparams, sargs)\n                  }\n                } else {\n                  raw_payload\n                },\n                _ => raw_payload\n              },\n              None => raw_payload\n            },\n            _ => raw_payload\n          }\n          let splen = Array::length(sub_pats)\n          let ptlen = Array::length(payload_types)\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let sub_ty = if i < ptlen {\n                Array::get(payload_types, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)\n              bind_subs(i + 1, next_env)\n            }\n          }\n          bind_subs(0, env)\n        },\n        None => {\n          let splen = Array::length(sub_pats)\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)\n              bind_unknown(i + 1, next_env)\n            }\n          }\n          bind_unknown(0, env)\n        }\n      }\n    },\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs),\n    PStruct(_, fields) => {\n      let flen = Array::length(fields)\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n        if i >= flen {\n          acc_env\n        } else {\n          let (_, fpat) = Array::get(fields, i)\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs)\n          bind_fields(i + 1, next_env)\n        }\n      }\n      bind_fields(0, env)\n    }\n  }\n}\n")
}

let cli_adapter_source_30 = () -> (String, String) {
  ("vibe/compiler/checker_trait.vibe",
"//# Imports\n\nimport ./types.vibe {\n  Subst, Type, TypeEnv, impls_overlap_for, trait_defined, type_implements_trait\n}\n\n//# Functions\n\nlet one_super: (String) -> Array[String] = (name) -> {\n  [\n    name\n  ]\n}\n\nlet no_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nexport let satisfies_bound: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, bound) -> {\n  type_implements_trait(env, s, ty, bound)\n}\n\nexport let check_bounds_satisfied: (TypeEnv, Subst, Type, Array[String]) -> Array[String] = (env, s, ty, bounds) -> {\n  let result = empty_strings()\n  let len = Array::length(bounds)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let bound = Array::get(bounds, i)\n      if not(satisfies_bound(env, s, ty, bound)) {\n        Array::push(result, bound)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let register_builtin_traits: (TypeEnv) -> TypeEnv = (env) -> {\n  let no_supers = empty_strings()\n  let eq_supers = one_super(\"Eq\")\n  let i64_type = CtNamed(\"i64\", no_type_args())\n  let u8_type = CtNamed(\"u8\", no_type_args())\n  let u16_type = CtNamed(\"u16\", no_type_args())\n  let u32_type = CtNamed(\"u32\", no_type_args())\n  let u64_type = CtNamed(\"u64\", no_type_args())\n  let i16_type = CtNamed(\"i16\", no_type_args())\n  let e1 = EnvTraitDef(\"Eq\", no_supers, false, env)\n  let e2 = EnvTraitDef(\"Ord\", eq_supers, false, e1)\n  let e3 = EnvTraitDef(\"Add\", no_supers, false, e2)\n  let e4 = EnvTraitDef(\"Sub\", no_supers, false, e3)\n  let e5 = EnvTraitDef(\"Mul\", no_supers, false, e4)\n  let e6 = EnvTraitDef(\"Div\", no_supers, false, e5)\n  let e7 = EnvTraitImpl(\"Eq\", CtInt, e6)\n  let e8 = EnvTraitImpl(\"Eq\", CtDouble, e7)\n  let e9 = EnvTraitImpl(\"Eq\", CtString, e8)\n  let e10 = EnvTraitImpl(\"Eq\", CtBool, e9)\n  let e11 = EnvTraitImpl(\"Ord\", CtInt, e10)\n  let e12 = EnvTraitImpl(\"Ord\", CtDouble, e11)\n  let e13 = EnvTraitImpl(\"Ord\", CtString, e12)\n  let e14 = EnvTraitImpl(\"Add\", CtInt, e13)\n  let e15 = EnvTraitImpl(\"Add\", CtDouble, e14)\n  let e16 = EnvTraitImpl(\"Sub\", CtInt, e15)\n  let e17 = EnvTraitImpl(\"Sub\", CtDouble, e16)\n  let e18 = EnvTraitImpl(\"Mul\", CtInt, e17)\n  let e19 = EnvTraitImpl(\"Mul\", CtDouble, e18)\n  let e20 = EnvTraitImpl(\"Div\", CtInt, e19)\n  let e21 = EnvTraitImpl(\"Div\", CtDouble, e20)\n  let e22 = EnvTraitImpl(\"Eq\", i64_type, e21)\n  let e23 = EnvTraitImpl(\"Eq\", u8_type, e22)\n  let e24 = EnvTraitImpl(\"Eq\", u16_type, e23)\n  let e25 = EnvTraitImpl(\"Eq\", u32_type, e24)\n  let e26 = EnvTraitImpl(\"Eq\", u64_type, e25)\n  let e27 = EnvTraitImpl(\"Eq\", i16_type, e26)\n  let e28 = EnvTraitImpl(\"Ord\", i64_type, e27)\n  let e29 = EnvTraitImpl(\"Ord\", u8_type, e28)\n  let e30 = EnvTraitImpl(\"Ord\", u16_type, e29)\n  let e31 = EnvTraitImpl(\"Ord\", u32_type, e30)\n  let e32 = EnvTraitImpl(\"Ord\", u64_type, e31)\n  let e33 = EnvTraitImpl(\"Ord\", i16_type, e32)\n  let e34 = EnvTraitImpl(\"Add\", i64_type, e33)\n  let e35 = EnvTraitImpl(\"Add\", u8_type, e34)\n  let e36 = EnvTraitImpl(\"Add\", u16_type, e35)\n  let e37 = EnvTraitImpl(\"Add\", u32_type, e36)\n  let e38 = EnvTraitImpl(\"Add\", u64_type, e37)\n  let e39 = EnvTraitImpl(\"Add\", i16_type, e38)\n  let e40 = EnvTraitImpl(\"Sub\", i64_type, e39)\n  let e41 = EnvTraitImpl(\"Sub\", u8_type, e40)\n  let e42 = EnvTraitImpl(\"Sub\", u16_type, e41)\n  let e43 = EnvTraitImpl(\"Sub\", u32_type, e42)\n  let e44 = EnvTraitImpl(\"Sub\", u64_type, e43)\n  let e45 = EnvTraitImpl(\"Sub\", i16_type, e44)\n  let e46 = EnvTraitImpl(\"Mul\", i64_type, e45)\n  let e47 = EnvTraitImpl(\"Mul\", u8_type, e46)\n  let e48 = EnvTraitImpl(\"Mul\", u16_type, e47)\n  let e49 = EnvTraitImpl(\"Mul\", u32_type, e48)\n  let e50 = EnvTraitImpl(\"Mul\", u64_type, e49)\n  let e51 = EnvTraitImpl(\"Mul\", i16_type, e50)\n  let e52 = EnvTraitImpl(\"Div\", i64_type, e51)\n  let e53 = EnvTraitImpl(\"Div\", u8_type, e52)\n  let e54 = EnvTraitImpl(\"Div\", u16_type, e53)\n  let e55 = EnvTraitImpl(\"Div\", u32_type, e54)\n  let e56 = EnvTraitImpl(\"Div\", u64_type, e55)\n  let e57 = EnvTraitImpl(\"Div\", i16_type, e56)\n  e57\n}\n\nexport let validate_supers_defined: (TypeEnv, Array[String]) -> Array[String] = (env, supers) -> {\n  let result = empty_strings()\n  let len = Array::length(supers)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let name = Array::get(supers, i)\n      if not(trait_defined(env, name)) {\n        Array::push(result, name)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let validate_impl_no_overlap: (TypeEnv, String, Type) -> Bool = (env, trait_name, target) -> {\n  not(impls_overlap_for(env, trait_name, target))\n}\n")
}

let cli_adapter_source_31 = () -> (String, String) {
  ("vibe/compiler/checker/checker.vibe",
"//# Imports\n\nimport .. / core / ast.vibe {\n  Expr\n}\n\nimport .. / core / types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, subst_add_bound, subst_apply, type_implements_trait, type_to_string, unify\n}\n\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\nimport ./checker_pattern.vibe {\n  check_pattern\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet min_int: (Int, Int) -> Int = (a, b) -> {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nlet prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nlet expr_ident_name_or_empty: (Expr) -> String = (expr) -> {\n  match expr {\n    EIdent(name) => name,\n    _ => \"\"\n  }\n}\n\nlet unify_call_args: (Array[Type], Array[Type], Subst) -> Subst = (param_tys, arg_tys, s) -> {\n  let mut out = s\n  let mut ui = 0\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n  while ui < ul {\n    out = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), out) {\n      Some(su) => su,\n      None => out\n    }\n    ui = ui + 1\n  }\n  out\n}\n\nexport let fn_return_env_name: (String) -> String = (name) -> {\n  String::concat(\"__fn_ret__:\", name)\n}\n\nlet direct_builtin_return: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::length\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_length\" || name == \"String::iter_length\" || name == \"Map::iter_length\" {\n    Some(CtInt)\n  }\n  else if name == \"Array::length\" {\n    Some(CtInt)\n  }\n  else if name == \"FixedArray::length\" {\n    Some(CtInt)\n  }\n  else if name == \"String::length\" {\n    Some(CtInt)\n  }\n  else if name == \"Bytes::get\" || name == \"String::index_of\" || name == \"String::char_code_at\" || name == \"String::last_index_of\" || name == \"Char::to_int\" || name == \"Double::to_int\" || name == \"Double::to_i64_bits\" || name == \"Double::to_i64_bits_lo\" || name == \"Double::to_i64_bits_hi\" || name == \"Env::args_len\" || name == \"Stdin::read_char\" {\n    Some(CtInt)\n  }\n  else if name == \"String::equals\" || name == \"String::contains\" || name == \"String::starts_with\" || name == \"String::ends_with\" || name == \"Array::any\" || name == \"Array::all\" || name == \"Array::contains\" || name == \"Map::has_key\" || name == \"map_has\" || name == \"Path::is_absolute\" || name == \"Fs::exists\" || name == \"Fs::is_dir\" || name == \"Fs::is_file\" || name == \"eq\" || name == \"not\" {\n    Some(CtBool)\n  }\n  else if name == \"String::concat\" || name == \"String::substring\" || name == \"String::trim\" || name == \"String::to_lower\" || name == \"String::to_upper\" || name == \"String::from_char_code\" || name == \"String::join\" || name == \"Array::join\" || name == \"Path::to_string\" || name == \"Path::resolve\" || name == \"PromptText::new\" || name == \"Stdin::read_stream\" || name == \"Env::get\" || name == \"Env::args_get\" || name == \"Fs::read_file\" || name == \"Fs::getcwd\" || name == \"sh\" || name == \"Lines::stringify\" || name == \"Llm::complete\" || name == \"Rlm::run\" || name == \"Rlm::finalize\" || name == \"__to_string\" {\n    Some(CtString)\n  }\n  else if name == \"__len\" {\n    Some(CtInt)\n  }\n  else if name == \"String::iter_get\" {\n    Some(CtInt)\n  }\n  else if name == \"iter_get\" || name == \"Map::iter_get\" || name == \"iter_require\" || name == \"__neg\" {\n    Some(CtUnknown)\n  }\n  else if name == \"Bytes::new\" || name == \"Bytes::concat\" || name == \"Bytes::slice\" || name == \"Bytes::from_array\" || name == \"Fs::read_bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"Array::set\" || name == \"Array::push\" || name == \"Array::push_all\" || name == \"Array::truncate\" || name == \"Array::foreach\" || name == \"FixedArray::set\" || name == \"FixedArray::blit\" || name == \"FixedArray::unsafe_set\" || name == \"Bytes::set\" || name == \"Bytes::push\" || name == \"Bytes::append\" || name == \"Bytes::blit\" || name == \"Bytes::fill\" || name == \"MapBuilder::set\" || name == \"Stdout::write_char\" || name == \"Stdout::write_stream\" || name == \"sleep\" || name == \"Fs::copy\" || name == \"Fs::chdir\" || name == \"Fs::mkdir\" || name == \"Fs::append\" || name == \"Fs::remove\" || name == \"Fs::write_file\" || name == \"Fs::write_bytes\" || name == \"print\" || name == \"println\" || name == \"assert\" || name == \"assert_true\" || name == \"assert_eq\" || name == \"__set_field\" {\n    Some(CtUnit)\n  }\n  else if name == \"Double::from_i64_bits\" || name == \"Int::to_double\" {\n    Some(CtDouble)\n  }\n  else if name == \"Char::from_int\" {\n    Some(CtChar)\n  }\n  else if name == \"Bytes::to_array\" {\n    Some(CtArray(CtInt))\n  }\n  else if name == \"Map::keys\" || name == \"sh_lines\" || name == \"Lines::parse\" {\n    Some(CtArray(CtString))\n  }\n  else if name == \"Array::slice\" || name == \"Array::concat\" || name == \"Array::filter\" || name == \"Array::reverse\" || name == \"Array::sort\" || name == \"FixedArray::make\" {\n    Some(CtArray(CtUnknown))\n  }\n  else if name == \"Some\" || name == \"Array::find\" {\n    Some(CtOption(CtUnknown))\n  }\n  else {\n    None\n  }\n}\n\nlet direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {\n  match env_lookup(env, name) {\n    Some(_) => None,\n    None => direct_builtin_return(name)\n  }\n}\n\nlet is_logic_binop: (String) -> Bool = (op) -> {\n  op == \"&&\"\n  || op == \"||\"\n}\n\nlet is_order_binop: (String) -> Bool = (op) -> {\n  op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n}\n\nlet type_name_prefix: (Type) -> String = (ty) -> {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\nlet is_equality_binop: (String) -> Bool = (op) -> {\n  op == \"==\"\n  || op == \"!=\"\n}\n\nlet unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nlet unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {\n  match unify(left_ty, right_ty, s) {\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\n    None => None\n  }\n}\n\nlet infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {\n  match unify_same_binop_operands(left_ty, right_ty, s) {\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\n      Some((resolved, s1))\n    } else {\n      None\n    },\n    None => None\n  }\n}\n\nlet infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors) -> {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Bool\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must have same type\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_order_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtBool, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, \"Ord\", s) {\n          Some((_, s1)) => (CtBool, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"+\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n          Some(s1) => (CtString, s1),\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \"Add\", s) {\n            Some((resolved, s1)) => (resolved, s1),\n            None => {\n              Array::push(errors, \"type mismatch in '+': operands must be Int, Double, or String\")\n              (CtUnknown, s)\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"-\"\n  || op == \"*\"\n  || op == \"/\" {\n    let trait_name = if op == \"-\" {\n      \"Sub\"\n    } else if op == \"*\" {\n      \"Mul\"\n    } else {\n      \"Div\"\n    }\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\n          Some((resolved, s1)) => (resolved, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"%\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, \"type mismatch in '%': operands must be Int\")\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else {\n    Array::push(errors, String::concat(\"unknown operator: \", op))\n    (CtUnknown, s)\n  }\n}\n\n// Recursively replace type-parameter names (those bound to a CtVar in `env`)\n// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type\n// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and\n// their args recursed. This lets a generic annotation like `Map[String, V]`\n// resolve its inner `V` to the function's quantified var, so call sites can\n// instantiate it (the previous shallow lookup only handled the outermost name).\nlet rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {\n  match ty {\n    CtNamed(name, args) => {\n      let ra = for a in args {\n        resolve_tparams_in(a, env)\n      }\n      match env_lookup(env, name) {\n        Some(t) => match t {\n          CtVar(_) => t,\n          _ => CtNamed(name, ra)\n        },\n        None => CtNamed(name, ra)\n      }\n    },\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\n    CtTuple(es) => CtTuple(for e in es {\n      resolve_tparams_in(e, env)\n    }),\n    CtFn(ps, ret, eff) => {\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(types) {\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\n    },\n    _ => ty\n  }\n}\n\nexport let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors) -> {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if Array::length(bounds) != 0 {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => (t, s, c),\n        None => {\n          Array::push(errors, String::concat(\"unknown name: \", name))\n          (CtUnknown, s, c)\n        }\n      }\n    },\n    ESeq(left, right) => {\n      let mut s1 = s\n      let mut c1 = c\n      let (_, ns0, nc0) = check_expr(left, env, defs, s1, c1, errors)\n      s1 = ns0\n      c1 = nc0\n      let mut cur = right\n      let mut done = false\n      while !done {\n        match cur {\n          ESeq(next_left, next_right) => {\n            let (_, ns, nc) = check_expr(next_left, env, defs, s1, c1, errors)\n            s1 = ns\n            c1 = nc\n            cur = next_right\n          },\n          _ => {\n            done = true\n          }\n        }\n      }\n      check_expr(cur, env, defs, s1, c1, errors)\n    },\n    ELet(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      let gen = generalize(s1, vt)\n      check_expr(body, env_bind(env, name, gen), defs, s1, c1, errors)\n    },\n    ELetRec(name, val, body) => {\n      let (tv, c1) = fresh_var(c)\n      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1, errors)\n      let s2 = match unify(tv, vt, s1) {\n        Some(su) => su,\n        None => s1\n      }\n      let gen = generalize(s2, tv)\n      check_expr(body, env_bind(env, name, gen), defs, s2, c2, errors)\n    },\n    ELetMut(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      check_expr(body, env_bind(env, name, vt), defs, s1, c1, errors)\n    },\n    EIf(cond, then_e, else_e) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"if condition must be Bool\")\n      }\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors)\n      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors)\n      (tt, s3, c3)\n    },\n    ECall(callee, args) => match callee {\n      // `perform EffName::Op(opargs)` parses as ECall(EIdent(\"perform\"),\n      // [ECall(EIdent(\"EffName::Op\"), opargs)]). The op name may be a builtin\n      // effect (Stdin/Stdout/...) not registered in the checker env, so check\n      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.\n      // `resume(v)` likewise yields the continuation result (a fresh var;\n      // handler arms are otherwise unchecked).\n      EIdent(name) => if name == \"perform\" {\n        if Array::length(args) == 1 {\n          match Array::get(args, 0) {\n            ECall(_, opargs) => {\n              let oalen = Array::length(opargs)\n              let mut s1 = s\n              let mut c1 = c\n              let mut ai = 0\n              while ai < oalen {\n                let (_, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors)\n                s1 = ns\n                c1 = nc\n                ai = ai + 1\n              }\n              let (tv, c2) = fresh_var(c1)\n              (tv, s1, c2)\n            },\n            EIdent(_) => {\n              let (tv, c2) = fresh_var(c)\n              (tv, s, c2)\n            },\n            other => check_expr(other, env, defs, s, c, errors)\n          }\n        } else {\n          (CtUnknown, s, c)\n        }\n      } else if name == \"resume\" {\n        let alen = Array::length(args)\n        let mut s1 = s\n        let mut c1 = c\n        let mut ai = 0\n        while ai < alen {\n          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors)\n          s1 = ns\n          c1 = nc\n          ai = ai + 1\n        }\n        let (tv, c2) = fresh_var(c1)\n        (tv, s1, c2)\n      } else if name == \"Some\" {\n        if Array::length(args) == 1 {\n          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors)\n          (CtOption(subst_apply(s1, at)), s1, c1)\n        } else {\n          (CtOption(CtUnknown), s, c)\n        }\n      } else {\n        match direct_call_return(env, name) {\n          Some(ret_ty) => {\n            let alen = Array::length(args)\n            let mut ai = 0\n            let mut s2 = s\n            let mut c2 = c\n            while ai < alen {\n              let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            (subst_apply(s2, ret_ty), s2, c2)\n          },\n          None => {\n            let (ct, s1, c1) = check_expr(EIdent(name), env, defs, s, c, errors)\n            let alen = Array::length(args)\n            let arg_tys = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            let mut s2 = s1\n            let mut c2 = c1\n            while ai < alen {\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\n              Array::push(arg_tys, at)\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(\"function arity mismatch for \", String::concat(name, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2)\n                let call_ret = Array::get(ret_box, 0)\n                (subst_apply(s3, call_ret), s3, c2)\n              },\n              CtStruct(sname) => (CtStruct(sname), s2, c2),\n              _ => (CtUnknown, s2, c2)\n            }\n          }\n        }\n      },\n      EDot(obj, method) => {\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)\n        let resolved = subst_apply(s1, obj_ty)\n        let type_prefix = type_name_prefix(resolved)\n        let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n        let direct_ret = direct_call_return(env, qualified)\n        let method_ty = match env_lookup(env, qualified) {\n          Some(t) => {\n            let (ti, c2, _) = instantiate(t, c1)\n            (ti, s1, c2)\n          },\n          None => match lookup_builtin(qualified) {\n            Some(t) => (t, s1, c1),\n            None => (CtUnknown, s1, c1)\n          }\n        }\n        let (mt, s2, c2) = method_ty\n        let all_args = prepend_expr(obj, args)\n        let alen = Array::length(all_args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        Array::push(arg_tys, obj_ty)\n        let mut ai = 1\n        let mut s3 = s2\n        let mut c3 = c2\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors)\n          Array::push(arg_tys, at)\n          s3 = ns\n          c3 = nc\n          ai = ai + 1\n        }\n        let applied_method_ty = match mt {\n          CtFn(_, _, _) => mt,\n          _ => subst_apply(s3, mt)\n        }\n        match applied_method_ty {\n          CtFn(param_tys, ret, _) => {\n            let ret_box = Array::slice([\n              ret\n            ], 0, 1)\n            let call_param_tys = param_tys\n            let plen = Array::length(param_tys)\n            let alen2 = Array::length(arg_tys)\n            if alen2 != plen {\n              Array::push(errors, String::concat(\"function arity mismatch for \", String::concat(qualified, String::concat(\": expected \", String::concat(__to_string(plen), String::concat(\" args, got \", __to_string(alen2)))))))\n            }\n            let s4 = unify_call_args(call_param_tys, arg_tys, s3)\n            let call_ret = Array::get(ret_box, 0)\n            let selected_ret = match direct_ret {\n              Some(t) => t,\n              None => call_ret\n            }\n            (subst_apply(s4, selected_ret), s4, c3)\n          },\n          _ => match direct_ret {\n            Some(t) => (t, s3, c3),\n            None => (CtUnknown, s3, c3)\n          }\n        }\n      },\n      _ => {\n        let callee_name0 = expr_ident_name_or_empty(callee)\n        if callee_name0 != \"\" {\n          match direct_call_return(env, callee_name0) {\n            Some(ret_ty) => {\n              let alen = Array::length(args)\n              let mut ai = 0\n              let mut s2 = s\n              let mut c2 = c\n              while ai < alen {\n                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n              (subst_apply(s2, ret_ty), s2, c2)\n            },\n            None => {\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors)\n              let alen = Array::length(args)\n              let arg_tys = Array::slice([\n                CtUnknown\n              ], 0, 0)\n              let mut ai = 0\n              let mut s2 = s1\n              let mut c2 = c1\n              while ai < alen {\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\n                Array::push(arg_tys, at)\n                s2 = ns\n                c2 = nc\n                ai = ai + 1\n              }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(\"function arity mismatch for \", String::concat(callee_name0, String::concat(\": expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2)\n                let call_ret = Array::get(ret_box, 0)\n                (subst_apply(s3, call_ret), s3, c2)\n              },\n              CtStruct(sname) => (CtStruct(sname), s2, c2),\n              _ => (CtUnknown, s2, c2)\n            }\n            }\n          }\n        } else {\n            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors)\n            let alen = Array::length(args)\n            let arg_tys = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            let mut s2 = s1\n            let mut c2 = c1\n            while ai < alen {\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\n              Array::push(arg_tys, at)\n              s2 = ns\n              c2 = nc\n              ai = ai + 1\n            }\n            let applied_callee_ty = match ct {\n              CtFn(_, _, _) => ct,\n              _ => subst_apply(s2, ct)\n            }\n            match applied_callee_ty {\n              CtFn(param_tys, ret, _) => {\n                let ret_box = Array::slice([\n                  ret\n                ], 0, 1)\n                let call_param_tys = param_tys\n                let plen2 = Array::length(param_tys)\n                let alen3 = Array::length(arg_tys)\n                if alen3 != plen2 {\n                  Array::push(errors, String::concat(\"function arity mismatch for <expr>: expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))\n                }\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2)\n                let call_ret = Array::get(ret_box, 0)\n                (subst_apply(s3, call_ret), s3, c2)\n              },\n              CtStruct(sname) => (CtStruct(sname), s2, c2),\n              _ => (CtUnknown, s2, c2)\n            }\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors)\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors)\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors)\n      if op == \"!\" {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else if op == \"-\" {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(_, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      check_expr(body, env, defs, s1, c1, errors)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      check_expr(body, env, defs, s1, c1, errors)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors)\n      let alen = Array::length(arms)\n      if alen == 0 {\n        (CtUnknown, s1, c1)\n      }\n      else {\n        let mut result_ty = CtUnknown\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = Array::get(arms, ai)\n          let arm_env = check_pattern(pat, scr_ty, env, defs)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors)\n          if ai == 0 {\n            result_ty = arm_ty\n          }\n          si = ns\n          ci = nc\n          ai = ai + 1\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, _) => check_expr(body, env, defs, s, c, errors),\n    EWhile(cond, body) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"while condition must be Bool\")\n      }\n      let (_, s2, c2) = check_expr(body, env, defs, s1, c1, errors)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1, errors)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c, errors)\n      // `for x in arr` iterates an Array[T]; `for await x in stream` iterates a\n      // Stream[T] (eager Array-backed model, docs/spec §M2c-3) — both yield T.\n      let et = match subst_apply(s1, it) {\n        CtArray(elem) => elem,\n        CtNamed(\"Stream\", args) => if Array::length(args) > 0 {\n          Array::get(args, 0)\n        } else CtUnknown,\n        _ => CtUnknown\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1, errors)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field) => {\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)\n      let resolved = subst_apply(s1, obj_ty)\n      let field_ty = match resolved {\n        CtStruct(sname) => match find_typedef(defs, sname) {\n          Some(td) => match td {\n            TDStruct(_, fields) => {\n              let rec find_field: (Int) -> Type = (i) -> {\n                if i >= Array::length(fields) {\n                  CtUnknown\n                } else {\n                  let (fname, ftype) = Array::get(fields, i)\n                  if fname == field {\n                    ftype\n                  } else find_field(i + 1)\n                }\n              }\n              find_field(0)\n            },\n            _ => CtUnknown\n          },\n          None => CtUnknown\n        },\n        _ => CtUnknown\n      }\n      (field_ty, s1, c1)\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let tplen = Array::length(tparams)\n      let mut tp_env = env\n      let mut s0 = s\n      let mut c0 = c\n      let mut tpi = 0\n      while tpi < tplen {\n        let tpname = Array::get(tparams, tpi)\n        match fresh_var(c0) {\n          (tv, nc) => {\n            let vid = nc - 1\n            let tblen = Array::length(tbounds)\n            let mut bounds = Array::slice([\n              \"\"\n            ], 0, 0)\n            let mut tbi = 0\n            let mut found_bounds = false\n            while tbi < tblen {\n              let (bname, blist) = Array::get(tbounds, tbi)\n              if !found_bounds && bname == tpname {\n                bounds = blist\n                found_bounds = true\n              }\n              tbi = tbi + 1\n            }\n            s0 = if Array::length(bounds) == 0 {\n              s0\n            } else subst_add_bound(s0, vid, bounds)\n            tp_env = env_bind(tp_env, tpname, tv)\n            c0 = nc\n          },\n          _ => ()\n        }\n        tpi = tpi + 1\n      }\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut pi = 0\n      while pi < plen {\n        let (raw_name, ann) = Array::get(params, pi)\n        let nlen = String::length(raw_name)\n        let name = if nlen > 0 {\n          let lc = String::char_code_at(raw_name, nlen - 1)\n          if lc == '~' || lc == '?' {\n            raw_name[0: nlen - 1]\n          } else raw_name\n        } else raw_name\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = resolve_tparams_in(resolved, fn_env)\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1, errors)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => {\n              Array::push(errors, String::concat(\"return type mismatch: expected \", String::concat(type_to_string(resolved_ret), String::concat(\", got \", type_to_string(bt)))))\n              (CtUnknown, s2)\n            }\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      (CtFn(param_types, final_ret, effect), s3, c2)\n    },\n    EBreak(opt) => match opt {\n      Some(e) => {\n        let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)\n        (CtUnit, s1, c1)\n      },\n      None => (CtUnit, s, c)\n    },\n    EContinue(args) => {\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let mut fi = 0\n      while fi < flen {\n        let (_, fval) = Array::get(fields, fi)\n        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1, errors)\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      (CtUnknown, s1, c1)\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors)\n        if ai == 0 {\n          elem_ty = it\n        }\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    EReturn(e) => {\n      let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)\n      (CtUnknown, s1, c1)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n")
}

let cli_adapter_source_32 = () -> (String, String) {
  ("vibe/compiler/checker/checker_stmt.vibe",
"//# Imports\n\nimport .. / checker_trait.vibe {\n  register_builtin_traits\n}\n\nimport .. / core / ast.vibe {\n  Expr, Stmt, TypeExpr\n}\n\nimport .. / core / types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_cache, env_flat_bindings, env_lookup_flat, generalize, resolve_builtin, trait_defined\n}\n\nimport ./checker.vibe {\n  check_expr, fn_return_env_name\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr, subst_type_params\n}\n\n//# Functions\n\nlet rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if cached_name == name {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nlet bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {\n  let env_bindings = env_flat_bindings(env)\n  let import_cache = Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n  let nlen = Array::length(names)\n  let mut i = 0\n  let mut acc = env\n  while i < nlen {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let ty = match import_cache_lookup(import_cache, name, 0) {\n      Some(t) => t,\n      None => {\n        let resolved = match env_lookup_flat(env_bindings, name) {\n          Some(t) => t,\n          None => CtUnknown\n        }\n        Array::push(import_cache, (name, resolved))\n        resolved\n      }\n    }\n    let acc_with_name = env_bind(acc, bound_name, ty)\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\n      None => acc_with_name\n    }\n    i = i + 1\n  }\n  acc\n}\n\nlet annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {\n  match ann {\n    Some(te) => match te {\n      TyFn(params, ret, _) => {\n        let ret_box = Array::slice([\n          ret\n        ], 0, 1)\n        let _ = Array::length(params)\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\n      },\n      _ => None\n    },\n    None => None\n  }\n}\n\nlet fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {\n  match expr {\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\n      Some(te) => Some(resolve_type_expr(te, defs)),\n      None => None\n    },\n    _ => None\n  }\n}\n\nlet bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {\n  env_bind(env, fn_return_env_name(name), ret_ty)\n}\n\nlet bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {\n  match annotation_return_type(ann, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => env\n  }\n}\n\nlet bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {\n  match fn_expr_return_type(val, defs) {\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\n    None => bind_annotation_return(env, name, ann, defs)\n  }\n}\n\nexport let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String]) -> (TypeEnv, Subst, Int) = (stmts, i, env, defs, s, c, errors) -> {\n  let mut idx = i\n  let mut cur_env = env\n  let mut cur_s = s\n  let mut cur_c = c\n  while idx < Array::length(stmts) {\n    let env = cur_env\n    let s = cur_s\n    let c = cur_c\n    let stmt = Array::get(stmts, idx)\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors)\n        } else {\n          check_expr(val, env, defs, s, c, errors)\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => generalize(ns, vt)\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        let env1 = env_bind(env, name, t)\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\n      },\n      SLetPat(pat, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)\n        let new_env = match pat {\n          PTuple(pats) => match vt {\n            CtTuple(types) => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => if pi < Array::length(types) {\n                    e = env_bind(e, name, Array::get(types, pi))\n                  } else {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            },\n            _ => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            }\n          },\n          PBind(name) => env_bind(env, name, vt),\n          PStruct(_, fields) => {\n            let mut e = env\n            let mut fi = 0\n            while fi < Array::length(fields) {\n              let (_, fpat) = Array::get(fields, fi)\n              match fpat {\n                PBind(name) => {\n                  e = env_bind(e, name, CtUnknown)\n                },\n                _ => ()\n              }\n              fi = fi + 1\n            }\n            e\n          },\n          _ => env\n        }\n        (new_env, ns, nc)\n      },\n      SEnum(_, name, params, variants) => {\n        let param_len = Array::length(params)\n        let param_var_ids = Array::slice([\n          0\n        ], 0, 0)\n        let param_var_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut pi = 0\n        while pi < param_len {\n          let vid = c + pi\n          Array::push(param_var_ids, vid)\n          Array::push(param_var_types, CtVar(vid))\n          pi = pi + 1\n        }\n        let ctor_result_type = if param_len == 0 {\n          CtEnum(name)\n        } else {\n          CtNamed(name, param_var_types)\n        }\n        let ctor_bounds = Array::slice([\n          (0, Array::slice([\n            \"\"\n          ], 0, 0))\n        ], 0, 0)\n        let resolved_variants = Array::slice([\n          (\"\", Array::slice([\n            CtUnknown\n          ], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = Array::slice([\n            CtUnknown\n          ], 0, 0)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, params, resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          let ctor_ty = if Array::length(vtypes) == 0 {\n            ctor_result_type\n          } else {\n            let resolved_args = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\n              Array::push(resolved_args, arg_ty)\n              ai = ai + 1\n            }\n            CtFn(resolved_args, ctor_result_type, None)\n          }\n          let exported_ctor_ty = if param_len == 0 {\n            ctor_ty\n          } else {\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\n          }\n          env1 = env_bind(env1, vname, exported_ctor_ty)\n          match ctor_ty {\n            CtFn(_, ret, _) => {\n              let exported_ret_ty = if param_len == 0 {\n                ret\n              } else {\n                CtForAll(param_var_ids, ctor_bounds, ret)\n              }\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\n            },\n            _ => ()\n          }\n          ci2 = ci2 + 1\n        }\n        (env1, s, c + param_len)\n      },\n      SStruct(_, name, field_defs) => {\n        let resolved_fields = Array::slice([\n          (\"\", CtUnit)\n        ], 0, 0)\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        Array::push(defs, TDStruct(name, resolved_fields))\n        let field_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\n        (bind_fn_return(env1, name, CtStruct(name)), s, c)\n      },\n      STypeAlias(_, name, params, te) => {\n        let t = resolve_type_expr(te, defs)\n        // Record the alias (with its formal params) so an applied use\n        // `Name[Arg]` expands via subst in resolve_type_expr's TyApp case.\n        Array::push(defs, TDAlias(name, params, t))\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        let env1 = env_bind(env, name, t)\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors)\n        (env, ns, nc)\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c, errors)\n        (env, s, c)\n      },\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SAliasDecl(_, _) => (env, s, c)\n      ,\n      STrait(_, name, supers) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, env), s, c)\n      },\n      SImpl(_, _, trait_name, type_name) => {\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, Array::slice([\n            CtUnknown\n          ], 0, 0))\n        }\n        (EnvTraitImpl(trait_name, target, env), s, c)\n      },\n      _ => (env, s, c)\n    }\n    cur_env = new_env\n    cur_s = s1\n    cur_c = c1\n    idx = idx + 1\n  }\n  (cur_env, cur_s, cur_c)\n}\n\nexport let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", Array::slice([\n      \"\"\n    ], 0, 0), CtUnit)\n  ], 0, 0)\n  let seeded_raw_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let seeded_env = env_cache(seeded_raw_env)\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)\n  if Array::length(frozen_errors) > 0 {\n    throw(Array::get(frozen_errors, 0))\n  }\n  env\n}\n\nexport let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {\n  match initial_env {\n    EnvEmpty => check_program(stmts),\n    _ => {\n      let empty_defs = Array::slice([\n        TDAlias(\"_dummy\", Array::slice([\n      \"\"\n    ], 0, 0), CtUnit)\n      ], 0, 0)\n      let cached_env = env_cache(initial_env)\n      let seeded_raw_env = if trait_defined(cached_env, \"Eq\") {\n        cached_env\n      } else {\n        register_builtin_traits(cached_env)\n      }\n      let seeded_env = env_cache(seeded_raw_env)\n      let errors = ArrayBuilder::new()\n      let frozen_errors = ArrayBuilder::freeze(errors)\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)\n      if Array::length(frozen_errors) > 0 {\n        throw(Array::get(frozen_errors, 0))\n      }\n      env\n    }\n  }\n}\n")
}

