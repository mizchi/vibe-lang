static_arr_push_all_body_bytes = Bytes::from_array([\n  32,\n  0,\n  167,\n  33,\n  2,\n  32,\n  1,\n  167,\n  33,\n  3,\n  32,\n  2,\n  40,\n  2,\n  4,\n  33,\n  4,\n  32,\n  3,\n  40,\n  2,\n  4,\n  33,\n  5,\n  32,\n  2,\n  40,\n  2,\n  8,\n  33,\n  6,\n  32,\n  3,\n  40,\n  2,\n  8,\n  33,\n  7,\n  32,\n  2,\n  40,\n  2,\n  0,\n  33,\n  8,\n  32,\n  4,\n  32,\n  5,\n  106,\n  32,\n  8,\n  75,\n  4,\n  64,\n  32,\n  4,\n  32,\n  5,\n  106,\n  65,\n  2,\n  108,\n  33,\n  9,\n  35,\n  0,\n  34,\n  10,\n  32,\n  9,\n  65,\n  8,\n  108,\n  106,\n  36,\n  0,\n  32,\n  10,\n  32,\n  6,\n  32,\n  4,\n  65,\n  8,\n  108,\n  252,\n  10,\n  0,\n  0,\n  32,\n  2,\n  32,\n  9,\n  54,\n  2,\n  0,\n  32,\n  2,\n  32,\n  10,\n  54,\n  2,\n  8,\n  32,\n  10,\n  33,\n  6,\n  11,\n  32,\n  6,\n  32,\n  4,\n  65,\n  3,\n  116,\n  106,\n  32,\n  7,\n  32,\n  5,\n  65,\n  3,\n  116,\n  252,\n  10,\n  0,\n  0,\n  32,\n  2,\n  32,\n  4,\n  32,\n  5,\n  106,\n  54,\n  2,\n  4\n])\n\nexport let static_arr_push_all_body: () -> Bytes = () -> {\n  static_arr_push_all_body_bytes\n}\n\nlet static_arr_truncate_body_bytes = Bytes::from_array([\n  32,\n  0,\n  167,\n  32,\n  1,\n  167,\n  54,\n  2,\n  4\n])\n\nexport let static_arr_truncate_body: () -> Bytes = () -> {\n  static_arr_truncate_body_bytes\n}\n\nlet static_double_to_int_body_bytes = Bytes::from_array([\n  32,\n  0,\n  191,\n  176\n])\n\nexport let static_double_to_int_body: () -> Bytes = () -> {\n  static_double_to_int_body_bytes\n}\n\nlet static_int_to_double_body_bytes = Bytes::from_array([\n  32,\n  0,\n  185,\n  189\n])\n\nexport let static_int_to_double_body: () -> Bytes = () -> {\n  static_int_to_double_body_bytes\n}\n\nlet static_str_substring_body_bytes = Bytes::from_array([\n  32,\n  0,\n  66,\n  32,\n  135,\n  167,\n  33,\n  3,\n  32,\n  2,\n  32,\n  1,\n  125,\n  167,\n  33,\n  4,\n  32,\n  3,\n  32,\n  1,\n  167,\n  106,\n  173,\n  66,\n  32,\n  134,\n  32,\n  4,\n  173,\n  132\n])\n\nexport let static_str_substring_body: