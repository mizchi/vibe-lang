\n        } else if op == \"-\" {\n          emit_f64_sub(buf)\n        } else if op == \"*\" {\n          emit_f64_mul(buf)\n        } else {\n          emit_f64_div(buf)\n        }\n        emit_i64_reinterpret_f64(buf)\n        if ctx.enable_rc {\n          Array::push(local_names, \"__fbits\")\n          Array::push(local_names, \"__fbox\")\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\n          nl2 + 2\n        } else {\n          nl2\n        }\n      } else {\n        if op == \"<\" {\n          emit_f64_lt(buf)\n        } else if op == \">\" {\n          emit_f64_gt(buf)\n        } else if op == \"<=\" {\n          emit_f64_le(buf)\n        } else if op == \">=\" {\n          emit_f64_ge(buf)\n        } else {\n          throw(String::concat(\"unsupported float binop: \", op))\n        }\n        emit_i64_extend_i32_s(buf)\n        if ctx.enable_rc {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        }\n        nl2\n      }\n    } else if ctx.enable_rc {\n      if op == \"<<\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shl(buf)\n        nl2\n      } else if op == \">>\" {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_i64_const(buf, 1)\n        emit_i64_shr_s(buf)\n        emit_i64_shr_s(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n        nl2\n      } else {\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n        emit_binop_op(buf, op)\n        if op == \"*\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shr_s(buf)\n        } else if op == \"/\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n          emit_i64_const(buf, 1)\n          emit_i64_shl(buf)\n        } else {\n          ()\n        }\n        nl2\n      }\n    } else {\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n      emit_binop_op(buf, op)\n      nl2\n    }\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      if expr_is_floatish(operand, local_names, ctx) {\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_f64_reinterpret_i64(buf)\n        emit_f64_neg(buf)\n        emit_i64_reinterpret_f64(buf)\n        nl\n      } else {\n        emit_i64_const(buf, 0)\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n        emit_i64_sub(buf)\n        nl\n      }\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        if cop == \"==\" {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          let (eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n          emit_call(buf, eq_fi)\n          emit_i32_wrap_i64(buf)\n          cnl2\n        } else if cop == \"!=\" {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          let (eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n          emit_call(buf, eq_fi)\n          emit_i32_wrap_i64(buf)\n          emit_i32_eqz(buf)\n          cnl2\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          emit_f64_reinterpret_i64(buf)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          emit_f64_reinterpret_i64(buf)\n          if cop == \"<\" {\n            emit_f64_lt(buf)\n          }\n          else if cop == \">\" {\n            emit_f64_gt(buf)\n          }\n          else if cop == \"<=\" {\n            emit_f64_le(buf)\n          }\n          else {\n            emit_f64_ge(buf)\n          }\n          cnl2\n        } else {\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n          if cop == \"<\" {\n            emit_i64_lt_s(buf)\n          }\n          else if cop == \">\" {\n            emit_i64_gt_s(buf)\n          }\n          else if cop == \"<=\" {\n            emit_i64_le_s(buf)\n          }\n          else {\n            emit_i64_ge_s(buf)\n          }\n          cnl2\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val {\n        1\n      } else {\n        0\n      })\n      next_local\n    } else if cond_tag == 6 {\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            if iop == \"==\" {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              let (eq_fi2, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_call(buf, eq_fi2)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if iop == \"!=\" {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              let (eq_fi2, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_call(buf, eq_fi2)\n              emit_i32_wrap_i64(buf)\n              emit_i32_eqz(buf)\n              emit_i32_eqz(buf)\n              inl2\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              emit_f64_reinterpret_i64(buf)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              emit_f64_reinterpret_i64(buf)\n              if iop == \"<\" {\n                emit_f64_lt(buf)\n              }\n              else if iop == \">\" {\n                emit_f64_gt(buf)\n              }\n              else if iop == \"<=\" {\n                emit_f64_le(buf)\n              }\n              else {\n                emit_f64_ge(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            } else {\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n              if iop == \"<\" {\n                emit_i64_lt_s(buf)\n              }\n              else if iop == \">\" {\n                emit_i64_gt_s(buf)\n              }\n              else if iop == \"<=\" {\n                emit_i64_le_s(buf)\n              }\n              else {\n                emit_i64_ge_s(buf)\n              }\n              emit_i32_eqz(buf)\n              inl2\n            }\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\nexport let compile_module_expr: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {\n  let fresh_int_array: () -> Array[Int] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_array: () -> Array[String] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_expr_array: () -> Array[Expr] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fn_names_list = fresh_string_array()\n  let fn_param_counts = fresh_int_array()\n  let export_names = fresh_string_array()\n  let export_indices = fresh_int_array()\n  let fn_bodies_list = fresh_expr_array()\n  let fn_param_names_list = fresh_string_matrix()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let cur_idx = Array::length(fn_names_list)\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_bodies_list, body)\n          let pnames = fresh_string_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pname, _) = Array::get(params, pi)\n            Array::push(pnames, pname)\n            pi = pi + 1\n          }\n          Array::push(fn_param_names_list, pnames)\n          if is_export {\n            Array::push(export_names, name)\n            Array::push(export_indices, cur_idx)\n          }\n          0\n        },\n        _ => 0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  let num_funcs = Array::length(fn_names_list)\n  if num_funcs == 0 {\n    let out = bytebuf_new()\n    let empty_type_defs = fresh_int_array()\n    let empty_type_indices = fresh_int_array()\n    let empty_body = bytebuf_new()\n    let empty_bodies = fresh_bytes_matrix()\n    Array::push(empty_bodies, empty_body)\n    let empty_local_counts = fresh_int_array()\n    Array::push(empty_local_counts, 0)\n    emit_header(out)\n    emit_type_section_multi(out, empty_type_defs)\n    emit_function_section(out, empty_type_indices)\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\n    bytebuf_to_bytes(out)\n  } else {\n    let fn_indices_list = fresh_int_array()\n    let fn_returns_list = fresh_int_array()\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\n    let mut fi = 0\n    while fi < num_funcs {\n      Array::push(fn_indices_list, fi)\n      Array::push(fn_returns_list, 1)\n      Array::push(fn_needs_env_list, false)\n      fi = fi + 1\n    }\n    let type_defs = fresh_int_array()\n    let mut ti = 0\n    while ti < num_funcs {\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\n      Array::push(type_defs, 1)\n      ti = ti + 1\n    }\n    let type_indices = fresh_int_array()\n    let mut tii = 0\n    while tii < num_funcs {\n      Array::push(type_indices, tii)\n      tii = tii + 1\n    }\n    let lt_m = LambdaTable::{\n      bodies: fresh_bytes_matrix(),\n      param_counts: fresh_int_array(),\n      captures: fresh_string_matrix(),\n      meta_i32: fresh_int_array(),\n      meta_i64: fresh_int_array()\n    }\n    let empty_str_table = StrTable::{\n      strs: fresh_string_array(),\n      offsets: fresh_int_array(),\n      lengths: fresh_int_array()\n    }\n    let empty_ctor_table = CtorTable::{\n      names: fresh_string_array(),\n      tags: fresh_int_array(),\n      field_counts: fresh_int_array(),\n      type_names: fresh_string_array(),\n      struct_names: fresh_string_array(),\n      struct_field_names: fresh_string_matrix()\n    }\n    let empty_thunk_names = fresh_string_array()\n    let empty_const_int_names = fresh_string_array()\n    let empty_const_int_values = fresh_int_array()\n    let empty_rc_drop_names = fresh_string_array()\n    let empty_rc_alias_dup_names = fresh_string_array()\n    let empty_rc_dup_names = fresh_string_array()\n    let bodies = fresh_bytes_matrix()\n    let local_counts = fresh_int_array()\n    let mut bi = 0\n    while bi < num_funcs {\n      let body = Array::get(fn_bodies_list, bi)\n      let param_names = Array::get(fn_param_names_list, bi)\n      let body_buf = bytebuf_new()\n      let local_names = fresh_string_array()\n      let mut pi = 0\n      while pi < Array::length(param_names) {\n        Array::push(local_names, Array::get(param_names, pi))\n        pi = pi + 1\n      }\n      let param_count = Array::length(param_names)\n      let empty_ref_cells = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list,\n          indices: fn_indices_list,\n          params: fn_param_counts,\n          returns: fn_returns_list,\n          needs_env: fn_needs_env_list\n        },\n        str_table: empty_str_table,\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: empty_ctor_table,\n        thunk_names: empty_thunk_names,\n        const_int_names: empty_const_int_names,\n        const_int_values: empty_const_int_values,\n        enable_rc: false,\n        rc_drop_names: empty_rc_drop_names,\n        rc_alias_dup_names: empty_rc_alias_dup_names,\n        heap_binding_names: fresh_string_array(),\n        rc_drop_func_idx: -1,\n        rc_alloc_func_idx: -1,\n        heap_grow_check_func_idx: -1,\n        rc_dup_names: empty_rc_dup_names,\n        float_local_slots: fresh_int_array(),\n        effect_names: fresh_string_array(),\n        effect_op_keys: fresh_string_array(),\n        effect_op_arities: fresh_int_array()\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n\n\n\n\nexport {\n  compile_expr, compile_module_expr\n}\n\n\n\n\n\n\nlet expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  let normalized_target = canonical_builtin_name(target)\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(free_vars) && !found {\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\n    i = i + 1\n  }\n  found\n}\n\nexport let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\n\n\n\n\n\n\n\n\n\n\nlet wasm_page_size = 65536\n\nlet lc_fresh_int_array: () -> Array[Int] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_bool_array: () -> Array[Bool] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_bytes_array: () -> Array[Bytes] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_string_array: () -> Array[String] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nlet lc_fresh_string_matrix: () -> Array[Array[String]] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet gen_heap_grow_check_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport let wasi_memory_min_pages_for_heap: (Int) -> Int = (heap_start) -> {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\nexport let compile_wasi_module_linked_impl: (Array[Stmt], String, Array[(String, String)], Array[(String, String, Int, Int)], Bool, Bool) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, linked_imports, library_mode, enable_rc) -> {\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let empty_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (expr_tag(expr) == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n  