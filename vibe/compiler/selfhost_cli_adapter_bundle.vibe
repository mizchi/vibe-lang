buf) -> {\n  bytebuf_push(buf, op_f64_convert_i64_s)\n}\n\nlet op_f64_reinterpret_i64 = 191\n\nlet op_i64_reinterpret_f64 = 189\n\nexport let emit_f64_reinterpret_i64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_f64_reinterpret_i64)\n}\n\nexport let emit_i64_reinterpret_f64: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_reinterpret_f64)\n}\n\nexport let emit_table_section_funcref: (Bytes, Int) -> Unit = (out, num_entries) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push2(content, type_funcref, 0)\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, sec_table, content)\n}\n\nexport let emit_element_section_active: (Bytes, Array[Int]) -> Unit = (out, func_indices) -> {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  bytebuf_push(content, 0)\n  emit_i32_const(content, 0)\n  emit_end(content)\n  leb128_encode_u32(content, Array::length(func_indices))\n  let mut i = 0\n  while i < Array::length(func_indices) {\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_element, content)\n}\n\n\n\n\n\nlet vt_i32 = 127\n\nlet sec_data = 11\n\nlet sec_type = 1\n\nexport let string_to_data: (String) -> Bytes = (s) -> {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\nlet empty_int_array: () -> Array[Int] = () -> {\n  Array::slice([\n    0\n  ], 0, 0)\n}\n\nlet pair_int_array: (Int, Int) -> Array[Int] = (v0, v1) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nlet quad_int_array: (Int, Int, Int, Int) -> Array[Int] = (v0, v1, v2, v3) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  Array::push(values, v3)\n  values\n}\n\nlet triple_int_array: (Int, Int, Int) -> Array[Int] = (v0, v1, v2) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet empty_bytes_array: () -> Array[Bytes] = () -> {\n  Array::slice([\n    bytebuf_new()\n  ], 0, 0)\n}\n\nlet pair_bytes_array: (Bytes, Bytes) -> Array[Bytes] = (v0, v1) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nlet empty_string_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet pair_string_array: (String, String) -> Array[String] = (v0, v1) -> {\n  let values = empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  values\n}\n\nexport let build_call_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\n  emit_function_section(out, pair_int_array(0, 1))\n  emit_export_section_multi(out, pair_string_array(\"square\", \"sum_sq\"), pair_int_array(0, 1))\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)\n  emit_i64_add(ss_body)\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\n  bytebuf_to_bytes(out)\n}\n\nlet triple_bytes_array: (Bytes, Bytes, Bytes) -> Array[Bytes] = (v0, v1, v2) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet singleton_int_array: (Int) -> Array[Int] = (v0) -> {\n  let values = empty_int_array()\n  Array::push(values, v0)\n  values\n}\n\nlet triple_string_array: (String, String, String) -> Array[String] = (v0, v1, v2) -> {\n  let values = empty_string_array()\n  Array::push(values, v0)\n  Array::push(values, v1)\n  Array::push(values, v2)\n  values\n}\n\nlet singleton_bytes_array: (Bytes) -> Array[Bytes] = (v0) -> {\n  let values = empty_bytes_array()\n  Array::push(values, v0)\n  values\n}\n\nexport let build_add_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, singleton_bytes_array(body))\n  bytebuf_to_bytes(out)\n}\n\nexport let build_factorial_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fact\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_mul(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))\n  bytebuf_to_bytes(out)\n}\n\nexport let build_fibonacci_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, singleton_int_array(0))\n  emit_export_section(out, \"fib\", 0)\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_le_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 1)\n  emit_local_get(b, 2)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_set(b, 1)\n  emit_local_get(b, 3)\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 0)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(3))\n  bytebuf_to_bytes(out)\n}\n\nlet singleton_string_array: (String) -> Array[String] = (v0) -> {\n  let values = empty_string_array()\n  Array::push(values, v0)\n  values\n}\n\nexport let build_hello_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(vt_i32, vt_i32, vt_i32, vt_i32), singleton_int_array(vt_i32))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 100)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)\n  bytebuf_push(hello_data, 101)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 32)\n  bytebuf_push(hello_data, 119)\n  bytebuf_push(hello_data, 111)\n  bytebuf_push(hello_data, 114)\n  bytebuf_push(hello_data, 108)\n  bytebuf_push(hello_data, 100)\n  bytebuf_push(hello_data, 10)\n  emit_data_section(out, 8, hello_data)\n  bytebuf_to_bytes(out)\n}\n\nexport let build_arithmetic_module: () -> Bytes = () -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, triple_int_array(0, 0, 0))\n  emit_export_section_multi(out, triple_string_array(\"add\", \"sub\", \"mul\"), triple_int_array(0, 1, 2))\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\n  bytebuf_to_bytes(out)\n}\n\nexport let emit_data_section_multi: (Bytes, Array[Int], Array[Bytes]) -> Unit = (out, offsets, datas) -> {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Bytes::length(data))\n    bytebuf_push_buf(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_data, content)\n}\n\nexport let build_print_string_module: (String) -> Bytes = (msg) -> {\n  let out = bytebuf_new()\n  emit_header(out)\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, quad_int_array(vt_i32, vt_i32, vt_i32, vt_i32), singleton_int_array(vt_i32))\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, singleton_int_array(1))\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, singleton_string_array(\"_start\"), singleton_int_array(1), \"memory\", 0)\n  let str_data = string_to_data(msg)\n  let str_len = Bytes::length(str_data)\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n  emit_code_section(out, singleton_bytes_array(b))\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n\n\n\n\n\n\n\nlet op_prefix = 252\n\n\nexport let get_ebinop_lhs: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ebinop_rhs: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ecall_args: (Expr) -> Array[Expr] with { Error } = (expr) -> {\n  match expr {\n    ECall(_, args) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efn_params: (Expr) -> Array[(String, Option[TypeExpr])] with { Error } = (expr) -> {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eint_value: (Expr) -> Int with { Error } = (expr) -> {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport let get_eseq_first: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport let get_match_arms: (Expr) -> Array[(Pat, Expr)] with { Error } = (expr) -> {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\nexport let get_pbind_name: (Pat) -> String with { Error } = (p) -> {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport let get_pctor_args: (Pat) -> Array[Pat] with { Error } = (p) -> {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\nexport let get_pctor_name: (Pat) -> String with { Error } = (p) -> {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\nexport let get_pint_value: (Pat) -> Int with { Error } = (p) -> {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport let get_eassign_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_ebool_value: (Expr) -> Bool with { Error } = (expr) -> {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport let get_eforin_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_iter: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eident_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EIdent(name) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport let get_eletmut_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetMut(_, val, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eseq_second: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport let get_ereturn_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EReturn(e) => e,\n    _ => throw(\"not EReturn\")\n  }\n}\n\nexport let get_ethrow_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EThrow(e) => e,\n    _ => throw(\"not EThrow\")\n  }\n}\n\nexport let get_eunaryop_op: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport let get_ewhile_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport let get_ewhile_cond: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport let get_pbool_value: (Pat) -> Bool with { Error } = (p) -> {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\nexport let get_ptuple_pats: (Pat) -> Array[Pat] with { Error } = (p) -> {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport let get_slet_export: (Stmt) -> Bool with { Error } = (stmt) -> {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let rec is_catchall_pat: (Pat) -> Bool = (p) -> {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\nexport let emit_assignop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport let emit_memory_copy: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 10)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\nexport let get_earray_elems: (Expr) -> Array[Expr] with { Error } = (expr) -> {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport let get_eassign_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassign_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassignop_op: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_ecall_callee: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ECall(callee, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efloat_value: (Expr) -> Double with { Error } = (expr) -> {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport let get_eletmut_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetMut(_, _, body) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletmut_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    ELetMut(name, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eletrec_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_etuple_elems: (Expr) -> Array[Expr] with { Error } = (expr) -> {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport let str_table_lookup: (Array[String], String) -> Int with { Error } = (strs, s) -> {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\nexport let find_catchall_idx: (Array[(Pat, Expr)]) -> Int = (arms) -> {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport let get_eassignop_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_estring_value: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport let get_eunaryop_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport let get_pstring_value: (Pat) -> String with { Error } = (p) -> {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport let array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let get_eassignop_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_eassignop_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_match_scrutinee: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n\n\n\n\nlet op_i64_extend_i32_u = 173\n\n\n\nexport let rec collect_strings_expr: (Expr, Array[String]) -> Int = (expr, out) -> {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args) => {\n      collect_strings_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        match pat {\n          PString(s) => {\n            let mut pf = false\n            let mut pi = 0\n            while pi < Array::length(out) {\n              if Array::get(out, pi) == s {\n                pf = true\n              }\n              pi = pi + 1\n            }\n            if !pf {\n              Array::push(out, s)\n            }\n            0\n          },\n          _ => 0\n        }\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EThrow(msg) => collect_strings_expr(msg, out),\n    EReturn(msg) => collect_strings_expr(msg, out),\n    EStringInterp(parts) => {\n      let mut si_p = 0\n      while si_p < Array::length(parts) {\n        if si_p % 2 == 0 {\n          let part = Array::get(parts, si_p)\n          if String::length(part) > 0 {\n            let mut found = false\n            let mut fi2 = 0\n            while fi2 < Array::length(out) {\n              if Array::get(out, fi2) == part { found = true }\n              fi2 = fi2 + 1\n            }\n            if !found { Array::push(out, part) }\n          }\n        }\n        si_p = si_p + 1\n      }\n      0\n    },\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut mi = 0\n      while mi < Array::length(fields) {\n        let (key, val) = Array::get(fields, mi)\n        let mut kf = false\n        let mut ki = 0\n        while ki < Array::length(out) {\n          if Array::get(out, ki) == key { kf = true }\n          ki = ki + 1\n        }\n        if !kf { Array::push(out, key) }\n        collect_strings_expr(val, out)\n        mi = mi + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_strings_expr(fval, out)\n        ri = ri + 1\n      }\n      0\n    },\n    EDot(obj, _) => collect_strings_expr(obj, out),\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\n    _ => 0\n  }\n}\n\nexport let get_func_param_names: (Stmt) -> Array[String] with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          let plen2 = String::length(pname)\n          let clean_name = if plen2 > 0 {\n            let last_char = String::char_code_at(pname, plen2 - 1)\n            if last_char == '~' || last_char == '?' {\n              pname[0:plen2 - 1]\n            } else pname\n          } else pname\n          Array::push(names, clean_name)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\nexport let collect_strings_stmts: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let emit_i64_extend_i32_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i64_extend_i32_u)\n}\n\nexport let emit_closure_resolve: (Bytes, Int, Int, Int) -> Unit = (buf, fn_val_local, slot_local, env_local) -> {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\nexport let emit_closure_call_tail: (Bytes, Int, Int, Int, Int) -> Unit = (buf, env_local, slot_local, closure_type_base, num_args) -> {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nlet rec collect_pattern_bindings: (Pat, Array[String]) -> Int = (pat, bindings) -> {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fpat) = Array::get(fields, i)\n        collect_pattern_bindings(fpat, bindings)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport let rec collect_free_vars_expr: (Expr, Array[String], Array[String], Array[String]) -> Int = (expr, bound, fn_names, out) -> {\n  match expr {\n    EIdent(name) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(fn_names, name) {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    },\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\n    },\n    ECall(callee, args) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(_, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname_raw, _) = Array::get(params, pi)\n        let pnl = String::length(pname_raw)\n        let pname = if pnl > 0 {\n          let plc = String::char_code_at(pname_raw, pnl - 1)\n          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw\n        } else pname_raw\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EReturn(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport let collect_free_vars: (Expr, Array[String], Array[String]) -> Array[String] = (body, param_names, fn_names) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr(body, bound, fn_names, out)\n  out\n}\n\nexport let rec proj_root_ident: (Expr) -> String = (e) -> {\n  match e {\n    EDot(obj, _) => proj_root_ident(obj),\n    EIdent(nm) => nm,\n    _ => \"\"\n  }\n}\n\nexport let rec scope_tail_proj_root: (Expr) -> String = (e) -> {\n  match e {\n    ELet(_, _, b) => scope_tail_proj_root(b),\n    ELetMut(_, _, b) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _) => proj_root_ident(obj),\n    _ => \"\"\n  }\n}\n\nexport let rec is_mut_captured_in: (Expr, String) -> Bool = (expr, name) -> {\n  match expr {\n    EIdent(_) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    ELet(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    ELetMut(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    },\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EFn(_, _, params, _, _, fn_body) => {\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        let param_names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\n          \"\"\n        ], 0, 0))\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EThrow(msg) => is_mut_captured_in(msg, name),\n    EReturn(msg) => is_mut_captured_in(msg, name),\n    _ => false\n  }\n}\n\n\n\n\n\n\nexport enum PerceusActionKind {\n  PaDup;\n  PaDrop;\n  PaAliasDup\n}\n\nexport struct PerceusAction {\n  kind: PerceusActionKind;\n  name: String\n}\n\nstruct PCtx {\n  mut next_id: Int;\n  mut seq_id: Int;\n  names: Array[String];\n  uses: Array[Int];\n  borrows: Array[Int];\n  scalar: Array[Bool];\n  remaining: Array[Int];\n  actions: Array[PerceusAction]\n}\n\n\nlet pctx_new: () -> PCtx = () -> {\n  PCtx::{\n    next_id: 0,\n    seq_id: 0,\n    names: [],\n    uses: [],\n    borrows: [],\n    scalar: [],\n    remaining: [],\n    actions: [],\n  }\n}\n\nlet next_seq_name: (PCtx) -> String = (ctx) -> {\n  let nm = \"__seq\" + __to_string(ctx.seq_id)\n  ctx.seq_id = ctx.seq_id + 1\n  nm\n}\n\nexport let pa_is_drop: (PerceusAction) -> Bool = (a) -> {\n  match a.kind {\n    PaDrop => true,\n    PaDup => false,\n    PaAliasDup => false\n  }\n}\n\nexport let pa_is_dup: (PerceusAction) -> Bool = (a) -> {\n  match a.kind {\n    PaDup => true,\n    PaDrop => false,\n    PaAliasDup => false\n  }\n}\n\nexport let pa_is_alias_dup: (PerceusAction) -> Bool = (a) -> {\n  match a.kind {\n    PaAliasDup => true,\n    PaDup => false,\n    PaDrop => false\n  }\n}\n\nlet is_scalar_expr: (Expr) -> Bool = (e) -> {\n  match e {\n    EInt(_) => true,\n    EBool(_) => true,\n    EFloat(_) => true,\n    EUnit => true,\n    _ => false\n  }\n}\n\nlet rec pat_names: (Pat, Array[String]) -> Int = (pat, out) -> {\n  match pat {\n    PBind(name) => {\n      Array::push(out, name)\n      0\n    },\n    PCtor(_n, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, _r) => pat_names(l, out),\n    PStruct(_n, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pat_names((Array::get(fields, i)).1, out)\n        i = i + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nlet fn_param_names: (Array[(String, Option[TypeExpr])]) -> Array[String] = (params) -> {\n  let out: Array[String] = []\n  let mut i = 0\n  while i < Array::length(params) {\n    Array::push(out, (Array::get(params, i)).0)\n    i = i + 1\n  }\n  out\n}\n\n\nlet pc_declare: (PCtx, String, Bool) -> Int = (ctx, name, scalar) -> {\n  let id = ctx.next_id\n  Array::push(ctx.names, name)\n  Array::push(ctx.uses, 0)\n  Array::push(ctx.borrows, 0)\n  Array::push(ctx.scalar, scalar)\n  ctx.next_id = id + 1\n  id\n}\n\nlet pc_count_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\n  }\n  0\n}\n\nlet pc_count_borrow: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\n  }\n  0\n}\n\nlet copy_ints: (Array[Int]) -> Array[Int] = (src) -> {\n  let out: Array[Int] = []\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::push(out, Array::get(src, i))\n    i = i + 1\n  }\n  out\n}\n\nlet restore_prefix: (Array[Int], Array[Int]) -> Int = (dst, src) -> {\n  let mut i = 0\n  while i < Array::length(src) {\n    Array::set(dst, i, Array::get(src, i))\n    i = i + 1\n  }\n  0\n}\n\nlet int_max: (Int, Int) -> Int = (a, b) -> {\n  if a > b { a } else { b }\n}\n\nlet zeros: (Int) -> Array[Int] = (n) -> {\n  let out: Array[Int] = []\n  let mut i = 0\n  while i < n {\n    Array::push(out, 0)\n    i = i + 1\n  }\n  out\n}\n\nlet is_borrow_arg0_call: (String) -> Bool = (f) -> {\n  f == \"__index\" || f == \"Array::get\" || f == \"Array::length\" || f == \"Array::set\" || f == \"Array::push\"\n}\n\nexport let rec pc_count: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x) => pc_count_use(ctx, scope, x),\n    ECall(callee, args) => {\n      match callee {\n        EIdent(f) => {\n          if is_borrow_arg0_call(f) {\n            0\n          } else {\n            pc_count_borrow(ctx, scope, f)\n          }\n        },\n        _ => pc_count(ctx, scope, callee)\n      }\n      let is_index = match callee {\n        EIdent(f) => is_borrow_arg0_call(f),\n        _ => false\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(obj) => pc_count_borrow(ctx, scope, obj),\n            _ => pc_count(ctx, scope, arg)\n          }\n        } else {\n          pc_count(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field) => {\n      match obj {\n        EIdent(x) => pc_count_borrow(ctx, scope, x),\n        _ => pc_count(ctx, scope, obj)\n      }\n    },\n    ELet(name, value, body) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(value))\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetMut(name, value, body) => {\n      pc_count(ctx, scope, value)\n      let id = pc_declare(ctx, name, is_scalar_expr(value))\n      pc_count(ctx, Map::set(scope, name, id), body)\n    },\n    ELetRec(name, value, body) => {\n      let id = pc_declare(ctx, name, false)\n      let s2 = Map::set(scope, name, id)\n      pc_count(ctx, s2, value)\n      pc_count(ctx, s2, body)\n    },\n    EAssign(_name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_count(ctx, scope, value)\n      pc_count(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_count(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let _id = pc_declare(ctx, nm, is_scalar_expr(a))\n      pc_count(ctx, scope, b)\n    },\n    EBinOp(_op, l, r) => {\n      pc_count(ctx, scope, l)\n      pc_count(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_count(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_count(ctx, scope, cond)\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      pc_count(ctx, scope, then_e)\n      let then_u = copy_ints(ctx.uses)\n      let then_b = copy_ints(ctx.borrows)\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      pc_count(ctx, scope, else_e)\n      let mut id = 0\n      while id < Array::length(snap_u) {\n        let base_u = Array::get(snap_u, id)\n        let dt = Array::get(then_u, id) - base_u\n        let de = Array::get(ctx.uses, id) - base_u\n        Array::set(ctx.uses, id, base_u + int_max(dt, de))\n        let base_b = Array::get(snap_b, id)\n        let dtb = Array::get(then_b, id) - base_b\n        let deb = Array::get(ctx.borrows, id) - base_b\n        Array::set(ctx.borrows, id, base_b + int_max(dtb, deb))\n        id = id + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      pc_count(ctx, scope, cond)\n      pc_count(ctx, scope, body)\n    },\n    EReturn(e) => pc_count(ctx, scope, e),\n    EThrow(e) => pc_count(ctx, scope, e),\n    ESpread(e) => pc_count(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\n    EBreak(opt) => {\n      match opt {\n        Some(e) => pc_count(ctx, scope, e),\n        None => 0\n      }\n    },\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pc_count_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_count(ctx, scope, iterable)\n      let idv = pc_declare(ctx, value_name, false)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pc_declare(ctx, idx, true)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_count(ctx, s3, fbody)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_count(ctx, scope, p.1)\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(p.1))\n        s = Map::set(s, p.0, pid)\n        i = i + 1\n      }\n      pc_count(ctx, s, lbody)\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(sx) => pc_count_borrow(ctx, scope, sx),\n        _ => pc_count(ctx, scope, scrut)\n      }\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = []\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap_u = copy_ints(ctx.uses)\n      let snap_b = copy_ints(ctx.borrows)\n      let max_u = zeros(Array::length(snap_u))\n      let max_b = zeros(Array::length(snap_b))\n      pc_count(ctx, scope, hbody)\n      let mut id0 = 0\n      while id0 < Array::length(snap_u) {\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\n        if du > Array::get(max_u, id0) {\n          Array::set(max_u, id0, du)\n        }\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\n        if db > Array::get(max_b, id0) {\n          Array::set(max_b, id0, db)\n        }\n        id0 = id0 + 1\n      }\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.uses, snap_u)\n        restore_prefix(ctx.borrows, snap_b)\n        let pnames: Array[String] = []\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pc_declare(ctx, nm, false)\n          s = Map::set(s, nm, pid)\n          k = k + 1\n        }\n        pc_count(ctx, s, arm.1)\n        let mut id = 0\n        while id < Array::length(snap_u) {\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\n          if du > Array::get(max_u, id) {\n            Array::set(max_u, id, du)\n          }\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\n          if db > Array::get(max_b, id) {\n            Array::set(max_b, id, db)\n          }\n          id = id + 1\n        }\n        a = a + 1\n      }\n      restore_prefix(ctx.uses, snap_u)\n      restore_prefix(ctx.borrows, snap_b)\n      let mut id2 = 0\n      while id2 < Array::length(snap_u) {\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\n        id2 = id2 + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n\nlet pe_declare: (PCtx, String) -> Int = (ctx, _name) -> {\n  let id = ctx.next_id\n  let owning = Array::get(ctx.uses, id)\n  let init = if owning == 0 { 1 } else { owning }\n  Array::push(ctx.remaining, init)\n  ctx.next_id = id + 1\n  id\n}\n\nlet pe_push: (PCtx, PerceusActionKind, String) -> Int = (ctx, kind, name) -> {\n  Array::push(ctx.actions, PerceusAction::{ kind, name })\n  0\n}\n\nlet pe_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\n  if Map::has_key(scope, name) {\n    let id = Map::get(scope, name)\n    let rem = Array::get(ctx.remaining, id)\n    if rem > 1 && !Array::get(ctx.scalar, id) {\n      pe_push(ctx, PaDup, name)\n    } else {\n      0\n    }\n    if rem > 0 {\n      Array::set(ctx.remaining, id, rem - 1)\n    }\n  }\n  0\n}\n\nlet pe_scope_end: (PCtx, Int, String) -> Int = (ctx, id, name) -> {\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\n    pe_push(ctx, PaDrop, name)\n    Array::set(ctx.remaining, id, 0)\n  }\n  0\n}\n\nexport let rec pc_emit: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {\n  match expr {\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EStringInterp(_) => 0,\n    EIdent(x) => pe_use(ctx, scope, x),\n    ECall(callee, args) => {\n      let is_index = match callee {\n        EIdent(f) => is_borrow_arg0_call(f),\n        _ => false\n      }\n      match callee {\n        EIdent(_) => 0,\n        _ => pc_emit(ctx, scope, callee)\n      }\n      let mut i = 0\n      while i < Array::length(args) {\n        let arg = Array::get(args, i)\n        if is_index && i == 0 {\n          match arg {\n            EIdent(_) => 0,\n            _ => pc_emit(ctx, scope, arg)\n          }\n        } else {\n          pc_emit(ctx, scope, arg)\n        }\n        i = i + 1\n      }\n      0\n    },\n    EDot(obj, _field) => {\n      match obj {\n        EIdent(_) => 0,\n        _ => pc_emit(ctx, scope, obj)\n      }\n    },\n    ELet(name, value, body) => {\n      match value {\n        EIdent(src) => {\n          if Map::has_key(scope, src) {\n            let sid = Map::get(scope, src)\n            let rem = Array::get(ctx.remaining, sid)\n            if rem > 1 && !Array::get(ctx.scalar, sid) {\n              pe_push(ctx, PaAliasDup, name)\n            } else {\n              0\n            }\n            if rem > 0 {\n              Array::set(ctx.remaining, sid, rem - 1)\n            }\n          } else {\n            ()\n          }\n          0\n        },\n        _ => pc_emit(ctx, scope, value)\n      }\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetMut(name, value, body) => {\n      pc_emit(ctx, scope, value)\n      let id = pe_declare(ctx, name)\n      pc_emit(ctx, Map::set(scope, name, id), body)\n      pe_scope_end(ctx, id, name)\n    },\n    ELetRec(name, value, body) => {\n      let id = pe_declare(ctx, name)\n      let s2 = Map::set(scope, name, id)\n      pc_emit(ctx, s2, value)\n      pc_emit(ctx, s2, body)\n      pe_scope_end(ctx, id, name)\n    },\n    EAssign(_name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    EAssignOp(_op, _name, value, body) => {\n      pc_emit(ctx, scope, value)\n      pc_emit(ctx, scope, body)\n    },\n    ESeq(a, b) => {\n      pc_emit(ctx, scope, a)\n      let nm = next_seq_name(ctx)\n      let id = pe_declare(ctx, nm)\n      pc_emit(ctx, scope, b)\n      pe_scope_end(ctx, id, nm)\n    },\n    EBinOp(_op, l, r) => {\n      pc_emit(ctx, scope, l)\n      pc_emit(ctx, scope, r)\n    },\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        pc_emit(ctx, scope, Array::get(items, i))\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      pc_emit(ctx, scope, cond)\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, then_e)\n      restore_prefix(ctx.remaining, snap)\n      pc_emit(ctx, scope, else_e)\n      0\n    },\n    EWhile(cond, body) => {\n      pc_emit(ctx, scope, cond)\n      pc_emit(ctx, scope, body)\n    },\n    EReturn(e) => pc_emit(ctx, scope, e),\n    EThrow(e) => pc_emit(ctx, scope, e),\n    ESpread(e) => pc_emit(ctx, scope, e),\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\n    EBreak(opt) => {\n      match opt {\n        Some(e) => pc_emit(ctx, scope, e),\n        None => 0\n      }\n    },\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\n      let caps = collect_free_vars(fbody, fn_param_names(params), [])\n      let mut i = 0\n      while i < Array::length(caps) {\n        pe_use(ctx, scope, Array::get(caps, i))\n        i = i + 1\n      }\n      0\n    },\n    EForIn(value_name, index_opt, iterable, fbody) => {\n      pc_emit(ctx, scope, iterable)\n      let idv = pe_declare(ctx, value_name)\n      let s2 = Map::set(scope, value_name, idv)\n      let s3 = match index_opt {\n        Some(idx) => {\n          let idi = pe_declare(ctx, idx)\n          Map::set(s2, idx, idi)\n        },\n        None => s2\n      }\n      pc_emit(ctx, s3, fbody)\n      pe_scope_end(ctx, idv, value_name)\n    },\n    ELoop(params, lbody) => {\n      let mut s = scope\n      let pids: Array[Int] = []\n      let pnames: Array[String] = []\n      let mut i = 0\n      while i < Array::length(params) {\n        let p = Array::get(params, i)\n        pc_emit(ctx, scope, p.1)\n        let pid = pe_declare(ctx, p.0)\n        s = Map::set(s, p.0, pid)\n        Array::push(pids, pid)\n        Array::push(pnames, p.0)\n        i = i + 1\n      }\n      pc_emit(ctx, s, lbody)\n      let mut j = 0\n      while j < Array::length(pids) {\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n        j = j + 1\n      }\n      0\n    },\n    EMatch(scrut, arms) => {\n      match scrut {\n        EIdent(_) => 0,\n        _ => pc_emit(ctx, scope, scrut)\n      }\n      let snap = copy_ints(ctx.remaining)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = []\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = []\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        a = a + 1\n      }\n      0\n    },\n    EHandle(hbody, arms) => {\n      let snap = copy_ints(ctx.remaining)\n      pc_emit(ctx, scope, hbody)\n      let mut a = 0\n      while a < Array::length(arms) {\n        let arm = Array::get(arms, a)\n        restore_prefix(ctx.remaining, snap)\n        let pnames: Array[String] = []\n        pat_names(arm.0, pnames)\n        let mut s = scope\n        let pids: Array[Int] = []\n        let mut k = 0\n        while k < Array::length(pnames) {\n          let nm = Array::get(pnames, k)\n          let pid = pe_declare(ctx, nm)\n          s = Map::set(s, nm, pid)\n          Array::push(pids, pid)\n          k = k + 1\n        }\n        pc_emit(ctx, s, arm.1)\n        let mut j = 0\n        while j < Array::length(pids) {\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\n          j = j + 1\n        }\n        a = a + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\nexport let build_perceus_plan: (Expr) -> Array[PerceusAction] = (body) -> {\n  let ctx = pctx_new()\n  let empty: Map[String, Int] = map {}\n  pc_count(ctx, empty, body)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  pc_emit(ctx, empty, body)\n  ctx.actions\n}\n\nlet type_name_is_heap: (String) -> Bool = (n) -> {\n  if String::length(n) == 0 {\n    false\n  } else {\n    let c0 = String::char_code_at(n, 0)\n    if c0 < 'A' || c0 > 'Z' {\n      false\n    } else if n == \"Int\" || n == \"Bool\" || n == \"Double\" || n == \"Float\" || n == \"String\" || n == \"Bytes\" || n == \"Char\" || n == \"Unit\" {\n      false\n    } else {\n      true\n    }\n  }\n}\n\nlet rec type_contains_fn: (TypeExpr) -> Bool = (t) -> {\n  match t {\n    TyFn(_, _, _) => true,\n    TyTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if type_contains_fn(Array::get(elems, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if type_contains_fn(Array::get(args, i)) {\n          found = true\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      found\n    },\n    TyName(_) => false,\n    TyUnit => false\n  }\n}\n\nexport let type_expr_is_heap: (Option[TypeExpr]) -> Bool = (ot) -> {\n  match ot {\n    None => false,\n    Some(t) =>\n      if type_contains_fn(t) {\n        false\n      } else {\n        match t {\n          TyTuple(_) => true,\n          TyApp(_, _) => true,\n          TyName(n) => type_name_is_heap(n),\n          TyFn(_, _, _) => false,\n          TyUnit => false\n        }\n      }\n  }\n}\n\nexport let build_perceus_plan_with_params: (Array[(String, Option[TypeExpr])], Expr) -> Array[PerceusAction] = (params, body) -> {\n  let ctx = pctx_new()\n  let mut scope: Map[String, Int] = map {}\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, ptype) = Array::get(params, pi)\n    let id = pc_declare(ctx, pname, !type_expr_is_heap(ptype))\n    scope = Map::set(scope, pname, id)\n    pi = pi + 1\n  }\n  pc_count(ctx, scope, body)\n  ctx.next_id = 0\n  ctx.seq_id = 0\n  let mut scope2: Map[String, Int] = map {}\n  let param_ids = Array::slice([\n    0\n  ], 0, 0)\n  let mut pj = 0\n  while pj < Array::length(params) {\n    let (pname, _) = Array::get(params, pj)\n    let id = pe_declare(ctx, pname)\n    scope2 = Map::set(scope2, pname, id)\n    Array::push(param_ids, id)\n    pj = pj + 1\n  }\n  pc_emit(ctx, scope2, body)\n  let mut pk = 0\n  while pk < Array::length(params) {\n    let (pname, _) = Array::get(params, pk)\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\n    pk = pk + 1\n  }\n  ctx.actions\n}\n\n\n\nlet op_i32_eq = 70\nlet op_i32_ne = 71\nlet op_i32_eqz = 69\nlet op_i32_mul = 108\nlet op_i32_sub = 107\nlet op_i32_ge_u = 79\nlet op_i32_gt_u = 75\nlet op_i64_load = 41\nlet op_i64_store = 55\n\n\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int];\n  needs_env: Array[Bool]\n}\n\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\nexport struct LambdaTable {\n  bodies: Array[Bytes];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]]\n}\n\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  thunk_names: Array[String];\n  const_int_names: Array[String];\n  const_int_values: Array[Int];\n  enable_rc: Bool;\n  rc_drop_names: Array[String];\n  rc_alias_dup_names: Array[String];\n  heap_binding_names: Array[String];\n  rc_drop_func_idx: Int;\n  rc_alloc_func_idx: Int;\n  rc_dup_names: Array[String]\n}\n\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  ctor_table: CtorTable\n}\n\n\nexport let is_efn: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pint: (Pat) -> Bool = (p) -> {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\nexport let is_slet: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let expr_tag: (Expr) -> Int = (expr) -> {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _) => 8,\n    ELet(_, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EThrow(_) => 23,\n    EFn(_, _, _, _, _, _) => 24,\n    ELoop(_, _) => 25,\n    EReturn(_) => 26,\n    _ => -1\n  }\n}\n\nexport let is_pbind: (Pat) -> Bool = (p) -> {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pbool: (Pat) -> Bool = (p) -> {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pctor: (Pat) -> Bool = (p) -> {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pwild: (Pat) -> Bool = (p) -> {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\nexport let is_eident: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EIdent(_) => true,\n    _ => false\n  }\n}\n\nexport let is_etuple: (Expr) -> Bool = (expr) -> {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\nexport let is_erecord: (Expr) -> Bool = (expr) -> {\n  match expr {\n    ERecord(_) => true,\n    _ => false\n  }\n}\n\nexport let is_earray: (Expr) -> Bool = (expr) -> {\n  match expr {\n    EArray(_) => true,\n    _ => false\n  }\n}\n\nexport let is_ptuple: (Pat) -> Bool = (p) -> {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pstring: (Pat) -> Bool = (p) -> {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nexport let emit_i32_eq: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport let emit_i32_ne: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_ne)\n}\n\nexport let get_arm_pat: ((Pat, Expr)) -> Pat = (arm) -> {\n  let (p, _) = arm\n  p\n}\n\nexport let rec lookup_ctor: (Array[String], String, Int) -> Int = (ctor_names, name, i) -> {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if Array::get(ctor_names, i) == name {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\nexport let is_ctor_call: (Expr, CtorTable) -> Bool = (value, ct) -> {\n  match value {\n    ECall(callee, _) => match callee {\n      EIdent(nm) => lookup_ctor(ct.names, nm, 0) >= 0,\n      _ => false\n    },\n    _ => false\n  }\n}\n\nexport let emit_i32_eqz: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_eqz)\n}\n\nexport let emit_i32_mul: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_mul)\n}\n\nexport let emit_i32_sub: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_sub)\n}\n\nexport let emit_str_ref: (Bytes, Int, Int) -> Unit = (buf, offset, length) -> {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\nexport let get_arm_body: ((Pat, Expr)) -> Expr = (arm) -> {\n  let (_, b) = arm\n  b\n}\n\nexport let get_efn_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eif_cond: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_else: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_then: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_elet_val: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELet(_, val, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let resolve_func: (FuncTable, String) -> (Int, Int, Int) with { Error } = (ft, name) -> {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(ft.names, i) == name {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\nexport let emit_binop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else if op == \"&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"|\" {\n    emit_i64_or(buf)\n  }\n  else if op == \"^\" {\n    emit_i64_xor(buf)\n  }\n  else if op == \"<<\" {\n    emit_i64_shl(buf)\n  }\n  else if op == \">>\" {\n    emit_i64_shr_s(buf)\n  }\n  else if op == \"==\" {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"!=\" {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<\" {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">\" {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<=\" {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">=\" {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"&&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"||\" {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport let emit_i32_ge_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_ge_u)\n}\n\nexport let emit_i32_gt_u: (Bytes) -> Unit = (buf) -> {\n  bytebuf_push(buf, op_i32_gt_u)\n}\n\nexport let emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, op_i64_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let get_ebinop_op: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_elet_body: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    ELet(_, _, body) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_elet_name: (Expr) -> String with { Error } = (expr) -> {\n  match expr {\n    ELet(name, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_func_body: (Stmt) -> Expr with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport let get_slet_expr: (Stmt) -> Expr with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_name: (Stmt) -> String with { Error } = (stmt) -> {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_type: (Stmt) -> Option[TypeExpr] = (stmt) -> {\n  match stmt {\n    SLet(_, _, _, ty, _) => ty,\n    _ => None\n  }\n}\n\nexport let fn_type_param_types: (Option[TypeExpr]) -> Option[Array[TypeExpr]] = (ty) -> {\n  match ty {\n    Some(t) =>\n      match t {\n        TyFn(args, _, _) => Some(args),\n        _ => None\n      },\n    None => None\n  }\n}\n\nexport let resolve_local: (Array[String], String, String) -> Int with { Error } = (names, name, tag) -> {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    let sb = StringBuilder::new()\n    StringBuilder::push(sb, \"undefined variable (local): \")\n    StringBuilder::push(sb, name)\n    StringBuilder::push(sb, \" [locals: \")\n    let mut di = 0\n    let dlen = Array::length(names)\n    while di < dlen {\n      if di > 0 {\n        StringBuilder::push(sb, \", \")\n      }\n      StringBuilder::push(sb, Array::get(names, di))\n      di = di + 1\n    }\n    StringBuilder::push(sb, \"] @\")\n    StringBuilder::push(sb, tag)\n    throw(StringBuilder::freeze(sb))\n  }\n  result\n}\n\nexport let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\n  bytebuf_push(buf, op_i64_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let find_func_stmt: (Array[Stmt], String) -> Stmt with { Error } = (stmts, name) -> {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if sname == name {\n        found = i\n        i = len\n      },\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n\n\n\n\n\n\n\nexport let gen_eq_body: (Int) -> Bytes = (str_eq_idx) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 1)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_end(b)\n  b\n}\n\n\n\n\n\n\n\nexport let gen_str_eq_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_ne(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 6)\n  emit_block_i64(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_i64_const(b, 0)\n  emit_br(b, 3)\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 1)\n  emit_i32