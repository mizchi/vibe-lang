             Some(t) => Some(t),\n                  None => match lookup_array_foreach(name) {\n                    Some(t) => Some(t),\n                    None => match lookup_array_reverse(name) {\n                      Some(t) => Some(t),\n                      None => match lookup_array_any(name) {\n                        Some(t) => Some(t),\n                        None => match lookup_array_find(name) {\n                          Some(t) => Some(t),\n                          None => match lookup_array_sort(name) {\n                            Some(t) => Some(t),\n                            None => match lookup_array_contains(name) {\n                              Some(t) => Some(t),\n                              None => lookup_array_join(name)\n                            }\n                          }\n                        }\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let lookup_array: (String) -> Option[Type] = (name) -> {\n  match lookup_array_group_a(name) {\n    Some(t) => Some(t),\n    None => lookup_array_group_b(name)\n  }\n}\n")
