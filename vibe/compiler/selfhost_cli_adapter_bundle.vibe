let cli_adapter_source_135 = () -> (String, String) {
  ("lib/@vibe/core/sha1.vibe",
"//# @vibe/core/sha1 — SHA1 digest (hex). CANONICAL copy; the compiler\n//# consumes it through the @vibe/core contract import (#741 — the old\n//# vendored twin at vibe/compiler/cache/sha1.vibe and gate 6e are retired).\n\n//# Functions\n\nlet k0: Int = 1518500249\n\nlet k1: Int = 1859775393\n\nlet k2: Int = ((36635 << 16) | 48348)\n\nlet k3: Int = ((51810 << 16) | 49622)\n\nfn ushr(x: Int, n: Int) -> Int {\n  if n == 0 {\n    x\n  }\n  else if n >= 32 {\n    0\n  }\n  else {\n    (x>>n)&((1<<(32 - n)) - 1)\n  }\n}\n\nlet mask32: Int = ((65535 << 16) | 65535)\n\nfn rotl(x: Int, n: Int) -> Int {\n  ((x<<n)|ushr(x, 32 - n))&mask32\n}\n\nfn add32(a: Int, b: Int) -> Int {\n  (a + b)&mask32\n}\n\nlet h0_init: Int = 1732584193\n\nlet h1_init: Int = ((61389 << 16) | 43913)\n\nlet h2_init: Int = ((39098 << 16) | 56574)\n\nlet h3_init: Int = 271733878\n\nlet h4_init: Int = ((50130 << 16) | 57840)\n\nlet hex_table: String = \"0123456789abcdef\"\n\nfn read_word(s: String, idx: Int) -> Int {\n  let offset = idx * 4\n  let b0 = s|>String::char_code_at(offset)\n  let b1 = s|>String::char_code_at(offset + 1)\n  let b2 = s|>String::char_code_at(offset + 2)\n  let b3 = s|>String::char_code_at(offset + 3)\n  ((b0<<24)|(b1<<16)|(b2<<8)|b3)&mask32\n}\n\n/// Read a 32-bit big-endian word from a `Bytes` buffer. Used by the\n/// `build_schedule` / `process_rounds` path that stores the SHA-1\n/// schedule in a `Bytes` (1 byte per cell, no truncation) instead of\n/// a `String` (which forced `acc|>String::concat(word_to_bytes(w))`\n/// on every iteration — O(N²) bytes copied per block on wasm-gc, see\n/// `docs/report/profile-wasm-gc-vs-linear-2026-05-26.md`).\nfn read_word_bytes(b: Bytes, idx: Int) -> Int {\n  let offset = idx * 4\n  let b0 = Bytes::get(b, offset)\n  let b1 = Bytes::get(b, offset + 1)\n  let b2 = Bytes::get(b, offset + 2)\n  let b3 = Bytes::get(b, offset + 3)\n  ((b0<<24)|(b1<<16)|(b2<<8)|b3)&mask32\n}\n\n/// Append the 4 big-endian bytes of `w` to a growing `Bytes`. Each\n/// `Bytes::push` is amortised O(1) (the underlying buffer grows by\n/// 2× when full), so the full 80-word schedule build is O(N) total\n/// instead of the O(N²) tower the original `String::concat`-based\n/// version produced on wasm-gc.\nfn push_word_bytes(b: Bytes, w: Int) -> Unit {\n  Bytes::push(b, ushr(w, 24)&255)\n  Bytes::push(b, ushr(w, 16)&255)\n  Bytes::push(b, ushr(w, 8)&255)\n  Bytes::push(b, w&255)\n}\n\n/// Pad the message to a multiple of 64 bytes per the SHA-1 spec.\n/// Builds via `StringBuilder` so the zero-fill loop doesn't re-copy\n/// the accumulator each iteration — O(N²) → O(N) on wasm-gc.\nfn pad_message(msg: String) -> String {\n  let len = msg|>String::length()\n  let bit_len = len * 8\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, msg)\n  StringBuilder::push(sb, String::from_char_code(128))\n  let mut cur_len = len + 1\n  while cur_len % 64 != 56 {\n    StringBuilder::push(sb, String::from_char_code(0))\n    cur_len = cur_len + 1\n  }\n  // 64-bit big-endian bit-length tail. High 32 bits are always zero\n  // for the input sizes we feed (≤ 2^32 / 8 bytes); the low 32 bits\n  // are emitted explicitly.\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(0))\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 24)&255))\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 16)&255))\n  StringBuilder::push(sb, String::from_char_code(ushr(bit_len, 8)&255))\n  StringBuilder::push(sb, String::from_char_code(bit_len&255))\n  StringBuilder::freeze(sb)\n}\n\nfn to_hex_char(i: Int) -> String {\n  String::substring(hex_table, i, i + 1)\n}\n\nfn byte_to_hex(b: Int) -> String {\n  to_hex_char((b>>4)&15)|>String::concat(to_hex_char(b&15))\n}\n\nfn word_to_hex(w: Int) -> String {\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 24)&255))\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 16)&255))\n  StringBuilder::push(sb, byte_to_hex(ushr(w, 8)&255))\n  StringBuilder::push(sb, byte_to_hex(w&255))\n  StringBuilder::freeze(sb)\n}\n\n/// Build the 320-byte (80-word) SHA-1 schedule into a `Bytes` buffer.\n/// Bytes is i8-per-cell so each codepoint stays within a byte (no\n/// 32-bit truncation problem the `Array[Int]` route hits). Random\n/// read access via `read_word_bytes` is O(1); each `push_word_bytes`\n/// is amortised O(1) — so the 80-iteration expand loop is O(N) instead\n/// of the original String-accumulator's O(N²).\nfn build_schedule(msg: String, block_start: Int) -> Bytes {\n  let arr = Bytes::new()\n  let mut i = 0\n  while i < 16 {\n    let w = read_word(msg, block_start / 4 + i)\n    push_word_bytes(arr, w)\n    i = i + 1\n  }\n  while i < 80 {\n    let w = rotl(\n      read_word_bytes(arr, i - 3) ^\n      read_word_bytes(arr, i - 8) ^\n      read_word_bytes(arr, i - 14) ^\n      read_word_bytes(arr, i - 16),\n      1\n    )\n    push_word_bytes(arr, w)\n    i = i + 1\n  }\n  arr\n}\n\n/// Drive the 80 SHA-1 rounds. `w` is the schedule as `Bytes` (see\n/// `build_schedule`) so each word read is `read_word_bytes(w, i)` —\n/// O(1) lookup, no per-call allocation. The result is returned as a\n/// 5-element `Bytes` buffer (20 bytes) via the same compact write\n/// path the schedule uses, dodging a second tower of `String::concat`\n/// calls.\nfn process_rounds(i: Int, a: Int, b: Int, c: Int, d: Int, e: Int, w: Bytes) -> Bytes {\n  if i >= 80 {\n    let out = Bytes::new()\n    push_word_bytes(out, a)\n    push_word_bytes(out, b)\n    push_word_bytes(out, c)\n    push_word_bytes(out, d)\n    push_word_bytes(out, e)\n    out\n  } else {\n    let f = if i < 20 {\n      (b&c)^((b^mask32)&d)\n    } else if i < 40 {\n      b^c^d\n    } else if i < 60 {\n      (b&c)^(b&d)^(c&d)\n    } else {\n      b^c^d\n    }\n    let k = if i < 20 {\n      k0\n    }\n    else if i < 40 {\n      k1\n    }\n    else if i < 60 {\n      k2\n    }\n    else {\n      k3\n    }\n    let temp = add32(add32(add32(add32(rotl(a, 5), f), e), k), read_word_bytes(w, i))\n    process_rounds(i + 1, temp, a, rotl(b, 30), c, d, w)\n  }\n}\n\nfn process_blocks(msg: String, block_idx: Int, num_blocks: Int, h0: Int, h1: Int, h2: Int, h3: Int, h4: Int) -> String {\n  if block_idx >= num_blocks {\n    // Final 40-char hex digest assembled through a single StringBuilder\n    // freeze (5 word_to_hex pushes), not a tower of String::concat.\n    let sb = StringBuilder::new()\n    StringBuilder::push(sb, word_to_hex(h0))\n    StringBuilder::push(sb, word_to_hex(h1))\n    StringBuilder::push(sb, word_to_hex(h2))\n    StringBuilder::push(sb, word_to_hex(h3))\n    StringBuilder::push(sb, word_to_hex(h4))\n    StringBuilder::freeze(sb)\n  } else {\n    let w = build_schedule(msg, block_idx * 64)\n    let result = process_rounds(0, h0, h1, h2, h3, h4, w)\n    let new_h0 = add32(h0, read_word_bytes(result, 0))\n    let new_h1 = add32(h1, read_word_bytes(result, 1))\n    let new_h2 = add32(h2, read_word_bytes(result, 2))\n    let new_h3 = add32(h3, read_word_bytes(result, 3))\n    let new_h4 = add32(h4, read_word_bytes(result, 4))\n    process_blocks(msg, block_idx + 1, num_blocks, new_h0, new_h1, new_h2, new_h3, new_h4)\n  }\n}\n\nexport fn sha1(msg: String) -> String {\n  let padded = pad_message(msg)\n  let num_blocks = (padded|>String::length()) / 64\n  process_blocks(padded, 0, num_blocks, h0_init, h1_init, h2_init, h3_init, h4_init)\n}\n")
}

let cli_adapter_source_136 = () -> (String, String) {
  ("lib/@vibe/core/hex.vibe",
"//# @vibe/core/hex — lowercase hex encode/decode over byte-strings (one char\n//# code per byte, the same convention sha1's padding and the compiler's\n//# `.hex` artifacts use). decode throws on odd length / non-hex digits.\n\n//# Functions\n\nlet hex_chars: String = \"0123456789abcdef\"\n\nexport let hex_encode = (s: String) -> String {\n  let len = String::length(s)\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let b = String::char_code_at(s, i) & 255\n    let hi = (b >> 4) & 15\n    let lo = b & 15\n    StringBuilder::push(sb, String::substring(hex_chars, hi, hi + 1))\n    StringBuilder::push(sb, String::substring(hex_chars, lo, lo + 1))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nlet hex_digit_value = (c: Int) -> Int with { Error } {\n  if c >= '0' && c <= '9' {\n    c - '0'\n  } else if c >= 'a' && c <= 'f' {\n    c - 'a' + 10\n  } else if c >= 'A' && c <= 'F' {\n    c - 'A' + 10\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nexport let hex_decode = (hex: String) -> String with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"odd-length hex string\")\n  } else {\n    let sb = StringBuilder::new()\n    let mut i = 0\n    while i < len {\n      let hi = hex_digit_value(String::char_code_at(hex, i))\n      let lo = hex_digit_value(String::char_code_at(hex, i + 1))\n      StringBuilder::push(sb, String::from_char_code((hi << 4) | lo))\n      i = i + 2\n    }\n    StringBuilder::freeze(sb)\n  }\n}\n")
}

let cli_adapter_source_137 = () -> (String, String) {
  ("lib/@vibe/core/leb128.vibe",
"//# Functions\n\nexport let read_sleb128 = (buf: Bytes, offset: Int) -> (Int, Int) {\n  let len = Bytes::length(buf)\n  let rec go = (i: Int, result: Int, shift: Int) -> (Int, Int) {\n    if i >= len {\n      (result, i)\n    } else {\n      let byte = buf[i]\n      let value = result|((byte&0x7F)<<shift)\n      let next_shift = shift + 7\n      if eq(byte&0x80, 0) {\n        if (byte&0x40) > 0 {\n          let sign_extend = value|((-1)<<next_shift)\n          (sign_extend, i + 1)\n        } else {\n          (value, i + 1)\n        }\n      } else {\n        go(i + 1, value, next_shift)\n      }\n    }\n  }\n  go(offset, 0, 0)\n}\n\nexport let read_uleb128 = (buf: Bytes, offset: Int) -> (Int, Int) {\n  let len = Bytes::length(buf)\n  let rec go = (i: Int, result: Int, shift: Int) -> (Int, Int) {\n    if i >= len {\n      (result, i)\n    } else {\n      let byte = buf[i]\n      let value = result|((byte&0x7F)<<shift)\n      if eq(byte&0x80, 0) {\n        (value, i + 1)\n      } else {\n        go(i + 1, value, shift + 7)\n      }\n    }\n  }\n  go(offset, 0, 0)\n}\n\nexport let sleb128_size = (n: Int) -> Int {\n  let rec go = (val: Int, count: Int) -> Int {\n    let byte = val&0x7F\n    let next = val>>7\n    if (eq(next, 0) && eq(byte&0x40, 0)) || (eq(next, -1) && (byte&0x40) > 0) {\n      count\n    } else go(next, count + 1)\n  }\n  go(n, 1)\n}\n\nexport let uleb128_size = (n: Int) -> Int {\n  let rec go = (val: Int, count: Int) -> Int {\n    let next = (val>>7)&((1<<25) - 1)\n    if eq(next, 0) {\n      count\n    }\n    else go(next, count + 1)\n  }\n  go(n, 1)\n}\n\nexport let write_sleb128 = (buf: Bytes, n: Int) -> Unit {\n  let mut val = n\n  let mut more = true\n  while more {\n    let byte = val&0x7F\n    val = val>>7\n    if (eq(val, 0) && eq(byte&0x40, 0)) || (eq(val, -1) && (byte&0x40) > 0) {\n      Bytes::push(buf, byte)\n      more = false\n    } else {\n      Bytes::push(buf, byte|0x80)\n    }\n  }\n}\n\nexport let write_uleb128 = (buf: Bytes, n: Int) -> Unit {\n  let mut val = n\n  while true {\n    let byte = val&0x7F\n    val = (val>>7)&((1<<25) - 1)\n    if eq(val, 0) {\n      Bytes::push(buf, byte)\n      break\n    } else {\n      Bytes::push(buf, byte|0x80)\n    }\n  }\n}\n\nexport let encode_sleb128 = (n: Int) -> Bytes {\n  let buf = Bytes::new()\n  write_sleb128(buf, n)\n  buf\n}\n\nexport let encode_uleb128 = (n: Int) -> Bytes {\n  let buf = Bytes::new()\n  write_uleb128(buf, n)\n  buf\n}\n")
}

let cli_adapter_source_138 = () -> (String, String) {
  ("lib/@vibe/core/list.vibe",
"//# @vibe/core/list — cons-list. The contract (index.vibei) re-exports the\n//# List enum via its bodyless `type List[T]` declaration.\n\n//# Types\n\nexport enum List[T] {\n  Nil;\n  Cons(T, List[T])\n}\n\nimpl [T] Iterable for List[T]\n\n//# Functions\n\nexport let rec list_nth = [T](xs: List[T], n: Int) -> Option[T] {\n  match xs {\n    Nil => None,\n    Cons(h, t) => if n == 0 {\n      Some(h)\n    } else list_nth(t, n - 1)\n  }\n}\n\nexport let nth = [T](xs: List[T], n: Int) -> Option[T] {\n  list_nth(xs, n)\n}\n\nexport let list_of3 = [T](a: T, b: T, c: T) -> List[T] {\n  Cons(a, Cons(b, Cons(c, Nil)))\n}\n\nexport let of3 = [T](a: T, b: T, c: T) -> List[T] {\n  list_of3(a, b, c)\n}\n\nexport let list_of5 = [T](a: T, b: T, c: T, d: T, e: T) -> List[T] {\n  Cons(a, Cons(b, Cons(c, Cons(d, Cons(e, Nil)))))\n}\n\nexport let of5 = [T](a: T, b: T, c: T, d: T, e: T) -> List[T] {\n  list_of5(a, b, c, d, e)\n}\n\nexport let list_cons = [T](x: T, xs: List[T]) -> List[T] {\n  Cons(x, xs)\n}\n\nexport let rec list_drop = [T](n: Int, xs: List[T]) -> List[T] {\n  if n <= 0 {\n    xs\n  }\n  else match xs {\n    Nil => Nil,\n    Cons(_, t) => list_drop(n - 1, t)\n  }\n}\n\nexport let drop = [T](xs: List[T], n: Int) -> List[T] {\n  list_drop(n, xs)\n}\n\nexport let list_fold = [A, B](f: (acc: B, x: A) -> B, init: B, xs: List[A]) -> B {\n  let rec go = (acc: B, rest: List[A]) -> B {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(f(acc, h), t)\n    }\n  }\n  go(init, xs)\n}\n\nexport let list_sum: (List[Int]) -> Int = (xs) -> {\n  list_fold((acc: Int, x: Int) -> Int {\n    acc + x\n  }, 0, xs)\n}\n\nexport let sum: (List[Int]) -> Int = (xs) -> {\n  list_sum(xs)\n}\n\nexport let list_head = [T](xs: List[T]) -> Option[T] {\n  match xs {\n    Cons(h, _) => Some(h),\n    _ => None\n  }\n}\n\nexport let head = [T](xs: List[T]) -> Option[T] {\n  list_head(xs)\n}\n\nexport let list_iter = [T, R](f: (x: T) -> R, xs: List[T]) -> Int {\n  let rec go = (count: Int, rest: List[T]) -> Int {\n    match rest {\n      Nil => count,\n      Cons(h, t) => {\n        f(h)\n        go(count + 1, t)\n      }\n    }\n  }\n  go(0, xs)\n}\n\nexport let iter = [T, R](xs: List[T], f: (x: T) -> R) -> Int {\n  list_iter(f, xs)\n}\n\nexport let list_tail = [T](xs: List[T]) -> List[T] {\n  match xs {\n    Cons(_, t) => t,\n    _ => Nil\n  }\n}\n\nexport let tail = [T](xs: List[T]) -> List[T] {\n  list_tail(xs)\n}\n\nexport let list_empty = [T]() -> List[T] {\n  Nil\n}\n\n// package-private: bare alias collides with set.vibe in the flat\n// @vibe/core contract; the canonical name is list_empty.\nlet empty = [T]() -> List[T] {\n  list_empty()\n}\n\nexport let rec list_length = [T](xs: List[T]) -> Int {\n  match xs {\n    Nil => 0,\n    Cons(_, t) => 1 + list_length(t)\n  }\n}\n\nexport let length = [T](xs: List[T]) -> Int {\n  list_length(xs)\n}\n\nexport let iter_length = [T](xs: List[T]) -> Int {\n  list_length(xs)\n}\n\nexport let list_reverse = [T](xs: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(h, acc), t)\n    }\n  }\n  go(Nil, xs)\n}\n\nexport let reverse = [T](xs: List[T]) -> List[T] {\n  list_reverse(xs)\n}\n\nexport let list_map = [A, B](f: (x: A) -> B, xs: List[A]) -> List[B] {\n  let rec go = (acc: List[B], rest: List[A]) -> List[B] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(f(h), acc), t)\n    }\n  }\n  list_reverse(go(Nil, xs))\n}\n\nexport let list_zip = [A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\n  let rec go = (acc: List[(A, B)], left: List[A], right: List[B]) -> List[(A, B)] {\n    match (left, right) {\n      (Cons(x, xt), Cons(y, yt)) => go(Cons((x, y), acc), xt, yt),\n      _ => list_reverse(acc)\n    }\n  }\n  go(Nil, xs, ys)\n}\n\nexport let zip = [A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\n  list_zip(xs, ys)\n}\n\nexport let list_take = [T](n: Int, xs: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T], count: Int) -> List[T] {\n    if count <= 0 {\n      acc\n    }\n    else match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(h, acc), t, count - 1)\n    }\n  }\n  list_reverse(go(Nil, xs, n))\n}\n\nexport let take = [T](xs: List[T], n: Int) -> List[T] {\n  list_take(n, xs)\n}\n\nexport let list_append = [T](xs: List[T], ys: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) => go(Cons(h, acc), t)\n    }\n  }\n  go(ys, list_reverse(xs))\n}\n\nexport let append = [T](xs: List[T], ys: List[T]) -> List[T] {\n  list_append(xs, ys)\n}\n\nexport let list_filter = [T](pred: (x: T) -> Bool, xs: List[T]) -> List[T] {\n  let rec go = (acc: List[T], rest: List[T]) -> List[T] {\n    match rest {\n      Nil => acc,\n      Cons(h, t) =>\n      if pred(h) {\n        go(Cons(h, acc), t)\n      }\n      else go(acc, t)\n    }\n  }\n  list_reverse(go(Nil, xs))\n}\n\nexport let filter = [T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {\n  list_filter(pred, xs)\n}\n\nexport let list_flatmap = [A, B](f: (x: A) -> List[B], xs: List[A]) -> List[B] {\n  let rec go = (rest: List[A]) -> List[B] {\n    match rest {\n      Nil => Nil,\n      Cons(h, t) => list_append(f(h), go(t))\n    }\n  }\n  go(xs)\n}\n\nexport let flatmap = [A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {\n  list_flatmap(f, xs)\n}\n\nexport let list_is_empty = [T](xs: List[T]) -> Bool {\n  xs is Nil\n}\n\n// package-private: bare alias collides with set.vibe in the flat\n// @vibe/core contract; the canonical name is list_is_empty.\nlet is_empty = [T](xs: List[T]) -> Bool {\n  list_is_empty(xs)\n}\n\nexport let rec list_iter_get = [T](xs: List[T], index: Int) -> T {\n  match xs {\n    Cons(h, t) =>\n    if index == 0 {\n      h\n    } else list_iter_get(t, index - 1)\n    Nil => list_iter_get(xs, index)\n  }\n}\n\nexport let iter_get = [T](xs: List[T], index: Int) -> T {\n  list_iter_get(xs, index)\n}\n\nexport let list_singleton = [T](x: T) -> List[T] {\n  Cons(x, Nil)\n}\n\nexport let singleton = [T](x: T) -> List[T] {\n  list_singleton(x)\n}\n\nexport let rec list_contains_by = [T](eq: (a: T, b: T) -> Bool, value: T, xs: List[T]) -> Bool {\n  match xs {\n    Nil => false,\n    Cons(h, t) => if eq(h, value) {\n      true\n    } else list_contains_by(eq, value, t)\n  }\n}\n\n// package-private: bare alias collides with set.vibe in the flat\n// @vibe/core contract; the canonical name is list_contains_by.\nlet contains_by = [T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {\n  list_contains_by(eq, value, xs)\n}\n\nexport let List::nth = [T](xs: List[T], n: Int) -> Option[T] {\n  list_nth(xs, n)\n}\n\nexport let List::sum: (List[Int]) -> Int = (xs) -> {\n  list_sum(xs)\n}\n\nexport let List::zip = [A, B](xs: List[A], ys: List[B]) -> List[(A, B)] {\n  list_zip(xs, ys)\n}\n\nexport let List::drop = [T](xs: List[T], n: Int) -> List[T] {\n  list_drop(n, xs)\n}\n\nexport let List::head = [T](xs: List[T]) -> Option[T] {\n  list_head(xs)\n}\n\nexport let List::iter = [T, R](xs: List[T], f: (x: T) -> R) -> Int {\n  list_iter(f, xs)\n}\n\nexport let List::tail = [T](xs: List[T]) -> List[T] {\n  list_tail(xs)\n}\n\nexport let List::take = [T](xs: List[T], n: Int) -> List[T] {\n  list_take(n, xs)\n}\n\nexport let List::append = [T](xs: List[T], ys: List[T]) -> List[T] {\n  list_append(xs, ys)\n}\n\nexport let List::filter = [T](xs: List[T], pred: (x: T) -> Bool) -> List[T] {\n  list_filter(pred, xs)\n}\n\nexport let List::length = [T](xs: List[T]) -> Int {\n  list_length(xs)\n}\n\nexport let List::flatmap = [A, B](xs: List[A], f: (x: A) -> List[B]) -> List[B] {\n  list_flatmap(f, xs)\n}\n\nexport let List::reverse = [T](xs: List[T]) -> List[T] {\n  list_reverse(xs)\n}\n\nexport let List::is_empty = [T](xs: List[T]) -> Bool {\n  list_is_empty(xs)\n}\n\nexport let List::iter_get = [T](xs: List[T], index: Int) -> T {\n  iter_get(xs, index)\n}\n\nexport let List::contains_by = [T](xs: List[T], eq: (a: T, b: T) -> Bool, value: T) -> Bool {\n  list_contains_by(eq, value, xs)\n}\n\nexport let List::iter_length = [T](xs: List[T]) -> Int {\n  iter_length(xs)\n}\n")
}

let cli_adapter_source_139 = () -> (String, String) {
  ("lib/@vibe/core/set.vibe",
"//# @vibe/core/set — string set. The contract (index.vibei) re-exports the\n//# StringSet enum via its bodyless `type StringSet` declaration.\n\n//# Types\n\nexport enum StringSet {\n  Empty;\n  Node(String, StringSet)\n}\n\n//# Functions\n\nexport let rec size: (StringSet) -> Int = (s: StringSet) -> Int {\n  match s {\n    Empty => 0,\n    Node(_, tail) => 1 + size(tail)\n  }\n}\n\nexport let empty: () -> StringSet = () -> {\n  Empty\n}\n\nexport let rec remove: (StringSet, String) -> StringSet = (s: StringSet, value: String) -> StringSet {\n  match s {\n    Empty => Empty,\n    Node(head, tail) => if head == value {\n      tail\n    } else Node(head, remove(tail, value))\n  }\n}\n\nexport let rec contains: (StringSet, String) -> Bool = (s: StringSet, value: String) -> Bool {\n  match s {\n    Empty => false,\n    Node(head, tail) => if head == value {\n      true\n    } else contains(tail, value)\n  }\n}\n\nexport let add: (StringSet, String) -> StringSet = (s, value) -> {\n  if contains(s, value) {\n    s\n  } else Node(value, s)\n}\n\nexport let is_empty: (StringSet) -> Bool = (s) -> {\n  s is Empty\n}\n\nexport let set_union: (StringSet, StringSet) -> StringSet = (a, b) -> {\n  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {\n    match rest {\n      Empty => acc,\n      Node(head, tail) => go(tail, add(acc, head))\n    }\n  }\n  go(b, a)\n}\n\nexport let from_array: (Array[String]) -> StringSet = (values) -> {\n  let len = Array::length(values)\n  let rec go = (i: Int, acc: StringSet) -> StringSet {\n    if i >= len {\n      acc\n    } else go(i + 1, add(acc, Array::get(values, i)))\n  }\n  go(0, Empty)\n}\n\nexport let set_intersect: (StringSet, StringSet) -> StringSet = (a, b) -> {\n  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {\n    match rest {\n      Empty => acc,\n      Node(head, tail) => if contains(b, head) {\n        go(tail, add(acc, head))\n      } else go(tail, acc)\n    }\n  }\n  go(a, Empty)\n}\n\nexport let set_difference: (StringSet, StringSet) -> StringSet = (a, b) -> {\n  let rec go = (rest: StringSet, acc: StringSet) -> StringSet {\n    match rest {\n      Empty => acc,\n      Node(head, tail) => if contains(b, head) {\n        go(tail, acc)\n      } else go(tail, add(acc, head))\n    }\n  }\n  go(a, Empty)\n}\n\nexport let set_value_to_string = [T](value: T) -> String {\n  __to_string(value)\n}\n\nexport let add_by = [T](s: StringSet, value: T) -> StringSet {\n  add(s, set_value_to_string(value))\n}\n\nexport let remove_by = [T](s: StringSet, value: T) -> StringSet {\n  remove(s, set_value_to_string(value))\n}\n\nexport let contains_by = [T](s: StringSet, value: T) -> Bool {\n  contains(s, set_value_to_string(value))\n}\n\nexport let from_array_by = [T](values: Array[T]) -> StringSet {\n  let len = Array::length(values)\n  let rec go = (i: Int, acc: StringSet) -> StringSet {\n    if i >= len {\n      acc\n    } else go(i + 1, add_by(acc, Array::get(values, i)))\n  }\n  go(0, Empty)\n}\n")
}

let cli_adapter_source_140 = () -> (String, String) {
  ("vibe/compiler/contract/index.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Stmt, TypeExpr\n}\n\nimport ../syntax/token.vibe {\n  Token\n}\n\nimport ../syntax/parser_base.vibe {\n  peek, tk_name\n}\n\nimport ../syntax/parser_expr.vibe {\n  parse_fn_signature\n}\n\nimport ../syntax/parser.vibe {\n  parse_stmt\n}\n\nimport ../syntax/printer.vibe {\n  print_stmt, print_type_expr\n}\n\n// #741: consumed through the @vibe/core contract boundary (directory import\n// resolving via index.vibei), replacing the vendored cache/sha1.vibe twin.\nimport ../../../lib/@vibe/core {\n  sha1\n}\n\n//# Functions\n\n// ADR-0063 Phase C (#729): contract conformance engine for `.vibei` files.\n//\n// A contract file's top level declares the package's public API. This module\n// parses bodyless `fn` declarations (the contract grammar) and checks that a\n// package's implementation statements provide exactly the declared surface:\n// every declared fn exists with a matching signature (param types + labels,\n// generics, return type, effect row), and no exported def is undeclared.\n//\n// This increment is the pure engine + its grammar; wiring into import\n// resolution / the merge layer (directory imports resolving through\n// index.vibei, boundary rules) is the next #729 stage.\n\n// Canonical signature fingerprint: `[T: Eq](Int, x~: Int) -> Ret with { E }`.\n// Labeled params keep their name (the label is ABI); positional params are\n// types only. Built from the same shapes both the contract declaration and\n// the implementation's EFn carry, so string equality is signature equality.\nlet fn_sig_text: (Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], TypeExpr, Option[String]) -> Option[String] = (tps, tbs, params, ret_ty, eff_opt) -> {\n  let mut missing = false\n  let parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, pty_opt) = Array::get(params, i)\n    match pty_opt {\n      Some(pty) => {\n        let tystr = print_type_expr(pty)\n        let entry = if String::ends_with(pname, \"~\") {\n          \"\\{pname}: \\{tystr}\"\n        } else tystr\n        Array::push(parts, entry)\n      },\n      None => { missing = true }\n    }\n    i = i + 1\n  }\n  if missing {\n    None\n  } else {\n    let gen = if Array::length(tps) == 0 {\n      \"\"\n    } else {\n      let entries = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut gi = 0\n      while gi < Array::length(tps) {\n        let tp = Array::get(tps, gi)\n        let mut bound = \"\"\n        let mut bi = 0\n        while bi < Array::length(tbs) {\n          let (bname, bnds) = Array::get(tbs, bi)\n          if bname == tp && Array::length(bnds) > 0 {\n            bound = String::join(bnds, \" + \")\n          } else ()\n          bi = bi + 1\n        }\n        let entry = if String::length(bound) == 0 {\n          tp\n        } else \"\\{tp}: \\{bound}\"\n        Array::push(entries, entry)\n        gi = gi + 1\n      }\n      \"[\\{String::join(entries, \", \")}]\"\n    }\n    let eff = match eff_opt {\n      Some(e) => \" with { \\{e} }\",\n      None => \"\"\n    }\n    Some(\"\\{gen}(\\{String::join(parts, \", \")}) -> \\{print_type_expr(ret_ty)}\\{eff}\")\n  }\n}\n\n// Parse a contract source's top level. Bare `fn` heads become declarations\n// (name, canonical signature); a declaration followed by `{` is an error —\n// contract files carry no bodies. `opaque type Name` declares a public type\n// whose definition lives in an implementation file (#729 C-4). Everything\n// else (implementation imports, transparent type definitions) parses as\n// ordinary statements and is returned alongside.\n// #739: opaque/bodyless type declarations carry (name, arity) so conformance\n// can reject an impl whose type-parameter count differs and the semver\n// surface can see `Box` -> `Box[T]` as a breaking change.\nexport let parse_contract_program: (Array[Token]) -> (Array[(String, String)], Array[(String, Int)], Array[Stmt]) with { Error } = (tokens) -> {\n  let decls = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let opaques = Array::slice([\n    (\"\", 0)\n  ], 0, 0)\n  let stmts = Array::slice([\n    SExport(Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => { done = true },\n      TType => {\n        // Bodyless `type Name` / `type Name[T]` — a TRANSPARENT public type\n        // whose definition lives in an implementation file (the facade\n        // re-exports it; same conformance rules as opaque, opacity is the\n        // only — currently documentation-level — difference). `type X = ..`\n        // (with '=') is the contract-defined alias and parses as a stmt.\n        let mut la = pos + 1\n        let tname = match peek(tokens, la) {\n          TIdent(tn) => tn,\n          _ => \"\"\n        }\n        let mut is_bodyless = false\n        let mut arity = 0\n        if tname == \"\" {\n          ()\n        } else {\n          la = la + 1\n          let mut scan = la\n          match peek(tokens, scan) {\n            TLBracket => {\n              let mut depth = 1\n              // `[T, U]` — parameters at depth 1 are comma-separated (#739).\n              arity = 1\n              scan = scan + 1\n              while depth > 0 {\n                match peek(tokens, scan) {\n                  TLBracket => { depth = depth + 1 },\n                  TRBracket => { depth = depth - 1 },\n                  TComma => if depth == 1 {\n                    arity = arity + 1\n                  } else {\n                    ()\n                  },\n                  TEof => { depth = 0 },\n                  _ => ()\n                }\n                scan = scan + 1\n              }\n            },\n            _ => ()\n          }\n          match peek(tokens, scan) {\n            TEq => {\n              arity = 0\n            },\n            _ => {\n              is_bodyless = true\n              la = scan\n            }\n          }\n        }\n        if is_bodyless {\n          Array::push(opaques, (tname, arity))\n          pos = la\n        } else {\n          let (stmt, next) = parse_stmt(tokens, [], pos)\n          Array::push(stmts, stmt)\n          pos = next\n        }\n      },\n      TIdent(head) => if head == \"opaque\" {\n        match peek(tokens, pos + 1) {\n          TType => match peek(tokens, pos + 2) {\n            TIdent(oname) => {\n              match peek(tokens, pos + 3) {\n                TLBracket => throw(\"opaque type '\\{oname}': type parameters are not yet supported (#729)\"),\n                _ => ()\n              }\n              Array::push(opaques, (oname, 0))\n              pos = pos + 3\n            },\n            _ => throw(\"expected type name after 'opaque type'\")\n          },\n          _ => throw(\"expected 'type' after 'opaque'\")\n        }\n      } else if head == \"fn\" {\n        // where clauses on declarations parse but are not yet part of the\n        // contract fingerprint (conformance/hash coverage comes with the\n        // SMT stage of #731).\n        let (dhead, dsig, _, next) = parse_fn_signature(tokens, pos + 1)\n        let (name, tps, tbs) = dhead\n        let (params, ret_ty, eff_opt) = dsig\n        match peek(tokens, next) {\n          TLBrace => throw(\"contract fn declaration '\\{name}' must not have a body (#729)\"),\n          _ => ()\n        }\n        match fn_sig_text(tps, tbs, params, ret_ty, eff_opt) {\n          Some(sig) => Array::push(decls, (name, sig)),\n          None => throw(\"contract fn declaration '\\{name}' requires full annotations\")\n        }\n        pos = next\n      } else {\n        let (stmt, next) = parse_stmt(tokens, [], pos)\n        Array::push(stmts, stmt)\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, [], pos)\n        Array::push(stmts, stmt)\n        pos = next\n      }\n    }\n  }\n  (decls, opaques, stmts)\n}\n\n// Collect (name, Some(sig) | None, exported) for every top-level let whose\n// value is a function. A None signature means the def lacks the full\n// annotations needed to compare against a contract (e.g. an unannotated\n// lambda) — reported as a conformance error if the name is declared.\nexport let collect_impl_fn_defs: (Array[Stmt]) -> Array[(String, Option[String], Bool)] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", Some(\"\"), false)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, name, _, val) => match val {\n        EFn(tps, tbs, params, ret_opt, eff_opt, _) => {\n          let sig = match ret_opt {\n            Some(ret_ty) => fn_sig_text(tps, tbs, params, ret_ty, eff_opt),\n            None => None\n          }\n          Array::push(out, (name, sig, exported))\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Collect (name, exported) for every top-level type definition (struct /\n// enum / type alias / suberror) — the shapes an `opaque type` declaration\n// can be implemented by.\n// #739: the third element is the implementation's type-parameter count, so\n// conformance can compare it against the contract's declared arity. Structs\n// and suberrors carry no type parameters in the AST — arity 0.\nexport let collect_impl_type_defs: (Array[Stmt]) -> Array[(String, Bool, Int)] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", false, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(exported, name, _, _, _) => Array::push(out, (name, exported, 0)),\n      SEnum(exported, name, tparams, _, _) => Array::push(out, (name, exported, Array::length(tparams))),\n      STypeAlias(exported, name, tparams, _) => Array::push(out, (name, exported, Array::length(tparams))),\n      SSuberror(exported, name, _) => Array::push(out, (name, exported, 0)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Check that `impl_stmts` provide exactly the contract surface. Returns a\n// list of human-readable conformance errors; empty = conformant.\nexport let check_contract: (Array[(String, String)], Array[(String, Int)], Array[Stmt]) -> Array[String] = (decls, opaque_names, impl_stmts) -> {\n  let errors = Array::slice([\n    \"\"\n  ], 0, 0)\n  let defs = collect_impl_fn_defs(impl_stmts)\n  let mut di = 0\n  while di < Array::length(decls) {\n    let (dname, dsig) = Array::get(decls, di)\n    // A declaration is satisfied by ANY exported def with a matching\n    // signature. Same-name defs in OTHER package files (private aliases,\n    // domain-local helpers) are legal and never violations by themselves —\n    // only when NO def satisfies the decl do the candidates drive the\n    // error message (best mismatch first, then export status).\n    let mut satisfied = false\n    let mut seen_any = false\n    let mut best_msg = \"\"\n    let mut fi = 0\n    while fi < Array::length(defs) {\n      let (fname, fsig_opt, fexported) = Array::get(defs, fi)\n      if fname == dname {\n        seen_any = true\n        match fsig_opt {\n          Some(fsig) => if fsig == dsig {\n            if fexported {\n              satisfied = true\n            } else {\n              best_msg = \"contract declaration '\\{dname}' is implemented but not exported by its implementation file\"\n            }\n          } else {\n            if best_msg == \"\" {\n              best_msg = \"signature mismatch for '\\{dname}': contract \\{dsig} but implementation \\{fsig}\"\n            } else ()\n          },\n          None => if best_msg == \"\" {\n            best_msg = \"implementation of '\\{dname}' lacks the full annotations required by the contract\"\n          } else ()\n        }\n      } else ()\n      fi = fi + 1\n    }\n    if satisfied {\n      ()\n    } else if seen_any {\n      Array::push(errors, best_msg)\n    } else {\n      Array::push(errors, \"contract declaration '\\{dname}' has no implementation\")\n    }\n    di = di + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(defs) {\n    let (fname, _fsig_opt, fexported) = Array::get(defs, ei)\n    if fexported {\n      let mut declared = false\n      let mut ci = 0\n      while ci < Array::length(decls) {\n        let (dname, _dsig) = Array::get(decls, ci)\n        if dname == fname {\n          declared = true\n        } else ()\n        ci = ci + 1\n      }\n      if declared {\n        ()\n      } else {\n        Array::push(errors, \"exported '\\{fname}' is not declared in the contract\")\n      }\n    } else ()\n    ei = ei + 1\n  }\n  let type_defs = collect_impl_type_defs(impl_stmts)\n  let mut oi = 0\n  while oi < Array::length(opaque_names) {\n    let (oname, oarity) = Array::get(opaque_names, oi)\n    let mut ofound = false\n    let mut ti = 0\n    while ti < Array::length(type_defs) {\n      let (tname, texported, tarity) = Array::get(type_defs, ti)\n      if tname == oname {\n        ofound = true\n        if texported {\n          ()\n        } else {\n          Array::push(errors, \"opaque type '\\{oname}' is implemented but not exported by its implementation file\")\n        }\n        // #739: the contract's declared type-parameter count is part of the\n        // surface — `type Box[T]` is not satisfied by a nullary `enum Box`.\n        if tarity == oarity {\n          ()\n        } else {\n          Array::push(errors, \"type '\\{oname}' arity mismatch: contract declares \\{oarity} type parameter(s), implementation defines \\{tarity}\")\n        }\n      } else ()\n      ti = ti + 1\n    }\n    if ofound {\n      ()\n    } else {\n      Array::push(errors, \"opaque type '\\{oname}' has no implementation\")\n    }\n    oi = oi + 1\n  }\n  let mut xi = 0\n  while xi < Array::length(type_defs) {\n    let (tname, texported, _) = Array::get(type_defs, xi)\n    if texported {\n      let mut tdeclared = false\n      let mut oj = 0\n      while oj < Array::length(opaque_names) {\n        let (ojname, _) = Array::get(opaque_names, oj)\n        if ojname == tname {\n          tdeclared = true\n        } else ()\n        oj = oj + 1\n      }\n      if tdeclared {\n        ()\n      } else {\n        Array::push(errors, \"exported type '\\{tname}' is not declared in the contract (declare it as `opaque type \\{tname}` or define it transparently in the contract)\")\n      }\n    } else ()\n    xi = xi + 1\n  }\n  errors\n}\n\n// Classify a contract's non-declaration statements: implementation-file\n// imports (`import ./impl.vibe {}`) and transparent type definitions\n// (struct / enum / type alias — the definition IS the contract, so it lives\n// here and passes into the facade verbatim, exported). Anything else is\n// rejected (subpath re-exports arrive with @scope resolution, #730).\nexport let classify_contract_stmts: (Array[Stmt]) -> (Array[String], Array[Stmt]) with { Error } = (stmts) -> {\n  let raws = Array::slice([\n    \"\"\n  ], 0, 0)\n  let type_defs = Array::slice([\n    SExport(Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(raws, raw_path),\n      SStruct(_, name, fields, derives, mut_names) => Array::push(type_defs, SStruct(true, name, fields, derives, mut_names)),\n      SEnum(_, name, tparams, ctors, derives) => Array::push(type_defs, SEnum(true, name, tparams, ctors, derives)),\n      STypeAlias(_, name, tparams, ty) => Array::push(type_defs, STypeAlias(true, name, tparams, ty)),\n      _ => throw(\"unsupported statement in a .vibei contract: only fn declarations, opaque type declarations, transparent type definitions, and implementation-file imports are allowed (#729)\")\n    }\n    i = i + 1\n  }\n  (raws, type_defs)\n}\n\n// Compat shim for the strict v1 shape (implementation imports only).\nexport let contract_impl_import_raw_paths: (Array[Stmt]) -> Array[String] with { Error } = (stmts) -> {\n  let (raws, _) = classify_contract_stmts(stmts)\n  raws\n}\n\n// Desugar a conformance-checked contract to facade source text: one\n// `export <raw> { names }` re-export line per implementation file, each\n// declared name allocated to its first definer. The facade is plain vibe\n// source, so everything downstream of the loader (type db, merge plan,\n// codegen) needs no .vibei awareness — it rides the #716 re-export\n// machinery unchanged.\nexport let contract_facade_source: (Array[(String, String)], Array[(String, Int)], Array[Stmt], Array[(String, Array[Stmt])]) -> String with { Error } = (decls, opaque_names, type_defs, impl_units) -> {\n  let lines = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut tdi = 0\n  while tdi < Array::length(type_defs) {\n    Array::push(lines, print_stmt(Array::get(type_defs, tdi)))\n    tdi = tdi + 1\n  }\n  let allocated = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ui = 0\n  while ui < Array::length(impl_units) {\n    let (raw, unit_stmts) = Array::get(impl_units, ui)\n    let defs = collect_impl_fn_defs(unit_stmts)\n    let unit_types = collect_impl_type_defs(unit_stmts)\n    let names = Array::slice([\n      \"\"\n    ], 0, 0)\n    let mut oi = 0\n    while oi < Array::length(opaque_names) {\n      let (oname, _) = Array::get(opaque_names, oi)\n      let mut otaken = false\n      let mut oai = 0\n      while oai < Array::length(allocated) {\n        if Array::get(allocated, oai) == \"type \\{oname}\" {\n          otaken = true\n        } else ()\n        oai = oai + 1\n      }\n      if otaken {\n        ()\n      } else {\n        let mut here = false\n        let mut uti = 0\n        while uti < Array::length(unit_types) {\n          let (tname, _, _) = Array::get(unit_types, uti)\n          if tname == oname {\n            here = true\n          } else ()\n          uti = uti + 1\n        }\n        if here {\n          Array::push(names, \"type \\{oname}\")\n          Array::push(allocated, \"type \\{oname}\")\n        } else ()\n      }\n      oi = oi + 1\n    }\n    let mut di = 0\n    while di < Array::length(decls) {\n      let (dname, _) = Array::get(decls, di)\n      let mut taken = false\n      let mut ai = 0\n      while ai < Array::length(allocated) {\n        if Array::get(allocated, ai) == dname {\n          taken = true\n        } else ()\n        ai = ai + 1\n      }\n      if taken {\n        ()\n      } else {\n        let mut defined_here = false\n        let mut fi = 0\n        while fi < Array::length(defs) {\n          let (fname, _, fexp) = Array::get(defs, fi)\n          if fname == dname && fexp {\n            defined_here = true\n          } else ()\n          fi = fi + 1\n        }\n        if defined_here {\n          Array::push(names, dname)\n          Array::push(allocated, dname)\n        } else ()\n      }\n      di = di + 1\n    }\n    if Array::length(names) > 0 {\n      Array::push(lines, \"export \\{raw} { \\{String::join(names, \", \")} }\")\n    } else ()\n    ui = ui + 1\n  }\n  if Array::length(allocated) != Array::length(decls) + Array::length(opaque_names) {\n    throw(\"contract facade: some declarations have no implementation file (run check_contract first)\")\n  } else ()\n  String::concat(String::join(lines, \"\\n\"), \"\\n\")\n}\n\n// ADR-0063 §5 (#730): content addressing. Two hashes identify a package:\n//\n// - contract_hash — the API surface only (fn signatures, opaque names,\n//   transparent type definitions), independent of implementation text.\n//   The API-compatibility signal and the dependents' recheck cache key.\n// - package_hash — the merkle over the package's normalized (path, source)\n//   pairs. Paths must be PACKAGE-RELATIVE (the contract as \"index.vibei\",\n//   impls by their raw import spelling) so the hash is location-independent.\n//   Since require/import lines are part of the hashed file contents, pinning\n//   a package hash transitively fixes its dependency choices.\n//\n// Format: `ct:sha1:<40hex>` / `pkg:sha1:<40hex>` (SHA1 per ADR-0004; the\n// scheme prefix leaves room for a stronger digest without ambiguity).\n\nlet sorted_strings: (Array[String]) -> Array[String] = (items) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(items) {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  let n = Array::length(out)\n  let mut a = 0\n  while a < n {\n    let mut b = a + 1\n    let mut min_i = a\n    while b < n {\n      // char-by-char lexicographic compare (String < is length-first)\n      let x = Array::get(out, b)\n      let y = Array::get(out, min_i)\n      let xl = String::length(x)\n      let yl = String::length(y)\n      let mut ci = 0\n      let mut cmp = 0\n      while cmp == 0 && ci < xl && ci < yl {\n        let cx = String::char_code_at(x, ci)\n        let cy = String::char_code_at(y, ci)\n        if cx < cy {\n          cmp = 0 - 1\n        } else if cx > cy {\n          cmp = 1\n        } else ()\n        ci = ci + 1\n      }\n      if cmp == 0 {\n        if xl < yl {\n          cmp = 0 - 1\n        } else if xl > yl {\n          cmp = 1\n        } else ()\n      } else ()\n      if cmp < 0 {\n        min_i = b\n      } else ()\n      b = b + 1\n    }\n    if min_i != a {\n      let tmp = Array::get(out, a)\n      Array::set(out, a, Array::get(out, min_i))\n      Array::set(out, min_i, tmp)\n    } else ()\n    a = a + 1\n  }\n  out\n}\n\nexport let contract_hash: (Array[(String, String)], Array[(String, Int)], Array[Stmt]) -> String = (fn_decls, opaque_names, type_defs) -> {\n  let canon = String::join(sorted_strings(contract_surface_lines(fn_decls, opaque_names, type_defs)), \"\\n\")\n  \"ct:sha1:\\{sha1(String::concat(\"vibei:v1\\n\", canon))}\"\n}\n\nexport let package_hash_from_sources: (Array[(String, String)]) -> String = (sources) -> {\n  let keys = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, _) = Array::get(sources, i)\n    Array::push(keys, path)\n    i = i + 1\n  }\n  let ordered = sorted_strings(keys)\n  let sb = StringBuilder::new()\n  StringBuilder::push(sb, \"vibe-pkg:v1\\n\")\n  let mut ki = 0\n  while ki < Array::length(ordered) {\n    let key = Array::get(ordered, ki)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, text) = Array::get(sources, si)\n      if path == key {\n        StringBuilder::push(sb, \"file \\{path} \\{String::length(text)}\\n\")\n        StringBuilder::push(sb, text)\n        StringBuilder::push(sb, \"\\n\")\n        si = Array::length(sources)\n      } else {\n        si = si + 1\n      }\n    }\n    ki = ki + 1\n  }\n  \"pkg:sha1:\\{sha1(StringBuilder::freeze(sb))}\"\n}\n\n// ADR-0063 §6 (#730 D-2): `require` pin lines. A directive, not statement\n// grammar: `require @scope/name 1.2.3 = #pkg:sha1:<40hex>` lines sit at the\n// top of a file (blank lines / line comments may precede). The loader\n// extracts them BEFORE parsing and blanks them to spaces, so byte offsets —\n// and therefore diagnostics — are preserved (same philosophy as #cfg's\n// tail-append). semver is strict: bare x.y.z or ^x.y.z, full triple only.\n// The constraint is edit-time tooling metadata; the build consumes only the\n// hash. The hash is REQUIRED here until fmt pin-insertion lands (D-3).\n\nlet is_digit_run: (String, Int, Int) -> Bool = (s, from, to) -> {\n  if to <= from {\n    false\n  } else {\n    let mut i = from\n    let mut ok = true\n    while i < to {\n      let c = String::char_code_at(s, i)\n      if c < '0' || c > '9' {\n        ok = false\n        i = to\n      } else {\n        i = i + 1\n      }\n    }\n    ok\n  }\n}\n\nexport let is_strict_semver: (String) -> Bool = (v) -> {\n  let start = if String::starts_with(v, \"^\") {\n    1\n  } else 0\n  let body = String::substring(v, start, String::length(v))\n  let parts = String::split(body, \".\")\n  if Array::length(parts) != 3 {\n    false\n  } else {\n    let a = Array::get(parts, 0)\n    let b = Array::get(parts, 1)\n    let c = Array::get(parts, 2)\n    is_digit_run(a, 0, String::length(a)) && is_digit_run(b, 0, String::length(b)) && is_digit_run(c, 0, String::length(c))\n  }\n}\n\nexport let is_package_pin: (String) -> Bool = (h) -> {\n  if !String::starts_with(h, \"#pkg:sha1:\") {\n    false\n  } else if String::length(h) != 50 {\n    false\n  } else {\n    let mut i = 10\n    let mut ok = true\n    while i < 50 {\n      let c = String::char_code_at(h, i)\n      let is_hex = (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f')\n      if is_hex {\n        i = i + 1\n      } else {\n        ok = false\n        i = 50\n      }\n    }\n    ok\n  }\n}\n\nlet split_fields: (String) -> Array[String] = (line) -> {\n  let raw = String::split(String::trim(line), \" \")\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(raw) {\n    let f = Array::get(raw, i)\n    if String::length(f) > 0 {\n      Array::push(out, f)\n    } else ()\n    i = i + 1\n  }\n  out\n}\n\n// Returns ((name, constraint, pin) triples, source with require lines\n// blanked to spaces). Only the leading directive region is scanned; a\n// `require` line after the first ordinary statement is a parse error\n// downstream (it never parses as a statement), which is intended.\nexport let extract_require_pins: (String) -> (Array[(String, String, String)], String) with { Error } = (source) -> {\n  let pins = Array::slice([\n    (\"\", \"\", \"\")\n  ], 0, 0)\n  let sb = StringBuilder::new()\n  let len = String::length(source)\n  let mut pos = 0\n  let mut scanning = true\n  while pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let line = String::substring(source, pos, nl)\n    let trimmed = String::trim(line)\n    let is_require = scanning && String::starts_with(trimmed, \"require \")\n    if is_require {\n      let fields = split_fields(trimmed)\n      let nfields = Array::length(fields)\n      if nfields != 5 && nfields != 3 {\n        throw(\"malformed require line (expected: require @scope/name x.y.z [= #pkg:sha1:<40hex>]): \\{trimmed}\")\n      } else ()\n      let name = Array::get(fields, 1)\n      let ver = Array::get(fields, 2)\n      if !String::starts_with(name, \"@\") {\n        throw(\"require package name must start with '@': \\{name}\")\n      } else ()\n      if !is_strict_semver(ver) {\n        throw(\"require version must be a strict semver triple (x.y.z or ^x.y.z): \\{ver}\")\n      } else ()\n      // Unpinned (3-field) form: accepted at parse so `vibe fmt` can fill\n      // the pin offline from the store (D-3); the BUILD still refuses to\n      // resolve an unpinned package (hash-only, resolver-free).\n      let pin_hash = if nfields == 5 {\n        let eq = Array::get(fields, 3)\n        let pin = Array::get(fields, 4)\n        if eq == \"=\" {\n          ()\n        } else {\n          throw(\"malformed require line (missing '='): \\{trimmed}\")\n        }\n        if !is_package_pin(pin) {\n          throw(\"require pin must be #pkg:sha1:<40hex> (compute with `vibe hash`): \\{pin}\")\n        } else ()\n        String::substring(pin, 1, String::length(pin))\n      } else {\n        \"\"\n      }\n      Array::push(pins, (name, ver, pin_hash))\n      // blank the line, preserving its byte length\n      let mut bi = 0\n      while bi < String::length(line) {\n        StringBuilder::push(sb, \" \")\n        bi = bi + 1\n      }\n    } else {\n      if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") {\n        ()\n      } else {\n        scanning = false\n      }\n      StringBuilder::push(sb, line)\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = nl + 1\n  }\n  (pins, StringBuilder::freeze(sb))\n}\n\n// ADR-0063 §8 (#732 Phase F): Elm-style machine-verified semver. The\n// version bump a release CLAIMS must match what its contract diff REQUIRES:\n//   patch — the API surface is unchanged (same fn decls, opaques, types)\n//   minor — additions only (every old declaration survives verbatim)\n//   major — anything else\n// \"semver is trusted\" becomes a checkable property instead of a hope.\n\nlet str_in: (Array[String], String) -> Bool = (arr, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Canonical per-declaration lines for a contract surface (shared by\n// contract_hash and the change classifier, so they can never disagree).\nexport let contract_surface_lines: (Array[(String, String)], Array[(String, Int)], Array[Stmt]) -> Array[String] = (fn_decls, opaque_names, type_defs) -> {\n  let lines = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(fn_decls) {\n    let (dname, dsig) = Array::get(fn_decls, i)\n    Array::push(lines, \"fn \\{dname} \\{dsig}\")\n    i = i + 1\n  }\n  let mut oi = 0\n  while oi < Array::length(opaque_names) {\n    let (oname, oarity) = Array::get(opaque_names, oi)\n    // #739: arity is part of the surface — `Box` -> `Box[T]` must classify\n    // as a MAJOR change. Zero-arity keeps the historical `opaque X` line so\n    // existing contract hashes only move for parameterized types.\n    let oline = if oarity == 0 {\n      \"opaque \\{oname}\"\n    } else {\n      \"opaque \\{oname}[\\{oarity}]\"\n    }\n    Array::push(lines, oline)\n    oi = oi + 1\n  }\n  let mut ti = 0\n  while ti < Array::length(type_defs) {\n    Array::push(lines, \"type \\{print_stmt(Array::get(type_defs, ti))}\")\n    ti = ti + 1\n  }\n  lines\n}\n\n// \"patch\" | \"minor\" | \"major\" for old -> new surface lines.\nexport let classify_contract_change: (Array[String], Array[String]) -> String = (old_lines, new_lines) -> {\n  let mut all_old_kept = true\n  let mut i = 0\n  while i < Array::length(old_lines) {\n    if str_in(new_lines, Array::get(old_lines, i)) {\n      ()\n    } else {\n      all_old_kept = false\n    }\n    i = i + 1\n  }\n  if !all_old_kept {\n    \"major\"\n  } else {\n    let mut any_new = false\n    let mut j = 0\n    while j < Array::length(new_lines) {\n      if str_in(old_lines, Array::get(new_lines, j)) {\n        ()\n      } else {\n        any_new = true\n      }\n      j = j + 1\n    }\n    if any_new {\n      \"minor\"\n    } else {\n      \"patch\"\n    }\n  }\n}\n\nlet digits_to_int: (String) -> Int = (raw) -> {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  while i < len {\n    result = result * 10 + (String::char_code_at(raw, i) - 48)\n    i = i + 1\n  }\n  result\n}\n\nlet semver_parts: (String) -> Option[(Int, Int, Int)] = (v) -> {\n  if is_strict_semver(v) && !String::starts_with(v, \"^\") {\n    let parts = String::split(v, \".\")\n    Some((digits_to_int(Array::get(parts, 0)), digits_to_int(Array::get(parts, 1)), digits_to_int(Array::get(parts, 2))))\n  } else {\n    None\n  }\n}\n\n// The bump kind a version transition claims: Some(\"patch\"/\"minor\"/\"major\"),\n// None when the transition is not a single well-formed forward bump.\nexport let semver_bump_kind: (String, String) -> Option[String] = (prev, next) -> {\n  match semver_parts(prev) {\n    None => None,\n    Some(pp) => match semver_parts(next) {\n      None => None,\n      Some(np) => {\n        let (pa, pb, pc) = pp\n        let (na, nb, nc) = np\n        if na == pa + 1 && nb == 0 && nc == 0 {\n          Some(\"major\")\n        } else if na == pa && nb == pb + 1 && nc == 0 {\n          Some(\"minor\")\n        } else if na == pa && nb == pb && nc == pc + 1 {\n          Some(\"patch\")\n        } else {\n          None\n        }\n      }\n    }\n  }\n}\n\n// The publish gate: claimed bump must be exactly what the diff requires.\nexport let verify_publish_bump: (String, String, Array[String], Array[String]) -> Array[String] = (prev_version, next_version, old_lines, new_lines) -> {\n  let errors = Array::slice([\n    \"\"\n  ], 0, 0)\n  let required = classify_contract_change(old_lines, new_lines)\n  match semver_bump_kind(prev_version, next_version) {\n    None => Array::push(errors, \"\\{prev_version} -> \\{next_version} is not a single forward semver bump\"),\n    Some(claimed) => if claimed == required {\n      ()\n    } else {\n      Array::push(errors, \"version \\{prev_version} -> \\{next_version} claims a \\{claimed} bump but the contract change requires \\{required}\")\n    }\n  }\n  errors\n}\n\nexport {\n  parse_contract_program, collect_impl_fn_defs, check_contract\n}\n")
}

let cli_adapter_source_141 = () -> (String, String) {
  ("vibe/compiler/loader/index.vibe",
"//# Imports\n\nimport ../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../core/ast.vibe {\n  Stmt,\n}\n\nimport ../core/types.vibe {\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  env_bind,\n  env_lookup\n}\n\nimport ../checker/checker_stmt.vibe {\n  check_stmts\n}\n\nimport ../runtime/eval_loader/index.vibe {\n  collect_exports, load_and_parse\n}\n\nimport ./header_cache.vibe {\n  contract_sibling_impl_raws, load_or_parse_module_header_fs_impl\n}\n\nimport ../contract/index.vibe {\n  check_contract, classify_contract_stmts, contract_facade_source, contract_hash, contract_surface_lines, extract_require_pins, package_hash_from_sources, parse_contract_program, verify_publish_bump\n}\n\nimport ./manifest_sources.vibe {\n  build_grouped_sources_from_manifest_rows,\n  load_manifest_full_sources,\n  try_collect_manifest_source_groups_fs,\n  try_collect_manifest_sources_fs,\n  try_load_manifest_rows\n}\n\nimport ../cache/persistent_cache.vibe {\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  persistent_module_header_cache_path,\n  persistent_source_group_cache_path,\n  persistent_source_list_cache_path\n}\n\nimport ../module_graph_path.vibe {\n  dir_of_path,\n  normalize_path,\n  resolve_import_path,\n  resolve_import_path_candidates,\n  contains_path,\n  path_set_add,\n  path_set_contains,\n  path_set_new\n}\n\n//# Path helpers\n\nlet source_lookup: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    match found {\n      Some(_) => (),\n      None => {\n        let (p, src) = Array::get(sources, i)\n        if p == path_key {\n          found = Some(src)\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet resolve_path_in_sources: (String, String, Array[(String, String)]) -> Option[(String, String)] = (base_dir, raw_path, sources) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(candidates) {\n    match found {\n      Some(_) => (),\n      None => {\n        let candidate = Array::get(candidates, i)\n        match source_lookup(sources, candidate) {\n          Some(source) => {\n            found = Some((candidate, source))\n          }\n          None => ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(candidates) {\n    if found == \"\" {\n      let candidate = Array::get(candidates, i)\n      let candidate_exists = perform Fs::Exists(candidate)\n      if candidate_exists {\n        found = candidate\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    found\n  }\n}\n\n// #740: normalized for the same reason as manifest_sources' join_path —\n// manifest rows outside the compiler dir must key under the import-resolved\n// spelling.\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\n\nlet string_to_bytes: (String) -> Bytes = (s) -> {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((\n      Array::slice([\"\"], 0, 0),\n      [\"selfhost_sources\", \"selfhost_source_groups\"]\n    ))\n  } else {\n    None\n  }\n}\n\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values: (Array[String]) -> String = (values) -> {\n  // O(N) via StringBuilder (previous accumulator was O(N^2)).\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(sb, header_value_separator)\n    }\n    StringBuilder::push(sb, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nlet split_header_values: (String) -> Array[String] = (text) -> {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_source_specs: () -> Array[(String, String)] = () -> {\n  Array::slice([(\"\", \"\")], 0, 0)\n}\n\nlet copy_source_specs: (Array[(String, String)]) -> Array[(String, String)] = (sources) -> {\n  let out = empty_source_specs()\n  let mut i = 0\n  while i < Array::length(sources) {\n    Array::push(out, Array::get(sources, i))\n    i = i + 1\n  }\n  out\n}\n\nlet empty_group_specs: () -> Array[(String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_source_cache_specs: () -> Array[(String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_group_cache_specs: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_sources) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_sources, (path, source))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, sources) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(sources, (path, source))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(sources, (path, source))\n      Array::push(groups, (group_name, sources))\n    }\n  }\n}\n\nlet push_grouped_source_fingerprint: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source_fingerprint) -> {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_specs) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_specs, (path, source_fingerprint))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, specs) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(specs, (path, source_fingerprint))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let specs = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(specs, (path, source_fingerprint))\n      Array::push(groups, (group_name, specs))\n    }\n  }\n}\n\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet parse_persistent_source_list_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let sources = empty_source_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent source list cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"source\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source list cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, sources)\n}\n\nlet parse_persistent_source_group_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_group_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent source group cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"group\" {\n          if version == 1 {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \"\", Array::get(fields, 3)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source group cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nlet load_source_if_cached_file_spec_matches: (String, String, String) -> Option[String] with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        Some(Fs::read_file(path))\n      } else if String::length(source_fingerprint) > 0 {\n        let source = Fs::read_file(path)\n        if compact_string_fingerprint(source) == source_fingerprint {\n          Some(source)\n        } else {\n          None\n        }\n      } else {\n        None\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      let source = Fs::read_file(path)\n      if compact_string_fingerprint(source) == source_fingerprint {\n        Some(source)\n      } else {\n        None\n      }\n    } else {\n      None\n    }\n  }\n}\n\n// #729/#730: EVERY path that turns an on-disk file into an in-memory source\n// must apply the same ingestion transform — require-pin blanking, and for\n// index.vibei contracts the conformance-checked facade desugar. The cold\n// walk (collect_sources_rec) did; the persistent-cache reconstruction lanes\n// below re-read RAW disk bytes, so a warm cache leaked undesugared contracts\n// into the merge (masked until now because every compiler-bundle change\n// invalidated the caches). Cache validity stays keyed on the RAW file.\n// Exported (#741): the wasi_only MERGE lane (merge_sources.vibe) applies the\n// same ingestion when collecting its import graph, so contract packages\n// (.vibei) resolve in that lane too.\n// #740: the facade output is marked so a second ingestion pass (the\n// collect_source_groups_fs chokepoint below re-ingests EVERY collected\n// source, including ones a cache-reconstruction branch already ingested)\n// recognizes an already-desugared contract instead of re-parsing the facade\n// as contract grammar (which would fail conformance with empty decls).\nlet contract_facade_marker = \"// vibe: contract facade (desugared from .vibei)\\n\"\n\nexport let ingest_source_text_fs: (String, String) -> String with { Error, Fs } = (path, raw) -> {\n  let (_, pin_blanked) = extract_require_pins(raw)\n  if String::ends_with(path, \".vibei\") {\n    if String::starts_with(pin_blanked, contract_facade_marker) {\n      pin_blanked\n    } else {\n      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))\n    }\n  } else {\n    pin_blanked\n  }\n}\n\n// #740: manifest source loaders (manifest_sources.vibe) read RAW disk bytes;\n// a .vibei contract reaching the grouped merge un-desugared left its imports\n// unresolvable (\"undefined variable (local): sha1 @call\" — contract/index.vibe's\n// @vibe/core import never rewrote). Ingest every collected source once here,\n// the single point all collection branches (manifest, caches, recursive walk)\n// flow through.\nlet ingest_grouped_sources_fs: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (groups) -> {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (gname, gsources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(gsources) {\n      let (spath, stext) = Array::get(gsources, si)\n      push_grouped_source(out, gname, spath, ingest_source_text_fs(spath, stext))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet rec load_cached_sources_rec: (Array[(String, String, String)], Int, Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } = (specs, index, out) -> {\n  if index >= Array::length(specs) {\n    Some(out)\n  } else {\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        Array::push(out, (path, ingest_source_text_fs(path, source)))\n        load_cached_sources_rec(specs, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nlet rec load_cached_grouped_sources_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        push_grouped_source(out, group_name, path, ingest_source_text_fs(path, source))\n        load_cached_grouped_sources_rec(rows, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nlet rec load_cached_group_fingerprint_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n      None\n    } else {\n      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)\n      load_cached_group_fingerprint_rec(rows, index + 1, out)\n    }\n  }\n}\n\nlet manifest_cache_is_valid: (Option[(String, String, String)]) -> Bool with { Error, Fs } = (manifest) -> {\n  match manifest {\n    Some((path, stat_token_text, source_fingerprint)) =>\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\n    None => true\n  }\n}\n\nlet load_persistent_sources_cache_if_valid: (String) -> Option[Array[(String, String)]] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_sources_rec(specs, 0, empty_source_specs())\n    }\n  }\n}\n\nlet load_persistent_source_groups_cache_if_valid: (String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\n    }\n  }\n}\n\nlet manifest_path_of: (Option[(String, String, String)]) -> Option[String] = (manifest) -> {\n  match manifest {\n    Some((path, _, _)) => Some(path),\n    None => None\n  }\n}\n\nlet load_persistent_sources_from_group_cache_if_valid: (String) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let specs = empty_source_cache_specs()\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n        Array::push(specs, (path, stat_token_text, source_fingerprint))\n        i = i + 1\n      }\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) => Some((manifest_path_of(manifest), sources)),\n        None => None\n      }\n    }\n  }\n}\n\nlet load_persistent_source_groups_from_source_list_cache_if_valid: (String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) =>\n          match try_load_manifest_rows(entry_path) {\n            Some((base_dir, rows)) => {\n              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\n              Some((manifest_path_of(manifest), groups))\n            },\n            None => {\n              let groups = empty_grouped_sources()\n              Array::push(groups, (\"recursive\", sources))\n              Some((None, groups))\n            }\n          },\n        None => None\n      }\n    }\n  }\n}\n\nexport let load_persistent_source_group_fingerprint_if_valid: (String) -> Option[String] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {\n        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),\n        None => None\n      }\n    }\n  }\n}\n\nlet build_persistent_sources_cache_text: (Option[String], Array[(String, String)]) -> String with { Error, Fs } = (manifest_path, sources) -> {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"source\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              __to_string(Fs::stat_token(path)),\n              String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet build_persistent_source_groups_cache_text: (Option[String], Array[(String, Array[(String, String)])]) -> String with { Error, Fs } = (manifest_path, groups) -> {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      out = String::concat(\n        out,\n        String::concat(\n          \"group\\t\",\n          String::concat(\n            group_name,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                path,\n                String::concat(\n                  \"\\t\",\n                  String::concat(\n                    __to_string(Fs::stat_token(path)),\n                    String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n                  )\n                )\n              )\n            )\n          )\n        )\n      )\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\n  let deps = Array::slice([\"\"], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport let load_or_parse_module_header_fs: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\n}\n\nlet store_persistent_sources_cache: (String, Option[String], Array[(String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, sources) -> {\n  Fs::write_file(\n    persistent_source_list_cache_path(entry_path),\n    build_persistent_sources_cache_text(manifest_path, sources)\n  )\n}\n\nlet store_persistent_source_groups_cache: (String, Option[String], Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } = (entry_path, manifest_path, groups) -> {\n  Fs::write_file(\n    persistent_source_group_cache_path(entry_path),\n    build_persistent_source_groups_cache_text(manifest_path, groups)\n  )\n}\n\nlet copy_grouped_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] = (groups) -> {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let copied_sources = copy_source_specs(sources)\n    Array::push(out, (group_name, copied_sources))\n    gi = gi + 1\n  }\n  out\n}\n\nlet flatten_group_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (groups) -> {\n  let out = empty_source_specs()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(out, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet filter_group_sources: (Array[(String, Array[(String, String)])], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (groups, ordered_sources) -> {\n  let filtered = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      match source_lookup(ordered_sources, path) {\n        Some(_) => Array::push(next_sources, pair),\n        None => ()\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered\n}\n\nlet special_bundle_source_groups: (String) -> Option[Array[(String, Array[(String, String)])]] = (entry_path) -> {\n  let _ = entry_path\n  None\n}\n\nlet normalize_bundle_source_groups: (Array[(String, Array[(String, String)])], String, String) -> Array[(String, Array[(String, String)])] = (groups, main_path, main_source) -> {\n  let normalized = empty_grouped_sources()\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = empty_source_specs()\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nlet special_manifest_sources: (String) -> Option[(String, Array[(String, String)])] = (entry_path) -> {\n  let _ = entry_path\n  None\n}\n\nlet special_manifest_source_groups: (String) -> Option[(String, Array[(String, Array[(String, String)])])] = (entry_path) -> {\n  let _ = entry_path\n  None\n}\n\n\n//# Helper functions\n\n// Cache lookup helper\nlet cache_lookup: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet export_marker_name: (String) -> String = (name) -> {\n  String::concat(\"__vibe_internal_export__:\", name)\n}\n\nlet env_has_export_marker: (TypeEnv, String) -> Bool = (env, name) -> {\n  match env_lookup(env, export_marker_name(name)) {\n    Some(_) => true,\n    None => false\n  }\n}\n\nlet bind_export_markers: (TypeEnv, Array[String]) -> TypeEnv = (env, exports) -> {\n  let mut acc = env\n  let mut i = 0\n  while i < Array::length(exports) {\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\n    i = i + 1\n  }\n  acc\n}\n\n// Bind imported names from a checked module's env\nlet rec bind_checked_imports: (Array[(String, Option[String])], Int, TypeEnv, TypeEnv) -> TypeEnv = (names, i, env, mod_env) -> {\n  if i >= Array::length(names) {\n    env\n  } else {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if env_has_export_marker(mod_env, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env)\n  }\n}\n\n//# Module Loader\n\n// Check a module and return its TypeEnv, resolving imports recursively.\n// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).\nexport let rec check_module: (String, String, Array[(String, String)], Array[String], Array[(String, TypeEnv)]) -> TypeEnv with { Error } = (source, path, sources, loading, checked_cache) -> {\n  // Check cache first\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      // Cycle detection\n      if contains_path(loading, path) {\n        throw(String::concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of_path(path)\n      // Cycle-detection stack: push self before recursing through this\n      // module's imports, truncate back when done. O(1) per frame vs.\n      // the previous `Array::concat(loading, [path])`, which copied the\n      // entire ancestor stack on every recursion and made nested module\n      // loads O(depth²) — same idiom as `runtime/typecheck_fs.vibe`\n      // (#366 truncate cutover).\n      let saved_loading_len = Array::length(loading)\n      Array::push(loading, path)\n\n      // Resolve imports using while loop\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < Array::length(stmts) {\n        let stmt = Array::get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          SReExport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n      Array::truncate(loading, saved_loading_len)\n\n      // Type-check with imported env\n      let empty_defs = Array::slice([TDAlias(\"_dummy\", Array::slice([\"\"], 0, 0), CtUnit)], 0, 0)\n      let check_errors = Array::slice([\n        \"\"\n      ], 0, 0)\n      // (8th arg: the typed-hover tytab — unused in this lane. The stale\n      // 7-arg call only surfaced under the cold-cache whole-graph check,\n      // #740 fallout.)\n      let check_tytab = Array::slice([\n        (0, CtUnit)\n      ], 0, 0)\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors, check_tytab)\n\n      // Cache result\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\n      Array::push(checked_cache, (path, cached_env))\n      cached_env\n    }\n  }\n}\n\n//# FS-based source collection\n\n// `visited` is a `path_set` (#533): this recursion runs once per import\n// EDGE and the visited set grows to every module of the program, so the\n// previous linear `contains_path` scan was O(edges × modules). The set is\n// membership-only — `sources` keeps its own dependency-first order from\n// the recursion, which is what callers consume.\n// #729 (ADR-0063 Phase C-2): ingest an index.vibei contract. The contract is\n// conformance-checked against its declared implementation files and desugared\n// to plain facade source (re-export lines), so everything downstream of the\n// loader — type db, merge plan, codegen — sees ordinary vibe source and needs\n// no .vibei awareness. Implementation files are DECLARED by the contract\n// (`import ./impl.vibe {}`) rather than discovered: the Fs effect has no\n// directory listing yet (auto-discovery arrives with Fs::ReadDir, #730).\nlet desugar_contract_source_fs: (String, String) -> String with { Error, Fs } = (path, source) -> {\n  let dir = dir_of_path(path)\n  let sibling_index = String::concat(dir, \"/index.vibe\")\n  if Fs::exists(sibling_index) {\n    throw(\"both index.vibe and index.vibei exist in \\{dir} (#729): a boundary has exactly one index\")\n  } else ()\n  let (decls, opaque_names, extra) = parse_contract_program(lex(source))\n  let (impl_raws0, type_defs) = classify_contract_stmts(extra)\n  // #730: explicit `import ./impl.vibe {}` declarations win; a contract that\n  // declares none auto-discovers its sibling *.vibe files (Fs::readdir,\n  // byte-sorted by the host so the facade is deterministic).\n  let impl_raws = if Array::length(impl_raws0) == 0 {\n    contract_sibling_impl_raws(dir)\n  } else {\n    impl_raws0\n  }\n  let impl_units = Array::slice([\n    (\"\", Array::slice([\n      SExport(Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0))\n  ], 0, 0)\n  let union_stmts = Array::slice([\n    SExport(Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut ri = 0\n  while ri < Array::length(impl_raws) {\n    let raw = Array::get(impl_raws, ri)\n    let resolved = resolve_import_path(dir, raw)\n    let impl_text = Fs::read_file(resolved)\n    // impl files may carry their own require pin lines (extracted for real\n    // when the file itself is ingested) — blank them for the conformance\n    // parse here.\n    let (_, impl_blanked) = extract_require_pins(impl_text)\n    let impl_stmts = parse_program(lex(impl_blanked))\n    Array::push(impl_units, (raw, impl_stmts))\n    let mut si = 0\n    while si < Array::length(impl_stmts) {\n      Array::push(union_stmts, Array::get(impl_stmts, si))\n      si = si + 1\n    }\n    ri = ri + 1\n  }\n  let errors = check_contract(decls, opaque_names, union_stmts)\n  if Array::length(errors) > 0 {\n    throw(\"\\{path}: contract violation: \\{String::join(errors, \"; \")}\")\n  } else ()\n  contract_facade_source(decls, opaque_names, type_defs, impl_units)\n}\n\n// #730 (D-2): both content-addressing hashes of a contract package, from its\n// ORIGINAL on-disk texts (require lines included — they are part of the\n// hashed content, which is what makes a direct pin fix the transitive\n// closure). Paths in the package hash are package-relative (\"index.vibei\" +\n// each impl's raw import spelling), so the hash is location-independent —\n// the same function serves `vibe hash` on a working directory and store\n// verification of an installed copy.\nexport let contract_package_hashes_fs: (String) -> (String, String) with { Error, Fs } = (path) -> {\n  let raw = Fs::read_file(path)\n  let (_, blanked) = extract_require_pins(raw)\n  let (decls, opaques, extra) = parse_contract_program(lex(blanked))\n  let (impl_raws0, type_defs) = classify_contract_stmts(extra)\n  let dir = dir_of_path(path)\n  // #730: mirror the ingestion's auto-discovery — the package hash must cover\n  // the same impl files the facade is built from. Discovered raws are\n  // \"./<name>\" and byte-sorted, so the hash stays location-independent and\n  // deterministic.\n  let impl_raws = if Array::length(impl_raws0) == 0 {\n    contract_sibling_impl_raws(dir)\n  } else {\n    impl_raws0\n  }\n  let sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  Array::push(sources, (\"index.vibei\", raw))\n  let mut ri = 0\n  while ri < Array::length(impl_raws) {\n    let iraw = Array::get(impl_raws, ri)\n    let itext = Fs::read_file(resolve_import_path(dir, iraw))\n    Array::push(sources, (iraw, itext))\n    ri = ri + 1\n  }\n  (package_hash_from_sources(sources), contract_hash(decls, opaques, type_defs))\n}\n\n// #730 (D-3): fill missing require pins OFFLINE from the workspace store.\n// `require @x/y 1.2.3` becomes `require @x/y 1.2.3 = #pkg:sha1:<hex>` when\n// .vibe/store/@x/y/ is installed; a package absent from the store is an\n// error (network fetch belongs to `vibe add`/`update`, never to fmt).\n// Pinned lines pass through untouched, so the rewrite is idempotent.\nexport let fill_require_pins_fs: (String) -> String with { Error, Fs } = (source) -> {\n  fill_require_pins_fs_mode(source, false)\n}\n\n// repin=true rewrites EVERY require line to the store's current hash —\n// `vibe dedupe --apply` (#730 D-4): after updating a store package, one\n// pass re-points all pins in a file at the installed copies. With the\n// by-name store there is one installed version per package, so repinning\n// IS conflict resolution.\nexport let fill_require_pins_fs_mode: (String, Bool) -> String with { Error, Fs } = (source, repin) -> {\n  let sb = StringBuilder::new()\n  let len = String::length(source)\n  let mut pos = 0\n  let mut scanning = true\n  while pos < len {\n    let mut nl = pos\n    while nl < len && String::char_code_at(source, nl) != 10 {\n      nl = nl + 1\n    }\n    let line = String::substring(source, pos, nl)\n    let trimmed = String::trim(line)\n    let mut emitted = false\n    if scanning && String::starts_with(trimmed, \"require \") {\n      let (pins_one, _) = extract_require_pins(String::concat(trimmed, \"\\n\"))\n      if Array::length(pins_one) == 1 {\n        let (pname, pver, ppin) = Array::get(pins_one, 0)\n        if ppin == \"\" || repin {\n          let store_index = String::concat(\".vibe/store/\", String::concat(pname, \"/index.vibei\"))\n          if Fs::exists(store_index) {\n            ()\n          } else {\n            throw(\"cannot pin \\{pname} offline: not installed in the store (.vibe/store/\\{pname}/)\")\n          }\n          let (pkg_hash, _) = contract_package_hashes_fs(store_index)\n          StringBuilder::push(sb, \"require \\{pname} \\{pver} = #\\{pkg_hash}\")\n          emitted = true\n        } else ()\n      } else ()\n    } else {\n      if String::length(trimmed) == 0 || String::starts_with(trimmed, \"//\") {\n        ()\n      } else {\n        scanning = false\n      }\n    }\n    if emitted {\n      ()\n    } else {\n      StringBuilder::push(sb, line)\n    }\n    if nl < len {\n      StringBuilder::push(sb, \"\\n\")\n    } else ()\n    pos = nl + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\n// #732 (Phase F): publish gate. Parse the previous and next contract\n// surfaces and verify the claimed version bump is exactly what the diff\n// requires (Elm-style machine-checked semver). Returns error strings;\n// empty = the release claim is honest.\nexport let publish_check_fs: (String, String, String, String) -> Array[String] with { Error, Fs } = (prev_contract_path, next_contract_path, prev_version, next_version) -> {\n  let (_, prev_blanked) = extract_require_pins(Fs::read_file(prev_contract_path))\n  let (pd, po, pextra) = parse_contract_program(lex(prev_blanked))\n  let (_, ptypes) = classify_contract_stmts(pextra)\n  let (_, next_blanked) = extract_require_pins(Fs::read_file(next_contract_path))\n  let (nd, no, nextra) = parse_contract_program(lex(next_blanked))\n  let (_, ntypes) = classify_contract_stmts(nextra)\n  verify_publish_bump(\n    prev_version,\n    next_version,\n    contract_surface_lines(pd, po, ptypes),\n    contract_surface_lines(nd, no, ntypes)\n  )\n}\n\n// #730 (D-2): verify a store-resolved package against the importer's require\n// pin. The store is laid out BY NAME (.vibe/store/@scope/name/) and trusted\n// only through this hash check, so any mirror/copy mechanism is fine.\nlet verify_store_package_fs: (String, Array[(String, String, String)], String) -> Unit with { Error, Fs } = (importer, pins, store_index_path) -> {\n  let prefix = \".vibe/store/\"\n  let suffix = \"/index.vibei\"\n  let name = String::substring(\n    store_index_path,\n    String::length(prefix),\n    String::length(store_index_path) - String::length(suffix)\n  )\n  let mut pin_hash = \"\"\n  let mut pin_found = false\n  let mut pi = 0\n  while pi < Array::length(pins) {\n    let (pname, _, phash) = Array::get(pins, pi)\n    if pname == name {\n      pin_hash = phash\n      pin_found = true\n    } else ()\n    pi = pi + 1\n  }\n  if pin_found {\n    ()\n  } else {\n    throw(\"no require pin for \\{name} in \\{importer} (add: require \\{name} <x.y.z> = #<pkg-hash>; compute with `vibe hash`)\")\n  }\n  if pin_hash == \"\" {\n    throw(\"unpinned require for \\{name} in \\{importer}: run `vibe fmt` (VIBE_FILL_PINS=1) to insert the pin from the store\")\n  } else ()\n  if Fs::exists(store_index_path) {\n    ()\n  } else {\n    throw(\"package \\{name} is not installed in the store (.vibe/store/\\{name}/)\")\n  }\n  let (actual, _) = contract_package_hashes_fs(store_index_path)\n  if actual == pin_hash {\n    ()\n  } else {\n    throw(\"pin mismatch for \\{name}: \\{importer} requires #\\{pin_hash} but the store copy is #\\{actual}\")\n  }\n}\n\n// #729 (Phase C-3): incoming boundary enforcement. A directory with an\n// index.vibei contract is a boundary: files outside it may import only the\n// contract itself, never package internals. Checked at every ancestor level\n// of the target, so nested contract packages are boundaries too. Directories\n// with a plain index.vibe keep the legacy permissive behavior until the\n// Phase G migration (#732) — the existing tree imports files inside such\n// directories directly. The escape rule (relative imports above the package\n// root) arrives with @scope resolution (#730).\nlet enforce_incoming_boundary_fs: (String, String) -> Unit with { Error, Fs } = (importer, target) -> {\n  let tlen = String::length(target)\n  let mut p = 0\n  while p < tlen {\n    if String::char_code_at(target, p) == '/' && p > 0 {\n      let dir = target[0:p]\n      let contract = String::concat(dir, \"/index.vibei\")\n      if target == contract {\n        ()\n      } else if Fs::exists(contract) {\n        let dir_prefix = String::concat(dir, \"/\")\n        if String::starts_with(importer, dir_prefix) {\n          ()\n        } else {\n          throw(\"cannot import \\{target} from outside its package boundary \\{dir} (#729); import \\{dir} (its contract) instead\")\n        }\n      } else ()\n    } else ()\n    p = p + 1\n  }\n}\n\nlet rec collect_sources_rec: (String, Array[(String, String)], Array[Array[String]]) -> Unit with { Error, Fs } = (path, sources, visited) -> {\n  if path_set_contains(visited, path) {\n    ()\n  }\n  else {\n    path_set_add(visited, path)\n    let raw_source = Fs::read_file(path)\n    // #730 (D-2): require pin lines are a leading directive, extracted and\n    // blanked (offset-preserving) before anything parses the source.\n    let (pins, pin_blanked) = extract_require_pins(raw_source)\n    // #749: the facade MUST carry contract_facade_marker — every collected\n    // source is re-ingested at the collect_source_groups_fs chokepoint, and\n    // an unmarked facade re-enters desugar_contract_source_fs as if it were\n    // raw contract grammar (classify_contract_stmts rejects its re-export\n    // lines). This walk used to emit the bare facade; only the cold first\n    // pass reaches it, so the failure hid behind the runner's module-init\n    // re-run (#749).\n    let source = if String::ends_with(path, \".vibei\") {\n      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))\n    } else {\n      pin_blanked\n    }\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    // First, recurse into dependencies (imports and re-exports)\n    let mut i = 0\n    while i < Array::length(deps) {\n      let dep = Array::get(deps, i)\n      enforce_incoming_boundary_fs(path, dep)\n      // Only a store PACKAGE reference (its contract) is pin-verified;\n      // paths inside an already-verified store package (its impl files)\n      // are covered by that package's hash.\n      if String::starts_with(dep, \".vibe/store/\") && String::ends_with(dep, \"/index.vibei\") {\n        verify_store_package_fs(path, pins, dep)\n      } else ()\n      collect_sources_rec(dep, sources, visited)\n      i = i + 1\n    }\n    // Then add this module (dependencies come first)\n    Array::push(sources, (path, source))\n  }\n}\n\n// Recursively collect all source files from filesystem, following imports and re-exports.\n// Returns Array[(path, source)] in dependency order (dependencies first).\nexport let collect_all_sources_fs: (String) -> Array[(String, String)] with { Error, Fs } = (entry_path) -> {\n  match special_manifest_sources(entry_path) {\n    Some((manifest_path, sources)) => {\n      let _ = manifest_path\n      copy_source_specs(sources)\n    },\n    None =>\n      match load_persistent_sources_cache_if_valid(entry_path) {\n        Some(sources) => sources,\n        None => {\n          match try_collect_manifest_sources_fs(entry_path) {\n            Some((manifest_path, sources)) => {\n              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\n              sources\n            },\n            None => {\n              match try_load_manifest_rows(entry_path) {\n                Some((base_dir, rows)) => {\n                  let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\n                  preloaded_sources\n                },\n                None => {\n                  let sources = Array::slice([(\"\", \"\")], 0, 0)\n                  let visited = path_set_new()\n                  collect_sources_rec(entry_path, sources, visited)\n                  store_persistent_sources_cache(entry_path, None, sources)\n                  sources\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}\n\n// #740: the grouped merge (db_grouped_merged_source) treats the LAST\n// flattened source as the export-rename plan entry — its exports stay\n// UNRENAMED. Manifest collection returns sources in MANIFEST ROW ORDER, so a\n// manifest-listed entry that is not the last needed row left some LATER dep\n// exempt from renames instead of the entry: callers were rewritten to that\n// dep's `_exp_<path>` names whose defs were never emitted (\"undefined\n// variable (local): ripple_get_fingerprint_exp_...\" when FS-compiling\n// runtime/typecheck_fs.vibe, row 152, whose ripple deps sit at rows 150-151).\n// Centralized here (rather than in each collection branch) so groups\n// reconstructed from PERSISTENT CACHES get the same ordering guarantee.\n// No-op when the entry is already last (the plain recursive walk).\nlet move_entry_last_grouped: (Array[(String, Array[(String, String)])], String) -> Array[(String, Array[(String, String)])] = (groups, entry_path) -> {\n  let glen = Array::length(groups)\n  let mut total = 0\n  let mut gi = 0\n  while gi < glen {\n    let (_, gsources) = Array::get(groups, gi)\n    total = total + Array::length(gsources)\n    gi = gi + 1\n  }\n  let mut seen = 0\n  let mut entry_is_last = false\n  let mut entry_found = false\n  let mut entry_source = \"\"\n  gi = 0\n  while gi < glen {\n    let (_, gsources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(gsources) {\n      seen = seen + 1\n      let (spath, stext) = Array::get(gsources, si)\n      if spath == entry_path {\n        entry_found = true\n        entry_source = stext\n        if seen == total {\n          entry_is_last = true\n        } else {\n          ()\n        }\n      } else {\n        ()\n      }\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  if !entry_found || entry_is_last {\n    groups\n  } else {\n    let out = empty_grouped_sources()\n    gi = 0\n    while gi < glen {\n      let (gname, gsources) = Array::get(groups, gi)\n      let mut si = 0\n      while si < Array::length(gsources) {\n        let (spath, stext) = Array::get(gsources, si)\n        if spath == entry_path {\n          ()\n        } else {\n          push_grouped_source(out, gname, spath, stext)\n        }\n        si = si + 1\n      }\n      gi = gi + 1\n    }\n    push_grouped_source(out, \"entry_last\", entry_path, entry_source)\n    out\n  }\n}\n\nexport let collect_source_groups_fs: (String) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  let collected = match special_manifest_source_groups(entry_path) {\n    Some((manifest_path, groups)) => {\n      let _ = manifest_path\n      copy_grouped_sources(groups)\n    },\n    None =>\n      match load_persistent_source_groups_cache_if_valid(entry_path) {\n        Some(groups) => groups,\n        None =>\n          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\n            Some((manifest_path, groups)) => {\n              store_persistent_source_groups_cache(entry_path, manifest_path, groups)\n              groups\n            },\n            None =>\n              match try_collect_manifest_source_groups_fs(entry_path) {\n                Some((manifest_path, groups)) => {\n                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                  groups\n                },\n                None =>\n                  match try_load_manifest_rows(entry_path) {\n                    Some((base_dir, rows)) => {\n                      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                      let groups = empty_grouped_sources()\n                      let mut j = 0\n                      while j < Array::length(rows) {\n                        let (group_name, rel_path) = Array::get(rows, j)\n                        let path = join_path(base_dir, rel_path)\n                        let mut found = \"\"\n                        let mut k = 0\n                        while k < Array::length(preloaded_sources) {\n                          if found == \"\" {\n                            let (source_path, source_text) = Array::get(preloaded_sources, k)\n                            if source_path == path {\n                              found = source_text\n                            }\n                          }\n                          k = k + 1\n                        }\n                        if found == \"\" {\n                          ()\n                        } else {\n                          push_grouped_source(groups, group_name, path, found)\n                        }\n                        j = j + 1\n                      }\n                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                      groups\n                    },\n                    None => {\n                      let groups = empty_grouped_sources()\n                      let recursive_sources = collect_all_sources_fs(entry_path)\n                      Array::push(groups, (\"recursive\", recursive_sources))\n                      store_persistent_source_groups_cache(entry_path, None, groups)\n                      groups\n                    }\n                  }\n              }\n          }\n      }\n  }\n  move_entry_last_grouped(ingest_grouped_sources_fs(collected), entry_path)\n}\n\n//# Module bundling — merge stmts from all modules in dependency order\n\n// Given all sources (in dependency order), parse and merge their statements.\n// Skips SImport, SReExport (already resolved). Keeps all definitions.\nexport let collect_merged_stmts: (Array[(String, String)]) -> Array[Stmt] with { Error } = (sources) -> {\n  let merged = Array::slice([SExport([\"_dummy\"])], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, src) = Array::get(sources, si)\n    // Use lex+parse_program directly (skip resolve_interp_stmt to reduce heap pressure)\n    let stmts = parse_program(lex(src))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n")
}

let cli_adapter_source_142 = () -> (String, String) {
  ("vibe/compiler/module_loader.vibe",
"//# Imports\n\nexport ./loader {\n  check_module, collect_all_sources_fs, collect_merged_stmts, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\n//# Misc\n\nexport {\n  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\n}\n")
}

let cli_adapter_source_143 = () -> (String, String) {
  ("vibe/compiler/normalize/index.vibe",
"//# `vibe normalize` engine (selfhost vertical slice, #594)\n//#\n//# A canonicalizing source transform built on the compiler's own AST. The first\n//# slice implements the structural pipeline:\n//#\n//#   parse -> flatten modules (`module m { let f }` => `let m::f`)\n//#         -> dead-code elimination from exported roots\n//#         -> drop redundant aggregate `export { .. }` statements\n//#         -> categorize into Imports / Types / Functions / Tests sections\n//#         -> render via the AST printer with section headers + blank lines\n//#\n//# Deferred to follow-ups (the host engine is ~6.6k lines): inline/const fold,\n//# inferred type annotations, decl-separator / labeled-arg quickfixes, and\n//# semver dependency `latest` resolution.\n\n//# Imports\n\nimport ../contract/index.vibe {\n  extract_require_pins\n}\n\nimport ../core/ast.vibe {\n  Stmt, TypeExpr, Expr, Pat\n}\n\nimport ../core/dce.vibe {\n  dce_stmts\n}\n\nimport ../syntax/index.vibe {\n  Token, lex, parse_program, print_stmt\n}\n\nimport ../syntax/import_alias_rewrite.vibe {\n  rewrite_import_alias_expr\n}\n\n//# Module flattening\n\nlet empty_stmts: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExport([])\n  ], 0, 0)\n}\n\nlet empty_strs: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\n// Prefix a binding name with the enclosing module path (`math` + `helper` =>\n// `math::helper`). Empty prefix leaves the name unchanged.\nlet join_module_name: (String, String) -> String = (prefix, name) -> {\n  if prefix == \"\" {\n    name\n  } else {\n    String::concat(prefix, String::concat(\"::\", name))\n  }\n}\n\n// Alias map (short name -> `prefix::name`) for the value members of a module\n// body, so intra-module references can be qualified to match the renamed decls.\nlet rec module_value_aliases: (Array[Stmt], String, Array[(String, String)]) -> Int = (body, prefix, out) -> {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(_, _, name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SLetMut(name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SExternLet(name, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  0\n}\n\n// Flatten a (DCE'd) module body to top-level decls: rename each value binding to\n// `prefix::name` AND qualify intra-module value references in its body, so the\n// flattened source typechecks without the enclosing module scope (a sibling call\n// `helper()` becomes `m::helper()`, matching the renamed `let m::helper`).\nlet rec flatten_module_body: (Array[Stmt], String, Array[(String, String)], Array[Stmt]) -> Int = (body, prefix, aliases, out) -> {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(exp, is_rec, name, ty, b) => {\n        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\n        0\n      },\n      SLetMut(name, ty, b) => {\n        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\n        0\n      },\n      SExternLet(name, ty) => {\n        Array::push(out, SExternLet(join_module_name(prefix, name), ty))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)\n        0\n      },\n      other => {\n        Array::push(out, other)\n        0\n      }\n    }\n    i = i + 1\n  }\n  0\n}\n\nlet is_module_stmt: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\n//# Exported roots for DCE\n\n// Roots for top-level DCE: exported value bindings, plus any already\n// module-qualified binding (a `m::f` name). Flattening renames a kept module\n// member to `m::f` while leaving its body referencing the short `f`, so a\n// second normalize pass must not drop those by name — keeping all `::` names\n// (module members are live by construction) makes normalize idempotent.\nlet exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let roots = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, _, name, _, _) => if exp || String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SLetMut(name, _, _) => if String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      // Aggregate `export { a, b }` also marks an exported API; without this a\n      // file whose only export is `export { run }` would DCE everything away.\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(roots, Array::get(names, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  roots\n}\n\n// Names that an aggregate `export { .. }` re-exports (the renderer drops the\n// `SExport` statement, so the underlying bindings must be promoted to keep the\n// public API).\nlet aggregate_export_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let names = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SExport(exported) => {\n        let mut j = 0\n        while j < Array::length(exported) {\n          Array::push(names, Array::get(exported, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  names\n}\n\nlet str_array_has: (Array[String], String) -> Bool = (arr, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet promote_aggregate_exports: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, agg) -> {\n  let result = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let promoted = match stmt {\n      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {\n        SLet(true, is_rec, name, ty, body)\n      } else {\n        stmt\n      },\n      _ => stmt\n    }\n    Array::push(result, promoted)\n    i = i + 1\n  }\n  result\n}\n\n//# Type-alias DCE: drop non-exported aliases whose name is never referenced.\n\nlet rec collect_type_names_into: (TypeExpr, Array[String]) -> Int = (ty, out) -> {\n  match ty {\n    TyName(n) => {\n      Array::push(out, n)\n      0\n    },\n    TyApp(n, args) => {\n      Array::push(out, n)\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_type_names_into(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyFn(params, ret, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let _ = collect_type_names_into(Array::get(params, i), out)\n        i = i + 1\n      }\n      let _ = collect_type_names_into(ret, out)\n      0\n    },\n    TyTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = collect_type_names_into(Array::get(items, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyUnit => 0\n  }\n}\n\nlet collect_opt_type_into: (Option[TypeExpr], Array[String]) -> Int = (ty_opt, out) -> {\n  match ty_opt {\n    Some(ty) => collect_type_names_into(ty, out),\n    None => 0\n  }\n}\n\n// Collect every type-name referenced by a statement.\nlet collect_stmt_type_refs_into: (Stmt, Array[String]) -> Int = (stmt, out) -> {\n  match stmt {\n    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),\n    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),\n    SExternLet(_, ty) => collect_type_names_into(ty, out),\n    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),\n    SStruct(_, _, fields, _, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fty) = Array::get(fields, i)\n        let _ = collect_type_names_into(fty, out)\n        i = i + 1\n      }\n      0\n    },\n    SEnum(_, _, _, ctors, _) => {\n      let mut i = 0\n      while i < Array::length(ctors) {\n        let (_, args) = Array::get(ctors, i)\n        let mut j = 0\n        while j < Array::length(args) {\n          let _ = collect_type_names_into(Array::get(args, j), out)\n          j = j + 1\n        }\n        i = i + 1\n      }\n      0\n    },\n    SImpl(_, _, _, type_name) => {\n      Array::push(out, type_name)\n      0\n    },\n    _ => 0\n  }\n}\n\n\nlet drop_unused_type_aliases: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let referenced = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let mut k = 0\n  while k < Array::length(stmts) {\n    let stmt = Array::get(stmts, k)\n    let keep = match stmt {\n      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),\n      _ => true\n    }\n    if keep {\n      Array::push(result, stmt)\n    }\n    k = k + 1\n  }\n  result\n}\n\n//# Categorize + render\n\n// 0 = import, 1 = type/structural, 2 = function/value, 3 = test/bench,\n// 9 = drop (aggregate export / bare expression).\nlet stmt_section: (Stmt) -> Int = (stmt) -> {\n  match stmt {\n    SImport(_, _) => 0,\n    SReExport(_, _) => 0,\n    SAliasDecl(_, _) => 0,\n    SEnum(_, _, _, _, _) => 1,\n    SSuberror(_, _, _) => 1,\n    SStruct(_, _, _, _, _) => 1,\n    STypeAlias(_, _, _, _) => 1,\n    STrait(_, _, _, _, _) => 1,\n    SImpl(_, _, _, _) => 1,\n    SEffectDef(_, _, _, _) => 1,\n    SExternLet(_, _) => 1,\n    SLet(_, _, _, _, _) => 2,\n    SLetMut(_, _, _) => 2,\n    SLetPat(_, _) => 2,\n    STest(_, _) => 3,\n    SBench(_, _) => 3,\n    SExport(_) => 9,\n    SExpr(_) => 9,\n    _ => 9\n  }\n}\n\nlet section_header: (Int) -> String = (section) -> {\n  if section == 0 {\n    \"//# Imports\"\n  } else if section == 1 {\n    \"//# Types\"\n  } else if section == 2 {\n    \"//# Functions\"\n  } else {\n    \"//# Tests\"\n  }\n}\n\n// Render all statements in one section (already filtered) joined by blank lines,\n// prefixed by the section header. Returns \"\" when the section is empty.\nlet render_section: (Array[Stmt], Int) -> String = (stmts, section) -> {\n  let parts = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if stmt_section(stmt) == section {\n      Array::push(parts, print_stmt(stmt))\n    }\n    i = i + 1\n  }\n  if Array::length(parts) == 0 {\n    \"\"\n  } else {\n    let body = String::join(parts, \"\\n\\n\")\n    String::concat(section_header(section), String::concat(\"\\n\\n\", body))\n  }\n}\n\n//# Lambda-annotation hoisting\n\nlet normalize_empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet all_params_typed: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(_) => 0,\n      None => {\n        ok = false\n        0\n      }\n    }\n    i = i + 1\n  }\n  ok\n}\n\nlet param_type_list: (Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] = (params) -> {\n  let out = normalize_empty_type_exprs()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(ty) => Array::push(out, ty),\n      None => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet strip_param_types: (Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (params) -> {\n  let out = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(params) {\n    let (name, _) = Array::get(params, i)\n    Array::push(out, (name, None))\n    i = i + 1\n  }\n  out\n}\n\n// Canonicalize an old-syntax lambda binding `let f = (x: T) -> R { body }` to\n// the annotated form `let f: (T) -> R = (x) -> { body }`: move the parameter\n// types + return type into a `TyFn` let-annotation and strip them from the\n// lambda. Only when the let has no annotation yet, the value is a return-type\n// annotated lambda, and every parameter carries a type (full type recoverable).\nlet hoist_lambda_let: (Stmt) -> Stmt = (stmt) -> {\n  match stmt {\n    SLet(exp, is_rec, name, ty, value) => match ty {\n      Some(_) => stmt,\n      None => match value {\n        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {\n          None => stmt,\n          // Skip generic lambdas: their `[T]` type params scope the lambda, not\n          // the let annotation, so hoisting `[T](x: T) -> T` to `: (T) -> T =\n          // [T](x) -> {...}` would leave `T` unbound in the annotation and the\n          // normalized output would not compile.\n          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {\n            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))\n          } else {\n            stmt\n          }\n        },\n        _ => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nlet hoist_lambda_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n//# Constant folding\n\n// Fold a binary op on two int literals. Only the closed arithmetic ops `+ - *`,\n// which are total and wrap identically at compile time and runtime (both use\n// 62-bit Int), so folding is semantics-preserving. `/` and `%` are skipped\n// (a literal `x / 0` must keep trapping at runtime, not at fold time).\nlet fold_int_binop: (String, Int, Int) -> Option[Int] = (op, a, b) -> {\n  if op == \"+\" {\n    Some(a + b)\n  } else if op == \"-\" {\n    Some(a - b)\n  } else if op == \"*\" {\n    Some(a * b)\n  } else {\n    None\n  }\n}\n\nlet rec fold_expr: (Expr) -> Expr = (expr) -> {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      fold_expr(it)\n    }),\n    EArray(items) => EArray(for it in items {\n      fold_expr(it)\n    }),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f\n      (n, fold_expr(v))\n    }),\n    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),\n    ELet(n, v, b) => ELet(n, fold_expr(v), fold_expr(b)),\n    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),\n    ELetMut(n, v, b) => ELetMut(n, fold_expr(v), fold_expr(b)),\n    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),\n    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),\n    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, fold_expr(init))\n    }, fold_expr(b)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),\n    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {\n      fold_expr(a)\n    }, off),\n    EBinOp(op, l, r) => {\n      let fl = fold_expr(l)\n      let fr = fold_expr(r)\n      match fl {\n        EInt(a) => match fr {\n          EInt(b) => match fold_int_binop(op, a, b) {\n            Some(v) => EInt(v),\n            None => EBinOp(op, fl, fr)\n          },\n          _ => EBinOp(op, fl, fr)\n        },\n        _ => EBinOp(op, fl, fr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),\n    EDot(e, field, off) => EDot(fold_expr(e), field, off),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),\n    EThrow(e) => EThrow(fold_expr(e)),\n    EReturn(e) => EReturn(fold_expr(e)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(fold_expr(v))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      fold_expr(a)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, fold_expr(v))\n    }),\n    ESpread(e) => ESpread(fold_expr(e))\n  }\n}\n\n// #703 follow-up: lift a temporary (non-variable) match scrutinee into a `let`\n// so the Perceus RC pass — which attributes drops to NAMED bindings — gives it\n// a scope-end drop. `match <e> { arms }` -> `let __m_scrut_N = <e> in match\n// __m_scrut_N { arms }` when `<e>` is not already an identifier. Without a\n// binding the fresh owned heap value the scrutinee produces (`match foo() {\n// .. }`, `match Some(x) { .. }`) is never dropped and leaks under RC.\n//\n// #708: the lift name MUST be unique per lift site (the `_N` suffix, from a\n// counter cell threaded through every recursive call). A single non-unique\n// name shared by every lift in a function is not just an RC-drop-scheduling\n// hazard (the original #708 fix) — when two lifts NEST (a match whose\n// scrutinee is itself a non-identifier match, e.g. `let (a,b) = match\n// <call> { .. }`, which the parser also desugars through a match-over-a-\n// match), the OUTER lift's own body-compile resolves the identifier by\n// searching local slots most-recent-first. Since the INNER lift (compiled\n// while evaluating the outer lift's OWN value) pushes the identical name\n// *after* the outer one, that search finds the inner (already out-of-scope)\n// binding instead of the outer one it meant to reference — reading whatever\n// unrelated heap object the inner scrutinee held (e.g. a `Token`) as if it\n// were the outer's freshly-built tuple, and misinterpreting its raw memory\n// as tuple fields. This produced garbage values (not a crash) for a `let\n// (a,b,c,d) = match <call> {..}` pattern local's fields — confirmed via a\n// minimal repro and fixed by this uniqueness change (see #708 follow-up\n// investigation notes). Modeled on fold_expr's complete walk; only the\n// EMatch case differs. EHandle is left as-is (effect handlers are not the\n// same ownership shape). Pure rewrite (aside from the counter cell) —\n// applied to each function body before build_perceus_plan so the plan and\n// codegen agree; running it on the non-RC backend would be harmless but it is\n// gated at the call site to keep that backend byte-identical.\n// #712: RC codegen's per-function bookkeeping (CompileCtx's `heap_binding_names`,\n// `rc_drop_names`, `rc_alias_dup_names`, `rc_dup_names`, `loop_borrowed_names`,\n// etc., and the Perceus plan itself) all key on the bare identifier NAME, not\n// binding identity. When an inner scope shadows an outer binding of the same\n// name (`let x = ...; { let x = ...; f(x) }`, or a `while` loop body rebinding\n// a name the loop already loop-borrows), those name-keyed lookups cannot tell\n// the two `x`s apart -- an action meant for one binding can fire at the other's\n// site instead (spurious/missing rc_dup, premature/missing rc_drop).\n//\n// Rather than retrofit every name-keyed consumer with binding identity (a\n// larger, more invasive change -- see #712), this eliminates the ambiguity at\n// the source: alpha-rename every binding that shadows an enclosing one to a\n// fresh, globally-unique name before the Perceus plan is built, so no two live\n// bindings in one function ever share a name. Modeled on lift_match_scrutinees\n// (#708) -- same shared-counter-cell technique for uniqueness, same complete\n// per-Expr-variant walk. Unshadowed bindings (the vast majority) are left with\n// their original name (so debugging/argument-inspection output is unaffected\n// outside the rare shadowing case). Pure rewrite; gated at the call site to\n// keep the non-RC backend byte-identical.\nlet fresh_shadow_name: (Array[Int], String) -> String = (counter, name) -> {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(String::concat(\"__shadow_\", __to_string(n)), String::concat(\"_\", name))\n}\n\n// Renamed reference for `name` under `env`, or `name` unchanged if it is not a\n// tracked (shadowed-or-not) binding -- i.e. a free variable / global / builtin.\nlet uq_lookup: (Map[String, String], String) -> String = (env, name) -> {\n  if Map::has_key(env, name) {\n    Map::get(env, name)\n  } else {\n    name\n  }\n}\n\n// #715: has `name` been bound ANYWHERE in this function already (including a\n// sibling scope that has since closed)? `seen` is a shared mutable array, one\n// per top-level function, appended by uq_bind_name's first-binder path.\nlet uq_seen_contains: (Array[String], String) -> Bool = (seen, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(seen) {\n    if Array::get(seen, i) == name {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Introduce binding `name` into `env`. If `name` is already tracked (bound by\n// an enclosing scope, shadowed or not), this occurrence shadows it: mint a\n// fresh unique name and map `name` to it for the extent of the inner scope.\n//\n// #715: ALSO rename when `name` was bound anywhere EARLIER in this same\n// function, even in an already-closed sibling scope (two match arms both\n// declaring `let resolved = ...`). The Perceus plan's actions and codegen's\n// bookkeeping (rc_drop_names / rc_dup_names / heap_binding_names) are flat,\n// name-keyed, whole-function lists, so two same-named sibling bindings\n// receive each other's planned dups/drops -- confirmed as the #715 checker\n// crash: check_expr declares `let resolved` in four sibling scopes; a\n// scope-end PaDrop planned for one fired at another whose reference had\n// already been consumed through resolve_tparams_in, freeing the block a\n// still-live tuple pointed at (use-after-free at the `pt` destructure dup).\n//\n// Otherwise this is the first binder for `name` in this function; keep it\n// as-is but still record the identity mapping, so a DEEPER shadow of the same\n// name is detected against this occurrence.\nlet uq_bind_name: (String, Map[String, String], Array[Int], Array[String]) -> (String, Map[String, String]) = (name, env, counter, seen) -> {\n  // A labeled/optional param (`a~`/`a?`) is declared with its suffix but its\n  // body references use the STRIPPED name, so this env (keyed by the declared\n  // name) never rewrites those references anyway -- renaming the declaration\n  // alone would orphan them. Leave such params untouched (status quo).\n  let nlen = String::length(name)\n  let lastc = if nlen > 0 {\n    String::char_code_at(name, nlen - 1)\n  } else {\n    0\n  }\n  if lastc == '~' || lastc == '?' {\n    (name, env)\n  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {\n    let fresh = fresh_shadow_name(counter, name)\n    (fresh, Map::set(env, name, fresh))\n  } else {\n    Array::push(seen, name)\n    (name, Map::set(env, name, name))\n  }\n}\n\nlet rec uq_pat_names: (Pat, Array[String]) -> Unit = (pat, out) -> {\n  match pat {\n    PBind(name) => Array::push(out, name),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        uq_pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        uq_pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    POr(l, _r) => uq_pat_names(l, out),\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        uq_pat_names(fp, out)\n        i = i + 1\n      }\n    },\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PWild => ()\n  }\n}\n\nlet rec uq_pat_rewrite: (Pat, Map[String, String]) -> Pat = (pat, env) -> {\n  match pat {\n    PBind(name) => PBind(uq_lookup(env, name)),\n    PCtor(name, args) => PCtor(name, for a in args {\n      uq_pat_rewrite(a, env)\n    }),\n    PTuple(pats) => PTuple(for a in pats {\n      uq_pat_rewrite(a, env)\n    }),\n    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),\n    PStruct(name, fields) => PStruct(name, for f in fields {\n      let (fname, fp) = f\n      (fname, uq_pat_rewrite(fp, env))\n    }),\n    _ => pat\n  }\n}\n\n// Binds every name in `pat` (shadow-checked against `env`) and returns the\n// rewritten pattern together with the extended env for the pattern's own\n// scope (the arm body).\nlet uq_bind_pat: (Pat, Map[String, String], Array[Int], Array[String]) -> (Pat, Map[String, String]) = (pat, env, counter, seen) -> {\n  let names: Array[String] = [\n  ]\n  uq_pat_names(pat, names)\n  let mut env2 = env\n  let mut i = 0\n  while i < Array::length(names) {\n    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)\n    env2 = env3\n    i = i + 1\n  }\n  (uq_pat_rewrite(pat, env2), env2)\n}\n\nexport let rec uniquify_shadowed_bindings: (Expr, Map[String, String], Array[Int], Array[String]) -> Expr = (expr, env, counter, seen) -> {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(name, off) => EIdent(uq_lookup(env, name), off),\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    EArray(items) => EArray(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f\n      (n, uniquify_shadowed_bindings(v, env, counter, seen))\n    }),\n    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),\n    ELet(n, v, b) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    ELetRec(n, v, b) => {\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)\n      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    ELetMut(n, v, b) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ELoop(params, b) => {\n      let mut env2 = env\n      let zipped: Array[(String, Expr)] = [\n      ]\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, init) = Array::get(params, pi)\n        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(zipped, (pn2, init2))\n        pi = pi + 1\n      }\n      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    EForIn(n, idx, it, b) => {\n      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let (idx2, env3) = match idx {\n        Some(iname) => {\n          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)\n          (Some(iname2), envI)\n        },\n        None => (None, env2)\n      }\n      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))\n    },\n    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),\n    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),\n    EFn(tp, bounds, params, ret, eff, body) => {\n      let mut env2 = env\n      let params2: Array[(String, Option[TypeExpr])] = [\n      ]\n      let mut fi = 0\n      while fi < Array::length(params) {\n        let (pn, pty) = Array::get(params, fi)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(params2, (pn2, pty))\n        fi = fi + 1\n      }\n      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))\n    },\n    EDot(e, field, off) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),\n    EThrow(e) => EThrow(uniquify_shadowed_bindings(e, env, counter, seen)),\n    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, uniquify_shadowed_bindings(v, env, counter, seen))\n    }),\n    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))\n  }\n}\n\nlet fresh_m_scrut_name: (Array[Int]) -> String = (counter) -> {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(\"__m_scrut_\", __to_string(n))\n}\n\nexport let rec lift_match_scrutinees: (Expr, Array[Int]) -> Expr = (expr, counter) -> {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    EArray(items) => EArray(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f\n      (n, lift_match_scrutinees(v, counter))\n    }),\n    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),\n    ELet(n, v, b) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ELetMut(n, v, b) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),\n    EMatch(s, arms) => {\n      let lifted_arms = for a in arms {\n        let (p, e) = a\n        (p, lift_match_scrutinees(e, counter))\n      }\n      let ls = lift_match_scrutinees(s, counter)\n      match ls {\n        EIdent(_, _) => EMatch(ls, lifted_arms),\n        _ => {\n          let fresh = fresh_m_scrut_name(counter)\n          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms))\n        }\n      }\n    },\n    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {\n      let (p, e) = a\n      (p, lift_match_scrutinees(e, counter))\n    }),\n    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, lift_match_scrutinees(init, counter))\n    }, lift_match_scrutinees(b, counter)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),\n    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {\n      lift_match_scrutinees(a, counter)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),\n    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),\n    EDot(e, field, off) => EDot(lift_match_scrutinees(e, counter), field, off),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),\n    EThrow(e) => EThrow(lift_match_scrutinees(e, counter)),\n    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      lift_match_scrutinees(a, counter)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, lift_match_scrutinees(v, counter))\n    }),\n    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))\n  }\n}\n\nlet fold_stmt: (Stmt) -> Stmt = (stmt) -> {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),\n    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),\n    STest(n, body) => STest(n, fold_expr(body)),\n    SBench(n, body) => SBench(n, fold_expr(body)),\n    SExpr(e) => SExpr(fold_expr(e)),\n    SLetPat(p, body) => SLetPat(p, fold_expr(body)),\n    _ => stmt\n  }\n}\n\nlet fold_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, fold_stmt(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n//# Literal type annotation\n\n// The type of a value binding whose initializer is a literal of an obvious\n// type. Only these self-evident cases are annotated; anything needing real\n// inference (a call result, an identifier, arithmetic over non-literals) is\n// left unannotated so normalize never asserts a type it cannot prove.\nlet literal_type: (Expr) -> Option[TypeExpr] = (e) -> {\n  match e {\n    EInt(_) => Some(TyName(\"Int\")),\n    EBool(_) => Some(TyName(\"Bool\")),\n    EString(_) => Some(TyName(\"String\")),\n    EFloat(_) => Some(TyName(\"Double\")),\n    _ => None\n  }\n}\n\n// Add `: T` to an un-annotated `let x = <literal>` (runs after folding, so e.g.\n// `let answer = 40 + 2` -> `let answer = 42` -> `let answer: Int = 42`). Lambda\n// values are handled by hoisting, not here (a literal is never an `EFn`).\nlet annotate_literal_let: (Stmt) -> Stmt = (stmt) -> {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => match ty {\n      Some(_) => stmt,\n      None => match literal_type(body) {\n        Some(t) => SLet(exp, is_rec, name, Some(t), body),\n        None => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nlet annotate_literal_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, annotate_literal_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n// DCE is name-based, so it must run while module members still carry their\n// short names (a body says `helper()`, not `math::helper()`). We therefore DCE\n// each scope before flattening renames its bindings:\n//   - top-level non-module decls are DCE'd against the exported top-level roots;\n//   - each module body is DCE'd against its own exported members, then renamed.\nexport let normalize_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let nonmods = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if !is_module_stmt(stmt) {\n      Array::push(nonmods, stmt)\n    }\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))\n  Array::push_all(result, live_top)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SModule(_, name, body) => {\n        let live_body = dce_stmts(body, exported_value_names(body))\n        let aliases = Array::slice([\n          (\"\", \"\")\n        ], 0, 0)\n        let _ = module_value_aliases(live_body, name, aliases)\n        let _ = flatten_module_body(live_body, name, aliases, result)\n        0\n      },\n      _ => 0\n    }\n    m = m + 1\n  }\n  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))\n  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))\n}\n\nexport let normalize_source: (String) -> String with { Error } = (src) -> {\n  // #730 (D-3): require pin lines are a leading directive, not statement\n  // grammar — extract them, normalize the remainder, and re-emit them in\n  // canonical single-space form above the output. Pin FILLING is the\n  // Fs-mode wrapper's job (VIBE_FILL_PINS); this pure engine re-emits\n  // pinned and unpinned lines as they are.\n  let (req_pins, src_wo_requires) = extract_require_pins(src)\n  // #cfg guard: parse_program DROPS inactive #cfg statements, so formatting\n  // a #cfg-bearing source would silently delete the disabled code from the\n  // re-printed output. Refuse instead.\n  let toks_cfg = lex(src_wo_requires)\n  let mut ci = 0\n  while ci < Array::length(toks_cfg) {\n    match Array::get(toks_cfg, ci) {\n      THash => throw(\"cannot normalize a source containing #cfg directives\"),\n      // #727 guard: `fn` desugars to SLet + EFn at parse time, so re-printing\n      // would rewrite fn statements into let-form (and drop `where` clauses,\n      // which the Phase A parser skips). Refuse until printer support lands\n      // with the fmt migration (ADR-0064 Phase E/G).\n      TIdent(tn) => if tn == \"fn\" {\n        throw(\"cannot normalize a source containing fn statements yet (#727)\")\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    ci = ci + 1\n  }\n  let stmts = parse_program(toks_cfg)\n  let kept = normalize_stmts(stmts)\n  let sections = empty_strs()\n  if Array::length(req_pins) > 0 {\n    let req_lines = empty_strs()\n    let mut ri = 0\n    while ri < Array::length(req_pins) {\n      let (rname, rver, rpin) = Array::get(req_pins, ri)\n      if rpin == \"\" {\n        Array::push(req_lines, \"require \\{rname} \\{rver}\")\n      } else {\n        Array::push(req_lines, \"require \\{rname} \\{rver} = #\\{rpin}\")\n      }\n      ri = ri + 1\n    }\n    Array::push(sections, String::join(req_lines, \"\\n\"))\n  } else ()\n  let mut s = 0\n  while s <= 3 {\n    let rendered = render_section(kept, s)\n    if rendered != \"\" {\n      Array::push(sections, rendered)\n    }\n    s = s + 1\n  }\n  String::concat(String::join(sections, \"\\n\\n\"), \"\\n\")\n}\n")
}

let cli_adapter_source_144 = () -> (String, String) {
  ("vibe/compiler/desugar_trait_dict.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\n// Dictionary-passing desugaring for method-bearing traits (#641 PR-3\n// components 3+4). Runs pre-check, after string-interpolation expansion. It is\n// INERT unless the program declares a trait with method signatures, so all\n// existing code (and the compiler's own selfbuild) is untouched.\n//\n// For a method-bearing `trait Tr { m(Self) -> R; ... }` it:\n//   1. synthesizes a witness struct `TrDict { m: (Self) -> R; ... }`,\n//   2. for each top-level generic `f = [T: Tr](.. x: T ..) -> Ret { body }`\n//      that is bounded by `Tr`, prepends a hidden dict parameter\n//      `__dict_Tr_T: TrDict[T]` and rewrites `T::m(args)` in the body to\n//      `(__dict_Tr_T.m)(args)`,\n//   3. at every call site `f(.. recv ..)` synthesizes the witness\n//      `TrDict::{ m: C::m, ... }` from the concrete receiver type C (the impl's\n//      `C::m` free functions from PR-1) and threads it in.\n//\n// First slice (see docs/method-bearing-traits-plan.md): single type parameter\n// per bound that appears directly as a parameter type (`x: T`), concrete call\n// sites whose receiver type is syntactically determinable (primitive literals\n// and struct literals). Anything outside this leaves the call unrewritten, so a\n// missing dictionary surfaces as a loud arity error rather than a miscompile.\n\nlet empty_expr_array: () -> Array[Expr] = () -> {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet empty_str_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\n// Method names declared by a trait, in declaration order.\nlet method_names_of_sigs: (Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] = (methods) -> {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(methods) {\n    let (mname, _, _) = Array::get(methods, i)\n    Array::push(out, mname)\n    i = i + 1\n  }\n  out\n}\n\nlet str_array_contains: (Array[String], String) -> Bool = (arr, val) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == val {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Split a qualified `Head::member` into Some((head, member)) on the FIRST `::`.\nlet split_qualified: (String) -> Option[(String, String)] = (name) -> {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    Some((head, member))\n  }\n}\n\n// The dict struct name for a trait, e.g. `Measurable` -> `MeasurableDict`.\nlet dict_struct_name: (String) -> String = (trait_name) -> {\n  String::concat(trait_name, \"Dict\")\n}\n\n// The hidden dict parameter name for `[T: Tr]`, e.g. `__dict_Measurable_T`.\nlet dict_param_name: (String, String) -> String = (trait_name, tparam) -> {\n  String::concat(\"__dict_\", String::concat(trait_name, String::concat(\"_\", tparam)))\n}\n\n// Collect method-bearing traits (name -> signatures). Marker-only traits\n// (no method signatures) are skipped, which is what keeps this pass inert on\n// existing code.\nlet collect_method_traits: (Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", Array::slice([\n      (\"\", empty_type_exprs(), TyUnit)\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, methods, _) => if Array::length(methods) > 0 {\n        Array::push(out, (tname, methods))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// ---- rank-1 method generics (#684) ----\n//\n// A trait method may declare its own type parameters, `m: [X: Show](Self, X) ->\n// R`. The binder lives on the TRAIT method only (STrait's 5th field); the impl\n// `impl Tr for C { m = (self, x) -> {..} }` does NOT repeat it and parses to a\n// top-level `SLet(_, _, \"C::m\", _, EFn([], [], [(self,None),(x,None)], ..))`.\n// `inject_method_generics` re-attaches the trait method's `[X: Show]` binder to\n// the impl's free function and annotates the unannotated params with the trait\n// method's declared param types. After injection `build_gens` sees `x: X`,\n// registers `C::m` as a Show-bounded generic, and the existing dict-passing\n// machinery threads/synthesizes the `Show` witness at qualified call sites.\n\nlet empty_method_gens: () -> Array[(String, Array[String], Array[(String, Array[String])])] = () -> {\n  Array::slice([\n    (\"\", empty_str_array(), Array::slice([\n      (\"\", empty_str_array())\n    ], 0, 0))\n  ], 0, 0)\n}\n\n// Collect every trait's per-method generic binders (name -> [(method,\n// type_params, bounds)]) from STrait's 5th field. Only traits that declare a\n// non-empty binder on at least one method are kept, so this stays inert.\nlet collect_trait_method_gens: (Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", empty_method_gens())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, _, method_gens) => {\n        let mut any = false\n        let mut j = 0\n        while j < Array::length(method_gens) {\n          let (_, tps, _) = Array::get(method_gens, j)\n          if Array::length(tps) > 0 {\n            any = true\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n        if any {\n          Array::push(out, (tname, method_gens))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Look up a method's `(type_params, bounds)` in a trait's method-gen table.\n// Returns None when the method has no binder (empty type_params).\nlet lookup_method_gen: (Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], String, String) -> Option[(Array[String], Array[(String, Array[String])])] = (table, trait_name, method) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(table) {\n    let (tn, gens) = Array::get(table, i)\n    if tn == trait_name {\n      let mut j = 0\n      while j < Array::length(gens) {\n        let (mname, tps, bounds) = Array::get(gens, j)\n        if mname == method && Array::length(tps) > 0 {\n          result = Some((tps, bounds))\n          j = Array::length(gens)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(table)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Map each impl's target type to the trait it implements\n// (`impl Tr for C` -> (C, Tr)). A type may implement several traits; the first\n// matching trait that declares the method is used at lookup time.\nlet collect_impl_trait_map: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// The declared parameter types of method `m` in trait `trait_name` (its 3-tuple\n// signature). Used to annotate the impl method's unannotated params so the\n// per-method type parameter `X` appears as `x: X`.\nlet lookup_trait_method_param_types: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[Array[TypeExpr]] = (traits, trait_name, method) -> {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(sigs) {\n        let (mname, ptypes, _) = Array::get(sigs, j)\n        if mname == method {\n          result = Some(ptypes)\n          j = Array::length(sigs)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    None => None\n  }\n}\n\n// Find the trait, among those `type_name` implements, that declares a\n// method-level binder for `method`. Returns its (type_params, bounds, param\n// types) so the impl method can be re-typed.\nlet find_method_generic_for_impl: (Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] = (impl_map, gen_table, traits, type_name, method) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(impl_map) {\n    let (tn, trait_name) = Array::get(impl_map, i)\n    if tn == type_name {\n      match lookup_method_gen(gen_table, trait_name, method) {\n        Some(g) => {\n          let (tps, bounds) = g\n          match lookup_trait_method_param_types(traits, trait_name, method) {\n            Some(ptypes) => {\n              result = Some((tps, bounds, ptypes))\n              i = Array::length(impl_map)\n            },\n            None => {\n              i = i + 1\n            }\n          }\n        },\n        None => {\n          i = i + 1\n        }\n      }\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Annotate each parameter whose annotation is None with the trait method's\n// declared param type (when one exists at that index). Already-annotated params\n// keep their annotation.\nlet annotate_params_from_sig: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, ptypes) -> {\n  let out = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    let new_ann = match ann {\n      Some(_) => ann,\n      None => if i < Array::length(ptypes) {\n        Some(Array::get(ptypes, i))\n      } else {\n        None\n      }\n    }\n    Array::push(out, (pname, new_ann))\n    i = i + 1\n  }\n  out\n}\n\n// In-place: for each impl method `C::m` whose trait declares a method-level\n// `[X: Bound]` binder, re-attach the binder to the EFn and annotate its params\n// with the trait method's declared types. Idempotent: an EFn that already\n// carries type_params was injected on a prior run and is skipped.\nlet inject_method_generics: (Array[Stmt], Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, impl_map, gen_table, traits) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, isrec, qname, ann, body) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {\n          match split_qualified(qname) {\n            Some(parts) => {\n              let (cname, method) = parts\n              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {\n                Some(g) => {\n                  let (mtparams, mtbounds, ptypes) = g\n                  let new_params = annotate_params_from_sig(params, ptypes)\n                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)\n                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))\n                },\n                None => ()\n              }\n            },\n            None => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// Re-attach trait-method `[X: Bound]` binders to impl free functions, given a\n// (possibly flattened) method-trait table for param-type lookup. Inert and\n// idempotent. Shared by `desugar_trait_dicts` (pre-codegen) and `check_program`\n// (so the FS-compile path, which type-checks before the desugar runs, also sees\n// the binder and can resolve `X::method`).\nlet inject_trait_method_generics_with: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, traits) -> {\n  let method_gen_table = collect_trait_method_gens(stmts)\n  if Array::length(method_gen_table) > 0 {\n    let impl_map = collect_impl_trait_map(stmts)\n    inject_method_generics(stmts, impl_map, method_gen_table, traits)\n  } else {\n    ()\n  }\n}\n\n// Self-contained entry for callers that have not flattened the trait table\n// (the checker). Builds its own (flattened) method-trait table from `stmts`.\nexport let inject_trait_method_generics: (Array[Stmt]) -> Unit = (stmts) -> {\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  inject_trait_method_generics_with(stmts, traits)\n}\n\n// Collect each trait's declared supertraits (`trait B: A + ...`), for all\n// traits (method-bearing or not), so a method-bearing trait can inherit its\n// supertraits' methods.\nlet collect_trait_supers: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", empty_str_array())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, supers, _, _) => Array::push(out, (tname, supers)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_supers: (Array[(String, Array[String])], String) -> Array[String] = (supers_map, name) -> {\n  let mut i = 0\n  let mut result = empty_str_array()\n  while i < Array::length(supers_map) {\n    let (tname, supers) = Array::get(supers_map, i)\n    if tname == name {\n      result = supers\n      i = Array::length(supers_map)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Flatten a trait's method signatures with those of its (transitive) method-\n// bearing supertraits, deduplicating by method name, so `[T: B]` for\n// `trait B: A` can dispatch both B's and A's methods through one flat witness\n// dictionary. `acc_names` / `out` accumulate across the recursion.\n//\n// Supertrait methods are emitted BEFORE the trait's own, so an inherited method\n// keeps the same field index in every dict that contains it (e.g. `measure`\n// is index 0 in both `MeasurableDict` and `SizedDict`). This matters because\n// codegen resolves `dict.field` by a global first-match field-name search\n// (compile_expr_tail4.vibe), not by the object's static type — so a shared\n// field name must sit at a consistent index across structs. (Single supertrait\n// chains only; multiple-supertrait ordering is a deferred slice.)\nlet rec flatten_trait_sigs_into: (String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[String], Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit = (tname, traits_raw, supers_map, acc_names, out) -> {\n  let supers = lookup_supers(supers_map, tname)\n  let mut s = 0\n  while s < Array::length(supers) {\n    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)\n    s = s + 1\n  }\n  match lookup_trait_sigs(traits_raw, tname) {\n    Some(sigs) => {\n      let mut i = 0\n      while i < Array::length(sigs) {\n        let (mname, params, ret) = Array::get(sigs, i)\n        if str_array_contains(acc_names, mname) {\n          ()\n        } else {\n          Array::push(acc_names, mname)\n          Array::push(out, (mname, params, ret))\n        }\n        i = i + 1\n      }\n    },\n    None => ()\n  }\n}\n\n// Produce a method-trait table whose signatures are flattened across\n// supertraits, so all downstream code (dict struct, dispatch names, witness\n// materialization) sees one flat method set per trait.\nlet flatten_traits: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (traits_raw, supers_map) -> {\n  let out = Array::slice([\n    (\"\", Array::slice([\n      (\"\", empty_type_exprs(), TyUnit)\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(traits_raw) {\n    let (tname, _) = Array::get(traits_raw, i)\n    let acc_names = empty_str_array()\n    let flat = Array::slice([\n      (\"\", empty_type_exprs(), TyUnit)\n    ], 0, 0)\n    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)\n    Array::push(out, (tname, flat))\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_trait_sigs: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] = (traits, name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(traits) {\n    let (tname, sigs) = Array::get(traits, i)\n    if tname == name {\n      result = Some(sigs)\n      i = Array::length(traits)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Collect user struct field-name sets, for inferring a struct-literal's type\n// (the parser discards the `Name::` prefix of `Name::{ ... }`).\nlet collect_struct_field_sets: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", empty_str_array())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _) => {\n        let names = empty_str_array()\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, _) = Array::get(fields, j)\n          Array::push(names, fname)\n          j = j + 1\n        }\n        Array::push(out, (sname, names))\n      },\n      // #672: also record enum names (with an EMPTY field set, so the ERecord\n      // field-set match never confuses an enum with a struct literal) so the\n      // `==` dispatch's `struct_set_has` gate accepts enum operands too.\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Build the witness struct `TrDict { m: (Self) -> R; ... }` for a trait. The\n// `Self` placeholder in the signatures stays verbatim — struct type params are\n// erased, so the field-access typing is structural (proven in spike G-3).\nlet make_dict_struct_stmt: (String, Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt = (trait_name, sigs) -> {\n  let fields = Array::slice([\n    (\"\", TyUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(sigs) {\n    let (mname, params, ret) = Array::get(sigs, i)\n    Array::push(fields, (mname, TyFn(params, ret, None)))\n    i = i + 1\n  }\n  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array())\n}\n\n// Two field-name sets describe the same struct shape when they have equal\n// length and every name in one appears in the other.\nlet field_sets_match: (Array[String], Array[String]) -> Bool = (a, b) -> {\n  if Array::length(a) != Array::length(b) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(a) {\n      if str_array_contains(b, Array::get(a, i)) {\n        i = i + 1\n      } else {\n        ok = false\n        i = Array::length(a)\n      }\n    }\n    ok\n  }\n}\n\n// Is `name` a known struct (a key in struct_sets)? Gates the #672 `==` dispatch.\nlet struct_set_has: (Array[(String, Array[String])], String) -> Bool = (struct_sets, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, _) = Array::get(struct_sets, i)\n    if sname == name {\n      found = true\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Whether type `name` declares a field/variant called `member` (struct_sets\n// maps struct AND enum names to their field/variant name lists). Used to keep\n// a field-stored-function call `b.f(args)` as an EDot when the struct also\n// has a same-named `T::f` method candidate.\nlet struct_set_member: (Array[(String, Array[String])], String, String) -> Bool = (struct_sets, name, member) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, members) = Array::get(struct_sets, i)\n    if sname == name {\n      let mut j = 0\n      while j < Array::length(members) {\n        if Array::get(members, j) == member {\n          found = true\n          j = Array::length(members)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// [robj, arg1, arg2, ...] — receiver prepended to the rewritten args for a\n// method-call rewrite (`xs.m(a)` -> `T::m(xs, a)`).\nlet prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (head, rest) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  Array::push(out, head)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_var_type: (Array[(String, String)], String) -> Option[String] = (var_types, name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(var_types) {\n    let (vn, vt) = Array::get(var_types, i)\n    if vn == name {\n      result = Some(vt)\n      i = Array::length(var_types)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Best-effort syntactic inference of a call argument's concrete type, enough to\n// pick the trait impl at a concrete call site. Consults `var_types` (locals\n// bound to inferable values and parameters with concrete annotations). Returns\n// None when the type is not determinable (the call is then left unrewritten).\n// Resolve a (possibly qualified) constructor name to its enum/return type.\n// Bare `Green` -> `Color` via fn_returns; qualified `Color::Green` first tries\n// the whole name (no match) then the member `Green` confirming its enum equals\n// the head — so `let a = Color::Green` seeds `a -> Color` for `==` dispatch.\nlet ctor_enum_of_name: (Array[(String, String)], String) -> Option[String] = (fn_returns, name) -> {\n  match fn_return_type(fn_returns, name) {\n    Some(t) => Some(t),\n    None => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match fn_return_type(fn_returns, member) {\n          Some(en) => if en == head {\n            Some(en)\n          } else {\n            None\n          },\n          None => None\n        }\n      },\n      None => None\n    }\n  }\n}\n\nlet rec infer_arg_type_name: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Option[String] = (arg, struct_sets, var_types, fn_returns) -> {\n  match arg {\n    EInt(_) => Some(\"Int\"),\n    EBool(_) => Some(\"Bool\"),\n    EString(_) => Some(\"String\"),\n    EFloat(_) => Some(\"Double\"),\n    // String `+` chains: `\"a\" + b + \"c\"` infers String when EITHER side does\n    // (the checker enforces both sides are String when one is). This both\n    // types the concat rewrite below and lets a `let u = a + \"x\"` binding\n    // record u -> String for downstream `u + ...`. Other `+` operands stay\n    // None (no behavior change for numeric/unknown).\n    EBinOp(bop, bl, br) => if bop == \"+\" {\n      let lstr = match infer_arg_type_name(bl, struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"String\",\n        None => false\n      }\n      let rstr = match infer_arg_type_name(br, struct_sets, var_types, fn_returns) {\n        Some(t) => t == \"String\",\n        None => false\n      }\n      if lstr || rstr {\n        Some(\"String\")\n      } else {\n        None\n      }\n    } else {\n      None\n    },\n    // An array literal dispatches to an `impl [T] Trait for Array` witness\n    // (#5 generic impls): its constructor is \"Array\" regardless of element type.\n    EArray(_) => Some(\"Array\"),\n    // Same for a `map { ... }` literal: constructor \"Map\" (lets a let-bound\n    // map resolve an `impl ... for Map` witness at a generic call site).\n    EMap(_) => Some(\"Map\"),\n    // A variable's recorded type, else a (possibly qualified) nullary\n    // constructor's enum name (`Green`/`Color::Green` -> `Color`) so that a\n    // `let a = Green` / `let a = Color::Green` binding resolves for `==`. The\n    // builtin nullary `None` resolves to the structural shape \"Option\" so a\n    // `let a = None; ... a == b` dispatches structurally (#695).\n    EIdent(name, _) => if name == \"None\" {\n      Some(\"Option\")\n    } else {\n      match lookup_var_type(var_types, name) {\n        Some(t) => Some(t),\n        None => ctor_enum_of_name(fn_returns, name)\n      }\n    },\n    // A call-valued iterable (`for x in lazy_iter_arr([..])`) or data ctor\n    // (`Sh::Circle(5)`): its type is the head of the callee's return type. The\n    // builtin `Some`/`Ok`/`Err` constructors resolve to \"Option\"/\"Result\" so a\n    // bare `==` on them dispatches structurally (#695).\n    ECall(callee, _, _) => match callee {\n      EIdent(\"Some\", _) => Some(\"Option\"),\n      EIdent(\"Ok\", _) => Some(\"Result\"),\n      EIdent(\"Err\", _) => Some(\"Result\"),\n      // String-returning builtins (not in fn_returns): lets a\n      // `String::concat(a, b) + c` / `__to_string(n) + s` operand type as\n      // String for the concat rewrite.\n      EIdent(\"String::concat\", _) => Some(\"String\"),\n      EIdent(\"String::join\", _) => Some(\"String\"),\n      EIdent(\"String::substring\", _) => Some(\"String\"),\n      EIdent(\"String::trim\", _) => Some(\"String\"),\n      EIdent(\"String::replace\", _) => Some(\"String\"),\n      EIdent(\"String::from_char_code\", _) => Some(\"String\"),\n      EIdent(\"__to_string\", _) => Some(\"String\"),\n      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),\n      // `let x: T = e` is desugared to `((__asc: T) -> __asc)(e)` (ascribe_wrap);\n      // recover the operand's type head from the annotation so an annotated\n      // `let a: Option[Int] = None` records `a -> \"Option\"` for `==` dispatch.\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\n        let (_, ann) = Array::get(params, 0)\n        match ann {\n          Some(TyName(n)) => Some(n),\n          Some(TyApp(n, _)) => Some(n),\n          _ => None\n        }\n      } else {\n        None\n      },\n      _ => None\n    },\n    ERecord(fields) => {\n      let names = empty_str_array()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(struct_sets) {\n        let (sname, sfields) = Array::get(struct_sets, j)\n        if field_sets_match(names, sfields) {\n          result = Some(sname)\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    _ => None\n  }\n}\n\n// The hidden bounds threaded into a generic: (type-param, trait, receiver\n// parameter index). Empty registry sentinel for arrays of these.\nlet empty_threaded: () -> Array[(String, String, Int)] = () -> {\n  Array::slice([\n    (\"\", \"\", 0)\n  ], 0, 0)\n}\n\nlet empty_dict_binds: () -> Array[(String, String, String, Array[String])] = () -> {\n  Array::slice([\n    (\"\", \"\", \"\", empty_str_array())\n  ], 0, 0)\n}\n\n// A function already carries a threaded dict parameter (idempotency guard\n// against desugaring the same stmts twice while bounds are still present).\nlet already_threaded: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\n  if Array::length(params) == 0 {\n    false\n  } else {\n    let (pname, _) = Array::get(params, 0)\n    String::starts_with(pname, \"__dict_\")\n  }\n}\n\n// Index of the first parameter whose annotation is exactly the type parameter\n// `tp` (`x: T`). -1 when `T` does not appear directly as a parameter type.\nlet find_recv_index: (Array[(String, Option[TypeExpr])], String) -> Int = (params, tp) -> {\n  let mut i = 0\n  let mut idx = -1\n  while i < Array::length(params) {\n    let (_, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(n)) => if n == tp {\n        idx = i\n        i = Array::length(params)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  idx\n}\n\n// Build the registry of top-level generics that need dictionary threading:\n// each is a (function name, threaded-bounds) pair. A bound is threaded only\n// when its trait is method-bearing and the type parameter appears directly as\n// a parameter type.\n// The type-constructor head of a qualified name (`Array::show2` -> \"Array\"),\n// or \"\" if unqualified.\nlet qualified_head: (String) -> String = (name) -> {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (head, _) = parts\n      head\n    },\n    None => \"\"\n  }\n}\n\n// Type names of bounded generic impls (`impl [T: Bound] Trait for C`). Their\n// methods (`C::m`) carry the bound `T` even though it appears nested in the\n// receiver (`self: C[T]`), so they must be threaded a witness dict (the normal\n// \"type param is a direct parameter\" rule misses them).\nlet collect_generic_impl_types: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {\n        let mut has_bound = false\n        let mut bi = 0\n        while bi < Array::length(tbounds) {\n          let (_, bs) = Array::get(tbounds, bi)\n          let mut bj = 0\n          while bj < Array::length(bs) {\n            if Array::get(bs, bj) != \"\" {\n              has_bound = true\n            } else {\n              ()\n            }\n            bj = bj + 1\n          }\n          bi = bi + 1\n        }\n        if has_bound {\n          Array::push(out, type_name)\n        } else {\n          ()\n        }\n      } else (),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet build_gens: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[String]) -> Array[(String, Array[(String, String, Int)])] = (stmts, traits, gimpl_types) -> {\n  let out = Array::slice([\n    (\"\", empty_threaded())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {\n          ()\n        } else {\n          let threaded = empty_threaded()\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let (tp, trait_list) = Array::get(bounds, bi)\n            let mut ti = 0\n            while ti < Array::length(trait_list) {\n              let tr = Array::get(trait_list, ti)\n              match lookup_trait_sigs(traits, tr) {\n                Some(_) => {\n                  let ridx = find_recv_index(params, tp)\n                  if ridx >= 0 {\n                    Array::push(threaded, (tp, tr, ridx))\n                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {\n                    // bounded generic-impl method: T is nested in `self: C[T]`,\n                    // so there is no inferable receiver argument — the witness\n                    // dict is supplied when C's witness is built. Thread with -1.\n                    Array::push(threaded, (tp, tr, 0 - 1))\n                  } else {\n                    ()\n                  }\n                },\n                None => ()\n              }\n              ti = ti + 1\n            }\n            bi = bi + 1\n          }\n          if Array::length(threaded) > 0 {\n            Array::push(out, (fname, threaded))\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_gen: (Array[(String, Array[(String, String, Int)])], String) -> Option[Array[(String, String, Int)]] = (gens, name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(gens) {\n    let (gname, threaded) = Array::get(gens, i)\n    if gname == name {\n      result = Some(threaded)\n      i = Array::length(gens)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Find the dict parameter to dispatch a `head::member` call against, given the\n// dict bindings in scope: the binding whose type-param is `head` and whose\n// trait declares `member`.\nlet find_dict_for_method: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, head, member) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)\n    if tp == head && str_array_contains(methods, member) {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Find the in-scope dict parameter bound to type-param `tparam` for `trait_name`\n// (used to forward a caller's own witness into a generic->generic call).\nlet find_dict_for_trait: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, tparam, trait_name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)\n    if tp == tparam && tr == trait_name {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// The first element of an array-literal receiver (for a bounded generic impl\n// `impl [T: Bound] Trait for Array`, the element determines T's witness).\nlet first_array_elem: (Expr) -> Option[Expr] = (e) -> {\n  match e {\n    EArray(elems) => if Array::length(elems) > 0 {\n      Some(Array::get(elems, 0))\n    } else None,\n    _ => None\n  }\n}\n\n// Build the witness `ERecord` for a concrete type `cname` implementing\n// `trait_name`. Codegen resolves it to the dict struct structurally by field\n// names.\n//\n// For a plain impl each method field is the free function `C::method`. For a\n// BOUNDED generic impl (`impl [T: Bound] Trait for C`) the method\n// `C::method` was threaded to take its own `Bound` dictionary for the element\n// type, so the field is instead a closure that supplies that nested dictionary:\n//   { method: (__w) -> C::method(<element Bound dict>, __w) }\n// The element dict is built recursively from the array literal's first element\n// (`arg_expr`) — a dictionary-of-dictionaries (#5 Increment B). If the element\n// type / dict cannot be determined the whole witness fails to build (returns\n// None), so the call is left unrewritten (a loud arity error, never a silent\n// miscompile).\nlet rec build_concrete_dict: (String, String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[(String, String, Int)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String)], Expr) -> Option[Expr] = (cname, trait_name, traits, gens, struct_sets, var_types, fn_returns, arg_expr) -> {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mnames = method_names_of_sigs(sigs)\n      let recfields = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut mi = 0\n      let mut failed = false\n      while mi < Array::length(mnames) {\n        let m = Array::get(mnames, mi)\n        let qm = String::concat(cname, String::concat(\"::\", m))\n        if not(fn_exists(fn_returns, qm)) {\n          // No `cname::m` free function exists — `cname` does not actually\n          // implement `trait_name`. Refuse to fabricate a witness (which would\n          // otherwise silently dispatch to a same-shaped function), so the call\n          // is left unrewritten and fails loudly instead of miscompiling.\n          failed = true\n        } else {\n        match lookup_gen(gens, qm) {\n          Some(threaded) => {\n            // `qm` is a bounded generic-impl method: supply its element dict(s).\n            match first_array_elem(arg_expr) {\n              Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {\n                Some(en) => {\n                  let callargs = empty_expr_array()\n                  let mut bi = 0\n                  let mut subok = true\n                  while bi < Array::length(threaded) {\n                    let (_, btrait, _) = Array::get(threaded, bi)\n                    match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {\n                      Some(sd) => Array::push(callargs, sd),\n                      None => {\n                        subok = false\n                      }\n                    }\n                    bi = bi + 1\n                  }\n                  if subok {\n                    Array::push(callargs, EIdent(\"__w\", -1))\n                    let closure = EFn(empty_str_array(), Array::slice([\n                      (\"\", empty_str_array())\n                    ], 0, 0), Array::slice([\n                      (\"__w\", None)\n                    ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))\n                    Array::push(recfields, (m, closure))\n                  } else {\n                    failed = true\n                  }\n                },\n                None => {\n                  failed = true\n                }\n              },\n              None => {\n                failed = true\n              }\n            }\n          },\n          None => Array::push(recfields, (m, EIdent(qm, -1)))\n        }\n        }\n        mi = mi + 1\n      }\n      if failed {\n        None\n      } else {\n        Some(ERecord(recfields))\n      }\n    },\n    None => None\n  }\n}\n\n// Synthesize the witness dictionaries for a call to a transformed generic, or\n// None when any receiver's witness cannot be determined (the call is then left\n// unrewritten). Each bound is satisfied either by a concrete dict literal (the\n// receiver type is syntactically known) or by forwarding the caller's own dict\n// parameter (the receiver is a type parameter bound by the same trait in the\n// enclosing generic — the generic->generic case).\nlet synth_dicts: (Array[(String, String, Int)], Array[Expr], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] = (threaded, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) -> {\n  let dicts = empty_expr_array()\n  let mut ok = true\n  let mut bi = 0\n  while bi < Array::length(threaded) {\n    let (_, trait_name, recv_idx) = Array::get(threaded, bi)\n    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {\n      let recv_arg = Array::get(orig_args, recv_idx)\n      match infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns) {\n        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {\n          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),\n          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {\n            Some(dict) => Array::push(dicts, dict),\n            None => {\n              ok = false\n            }\n          }\n        },\n        None => {\n          ok = false\n        }\n      }\n    } else {\n      ok = false\n    }\n    bi = bi + 1\n  }\n  if ok {\n    Some(dicts)\n  } else {\n    None\n  }\n}\n\nlet concat_expr_arrays: (Array[Expr], Array[Expr]) -> Array[Expr] = (a, b) -> {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    Array::push(out, Array::get(b, j))\n    j = j + 1\n  }\n  out\n}\n\n// Seed a var-type environment from a function's parameters whose annotation is\n// a bare type name `T` — concrete (`Point`) for call-site dict synthesis, or a\n// type parameter (`T`) for generic->generic dict forwarding. The distinction is\n// made at use time against the in-scope dict bindings. `tparams` is retained for\n// signature compatibility but no longer filters (both kinds are tracked).\nlet seed_var_types: (Array[(String, Option[TypeExpr])], Array[String], Array[(String, String)]) -> Array[(String, String)] = (params, tparams, base) -> {\n  let _ = tparams\n  let out = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut b = 0\n  while b < Array::length(base) {\n    Array::push(out, Array::get(base, b))\n    b = b + 1\n  }\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\n      // A generic struct annotation `x: LazyIter[T]` -> track the head name so\n      // `for x in <param>` over a generic iterator type resolves (#636).\n      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Collect the return-type name of every top-level `let f = (..) -> R { .. }`\n// (R only when it is a bare type name), so the `for` desugar can tell an\n// iterator (`C::next` exists) from an iterable (`C::iter` returns an iterator).\nlet collect_fn_returns: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, _, ret, _, _) => {\n          // Record the head name of the return type: `TyName(n)` -> n,\n          // `TyApp(n, _)` -> n (so a generic `iter() -> LazyIter[T]` resolves to\n          // `LazyIter`, and an async `next() -> Future[Option[..]]` resolves to\n          // `Future` so the `for await` desugar can tell async from sync).\n          let rn = match ret {\n            Some(te) => match te {\n              TyName(n) => n,\n              TyApp(n, _) => n,\n              _ => \"\"\n            },\n            None => \"\"\n          }\n          Array::push(out, (fname, rn))\n        },\n        _ => ()\n      },\n      // #672: map each enum variant constructor to its enum name, so a\n      // `let t = Node(...)` binding resolves `t`'s type for the `==` dispatch\n      // (infer_arg_type_name reads ctor calls through fn_returns).\n      SEnum(_, ename, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(out, (vname, ename))\n          vi = vi + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet fn_exists: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fn_returns) {\n    let (n, _) = Array::get(fn_returns, i)\n    if n == fname {\n      found = true\n      i = Array::length(fn_returns)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet fn_return_type: (Array[(String, String)], String) -> Option[String] = (fn_returns, fname) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_returns) {\n    let (n, rt) = Array::get(fn_returns, i)\n    if n == fname {\n      result = if String::length(rt) == 0 {\n        None\n      } else Some(rt)\n      i = Array::length(fn_returns)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\n// Desugar `for x in it { body }` over a struct iterator type `C` into a loop\n// driven by the functional `C::next(self) -> Option[(T, Self)]`:\n//\n//   let mut __iter_cur = it\n//   let mut __iter_go = true\n//   while __iter_go {\n//     match C::next(__iter_cur) {\n//       Some((x, __iter_rest)) => { __iter_cur = __iter_rest; body },\n//       None => { __iter_go = false }\n//     }\n//   }\n//\n// Nested loops shadow the `__iter_*` names correctly (ELetMut scoping). The\n// optional index binding is not supported for iterators (first slice).\n//\n// `nextcall` is the expression yielding `Option[(T, Self)]` for the current\n// cursor `__iter_cur`: a bare `C::next(__iter_cur)` for a sync iterator, or\n// `await(C::next(__iter_cur))` (a `Future[Option[(T, Self)]]` unwrapped) for an\n// async iterator under `for await`.\nlet build_iter_for_with: (String, Expr, Expr, Expr) -> Expr = (name, nextcall, iter, body) -> {\n  let some_arm = (PCtor(\"Some\", [\n    PTuple([\n      PBind(name),\n      PBind(\"__iter_rest\")\n    ])\n  ]), EAssign(\"__iter_cur\", EIdent(\"__iter_rest\", -1), body))\n  let none_arm = (PCtor(\"None\", Array::slice([\n    PWild\n  ], 0, 0)), EAssign(\"__iter_go\", EBool(false), EUnit))\n  let loop_body = EMatch(nextcall, [\n    some_arm,\n    none_arm\n  ])\n  // Bind the iterand through an immutable `__iter_src` and initialize the\n  // mutable cursor from that ident, rather than from `iter` directly. The\n  // cursor is consumed by `C::next(__iter_cur)` and then reassigned each\n  // iteration; initializing it from a fresh heap value (e.g. a struct literal\n  // `for x in Range::{..}`) made that consume-then-reassign double-free the\n  // initial value under RC. Seeding from a stable binding mirrors the working\n  // `let r = ..; for x in r` shape so the ownership accounting balances (#704).\n  ELet(\"__iter_src\", iter, ELetMut(\"__iter_cur\", EIdent(\"__iter_src\", -1), ELetMut(\"__iter_go\", EBool(true), EWhile(EIdent(\"__iter_go\", -1), loop_body))))\n}\n\nlet next_call_for: (String) -> Expr = (ctype) -> {\n  ECall(EIdent(String::concat(ctype, \"::next\"), -1), [\n    EIdent(\"__iter_cur\", -1)\n  ], -1)\n}\n\nlet build_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\n  build_iter_for_with(name, next_call_for(ctype), iter, body)\n}\n\n// #736: `for x in xs` over a USER type implementing the indexed Iterable\n// protocol (`C::iter_length(Self) -> Int` + `C::iter_get(Self, Int) -> T`,\n// e.g. @vibe/core's List) desugars to an index-driven loop:\n//\n//   let __iter_src = xs\n//   let __iter_n = C::iter_length(__iter_src)\n//   let mut __iter_i = 0\n//   while __iter_i < __iter_n {\n//     let x = C::iter_get(__iter_src, __iter_i)\n//     body\n//     __iter_i = __iter_i + 1\n//   }\n//\n// The iterand is seeded through an immutable `__iter_src` for the same RC\n// ownership reason as build_iter_for_with (#704). Unlike the next-protocol\n// desugar, the optional index binding IS supported here (the loop counter is\n// the index): `for x, i in xs` binds `i` to the current `__iter_i`. The loop\n// is a statement (no per-iteration result collection).\nlet build_indexed_iter_for: (String, Option[String], String, Expr, Expr) -> Expr = (name, idx, ctype, iter, body) -> {\n  let get_call = ECall(EIdent(String::concat(ctype, \"::iter_get\"), -1), [\n    EIdent(\"__iter_src\", -1),\n    EIdent(\"__iter_i\", -1)\n  ], -1)\n  let len_call = ECall(EIdent(String::concat(ctype, \"::iter_length\"), -1), [\n    EIdent(\"__iter_src\", -1)\n  ], -1)\n  let incr = EAssign(\"__iter_i\", EBinOp(\"+\", EIdent(\"__iter_i\", -1), EInt(1)), EUnit)\n  let bound_body = match idx {\n    Some(iname) => ELet(iname, EIdent(\"__iter_i\", -1), body),\n    None => body\n  }\n  let loop_body = ELet(name, get_call, ESeq(bound_body, incr))\n  ELet(\"__iter_src\", iter, ELet(\"__iter_n\", len_call, ELetMut(\"__iter_i\", EInt(0), EWhile(EBinOp(\"<\", EIdent(\"__iter_i\", -1), EIdent(\"__iter_n\", -1)), loop_body))))\n}\n\n// `for await` over an async iterator type `C` whose\n// `C::next(self) -> Future[Option[(T, Self)]] with { Async }`: identical to the\n// sync loop but each step `await`s the next-future. `await` is the M1a builtin\n// (`await(Future[T]) -> T`); on the synchronous ready-future codegen it unwraps\n// in place, so this also runs on the linear backend today.\nlet build_await_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\n  let awaited = ECall(EIdent(\"await\", -1), [\n    next_call_for(ctype)\n  ], -1)\n  build_iter_for_with(name, awaited, iter, body)\n}\n\n// `for await x in pull { body }` over a pull closure `pull : () -> Option[T]`\n// (host-state async iterator, e.g. `stdin_stream`): drive `pull()` to `None`.\n// This is the M2c-3 pull model, moved here from the parser so `for await` shares\n// one type-directed desugar with the trait iterators (a struct `C` with a\n// `C::next` drives the iterator loop above; anything else — a pull closure or a\n// call whose return type is unknown — falls back to this).\nlet build_pull_for_in: (String, Option[String], Expr, Expr) -> Expr = (value_name, index_name, iterable, body) -> {\n  let some_arm = match index_name {\n    Some(ix) => ESeq(body, EAssign(ix, EBinOp(\"+\", EIdent(ix, -1), EInt(1)), EUnit)),\n    None => ESeq(body, EUnit)\n  }\n  let loop_body = EMatch(ECall(EIdent(\"__pull_next\", -1), Array::slice([\n    EUnit\n  ], 0, 0), -1), [\n    (PCtor(\"Some\", [\n      PBind(value_name)\n    ]), some_arm),\n    (PCtor(\"None\", Array::slice([\n      PWild\n    ], 0, 0)), EAssign(\"__pull_continue\", EBool(false), EUnit))\n  ])\n  let core_loop = ELetMut(\"__pull_continue\", EBool(true), EWhile(EIdent(\"__pull_continue\", -1), loop_body))\n  let with_index = match index_name {\n    Some(ix) => ELetMut(ix, EInt(0), core_loop),\n    None => core_loop\n  }\n  ELet(\"__pull_next\", iterable, with_index)\n}\n\n// Unwrap a `for await` marker: the parser wraps the iterable of a `for await`\n// loop in `__await_iter(<iterable>)` (a non-builtin sentinel call) so this pass\n// — which has type information the parser lacks — picks the iterator vs pull\n// desugar. Returns the inner iterable when `iter` is the marker.\nlet for_await_inner: (Expr) -> Option[Expr] = (iter) -> {\n  match iter {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"__await_iter\" && Array::length(args) == 1 {\n        Some(Array::get(args, 0))\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\n// Does `fname`'s recorded return-type head indicate an async iterator\n// (`next() -> Future[Option[..]]`)? Drives the `await`-wrapped loop choice.\nlet fn_return_is_future: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\n  match fn_return_type(fn_returns, fname) {\n    Some(head) => head == \"Future\",\n    None => false\n  }\n}\n\n// `for await x in inner { body }`: classify `inner` and build the loop.\n// `rinner` / `rbody` are the already-rewritten iterable / body. A struct type\n// with a `::next` drives the iterator loop (`await`-wrapped when async);\n// anything else drives the pull-closure loop.\nlet classify_for_await_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns) -> {\n  match infer_arg_type_name(inner, struct_sets, var_types, fn_returns) {\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      if fn_return_is_future(fn_returns, String::concat(tn, \"::next\")) {\n        build_await_iter_for(name, tn, rinner, rbody)\n      } else {\n        build_iter_for(name, tn, rinner, rbody)\n      }\n    } else {\n      build_pull_for_in(name, idx, rinner, rbody)\n    },\n    None => build_pull_for_in(name, idx, rinner, rbody)\n  }\n}\n\n// `for x in iter { body }`: iterator (`::next`) / iterable (`::iter`) / array\n// classification. `riter` / `rbody` are already rewritten.\n// #736: the indexed-Iterable slice of for-loop classification, USER types only\n// (struct_sets gate — Array/String/Map keep the builtin EForIn lowering even\n// though the prelude's Iterable impls define e.g. `Array::iter_length`). Split\n// out of classify_sync_for_loop because it needs no declared trait (the\n// protocol is plain named `C::iter_length`/`C::iter_get` functions, e.g.\n// @vibe/core's List), so it also runs for trait-free programs where the\n// next/iter classification stays gated off.\nlet classify_indexed_for_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns) -> {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, String::concat(tn, \"::iter_length\")) && fn_exists(fn_returns, String::concat(tn, \"::iter_get\")) {\n      build_indexed_iter_for(name, idx, tn, riter, rbody)\n    } else {\n      EForIn(name, idx, riter, rbody)\n    },\n    None => EForIn(name, idx, riter, rbody)\n  }\n}\n\nlet classify_sync_for_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns) -> {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      build_iter_for(name, tn, riter, rbody)\n    } else {\n      match fn_return_type(fn_returns, String::concat(tn, \"::iter\")) {\n        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, \"::iter\"), -1), [\n          riter\n        ], -1), rbody),\n        None => classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n      }\n    },\n    None => EForIn(name, idx, riter, rbody)\n  }\n}\n\n// Extend the local var-type environment with `name` when its bound value's\n// type was inferable. A fresh array (copy) is returned so sibling scopes do not\n// see the binding.\nlet extend_var_types: (Array[(String, String)], String, Option[String]) -> Array[(String, String)] = (var_types, name, inferred) -> {\n  match inferred {\n    Some(tname) => {\n      let out = Array::slice([\n        (\"\", \"\")\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(var_types) {\n        Array::push(out, Array::get(var_types, i))\n        i = i + 1\n      }\n      Array::push(out, (name, tname))\n      out\n    },\n    None => var_types\n  }\n}\n\n// #672: a qualified constructor `Enum::Variant` -> the unqualified variant\n// `Variant`, when `member` is a constructor of enum `head` (variants are bound\n// unqualified, and codegen's ctor table is keyed unqualified). `head` MUST be a\n// known user enum/struct (`struct_sets` includes enum names) — this is the gate\n// that keeps builtin qualified calls like `String::join` / `Array::map` alone\n// even when a same-named function (`join`/`map`) happens to return that type.\nlet qual_ctor_member: (String, String, Array[(String, Array[String])], Array[(String, String)]) -> Option[String] = (head, member, struct_sets, fn_returns) -> {\n  if struct_set_has(struct_sets, head) {\n    match fn_return_type(fn_returns, member) {\n      Some(en) => if en == head {\n        Some(member)\n      } else {\n        None\n      },\n      None => None\n    }\n  } else {\n    None\n  }\n}\n\n// #635: classify a call as a railway-bind/op sentinel. Returns\n//   0 = `__try_bind(val, (name) -> rest)` (callee `__try_bind`, 2 args, arg1\n//       a 1-param closure),\n//   1 = `__try_op(val)` (callee `__try_op`, exactly 1 arg),\n//   2 = not a sentinel (ordinary call; e.g. a user fn that happens to share the\n//       name but with a different arity/shape).\nlet try_sentinel: (Expr, Array[Expr]) -> Int = (callee, args) -> {\n  match callee {\n    EIdent(n, _) => if n == \"__try_bind\" {\n      if Array::length(args) == 2 {\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {\n            0\n          } else {\n            2\n          },\n          _ => 2\n        }\n      } else {\n        2\n      }\n    } else if n == \"__try_op\" {\n      if Array::length(args) == 1 {\n        1\n      } else {\n        2\n      }\n    } else {\n      2\n    },\n    _ => 2\n  }\n}\n\n// #635: lower the `let* name = val <rest>` sentinel by `val`'s head type.\n// Option -> `match val { Some(name) => rest, None => None }`; else (Result, or\n// undeterminable -> default Result, today's behavior) the railway Result match\n// `match val { Ok(name) => rest, Err(__bind_err) => Err(__bind_err) }`.\nlet lower_try_bind: (Expr, String, Expr, Option[String]) -> Expr = (val, name, rest, inferred) -> {\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EIdent(\"None\", -1))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"Err\", [\n          PBind(\"__bind_err\")\n        ]), ECall(EIdent(\"Err\", -1), [\n          EIdent(\"__bind_err\", -1)\n        ], -1))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(name)\n      ]), rest),\n      (PCtor(\"Err\", [\n        PBind(\"__bind_err\")\n      ]), ECall(EIdent(\"Err\", -1), [\n        EIdent(\"__bind_err\", -1)\n      ], -1))\n    ])\n  }\n}\n\n// #635: lower the `val?` sentinel by `val`'s head type. Option -> yield the\n// inner value on `Some`, early-`return None` on `None`. Else (Result, or\n// undeterminable -> default Result) -> yield on `Ok`, early-`return Err(e)` on\n// `Err`. Uses `EReturn`, so the enclosing function short-circuits.\nlet lower_try_op: (Expr, Option[String]) -> Expr = (val, inferred) -> {\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EReturn(EIdent(\"None\", -1)))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"Err\", [\n          PBind(\"__try_e\")\n        ]), EReturn(ECall(EIdent(\"Err\", -1), [\n          EIdent(\"__try_e\", -1)\n        ], -1)))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(\"__try_v\")\n      ]), EIdent(\"__try_v\", -1)),\n      (PCtor(\"Err\", [\n        PBind(\"__try_e\")\n      ]), EReturn(ECall(EIdent(\"Err\", -1), [\n        EIdent(\"__try_e\", -1)\n      ], -1)))\n    ])\n  }\n}\n\n// #635: standalone railway-sentinel lowering. Walks an expr and rewrites only\n// the `__try_bind`/`__try_op` sentinels (everything else is recursed\n// structurally unchanged), type-directing each by `infer_arg_type_name`. Runs\n// from BOTH the checker (`check_program`, where the heavy dict-passing pass does\n// NOT run) and — idempotently — the codegen `desugar_trait_dicts`. It is inert\n// for programs that use no `let*`/`?` (no sentinels present). `var_types` tracks\n// locals so `let* x = some_opt` then `let* y = uses(x)` resolves x's type.\nlet rec railway_rw: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, struct_sets, var_types, fn_returns) -> {\n  match expr {\n    ECall(callee, args, off) => {\n      let k = try_sentinel(callee, args)\n      if k == 0 {\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            let body_vars = extend_var_types(var_types, name, inferred)\n            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if k == 1 {\n        let val = Array::get(args, 0)\n        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n        ECall(railway_rw(callee, struct_sets, var_types, fn_returns), for a in args {\n          railway_rw(a, struct_sets, var_types, fn_returns)\n        }, off)\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EStringInterp(_) => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    ERecord(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(out)\n    },\n    EMap(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),\n    ELet(name, val, body) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\n    },\n    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    ELetMut(name, val, body) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\n    },\n    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, railway_rw(init, struct_sets, var_types, fn_returns))\n    }, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),\n    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off) => EDot(railway_rw(obj, struct_sets, var_types, fn_returns), field, off),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EThrow(e) => EThrow(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    })\n  }\n}\n\n// #635: lower the `let*`/`?` sentinels across a whole program. In-place,\n// idempotent (a second run finds no sentinels), and inert for programs that use\n// neither. Exported so the checker path can lower before type-checking.\nlet rec railway_rw_stmt: (Stmt, Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (s, struct_sets, fn_returns) -> {\n  let no_vars = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  match s {\n    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, no_vars, fn_returns)),\n    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, no_vars, fn_returns)),\n    STest(name, body) => STest(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\n    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\n    SExpr(e) => SExpr(railway_rw(e, struct_sets, no_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for inner in body {\n      railway_rw_stmt(inner, struct_sets, fn_returns)\n    }),\n    _ => s\n  }\n}\n\nexport let desugar_railway_binds: (Array[Stmt]) -> Unit = (stmts) -> {\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns))\n    i = i + 1\n  }\n}\n\n// The core rewriter. `dict_binds` is non-empty only inside a transformed\n// generic's body (so `T::method` resolves to a dict field); call-site dict\n// threading applies everywhere a transformed generic is called. `var_types`\n// tracks locals/params whose concrete type is known, for call-site dict\n// synthesis when the receiver is a variable.\nlet rec rewrite_expr: (Expr, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, gens, traits, struct_sets, dict_binds, var_types, fn_returns) -> {\n  match expr {\n    EIdent(name, off) => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match find_dict_for_method(dict_binds, head, member) {\n          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1),\n          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {\n            Some(m) => EIdent(m, off),\n            None => expr\n          }\n        }\n      },\n      None => expr\n    },\n    ECall(callee, args, off) => {\n      // #635: type-directed lowering of the railway sentinels emitted by the\n      // parser. `__try_bind(val, (x) -> rest)` and `__try_op(val)` carry no type\n      // info from the parser; here `infer_arg_type_name(val)` picks Option vs\n      // Result (default Result when undeterminable — today's behavior). A user\n      // function literally named `__try_bind`/`__try_op` with the wrong shape\n      // (handled by `try_sentinel` returning None) takes the generic path.\n      let try_kind = try_sentinel(callee, args)\n      if try_kind == 0 {\n        // __try_bind(val, (name) -> rest)\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            let body_vars = extend_var_types(var_types, name, inferred)\n            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if try_kind == 1 {\n        // __try_op(val)\n        let val = Array::get(args, 0)\n        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n      let rwargs = for a in args {\n        rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      }\n      match callee {\n        EIdent(name0, coff) => {\n          // #672: unqualify a qualified constructor call `Enum::Variant(..)` ->\n          // `Variant(..)` so codegen's (unqualified) ctor table recognizes it.\n          let name_ctor = match split_qualified(name0) {\n            Some(parts0) => {\n              let (h0, m0) = parts0\n              match qual_ctor_member(h0, m0, struct_sets, fn_returns) {\n                Some(mm) => mm,\n                None => name0\n              }\n            },\n            None => name0\n          }\n          // #736 residual: bare method-style callee — `xs |> length` is\n          // `length(xs)`; with only the receiver TYPE imported there is no\n          // top-level `length`, so resolve to `<type-of-arg0>::length` (USER\n          // types only, and only when no top-level fn of the bare name exists\n          // — a lexically visible `length` keeps normal call semantics). The\n          // checker applies the same rule, so typing and codegen agree.\n          let name = if String::index_of(name_ctor, \"::\") < 0 && !fn_exists(fn_returns, name_ctor) && Array::length(args) >= 1 {\n            match infer_arg_type_name(Array::get(args, 0), struct_sets, var_types, fn_returns) {\n              Some(tn) => {\n                let qual = String::concat(tn, String::concat(\"::\", name_ctor))\n                if struct_set_has(struct_sets, tn) && fn_exists(fn_returns, qual) {\n                  qual\n                } else {\n                  name_ctor\n                }\n              },\n              None => name_ctor\n            }\n          } else {\n            name_ctor\n          }\n          // `T::method(args)` inside a transformed body -> `(dict.method)(args)`.\n          let as_method = match split_qualified(name) {\n            Some(parts) => {\n              let (head, member) = parts\n              find_dict_for_method(dict_binds, head, member)\n            },\n            None => None\n          }\n          match as_method {\n            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1), rwargs, off),\n            None => match lookup_gen(gens, name) {\n              Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\n                Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),\n                None => ECall(EIdent(name, coff), rwargs, off)\n              },\n              None => ECall(EIdent(name, coff), rwargs, off)\n            }\n          }\n        },\n        EDot(obj, m, doff) => {\n          // #736 residual: method-style call `xs.length()` on a USER type —\n          // codegen compiles a called EDot as struct-field access, so a\n          // receiver method (`List::length`) failed with \"unknown struct\n          // field\". Rewrite to the qualified call when the receiver's type is\n          // inferable and declares the method as a top-level fn. A struct\n          // FIELD of the same name keeps the field-stored-function call (the\n          // field is the closer binding), and unknown receivers keep the EDot\n          // (codegen's existing paths).\n          let robj = rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          let as_recv_method = match infer_arg_type_name(obj, struct_sets, var_types, fn_returns) {\n            Some(tn) => {\n              let qual = String::concat(tn, String::concat(\"::\", m))\n              let is_field = struct_set_member(struct_sets, tn, m)\n              if !is_field && fn_exists(fn_returns, qual) {\n                Some(qual)\n              } else {\n                None\n              }\n            },\n            None => None\n          }\n          match as_recv_method {\n            Some(qual) => ECall(EIdent(qual, doff), prepend_expr(robj, rwargs), off),\n            None => ECall(EDot(robj, m, doff), rwargs, off)\n          }\n        },\n        _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)\n      }\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(_) => expr,\n    EStringInterp(_) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    ERecord(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(out)\n    },\n    EMap(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELet(name, val, body) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\n    },\n    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELetMut(name, val, body) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\n    },\n    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))\n    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => {\n      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      // `for await x in s` (#636 unification): the parser wraps `s` in an\n      // `__await_iter` marker; classify_for_await_loop picks iterator vs pull\n      // loop by type. It runs regardless of whether a trait is declared, since\n      // `for await` predates the trait machinery. A plain `for x in e` is\n      // iterator/iterable/array-classified only when a method-bearing trait is\n      // present (without one there are no `impl ::next` methods to dispatch), so\n      // trait-free programs' `for` loops are untouched.\n      match for_await_inner(iter) {\n        Some(inner) => {\n          let rinner = rewrite_expr(inner, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          classify_for_await_loop(name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns)\n        },\n        None => {\n          let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          if Array::length(traits) == 0 {\n            // No declared trait: next/iter classification stays off (no\n            // `impl ::next` to dispatch), but the #736 indexed protocol is\n            // plain named functions, so it classifies regardless.\n            classify_indexed_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n          } else {\n            classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n          }\n        }\n      }\n    },\n    EBinOp(op, l, r) => {\n      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      // #672: dispatch `a == b` / `a != b` on a struct type to the generated\n      // structural `T::equals`. The operand's type is resolved best-effort via\n      // `infer_arg_type_name` (var_types for variables, field-set match for\n      // struct literals); a struct type whose `equals` we generated is rewritten\n      // to a call. Non-struct / unresolved operands keep the scalar binop.\n      if op == \"==\" || op == \"!=\" {\n        // #695: an empty array LITERAL on either side reduces `==` to a length\n        // check on the other operand (an array equals `[]` iff its length is 0),\n        // which is exact and needs no element type. This also covers `[] == []`,\n        // whose element type is otherwise undeterminable.\n        let empty_l = is_empty_array_lit(l)\n        let empty_r = is_empty_array_lit(r)\n        // #695: a bare array `==` (operand is an array literal whose element type\n        // is statically determinable) dispatches to the monomorphic\n        // `__arr_equals__<key>` helper (emitted by desugar_derives), since the\n        // runtime `eq` would identity-compare the array. Opaque array-typed\n        // operands (no literal in scope) are left as `==` (documented residual).\n        let arr_elem = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        if empty_l || empty_r {\n          let other = if empty_l {\n            rr\n          } else {\n            rl\n          }\n          let lencmp = EBinOp(\"==\", ECall(EIdent(\"Array::length\", -1), [\n            other\n          ], -1), EInt(0))\n          if op == \"==\" {\n            lencmp\n          } else {\n            ECall(EIdent(\"not\", -1), [\n              lencmp\n            ], -1)\n          }\n        } else {\n        match arr_elem {\n          Some(elem) => {\n            let call = ECall(EIdent(arr_equals_name(elem), -1), [\n              rl,\n              rr\n            ], -1)\n            if op == \"==\" {\n              call\n            } else {\n              ECall(EIdent(\"not\", -1), [\n                call\n              ], -1)\n            }\n          },\n          None => {\n            let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n              Some(t) => Some(t),\n              None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)\n            }\n            match ty {\n              Some(t) => if struct_set_has(struct_sets, t) {\n                let call = ECall(EIdent(String::concat(t, \"::equals\"), -1), [\n                  rl,\n                  rr\n                ], -1)\n                if op == \"==\" {\n                  call\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    call\n                  ], -1)\n                }\n              } else if t == \"Option\" {\n                // Bare `==` on Option-typed operands (e.g. `let a = None; a == b`)\n                // dispatches to a structural match; the runtime would otherwise\n                // identity-compare the heap-allocated nullary `None`. Payloads\n                // compare with `==` — correct for scalar payloads (the common\n                // case); an aggregate-payload bare-Option variable is a #695\n                // residual (route it through a struct field for full recursion).\n                let eqm = opt_eq_match(rl, rr)\n                if op == \"==\" {\n                  eqm\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    eqm\n                  ], -1)\n                }\n              } else if t == \"Result\" {\n                let eqm = result_eq_match(rl, rr)\n                if op == \"==\" {\n                  eqm\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    eqm\n                  ], -1)\n                }\n              } else {\n                EBinOp(op, rl, rr)\n              },\n              None => EBinOp(op, rl, rr)\n            }\n          }\n        }\n        }\n      } else if op == \"<\" || op == \">\" || op == \"<=\" || op == \">=\" {\n        // #746: String relational lowering. The backends compile a bare\n        // `<`/`>`/`<=`/`>=` as signed i64 compare — on the (ptr<<32)|len\n        // string repr that orders by POINTER, not content. Rewrite to\n        // `str_lex_diff(l, r) <op> 0` (a builtin returning a sign-carrying\n        // lexicographic diff with length tie-break) when either ORIGINAL\n        // operand is determinably String — same inference and residual\n        // class as the `+` -> String::concat rewrite below.\n        let rel_stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        })\n        if rel_stringish {\n          EBinOp(op, ECall(EIdent(\"str_lex_diff\", -1), [\n            rl,\n            rr\n          ], -1), EInt(0))\n        } else {\n          EBinOp(op, rl, rr)\n        }\n      } else if op == \"+\" {\n        // String `+` lowering: the checker types `String + String` as String,\n        // but the backends compile a bare `+` as numeric i64.add — on the\n        // (ptr<<32)|len string repr that adds the lengths and garbles the\n        // pointer. Rewrite to String::concat when either ORIGINAL operand is\n        // determinably String (literal, tracked var, string-returning call,\n        // or a nested `+` chain of those). Undeterminable operands (e.g. two\n        // untracked call results) keep the raw binop — same residual class\n        // as #695's opaque `==`.\n        let stringish = (match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        }) || (match infer_arg_type_name(r, struct_sets, var_types, fn_returns) {\n          Some(t) => t == \"String\",\n          None => false\n        })\n        if stringish {\n          ECall(EIdent(\"String::concat\", -1), [\n            rl,\n            rr\n          ], -1)\n        } else {\n          EBinOp(op, rl, rr)\n        }\n      } else {\n        EBinOp(op, rl, rr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off) => EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), field, off),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EThrow(e) => EThrow(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    })\n  }\n}\n\n// Extract the member of a qualified `Head::member` name (the part after `::`).\nlet member_of: (String) -> String = (name) -> {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (_, member) = parts\n      member\n    },\n    None => name\n  }\n}\n\n// Build the dict bindings in scope for a transformed generic's body.\nlet dict_binds_of: (Array[(String, String, Int)], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] = (threaded, traits) -> {\n  let out = empty_dict_binds()\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let methods = match lookup_trait_sigs(traits, trait_name) {\n      Some(sigs) => method_names_of_sigs(sigs),\n      None => empty_str_array()\n    }\n    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))\n    i = i + 1\n  }\n  out\n}\n\n// Prepend the hidden dict parameters to a transformed generic's parameter list.\nlet thread_dict_params: (Array[(String, String, Int)], Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (threaded, params) -> {\n  let result = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let dty = TyApp(dict_struct_name(trait_name), [\n      TyName(tp)\n    ])\n    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(params) {\n    Array::push(result, Array::get(params, j))\n    j = j + 1\n  }\n  result\n}\n\nlet rewrite_stmt: (Stmt, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (stmt, gens, traits, struct_sets, fn_returns) -> {\n  let no_binds = empty_dict_binds()\n  let no_vars = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  match stmt {\n    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {\n      Some(threaded) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => {\n          let binds = dict_binds_of(threaded, traits)\n          let new_params = thread_dict_params(threaded, params)\n          let seeded = seed_var_types(params, tparams, no_vars)\n          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)\n          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))\n        },\n        _ => stmt\n      },\n      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns))\n    },\n    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for s in body {\n      rewrite_stmt(s, gens, traits, struct_sets, fn_returns)\n    }),\n    _ => stmt\n  }\n}\n\n// ---- derive(...) structural function generation (#638) ----\n//\n// For a `struct P { x; y } derive(Show, Ord)` this generates the structural\n// free functions `P::to_string` and `P::compare` (concrete `Type::method`,\n// resolved by the PR-1 dispatch path). `Eq` stays a no-op marker (structural\n// `==` is a runtime builtin). Hash / Default and enums are deferred slices.\n\nlet qualified_name: (String, String) -> String = (tname, method) -> {\n  String::concat(tname, String::concat(\"::\", method))\n}\n\nlet top_level_fn_exists: (Array[Stmt], String) -> Bool = (stmts, fname) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => if name == fname {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\nlet concat2: (Expr, Expr) -> Expr = (a, b) -> {\n  ECall(EIdent(\"String::concat\", -1), [\n    a,\n    b\n  ], -1)\n}\n\n// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array\n// to-string helper `__arr_to_string__<key>` so distinct element types get\n// distinct helpers. `Int` -> \"Int\", `Array[Int]` -> \"Array_Int\",\n// `Option[Int]` -> \"Option_Int\", `(Int,Bool)` -> \"Tup_Int_Bool\", else \"Any\".\n// (#694: mirrors #672/#695-era helper-naming so Layer-2 recursion into\n// `Array[t]` fields produces a structural — not pointer-heuristic — string.)\nlet rec ts_type_key: (TypeExpr) -> String = (ty) -> {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\n// The generated monomorphic array-to-string helper name for element type `t`.\nlet arr_to_string_name: (TypeExpr) -> String = (t) -> {\n  String::concat(\"__arr_to_string__\", ts_type_key(t))\n}\n\n// Produce a String expression for a value `val` whose declared type is `fty`.\n// Fully type-directed and recursive (#694 Layer 2):\n//   - `String` -> verbatim\n//   - scalar `TyName` -> `__to_string(val)`\n//   - declared struct/enum `TyName(n)` (`known_types`) -> `n::to_string(val)`\n//   - `Option[t]` -> `match val { Some(x) => \"Some(\" ++ show(x) ++ \")\", None => \"None\" }`\n//   - `Result[t,e]` -> `Ok(..)` / `Err(..)` structural match\n//   - tuple `(t0,..,tn)` -> `\"(\" ++ show(t0) ++ \", \" ++ .. ++ \")\"`\n//   - `Array[t]` -> a call to the monomorphic `__arr_to_string__<key>` helper\n//   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::to_string(val)`\n//   - anything else -> `__to_string(val)` (status-quo pointer/scalar heuristic)\n// The structural `Type::to_string` (and the derived `Type::hash_key` that\n// delegates to it) is therefore stable for two distinct-but-equal aggregates,\n// no matter how deeply nested.\nlet rec show_for_typed: (TypeExpr, Expr, Array[String]) -> Expr = (fty, val, known_types) -> {\n  match fty {\n    TyName(\"String\") => val,\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner = show_for_typed(t, EIdent(\"__os_v\", -1), known_types)\n      let some_body = concat2(EString(\"Some(\"), concat2(inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__os_v\")\n        ], 0, 1)), some_body),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EString(\"None\"))\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_inner = show_for_typed(t, EIdent(\"__rs_v\", -1), known_types)\n      let err_inner = show_for_typed(e, EIdent(\"__rs_v\", -1), known_types)\n      let ok_body = concat2(EString(\"Ok(\"), concat2(ok_inner, EString(\")\")))\n      let err_body = concat2(EString(\"Err(\"), concat2(err_inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), ok_body),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), err_body)\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let pats = Array::slice([\n        PWild\n      ], 0, 0)\n      let mut i = 0\n      while i < n {\n        Array::push(pats, PBind(String::concat(\"__ts_t\", idx_str(i))))\n        i = i + 1\n      }\n      let segs = empty_expr_array()\n      Array::push(segs, EString(\"(\"))\n      let mut k = 0\n      while k < n {\n        if k > 0 {\n          Array::push(segs, EString(\", \"))\n        } else {\n          ()\n        }\n        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat(\"__ts_t\", idx_str(k)), -1), known_types))\n        k = k + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      EMatch(val, Array::slice([\n        (PTuple(pats), acc)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    _ => ECall(EIdent(\"__to_string\", -1), Array::slice([\n      val\n    ], 0, 1), -1)\n  }\n}\n\n// Show a single struct field value as a String expression, by its declared type\n// (#694: type-directed and recursive — aggregate fields recurse structurally\n// instead of falling into the `__to_string` pointer heuristic).\nlet field_show_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\n  show_for_typed(fty, EDot(EIdent(\"self\", -1), fname, -1), known_types)\n}\n\n// `let __arr_to_string__<key> = (a: Array[t]) -> String {\n//    \"[\" ++ join(show(a[0]), \", \", show(a[1]), ...) ++ \"]\" }` — a monomorphic,\n// fully-recursive array to-string. Element rendering goes through\n// `show_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse structurally\n// instead of pointer-stringifying aggregate elements. (#694 Layer 2.)\nlet gen_arr_to_string_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\n  let elem_get = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__as_i\", -1)\n  ], 0, 2), -1)\n  let elem_show = show_for_typed(elem_ty, elem_get, known_types)\n  // `__as_acc = __as_acc ++ (if i == 0 { \"\" } else { \", \" }) ++ show(a[i])`\n  let sep = EIf(EBinOp(\"==\", EIdent(\"__as_i\", -1), EInt(0)), EString(\"\"), EString(\", \"))\n  let append = concat2(concat2(EIdent(\"__as_acc\", -1), sep), elem_show)\n  let set_acc = EAssign(\"__as_acc\", append, EUnit)\n  let incr = EAssign(\"__as_i\", EBinOp(\"+\", EIdent(\"__as_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_acc, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__as_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let closed = concat2(EIdent(\"__as_acc\", -1), EString(\"]\"))\n  let body = ELetMut(\"__as_i\", EInt(0), ELetMut(\"__as_acc\", EString(\"[\"), ESeq(while_loop, closed)))\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\n// `let P::to_string = (self: P) -> String { \"P { x: \" ++ show(x) ++ \", ... }\" }`\nlet gen_show_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\n  let segs = empty_expr_array()\n  Array::push(segs, EString(String::concat(tname, \" { \")))\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    let sep = if i == 0 {\n      \"\"\n    } else \", \"\n    Array::push(segs, EString(String::concat(sep, String::concat(fname, \": \"))))\n    Array::push(segs, field_show_expr(fname, fty, known_types))\n    i = i + 1\n  }\n  Array::push(segs, EString(\" }\"))\n  // fold right: concat(seg0, concat(seg1, ... segN))\n  let mut body = Array::get(segs, Array::length(segs) - 1)\n  let mut j = Array::length(segs) - 2\n  while j >= 0 {\n    body = concat2(Array::get(segs, j), body)\n    j = j - 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\n// A type name that the runtime compares as a flat scalar (no structural\n// `equals` needed). Everything else named is a user struct/enum and recurses\n// through its generated `T::equals`.\nlet is_scalar_type_name: (String) -> Bool = (n) -> {\n  n == \"Int\" || n == \"Double\" || n == \"Bool\" || n == \"String\" || n == \"Char\" || n == \"Unit\" || n == \"Bytes\"\n}\n\n// A stable, fn-name-safe key for a TypeExpr, used to name the monomorphic array\n// helper `__arr_equals__<key>` so distinct element types get distinct helpers.\n// `Int` -> \"Int\", `Array[Int]` -> \"Array_Int\", `Option[Int]` -> \"Option_Int\",\n// `(Int,Bool)` -> \"Tup_Int_Bool\", unknown shapes -> \"Any\".\nlet rec type_key: (TypeExpr) -> String = (ty) -> {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\n// The generated monomorphic array-equality helper name for element type `t`.\nlet arr_equals_name: (TypeExpr) -> String = (t) -> {\n  String::concat(\"__arr_equals__\", type_key(t))\n}\n\n// Structural equality match for two Option operands whose element type is NOT\n// statically known here (bare `==` dispatch on Option-typed variables). Some\n// payloads compare with `==` (correct for scalars); a None matches a None.\n// (#695.)\nlet opt_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  let some_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let none_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"None\", Array::slice([\n      PWild\n    ], 0, 0)), EBool(true)),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_l\")\n    ], 0, 1)), some_inner),\n    (PCtor(\"None\", Array::slice([\n      PWild\n    ], 0, 0)), none_inner)\n  ], 0, 2))\n}\n\n// Structural equality match for two Result operands of statically-unknown\n// element types (bare `==` dispatch). (#695.)\nlet result_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  let ok_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let err_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), ok_inner),\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), err_inner)\n  ], 0, 2))\n}\n\n// Equality of two operands whose declared type is `fty`. Fully type-directed:\n//   - scalar `TyName` -> raw `==`\n//   - declared struct/enum `TyName(n)` -> `n::equals(lhs, rhs)`\n//   - `Option[t]` / `Result[t,e]` -> inline `match` recursing on payloads\n//   - `(t0,..,tn)` tuple -> inline `match` over `PTuple`, conjoining element eqs\n//   - `Array[t]` -> a call to the monomorphic `__arr_equals__<key>` helper\n//   - declared generic `TyApp(n, _)` (e.g. `Box[T]`) -> `n::equals(lhs, rhs)`\n//   - anything else -> raw `==` (status quo fallback)\n// The runtime `eq` builtin is type-blind (it identity-compares aggregates), so\n// structural equality MUST be resolved here at the AST level where the static\n// type is known. (#695.)\nlet rec eq_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\n  match fty {\n    TyName(n) => if n == \"Double\" || n == \"Float\" {\n      // Under RC a Double is a BOXED heap value, so a raw `==` between two\n      // Double fields compares box identity (always false) instead of the f64\n      // payload. Wrap each operand in the identity `Double::to_float` so the\n      // `==` codegen recognizes the operands as floatish (expr_is_floatish) and\n      // takes the unbox-then-f64.eq path. Harmless on the non-RC backend, where\n      // the wrapper is identity and the float branch compares raw bits (#704).\n      EBinOp(\"==\", ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        lhs\n      ], 0, 1), -1), ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        rhs\n      ], 0, 1), -1))\n    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner_eq = eq_for_typed(t, EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1), known_types)\n      let some_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_r\")\n        ], 0, 1)), inner_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let none_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EBool(true)),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_l\")\n        ], 0, 1)), some_inner),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), none_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_eq = eq_for_typed(t, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let err_eq = eq_for_typed(e, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let ok_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), ok_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let err_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), err_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), ok_inner),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), err_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let lpats = Array::slice([\n        PWild\n      ], 0, 0)\n      let rpats = Array::slice([\n        PWild\n      ], 0, 0)\n      let mut i = 0\n      while i < n {\n        Array::push(lpats, PBind(String::concat(\"__teq_l\", idx_str(i))))\n        Array::push(rpats, PBind(String::concat(\"__teq_r\", idx_str(i))))\n        i = i + 1\n      }\n      let mut conj = EBool(true)\n      let mut j = n - 1\n      while j >= 0 {\n        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(\"__teq_l\", idx_str(j)), -1), EIdent(String::concat(\"__teq_r\", idx_str(j)), -1), known_types)\n        conj = EBinOp(\"&&\", cmp, conj)\n        j = j - 1\n      }\n      let inner = EMatch(rhs, Array::slice([\n        (PTuple(rpats), conj)\n      ], 0, 1))\n      EMatch(lhs, Array::slice([\n        (PTuple(lpats), inner)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    _ => EBinOp(\"==\", lhs, rhs)\n  }\n}\n\n// `let __arr_equals__<key> = (a: Array[t], b: Array[t]) -> Bool { ... }` — a\n// monomorphic, fully-recursive array structural equality. Element compare goes\n// through `eq_for_typed`, so `Array[Foo]` / `Array[Array[Int]]` recurse\n// correctly instead of identity-comparing aggregate elements. (#695.)\nlet gen_arr_equals_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\n  let len_a = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)\n  let len_b = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"b\", -1)\n  ], 0, 1), -1)\n  let elem_a = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_b = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"b\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)\n  let not_eq = ECall(EIdent(\"not\", -1), Array::slice([\n    elem_eq\n  ], 0, 1), -1)\n  let set_false = EIf(not_eq, EAssign(\"__ae_ok\", EBool(false), EUnit), EUnit)\n  let incr = EAssign(\"__ae_i\", EBinOp(\"+\", EIdent(\"__ae_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_false, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__ae_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let body_eq = ELetMut(\"__ae_i\", EInt(0), ELetMut(\"__ae_ok\", EBool(true), ESeq(while_loop, EIdent(\"__ae_ok\", -1))))\n  let body = EIf(EBinOp(\"!=\", len_a, len_b), EBool(false), body_eq)\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty)),\n    (\"b\", Some(arr_ty))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\n// One field's equality expression: `a.f == b.f` for scalar/param fields, or a\n// direct `FieldType::equals(a.f, b.f)` for aggregate (declared struct/enum)\n// fields so nested/recursive structs compare structurally. (#672 recursion.)\nlet field_eq_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\n  eq_for_typed(fty, EDot(EIdent(\"a\", -1), fname, -1), EDot(EIdent(\"b\", -1), fname, -1), known_types)\n}\n\n// `let P::equals = (a: P, b: P) -> Bool { a.x == b.x && a.y == b.y && ... }`\n// Mirrors gen_compare_fn. Primitive fields compare with `==`; aggregate fields\n// recurse through the field type's generated `equals`. An empty struct is `true`.\nlet gen_eq_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\n  let mut body = EBool(true)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, fty) = Array::get(fields, i)\n    body = EBinOp(\"&&\", field_eq_expr(fname, fty, known_types), body)\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\n// Small non-negative Int -> decimal String (Int::to_string is not in scope in\n// this module). Used only to make unique enum-field binder names.\nlet digit_str: (Int) -> String = (d) -> {\n  if d == 0 {\n    \"0\"\n  } else if d == 1 {\n    \"1\"\n  } else if d == 2 {\n    \"2\"\n  } else if d == 3 {\n    \"3\"\n  } else if d == 4 {\n    \"4\"\n  } else if d == 5 {\n    \"5\"\n  } else if d == 6 {\n    \"6\"\n  } else if d == 7 {\n    \"7\"\n  } else if d == 8 {\n    \"8\"\n  } else {\n    \"9\"\n  }\n}\n\nlet rec idx_str: (Int) -> String = (n) -> {\n  if n < 10 {\n    digit_str(n)\n  } else {\n    String::concat(idx_str(n / 10), digit_str(n % 10))\n  }\n}\n\n// `let E::equals = (a: E, b: E) -> Bool {\n//    match a {\n//      V1(_a0, _a1) => match b { V1(_b0, _b1) => _a0 == _b0 && _a1 == _b1, _ => false },\n//      V2          => match b { V2 => true, _ => false }, ... } }`\n// Tag mismatch falls to the inner `_ => false`; payload `==` is itself\n// dispatched, so aggregate payloads recurse into their own `equals`.\nlet gen_enum_eq_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let outer_arms = Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let abinds = Array::slice([\n      PWild\n    ], 0, 0)\n    let bbinds = Array::slice([\n      PWild\n    ], 0, 0)\n    let mut fi = 0\n    while fi < nf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(fi))))\n      Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let mut body = EBool(true)\n    let mut bi = nf - 1\n    while bi >= 0 {\n      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat(\"__a\", idx_str(bi)), -1), EIdent(String::concat(\"__b\", idx_str(bi)), -1), known_types)\n      body = EBinOp(\"&&\", cmp, body)\n      bi = bi - 1\n    }\n    let inner_arms = Array::slice([\n      (PCtor(vname, bbinds), body),\n      (PWild, EBool(false))\n    ], 0, 2)\n    let inner = EMatch(EIdent(\"b\", -1), inner_arms)\n    Array::push(outer_arms, (PCtor(vname, abinds), inner))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\n// `let P::compare = (a: P, b: P) -> Int { lexicographic over fields -> -1/0/1 }`\nlet gen_compare_fn: (String, Array[(String, TypeExpr)]) -> Stmt = (tname, fields) -> {\n  let neg_one = 0 - 1\n  let mut body = EInt(0)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, _) = Array::get(fields, i)\n    let af = EDot(EIdent(\"a\", -1), fname, -1)\n    let bf = EDot(EIdent(\"b\", -1), fname, -1)\n    body = EIf(EBinOp(\"<\", af, bf), EInt(neg_one), EIf(EBinOp(\">\", af, bf), EInt(1), body))\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, body))\n}\n\n// Show an arbitrary value expression by its declared type (#694: type-directed\n// and recursive via `show_for_typed`, so aggregate enum payloads — nested\n// struct/enum, Option, Result, tuple, Array — render structurally instead of\n// through the `__to_string` pointer heuristic).\nlet show_expr_typed: (Expr, TypeExpr, Array[String]) -> Expr = (val, fty, known_types) -> {\n  show_for_typed(fty, val, known_types)\n}\n\n// `let E::to_string = (self: E) -> String {\n//    match self { V0(_a0, _a1) => \"V0(\" ++ show(_a0) ++ \", \" ++ show(_a1) ++ \")\",\n//                 V1 => \"V1\", ... } }`\n// A nullary variant shows as its bare name; a payload variant shows as\n// `Name(p0, p1, ...)` with each payload shown structurally.\nlet gen_enum_show_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let arms = Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let binds = Array::slice([\n      PWild\n    ], 0, 0)\n    let mut fi = 0\n    while fi < nf {\n      Array::push(binds, PBind(String::concat(\"__s\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let body = if nf == 0 {\n      EString(vname)\n    } else {\n      let segs = empty_expr_array()\n      Array::push(segs, EString(String::concat(vname, \"(\")))\n      let mut si = 0\n      while si < nf {\n        let sep = if si == 0 {\n          \"\"\n        } else \", \"\n        if sep != \"\" {\n          Array::push(segs, EString(sep))\n        } else {\n          ()\n        }\n        Array::push(segs, show_expr_typed(EIdent(String::concat(\"__s\", idx_str(si)), -1), Array::get(ftypes, si), known_types))\n        si = si + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      acc\n    }\n    Array::push(arms, (PCtor(vname, binds), body))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(ename)))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, EMatch(EIdent(\"self\", -1), arms)))\n}\n\n// `let T::hash_key = (self: T) -> String { T::to_string(self) }` (#694 Layer 1).\n// `derive(Hash)` makes a type usable as a Map key via the method-bearing `Hash`\n// trait (`hash_key(Self) -> String`): `map_key_to_string = [K: Hash](key) ->\n// K::hash_key(key)` threads the witness (#684), and at a concrete call site\n// `get_by(m, T::{..})` the synthesized `HashDict::{ hash_key: T::hash_key }`\n// resolves here. The key is the structural `to_string` (now fully recursive via\n// `show_for_typed`), so two distinct-but-field-equal values hash to one entry.\nlet gen_hash_key_fn: (String) -> Stmt = (tname) -> {\n  let body = ECall(EIdent(qualified_name(tname, \"to_string\"), -1), Array::slice([\n    EIdent(\"self\", -1)\n  ], 0, 1), -1)\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"hash_key\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\n// Append any `Array[e]` element types referenced by a TypeExpr to `acc`\n// (dedup by type-key), so a Show/Hash-deriving type with an `Array[t]` field or\n// payload gets a generated `__arr_to_string__<key>` helper. (#694 Layer 2.)\nlet collect_show_array_elems: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, keys) -> {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let et = Array::get(args, 0)\n      let k = ts_type_key(et)\n      if str_array_contains(keys, k) {\n        ()\n      } else {\n        Array::push(keys, k)\n        Array::push(acc, et)\n      }\n    } else {\n      ()\n    },\n    _ => ()\n  }\n}\n\n// Compare two operands of declared type `fty`, returning -1/0/1. Aggregate\n// (declared struct/enum) operands recurse through `T::compare`; scalars and type\n// parameters use the runtime structural `<` / `>` (codegen handles them).\nlet compare_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\n  let neg_one = 0 - 1\n  match fty {\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"compare\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n    },\n    _ => EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n  }\n}\n\n// `let E::compare = (a: E, b: E) -> Int { ... }`\n// Lexicographic: first by variant order (a's tag index vs b's tag index), then\n// (same variant) by payload, recursively. The variant index of `a` is computed\n// by matching `a`; for each `a` variant the inner match on `b` either compares\n// payloads (same variant) or returns the sign of (a_index - b_index).\nlet gen_enum_compare_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let neg_one = 0 - 1\n  let outer_arms = Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n  let mut ai = 0\n  while ai < Array::length(variants) {\n    let (avname, aftypes) = Array::get(variants, ai)\n    let anf = Array::length(aftypes)\n    let abinds = Array::slice([\n      PWild\n    ], 0, 0)\n    let mut afi = 0\n    while afi < anf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(afi))))\n      afi = afi + 1\n    }\n    // inner match over b: for the same variant compare payloads; otherwise the\n    // sign comes from the variant order (a before b -> -1, after -> 1).\n    let inner_arms = Array::slice([\n      (PWild, EUnit)\n    ], 0, 0)\n    let mut bi = 0\n    while bi < Array::length(variants) {\n      let (bvname, bftypes) = Array::get(variants, bi)\n      let bnf = Array::length(bftypes)\n      let bbinds = Array::slice([\n        PWild\n      ], 0, 0)\n      let mut bfi = 0\n      while bfi < bnf {\n        Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(bfi))))\n        bfi = bfi + 1\n      }\n      let arm_body = if ai == bi {\n        // same variant: lexicographic over payloads, 0 if no payload.\n        let mut body = EInt(0)\n        let mut pi = anf - 1\n        while pi >= 0 {\n          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat(\"__a\", idx_str(pi)), -1), EIdent(String::concat(\"__b\", idx_str(pi)), -1), known_types)\n          let prev = body\n          body = EIf(EBinOp(\"<\", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(\">\", cmp, EInt(0)), EInt(1), prev))\n          pi = pi - 1\n        }\n        body\n      } else if ai < bi {\n        EInt(neg_one)\n      } else {\n        EInt(1)\n      }\n      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))\n      bi = bi + 1\n    }\n    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent(\"b\", -1), inner_arms)))\n    ai = ai + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\n// The default value expression for a declared field type. Per-type rules:\n//   Int -> 0, Double/Float -> 0.0, Bool -> false, String -> \"\", Unit -> (),\n//   Option[_] -> None, Array[_] -> empty array, and a declared struct/enum\n//   (in `known_types`) -> `T::default()`. A type with no sensible default (a\n//   bare type parameter, a function/tuple type, an unknown name) falls back to\n//   `()` — codegen will then flag the literal against the field's real type, so\n//   the limitation surfaces as a type error rather than silently wrong data.\nlet default_for_type: (TypeExpr, Array[String]) -> Expr = (fty, known_types) -> {\n  match fty {\n    TyName(\"Int\") => EInt(0),\n    TyName(\"Double\") => EFloat(0.0),\n    TyName(\"Float\") => EFloat(0.0),\n    TyName(\"Bool\") => EBool(false),\n    TyName(\"String\") => EString(\"\"),\n    TyName(\"Unit\") => EUnit,\n    TyName(n) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyApp(\"Option\", _) => EIdent(\"None\", -1),\n    TyApp(\"Array\", _) => EArray(empty_expr_array()),\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyUnit => EUnit,\n    _ => EUnit\n  }\n}\n\n// `let P::default = () -> P { P::{ f1: <default>, ... } }` — a struct literal\n// (ERecord; the struct type is recovered from the field set) with each field at\n// its type's default.\nlet gen_default_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\n  let rec_fields = Array::slice([\n    (\"\", EUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))\n    i = i + 1\n  }\n  let no_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord(rec_fields)))\n}\n\n// `let E::default = () -> E { V0(<default>, ...) }` — the FIRST variant, with\n// each payload slot at its type's default (nullary -> bare constructor name).\nlet gen_enum_default_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let (vname, ftypes) = Array::get(variants, 0)\n  let body = if Array::length(ftypes) == 0 {\n    EIdent(vname, -1)\n  } else {\n    let args = empty_expr_array()\n    let mut i = 0\n    while i < Array::length(ftypes) {\n      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))\n      i = i + 1\n    }\n    ECall(EIdent(vname, -1), args, -1)\n  }\n  let no_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))\n}\n\n// Scan `ty` and, for every `Array[e]` shape found anywhere inside it, append the\n// element type `e` to `acc` (deduped by `type_key`). Only the immediate element\n// types are added here; transitive nesting (`Array[Array[Int]]` needs the\n// `Array[Int]` helper too) is closed by the worklist loop in the caller, which\n// re-scans every element type it collects. (#695.)\nlet rec collect_array_elem_types: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, acc_keys) -> {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let e = Array::get(args, 0)\n      let k = type_key(e)\n      if !str_array_contains(acc_keys, k) {\n        Array::push(acc, e)\n        Array::push(acc_keys, k)\n      } else {\n        ()\n      }\n      collect_array_elem_types(e, acc, acc_keys)\n    } else {\n      ()\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_array_elem_types(Array::get(args, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    TyTuple(ts) => {\n      let mut i = 0\n      while i < Array::length(ts) {\n        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n// Best-effort element TypeExpr of an array LITERAL, inferred from its first\n// element: scalars and nested array literals only. An empty array, or a first\n// element whose type is not statically obvious here (variables, struct records,\n// calls), yields `None` — the caller then leaves a bare-array `==` as the\n// status-quo scalar binop (documented #695 residual) rather than guessing.\n// Is `e` an empty array literal `[]`? Used to reduce `[] == x` to a length check.\nlet is_empty_array_lit: (Expr) -> Bool = (e) -> {\n  match e {\n    EArray(elems) => Array::length(elems) == 0,\n    _ => false\n  }\n}\n\nlet rec infer_earray_elem_type: (Expr) -> Option[TypeExpr] = (arr) -> {\n  match arr {\n    EArray(elems) => if Array::length(elems) == 0 {\n      None\n    } else {\n      match Array::get(elems, 0) {\n        EInt(_) => Some(TyName(\"Int\")),\n        EBool(_) => Some(TyName(\"Bool\")),\n        EString(_) => Some(TyName(\"String\")),\n        EFloat(_) => Some(TyName(\"Double\")),\n        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {\n          Some(inner) => Some(TyApp(\"Array\", Array::slice([\n            inner\n          ], 0, 1))),\n          None => None\n        },\n        _ => None\n      }\n    },\n    _ => None\n  }\n}\n\n// Walk an expression and, for every `a == b` / `a != b` whose operand is an\n// array LITERAL with a determinable element type, collect that element type so a\n// `__arr_equals__<key>` helper is generated for the dispatch rewrite to call.\nlet rec collect_bare_array_eq_keys: (Expr, Array[TypeExpr], Array[String]) -> Unit = (e, acc, acc_keys) -> {\n  match e {\n    EBinOp(op, l, r) => {\n      if op == \"==\" || op == \"!=\" {\n        let et = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        match et {\n          Some(t) => {\n            let k = type_key(t)\n            if !str_array_contains(acc_keys, k) {\n              Array::push(acc, t)\n              Array::push(acc_keys, k)\n            } else {\n              ()\n            }\n            collect_array_elem_types(t, acc, acc_keys)\n          },\n          None => ()\n        }\n      } else {\n        ()\n      }\n      collect_bare_array_eq_keys(l, acc, acc_keys)\n      collect_bare_array_eq_keys(r, acc, acc_keys)\n    },\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(_, _) => (),\n    EUnit => (),\n    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ERecord(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EIf(c, t, el) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(t, acc, acc_keys)\n      collect_bare_array_eq_keys(el, acc, acc_keys)\n    },\n    ELet(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetRec(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetMut(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EAssign(_, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    EAssignOp(_, _, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    ESeq(a, b) => {\n      collect_bare_array_eq_keys(a, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EMatch(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EHandle(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EWhile(c, b) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_bare_array_eq_keys(init, acc, acc_keys)\n        i = i + 1\n      }\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EForIn(_, _, it, b) => {\n      collect_bare_array_eq_keys(it, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ECall(callee, args, _) => {\n      collect_bare_array_eq_keys(callee, acc, acc_keys)\n      collect_bare_array_eq_keys_list(args, acc, acc_keys)\n    },\n    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EDot(o, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),\n    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EThrow(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EBreak(opt) => match opt {\n      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n      None => ()\n    },\n    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    _ => ()\n  }\n}\n\nlet collect_bare_array_eq_keys_list: (Array[Expr], Array[TypeExpr], Array[String]) -> Unit = (es, acc, acc_keys) -> {\n  let mut i = 0\n  while i < Array::length(es) {\n    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)\n    i = i + 1\n  }\n}\n\nlet collect_bare_array_eq_keys_arms: (Array[(Pat, Expr)], Array[TypeExpr], Array[String]) -> Unit = (arms, acc, acc_keys) -> {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    collect_bare_array_eq_keys(b, acc, acc_keys)\n    i = i + 1\n  }\n}\n\n// In-place: for each struct with `derive(Show/Ord)`, append the structural\n// function if not already present (idempotent across the double-run pipeline).\n// The set of concrete struct/enum names declared in the program — the gate for\n// emitting DIRECT `T::equals` calls in generated comparators (a field/arg whose\n// type name is NOT here, e.g. a type parameter `T` of `Box[T]`, falls back to\n// scalar `==`, since there is no `T::equals` to call).\nlet collect_decl_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, _, _, _) => Array::push(out, name),\n      SEnum(_, ename, _, _, _) => Array::push(out, ename),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let desugar_derives: (Array[Stmt]) -> Unit = (stmts) -> {\n  let gen = empty_stmt_list()\n  let known_types = collect_decl_type_names(stmts)\n  // #694 Layer 2: collect `Array[e]` element types referenced by Show/Hash-\n  // deriving types' fields/payloads, so each gets a `__arr_to_string__<key>`\n  // helper. A worklist closes nesting (`Array[Array[Int]]` -> `Array[Int]`).\n  let arr_elems = empty_type_exprs()\n  let arr_keys = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, fields, derives, _) => {\n        // `derive(Hash)` also needs the structural `to_string`: a Hash type's\n        // stable Map-key string is its structural representation (#638), so\n        // generate `to_string` for Show OR Hash.\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(name, \"to_string\")) {\n          Array::push(gen, gen_show_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        // #694 Layer 1: `derive(Hash)` -> structural `T::hash_key` (delegates to\n        // the recursive `to_string`), so the method-bearing `Hash` witness at a\n        // `get_by(m, T::{..})` call site resolves to a stable structural key.\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(name, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(name))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut fi = 0\n          while fi < Array::length(fields) {\n            let (_, fty) = Array::get(fields, fi)\n            collect_show_array_elems(fty, arr_elems, arr_keys)\n            fi = fi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(name, \"compare\")) {\n          Array::push(gen, gen_compare_fn(name, fields))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(name, \"default\")) {\n          Array::push(gen, gen_default_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        // Generate `T::equals` for every struct (not just derive(Eq)) so the\n        // `==` dispatch below always resolves; structural equality is the\n        // sensible default for any struct, and a struct never relied on the old\n        // pointer-identity `==` (which was silently always-false).\n        if !top_level_fn_exists(stmts, qualified_name(name, \"equals\")) {\n          Array::push(gen, gen_eq_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n      },\n      SEnum(_, ename, _, variants, derives) => {\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(ename, \"to_string\")) {\n          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(ename, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(ename))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut vi = 0\n          while vi < Array::length(variants) {\n            let (_, ftypes) = Array::get(variants, vi)\n            let mut ti = 0\n            while ti < Array::length(ftypes) {\n              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)\n              ti = ti + 1\n            }\n            vi = vi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(ename, \"compare\")) {\n          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(ename, \"default\")) {\n          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        // Generate `E::equals` for every enum (same rationale as structs), so\n        // the `==` dispatch resolves enum operands too.\n        if !top_level_fn_exists(stmts, qualified_name(ename, \"equals\")) {\n          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  // #695: collect every `Array[e]` element type referenced by struct fields /\n  // enum payloads (transitively) plus those surfaced by bare-array `==` sites in\n  // user code, then emit one monomorphic `__arr_equals__<key>` helper per\n  // distinct key. The worklist closes nesting: scanning element type `e` may\n  // surface a further `Array[u]` whose helper is also required. Idempotent:\n  // guarded by `top_level_fn_exists` so re-running the pass is inert.\n  let elem_types = empty_type_exprs()\n  let elem_keys = empty_str_array()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, _, fields, _, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fty) = Array::get(fields, fi)\n          collect_array_elem_types(fty, elem_types, elem_keys)\n          fi = fi + 1\n        }\n      },\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, ftypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(ftypes) {\n            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      _ => ()\n    }\n    si = si + 1\n  }\n  // Worklist closure: scanning each collected element type can surface further\n  // nested array element types (e.g. `Array[Array[Int]]` -> `Array[Int]`).\n  let mut wi = 0\n  while wi < Array::length(elem_types) {\n    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)\n    wi = wi + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(elem_types) {\n    let et = Array::get(elem_types, ei)\n    if !top_level_fn_exists(stmts, arr_equals_name(et)) {\n      Array::push(gen, gen_arr_equals_fn(et, known_types))\n    } else {\n      ()\n    }\n    ei = ei + 1\n  }\n  // #694: emit `__arr_to_string__<key>` helpers for Array element types\n  // referenced by Show/Hash-deriving fields/payloads (`arr_elems` populated in\n  // the struct/enum arms above). Independent of the #695 `__arr_equals__` set.\n  let mut wi2 = 0\n  while wi2 < Array::length(arr_elems) {\n    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)\n    wi2 = wi2 + 1\n  }\n  let mut ei2 = 0\n  while ei2 < Array::length(arr_elems) {\n    let et2 = Array::get(arr_elems, ei2)\n    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {\n      Array::push(gen, gen_arr_to_string_fn(et2, known_types))\n    } else {\n      ()\n    }\n    ei2 = ei2 + 1\n  }\n  let mut g = 0\n  while g < Array::length(gen) {\n    Array::push(stmts, Array::get(gen, g))\n    g = g + 1\n  }\n}\n\nlet empty_stmt_list: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExport([\n      \"\"\n    ])\n  ], 0, 0)\n}\n\nlet struct_decl_exists: (Array[Stmt], String) -> Bool = (stmts, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, _, _, _) => if sname == name {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\n// Entry point: in-place dictionary-passing desugaring. No-op unless the program\n// declares at least one method-bearing trait. Idempotent: re-running (the\n// single-file pipeline desugars before generic-stripping and codegen re-runs on\n// the same stmts after) finds the bounds already stripped (so no function is\n// re-threaded) and skips dict structs that already exist.\nexport let desugar_trait_dicts: (Array[Stmt]) -> Unit = (stmts) -> {\n  // derive(...) structural function generation (#638) — independent of traits,\n  // idempotent, so it runs unconditionally here at the shared pre-check points.\n  desugar_derives(stmts)\n  // Flatten supertrait methods into each trait so `[T: B]` (for `trait B: A`)\n  // dispatches both B's and A's methods through one witness dictionary. When the\n  // program declares no method-bearing trait `traits` is empty, the dict-passing\n  // rewrites are all no-ops (`gens` empty, sync-`for` classification gated off),\n  // and the rewrite pass only strips `for await` markers — so it must still run\n  // unconditionally (`for await` predates the trait machinery).\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  // Rank-1 method generics (#684): re-attach each trait method's `[X: Bound]`\n  // binder to its impl free functions (and annotate their params) BEFORE\n  // build_gens, so `C::m` is registered as a bounded generic and the existing\n  // dict-passing threads the witness at qualified call sites. Inert (and\n  // idempotent) when no trait declares a method-level binder. Also run from\n  // `check_program` so the FS-compile path (which type-checks before this pass)\n  // sees the `X` binding and can resolve `X::method` in the impl body.\n  inject_trait_method_generics_with(stmts, traits)\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let gimpl_types = collect_generic_impl_types(stmts)\n  let gens = build_gens(stmts, traits, gimpl_types)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns))\n    i = i + 1\n  }\n  // Witness dict structs are only needed when method-bearing traits exist.\n  if Array::length(traits_raw) == 0 {\n    ()\n  } else {\n    let mut ti = 0\n    while ti < Array::length(traits) {\n      let (trait_name, sigs) = Array::get(traits, ti)\n      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {\n        ()\n      } else {\n        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))\n      }\n      ti = ti + 1\n    }\n  }\n}\n")
}

let cli_adapter_source_145 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/gc_only/index.vibe",
"//# Imports\n\nimport ../../../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../../checker/checker_stmt.vibe {\n  check_program\n}\n\nimport ../../../desugar_trait_dict.vibe {\n  desugar_trait_dicts\n}\n\nimport ../wasi_only/preprocess_interp.vibe {\n  expand_interp_stmts\n}\n\nimport ../wasi_only/preprocess_strip.vibe {\n  strip_generic_type_params\n}\n\nimport ../../../codegen/gc/backend_body.vibe {\n  compile_wasi_module_gc\n}\n\nimport ../../../core/ast.vibe {\n  Expr, Stmt\n}\n\n//# Functions\n\n// #683: test/bench-block lowering for the gc lane, mirroring the linear\n// backend's in-codegen rewrite (codegen/wasi/linked_compile.vibe): each\n// `test \"name\" { body }` becomes `let __test_name = () -> { body; 0 }`,\n// and when the requested entry does not exist (the `vibe test` sentinel\n// path) a `_start` running every test/bench function in order is\n// synthesized at the AST level. Returns the effective entry name. This is\n// what lets `VIBE_TEST_BACKEND=gc bash scripts/vibe_test.sh file` run a\n// *_test.vibe on the wasm-gc backend under wasmtime.\nlet lower_test_blocks_gc: (Array[Stmt], String) -> String with { Error } = (stmts, entry_name) -> {\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let empty_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let test_fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut has_entry = false\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, i, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, i, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(_, _, name, _, _) => if name == entry_name {\n        has_entry = true\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if has_entry || Array::length(test_fn_names) == 0 {\n    entry_name\n  } else {\n    // Synthesize `_start` calling each test/bench fn in declaration order.\n    let mut body = EInt(0)\n    let mut ti = Array::length(test_fn_names) - 1\n    while ti >= 0 {\n      body = ESeq(ECall(EIdent(Array::get(test_fn_names, ti), 0 - 1), Array::slice([\n        EUnit\n      ], 0, 0), 0 - 1), body)\n      ti = ti - 1\n    }\n    Array::push(stmts, SLet(true, false, \"_start\", None, EFn(empty_tp, empty_bounds, empty_params, None, None, body)))\n    \"_start\"\n  }\n}\n\n// #538 P4.5: the SAME source pipeline as compile_source_wasi_only — interp\n// expansion, check, trait-dict desugar, generic-param strip — in front of the\n// gc backend. The trait-dict desugar is what expands `a == b` on enum/struct\n// operands into the derived structural Eq walk (and Show's Int::to_string\n// etc.); without it the gc lane compared ctor POINTERS, so the gc-compiled\n// checker's Option/effect-row comparisons were silently wrong.\nexport let compile_source_gc_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  expand_interp_stmts(stmts)\n  // #683: lower test/bench blocks BEFORE the check so the synthesized\n  // `__test_*` lets and the no-entry `_start` runner are type-checked like\n  // ordinary functions (the linear lane checks STest bodies directly and\n  // rewrites inside codegen; pre-check rewriting is equivalent here).\n  let effective_entry = lower_test_blocks_gc(stmts, entry_name)\n  let _ = check_program(stmts)\n  // Same effective order as the linear lane: strip source-level generic\n  // params, then the trait-dict desugar (compile_wasi_module_linked_impl\n  // runs it as its first step).\n  strip_generic_type_params(stmts)\n  desugar_trait_dicts(stmts)\n  compile_wasi_module_gc(stmts, effective_entry)\n}\n")
}

let cli_adapter_source_146 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess.vibe",
"//# Imports\n\nexport ./preprocess_compile.vibe {\n  compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, compile_source_wasi_only_rc_shadow\n}\n\nexport ./preprocess_interp.vibe {\n  expand_interp_stmts\n}\n\nexport ./preprocess_strip.vibe {\n  strip_generic_type_params\n}\n\n//# Misc\n\nexport {\n  expand_interp_stmts, compile_source_wasi_only, compile_source_wasi_only_coverage, compile_source_wasi_only_rc, compile_source_wasi_only_rc_shadow, strip_generic_type_params\n}\n")
}

let cli_adapter_source_147 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_strip.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nexport let strip_generic_type_params: (Array[Stmt]) -> Unit = (stmts) -> {\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n")
}

let cli_adapter_source_148 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Stmt\n}\n\nimport ./preprocess_interp_rewrite.vibe {\n  rewrite_interp\n}\n\nimport .. / .. / .. / desugar_trait_dict.vibe {\n  desugar_trait_dicts\n}\n\n//# Functions\n\nexport let expand_interp_stmts: (Array[Stmt]) -> Unit with { Error } = (stmts) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n  // Method-bearing-trait dictionary passing (#641 PR-3). No-op unless the\n  // program declares a trait with method signatures.\n  desugar_trait_dicts(stmts)\n}\n")
}

let cli_adapter_source_149 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_parse.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr, Stmt\n}\n\nimport .. / .. / .. / syntax / parser.vibe {\n  parse_stmt\n}\n\nimport .. / .. / .. / syntax / token.vibe {\n  Token\n}\n\n//# Functions\n\nexport let parse_interp_expr: (Array[Token]) -> Expr with { Error } = (tokens) -> {\n  let (stmt, _) = parse_stmt(tokens, [], 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n")
}

