mit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let gc_gen_arr_len_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gc_gen_arr_new_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // #415: gc-lane heap bump must grow linear memory like the linear\n  // backend does -- without this any allocation past the initial page\n  // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// #538: real function bodies for Array::slice/concat/truncate/push_all. They\n// previously carried the placeholder table index (= arr_new), so any lookup\n// through the func table (e.g. the __slice container dispatch) called a\n// 0-arg allocator with values still on the stack -- invalid wasm. Built on\n// arr_new/arr_get/arr_push calls so they stay layout-agnostic.\n\n// (arr, start, end) -> new array of arr[start..end)\nexport let gc_gen_arr_slice_body: (Int, Int, Int) -> Bytes = (arr_new_idx, arr_get_idx, arr_push_idx) -> {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 3)\n  emit_local_get(b, 1)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 2)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 3)\n  b\n}\n\n// (a, b) -> new array of a's elements then b's\nexport let gc_gen_arr_concat_body: (Int, Int, Int, Int) -> Bytes = (arr_new_idx, arr_len_idx, arr_get_idx, arr_push_idx) -> {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 2)\n  emit_i64_const(b, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 3)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 1)\n  emit_call(b, arr_len_idx)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_local_get(b, 3)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 3)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 2)\n  b\n}\n\n// (arr, n): shrink in place (len@4 of the gc array header)\nexport let gc_gen_arr_truncate_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\n// (dst, src): append all of src to dst\nexport let gc_gen_arr_push_all_body: (Int, Int, Int) -> Bytes = (arr_len_idx, arr_get_idx, arr_push_idx) -> {\n  let b = bytebuf_new()\n  emit_i64_const(b, 0)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, arr_len_idx)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 2)\n  emit_call(b, arr_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n")
