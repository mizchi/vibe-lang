ile_expr(buf, body, local_names, nl1, ctx, ld + 1)\n    emit_drop(buf)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_i64_const(buf, 0)\n    nl2\n  } else if __tag == 20 {\n    emit_br(buf, ld + 1)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 21 {\n    emit_br(buf, ld)\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 22 {\n    emit_i64_const(buf, 0)\n    next_local\n  } else if __tag == 23 {\n    let msg_expr = get_ethrow_expr(expr)\n    let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)\n    // throw tag_0 (exception with i64 payload)\n    bytebuf_push(buf, 8)\n    bytebuf_push(buf, 0)\n    // tag index 0\n    nl\n  } else if __tag == 24 {\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else {\n    match expr {\n      EDot(obj, field) => {\n        let mut si_search = 0\n        let mut field_idx = -1\n        while si_search < Array::length(ctx.ctor_table.struct_names) {\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)\n          let mut fi = 0\n          while fi < Array::length(fnames) {\n            if Array::get(fnames, fi) == field {\n              field_idx = fi\n              fi = Array::length(fnames)\n            } else {\n              fi = fi + 1\n            }\n          }\n          if field_idx >= 0 {\n            si_search = Array::length(ctx.ctor_table.struct_names)\n          } else {\n            si_search = si_search + 1\n          }\n        }\n        if field_idx < 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + field_idx * 8)\n        nl1\n      },\n      ERecord(fields) => {\n        let flen = Array::length(fields)\n        let obj_size = 8 + flen * 8\n        let ptr_local = next_local\n        Array::push(local_names, \"__rec_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      },\n      EForIn(_, _, _, _) => throw(\"unsupported expression in codegen: EForIn\"),\n      EHandle(body, arms) => {\n        if Array::length(arms) > 0 {\n          let (catch_pat, fallback_expr) = Array::get(arms, 0)\n          // block $result (result i64)\n          emit_block_i64(buf)\n          // block $catch_land (i64) — catch jumps here with payload\n          emit_block_i64(buf)\n          // try_table (result i64) (catch 0 0)\n          bytebuf_push(buf, 31)\n          bytebuf_push(buf, 126)\n          bytebuf_push(buf, 1)\n          bytebuf_push(buf, 0)\n          bytebuf_push(buf, 0)\n          bytebuf_push(buf, 0)\n          // catch tag 0 → label 0 ($catch_land)\n          let nl1 = compile_expr(buf, body, local_names, next_local, ctx, ld)\n          emit_end(buf)\n          // end try_table — normal: i64 on stack\n          emit_br(buf, 1)\n          // br $result with body value\n          emit_end(buf)\n          // end $catch_land — catch payload (i64) on stack\n          // Bind catch payload to pattern variable if PBind or PCtor(Error, [PBind])\n          let nl_catch = if is_pctor(catch_pat) {\n            let cargs = get_pctor_args(catch_pat)\n            if Array::length(cargs) > 0 && is_pbind(Array::get(cargs, 0)) {\n              let pname = get_pbind_name(Array::get(cargs, 0))\n              let bl = Array::length(local_names)\n              emit_local_set(buf, bl)\n              Array::push(local_names, pname)\n              nl1\n            } else {\n              emit_drop(buf)\n              nl1\n            }\n          } else if is_pbind(catch_pat) {\n            let pname = get_pbind_name(catch_pat)\n            let bl = Array::length(local_names)\n            emit_local_set(buf, bl)\n            Array::push(local_names, pname)\n            nl1\n          } else {\n            emit_drop(buf)\n            nl1\n          }\n          let nl2 = compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\n          emit_end(buf)\n          // end $catch_handler\n          nl2\n        } else {\n          compile_expr(buf, body, local_names, next_local, ctx, ld)\n        }\n      }\n      ,\n      ELabeledArg(_, _, _) => throw(\"unsupported expression in codegen: ELabeledArg\"),\n      _ => throw(\"unsupported expression in codegen: unknown\")\n    }\n  }\n}\n\nexport let compile_module_expr = (stmts: Array[Stmt]) -> Bytes with { Error } {\n  let fresh_int_array = () -> Array[Int] {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_array = () -> Array[String] {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_expr_array = () -> Array[Expr] {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_int_matrix = () -> Array[Array[Int]] {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fresh_string_matrix = () -> Array[Array[String]] {\n    ArrayBuilder::freeze(ArrayBuilder::new())\n  }\n  let fn_names_list = fresh_string_array()\n  let fn_param_counts = fresh_int_array()\n  let export_names = fresh_string_array()\n  let export_indices = fresh_int_array()\n  let fn_bodies_list = fresh_expr_array()\n  let fn_param_names_list = fresh_string_matrix()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(is_export, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, body) => {\n          let cur_idx = Array::length(fn_names_list)\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_bodies_list, body)\n          let pnames = fresh_string_array()\n          let mut pi = 0\n          while pi < Array::length(params) {\n            let (pname, _) = Array::get(params, pi)\n            Array::push(pnames, pname)\n            pi = pi + 1\n          }\n          Array::push(fn_param_names_list, pnames)\n          if is_export {\n            Array::push(export_names, name)\n            Array::push(export_indices, cur_idx)\n          }\n          0\n        },\n        _ => 0\n      }\n      ,\n      _ => 0\n    }\n    i = i + 1\n  }\n  let num_funcs = Array::length(fn_names_list)\n  if num_funcs == 0 {\n    let out = bytebuf_new()\n    let empty_type_defs = fresh_int_array()\n    let empty_type_indices = fresh_int_array()\n    let empty_body = fresh_int_array()\n    let empty_bodies = fresh_int_matrix()\n    Array::push(empty_bodies, empty_body)\n    let empty_local_counts = fresh_int_array()\n    Array::push(empty_local_counts, 0)\n    emit_header(out)\n    emit_type_section_multi(out, empty_type_defs)\n    emit_function_section(out, empty_type_indices)\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\n    bytebuf_to_bytes(out)\n  } else {\n    let fn_indices_list = fresh_int_array()\n    let fn_returns_list = fresh_int_array()\n    let mut fi = 0\n    while fi < num_funcs {\n      Array::push(fn_indices_list, fi)\n      Array::push(fn_returns_list, 1)\n      fi = fi + 1\n    }\n    let type_defs = fresh_int_array()\n    let mut ti = 0\n    while ti < num_funcs {\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\n      Array::push(type_defs, 1)\n      ti = ti + 1\n    }\n    let type_indices = fresh_int_array()\n    let mut tii = 0\n    while tii < num_funcs {\n      Array::push(type_indices, tii)\n      tii = tii + 1\n    }\n    let lt_m = LambdaTable::{\n      bodies: fresh_int_matrix(),\n      param_counts: fresh_int_array(),\n      captures: fresh_string_matrix(),\n      meta_i32: fresh_int_array(),\n      meta_i64: fresh_int_array()\n    }\n    let bodies = fresh_int_matrix()\n    let local_counts = fresh_int_array()\n    let mut bi = 0\n    while bi < num_funcs {\n      let body = Array::get(fn_bodies_list, bi)\n      let param_names = Array::get(fn_param_names_list, bi)\n      let body_buf = bytebuf_new()\n      let local_names = fresh_string_array()\n      let mut pi = 0\n      while pi < Array::length(param_names) {\n        Array::push(local_names, Array::get(param_names, pi))\n        pi = pi + 1\n      }\n      let param_count = Array::length(param_names)\n      let empty_strs = fresh_string_array()\n      let empty_offs = fresh_int_array()\n      let empty_lens = fresh_int_array()\n      let empty_ref_cells = fresh_string_array()\n      let empty_ctor_names = fresh_string_array()\n      let empty_ctor_tags = fresh_int_array()\n      let empty_ctor_field_counts = fresh_int_array()\n      let empty_ctor_type_names = fresh_string_array()\n      let empty_ctor_struct_names = fresh_string_array()\n      let empty_ctor_struct_field_names = fresh_string_matrix()\n      let empty_thunk_names = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list\n        },\n        str_table: StrTable::{\n          strs: empty_strs, offsets: empty_offs, lengths: empty_lens\n        },\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: CtorTable::{\n          names: empty_ctor_names, tags: empty_ctor_tags, field_counts: empty_ctor_field_counts, type_names: empty_ctor_type_names, struct_names: empty_ctor_struct_names, struct_field_names: empty_ctor_struct_field_names\n        },\n        thunk_names: empty_thunk_names,\n        const_int_names: fresh_string_array(),\n        const_int_values: fresh_int_array()\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n")

  let source_20 = ("vibe/compiler/codegen/builtin_bodies/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport ../common_base/index.vibe {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport ../common_analysis/index.vibe {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\n// eq(a, b): first try i64 bitwise eq, then fall back to String::equals\nexport let gen_eq_body = (str_eq_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_i64_eq(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 1)\n  emit_else(b)\n  // Fallback: try string equality\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_end(b)\n  b\n}\n\n\nexport let gen_str_eq_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_ne(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 6)\n  emit_block_i64(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  // break to inner block_void\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_i64_const(b, 0)\n  // false\n  emit_br(b, 3)\n  // break to block_i64 with false\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 6)\n  emit_br(b, 0)\n  // continue loop\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, 1)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport let gen_arr_get_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  // 0x74 i32.shl\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 0)\n  b\n}\n\nexport let gen_arr_len_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  // header[4] = length\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gen_arr_new_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i3