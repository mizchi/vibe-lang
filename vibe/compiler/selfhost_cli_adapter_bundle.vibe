mit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let gc_gen_str_substring_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i64_sub(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_i64_or(b)\n  b\n}\n\nexport let gc_gen_str_char_code_at_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gc_gen_str_from_char_code_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 1)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_const(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, -8)\n  bytebuf_push(b, 113)\n  emit_global_set(b, 0)\n  // #415: gc-lane heap bump must grow linear memory like the linear\n  // backend does -- without this any allocation past the initial page\n  // traps OOB (the gc smoke fixture only ever allocated a few bytes).\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 1)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_i64_c