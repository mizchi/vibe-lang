it_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail5.vibe {\n  compile_expr_tail5\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  match expr {\n    EDot(obj, field) => {\n      let fc = String::char_code_at(field, 0)\n      let mut field_idx = if fc >= 48 && fc <= 57 {\n        let mut vi = 0\n        let mut vp = 0\n        while vp < String::length(field) {\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\n          vp = vp + 1\n        }\n        vi\n      } else {\n        let mut si_search = 0\n        let mut found = -1\n        while si_search < Array::length(ctx.ctor_table.struct_names) {\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)\n          let mut fi = 0\n          while fi < Array::length(fnames) {\n            if Array::get(fnames, fi) == field {\n              found = fi\n              fi = Array::length(fnames)\n            } else {\n              fi = fi + 1\n            }\n          }\n          if found >= 0 {\n            si_search = Array::length(ctx.ctor_table.struct_names)\n          } else {\n            si_search = si_search + 1\n          }\n        }\n        if found < 0 {\n          throw(String::concat(\"unknown struct field: \", field))\n        }\n        found\n      }\n      let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\n      if fc >= 48 && fc <= 57 {\n        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.\n        if ctx.enable_rc {\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n        }\n        emit_i32_wrap_i64(buf)\n        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.\n        let toff = if ctx.enable_rc {\n          8 + field_idx * 8\n        } else {\n          field_idx * 8\n        }\n        emit_i64_load(buf, 3, toff)\n      } else {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 8 + field_idx * 8)\n      }\n      nl1\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let ptr_local = next_local\n      Array::push(local_names, \"__rec_ptr\")\n      if ctx.enable_rc {\n        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):\n        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n        // The record value is (block_start+8) | 1 (records stay tagged), so the\n        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]\n        // [length@ptr+4] and field access stays at +8 (untag cancels the +8\n        // pointer shift). type_id 0 preserves the existing record read semantics.\n        let total = 16 + flen * 8\n        // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a\n        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same\n        // shape the recursive rc_drop loops.\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + ri * 8)\n          ri = ri + 1\n        }\n        // record value = (block_start + 8) | 1\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      } else {\n        let obj_size = 8 + flen * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, flen)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_r = next_local + 1\n        let mut ri = 0\n        while ri < flen {\n          let (_, fexpr) = Array::get(fields, ri)\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\n          let val_local = nl_r\n          Array::push(local_names, \"__rec_val\")\n          emit_local_set(buf, val_local)\n          nl_r = nl_r + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + ri * 8)\n          ri = ri + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_r\n      }\n    },\n    EMap(fields) => {\n      let flen = Array::length(fields)\n      let obj_size = 8 + flen * 2 * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__map_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_heap_grow_after_heap_set(buf, ctx)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, flen)\n      emit_i32_store(buf, 2, 0)\n      let mut nl_m = next_local + 1\n      let mut mi = 0\n      while mi < flen {\n        let (key, val_expr) = Array::get(fields, mi)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\n        if key_idx >= 0 {\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\n        } else {\n          emit_i64_const(buf, 0)\n        }\n        emit_i64_store(buf, 3, 8 + mi * 16)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\n        let val_local = nl_m\n        Array::push(local_names, \"__map_val\")\n        emit_local_set(buf, val_local)\n        nl_m = nl_m + 1\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\n        mi = mi + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl_m\n    },\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")
}

