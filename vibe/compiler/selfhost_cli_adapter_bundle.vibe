n\")\n      emit_local_set(buf, val_l)\n      emit_block_i64(buf)\n      if ts_arg_is_int {\n        // #678: the argument is statically a known Int (literal or int-bound\n        // local) — never run it through the string-pointer heuristic (a large\n        // int like `1 << 40` has a zero low word and an in-bounds high word, so\n        // it would be misread as an empty string). Force the integer path with\n        // a false (i32) condition — the heuristic below also yields an i32 bool.\n        emit_i32_const(buf, 0)\n      } else {\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 32)\n      bytebuf_push(buf, 136)\n      emit_local_tee(buf, abs_l)\n      emit_i64_const(buf, 64)\n      emit_i64_ge_s(buf)\n      emit_local_get(buf, abs_l)\n      // #606: a string is represented as (ptr << 32) | len, and `__to_string`\n      // returns the value unchanged when it looks like a string pointer. A\n      // string can live anywhere in linear memory — including the static data\n      // section (token / literal strings), whose offset is ABOVE the heap bump\n      // pointer during early compilation. The old bound `ptr < heap_ptr`\n      // (global 0) misclassified such strings as ints and stringified their raw\n      // i64, leaking a heap pointer (e.g. labeled param `x~` printed as\n      // `1285664100319233~`). Use the full linear-memory size (memory.size\n      // pages * 65536) as the upper bound so any in-bounds pointer is\n      // recognized; a small int still has a zero high word and takes the int\n      // path below.\n      bytebuf_push(buf, 63)\n      bytebuf_push(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_i64_const(buf, 65536)\n      emit_i64_mul(buf)\n      emit_i64_lt_s(buf)\n      bytebuf_push(buf, 113)\n      // #664: ALSO require the candidate string to FIT in linear memory:\n      // ptr + len <= memory_size. The `ptr < memory_size` bound above is not\n      // enough — a large integer (e.g. a 61-bit `Fs::stat_token`) whose HI