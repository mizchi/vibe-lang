al_get(b, 1)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 1)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_i64_const(b, 1)\n  emit_i64_or(b)\n  b\n}\n\nexport let gen_fs_write_bytes_stub_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  b\n}\n\nexport let gen_string_last_index_of_body = (str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 75)\n  // i32.gt_u\n  emit_if_i64(b)\n  emit_i64_const(b, -1)\n  emit_else(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_sub(b)\n  emit_local_set(b, 4)\n  emit_block_i64(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 0)\n  bytebuf_push(b, 72)\n  // i32.lt_s\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  emit_local_set(b, 5)\n  emit_local_get(b, 5)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_i32_wrap_i64(b)\n  emit_if_void(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_br(b, 3)\n  // br $found (past block $notfound + loop + if)\n  emit_end(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  // end loop\n  emit_end(b)\n  // end block $notfound\n  emit_i64_const(b, -1)\n  emit_end(b)\n  // end block $found\n  emit_end(b)\n  // end if\n  b\n}\n\nexport let gen_selfhost_sources_stub_body = (arr_new_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  b\n}\n\n//# Static pre-computed bodies (avoid emit_* call overhead)\n\nexport let static_eq_body = () -> Array[Int] {\n  Array::slice([32, 0, 32, 1, 81, 173], 0, 6)\n}\n\nexport let static_str_eq_body = () -> Array[Int] {\n  Array::slice([32, 0, 66, 255, 255, 255, 255, 15, 131, 167, 33, 2, 32, 1, 66, 255, 255, 255, 255, 15, 131, 167, 33, 3, 32, 2, 32, 3, 71, 4, 126, 66, 0, 5, 32, 0, 66, 32, 135, 167, 33, 4, 32, 1, 66, 32, 135, 167, 33, 5, 65, 0, 33, 6, 2, 126, 2, 64, 3, 64, 32, 6, 32, 2, 79, 13, 1, 32, 4, 32, 6, 106, 45, 0, 0, 32, 5, 32, 6, 106, 45, 0, 0, 71, 4, 64, 66, 0, 12, 3, 11, 32, 6, 65, 1, 106, 33, 6, 12, 0, 11, 11, 66, 1, 11, 11], 0, 106)\n}\n\nexport let static_arr_get_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 40, 2, 8, 33, 2, 32, 2, 32, 1, 167, 65, 3, 116, 106, 41, 3, 0], 0, 20)\n}\n\nexport let static_arr_len_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 40, 2, 4, 173], 0, 7)\n}\n\nexport let static_arr_new_body = () -> Array[Int] {\n  Array::slice([35, 0, 34, 0, 65, 204, 0, 106, 36, 0, 32, 0, 65, 8, 54, 2, 0, 32, 0, 65, 0, 54, 2, 4, 32, 0, 32, 0, 65, 12, 106, 54, 2, 8, 32, 0, 173], 0, 37)\n}\n\nexport let static_arr_set_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 40, 2, 8, 33, 3, 32, 3, 32, 1, 167, 65, 3, 116, 106, 32, 2, 55, 3, 0], 0, 22)\n}\n\nexport let static_str_len_body = () -> Array[Int] {\n  Array::slice([32, 0, 66, 255, 255, 255, 255, 15, 131], 0, 9)\n}\n\nexport let static_arr_push_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 33, 2, 32, 2, 40, 2, 0, 33, 3, 32, 2, 40, 2, 4, 33, 4, 32, 2, 40, 2, 8, 33, 5, 32, 4, 32, 3, 79, 4, 64, 32, 3, 65, 2, 108, 33, 7, 35, 0, 34, 6, 32, 7, 65, 8, 108, 106, 36, 0, 32, 6, 32, 5, 32, 4, 65, 8, 108, 252, 10, 0, 0, 32, 2, 32, 7, 54, 2, 0, 32, 2, 32, 6, 54, 2, 8, 32, 6, 33, 5, 11, 32, 5, 32, 4, 65, 3, 116, 106, 32, 1, 55, 3, 0, 32, 2, 32, 4, 65, 1, 106, 54, 2, 4], 0, 107)\n}\n\nexport let static_arr_push_all_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 33, 2, 32, 1, 167, 33, 3, 32, 2, 40, 2, 4, 33, 4, 32, 3, 40, 2, 4, 33, 5, 32, 2, 40, 2, 8, 33, 6, 32, 3, 40, 2, 8, 33, 7, 32, 2, 40, 2, 0, 33, 8, 32, 4, 32, 5, 106, 32, 8, 75, 4, 64, 32, 4, 32, 5, 106, 65, 2, 108, 33, 9, 35, 0, 34, 10, 32, 9, 65, 8, 108, 106, 36, 0, 32, 10, 32, 6, 32, 4, 65, 8, 108, 252, 10, 0, 0, 32, 2, 32, 9, 54, 2, 0, 32, 2, 32, 10, 54, 2, 8, 32, 10, 33, 6, 11, 32, 6, 32, 4, 65, 3, 116, 106, 32, 7, 32, 5, 65, 3, 116, 252, 10, 0, 0, 32, 2, 32, 4, 32, 5, 106, 54, 2, 4], 0, 138)\n}\n\nexport let static_identity_body = () -> Array[Int] {\n  Array::slice([32, 0], 0, 2)\n}\n\nexport let static_arr_slice_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 33, 3, 32, 3, 40, 2, 8, 33, 4, 32, 2, 167, 32, 1, 167, 107, 33, 5, 32, 5, 65, 8, 106, 33, 8, 35, 0, 34, 6, 65, 12, 32, 8, 65, 3, 116, 106, 106, 36, 0, 32, 6, 32, 8, 54, 2, 0, 32, 6, 32, 5, 54, 2, 4, 32, 6, 65, 12, 106, 33, 7, 32, 6, 32, 7, 54, 2, 8, 32, 7, 32, 4, 32, 1, 167, 65, 3, 116, 106, 32, 5, 65, 3, 116, 252, 10, 0, 0, 32, 6, 173], 0, 94)\n}\n\nexport let static_print_i64_body = () -> Array[Int] {\n  Array::slice([65, 46, 33, 2, 65, 47, 65, 10, 58, 0, 0, 32, 0, 66, 0, 83, 33, 1, 32, 1, 4, 126, 66, 0, 32, 0, 125, 5, 32, 0, 11, 33, 4, 32, 4, 80, 4, 64, 32, 2, 65, 48, 58, 0, 0, 32, 2, 65, 1, 107, 33, 2, 11, 2, 64, 3, 64, 32, 4, 80, 13, 1, 32, 4, 66, 10, 129, 167, 33, 3, 32, 2, 32, 3, 65, 48, 106, 58, 0, 0, 32, 2, 65, 1, 107, 33, 2, 32, 4, 66, 10, 127, 33, 4, 12, 0, 11, 11, 32, 1, 4, 64, 32, 2, 65, 45, 58, 0, 0, 32, 2, 65, 1, 107, 33, 2, 11, 65, 0, 32, 2, 65, 1, 106, 54, 2, 0, 65, 4, 65, 47, 32, 2, 107, 54, 2, 0, 65, 1, 65, 0, 65, 1, 65, 8, 16, 0, 26], 0, 148)\n}\n\nexport let static_print_str_body = () -> Array[Int] {\n  Array::slice([32, 0, 66, 32, 135, 167, 33, 1, 32, 0, 167, 33, 2, 65, 0, 32, 1, 54, 2, 0, 65, 4, 32, 2, 54, 2, 0, 65, 1, 65, 0, 65, 1, 65, 8, 16, 0, 26], 0, 38)\n}\n\nexport let static_arr_concat_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 33, 2, 32, 1, 167, 33, 3, 32, 2, 40, 2, 4, 33, 4, 32, 3, 40, 2, 4, 33, 5, 32, 2, 40, 2, 8, 33, 6, 32, 3, 40, 2, 8, 33, 7, 32, 4, 32, 5, 106, 33, 8, 35, 0, 34, 9, 65, 12, 32, 8, 65, 3, 116, 106, 106, 36, 0, 32, 9, 32, 8, 54, 2, 0, 32, 9, 32, 8, 54, 2, 4, 32, 9, 65, 12, 106, 33, 10, 32, 9, 32, 10, 54, 2, 8, 32, 10, 32, 6, 32, 4, 65, 3, 116, 252, 10, 0, 0, 32, 10, 32, 4, 65, 3, 116, 106, 32, 7, 32, 5, 65, 3, 116, 252, 10, 0, 0, 32, 9, 173], 0, 123)\n}\n\nexport let static_str_concat_body = () -> Array[Int] {\n  Array::slice([32, 0, 66, 255, 255, 255, 255, 15, 131, 167, 33, 2, 32, 1, 66, 255, 255, 255, 255, 15, 131, 167, 33, 3, 32, 0, 66, 32, 135, 167, 33, 4, 32, 1, 66, 32, 135, 167, 33, 5, 32, 2, 32, 3, 106, 33, 7, 35, 0, 34, 6, 32, 7, 106, 36, 0, 32, 6, 32, 4, 32, 2, 252, 10, 0, 0, 32, 6, 32, 2, 106, 32, 5, 32, 3, 252, 10, 0, 0, 32, 6, 173, 66, 32, 134, 32, 7, 173, 132], 0, 89)\n}\n\nexport let static_arr_truncate_body = () -> Array[Int] {\n  Array::slice([32, 0, 167, 32, 1, 167, 54, 2, 4], 0, 9)\n}\n\nexport let static_double_to_int_body = () -> Array[Int] {\n  Array::slice([32, 0, 191, 176], 0, 4)\n}\n\nexport let static_int_to_double_body = () -> Array[Int] {\n  Array::slice([32, 0, 185, 189], 0, 4)\n}\n\nexport let static_str_substring_body = () -> Array[Int] {\n  Array::slice([32, 0, 66, 32, 135, 167, 33, 3, 32, 2, 32, 1, 125, 167, 33, 4, 32, 3, 32, 1, 167, 106, 173, 66, 32, 134, 32, 4, 173, 132], 0, 30)\n}\n\nexport let static_str_char_code_at_body = () -> Array[Int] {\n  Array::slice([32, 0, 66, 32, 135, 167, 33, 2, 32, 2, 32, 1, 167, 106, 45, 0, 0, 173], 0, 18)\n}\n\nexport let static_fs_stub_body = () -> Array[Int] {\n  Array::slice([66, 0], 0, 2)\n}\n\nexport let static_str_from_char_code_body = () -> Array[Int] {\n  Array::slice([35, 0, 34, 1, 65, 1, 106, 36, 0, 32, 1, 32, 0, 167, 58, 0, 0, 32, 1, 173, 66, 32, 134, 66, 1, 132], 0, 26)\n}\n\nexport let static_fs_write_bytes_stub_body = () -> Array[Int] {\n  Array::slice([0], 0, 0)\n}\n\n// String::index_of(haystack, needle) -> Int (-1 if not found)\n// Forward scan version of last_index_of\nexport let gen_string_index_of_body = (str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  // local 2 = len_haystack, local 3 = len_needle, local 4 = i, local 5 = sub\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 75)\n  // i32.gt_u\n  emit_if_i64(b)\n  emit_i64_const(b, -1)\n  emit_else(b)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  emit_local_get(b, 2)\n  emit_local_get(b, 3)\n  emit_i32_sub(b)\n  emit_local_set(b, 2)\n  // local 2 = max_offset\n  emit_block_i64(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 75)\n  // i32.gt_u (if i > max_offset, break)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  emit_local_set(b, 5)\n  emit_local_get(b, 5)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_i32_wrap_i64(b)\n  emit_if_void(b)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_br(b, 3)\n  emit_end(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, -1)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\n// String::contains(haystack, needle) -> Bool\n// Delegates to index_of >= 0\nexport let gen_string_contains_body = (string_index_of_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, string_index_of_idx)\n  emit_i64_const(b, 0)\n  emit_i64_ge_s(b)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\n// String::starts_with(s, prefix) -> Bool\n// Delegates to substring + equals\nexport let gen_string_starts_with_body = (str_len_idx: Int, str_substring_idx: Int, str_eq_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  // local 2 = len_s, local 3 = len_prefix, local 4 = sub\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 75)\n  // i32.gt_u\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  // false\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  emit_local_set(b, 4)\n  emit_local_get(b, 4)\n  emit_local_get(b, 1)\n  emit_call(b, str_eq_idx)\n  emit_end(b)\n  b\n}\n\n// String::split(s, sep) -> Array[String]\n// Uses arr_new, arr_push, str_len, str_substring, string_index_of\nexport let gen_string_split_body = (arr_new_idx: Int, arr_push_idx: Int, str_len_idx: Int, str_substring_idx: Int, string_index_of_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  // locals: 0=s(i64), 1=sep(i64), 2=s_len(i32), 3=sep_len(i32), 4=start(i32), 5=idx(i32), 6=arr(i64)\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 6)\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 4)\n  // loop\n  emit_block_void(b)\n  emit_loop_void(b)\n  // idx = index_of(substring(s, start, s_len), sep)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  emit_local_get(b, 1)\n  emit_call(b, string_index_of_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  // if idx < 0, break\n  emit_local_get(b, 5)\n  emit_i32_const(b, 0)\n  bytebuf_push(b, 72)\n  // i32.lt_s\n  emit_br_if(b, 1)\n  // push substring(s, start, start + idx)\n  emit_local_get(b, 6)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  emit_call(b, arr_push_idx)\n  // start = start + idx + sep_len\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_local_get(b, 3)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // push remaining: substring(s, start, s_len)\n  emit_local_get(b, 6)\n  emit_local_get(b, 0)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 6)\n  b\n}\n\n// String::trim(s) -> String\n// Scans whitespace from both ends, returns substring\nexport let gen_string_trim_body = (str_len_idx: Int, str_char_code_at_idx: Int, str_substring_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  // locals: 0=s, 1=len, 2=start, 3=end\n  emit_local_get(b, 0)\n  emit_call(b, str_len_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_local_get(b, 1)\n  emit_local_set(b, 3)\n  // scan start forward while whitespace\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_char_code_at_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_tee(b, 4)\n  // check if whitespace: 32=' ', 9=tab, 10=lf, 13=cr\n  emit_i32_const(b, 32)\n  emit_i32_eq(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 9)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  // i32.or\n  emit_local_get(b, 4)\n  emit_i32_const(b, 10)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  // i32.or\n  emit_local_get(b, 4)\n  emit_i32_const(b, 13)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  // i32.or\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // scan end backward while whitespace\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  bytebuf_push(b, 76)\n  // i32.le_u\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_char_code_at_idx)\n  emit_i32_wrap_i64(b)\n  emit_local_tee(b, 4)\n  emit_i32_const(b, 32)\n  emit_i32_eq(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 9)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 10)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 13)\n  emit_i32_eq(b)\n  bytebuf_push(b, 114)\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_sub(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // return substring(s, start, end)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  emit_call(b, str_substring_idx)\n  b\n}\n\nexport let gen_selfhost_sources_proper_body = (num_sources: Int, str_offsets: Array[Int], str_lengths: Array[Int], src_str_base: Int, arr_new_idx: Int, arr_push_idx: Int) -> Array[Int] {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  // arr_new -> i64\n  emit_local_set(b, 1)\n  // local 1 (i64) = array\n  let mut si = 0\n  while si < num_sources {\n    let path_idx = src_str_base + si * 2\n    let content_idx = src_str_base + si * 2 + 1\n    let path_off = Array::get(str_offsets, path_idx)\n    let path_len = Array::get(str_lengths, path_idx)\n    let content_off = Array::get(str_offsets, content_idx)\n    let content_len = Array::get(str_lengths, content_idx)\n    emit_global_get(b, 0)\n    // heap_ptr (i32)\n    emit_local_tee(b, 0)\n    // local 0 (i32) = tuple_ptr\n    emit_i32_const(b, 16)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    // heap_ptr += 16\n    emit_local_get(b, 0)\n    let path_ref = (path_off<<32)|path_len\n    emit_i64_const(b, path_ref)\n    emit_i64_store(b, 3, 0)\n    emit_local_get(b, 0)\n    let content_ref = (content_off<<32)|content_len\n    emit_i64_const(b, content_ref)\n    emit_i64_store(b, 3, 8)\n    emit_local_get(b, 1)\n    // array ref (i64)\n    emit_local_get(b, 0)\n    // tuple_ptr (i32)\n    emit_i64_extend_i32_u(b)\n    // extend to i64\n    emit_call(b, arr_push_idx)\n    // arr_push(i64, i64)\n    si = si + 1\n  }\n  emit_local_get(b, 1)\n  b\n}\n")

  let source_21 = ("vibe/compiler/codegen/wasi/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport ../common_base/index.vibe {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport ../common_analysis/index.vibe {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ../expr/index.vibe {\n  compile_expr\n}\n\nimport ../builtin_bodies/index.vibe {\n  gen_string_join_body, gen_string_ends_with_body, gen_string_last_index_of_body, gen_string_index_of_body, gen_string_contains_body, gen_string_starts_with_body, gen_string_split_body, gen_string_trim_body, gen_selfhost_sources_stub_body, gen_selfhost_sources_proper_body,\n  gen_eq_body, static_str_eq_body, static_arr_get_body, static_arr_len_body, static_arr_new_body, static_arr_set_body, static_str_len_body, static_arr_push_body, static_arr_push_all_body, static_identity_body, static_arr_slice_body, static_print_i64_body, static_print_str_body, static_arr_concat_body, static_str_concat_body, static_arr_truncate_body, static_double_to_int_body, static_int_to_double_body, static_str_substring_body, static_str_char_code_at_body, static_fs_stub_body, static_str_from_char_code_body, static_fs_write_bytes_stub_body\n}\n\n//# Functions\n\nlet expr_uses_builtin = (expr: Expr, fn_names: Array[String], target: String) -> Bool {\n  let free_vars = collect_free_vars(expr, Array::slice([\n    \"\"\n  ], 0, 0), fn_names)\n  array_contains_str(free_vars, target)\n}\n\nlet rec stmts_use_builtin = (stmts: Array[Stmt], fn_names: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) && !found {\n    found = match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\n      _ => false\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport let compile_wasi_module_with_sources_impl = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\n  let fn_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_param_counts = Array::slice([\n    0\n  ], 0, 0)\n  let fn_stmt_indices = Array::slice([\n    0\n  ], 0, 0)\n  let thunk_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let const_int_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let const_int_values_list = Array::slice([\n    0\n  ], 0, 0)\n  let export_fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let export_fn_user_indices = Array::slice([\n    0\n  ], 0, 0)\n  // Preprocess: convert STest to SLet with EFn wrapper\n  let test_fn_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_tp = Array::slice([\"\"], 0, 0)\n  let empty_bounds = Array::slice([(\"\", Array::slice([\"\"], 0, 0))], 0, 0)\n  let empty_params = Array::slice([(\"\", None)], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  // If tests exist and no explicit entry, generate a run function calling all tests\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name { has_entry = true },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      let mut test_body = EInt(0)\n      let mut ti = Array::length(test_fn_names) - 1\n      while ti >= 0 {\n        let tname = Array::get(test_fn_names, ti)\n        test_body = ESeq(ECall(EIdent(tname), Array::slice([EUnit], 0, 0)), test_body)\n        ti = ti - 1\n      }\n      Array::push(stmts, SLet(true, false, entry_name, None, EFn(empty_tp, empty_bounds, empty_params, None, None, test_body)))\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (expr_tag(expr) == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  // type 0 = Option\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let struct_field_names = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        Array::push(struct_names, sname)\n        let fnames = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(String::concat(\"entry function not found: \", entry_name))\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = Array::slice([\n    0\n  ], 0, 0)\n  let str_lengths = Array::slice([\n    0\n  ], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::get\")\n  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\")\n  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\")\n  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\")\n  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\")\n  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\")\n  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let num_imported_funcs = next_import_idx\n  let print_int_idx = num_imported_funcs\n  let print_str_idx = print_int_idx + 1\n  let str_len_idx = print_str_idx + 1\n  let str_eq_idx = str_len_idx + 1\n  let str_concat_idx = str_eq_idx + 1\n  let arr_new_idx = str_concat_idx + 1\n  let arr_len_idx = arr_new_idx + 1\n  let arr_get_idx = arr_len_idx + 1\n  let arr_push_idx = arr_get_idx + 1\n  let arr_set_idx = arr_push_idx + 1\n  let double_to_int_idx = arr_set_idx + 1\n  let int_to_double_idx = double_to_int_idx + 1\n  let str_char_code_at_idx = int_to_double_idx + 1\n  let str_from_char_code_idx = str_char_code_at_idx + 1\n  let str_substring_idx = str_from_char_code_idx + 1\n  let identity_idx = str_substring_idx + 1\n  let arr_slice_idx = identity_idx + 1\n  let arr_concat_idx = arr_slice_idx + 1\n  let arr_truncate_idx = arr_concat_idx + 1\n  let string_join_idx = arr_truncate_idx + 1\n  let fs_read_file_stub_idx = string_join_idx + 1\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\n  let fs_write_bytes_stub_idx = fs_stat_token_stub_idx + 1\n  let eq_idx = fs_write_bytes_stub_idx + 1\n  let string_ends_with_idx = eq_idx + 1\n  let string_last_index_of_idx = string_ends_with_idx + 1\n  let arr_push_all_idx = string_last_index_of_idx + 1\n  let string_index_of_idx = arr_push_all_idx + 1\n  let string_contains_idx = string_index_of_idx + 1\n  let string_starts_with_idx = string_contains_idx + 1\n  let string_split_idx = string_starts_with_idx + 1\n  let string_trim_idx = string_split_idx + 1\n  let selfhost_sources_idx = string_trim_idx + 1\n  let env_get_idx = if env_get_import_idx >= 0 { env_get_import_idx } else { fs_read_file_stub_idx }\n  let env_args_len_idx = if env_args_len_import_idx >= 0 { env_args_len_import_idx } else { fs_exists_stub_idx }\n  let env_args_get_idx = if env_args_get_import_idx >= 0 { env_args_get_import_idx } else { fs_read_file_stub_idx }\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 { fs_read_file_import_idx } else { fs_read_file_stub_idx }\n  let fs_exists_idx = if fs_exists_import_idx >= 0 { fs_exists_import_idx } else { fs_exists_stub_idx }\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 { fs_stat_token_import_idx } else { fs_stat_token_stub_idx }\n  let fs_write_bytes_idx = if fs_write_bytes_import_idx >= 0 { fs_write_bytes_import_idx } else { fs_write_bytes_stub_idx }\n  let builtin_defs = [\n    (\"Env::get\", 1, env_get_idx, 1),\n    (\"Env::args_len\", 0, env_args_len_idx, 1),\n    (\"Env::args_get\", 1, env_args_get_idx, 1),\n    (\"Fs::read_file\", 1, fs_read_file_idx, 1),\n    (\"Fs::exists\", 1, fs_exists_idx, 1),\n    (\"Fs::stat_token\", 1, fs_stat_token_idx, 1),\n    (\"Fs::write_bytes\", 2, fs_write_bytes_idx, 0),\n    (\"print_int\", 1, print_int_idx, 0),\n    (\"print_str\", 1, print_str_idx, 0),\n    (\"String::length\", 1, str_len_idx, 1),\n    (\"String::equals\", 2, str_eq_idx, 1),\n    (\"String::concat\", 2, str_concat_idx, 1),\n    (\"array_new\", 0, arr_new_idx, 1),\n    (\"Array::length\", 1, arr_len_idx, 1),\n    (\"Array::get\", 2, arr_get_idx, 1),\n    (\"Array::push\", 2, arr_push_idx, 0),\n    (\"Array::push_all\", 2, arr_push_all_idx, 0),\n    (\"Array::set\", 3, arr_set_idx, 0),\n    (\"Double::to_int\", 1, double_to_int_idx, 1),\n    (\"Int::to_double\", 1, int_to_double_idx, 1),\n    (\"String::char_code_at\", 2, str_char_code_at_idx, 1),\n    (\"String::from_char_code\", 1, str_from_char_code_idx, 1),\n    (\"String::substring\", 3, str_substring_idx, 1),\n    (\"Array::truncate\", 2, arr_truncate_idx, 0),\n    (\"String::join\", 2, string_join_idx, 1),\n    (\"eq\", 2, eq_idx, 1),\n    (\"String::ends_with\", 2, string_ends_with_idx, 1),\n    (\"String::last_index_of\", 2, string_last_index_of_idx, 1),\n    (\"String::index_of\", 2, string_index_of_idx, 1),\n    (\"String::contains\", 2, string_contains_idx, 1),\n    (\"String::starts_with\", 2, string_starts_with_idx, 1),\n    (\"String::split\", 2, string_split_idx, 1),\n    (\"String::trim\", 1, string_trim_idx, 1),\n    (\"selfhost_sources\", 0, selfhost_sources_idx, 1),\n    (\"ArrayBuilder::new\", 0, arr_new_idx, 1),\n    (\"ArrayBuilder::push\", 2, arr_push_idx, 0),\n    (\"ArrayBuilder::freeze\", 1, identity_idx, 1),\n    (\"Array::slice\", 3, arr_slice_idx, 1),\n    (\"Array::concat\", 2, arr_concat_idx, 1),\n    (\"Bytes::from_array\", 1, identity_idx, 1),\n    (\"Bytes::length\", 1, arr_len_idx, 1),\n    (\"Bytes::get\", 2, arr_get_idx, 1),\n    (\"Double::to_i64_bits\", 1, identity_idx, 1)\n  ]\n  let mut max_builtin_func_idx = num_imported_funcs - 1\n  let mut builtin_idx_i = 0\n  while builtin_idx_i < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, _) = Array::get(builtin_defs, builtin_idx_i)\n    if bwasm_idx > max_builtin_func_idx {\n      max_builtin_func_idx = bwasm_idx\n    }\n    builtin_idx_i = builtin_idx_i + 1\n  }\n  let num_generated = (max_builtin_func_idx - num_imported_funcs) + 1\n  let func_offset = num_imported_funcs + num_generated\n  let mut __bi = 0\n  while __bi < Array::length(builtin_defs) {\n    let (bname, bparams, _, _) = Array::get(builtin_defs, __bi)\n    Array::push(fn_names_list, bname)\n    Array::push(fn_param_counts, bparams)\n    __bi = __bi + 1\n  }\n  let fn_indices_list = Array::slice([\n    0\n  ], 0, 0)\n  let fn_returns_list = Array::slice([\n    0\n  ], 0, 0)\n  let mut fi = 0\n  while fi < num_user_funcs {\n    Array::push(fn_indices_list, fi + func_offset)\n    Array::push(fn_returns_list, 1)\n    fi = fi + 1\n  }\n  let mut __bi2 = 0\n  while __bi2 < Array::length(builtin_defs) {\n    let (_, _, bwasm_idx, breturns) = Array::get(builtin_defs, __bi2)\n    Array::push(fn_indices_list, bwasm_idx)\n    Array::push(fn_returns_list, breturns)\n    __bi2 = __bi2 + 1\n  }\n  let num_base_types = 9\n  let lt_w = LambdaTable::{\n    bodies: Array::slice([\n      Array::slice([\n        0\n      ], 0, 0)\n    ], 0, 0),\n    param_counts: Array::slice([\n      0\n    ], 0, 0),\n    captures: Array::slice([\n      Array::slice([\n        \"\"\n      ], 0, 0)\n    ], 0, 0),\n    meta_i32: Array::slice([\n      0\n    ], 0, 0),\n    meta_i64: Array::slice([\n      0\n    ], 0, 0)\n  }\n  let bodies = Array::slice([\n    Array::slice([\n      0\n    ], 0, 0)\n  ], 0, 0)\n  let meta_i32 = Array::slice([\n    0\n  ], 0, 0)\n  let meta_i64 = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(bodies, static_print_i64_body())\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, static_print_str_body())\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_str_len_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_str_eq_body())\n  Array::push(meta_i32, 5)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_str_concat_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_new_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_len_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_get_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_push_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_set_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_double_to_int_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_int_to_double_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_str_char_code_at_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_str_from_char_code_body())\n  Array::push(meta_i32, 1)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_str_substring_body())\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_identity_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_slice_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_concat_body())\n  Array::push(meta_i32, 9)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_arr_truncate_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_string_join_body(arr_len_idx, arr_get_idx, str_concat_idx))\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 2)\n  Array::push(bodies, static_fs_stub_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_fs_stub_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_fs_stub_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, static_fs_write_bytes_stub_body())\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_eq_body(str_eq_idx))\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_string_ends_with_body(str_len_idx, str_substring_idx, str_eq_idx))\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_string_last_index_of_body(str_len_idx, str_substring_idx, str_eq_idx))\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, static_arr_push_all_body())\n  Array::push(meta_i32, 9)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_string_index_of_body(str_len_idx, str_substring_idx, str_eq_idx))\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_string_contains_body(string_index_of_idx))\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_string_starts_with_body(str_len_idx, str_substring_idx, str_eq_idx))\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_string_split_body(arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx))\n  Array::push(meta_i32, 4)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, gen_string_trim_body(str_len_idx, str_char_code_at_idx, str_substring_idx))\n  Array::push(meta_i32, 4)\n  Array::push(meta_i64, 0)\n  if num_src_pairs > 0 {\n    Array::push(bodies, gen_selfhost_sources_proper_body(num_src_pairs, str_offsets, str_lengths, src_str_base, arr_new_idx, arr_push_idx))\n    Array::push(meta_i32, 1)\n    // 1 i32 local (tuple ptr)\n    Array::push(meta_i64, 1)\n    // 1 i64 local (array ref)\n  } else {\n    Array::push(bodies, gen_selfhost_sources_stub_body(arr_new_idx))\n    Array::push(meta_i32, 0)\n    Array::push(meta_i64, 0)\n  }\n  let mut bi = 0\n  while bi < num_user_funcs {\n    let __bi_stmt = Array::get(stmts, Array::get(fn_stmt_indices, bi))\n    let __bi_expr = get_slet_expr(__bi_stmt)\n    let body_buf = bytebuf_new()\n    let local_names = Array::slice([\n      \"\"\n    ], 0, 0)\n    let fn_name_dbg = Array::get(fn_names_list, bi)\n    let compile_ctx = CompileCtx::{\n      func_table: FuncTable::{\n        names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list\n      },\n      str_table: StrTable::{\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\n      },\n      lambda_table: lt_w,\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\n      ref_cell_names: Array::slice([\n        \"\"\n      ], 0, 0),\n      ctor_table: CtorTable::{\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\n      },\n      thunk_names: thunk_names_list,\n      const_int_names: const_int_names_list,\n      const_int_values: const_int_values_list\n    }\n    if is_efn(__bi_expr) {\n      let __bi_params = get_efn_params(__bi_expr)\n      let body = get_efn_body(__bi_expr)\n      let mut pi = 0\n      while pi < Array::length(__bi_params) {\n        let (pname, _) = Array::get(__bi_params, pi)\n        Array::push(local_names, pname)\n        pi = pi + 1\n      }\n      Array::push(local_names, \"__env\")\n      let param_count = Array::length(__bi_params) + 1\n      // includes __env\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    } else {\n      Array::push(local_names, \"__env\")\n      let param_count = 1\n      // just __env\n      let final_nl = compile_expr(body_buf, __bi_expr, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(meta_i32, 0)\n      Array::push(meta_i64, extra)\n    }\n    bi = bi + 1\n  }\n  let num_lambdas = Array::length(lt_w.bodies)\n  let start_body = bytebuf_new()\n  let entry_func_idx = entry_user_idx + func_offset\n  let entry_params = Array::get(fn_param_counts, entry_user_idx)\n  if entry_params != 0 {\n    throw(\"WASI entry function must take 0 parameters\")\n  }\n  emit_i64_const(start_body, 0)\n  // env=0 for user func\n  emit_call(start_body, entry_func_idx)\n  emit_call(start_body, print_int_idx)\n  // __print_i64\n  Array::push(bodies, start_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let run_body = bytebuf_new()\n  emit_i64_const(run_body, 0)\n  // env=0 for user func; run returns the entry result for host-driven execution.\n  emit_call(run_body, entry_func_idx)\n  Array::push(bodies, run_body)\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  let mut li = 0\n  while li < num_lambdas {\n    Array::push(bodies, Array::get(lt_w.bodies, li))\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\n    li = li + 1\n  }\n  let mut max_closure_arity = -1\n  let mut lai = 0\n  while lai < num_lambdas {\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\n    // user_params = total - 1 (env)\n    if lpc > max_closure_arity {\n      max_closure_arity = lpc\n    }\n    lai = lai + 1\n  }\n  let mut uai = 0\n  while uai < num_user_funcs {\n    let upc = Array::get(fn_param_counts, uai)\n    if upc > max_closure_arity {\n      max_closure_arity = upc\n    }\n    uai = uai + 1\n  }\n  let num_closure_types = if max_closure_arity >= 0 {\n    max_closure_arity + 1\n  } else {\n    0\n  }\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\n  emit_func_type_raw(type_content, [\n    127,\n    127,\n    127,\n    127\n  ], [\n    127\n  ])\n  // type 0: fd_write\n  emit_func_type_raw(type_content, [\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  // type 1: (i64)->()\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), Array::slice([\n    0\n  ], 0, 0))\n  // type 2: ()->()\n  emit_func_type_raw(type_content, [\n    126\n  ], [\n    126\n  ])\n  // type 3: (i64)->(i64)\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], [\n    126\n  ])\n  // type 4: (i64,i64)->(i64)\n  emit_func_type_raw(type_content, Array::slice([\n    0\n  ], 0, 0), [\n    126\n  ])\n  // type 5: ()->(i64)\n  emit_func_type_raw(type_content, [\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  // type 6: (i64,i64)->()\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], Array::slice([\n    0\n  ], 0, 0))\n  // type 7: (i64,i64,i64)->()\n  emit_func_type_raw(type_content, [\n    126,\n    126,\n    126\n  ], [\n    126\n  ])\n  // type 8: (i64,i64,i64)->(i64)\n  let mut cti = 0\n  while cti < num_closure_types {\n    let num_params = cti + 1\n    // N user params + 1 env\n    let ct_params = Array::slice([\n      0\n    ], 0, 0)\n    let mut cpti = 0\n    while cpti < num_params {\n      Array::push(ct_params, 126)\n      cpti = cpti + 1\n    }\n    emit_func_type_raw(type_content, ct_params, [\n      126\n    ])\n    cti = cti + 1\n  }\n  let out = bytebuf_new()\n  emit_header(out)\n  bytebuf_push_section(out, 1, type_content)\n  let import_content = bytebuf_new()\n  bytebuf_push_vec_header(import_content, num_imported_funcs)\n  emit_name(import_content, \"wasi_snapshot_preview1\")\n  emit_name(import_content, \"fd_write\")\n  bytebuf_push(import_content, 0)\n  leb128_encode_u32(import_content, 0)\n  if env_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"env-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if env_args_len_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-len\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 5)\n  }\n  if env_args_get_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"args-get\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_read_file_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_read_file\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_exists_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_exists\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_stat_token_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_stat_token\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 3)\n  }\n  if fs_write_bytes_import_idx >= 0 {\n    emit_name(import_content, \"vibe\")\n    emit_name(import_content, \"fs_write_bytes\")\n    bytebuf_push(import_content, 0)\n    leb128_encode_u32(import_content, 6)\n  }\n  bytebuf_push_section(out, 2, import_content)\n  let func_type_indices = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(func_type_indices, 1)\n  // __print_i64\n  Array::push(func_type_indices, 1)\n  // __print_str\n  Array::push(func_type_indices, 3)\n  // __str_len\n  Array::push(func_type_indices, 4)\n  // __str_eq\n  Array::push(func_type_indices, 4)\n  // __str_concat\n  Array::push(func_type_indices, 5)\n  // __arr_new\n  Array::push(func_type_indices, 3)\n  // __arr_len\n  Array::push(func_type_indices, 4)\n  // __arr_get\n  Array::push(func_type_indices, 6)\n  // __arr_push\n  Array::push(func_type_indices, 7)\n  // __arr_set\n  Array::push(func_type_indices, 3)\n  // __double_to_int\n  Array::push(func_type_indices, 3)\n  // __int_to_double\n  Array::push(func_type_indices, 4)\n  // __str_char_code_at\n  Array::push(func_type_indices, 3)\n  // __str_from_char_code\n  Array::push(func_type_indices, 8)\n  // __str_substring\n  Array::push(func_type_indices, 3)\n  // __identity (ArrayBuilder::freeze)\n  Array::push(func_type_indices, 8)\n  // __arr_slice (i64,i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __arr_concat (i64,i64) -> (i64)\n  Array::push(func_type_indices, 6)\n  // __arr_truncate (i64,i64) -> ()\n  Array::push(func_type_indices, 4)\n  // __string_join (i64,i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __fs_read_file_stub (i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __fs_exists_stub (i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __fs_stat_token_stub (i64) -> (i64)\n  Array::push(func_type_indices, 6)\n  // __fs_write_bytes_stub (i64,i64) -> ()\n  Array::push(func_type_indices, 4)\n  // __eq (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_ends_with (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_last_index_of (i64,i64) -> (i64)\n  Array::push(func_type_indices, 6)\n  // __arr_push_all (i64,i64) -> ()\n  Array::push(func_type_indices, 4)\n  // __string_index_of (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_contains (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_starts_with (i64,i64) -> (i64)\n  Array::push(func_type_indices, 4)\n  // __string_split (i64,i64) -> (i64)\n  Array::push(func_type_indices, 3)\n  // __string_trim (i64) -> (i64)\n  Array::push(func_type_indices, 5)\n  // __selfhost_sources_stub () -> (i64)\n  let mut fti = 0\n  while fti < num_user_funcs {\n    let upc = Array::get(fn_param_counts, fti)\n    Array::push(func_type_indices, num_base_types + upc)\n    fti = fti + 1\n  }\n  Array::push(func_type_indices, 2)\n  // _start () -> ()\n  Array::push(func_type_indices, 5)\n  // run () -> (i64)\n  let mut lfi = 0\n  while lfi < num_lambdas {\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\n    Array::push(func_type_indices, num_base_types + lam_user_params)\n    lfi = lfi + 1\n  }\n  emit_function_section(out, func_type_indices)\n  let total_table_entries = num_user_funcs + num_lambdas\n  if total_table_entries > 0 {\n    emit_table_section_funcref(out, total_table_entries)\n  }\n  emit_memory_section(out, 8192)\n  // Tag section (section ID 13): exception tag with type (i64)->()\n  let tag_content = bytebuf_new()\n  bytebuf_push_vec_header(tag_content, 1)\n  bytebuf_push(tag_content, 0)\n  // attribute: exception\n  leb128_encode_u32(tag_content, 1)\n  // type index 1 = (i64)->()\n  bytebuf_push_section(out, 13, tag_content)\n  emit_global_section_i32_mut(out, heap_start)\n  let start_func_idx = func_offset + num_user_funcs\n  let run_func_idx = start_func_idx + 1\n  let all_export_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let all_export_indices = Array::slice([\n    0\n  ], 0, 0)\n  Array::push(all_export_names, \"_start\")\n  Array::push(all_export_indices, start_func_idx)\n  Array::push(all_export_names, \"run\")\n  Array::push(all_export_indices, run_func_idx)\n  if !array_contains_str(all_export_names, entry_name) {\n    Array::push(all_export_names, entry_name)\n    Array::push(all_export_indices, entry_func_idx)\n  }\n  let mut exi = 0\n  while exi < Array::length(export_fn_names) {\n    let ename = Array::get(export_fn_names, exi)\n    if !array_contains_str(all_export_names, ename) {\n      Array::push(all_export_names, ename)\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\n    }\n    exi = exi + 1\n  }\n  // Export section: functions + memory + globals + error tag\n  let export_content = bytebuf_new()\n  let export_count = Array::length(all_export_names) + 1 + 1 + 1\n  // funcs + memory + __heap_ptr global + error tag\n  bytebuf_push_vec_header(export_content, export_count)\n  let mut efi = 0\n  while efi < Array::length(all_export_names) {\n    emit_name(export_content, Array::get(all_export_names, efi))\n    bytebuf_push(export_content, 0)\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\n    efi = efi + 1\n  }\n  emit_name(export_content, \"memory\")\n  bytebuf_push(export_content, 2)\n  leb128_encode_u32(export_content, 0)\n  emit_name(export_content, \"__heap_ptr\")\n  bytebuf_push(export_content, 3)\n  leb128_encode_u32(export_content, 0)\n  emit_name(export_content, \"error\")\n  bytebuf_push(export_content, 4)\n  // tag export\n  leb128_encode_u32(export_content, 0)\n  bytebuf_push_section(out, 7, export_content)\n  if total_table_entries > 0 {\n    let table_func_indices = Array::slice([\n      0\n    ], 0, 0)\n    let mut tei = 0\n    while tei < num_user_funcs {\n      Array::push(table_func_indices, func_offset + tei)\n      tei = tei + 1\n    }\n    let mut tej = 0\n    while tej < num_lambdas {\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\n      tej = tej + 1\n    }\n    emit_element_section_active(out, table_func_indices)\n  }\n  let code_content = bytebuf_new()\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\n  let mut ci = 0\n  while ci < Array::length(bodies) {\n    let body = Array::get(bodies, ci)\n    let func_buf = bytebuf_new()\n    let ni32 = Array::get(meta_i32, ci)\n    let ni64 = Array::get(meta_i64, ci)\n    if ni32 == 0 {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 0)\n        // no locals\n      } else {\n        leb128_encode_u32(func_buf, 1)\n        // 1 group\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n        // i64\n      }\n    } else {\n      if ni64 == 0 {\n        leb128_encode_u32(func_buf, 1)\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        // i32\n      } else {\n        leb128_encode_u32(func_buf, 2)\n        // 2 groups\n        leb128_encode_u32(func_buf, ni32)\n        bytebuf_push(func_buf, 127)\n        // i32\n        leb128_encode_u32(func_buf, ni64)\n        bytebuf_push(func_buf, 126)\n        // i64\n      }\n    }\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    // end\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_array(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = Array::slice([\n      0\n    ], 0, 0)\n    let data_bufs = Array::slice([\n      Array::slice([\n        0\n      ], 0, 0)\n    ], 0, 0)\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\n      di = di + 1\n    }\n    emit_data_section_multi(out, data_offsets, data_bufs)\n  }\n  bytebuf_to_bytes(out)\n}\n\n// Backward-compatible wrapper: compile WASI module without embedded selfhost sources\nexport let compile_wasi_module_impl = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n}\n")

  let source_22 = ("vibe/compiler/entry/source_compile/wasi_only/index.vibe",
"//# Imports\n\nimport ../../../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../../checker/checker_stmt.vibe {\n  check_program\n}\n\nimport ../../../codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\n//# Functions\n\nexport let compile_source_wasi_only = (source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n")

  let source_23 = ("vibe/compiler/selfhost_cli_adapter.vibe",
"//# Imports\n\nimport ./entry / source_compile / wasi_only {\n  compile_source_wasi_only\n}\n\n//# Functions\n\nexport let cli_main = () -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  let entry_name = Env::get(\"VIBE_ENTRY\")\n  let source = Fs::read_file(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Fs::write_bytes(output_path, bytes)\n  0\n}\n")

export let selfhost_cli_adapter_sources = () -> Array[(String, String)] {
  let sources = Array::slice([("", "")], 0, 0)
  Array::push(sources, source_0)
  Array::push(sources, source_1)
  Array::push(sources, source_2)
  Array::push(sources, source_3)
  Array::push(sources, source_4)
  Array::push(sources, source_5)
  Array::push(sources, source_6)
  Array::push(sources, source_7)
  Array::push(sources, source_8)
  Array::push(sources, source_9)
  Array::push(sources, source_10)
  Array::push(sources, source_11)
  Array::push(sources, source_12)
  Array::push(sources, source_13)
  Array::push(sources, source_14)
  Array::push(sources, source_15)
  Array::push(sources, source_16)
  Array::push(sources, source_17)
  Array::push(sources, source_18)
  Array::push(sources, source_19)
  Array::push(sources, source_20)
  Array::push(sources, source_21)
  Array::push(sources, source_22)
  Array::push(sources, source_23)
  sources
}

export let selfhost_cli_adapter_source_groups = () -> Array[(String, Array[(String, String)])] {
  let groups = empty_grouped_sources()
  push_grouped_source_pair(groups, "core", source_0)
  push_grouped_source_pair(groups, "core", source_1)
  push_grouped_source_pair(groups, "core", source_2)
  push_grouped_source_pair(groups, "core", source_3)
  push_grouped_source_pair(groups, "core", source_4)
  push_grouped_source_pair(groups, "core", source_5)
  push_grouped_source_pair(groups, "syntax", source_6)
  push_grouped_source_pair(groups, "syntax", source_7)
  push_grouped_source_pair(groups, "syntax", source_8)
