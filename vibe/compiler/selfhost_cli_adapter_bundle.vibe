4,\n  66,\n  1,\n  132\n])\n\nexport let static_str_from_char_code_body: () -> Bytes = () -> {\n  static_str_from_char_code_body_bytes\n}\n\nlet static_fs_write_bytes_stub_body_bytes = Bytes::new()\n\nexport let static_fs_write_bytes_stub_body: () -> Bytes = () -> {\n  static_fs_write_bytes_stub_body_bytes\n}\n")
}

