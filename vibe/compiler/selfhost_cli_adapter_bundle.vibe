"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_v128_load, emit_i8x16_splat, emit_i8x16_eq, emit_i8x16_le_u, emit_i8x16_sub, emit_v128_or, emit_v128_not, emit_i8x16_bitmask, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let gen_identity_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\nexport let gen_arr_slice_body: (Bool, Int) -> Bytes = (enable_rc, rc_alloc_idx) -> {\n  let b = bytebuf_new()\n  if enable_rc {\n    // ADR-0055 Stage 4: build the slice as a self-describing RC block, the same\n    // shape as gen_arr_new / a literal array, so the recursive rc_drop and the\n    // free-list can reach it. Layout: [alloc_size@0][rc_count@4][class=5@7],\n    // value = block+8, value[0]=cap value[4]=len value[8]=data_ptr=block+20.\n    // The copied elements are shared with the source, so each RC-managed element\n    // is dup'd (guarded) — without this the source drop frees them while the\n    // slice still references them (use-after-free / trap, issue #500).\n    // locals: 3=src_val 4=src_data 5=count 6=block 7=data_ptr 8=cap 9=i (i32),\n    //         10=elem (i64).\n    // src_val = wrap(arr & -2)  (untag the odd source pointer)\n    emit_local_get(b, 0)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    // src_data = src_val[8]\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 4)\n    // count = untag(end) - untag(start)\n    emit_local_get(b, 2)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_local_get(b, 1)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_sub(b)\n    emit_local_set(b, 5)\n    // cap = count + 8\n    emit_local_get(b, 5)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 8)\n    // block = wrap(__rc_alloc(20 + cap*8))\n    emit_i32_const(b, 20)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 6)\n    // block[0] = alloc_size = 20 + cap*8\n    emit_local_get(b, 6)\n    emit_i32_const(b, 20)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // block[4] = rc_count = 1\n    emit_local_get(b, 6)\n    emit_i32_const(b, 1)\n    emit_i32_store(b, 2, 4)\n    // block[7] = class = 5 (array); high byte of the rc_count word\n    emit_local_get(b, 6)\n    emit_i32_const(b, 5)\n    emit_i32_store8(b, 0, 7)\n    // value[0] (block+8) = cap\n    emit_local_get(b, 6)\n    emit_local_get(b, 8)\n    emit_i32_store(b, 2, 8)\n    // value[4] (block+12) = len = count\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_i32_store(b, 2, 12)\n    // data_ptr = block+20\n    emit_local_get(b, 6)\n    emit_i32_const(b, 20)\n    emit_i32_add(b)\n    emit_local_set(b, 7)\n    // value[8] (block+16) = data_ptr\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 16)\n    // memory_copy: dst=data_ptr, src=src_data + untag(start)*8, len=count*8\n    emit_local_get(b, 7)\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    // dup each copied RC-managed element (guarded: odd && high32==0)\n    emit_i32_const(b, 0)\n    emit_local_set(b, 9)\n    emit_block_void(b)\n    emit_loop_void(b)\n    emit_local_get(b, 9)\n    emit_local_get(b, 5)\n    emit_i32_ge_u(b)\n    emit_br_if(b, 1)\n    // elem = load_i64(data_ptr + i*8)\n    emit_local_get(b, 7)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_load(b, 3, 0)\n    emit_local_set(b, 10)\n    // if (elem & 1) — odd heap pointer\n    emit_local_get(b, 10)\n    emit_i64_const(b, 1)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_if_void(b)\n    // if (elem >> 32) == 0 — not a string/bytes fat pointer\n    emit_local_get(b, 10)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i64_eqz(b)\n    emit_if_void(b)\n    // rc_count++ at (elem & -2) - 4\n    emit_local_get(b, 10)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_local_get(b, 10)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_i32_load(b, 2, 0)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    emit_end(b)\n    emit_end(b)\n    // i++\n    emit_local_get(b, 9)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_local_set(b, 9)\n    emit_br(b, 0)\n    emit_end(b)\n    emit_end(b)\n    // return (block+8) | 1  (odd-tagged value pointer)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_i64_const(b, 1)\n    emit_i64_or(b)\n  } else {\n    emit_local_get(b, 0)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 4)\n    emit_local_get(b, 2)\n    emit_i32_wrap_i64(b)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_i32_sub(b)\n    emit_local_set(b, 5)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 8)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 6)\n    emit_i32_const(b, 12)\n    emit_local_get(b, 8)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 8)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 6)\n    emit_local_get(b, 5)\n    emit_i32_store(b, 2, 4)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_local_set(b, 7)\n    emit_local_get(b, 6)\n    emit_local_get(b, 7)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 7)\n    emit_local_get(b, 4)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    emit_local_get(b, 6)\n    emit_i64_extend_i32_u(b)\n  }\n  b\n}\n\nexport let gen_bytes_get_body: (Bool) -> Bytes = (enable_rc) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: the byte is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\nexport let gen_bytes_len_body: (Bool) -> Bytes = (enable_rc) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: the length is a count entering the value world; tag it.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\n// simd_skip_ws(buf: Bytes, pos: Int, len: Int) -> Int\n// Returns the smallest index i in [pos, len) such that buf[i] is not an ASCII\n// whitespace byte (space/tab/LF/CR); returns len if every byte in the range is\n// whitespace. A SIMD fast path skips whole 16-byte chunks that are entirely\n// whitespace; a scalar tail handles the final partial chunk and the chunk that\n// first contains a non-whitespace byte. The v128 values stay on the operand\n// stack (no v128 local), so the function declares only i32/i64 locals.\n//   locals: i32 { 3: addr (data ptr), 4: byte } ; i64 { 5: p, 6: n }\nexport let gen_simd_skip_ws_body: (Bool) -> Bytes = (enable_rc) -> {\n  let b = bytebuf_new()\n  // addr = data pointer of the Bytes object (payload pointer at obj+8)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  // p = untag(pos)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 5)\n  // n = untag(len)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 6)\n  // --- SIMD fast path: skip 16-byte chunks that are entirely whitespace ---\n  emit_block_void(b)\n  emit_loop_void(b)\n  // if p + 16 > n: leave the fast path\n  emit_local_get(b, 5)\n  emit_i64_const(b, 16)\n  emit_i64_add(b)\n  emit_local_get(b, 6)\n  emit_i64_gt_s(b)\n  emit_br_if(b, 1)\n  // is_space (0x20)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 32)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_eq(b)\n  // is_tab (0x09)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 9)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_eq(b)\n  emit_v128_or(b)\n  // is_lf (0x0A)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 10)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_eq(b)\n  emit_v128_or(b)\n  // is_cr (0x0D)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 13)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_eq(b)\n  emit_v128_or(b)\n  // non-whitespace bitmask: bit set => byte is NOT whitespace\n  emit_v128_not(b)\n  emit_i8x16_bitmask(b)\n  // if any non-whitespace byte in this chunk, hand off to the scalar tail\n  emit_br_if(b, 1)\n  // whole chunk is whitespace: advance 16 and continue\n  emit_local_get(b, 5)\n  emit_i64_const(b, 16)\n  emit_i64_add(b)\n  emit_local_set(b, 5)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // --- scalar tail: advance p while p < n and buf[p] is whitespace ---\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  // byte = load8u(addr + p)\n  emit_local_get(b, 3)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_set(b, 4)\n  // is_ws = (byte==0x20)+(byte==0x09)+(byte==0x0A)+(byte==0x0D); the equalities\n  // are mutually exclusive so the sum is 0 or 1 (avoids needing i32.or).\n  emit_local_get(b, 4)\n  emit_i32_const(b, 32)\n  emit_i32_eq(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 9)\n  emit_i32_eq(b)\n  emit_i32_add(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 10)\n  emit_i32_eq(b)\n  emit_i32_add(b)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 13)\n  emit_i32_eq(b)\n  emit_i32_add(b)\n  // if NOT whitespace, stop\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 5)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 5)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // return tag(p)\n  emit_local_get(b, 5)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\n// simd_scan_alnum(buf: Bytes, pos: Int, len: Int) -> Int\n// Returns the smallest index i in [pos, len) such that buf[i] is NOT an\n// identifier byte ([A-Za-z0-9_]); returns len if every byte in the range is an\n// identifier byte. Used to scan to the end of an identifier/number run. A SIMD\n// fast path skips whole 16-byte chunks that are entirely identifier bytes; a\n// scalar tail handles the final partial chunk and the chunk that first contains\n// a non-identifier byte. Range membership uses the wrap-subtract trick\n// (x - lo) <=u (hi - lo). v128 stays on the operand stack (no v128 local).\n//   locals: i32 { 3: addr } ; i64 { 4: p, 5: n, 6: byte }\nexport let gen_simd_scan_alnum_body: (Bool, Bool) -> Bytes = (enable_rc, is_string) -> {\n  let b = bytebuf_new()\n  // addr = pointer to the byte payload. Bytes: the payload pointer lives at\n  // obj+8. String: the value packs (ptr|len) with char data at (value >> 32).\n  emit_local_get(b, 0)\n  if is_string {\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i32_wrap_i64(b)\n  } else {\n    emit_i32_wrap_i64(b)\n    emit_i32_load(b, 2, 8)\n  }\n  emit_local_set(b, 3)\n  // p = untag(pos)\n  emit_local_get(b, 1)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 4)\n  // n = untag(len)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_local_set(b, 5)\n  // --- SIMD fast path: skip 16-byte chunks that are entirely identifier bytes ---\n  emit_block_void(b)\n  emit_loop_void(b)\n  // if p + 16 > n: leave the fast path\n  emit_local_get(b, 4)\n  emit_i64_const(b, 16)\n  emit_i64_add(b)\n  emit_local_get(b, 5)\n  emit_i64_gt_s(b)\n  emit_br_if(b, 1)\n  // digit: (x - 0x30) <=u 9\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 48)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_sub(b)\n  emit_i64_const(b, 9)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_le_u(b)\n  // upper: (x - 0x41) <=u 25\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 65)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_sub(b)\n  emit_i64_const(b, 25)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_le_u(b)\n  emit_v128_or(b)\n  // lower: (x - 0x61) <=u 25\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 97)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_sub(b)\n  emit_i64_const(b, 25)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_le_u(b)\n  emit_v128_or(b)\n  // underscore: x == 0x5F\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_v128_load(b, 0, 0)\n  emit_i64_const(b, 95)\n  emit_i32_wrap_i64(b)\n  emit_i8x16_splat(b)\n  emit_i8x16_eq(b)\n  emit_v128_or(b)\n  // non-identifier bitmask: bit set => byte is NOT an identifier byte\n  emit_v128_not(b)\n  emit_i8x16_bitmask(b)\n  // if any non-identifier byte in this chunk, hand off to the scalar tail\n  emit_br_if(b, 1)\n  // whole chunk is identifier bytes: advance 16 and continue\n  emit_local_get(b, 4)\n  emit_i64_const(b, 16)\n  emit_i64_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // --- scalar tail: advance p while p < n and buf[p] is an identifier byte ---\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i64_ge_s(b)\n  emit_br_if(b, 1)\n  // byte = load8u(addr + p), widened to i64\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, 6)\n  // is_id = digit + upper + lower + underscore (mutually exclusive => 0 or 1).\n  // each range is (byte >= lo) * (byte <= hi) via i64 compares + i32.mul.\n  emit_local_get(b, 6)\n  emit_i64_const(b, 48)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 57)\n  emit_i64_le_s(b)\n  emit_i32_mul(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 65)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 90)\n  emit_i64_le_s(b)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 97)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 122)\n  emit_i64_le_s(b)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_local_get(b, 6)\n  emit_i64_const(b, 95)\n  emit_i64_eq(b)\n  emit_i32_add(b)\n  // if NOT an identifier byte, stop\n  emit_i32_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  // return tag(p)\n  emit_local_get(b, 4)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  b\n}\n\nexport let gen_bytes_new_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0 - 64)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gen_bytes_set_body: (Bool) -> Bytes = (enable_rc) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: index arrives tagged; untag before use.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  // ADR-0055 Stage 1: byte value arrives tagged; untag before storing.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  b\n}\n\nexport let gen_bytes_blit_body: (Bool, Int, Int) -> Bytes = (enable_rc, bytes_get_idx, bytes_push_idx) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 2)\n  // ADR-0055 Stage 1: start/end indices arrive tagged; untag for loop bounds.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 3)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 4)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 4)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport let gen_bytes_fill_body: (Bool, Int) -> Bytes = (enable_rc, bytes_push_idx) -> {\n  let b = bytebuf_new()\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  // ADR-0055 Stage 1: count arrives tagged; untag for the loop bound. The byte\n  // value (local 1) is passed straight to the value-world bytes_push, which\n  // untags it itself.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport let gen_bytes_push_body: (Bool) -> Bytes = (enable_rc) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 3)\n  emit_i32_sub(b)\n  emit_local_set(b, 7)\n  emit_local_get(b, 4)\n  emit_local_get(b, 7)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 2)\n  emit_i32_mul(b)\n  emit_local_set(b, 7)\n  emit_global_get(b, 0)\n  emit_local_tee(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_memory_copy(b)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 0)\n  emit_local_get(b, 7)\n  emit_i32_sub(b)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 6)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 6)\n  emit_local_set(b, 5)\n  emit_end(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: byte value arrives tagged; untag before storing.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\nexport let gen_bytes_slice_body: (Bool, Int, Int, Int) -> Bytes = (enable_rc, bytes_new_idx, bytes_get_idx, bytes_push_idx) -> {\n  let b = bytebuf_new()\n  emit_call(b, bytes_new_idx)\n  emit_local_set(b, 5)\n  emit_local_get(b, 1)\n  // ADR-0055 Stage 1: start/end indices arrive tagged; untag for loop bounds.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 4)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 5)\n  emit_local_get(b, 0)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 5)\n  b\n}\n\nexport let gen_arr_push_all_body: (Bool, Int) -> Bytes = (enable_rc, rc_alloc_idx) -> {\n  let b = bytebuf_new()\n  if enable_rc {\n    // ADR-0055 Stage 4: in-place append that keeps `a` a valid RC array. Untag\n    // both pointers; grow via __rc_alloc into a headered data block (freeing the\n    // old grown buffer to the free-list, mirroring gen_arr_push); and guard-dup\n    // each appended element from `b` so both `a` and `b` can be dropped safely.\n    // locals: 2=a_val 3=b_val 4=len_a 5=len_b 6=data_a 7=data_b 8=cap_a\n    //         9=newcap 10=block 11=i (i32), 12=elem (i64).\n    emit_local_get(b, 0)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 2)\n    emit_local_get(b, 1)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 4)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 5)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 6)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 7)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 0)\n    emit_local_set(b, 8)\n    // if (len_a + len_b > cap_a): grow\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_local_get(b, 8)\n    emit_i32_gt_u(b)\n    emit_if_void(b)\n    // newcap = (len_a+len_b)*2\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_const(b, 2)\n    emit_i32_mul(b)\n    emit_local_set(b, 9)\n    // block = wrap(__rc_alloc(newcap*8 + 8)); data lives at block+8\n    emit_local_get(b, 9)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i64_extend_i32_u(b)\n    emit_call(b, rc_alloc_idx)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 10)\n    emit_local_get(b, 10)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    // copy old elements into block+8\n    emit_local_get(b, 10)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    // free old buffer if it was a separate grown block (data_a != a_val+12)\n    emit_local_get(b, 6)\n    emit_local_get(b, 2)\n    emit_i32_const(b, 12)\n    emit_i32_add(b)\n    emit_i32_ne(b)\n    emit_if_void(b)\n    emit_local_get(b, 6)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_global_get(b, 2)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 6)\n    emit_global_set(b, 2)\n    emit_end(b)\n    // cap = newcap; data_ptr = block+8; data_a = block+8\n    emit_local_get(b, 2)\n    emit_local_get(b, 9)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 10)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 10)\n    emit_i32_const(b, 8)\n    emit_i32_add(b)\n    emit_local_set(b, 6)\n    emit_end(b)\n    // copy b's elements into data_a + len_a*8\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 7)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    // len = len_a + len_b\n    emit_local_get(b, 2)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 4)\n    // dup each appended element from b (guarded: odd && high32==0)\n    emit_i32_const(b, 0)\n    emit_local_set(b, 11)\n    emit_block_void(b)\n    emit_loop_void(b)\n    emit_local_get(b, 11)\n    emit_local_get(b, 5)\n    emit_i32_ge_u(b)\n    emit_br_if(b, 1)\n    emit_local_get(b, 7)\n    emit_local_get(b, 11)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_i64_load(b, 3, 0)\n    emit_local_set(b, 12)\n    emit_local_get(b, 12)\n    emit_i64_const(b, 1)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_if_void(b)\n    emit_local_get(b, 12)\n    emit_i64_const(b, 32)\n    emit_i64_shr_s(b)\n    emit_i64_eqz(b)\n    emit_if_void(b)\n    emit_local_get(b, 12)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_local_get(b, 12)\n    emit_i64_const(b, -2)\n    emit_i64_and(b)\n    emit_i32_wrap_i64(b)\n    emit_i32_const(b, 4)\n    emit_i32_sub(b)\n    emit_i32_load(b, 2, 0)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 0)\n    emit_end(b)\n    emit_end(b)\n    emit_local_get(b, 11)\n    emit_i32_const(b, 1)\n    emit_i32_add(b)\n    emit_local_set(b, 11)\n    emit_br(b, 0)\n    emit_end(b)\n    emit_end(b)\n  } else {\n    emit_local_get(b, 0)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 2)\n    emit_local_get(b, 1)\n    emit_i32_wrap_i64(b)\n    emit_local_set(b, 3)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 4)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 4)\n    emit_local_set(b, 5)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 6)\n    emit_local_get(b, 3)\n    emit_i32_load(b, 2, 8)\n    emit_local_set(b, 7)\n    emit_local_get(b, 2)\n    emit_i32_load(b, 2, 0)\n    emit_local_set(b, 8)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_local_get(b, 8)\n    emit_i32_gt_u(b)\n    emit_if_void(b)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_const(b, 2)\n    emit_i32_mul(b)\n    emit_local_set(b, 9)\n    emit_global_get(b, 0)\n    emit_local_tee(b, 10)\n    emit_local_get(b, 9)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_i32_add(b)\n    emit_global_set(b, 0)\n    emit_heap_memory_grow_check(b)\n    emit_local_get(b, 10)\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 8)\n    emit_i32_mul(b)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 9)\n    emit_i32_store(b, 2, 0)\n    emit_local_get(b, 2)\n    emit_local_get(b, 10)\n    emit_i32_store(b, 2, 8)\n    emit_local_get(b, 10)\n    emit_local_set(b, 6)\n    emit_end(b)\n    emit_local_get(b, 6)\n    emit_local_get(b, 4)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_i32_add(b)\n    emit_local_get(b, 7)\n    emit_local_get(b, 5)\n    emit_i32_const(b, 3)\n    bytebuf_push(b, 116)\n    emit_memory_copy(b)\n    emit_local_get(b, 2)\n    emit_local_get(b, 4)\n    emit_local_get(b, 5)\n    emit_i32_add(b)\n    emit_i32_store(b, 2, 4)\n  }\n  b\n}\n\nexport let gen_bytes_append_body: (Bool, Int, Int, Int) -> Bytes = (enable_rc, bytes_len_idx, bytes_get_idx, bytes_push_idx) -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 1)\n  emit_call(b, bytes_len_idx)\n  // ADR-0055 Stage 1: bytes_len now returns a tagged count; untag for the bound.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 3)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 0)\n  emit_local_get(b, 1)\n  emit_local_get(b, 3)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to the value-world bytes_get.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport let gen_bytes_concat_body: (Int, Int) -> Bytes = (bytes_new_idx, bytes_append_idx) -> {\n  let b = bytebuf_new()\n  emit_call(b, bytes_new_idx)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 0)\n  emit_call(b, bytes_append_idx)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_call(b, bytes_append_idx)\n  emit_local_get(b, 2)\n  b\n}\n\nexport let gen_bytes_to_array_body: (Bool, Int, Int, Int, Int) -> Bytes = (enable_rc, arr_new_idx, arr_push_idx, bytes_len_idx, bytes_get_idx) -> {\n  let b = bytebuf_new()\n  emit_call(b, arr_new_idx)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_call(b, bytes_len_idx)\n  // ADR-0055 Stage 1: bytes_len now returns a tagged count; untag for the bound.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to value-world bytes_get. The byte\n  // it returns is tagged, which is exactly what arr_push stores.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, bytes_get_idx)\n  emit_call(b, arr_push_idx)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 3)\n  b\n}\n\nexport let gen_bytes_from_array_body: (Bool, Int, Int, Int, Int) -> Bytes = (enable_rc, arr_len_idx, arr_get_idx, bytes_new_idx, bytes_push_idx) -> {\n  let b = bytebuf_new()\n  emit_call(b, bytes_new_idx)\n  emit_local_set(b, 3)\n  emit_local_get(b, 0)\n  emit_call(b, arr_len_idx)\n  // ADR-0055 Stage 1: arr_len now returns a tagged count; untag for the bound.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shr_s(b)\n  }\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 1)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 2)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_local_get(b, 2)\n  emit_i64_extend_i32_u(b)\n  // ADR-0055 Stage 1: tag the index passed to value-world arr_get. The value it\n  // returns is tagged, which is exactly what the value-world bytes_push untags.\n  if enable_rc {\n    emit_i64_const(b, 1)\n    emit_i64_shl(b)\n  }\n  emit_call(b, arr_get_idx)\n  emit_call(b, bytes_push_idx)\n  emit_local_get(b, 2)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 2)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 3)\n  b\n}\n")
