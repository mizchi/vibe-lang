//# Selfhost CLI adapter bundle

let cli_adapter_empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}

let cli_adapter_push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {
  let (path, source) = pair
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if String::equals(name, group_name) {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

let cli_adapter_source_0 = () -> (String, String) {
  ("vibe/compiler/core/polyfill.vibe",
"//# Functions\n\nexport let __to_string: (Int) -> String = (n) -> {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")
}

let cli_adapter_source_1 = () -> (String, String) {
  ("vibe/compiler/core/bytebuf.vibe",
"//# Functions\n\nexport let bytebuf_new: () -> Bytes = () -> {\n  Bytes::new()\n}\n\nexport let bytebuf_push: (Bytes, Int) -> Unit = (buf, byte) -> {\n  Bytes::push(buf, byte)\n}\n\nexport let bytebuf_push2: (Bytes, Int, Int) -> Unit = (buf, b1, b2) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport let bytebuf_push3: (Bytes, Int, Int, Int) -> Unit = (buf, b1, b2, b3) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport let bytebuf_push9: (Bytes, Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Unit = (buf, b1, b2, b3, b4, b5, b6, b7, b8, b9) -> {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n\nexport let bytebuf_length: (Bytes) -> Int = (buf) -> {\n  Bytes::length(buf)\n}\n\nexport let bytebuf_push_buf: (Bytes, Bytes) -> Unit = (dst, src) -> {\n  Bytes::append(dst, src)\n}\n\nexport let bytebuf_to_bytes: (Bytes) -> Bytes = (buf) -> {\n  buf\n}\n\nexport let leb128_encode_s32: (Bytes, Int) -> Unit = (buf, value) -> {\n  if value >= (0 - 64) && value < 64 {\n    Bytes::push(buf, value&127)\n  } else {\n    if value >= (0 - 8192) && value < 8192 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = v>>7\n        if (v == 0) && (byte&64) == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          if (v == 0 - 1) && (byte&64) != 0 {\n            Bytes::push(buf, byte)\n            more = false\n          } else {\n            Bytes::push(buf, byte|128)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64: (Bytes, Int) -> Unit = (buf, value) -> {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32: (Bytes, Int) -> Unit = (buf, value) -> {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = (v>>7)&((1<<25) - 1)\n        if v == 0 {\n          Bytes::push(buf, byte)\n          more = false\n        } else {\n          Bytes::push(buf, byte|128)\n        }\n      }\n    }\n  }\n}\n\nexport let bytebuf_push_string: (Bytes, String) -> Unit = (buf, s) -> {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section: (Bytes, Int, Bytes) -> Unit = (out, section_id, content) -> {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport let bytebuf_push_opcode_s64: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_opcode_u32: (Bytes, Int, Int) -> Unit = (buf, opcode, value) -> {\n  if value >= 0 && value < 128 {\n    Bytes::push(buf, opcode)\n    Bytes::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Bytes::push(buf, opcode)\n      Bytes::push(buf, (value&127)|128)\n      Bytes::push(buf, (value>>7)&127)\n    } else {\n      Bytes::push(buf, opcode)\n      leb128_encode_u32(buf, value)\n    }\n  }\n}\n\nexport let bytebuf_push_vec_header: (Bytes, Int) -> Unit = (buf, count) -> {\n  leb128_encode_u32(buf, count)\n}\n\nexport let bytebuf_push_opcode_u32_u32: (Bytes, Int, Int, Int) -> Unit = (buf, opcode, a, b) -> {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n")
}

let cli_adapter_source_2 = () -> (String, String) {
  ("vibe/compiler/core/ast.vibe",
"//# Types\n\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PFloat(Double);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat);\n  PStruct(String, Array[(String, Pat)])\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr, Option[String]);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String, Int);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr], Int);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String, Int);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EReturn(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[String], Array[(String, Array[TypeExpr])], Array[String]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)], Array[String], Array[String]);\n  STypeAlias(Bool, String, Array[String], TypeExpr);\n  STrait(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SAliasDecl(String, String);\n  SLetPat(Pat, Expr);\n  SModule(Bool, String, Array[Stmt]);\n  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)])\n}\n")
}

let cli_adapter_source_3 = () -> (String, String) {
  ("vibe/compiler/core/types.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  TypeExpr\n}\n\n//# Types\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Option[String]);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[String], Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)], Array[String]);\n  TDAlias(String, Array[String], Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, Array[(String, Array[TypeExpr], TypeExpr)], TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\n  EnvFlat(Array[(String, Type)]);\n  EnvCached(Map[String, Type], TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst);\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst);\n  // #626 criterion 4: an effect-variable binding `var := effect-label-string`\n  // (\"\" meaning the pure/empty row). Effect variables are no longer a wildcard\n  // that is compatible with everything — `unify` records their binding here and\n  // `subst_apply` resolves CtFn effects through it, so `e` actually unifies to\n  // its first binding and a later conflicting use is a type error.\n  SubstEffBind(String, String, Subst)\n}\n\n//# Functions\n\nexport let env_bind: (TypeEnv, String, Type) -> TypeEnv = (env, name, ty) -> {\n  match env {\n    EnvCached(cache, rest) => EnvCached(cache, EnvBind(name, ty, rest)),\n    _ => EnvBind(name, ty, env)\n  }\n}\n\nexport let env_cache: (TypeEnv) -> TypeEnv = (env) -> {\n  let is_empty = match env {\n    EnvEmpty => true,\n    _ => false\n  }\n  if is_empty {\n    EnvEmpty\n  } else {\n    let names = ArrayBuilder::new()\n    let types = ArrayBuilder::new()\n    let mut cur = env\n    let mut done = false\n    while !done {\n      match cur {\n        EnvEmpty => {\n          done = true\n        },\n        EnvBind(n, ty, rest) => {\n          ArrayBuilder::push(names, n)\n          ArrayBuilder::push(types, ty)\n          cur = rest\n        },\n        EnvTraitDef(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImpl(_, _, rest) => {\n          cur = rest\n        },\n        EnvTraitImplGen(_, _, _, _, rest) => {\n          cur = rest\n        },\n        EnvFlat(bindings) => {\n          let mut j = 0\n          while j < Array::length(bindings) {\n            let (n, ty) = Array::get(bindings, j)\n            ArrayBuilder::push(names, n)\n            ArrayBuilder::push(types, ty)\n            j = j + 1\n          }\n          done = true\n        },\n        EnvCached(_, rest) => {\n          cur = rest\n        }\n      }\n    }\n    let na = ArrayBuilder::freeze(names)\n    let ta = ArrayBuilder::freeze(types)\n    let cache = MapBuilder::new()\n    let len = Array::length(na)\n    let mut i = 0\n    while i < len {\n      let idx = len - i - 1\n      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))\n      i = i + 1\n    }\n    EnvCached(MapBuilder::freeze(cache), env)\n  }\n}\n\nexport let fresh_var: (Int) -> (Type, Int) = (c) -> {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in: (Int, Type) -> Bool = (id, ty) -> {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let env_lookup: (TypeEnv, String) -> Option[Type] = (env, name) -> {\n  let mut cur = env\n  let mut result = None\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(n, ty, rest) => if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      },\n      EnvFlat(bindings) => {\n        let mut j = 0\n        while j < Array::length(bindings) && !done {\n          let (n, ty) = Array::get(bindings, j)\n          if n == name {\n            result = Some(ty)\n            done = true\n          } else {\n            j = j + 1\n          }\n        }\n        if !done {\n          done = true\n        }\n      },\n      EnvCached(cache, rest) => if Map::has_key(cache, name) {\n        result = Some(Map::get(cache, name))\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  result\n}\n\nexport let env_bind_all: (TypeEnv, Array[(String, Type)]) -> TypeEnv = (env, bindings) -> {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while i < len {\n    let (name, ty) = Array::get(bindings, i)\n    acc = env_bind(acc, name, ty)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef: (Array[TypeDef], String) -> Option[TypeDef] = (defs, name) -> {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _, _) => n,\n        TDStruct(n, _, _) => n,\n        TDAlias(n, _, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let subst_lookup: (Subst, Int) -> Option[Type] = (s, id) -> {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  let key = __to_string(id)\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => if i == id {\n        out = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\n        out = Some(Map::get(cache, key))\n        done = true\n      } else {\n        cur = rest\n      }\n      ,\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let rec trait_supers: (TypeEnv, String) -> Array[String] = (env, name) -> {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\n    EnvFlat(_) => empty,\n    EnvCached(_, rest) => trait_supers(rest, name)\n  }\n}\n\n// Look up a trait method's declared signature (param TypeExprs + return\n// TypeExpr) by trait name + method name. `Self` appears verbatim as\n// `TyName(\"Self\")` in the stored signature; the caller substitutes it.\nexport let rec trait_method_sig: (TypeEnv, String, String) -> Option[(Array[TypeExpr], TypeExpr)] = (env, trait_name, method_name) -> {\n  match env {\n    EnvEmpty => None,\n    EnvBind(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\n      let mlen = Array::length(methods)\n      let mut i = 0\n      let mut found = None\n      while i < mlen {\n        let (mname, params, ret) = Array::get(methods, i)\n        if mname == method_name {\n          found = Some((params, ret))\n          i = mlen\n        } else {\n          i = i + 1\n        }\n      }\n      match found {\n        Some(sig) => Some(sig),\n        None => trait_method_sig(rest, trait_name, method_name)\n      }\n    } else trait_method_sig(rest, trait_name, method_name),\n    EnvTraitImpl(_, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_method_sig(rest, trait_name, method_name),\n    EnvFlat(_) => None,\n    EnvCached(_, rest) => trait_method_sig(rest, trait_name, method_name)\n  }\n}\n\n// The declared name at the head of a (possibly generic) named type, for\n// matching against a trait impl's target. Impl targets are stored with their\n// type arguments erased to `CtUnknown` (see the `SImpl` handler), so element\n// types must be matched by head name, not by `types_equal`.\nlet trait_target_head_name: (Type) -> String = (ty) -> {\n  match ty {\n    CtNamed(n, _) => n,\n    CtStruct(n) => n,\n    CtEnum(n) => n,\n    _ => \"\"\n  }\n}\n\nlet rec type_name_iterator_impl_scan: (TypeEnv, TypeEnv, String) -> Bool = (scan, full, type_name) -> {\n  match scan {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvTraitDef(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvTraitImpl(tname, target, rest) => {\n      let hit = trait_target_head_name(target) == type_name && (match trait_method_sig(full, tname, \"next\") {\n        Some(_) => true,\n        None => false\n      })\n      if hit {\n        true\n      } else type_name_iterator_impl_scan(rest, full, type_name)\n    },\n    EnvTraitImplGen(_, _, _, _, rest) => type_name_iterator_impl_scan(rest, full, type_name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_name_iterator_impl_scan(rest, full, type_name)\n  }\n}\n\n// True iff a type named `type_name` has an `impl Tr for type_name` where the\n// trait `Tr` declares a `next` method — i.e. the type is iterator-shaped\n// (`Iterator[T] { next(Self) -> Option[(T, Self)] }`). The checker's `for x in\n// it` element-type inference uses this to recognise struct-trait iterators\n// (`LazyIter`, async streams, …) and bind the loop variable to the iterator's\n// element type instead of `CtUnknown`.\nexport let type_name_has_iterator_impl: (TypeEnv, String) -> Bool = (env, type_name) -> {\n  type_name_iterator_impl_scan(env, env, type_name)\n}\n\n// Like `trait_method_sig` but follows supertraits transitively, so a method\n// inherited from a supertrait (`trait B: A` calling an `A` method on `[T: B]`)\n// resolves. Trait hierarchies are acyclic, so the recursion terminates.\nexport let rec trait_method_sig_deep: (TypeEnv, String, String) -> Option[(Array[TypeExpr], TypeExpr)] = (env, trait_name, method_name) -> {\n  match trait_method_sig(env, trait_name, method_name) {\n    Some(sig) => Some(sig),\n    None => {\n      let supers = trait_supers(env, trait_name)\n      let mut i = 0\n      let mut result = None\n      while i < Array::length(supers) {\n        let pending = match result {\n          None => true,\n          _ => false\n        }\n        if pending {\n          match trait_method_sig_deep(env, Array::get(supers, i), method_name) {\n            Some(sig) => {\n              result = Some(sig)\n            },\n            None => ()\n          }\n        } else {\n          ()\n        }\n        i = i + 1\n      }\n      result\n    }\n  }\n}\n\n// Collect the trait bounds recorded for a specific type variable id in the\n// current substitution (`subst_add_bound` entries). Used to resolve a\n// `T::method` call where `T` is a bounded generic parameter.\nexport let subst_bounds_for: (Subst, Int) -> Array[String] = (s, id) -> {\n  let out = ArrayBuilder::new()\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if bid == id {\n          let mut i = 0\n          while i < Array::length(bounds) {\n            ArrayBuilder::push(out, Array::get(bounds, i))\n            i = i + 1\n          }\n        } else {\n          ()\n        }\n        cur = rest\n      },\n      SubstCached(_, bounds_cache, rest) => {\n        let key = __to_string(id)\n        if Map::has_key(bounds_cache, key) {\n          let bounds = Map::get(bounds_cache, key)\n          let mut i = 0\n          while i < Array::length(bounds) {\n            ArrayBuilder::push(out, Array::get(bounds, i))\n            i = i + 1\n          }\n        } else {\n          ()\n        }\n        cur = rest\n      },\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  ArrayBuilder::freeze(out)\n}\n\nlet rec array_has_int: (Array[Int], Int, Int) -> Bool = (arr, val, i) -> {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if Array::get(arr, i) == val {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet int_array_has: (Array[Int], Int) -> Bool = (arr, v) -> {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while !sdone {\n    if si >= slen {\n      sdone = true\n    } else if Array::get(arr, si) == v {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nlet is_effect_var_name: (String) -> Bool = (name) -> {\n  let len = String::length(name)\n  if len == 1 {\n    // a source-level effect variable: a single lowercase letter (`with { e }`)\n    String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\n  } else if len >= 2 {\n    // a FRESH effect variable minted by `instantiate` (`$N`): no real effect\n    // name starts with `$`, so this marker is unambiguous.\n    String::char_code_at(name, 0) == 36\n  } else {\n    false\n  }\n}\n\n// Resolve an effect variable name through the effect-binding chain (transitively\n// following var->var links). Returns the bound effect-label string (\"\" = pure)\n// or None if the variable is unbound.\nlet rec subst_eff_lookup: (Subst, String) -> Option[String] = (s, name) -> {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      },\n      SubstEffBind(v, val, rest) => if v == name {\n        out = Some(val)\n        done = true\n      } else {\n        cur = rest\n      }\n    }\n  }\n  match out {\n    Some(val) => if is_effect_var_name(val) {\n      match subst_eff_lookup(s, val) {\n        Some(v2) => Some(v2),\n        None => Some(val)\n      }\n    } else {\n      Some(val)\n    },\n    None => None\n  }\n}\n\n// Resolve a CtFn effect annotation through the effect-binding chain: a bound\n// effect variable becomes its binding (an empty binding \"\" collapses to the\n// pure row `None`); anything else is returned unchanged.\nlet resolve_effect_opt: (Subst, Option[String]) -> Option[String] = (s, eff) -> {\n  match eff {\n    None => None,\n    Some(name) => if is_effect_var_name(name) {\n      match subst_eff_lookup(s, name) {\n        Some(val) => if String::length(val) == 0 {\n          None\n        } else {\n          Some(val)\n        },\n        None => eff\n      }\n    } else {\n      eff\n    }\n  }\n}\n\nexport let rec subst_apply: (Subst, Type) -> Type = (s, ty) -> {\n  match ty {\n    CtInt => ty,\n    CtBool => ty,\n    CtString => ty,\n    CtUnit => ty,\n    CtDouble => ty,\n    CtChar => ty,\n    CtBytes => ty,\n    CtUnknown => ty,\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while !done {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          },\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, effect_name) => {\n      let apply_params: (Array[Type]) -> Array[Type] = (items) -> {\n        let out = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(items) {\n          Array::push(out, subst_apply(s, Array::get(items, i)))\n          i = i + 1\n        }\n        out\n      }\n      CtFn(apply_params(params), subst_apply(s, ret), resolve_effect_opt(s, effect_name))\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtNamed(name, args) => CtNamed(name, for arg in args {\n      subst_apply(s, arg)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec trait_defined: (TypeEnv, String) -> Bool = (env, name) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string: (Type) -> String = (ty) -> {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while vi < vlen {\n        let v = String::concat(\"?t\", __to_string(Array::get(vars, vi)))\n        let next = if vi > 0 {\n          String::concat(vacc, String::concat(\" \", v))\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      String::concat(\"forall \", String::concat(vacc, String::concat(\". \", type_to_string(body))))\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => String::concat(\"Array[\", String::concat(type_to_string(elem), \"]\")),\n    CtOption(elem) => String::concat(\"Option[\", String::concat(type_to_string(elem), \"]\")),\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(name, String::concat(\"[\", String::concat(joined, \"]\")))\n    },\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      String::concat(\"(\", String::concat(joined, \")\"))\n    },\n    CtFn(params, ret, effect_name) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let mut i = 0\n      let mut joined = \"\"\n      while i < Array::length(parts) {\n        joined = if i > 0 {\n          String::concat(joined, String::concat(\", \", Array::get(parts, i)))\n        } else Array::get(parts, i)\n        i = i + 1\n      }\n      let ret_text = type_to_string(ret)\n      let base = String::concat(\"(\", String::concat(joined, String::concat(\") -> \", ret_text)))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with {\", String::concat(name, \"}\"))),\n        None => base\n      }\n    }\n  }\n}\n\nlet empty_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nexport let env_lookup_flat: (Array[(String, Type)], String) -> Option[Type] = (bindings, name) -> {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nexport let resolve_builtin: (String) -> Option[Type] = (name) -> {\n  if name == \"Int\" || name == \"i32\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" || name == \"f64\" || name == \"Float\" || name == \"f32\" {\n    // The selfhost type system has no distinct 32-bit float: `Float` is\n    // unified with `Double` (codegen is f64-only, and float literals such as\n    // `0.0f` are already typed CtDouble). Without this, `Float` resolved to an\n    // opaque CtNamed and `x < 0.0f` mismatched (Float vs Double).\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else if name == \"V128\" {\n    // #536: first-class WebAssembly 128-bit SIMD type. Represented structurally\n    // as CtNamed(\"V128\", []) (no core Type enum variant), mirroring how\n    // Future/Stream/Task are represented; a V128 value is a tagged pointer to a\n    // 16-byte heap box (see codegen in compile_call.vibe).\n    Some(CtNamed(\"V128\", empty_type_args()))\n  }\n  else if name == \"i64\"\n  || name == \"u8\"\n  || name == \"u16\"\n  || name == \"u32\"\n  || name == \"u64\"\n  || name == \"i16\"\n  || name == \"v128\" {\n    Some(CtNamed(name, empty_type_args()))\n  }\n  else None\n}\n\nexport let subst_add_bound: (Subst, Int, Array[String]) -> Subst = (s, id, bounds) -> {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds: () -> Array[(Int, Array[String])] = () -> {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet rec int_bounds_has_id: (Array[(Int, Array[String])], Int, Int) -> Bool = (pairs, id, i) -> {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if pid == id {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup: (Array[(Int, Array[String])], Int, Int) -> Array[String] = (pairs, id, i) -> {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if pid == id {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_int_lookup_or: (Array[(Int, Int)], Int, Int, Int) -> Int = (pairs, key, fallback, i) -> {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if k == key {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\n// #626 criterion 4: collect the distinct effect-VARIABLE names appearing in a\n// type scheme body (lone `with { e }` annotations), so `instantiate` can mint a\n// fresh variable per use site and effect polymorphism survives unification.\nlet rec collect_effect_vars_walk: (Type, Array[String]) -> Int = (t, out) -> {\n  match t {\n    CtFn(params, ret, eff) => {\n      match eff {\n        Some(name) => if is_effect_var_name(name) {\n          let mut seen = false\n          let mut k = 0\n          while k < Array::length(out) {\n            if Array::get(out, k) == name {\n              seen = true\n            }\n            k = k + 1\n          }\n          if !seen {\n            Array::push(out, name)\n          }\n        },\n        None => ()\n      }\n      for p in params {\n        let _ = collect_effect_vars_walk(p, out)\n      }\n      collect_effect_vars_walk(ret, out)\n    },\n    CtArray(elem) => collect_effect_vars_walk(elem, out),\n    CtOption(elem) => collect_effect_vars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_effect_vars_walk(e, out)\n      }\n      0\n    },\n    CtNamed(_, args) => {\n      for a in args {\n        let _ = collect_effect_vars_walk(a, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_effect_vars_walk(body, out),\n    _ => 0\n  }\n}\n\nlet rename_eff_name: (String, Array[(String, String)]) -> String = (name, pairs) -> {\n  let mut i = 0\n  let mut out = name\n  while i < Array::length(pairs) {\n    let (k, v) = Array::get(pairs, i)\n    if k == name {\n      out = v\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet rec rename_effect_vars: (Type, Array[(String, String)]) -> Type = (t, pairs) -> {\n  match t {\n    CtFn(params, ret, eff) => {\n      let new_params = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(params) {\n        Array::push(new_params, rename_effect_vars(Array::get(params, i), pairs))\n        i = i + 1\n      }\n      let new_eff = match eff {\n        Some(name) => Some(rename_eff_name(name, pairs)),\n        None => None\n      }\n      CtFn(new_params, rename_effect_vars(ret, pairs), new_eff)\n    },\n    CtArray(elem) => CtArray(rename_effect_vars(elem, pairs)),\n    CtOption(elem) => CtOption(rename_effect_vars(elem, pairs)),\n    CtTuple(elems) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(elems) {\n        Array::push(out, rename_effect_vars(Array::get(elems, i), pairs))\n        i = i + 1\n      }\n      CtTuple(out)\n    },\n    CtNamed(name, args) => {\n      let out = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(args) {\n        Array::push(out, rename_effect_vars(Array::get(args, i), pairs))\n        i = i + 1\n      }\n      CtNamed(name, out)\n    },\n    _ => t\n  }\n}\n\nexport let instantiate: (Type, Int) -> (Type, Int, Array[(Int, Array[String])]) = (ty, c) -> {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      // #743: fresh ids must not overlap the scheme's OLD bound ids. An\n      // IMPORTED scheme carries bound-var ids from the EXPORTING module's\n      // counter domain (FS-compile checks modules separately and caches\n      // their envs), so the importing module's counter c can be ≤ an old id.\n      // A fresh id equal to another old bound id makes subst_apply's\n      // transitive var resolution chain old→fresh→fresh' and COLLAPSES two\n      // distinct scheme vars into one — `Err` from the prelude instantiated\n      // as `(E) -> Result[E, E]` whenever exactly one extra type var had\n      // been allocated before the use site (json_parse's #743).\n      let mut bnc = c\n      let mut bmax_i = 0\n      while bmax_i < blen {\n        let bold = Array::get(bound_vars, bmax_i)\n        if bold >= bnc {\n          bnc = bold + 1\n        } else {\n          ()\n        }\n        bmax_i = bmax_i + 1\n      }\n      while bi < blen {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      let inst_body = subst_apply(inst_s, body)\n      // #626 criterion 4: freshen the scheme's effect variables so each use site\n      // gets its own variable. Without this, binding `e` at one call site would\n      // leak to every other call (effect polymorphism would collapse to the\n      // first concrete effect). Fresh names are `$<counter>` (never a real\n      // effect name), threaded through the same counter as type variables.\n      let eff_vars = Array::slice([\n        \"\"\n      ], 0, 0)\n      let _ = collect_effect_vars_walk(inst_body, eff_vars)\n      let eff_pairs = Array::slice([\n        (\"\", \"\")\n      ], 0, 0)\n      let mut ev_i = 0\n      let mut ev_c = c1\n      while ev_i < Array::length(eff_vars) {\n        let ev = Array::get(eff_vars, ev_i)\n        Array::push(eff_pairs, (ev, String::concat(\"$\", __to_string(ev_c))))\n        ev_c = ev_c + 1\n        ev_i = ev_i + 1\n      }\n      let final_body = if Array::length(eff_pairs) == 0 {\n        inst_body\n      } else {\n        rename_effect_vars(inst_body, eff_pairs)\n      }\n      (final_body, ev_c, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let rec trait_is_subtrait: (TypeEnv, String, String) -> Bool = (env, sub, super_name) -> {\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while !sdone {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec collect_tvars_walk: (Type, Array[Int]) -> Int = (t, out) -> {\n  match t {\n    CtVar(id) => {\n      if !array_has_int(out, id, 0) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars: (Type) -> Array[Int] = (ty) -> {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nlet empty_env_bindings: () -> Array[(String, Type)] = () -> {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings: (TypeEnv) -> Array[(String, Type)] = (env) -> {\n  match env {\n    EnvFlat(bindings) => bindings,\n    _ => {\n      let out = empty_env_bindings()\n      let mut cur = env\n      let mut done = false\n      while !done {\n        match cur {\n          EnvEmpty => {\n            done = true\n          },\n          EnvBind(name, ty, rest) => {\n            Array::push(out, (name, ty))\n            cur = rest\n          },\n          EnvTraitDef(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImpl(_, _, rest) => {\n            cur = rest\n          },\n          EnvTraitImplGen(_, _, _, _, rest) => {\n            cur = rest\n          },\n          EnvFlat(bindings) => {\n            let mut j = 0\n            while j < Array::length(bindings) {\n              Array::push(out, Array::get(bindings, j))\n              j = j + 1\n            }\n            done = true\n          },\n          EnvCached(_, rest) => {\n            cur = rest\n          }\n        }\n      }\n      out\n    }\n  }\n}\n\nlet string_array_equal: (Array[String], Array[String]) -> Bool = (left, right) -> {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else if Array::get(left, i) != Array::get(right, i) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet option_string_equal: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  match left {\n    Some(left_name) => match right {\n      Some(right_name) => left_name == right_name,\n      None => false\n    },\n    None => match right {\n      Some(_) => false,\n      None => true\n    }\n  }\n}\n\n// #626 criterion 3: an effect annotation `with { A, B }` is an unordered SET,\n// but `collect_effect_names` joins it source-order into one string (\"A, B\"),\n// so `{ A, B }` and `{ B, A }` serialize to different strings. Split the\n// comma-separated annotation back into its labels (trimmed, deduplicated) so\n// equality can be decided on the set, not the raw ordered string.\nlet effect_label_list: (Option[String]) -> Array[String] = (eff) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  match eff {\n    None => out,\n    Some(s) => {\n      let raw = String::split(s, \",\")\n      let mut i = 0\n      while i < Array::length(raw) {\n        let label = String::trim(Array::get(raw, i))\n        if String::length(label) > 0 {\n          let mut seen = false\n          let mut j = 0\n          while j < Array::length(out) {\n            if Array::get(out, j) == label {\n              seen = true\n            }\n            j = j + 1\n          }\n          if !seen {\n            Array::push(out, label)\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n  }\n}\n\nlet effect_label_sets_equal: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  let ls = effect_label_list(left)\n  let rs = effect_label_list(right)\n  if Array::length(ls) != Array::length(rs) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(ls) {\n      let label = Array::get(ls, i)\n      let mut found = false\n      let mut j = 0\n      while j < Array::length(rs) {\n        if Array::get(rs, j) == label {\n          found = true\n        }\n        j = j + 1\n      }\n      if !found {\n        ok = false\n      }\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet effect_opt_is_var: (Option[String]) -> Bool = (eff) -> {\n  match eff {\n    Some(name) => is_effect_var_name(name),\n    None => false\n  }\n}\n\nlet effect_names_compatible: (Option[String], Option[String]) -> Bool = (left, right) -> {\n  if option_string_equal(left, right) {\n    true\n  } else if effect_opt_is_var(left) {\n    // #626 criterion 4: an effect variable is NO LONGER a wildcard. It equals\n    // only itself (handled by `option_string_equal` above); a variable vs a\n    // different effect is reported NOT-equal here so that `unify`'s structural\n    // `types_equal` fast path falls through to the `CtFn` arm, where\n    // `unify_effects` records the actual binding (and detects a later conflict).\n    false\n  } else if effect_opt_is_var(right) {\n    false\n  } else {\n    // Neither side is an effect variable: decide on the unordered label set, so\n    // `{ A, B }` and `{ B, A }` (and `{ A, A }` vs `{ A }`) are compatible\n    // (criterion 3). `None` (pure) vs `Some(concrete)` differ in set size and\n    // stay incompatible.\n    effect_label_sets_equal(left, right)\n  }\n}\n\n// Unify two effect annotations, binding an effect VARIABLE to the other side\n// (#626 criterion 4 — no longer an unconditional wildcard). Returns the extended\n// substitution, or None on a genuine effect-set conflict.\nlet unify_effects: (Option[String], Option[String], Subst) -> Option[Subst] = (ea, eb, s) -> {\n  let ra = resolve_effect_opt(s, ea)\n  let rb = resolve_effect_opt(s, eb)\n  let a_is_var = match ra {\n    Some(n) => is_effect_var_name(n),\n    None => false\n  }\n  let b_is_var = match rb {\n    Some(n) => is_effect_var_name(n),\n    None => false\n  }\n  if a_is_var {\n    match ra {\n      Some(av) => if Some(av) == rb {\n        Some(s)\n      } else {\n        let bval = match rb {\n          Some(bv) => bv,\n          None => \"\"\n        }\n        Some(SubstEffBind(av, bval, s))\n      },\n      None => Some(s)\n    }\n  } else if b_is_var {\n    match rb {\n      Some(bv) => {\n        let aval = match ra {\n          Some(av) => av,\n          None => \"\"\n        }\n        Some(SubstEffBind(bv, aval, s))\n      },\n      None => Some(s)\n    }\n  } else if effect_names_compatible(ra, rb) {\n    Some(s)\n  } else {\n    None\n  }\n}\n\nexport let rec types_equal: (Type, Type) -> Bool = (a, b) -> {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      // A bare named type `CtNamed(X, [])` (zero type args) denotes the same\n      // type as the enum `CtEnum(X)`. Cross-module imports can resolve a\n      // self-referential enum ctor field type to one form and a function\n      // annotation to the other; bridge them so they unify.\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      CtNamed(bname, bargs) => aname == bname && Array::length(bargs) == 0,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtEnum(bname) => aname == bname && Array::length(aargs) == 0,\n      CtStruct(bname) => aname == bname && Array::length(aargs) == 0,\n      CtNamed(bname, bargs) =>\n      if aname != bname {\n        false\n      } else if Array::length(aargs) != Array::length(bargs) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while !tae_done {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else {\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\n              tae_i = tae_i + 1\n            } else {\n              tae_result = false\n              tae_done = true\n            }\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if Array::length(aelems) != Array::length(belems) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while !tae_done2 {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else {\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\n              tae_i2 = tae_i2 + 1\n            } else {\n              tae_result2 = false\n              tae_done2 = true\n            }\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, aeffect) => match b {\n      CtFn(bparams, bret, beffect) =>\n      if Array::length(aparams) != Array::length(bparams) {\n        false\n      } else if effect_names_compatible(aeffect, beffect) {\n        let tae_len3 = Array::length(aparams)\n        let mut tae_i3 = 0\n        let mut tae_result3 = true\n        let mut tae_done3 = false\n        while !tae_done3 {\n          if tae_i3 >= tae_len3 {\n            tae_done3 = true\n          } else {\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\n              tae_i3 = tae_i3 + 1\n            } else {\n              tae_result3 = false\n              tae_done3 = true\n            }\n          }\n        }\n        if tae_result3 {\n          types_equal(aret, bret)\n        } else {\n          false\n        }\n      } else {\n        false\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\n        false\n      } else if Array::length(abounds) != Array::length(bbounds) {\n        false\n      } else {\n        let vlen = Array::length(avars)\n        let mut vi = 0\n        let mut vresult = true\n        let mut vdone = false\n        while !vdone {\n          if vi >= vlen {\n            vdone = true\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\n            vresult = false\n            vdone = true\n          } else {\n            vi = vi + 1\n          }\n        }\n        if vresult {\n          let fbe_len = Array::length(abounds)\n          let mut fbe_i = 0\n          let mut fbe_result = true\n          let mut fbe_done = false\n          while !fbe_done {\n            if fbe_i >= fbe_len {\n              fbe_done = true\n            } else {\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n              if lvar != rvar {\n                fbe_result = false\n                fbe_done = true\n              } else if Array::length(lbounds) != Array::length(rbounds) {\n                fbe_result = false\n                fbe_done = true\n              } else {\n                if string_array_equal(lbounds, rbounds) {\n                  fbe_i = fbe_i + 1\n                } else {\n                  fbe_result = false\n                  fbe_done = true\n                }\n              }\n            }\n          }\n          if fbe_result {\n            types_equal(abody, bbody)\n          } else {\n            false\n          }\n        } else {\n          false\n        }\n      }\n      ,\n      _ => false\n    }\n  }\n}\n\nexport let rec unify: (Type, Type, Subst) -> Option[Subst] = (a, b, s) -> {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, aeffect) => match tb {\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while !ul_done {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    // #626 criterion 4: unify params, then the return type, then\n                    // the EFFECT row — binding an effect variable to the other\n                    // side (or failing on a genuine effect conflict) instead of\n                    // the old unconditional-wildcard accept.\n                    match ul_result {\n                      Some(s2) => match unify(ra, rb, s2) {\n                        Some(s3) => unify_effects(aeffect, beffect, s3),\n                        None => None\n                      },\n                      None => None\n                    }\n                  },\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while !ul_done2 {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  },\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  // Bridge `CtEnum(X)` with `CtNamed(X, args)` of any arity: an\n                  // enum VALUE carries no type args (constructors yield a bare\n                  // CtEnum), so it must still unify by name with an applied\n                  // annotation like `Result[U, E]`.\n                  CtNamed(b_name, _) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name == b_name && Array::length(b_args) == 0 {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  // Symmetric to the CtEnum bridge: an applied `CtNamed(X, args)`\n                  // unifies with the bare enum value `CtEnum(X)` by name.\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  CtStruct(b_name) => if a_name == b_name && Array::length(a_args) == 0 {\n                    Some(s)\n                  } else None,\n                  CtNamed(b_name, b_args) => if a_name != b_name {\n                    None\n                  }\n                  else if Array::length(a_args) != Array::length(b_args) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while !ul_done3 {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  },\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let types_compatible: (Type, Type) -> Bool = (expected, actual) -> {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for: (TypeEnv, String, Type) -> Bool = (env, trait_name, new_target) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nlet rec type_implements_check_env: (TypeEnv, String, Type) -> Bool = (e, trait_name, resolved) -> {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport let collect_subst_bounds_pairs: (Subst) -> Array[(Int, Array[String])] = (s) -> {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while !done {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if !int_bounds_has_id(out, id, 0) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      },\n      SubstCached(_, _, rest) => {\n        cur = rest\n      },\n      SubstEffBind(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let generalize: (Subst, Type) -> Type = (s, ty) -> {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if Array::length(tvars) == 0 {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if Array::length(bounds) != 0 {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nlet rec type_implements_check_super: (TypeEnv, TypeEnv, String, Type) -> Bool = (e2, full_env, trait_name, resolved) -> {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\n// Constructor/head name of a type, for matching a generic impl's erased target\n// against a concrete type (`Array[Int]` and the impl target `Array` both have\n// head \"Array\"). Returns \"\" for types with no nominal constructor (tuples,\n// primitives, vars) so they never match a generic impl.\nlet type_constructor_name: (Type) -> String = (ty) -> {\n  match ty {\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtNamed(n, _) => n,\n    CtStruct(n) => n,\n    CtEnum(n) => n,\n    _ => \"\"\n  }\n}\n\n// True iff `trait_name` declares at least one method (a method-bearing trait).\n// Marker traits (Eq/Ord/Add/…, declared `trait Eq` with no body) and undeclared\n// bound names (e.g. `Iterable`) return false. This is the soundness gate for\n// generic-impl resolution: a method-bearing trait dispatches through the threaded\n// witness dictionary (so a generic impl runs the correct per-type method),\n// whereas a marker trait \"dispatches\" via a builtin operator (`==`, `<`) that\n// does NOT structurally handle a container — so matching a marker-trait generic\n// impl would let `==` be used on e.g. `Option[Int]` where it silently misbehaves.\nlet rec trait_is_method_bearing: (TypeEnv, String) -> Bool = (env, trait_name) -> {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvTraitDef(tname, _, _, methods, rest) => if tname == trait_name {\n      Array::length(methods) > 0\n    } else trait_is_method_bearing(rest, trait_name),\n    EnvTraitImpl(_, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_is_method_bearing(rest, trait_name),\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => trait_is_method_bearing(rest, trait_name)\n  }\n}\n\n// True iff a type-parameter bound list carries no real trait bound (only the\n// empty / `\"\"` sentinel entries). Increment A of generic-impl support matches\n// the per-parameter trait bounds of a generic impl. Increment A (`impl [T]\n// Trait for C`) has empty bounds; Increment B (`impl [T: Bound] Trait for\n// C[T]`) carries them and is satisfied only when every type argument of the\n// concrete type satisfies them — a dictionary-of-dictionaries: `C[K]: Trait`\n// iff `K: Bound`.\n\n// Type arguments of a (possibly generic) type, for checking a generic impl's\n// per-parameter bounds against the concrete element types.\nlet type_args_of: (Type) -> Array[Type] = (ty) -> {\n  match ty {\n    CtArray(e) => Array::slice([\n      e\n    ], 0, 1),\n    CtOption(e) => Array::slice([\n      e\n    ], 0, 1),\n    CtNamed(_, args) => args,\n    _ => Array::slice([\n      CtUnit\n    ], 0, 0)\n  }\n}\n\n// Does an in-env method-bearing generic impl `impl [T(: Bound)?] Trait for C`\n// cover the concrete `resolved` type? Matched by constructor name (the impl\n// target's args are erased); for a bounded impl, EVERY type argument of\n// `resolved` must satisfy EVERY bound (recursively via `type_implements_trait`),\n// which is the dictionary-of-dictionaries condition. The dict-passing desugar\n// synthesizes a `{ method: C::method }` witness (unbounded) or a nested closure\n// witness supplying the element dict (bounded). (#5 generic impls.)\nlet rec generic_impl_satisfies: (TypeEnv, TypeEnv, Subst, String, Type) -> Bool = (scan, full, s, trait_name, resolved) -> {\n  match scan {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitDef(_, _, _, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitImpl(_, _, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved),\n    EnvTraitImplGen(itrait, _tparams, bounds, target, rest) => {\n      let head = type_constructor_name(resolved)\n      let shape_ok = itrait == trait_name && head != \"\" && type_constructor_name(target) == head && trait_is_method_bearing(full, trait_name)\n      if shape_ok && generic_bounds_hold(full, s, bounds, type_args_of(resolved)) {\n        true\n      } else generic_impl_satisfies(rest, full, s, trait_name, resolved)\n    },\n    EnvFlat(_) => false,\n    EnvCached(_, rest) => generic_impl_satisfies(rest, full, s, trait_name, resolved)\n  }\n}\n\n// Every non-empty per-parameter bound is satisfied by every concrete type\n// argument. Empty bound lists (Increment A) hold trivially.\nlet rec generic_bounds_hold: (TypeEnv, Subst, Array[(String, Array[String])], Array[Type]) -> Bool = (full, s, bounds, args) -> {\n  let mut bi = 0\n  let mut ok = true\n  while bi < Array::length(bounds) {\n    let (_, btraits) = Array::get(bounds, bi)\n    let mut ti = 0\n    while ti < Array::length(btraits) {\n      let bt = Array::get(btraits, ti)\n      if bt != \"\" {\n        let mut ai = 0\n        while ai < Array::length(args) {\n          // A still-unknown element type (e.g. a struct literal, which the\n          // checker types as `CtUnknown`) defers its bound to the dict-passing\n          // desugar — which infers the element type syntactically and either\n          // threads the nested witness or fails loudly. This mirrors how a\n          // `CtUnknown` receiver skips the top-level bound check, so accepting\n          // it here is no less sound.\n          match subst_apply(s, Array::get(args, ai)) {\n            CtUnknown => (),\n            _ => if not(type_implements_trait(full, s, Array::get(args, ai), bt)) {\n              ok = false\n            } else {\n              ()\n            }\n          }\n          ai = ai + 1\n        }\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    bi = bi + 1\n  }\n  ok\n}\n\nexport let rec type_implements_trait: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, trait_name) -> {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else if generic_impl_satisfies(env, env, s, trait_name, resolved) {\n    true\n  }\n  else {\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if slen == 0 {\n      false\n    }\n    else {\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")
}

let cli_adapter_source_4 = () -> (String, String) {
  ("vibe/compiler/core/dce.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet clone_arr: (Array[String]) -> Array[String] = (arr) -> {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name: (Stmt) -> Option[String] = (stmt) -> {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet dce_array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {\n  let len = Array::length(arr)\n  let rec search: (Int) -> Bool = (i) -> {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref: (Array[String], Array[String], String) -> Int = (out, bound, name) -> {\n  if not(dce_array_contains_str(bound, name)) {\n    if not(dce_array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings: (Pat, Array[String]) -> Int = (pat, bound) -> {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PFloat(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    },\n    PStruct(_, _) => 0\n  }\n}\n\nlet rec collect_refs_into: (Expr, Array[String], Array[String]) -> Int = (expr, bound, out) -> {\n  match expr {\n    EIdent(name, _) => add_ref(out, bound, name),\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out),\n    EReturn(e) => collect_refs_into(e, bound, out),\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args, _) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs: (Expr, Array[String]) -> Array[String] = (expr, bound) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet enqueue_reachable: (Array[String], Array[String], String) -> Unit = (reachable, queue, name) -> {\n  if not(dce_array_contains_str(reachable, name)) {\n    Array::push(reachable, name)\n    Array::push(queue, name)\n  }\n}\n\nlet collect_structural_refs_into_queue: (Stmt, Array[String], Array[String], Array[String]) -> Unit = (stmt, bound, reachable, queue) -> {\n  let refs = match stmt {\n    STest(_, expr) => collect_refs(expr, bound),\n    SBench(_, expr) => collect_refs(expr, bound),\n    SExpr(expr) => collect_refs(expr, bound),\n    _ => Array::slice([\n      \"\"\n    ], 0, 0)\n  }\n  let mut i = 0\n  while i < Array::length(refs) {\n    enqueue_reachable(reachable, queue, Array::get(refs, i))\n    i = i + 1\n  }\n}\n\nlet is_type_or_structural: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SEnum(_, _, _, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SEffectDef(_, _, _, _) => true,\n    SStruct(_, _, _, _, _) => true,\n    STypeAlias(_, _, _, _) => true,\n    STrait(_, _, _, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    SAliasDecl(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, entry_names) -> {\n  // Early-return on empty input: downstream code uses\n  //   `Array::slice([Array::get(stmts, 0)], 0, 0)`\n  // to construct a typed empty `Array[Stmt]`, which traps out-of-bounds\n  // when stmts itself is empty. (See `dce_test.vibe: \"empty stmts\n  // returns empty\"`, tracked in #266.)\n  if Array::length(stmts) == 0 {\n    Array::slice(stmts, 0, 0)\n  } else {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if dce_array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        },\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n  }\n}\n\n// Compute the set of reachable top-level names from `entry_names`, following\n// value-definition refs and structural (type/test/expr) refs to a fixpoint.\n// Mirrors the reachability computation inside `dce_stmts`; kept as a separate\n// (currently unwired) function so module-source emission can reuse it without\n// changing `dce_stmts` (a bootstrap-reachable hot path).\nlet dce_reachable_names: (Array[Stmt], Array[String]) -> Array[String] = (stmts, entry_names) -> {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    enqueue_reachable(reachable, queue, name)\n    j = j + 1\n  }\n  let mut sj = 0\n  while sj < Array::length(stmts) {\n    collect_structural_refs_into_queue(Array::get(stmts, sj), empty_bound, reachable, queue)\n    sj = sj + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(dce_array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  reachable\n}\n\n// Whether DCE keeps `stmt` given the reachable name set: type/structural\n// statements are always kept; named value defs are kept iff reachable; unnamed\n// statements are kept. (Same per-statement rule `dce_stmts` applies.)\nlet dce_keep_stmt: (Stmt, Array[String]) -> Bool = (stmt, reachable) -> {\n  if is_type_or_structural(stmt) {\n    true\n  } else {\n    match stmt_name(stmt) {\n      Some(name) => dce_array_contains_str(reachable, name),\n      None => true\n    }\n  }\n}\n\n// Per-original-index keep flags from DCE, parallel to `stmts`. Lets callers\n// (e.g. module-source emission) map surviving statements back to their source\n// spans without relying on statement identity/equality. Result length equals\n// `Array::length(stmts)`.\nexport let dce_keep_flags: (Array[Stmt], Array[String]) -> Array[Bool] = (stmts, entry_names) -> {\n  let flags = Array::slice([\n    true\n  ], 0, 0)\n  if Array::length(stmts) == 0 {\n    flags\n  } else {\n    let reachable = dce_reachable_names(stmts, entry_names)\n    let mut m = 0\n    while m < Array::length(stmts) {\n      Array::push(flags, dce_keep_stmt(Array::get(stmts, m), reachable))\n      m = m + 1\n    }\n    flags\n  }\n}\n")
}

