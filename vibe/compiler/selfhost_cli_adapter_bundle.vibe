}

let cli_adapter_source_158 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_loop.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr\n}\n\n//# Functions\n\nlet concat_exprs: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, lhs)\n  ArrayBuilder::push(b, rhs)\n  let args = ArrayBuilder::freeze(b)\n  ECall(EIdent(\"String::concat\", -1), args, -1)\n}\n\nexport let fold_interp_exprs_loop: (Array[Expr], Int, Expr, Int) -> Expr = (result_arr, result_len, result0, j0) -> {\n  let mut result = result0\n  let mut j = j0\n  while j < result_len {\n    let rhs = Array::get(result_arr, j)\n    result = concat_exprs(result, rhs)\n    j = j + 1\n  }\n  result\n}\n")
}

let cli_adapter_source_159 = () -> (String, String) {
