), CtFn(array_one_param(CtUnknown), CtUnknown, None)),\n      CtArray(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_fold: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::fold\" {\n    Some(CtFn(\n      array_three_params(\n        CtArray(CtUnknown),\n        CtUnknown,\n        CtFn(array_two_params(CtUnknown, CtUnknown), CtUnknown, None)\n      ),\n      CtUnknown,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_filter: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::filter\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtArray(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_foreach: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::foreach\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtUnit, None)),\n      CtUnit,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_reverse: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::reverse\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_any: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::any\" || name == \"Array::all\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtBool,\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_find: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::find\" {\n    Some(CtFn(\n      array_two_params(CtArray(CtUnknown), CtFn(array_one_param(CtUnknown), CtBool, None)),\n      CtOption(CtUnknown),\n      None\n    ))\n  }\n  else None\n}\n\nlet lookup_array_sort: (String) -> Option[Type] = (name) -> {\n  if name == \"Array::sort\" {\n    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtArray(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_array_contains: (String) ->