let cli_adapter_source_118 = () -> (String, String) {
  ("vibe/compiler/runtime/eval_loader/index.vibe",
"//# Imports\n\nimport ../../syntax/lexer.vibe {\n  lex\n}\n\nimport ../../syntax/parser_expr.vibe {\n  parse\n}\n\nimport ../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet rec resolve_interp_expr: (Expr) -> Expr with { Error } = (expr) -> {\n  match expr {\n    EStringInterp(parts) => {\n      let plen = Array::length(parts)\n      let exprs = ArrayBuilder::new()\n      let mut i = 0\n      while i < plen {\n        let lit = Array::get(parts, i)\n        if String::length(lit) > 0 {\n          ArrayBuilder::push(exprs, EString(lit))\n        }\n        if i + 1 < plen {\n          let expr_src = Array::get(parts, i + 1)\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\n          ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n            resolved\n          ], -1))\n        }\n        i = i + 2\n      }\n      let out = ArrayBuilder::freeze(exprs)\n      let len = Array::length(out)\n      if len == 0 {\n        EString(\"\")\n      }\n      else {\n        let mut acc = Array::get(out, 0)\n        let mut j = 1\n        while j < len {\n          acc = ECall(EIdent(\"String::concat\", -1), [\n            acc,\n            Array::get(out, j)\n          ], -1)\n          j = j + 1\n        }\n        acc\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    EArray(elems) => EArray(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    ERecord(fields) => ERecord(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EMap(fields) => EMap(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\n    ELet(name, value, body) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetMut(name, value, body) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_interp_expr(init)) }, resolve_interp_expr(body)),\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\n    ECall(callee, args, off) => ECall(resolve_interp_expr(callee), for arg in args {\n      resolve_interp_expr(arg)\n    }, off),\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\n    EDot(inner, field, off) => EDot(resolve_interp_expr(inner), field, off),\n    EThrow(inner) => EThrow(resolve_interp_expr(inner)),\n    EReturn(inner) => EReturn(resolve_interp_expr(inner)),\n    EBreak(opt) => match opt {\n      None => expr,\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\n    },\n    EContinue(args) => EContinue(for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\n  }\n}\n\nlet resolve_interp_stmt: (Stmt) -> Stmt with { Error } = (stmt) -> {\n  match stmt {\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\n    _ => stmt\n  }\n}\n\nexport let contains_str: (Array[String], String) -> Bool = (arr, target) -> {\n  let rec go: (Int) -> Bool = (i) -> {\n    if i >= Array::length(arr) {\n      false\n    }\n    else {\n      if Array::get(arr, i) == target {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let source_lookup: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= Array::length(sources) {\n      None\n    }\n    else {\n      let (p, src) = Array::get(sources, i)\n      if p == path_key {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let load_and_parse: (String) -> Array[Stmt] with { Error } = (source) -> {\n  let tokens = lex(source)\n  for stmt in parse_program(tokens) {\n    resolve_interp_stmt(stmt)\n  }\n}\n\nexport let collect_exports: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  // Out-param accumulation: each match arm pushes directly into `out`.\n  // Previously each `Array::concat(acc, [x])` allocated and copied the\n  // entire growing prefix — total O(N^2) for N exports across the file.\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(true, _, name, _, _) => Array::push(out, name),\n      SEnum(true, _, _, variants, _) => {\n        let mut j = 0\n        while j < Array::length(variants) {\n          let (cname, _) = Array::get(variants, j)\n          Array::push(out, cname)\n          j = j + 1\n        }\n      },\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(out, Array::get(names, j))\n          j = j + 1\n        }\n      },\n      SReExport(_, names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          let (name, _) = Array::get(names, j)\n          Array::push(out, name)\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n")
}

