let empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}

let push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {
  let (path, source) = pair
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if String::equals(name, group_name) {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

  let source_0 = ("vibe/compiler/core/polyfill.vibe",
"//# Functions\n\nexport let __to_string = (n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = Array::slice([\n      \"\"\n    ], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 {\n        \"0\"\n      }\n      else if d == 1 {\n        \"1\"\n      }\n      else if d == 2 {\n        \"2\"\n      }\n      else if d == 3 {\n        \"3\"\n      }\n      else if d == 4 {\n        \"4\"\n      }\n      else if d == 5 {\n        \"5\"\n      }\n      else if d == 6 {\n        \"6\"\n      }\n      else if d == 7 {\n        \"7\"\n      }\n      else if d == 8 {\n        \"8\"\n      }\n      else {\n        \"9\"\n      }\n      Array::push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg {\n      \"-\"\n    } else {\n      \"\"\n    }\n    let mut i = Array::length(digits) - 1\n    while i >= 0 {\n      result = String::concat(result, Array::get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")

  let source_1 = ("vibe/compiler/core/bytebuf.vibe",
"//# Functions\n\nexport let bytebuf_new = () -> Array[Int] {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nexport let bytebuf_push = (buf: Array[Int], byte: Int) -> Unit {\n  Array::push(buf, byte)\n}\n\nexport let bytebuf_length = (buf: Array[Int]) -> Int {\n  Array::length(buf)\n}\n\nexport let bytebuf_to_bytes = (buf: Array[Int]) -> Bytes {\n  Bytes::from_array(buf)\n}\n\nexport let leb128_encode_s32 = (buf: Array[Int], value: Int) -> Unit {\n  if value >= (0 - 64) && value < 64 {\n    Array::push(buf, value&127)\n  } else {\n    if value >= (0 - 8192) && value < 8192 {\n      Array::push(buf, (value&127)|128)\n      Array::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = v>>7\n        if (v == 0) && ((byte&64) == 0) {\n          Array::push(buf, byte)\n          more = false\n        } else {\n          if (v == 0 - 1) && ((byte&64) != 0) {\n            Array::push(buf, byte)\n            more = false\n          } else {\n            Array::push(buf, byte|128)\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let leb128_encode_s64 = (buf: Array[Int], value: Int) -> Unit {\n  leb128_encode_s32(buf, value)\n}\n\nexport let leb128_encode_u32 = (buf: Array[Int], value: Int) -> Unit {\n  if value >= 0 && value < 128 {\n    Array::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Array::push(buf, (value&127)|128)\n      Array::push(buf, (value>>7)&127)\n    } else {\n      let mut v = value\n      let mut more = true\n      while more {\n        let byte = v&127\n        v = (v>>7)&((1<<25) - 1)\n        if v == 0 {\n          Array::push(buf, byte)\n          more = false\n        } else {\n          Array::push(buf, byte|128)\n        }\n      }\n    }\n  }\n}\n\nexport let bytebuf_push_array = (dst: Array[Int], src: Array[Int]) -> Unit {\n  Array::push_all(dst, src)\n}\n\nexport let bytebuf_push_bytes = (buf: Array[Int], bytes: Bytes) -> Unit {\n  let blen = Bytes::length(bytes)\n  let mut i = 0\n  while i < blen {\n    bytebuf_push(buf, bytes[i])\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push_section = (out: Array[Int], section_id: Int, content: Array[Int]) -> Unit {\n  bytebuf_push(out, section_id)\n  leb128_encode_u32(out, bytebuf_length(content))\n  bytebuf_push_buf(out, content)\n}\n\nexport let bytebuf_push_vec_header = (buf: Array[Int], count: Int) -> Unit {\n  leb128_encode_u32(buf, count)\n}\n\nexport let bytebuf_push_buf = (dst: Array[Int], src: Array[Int]) -> Unit {\n  Array::push_all(dst, src)\n}\n\nexport let bytebuf_push2 = (buf: Array[Int], b1: Int, b2: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n}\n\nexport let bytebuf_push3 = (buf: Array[Int], b1: Int, b2: Int, b3: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n}\n\nexport let bytebuf_push_opcode_u32 = (buf: Array[Int], opcode: Int, value: Int) -> Unit {\n  if value >= 0 && value < 128 {\n    Array::push(buf, opcode)\n    Array::push(buf, value)\n  } else {\n    if value >= 128 && value < 16384 {\n      Array::push(buf, opcode)\n      Array::push(buf, (value&127)|128)\n      Array::push(buf, (value>>7)&127)\n    } else {\n      Array::push(buf, opcode)\n      leb128_encode_u32(buf, value)\n    }\n  }\n}\n\nexport let bytebuf_push_opcode_s64 = (buf: Array[Int], opcode: Int, value: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_s32(buf, value)\n}\n\nexport let bytebuf_push_opcode_u32_u32 = (buf: Array[Int], opcode: Int, a: Int, b: Int) -> Unit {\n  bytebuf_push(buf, opcode)\n  leb128_encode_u32(buf, a)\n  leb128_encode_u32(buf, b)\n}\n\nexport let bytebuf_push_string = (buf: Array[Int], s: String) -> Unit {\n  let slen = String::length(s)\n  leb128_encode_u32(buf, slen)\n  let mut i = 0\n  while i < slen {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n}\n\nexport let bytebuf_push9 = (buf: Array[Int], b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {\n  bytebuf_push(buf, b1)\n  bytebuf_push(buf, b2)\n  bytebuf_push(buf, b3)\n  bytebuf_push(buf, b4)\n  bytebuf_push(buf, b5)\n  bytebuf_push(buf, b6)\n  bytebuf_push(buf, b7)\n  bytebuf_push(buf, b8)\n  bytebuf_push(buf, b9)\n}\n")

  let source_2 = ("vibe/compiler/core/ast.vibe",
"//# Types\n\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat)\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  ELoop(Array[(String, Expr)], Expr);\n  EForIn(String, Option[String], Expr, Expr);\n  ECall(Expr, Array[Expr]);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EMap(Array[(String, Expr)]);\n  ESpread(Expr);\n  EStringInterp(Array[String]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[(String, Array[TypeExpr])]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\n  STypeAlias(Bool, String, TypeExpr);\n  STrait(Bool, String, Array[String]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SModule(Bool, String, Array[Stmt])\n}\n")

  let source_3 = ("vibe/compiler/core/types.vibe",
"//# Types\n\nexport enum Type {\n  CtInt;\n  CtDouble;\n  CtBool;\n  CtString;\n  CtChar;\n  CtUnit;\n  CtTuple(Array[Type]);\n  CtArray(Type);\n  CtOption(Type);\n  CtFn(Array[Type], Type, Bool);\n  CtEnum(String);\n  CtStruct(String);\n  CtBytes;\n  CtNamed(String, Array[Type]);\n  CtVar(Int);\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\n  CtUnknown\n}\n\nexport enum TypeDef {\n  TDEnum(String, Array[(String, Array[Type])]);\n  TDStruct(String, Array[(String, Type)]);\n  TDAlias(String, Type)\n}\n\nexport enum TypeEnv {\n  EnvEmpty;\n  EnvBind(String, Type, TypeEnv);\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\n  EnvTraitImpl(String, Type, TypeEnv);\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv)\n}\n\nexport enum Subst {\n  SubstEmpty;\n  SubstBind(Int, Type, Subst);\n  SubstBound(Int, Array[String], Subst)\n}\n\n//# Functions\n\nexport let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {\n  EnvBind(name, ty, env)\n}\n\nexport let fresh_var = (c: Int) -> (Type, Int) {\n  (CtVar(c), c + 1)\n}\n\nexport let rec occurs_in = (id: Int, ty: Type) -> Bool {\n  match ty {\n    CtVar(vid) => (id == vid),\n    CtFn(params, ret, _) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(params) {\n        if occurs_in(id, Array::get(params, i)) {\n          found = true\n          i = Array::length(params)\n        } else {\n          i = i + 1\n        }\n      }\n      found || occurs_in(id, ret)\n    },\n    CtArray(elem) => occurs_in(id, elem),\n    CtOption(elem) => occurs_in(id, elem),\n    CtTuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if occurs_in(id, Array::get(elems, i)) {\n          found = true\n          i = Array::length(elems)\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    CtForAll(_, _, body) => occurs_in(id, body),\n    _ => false\n  }\n}\n\nexport let env_lookup = (env: TypeEnv, name: String) -> Option[Type] {\n  let mut cur = env\n  let mut result : Option[Type] = None\n  let mut done = false\n  while !done {\n    match cur {\n      EnvEmpty => { done = true },\n      EnvBind(n, ty, rest) => if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, rest) => { cur = rest },\n      EnvTraitImpl(_, _, rest) => { cur = rest },\n      EnvTraitImplGen(_, _, _, _, rest) => { cur = rest }\n    }\n  }\n  result\n}\n\nlet empty_env_bindings = () -> Array[(String, Type)] {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {\n  let out = empty_env_bindings()\n  let mut cur = env\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      EnvEmpty => {\n        done = true\n      },\n      EnvBind(name, ty, rest) => {\n        Array::push(out, (name, ty))\n        cur = rest\n      },\n      EnvTraitDef(_, _, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImpl(_, _, rest) => {\n        cur = rest\n      },\n      EnvTraitImplGen(_, _, _, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nexport let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let (n, ty) = Array::get(bindings, i)\n      if n == name {\n        result = Some(ty)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet join_types = (arr: Array[String], sep: String) -> String {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut acc = \"\"\n  while (!(i >= len)) {\n    let s = if i > 0 {\n      \"\\{acc}\\{sep}\\{Array::get(arr, i)}\"\n    } else Array::get(arr, i)\n    acc = s\n    i = i + 1\n  }\n  acc\n}\n\nlet string_array_equal = (left: Array[String], right: Array[String]) -> Bool {\n  let len = Array::length(left)\n  let mut i = 0\n  let mut result = true\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else if (!(Array::get(left, i) == Array::get(right, i))) {\n      result = false\n      done = true\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nexport let rec types_equal = (a: Type, b: Type) -> Bool {\n  match a {\n    CtInt => match b {\n      CtInt => true,\n      _ => false\n    },\n    CtDouble => match b {\n      CtDouble => true,\n      _ => false\n    },\n    CtBool => match b {\n      CtBool => true,\n      _ => false\n    },\n    CtString => match b {\n      CtString => true,\n      _ => false\n    },\n    CtChar => match b {\n      CtChar => true,\n      _ => false\n    },\n    CtUnit => match b {\n      CtUnit => true,\n      _ => false\n    },\n    CtBytes => match b {\n      CtBytes => true,\n      _ => false\n    },\n    CtUnknown => match b {\n      CtUnknown => true,\n      _ => false\n    },\n    CtVar(aid) => match b {\n      CtVar(bid) => (aid == bid),\n      _ => false\n    },\n    CtArray(aelem) => match b {\n      CtArray(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtOption(aelem) => match b {\n      CtOption(belem) => types_equal(aelem, belem),\n      _ => false\n    },\n    CtEnum(aname) => match b {\n      CtEnum(bname) => aname == bname,\n      _ => false\n    },\n    CtStruct(aname) => match b {\n      CtStruct(bname) => aname == bname,\n      _ => false\n    },\n    CtNamed(aname, aargs) => match b {\n      CtNamed(bname, bargs) =>\n      if (!(aname == bname)) {\n        false\n      } else if (Array::length(aargs) != Array::length(bargs)) {\n        false\n      } else {\n        let tae_len = Array::length(aargs)\n        let mut tae_i = 0\n        let mut tae_result = true\n        let mut tae_done = false\n        while (!(tae_done)) {\n          if tae_i >= tae_len {\n            tae_done = true\n          } else if (!(types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)))) {\n            tae_result = false\n            tae_done = true\n          } else {\n            tae_i = tae_i + 1\n          }\n        }\n        tae_result\n      },\n      _ => false\n    },\n    CtTuple(aelems) => match b {\n      CtTuple(belems) =>\n      if (Array::length(aelems) != Array::length(belems)) {\n        false\n      } else {\n        let tae_len2 = Array::length(aelems)\n        let mut tae_i2 = 0\n        let mut tae_result2 = true\n        let mut tae_done2 = false\n        while (!(tae_done2)) {\n          if tae_i2 >= tae_len2 {\n            tae_done2 = true\n          } else if (!(types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)))) {\n            tae_result2 = false\n            tae_done2 = true\n          } else {\n            tae_i2 = tae_i2 + 1\n          }\n        }\n        tae_result2\n      },\n      _ => false\n    },\n    CtFn(aparams, aret, ahas_error) => match b {\n      CtFn(bparams, bret, bhas_error) =>\n      if (Array::length(aparams) != Array::length(bparams)) {\n        false\n      } else if ahas_error {\n        if (!(bhas_error)) {\n          false\n        } else {\n          let tae_len3 = Array::length(aparams)\n          let mut tae_i3 = 0\n          let mut tae_result3 = true\n          let mut tae_done3 = false\n          while (!(tae_done3)) {\n            if tae_i3 >= tae_len3 {\n              tae_done3 = true\n            } else if (!(types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)))) {\n              tae_result3 = false\n              tae_done3 = true\n            } else {\n              tae_i3 = tae_i3 + 1\n            }\n          }\n          if (!(tae_result3)) {\n            false\n          } else {\n            types_equal(aret, bret)\n          }\n        }\n      } else if bhas_error {\n        false\n      } else {\n        let tae_len4 = Array::length(aparams)\n        let mut tae_i4 = 0\n        let mut tae_result4 = true\n        let mut tae_done4 = false\n        while (!(tae_done4)) {\n          if tae_i4 >= tae_len4 {\n            tae_done4 = true\n          } else if (!(types_equal(Array::get(aparams, tae_i4), Array::get(bparams, tae_i4)))) {\n            tae_result4 = false\n            tae_done4 = true\n          } else {\n            tae_i4 = tae_i4 + 1\n          }\n        }\n        if (!(tae_result4)) {\n          false\n        } else {\n          types_equal(aret, bret)\n        }\n      },\n      _ => false\n    },\n    CtForAll(avars, abounds, abody) => match b {\n      CtForAll(bvars, bbounds, bbody) => {\n        if (Array::length(avars) != Array::length(bvars)) {\n          false\n        } else if (Array::length(abounds) != Array::length(bbounds)) {\n          false\n        } else {\n          // inline var_list_equal\n          let vlen = Array::length(avars)\n          let mut vi = 0\n          let mut vresult = true\n          let mut vdone = false\n          while (!(vdone)) {\n            if vi >= vlen {\n              vdone = true\n            } else if (Array::get(avars, vi) != Array::get(bvars, vi)) {\n              vresult = false\n              vdone = true\n            } else {\n              vi = vi + 1\n            }\n          }\n          if (!(vresult)) {\n            false\n          } else {\n            // inline forall_bounds_equal\n            let fbe_len = Array::length(abounds)\n            let mut fbe_i = 0\n            let mut fbe_result = true\n            let mut fbe_done = false\n            while (!(fbe_done)) {\n              if fbe_i >= fbe_len {\n                fbe_done = true\n              } else {\n                let (lvar, lbounds) = Array::get(abounds, fbe_i)\n                let (rvar, rbounds) = Array::get(bbounds, fbe_i)\n                if (lvar != rvar) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (Array::length(lbounds) != Array::length(rbounds)) {\n                  fbe_result = false\n                  fbe_done = true\n                } else if (!(string_array_equal(lbounds, rbounds))) {\n                  fbe_result = false\n                  fbe_done = true\n                } else {\n                  fbe_i = fbe_i + 1\n                }\n              }\n            }\n            if (!(fbe_result)) {\n              false\n            } else {\n              types_equal(abody, bbody)\n            }\n          }\n        }\n      },\n      _ => false\n    }\n  }\n}\n\nexport let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\n  let len = Array::length(bindings)\n  let mut i = 0\n  let mut acc = env\n  while (!(i >= len)) {\n    let (name, ty) = Array::get(bindings, i)\n    acc = EnvBind(name, ty, acc)\n    i = i + 1\n  }\n  acc\n}\n\nexport let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {\n  let len = Array::length(defs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while (!(done)) {\n    if i >= len {\n      done = true\n    } else {\n      let d = Array::get(defs, i)\n      let dname = match d {\n        TDEnum(n, _) => n,\n        TDStruct(n, _) => n,\n        TDAlias(n, _) => n\n      }\n      if dname == name {\n        result = Some(d)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet subst_bounds = (s: Subst, id: Int) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut cur = s\n  let mut out = empty\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(bid, bounds, rest) => {\n        if (bid == id) {\n          out = bounds\n          done = true\n        } else {\n          cur = rest\n        }\n      }\n    }\n  }\n  out\n}\n\nlet rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\n  if i >= Array::length(pairs) {\n    false\n  } else {\n    let (pid, _) = Array::get(pairs, i)\n    if (pid == id) {\n      true\n    } else {\n      int_bounds_has_id(pairs, id, i + 1)\n    }\n  }\n}\n\nlet rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\n  if i >= Array::length(pairs) {\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  } else {\n    let (pid, bounds) = Array::get(pairs, i)\n    if (pid == id) {\n      bounds\n    } else {\n      int_bounds_lookup(pairs, id, i + 1)\n    }\n  }\n}\n\nlet collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {\n  let out = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut cur = s\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(_, _, rest) => {\n        cur = rest\n      },\n      SubstBound(id, bounds, rest) => {\n        if (!(int_bounds_has_id(out, id, 0))) {\n          Array::push(out, (id, bounds))\n        }\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\n  if i >= Array::length(pairs) {\n    fallback\n  } else {\n    let (k, v) = Array::get(pairs, i)\n    if (k == key) {\n      v\n    } else {\n      int_int_lookup_or(pairs, key, fallback, i + 1)\n    }\n  }\n}\n\nexport let subst_lookup = (s: Subst, id: Int) -> Option[Type] {\n  let mut cur = s\n  let mut out = None\n  let mut done = false\n  while (!(done)) {\n    match cur {\n      SubstEmpty => {\n        done = true\n      },\n      SubstBind(i, ty, rest) => {\n        if (i == id) {\n          out = Some(ty)\n          done = true\n        } else {\n          cur = rest\n        }\n      },\n      SubstBound(_, _, rest) => {\n        cur = rest\n      }\n    }\n  }\n  out\n}\n\nlet int_array_has = (arr: Array[Int], v: Int) -> Bool {\n  let slen = Array::length(arr)\n  let mut si = 0\n  let mut sfound = false\n  let mut sdone = false\n  while (!(sdone)) {\n    if si >= slen {\n      sdone = true\n    } else if (Array::get(arr, si) == v) {\n      sfound = true\n      sdone = true\n    } else {\n      si = si + 1\n    }\n  }\n  sfound\n}\n\nexport let rec subst_apply = (s: Subst, ty: Type) -> Type {\n  match ty {\n    // Fast path: concrete types have no type variables\n    CtInt => ty,\n    CtBool => ty,\n    CtString => ty,\n    CtUnit => ty,\n    CtDouble => ty,\n    CtChar => ty,\n    CtBytes => ty,\n    CtUnknown => ty,\n    CtVar(_) => {\n      let mut cur = ty\n      let mut out = ty\n      let mut done = false\n      let mut seen = Array::slice([\n        0\n      ], 0, 0)\n      while (!(done)) {\n        match cur {\n          CtVar(vid) => if int_array_has(seen, vid) {\n            out = cur\n            done = true\n          } else {\n            Array::push(seen, vid)\n            match subst_lookup(s, vid) {\n              Some(next) => {\n                cur = next\n                out = next\n              },\n              None => {\n                out = cur\n                done = true\n              }\n            }\n          }\n          ,\n          _ => {\n            out = subst_apply(s, cur)\n            done = true\n          }\n        }\n      }\n      out\n    },\n    CtFn(params, ret, he) => {\n      let rp = for p in params {\n        subst_apply(s, p)\n      }\n      CtFn(rp, subst_apply(s, ret), he)\n    },\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\n    CtTuple(elems) => CtTuple(for e in elems {\n      subst_apply(s, e)\n    }),\n    CtForAll(_, _, _) => ty,\n    _ => ty\n  }\n}\n\nexport let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {\n  let ta = subst_apply(s, a)\n  let tb = subst_apply(s, b)\n  if types_equal(ta, tb) {\n    Some(s)\n  }\n  else match ta {\n    CtVar(id) => if occurs_in(id, tb) {\n      None\n    } else Some(SubstBind(id, tb, s)),\n    _ => match tb {\n      CtVar(id) => if occurs_in(id, ta) {\n        None\n      } else Some(SubstBind(id, ta, s)),\n      _ => match ta {\n        CtUnknown => Some(s),\n        _ => match tb {\n          CtUnknown => Some(s),\n          _ => match ta {\n            CtForAll(_, _, body_a) => match tb {\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\n              _ => unify(body_a, tb, s)\n            },\n            _ => match tb {\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\n              _ => match ta {\n                CtArray(ea) => match tb {\n                  CtArray(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtOption(ea) => match tb {\n                  CtOption(eb) => unify(ea, eb, s),\n                  _ => None\n                },\n                CtFn(pa, ra, _) => match tb {\n                  CtFn(pb, rb, _) => if (Array::length(pa) != Array::length(pb)) {\n                    None\n                  }\n                  else {\n                    let ul_len = Array::length(pa)\n                    let mut ul_i = 0\n                    let mut ul_acc = s\n                    let mut ul_result = Some(s)\n                    let mut ul_done = false\n                    while (!(ul_done)) {\n                      if ul_i >= ul_len {\n                        ul_result = Some(ul_acc)\n                        ul_done = true\n                      } else {\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\n                          Some(s2) => {\n                            ul_acc = s2\n                            ul_i = ul_i + 1\n                          },\n                          None => {\n                            ul_result = None\n                            ul_done = true\n                          }\n                        }\n                      }\n                    }\n                    match ul_result {\n                      Some(s2) => unify(ra, rb, s2),\n                      None => None\n                    }\n                  }\n                  ,\n                  _ => None\n                },\n                CtTuple(ea) => match tb {\n                  CtTuple(eb) => if (Array::length(ea) != Array::length(eb)) {\n                    None\n                  }\n                  else {\n                    let ul_len2 = Array::length(ea)\n                    let mut ul_i2 = 0\n                    let mut ul_acc2 = s\n                    let mut ul_result2 = Some(s)\n                    let mut ul_done2 = false\n                    while (!(ul_done2)) {\n                      if ul_i2 >= ul_len2 {\n                        ul_result2 = Some(ul_acc2)\n                        ul_done2 = true\n                      } else {\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\n                          Some(s2) => {\n                            ul_acc2 = s2\n                            ul_i2 = ul_i2 + 1\n                          },\n                          None => {\n                            ul_result2 = None\n                            ul_done2 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result2\n                  }\n                  ,\n                  _ => None\n                },\n                CtEnum(a_name) => match tb {\n                  CtEnum(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtStruct(a_name) => match tb {\n                  CtStruct(b_name) => if a_name == b_name {\n                    Some(s)\n                  } else None,\n                  _ => None\n                },\n                CtNamed(a_name, a_args) => match tb {\n                  CtNamed(b_name, b_args) => if (!(a_name == b_name)) {\n                    None\n                  }\n                  else if (Array::length(a_args) != Array::length(b_args)) {\n                    None\n                  }\n                  else {\n                    let ul_len3 = Array::length(a_args)\n                    let mut ul_i3 = 0\n                    let mut ul_acc3 = s\n                    let mut ul_result3 = Some(s)\n                    let mut ul_done3 = false\n                    while (!(ul_done3)) {\n                      if ul_i3 >= ul_len3 {\n                        ul_result3 = Some(ul_acc3)\n                        ul_done3 = true\n                      } else {\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\n                          Some(s2) => {\n                            ul_acc3 = s2\n                            ul_i3 = ul_i3 + 1\n                          },\n                          None => {\n                            ul_result3 = None\n                            ul_done3 = true\n                          }\n                        }\n                      }\n                    }\n                    ul_result3\n                  }\n                  ,\n                  _ => None\n                },\n                _ => None\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {\n  let empty = Array::slice([\n    \"\"\n  ], 0, 0)\n  match env {\n    EnvEmpty => empty,\n    EnvBind(_, _, rest) => trait_supers(rest, name),\n    EnvTraitDef(tname, supers, _, rest) => if tname == name {\n      supers\n    } else trait_supers(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name)\n  }\n}\n\nlet rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {\n  if i >= Array::length(arr) {\n    false\n  }\n  else if (Array::get(arr, i) == val) {\n    true\n  }\n  else array_has_int(arr, val, i + 1)\n}\n\nlet rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {\n  match t {\n    CtVar(id) => {\n      if (!(array_has_int(out, id, 0))) {\n        Array::push(out, id)\n      }\n      0\n    },\n    CtFn(params, ret, _) => {\n      for p in params {\n        let _ = collect_tvars_walk(p, out)\n      }\n      collect_tvars_walk(ret, out)\n    },\n    CtArray(elem) => collect_tvars_walk(elem, out),\n    CtOption(elem) => collect_tvars_walk(elem, out),\n    CtTuple(elems) => {\n      for e in elems {\n        let _ = collect_tvars_walk(e, out)\n      }\n      0\n    },\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\n    _ => 0\n  }\n}\n\nexport let collect_tvars = (ty: Type) -> Array[Int] {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let _ = collect_tvars_walk(ty, out)\n  out\n}\n\nexport let generalize = (s: Subst, ty: Type) -> Type {\n  let resolved = subst_apply(s, ty)\n  let tvars = collect_tvars(resolved)\n  if (Array::length(tvars) == 0) {\n    resolved\n  }\n  else {\n    let bounds_pairs = collect_subst_bounds_pairs(s)\n    let var_bounds = Array::slice([\n      (0, Array::slice([\n        \"\"\n      ], 0, 0))\n    ], 0, 0)\n    for vid in tvars {\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\n      if (Array::length(bounds) != 0) {\n        Array::push(var_bounds, (vid, bounds))\n      }\n    }\n    CtForAll(tvars, var_bounds, resolved)\n  }\n}\n\nexport let rec trait_defined = (env: TypeEnv, name: String) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => trait_defined(rest, name),\n    EnvTraitDef(tname, _, _, rest) => if tname == name {\n      true\n    } else trait_defined(rest, name),\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name)\n  }\n}\n\nexport let rec type_to_string = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"()\",\n    CtBytes => \"Bytes\",\n    CtVar(id) => \"?t\\{id}\",\n    CtForAll(vars, _, body) => {\n      let vlen = Array::length(vars)\n      let mut vi = 0\n      let mut vacc = \"\"\n      while (!(vi >= vlen)) {\n        let v = \"?t\\{Array::get(vars, vi)}\"\n        let next = if vi > 0 {\n          \"\\{vacc} \\{v}\"\n        } else v\n        vacc = next\n        vi = vi + 1\n      }\n      \"forall \\{vacc}. \\{type_to_string(body)}\"\n    },\n    CtUnknown => \"?\",\n    CtArray(elem) => \"Array[\\{type_to_string(elem)}]\",\n    CtOption(elem) => \"Option[\\{type_to_string(elem)}]\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, args) => if (Array::length(args) == 0) {\n      name\n    } else {\n      let parts = for arg in args {\n        type_to_string(arg)\n      }\n      \"\\{name}[\\{join_types(parts, \", \")}]\"\n    }\n    ,\n    CtTuple(elems) => {\n      let parts = for e in elems {\n        type_to_string(e)\n      }\n      \"(\\{join_types(parts, \", \")})\"\n    },\n    CtFn(params, ret, has_error) => {\n      let parts = for p in params {\n        type_to_string(p)\n      }\n      let base = \"(\\{join_types(parts, \", \")}) -> \\{type_to_string(ret)}\"\n      if has_error {\n        \"\\{base} with {Error}\"\n      } else base\n    }\n  }\n}\n\nexport let resolve_builtin = (name: String) -> Option[Type] {\n  if name == \"Int\" {\n    Some(CtInt)\n  }\n  else if name == \"Double\" {\n    Some(CtDouble)\n  }\n  else if name == \"Bool\" {\n    Some(CtBool)\n  }\n  else if name == \"String\" {\n    Some(CtString)\n  }\n  else if name == \"Char\" {\n    Some(CtChar)\n  }\n  else if name == \"Unit\" {\n    Some(CtUnit)\n  }\n  else if name == \"Bytes\" {\n    Some(CtBytes)\n  }\n  else None\n}\n\nexport let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {\n  SubstBound(id, bounds, s)\n}\n\nlet empty_var_bounds = () -> Array[(Int, Array[String])] {\n  Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n}\n\nexport let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\n  match ty {\n    CtForAll(bound_vars, var_bounds, body) => {\n      let blen = Array::length(bound_vars)\n      let id_map = Array::slice([\n        (0, 0)\n      ], 0, 0)\n      let mut bi = 0\n      let mut bacc = SubstEmpty\n      let mut bnc = c\n      while (!(bi >= blen)) {\n        let old_id = Array::get(bound_vars, bi)\n        Array::push(id_map, (old_id, bnc))\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\n        bnc = bnc + 1\n        bi = bi + 1\n      }\n      let inst_s = bacc\n      let id_map2 = id_map\n      let c1 = bnc\n      // Remap var_bounds: old_id -> new_id\n      let new_bounds = Array::slice([\n        (0, Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0)\n      for var_bound in var_bounds {\n        let (old_id, bounds) = var_bound\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\n        Array::push(new_bounds, (new_id, bounds))\n      };\n      (subst_apply(inst_s, body), c1, new_bounds)\n    },\n    _ => (ty, c, empty_var_bounds())\n  }\n}\n\nexport let types_compatible = (expected: Type, actual: Type) -> Bool {\n  match expected {\n    CtUnknown => true,\n    _ => match actual {\n      CtUnknown => true,\n      _ => types_equal(expected, actual)\n    }\n  }\n}\n\nexport let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\n  match env {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, new_target) {\n        true\n      }\n      else impls_overlap_for(rest, trait_name, new_target)\n    } else impls_overlap_for(rest, trait_name, new_target)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target)\n  }\n}\n\nexport let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {\n  // DFS: sub's supers include super_name, or any of sub's supers is a subtrait of super_name\n  if sub == super_name {\n    true\n  }\n  else {\n    let supers = trait_supers(env, sub)\n    let slen = Array::length(supers)\n    let mut si = 0\n    let mut sresult = false\n    let mut sdone = false\n    while (!(sdone)) {\n      if si >= slen {\n        sdone = true\n      } else {\n        let s = Array::get(supers, si)\n        if s == super_name {\n          sresult = true\n          sdone = true\n        } else if trait_is_subtrait(env, s, super_name) {\n          sresult = true\n          sdone = true\n        } else {\n          si = si + 1\n        }\n      }\n    }\n    sresult\n  }\n}\n\nlet rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e2 {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\n      if trait_is_subtrait(full_env, tname, trait_name) {\n        true\n      }\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\n    } else type_implements_check_super(rest, full_env, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\n  }\n}\n\nlet rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\n  match e {\n    EnvEmpty => false,\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\n      if types_equal(target, resolved) {\n        true\n      }\n      else type_implements_check_env(rest, trait_name, resolved)\n    } else type_implements_check_env(rest, trait_name, resolved)\n    ,\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved)\n  }\n}\n\nexport let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\n  let resolved = subst_apply(s, ty)\n  if type_implements_check_env(env, trait_name, resolved) {\n    true\n  }\n  else {\n    // Check supertrait: if trait_name has subtrait impls\n    let supers = trait_supers(env, trait_name)\n    let slen = Array::length(supers)\n    if (slen == 0) {\n      false\n    }\n    else {\n      // Type implements trait_name if it implements all supers? No — reversed:\n      // If T implements sub-trait B where B: A, then T also implements A\n      // So check all traits that the type implements and see if any is a subtrait of trait_name\n      type_implements_check_super(env, env, trait_name, resolved)\n    }\n  }\n}\n")

  let source_4 = ("vibe/compiler/core/dce.vibe",
"//# Imports\n\nimport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet clone_arr = (arr: Array[String]) -> Array[String] {\n  Array::slice(arr, 0, Array::length(arr))\n}\n\nlet stmt_name = (stmt: Stmt) -> Option[String] {\n  match stmt {\n    SLet(_, _, name, _, _) => Some(name),\n    SLetMut(name, _, _) => Some(name),\n    _ => None\n  }\n}\n\nlet array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let rec search = (i: Int) -> Bool {\n    if i >= len {\n      false\n    }\n    else if Array::get(arr, i) == s {\n      true\n    }\n    else search(i + 1)\n  }\n  search(0)\n}\n\nlet add_ref = (out: Array[String], bound: Array[String], name: String) -> Int {\n  if not(array_contains_str(bound, name)) {\n    if not(array_contains_str(out, name)) {\n      Array::push(out, name)\n    }\n  }\n  0\n}\n\nlet rec collect_pat_bindings = (pat: Pat, bound: Array[String]) -> Int {\n  match pat {\n    PWild => 0,\n    PBind(name) => {\n      Array::push(bound, name)\n      0\n    },\n    PInt(_) => 0,\n    PString(_) => 0,\n    PBool(_) => 0,\n    PCtor(_, pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pat_bindings(Array::get(pats, i), bound)\n        i = i + 1\n      }\n      0\n    },\n    POr(p1, p2) => {\n      collect_pat_bindings(p1, bound)\n      collect_pat_bindings(p2, bound)\n      0\n    }\n  }\n}\n\nlet rec collect_refs_into = (expr: Expr, bound: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => add_ref(out, bound, name)\n    ,\n    EInt(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EBool(_) => 0,\n    EUnit => 0,\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(e) => collect_refs_into(e, bound, out)\n    ,\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out)\n    ,\n    ETuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        collect_refs_into(Array::get(items, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ERecord(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EBinOp(_, l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    ECall(callee, args) => {\n      collect_refs_into(callee, bound, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_refs_into(Array::get(args, i), bound, out)\n        i = i + 1\n      }\n      0\n    },\n    EIf(cond, then_e, else_e) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(then_e, bound, out)\n      collect_refs_into(else_e, bound, out)\n      0\n    },\n    ELet(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetRec(name, val, body) => {\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(val, bound2, out)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    ELetMut(name, val, body) => {\n      collect_refs_into(val, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EAssign(_, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    EAssignOp(_, _, val, body) => {\n      collect_refs_into(val, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ESeq(l, r) => {\n      collect_refs_into(l, bound, out)\n      collect_refs_into(r, bound, out)\n      0\n    },\n    EMatch(scr, arms) => {\n      collect_refs_into(scr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EHandle(body_expr, arms) => {\n      collect_refs_into(body_expr, bound, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_body) = Array::get(arms, i)\n        let bound2 = clone_arr(bound)\n        collect_pat_bindings(pat, bound2)\n        collect_refs_into(arm_body, bound2, out)\n        i = i + 1\n      }\n      0\n    },\n    EWhile(cond, body) => {\n      collect_refs_into(cond, bound, out)\n      collect_refs_into(body, bound, out)\n      0\n    },\n    ELoop(params, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        collect_refs_into(init, bound2, out)\n        Array::push(bound2, name)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EForIn(name, index_name, iter, body) => {\n      collect_refs_into(iter, bound, out)\n      let bound2 = clone_arr(bound)\n      Array::push(bound2, name)\n      match index_name {\n        Some(index_name) => Array::push(bound2, index_name),\n        None => ()\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let bound2 = clone_arr(bound)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        Array::push(bound2, pname)\n        i = i + 1\n      }\n      collect_refs_into(body, bound2, out)\n      0\n    },\n    EDot(obj, _) => {\n      collect_refs_into(obj, bound, out)\n      0\n    },\n    ELabeledArg(_, _, e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EMap(fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, val) = Array::get(fields, i)\n        collect_refs_into(val, bound, out)\n        i = i + 1\n      }\n      0\n    },\n    ESpread(e) => {\n      collect_refs_into(e, bound, out)\n      0\n    },\n    EStringInterp(_) => 0\n  }\n}\n\nlet collect_refs = (expr: Expr, bound: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_refs_into(expr, bound, out)\n  out\n}\n\nlet is_type_or_structural = (stmt: Stmt) -> Bool {\n  match stmt {\n    SEnum(_, _, _) => true,\n    SSuberror(_, _, _) => true,\n    SStruct(_, _, _) => true,\n    STypeAlias(_, _, _) => true,\n    STrait(_, _, _) => true,\n    SImpl(_, _, _, _) => true,\n    SExternLet(_, _) => true,\n    SImport(_, _) => true,\n    STest(_, _) => true,\n    SBench(_, _) => true,\n    SExpr(_) => true,\n    SExport(_) => true,\n    SReExport(_, _) => true,\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\nexport let dce_stmts = (stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\n  let empty_bound = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let def_refs = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt_name(stmt) {\n      Some(name) => {\n        Array::push(def_names, name)\n        let refs = match stmt {\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\n          _ => Array::slice([\n            \"\"\n          ], 0, 0)\n        }\n        Array::push(def_refs, refs)\n        0\n      },\n      None => 0\n    }\n    i = i + 1\n  }\n  let reachable = Array::slice([\n    \"\"\n  ], 0, 0)\n  let queue = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut j = 0\n  while j < Array::length(entry_names) {\n    let name = Array::get(entry_names, j)\n    if not(array_contains_str(reachable, name)) {\n      Array::push(reachable, name)\n      Array::push(queue, name)\n    }\n    j = j + 1\n  }\n  let mut qi = 0\n  while qi < Array::length(queue) {\n    let current = Array::get(queue, qi)\n    qi = qi + 1\n    let mut k = 0\n    while k < Array::length(def_names) {\n      if Array::get(def_names, k) == current {\n        let refs = Array::get(def_refs, k)\n        let mut r = 0\n        while r < Array::length(refs) {\n          let dep = Array::get(refs, r)\n          if not(array_contains_str(reachable, dep)) {\n            Array::push(reachable, dep)\n            Array::push(queue, dep)\n          }\n          r = r + 1\n        }\n      }\n      k = k + 1\n    }\n  }\n  let result = Array::slice([\n    Array::get(stmts, 0)\n  ], 0, 0)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    let stmt = Array::get(stmts, m)\n    if is_type_or_structural(stmt) {\n      Array::push(result, stmt)\n    } else {\n      match stmt_name(stmt) {\n        Some(name) => if array_contains_str(reachable, name) {\n          Array::push(result, stmt)\n        }\n        ,\n        None => Array::push(result, stmt)\n      }\n    }\n    m = m + 1\n  }\n  result\n}\n")

  let source_5 = ("vibe/compiler/core/index.vibe",
"export let version = \"0.1.0\"\n\nexport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nexport ./polyfill.vibe {\n  __to_string\n}\n\nexport ./bytebuf.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_array, bytebuf_push_bytes, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_push_buf, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32, bytebuf_push_string\n}\n\nexport ./dce.vibe {\n  dce_stmts\n}\n\nexport ./types.vibe {\n  Type, TypeDef, TypeEnv, Subst, env_bind, fresh_var, occurs_in, env_lookup, env_flat_bindings, env_lookup_flat, types_equal, env_bind_all, find_typedef, subst_lookup, subst_apply, unify, trait_supers, collect_tvars, generalize, trait_defined, type_to_string, resolve_builtin, subst_add_bound, instantiate, types_compatible, impls_overlap_for, trait_is_subtrait, type_implements_trait\n}\n")

  let source_6 = ("vibe/compiler/syntax/token.vibe",
"//# Imports\n\nimport ../core {\n  __to_string\n}\n\nimport ./float_format.vibe {\n  double_to_string_compiler\n}\n\n//# Types\n\nexport enum Token {\n  TInt(Int);\n  TFloat(Double);\n  TString(String);\n  TIdent(String);\n  TLet;\n  TRec;\n  TMut;\n  TFn;\n  TIf;\n  TElse;\n  TMatch;\n  TDo;\n  TEnum;\n  TStruct;\n  TType;\n  TTrait;\n  TImpl;\n  TExport;\n  TTest;\n  TWhile;\n  TFor;\n  TIn;\n  TLoop;\n  TBreak;\n  TContinue;\n  TReturn;\n  TWith;\n  THandle;\n  TThrow;\n  TRaise;\n  TYield;\n  TBench;\n  TDeclare;\n  TAs;\n  TModule;\n  TSuberror;\n  TDerive;\n  TOpen;\n  TImport;\n  TPlus;\n  TMinus;\n  TStar;\n  TSlash;\n  TPercent;\n  TEqEq;\n  TNeq;\n  TLt;\n  TLte;\n  TGt;\n  TGte;\n  TAnd;\n  TOr;\n  TNot;\n  TBitAnd;\n  TBitOr;\n  TBitXor;\n  TLShift;\n  TRShift;\n  TPipeGt;\n  TArrow;\n  TThinArrow;\n  TEq;\n  TDot;\n  TColon;\n  TDoubleColon;\n  TComma;\n  TSemicolon;\n  THash;\n  TTilde;\n  TQuestion;\n  TPlusEq;\n  TMinusEq;\n  TStarEq;\n  TSlashEq;\n  TPercentEq;\n  TLParen;\n  TRParen;\n  TLBrace;\n  TRBrace;\n  TLBracket;\n  TRBracket;\n  TDotDot;\n  TDotDotDot;\n  TStringInterp(Array[String]);\n  TEof\n}\n\n//# Functions\n\nexport let token_to_string = (t: Token) -> String {\n  match t {\n    TInt(n) => String::concat(\"TInt(\", String::concat(__to_string(n), \")\")),\n    TFloat(n) =>\n    String::concat(\"TFloat(\", String::concat(double_to_string_compiler(n), \")\")),\n    TString(s) => String::concat(\"TString(\\\"\", String::concat(s, \"\\\")\")),\n    TIdent(s) => String::concat(\"TIdent(\", String::concat(s, \")\")),\n    TLet => \"TLet\",\n    TRec => \"TRec\",\n    TMut => \"TMut\",\n    TFn => \"TFn\",\n    TIf => \"TIf\",\n    TElse => \"TElse\",\n    TMatch => \"TMatch\",\n    TDo => \"TDo\",\n    TEnum => \"TEnum\",\n    TStruct => \"TStruct\",\n    TType => \"TType\",\n    TTrait => \"TTrait\",\n    TImpl => \"TImpl\",\n    TExport => \"TExport\",\n    TTest => \"TTest\",\n    TWhile => \"TWhile\",\n    TFor => \"TFor\",\n    TIn => \"TIn\",\n    TLoop => \"TLoop\",\n    TBreak => \"TBreak\",\n    TContinue => \"TContinue\",\n    TReturn => \"TReturn\",\n    TWith => \"TWith\",\n    THandle => \"THandle\",\n    TThrow => \"TThrow\",\n    TRaise => \"TRaise\",\n    TYield => \"TYield\",\n    TBench => \"TBench\",\n    TDeclare => \"TDeclare\",\n    TAs => \"TAs\",\n    TModule => \"TModule\",\n    TSuberror => \"TSuberror\",\n    TDerive => \"TDerive\",\n    TOpen => \"TOpen\",\n    TImport => \"TImport\",\n    TPlus => \"TPlus\",\n    TMinus => \"TMinus\",\n    TStar => \"TStar\",\n    TSlash => \"TSlash\",\n    TPercent => \"TPercent\",\n    TEqEq => \"TEqEq\",\n    TNeq => \"TNeq\",\n    TLt => \"TLt\",\n    TLte => \"TLte\",\n    TGt => \"TGt\",\n    TGte => \"TGte\",\n    TAnd => \"TAnd\",\n    TOr => \"TOr\",\n    TNot => \"TNot\",\n    TBitAnd => \"TBitAnd\",\n    TBitOr => \"TBitOr\",\n    TBitXor => \"TBitXor\",\n    TLShift => \"TLShift\",\n    TRShift => \"TRShift\",\n    TPipeGt => \"TPipeGt\",\n    TArrow => \"TArrow\",\n    TThinArrow => \"TThinArrow\",\n    TEq => \"TEq\",\n    TDot => \"TDot\",\n    TColon => \"TColon\",\n    TDoubleColon => \"TDoubleColon\",\n    TComma => \"TComma\",\n    TSemicolon => \"TSemicolon\",\n    THash => \"THash\",\n    TTilde => \"TTilde\",\n    TQuestion => \"TQuestion\",\n    TPlusEq => \"TPlusEq\",\n    TMinusEq => \"TMinusEq\",\n    TStarEq => \"TStarEq\",\n    TSlashEq => \"TSlashEq\",\n    TPercentEq => \"TPercentEq\",\n    TLParen => \"TLParen\",\n    TRParen => \"TRParen\",\n    TLBrace => \"TLBrace\",\n    TRBrace => \"TRBrace\",\n    TLBracket => \"TLBracket\",\n    TRBracket => \"TRBracket\",\n    TDotDot => \"TDotDot\",\n    TDotDotDot => \"TDotDotDot\",\n    TStringInterp(_) => \"TStringInterp\",\n    TEof => \"TEof\"\n  }\n}\n")

  let source_7 = ("vibe/compiler/syntax/float_format.vibe",
"//# Imports\n\nimport ../core {\n  __to_string\n}\n\n//# Functions\n\nlet zero_pad_6 = (n: Int) -> String {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nlet trim_trailing_zeros = (s: String) -> String {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    s[0:end]\n  }\n}\n\nexport let double_to_string_compiler = (d: Double) -> String {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if eq(scaled_raw, 1000000) {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if eq(scaled_raw, 1000000) {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if eq(frac_norm, 0) {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n  }\n}\n")

  let source_8 = ("vibe/compiler/syntax/lexer.vibe",
"//# Imports\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet is_ws = (c: Int) -> Bool {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha = (c: Int) -> Bool {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit = (c: Int) -> Bool {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum = (c: Int) -> Bool {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet is_hex_digit = (c: Int) -> Bool {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup = (word: String) -> Option[Token] {\n  let len = String::length(word)\n  if len == 2 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'f' {\n      if word == \"fn\" {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if word == \"if\" {\n        Some(TIf)\n      } else if word == \"in\" {\n        Some(TIn)\n      } else None\n    } else if c0 == 'd' {\n      if word == \"do\" {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if word == \"as\" {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'l' {\n      if word == \"let\" {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if word == \"rec\" {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if word == \"mut\" {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if word == \"for\" {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'e' {\n      if word == \"else\" {\n        Some(TElse)\n      } else if word == \"enum\" {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if word == \"true\" {\n        Some(TIdent(\"true\"))\n      } else if word == \"type\" {\n        Some(TType)\n      } else if word == \"test\" {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if word == \"with\" {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if word == \"loop\" {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if word == \"open\" {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if word == \"impl\" {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'f' {\n      if word == \"false\" {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if word == \"match\" {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if word == \"trait\" {\n        Some(TTrait)\n      } else if word == \"throw\" {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if word == \"while\" {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if word == \"break\" {\n        Some(TBreak)\n      } else if word == \"bench\" {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if word == \"raise\" {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if word == \"yield\" {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 's' {\n      if word == \"struct\" {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if word == \"export\" {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if word == \"return\" {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if word == \"handle\" {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if word == \"module\" {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if word == \"derive\" {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if word == \"import\" {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if word == \"declare\" {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(word, 0)\n    if c0 == 'c' {\n      if word == \"continue\" {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if word == \"suberror\" {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet rec scan_ident_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_alnum(String::char_code_at(s, i)) {\n    scan_ident_end(s, len, i + 1)\n  } else i\n}\n\nlet lex_ident = (s: String, len: Int, i: Int) -> (Token, Int) {\n  let end = scan_ident_end(s, len, i)\n  let word = s[i:end]\n  // Raw string: r\"...\" → lex as regular string but without escape processing\n  if word == \"r\" && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    let mut raw_acc = \"\"\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      raw_acc = String::concat(raw_acc, String::from_char_code(String::char_code_at(s, ri)))\n      ri = ri + 1\n    }\n    if ri >= len {\n      (TString(raw_acc), ri)\n    } else {\n      (TString(raw_acc), ri + 1)\n    }\n  } else {\n    match keyword_lookup(word) {\n      Some(tok) => if word == \"true\" || word == \"false\" {\n        (TIdent(word), end)\n      } else (tok, end),\n      None => (TIdent(word), end)\n    }\n  }\n}\n\nlet rec scan_interp_end = (s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\n  if idx >= len {\n    throw(\"unterminated string interpolation\")\n  }\n  let c = String::char_code_at(s, idx)\n  if c == '{' {\n    scan_interp_end(s, len, idx + 1, depth + 1)\n  } else if c == '}' {\n    if depth == 1 {\n      idx\n    } else scan_interp_end(s, len, idx + 1, depth - 1)\n  } else scan_interp_end(s, len, idx + 1, depth)\n}\n\nlet rec lex_string_go = (\n  s: String,\n  len: Int,\n  idx: Int,\n  start: Int,\n  acc: String,\n  has_interp: Bool,\n  parts: ArrayBuilder[String]\n) -> (Token, Int) with { Error } {\n  {\n    if idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, idx)\n    if c == '\"' {\n      let chunk = s[start:idx]\n      let value = String::concat(acc, chunk)\n      if has_interp {\n        ArrayBuilder::push(parts, value)\n        (TStringInterp(ArrayBuilder::freeze(parts)), idx + 1)\n      } else {\n        (TString(value), idx + 1)\n      }\n    } else if c == '\\\\' {\n      let chunk = s[start:idx]\n      let next = idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '{' {\n        ArrayBuilder::push(parts, String::concat(acc, chunk))\n        let interp_end = scan_interp_end(s, len, next + 1, 1)\n        let expr_src = s[next + 1:interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        lex_string_go(s, len, interp_end + 1, interp_end + 1, \"\", true, parts)\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        lex_string_go(\n          s,\n          len,\n          next + 1,\n          next + 1,\n          String::concat(String::concat(acc, chunk), escaped),\n          has_interp,\n          parts\n        )\n      }\n    } else {\n      lex_string_go(s, len, idx + 1, start, acc, has_interp, parts)\n    }\n  }\n}\n\nlet lex_string = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  lex_string_go(s, len, i + 1, i + 1, \"\", false, ArrayBuilder::new())\n}\n\nlet rec scan_digits_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_digit(String::char_code_at(s, i)) {\n    scan_digits_end(s, len, i + 1)\n  } else i\n}\n\nlet rec parse_frac_digits = (s: String, len: Int, i: Int, acc: Double, scale: Double) -> (Double, Int) {\n  if i < len {\n    let c = String::char_code_at(s, i)\n    if is_digit(c) {\n      parse_frac_digits(s, len, i + 1, acc + Int::to_double(c - 48) / scale, scale * 10.0)\n    } else (acc, i)\n  } else (acc, i)\n}\n\nlet rec skip_until_newline = (s: String, len: Int, i: Int) -> Int {\n  if i < len {\n    if String::char_code_at(s, i) == '\\n' {\n      i + 1\n    } else skip_until_newline(s, len, i + 1)\n  } else i\n}\n\nlet rec skip_ws = (s: String, len: Int, i: Int) -> Int {\n  if i < len {\n    let c = String::char_code_at(s, i)\n    if is_ws(c) {\n      skip_ws(s, len, i + 1)\n    } else if c == '/' && i + 1 < len && String::char_code_at(s, i + 1) == '/' {\n      let after_comment = skip_until_newline(s, len, i + 2)\n      skip_ws(s, len, after_comment)\n    } else i\n  } else i\n}\n\nlet rec scan_hex_digits_end = (s: String, len: Int, i: Int) -> Int {\n  if i < len && is_hex_digit(String::char_code_at(s, i)) {\n    scan_hex_digits_end(s, len, i + 1)\n  } else i\n}\n\nlet parse_hex_from_string = (s: String) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string = (s: String) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  if int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let int_str = s[i:int_end]\n      let int_val = Int::to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(int_val + frac_val), frac_end + 1)\n      } else {\n        (TFloat(int_val + frac_val), frac_end)\n      }\n    } else {\n      let int_str = s[i:int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else {\n    let int_str = s[i:int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start:hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\nexport let lex = (source: String) -> Array[Token] with { Error } {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut pos = skip_ws(source, len, 0)\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = if is_alpha(c) {\n        lex_ident(source, len, pos)\n      } else if is_digit(c) {\n        lex_number(source, len, pos)\n      } else if c == '\"' {\n        lex_string(source, len, pos)\n      } else if c == '+' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPlusEq, pos + 2)\n        } else (TPlus, pos + 1)\n      } else if c == '-' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TThinArrow, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TMinusEq, pos + 2)\n        } else (TMinus, pos + 1)\n      } else if c == '*' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TStarEq, pos + 2)\n        } else (TStar, pos + 1)\n      } else if c == '/' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TSlashEq, pos + 2)\n        } else (TSlash, pos + 1)\n      } else if c == '%' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TPercentEq, pos + 2)\n        } else (TPercent, pos + 1)\n      } else if c == '=' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TEqEq, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TArrow, pos + 2)\n        } else (TEq, pos + 1)\n      } else if c == '!' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TNeq, pos + 2)\n        } else (TNot, pos + 1)\n      } else if c == '<' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TLte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n          (TLShift, pos + 2)\n        } else (TLt, pos + 1)\n      } else if c == '>' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n          (TGte, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TRShift, pos + 2)\n        } else (TGt, pos + 1)\n      } else if c == '&' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n          (TAnd, pos + 2)\n        } else (TBitAnd, pos + 1)\n      } else if c == '|' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n          (TOr, pos + 2)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n          (TPipeGt, pos + 2)\n        } else (TBitOr, pos + 1)\n      } else if c == '^' {\n        (TBitXor, pos + 1)\n      } else if c == '(' {\n        (TLParen, pos + 1)\n      } else if c == ')' {\n        (TRParen, pos + 1)\n      } else if c == '{' {\n        (TLBrace, pos + 1)\n      } else if c == '}' {\n        (TRBrace, pos + 1)\n      } else if c == '[' {\n        (TLBracket, pos + 1)\n      } else if c == ']' {\n        (TRBracket, pos + 1)\n      } else if c == ',' {\n        (TComma, pos + 1)\n      } else if c == ';' {\n        (TSemicolon, pos + 1)\n      } else if c == '.' {\n        if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n          (TDotDotDot, pos + 3)\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n          (TDotDot, pos + 2)\n        } else (TDot, pos + 1)\n      } else if c == ':' {\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n          (TDoubleColon, pos + 2)\n        } else (TColon, pos + 1)\n      } else if c == '#' {\n        (THash, pos + 1)\n      } else if c == '~' {\n        (TTilde, pos + 1)\n      } else if c == '?' {\n        (TQuestion, pos + 1)\n      } else if c == '\\'' {\n        lex_char(source, len, pos)\n      } else throw(String::concat(\"unexpected character: \", String::from_char_code(c)))\n      ArrayBuilder::push(b, tok)\n      pos = skip_ws(source, len, next)\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport let lex_ok = (source: String) -> Bool {\n  handle {\n    let _ = lex(source)\n    true\n  } {\n    Error(_) => false\n  }\n}\n")

  let source_9 = ("vibe/compiler/syntax/parser.vibe",
"//# Imports\n\nimport ../core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb = () -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nlet tk_name = (tok: Token) -> String {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk = (tok: Token, name: String) -> Bool {\n  tk_name(tok) == name\n}\n\nlet expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  }\n  else throw(\"expected \\{expected} but got \\{tk_name(peek(tokens, pos))}\")\n}\n\nlet skip_semi = (tokens: Array[Token], pos: Int) -> Int {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms = () -> Array[(Pat, Expr)] {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats = () -> Array[Pat] {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nlet empty_ctors = () -> Array[(String, Array[TypeExpr])] {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs = () -> Array[Expr] {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet empty_names = () -> Array[String] {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\nlet empty_fields = () -> Array[(String, TypeExpr)] {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params = () -> Array[(String, Option[TypeExpr])] {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {\n  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => if name == \"true\" {\n      (PBool(true), pos + 1)\n    }\n    else if name == \"false\" {\n      (PBool(false), pos + 1)\n    }\n    else if name == \"_\" {\n      (PWild, pos + 1)\n    }\n    else {\n      let fc = String::char_code_at(name, 0)\n      if fc >= 65 && fc <= 90 {\n        match peek(tokens, pos + 1) {\n          TLParen => {\n            let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n            (PCtor(name, args), end)\n          },\n          _ => (PCtor(name, empty_pats()), pos + 1)\n        }\n      } else (PBind(name), pos + 1)\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => throw(\"unexpected in pattern: \\{tk_name(peek(tokens, pos))}\")\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"_\", empty_strings)\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TLBracket => throw(\"impl type parameters are not supported yet\"),\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, pos + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet empty_type_exprs = () -> Array[TypeExpr] {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {\n  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n        ArrayBuilder::push(b, ty)\n        type_list_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  if mode == 0 {\n    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n    match peek(tokens, atom_next) {\n      TThinArrow => {\n        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n        let params = match atom_ty {\n          TyUnit => empty_type_exprs(),\n          TyTuple(elems) => elems,\n          _ => [\n            atom_ty\n          ]\n        }\n        let rn2 = match peek(tokens, rn) {\n          TWith => {\n            let p1 = rn + 1\n            match peek(tokens, p1) {\n              TLBrace => {\n                let mut p2 = p1 + 1\n                let mut done = false\n                while (!(done)) {\n                  match peek(tokens, p2) {\n                    TRBrace => {\n                      done = true\n                    },\n                    _ => {\n                      p2 = p2 + 1\n                    }\n                  }\n                }\n                p2 + 1\n              },\n              _ => rn\n            }\n          },\n          _ => rn\n        };\n        (TyFn(params, ret), rn2)\n      },\n      _ => (atom_ty, atom_next)\n    }\n  } else match peek(tokens, pos) {\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (TyUnit, pos + 2),\n      _ => {\n        let (first, n1) = parse_type_impl(tokens, pos + 1, 0)\n        match peek(tokens, n1) {\n          TRParen => (first, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \")\");\n            (TyTuple(rest), en)\n          },\n          _ => throw(\"expected ')' or ',' in type\")\n        }\n      }\n    },\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLBracket => {\n        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n        match peek(tokens, n1) {\n          TRBracket => (TyApp(name, [\n            first\n          ]), n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, first)\n            let (rest, end) = type_list_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (TyApp(name, rest), en)\n          },\n          _ => throw(\"expected ']' or ',' in type application\")\n        }\n      },\n      _ => (TyName(name), pos + 1)\n    },\n    _ => throw(\"expected type but got \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nexport let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        ((name, Some(ty)), tp)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => throw(\"expected parameter name\")\n  }\n}\n\nlet rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (p, pn) = parse_one_param(tokens, pos + 1)\n      ArrayBuilder::push(b, p)\n      parse_param_cont(tokens, pn, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in param list\")\n  }\n}\n\nlet parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TColon => {\n        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {\n          match peek(tokens, p) {\n            TIdent(sname) => match peek(tokens, p + 1) {\n              TPlus => parse_supers(p + 2, Array::concat(acc, [\n                sname\n              ])),\n              _ => (Array::concat(acc, [\n                sname\n              ]), p + 1)\n            },\n            _ => (acc, p)\n          }\n        }\n        let (supers, np) = parse_supers(pos + 2, empty_strings);\n        (STrait(exported, name, supers), np)\n      },\n      _ => (STrait(exported, name, empty_strings), pos + 1)\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token = (tok: Token) -> Bool {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix = (tok: Token) -> Bool {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {\n  let parse_import_name = (name_pos: Int) -> ((String, Option[String]), Int)with { Error } {\n    match peek(tokens, name_pos) {\n      TIdent(name) => match peek(tokens, name_pos + 1) {\n        TAs => match peek(tokens, name_pos + 2) {\n          TIdent(alias) => ((name, Some(alias)), name_pos + 3),\n          _ => throw(\"expected alias name after 'as'\")\n        },\n        _ => ((name, None), name_pos + 1)\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items = () -> Array[(String, Option[String])] {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_binding_name = (tokens: Array[Token], pos: Int) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, pos + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, \"\\{acc}.\"),\n    TDotDot => collect_import_path(tokens, pos + 1, \"\\{acc}..\"),\n    TSlash => collect_import_path(tokens, pos + 1, \"\\{acc}/\"),\n    TIdent(name) => collect_import_path(tokens, pos + 1, \"\\{acc}\\{name}\"),\n    TMinus => collect_import_path(tokens, pos + 1, \"\\{acc}-\"),\n    TModule => collect_import_path(tokens, pos + 1, \"\\{acc}module\"),\n    TType => collect_import_path(tokens, pos + 1, \"\\{acc}type\"),\n    TMatch => collect_import_path(tokens, pos + 1, \"\\{acc}match\"),\n    TTest => collect_import_path(tokens, pos + 1, \"\\{acc}test\"),\n    _ => throw(\"unexpected token in import path: \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nlet rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if String::length(acc) == 0 {\n        name\n      } else \"\\{acc}, \\{name}\"\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {\n  match peek(tokens, pos) {\n    TColon => if depth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\n  }\n}\n\nlet is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {\n  is_lambda_start_impl(tokens, pos, 0, false)\n}\n\nlet rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      // Skip optional type parameters [T] or [T, U]\n      let after_name = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let mut skip = pos + 2\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => { depth = depth + 1; skip = skip + 1 },\n              TRBracket => { depth = depth - 1; skip = skip + 1 },\n              _ => { skip = skip + 1 }\n            }\n          }\n          skip\n        },\n        _ => pos + 1\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      (SEnum(exported, name, ctors), end)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let ep = expect_tk(tokens, pos + 1, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet has_non_pipe_infix_top = (tokens: Array[Token], start: Int, end: Int) -> Bool {\n  let rec go = (i: Int, depth: Int, prev_top_end: Bool) -> Bool {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else go(i + 1, 0, false)\n        } else match tok {\n          TLParen => go(i + 1, 1, false),\n          TLBracket => go(i + 1, 1, false),\n          TLBrace => go(i + 1, 1, false),\n          _ => go(i + 1, 0, is_expr_end_token(tok))\n        }\n      } else match tok {\n        TLParen => go(i + 1, depth + 1, prev_top_end),\n        TLBracket => go(i + 1, depth + 1, prev_top_end),\n        TLBrace => go(i + 1, depth + 1, prev_top_end),\n        TRParen => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        TRBracket => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        TRBrace => if depth == 1 {\n          go(i + 1, 0, true)\n        } else go(i + 1, depth - 1, prev_top_end),\n        _ => go(i + 1, depth, prev_top_end)\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nexport let rec parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {\n  let rec parse_comma_exprs_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (e, next) = parse_impl(tokens, pos + 1, 0)\n        ArrayBuilder::push(b, e)\n        parse_comma_exprs_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_primary = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TInt(n) => (EInt(n), pos + 1),\n      TFloat(n) => (EFloat(n), pos + 1),\n      TString(s) => (EString(s), pos + 1),\n      TStringInterp(parts) => (EStringInterp(parts), pos + 1),\n      TIdent(name) => if name == \"true\" {\n        (EBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (EBool(false), pos + 1)\n      }\n      else if name == \"record\" {\n        match peek(tokens, pos + 1) {\n          TLBrace => {\n            let rec parse_rec_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {\n              match peek(toks, p) {\n                TRBrace => (ArrayBuilder::freeze(b), p + 1),\n                TIdent(fname) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (fname, val))\n                  match peek(toks, vn) {\n                    TComma => parse_rec_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in record literal\")\n                  }\n                },\n                _ => throw(\"expected field name or '}' in record literal\")\n              }\n            }\n            let rb = ArrayBuilder::new()\n            let (fields, end) = parse_rec_fields(tokens, pos + 2, rb);\n            (ERecord(fields), end)\n          },\n          _ => (EIdent(name), pos + 1)\n        }\n      }\n      else if name == \"map\" {\n        match peek(tokens, pos + 1) {\n          TLBrace => {\n            let rec parse_map_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {\n              match peek(toks, p) {\n                TRBrace => (ArrayBuilder::freeze(b), p + 1),\n                TIdent(fname) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (fname, val))\n                  match peek(toks, vn) {\n                    TComma => parse_map_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in map literal\")\n                  }\n                },\n                TString(skey) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (skey, val))\n                  match peek(toks, vn) {\n                    TComma => parse_map_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in map literal\")\n                  }\n                },\n                _ => throw(\"expected field name or '}' in map literal\")\n              }\n            }\n            let mb = ArrayBuilder::new()\n            let (fields, end) = parse_map_fields(tokens, pos + 2, mb);\n            (EMap(fields), end)\n          },\n          _ => (EIdent(name), pos + 1)\n        }\n      }\n      else match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member))), pos + 3),\n          TLBrace => {\n            let rec parse_record_fields = (toks: Array[Token], p: Int, b: ArrayBuilder[(String, Expr)]) -> (Array[(String, Expr)], Int)with { Error } {\n              match peek(toks, p) {\n                TRBrace => (ArrayBuilder::freeze(b), p + 1),\n                TIdent(fname) => {\n                  let cn = expect_tk(toks, p + 1, \":\")\n                  let (val, vn) = parse_impl(toks, cn, 0)\n                  ArrayBuilder::push(b, (fname, val))\n                  match peek(toks, vn) {\n                    TComma => parse_record_fields(toks, vn + 1, b),\n                    TRBrace => (ArrayBuilder::freeze(b), vn + 1),\n                    _ => throw(\"expected ',' or '}' in record literal\")\n                  }\n                },\n                _ => throw(\"expected field name or '}' in record literal\")\n              }\n            }\n            let rb = ArrayBuilder::new()\n            let (fields, end) = parse_record_fields(tokens, pos + 3, rb);\n            (ERecord(fields), end)\n          },\n          _ => (EIdent(name), pos + 1)\n        },\n        _ => (EIdent(name), pos + 1)\n      },\n      TLParen => if is_lambda_start(tokens, pos + 1) {\n        let (params, ap) = parse_param_list(tokens, pos + 1)\n        let parse_lambda_body = (saved_params: Array[(String, Option[TypeExpr])], saved_ret_ty: Option[TypeExpr], saved_effect: Option[String], body_pos: Int, body_mode: Int) -> (Expr, Int)with { Error } {\n          let (body, end) = parse_impl(tokens, body_pos, body_mode);\n          (EFn(_no_tp(), _no_tb(), saved_params, saved_ret_ty, saved_effect, body), end)\n        }\n        match peek(tokens, ap) {\n          TThinArrow => {\n            let after_arrow = ap + 1\n            match peek(tokens, after_arrow) {\n              TIdent(_) => {\n                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)\n                match peek(tokens, tp) {\n                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),\n                  TWith => {\n                    let wb = expect_tk(tokens, tp + 1, \"{\")\n                    let (eff, eb) = collect_effect_names(tokens, wb, \"\")\n                    let bb = expect_tk(tokens, eb, \"{\")\n                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)\n                  },\n                  _ => parse_lambda_body(params, None, None, after_arrow, 0)\n                }\n              },\n              TLParen => {\n                let (ty, tp) = parse_type_impl(tokens, after_arrow, 0)\n                match peek(tokens, tp) {\n                  TLBrace => parse_lambda_body(params, Some(ty), None, tp + 1, mode_block),\n                  TWith => {\n                    let wb = expect_tk(tokens, tp + 1, \"{\")\n                    let (eff, eb) = collect_effect_names(tokens, wb, \"\")\n                    let bb = expect_tk(tokens, eb, \"{\")\n                    parse_lambda_body(params, Some(ty), Some(eff), bb, mode_block)\n                  },\n                  _ => parse_lambda_body(params, None, None, after_arrow, 0)\n                }\n              },\n              _ => parse_lambda_body(params, None, None, after_arrow, 0)\n            }\n          },\n          TLBrace => parse_lambda_body(params, None, None, ap + 1, mode_block),\n          _ => throw(\"expected '->' or '{' after fn params\")\n        }\n      } else match peek(tokens, pos + 1) {\n        TRParen => (EUnit, pos + 2),\n        _ => {\n          let (f, n1) = parse_impl(tokens, pos + 1, 0)\n          match peek(tokens, n1) {\n            TRParen => (f, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, f)\n              let (tup, end) = parse_comma_exprs_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (ETuple(tup), en)\n            },\n            _ => throw(\"expected ')' or ','\")\n          }\n        }\n      },\n      TLBracket => {\n        // Check if this is generic function type params [T] or [K: Show]\n        // Heuristic: [Ident(:]|,|]) ... ](\n        let is_type_params = match peek(tokens, pos + 1) {\n          TIdent(_) => match peek(tokens, pos + 2) {\n            TRBracket => match peek(tokens, pos + 3) { TLParen => true, _ => false },\n            TColon => true,\n            TComma => match peek(tokens, pos + 3) { TIdent(_) => true, _ => false },\n            _ => false\n          },\n          _ => false\n        }\n        if is_type_params {\n          // Skip type params: scan to matching ]\n          let mut skip_pos = pos + 1\n          let mut depth = 1\n          let tp_names = ArrayBuilder::new()\n          let tp_bounds = ArrayBuilder::new()\n          while depth > 0 {\n            match peek(tokens, skip_pos) {\n              TLBracket => { depth = depth + 1; skip_pos = skip_pos + 1 },\n              TRBracket => { depth = depth - 1; skip_pos = skip_pos + 1 },\n              TIdent(tname) => {\n                ArrayBuilder::push(tp_names, tname)\n                // Check for : Bound + Bound\n                let tp_bound_names = ArrayBuilder::new()\n                let mut bp = skip_pos + 1\n                match peek(tokens, bp) {\n                  TColon => {\n                    bp = bp + 1\n                    let mut bd = true\n                    while bd {\n                      match peek(tokens, bp) {\n                        TIdent(bname) => {\n                          ArrayBuilder::push(tp_bound_names, bname)\n                          bp = bp + 1\n                          match peek(tokens, bp) {\n                            TPlus => { bp = bp + 1 },\n                            _ => { bd = false }\n                          }\n                        },\n                        _ => { bd = false }\n                      }\n                    }\n                  },\n                  _ => ()\n                }\n                ArrayBuilder::push(tp_bounds, (tname, ArrayBuilder::freeze(tp_bound_names)))\n                skip_pos = bp\n              },\n              TComma => { skip_pos = skip_pos + 1 },\n              _ => { skip_pos = skip_pos + 1 }\n            }\n          }\n          // Now parse as lambda: (params) -> Type { body }\n          let (params, ap) = parse_param_list(tokens, skip_pos)\n          let parse_lambda_body = (saved_params: Array[(String, Option[TypeExpr])], saved_ret_ty: Option[TypeExpr], saved_effect: Option[String], body_pos: Int, body_mode: Int) -> (Expr, Int)with { Error } {\n            let (body, end) = parse_impl(tokens, body_pos, body_mode);\n            (EFn(ArrayBuilder::freeze(tp_names), ArrayBuilder::freeze(tp_bounds), saved_params, saved_ret_ty, saved_effect, body), end)\n          }\n          match peek(tokens, ap) {\n            TThinArrow => {\n              let (ret_ty, rtp) = parse_type_impl(tokens, ap + 1, 0)\n              let (effect, ep) = match peek(tokens, rtp) {\n                TWith => {\n                  let lb = expect_tk(tokens, rtp + 1, \"{\")\n                  let (eff_name, en) = collect_effect_names(tokens, lb, \"\")\n                  (Some(eff_name), en)\n                },\n                _ => (None, rtp)\n              }\n              let bp = expect_tk(tokens, ep, \"{\")\n              parse_lambda_body(params, Some(ret_ty), effect, bp, mode_block)\n            },\n            TLBrace => parse_lambda_body(params, None, None, ap + 1, mode_block),\n            _ => throw(\"expected '->' or '{' after generic function params\")\n          }\n        } else {\n        let rec parse_array_elems_rest = (toks: Array[Token], p: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n          match peek(toks, p) {\n            TComma => {\n              let next_p = p + 1\n              match peek(toks, next_p) {\n                TDotDotDot => {\n                  let (e, en) = parse_impl(toks, next_p + 1, 0)\n                  ArrayBuilder::push(b, ESpread(e))\n                  parse_array_elems_rest(toks, en, b)\n                },\n                _ => {\n                  let (e, en) = parse_impl(toks, next_p, 0)\n                  ArrayBuilder::push(b, e)\n                  parse_array_elems_rest(toks, en, b)\n                }\n              }\n            },\n            _ => (ArrayBuilder::freeze(b), p)\n          }\n        }\n        match peek(tokens, pos + 1) {\n          TRBracket => (EArray(empty_exprs()), pos + 2),\n          TDotDotDot => {\n            let b = ArrayBuilder::new()\n            let (f, n1) = parse_impl(tokens, pos + 2, 0)\n            ArrayBuilder::push(b, ESpread(f))\n            let (arr, end) = parse_array_elems_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (EArray(arr), en)\n          },\n          _ => {\n            let b = ArrayBuilder::new()\n            let (f, n1) = parse_impl(tokens, pos + 1, 0)\n            ArrayBuilder::push(b, f)\n            let (arr, end) = parse_array_elems_rest(tokens, n1, b)\n            let en = expect_tk(tokens, end, \"]\");\n            (EArray(arr), en)\n          }\n        }\n        }\n      },\n      TLBrace => parse_impl(tokens, pos + 1, mode_block),\n      TIf => parse_impl(tokens, pos + 1, mode_if),\n      TMatch => parse_impl(tokens, pos + 1, mode_match),\n      THandle => parse_impl(tokens, pos + 1, mode_handle),\n      TWhile => parse_impl(tokens, pos + 1, mode_while),\n      TFor => parse_impl(tokens, pos + 1, mode_for_in),\n      TThrow => {\n        let lp = expect_tk(tokens, pos + 1, \"(\")\n        let (e, en) = parse_impl(tokens, lp, 0)\n        let rp = expect_tk(tokens, en, \")\");\n        (EThrow(e), rp)\n      },\n      TBreak => {\n        let next_tok = peek(tokens, pos + 1)\n        match next_tok {\n          TRBrace => (EBreak(None), pos + 1),\n          TSemicolon => (EBreak(None), pos + 1),\n          TEof => (EBreak(None), pos + 1),\n          _ => {\n            let (e, en) = parse_impl(tokens, pos + 1, 0);\n            (EBreak(Some(e)), en)\n          }\n        }\n      },\n      TContinue => match peek(tokens, pos + 1) {\n        TLParen => {\n          let b = ArrayBuilder::new()\n          match peek(tokens, pos + 2) {\n            TRParen => (EContinue(empty_exprs()), pos + 3),\n            _ => {\n              let (f, fn1) = parse_impl(tokens, pos + 2, 0)\n              ArrayBuilder::push(b, f)\n              let (args, end) = parse_comma_exprs_rest(tokens, fn1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (EContinue(args), en)\n            }\n          }\n        },\n        _ => (EContinue(empty_exprs()), pos + 1)\n      }\n      ,\n      TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n      TReturn => throw(\"'return' is not supported; use implicit returns\"),\n      TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n      TLoop => match peek(tokens, pos + 1) {\n        TLParen => {\n          let params_b = ArrayBuilder::new()\n          let mut cur = pos + 2\n          let mut done = false\n          while !done {\n            match peek(tokens, cur) {\n              TRParen => {\n                cur = cur + 1\n                done = true\n              },\n              TIdent(name) => {\n                let eq = expect_tk(tokens, cur + 1, \"=\")\n                let (init, next) = parse_impl(tokens, eq, 0)\n                ArrayBuilder::push(params_b, (name, init))\n                match peek(tokens, next) {\n                  TComma => {\n                    cur = next + 1\n                  },\n                  TRParen => {\n                    cur = next + 1\n                    done = true\n                  },\n                  _ => throw(\"expected ',' or ')' in loop params\")\n                }\n              },\n              _ => throw(\"expected loop parameter name or ')'\")\n            }\n          }\n          let br = expect_tk(tokens, cur, \"{\")\n          let (body, end) = parse_impl(tokens, br, mode_block)\n          (ELoop(ArrayBuilder::freeze(params_b), body), end)\n        },\n        _ => {\n          let br = expect_tk(tokens, pos + 1, \"{\")\n          let (body, end) = parse_impl(tokens, br, mode_block)\n          (EWhile(EBool(true), body), end)\n        }\n      },\n      TYield => throw(\"'yield' is not supported\"),\n      TDeclare => throw(\"'declare' is not supported\"),\n      _ => throw(\"unexpected token: \\{tk_name(peek(tokens, pos))}\")\n    }\n  }\n  let parse_call_arg = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TTilde => match peek(tokens, pos + 2) {\n          TEq => {\n            let (val, end) = parse_impl(tokens, pos + 3, 0);\n            (ELabeledArg(name, \"~\", val), end)\n          },\n          _ => parse_impl(tokens, pos, 0)\n        },\n        TQuestion => match peek(tokens, pos + 2) {\n          TEq => {\n            let (val, end) = parse_impl(tokens, pos + 3, 0);\n            (ELabeledArg(name, \"?\", val), end)\n          },\n          _ => parse_impl(tokens, pos, 0)\n        },\n        TEq => {\n          let (val, end) = parse_impl(tokens, pos + 2, 0);\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_impl(tokens, pos, 0)\n      },\n      _ => parse_impl(tokens, pos, 0)\n    }\n  }\n  let rec parse_call_args_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Expr]) -> (Array[Expr], Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => {\n        let (e, next) = parse_call_arg(tokens, pos + 1)\n        ArrayBuilder::push(b, e)\n        parse_call_args_rest(tokens, next, b)\n      },\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  let parse_postfix = (tokens: Array[Token], pos: Int, expr: Expr) -> (Expr, Int)with { Error } {\n    let mut cur_expr = expr\n    let mut cur_pos = pos\n    let mut done = false\n    while !done {\n      match peek(tokens, cur_pos) {\n        TLParen => match cur_expr {\n          ECall(_, _) => {\n            done = true\n          },\n          _ => match peek(tokens, cur_pos + 1) {\n            TRParen => {\n              cur_expr = ECall(cur_expr, empty_exprs())\n              cur_pos = cur_pos + 2\n            },\n            _ => {\n              let b = ArrayBuilder::new()\n              let (f, n1) = parse_call_arg(tokens, cur_pos + 1)\n              ArrayBuilder::push(b, f)\n              let (args, end) = parse_call_args_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\")\n              cur_expr = ECall(cur_expr, args)\n              cur_pos = en\n            }\n          }\n        },\n        TLBracket => {\n          match peek(tokens, cur_pos + 1) {\n            TColon => match peek(tokens, cur_pos + 2) {\n              TRBracket => {\n                // expr[:] — full copy\n                cur_expr = ECall(EIdent(\"__slice\"), [cur_expr, EInt(0), ECall(EIdent(\"__len\"), [cur_expr])])\n                cur_pos = cur_pos + 3\n              },\n              _ => {\n                // expr[:j] — slice from 0 to j\n                let (end_expr, en) = parse_impl(tokens, cur_pos + 2, 0)\n                let en2 = expect_tk(tokens, en, \"]\")\n                cur_expr = ECall(EIdent(\"__slice\"), [cur_expr, EInt(0), end_expr])\n                cur_pos = en2\n              }\n            },\n            _ => {\n              let (idx, n1) = parse_impl(tokens, cur_pos + 1, 0)\n              match peek(tokens, n1) {\n                TColon => match peek(tokens, n1 + 1) {\n                  TRBracket => {\n                    // expr[i:] — slice from i to length\n                    cur_expr = ECall(EIdent(\"__slice\"), [cur_expr, idx, ECall(EIdent(\"__len\"), [cur_expr])])\n                    cur_pos = n1 + 2\n                  },\n                  _ => {\n                    // expr[i:j]\n                    let (end_expr, en) = parse_impl(tokens, n1 + 1, 0)\n                    let en2 = expect_tk(tokens, en, \"]\")\n                    cur_expr = ECall(EIdent(\"__slice\"), [cur_expr, idx, end_expr])\n                    cur_pos = en2\n                  }\n                },\n                _ => {\n                  let en = expect_tk(tokens, n1, \"]\")\n                  cur_expr = ECall(EIdent(\"__index\"), [cur_expr, idx])\n                  cur_pos = en\n                }\n              }\n            }\n          }\n        },\n        TDot => match peek(tokens, cur_pos + 1) {\n          TIdent(field) => {\n            cur_expr = EDot(cur_expr, field)\n            cur_pos = cur_pos + 2\n          },\n          TInt(idx) => {\n            cur_expr = EDot(cur_expr, __to_string(idx))\n            cur_pos = cur_pos + 2\n          },\n          _ => {\n            done = true\n          }\n        },\n        _ => {\n          done = true\n        }\n      }\n    }\n    (cur_expr, cur_pos)\n  }\n  let pipe_desugar = (lhs: Expr, rhs: Expr) -> Expr {\n    match rhs {\n      ECall(callee, args) => ECall(callee, Array::concat([\n        lhs\n      ], args)),\n      _ => ECall(rhs, [\n        lhs\n      ])\n    }\n  }\n  let binop_prec = (tok: Token) -> Int {\n    match tok {\n      TOr => 0,\n      TAnd => 1,\n      TPipeGt => 2,\n      TEqEq => 3,\n      TNeq => 3,\n      TLt => 3,\n      TLte => 3,\n      TGt => 3,\n      TGte => 3,\n      TBitOr => 4,\n      TBitXor => 5,\n      TBitAnd => 6,\n      TLShift => 7,\n      TRShift => 7,\n      TPlus => 8,\n      TMinus => 8,\n      TStar => 9,\n      TSlash => 9,\n      TPercent => 9,\n      _ => -1\n    }\n  }\n  let binop_op = (tok: Token) -> String with { Error } {\n    match tok {\n      TOr => \"||\",\n      TAnd => \"&&\",\n      TPipeGt => \"|>\",\n      TEqEq => \"==\",\n      TNeq => \"!=\",\n      TLt => \"<\",\n      TLte => \"<=\",\n      TGt => \">\",\n      TGte => \">=\",\n      TBitOr => \"|\",\n      TBitXor => \"^\",\n      TBitAnd => \"&\",\n      TLShift => \"<<\",\n      TRShift => \">>\",\n      TPlus => \"+\",\n      TMinus => \"-\",\n      TStar => \"*\",\n      TSlash => \"/\",\n      TPercent => \"%\",\n      _ => throw(\"internal parser error: not a binary operator\")\n    }\n  }\n  let rec parse_prefix = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TMinus => {\n        let (e, next) = parse_prefix(tokens, pos + 1);\n        (EUnaryOp(\"-\", e), next)\n      },\n      TNot => {\n        let (e, next) = parse_prefix(tokens, pos + 1);\n        (EUnaryOp(\"!\", e), next)\n      },\n      _ => {\n        let (e, next) = parse_primary(tokens, pos)\n        parse_postfix(tokens, next, e)\n      }\n    }\n  }\n  let rec parse_infix_loop = (tokens: Array[Token], left: Expr, next: Int, min_prec: Int, expr_start: Int, cmp_locked: Bool) -> (Expr, Int)with { Error } {\n    let tok = peek(tokens, next)\n    let prec = binop_prec(tok)\n    if prec < min_prec || (cmp_locked && prec == 3) {\n      (left, next)\n    } else {\n      let op = binop_op(tok)\n      if op == \"|>\" {\n        if has_non_pipe_infix_top(tokens, expr_start, next) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n      let (right0, right_next0) = parse_prefix(tokens, next + 1)\n      let (right, rn) = parse_infix_loop(tokens, right0, right_next0, prec + 1, next + 1, false)\n      if op == \"|>\" {\n        if has_non_pipe_infix_top(tokens, next + 1, rn) {\n          throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n        } else {\n          0\n        }\n      } else {\n        0\n      }\n      let combined = if op == \"|>\" {\n        pipe_desugar(left, right)\n      } else {\n        EBinOp(op, left, right)\n      }\n      let next_cmp_locked = if prec == 3 {\n        true\n      } else {\n        cmp_locked\n      }\n      parse_infix_loop(tokens, combined, rn, min_prec, expr_start, next_cmp_locked)\n    }\n  }\n  let rec parse_infix = (tokens: Array[Token], pos: Int, min_prec: Int, expr_start: Int) -> (Expr, Int)with { Error } {\n    let (left0, next0) = parse_prefix(tokens, pos)\n    let (expr, en) = parse_infix_loop(tokens, left0, next0, min_prec, expr_start, false)\n    match peek(tokens, en) {\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, en + 1)\n        (EMatch(expr, [(pat, EBool(true)), (PWild, EBool(false))]), pn)\n      } else {\n        (expr, en)\n      },\n      _ => (expr, en)\n    }\n  }\n  let rec parse_match_rest = (tokens: Array[Token], pos: Int, scrutinee: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 2),\n        _ => {\n          let (pa, paa) = parse_pattern(tokens, pos + 1)\n          let a2 = expect_tk(tokens, paa, \"=>\")\n          let (ea, en) = parse_impl(tokens, a2, 0)\n          ArrayBuilder::push(b, (pa, ea))\n          parse_match_rest(tokens, en, scrutinee, b)\n        }\n      },\n      TRBrace => (EMatch(scrutinee, ArrayBuilder::freeze(b)), pos + 1),\n      _ => {\n        // Allow newline-separated arms (no comma required)\n        let (pa, paa) = parse_pattern(tokens, pos)\n        let a2 = expect_tk(tokens, paa, \"=>\")\n        let (ea, en) = parse_impl(tokens, a2, 0)\n        ArrayBuilder::push(b, (pa, ea))\n        parse_match_rest(tokens, en, scrutinee, b)\n      }\n    }\n  }\n  let rec parse_handle_rest = (tokens: Array[Token], pos: Int, body: Expr, b: ArrayBuilder[(Pat, Expr)]) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n        _ => {\n          let (pa, paa) = parse_pattern(tokens, pos + 1)\n          let a2 = expect_tk(tokens, paa, \"=>\")\n          let (ea, en) = parse_impl(tokens, a2, 0)\n          ArrayBuilder::push(b, (pa, ea))\n          parse_handle_rest(tokens, en, body, b)\n        }\n      },\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n      _ => {\n        let (pa, paa) = parse_pattern(tokens, pos)\n        let a2 = expect_tk(tokens, paa, \"=>\")\n        let (ea, en) = parse_impl(tokens, a2, 0)\n        ArrayBuilder::push(b, (pa, ea))\n        parse_handle_rest(tokens, en, body, b)\n      }\n    }\n  }\n  let rec parse_block_after_expr = (tokens: Array[Token], pos: Int, e: Expr) -> (Expr, Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (e, pos + 1),\n      TSemicolon => {\n        let (rest, end) = parse_impl(tokens, pos + 1, mode_block);\n        (ESeq(e, rest), end)\n      },\n      TEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssign(name, val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TPlusEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"+\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TMinusEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"-\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TStarEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"*\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TSlashEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"/\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      TPercentEq => match e {\n        EIdent(name) => {\n          let (val, vn) = parse_impl(tokens, pos + 1, 0)\n          let a = skip_semi(tokens, vn)\n          let (rest, end) = parse_impl(tokens, a, mode_block);\n          (EAssignOp(name, \"%\", val, rest), end)\n        },\n        _ => throw(\"invalid assignment target\")\n      },\n      _ => {\n        let (rest, end) = parse_impl(tokens, pos, mode_block)\n        if end <= pos {\n          throw(\"internal parser error: block continuation did not advance\")\n        } else (ESeq(e, rest), end)\n      }\n    }\n  }\n  if mode == mode_match {\n    let (scrutinee, sn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (fp, fa) = parse_pattern(tokens, br)\n        let aa = expect_tk(tokens, fa, \"=>\")\n        let (fe, fn1) = parse_impl(tokens, aa, 0)\n        ArrayBuilder::push(b, (fp, fe))\n        parse_match_rest(tokens, fn1, scrutinee, b)\n      }\n    }\n  } else if mode == mode_if {\n    let (cond, cn) = parse_impl(tokens, pos, 0)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_impl(tokens, br, mode_block)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_impl(tokens, tn + 2, mode_if),\n        TLBrace => parse_impl(tokens, tn + 2, mode_block),\n        _ => parse_impl(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [(is_pat_val, then_e), (PWild, else_e)]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == mode_while {\n    let (cond, cn) = parse_impl(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_impl(tokens, br, mode_block);\n    (EWhile(cond, body), end)\n  } else if mode == mode_handle {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_impl(tokens, br, mode_block)\n    let hb = expect_tk(tokens, bn, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (fp, fa) = parse_pattern(tokens, hb)\n        let aa = expect_tk(tokens, fa, \"=>\")\n        let (fe, fn1) = parse_impl(tokens, aa, 0)\n        ArrayBuilder::push(b, (fp, fe))\n        parse_handle_rest(tokens, fn1, body, b)\n      }\n    }\n  } else if mode == mode_for_in {\n    match peek(tokens, pos) {\n      TIdent(first_name) => {\n        let (value_name, index_name, name_end) = match peek(tokens, pos + 1) {\n          TComma => match peek(tokens, pos + 2) {\n            TIdent(second_name) => (second_name, Some(first_name), pos + 3),\n            _ => throw(\"expected value binding name after ','\")\n          },\n          _ => (first_name, None, pos + 1)\n        }\n        let ip = expect_tk(tokens, name_end, \"in\")\n        let (iterable, inext) = parse_impl(tokens, ip, 0)\n        let bb = expect_tk(tokens, inext, \"{\")\n        let (body, end) = parse_impl(tokens, bb, mode_block);\n        (EForIn(value_name, index_name, iterable, body), end)\n      },\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else if mode == mode_block {\n    match peek(tokens, pos) {\n      TRBrace => (EUnit, pos + 1),\n      TLet => {\n        let next = pos + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq_pos_r = match peek(tokens, next + 2) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\n                  tp\n                },\n                _ => next + 2\n              }\n              let eq = expect_tk(tokens, eq_pos_r, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else (ELetRec(name, val, body), end)\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq_pos_m = match peek(tokens, next + 2) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\n                  tp\n                },\n                _ => next + 2\n              }\n              let eq = expect_tk(tokens, eq_pos_m, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else (ELetMut(name, val, body), end)\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TIdent(name) => {\n            // Check if this is a constructor pattern: let Some(x) = expr\n            let is_ctor_pat = match peek(tokens, next + 1) {\n              TLParen => true,\n              _ => false\n            }\n            if is_ctor_pat {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let-ctor-pat parser did not advance\")\n              } else {\n                (EMatch(val, [(pat, body)]), end)\n              }\n            } else {\n              let eq_pos = match peek(tokens, next + 1) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 2, 0)\n                  tp\n                },\n                _ => next + 1\n              }\n              let eq = expect_tk(tokens, eq_pos, \"=\")\n              let (val, vn) = parse_impl(tokens, eq, 0)\n              let a = skip_semi(tokens, vn)\n              let (body, end) = parse_impl(tokens, a, mode_block)\n              if end <= a {\n                throw(\"internal parser error: block let parser did not advance\")\n              } else (ELet(name, val, body), end)\n            }\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, vn) = parse_impl(tokens, eq, 0)\n            let a = skip_semi(tokens, vn)\n            let (body, end) = parse_impl(tokens, a, mode_block)\n            if end <= a {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              let arms = [\n                (pat, body)\n              ]\n              (EMatch(val, arms), end)\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_impl(tokens, pos, 0)\n        if next <= pos {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else parse_block_after_expr(tokens, next, e)\n      }\n    }\n  } else if mode >= 0 && mode <= 10 {\n    parse_infix(tokens, pos, mode, pos)\n  } else {\n    throw(\"internal parser error: unknown parse mode\")\n  }\n}\n\nexport let parse = (tokens: Array[Token]) -> Expr with { Error } {\n  let (e, next) = parse_impl(tokens, 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => throw(\"unexpected after expression: \\{tk_name(peek(tokens, next))}\")\n  }\n}\n\nexport let parse_ok = (tokens: Array[Token]) -> Bool {\n  handle {\n    let _ = parse(tokens)\n    true\n  } {\n    Error(_) => false\n  }\n}\n\nexport let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\n  parse_impl(tokens, pos, 0)\n}\n\nlet parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0);\n          (Some(ty), tp)\n        },\n        _ => (None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (val, vn) = parse_impl(tokens, ep, 0);\n      (SLet(exported, true, name, ty_opt, val), vn)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (val, vn) = parse_impl(tokens, ep, 0);\n        (SLetMut(name, ty_opt, val), vn)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TIdent(_) => {\n      let (name, name_next) = parse_binding_name(tokens, pos)\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0);\n          (Some(ty), tp)\n        },\n        _ => (None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (val, vn) = parse_impl(tokens, ep, 0);\n      (SLet(exported, false, name, ty_opt, val), vn)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet parse_test_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, br, mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\nlet rec parse_export_names_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        parse_export_names_rest(tokens, pos + 2, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let (path, bp) = collect_import_path(tokens, pos, \"\")\n  let br = expect_tk(tokens, bp, \"{\")\n  let (items, end) = parse_import_items(tokens, br);\n  (SImport(path, items), end)\n}\n\nlet parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (field, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        parse_struct_fields_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), pos + 1),\n    _ => {\n      let (first, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_struct_fields_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (fields, end) = parse_struct_fields(tokens, br);\n      (SStruct(exported, name, fields), end)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_struct_stmt(tokens, pos + 1, true),\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(name) => {\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, name)\n        let (names, end) = parse_export_names_rest(tokens, pos + 2, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => throw(\"unexpected after 'export': \\{tk_name(peek(tokens, pos))}\")\n  }\n}\n\nlet parse_percent_symbol_name = (tokens: Array[Token], pos: Int, label: String) -> (String, Int)with { Error } {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nlet parse_extern_let_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type_impl(tokens, cp, 0);\n  (SExternLet(name, ty), end)\n}\n\nexport let rec parse_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\n  let rec parse_module_body = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Stmt]) -> (Array[Stmt], Int)with { Error } {\n    match peek(tokens, pos) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, pos)\n        ArrayBuilder::push(b, stmt)\n        parse_module_body(tokens, next, b)\n      }\n    }\n  }\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      TModule => match peek(tokens, pos + 2) {\n        TIdent(name) => {\n          let br = expect_tk(tokens, pos + 3, \"{\")\n          {\n            let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\n            (SModule(true, name, stmts), end)\n          }\n        },\n        _ => throw(\"expected module name\")\n      },\n      _ => parse_export_stmt(tokens, pos + 1)\n    },\n    TModule => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let br = expect_tk(tokens, pos + 2, \"{\")\n        {\n          let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\n          (SModule(false, name, stmts), end)\n        }\n      },\n      _ => throw(\"expected module name\")\n    },\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, pos + 1),\n    TBench => parse_bench_stmt(tokens, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => if name == \"extern\" {\n      parse_extern_let_stmt(tokens, pos + 1)\n    } else if name == \"use\" {\n      throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\")\n    } else {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\nexport let parse_program = (tokens: Array[Token]) -> Array[Stmt] with { Error } {\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  while !is_tk(peek(tokens, pos), \"eof\") {\n    let (stmt, next) = if is_tk(peek(tokens, pos), \"impl\") {\n      parse_impl_stmt_dispatch(tokens, pos + 1)\n    } else {\n      parse_stmt(tokens, pos)\n    }\n    ArrayBuilder::push(b, stmt)\n    pos = next\n  }\n  ArrayBuilder::freeze(b)\n}\n\n//# Misc\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_impl, parse_stmt, parse_type, parse_program\n}\n")

  let source_10 = ("vibe/compiler/checker/builtins.vibe",
"//# Imports\n\nimport ../core/types.vibe {\n  Type, resolve_builtin\n}\n\n//# Functions\n\nlet no_params = () -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet lookup_fs = (name: String) -> Option[Type] {\n  if name == \"Fs::read_file\" {\n    Some(CtFn([\n      CtString\n    ], CtString, true))\n  }\n  else if name == \"Fs::write_file\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnit, true))\n  }\n  else if name == \"Fs::read_bytes\" {\n    Some(CtFn([\n      CtString\n    ], CtBytes, true))\n  }\n  else if name == \"Fs::write_bytes\" {\n    Some(CtFn([\n      CtString,\n      CtBytes\n    ], CtUnit, true))\n  }\n  else if name == \"Fs::exists\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, true))\n  }\n  else if name == \"Fs::stat_token\" {\n    Some(CtFn([\n      CtString\n    ], CtInt, true))\n  }\n  else if name == \"Fs::readdir\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), true))\n  }\n  else if name == \"Fs::is_dir\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, true))\n  }\n  else if name == \"Fs::is_file\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, true))\n  }\n  else if name == \"Fs::mkdir\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, true))\n  }\n  else if name == \"Fs::getcwd\" {\n    Some(CtFn(no_params(), CtString, true))\n  }\n  else if name == \"Fs::chdir\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, true))\n  }\n  else if name == \"Fs::remove\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, true))\n  }\n  else if name == \"Fs::copy\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnit, true))\n  }\n  else if name == \"Fs::append\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnit, true))\n  }\n  else None\n}\n\nlet lookup_io = (name: String) -> Option[Type] {\n  if name == \"sh\" {\n    Some(CtFn([\n      CtString\n    ], CtString, true))\n  }\n  else if name == \"sh_lines\" {\n    Some(CtFn([\n      CtString\n    ], CtArray(CtString), true))\n  }\n  else if name == \"path\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, false))\n  }\n  else if name == \"Path::to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if name == \"Path::is_absolute\" {\n    Some(CtFn([\n      CtString\n    ], CtBool, false))\n  }\n  else if name == \"PromptText::new\" {\n    Some(CtFn([\n      CtString\n    ], CtString, false))\n  }\n  else if name == \"Stdin::read_char\" {\n    Some(CtFn(no_params(), CtInt, true))\n  }\n  else if name == \"Stdin::read_stream\" {\n    Some(CtFn(no_params(), CtString, true))\n  }\n  else if name == \"Stdout::write_char\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, false))\n  }\n  else if name == \"Stdout::write_stream\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if name == \"Env::get\" {\n    Some(CtFn([\n      CtString\n    ], CtString, true))\n  }\n  else if name == \"Env::args_len\" {\n    Some(CtFn(no_params(), CtInt, true))\n  }\n  else if name == \"Env::args_get\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, true))\n  }\n  else if name == \"sleep\" {\n    Some(CtFn([\n      CtInt\n    ], CtUnit, false))\n  }\n  else if name == \"Path::resolve\" {\n    Some(CtFn([\n      CtString\n    ], CtString, false))\n  }\n  else None\n}\n\nlet lookup_map = (name: String) -> Option[Type] {\n  if name == \"MapBuilder::new\" {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if name == \"MapBuilder::set\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"MapBuilder::freeze\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnknown, false))\n  }\n  else if name == \"Map::get\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtUnknown, false))\n  }\n  else if name == \"map_has\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtBool, false))\n  }\n  else if name == \"Map::keys\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtArray(CtString), false))\n  }\n  else None\n}\n\nlet lookup_net = (name: String) -> Option[Type] {\n  if name == \"Socket::tcp_connect\" {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtUnknown, true))\n  }\n  else if name == \"Socket::tcp_read\" {\n    Some(CtFn([\n      CtUnknown,\n      CtInt\n    ], CtString, true))\n  }\n  else if name == \"Socket::tcp_write\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtInt, true))\n  }\n  else if name == \"Socket::tcp_close\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnit, true))\n  }\n  else if name == \"Http::request\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtUnknown, true))\n  }\n  else if name == \"Http::response_status\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtInt, false))\n  }\n  else if name == \"Http::response_header\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtString, false))\n  }\n  else if name == \"Http::response_body\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, true))\n  }\n  else if name == \"Http::close\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"Http::listen\" {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtUnknown, true))\n  }\n  else if name == \"Http::accept\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtUnknown, true))\n  }\n  else if name == \"Http::request_method\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if name == \"Http::request_header\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtString, false))\n  }\n  else if name == \"Http::respond\" {\n    Some(CtFn([\n      CtUnknown,\n      CtInt,\n      CtString\n    ], CtUnit, true))\n  }\n  else None\n}\n\nlet lookup_misc = (name: String) -> Option[Type] {\n  if name == \"eq\" {\n    Some(CtFn([\n      CtInt,\n      CtInt\n    ], CtBool, false))\n  }\n  else if name == \"not\" {\n    Some(CtFn([\n      CtBool\n    ], CtBool, false))\n  }\n  else if name == \"__to_string\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else if name == \"__index\" {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnknown, false))\n  }\n  else if name == \"__slice\" {\n    Some(CtFn([\n      CtUnknown,\n      CtInt,\n      CtInt\n    ], CtUnknown, false))\n  }\n  else if name == \"print\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if name == \"println\" {\n    Some(CtFn([\n      CtString\n    ], CtUnit, false))\n  }\n  else if name == \"assert\" {\n    Some(CtFn([\n      CtBool\n    ], CtUnit, false))\n  }\n  else if name == \"throw\" {\n    Some(CtFn([\n      CtString\n    ], CtUnknown, true))\n  }\n  else if name == \"Int::to_double\" {\n    Some(CtFn([\n      CtInt\n    ], CtDouble, false))\n  }\n  else if name == \"Double::to_int\" {\n    Some(CtFn([\n      CtDouble\n    ], CtInt, false))\n  }\n  else if name == \"Double::to_i64_bits\" {\n    Some(CtFn([\n      CtDouble\n    ], CtInt, false))\n  }\n  else if name == \"Double::from_i64_bits\" {\n    Some(CtFn([\n      CtInt\n    ], CtDouble, false))\n  }\n  else None\n}\n\nlet lookup_array = (name: String) -> Option[Type] {\n  if name == \"array_new\" {\n    Some(CtFn(no_params(), CtArray(CtUnknown), false))\n  }\n  else if name == \"Array::length\" {\n    Some(CtFn([\n      CtArray(CtUnknown)\n    ], CtInt, false))\n  }\n  else if name == \"Array::get\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt\n    ], CtUnknown, false))\n  }\n  else if name == \"Array::set\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"Array::push\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"Array::slice\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtInt\n    ], CtArray(CtUnknown), false))\n  }\n  else if name == \"Array::push_all\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtArray(CtUnknown)\n    ], CtUnit, false))\n  }\n  else if name == \"Array::concat\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtArray(CtUnknown)\n    ], CtArray(CtUnknown), false))\n  }\n  else None\n}\n\nlet lookup_fixed_array = (name: String) -> Option[Type] {\n  if name == \"FixedArray::make\" {\n    Some(CtFn([\n      CtInt,\n      CtUnknown\n    ], CtArray(CtUnknown), false))\n  }\n  else if name == \"FixedArray::length\" {\n    Some(CtFn([\n      CtArray(CtUnknown)\n    ], CtInt, false))\n  }\n  else if name == \"FixedArray::get\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt\n    ], CtUnknown, false))\n  }\n  else if name == \"FixedArray::set\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"FixedArray::unsafe_set\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"FixedArray::blit\" {\n    Some(CtFn([\n      CtArray(CtUnknown),\n      CtInt,\n      CtArray(CtUnknown),\n      CtInt,\n      CtInt\n    ], CtUnit, false))\n  }\n  else None\n}\n\nlet lookup_bytes = (name: String) -> Option[Type] {\n  if name == \"Bytes::new\" {\n    Some(CtFn(no_params(), CtBytes, false))\n  }\n  else if name == \"Bytes::length\" {\n    Some(CtFn([\n      CtBytes\n    ], CtInt, false))\n  }\n  else if name == \"Bytes::get\" {\n    Some(CtFn([\n      CtBytes,\n      CtInt\n    ], CtInt, false))\n  }\n  else if name == \"Bytes::set\" {\n    Some(CtFn([\n      CtBytes,\n      CtInt,\n      CtInt\n    ], CtUnit, false))\n  }\n  else if name == \"Bytes::push\" {\n    Some(CtFn([\n      CtBytes,\n      CtInt\n    ], CtUnit, false))\n  }\n  else if name == \"Bytes::concat\" {\n    Some(CtFn([\n      CtBytes,\n      CtBytes\n    ], CtBytes, false))\n  }\n  else if name == \"Bytes::slice\" {\n    Some(CtFn([\n      CtBytes,\n      CtInt,\n      CtInt\n    ], CtBytes, false))\n  }\n  else if name == \"Bytes::from_array\" {\n    Some(CtFn([\n      CtArray(CtInt)\n    ], CtBytes, false))\n  }\n  else if name == \"Bytes::to_array\" {\n    Some(CtFn([\n      CtBytes\n    ], CtArray(CtInt), false))\n  }\n  else None\n}\n\nlet lookup_string1 = (name: String) -> Option[Type] {\n  if name == \"String::concat\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtString, false))\n  }\n  else if name == \"String::length\" {\n    Some(CtFn([\n      CtString\n    ], CtInt, false))\n  }\n  else if name == \"String::equals\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if name == \"String::substring\" {\n    Some(CtFn([\n      CtString,\n      CtInt,\n      CtInt\n    ], CtString, false))\n  }\n  else if name == \"string_char_at\" {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtString, false))\n  }\n  else None\n}\n\nlet lookup_string2 = (name: String) -> Option[Type] {\n  if name == \"String::index_of\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtInt, false))\n  }\n  else if name == \"String::contains\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if name == \"String::starts_with\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if name == \"String::ends_with\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtBool, false))\n  }\n  else if name == \"String::from_char_code\" {\n    Some(CtFn([\n      CtInt\n    ], CtString, false))\n  }\n  else if name == \"String::char_code_at\" {\n    Some(CtFn([\n      CtString,\n      CtInt\n    ], CtInt, false))\n  }\n  else if name == \"String::last_index_of\" {\n    Some(CtFn([\n      CtString,\n      CtString\n    ], CtInt, false))\n  }\n  else None\n}\n\nlet lookup_array_builder = (name: String) -> Option[Type] {\n  if name == \"ArrayBuilder::new\" {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if name == \"ArrayBuilder::push\" {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, false))\n  }\n  else if name == \"ArrayBuilder::freeze\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtArray(CtUnknown), false))\n  }\n  else None\n}\n\nlet lookup_string_builder = (name: String) -> Option[Type] {\n  if name == \"StringBuilder::new\" {\n    Some(CtFn(no_params(), CtUnknown, false))\n  }\n  else if name == \"StringBuilder::push\" {\n    Some(CtFn([\n      CtUnknown,\n      CtString\n    ], CtUnit, false))\n  }\n  else if name == \"StringBuilder::freeze\" {\n    Some(CtFn([\n      CtUnknown\n    ], CtString, false))\n  }\n  else None\n}\n\nexport let lookup_builtin = (name: String) -> Option[Type] {\n  match lookup_array(name) {\n    Some(t) => Some(t),\n    None => match lookup_fixed_array(name) {\n      Some(t) => Some(t),\n      None => match lookup_array_builder(name) {\n        Some(t) => Some(t),\n        None => match lookup_string1(name) {\n          Some(t) => Some(t),\n          None => match lookup_string2(name) {\n            Some(t) => Some(t),\n            None => match lookup_string_builder(name) {\n              Some(t) => Some(t),\n              None => match lookup_bytes(name) {\n                Some(t) => Some(t),\n                None => match lookup_map(name) {\n                  Some(t) => Some(t),\n                  None => match lookup_io(name) {\n                    Some(t) => Some(t),\n                    None => match lookup_fs(name) {\n                      Some(t) => Some(t),\n                      None => match lookup_net(name) {\n                        Some(t) => Some(t),\n                        None => lookup_misc(name)\n                      }\n                    }\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}\n")

  let source_11 = ("vibe/compiler/checker/checker_resolve.vibe",
"//# Imports\n\nimport ../core/ast.vibe {\n  TypeExpr\n}\n\nimport ../core/types.vibe {\n  Type, TypeDef, find_typedef, resolve_builtin\n}\n\n//# Functions\n\nexport let rec resolve_type_expr = (te: TypeExpr, defs: Array[TypeDef]) -> Type {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _) => CtEnum(n),\n          TDStruct(n, _) => CtStruct(n),\n          TDAlias(_, t) => t\n        },\n        None => CtNamed(name, Array::slice([\n          CtUnknown\n        ], 0, 0))\n      }\n    }\n    ,\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if name == \"Array\" {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if name == \"Option\" {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else CtNamed(name, ra)\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret) => {\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(ret, defs), false)\n    }\n  }\n}\n")

  let source_12 = ("vibe/compiler/checker/checker_pattern.vibe",
"//# Imports\n\nimport ../core {\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\n}\n\n//# Functions\n\nlet find_ctor_in_defs = (defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\n  let dlen = Array::length(defs)\n  let rec go_defs = (di: Int) -> Option[(String, Array[Type])] {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants = (vi: Int) -> Option[(String, Array[Type])] {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if vname == ctor_name {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\nexport let rec check_pattern = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => env,\n    PString(_) => env,\n    PBool(_) => env,\n    PCtor(name, sub_pats) => match find_ctor_in_defs(defs, name) {\n      Some(info) => {\n        let (_, payload_types) = info\n        let splen = Array::length(sub_pats)\n        let ptlen = Array::length(payload_types)\n        let rec bind_subs = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n          if i >= splen {\n            acc_env\n          } else {\n            let sub_ty = if i < ptlen {\n              Array::get(payload_types, i)\n            } else {\n              CtUnknown\n            }\n            let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)\n            bind_subs(i + 1, next_env)\n          }\n        }\n        bind_subs(0, env)\n      },\n      None => {\n        let splen = Array::length(sub_pats)\n        let rec bind_unknown = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n          if i >= splen {\n            acc_env\n          } else {\n            let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)\n            bind_unknown(i + 1, next_env)\n          }\n        }\n        bind_unknown(0, env)\n      }\n    }\n    ,\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          let rec bind_tuple = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          let rec bind_unk = (i: Int, acc_env: TypeEnv) -> TypeEnv {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs)\n  }\n}\n")

  let source_13 = ("vibe/compiler/checker/checker.vibe",
"//# Imports\n\nimport ../core/ast.vibe {\n  Expr\n}\n\nimport ../core/types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, type_implements_trait, unify\n}\n\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\nimport ./checker_pattern.vibe {\n  check_pattern\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet min_int = (a: Int, b: Int) -> Int {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nlet prepend_expr = (first: Expr, rest: Array[Expr]) -> Array[Expr] {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nlet is_bool_binop = (op: String) -> Bool {\n  op == \"==\"\n  || op == \"!=\"\n  || op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n  || op == \"&&\"\n  || op == \"||\"\n}\n\nlet is_logic_binop = (op: String) -> Bool {\n  op == \"&&\"\n  || op == \"||\"\n}\n\nlet is_equality_binop = (op: String) -> Bool {\n  op == \"==\"\n  || op == \"!=\"\n}\n\nlet is_order_binop = (op: String) -> Bool {\n  op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n}\n\nlet unify_binop_candidate = (left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nlet infer_binop_type = (op: String, left_ty: Type, right_ty: Type, s: Subst) -> (Type, Subst) {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => (CtUnknown, s)\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => (CtUnknown, s)\n    }\n  }\n  else if is_order_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtBool, s1),\n        None => (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"+\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n          Some(s1) => (CtString, s1),\n          None => (CtUnknown, s)\n        }\n      }\n    }\n  }\n  else if op == \"-\"\n    || op == \"*\"\n    || op == \"/\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"%\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => (CtUnknown, s)\n    }\n  }\n  else (CtUnknown, s)\n}\n\nlet type_name_prefix = (ty: Type) -> String {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\nexport let rec check_expr = (expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if !eq(Array::length(bounds), 0) {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => (t, s, c),\n        None => (CtUnknown, s, c)\n      }\n    }\n    ,\n    ESeq(left, right) => {\n      let (_, s1, c1) = check_expr(left, env, defs, s, c)\n      check_expr(right, env, defs, s1, c1)\n    },\n    ELet(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c)\n      let gen = generalize(s1, vt)\n      check_expr(body, env_bind(env, name, gen), defs, s1, c1)\n    },\n    ELetRec(name, val, body) => {\n      let (tv, c1) = fresh_var(c)\n      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1)\n      let s2 = match unify(tv, vt, s1) {\n        Some(su) => su,\n        None => s1\n      }\n      let gen = generalize(s2, tv)\n      check_expr(body, env_bind(env, name, gen), defs, s2, c2)\n    },\n    ELetMut(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env_bind(env, name, vt), defs, s1, c1)\n    },\n    EIf(cond, then_e, else_e) => {\n      let (_, s1, c1) = check_expr(cond, env, defs, s, c)\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1)\n      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2)\n      (tt, s3, c3)\n    },\n    ECall(callee, args) => match callee {\n      EDot(obj, method) => {\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)\n        let resolved = subst_apply(s1, obj_ty)\n        let type_prefix = type_name_prefix(resolved)\n        let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n        let method_ty = match env_lookup(env, qualified) {\n          Some(t) => {\n            let (ti, c2, _) = instantiate(t, c1)\n            (ti, s1, c2)\n          },\n          None => match lookup_builtin(qualified) {\n            Some(t) => (t, s1, c1),\n            None => (CtUnknown, s1, c1)\n          }\n        }\n        let (mt, s2, c2) = method_ty\n        let all_args = prepend_expr(obj, args)\n        let alen = Array::length(all_args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        Array::push(arg_tys, obj_ty)\n        let mut ai = 1\n        let mut s3 = s2\n        let mut c3 = c2\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3)\n          Array::push(arg_tys, at)\n          s3 = ns\n          c3 = nc\n          ai = ai + 1\n        }\n        match subst_apply(s3, mt) {\n          CtFn(param_tys, ret, _) => {\n            let mut s4 = s3\n            let mut ui = 0\n            let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n            while ui < ul {\n              s4 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s4) {\n                Some(su) => su,\n                None => s4\n              }\n              ui = ui + 1\n            }\n            (subst_apply(s4, ret), s4, c3)\n          },\n          _ => (CtUnknown, s3, c3)\n        }\n      },\n      _ => {\n        let (ct, s1, c1) = check_expr(callee, env, defs, s, c)\n        let alen = Array::length(args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut ai = 0\n        let mut s2 = s1\n        let mut c2 = c1\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2)\n          Array::push(arg_tys, at)\n          s2 = ns\n          c2 = nc\n          ai = ai + 1\n        }\n        match subst_apply(s2, ct) {\n          CtFn(param_tys, ret, _) => {\n            let mut s3 = s2\n            let mut ui = 0\n            let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\n            while ui < ul {\n              s3 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s3) {\n                Some(su) => su,\n                None => s3\n              }\n              ui = ui + 1\n            }\n            (subst_apply(s3, ret), s3, c2)\n          },\n          CtStruct(sname) => (CtStruct(sname), s2, c2),\n          _ => (CtUnknown, s2, c2)\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1)\n      let (result_ty, s3) = infer_binop_type(\n        op,\n        subst_apply(s2, left_ty),\n        subst_apply(s2, right_ty),\n        s2\n      )\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c)\n      if op == \"!\" {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else if op == \"-\" {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(_, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env, defs, s1, c1)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c)\n      check_expr(body, env, defs, s1, c1)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c)\n      let alen = Array::length(arms)\n      if eq(alen, 0) {\n        (CtUnknown, s1, c1)\n      }\n      else {\n        let mut result_ty = CtUnknown\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = Array::get(arms, ai)\n          let arm_env = check_pattern(pat, scr_ty, env, defs)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci)\n          if eq(ai, 0) {\n            result_ty = arm_ty\n          }\n          si = ns\n          ci = nc\n          ai = ai + 1\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, _) => check_expr(body, env, defs, s, c),\n    EWhile(cond, body) => {\n      let (_, s1, c1) = check_expr(cond, env, defs, s, c)\n      let (_, s2, c2) = check_expr(body, env, defs, s1, c1)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c)\n      let et = match it {\n        CtArray(elem) => elem,\n        _ => CtUnknown\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field) => {\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)\n      let resolved = subst_apply(s1, obj_ty)\n      let field_ty = match resolved {\n        CtStruct(sname) => match find_typedef(defs, sname) {\n          Some(td) => match td {\n            TDStruct(_, fields) => {\n              let rec find_field = (i: Int) -> Type {\n                if i >= Array::length(fields) {\n                  CtUnknown\n                } else {\n                  let (fname, ftype) = Array::get(fields, i)\n                  if fname == field {\n                    ftype\n                  } else find_field(i + 1)\n                }\n              }\n              find_field(0)\n            },\n            _ => CtUnknown\n          },\n          None => CtUnknown\n        },\n        _ => CtUnknown\n      }\n      (field_ty, s1, c1)\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let he = match effect {\n        Some(_) => true,\n        None => false\n      }\n      let tplen = Array::length(tparams)\n      let rec alloc_tparams = (i: Int, acc_env: TypeEnv, acc_s: Subst, acc_c: Int) -> (TypeEnv, Subst, Int) {\n        if i >= tplen {\n          (acc_env, acc_s, acc_c)\n        }\n        else {\n          let tpname = Array::get(tparams, i)\n          let (tv, nc) = fresh_var(acc_c)\n          let vid = nc - 1\n          let tblen = Array::length(tbounds)\n          let rec find_bounds = (j: Int) -> Array[String] {\n            if j >= tblen {\n              Array::slice([\n                \"\"\n              ], 0, 0)\n            }\n            else {\n              let (bname, blist) = Array::get(tbounds, j)\n              if bname == tpname {\n                blist\n              }\n              else find_bounds(j + 1)\n            }\n          }\n          let bounds = find_bounds(0)\n          let ns = if eq(Array::length(bounds), 0) {\n            acc_s\n          }\n          else subst_add_bound(acc_s, vid, bounds)\n          alloc_tparams(i + 1, env_bind(acc_env, tpname, tv), ns, nc)\n        }\n      }\n      let (tp_env, s0, c0) = alloc_tparams(0, env, s, c)\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut pi = 0\n      while pi < plen {\n        let (name, ann) = Array::get(params, pi)\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = match resolved {\n              CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n                Some(t) => t,\n                None => resolved\n              },\n              _ => resolved\n            }\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = match resolved {\n            CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n              Some(t) => t,\n              None => resolved\n            },\n            _ => resolved\n          }\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => (CtUnknown, s2)\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      let resolved_params = for p in param_types {\n        subst_apply(s3, p)\n      }\n      (CtFn(resolved_params, final_ret, he), s3, c2)\n    },\n    EBreak(opt) => match opt {\n      Some(e) => {\n        let (_, s1, c1) = check_expr(e, env, defs, s, c)\n        (CtUnit, s1, c1)\n      },\n      None => (CtUnit, s, c)\n    }\n    ,\n    EContinue(args) => {\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let mut fi = 0\n      while fi < flen {\n        let (_, fval) = Array::get(fields, fi)\n        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1)\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      (CtUnknown, s1, c1)\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1)\n        if eq(ai, 0) {\n          elem_ty = it\n        }\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n")

  let source_14 = ("vibe/compiler/checker/checker_stmt.vibe",
"//# Imports\n\nimport ../core/ast.vibe {\n  Stmt\n}\n\nimport ../core/types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat, generalize, impls_overlap_for, resolve_builtin, subst_apply, trait_defined\n}\n\nimport ./checker.vibe {\n  check_expr\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet rec import_cache_lookup = (cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if cached_name == name {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nlet bind_stmt_imports = (env: TypeEnv, names: Array[(String, Option[String])]) -> TypeEnv {\n  let env_bindings = env_flat_bindings(env)\n  let import_cache = Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n  let nlen = Array::length(names)\n  let rec bind_imports = (i: Int, acc: TypeEnv) -> TypeEnv {\n    if i >= nlen {\n      acc\n    }\n    else {\n      let (name, alias) = Array::get(names, i)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match import_cache_lookup(import_cache, name, 0) {\n        Some(t) => t,\n        None => {\n          let resolved = match env_lookup_flat(env_bindings, name) {\n            Some(t) => t,\n            None => CtUnknown\n          }\n          Array::push(import_cache, (name, resolved))\n          resolved\n        }\n      }\n      bind_imports(i + 1, env_bind(acc, bound_name, ty))\n    }\n  }\n  bind_imports(0, env)\n}\n\nexport let rec check_stmts = (stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (TypeEnv, Subst, Int) {\n  if i >= Array::length(stmts) {\n    (env, s, c)\n  } else {\n    let stmt = Array::get(stmts, i)\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c)\n        } else {\n          check_expr(val, env, defs, s, c)\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => generalize(ns, vt)\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c)\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SEnum(_, name, variants) => {\n        let resolved_variants = Array::slice([\n          (\"\", Array::slice([\n            CtUnknown\n          ], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = Array::slice([\n            CtUnknown\n          ], 0, 0)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = resolve_type_expr(Array::get(vtypes, ti), defs)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          if eq(Array::length(vtypes), 0) {\n            env1 = env_bind(env1, vname, CtEnum(name))\n          } else {\n            let resolved_args = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            env1 = env_bind(env1, vname, CtFn(resolved_args, CtEnum(name), false))\n          }\n          ci2 = ci2 + 1\n        }\n        (env1, s, c)\n      }\n      ,\n      SStruct(_, name, field_defs) => {\n        let resolved_fields = Array::slice([\n          (\"\", CtUnit)\n        ], 0, 0)\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        Array::push(defs, TDStruct(name, resolved_fields))\n        let field_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        (env_bind(env, name, CtFn(field_types, CtStruct(name), false)), s, c)\n      }\n      ,\n      STypeAlias(_, name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c)\n        (env, ns, nc)\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c)\n        (env, s, c)\n      },\n      SImport(_, names) => {\n        (bind_stmt_imports(env, names), s, c)\n      },\n      SReExport(_, names) => {\n        (bind_stmt_imports(env, names), s, c)\n      },\n      STrait(_, name, supers) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, env), s, c)\n      },\n      SImpl(_, _, trait_name, type_name) => {\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, Array::slice([\n            CtUnknown\n          ], 0, 0))\n        }\n        (EnvTraitImpl(trait_name, target, env), s, c)\n      },\n      _ => (env, s, c)\n    }\n    check_stmts(stmts, i + 1, new_env, defs, s1, c1)\n  }\n}\n\nexport let check_program = (stmts: Array[Stmt]) -> TypeEnv {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs, SubstEmpty, 0)\n  env\n}\n\nexport let check_program_with_env = (stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let (env, _, _) = check_stmts(stmts, 0, initial_env, empty_defs, SubstEmpty, 0)\n  env\n}\n")

  let source_15 = ("vibe/compiler/codegen/wasm_emit/index.vibe",
"// WASM binary emitter — generates minimal valid .wasm modules\n// Uses bytebuf.vibe for byte-level binary construction\n\nimport ../../core/index.vibe {\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes,\n  bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header,\n  leb128_encode_u32, leb128_encode_s64,\n  bytebuf_push2, bytebuf_push3, bytebuf_push9,\n  bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32,\n  bytebuf_push_string\n}\n\n// WASM Opcodes\nlet op_block = 2\nlet op_loop = 3\nlet op_if = 4\nlet op_else = 5\nlet op_end = 11\nlet op_br = 12\nlet op_br_if = 13\nlet op_return = 15\nlet op_call = 16\nlet op_call_indirect = 17\nlet op_drop = 26\nlet bt_void = 64\nlet bt_i64 = 126\nlet op_local_get = 32\nlet op_local_set = 33\nlet op_local_tee = 34\nlet op_global_get = 35\nlet op_global_set = 36\nlet op_i32_load = 40\nlet op_i64_load = 41\nlet op_i32_load8_u = 45\nlet op_i32_store = 54\nlet op_i64_store = 55\nlet op_i32_store8 = 58\nlet op_i32_const = 65\nlet op_i64_const = 66\nlet op_i32_eqz = 69\nlet op_i32_eq = 70\nlet op_i32_ne = 71\nlet op_i32_gt_u = 75\nlet op_i32_ge_u = 79\nlet op_i32_add = 106\nlet op_i32_sub = 107\nlet op_i32_mul = 108\nlet op_i64_eqz = 80\nlet op_i64_eq = 81\nlet op_i64_ne = 82\nlet op_i64_lt_s = 83\nlet op_i64_gt_s = 85\nlet op_i64_le_s = 87\nlet op_i64_ge_s = 89\nlet op_i64_add = 124\nlet op_i64_sub = 125\nlet op_i64_mul = 126\nlet op_i64_div_s = 127\nlet op_i64_rem_s = 129\nlet op_i64_and = 131\nlet op_i64_or = 132\nlet op_i64_xor = 133\nlet op_i64_shl = 134\nlet op_i64_shr_s = 135\nlet op_i32_wrap_i64 = 167\nlet op_i64_extend_i32_s = 172\nlet op_i64_extend_i32_u = 173\nlet op_i64_trunc_f64_s = 176\nlet op_f64_convert_i64_s = 185\nlet op_i64_reinterpret_f64 = 189\nlet op_f64_reinterpret_i64 = 191\nlet op_f64_eq = 97\nlet op_f64_ne = 98\nlet op_f64_lt = 99\nlet op_f64_gt = 100\nlet op_f64_le = 101\nlet op_f64_ge = 102\nlet op_f64_neg = 154\nlet op_f64_add = 160\nlet op_f64_sub = 161\nlet op_f64_mul = 162\nlet op_f64_div = 163\nlet op_prefix = 252\nlet type_func = 96\nlet type_funcref = 112\nlet vt_i32 = 127\nlet vt_i64 = 126\nlet sec_type = 1\nlet sec_import = 2\nlet sec_function = 3\nlet sec_table = 4\nlet sec_memory = 5\nlet sec_global = 6\nlet sec_export = 7\nlet sec_element = 9\nlet sec_code = 10\nlet sec_data = 11\nlet export_func = 0\nlet export_memory = 2\n\n// === Emit helpers ===\n\n// Emit WASM magic number and version\nexport let emit_header = (buf: Array[Int]) -> Unit {\n  // \\0asm + version 1 (8 bytes via two push3 + push2)\n  bytebuf_push3(buf, 0, 97, 115)\n  bytebuf_push3(buf, 109, 1, 0)\n  bytebuf_push2(buf, 0, 0)\n}\n\n// Encode a function type: (i64 x param_count) -> (i64 x result_count)\nexport let emit_func_type = (buf: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  bytebuf_push(buf, type_func)\n  leb128_encode_u32(buf, param_count)\n  let mut i = 0\n  while i < param_count {\n    bytebuf_push(buf, vt_i64)\n    i = i + 1\n  }\n  leb128_encode_u32(buf, result_count)\n  let mut j = 0\n  while j < result_count {\n    bytebuf_push(buf, vt_i64)\n    j = j + 1\n  }\n}\n\n// Emit type section with multiple function types\n// type_defs: flat array of [param_count, result_count, param_count, result_count, :.]\nexport let emit_type_section_multi = (out: Array[Int], type_defs: Array[Int]) -> Unit {\n  let count = Array::length(type_defs) / 2\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_type, content)\n}\n\n// Emit type section with a single function type (convenience)\nexport let emit_type_section = (out: Array[Int], param_count: Int, result_count: Int) -> Unit {\n  emit_type_section_multi(out, [param_count, result_count])\n}\n\n// Emit function section — maps function indices to type indices\nexport let emit_function_section = (out: Array[Int], type_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(type_indices))\n  let mut i = 0\n  while i < Array::length(type_indices) {\n    leb128_encode_u32(content, Array::get(type_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_function, content)\n}\n\n// Helper: emit a name string (length-prefixed ASCII)\nexport let emit_name = (buf: Array[Int], name: String) -> Unit {\n  bytebuf_push_string(buf, name)\n}\n\n// Emit export section with multiple exports\n// names: array of export names, func_indices: matching array of function indices\nexport let emit_export_section_multi = (out: Array[Int], names: Array[String], func_indices: Array[Int]) -> Unit {\n  let count = Array::length(names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    emit_name(content, Array::get(names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_export, content)\n}\n\n// Emit export section — single export (convenience)\nexport let emit_export_section = (out: Array[Int], name: String, func_idx: Int) -> Unit {\n  emit_export_section_multi(out, [name], [func_idx])\n}\n\n// Emit memory section: 1 memory with min pages, no max\nexport let emit_memory_section = (out: Array[Int], min_pages: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 memory\n  bytebuf_push(content, 0)  // limits: no max\n  leb128_encode_u32(content, min_pages)\n  bytebuf_push_section(out, sec_memory, content)\n}\n\n// Emit a code section with function bodies\n// Each body is pre-encoded instructions (without end opcode)\nexport let emit_code_section = (out: Array[Int], bodies: Array[Array[Int]]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let func_buf = bytebuf_new()\n    leb128_encode_u32(func_buf, 0)  // 0 local declarations\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, op_end)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_code, content)\n}\n\n// Emit code section with local declarations\n// local_decls: array of [count, valtype] pairs per function (flat)\n// For now: emit one block of count locals of type i64\nexport let emit_code_section_with_locals = (out: Array[Int], bodies: Array[Array[Int]], local_counts: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, Array::length(bodies))\n  let mut i = 0\n  while i < Array::length(bodies) {\n    let body = Array::get(bodies, i)\n    let num_locals = Array::get(local_counts, i)\n    let func_buf = bytebuf_new()\n    if num_locals == 0 {\n      leb128_encode_u32(func_buf, 0)  // 0 local decl blocks\n    } else {\n      leb128_encode_u32(func_buf, 1)  // 1 local decl block\n      leb128_encode_u32(func_buf, num_locals)\n      bytebuf_push(func_buf, vt_i64)\n    }\n    bytebuf_push_array(func_buf, body)\n    bytebuf_push(func_buf, op_end)\n    leb128_encode_u32(content, bytebuf_length(func_buf))\n    bytebuf_push_array(content, func_buf)\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_code, content)\n}\n\n// === Instruction emitters ===\n\nexport let emit_local_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_get, idx)\n}\n\nexport let emit_local_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_set, idx)\n}\n\nexport let emit_local_tee = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_tee, idx)\n}\n\nexport let emit_i64_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, op_i64_const, value)\n}\n\nexport let emit_i64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_add)\n}\n\nexport let emit_i64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_sub)\n}\n\nexport let emit_i64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_mul)\n}\n\nexport let emit_i64_div_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_div_s)\n}\n\nexport let emit_i64_rem_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_rem_s)\n}\n\nexport let emit_i64_and = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_and)\n}\n\nexport let emit_i64_or = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_or)\n}\n\nexport let emit_i64_xor = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_xor)\n}\n\nexport let emit_i64_shl = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_shl)\n}\n\nexport let emit_i64_shr_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_shr_s)\n}\n\nexport let emit_i64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_eq)\n}\n\nexport let emit_i64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_ne)\n}\n\nexport let emit_i64_lt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_lt_s)\n}\n\nexport let emit_i64_gt_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_gt_s)\n}\n\nexport let emit_i64_le_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_le_s)\n}\n\nexport let emit_i64_ge_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_ge_s)\n}\n\nexport let emit_i64_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_eqz)\n}\n\nexport let emit_call = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\n}\n\nexport let emit_drop = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_drop)\n}\n\nexport let emit_return = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_return)\n}\n\n// Control flow: block types\n// 0x40 = void block, 0x7E = i64 block\nexport let emit_block_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, op_block, bt_void)\n}\n\nexport let emit_block_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, op_block, bt_i64)\n}\n\nexport let emit_loop_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, op_loop, bt_void)\n}\n\nexport let emit_if_void = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, op_if, bt_void)\n}\n\nexport let emit_if_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push2(buf, op_if, bt_i64)\n}\n\nexport let emit_else = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_else)\n}\n\nexport let emit_end = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_end)\n}\n\nexport let emit_br = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br, label)\n}\n\nexport let emit_br_if = (buf: Array[Int], label: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_br_if, label)\n}\n\n// i64.extend_i32_s — extend i32 comparison result to i64\nexport let emit_i64_extend_i32_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_extend_i32_s)\n}\n\n// i32.wrap_i64 — truncate i64 to i32\nexport let emit_i32_wrap_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_wrap_i64)\n}\n\n// === i32 instructions (needed for WASI APIs) ===\n\nexport let emit_i32_const = (buf: Array[Int], value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, op_i32_const, value)\n}\n\nexport let emit_i32_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_add)\n}\n\nexport let emit_i32_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)\n}\n\nexport let emit_i32_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load, align, offset)\n}\n\nexport let emit_i32_store8 = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store8, align, offset)\n}\n\nexport let emit_i32_load8_u = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load8_u, align, offset)\n}\n\n// === Section emitters: Import, Data, Global ===\n\n// Emit raw func type with explicit valtype arrays\n// param_types/result_types: arrays of valtype ints (126=i64, 127=i32)\nexport let emit_func_type_raw = (buf: Array[Int], param_types: Array[Int], result_types: Array[Int]) -> Unit {\n  bytebuf_push(buf, type_func)\n  leb128_encode_u32(buf, Array::length(param_types))\n  let mut i = 0\n  while i < Array::length(param_types) {\n    bytebuf_push(buf, Array::get(param_types, i))\n    i = i + 1\n  }\n  leb128_encode_u32(buf, Array::length(result_types))\n  let mut j = 0\n  while j < Array::length(result_types) {\n    bytebuf_push(buf, Array::get(result_types, j))\n    j = j + 1\n  }\n}\n\n// Emit import section: import a function\n// module_name, field_name: import path, type_idx: type index\nexport let emit_import_section_func = (out: Array[Int], module_name: String, field_name: String, type_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 import\n  emit_name(content, module_name)\n  emit_name(content, field_name)\n  bytebuf_push(content, export_func)  // import kind: function\n  leb128_encode_u32(content, type_idx)\n  bytebuf_push_section(out, sec_import, content)\n}\n\n// Emit data section: place byte data at a memory offset\n// segments: array of [offset, data_buf] pairs\nexport let emit_data_section = (out: Array[Int], offset: Int, data: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 data segment\n  // Active data segment: memory index 0\n  bytebuf_push(content, 0)  // flags: active, memory 0\n  // Offset expression: i32.const <offset>, end\n  emit_i32_const(content, offset)\n  emit_end(content)\n  // Data bytes\n  leb128_encode_u32(content, Array::length(data))\n  bytebuf_push_array(content, data)\n  bytebuf_push_section(out, sec_data, content)\n}\n\n// Emit global section: one mutable i32 global with initial value\nexport let emit_global_section_i32_mut = (out: Array[Int], init_value: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 global\n  bytebuf_push2(content, vt_i32, 1)  // mutable\n  emit_i32_const(content, init_value)\n  emit_end(content)\n  bytebuf_push_section(out, sec_global, content)\n}\n\nexport let emit_global_get = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\n}\n\nexport let emit_global_set = (buf: Array[Int], idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\n}\n\n// Emit export for memory\nexport let emit_export_memory = (out: Array[Int], name: String, mem_idx: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)\n  emit_name(content, name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\n// Emit combined export section: functions + optional memory\nexport let emit_exports_with_memory = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int) -> Unit {\n  let count = Array::length(fn_names) + 1\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  bytebuf_push_section(out, sec_export, content)\n}\n\n// Emit export section with functions, memory, and globals\n// Export kinds: 0=func, 1=table, 2=memory, 3=global\nexport let emit_exports_full = (out: Array[Int], fn_names: Array[String], fn_indices: Array[Int], mem_name: String, mem_idx: Int, global_names: Array[String], global_indices: Array[Int]) -> Unit {\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  // Function exports\n  let mut i = 0\n  while i < Array::length(fn_names) {\n    emit_name(content, Array::get(fn_names, i))\n    bytebuf_push(content, export_func)\n    leb128_encode_u32(content, Array::get(fn_indices, i))\n    i = i + 1\n  }\n  // Memory export\n  emit_name(content, mem_name)\n  bytebuf_push(content, export_memory)\n  leb128_encode_u32(content, mem_idx)\n  // Global exports\n  let mut gi = 0\n  while gi < Array::length(global_names) {\n    emit_name(content, Array::get(global_names, gi))\n    bytebuf_push(content, 3)  // export kind: global\n    leb128_encode_u32(content, Array::get(global_indices, gi))\n    gi = gi + 1\n  }\n  bytebuf_push_section(out, sec_export, content)\n}\n\n// === High-level: build a complete module ===\n\n// Build a minimal WASM module with one exported function: add(i64, i64) -> i64\nexport let build_add_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n  emit_type_section(out, 2, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"add\", 0)\n  let body = bytebuf_new()\n  emit_local_get(body, 0)\n  emit_local_get(body, 1)\n  emit_i64_add(body)\n  emit_code_section(out, [body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with internal call: square(x) = x*x, sum_sq(a,b) = square(a) + square(b)\nexport let build_call_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 2 types: type0 = (i64) -> (i64), type1 = (i64, i64) -> (i64)\n  emit_type_section_multi(out, [1, 1, 2, 1])\n\n  // 2 functions: func0=square(type0), func1=sum_sq(type1)\n  emit_function_section(out, [0, 1])\n\n  // export both\n  emit_export_section_multi(out, [\"square\", \"sum_sq\"], [0, 1])\n\n  // square: x * x\n  let sq_body = bytebuf_new()\n  emit_local_get(sq_body, 0)\n  emit_local_get(sq_body, 0)\n  emit_i64_mul(sq_body)\n\n  // sum_sq: square(a) + square(b)\n  let ss_body = bytebuf_new()\n  emit_local_get(ss_body, 0)\n  emit_call(ss_body, 0)  // call square\n  emit_local_get(ss_body, 1)\n  emit_call(ss_body, 0)  // call square\n  emit_i64_add(ss_body)\n\n  emit_code_section(out, [sq_body, ss_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build a module with add, sub, mul exported (all using same type: (i64, i64) -> i64)\nexport let build_arithmetic_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // 1 type: (i64, i64) -> (i64)\n  emit_type_section(out, 2, 1)\n\n  // 3 functions, all type 0\n  emit_function_section(out, [0, 0, 0])\n\n  // 3 exports\n  emit_export_section_multi(out, [\"add\", \"sub\", \"mul\"], [0, 1, 2])\n\n  // 3 function bodies\n  let add_body = bytebuf_new()\n  emit_local_get(add_body, 0)\n  emit_local_get(add_body, 1)\n  emit_i64_add(add_body)\n\n  let sub_body = bytebuf_new()\n  emit_local_get(sub_body, 0)\n  emit_local_get(sub_body, 1)\n  emit_i64_sub(sub_body)\n\n  let mul_body = bytebuf_new()\n  emit_local_get(mul_body, 0)\n  emit_local_get(mul_body, 1)\n  emit_i64_mul(mul_body)\n\n  emit_code_section(out, [add_body, sub_body, mul_body])\n  bytebuf_to_bytes(out)\n}\n\n// Build fibonacci module: fib(n) iterative\n// params: n (local 0)\n// locals: a (local 1), b (local 2), tmp (local 3)\n// Algorithm: a=0, b=1, while(n>0) { tmp=a+b; a=b; b=tmp; n=n-1 }; return a\nexport let build_fibonacci_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // type0: (i64) -> (i64)\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fib\", 0)\n\n  let b = bytebuf_new()\n  // local 0 = n (param), locals 1=a, 2=b, 3=tmp\n\n  // a = 0\n  emit_i64_const(b, 0)\n  emit_local_set(b, 1)\n  // b = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 2)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 0, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 0)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)  // br $break (label 1 = outer block)\n\n      // tmp = a + b\n      emit_local_get(b, 1)\n      emit_local_get(b, 2)\n      emit_i64_add(b)\n      emit_local_set(b, 3)\n      // a = b\n      emit_local_get(b, 2)\n      emit_local_set(b, 1)\n      // b = tmp\n      emit_local_get(b, 3)\n      emit_local_set(b, 2)\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      // br $continue (label 0 = loop)\n      emit_br(b, 0)\n    emit_end(b)  // end loop\n  emit_end(b)    // end block\n\n  // return a\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [3])\n  bytebuf_to_bytes(out)\n}\n\n// Build factorial module: fact(n) iterative\n// params: n (local 0), locals: result (local 1)\n// Algorithm: result=1, while(n>1) { result=result*n; n=n-1 }; return result\nexport let build_factorial_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  emit_type_section(out, 1, 1)\n  emit_function_section(out, [0])\n  emit_export_section(out, \"fact\", 0)\n\n  let b = bytebuf_new()\n  // result = 1\n  emit_i64_const(b, 1)\n  emit_local_set(b, 1)\n\n  // block $break\n  emit_block_void(b)\n    // loop $continue\n    emit_loop_void(b)\n      // if n <= 1, break\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_le_s(b)\n      emit_br_if(b, 1)\n\n      // result = result * n\n      emit_local_get(b, 1)\n      emit_local_get(b, 0)\n      emit_i64_mul(b)\n      emit_local_set(b, 1)\n\n      // n = n - 1\n      emit_local_get(b, 0)\n      emit_i64_const(b, 1)\n      emit_i64_sub(b)\n      emit_local_set(b, 0)\n\n      emit_br(b, 0)\n    emit_end(b)\n  emit_end(b)\n\n  // return result\n  emit_local_get(b, 1)\n\n  emit_code_section_with_locals(out, [b], [1])\n  bytebuf_to_bytes(out)\n}\n\n// Build a WASI hello world module\n// Imports fd_write from wasi_snapshot_preview1, writes \"hello world\\n\" to stdout\nexport let build_hello_module = () -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Type section:\n  //   type0: fd_write(i32, i32, i32, i32) -> i32\n  //   type1: _start() -> void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [vt_i32, vt_i32, vt_i32, vt_i32], [vt_i32])\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n\n  // Import section: fd_write from wasi_snapshot_preview1 (func index 0)\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n\n  // Function section: _start is func index 1 (after 1 import), type 1\n  emit_function_section(out, [1])\n\n  // Memory section: 1 page\n  emit_memory_section(out, 1)\n\n  // Export section: _start + memory\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // Code section: _start body (must come before data section)\n  // Setup iovec at memory[0]: {ptr=8, len=12}\n  // Then call fd_write(1, 0, 1, 100)\n  //   fd=1 (stdout), iovs_ptr=0, iovs_count=1, nwritten_ptr=100\n  let b = bytebuf_new()\n\n  // mem[0] = 8 (iovec.buf pointer)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n\n  // mem[4] = 12 (iovec.buf_len)\n  emit_i32_const(b, 4)\n  emit_i32_const(b, 12)\n  emit_i32_store(b, 2, 0)\n\n  // call fd_write(1, 0, 1, 100)\n  emit_i32_const(b, 1)    // fd = stdout\n  emit_i32_const(b, 0)    // iovs ptr\n  emit_i32_const(b, 1)    // iovs count\n  emit_i32_const(b, 100)  // nwritten ptr\n  emit_call(b, 0)         // call fd_write (import index 0)\n  emit_drop(b)            // discard return value\n\n  emit_code_section(out, [b])\n\n  // Data section: \"hello world\\n\" at offset 8\n  let hello_data = bytebuf_new()\n  bytebuf_push(hello_data, 104)  // h\n  bytebuf_push(hello_data, 101)  // e\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 32)   // ' '\n  bytebuf_push(hello_data, 119)  // w\n  bytebuf_push(hello_data, 111)  // o\n  bytebuf_push(hello_data, 114)  // r\n  bytebuf_push(hello_data, 108)  // l\n  bytebuf_push(hello_data, 100)  // d\n  bytebuf_push(hello_data, 10)   // \\n\n  emit_data_section(out, 8, hello_data)\n\n  bytebuf_to_bytes(out)\n}\n\n// === String data helpers ===\n\n// Convert a string to a byte array (ASCII only)\nexport let string_to_data = (s: String) -> Array[Int] {\n  let buf = bytebuf_new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    bytebuf_push(buf, String::char_code_at(s, i))\n    i = i + 1\n  }\n  buf\n}\n\n// Emit data section with multiple segments\nexport let emit_data_section_multi = (out: Array[Int], offsets: Array[Int], datas: Array[Array[Int]]) -> Unit {\n  let count = Array::length(offsets)\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, count)\n  let mut i = 0\n  while i < count {\n    bytebuf_push(content, 0)  // active, memory 0\n    emit_i32_const(content, Array::get(offsets, i))\n    emit_end(content)\n    let data = Array::get(datas, i)\n    leb128_encode_u32(content, Array::length(data))\n    bytebuf_push_array(content, data)\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_data, content)\n}\n\n// Build a WASI module that prints a custom string\nexport let build_print_string_module = (msg: String) -> Bytes {\n  let out = bytebuf_new()\n  emit_header(out)\n\n  // Types: fd_write(i32,i32,i32,i32)->i32, _start()->void\n  let type_content = bytebuf_new()\n  bytebuf_push_vec_header(type_content, 2)\n  emit_func_type_raw(type_content, [vt_i32, vt_i32, vt_i32, vt_i32], [vt_i32])\n  emit_func_type_raw(type_content, Array::slice([0], 0, 0), Array::slice([0], 0, 0))\n  bytebuf_push_section(out, sec_type, type_content)\n\n  emit_import_section_func(out, \"wasi_snapshot_preview1\", \"fd_write\", 0)\n  emit_function_section(out, [1])\n  emit_memory_section(out, 1)\n  emit_exports_with_memory(out, [\"_start\"], [1], \"memory\", 0)\n\n  // String data at offset 16 (leave 0-15 for iovec + nwritten)\n  let str_data = string_to_data(msg)\n  let str_len = Array::length(str_data)\n\n  // Code: setup iovec and call fd_write\n  let b = bytebuf_new()\n  // iovec[0].buf = 16\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 16)\n  emit_i32_store(b, 2, 0)\n  // iovec[0].len = str_len\n  emit_i32_const(b, 4)\n  emit_i32_const(b, str_len)\n  emit_i32_store(b, 2, 0)\n  // fd_write(stdout=1, iovs=0, count=1, nwritten=8)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 0)\n  emit_i32_const(b, 1)\n  emit_i32_const(b, 8)\n  emit_call(b, 0)\n  emit_drop(b)\n\n  emit_code_section(out, [b])\n  emit_data_section(out, 16, str_data)\n  bytebuf_to_bytes(out)\n}\n\n// === f64 instructions ===\n\n// f64.const — emit raw i64 bits as f64 constant\n// Caller provides the raw i64 bits (from Double::to_i64_bits builtin)\nexport let emit_f64_const_bits = (buf: Array[Int], bits: Int) -> Unit {\n  bytebuf_push9(buf, 68,\n    bits & 255, (bits >> 8) & 255, (bits >> 16) & 255, (bits >> 24) & 255,\n    (bits >> 32) & 255, (bits >> 40) & 255, (bits >> 48) & 255, (bits >> 56) & 255)\n}\n\nexport let emit_f64_add = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_add)\n}\n\nexport let emit_f64_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_sub)\n}\n\nexport let emit_f64_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_mul)\n}\n\nexport let emit_f64_div = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_div)\n}\n\nexport let emit_f64_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_eq)\n}\n\nexport let emit_f64_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_ne)\n}\n\nexport let emit_f64_lt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_lt)\n}\n\nexport let emit_f64_gt = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_gt)\n}\n\nexport let emit_f64_le = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_le)\n}\n\nexport let emit_f64_ge = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_ge)\n}\n\nexport let emit_f64_neg = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_neg)\n}\n\n// i64.reinterpret_f64 — reinterpret f64 bits as i64\nexport let emit_i64_reinterpret_f64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_reinterpret_f64)\n}\n\n// f64.reinterpret_i64 — reinterpret i64 bits as f64\nexport let emit_f64_reinterpret_i64 = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_reinterpret_i64)\n}\n\n// i64.trunc_f64_s — truncate f64 to signed i64\nexport let emit_i64_trunc_f64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_trunc_f64_s)\n}\n\n// f64.convert_i64_s — convert signed i64 to f64\nexport let emit_f64_convert_i64_s = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_f64_convert_i64_s)\n}\n\n// === Table and indirect call support ===\n\n// call_indirect: opcode 0x11 + type_idx (LEB128) + table 0x00\nexport let emit_call_indirect = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_call_indirect, type_idx)\n  bytebuf_push(buf, 0)   // table index 0\n}\n\n// Emit table section (section 4): 1 funcref table with min=num_entries, no max\nexport let emit_table_section_funcref = (out: Array[Int], num_entries: Int) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 table\n  bytebuf_push2(content, type_funcref, 0)  // limits: no max\n  leb128_encode_u32(content, num_entries)\n  bytebuf_push_section(out, sec_table, content)\n}\n\n// Emit element section (section 9): active segment for table 0 at offset 0\n// func_indices: array of function indices to place in table\nexport let emit_element_section_active = (out: Array[Int], func_indices: Array[Int]) -> Unit {\n  let content = bytebuf_new()\n  bytebuf_push_vec_header(content, 1)  // 1 segment\n  bytebuf_push(content, 0)  // flags: active, table 0\n  // Offset expression: i32.const 0, end\n  emit_i32_const(content, 0)\n  emit_end(content)\n  // Function indices\n  leb128_encode_u32(content, Array::length(func_indices))\n  let mut i = 0\n  while i < Array::length(func_indices) {\n    leb128_encode_u32(content, Array::get(func_indices, i))\n    i = i + 1\n  }\n  bytebuf_push_section(out, sec_element, content)\n}\n\n// === GC instructions ===\n\n// Emit a struct type definition: struct { field_types[i] with field_muts[i] }\n// field_types: valtype bytes (0x7E=i64, 0x7F=i32, etc.)\n// field_muts: 0x00=const, 0x01=mut\nexport let emit_struct_type_raw = (buf: Array[Int], field_types: Array[Int], field_muts: Array[Int]) -> Unit {\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\n  let mut i = 0\n  while i < Array::length(field_types) {\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\n    i = i + 1\n  }\n}\n\n// struct.new $type — create a new struct (values on stack)\nexport let emit_struct_new = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 0, type_idx)\n}\n\n// struct.get $type $field — read a struct field\nexport let emit_struct_get = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 2, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// struct.set $type $field — write a struct field\nexport let emit_struct_set = (buf: Array[Int], type_idx: Int, field_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, 251, 5, type_idx)\n  leb128_encode_u32(buf, field_idx)\n}\n\n// ref.func $func — get a typed function reference\nexport let emit_ref_func = (buf: Array[Int], func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\n}\n\n// call_ref $type — call a function reference\nexport let emit_call_ref = (buf: Array[Int], type_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 20, type_idx)\n}\n\n// ref.null $heaptype — push a null reference\nexport let emit_ref_null = (buf: Array[Int], heap_type_byte: Int) -> Unit {\n  bytebuf_push2(buf, 208, heap_type_byte)\n}\n")

  let source_16 = ("vibe/compiler/codegen/common_base/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_xor, emit_if_void, emit_local_get, emit_local_set\n}\n\n// WASM opcodes (local constants for readability)\nlet op_i32_eq = 70\nlet op_i32_ne = 71\nlet op_i32_eqz = 69\nlet op_i32_mul = 108\nlet op_i32_sub = 107\nlet op_i32_ge_u = 79\nlet op_i32_gt_u = 75\nlet op_i64_load = 41\nlet op_i64_store = 55\n\n//# Types\n\n// Function registry: groups parallel arrays for function metadata\nexport struct FuncTable {\n  names: Array[String];\n  indices: Array[Int];\n  params: Array[Int];\n  returns: Array[Int]\n}\n\n// String table: groups string data with their WASM data segment offsets/lengths\nexport struct StrTable {\n  strs: Array[String];\n  offsets: Array[Int];\n  lengths: Array[Int]\n}\n\n// Lambda accumulator: collects compiled lambda bodies and metadata\nexport struct LambdaTable {\n  bodies: Array[Array[Int]];\n  param_counts: Array[Int];\n  captures: Array[Array[String]];\n  meta_i32: Array[Int];\n  meta_i64: Array[Int]\n}\n\n// Constructor/struct registry: enum variant + struct constructors\nexport struct CtorTable {\n  names: Array[String];\n  tags: Array[Int];\n  field_counts: Array[Int];\n  type_names: Array[String];\n  struct_names: Array[String];\n  struct_field_names: Array[Array[String]]\n}\n\n// Compilation context: all shared state for compile_expr\nexport struct CompileCtx {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ctor_table: CtorTable;\n  thunk_names: Array[String];\n  const_int_names: Array[String];\n  const_int_values: Array[Int]\n}\n\n// GC backend compilation context (extends CompileCtx with GC-specific fields)\nexport struct CompileCtxGc {\n  func_table: FuncTable;\n  str_table: StrTable;\n  lambda_table: LambdaTable;\n  num_user_funcs: Int;\n  func_offset: Int;\n  ref_cell_names: Array[String];\n  ref_local_indices: Array[Int];\n  refcell_type_idx: Int;\n  closure_type_base: Int;\n  ctor_table: CtorTable\n}\n\n//# Functions\n\nexport let is_efn = (expr: Expr) -> Bool {\n  match expr {\n    EFn(_, _, _, _, _, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pint = (p: Pat) -> Bool {\n  match p {\n    PInt(_) => true,\n    _ => false\n  }\n}\n\n// === Stmt extractors ===\nexport let is_slet = (stmt: Stmt) -> Bool {\n  match stmt {\n    SLet(_, _, _, _, _) => true,\n    _ => false\n  }\n}\n\n// Expr tag: returns a numeric tag for dispatch without match in let rec\n// 0=EInt, 1=EBool, 2=EFloat, 3=EString, 4=EIdent, 5=EBinOp, 6=EUnaryOp,\n// 7=EIf, 8=ECall, 9=ELet, 10=ELetRec, 11=ELetMut, 12=EAssign, 13=EAssignOp,\n// 14=ESeq, 15=ETuple, 16=EMatch, 17=EArray, 18=EForIn, 19=EWhile,\n// 20=EBreak, 21=EContinue, 22=EUnit, 23=EThrow, 24=EFn, -1=unknown\nexport let expr_tag = (expr: Expr) -> Int {\n  match expr {\n    EInt(_) => 0,\n    EBool(_) => 1,\n    EFloat(_) => 2,\n    EString(_) => 3,\n    EIdent(_) => 4,\n    EBinOp(_, _, _) => 5,\n    EUnaryOp(_, _) => 6,\n    EIf(_, _, _) => 7,\n    ECall(_, _) => 8,\n    ELet(_, _, _) => 9,\n    ELetRec(_, _, _) => 10,\n    ELetMut(_, _, _) => 11,\n    EAssign(_, _, _) => 12,\n    EAssignOp(_, _, _, _) => 13,\n    ESeq(_, _) => 14,\n    ETuple(_) => 15,\n    EMatch(_, _) => 16,\n    EArray(_) => 17,\n    EForIn(_, _, _, _) => 18,\n    EWhile(_, _) => 19,\n    EBreak(_) => 20,\n    EContinue(_) => 21,\n    EUnit => 22,\n    EThrow(_) => 23,\n    EFn(_, _, _, _, _, _) => 24,\n    _ => -1\n  }\n}\n\nexport let is_pbind = (p: Pat) -> Bool {\n  match p {\n    PBind(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pbool = (p: Pat) -> Bool {\n  match p {\n    PBool(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pctor = (p: Pat) -> Bool {\n  match p {\n    PCtor(_, _) => true,\n    _ => false\n  }\n}\n\nexport let is_pwild = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    _ => false\n  }\n}\n\n// Expr type checks (only those needed inside match arms)\nexport let is_eident = (expr: Expr) -> Bool {\n  match expr {\n    EIdent(_) => true,\n    _ => false\n  }\n}\n\n// Check if expr is an ETuple\nexport let is_etuple = (expr: Expr) -> Bool {\n  match expr {\n    ETuple(_) => true,\n    _ => false\n  }\n}\n\n// Check pattern type\nexport let is_ptuple = (p: Pat) -> Bool {\n  match p {\n    PTuple(_) => true,\n    _ => false\n  }\n}\n\nexport let is_pstring = (p: Pat) -> Bool {\n  match p {\n    PString(_) => true,\n    _ => false\n  }\n}\n\nexport let emit_i32_eq = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_eq)\n}\n\nexport let emit_i32_ne = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_ne)\n}\n\n// Extract pattern from match arm pair\nexport let get_arm_pat = (arm: (Pat, Expr)) -> Pat {\n  let (p, _) = arm\n  p\n}\n\n// Returns index into ctor_names array, or -1 if not found\nexport let rec lookup_ctor = (ctor_names: Array[String], name: String, i: Int) -> Int {\n  if i >= Array::length(ctor_names) {\n    -1\n  }\n  else if Array::get(ctor_names, i) == name {\n    i\n  }\n  else lookup_ctor(ctor_names, name, i + 1)\n}\n\nexport let emit_i32_eqz = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_eqz)\n}\n\nexport let emit_i32_mul = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_mul)\n}\n\nexport let emit_i32_sub = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_sub)\n}\n\nexport let emit_str_ref = (buf: Array[Int], offset: Int, length: Int) -> Unit {\n  emit_i64_const(buf, offset)\n  emit_i64_const(buf, 32)\n  emit_i64_shl(buf)\n  emit_i64_const(buf, length)\n  emit_i64_or(buf)\n}\n\n// Extract body from match arm pair\nexport let get_arm_body = (arm: (Pat, Expr)) -> Expr {\n  let (_, b) = arm\n  b\n}\n\nexport let get_efn_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EFn(_, _, _, _, _, body) => body,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eif_cond = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(c, _, _) => c,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_else = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, _, e) => e,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_eif_then = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EIf(_, t, _) => t,\n    _ => throw(\"not EIf\")\n  }\n}\n\nexport let get_elet_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, val, _) => val,\n    _ => throw(\"not ELet\")\n  }\n}\n\n// Resolve function: returns (func_index, param_count, has_return)\nexport let resolve_func = (ft: FuncTable, name: String) -> (Int, Int, Int)with { Error } {\n  let len = Array::length(ft.names)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(ft.names, i) == name {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"undefined function: \", name))\n  };\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\n}\n\n// Emit WASM instruction for a binary operator\nexport let emit_binop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else if op == \"&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"|\" {\n    emit_i64_or(buf)\n  }\n  else if op == \"^\" {\n    emit_i64_xor(buf)\n  }\n  else if op == \"<<\" {\n    emit_i64_shl(buf)\n  }\n  else if op == \">>\" {\n    emit_i64_shr_s(buf)\n  }\n  else if op == \"==\" {\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"!=\" {\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<\" {\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">\" {\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"<=\" {\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \">=\" {\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\n  }\n  else if op == \"&&\" {\n    emit_i64_and(buf)\n  }\n  else if op == \"||\" {\n    emit_i64_or(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported binop: \", op))\n  }\n}\n\nexport let emit_i32_ge_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_ge_u)\n}\n\nexport let emit_i32_gt_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i32_gt_u)\n}\n\nexport let emit_i64_load = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, op_i64_load)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\nexport let get_ebinop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EBinOp(op, _, _) => op,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_elet_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELet(_, _, body) => body,\n    _ => throw(\"not ELet\")\n  }\n}\n\nexport let get_elet_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELet(name, _, _) => name,\n    _ => throw(\"not ELet\")\n  }\n}\n\n// Extract function body from SLet(_, _, _, _, EFn(_, _, _, _, _, body))\nexport let get_func_body = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, _, _, _, body) => body,\n      _ => throw(\"get_func_body: not a function\")\n    },\n    _ => throw(\"get_func_body: not a let statement\")\n  }\n}\n\nexport let get_slet_expr = (stmt: Stmt) -> Expr with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => expr,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let get_slet_name = (stmt: Stmt) -> String with { Error } {\n  match stmt {\n    SLet(_, _, name, _, _) => name,\n    _ => throw(\"not SLet\")\n  }\n}\n\nexport let resolve_local = (names: Array[String], name: String, tag: String) -> Int with { Error } {\n  let mut i = Array::length(names) - 1\n  let mut result = -1\n  while i >= 0 {\n    if Array::get(names, i) == name {\n      result = i\n      i = -1\n    } else {\n      i = i - 1\n    }\n  }\n  if result < 0 {\n    let mut dbg = String::concat(\"undefined variable (local): \", name)\n    dbg = String::concat(dbg, \" [locals: \")\n    let mut di = 0\n    let dlen = Array::length(names)\n    while di < dlen {\n      if di > 0 {\n        dbg = String::concat(dbg, \", \")\n      }\n      dbg = String::concat(dbg, Array::get(names, di))\n      di = di + 1\n    }\n    dbg = String::concat(dbg, \"]\")\n    dbg = String::concat(dbg, \" @\")\n    dbg = String::concat(dbg, tag)\n    throw(dbg)\n  }\n  result\n}\n\nexport let emit_i64_store = (buf: Array[Int], align: Int, offset: Int) -> Unit {\n  bytebuf_push(buf, op_i64_store)\n  leb128_encode_u32(buf, align)\n  leb128_encode_u32(buf, offset)\n}\n\n// Find the SLet statement for a given function name\nexport let find_func_stmt = (stmts: Array[Stmt], name: String) -> Stmt with { Error } {\n  let len = Array::length(stmts)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, sname, _, _) => if sname == name {\n        found = i\n        i = len\n      }\n      ,\n      _ => ()\n    }\n    if found < 0 {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"function not found: \", name))\n  }\n  Array::get(stmts, found)\n}\n")

  let source_17 = ("vibe/compiler/codegen/common_extractors/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push, leb128_encode_u32\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_i64_add, emit_i64_div_s, emit_i64_mul, emit_i64_rem_s, emit_i64_sub\n}\n\nlet op_prefix = 252\n\n//# Functions\n\nexport let get_ebinop_lhs = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, lhs, _) => lhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ebinop_rhs = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EBinOp(_, _, rhs) => rhs,\n    _ => throw(\"not EBinOp\")\n  }\n}\n\nexport let get_ecall_args = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ECall(_, args) => args,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efn_params = (expr: Expr) -> Array[(String, Option[TypeExpr])] with { Error } {\n  match expr {\n    EFn(_, _, params, _, _, _) => params,\n    _ => throw(\"not EFn\")\n  }\n}\n\nexport let get_eint_value = (expr: Expr) -> Int with { Error } {\n  match expr {\n    EInt(n) => n,\n    _ => throw(\"not EInt\")\n  }\n}\n\nexport let get_eseq_first = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(first, _) => first,\n    _ => throw(\"not ESeq\")\n  }\n}\n\n// Extract arms from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_arms = (expr: Expr) -> Array[(Pat, Expr)] with { Error } {\n  match expr {\n    EMatch(_, arms) => arms,\n    _ => throw(\"get_match_arms: not an EMatch\")\n  }\n}\n\n// Extract name from PBind\nexport let get_pbind_name = (p: Pat) -> String with { Error } {\n  match p {\n    PBind(name) => name,\n    _ => throw(\"get_pbind_name: not a PBind\")\n  }\n}\n\nexport let get_pctor_args = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PCtor(_, args) => args,\n    _ => throw(\"get_pctor_args: not a PCtor\")\n  }\n}\n\n// Extract PCtor name and args\nexport let get_pctor_name = (p: Pat) -> String with { Error } {\n  match p {\n    PCtor(name, _) => name,\n    _ => throw(\"get_pctor_name: not a PCtor\")\n  }\n}\n\n// Extract PInt value\nexport let get_pint_value = (p: Pat) -> Int with { Error } {\n  match p {\n    PInt(n) => n,\n    _ => throw(\"get_pint_value: not a PInt\")\n  }\n}\n\nexport let get_eassign_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, val, _) => val,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_ebool_value = (expr: Expr) -> Bool with { Error } {\n  match expr {\n    EBool(b) => b,\n    _ => throw(\"not EBool\")\n  }\n}\n\nexport let get_eforin_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, _, body) => body,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_iter = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EForIn(_, _, iter, _) => iter,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eforin_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EForIn(name, _, _, _) => name,\n    _ => throw(\"not EForIn\")\n  }\n}\n\nexport let get_eident_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EIdent(name) => name,\n    _ => throw(\"not EIdent\")\n  }\n}\n\nexport let get_eletmut_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, val, _) => val,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, val, _) => val,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eseq_second = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ESeq(_, second) => second,\n    _ => throw(\"not ESeq\")\n  }\n}\n\nexport let get_ethrow_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EThrow(e) => e,\n    _ => throw(\"not EThrow\")\n  }\n}\n\nexport let get_eunaryop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EUnaryOp(op, _) => op,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\nexport let get_ewhile_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(_, body) => body,\n    _ => throw(\"not EWhile\")\n  }\n}\n\nexport let get_ewhile_cond = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EWhile(cond, _) => cond,\n    _ => throw(\"not EWhile\")\n  }\n}\n\n// Extract PBool value\nexport let get_pbool_value = (p: Pat) -> Bool with { Error } {\n  match p {\n    PBool(v) => v,\n    _ => throw(\"get_pbool_value: not a PBool\")\n  }\n}\n\n// Extract sub-patterns from PTuple\nexport let get_ptuple_pats = (p: Pat) -> Array[Pat] with { Error } {\n  match p {\n    PTuple(pats) => pats,\n    _ => throw(\"get_ptuple_pats: not a PTuple\")\n  }\n}\n\nexport let get_slet_export = (stmt: Stmt) -> Bool with { Error } {\n  match stmt {\n    SLet(is_export, _, _, _, _) => is_export,\n    _ => throw(\"not SLet\")\n  }\n}\n\n// Check if a pattern is unconditionally matching (catch-all)\nexport let rec is_catchall_pat = (p: Pat) -> Bool {\n  match p {\n    PWild => true,\n    PBind(_) => true,\n    PTuple(pats) => {\n      // PTuple is catch-all only if ALL sub-patterns are catch-all\n      let mut i = 0\n      let mut all_catch = true\n      while i < Array::length(pats) {\n        if !is_catchall_pat(Array::get(pats, i)) {\n          all_catch = false\n        }\n        i = i + 1\n      }\n      all_catch\n    },\n    _ => false\n  }\n}\n\n// Emit WASM instruction for an assign operator (+=, -=, etc.)\nexport let emit_assignop_op = (buf: Array[Int], op: String) -> Unit with { Error } {\n  if op == \"+\" {\n    emit_i64_add(buf)\n  }\n  else if op == \"-\" {\n    emit_i64_sub(buf)\n  }\n  else if op == \"*\" {\n    emit_i64_mul(buf)\n  }\n  else if op == \"/\" {\n    emit_i64_div_s(buf)\n  }\n  else if op == \"%\" {\n    emit_i64_rem_s(buf)\n  }\n  else {\n    throw(String::concat(\"unsupported assign op: \", op))\n  }\n}\n\nexport let emit_memory_copy = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_prefix)\n  leb128_encode_u32(buf, 10)\n  bytebuf_push(buf, 0)\n  bytebuf_push(buf, 0)\n}\n\nexport let get_earray_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    EArray(elems) => elems,\n    _ => throw(\"not EArray\")\n  }\n}\n\nexport let get_eassign_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssign(_, _, body) => body,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassign_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssign(name, _, _) => name,\n    _ => throw(\"not EAssign\")\n  }\n}\n\nexport let get_eassignop_op = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(_, op, _, _) => op,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_ecall_callee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ECall(callee, _) => callee,\n    _ => throw(\"not ECall\")\n  }\n}\n\nexport let get_efloat_value = (expr: Expr) -> Double with { Error } {\n  match expr {\n    EFloat(v) => v,\n    _ => throw(\"not EFloat\")\n  }\n}\n\nexport let get_eletmut_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetMut(_, _, body) => body,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletmut_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELetMut(name, _, _) => name,\n    _ => throw(\"not ELetMut\")\n  }\n}\n\nexport let get_eletrec_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    ELetRec(_, _, body) => body,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\nexport let get_eletrec_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    ELetRec(name, _, _) => name,\n    _ => throw(\"not ELetRec\")\n  }\n}\n\n// Extract elements from ETuple\nexport let get_etuple_elems = (expr: Expr) -> Array[Expr] with { Error } {\n  match expr {\n    ETuple(elems) => elems,\n    _ => throw(\"get_etuple_elems: not an ETuple\")\n  }\n}\n\nexport let str_table_lookup = (strs: Array[String], s: String) -> Int with { Error } {\n  let len = Array::length(strs)\n  let mut i = 0\n  let mut found = -1\n  while i < len {\n    if Array::get(strs, i) == s {\n      found = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  if found < 0 {\n    throw(String::concat(\"string not in table: \", s))\n  }\n  found\n}\n\n// Find the index of the first catch-all pattern in match arms\n// Returns num_arms if no catch-all found\nexport let find_catchall_idx = (arms: Array[(Pat, Expr)]) -> Int {\n  let num = Array::length(arms)\n  let mut idx = 0\n  let mut result = num\n  while idx < num {\n    let (p, _) = Array::get(arms, idx)\n    if is_catchall_pat(p) {\n      result = idx\n      idx = num\n    } else {\n      idx = idx + 1\n    }\n  }\n  result\n}\n\nexport let get_eassignop_val = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, val, _) => val,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_estring_value = (expr: Expr) -> String with { Error } {\n  match expr {\n    EString(s) => s,\n    _ => throw(\"not EString\")\n  }\n}\n\nexport let get_eunaryop_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EUnaryOp(_, e) => e,\n    _ => throw(\"not EUnaryOp\")\n  }\n}\n\n// Extract PString value\nexport let get_pstring_value = (p: Pat) -> String with { Error } {\n  match p {\n    PString(s) => s,\n    _ => throw(\"get_pstring_value: not a PString\")\n  }\n}\n\nexport let array_contains_str = (arr: Array[String], s: String) -> Bool {\n  let len = Array::length(arr)\n  let mut i = 0\n  let mut found = false\n  while i < len {\n    if Array::get(arr, i) == s {\n      found = true\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let get_eassignop_body = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EAssignOp(_, _, _, body) => body,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\nexport let get_eassignop_name = (expr: Expr) -> String with { Error } {\n  match expr {\n    EAssignOp(name, _, _, _) => name,\n    _ => throw(\"not EAssignOp\")\n  }\n}\n\n// Extract scrutinee from EMatch (non-recursive to avoid stale binding bug in let rec)\nexport let get_match_scrutinee = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EMatch(scrutinee, _) => scrutinee,\n    _ => throw(\"get_match_scrutinee: not an EMatch\")\n  }\n}\n")

  let source_18 = ("vibe/compiler/codegen/common_analysis/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_push\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_call_indirect, emit_else, emit_end, emit_i32_load, emit_i32_wrap_i64, emit_i64_and, emit_i64_const, emit_i64_eq, emit_i64_or, emit_i64_shl, emit_i64_shr_s, emit_if_void, emit_local_get, emit_local_set\n}\n\nlet op_i64_extend_i32_u = 173\n\n//# Functions\n\n\nexport let rec collect_strings_expr = (expr: Expr, out: Array[String]) -> Int {\n  match expr {\n    EString(s) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(out) {\n        if Array::get(out, i) == s {\n          found = true\n        }\n        i = i + 1\n      }\n      if !found {\n        Array::push(out, s)\n      }\n      0\n    },\n    EBinOp(_, lhs, rhs) => {\n      collect_strings_expr(lhs, out)\n      collect_strings_expr(rhs, out)\n    },\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\n    EIf(cond, then_e, else_e) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(then_e, out)\n      collect_strings_expr(else_e, out)\n    },\n    ECall(callee, args) => {\n      collect_strings_expr(callee, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_strings_expr(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetRec(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ELetMut(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssign(_, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_strings_expr(value, out)\n      collect_strings_expr(body, out)\n    },\n    ESeq(first, second) => {\n      collect_strings_expr(first, out)\n      collect_strings_expr(second, out)\n    },\n    EWhile(cond, body) => {\n      collect_strings_expr(cond, out)\n      collect_strings_expr(body, out)\n    },\n    EForIn(_, _, iter_e, body) => {\n      collect_strings_expr(iter_e, out)\n      collect_strings_expr(body, out)\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_strings_expr(Array::get(elems, i), out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_strings_expr(scrutinee, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (pat, arm_expr) = Array::get(arms, i)\n        match pat {\n          PString(s) => {\n            let mut pf = false\n            let mut pi = 0\n            while pi < Array::length(out) {\n              if Array::get(out, pi) == s {\n                pf = true\n              }\n              pi = pi + 1\n            }\n            if !pf {\n              Array::push(out, s)\n            }\n            0\n          },\n          _ => 0\n        }\n        collect_strings_expr(arm_expr, out)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\n    EThrow(msg) => collect_strings_expr(msg, out),\n    EHandle(body, arms) => {\n      collect_strings_expr(body, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_strings_expr(arm_expr, out)\n        hi = hi + 1\n      }\n      0\n    },\n    _ => 0\n  }\n}\n\n// Extract function param names from SLet(_, _, _, _, EFn(_, _, params, _, _, _))\nexport let get_func_param_names = (stmt: Stmt) -> Array[String] with { Error } {\n  match stmt {\n    SLet(_, _, _, _, expr) => match expr {\n      EFn(_, _, params, _, _, _) => {\n        let names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut i = 0\n        while i < Array::length(params) {\n          let (pname, _) = Array::get(params, i)\n          Array::push(names, pname)\n          i = i + 1\n        }\n        names\n      },\n      _ => throw(\"get_func_param_names: not a function\")\n    },\n    _ => throw(\"get_func_param_names: not a let statement\")\n  }\n}\n\nexport let collect_strings_stmts = (stmts: Array[Stmt]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\n      _ => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let emit_i64_extend_i32_u = (buf: Array[Int]) -> Unit {\n  bytebuf_push(buf, op_i64_extend_i32_u)\n}\n\n// Resolve closure/fn value tag and fill slot_local/env_local\n// After this: slot_local = table slot index, env_local = env pointer (0 for bare fn)\nexport let emit_closure_resolve = (buf: Array[Int], fn_val_local: Int, slot_local: Int, env_local: Int) -> Unit {\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 3)\n  emit_i64_and(buf)\n  emit_i64_const(buf, 2)\n  emit_i64_eq(buf)\n  emit_if_void(buf)\n  // Bare fn: table_slot = fn_val >> 2, env = 0\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, 2)\n  emit_i64_shr_s(buf)\n  emit_local_set(buf, slot_local)\n  emit_i64_const(buf, 0)\n  emit_local_set(buf, env_local)\n  emit_else(buf)\n  // Closure: env = fn_val & ~3, slot = i32.load(env, 0)\n  emit_local_get(buf, fn_val_local)\n  emit_i64_const(buf, -4)\n  emit_i64_and(buf)\n  emit_local_set(buf, env_local)\n  emit_local_get(buf, env_local)\n  emit_i32_wrap_i64(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i64_extend_i32_u(buf)\n  emit_local_set(buf, slot_local)\n  emit_end(buf)\n}\n\n// Emit the tail of an indirect closure call (push env, push slot, call_indirect)\nexport let emit_closure_call_tail = (buf: Array[Int], env_local: Int, slot_local: Int, closure_type_base: Int, num_args: Int) -> Unit {\n  emit_local_get(buf, env_local)\n  emit_local_get(buf, slot_local)\n  emit_i32_wrap_i64(buf)\n  emit_call_indirect(buf, closure_type_base + num_args)\n}\n\nlet rec collect_pattern_bindings = (pat: Pat, bindings: Array[String]) -> Int {\n  match pat {\n    PBind(name) => {\n      Array::push(bindings, name); 0\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        collect_pattern_bindings(Array::get(pats, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_pattern_bindings(Array::get(args, i), bindings)\n        i = i + 1\n      }\n      0\n    },\n    POr(l, r) => {\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\n    },\n    _ => 0\n  }\n}\n\n// Stack-based free variable analysis: uses in-place push/truncate on bound array\n// to avoid O(n) array copies at every scope boundary. This dramatically reduces\n// heap allocation during meta-circular self-compilation.\nexport let rec collect_free_vars_expr = (expr: Expr, bound: Array[String], fn_names: Array[String], out: Array[String]) -> Int {\n  match expr {\n    EIdent(name) => if array_contains_str(bound, name) {\n      0\n    }\n    else if array_contains_str(fn_names, name) {\n      0\n    }\n    else if array_contains_str(out, name) {\n      0\n    }\n    else {\n      Array::push(out, name)\n      0\n    }\n    ,\n    EInt(_) => 0,\n    EBool(_) => 0,\n    EFloat(_) => 0,\n    EString(_) => 0,\n    EUnit => 0,\n    EBinOp(_, lhs, rhs) => {\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\n    },\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\n    EIf(cond, then_e, else_e) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\n    },\n    ECall(callee, args) => {\n      collect_free_vars_expr(callee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    ELet(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetRec(name, value, body) => {\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(value, bound, fn_names, out)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ELetMut(name, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, name)\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EAssign(_, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EAssignOp(_, _, value, body) => {\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    ESeq(first, second) => {\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\n    },\n    EWhile(cond, body) => {\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\n    },\n    EForIn(var_name, index_name, iter_e, body) => {\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\n      let saved = Array::length(bound)\n      Array::push(bound, var_name)\n      match index_name {\n        Some(index_name) => Array::push(bound, index_name),\n        None => ()\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    ETuple(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EArray(elems) => {\n      let mut i = 0\n      while i < Array::length(elems) {\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\n        i = i + 1\n      }\n      0\n    },\n    EMatch(scrutinee, arms) => {\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (arm_pat, arm_expr) = Array::get(arms, i)\n        let saved = Array::length(bound)\n        collect_pattern_bindings(arm_pat, bound)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        Array::truncate(bound, saved)\n        i = i + 1\n      }\n      0\n    },\n    EFn(_, _, params, _, _, body) => {\n      let saved = Array::length(bound)\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        Array::push(bound, pname)\n        pi = pi + 1\n      }\n      collect_free_vars_expr(body, bound, fn_names, out)\n      Array::truncate(bound, saved)\n      0\n    },\n    EBreak(_) => 0,\n    EContinue(_) => 0,\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\n    EHandle(body, arms) => {\n      collect_free_vars_expr(body, bound, fn_names, out)\n      let mut hi = 0\n      while hi < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, hi)\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\n        hi = hi + 1\n      }\n      0\n    },\n    EDot(obj, _) => collect_free_vars_expr(obj, bound, fn_names, out),\n    ERecord(fields) => {\n      let mut ri = 0\n      while ri < Array::length(fields) {\n        let (_, fval) = Array::get(fields, ri)\n        collect_free_vars_expr(fval, bound, fn_names, out)\n        ri = ri + 1\n      }\n      0\n    },\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\n    _ => 0\n  }\n}\n\nexport let collect_free_vars = (body: Expr, param_names: Array[String], fn_names: Array[String]) -> Array[String] {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  // Make a mutable copy of param_names for stack-based push/truncate\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\n  collect_free_vars_expr(body, bound, fn_names, out)\n  out\n}\n\n// Check if a mutable variable is captured by any nested EFn in the given expression\nexport let rec is_mut_captured_in = (expr: Expr, name: String) -> Bool {\n  match expr {\n    EIdent(_) => false,\n    EInt(_) => false,\n    EBool(_) => false,\n    EFloat(_) => false,\n    EString(_) => false,\n    EUnit => false,\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\n    ECall(callee, args) => if is_mut_captured_in(callee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(args) {\n        if is_mut_captured_in(Array::get(args, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n    ,\n    ELet(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    ELetRec(n, value, body) => if n == name {\n      false\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    ELetMut(n, value, body) => if n == name {\n      is_mut_captured_in(value, name)\n    }\n    else {\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\n    }\n    ,\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\n    ETuple(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EArray(elems) => {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(elems) {\n        if is_mut_captured_in(Array::get(elems, i), name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    },\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\n      true\n    }\n    else {\n      let mut i = 0\n      let mut found = false\n      while i < Array::length(arms) {\n        let (_, arm_expr) = Array::get(arms, i)\n        if is_mut_captured_in(arm_expr, name) {\n          found = true\n        }\n        i = i + 1\n      }\n      found\n    }\n    ,\n    EFn(_, _, params, _, _, fn_body) => {\n      // Check if name is shadowed by params\n      let mut shadowed = false\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pname, _) = Array::get(params, pi)\n        if pname == name {\n          shadowed = true\n        }\n        pi = pi + 1\n      }\n      if shadowed {\n        false\n      }\n      else {\n        // Check if name is free in this EFn\n        let param_names = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut pi2 = 0\n        while pi2 < Array::length(params) {\n          let (pname2, _) = Array::get(params, pi2)\n          Array::push(param_names, pname2)\n          pi2 = pi2 + 1\n        }\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\n          \"\"\n        ], 0, 0))\n        if array_contains_str(fv, name) {\n          true\n        }\n        else {\n          // Also check recursively for deeper nesting\n          is_mut_captured_in(fn_body, name)\n        }\n      }\n    },\n    EBreak(_) => false,\n    EContinue(_) => false,\n    EThrow(msg) => is_mut_captured_in(msg, name),\n    _ => false\n  }\n}\n")

  let source_19 = ("vibe/compiler/codegen/expr/index.vibe",
"//# Imports\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr,\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport ../common_base/index.vibe {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport ../common_extractors/index.vibe {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport ../common_analysis/index.vibe {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport ../wasm_emit/index.vibe {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nlet compile_call = (buf: Array[Int], callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if is_eident(callee) {\n    let fname = get_eident_name(callee)\n    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let obj_size = 8 + fc * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, fc)\n      emit_i32_store(buf, 2, 4)\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(rec_fields) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = Array::slice([\n                EUnit\n              ], 0, 0)\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n                let mut found_rfv = EUnit\n                while ri < Array::length(rec_fields) {\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\n                  if rfn == target_name {\n                    found_rfv = rfv\n                    ri = Array::length(rec_fields)\n                  } else {\n                    ri = ri + 1\n                  }\n                }\n                Array::push(ordered, found_rfv)\n                oi = oi + 1\n              }\n              ordered\n            } else {\n              args\n            }\n          },\n          _ => args\n        }\n      } else {\n        args\n      }\n      let mut nl_c = next_local + 1\n      let mut fi_c = 0\n      while fi_c < Array::length(actual_args) {\n        nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n        let val_local = nl_c\n        Array::push(local_names, \"__ctor_val\")\n        emit_local_set(buf, val_local)\n        nl_c = nl_c + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + fi_c * 8)\n        fi_c = fi_c + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_c\n    }\n    else if fname == \"Bytes::from_array\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"Bytes::length\" {\n      let (al_idx, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_call(buf, al_idx)\n      nl\n    }\n    else if fname == \"Bytes::get\" {\n      let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, ag_idx)\n      nl\n    }\n    else if fname == \"eq\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if fname == \"not\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if fname == \"add\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_add(buf)\n      nl\n    }\n    else if fname == \"sub\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    }\n    else if fname == \"mul\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_mul(buf)\n      nl\n    }\n    else if fname == \"lt\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if fname == \"perform\" {\n      // Stub: perform returns its argument (effect not actually dispatched)\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"resume\" {\n      // Stub: resume returns its argument\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"assert\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_else(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"Double::to_i64_bits\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"String::ends_with\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, 29)\n      nl\n    }\n    else if fname == \"String::last_index_of\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, 30)\n      nl\n    }\n    else if fname == \"__slice\" {\n      // __slice(container, start, end) → String::substring fallback\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      nl = ce(buf, Array::get(args, 2), local_names, nl, ctx, ld)\n      let (ss_idx, _, _) = resolve_func(ctx.func_table, \"String::substring\")\n      emit_call(buf, ss_idx)\n      nl\n    }\n    else if fname == \"__len\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      // Try String::length (works for both string and array in practice)\n      let (sl_idx, _, _) = resolve_func(ctx.func_table, \"String::length\")\n      emit_call(buf, sl_idx)\n      nl\n    }\n    else if fname == \"__index\" {\n      // __index(container, idx) → Array::get fallback\n      let (ag_idx, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_call(buf, ag_idx)\n      nl\n    }\n    else {\n      let fn_len2 = Array::length(ctx.func_table.names)\n      let mut __tr_j = 0\n      let mut __tr_result = -1\n      while __tr_j < fn_len2 {\n        if Array::get(ctx.func_table.names, __tr_j) == fname {\n          __tr_result = __tr_j\n          __tr_j = fn_len2\n        } else {\n          __tr_j = __tr_j + 1\n        }\n      }\n      let fn_idx_in_list = __tr_result\n      if fn_idx_in_list >= 0 {\n        let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\n        let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\n        let mut nl = next_local\n        let mut ci = 0\n        while ci < Array::length(args) {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)\n          ci = ci + 1\n        }\n        if ctx.func_offset > 0 {\n          if fidx >= ctx.func_offset {\n            emit_i64_const(buf, 0)\n          }\n        }\n        emit_call(buf, fidx)\n        if has_ret == 0 {\n          emit_i64_const(buf, 0)\n        }\n        nl\n      } else {\n        let local_idx2 = resolve_local(local_names, fname, \"call\")\n        let num_args = Array::length(args)\n        let fn_val_local = next_local\n        let slot_local = next_local + 1\n        let env_local = next_local + 2\n        let mut nl = next_local + 3\n        Array::push(local_names, \"__fn_val\")\n        Array::push(local_names, \"__slot\")\n        Array::push(local_names, \"__env\")\n        emit_local_get(buf, local_idx2)\n        emit_local_set(buf, fn_val_local)\n        emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n        let mut ci = 0\n        while ci < num_args {\n          nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)\n          ci = ci + 1\n        }\n        emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n        nl\n      }\n    }\n    // close ctor_lookup else\n  } else {\n    let num_args = Array::length(args)\n    let fn_val_local = next_local\n    let slot_local = next_local + 1\n    let env_local = next_local + 2\n    let mut nl = next_local + 3\n    Array::push(local_names, \"__fn_val\")\n    Array::push(local_names, \"__slot\")\n    Array::push(local_names, \"__env\")\n    nl = ce(buf, callee, local_names, nl, ctx, ld)\n    emit_local_set(buf, fn_val_local)\n    emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\n    let mut ci = 0\n    while ci < num_args {\n      nl = ce(buf, Array::get(args, ci), local_names, nl, ctx, ld)\n      ci = ci + 1\n    }\n    emit_closure_call_tail(buf, env_local, slot_local, 9, num_args)\n    nl\n  }\n}\n\nlet compile_match = (buf: Array[Int], expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    let __cond_p = get_arm_pat(Array::get(__match_arms, ai))\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          1\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, 8)\n              emit_i64_const(buf, 1)\n              emit_i64_eq(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else {\n            0\n          }\n        }\n      }\n    }\n    let __arm_body = get_arm_body(Array::get(__match_arms, ai))\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < Array::length(cargs_bind) {\n        let __sub_p = Array::get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          Array::push(local_names, pname)\n        } else if is_ptuple(__sub_p) {\n          let tpats = get_ptuple_pats(__sub_p)\n          let tup_local = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, tup_local)\n          Array::push(local_names, \"__ctor_tup\")\n          let mut ti = 0\n          while ti < Array::length(tpats) {\n            let tp = Array::get(tpats, ti)\n            if is_pbind(tp) {\n              let tpname = get_pbind_name(tp)\n              let tfl = Array::length(local_names)\n              emit_local_get(buf, tup_local)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, ti * 8)\n              emit_local_set(buf, tfl)\n              Array::push(local_names, tpname)\n            }\n            ti = ti + 1\n          }\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let __catch_p = get_arm_pat(__catch_arm)\n    let __catch_body = get_arm_body(__catch_arm)\n    0\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        let cargs = get_pctor_args(__catch_p)\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          let __sub_p2 = Array::get(cargs, cbi2)\n          if is_pbind(__sub_p2) {\n            let pname = get_pbind_name(__sub_p2)\n            let fl2 = Array::length(local_names)\n            emit_local_get(buf, scrut_local)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + cbi2 * 8)\n            emit_local_set(buf, fl2)\n            Array::push(local_names, pname)\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let pats = get_ptuple_pats(__catch_p)\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          let mut pi2 = 0\n          while pi2 < Array::length(pats) {\n            let __tp = Array::get(pats, pi2)\n            if is_pbind(__tp) {\n              let pname = get_pbind_name(__tp)\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            } else {\n              if is_pwild(__tp) {\n                0\n              } else {\n                throw(\"unsupported pattern in tuple destructure\")\n              }\n            }\n            pi2 = pi2 + 1\n          }\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\nlet compile_lambda = (buf: Array[Int], params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Array[Int], Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let extra_lam = if final_lam_nl > (user_params + 1) {\n    final_lam_nl - (user_params + 1)\n  } else {\n    0\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __cap_resolve)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      }\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\nexport let rec compile_expr = (buf: Array[Int], expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int) -> Int with { Error } {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      1\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let bits = Double::to_i64_bits(v)\n    emit_f64_const_bits(buf, bits)\n    emit_i64_reinterpret_f64(buf)\n    next_local\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl_result = __tl_i\n        __tl_i = -1\n        // break\n      } else {\n        __tl_i = __tl_i - 1\n      }\n    }\n    let local_idx = __tl_result\n    if local_idx >= 0 {\n      if array_contains_str(ctx.ref_cell_names, name) {\n        emit_local_get(buf, local_idx)\n        emit_i32_wrap_i64(buf)\n        emit_i64_load(buf, 3, 0)\n      } else {\n        emit_local_get(buf, local_idx)\n      }\n      next_local\n    } else {\n      // Check const_int bindings first (top-level let X = <int literal>)\n      let mut __ci_idx = -1\n      let __ci_len = Array::length(ctx.const_int_names)\n      let mut __ci_j = 0\n      while __ci_j < __ci_len {\n        if Array::get(ctx.const_int_names, __ci_j) == name {\n          __ci_idx = __ci_j\n          __ci_j = __ci_len\n        } else {\n          __ci_j = __ci_j + 1\n        }\n      }\n      if __ci_idx >= 0 {\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\n        next_local\n      } else {\n      let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\n      if ctor_idx >= 0 {\n        let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\n        let ptr_l = next_local\n        Array::push(local_names, \"__ctor_ptr\")\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_l)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, 8)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_local_get(buf, ptr_l)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag_c)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_l)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 0)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_l)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        next_local + 1\n      } else {\n        let fn_len = Array::length(ctx.func_table.names)\n        let mut __tf_j = 0\n        let mut __tf_result = -1\n        while __tf_j < fn_len {\n          if Array::get(ctx.func_table.names, __tf_j) == name {\n            __tf_result = __tf_j\n            __tf_j = fn_len\n            // break\n          } else {\n            __tf_j = __tf_j + 1\n          }\n        }\n        if __tf_result < 0 {\n          let mut diag = String::concat(\"undefined variable (ident): \", name)\n          diag = String::concat(diag, \" | locals=[\")\n          let mut di = 0\n          while di < len {\n            if di > 0 {\n              diag = String::concat(diag, \",\")\n            }\n            diag = String::concat(diag, Array::get(local_names, di))\n            di = di + 1\n          }\n          diag = String::concat(diag, \"]\")\n          throw(diag)\n        }\n        let fni = __tf_result\n        let fidx = Array::get(ctx.func_table.indices, fni)\n        if array_contains_str(ctx.thunk_names, name) {\n          emit_i64_const(buf, 0)\n          // env=0\n          emit_call(buf, fidx)\n          next_local\n        } else {\n          let table_slot = fidx - ctx.func_offset\n          emit_i64_const(buf, (table_slot<<2)|2)\n          next_local\n        }\n      }\n      }\n    }\n  } else if __tag == 5 {\n    let op = get_ebinop_op(expr)\n    let lhs = get_ebinop_lhs(expr)\n    let rhs = get_ebinop_rhs(expr)\n    let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\n    let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\n    if op == \"==\" {\n      // Use eq builtin for deep equality (handles strings)\n      let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n      emit_call(buf, eq_fidx)\n    } else if op == \"!=\" {\n      let (eq_fidx, _, _) = resolve_func(ctx.func_table, \"eq\")\n      emit_call(buf, eq_fidx)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n    } else {\n      emit_binop_op(buf, op)\n    }\n    nl2\n  } else if __tag == 6 {\n    let op = get_eunaryop_op(expr)\n    let operand = get_eunaryop_expr(expr)\n    if op == \"-\" {\n      emit_i64_const(buf, 0)\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    } else if op == \"!\" {\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    } else {\n      throw(String::concat(\"unsupported unary op: \", op))\n    }\n  } else if __tag == 7 {\n    let cond = get_eif_cond(expr)\n    let then_e = get_eif_then(expr)\n    let else_e = get_eif_else(expr)\n    // S1b: skip extend+wrap roundtrip for comparison conditions\n    let cond_tag = expr_tag(cond)\n    let nl1 = if cond_tag == 5 {\n      // EBinOp: check if comparison op\n      let cop = get_ebinop_op(cond)\n      if cop == \"==\" || cop == \"!=\" || cop == \"<\" || cop == \">\" || cop == \"<=\" || cop == \">=\" {\n        let clhs = get_ebinop_lhs(cond)\n        let crhs = get_ebinop_rhs(cond)\n        let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\n        let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\n        // Emit comparison (leaves i32 on stack, no extend needed)\n        if cop == \"==\" { emit_i64_eq(buf) }\n        else if cop == \"!=\" { emit_i64_ne(buf) }\n        else if cop == \"<\" { emit_i64_lt_s(buf) }\n        else if cop == \">\" { emit_i64_gt_s(buf) }\n        else if cop == \"<=\" { emit_i64_le_s(buf) }\n        else { emit_i64_ge_s(buf) }\n        cnl2\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else if cond_tag == 1 {\n      // EBool literal: emit i32 directly\n      let b_val = get_ebool_value(cond)\n      emit_i32_const(buf, if b_val { 1 } else { 0 })\n      next_local\n    } else if cond_tag == 6 {\n      // EUnaryOp \"!\": check if operand is comparison\n      let uop = get_eunaryop_op(cond)\n      let uoperand = get_eunaryop_expr(cond)\n      if uop == \"!\" {\n        let inner_tag = expr_tag(uoperand)\n        if inner_tag == 5 {\n          let iop = get_ebinop_op(uoperand)\n          if iop == \"==\" || iop == \"!=\" || iop == \"<\" || iop == \">\" || iop == \"<=\" || iop == \">=\" {\n            let ilhs = get_ebinop_lhs(uoperand)\n            let irhs = get_ebinop_rhs(uoperand)\n            let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\n            let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\n            if iop == \"==\" { emit_i64_eq(buf) }\n            else if iop == \"!=\" { emit_i64_ne(buf) }\n            else if iop == \"<\" { emit_i64_lt_s(buf) }\n            else if iop == \">\" { emit_i64_gt_s(buf) }\n            else if iop == \"<=\" { emit_i64_le_s(buf) }\n            else { emit_i64_ge_s(buf) }\n            emit_i32_eqz(buf)\n            inl2\n          } else {\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n            emit_i32_wrap_i64(buf)\n            cnl\n          }\n        } else {\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n          emit_i32_wrap_i64(buf)\n          cnl\n        }\n      } else {\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n        emit_i32_wrap_i64(buf)\n        cnl\n      }\n    } else {\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      cnl\n    }\n    emit_if_i64(buf)\n    let ld_inner = if ld >= 0 {\n      ld + 1\n    } else {\n      -1\n    }\n    let names_len_before = Array::length(local_names)\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\n    emit_else(buf)\n    Array::truncate(local_names, names_len_before)\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\n    emit_end(buf)\n    let max_nl_if = if nl2 > nl3 {\n      nl2\n    } else {\n      nl3\n    }\n    while Array::length(local_names) < max_nl_if {\n      Array::push(local_names, \"\")\n    }\n    max_nl_if\n  } else if __tag == 8 {\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      let caps = collect_free