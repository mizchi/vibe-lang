tion, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    let __cond_p = get_arm_pat(Array::get(__match_arms, ai))\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          if ctx.enable_rc { 2 } else { 1 }\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, str_eq_fi)\n              emit_i32_wrap_i64(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else {\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\n              match pat {\n                POr(left, right) => {\n                  emit_or_check(left)\n                  emit_or_check(right)\n                  bytebuf_push(buf, 114)\n                },\n                PInt(n) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, n)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, 1)\n                    emit_i64_shl(buf)\n                  }\n                  emit_i64_eq(buf)\n                },\n                PCtor(cname, cargs) => {\n                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)\n                  let ctag = if ci >= 0 {\n                    Array::get(ctx.ctor_table.tags, ci)\n                  } else {\n                    -1\n                  }\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i32_load(buf, 2, 0)\n                  emit_i32_const(buf, ctag)\n                  emit_i32_eq(buf)\n                  if Array::length(cargs) == 1 {\n                    match Array::get(cargs, 0) {\n                      PInt(n) => {\n                        emit_local_get(buf, scrut_local)\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                        emit_i32_wrap_i64(buf)\n                        emit_i64_load(buf, 3, 8)\n                        emit_i64_const(buf, n)\n                        if ctx.enable_rc {\n                          emit_i64_const(buf, 1)\n                          emit_i64_shl(buf)\n                        }\n                        emit_i64_eq(buf)\n                        bytebuf_push(buf, 113)\n                      },\n                      _ => ()\n                    }\n                  }\n                },\n                _ => emit_i32_const(buf, 1)\n              }\n            }\n            emit_or_check(__cond_p)\n            emit_if_i64(buf)\n            0\n          }\n        }\n      }\n    }\n    let __arm_body = get_arm_body(Array::get(__match_arms, ai))\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < Array::length(cargs_bind) {\n        let __sub_p = Array::get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          Array::push(local_names, pname)\n        } else if is_ptuple(__sub_p) {\n          let tpats = get_ptuple_pats(__sub_p)\n          let tup_local = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, tup_local)\n          Array::push(local_names, \"__ctor_tup\")\n          let mut ti = 0\n          while ti < Array::length(tpats) {\n            let tp = Array::get(tpats, ti)\n            if is_pbind(tp) {\n              let tpname = get_pbind_name(tp)\n              let tfl = Array::length(local_names)\n              emit_local_get(buf, tup_local)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + ti * 8 } else { ti * 8 })\n              emit_local_set(buf, tfl)\n              Array::push(local_names, tpname)\n            }\n            ti = ti + 1\n          }\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let __catch_p = get_arm_pat(__catch_arm)\n    let __catch_body = get_arm_body(__catch_arm)\n    0\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        let cargs = get_pctor_args(__catch_p)\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          let __sub_p2 = Array::get(cargs, cbi2)\n          if is_pbind(__sub_p2) {\n            let pname = get_pbind_name(__sub_p2)\n            let fl2 = Array::length(local_names)\n            emit_local_get(buf, scrut_local)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + cbi2 * 8)\n            emit_local_set(buf, fl2)\n            Array::push(local_names, pname)\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let pats = get_ptuple_pats(__catch_p)\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          let mut pi2 = 0\n          while pi2 < Array::length(pats) {\n            let __tp = Array::get(pats, pi2)\n            if is_pbind(__tp) {\n              let pname = get_pbind_name(__tp)\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            } else if is_ptuple(__tp) {\n              let sub_pats = get_ptuple_pats(__tp)\n              let sub_ptr = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })\n              emit_local_set(buf, sub_ptr)\n              Array::push(local_names, \"__sub_tup\")\n              let mut si3 = 0\n              while si3 < Array::length(sub_pats) {\n                let sp = Array::get(sub_pats, si3)\n                if is_pbind(sp) {\n                  let spname = get_pbind_name(sp)\n                  let sfl = Array::length(local_names)\n                  emit_local_get(buf, sub_ptr)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, -2)\n                    emit_i64_and(buf)\n                  }\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, if ctx.enable_rc { 8 + si3 * 8 } else { si3 * 8 })\n                  emit_local_set(buf, sfl)\n                  Array::push(local_names, spname)\n                }\n                si3 = si3 + 1\n              }\n              0\n            } else {\n              if is_pwild(__tp) {\n                0\n              } else {\n                throw(\"unsupported pattern in tuple destructure\")\n              }\n            }\n            pi2 = pi2 + 1\n          }\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n")

  let cli_adapter_source_52 = ("vibe/compiler/codegen/expr/compile_lambda.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root\n}\n\nimport .. / .. / perceus {\n  build_perceus_plan_with_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, type_expr_is_heap\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\n// ADR-0055 Stage 4: a runtime-guarded rc_dup of the value in `local_idx` — a\n// no-op on an even (scalar) value or a string/bytes fat pointer (high 32 bits\n// set). Replica of compile_expr_tail's emit_rc_dup_guarded (avoids a circular\n// import: the tail chain calls compile_lambda).\nlet lam_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nexport let compile_lambda: (Bytes, Array[(String, Option[TypeExpr])], Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, params, fn_body, local_names, next_local, ctx, ld, compile_fn) -> {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname_raw, _) = Array::get(params, lpi)\n    let lpnlen = String::length(lpname_raw)\n    let lpname = if lpnlen > 0 {\n      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)\n      if lpc == '~' {\n        lpname_raw[0: lpnlen - 1]\n      } else if lpc == '?' {\n        lpname_raw[0: lpnlen - 1]\n      } else {\n        lpname_raw\n      }\n    } else lpname_raw\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  // RC: a lambda body has its own scope, so run the Perceus analysis on it and\n  // give the lambda ctx its own drop set (otherwise per-iteration tuples in a\n  // callback / returned closure leak). ADR-0055 Stage 4 (owned-vs-borrowed): the\n  // analysis also declares the parameters as owned bindings, so a heap param used\n  // only by borrows is dropped at the body tail rather than leaked.\n  // norm_params = params with the labeled-arg `~`/`?` suffix stripped, matching\n  // how the body references them (and how lam_locals were named).\n  let norm_params = Array::slice(params, 0, 0)\n  let mut npi = 0\n  while npi < Array::length(params) {\n    let (rawn, pty) = Array::get(params, npi)\n    let rnlen = String::length(rawn)\n    let sn = if rnlen > 0 {\n      let lc = String::char_code_at(rawn, rnlen - 1)\n      if lc == '~' || lc == '?' {\n        rawn[0: rnlen - 1]\n      } else {\n        rawn\n      }\n    } else {\n      rawn\n    }\n    Array::push(norm_params, (sn, pty))\n    npi = npi + 1\n  }\n  let lam_drops = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_alias_dups = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_dups = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_heap_params = Array::slice([\n    \"\"\n  ], 0, 0)\n  if ctx.enable_rc {\n    let lam_plan = build_perceus_plan_with_params(norm_params, fn_body)\n    let mut ldi = 0\n    while ldi < Array::length(lam_plan) {\n      let lpa = Array::get(lam_plan, ldi)\n      if pa_is_drop(lpa) {\n        Array::push(lam_drops, lpa.name)\n      } else if pa_is_alias_dup(lpa) {\n        Array::push(lam_alias_dups, lpa.name)\n      } else if pa_is_dup(lpa) {\n        Array::push(lam_dups, lpa.name)\n      } else {\n        ()\n      }\n      ldi = ldi + 1\n    }\n    let mut hpi = 0\n    while hpi < Array::length(norm_params) {\n      let (hpn, hpt) = Array::get(norm_params, hpi)\n      if type_expr_is_heap(hpt) {\n        Array::push(lam_heap_params, hpn)\n      } else {\n        ()\n      }\n      hpi = hpi + 1\n    }\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values,\n    enable_rc: ctx.enable_rc,\n    rc_drop_names: lam_drops,\n    rc_alias_dup_names: lam_alias_dups,\n    heap_binding_names: lam_heap_params,\n    rc_drop_func_idx: ctx.rc_drop_func_idx,\n    rc_alloc_func_idx: ctx.rc_alloc_func_idx,\n    rc_dup_names: lam_dups\n  }\n  // ADR-0055 Stage 4: emit the owning-use dup budget for heap params at function\n  // entry (one guarded rc_dup per plan PaDup(param)) — a param used in N owning\n  // positions needs N-1 extra refs. Param i lives at local index i.\n  if ctx.enable_rc {\n    let mut dpi = 0\n    while dpi < Array::length(norm_params) {\n      let (dpn, dpt) = Array::get(norm_params, dpi)\n      if type_expr_is_heap(dpt) {\n        let mut dcount = 0\n        let mut dqi = 0\n        while dqi < Array::length(lam_dups) {\n          if Array::get(lam_dups, dqi) == dpn {\n            dcount = dcount + 1\n          } else {\n            ()\n          }\n          dqi = dqi + 1\n        }\n        let mut de = 0\n        while de < dcount {\n          lam_emit_rc_dup_guarded(lam_buf, dpi)\n          de = de + 1\n        }\n      } else {\n        ()\n      }\n      dpi = dpi + 1\n    }\n  } else {\n    ()\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  // ADR-0055 Stage 4: drop owned heap params (borrow-only / unused, hence in the\n  // plan's drop set) at the body tail. The body result is on the stack. If that\n  // result is a projection rooted at one of the dropped params, dup it first\n  // (the recursive drop would otherwise free the field it aliases — use-after\n  // -free); the guarded dup is a no-op on a scalar result.\n  let mut tail_lam_nl = final_lam_nl\n  if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 {\n    let tail_root = scope_tail_proj_root(fn_body)\n    let mut need_dup = false\n    let mut ti = 0\n    while ti < Array::length(norm_params) {\n      let (tpn, tpt) = Array::get(norm_params, ti)\n      if type_expr_is_heap(tpt) && array_contains_str(lam_drops, tpn) && tpn == tail_root {\n        need_dup = true\n      } else {\n        ()\n      }\n      ti = ti + 1\n    }\n    let rtemp = final_lam_nl\n    if need_dup {\n      emit_local_set(lam_buf, rtemp)\n      lam_emit_rc_dup_guarded(lam_buf, rtemp)\n      tail_lam_nl = final_lam_nl + 1\n    } else {\n      ()\n    }\n    let mut tj = 0\n    while tj < Array::length(norm_params) {\n      let (dpn2, dpt2) = Array::get(norm_params, tj)\n      if type_expr_is_heap(dpt2) && array_contains_str(lam_drops, dpn2) {\n        emit_local_get(lam_buf, tj)\n        emit_call(lam_buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      tj = tj + 1\n    }\n    if need_dup {\n      emit_local_get(lam_buf, rtemp)\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if tail_lam_nl > min_lam_nl {\n    extra_lam = tail_lam_nl - min_lam_nl\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __cap_resolve)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      }\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n")

  let cli_adapter_source_53 = ("vibe/compiler/codegen/expr/compile_call.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_call: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {\n  if is_eident(callee) {\n    let fname = get_eident_name(callee)\n    let fn_len2 = Array::length(ctx.func_table.names)\n    let mut fn_idx_in_list = -1\n    let mut __tr_j = 0\n    while __tr_j < fn_len2 {\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\n        fn_idx_in_list = __tr_j\n        __tr_j = fn_len2\n    