  let cli_adapter_source_28 = ("vibe/compiler/checker/checker_resolve.vibe",
"//# Imports\n\nimport .. / core / ast.vibe {\n  TypeExpr\n}\n\nimport .. / core / types.vibe {\n  Type, TypeDef, find_typedef, resolve_builtin\n}\n\n//# Functions\n\nexport let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {\n  match te {\n    TyUnit => CtUnit,\n    TyName(name) => match resolve_builtin(name) {\n      Some(t) => t,\n      None => match find_typedef(defs, name) {\n        Some(td) => match td {\n          TDEnum(n, _) => CtEnum(n),\n          TDStruct(n, _) => CtStruct(n),\n          TDAlias(_, t) => t\n        },\n        None => CtNamed(name, Array::slice([\n          CtUnknown\n        ], 0, 0))\n      }\n    },\n    TyApp(name, args) => {\n      let ra = for a in args {\n        resolve_type_expr(a, defs)\n      }\n      if name == \"Array\" {\n        if Array::length(ra) == 1 {\n          CtArray(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else if name == \"Option\" {\n        if Array::length(ra) == 1 {\n          CtOption(Array::get(ra, 0))\n        }\n        else CtNamed(name, ra)\n      } else CtNamed(name, ra)\n    },\n    TyTuple(elems) => {\n      let r = for e in elems {\n        resolve_type_expr(e, defs)\n      }\n      CtTuple(r)\n    },\n    TyFn(params, ret, effect_name) => {\n      let rp = for p in params {\n        resolve_type_expr(p, defs)\n      }\n      CtFn(rp, resolve_type_expr(ret, defs), effect_name)\n    }\n  }\n}\n")

  let cli_adapter_source_29 = ("vibe/compiler/checker/checker_pattern.vibe",
"//# Imports\n\nimport .. / core {\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\n}\n\n//# Functions\n\nlet find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {\n  let dlen = Array::length(defs)\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\n    if di >= dlen {\n      None\n    } else {\n      let d = Array::get(defs, di)\n      match d {\n        TDEnum(enum_name, variants) => {\n          let vlen = Array::length(variants)\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\n            if vi >= vlen {\n              go_defs(di + 1)\n            } else {\n              let (vname, vtypes) = Array::get(variants, vi)\n              if vname == ctor_name {\n                Some((enum_name, vtypes))\n              } else {\n                go_variants(vi + 1)\n              }\n            }\n          }\n          go_variants(0)\n        },\n        _ => go_defs(di + 1)\n      }\n    }\n  }\n  go_defs(0)\n}\n\nexport let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {\n  match pat {\n    PWild => env,\n    PBind(name) => env_bind(env, name, scrutinee_ty),\n    PInt(_) => env,\n    PString(_) => env,\n    PBool(_) => env,\n    PCtor(name, sub_pats) => {\n      let builtin_payload = match scrutinee_ty {\n        CtOption(elem) => if name == \"Some\" {\n          Some([\n            elem\n          ])\n        } else if name == \"None\" {\n          Some(Array::slice([\n            CtUnknown\n          ], 0, 0))\n        } else {\n          None\n        },\n        _ => None\n      }\n      let ctor_payload = match builtin_payload {\n        Some(types) => Some((\"Option\", types)),\n        None => find_ctor_in_defs(defs, name)\n      }\n      match ctor_payload {\n        Some(info) => {\n          let (_, payload_types) = info\n          let splen = Array::length(sub_pats)\n          let ptlen = Array::length(payload_types)\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let sub_ty = if i < ptlen {\n                Array::get(payload_types, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)\n              bind_subs(i + 1, next_env)\n            }\n          }\n          bind_subs(0, env)\n        },\n        None => {\n          let splen = Array::length(sub_pats)\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= splen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)\n              bind_unknown(i + 1, next_env)\n            }\n          }\n          bind_unknown(0, env)\n        }\n      }\n    },\n    PTuple(pats) => {\n      let plen = Array::length(pats)\n      match scrutinee_ty {\n        CtTuple(elem_tys) => {\n          let elen = Array::length(elem_tys)\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let et = if i < elen {\n                Array::get(elem_tys, i)\n              } else {\n                CtUnknown\n              }\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)\n              bind_tuple(i + 1, next_env)\n            }\n          }\n          bind_tuple(0, env)\n        },\n        _ => {\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n            if i >= plen {\n              acc_env\n            } else {\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)\n              bind_unk(i + 1, next_env)\n            }\n          }\n          bind_unk(0, env)\n        }\n      }\n    },\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs),\n    PStruct(_, fields) => {\n      let flen = Array::length(fields)\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\n        if i >= flen {\n          acc_env\n        } else {\n          let (_, fpat) = Array::get(fields, i)\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs)\n          bind_fields(i + 1, next_env)\n        }\n      }\n      bind_fields(0, env)\n    }\n  }\n}\n")

  let cli_adapter_source_30 = ("vibe/compiler/checker_trait.vibe",
"//# Imports\n\nimport ./types.vibe {\n  Subst, Type, TypeEnv, impls_overlap_for, trait_defined, type_implements_trait\n}\n\n//# Functions\n\nlet one_super: (String) -> Array[String] = (name) -> {\n  [\n    name\n  ]\n}\n\nlet no_type_args: () -> Array[Type] = () -> {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nexport let satisfies_bound: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, bound) -> {\n  type_implements_trait(env, s, ty, bound)\n}\n\nexport let check_bounds_satisfied: (TypeEnv, Subst, Type, Array[String]) -> Array[String] = (env, s, ty, bounds) -> {\n  let result = empty_strings()\n  let len = Array::length(bounds)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let bound = Array::get(bounds, i)\n      if not(satisfies_bound(env, s, ty, bound)) {\n        Array::push(result, bound)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let register_builtin_traits: (TypeEnv) -> TypeEnv = (env) -> {\n  let no_supers = empty_strings()\n  let eq_supers = one_super(\"Eq\")\n  let i64_type = CtNamed(\"i64\", no_type_args())\n  let u8_type = CtNamed(\"u8\", no_type_args())\n  let u16_type = CtNamed(\"u16\", no_type_args())\n  let u32_type = CtNamed(\"u32\", no_type_args())\n  let u64_type = CtNamed(\"u64\", no_type_args())\n  let i16_type = CtNamed(\"i16\", no_type_args())\n  let e1 = EnvTraitDef(\"Eq\", no_supers, false, env)\n  let e2 = EnvTraitDef(\"Ord\", eq_supers, false, e1)\n  let e3 = EnvTraitDef(\"Add\", no_supers, false, e2)\n  let e4 = EnvTraitDef(\"Sub\", no_supers, false, e3)\n  let e5 = EnvTraitDef(\"Mul\", no_supers, false, e4)\n  let e6 = EnvTraitDef(\"Div\", no_supers, false, e5)\n  let e7 = EnvTraitImpl(\"Eq\", CtInt, e6)\n  let e8 = EnvTraitImpl(\"Eq\", CtDouble, e7)\n  let e9 = EnvTraitImpl(\"Eq\", CtString, e8)\n  let e10 = EnvTraitImpl(\"Eq\", CtBool, e9)\n  let e11 = EnvTraitImpl(\"Ord\", CtInt, e10)\n  let e12 = EnvTraitImpl(\"Ord\", CtDouble, e11)\n  let e13 = EnvTraitImpl(\"Ord\", CtString, e12)\n  let e14 = EnvTraitImpl(\"Add\", CtInt, e13)\n  let e15 = EnvTraitImpl(\"Add\", CtDouble, e14)\n  let e16 = EnvTraitImpl(\"Sub\", CtInt, e15)\n  let e17 = EnvTraitImpl(\"Sub\", CtDouble, e16)\n  let e18 = EnvTraitImpl(\"Mul\", CtInt, e17)\n  let e19 = EnvTraitImpl(\"Mul\", CtDouble, e18)\n  let e20 = EnvTraitImpl(\"Div\", CtInt, e19)\n  let e21 = EnvTraitImpl(\"Div\", CtDouble, e20)\n  let e22 = EnvTraitImpl(\"Eq\", i64_type, e21)\n  let e23 = EnvTraitImpl(\"Eq\", u8_type, e22)\n  let e24 = EnvTraitImpl(\"Eq\", u16_type, e23)\n  let e25 = EnvTraitImpl(\"Eq\", u32_type, e24)\n  let e26 = EnvTraitImpl(\"Eq\", u64_type, e25)\n  let e27 = EnvTraitImpl(\"Eq\", i16_type, e26)\n  let e28 = EnvTraitImpl(\"Ord\", i64_type, e27)\n  let e29 = EnvTraitImpl(\"Ord\", u8_type, e28)\n  let e30 = EnvTraitImpl(\"Ord\", u16_type, e29)\n  let e31 = EnvTraitImpl(\"Ord\", u32_type, e30)\n  let e32 = EnvTraitImpl(\"Ord\", u64_type, e31)\n  let e33 = EnvTraitImpl(\"Ord\", i16_type, e32)\n  let e34 = EnvTraitImpl(\"Add\", i64_type, e33)\n  let e35 = EnvTraitImpl(\"Add\", u8_type, e34)\n  let e36 = EnvTraitImpl(\"Add\", u16_type, e35)\n  let e37 = EnvTraitImpl(\"Add\", u32_type, e36)\n  let e38 = EnvTraitImpl(\"Add\", u64_type, e37)\n  let e39 = EnvTraitImpl(\"Add\", i16_type, e38)\n  let e40 = EnvTraitImpl(\"Sub\", i64_type, e39)\n  let e41 = EnvTraitImpl(\"Sub\", u8_type, e40)\n  let e42 = EnvTraitImpl(\"Sub\", u16_type, e41)\n  let e43 = EnvTraitImpl(\"Sub\", u32_type, e42)\n  let e44 = EnvTraitImpl(\"Sub\", u64_type, e43)\n  let e45 = EnvTraitImpl(\"Sub\", i16_type, e44)\n  let e46 = EnvTraitImpl(\"Mul\", i64_type, e45)\n  let e47 = EnvTraitImpl(\"Mul\", u8_type, e46)\n  let e48 = EnvTraitImpl(\"Mul\", u16_type, e47)\n  let e49 = EnvTraitImpl(\"Mul\", u32_type, e48)\n  let e50 = EnvTraitImpl(\"Mul\", u64_type, e49)\n  let e51 = EnvTraitImpl(\"Mul\", i16_type, e50)\n  let e52 = EnvTraitImpl(\"Div\", i64_type, e51)\n  let e53 = EnvTraitImpl(\"Div\", u8_type, e52)\n  let e54 = EnvTraitImpl(\"Div\", u16_type, e53)\n  let e55 = EnvTraitImpl(\"Div\", u32_type, e54)\n  let e56 = EnvTraitImpl(\"Div\", u64_type, e55)\n  let e57 = EnvTraitImpl(\"Div\", i16_type, e56)\n  e57\n}\n\nexport let validate_supers_defined: (TypeEnv, Array[String]) -> Array[String] = (env, supers) -> {\n  let result = empty_strings()\n  let len = Array::length(supers)\n  let rec go: (Int) -> Int = (i) -> {\n    if i >= len {\n      0\n    } else {\n      let name = Array::get(supers, i)\n      if not(trait_defined(env, name)) {\n        Array::push(result, name)\n      }\n      go(i + 1)\n    }\n  }\n  let _ = go(0)\n  result\n}\n\nexport let validate_impl_no_overlap: (TypeEnv, String, Type) -> Bool = (env, trait_name, target) -> {\n  not(impls_overlap_for(env, trait_name, target))\n}\n")

  let cli_adapter_source_31 = ("vibe/compiler/checker/checker.vibe",
"//# Imports\n\nimport .. / core / ast.vibe {\n  Expr\n}\n\nimport .. / core / types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, type_implements_trait, unify\n}\n\nimport ./builtins.vibe {\n  lookup_builtin\n}\n\nimport ./checker_pattern.vibe {\n  check_pattern\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet min_int: (Int, Int) -> Int = (a, b) -> {\n  if a < b {\n    a\n  } else {\n    b\n  }\n}\n\nlet prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  Array::push(out, first)\n  let mut i = 0\n  while i < Array::length(rest) {\n    Array::push(out, Array::get(rest, i))\n    i = i + 1\n  }\n  out\n}\n\nlet is_logic_binop: (String) -> Bool = (op) -> {\n  op == \"&&\"\n  || op == \"||\"\n}\n\nlet is_order_binop: (String) -> Bool = (op) -> {\n  op == \"<\"\n  || op == \">\"\n  || op == \"<=\"\n  || op == \">=\"\n}\n\nlet type_name_prefix: (Type) -> String = (ty) -> {\n  match ty {\n    CtInt => \"Int\",\n    CtDouble => \"Double\",\n    CtBool => \"Bool\",\n    CtString => \"String\",\n    CtChar => \"Char\",\n    CtUnit => \"Unit\",\n    CtBytes => \"Bytes\",\n    CtArray(_) => \"Array\",\n    CtOption(_) => \"Option\",\n    CtEnum(name) => name,\n    CtStruct(name) => name,\n    CtNamed(name, _) => name,\n    _ => \"\"\n  }\n}\n\nlet is_equality_binop: (String) -> Bool = (op) -> {\n  op == \"==\"\n  || op == \"!=\"\n}\n\nlet unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {\n  match unify(left_ty, target_ty, s) {\n    Some(s1) => unify(right_ty, target_ty, s1),\n    None => None\n  }\n}\n\nlet unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {\n  match unify(left_ty, right_ty, s) {\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\n    None => None\n  }\n}\n\nlet infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {\n  match unify_same_binop_operands(left_ty, right_ty, s) {\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\n      Some((resolved, s1))\n    } else {\n      None\n    },\n    None => None\n  }\n}\n\nlet infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors) -> {\n  if is_logic_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Bool\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_equality_binop(op) {\n    match unify(left_ty, right_ty, s) {\n      Some(s1) => (CtBool, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must have same type\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if is_order_binop(op) {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtBool, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtBool, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, \"Ord\", s) {\n          Some((_, s1)) => (CtBool, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"+\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\n          Some(s1) => (CtString, s1),\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \"Add\", s) {\n            Some((resolved, s1)) => (resolved, s1),\n            None => {\n              Array::push(errors, \"type mismatch in '+': operands must be Int, Double, or String\")\n              (CtUnknown, s)\n            }\n          }\n        }\n      }\n    }\n  }\n  else if op == \"-\"\n  || op == \"*\"\n  || op == \"/\" {\n    let trait_name = if op == \"-\" {\n      \"Sub\"\n    } else if op == \"*\" {\n      \"Mul\"\n    } else {\n      \"Div\"\n    }\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\n        Some(s1) => (CtDouble, s1),\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\n          Some((resolved, s1)) => (resolved, s1),\n          None => {\n            Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int or Double\")))\n            (CtUnknown, s)\n          }\n        }\n      }\n    }\n  }\n  else if op == \"%\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, \"type mismatch in '%': operands must be Int\")\n        (CtUnknown, s)\n      }\n    }\n  }\n  else if op == \"&\" || op == \"|\" || op == \"^\" || op == \"<<\" || op == \">>\" {\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\n      Some(s1) => (CtInt, s1),\n      None => {\n        Array::push(errors, String::concat(\"type mismatch in '\", String::concat(op, \"': operands must be Int\")))\n        (CtUnknown, s)\n      }\n    }\n  }\n  else {\n    Array::push(errors, String::concat(\"unknown operator: \", op))\n    (CtUnknown, s)\n  }\n}\n\nexport let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors) -> {\n  match expr {\n    EInt(_) => (CtInt, s, c),\n    EFloat(_) => (CtDouble, s, c),\n    EString(_) => (CtString, s, c),\n    EBool(_) => (CtBool, s, c),\n    EUnit => (CtUnit, s, c),\n    EIdent(name) => match env_lookup(env, name) {\n      Some(t) => {\n        let (ti, c1, new_bounds) = instantiate(t, c)\n        let nblen = Array::length(new_bounds)\n        let mut s1 = s\n        let mut bi = 0\n        while bi < nblen {\n          let (vid, bounds) = Array::get(new_bounds, bi)\n          if !eq(Array::length(bounds), 0) {\n            s1 = subst_add_bound(s1, vid, bounds)\n          }\n          bi = bi + 1\n        }\n        (ti, s1, c1)\n      },\n      None => match lookup_builtin(name) {\n        Some(t) => (t, s, c),\n        None => {\n          Array::push(errors, String::concat(\"unknown name: \", name))\n          (CtUnknown, s, c)\n        }\n      }\n    },\n    ESeq(left, right) => {\n      let (_, s1, c1) = check_expr(left, env, defs, s, c, errors)\n      check_expr(right, env, defs, s1, c1, errors)\n    },\n    ELet(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      let gen = generalize(s1, vt)\n      check_expr(body, env_bind(env, name, gen), defs, s1, c1, errors)\n    },\n    ELetRec(name, val, body) => {\n      let (tv, c1) = fresh_var(c)\n      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1, errors)\n      let s2 = match unify(tv, vt, s1) {\n        Some(su) => su,\n        None => s1\n      }\n      let gen = generalize(s2, tv)\n      check_expr(body, env_bind(env, name, gen), defs, s2, c2, errors)\n    },\n    ELetMut(name, val, body) => {\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      check_expr(body, env_bind(env, name, vt), defs, s1, c1, errors)\n    },\n    EIf(cond, then_e, else_e) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"if condition must be Bool\")\n      }\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors)\n      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors)\n      (tt, s3, c3)\n    },\n    ECall(callee, args) => match callee {\n      EDot(obj, method) => {\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)\n        let resolved = subst_apply(s1, obj_ty)\n        let type_prefix = type_name_prefix(resolved)\n        let qualified = String::concat(type_prefix, String::concat(\"::\", method))\n        let method_ty = match env_lookup(env, qualified) {\n          Some(t) => {\n            let (ti, c2, _) = instantiate(t, c1)\n            (ti, s1, c2)\n          },\n          None => match lookup_builtin(qualified) {\n            Some(t) => (t, s1, c1),\n            None => (CtUnknown, s1, c1)\n          }\n        }\n        let (mt, s2, c2) = method_ty\n        let all_args = prepend_expr(obj, args)\n        let alen = Array::length(all_args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        Array::push(arg_tys, obj_ty)\n        let mut ai = 1\n        let mut s3 = s2\n        let mut c3 = c2\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors)\n          Array::push(arg_tys, at)\n          s3 = ns\n          c3 = nc\n          ai = ai + 1\n        }\n        match subst_apply(s3, mt) {\n          CtFn(param_tys, ret, _) => {\n            let plen = Array::length(param_tys)\n            let alen2 = Array::length(arg_tys)\n            if alen2 != plen {\n              Array::push(errors, String::concat(\"function arity mismatch: expected \", String::concat(__to_string(plen), String::concat(\" args, got \", __to_string(alen2)))))\n            }\n            let mut s4 = s3\n            let mut ui = 0\n            while ui < plen {\n              s4 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s4) {\n                Some(su) => su,\n                None => s4\n              }\n              ui = ui + 1\n            }\n            (subst_apply(s4, ret), s4, c3)\n          },\n          _ => (CtUnknown, s3, c3)\n        }\n      },\n      _ => {\n        let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors)\n        let alen = Array::length(args)\n        let arg_tys = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut ai = 0\n        let mut s2 = s1\n        let mut c2 = c1\n        while ai < alen {\n          let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\n          Array::push(arg_tys, at)\n          s2 = ns\n          c2 = nc\n          ai = ai + 1\n        }\n        match subst_apply(s2, ct) {\n          CtFn(param_tys, ret, _) => {\n            let plen2 = Array::length(param_tys)\n            let alen3 = Array::length(arg_tys)\n            if alen3 != plen2 {\n              Array::push(errors, String::concat(\"function arity mismatch: expected \", String::concat(__to_string(plen2), String::concat(\" args, got \", __to_string(alen3)))))\n            }\n            let mut s3 = s2\n            let mut ui = 0\n            let ul = min_int(alen3, plen2)\n            while ui < ul {\n              s3 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s3) {\n                Some(su) => su,\n                None => s3\n              }\n              ui = ui + 1\n            }\n            (subst_apply(s3, ret), s3, c2)\n          },\n          CtStruct(sname) => (CtStruct(sname), s2, c2),\n          _ => (CtUnknown, s2, c2)\n        }\n      }\n    },\n    EBinOp(op, left, right) => {\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors)\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors)\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors)\n      (subst_apply(s3, result_ty), s3, c2)\n    },\n    EUnaryOp(op, operand) => {\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors)\n      if op == \"!\" {\n        match subst_apply(s1, operand_ty) {\n          CtBool => (CtBool, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\n            Some(s2) => (CtBool, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else if op == \"-\" {\n        match subst_apply(s1, operand_ty) {\n          CtDouble => (CtDouble, s1, c1),\n          CtInt => (CtInt, s1, c1),\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\n            Some(s2) => (CtInt, s2, c1),\n            None => (CtUnknown, s1, c1)\n          },\n          _ => (CtUnknown, s1, c1)\n        }\n      } else (CtUnknown, s1, c1)\n    },\n    EAssign(_, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      check_expr(body, env, defs, s1, c1, errors)\n    },\n    EAssignOp(_, _, val, body) => {\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)\n      check_expr(body, env, defs, s1, c1, errors)\n    },\n    EMatch(scrutinee, arms) => {\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors)\n      let alen = Array::length(arms)\n      if eq(alen, 0) {\n        (CtUnknown, s1, c1)\n      }\n      else {\n        let mut result_ty = CtUnknown\n        let mut si = s1\n        let mut ci = c1\n        let mut ai = 0\n        while ai < alen {\n          let (pat, body) = Array::get(arms, ai)\n          let arm_env = check_pattern(pat, scr_ty, env, defs)\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors)\n          if eq(ai, 0) {\n            result_ty = arm_ty\n          }\n          si = ns\n          ci = nc\n          ai = ai + 1\n        }\n        (result_ty, si, ci)\n      }\n    },\n    EHandle(body, _) => check_expr(body, env, defs, s, c, errors),\n    EWhile(cond, body) => {\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)\n      let resolved_ct = subst_apply(s1, ct)\n      match resolved_ct {\n        CtBool => (),\n        CtUnknown => (),\n        CtVar(_) => (),\n        _ => Array::push(errors, \"while condition must be Bool\")\n      }\n      let (_, s2, c2) = check_expr(body, env, defs, s1, c1, errors)\n      (CtUnit, s2, c2)\n    },\n    ELoop(params, body) => {\n      let mut env1 = env\n      let mut s1 = s\n      let mut c1 = c\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, init) = Array::get(params, i)\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors)\n        env1 = env_bind(env1, name, pt)\n        s1 = ns\n        c1 = nc\n        i = i + 1\n      }\n      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1, errors)\n      (CtUnit, s2, c2)\n    },\n    EForIn(name, index_name, iterable, body) => {\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c, errors)\n      let et = match it {\n        CtArray(elem) => elem,\n        _ => CtUnknown\n      }\n      let env2 = env_bind(env, name, et)\n      let env3 = match index_name {\n        Some(index_name) => env_bind(env2, index_name, CtInt),\n        None => env2\n      }\n      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1, errors)\n      (CtArray(bt), s2, c2)\n    },\n    EDot(obj, field) => {\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)\n      let resolved = subst_apply(s1, obj_ty)\n      let field_ty = match resolved {\n        CtStruct(sname) => match find_typedef(defs, sname) {\n          Some(td) => match td {\n            TDStruct(_, fields) => {\n              let rec find_field: (Int) -> Type = (i) -> {\n                if i >= Array::length(fields) {\n                  CtUnknown\n                } else {\n                  let (fname, ftype) = Array::get(fields, i)\n                  if fname == field {\n                    ftype\n                  } else find_field(i + 1)\n                }\n              }\n              find_field(0)\n            },\n            _ => CtUnknown\n          },\n          None => CtUnknown\n        },\n        _ => CtUnknown\n      }\n      (field_ty, s1, c1)\n    },\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\n      let tplen = Array::length(tparams)\n      let mut tp_env = env\n      let mut s0 = s\n      let mut c0 = c\n      let mut tpi = 0\n      while tpi < tplen {\n        let tpname = Array::get(tparams, tpi)\n        match fresh_var(c0) {\n          (tv, nc) => {\n            let vid = nc - 1\n            let tblen = Array::length(tbounds)\n            let mut bounds = Array::slice([\n              \"\"\n            ], 0, 0)\n            let mut tbi = 0\n            let mut found_bounds = false\n            while tbi < tblen {\n              let (bname, blist) = Array::get(tbounds, tbi)\n              if !found_bounds && bname == tpname {\n                bounds = blist\n                found_bounds = true\n              }\n              tbi = tbi + 1\n            }\n            s0 = if eq(Array::length(bounds), 0) {\n              s0\n            } else subst_add_bound(s0, vid, bounds)\n            tp_env = env_bind(tp_env, tpname, tv)\n            c0 = nc\n          },\n          _ => ()\n        }\n        tpi = tpi + 1\n      }\n      let plen = Array::length(params)\n      let mut fn_env = tp_env\n      let mut s1 = s0\n      let mut c1 = c0\n      let param_types = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut pi = 0\n      while pi < plen {\n        let (raw_name, ann) = Array::get(params, pi)\n        let nlen = String::length(raw_name)\n        let name = if nlen > 0 {\n          let lc = String::char_code_at(raw_name, nlen - 1)\n          if lc == '~' || lc == '?' {\n            raw_name[0: nlen - 1]\n          } else raw_name\n        } else raw_name\n        let (pt, ns, nc) = match ann {\n          Some(te) => {\n            let resolved = resolve_type_expr(te, defs)\n            let pt2 = match resolved {\n              CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n                Some(t) => t,\n                None => resolved\n              },\n              _ => resolved\n            }\n            (pt2, s1, c1)\n          },\n          None => {\n            let (tv, nc2) = fresh_var(c1)\n            (tv, s1, nc2)\n          }\n        }\n        fn_env = env_bind(fn_env, name, pt)\n        Array::push(param_types, pt)\n        s1 = ns\n        c1 = nc\n        pi = pi + 1\n      }\n      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1, errors)\n      let (final_ret, s3) = match ret_ty {\n        Some(te) => {\n          let resolved = resolve_type_expr(te, defs)\n          let resolved_ret = match resolved {\n            CtNamed(tn, _) => match env_lookup(fn_env, tn) {\n              Some(t) => t,\n              None => resolved\n            },\n            _ => resolved\n          }\n          match unify(bt, resolved_ret, s2) {\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\n            None => {\n              Array::push(errors, String::concat(\"return type mismatch: expected \", String::concat(type_to_string(resolved_ret), String::concat(\", got \", type_to_string(bt)))))\n              (CtUnknown, s2)\n            }\n          }\n        },\n        None => (subst_apply(s2, bt), s2)\n      }\n      let resolved_params = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut rpi = 0\n      while rpi < Array::length(param_types) {\n        Array::push(resolved_params, subst_apply(s3, Array::get(param_types, rpi)))\n        rpi = rpi + 1\n      }\n      (CtFn(resolved_params, final_ret, effect), s3, c2)\n    },\n    EBreak(opt) => match opt {\n      Some(e) => {\n        let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)\n        (CtUnit, s1, c1)\n      },\n      None => (CtUnit, s, c)\n    },\n    EContinue(args) => {\n      let alen = Array::length(args)\n      let mut s1 = s\n      let mut c1 = c\n      let mut ai = 0\n      while ai < alen {\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors)\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtUnit, s1, c1)\n    },\n    ERecord(fields) => {\n      let flen = Array::length(fields)\n      let mut s1 = s\n      let mut c1 = c\n      let mut fi = 0\n      while fi < flen {\n        let (_, fval) = Array::get(fields, fi)\n        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1, errors)\n        s1 = ns\n        c1 = nc\n        fi = fi + 1\n      }\n      (CtUnknown, s1, c1)\n    },\n    ETuple(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let tys = Array::slice([\n        CtUnknown\n      ], 0, 0)\n      let mut ti = 0\n      while ti < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors)\n        Array::push(tys, it)\n        s1 = ns\n        c1 = nc\n        ti = ti + 1\n      }\n      (CtTuple(tys), s1, c1)\n    },\n    EArray(items) => {\n      let ilen = Array::length(items)\n      let mut s1 = s\n      let mut c1 = c\n      let mut elem_ty = CtUnknown\n      let mut ai = 0\n      while ai < ilen {\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors)\n        if eq(ai, 0) {\n          elem_ty = it\n        }\n        s1 = ns\n        c1 = nc\n        ai = ai + 1\n      }\n      (CtArray(elem_ty), s1, c1)\n    },\n    EReturn(e) => {\n      let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)\n      (CtUnknown, s1, c1)\n    },\n    _ => (CtUnknown, s, c)\n  }\n}\n")

  let cli_adapter_source_32 = ("vibe/compiler/checker/checker_stmt.vibe",
"//# Imports\n\nimport .. / checker_trait.vibe {\n  register_builtin_traits\n}\n\nimport .. / core / ast.vibe {\n  Stmt\n}\n\nimport .. / core / types.vibe {\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_cache, env_flat_bindings, env_lookup_flat, generalize, impls_overlap_for, resolve_builtin, subst_apply, trait_defined\n}\n\nimport ./checker.vibe {\n  check_expr\n}\n\nimport ./checker_resolve.vibe {\n  resolve_type_expr\n}\n\n//# Functions\n\nlet rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {\n  if i >= Array::length(cache) {\n    None\n  }\n  else {\n    let (cached_name, cached_ty) = Array::get(cache, i)\n    if cached_name == name {\n      Some(cached_ty)\n    }\n    else import_cache_lookup(cache, name, i + 1)\n  }\n}\n\nlet bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {\n  let env_bindings = env_flat_bindings(env)\n  let import_cache = Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n  let nlen = Array::length(names)\n  let rec bind_imports: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= nlen {\n      acc\n    }\n    else {\n      let (name, alias) = Array::get(names, i)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match import_cache_lookup(import_cache, name, 0) {\n        Some(t) => t,\n        None => {\n          let resolved = match env_lookup_flat(env_bindings, name) {\n            Some(t) => t,\n            None => CtUnknown\n          }\n          Array::push(import_cache, (name, resolved))\n          resolved\n        }\n      }\n      bind_imports(i + 1, env_bind(acc, bound_name, ty))\n    }\n  }\n  bind_imports(0, env)\n}\n\nexport let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String]) -> (TypeEnv, Subst, Int) = (stmts, i, env, defs, s, c, errors) -> {\n  if i >= Array::length(stmts) {\n    (env, s, c)\n  } else {\n    let stmt = Array::get(stmts, i)\n    let (new_env, s1, c1) = match stmt {\n      SLet(_, is_rec, name, ann, val) => {\n        let (vt, ns, nc) = if is_rec {\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors)\n        } else {\n          check_expr(val, env, defs, s, c, errors)\n        }\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => generalize(ns, vt)\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SLetMut(name, ann, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)\n        let t = match ann {\n          Some(te) => resolve_type_expr(te, defs),\n          None => vt\n        }\n        (env_bind(env, name, t), ns, nc)\n      },\n      SLetPat(pat, val) => {\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)\n        let new_env = match pat {\n          PTuple(pats) => match vt {\n            CtTuple(types) => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => if pi < Array::length(types) {\n                    e = env_bind(e, name, Array::get(types, pi))\n                  } else {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            },\n            _ => {\n              let mut e = env\n              let mut pi = 0\n              while pi < Array::length(pats) {\n                match Array::get(pats, pi) {\n                  PBind(name) => {\n                    e = env_bind(e, name, CtUnknown)\n                  },\n                  _ => ()\n                }\n                pi = pi + 1\n              }\n              e\n            }\n          },\n          PBind(name) => env_bind(env, name, vt),\n          PStruct(_, fields) => {\n            let mut e = env\n            let mut fi = 0\n            while fi < Array::length(fields) {\n              let (_, fpat) = Array::get(fields, fi)\n              match fpat {\n                PBind(name) => {\n                  e = env_bind(e, name, CtUnknown)\n                },\n                _ => ()\n              }\n              fi = fi + 1\n            }\n            e\n          },\n          _ => env\n        }\n        (new_env, ns, nc)\n      },\n      SEnum(_, name, variants) => {\n        let resolved_variants = Array::slice([\n          (\"\", Array::slice([\n            CtUnknown\n          ], 0, 0))\n        ], 0, 0)\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, vi)\n          let resolved_vtypes = Array::slice([\n            CtUnknown\n          ], 0, 0)\n          let mut ti = 0\n          while ti < Array::length(vtypes) {\n            let vt = resolve_type_expr(Array::get(vtypes, ti), defs)\n            Array::push(resolved_vtypes, vt)\n            ti = ti + 1\n          }\n          Array::push(resolved_variants, (vname, resolved_vtypes))\n          vi = vi + 1\n        }\n        Array::push(defs, TDEnum(name, resolved_variants))\n        let mut env1 = env_bind(env, name, CtEnum(name))\n        let mut ci2 = 0\n        while ci2 < Array::length(variants) {\n          let (vname, vtypes) = Array::get(variants, ci2)\n          if eq(Array::length(vtypes), 0) {\n            env1 = env_bind(env1, vname, CtEnum(name))\n          } else {\n            let resolved_args = Array::slice([\n              CtUnknown\n            ], 0, 0)\n            let mut ai = 0\n            while ai < Array::length(vtypes) {\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\n              ai = ai + 1\n            }\n            env1 = env_bind(env1, vname, CtFn(resolved_args, CtEnum(name), None))\n          }\n          ci2 = ci2 + 1\n        }\n        (env1, s, c)\n      },\n      SStruct(_, name, field_defs) => {\n        let resolved_fields = Array::slice([\n          (\"\", CtUnit)\n        ], 0, 0)\n        let mut fi = 0\n        while fi < Array::length(field_defs) {\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\n          let ftype = resolve_type_expr(ftype_expr, defs)\n          Array::push(resolved_fields, (fname, ftype))\n          fi = fi + 1\n        }\n        Array::push(defs, TDStruct(name, resolved_fields))\n        let field_types = Array::slice([\n          CtUnknown\n        ], 0, 0)\n        let mut fj = 0\n        while fj < Array::length(resolved_fields) {\n          let (_, fty) = Array::get(resolved_fields, fj)\n          Array::push(field_types, fty)\n          fj = fj + 1\n        }\n        (env_bind(env, name, CtFn(field_types, CtStruct(name), None)), s, c)\n      },\n      STypeAlias(_, name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      SExternLet(name, te) => {\n        let t = resolve_type_expr(te, defs)\n        (env_bind(env, name, t), s, c)\n      },\n      STest(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)\n        (env, ns, nc)\n      },\n      SBench(_, body) => {\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)\n        (env, ns, nc)\n      },\n      SExpr(expr) => {\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors)\n        (env, ns, nc)\n      },\n      SModule(_, _, body) => {\n        let _ = check_stmts(body, 0, env, defs, s, c, errors)\n        (env, s, c)\n      },\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\n      ,\n      SAliasDecl(_, _) => (env, s, c)\n      ,\n      STrait(_, name, supers) => {\n        let is_open = false\n        (EnvTraitDef(name, supers, is_open, env), s, c)\n      },\n      SImpl(_, _, trait_name, type_name) => {\n        let target = match resolve_builtin(type_name) {\n          Some(t) => t,\n          None => CtNamed(type_name, Array::slice([\n            CtUnknown\n          ], 0, 0))\n        }\n        (EnvTraitImpl(trait_name, target, env), s, c)\n      },\n      _ => (env, s, c)\n    }\n    check_stmts(stmts, i + 1, new_env, defs, s1, c1, errors)\n  }\n}\n\nexport let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {\n  let empty_defs = Array::slice([\n    TDAlias(\"_dummy\", CtUnit)\n  ], 0, 0)\n  let seeded_env = if trait_defined(EnvEmpty, \"Eq\") {\n    EnvEmpty\n  } else {\n    register_builtin_traits(EnvEmpty)\n  }\n  let errors = ArrayBuilder::new()\n  let frozen_errors = ArrayBuilder::freeze(errors)\n  let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)\n  if Array::length(frozen_errors) > 0 {\n    throw(Array::get(frozen_errors, 0))\n  }\n  env\n}\n\nexport let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {\n  match initial_env {\n    EnvEmpty => check_program(stmts),\n    _ => {\n      let empty_defs = Array::slice([\n        TDAlias(\"_dummy\", CtUnit)\n      ], 0, 0)\n      let cached_env = env_cache(initial_env)\n      let seeded_env = if trait_defined(cached_env, \"Eq\") {\n        cached_env\n      } else {\n        register_builtin_traits(cached_env)\n      }\n      let errors = ArrayBuilder::new()\n      let frozen_errors = ArrayBuilder::freeze(errors)\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)\n      if Array::length(frozen_errors) > 0 {\n        throw(Array::get(frozen_errors, 0))\n      }\n      env\n    }\n  }\n}\n")

  let cli_adapter_source_33 = ("vibe/compiler/builtin_name.vibe",
"//# Functions\n\nexport let canonical_builtin_name: (String) -> String = (name) -> {\n  match name {\n    \"Fs::ReadFile\" => \"Fs::read_file\",\n    \"Fs::WriteFile\" => \"Fs::write_file\",\n    \"Fs::ReadBytes\" => \"Fs::read_bytes\",\n    \"Fs::WriteBytes\" => \"Fs::write_bytes\",\n    \"Fs::Exists\" => \"Fs::exists\",\n    \"Fs::StatToken\" => \"Fs::stat_token\",\n    \"Fs::ReadDir\" => \"Fs::readdir\",\n    \"Fs::IsDir\" => \"Fs::is_dir\",\n    \"Fs::IsFile\" => \"Fs::is_file\",\n    \"Fs::Mkdir\" => \"Fs::mkdir\",\n    \"Fs::Getcwd\" => \"Fs::getcwd\",\n    \"Fs::Chdir\" => \"Fs::chdir\",\n    \"Fs::Remove\" => \"Fs::remove\",\n    \"Fs::Copy\" => \"Fs::copy\",\n    \"Fs::Append\" => \"Fs::append\",\n    \"Env::Get\" => \"Env::get\",\n    \"Env::ArgsLen\" => \"Env::args_len\",\n    \"Env::ArgsGet\" => \"Env::args_get\",\n    _ => name\n  }\n}\n")

