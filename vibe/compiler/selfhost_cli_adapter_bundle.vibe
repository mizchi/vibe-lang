tion, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail3.vibe {\n  compile_expr_tail3\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_expr_tail2: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 15 {\n    let __tuple_elems = get_etuple_elems(expr)\n    let num_elems = Array::length(__tuple_elems)\n    let ptr_local = next_local\n    Array::push(local_names, \"__tuple_ptr\")\n    let mut nl = next_local + 1\n    if ctx.enable_rc {\n      // RC layout (docs/spec/selfhost-rc-port.md):\n      //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\n      // The tuple value is block_start+8 (points at type_id), so the live header\n      // is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0][length@ptr+4] and the\n      // payload stays at ptr+8 (field access is unchanged). ptr_local holds\n      // block_start. type_id 3 = tuple.\n      let total = 16 + num_elems * 8\n      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc) —\n      // exact-fit reuse anywhere in the list, else bump. Replaces the inline\n      // head-only check, which fragmented when interleaved sizes were freed.\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header words at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: uniform drop-class byte in the rc_count word's high\n      // byte (block+7 = value-1). rc stays in the low 24 bits, so dec (full-word\n      // -1) and the `*256 == 0` zero-test ignore this byte. 1 = field-vector\n      // ([?@value+0][count@value+4][fields@value+8+i*8]) — the generic recursive\n      // rc_drop loops `count` fields. (docs/spec/selfhost-uniform-value-repr.md)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store8(buf, 0, 7)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 3)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, num_elems)\n      emit_i32_store(buf, 2, 12)\n      let mut tri = 0\n      while tri < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, tri), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, 16 + tri * 8)\n        tri = tri + 1\n      }\n      // tuple value = (block_start + 8) | 1 (ADR-0055 Stage 2: all heap pointers\n      // are odd so a generic recursive rc_drop can classify fields by `& 1`).\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let alloc_size = num_elems * 8\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, alloc_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      let mut ti = 0\n      while ti < num_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(__tuple_elems, ti), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, ti * 8)\n        ti = ti + 1\n      }\n      emit_local_get(buf, ptr_local)\n      nl\n    }\n  } else if __tag == 16 {\n    compile_match(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  } else if __tag == 17 {\n    let elems = get_earray_elems(expr)\n    let n_elems = Array::length(elems)\n    if ctx.enable_rc {\n      // RC array literal: inline-allocate the array object with the tuple-style\n      // RC layout so it drops like a tuple (value = block+8, untagged). Object\n      // layout at the value pointer matches the array runtime\n      // (`[capacity@0][length@4][data_ptr@8][inline_data@12...]`); data_ptr points\n      // at the inline buffer (value+12). capacity defaults to 8 (as array_new)\n      // but is sized up for larger literals so all elements fit inline.\n      // The header behind is [alloc_size@-8][rc_count@-4]; the array runtime\n      // (Array::get / length / push) reads value+0/+4/+8, unchanged.\n      // (docs/spec/selfhost-rc-port.md)\n      let cap = if n_elems > 8 {\n        n_elems\n      } else {\n        8\n      }\n      let total = 20 + cap * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__arr_ptr\")\n      let mut nl = next_local + 1\n      // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).\n      emit_i64_const(buf, total)\n      emit_call(buf, ctx.rc_alloc_func_idx)\n      emit_local_set(buf, ptr_local)\n      // header at block_start\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, total)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 1)\n      emit_i32_store(buf, 2, 4)\n      // ADR-0055 Stage 2c/3: drop-class byte (block+7). 5 = array — value+0 is\n      // capacity (not a count) and elements live behind data_ptr@value+8, so the\n      // recursive rc_drop must use the array path, not the field-vector loop.\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 5)\n      emit_i32_store8(buf, 0, 7)\n      // array object at block_start+8 = value: capacity, length, data_ptr\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, cap)\n      emit_i32_store(buf, 2, 8)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, n_elems)\n      emit_i32_store(buf, 2, 12)\n      // data_ptr = value + 12 = block_start + 20 (inline buffer)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 20)\n      emit_i32_add(buf)\n      emit_i32_store(buf, 2, 16)\n      // store elements at block_start + 20 + i*8\n      let mut ai = 0\n      while ai < n_elems {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        nl = compile_expr(buf, Array::get(elems, ai), local_names, nl, ctx, ld)\n        emit_i64_store(buf, 3, 20 + ai * 8)\n        ai = ai + 1\n      }\n      // array value = (block_start + 8) | 1 (ADR-0055 Stage 2b: odd heap pointer)\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 8)\n      emit_i64_add(buf)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl\n    } else {\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let arr_local = next_local\n      emit_call(buf, arr_new_idx)\n      emit_local_set(buf, arr_local)\n      Array::push(local_names, \"__arr_lit\")\n      let mut nl = next_local + 1\n      let mut ei = 0\n      while ei < Array::length(elems) {\n        emit_local_get(buf, arr_local)\n        nl = compile_expr(buf, Array::get(elems, ei), local_names, nl, ctx, ld)\n        emit_call(buf, arr_push_idx)\n        ei = ei + 1\n      }\n      emit_local_get(buf, arr_local)\n      nl\n    }\n  } else if __tag == 18 {\n    let var_name = get_eforin_name(expr)\n    let iter_expr = get_eforin_iter(expr)\n    let body = get_eforin_body(expr)\n    let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n    let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n    let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n    let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n    let result_local = next_local\n    let arr_local = next_local + 1\n    let i_local = next_local + 2\n    Array::push(local_names, \"__forin_res\")\n    Array::push(local_names, \"__forin_arr\")\n    Array::push(local_names, \"__forin_i\")\n    emit_call(buf, arr_new_fi)\n    emit_local_set(buf, result_local)\n    let nl1 = compile_expr(buf, iter_expr, local_names, next_local + 3, ctx, ld)\n    emit_local_set(buf, arr_local)\n    emit_i64_const(buf, 0)\n    emit_local_set(buf, i_local)\n    emit_block_void(buf)\n    emit_loop_void(buf)\n    emit_local_get(buf, i_local)\n    emit_local_get(buf, arr_local)\n    emit_call(buf, arr_len_fi)\n    emit_i64_ge_s(buf)\n    emit_br_if(buf, 1)\n    let var_local = nl1\n    emit_local_get(buf, arr_local)\n    emit_local_get(buf, i_local)\n    emit_call(buf, arr_get_fi)\n    emit_local_set(buf, var_local)\n    Array::push(local_names, var_name)\n    let nl2 = nl1 + 1\n    let nl3 = compile_expr(buf, body, local_names, nl2, ctx, ld + 1)\n    let body_val = nl3\n    Array::push(local_names, \"__forin_val\")\n    emit_local_set(buf, body_val)\n    emit_local_get(buf, result_local)\n    emit_local_get(buf, body_val)\n    emit_call(buf, arr_push_fi)\n    emit_local_get(buf, i_local)\n    emit_i64_const(buf, 1)\n    emit_i64_add(buf)\n    emit_local_set(buf, i_local)\n    emit_br(buf, 0)\n    emit_end(buf)\n    emit_end(buf)\n    emit_local_get(buf, result_local)\n    nl3 + 1\n  } else {\n    compile_expr_tail3(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")

  let cli_adapter_source_60 = ("vibe/compiler/codegen/expr/compile_expr_tail.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_ctor_call, is_earray, is_efn, is_eident, is_erecord, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_call.vibe {\n  compile_call\n}\n\nimport ./compile_expr_tail2.vibe {\n  compile_expr_tail2\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\n// Push the untagged value pointer (as i32) held in `local_idx`. Records are\n// tagged (`ptr | 1`) so their low bit is cleared first; tuples are raw.\nlet emit_rc_value_ptr_i32: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_local_get(buf, local_idx)\n  if tagged {\n    emit_i64_const(buf, -2)\n    emit_i64_and(buf)\n  } else {\n    ()\n  }\n  emit_i32_wrap_i64(buf)\n}\n\n// Emit a non-recursive rc_drop of a heap value held in `local_idx`: decrement\n// rc_count (at value-4) and, at zero, push the block onto the free-list head\n// (global 2), reusing the rc slot as the next pointer. The free-list head holds\n// the (untagged) value pointer, matching the allocator in compile_expr_tail2 /\n// compile_expr_tail4. (docs/spec/selfhost-rc-port.md)\nlet emit_rc_drop_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_sub(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  // ADR-0055 Stage 2c: the rc_count word's high byte holds a drop-class id, so\n  // test the low 24 bits (rc) for zero by `* 256` (shifts the class byte out of\n  // the 32-bit word) before `eqz`.\n  emit_i32_const(buf, 256)\n  emit_i32_mul(buf)\n  emit_i32_eqz(buf)\n  emit_if_void(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_global_get(buf, 2)\n  emit_i32_store(buf, 2, 0)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_global_set(buf, 2)\n  emit_end(buf)\n}\n\n// Emit rc_dup: increment the reference count (at value-4) of a heap object held\n// in `local_idx`. Used for an alias `let a = t` whose source `t` is multiply\n// used, so the alias takes its own owned reference. (docs/spec/selfhost-rc-port.md)\nlet emit_rc_dup_local: (Bytes, Int, Bool) -> Unit = (buf, local_idx, tagged) -> {\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_rc_value_ptr_i32(buf, local_idx, tagged)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n}\n\n// ADR-0055 Stage 4: a runtime-guarded rc_dup of the value held in `local_idx`.\n// Unlike emit_rc_dup_local it first tests the low bit, so it is a no-op on an\n// even (scalar) value — the projected field whose heap-ness is unknown at\n// codegen time (Blocker 3). Used to give an escaping projection its own owned\n// reference before the source container is recursively dropped.\nlet emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  // odd: also require high 32 bits == 0 (a real heap block address, not a\n  // string/bytes fat pointer whose data offset sits in the high 32 bits).\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n  emit_end(buf)\n}\n\n// Whether `e` is a field/index projection (EDot). A let bound to one aliases a\n// field of another container (ADR-0055 Stage 4).\nlet is_edot: (Expr) -> Bool = (e) -> {\n  match e {\n    EDot(_, _) => true,\n    _ => false\n  }\n}\n\n// The root identifier of a projection chain (EDot(...EDot(EIdent(root))...)), or\n// \"\" if `e` is not a projection.\nlet rec proj_root_ident: (Expr) -> String = (e) -> {\n  match e {\n    EDot(obj, _) => proj_root_ident(obj),\n    EIdent(nm) => nm,\n    _ => \"\"\n  }\n}\n\n// If the *tail* (result) expression of a scope is a projection chain, return its\n// root identifier; otherwise \"\". Follows let/seq/assign wrappers to the tail.\n// (ADR-0055 Stage 4: an escaping projection rooted at a dropped binding aliases\n// a field the recursive rc_drop would free — it must be dup'd.)\nlet rec scope_tail_proj_root: (Expr) -> String = (e) -> {\n  match e {\n    ELet(_, _, b) => scope_tail_proj_root(b),\n    ELetMut(_, _, b) => scope_tail_proj_root(b),\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\n    ESeq(_, b) => scope_tail_proj_root(b),\n    EAssign(_, _, b) => scope_tail_proj_root(b),\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\n    EDot(obj, _) => proj_root_ident(obj),\n    _ => \"\"\n  }\n}\n\n// ADR-0055 Stage 4: does the assignment RHS reference `name`? If so, dropping\n// the old value of `name` before evaluating the RHS would be a use-after-free\n// (`b = b.0`, `b = f(b)`), so the reassignment drop is suppressed for these.\nlet assign_value_mentions: (Expr, String) -> Bool = (value, name) -> {\n  let empty1 = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty2 = Array::slice([\n    \"\"\n  ], 0, 0)\n  array_contains_str(collect_free_vars(value, empty1, empty2), name)\n}\n\nexport let compile_expr_tail: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 9 {\n    let name = get_elet_name(expr)\n    let value = get_elet_val(expr)\n    let body = get_elet_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    // RC: classify the bound value's heap-ness. rc_kind 0 = not (known) heap,\n    // 1 = heap tuple (raw pointer), 2 = heap tagged (record/enum, or an alias of\n    // any heap kind — the `& -2` untag is a no-op on 8-aligned tuple pointers so\n    // it is safe for aliases of any kind). A binding is registered in\n    // heap_binding_names so a later alias `let a = <this>` can be dup'd/dropped,\n    // and so that drops never touch a non-heap binding the static Perceus\n    // `scalar` flag over-approximates as heap. (docs/spec/selfhost-rc-port.md)\n    let mut rc_kind = 0\n    if ctx.enable_rc {\n      if is_etuple(value) {\n        // ADR-0055 Stage 2: tuples are now odd pointers, so the drop must untag\n        // (& -2) — same as records/enums (rc_kind 2 / tagged=true).\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_earray(value) {\n        // ADR-0055 Stage 2b: arrays are now odd pointers; drop must untag.\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_erecord(value) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_ctor_call(value, ctx.ctor_table) {\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n      } else if is_eident(value) {\n        let src = get_eident_name(value)\n        if array_contains_str(ctx.heap_binding_names, src) {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n          // Alias of a multiply-used source: take a duplicated reference.\n          if array_contains_str(ctx.rc_alias_dup_names, name) {\n            emit_rc_dup_local(buf, local_idx, true)\n          } else {\n            ()\n          }\n        } else {\n          ()\n        }\n      } else if expr_tag(value) == 8 {\n        // ADR-0055 Stage 4: a call result is an OWNED heap value — the callee\n        // returns its reference (a fresh allocation, an arg whose ownership was\n        // transferred in under the owning-argument convention, or an escaping\n        // projection the callee already dup'd). Classify it as droppable so the\n        // scope-end drop the analysis already planned (every binding gets\n        // remaining >= 1) actually fires, closing the `let p = f(...)` leak. The\n        // runtime-guarded __rc_drop is a no-op on a scalar result, so an\n        // Int-returning call costs nothing. EXCEPTION: a builtin that returns a\n        // BORROW of a still-live container (Array::get / __index) yields an\n        // element the container still owns — dropping it would double-free.\n        let callee = get_ecall_callee(value)\n        let is_borrow_ret = if is_eident(callee) {\n          let cn = get_eident_name(callee)\n          cn == \"Array::get\" || cn == \"__index\"\n        } else {\n          false\n        }\n        if is_borrow_ret {\n          ()\n        } else {\n          rc_kind = 2\n          Array::push(ctx.heap_binding_names, name)\n        }\n      } else if is_edot(value) {\n        // ADR-0055 Stage 4: a projection bound to a let (`let a = t.0`) aliases a\n        // field of another container. The Perceus analysis treats it as a\n        // binding that owns one reference (remaining >= 1) and drops it at scope\n        // end — but `t.0` does not actually take a reference. Give it one with a\n        // guarded dup (a no-op on a scalar/string field): now if `a` escapes it\n        // survives the container's recursive drop, and if it does not, its\n        // analysis-planned drop balances the dup.\n        rc_kind = 2\n        Array::push(ctx.heap_binding_names, name)\n        emit_rc_dup_guarded(buf, local_idx)\n      } else {\n        ()\n      }\n    } else {\n      ()\n    }\n    // ADR-0055 Stage 4: emit the non-alias `PaDup` budget for this binding — one\n    // guarded rc_dup per plan PaDup(name). A heap value used in N owning\n    // positions (e.g. `let u = (t, t)` uses `t` twice) needs N-1 extra refs so\n    // each owning consumer's (recursive) drop is balanced; the analysis records\n    // exactly N-1 PaDup(name). Placement is occurrence-agnostic (all uses share\n    // the same block), so emitting them here at the binding is equivalent and\n    // can only raise the refcount — at worst a leak, never a premature free.\n    if ctx.enable_rc && rc_kind > 0 {\n      let mut dbi = 0\n      while dbi < Array::length(ctx.rc_dup_names) {\n        if Array::get(ctx.rc_dup_names, dbi) == name {\n          emit_rc_dup_guarded(buf, local_idx)\n        } else {\n          ()\n        }\n        dbi = dbi + 1\n      }\n    } else {\n      ()\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    // RC: drop a heap binding the Perceus plan marks for scope-end drop. rc_count\n    // at value-4 is decremented and, at zero, the block is pushed onto the\n    // free-list head (global 2). The body result is already on the stack and\n    // untouched. (docs/spec/selfhost-rc-port.md)\n    if ctx.enable_rc && rc_kind > 0 && array_contains_str(ctx.rc_drop_names, name) {\n      // ADR-0055 Stage 4: if the scope result is a projection rooted at THIS\n      // dropped binding (e.g. `let t = (...); t.0`), the result aliases a field\n      // the recursive drop would free — use-after-free. Save the result, dup it\n      // (runtime-guarded, so a scalar field is a no-op), drop, then restore.\n      if ctx.rc_drop_func_idx >= 0 && scope_tail_proj_root(body) == name {\n        emit_local_set(buf, nl2)\n        emit_rc_dup_guarded(buf, nl2)\n        emit_local_get(buf, local_idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n        emit_local_get(buf, nl2)\n        nl2 + 1\n      } else {\n        if ctx.rc_drop_func_idx >= 0 {\n          // ADR-0055 Stage 3: route the scope-end drop through the recursive\n          // helper so nested heap fields are reclaimed to arbitrary depth. The\n          // helper untags and classifies the value itself.\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n        } else if rc_kind == 1 {\n          emit_rc_drop_local(buf, local_idx, false)\n        } else {\n          emit_rc_drop_local(buf, local_idx, true)\n        }\n        nl2\n      }\n    } else {\n      nl2\n    }\n  } else if __tag == 10 {\n    let name = get_eletrec_name(expr)\n    let value = get_eletrec_val(expr)\n    let body = get_eletrec_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n    emit_local_set(buf, local_idx)\n    if is_efn(value) {\n      let params = get_efn_params(value)\n      let fn_body = get_efn_body(value)\n      let param_names_bp = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bpi = 0\n      while bpi < Array::length(params) {\n        let (pn, _) = Array::get(params, bpi)\n        Array::push(param_names_bp, pn)\n        bpi = bpi + 1\n      }\n      let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\n      let mut self_cap_idx = -1\n      let mut bci = 0\n      while bci < Array::length(caps) {\n        if Array::get(caps, bci) == name {\n          self_cap_idx = bci\n        }\n        bci = bci + 1\n      }\n      if self_cap_idx >= 0 {\n        emit_local_get(buf, local_idx)\n        emit_i64_const(buf, -4)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, local_idx)\n        emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\n      }\n      0\n    } else {\n      0\n    }\n    let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n    nl2\n  } else if __tag == 11 {\n    let name = get_eletmut_name(expr)\n    let value = get_eletmut_val(expr)\n    let body = get_eletmut_body(expr)\n    let local_idx = next_local\n    Array::push(local_names, name)\n    if is_mut_captured_in(body, name) {\n      Array::push(ctx.ref_cell_names, name)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_tee(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 8)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, local_idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      nl2\n    } else {\n      // ADR-0055 Stage 4: classify the mut binding's heap-ness from its\n      // initializer (a binding has one type, so this is stable across\n      // reassignments). Registering it in heap_binding_names lets `EAssign` drop\n      // the OLD value before overwriting (otherwise each `b = <heap>` leaks the\n      // previous block — a per-iteration leak in a loop).\n      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table)) {\n        Array::push(ctx.heap_binding_names, name)\n      } else {\n        ()\n      }\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\n      emit_local_set(buf, local_idx)\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\n      // ADR-0055 Stage 4: drop the mut binding's FINAL value at scope end (the\n      // per-iteration reassignment drop only reclaims overwritten values; the\n      // last one still owns a reference). Same projection-rooted-at-name tail\n      // guard as `let`: if the scope result aliases a field of this binding, dup\n      // it before the recursive drop frees the container.\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\n        if scope_tail_proj_root(body) == name {\n          emit_local_set(buf, nl2)\n          emit_rc_dup_guarded(buf, nl2)\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          emit_local_get(buf, nl2)\n          nl2 + 1\n        } else {\n          emit_local_get(buf, local_idx)\n          emit_call(buf, ctx.rc_drop_func_idx)\n          nl2\n        }\n      } else {\n        nl2\n      }\n    }\n  } else if __tag == 12 {\n    let name = get_eassign_name(expr)\n    let value = get_eassign_val(expr)\n    let body = get_eassign_body(expr)\n    let idx = resolve_local(local_names, name, \"assign\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      // ADR-0055 Stage 4: drop the OLD value before overwriting a heap mut\n      // binding (Perceus assignment rule). Without this, `b = <heap>` in a loop\n      // leaks the previous block every iteration. The drop is guarded by\n      // __rc_drop (a no-op on a scalar/string), and a dec (not an unconditional\n      // free), so an aliased old value (rc > 1 via PaAliasDup) is safe.\n      // SAFETY: skip the drop when the RHS references `name` (e.g. `b = b.0` or\n      // `b = f(b)`) — dropping first would free a block the new value derives\n      // from (use-after-free). Those keep the old, safe leak.\n      if ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name) && !assign_value_mentions(value, name) {\n        emit_local_get(buf, idx)\n        emit_call(buf, ctx.rc_drop_func_idx)\n      } else {\n        ()\n      }\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 13 {\n    let name = get_eassignop_name(expr)\n    let op = get_eassignop_op(expr)\n    let value = get_eassignop_val(expr)\n    let body = get_eassignop_body(expr)\n    let idx = resolve_local(local_names, name, \"assignop\")\n    if array_contains_str(ctx.ref_cell_names, name) {\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, idx)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, 0)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_i64_store(buf, 3, 0)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    } else {\n      emit_local_get(buf, idx)\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\n      emit_assignop_op(buf, op)\n      emit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n")

