"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / .. / perceus {\n  PerceusAction, build_perceus_plan, build_perceus_plan_with_params, elaborate_heap_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\n}\n\nimport .. / builtin_bodies {\n  gen_arr_concat_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_push_all_body, gen_arr_push_body, gen_arr_set_body, gen_arr_slice_body, gen_arr_truncate_body, gen_bytes_append_body, gen_bytes_concat_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_len_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_rc_alloc_body, gen_rc_drop_body, gen_selfhost_sources_proper_body, gen_selfhost_sources_stub_body, gen_simd_scan_alnum_body, gen_simd_skip_ws_body, gen_str_char_code_at_body, gen_str_concat_body, gen_str_from_char_code_body, gen_str_len_body, gen_str_substring_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body, static_arr_get_body, static_arr_len_body, static_arr_set_body, static_arr_truncate_body, static_double_to_int_body, static_fs_stub_body, static_fs_write_bytes_stub_body, static_identity_body, static_int_to_double_body, static_print_i64_body, static_print_str_body, static_str_char_code_at_body, static_str_eq_body, static_str_len_body\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, fn_type_param_types, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, get_slet_type, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / expr {\n  compile_expr\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, emit_vibe_abi_custom_section, string_to_data\n}\n\nimport ./linked_helpers.vibe {\n  stmts_use_builtin\n}\n\n//# Functions\n\nlet wasm_page_size = 65536\n\nlet lc_fresh_int_array: () -> Array[Int] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_bool_array: () -> Array[Bool] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_bytes_array: () -> Array[Bytes] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_fresh_string_array: () -> Array[String] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet lc_emit_rc_dup_guarded: (Bytes, Int) -> Unit = (buf, local_idx) -> {\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 1)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, 32)\n  emit_i64_shr_s(buf)\n  emit_i64_eqz(buf)\n  emit_if_void(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_local_get(buf, local_idx)\n  emit_i64_const(buf, -2)\n  emit_i64_and(buf)\n  emit_i32_wrap_i64(buf)\n  emit_i32_const(buf, 4)\n  emit_i32_sub(buf)\n  emit_i32_load(buf, 2, 0)\n  emit_i32_const(buf, 1)\n  emit_i32_add(buf)\n  emit_i32_store(buf, 2, 0)\n  emit_end(buf)\n  emit_end(buf)\n}\n\nlet lc_fresh_string_matrix: () -> Array[Array[String]] = () -> {\n  ArrayBuilder::freeze(ArrayBuilder::new())\n}\n\nlet gen_heap_grow_check_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_heap_memory_grow_check(b)\n  b\n}\n\nlet default_wasi_memory_min_pages = 64\n\nexport let wasi_memory_min_pages_for_heap: (Int) -> Int = (heap_start) -> {\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\n  if needed_pages > default_wasi_memory_min_pages {\n    needed_pages\n  } else {\n    default_wasi_memory_min_pages\n  }\n}\n\nexport let compile_wasi_module_linked_impl: (Array[Stmt], String, Array[(String, String)], Array[(String, String, Int, Int)], Bool, Bool) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, linked_imports, library_mode, enable_rc) -> {\n  let fn_names_list = lc_fresh_string_array()\n  let fn_param_counts = lc_fresh_int_array()\n  let fn_needs_env_list = lc_fresh_bool_array()\n  let fn_stmt_indices = lc_fresh_int_array()\n  let thunk_names_list = lc_fresh_string_array()\n  let const_int_names_list = lc_fresh_string_array()\n  let const_int_values_list = lc_fresh_int_array()\n  let export_fn_names = lc_fresh_string_array()\n  let export_fn_user_indices = lc_fresh_int_array()\n  let test_fn_names = lc_fresh_string_array()\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let empty_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(stmts) {\n    match Array::get(stmts, pi) {\n      STest(tname, tbody) => {\n        let test_fn = String::concat(\"__test_\", tname)\n        Array::push(test_fn_names, test_fn)\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\n      },\n      SBench(bname, bbody) => {\n        let bench_fn = String::concat(\"__bench_\", bname)\n        Array::push(test_fn_names, bench_fn)\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\n      },\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    pi = pi + 1\n  }\n  if Array::length(test_fn_names) > 0 {\n    let mut has_entry = false\n    let mut ei = 0\n    while ei < Array::length(stmts) {\n      match Array::get(stmts, ei) {\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\n          has_entry = true\n        },\n        _ => ()\n      }\n      ei = ei + 1\n    }\n    if !has_entry {\n      ()\n    }\n  }\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if is_slet(stmt) {\n      let name = get_slet_name(stmt)\n      let expr = get_slet_expr(stmt)\n      let is_export = get_slet_export(stmt)\n      let user_idx = Array::length(fn_names_list)\n      if is_efn(expr) {\n        let params = get_efn_params(expr)\n        Array::push(fn_names_list, name)\n        Array::push(fn_param_counts, Array::length(params))\n        Array::push(fn_needs_env_list, true)\n        Array::push(fn_stmt_indices, i)\n      } else {\n        if (expr_tag(expr) == 0) && !is_export {\n          Array::push(const_int_names_list, name)\n          Array::push(const_int_values_list, get_eint_value(expr))\n        } else {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, 0)\n          Array::push(fn_needs_env_list, true)\n          Array::push(fn_stmt_indices, i)\n          Array::push(thunk_names_list, name)\n        }\n      }\n      if is_export || library_mode {\n        Array::push(export_fn_names, name)\n        Array::push(export_fn_user_indices, user_idx)\n      }\n    }\n    i = i + 1\n  }\n  let ctor_names_list = lc_fresh_string_array()\n  Array::push(ctor_names_list, \"None\")\n  Array::push(ctor_names_list, \"Some\")\n  let ctor_tags_list = lc_fresh_int_array()\n  Array::push(ctor_tags_list, 0)\n  Array::push(ctor_tags_list, 1)\n  let ctor_field_counts_list = lc_fresh_int_array()\n  Array::push(ctor_field_counts_list, 0)\n  Array::push(ctor_field_counts_list, 1)\n  let ctor_type_names_list = lc_fresh_string_array()\n  Array::push(ctor_type_names_list, \"Option\")\n  Array::push(ctor_type_names_list, \"Option\")\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  let struct_names = lc_fresh_string_array()\n  let struct_field_names = lc_fresh_string_matrix()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields) => {\n        Array::push(struct_names, sname)\n        let fnames = lc_fresh_string_array()\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\n    match e {\n      EMap(fields) => {\n        let mut mi = 0\n        while mi < Array::length(fields) {\n          let (key, val) = Array::get(fields, mi)\n          if !array_contains_str(str_strs, key) {\n            Array::push(str_strs, key)\n          }\n          add_map_keys_expr(val)\n          mi = mi + 1\n        }\n      },\n      EStringInterp(parts) => {\n        let mut pi3 = 0\n        while pi3 < Array::length(parts) {\n          if pi3 % 2 == 0 {\n            let part = Array::get(parts, pi3)\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\n              Array::push(str_strs, part)\n            }\n          }\n          pi3 = pi3 + 1\n        }\n      },\n      ELet(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetMut(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ELetRec(_, val, body) => {\n        add_map_keys_expr(val); add_map_keys_expr(body)\n      },\n      ESeq(a, b) => {\n        add_map_keys_expr(a); add_map_keys_expr(b)\n      },\n      EIf(c, t, e) => {\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\n      },\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\n      EHandle(body, _) => add_map_keys_expr(body),\n      ECall(callee, args) => {\n        add_map_keys_expr(callee)\n        let mut ai = 0\n        while ai < Array::length(args) {\n          add_map_keys_expr(Array::get(args, ai))\n          ai = ai + 1\n        }\n      },\n      _ => ()\n    }\n  }\n  let mut __mk = 0\n  while __mk < Array::length(stmts) {\n    match Array::get(stmts, __mk) {\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\n      STest(_, expr) => add_map_keys_expr(expr),\n      SBench(_, expr) => add_map_keys_expr(expr),\n      _ => ()\n    }\n    __mk = __mk + 1\n  }\n  // Always seed the empty string so codegen that materialises \"\" (e.g.\n  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)\n  // can rely on str_table_lookup(\"\") succeeding even when the source never\n  // mentions \"\" literally.\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  let src_str_base = Array::length(str_strs)\n  let num_src_pairs = Array::length(selfhost_srcs)\n  let mut __src_i = 0\n  while __src_i < num_src_pairs {\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\n    Array::push(str_strs, __src_path)\n    Array::push(str_strs, __src_content)\n    __src_i = __src_i + 1\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = lc_fresh_int_array()\n  let str_lengths = lc_fresh_int_array()\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let effect_names_list = lc_fresh_string_array()\n  let effect_op_keys_list = lc_fresh_string_array()\n  let effect_op_arities_list = Array::slice([\n    0\n  ], 0, 0)\n  let mut eff_collect_i = 0\n  while eff_collect_i < Array::length(stmts) {\n    match Array::get(stmts, eff_collect_i) {\n      SEffectDef(_, eff_name, _, ops) => {\n        if eff_name != \"Error\" && !array_contains_str(effect_names_list, eff_name) {\n          Array::push(effect_names_list, eff_name)\n        } else {\n          ()\n        }\n        let mut op_i = 0\n        while op_i < Array::length(ops) {\n          let (op_name, op_params, _) = Array::get(ops, op_i)\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \"::\"), op_name))\n          Array::push(effect_op_arities_list, Array::length(op_params))\n          op_i = op_i + 1\n        }\n      },\n      _ => ()\n    }\n    eff_collect_i = eff_collect_i + 1\n  }\n  // Per-effect region stride (#553). Each effect tag gets a reserved region\n  // below the heap frontier holding the replay-handler control words (+0\n  // perform counter, +8 resume-memo count) and the resume-memo array (+16 +\n  // k*8). The replay model stores one i64 per `perform` resolved within a\n  // `handle`, so the region is O(performs). At 8192 B (1022 entries) a loop\n  // performing more than ~1022-2046 times overflowed the region into the live\n  // heap, where the growing memo chased and clobbered the reused payload-tuple\n  // free block (~8 B/iter past the threshold, ADR-0055). 131072 B (16382\n  // entries) covers the full verify regime (N2=11000) with headroom; programs\n  // performing more than ~16K times within one handle still spill (a hard\n  // bound of the replay-based handler — unbounded performs need a\n  // continuation-based handler). MUST stay in sync with the `* 131072` strides\n  // in compile_call.vibe (perform) and compile_expr_tail6.vibe (handler arm).\n  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072\n  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::get\")\n  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\")\n  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\")\n  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\")\n  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\")\n  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\")\n  let need_fs_write_file_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_file\")\n  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\")\n  let need_profiler_now_us_builtin = stmts_use_builtin(stmts, fn_names_list, \"Profiler::now_us\")\n  let mut next_import_idx = 1\n  let env_get_import_idx = if need_env_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_len_import_idx = if need_env_args_len_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let env_args_get_import_idx = if need_env_args_get_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_exists_import_idx = if need_fs_exists_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_file_import_idx = if need_fs_write_file_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {\n    let idx = next_import_idx\n    next_import_idx = next_import_idx + 1\n    idx\n  } else {\n    -1\n  }\n  let linked_import_indices = lc_fresh_int_array()\n  let linked_import_names = lc_fresh_string_array()\n  let mut li_i = 0\n  while li_i < Array::length(linked_imports) {\n    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)\n    Array::push(linked_import_indices, next_import_idx)\n    Array::push(linked_import_names, lfn_name)\n    next_import_idx = next_import_idx + 1\n    li_i = li_i + 1\n  }\n  let num_imported_funcs = next_import_idx\n  let print_int_idx = num_imported_funcs\n  let print_str_idx = print_int_idx + 1\n  let str_len_idx = print_str_idx + 1\n  let str_eq_idx = str_len_idx + 1\n  let str_concat_idx = str_eq_idx + 1\n  let arr_new_idx = str_concat_idx + 1\n  let arr_len_idx = arr_new_idx + 1\n  let arr_get_idx = arr_len_idx + 1\n  let arr_push_idx = arr_get_idx + 1\n  let arr_set_idx = arr_push_idx + 1\n  let double_to_int_idx = arr_set_idx + 1\n  let int_to_double_idx = double_to_int_idx + 1\n  let str_char_code_at_idx = int_to_double_idx + 1\n  let str_from_char_code_idx = str_char_code_at_idx + 1\n  let str_substring_idx = str_from_char_code_idx + 1\n  let identity_idx = str_substring_idx + 1\n  let arr_slice_idx = identity_idx + 1\n  let arr_concat_idx = arr_slice_idx + 1\n  let arr_truncate_idx = arr_concat_idx + 1\n  let string_join_idx = arr_truncate_idx + 1\n  let fs_read_file_stub_idx = string_join_idx + 1\n  let fs_exists_stub_idx = fs_read_file_stub_idx + 1\n  let fs_stat_token_stub_idx = fs_exists_stub_idx + 1\n  let fs_write_file_stub_idx = fs_stat_token_stub_idx + 1\n  let fs_write_bytes_stub_idx = fs_write_file_stub_idx + 1\n  let eq_idx = fs_write_bytes_stub_idx + 1\n  let string_ends_with_idx = eq_idx + 1\n  let string_last_index_of_idx = string_ends_with_idx + 1\n  let arr_push_all_idx = string_last_index_of_idx + 1\n  let string_index_of_idx = arr_push_all_idx + 1\n  let string_contains_idx = string_index_of_idx + 1\n  let string_starts_with_idx = string_contains_idx + 1\n  let string_split_idx = string_starts_with_idx + 1\n  let string_trim_idx = string_split_idx + 1\n  let selfhost_sources_idx = string_trim_idx + 1\n  let bytes_new_idx = selfhost_sources_idx + 1\n  let bytes_len_idx = bytes_new_idx + 1\n  let bytes_get_idx = bytes_len_idx + 1\n  let bytes_set_idx = bytes_get_idx + 1\n  let bytes_push_idx = bytes_set_idx + 1\n  let bytes_append_idx = bytes_push_idx + 1\n  let bytes_concat_idx = bytes_append_idx + 1\n  let bytes_slice_idx = bytes_concat_idx + 1\n  let bytes_from_array_idx = bytes_slice_idx + 1\n  let bytes_to_array_idx = bytes_from_array_idx + 1\n  let rc_drop_idx = bytes_to_array_idx + 1\n  let rc_alloc_idx = rc_drop_idx + 1\n  let heap_grow_check_idx = if enable_rc {\n    rc_alloc_idx + 1\n  } else {\n    bytes_to_array_idx + 1\n  }\n  let simd_skip_ws_idx = heap_grow_check_idx + 1\n  let simd_scan_alnum_idx = simd_skip_ws_idx + 1\n  let simd_scan_alnum_str_idx = simd_scan_alnum_idx + 1\n  let env_get_idx = if env_get_import_idx >= 0 {\n    env_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let env_args_len_idx = if env_args_len_import_idx >= 0 {\n    env_args_len_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let env_args_get_idx = if env_args_get_import_idx >= 0 {\n    env_args_get_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_read_file_idx = if fs_read_file_import_idx >= 0 {\n    fs_read_file_import_idx\n  } else {\n    fs_read_file_stub_idx\n  }\n  let fs_exists_idx = if fs_exists_import_idx >= 0 {\n    fs_exists_import_idx\n  } else {\n    fs_exists_stub_idx\n  }\n  let fs_stat_token_idx = if fs_stat_token_import_idx >= 0 {\n    fs_stat_token_import_idx\n  } else {\n 