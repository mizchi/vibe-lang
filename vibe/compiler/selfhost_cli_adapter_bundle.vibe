)\n}\n\n// Break variant (debugger / DAP P1): `vibe::dbg_break` host-hook instrumentation\n// at each user function entry. Used by the FS-compile break entry under\n// VIBE_DEBUG_BREAK=1.\nexport let compile_wasi_module_break: (Array[Stmt], String, DbgProv) -> Bytes with { Error } = (stmts, entry_name, prov) -> {\n  compile_wasi_module_break_impl(stmts, entry_name, prov)\n}\n\n// (A second, identical `compile_wasi_module_rc` definition used to live here —\n// the flat bundle's first-match tolerated it; the #726 merge flatten surfaced\n// it as the last remaining duplicate top-level def.)\n")
}

