"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let gc_gen_identity_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  b\n}\n\n// Push `memory.size * 65536` (linear memory size in BYTES) as an i64.\nlet gc_emit_mem_size_bytes: (Bytes) -> Unit = (b) -> {\n  bytebuf_push(b, 63)\n  bytebuf_push(b, 0)\n  emit_i64_extend_i32_u(b)\n  emit_i64_const(b, 65536)\n  emit_i64_mul(b)\n}\n\n// #538 P4.5: runtime-dispatching `__to_string`, ported from the linear lane's\n// inline call-site handler (compile_call.vibe, #606/#664 heuristics). String\n// interpolation desugars EVERY `\\{x}` to `__to_string(x)`; the gc lane used to\n// resolve that to the compiled program's own decimal-only `__to_string(Int)`,\n// so interpolating a String rendered its packed (ptr<<32)|len pointer as a\n// NUMBER — the parser's `\"\\{acc}, \\{name}\"` effect-row join produced rows like\n// \"127642133069826, 127659312939013\" when the gc-compiled compiler ran, and\n// every multi-label `with { A, B }` declaration stopped authorizing anything.\n// Layout facts: params (val:i64); locals 1=neg 2=cur 3=abs 4=hp 5=len (i64);\n// scratch digits build at bytes 46..1 (gc data_base is 64, so 0..63 is free).\nexport let gc_gen_to_string_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_block_i64(b)\n  // Looks-like-string test: ptr = val >> 32 (unsigned) >= 64, ptr < memsize,\n  // ptr + len <= memsize  ->  identity (it IS a string).\n  emit_local_get(b, 0)\n  emit_i64_const(b, 32)\n  bytebuf_push(b, 136)\n  emit_local_tee(b, 3)\n  emit_i64_const(b, 64)\n  emit_i64_ge_s(b)\n  emit_local_get(b, 3)\n  gc_emit_mem_size_bytes(b)\n  emit_i64_lt_s(b)\n  bytebuf_push(b, 113)\n  emit_local_get(b, 3)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  emit_i64_and(b)\n  emit_i64_add(b)\n  gc_emit_mem_size_bytes(b)\n  emit_i64_le_s(b)\n  bytebuf_push(b, 113)\n  emit_if_void(b)\n  emit_local_get(b, 0)\n  emit_br(b, 1)\n  emit_end(b)\n  // Integer path: render decimal digits right-to-left into scratch bytes\n  // 46..1, then copy to a fresh heap string.\n  emit_i64_const(b, 46)\n  emit_local_set(b, 2)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_i64_extend_i32_s(b)\n  emit_local_set(b, 1)\n  emit_local_get(b, 0)\n  emit_i64_const(b, 0)\n  emit_i64_lt_s(b)\n  emit_if_i64(b)\n  emit_i64_const(b, 0)\n  emit_local_get(b, 0)\n  emit_i64_sub(b)\n  emit_else(b)\n  emit_local_get(b, 0)\n  emit_end(b)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_i64_eqz(b)\n  emit_if_void(b)\n  emit_local_get(b, 2)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 48)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 2)\n  emit_end(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 3)\n  emit_i64_eqz(b)\n  emit_br_if(b, 1)\n  emit_local_get(b, 2)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 3)\n  emit_i64_const(b, 10)\n  emit_i64_rem_s(b)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 48)\n  emit_i32_add(b)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 3)\n  emit_i64_const(b, 10)\n  emit_i64_div_s(b)\n  emit_local_set(b, 3)\n  emit_br(b, 0)\n  emit_end(b)\n  emit_end(b)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_if_void(b)\n  emit_local_get(b, 2)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 45)\n  emit_i32_store8(b, 0, 0)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_sub(b)\n  emit_local_set(b, 2)\n  emit_end(b)\n  emit_global_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  emit_local_set(b, 4)\n  emit_i64_const(b, 46)\n  emit_local_get(b, 2)\n  emit_i64_sub(b)\n  emit_local_set(b, 5)\n  // Bump + grow check BEFORE the memory.copy into the fresh allocation —\n  // same ordering fix as the linear inline `__to_string` handler\n  // (compile_call.vibe): copying first traps when the previous allocation\n  // left global 0 within `len` bytes of the memory end.\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 7)\n  emit_i32_add(b)\n  emit_i32_const(b, -8)\n  bytebuf_push(b, 113)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_heap_memory_grow_check(b)\n  emit_local_get(b, 4)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 2)\n  emit_i64_const(b, 1)\n  emit_i64_add(b)\n  emit_i32_wrap_i64(b)\n  emit_local_get(b, 5)\n  emit_i32_wrap_i64(b)\n  emit_memory_copy(b)\n  emit_local_get(b, 4)\n  emit_i64_const(b, 32)\n  emit_i64_shl(b)\n  emit_local_get(b, 5)\n  emit_i64_or(b)\n  emit_end(b)\n  b\n}\n\nexport let gc_gen_double_to_int_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_reinterpret_i64(b)\n  emit_i64_trunc_f64_s(b)\n  b\n}\n\nexport let gc_gen_int_to_double_body: () -> Bytes = () -> {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_f64_convert_i64_s(b)\n  emit_i64_reinterpret_f64(b)\n  b\n}\n")
}

let cli_adapter_source_105 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_body.vibe",
"//# Imports\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / .. / syntax / import_alias_rewrite.vibe {\n  rewrite_top_level_fn_alias_refs\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, stmts_contain_exceptions\n}\n\nimport .. / common_base {\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, agg_info_of_type_expr, compute_agg_returning, fn_type_param_types, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport .. / builtin_registry.vibe {\n  verify_lane_builtins\n}\n\nimport .. / builtin_bodies {\n  gen_str_eq_body, gen_str_lex_diff_body, gen_bytes_append_body, gen_bytes_blit_body, gen_bytes_concat_body, gen_bytes_fill_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body\n}\n\nimport ./backend_builtins_array_alloc.vibe {\n  gc_gen_arr_concat_body, gc_gen_arr_len_body, gc_gen_arr_new_body, gc_gen_arr_push_all_body, gc_gen_arr_slice_body, gc_gen_arr_truncate_body\n}\n\nimport ./backend_builtins_array_get.vibe {\n  gc_gen_arr_get_body\n}\n\nimport ./backend_builtins_array_push.vibe {\n  gc_gen_arr_push_body\n}\n\nimport ./backend_builtins_array_set.vibe {\n  gc_gen_arr_set_body\n}\n\nimport ./backend_builtins_numeric.vibe {\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body, gc_gen_to_string_body\n}\n\nimport ./backend_builtins_print.vibe {\n  gc_gen_print_i64_body, gc_gen_print_str_body\n}\n\nimport ./backend_builtins_string.vibe {\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\n}\n\nimport ./backend_builtins_string_extra.vibe {\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\n}\n\nimport ./backend_expr.vibe {\n  compile_expr_gc\n}\n\nimport .. / wasi / linked_helpers.vibe {\n  stmts_use_builtin\n}\n\n\n//# Functions\n\nexport let compile_wasi_module_gc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\n  // Top-level `let f = g` function aliases: retarget references to the final\n  // EFn def so calls do not route through a 0-param thunk registration\n  // (invalid wasm for any call arity). See import_alias_rewrite.vibe.\n  rewrite_top_level_fn_alias_refs(stmts)\n  let fn_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_param_counts = Array::slice([\n    0\n  ], 0, 0)\n  let fn_needs_env_list = Array::slice([\n    true\n  ], 0, 0)\n  let user_func_stmts = Array::slice([\n    SExpr(EUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, _) => {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_needs_env_list, true)\n          Array::push(user_func_stmts, stmt)\n          0\n        },\n        _ => 0\n      }\n      ,\n      _ => 0\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\n        Array::push(ctor_field_counts_list, Array::length(sfields))\n        Array::push(ctor_type_names_list, sname)\n        0\n      },\n      _ => 0\n    }\n    ei2 = ei2 + 1\n  }\n  // #538: module-level literal constants (Int / Bool / String). The user-func\n  // walk keeps only EFn lets; scalar lets like `let op_call = 16` previously\n  // vanished and every reference threw \"undefined variable\".\n  let gc_const_names_l = Array::slice([\n    \"\"\n  ], 0, 0)\n  let gc_const_kinds_l = Array::slice([\n    0\n  ], 0, 0)\n  let gc_const_ivals_l = Array::slice([\n    0\n  ], 0, 0)\n  let gc_const_svals_l = Array::slice([\n    \"\"\n  ], 0, 0)\n  let gc_global_names_l = Array::slice([\n    \"\"\n  ], 0, 0)\n  let gc_global_exprs_l = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut gci = 0\n  while gci < Array::length(stmts) {\n    match Array::get(stmts, gci) {\n      SLet(_, _, cname, _, cval) => match cval {\n        EInt(iv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, iv)\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EBool(bv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 0)\n          Array::push(gc_const_ivals_l, if bv {\n            1\n          } else {\n            0\n          })\n          Array::push(gc_const_svals_l, \"\")\n        },\n        EString(sv) => {\n          Array::push(gc_const_names_l, cname)\n          Array::push(gc_const_kinds_l, 1)\n          Array::push(gc_const_ivals_l, 0)\n          Array::push(gc_const_svals_l, sv)\n        },\n        EFn(_, _, _, _, _, _) => (),\n        _ => {\n          // Computed module-level value: a mutable i64 global initialized at\n          // the top of _start (B12 port).\n          Array::push(gc_global_names_l, cname)\n          Array::push(gc_global_exprs_l, cval)\n        }\n      },\n      _ => ()\n    }\n    gci = gci + 1\n  }\n  let struct_names = Array::slice([\n    \"\"\n  ], 0, 0)\n  let struct_field_names = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, sname, sfields, _, _) => {\n        Array::push(struct_names, sname)\n        let fnames = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut sfi = 0\n        while sfi < Array::length(sfields) {\n          let (fname, _) = Array::get(sfields, sfi)\n          Array::push(fnames, fname)\n          sfi = sfi + 1\n        }\n        Array::push(struct_field_names, fnames)\n        ()\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n  let num_user_funcs = Array::length(fn_names_list)\n  if num_user_funcs == 0 {\n    throw(\"no functions found to compile\")\n  }\n  let mut entry_user_idx = -1\n  let mut ei = 0\n  while ei < num_user_funcs {\n    if Array::get(fn_names_list, ei) == entry_name {\n      entry_user_idx = ei\n    }\n    ei = ei + 1\n  }\n  if entry_user_idx < 0 {\n    throw(String::concat(\"entry function not found: \", entry_name))\n  }\n  let str_strs = collect_strings_stmts(stmts)\n  // #538: StringBuilder::freeze joins with \"\" and println appends \"\\n\"; both\n  // must exist in the string table even when the program has no such literal.\n  if !array_contains_str(str_strs, \"\") {\n    Array::push(str_strs, \"\")\n  }\n  if !array_contains_str(str_strs, \"\\n\") {\n    Array::push(str_strs, \"\\n\")\n  }\n  let num_strings = Array::length(str_strs)\n  let data_base = 64\n  let str_offsets = Array::slice([\n    0\n  ], 0, 0)\n  let str_lengths = Array::slice([\n    0\n  ], 0, 0)\n  let mut str_pos = data_base\n  let mut si = 0\n  while si < num_strings {\n    let s = Array::get(str_strs, si)\n    let slen = String::length(s)\n    Array::push(str_offsets, str_pos)\n    Array::push(str_lengths, slen)\n    str_pos = str_pos + slen\n    si = si + 1\n  }\n  let heap_start = ((str_pos + 7) / 8) * 8\n  let num_generated = 42\n  // #538: host imports (module \"vibe\", tagged-i64 ABI -- the same raw ABI the\n  // linear backend and the node host runner speak). Gated as a GROUP: pure\n  // modules stay import-free (runnable on bare wasmtime); a module touching\n  // any Env::/Fs:: builtin imports all nine at indices 1..9, shifting every\n  // generated-body index by 9 (hbo).\n  let use_host = stmts_use_builtin(stmts, fn_names_list, \"Env::get\") || stmts_use_builtin(stmts, fn_names_list, \"Env::args_len\") || stmts_use_builtin(stmts, fn_names_list, \"Env::args_get\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::read_file\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::exists\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::stat_token\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::write_file\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::write_bytes\") || stmts_use_builtin(stmts, fn_names_list, \"Fs::read_bytes\") || stmts_use_builtin(stmts, fn_names_list, \"Profiler::now_us\")\n  let hbo = if use_host {\n    10\n  } else {\n    0\n  }\n  let func_offset = 1 + hbo + num_generated\n  let builtin_defs = [\n    (\"print_int\", 1, 1, 0),\n    (\"print_str\", 1, 2, 0),\n    (\"String::length\", 1, 3, 1),\n    (\"String::equals\", 2, 4, 1),\n    (\"String::concat\", 2, 5, 1),\n    (\"array_new\", 0, 6, 1),\n    (\"Array::length\", 1, 7, 1),\n    (\"Array::get\", 2, 8, 1),\n    (\"Array::push\", 2, 9, 0),\n    (\"Array::set\", 3, 10, 0),\n    (\"Double::to_int\", 1, 11, 1),\n    (\"Int::to_double\", 1, 12, 1),\n    (\"String::char_code_at\", 2, 13, 1),\n    (\"String::from_char_code\", 1, 14, 