let cli_adapter_source_9 = () -> (String, String) {
  ("vibe/compiler/syntax/float_format.vibe",
"//# Imports\n\nimport .. / core {\n  __to_string\n}\n\n//# Functions\n\nlet zero_pad_6: (Int) -> String = (n) -> {\n  let s = __to_string(n)\n  let len = String::length(s)\n  if len >= 6 {\n    s\n  } else {\n    let mut out = \"\"\n    let mut i = len\n    while i < 6 {\n      out = String::concat(out, \"0\")\n      i = i + 1\n    }\n    String::concat(out, s)\n  }\n}\n\nlet trim_trailing_zeros: (String) -> String = (s) -> {\n  let mut end = String::length(s)\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\n    end = end - 1\n  }\n  if end <= 0 {\n    \"\"\n  } else {\n    s[0: end]\n  }\n}\n\nexport let double_to_string_compiler: (Double) -> String = (d) -> {\n  if d != d {\n    \"nan\"\n  } else {\n    let neg = d < 0.0\n    let abs_d = if neg {\n      0.0 - d\n    } else {\n      d\n    }\n    let int_part = Double::to_int(abs_d)\n    let frac = abs_d - Int::to_double(int_part)\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\n    let int_norm = if scaled_raw == 1000000 {\n      int_part + 1\n    } else {\n      int_part\n    }\n    let frac_norm = if scaled_raw == 1000000 {\n      0\n    } else {\n      scaled_raw\n    }\n    let int_s = __to_string(int_norm)\n    let frac_s = if frac_norm == 0 {\n      \"\"\n    } else {\n      trim_trailing_zeros(zero_pad_6(frac_norm))\n    }\n    let body = if String::length(frac_s) == 0 {\n      int_s\n    } else {\n      String::concat(int_s, String::concat(\".\", frac_s))\n    }\n    if neg {\n      String::concat(\"-\", body)\n    } else {\n      body\n    }\n  }\n}\n")
}

let cli_adapter_source_10 = () -> (String, String) {
  ("vibe/compiler/syntax/lexer.vibe",
"//# Imports\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet is_ws: (Int) -> Bool = (c) -> {\n  c == ' ' || c == '\\n' || c == '\\t' || c == '\\r'\n}\n\nlet is_alpha: (Int) -> Bool = (c) -> {\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\n}\n\nlet is_digit: (Int) -> Bool = (c) -> {\n  c >= '0' && c <= '9'\n}\n\nlet is_alnum: (Int) -> Bool = (c) -> {\n  is_alpha(c) || is_digit(c)\n}\n\nlet lex_char: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  let start = i + 1\n  if start >= len {\n    throw(\"unterminated char literal\")\n  }\n  let c = String::char_code_at(s, start)\n  if c == '\\\\' {\n    let esc_pos = start + 1\n    if esc_pos >= len {\n      throw(\"unterminated char escape\")\n    }\n    let esc = String::char_code_at(s, esc_pos)\n    let val = if esc == 'n' {\n      10\n    }\n    else if esc == 't' {\n      9\n    }\n    else if esc == 'r' {\n      13\n    }\n    else if esc == '\\\\' {\n      92\n    }\n    else if esc == '\\'' {\n      39\n    }\n    else if esc == '0' {\n      0\n    }\n    else throw(\"invalid char escape\")\n    let close = esc_pos + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(val), close + 1)\n  } else {\n    let close = start + 1\n    if close >= len || String::char_code_at(s, close) != '\\'' {\n      throw(\"expected closing quote for char literal\")\n    };\n    (TInt(c), close + 1)\n  }\n}\n\nlet slice_eq: (String, Int, Int, String) -> Bool = (source, start, end, text) -> {\n  let len = end - start\n  let text_len = String::length(text)\n  if len != text_len {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet is_hex_digit: (Int) -> Bool = (c) -> {\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\n}\n\nlet keyword_lookup: (String, Int, Int) -> Option[Token] = (source, start, end) -> {\n  let len = end - start\n  if len == 2 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"fn\") {\n        Some(TIdent(\"fn\"))\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"if\") {\n        Some(TIf)\n      } else if slice_eq(source, start, end, \"in\") {\n        Some(TIn)\n      } else if slice_eq(source, start, end, \"is\") {\n        // ADR-0023: `expr is pattern` is a Bool-returning pattern test.\n        Some(TIs)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"do\") {\n        Some(TDo)\n      } else None\n    } else if c0 == 'a' {\n      if slice_eq(source, start, end, \"as\") {\n        Some(TAs)\n      } else None\n    } else None\n  } else if len == 3 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'l' {\n      if slice_eq(source, start, end, \"let\") {\n        Some(TLet)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"rec\") {\n        Some(TRec)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"mut\") {\n        Some(TMut)\n      } else None\n    } else if c0 == 'f' {\n      if slice_eq(source, start, end, \"for\") {\n        Some(TFor)\n      } else None\n    } else None\n  } else if len == 4 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'e' {\n      if slice_eq(source, start, end, \"else\") {\n        Some(TElse)\n      } else if slice_eq(source, start, end, \"enum\") {\n        Some(TEnum)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"true\") {\n        Some(TIdent(\"true\"))\n      } else if slice_eq(source, start, end, \"type\") {\n        Some(TType)\n      } else if slice_eq(source, start, end, \"test\") {\n        Some(TTest)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"with\") {\n        Some(TWith)\n      } else None\n    } else if c0 == 'l' {\n      if slice_eq(source, start, end, \"loop\") {\n        Some(TLoop)\n      } else None\n    } else if c0 == 'o' {\n      if slice_eq(source, start, end, \"open\") {\n        Some(TOpen)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"impl\") {\n        Some(TImpl)\n      } else None\n    } else None\n  } else if len == 5 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'f' {\n      if slice_eq(source, start, end, \"false\") {\n        Some(TIdent(\"false\"))\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"match\") {\n        Some(TMatch)\n      } else None\n    } else if c0 == 't' {\n      if slice_eq(source, start, end, \"trait\") {\n        Some(TTrait)\n      } else if slice_eq(source, start, end, \"throw\") {\n        Some(TThrow)\n      } else None\n    } else if c0 == 'w' {\n      if slice_eq(source, start, end, \"while\") {\n        Some(TWhile)\n      } else None\n    } else if c0 == 'b' {\n      if slice_eq(source, start, end, \"break\") {\n        Some(TBreak)\n      } else if slice_eq(source, start, end, \"bench\") {\n        Some(TBench)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"raise\") {\n        Some(TRaise)\n      } else None\n    } else if c0 == 'y' {\n      if slice_eq(source, start, end, \"yield\") {\n        Some(TYield)\n      } else None\n    } else None\n  } else if len == 6 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 's' {\n      if slice_eq(source, start, end, \"struct\") {\n        Some(TStruct)\n      } else None\n    } else if c0 == 'e' {\n      if slice_eq(source, start, end, \"export\") {\n        Some(TExport)\n      } else None\n    } else if c0 == 'r' {\n      if slice_eq(source, start, end, \"return\") {\n        Some(TReturn)\n      } else None\n    } else if c0 == 'h' {\n      if slice_eq(source, start, end, \"handle\") {\n        Some(THandle)\n      } else None\n    } else if c0 == 'm' {\n      if slice_eq(source, start, end, \"module\") {\n        Some(TModule)\n      } else None\n    } else if c0 == 'd' {\n      if slice_eq(source, start, end, \"derive\") {\n        Some(TDerive)\n      } else None\n    } else if c0 == 'i' {\n      if slice_eq(source, start, end, \"import\") {\n        Some(TImport)\n      } else None\n    } else None\n  } else if len == 7 {\n    if slice_eq(source, start, end, \"declare\") {\n      Some(TDeclare)\n    } else None\n  } else if len == 8 {\n    let c0 = String::char_code_at(source, start)\n    if c0 == 'c' {\n      if slice_eq(source, start, end, \"continue\") {\n        Some(TContinue)\n      } else None\n    } else if c0 == 's' {\n      if slice_eq(source, start, end, \"suberror\") {\n        Some(TSuberror)\n      } else None\n    } else None\n  } else None\n}\n\nlet scan_ident_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_alnum(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet lex_ident: (String, Int, Int) -> (Token, Int) = (s, len, i) -> {\n  let end = scan_ident_end(s, len, i)\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\n    let ri_start = end + 1\n    let ri_end = scan_ident_end(s, len, ri_start)\n    (TIdent(s[ri_start: ri_end]), ri_end)\n  }\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\"' {\n    let mut ri = end + 1\n    while ri < len && String::char_code_at(s, ri) != '\"' {\n      ri = ri + 1\n    }\n    (TString(s[end + 1: ri]), if ri >= len {\n      ri\n    } else {\n      ri + 1\n    })\n  } else {\n    match keyword_lookup(s, i, end) {\n      Some(tok) => (tok, end),\n      None => (TIdent(s[i: end]), end)\n    }\n  }\n}\n\nlet scan_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet scan_interp_end: (String, Int, Int, Int) -> Int with { Error } = (s, len, idx, depth) -> {\n  let mut out = idx\n  let mut current_depth = depth\n  let mut found = -1\n  while out < len && found < 0 {\n    let c = String::char_code_at(s, out)\n    if c == '{' {\n      current_depth = current_depth + 1\n    } else if c == '}' {\n      if current_depth == 1 {\n        found = out\n      } else {\n        current_depth = current_depth - 1\n      }\n    }\n    if found < 0 {\n      out = out + 1\n    }\n  }\n  if found >= 0 {\n    found\n  } else {\n    throw(\"unterminated string interpolation\")\n  }\n}\n\nlet parse_frac_digits: (String, Int, Int, Double, Double) -> (Double, Int) = (s, len, i, acc, scale) -> {\n  let mut out_i = i\n  let mut out_acc = acc\n  let mut out_scale = scale\n  let mut done = false\n  while out_i < len && !done {\n    let c = String::char_code_at(s, out_i)\n    if is_digit(c) {\n      out_acc = out_acc + Int::to_double(c - 48) / out_scale\n      out_scale = out_scale * 10.0\n      out_i = out_i + 1\n    } else {\n      done = true\n    }\n  }\n  (out_acc, out_i)\n}\n\nlet empty_string_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet skip_until_newline: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  let mut done = false\n  while out < len && !done {\n    if String::char_code_at(s, out) == '\\n' {\n      out = out + 1\n      done = true\n    } else {\n      out = out + 1\n    }\n  }\n  out\n}\n\nlet skip_ws_with_newline: (String, Int, Int) -> (Int, Bool) = (s, len, i) -> {\n  let mut out = i\n  let mut saw_newline = false\n  let mut skipping = true\n  while skipping && out < len {\n    let c = String::char_code_at(s, out)\n    if is_ws(c) {\n      if c == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = out + 1\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\n      let next = skip_until_newline(s, len, out + 2)\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\n' {\n        saw_newline = true\n      } else {\n        ()\n      }\n      out = next\n    } else {\n      skipping = false\n    }\n  }\n  (out, saw_newline)\n}\n\nlet concat_string_parts: (Array[String], String) -> String = (parts, tail) -> {\n  // O(N) join via StringBuilder; the previous `out = String::concat(out, ...)`\n  // per part was O(N²) over the joined length (issue #366).\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(parts) {\n    StringBuilder::push(out, Array::get(parts, i))\n    i = i + 1\n  }\n  StringBuilder::push(out, tail)\n  StringBuilder::freeze(out)\n}\n\nlet lex_string_go: (String, Int, Int, Int, Array[String], Bool, ArrayBuilder[String]) -> (Token, Int) with { Error } = (s, len, idx, start, parts_acc, has_interp, parts) -> {\n  let mut current_idx = idx\n  let mut current_start = start\n  let mut current_parts_acc = parts_acc\n  let mut current_has_interp = has_interp\n  let mut out_tok = TEof\n  let mut out_next = -1\n  let mut done = false\n  while !done {\n    if current_idx >= len {\n      throw(\"unterminated string\")\n    }\n    let c = String::char_code_at(s, current_idx)\n    if c == '\"' {\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\n      if current_has_interp {\n        ArrayBuilder::push(parts, value)\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts))\n        out_next = current_idx + 1\n      } else {\n        out_tok = TString(value)\n        out_next = current_idx + 1\n      }\n      done = true\n    } else if c == '\\\\' {\n      let chunk = s[current_start: current_idx]\n      let next = current_idx + 1\n      if next >= len {\n        throw(\"unterminated string escape\")\n      }\n      let esc = String::char_code_at(s, next)\n      if esc == '{' || esc == '(' {\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\n        let interp_end = if esc == '{' {\n          scan_interp_end(s, len, next + 1, 1)\n        } else {\n          let mut ie = next + 1\n          let mut depth = 1\n          while ie < len && depth > 0 {\n            let ic = String::char_code_at(s, ie)\n            if ic == '(' {\n              depth = depth + 1\n            }\n            else if ic == ')' {\n              depth = depth - 1\n            }\n            ie = ie + 1\n          }\n          ie - 1\n        }\n        let expr_src = s[next + 1: interp_end]\n        ArrayBuilder::push(parts, expr_src)\n        current_idx = interp_end + 1\n        current_start = interp_end + 1\n        current_parts_acc = empty_string_array()\n        current_has_interp = true\n      } else {\n        let escaped = if esc == '\"' {\n          \"\\\"\"\n        }\n        else if esc == '\\\\' {\n          \"\\\\\"\n        }\n        else if esc == 'n' {\n          \"\\n\"\n        }\n        else if esc == 't' {\n          \"\\t\"\n        }\n        else if esc == 'r' {\n          String::from_char_code(13)\n        }\n        else if esc == '0' {\n          String::from_char_code(0)\n        }\n        else throw(\"invalid escape sequence\")\n        Array::push(current_parts_acc, chunk)\n        Array::push(current_parts_acc, escaped)\n        current_idx = next + 1\n        current_start = next + 1\n      }\n    } else {\n      current_idx = current_idx + 1\n    }\n  }\n  (out_tok, out_next)\n}\n\nlet lex_string: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())\n}\n\nlet scan_hex_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\n  let mut out = i\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\n    out = out + 1\n  }\n  out\n}\n\nlet parse_hex_from_string: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    let digit = if c >= '0' && c <= '9' {\n      c - 48\n    } else if c >= 'a' && c <= 'f' {\n      c - 87\n    } else c - 55\n    acc = acc * 16 + digit\n    i = i + 1\n  }\n  acc\n}\n\nlet parse_int_from_string: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut acc = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    acc = acc * 10 + (c - 48)\n    i = i + 1\n  }\n  acc\n}\n\nlet lex_decimal: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  let int_end = scan_digits_end(s, len, i)\n  if int_end == i {\n    throw(\"expected digit\")\n  }\n  // Tuple field access `t.0.0`: a number immediately preceded by a single field\n  // dot must NOT absorb a trailing `.<digit>` as a float decimal — that `.` is\n  // the next tuple-index projection, not this number's fraction. (Mirrors\n  // src/parser/lexer.mbt `after_field_dot`.) Excludes `..`/`...` (range/spread)\n  // by requiring the char two back to not also be a dot.\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\n      let int_str = s[i: int_end]\n      let int_val = Int::to_double(parse_int_from_string(int_str))\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\n        (TFloat(int_val + frac_val), frac_end + 1)\n      } else {\n        (TFloat(int_val + frac_val), frac_end)\n      }\n    } else {\n      let int_str = s[i: int_end];\n      (TInt(parse_int_from_string(int_str)), int_end)\n    }\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\n    // Integer-form float literal with an `f` suffix, e.g. `10f`, `0f`.\n    let int_str = s[i: int_end]\n    let int_val = Int::to_double(parse_int_from_string(int_str))\n    (TFloat(int_val), int_end + 1)\n  } else {\n    let int_str = s[i: int_end];\n    (TInt(parse_int_from_string(int_str)), int_end)\n  }\n}\n\nlet lex_number: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\n    let next_c = String::char_code_at(s, i + 1)\n    if next_c == 'x' || next_c == 'X' {\n      let hex_start = i + 2\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\n      if hex_end == hex_start {\n        throw(\"expected hex digit after 0x\")\n      }\n      let hex_str = s[hex_start: hex_end];\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\n    } else lex_decimal(s, len, i)\n  } else lex_decimal(s, len, i)\n}\n\n// Can this token end a complete (primary) expression? After such a token, a\n// newline followed by `[` starts a NEW statement (an array literal), not a\n// postfix subscript — the lexer inserts a synthetic `;` to disambiguate.\nlet is_expr_ending_tok: (Token) -> Bool = (t) -> {\n  match t {\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    TIdent(_) => true,\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    _ => false\n  }\n}\n\n// Classify and consume a single token starting at byte `pos`, returning the\n// token and the byte offset just past it. Shared by `lex` and\n// `lex_with_offsets` so the large classification logic (and its codegen) exists\n// only once.\nlet lex_one_token: (String, Int, Int) -> (Token, Int) with { Error } = (source, len, pos) -> {\n  let c = String::char_code_at(source, pos)\n  if is_alpha(c) {\n    lex_ident(source, len, pos)\n  } else if is_digit(c) {\n    lex_number(source, len, pos)\n  } else if c == '\"' {\n    lex_string(source, len, pos)\n  } else if c == '+' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPlusEq, pos + 2)\n    } else (TPlus, pos + 1)\n  } else if c == '-' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TThinArrow, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TMinusEq, pos + 2)\n    } else (TMinus, pos + 1)\n  } else if c == '*' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TStarEq, pos + 2)\n    } else (TStar, pos + 1)\n  } else if c == '/' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TSlashEq, pos + 2)\n    } else (TSlash, pos + 1)\n  } else if c == '%' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TPercentEq, pos + 2)\n    } else (TPercent, pos + 1)\n  } else if c == '=' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TEqEq, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TArrow, pos + 2)\n    } else (TEq, pos + 1)\n  } else if c == '!' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TNeq, pos + 2)\n    } else (TNot, pos + 1)\n  } else if c == '<' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TLte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\n      (TLShift, pos + 2)\n    } else (TLt, pos + 1)\n  } else if c == '>' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\n      (TGte, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TRShift, pos + 2)\n    } else (TGt, pos + 1)\n  } else if c == '&' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\n      (TAnd, pos + 2)\n    } else (TBitAnd, pos + 1)\n  } else if c == '|' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\n      (TOr, pos + 2)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\n      (TPipeGt, pos + 2)\n    } else (TBitOr, pos + 1)\n  } else if c == '^' {\n    (TBitXor, pos + 1)\n  } else if c == '(' {\n    (TLParen, pos + 1)\n  } else if c == ')' {\n    (TRParen, pos + 1)\n  } else if c == '{' {\n    (TLBrace, pos + 1)\n  } else if c == '}' {\n    (TRBrace, pos + 1)\n  } else if c == '[' {\n    (TLBracket, pos + 1)\n  } else if c == ']' {\n    (TRBracket, pos + 1)\n  } else if c == ',' {\n    (TComma, pos + 1)\n  } else if c == ';' {\n    (TSemicolon, pos + 1)\n  } else if c == '.' {\n    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\n      (TDotDotDot, pos + 3)\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\n      (TDotDot, pos + 2)\n    } else (TDot, pos + 1)\n  } else if c == ':' {\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\n      (TDoubleColon, pos + 2)\n    } else (TColon, pos + 1)\n  } else if c == '#' {\n    (THash, pos + 1)\n  } else if c == '~' {\n    (TTilde, pos + 1)\n  } else if c == '?' {\n    (TQuestion, pos + 1)\n  } else if c == '@' {\n    // Package refs: `@scope/name` — '/', '-', '_' are part of the name after\n    // '@' (#730; matches the documented `@lib/path` form). A trailing '/'\n    // is not consumed (so `@a/` is `@a` + '/').\n    let mut end = pos + 1\n    while end < len {\n      let ec = String::char_code_at(source, end)\n      if is_alnum(ec) || ec == '_' || ec == '-' {\n        end = end + 1\n      } else if ec == '/' && end + 1 < len && is_alnum(String::char_code_at(source, end + 1)) {\n        end = end + 1\n      } else {\n        break\n      }\n    }\n    if end > pos + 1 {\n      (TIdent(String::substring(source, pos, end)), end)\n    } else {\n      throw(\"unexpected '@' without identifier\")\n    }\n  } else if c == '\\'' {\n    lex_char(source, len, pos)\n  } else throw(String::concat(\"unexpected character: \", String::from_char_code(c)))\n}\n\n// Position-tracking lexer: identical token production to `lex`, but also returns\n// per emitted token its start and end byte offset in `source` (three parallel\n// arrays — one entry per token, including any synthetic `;` separators and the\n// trailing `TEof`). Used by module-source emission to recover top-level\n// statement source spans.\nexport let lex_with_offsets: (String) -> (Array[Token], Array[Int], Array[Int]) with { Error } = (source) -> {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let starts = ArrayBuilder::new()\n    let ends = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, 0)\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n        ArrayBuilder::push(starts, pos)\n        ArrayBuilder::push(ends, pos)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      ArrayBuilder::push(starts, pos)\n      ArrayBuilder::push(ends, next)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::push(starts, len)\n    ArrayBuilder::push(ends, len)\n    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))\n  }\n}\n\n// Convert a 0-based char offset (from lex_with_offsets) to 1-based (line, col).\n// Source-span foundation: lets diagnostics report a real `line:col`.\nexport let offset_to_line_col: (String, Int) -> (Int, Int) = (source, offset) -> {\n  let len = String::length(source)\n  let bound = if offset < len { offset } else { len }\n  let mut i = 0\n  let mut line = 1\n  let mut col = 1\n  while i < bound {\n    if String::char_code_at(source, i) == 10 {\n      line = line + 1\n      col = 1\n    } else {\n      col = col + 1\n    }\n    i = i + 1\n  }\n  (line, col)\n}\n\nexport let lex: (String) -> Array[Token] with { Error } = (source) -> {\n  let len = String::length(source)\n  {\n    let b = ArrayBuilder::new()\n    let mut prev_tok = TEof\n    let first_skip = skip_ws_with_newline(source, len, 0)\n    let mut pos = first_skip.0\n    let mut nl_before = first_skip.1\n    while pos < len {\n      let c = String::char_code_at(source, pos)\n      let (tok, next) = lex_one_token(source, len, pos)\n      // Newline-sensitive disambiguation: `expr <newline> [ ... ]` is two\n      // statements (the `[...]` is an array literal), not a postfix subscript\n      // `expr[...]`; likewise `expr <newline> ( ... )` is two statements (the\n      // `(...)` is a paren/tuple expression), not a call `expr(...)`. The lexer\n      // discards newlines, so insert a synthetic `;` when a `[`/`(` is\n      // newline-preceded and follows an expression-ending token; the statement\n      // parser already treats `;` as a separator. A same-line `(`/`[` (no\n      // newline) still attaches as a call/subscript suffix.\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\n        ArrayBuilder::push(b, TSemicolon)\n      } else {\n        ()\n      }\n      ArrayBuilder::push(b, tok)\n      prev_tok = tok\n      let skipped = skip_ws_with_newline(source, len, next)\n      pos = skipped.0\n      nl_before = skipped.1\n    }\n    ArrayBuilder::push(b, TEof)\n    ArrayBuilder::freeze(b)\n  }\n}\n\nexport let lex_ok: (String) -> Bool = (source) -> {\n  handle {\n    let _ = lex(source)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n")
}

let cli_adapter_source_11 = () -> (String, String) {
  ("vibe/compiler/syntax/parser.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./parser_base.vibe {\n  collect_import_path, empty_fields, empty_import_items, expect_tk, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_derive_names, peek, skip_braced_body, skip_derive, tk_name\n}\n\nimport ./parser_expr.vibe {\n  parse, parse_expr, parse_fn_stmt, parse_impl, parse_let_stmt, parse_ok\n}\n\nimport ./token.vibe {\n  Token\n}\n\nimport ./lexer.vibe {\n  offset_to_line_col\n}\n\n//# Functions\n\nlet parser_mode_block = 20\n\nlet empty_names: () -> Array[String] = () -> {\n  Array::slice([\n    \"_\"\n  ], 0, 0)\n}\n\nlet parse_test_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\n      (STest(name, body), end)\n    },\n    _ => throw(\"expected test name string\")\n  }\n}\n\nlet parse_bench_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  match peek(tokens, pos) {\n    TString(name) => {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\n      (SBench(name, body), end)\n    },\n    _ => throw(\"expected bench name string\")\n  }\n}\n\n// Parse one export-list name, accepting a qualified `Ns::member`\n// (e.g. `JsonSchema::validate`) in addition to a bare ident.\nlet parse_export_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) =>\n          (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name in export list\")\n  }\n}\n\nlet rec parse_export_names_rest: (Array[Token], Int, ArrayBuilder[String]) -> (Array[String], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      TIdent(_) => {\n        let (nm, after) = parse_export_name(tokens, pos + 1)\n        ArrayBuilder::push(b, nm)\n        parse_export_names_rest(tokens, after, b)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in export list\")\n  }\n}\n\nlet rec parse_import_items_rest: (Array[Token], Int, ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (item, next) = parse_import_item(tokens, pos + 1)\n        ArrayBuilder::push(b, item)\n        parse_import_items_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or '}' in import list\")\n  }\n}\n\nlet parse_import_items: (Array[Token], Int) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_import_items(), pos + 1),\n    _ => {\n      let (first, next) = parse_import_item(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_import_items_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_import_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\n      let br = expect_tk(tokens, pos + 1, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(name, items), end)\n    } else {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      match peek(tokens, bp) {\n        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\n          let alias_str = String::substring(alias_name, 1, String::length(alias_name))\n          (SAliasDecl(alias_str, path), bp + 1)\n        } else {\n          let br = expect_tk(tokens, bp, \"{\")\n          let (items, end) = parse_import_items(tokens, br);\n          (SImport(path, items), end)\n        },\n        _ => {\n          let br = expect_tk(tokens, bp, \"{\")\n          let (items, end) = parse_import_items(tokens, br);\n          (SImport(path, items), end)\n        }\n      }\n    },\n    _ => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SImport(path, items), end)\n    }\n  }\n}\n\nlet tl_push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nlet rec parse_toplevel_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        tl_push_mut_name(mb, field, is_mut)\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        tl_push_mut_name(mb, field, is_mut)\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_toplevel_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      tl_push_mut_name(mb, first, is_mut)\n      parse_toplevel_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nlet parse_toplevel_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      // Optional type-parameter header `struct Foo[T] { ... }`. Consumed and\n      // discarded (uniform tagged representation, like enum type params).\n      let after_name = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let mut skip = pos + 2\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TEof => {\n                depth = 0\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          skip\n        },\n        _ => pos + 1\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\nlet parse_export_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  match peek(tokens, pos) {\n    TLet => parse_let_stmt(tokens, starts, pos + 1, true),\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),\n    TIdent(ident_name) => if ident_name == \"effect\" {\n      parse_effect_stmt(tokens, pos + 1, true)\n    } else if ident_name == \"fn\" {\n      parse_fn_stmt(tokens, starts, pos + 1, true)\n    } else {\n      throw(String::concat(\"unexpected token in export: \", ident_name))\n    },\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\n    TOpen => match peek(tokens, pos + 1) {\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\n      _ => throw(\"expected 'trait' after 'open'\")\n    },\n    TLBrace => match peek(tokens, pos + 1) {\n      TRBrace => (SExport(empty_names()), pos + 2),\n      TIdent(_) => {\n        let (first, after) = parse_export_name(tokens, pos + 1)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, first)\n        let (names, end) = parse_export_names_rest(tokens, after, b);\n        (SExport(names), end)\n      },\n      _ => throw(\"expected name in export list\")\n    },\n    TDot => {\n      let (path, bp) = collect_import_path(tokens, pos, \"\")\n      let br = expect_tk(tokens, bp, \"{\")\n      let (items, end) = parse_import_items(tokens, br);\n      (SReExport(path, items), end)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected after 'export': \\{actual}\")\n    }\n  }\n}\n\nlet parse_percent_symbol_name: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, label) -> {\n  let pp = expect_tk(tokens, pos, \"%\")\n  match peek(tokens, pp) {\n    TIdent(name) => (\"%\\{name}\", pp + 1),\n    _ => throw(\"expected \\{label} after '%'\")\n  }\n}\n\nlet parse_extern_let_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let lp = expect_tk(tokens, pos, \"let\")\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \"extern symbol name\")\n  let cp = expect_tk(tokens, np, \":\")\n  let (ty, end) = parse_type(tokens, cp);\n  (SExternLet(name, ty), end)\n}\n\nexport let rec parse_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\n  let head = peek(tokens, pos)\n  match head {\n    TLet => parse_let_stmt(tokens, starts, pos + 1, false),\n    TExport => match peek(tokens, pos + 1) {\n      // ADR-0063 Phase B (#728): module blocks are removed.\n      TModule => throw(\"'module' blocks are removed (#728); use file boundaries + import/export\"),\n      _ => parse_export_stmt(tokens, starts, pos + 1)\n    },\n    TModule => throw(\"'module' blocks are removed (#728); use file boundaries + import/export\"),\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\n    TTest => parse_test_stmt(tokens, starts, pos + 1),\n    TBench => parse_bench_stmt(tokens, starts, pos + 1),\n    TImport => parse_import_stmt(tokens, pos + 1),\n    TIdent(name) => match name {\n      \"effect\" => parse_effect_stmt(tokens, pos + 1, false),\n      \"extern\" => parse_extern_let_stmt(tokens, pos + 1),\n      \"fn\" => parse_fn_stmt(tokens, starts, pos + 1, false),\n      \"use\" => throw(\"'use' syntax is removed; use 'import <module-ref> { ... }'\"),\n      _ => {\n      let (e, next) = parse_impl(tokens, starts, pos, 0)\n      match peek(tokens, next) {\n        TEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssign(name, val, EUnit)), vn)\n          },\n          ECall(idx_callee, idx_args, _) => {\n            // `arr[i] = v` at statement level: `__index(arr, i)` receiver\n            // desugars to Array::set (same as the block-expr TEq arm).\n            let is_index = match idx_callee {\n              EIdent(icn, _) => icn == \"__index\",\n              _ => false\n            }\n            if is_index && Array::length(idx_args) == 2 {\n              let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n              let set_args = Array::slice([\n                EUnit\n              ], 0, 0)\n              Array::push(set_args, Array::get(idx_args, 0))\n              Array::push(set_args, Array::get(idx_args, 1))\n              Array::push(set_args, val)\n              (SExpr(ECall(EIdent(\"Array::set\", -1), set_args, -1)), vn)\n            } else {\n              (SExpr(e), next)\n            }\n          },\n          _ => (SExpr(e), next)\n        },\n        TPlusEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"+\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TMinusEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"-\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TStarEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"*\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        TSlashEq => match e {\n          EIdent(name, _) => {\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\n            (SExpr(EAssignOp(name, \"/\", val, EUnit)), vn)\n          },\n          _ => (SExpr(e), next)\n        },\n        _ => (SExpr(e), next)\n      }\n      }\n    },\n    _ => {\n      let (e, next) = parse_impl(tokens, starts, pos, 0);\n      (SExpr(e), next)\n    }\n  }\n}\n\n// Expand an impl body `{ method(params) -> ret { body } ... }` into the impl\n// marker plus one `let Type::method = (params) -> ret { body }` per method\n// (#641 Phase 1: concrete-receiver dispatch). Trait stays marker-only; the\n// methods become ordinary qualified free functions resolved by name. `pos` is\n// at the body `{` (or the next token for a body-less impl). Needs `parse_expr`,\n// which is why this lives here rather than in parser_base.\nlet parse_impl_methods: (Array[Token], Int, Stmt) -> (Array[Stmt], Int) with { Error } = (tokens, pos, simpl) -> {\n  let out = ArrayBuilder::new()\n  ArrayBuilder::push(out, simpl)\n  match peek(tokens, pos) {\n    TLBrace => {\n      let type_name = match simpl {\n        SImpl(_, _, _, tn) => tn,\n        _ => \"\"\n      }\n      // A generic impl `impl [T: Bound] Trait for C { method(self){..} }` binds\n      // `T` (and its bound) over each method body, so inject the impl's type\n      // parameters + bounds into every method's `EFn`. This lets the body\n      // dispatch `T::m(elem)` (resolved via the threaded witness dict, #5\n      // Increment B). Non-generic impls have an empty list → methods unchanged.\n      let impl_tparams = match simpl {\n        SImpl(tp, _, _, _) => tp,\n        _ => Array::slice([\n          \"\"\n        ], 0, 0)\n      }\n      let impl_tbounds = match simpl {\n        SImpl(_, tb, _, _) => tb,\n        _ => Array::slice([\n          (\"\", Array::slice([\n            \"\"\n          ], 0, 0))\n        ], 0, 0)\n      }\n      let mut p = pos + 1\n      let mut done = false\n      while !done {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            done = true\n          },\n          TIdent(mname) => {\n            let (efn, p2) = parse_expr(tokens, p + 1)\n            let efn2 = if Array::length(impl_tparams) > 0 {\n              match efn {\n                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),\n                _ => efn\n              }\n            } else {\n              efn\n            }\n            let qname = String::concat(type_name, String::concat(\"::\", mname))\n            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))\n            p = match peek(tokens, p2) {\n              TSemicolon => p2 + 1,\n              _ => p2\n            }\n          },\n          _ => throw(\"expected impl method name or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(out), p)\n    },\n    _ => (ArrayBuilder::freeze(out), pos)\n  }\n}\n\n// Compile-time conditional compilation (#cfg). A top-level statement may be\n// prefixed with `#cfg(flag)`; the statement is KEPT only when `flag` is\n// active, and otherwise parsed (syntax must stay valid, like Rust's cfg) and\n// DISCARDED before checking/codegen -- so disabled debug code adds zero bytes\n// to the output. Flags are activated by `#cfg_enable(flag)` directives, which\n// the CLI appends to the source when `VIBE_CFG=flag1,flag2` is set (appending\n// at the END keeps every source offset -- and thus diagnostics -- unchanged).\n// A pre-scan collects the active set so `#cfg_enable` position is irrelevant.\n//\n// NOTE: `#cfg` must not be used in the compiler's own source until the seed\n// compiler understands it (docs/selfhost-bootstrap.md bump procedure).\n\n// Parse the directive after a THash: `cfg(name)` or `cfg_enable(name)`.\n// Returns (directive_kind, flag_name, next_pos).\nlet parse_cfg_directive: (Array[Token], Int) -> (String, String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(dname) => {\n      if dname == \"cfg\" || dname == \"cfg_enable\" {\n        match peek(tokens, pos + 1) {\n          TLParen => match peek(tokens, pos + 2) {\n            TIdent(flag) => match peek(tokens, pos + 3) {\n              TRParen => (dname, flag, pos + 4),\n              _ => throw(\"expected ')' after #cfg flag name\")\n            },\n            _ => throw(\"expected flag name in #cfg(...)\")\n          },\n          _ => throw(\"expected '(' after #cfg\")\n        }\n      } else {\n        throw(String::concat(\"unknown # directive: \", dname))\n      }\n    },\n    _ => throw(\"expected directive name after '#'\")\n  }\n}\n\n// Pre-scan the whole token stream for `#cfg_enable(name)` directives and\n// return the active flag set. O(tokens), no allocation unless a THash exists.\nlet cfg_scan_enabled: (Array[Token]) -> Array[String] with { Error } = (tokens) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  let n = Array::length(tokens)\n  while i < n {\n    match Array::get(tokens, i) {\n      THash => {\n        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)\n        if dname == \"cfg_enable\" {\n          Array::push(out, flag)\n        } else {\n          ()\n        }\n        i = next\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  out\n}\n\nlet cfg_flag_active: (Array[String], String) -> Bool = (active, flag) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(active) {\n    if Array::get(active, i) == flag {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nexport let parse_program: (Array[Token]) -> Array[Stmt] with { Error } = (tokens) -> {\n  let cfg_active = cfg_scan_enabled(tokens)\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n        if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n          // enable directive consumed, or active #cfg: keep the next stmt.\n          pos = dnext\n        } else {\n          // Inactive #cfg: parse the guarded statement and discard it.\n          match peek(tokens, dnext) {\n            TImpl => {\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n              pos = dn\n            },\n            _ => {\n              let (_dropped, dn) = parse_stmt(tokens, [], dnext)\n              pos = dn\n            }\n          }\n        }\n      },\n      TImpl => {\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)\n        let mut ii = 0\n        while ii < Array::length(impl_stmts) {\n          ArrayBuilder::push(b, Array::get(impl_stmts, ii))\n          ii = ii + 1\n        }\n        pos = next\n      },\n      _ => {\n        let (stmt, next) = parse_stmt(tokens, [], pos)\n        ArrayBuilder::push(b, stmt)\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\n// Like parse_program but, on a syntax error, prefixes the message with the\n// failing statement's `line:col` (from `lex_with_offsets` token start offsets).\n// Per-statement wrapping keeps the change local. Build the prefix with\n// String::concat (not `+` or interpolation) to avoid selfhost string-concat\n// NUL fragility. Source-span foundation: located parse diagnostics.\nexport let parse_program_located: (Array[Token], Array[Int], String) -> Array[Stmt] with { Error } = (tokens, starts, source) -> {\n  let cfg_active = cfg_scan_enabled(tokens)\n  let b = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n        if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n          pos = dnext\n        } else {\n          match peek(tokens, dnext) {\n            TImpl => {\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n              pos = dn\n            },\n            _ => {\n              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\n              pos = dn\n            }\n          }\n        }\n      },\n      _ => {\n        let start_pos = pos\n        let (stmts, next) = handle {\n          match peek(tokens, pos) {\n            TImpl => {\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n              parse_impl_methods(tokens, hp, simpl)\n            },\n            _ => {\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\n              ([\n                stmt\n              ], n)\n            }\n          }\n        } with Error {\n          Throw(msg) => {\n            let off = if start_pos < Array::length(starts) {\n              Array::get(starts, start_pos)\n            } else {\n              0\n            }\n            let (line, col) = offset_to_line_col(source, off)\n            let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n            throw(String::concat(loc, msg))\n          }\n        }\n        let mut ii = 0\n        while ii < Array::length(stmts) {\n          ArrayBuilder::push(b, Array::get(stmts, ii))\n          ii = ii + 1\n        }\n        pos = next\n      }\n    }\n  }\n  ArrayBuilder::freeze(b)\n}\n\n// True when `t` is a resynchronization point for `parse_program_recovering`:\n// it begins a top-level statement, OR is a statement separator (TSemicolon),\n// OR ends input (TEof). Folding TSemicolon/TEof in here lets the resync loop\n// use a single `if is_recovery_point(...)` test instead of a mixed\n// constructor/catch-all `match` (the latter traps the seed codegen on this\n// shape — keep this a flat function returning Bool).\nlet is_recovery_point: (Token) -> Bool = (t) -> {\n  match t {\n    TLet => true,\n    TExport => true,\n    TModule => true,\n    TEnum => true,\n    TSuberror => true,\n    TStruct => true,\n    TType => true,\n    TTrait => true,\n    TTest => true,\n    TBench => true,\n    TImport => true,\n    TImpl => true,\n    TDeclare => true,\n    TOpen => true,\n    TSemicolon => true,\n    TEof => true,\n    _ => false\n  }\n}\n\n// Like `parse_program_located`, but NEVER rethrows. On a per-statement syntax\n// error it records the located (`line:col`) message into a diagnostics array,\n// then resynchronizes by advancing `pos` to the next top-level statement start\n// (or TSemicolon / TEof). At least one token is always consumed to guarantee\n// progress. Returns the partial AST plus all collected diagnostics. Build all\n// strings with String::concat (not `+`/interpolation) to avoid selfhost\n// string-concat NUL fragility. Foundation: collect-all parse diagnostics (LSP).\nexport let parse_program_recovering: (Array[Token], Array[Int], String) -> (Array[Stmt], Array[String]) with { Error } = (tokens, starts, source) -> {\n  let cfg_active = handle {\n    cfg_scan_enabled(tokens)\n  } with Error {\n    Throw(_) => Array::slice([\n      \"\"\n    ], 0, 0)\n  }\n  let b = ArrayBuilder::new()\n  let diags = ArrayBuilder::new()\n  let n = Array::length(tokens)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        // #cfg directive: on any malformed directive fall through to the\n        // recovery machinery below by treating it like a failed statement.\n        let cfg_res = handle {\n          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\n          if dname == \"cfg_enable\" || cfg_flag_active(cfg_active, flag) {\n            dnext\n          } else {\n            match peek(tokens, dnext) {\n              TImpl => {\n                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\n                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\n                dn\n              },\n              _ => {\n                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\n                dn\n              }\n            }\n          }\n        } with Error {\n          Throw(_) => 0 - 1\n        }\n        if cfg_res >= 0 {\n          pos = cfg_res\n        } else {\n          // resync: skip to the next recovery point (mirrors the stmt path).\n          let mut rp = pos + 1\n          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {\n            rp = rp + 1\n          }\n          pos = rp\n        }\n      },\n      _ => {\n        let start_pos = pos\n        let res = handle {\n          let (stmts, next) = match peek(tokens, pos) {\n            TImpl => {\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n              parse_impl_methods(tokens, hp, simpl)\n            },\n            _ => {\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\n              ([\n                stmt\n              ], n)\n            }\n          }\n          Some((stmts, next))\n        } with Error {\n          Throw(msg) => {\n            let off = if start_pos < Array::length(starts) {\n              Array::get(starts, start_pos)\n            } else {\n              0\n            }\n            let (line, col) = offset_to_line_col(source, off)\n            let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n            ArrayBuilder::push(diags, String::concat(loc, msg))\n            None\n          }\n        }\n        match res {\n          Some((stmts, next)) => {\n            let mut ii = 0\n            while ii < Array::length(stmts) {\n              ArrayBuilder::push(b, Array::get(stmts, ii))\n              ii = ii + 1\n            }\n            pos = next\n          },\n          None => {\n            // Resynchronize: skip at least one token (guarantee progress),\n            // then advance to the next recovery point (top-level statement\n            // start, TSemicolon, or TEof — see is_recovery_point).\n            let mut rp = start_pos + 1\n            let mut sync = false\n            while !sync {\n              if rp >= n {\n                sync = true\n              } else {\n                let t = peek(tokens, rp)\n                if is_recovery_point(t) {\n                  sync = true\n                } else {\n                  rp = rp + 1\n                }\n              }\n            }\n            pos = rp\n          }\n        }\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(diags))\n}\n\n// Like `parse_program`, but also returns per top-level statement its source\n// byte span (start, end), derived from the token offset arrays produced by\n// `lex_with_offsets`. start = first token's start offset; end = last token's\n// end offset. The three returned arrays are parallel (one entry per stmt).\nexport let parse_program_spans: (Array[Token], Array[Int], Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } = (tokens, starts, ends) -> {\n  let b = ArrayBuilder::new()\n  let span_start = ArrayBuilder::new()\n  let span_end = ArrayBuilder::new()\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    match peek(tokens, pos) {\n      TEof => {\n        done = true\n      },\n      TSemicolon => {\n        pos = pos + 1\n      },\n      THash => {\n        // Module-source (flat source) emission re-emits statement spans; a\n        // #cfg directive sits OUTSIDE its statement's span, so passing it\n        // through would silently change semantics between the original and\n        // the re-emitted source. Refuse loudly instead (the compiler's own\n        // source must not use #cfg until the seed understands it).\n        throw(\"#cfg directives are not supported in module-source emission\")\n      },\n      TImpl => {\n        let st = Array::get(starts, pos)\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\n        let next = skip_braced_body(tokens, hp)\n        ArrayBuilder::push(b, simpl)\n        ArrayBuilder::push(span_start, st)\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\n        pos = next\n      },\n      _ => {\n        let st = Array::get(starts, pos)\n        let (stmt, next) = parse_stmt(tokens, starts, pos)\n        ArrayBuilder::push(b, stmt)\n        ArrayBuilder::push(span_start, st)\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\n        pos = next\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))\n}\n\n//# Misc\n\nexport {\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n\nexport {\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\n}\n")
}

let cli_adapter_source_12 = () -> (String, String) {
  ("vibe/compiler/syntax/parser_base.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet peek: (Array[Token], Int) -> Token = (tokens, pos) -> {\n  if pos < Array::length(tokens) {\n    Array::get(tokens, pos)\n  } else TEof\n}\n\nlet _no_tp: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet _no_tb: () -> Array[(String, Array[String])] = () -> {\n  Array::slice([\n    (\"\", _no_tp())\n  ], 0, 0)\n}\n\nlet mode_if = 21\n\nlet tk_name: (Token) -> String = (tok) -> {\n  match tok {\n    TInt(_) => \"int\",\n    TFloat(_) => \"float\",\n    TString(_) => \"string\",\n    TStringInterp(_) => \"string\",\n    TIdent(_) => \"ident\",\n    TLet => \"let\",\n    TRec => \"rec\",\n    TMut => \"mut\",\n    TFn => \"fn\",\n    TIf => \"if\",\n    TElse => \"else\",\n    TMatch => \"match\",\n    TIs => \"is\",\n    TDo => \"do\",\n    TEnum => \"enum\",\n    TStruct => \"struct\",\n    TType => \"type\",\n    TTrait => \"trait\",\n    TImpl => \"impl\",\n    TExport => \"export\",\n    TTest => \"test\",\n    TWhile => \"while\",\n    TFor => \"for\",\n    TIn => \"in\",\n    TLoop => \"loop\",\n    TBreak => \"break\",\n    TContinue => \"continue\",\n    TReturn => \"return\",\n    TWith => \"with\",\n    THandle => \"handle\",\n    TThrow => \"throw\",\n    TRaise => \"raise\",\n    TYield => \"yield\",\n    TBench => \"bench\",\n    TDeclare => \"declare\",\n    TAs => \"as\",\n    TModule => \"module\",\n    TSuberror => \"suberror\",\n    TDerive => \"derive\",\n    TOpen => \"open\",\n    TImport => \"import\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TAnd => \"&&\",\n    TOr => \"||\",\n    TNot => \"!\",\n    TBitAnd => \"&\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPipeGt => \"|>\",\n    TArrow => \"=>\",\n    TThinArrow => \"->\",\n    TEq => \"=\",\n    TDot => \".\",\n    TColon => \":\",\n    TDoubleColon => \"::\",\n    TComma => \",\",\n    TSemicolon => \";\",\n    THash => \"#\",\n    TTilde => \"~\",\n    TQuestion => \"?\",\n    TPlusEq => \"+=\",\n    TMinusEq => \"-=\",\n    TStarEq => \"*=\",\n    TSlashEq => \"/=\",\n    TPercentEq => \"%=\",\n    TLParen => \"(\",\n    TRParen => \")\",\n    TLBrace => \"{\",\n    TRBrace => \"}\",\n    TLBracket => \"[\",\n    TRBracket => \"]\",\n    TDotDot => \"..\",\n    TDotDotDot => \"...\",\n    TStringInterp(_) => \"string\",\n    TEof => \"eof\"\n  }\n}\n\nlet is_tk: (Token, String) -> Bool = (tok, name) -> {\n  tk_name(tok) == name\n}\n\nlet expect_tk: (Array[Token], Int, String) -> Int with { Error } = (tokens, pos, expected) -> {\n  if is_tk(peek(tokens, pos), expected) {\n    pos + 1\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"expected \\{expected} but got \\{actual}\")\n  }\n}\n\nlet skip_semi: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TSemicolon => pos + 1,\n    _ => pos\n  }\n}\n\nlet empty_arms: () -> Array[(Pat, Expr)] = () -> {\n  Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n}\n\nlet empty_pats: () -> Array[Pat] = () -> {\n  Array::slice([\n    PWild\n  ], 0, 0)\n}\n\nlet mode_block = 20\n\nlet mode_match = 22\n\nlet mode_while = 23\n\nlet empty_ctors: () -> Array[(String, Array[TypeExpr])] = () -> {\n  Array::slice([\n    (\"_\", Array::slice([\n      TyUnit\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet empty_exprs: () -> Array[Expr] = () -> {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet mode_for_in = 25\n\nlet mode_handle = 24\n\n// Parse a `derive(A, B, ...)` clause into the list of derived trait names plus\n// the position after the clause. Any identifier is accepted (the set of\n// structurally-derivable traits is validated later); a missing clause yields an\n// empty list. Supports multiple comma-separated names (#638).\nexport let parse_derive_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let names = Array::slice([\n    \"\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TDerive => match peek(tokens, pos + 1) {\n      TLParen => {\n        let mut dp = pos + 2\n        let mut dd = true\n        while dd {\n          match peek(tokens, dp) {\n            TRParen => {\n              dd = false\n              dp = dp + 1\n            },\n            TComma => {\n              dp = dp + 1\n            },\n            TIdent(name) => {\n              Array::push(names, name)\n              dp = dp + 1\n            },\n            _ => throw(\"expected derive identifier\")\n          }\n        }\n        (names, dp)\n      },\n      _ => (names, pos)\n    },\n    _ => (names, pos)\n  }\n}\n\nexport let skip_derive: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\n  let (_, next) = parse_derive_names(tokens, pos)\n  next\n}\n\nlet empty_fields: () -> Array[(String, TypeExpr)] = () -> {\n  Array::slice([\n    (\"_\", TyUnit)\n  ], 0, 0)\n}\n\nlet empty_params: () -> Array[(String, Option[TypeExpr])] = () -> {\n  Array::slice([\n    (\"\", None)\n  ], 0, 0)\n}\n\nlet rec parse_pattern: (Array[Token], Int) -> (Pat, Int) with { Error } = (tokens, pos) -> {\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => {\n        let (p, pn) = parse_pattern(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_pat_cont(tokens, pn, b)\n      },\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\n      _ => throw(\"expected ',' or ')' in pattern list\")\n    }\n  }\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\n    match peek(tokens, pos) {\n      TRParen => (empty_pats(), pos + 1),\n      _ => {\n        let (f, fn1) = parse_pattern(tokens, pos)\n        let b = ArrayBuilder::new()\n        ArrayBuilder::push(b, f)\n        parse_pat_cont(tokens, fn1, b)\n      }\n    }\n  }\n  let (pat, next) = match peek(tokens, pos) {\n    TInt(n) => (PInt(n), pos + 1),\n    // A negative literal pattern `-5` / `-1.5` (lexed as TMinus + number).\n    // Float literal patterns used to silently become PWild — the first\n    // float arm then matched EVERYTHING (`match d { 0.0 => .., 1.0 => .. }`\n    // always took \"0.0\"); they are real PFloat patterns now (bit-exact via\n    // f64.eq at codegen, so 0.0 == -0.0 and NaN never matches, like `==`).\n    TMinus => match peek(tokens, pos + 1) {\n      TInt(n) => (PInt(0 - n), pos + 2),\n      TFloat(n) => (PFloat(0.0 - n), pos + 2),\n      _ => throw(\"expected number literal after '-' in pattern\")\n    },\n    TFloat(n) => (PFloat(n), pos + 1),\n    TString(s) => (PString(s), pos + 1),\n    TIdent(name) => {\n      let next_is_lbrace = match peek(tokens, pos + 1) {\n        TLBrace => true,\n        _ => false\n      }\n      if name == \"true\" {\n        (PBool(true), pos + 1)\n      }\n      else if name == \"false\" {\n        (PBool(false), pos + 1)\n      }\n      else if name == \"_\" {\n        (PWild, pos + 1)\n      }\n      else if name == \"record\" && next_is_lbrace {\n        let mut rp = pos + 2\n        let field_pats_b = ArrayBuilder::new()\n        let mut rd = true\n        while rd {\n          match peek(tokens, rp) {\n            TRBrace => {\n              rd = false\n            },\n            TIdent(fname) => {\n              match peek(tokens, rp + 1) {\n                TColon => {\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\n                  ArrayBuilder::push(field_pats_b, fp)\n                  rp = fnext\n                },\n                TComma => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                TRBrace => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                },\n                _ => {\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\n                }\n              }\n              match peek(tokens, rp) {\n                TComma => {\n                  rp = rp + 1\n                },\n                _ => ()\n              }\n            },\n            _ => {\n              rp = rp + 1\n            }\n          }\n        }\n        let rp2 = rp + 1\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\n      }\n      else {\n        let fc = String::char_code_at(name, 0)\n        if fc >= 65 && fc <= 90 {\n          match peek(tokens, pos + 1) {\n            TLParen => {\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\n              (PCtor(name, args), end)\n            },\n            TDoubleColon => match peek(tokens, pos + 2) {\n              TLBrace => {\n                let mut sp = pos + 3\n                let field_pats = ArrayBuilder::new()\n                let mut sd = true\n                while sd {\n                  match peek(tokens, sp) {\n                    TRBrace => {\n                      sd = false\n                    },\n                    TIdent(fname) => {\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\n                      sp = sp + 1\n                      match peek(tokens, sp) {\n                        TComma => {\n                          sp = sp + 1\n                        },\n                        _ => ()\n                      }\n                    },\n                    _ => {\n                      sd = false\n                    }\n                  }\n                }\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\n              },\n              // #742: qualified variant pattern `Enum::Variant(..)` /\n              // `Enum::Variant`. The qualifier is dropped, mirroring the\n              // expression side (#672): codegen's ctor table is keyed\n              // unqualified, and handle-arm dispatch re-prefixes the effect\n              // name onto a bare op pattern, so `Fs::ReadFile(p)` in a\n              // `with Fs` arm also lands on the same name it does today.\n              TIdent(vname) => {\n                let vc = String::char_code_at(vname, 0)\n                if vc >= 65 && vc <= 90 {\n                  match peek(tokens, pos + 3) {\n                    TLParen => {\n                      let (args, end) = parse_pats_until_rparen(tokens, pos + 4);\n                      (PCtor(vname, args), end)\n                    },\n                    _ => (PCtor(vname, empty_pats()), pos + 3)\n                  }\n                } else {\n                  (PCtor(name, empty_pats()), pos + 1)\n                }\n              },\n              _ => (PCtor(name, empty_pats()), pos + 1)\n            },\n            _ => (PCtor(name, empty_pats()), pos + 1)\n          }\n        } else (PBind(name), pos + 1)\n      }\n    },\n    TLParen => match peek(tokens, pos + 1) {\n      TRParen => (PTuple(empty_pats()), pos + 2),\n      _ => {\n        let (f, n1) = parse_pattern(tokens, pos + 1)\n        match peek(tokens, n1) {\n          TRParen => (f, n1 + 1),\n          TComma => {\n            let b = ArrayBuilder::new()\n            ArrayBuilder::push(b, f)\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\n            (PTuple(rest), end)\n          },\n          _ => throw(\"expected ')' or ',' in pattern\")\n        }\n      }\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"unexpected in pattern: \\{actual}\")\n    }\n  }\n  match peek(tokens, next) {\n    TBitOr => {\n      let (right, end) = parse_pattern(tokens, next + 1);\n      (POr(pat, right), end)\n    },\n    _ => (pat, next)\n  }\n}\n\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nexport let skip_braced_body: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBrace => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\n// Parse `Bound + Bound2 + ...` (one type parameter's bound trait names) in a\n// method-level `[X: Bound]` binder. Local equivalent of parser_expr's\n// `parse_type_param_bound_names` (not visible from parser_base).\nlet parse_method_tp_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\n// Parse a method-level `[X: Bound, Y, ...]` binder (the first param name token\n// is at `pos`, the `[` already consumed). Local equivalent of parser_expr's\n// `parse_let_type_params`. Returns (type-param names, per-param bounds, next\n// position after `]`).\nlet parse_method_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in method type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_trait_methods: (Array[Token], Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let sigs_b = ArrayBuilder::new()\n      let gens_b = ArrayBuilder::new()\n      let mut p = pos + 1\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(method_name) => {\n            // Optional `:` after the method name, so both\n            // `m(Self) -> R` and `m: [X: Bound](Self, X) -> R` parse (#684).\n            let after_colon = match peek(tokens, p + 1) {\n              TColon => p + 2,\n              _ => p + 1\n            }\n            // Optional method-level generic binder `[X: Bound]`, declared on the\n            // trait method only (rank-1 method generics, #684). The impl never\n            // repeats it; the desugar reattaches it to the impl's free function.\n            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {\n              TLBracket => parse_method_type_params(tokens, after_colon + 1),\n              _ => (_no_tp(), _no_tb(), after_colon)\n            }\n            let (params, after_method_params) = match peek(tokens, after_binder) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), after_binder)\n            }\n            let arrow_pos = expect_tk(tokens, after_method_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))\n            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected trait method signature or '}'\")\n        }\n      }\n      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)\n    },\n    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)\n  }\n}\n\nlet parse_trait_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  let empty_strings = Array::slice([\n    \"_\"\n  ], 0, 0)\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      // Optional type-parameter header `trait Iterator[T] { ... }`. Consumed\n      // and discarded — the uniform tagged representation erases type params, so\n      // the element type T only constrains the method signatures (#636).\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      match peek(tokens, after_name) {\n        TColon => {\n          let supers = empty_strings\n          let mut p = after_name + 1\n          let mut done = false\n          while !done {\n            match peek(tokens, p) {\n              TIdent(sname) => match peek(tokens, p + 1) {\n                TPlus => {\n                  Array::push(supers, sname)\n                  p = p + 2\n                },\n                _ => {\n                  Array::push(supers, sname)\n                  p = p + 1\n                  done = true\n                }\n              },\n              _ => {\n                done = true\n              }\n            }\n          }\n          let np = p\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)\n          (STrait(exported, name, supers, methods, method_gens), body_end)\n        },\n        _ => {\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)\n          (STrait(exported, name, empty_strings, methods, method_gens), body_end)\n        }\n      }\n    },\n    _ => throw(\"expected trait name\")\n  }\n}\n\nlet is_expr_end_token: (Token) -> Bool = (tok) -> {\n  match tok {\n    TInt(_) => true,\n    TFloat(_) => true,\n    TString(_) => true,\n    TStringInterp(_) => true,\n    TIdent(_) => true,\n    TRParen => true,\n    TRBracket => true,\n    TRBrace => true,\n    _ => false\n  }\n}\n\nlet is_non_pipe_infix: (Token) -> Bool = (tok) -> {\n  match tok {\n    TOr => true,\n    TAnd => true,\n    TEqEq => true,\n    TNeq => true,\n    TLt => true,\n    TLte => true,\n    TGt => true,\n    TGte => true,\n    TBitOr => true,\n    TBitXor => true,\n    TBitAnd => true,\n    TLShift => true,\n    TRShift => true,\n    TPlus => true,\n    TMinus => true,\n    TStar => true,\n    TSlash => true,\n    TPercent => true,\n    _ => false\n  }\n}\n\nlet parse_import_item: (Array[Token], Int) -> ((String, Option[String]), Int) with { Error } = (tokens, pos) -> {\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\n    match peek(tokens, name_pos) {\n      TIdent(name) => {\n        let (base, after) = match peek(tokens, name_pos + 1) {\n          TDoubleColon => match peek(tokens, name_pos + 2) {\n            TIdent(member) =>\n            (String::concat(name, String::concat(\"::\", member)), name_pos + 3),\n            _ => throw(\"expected qualified member name after '::'\")\n          },\n          _ => (name, name_pos + 1)\n        }\n        match peek(tokens, after) {\n          TAs => match peek(tokens, after + 1) {\n            TIdent(alias) => ((base, Some(alias)), after + 2),\n            _ => throw(\"expected alias name after 'as'\")\n          },\n          _ => ((base, None), after)\n        }\n      },\n      _ => throw(\"expected import item name\")\n    }\n  }\n  match peek(tokens, pos) {\n    TIdent(_) => parse_import_name(pos),\n    TType => parse_import_name(pos + 1),\n    TTrait => parse_import_name(pos + 1),\n    _ => throw(\"expected import item name\")\n  }\n}\n\nlet empty_import_items: () -> Array[(String, Option[String])] = () -> {\n  Array::slice([\n    (\"_\", None)\n  ], 0, 0)\n}\n\nlet parse_binding_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (String::concat(name, String::concat(\"::\", member)), pos + 3),\n        _ => throw(\"expected qualified member name after '::'\")\n      },\n      _ => (name, pos + 1)\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\nlet rec collect_import_path: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\n  match peek(tokens, pos) {\n    TLBrace => (acc, pos),\n    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, \".\")),\n    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, \"..\")),\n    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, \"/\")),\n    TIdent(name) => collect_import_path(tokens, pos + 1, String::concat(acc, name)),\n    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, \"-\")),\n    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, \"module\")),\n    TImpl => collect_import_path(tokens, pos + 1, String::concat(acc, \"impl\")),\n    TType => collect_import_path(tokens, pos + 1, String::concat(acc, \"type\")),\n    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, \"match\")),\n    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, \"test\")),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(String::concat(\"unexpected token in import path: \", actual))\n    }\n  }\n}\n\nlet skip_bracketed_args: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let mut bp = pos + 1\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, bp) {\n          TLBracket => {\n            depth = depth + 1\n            bp = bp + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n            bp = bp + 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => {\n            bp = bp + 1\n          }\n        }\n      }\n      bp\n    },\n    _ => pos\n  }\n}\n\nlet rec collect_effect_names: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\n  match peek(tokens, pos) {\n    TRBrace => (acc, pos + 1),\n    TIdent(name) => {\n      let new_acc = if String::length(acc) == 0 {\n        name\n      } else \"\\{acc}, \\{name}\"\n      match peek(tokens, pos + 1) {\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\n        TRBrace => (new_acc, pos + 2),\n        _ => throw(\"expected ',' or '}' in effect list\")\n      }\n    },\n    _ => throw(\"expected effect name or '}'\")\n  }\n}\n\nlet rec parse_type_impl: (Array[Token], Int, Int) -> (TypeExpr, Int) with { Error } = (tokens, pos, mode) -> {\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n    match peek(tokens, pos) {\n      TComma => match peek(tokens, pos + 1) {\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let ts = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\n          ArrayBuilder::push(b, ty)\n          type_list_rest(tokens, next, b)\n        }\n      }\n      ,\n      _ => (ArrayBuilder::freeze(b), pos)\n    }\n  }\n  // The optional `with { E1, E2 }` effect row after a function type's return.\n  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {\n    match peek(tokens, rn) {\n      TWith => {\n        let with_pos = expect_tk(tokens, rn + 1, \"{\")\n        let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n        (Some(effect_name_pair.0), effect_name_pair.1)\n      },\n      _ => (None, rn)\n    }\n  }\n  if mode == 0 {\n    // Leading-paren handling parses the group's TOP-LEVEL elements with arity\n    // preserved, so a function parameter list is read by element count rather\n    // than by reinterpreting a (already-unwrapped) tuple atom. This keeps\n    // `(A, B) -> R` (two params) distinct from `((A, B)) -> R` (one tuple\n    // param): the latter's outer group has a single element `(A, B)`. (#664-adjacent\n    // type-annotation fix: previously both flattened to a two-param list.)\n    match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => {\n          // `()` — empty group: a zero-param function `() -> R`, else Unit.\n          let after = pos + 2\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)\n            },\n            _ => (TyUnit, after)\n          }\n        },\n        _ => {\n          // A first element may be a labeled param (`x: T` / `x~: T` / `x?: T`);\n          // skip the label so the element's TYPE is what gets recorded.\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          let (elems, after) = match peek(tokens, n1) {\n            TRParen => ([\n              first\n            ], n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (rest, en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n          match peek(tokens, after) {\n            TThinArrow => {\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\n              let eff = parse_effect_suffix(tokens, rn)\n              (TyFn(elems, ret, eff.0), eff.1)\n            },\n            _ => {\n              // Not a function: a single element is a parenthesized type (the\n              // parens are just grouping); two or more elements are a tuple.\n              let atom = if Array::length(elems) == 1 {\n                Array::get(elems, 0)\n              } else {\n                TyTuple(elems)\n              }\n              match peek(tokens, after) {\n                TQuestion => (TyApp(\"Option\", [\n                  atom\n                ]), after + 1),\n                _ => (atom, after)\n              }\n            }\n          }\n        }\n      },\n      _ => {\n        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\n        match peek(tokens, atom_next) {\n          TThinArrow => {\n            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\n            let eff = parse_effect_suffix(tokens, rn)\n            (TyFn([\n              atom_ty\n            ], ret, eff.0), eff.1)\n          },\n          _ => (atom_ty, atom_next)\n        }\n      }\n    }\n  } else {\n    let (base_ty, base_next) = match peek(tokens, pos) {\n      TLParen => match peek(tokens, pos + 1) {\n        TRParen => (TyUnit, pos + 2),\n        _ => {\n          let ty_start = match peek(tokens, pos + 1) {\n            TIdent(_) => match peek(tokens, pos + 2) {\n              TColon => pos + 3,\n              TTilde => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              TQuestion => match peek(tokens, pos + 3) {\n                TColon => pos + 4,\n                _ => pos + 1\n              },\n              _ => pos + 1\n            },\n            _ => pos + 1\n          }\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\n          match peek(tokens, n1) {\n            TRParen => (first, n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \")\");\n              (TyTuple(rest), en)\n            },\n            _ => throw(\"expected ')' or ',' in type\")\n          }\n        }\n      },\n      TIdent(name) => match peek(tokens, pos + 1) {\n        TLBracket => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          match peek(tokens, n1) {\n            TRBracket => (TyApp(name, [\n              first\n            ]), n1 + 1),\n            TComma => {\n              let b = ArrayBuilder::new()\n              ArrayBuilder::push(b, first)\n              let (rest, end) = type_list_rest(tokens, n1, b)\n              let en = expect_tk(tokens, end, \"]\");\n              (TyApp(name, rest), en)\n            },\n            _ => throw(\"expected ']' or ',' in type application\")\n          }\n        },\n        _ => (TyName(name), pos + 1)\n      },\n      _ => {\n        let actual = tk_name(peek(tokens, pos))\n        throw(\"expected type but got \\{actual}\")\n      }\n    }\n    match peek(tokens, base_next) {\n      TQuestion => (TyApp(\"Option\", [\n        base_ty\n      ]), base_next + 1),\n      _ => (base_ty, base_next)\n    }\n  }\n}\n\nexport let parse_type: (Array[Token], Int) -> (TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  parse_type_impl(tokens, pos, 0)\n}\n\nlet parse_one_param: (Array[Token], Int) -> ((String, Option[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TTilde => {\n        let labeled_name = \"\\{name}~\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((labeled_name, Some(ty)), tp)\n          },\n          _ => ((labeled_name, None), pos + 2)\n        }\n      },\n      TQuestion => {\n        let opt_name = \"\\{name}?\"\n        match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\n            ((opt_name, Some(ty)), tp)\n          },\n          _ => ((opt_name, None), pos + 2)\n        }\n      },\n      TColon => {\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\n        let tp2 = match peek(tokens, tp) {\n          TColon => {\n            let mut bp = tp + 1\n            let mut bd = true\n            while bd {\n              match peek(tokens, bp) {\n                TIdent(_) => {\n                  bp = bp + 1; match peek(tokens, bp) {\n                    TPlus => {\n                      bp = bp + 1\n                    },\n                    _ => {\n                      bd = false\n                    }\n                  }\n                },\n                _ => {\n                  bd = false\n                }\n              }\n            }\n            bp\n          },\n          _ => tp\n        }\n        ((name, Some(ty)), tp2)\n      },\n      _ => ((name, None), pos + 1)\n    },\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected parameter name at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nlet rec parse_param_cont: (Array[Token], Int, ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => match peek(tokens, pos + 1) {\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (p, pn) = parse_one_param(tokens, pos + 1)\n        ArrayBuilder::push(b, p)\n        parse_param_cont(tokens, pn, b)\n      }\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => {\n      let actual = tk_name(peek(tokens, pos))\n      throw(\"expected ',' or ')' in param list at #\\{pos} token=\\{actual}\")\n    }\n  }\n}\n\nlet parse_param_list: (Array[Token], Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRParen => (empty_params(), pos + 1),\n    _ => {\n      let (f, fn1) = parse_one_param(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, f)\n      parse_param_cont(tokens, fn1, b)\n    }\n  }\n}\n\nlet parse_struct_field: (Array[Token], Int) -> ((String, TypeExpr), Bool, Int) with { Error } = (tokens, pos) -> {\n  let (is_mut, p) = match peek(tokens, pos) {\n    TMut => (true, pos + 1),\n    _ => (false, pos)\n  }\n  match peek(tokens, p) {\n    TIdent(name) => {\n      let cn = expect_tk(tokens, p + 1, \":\")\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\n      ((name, ty), is_mut, next)\n    },\n    _ => throw(\"expected field name\")\n  }\n}\n\nlet rec is_lambda_start_impl: (Array[Token], Int, Int, Int, Bool) -> Bool = (tokens, pos, depth, bdepth, has_colon) -> {\n  match peek(tokens, pos) {\n    // A colon only signals an annotated lambda param when it sits directly\n    // inside the candidate parens — a colon inside BRACKETS is a slice bound\n    // (`raw_path[0: 2]`), and counting it made `(len >= 2 && s[0: 2] == x) {`\n    // (a parenthesized if-condition followed by the if body's brace) parse as\n    // a no-arrow lambda, failing with \"expected ',' or ')' in param list\".\n    TColon => if depth == 0 && bdepth == 0 {\n      is_lambda_start_impl(tokens, pos + 1, depth, bdepth, true)\n    } else is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon),\n    TRParen => if depth == 0 {\n      match peek(tokens, pos + 1) {\n        TThinArrow => true,\n        TLBrace => has_colon,\n        _ => false\n      }\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, bdepth, has_colon),\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, bdepth, has_colon),\n    TLBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth + 1, has_colon),\n    TRBracket => is_lambda_start_impl(tokens, pos + 1, depth, bdepth - 1, has_colon),\n    TEof => false,\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, bdepth, has_colon)\n  }\n}\n\nlet is_lambda_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\n  is_lambda_start_impl(tokens, pos, 0, 0, false)\n}\n\nlet rec parse_ctor_types_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, ty)\n      parse_ctor_types_rest(tokens, next, b)\n    },\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ',' or ')' in constructor types\")\n  }\n}\n\nlet parse_enum_ctor: (Array[Token], Int) -> ((String, Array[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => ((name, empty_type_exprs()), pos + 3),\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\n          ((name, types), end)\n        }\n      },\n      _ => ((name, empty_type_exprs()), pos + 1)\n    },\n    _ => throw(\"expected constructor name\")\n  }\n}\n\nlet rec parse_enum_ctors_rest: (Array[Token], Int, ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\n      _ => {\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\n        ArrayBuilder::push(b, ctor)\n        parse_enum_ctors_rest(tokens, next, b)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in enum\")\n  }\n}\n\nlet parse_enum_ctors: (Array[Token], Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_ctors(), pos + 1),\n    _ => {\n      let (first, next) = parse_enum_ctor(tokens, pos)\n      let b = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      parse_enum_ctors_rest(tokens, next, b)\n    }\n  }\n}\n\nlet parse_enum_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => {\n          let b = ArrayBuilder::new()\n          let mut skip = pos + 2\n          let mut depth = 1\n          let mut expect_name = true\n          while depth > 0 {\n            match peek(tokens, skip) {\n              TLBracket => {\n                depth = depth + 1; skip = skip + 1\n              },\n              TRBracket => {\n                depth = depth - 1; skip = skip + 1\n              },\n              TComma => {\n                if depth == 1 {\n                  expect_name = true\n                }\n                skip = skip + 1\n              },\n              TIdent(nm) => {\n                if depth == 1 && expect_name {\n                  ArrayBuilder::push(b, nm)\n                  expect_name = false\n                }\n                skip = skip + 1\n              },\n              _ => {\n                skip = skip + 1\n              }\n            }\n          }\n          (ArrayBuilder::freeze(b), skip)\n        },\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (ctors, end) = parse_enum_ctors(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SEnum(exported, name, params, ctors, derives), final_pos)\n    },\n    _ => throw(\"expected enum name\")\n  }\n}\n\nlet parse_suberror_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TLParen => match peek(tokens, pos + 2) {\n        TRParen => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\n        },\n        _ => {\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\n          let args_b = ArrayBuilder::new()\n          ArrayBuilder::push(args_b, first)\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\n          let ctors_b = ArrayBuilder::new()\n          ArrayBuilder::push(ctors_b, (name, args))\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\n        }\n      },\n      TLBrace => {\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\n        (SSuberror(exported, name, ctors), end)\n      },\n      _ => throw(\"expected '(' or '{' after suberror name\")\n    },\n    _ => throw(\"expected suberror name\")\n  }\n}\n\nlet parse_impl_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_impl_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in impl type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_impl_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\n    _ => (_no_tp(), _no_tb(), pos)\n  }\n  match peek(tokens, after_tp) {\n    TIdent(trait_name) => {\n      let fp = expect_tk(tokens, after_tp + 1, \"for\")\n      match peek(tokens, fp) {\n        TIdent(type_name) => {\n          // Return the position at the impl body `{` (or the next token when\n          // the impl is body-less). The caller (parser.vibe) either expands the\n          // method block into `Type::method` let-bindings or skips it; this\n          // parser layer cannot reach `parse_expr` to parse method bodies.\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\n          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)\n        },\n        _ => throw(\"expected type name after 'for'\")\n      }\n    },\n    _ => throw(\"expected trait name after 'impl'\")\n  }\n}\n\nlet parse_type_params_list: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\n// Parse effect declaration: effect Name[T] { Op(Args) -> Ret; ... }\nlet parse_effect_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\n      }\n      let br = expect_tk(tokens, after_params, \"{\")\n      let ops_b = ArrayBuilder::new()\n      let mut p = br\n      while true {\n        match peek(tokens, p) {\n          TRBrace => {\n            p = p + 1\n            break\n          },\n          TIdent(op_name) => {\n            let (params, after_op_params) = match peek(tokens, p + 1) {\n              TLParen => {\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\n                let params = match params_ty {\n                  TyUnit => empty_type_exprs(),\n                  TyTuple(elems) => elems,\n                  _ => [\n                    params_ty\n                  ]\n                }\n                (params, after_paren)\n              },\n              _ => (empty_type_exprs(), p + 1)\n            }\n            let arrow_pos = expect_tk(tokens, after_op_params, \"->\")\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\n            p = match peek(tokens, after_ret) {\n              TSemicolon => after_ret + 1,\n              _ => after_ret\n            }\n          },\n          _ => throw(\"expected effect operation name or '}'\")\n        }\n      }\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\n    },\n    _ => throw(\"expected effect name\")\n  }\n}\n\nlet parse_type_alias_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let (params, after_name) = match peek(tokens, pos + 1) {\n        TLBracket => parse_type_params_list(tokens, pos + 2),\n        _ => (Array::slice([\n          \"\"\n        ], 0, 0), pos + 1)\n      }\n      let ep = expect_tk(tokens, after_name, \"=\")\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\n      (STypeAlias(exported, name, params, ty), next)\n    },\n    _ => throw(\"expected type alias name\")\n  }\n}\n\nlet parse_impl_stmt_dispatch: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\n  parse_impl_stmt(tokens, pos)\n}\n\nlet push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {\n  if is_mut {\n    let (fname, _) = field\n    ArrayBuilder::push(mb, fname)\n  } else {\n    ()\n  }\n}\n\nlet rec parse_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        push_mut_name(mb, field, is_mut)\n        parse_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TComma => match peek(tokens, pos + 1) {\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\n      _ => {\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\n        ArrayBuilder::push(b, field)\n        push_mut_name(mb, field, is_mut)\n        parse_struct_fields_rest(tokens, next, b, mb)\n      }\n    },\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\n    _ => throw(\"expected ';', ',' or '}' in struct\")\n  }\n}\n\nlet parse_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TRBrace => (empty_fields(), Array::slice([\n      \"\"\n    ], 0, 0), pos + 1),\n    _ => {\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\n      let b = ArrayBuilder::new()\n      let mb = ArrayBuilder::new()\n      ArrayBuilder::push(b, first)\n      push_mut_name(mb, first, is_mut)\n      parse_struct_fields_rest(tokens, next, b, mb)\n    }\n  }\n}\n\nlet parse_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => {\n      let after_name = skip_bracketed_args(tokens, pos + 1)\n      let br = expect_tk(tokens, after_name, \"{\")\n      let (fields, mut_names, end) = parse_struct_fields(tokens, br);\n      let (derives, final_pos) = parse_derive_names(tokens, end)\n      (SStruct(exported, name, fields, derives, mut_names), final_pos)\n    },\n    _ => throw(\"expected struct name\")\n  }\n}\n\n//# Misc\n\nexport {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, parse_derive_names, peek, skip_derive, skip_semi, tk_name\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, parse_derive_names, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n\nexport {\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, parse_derive_names, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")
}

let cli_adapter_source_13 = () -> (String, String) {
  ("vibe/compiler/syntax/parser_expr.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Stmt, TypeExpr\n}\n\nimport ./parser_base.vibe {\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, mode_block, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, skip_braced_body, tk_name\n}\n\nimport ./parser_expr_core.vibe {\n  parse_infix\n}\n\nimport ./parser_expr_dispatch.vibe {\n  parse_impl_dispatch\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nexport let parse_impl: (Array[Token], Array[Int], Int, Int) -> (Expr, Int) with { Error } = (tokens, starts, pos, mode) -> {\n  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {\n    if rmode >= 0 && rmode <= 10 {\n      parse_infix(rtoks, starts, rpos, rmode, rpos, parse_recur)\n    } else {\n      parse_impl_dispatch(rtoks, starts, rpos, rmode, parse_recur)\n    }\n  }\n  parse_recur(tokens, pos, mode)\n}\n\nexport let parse: (Array[Token]) -> Expr with { Error } = (tokens) -> {\n  let (e, next) = parse_impl(tokens, [], 0, 0)\n  match peek(tokens, next) {\n    TEof => e,\n    _ => {\n      let actual = tk_name(peek(tokens, next))\n      throw(\"unexpected after expression: \\{actual}\")\n    }\n  }\n}\n\nexport let parse_ok: (Array[Token]) -> Bool = (tokens) -> {\n  handle {\n    let _ = parse(tokens)\n    true\n  } with Error {\n    Throw(_) => false\n  }\n}\n\nexport let parse_expr: (Array[Token], Int) -> (Expr, Int) with { Error } = (tokens, pos) -> {\n  parse_impl(tokens, [], pos, 0)\n}\n\nlet parse_type_param_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\n  let b = ArrayBuilder::new()\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TIdent(name) => {\n        ArrayBuilder::push(b, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TPlus => {\n            p = p + 1\n          },\n          _ => {\n            done = true\n          }\n        }\n      },\n      _ => throw(\"expected trait bound name\")\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet parse_let_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let names = ArrayBuilder::new()\n  let bounds = ArrayBuilder::new()\n  let mut p = pos\n  while true {\n    match peek(tokens, p) {\n      TRBracket => {\n        p = p + 1\n        break\n      },\n      TIdent(name) => {\n        ArrayBuilder::push(names, name)\n        p = p + 1\n        match peek(tokens, p) {\n          TColon => {\n            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)\n            ArrayBuilder::push(bounds, (name, bound_names))\n            p = next\n          },\n          _ => ()\n        }\n        match peek(tokens, p) {\n          TComma => {\n            p = p + 1\n          },\n          TRBracket => {\n            p = p + 1\n            break\n          },\n          _ => throw(\"expected ',' or ']' in type params\")\n        }\n      },\n      _ => throw(\"expected type parameter name or ']'\")\n    }\n  }\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\n}\n\nlet parse_let_annotation: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => {\n      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)\n      let (ty, next) = parse_type_impl(tokens, after_params, 0)\n      (type_params, type_bounds, ty, next)\n    },\n    _ => {\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\n      (_no_tp(), _no_tb(), ty, next)\n    }\n  }\n}\n\nlet apply_fn_annotation_params: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, param_types) -> {\n  if Array::length(params) != Array::length(param_types) {\n    params\n  } else {\n    let out = ArrayBuilder::new()\n    let mut i = 0\n    while i < Array::length(params) {\n      let (name, ann) = Array::get(params, i)\n      let next_ann = match ann {\n        Some(_) => ann,\n        None => Some(Array::get(param_types, i))\n      }\n      ArrayBuilder::push(out, (name, next_ann))\n      i = i + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\nlet apply_generic_fn_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr, Array[TypeExpr], TypeExpr, Option[String]) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val, param_types, ret_ty, effect_name) -> {\n  match val {\n    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {\n      let next_params = apply_fn_annotation_params(params, param_types)\n      let next_ret = match ret_opt {\n        Some(_) => ret_opt,\n        None => Some(ret_ty)\n      }\n      let next_effect = match effect_opt {\n        Some(_) => effect_opt,\n        None => effect_name\n      }\n      let next_type_params = if Array::length(type_params) > 0 {\n        type_params\n      } else existing_type_params\n      let next_type_bounds = if Array::length(type_params) > 0 {\n        type_bounds\n      } else existing_type_bounds\n      let next_ann = if Array::length(type_params) > 0 {\n        None\n      } else ann\n      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))\n    },\n    _ => (ann, val)\n  }\n}\n\nlet apply_generic_let_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val) -> {\n  match ann {\n    Some(ann_ty) => match ann_ty {\n      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),\n      _ => (ann, val)\n    },\n    _ => (ann, val)\n  }\n}\n\n// Inject a value-position type-parameter header `[T: Ord]` (from\n// `let f = [T: Ord](...)`) into the resulting lambda's EFn type_params/bounds.\n// Previously these were skipped and discarded, so the lambda had no type\n// params: the body checked with `T` as a concrete `CtNamed(\"T\")` rather than a\n// bound type variable. That happened to work standalone (unresolved type names\n// are tolerated) but broke once the module was re-exported and re-checked.\nlet apply_value_bracket_type_params: (Array[String], Array[(String, Array[String])], Expr) -> Expr = (tps, tbs, val) -> {\n  if Array::length(tps) == 0 {\n    val\n  } else {\n    match val {\n      EFn(existing_tp, existing_tb, params, ret, eff, body) => {\n        let next_tp = if Array::length(existing_tp) > 0 {\n          existing_tp\n        } else tps\n        let next_tb = if Array::length(existing_tp) > 0 {\n          existing_tb\n        } else tbs\n        EFn(next_tp, next_tb, params, ret, eff, body)\n      },\n      _ => val\n    }\n  }\n}\n\nlet skip_generic_value_start: (Array[Token], Int) -> Int = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBracket => match peek(tokens, pos + 1) {\n      TIdent(_) => {\n        let maybe_generic = match peek(tokens, pos + 2) {\n          TRBracket => match peek(tokens, pos + 3) {\n            TLParen => true,\n            _ => false\n          },\n          TColon => true,\n          TComma => true,\n          _ => false\n        }\n        if maybe_generic {\n          let mut scan_pos = pos + 1\n          let mut depth = 1\n          while depth > 0 {\n            match peek(tokens, scan_pos) {\n              TLBracket => {\n                depth = depth + 1\n              },\n              TRBracket => {\n                depth = depth - 1\n              },\n              _ => ()\n            }\n            scan_pos = scan_pos + 1\n          }\n          scan_pos\n        } else {\n          pos\n        }\n      },\n      _ => pos\n    },\n    _ => pos\n  }\n}\n\n// Parse a value-position generic header `[T: Ord]` at `pos` (just after `=`)\n// when one is present, returning its type params/bounds plus the position of\n// the value that follows. When there is no generic header (e.g. an array\n// literal `[1, 2]`), returns empty params and `pos` unchanged.\nlet parse_value_bracket_header: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\n  let skipped = skip_generic_value_start(tokens, pos)\n  if skipped == pos {\n    (_no_tp(), _no_tb(), pos)\n  } else {\n    match peek(tokens, pos) {\n      TLBracket => {\n        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)\n        (tps, tbs, skipped)\n      },\n      _ => (_no_tp(), _no_tb(), skipped)\n    }\n  }\n}\n\nlet parse_let_stmt: (Array[Token], Array[Int], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, starts, pos, exported) -> {\n  match peek(tokens, pos) {\n    TRec => {\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\n      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n        TColon => {\n          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n          (tparams, tbounds, Some(ty), tp)\n        },\n        _ => (_no_tp(), _no_tb(), None, name_next)\n      }\n      let ep = expect_tk(tokens, eq_pos, \"=\")\n      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)\n      let val_pair = parse_impl(tokens, starts, val_start_r, 0)\n      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n      let val_next = val_pair.1\n      (SLet(exported, true, name, final_ty_opt, val), val_next)\n    },\n    TMut => match peek(tokens, pos + 1) {\n      TIdent(name) => {\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\n          TColon => {\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\n            (Some(ty), tp)\n          },\n          _ => (None, pos + 2)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let val_pair = parse_impl(tokens, starts, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetMut(name, ty_opt, val), val_next)\n      },\n      _ => throw(\"expected name after 'let mut'\")\n    },\n    TLParen => {\n      let (pat, pat_next) = parse_pattern(tokens, pos)\n      let ep = expect_tk(tokens, pat_next, \"=\")\n      let val_pair = parse_impl(tokens, starts, ep, 0)\n      let val = val_pair.0\n      let val_next = val_pair.1\n      (SLetPat(pat, val), val_next)\n    },\n    TIdent(_name0) => {\n      let is_struct_destructure = match peek(tokens, pos + 1) {\n        TDoubleColon => match peek(tokens, pos + 2) {\n          TLBrace => true,\n          _ => false\n        },\n        _ => false\n      }\n      if is_struct_destructure {\n        let (pat, pat_next) = parse_pattern(tokens, pos)\n        let ep = expect_tk(tokens, pat_next, \"=\")\n        let val_pair = parse_impl(tokens, starts, ep, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        (SLetPat(pat, val), val_next)\n      } else {\n        let (name, name_next) = parse_binding_name(tokens, pos)\n        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\n          TColon => {\n            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\n            (tparams, tbounds, Some(ty), tp)\n          },\n          _ => (_no_tp(), _no_tb(), None, name_next)\n        }\n        let ep = expect_tk(tokens, eq_pos, \"=\")\n        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)\n        let val_pair = parse_impl(tokens, starts, val_start, 0)\n        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\n        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\n        let val_next = val_pair.1\n        (SLet(exported, false, name, final_ty_opt, val), val_next)\n      }\n    },\n    _ => throw(\"expected name after 'let'\")\n  }\n}\n\n// #727 (ADR-0064 Phase A): top-level `fn` sugar.\n//   fn name[T: Eq](x: Int, y: Int) -> Int with { E } where { ... } { body }\n// desugars to the same SLet + EFn shape impl methods lower to\n// (SLet(exported, rec, name, None, EFn(tps, tbs, params, Some(ret), eff, body))),\n// so checker/codegen are untouched. Full annotations are required (every\n// param typed + explicit return type): ADR-0037's forward-reference\n// conditions then always hold, so the binding is always `rec`. The\n// `where { ... }` contract clause is brace-balance skipped for now —\n// retention + assert semantics land with Phase E (#731); until then\n// fmt/normalize reject it (same guardrail pattern as #cfg, ADR-0061).\n// Shared fn-signature head: `name[T: Eq](x: Int, y: Int) -> Ret with { E }\n// where { ... }` starting AFTER the `fn` keyword. Returns\n// ((name, tps, tbs), (params, ret_ty, eff_opt), (requires, ensures), next)\n// with `next` positioned after the where clause — at the body `{` for a\n// definition, or at the following statement for a .vibei contract\n// declaration (#729). The `where { requires: e, ensures: e }` contract\n// clause (#731, ADR-0064 §7) parses each condition as an ordinary Bool\n// expression; `ensures` conditions may reference the function result as\n// `result`. Multiple requires/ensures entries are allowed.\nexport let parse_fn_signature: (Array[Token], Int) -> ((String, Array[String], Array[(String, Array[String])]), (Array[(String, Option[TypeExpr])], TypeExpr, Option[String]), (Array[Expr], Array[Expr]), Int) with { Error } = (tokens, pos) -> {\n  let (name, name_next) = parse_binding_name(tokens, pos)\n  let (tps, tbs, after_gen) = parse_value_bracket_header(tokens, name_next)\n  let lp = expect_tk(tokens, after_gen, \"(\")\n  let (params, after_params) = parse_param_list(tokens, lp)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let param = Array::get(params, pi)\n    let pty = param.1\n    match pty {\n      Some(_) => (),\n      None => throw(\"fn parameter '\\{param.0}' requires a type annotation\")\n    }\n    pi = pi + 1\n  }\n  let arrow = expect_tk(tokens, after_params, \"->\")\n  let (ret_ty, ret_next) = parse_type_impl(tokens, arrow, 0)\n  let (eff_opt, eff_next) = match peek(tokens, ret_next) {\n    TWith => {\n      let wb = expect_tk(tokens, ret_next + 1, \"{\")\n      let (eff_names, en) = collect_effect_names(tokens, wb, \"\")\n      (Some(eff_names), en)\n    },\n    _ => (None, ret_next)\n  }\n  let reqs = Array::slice([\n    EIdent(\"\", 0 - 1)\n  ], 0, 0)\n  let enss = Array::slice([\n    EIdent(\"\", 0 - 1)\n  ], 0, 0)\n  let where_next = match peek(tokens, eff_next) {\n    TIdent(w) => if w == \"where\" {\n      let mut wp = expect_tk(tokens, eff_next + 1, \"{\")\n      let mut wdone = false\n      while !wdone {\n        match peek(tokens, wp) {\n          TRBrace => {\n            wp = wp + 1\n            wdone = true\n          },\n          TIdent(kind) => {\n            let cp = expect_tk(tokens, wp + 1, \":\")\n            let (cond, cnext) = parse_impl(tokens, [], cp, 0)\n            if kind == \"requires\" {\n              Array::push(reqs, cond)\n            } else if kind == \"ensures\" {\n              Array::push(enss, cond)\n            } else {\n              throw(\"expected 'requires' or 'ensures' in where clause, got '\\{kind}'\")\n            }\n            wp = match peek(tokens, cnext) {\n              TComma => cnext + 1,\n              _ => cnext\n            }\n          },\n          _ => throw(\"expected 'requires', 'ensures', or '}' in where clause\")\n        }\n      }\n      wp\n    } else eff_next,\n    _ => eff_next\n  }\n  ((name, tps, tbs), (params, ret_ty, eff_opt), (reqs, enss), where_next)\n}\n\nlet parse_fn_stmt: (Array[Token], Array[Int], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, starts, pos, exported) -> {\n  let (head, sig, contracts, where_next) = parse_fn_signature(tokens, pos)\n  let (name, tps, tbs) = head\n  let (params, ret_ty, eff_opt) = sig\n  let (reqs, enss) = contracts\n  let br = expect_tk(tokens, where_next, \"{\")\n  let (body, end) = parse_impl(tokens, starts, br, mode_block)\n  // #731 (ADR-0064 §7 Phase 1): where-contract desugar. requires conditions\n  // assert at entry; ensures conditions bind the body's value as `result`\n  // and assert at exit. v1 semantics are Eiffel-style ALWAYS-ON runtime\n  // checks (a violating call traps); compile-time stripping for release\n  // builds is a later refinement. Known limits (documented): an early\n  // `return` inside the body bypasses ensures; `result` shadows any\n  // user binding of that name inside ensures conditions.\n  let body_with_ensures = if Array::length(enss) == 0 {\n    body\n  } else {\n    let mut exit_expr = EIdent(\"result\", 0 - 1)\n    let mut ei = Array::length(enss)\n    while ei > 0 {\n      ei = ei - 1\n      exit_expr = ESeq(ECall(EIdent(\"assert\", 0 - 1), [\n        Array::get(enss, ei)\n      ], 0 - 1), exit_expr)\n    }\n    ELet(\"result\", body, exit_expr)\n  }\n  let mut guarded = body_with_ensures\n  let mut qi = Array::length(reqs)\n  while qi > 0 {\n    qi = qi - 1\n    guarded = ESeq(ECall(EIdent(\"assert\", 0 - 1), [\n      Array::get(reqs, qi)\n    ], 0 - 1), guarded)\n  }\n  (SLet(exported, true, name, None, EFn(tps, tbs, params, Some(ret_ty), eff_opt, guarded)), end)\n}\n\n//# Misc\n\nexport {\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_fn_stmt, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\n}\n\nexport {\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_fn_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch\n}\n")
}

let cli_adapter_source_14 = () -> (String, String) {
  ("vibe/compiler/syntax/parser_expr_primary.vibe",
"//# Imports\n\nimport .. / core {\n  Expr\n}\n\nimport ./parser_base.vibe {\n  _no_tb, _no_tp, collect_effect_names, empty_exprs, expect_tk, is_lambda_start, parse_param_list, parse_type_impl, peek, tk_name\n}\n\nimport ./token.vibe {\n  Token\n}\n\nimport ./lexer.vibe {\n  lex\n}\n\n//# Functions\n\n// Desugar a string-interpolation token's parts into a `String::concat` chain.\n// Parts alternate literal/expression by index (even = literal chunk, odd =\n// embedded expression SOURCE). The embedded expression is lexed and parsed as a\n// full expression (not treated as a bare identifier), so `\"\\{1 + 1}\"`,\n// `\"\\{f(x)}\"`, `\"\\{p.field}\"` etc. all work — matching the documented behavior.\n// Each interpolated value is rendered via `__to_string`. Bare-identifier parts\n// parse to the same `EIdent` the previous (ident-only) path produced, so\n// existing interpolations are unchanged.\nlet build_interp_expr: (Array[String], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Expr with { Error } = (parts, parse_recur) -> {\n  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {\n    ECall(EIdent(\"String::concat\", -1), [\n      a,\n      b\n    ], -1)\n  }\n  let plen = Array::length(parts)\n  let mut result = EString(\"\")\n  let mut has_val = false\n  let mut i = 0\n  while i < plen {\n    let part = Array::get(parts, i)\n    if i % 2 == 0 {\n      if String::length(part) > 0 {\n        let piece = EString(part)\n        result = if has_val {\n          concat_expr(result, piece)\n        } else {\n          piece\n        }\n        has_val = true\n      } else {\n        ()\n      }\n    } else {\n      let (pe, _) = parse_recur(lex(part), 0, 0)\n      let piece = ECall(EIdent(\"__to_string\", -1), [\n        pe\n      ], -1)\n      result = if has_val {\n        concat_expr(result, piece)\n      } else {\n        piece\n      }\n      has_val = true\n    }\n    i = i + 1\n  }\n  result\n}\n\n// Transform break(val) and continue(args) inside a loop body for desugaring.\n// break(val) → { __loop_result = val; break }\n// continue(a, b) → { let __lt0 = a; let __lt1 = b; p0 = __lt0; p1 = __lt1; continue }\nlet rec desugar_loop_body: (Expr, Array[String]) -> Expr = (expr, param_names) -> {\n  match expr {\n    EBreak(opt) => match opt {\n      Some(val) => EAssign(\"__loop_result\", desugar_loop_body(val, param_names), EBreak(None)),\n      None => EBreak(None)\n    },\n    EContinue(args) => {\n      if Array::length(args) == 0 {\n        EContinue(args)\n      } else {\n        let nargs = Array::length(args)\n        let nparams = Array::length(param_names)\n        if nargs > nparams {\n          // Guard: more args than params → use only param count to avoid OOB\n          EContinue(args)\n        } else {\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\n        let mut ci = nargs - 1\n        while ci >= 0 {\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\"__lt\", __to_string(ci)), -1), result)\n          ci = ci - 1\n        }\n        let mut ci2 = nargs - 1\n        while ci2 >= 0 {\n          result = ELet(String::concat(\"__lt\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result)\n          ci2 = ci2 - 1\n        }\n        result\n        }\n      }\n    },\n    EWhile(_, _) => expr,\n    ELoop(_, _) => expr,\n    EFn(_, _, _, _, _, _) => expr,\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\n    ELet(n, v, b) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    ELetMut(n, v, b) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    // EMatch/EHandle: pass through unchanged.\n    // Limitation: break/continue inside match/handle arms won't be desugared.\n    // The host compiler crashes on (Pat, Expr) tuple operations, preventing\n    // arms transformation. The selfhost parser (which compiles user code) handles\n    // ELoop natively via this desugaring, so this only affects programs compiled\n    // by the host-compiled selfhost. A future fix could add arms recursion when\n    // the host compiler supports Pat tuple types.\n    EMatch(_, _) => expr,\n    EHandle(_, _) => expr,\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\n    ECall(_, _, _) => expr,\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\n    EThrow(e) => EThrow(desugar_loop_body(e, param_names)),\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\n    EDot(obj, field, off) => EDot(desugar_loop_body(obj, param_names), field, off),\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\n    _ => expr\n  }\n}\n\n\nlet parse_loop_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let param_names_b = ArrayBuilder::new()\n      let param_inits_b = ArrayBuilder::new()\n      let mut cur = pos + 2\n      let mut done = false\n      while !done {\n        match peek(tokens, cur) {\n          TRParen => {\n            cur = cur + 1\n            done = true\n          },\n          TIdent(name) => {\n            let eq_pos = expect_tk(tokens, cur + 1, \"=\")\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\n            ArrayBuilder::push(param_names_b, name)\n            ArrayBuilder::push(param_inits_b, init)\n            match peek(tokens, next_pos) {\n              TComma => {\n                cur = next_pos + 1\n              },\n              TRParen => {\n                cur = next_pos + 1\n                done = true\n              },\n              _ => throw(\"expected ',' or ')' in loop params\")\n            }\n          },\n          _ => throw(\"expected loop parameter name or ')'\")\n        }\n      }\n      let body_pos = expect_tk(tokens, cur, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      // Desugar ELoop into ELetMut + EWhile\n      let pnames = ArrayBuilder::freeze(param_names_b)\n      let pinits = ArrayBuilder::freeze(param_inits_b)\n      let transformed_body = desugar_loop_body(body, pnames)\n      let while_expr = EWhile(EBool(true), transformed_body)\n      let result = ELetMut(\"__loop_result\", EInt(0),\n        ESeq(while_expr, EIdent(\"__loop_result\", -1)))\n      let mut wrapped = result\n      let mut wi = Array::length(pnames) - 1\n      while wi >= 0 {\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped)\n        wi = wi - 1\n      }\n      (wrapped, end_pos)\n    },\n    _ => {\n      let body_pos = expect_tk(tokens, pos + 1, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EWhile(EBool(true), body), end_pos)\n    }\n  }\n}\n\nlet parse_break_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EBreak(None), pos + 1),\n    TSemicolon => (EBreak(None), pos + 1),\n    TEof => (EBreak(None), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EBreak(Some(expr)), next_pos)\n    }\n  }\n}\n\nlet parse_throw_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let open_pos = expect_tk(tokens, pos + 1, \"(\")\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\n  let close_pos = expect_tk(tokens, next_pos, \")\")\n  (EThrow(expr), close_pos)\n}\n\nlet parse_return_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBrace => (EReturn(EUnit), pos + 1),\n    TSemicolon => (EReturn(EUnit), pos + 1),\n    TEof => (EReturn(EUnit), pos + 1),\n    _ => {\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\n      (EReturn(expr), next_pos)\n    }\n  }\n}\n\nlet parse_perform_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRParen => (EIdent(\"perform\", -1), pos + 1),\n    TRBracket => (EIdent(\"perform\", -1), pos + 1),\n    TRBrace => (EIdent(\"perform\", -1), pos + 1),\n    TComma => (EIdent(\"perform\", -1), pos + 1),\n    TSemicolon => (EIdent(\"perform\", -1), pos + 1),\n    TEof => (EIdent(\"perform\", -1), pos + 1),\n    _ => {\n      // `perform` binds tighter than binary operators: parse only the\n      // effect-op application (primary + postfix), not a trailing binary\n      // expression, so `perform A::Op + perform B::Op` groups as\n      // `(perform A::Op) + (perform B::Op)` rather than\n      // `perform (A::Op + perform B::Op)` (#550). min_prec 10 is above the\n      // highest binop precedence (9, see binop_prec), so parse_infix_loop\n      // stops before consuming any operator.\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\n      (ECall(EIdent(\"perform\", -1), [\n        arg\n      ], offset_at(starts, pos)), next_pos)\n    }\n  }\n}\n\nlet rec parse_array_elems_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      let next_pos = pos + 1\n      match peek(tokens, next_pos) {\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\n        TDotDotDot => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\n          ArrayBuilder::push(b, ESpread(expr))\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        },\n        _ => {\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\n          ArrayBuilder::push(b, expr)\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nlet parse_array_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRBracket => (EArray(empty_exprs()), pos + 2),\n    TDotDotDot => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n      ArrayBuilder::push(b, ESpread(first))\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    },\n    _ => {\n      let b = ArrayBuilder::new()\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      ArrayBuilder::push(b, first)\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\n      let close_pos = expect_tk(tokens, end_pos, \"]\")\n      (EArray(items), close_pos)\n    }\n  }\n}\n\nlet rec parse_comma_exprs_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TComma => {\n      // Allow a trailing comma before the closing `)` in tuples and call\n      // argument lists (`(a, b,)` / `f(a, b,)`).\n      match peek(tokens, pos + 1) {\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\n        _ => {\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\n          ArrayBuilder::push(b, e)\n          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur)\n        }\n      }\n    },\n    _ => (ArrayBuilder::freeze(b), pos)\n  }\n}\n\nlet parse_continue_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TLParen => {\n      let b = ArrayBuilder::new()\n      match peek(tokens, pos + 2) {\n        TRParen => (EContinue(empty_exprs()), pos + 3),\n        _ => {\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\n          ArrayBuilder::push(b, first)\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (EContinue(args), close_pos)\n        }\n      }\n    },\n    _ => (EContinue(empty_exprs()), pos + 1)\n  }\n}\n\nlet parse_control_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TLBrace => parse_recur(tokens, pos + 1, 20),\n    TIf => parse_recur(tokens, pos + 1, 21),\n    TMatch => parse_recur(tokens, pos + 1, 22),\n    THandle => parse_recur(tokens, pos + 1, 24),\n    TWhile => parse_recur(tokens, pos + 1, 23),\n    TFor => parse_recur(tokens, pos + 1, 25),\n    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur),\n    TBreak => parse_break_primary(tokens, starts, pos, parse_recur),\n    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur),\n    TRaise => throw(\"'raise' is deprecated, use 'throw(expr)' instead\"),\n    TReturn => parse_return_primary(tokens, starts, pos, parse_recur),\n    TDo => throw(\"'do' is reserved; use 'while' or 'for' instead\"),\n    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur),\n    TYield => throw(\"'yield' is not supported\"),\n    TDeclare => throw(\"'declare' is not supported\"),\n    _ => {\n      let prev_name = if pos > 0 {\n        tk_name(peek(tokens, pos - 1))\n      } else {\n        \"start\"\n      }\n      let actual = tk_name(peek(tokens, pos))\n      let next_name = tk_name(peek(tokens, pos + 1))\n      throw(\"unexpected token at #\\{pos}: \\{actual} (prev=\\{prev_name}, next=\\{next_name})\")\n    }\n  }\n}\n\nlet rec parse_ctor_record_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\nlet parse_generic_fn_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let mut skip_pos = pos + 1\n  let mut depth = 1\n  while depth > 0 {\n    match peek(tokens, skip_pos) {\n      TLBracket => {\n        depth = depth + 1\n      },\n      TRBracket => {\n        depth = depth - 1\n      },\n      _ => ()\n    }\n    skip_pos = skip_pos + 1\n  }\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\n      let effect_pair = match peek(tokens, ret_pos) {\n        TWith => {\n          let with_pos = expect_tk(tokens, ret_pos + 1, \"{\")\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \"\")\n          let effect_name = effect_name_pair.0\n          let end_pos = effect_name_pair.1\n          (Some(effect_name), end_pos)\n        },\n        _ => (None, ret_pos)\n      }\n      let effect = effect_pair.0\n      let effect_next = effect_pair.1\n      let body_pos = expect_tk(tokens, effect_next, \"{\")\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\n    },\n    TLBrace => {\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\n    },\n    _ => throw(\"expected '->' or '{' after generic function params\")\n  }\n}\n\nlet is_generic_fn_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\n  match peek(tokens, pos + 1) {\n    TIdent(_) => {\n      let mut p = pos + 2\n      let mut depth = 1\n      while depth > 0 {\n        match peek(tokens, p) {\n          TLBracket => {\n            depth = depth + 1\n          },\n          TRBracket => {\n            depth = depth - 1\n          },\n          TEof => {\n            depth = 0\n          },\n          _ => ()\n        }\n        p = p + 1\n      }\n      match peek(tokens, p) {\n        TLParen => true,\n        _ => false\n      }\n    },\n    _ => false\n  }\n}\n\nlet parse_bracket_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  if is_generic_fn_start(tokens, pos) {\n    parse_generic_fn_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_array_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nlet rec parse_map_literal_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_map_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in map literal\")\n      }\n    },\n    TString(skey) => {\n      let colon_pos = expect_tk(tokens, pos + 1, \":\")\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\n      ArrayBuilder::push(b, (skey, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_map_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in map literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in map literal\")\n  }\n}\n\nlet parse_paren_tuple_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos + 1) {\n    TRParen => (EUnit, pos + 2),\n    _ => {\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\n      match peek(tokens, next_pos) {\n        TRParen => (first, next_pos + 1),\n        TComma => {\n          let b = ArrayBuilder::new()\n          ArrayBuilder::push(b, first)\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          (ETuple(items), close_pos)\n        },\n        _ => throw(\"expected ')' or ','\")\n      }\n    }\n  }\n}\n\nlet parse_paren_lambda_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\n  match peek(tokens, after_params) {\n    TThinArrow => {\n      let after_arrow = after_params + 1\n      match peek(tokens, after_arrow) {\n        TIdent(_) => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        TLParen => {\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\n          match peek(tokens, ty_pos) {\n            TLBrace => {\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\n            },\n            TWith => {\n              let with_pos = expect_tk(tokens, ty_pos + 1, \"{\")\n              let effect_pair = collect_effect_names(tokens, with_pos, \"\")\n              let effect_name = effect_pair.0\n              let effect_next = effect_pair.1\n              let body_pos = expect_tk(tokens, effect_next, \"{\")\n              let (body, end) = parse_recur(tokens, body_pos, 20)\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\n            },\n            _ => {\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n            }\n          }\n        },\n        _ => {\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n        }\n      }\n    },\n    TLBrace => {\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\n    },\n    _ => throw(\"expected '->' or '{' after fn params\")\n  }\n}\n\nlet parse_paren_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  if is_lambda_start(tokens, pos + 1) {\n    parse_paren_lambda_primary(tokens, starts, pos, parse_recur)\n  } else {\n    parse_paren_tuple_primary(tokens, starts, pos, parse_recur)\n  }\n}\n\nlet rec parse_record_literal_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\n    TIdent(fname) => {\n      let (val, next_pos) = match peek(tokens, pos + 1) {\n        TComma => (EIdent(fname, -1), pos + 1),\n        TRBrace => (EIdent(fname, -1), pos + 1),\n        _ => {\n          let colon_pos = expect_tk(tokens, pos + 1, \":\")\n          parse_recur(tokens, colon_pos, 0)\n        }\n      }\n      ArrayBuilder::push(b, (fname, val))\n      match peek(tokens, next_pos) {\n        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\n        _ => throw(\"expected ',' or '}' in record literal\")\n      }\n    },\n    _ => throw(\"expected field name or '}' in record literal\")\n  }\n}\n\n// Look up the source char offset of the token at position `p` in the\n// parallel `starts` array produced by the offset-tracking lexer. Returns\n// -1 when `starts` has no entry for `p` (e.g. the empty-array entry points\n// `parse`/`parse_expr` that do not thread real offsets).\nlet offset_at: (Array[Int], Int) -> Int = (starts, p) -> {\n  if p >= 0 && p < Array::length(starts) {\n    Array::get(starts, p)\n  } else {\n    -1\n  }\n}\n\nlet parse_ident_primary: (Array[Token], Array[Int], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, name, parse_recur) -> {\n  if name == \"true\" {\n    (EBool(true), pos + 1)\n  } else if name == \"false\" {\n    (EBool(false), pos + 1)\n  } else if name == \"perform\" {\n    parse_perform_primary(tokens, starts, pos, parse_recur)\n  } else if name == \"record\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur)\n        (ERecord(fields), end_pos)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else if name == \"map\" {\n    match peek(tokens, pos + 1) {\n      TLBrace => {\n        let b = ArrayBuilder::new()\n        let (fields, end_pos) = parse_map_literal_fields(tokens, starts, pos + 2, b, parse_recur)\n        (EMap(fields), end_pos)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  } else {\n    match peek(tokens, pos + 1) {\n      TDoubleColon => match peek(tokens, pos + 2) {\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\"::\", member)), offset_at(starts, pos)), pos + 3),\n        TLBrace => {\n          let b = ArrayBuilder::new()\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur)\n          (ERecord(fields), end_pos)\n        },\n        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n      },\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\n    }\n  }\n}\n\nexport let parse_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TInt(n) => (EInt(n), pos + 1),\n    TFloat(n) => (EFloat(n), pos + 1),\n    TString(s) => (EString(s), pos + 1),\n    TStringInterp(parts) => (build_interp_expr(parts, parse_recur), pos + 1),\n    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur),\n    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur),\n    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur),\n    _ => parse_control_primary(tokens, starts, pos, parse_recur)\n  }\n}\n")
}

let cli_adapter_source_15 = () -> (String, String) {
  ("vibe/compiler/syntax/parser_expr_core.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat\n}\n\nimport ./parser_base.vibe {\n  _no_tb, _no_tp, empty_exprs, expect_tk, is_expr_end_token, is_non_pipe_infix, parse_pattern, peek\n}\n\nimport ./parser_expr_primary.vibe {\n  parse_primary\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet binop_op: (Token) -> String with { Error } = (tok) -> {\n  match tok {\n    TOr => \"||\",\n    TAnd => \"&&\",\n    TPipeGt => \"|>\",\n    TEqEq => \"==\",\n    TNeq => \"!=\",\n    TLt => \"<\",\n    TLte => \"<=\",\n    TGt => \">\",\n    TGte => \">=\",\n    TBitOr => \"|\",\n    TBitXor => \"^\",\n    TBitAnd => \"&\",\n    TLShift => \"<<\",\n    TRShift => \">>\",\n    TPlus => \"+\",\n    TMinus => \"-\",\n    TStar => \"*\",\n    TSlash => \"/\",\n    TPercent => \"%\",\n    _ => throw(\"internal parser error: not a binary operator\")\n  }\n}\n\nlet binop_prec: (Token) -> Int = (tok) -> {\n  match tok {\n    TOr => 0,\n    TAnd => 1,\n    TPipeGt => 2,\n    TEqEq => 3,\n    TNeq => 3,\n    TLt => 3,\n    TLte => 3,\n    TGt => 3,\n    TGte => 3,\n    TBitOr => 4,\n    TBitXor => 5,\n    TBitAnd => 6,\n    TLShift => 7,\n    TRShift => 7,\n    TPlus => 8,\n    TMinus => 8,\n    TStar => 9,\n    TSlash => 9,\n    TPercent => 9,\n    _ => -1\n  }\n}\n\n// Extract the source char offset of a callee expression so that the ECall\n// node can carry the call-site offset (callee start). Mirrors how EIdent\n// threads `offset_at(starts, pos)`. Falls back to -1 for callees that do\n// not carry an offset (synthetic / nested forms).\nlet callee_offset: (Expr) -> Int = (callee) -> {\n  match callee {\n    EIdent(_, off) => off,\n    EDot(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\n    ECall(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\n    _ => -1\n  }\n}\n\nlet index_expr: (Expr, Expr) -> Expr = (cur_expr, idx) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  ECall(EIdent(\"__index\", -1), args, -1)\n}\n\n// `x |> f(a, _)` substitutes the piped value at each bare `_` placeholder\n// (`f(a, x)`) instead of prepending. With no `_`, the piped value is\n// prepended as the first argument (`x |> f(a)` => `f(x, a)`). Bare `_`\n// call arguments are preserved as `EIdent(\"_\")` holes by\n// `desugar_placeholder_args`; compound placeholders like `_ * 2` are already\n// lowered to section lambdas before they reach here.\nlet pipe_arg_is_hole: (Expr) -> Bool = (arg) -> {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    _ => false\n  }\n}\n\nlet pipe_desugar: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  match rhs {\n    ECall(callee, args, off) => {\n      let mut has_hole = false\n      let mut i = 0\n      while i < Array::length(args) {\n        if pipe_arg_is_hole(Array::get(args, i)) {\n          has_hole = true\n          i = Array::length(args)\n        } else {\n          i = i + 1\n        }\n      }\n      if has_hole {\n        let out = empty_exprs()\n        let mut j = 0\n        while j < Array::length(args) {\n          let a = Array::get(args, j)\n          if pipe_arg_is_hole(a) {\n            Array::push(out, lhs)\n          } else {\n            Array::push(out, a)\n          }\n          j = j + 1\n        }\n        ECall(callee, out, off)\n      } else {\n        ECall(callee, Array::concat([\n          lhs\n        ], args), off)\n      }\n    },\n    _ => ECall(rhs, [\n      lhs\n    ], callee_offset(rhs))\n  }\n}\n\nlet parse_call_arg: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TIdent(name) => match peek(tokens, pos + 1) {\n      TThinArrow => {\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\n        (EFn(_no_tp(), _no_tb(), [\n          (name, None)\n        ], None, None, body), end)\n      },\n      TTilde => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"~\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TQuestion => match peek(tokens, pos + 2) {\n        TEq => {\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\n          (ELabeledArg(name, \"?\", val), end)\n        },\n        _ => parse_recur(tokens, pos, 0)\n      },\n      TEq => {\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\n        (ELabeledArg(name, \"~\", val), end)\n      },\n      _ => parse_recur(tokens, pos, 0)\n    },\n    _ => parse_recur(tokens, pos, 0)\n  }\n}\n\nlet has_placeholder_arg: (Expr) -> Bool = (arg) -> {\n  match arg {\n    EIdent(n, _) => n == \"_\",\n    EBinOp(_, l, r) => {\n      let left_has = match l {\n        EIdent(n, _) => n == \"_\",\n        _ => false\n      }\n      let right_has = match r {\n        EIdent(n, _) => n == \"_\",\n        _ => false\n      }\n      left_has || right_has\n    },\n    _ => false\n  }\n}\n\nlet slice_from_idx_expr: (Expr, Expr, Expr) -> Expr = (cur_expr, idx, end_expr) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, idx)\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nlet has_placeholder_args: (Array[Expr]) -> Bool = (args) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(args) {\n    if has_placeholder_arg(Array::get(args, i)) {\n      found = true\n      i = Array::length(args)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet parse_call_args_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\n  let mut p = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TComma => match peek(tokens, p + 1) {\n        TRParen => {\n          p = p + 1\n          done = true\n        },\n        _ => {\n          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur)\n          ArrayBuilder::push(b, e)\n          p = next\n        }\n      }\n      ,\n      _ => {\n        done = true\n      }\n    }\n  }\n  (ArrayBuilder::freeze(b), p)\n}\n\nlet slice_from_zero_expr: (Expr, Expr) -> Expr = (cur_expr, end_expr) -> {\n  let args = empty_exprs()\n  Array::push(args, cur_expr)\n  Array::push(args, EInt(0))\n  Array::push(args, end_expr)\n  ECall(EIdent(\"__slice\", -1), args, -1)\n}\n\nlet wrap_placeholder_arg: (Expr) -> Expr = (arg) -> {\n  let mut pc = 0\n  let params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let replaced = match arg {\n    EIdent(n, _) => if n == \"_\" {\n      let pn = \"__ph0\"\n      Array::push(params, (pn, None))\n      EIdent(pn, -1)\n    } else {\n      arg\n    }\n    ,\n    EBinOp(op, l, r) => {\n      let nl = match l {\n        EIdent(n, _) => if n == \"_\" {\n          let pn = String::concat(\"__ph\", __to_string(pc))\n          Array::push(params, (pn, None))\n          pc = pc + 1\n          EIdent(pn, -1)\n        } else {\n          l\n        }\n        ,\n        _ => l\n      }\n      let nr = match r {\n        EIdent(n, _) => if n == \"_\" {\n          let pn = String::concat(\"__ph\", __to_string(pc))\n          Array::push(params, (pn, None))\n          pc = pc + 1\n          EIdent(pn, -1)\n        } else {\n          r\n        }\n        ,\n        _ => r\n      }\n      EBinOp(op, nl, nr)\n    },\n    _ => arg\n  }\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\n}\n\nlet has_non_pipe_infix_top: (Array[Token], Int, Int) -> Bool = (tokens, start, end) -> {\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\n    if i >= end {\n      false\n    } else {\n      let tok = peek(tokens, i)\n      if depth == 0 {\n        if is_non_pipe_infix(tok) {\n          if prev_top_end {\n            true\n          } else {\n            go(i + 1, 0, false)\n          }\n        } else {\n          match tok {\n            TLParen => go(i + 1, 1, false),\n            TLBracket => go(i + 1, 1, false),\n            TLBrace => go(i + 1, 1, false),\n            _ => go(i + 1, 0, is_expr_end_token(tok))\n          }\n        }\n      } else {\n        match tok {\n          TLParen => go(i + 1, depth + 1, prev_top_end),\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\n          TRParen => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBracket => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          TRBrace => if depth == 1 {\n            go(i + 1, 0, true)\n          } else {\n            go(i + 1, depth - 1, prev_top_end)\n          },\n          _ => go(i + 1, depth, prev_top_end)\n        }\n      }\n    }\n  }\n  go(start, 0, false)\n}\n\nlet desugar_placeholder_args: (Array[Expr]) -> Array[Expr] = (args) -> {\n  let out = Array::slice([\n    EUnit\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(args) {\n    let arg = Array::get(args, i)\n    if pipe_arg_is_hole(arg) {\n      // Bare `_` stays a hole so a surrounding `|>` can substitute the\n      // piped value at this position; compound placeholders still lower.\n      Array::push(out, arg)\n    } else if has_placeholder_arg(arg) {\n      Array::push(out, wrap_placeholder_arg(arg))\n    } else {\n      Array::push(out, arg)\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet rec parse_postfix: (Array[Token], Array[Int], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, expr, parse_recur) -> {\n  match peek(tokens, pos) {\n    TLParen => match expr {\n      ECall(_, _, _) => (expr, pos),\n      EArray(_) => (expr, pos),\n      ETuple(_) => (expr, pos),\n      ERecord(_) => (expr, pos),\n      EMap(_) => (expr, pos),\n      EInt(_) => (expr, pos),\n      EFloat(_) => (expr, pos),\n      EString(_) => (expr, pos),\n      EStringInterp(_) => (expr, pos),\n      EBool(_) => (expr, pos),\n      EUnit => (expr, pos),\n      EWhile(_, _) => (expr, pos),\n      EIf(_, _, _) => (expr, pos),\n      EMatch(_, _) => (expr, pos),\n      ELoop(_, _) => (expr, pos),\n      EForIn(_, _, _, _) => (expr, pos),\n      EHandle(_, _) => (expr, pos),\n      _ => match peek(tokens, pos + 1) {\n        TRParen => parse_postfix(tokens, starts, pos + 2, ECall(expr, empty_exprs(), callee_offset(expr)), parse_recur),\n        _ => {\n          let b = ArrayBuilder::new()\n          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur)\n          ArrayBuilder::push(b, first_arg)\n          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, parse_recur)\n          let close_pos = expect_tk(tokens, end_pos, \")\")\n          let call_args = if has_placeholder_args(args) {\n            desugar_placeholder_args(args)\n          } else {\n            args\n          }\n          parse_postfix(tokens, starts, close_pos, ECall(expr, call_args, callee_offset(expr)), parse_recur)\n        }\n      },\n    },\n    TLBracket => match peek(tokens, pos + 1) {\n      TColon => match peek(tokens, pos + 2) {\n        TRBracket => {\n          let end_expr = ECall(EIdent(\"__len\", -1), [\n            expr\n          ], -1)\n          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\n        },\n        _ => {\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\n          let close_pos = match peek(tokens, end_next) {\n            TRBracket => end_next + 1,\n            _ => throw(\"expected ']'\")\n          }\n          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\n        }\n      },\n      _ => {\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\n        match peek(tokens, idx_next) {\n          TColon => match peek(tokens, idx_next + 1) {\n            TRBracket => {\n              let end_expr = ECall(EIdent(\"__len\", -1), [\n                expr\n              ], -1)\n              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            },\n            _ => {\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\n              let close_pos = match peek(tokens, end_next) {\n                TRBracket => end_next + 1,\n                _ => throw(\"expected ']'\")\n              }\n              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\n            }\n          },\n          _ => {\n            let close_pos = match peek(tokens, idx_next) {\n              TRBracket => idx_next + 1,\n              _ => throw(\"expected ']'\")\n            }\n            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur)\n          }\n        }\n      }\n    },\n    TDot => match peek(tokens, pos + 1) {\n      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr)), parse_recur),\n      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr)), parse_recur),\n      _ => (expr, pos)\n    },\n    // `expr?` (railway try, #635): emit the type-directed sentinel\n    // `__try_op(expr)` that the pre-check desugar lowers by `expr`'s head type —\n    // Option -> yield inner on Some, early-`return None` on None; Result (the\n    // default) -> yield inner on Ok, early-`return Err(e)` on Err. The parser\n    // has no type info, so it defers the choice to the desugar. Continue postfix\n    // parsing so `f(x)?.field` chains.\n    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent(\"__try_op\", -1), [\n      expr\n    ], -1), parse_recur),\n    _ => (expr, pos)\n  }\n}\n\nlet rec parse_prefix: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  match peek(tokens, pos) {\n    TMinus => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"-\", e), next)\n    },\n    TNot => {\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\n      (EUnaryOp(\"!\", e), next)\n    },\n    _ => {\n      let (e, next) = parse_primary(tokens, starts, pos, parse_recur)\n      parse_postfix(tokens, starts, next, e, parse_recur)\n    }\n  }\n}\n\nlet rec parse_infix_loop: (Array[Token], Array[Int], Expr, Int, Int, Int, Bool, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, left, next, min_prec, expr_start, cmp_locked, parse_recur) -> {\n  let tok = peek(tokens, next)\n  let prec = binop_prec(tok)\n  let should_stop = if prec < min_prec {\n    true\n  } else if cmp_locked {\n    prec == 3\n  } else {\n    false\n  }\n  if should_stop {\n    (left, next)\n  } else {\n    let is_pipe = match tok {\n      TPipeGt => true,\n      _ => false\n    }\n    let op = binop_op(tok)\n    if is_pipe {\n      if has_non_pipe_infix_top(tokens, expr_start, next) {\n        throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n      }\n    }\n    let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur)\n    let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, parse_recur)\n    if is_pipe {\n      if has_non_pipe_infix_top(tokens, next + 1, rn) {\n        throw(\"cannot mix '|>' with other infix operators without explicit parentheses\")\n      }\n    }\n    let combined = if is_pipe {\n      pipe_desugar(left, right)\n    } else {\n      EBinOp(op, left, right)\n    }\n    let next_cmp_locked = if prec == 3 {\n      true\n    } else {\n      cmp_locked\n    }\n    parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, parse_recur)\n  }\n}\n\n// `parse_infix_no_is` walks the operator-precedence ladder *without*\n// consuming a trailing `expr is pattern` test at the end. The `if-cond is\n// pat { ... }` special form (parsed in `parse_impl_dispatch` mode_if)\n// needs the pattern to remain on the token stream so it can capture it\n// as the if-cond's pattern arm; without this split the `is` gets\n// swallowed here and the outer dispatch sees a stray `{` it cannot match\n// against the if-cond pattern slot.\nexport let parse_infix_no_is: (Array[Token], Array[Int], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, min_prec, expr_start, parse_recur) -> {\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, parse_recur)\n}\n\nexport let parse_infix: (Array[Token], Array[Int], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, min_prec, expr_start, parse_recur) -> {\n  let (expr, en) = parse_infix_no_is(tokens, starts, pos, min_prec, expr_start, parse_recur)\n  match peek(tokens, en) {\n    TIs => {\n      let (pat, pn) = parse_pattern(tokens, en + 1)\n      (EMatch(expr, [\n        (pat, EBool(true)),\n        (PWild, EBool(false))\n      ]), pn)\n    },\n    TIdent(kw) => if kw == \"is\" {\n      let (pat, pn) = parse_pattern(tokens, en + 1)\n      (EMatch(expr, [\n        (pat, EBool(true)),\n        (PWild, EBool(false))\n      ]), pn)\n    } else {\n      (expr, en)\n    },\n    _ => (expr, en)\n  }\n}\n")
}

let cli_adapter_source_16 = () -> (String, String) {
  ("vibe/compiler/syntax/parser_expr_dispatch.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat, TypeExpr\n}\n\nimport ./parser_base.vibe {\n  empty_arms, empty_exprs, expect_tk, parse_enum_stmt, parse_pattern, parse_struct_stmt, parse_type_impl, peek, skip_semi, tk_name\n}\n\nimport ./parser_expr_core.vibe {\n  parse_infix_no_is\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\n// Wrap `val` so that `((__asc: ty) -> __asc)(val)` forces `val` to have type\n// `ty` (enforced by the call-argument check) while evaluating to `val` itself.\n// Used to type-check a local `let x: T = e`, whose annotation `ELet` cannot\n// store. Uses only EFn/ECall, so every downstream pass handles it unchanged.\nlet ascribe_wrap: (Expr, TypeExpr) -> Expr = (val, ty) -> {\n  let tparams = Array::slice([\n    \"\"\n  ], 0, 0)\n  let tbounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let params = [\n    (\"__asc\", Some(ty))\n  ]\n  let lam = EFn(tparams, tbounds, params, None, None, EIdent(\"__asc\", 0 - 1))\n  ECall(lam, [\n    val\n  ], 0 - 1)\n}\n\n// #705: a local `let f: (A) -> R = (x) -> ..` must behave like the top-level\n// form (parse_let_stmt / apply_generic_let_annotation): distribute the TyFn\n// annotation onto the lambda's unannotated params / ret / effect. Hiding the\n// lambda behind ascribe_wrap's `((__asc: T) -> __asc)(lam)` instead means the\n// Perceus param heap-inference (fill_lambda_params / param_is_heap_in_body)\n// never sees an annotation for the lambda's params, plans a heap param as\n// scalar, and under-provisions its rc dups -- the callee-owns drops inside the\n// body then free a still-live argument (use-after-free under VIBE_RC=1).\n// Returns None when the annotation is not a TyFn, the value is not a lambda,\n// or the arity does not match; callers fall back to ascribe_wrap (plain let)\n// or the bare value (let rec, which previously discarded the annotation).\nlet distribute_local_fn_ann: (TypeExpr, Expr) -> Option[Expr] = (ann_ty, val) -> {\n  match ann_ty {\n    TyFn(param_types, ret_ty, effect_name) => match val {\n      EFn(tp, tb, params, ret_opt, effect_opt, body) => {\n        if Array::length(params) != Array::length(param_types) {\n          None\n        } else {\n          let out = ArrayBuilder::new()\n          let mut i = 0\n          while i < Array::length(params) {\n            let (pname, pann) = Array::get(params, i)\n            let next_ann = match pann {\n              Some(_) => pann,\n              None => Some(Array::get(param_types, i))\n            }\n            ArrayBuilder::push(out, (pname, next_ann))\n            i = i + 1\n          }\n          let next_ret = match ret_opt {\n            Some(_) => ret_opt,\n            None => Some(ret_ty)\n          }\n          let next_eff = match effect_opt {\n            Some(_) => effect_opt,\n            None => effect_name\n          }\n          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))\n        }\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nenum BlockStep {\n  StepSeq(Expr);\n  StepValue(Expr);\n  StepLet(String, Expr);\n  StepLetMut(String, Expr);\n  StepLetRec(String, Expr);\n  StepAssign(String, Expr);\n  StepAssignOp(String, String, Expr);\n  StepPattern(Pat, Expr);\n  StepStructDestr(Pat, Expr);\n  StepRecordDestr(Pat, Expr);\n  StepBind(String, Expr)\n}\n\n// #666: desugar match-arm guards into existing constructs. `arms` is the\n// collected arm list as (pattern, guard-or-EBool(true)-sentinel, body). A\n// guarded arm `pat if g => body` becomes `pat => if g { body } else { match\n// scrut { remaining } }` so a FAILED guard falls through to later arms; the\n// remaining arms are also appended (for the pattern-doesn't-match case). The\n// guard's Bool-check and codegen come for free via `EIf`. `scrut` must be a\n// re-evaluable reference (the caller binds the scrutinee to a temp), so the\n// nested match never re-runs a side-effecting scrutinee.\nlet rec desugar_guarded: (Array[(Pat, Expr, Expr)], Int, Expr) -> Array[(Pat, Expr)] = (arms, i, scrut) -> {\n  if i >= Array::length(arms) {\n    empty_arms()\n  } else {\n    let (pat, guard, body) = Array::get(arms, i)\n    let rest = desugar_guarded(arms, i + 1, scrut)\n    let no_guard = match guard {\n      EBool(bv) => bv,\n      _ => false\n    }\n    let arm_body = if no_guard {\n      body\n    } else {\n      EIf(guard, body, EMatch(scrut, rest))\n    }\n    let out = ArrayBuilder::new()\n    ArrayBuilder::push(out, (pat, arm_body))\n    let mut j = 0\n    while j < Array::length(rest) {\n      ArrayBuilder::push(out, Array::get(rest, j))\n      j = j + 1\n    }\n    ArrayBuilder::freeze(out)\n  }\n}\n\n// #666: parse all match arms into `b` as (pattern, guard|EBool(true), body),\n// setting hg[0] when any arm carries a guard. Arms are comma-separated, ending\n// at `}` (optionally with a trailing comma).\nlet rec collect_match_arms: (Array[Token], Array[Int], Int, ArrayBuilder[(Pat, Expr, Expr)], Array[Bool], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } = (tokens, starts, pos, b, hg, parse_recur) -> {\n  let (pat, pa) = parse_pattern(tokens, pos)\n  let (guard, after_g) = match peek(tokens, pa) {\n    TIf => {\n      Array::set(hg, 0, true)\n      parse_recur(tokens, pa + 1, 0)\n    },\n    _ => (EBool(true), pa)\n  }\n  let arrow = expect_tk(tokens, after_g, \"=>\")\n  let (body, bn) = parse_recur(tokens, arrow, 0)\n  ArrayBuilder::push(b, (pat, guard, body))\n  match peek(tokens, bn) {\n    TComma => match peek(tokens, bn + 1) {\n      TRBrace => bn + 2,\n      _ => collect_match_arms(tokens, starts, bn + 1, b, hg, parse_recur)\n    },\n    TRBrace => bn + 1,\n    // Comma-less arm separation: mirror the old parse_match_rest fall-through,\n    // which parsed the next arm's pattern without consuming a separator.\n    _ => collect_match_arms(tokens, starts, bn, b, hg, parse_recur)\n  }\n}\n\nlet rec qualify_handle_arm_pattern: (String, Pat) -> Pat = (effect_name, pat) -> {\n  match pat {\n    PCtor(name, args) => if String::contains(name, \"::\") {\n      PCtor(name, args)\n    } else {\n      PCtor(String::concat(effect_name, String::concat(\"::\", name)), args)\n    },\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\n    _ => pat\n  }\n}\n\nlet parse_handle_arm: (Array[Token], Array[Int], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } = (tokens, starts, pos, effect_name, parse_recur) -> {\n  let (pat, pat_next) = parse_pattern(tokens, pos)\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\n  let arrow_pos = expect_tk(tokens, pat_next, \"=>\")\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\n  ((qualified_pat, expr), next)\n}\n\nlet rec parse_handle_rest: (Array[Token], Array[Int], Int, Expr, String, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, body, effect_name, b, parse_recur) -> {\n  match peek(tokens, pos) {\n    TSemicolon => match peek(tokens, pos + 1) {\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\n      _ => {\n        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    },\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\n    _ => throw(\"expected ';' or '}' in handle arm list\")\n  }\n}\n\nlet parse_block_after_expr: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, e, parse_recur) -> {\n  match peek(tokens, pos) {\n    TRBrace => (e, pos + 1),\n    TSemicolon => {\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\n      (ESeq(e, rest), end)\n    },\n    TEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssign(name, val, rest), end)\n      },\n      EDot(obj, field, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        let set_args = empty_exprs()\n        Array::push(set_args, obj)\n        Array::push(set_args, EString(field))\n        Array::push(set_args, val)\n        (ESeq(ECall(EIdent(\"__set_field\", -1), set_args, -1), rest), end)\n      },\n      ECall(idx_callee, idx_args, _) => {\n        // `arr[i] = v` (indexing parses as `__index(arr, i)`) desugars to\n        // `Array::set(arr, i, v)` — host-era index assignment used across\n        // vibe/shell and vibe/wasm sources previously died here with\n        // \"invalid assignment target\". Array-only: a non-Array receiver\n        // fails in the checker on Array::set's signature.\n        let is_index = match idx_callee {\n          EIdent(icn, _) => icn == \"__index\",\n          _ => false\n        }\n        if is_index && Array::length(idx_args) == 2 {\n          let val_pair = parse_recur(tokens, pos + 1, 0)\n          let val = val_pair.0\n          let val_next = val_pair.1\n          let a = skip_semi(tokens, val_next)\n          let (rest, end) = parse_recur(tokens, a, 20)\n          let set_args = empty_exprs()\n          Array::push(set_args, Array::get(idx_args, 0))\n          Array::push(set_args, Array::get(idx_args, 1))\n          Array::push(set_args, val)\n          (ESeq(ECall(EIdent(\"Array::set\", -1), set_args, -1), rest), end)\n        } else {\n          throw(\"invalid assignment target\")\n        }\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPlusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"+\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TMinusEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"-\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TStarEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"*\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TSlashEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"/\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    TPercentEq => match e {\n      EIdent(name, _) => {\n        let val_pair = parse_recur(tokens, pos + 1, 0)\n        let val = val_pair.0\n        let val_next = val_pair.1\n        let a = skip_semi(tokens, val_next)\n        let (rest, end) = parse_recur(tokens, a, 20)\n        (EAssignOp(name, \"%\", val, rest), end)\n      },\n      _ => throw(\"invalid assignment target\")\n    },\n    _ => {\n      let (rest, end) = parse_recur(tokens, pos, 20)\n      if end <= pos {\n        throw(\"internal parser error: block continuation did not advance\")\n      } else {\n        (ESeq(e, rest), end)\n      }\n    }\n  }\n}\n\nlet parse_block_value_body: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } = (tokens, eq, parse_recur) -> {\n  let val_pair = parse_recur(tokens, eq, 0)\n  let val = val_pair.0\n  let val_next = val_pair.1\n  let a = skip_semi(tokens, val_next)\n  let (body, end) = parse_recur(tokens, a, 20)\n  (val, body, end, a)\n}\n\nlet parse_block_value_only: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, value_pos, parse_recur) -> {\n  let val_pair = parse_recur(tokens, value_pos, 0)\n  (val_pair.0, skip_semi(tokens, val_pair.1))\n}\n\nlet apply_struct_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\n  let val_name = \"__struct_destr\"\n  let mut desugar = rest\n  match pat {\n    PStruct(_, fields) => {\n      let mut di = Array::length(fields) - 1\n      while di >= 0 {\n        let (fname, fpat) = Array::get(fields, di)\n        match fpat {\n          PBind(bname) => {\n            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1), desugar)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar)\n}\n\nlet apply_record_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\n  let val_name = \"__rec_destr\"\n  let mut desugar = rest\n  match pat {\n    PTuple(field_pats) => {\n      let mut di = Array::length(field_pats) - 1\n      while di >= 0 {\n        let fp = Array::get(field_pats, di)\n        match fp {\n          PBind(bname) => {\n            desugar = ELet(bname, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar)\n          },\n          PTuple(sub_pats) => {\n            let sub_name = String::concat(\"__rec_sub_\", __to_string(di))\n            let mut si = Array::length(sub_pats) - 1\n            while si >= 0 {\n              match Array::get(sub_pats, si) {\n                PBind(sname) => {\n                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1), desugar)\n                },\n                _ => ()\n              }\n              si = si - 1\n            }\n            desugar = ELet(sub_name, ECall(EIdent(\"__rec_field\", -1), [\n              EIdent(val_name, -1),\n              EInt(di)\n            ], -1), desugar)\n          },\n          _ => ()\n        }\n        di = di - 1\n      }\n    },\n    _ => ()\n  }\n  ELet(val_name, val, desugar)\n}\n\nlet apply_block_step: (BlockStep, Expr) -> Expr = (step, rest) -> {\n  match step {\n    StepSeq(expr) => ESeq(expr, rest),\n    StepValue(expr) => expr,\n    StepLet(name, val) => ELet(name, val, rest),\n    StepLetMut(name, val) => ELetMut(name, val, rest),\n    StepLetRec(name, val) => ELetRec(name, val, rest),\n    StepAssign(name, val) => EAssign(name, val, rest),\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\n    StepPattern(pat, val) => EMatch(val, [\n      (pat, rest)\n    ]),\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),\n    // `let* x = e` (railway bind, #635): short-circuit on the failure case,\n    // continue on the success case. The parser has no type info, so it emits a\n    // type-directed sentinel `__try_bind(val, (x) -> rest)` that the pre-check\n    // desugar (`desugar_trait_dict.vibe::rewrite_expr`) lowers by `val`'s head\n    // type: `Option` -> `match val { Some(x) => rest, None => None }`, else\n    // (`Result` or undeterminable) the original Result match\n    //   `match val { Ok(x) => rest, Err(__bind_err) => Err(__bind_err) }`.\n    // The continuation closure carries `x` + `rest` so `rest`'s scope is exact.\n    StepBind(name, val) => ECall(EIdent(\"__try_bind\", -1), [\n      val,\n      EFn(Array::slice([\n        \"\"\n      ], 0, 0), Array::slice([\n        (\"\", Array::slice([\n          \"\"\n        ], 0, 0))\n      ], 0, 0), [\n        (name, None)\n      ], None, None, rest)\n    ], -1)\n  }\n}\n\nlet fold_block_steps: (Array[BlockStep]) -> Expr = (steps) -> {\n  let mut result = EUnit\n  let mut i = Array::length(steps) - 1\n  while i >= 0 {\n    result = apply_block_step(Array::get(steps, i), result)\n    i = i - 1\n  }\n  result\n}\n\nlet parse_impl_block: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\n  let steps = ArrayBuilder::new()\n  let mut p = pos\n  let mut end_pos = pos\n  let mut done = false\n  while !done {\n    match peek(tokens, p) {\n      TRBrace => {\n        end_pos = p + 1\n        done = true\n      },\n      TEof => throw(\"unexpected eof in block\"),\n      TEnum => {\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\n        match enum_stmt {\n          SEnum(_, _, _, variants, _) => {\n            let mut vi = 0\n            while vi < Array::length(variants) {\n              let (vname, vfields) = Array::get(variants, vi)\n              if Array::length(vfields) == 0 {\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi)))\n              }\n              vi = vi + 1\n            }\n          },\n          _ => ()\n        }\n        p = enum_end\n      },\n      TStruct => {\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\n        p = struct_end\n      },\n      TLet => {\n        let next = p + 1\n        match peek(tokens, next) {\n          TRec => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let (rec_ann, eq_pos_r) = match peek(tokens, next + 2) {\n                TColon => {\n                  let (rty, tp) = parse_type_impl(tokens, next + 3, 0)\n                  (Some(rty), tp)\n                },\n                _ => (None, next + 2)\n              }\n              let eq = expect_tk(tokens, eq_pos_r, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-rec parser did not advance\")\n              } else {\n                // #705: same TyFn-annotation distribution as the plain local\n                // let below. The annotation used to be parsed and discarded\n                // here; keep that as the fallback (no ascribe_wrap -- a\n                // wrapped value would break letrec's direct-lambda shape).\n                let val2 = match rec_ann {\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                    Some(distributed) => distributed,\n                    None => val\n                  },\n                  None => val\n                }\n                ArrayBuilder::push(steps, StepLetRec(name, val2))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let rec'\")\n          },\n          TMut => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq_pos_m = match peek(tokens, next + 2) {\n                TColon => {\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\n                  tp\n                },\n                _ => next + 2\n              }\n              let eq = expect_tk(tokens, eq_pos_m, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let-mut parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepLetMut(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let mut'\")\n          },\n          TStar => match peek(tokens, next + 1) {\n            TIdent(name) => {\n              let eq = expect_tk(tokens, next + 2, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              if next_pos <= eq {\n                throw(\"internal parser error: block let* parser did not advance\")\n              } else {\n                ArrayBuilder::push(steps, StepBind(name, val))\n                p = next_pos\n              }\n            },\n            _ => throw(\"expected identifier after 'let*'\")\n          },\n          TIdent(name) => {\n            let after_name = peek(tokens, next + 1)\n            let next_is_struct_destr = match after_name {\n              TDoubleColon => {\n                let fc = String::char_code_at(name, 0)\n                if fc >= 65 && fc <= 90 {\n                  match peek(tokens, next + 2) {\n                    TLBrace => true,\n                    _ => false\n                  }\n                } else {\n                  false\n                }\n              },\n              _ => false\n            }\n            let next_is_record_destr = match after_name {\n              TLBrace => name == \"record\",\n              _ => false\n            }\n            if next_is_struct_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\n              p = next_pos\n            } else if next_is_record_destr {\n              let (pat, pn) = parse_pattern(tokens, next)\n              let eq = expect_tk(tokens, pn, \"=\")\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\n              p = next_pos\n            } else {\n              match after_name {\n                TLParen => {\n                  let (pat, pn) = parse_pattern(tokens, next)\n                  let eq = expect_tk(tokens, pn, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let-ctor-pat parser did not advance\")\n                  } else {\n                    ArrayBuilder::push(steps, StepPattern(pat, val))\n                    p = next_pos\n                  }\n                },\n                _ => {\n                  let (ann_type, eq_pos) = match after_name {\n                    TColon => {\n                      let (the_type, tp) = parse_type_impl(tokens, next + 2, 0)\n                      (Some(the_type), tp)\n                    },\n                    _ => (None, next + 1)\n                  }\n                  let eq = expect_tk(tokens, eq_pos, \"=\")\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n                  if next_pos <= eq {\n                    throw(\"internal parser error: block let parser did not advance\")\n                  } else {\n                    // A local `let x: T = e` carries no type field on `ELet`, so\n                    // enforce `e : T` by wrapping the value in an identity\n                    // application `((__asc: T) -> __asc)(e)` whose argument check\n                    // (unify_call_args) rejects a mismatch — no new AST node, and\n                    // codegen sees only ordinary EFn/ECall. Exception (#705): a\n                    // TyFn annotation on a lambda value is distributed onto the\n                    // lambda itself instead (see distribute_local_fn_ann) so the\n                    // Perceus param heap-inference sees the param types.\n                    let val2 = match ann_type {\n                      Some(the_type) => match distribute_local_fn_ann(the_type, val) {\n                        Some(distributed) => distributed,\n                        None => ascribe_wrap(val, the_type)\n                      },\n                      None => val\n                    }\n                    ArrayBuilder::push(steps, StepLet(name, val2))\n                    p = next_pos\n                  }\n                }\n              }\n            }\n          },\n          TLParen => {\n            let (pat, pn) = parse_pattern(tokens, next)\n            let eq = expect_tk(tokens, pn, \"=\")\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\n            if next_pos <= eq {\n              throw(\"internal parser error: block let-pat parser did not advance\")\n            } else {\n              ArrayBuilder::push(steps, StepPattern(pat, val))\n              p = next_pos\n            }\n          },\n          _ => throw(\"expected identifier after 'let'\")\n        }\n      },\n      _ => {\n        let (e, next) = parse_recur(tokens, p, 0)\n        if next <= p {\n          throw(\"internal parser error: block expr parser did not advance\")\n        } else {\n          match peek(tokens, next) {\n            TRBrace => {\n              ArrayBuilder::push(steps, StepValue(e))\n              end_pos = next + 1\n              done = true\n            },\n            TSemicolon => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next + 1\n            },\n            TEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssign(name, val))\n                p = next_pos\n              },\n              EDot(obj, field, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                let set_args = empty_exprs()\n                Array::push(set_args, obj)\n                Array::push(set_args, EString(field))\n                Array::push(set_args, val)\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"__set_field\", -1), set_args, -1)))\n                p = next_pos\n              },\n              ECall(sidx_callee, sidx_args, _) => {\n                // `arr[i] = v` in the step-block path (same desugar as the\n                // parse_block_after_expr TEq arm above).\n                let s_is_index = match sidx_callee {\n                  EIdent(sicn, _) => sicn == \"__index\",\n                  _ => false\n                }\n                if s_is_index && Array::length(sidx_args) == 2 {\n                  let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                  let set_args = empty_exprs()\n                  Array::push(set_args, Array::get(sidx_args, 0))\n                  Array::push(set_args, Array::get(sidx_args, 1))\n                  Array::push(set_args, val)\n                  ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\"Array::set\", -1), set_args, -1)))\n                  p = next_pos\n                } else {\n                  throw(\"invalid assignment target\")\n                }\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPlusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"+\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TMinusEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"-\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TStarEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"*\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TSlashEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"/\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            TPercentEq => match e {\n              EIdent(name, _) => {\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\n                ArrayBuilder::push(steps, StepAssignOp(name, \"%\", val))\n                p = next_pos\n              },\n              _ => throw(\"invalid assignment target\")\n            },\n            _ => {\n              ArrayBuilder::push(steps, StepSeq(e))\n              p = next\n            }\n          }\n        }\n      }\n    }\n  }\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\n}\n\n// `for await x in s { body }` is parsed to `EForIn(x, _, __await_iter(s), body)`\n// — the iterable wrapped in a `__await_iter` marker call. The marker carries the\n// `await` intent past the parser (which has no type information) to the\n// dict-passing desugar (`desugar_trait_dict.vibe`), which picks the iterator vs\n// pull-closure loop by `s`'s type and strips the marker. The checker unwraps the\n// marker so it never sees `__await_iter` as a real function (docs/spec §M2c-3).\n\nexport let parse_impl_dispatch: (Array[Token], Array[Int], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, mode, parse_recur) -> {\n  if mode == 20 {\n    parse_impl_block(tokens, starts, pos, parse_recur)\n  } else if mode == 21 {\n    // Parse cond with the no-is variant so a trailing `is pattern` belongs\n    // to the if-cond pattern slot rather than collapsing into a Bool match.\n    let (cond, cn) = parse_infix_no_is(tokens, starts, pos, 0, pos, parse_recur)\n    let mut is_mode = false\n    let mut is_pat_val = PWild\n    let mut brace_pos = cn\n    match peek(tokens, cn) {\n      TIs => {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      TIdent(kw) => if kw == \"is\" {\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\n        is_mode = true\n        is_pat_val = pat\n        brace_pos = pn\n      },\n      _ => ()\n    }\n    let br = expect_tk(tokens, brace_pos, \"{\")\n    let (then_e, tn) = parse_recur(tokens, br, 20)\n    let (else_e, end_pos) = match peek(tokens, tn) {\n      TElse => match peek(tokens, tn + 1) {\n        TIf => parse_recur(tokens, tn + 2, 21),\n        TLBrace => parse_recur(tokens, tn + 2, 20),\n        _ => parse_recur(tokens, tn + 1, 0)\n      },\n      _ => (EUnit, tn)\n    }\n    if is_mode {\n      (EMatch(cond, [\n        (is_pat_val, then_e),\n        (PWild, else_e)\n      ]), end_pos)\n    } else {\n      (EIf(cond, then_e, else_e), end_pos)\n    }\n  } else if mode == 22 {\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, sn, \"{\")\n    match peek(tokens, br) {\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\n      _ => {\n        // #666: collect arms as (pattern, guard|EBool(true), body). If any arm\n        // carries a guard, bind the scrutinee to a temp `__mg` (so a failed\n        // guard can re-match it without re-evaluating a side-effecting\n        // scrutinee) and desugar guards into nested EIf/EMatch. Otherwise emit\n        // a plain EMatch.\n        let ab = ArrayBuilder::new()\n        let hg = [false]\n        let endpos = collect_match_arms(tokens, starts, br, ab, hg, parse_recur)\n        let arms3 = ArrayBuilder::freeze(ab)\n        if Array::get(hg, 0) {\n          let final_arms = desugar_guarded(arms3, 0, EIdent(\"__mg\", 0 - 1))\n          (ELet(\"__mg\", scrutinee, EMatch(EIdent(\"__mg\", 0 - 1), final_arms)), endpos)\n        } else {\n          let plain = ArrayBuilder::new()\n          let mut k = 0\n          while k < Array::length(arms3) {\n            let (p, _, bd) = Array::get(arms3, k)\n            ArrayBuilder::push(plain, (p, bd))\n            k = k + 1\n          }\n          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)\n        }\n      }\n    }\n  } else if mode == 23 {\n    let (cond, cn) = parse_recur(tokens, pos, 0)\n    let br = expect_tk(tokens, cn, \"{\")\n    let (body, end) = parse_recur(tokens, br, 20)\n    (EWhile(cond, body), end)\n  } else if mode == 24 {\n    let br = expect_tk(tokens, pos, \"{\")\n    let (body, bn) = parse_recur(tokens, br, 20)\n    let wp = expect_tk(tokens, bn, \"with\")\n    let (effect_name, effect_next) = match peek(tokens, wp) {\n      TIdent(name) => (name, wp + 1),\n      _ => throw(\"expected effect name after 'with'\")\n    }\n    let hb = expect_tk(tokens, effect_next, \"{\")\n    match peek(tokens, hb) {\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\n      _ => {\n        let b = ArrayBuilder::new()\n        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur)\n        ArrayBuilder::push(b, arm)\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\n      }\n    }\n  } else if mode == 25 {\n    // `for await x in stream { ... }`: `await` is not a keyword (it is the\n    // builtin call `await(...)`), so detect the async-iterator marker as an\n    // `await` identifier immediately followed by the binding name. When present,\n    // the iterable is wrapped in a `__await_iter(..)` marker so the desugar can\n    // pick the iterator vs pull-closure loop by type (docs/spec §M2c-3). Without\n    // the marker, `for x in arr` iterates an eager Array[T] via EForIn. A loop\n    // variable literally named `await` (`for await in e`) is still parsed as a\n    // binding because `await` is then followed by `in`, so `is_await` stays\n    // false.\n    let mut start = pos\n    let mut is_await = false\n    match peek(tokens, pos) {\n      TIdent(marker) => if marker == \"await\" {\n        match peek(tokens, pos + 1) {\n          TIdent(_) => { start = pos + 1; is_await = true },\n          _ => ()\n        }\n      } else (),\n      _ => ()\n    }\n    match peek(tokens, start) {\n      TIdent(first_name) => match peek(tokens, start + 1) {\n        TComma => match peek(tokens, start + 2) {\n          TIdent(second_name) => {\n            let ip = expect_tk(tokens, start + 3, \"in\")\n            match parse_recur(tokens, ip, 0) {\n              (iterable, after_iter) => {\n                let bb = expect_tk(tokens, after_iter, \"{\")\n                let (body, end) = parse_recur(tokens, bb, 20)\n                let loop_expr = if is_await {\n                  EForIn(second_name, Some(first_name), ECall(EIdent(\"__await_iter\", -1), [\n                    iterable\n                  ], -1), body)\n                } else {\n                  EForIn(second_name, Some(first_name), iterable, body)\n                }\n                (loop_expr, end)\n              },\n              _ => throw(\"unreachable: parse_recur for for-in\")\n            }\n          },\n          _ => throw(\"expected value binding name after ','\")\n        },\n        _ => {\n          let ip = expect_tk(tokens, start + 1, \"in\")\n          match parse_recur(tokens, ip, 0) {\n            (iterable, after_iter) => {\n              let bb = expect_tk(tokens, after_iter, \"{\")\n              let (body, end) = parse_recur(tokens, bb, 20)\n              let loop_expr = if is_await {\n                EForIn(first_name, None, ECall(EIdent(\"__await_iter\", -1), [\n                  iterable\n                ], -1), body)\n              } else {\n                EForIn(first_name, None, iterable, body)\n              }\n              (loop_expr, end)\n            },\n            _ => throw(\"unreachable: parse_recur for for-in\")\n          }\n        }\n      }\n      ,\n      _ => throw(\"expected identifier after 'for'\")\n    }\n  } else {\n    let actual = tk_name(peek(tokens, pos))\n    throw(\"internal parser error: unknown parse mode \\{mode} at #\\{pos} token=\\{actual}\")\n  }\n}\n")
}

let cli_adapter_source_17 = () -> (String, String) {
  ("vibe/compiler/syntax/expand_interp.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ./lexer.vibe {\n  lex\n}\n\nimport ./parser_expr.vibe {\n  parse\n}\n\nimport ./token.vibe {\n  Token\n}\n\n//# Functions\n\nlet rec resolve_expr: (Expr) -> Expr with { Error } = (e) -> {\n  let desugar_parts: (Array[String]) -> Expr with { Error } = (parts) -> {\n    let plen = Array::length(parts)\n    let exprs = ArrayBuilder::new()\n    let mut i = 0\n    while i < plen {\n      let lit = Array::get(parts, i)\n      if String::length(lit) > 0 {\n        ArrayBuilder::push(exprs, EString(lit))\n      }\n      if i + 1 < plen {\n        let expr_src = Array::get(parts, i + 1)\n        let expr_tokens = lex(expr_src)\n        let parsed = parse(expr_tokens)\n        let resolved = resolve_expr(parsed)\n        ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\", -1), [\n          resolved\n        ], -1))\n      }\n      i = i + 2\n    }\n    let result_arr = ArrayBuilder::freeze(exprs)\n    let result_len = Array::length(result_arr)\n    if result_len == 0 {\n      EString(\"\")\n    } else {\n      let mut result = Array::get(result_arr, 0)\n      let mut j = 1\n      while j < result_len {\n        result = ECall(EIdent(\"String::concat\", -1), [\n          result,\n          Array::get(result_arr, j)\n        ], -1)\n        j = j + 1\n      }\n      result\n    }\n  }\n  let resolve_arr: (Array[Expr]) -> Array[Expr] with { Error } = (exprs) -> {\n    for ex in exprs {\n      resolve_expr(ex)\n    }\n  }\n  match e {\n    EStringInterp(parts) => desugar_parts(parts),\n    EInt(_) => e,\n    EFloat(_) => e,\n    EString(_) => e,\n    EBool(_) => e,\n    EUnit => e,\n    EIdent(_, _) => e,\n    ETuple(elems) => ETuple(resolve_arr(elems)),\n    EArray(elems) => EArray(resolve_arr(elems)),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (n, v) = f; (n, resolve_expr(v))\n    }),\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\n    ELet(n, v, b) => ELet(n, resolve_expr(v), resolve_expr(b)),\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\n    ELetMut(n, v, b) => ELetMut(n, resolve_expr(v), resolve_expr(b)),\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms {\n      let (p, ex) = a; (p, resolve_expr(ex))\n    }),\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param; (name, resolve_expr(init))\n    }, resolve_expr(body)),\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\n    ECall(callee, args, off) => ECall(resolve_expr(callee), resolve_arr(args), off),\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\n    EDot(inner, field, off) => EDot(resolve_expr(inner), field, off),\n    EThrow(inner) => EThrow(resolve_expr(inner)),\n    EReturn(inner) => EReturn(resolve_expr(inner)),\n    EBreak(opt) => match opt {\n      None => e,\n      Some(v) => EBreak(Some(resolve_expr(v)))\n    },\n    EContinue(args) => EContinue(resolve_arr(args)),\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\n    ESpread(inner) => ESpread(resolve_expr(inner))\n  }\n}\n\nlet resolve_stmt: (Stmt) -> Stmt with { Error } = (s) -> {\n  match s {\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\n    STest(name, body) => STest(name, resolve_expr(body)),\n    SBench(name, body) => SBench(name, resolve_expr(body)),\n    SExpr(e) => SExpr(resolve_expr(e)),\n    _ => s\n  }\n}\n\nexport let resolve_interp_expr: (Expr) -> Expr with { Error } = (e) -> {\n  resolve_expr(e)\n}\n\nexport let resolve_interp_stmts: (Array[Stmt]) -> Array[Stmt] with { Error } = (stmts) -> {\n  for s in stmts {\n    resolve_stmt(s)\n  }\n}\n")
}

let cli_adapter_source_18 = () -> (String, String) {
  ("vibe/compiler/syntax/import_alias_rewrite.vibe",
"//# Imports\n\nimport ../core/ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nimport ../module_graph_path.vibe {\n  dir_of_path, resolve_import_path_candidates\n}\n\n//# Functions\n\nlet empty_aliases: () -> Array[(String, String)] = () -> {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_import_refs: () -> Array[(String, String, String)] = () -> {\n  Array::slice([\n    (\"\", \"\", \"\")\n  ], 0, 0)\n}\n\nlet string_array_contains: (Array[String], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet import_ref_array_contains_local: (Array[(String, String, String)], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    let (_, _, local) = Array::get(items, i)\n    if local == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet import_ref_has_other_path_for_original: (Array[(String, String, String)], String, String) -> Bool = (items, raw_path, original) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    let (other_path, other_original, _) = Array::get(items, i)\n    if other_original == original && other_path != raw_path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet lookup_alias: (Array[(String, String)], String) -> Option[String] = (aliases, name) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(aliases) {\n    let (alias, original) = Array::get(aliases, i)\n    if alias == name {\n      found = Some(original)\n      i = Array::length(aliases)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet alias_map_without_name: (Array[(String, String)], String) -> Array[(String, String)] = (aliases, name) -> {\n  let out = empty_aliases()\n  let mut i = 0\n  while i < Array::length(aliases) {\n    let (alias, original) = Array::get(aliases, i)\n    if alias != name {\n      Array::push(out, (alias, original))\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet alias_map_without_names: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (aliases, names) -> {\n  let out = empty_aliases()\n  let mut i = 0\n  while i < Array::length(aliases) {\n    let (alias, original) = Array::get(aliases, i)\n    if !string_array_contains(names, alias) {\n      Array::push(out, (alias, original))\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet rec pat_binds_name: (Pat, String) -> Bool = (pat, name) -> {\n  match pat {\n    PBind(bound) => bound == name,\n    PCtor(_, pats) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(pats) && !found {\n        if pat_binds_name(Array::get(pats, i), name) {\n          found = true\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    PTuple(pats) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(pats) && !found {\n        if pat_binds_name(Array::get(pats, i), name) {\n          found = true\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),\n    PStruct(_, fields) => {\n      let mut found = false\n      let mut i = 0\n      while i < Array::length(fields) && !found {\n        let (_, field_pat) = Array::get(fields, i)\n        if pat_binds_name(field_pat, name) {\n          found = true\n        } else {\n          i = i + 1\n        }\n      }\n      found\n    },\n    _ => false\n  }\n}\n\nlet alias_map_without_pat: (Array[(String, String)], Pat) -> Array[(String, String)] = (aliases, pat) -> {\n  let out = empty_aliases()\n  let mut i = 0\n  while i < Array::length(aliases) {\n    let (alias, original) = Array::get(aliases, i)\n    if !pat_binds_name(pat, alias) {\n      Array::push(out, (alias, original))\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet param_binds_name: (Array[(String, Option[TypeExpr])], String) -> Bool = (params, name) -> {\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(params) && !found {\n    let (param_name, _) = Array::get(params, i)\n    if param_name == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet alias_map_without_params: (Array[(String, String)], Array[(String, Option[TypeExpr])]) -> Array[(String, String)] = (aliases, params) -> {\n  let out = empty_aliases()\n  let mut i = 0\n  while i < Array::length(aliases) {\n    let (alias, original) = Array::get(aliases, i)\n    if !param_binds_name(params, alias) {\n      Array::push(out, (alias, original))\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let rec rewrite_import_alias_expr: (Expr, Array[(String, String)]) -> Expr = (expr, aliases) -> {\n  match expr {\n    EIdent(name, _) => match lookup_alias(aliases, name) {\n      Some(original) => EIdent(original, -1),\n      None => expr\n    },\n    ETuple(items) => ETuple(for item in items {\n      rewrite_import_alias_expr(item, aliases)\n    }),\n    EArray(items) => EArray(for item in items {\n      rewrite_import_alias_expr(item, aliases)\n    }),\n    ERecord(fields) => ERecord(for field in fields {\n      let (name, value) = field\n      (name, rewrite_import_alias_expr(value, aliases))\n    }),\n    EIf(cond, then_expr, else_expr) => EIf(\n      rewrite_import_alias_expr(cond, aliases),\n      rewrite_import_alias_expr(then_expr, aliases),\n      rewrite_import_alias_expr(else_expr, aliases)\n    ),\n    ELet(name, value, body) => ELet(\n      name,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\n    ),\n    ELetRec(name, value, body) => {\n      let body_aliases = alias_map_without_name(aliases, name)\n      ELetRec(\n        name,\n        rewrite_import_alias_expr(value, body_aliases),\n        rewrite_import_alias_expr(body, body_aliases)\n      )\n    },\n    ELetMut(name, value, body) => ELetMut(\n      name,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\n    ),\n    EAssign(name, value, body) => EAssign(\n      name,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, aliases)\n    ),\n    EAssignOp(name, op, value, body) => EAssignOp(\n      name,\n      op,\n      rewrite_import_alias_expr(value, aliases),\n      rewrite_import_alias_expr(body, aliases)\n    ),\n    ESeq(left, right) => ESeq(\n      rewrite_import_alias_expr(left, aliases),\n      rewrite_import_alias_expr(right, aliases)\n    ),\n    EMatch(scrutinee, arms) => EMatch(rewrite_import_alias_expr(scrutinee, aliases), for arm in arms {\n      let (pat, body) = arm\n      (pat, rewrite_import_alias_expr(body, alias_map_without_pat(aliases, pat)))\n    }),\n    EHandle(body, arms) => EHandle(rewrite_import_alias_expr(body, aliases), for arm in arms {\n      let (pat, arm_body) = arm\n      (pat, rewrite_import_alias_expr(arm_body, alias_map_without_pat(aliases, pat)))\n    }),\n    EWhile(cond, body) => EWhile(\n      rewrite_import_alias_expr(cond, aliases),\n      rewrite_import_alias_expr(body, aliases)\n    ),\n    ELoop(params, body) => {\n      let out_params = for param in params {\n        let (name, init) = param\n        (name, rewrite_import_alias_expr(init, aliases))\n      }\n      let mut body_aliases = aliases\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, _) = Array::get(params, i)\n        body_aliases = alias_map_without_name(body_aliases, name)\n        i = i + 1\n      }\n      ELoop(out_params, rewrite_import_alias_expr(body, body_aliases))\n    },\n    EForIn(name, index_name, iter, body) => {\n      let body_aliases = match index_name {\n        Some(index_name) => alias_map_without_name(alias_map_without_name(aliases, name), index_name),\n        None => alias_map_without_name(aliases, name)\n      }\n      EForIn(\n        name,\n        index_name,\n        rewrite_import_alias_expr(iter, aliases),\n        rewrite_import_alias_expr(body, body_aliases)\n      )\n    },\n    ECall(callee, args, off) => ECall(rewrite_import_alias_expr(callee, aliases), for arg in args {\n      rewrite_import_alias_expr(arg, aliases)\n    }, off),\n    EBinOp(op, left, right) => EBinOp(\n      op,\n      rewrite_import_alias_expr(left, aliases),\n      rewrite_import_alias_expr(right, aliases)\n    ),\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_import_alias_expr(value, aliases)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\n      type_params,\n      bounds,\n      params,\n      ret_ty,\n      effect,\n      rewrite_import_alias_expr(body, alias_map_without_params(aliases, params))\n    ),\n    EDot(obj, field, off) => EDot(rewrite_import_alias_expr(obj, aliases), field, off),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_import_alias_expr(body, aliases)),\n    EThrow(value) => EThrow(rewrite_import_alias_expr(value, aliases)),\n    EReturn(value) => EReturn(rewrite_import_alias_expr(value, aliases)),\n    EBreak(value) => match value {\n      Some(value) => EBreak(Some(rewrite_import_alias_expr(value, aliases))),\n      None => expr\n    },\n    EContinue(values) => EContinue(for value in values {\n      rewrite_import_alias_expr(value, aliases)\n    }),\n    EMap(fields) => EMap(for field in fields {\n      let (name, value) = field\n      (name, rewrite_import_alias_expr(value, aliases))\n    }),\n    ESpread(value) => ESpread(rewrite_import_alias_expr(value, aliases)),\n    _ => expr\n  }\n}\n\nexport let collect_import_aliases: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\n  let aliases = empty_aliases()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(_, items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let (original, alias_opt) = Array::get(items, j)\n          match alias_opt {\n            Some(alias) => if alias != original {\n              Array::push(aliases, (alias, original))\n            },\n            None => ()\n          }\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  aliases\n}\n\nlet collect_import_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {\n  let refs = empty_import_refs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let (original, alias_opt) = Array::get(items, j)\n          let local = match alias_opt {\n            Some(alias) => alias,\n            None => original\n          }\n          Array::push(refs, (raw_path, original, local))\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  refs\n}\n\nexport let collect_import_alias_collision_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {\n  let refs = collect_import_refs(stmts)\n  let out = empty_import_refs()\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {\n      Array::push(out, (raw_path, original, local))\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let collect_import_alias_collision_locals: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let out = empty_strings()\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (_, _, local) = Array::get(refs, i)\n    if !string_array_contains(out, local) {\n      Array::push(out, local)\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let rec rewrite_import_alias_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, aliases) -> {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => SLet(\n      exported,\n      is_rec,\n      name,\n      ty,\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\n    ),\n    SLetMut(name, ty, body) => SLetMut(\n      name,\n      ty,\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\n    ),\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, aliases)),\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, aliases)),\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, aliases)),\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, aliases)),\n    SModule(exported, name, stmts) => {\n      let module_aliases = collect_import_aliases(stmts)\n      SModule(exported, name, for inner_stmt in stmts {\n        rewrite_import_alias_stmt(inner_stmt, module_aliases)\n      })\n    },\n    _ => stmt\n  }\n}\n\nexport let rec stmts_have_import_deep: (Array[Stmt]) -> Bool = (stmts) -> {\n  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {\n    match stmt {\n      SImport(_, _) => true,\n      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),\n      _ => false\n    }\n  }\n  let mut found = false\n  let mut i = 0\n  while i < Array::length(stmts) && !found {\n    if stmt_has_import_deep(Array::get(stmts, i)) {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let append_non_import_stmts_without_alias_rewrite: (Array[Stmt], Array[Stmt]) -> Unit = (merged, stmts) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      _ => Array::push(merged, stmt)\n    }\n    i = i + 1\n  }\n}\n\nexport let append_import_alias_rewritten_non_import_stmts_skipping: (Array[Stmt], Array[Stmt], Array[String]) -> Unit = (merged, stmts, skipped_locals) -> {\n  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)\n  let should_rewrite = Array::length(aliases) > 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, aliases)),\n      _ => if should_rewrite {\n        Array::push(merged, rewrite_import_alias_stmt(stmt, aliases))\n      } else {\n        Array::push(merged, stmt)\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport let append_import_alias_rewritten_non_import_stmts: (Array[Stmt], Array[Stmt]) -> Unit = (merged, stmts) -> {\n  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())\n}\n\nexport let rewrite_imported_value_stmt_to_local: (Stmt, String, String) -> Option[Stmt] = (stmt, original, local) -> {\n  let aliases = Array::slice([\n    (original, local)\n  ], 0, 1)\n  let rewrite_value: (Expr) -> Expr = (expr) -> {\n    if original == local {\n      expr\n    } else {\n      rewrite_import_alias_expr(expr, aliases)\n    }\n  }\n  match stmt {\n    SLet(_, is_rec, name, ty, body) => if name == original {\n      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))\n    } else {\n      None\n    },\n    SLetMut(name, ty, body) => if name == original {\n      Some(SLetMut(local, ty, rewrite_value(body)))\n    } else {\n      None\n    },\n    _ => None\n  }\n}\n\nlet sanitize_namespace_char: (Int) -> String = (code) -> {\n  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {\n    String::from_char_code(code)\n  } else {\n    \"_\"\n  }\n}\n\nlet sanitize_namespace_path: (String) -> String = (path) -> {\n  // O(N) build via StringBuilder; the previous `out = String::concat(out, ...)`\n  // per char was O(N²) over the path length (issue #366).\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(path) {\n    StringBuilder::push(out, sanitize_namespace_char(String::char_code_at(path, i)))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nlet namespace_private_name: (String, String) -> String = (path, name) -> {\n  String::concat(name, String::concat(\"_dep_\", sanitize_namespace_path(path)))\n}\n\nlet namespace_private_name_with_suffix: (String, String) -> String = (namespace_suffix, name) -> {\n  String::concat(name, String::concat(\"_dep_\", namespace_suffix))\n}\n\nlet namespace_private_name_lazy: (String, String, Array[String]) -> String = (path, name, suffix_box) -> {\n  let current = Array::get(suffix_box, 0)\n  let suffix = if String::length(current) == 0 {\n    let sanitized = sanitize_namespace_path(path)\n    Array::set(suffix_box, 0, sanitized)\n    sanitized\n  } else {\n    current\n  }\n  namespace_private_name_with_suffix(suffix, name)\n}\n\nlet collect_exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {\n        Array::push(names, name)\n      },\n      SExport(items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let name = Array::get(items, j)\n          if !string_array_contains(names, name) {\n            Array::push(names, name)\n          }\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  names\n}\n\n// The names of types declared `export` in `stmts` (struct/enum/trait/alias/\n// suberror). A qualified method `Type::m` whose `Type` is exported is part of\n// that type's public surface, so it must NOT be module-private-renamed.\nlet collect_exported_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(true, name, _, _, _) => Array::push(names, name),\n      SEnum(true, name, _, _, _) => Array::push(names, name),\n      STrait(true, name, _, _, _) => Array::push(names, name),\n      STypeAlias(true, name, _, _) => Array::push(names, name),\n      SSuberror(true, name, _) => Array::push(names, name),\n      _ => ()\n    }\n    i = i + 1\n  }\n  names\n}\n\n// The names of ALL types declared in `stmts` (exported or not). Used with\n// collect_exported_type_names to decide which qualified methods are private.\nlet collect_declared_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, _, _, _) => Array::push(names, name),\n      SEnum(_, name, _, _, _) => Array::push(names, name),\n      STrait(_, name, _, _, _) => Array::push(names, name),\n      STypeAlias(_, name, _, _) => Array::push(names, name),\n      SSuberror(_, name, _) => Array::push(names, name),\n      _ => ()\n    }\n    i = i + 1\n  }\n  names\n}\n\n// A qualified `Head::member` value (an impl/trait method `let Type::m = ..`)\n// on a PUBLIC receiver type. Such methods are resolved globally by the\n// receiver type and are referenced unqualified by that type's name, so\n// path-suffixing them in an imported module (`Strm::next` -> `Strm::next$path`)\n// would orphan them from `Strm` — breaking method dispatch and the trait /\n// `for`-iterator desugar's `Type::method` lookup. Public means the head is\n// either exported from this module OR not declared in it at all — the latter\n// covers impls on BUILTIN types (`impl Iterable for Array` desugars to a\n// non-exported `let Array::iter_length = ..` whose head \"Array\" no module\n// declares; #736 hit this when the prelude's builtin Iterable impls were\n// private-renamed and orphaned from the witness dispatch). Only methods whose\n// head is a type declared in this module and NOT exported keep the old\n// whole-name renaming: that private type is itself renamed and its call sites\n// are rewritten through the same value-rename map, so they stay consistent.\nlet qualified_method_of_exported_type: (String, Array[String], Array[String]) -> Bool = (name, exported_types, declared_types) -> {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    false\n  } else {\n    let head = String::substring(name, 0, idx)\n    if string_array_contains(exported_types, head) {\n      true\n    } else {\n      !string_array_contains(declared_types, head)\n    }\n  }\n}\n\nlet collect_private_value_renames: (String, Array[Stmt], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, namespace_suffix_box, exported) -> {\n  let renames = empty_aliases()\n  let exported_types = collect_exported_type_names(stmts)\n  let declared_types = collect_declared_type_names(stmts)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types, declared_types) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      SLetMut(name, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  renames\n}\n\nlet rec rewrite_private_type_expr: (TypeExpr, Array[(String, String)]) -> TypeExpr = (ty, renames) -> {\n  match ty {\n    TyName(name) => match lookup_alias(renames, name) {\n      Some(renamed) => TyName(renamed),\n      None => ty\n    },\n    TyApp(name, args) => {\n      let next_name = match lookup_alias(renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      TyApp(next_name, for arg in args {\n        rewrite_private_type_expr(arg, renames)\n      })\n    },\n    TyFn(params, ret, effect_name) => TyFn(\n      for param in params {\n        rewrite_private_type_expr(param, renames)\n      },\n      rewrite_private_type_expr(ret, renames),\n      effect_name\n    ),\n    TyTuple(items) => TyTuple(for item in items {\n      rewrite_private_type_expr(item, renames)\n    }),\n    TyUnit => ty\n  }\n}\n\nlet rewrite_private_type_opt: (Option[TypeExpr], Array[(String, String)]) -> Option[TypeExpr] = (ty, renames) -> {\n  match ty {\n    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),\n    None => None\n  }\n}\n\nlet rewrite_private_params: (Array[(String, Option[TypeExpr])], Array[(String, String)]) -> Array[(String, Option[TypeExpr])] = (params, type_renames) -> {\n  for param in params {\n    let (name, ty) = param\n    (name, rewrite_private_type_opt(ty, type_renames))\n  }\n}\n\nlet rec rewrite_private_type_ctor_pat: (Pat, Array[(String, String)], Array[(String, String)]) -> Pat = (pat, type_renames, ctor_renames) -> {\n  match pat {\n    PCtor(name, pats) => {\n      let next_name = match lookup_alias(ctor_renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      PCtor(next_name, for item in pats {\n        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\n      })\n    },\n    PTuple(pats) => PTuple(for item in pats {\n      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\n    }),\n    POr(left, right) => POr(\n      rewrite_private_type_ctor_pat(left, type_renames, ctor_renames),\n      rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)\n    ),\n    PStruct(name, fields) => {\n      let next_name = match lookup_alias(type_renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      PStruct(next_name, for field in fields {\n        let (field_name, field_pat) = field\n        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))\n      })\n    },\n    _ => pat\n  }\n}\n\nlet rec rewrite_private_type_ctor_expr: (Expr, Array[(String, String)], Array[(String, String)]) -> Expr = (expr, type_renames, ctor_renames) -> {\n  match expr {\n    EIdent(name, _) => match lookup_alias(ctor_renames, name) {\n      Some(renamed) => EIdent(renamed, -1),\n      None => expr\n    },\n    ETuple(items) => ETuple(for item in items {\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\n    }),\n    EArray(items) => EArray(for item in items {\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\n    }),\n    ERecord(fields) => ERecord(for field in fields {\n      let (name, value) = field\n      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\n    }),\n    EIf(cond, then_expr, else_expr) => EIf(\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)\n    ),\n    ELet(name, value, body) => ELet(\n      name,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n    ),\n    ELetRec(name, value, body) => {\n      let body_ctors = alias_map_without_name(ctor_renames, name)\n      ELetRec(\n        name,\n        rewrite_private_type_ctor_expr(value, type_renames, body_ctors),\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\n      )\n    },\n    ELetMut(name, value, body) => ELetMut(\n      name,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n    ),\n    EAssign(name, value, body) => EAssign(\n      name,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\n    ),\n    EAssignOp(name, op, value, body) => EAssignOp(\n      name,\n      op,\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\n    ),\n    ESeq(left, right) => ESeq(\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\n    ),\n    EMatch(scrutinee, arms) => EMatch(\n      rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames),\n      for arm in arms {\n        let (pat, body) = arm\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n        (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n      }\n    ),\n    EHandle(body, arms) => EHandle(\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames),\n      for arm in arms {\n        let (pat, arm_body) = arm\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n        (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n      }\n    ),\n    EWhile(cond, body) => EWhile(\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\n    ),\n    ELoop(params, body) => {\n      let out_params = for param in params {\n        let (name, init) = param\n        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))\n      }\n      let mut body_ctors = ctor_renames\n      let mut i = 0\n      while i < Array::length(params) {\n        let (name, _) = Array::get(params, i)\n        body_ctors = alias_map_without_name(body_ctors, name)\n        i = i + 1\n      }\n      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))\n    },\n    EForIn(name, index_name, iter, body) => {\n      let body_ctors = match index_name {\n        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),\n        None => alias_map_without_name(ctor_renames, name)\n      }\n      EForIn(\n        name,\n        index_name,\n        rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames),\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\n      )\n    },\n    ECall(callee, args, off) => ECall(\n      rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames),\n      for arg in args {\n        rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)\n      },\n      off\n    ),\n    EBinOp(op, left, right) => EBinOp(\n      op,\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\n    ),\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\n      type_params,\n      bounds,\n      rewrite_private_params(params, type_renames),\n      rewrite_private_type_opt(ret_ty, type_renames),\n      effect,\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))\n    ),\n    EDot(obj, field, off) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    EThrow(value) => EThrow(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    EBreak(value) => match value {\n      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),\n      None => expr\n    },\n    EContinue(values) => EContinue(for value in values {\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)\n    }),\n    EMap(fields) => EMap(for field in fields {\n      let (name, value) = field\n      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\n    }),\n    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\n    _ => expr\n  }\n}\n\nlet collect_private_type_renames: (String, Array[Stmt], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, namespace_suffix_box, exported) -> {\n  let renames = empty_aliases()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(false, name, _, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      SStruct(false, name, _, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      SSuberror(false, name, _) => if !string_array_contains(exported, name) {\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  renames\n}\n\nlet collect_private_ctor_renames: (String, Array[Stmt], Array[(String, String)], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, type_renames, namespace_suffix_box, exported) -> {\n  let renames = empty_aliases()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SEnum(false, type_name, _, ctors, _) => if !string_array_contains(exported, type_name) {\n        let mut j = 0\n        while j < Array::length(ctors) {\n          let (ctor_name, _) = Array::get(ctors, j)\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\n          j = j + 1\n        }\n      },\n      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {\n        let mut j = 0\n        while j < Array::length(ctors) {\n          let (ctor_name, _) = Array::get(ctors, j)\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  type_renames\n  renames\n}\n\nexport let rec namespace_private_value_stmts: (String, Array[Stmt]) -> Array[Stmt] = (path, stmts) -> {\n  let namespace_private_type_ctor_stmt_local: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {\n    match stmt {\n      SLet(exported, is_rec, name, ty, body) => SLet(\n        exported,\n        is_rec,\n        name,\n        rewrite_private_type_opt(ty, type_renames),\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n      ),\n      SLetMut(name, ty, body) => SLetMut(\n        name,\n        rewrite_private_type_opt(ty, type_renames),\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n      ),\n      SEnum(exported, name, params, ctors, derives) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        SEnum(exported, next_name, params, for ctor in ctors {\n          let (ctor_name, args) = ctor\n          let next_ctor = if exported {\n            ctor_name\n          } else {\n            match lookup_alias(ctor_renames, ctor_name) {\n              Some(renamed) => renamed,\n              None => ctor_name\n            }\n          }\n          (next_ctor, for arg in args {\n            rewrite_private_type_expr(arg, type_renames)\n          })\n        }, derives)\n      },\n      SSuberror(exported, name, ctors) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        SSuberror(exported, next_name, for ctor in ctors {\n          let (ctor_name, args) = ctor\n          let next_ctor = if exported {\n            ctor_name\n          } else {\n            match lookup_alias(ctor_renames, ctor_name) {\n              Some(renamed) => renamed,\n              None => ctor_name\n            }\n          }\n          (next_ctor, for arg in args {\n            rewrite_private_type_expr(arg, type_renames)\n          })\n        })\n      },\n      SStruct(exported, name, fields, derives, mut_fields) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        SStruct(exported, next_name, for field in fields {\n          let (field_name, field_ty) = field\n          (field_name, rewrite_private_type_expr(field_ty, type_renames))\n        }, derives, mut_fields)\n      },\n      STypeAlias(exported, name, params, target) => {\n        let next_name = if exported {\n          name\n        } else {\n          match lookup_alias(type_renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n        }\n        STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\n      },\n      SImpl(tparams, bounds, trait_name, target_name) => {\n        let next_target = match lookup_alias(type_renames, target_name) {\n          Some(renamed) => renamed,\n          None => target_name\n        }\n        SImpl(tparams, bounds, trait_name, next_target)\n      },\n      SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\n      STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n      SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n      SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n      SLetPat(pat, body) => {\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n        SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n      },\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\n      SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\n        let (op_name, op_params, ret_ty) = op\n        (op_name, for param in op_params {\n          rewrite_private_type_expr(param, type_renames)\n        }, rewrite_private_type_expr(ret_ty, type_renames))\n      }),\n      _ => stmt\n    }\n  }\n  let namespace_private_stmt_local: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {\n    match stmt {\n      SLet(exported, is_rec, name, ty, body) => {\n        let next_name = match lookup_alias(renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n        SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\n      },\n      SLetMut(name, ty, body) => {\n        let next_name = match lookup_alias(renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n        SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\n      },\n      STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\n      SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\n      SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\n      SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\n      _ => stmt\n    }\n  }\n  let namespace_suffix_box = [\"\"]\n  let exported = collect_exported_value_names(stmts)\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\n  let value_renamed = if Array::length(renames) == 0 {\n    stmts\n  } else {\n    for stmt in stmts {\n      namespace_private_stmt_local(stmt, renames)\n    }\n  }\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\n    value_renamed\n  } else {\n    for stmt in value_renamed {\n      namespace_private_type_ctor_stmt_local(stmt, type_renames, ctor_renames)\n    }\n  }\n}\n\nlet namespace_private_type_ctor_stmt: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => SLet(\n      exported,\n      is_rec,\n      name,\n      rewrite_private_type_opt(ty, type_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n    ),\n    SLetMut(name, ty, body) => SLetMut(\n      name,\n      rewrite_private_type_opt(ty, type_renames),\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\n    ),\n    SEnum(exported, name, params, ctors, derives) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      SEnum(exported, next_name, params, for ctor in ctors {\n        let (ctor_name, args) = ctor\n        let next_ctor = if exported {\n          ctor_name\n        } else {\n          match lookup_alias(ctor_renames, ctor_name) {\n            Some(renamed) => renamed,\n            None => ctor_name\n          }\n        }\n        (next_ctor, for arg in args {\n          rewrite_private_type_expr(arg, type_renames)\n        })\n      }, derives)\n    },\n    SSuberror(exported, name, ctors) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      SSuberror(exported, next_name, for ctor in ctors {\n        let (ctor_name, args) = ctor\n        let next_ctor = if exported {\n          ctor_name\n        } else {\n          match lookup_alias(ctor_renames, ctor_name) {\n            Some(renamed) => renamed,\n            None => ctor_name\n          }\n        }\n        (next_ctor, for arg in args {\n          rewrite_private_type_expr(arg, type_renames)\n        })\n      })\n    },\n    SStruct(exported, name, fields, derives, mut_fields) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      SStruct(exported, next_name, for field in fields {\n        let (field_name, field_ty) = field\n        (field_name, rewrite_private_type_expr(field_ty, type_renames))\n      }, derives, mut_fields)\n    },\n    STypeAlias(exported, name, params, target) => {\n      let next_name = if exported {\n        name\n      } else {\n        match lookup_alias(type_renames, name) {\n          Some(renamed) => renamed,\n          None => name\n        }\n      }\n      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\n    },\n    SImpl(tparams, bounds, trait_name, target_name) => {\n      let next_target = match lookup_alias(type_renames, target_name) {\n        Some(renamed) => renamed,\n        None => target_name\n      }\n      SImpl(tparams, bounds, trait_name, next_target)\n    },\n    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\n    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\n    SLetPat(pat, body) => {\n      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\n      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\n    },\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\n    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\n      let (op_name, op_params, ret_ty) = op\n      (op_name, for param in op_params {\n        rewrite_private_type_expr(param, type_renames)\n      }, rewrite_private_type_expr(ret_ty, type_renames))\n    }),\n    _ => stmt\n  }\n}\n\nlet namespace_private_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {\n  match stmt {\n    SLet(exported, is_rec, name, ty, body) => {\n      let next_name = match lookup_alias(renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\n    },\n    SLetMut(name, ty, body) => {\n      let next_name = match lookup_alias(renames, name) {\n        Some(renamed) => renamed,\n        None => name\n      }\n      SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\n    },\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\n    _ => stmt\n  }\n}\n\nlet namespace_private_value_stmts_legacy_ordered: (String, Array[Stmt]) -> Array[Stmt] = (path, stmts) -> {\n  let namespace_suffix_box = [\"\"]\n  let exported = collect_exported_value_names(stmts)\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\n  let value_renamed = if Array::length(renames) == 0 {\n    stmts\n  } else {\n    for stmt in stmts {\n      namespace_private_stmt(stmt, renames)\n    }\n  }\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\n    value_renamed\n  } else {\n    for stmt in value_renamed {\n      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames)\n    }\n  }\n}\n\n//# #716 export-name visibility\n\n// The merge flattens every file's top-level statements into one program, so a\n// bare exported name used to be globally visible: two files exporting the\n// same name collided (function-table first match, by merge order), an export\n// shadowing a bare BUILTIN name (float.vibe's `eq`) raced the builtin\n// fast-path in every file, and any file could call an export it never\n// imported. The plan below renames EVERY exported value def of a non-entry\n// file to `name_exp_<path>` at its defining file and rewrites the references\n// of files that actually `import` it — full import visibility (#716): a name\n// resolves exactly where it is imported (or defined). The ENTRY file's own\n// defs and the names its re-export surface resolves to are never renamed:\n// they are the program's wasm-export / linked-library ABI.\n\nexport let namespace_exported_name: (String, String) -> String = (path, name) -> {\n  String::concat(name, String::concat(\"_exp_\", sanitize_namespace_path(path)))\n}\n\n// Top-level VALUE defs this file exports under a bare (unqualified) name:\n// `export let f` plus a plain `let f` listed in an `export { ... }` block.\n// Excludes qualified `Type::method` lets (dispatched globally by receiver\n// type), `let mut` globals (an `EAssign` target is a plain string the\n// expression rewriter cannot rename), and extern lets (host import names).\nexport let collect_export_def_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let extern_names = empty_strings()\n  let let_names = empty_strings()\n  let exported_lets = empty_strings()\n  let export_items = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exported, _, name, _, _) => {\n        Array::push(let_names, name)\n        if exported {\n          Array::push(exported_lets, name)\n        } else {\n          ()\n        }\n      },\n      SExternLet(name, _) => Array::push(extern_names, name),\n      SExport(items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          Array::push(export_items, Array::get(items, j))\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let out = empty_strings()\n  let push_def_name: (String) -> Unit = (name) -> {\n    if String::index_of(name, \"::\") < 0 && !string_array_contains(extern_names, name) && !string_array_contains(out, name) {\n      Array::push(out, name)\n    } else {\n      ()\n    }\n  }\n  let mut k = 0\n  while k < Array::length(exported_lets) {\n    push_def_name(Array::get(exported_lets, k))\n    k = k + 1\n  }\n  let mut m = 0\n  while m < Array::length(export_items) {\n    let name = Array::get(export_items, m)\n    if string_array_contains(let_names, name) {\n      push_def_name(name)\n    } else {\n      ()\n    }\n    m = m + 1\n  }\n  out\n}\n\nexport struct ExportRenamePlan {\n  plan_paths: Array[String];\n  rename_paths: Array[String];\n  rename_names: Array[String];\n  rename_mangled: Array[String]\n}\n\n// Resolve a raw import path against the set of files in this merge; a\n// directory import (`import ./codegen/wasi { .. }`) has two candidates and we\n// pick the one that is actually part of the program.\nlet resolve_known_import_path: (Array[String], String, String, String) -> String = (known_paths, base_dir, raw_path, self_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut chosen = \"\"\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(candidates) && !found {\n    let candidate = Array::get(candidates, i)\n    // Never resolve to the importing file itself (`export ./codegen` inside\n    // codegen.vibe targets the directory) — mirrors header_cache/merge_sources.\n    if candidate == self_path {\n      i = i + 1\n    } else {\n      if chosen == \"\" {\n        chosen = candidate\n      } else {\n        ()\n      }\n      if string_array_contains(known_paths, candidate) {\n        chosen = candidate\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  if chosen == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    chosen\n  }\n}\n\nlet plan_triple_lookup: (Array[String], Array[String], Array[String], String, String) -> Option[String] = (tpaths, tnames, tvalues, path, name) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(tpaths) {\n    if Array::get(tpaths, i) == path && Array::get(tnames, i) == name {\n      found = Some(Array::get(tvalues, i))\n      i = Array::length(tpaths)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Re-export edges of one file: `export ./dep.vibe { a, b as c }` plus the\n// `import { x } ... export { x }` facade idiom (an `export {}` item with no\n// local let def but a matching import). Pushed as parallel arrays\n// (from-path, public-name, target-path, target-name).\nlet collect_reexport_edges_into: (String, Array[Stmt], Array[String], Array[String], Array[String], Array[String], Array[String]) -> Unit = (path, stmts, known_paths, edge_from, edge_pub, edge_tpath, edge_tname) -> {\n  let base_dir = dir_of_path(path)\n  let let_names = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => Array::push(let_names, name),\n      SLetMut(name, _, _) => Array::push(let_names, name),\n      _ => ()\n    }\n    i = i + 1\n  }\n  let import_refs = collect_import_refs(stmts)\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SReExport(raw_path, items) => {\n        let target = resolve_known_import_path(known_paths, base_dir, raw_path, path)\n        let mut j = 0\n        while j < Array::length(items) {\n          let (iname, alias_opt) = Array::get(items, j)\n          let public_name = match alias_opt {\n            Some(alias) => alias,\n            None => iname\n          }\n          Array::push(edge_from, path)\n          Array::push(edge_pub, public_name)\n          Array::push(edge_tpath, target)\n          Array::push(edge_tname, iname)\n          j = j + 1\n        }\n      },\n      SExport(items) => {\n        let mut j = 0\n        while j < Array::length(items) {\n          let name = Array::get(items, j)\n          if !string_array_contains(let_names, name) {\n            let mut ri = 0\n            let mut done = false\n            while ri < Array::length(import_refs) && !done {\n              let (raw_path, original, local) = Array::get(import_refs, ri)\n              if local == name {\n                Array::push(edge_from, path)\n                Array::push(edge_pub, name)\n                Array::push(edge_tpath, resolve_known_import_path(known_paths, base_dir, raw_path, path))\n                Array::push(edge_tname, original)\n                done = true\n              } else {\n                ri = ri + 1\n              }\n            }\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n      },\n      _ => ()\n    }\n    si = si + 1\n  }\n}\n\nexport let build_export_rename_plan: (Array[String], Array[Array[Stmt]], String) -> ExportRenamePlan = (paths, stmts_list, entry_path) -> {\n  let file_count = Array::length(paths)\n  let def_names_list = Array::slice([\n    empty_strings()\n  ], 0, 0)\n  let mut fi = 0\n  while fi < file_count {\n    Array::push(def_names_list, collect_export_def_value_names(Array::get(stmts_list, fi)))\n    fi = fi + 1\n  }\n  let edge_from = empty_strings()\n  let edge_pub = empty_strings()\n  let edge_tpath = empty_strings()\n  let edge_tname = empty_strings()\n  let mut ei = 0\n  while ei < file_count {\n    collect_reexport_edges_into(Array::get(paths, ei), Array::get(stmts_list, ei), paths, edge_from, edge_pub, edge_tpath, edge_tname)\n    ei = ei + 1\n  }\n  // The origins of the entry file's re-export surface are program ABI (wasm\n  // export names of a linked library / component entry) and stay bare.\n  let excluded_paths = empty_strings()\n  let excluded_names = empty_strings()\n  let file_idx_of: (String) -> Int = (path) -> {\n    let mut i = 0\n    let mut found = -1\n    while i < file_count {\n      if Array::get(paths, i) == path {\n        found = i\n        i = file_count\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  }\n  let mut xi = 0\n  while xi < Array::length(edge_from) {\n    if Array::get(edge_from, xi) == entry_path {\n      let mut cur_path = Array::get(edge_tpath, xi)\n      let mut cur_name = Array::get(edge_tname, xi)\n      let mut depth = 0\n      while depth < 16 {\n        let idx = file_idx_of(cur_path)\n        let is_def = if idx < 0 {\n          false\n        } else {\n          string_array_contains(Array::get(def_names_list, idx), cur_name)\n        }\n        if is_def {\n          Array::push(excluded_paths, cur_path)\n          Array::push(excluded_names, cur_name)\n          depth = 16\n        } else {\n          match plan_triple_lookup(edge_from, edge_pub, edge_tpath, cur_path, cur_name) {\n            Some(next_path) => {\n              match plan_triple_lookup(edge_from, edge_pub, edge_tname, cur_path, cur_name) {\n                Some(next_name) => {\n                  cur_path = next_path\n                  cur_name = next_name\n                  depth = depth + 1\n                },\n                None => {\n                  depth = 16\n                }\n              }\n            },\n            None => {\n              depth = 16\n            }\n          }\n        }\n      }\n    } else {\n      ()\n    }\n    xi = xi + 1\n  }\n  let rename_paths = empty_strings()\n  let rename_names = empty_strings()\n  let rename_mangled = empty_strings()\n  let mut ri = 0\n  while ri < file_count {\n    let path = Array::get(paths, ri)\n    if path == entry_path {\n      ()\n    } else {\n      let def_names = Array::get(def_names_list, ri)\n      let mut ni = 0\n      while ni < Array::length(def_names) {\n        let name = Array::get(def_names, ni)\n        let excluded = match plan_triple_lookup(excluded_paths, excluded_names, excluded_names, path, name) {\n          Some(_) => true,\n          None => false\n        }\n        if excluded {\n          ()\n        } else {\n          Array::push(rename_paths, path)\n          Array::push(rename_names, name)\n          Array::push(rename_mangled, namespace_exported_name(path, name))\n        }\n        ni = ni + 1\n      }\n    }\n    ri = ri + 1\n  }\n  // Close the rename table over re-export facades so an import THROUGH a\n  // facade (`import ./index.vibe { eq }` where index re-exports float's `eq`)\n  // resolves to the renamed origin in one lookup.\n  let mut changed = true\n  while changed {\n    changed = false\n    let mut ci = 0\n    while ci < Array::length(edge_from) {\n      let from = Array::get(edge_from, ci)\n      let pub_name = Array::get(edge_pub, ci)\n      if from == entry_path {\n        ()\n      } else {\n        match plan_triple_lookup(rename_paths, rename_names, rename_mangled, Array::get(edge_tpath, ci), Array::get(edge_tname, ci)) {\n          Some(mangled) => {\n            match plan_triple_lookup(rename_paths, rename_names, rename_mangled, from, pub_name) {\n              Some(_) => (),\n              None => {\n                Array::push(rename_paths, from)\n                Array::push(rename_names, pub_name)\n                Array::push(rename_mangled, mangled)\n                changed = true\n              }\n            }\n          },\n          None => ()\n        }\n      }\n      ci = ci + 1\n    }\n  }\n  ExportRenamePlan::{\n    plan_paths: paths,\n    rename_paths: rename_paths,\n    rename_names: rename_names,\n    rename_mangled: rename_mangled\n  }\n}\n\nexport let export_plan_rename_count: (ExportRenamePlan) -> Int = (plan) -> {\n  Array::length(plan.rename_paths)\n}\n\n// (name -> mangled) pairs for the defs of one file.\nexport let export_plan_renames_for: (ExportRenamePlan, String) -> Array[(String, String)] = (plan, path) -> {\n  let out = empty_aliases()\n  let rename_paths = plan.rename_paths\n  let rename_names = plan.rename_names\n  let rename_mangled = plan.rename_mangled\n  let mut i = 0\n  while i < Array::length(rename_paths) {\n    if Array::get(rename_paths, i) == path {\n      Array::push(out, (Array::get(rename_names, i), Array::get(rename_mangled, i)))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n// Deterministic text summary of the plan; callers fold it into merge cache\n// fingerprints so a rename-set change invalidates cached merged sources.\nexport let export_plan_fingerprint_text: (ExportRenamePlan) -> String = (plan) -> {\n  let rename_paths = plan.rename_paths\n  let rename_names = plan.rename_names\n  let rename_mangled = plan.rename_mangled\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"export-renames\")\n  let mut i = 0\n  while i < Array::length(rename_paths) {\n    StringBuilder::push(buf, \"|\")\n    StringBuilder::push(buf, Array::get(rename_paths, i))\n    StringBuilder::push(buf, \">\")\n    StringBuilder::push(buf, Array::get(rename_names, i))\n    StringBuilder::push(buf, \">\")\n    StringBuilder::push(buf, Array::get(rename_mangled, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\n// (local -> mangled) reference renames for one importing file, derived from\n// its `import` statements against the plan.\nexport let collect_import_value_renames: (ExportRenamePlan, String, Array[Stmt]) -> Array[(String, String)] = (plan, path, stmts) -> {\n  let out = empty_aliases()\n  let locals_seen = empty_strings()\n  let rename_paths = plan.rename_paths\n  let rename_names = plan.rename_names\n  let rename_mangled = plan.rename_mangled\n  if Array::length(rename_paths) == 0 {\n    out\n  } else {\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, items) => {\n          let target = resolve_known_import_path(plan.plan_paths, base_dir, raw_path, path)\n          let mut j = 0\n          while j < Array::length(items) {\n            let (original, alias_opt) = Array::get(items, j)\n            let local = match alias_opt {\n              Some(alias) => alias,\n              None => original\n            }\n            if String::index_of(original, \"::\") < 0 && !string_array_contains(locals_seen, local) {\n              match plan_triple_lookup(rename_paths, rename_names, rename_mangled, target, original) {\n                Some(mangled) => {\n                  Array::push(out, (local, mangled))\n                  Array::push(locals_seen, local)\n                },\n                None => ()\n              }\n            } else {\n              ()\n            }\n            j = j + 1\n          }\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    out\n  }\n}\n\nexport let import_value_rename_locals: (Array[(String, String)]) -> Array[String] = (renames) -> {\n  let out = empty_strings()\n  let mut i = 0\n  while i < Array::length(renames) {\n    let (local, _) = Array::get(renames, i)\n    Array::push(out, local)\n    i = i + 1\n  }\n  out\n}\n\n// Apply (name -> mangled) def renames to one file's statements: SLet def\n// names, `export { ... }` items, and every value reference (shadow-aware via\n// rewrite_import_alias_expr).\nexport let apply_export_renames_stmts: (Array[Stmt], Array[(String, String)]) -> Array[Stmt] = (stmts, renames) -> {\n  if Array::length(renames) == 0 {\n    stmts\n  } else {\n    for stmt in stmts {\n      match stmt {\n        SLet(exported, is_rec, name, ty, body) => {\n          let next_name = match lookup_alias(renames, name) {\n            Some(renamed) => renamed,\n            None => name\n          }\n          SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\n        },\n        SLetMut(name, ty, body) => SLetMut(name, ty, rewrite_import_alias_expr(body, renames)),\n        SExport(items) => SExport(for item in items {\n          match lookup_alias(renames, item) {\n            Some(renamed) => renamed,\n            None => item\n          }\n        }),\n        STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\n        SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\n        SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\n        SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\n        _ => stmt\n      }\n    }\n  }\n}\n\n// `export let eq: (Float, Float) -> Bool = float_eq` binds a NAME to another\n// top-level function. The backend function tables register such non-EFn lets\n// as 0-parameter thunks, so a CALL through the alias emits N arguments\n// against a 0-param function — invalid wasm (stack imbalance), on every\n// backend and for any arity (found while fixing #716: vibe/prelude/float.vibe\n// exports its whole API this way). Rewrite every reference to a top-level\n// function alias (chains followed, ≤16) to the final EFn def's name. The\n// alias def itself stays: it is inert once nothing refers to it, and its\n// export flag keeps the wasm export surface unchanged.\nexport let rewrite_top_level_fn_alias_refs: (Array[Stmt]) -> Unit = (stmts) -> {\n  let fn_names = empty_strings()\n  let alias_names = empty_strings()\n  let alias_targets = empty_strings()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, _, _, _, _) => Array::push(fn_names, name),\n        EIdent(target, _) => {\n          Array::push(alias_names, name)\n          Array::push(alias_targets, target)\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  if Array::length(alias_names) == 0 {\n    ()\n  } else {\n    let renames = empty_aliases()\n    let mut ai = 0\n    while ai < Array::length(alias_names) {\n      let mut target = Array::get(alias_targets, ai)\n      let mut final_target = \"\"\n      let mut depth = 0\n      while depth < 16 {\n        if string_array_contains(fn_names, target) {\n          final_target = target\n          depth = 16\n        } else {\n          let mut hop = false\n          let mut aj = 0\n          while aj < Array::length(alias_names) && !hop {\n            if Array::get(alias_names, aj) == target {\n              target = Array::get(alias_targets, aj)\n              hop = true\n            } else {\n              aj = aj + 1\n            }\n          }\n          if hop {\n            depth = depth + 1\n          } else {\n            depth = 16\n          }\n        }\n      }\n      if final_target != \"\" && final_target != Array::get(alias_names, ai) {\n        Array::push(renames, (Array::get(alias_names, ai), final_target))\n      } else {\n        ()\n      }\n      ai = ai + 1\n    }\n    if Array::length(renames) == 0 {\n      ()\n    } else {\n      let mut si = 0\n      while si < Array::length(stmts) {\n        match Array::get(stmts, si) {\n          SLet(exported, is_rec, name, ty, body) => Array::set(stmts, si, SLet(exported, is_rec, name, ty, rewrite_import_alias_expr(body, renames))),\n          SLetMut(name, ty, body) => Array::set(stmts, si, SLetMut(name, ty, rewrite_import_alias_expr(body, renames))),\n          STest(name, body) => Array::set(stmts, si, STest(name, rewrite_import_alias_expr(body, renames))),\n          SBench(name, body) => Array::set(stmts, si, SBench(name, rewrite_import_alias_expr(body, renames))),\n          SExpr(body) => Array::set(stmts, si, SExpr(rewrite_import_alias_expr(body, renames))),\n          SLetPat(pat, body) => Array::set(stmts, si, SLetPat(pat, rewrite_import_alias_expr(body, renames))),\n          _ => ()\n        }\n        si = si + 1\n      }\n    }\n  }\n}\n\n// Like append_import_alias_rewritten_non_import_stmts_skipping, but with\n// extra (local -> mangled) import-value renames applied in the same pass.\n// Locals covered by `extra_renames` are removed from the legacy alias map\n// (which would rewrite alias -> original instead).\nexport let append_import_alias_rewritten_non_import_stmts_with_renames: (Array[Stmt], Array[Stmt], Array[String], Array[(String, String)]) -> Unit = (merged, stmts, skipped_locals, extra_renames) -> {\n  let legacy = alias_map_without_names(\n    alias_map_without_names(collect_import_aliases(stmts), skipped_locals),\n    import_value_rename_locals(extra_renames)\n  )\n  let combined = empty_aliases()\n  let mut li = 0\n  while li < Array::length(legacy) {\n    Array::push(combined, Array::get(legacy, li))\n    li = li + 1\n  }\n  let mut xi = 0\n  while xi < Array::length(extra_renames) {\n    Array::push(combined, Array::get(extra_renames, xi))\n    xi = xi + 1\n  }\n  let should_rewrite = Array::length(combined) > 0\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SImport(_, _) => (),\n      SReExport(_, _) => (),\n      SAliasDecl(_, _) => (),\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, combined)),\n      _ => if should_rewrite {\n        Array::push(merged, rewrite_import_alias_stmt(stmt, combined))\n      } else {\n        Array::push(merged, stmt)\n      }\n    }\n    i = i + 1\n  }\n}\n")
}

let cli_adapter_source_19 = () -> (String, String) {
  ("vibe/compiler/syntax/printer.vibe",
"//# Imports\n\nimport .. / core {\n  Expr, Pat, Stmt, TypeExpr, __to_string\n}\n\nimport ./float_format.vibe {\n  double_to_string_compiler\n}\n\n//# Functions\n\nlet join: (Array[String], String) -> String = (arr, sep) -> {\n  let len = Array::length(arr)\n  if len == 0 {\n    \"\"\n  } else {\n    let b = ArrayBuilder::new()\n    let mut i = 0\n    while i < len {\n      if i > 0 {\n        ArrayBuilder::push(b, sep)\n      }\n      ArrayBuilder::push(b, Array::get(arr, i))\n      i = i + 1\n    }\n    String::join(ArrayBuilder::freeze(b), \"\")\n  }\n}\n\n// #741: `r#loop`-style raw identifiers lex to a bare TIdent — the r# prefix\n// is not kept in the AST — so a binding named after a keyword must be\n// re-escaped on print or the emitted program fails to re-parse (the merge\n// flatten hit \"expected identifier after 'let rec'\" on @vibe/core set.vibe's\n// `let rec r#loop`). Mirror of the lexer's keyword table.\nlet is_keyword_name: (String) -> Bool = (name) -> {\n  name == \"fn\" || name == \"if\" || name == \"in\" || name == \"is\" || name == \"do\" ||\n  name == \"as\" || name == \"let\" || name == \"rec\" || name == \"mut\" || name == \"for\" ||\n  name == \"else\" || name == \"enum\" || name == \"true\" || name == \"type\" || name == \"test\" ||\n  name == \"with\" || name == \"loop\" || name == \"open\" || name == \"impl\" || name == \"false\" ||\n  name == \"match\" || name == \"trait\" || name == \"throw\" || name == \"while\" || name == \"break\" ||\n  name == \"bench\" || name == \"raise\" || name == \"yield\" || name == \"struct\" || name == \"export\" ||\n  name == \"return\" || name == \"handle\" || name == \"module\" || name == \"derive\" || name == \"import\" ||\n  name == \"declare\" || name == \"continue\" || name == \"suberror\"\n}\n\nlet print_name: (String) -> String = (name) -> {\n  if is_keyword_name(name) {\n    String::concat(\"r#\", name)\n  } else name\n}\n\nlet escape_string: (String) -> String = (s) -> {\n  let len = String::length(s)\n  let b = ArrayBuilder::new()\n  let push_chunk: (Int, Int) -> Unit = (start, end) -> {\n    if end > start {\n      ArrayBuilder::push(b, s[start: end])\n    }\n  }\n  let mut i = 0\n  let mut start = 0\n  while i < len {\n    let c = String::char_code_at(s, i)\n    if c == '\"' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\"\")\n      i = i + 1\n      start = i\n    } else if c == '\\\\' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\\\\\\")\n      i = i + 1\n      start = i\n    } else if c == '\\n' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\n\")\n      i = i + 1\n      start = i\n    } else if c == '\\t' {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\t\")\n      i = i + 1\n      start = i\n    } else if c == 13 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\r\")\n      i = i + 1\n      start = i\n    } else if c == 0 {\n      push_chunk(start, i)\n      ArrayBuilder::push(b, \"\\\\0\")\n      i = i + 1\n      start = i\n    } else {\n      i = i + 1\n    }\n  }\n  push_chunk(start, len)\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n\nexport let rec print_pat: (Pat) -> String = (p) -> {\n  match p {\n    PWild => \"_\",\n    PBind(name) => print_name(name),\n    PInt(n) => __to_string(n),\n    PFloat(v) => {\n      // Same int-reparse guard as the EFloat printer arm below.\n      let fs = double_to_string_compiler(v)\n      if String::contains(fs, \".\") || fs == \"nan\" {\n        fs\n      } else {\n        String::concat(fs, \".0\")\n      }\n    },\n    PString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    PBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    PCtor(name, args) => if Array::length(args) == 0 {\n      name\n    } else {\n      let parts = for arg in args {\n        print_pat(arg)\n      }\n      String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n    },\n    PTuple(elems) => {\n      let parts = for elem in elems {\n        print_pat(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    },\n    POr(left, right) => String::concat(print_pat(left), String::concat(\" | \", print_pat(right))),\n    PStruct(name, _) => String::concat(name, \"::{...}\")\n  }\n}\n\nlet handle_effect_name_from_ctor: (String) -> Option[String] = (name) -> {\n  let idx = String::last_index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    Some(name[0: idx])\n  }\n}\n\nlet rec infer_handle_effect_name_from_pat: (Pat) -> Option[String] = (pat) -> {\n  match pat {\n    PCtor(name, _) => handle_effect_name_from_ctor(name),\n    POr(left, right) => match infer_handle_effect_name_from_pat(left) {\n      Some(name) => Some(name),\n      None => infer_handle_effect_name_from_pat(right)\n    },\n    _ => None\n  }\n}\n\nlet infer_handle_effect_name: (Array[(Pat, Expr)]) -> String = (arms) -> {\n  let mut i = 0\n  let mut effect_name = \"Error\"\n  let mut found = false\n  while i < Array::length(arms) && !found {\n    let (pat, _) = Array::get(arms, i)\n    match infer_handle_effect_name_from_pat(pat) {\n      Some(name) => {\n        effect_name = name\n        found = true\n      },\n      None => {\n        i = i + 1\n      }\n    }\n  }\n  effect_name\n}\n\nlet strip_handle_effect_ctor: (String, String) -> String = (effect_name, ctor_name) -> {\n  let prefix = String::concat(effect_name, \"::\")\n  if String::starts_with(ctor_name, prefix) {\n    let prefix_len = String::length(prefix)\n    let ctor_len = String::length(ctor_name)\n    ctor_name[prefix_len: ctor_len]\n  } else {\n    ctor_name\n  }\n}\n\nlet rec print_handle_pat: (String, Pat) -> String = (effect_name, pat) -> {\n  match pat {\n    PCtor(name, args) => {\n      let short_name = strip_handle_effect_ctor(effect_name, name)\n      if Array::length(args) == 0 {\n        short_name\n      } else {\n        let parts = for arg in args {\n          print_pat(arg)\n        }\n        String::concat(short_name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n      }\n    },\n    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(\" | \", print_handle_pat(effect_name, right))),\n    _ => print_pat(pat)\n  }\n}\n\nlet map_to_strings: (Array[Expr], (Expr) -> String) -> Array[String] = (exprs, f) -> {\n  for expr in exprs {\n    f(expr)\n  }\n}\n\nexport let rec print_type_expr: (TypeExpr) -> String = (ty) -> {\n  match ty {\n    TyName(name) => name,\n    TyUnit => \"()\",\n    TyApp(name, args) => {\n      let parts = for arg in args {\n        print_type_expr(arg)\n      }\n      String::concat(name, String::concat(\"[\", String::concat(join(parts, \", \"), \"]\")))\n    },\n    TyFn(params, ret, effect_name) => {\n      let parts = for param in params {\n        print_type_expr(param)\n      }\n      let base = String::concat(\"(\", String::concat(join(parts, \", \"), String::concat(\") -> \", print_type_expr(ret))))\n      match effect_name {\n        Some(name) => String::concat(base, String::concat(\" with { \", String::concat(name, \" }\"))),\n        None => base\n      }\n    },\n    TyTuple(elems) => {\n      let parts = for elem in elems {\n        print_type_expr(elem)\n      }\n      String::concat(\"(\", String::concat(join(parts, \", \"), \")\"))\n    }\n  }\n}\n\nlet print_ctor: (String, Array[TypeExpr]) -> String = (name, args) -> {\n  if Array::length(args) == 0 {\n    name\n  }\n  else {\n    let parts = for arg in args {\n      print_type_expr(arg)\n    }\n    String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))\n  }\n}\n\n// Render a function/lambda type-parameter header `[T: Ord, U]` from the EFn\n// type_params + bounds. Returns \"\" when there are no type params. Without\n// this, print_program (used to round-trip a merged multi-module program back\n// to source) would drop `[T: Ord]`, so a re-parsed generic function loses its\n// type-parameter scope and `T` resolves to a concrete `CtNamed(\"T\", [])`\n// instead of a bound type variable.\nlet print_fn_type_params: (Array[String], Array[(String, Array[String])]) -> String = (type_params, bounds) -> {\n  if Array::length(type_params) == 0 {\n    \"\"\n  } else {\n    let parts = for tp in type_params {\n      let mut found = Array::slice([\n        \"\"\n      ], 0, 0)\n      let mut bi = 0\n      while bi < Array::length(bounds) {\n        let (bname, blist) = Array::get(bounds, bi)\n        if bname == tp {\n          found = blist\n        }\n        bi = bi + 1\n      }\n      if Array::length(found) == 0 {\n        tp\n      } else {\n        String::concat(tp, String::concat(\": \", join(found, \" + \")))\n      }\n    }\n    String::concat(\"[\", String::concat(join(parts, \", \"), \"]\"))\n  }\n}\n\nexport let rec print_expr: (Expr) -> String = (e) -> {\n  match e {\n    EInt(n) => __to_string(n),\n    EFloat(n) => {\n      // #726: a whole double printed as \"2\" re-parses as an INT literal —\n      // `EFloat(2.0)` round-tripped to `EInt(2)` (the merge-flatten stage\n      // rejected the compiler's own `EFloat(...)` ctor calls; normalize had\n      // the same silent semantic corruption). Keep the float-ness explicit.\n      let s = double_to_string_compiler(n)\n      if String::contains(s, \".\") || s == \"nan\" {\n        s\n      } else {\n        String::concat(s, \".0\")\n      }\n    },\n    EString(s) => String::concat(\"\\\"\", String::concat(escape_string(s), \"\\\"\")),\n    EBool(b) => if b {\n      \"true\"\n    } else \"false\",\n    EIdent(name, _) => print_name(name),\n    EUnit => \"()\",\n    ETuple(elems) => String::concat(\"(\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \")\")),\n    EArray(elems) => String::concat(\"[\", String::concat(join(map_to_strings(elems, print_expr), \", \"), \"]\")),\n    ERecord(fields) => {\n      let parts = for field in fields {\n        let (name, val) = field\n        String::concat(name, String::concat(\": \", print_expr(val)))\n      }\n      String::concat(\"record { \", String::concat(join(parts, \", \"), \" }\"))\n    },\n    EIf(cond, then_e, else_e) => match else_e {\n      EUnit => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), \" }\")))),\n      _ => String::concat(\"if \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(then_e), String::concat(\" } else { \", String::concat(print_expr(else_e), \" }\"))))))\n    },\n    ELet(name, val, body) => String::concat(\"{ let \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetRec(name, val, body) => String::concat(\"{ let rec \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    ELetMut(name, val, body) => String::concat(\"{ let mut \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssign(name, val, body) => String::concat(\"{ \", String::concat(print_name(name), String::concat(\" = \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))),\n    EAssignOp(name, op, val, body) => String::concat(\"{ \", String::concat(print_name(name), String::concat(\" \", String::concat(op, String::concat(\"= \", String::concat(print_expr(val), String::concat(\"; \", String::concat(print_expr(body), \" }\")))))))),\n    ESeq(a, b) => String::concat(\"{ \", String::concat(print_expr(a), String::concat(\"; \", String::concat(print_expr(b), \" }\")))),\n    EMatch(scrutinee, arms) => {\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_pat(pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"match \", String::concat(print_expr(scrutinee), String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    EHandle(body, arms) => {\n      let effect_name = infer_handle_effect_name(arms)\n      let parts = for arm in arms {\n        let (pat, expr) = arm\n        String::concat(print_handle_pat(effect_name, pat), String::concat(\" => \", print_expr(expr)))\n      }\n      String::concat(\"handle { \", String::concat(print_expr(body), String::concat(\" } with \", String::concat(effect_name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\"))))))\n    },\n    EWhile(cond, body) => String::concat(\"while \", String::concat(print_expr(cond), String::concat(\" { \", String::concat(print_expr(body), \" }\")))),\n    ELoop(params, body) => {\n      let parts = for param in params {\n        let (name, init) = param\n        String::concat(print_name(name), String::concat(\" = \", print_expr(init)))\n      }\n      String::concat(\"loop (\", String::concat(join(parts, \", \"), String::concat(\") { \", String::concat(print_expr(body), \" }\"))))\n    },\n    EForIn(value_name, index_name, iterable, body) => {\n      let binding = match index_name {\n        Some(index_name) => String::concat(print_name(index_name), String::concat(\", \", print_name(value_name))),\n        None => print_name(value_name)\n      }\n      String::concat(\"for \", String::concat(binding, String::concat(\" in \", String::concat(print_expr(iterable), String::concat(\" { \", String::concat(print_expr(body), \" }\"))))))\n    },\n    ECall(callee, args, _) => match callee {\n      EIdent(\"perform\", _) => if Array::length(args) == 1 {\n        String::concat(\"perform \", print_expr(Array::get(args, 0)))\n      } else {\n        String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))\n      },\n      // #726: an immediately-invoked lambda callee must be parenthesized —\n      // `(x: T) -> { x }(args)` re-parses with the CALL inside the lambda\n      // body (`{ x }(args)`, \"calling a non-function value\"), so print\n      // `((x: T) -> { x })(args)`.\n      EFn(_, _, _, _, _, _) => String::concat(\"(\", String::concat(print_expr(callee), String::concat(\")(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))),\n      _ => String::concat(print_expr(callee), String::concat(\"(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")))\n    },\n    EBinOp(op, left, right) => String::concat(\"(\", String::concat(print_expr(left), String::concat(\" \", String::concat(op, String::concat(\" \", String::concat(print_expr(right), \")\")))))),\n    EUnaryOp(op, expr) => String::concat(\"(\", String::concat(op, String::concat(print_expr(expr), \")\"))),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => {\n      let tp_str = print_fn_type_params(type_params, bounds)\n      let parts = for param in params {\n        let (name, ty_opt) = param\n        match ty_opt {\n          Some(ty) => String::concat(print_name(name), String::concat(\": \", print_type_expr(ty))),\n          None => print_name(name)\n        }\n      }\n      let ret_str = match ret_ty {\n        Some(rt) => {\n          let eff_str = match effect {\n            Some(e) => String::concat(\" with { \", String::concat(e, \" }\")),\n            None => \"\"\n          }\n          String::concat(\") -> \", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\" { \", String::concat(print_expr(body), \" }\")))))\n        },\n        None => String::concat(\") -> { \", String::concat(print_expr(body), \" }\"))\n      }\n      String::concat(tp_str, String::concat(\"(\", String::concat(join(parts, \", \"), ret_str)))\n    },\n    EDot(expr, field, _) => String::concat(print_expr(expr), String::concat(\".\", field)),\n    EThrow(e) => String::concat(\"throw(\", String::concat(print_expr(e), \")\")),\n    EReturn(e) => String::concat(\"return \", print_expr(e)),\n    EBreak(opt) => match opt {\n      None => \"break\",\n      Some(v) => String::concat(\"break \", print_expr(v))\n    },\n    EContinue(args) => if Array::length(args) == 0 {\n      \"continue\"\n    } else String::concat(\"continue(\", String::concat(join(map_to_strings(args, print_expr), \", \"), \")\")),\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\"=\", print_expr(val))),\n    EMap(fields) => if Array::length(fields) == 0 {\n      \"map {}\"\n    } else {\n      let parts = for field in fields {\n        let (k, v) = field\n        String::concat(k, String::concat(\": \", print_expr(v)))\n      }\n      String::concat(\"map { \", String::concat(join(parts, \", \"), \" }\"))\n    },\n    ESpread(inner) => String::concat(\"...\", print_expr(inner)),\n    EStringInterp(parts) => String::concat(\"\\\"\", String::concat(join(parts, \"\"), \"\\\"\"))\n  }\n}\n\nlet print_annotated_let_value: (Option[TypeExpr], Expr) -> String = (ty_opt, val) -> {\n  match ty_opt {\n    Some(TyFn(_, _, _)) => match val {\n      EFn(type_params, bounds, params, _, _, body) => {\n        // Type params live only on the EFn (the `: (T) -> T` annotation does\n        // not carry `[T: Ord]`); emit them so a re-parse keeps the\n        // type-parameter scope. Without this, print_program round-tripping a\n        // merged multi-module program drops `[T: Ord]` and `T` resolves to a\n        // concrete CtNamed instead of a bound type variable.\n        let tp_str = print_fn_type_params(type_params, bounds)\n        let parts = for param in params {\n          let (name, _) = param\n          print_name(name)\n        }\n        String::concat(\n          tp_str,\n          String::concat(\n            \"(\",\n            String::concat(\n              join(parts, \", \"),\n              String::concat(\") -> { \", String::concat(print_expr(body), \" }\"))\n            )\n          )\n        )\n      },\n      _ => print_expr(val)\n    },\n    _ => print_expr(val)\n  }\n}\n\nlet print_ctor_list: (Array[(String, Array[TypeExpr])]) -> String = (ctors) -> {\n  let parts = for ctor in ctors {\n    let (name, args) = ctor\n    print_ctor(name, args)\n  }\n  join(parts, \"; \")\n}\n\nexport let rec print_stmt: (Stmt) -> String = (s) -> {\n  let prefix: (Bool) -> String = (exported) -> {\n    if exported {\n      \"export \"\n    } else \"\"\n  }\n  match s {\n    SLet(exported, is_rec, name, ty_opt, val) => {\n      let p = prefix(exported)\n      let r = if is_rec {\n        \"let rec \"\n      } else \"let \"\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(p, String::concat(r, String::concat(print_name(name), String::concat(t, String::concat(\" = \", print_annotated_let_value(ty_opt, val))))))\n    },\n    SLetMut(name, ty_opt, val) => {\n      let t = match ty_opt {\n        Some(ty) => String::concat(\": \", print_type_expr(ty)),\n        None => \"\"\n      }\n      String::concat(\"let mut \", String::concat(print_name(name), String::concat(t, String::concat(\" = \", print_expr(val)))))\n    },\n    SEnum(exported, name, params, ctors, derives) => {\n      // #735: `[T]` type params and `derive(...)` were dropped, so a printed\n      // generic enum (e.g. a contract facade embedding `enum List[T]`)\n      // round-tripped to an ill-typed nullary declaration.\n      let tp = if Array::length(params) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(params, \", \"), \"]\"))\n      }\n      let base = String::concat(prefix(exported), String::concat(\"enum \", String::concat(name, String::concat(tp, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\"))))))\n      if Array::length(derives) == 0 {\n        base\n      } else {\n        String::concat(base, String::concat(\" derive(\", String::concat(join(derives, \", \"), \")\")))\n      }\n    },\n    SSuberror(exported, name, ctors) => {\n      let p = prefix(exported)\n      if Array::length(ctors) == 1 {\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\n        if ctor_name == name {\n          let parts = for arg in ctor_args {\n            print_type_expr(arg)\n          }\n          String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\"(\", String::concat(join(parts, \", \"), \")\")))))\n        }\n        else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n      } else String::concat(p, String::concat(\"suberror \", String::concat(name, String::concat(\" { \", String::concat(print_ctor_list(ctors), \" }\")))))\n    },\n    SStruct(exported, name, fields, derives, mut_names) => {\n      let parts = for field in fields {\n        let (fn1, ty) = field\n        let mut is_mut = false\n        let mut mi = 0\n        while mi < Array::length(mut_names) {\n          if Array::get(mut_names, mi) == fn1 {\n            is_mut = true\n          }\n          mi = mi + 1\n        }\n        let mp = if is_mut {\n          \"mut \"\n        } else {\n          \"\"\n        }\n        String::concat(mp, String::concat(fn1, String::concat(\": \", print_type_expr(ty))))\n      }\n      let base = String::concat(prefix(exported), String::concat(\"struct \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"; \"), \" }\")))))\n      if Array::length(derives) == 0 {\n        base\n      } else {\n        String::concat(base, String::concat(\" derive(\", String::concat(join(derives, \", \"), \")\")))\n      }\n    },\n    STypeAlias(exported, name, params, ty) => {\n      // #735 (same class as SEnum): keep `[T]` params on printed aliases.\n      let tp = if Array::length(params) == 0 {\n        \"\"\n      } else {\n        String::concat(\"[\", String::concat(join(params, \", \"), \"]\"))\n      }\n      String::concat(prefix(exported), String::concat(\"type \", String::concat(name, String::concat(tp, String::concat(\" = \", print_type_expr(ty))))))\n    },\n    STrait(exported, name, supers, methods, _) => {\n      let base = String::concat(prefix(exported), String::concat(\"trait \", name))\n      let head = if Array::length(supers) == 0 {\n        base\n      }\n      else String::concat(base, String::concat(\": \", join(supers, \" + \")))\n      if Array::length(methods) == 0 {\n        head\n      } else {\n        let method_parts = for m in methods {\n          let (method_name, params, ret) = m\n          let params_str = if Array::length(params) > 0 {\n            String::concat(\"(\", String::concat(join(for pt in params {\n              print_type_expr(pt)\n            }, \", \"), \")\"))\n          } else \"\"\n          String::concat(\"  \", String::concat(method_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n        }\n        String::concat(head, String::concat(\" {\\n\", String::concat(join(method_parts, \";\\n\"), \"\\n}\")))\n      }\n    },\n    SImpl(tparams, _, trait_name, type_name) => {\n      let head = if Array::length(tparams) == 0 {\n        \"impl \"\n      } else {\n        String::concat(\"impl [\", String::concat(join(tparams, \", \"), \"] \"))\n      }\n      String::concat(head, String::concat(trait_name, String::concat(\" for \", type_name)))\n    },\n    SExternLet(name, ty) => String::concat(\"extern let \", String::concat(name, String::concat(\": \", print_type_expr(ty)))),\n    SImport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"import \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    STest(name, body) => String::concat(\"test \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SBench(name, body) => String::concat(\"bench \\\"\", String::concat(name, String::concat(\"\\\" { \", String::concat(print_expr(body), \" }\")))),\n    SExpr(e) => print_expr(e),\n    SExport(names) => String::concat(\"export { \", String::concat(join(names, \", \"), \" }\")),\n    SReExport(path, items) => {\n      let parts = for item in items {\n        let (name, alias) = item\n        match alias {\n          Some(a) => String::concat(name, String::concat(\" as \", a)),\n          None => name\n        }\n      }\n      String::concat(\"export \", String::concat(path, String::concat(\" { \", String::concat(join(parts, \", \"), \" }\"))))\n    },\n    SAliasDecl(alias_name, source_path) => String::concat(\"import \", String::concat(source_path, String::concat(\" @\", alias_name))),\n    SLetPat(pat, expr) => String::concat(\"let \", String::concat(print_pat(pat), String::concat(\" = \", print_expr(expr)))),\n    SModule(exported, name, stmts) => {\n      let parts = for s in stmts {\n        print_stmt(s)\n      }\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      String::concat(p, String::concat(\"module \", String::concat(name, String::concat(\" { \", String::concat(join(parts, \"\\n\"), \" }\")))))\n    },\n    SEffectDef(exported, name, type_params, ops) => {\n      let p = if exported {\n        \"export \"\n      } else \"\"\n      let tp = if Array::length(type_params) > 0 {\n        String::concat(\"[\", String::concat(join(type_params, \", \"), \"]\"))\n      } else \"\"\n      let op_parts = for op in ops {\n        let (op_name, params, ret) = op\n        let params_str = if Array::length(params) > 0 {\n          String::concat(\"(\", String::concat(join(for pt in params {\n            print_type_expr(pt)\n          }, \", \"), \")\"))\n        } else \"\"\n        String::concat(\"  \", String::concat(op_name, String::concat(params_str, String::concat(\" -> \", print_type_expr(ret)))))\n      }\n      String::concat(p, String::concat(\"effect \", String::concat(name, String::concat(tp, String::concat(\" {\\n\", String::concat(join(op_parts, \";\\n\"), \"\\n}\"))))))\n    }\n  }\n}\n\nlet needs_program_separator: (String) -> Bool = (stmt_text) -> {\n  if String::length(stmt_text) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(stmt_text, 0)\n    c == '(' || c == '['\n  }\n}\n\nexport let print_program: (Array[Stmt]) -> String = (stmts) -> {\n  let len = Array::length(stmts)\n  // O(N) build via ArrayBuilder (matching this file's join/escape_string idiom);\n  // the previous `out = String::concat(out, ...)` per statement was O(N²) over\n  // the total printed size, which dominates emit-module-source (issue #366).\n  let b = ArrayBuilder::new()\n  let mut i = 0\n  while i < len {\n    let stmt_text = print_stmt(Array::get(stmts, i))\n    if i > 0 {\n      let sep = if needs_program_separator(stmt_text) {\n        \";\\n\"\n      } else \"\\n\"\n      ArrayBuilder::push(b, sep)\n    }\n    ArrayBuilder::push(b, stmt_text)\n    i = i + 1\n  }\n  String::join(ArrayBuilder::freeze(b), \"\")\n}\n")
}

