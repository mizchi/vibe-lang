_block_void(buf)\n      // $tail\n      emit_loop_void(buf)\n      // $scan: if (pos + 16 > len) br $tail\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 16)\n      emit_i32_add(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_gt_u(buf)\n      emit_if_void(buf)\n      emit_br(buf, 2)\n      emit_end(buf)\n      // addr = base + pos\n      emit_local_get(buf, base_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, pos_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_add(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, addr_l)\n      // is_ws = (c==0x20) | (c==0x09) | (c==0x0A) | (c==0x0D), v128 on stack\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 32)\n      emit_i8x16_eq(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 9)\n      emit_i8x16_eq(buf)\n      emit_v128_or(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 10)\n      emit_i8x16_eq(buf)\n      emit_v128_or(buf)\n      emit_local_get(buf, addr_l)\n      emit_i32_wrap_i64(buf)\n      emit_v128_load(buf, 0, 0)\n      emit_v128_const_splat_byte(buf, 13)\n      emit_i8x16_eq(buf)\n      emit_v128_or(buf)\n      // mask = bitmask(not(is_ws)): bit i set => lane i is NON-whitespace\n      emit_v128_not(buf)\n      emit_i8x16_bitmask(buf)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, mask_l)\n      // if (mask == 0) { pos += 16; br $scan }\n      emit_local_get(buf, mask_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_eqz(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, pos_l)\n      emit_i64_const(buf, 16)\n      emit_i64_add(buf)\n      emit_local_set(buf, pos_l)\n      emit_br(buf, 1)\n      emit_end(buf)\n      //