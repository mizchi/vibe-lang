let cli_adapter_source_156 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_core.vibe",
"//# Imports\n\nimport .. / .. / .. / core / ast.vibe {\n  Expr\n}\n\nimport ./preprocess_interp_string_fold_nonempty.vibe {\n  fold_interp_exprs_nonempty\n}\n\n//# Functions\n\nexport let fold_interp_exprs: (Array[Expr]) -> Expr = (result_arr) -> {\n  let result_len = Array::length(result_arr)\n  if result_len == 0 {\n    EString(\"\")\n  } else {\n    fold_interp_exprs_nonempty(result_arr, result_len)\n  }\n}\n")
