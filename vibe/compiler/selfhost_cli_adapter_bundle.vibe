mit_local_set(buf, idx)\n      compile_expr(buf, body, local_names, nl, ctx, ld)\n    }\n  } else if __tag == 14 {\n    let first = get_eseq_first(expr)\n    let second = get_eseq_second(expr)\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\n    emit_drop(buf)\n    compile_expr(buf, second, local_names, nl, ctx, ld)\n  } else {\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\n  }\n}\n\n\n\n\n\n\n\n\n\n\n\nexport let rec compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\n  let __tag = expr_tag(expr)\n  if __tag == 0 {\n    let n = get_eint_value(expr)\n    emit_i64_const(buf, n)\n    if ctx.enable_rc {\n      emit_i64_const(buf, 1)\n      emit_i64_shl(buf)\n    }\n    next_local\n  } else if __tag == 1 {\n    let b_val = get_ebool_value(expr)\n    emit_i64_const(buf, if b_val {\n      if ctx.enable_rc {\n        2\n      } else {\n        1\n      }\n    } else {\n      0\n    })\n    next_local\n  } else if __tag == 2 {\n    let v = get_efloat_value(expr)\n    let lo = Double::to_i64_bits_lo(v)\n    let hi = Double::to_i64_bits_hi(v)\n    emit_f64_const_lohi(buf, lo, hi)\n    emit_i64_reinterpret_f64(buf)\n    if ctx.enable_rc {\n      Array::push(local_names, \"__fbits\")\n      Array::push(local_names, \"__fbox\")\n      emit_box_float(buf, ctx, next_local, next_local + 1)\n      next_local + 2\n    } else {\n      next_local\n    }\n  } else if __tag == 3 {\n    let s = get_estring_value(expr)\n    let idx = str_table_lookup(ctx.str_table.strs, s)\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\n    next_local\n  } else if __tag == 4 {\n    let name = get_eident_name(expr)\n    let len = Array::length(local_names)\n    let mut __tl_i = len - 1\n    let mut __tl_result = -1\n    while __tl_i >= 0 {\n      if Array::get(local_names, __tl_i) == name {\n        __tl