ray::push(builtin_names_list, \"__rc_alloc\")\n    Array::push(builtin_param_counts, 1)\n    Array::push(builtin_needs_env_list, false)\n    Array::push(builtin_indices_list, rc_alloc_idx)\n    Array::push(builtin_returns_list, 1)\n  } else {\n    ()\n  }\n  Array::push(builtin_names_list, \"__heap_grow_check\")\n  Array::push(builtin_param_counts, 0)\n  Array::push(builtin_needs_env_list, false)\n  Array::push(builtin_indices_list, heap_grow_check_idx)\n  Array::push(builtin_returns_list, 0)\n  // #415 B-0: the static registration above must agree with the central\n  // registry (name set + params + returns, both directions). Placed BEFORE\n  // the linked_imports loop — those are user-declared effect bridges with\n  // dynamic names, not builtins.\n  verify_lane_builtins(\"linear\", builtin_names_list, builtin_param_counts, builtin_returns_list)\n  let mut li_reg = 0\n  while li_reg < Array::length(linked_imports) {\n    let (_, lfn_name, lparams, lreturns) = Array::get(linked_imports, li_reg)\n    Array::push(builtin_names_list, lfn_name)\n    Array::push(builtin_param_counts, lparams)\n    Array::push(builtin_needs_env_list, true)\n    Array::push(builtin_indices_list, Array::get(linked_import_indices, li_reg))\n    Array::push(builtin_returns_list, lreturns)\n    li_reg = li_reg + 1\n  }\n  let mut all_fn_i = 0\n  while all_fn_i < Array::length(builtin_names_list) {\n    Array::push(fn_names_list, Array::get(builtin_names_list, all_fn_i))\n    Array::push(fn_param_counts, Array::get(builtin_param_counts, all_fn_i))\n    Array::push(fn_needs_env_list, Array::get(builtin_needs_env_list, all_fn_i))\n    Array::push(fn_indices_list, Array::get(builtin_indices_list, all_fn_i))\n    Array::push(fn_returns_list, Array::get(builtin_returns_list, all_fn_i))\n    all_fn_i = all_fn_i + 1\n  }\n  let all_fn_names_list = fn_names_list\n  let all_fn_param_counts = fn_param_counts\n  let all_fn_needs_env_list = fn_needs_env_list\n  let all_fn_indices_list = fn_indices_list\n  let all_fn_returns_list = fn_returns_list\n  let num_base_types = 9\n  let lt_w = LambdaTable::{\n    bodies: lc_fresh_bytes_array(),\n    param_counts: lc_fresh_int_array(),\n    captures: lc_fresh_string_matrix(),\n    meta_i32: lc_fresh_int_array(),\n    meta_i64: lc_fresh_int_array()\n  }\n  let bodies = lc_fresh_bytes_array()\n  let meta_i32 = lc_fresh_int_array()\n  let meta_i64 = lc_fresh_int_array()\n  Array::push(bodies, static_print_i64_body())\n  Array::push(meta_i32, 3)\n  Array::push(meta_i64, 1)\n  Array::push(bodies, static_print_str_body())\n  Array::push(meta_i32, 2)\n  Array::push(meta_i64, 0)\n  if enable_rc {\n    Array::push(bodies, gen_str_len_body(true))\n  } else {\n    Array::push(bodies, static_str_len_body())\n  }\n  Array::push(meta_i32, 0)\n  Array::push(meta_i64, 0)\n  // #748: SIMD chunk compare needs the extra chunk_limit local (meta_i32 6).\n  Array::push(bodies, gen_str_eq_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  Array::push(bodies, gen_str_concat_body())\n  Array::push(meta_i32, 6)\n  Array::push(meta_i64, 0)\n  if enable_rc {\n    Array::push(bodies, gen_arr_new_body(true, rc_alloc_idx))\n    Array::push(meta_i32, 1)\n    Array::push(meta_i64, 0)\n    Array::push(bodies, gen_arr_len_body(true))\n    Array::push(meta_i32, 0)\n    Array::push(meta_i64, 0)\n    Array::push(bodies, gen_arr_get_body(true))\n    Array::push(meta_i32, 1)\n    Array::push(meta_i64, 0)\n    Array::push(bodies, gen_arr_push_body(true, rc_alloc_idx, rc_shadow))\n    Array::push(meta_i32, 6)\n    Array::push(meta_i64, 0)\n    Array::push(bodies, gen_arr_set_body(true))\n    Array::push(meta_i32, 1)\n    Array::push(meta_i64, 0)\n  } else {\n    Array::push(bodies, gen_arr_new_body(false, rc_alloc_idx))\n    Array::push(meta_i32, 1)\n    Array::push(meta_i64, 0)\n    Array::push(bodies, static_arr_len_body())\n    Array::push(meta_i32, 0)\n    Array::push(meta_i64, 0)\n    Array::push(bodies, static_arr_get_body())\n    Array::push(m