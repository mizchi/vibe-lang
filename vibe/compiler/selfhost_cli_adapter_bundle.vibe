h_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\n//# Functions\n\nexport let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      // ADR-0055 Stage 1: scrutinee is a tagged int; tag the literal to match.\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          if ctx.enable_rc { 2 } else { 1 }\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, str_eq_fi)\n              emit_i32_wrap_i64(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else {\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\n              match pat {\n                POr(left, right) => {\n                  emit_or_check(left)\n                  emit_or_check(right)\n                  bytebuf_push(buf, 114)\n                },\n                PInt(n) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, n)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, 1)\n                    emit_i64_shl(buf)\n                  }\n                  emit_i64_eq(buf)\n                },\n                PCtor(cname, cargs) => {\n                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)\n                  let ctag = if ci >= 0 {\n                    Array::get(ctx.ctor_table.tags, ci)\n                  } else {\n                    -1\n                  }\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i32_load(buf, 2, 0)\n                  emit_i32_const(buf, ctag)\n                  emit_i32_eq(buf)\n                  if Array::length(cargs) == 1 {\n                    match Array::get(cargs, 0) {\n                      PInt(n) => {\n                        emit_local_get(buf, scrut_local)\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                        emit_i32_wrap_i64(buf)\n                        emit_i64_load(buf, 3, 8)\n                        emit_i64_const(buf, n)\n                        if ctx.enable_rc {\n                          emit_i64_const(buf, 1)\n                          emit_i64_shl(buf)\n                        }\n                        emit_i64_eq(buf)\n                        bytebuf_push(buf, 113)\n                      },\n                      _ => ()\n                    }\n                  }\n                },\n                _ => emit_i32_const(buf, 1)\n              }\n            }\n            emit_or_check(__cond_p)\n            emit_if_i64(buf)\n            0\n          }\n        }\n      }\n    }\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < Array::length(cargs_bind) {\n        let __sub_p = Array::get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          Array::push(local_names, pname)\n        } else if is_ptuple(__sub_p) {\n          let tpats = get_ptuple_pats(__sub_p)\n          let tup_local = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, tup_local)\n          Array::push(local_names, \"__ctor_tup\")\n          let mut ti = 0\n          while ti < Array::length(tpats) {\n            let tp = Array::get(tpats, ti)\n            if is_pbind(tp) {\n              let tpname = get_pbind_name(tp)\n              let tfl = Array::length(local_names)\n              emit_local_get(buf, tup_local)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + ti * 8 } else { ti * 8 })\n              emit_local_set(buf, tfl)\n              Array::push(local_names, tpname)\n            }\n            ti = ti + 1\n          }\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let (__catch_p, __catch_body) = __catch_arm\n    0\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        let cargs = get_pctor_args(__catch_p)\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          let __sub_p2 = Array::get(cargs, cbi2)\n          if is_pbind(__sub_p2) {\n            let pname = get_pbind_name(__sub_p2)\n            let fl2 = Array::length(local_names)\n            emit_local_get(buf, scrut_local)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + cbi2 * 8)\n            emit_local_set(buf, fl2)\n            Array::push(local_names, pname)\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let pats = get_ptuple_pats(__catch_p)\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          let mut pi2 = 0\n          while pi2 < Array::length(pats) {\n            let __tp = Array::get(pats, pi2)\n            if is_pbind(__tp) {\n              let pname = get_pbind_name(__tp)\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            } else if is_ptuple(__tp) {\n              let sub_pats = get_ptuple_pats(__tp)\n              let sub_ptr = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + pi2 * 8 } else { pi2 * 8 })\n              emit_local_set(buf, sub_ptr)\n              Array::push(local_names, \"__sub_tup\")\n              let mut si3 = 0\n              while si3 < Array::length(sub_pats) {\n                let sp = Array::get(sub_pats, si3)\n                if is_pbind(sp) {\n                  let spname = get_pbind_name(sp)\n                  let sfl = Array::length(local_names)\n                  emit_local_get(buf, sub_ptr)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, -2)\n                    emit_i64_and(buf)\n                  }\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, if ctx.enable_rc { 8 + si3 * 8 } else { si3 * 8 })\n                  emit_local_set(buf, sfl)\n                  Array::push(local_names, spname)\n                }\n                si3 = si3 + 1\n              }\n              0\n            } else {\n              if is_pwild(__tp) {\n                0\n              } else {\n                throw(\"unsupported pattern in tuple destructure\")\n              }\n            }\n            pi2 = pi2 + 1\n          }\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n")
