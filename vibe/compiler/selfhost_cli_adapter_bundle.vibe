"//# Imports\n\nimport .. / .. / builtin_name.vibe {\n  canonical_builtin_name\n}\n\nimport .. / .. / core {\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\n}\n\nimport .. / common_analysis {\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\n}\n\nimport .. / common_base {\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, effect_name_to_tag, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, emit_unbox_float, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\n}\n\nimport .. / common_extractors {\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\n}\n\nimport .. / wasm_emit {\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\n}\n\nimport ./compile_lambda.vibe {\n  compile_lambda\n}\n\nimport ./compile_match.vibe {\n  compile_match\n}\n\n//# Functions\n\nexport let compile_call: (Bytes, Expr, Array[Expr], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, callee, args, local_names, next_local, ctx, ld, ce) -> {\n  if is_eident(callee) {\n    let fname0 = canonical_builtin_name(get_eident_name(callee))\n    // Stream[T] (docs/spec/wasi-p3-async.md §2.4) is backed by the eager Array\n    // machinery on the linear backend: map/fold reuse the existing inline\n    // Array::map / Array::fold lowering verbatim (same arg order, same value\n    // representation). empty/once/filter are handled explicitly below.\n    let fname = if fname0 == \"Stream::map\" {\n      \"Array::map\"\n    } else if fname0 == \"Stream::fold\" {\n      \"Array::fold\"\n    } else {\n      fname0\n    }\n    let fn_len2 = Array::length(ctx.func_table.names)\n    let mut fn_idx_in_list = -1\n    let mut __tr_j = 0\n    while __tr_j < fn_len2 {\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\n        fn_idx_in_list = __tr_j\n        __tr_j = fn_len2\n      } else {\n        __tr_j = __tr_j + 1\n      }\n    }\n    let mut local_idx_hint = -1\n    let mut li = Array::length(local_names) - 1\n    while li >= 0 {\n      if Array::get(local_names, li) == fname {\n        local_idx_hint = li\n        li = -1\n      } else {\n        li = li - 1\n      }\n    }\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\n    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(rec_fields) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = Array::slice([\n                EUnit\n              ], 0, 0)\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n                let mut found_rfv = EUnit\n                while ri < Array::length(rec_fields) {\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\n                  if rfn == target_name {\n                    found_rfv = rfv\n                    ri = Array::length(rec_fields)\n                  } else {\n                    ri = ri + 1\n                  }\n                }\n                Array::push(ordered, found_rfv)\n                oi = oi + 1\n              }\n              ordered\n            } else {\n              args\n            }\n          },\n          _ => args\n        }\n      } else {\n        args\n      }\n      if ctx.enable_rc {\n        let total = 16 + fc * 8\n        emit_i64_const(buf, total)\n        emit_call(buf, ctx.rc_alloc_func_idx)\n        emit_local_set(buf, ptr_local)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, total)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store(buf, 2, 4)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, 1)\n        emit_i32_store8(buf, 0, 7)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 8)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 12)\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 16 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 8)\n        emit_i64_add(buf)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      } else {\n        let obj_size = 8 + fc * 8\n        emit_global_get(buf, 0)\n        emit_i64_extend_i32_u(buf)\n        emit_local_set(buf, ptr_local)\n        emit_global_get(buf, 0)\n        emit_i32_const(buf, obj_size)\n        emit_i32_add(buf)\n        emit_global_set(buf, 0)\n        emit_heap_grow_after_heap_set(buf, ctx)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, tag)\n        emit_i32_store(buf, 2, 0)\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i32_const(buf, fc)\n        emit_i32_store(buf, 2, 4)\n        let mut nl_c = next_local + 1\n        let mut fi_c = 0\n        while fi_c < Array::length(actual_args) {\n          nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n          let val_local = nl_c\n          Array::push(local_names, \"__ctor_val\")\n          emit_local_set(buf, val_local)\n          nl_c = nl_c + 1\n          emit_local_get(buf, ptr_local)\n          emit_i32_wrap_i64(buf)\n          emit_local_get(buf, val_local)\n          emit_i64_store(buf, 3, 8 + fi_c * 8)\n          fi_c = fi_c + 1\n        }\n        emit_local_get(buf, ptr_local)\n        emit_i64_const(buf, 1)\n        emit_i64_or(buf)\n        nl_c\n      }\n    }\n    else if !prefer_bound_call && fname == \"eq\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"not\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"await\" {\n      // M1b-3b (docs/spec/wasi-p3-async.md): awaiting a ready future yields the\n      // value directly (ready-future fast path). Real blocking future.read for\n      // async sources (host async imports / spawned subtasks) is M1b-3c.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Future::ready\" {\n      // Future::ready(x) carries x directly — no canon future is created for an\n      // already-resolved value.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::spawn\" {\n      // Structured concurrency, synchronous model (docs/spec/wasi-p3-async.md\n      // §2.5): on the single-threaded linear backend a spawned task runs its\n      // thunk eagerly, so the Task[T] value *is* the resolved result. `join`\n      // is then identity and `cancel` a no-op. Real subtask spawn over\n      // waitable-set / future.cancel is documented future work.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let fn_l = nl\n      let slot_l = nl + 1\n      let env_l = nl + 2\n      Array::push(local_names, \"__spawn_fn\")\n      Array::push(local_names, \"__spawn_slot\")\n      Array::push(local_names, \"__spawn_env\")\n      emit_local_set(buf, fn_l)\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 0)\n      nl + 3\n    }\n    else if !prefer_bound_call && fname == \"Task::join\" {\n      // The task already holds its resolved value (eager spawn) — join is the\n      // identity projection onto that value.\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::cancel\" {\n      // The eager task has already completed; cancel evaluates the handle for\n      // its effects, drops it, and yields Unit.\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_drop(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"Task::race\" {\n      // Both tasks are already resolved under the eager model; race resolves to\n      // the first task's value. (b is evaluated for its effects, then dropped.)\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_drop(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"Stream::empty\" {\n      // Empty stream = empty backing array.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      emit_call(buf, arr_new_fi)\n      next_local\n    }\n    else if !prefer_bound_call && fname == \"Stream::once\" {\n      // Singleton stream = one-element backing array.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let val_l = nl\n      let arr_l = nl + 1\n      Array::push(local_names, \"__once_val\")\n      Array::push(local_names, \"__once_arr\")\n      emit_local_set(buf, val_l)\n      emit_call(buf, arr_new_fi)\n      emit_local_set(buf, arr_l)\n      emit_local_get(buf, arr_l)\n      emit_local_get(buf, val_l)\n      emit_call(buf, arr_push_fi)\n      emit_local_get(buf, arr_l)\n      nl + 2\n    }\n    else if !prefer_bound_call && fname == \"Stream::filter\" {\n      // Eager filter: walk the backing array, keep elements whose predicate is\n      // truthy. Mirrors the Array::map loop but pushes conditionally.\n      let (arr_new_fi, _, _) = resolve_func(ctx.func_table, \"array_new\")\n      let (arr_len_fi, _, _) = resolve_func(ctx.func_table, \"Array::length\")\n      let (arr_get_fi, _, _) = resolve_func(ctx.func_table, \"Array::get\")\n      let (arr_push_fi, _, _) = resolve_func(ctx.func_table, \"Array::push\")\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      let arr_l = nl\n      let fn_l = nl + 1\n      let res_l = nl + 2\n      let len_l = nl + 3\n      let i_l = nl + 4\n      let slot_l = nl + 5\n      let env_l = nl + 6\n      let elem_l = nl + 7\n      Array::push(local_names, \"__filter_arr\")\n      Array::push(local_names, \"__filter_fn\")\n      Array::push(local_names, \"__filter_res\")\n      Array::push(local_names, \"__filter_len\")\n      Array::push(local_names, \"__filter_i\")\n      Array::push(local_names, \"__filter_slot\")\n      Array::push(local_names, \"__filter_env\")\n      Array::push(local_names, \"__filter_elem\")\n      emit_local_set(buf, fn_l)\n      emit_local_set(buf, arr_l)\n      emit_call(buf, arr_new_fi)\n      emit_local_set(buf, res_l)\n      emit_local_get(buf, arr_l)\n      emit_call(buf, arr_len_fi)\n      emit_local_set(buf, len_l)\n      emit_i64_const(buf, 0)\n      emit_local_set(buf, i_l)\n      emit_closure_resolve(buf, fn_l, slot_l, env_l)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, i_l)\n      emit_local_get(buf, len_l)\n      emit_i64_ge_s(buf)\n      emit_br_if(buf, 1)\n      emit_local_get(buf, arr_l)\n      emit_local_get(buf, i_l)\n      emit_call(buf, arr_get_fi)\n      emit_local_set(buf, elem_l)\n      emit_local_get(buf, elem_l)\n      emit_closure_call_tail(buf, env_l, slot_l, 9, 1)\n      emit_i64_const(buf, 0)\n      emit_i64_ne(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, res_l)\n      emit_local_get(buf, elem_l)\n      emit_call(buf, arr_push_fi)\n      emit_end(buf)\n      emit_local_get(buf, i_l)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_local_set(buf, i_l)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, res_l)\n      nl + 8\n    }\n    else if !prefer_bound_call && fname == \"Stream::next\" {\n      // Stream::next(s) : Future[Option[T]] (docs/spec §2.4). On the eager\n      // Array-backed model `next` peeks the head: Some(s[0]) if non-empty else\n      // None. Synthesize the Option expression and reuse the existing ctor +\n      // Array::length/get lowering via `ce`. (await unwraps the ready future.)\n      let s_expr = Array::get(args, 0)\n      let synth = ELet(\"__nx_s\", s_expr, EIf(ECall(EIdent(\"lt\"), [\n        EInt(0),\n        ECall(EIdent(\"Array::length\"), [\n          EIdent(\"__nx_s\")\n        ])\n      ]), ECall(EIdent(\"Some\"), [\n        ECall(EIdent(\"Array::get\"), [\n          EIdent(\"__nx_s\"),\n          EInt(0)\n        ])\n      ]), ECall(EIdent(\"None\"), Array::slice([\n        EUnit\n      ], 0, 0))))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Task::timeout\" {\n      // Task::timeout(ms, thunk) : Option[T] (docs/spec §2.5). Synchronous eager\n      // model: the thunk always completes, so the result is Some(thunk()); the\n      // deadline is evaluated for its effects then ignored. Synthesized and\n      // lowered via `ce` so the Some ctor + 0-arg closure call reuse existing\n      // lowering.\n      let ms_expr = Array::get(args, 0)\n      let thunk_expr = Array::get(args, 1)\n      let synth = ELet(\"__to_fn\", thunk_expr, ELet(\"__to_ms\", ms_expr, ECall(EIdent(\"Some\"), [\n        ECall(EIdent(\"__to_fn\"), Array::slice([\n          EUnit\n        ], 0, 0))\n      ])))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"String::to_bytes\" {\n      // String::to_bytes(s) : Stream[Int]  (ByteStream, docs/spec §2.4/§4.1).\n      // Eagerly materialise the string's bytes into the Array that backs a\n      // Stream[Int], so request/response bodies can be consumed with the Stream\n      // combinators. Synthesized as a `let mut arr = []; while i < length(s) {\n      // Array::push(arr, char_code_at(s, i)); i = i + 1 }; arr` loop and lowered\n      // via `ce`, so String::length/char_code_at + the loop counter follow the\n      // same (RC) tagging conventions as ordinary source. char_code_at reads one\n      // byte (i32.load8_u), so this is byte-accurate.\n      let s_expr = Array::get(args, 0)\n      let loop_body = ESeq(ECall(EIdent(\"Array::push\"), [\n        EIdent(\"__tb_arr\"),\n        ECall(EIdent(\"String::char_code_at\"), [\n          EIdent(\"__tb_s\"),\n          EIdent(\"__tb_i\")\n        ])\n      ]), EAssign(\"__tb_i\", ECall(EIdent(\"add\"), [\n        EIdent(\"__tb_i\"),\n        EInt(1)\n      ]), EUnit))\n      let synth = ELet(\"__tb_s\", s_expr, ELetMut(\"__tb_arr\", EArray(Array::slice([\n        EUnit\n      ], 0, 0)), ELetMut(\"__tb_i\", EInt(0), ESeq(EWhile(ECall(EIdent(\"lt\"), [\n        EIdent(\"__tb_i\"),\n        ECall(EIdent(\"String::length\"), [\n          EIdent(\"__tb_s\")\n        ])\n      ]), loop_body), EIdent(\"__tb_arr\")))))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"Stream::to_string\" {\n      // Stream::to_string(bs) : String  (ByteStream -> String, docs/spec\n      // §M2c-2). Collect a Stream[Int] of byte codes into a String, e.g. to\n      // build a response body. Synthesized as `let parts = []; while i <\n      // length(bs) { Array::push(parts, String::from_char_code(bs[i])); i = i +\n      // 1 }; String::join(parts, \"\")` and lowered via `ce`. Pushing one-char\n      // pieces and joining once is O(n); the earlier `acc = String::concat(acc,\n      // ...)` accumulator was O(n^2) (each concat copied the whole prefix), the\n      // dominant cost in the streaming bench (4 KB to_string: 1.77s -> see\n      // scripts/bench_streaming.sh). linked_compile always seeds \"\" into the\n      // string table, so the join separator literal resolves.\n      let bs_expr = Array::get(args, 0)\n      let ts_body = ESeq(ECall(EIdent(\"Array::push\"), [\n        EIdent(\"__ts_parts\"),\n        ECall(EIdent(\"String::from_char_code\"), [\n          ECall(EIdent(\"Array::get\"), [\n            EIdent(\"__ts_arr\"),\n            EIdent(\"__ts_i\")\n          ])\n        ])\n      ]), EAssign(\"__ts_i\", ECall(EIdent(\"add\"), [\n        EIdent(\"__ts_i\"),\n        EInt(1)\n      ]), EUnit))\n      let synth = ELet(\"__ts_arr\", bs_expr, ELetMut(\"__ts_parts\", EArray(Array::slice([\n        EUnit\n      ], 0, 0)), ELetMut(\"__ts_i\", EInt(0), ESeq(EWhile(ECall(EIdent(\"lt\"), [\n        EIdent(\"__ts_i\"),\n        ECall(EIdent(\"Array::length\"), [\n          EIdent(\"__ts_arr\")\n        ])\n      ]), ts_body), ECall(EIdent(\"String::join\"), [\n        EIdent(\"__ts_parts\"),\n        EString(\"\")\n      ])))))\n      ce(buf, synth, local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"add\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_add(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"sub\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"mul\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_mul(buf)\n      nl\n    }