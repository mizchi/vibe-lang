let cli_adapter_source_120 = () -> (String, String) {
  ("vibe/compiler/ripple/ripple.vibe",
"//# Types\n\n// RippleDb is the selfhost compiler's incremental module DB: it maps module\n// path -> source, path -> fingerprint, and path -> dependency list.\n//\n// Previously each map was a flat association array (`Array[(String, _)]`):\n// every lookup was O(n) and every upsert rebuilt the whole array O(n), so\n// threading the DB through N modules was O(N^2) time AND allocations (matching\n// the alloc-bound compile profile from moon-pprof). This replaces them with\n// fixed-bucket hash maps: hash the path to one of NBUCKETS buckets and scan\n// only that (small) bucket. Lookup/insert are O(1) amortized, so a full\n// N-module compile is O(N).\n//\n// The maps mutate their buckets in place, so the DB is *linear*: callers must\n// use the returned db and discard the old one. The selfhost compiler always\n// threads `next_db`, so this is safe. eval_count lives in a 1-element array so\n// it is bumped without rebuilding the enum payload.\n\nexport enum StrMap {\n  StrMap(Array[Array[(String, String)]])\n}\n\nexport enum DepsMap {\n  DepsMap(Array[Array[(String, Array[String])]])\n}\n\nexport enum RippleDb {\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\n}\n\n//# Functions\n\nlet nbuckets: () -> Int = () -> {\n  256\n}\n\nlet bucket_mask: () -> Int = () -> {\n  255\n}\n\n// FNV-1a-style string hash, masked to a non-negative bucket index. NBUCKETS is\n// a power of two so we mask with `& 255` instead of `%`. Intermediate values\n// are kept within 30 bits so the multiply stays well under the 2^61 tag limit.\nlet hash_bucket: (String) -> Int = (key) -> {\n  let len = String::length(key)\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let c = String::char_code_at(key, i)\n      let mixed = (acc ^ c) * 16777619\n      let bounded = mixed & 1073741823\n      go(i + 1, bounded)\n    }\n  }\n  let h = go(0, 2166136261 & 1073741823)\n  h & bucket_mask()\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_string_pairs: () -> Array[(String, String)] = () -> {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_deps_pairs: () -> Array[(String, Array[String])] = () -> {\n  Array::slice([\n    (\"\", empty_strings())\n  ], 0, 0)\n}\n\n// Build a bucket array of NBUCKETS DISTINCT empty assoc arrays. (Array::make\n// would alias one array across every slot, so push fresh empties instead.)\nlet new_string_buckets: () -> Array[Array[(String, String)]] = () -> {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_string_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nlet new_deps_buckets: () -> Array[Array[(String, Array[String])]] = () -> {\n  let n = nbuckets()\n  let b = ArrayBuilder::new()\n  let rec go: (Int) -> Unit = (i) -> {\n    if i >= n {\n      ()\n    } else {\n      ArrayBuilder::push(b, empty_deps_pairs())\n      go(i + 1)\n    }\n  }\n  go(0)\n  ArrayBuilder::freeze(b)\n}\n\nlet strmap_new: () -> StrMap = () -> {\n  StrMap(new_string_buckets())\n}\n\nlet rec assoc_get_string: (Array[(String, String)], String, Int) -> Option[String] = (bucket, key, i) -> {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_string(bucket, key, i + 1)\n    }\n  }\n}\n\nlet strmap_get: (StrMap, String) -> Option[String] = (m, key) -> {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_string(bucket, key, 0)\n    }\n  }\n}\n\n// In-place upsert into the bucket for `key`.\nlet strmap_set: (StrMap, String, String) -> Unit = (m, key, value) -> {\n  match m {\n    StrMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, value))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, value))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nlet depsmap_new: () -> DepsMap = () -> {\n  DepsMap(new_deps_buckets())\n}\n\nlet rec assoc_get_deps: (Array[(String, Array[String])], String, Int) -> Option[Array[String]] = (bucket, key, i) -> {\n  if i >= Array::length(bucket) {\n    None\n  } else {\n    let (k, v) = Array::get(bucket, i)\n    if k == key {\n      Some(v)\n    } else {\n      assoc_get_deps(bucket, key, i + 1)\n    }\n  }\n}\n\nlet depsmap_get: (DepsMap, String) -> Option[Array[String]] = (m, key) -> {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      assoc_get_deps(bucket, key, 0)\n    }\n  }\n}\n\nlet depsmap_set: (DepsMap, String, Array[String]) -> Unit = (m, key, deps) -> {\n  match m {\n    DepsMap(buckets) => {\n      let idx = hash_bucket(key)\n      let bucket = Array::get(buckets, idx)\n      let len = Array::length(bucket)\n      let rec go: (Int) -> Unit = (i) -> {\n        if i >= len {\n          Array::push(bucket, (key, deps))\n        } else {\n          let (k, _) = Array::get(bucket, i)\n          if k == key {\n            Array::set(bucket, i, (key, deps))\n          } else {\n            go(i + 1)\n          }\n        }\n      }\n      go(0)\n    }\n  }\n}\n\nexport let ripple_new: () -> RippleDb = () -> {\n  let count = ArrayBuilder::new()\n  ArrayBuilder::push(count, 0)\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\n}\n\nexport let ripple_get_source: (RippleDb, String) -> Option[String] = (db, path) -> {\n  match db {\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\n  }\n}\n\nexport let ripple_get_fingerprint: (RippleDb, String) -> Option[String] = (db, path) -> {\n  match db {\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\n  }\n}\n\nexport let ripple_get_deps: (RippleDb, String) -> Option[Array[String]] = (db, path) -> {\n  match db {\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\n  }\n}\n\nexport let ripple_eval_count: (RippleDb) -> Int = (db) -> {\n  match db {\n    RippleDb(_, _, _, count) => Array::get(count, 0)\n  }\n}\n\nexport let ripple_set_source: (RippleDb, String, String) -> RippleDb = (db, path, source) -> {\n  match db {\n    RippleDb(sources, _, _, _) => {\n      strmap_set(sources, path, source)\n      db\n    }\n  }\n}\n\nexport let ripple_record_eval: (RippleDb, String, String, Array[String]) -> RippleDb = (db, path, fingerprint, deps) -> {\n  match db {\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\n      Some(prev_fp) => if prev_fp == fingerprint {\n        db\n      } else {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      },\n      None => {\n        strmap_set(fingerprints, path, fingerprint)\n        depsmap_set(deps_map, path, deps)\n        Array::set(count, 0, Array::get(count, 0) + 1)\n        db\n      }\n    }\n  }\n}\n")
}

let cli_adapter_source_121 = () -> (String, String) {
  ("vibe/compiler/runtime/typecheck_fs.vibe",
"//# Imports\n\nimport .. / cache / persistent_cache.vibe {\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\n}\n\nimport .. / checker / checker_stmt.vibe {\n  check_program, check_program_with_env\n}\n\nimport .. / core {\n  Stmt, Type, TypeEnv, env_bind, env_flat_bindings, env_lookup_flat\n}\n\nimport .. / module_graph_path.vibe {\n  dir_of_path, resolve_import_path, resolve_import_path_candidates\n}\n\nimport .. / module_loader.vibe {\n  load_or_parse_module_header_fs\n}\n\nimport .. / ripple {\n  RippleDb, ripple_get_deps, ripple_get_fingerprint, ripple_get_source, ripple_record_eval\n}\n\nimport .. / syntax {\n  lex_with_offsets, parse_program_located, parse_program_recovering, offset_to_line_col\n}\n\nimport ./eval_loader {\n  contains_str\n}\n\nexport ./persistent_env_codec.vibe {\n  load_persistent_dep_list, load_persistent_leaf_fingerprint, load_persistent_type_env, persistent_dep_list_text, persistent_leaf_fingerprint_text, persistent_type_env_cache_text\n}\n\n//# Functions\n\nlet empty_stack: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_dep_fps: () -> Array[(String, String)] = () -> {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        result = Some(env)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nlet starts_with_upper: (String) -> Bool = (name) -> {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nlet rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nlet bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nlet build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nlet upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (p, _) = Array::get(cache, i)\n    if p == path {\n      Array::set(cache, i, (path, env))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(cache, (path, env))\n  }\n  cache\n}\n\nlet ensure_env_cache_for_path: (RippleDb, Array[(String, TypeEnv)], String) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, path) -> {\n  match lookup_env_cache(env_cache, path) {\n    Some(_) => env_cache,\n    None =>\n    match ripple_get_fingerprint(rdb, path) {\n      Some(fingerprint) =>\n      match load_persistent_type_env(fingerprint) {\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\n        None => env_cache\n      },\n      None => env_cache\n    }\n  }\n}\n\nlet ensure_env_cache_for_paths: (RippleDb, Array[(String, TypeEnv)], Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, paths) -> {\n  let mut cache = env_cache\n  let mut i = 0\n  while i < Array::length(paths) {\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\n    i = i + 1\n  }\n  cache\n}\n\nlet build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet copy_string_array: (Array[String]) -> Array[String] = (items) -> {\n  // Iterative push: previous recursive Array::concat(acc, [x]) was\n  // O(N^2) — copied the full prefix on each step.\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(items)\n  while i < len {\n    Array::push(out, Array::get(items, i))\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while !done {\n    if i >= len {\n      done = true\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        result = Some(v)\n        done = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n  result\n}\n\nlet upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {\n  let len = Array::length(pairs)\n  let mut i = 0\n  let mut found = false\n  while i < len && !found {\n    let (k, _) = Array::get(pairs, i)\n    if k == key {\n      Array::set(pairs, i, (key, value))\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    Array::push(pairs, (key, value))\n  }\n  pairs\n}\n\nlet parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\n  handle {\n    // Located lex+parse so EIdent (and other) nodes carry real source char\n    // offsets; the checker rides those offsets into type diagnostics via the\n    // [@off=N] marker (decoded by locate_type_error). The plain\n    // `parse_program(lex(source))` passed an empty starts array, leaving every\n    // offset at -1, so located type errors fell back to a first-occurrence scan.\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    parse_program_located(tokens, starts, source)\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nlet store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nlet write_persistent_dep_list_if_missing: (String, String, Array[String]) -> Unit with { Fs } = (path, source, deps) -> {\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(dep_cache_path)) {\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\n  } else {\n    ()\n  }\n}\n\n// Span of an identifier run starting at `start` (returns the end offset).\nlet typecheck_ident_run: (String, Int) -> Int = (s, start) -> {\n  let len = String::length(s)\n  let mut e = start\n  let mut go = true\n  while go && e < len {\n    let c = String::char_code_at(s, e)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    if is_id {\n      e = e + 1\n    } else {\n      go = false\n    }\n  }\n  e\n}\n\n// Best-effort `line:col` for a type error: pull the symbol out of\n// `unknown name: X` and locate its first occurrence in the source. Real\n// expression-level spans (AST node positions) remain future work; this gives\n// the common case a line number in both CLI and LSP (which parses the prefix).\n// Built with String::concat only (not `+`) to avoid the selfhost NUL fragility.\n// Prefix `msg` with the source `line:col` of the symbol that follows `marker`\n// in `msg` (if both are found); otherwise return `msg` unchanged.\nlet locate_by_marker: (String, String, String) -> String = (source, msg, marker) -> {\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    msg\n  } else {\n    let sstart = mi + String::length(marker)\n    let send = typecheck_ident_run(msg, sstart)\n    if send <= sstart {\n      msg\n    } else {\n      let sym = String::substring(msg, sstart, send)\n      let off = String::index_of(source, sym)\n      if off < 0 {\n        msg\n      } else {\n        let (line, col) = offset_to_line_col(source, off)\n        let loc = String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n        String::concat(loc, msg)\n      }\n    }\n  }\n}\n\n// First-occurrence heuristic locator (the original behavior). Kept separate so\n// the offset-marker path can fall through to it on the marker-stripped message.\nlet locate_type_error_heuristic: (String, String) -> String = (source, msg) -> {\n  // Already located (e.g. a parse error that bubbled here)? leave it.\n  if String::index_of(msg, \"line \") == 0 {\n    msg\n  } else {\n    let with_name = locate_by_marker(source, msg, \"unknown name: \")\n    if with_name != msg {\n      with_name\n    } else {\n      let with_arity = locate_by_marker(source, msg, \"function arity mismatch for \")\n      if with_arity != msg {\n        with_arity\n      } else {\n        let with_field = locate_by_marker(source, msg, \"unknown field \")\n        if with_field != msg {\n          with_field\n        } else {\n          locate_by_marker(source, msg, \"unknown constructor \")\n        }\n      }\n    }\n  }\n}\n\n// Build the `line L:col C: ` prefix for a source char offset (same format as\n// locate_by_marker). String::concat only — the selfhost `+`/interpolation NUL\n// hazard applies here too.\nlet offset_line_col_prefix: (String, Int) -> String = (source, off) -> {\n  let (line, col) = offset_to_line_col(source, off)\n  String::concat(\"line \", String::concat(__to_string(line), String::concat(\":\", String::concat(__to_string(col), \": \"))))\n}\n\n// Build a `line L:colC-E: ` RANGE prefix from a (start, end) char-offset span.\n// When start and end fall on the same source line this carries the exact end\n// column so the LSP can highlight the precise token (incl. qualified names);\n// when end is on a later line (or not greater than start) it degrades to the\n// point prefix. Backward compatible: `line L:` still leads, so existing\n// `grep -F \"line N:\"` assertions keep matching. String::concat only.\nlet offset_line_col_range_prefix: (String, Int, Int) -> String = (source, start, endo) -> {\n  let (l1, c1) = offset_to_line_col(source, start)\n  let (l2, c2) = offset_to_line_col(source, endo)\n  if l1 == l2 && endo > start {\n    String::concat(\"line \", String::concat(__to_string(l1), String::concat(\":\", String::concat(__to_string(c1), String::concat(\"-\", String::concat(__to_string(c2), \": \"))))))\n  } else {\n    offset_line_col_prefix(source, start)\n  }\n}\n\n// Parse a non-negative decimal integer from msg[start..end). Returns -1 if the\n// span is empty or contains a non-digit (callers then fall through to the text\n// heuristic).\nlet parse_offset_digits: (String, Int, Int) -> Int = (msg, start, end) -> {\n  if end <= start {\n    -1\n  } else {\n    let mut i = start\n    let mut acc = 0\n    let mut ok = true\n    while ok && i < end {\n      let c = String::char_code_at(msg, i)\n      if c >= '0' && c <= '9' {\n        acc = acc * 10 + (c - '0')\n        i = i + 1\n      } else {\n        ok = false\n      }\n    }\n    if ok {\n      acc\n    } else {\n      -1\n    }\n  }\n}\n\n// Decode (and ALWAYS strip) the ` [@off=N]` marker the checker may have\n// appended. If N is a valid in-range offset, prefix the stripped message with\n// its exact `line:col`. Otherwise strip the marker and fall through to the\n// existing first-occurrence heuristics on the cleaned message. If no marker is\n// present, returns msg unchanged.\nlet locate_type_error: (String, String) -> String = (source, msg) -> {\n  let marker = \" [@off=\"\n  let mi = String::index_of(msg, marker)\n  if mi < 0 {\n    locate_type_error_heuristic(source, msg)\n  } else {\n    let inner_start = mi + String::length(marker)\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \"]\")\n    if rel_end < 0 {\n      // Malformed marker (no closing `]`): strip from the marker onward.\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\n    } else {\n      let close = inner_start + rel_end\n      // inner is `N` (start only) or `N:M` (start:end). Split on `:`.\n      let inner = String::substring(msg, inner_start, close)\n      let colon = String::index_of(inner, \":\")\n      let n = if colon < 0 {\n        parse_offset_digits(inner, 0, String::length(inner))\n      } else {\n        parse_offset_digits(inner, 0, colon)\n      }\n      let m = if colon < 0 {\n        -1\n      } else {\n        parse_offset_digits(inner, colon + 1, String::length(inner))\n      }\n      // Strip the full ` [@off=...]` segment (marker .. closing `]` inclusive).\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\n      let slen = String::length(source)\n      if n >= 0 && n < slen {\n        if m > n && m <= slen {\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\n        } else {\n          String::concat(offset_line_col_prefix(source, n), stripped)\n        }\n      } else {\n        locate_type_error_heuristic(source, stripped)\n      }\n    }\n  }\n}\n\nlet finish_typecheck_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, String, Array[String], String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, source, deps, fingerprint) -> {\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\n  } else {\n    let stmts = parse_program_with_path(path, source)\n    let final_parse_count = parse_count + 1\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\n    let import_env = build_import_env(stmts, dir_of_path(path), import_env_cache)\n    let checked_env = handle {\n      match import_env {\n        EnvEmpty => check_program(stmts),\n        _ => check_program_with_env(stmts, import_env)\n      }\n    } with Error {\n      Throw(msg) => throw(String::concat(String::concat(path, \": \"), locate_type_error(source, msg)))\n    }\n    store_persistent_type_env(fingerprint, checked_env)\n    if Array::length(deps) == 0 {\n      Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))\n    } else {\n      ()\n    }\n    let next_env_cache = upsert_env_cache(import_env_cache, path, checked_env)\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n    (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)\n  }\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {\n  // Iterative push: previously the recursive `Array::concat(acc, [x])`\n  // copied the full prefix on each new dep — O(N^2) for files with\n  // many imports.\n  let out = empty_stack()\n  let mut i = 0\n  let len = Array::length(stmts)\n  while i < len {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\n        let resolved = resolve_import_path(base_dir, raw_path)\n        if !contains_str(out, resolved) {\n          Array::push(out, resolved)\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\n    }\n  }\n}\n\nlet resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nlet rec ensure_fingerprint_fs_go: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => match lookup_string_pair(dep_source_cache, path) {\n        Some(cached_source) => if cached_source == source {\n          match ripple_get_fingerprint(rdb, path) {\n            Some(cached_fingerprint) =>\n            // The fingerprint is enough for dependency fingerprint folding.\n            // Loading the env here caused shared leaf modules to re-read their\n            // persistent leaf cache every time they were reached before a\n            // parent needed their bindings.\n            (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),\n            None => match load_persistent_leaf_fingerprint(path, source) {\n              Some(leaf_fingerprint) => {\n                write_persistent_dep_list_if_missing(path, source, empty_stack())\n                let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n                (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n              },\n              None => {\n                let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n                let deps = copy_string_array(deps_raw)\n                write_persistent_dep_list_if_missing(path, source, deps)\n                let dlen = Array::length(deps)\n                let saved_stack_len = Array::length(stack)\n                Array::push(stack, path)\n                let mut i = 0\n                let mut db_after_deps = rdb\n                let mut env_cache_after_deps = env_cache\n                let mut dep_source_cache_after_deps = next_dep_source_cache\n                let mut parse_count_after_deps = initial_parse_count\n                let dep_fps = empty_dep_fps()\n                while i < dlen {\n                  let dep_path = Array::get(deps, i)\n                  let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\n                  db_after_deps = next_db\n                  env_cache_after_deps = next_env_cache\n                  dep_source_cache_after_deps = next_dep_source_cache2\n                  parse_count_after_deps = next_parse_count\n                  Array::push(dep_fps, (dep_path, dep_fp))\n                  i = i + 1\n                }\n                Array::truncate(stack, saved_stack_len)\n                let fingerprint = build_fingerprint(source, dep_fps)\n                match ripple_get_fingerprint(db_after_deps, path) {\n                  Some(cached_fp) =>\n                  if cached_fp == fingerprint {\n                    (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n                  } else {\n                    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n                  },\n                  None =>\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n                }\n              }\n            }\n          }\n        } else {\n          match load_persistent_leaf_fingerprint(path, source) {\n            Some(leaf_fingerprint) => {\n              write_persistent_dep_list_if_missing(path, source, empty_stack())\n              let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n              let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n              (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n            },\n            None => {\n              let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n              let deps = copy_string_array(deps_raw)\n              write_persistent_dep_list_if_missing(path, source, deps)\n              let dlen = Array::length(deps)\n              let saved_stack_len = Array::length(stack)\n              Array::push(stack, path)\n              let mut i = 0\n              let mut db_after_deps = rdb\n              let mut env_cache_after_deps = env_cache\n              let mut dep_source_cache_after_deps = next_dep_source_cache\n              let mut parse_count_after_deps = initial_parse_count\n              let dep_fps = empty_dep_fps()\n              while i < dlen {\n                let dep_path = Array::get(deps, i)\n                let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\n                db_after_deps = next_db\n                env_cache_after_deps = next_env_cache\n                dep_source_cache_after_deps = next_dep_source_cache2\n                parse_count_after_deps = next_parse_count\n                Array::push(dep_fps, (dep_path, dep_fp))\n                i = i + 1\n              }\n              Array::truncate(stack, saved_stack_len)\n              let fingerprint = build_fingerprint(source, dep_fps)\n              match ripple_get_fingerprint(db_after_deps, path) {\n                Some(cached_fp) =>\n                if cached_fp == fingerprint {\n                  (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n                } else {\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n                },\n                None =>\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n              }\n            }\n          }\n        },\n        None =>\n        match load_persistent_leaf_fingerprint(path, source) {\n          Some(leaf_fingerprint) => {\n            write_persistent_dep_list_if_missing(path, source, empty_stack())\n            let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n            (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\n          },\n          None => {\n            let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n            let deps = copy_string_array(deps_raw)\n            write_persistent_dep_list_if_missing(path, source, deps)\n            let dlen = Array::length(deps)\n            let saved_stack_len = Array::length(stack)\n            Array::push(stack, path)\n            let mut i = 0\n            let mut db_after_deps = rdb\n            let mut env_cache_after_deps = env_cache\n            let mut dep_source_cache_after_deps = next_dep_source_cache\n            let mut parse_count_after_deps = initial_parse_count\n            let dep_fps = empty_dep_fps()\n            while i < dlen {\n              let dep_path = Array::get(deps, i)\n              let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\n              db_after_deps = next_db\n              env_cache_after_deps = next_env_cache\n              dep_source_cache_after_deps = next_dep_source_cache2\n              parse_count_after_deps = next_parse_count\n              Array::push(dep_fps, (dep_path, dep_fp))\n              i = i + 1\n            }\n            Array::truncate(stack, saved_stack_len)\n            let fingerprint = build_fingerprint(source, dep_fps)\n            match ripple_get_fingerprint(db_after_deps, path) {\n              Some(cached_fp) =>\n              if cached_fp == fingerprint {\n                (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n              } else {\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n              },\n              None =>\n              finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n            }\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let ensure_fingerprint_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\n  let (fingerprint, next_db, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)\n  let final_env_cache = ensure_env_cache_for_path(next_db, next_env_cache, path)\n  (fingerprint, next_db, final_env_cache, next_dep_source_cache, next_parse_count)\n}\n\n// Collect ALL diagnostics for `source` as located (`line:col`) message strings.\n// Uses the recovering parser to gather every top-level syntax error; only if\n// the parse is clean does it run the type checker and report the (single,\n// located) type error. Returns [] when the source parses and checks cleanly.\n// Foundation for `vibe check` / LSP multi-diagnostic reporting.\nexport let collect_all_diagnostics: (String) -> Array[String] with { Error } = (source) -> {\n  let (tokens, starts, _ends) = lex_with_offsets(source)\n  let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\n  if Array::length(parse_diags) > 0 {\n    parse_diags\n  } else {\n    handle {\n      let _env = check_program(stmts)\n      Array::slice([\n        \"_\"\n      ], 0, 0)\n    } with Error {\n      Throw(msg) => [\n        locate_type_error(source, msg)\n      ]\n    }\n  }\n}\n")
}

let cli_adapter_source_122 = () -> (String, String) {
  ("vibe/compiler/runtime/type_at.vibe",
"//# Imports\n\n// `vibe type-at` — first typed-hover (LSP) consumer of the real EIdent source\n// offsets. Given a (line, col), locate the identifier node whose source span\n// covers that position, typecheck the program, and return the inferred type of\n// that name via env_lookup + type_to_string.\n//\n// MVP scope / LIMITATION: only env-visible names resolve — top-level bindings\n// and imported names that the checker records in the returned TypeEnv. Locals\n// and function parameters are NOT in that env (they live in nested scopes during\n// inference and are gone by the time check_program returns), so hovering one\n// yields \"\". A future per-node type table would lift this restriction.\n//\n// All strings are built with String::concat only (never `+`, never \"\\{x}\"\n// interpolation): both mis-codegen to NUL in selfhost. Ints stringify via\n// __to_string.\n\nimport ../core {\n  Stmt, Expr, Pat, Type, TypeEnv, Subst, env_lookup, subst_apply, type_to_string\n}\n\nimport ../checker/checker_stmt.vibe {\n  check_program, check_program_type_table\n}\n\nimport ../syntax {\n  lex_with_offsets, parse_program_located, parse_program_spans, offset_to_line_col\n}\n\n//# Functions\n\n// 1-based (line, col) -> 0-based char offset, the inverse of offset_to_line_col.\n// `col` is the position WITHIN a line (col 1 = first char of the line). We count\n// newlines: the offset of the start of line L is just past the (L-1)th newline,\n// then add (col - 1). Defensive: clamp at the source length.\nlet line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {\n  let len = String::length(source)\n  let mut i = 0\n  let mut cur_line = 1\n  // Advance to the first char of the target line.\n  while cur_line < line && i < len {\n    if String::char_code_at(source, i) == 10 {\n      cur_line = cur_line + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  // i now points at the first char of `line` (or end). Add the column offset.\n  let off = i + (col - 1)\n  if off < 0 {\n    0\n  } else if off > len {\n    len\n  } else {\n    off\n  }\n}\n\n// A located EIdent hit: name + source span [off, off + length(name)). `off` is\n// -1 for synthetic / non-located idents (those are ignored by the search).\nenum IdentHit {\n  IdentHit(String, Int)\n}\n\nlet empty_hits: () -> Array[IdentHit] = () -> {\n  Array::slice([\n    IdentHit(\"\", -1)\n  ], 0, 0)\n}\n\n// Read-only walker over the Expr structure (templated on normalize/index.vibe's\n// `fold_expr`, but it only COLLECTS located EIdent nodes — it never rebuilds the\n// tree). Every variant is enumerated so a new Expr arm is a compile error here,\n// keeping the collector in sync with the AST.\nlet rec collect_expr: (Expr, Array[IdentHit]) -> Unit = (expr, acc) -> {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => {\n      if off >= 0 {\n        Array::push(acc, IdentHit(name, off))\n      } else {\n        ()\n      }\n    },\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => collect_exprs(items, acc),\n    EArray(items) => collect_exprs(items, acc),\n    ERecord(fields) => collect_field_exprs(fields, acc),\n    EIf(c, t, e) => {\n      collect_expr(c, acc)\n      collect_expr(t, acc)\n      collect_expr(e, acc)\n    },\n    ELet(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetRec(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ELetMut(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssign(_, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    EAssignOp(_, _, v, b) => {\n      collect_expr(v, acc)\n      collect_expr(b, acc)\n    },\n    ESeq(a, b) => {\n      collect_expr(a, acc)\n      collect_expr(b, acc)\n    },\n    EMatch(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EHandle(s, arms) => {\n      collect_expr(s, acc)\n      collect_arm_exprs(arms, acc)\n    },\n    EWhile(c, b) => {\n      collect_expr(c, acc)\n      collect_expr(b, acc)\n    },\n    ELoop(params, b) => {\n      collect_loop_param_exprs(params, acc)\n      collect_expr(b, acc)\n    },\n    EForIn(_, _, it, b) => {\n      collect_expr(it, acc)\n      collect_expr(b, acc)\n    },\n    ECall(callee, args, _) => {\n      collect_expr(callee, acc)\n      collect_exprs(args, acc)\n    },\n    EBinOp(_, l, r) => {\n      collect_expr(l, acc)\n      collect_expr(r, acc)\n    },\n    EUnaryOp(_, e) => collect_expr(e, acc),\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\n    EDot(e, _, _) => collect_expr(e, acc),\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\n    EThrow(e) => collect_expr(e, acc),\n    EReturn(e) => collect_expr(e, acc),\n    EBreak(opt) => match opt {\n      Some(v) => collect_expr(v, acc),\n      None => ()\n    },\n    EContinue(args) => collect_exprs(args, acc),\n    EMap(fields) => collect_field_exprs(fields, acc),\n    ESpread(e) => collect_expr(e, acc)\n  }\n}\n\nlet collect_exprs: (Array[Expr], Array[IdentHit]) -> Unit = (items, acc) -> {\n  let mut i = 0\n  while i < Array::length(items) {\n    collect_expr(Array::get(items, i), acc)\n    i = i + 1\n  }\n}\n\nlet collect_field_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (fields, acc) -> {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    collect_expr(v, acc)\n    i = i + 1\n  }\n}\n\nlet collect_arm_exprs: (Array[(Pat, Expr)], Array[IdentHit]) -> Unit = (arms, acc) -> {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, e) = Array::get(arms, i)\n    collect_expr(e, acc)\n    i = i + 1\n  }\n}\n\nlet collect_loop_param_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (params, acc) -> {\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, init) = Array::get(params, i)\n    collect_expr(init, acc)\n    i = i + 1\n  }\n}\n\nlet collect_stmt: (Stmt, Array[IdentHit]) -> Unit = (stmt, acc) -> {\n  match stmt {\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\n    SLetMut(_, _, body) => collect_expr(body, acc),\n    STest(_, body) => collect_expr(body, acc),\n    SBench(_, body) => collect_expr(body, acc),\n    SExpr(e) => collect_expr(e, acc),\n    SLetPat(_, body) => collect_expr(body, acc),\n    SModule(_, _, body) => collect_stmts(body, acc),\n    _ => ()\n  }\n}\n\nlet collect_stmts: (Array[Stmt], Array[IdentHit]) -> Unit = (stmts, acc) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    collect_stmt(Array::get(stmts, i), acc)\n    i = i + 1\n  }\n}\n\n// True when `source[off]` is NOT an identifier char (or off is out of range) —\n// i.e. a valid word boundary. Used to match a binding name as a whole word.\nlet is_boundary_at: (String, Int) -> Bool = (source, off) -> {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\n// Find the first whole-word occurrence of `name` in `source[start..end)` and, if\n// found, push a located IdentHit for it. This recovers a source offset for a\n// let-binding NAME, which the parser stores only as a String on the Stmt (it is\n// not an EIdent and so carries no offset). Binding names are exactly the\n// env-visible top-level names, so making their definition site hoverable is the\n// useful case for this MVP.\nlet push_binding_name_hit: (String, Int, Int, String, Array[IdentHit]) -> Unit = (source, start, end, name, acc) -> {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if end > String::length(source) { String::length(source) } else { end }\n    let mut i = if start < 0 { 0 } else { start }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\n        Array::push(acc, IdentHit(name, i))\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\n// Add located hits for the NAMES of top-level (and module-body) value bindings,\n// using each statement's source span (from parse_program_spans) to scope the\n// whole-word search. Only SLet/SLetMut names are env-visible value bindings.\nlet collect_binding_name_hits: (Array[Stmt], Array[Int], Array[Int], String, Array[IdentHit]) -> Unit = (stmts, span_start, span_end, source, acc) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let start = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\n    let end = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\n// Among all collected idents whose span [off, off+len(name)) contains `tgt`,\n// pick the one with the largest `off` (innermost / closest start). Returns \"\"\n// when no ident covers the position.\nlet pick_ident_at: (Array[IdentHit], Int) -> String = (hits, tgt) -> {\n  let mut best_name = \"\"\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_name\n}\n\n// Same selection as pick_ident_at, but returns the chosen ident's source\n// `off` (the innermost / largest-off hit covering `tgt`), or -1 when none.\n// Used to query the per-node type table by the hovered EIdent's offset.\nlet pick_ident_off: (Array[IdentHit], Int) -> Int = (hits, tgt) -> {\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      IdentHit(name, off) => {\n        let span_end = off + String::length(name)\n        if off <= tgt && tgt < span_end && off > best_off {\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  best_off\n}\n\n// Look up the recorded type for source offset `off` in the per-node type table\n// produced by check_program_type_table. Returns None when no node recorded that\n// exact offset. When multiple entries share an offset (re-checked node), the\n// last recorded one wins (closest to the final inference state).\nlet tytab_lookup: (Array[(Int, Type)], Int) -> Option[Type] = (table, off) -> {\n  let mut found = None\n  let mut i = 0\n  while i < Array::length(table) {\n    let (toff, tty) = Array::get(table, i)\n    if toff == off {\n      found = Some(tty)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\n// Locate the identifier at (line, col), typecheck the program, and return its\n// inferred type as a string. Resolution order:\n//   1. per-node type table (covers LOCALS and PARAMETERS — names that live in\n//      nested inference scopes and are gone from the returned TypeEnv);\n//   2. fall back to the top-level TypeEnv lookup (top-level / imported names,\n//      and let-binding definition sites whose offset is not an EIdent node).\n// Returns \"\" when the position is not over a located identifier, or the name\n// resolves nowhere. Any failure is swallowed and yields \"\".\nexport let type_at_source: (String, Int, Int) -> String = (source, line, col) -> {\n  handle {\n    let tgt = line_col_to_offset(source, line, col)\n    let (tokens, starts, ends) = lex_with_offsets(source)\n    let stmts = parse_program_located(tokens, starts, source)\n    let hits = empty_hits()\n    // Identifier USES carry real offsets on their EIdent nodes.\n    collect_stmts(stmts, hits)\n    // Identifier DEFINITIONS (let-binding names) carry none, so recover their\n    // source offset from each statement's span and the source text.\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n    collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\n    let name = pick_ident_at(hits, tgt)\n    if name == \"\" {\n      \"\"\n    } else {\n      let chosen_off = pick_ident_off(hits, tgt)\n      // 1. per-node type table (locals + parameters).\n      let (table, final_s) = check_program_type_table(stmts)\n      let table_hit = if chosen_off >= 0 {\n        tytab_lookup(table, chosen_off)\n      } else {\n        None\n      }\n      match table_hit {\n        Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\n        None => {\n          // 2. fall back to the top-level env (top-level / imported names).\n          let env = check_program(stmts)\n          match env_lookup(env, name) {\n            Some(t) => type_to_string(t),\n            None => \"\"\n          }\n        }\n      }\n    }\n  } with Error {\n    Throw(_) => \"\"\n  }\n}\n")
}

let cli_adapter_source_123 = () -> (String, String) {
  ("vibe/compiler/runtime/binding_at.vibe",
"//# Imports\n\n// `vibe binding-at` — AST-accurate, scope-aware binding occurrences: the\n// foundation for scope-precision rename / references (テーマ4). Given a\n// (line, col), locate the identifier under the cursor and return the source\n// spans of every occurrence that resolves to the SAME binding — not merely the\n// same NAME.\n//\n// Why this is better than a text scan: occurrences are taken from the real\n// parsed AST, so there are NO false matches inside string literals, comments, or\n// as substrings of a longer word — only actual identifier nodes count.\n//\n// SCOPE AWARENESS (テーマ4): a scope-stack walk resolves every `EIdent(name,off)`\n// REFERENCE to the nearest enclosing introduction of `name` — a `let` / `let mut`\n// local, a function/lambda parameter, a `for` binder, a `loop` parameter, or a\n// match/handle pattern binder. Each introduction gets a unique binding id;\n// references that resolve to the same introduction share it, so two distinct\n// same-named locals (e.g. `x` in one function vs `x` in another, or a shadowing\n// inner `let x`) are NOT conflated. A reference that resolves to no local\n// introduction is treated as a module-level / free name and grouped FILE-WIDE by\n// name (canonical key 0), so top-level `export let f` references across the file\n// still resolve together.\n//\n// BINDER OFFSET RECOVERY: the AST stores binder NAMES as plain Strings without\n// offsets (only `EIdent` carries an offset). We recover a binder's source span by\n// scanning the source for the next whole-word occurrence of the name from a\n// monotonically-advancing floor, walking constructs in source order. This is the\n// same whole-word-scan machinery the previous name-wide implementation used for\n// top-level binding names, generalized to nested binders.\n//\n// FALLBACK (honest): for `match`/`handle` arms whose patterns introduce nested\n// sub-binders (ctor / tuple / struct / or patterns) the names ARE introduced into\n// scope so references resolve correctly, but if a particular binder's source\n// offset cannot be recovered from the floor its own occurrence span is omitted\n// (the rename set may miss the binder site itself, never a crash). Resolution\n// never crashes: any failure is swallowed and yields an empty list.\n//\n// All strings are built with String::concat only (never `+`, never \"\\{x}\"\n// interpolation): both mis-codegen to NUL in selfhost.\n\nimport ../core {\n  Stmt, Expr, Pat\n}\n\nimport ../syntax {\n  lex_with_offsets, parse_program_located\n}\n\n//# Functions\n\n// 1-based (line, col) -> 0-based char offset. Mirror of type_at.vibe's\n// line_col_to_offset: count newlines to reach the target line, add (col - 1),\n// clamp to [0, len].\nlet bind_line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {\n  let len = String::length(source)\n  let mut i = 0\n  let mut cur_line = 1\n  while cur_line < line && i < len {\n    if String::char_code_at(source, i) == 10 {\n      cur_line = cur_line + 1\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  let off = i + (col - 1)\n  if off < 0 {\n    0\n  } else if off > len {\n    len\n  } else {\n    off\n  }\n}\n\n// A located occurrence resolved to a binding:\n//   BindHit(name, off, key)\n// where `off` is the start source offset (its span is [off, off+length(name)))\n// and `key` is the canonical binding id this occurrence resolves to. key 0 means\n// \"module-level / free name, grouped file-wide by name\". `off` is -1 for\n// synthetic / non-located nodes, which the search ignores.\nenum BindHit {\n  BindHit(String, Int, Int)\n}\n\nlet bind_empty_hits: () -> Array[BindHit] = () -> {\n  Array::slice([\n    BindHit(\"\", -1, 0)\n  ], 0, 0)\n}\n\n// True when `source[off]` is NOT an identifier char (or off out of range) — a\n// word boundary. Used to match a binding name as a whole word.\nlet bind_is_boundary_at: (String, Int) -> Bool = (source, off) -> {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\n// Find the start offset of the first whole-word occurrence of `name` in\n// `source` at or after `from`. Returns -1 when not found. Recovers a source\n// offset for a binder NAME, which the parser stores only as a String.\nlet bind_find_word: (String, String, Int) -> Int = (source, name, from) -> {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    -1\n  } else {\n    let limit = String::length(source)\n    let mut i = if from < 0 { 0 } else { from }\n    let mut found = -1\n    while found < 0 && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\n        found = i\n      } else {\n        i = i + 1\n      }\n    }\n    found\n  }\n}\n\n// Mutable walk state threaded through the AST traversal:\n//   hits        — collected occurrences (references + recovered binders)\n//   scope_names — scope-stack of in-scope binder names (parallel to scope_ids)\n//   scope_ids   — scope-stack of binder ids (parallel to scope_names)\n//   floor       — boxed monotonically-advancing scan floor for binder recovery\n//   source      — the program text\n//\n// Binding ids are NOT a separate counter: each binder's canonical id is its\n// recovered source offset + 1 (unique per binder, and >= 1 so it never collides\n// with the module/free key 0). This avoids a separate mutable id-counter field.\nstruct BindState {\n  hits: Array[BindHit];\n  scope_names: Array[String];\n  scope_ids: Array[Int];\n  floor: Array[Int];\n  source: String\n}\n\n// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box).\n// Built via the slice+push idiom so the cell is a heap array supporting\n// Array::set, not a static read-only literal.\nlet bind_box_int: (Int) -> Array[Int] = (v) -> {\n  let arr = Array::slice([0], 0, 0)\n  Array::push(arr, v)\n  arr\n}\n\nlet bind_new_state: (String) -> BindState = (source) -> {\n  BindState::{\n    hits: bind_empty_hits(),\n    scope_names: Array::slice([\"\"], 0, 0),\n    scope_ids: Array::slice([0], 0, 0),\n    floor: bind_box_int(0),\n    source: source\n  }\n}\n\n// Resolve `name` to the nearest enclosing scope id, scanning the scope stack from\n// the top (end) down. Returns 0 (module-level / free, grouped file-wide) when no\n// local introduction is in scope.\nlet bind_resolve: (BindState, String) -> Int = (st, name) -> {\n  let n = Array::length(st.scope_names)\n  let mut i = n - 1\n  let mut found = 0\n  while i >= 0 && found == 0 {\n    if Array::get(st.scope_names, i) == name {\n      found = Array::get(st.scope_ids, i)\n    } else {\n      ()\n    }\n    i = i - 1\n  }\n  found\n}\n\n// Pop the scope stack back down to `mark` entries.\nlet bind_pop_scope: (BindState, Int) -> Unit = (st, mark) -> {\n  Array::truncate(st.scope_names, mark)\n  Array::truncate(st.scope_ids, mark)\n}\n\n// Recover a binder's source offset (from the scan floor forward), record it as an\n// occurrence, advance the floor past it, and return its unique binding id (off+1,\n// always >= 1; or 0 when the offset cannot be recovered — see file header\n// FALLBACK note). Does NOT push to scope — callers control when the binder enters\n// scope (e.g. a non-recursive `let x = v` must recover x's offset textually\n// before v, yet not have x in scope while walking v).\nlet bind_recover_binder: (BindState, String) -> Int = (st, name) -> {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  let id = if off >= 0 { off + 1 } else { 0 }\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, id))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n  id\n}\n\n// Push a binder (name, id) onto the current scope.\nlet bind_push_binder: (BindState, String, Int) -> Unit = (st, name, id) -> {\n  Array::push(st.scope_names, name)\n  Array::push(st.scope_ids, id)\n}\n\n// Introduce a binder: recover its offset/id then immediately push it into scope.\n// Used where the binder's scope begins right at the binder site (params, for /\n// loop binders, match-pattern binders).\nlet bind_introduce: (BindState, String) -> Unit = (st, name) -> {\n  let id = bind_recover_binder(st, name)\n  bind_push_binder(st, name, id)\n}\n\n// Record a reference `EIdent(name, off)`: resolve it to the nearest enclosing\n// binding (or 0 = module-level/free) and store its located span. Advance the\n// floor past it so later binder recovery does not re-find an earlier position.\nlet bind_record_ref: (BindState, String, Int) -> Unit = (st, name, off) -> {\n  if off >= 0 {\n    let key = bind_resolve(st, name)\n    Array::push(st.hits, BindHit(name, off, key))\n    if off >= Array::get(st.floor, 0) {\n      Array::set(st.floor, 0, off + String::length(name))\n    } else {\n      ()\n    }\n  } else {\n    ()\n  }\n}\n\n// Record an assignment target `name = ...` / `name op= ...`. Resolve to the\n// enclosing binding and recover the name's source offset from the floor (the\n// target name has no stored offset).\nlet bind_record_assign_target: (BindState, String) -> Unit = (st, name) -> {\n  let key = bind_resolve(st, name)\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, key))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\n// Introduce the names bound by a pattern (PBind directly; nested binders in\n// ctor / tuple / struct / or patterns recursively). Each is introduced into the\n// current scope.\nlet rec bind_introduce_pat: (BindState, Pat) -> Unit = (st, pat) -> {\n  match pat {\n    PWild => (),\n    PBind(name) => bind_introduce(st, name),\n    PInt(_) => (),\n    PFloat(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\n    PTuple(sub) => bind_introduce_pats(st, sub),\n    POr(a, b) => {\n      bind_introduce_pat(st, a)\n      bind_introduce_pat(st, b)\n    },\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        bind_introduce_pat(st, fp)\n        i = i + 1\n      }\n    }\n  }\n}\n\nlet bind_introduce_pats: (BindState, Array[Pat]) -> Unit = (st, sub) -> {\n  let mut i = 0\n  while i < Array::length(sub) {\n    bind_introduce_pat(st, Array::get(sub, i))\n    i = i + 1\n  }\n}\n\n// Scope-aware walker. `st.hits` accumulates references (resolved to a binding id)\n// and recovered binders. Every Expr arm is enumerated so a new variant is a\n// compile error here, keeping the collector in sync with the AST.\nlet rec bind_walk_expr: (BindState, Expr) -> Unit = (st, expr) -> {\n  match expr {\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(name, off) => bind_record_ref(st, name, off),\n    EUnit => (),\n    EStringInterp(_) => (),\n    ETuple(items) => bind_walk_exprs(st, items),\n    EArray(items) => bind_walk_exprs(st, items),\n    ERecord(fields) => bind_walk_field_exprs(st, fields),\n    EIf(c, t, e) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, t)\n      bind_walk_expr(st, e)\n    },\n    ELet(name, v, b) => {\n      // `let name = v; b`: the binder is textually BEFORE v, so recover its\n      // offset first (advancing the floor past it), but keep it OUT of scope while\n      // walking v — a non-recursive `let x = x + 1` references the OUTER x. Then\n      // push it into scope for b only.\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetRec(name, v, b) => {\n      // recursive let: name is in scope for both v and b.\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ELetMut(name, v, b) => {\n      // same binder-before-value ordering as ELet.\n      let id = bind_recover_binder(st, name)\n      bind_walk_expr(st, v)\n      let mark = Array::length(st.scope_names)\n      bind_push_binder(st, name, id)\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EAssign(name, v, b) => {\n      // assignment target is a reference to an in-scope binding.\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    EAssignOp(name, _, v, b) => {\n      bind_record_assign_target(st, name)\n      bind_walk_expr(st, v)\n      bind_walk_expr(st, b)\n    },\n    ESeq(a, b) => {\n      bind_walk_expr(st, a)\n      bind_walk_expr(st, b)\n    },\n    EMatch(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EHandle(s, arms) => {\n      bind_walk_expr(st, s)\n      bind_walk_arms(st, arms)\n    },\n    EWhile(c, b) => {\n      bind_walk_expr(st, c)\n      bind_walk_expr(st, b)\n    },\n    ELoop(params, b) => {\n      // loop params introduce names scoped to b; init exprs are outside scope.\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, init) = Array::get(params, i)\n        bind_walk_expr(st, init)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    EForIn(name, idx_opt, it, b) => {\n      bind_walk_expr(st, it)\n      let mark = Array::length(st.scope_names)\n      bind_introduce(st, name)\n      match idx_opt {\n        Some(idx) => bind_introduce(st, idx),\n        None => ()\n      }\n      bind_walk_expr(st, b)\n      bind_pop_scope(st, mark)\n    },\n    ECall(callee, args, _) => {\n      bind_walk_expr(st, callee)\n      bind_walk_exprs(st, args)\n    },\n    EBinOp(_, l, r) => {\n      bind_walk_expr(st, l)\n      bind_walk_expr(st, r)\n    },\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\n    EFn(_, _, params, _, _, body) => {\n      // function / lambda parameters are scoped to body.\n      let mark = Array::length(st.scope_names)\n      let mut i = 0\n      while i < Array::length(params) {\n        let (pname, _) = Array::get(params, i)\n        bind_introduce(st, pname)\n        i = i + 1\n      }\n      bind_walk_expr(st, body)\n      bind_pop_scope(st, mark)\n    },\n    EDot(e, _, _) => bind_walk_expr(st, e),\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\n    EThrow(e) => bind_walk_expr(st, e),\n    EReturn(e) => bind_walk_expr(st, e),\n    EBreak(opt) => match opt {\n      Some(v) => bind_walk_expr(st, v),\n      None => ()\n    },\n    EContinue(args) => bind_walk_exprs(st, args),\n    EMap(fields) => bind_walk_field_exprs(st, fields),\n    ESpread(e) => bind_walk_expr(st, e)\n  }\n}\n\nlet bind_walk_exprs: (BindState, Array[Expr]) -> Unit = (st, items) -> {\n  let mut i = 0\n  while i < Array::length(items) {\n    bind_walk_expr(st, Array::get(items, i))\n    i = i + 1\n  }\n}\n\nlet bind_walk_field_exprs: (BindState, Array[(String, Expr)]) -> Unit = (st, fields) -> {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (_, v) = Array::get(fields, i)\n    bind_walk_expr(st, v)\n    i = i + 1\n  }\n}\n\n// A match/handle arm: the pattern binders are scoped to the arm body only.\nlet bind_walk_arms: (BindState, Array[(Pat, Expr)]) -> Unit = (st, arms) -> {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (pat, e) = Array::get(arms, i)\n    let mark = Array::length(st.scope_names)\n    bind_introduce_pat(st, pat)\n    bind_walk_expr(st, e)\n    bind_pop_scope(st, mark)\n    i = i + 1\n  }\n}\n\n// Record a top-level / module-level binder NAME. These group file-wide (key 0),\n// so all references to the same module name resolve together. We recover the\n// binder's offset from the floor.\nlet bind_record_module_binder: (BindState, String) -> Unit = (st, name) -> {\n  let from = Array::get(st.floor, 0)\n  let off = bind_find_word(st.source, name, from)\n  if off >= 0 {\n    Array::push(st.hits, BindHit(name, off, 0))\n    Array::set(st.floor, 0, off + String::length(name))\n  } else {\n    ()\n  }\n}\n\n// Walk a statement. Top-level value bindings (SLet/SLetMut) introduce a\n// module-level name (key 0 => grouped file-wide); we record the binder's located\n// NAME and walk the body. SModule recurses.\nlet bind_walk_stmt: (BindState, Stmt) -> Unit = (st, stmt) -> {\n  match stmt {\n    SLet(_, _, name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    SLetMut(name, _, body) => {\n      bind_record_module_binder(st, name)\n      bind_walk_expr(st, body)\n    },\n    STest(_, body) => bind_walk_expr(st, body),\n    SBench(_, body) => bind_walk_expr(st, body),\n    SExpr(e) => bind_walk_expr(st, e),\n    SLetPat(_, body) => bind_walk_expr(st, body),\n    SModule(_, _, body) => bind_walk_stmts(st, body),\n    _ => ()\n  }\n}\n\nlet bind_walk_stmts: (BindState, Array[Stmt]) -> Unit = (st, stmts) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    bind_walk_stmt(st, Array::get(stmts, i))\n    i = i + 1\n  }\n}\n\n// Among all hits whose span [off, off+len(name)) contains `tgt`, pick the one\n// with the largest `off` (innermost / closest start). Returns the (name, key) of\n// that hit, or (\"\", 0) when none.\nlet bind_pick_at: (Array[BindHit], Int) -> (String, Int) = (hits, tgt) -> {\n  let mut best_name = \"\"\n  let mut best_key = 0\n  let mut best_off = -1\n  let mut i = 0\n  while i < Array::length(hits) {\n    match Array::get(hits, i) {\n      BindHit(name, off, key) => {\n        let span_end = off + String::length(name)\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\n          best_name = name\n          best_key = key\n          best_off = off\n        } else {\n          ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  (best_name, best_key)\n}\n\n// Insert (start, end) into `out` keeping it sorted by start ascending and\n// de-duplicated (skip when an identical start is already present — equal starts\n// imply equal spans because the name length is fixed).\nlet bind_insert_sorted_unique: (Array[(Int, Int)], Int, Int) -> Unit = (out, start, end) -> {\n  let n = Array::length(out)\n  let mut dup = false\n  let mut idx = n\n  let mut j = 0\n  while j < n {\n    let (s, _) = Array::get(out, j)\n    if s == start {\n      dup = true\n    } else {\n      ()\n    }\n    if s > start && idx == n {\n      idx = j\n    } else {\n      ()\n    }\n    j = j + 1\n  }\n  if dup {\n    ()\n  } else if idx == n {\n    Array::push(out, (start, end))\n  } else {\n    Array::push(out, Array::get(out, n - 1))\n    let mut k = n - 1\n    while k > idx {\n      Array::set(out, k, Array::get(out, k - 1))\n      k = k - 1\n    }\n    Array::set(out, idx, (start, end))\n  }\n}\n\n// Collect the (start, end) source spans of every occurrence that resolves to the\n// SAME binding as the identifier under the cursor at 1-based (line, col). Steps:\n//   1. lex + parse located; scope-aware walk collecting located references\n//      (resolved to a binding id) plus recovered binders.\n//   2. find the (name, key) covering the cursor offset; \"\" -> no occurrences.\n//   3. emit a span for every hit with the same name AND key (key 0 = module /\n//      free name grouped file-wide), de-duplicated and sorted by start.\n// AST-accurate and scope-aware (see file header). Any failure is swallowed and\n// yields an empty list.\nlet binding_occurrences_impl: (String, Int, Int) -> Array[(Int, Int)] with { Error } = (source, line, col) -> {\n  {\n    let tgt = bind_line_col_to_offset(source, line, col)\n    let (tokens, starts, _ends) = lex_with_offsets(source)\n    let stmts = parse_program_located(tokens, starts, source)\n    let st = bind_new_state(source)\n    bind_walk_stmts(st, stmts)\n    let hits = st.hits\n    let (name, key) = bind_pick_at(hits, tgt)\n    let out = Array::slice([\n      (0, 0)\n    ], 0, 0)\n    if name == \"\" {\n      out\n    } else {\n      let mut i = 0\n      while i < Array::length(hits) {\n        match Array::get(hits, i) {\n          BindHit(hname, hoff, hkey) => {\n            if hname == name && hkey == key && hoff >= 0 {\n              bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\n            } else {\n              ()\n            }\n          }\n        }\n        i = i + 1\n      }\n      out\n    }\n  }\n}\n\nexport let binding_occurrences: (String, Int, Int) -> Array[(Int, Int)] = (source, line, col) -> {\n  handle {\n    binding_occurrences_impl(source, line, col)\n  } with Error {\n    Throw(_) => Array::slice([\n      (0, 0)\n    ], 0, 0)\n  }\n}\n")
}

let cli_adapter_source_124 = () -> (String, String) {
  ("vibe/compiler/runtime/symbol_spans.vibe",
"//# Imports\n\n// `vibe symbols` — AST-accurate top-level (and module-nested) declaration spans:\n// the foundation for scope-precision document outline / go-to-definition\n// (テーマ4 LSP). Given a source string, return one record per declared symbol:\n//   (name, kind, start, end)\n// where `kind` is an LSP SymbolKind number and [start, end) is the source span\n// of the declaration NAME (char offsets).\n//\n// Why this beats the LSP server's previous line-regex scan: declarations are\n// taken from the real parsed AST, so multi-line declarations, declarations not\n// starting at column 0, and names that merely look like keywords inside strings\n// or comments are handled correctly — only actual declaration nodes count. The\n// name's source offset is recovered by a whole-word scan SCOPED to that\n// statement's parse span (from parse_program_spans), so a name that also appears\n// elsewhere in the statement body cannot be mis-located.\n//\n// FALLBACK (honest): a name whose offset cannot be recovered within its span is\n// simply omitted (never a crash). Resolution never throws: any failure is\n// swallowed and yields an empty list, so the LSP degrades to its regex scan.\n//\n// All strings are built with String::concat only (never `+`, never \"\\{x}\"\n// interpolation): both mis-codegen to NUL in selfhost.\n\nimport ../core {\n  Stmt, Expr\n}\n\nimport ../syntax {\n  lex_with_offsets, parse_program_spans\n}\n\n//# Functions\n\n// True when `source[off]` is NOT an identifier char (or off out of range) — a\n// word boundary. Used to match a declaration name as a whole word.\nlet sym_is_boundary_at: (String, Int) -> Bool = (source, off) -> {\n  if off < 0 || off >= String::length(source) {\n    true\n  } else {\n    let c = String::char_code_at(source, off)\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\n    !is_id\n  }\n}\n\n// A fresh single-cell mutable Int array holding `v` (a poor-man's mutable box),\n// built via slice+push so the cell is a heap array supporting Array::set.\nlet sym_box_int: (Int) -> Array[Int] = (v) -> {\n  let arr = Array::slice([0], 0, 0)\n  Array::push(arr, v)\n  arr\n}\n\nlet sym_empty_items: () -> Array[(String, Int, Int, Int)] = () -> {\n  Array::slice([\n    (\"\", 0, 0, 0)\n  ], 0, 0)\n}\n\n// Find the first whole-word occurrence of `name` in `source[from..hi)` and, when\n// found, push `(name, kind, off, off+len)` and advance `floor` past it (so a\n// later sibling declaration in the same window keeps scanning forward). No-op\n// when the name cannot be located in the window.\nlet sym_emit: (Array[(String, Int, Int, Int)], String, String, Int, Array[Int], Int) -> Unit = (out, source, name, kind, floor, hi) -> {\n  let nlen = String::length(name)\n  if nlen == 0 {\n    ()\n  } else {\n    let limit = if hi > String::length(source) { String::length(source) } else { hi }\n    let mut i = Array::get(floor, 0)\n    if i < 0 {\n      i = 0\n    } else {\n      ()\n    }\n    let mut found = false\n    while !found && i + nlen <= limit {\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\n        Array::push(out, (name, kind, i, i + nlen))\n        Array::set(floor, 0, i + nlen)\n        found = true\n      } else {\n        i = i + 1\n      }\n    }\n  }\n}\n\n// LSP SymbolKind for a top-level value binding: Function (12) when its body is a\n// lambda, else Variable (13).\nlet sym_let_kind: (Expr) -> Int = (body) -> {\n  match body {\n    EFn(_, _, _, _, _, _) => 12,\n    _ => 13\n  }\n}\n\n// Emit the symbol for one statement within the window [floor, hi). SModule emits\n// the module name (kind 2 = Module) then recurses into its body, threading the\n// SAME advancing floor so nested declarations are located in source order.\nlet rec sym_walk_stmt: (Array[(String, Int, Int, Int)], String, Stmt, Array[Int], Int) -> Unit = (out, source, stmt, floor, hi) -> {\n  match stmt {\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\n    SStruct(_, name, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\n    STrait(_, name, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\n    SModule(_, name, body) => {\n      sym_emit(out, source, name, 2, floor, hi)\n      let mut j = 0\n      while j < Array::length(body) {\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\n        j = j + 1\n      }\n    },\n    _ => ()\n  }\n}\n\n// Collect declaration symbols. Steps:\n//   1. lex + parse with per-statement spans (parse_program_spans).\n//   2. for each top-level statement, scan its own [start, end) span for the\n//      declaration name and emit (name, kind, start, end); SModule recurses.\n// AST-accurate (see file header). Any failure is swallowed -> empty list.\nlet symbol_spans_impl: (String) -> Array[(String, Int, Int, Int)] with { Error } = (source) -> {\n  {\n    let (tokens, starts, ends) = lex_with_offsets(source)\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\n    let out = sym_empty_items()\n    let mut i = 0\n    while i < Array::length(span_stmts) {\n      let lo = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\n      let hi = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\n      let floor = sym_box_int(lo)\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\n      i = i + 1\n    }\n    out\n  }\n}\n\nexport let symbol_spans: (String) -> Array[(String, Int, Int, Int)] = (source) -> {\n  handle {\n    symbol_spans_impl(source)\n  } with Error {\n    Throw(_) => Array::slice([\n      (\"\", 0, 0, 0)\n    ], 0, 0)\n  }\n}\n")
}

let cli_adapter_source_125 = () -> (String, String) {
  ("vibe/compiler/runtime/persistent_env_codec.vibe",
"//# Imports\n\nimport .. / cache / persistent_cache.vibe {\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path\n}\n\nimport .. / core {\n  Type, TypeEnv, env_flat_bindings\n}\n\n//# Functions\n\nlet parse_int_unwrap: (String, Int) -> Int = (raw, fallback) -> {\n  let len = String::length(raw)\n  let mut result = 0\n  let mut i = 0\n  let mut neg = false\n  let mut valid = true\n  if len == 0 { valid = false }\n  if valid {\n    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }\n  }\n  while valid {\n    if i >= len { break }\n    let c = String::char_code_at(raw, i)\n    if c < 48 { valid = false }\n    else if c > 57 { valid = false }\n    else {\n      result = result * 10 + (c - 48)\n      i = i + 1\n    }\n  }\n  if valid {\n    if neg { 0 - result } else result\n  } else fallback\n}\n\nlet serialize_segment: (String) -> String = (text) -> {\n  let len = String::length(text)\n  let len_str = __to_string(len)\n  let colon_text = String::concat(\":\", text)\n  String::concat(len_str, colon_text)\n}\n\nlet decode_effect_name: (String) -> String = (raw) -> {\n  if raw == \"\" || raw == \"0\" {\n    \"\"\n  } else if raw == \"1\" {\n    \"Error\"\n  } else {\n    raw\n  }\n}\n\nlet parse_count_header: (String, Int, Int) -> (Int, Int) with { Error } = (text, pos, terminator) -> {\n  let len = String::length(text)\n  let mut i = pos\n  while i < len && String::char_code_at(text, i) != terminator {\n    i = i + 1\n  }\n  if i >= len {\n    throw(\"invalid persistent type env payload\")\n  } else {\n    let parsed = parse_int_unwrap(text[pos: i], 0)\n    (parsed, i + 1)\n  }\n}\n\nlet parse_segment: (String, Int) -> (String, Int) with { Error } = (text, pos) -> {\n  let (seg_len, start) = parse_count_header(text, pos, 58)\n  let end = start + seg_len\n  if end > String::length(text) {\n    throw(\"invalid persistent type env segment\")\n  } else {\n    (text[start: end], end)\n  }\n}\n\nlet parse_int_array: (String, Int) -> (Array[Int], Int) with { Error } = (text, pos) -> {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\n    0\n  ], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw, next_cursor) = parse_segment(text, cursor)\n    let parsed_val = parse_int_unwrap(raw, 0)\n    Array::push(items, parsed_val)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env int array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet parse_string_array: (String, Int) -> (Array[String], Int) with { Error } = (text, pos) -> {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (item, next_cursor) = parse_segment(text, cursor)\n    Array::push(items, item)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env string array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet parse_bounds_array: (String, Int) -> (Array[(Int, Array[String])], Int) with { Error } = (text, pos) -> {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\n    (0, Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\n    let parsed_id = parse_int_unwrap(raw_id, 0)\n    Array::push(items, (parsed_id, bounds))\n    cursor = next_cursor2\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env bounds array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet rec parse_cached_type: (String, Int) -> (Type, Int) with { Error } = (source, pos) -> {\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\n    let (count, start) = parse_count_header(text, pos, 91)\n    let items = Array::slice([\n      CtUnknown\n    ], 0, 0)\n    let mut i = 0\n    let mut cursor = start\n    while i < count {\n      let (raw, next_cursor) = parse_segment(text, cursor)\n      let (item, end_cursor) = parse_cached_type(raw, 0)\n      if end_cursor != String::length(raw) {\n        throw(\"invalid persistent type env nested type\")\n      } else {\n        Array::push(items, item)\n        cursor = next_cursor\n        i = i + 1\n      }\n    }\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n      throw(\"invalid persistent type env type array\")\n    } else {\n      (items, cursor + 1)\n    }\n  }\n  if pos >= String::length(source) {\n    throw(\"invalid persistent type env type\")\n  } else {\n    let tag = String::char_code_at(source, pos)\n    match tag {\n      73 => (CtInt, pos + 1),\n      68 => (CtDouble, pos + 1),\n      66 => (CtBool, pos + 1),\n      71 => (CtString, pos + 1),\n      72 => (CtChar, pos + 1),\n      85 => (CtUnit, pos + 1),\n      89 => (CtBytes, pos + 1),\n      88 => (CtUnknown, pos + 1),\n      86 => {\n        let (raw, next_pos) = parse_segment(source, pos + 1)\n        let var_id = parse_int_unwrap(raw, 0)\n        (CtVar(var_id), next_pos)\n      },\n      69 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtEnum(name), next_pos)\n      },\n      82 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtStruct(name), next_pos)\n      },\n      65 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtArray(elem), next_pos)\n      },\n      79 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtOption(elem), next_pos)\n      },\n      84 => {\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\n        (CtTuple(elems), next_pos)\n      },\n      70 => {\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\n        let eff_raw = decode_effect_name(raw_effect)\n        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }\n        (CtFn(params, ret, eff_name), next_pos3)\n      },\n      78 => {\n        let (name, next_pos1) = parse_segment(source, pos + 1)\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\n        (CtNamed(name, args), next_pos2)\n      },\n      81 => {\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\n        (CtForAll(vars, bounds, body), next_pos3)\n      },\n      _ => throw(\"invalid persistent type env type tag\")\n    }\n  }\n}\n\n// All `serialize_*_array` helpers below used a `String::concat(out, ...)`\n// accumulator that was O(N²) over the array length. Cache-serialisation\n// runs them on every TypeEnv save, and large modules hit thousands of\n// bindings — the cumulative cost shows up in `vibe check` cold runs.\n// StringBuilder collapses each one to O(N).\nlet serialize_int_array: (Array[Int]) -> String = (items) -> {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nlet serialize_effect_name_str: (String) -> String = (effect_name) -> {\n  effect_name\n}\n\nlet serialize_string_array: (Array[String]) -> String = (items) -> {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nlet serialize_bounds_array: (Array[(Int, Array[String])]) -> String = (items) -> {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, __to_string(Array::length(items)))\n  StringBuilder::push(buf, \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    let (id, bounds) = Array::get(items, i)\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\n    StringBuilder::push(buf, serialize_string_array(bounds))\n    i = i + 1\n  }\n  StringBuilder::push(buf, \"]\")\n  StringBuilder::freeze(buf)\n}\n\nlet rec serialize_type: (Type) -> String = (ty) -> {\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\n    let buf = StringBuilder::new()\n    StringBuilder::push(buf, __to_string(Array::length(items)))\n    StringBuilder::push(buf, \"[\")\n    let mut i = 0\n    while i < Array::length(items) {\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\n      i = i + 1\n    }\n    StringBuilder::push(buf, \"]\")\n    StringBuilder::freeze(buf)\n  }\n  match ty {\n    CtInt => \"I\",\n    CtDouble => \"D\",\n    CtBool => \"B\",\n    CtString => \"G\",\n    CtChar => \"H\",\n    CtUnit => \"U\",\n    CtBytes => \"Y\",\n    CtUnknown => \"X\",\n    CtVar(id) => String::concat(\"V\", serialize_segment(__to_string(id))),\n    CtEnum(name) => String::concat(\"E\", serialize_segment(name)),\n    CtStruct(name) => String::concat(\"R\", serialize_segment(name)),\n    CtArray(elem) => String::concat(\"A\", serialize_type(elem)),\n    CtOption(elem) => String::concat(\"O\", serialize_type(elem)),\n    CtTuple(elems) => String::concat(\"T\", serialize_type_array(elems)),\n    CtFn(params, ret, effect_name) => {\n      let eff_str = if effect_name is Some(n) { n } else { \"\" }\n      String::concat(\"F\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\n    },\n    CtNamed(name, args) =>\n    String::concat(\"N\", String::concat(serialize_segment(name), serialize_type_array(args))),\n    CtForAll(vars, bounds, body) =>\n    String::concat(\"Q\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\n  }\n}\n\nexport let persistent_dep_list_text: (Array[String]) -> String = (deps) -> {\n  if Array::length(deps) == 0 {\n    \"\"\n  } else if Array::length(deps) == 1 {\n    String::concat(\"version\\t3\\n\", Array::get(deps, 0))\n  } else {\n    String::concat(\"version\\t2\\n\", serialize_string_array(deps))\n  }\n}\n\nexport let load_persistent_dep_list: (String, String) -> Option[Array[String]] with { Error, Fs } = (path, source) -> {\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    if String::length(text) == 0 {\n      Some(Array::slice([\n        \"\"\n      ], 0, 0))\n    } else {\n      let v2_prefix = \"version\\t2\\n\"\n      let v3_prefix = \"version\\t3\\n\"\n      let text_len = String::length(text)\n      let v2_len = String::length(v2_prefix)\n      let v3_len = String::length(v3_prefix)\n      if text_len >= v2_len &&\n      text[0: v2_len] == v2_prefix {\n        let body = text[v2_len: text_len]\n        let (deps, end_pos) = parse_string_array(body, 0)\n        if end_pos == String::length(body) {\n          Some(deps)\n        } else {\n          throw(String::concat(\"invalid persistent dep list body: \", cache_path))\n        }\n      } else if text_len >= v3_len &&\n      text[0: v3_len] == v3_prefix {\n        let dep = text[v3_len: text_len]\n        if String::length(dep) == 0 {\n          Some(Array::slice([\n            \"\"\n          ], 0, 0))\n        } else {\n          Some([dep])\n        }\n      } else {\n        throw(String::concat(\"invalid persistent dep list header: \", cache_path))\n      }\n    }\n  }\n}\n\nlet rebuild_persistent_type_env: (Array[(String, Type)]) -> TypeEnv = (bindings) -> {\n  EnvFlat(bindings)\n}\n\nexport let load_persistent_type_env: (String) -> Option[TypeEnv] with { Error, Fs } = (fingerprint) -> {\n  let path = persistent_type_env_cache_path(fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), \"\\n\")\n    let len = Array::length(lines)\n    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\n      if index >= len {\n        if version_ok {\n          Some(rebuild_persistent_type_env(bindings))\n        } else {\n          None\n        }\n      } else {\n        let line = Array::get(lines, index)\n        if String::length(line) == 0 {\n          go(index + 1, version_ok, bindings)\n        } else {\n          let parts = String::split(line, \"\\t\")\n          if !version_ok {\n            if Array::length(parts) == 2 &&\n            Array::get(parts, 0) == \"version\" &&\n            Array::get(parts, 1) == \"1\" {\n              go(index + 1, true, bindings)\n            } else {\n              throw(String::concat(\"invalid persistent type env header: \", line))\n            }\n          } else if Array::length(parts) == 3 && Array::get(parts, 0) == \"bind\" {\n            let raw_type = Array::get(parts, 2)\n            let (ty, end_pos) = parse_cached_type(raw_type, 0)\n            if end_pos != String::length(raw_type) {\n              throw(String::concat(\"invalid persistent type env bind row: \", line))\n            } else {\n              // Was `Array::concat(bindings, [tuple])` — O(N) copy per\n              // row, O(N²) over the file. Linear-recursive accumulation\n              // through `go`, so push-mutating the shared `bindings`\n              // is equivalent to the per-call rebuild.\n              Array::push(bindings, (Array::get(parts, 1), ty))\n              go(index + 1, true, bindings)\n            }\n          } else {\n            throw(String::concat(\"invalid persistent type env row: \", line))\n          }\n        }\n      }\n    }\n    go(0, false, Array::slice([\n      (\"\", CtUnknown)\n    ], 0, 0))\n  }\n}\n\nexport let persistent_type_env_cache_text: (TypeEnv) -> String = (env) -> {\n  let bindings = env_flat_bindings(env)\n  // StringBuilder over the bindings list — was O(N²) via `out =\n  // String::concat(out, ...)` for N bindings.\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let (name, ty) = Array::get(bindings, i)\n    StringBuilder::push(buf, \"bind\\t\")\n    StringBuilder::push(buf, name)\n    StringBuilder::push(buf, \"\\t\")\n    StringBuilder::push(buf, serialize_type(ty))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let load_persistent_leaf_fingerprint: (String, String) -> Option[String] with { Error, Fs } = (path, source) -> {\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    let prefix = \"version\\t1\\n\"\n    if String::length(text) > String::length(prefix) &&\n    text[0: String::length(prefix)] == prefix {\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\n    } else {\n      None\n    }\n  }\n}\n\nexport let persistent_leaf_fingerprint_text: (String) -> String = (fingerprint) -> {\n  String::concat(\"version\\t1\\n\", String::concat(fingerprint, \"\\n\"))\n}\n")
}

let cli_adapter_source_126 = () -> (String, String) {
  ("vibe/compiler/runtime/module_source.vibe",
"//# Imports\n\nimport ../core/index.vibe {\n  Stmt,\n  Expr,\n  dce_keep_flags\n}\n\nimport ../syntax/index.vibe {\n  lex_with_offsets,\n  parse_program_spans,\n  offset_to_line_col\n}\n\n//# Module source emission (selfhost port of host `emit-module-source`)\n\n// Reconstruct a flat module source containing only the top-level statements\n// reachable from `entry_name` (via DCE), emitted as their original source text.\n//\n// Mirrors the MoonBit host `emit-module-source`\n// (`src/cmd/vibe/cli_module_source.mbt`) but recovers statement source spans\n// from the selfhost lexer (`lex_with_offsets`) + parser (`parse_program_spans`)\n// instead of AST node spans, since the selfhost AST does not carry offsets.\n// Pure: no filesystem or host calls.\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let span_end = parsed.2\n  let keep = dce_keep_flags(stmts, [entry_name])\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    if Array::get(keep, i) {\n      let s = Array::get(span_start, i)\n      let e = Array::get(span_end, i)\n      if e > s {\n        let snippet = String::substring(source, s, e)\n        StringBuilder::push(buf, snippet)\n        let n = String::length(snippet)\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\n' {\n          StringBuilder::push(buf, \"\\n\")\n        }\n      }\n    }\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\n// debugger テーマ3 / M2: build a `.funcmap` sidecar text mapping each ENTRY-file\n// top-level function definition to its 1-based source line, one `name<TAB>line\\n`\n// per function. The launcher (`runtime/vibe`) reads this to annotate runtime trap\n// backtrace frames (which name user functions via the wasm \"name\" section) with\n// `(file:line)`.\n//\n// MVP scope: ENTRY-file top-level functions only. Imported-module functions are\n// not yet covered (future work) — they are flattened into the program at compile\n// time but their original source lines are not recovered here.\n//\n// Reuses the lexer offsets + parse_program_spans span table (same as\n// build_module_source_from_source) so it needs no checker. A top-level `SLet`\n// whose bound expr is a function (`EFn`) maps `name` -> line of the statement's\n// start offset. All strings via String::concat + __to_string only (never `+`,\n// never \"\\{}\" interpolation): both mis-codegen to NUL in selfhost.\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\n  let lexed = lex_with_offsets(source)\n  let tokens = lexed.0\n  let starts = lexed.1\n  let ends = lexed.2\n  let parsed = parse_program_spans(tokens, starts, ends)\n  let stmts = parsed.0\n  let span_start = parsed.1\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let entry = match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, _, _, _, _) => {\n          let off = Array::get(span_start, i)\n          let lc = offset_to_line_col(source, off)\n          let line = lc.0\n          String::concat(name, String::concat(\"\\t\", String::concat(__to_string(line), \"\\n\")))\n        },\n        _ => \"\"\n      },\n      _ => \"\"\n    }\n    StringBuilder::push(buf, entry)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n")
}

let cli_adapter_source_127 = () -> (String, String) {
  ("vibe/compiler/runtime/index.vibe",
"//# Imports\n\nimport ../core/index.vibe {\n  Stmt,\n  Type,\n  TypeEnv,\n  env_bind,\n  env_flat_bindings,\n  env_lookup_flat\n}\n\nimport ../checker/checker_stmt.vibe {\n  check_program_with_env\n}\n\nimport ./eval_loader/index.vibe {\n  contains_str\n}\n\nimport ./typecheck_fs.vibe {\n  ensure_fingerprint_fs_impl,\n  load_persistent_dep_list,\n  load_persistent_leaf_fingerprint,\n  persistent_dep_list_text,\n  persistent_leaf_fingerprint_text,\n  persistent_type_env_cache_text,\n  load_persistent_type_env\n}\n\nimport ../syntax/index.vibe {\n  lex,\n  parse_program,\n  print_program\n}\n\nimport ../syntax/import_alias_rewrite.vibe {\n  ExportRenamePlan,\n  append_import_alias_rewritten_non_import_stmts_with_renames,\n  append_non_import_stmts_without_alias_rewrite,\n  apply_export_renames_stmts,\n  build_export_rename_plan,\n  collect_import_alias_collision_locals,\n  collect_import_alias_collision_refs,\n  collect_import_value_renames,\n  export_plan_fingerprint_text,\n  export_plan_renames_for,\n  import_value_rename_locals,\n  namespace_private_value_stmts,\n  rewrite_imported_value_stmt_to_local,\n  stmts_have_import_deep\n}\n\nimport ../module_loader.vibe {\n  load_or_parse_module_header_fs\n}\n\nimport ../module_graph_path.vibe {\n  dir_of_path,\n  resolve_import_path,\n  resolve_import_path_candidates\n}\n\nimport ../cache/persistent_cache.vibe {\n  persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path,\n  persistent_type_env_cache_path\n}\n\nimport ../ripple/index.vibe {\n  RippleDb,\n  ripple_eval_count,\n  ripple_get_deps,\n  ripple_get_fingerprint,\n  ripple_get_source,\n  ripple_new,\n  ripple_record_eval,\n  ripple_set_source\n}\n\n//# Types\n\nenum StringTriple {\n  StringTriple(String, String, String)\n}\n\nenum TypeDbState {\n  TypeDbState(\n    RippleDb,\n    Array[(String, TypeEnv)],\n    Array[(String, String)],\n    Array[StringTriple],\n    Array[StringTriple],\n    Array[StringTriple],\n    Int,\n    Int,\n    Int,\n    Int\n  )\n}\n\nexport enum TypeDb {\n  TypeDb(TypeDbState)\n}\n\n//# Functions\n\nlet unwrap_db: (TypeDb) -> TypeDbState = (db) -> {\n  match db {\n    TypeDb(state) => state\n  }\n}\n\nlet wrap_db: (TypeDbState) -> TypeDb = (state) -> {\n  TypeDb(state)\n}\n\nlet parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\n  handle {\n    parse_program(lex(source))\n  } with Error {\n    Throw(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nlet add_dep: (Array[String], String, String) -> Array[String] = (acc, raw_path, base_dir) -> {\n  // Mutates `acc` in place. Caller pattern is `acc = add_dep(acc, ...)`\n  // so the same reference is returned either way.\n  if String::length(raw_path) == 0 {\n    acc\n  } else {\n    let resolved = resolve_import_path(base_dir, raw_path)\n    if contains_str(acc, resolved) {\n      acc\n    } else {\n      Array::push(acc, resolved)\n      acc\n    }\n  }\n}\n\nlet empty_strings: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_dep_fps: () -> Array[(String, String)] = () -> {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_env_cache: () -> Array[(String, TypeEnv)] = () -> {\n  Array::slice([\n    (\"\", EnvEmpty)\n  ], 0, 0)\n}\n\nlet empty_string_pairs: () -> Array[(String, String)] = () -> {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_string_triples: () -> Array[StringTriple] = () -> {\n  Array::slice([\n    StringTriple(\"\", \"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_stmt_array: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nexport let db_new: () -> TypeDb = () -> {\n  wrap_db(\n    TypeDbState(\n      ripple_new(),\n      empty_env_cache(),\n      empty_string_pairs(),\n      empty_string_triples(),\n      empty_string_triples(),\n      empty_string_triples(),\n      0,\n      0,\n      0,\n      0\n    )\n  )\n}\n\nlet lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {\n  let len = Array::length(pairs)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet lookup_source_cache: (Array[StringTriple], String, String) -> Option[String] = (cache, path, fingerprint) -> {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[String] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, source) =>\n          if p == path && fp == fingerprint {\n            Some(source)\n          } else {\n            go(i + 1)\n          }\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_source_cache: (Array[StringTriple], String, String, String) -> Array[StringTriple] = (cache, path, fingerprint, source) -> {\n  // O(N) in-place rebuild: previously each `Array::concat(acc, [x])`\n  // copied the entire prefix per iteration → O(N^2) for large source\n  // caches.\n  let out = empty_string_triples()\n  let mut i = 0\n  let len = Array::length(cache)\n  while i < len {\n    match Array::get(cache, i) {\n      StringTriple(p, fp, existing) =>\n        if p == path && fp == fingerprint {\n          ()\n        } else {\n          Array::push(out, StringTriple(p, fp, existing))\n        }\n    }\n    i = i + 1\n  }\n  Array::push(out, StringTriple(path, fingerprint, source))\n  out\n}\n\nlet append_source_cache_entries: (Array[StringTriple], Array[StringTriple]) -> Array[StringTriple] = (cache, entries) -> {\n  if Array::length(entries) == 0 {\n    cache\n  } else {\n    let out = empty_string_triples()\n    let mut i = 0\n    while i < Array::length(cache) {\n      Array::push(out, Array::get(cache, i))\n      i = i + 1\n    }\n    let mut j = 0\n    while j < Array::length(entries) {\n      Array::push(out, Array::get(entries, j))\n      j = j + 1\n    }\n    out\n  }\n}\n\nexport let db_set_source: (TypeDb, String, String) -> TypeDb = (db, path, source) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          ripple_set_source(rdb, path, source),\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n  }\n}\n\nlet lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\n  let len = Array::length(cache)\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nlet resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut selected = \"\"\n  let mut i = 0\n  while i < Array::length(candidates) && selected == \"\" {\n    let candidate = Array::get(candidates, i)\n    match lookup_env_cache(cache, candidate) {\n      Some(_) => {\n        selected = candidate\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  if selected == \"\" {\n    resolve_import_path(base_dir, raw_path)\n  } else {\n    selected\n  }\n}\n\nexport let db_check_env: (TypeDb, String) -> Option[TypeEnv] = (db, path) -> {\n  match unwrap_db(db) {\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\n  }\n}\n\nlet starts_with_upper: (String) -> Bool = (name) -> {\n  if String::length(name) == 0 {\n    false\n  } else {\n    let c = String::char_code_at(name, 0)\n    c >= 65 && c <= 90\n  }\n}\n\nlet rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {\n  match ty {\n    CtEnum(name) => name == type_name,\n    CtNamed(name, _) => name == type_name,\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\n    _ => false\n  }\n}\n\nlet bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {\n  let mut out = acc\n  let mut i = 0\n  while i < Array::length(dep_bindings) {\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\n      out = env_bind(out, candidate_name, candidate_ty)\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {\n  let dep_env = match lookup_env_cache(cache, resolved) {\n    Some(e) => e,\n    None => EnvEmpty\n  }\n  let dep_bindings = env_flat_bindings(dep_env)\n  let nlen = Array::length(names)\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\n    if j >= nlen {\n      nacc\n    } else {\n      let (name, alias) = Array::get(names, j)\n      let bound_name = match alias {\n        Some(a) => a,\n        None => name\n      }\n      let ty = match env_lookup_flat(dep_bindings, name) {\n        Some(t) => t,\n        None => CtUnknown\n      }\n      let with_name = env_bind(nacc, bound_name, ty)\n      let with_companions = match ty {\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\n        _ => if starts_with_upper(name) {\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\n        } else {\n          with_name\n        }\n      }\n      bind_names(j + 1, with_companions)\n    }\n  }\n  bind_names(0, acc)\n}\n\nlet build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {\n  let len = Array::length(stmts)\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        SReExport(raw_path, names) => {\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\n          bind_import_names_from_cache(acc, resolved, names, cache)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nlet upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet compact_string_fingerprint: (String) -> String = (source) -> {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {\n  Fs::write_file(\n    persistent_type_env_cache_path(fingerprint),\n    persistent_type_env_cache_text(env)\n  )\n}\n\nlet build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let db_typecheck_count: (TypeDb) -> Int = (db) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\n  }\n}\n\nexport let db_parse_count: (TypeDb) -> Int = (db) -> {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\n  }\n}\n\nexport let db_merge_count: (TypeDb) -> Int = (db) -> {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\n  }\n}\n\nexport let db_module_source_count: (TypeDb) -> Int = (db) -> {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\n  }\n}\n\nexport let db_codegen_count: (TypeDb) -> Int = (db) -> {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\n  }\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {\n  let len = Array::length(stmts)\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_strings())\n}\n\nlet resolve_deps_for_source: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error } = (rdb, dep_source_cache, path, source, parse_count) -> {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if cached_source == source {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n            (\n              deps,\n              upsert_string_pair(dep_source_cache, path, source),\n              parse_count + 1\n            )\n          }\n        }\n      } else {\n        let stmts = parse_program_with_path(path, source)\n        let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n        (\n          deps,\n          upsert_string_pair(dep_source_cache, path, source),\n          parse_count + 1\n        )\n      },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of_path(path))\n      (\n        deps,\n        upsert_string_pair(dep_source_cache, path, source),\n        parse_count + 1\n      )\n    }\n  }\n}\n\nlet load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {\n  match load_persistent_dep_list(path, source) {\n    Some(deps) => (\n      deps,\n      upsert_string_pair(dep_source_cache, path, source),\n      parse_count\n    ),\n    None => {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      (\n        deps,\n        upsert_string_pair(dep_source_cache, path, source),\n        next_parse_count\n      )\n    }\n  }\n}\n\nlet resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if cached_source == source {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n        }\n      } else {\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nlet rec ensure_fingerprint: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(\n          rdb,\n          dep_source_cache,\n          path,\n          source,\n          parse_count\n        )\n        let dlen = Array::length(deps)\n        // Cycle-detection stack: push self before recursing, truncate back after.\n        // O(1) per frame vs. previous Array::concat(stack, [path]) which was O(depth) per frame.\n        let saved_stack_len = Array::length(stack)\n        Array::push(stack, path)\n        // Tail-recursive over `deps`, accumulating (dep_path, dep_fp)\n        // pairs into `dep_acc`. Previously each recursion did\n        // `Array::concat(dep_acc, [tuple])` — O(N) copy per step,\n        // O(N²) over the deps list. Mutating in place is safe because\n        // `dep_acc` flows linearly down the recursion (one path, no\n        // sibling branches that need the old prefix).\n        let rec resolve_nested: (Int, Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } = (i, dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count) -> {\n          if i >= dlen {\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\n          } else {\n            let dep_path = Array::get(deps, i)\n            let (\n              dep_fp,\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            ) = ensure_fingerprint(\n              dep_db,\n              dep_env_cache,\n              dep_source_cache2,\n              dep_parse_count,\n              dep_path,\n              stack\n            )\n            Array::push(dep_acc, (dep_path, dep_fp))\n            resolve_nested(\n              i + 1,\n              dep_acc,\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            )\n          }\n        }\n        let resolved_nested = resolve_nested(\n          0,\n          empty_dep_fps(),\n          rdb,\n          env_cache,\n          next_dep_source_cache,\n          initial_parse_count\n        )\n        Array::truncate(stack, saved_stack_len)\n        let dep_fps = resolved_nested.0\n        let db_after_deps = resolved_nested.1\n        let env_cache_after_deps = resolved_nested.2\n        let dep_source_cache_after_deps = resolved_nested.3\n        let parse_count_after_deps = resolved_nested.4\n        let fingerprint = build_fingerprint(source, dep_fps)\n        match ripple_get_fingerprint(db_after_deps, path) {\n          Some(cached_fp) =>\n            if cached_fp == fingerprint {\n              (\n                fingerprint,\n                db_after_deps,\n                env_cache_after_deps,\n                dep_source_cache_after_deps,\n                parse_count_after_deps\n              )\n            } else {\n              let stmts = parse_program_with_path(path, source)\n              let final_parse_count = parse_count_after_deps + 1\n              let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n              let checked_env = check_program_with_env(stmts, import_env)\n              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n              (\n                fingerprint,\n                next_db,\n                next_env_cache,\n                dep_source_cache_after_deps,\n                final_parse_count\n              )\n            },\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of_path(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (\n              fingerprint,\n              next_db,\n              next_env_cache,\n              dep_source_cache_after_deps,\n              final_parse_count\n            )\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let db_typecheck: (TypeDb, String) -> TypeDb with { Error } = (db, path) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_strings()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nexport let db_typecheck_fs: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, path) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint_fs_impl(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_strings()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nexport let db_program_source: (TypeDb, String) -> (String, String, TypeDb) with { Error } = (db, path) -> {\n  let checked = db_typecheck(db, path)\n  match unwrap_db(checked) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\n      match ripple_get_source(rdb, path) {\n        None => throw(String::concat(\"missing:\", path)),\n        Some(source) =>\n          match ripple_get_fingerprint(rdb, path) {\n            Some(fingerprint) => (source, fingerprint, checked),\n            None => (source, source, checked)\n          }\n      }\n  }\n}\n\nlet build_merge_fingerprint: (Array[(String, String)]) -> String = (sources) -> {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", compact_string_fingerprint(source))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if path == target_path {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`\n// are the locals the export-rename plan already rewrites; the inline copy gets\n// the target file's export renames applied first.\nlet append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)], ExportRenamePlan, Array[String]) -> Unit with { Error } = (merged, current_path, stmts, sources, plan, excluded_locals) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !contains_str(emitted, local) && !contains_str(excluded_locals, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      match lookup_source_by_path(sources, resolved) {\n        Some(source) => {\n          let source_stmts = namespace_private_value_stmts(\n            resolved,\n            apply_export_renames_stmts(\n              parse_program_with_path(resolved, source),\n              export_plan_renames_for(plan, resolved)\n            )\n          )\n          let mut j = 0\n          let mut done = false\n          while j < Array::length(source_stmts) && !done {\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n              Some(local_stmt) => {\n                Array::push(merged, local_stmt)\n                Array::push(emitted, local)\n                done = true\n              },\n              None => ()\n            }\n            j = j + 1\n          }\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\n// #716: parse every source once and expose (paths, stmts) for the export-\n// rename plan; the merge itself reuses the parsed statements.\nlet parse_merge_sources: (Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } = (sources) -> {\n  let file_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let file_stmts = Array::slice([\n    empty_stmt_array()\n  ], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (path, source) = Array::get(sources, si)\n    Array::push(file_paths, path)\n    Array::push(file_stmts, parse_program_with_path(path, source))\n    si = si + 1\n  }\n  (file_paths, file_stmts)\n}\n\n// One (sub)list of sources merged under a whole-program rename plan.\n// `collision_sources` spans the whole program so a collision-def import that\n// crosses a group boundary still resolves.\nlet build_merged_source_with_plan: (String, Array[(String, String)], Array[String], Array[Array[Stmt]], ExportRenamePlan, Array[(String, String)]) -> String with { Error } = (entry_path, sources, file_paths, file_stmts, plan, collision_sources) -> {\n  let merged = empty_stmt_array()\n  let source_count = Array::length(sources)\n  let mut si = 0\n  while si < source_count {\n    let path = Array::get(file_paths, si)\n    let stmts = Array::get(file_stmts, si)\n    let is_entry_source = if entry_path == \"\" {\n      si == source_count - 1\n    } else {\n      path == entry_path\n    }\n    let export_renamed = if is_entry_source {\n      stmts\n    } else {\n      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))\n    }\n    let namespaced_stmts = if is_entry_source {\n      export_renamed\n    } else {\n      namespace_private_value_stmts(path, export_renamed)\n    }\n    if stmts_have_import_deep(stmts) {\n      let import_renames = collect_import_value_renames(plan, path, stmts)\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, collision_sources, plan, import_value_rename_locals(import_renames))\n      append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n    si = si + 1\n  }\n  print_program(merged)\n}\n\nlet build_merged_source: (String, Array[(String, String)]) -> String with { Error } = (entry_path, sources) -> {\n  let (file_paths, file_stmts) = parse_merge_sources(sources)\n  let plan_entry = if entry_path == \"\" {\n    if Array::length(file_paths) > 0 {\n      Array::get(file_paths, Array::length(file_paths) - 1)\n    } else {\n      \"\"\n    }\n  } else {\n    entry_path\n  }\n  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)\n  build_merged_source_with_plan(entry_path, sources, file_paths, file_stmts, plan, sources)\n}\n\nlet join_group_sources: (Array[String]) -> String = (group_sources) -> {\n  let len = Array::length(group_sources)\n  // O(N) via StringBuilder; the recursive `String::concat(acc, ...)` was\n  // O(N²) over the source-group count.\n  let buf = StringBuilder::new()\n  let mut i = 0\n  while i < len {\n    let source = Array::get(group_sources, i)\n    if i > 0 {\n      StringBuilder::push(buf, \"\\n\")\n    }\n    StringBuilder::push(buf, source)\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let db_merged_source: (TypeDb, String, Array[(String, String)]) -> (String, String, TypeDb) with { Error } = (db, _entry_path, sources) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let merge_fingerprint = build_merge_fingerprint(sources)\n      let merge_cache_key = \"merged\"\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\n        None => {\n          let merged_source = build_merged_source(_entry_path, sources)\n          let next_merged_cache = upsert_source_cache(\n            merged_cache,\n            merge_cache_key,\n            merge_fingerprint,\n            merged_source\n          )\n          (\n            merged_source,\n            merge_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nexport let db_grouped_merged_source: (TypeDb, Array[(String, Array[(String, String)])]) -> (String, String, TypeDb) with { Error } = (db, groups) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      // Keep per-group results in side buffers, then append cache misses\n      // once. Rebuilding the full cache on every group miss is O(N^2) for\n      // the ~150-group selfhost compiler manifest.\n      let group_sources = empty_strings()\n      let mut grouped_fingerprint = \"merged-groups\"\n      let new_group_cache_entries = empty_string_triples()\n      let mut merge_count_acc = merge_count\n      // #716: the export-rename plan spans ALL groups (imports cross group\n      // boundaries), so every source is parsed once up front and the plan\n      // fingerprint is folded into each group's cache fingerprint — a change\n      // to the program's ambiguous-export set invalidates cached group merges\n      // even when the group's own sources are unchanged.\n      let flat_sources = Array::slice([\n        (\"\", \"\")\n      ], 0, 0)\n      let mut fgi = 0\n      while fgi < Array::length(groups) {\n        let (_, gsources) = Array::get(groups, fgi)\n        let mut fsi = 0\n        while fsi < Array::length(gsources) {\n          Array::push(flat_sources, Array::get(gsources, fsi))\n          fsi = fsi + 1\n        }\n        fgi = fgi + 1\n      }\n      let (flat_paths, flat_stmts) = parse_merge_sources(flat_sources)\n      let plan_entry = if Array::length(flat_paths) > 0 {\n        Array::get(flat_paths, Array::length(flat_paths) - 1)\n      } else {\n        \"\"\n      }\n      let plan = build_export_rename_plan(flat_paths, flat_stmts, plan_entry)\n      let plan_fp = compact_string_fingerprint(export_plan_fingerprint_text(plan))\n      let mut flat_idx = 0\n      let mut i = 0\n      while i < Array::length(groups) {\n        let (group_name, sources) = Array::get(groups, i)\n        let group_start = flat_idx\n        flat_idx = flat_idx + Array::length(sources)\n        let fingerprint = compact_string_fingerprint(\n          String::concat(build_merge_fingerprint(sources), String::concat(\"#\", plan_fp))\n        )\n        let grouped_next = String::concat(\n          grouped_fingerprint,\n          String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n        )\n        grouped_fingerprint = compact_string_fingerprint(grouped_next)\n        let cache_key = String::concat(\"merged-group|\", group_name)\n        match lookup_source_cache(merged_cache, cache_key, fingerprint) {\n          Some(source) => {\n            Array::push(group_sources, source)\n          },\n          None =>\n            match lookup_source_cache(new_group_cache_entries, cache_key, fingerprint) {\n              Some(source) => {\n                Array::push(group_sources, source)\n              },\n              None => {\n                let group_paths = Array::slice(flat_paths, group_start, group_start + Array::length(sources))\n                let group_stmts = Array::slice(flat_stmts, group_start, group_start + Array::length(sources))\n                // #740: pass the WHOLE-merge plan entry, not \"\" — the empty\n                // entry made build_merged_source_with_plan treat the last\n                // file of EVERY GROUP as the entry (exports unrenamed), so\n                // group tails (ripple.vibe, desugar_trait_dict.vibe, ...)\n                // were missing their `_exp_` defs while callers referenced\n                // them.\n                let source = build_merged_source_with_plan(plan_entry, sources, group_paths, group_stmts, plan, flat_sources)\n                Array::push(new_group_cache_entries, StringTriple(cache_key, fingerprint, source))\n                merge_count_acc = merge_count_acc + 1\n                Array::push(group_sources, source)\n              }\n            }\n        }\n        i = i + 1\n      }\n      let next_merged_cache = append_source_cache_entries(merged_cache, new_group_cache_entries)\n      let next_merge_count = merge_count_acc\n      let grouped_cache_key = \"merged-groups\"\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\n        Some(source) =>\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count,\n                module_source_count,\n                codegen_count\n              )\n            )\n          ),\n        None => {\n          let source = join_group_sources(group_sources)\n          let final_merged_cache = upsert_source_cache(\n            next_merged_cache,\n            grouped_cache_key,\n            grouped_fingerprint,\n            source\n          )\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                final_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nlet build_module_source: (String) -> String with { Error } = (source) -> {\n  let stmts = parse_program(lex(source))\n  let filtered = empty_stmt_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let keep = match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => true,\n          _ => false\n        }\n      },\n      _ => false\n    }\n    if keep {\n      Array::push(filtered, stmt)\n    }\n    i = i + 1\n  }\n  print_program(filtered)\n}\n\nexport let db_module_source: (TypeDb, String, String) -> (String, TypeDb) with { Error } = (db, fingerprint, source) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let module_cache_key = \"module-source\"\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\n        Some(module_source) => (module_source, db),\n        None => {\n          let module_source = build_module_source(source)\n          let next_module_source_cache = upsert_source_cache(\n            module_source_cache,\n            module_cache_key,\n            fingerprint,\n            module_source\n          )\n          (\n            module_source,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                merged_cache,\n                next_module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count,\n                module_source_count + 1,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nlet artifact_cache_key: (String, String) -> String = (kind, entry_name) -> {\n  String::concat(kind, String::concat(\"|\", entry_name))\n}\n\nlet bytes_to_hex_digit: (Int) -> String = (n) -> {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nlet nibble_from_hex_char: (Int) -> Int with { Error } = (c) -> {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nlet bytes_to_hex: (Bytes) -> String = (bytes) -> {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  // O(N) via StringBuilder; previously each `String::concat(out, ...)`\n  // copied the growing buffer, making this O(N²) for the N-byte module\n  // hashes this routine serialises.\n  let buf = StringBuilder::new()\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    StringBuilder::push(buf, bytes_to_hex_digit(hi))\n    StringBuilder::push(buf, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nlet hex_to_bytes: (String) -> Bytes with { Error } = (hex) -> {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Bytes::new()\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Bytes::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    out\n  }\n}\n\nexport let db_load_artifact: (TypeDb, String, String, String, String) -> Option[Bytes] with { Error } = (db, _path, kind, entry_name, fingerprint) -> {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\n      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\n        Some(hex) => Some(hex_to_bytes(hex)),\n        None => None\n      }\n  }\n}\n\nexport let db_store_artifact: (TypeDb, String, String, String, String, Bytes) -> TypeDb = (db, _path, kind, entry_name, fingerprint, bytes) -> {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          rdb,\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          upsert_source_cache(\n            artifact_cache,\n            artifact_cache_key(kind, entry_name),\n            fingerprint,\n            bytes_to_hex(bytes)\n          ),\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count + 1\n        )\n      )\n  }\n}\n")
}

let cli_adapter_source_128 = () -> (String, String) {
  ("vibe/compiler/cache/selfhost_codegen_fingerprint.vibe",
"// AUTO-GENERATED by scripts/generate_selfhost_bundle.sh (#630).\n// Do not edit manually. Regenerate with: bash scripts/generate_selfhost_bundle.sh\n//\n// A hash of every compiler source file in selfhost_sources_manifest.tsv (the\n// codegen included). persistent_cache folds it into the artifact cache key so a\n// codegen change — which produces different wasm from the SAME user source —\n// automatically invalidates stale compiled .hex artifacts (#630).\n\n//# Functions\n\nexport let selfhost_codegen_fingerprint: () -> String = () -> {\n  \"89d76ef0c0812dc7\"\n}\n")
}

let cli_adapter_source_129 = () -> (String, String) {
  ("vibe/compiler/cache/persistent_cache.vibe",
"//# Imports\n\nimport ./selfhost_codegen_fingerprint.vibe {\n  selfhost_codegen_fingerprint\n}\n\n//# Functions\n\nexport let compact_string_fingerprint: (String) -> String = (source) -> {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\n// Cache key version tag. TWO independent reasons to bump it (#630):\n//  - cache FORMAT change (how `.hex` / `.tsv` entries are serialized): bump `vNN`.\n//  - CODEGEN / wasm-ABI change (the SAME source now compiles to DIFFERENT wasm):\n//    bump `cgNN`. The artifact cache is keyed by the source fingerprint only, so\n//    without a codegen segment a codegen change returns a STALE compiled wasm for\n//    unchanged source. Bump `cg` on any change to emitted wasm / runtime ABI.\n//    The `cg` segment is `selfhost_codegen_fingerprint()` — a build-time hash of\n//    all compiler source files (selfhost_sources_manifest.tsv), regenerated with\n//    the bundle. So any codegen-source change automatically changes the key and\n//    invalidates stale artifacts; no manual bump needed (#630). `vNN` is still a\n//    manual knob for pure cache-FORMAT changes that don't change the source hash.\nlet persistent_cache_version_tag: () -> String = () -> {\n  // v11 (#632): artifact cache switched from hex text (`.hex`) to raw binary\n  // (`.bin`, via Fs::write_bytes / Fs::read_bytes) — a cache FORMAT change, so\n  // the manual `vNN` knob is bumped. Old `.hex` entries are now unreferenced\n  // (different key + suffix) and reclaimable via `pkf run cache-clean` (#631).\n  String::concat(\"v11|cg-\", selfhost_codegen_fingerprint())\n}\n\nlet stable_cache_path: (String, String, String) -> String = (prefix, seed, suffix) -> {\n  let raw = compact_string_fingerprint(String::concat(\"persistent-cache-\", String::concat(persistent_cache_version_tag(), String::concat(\"|\", seed))))\n  // O(N) build via StringBuilder; the previous `token = String::concat(token, ...)`\n  // per char was O(N²) over the fingerprint length (issue #366).\n  let token_sb = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(raw) {\n    let c = String::char_code_at(raw, i)\n    let piece = if c == 58 {\n      \"_\"\n    } else {\n      String::from_char_code(c)\n    }\n    StringBuilder::push(token_sb, piece)\n    i = i + 1\n  }\n  let token = StringBuilder::freeze(token_sb)\n  String::concat(\"_build/vibe_\", String::concat(prefix, String::concat(\"_\", String::concat(token, suffix))))\n}\n\nlet build_sources_fingerprint: (Array[(String, String)]) -> String = (sources) -> {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(acc, String::concat(\"|\", compact_string_fingerprint(source)))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let persistent_artifact_cache_path: (String, String, String) -> String = (kind, entry_name, fingerprint) -> {\n  stable_cache_path(\"selfhost_artifact\", String::concat(kind, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", fingerprint)))), \".bin\")\n}\n\nexport let store_persistent_artifact: (String, String, String, Bytes) -> Unit with { Error, Fs } = (kind, entry_name, fingerprint, bytes) -> {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  // #632: store the compiled wasm RAW. Previously hex-encoded text (`.hex`),\n  // doubling disk and paying encode/decode each store/load; the artifact is a\n  // wasm binary (magic begins 0x00), so raw needs a byte-exact reader —\n  // Fs::read_bytes (load below), the inverse of this Fs::write_bytes.\n  Fs::write_bytes(path, bytes)\n}\n\nexport let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  stable_cache_path(\"selfhost_dep_list\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nexport let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {\n  stable_cache_path(\"selfhost_type_env_v2\", fingerprint, \".tsv\")\n}\n\nexport let build_source_groups_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, i)\n    let fingerprint = build_sources_fingerprint(sources)\n    let next = String::concat(acc, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let normalize_persistent_cache_text: (String) -> String = (text) -> {\n  let len = String::length(text)\n  let mut start = 0\n  while start < len && String::char_code_at(text, start) == 0 {\n    start = start + 1\n  }\n  if start == 0 {\n    text\n  } else {\n    text[start: len]\n  }\n}\n\nexport let load_persistent_artifact: (String, String, String) -> Option[Bytes] with { Error, Fs } = (kind, entry_name, fingerprint) -> {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    // #632: read the raw wasm back byte-exact. No hex decode and no leading-NUL\n    // normalize (that was a workaround for the utf8 read_file text path; raw\n    // Fs::read_bytes returns the file bytes verbatim, incl. the 0x00 wasm magic).\n    Some(Fs::read_bytes(path))\n  }\n}\n\nexport let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {\n  stable_cache_path(\"selfhost_source_list\", entry_path, \".tsv\")\n}\n\nexport let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {\n  stable_cache_path(\"selfhost_source_groups\", entry_path, \".tsv\")\n}\n\nexport let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  stable_cache_path(\"selfhost_module_header_v2\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nexport let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {\n  stable_cache_path(\"selfhost_manifest_headers\", entry_path, \".tsv\")\n}\n\nexport let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  stable_cache_path(\"selfhost_leaf_fp_v2\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nlet build_sources_fingerprint_from_compact_fingerprints: (Array[String]) -> String = (source_fingerprints) -> {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(source_fingerprints) {\n    let next = String::concat(acc, String::concat(\"|\", Array::get(source_fingerprints, i)))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_source_groups_fingerprint_from_compact_fingerprints: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, specs) = Array::get(groups, i)\n    let source_fingerprints = Array::slice([\n      \"\"\n    ], 0, 0)\n    let mut j = 0\n    while j < Array::length(specs) {\n      let (_, source_fingerprint) = Array::get(specs, j)\n      Array::push(source_fingerprints, source_fingerprint)\n      j = j + 1\n    }\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)\n    let next = String::concat(acc, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String) -> String = (source_groups_fingerprint, entry_name) -> {\n  compact_string_fingerprint(String::concat(\"fs-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", entry_name))))\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String) -> String = (source_groups, entry_name) -> {\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String, String) -> String = (source_groups_fingerprint, entry_name, mode) -> {\n  compact_string_fingerprint(String::concat(\"file-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))))\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String, String) -> String = (source_groups, entry_name, mode) -> {\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)\n}\n\nexport let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {\n  compact_string_fingerprint(String::concat(\"fs-compile-module|\", source_groups_fingerprint))\n}\n\nexport let build_fs_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\n}\n\nexport let build_file_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {\n  compact_string_fingerprint(String::concat(\"file-compile-module|\", source_groups_fingerprint))\n}\n\nexport let build_file_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\n}\n")
}

let cli_adapter_source_130 = () -> (String, String) {
  ("vibe/compiler/module_graph_path.vibe",
"//# Functions\n\nexport let dir_of_path: (String) -> String = (file_path) -> {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else if idx == 0 {\n    \"/\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\n// Linear membership scan used by `resolve_reexport_chain` to filter\n// re-exported names. Bounded per-module, not whole-program: `items`\n// (`wanted_names`) is a single re-export selection (typically 1-5 names)\n// and it is scanned once per pub statement of one source file. The\n// original O(N^2)-accumulator survey (#366) classified this as \"small N,\n// refactor pointless\" and #533 re-confirms it. A `Map[String, Bool]`\n// would NOT help: the selfhost runtime emits `Map::has_key` as a linear\n// search (#395, closed not-planned). See\n// bench/selfhost_perf/README.md (\"String-keyed lookup\" postmortem).\nexport let contains_name: (Array[String], String) -> Bool = (items, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// Linear membership scan used by `collect_direct_dep_paths` to dedup the\n// direct dependency paths of one entry file. Bounded by that file's\n// unique imports (≈5-30), so the dedup is O(D^2) with small D (≤ ~900\n// ops, per #366's survey). NOTE: the whole-graph visited/scheduled sets\n// that used to route through this helper (merge recursion, FS collect,\n// manifest worklists) moved to the bucketed `path_set` below (#533);\n// only genuinely small, per-module dedups should keep using this. Kept\n// linear deliberately for those (#533):\n//   - `Map[String, Bool]` is a no-op — the selfhost runtime emits\n//     `Map::has_key`/`Map::get` as linear searches (#395 not-planned).\n//   - A sort+merge dedup is UNSAFE: the resulting `dep_paths` order is\n//     preserved into `linked_imports`, which the linked codegen turns\n//     into wasm import-section indices (see\n//     vibe/compiler/codegen/wasi/linked_compile.vibe). Reordering would\n//     change the emitted binary, breaking reproducibility/parity.\n// First-occurrence insertion order must therefore be preserved.\nexport let contains_path: (Array[String], String) -> Bool = (visited, path) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(visited) && !found {\n    if Array::get(visited, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #533: mutable bucketed string set for whole-graph membership tests.\n//\n// The per-module `contains_name` / `contains_path` scans above are fine\n// (small bounded N — see the notes on each), but the graph-traversal\n// dedup sites (`collect_sources_rec`, `collect_merged_stmts_recursive`,\n// the manifest worklist loops) test membership against a set that grows\n// to ALL modules, once per import edge — O(edges × modules) string\n// compares, plus O(modules²) entry copying where the set was a\n// `Map[String, Bool]` (the runtime `Map::set` copies the whole map per\n// insert; `Map::has_key` is a linear scan — #395, closed not-planned).\n//\n// This set is plain `Array[Array[String]]` buckets + `Array::push`, so\n// it relies on nothing but O(1)-amortized array ops: membership and\n// insert are O(len(path)) hash + a short bucket scan, independent of\n// module count. Insert-only; iteration order is NOT meaningful — callers\n// that need ordered output must keep their own insertion-ordered array\n// (see the reorder hazard on `contains_path` above).\nlet path_set_bucket_count = 64\n\nlet path_set_hash: (String) -> Int = (s) -> {\n  let len = String::length(s)\n  let mut h = 5381\n  let mut i = 0\n  while i < len {\n    // djb2-xor, masked to 30 bits so `h * 33` stays far below the 61-bit\n    // tagged-int range.\n    h = ((h * 33) ^ String::char_code_at(s, i)) & 0x3FFFFFFF\n    i = i + 1\n  }\n  h\n}\n\nexport let path_set_new: () -> Array[Array[String]] = () -> {\n  let buckets = Array::slice([\n    Array::slice([\n      \"\"\n    ], 0, 0)\n  ], 0, 0)\n  let mut i = 0\n  while i < path_set_bucket_count {\n    Array::push(buckets, Array::slice([\n      \"\"\n    ], 0, 0))\n    i = i + 1\n  }\n  buckets\n}\n\nexport let path_set_contains: (Array[Array[String]], String) -> Bool = (set, path) -> {\n  let bucket = Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1))\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(bucket) && !found {\n    if Array::get(bucket, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// No membership check: callers gate on `path_set_contains` first (every\n// site below is check-then-add), so adding unconditionally here avoids a\n// second hash walk.\nexport let path_set_add: (Array[Array[String]], String) -> Unit = (set, path) -> {\n  Array::push(Array::get(set, path_set_hash(path) & (path_set_bucket_count - 1)), path)\n}\n\nexport let normalize_path: (String) -> String = (path) -> {\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\n  let mut parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_sep = if i == len {\n      true\n    } else {\n      String::char_code_at(path, i) == 47\n    }\n    if at_sep {\n      let part = path[start: i]\n      let skip_part = if String::length(part) == 0 {\n        true\n      } else {\n        part == \".\"\n      }\n      if skip_part {\n        ()\n      } else if part == \"..\" {\n        // O(1) truncate vs. previous O(N) copy of `parts[0:N-1]` into a\n        // fresh Array.\n        if Array::length(parts) > 0 {\n          Array::truncate(parts, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  // Build the joined output via StringBuilder. The previous code did\n  // `out = String::concat(out, ...)` in a loop, which is O(N²) over the\n  // segment count because each concat allocates and copies the growing\n  // string. Same shape as the StringBuilder migrations issue #366\n  // tracks for the rest of selfhost.\n  let buf = StringBuilder::new()\n  if is_absolute {\n    StringBuilder::push(buf, \"/\")\n  }\n  let mut pi = 0\n  while pi < Array::length(parts) {\n    if pi > 0 {\n      StringBuilder::push(buf, \"/\")\n    }\n    StringBuilder::push(buf, Array::get(parts, pi))\n    pi = pi + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let get_export_name: (Array[(String, Option[String])], String) -> String = (items, name) -> {\n  let mut result = name\n  let mut i = 0\n  while i < Array::length(items) {\n    let (iname, irename) = Array::get(items, i)\n    if iname == name {\n      match irename {\n        Some(alias) => {\n          result = alias\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {\n  if base_dir == \"\" || base_dir == \"/\" {\n    String::concat(base_dir, raw_path)\n  } else {\n    String::concat(base_dir, String::concat(\"/\", raw_path))\n  }\n}\n\nexport let path_to_module_name: (String) -> String = (path) -> {\n  let len = String::length(path)\n  let mut last_slash = -1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = if last_slash >= 0 {\n    path[last_slash + 1: len]\n  } else {\n    path\n  }\n  let base_len = String::length(base)\n  if String::ends_with(base, \".vibe\") {\n    base[0: base_len - 5]\n  } else {\n    base\n  }\n}\n\nexport let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {\n  // Bare `.` / `..` are relative too: `import . { x }` targets the importing\n  // file's own directory index. They were previously treated as workspace-\n  // root-relative raw paths, so `.` normalized to \"\" and the first candidate\n  // became \".vibe\" — the workspace STORE DIRECTORY — which fs_read trapped on\n  // with no diagnostic (EISDIR from the host).\n  if raw_path == \".\" || raw_path == \"..\" {\n    true\n  } else if len >= 2 {\n    if raw_path[0: 2] == \"./\" {\n      true\n    } else if len >= 3 {\n      raw_path[0: 3] == \"../\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\nexport let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {\n  // #730 (ADR-0063 §5/§6): `@scope/name` package refs resolve to the\n  // workspace store, laid out BY NAME and verified BY HASH against the\n  // importer's require pin (verification happens in the loader; this\n  // function stays pure). Root-relative, independent of base_dir.\n  if String::starts_with(raw_path, \"@\") {\n    return [\n      String::concat(\".vibe/store/\", String::concat(raw_path, \"/index.vibei\"))\n    ]\n  } else ()\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    [\n      normalized\n    ]\n  } else {\n    // #729: a bare (directory-style) import may target a contract package —\n    // `<dir>/index.vibei` is probed between the plain-file and index.vibe\n    // forms. Existence-probing resolvers pick it up when present; index-0\n    // stays the plain-file form so no-match fallbacks are unchanged.\n    [\n      String::concat(normalized, \".vibe\"),\n      String::concat(normalized, \"/index.vibei\"),\n      String::concat(normalized, \"/index.vibe\")\n    ]\n  }\n}\n")
}

let cli_adapter_source_131 = () -> (String, String) {
  ("vibe/compiler/cache/persistent_module_header_codec.vibe",
"//# Functions\n\nlet has_prefix: (String, String) -> Bool = (line, prefix) -> {\n  let prefix_len = String::length(prefix)\n  if String::length(line) < prefix_len {\n    false\n  } else {\n    let mut ok = true\n    let mut i = 0\n    while ok && i < prefix_len {\n      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0: len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nlet parse_persistent_module_header_line: (Array[String], Array[String], String, Bool) -> Bool with { Error } = (deps, exports, line, saw_version) -> {\n  if String::length(line) == 0 {\n    saw_version\n  } else if has_prefix(line, \"version\\t\") {\n    let value = line[8: String::length(line)]\n    if !(value == \"1\") {\n      throw(\"invalid persistent module header version\")\n    }\n    true\n  } else if has_prefix(line, \"dep\\t\") {\n    let value = line[4: String::length(line)]\n    if String::length(value) == 0 {\n      throw(\"invalid persistent module header dep row\")\n    } else {\n      Array::push(deps, value)\n      saw_version\n    }\n  } else if has_prefix(line, \"export\\t\") {\n    let value = line[7: String::length(line)]\n    if String::length(value) == 0 {\n      throw(\"invalid persistent module header export row\")\n    } else {\n      Array::push(exports, value)\n      saw_version\n    }\n  } else {\n    throw(String::concat(\"invalid persistent module header row: \", line))\n  }\n}\n\nexport let persistent_module_header_text: (Array[String], Array[String]) -> String = (deps, exports) -> {\n  // O(N) via StringBuilder; previously `out = String::concat(out, ...)`\n  // over both `deps` and `exports` was O((D+E)²).\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let mut i = 0\n  while i < Array::length(deps) {\n    StringBuilder::push(buf, \"dep\\t\")\n    StringBuilder::push(buf, Array::get(deps, i))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(exports) {\n    StringBuilder::push(buf, \"export\\t\")\n    StringBuilder::push(buf, Array::get(exports, j))\n    StringBuilder::push(buf, \"\\n\")\n    j = j + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let parse_persistent_module_header_text: (String) -> (Array[String], Array[String]) with { Error } = (raw) -> {\n  let deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let exports = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut saw_version = false\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(raw[line_start: i])\n      saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  let line = strip_trailing_cr(raw[line_start: len])\n  saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\n  if !saw_version {\n    throw(\"missing persistent module header version\")\n  } else {\n    (deps, exports)\n  }\n}\n")
}

let cli_adapter_source_132 = () -> (String, String) {
  ("vibe/compiler/loader/header_cache.vibe",
"//# Imports\n\nimport .. / cache / persistent_module_header_codec.vibe {\n  parse_persistent_module_header_text, persistent_module_header_text\n}\n\nimport .. / cache / persistent_cache.vibe {\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_module_header_cache_path\n}\n\nimport .. / core / ast.vibe {\n  Stmt\n}\n\nimport .. / module_graph_path.vibe {\n  dir_of_path, resolve_import_path_candidates\n}\n\nimport .. / runtime / eval_loader {\n  collect_exports\n}\n\nimport .. / syntax / lexer.vibe {\n  lex, lex_with_offsets\n}\n\nimport .. / syntax / parser.vibe {\n  parse_program, parse_program_located\n}\n\nimport .. / contract / index.vibe {\n  extract_require_pins, parse_contract_program\n}\n\n//# Functions\n\nlet resolve_path_fs: (String, String, String) -> String with { Fs } = (base_dir, raw_path, self_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  let mut fallback = \"\"\n  while i < Array::length(candidates) {\n    let candidate = Array::get(candidates, i)\n    // A directory-style import from a same-named facade file resolves its\n    // plain-file candidate to the IMPORTING file itself (`export ./codegen`\n    // inside codegen.vibe -> codegen.vibe): a self-dep is never meant, it\n    // only manufactures \"type_db: import cycle detected\". Skip it so the\n    // probe falls through to <dir>/index.vibe(i).\n    if candidate == self_path {\n      ()\n    } else {\n      if fallback == \"\" {\n        fallback = candidate\n      } else {\n        ()\n      }\n      if found == \"\" && Fs::exists(candidate) {\n        found = candidate\n      } else {\n        ()\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    if fallback == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      fallback\n    }\n  } else {\n    found\n  }\n}\n\nlet is_special_bundle_path: (String) -> Bool = (path) -> {\n  String::ends_with(path, \"selfhost_sources_bundle.vibe\") || String::ends_with(path, \"selfhost_cli_adapter_bundle.vibe\") || String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\")\n}\n\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfhost_sources\",\n      \"selfhost_source_groups\"\n    ]))\n  } else if String::ends_with(path, \"selfhost_cli_adapter_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfhost_cli_adapter_sources\",\n      \"selfhost_cli_adapter_source_groups\",\n      \"selfhost_cli_adapter_ordered_sources\",\n      \"selfhost_cli_adapter_merged_source\",\n      \"selfhost_cli_adapter_module_source\"\n    ]))\n  } else if String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfbuild_runtime_entry_source\"\n    ]))\n  } else {\n    None\n  }\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String, String) -> Array[String] with { Fs } = (stmts, base_dir, self_path) -> {\n  let deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path, self_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path, self_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\n// #730: sibling implementation files of a contract package, as raw import\n// spellings (\"./<name>\"). Used when an index.vibei declares NO implementation\n// imports: explicit `import ./impl.vibe {}` lines win when present (their\n// spelling is part of the package hash), discovery applies otherwise.\n// Fs::readdir returns names byte-sorted by the host, so facade order, hash\n// order, and dep order are deterministic. index.vibe cannot appear among the\n// siblings — ingestion rejects index.vibe + index.vibei coexistence first.\nexport let contract_sibling_impl_raws: (String) -> Array[String] with { Error, Fs } = (dir) -> {\n  let out = Array::slice([\n    \"\"\n  ], 0, 0)\n  let names = Fs::readdir(dir)\n  let mut i = 0\n  while i < Array::length(names) {\n    let name = Array::get(names, i)\n    if String::ends_with(name, \".vibe\") {\n      Array::push(out, String::concat(\"./\", name))\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  if Fs::exists(cache_path) {\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    (parsed.0, parsed.1, parse_count)\n  } else {\n    // #708: dispatch on `is_special_bundle_path` (a plain Bool) rather than\n    // matching `special_bundle_header(path)`'s Option result directly here,\n    // and never nest the `Some((deps, exports))` tuple-in-option pattern in\n    // the same match as the `None` arm's parse call. A compiler that is\n    // itself self-hosted under RC traps (\"wasm unreachable\" in `tk_name`,\n    // reached via `parse_stmt`) reading a corrupted Token tag when\n    // `load_or_parse_module_header_fs_impl` is compiled with the call chain\n    // that reaches `tk_name` (lex_with_offsets/parse_program_located, or\n    // even the plain lex/parse_program pair) sitting inside ONE arm of a\n    // `match` on `special_bundle_header(path)`'s `Option` result — even\n    // though that arm is never taken for ordinary (non-bundle-file) input.\n    // Splitting the dispatch into this Bool `if` (special_bundle_header is\n    // then only ever called, and only ever `match`ed, inside the branch that\n    // does NOT also reach the parser) reproducibly avoids the trap for the\n    // simplest repro. NOT a full fix for #708: a structurally similar crash\n    // still reproduces one level deeper (`parse_type_impl`, reached once the\n    // input has a type annotation) -- root cause remains uncharacterized, and\n    // this workaround likely needs to be repeated at that/other call sites.\n    let header_result = if String::ends_with(path, \".vibei\") {\n      // #740 fallout: a .vibei contract is not ordinary program syntax\n      // (bodyless fn/type declarations), so the full-program parse below\n      // threw \"expected = but got type\". Only the COLD-cache lane reaches\n      // this parse (warm runs read the cached header), which is why it\n      // survived until the whole-graph cold repro. Parse with the contract\n      // grammar instead: deps come from the implementation imports, the\n      // export surface from decls + opaques + transparent type stmts.\n      let (_, pin_blanked) = extract_require_pins(source)\n      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))\n      let cexports = collect_exports(cextra)\n      let mut cdi = 0\n      while cdi < Array::length(cdecls) {\n        let (cdname, _) = Array::get(cdecls, cdi)\n        Array::push(cexports, cdname)\n        cdi = cdi + 1\n      }\n      let mut coi = 0\n      while coi < Array::length(copaques) {\n        let (coname, _) = Array::get(copaques, coi)\n        Array::push(cexports, coname)\n        coi = coi + 1\n      }\n      // #730: a contract with no implementation imports auto-discovers its\n      // siblings — those files are deps of the header too, or an impl edit\n      // would not invalidate this cache entry.\n      let cdeps = collect_import_deps_from_stmts(cextra, dir_of_path(path), path)\n      let cdeps2 = if Array::length(cdeps) == 0 {\n        let craws = contract_sibling_impl_raws(dir_of_path(path))\n        let resolved = Array::slice([\n          \"\"\n        ], 0, 0)\n        let mut cri = 0\n        while cri < Array::length(craws) {\n          Array::push(resolved, resolve_path_fs(dir_of_path(path), Array::get(craws, cri), path))\n          cri = cri + 1\n        }\n        resolved\n      } else {\n        cdeps\n      }\n      (cdeps2, cexports, parse_count + 1)\n    } else if is_special_bundle_path(path) {\n      match special_bundle_header(path) {\n        Some(pair) => {\n          let deps = pair.0\n          let exports = pair.1\n          (deps, exports, parse_count)\n        },\n        None => (Array::slice([\n          \"\"\n        ], 0, 0), Array::slice([\n          \"\"\n        ], 0, 0), parse_count)\n      }\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = handle {\n        parse_program_located(tokens, starts, source)\n      } with Error {\n        Throw(msg) => throw(String::concat(path, String::concat(\": \", msg)))\n      }\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path), collect_exports(stmts), parse_count + 1)\n    }\n    let deps = header_result.0\n    let exports = header_result.1\n    let next_parse_count = header_result.2\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))\n    (deps, exports, next_parse_count)\n  }\n}\n")
}

let cli_adapter_source_133 = () -> (String, String) {
  ("vibe/compiler/loader/manifest_sources.vibe",
"//# Imports\n\nimport . / header_cache.vibe {\n  load_or_parse_module_header_fs_impl\n}\n\nimport .. / cache / persistent_cache.vibe {\n  compact_string_fingerprint, normalize_persistent_cache_text, persistent_manifest_header_cache_path\n}\n\nimport .. / module_graph_path.vibe {\n  contains_path, dir_of_path, normalize_path, path_set_add, path_set_contains, path_set_new,\n  resolve_import_path_candidates\n}\n\nimport .. / syntax / lexer.vibe {\n  lex\n}\n\nimport .. / syntax / parser_base.vibe {\n  collect_import_path, peek, skip_semi\n}\n\nimport .. / syntax / token.vibe {\n  Token\n}\n\n//# Path helpers\n\n// #740: NORMALIZED join. Manifest rows may point outside the compiler dir\n// (\"../../lib/@vibe/core/...\"); the joined spelling must match what import\n// resolution produces (resolve_import_path normalizes), or the merge plan\n// keys the file under one spelling while importers resolve the other and\n// every cross-reference silently misses (bare `sha1 @call` in the merge).\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\n  if base_dir == \"\" {\n    normalize_path(rel_path)\n  } else {\n    normalize_path(String::concat(base_dir, String::concat(\"/\", rel_path)))\n  }\n}\n\nlet resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\n    raw_path\n  } else {\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        }\n      }\n      i = i + 1\n    }\n    if found == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      found\n    }\n  }\n}\n\nlet starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {\n  match tok {\n    TDot => true,\n    _ => false\n  }\n}\n\nlet is_ident_char: (Int) -> Bool = (c) -> {\n  (c >= 'a' && c <= 'z') ||\n    (c >= 'A' && c <= 'Z') ||\n    (c >= '0' && c <= '9') ||\n    c == '_'\n}\n\nlet slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {\n  let text_len = String::length(text)\n  if start + text_len > String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {\n  let keyword_len = String::length(keyword)\n  if !(slice_eq_text(s, pos, keyword)) {\n    false\n  } else {\n    let before_ok = if pos == 0 {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\n    }\n    let after_pos = pos + keyword_len\n    let after_ok = if after_pos >= String::length(s) {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, after_pos)))\n    }\n    before_ok && after_ok\n  }\n}\n\nlet skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {\n  let mut pos = start\n  let mut done = false\n  while !done && pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == ';' {\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      pos = pos + 2\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else {\n      done = true\n    }\n  }\n  pos\n}\n\nlet scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {\n  let mut pos = start\n  let mut brace_depth = 0\n  let mut in_string = false\n  let mut string_quote = 0\n  let mut escape = false\n  let mut done = false\n  while pos < len && !done {\n    let c = String::char_code_at(s, pos)\n    if in_string {\n      if escape {\n        escape = false\n      } else if c == '\\\\' {\n        escape = true\n      } else if c == string_quote {\n        in_string = false\n      }\n      pos = pos + 1\n    } else if c == '\"' || c == '\\'' {\n      in_string = true\n      string_quote = c\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else if c == '{' {\n      brace_depth = brace_depth + 1\n      pos = pos + 1\n    } else if c == '}' {\n      if brace_depth > 0 {\n        brace_depth = brace_depth - 1\n      }\n      pos = pos + 1\n    } else if brace_depth == 0 && (c == '\\n' || c == ';') {\n      done = true\n    } else {\n      pos = pos + 1\n    }\n  }\n  pos\n}\n\nlet skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut depth = 1\n      let mut i = pos + 1\n      while depth > 0 {\n        match peek(tokens, i) {\n          TLBrace => {\n            depth = depth + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n          },\n          TEof => throw(\"unterminated brace list in manifest import scanner\"),\n          _ => ()\n        }\n        i = i + 1\n      }\n      i\n    }\n    _ => throw(\"expected '{' in manifest import scanner\")\n  }\n}\n\nlet scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {\n  let (raw_path, next_pos) = match peek(tokens, pos) {\n    TIdent(name) =>\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\n        (name, pos + 1)\n      } else {\n        collect_import_path(tokens, pos, \"\")\n      },\n    _ => collect_import_path(tokens, pos, \"\")\n  }\n  let after_path = match peek(tokens, next_pos) {\n    TIdent(alias_name) =>\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\n        next_pos + 1\n      } else {\n        next_pos\n      },\n    _ => next_pos\n  }\n  let end_pos = match peek(tokens, after_path) {\n    TLBrace => skip_brace_list(tokens, after_path),\n    _ => after_path\n  }\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\n}\n\nlet collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\n  let deps = Array::slice([\"\"], 0, 0)\n  let base_dir = dir_of_path(path)\n  let len = String::length(source)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    pos = skip_header_ws_and_comments(source, len, pos)\n    if pos >= len {\n      done = true\n    } else {\n      let is_import = starts_with_keyword_at(source, pos, \"import\")\n      let is_export = starts_with_keyword_at(source, pos, \"export\")\n      if !(is_import || is_export) {\n        done = true\n      } else {\n        let stmt_end = scan_header_stmt_end(source, len, pos)\n        let stmt_source = source[pos:stmt_end]\n        let tokens = lex(stmt_source)\n        let stmt_pos = skip_semi(tokens, 0)\n        match peek(tokens, stmt_pos) {\n          TImport => {\n            let (dep_path, _) = scan_header_import_dep(\n              tokens,\n              stmt_pos + 1,\n              base_dir,\n              manifest_path_index\n            )\n            Array::push(deps, dep_path)\n          },\n          TExport => {\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\n              let (dep_path, _) = scan_header_import_dep(\n                tokens,\n                stmt_pos + 1,\n                base_dir,\n                manifest_path_index\n              )\n              Array::push(deps, dep_path)\n            }\n          },\n          _ => {\n            done = true\n          }\n        }\n        pos = stmt_end\n      }\n    }\n  }\n  deps\n}\n\nlet collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\n  handle {\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\n  } with Error {\n    Throw(err) => throw(\"manifest header scan failed for \" + path + \": \" + err)\n  }\n}\n\nlet is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {\n  String::ends_with(path, \"selfhost_sources_bundle.vibe\")\n}\n\nlet should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {\n  if Map::has_key(manifest_path_index, dep_path) {\n    true\n  } else {\n    !(is_manifest_external_terminal_dep(dep_path))\n  }\n}\n\nlet load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {\n  handle {\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\n    deps\n  } with Error {\n    Throw(err) => throw(\"module header parse failed for \" + path + \": \" + err)\n  }\n}\n\nexport let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    MapBuilder::set(builder, path, source)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {\n  if Map::has_key(source_index, path_key) {\n    Some(Map::get(source_index, path_key))\n  } else {\n    None\n  }\n}\n\nexport let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(paths) {\n    MapBuilder::set(builder, Array::get(paths, i), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet empty_path_index: () -> Map[String, Bool] = () -> {\n  let builder = MapBuilder::new()\n  MapBuilder::freeze(builder)\n}\n\nlet build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {\n  let mut base_dir = dir_of_path(entry_path)\n  let mut found = None\n  let mut done = false\n  loop {\n    if done {\n      break\n    }\n    let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n    if Fs::exists(manifest_path) {\n      found = Some(base_dir)\n      done = true\n    } else if base_dir == \"\" {\n      done = true\n    } else {\n      let parent = dir_of_path(base_dir)\n      if parent == base_dir {\n        done = true\n      } else {\n        base_dir = parent\n      }\n    }\n  }\n  found\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nlet find_char: (String, Int) -> Int = (s, target) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values: (Array[String]) -> String = (values) -> {\n  // O(N) join via StringBuilder; per-value String::concat was O(N²) (issue #366).\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(out, header_value_separator)\n    }\n    StringBuilder::push(out, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nlet split_header_values: (String) -> Array[String] = (text) -> {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if name == group_name {\n      found = Some(sources)\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  match found {\n    Some(sources) => sources,\n    None => {\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(groups, (group_name, sources))\n      sources\n    }\n  }\n}\n\nlet build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    match on_path(path) {\n      Some(source) => {\n        let bucket = if has_last_group && last_group_name == group_name {\n          last_group_sources\n        } else {\n          let ensured = ensure_grouped_source_bucket(groups, group_name)\n          last_group_name = group_name\n          last_group_sources = ensured\n          has_last_group = true\n          ensured\n        }\n        Array::push(bucket, (path, source))\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  groups\n}\n\n//# Manifest parsing\n\nlet parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {\n  let rows = Array::slice([(\"\", \"\")], 0, 0)\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(manifest_source, i) == 10\n    }\n    if at_line_end {\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\n      let line_len = String::length(raw_line)\n      let has_content = line_len > 0\n      let is_comment = if has_content {\n        String::char_code_at(raw_line, 0) == 35\n      } else {\n        false\n      }\n      if has_content {\n        if is_comment {\n          ()\n        } else {\n          let tab_idx = find_char(raw_line, 9)\n          let invalid_row = if tab_idx < 0 {\n            true\n          } else {\n            tab_idx + 1 >= line_len\n          }\n          if invalid_row {\n            throw(String::concat(\"invalid source manifest row: \", raw_line))\n          }\n          let group = raw_line[0:tab_idx]\n          let path = raw_line[tab_idx + 1:line_len]\n          Array::push(rows, (group, path))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nexport let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match find_manifest_base_dir(entry_path) {\n    Some(base_dir) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n      let mut has_entry = false\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, rel_path) = Array::get(rows, i)\n        let path = join_path(base_dir, rel_path)\n        if path == entry_path {\n          has_entry = true\n        }\n        i = i + 1\n      }\n      if has_entry {\n        Some((base_dir, rows))\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nexport let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {\n  let full_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nlet load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\n  let sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(sources, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  sources\n}\n\nlet load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      let bucket = if has_last_group && last_group_name == group_name {\n        last_group_sources\n      } else {\n        let ensured = ensure_grouped_source_bucket(groups, group_name)\n        last_group_name = group_name\n        last_group_sources = ensured\n        has_last_group = true\n        ensured\n      }\n      Array::push(bucket, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  groups\n}\n\nexport let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {\n  build_grouped_sources_from_manifest_rows_with_lookup(\n    base_dir,\n    rows,\n    (path: String) -> Option[String] {\n      source_lookup_in_index(source_index, path)\n    }\n  )\n}\n\nexport let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {\n  let source_index = build_manifest_source_index(sources)\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\n}\n\nexport let filter_manifest_sources_by_path_index: (Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] = (preloaded_sources, needed_path_index) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport let filter_manifest_sources_by_paths: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\n  let needed_path_index = build_manifest_path_index(needed_paths)\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\n}\n\nexport let filter_manifest_sources_by_paths_linear: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if contains_path(needed_paths, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport let filter_manifest_sources_by_source_index: (Array[String], Map[String, String]) -> Array[(String, String)] = (needed_paths, preloaded_source_index) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(needed_paths) {\n    let path = Array::get(needed_paths, i)\n    match source_lookup_in_index(preloaded_source_index, path) {\n      Some(source) => Array::push(filtered_sources, (path, source)),\n      None => ()\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\n//# Manifest header cache\n\nlet parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if tag == \"header\" {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nlet load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n        cached_path == manifest_path &&\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\n          if !(Map::has_key(manifest_path_index, path)) {\n            valid = false\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n            valid = false\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(\n    out,\n    String::concat(\n      \"manifest\\t\",\n      String::concat(\n        manifest_path,\n        String::concat(\n          \"\\t\",\n          String::concat(\n            __to_string(Fs::stat_token(manifest_path)),\n            String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \"\\n\"))\n          )\n        )\n      )\n    )\n  )\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"header\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              stat_token_text,\n              String::concat(\n                \"\\t\",\n                String::concat(\n                  source_fingerprint,\n                  String::concat(\"\\t\", String::concat(deps_text, \"\\n\"))\n                )\n              )\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {\n  Fs::write_file(\n    persistent_manifest_header_cache_path(entry_path),\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\n  )\n}\n\nlet manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if row_path == path {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\n// #533: schedule-time dedup via a mutable `path_set`. The previous\n// `Map[String, Bool]` scheduled-set copied the whole map on every\n// `Map::set` (O(N) per insert → O(N²) total) and linearly scanned it per\n// `Map::has_key`; the pop-time `contains_path(visited, current)` guard\n// was another O(edges × modules) scan that could never fire, because\n// every worklist push is gated on the scheduled set, making worklist\n// entries unique by construction. `visited` stays an insertion-ordered\n// array — it is the returned needed-paths list. (Same pattern in the two\n// sibling collectors below.)\nlet collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let source = Fs::read_file(current)\n        if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(\n            current,\n            source,\n            manifest_path_index\n          )\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = match manifest_header_deps_lookup(rows, current) {\n      Some(found) => found,\n      None => {\n        let parsed_deps = if Map::has_key(manifest_path_index, current) {\n          collect_manifest_header_deps_from_source_with_context(\n            current,\n            source,\n            manifest_path_index\n          )\n        } else {\n          load_or_parse_module_header_deps_with_context(current, source)\n        }\n        Array::push(\n          rows,\n          (\n            current,\n            __to_string(Fs::stat_token(current)),\n            compact_string_fingerprint(source),\n            join_header_values(parsed_deps)\n          )\n        )\n        parsed_deps\n      }\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  (rows, visited)\n}\n\nlet collect_needed_paths_from_manifest_scan: (String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, manifest_path_index) -> {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = path_set_new()\n  Array::push(worklist, path)\n  path_set_add(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    Array::push(visited, current)\n    let source = Fs::read_file(current)\n    let deps = if Map::has_key(manifest_path_index, current) {\n      collect_manifest_header_deps_from_source_with_context(\n        current,\n        source,\n        manifest_path_index\n      )\n    } else {\n      load_or_parse_module_header_deps_with_context(current, source)\n    }\n    let mut dep_i = 0\n    while dep_i < Array::length(deps) {\n      let dep_path = Array::get(deps, dep_i)\n      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n        !(path_set_contains(scheduled, dep_path)) {\n        Array::push(worklist, dep_path)\n        path_set_add(scheduled, dep_path)\n        work_len = work_len + 1\n      }\n      dep_i = dep_i + 1\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\n  match load_persistent_manifest_header_cache_if_valid(\n    entry_path,\n    manifest_path,\n    manifest_path_index\n  ) {\n    Some(cached_rows) => cached_rows,\n    None => {\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n      built_rows\n    }\n  }\n}\n\nexport let probe_manifest_header_rows_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_header_rows_uncached_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_needed_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_scan_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let needed_paths = collect_needed_paths_from_manifest_scan(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\n//# Source collection\n\nexport let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, sources))\n    },\n    None => None\n  }\n}\n\nexport let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n")
}

let cli_adapter_source_134 = () -> (String, String) {
  ("lib/@vibe/core/index.vibei",
"// @vibe/core — vibe standard core library (ADR-0063 contract package).\n// Modeled on moonbitlang/core's per-domain organization. The top level of\n// this contract IS the public API: transparent type definitions + fn\n// declarations, implemented by the sibling .vibe files. Consumed in-repo\n// via a bare directory import (`import ../lib/@vibe/core { ... }`) and\n// externally via the content-addressed store (`require @vibe/core ...` +\n// `import @vibe/core { ... }`; install with scripts/vibe_core_install.sh).\n//\n// v1 contents: sha1, leb128, list, set, hex. maps/map (the derive(Hash)\n// machinery) stays in vibe/collection until the contract grammar can\n// declare traits; prelude consolidation is the same follow-up track.\n\nimport ./sha1.vibe {}\nimport ./leb128.vibe {}\nimport ./list.vibe {}\nimport ./set.vibe {}\nimport ./hex.vibe {}\n\ntype List[T]\ntype StringSet\n\n// --- sha1\nfn sha1(msg: String) -> String\n\n// --- hex\nfn hex_encode(s: String) -> String\nfn hex_decode(hex: String) -> String with { Error }\n\n// --- leb128\nfn read_sleb128(buf: Bytes, offset: Int) -> (Int, Int)\nfn read_uleb128(buf: Bytes, offset: Int) -> (Int, Int)\nfn sleb128_size(n: Int) -> Int\nfn uleb128_size(n: Int) -> Int\nfn write_sleb128(buf: Bytes, n: Int) -> Unit\nfn write_uleb128(buf: Bytes, n: Int) -> Unit\nfn encode_sleb128(n: Int) -> Bytes\nfn encode_uleb128(n: Int) -> Bytes\n\n// --- list\nfn list_nth[T](xs: List[T], n: Int) -> Option[T]\nfn nth[T](xs: List[T], n: Int) -> Option[T]\nfn list_of3[T](a: T, b: T, c: T) -> List[T]\nfn of3[T](a: T, b: T, c: T) -> List[T]\nfn list_of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]\nfn of5[T](a: T, b: T, c: T, d: T, e: T) -> List[T]\nfn list_cons[T](x: T, xs: List[T]) -> List[T]\nfn list_drop[T](n: Int, xs: List[T]) -> List[T]\nfn drop[T](xs: List[T], n: Int) -> List[T]\nfn list_fold[A, B](f: (B, A) -> B, init: B, xs: List[A]) -> B\nfn list_sum(xs: List[Int]) -> Int\nfn sum(xs: List[Int]) -> Int\nfn list_head[T](xs: List[T]) -> Option[T]\nfn head[T](xs: List[T]) -> Option[T]\nfn list_iter[T, R](f: (T) -> R, xs: List[T]) -> Int\nfn iter[T, R](xs: List[T], f: (T) -> R) -> Int\nfn list_tail[T](xs: List[T]) -> List[T]\nfn tail[T](xs: List[T]) -> List[T]\nfn list_empty[T]() -> List[T]\nfn list_length[T](xs: List[T]) -> Int\nfn length[T](xs: List[T]) -> Int\nfn iter_length[T](xs: List[T]) -> Int\nfn list_reverse[T](xs: List[T]) -> List[T]\nfn reverse[T](xs: List[T]) -> List[T]\nfn list_map[A, B](f: (A) -> B, xs: List[A]) -> List[B]\nfn list_zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\nfn zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\nfn list_take[T](n: Int, xs: List[T]) -> List[T]\nfn take[T](xs: List[T], n: Int) -> List[T]\nfn list_append[T](xs: List[T], ys: List[T]) -> List[T]\nfn append[T](xs: List[T], ys: List[T]) -> List[T]\nfn list_filter[T](pred: (T) -> Bool, xs: List[T]) -> List[T]\nfn filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]\nfn list_flatmap[A, B](f: (A) -> List[B], xs: List[A]) -> List[B]\nfn flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]\nfn list_is_empty[T](xs: List[T]) -> Bool\nfn list_iter_get[T](xs: List[T], index: Int) -> T\nfn iter_get[T](xs: List[T], index: Int) -> T\nfn list_singleton[T](x: T) -> List[T]\nfn singleton[T](x: T) -> List[T]\nfn list_contains_by[T](eq: (T, T) -> Bool, value: T, xs: List[T]) -> Bool\nfn List::nth[T](xs: List[T], n: Int) -> Option[T]\nfn List::sum(xs: List[Int]) -> Int\nfn List::zip[A, B](xs: List[A], ys: List[B]) -> List[(A, B)]\nfn List::drop[T](xs: List[T], n: Int) -> List[T]\nfn List::head[T](xs: List[T]) -> Option[T]\nfn List::iter[T, R](xs: List[T], f: (T) -> R) -> Int\nfn List::tail[T](xs: List[T]) -> List[T]\nfn List::take[T](xs: List[T], n: Int) -> List[T]\nfn List::append[T](xs: List[T], ys: List[T]) -> List[T]\nfn List::filter[T](xs: List[T], pred: (T) -> Bool) -> List[T]\nfn List::length[T](xs: List[T]) -> Int\nfn List::flatmap[A, B](xs: List[A], f: (A) -> List[B]) -> List[B]\nfn List::reverse[T](xs: List[T]) -> List[T]\nfn List::is_empty[T](xs: List[T]) -> Bool\nfn List::iter_get[T](xs: List[T], index: Int) -> T\nfn List::contains_by[T](xs: List[T], eq: (T, T) -> Bool, value: T) -> Bool\nfn List::iter_length[T](xs: List[T]) -> Int\n\n// --- set\nfn size(s: StringSet) -> Int\nfn empty() -> StringSet\nfn remove(s: StringSet, value: String) -> StringSet\nfn contains(s: StringSet, value: String) -> Bool\nfn add(s: StringSet, value: String) -> StringSet\nfn is_empty(s: StringSet) -> Bool\nfn set_union(a: StringSet, b: StringSet) -> StringSet\nfn from_array(values: Array[String]) -> StringSet\nfn set_intersect(a: StringSet, b: StringSet) -> StringSet\nfn set_difference(a: StringSet, b: StringSet) -> StringSet\nfn set_value_to_string[T](value: T) -> String\nfn add_by[T](s: StringSet, value: T) -> StringSet\nfn remove_by[T](s: StringSet, value: T) -> StringSet\nfn contains_by[T](s: StringSet, value: T) -> Bool\nfn from_array_by[T](values: Array[T]) -> StringSet\n")
