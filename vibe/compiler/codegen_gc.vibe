// AST-to-WASM codegen (wasm-gc backend)
// Uses GC struct types for ref cells instead of linear memory bump allocation.
// Closures use table-based call_indirect (same as linear memory backend).

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push_array, bytebuf_length,
  bytebuf_to_bytes, bytebuf_push_section, bytebuf_push_vec_header,
  leb128_encode_u32, leb128_encode_s64
}

import ./wasm_emit.vibe {
  emit_header,
  emit_type_section, emit_type_section_multi,
  emit_function_section, emit_export_section, emit_export_section_multi,
  emit_code_section, emit_code_section_with_locals,
  emit_name, emit_func_type_raw,
  emit_import_section_func, emit_memory_section,
  emit_exports_with_memory, emit_data_section, emit_data_section_multi,
  emit_local_get, emit_local_set, emit_local_tee,
  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,
  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor,
  emit_i64_shl, emit_i64_shr_s,
  emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,
  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz,
  emit_i64_extend_i32_s, emit_i32_wrap_i64,
  emit_i32_const, emit_i32_store, emit_i32_add, emit_i32_load,
  emit_i32_store8, emit_i32_load8_u,
  emit_call, emit_drop, emit_return,
  emit_block_void, emit_block_i64, emit_loop_void,
  emit_if_void, emit_if_i64, emit_else, emit_end,
  emit_br, emit_br_if,
  emit_global_section_i32_mut, emit_global_get, emit_global_set,
  string_to_data,
  emit_f64_const_bits, emit_f64_add, emit_f64_sub, emit_f64_mul, emit_f64_div,
  emit_f64_eq, emit_f64_ne, emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge,
  emit_f64_neg, emit_i64_reinterpret_f64, emit_f64_reinterpret_i64,
  emit_i64_trunc_f64_s, emit_f64_convert_i64_s,
  emit_call_indirect, emit_table_section_funcref, emit_element_section_active,
  emit_struct_type_raw, emit_struct_new, emit_struct_get, emit_struct_set
}

import ./codegen_common.vibe {
  emit_i32_sub, emit_i32_mul, emit_i32_ne, emit_i32_eq, emit_i32_ge_u, emit_i32_eqz,
  emit_i64_store, emit_i64_load, emit_i64_extend_i32_u, emit_memory_copy,
  resolve_local, resolve_func, FuncTable, StrTable, CtorTable,
  emit_str_ref, collect_strings_stmts,
  array_contains_str, collect_free_vars, is_mut_captured_in,
  str_table_lookup, find_catchall_idx, find_func_stmt,
  lookup_ctor,
  emit_binop_op, emit_assignop_op, emit_closure_resolve, emit_closure_call_tail
}

// === Expression compiler (GC backend) ===

let rec compile_expr_gc = (
  buf: Array[Int],
  expr: Expr,
  local_names: Array[String],
  next_local: Int,
  func_table: FuncTable,
  str_table: StrTable,
  ld: Int,
  ref_cell_names: Array[String],
  ref_local_indices: Array[Int],
  refcell_type_idx: Int,
  lambda_bodies: Array[Array[Int]],
  lambda_param_counts: Array[Int],
  lambda_captures: Array[Array[String]],
  lambda_meta_i32: Array[Int],
  lambda_meta_i64: Array[Int],
  num_user_funcs: Int,
  func_offset: Int,
  closure_type_base: Int,
  ctor_table: CtorTable
) -> Int with { Error } {
  // shorthand for recursive call
  let ce = (b: Array[Int], e: Expr, ln: Array[String], nl: Int, d: Int) -> Int with { Error } {
    compile_expr_gc(b, e, ln, nl, func_table, str_table, d, ref_cell_names, ref_local_indices, refcell_type_idx, lambda_bodies, lambda_param_counts, lambda_captures, lambda_meta_i32, lambda_meta_i64, num_user_funcs, func_offset, closure_type_base, ctor_table)
  }
  match expr {
    EInt(n) => {
      emit_i64_const(buf, n)
      next_local
    },
    EBool(b_val) => {
      emit_i64_const(buf, if b_val { 1 } else { 0 })
      next_local
    },
    EFloat(v) => {
      let bits = double_to_i64_bits(v)
      emit_f64_const_bits(buf, bits)
      emit_i64_reinterpret_f64(buf)
      next_local
    },
    EString(s) => {
      let idx = str_table_lookup(str_table.strs, s)
      emit_str_ref(buf, array_get(str_table.offsets, idx), array_get(str_table.lengths, idx))
      next_local
    },
    EIdent(name) => {
      // Try local first
      let len = array_length(local_names)
      let rec try_local = (i: Int) -> Int {
        if i < 0 { -1 }
        else if string_equals(array_get(local_names, i), name) { i }
        else try_local(i - 1)
      }
      let local_idx = try_local(len - 1)
      if local_idx >= 0 {
        if array_contains_str(ref_cell_names, name) {
          // Ref cell: local holds (ref $RefCell), read via struct.get
          emit_local_get(buf, local_idx)
          emit_struct_get(buf, refcell_type_idx, 0)
        } else {
          emit_local_get(buf, local_idx)
        }
        next_local
      } else {
        // Check if it's a 0-arg enum constructor
        let ctor_idx = lookup_ctor(ctor_table.names, name, 0)
        if ctor_idx >= 0 {
          let tag_c = array_get(ctor_table.tags, ctor_idx)
          let ptr_l = next_local
          array_push(local_names, "__ctor_ptr")
          emit_global_get(buf, 0)
          emit_i64_extend_i32_u(buf)
          emit_local_set(buf, ptr_l)
          emit_global_get(buf, 0)
          emit_i32_const(buf, 8)
          emit_i32_add(buf)
          emit_global_set(buf, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, tag_c)
          emit_i32_store(buf, 2, 0)
          emit_local_get(buf, ptr_l)
          emit_i32_wrap_i64(buf)
          emit_i32_const(buf, 0)
          emit_i32_store(buf, 2, 4)
          emit_local_get(buf, ptr_l)
          emit_i64_const(buf, 1)
          emit_i64_or(buf)
          next_local + 1
        } else {
        // Check if it's a top-level function — emit as bare fn value
        let fn_len = array_length(func_table.names)
        let rec try_fn = (j: Int) -> Int with { Error } {
          if j >= fn_len { throw(string_concat("undefined variable: ", name)) }
          else if string_equals(array_get(func_table.names, j), name) { j }
          else try_fn(j + 1)
        }
        let fni = try_fn(0)
        let fidx = array_get(func_table.indices, fni)
        let table_slot = fidx - func_offset
        emit_i64_const(buf, (table_slot << 2) | 2)
        next_local
        }
      }
    },
    EBinOp(op, lhs, rhs) => {
      let nl1 = ce(buf, lhs, local_names, next_local, ld)
      let nl2 = ce(buf, rhs, local_names, nl1, ld)
      emit_binop_op(buf, op)
      nl2
    },
    EUnaryOp(op, operand) => {
      if string_equals(op, "-") {
        emit_i64_const(buf, 0)
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_sub(buf)
        nl
      } else if string_equals(op, "!") {
        let nl = ce(buf, operand, local_names, next_local, ld)
        emit_i64_eqz(buf)
        emit_i64_extend_i32_s(buf)
        nl
      } else {
        throw(string_concat("unsupported unary op: ", op))
      }
    },
    EIf(cond, then_e, else_e) => {
      let nl1 = ce(buf, cond, local_names, next_local, ld)
      emit_i32_wrap_i64(buf)
      emit_if_i64(buf)
      let ld_inner = if ld >= 0 { ld + 1 } else { -1 }
      let names_len_before = array_length(local_names)
      let nl2 = ce(buf, then_e, local_names, nl1, ld_inner)
      emit_else(buf)
      array_truncate(local_names, names_len_before)
      let nl3 = ce(buf, else_e, local_names, nl1, ld_inner)
      emit_end(buf)
      if nl2 > nl3 { nl2 } else { nl3 }
    },
    ECall(callee, args) => {
      match callee {
        EIdent(fname) => {
          // Check if this is an enum constructor call
          let ctor_lookup_idx = lookup_ctor(ctor_table.names, fname, 0)
          if ctor_lookup_idx >= 0 {
            let tag = array_get(ctor_table.tags, ctor_lookup_idx)
            let fc = array_get(ctor_table.field_counts, ctor_lookup_idx)
            let obj_size = 8 + fc * 8
            let ptr_local = next_local
            array_push(local_names, "__ctor_ptr")
            emit_global_get(buf, 0)
            emit_i64_extend_i32_u(buf)
            emit_local_set(buf, ptr_local)
            emit_global_get(buf, 0)
            emit_i32_const(buf, obj_size)
            emit_i32_add(buf)
            emit_global_set(buf, 0)
            emit_local_get(buf, ptr_local)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, tag)
            emit_i32_store(buf, 2, 0)
            emit_local_get(buf, ptr_local)
            emit_i32_wrap_i64(buf)
            emit_i32_const(buf, fc)
            emit_i32_store(buf, 2, 4)
            // For structs, unwrap ERecord and reorder fields
            let actual_args = if array_length(args) == 1 {
              match array_get(args, 0) {
                ERecord(rec_fields) => {
                  let rec find_sn = (sni: Int) -> Int {
                    if sni >= array_length(ctor_table.struct_names) { -1 }
                    else if string_equals(array_get(ctor_table.struct_names, sni), fname) { sni }
                    else find_sn(sni + 1)
                  }
                  let sn_idx = find_sn(0)
                  if sn_idx >= 0 {
                    let def_fnames = array_get(ctor_table.struct_field_names, sn_idx)
                    let ordered = array_slice([EUnit], 0, 0)
                    let mut oi = 0
                    while oi < array_length(def_fnames) {
                      let target_name = array_get(def_fnames, oi)
                      let rec find_rf = (ri: Int) -> Expr {
                        if ri >= array_length(rec_fields) { EUnit }
                        else {
                          let (rfn, rfv) = array_get(rec_fields, ri)
                          if string_equals(rfn, target_name) { rfv }
                          else find_rf(ri + 1)
                        }
                      }
                      array_push(ordered, find_rf(0))
                      oi = oi + 1
                    }
                    ordered
                  } else { args }
                },
                _ => args
              }
            } else { args }
            let mut nl_c = next_local + 1
            let mut fi_c = 0
            while fi_c < array_length(actual_args) {
              nl_c = ce(buf, array_get(actual_args, fi_c), local_names, nl_c, ld)
              let val_local = nl_c
              array_push(local_names, "__ctor_val")
              emit_local_set(buf, val_local)
              nl_c = nl_c + 1
              emit_local_get(buf, ptr_local)
              emit_i32_wrap_i64(buf)
              emit_local_get(buf, val_local)
              emit_i64_store(buf, 3, 8 + fi_c * 8)
              fi_c = fi_c + 1
            }
            emit_local_get(buf, ptr_local)
            emit_i64_const(buf, 1)
            emit_i64_or(buf)
            nl_c
          }
          else {
          let fn_len2 = array_length(func_table.names)
          let rec try_resolve = (j: Int) -> Int {
            if j >= fn_len2 { -1 }
            else if string_equals(array_get(func_table.names, j), fname) { j }
            else try_resolve(j + 1)
          }
          let fn_idx_in_list = try_resolve(0)
          if fn_idx_in_list >= 0 {
            // Direct call to known function
            let fidx = array_get(func_table.indices, fn_idx_in_list)
            let has_ret = array_get(func_table.returns, fn_idx_in_list)
            let mut nl = next_local
            let mut ci = 0
            while ci < array_length(args) {
              nl = ce(buf, array_get(args, ci), local_names, nl, ld)
              ci = ci + 1
            }
            // User funcs in GC backend have __env param for table compatibility
            if func_offset > 0 {
              if fidx >= func_offset {
                emit_i64_const(buf, 0)
              }
            }
            emit_call(buf, fidx)
            if has_ret == 0 {
              emit_i64_const(buf, 0)
            }
            nl
          } else {
            // Indirect call: fname is a local holding a closure/fn value
            let local_idx2 = resolve_local(local_names, fname)
            let num_args = array_length(args)
            let fn_val_local = next_local
            let slot_local = next_local + 1
            let env_local = next_local + 2
            let mut nl = next_local + 3
            array_push(local_names, "__fn_val")
            array_push(local_names, "__slot")
            array_push(local_names, "__env")
            emit_local_get(buf, local_idx2)
            emit_local_set(buf, fn_val_local)
            emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
            let mut ci = 0
            while ci < num_args {
              nl = ce(buf, array_get(args, ci), local_names, nl, ld)
              ci = ci + 1
            }
            emit_closure_call_tail(buf, env_local, slot_local, closure_type_base, num_args)
            nl
          }
          } // close ctor_lookup else
        },
        _ => {
          // Callee is an arbitrary expression
          let num_args = array_length(args)
          let fn_val_local = next_local
          let slot_local = next_local + 1
          let env_local = next_local + 2
          let mut nl = next_local + 3
          array_push(local_names, "__fn_val")
          array_push(local_names, "__slot")
          array_push(local_names, "__env")
          nl = ce(buf, callee, local_names, nl, ld)
          emit_local_set(buf, fn_val_local)
          emit_closure_resolve(buf, fn_val_local, slot_local, env_local)
          let mut ci = 0
          while ci < num_args {
            nl = ce(buf, array_get(args, ci), local_names, nl, ld)
            ci = ci + 1
          }
          emit_closure_call_tail(buf, env_local, slot_local, closure_type_base, num_args)
          nl
        }
      }
    },
    ELet(name, value, body) => {
      let local_idx = next_local
      array_push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    ELetRec(name, value, body) => {
      let local_idx = next_local
      array_push(local_names, name)
      let nl = ce(buf, value, local_names, next_local + 1, ld)
      emit_local_set(buf, local_idx)
      // Backpatch self-reference in closure for recursive let rec
      match value {
        EFn(_, _, params, _, _, fn_body) => {
          let param_names_bp = array_slice([""], 0, 0)
          let mut bpi = 0
          while bpi < array_length(params) {
            let (pn, _) = array_get(params, bpi)
            array_push(param_names_bp, pn)
            bpi = bpi + 1
          }
          let caps = collect_free_vars(fn_body, param_names_bp, array_concat(func_table.names, ctor_table.names))
          let mut self_cap_idx = -1
          let mut bci = 0
          while bci < array_length(caps) {
            if string_equals(array_get(caps, bci), name) {
              self_cap_idx = bci
            }
            bci = bci + 1
          }
          if self_cap_idx >= 0 {
            emit_local_get(buf, local_idx)
            emit_i64_const(buf, -4)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_local_get(buf, local_idx)
            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)
          }
          0
        },
        _ => 0
      }
      let nl2 = ce(buf, body, local_names, nl, ld)
      nl2
    },
    ELetMut(name, value, body) => {
      let local_idx = next_local
      array_push(local_names, name)
      if is_mut_captured_in(body, name) {
        // Mutable captured: allocate GC ref cell via struct.new
        array_push(ref_cell_names, name)
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_struct_new(buf, refcell_type_idx)
        emit_local_set(buf, local_idx)
        array_push(ref_local_indices, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      } else {
        let nl = ce(buf, value, local_names, next_local + 1, ld)
        emit_local_set(buf, local_idx)
        let nl2 = ce(buf, body, local_names, nl, ld)
        nl2
      }
    },
    EAssign(name, value, body) => {
      let idx = resolve_local(local_names, name)
      if array_contains_str(ref_cell_names, name) {
        // Ref cell: struct.set
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_struct_set(buf, refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    EAssignOp(name, op, value, body) => {
      let idx = resolve_local(local_names, name)
      if array_contains_str(ref_cell_names, name) {
        // Ref cell: read via struct.get, compute, write via struct.set
        emit_local_get(buf, idx)   // ref on stack (for struct.set later)
        emit_local_get(buf, idx)   // ref on stack (for struct.get)
        emit_struct_get(buf, refcell_type_idx, 0)  // current value
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_struct_set(buf, refcell_type_idx, 0)
        ce(buf, body, local_names, nl, ld)
      } else {
        emit_local_get(buf, idx)
        let nl = ce(buf, value, local_names, next_local, ld)
        emit_assignop_op(buf, op)
        emit_local_set(buf, idx)
        ce(buf, body, local_names, nl, ld)
      }
    },
    ESeq(first, second) => {
      let nl = ce(buf, first, local_names, next_local, ld)
      emit_drop(buf)
      ce(buf, second, local_names, nl, ld)
    },
    ETuple(elems) => {
      // Allocate N*8 bytes on heap, store each element as i64
      let num_elems = array_length(elems)
      let alloc_size = num_elems * 8
      let ptr_local = next_local
      array_push(local_names, "__tuple_ptr")
      let mut nl = next_local + 1
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_tee(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, alloc_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      let mut ti = 0
      while ti < num_elems {
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        nl = ce(buf, array_get(elems, ti), local_names, nl, ld)
        emit_i64_store(buf, 3, ti * 8)
        ti = ti + 1
      }
      emit_local_get(buf, ptr_local)
      nl
    },
    EMatch(scrutinee, arms) => {
      let scrut_local = next_local
      // Push name BEFORE compiling scrutinee so temp locals don't shift indices
      array_push(local_names, "__match_scrut")
      let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)
      emit_local_set(buf, scrut_local)
      let num_arms = array_length(arms)
      let catchall_idx = find_catchall_idx(arms)
      let num_cond_arms = catchall_idx
      let mut max_nl = nl1
      let mut ai = 0
      while ai < num_cond_arms {
        let (p, _) = array_get(arms, ai)
        match p {
          PInt(n) => {
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, n)
            emit_i64_eq(buf)
            emit_if_i64(buf)
            0
          },
          PBool(bv) => {
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, if bv { 1 } else { 0 })
            emit_i64_eq(buf)
            emit_if_i64(buf)
            0
          },
          PCtor(cname_cond, _) => {
            let ctor_ci = lookup_ctor(ctor_table.names, cname_cond, 0)
            let expected_tag = if ctor_ci >= 0 { array_get(ctor_table.tags, ctor_ci) } else { -1 }
            emit_local_get(buf, scrut_local)
            emit_i64_const(buf, -2)
            emit_i64_and(buf)
            emit_i32_wrap_i64(buf)
            emit_i32_load(buf, 2, 0)
            emit_i32_const(buf, expected_tag)
            emit_i32_eq(buf)
            emit_if_i64(buf)
            0
          },
          PString(sval) => {
            let str_idx = str_table_lookup(str_table.strs, sval)
            if str_idx >= 0 {
              emit_local_get(buf, scrut_local)
              emit_str_ref(buf, array_get(str_table.offsets, str_idx), array_get(str_table.lengths, str_idx))
              emit_call(buf, 4)
              emit_i64_const(buf, 1)
              emit_i64_eq(buf)
              emit_if_i64(buf)
            }
            0
          },
          _ => 0
        }
        // Compile arm body — for PCtor, bind fields first
        let names_len_at_arm = array_length(local_names)
        let (p2, arm_body) = array_get(arms, ai)
        let ld_arm = if ld >= 0 { ld + ai + 1 } else { -1 }
        match p2 {
          PCtor(_, cargs_bind) => {
            let mut cbi = 0
            while cbi < array_length(cargs_bind) {
              match array_get(cargs_bind, cbi) {
                PBind(pname) => {
                  let fl = array_length(local_names)
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                  emit_i32_wrap_i64(buf)
                  emit_i64_load(buf, 3, 8 + cbi * 8)
                  emit_local_set(buf, fl)
                  array_push(local_names, pname)
                  0
                },
                PWild => 0,
                _ => 0
              }
              cbi = cbi + 1
            }
            let arm_nl = ce(buf, arm_body, local_names, array_length(local_names), ld_arm)
            if arm_nl > max_nl { max_nl = arm_nl }
            0
          },
          _ => {
            let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)
            if arm_nl > max_nl { max_nl = arm_nl }
            0
          }
        }
        emit_else(buf)
        array_truncate(local_names, names_len_at_arm)
        ai = ai + 1
      }
      let ld_catch = if ld >= 0 { ld + num_cond_arms } else { -1 }
      let names_len_at_catch = array_length(local_names)
      if catchall_idx < num_arms {
        let (cp, cbody) = array_get(arms, catchall_idx)
        let catch_nl = match cp {
          PBind(bname) => {
            let bind_local = array_length(local_names)
            emit_local_get(buf, scrut_local)
            emit_local_set(buf, bind_local)
            array_push(local_names, bname)
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
          },
          PCtor(cname, cargs) => {
            let mut cbi2 = 0
            while cbi2 < array_length(cargs) {
              match array_get(cargs, cbi2) {
                PBind(pname) => {
                  let fl2 = array_length(local_names)
                  emit_local_get(buf, scrut_local)
                  emit_i64_const(buf, -2)
                  emit_i64_and(buf)
                  emit_i32_wrap_i64(buf)
                  emit_i64_load(buf, 3, 8 + cbi2 * 8)
                  emit_local_set(buf, fl2)
                  array_push(local_names, pname)
                  0
                },
                PWild => 0,
                _ => 0
              }
              cbi2 = cbi2 + 1
            }
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
          },
          PTuple(pats) => {
            let ptr_local2 = array_length(local_names)
            emit_local_get(buf, scrut_local)
            emit_local_set(buf, ptr_local2)
            array_push(local_names, "__tup_ptr2")
            let mut pi2 = 0
            while pi2 < array_length(pats) {
              let tp = array_get(pats, pi2)
              match tp {
                PBind(pname) => {
                  let field_l = array_length(local_names)
                  emit_local_get(buf, ptr_local2)
                  emit_i32_wrap_i64(buf)
                  emit_i64_load(buf, 3, pi2 * 8)
                  emit_local_set(buf, field_l)
                  array_push(local_names, pname)
                  0
                },
                PWild => 0,
                _ => throw("unsupported pattern in tuple destructure")
              }
              pi2 = pi2 + 1
            }
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
          },
          _ => {
            ce(buf, cbody, local_names, array_length(local_names), ld_catch)
          }
        }
        if catch_nl > max_nl { max_nl = catch_nl }
        0
      } else {
        bytebuf_push(buf, 0)  // unreachable
        0
      }
      let mut ci2 = 0
      while ci2 < num_cond_arms {
        emit_end(buf)
        ci2 = ci2 + 1
      }
      max_nl
    },
    EArray(elems) => {
      let (arr_new_idx, _, _) = resolve_func(func_table, "array_new")
      let (arr_push_idx, _, _) = resolve_func(func_table, "array_push")
      let arr_local = next_local
      emit_call(buf, arr_new_idx)
      emit_local_set(buf, arr_local)
      array_push(local_names, "__arr_lit")
      let mut nl = next_local + 1
      let mut ei = 0
      while ei < array_length(elems) {
        emit_local_get(buf, arr_local)
        nl = ce(buf, array_get(elems, ei), local_names, nl, ld)
        emit_call(buf, arr_push_idx)
        ei = ei + 1
      }
      emit_local_get(buf, arr_local)
      nl
    },
    EForIn(var_name, iter_expr, body) => {
      let (arr_len_idx, _, _) = resolve_func(func_table, "array_length")
      let (arr_get_idx, _, _) = resolve_func(func_table, "array_get")
      let arr_local = next_local
      let nl1 = ce(buf, iter_expr, local_names, next_local + 1, ld)
      emit_local_set(buf, arr_local)
      array_push(local_names, "__for_arr")
      let i_local = nl1
      emit_i64_const(buf, 0)
      emit_local_set(buf, i_local)
      array_push(local_names, "__for_i")
      let nl2 = nl1 + 1
      emit_block_void(buf)
        emit_loop_void(buf)
          emit_local_get(buf, i_local)
          emit_local_get(buf, arr_local)
          emit_call(buf, arr_len_idx)
          emit_i64_ge_s(buf)
          emit_i64_extend_i32_s(buf)
          emit_i32_wrap_i64(buf)
          emit_br_if(buf, 1)
          let var_local = nl2
          emit_local_get(buf, arr_local)
          emit_local_get(buf, i_local)
          emit_call(buf, arr_get_idx)
          emit_local_set(buf, var_local)
          array_push(local_names, var_name)
          let nl3 = nl2 + 1
          let nl4 = ce(buf, body, local_names, nl3, ld + 1)
          emit_drop(buf)
          emit_local_get(buf, i_local)
          emit_i64_const(buf, 1)
          emit_i64_add(buf)
          emit_local_set(buf, i_local)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl4
    },
    EWhile(cond, body) => {
      emit_block_void(buf)
        emit_loop_void(buf)
          let nl1 = ce(buf, cond, local_names, next_local, ld + 1)
          emit_i64_eqz(buf)
          emit_br_if(buf, 1)
          let nl2 = ce(buf, body, local_names, nl1, ld + 1)
          emit_drop(buf)
          emit_br(buf, 0)
        emit_end(buf)
      emit_end(buf)
      emit_i64_const(buf, 0)
      nl2
    },
    EBreak(_) => {
      emit_br(buf, ld + 1)
      emit_i64_const(buf, 0)
      next_local
    },
    EContinue(_) => {
      emit_br(buf, ld)
      emit_i64_const(buf, 0)
      next_local
    },
    EUnit => {
      emit_i64_const(buf, 0)
      next_local
    },
    EThrow(msg_expr) => {
      let nl = ce(buf, msg_expr, local_names, next_local, ld)
      emit_drop(buf)
      bytebuf_push(buf, 0)  // unreachable
      nl
    },
    EFn(_, _, params, _, _, fn_body) => {
      // Lambda: collect free vars, compile body, create closure
      let param_names_arr = array_slice([""], 0, 0)
      let mut pi = 0
      while pi < array_length(params) {
        let (pname, _) = array_get(params, pi)
        array_push(param_names_arr, pname)
        pi = pi + 1
      }
      let fn_and_ctor = array_concat(func_table.names, ctor_table.names)
      let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)
      let num_captures = array_length(captures)
      let user_params = array_length(params)

      // Compile lambda body into a separate buffer
      let lam_buf = bytebuf_new()
      let lam_locals = array_slice([""], 0, 0)
      let mut lpi = 0
      while lpi < user_params {
        let (lpname, _) = array_get(params, lpi)
        array_push(lam_locals, lpname)
        lpi = lpi + 1
      }
      array_push(lam_locals, "__env")
      let env_param_idx = user_params
      let lam_nl_start = user_params + 1

      // Prologue: extract captures from env
      let lam_ref_cells = array_slice([""], 0, 0)
      let lam_ref_local_indices = array_slice([0], 0, 0)
      let mut ci3 = 0
      let mut lam_nl = lam_nl_start
      while ci3 < num_captures {
        let cap_local = lam_nl
        let cap_name = array_get(captures, ci3)
        emit_local_get(lam_buf, env_param_idx)
        emit_i32_wrap_i64(lam_buf)
        emit_i64_load(lam_buf, 3, 8 + ci3 * 8)
        emit_local_set(lam_buf, cap_local)
        array_push(lam_locals, cap_name)
        if array_contains_str(ref_cell_names, cap_name) {
          array_push(lam_ref_cells, cap_name)
        }
        lam_nl = lam_nl + 1
        ci3 = ci3 + 1
      }

      // Compile lambda body
      let final_lam_nl = compile_expr_gc(
        lam_buf, fn_body, lam_locals, lam_nl,
        func_table,
        str_table, -1,
        lam_ref_cells, lam_ref_local_indices, refcell_type_idx,
        lambda_bodies, lambda_param_counts, lambda_captures,
        lambda_meta_i32, lambda_meta_i64, num_user_funcs, func_offset,
        closure_type_base, ctor_table
      )

      // Record lambda AFTER body compilation (nested lambdas already added)
      let lambda_idx = array_length(lambda_bodies)
      array_push(lambda_bodies, lam_buf)
      array_push(lambda_param_counts, user_params + 1)  // +1 for env
      array_push(lambda_captures, captures)
      let extra_lam = if final_lam_nl > (user_params + 1) { final_lam_nl - (user_params + 1) } else { 0 }
      array_push(lambda_meta_i32, 0)
      array_push(lambda_meta_i64, extra_lam)

      // Emit closure creation code
      let table_slot = num_user_funcs + lambda_idx
      if num_captures == 0 {
        emit_i64_const(buf, (table_slot << 2) | 2)
        next_local
      } else {
        let alloc_size = 8 + num_captures * 8
        let ptr_local = next_local
        let mut nl2 = next_local + 1
        array_push(local_names, "__closure_ptr")
        emit_global_get(buf, 0)
        emit_i64_extend_i32_u(buf)
        emit_local_tee(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, alloc_size)
        emit_i32_add(buf)
        emit_global_set(buf, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, table_slot)
        emit_i32_store(buf, 2, 0)
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_i32_const(buf, num_captures)
        emit_i32_store(buf, 2, 4)
        let mut csi = 0
        while csi < num_captures {
          let cap_name = array_get(captures, csi)
          let cap_idx = resolve_local(local_names, cap_name)
          emit_local_get(buf, ptr_local)
          emit_i32_wrap_i64(buf)
          emit_local_get(buf, cap_idx)
          emit_i64_store(buf, 3, 8 + csi * 8)
          csi = csi + 1
        }
        emit_local_get(buf, ptr_local)
        emit_i64_const(buf, 1)
        emit_i64_or(buf)
        nl2
      }
    },
    EDot(obj, field) => {
      // Struct field access: find field index from ctor_table.struct_field_names
      let rec find_struct_field_idx = (si2: Int) -> Int {
        if si2 >= array_length(ctor_table.struct_names) { -1 }
        else {
          let fnames = array_get(ctor_table.struct_field_names, si2)
          let rec find_f = (fi: Int) -> Int {
            if fi >= array_length(fnames) { -1 }
            else if string_equals(array_get(fnames, fi), field) { fi }
            else find_f(fi + 1)
          }
          let idx = find_f(0)
          if idx >= 0 { idx }
          else find_struct_field_idx(si2 + 1)
        }
      }
      let field_idx = find_struct_field_idx(0)
      if field_idx < 0 {
        throw(string_concat("unknown struct field: ", field))
      }
      let nl1 = ce(buf, obj, local_names, next_local, ld)
      // Untag: ptr & ~1
      emit_i64_const(buf, -2)
      emit_i64_and(buf)
      emit_i32_wrap_i64(buf)
      // Load field at offset 8 + field_idx * 8
      emit_i64_load(buf, 3, 8 + field_idx * 8)
      nl1
    },
    ERecord(fields) => {
      // Record literal: heap alloc [tag_i32 | field_count_i32 | fields...]
      let flen = array_length(fields)
      let obj_size = 8 + flen * 8
      let ptr_local = next_local
      array_push(local_names, "__rec_ptr")
      emit_global_get(buf, 0)
      emit_i64_extend_i32_u(buf)
      emit_local_set(buf, ptr_local)
      emit_global_get(buf, 0)
      emit_i32_const(buf, obj_size)
      emit_i32_add(buf)
      emit_global_set(buf, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, 0)
      emit_i32_store(buf, 2, 0)
      emit_local_get(buf, ptr_local)
      emit_i32_wrap_i64(buf)
      emit_i32_const(buf, flen)
      emit_i32_store(buf, 2, 4)
      let mut nl_r = next_local + 1
      let mut ri = 0
      while ri < flen {
        let (_, fexpr) = array_get(fields, ri)
        nl_r = ce(buf, fexpr, local_names, nl_r, ld)
        let val_local = nl_r
        array_push(local_names, "__rec_val")
        emit_local_set(buf, val_local)
        nl_r = nl_r + 1
        emit_local_get(buf, ptr_local)
        emit_i32_wrap_i64(buf)
        emit_local_get(buf, val_local)
        emit_i64_store(buf, 3, 8 + ri * 8)
        ri = ri + 1
      }
      emit_local_get(buf, ptr_local)
      emit_i64_const(buf, 1)
      emit_i64_or(buf)
      nl_r
    },
    _ => throw("unsupported expression in gc codegen")
  }
}

// === Builtin generators (copied from codegen.vibe) ===

let gen_print_i64_body = () -> Array[Int] {
  let b = bytebuf_new()
  emit_i32_const(b, 46)
  emit_local_set(b, 2)
  emit_i32_const(b, 47)
  emit_i32_const(b, 10)
  emit_i32_store8(b, 0, 0)
  emit_local_get(b, 0)
  emit_i64_const(b, 0)
  emit_i64_lt_s(b)
  emit_local_set(b, 1)
  emit_local_get(b, 1)
  emit_if_i64(b)
    emit_i64_const(b, 0)
    emit_local_get(b, 0)
    emit_i64_sub(b)
  emit_else(b)
    emit_local_get(b, 0)
  emit_end(b)
  emit_local_set(b, 4)
  emit_local_get(b, 4)
  emit_i64_eqz(b)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 48)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_block_void(b)
    emit_loop_void(b)
      emit_local_get(b, 4)
      emit_i64_eqz(b)
      emit_br_if(b, 1)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_rem_s(b)
      emit_i32_wrap_i64(b)
      emit_local_set(b, 3)
      emit_local_get(b, 2)
      emit_local_get(b, 3)
      emit_i32_const(b, 48)
      emit_i32_add(b)
      emit_i32_store8(b, 0, 0)
      emit_local_get(b, 2)
      emit_i32_const(b, 1)
      emit_i32_sub(b)
      emit_local_set(b, 2)
      emit_local_get(b, 4)
      emit_i64_const(b, 10)
      emit_i64_div_s(b)
      emit_local_set(b, 4)
      emit_br(b, 0)
    emit_end(b)
  emit_end(b)
  emit_local_get(b, 1)
  emit_if_void(b)
    emit_local_get(b, 2)
    emit_i32_const(b, 45)
    emit_i32_store8(b, 0, 0)
    emit_local_get(b, 2)
    emit_i32_const(b, 1)
    emit_i32_sub(b)
    emit_local_set(b, 2)
  emit_end(b)
  emit_i32_const(b, 0)
  emit_local_get(b, 2)
  emit_i32_const(b, 1)
  emit_i32_add(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 4)
  emit_i32_const(b, 47)
  emit_local_get(b, 2)
  emit_i32_sub(b)
  emit_i32_store(b, 2, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 0)
  emit_i32_const(b, 1)
  emit_i32_const(b, 8)
  emit_call(b, 0)
  emit_drop(b)
  b
}

