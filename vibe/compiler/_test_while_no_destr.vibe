//# Imports

import ./ast.vibe {
  Expr, Pat
}

//# Functions

let test_fn = (arms: Array[(Pat, Expr)]) -> Array[String] {
  let arr = arms
  let len = array_length(arr)
  let b = array_builder()
  let mut i = 0
  while i < len {
    let arm = array_get(arr, i)
    i = i + 1
    array_builder_push(b, "item")
  }
  array_builder_freeze(b)
}
