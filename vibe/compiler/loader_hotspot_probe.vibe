//# Imports

import ./loader/manifest_sources.vibe {
  build_grouped_sources_from_manifest_row_source_index,
  build_grouped_sources_from_manifest_rows,
  build_manifest_path_index,
  build_manifest_source_index,
  filter_manifest_sources_by_path_index,
  filter_manifest_sources_by_source_index,
  filter_manifest_sources_by_paths,
  load_manifest_full_sources,
  try_load_manifest_rows
}

import ./module_loader.vibe {
  collect_all_sources_fs, collect_source_groups_fs
}

//# Functions

let selfhost_loader_entry_path = "vibe/compiler/module_loader.vibe"

let contains_str: (Array[String], String) -> Bool = (values, target) -> {
  let mut found = false
  let mut i = 0
  while i < Array::length(values) {
    if Array::get(values, i) == target {
      found = true
      i = Array::length(values)
    } else {
      i = i + 1
    }
  }
  found
}

let collect_source_paths: (Array[(String, String)]) -> Array[String] = (sources) -> {
  let paths = Array::slice([""], 0, 0)
  let mut i = 0
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    Array::push(paths, path)
    i = i + 1
  }
  paths
}

let source_lookup_linear: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {
  let mut found = None
  let mut i = 0
  while i < Array::length(sources) {
    match found {
      Some(_) => (),
      None => {
        let (path, source) = Array::get(sources, i)
        if path == path_key {
          found = Some(source)
        }
      }
    }
    i = i + 1
  }
  found
}

let push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == group_name {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

let encode_grouped_sources: (Array[(String, Array[(String, String)])]) -> Int = (groups) -> {
  let mut total_sources = 0
  let mut i = 0
  while i < Array::length(groups) {
    let (_, sources) = Array::get(groups, i)
    total_sources = total_sources + Array::length(sources)
    i = i + 1
  }
  Array::length(groups) * 1000 + total_sources
}

export let load_selfhost_loader_hotspot_fixture: () -> (
  String,
  Array[(String, String)],
  Array[(String, String)],
  Array[(String, String)],
  Array[String]
) with { Error, Fs } = () -> {
  let entry_path = selfhost_loader_entry_path
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let preloaded_sources = load_manifest_full_sources(base_dir, rows)
      let needed_sources = collect_all_sources_fs(entry_path)
      let needed_paths = collect_source_paths(needed_sources)
      (base_dir, rows, preloaded_sources, needed_sources, needed_paths)
    },
    None => throw("selfhost manifest rows are unavailable")
  }
}

export let load_selfhost_loader_hotspot_indexed_fixture: () -> (
  String,
  Array[(String, String)],
  Array[(String, String)],
  Array[(String, String)],
  Array[String],
  Map[String, String],
  Map[String, Bool],
  Map[String, String]
) with { Error, Fs } = () -> {
  let (
    base_dir,
    rows,
    preloaded_sources,
    needed_sources,
    needed_paths
  ) = load_selfhost_loader_hotspot_fixture()
  let preloaded_source_index = build_manifest_source_index(preloaded_sources)
  let needed_path_index = build_manifest_path_index(needed_paths)
  let needed_source_index = build_manifest_source_index(needed_sources)
  (
    base_dir,
    rows,
    preloaded_sources,
    needed_sources,
    needed_paths,
    preloaded_source_index,
    needed_path_index,
    needed_source_index
  )
}

export let probe_loader_manifest_list_count: () -> Int with { Error, Fs } = () -> {
  let sources = collect_all_sources_fs(selfhost_loader_entry_path)
  Array::length(sources)
}

export let probe_loader_manifest_list_filter_linear_count: (Array[(String, String)], Array[String]) -> Int = (preloaded_sources, needed_paths) -> {
  let filtered_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(preloaded_sources) {
    let (path, source) = Array::get(preloaded_sources, i)
    if contains_str(needed_paths, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  Array::length(filtered_sources)
}

export let probe_loader_manifest_list_filter_indexed_count: (Array[(String, String)], Array[String]) -> Int = (preloaded_sources, needed_paths) -> {
  let filtered_sources = filter_manifest_sources_by_paths(
    preloaded_sources,
    needed_paths
  )
  Array::length(filtered_sources)
}

export let probe_loader_manifest_list_filter_indexed_count_with_index: (Array[(String, String)], Map[String, Bool]) -> Int = (preloaded_sources, needed_path_index) -> {
  let filtered_sources = filter_manifest_sources_by_path_index(
    preloaded_sources,
    needed_path_index
  )
  Array::length(filtered_sources)
}

export let probe_loader_manifest_list_filter_source_indexed_count: (Array[String], Map[String, String]) -> Int = (needed_paths, preloaded_source_index) -> {
  let filtered_sources = filter_manifest_sources_by_source_index(
    needed_paths,
    preloaded_source_index
  )
  Array::length(filtered_sources)
}

export let probe_loader_manifest_groups_encoded: () -> Int with { Error, Fs } = () -> {
  let groups = collect_source_groups_fs(selfhost_loader_entry_path)
  encode_grouped_sources(groups)
}

export let probe_loader_manifest_groups_linear_encoded: (String, Array[(String, String)], Array[(String, String)]) -> Int = (base_dir, rows, needed_sources) -> {
  let groups = Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = if base_dir == "" {
      rel_path
    } else {
      String::concat(base_dir, String::concat("/", rel_path))
    }
    match source_lookup_linear(needed_sources, path) {
      Some(source) => push_grouped_source(groups, group_name, path, source),
      None => ()
    }
    i = i + 1
  }
  encode_grouped_sources(groups)
}

export let probe_loader_manifest_groups_indexed_encoded: (String, Array[(String, String)], Array[(String, String)]) -> Int = (base_dir, rows, needed_sources) -> {
  let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, needed_sources)
  encode_grouped_sources(groups)
}

export let probe_loader_manifest_groups_indexed_encoded_with_source_index: (String, Array[(String, String)], Map[String, String]) -> Int = (base_dir, rows, needed_source_index) -> {
  let groups = build_grouped_sources_from_manifest_row_source_index(
    base_dir,
    rows,
    needed_source_index
  )
  encode_grouped_sources(groups)
}
