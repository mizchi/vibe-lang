//# Imports

import ./syntax / lexer.vibe {
  lex
}

import ./syntax / token.vibe {
  Token
}

//# Functions

let lex_token_count = (source: String) -> Int with { Error } {
  Array::length(lex(source))
}

let lex_repeat_count = (source: String, repeats: Int) -> Int with { Error } {
  let mut total = 0
  let mut i = 0
  while i < repeats {
    total = total + Array::length(lex(source))
    i = i + 1
  }
  total
}

let lex_token_payload_walk = (source: String) -> Int with { Error } {
  let tokens = lex(source)
  let mut total = 0
  let mut i = 0
  let len = Array::length(tokens)
  while i < len {
    let delta = match Array::get(tokens, i) {
      TIdent(name) => String::length(name),
      TString(s) => String::length(s),
      _ => 1
    }
    total = total + delta
    i = i + 1
  }
  total
}

export let probe_lex_lexer_vibe = () -> Int with { Error, Fs } {
  lex_token_count(perform Fs::ReadFile("vibe/compiler/syntax/lexer.vibe"))
}

export let probe_lex_checker_vibe = () -> Int with { Error, Fs } {
  lex_token_count(perform Fs::ReadFile("vibe/compiler/checker/checker.vibe"))
}

export let probe_lex_parser_vibe = () -> Int with { Error, Fs } {
  lex_token_count(perform Fs::ReadFile("vibe/compiler/syntax/parser.vibe"))
}

export let probe_lex_synthetic_keyword_heavy = () -> Int with { Error } {
  lex_repeat_count("let f = (x: Int) -> Int { if x > 0 { let mut y = 0 while y < x { y = y + 1 } y } else { 0 } }\nlet g = (a: Int, b: Int) -> Int { match (a, b) { (0, _) => b, (_, 0) => a, (x, y) => x + y } }\nlet h = (xs: Array[Int]) -> Int { let mut sum = 0 for x in xs { sum = sum + x } sum }\nlet i: [T: Eq + Ord](T) -> T = (x) -> { x }\n", 32)
}

export let probe_lex_token_payload_walk = () -> Int with { Error, Fs } {
  lex_token_payload_walk(perform Fs::ReadFile("vibe/compiler/syntax/lexer.vibe"))
}
