//# Imports

import ./syntax / lexer.vibe {
  lex
}

import ./syntax / token.vibe {
  Token
}

//# Functions

let selfhost_lexer_source_path = "vibe/compiler/syntax/lexer.vibe"

let selfhost_checker_source_path = "vibe/compiler/checker/checker.vibe"

let selfhost_parser_source_path = "vibe/compiler/syntax/parser.vibe"

let synthetic_keyword_heavy_source = "let f = (x: Int) -> Int { if x > 0 { let mut y = 0 while y < x { y = y + 1 } y } else { 0 } }\nlet g = (a: Int, b: Int) -> Int { match (a, b) { (0, _) => b, (_, 0) => a, (x, y) => x + y } }\nlet h = (xs: Array[Int]) -> Int { let mut sum = 0 for x in xs { sum = sum + x } sum }\nlet i: [T: Eq + Ord](T) -> T = (x) -> { x }\n"

export let load_lexer_source_fixture = () -> (String, String, String, String) with { Error, Fs } {
  let lexer_source = perform Fs::ReadFile(selfhost_lexer_source_path)
  let checker_source = perform Fs::ReadFile(selfhost_checker_source_path)
  let parser_source = perform Fs::ReadFile(selfhost_parser_source_path)
  let synthetic = synthetic_keyword_heavy_source
  (lexer_source, checker_source, parser_source, synthetic)
}

export let probe_lex_token_count = (source: String) -> Int with { Error } {
  Array::length(lex(source))
}

export let probe_lex_total_token_length = (source: String) -> Int with { Error } {
  let tokens = lex(source)
  let mut total = 0
  let mut i = 0
  let len = Array::length(tokens)
  while i < len {
    match Array::get(tokens, i) {
      TIdent(name) => total = total + String::length(name),
      TString(s) => total = total + String::length(s),
      _ => total = total + 1
    }
    i = i + 1
  }
  total
}

export let probe_lex_repeat_count = (source: String, repeats: Int) -> Int with { Error } {
  let mut total = 0
  let mut i = 0
  while i < repeats {
    total = total + Array::length(lex(source))
    i = i + 1
  }
  total
}
