//# Selfbuild runner — full S5 compile

import ./module_loader.vibe {
  collect_merged_stmts
}

import ./selfhost_sources_bundle.vibe {
  selfhost_sources
}

import ./codegen.vibe {
  compile_wasi_module
}

let selfbuild_main = () -> Int with { Error } {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  let bytes = compile_wasi_module(merged, "selfbuild_compile_stage2")
  bytes_length(bytes)
}

selfbuild_main()
