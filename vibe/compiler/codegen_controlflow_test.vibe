//# Imports

import ./codegen_test_support.vibe {
  assert_wasm, compile_wasi
}

//# Misc

test "wasi: match int" {
  let source = "let f = (x: Int) -> Int {\n  match x {\n    0 => 100,\n    1 => 200,\n    _ => 300\n  }\n}\nlet main = () -> Int { f(1) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: match wildcard" {
  let source = "let f = (x: Int) -> Int {\n  match x {\n    0 => 100,\n    _ => 999\n  }\n}\nlet main = () -> Int { f(41) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: match default with scrutinee" {
  let source = "let f = (x: Int) -> Int {\n  match x {\n    0 => 100,\n    _ => x + 1\n  }\n}\nlet main = () -> Int { f(41) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: bool literal true" {
  let source = "let main = () -> Int { if true { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: bool literal false" {
  let source = "let main = () -> Int { if false { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: match bool pattern" {
  let source = "let f = (b: Int) -> Int {\n  match b {\n    true => 10,\n    false => 20\n  }\n}\nlet main = () -> Int { f(1) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: logical not" {
  let source = "let main = () -> Int { if !false { 42 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: division" {
  let source = "let main = () -> Int { 100 / 3 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: modulo" {
  let source = "let main = () -> Int { 17 % 5 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: equals true" {
  let source = "let main = () -> Int { if 3 == 3 { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: equals false" {
  let source = "let main = () -> Int { if 3 == 4 { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: not equals" {
  let source = "let main = () -> Int { if 3 != 4 { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: less than" {
  let source = "let main = () -> Int { if 3 < 5 { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: greater or equal" {
  let source = "let main = () -> Int { if 5 >= 5 { 1 } else { 0 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: bitwise and" {
  let source = "let main = () -> Int { 15 & 9 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: bitwise or" {
  let source = "let main = () -> Int { 5 | 3 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: bitwise xor" {
  let source = "let main = () -> Int { 15 ^ 9 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: shift left" {
  let source = "let main = () -> Int { 1 << 4 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: shift right" {
  let source = "let main = () -> Int { 32 >> 2 }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: logical and" {
  let source = "let main = () -> Int { if 1 && 1 { 10 } else { 20 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: logical or" {
  let source = "let main = () -> Int { if 0 || 1 { 10 } else { 20 } }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: unit expression" {
  let source = "let main = () -> Int {\n  let _ = ()\n  99\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: match many arms" {
  let source = "let f = (x: Int) -> Int {\n  match x {\n    0 => 10,\n    1 => 20,\n    2 => 30,\n    3 => 40,\n    _ => 50\n  }\n}\nlet main = () -> Int { f(3) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: nested let bindings" {
  let source = "let main = () -> Int {\n  let a = 10\n  let b = a + 5\n  let c = b * 2\n  c + a\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: while with mutation" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 1\n  while i <= 10 {\n    sum = sum + i\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: string in array workflow" {
  let source = "let main = () -> Int {\n  let s = String::concat(\"hello \", \"world\")\n  String::length(s)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: array sum loop" {
  let source = "let main = () -> Int {\n  let arr = array_new()\n  Array::push(arr, 10)\n  Array::push(arr, 20)\n  Array::push(arr, 30)\n  let mut sum = 0\n  let mut i = 0\n  while i < Array::length(arr) {\n    sum = sum + Array::get(arr, i)\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: tuple3 destructure" {
  let source = "let f = () -> (Int, Int, Int) { (10, 20, 30) }\nlet main = () -> Int {\n  match f() {\n    (a, b, c) => a + b + c\n  }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: assign op plus" {
  let source = "let main = () -> Int {\n  let mut x = 10\n  x += 5\n  x\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: assign op minus" {
  let source = "let main = () -> Int {\n  let mut x = 10\n  x -= 3\n  x\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: assign op mul" {
  let source = "let main = () -> Int {\n  let mut x = 5\n  x *= 4\n  x\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: assign op in while loop" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 1\n  while i <= 5 {\n    sum += i\n    i += 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: array literal" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30]\n  Array::get(arr, 1)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: array literal length" {
  let source = "let main = () -> Int {\n  let arr = [1, 2, 3, 4, 5]\n  Array::length(arr)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: for-in sum" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30]\n  let mut sum = 0\n  for x in arr {\n    sum = sum + x\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: for-in with Array::push" {
  let source = "let main = () -> Int {\n  let src = [1, 2, 3]\n  let dst = array_new()\n  for x in src {\n    Array::push(dst, x * 10)\n  }\n  Array::get(dst, 2)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: break from while" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut result = 0\n  while i < 100 {\n    if i == 5 { break }\n    result = result + i\n    i = i + 1\n  }\n  result\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: continue in while" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut sum = 0\n  while i < 10 {\n    i = i + 1\n    if i % 2 == 0 { continue }\n    sum = sum + i\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: break in nested if" {
  let source = "let main = () -> Int {\n  let mut i = 0\n  let mut r = 0\n  while i < 100 {\n    if i > 3 {\n      if i > 5 { break }\n      r = r + i\n    }\n    i = i + 1\n  }\n  r\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: for-in with break" {
  let source = "let main = () -> Int {\n  let arr = [10, 20, 30, 40, 50]\n  let mut sum = 0\n  for x in arr {\n    if x > 30 { break }\n    sum = sum + x\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: empty array" {
  let source = "let main = () -> Int {\n  let arr = []\n  Array::length(arr)\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: nested while loops" {
  let source = "let main = () -> Int {\n  let mut sum = 0\n  let mut i = 0\n  while i < 3 {\n    let mut j = 0\n    while j < 3 {\n      sum = sum + 1\n      j = j + 1\n    }\n    i = i + 1\n  }\n  sum\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: nested function calls" {
  let source = "let add = (a: Int, b: Int) -> Int { a + b }\nlet mul = (a: Int, b: Int) -> Int { a * b }\nlet main = () -> Int { add(mul(3, 4), mul(5, 6)) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: match with function call in arm" {
  let source = "let double = (x: Int) -> Int { x * 2 }\nlet f = (x: Int) -> Int {\n  match x {\n    0 => 0,\n    _ => double(x)\n  }\n}\nlet main = () -> Int { f(21) }"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: fibonacci iterative" {
  let source = "let main = () -> Int {\n  let mut a = 0\n  let mut b = 1\n  let mut i = 0\n  while i < 10 {\n    let t = b\n    b = a + b\n    a = t\n    i = i + 1\n  }\n  a\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: complex expression" {
  let source = "let main = () -> Int {\n  let x = (3 + 4) * 2\n  let y = x / 7 + x % 7\n  y\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}

test "wasi: string equality in if" {
  let source = "let main = () -> Int {\n  let s = \"hello\"\n  if String::equals(s, \"hello\") { 1 } else { 0 }\n}"
  let bytes = compile_wasi(source, "main")
  assert_wasm(bytes)
}
