//# Imports

import ./index.vibe {
  selfbuild_probe_type_db_cache_counts
}

//# Tests

test "cache probe: TypeDb reuses warm typecheck state" {
  let encoded = selfbuild_probe_type_db_cache_counts()
  let count1 = encoded / 1000
  let count2 = encoded % 1000
  assert(count1 > 0)
  assert(eq(count2, count1))
}
