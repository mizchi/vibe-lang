//# Imports

import ./checker_stmt.vibe {
  check_program
}

import ./syntax {
  lex, parse_program
}

//# Functions

let check_source_status_impl: (String) -> Int with { Error } = (source) -> {
  let stmts = parse_program(lex(source))
  let _ = check_program(stmts)
  0
}

export let check_source_report: (String) -> String = (source) -> {
  handle {
    let _ = check_source_status_impl(source)
    "ok"
  } with Error {
    Throw(msg) => String::concat("error:", msg)
  }
}
