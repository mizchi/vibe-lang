import ./syntax/index.vibe {
  lex, parse_program
}

import ./checker/index.vibe {
  check_program
}

let check_source_status_impl = (source: String) -> Int with { Error } {
  let stmts = parse_program(lex(source))
  let _ = check_program(stmts)
  0
}

export let check_source_report = (source: String) -> String {
  handle {
    let _ = check_source_status_impl(source)
    "ok"
  } {
    Error(msg) => String::concat("error:", msg)
  }
}

0
