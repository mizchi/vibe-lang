//# Imports

// #726: standalone entry for emitting the MERGED whole program as source
// text. This tool replaces the Python flattener in
// scripts/generate_selfhost_bundle.sh: the script FS-compiles THIS entry with
// the seed (a normal multi-file compile, which itself runs the real merge
// machinery), then runs it to flatten selfhost_cli_adapter.vibe.
//
// Deliberately NOT a mode inside selfhost_cli_adapter's cli_main: adding an
// adapter -> merge_sources import edge changes the committed flat bundle's
// DFS order, which reshuffles the first-match winners of its duplicate
// top-level defs — the very fragility #726 removes. A separate entry leaves
// the adapter graph untouched during the transition; once the flattener IS
// the merge machinery, dup defs are renamed away and this ordering hazard
// disappears.

import ./entry/source_compile/wasi_only/merge_sources.vibe {
  merged_program_source_fs
}

//# Functions

let arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {
  let value = Env::args_get(index)
  if value != "" {
    value
  } else {
    Env::get(env_name)
  }
}

export let cli_main: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = String::concat("", arg_or_env(0, "VIBE_INPUT"))
  let output_path = String::concat("", arg_or_env(1, "VIBE_OUTPUT"))
  handle {
    // Bridge the Fs EFFECT (merge_sources reads imports via
    // `perform Fs::ReadFile`) to the host builtins: this tool is FS-compiled,
    // and an unhandled effect in an FS-compiled program escapes as a raw
    // exception rather than a host import (only the bundle-built adapter gets
    // export-boundary effect wiring).
    handle {
      Fs::write_file(output_path, merged_program_source_fs(input_path))
      0
    } with Fs {
      ReadFile(p) => resume(Fs::read_file(p));
      WriteFile(p, s) => resume(Fs::write_file(p, s));
      Exists(p) => resume(Fs::exists(p));
      Mkdir(p) => resume(Fs::mkdir(p))
    }
  } with Error {
    Throw(msg) => {
      Fs::write_file(String::concat(output_path, ".diag"), msg)
      1
    }
  }
}
