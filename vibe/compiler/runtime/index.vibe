//# Types

enum StringTriple {
  StringTriple(String, String, String)
}

enum TypeDbState {
  TypeDbState(
    RippleDb,
    Array[(String, TypeEnv)],
    Array[(String, String)],
    Array[StringTriple],
    Array[StringTriple],
    Array[StringTriple],
    Int,
    Int,
    Int,
    Int
  )
}

export enum TypeDb {
  TypeDb(TypeDbState)
}

//# Functions

let unwrap_db = (db: TypeDb) -> TypeDbState {
  match db {
    TypeDb(state) => state
  }
}

let wrap_db = (state: TypeDbState) -> TypeDb {
  TypeDb(state)
}

let string_to_bytes = (s: String) -> Bytes {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  } else {
    String::substring(file_path, 0, idx)
  }
}

let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  if len >= 3 {
    if String::substring(raw_path, 0, 3) == "../" {
      let rest = String::substring(raw_path, 3, len)
      let parent = dir_of(base_dir)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if parent == "" {
        resolved
      } else {
        String::concat(parent, String::concat("/", resolved))
      }
    } else if String::substring(raw_path, 0, 2) == "./" {
      let rest = String::substring(raw_path, 2, len)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if base_dir == "" {
        resolved
      } else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    } else {
      raw_path
    }
  } else if len >= 2 {
    if String::substring(raw_path, 0, 2) == "./" {
      let rest = String::substring(raw_path, 2, len)
      let resolved = if String::ends_with(rest, ".vibe") {
        rest
      } else {
        String::concat(rest, ".vibe")
      }
      if base_dir == "" {
        resolved
      } else {
        String::concat(base_dir, String::concat("/", resolved))
      }
    } else {
      raw_path
    }
  } else {
    raw_path
  }
}

let parse_program_with_path = (path: String, source: String) -> Array[Stmt] with { Error } {
  handle {
    parse_program(lex(source))
  } {
    Error(msg) => throw(String::concat(String::concat(path, ": "), msg))
  }
}

let add_dep = (acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {
  if String::length(raw_path) == 0 {
    acc
  } else {
    let resolved = resolve_path(base_dir, raw_path)
    if contains_str(acc, resolved) {
      acc
    } else {
      Array::concat(acc, [
        resolved
      ])
    }
  }
}

let empty_stack = () -> Array[String] {
  Array::slice([
    ""
  ], 0, 0)
}

let empty_dep_fps = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let empty_env_cache = () -> Array[(String, TypeEnv)] {
  Array::slice([
    ("", EnvEmpty)
  ], 0, 0)
}

let empty_string_pairs = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let empty_string_triples = () -> Array[StringTriple] {
  Array::slice([
    StringTriple("", "", "")
  ], 0, 0)
}

let empty_stmt_array = () -> Array[Stmt] {
  Array::slice([
    SExport(["_dummy"])
  ], 0, 0)
}

let empty_type_bindings = () -> Array[(String, Type)] {
  Array::slice([
    ("", CtUnknown)
  ], 0, 0)
}

export let db_new = () -> TypeDb {
  wrap_db(
    TypeDbState(
      ripple_new(),
      empty_env_cache(),
      empty_string_pairs(),
      empty_string_triples(),
      empty_string_triples(),
      empty_string_triples(),
      0,
      0,
      0,
      0
    )
  )
}

let lookup_string_pair = (pairs: Array[(String, String)], key: String) -> Option[String] {
  let len = Array::length(pairs)
  let rec go = (i: Int) -> Option[String] {
    if i >= len {
      None
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        Some(v)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

let upsert_string_pair = (
  pairs: Array[(String, String)],
  key: String,
  value: String
) -> Array[(String, String)] {
  let len = Array::length(pairs)
  let b = ArrayBuilder::new()
  let rec build = (i: Int) -> Array[(String, String)] {
    if i >= len {
      ArrayBuilder::push(b, (key, value))
      ArrayBuilder::freeze(b)
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        build(i + 1)
      } else {
        ArrayBuilder::push(b, (k, v))
        build(i + 1)
      }
    }
  }
  build(0)
}

let lookup_source_cache = (
  cache: Array[StringTriple],
  path: String,
  fingerprint: String
) -> Option[String] {
  let len = Array::length(cache)
  let rec go = (i: Int) -> Option[String] {
    if i >= len {
      None
    } else {
      match Array::get(cache, i) {
        StringTriple(p, fp, source) =>
          if p == path && fp == fingerprint {
            Some(source)
          } else {
            go(i + 1)
          }
      }
    }
  }
  go(0)
}

let upsert_source_cache = (
  cache: Array[StringTriple],
  path: String,
  fingerprint: String,
  source: String
) -> Array[StringTriple] {
  let len = Array::length(cache)
  let rec build = (i: Int, acc: Array[StringTriple]) -> Array[StringTriple] {
    if i >= len {
      acc
    } else {
      match Array::get(cache, i) {
        StringTriple(p, fp, existing) =>
          if p == path && fp == fingerprint {
            build(i + 1, acc)
          } else {
            build(i + 1, Array::concat(acc, [
              StringTriple(p, fp, existing)
            ]))
          }
      }
    }
  }
  Array::concat(build(0, empty_string_triples()), [
    StringTriple(path, fingerprint, source)
  ])
}

export let db_set_source = (db: TypeDb, path: String, source: String) -> TypeDb {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>
      wrap_db(
        TypeDbState(
          ripple_set_source(rdb, path, source),
          env_cache,
          dep_source_cache,
          merged_cache,
          module_source_cache,
          artifact_cache,
          parse_count,
          merge_count,
          module_source_count,
          codegen_count
        )
      )
  }
}

let lookup_env_cache = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let rec go = (i: Int) -> Option[TypeEnv] {
    if i >= len {
      None
    } else {
      let (p, env) = Array::get(cache, i)
      if p == path {
        Some(env)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

export let db_check_env = (db: TypeDb, path: String) -> Option[TypeEnv] {
  match unwrap_db(db) {
    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)
  }
}

let build_import_env = (stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {
  let len = Array::length(stmts)
  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, names) => {
          let resolved = resolve_path(base_dir, raw_path)
          let dep_env = match lookup_env_cache(cache, resolved) {
            Some(e) => e,
            None => EnvEmpty
          }
          let dep_bindings = env_flat_bindings(dep_env)
          let nlen = Array::length(names)
          let rec bind_names = (j: Int, nacc: TypeEnv) -> TypeEnv {
            if j >= nlen {
              nacc
            } else {
              let (name, alias) = Array::get(names, j)
              let bound_name = match alias {
                Some(a) => a,
                None => name
              }
              let ty = match env_lookup_flat(dep_bindings, name) {
                Some(t) => t,
                None => CtUnknown
              }
              bind_names(j + 1, env_bind(nacc, bound_name, ty))
            }
          }
          bind_names(0, acc)
        },
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, EnvEmpty)
}

let upsert_env_cache = (
  cache: Array[(String, TypeEnv)],
  path: String,
  env: TypeEnv
) -> Array[(String, TypeEnv)] {
  let len = Array::length(cache)
  let b = ArrayBuilder::new()
  let rec build = (i: Int) -> Array[(String, TypeEnv)] {
    if i >= len {
      ArrayBuilder::push(b, (path, env))
      ArrayBuilder::freeze(b)
    } else {
      let (p, e) = Array::get(cache, i)
      if p == path {
        build(i + 1)
      } else {
        ArrayBuilder::push(b, (p, e))
        build(i + 1)
      }
    }
  }
  build(0)
}

let compact_string_fingerprint = (source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(
    __to_string(len),
    String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2))))
  )
}

let serialize_segment = (text: String) -> String {
  String::concat(__to_string(String::length(text)), String::concat(":", text))
}

let parse_count_header = (text: String, pos: Int, terminator: Int) -> (Int, Int) with { Error } {
  let len = String::length(text)
  let mut i = pos
  while i < len && String::char_code_at(text, i) != terminator {
    i = i + 1
  }
  if i >= len {
    throw("invalid persistent type env payload")
  } else {
    (Int::parse(String::substring(text, pos, i)), i + 1)
  }
}

let parse_segment = (text: String, pos: Int) -> (String, Int) with { Error } {
  let (seg_len, start) = parse_count_header(text, pos, 58)
  let end = start + seg_len
  if end > String::length(text) {
    throw("invalid persistent type env segment")
  } else {
    (String::substring(text, start, end), end)
  }
}

let serialize_string_array = (items: Array[String]) -> String {
  let mut out = String::concat(__to_string(Array::length(items)), "[")
  let mut i = 0
  while i < Array::length(items) {
    out = String::concat(out, serialize_segment(Array::get(items, i)))
    i = i + 1
  }
  String::concat(out, "]")
}

let parse_string_array = (text: String, pos: Int) -> (Array[String], Int) with { Error } {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([""], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (item, next_cursor) = parse_segment(text, cursor)
    Array::push(items, item)
    cursor = next_cursor
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env string array")
  } else {
    (items, cursor + 1)
  }
}

let serialize_int_array = (items: Array[Int]) -> String {
  let mut out = String::concat(__to_string(Array::length(items)), "[")
  let mut i = 0
  while i < Array::length(items) {
    out = String::concat(out, serialize_segment(__to_string(Array::get(items, i))))
    i = i + 1
  }
  String::concat(out, "]")
}

let parse_int_array = (text: String, pos: Int) -> (Array[Int], Int) with { Error } {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([0], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next_cursor) = parse_segment(text, cursor)
    Array::push(items, Int::parse(raw))
    cursor = next_cursor
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env int array")
  } else {
    (items, cursor + 1)
  }
}

let serialize_bounds_array = (items: Array[(Int, Array[String])]) -> String {
  let mut out = String::concat(__to_string(Array::length(items)), "[")
  let mut i = 0
  while i < Array::length(items) {
    let (id, bounds) = Array::get(items, i)
    out = String::concat(out, serialize_segment(__to_string(id)))
    out = String::concat(out, serialize_string_array(bounds))
    i = i + 1
  }
  String::concat(out, "]")
}

let parse_bounds_array = (text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with { Error } {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([(0, Array::slice([""], 0, 0))], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw_id, next_cursor) = parse_segment(text, cursor)
    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)
    Array::push(items, (Int::parse(raw_id), bounds))
    cursor = next_cursor2
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env bounds array")
  } else {
    (items, cursor + 1)
  }
}

let rec serialize_type = (ty: Type) -> String {
  match ty {
    CtInt => "I",
    CtDouble => "D",
    CtBool => "B",
    CtString => "G",
    CtChar => "H",
    CtUnit => "U",
    CtBytes => "Y",
    CtUnknown => "X",
    CtVar(id) => String::concat("V", serialize_segment(__to_string(id))),
    CtEnum(name) => String::concat("E", serialize_segment(name)),
    CtStruct(name) => String::concat("R", serialize_segment(name)),
    CtArray(elem) => String::concat("A", serialize_type(elem)),
    CtOption(elem) => String::concat("O", serialize_type(elem)),
    CtTuple(elems) => String::concat("T", serialize_type_array(elems)),
    CtFn(params, ret, has_error) =>
      String::concat(
        "F",
        String::concat(
          serialize_segment(if has_error { "1" } else { "0" }),
          String::concat(serialize_type_array(params), serialize_type(ret))
        )
      ),
    CtNamed(name, args) =>
      String::concat("N", String::concat(serialize_segment(name), serialize_type_array(args))),
    CtForAll(vars, bounds, body) =>
      String::concat(
        "Q",
        String::concat(
          serialize_int_array(vars),
          String::concat(serialize_bounds_array(bounds), serialize_type(body))
        )
      )
  }
}

let serialize_type_array = (items: Array[Type]) -> String {
  let mut out = String::concat(__to_string(Array::length(items)), "[")
  let mut i = 0
  while i < Array::length(items) {
    out = String::concat(out, serialize_segment(serialize_type(Array::get(items, i))))
    i = i + 1
  }
  String::concat(out, "]")
}

let parse_type_array = (text: String, pos: Int) -> (Array[Type], Int) with { Error } {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([CtUnknown], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next_cursor) = parse_segment(text, cursor)
    let (item, end_cursor) = parse_cached_type(raw, 0)
    if end_cursor != String::length(raw) {
      throw("invalid persistent type env nested type")
    } else {
      Array::push(items, item)
      cursor = next_cursor
      i = i + 1
    }
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env type array")
  } else {
    (items, cursor + 1)
  }
}

let persistent_type_env_cache_text = (env: TypeEnv) -> String {
  let bindings = env_flat_bindings(env)
  let mut out = "version\t1\n"
  let mut i = 0
  while i < Array::length(bindings) {
    let (name, ty) = Array::get(bindings, i)
    out = String::concat(
      out,
      String::concat(
        "bind\t",
        String::concat(name, String::concat("\t", String::concat(serialize_type(ty), "\n")))
      )
    )
    i = i + 1
  }
  out
}

let parse_cached_type = (source: String, pos: Int) -> (Type, Int) with { Error } {
  if pos >= String::length(source) {
    throw("invalid persistent type env type")
  } else {
    let tag = String::char_code_at(source, pos)
    match tag {
      73 => (CtInt, pos + 1),
      68 => (CtDouble, pos + 1),
      66 => (CtBool, pos + 1),
      71 => (CtString, pos + 1),
      72 => (CtChar, pos + 1),
      85 => (CtUnit, pos + 1),
      89 => (CtBytes, pos + 1),
      88 => (CtUnknown, pos + 1),
      86 => {
        let (raw, next_pos) = parse_segment(source, pos + 1)
        (CtVar(Int::parse(raw)), next_pos)
      },
      69 => {
        let (name, next_pos) = parse_segment(source, pos + 1)
        (CtEnum(name), next_pos)
      },
      82 => {
        let (name, next_pos) = parse_segment(source, pos + 1)
        (CtStruct(name), next_pos)
      },
      65 => {
        let (elem, next_pos) = parse_cached_type(source, pos + 1)
        (CtArray(elem), next_pos)
      },
      79 => {
        let (elem, next_pos) = parse_cached_type(source, pos + 1)
        (CtOption(elem), next_pos)
      },
      84 => {
        let (elems, next_pos) = parse_type_array(source, pos + 1)
        (CtTuple(elems), next_pos)
      },
      70 => {
        let (raw_flag, next_pos1) = parse_segment(source, pos + 1)
        let (params, next_pos2) = parse_type_array(source, next_pos1)
        let (ret, next_pos3) = parse_cached_type(source, next_pos2)
        (CtFn(params, ret, raw_flag == "1"), next_pos3)
      },
      78 => {
        let (name, next_pos1) = parse_segment(source, pos + 1)
        let (args, next_pos2) = parse_type_array(source, next_pos1)
        (CtNamed(name, args), next_pos2)
      },
      81 => {
        let (vars, next_pos1) = parse_int_array(source, pos + 1)
        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)
        let (body, next_pos3) = parse_cached_type(source, next_pos2)
        (CtForAll(vars, bounds, body), next_pos3)
      },
      _ => throw("invalid persistent type env type tag")
    }
  }
}

let load_persistent_type_env = (fingerprint: String) -> Option[TypeEnv] with { Error, Fs } {
  let path = persistent_type_env_cache_path(fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), "\n")
    let bindings = empty_type_bindings()
    let mut version_ok = false
    let mut i = 0
    while i < Array::length(lines) {
      let line = Array::get(lines, i)
      if String::length(line) == 0 {
        ()
      } else {
        let parts = String::split(line, "\t")
        if !version_ok {
          if Array::length(parts) == 2 &&
            Array::get(parts, 0) == "version" &&
            Array::get(parts, 1) == "1" {
            version_ok = true
          } else {
            throw(String::concat("invalid persistent type env header: ", line))
          }
        } else if Array::length(parts) == 3 && Array::get(parts, 0) == "bind" {
          let raw_type = Array::get(parts, 2)
          let (ty, end_pos) = parse_cached_type(raw_type, 0)
          if end_pos != String::length(raw_type) {
            throw(String::concat("invalid persistent type env row: ", line))
          }
          Array::push(bindings, (Array::get(parts, 1), ty))
        } else {
          throw(String::concat("invalid persistent type env row: ", line))
        }
      }
      i = i + 1
    }
    if version_ok {
      Some(rebuild_persistent_type_env(bindings))
    } else {
      None
    }
  }
}

let parse_persistent_dep_list_text = (text: String) -> Array[String] with { Error } {
  let prefix = "version\t2\n"
  if String::length(text) < String::length(prefix) ||
    !(String::substring(text, 0, String::length(prefix)) == prefix) {
    throw("invalid persistent dep cache header")
  } else {
    let body = String::substring(text, String::length(prefix), String::length(text))
    let (deps, end) = parse_string_array(body, 0)
    if end != String::length(body) {
      throw("invalid persistent dep cache body")
    } else {
      deps
    }
  }
}

let persistent_dep_list_text = (deps: Array[String]) -> String {
  if Array::length(deps) == 0 {
    ""
  } else if Array::length(deps) == 1 {
    String::concat("version\t3\n", Array::get(deps, 0))
  } else {
    String::concat("version\t2\n", serialize_string_array(deps))
  }
}

let persistent_leaf_fingerprint_text = (fingerprint: String) -> String {
  String::concat("version\t1\n", String::concat(fingerprint, "\n"))
}

let load_persistent_leaf_fingerprint = (path: String, source: String) -> Option[String] with { Fs } {
  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = "version\t1\n"
    if String::length(text) > String::length(prefix) &&
      String::substring(text, 0, String::length(prefix)) == prefix {
      Some(String::substring(text, String::length(prefix), String::length(text) - 1))
    } else {
      None
    }
  }
}

let load_or_parse_deps_for_source_fs = (
  dep_source_cache: Array[(String, String)],
  path: String,
  source: String,
  parse_count: Int
) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {
  let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)
  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
  if Fs::exists(cache_path) {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = "version\t2\n"
    let single_prefix = "version\t3\n"
    if String::length(text) == 0 {
      (empty_stack(), next_dep_source_cache, parse_count)
    } else if String::length(text) >= String::length(single_prefix) &&
      String::substring(text, 0, String::length(single_prefix)) == single_prefix {
      let dep = String::substring(text, String::length(single_prefix), String::length(text))
      ([dep], next_dep_source_cache, parse_count)
    } else if String::length(text) >= String::length(prefix) &&
      String::substring(text, 0, String::length(prefix)) == prefix {
      (parse_persistent_dep_list_text(text), next_dep_source_cache, parse_count)
    } else {
      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)
      Fs::write_file(cache_path, persistent_dep_list_text(deps))
      (deps, next_dep_source_cache, next_parse_count)
    }
  } else {
    let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)
    Fs::write_file(cache_path, persistent_dep_list_text(deps))
    (deps, next_dep_source_cache, next_parse_count)
  }
}

let rebuild_persistent_type_env = (bindings: Array[(String, Type)]) -> TypeEnv {
  let mut env = EnvEmpty
  let mut i = Array::length(bindings) - 1
  while i >= 0 {
    let (name, ty) = Array::get(bindings, i)
    env = env_bind(env, name, ty)
    i = i - 1
  }
  env
}

let store_persistent_type_env = (fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {
  Fs::write_file(
    persistent_type_env_cache_path(fingerprint),
    persistent_type_env_cache_text(env)
  )
}

let build_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let (dep_path, dep_fp) = Array::get(dep_fps, i)
    let next = String::concat(
      acc,
      String::concat("|", String::concat(dep_path, String::concat("=", dep_fp)))
    )
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let db_typecheck_count = (db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)
  }
}

export let db_parse_count = (db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count
  }
}

export let db_merge_count = (db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count
  }
}

export let db_module_source_count = (db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count
  }
}

export let db_codegen_count = (db: TypeDb) -> Int {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count
  }
}

let collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {
  let len = Array::length(stmts)
  let rec go = (i: Int, acc: Array[String]) -> Array[String] {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, empty_stack())
}

let resolve_deps_for_source = (
  rdb: RippleDb,
  dep_source_cache: Array[(String, String)],
  path: String,
  source: String,
  parse_count: Int
) -> (Array[String], Array[(String, String)], Int) with { Error } {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) =>
      if cached_source == source {
        match ripple_get_deps(rdb, path) {
          Some(deps) => (deps, dep_source_cache, parse_count),
          None => {
            let stmts = parse_program_with_path(path, source)
            let deps = collect_import_deps_from_stmts(stmts, dir_of(path))
            (
              deps,
              upsert_string_pair(dep_source_cache, path, source),
              parse_count + 1
            )
          }
        }
      } else {
        let stmts = parse_program_with_path(path, source)
        let deps = collect_import_deps_from_stmts(stmts, dir_of(path))
        (
          deps,
          upsert_string_pair(dep_source_cache, path, source),
          parse_count + 1
        )
      },
    None => {
      let stmts = parse_program_with_path(path, source)
      let deps = collect_import_deps_from_stmts(stmts, dir_of(path))
      (
        deps,
        upsert_string_pair(dep_source_cache, path, source),
        parse_count + 1
      )
    }
  }
}

let resolve_deps_for_source_fs = (
  rdb: RippleDb,
  dep_source_cache: Array[(String, String)],
  path: String,
  source: String,
  parse_count: Int
) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) =>
      if cached_source == source {
        match ripple_get_deps(rdb, path) {
          Some(deps) => (deps, dep_source_cache, parse_count),
          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
        }
      } else {
        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
      },
    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
  }
}

let rec ensure_fingerprint = (
  rdb: RippleDb,
  env_cache: Array[(String, TypeEnv)],
  dep_source_cache: Array[(String, String)],
  parse_count: Int,
  path: String,
  stack: Array[String]
) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {
  if contains_str(stack, path) {
    throw(String::concat("type_db: import cycle detected at ", path))
  } else {
    match ripple_get_source(rdb, path) {
      None => (String::concat("missing:", path), rdb, env_cache, dep_source_cache, parse_count),
      Some(source) => {
        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(
          rdb,
          dep_source_cache,
          path,
          source,
          parse_count
        )
        let dlen = Array::length(deps)
        let next_stack = Array::concat(stack, [
          path
        ])
        let rec resolve_nested = (
          i: Int,
          dep_acc: Array[(String, String)],
          dep_db: RippleDb,
          dep_env_cache: Array[(String, TypeEnv)],
          dep_source_cache2: Array[(String, String)],
          dep_parse_count: Int
        ) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {
          if i >= dlen {
            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)
          } else {
            let dep_path = Array::get(deps, i)
            let (
              dep_fp,
              next_db,
              next_env_cache,
              next_dep_source_cache2,
              next_parse_count
            ) = ensure_fingerprint(
              dep_db,
              dep_env_cache,
              dep_source_cache2,
              dep_parse_count,
              dep_path,
              next_stack
            )
            resolve_nested(
              i + 1,
              Array::concat(dep_acc, [
                (dep_path, dep_fp)
              ]),
              next_db,
              next_env_cache,
              next_dep_source_cache2,
              next_parse_count
            )
          }
        }
        let (
          dep_fps,
          db_after_deps,
          env_cache_after_deps,
          dep_source_cache_after_deps,
          parse_count_after_deps
        ) = resolve_nested(
          0,
          empty_dep_fps(),
          rdb,
          env_cache,
          next_dep_source_cache,
          initial_parse_count
        )
        let fingerprint = build_fingerprint(source, dep_fps)
        match ripple_get_fingerprint(db_after_deps, path) {
          Some(cached_fp) =>
            if cached_fp == fingerprint {
              (
                fingerprint,
                db_after_deps,
                env_cache_after_deps,
                dep_source_cache_after_deps,
                parse_count_after_deps
              )
            } else {
              let stmts = parse_program_with_path(path, source)
              let final_parse_count = parse_count_after_deps + 1
              let import_env = build_import_env(stmts, dir_of(path), env_cache_after_deps)
              let checked_env = check_program_with_env(stmts, import_env)
              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)
              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)
              (
                fingerprint,
                next_db,
                next_env_cache,
                dep_source_cache_after_deps,
                final_parse_count
              )
            },
          None => {
            let stmts = parse_program_with_path(path, source)
            let final_parse_count = parse_count_after_deps + 1
            let import_env = build_import_env(stmts, dir_of(path), env_cache_after_deps)
            let checked_env = check_program_with_env(stmts, import_env)
            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)
            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)
            (
              fingerprint,
              next_db,
              next_env_cache,
              dep_source_cache_after_deps,
              final_parse_count
            )
          }
        }
      }
    }
  }
}

export let db_typecheck = (db: TypeDb, path: String) -> TypeDb with { Error } {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {
      let (
        _,
        next_rdb,
        next_env_cache,
        next_dep_source_cache,
        next_parse_count
      ) = ensure_fingerprint(
        rdb,
        env_cache,
        dep_source_cache,
        parse_count,
        path,
        empty_stack()
      )
      wrap_db(
        TypeDbState(
          next_rdb,
          next_env_cache,
          next_dep_source_cache,
          merged_cache,
          module_source_cache,
          artifact_cache,
          next_parse_count,
          merge_count,
          module_source_count,
          codegen_count
        )
      )
    }
  }
}

let rec ensure_fingerprint_fs = (
  rdb: RippleDb,
  env_cache: Array[(String, TypeEnv)],
  dep_source_cache: Array[(String, String)],
  parse_count: Int,
  path: String,
  stack: Array[String]
) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  if contains_str(stack, path) {
    throw(String::concat("type_db: import cycle detected at ", path))
  } else {
    match ripple_get_source(rdb, path) {
      None => (String::concat("missing:", path), rdb, env_cache, dep_source_cache, parse_count),
      Some(source) => {
        match load_persistent_leaf_fingerprint(path, source) {
          Some(leaf_fingerprint) =>
            match load_persistent_type_env(leaf_fingerprint) {
              Some(cached_env) => {
                let next_env_cache = upsert_env_cache(env_cache, path, cached_env)
                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())
                (
                  leaf_fingerprint,
                  next_db,
                  next_env_cache,
                  dep_source_cache,
                  parse_count
                )
              },
              None => continue_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)
            },
          None => continue_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)
        }
      }
    }
  }
}

let continue_fingerprint_fs = (
  rdb: RippleDb,
  env_cache: Array[(String, TypeEnv)],
  dep_source_cache: Array[(String, String)],
  parse_count: Int,
  path: String,
  stack: Array[String],
  source: String
) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(
    rdb,
    dep_source_cache,
    path,
    source,
    parse_count
  )
  Fs::write_file(
    persistent_dep_list_cache_path(path, compact_string_fingerprint(source)),
    persistent_dep_list_text(deps)
  )
  let dlen = Array::length(deps)
  let next_stack = Array::concat(stack, [
    path
  ])
  let dep_fps = empty_dep_fps()
  let mut db_after_deps = rdb
  let mut env_cache_after_deps = env_cache
  let mut dep_source_cache_after_deps = next_dep_source_cache
  let mut parse_count_after_deps = initial_parse_count
  let mut i = 0
  while i < dlen {
    let dep_path = Array::get(deps, i)
    let (
      dep_fp,
      next_db,
      next_env_cache,
      next_dep_source_cache2,
      next_parse_count
    ) = ensure_fingerprint_fs(
      db_after_deps,
      env_cache_after_deps,
      dep_source_cache_after_deps,
      parse_count_after_deps,
      dep_path,
      next_stack
    )
    Array::push(dep_fps, (dep_path, dep_fp))
    db_after_deps = next_db
    env_cache_after_deps = next_env_cache
    dep_source_cache_after_deps = next_dep_source_cache2
    parse_count_after_deps = next_parse_count
    i = i + 1
  }
  let fingerprint = build_fingerprint(source, dep_fps)
  match ripple_get_fingerprint(db_after_deps, path) {
    Some(cached_fp) =>
      if cached_fp == fingerprint {
        (
          fingerprint,
          db_after_deps,
          env_cache_after_deps,
          dep_source_cache_after_deps,
          parse_count_after_deps
        )
      } else {
        finish_typecheck_fs(
          db_after_deps,
          env_cache_after_deps,
          dep_source_cache_after_deps,
          parse_count_after_deps,
          path,
          source,
          deps,
          fingerprint
        )
      },
    None =>
      finish_typecheck_fs(
        db_after_deps,
        env_cache_after_deps,
        dep_source_cache_after_deps,
        parse_count_after_deps,
        path,
        source,
        deps,
        fingerprint
      )
  }
}

let finish_typecheck_fs = (
  rdb: RippleDb,
  env_cache: Array[(String, TypeEnv)],
  dep_source_cache: Array[(String, String)],
  parse_count: Int,
  path: String,
  source: String,
  deps: Array[String],
  fingerprint: String
) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {
  match load_persistent_type_env(fingerprint) {
    Some(cached_env) => {
      let next_env_cache = upsert_env_cache(env_cache, path, cached_env)
      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
    },
    None => {
      let stmts = parse_program_with_path(path, source)
      let final_parse_count = parse_count + 1
      let import_env = build_import_env(stmts, dir_of(path), env_cache)
      let checked_env = check_program_with_env(stmts, import_env)
      store_persistent_type_env(fingerprint, checked_env)
      if Array::length(deps) == 0 {
        Fs::write_file(
          persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)),
          persistent_leaf_fingerprint_text(fingerprint)
        )
      } else {
        ()
      }
      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)
      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
      (
        fingerprint,
        next_db,
        next_env_cache,
        dep_source_cache,
        final_parse_count
      )
    }
  }
}

export let db_typecheck_fs = (db: TypeDb, path: String) -> TypeDb with { Error, Fs } {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {
      let (
        _,
        next_rdb,
        next_env_cache,
        next_dep_source_cache,
        next_parse_count
      ) = ensure_fingerprint_fs(
        rdb,
        env_cache,
        dep_source_cache,
        parse_count,
        path,
        empty_stack()
      )
      wrap_db(
        TypeDbState(
          next_rdb,
          next_env_cache,
          next_dep_source_cache,
          merged_cache,
          module_source_cache,
          artifact_cache,
          next_parse_count,
          merge_count,
          module_source_count,
          codegen_count
        )
      )
    }
  }
}

export let db_program_source = (db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {
  let checked = db_typecheck(db, path)
  match unwrap_db(checked) {
    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>
      match ripple_get_source(rdb, path) {
        None => throw(String::concat("missing:", path)),
        Some(source) =>
          match ripple_get_fingerprint(rdb, path) {
            Some(fingerprint) => (source, fingerprint, checked),
            None => (source, source, checked)
          }
      }
  }
}

let build_merge_fingerprint = (sources: Array[(String, String)]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, i)
    let next = String::concat(
      acc,
      String::concat("|", compact_string_fingerprint(source))
    )
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

let build_grouped_merge_fingerprint = (group_fingerprints: Array[(String, String)]) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(group_fingerprints) {
    let (group_name, fingerprint) = Array::get(group_fingerprints, i)
    let next = String::concat(
      acc,
      String::concat("|", String::concat(group_name, String::concat("=", fingerprint)))
    )
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

let build_merged_source = (sources: Array[(String, String)]) -> String with { Error } {
  let merged = empty_stmt_array()
  let mut si = 0
  while si < Array::length(sources) {
    let (_, source) = Array::get(sources, si)
    let stmts = parse_program_with_path("(merged)", source)
    let mut j = 0
    while j < Array::length(stmts) {
      let stmt = Array::get(stmts, j)
      match stmt {
        SImport(_, _) => (),
        SReExport(_, _) => (),
        _ => Array::push(merged, stmt),
      }
      j = j + 1
    }
    si = si + 1
  }
  print_program(merged)
}

let join_group_sources = (group_sources: Array[(String, String)]) -> String {
  let len = Array::length(group_sources)
  let rec go = (i: Int, acc: String) -> String {
    if i >= len {
      acc
    } else {
      let (_, source) = Array::get(group_sources, i)
      let next = if acc == "" {
        source
      } else {
        String::concat(acc, String::concat("\n", source))
      }
      go(i + 1, next)
    }
  }
  go(0, "")
}

export let db_merged_source = (
  db: TypeDb,
  _entry_path: String,
  sources: Array[(String, String)]
) -> (String, String, TypeDb) with { Error } {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {
      let merge_fingerprint = build_merge_fingerprint(sources)
      let merge_cache_key = "merged"
      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {
        Some(merged_source) => (merged_source, merge_fingerprint, db),
        None => {
          let merged_source = build_merged_source(sources)
          let next_merged_cache = upsert_source_cache(
            merged_cache,
            merge_cache_key,
            merge_fingerprint,
            merged_source
          )
          (
            merged_source,
            merge_fingerprint,
            wrap_db(
              TypeDbState(
                rdb,
                env_cache,
                dep_source_cache,
                next_merged_cache,
                module_source_cache,
                artifact_cache,
                parse_count,
                merge_count + 1,
                module_source_count,
                codegen_count
              )
            )
          )
        }
      }
    }
  }
}

export let db_grouped_merged_source = (
  db: TypeDb,
  groups: Array[(String, Array[(String, String)])]
) -> (String, String, TypeDb) with { Error } {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {
      let rec load_groups = (
        i: Int,
        group_fingerprints: Array[(String, String)],
        group_sources: Array[(String, String)],
        cache_acc: Array[StringTriple],
        merge_count_acc: Int
      ) -> (Array[(String, String)], Array[(String, String)], Array[StringTriple], Int) with { Error } {
        if i >= Array::length(groups) {
          (group_fingerprints, group_sources, cache_acc, merge_count_acc)
        } else {
          let (group_name, sources) = Array::get(groups, i)
          let fingerprint = build_merge_fingerprint(sources)
          let cache_key = String::concat("merged-group|", group_name)
          match lookup_source_cache(cache_acc, cache_key, fingerprint) {
            Some(source) =>
              load_groups(
                i + 1,
                Array::concat(group_fingerprints, [(group_name, fingerprint)]),
                Array::concat(group_sources, [(group_name, source)]),
                cache_acc,
                merge_count_acc
              ),
            None => {
              let source = build_merged_source(sources)
              let next_cache = upsert_source_cache(cache_acc, cache_key, fingerprint, source)
              load_groups(
                i + 1,
                Array::concat(group_fingerprints, [(group_name, fingerprint)]),
                Array::concat(group_sources, [(group_name, source)]),
                next_cache,
                merge_count_acc + 1
              )
            }
          }
        }
      }
      let (group_fingerprints, group_sources, next_merged_cache, next_merge_count) = load_groups(
        0,
        empty_string_pairs(),
        empty_string_pairs(),
        merged_cache,
        merge_count
      )
      let grouped_fingerprint = build_grouped_merge_fingerprint(group_fingerprints)
      let grouped_cache_key = "merged-groups"
      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {
        Some(source) =>
          (
            source,
            grouped_fingerprint,
            wrap_db(
              TypeDbState(
                rdb,
                env_cache,
                dep_source_cache,
                next_merged_cache,
                module_source_cache,
                artifact_cache,
                parse_count,
                next_merge_count,
                module_source_count,
                codegen_count
              )
            )
          ),
        None => {
          let source = join_group_sources(group_sources)
          let final_merged_cache = upsert_source_cache(
            next_merged_cache,
            grouped_cache_key,
            grouped_fingerprint,
            source
          )
          (
            source,
            grouped_fingerprint,
            wrap_db(
              TypeDbState(
                rdb,
                env_cache,
                dep_source_cache,
                final_merged_cache,
                module_source_cache,
                artifact_cache,
                parse_count,
                next_merge_count + 1,
                module_source_count,
                codegen_count
              )
            )
          )
        }
      }
    }
  }
}

let build_module_source = (source: String) -> String with { Error } {
  let stmts = parse_program(lex(source))
  let filtered = empty_stmt_array()
  let mut i = 0
  while i < Array::length(stmts) {
    let stmt = Array::get(stmts, i)
    let keep = match stmt {
      SLet(_, _, _, _, expr) => {
        match expr {
          EFn(_, _, _, _, _, _) => true,
          _ => false
        }
      },
      _ => false
    }
    if keep {
      Array::push(filtered, stmt)
    }
    i = i + 1
  }
  print_program(filtered)
}

export let db_module_source = (db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {
      let module_cache_key = "module-source"
      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {
        Some(module_source) => (module_source, db),
        None => {
          let module_source = build_module_source(source)
          let next_module_source_cache = upsert_source_cache(
            module_source_cache,
            module_cache_key,
            fingerprint,
            module_source
          )
          (
            module_source,
            wrap_db(
              TypeDbState(
                rdb,
                env_cache,
                dep_source_cache,
                merged_cache,
                next_module_source_cache,
                artifact_cache,
                parse_count,
                merge_count,
                module_source_count + 1,
                codegen_count
              )
            )
          )
        }
      }
    }
  }
}

let artifact_cache_key = (kind: String, entry_name: String) -> String {
  String::concat(kind, String::concat("|", entry_name))
}

let bytes_to_hex_digit = (n: Int) -> String {
  if n < 10 {
    __to_string(n)
  } else if n == 10 {
    "a"
  } else if n == 11 {
    "b"
  } else if n == 12 {
    "c"
  } else if n == 13 {
    "d"
  } else if n == 14 {
    "e"
  } else {
    "f"
  }
}

let nibble_from_hex_char = (c: Int) -> Int with { Error } {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    throw("invalid hex digit")
  }
}

let bytes_to_hex = (bytes: Bytes) -> String {
  let len = Bytes::length(bytes)
  let mut i = 0
  let mut out = ""
  while i < len {
    let byte = Bytes::get(bytes, i)
    let hi = byte / 16
    let lo = byte % 16
    out = String::concat(out, bytes_to_hex_digit(hi))
    out = String::concat(out, bytes_to_hex_digit(lo))
    i = i + 1
  }
  out
}

let hex_to_bytes = (hex: String) -> Bytes with { Error } {
  let len = String::length(hex)
  if len % 2 != 0 {
    throw("invalid hex length")
  } else {
    let out = Array::slice([0], 0, 0)
    let mut i = 0
    while i < len {
      let hi = nibble_from_hex_char(String::char_code_at(hex, i))
      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))
      Array::push(out, hi * 16 + lo)
      i = i + 2
    }
    Bytes::from_array(out)
  }
}

export let db_load_artifact = (db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {
  match unwrap_db(db) {
    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>
      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {
        Some(hex) => Some(hex_to_bytes(hex)),
        None => None
      }
  }
}

export let db_store_artifact = (
  db: TypeDb,
  _path: String,
  kind: String,
  entry_name: String,
  fingerprint: String,
  bytes: Bytes
) -> TypeDb {
  match unwrap_db(db) {
    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>
      wrap_db(
        TypeDbState(
          rdb,
          env_cache,
          dep_source_cache,
          merged_cache,
          module_source_cache,
          upsert_source_cache(
            artifact_cache,
            artifact_cache_key(kind, entry_name),
            fingerprint,
            bytes_to_hex(bytes)
          ),
          parse_count,
          merge_count,
          module_source_count,
          codegen_count + 1
        )
      )
  }
}
