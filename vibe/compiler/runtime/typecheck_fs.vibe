  contains_str
}

export ./persistent_env_codec.vibe {
  load_persistent_dep_list, load_persistent_leaf_fingerprint, load_persistent_type_env, persistent_dep_list_text, persistent_leaf_fingerprint_text, persistent_type_env_cache_text
}

//# Functions

let dir_of = dir_of_path

let empty_stack: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let resolve_path = resolve_import_path

let empty_dep_fps: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}

let lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {
  let len = Array::length(cache)
  let rec go: (Int) -> Option[TypeEnv] = (i) -> {
    if i >= len {
      None
    } else {
      let (p, env) = Array::get(cache, i)
      if p == path {
        Some(env)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

let build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {
  let len = Array::length(stmts)
  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {
    if i >= len {
      acc
    } else {
      let next = match Array::get(stmts, i) {
        SImport(raw_path, names) => {
          let resolved = resolve_path(base_dir, raw_path)
          let dep_env = match lookup_env_cache(cache, resolved) {
            Some(e) => e,
            None => EnvEmpty
          }
          let dep_bindings = env_flat_bindings(dep_env)
          let nlen = Array::length(names)
          let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {
            if j >= nlen {
              nacc
            } else {
              let (name, alias) = Array::get(names, j)
              let bound_name = match alias {
                Some(a) => a,
                None => name
              }
              let ty = match env_lookup_flat(dep_bindings, name) {
                Some(t) => t,
                None => CtUnknown
              }
              bind_names(j + 1, env_bind(nacc, bound_name, ty))
            }
          }
          bind_names(0, acc)
        },
        _ => acc
      }
      go(i + 1, next)
    }
  }
  go(0, EnvEmpty)
}

let upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {
  let len = Array::length(cache)
  let b = ArrayBuilder::new()
  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {
    if i >= len {
      ArrayBuilder::push(b, (path, env))
      ArrayBuilder::freeze(b)
    } else {
      let (p, e) = Array::get(cache, i)
      if p == path {
        build(i + 1)
      } else {
        ArrayBuilder::push(b, (p, e))
        build(i + 1)
      }
    }
  }
  build(0)
}

let build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {
  let mut acc = compact_string_fingerprint(source)
  let mut i = 0
  while i < Array::length(dep_fps) {
    let dep_pair = Array::get(dep_fps, i)
    let dep_path = dep_pair.0
    let dep_fp = dep_pair.1
    let next = String::concat(acc, String::concat("|", String::concat(dep_path, String::concat("=", dep_fp))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

let copy_string_array: (Array[String]) -> Array[String] = (items) -> {
  // Iterative push: previous recursive Array::concat(acc, [x]) was
  // O(N^2) — copied the full prefix on each step.
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(items)
  while i < len {
    Array::push(out, Array::get(items, i))
    i = i + 1
  }
  out
}

let lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {
  let len = Array::length(pairs)
  let rec go: (Int) -> Option[String] = (i) -> {
    if i >= len {
      None
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        Some(v)
      } else {
        go(i + 1)
      }
    }
  }
  go(0)
}

let upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {
  let len = Array::length(pairs)
  let b = ArrayBuilder::new()
  let rec build: (Int) -> Array[(String, String)] = (i) -> {
    if i >= len {
      ArrayBuilder::push(b, (key, value))
      ArrayBuilder::freeze(b)
    } else {
      let (k, v) = Array::get(pairs, i)
      if k == key {
        build(i + 1)
      } else {
        ArrayBuilder::push(b, (k, v))
        build(i + 1)
      }
    }
  }
  build(0)
}

let parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {
  handle {
    parse_program(lex(source))
  } with Error {
    Throw(msg) => throw(String::concat(String::concat(path, ": "), msg))
  }
}

let store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {
  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))
}

let finish_typecheck_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, String, Array[String], String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, source, deps, fingerprint) -> {
  match load_persistent_type_env(fingerprint) {
    Some(cached_env) => {
      let next_env_cache = upsert_env_cache(env_cache, path, cached_env)
      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
    },
    None => {
      let stmts = parse_program_with_path(path, source)
      let final_parse_count = parse_count + 1
      let import_env = build_import_env(stmts, dir_of(path), env_cache)
      let checked_env = match import_env {
        EnvEmpty => check_program(stmts),
        _ => check_program_with_env(stmts, import_env)
      }
      store_persistent_type_env(fingerprint, checked_env)
      if Array::length(deps) == 0 {
        Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))
      } else {
        ()
      }
      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)
      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)
      (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)
    }
  }
}

let collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {
  // Iterative push: previously the recursive `Array::concat(acc, [x])`
  // copied the full prefix on each new dep — O(N^2) for files with
  // many imports.
  let out = empty_stack()
  let mut i = 0
  let len = Array::length(stmts)
  while i < len {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_path(base_dir, raw_path)
        if !contains_str(out, resolved) {
          Array::push(out, resolved)
        }
      },
      SReExport(raw_path, _) => if String::length(raw_path) > 0 {
        let resolved = resolve_path(base_dir, raw_path)
        if !contains_str(out, resolved) {
          Array::push(out, resolved)
        }
      },
      _ => ()
    }
    i = i + 1
  }
  out
}

let load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {
  match load_persistent_dep_list(path, source) {
    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),
    None => {
      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)
      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)
    }
  }
}

let resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {
  match lookup_string_pair(dep_source_cache, path) {
    Some(cached_source) =>
    if cached_source == source {
      match ripple_get_deps(rdb, path) {
        Some(deps) => (deps, dep_source_cache, parse_count),
        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
      }
    } else {
      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
    },
    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)
  }
}

let rec ensure_fingerprint_fs_go: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {
  if contains_str(stack, path) {
    throw(String::concat("type_db: import cycle detected at ", path))
  } else {
    match ripple_get_source(rdb, path) {
      None => (String::concat("missing:", path), rdb, env_cache, dep_source_cache, parse_count),
      Some(source) => match load_persistent_leaf_fingerprint(path, source) {
        Some(leaf_fingerprint) =>
        match load_persistent_type_env(leaf_fingerprint) {
          Some(cached_env) => {
            let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
            if !(Fs::exists(dep_cache_path)) {
              Fs::write_file(dep_cache_path, persistent_dep_list_text(empty_stack()))
            } else {
              ()
            }
            let next_env_cache = upsert_env_cache(env_cache, path, cached_env)
            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())
            (leaf_fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)
          },
          None =>
          continue_fingerprint_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)
        },
        None =>
        continue_fingerprint_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)
      }
    }
  }
}

export let ensure_fingerprint_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {
  ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)
}

let continue_fingerprint_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String], String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack, source) -> {
  let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)
  let deps = copy_string_array(deps_raw)
  Fs::write_file(persistent_dep_list_cache_path(path, compact_string_fingerprint(source)), persistent_dep_list_text(deps))
  let dlen = Array::length(deps)
  // Cycle-detection stack: push self before recursing, truncate back after.
  // O(1) per frame vs. previous Array::concat(stack, [path]) which was O(depth) per frame.
  let saved_stack_len = Array::length(stack)
  Array::push(stack, path)
  let mut i = 0
  let mut db_after_deps = rdb
  let mut env_cache_after_deps = env_cache
  let mut dep_source_cache_after_deps = next_dep_source_cache
  let mut parse_count_after_deps = initial_parse_count
  let dep_fps = empty_dep_fps()
  while i < dlen {
    let dep_path = Array::get(deps, i)
    let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)
    db_after_deps = next_db
    env_cache_after_deps = next_env_cache
    dep_source_cache_after_deps = next_dep_source_cache2
    parse_count_after_deps = next_parse_count
    Array::push(dep_fps, (dep_path, dep_fp))
    i = i + 1
  }
  Array::truncate(stack, saved_stack_len)
  let fingerprint = build_fingerprint(source, dep_fps)
  match ripple_get_fingerprint(db_after_deps, path) {
    Some(cached_fp) =>
    if cached_fp == fingerprint {
      (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)
    } else {
      finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
    },
    None =>
    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)
  }
}
