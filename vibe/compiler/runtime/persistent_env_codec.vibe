//# Imports

import .. / cache / persistent_cache.vibe {
  compact_string_fingerprint, normalize_persistent_cache_text, persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path, persistent_type_env_cache_path
}

import .. / core {
  Type, TypeEnv, env_flat_bindings
}

//# Functions

let parse_int_unwrap: (String, Int) -> Int = (raw, fallback) -> {
  let len = String::length(raw)
  let mut result = 0
  let mut i = 0
  let mut neg = false
  let mut valid = true
  if len == 0 { valid = false }
  if valid {
    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }
  }
  while valid {
    if i >= len { break }
    let c = String::char_code_at(raw, i)
    if c < 48 { valid = false }
    else if c > 57 { valid = false }
    else {
      result = result * 10 + (c - 48)
      i = i + 1
    }
  }
  if valid {
    if neg { 0 - result } else result
  } else fallback
}

let serialize_segment: (String) -> String = (text) -> {
  let len = String::length(text)
  let len_str = __to_string(len)
  let colon_text = String::concat(":", text)
  String::concat(len_str, colon_text)
}

let decode_effect_name: (String) -> String = (raw) -> {
  if raw == "" || raw == "0" {
    ""
  } else if raw == "1" {
    "Error"
  } else {
    raw
  }
}

let parse_count_header: (String, Int, Int) -> (Int, Int) with { Error } = (text, pos, terminator) -> {
  let len = String::length(text)
  let mut i = pos
  while i < len && String::char_code_at(text, i) != terminator {
    i = i + 1
  }
  if i >= len {
    throw("invalid persistent type env payload")
  } else {
    let parsed = parse_int_unwrap(text[pos: i], 0)
    (parsed, i + 1)
  }
}

let parse_segment: (String, Int) -> (String, Int) with { Error } = (text, pos) -> {
  let (seg_len, start) = parse_count_header(text, pos, 58)
  let end = start + seg_len
  if end > String::length(text) {
    throw("invalid persistent type env segment")
  } else {
    (text[start: end], end)
  }
}

let parse_int_array: (String, Int) -> (Array[Int], Int) with { Error } = (text, pos) -> {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([
    0
  ], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw, next_cursor) = parse_segment(text, cursor)
    let parsed_val = parse_int_unwrap(raw, 0)
    Array::push(items, parsed_val)
    cursor = next_cursor
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env int array")
  } else {
    (items, cursor + 1)
  }
}

let parse_string_array: (String, Int) -> (Array[String], Int) with { Error } = (text, pos) -> {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (item, next_cursor) = parse_segment(text, cursor)
    Array::push(items, item)
    cursor = next_cursor
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env string array")
  } else {
    (items, cursor + 1)
  }
}

let parse_bounds_array: (String, Int) -> (Array[(Int, Array[String])], Int) with { Error } = (text, pos) -> {
  let (count, start) = parse_count_header(text, pos, 91)
  let items = Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let mut i = 0
  let mut cursor = start
  while i < count {
    let (raw_id, next_cursor) = parse_segment(text, cursor)
    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)
    let parsed_id = parse_int_unwrap(raw_id, 0)
    Array::push(items, (parsed_id, bounds))
    cursor = next_cursor2
    i = i + 1
  }
  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
    throw("invalid persistent type env bounds array")
  } else {
    (items, cursor + 1)
  }
}

let rec parse_cached_type: (String, Int) -> (Type, Int) with { Error } = (source, pos) -> {
  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {
    let (count, start) = parse_count_header(text, pos, 91)
    let items = Array::slice([
      CtUnknown
    ], 0, 0)
    let mut i = 0
    let mut cursor = start
    while i < count {
      let (raw, next_cursor) = parse_segment(text, cursor)
      let (item, end_cursor) = parse_cached_type(raw, 0)
      if end_cursor != String::length(raw) {
        throw("invalid persistent type env nested type")
      } else {
        Array::push(items, item)
        cursor = next_cursor
        i = i + 1
      }
    }
    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {
      throw("invalid persistent type env type array")
    } else {
      (items, cursor + 1)
    }
  }
  if pos >= String::length(source) {
    throw("invalid persistent type env type")
  } else {
    let tag = String::char_code_at(source, pos)
    match tag {
      73 => (CtInt, pos + 1),
      68 => (CtDouble, pos + 1),
      66 => (CtBool, pos + 1),
      71 => (CtString, pos + 1),
      72 => (CtChar, pos + 1),
      85 => (CtUnit, pos + 1),
      89 => (CtBytes, pos + 1),
      88 => (CtUnknown, pos + 1),
      86 => {
        let (raw, next_pos) = parse_segment(source, pos + 1)
        let var_id = parse_int_unwrap(raw, 0)
        (CtVar(var_id), next_pos)
      },
      69 => {
        let (name, next_pos) = parse_segment(source, pos + 1)
        (CtEnum(name), next_pos)
      },
      82 => {
        let (name, next_pos) = parse_segment(source, pos + 1)
        (CtStruct(name), next_pos)
      },
      65 => {
        let (elem, next_pos) = parse_cached_type(source, pos + 1)
        (CtArray(elem), next_pos)
      },
      79 => {
        let (elem, next_pos) = parse_cached_type(source, pos + 1)
        (CtOption(elem), next_pos)
      },
      84 => {
        let (elems, next_pos) = parse_type_array(source, pos + 1)
        (CtTuple(elems), next_pos)
      },
      70 => {
        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)
        let (params, next_pos2) = parse_type_array(source, next_pos1)
        let (ret, next_pos3) = parse_cached_type(source, next_pos2)
        let eff_raw = decode_effect_name(raw_effect)
        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }
        (CtFn(params, ret, eff_name), next_pos3)
      },
      78 => {
        let (name, next_pos1) = parse_segment(source, pos + 1)
        let (args, next_pos2) = parse_type_array(source, next_pos1)
        (CtNamed(name, args), next_pos2)
      },
      81 => {
        let (vars, next_pos1) = parse_int_array(source, pos + 1)
        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)
        let (body, next_pos3) = parse_cached_type(source, next_pos2)
        (CtForAll(vars, bounds, body), next_pos3)
      },
      _ => throw("invalid persistent type env type tag")
    }
  }
}

// All `serialize_*_array` helpers below used a `String::concat(out, ...)`
// accumulator that was O(N²) over the array length. Cache-serialisation
// runs them on every TypeEnv save, and large modules hit thousands of
// bindings — the cumulative cost shows up in `vibe check` cold runs.
// StringBuilder collapses each one to O(N).
let serialize_int_array: (Array[Int]) -> String = (items) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

let serialize_effect_name_str: (String) -> String = (effect_name) -> {
  effect_name
}

let serialize_string_array: (Array[String]) -> String = (items) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

let serialize_bounds_array: (Array[(Int, Array[String])]) -> String = (items) -> {
  let buf = StringBuilder::new()
  StringBuilder::push(buf, __to_string(Array::length(items)))
  StringBuilder::push(buf, "[")
  let mut i = 0
  while i < Array::length(items) {
    let (id, bounds) = Array::get(items, i)
    StringBuilder::push(buf, serialize_segment(__to_string(id)))
    StringBuilder::push(buf, serialize_string_array(bounds))
    i = i + 1
  }
  StringBuilder::push(buf, "]")
  StringBuilder::freeze(buf)
}

let rec serialize_type: (Type) -> String = (ty) -> {
  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {
    let buf = StringBuilder::new()
    StringBuilder::push(buf, __to_string(Array::length(items)))
    StringBuilder::push(buf, "[")
    let mut i = 0
    while i < Array::length(items) {
      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))
      i = i + 1
    }
    StringBuilder::push(buf, "]")
    StringBuilder::freeze(buf)
  }
  match ty {
    CtInt => "I",
    CtDouble => "D",
    CtBool => "B",
    CtString => "G",
    CtChar => "H",
    CtUnit => "U",
    CtBytes => "Y",
    CtUnknown => "X",
    CtVar(id) => String::concat("V", serialize_segment(__to_string(id))),
    CtEnum(name) => String::concat("E", serialize_segment(name)),
    CtStruct(name) => String::concat("R", serialize_segment(name)),
    CtArray(elem) => String::concat("A", serialize_type(elem)),
    CtOption(elem) => String::concat("O", serialize_type(elem)),
    CtTuple(elems) => String::concat("T", serialize_type_array(elems)),
    CtFn(params, ret, effect_name) => {
      let eff_str = if effect_name is Some(n) { n } else { "" }
      String::concat("F", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))
    },
    CtNamed(name, args) =>
    String::concat("N", String::concat(serialize_segment(name), serialize_type_array(args))),
    CtForAll(vars, bounds, body) =>
    String::concat("Q", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))
  }
}

export let persistent_dep_list_text: (Array[String]) -> String = (deps) -> {
  if Array::length(deps) == 0 {
    ""
  } else if Array::length(deps) == 1 {
    String::concat("version\t3\n", Array::get(deps, 0))
  } else {
    String::concat("version\t2\n", serialize_string_array(deps))
  }
}

export let load_persistent_dep_list: (String, String) -> Option[Array[String]] with { Error, Fs } = (path, source) -> {
  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    if String::length(text) == 0 {
      Some(Array::slice([
        ""
      ], 0, 0))
    } else {
      let v2_prefix = "version\t2\n"
      let v3_prefix = "version\t3\n"
      let text_len = String::length(text)
      let v2_len = String::length(v2_prefix)
      let v3_len = String::length(v3_prefix)
      if text_len >= v2_len &&
      text[0: v2_len] == v2_prefix {
        let body = text[v2_len: text_len]
        let (deps, end_pos) = parse_string_array(body, 0)
        if end_pos == String::length(body) {
          Some(deps)
        } else {
          throw(String::concat("invalid persistent dep list body: ", cache_path))
        }
      } else if text_len >= v3_len &&
      text[0: v3_len] == v3_prefix {
        let dep = text[v3_len: text_len]
        if String::length(dep) == 0 {
          Some(Array::slice([
            ""
          ], 0, 0))
        } else {
          Some([dep])
        }
      } else {
        throw(String::concat("invalid persistent dep list header: ", cache_path))
      }
    }
  }
}

let rebuild_persistent_type_env: (Array[(String, Type)]) -> TypeEnv = (bindings) -> {
  EnvFlat(bindings)
}

export let load_persistent_type_env: (String) -> Option[TypeEnv] with { Error, Fs } = (fingerprint) -> {
  let path = persistent_type_env_cache_path(fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), "\n")
    let len = Array::length(lines)
    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {
      if index >= len {
        if version_ok {
          Some(rebuild_persistent_type_env(bindings))
        } else {
          None
        }
      } else {
        let line = Array::get(lines, index)
        if String::length(line) == 0 {
          go(index + 1, version_ok, bindings)
        } else {
          let parts = String::split(line, "\t")
          if !version_ok {
            if Array::length(parts) == 2 &&
            Array::get(parts, 0) == "version" &&
            Array::get(parts, 1) == "1" {
              go(index + 1, true, bindings)
            } else {
              throw(String::concat("invalid persistent type env header: ", line))
            }
          } else if Array::length(parts) == 3 && Array::get(parts, 0) == "bind" {
            let raw_type = Array::get(parts, 2)
            let (ty, end_pos) = parse_cached_type(raw_type, 0)
            if end_pos != String::length(raw_type) {
              throw(String::concat("invalid persistent type env bind row: ", line))
            } else {
              // Was `Array::concat(bindings, [tuple])` — O(N) copy per
              // row, O(N²) over the file. Linear-recursive accumulation
              // through `go`, so push-mutating the shared `bindings`
              // is equivalent to the per-call rebuild.
              Array::push(bindings, (Array::get(parts, 1), ty))
              go(index + 1, true, bindings)
            }
          } else {
            throw(String::concat("invalid persistent type env row: ", line))
          }
        }
      }
    }
    go(0, false, Array::slice([
      ("", CtUnknown)
    ], 0, 0))
  }
}

export let persistent_type_env_cache_text: (TypeEnv) -> String = (env) -> {
  let bindings = env_flat_bindings(env)
  // StringBuilder over the bindings list — was O(N²) via `out =
  // String::concat(out, ...)` for N bindings.
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "version\t1\n")
  let mut i = 0
  while i < Array::length(bindings) {
    let (name, ty) = Array::get(bindings, i)
    StringBuilder::push(buf, "bind\t")
    StringBuilder::push(buf, name)
    StringBuilder::push(buf, "\t")
    StringBuilder::push(buf, serialize_type(ty))
    StringBuilder::push(buf, "\n")
    i = i + 1
  }
  StringBuilder::freeze(buf)
}

export let load_persistent_leaf_fingerprint: (String, String) -> Option[String] with { Error, Fs } = (path, source) -> {
  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))
    let prefix = "version\t1\n"
    if String::length(text) > String::length(prefix) &&
    text[0: String::length(prefix)] == prefix {
      Some(String::substring(text, String::length(prefix), String::length(text) - 1))
    } else {
      None
    }
  }
}

export let persistent_leaf_fingerprint_text: (String) -> String = (fingerprint) -> {
  String::concat("version\t1\n", String::concat(fingerprint, "\n"))
}
