// Debug probe: lex only
export let selfbuild_probe_lex: () -> Int with { Error } = () -> {
  let tokens = lex("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  Array::length(tokens)
}

// Debug probe: parse only
export let selfbuild_probe_parse: () -> Int with { Error } = () -> {
  let tokens = lex("let add: (Int, Int) -> Int = (a, b) -> { a + b }")
  let stmts = parse_program(tokens)
  Array::length(stmts)
}

