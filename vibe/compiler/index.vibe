}

let probe_parse_source = (source: String) -> Int with { Error } {
  let stmts = parse_program(lex(source))
  Array::length(stmts)
}

let probe_check_source = (source: String) -> Int with { Error } {
  let stmts = parse_program(lex(source))
  let _ = check_program(stmts)
  1
}

let probe_compile_source_len = (source: String, entry_name: String) -> Int with { Error } {
  let bytes = compile_source_wasi_only(source, entry_name)
  Bytes::length(bytes)
}

let probe_parse_stmt_progress_source = (source: String) -> Int with { Error } {
  let tokens = lex(source)
  let mut pos = 0
  let mut stmt_index = 0
  let mut result = -1
  let mut done = false
  while !done {
    if pos >= Array::length(tokens) {
      result = stmt_index * 100000 + pos
      done = true
    } else {
      match Array::get(tokens, pos) {
        TEof => {
          result = stmt_index * 100000 + pos
          done = true
        },
        _ => {
          handle {
            let (_, next) = parse_stmt(tokens, pos)
            pos = next
            stmt_index = stmt_index + 1
          } {
            Error(_) => {
              result = stmt_index * 100000 + pos
              done = true
            }
          }
        }
      }
    }
  }
  result
}

let probe_parse_sources_first_failure = (sources: Array[(String, String)]) -> Int with { Error } {
  let mut i = 0
  let mut result = -1
  while i < Array::length(sources) && result < 0 {
    let (_, source) = Array::get(sources, i)
    handle {
      let _ = parse_program(lex(source))
      ()
    } {
      Error(_) => {
        result = i * 1000000 + probe_parse_stmt_progress_source(source)
      }
    }
    i = i + 1
  }
  result
}

