// Lightweight entry for WASI _start/run wrapper.
export let selfbuild_entry = () -> Int { 0 }

// selfbuild helper: use the selfhost compiler's own compile pipeline to compile stage2.
export let selfbuild_compile_stage2 = () -> Bytes with { Error } {
  let sources = selfhost_sources()
  // Guard: if selfhost_sources() returns empty (stub in selfhost codegen),
  // fail early so the selfbuild gate falls back to the seed compiler.
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let merged_stmts = collect_merged_stmts(sources)
  compile_wasi_module(merged_stmts, "selfbuild_entry")
}

// Debug probe: lex only
export let selfbuild_probe_lex = () -> Int with { Error } {
  let tokens = lex("let add = (a: Int, b: Int) -> Int { a + b }")
  Array::length(tokens)
}

// Debug probe: parse only
export let selfbuild_probe_parse = () -> Int with { Error } {
  let tokens = lex("let add = (a: Int, b: Int) -> Int { a + b }")
  let stmts = parse_program(tokens)
  Array::length(stmts)
}

// Debug probe: check only
export let selfbuild_probe_check = () -> Int with { Error } {
  let tokens = lex("let add = (a: Int, b: Int) -> Int { a + b }")
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  1
}

// Debug probe: compile
export let selfbuild_probe_compile = () -> Int with { Error } {
  let bytes = compile_source("let add = (a: Int, b: Int) -> Int { a + b }")
  Bytes::length(bytes)
}

// Debug probe: parse_count
export let selfbuild_probe_parse_count = () -> Int with { Error } {
  let tokens = lex("let x = 42")
  let num_tokens = Array::length(tokens)
  let stmts = parse_program(tokens)
  let num_stmts = Array::length(stmts)
  num_tokens * 1000 + num_stmts
}

// Debug probe: token tag
export let selfbuild_probe_token_tag = () -> Int with { Error } {
  let tokens = lex("let x = 42")
  let first = Array::get(tokens, 0)
  let tag = match first {
    TLet => 1,
    TEof => 2,
    _ => 0
  }
  Array::length(tokens) * 100 + tag
}

// Debug probe: deep if-else chain
export let selfbuild_probe_deep_if = () -> Int with { Error } {
  let c = 40
  let result = if c == 43 { 1 }
    else if c == 45 { 2 }
    else if c == 42 { 3 }
    else if c == 47 { 4 }
    else if c == 37 { 5 }
    else if c == 61 { 6 }
    else if c == 33 { 7 }
    else if c == 60 { 8 }
    else if c == 62 { 9 }
    else if c == 38 { 10 }
    else if c == 124 { 11 }
    else if c == 94 { 12 }
    else if c == 40 { 13 }
    else if c == 41 { 14 }
    else if c == 123 { 15 }
    else 0
  result
}

// Debug probe: char code at position 10
export let selfbuild_probe_char_at = () -> Int with { Error } {
  let s = "let add = (a: Int, b: Int) -> Int { a + b }"
  String::char_code_at(s, 10)
}

// Debug probe: fn_count in merged stmts
export let selfbuild_probe_fn_count = () -> Int with { Error } {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  let mut count = 0
  let mut i = 0
  while i < Array::length(merged) {
    let stmt = Array::get(merged, i)
    match stmt {
      SLet(_, _, name, _, expr) => {
        match expr {
          EFn(_, _, _, _, _, _) => { count = count + 1 },
          _ => ()
        }
      },
      _ => ()
    }
    i = i + 1
  }
  count
}

// Debug probe: selfhost_sources length
export let selfbuild_probe_sources_len = () -> Int with { Error } {
  let sources = selfhost_sources()
  Array::length(sources)
}

// Debug probe: merged stmts length
export let selfbuild_probe_merged_len = () -> Int with { Error } {
  let sources = selfhost_sources()
  let merged = collect_merged_stmts(sources)
  Array::length(merged)
}

let selfbuild_probe_compile_first = (n: Int) -> Int with { Error } {
  let sources = selfhost_sources()
  let first = Array::slice(sources, 0, n)
  let merged = collect_merged_stmts(first)
  let entry_tokens = lex("export let __probe_entry = () -> Int { 0 }")
  let entry_stmts = parse_program(entry_tokens)
  let mut j = 0
  while j < Array::length(entry_stmts) { Array::push(merged, Array::get(entry_stmts, j)); j = j + 1 }
  let bytes = compile_wasi_module(merged, "__probe_entry")
  Bytes::length(bytes)
}

// Binary search: compile first N source files
export let selfbuild_probe_compile_first_5 = () -> Int with { Error } {
  selfbuild_probe_compile_first(5)
}

