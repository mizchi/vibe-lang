let probe_lex_selfhost_source = (path: String) -> Int with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let source = lookup_selfhost_source(sources, path)
  let tokens = lex(source)
  Array::length(tokens)
}

let probe_parse_stmt_progress_selfhost_source = (path: String) -> Int with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let source = lookup_selfhost_source(sources, path)
  let tokens = lex(source)
  let mut pos = 0
  let mut stmt_index = 0
  let mut result = -1
  let mut done = false
  while !done {
    if pos >= Array::length(tokens) {
      result = stmt_index * 100000 + pos
      done = true
    } else {
      match Array::get(tokens, pos) {
        TEof => {
          result = stmt_index * 100000 + pos
          done = true
        },
        _ => {
          handle {
            let (_, next) = parse_stmt(tokens, pos)
            pos = next
            stmt_index = stmt_index + 1
          } {
            Error(_) => {
              result = stmt_index * 100000 + pos
              done = true
            }
          }
        }
      }
    }
  }
  result
}

let probe_parse_import_stmt = (source: String) -> Int with { Error } {
  let tokens = lex(source)
  let (_, next) = parse_stmt(tokens, 0)
  next
}

let probe_lex_source = (source: String) -> Int with { Error } {
