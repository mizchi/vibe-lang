  Bytes::length(bytes)
}

export let selfbuild_probe_cli_args_read_len: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = if perform Env::ArgsLen > 0 { perform Env::ArgsGet(0) } else { "" }
  let source = perform Fs::ReadFile(input_path)
  String::length(source)
}

export let selfbuild_probe_cli_args_compile_len: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = if perform Env::ArgsLen > 0 { perform Env::ArgsGet(0) } else { "" }
  let entry_name = if perform Env::ArgsLen > 2 { perform Env::ArgsGet(2) } else { "" }
  let source = perform Fs::ReadFile(input_path)
  let bytes = compile_source_wasi_only(source, entry_name)
  Bytes::length(bytes)
}

export let selfbuild_cli_args_entry: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = if perform Env::ArgsLen > 0 { perform Env::ArgsGet(0) } else { "" }
  let output_path = if perform Env::ArgsLen > 1 { perform Env::ArgsGet(1) } else { "" }
  let entry_name = if perform Env::ArgsLen > 2 { perform Env::ArgsGet(2) } else { "" }
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else {
    let source = perform Fs::ReadFile(input_path)
    let bytes = compile_source_wasi_only(source, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
}

export let selfbuild_cli_entry: () -> Int with { Error, Fs } = () -> {
  let input_path = "_build/bench/selfhost_cli_adapter/adapter_input.vibe"
  let output_path = "_build/bench/selfhost_cli_adapter/adapter_output.wasm"
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else {
    let (bytes, _) = compile_file_fs_cached(db_new(), input_path, "main")
    Fs::write_bytes(output_path, bytes)
    0
  }
}

// selfbuild helper: use the selfhost compiler's own compile pipeline to compile stage2.
export let selfbuild_compile_stage2: () -> Bytes with { Error } = () -> {
  let main_source = selfbuild_runtime_entry_source()
  if main_source == "" { throw("selfbuild_runtime_entry_source is empty") }
  compile_source_wasi_only(main_source, "selfbuild_entry")
}

export let selfbuild_compile_cli_adapter: () -> Bytes with { Error } = () -> {
  build_selfhost_cli_adapter_bytes()
}

