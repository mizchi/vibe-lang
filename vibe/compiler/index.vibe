let build_selfhost_cli_adapter_bytes = () -> Bytes with { Error } {
  let adapter_path = "vibe/compiler/selfhost_cli_adapter.vibe"
  let sources = selfhost_sources()
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let adapter_source = lookup_selfhost_source(sources, adapter_path)
  let (bytes, _) = compile_with_modules_wasi_cached(
    db_new(),
    adapter_source,
    adapter_path,
    sources,
    "cli_main"
  )
  bytes
}

let compile_selfhost_cli_adapter_to = (output_path: String) -> Int with { Error, Fs } {
  if String::equals(output_path, "") {
    1
  } else {
    let bytes = build_selfhost_cli_adapter_bytes()
    Fs::write_bytes(output_path, bytes)
    0
  }
}

let selfhost_cli_trigger_path = "_build/bench/selfhost_cli_adapter/.compile_cli_trigger"
let selfhost_cli_stage1_path = "_build/bench/selfhost_cli_adapter/selfhost_cli_stage1.wasm"

// Lightweight entry for WASI _start/run wrapper.
export let selfbuild_entry = () -> Int with { Error, Fs } {
  handle {
    if Fs::exists(selfhost_cli_trigger_path) {
      compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)
    } else {
      0
    }
  } {
    Error(_) => 0
  }
}

export let selfbuild_cli_entry = () -> Int with { Error, Fs } {
  let input_path = "_build/bench/selfhost_cli_adapter/adapter_input.vibe"
  let output_path = "_build/bench/selfhost_cli_adapter/adapter_output.wasm"
  if String::equals(input_path, "") {
    1
  }
  else if String::equals(output_path, "") {
    1
  }
  else {
    let (bytes, _) = compile_file_fs_cached(db_new(), input_path, "main")
    Fs::write_bytes(output_path, bytes)
    0
  }
}

// selfbuild helper: use the selfhost compiler's own compile pipeline to compile stage2.
export let selfbuild_compile_stage2 = () -> Bytes with { Error } {
  let sources = selfhost_sources()
  // Guard: if selfhost_sources() returns empty (stub in selfhost codegen),
  // fail early so the selfbuild gate falls back to the seed compiler.
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let merged_stmts = collect_merged_stmts(sources)
  compile_wasi_module(merged_stmts, "selfbuild_entry")
}

let lookup_selfhost_source = (sources: Array[(String, String)], path: String) -> String with { Error } {
  let mut i = 0
  let mut found = false
  let mut result = ""
  while i < Array::length(sources) && !found {
    let (candidate_path, source) = Array::get(sources, i)
    if String::equals(candidate_path, path) {
      result = source
      found = true
    }
    i = i + 1
  }
  if found {
    result
  } else {
    throw(String::concat("selfhost source not found: ", path))
  }
}

let load_cli_adapter_merged_source = () -> String with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let adapter_path = "vibe/compiler/selfhost_cli_adapter.vibe"
  let adapter_source = lookup_selfhost_source(sources, adapter_path)
  let prepared = prepare_modules_cached(db_new(), adapter_path, adapter_source, sources)
  let (merged_source, _, _) = db_merged_source(prepared, adapter_path, sources)
  merged_source
}

let load_cli_adapter_program_source = () -> String with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let adapter_path = "vibe/compiler/selfhost_cli_adapter.vibe"
  let adapter_source = lookup_selfhost_source(sources, adapter_path)
  let prepared = prepare_modules_cached(db_new(), adapter_path, adapter_source, sources)
  let (program_source, _, _) = db_program_source(prepared, adapter_path)
  program_source
}

let find_unexpected_control_char = (source: String) -> Int {
  let len = String::length(source)
  let mut i = 0
  let mut result = -1
  while i < len && result < 0 {
    let c = String::char_code_at(source, i)
    let allowed = c == 9 || c == 10 || c == 13 || c >= 32
    if !allowed {
      result = i * 1000 + c
    }
    i = i + 1
  }
  result
}

let probe_prepare_source = (main_source: String, main_path: String) -> Int with { Error } {
  let sources = selfhost_sources()
  if Array::length(sources) == 0 { throw("selfhost_sources is empty (stub)") }
  let prepared = prepare_modules_cached(db_new(), main_path, main_source, sources)
  db_typecheck_count(prepared)
}

