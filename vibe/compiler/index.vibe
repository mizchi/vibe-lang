export let selfbuild_probe_type_db_cache_counts = () -> Int with { Error } {
  let main_source = "let main = () -> Int { 1 + 2 }"
  let db1 = db_set_source(db_new(), "main.vibe", main_source)
  let db2 = db_typecheck(db1, "main.vibe")
  let count1 = db_typecheck_count(db2)
  let db3 = db_typecheck(db2, "main.vibe")
  let count2 = db_typecheck_count(db3)
  count1 * 1000 + count2
}

export let selfbuild_probe_type_db_fs_parse_counts = () -> Int with { Error, Fs } {
  let nonce_path = "_build/persistent_type_env_probe_nonce.txt"
  let prev_nonce = if Fs::exists(nonce_path) { perform Fs::ReadFile(nonce_path) } else { "" }
  let nonce = __to_string(String::length(prev_nonce) + 1)
  Fs::write_bytes(nonce_path, string_to_bytes(String::concat(prev_nonce, "x")))
  let helper_path = String::concat(
    "_build/persistent_type_env_probe_helper_",
    String::concat(nonce, ".vibe")
  )
  let main_path = String::concat(
    "_build/persistent_type_env_probe_main_",
    String::concat(nonce, ".vibe")
  )
  let helper_name = String::substring(
    helper_path,
    String::last_index_of(helper_path, "/") + 1,
    String::length(helper_path)
  )
  let helper_source = String::concat("export let add = () -> Int { 1 }\n// ", nonce)
  let main_source = String::concat(
    "import ./",
    String::concat(
      helper_name,
      String::concat(" { add }\nlet run = () -> Int { add() }\n// ", nonce)
    )
  )
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  let db1 = db_typecheck_fs(
    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),
    main_path
  )
  let count1 = db_parse_count(db1)
  let db2 = db_typecheck_fs(
    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),
    main_path
  )
  let count2 = db_parse_count(db2)
  count1 * 1000 + count2
}

export let selfbuild_probe_type_db_group_merge_counts = () -> Int with { Error } {
  let groups = [
    ("core", [("helpers.vibe", "export let add = (a: Int, b: Int) -> Int { a + b }")]),
    ("entry", [("main.vibe", "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }")])
  ]
  let result1 = db_grouped_merged_source(db_new(), groups)
  let db1 = result1.2
  let count1 = db_merge_count(db1)
  let result2 = db_grouped_merged_source(db1, groups)
  let db2 = result2.2
  let count2 = db_merge_count(db2)
  count1 * 1000 + count2
}

export let selfbuild_probe_type_db_module_source_counts = () -> Int with { Error } {
  let main_source = "let main = () -> Int { 1 + 2 }"
  let sources = Array::slice([
