// Debug probe: warm TypeDb typecheck count1/count2 packed as count1*1000+count2
export let selfbuild_probe_type_db_cache_counts = () -> Int with { Error } {
  let main_source = "let main = () -> Int { 1 + 2 }"
  let db1 = db_set_source(db_new(), "main.vibe", main_source)
  let db2 = db_typecheck(db1, "main.vibe")
  let count1 = db_typecheck_count(db2)
  let db3 = db_typecheck(db2, "main.vibe")
  let count2 = db_typecheck_count(db3)
  count1 * 1000 + count2
}

export let selfbuild_probe_type_db_parse_counts = () -> Int with { Error } {
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }"
  let sources = [("helpers.vibe", helper_source)]
  let db1 = prepare_modules_cached(db_new(), "main.vibe", main_source, sources)
  let count1 = db_parse_count(db1)
  let db2 = prepare_modules_cached(db1, "main.vibe", main_source, sources)
  let count2 = db_parse_count(db2)
  count1 * 1000 + count2
}

export let selfbuild_probe_type_db_merge_counts = () -> Int with { Error } {
  let sources = [
    ("helpers.vibe", "export let add = (a: Int, b: Int) -> Int { a + b }"),
    ("main.vibe", "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }")
  ]
  let (_, _, db1) = db_merged_source(db_new(), "main.vibe", sources)
  let count1 = db_merge_count(db1)
  let (_, _, db2) = db_merged_source(db1, "main.vibe", sources)
  let count2 = db_merge_count(db2)
  count1 * 1000 + count2
}

export let selfbuild_probe_type_db_group_merge_counts = () -> Int with { Error } {
  let groups = [
    ("core", [("helpers.vibe", "export let add = (a: Int, b: Int) -> Int { a + b }")]),
    ("entry", [("main.vibe", "import ./helpers.vibe { add }\nlet main = () -> Int { add(1, 2) }")])
  ]
  let (_, _, db1) = db_grouped_merged_source(db_new(), groups)
  let count1 = db_merge_count(db1)
  let (_, _, db2) = db_grouped_merged_source(db1, groups)
  let count2 = db_merge_count(db2)
  count1 * 1000 + count2
}

