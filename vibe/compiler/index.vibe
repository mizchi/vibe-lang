let build_selfhost_cli_adapter_bytes = () -> Bytes with { Error } {
  let module_source = selfhost_cli_adapter_module_source()
  if module_source == "" {
    throw("selfhost_cli_adapter_module_source is empty")
  }
  let adapter_path = "vibe/compiler/selfhost_cli_adapter.vibe"
  let source_groups = selfhost_cli_adapter_source_groups()
  let (bytes, _) = compile_with_source_groups_via_module_source_wasi_unchecked_cached(
    db_new(),
    module_source,
    adapter_path,
    source_groups,
    "cli_main"
  )
  bytes
}

let string_to_bytes = (s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

let compile_selfhost_cli_adapter_to = (output_path: String) -> Int with { Error, Fs } {
  if output_path == "" {
    1
  } else {
    let bytes = build_selfhost_cli_adapter_bytes()
    Fs::write_bytes(output_path, bytes)
    0
  }
}

let selfhost_cli_trigger_path = "_build/bench/selfhost_cli_adapter/.compile_cli_trigger"
let selfhost_cli_stage1_path = "_build/bench/selfhost_cli_adapter/selfhost_cli_stage1.wasm"
let selfhost_cli_merged_dump_path = "_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_merged_dump.vibe"
let selfhost_cli_module_dump_path = "_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_module_dump.vibe"

// Lightweight entry for WASI _start/run wrapper.
export let selfbuild_entry = () -> Int with { Error, Fs } {
  handle {
    if perform Fs::Exists(selfhost_cli_trigger_path) {
      compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)
    } else {
      0
    }
  } {
    Error(_) => 0
  }
}

export let selfbuild_write_cli_adapter = () -> Int with { Error, Fs } {
  compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)
}

export let selfbuild_dump_cli_adapter_merged_source = () -> Int with { Error, Fs } {
  Fs::write_bytes(
    selfhost_cli_merged_dump_path,
    string_to_bytes(selfhost_cli_adapter_merged_source())
  )
  0
}

export let selfbuild_dump_cli_adapter_module_source = () -> Int with { Error, Fs } {
  Fs::write_bytes(
    selfhost_cli_module_dump_path,
    string_to_bytes(selfhost_cli_adapter_module_source())
  )
  0
}

export let selfbuild_dump_cli_adapter_merged_source_env = () -> Int with { Error, Fs, Env } {
  let output_path = perform Env::Get("VIBE_OUTPUT")
  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))
