export let selfbuild_cli_env_entry = () -> Int with { Error, Fs, Env } {
  let input_path = Env::get("VIBE_INPUT")
  let output_path = Env::get("VIBE_OUTPUT")
  let entry_name = Env::get("VIBE_ENTRY")
  if String::equals(input_path, "") {
    1
  }
  else if String::equals(output_path, "") {
    1
  }
  else if String::equals(entry_name, "") {
    1
  }
  else {
    let source = Fs::read_file(input_path)
    let bytes = compile_source_wasi_only(source, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
}

