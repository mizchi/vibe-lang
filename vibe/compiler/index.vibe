export let selfbuild_probe_cli_file_cache_counts = () -> Int with { Error, Fs } {
  let helper_path = "/tmp/vibe_selfhost_cli_cache_v4_helper.vibe"
  let main_path = "/tmp/vibe_selfhost_cli_cache_v4_main.vibe"
  let helper_source = "export let add = (a: Int, b: Int) -> Int { a + b }"
  let main_source = "import ./vibe_selfhost_cli_cache_v4_helper.vibe { add }\nlet run = () -> Int { add(1, 2) }"
  Fs::write_bytes(helper_path, string_to_bytes(helper_source))
  Fs::write_bytes(main_path, string_to_bytes(main_source))
  let db1 = prepare_file_fs_cached(db_new(), main_path)
  let count1 = db_typecheck_count(db1)
  let db2 = prepare_file_fs_cached(db1, main_path)
  let count2 = db_typecheck_count(db2)
  count1 * 1000 + count2
}

export let selfbuild_probe_cli_cache_counts = () -> Int with { Error, Fs } {
  selfbuild_probe_cli_file_cache_counts()
}

