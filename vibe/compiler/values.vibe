//# Types

export enum Value {
  VInt(Int);
  VFloat(Double);
  VString(String);
  VBool(Bool);
  VUnit;
  VTuple(Array[Value]);
  VArray(Array[Value]);
  VRecord(Array[(String, Value)]);
  VCtor(String, Array[Value]);
  VBytes(Bytes);
  VFn(Array[(String, Value)], Array[String], Int, Option[String]);
  VBreak(Value);
  VContinue(Array[Value])
}

export enum ValEnv {
  VEnvEmpty;
  VEnvBind(String, Value, ValEnv)
}

export enum ModuleCtx {
  ModuleCtx(Array[(String, String)], Array[String], String)
}

//# Functions

export let val_env_bind = (env: ValEnv, name: String, v: Value) -> ValEnv {
  VEnvBind(name, v, env)
}

export let rec values_equal = (a: Value, b: Value) -> Bool {
  let rec values_equal_array = (left: Array[Value], right: Array[Value], i: Int) -> Bool {
    if i >= Array::length(left) {
      true
    }
    else if values_equal(Array::get(left, i), Array::get(right, i)) {
      values_equal_array(left, right, i + 1)
    }
    else {
      false
    }
  }
  let rec bytes_equal = (left: Bytes, right: Bytes, i: Int) -> Bool {
    if i >= Bytes::length(left) {
      true
    }
    else if Bytes::get(left, i) == Bytes::get(right, i) {
      bytes_equal(left, right, i + 1)
    }
    else {
      false
    }
  }
  let rec record_fields_equal = (left: Array[(String, Value)], right: Array[(String, Value)], i: Int) -> Bool {
    if i >= Array::length(left) {
      true
    }
    else {
      let (left_name, left_value) = Array::get(left, i)
      let (right_name, right_value) = Array::get(right, i)
      if !(left_name == right_name) {
        false
      }
      else if values_equal(left_value, right_value) {
        record_fields_equal(left, right, i + 1)
      }
      else {
        false
      }
    }
  }
  let rec string_array_equal = (left: Array[String], right: Array[String], i: Int) -> Bool {
    if i >= Array::length(left) {
      true
    }
    else if Array::get(left, i) == Array::get(right, i) {
      string_array_equal(left, right, i + 1)
    }
    else {
      false
    }
  }
  match a {
    VInt(x) => match b {
      VInt(y) => x == y,
      _ => false
    },
    VFloat(x) => match b {
      VFloat(y) => x == y,
      _ => false
    },
    VString(x) => match b {
      VString(y) => x == y,
      _ => false
    },
    VBool(x) => match b {
      VBool(y) => x == y,
      _ => false
    },
    VUnit => match b {
      VUnit => true,
      _ => false
    },
    VTuple(left) => match b {
      VTuple(right) => if Array::length(left) != Array::length(right) {
        false
      } else {
        values_equal_array(left, right, 0)
      }
      ,
      _ => false
    },
    VArray(left) => match b {
      VArray(right) => if Array::length(left) != Array::length(right) {
        false
      } else {
        values_equal_array(left, right, 0)
      }
      ,
      _ => false
    },
    VRecord(left) => match b {
      VRecord(right) => if Array::length(left) != Array::length(right) {
        false
      } else {
        record_fields_equal(left, right, 0)
      }
      ,
      _ => false
    },
    VCtor(left_name, left_args) => match b {
      VCtor(right_name, right_args) => if !(left_name == right_name) {
        false
      } else if Array::length(left_args) != Array::length(right_args) {
        false
      } else {
        values_equal_array(left_args, right_args, 0)
      }
      ,
      _ => false
    },
    VBytes(left) => match b {
      VBytes(right) => if Bytes::length(left) != Bytes::length(right) {
        false
      } else {
        bytes_equal(left, right, 0)
      }
      ,
      _ => false
    },
    VFn(_, _, _, _) => false,
    VBreak(left) => match b {
      VBreak(right) => values_equal(left, right),
      _ => false
    },
    VContinue(left) => match b {
      VContinue(right) => if Array::length(left) != Array::length(right) {
        false
      } else {
        values_equal_array(left, right, 0)
      }
      ,
      _ => false
    }
  }
}

export let module_ctx_new = (sources: Array[(String, String)], base_dir: String) -> ModuleCtx {
  ModuleCtx(sources, Array::slice([
    ""
  ], 0, 0), base_dir)
}

export let rec val_env_lookup = (env: ValEnv, name: String) -> Option[Value] {
  match env {
    VEnvEmpty => None,
    VEnvBind(n, v, rest) => if n == name {
      Some(v)
    }
    else {
      val_env_lookup(rest, name)
    }
  }
}

export let rec value_to_string = (v: Value) -> String {
  let rec arr_to_str = (arr: Array[Value], i: Int) -> String {
    if i >= Array::length(arr) {
      ""
    }
    else {
      let s = value_to_string(Array::get(arr, i))
      if eq(i, Array::length(arr) - 1) {
        s
      }
      else {
        String::concat(s, String::concat(", ", arr_to_str(arr, i + 1)))
      }
    }
  }
  let rec fields_to_str = (fields: Array[(String, Value)], i: Int) -> String {
    if i >= Array::length(fields) {
      ""
    }
    else {
      let (fname, fv) = Array::get(fields, i)
      let entry = String::concat(fname, String::concat(": ", value_to_string(fv)))
      if eq(i, Array::length(fields) - 1) {
        entry
      }
      else {
        String::concat(entry, String::concat(", ", fields_to_str(fields, i + 1)))
      }
    }
  }
  match v {
    VInt(n) => __to_string(n),
    VFloat(f) => __to_string(f),
    VString(s) => s,
    VBool(b) => if b {
      "true"
    } else {
      "false"
    },
    VUnit => "()",
    VTuple(elems) => String::concat("(", String::concat(arr_to_str(elems, 0), ")")),
    VArray(elems) => String::concat("[", String::concat(arr_to_str(elems, 0), "]")),
    VRecord(fields) => String::concat("{", String::concat(fields_to_str(fields, 0), "}")),
    VCtor(name, args) => if eq(Array::length(args), 0) {
      name
    }
    else {
      String::concat(name, String::concat("(", String::concat(arr_to_str(args, 0), ")")))
    }
    ,
    VBytes(data) => {
      let len = Bytes::length(data)
      let rec go = (i: Int, acc: String) -> String {
        if i >= len {
          acc
        }
        else {
          let sep = if i > 0 {
            ", "
          } else {
            ""
          }
          go(i + 1, String::concat(acc, String::concat(sep, __to_string(Bytes::get(data, i)))))
        }
      }
      String::concat("Bytes([", String::concat(go(0, ""), "])"))
    },
    VFn(_, _, _, _) => "<fn>",
    VBreak(inner) => String::concat("<break:", String::concat(value_to_string(inner), ">")),
    VContinue(_) => "<continue>"
  }
}

export let empty_module_ctx = () -> ModuleCtx {
  ModuleCtx(Array::slice([
    ("", "")
  ], 0, 0), Array::slice([
    ""
  ], 0, 0), "")
}

export let val_env_bind_all = (env: ValEnv, bindings: Array[(String, Value)]) -> ValEnv {
  let len = Array::length(bindings)
  let rec go = (i: Int, acc: ValEnv) -> ValEnv {
    if i >= len {
      acc
    }
    else {
      let (name, v) = Array::get(bindings, i)
      go(i + 1, VEnvBind(name, v, acc))
    }
  }
  go(0, env)
}
