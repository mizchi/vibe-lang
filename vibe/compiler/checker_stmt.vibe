import ./ast.vibe { Expr, Pat, TypeExpr, Stmt }
import ./types.vibe { Type, TypeDef, TypeEnv, env_lookup, env_bind, resolve_builtin, Subst, subst_apply, generalize, trait_defined, impls_overlap_for }
import ./checker.vibe { check_expr }

let resolve_te = (te: TypeExpr) -> Type {
  match te {
    TyUnit => CtUnit,
    TyName(name) => {
      match resolve_builtin(name) {
        Some(t) => t,
        None => CtNamed(name, array_slice([CtUnknown], 0, 0))
      }
    },
    _ => CtUnknown
  }
}

export let rec check_stmts = (
  stmts: Array[Stmt],
  i: Int,
  env: TypeEnv,
  defs: Array[TypeDef],
  s: Subst,
  c: Int
) -> (TypeEnv, Subst, Int) {
  if i >= array_length(stmts) {
    (env, s, c)
  } else {
    let stmt = array_get(stmts, i)
    let (new_env, s1, c1) = match stmt {
      SLet(_, is_rec, name, ann, val) => {
        let (vt, ns, nc) = if is_rec {
          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c)
        } else {
          check_expr(val, env, defs, s, c)
        }
        let t = match ann {
          Some(te) => resolve_te(te),
          None => generalize(ns, vt)
        }
        (env_bind(env, name, t), ns, nc)
      },
      SLetMut(name, ann, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c)
        let t = match ann {
          Some(te) => resolve_te(te),
          None => vt
        }
        (env_bind(env, name, t), ns, nc)
      },
      SEnum(_, name, _) => {
        (env_bind(env, name, CtEnum(name)), s, c)
      },
      SStruct(_, name, _) => {
        (env_bind(env, name, CtStruct(name)), s, c)
      },
      STypeAlias(_, name, te) => {
        let t = resolve_te(te)
        (env_bind(env, name, t), s, c)
      },
      SExternLet(name, te) => {
        let t = resolve_te(te)
        (env_bind(env, name, t), s, c)
      },
      STest(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c)
        (env, ns, nc)
      },
      SBench(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c)
        (env, ns, nc)
      },
      SExpr(expr) => {
        let (_, ns, nc) = check_expr(expr, env, defs, s, c)
        (env, ns, nc)
      },
      SModule(_, _, body) => {
        let _ = check_stmts(body, 0, env, defs, s, c)
        (env, s, c)
      },
      SImport(_, names) => {
        let nlen = array_length(names)
        let rec bind_imports = (i: Int, acc: TypeEnv) -> TypeEnv {
          if i >= nlen { acc }
          else {
            let (name, alias) = array_get(names, i)
            let bound_name = match alias { Some(a) => a, None => name }
            bind_imports(i + 1, env_bind(acc, bound_name, CtUnknown))
          }
        }
        (bind_imports(0, env), s, c)
      },
      STrait(_, name, supers) => {
        // Register trait definition in env
        let is_open = false
        (EnvTraitDef(name, supers, is_open, env), s, c)
      },
      SImpl(_, _, trait_name, type_name) => {
        // Resolve target type
        let target = match resolve_builtin(type_name) {
          Some(t) => t,
          None => CtNamed(type_name, array_slice([CtUnknown], 0, 0))
        }
        // Register impl in env
        (EnvTraitImpl(trait_name, target, env), s, c)
      },
      _ => (env, s, c)
    }
    check_stmts(stmts, i + 1, new_env, defs, s1, c1)
  }
}

export let check_program = (stmts: Array[Stmt]) -> TypeEnv {
  let empty_defs = array_slice([TDAlias("_dummy", CtUnit)], 0, 0)
  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs, SubstEmpty, 0)
  env
}
