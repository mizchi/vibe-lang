//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker.vibe {
  check_expr
}

import ./checker_resolve.vibe {
  resolve_type_expr
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, generalize, impls_overlap_for, resolve_builtin, subst_apply, trait_defined
}

//# Functions

export let rec check_stmts = (stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (TypeEnv, Subst, Int) {
  if i >= array_length(stmts) {
    (env, s, c)
  } else {
    let stmt = array_get(stmts, i)
    let (new_env, s1, c1) = match stmt {
      SLet(_, is_rec, name, ann, val) => {
        let (vt, ns, nc) = if is_rec {
          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c)
        } else {
          check_expr(val, env, defs, s, c)
        }
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => generalize(ns, vt)
        }
        (env_bind(env, name, t), ns, nc)
      },
      SLetMut(name, ann, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c)
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => vt
        }
        (env_bind(env, name, t), ns, nc)
      },
      SEnum(_, name, _) => (env_bind(env, name, CtEnum(name)), s, c)
      ,
      SStruct(_, name, _) => (env_bind(env, name, CtStruct(name)), s, c)
      ,
      STypeAlias(_, name, te) => {
        let t = resolve_type_expr(te, defs)
        (env_bind(env, name, t), s, c)
      },
      SExternLet(name, te) => {
        let t = resolve_type_expr(te, defs)
        (env_bind(env, name, t), s, c)
      },
      STest(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c)
        (env, ns, nc)
      },
      SBench(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c)
        (env, ns, nc)
      },
      SExpr(expr) => {
        let (_, ns, nc) = check_expr(expr, env, defs, s, c)
        (env, ns, nc)
      },
      SModule(_, _, body) => {
        let _ = check_stmts(body, 0, env, defs, s, c)
        (env, s, c)
      },
      SImport(_, names) => {
        let nlen = array_length(names)
        let rec bind_imports = (i: Int, acc: TypeEnv) -> TypeEnv {
          if i >= nlen {
            acc
          }
          else {
            let (name, alias) = array_get(names, i)
            let bound_name = match alias {
              Some(a) => a,
              None => name
            }
            let ty = match env_lookup(env, bound_name) {
              Some(t) => t,
              None => CtUnknown
            }
            bind_imports(i + 1, env_bind(acc, bound_name, ty))
          }
        }
        (bind_imports(0, env), s, c)
      },
      STrait(_, name, supers) => {
        // Register trait definition in env
        let is_open = false
        (EnvTraitDef(name, supers, is_open, env), s, c)
      },
      SImpl(_, _, trait_name, type_name) => {
        // Resolve target type
        let target = match resolve_builtin(type_name) {
          Some(t) => t,
          None => CtNamed(type_name, array_slice([
            CtUnknown
          ], 0, 0))
        }
        // Register impl in env
        (EnvTraitImpl(trait_name, target, env), s, c)
      },
      _ => (env, s, c)
    }
    check_stmts(stmts, i + 1, new_env, defs, s1, c1)
  }
}

export let check_program = (stmts: Array[Stmt]) -> TypeEnv {
  let empty_defs = array_slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs, SubstEmpty, 0)
  env
}

export let check_program_with_env = (stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv {
  let empty_defs = array_slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
  let (env, _, _) = check_stmts(stmts, 0, initial_env, empty_defs, SubstEmpty, 0)
  env
}
