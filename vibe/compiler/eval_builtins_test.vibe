import ./values.vibe { Value, values_equal, value_to_string }
import ./eval_builtins.vibe { eval_builtin_call }

test "array_length" {
  match eval_builtin_call("array_length", [VArray([VInt(1), VInt(2), VInt(3)])]) {
    Some(v) => assert(values_equal(v, VInt(3))),
    None => assert(false)
  }
}

test "array_get" {
  match eval_builtin_call("array_get", [VArray([VInt(10), VInt(20)]), VInt(1)]) {
    Some(v) => assert(values_equal(v, VInt(20))),
    None => assert(false)
  }
}

test "array_slice" {
  match eval_builtin_call("array_slice", [VArray([VInt(1), VInt(2), VInt(3)]), VInt(0), VInt(2)]) {
    Some(v) => assert(string_equals(value_to_string(v), "[1, 2]")),
    None => assert(false)
  }
}

test "array_concat" {
  match eval_builtin_call("array_concat", [VArray([VInt(1)]), VArray([VInt(2)])]) {
    Some(v) => assert(string_equals(value_to_string(v), "[1, 2]")),
    None => assert(false)
  }
}

test "string_concat" {
  match eval_builtin_call("string_concat", [VString("hello"), VString(" world")]) {
    Some(v) => assert(values_equal(v, VString("hello world"))),
    None => assert(false)
  }
}

test "string_length" {
  match eval_builtin_call("string_length", [VString("hello")]) {
    Some(v) => assert(values_equal(v, VInt(5))),
    None => assert(false)
  }
}

test "string_equals builtin" {
  match eval_builtin_call("string_equals", [VString("a"), VString("a")]) {
    Some(v) => assert(values_equal(v, VBool(true))),
    None => assert(false)
  }
  match eval_builtin_call("string_equals", [VString("a"), VString("b")]) {
    Some(v) => assert(values_equal(v, VBool(false))),
    None => assert(false)
  }
}

test "eq builtin" {
  match eval_builtin_call("eq", [VInt(42), VInt(42)]) {
    Some(v) => assert(values_equal(v, VBool(true))),
    None => assert(false)
  }
  match eval_builtin_call("eq", [VInt(1), VInt(2)]) {
    Some(v) => assert(values_equal(v, VBool(false))),
    None => assert(false)
  }
}

test "not builtin" {
  match eval_builtin_call("not", [VBool(true)]) {
    Some(v) => assert(values_equal(v, VBool(false))),
    None => assert(false)
  }
}

test "unknown returns None" {
  match eval_builtin_call("nonexistent_fn", [VUnit]) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "bytes_new" {
  match eval_builtin_call("bytes_new", []) {
    Some(v) => assert(values_equal(v, VBytes([]))),
    None => assert(false)
  }
}

test "bytes_push + bytes_length" {
  match eval_builtin_call("bytes_new", []) {
    Some(b) => {
      eval_builtin_call("bytes_push", [b, VInt(10)])
      eval_builtin_call("bytes_push", [b, VInt(20)])
      match eval_builtin_call("bytes_length", [b]) {
        Some(len) => assert(values_equal(len, VInt(2))),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "bytes_get" {
  match eval_builtin_call("bytes_new", []) {
    Some(b) => {
      eval_builtin_call("bytes_push", [b, VInt(42)])
      eval_builtin_call("bytes_push", [b, VInt(99)])
      match eval_builtin_call("bytes_get", [b, VInt(1)]) {
        Some(v) => assert(values_equal(v, VInt(99))),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "bytes_set" {
  match eval_builtin_call("bytes_new", []) {
    Some(b) => {
      eval_builtin_call("bytes_push", [b, VInt(1)])
      eval_builtin_call("bytes_push", [b, VInt(2)])
      eval_builtin_call("bytes_set", [b, VInt(0), VInt(77)])
      match eval_builtin_call("bytes_get", [b, VInt(0)]) {
        Some(v) => assert(values_equal(v, VInt(77))),
        None => assert(false)
      }
    },
    None => assert(false)
  }
}

test "bytes_slice" {
  match eval_builtin_call("bytes_slice", [VBytes([10, 20, 30, 40]), VInt(1), VInt(3)]) {
    Some(v) => assert(string_equals(value_to_string(v), "Bytes([20, 30])")),
    None => assert(false)
  }
}

test "bytes_concat" {
  match eval_builtin_call("bytes_concat", [VBytes([1, 2]), VBytes([3, 4])]) {
    Some(v) => assert(string_equals(value_to_string(v), "Bytes([1, 2, 3, 4])")),
    None => assert(false)
  }
}

test "bytes_to_array roundtrip" {
  let arr = VArray([VInt(65), VInt(66), VInt(67)])
  match eval_builtin_call("bytes_from_array", [arr]) {
    Some(b) => match eval_builtin_call("bytes_to_array", [b]) {
      Some(result) => {
        assert(string_equals(value_to_string(result), "[65, 66, 67]"))
      },
      None => assert(false)
    },
    None => assert(false)
  }
}
