//# Imports

import ./eval_builtins.vibe {
  eval_builtin_call
}

import ./values.vibe {
  Value, value_to_string, values_equal
}

import ../prelude/option.vibe {
  Option
}

//# Functions

let _no_args = Array::slice([
  VUnit
], 0, 0)

let expect_builtin_value = (name: String, args: Array[Value], expected: Value) -> Unit {
  let value_opt = eval_builtin_call(name, args)
  assert(Option::is_some(value_opt))
  let value = Option::unwrap_or(value_opt, VUnit)
  assert(values_equal(value, expected))
}

let expect_builtin_text = (name: String, args: Array[Value], expected: String) -> Unit {
  let value_opt = eval_builtin_call(name, args)
  assert(Option::is_some(value_opt))
  let value = Option::unwrap_or(value_opt, VUnit)
  assert(String::equals(value_to_string(value), expected))
}

//# Misc

test "Array::length" {
  expect_builtin_value("Array::length", [VArray([VInt(1), VInt(2), VInt(3)])], VInt(3))
}

test "Array::get" {
  expect_builtin_value("Array::get", [VArray([VInt(10), VInt(20)]), VInt(1)], VInt(20))
}

test "Array::slice" {
  expect_builtin_text("Array::slice", [VArray([VInt(1), VInt(2), VInt(3)]), VInt(0), VInt(2)], "[1, 2]")
}

test "Array::concat" {
  expect_builtin_text("Array::concat", [VArray([VInt(1)]), VArray([VInt(2)])], "[1, 2]")
}

test "String::concat" {
  expect_builtin_value("String::concat", [VString("hello"), VString(" world")], VString("hello world"))
}

test "String::length" {
  expect_builtin_value("String::length", [VString("hello")], VInt(5))
}

test "String::equals builtin" {
  expect_builtin_value("String::equals", [VString("a"), VString("a")], VBool(true))
  expect_builtin_value("String::equals", [VString("a"), VString("b")], VBool(false))
}

test "eq builtin" {
  expect_builtin_value("eq", [VInt(42), VInt(42)], VBool(true))
  expect_builtin_value("eq", [VInt(1), VInt(2)], VBool(false))
}

test "not builtin" {
  expect_builtin_value("not", [VBool(true)], VBool(false))
}

test "unknown returns None" {
  assert(match eval_builtin_call("nonexistent_fn", [VUnit]) {
    Some(_) => false,
    None => true
  })
}

test "Bytes::new" {
  expect_builtin_text("Bytes::new", _no_args, "Bytes([])")
}

test "Bytes::slice" {
  expect_builtin_text("Bytes::slice", [VBytes([10, 20, 30, 40]), VInt(1), VInt(3)], "Bytes([20, 30])")
}

test "Bytes::concat" {
  expect_builtin_text("Bytes::concat", [VBytes([1, 2]), VBytes([3, 4])], "Bytes([1, 2, 3, 4])")
}

test "Bytes::to_array roundtrip" {
  let arr = VArray([
    VInt(65),
    VInt(66),
    VInt(67)
  ])
  let bytes_opt = eval_builtin_call("Bytes::from_array", [arr])
  assert(Option::is_some(bytes_opt))
  let bytes = Option::unwrap_or(bytes_opt, VUnit)
  expect_builtin_text("Bytes::to_array", [bytes], "[65, 66, 67]")
}
