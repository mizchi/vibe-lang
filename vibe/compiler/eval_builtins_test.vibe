//# Imports

import ./eval_builtins.vibe {
  eval_builtin_call
}

import ./values.vibe {
  Value, value_to_string, values_equal
}

//# Functions

let _no_args = Array::slice([
  VUnit
], 0, 0)

//# Misc

test "Array::length" {
  match eval_builtin_call("Array::length", [
    VArray([
      VInt(1),
      VInt(2),
      VInt(3)
    ])
  ]) {
    Some(v) => assert(values_equal(v, VInt(3))),
    None => assert(false)
  }
}

test "Array::get" {
  match eval_builtin_call("Array::get", [
    VArray([
      VInt(10),
      VInt(20)
    ]),
    VInt(1)
  ]) {
    Some(v) => assert(values_equal(v, VInt(20))),
    None => assert(false)
  }
}

test "Array::slice" {
  match eval_builtin_call("Array::slice", [
    VArray([
      VInt(1),
      VInt(2),
      VInt(3)
    ]),
    VInt(0),
    VInt(2)
  ]) {
    Some(v) => assert(String::equals(value_to_string(v), "[1, 2]")),
    None => assert(false)
  }
}

test "Array::concat" {
  match eval_builtin_call("Array::concat", [
    VArray([
      VInt(1)
    ]),
    VArray([
      VInt(2)
    ])
  ]) {
    Some(v) => assert(String::equals(value_to_string(v), "[1, 2]")),
    None => assert(false)
  }
}

test "String::concat" {
  match eval_builtin_call("String::concat", [
    VString("hello"),
    VString(" world")
  ]) {
    Some(v) => assert(values_equal(v, VString("hello world"))),
    None => assert(false)
  }
}

test "String::length" {
  match eval_builtin_call("String::length", [
    VString("hello")
  ]) {
    Some(v) => assert(values_equal(v, VInt(5))),
    None => assert(false)
  }
}

test "String::equals builtin" {
  match eval_builtin_call("String::equals", [
    VString("a"),
    VString("a")
  ]) {
    Some(v) => assert(values_equal(v, VBool(true))),
    None => assert(false)
  }
  match eval_builtin_call("String::equals", [
    VString("a"),
    VString("b")
  ]) {
    Some(v) => assert(values_equal(v, VBool(false))),
    None => assert(false)
  }
}

test "eq builtin" {
  match eval_builtin_call("eq", [
    VInt(42),
    VInt(42)
  ]) {
    Some(v) => assert(values_equal(v, VBool(true))),
    None => assert(false)
  }
  match eval_builtin_call("eq", [
    VInt(1),
    VInt(2)
  ]) {
    Some(v) => assert(values_equal(v, VBool(false))),
    None => assert(false)
  }
}

test "not builtin" {
  match eval_builtin_call("not", [
    VBool(true)
  ]) {
    Some(v) => assert(values_equal(v, VBool(false))),
    None => assert(false)
  }
}

test "unknown returns None" {
  match eval_builtin_call("nonexistent_fn", [
    VUnit
  ]) {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "Bytes::new" {
  match eval_builtin_call("Bytes::new", _no_args) {
    Some(v) => assert(String::equals(value_to_string(v), "Bytes([])")),
    None => assert(false)
  }
}

test "Bytes::slice" {
  match eval_builtin_call("Bytes::slice", [
    VBytes([
      10,
      20,
      30,
      40
    ]),
    VInt(1),
    VInt(3)
  ]) {
    Some(v) => assert(String::equals(value_to_string(v), "Bytes([20, 30])")),
    None => assert(false)
  }
}

test "Bytes::concat" {
  match eval_builtin_call("Bytes::concat", [
    VBytes([
      1,
      2
    ]),
    VBytes([
      3,
      4
    ])
  ]) {
    Some(v) => assert(String::equals(value_to_string(v), "Bytes([1, 2, 3, 4])")),
    None => assert(false)
  }
}

test "Bytes::to_array roundtrip" {
  let arr = VArray([
    VInt(65),
    VInt(66),
    VInt(67)
  ])
  match eval_builtin_call("Bytes::from_array", [
    arr
  ]) {
    Some(b) => match eval_builtin_call("Bytes::to_array", [
      b
    ]) {
      Some(result) => assert(String::equals(value_to_string(result), "[65, 66, 67]"))
      ,
      None => assert(false)
    },
    None => assert(false)
  }
}
