//# Imports

import ./bytebuf.vibe {
  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_u32
}

import ./component_codegen.vibe {
  comp_emit_component_wasm, comp_emit_component_wasm_async, comp_emit_component_wasm_async_trampolined, comp_emit_component_wasm_with_lift, comp_emit_component_wasm_with_string_lift, comp_generate_string_trampoline
}

import ./wasm_emit.vibe {
  emit_code_section, emit_export_section, emit_exports_with_memory, emit_func_type_raw, emit_function_section, emit_header, emit_i32_const, emit_i64_add, emit_i64_const, emit_import_section_func, emit_local_get, emit_memory_section, emit_type_section
}

//# Functions

let component_bytes_contains: (Bytes, String) -> Int = (hay, needle) -> {
  let hay_len = Bytes::length(hay)
  let needle_len = String::length(needle)
  if needle_len == 0 {
    1
  }
  else {
    let limit = hay_len - needle_len
    let mut found = 0
    let mut i = 0
    while (i <= limit) && (found == 0) {
      let mut ok = 1
      let mut j = 0
      while (j < needle_len) && (ok == 1) {
        if Bytes::get(hay, i + j) != String::char_code_at(needle, j) {
          ok = 0
        }
        j = j + 1
      }
      if ok == 1 {
        found = 1
      }
      i = i + 1
    }
    found
  }
}

let build_test_core: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  emit_type_section(out, 2, 1)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "run", 0)
  let body = bytebuf_new()
  emit_local_get(body, 0)
  emit_local_get(body, 1)
  emit_i64_add(body)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

let build_test_core_with_memory: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 2)
  emit_func_type_raw(type_content, [
    126,
    126,
    127
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  bytebuf_push_section(out, 1, type_content)
  emit_function_section(out, [
    0,
    1
  ])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, [
    "handler",
    "cabi_realloc"
  ], [
    0,
    1
  ], "memory", 0)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  let r_body = bytebuf_new()
  emit_i32_const(r_body, 0)
  emit_code_section(out, [
    h_body,
    r_body
  ])
  bytebuf_to_bytes(out)
}

let build_test_core_with_memory_and_run: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  let type_content = bytebuf_new()
  bytebuf_push_vec_header(type_content, 3)
  emit_func_type_raw(type_content, [
    126,
    126,
    127
  ], [
    126
  ])
  emit_func_type_raw(type_content, [
    127,
    127,
    127,
    127
  ], [
    127
  ])
  emit_func_type_raw(type_content, Array::slice([
    0
  ], 0, 0), [
    126
  ])
  bytebuf_push_section(out, 1, type_content)
  emit_function_section(out, [
    0,
    1,
    2
  ])
  emit_memory_section(out, 1)
  emit_exports_with_memory(out, [
    "handler",
    "cabi_realloc",
    "_start"
  ], [
    0,
    1,
    2
  ], "memory", 0)
  let h_body = bytebuf_new()
  emit_local_get(h_body, 0)
  let r_body = bytebuf_new()
  emit_i32_const(r_body, 0)
  let run_body = bytebuf_new()
  emit_i64_const(run_body, 0)
  emit_code_section(out, [
    h_body,
    r_body,
    run_body
  ])
  bytebuf_to_bytes(out)
}

let bytes_contains_seq: (Bytes, Array[Int]) -> Int = (hay, needle) -> {
  let hay_len = Bytes::length(hay)
  let needle_len = Array::length(needle)
  if needle_len == 0 {
    1
  }
  else {
    let limit = hay_len - needle_len
    let mut found = 0
    let mut i = 0
    while (i <= limit) && (found == 0) {
      let mut ok = 1
      let mut j = 0
      while (j < needle_len) && (ok == 1) {
        if Bytes::get(hay, i + j) != Array::get(needle, j) {
          ok = 0
        }
        j = j + 1
      }
      if ok == 1 {
        found = 1
      }
      i = i + 1
    }
    found
  }
}

// Core module that imports ("cm","task-return") and exports a void `run` which
// hands a constant to task.return — the shape comp_emit_component_wasm_async wraps.
let build_async_test_core: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 2)
  emit_func_type_raw(tc, [
    127
  ], Array::slice([
    0
  ], 0, 0))
  emit_func_type_raw(tc, Array::slice([
    0
  ], 0, 0), Array::slice([
    0
  ], 0, 0))
  bytebuf_push_section(out, 1, tc)
  emit_import_section_func(out, "cm", "task-return", 0)
  emit_function_section(out, [
    1
  ])
  emit_export_section(out, "run", 1)
  let body = bytebuf_new()
  emit_i32_const(body, 42)
  bytebuf_push(body, 16)
  leb128_encode_u32(body, 0)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

// Normally-compiled main entry: run : () -> i64 = 42.
let build_main_i64_core: () -> Bytes = () -> {
  let out = bytebuf_new()
  emit_header(out)
  let tc = bytebuf_new()
  bytebuf_push_vec_header(tc, 1)
  emit_func_type_raw(tc, Array::slice([
    0
  ], 0, 0), [
    126
  ])
  bytebuf_push_section(out, 1, tc)
  emit_function_section(out, [
    0
  ])
  emit_export_section(out, "run", 0)
  let body = bytebuf_new()
  emit_i64_const(body, 42)
  emit_code_section(out, [
    body
  ])
  bytebuf_to_bytes(out)
}

//# Misc

test "component async trampolined: two-module compose with async lift" {
  let main_core = build_main_i64_core()
  let comp = comp_emit_component_wasm_async_trampolined(main_core, "run", 120)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  // task.return canon (s64=120): 08 05 01 09 00 78 00
  assert(bytes_contains_seq(comp, [
    8, 5, 1, 9, 0, 120, 0
  ]) == 1)
  // async functype () -> s64: 07 05 01 43 00 00 78
  assert(bytes_contains_seq(comp, [
    7, 5, 1, 67, 0, 0, 120
  ]) == 1)
  // async lift of core func 2 (trampoline run), type 0: 08 07 01 00 00 02 01 06 00
  assert(bytes_contains_seq(comp, [
    8, 7, 1, 0, 0, 2, 1, 6, 0
  ]) == 1)
  // trampoline imports task-return from "cm"
  assert(component_bytes_contains(comp, "task-return") == 1)
  assert(component_bytes_contains(comp, "run") == 1)
}

test "component async: emits task.return canon, async functype, async lift" {
  let core = build_async_test_core()
  let comp = comp_emit_component_wasm_async(core, "run", 120)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(bytes_contains_seq(comp, [
    8, 5, 1, 9, 0, 120, 0
  ]) == 1)
  assert(bytes_contains_seq(comp, [
    7, 5, 1, 67, 0, 0, 120
  ]) == 1)
  assert(bytes_contains_seq(comp, [
    8, 7, 1, 0, 0, 1, 1, 6, 0
  ]) == 1)
  assert(component_bytes_contains(comp, "run") == 1)
}

test "component async: sync lift carries no async canonopt" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "run")
  assert(bytes_contains_seq(comp, [
    8, 7, 1, 0, 0, 1, 1, 6, 0
  ]) == 0)
}

test "component: simple wrap has component header" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm(core)
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 1) == 97)
  assert(Bytes::get(comp, 2) == 115)
  assert(Bytes::get(comp, 3) == 109)
  assert(Bytes::get(comp, 4) == 13)
  assert(Bytes::length(comp) > Bytes::length(core))
}

test "component: lift no imports produces valid component" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "run")
  assert(Bytes::get(comp, 0) == 0)
  assert(Bytes::get(comp, 4) == 13)
  assert(Bytes::length(comp) > Bytes::length(core))
}

test "component: string trampoline has wasm header" {
  let tramp = comp_generate_string_trampoline(2, 0)
  assert(Bytes::get(tramp, 0) == 0)
  assert(Bytes::get(tramp, 1) == 97)
  assert(Bytes::get(tramp, 2) == 115)
  assert(Bytes::get(tramp, 3) == 109)
  assert(Bytes::get(tramp, 4) == 1)
  assert(Bytes::length(tramp) > 20)
}

test "component: string lift injects run_init when core exports _start" {
  let core = build_test_core_with_memory_and_run()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "handler", 2, [
    "method",
    "url"
  ], 0)
  assert(component_bytes_contains(comp, "run_init") == 1)
}

test "component: string lift omits run_init without _start export" {
  let core = build_test_core_with_memory()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "handler", 2, [
    "method",
    "url"
  ], 0)
  assert(component_bytes_contains(comp, "run_init") == 0)
}

test "component: export contains name" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm_with_lift(core, "my_run")
  assert(component_bytes_contains(comp, "my-run") == 1)
  assert(component_bytes_contains(comp, "my_run") == 0)
}

test "component: string lift kebab-cases parameter names" {
  let core = build_test_core_with_memory()
  let comp = comp_emit_component_wasm_with_string_lift(core, "handler", "run_cli_request", 2, [
    "input_path",
    "output_path"
  ], 0)
  assert(component_bytes_contains(comp, "input-path") == 1)
  assert(component_bytes_contains(comp, "output-path") == 1)
  assert(component_bytes_contains(comp, "input_path") == 0)
  assert(component_bytes_contains(comp, "output_path") == 0)
}

test "component: simple wrap overhead is small" {
  let core = build_test_core()
  let comp = comp_emit_component_wasm(core)
  let overhead = Bytes::length(comp) - Bytes::length(core)
  assert(overhead > 0)
  assert(overhead < 100)
}
