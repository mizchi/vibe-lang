//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

test "selfhost3: char code classification" {
  let src = "let is_digit = (c: Int) -> Bool { c >= 48 && c <= 57 }\nlet is_space = (c: Int) -> Bool { c == 32 }\nlet is_plus = (c: Int) -> Bool { c == 43 }\nlet r1 = is_digit(51)\nlet r2 = is_space(32)\nlet r3 = is_plus(43)\nlet result = if r1 { if r2 { if r3 { \"ok\" } else { \"bad3\" } } else { \"bad2\" } } else { \"bad1\" }"
  assert(String::equals(run_and_lookup(src, "result"), "ok"))
}

test "selfhost3: while loop number parse" {
  let src = "let s = \"123\"\nlet len = String::length(s)\nlet mut i = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); num = num * 10 + (c - 48); i = i + 1 }\nlet result = num"
  assert(String::equals(run_and_lookup(src, "result"), "123"))
}

test "selfhost3: enum token flat dispatch lexer" {
  let src = "enum Tok { TNum(Int); TPlus; TEof }\nlet s = \"3+42\"\nlet len = String::length(s)\nlet b = ArrayBuilder::new()\nlet mut i = 0\nlet mut mode = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); let is_d = if c >= 48 && c <= 57 { 1 } else { 0 }; let act = mode * 2 + is_d; if act == 1 { mode = 1; num = c - 48; i = i + 1 } else { 0 }; if act == 3 { num = num * 10 + (c - 48); i = i + 1 } else { 0 }; if act == 2 { let tok = TNum(num); ArrayBuilder::push(b, tok); mode = 0; num = 0 } else { 0 }; if act == 0 && c == 43 { ArrayBuilder::push(b, TPlus); i = i + 1 } else { 0 }; if act == 0 && c != 43 { i = i + 1 } else { 0 } }\nlet flush = if mode == 1 { let tok = TNum(num); ArrayBuilder::push(b, tok) } else { 0 }\nArrayBuilder::push(b, TEof)\nlet toks = ArrayBuilder::freeze(b)\nlet result = Array::length(toks)"
  assert(String::equals(run_and_lookup(src, "result"), "4"))
}

test "selfhost3: token array direct eval" {
  let src = "enum Tok { TNum(Int); TPlus; TEof }\nlet toks = [TNum(3), TPlus, TNum(42), TEof]\nlet len = Array::length(toks)\nlet mut i = 0\nlet mut acc = 0\nwhile i < len { let t = Array::get(toks, i); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; i = i + 1 }\nlet result = acc"
  assert(String::equals(run_and_lookup(src, "result"), "45"))
}

test "selfhost3: single file lex eval pipeline" {
  let src = "enum Tok { TNum(Int); TPlus; TEof }\nlet s = \"10+20+15\"\nlet len = String::length(s)\nlet b = ArrayBuilder::new()\nlet mut i = 0\nlet mut mode = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); let is_d = if c >= 48 && c <= 57 { 1 } else { 0 }; let act = mode * 2 + is_d; if act == 1 { mode = 1; num = c - 48; i = i + 1 } else { 0 }; if act == 3 { num = num * 10 + (c - 48); i = i + 1 } else { 0 }; if act == 2 { let tok = TNum(num); ArrayBuilder::push(b, tok); mode = 0; num = 0 } else { 0 }; if act == 0 && c == 43 { ArrayBuilder::push(b, TPlus); i = i + 1 } else { 0 }; if act == 0 && c != 43 { i = i + 1 } else { 0 } }\nlet flush = if mode == 1 { let tok = TNum(num); ArrayBuilder::push(b, tok) } else { 0 }\nArrayBuilder::push(b, TEof)\nlet toks = ArrayBuilder::freeze(b)\nlet tlen = Array::length(toks)\nlet mut j = 0\nlet mut acc = 0\nwhile j < tlen { let t = Array::get(toks, j); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; j = j + 1 }\nlet result = acc"
  assert(String::equals(run_and_lookup(src, "result"), "45"))
}

test "selfhost3: 2-file import lex eval" {
  let tok_src = "export enum Tok { TNum(Int); TPlus; TEof }"
  let main_src = "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nlet s = \"10+20+15\"\nlet len = String::length(s)\nlet b = ArrayBuilder::new()\nlet mut i = 0\nlet mut mode = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); let is_d = if c >= 48 && c <= 57 { 1 } else { 0 }; let act = mode * 2 + is_d; if act == 1 { mode = 1; num = c - 48; i = i + 1 } else { 0 }; if act == 3 { num = num * 10 + (c - 48); i = i + 1 } else { 0 }; if act == 2 { let tok = TNum(num); ArrayBuilder::push(b, tok); mode = 0; num = 0 } else { 0 }; if act == 0 && c == 43 { ArrayBuilder::push(b, TPlus); i = i + 1 } else { 0 }; if act == 0 && c != 43 { i = i + 1 } else { 0 } }\nlet flush = if mode == 1 { let tok = TNum(num); ArrayBuilder::push(b, tok) } else { 0 }\nArrayBuilder::push(b, TEof)\nlet toks = ArrayBuilder::freeze(b)\nlet tlen = Array::length(toks)\nlet mut j = 0\nlet mut acc = 0\nwhile j < tlen { let t = Array::get(toks, j); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; j = j + 1 }\nlet result = acc"
  let sources = [
    ("tok.vibe", tok_src),
    ("main.vibe", main_src)
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "45"))
}

test "selfhost3: 3-file import lex eval" {
  let tok_src = "export enum Tok { TNum(Int); TPlus; TEof }"
  let lex_src = "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nexport let is_digit = (c: Int) -> Int { if c >= 48 && c <= 57 { 1 } else { 0 } }"
  let main_src = "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nimport ./lex.vibe { is_digit }\nlet s = \"3+4\"\nlet len = String::length(s)\nlet b = ArrayBuilder::new()\nlet mut i = 0\nlet mut mode = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); let d = is_digit(c); let act = mode * 2 + d; if act == 1 { mode = 1; num = c - 48; i = i + 1 } else { 0 }; if act == 3 { num = num * 10 + (c - 48); i = i + 1 } else { 0 }; if act == 2 { let tok = TNum(num); ArrayBuilder::push(b, tok); mode = 0; num = 0 } else { 0 }; if act == 0 && c == 43 { ArrayBuilder::push(b, TPlus); i = i + 1 } else { 0 }; if act == 0 && c != 43 { i = i + 1 } else { 0 } }\nlet flush = if mode == 1 { let tok = TNum(num); ArrayBuilder::push(b, tok) } else { 0 }\nArrayBuilder::push(b, TEof)\nlet toks = ArrayBuilder::freeze(b)\nlet tlen = Array::length(toks)\nlet mut j = 0\nlet mut acc = 0\nwhile j < tlen { let t = Array::get(toks, j); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; j = j + 1 }\nlet result = acc"
  let sources = [
    ("tok.vibe", tok_src),
    ("lex.vibe", lex_src),
    ("main.vibe", main_src)
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "7"))
}

test "selfhost3: crown jewel 3-file lex eval pipeline" {
  let tok_src = "export enum Tok { TNum(Int); TPlus; TEof }"
  let lex_src = "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nexport let is_digit = (c: Int) -> Int { if c >= 48 && c <= 57 { 1 } else { 0 } }"
  let main_src = "import ./tok.vibe { Tok, TNum, TPlus, TEof }\nimport ./lex.vibe { is_digit }\nlet s = \"7+8+5\"\nlet len = String::length(s)\nlet b = ArrayBuilder::new()\nlet mut i = 0\nlet mut mode = 0\nlet mut num = 0\nwhile i < len { let c = String::char_code_at(s, i); let d = is_digit(c); let act = mode * 2 + d; if act == 1 { mode = 1; num = c - 48; i = i + 1 } else { 0 }; if act == 3 { num = num * 10 + (c - 48); i = i + 1 } else { 0 }; if act == 2 { let tok = TNum(num); ArrayBuilder::push(b, tok); mode = 0; num = 0 } else { 0 }; if act == 0 && c == 43 { ArrayBuilder::push(b, TPlus); i = i + 1 } else { 0 }; if act == 0 && c != 43 { i = i + 1 } else { 0 } }\nlet flush = if mode == 1 { let tok = TNum(num); ArrayBuilder::push(b, tok) } else { 0 }\nArrayBuilder::push(b, TEof)\nlet toks = ArrayBuilder::freeze(b)\nlet tlen = Array::length(toks)\nlet mut j = 0\nlet mut acc = 0\nwhile j < tlen { let t = Array::get(toks, j); let v = match t { TNum(n) => n, _ => 0 }; acc = acc + v; j = j + 1 }\nlet result = acc"
  let sources = [
    ("tok.vibe", tok_src),
    ("lex.vibe", lex_src),
    ("main.vibe", main_src)
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "20"))
}
