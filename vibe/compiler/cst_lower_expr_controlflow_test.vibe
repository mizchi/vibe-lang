// Tests for CST lower: expression control-flow conversion

import ./token.vibe { Token }
import ./ast.vibe { Expr }
import ./cst.vibe { NodeKind, CstChild }
import ./lower.vibe {
  lower_expr
}

//# Lower: expression tests

test "lower EIf no else" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(1))])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EMatch" {
  let node = CNode(NMatchExpr, [
    CToken(TMatch),
    CNode(NIdentExpr, [CToken(TIdent("x"))]),
    CToken(TLBrace),
    CNode(NMatchArm, [
      CNode(NIntPat, [CToken(TInt(1))]),
      CToken(TArrow),
      CNode(NStringExpr, [CToken(TString("one"))])
    ]),
    CToken(TComma),
    CNode(NMatchArm, [
      CNode(NWildPat, [CToken(TIdent("_"))]),
      CToken(TArrow),
      CNode(NStringExpr, [CToken(TString("other"))])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    EMatch(_, arms) => assert(Array::length(arms) == 2),
    _ => assert(false)
  }
}

test "lower EWhile" {
  let node = CNode(NWhileExpr, [
    CToken(TWhile),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ])
  match lower_expr(node) {
    EWhile(_, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EBreak none" {
  let node = CNode(NBreakExpr, [CToken(TBreak)])
  match lower_expr(node) {
    EBreak(None) => assert(true),
    _ => assert(false)
  }
}

test "lower EBreak with value" {
  let node = CNode(NBreakExpr, [
    CToken(TBreak),
    CNode(NIntExpr, [CToken(TInt(42))])
  ])
  match lower_expr(node) {
    EBreak(Some(_)) => assert(true),
    _ => assert(false)
  }
}

test "lower EContinue" {
  let node = CNode(NContinueExpr, [CToken(TContinue)])
  match lower_expr(node) {
    EContinue(args) => assert(Array::length(args) == 0),
    _ => assert(false)
  }
}

test "lower EThrow" {
  let node = CNode(NThrowExpr, [
    CToken(TThrow),
    CNode(NStringExpr, [CToken(TString("err"))])
  ])
  match lower_expr(node) {
    EThrow(_) => assert(true),
    _ => assert(false)
  }
}

test "lower EForIn" {
  let node = CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [CToken(TIdent("xs"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ])
  match lower_expr(node) {
    EForIn(name, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}
