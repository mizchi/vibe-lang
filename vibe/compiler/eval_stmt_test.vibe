//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./eval_stmt.vibe {
  eval_and_lookup, eval_program, eval_stmts
}

import ./values.vibe {
  ValEnv, Value, val_env_lookup, value_to_string, values_equal
}

//# Functions

let _a1 = (e: Expr) -> Expr {
  e
}

let _a2 = (p: Pat) -> Pat {
  p
}

let _a3 = (t: TypeExpr) -> TypeExpr {
  t
}

let _a4 = (s: Stmt) -> Stmt {
  s
}

let _no_tp = Array::slice([
  ""
], 0, 0)

let _no_tb = Array::slice([
  ("", _no_tp)
], 0, 0)

//# Misc

test "eval SLet simple" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(42))),
    None => assert(false)
  }
}

test "eval SLet with expression" {
  let stmts = [
    SLet(false, false, "x", None, EBinOp("+", EInt(1), EInt(2)))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(3))),
    None => assert(false)
  }
}

test "eval SLetMut" {
  let stmts = [
    SLetMut("x", None, EInt(10))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(10))),
    None => assert(false)
  }
}

test "eval SExpr" {
  let stmts = [
    SLet(false, false, "x", None, EInt(1)),
    SExpr(EInt(99))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(1))),
    None => assert(false)
  }
}

test "eval STest does not change env" {
  let stmts = [
    SLet(false, false, "x", None, EInt(5)),
    STest("t", EInt(99))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "x") {
    Some(v) => assert(values_equal(v, VInt(5))),
    None => assert(false)
  }
}

test "eval SEnum binds constructors" {
  let variants = [
    ("Red", Array::slice([
      TyUnit
    ], 0, 0)),
    ("Green", Array::slice([
      TyUnit
    ], 0, 0)),
    ("Blue", Array::slice([
      TyUnit
    ], 0, 0))
  ]
  let stmts = [
    SEnum(false, "Color", variants)
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "Red") {
    Some(v) => assert(String::equals(value_to_string(v), "Red")),
    None => assert(false)
  }
  match val_env_lookup(env, "Green") {
    Some(v) => assert(String::equals(value_to_string(v), "Green")),
    None => assert(false)
  }
}

test "eval SEnum with args" {
  let variants = [
    ("Some", [
      TyName("Int")
    ]),
    ("None", Array::slice([
      TyUnit
    ], 0, 0))
  ]
  let stmts = [
    SEnum(false, "MyOpt", variants),
    SLet(false, false, "x", None, ECall(EIdent("Some"), [
      EInt(42)
    ]))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "x") {
    Some(v) => assert(String::equals(value_to_string(v), "Some(42)")),
    None => assert(false)
  }
}

test "eval multiple stmts" {
  let stmts = [
    SLet(false, false, "a", None, EInt(10)),
    SLet(false, false, "b", None, EBinOp("+", EIdent("a"), EInt(5))),
    SLet(false, false, "c", None, EBinOp("*", EIdent("b"), EInt(2)))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "c") {
    Some(v) => assert(values_equal(v, VInt(30))),
    None => assert(false)
  }
}

test "eval let rec factorial" {
  // let rec fact = (n) -> if n <= 1 then 1 else n * fact(n - 1)
  let fn_body = EIf(EBinOp("<=", EIdent("n"), EInt(1)), EInt(1), EBinOp("*", EIdent("n"), ECall(EIdent("fact"), [
    EBinOp("-", EIdent("n"), EInt(1))
  ])))
  let fn_expr = EFn(_no_tp, _no_tb, [
    ("n", None)
  ], None, None, fn_body)
  let stmts = [
    SLet(false, true, "fact", None, fn_expr),
    SLet(false, false, "result", None, ECall(EIdent("fact"), [
      EInt(5)
    ]))
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "result") {
    Some(v) => assert(values_equal(v, VInt(120))),
    None => assert(false)
  }
}

test "eval enum match E2E" {
  let variants = [
    ("Some", [
      TyName("Int")
    ]),
    ("None", Array::slice([
      TyUnit
    ], 0, 0))
  ]
  let match_expr = EMatch(EIdent("val"), [
    (PCtor("Some", [
      PBind("x")
    ]), EIdent("x")),
    (PCtor("None", Array::slice([
      PWild
    ], 0, 0)), EInt(0))
  ])
  let stmts = [
    SEnum(false, "MyOpt", variants),
    SLet(false, false, "val", None, ECall(EIdent("Some"), [
      EInt(99)
    ])),
    SLet(false, false, "result", None, match_expr)
  ]
  let env = eval_program(stmts)
  match val_env_lookup(env, "result") {
    Some(v) => assert(values_equal(v, VInt(99))),
    None => assert(false)
  }
}

test "eval_and_lookup" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  assert(String::equals(eval_and_lookup(stmts, "x"), "42"))
}

test "eval_and_lookup not found" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  assert(String::equals(eval_and_lookup(stmts, "y"), "<not found>"))
}
