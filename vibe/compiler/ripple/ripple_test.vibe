//# Imports

import ./ripple.vibe {
  ripple_eval_count, ripple_get_fingerprint, ripple_get_source, ripple_new, ripple_record_eval, ripple_set_source
}

//# Misc

test "compiler ripple set/get source" {
  let db0 = ripple_new()
  let db1 = ripple_set_source(db0, "a.vibe", "let x = 1")
  match ripple_get_source(db1, "a.vibe") {
    Some(src) => assert(string_equals(src, "let x = 1")),
    None => assert(false)
  }
}

test "compiler ripple record eval increments only on fingerprint change" {
  let db0 = ripple_new()
  let db1 = ripple_record_eval(db0, "a.vibe", "fp1", [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db1), 1))
  let db2 = ripple_record_eval(db1, "a.vibe", "fp1", [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db2), 1))
  let db3 = ripple_record_eval(db2, "a.vibe", "fp2", [
    "b.vibe"
  ])
  assert(eq(ripple_eval_count(db3), 2))
}

test "compiler ripple stores latest fingerprint" {
  let db0 = ripple_new()
  let db1 = ripple_record_eval(db0, "a.vibe", "fp1", [
    "b.vibe"
  ])
  let db2 = ripple_record_eval(db1, "a.vibe", "fp2", [
    "c.vibe"
  ])
  match ripple_get_fingerprint(db2, "a.vibe") {
    Some(fp) => assert(string_equals(fp, "fp2")),
    None => assert(false)
  }
}
