//# Types

export enum RippleDb {
  RippleDb(Array[(String, String)], Array[(String, String)], Array[(String, Array[String])], Int)
}

//# Functions

let empty_strings: () -> Array[String] = () -> {
  Array::slice([
    ""
  ], 0, 0)
}

let empty_deps_pairs: () -> Array[(String, Array[String])] = () -> {
  Array::slice([
    ("", empty_strings())
  ], 0, 0)
}

let rec lookup_deps_entry: (Array[(String, Array[String])], String, Int) -> Option[Array[String]] = (entries, key, i) -> {
  if i >= Array::length(entries) {
    None
  }
  else {
    let (k, deps) = Array::get(entries, i)
    if k == key {
      Some(deps)
    }
    else {
      lookup_deps_entry(entries, key, i + 1)
    }
  }
}

export let ripple_get_deps: (RippleDb, String) -> Option[Array[String]] = (db, path) -> {
  match db {
    RippleDb(_, _, deps_map, _) => lookup_deps_entry(deps_map, path, 0)
  }
}

export let ripple_eval_count: (RippleDb) -> Int = (db) -> {
  match db {
    RippleDb(_, _, _, count) => count
  }
}

let upsert_deps_entry: (Array[(String, Array[String])], String, Array[String]) -> Array[(String, Array[String])] = (entries, key, deps) -> {
  let len = Array::length(entries)
  let b = ArrayBuilder::new()
  let rec go: (Int, Bool) -> Array[(String, Array[String])] = (i, found) -> {
    if i >= len {
      if found {
        ArrayBuilder::freeze(b)
      } else {
        ArrayBuilder::push(b, (key, deps))
        ArrayBuilder::freeze(b)
      }
    } else {
      let (k, existing) = Array::get(entries, i)
      if k == key {
        ArrayBuilder::push(b, (key, deps))
        go(i + 1, true)
      } else {
        ArrayBuilder::push(b, (k, existing))
        go(i + 1, found)
      }
    }
  }
  go(0, false)
}

let empty_string_pairs: () -> Array[(String, String)] = () -> {
  Array::slice([
    ("", "")
  ], 0, 0)
}

export let ripple_new: () -> RippleDb = () -> {
  RippleDb(empty_string_pairs(), empty_string_pairs(), empty_deps_pairs(), 0)
}

let rec lookup_string_entry: (Array[(String, String)], String, Int) -> Option[String] = (entries, key, i) -> {
  if i >= Array::length(entries) {
    None
  }
  else {
    let (k, v) = Array::get(entries, i)
    if k == key {
      Some(v)
    }
    else {
      lookup_string_entry(entries, key, i + 1)
    }
  }
}

export let ripple_get_source: (RippleDb, String) -> Option[String] = (db, path) -> {
  match db {
    RippleDb(sources, _, _, _) => lookup_string_entry(sources, path, 0)
  }
}

let upsert_string_entry: (Array[(String, String)], String, String) -> Array[(String, String)] = (entries, key, value) -> {
  let len = Array::length(entries)
  let b = ArrayBuilder::new()
  let rec go: (Int, Bool) -> Array[(String, String)] = (i, found) -> {
    if i >= len {
      if found {
        ArrayBuilder::freeze(b)
      } else {
        ArrayBuilder::push(b, (key, value))
        ArrayBuilder::freeze(b)
      }
    } else {
      let (k, v) = Array::get(entries, i)
      if k == key {
        ArrayBuilder::push(b, (key, value))
        go(i + 1, true)
      } else {
        ArrayBuilder::push(b, (k, v))
        go(i + 1, found)
      }
    }
  }
  go(0, false)
}

export let ripple_set_source: (RippleDb, String, String) -> RippleDb = (db, path, source) -> {
  match db {
    RippleDb(sources, fingerprints, deps_map, eval_count) => RippleDb(upsert_string_entry(sources, path, source), fingerprints, deps_map, eval_count)
  }
}

export let ripple_record_eval: (RippleDb, String, String, Array[String]) -> RippleDb = (db, path, fingerprint, deps) -> {
  match db {
    RippleDb(sources, fingerprints, deps_map, eval_count) => match lookup_string_entry(fingerprints, path, 0) {
      Some(prev_fp) => if prev_fp == fingerprint {
        RippleDb(sources, fingerprints, deps_map, eval_count)
      } else {
        RippleDb(sources, upsert_string_entry(fingerprints, path, fingerprint), upsert_deps_entry(deps_map, path, deps), eval_count + 1)
      },
      None => RippleDb(sources, upsert_string_entry(fingerprints, path, fingerprint), upsert_deps_entry(deps_map, path, deps), eval_count + 1)
    }
  }
}

export let ripple_get_fingerprint: (RippleDb, String) -> Option[String] = (db, path) -> {
  match db {
    RippleDb(_, fingerprints, _, _) => lookup_string_entry(fingerprints, path, 0)
  }
}
