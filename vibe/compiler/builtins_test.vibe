//# Imports

import ./builtins.vibe {
  lookup_builtin, normalize_builtin_name
}

import ./types.vibe {
  Type
}

//# Misc

test "lookup_builtin array_length" {
  match lookup_builtin("array_length") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin string_concat" {
  match lookup_builtin("string_concat") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin eq" {
  match lookup_builtin("eq") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin throw" {
  match lookup_builtin("throw") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin not_found" {
  match lookup_builtin("nonexistent") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "normalize_builtin_name rewrites legacy map builder aliases" {
  assert(normalize_builtin_name("map_builder") == "MapBuilder::new")
  assert(normalize_builtin_name("map_builder_set") == "MapBuilder::set")
  assert(normalize_builtin_name("map_builder_freeze") == "MapBuilder::freeze")
  assert(normalize_builtin_name("map_get") == "map_get")
}

test "lookup_builtin accepts legacy and canonical map builder names" {
  match lookup_builtin("map_builder") {
    Some(_) => assert(true),
    None => assert(false)
  }
  match lookup_builtin("MapBuilder::new") {
    Some(_) => assert(true),
    None => assert(false)
  }
}
