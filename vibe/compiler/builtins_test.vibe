//# Imports

import ./builtins.vibe {
  lookup_builtin
}

import ./types.vibe {
  Type
}

//# Misc

test "lookup_builtin array_length" {
  match lookup_builtin("array_length") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin string_concat" {
  match lookup_builtin("string_concat") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin eq" {
  match lookup_builtin("eq") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin throw" {
  match lookup_builtin("throw") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin not_found" {
  match lookup_builtin("nonexistent") {
    Some(_) => assert(false),
    None => assert(true)
  }
}
