//# Imports

import ./builtins.vibe {
  lookup_builtin
}

import ./types.vibe {
  Type
}

//# Misc

test "lookup_builtin Array::length" {
  match lookup_builtin("Array::length") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "lookup_builtin array_new" {
  match lookup_builtin("array_new") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

