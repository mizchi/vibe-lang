//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./desugar.vibe {
  desugar_expr, desugar_stmts
}

//# Functions

let is_edot = (e: Expr) -> Bool {
  match e {
    EDot(_, _) => true,
    _ => false
  }
}

let is_eint = (e: Expr) -> Bool {
  match e {
    EInt(_) => true,
    _ => false
  }
}

let is_elet = (e: Expr) -> Bool {
  match e {
    ELet(_, _, _) => true,
    _ => false
  }
}

let is_slet = (s: Stmt) -> Bool {
  match s {
    SLet(_, _, _, _, _) => true,
    _ => false
  }
}

let edot_obj = (e: Expr) -> Expr {
  match e {
    EDot(o, _) => o,
    _ => EUnit
  }
}

let eint_val = (e: Expr) -> Int {
  match e {
    EInt(n) => n,
    _ => -1
  }
}

let is_ecall = (e: Expr) -> Bool {
  match e {
    ECall(_, _) => true,
    _ => false
  }
}

let ebinop_op = (e: Expr) -> String {
  match e {
    EBinOp(op, _, _) => op,
    _ => ""
  }
}

let elet_body = (e: Expr) -> Expr {
  match e {
    ELet(_, _, b) => b,
    _ => EUnit
  }
}

let is_ebinop = (e: Expr) -> Bool {
  match e {
    EBinOp(_, _, _) => true,
    _ => false
  }
}

let is_eident = (e: Expr) -> Bool {
  match e {
    EIdent(_) => true,
    _ => false
  }
}

let slet_body = (s: Stmt) -> Expr {
  match s {
    SLet(_, _, _, _, b) => b,
    _ => EUnit
  }
}

let ecall_args = (e: Expr) -> Array[Expr] {
  match e {
    ECall(_, a) => a,
    _ => Array::slice([
      EUnit
    ], 0, 0)
  }
}

let edot_field = (e: Expr) -> String {
  match e {
    EDot(_, f) => f,
    _ => ""
  }
}

let eident_name = (e: Expr) -> String {
  match e {
    EIdent(n) => n,
    _ => ""
  }
}

let ecall_callee = (e: Expr) -> Expr {
  match e {
    ECall(c, _) => c,
    _ => EUnit
  }
}

let is_eassignop = (e: Expr) -> Bool {
  match e {
    EAssignOp(_, _, _, _) => true,
    _ => false
  }
}

let eassignop_val = (e: Expr) -> Expr {
  match e {
    EAssignOp(_, _, v, _) => v,
    _ => EUnit
  }
}

//# Misc

test "pipe simple: x |> f => f(x)" {
  let result = desugar_expr(EBinOp("|>", EInt(1), EIdent("f")))
  assert(is_ecall(result))
  assert(is_eident(ecall_callee(result)))
  assert(String::equals(eident_name(ecall_callee(result)), "f"))
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "pipe with args: x |> f(y) => f(x, y)" {
  let result = desugar_expr(EBinOp("|>", EInt(1), ECall(EIdent("f"), [
    EInt(2)
  ])))
  assert(is_ecall(result))
  assert(String::equals(eident_name(ecall_callee(result)), "f"))
  assert(eq(Array::length(ecall_args(result)), 2))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 1)), 2))
}

test "method call: obj.method() preserved as ECall(EDot(...))" {
  let result = desugar_expr(ECall(EDot(EIdent("x"), "len"), Array::slice([
    EUnit
  ], 0, 0)))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(String::equals(edot_field(callee), "len"))
  assert(String::equals(eident_name(edot_obj(callee)), "x"))
}

test "method call with args: obj.push(1) preserved" {
  let result = desugar_expr(ECall(EDot(EIdent("x"), "push"), [
    EInt(1)
  ]))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(String::equals(edot_field(callee), "push"))
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "non-pipe binop passes through" {
  let result = desugar_expr(EBinOp("+", EInt(1), EInt(2)))
  assert(is_ebinop(result))
  assert(String::equals(ebinop_op(result), "+"))
}

test "EDot without call passes through" {
  let result = desugar_expr(EDot(EIdent("x"), "y"))
  assert(is_edot(result))
  assert(String::equals(edot_field(result), "y"))
  assert(String::equals(eident_name(edot_obj(result)), "x"))
}

test "nested: pipe inside let body" {
  let result = desugar_expr(ELet("x", EInt(1), EBinOp("|>", EIdent("x"), EIdent("f"))))
  assert(is_elet(result))
  let body = elet_body(result)
  assert(is_ecall(body))
  assert(String::equals(eident_name(ecall_callee(body)), "f"))
}

test "SLet body gets desugared" {
  let stmts = [
    SLet(false, false, "x", None, EBinOp("|>", EInt(1), EIdent("f")))
  ]
  let result = desugar_stmts(stmts)
  assert(eq(Array::length(result), 1))
  match Array::get(result, 0) {
    SLet(_, _, name, _, body) => {
      assert(String::equals(name, "x"))
      assert(is_ecall(body))
      assert(String::equals(eident_name(ecall_callee(body)), "f"))
    },
    _ => assert(false)
  }
}

test "chained pipe: x |> f |> g => g(f(x))" {
  let result = desugar_expr(EBinOp("|>", EBinOp("|>", EInt(1), EIdent("f")), EIdent("g")))
  assert(is_ecall(result))
  assert(is_eident(ecall_callee(result)))
  assert(String::equals(eident_name(ecall_callee(result)), "g"))
  assert(eq(Array::length(ecall_args(result)), 1))
  let inner = Array::get(ecall_args(result), 0)
  assert(is_ecall(inner))
  assert(String::equals(eident_name(ecall_callee(inner)), "f"))
  assert(eq(Array::length(ecall_args(inner)), 1))
  assert(eq(eint_val(Array::get(ecall_args(inner), 0)), 1))
}

test "pipe into method call: 1 |> obj.method() preserved EDot" {
  let result = desugar_expr(EBinOp("|>", EInt(1), ECall(EDot(EIdent("obj"), "method"), Array::slice([
    EUnit
  ], 0, 0))))
  // pipe prepends 1 to args of ECall(EDot(obj, method), [])
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(String::equals(edot_field(callee), "method"))
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "chained method: x.a().b() preserved as nested EDot" {
  let result = desugar_expr(ECall(EDot(ECall(EDot(EIdent("x"), "a"), Array::slice([
    EUnit
  ], 0, 0)), "b"), Array::slice([
    EUnit
  ], 0, 0)))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(String::equals(edot_field(callee), "b"))
  // inner is ECall(EDot(x, a), [])
  let inner = edot_obj(callee)
  assert(is_ecall(inner))
  let inner_callee = ecall_callee(inner)
  assert(is_edot(inner_callee))
  assert(String::equals(edot_field(inner_callee), "a"))
}

test "pipe into obj.push(): 1 |> obj.push() preserved EDot" {
  let result = desugar_expr(EBinOp("|>", EInt(1), ECall(EDot(EIdent("obj"), "push"), Array::slice([
    EUnit
  ], 0, 0))))
  assert(is_ecall(result))
  let callee = ecall_callee(result)
  assert(is_edot(callee))
  assert(String::equals(edot_field(callee), "push"))
  assert(eq(Array::length(ecall_args(result)), 1))
  assert(eq(eint_val(Array::get(ecall_args(result), 0)), 1))
}

test "EAssignOp desugars val: x += (1 |> f) => x += f(1)" {
  let result = desugar_expr(EAssignOp("x", "+", EBinOp("|>", EInt(1), EIdent("f")), EUnit))
  assert(is_eassignop(result))
  let val = eassignop_val(result)
  assert(is_ecall(val))
  assert(String::equals(eident_name(ecall_callee(val)), "f"))
  assert(eq(Array::length(ecall_args(val)), 1))
  assert(eq(eint_val(Array::get(ecall_args(val), 0)), 1))
}

test "desugar_stmts handles multiple SLet with pipes" {
  let stmts = [
    SLet(false, false, "a", None, EBinOp("|>", EInt(1), EIdent("f"))),
    SLet(false, false, "b", None, EBinOp("|>", EInt(2), EIdent("g")))
  ]
  let result = desugar_stmts(stmts)
  assert(eq(Array::length(result), 2))
  let body0 = slet_body(Array::get(result, 0))
  assert(is_ecall(body0))
  assert(String::equals(eident_name(ecall_callee(body0)), "f"))
  assert(eq(eint_val(Array::get(ecall_args(body0), 0)), 1))
  let body1 = slet_body(Array::get(result, 1))
  assert(is_ecall(body1))
  assert(String::equals(eident_name(ecall_callee(body1)), "g"))
  assert(eq(eint_val(Array::get(ecall_args(body1), 0)), 2))
}
