//# Imports

import ./fixture_preloaded_test_support.vibe {
  assert_preloaded_fixture_success
}

//# Misc

test "preloaded real fixture: closure_capture" {
  let path = "fixtures/closure_capture.vibe"
  let main_source = "let n = 5\nlet add_n = (x: Int) -> Int { x + n }\nadd_n(10)"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "15", None)
}

test "preloaded real fixture: effect_sh" {
  let path = "fixtures/effect_sh.vibe"
  let main_source = "{\n  sh(\"echo hi\")\n}"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "()", Some([
    "ShellExec(\"echo hi\")"
  ]))
}

test "preloaded real fixture: closure_nested" {
  let path = "fixtures/closure_nested.vibe"
  let main_source = "let a = 1\nlet b = 2\nlet outer = (x: Int) -> Int {\n  let inner = (y: Int) -> Int { y + a + b }\n  inner(x)\n}\nouter(10)"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "13", None)
}

test "preloaded real fixture: for_in_basic" {
  let path = "fixtures/for_in_basic.vibe"
  let main_source = "for x in [1, 2, 3] { x * 2 }"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "[2, 4, 6]", None)
}

test "preloaded real fixture: import_version_ref rewritten" {
  let path = "fixtures/import_version_ref.vibe"
  let main_source = "import fixtures/modules/ref_lib_export.vibe { value, add }\nadd(value, 1)"
  let dep_path = "fixtures/modules/ref_lib_export.vibe"
  let dep_source = "export let value = 7\nlet add = (x: Int, y: Int) -> Int { x + y }\nexport { add }"
  let sources = [
    (path, main_source),
    (dep_path, dep_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "8", None)
}

test "preloaded real fixture: import_symbol_ref rewritten" {
  let path = "fixtures/import_symbol_ref.vibe"
  let main_source = "import fixtures/modules/ref_lib_export.vibe { value, add }\nadd(value, 2)"
  let dep_path = "fixtures/modules/ref_lib_export.vibe"
  let dep_source = "export let value = 7\nlet add = (x: Int, y: Int) -> Int { x + y }\nexport { add }"
  let sources = [
    (path, main_source),
    (dep_path, dep_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "9", None)
}
