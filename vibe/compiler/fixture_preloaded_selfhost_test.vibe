test "preloaded real fixture: loop_expr_counter" {
  let path = "fixtures/loop_expr_counter.vibe"
  let main_source = "let mut i = 0\nloop {\n  i += 1\n  if i == 3 { break } else { }\n}\ni\n"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "3", None)
}

test "preloaded real fixture: loop_param_sum" {
  let path = "fixtures/loop_param_sum.vibe"
  let main_source = "loop (i = 10, acc = 0) {\n  if i <= 0 { break acc } else { continue(i - 1, acc + i) }\n}\n"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "55", None)
}

test "preloaded real fixture: loop_param_factorial" {
  let path = "fixtures/loop_param_factorial.vibe"
  let main_source = "loop (n = 5, acc = 1) {\n  if n <= 1 { break acc } else { continue(n - 1, acc * n) }\n}\n"
  let sources = [
    (path, main_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "120", None)
}

test "preloaded real fixture: import_version_ref rewritten" {
  let path = "fixtures/import_version_ref.vibe"
  let main_source = "import fixtures/modules/ref_lib_export.vibe { value, add }\nadd(value, 1)"
  let dep_path = "fixtures/modules/ref_lib_export.vibe"
  let dep_source = "export let value = 7\nlet add = (x: Int, y: Int) -> Int { x + y }\nexport { add }"
  let sources = [
    (path, main_source),
    (dep_path, dep_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "8", None)
}

test "preloaded real fixture: import_symbol_ref rewritten" {
  let path = "fixtures/import_symbol_ref.vibe"
  let main_source = "import fixtures/modules/ref_lib_export.vibe { value, add }\nadd(value, 2)"
  let dep_path = "fixtures/modules/ref_lib_export.vibe"
  let dep_source = "export let value = 7\nlet add = (x: Int, y: Int) -> Int { x + y }\nexport { add }"
  let sources = [
    (path, main_source),
    (dep_path, dep_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "9", None)
}

test "preloaded real fixture: type_member_import_namespace_int" {
  let path = "fixtures/type_member_import_namespace_int.vibe"
  let main_source = "import vibe/prelude/int.vibe {  Int  }\n\nlet v = -6\nlet abs_v = v |> Int::abs\nlet pow_v = Int::pow(2, 3)\n\nabs_v + pow_v\n"
  let dep_path = "vibe/prelude/int.vibe"
  let dep_source = "export let Int::max = (a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else b\n}\n\nexport let max = (a: Int, b: Int) -> Int {\n  Int::max(a, b)\n}\n\nexport let Int::min = (a: Int, b: Int) -> Int {\n  if a < b {\n    a\n  } else b\n}\n\nexport let min = (a: Int, b: Int) -> Int {\n  Int::min(a, b)\n}\n\nlet rec int_pow = (base: Int, exp: Int) -> Int {\n  if exp <= 0 {\n    1\n  }\n  else if exp == 1 {\n    base\n  }\n  else if exp % 2 == 0 {\n    let half = int_pow(base, exp / 2)\n    half * half\n  } else base * int_pow(base, exp - 1)\n}\n\nexport let pow = (base: Int, exp: Int) -> Int {\n  int_pow(base, exp)\n}\n\nexport let Int::pow = (base: Int, exp: Int) -> Int {\n  int_pow(base, exp)\n}\n\nlet int_max_value: Int = 2305843009213693951\n\nexport let max_value: Int = int_max_value\n\nlet int_min_value: Int = 0 - 2305843009213693951 - 1\n\nexport let Int::abs = (x: Int) -> Int {\n  if x == int_min_value {\n    int_max_value\n  }\n  else if x < 0 {\n    0 - x\n  }\n  else x\n}\n\nexport let abs = (x: Int) -> Int {\n  Int::abs(x)\n}\n"
  let sources = [
    (path, main_source),
    (dep_path, dep_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "14", None)
}

test "preloaded real fixture: type_member_import_namespace_int_typed" {
  let path = "fixtures/type_member_import_namespace_int_typed.vibe"
  let main_source = "import vibe/prelude/int.vibe {  type Int  }\nlet v = 5\n\nDouble::to_int(v |> Int::to_double)\n"
  let dep_path = "vibe/prelude/int.vibe"
  let dep_source = "export let Int::max = (a: Int, b: Int) -> Int {\n  if a > b {\n    a\n  } else b\n}\n"
  let sources = [
    (path, main_source),
    (dep_path, dep_source)
  ]
  assert_preloaded_fixture_success(path, main_source, sources, "5", None)
}
