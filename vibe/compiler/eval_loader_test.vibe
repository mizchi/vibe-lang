//# Imports

import ./runtime / eval_loader {
  collect_exports, contains_str, load_and_parse
}

//# Misc

test "collect_exports includes re-exported names" {
  let exports = collect_exports(load_and_parse("export ./core { x, y }"))
  assert(contains_str(exports, "x"))
  assert(contains_str(exports, "y"))
}
