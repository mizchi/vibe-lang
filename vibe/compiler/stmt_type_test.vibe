//# Imports

import ./stmt_test_support.vibe {
  pt
}

//# Misc

test "type_name" {
  assert(String::equals(pt("Int"), "Int"))
}

test "type_unit" {
  assert(String::equals(pt("()"), "()"))
}

test "type_app_single" {
  assert(String::equals(pt("Array[Int]"), "Array[Int]"))
}

test "type_app_multi" {
  assert(String::equals(pt("Map[String, Int]"), "Map[String, Int]"))
}

test "type_fn" {
  assert(String::equals(pt("(Int) -> String"), "(Int) -> String"))
}

test "type_fn_multi_params" {
  assert(String::equals(pt("(Int, String) -> Bool"), "(Int, String) -> Bool"))
}

test "type_fn_unit_param" {
  assert(String::equals(pt("() -> Int"), "() -> Int"))
}

test "type_tuple" {
  assert(String::equals(pt("(Int, String)"), "(Int, String)"))
}

test "type_nested" {
  assert(String::equals(pt("Array[Option[Int]]"), "Array[Option[Int]]"))
}

test "type_fn_returning_fn" {
  assert(String::equals(pt("(Int) -> (String) -> Bool"), "(Int) -> (String) -> Bool"))
}
