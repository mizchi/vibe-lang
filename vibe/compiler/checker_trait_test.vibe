//# Imports

import ./checker_trait.vibe {
  register_builtin_traits, validate_impl_no_overlap, validate_supers_defined, satisfies_bound, check_bounds_satisfied
}

import ./types.vibe {
  Subst, Type, TypeEnv, trait_defined, trait_supers, type_implements_trait
}

//# Tests

test "register_builtin_traits defines Eq trait" {
  let env = register_builtin_traits(EnvEmpty)
  assert(trait_defined(env, "Eq"))
}

test "register_builtin_traits defines Ord trait with Eq super" {
  let env = register_builtin_traits(EnvEmpty)
  assert(trait_defined(env, "Ord"))
  let supers = trait_supers(env, "Ord")
  assert(eq(array_length(supers), 1))
  assert(string_equals(array_get(supers, 0), "Eq"))
}

test "Int implements Eq after registration" {
  let env = register_builtin_traits(EnvEmpty)
  assert(type_implements_trait(env, SubstEmpty, CtInt, "Eq"))
}

test "Int implements Ord after registration" {
  let env = register_builtin_traits(EnvEmpty)
  assert(type_implements_trait(env, SubstEmpty, CtInt, "Ord"))
}

test "Int implements Add after registration" {
  let env = register_builtin_traits(EnvEmpty)
  assert(type_implements_trait(env, SubstEmpty, CtInt, "Add"))
}

test "Bool implements Eq but NOT Add" {
  let env = register_builtin_traits(EnvEmpty)
  assert(type_implements_trait(env, SubstEmpty, CtBool, "Eq"))
  assert(not(type_implements_trait(env, SubstEmpty, CtBool, "Add")))
}

test "validate_impl_no_overlap returns true for new impl" {
  let env = register_builtin_traits(EnvEmpty)
  assert(validate_impl_no_overlap(env, "Eq", CtUnit))
}

test "validate_impl_no_overlap returns false for duplicate impl" {
  let env = register_builtin_traits(EnvEmpty)
  assert(not(validate_impl_no_overlap(env, "Eq", CtInt)))
}

test "validate_supers_defined with all defined returns empty" {
  let env = register_builtin_traits(EnvEmpty)
  let result = validate_supers_defined(env, ["Eq"])
  assert(eq(array_length(result), 0))
}

test "validate_supers_defined with undefined returns it" {
  let env = register_builtin_traits(EnvEmpty)
  let result = validate_supers_defined(env, ["Nonexistent"])
  assert(eq(array_length(result), 1))
  assert(string_equals(array_get(result, 0), "Nonexistent"))
}

test "satisfies_bound Int satisfies Eq" {
  let env = register_builtin_traits(EnvEmpty)
  assert(satisfies_bound(env, SubstEmpty, CtInt, "Eq"))
}

test "satisfies_bound Bool does NOT satisfy Add" {
  let env = register_builtin_traits(EnvEmpty)
  assert(not(satisfies_bound(env, SubstEmpty, CtBool, "Add")))
}

test "check_bounds_satisfied all satisfied returns empty" {
  let env = register_builtin_traits(EnvEmpty)
  let result = check_bounds_satisfied(env, SubstEmpty, CtInt, ["Eq", "Add"])
  assert(eq(array_length(result), 0))
}

test "check_bounds_satisfied some unsatisfied returns names" {
  let env = register_builtin_traits(EnvEmpty)
  let result = check_bounds_satisfied(env, SubstEmpty, CtBool, ["Eq", "Add"])
  assert(eq(array_length(result), 1))
  assert(string_equals(array_get(result, 0), "Add"))
}
