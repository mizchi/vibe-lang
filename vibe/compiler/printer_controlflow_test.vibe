//# Imports

import ./printer_test_support.vibe {
  roundtrip, roundtrip_eq
}

//# Misc

test "roundtrip let" {
  let ok = handle {
    roundtrip_eq("{ let x = 1; x }", "{ let x = 1; x }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip complex" {
  let ok = handle {
    roundtrip("if x > 0 { f(x - 1) } else { 0 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip throw" {
  let ok = handle {
    roundtrip("throw(\"error\")")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip break" {
  let ok = handle {
    roundtrip_eq("{ while true { break } }", "while true { break }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip break value" {
  let ok = handle {
    roundtrip_eq("{ while true { break 42 } }", "while true { break 42 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip continue" {
  let ok = handle {
    roundtrip_eq("{ while true { continue } }", "while true { continue }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip continue args" {
  let ok = handle {
    roundtrip_eq("{ while true { continue(1, 2) } }", "while true { continue(1, 2) }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip if without else" {
  let ok = handle {
    roundtrip("if true { 1 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip handle expression" {
  let ok = handle {
    roundtrip("handle { throw(\"oops\") } { Error(msg) => msg }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip for in expression" {
  let ok = handle {
    roundtrip("for x in [1, 2, 3] { x * 2 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip assign in block" {
  let ok = handle {
    roundtrip("{ let mut x = 1; x = x + 1; x }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip let rec in block" {
  let ok = handle {
    roundtrip("{ let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }; fact(5) }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip escaped string variants" {
  let ok = handle {
    roundtrip("\"a\\r\\\\\\\"\"")
  } {
    Error(_) => false
  }
  assert(ok)
}
