//# Imports

import ./printer_test_support.vibe {
  roundtrip, roundtrip_eq
}

//# Binding and misc control flow roundtrip tests

test "roundtrip let" {
  let ok = handle {
    roundtrip_eq("{ let x = 1; x }", "{ let x = 1; x }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip complex" {
  let ok = handle {
    roundtrip("if x > 0 { f(x - 1) } else { 0 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip throw" {
  let ok = handle {
    roundtrip("throw(\"error\")")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip if without else" {
  let ok = handle {
    roundtrip("if true { 1 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip assign in block" {
  let ok = handle {
    roundtrip("{ let mut x = 1; x = x + 1; x }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip let rec in block" {
  let ok = handle {
    roundtrip("{ let rec fact = (n) -> if n <= 1 { 1 } else { n * fact(n - 1) }; fact(5) }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip escaped string variants" {
  let ok = handle {
    roundtrip("\"a\\r\\\\\\\"\"")
  } {
    Error(_) => false
  }
  assert(ok)
}
