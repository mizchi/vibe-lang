//# Imports

import ../../../syntax/lexer.vibe {
  lex,
}

import ../../../syntax/parser.vibe {
  parse_program
}

import ../../../checker/checker_stmt.vibe {
  check_program
}

import ../../../codegen/gc/backend_body.vibe {
  compile_wasi_module_gc
}

//# Functions

export let compile_source_gc_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_wasi_module_gc(stmts, entry_name)
}
