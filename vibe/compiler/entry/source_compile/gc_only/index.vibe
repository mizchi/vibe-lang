//# Imports

import ../../../syntax/lexer.vibe {
  lex,
}

import ../../../syntax/parser.vibe {
  parse_program
}

import ../../../checker/checker_stmt.vibe {
  check_program
}

import ../../../codegen/gc/backend_body.vibe {
  compile_wasi_module_gc
}

import ../../../lower_loop.vibe {
  lower_loop_stmts
}

//# Functions

// The gc backend doesn't go through codegen/index.vibe so we lower here.
export let compile_source_gc_only = (source: String, entry_name: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  let lowered = lower_loop_stmts(stmts)
  compile_wasi_module_gc(lowered, entry_name)
}
