//# Imports

import ../../../syntax/lexer.vibe {
  lex,
}

import ../../../syntax/parser.vibe {
  parse_program
}

import ../../../checker/checker_stmt.vibe {
  check_program
}

import ../../../codegen/gc/index.vibe {
  compile_wasi_module_gc, resolve_gc_interp_stmts
}

//# Functions

export let compile_source_gc_only = (source: String, entry_name: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let raw_stmts = parse_program(tokens)
  let stmts = resolve_gc_interp_stmts(raw_stmts)
  let _ = check_program(stmts)
  compile_wasi_module_gc(stmts, entry_name)
}
