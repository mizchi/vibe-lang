//# Imports

import ../../../core/ast.vibe {
  Expr, Stmt
}

import ../../../syntax/lexer.vibe {
  lex,
}

import ../../../syntax/parser.vibe {
  parse_program
}

import ../../../checker/checker_stmt.vibe {
  check_program
}

import ../../../codegen/wasi/index.vibe {
  compile_wasi_module_linked_impl
}

import ./preprocess.vibe {
  strip_generic_type_params,
  expand_interp_stmts
}

import ../../../module_graph_path.vibe {
  dir_of_path,
  resolve_import_path,
  contains_name,
  get_export_name,
  path_to_module_name
}

let rec resolve_reexport_chain = (source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with { Error, Fs } {
  if depth > 10 { () }
  else {
    let source = perform Fs::ReadFile(source_path)
    let stmts = parse_program(lex(source))
    let source_dir = dir_of_path(source_path)
    let wanted_names = Array::slice([""], 0, 0)
    let mut wi = 0
    while wi < Array::length(items) {
      let (name, _) = Array::get(items, wi)
      Array::push(wanted_names, name)
      wi = wi + 1
    }
    let mut si = 0
    while si < Array::length(stmts) {
      match Array::get(stmts, si) {
        SLet(true, _, name, _, EFn(_, _, params, _, _, _)) => {
          if contains_name(wanted_names, name) {
            let export_name = get_export_name(items, name)
            Array::push(linked_imports, (module_name, export_name, Array::length(params), 1))
          }
        },
        SEnum(true, name, _) => {
          if contains_name(wanted_names, name) {
            Array::push(type_stmts, Array::get(stmts, si))
          }
        },
        SReExport(raw_path, inner_items) => {
          let filtered = Array::slice([("", None)], 0, 0)
          let mut fi = 0
          while fi < Array::length(inner_items) {
            let (iname, irename) = Array::get(inner_items, fi)
            if contains_name(wanted_names, iname) {
              Array::push(filtered, (iname, irename))
            }
            fi = fi + 1
          }
          if Array::length(filtered) > 0 {
            let resolved = resolve_import_path(source_dir, raw_path)
            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)
          }
        },
        _ => ()
      }
      si = si + 1
    }
  }
}

// Linked mode: direct deps become linked imports, not inlined.
// Returns (entry_wasm, linked_imports, linked_dep_specs) where linked_dep_specs

export {
  path_to_module_name,
  resolve_reexport_chain
}
