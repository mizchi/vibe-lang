//# Imports

import ../../../core/ast.vibe {
  Expr, Stmt
}

import ../../../syntax/lexer.vibe {
  lex,
}

import ../../../syntax/parser.vibe {
  parse_program,
  parse
}

import ../../../checker/checker_stmt.vibe {
  check_program
}

import ../../../codegen/wasi/index.vibe {
  compile_wasi_module_impl
}

//# Functions

// Strip generic type params from EFn before type checking
let strip_generic_type_params = (stmts: Array[Stmt]) -> Unit {
  let empty_tp = Array::slice([""], 0, 0)
  let empty_bounds = Array::slice([("", Array::slice([""], 0, 0))], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {
        EFn(tparams, _, params, ret, eff, body) => {
          if Array::length(tparams) > 0 {
            Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))
          }
        },
        _ => ()
      },
      _ => ()
    }
    i = i + 1
  }
}

// Expand EStringInterp: replace expr parts (odd indices) with parsed Expr
let rec rewrite_interp = (e: Expr) -> Expr with { Error } {
  match e {
    EStringInterp(parts) => {
      let plen = Array::length(parts)
      let mut result = EString("")
      let mut has = false
      let mut i = 0
      while i < plen {
        let part = Array::get(parts, i)
        if i % 2 == 0 {
          if String::length(part) > 0 {
            if has { result = ECall(EIdent("String::concat"), [result, EString(part)]) }
            else { result = EString(part); has = true }
          }
        } else {
          let part_tokens = lex(part)
          let part_expr = parse(part_tokens)
          let ep = ECall(EIdent("__to_string"), [part_expr])
          if has { result = ECall(EIdent("String::concat"), [result, ep]) }
          else { result = ep; has = true }
        }
        i = i + 1
      }
      result
    },
    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),
    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),
    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),
    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),
    ECall(callee, args) => {
      let new_args = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(args) {
        ArrayBuilder::push(new_args, rewrite_interp(Array::get(args, i)))
        i = i + 1
      }
      ECall(rewrite_interp(callee), ArrayBuilder::freeze(new_args))
    },
    EIf(c, t, e) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e)),
    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),
    EMatch(scrut, arms) => {
      let new_arms = ArrayBuilder::new()
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        ArrayBuilder::push(new_arms, (pat, rewrite_interp(body)))
        i = i + 1
      }
      EMatch(rewrite_interp(scrut), ArrayBuilder::freeze(new_arms))
    },
    _ => e
  }
}

let expand_interp_stmts = (stmts: Array[Stmt]) -> Unit with { Error } {
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SLet(exp, is_rec, name, ann, expr) => {
        Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))
      },
      STest(name, expr) => {
        Array::set(stmts, i, STest(name, rewrite_interp(expr)))
      },
      SBench(name, expr) => {
        Array::set(stmts, i, SBench(name, rewrite_interp(expr)))
      },
      _ => ()
    }
    i = i + 1
  }
}

export let compile_source_wasi_only = (source: String, entry_name: String) -> Bytes with { Error } {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  strip_generic_type_params(stmts)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}

// Path utilities (inlined from loader to avoid import count issues)
let dir_of_path = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 { "" }
  else { file_path[0:idx] }
}

let normalize_path = (path: String) -> String {
  let parts = Array::slice([""], 0, 0)
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    if i == len || String::char_code_at(path, i) == 47 {
      let part = path[start:i]
      if String::length(part) == 0 || part == "." {
        ()
      } else if part == ".." {
        if Array::length(parts) > 0 {
          parts = Array::slice(parts, 0, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  let mut out = ""
  i = 0
  while i < Array::length(parts) {
    if i > 0 {
      out = String::concat(out, "/")
    }
    out = String::concat(out, Array::get(parts, i))
    i = i + 1
  }
  out
}

let resolve_import_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  let joined = if len >= 2 && raw_path[0:2] == "./" {
    if base_dir == "" { raw_path }
    else { String::concat(base_dir, String::concat("/", raw_path)) }
  } else if len >= 3 && raw_path[0:3] == "../" {
    if base_dir == "" { raw_path }
    else { String::concat(base_dir, String::concat("/", raw_path)) }
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") { normalized }
  else { String::concat(normalized, ".vibe") }
}

let contains_path = (visited: Array[String], path: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(visited) {
    if Array::get(visited, i) == path {
      found = true
    }
    i = i + 1
  }
  found
}

// Recursively collect sources in dependency order (deps first)
let rec collect_sources = (path: String, sources: Array[(String, String)], visited: Array[String]) -> Unit with { Error, Fs } {
  if contains_path(visited, path) { () }
  else {
    Array::push(visited, path)
    let source = perform Fs::ReadFile(path)
    let stmts = parse_program(lex(source))
    let base_dir = dir_of_path(path)
    // Process imports first (depth-first)
    let mut i = 0
    while i < Array::length(stmts) {
      match Array::get(stmts, i) {
        SImport(raw_path, _) => {
          let resolved = resolve_import_path(base_dir, raw_path)
          collect_sources(resolved, sources, visited)
        },
        _ => ()
      }
      i = i + 1
    }
    // Then add this module
    Array::push(sources, (path, source))
  }
}

// Merge sources: parse each, strip SImport/SReExport, concatenate stmts
let merge_sources = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {
  let merged = ArrayBuilder::new()
  let mut si = 0
  while si < Array::length(sources) {
    let (_, src) = Array::get(sources, si)
    let stmts = parse_program(lex(src))
    let mut j = 0
    while j < Array::length(stmts) {
      match Array::get(stmts, j) {
        SImport(_, _) => (),
        SReExport(_, _) => (),
        SAliasDecl(_, _) => (),
        _ => ArrayBuilder::push(merged, Array::get(stmts, j))
      }
      j = j + 1
    }
    si = si + 1
  }
  ArrayBuilder::freeze(merged)
}

export let compile_file_wasi_only = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {
  let sources = Array::slice([("", "")], 0, 0)
  let visited = Array::slice([""], 0, 0)
  collect_sources(entry_path, sources, visited)
  let stmts = merge_sources(sources)
  strip_generic_type_params(stmts)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}
