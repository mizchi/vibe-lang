//# Imports

import .. / .. / .. / checker / checker_stmt.vibe {
  check_program
}

import .. / .. / .. / codegen / wasi {
  compile_wasi_module_linked_impl
}

import .. / .. / .. / core / ast.vibe {
  Expr, Stmt
}

import .. / .. / .. / module_graph_path.vibe {
  contains_path, dir_of_path, path_to_module_name, resolve_import_path
}

import .. / .. / .. / syntax / lexer.vibe {
  lex
}

import .. / .. / .. / syntax / parser.vibe {
  parse_program
}

import ./linked_helpers.vibe {
  resolve_reexport_chain
}

import ./path_utils.vibe {
  empty_stmt_array
}

import ./preprocess.vibe {
  expand_interp_stmts, strip_generic_type_params
}

//# Functions

let read_program = (path: String) -> Array[Stmt] with { Error, Fs } {
  let source = perform Fs::ReadFile(path)
  parse_program(lex(source))
}

let append_stmt_array = (dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

let collect_direct_dep_paths = (entry_stmts: Array[Stmt], entry_dir: String) -> Array[String] {
  let dep_paths = Array::slice([
    ""
  ], 0, 0)
  let mut ei = 0
  while ei < Array::length(entry_stmts) {
    match Array::get(entry_stmts, ei) {
      SImport(raw_path, items) => if Array::length(items) > 0 {
        let resolved = resolve_import_path(entry_dir, raw_path)
        if !contains_path(dep_paths, resolved) {
          Array::push(dep_paths, resolved)
        }
      }
      ,
      SReExport(raw_path, _) => {
        let resolved = resolve_import_path(entry_dir, raw_path)
        if !contains_path(dep_paths, resolved) {
          Array::push(dep_paths, resolved)
        }
      },
      _ => ()
    }
    ei = ei + 1
  }
  dep_paths
}

let collect_linked_dep_artifacts = (dep_paths: Array[String]) -> (Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)])with { Error, Fs } {
  let linked_imports = Array::slice([
    ("", "", 0, 0)
  ], 0, 0)
  let linked_dep_specs = Array::slice([
    ("", "")
  ], 0, 0)
  let resolved_type_stmts = Array::slice([
    SExpr(EInt(0))
  ], 0, 0)
  let mut di = 0
  while di < Array::length(dep_paths) {
    let dep_path = Array::get(dep_paths, di)
    let dep_stmts = read_program(dep_path)
    let module_name = path_to_module_name(dep_path)
    let dep_dir = dir_of_path(dep_path)
    let mut has_linked = false
    let mut dsi = 0
    while dsi < Array::length(dep_stmts) {
      match Array::get(dep_stmts, dsi) {
        SLet(true, _, name, _, EFn(_, _, params, _, _, _)) => {
          Array::push(linked_imports, (module_name, name, Array::length(params), 1))
          has_linked = true
        },
        SReExport(raw_path, items) => {
          let resolved = resolve_import_path(dep_dir, raw_path)
          resolve_reexport_chain(resolved, items, module_name, linked_imports, resolved_type_stmts, 0)
          has_linked = true
        },
        SEnum(true, _, _) => Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))
        ,
        _ => ()
      }
      dsi = dsi + 1
    }
    if has_linked {
      Array::push(linked_dep_specs, (module_name, dep_path))
    }
    di = di + 1
  }
  (resolved_type_stmts, linked_imports, linked_dep_specs)
}

export let collect_linked_compile_inputs = (entry_path: String) -> (Array[Stmt], Array[Stmt], Array[(String, String, Int, Int)], Array[(String, String)])with { Error, Fs } {
  let entry_stmts = read_program(entry_path)
  let dep_paths = collect_direct_dep_paths(entry_stmts, dir_of_path(entry_path))
  let (resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_dep_artifacts(dep_paths)
  (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs)
}

export let compile_file_wasi_linked_artifacts = (entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)])with { Error, Fs } {
  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(entry_path)
  let stmts = empty_stmt_array()
  append_stmt_array(stmts, resolved_type_stmts)
  append_stmt_array(stmts, entry_stmts)
  strip_generic_type_params(stmts)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  let wasm = compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([
    ("", "")
  ], 0, 0), linked_imports, false)
  (wasm, linked_imports, linked_dep_specs)
}

export let compile_file_wasi_linked = (entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)])with { Error, Fs } {
  let (wasm, linked_imports, _) = compile_file_wasi_linked_artifacts(entry_path, entry_name)
  (wasm, linked_imports)
}
