//# Imports

import .. / .. / .. / checker / checker_stmt.vibe {
  check_program
}

import .. / .. / .. / codegen / wasi {
  compile_wasi_module_impl, compile_wasi_module_rc_impl
}

import .. / .. / .. / syntax / lexer.vibe {
  lex
}

import .. / .. / .. / syntax / parser.vibe {
  parse_program
}

import ./preprocess_interp.vibe {
  expand_interp_stmts
}

import ./preprocess_strip.vibe {
  strip_generic_type_params
}

//# Functions

export let compile_source_wasi_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  // Check before stripping generic type params (see merge_sources.vibe).
  let _ = check_program(stmts)
  strip_generic_type_params(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}

// ADR-0055 #493 cutover: same pipeline on the Perceus RC codegen path. Lets the
// selfbuild / bootstrap / e2e gates compile real programs (incl. the whole
// compiler) under RC via an env toggle in cli_main — the full-scale validity +
// correctness signal the memory-limited test probes cannot produce.
export let compile_source_wasi_only_rc: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  expand_interp_stmts(stmts)
  let _ = check_program(stmts)
  strip_generic_type_params(stmts)
  compile_wasi_module_rc_impl(stmts, entry_name)
}
