//# Imports

import .. / .. / .. / core / ast.vibe {
  Expr
}

import ./preprocess_interp_string.vibe {
  rewrite_interp_string
}

//# Functions

export let rec rewrite_interp: (Expr) -> Expr with { Error } = (e) -> {
  match e {
    EStringInterp(parts) => rewrite_interp_string(parts),
    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),
    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),
    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),
    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),
    ECall(callee, args) => ECall(rewrite_interp(callee), for arg in args {
      rewrite_interp(arg)
    }),
    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),
    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),
    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {
      let (pat, body) = arm; (pat, rewrite_interp(body))
    }),
    _ => e
  }
}
