//# Imports

import .. / .. / .. / core / ast.vibe {
  Expr
}

//# Functions

let concat_exprs: (Expr, Expr) -> Expr = (lhs, rhs) -> {
  let b = ArrayBuilder::new()
  ArrayBuilder::push(b, lhs)
  ArrayBuilder::push(b, rhs)
  let args = ArrayBuilder::freeze(b)
  ECall(EIdent("String::concat"), args)
}

export let fold_interp_exprs_loop: (Array[Expr], Int, Expr, Int) -> Expr = (result_arr, result_len, result0, j0) -> {
  let mut result = result0
  let mut j = j0
  while j < result_len {
    let rhs = Array::get(result_arr, j)
    result = concat_exprs(result, rhs)
    j = j + 1
  }
  result
}
