//# Imports

import .. / .. / .. / core / ast.vibe {
  Expr, Stmt
}

import .. / .. / .. / syntax / parser.vibe {
  parse_stmt
}

import .. / .. / .. / syntax / token.vibe {
  Token
}

//# Functions

export let parse_interp_expr: (Array[Token]) -> Expr with { Error } = (tokens) -> {
  let (stmt, _) = parse_stmt(tokens, 0)
  match stmt {
    SExpr(expr) => expr,
    _ => throw("expected interpolation expression")
  }
}
