//# Imports

import .. / .. / .. / core / ast.vibe {
  Expr
}

import ./preprocess_interp_string_fold_nonempty.vibe {
  fold_interp_exprs_nonempty
}

//# Functions

export let fold_interp_exprs = (result_arr: Array[Expr]) -> Expr {
  let result_len = Array::length(result_arr)
  if result_len == 0 {
    EString("")
  } else {
    fold_interp_exprs_nonempty(result_arr, result_len)
  }
}
