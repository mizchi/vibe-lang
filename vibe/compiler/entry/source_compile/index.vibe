//# Imports

import ../../syntax/lexer.vibe {
  lex,
}

import ../../syntax/parser.vibe {
  parse_program
}

import ../../checker/checker_stmt.vibe {
  check_program
}

import ../../codegen/index.vibe {
  compile_module
}

import ../../codegen/wasi/index.vibe {
  compile_wasi_module_impl
}

import ../../core/dce.vibe {
  dce_stmts
}

//# Functions

export let compile_source: (String) -> Bytes with { Error } = (source) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_module(stmts)
}

export let compile_source_wasi: (String, String) -> Bytes with { Error } = (source, entry_name) -> {
  let tokens = lex(source)
  let stmts = parse_program(tokens)
  let _ = check_program(stmts)
  compile_wasi_module_impl(stmts, entry_name)
}

export let compile_source_wasi_mode: (String, String, String) -> Bytes with { Error } = (source, entry_name, mode) -> {
  if mode == "mvp" {
    let tokens = lex(source)
    let stmts = parse_program(tokens)
    let _ = check_program(stmts)
    let pruned_stmts = dce_stmts(stmts, [entry_name])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_source_wasi(source, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}
