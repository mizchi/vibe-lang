//# Functions

let empty_stmt_array: () -> Array[Stmt] = () -> {
  Array::slice([
    SExport(["_dummy"])
  ], 0, 0)
}

let seed_type_db: (TypeDb, String, String, Array[(String, String)]) -> TypeDb = (db, main_path, main_source, sources) -> {
  let mut seeded = db
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    seeded = db_set_source(seeded, path, source)
    i = i + 1
  }
  db_set_source(seeded, main_path, main_source)
}

let flatten_source_groups: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (source_groups) -> {
  let flat = Array::slice([("", "")], 0, 0)
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(flat, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  flat
}

let normalize_source_groups: (Array[(String, Array[(String, String)])], String, String) -> Array[(String, Array[(String, String)])] = (source_groups, main_path, main_source) -> {
  let normalized = Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
  let mut found = false
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (group_name, sources) = Array::get(source_groups, gi)
    let next_sources = Array::slice([("", "")], 0, 0)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == main_path {
        Array::push(next_sources, (path, main_source))
        found = true
      } else {
        Array::push(next_sources, (path, source))
      }
      si = si + 1
    }
    Array::push(normalized, (group_name, next_sources))
    gi = gi + 1
  }
  if !found {
    let entry_sources = Array::slice([("", "")], 0, 0)
    Array::push(entry_sources, (main_path, main_source))
    Array::push(normalized, ("entry", entry_sources))
  }
  normalized
}

let contains_source_path: (Array[(String, String)], String) -> Bool = (sources, target_path) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(sources) && !found {
    let (path, _) = Array::get(sources, i)
    if path == target_path {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let filter_source_groups: (Array[(String, Array[(String, String)])], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (source_groups, ordered_sources) -> {
  let filtered_groups = Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (group_name, sources) = Array::get(source_groups, gi)
    let next_sources = Array::slice([("", "")], 0, 0)
    let mut si = 0
    while si < Array::length(sources) {
      let pair = Array::get(sources, si)
      let (path, _) = pair
      if contains_source_path(ordered_sources, path) {
        Array::push(next_sources, pair)
      }
      si = si + 1
    }
    if Array::length(next_sources) > 0 {
      Array::push(filtered_groups, (group_name, next_sources))
    }
    gi = gi + 1
  }
  filtered_groups
}

export let source_group_total_source_count: (Array[(String, Array[(String, String)])]) -> Int = (source_groups) -> {
  let mut total = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    total = total + Array::length(sources)
    gi = gi + 1
  }
  total
}

export let source_group_ordered_source_count: (String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (main_source, main_path, source_groups) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  Array::length(ordered_sources)
}

export let source_group_filtered_group_count: (String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (main_source, main_path, source_groups) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  Array::length(filtered_groups)
}

let string_array_contains_local: (Array[String], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
// are the locals the export-rename plan already rewrites; the inline copy gets
// the target file's export renames applied first.
let append_inline_import_alias_collision_defs: (Array[Stmt], String, Array[Stmt], Array[(String, String)], ExportRenamePlan, Array[String]) -> Unit with { Error } = (merged, current_path, stmts, sources, plan, excluded_locals) -> {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = Array::slice([
    ""
  ], 0, 0)
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains_local(emitted, local) && !string_array_contains_local(excluded_locals, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      let source = source_lookup_or_throw(sources, resolved)
      let source_stmts = namespace_private_value_stmts(
        resolved,
        apply_export_renames_stmts(
          parse_program(lex(source)),
          export_plan_renames_for(plan, resolved)
        )
      )
      let mut j = 0
      let mut done = false
      while j < Array::length(source_stmts) && !done {
        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
          Some(local_stmt) => {
            Array::push(merged, local_stmt)
            Array::push(emitted, local)
            done = true
          },
          None => ()
        }
        j = j + 1
      }
    }
    i = i + 1
  }
}

export let prepare_modules_cached: (TypeDb, String, String, Array[(String, String)]) -> TypeDb with { Error } = (db, main_path, main_source, sources) -> {
  let seeded = seed_type_db(db, main_path, main_source, sources)
  db_typecheck(seeded, main_path)
}

let prepare_modules_persistent_fs_cached: (TypeDb, String, String, Array[(String, String)]) -> TypeDb with { Error, Fs } = (db, main_path, main_source, sources) -> {
  let seeded = seed_type_db(db, main_path, main_source, sources)
  db_typecheck_fs(seeded, main_path)
}

export let source_group_prepare_typecheck_count: (TypeDb, String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (db, main_source, main_path, source_groups) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let next_db = prepare_modules_cached(
    db,
    main_path,
    main_source,
    ordered_sources
  )
  db_typecheck_count(next_db)
}

export let grouped_source_merged_len: (TypeDb, String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (db, main_source, main_path, source_groups) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let next_db = prepare_modules_cached(
    db,
    main_path,
    main_source,
    ordered_sources
  )
  let (merged_source, _, _) = db_grouped_merged_source(next_db, filtered_groups)
  String::length(merged_source)
}

export let source_group_module_source_len: (TypeDb, String, String, Array[(String, Array[(String, String)])]) -> Int with { Error } = (db, main_source, main_path, source_groups) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)
  let (module_source, _) = db_module_source(module_db, merge_fingerprint, merged_source)
  String::length(module_source)
}

export let compile_with_modules: (String, String, Array[(String, String)]) -> Bytes with { Error } = (main_source, main_path, sources) -> {
  let (bytes, _) = compile_with_modules_cached(db_new(), main_source, main_path, sources)
  bytes
}

export let compile_with_modules_wasi: (String, String, Array[(String, String)], String) -> Bytes with { Error } = (main_source, main_path, sources, entry_name) -> {
  let (bytes, _) = compile_with_modules_wasi_cached(db_new(), main_source, main_path, sources, entry_name)
  bytes
}

let artifact_fingerprint_from_source: (String) -> String = (source) -> {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(
    __to_string(len),
    String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2))))
  )
}

let build_merge_fingerprint_inline: (Array[(String, String)]) -> String = (sources) -> {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, i)
    let next = String::concat(
      acc,
      String::concat("|", artifact_fingerprint_from_source(source))
    )
    acc = artifact_fingerprint_from_source(next)
    i = i + 1
  }
  acc
}

let build_merged_stmts_inline: (Array[(String, String)]) -> Array[Stmt] with { Error } = (sources) -> {
  let merged = empty_stmt_array()
  let source_count = Array::length(sources)
  // #716: parse once, then build the whole-program export-rename plan (last
  // source is the entry) before appending any file.
  let file_paths = Array::slice([
    ""
  ], 0, 0)
  let file_stmts = Array::slice([
    empty_stmt_array()
  ], 0, 0)
  let mut pi = 0
  while pi < source_count {
    let (path, source) = Array::get(sources, pi)
    Array::push(file_paths, path)
    Array::push(file_stmts, parse_program(lex(source)))
    pi = pi + 1
  }
  let plan_entry = if source_count > 0 {
    Array::get(file_paths, source_count - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut si = 0
  while si < source_count {
    let path = Array::get(file_paths, si)
    let stmts = Array::get(file_stmts, si)
    let is_entry_source = si == source_count - 1
    let export_renamed = if is_entry_source {
      stmts
    } else {
      apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))
    }
    let namespaced_stmts = if is_entry_source {
      export_renamed
    } else {
      namespace_private_value_stmts(path, export_renamed)
    }
    let import_renames = collect_import_value_renames(plan, path, stmts)
    let skipped_locals = collect_import_alias_collision_locals(stmts)
    append_inline_import_alias_collision_defs(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))
    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)
    si = si + 1
  }
  merged
}

let prune_entry_stmts: (Array[Stmt], String) -> Array[Stmt] = (stmts, entry_name) -> {
  dce_stmts(stmts, [entry_name])
}

export let closure_ordered_source_count: (String, String, Array[(String, String)]) -> Int with { Error } = (main_source, main_path, sources) -> {
  Array::length(collect_inline_sources_ordered(main_path, main_source, sources))
}

export let closure_merged_stmt_count: (String, String, Array[(String, String)]) -> Int with { Error } = (main_source, main_path, sources) -> {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  Array::length(merged_stmts)
}

export let closure_pruned_stmt_count: (String, String, Array[(String, String)], String) -> Int with { Error } = (main_source, main_path, sources, entry_name) -> {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
  Array::length(pruned_stmts)
}

export let source_group_pruned_stmt_count: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> Int with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let _ = db
  let merged_stmts = build_merged_stmts_inline(ordered_sources)
  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
  Array::length(pruned_stmts)
}

export let compile_with_modules_cached: (TypeDb, String, String, Array[(String, String)]) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources) -> {
  let next_db = prepare_modules_cached(db, main_path, main_source, sources)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let (merged_source, merge_fingerprint, merge_db) = db_merged_source(next_db, main_path, ordered_sources)
  let (module_source, codegen_db) = db_module_source(merge_db, merge_fingerprint, merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(module_source)
  match db_load_artifact(codegen_db, main_path, "module", "", artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let stmts = parse_program(lex(module_source))
      let bytes = compile_module(stmts)
      (bytes, db_store_artifact(codegen_db, main_path, "module", "", artifact_fingerprint, bytes))
    }
  }
}

export let compile_with_modules_wasi_cached: (TypeDb, String, String, Array[(String, String)], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name) -> {
  let next_db = prepare_modules_cached(db, main_path, main_source, sources)
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(
    String::concat(merge_fingerprint, String::concat("|", entry_name))
  )
  match db_load_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export let compile_with_closure_sources_wasi_cached: (TypeDb, String, String, Array[(String, String)], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name) -> {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_fingerprint = artifact_fingerprint_from_source(
    String::concat(merge_fingerprint, String::concat("|", entry_name))
  )
  match db_load_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
      let bytes = compile_wasi_module(pruned_stmts, entry_name)
      (bytes, db_store_artifact(next_db, main_path, "wasi", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export let compile_with_closure_sources_wasi_mode_cached: (TypeDb, String, String, Array[(String, String)], String, String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, sources, entry_name, mode) -> {
  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)
  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)
  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)
  let artifact_kind = if mode == "mvp" {
    "wasi-mvp"
  } else if mode == "no-dce" {
    "wasi"
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let artifact_fingerprint = artifact_fingerprint_from_source(
    String::concat(merge_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode))))
  )
  match db_load_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, next_db),
    None => {
      let merged_stmts = build_merged_stmts_inline(ordered_sources)
      let bytes = if mode == "mvp" {
        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
        compile_wasi_module_impl(pruned_stmts, entry_name)
      } else {
        compile_wasi_module(merged_stmts, entry_name)
      }
      (bytes, db_store_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))
    }
  }
}

