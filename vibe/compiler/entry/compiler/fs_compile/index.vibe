    }
  }
}

export let compile_with_source_groups_via_module_source_wasi_unchecked_cached: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)
  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(
    String::concat(module_source, String::concat("|", entry_name))
  )
  match db_load_artifact(codegen_db, main_path, "wasi-module-source", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let module_stmts = parse_program(lex(module_source))
      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)
      let bytes = compile_wasi_module_impl(pruned_stmts, entry_name)
      (bytes, db_store_artifact(codegen_db, main_path, "wasi-module-source", entry_name, artifact_fingerprint, bytes))
    }
  }
}

// ADR-0055 #493 cutover: RC-codegen variant of the module-source self-compile
// path. Identical pipeline to the function above, but emits via the Perceus RC
// backend (compile_wasi_module_rc_impl). This is the real vehicle the selfhost
// compiler uses to compile *itself* (build_selfhost_cli_adapter_bytes), so an
// RC variant gives the whole-compiler-under-RC validity signal for the cutover.
// A distinct artifact key ("wasi-module-source-rc") keeps the RC and default
// caches from colliding.
export let compile_with_source_groups_via_module_source_wasi_unchecked_rc: (TypeDb, String, String, Array[(String, Array[(String, String)])], String) -> (Bytes, TypeDb) with { Error } = (db, main_source, main_path, source_groups, entry_name) -> {
  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)
  let ordered_sources = collect_inline_sources_ordered(
    main_path,
    main_source,
    flatten_source_groups(normalized_groups)
  )
  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)
  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)
  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
  let artifact_fingerprint = artifact_fingerprint_from_source(
    String::concat(module_source, String::concat("|", entry_name))
  )
  match db_load_artifact(codegen_db, main_path, "wasi-module-source-rc", entry_name, artifact_fingerprint) {
    Some(bytes) => (bytes, codegen_db),
    None => {
      let module_stmts = parse_program(lex(module_source))
      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)
      let bytes = compile_wasi_module_rc_impl(pruned_stmts, entry_name)
      (bytes, db_store_artifact(codegen_db, main_path, "wasi-module-source-rc", entry_name, artifact_fingerprint, bytes))
    }
  }
}

export let compile_file_fs: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)
  bytes
}

export let compile_file_fs_module: (String) -> Bytes with { Error, Fs } = (entry_path) -> {
  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)
  bytes
}

export let prepare_file_fs_cached: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, entry_path) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
}

let prepare_file_fs_from_source_groups_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error } = (db, entry_path, source_groups) -> {
  let sources = flatten_source_groups(source_groups)
  let main_source = source_lookup_or_throw(sources, entry_path)
  prepare_modules_cached(db, entry_path, main_source, sources)
}

let prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {
  let sources = flatten_source_groups(source_groups)
  let main_source = source_lookup_or_throw(sources, entry_path)
  prepare_modules_persistent_fs_cached(db, entry_path, main_source, sources)
}

let compile_file_fs_cached_slow: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_fs_compile_wasi_artifact_fingerprint(
    source_groups,
    entry_name
  )
  match load_persistent_artifact("fs-compile-wasi", entry_name, persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)
      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)
      match db_load_artifact(codegen_db, entry_path, "wasi", entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, codegen_db),
        None => {
          let merged_stmts = parse_program(lex(merged_source))
          let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)
          let bytes = compile_wasi_module(pruned_stmts, entry_name)
          store_persistent_artifact(
            "fs-compile-wasi",
            entry_name,
            persistent_artifact_fingerprint,
            bytes
          )
          (bytes, db_store_artifact(codegen_db, entry_path, "wasi", entry_name, artifact_fingerprint, bytes))
        }
      }
    }
  }
}

export let compile_file_fs_cached: (TypeDb, String, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path, entry_name) -> {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
      match load_persistent_artifact(
        "fs-compile-wasi",
        entry_name,
        build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(
          source_groups_fingerprint,
          entry_name
        )
      ) {
        Some(bytes) => (bytes, db),
        None => compile_file_fs_cached_slow(db, entry_path, entry_name)
      },
    None => compile_file_fs_cached_slow(db, entry_path, entry_name)
  }
}

let compile_file_fs_module_cached_slow: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_fs_compile_module_artifact_fingerprint(
    source_groups
  )
  match load_persistent_artifact("fs-compile-module", "", persistent_artifact_fingerprint) {
    Some(bytes) => (bytes, db),
    None => {
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)
      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)
      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)
      match db_load_artifact(codegen_db, entry_path, "module", "", artifact_fingerprint) {
        Some(bytes) => (bytes, codegen_db),
        None => {
          let merged_stmts = parse_program(lex(module_source))
          let bytes = compile_module(merged_stmts)
          store_persistent_artifact(
            "fs-compile-module",
            "",
            persistent_artifact_fingerprint,
            bytes
          )
          (bytes, db_store_artifact(codegen_db, entry_path, "module", "", artifact_fingerprint, bytes))
        }
      }
    }
  }
}

export let compile_file_fs_module_cached: (TypeDb, String) -> (Bytes, TypeDb) with { Error, Fs } = (db, entry_path) -> {
  match load_persistent_source_group_fingerprint_if_valid(entry_path) {
    Some(source_groups_fingerprint) =>
      match load_persistent_artifact(
        "fs-compile-module",
        "",
        build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(
          source_groups_fingerprint
        )
      ) {
        Some(bytes) => (bytes, db),
        None => compile_file_fs_module_cached_slow(db, entry_path)
      },
    None => compile_file_fs_module_cached_slow(db, entry_path)
  }
}
