//# Types

export effect Profiler {
  NowUs -> Int
}

//# Functions

let profiler_now_us: () -> Int with { Profiler } = () -> {
  perform Profiler::NowUs
}

let elapsed_us_since: (Int) -> Int with { Profiler } = (start_us) -> {
  let elapsed = profiler_now_us() - start_us
  if elapsed < 0 {
    0
  } else {
    elapsed
  }
}

let artifact_fingerprint_from_source: (String) -> String = (source) -> {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(
    __to_string(len),
    String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2))))
  )
}

let seed_type_db_from_source_groups: (TypeDb, Array[(String, Array[(String, String)])]) -> TypeDb = (db, source_groups) -> {
  let mut seeded = db
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      seeded = db_set_source(seeded, path, source)
      si = si + 1
    }
    gi = gi + 1
  }
  seeded
}

let append_stmt_array: (Array[Stmt], Array[Stmt]) -> Unit = (dst, src) -> {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

let flatten_source_groups_local: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (source_groups) -> {
  let flat = Array::slice([
    ("", "")
  ], 0, 0)
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(flat, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  flat
}

let string_array_contains: (Array[String], String) -> Bool = (items, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(items) && !found {
    if Array::get(items, i) == target {
      found = true
    } else {
      i = i + 1
    }
  }
  found
}

let lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    if path == target_path {
      found = Some(source)
      i = Array::length(sources)
    } else {
      i = i + 1
    }
  }
  found
}

let parse_program_for_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {
  handle {
    // Interior-line breakpoints (span-arc step5): parse via the span-aware
    // `parse_program_located` so EIdent nodes carry real source char-offsets
    // (offset_to_line then maps them to lines for `vibe::dbg_line`). Offsets are
    // inert for normal codegen (no codegen path reads them), so the default
    // wasm output is unchanged — only the gated break path consumes them.
    let (tokens, starts, _ends) = lex_with_offsets(source)
    parse_program_located(tokens, starts, source)
  } with Error {
    Throw(msg) => throw(String::concat(String::concat(path, ": "), msg))
  }
}

// #716: collision-def fallback (see merge_sources.vibe). `excluded_locals`
// are the locals the export-rename plan already rewrites; the inline copy gets
// the target file's export renames applied first.
let append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)], ExportRenamePlan, Array[String]) -> Unit with { Error } = (merged, current_path, stmts, sources, plan, excluded_locals) -> {
  let refs = collect_import_alias_collision_refs(stmts)
  let emitted = Array::slice([
    ""
  ], 0, 0)
  let base_dir = dir_of_path(current_path)
  let mut i = 0
  while i < Array::length(refs) {
    let (raw_path, original, local) = Array::get(refs, i)
    if !string_array_contains(emitted, local) && !string_array_contains(excluded_locals, local) {
      let resolved = resolve_import_path(base_dir, raw_path)
      match lookup_source_by_path(sources, resolved) {
        Some(source) => {
          let source_stmts = namespace_private_value_stmts(
            resolved,
            apply_export_renames_stmts(
              parse_program_for_path(resolved, source),
              export_plan_renames_for(plan, resolved)
            )
          )
          let mut j = 0
          let mut done = false
          while j < Array::length(source_stmts) && !done {
            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {
              Some(local_stmt) => {
                Array::push(merged, local_stmt)
                Array::push(emitted, local)
                done = true
              },
              None => ()
            }
            j = j + 1
          }
        },
        None => ()
      }
    }
    i = i + 1
  }
}

// #716: parse every source once and build the export-rename plan for the whole
// program (the merge output of one file depends on the export surfaces of ALL
// files: ambiguous exported names are renamed at their defs and at importing
// files' references).
let parse_sources_for_merge: (Array[(String, String)]) -> (Array[String], Array[Array[Stmt]]) with { Error } = (sources) -> {
  let file_paths = Array::slice([
    ""
  ], 0, 0)
  let file_stmts = Array::slice([
    empty_stmt_array()
  ], 0, 0)
  let mut si = 0
  while si < Array::length(sources) {
    let (path, source) = Array::get(sources, si)
    Array::push(file_paths, path)
    Array::push(file_stmts, parse_program_for_path(path, source))
    si = si + 1
  }
  (file_paths, file_stmts)
}

// One file's contribution to the merged program. `stmts` are the file's parsed
// statements, `is_entry_source` mirrors the pre-#716 per-group entry rule
// (entry keeps its private names), and `plan`/`sources` drive the export-name
// rewriting and the collision-def fallback.
let append_merged_stmts_for_file: (Array[Stmt], String, Array[Stmt], Bool, ExportRenamePlan, Array[(String, String)]) -> Unit with { Error } = (merged, path, stmts, is_entry_source, plan, sources) -> {
  let export_renamed = if is_entry_source {
    stmts
  } else {
    apply_export_renames_stmts(stmts, export_plan_renames_for(plan, path))
  }
  let namespaced_stmts = if is_entry_source {
    export_renamed
  } else {
    namespace_private_value_stmts(path, export_renamed)
  }
  if stmts_have_import_deep(stmts) {
    let import_renames = collect_import_value_renames(plan, path, stmts)
    let skipped_locals = collect_import_alias_collision_locals(stmts)
    append_import_alias_collision_defs_from_sources(merged, path, stmts, sources, plan, import_value_rename_locals(import_renames))
    append_import_alias_rewritten_non_import_stmts_with_renames(merged, namespaced_stmts, skipped_locals, import_renames)
  } else {
    append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)
  }
}

let build_merged_stmts_from_sources: (String, Array[(String, String)]) -> Array[Stmt] with { Error } = (entry_path, sources) -> {
  let merged = empty_stmt_array()
  let source_count = Array::length(sources)
  let (file_paths, file_stmts) = parse_sources_for_merge(sources)
  let plan_entry = if entry_path == "" {
    if source_count > 0 {
      Array::get(file_paths, source_count - 1)
    } else {
      ""
    }
  } else {
    entry_path
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut si = 0
  while si < source_count {
    let path = Array::get(file_paths, si)
    let is_entry_source = if entry_path == "" {
      si == source_count - 1
    } else {
      path == entry_path
    }
    append_merged_stmts_for_file(merged, path, Array::get(file_stmts, si), is_entry_source, plan, sources)
    si = si + 1
  }
  merged
}

let build_grouped_merged_stmts: (Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } = (source_groups) -> {
  let merged = empty_stmt_array()
  // #716: the plan spans ALL groups (imports cross group boundaries), so the
  // flat source list is parsed once here and reused per group.
  let flat_sources = flatten_source_groups_local(source_groups)
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let path = Array::get(file_paths, flat_idx)
      let stmts = Array::get(file_stmts, flat_idx)
      append_merged_stmts_for_file(merged, path, stmts, si == source_count - 1, plan, flat_sources)
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  merged
}

// Interior-line breakpoints (span-arc step5): the basename of a file path (text
// after the last '/'). Used as the `vibe.dbgfiles` key the runner matches a
// `--break <file>:<line>` spec against. String::concat-free (substring only).
let path_basename: (String) -> String = (p) -> {
  let n = String::length(p)
  let mut last = 0 - 1
  let mut i = 0
  while i < n {
    if String::char_code_at(p, i) == 47 {
      last = i
    } else {
      ()
    }
    i = i + 1
  }
  String::substring(p, last + 1, n)
}

// Interior-line breakpoints: sorted char-offsets of each '\n' in `src` (local
// copy of the codegen helper, to avoid an entry->codegen import).
let file_newline_offsets: (String) -> Array[Int] = (src) -> {
  let arr = Array::slice([
    0
  ], 0, 0)
  let n = String::length(src)
  let mut i = 0
  while i < n {
    if String::char_code_at(src, i) == 10 {
      Array::push(arr, i)
    } else {
      ()
    }
    i = i + 1
  }
  arr
}

// Interior-line breakpoints (span-arc step5, multi-file): like
// build_grouped_merged_stmts but ALSO records, per merged top-level statement,
// which SOURCE FILE it came from — so codegen can map each statement's char
// offset to a line IN ITS OWN FILE (offsets from different files collide after
// the merge). Returns (merged, file_basenames, file_newlines, stmt_file_id):
//   file_basenames[k] / file_newlines[k]  — the k-th distinct source file
//   stmt_file_id[s]                        — file id of merged top-level stmt s
// Provenance is captured by measuring the merged-array length delta around each
// source's append, so it stays aligned no matter how many statements a source
// contributes; the append calls themselves mirror build_merged_stmts_from_sources
// exactly, so `merged` is identical to the normal path.
let build_grouped_merged_stmts_prov: (Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } = (source_groups) -> {
  let merged = empty_stmt_array()
  let files = Array::slice([
    ""
  ], 0, 0)
  let file_nls = Array::slice([
    Array::slice([
      0
    ], 0, 0)
  ], 0, 0)
  let stmt_file_id = Array::slice([
    0
  ], 0, 0)
  // #716: same whole-program plan as build_grouped_merged_stmts, so `merged`
  // stays identical to the normal (non-break) merge.
  let flat_sources = flatten_source_groups_local(source_groups)
  let (file_paths, file_stmts) = parse_sources_for_merge(flat_sources)
  let plan_entry = if Array::length(file_paths) > 0 {
    Array::get(file_paths, Array::length(file_paths) - 1)
  } else {
    ""
  }
  let plan = build_export_rename_plan(file_paths, file_stmts, plan_entry)
  let mut flat_idx = 0
  let mut gi = 0
  while gi < Array::length(source_groups) {
    let (_, sources) = Array::get(source_groups, gi)
    let source_count = Array::length(sources)
    let mut si = 0
    while si < source_count {
      let (path, source) = Array::get(sources, si)
      let file_id = Array::length(files)
      Array::push(files, path_basename(path))
      Array::push(file_nls, file_newline_offsets(source))
      let before = Array::length(merged)
      append_merged_stmts_for_file(merged, path, Array::get(file_stmts, flat_idx), si == source_count - 1, plan, flat_sources)
      let after = Array::length(merged)
      let mut k = before
      while k < after {
        Array::push(stmt_file_id, file_id)
        k = k + 1
      }
      flat_idx = flat_idx + 1
      si = si + 1
    }
    gi = gi + 1
  }
  (merged, files, file_nls, stmt_file_id)
}

let prepare_file_fs_from_source_groups_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error } = (db, entry_path, source_groups) -> {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck(seeded, entry_path)
}

let prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {
  let seeded = seed_type_db_from_source_groups(db, source_groups)
  db_typecheck_fs(seeded, entry_path)
}

export let prepare_file_fs_cached: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, entry_path) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
}

export let compile_file_fs_mode: (String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
}

// #701 RC variant: same load/merge as compile_file_fs_mode "no-dce" but routes
// through the Perceus RC codegen (compile_wasi_module_rc_impl, enable_rc) so an
// import-resolving / `vibe run` program actually honors VIBE_RC. Without this
// the FS-compile path silently used the bump allocator regardless of VIBE_RC.
export let compile_file_fs_mode_rc: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_rc(merged_stmts, entry_name)
}

// #634 (ADR-0026): same as compile_file_fs_mode, but ALSO writes the pure-test
// cache verdict to `meta_out` (when non-empty) before codegen — computed on the
// MERGED stmts, so transitive imported-function effect rows are visible. "1" =
// every test block is transitively effect-free → `vibe test` may cache/skip it.
// Reached only on a successful compile (the program type-checks), so reading the
// declared effect rows is sound. Env is read by the caller (the CLI adapter),
// keeping this layer free of the Env effect.
export let compile_file_fs_mode_testmeta: (String, String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode, meta_out) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  // Compute the cacheability verdict BEFORE codegen (it only needs the stmts)
  // but write it only AFTER codegen succeeds, so a failed compile leaves no
  // stale sidecar.
  let cacheable = if meta_out != "" {
    file_tests_cacheable(merged_stmts)
  } else {
    false
  }
  let bytes = if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  if meta_out != "" {
    Fs::write_file(meta_out, if cacheable {
      "1"
    } else {
      "0"
    })
  } else {
    ()
  }
  bytes
}

// Coverage (#cov): FS-mode compile with function-level hit instrumentation.
// Same load/merge as compile_file_fs_mode "no-dce" but routes through the
// coverage codegen so the output wasm carries the hit bitmap + `vibe_cov`
// section. Used by `cli_main` under VIBE_COVERAGE=1.
export let compile_file_fs_mode_coverage: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_coverage(merged_stmts, entry_name)
}

// Trace (debugger / DAP P1 groundwork): FS-mode compile with function-call
// execution-trace instrumentation. Same load/merge as compile_file_fs_mode
// "no-dce" but routes through the trace codegen so the output wasm carries the
// in-memory trace log + `vibe.trace` custom section. Used by `cli_main` under
// VIBE_DEBUG=1.
export let compile_file_fs_mode_trace: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  compile_wasi_module_trace(merged_stmts, entry_name)
}

// Break (debugger / DAP P1): FS-mode compile with `vibe::dbg_break` host-hook
// instrumentation at each user function entry. Same load/merge as
// compile_file_fs_mode "no-dce" but routes through the break codegen so the
// output wasm imports + calls `vibe::dbg_break`. Used by `cli_main` under
// VIBE_DEBUG_BREAK=1.
export let compile_file_fs_mode_break: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {
  let source_groups = collect_source_groups_fs(entry_path)
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  // Interior-line breakpoints (span-arc step5): merge WITH per-file provenance so
  // the break codegen can emit `vibe::dbg_line(<file_id>, <line>)` at every
  // statement boundary, mapping each statement's char offset to a line in its OWN
  // source file (multi-file: offsets from different files collide). `merged` is
  // identical to the non-break merge.
  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)
  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{
    files: dbg_files,
    file_nls: dbg_file_nls,
    stmt_file_id: dbg_stmt_file_id
  })
}

export let compile_file_fs_mode_profiled: (String, String, String) -> (Bytes, Int, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (entry_path, entry_name, mode) -> {
  let total_start = profiler_now_us()
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  let load_us = elapsed_us_since(load_start)
  let type_start = profiler_now_us()
  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)
  let _ = next_db
  let type_us = elapsed_us_since(type_start)
  let bundle_start = profiler_now_us()
  let _ = build_source_groups_fingerprint(source_groups)
  let bundle_us = elapsed_us_since(bundle_start)
  let parse_start = profiler_now_us()
  let merged_stmts = build_grouped_merged_stmts(source_groups)
  let parse_us = elapsed_us_since(parse_start)
  let compile_start = profiler_now_us()
  let bytes = if mode == "mvp" {
    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
    compile_wasi_module_impl(pruned_stmts, entry_name)
  } else if mode == "no-dce" {
    compile_wasi_module(merged_stmts, entry_name)
  } else {
    throw(String::concat("unsupported compile mode: ", mode))
  }
  let compile_us = elapsed_us_since(compile_start)
  (bytes, load_us, type_us, bundle_us, parse_us, compile_us, elapsed_us_since(total_start))
}

let compile_file_fs_mode_cached_slow_profiled: (TypeDb, String, String, String, String) -> (Bytes, TypeDb, Int, Int, Int, Int, Int) with { Error, Fs, Profiler } = (db, entry_path, entry_name, mode, persistent_artifact_kind) -> {
  let load_start = profiler_now_us()
  let source_groups = collect_source_groups_fs(entry_path)
  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(
    source_groups,
    entry_name,
    mode
  )
  match load_persistent_artifact(
    persistent_artifact_kind,
    entry_name,
    persistent_artifact_fingerprint
  ) {
    Some(bytes) => (bytes, db, elapsed_us_since(load_start), 0, 0, 0, 0),
    None => {
      let load_us = elapsed_us_since(load_start)
      let type_start = profiler_now_us()
      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)
      let type_us = elapsed_us_since(type_start)
      let bundle_start = profiler_now_us()
      let merge_fingerprint = build_source_groups_fingerprint(source_groups)
      let bundle_us = elapsed_us_since(bundle_start)
      let artifact_fingerprint = merge_fingerprint
      let artifact_kind = if mode == "mvp" {
        "wasi-mvp"
      } else if mode == "no-dce" {
        "wasi"
      } else {
        throw(String::concat("unsupported compile mode: ", mode))
      }
      match db_load_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {
        Some(bytes) => (bytes, next_db, load_us, type_us, bundle_us, 0, 0),
        None => {
          let parse_start = profiler_now_us()
          let merged_stmts = build_grouped_merged_stmts(source_groups)
          let parse_us = elapsed_us_since(parse_start)
          let compile_start = profiler_now_us()
          let bytes = if mode == "mvp" {
            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])
            compile_wasi_module_impl(pruned_stmts, entry_name)
          } else {
            compile_wasi_module(merged_stmts, entry_name)
          }
          store_persistent_artifact(
            persistent_artifact_kind,
            entry_name,
            persistent_artifact_fingerprint,
            bytes
          )
          let compile_us = elapsed_us_since(compile_start)
          (bytes, db_store_artifact(next_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes), load_us, type_us, bundle_us, parse_us, compile_us)
        }
      }
    }
  }
}

