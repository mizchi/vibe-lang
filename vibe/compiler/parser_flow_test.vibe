//# Imports

import ./parser_test_support.vibe {
  parse_print
}

//# Misc

test "parse if" {
  let result = handle {
    parse_print("if true { 1 } else { 2 }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "if true { 1 } else { 2 }"))
}

test "parse while" {
  let result = handle {
    parse_print("while x < 10 { x = x + 1; x }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "while (x < 10) { { x = (x + 1); x } }"))
}

test "parse for in" {
  let result = handle {
    parse_print("for item in items { item }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "for item in items { item }"))
}

test "parse handle" {
  let result = handle {
    parse_print("handle { f() } { Error(msg) => msg }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "handle { f() } { Error(msg) => msg }"))
}

test "parse block let" {
  let result = handle {
    parse_print("{ let x = 1; x }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "{ let x = 1; x }"))
}

test "parse match" {
  let result = handle {
    parse_print("match x { 1 => true, _ => false }")
  } {
    Error(e) => String::concat("ERROR: ", e)
  }
  assert(String::equals(result, "match x { 1 => true, _ => false }"))
}
