//# Imports

import ./module_loader.vibe {
  collect_all_sources_fs, collect_source_groups_fs
}

//# Functions

let has_source_path: (Array[(String, String)], String) -> Bool = (sources, target) -> {
  let mut i = 0
  let mut found = false
  while i < Array::length(sources) {
    let (path, _) = Array::get(sources, i)
    if path == target {
      found = true
      i = Array::length(sources)
    }
    else {
      i = i + 1
    }
  }
  found
}

let find_group_sources: (Array[(String, Array[(String, String)])], String) -> Option[Array[(String, String)]] = (groups, target) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == target {
      found = Some(sources)
      i = Array::length(groups)
    }
    else {
      i = i + 1
    }
  }
  found
}

//# Misc

test "collect_all_sources_fs: compiler index prefers manifest list" {
  let sources = collect_all_sources_fs("vibe/compiler/index.vibe")
  let (first_path, _) = Array::get(sources, 0)
  let (last_path, _) = Array::get(sources, Array::length(sources) - 1)
  assert(first_path == "vibe/compiler/core/polyfill.vibe")
  assert(last_path == "vibe/compiler/index.vibe")
  assert(Array::length(sources) == 161)
  assert(has_source_path(sources, "vibe/compiler/core/polyfill.vibe"))
  assert(has_source_path(sources, "vibe/compiler/core/bytebuf.vibe"))
  assert(has_source_path(sources, "vibe/compiler/core/ast.vibe"))
  assert(has_source_path(sources, "vibe/compiler/core/types.vibe"))
  assert(has_source_path(sources, "vibe/compiler/core/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/token.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/float_format.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/lexer.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/parser.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/printer.vibe"))
  assert(has_source_path(sources, "vibe/compiler/syntax/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/ast.vibe"))
  assert(has_source_path(sources, "vibe/compiler/types.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/builtins.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker_resolve.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker_pattern.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker.vibe"))
  assert(has_source_path(sources, "vibe/compiler/checker/checker_stmt.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/wasm_emit/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/wasm_emit/simd.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/wasm_emit/simd_patterns.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/common_base/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/common_extractors/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/common_analysis/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/expr/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/builtin_bodies/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/wasi/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/gc/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen.vibe"))
  assert(has_source_path(sources, "vibe/compiler/runtime/eval_loader/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/ripple/ripple.vibe"))
  assert(has_source_path(sources, "vibe/compiler/runtime/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/runtime/persistent_env_codec.vibe"))
  assert(has_source_path(sources, "vibe/compiler/type_db.vibe"))
  assert(has_source_path(sources, "vibe/compiler/cache/persistent_cache.vibe"))
  assert(has_source_path(sources, "vibe/compiler/module_graph_path.vibe"))
  assert(has_source_path(sources, "vibe/compiler/cache/persistent_module_header_codec.vibe"))
  assert(has_source_path(sources, "vibe/compiler/loader/header_cache.vibe"))
  assert(has_source_path(sources, "vibe/compiler/loader/manifest_sources.vibe"))
  assert(has_source_path(sources, "vibe/compiler/loader/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/cache_probe_support.vibe"))
  assert(has_source_path(sources, "vibe/compiler/entry/source_compile/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/entry/compiler/fs_compile/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/entry/compiler/file_compile/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/entry/cli_cache/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/selfbuild_runtime_entry_bundle.vibe"))
  assert(has_source_path(sources, "vibe/compiler/selfhost_cli_adapter_bundle.vibe"))
  assert(has_source_path(sources, "vibe/compiler/selfhost_sources_bundle.vibe") == false)
}

test "collect_all_sources_fs: non-manifest compiler entry keeps recursive collection" {
  let sources = collect_all_sources_fs("vibe/compiler/module_loader_non_manifest_fixture.vibe")
  assert(has_source_path(sources, "vibe/compiler/module_loader_non_manifest_fixture.vibe"))
}

test "collect_all_sources_fs: fs_compile entry follows source imports without hardcoded deps" {
  let sources = collect_all_sources_fs("vibe/compiler/entry/compiler/fs_compile/index.vibe")
  assert(has_source_path(sources, "vibe/compiler/entry/compiler/fs_compile/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/entry/compiler/fs_compile/closure_order.vibe"))
  assert(has_source_path(sources, "vibe/compiler/cache/persistent_cache.vibe"))
  assert(has_source_path(sources, "vibe/compiler/runtime/index.vibe"))
  assert(has_source_path(sources, "vibe/compiler/codegen/index.vibe"))
}

test "collect_source_groups_fs: compiler index keeps manifest groups" {
  let groups = collect_source_groups_fs("vibe/compiler/index.vibe")
  assert(Array::length(groups) == 9)
  let (first_name, first_sources) = Array::get(groups, 0)
  let (last_name, last_sources) = Array::get(groups, Array::length(groups) - 1)
  assert(first_name == "core")
  assert(last_name == "entry")
  assert(has_source_path(first_sources, "vibe/compiler/core/polyfill.vibe"))
  assert(has_source_path(first_sources, "vibe/compiler/core/bytebuf.vibe"))
  assert(has_source_path(first_sources, "vibe/compiler/core/ast.vibe"))
  assert(has_source_path(first_sources, "vibe/compiler/core/types.vibe"))
  assert(has_source_path(first_sources, "vibe/compiler/core/index.vibe"))
  assert(has_source_path(first_sources, "vibe/compiler/ast.vibe"))
  match find_group_sources(groups, "syntax") {
    Some(syntax_sources) => {
      assert(has_source_path(syntax_sources, "vibe/compiler/syntax/token.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/syntax/float_format.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/syntax/lexer.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/syntax/parser.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/syntax/printer.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/syntax/index.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/token.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/lexer.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/parser.vibe"))
      assert(has_source_path(syntax_sources, "vibe/compiler/printer.vibe"))
    },
    None => assert(false)
  }
  match find_group_sources(groups, "checker") {
    Some(checker_sources) => {
      assert(has_source_path(checker_sources, "vibe/compiler/checker/builtins.vibe"))
      assert(has_source_path(checker_sources, "vibe/compiler/checker/checker_resolve.vibe"))
      assert(has_source_path(checker_sources, "vibe/compiler/checker/checker_pattern.vibe"))
      assert(has_source_path(checker_sources, "vibe/compiler/checker/checker.vibe"))
      assert(has_source_path(checker_sources, "vibe/compiler/checker/checker_stmt.vibe"))
    },
    None => assert(false)
  }
  match find_group_sources(groups, "codegen") {
    Some(codegen_sources) => {
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/wasm_emit/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/wasm_emit/simd.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/wasm_emit/simd_patterns.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/common_base/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/common_extractors/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/common_analysis/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/expr/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/builtin_bodies/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/wasi/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/gc/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen/index.vibe"))
      assert(has_source_path(codegen_sources, "vibe/compiler/codegen.vibe"))
    },
    None => assert(false)
  }
  assert(has_source_path(last_sources, "vibe/compiler/cli_cache.vibe"))
  assert(has_source_path(last_sources, "vibe/compiler/selfbuild_runtime_entry_bundle.vibe"))
  assert(has_source_path(last_sources, "vibe/compiler/index.vibe"))
  match find_group_sources(groups, "runtime") {
    Some(runtime_sources) => {
      assert(has_source_path(runtime_sources, "vibe/compiler/runtime/eval_loader/index.vibe"))
      assert(has_source_path(runtime_sources, "vibe/compiler/runtime/index.vibe"))
      assert(has_source_path(runtime_sources, "vibe/compiler/runtime/persistent_env_codec.vibe"))
      assert(has_source_path(runtime_sources, "vibe/compiler/type_db.vibe"))
      assert(has_source_path(runtime_sources, "vibe/compiler/cache/persistent_cache.vibe"))
    },
    None => assert(false)
  }
  match find_group_sources(groups, "loader") {
    Some(loader_sources) => {
      assert(has_source_path(loader_sources, "vibe/compiler/module_graph_path.vibe"))
      assert(has_source_path(loader_sources, "vibe/compiler/cache/persistent_module_header_codec.vibe"))
      assert(has_source_path(loader_sources, "vibe/compiler/loader/header_cache.vibe"))
      assert(has_source_path(loader_sources, "vibe/compiler/loader/manifest_sources.vibe"))
      assert(has_source_path(loader_sources, "vibe/compiler/loader/index.vibe"))
      assert(has_source_path(loader_sources, "vibe/compiler/module_loader.vibe"))
    },
    None => assert(false)
  }
  match find_group_sources(groups, "entry") {
    Some(entry_sources) => {
      assert(has_source_path(entry_sources, "vibe/compiler/entry/source_compile/index.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/entry/compiler/fs_compile/index.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/entry/compiler/file_compile/index.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/entry/cli_cache/index.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/cli_cache.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/selfbuild_runtime_entry_bundle.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/index.vibe"))
    },
    None => assert(false)
  }
}

test "collect_source_groups_fs: manifest applies to selfhost cli adapter entry" {
  let groups = collect_source_groups_fs("vibe/compiler/selfhost_cli_adapter.vibe")
  assert(Array::length(groups) == 6)
  let (first_name, _) = Array::get(groups, 0)
  let (last_name, _) = Array::get(groups, Array::length(groups) - 1)
  assert(first_name == "core")
  assert(last_name == "entry")
  match find_group_sources(groups, "entry") {
    Some(entry_sources) => {
      assert(has_source_path(entry_sources, "vibe/compiler/selfhost_cli_adapter.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/entry/source_compile/wasi_only/preprocess.vibe"))
      assert(has_source_path(entry_sources, "vibe/compiler/entry/compiler/index.vibe") == false)
    },
    None => assert(false)
  }
  match find_group_sources(groups, "runtime") {
    Some(_) => assert(false),
    None => assert(true)
  }
  match find_group_sources(groups, "loader") {
    Some(_) => assert(false),
    None => assert(true)
  }
}

test "collect_source_groups_fs: non-manifest compiler entry uses recursive fallback group" {
  let groups = collect_source_groups_fs("vibe/compiler/module_loader_non_manifest_fixture.vibe")
  assert(Array::length(groups) == 1)
  let (name, sources) = Array::get(groups, 0)
  assert(name == "recursive")
  assert(has_source_path(sources, "vibe/compiler/module_loader_non_manifest_fixture.vibe"))
}
