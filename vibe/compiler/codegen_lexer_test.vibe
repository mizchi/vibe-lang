import ./lexer.vibe { lex }
import ./parser.vibe { parse_program }
import ./codegen.vibe { compile_wasi_module }

// Helper: collect enum defs from token.vibe, function defs from lexer.vibe, and compile with given main
let compile_lexer_wasm = (main_source: String) -> Bytes with { Error, Fs } {
  let token_source = fs_read_file("vibe/compiler/token.vibe")
  let lexer_source = fs_read_file("vibe/compiler/lexer.vibe")
  let all_stmts = array_builder()
  // Token enum
  let tk_tokens = lex(token_source)
  let tk_stmts = parse_program(tk_tokens)
  let mut ti = 0
  while ti < array_length(tk_stmts) {
    match array_get(tk_stmts, ti) {
      SEnum(_, _, _) => { array_builder_push(all_stmts, array_get(tk_stmts, ti)); 0 },
      _ => 0
    };
    ti = ti + 1
  }
  // Lexer functions (skip imports, skip lex_ok which uses EHandle)
  let lx_tokens = lex(lexer_source)
  let lx_stmts = parse_program(lx_tokens)
  let mut li = 0
  while li < array_length(lx_stmts) {
    match array_get(lx_stmts, li) {
      SImport(_, _) => 0,
      SLet(_, _, name, _, _) => {
        if string_equals(name, "lex_ok") { 0 }
        else { array_builder_push(all_stmts, array_get(lx_stmts, li)); 0 }
      },
      _ => { array_builder_push(all_stmts, array_get(lx_stmts, li)); 0 }
    };
    li = li + 1
  }
  // Main function
  let mn_tokens = lex(main_source)
  let mn_stmts = parse_program(mn_tokens)
  let mut mi = 0
  while mi < array_length(mn_stmts) {
    array_builder_push(all_stmts, array_get(mn_stmts, mi));
    mi = mi + 1
  }
  compile_wasi_module(array_builder_freeze(all_stmts), "main")
}

test "selfhost codegen: lexer.vibe - token count" {
  let bytes = compile_lexer_wasm("let main = () -> Int {\n  let tokens = lex(\"42\")\n  array_length(tokens)\n}")
  fs_write_bytes("/tmp/test_cg_lexer_count.wasm", bytes)
  0
}

test "selfhost codegen: lexer.vibe - TInt value" {
  let bytes = compile_lexer_wasm("let main = () -> Int {\n  let tokens = lex(\"42\")\n  let t = array_get(tokens, 0)\n  match t {\n    TInt(n) => n,\n    _ => -1\n  }\n}")
  fs_write_bytes("/tmp/test_cg_lexer_tint.wasm", bytes)
  0
}

test "selfhost codegen: lexer.vibe - multi-token" {
  let bytes = compile_lexer_wasm("let main = () -> Int {\n  let tokens = lex(\"1 + 2 * 3\")\n  array_length(tokens)\n}")
  fs_write_bytes("/tmp/test_cg_lexer_multi.wasm", bytes)
  0
}
