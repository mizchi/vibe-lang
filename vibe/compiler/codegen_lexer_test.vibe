import ./lexer.vibe { lex }
import ./parser.vibe { parse_program }
import ./codegen.vibe { compile_wasi_module }

test "wasi: lexer.vibe import - compile only" {
  let token_source = fs_read_file("vibe/compiler/token.vibe")
  let lexer_source = fs_read_file("vibe/compiler/lexer.vibe")
  let main_source = "let main = () -> Int {\n  let tokens = lex(\"42\")\n  array_length(tokens)\n}"
  let all_stmts = array_builder()
  let tk_tokens = lex(token_source)
  let tk_stmts = parse_program(tk_tokens)
  let mut ti = 0
  while ti < array_length(tk_stmts) {
    match array_get(tk_stmts, ti) {
      SEnum(_, _, _) => { array_builder_push(all_stmts, array_get(tk_stmts, ti)); 0 },
      _ => 0
    };
    ti = ti + 1
  }
  let lx_tokens = lex(lexer_source)
  let lx_stmts = parse_program(lx_tokens)
  let mut li = 0
  while li < array_length(lx_stmts) {
    match array_get(lx_stmts, li) {
      SImport(_, _) => 0,
      SLet(_, _, name, _, _) => {
        // Skip lex_ok (uses EHandle which is not yet supported in codegen)
        if string_equals(name, "lex_ok") { 0 }
        else { array_builder_push(all_stmts, array_get(lx_stmts, li)); 0 }
      },
      _ => { array_builder_push(all_stmts, array_get(lx_stmts, li)); 0 }
    };
    li = li + 1
  }
  let mn_tokens = lex(main_source)
  let mn_stmts = parse_program(mn_tokens)
  let mut mi = 0
  while mi < array_length(mn_stmts) {
    array_builder_push(all_stmts, array_get(mn_stmts, mi));
    mi = mi + 1
  }
  let bytes = compile_wasi_module(array_builder_freeze(all_stmts), "main")
  fs_write_bytes("/tmp/test_cg_lexer_import.wasm", bytes)
  0
}
