import ./lexer.vibe { lex }
import ./parser.vibe { parse_program }
import ./codegen.vibe { compile_wasi_module }

test "wasi: parser.vibe import - compile and run" {
  let token_source = Fs::read_file("vibe/compiler/token.vibe")
  let ast_source = Fs::read_file("vibe/compiler/ast.vibe")
  let lexer_source = Fs::read_file("vibe/compiler/lexer.vibe")
  let parser_source = Fs::read_file("vibe/compiler/parser.vibe")
  let main_source = "let main = () -> Int {\n  let tokens = lex(\"1 + 2\")\n  let stmts = parse_program(tokens)\n  Array::length(stmts)\n}"
  let all_stmts = ArrayBuilder::new()
  // Token enum
  let tk_tokens = lex(token_source)
  let tk_stmts = parse_program(tk_tokens)
  let mut ti = 0
  while ti < Array::length(tk_stmts) {
    match Array::get(tk_stmts, ti) {
      SEnum(_, _, _) => { ArrayBuilder::push(all_stmts, Array::get(tk_stmts, ti)); 0 },
      _ => 0
    };
    ti = ti + 1
  }
  // AST enums
  let ast_tokens = lex(ast_source)
  let ast_stmts = parse_program(ast_tokens)
  let mut ai = 0
  while ai < Array::length(ast_stmts) {
    match Array::get(ast_stmts, ai) {
      SEnum(_, _, _) => { ArrayBuilder::push(all_stmts, Array::get(ast_stmts, ai)); 0 },
      _ => 0
    };
    ai = ai + 1
  }
  // Lexer functions (skip imports, skip lex_ok)
  let lx_tokens = lex(lexer_source)
  let lx_stmts = parse_program(lx_tokens)
  let mut li = 0
  while li < Array::length(lx_stmts) {
    match Array::get(lx_stmts, li) {
      SImport(_, _) => 0,
      SLet(_, _, name, _, _) => {
        if String::equals(name, "lex_ok") { 0 }
        else { ArrayBuilder::push(all_stmts, Array::get(lx_stmts, li)); 0 }
      },
      _ => { ArrayBuilder::push(all_stmts, Array::get(lx_stmts, li)); 0 }
    };
    li = li + 1
  }
  // Parser functions (skip imports, skip parse_ok)
  let px_tokens = lex(parser_source)
  let px_stmts = parse_program(px_tokens)
  let mut pi = 0
  while pi < Array::length(px_stmts) {
    match Array::get(px_stmts, pi) {
      SImport(_, _) => 0,
      SLet(_, _, name, _, _) => {
        if String::equals(name, "parse_ok") { 0 }
        else { ArrayBuilder::push(all_stmts, Array::get(px_stmts, pi)); 0 }
      },
      _ => { ArrayBuilder::push(all_stmts, Array::get(px_stmts, pi)); 0 }
    };
    pi = pi + 1
  }
  // Main function
  let mn_tokens = lex(main_source)
  let mn_stmts = parse_program(mn_tokens)
  let mut mi = 0
  while mi < Array::length(mn_stmts) {
    ArrayBuilder::push(all_stmts, Array::get(mn_stmts, mi));
    mi = mi + 1
  }
  let bytes = compile_wasi_module(ArrayBuilder::freeze(all_stmts), "main")
  Fs::write_bytes("/tmp/test_cg_parser_import.wasm", bytes)
  0
}
