//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup
}

//# Misc

test "selfhost: while loop counter" {
  let src = "let s = \"hello world\"\nlet len = String::length(s)\nlet mut count = 0\nwhile count < len {\n  count = count + 1\n}\nlet result = count"
  assert(String::equals(run_and_lookup(src, "result"), "11"))
}

test "selfhost: recursive array sum" {
  let src = "let rec sum_arr = (arr: Array[Int], i: Int) -> Int {\n  if i >= Array::length(arr) { 0 }\n  else { Array::get(arr, i) + sum_arr(arr, i + 1) }\n}\nlet result = sum_arr([10, 20, 30], 0)"
  assert(String::equals(run_and_lookup(src, "result"), "60"))
}

test "selfhost: break in while loop" {
  let src = "let mut i = 0\nwhile true {\n  i = i + 1\n  if i == 5 {\n    break\n  }\n}\nlet result = i"
  assert(String::equals(run_and_lookup(src, "result"), "5"))
}

test "selfhost: continue in while loop" {
  let src = "let mut sum = 0\nlet mut i = 0\nwhile i < 5 {\n  i = i + 1\n  if i == 3 {\n    continue\n  }\n  sum = sum + i\n}\nlet result = sum"
  assert(String::equals(run_and_lookup(src, "result"), "12"))
}

test "selfhost: break with value in while" {
  let src = "let result = while true {\n  break 42\n}"
  assert(String::equals(run_and_lookup(src, "result"), "42"))
}

test "selfhost: parameterized loop sum" {
  let src = "let result = loop (i = 10, acc = 0) {\n  if i <= 0 { break acc } else { continue(i - 1, acc + i) }\n}"
  assert(String::equals(run_and_lookup(src, "result"), "55"))
}
