//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_ann.vibe {
  resolve_simple_type
}

import ./types.vibe {
  Type, TypeDef, types_equal
}

//# Functions

let empty_defs = () -> Array[TypeDef] {
  array_slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
}

//# Misc

test "resolve_simple_type TyUnit" {
  let ty = resolve_simple_type(TyUnit, empty_defs())
  assert(types_equal(ty, CtUnit))
}

test "resolve_simple_type TyName Int" {
  let ty = resolve_simple_type(TyName("Int"), empty_defs())
  assert(types_equal(ty, CtInt))
}

test "resolve_simple_type TyName String" {
  let ty = resolve_simple_type(TyName("String"), empty_defs())
  assert(types_equal(ty, CtString))
}

test "resolve_simple_type TyName Bool" {
  let ty = resolve_simple_type(TyName("Bool"), empty_defs())
  assert(types_equal(ty, CtBool))
}

test "resolve_simple_type complex falls back to Unknown" {
  let ty = resolve_simple_type(TyFn([
    TyName("Int")
  ], TyName("String")), empty_defs())
  assert(types_equal(ty, CtUnknown))
}
