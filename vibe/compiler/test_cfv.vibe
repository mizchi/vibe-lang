import ./ast.vibe { Expr, Pat }
import ./codegen_common.vibe { collect_free_vars }

test "collect_free_vars with tuple pattern" {
  let body = EMatch(
    ECall(EIdent("foo"), array_slice([EUnit], 0, 0)),
    [(PTuple([PBind("a"), PBind("b")]), EBinOp("+", EIdent("a"), EIdent("b")))]
  )
  let fv = collect_free_vars(body, array_slice([""], 0, 0), ["foo"])
  if array_length(fv) != 0 {
    throw("expected 0 free vars")
  }
  0
}
