//# Imports

import ./ast.vibe {
  Expr, Pat
}

import ./codegen/common_analysis {
  collect_free_vars
}

//# Misc

test "collect_free_vars with tuple pattern" {
  let body = EMatch(ECall(EIdent("foo", -1), Array::slice([
    EUnit
  ], 0, 0), -1), [
    (PTuple([
      PBind("a"),
      PBind("b")
    ]), EBinOp("+", EIdent("a", -1), EIdent("b", -1)))
  ])
  let fv = collect_free_vars(body, Array::slice([
    ""
  ], 0, 0), [
    "foo"
  ])
  if Array::length(fv) != 0 {
    throw("expected 0 free vars")
  }
  0
}
