//# Imports

import ./ast.vibe {
  Expr, Pat
}

import ./codegen_common_analysis.vibe {
  collect_free_vars
}

//# Misc

test "collect_free_vars with tuple pattern" {
  let body = EMatch(ECall(EIdent("foo"), Array::slice([
    EUnit
  ], 0, 0)), [
    (PTuple([
      PBind("a"),
      PBind("b")
    ]), EBinOp("+", EIdent("a"), EIdent("b")))
  ])
  let fv = collect_free_vars(body, Array::slice([
    ""
  ], 0, 0), [
    "foo"
  ])
  if Array::length(fv) != 0 {
    throw("expected 0 free vars")
  }
  0
}
