//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse
}

import ./printer.vibe {
  print_expr
}

//# Functions

let roundtrip = (src: String) -> Bool with { Error } {
  let printed1 = print_expr(parse(lex(src)))
  let printed2 = print_expr(parse(lex(printed1)))
  string_equals(printed1, printed2)
}

let roundtrip_eq = (src: String, expected: String) -> Bool with { Error } {
  let printed = print_expr(parse(lex(src)))
  string_equals(printed, expected)
}

//# Misc

test "roundtrip int" {
  let ok = handle {
    roundtrip("42")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip string" {
  let ok = handle {
    roundtrip("\"hello\"")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip bool" {
  let ok = handle {
    roundtrip("true")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip ident" {
  let ok = handle {
    roundtrip("foo")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip binop" {
  let ok = handle {
    roundtrip("1 + 2")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip precedence" {
  let ok = handle {
    roundtrip("1 + 2 * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip left assoc" {
  let ok = handle {
    roundtrip("1 + 2 + 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip parens" {
  let ok = handle {
    roundtrip("(1 + 2) * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unary" {
