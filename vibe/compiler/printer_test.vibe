//# Imports

import ./printer_test_support.vibe {
  roundtrip, roundtrip_eq
}

//# Misc

test "roundtrip int" {
  let ok = handle {
    roundtrip("42")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip string" {
  let ok = handle {
    roundtrip("\"hello\"")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip bool" {
  let ok = handle {
    roundtrip("true")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip ident" {
  let ok = handle {
    roundtrip("foo")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip binop" {
  let ok = handle {
    roundtrip("1 + 2")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip precedence" {
  let ok = handle {
    roundtrip("1 + 2 * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip left assoc" {
  let ok = handle {
    roundtrip("1 + 2 + 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip parens" {
  let ok = handle {
    roundtrip("(1 + 2) * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unary" {
  let ok = handle {
    roundtrip("-1")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip call" {
  let ok = handle {
    roundtrip("f(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip dot" {
  let ok = handle {
    roundtrip("a.b.c")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip pipe" {
  let ok = handle {
    roundtrip("x |> f |> g")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip if" {
  let ok = handle {
    roundtrip("if true { 1 } else { 2 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip fn" {
  let ok = handle {
    roundtrip("(x) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip fn typed" {
  let ok = handle {
    roundtrip("(x: Int) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip match" {
  let ok = handle {
    roundtrip("match x { 1 => true, _ => false }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip array" {
  let ok = handle {
    roundtrip("[1, 2, 3]")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip tuple" {
  let ok = handle {
    roundtrip("(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unit" {
  let ok = handle {
    roundtrip("()")
  } {
    Error(_) => false
  }
  assert(ok)
}
