test "roundtrip fn typed" {
  let ok = handle {
    roundtrip("(x: Int) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip match" {
  let ok = handle {
    roundtrip("match x { 1 => true, _ => false }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip array" {
  let ok = handle {
    roundtrip("[1, 2, 3]")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip tuple" {
  let ok = handle {
    roundtrip("(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
