//# Imports

import ./printer_test_support.vibe {
  roundtrip, roundtrip_eq
}

//# Misc

test "roundtrip if" {
  let ok = handle {
    roundtrip("if true { 1 } else { 2 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip fn" {
  let ok = handle {
    roundtrip("(x) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip fn typed" {
  let ok = handle {
    roundtrip("(x: Int) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip match" {
  let ok = handle {
    roundtrip("match x { 1 => true, _ => false }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip array" {
  let ok = handle {
    roundtrip("[1, 2, 3]")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip tuple" {
  let ok = handle {
    roundtrip("(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unit" {
  let ok = handle {
    roundtrip("()")
  } {
    Error(_) => false
  }
  assert(ok)
}
