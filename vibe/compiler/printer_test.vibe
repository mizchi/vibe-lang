test "roundtrip dot" {
  let ok = handle {
    roundtrip("a.b.c")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip pipe" {
  let ok = handle {
    roundtrip("x |> f |> g")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip if" {
  let ok = handle {
    roundtrip("if true { 1 } else { 2 }")
  } {
    Error(_) => false
  }
  assert(ok)
