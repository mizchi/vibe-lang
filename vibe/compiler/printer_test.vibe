//# Imports

use ./parser.vibe {
  parse
}

use ./printer.vibe {
  print_expr
}

use ./lexer.vibe {
  lex
}

//# Functions

let roundtrip = (src: String) -> Bool with { Error } {
  let printed1 = print_expr(parse(lex(src)))
  let printed2 = print_expr(parse(lex(printed1)))
  string_equals(printed1, printed2)
}

let roundtrip_eq = (src: String, expected: String) -> Bool with { Error } {
  let printed = print_expr(parse(lex(src)))
  string_equals(printed, expected)
}

//# Misc

test "roundtrip int" {
  let ok = handle {
    roundtrip("42")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip string" {
  let ok = handle {
    roundtrip("\"hello\"")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip bool" {
  let ok = handle {
    roundtrip("true")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip ident" {
  let ok = handle {
    roundtrip("foo")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip binop" {
  let ok = handle {
    roundtrip("1 + 2")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip precedence" {
  let ok = handle {
    roundtrip("1 + 2 * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip left assoc" {
  let ok = handle {
    roundtrip("1 + 2 + 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip parens" {
  let ok = handle {
    roundtrip("(1 + 2) * 3")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unary" {
  let ok = handle {
    roundtrip("-1")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip call" {
  let ok = handle {
    roundtrip("f(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip dot" {
  let ok = handle {
    roundtrip("a.b.c")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip pipe" {
  let ok = handle {
    roundtrip("x |> f |> g")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip if" {
  let ok = handle {
    roundtrip("if true { 1 } else { 2 }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip fn" {
  let ok = handle {
    roundtrip("(x) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip fn typed" {
  let ok = handle {
    roundtrip("(x: Int) -> x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip match" {
  let ok = handle {
    roundtrip("match x { 1 => true, _ => false }")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip array" {
  let ok = handle {
    roundtrip("[1, 2, 3]")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip tuple" {
  let ok = handle {
    roundtrip("(1, 2)")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip unit" {
  let ok = handle {
    roundtrip("()")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip let" {
  let ok = handle {
    roundtrip_eq("{ let x = 1; x }", "let x = 1; x")
  } {
    Error(_) => false
  }
  assert(ok)
}

test "roundtrip complex" {
  let ok = handle {
    roundtrip("if x > 0 { f(x - 1) } else { 0 }")
  } {
    Error(_) => false
  }
  assert(ok)
}
