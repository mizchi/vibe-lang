import ./parser.vibe { Expr, Pat, Stmt, TypeExpr, parse_program }
import ./lexer.vibe { lex }
import ./eval_stmt.vibe { eval_and_lookup }

let _a1 = (e: Expr) -> Expr { e }
let _a2 = (p: Pat) -> Pat { p }
let _a3 = (t: TypeExpr) -> TypeExpr { t }
let _a4 = (s: Stmt) -> Stmt { s }

export let run_and_lookup = (src: String, name: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    eval_and_lookup(stmts, name)
  } {
    Error(msg) => string_concat("ERROR: ", msg)
  }
}
