import ./eval_stmt.vibe { run_source, run_source_with_imports }

export let run_and_lookup = (src: String, name: String) -> String {
  run_source(src, name)
}

export let run_with_imports = (sources: Array[(String, String)], main_key: String, lookup_name: String) -> String {
  run_source_with_imports(sources, main_key, lookup_name)
}
