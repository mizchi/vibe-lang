//# Imports

import ./types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

export let lookup_char = (name: String) -> Option[Type] {
  if name == "Char::to_int" {
    Some(CtFn([
      CtChar
    ], CtInt, false))
  }
  else if name == "Char::from_int" {
    Some(CtFn([
      CtInt
    ], CtChar, false))
  }
  else None
}

export let lookup_json = (name: String) -> Option[Type] {
  if name == "Json::stringify" {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if name == "Json::parse" {
    Some(CtFn([
      CtString
    ], CtUnknown, false))
  }
  else if name == "Json::stringify_lines" {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if name == "Json::parse_lines" {
    Some(CtFn([
      CtString
    ], CtArray(CtUnknown), false))
  }
  else if name == "Json::type_of" {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if name == "Json::get" {
    Some(CtFn([
      CtUnknown,
      CtString
    ], CtUnknown, false))
  }
  else if name == "Json::index" {
    Some(CtFn([
      CtUnknown,
      CtInt
    ], CtUnknown, false))
  }
  else if name == "Json::number" {
    Some(CtFn([
      CtUnknown
    ], CtDouble, false))
  }
  else if name == "Json::bool" {
    Some(CtFn([
      CtUnknown
    ], CtBool, false))
  }
  else if name == "Json::length" {
    Some(CtFn([
      CtUnknown
    ], CtInt, false))
  }
  else if name == "Json::keys" {
    Some(CtFn([
      CtUnknown
    ], CtArray(CtString), false))
  }
  else None
}

export let lookup_numeric = (name: String) -> Option[Type] {
  if name == "Int::parse" {
    Some(CtFn([
      CtString
    ], CtInt, false))
  }
  else if name == "Double::parse" {
    Some(CtFn([
      CtString
    ], CtDouble, false))
  }
  else if name == "Int::abs" {
    Some(CtFn([
      CtInt
    ], CtInt, false))
  }
  else if name == "Int::is_even" {
    Some(CtFn([
      CtInt
    ], CtBool, false))
  }
  else if name == "Int::max" {
    Some(CtFn([
      CtInt,
      CtInt
    ], CtInt, false))
  }
  else if name == "Int::clamp" {
    Some(CtFn([
      CtInt,
      CtInt,
      CtInt
    ], CtInt, false))
  }
  else if name == "Double::abs" {
    Some(CtFn([
      CtDouble
    ], CtDouble, false))
  }
  else if name == "Double::floor" {
    Some(CtFn([
      CtDouble
    ], CtInt, false))
  }
  else if name == "Double::max" {
    Some(CtFn([
      CtDouble,
      CtDouble
    ], CtDouble, false))
  }
  else if name == "Int::to_float" {
    Some(CtFn([
      CtInt
    ], CtDouble, false))
  }
  else if name == "Float::to_int" {
    Some(CtFn([
      CtDouble
    ], CtInt, false))
  }
  else if name == "Float::to_double" {
    Some(CtFn([
      CtDouble
    ], CtDouble, false))
  }
  else if name == "Double::to_float" {
    Some(CtFn([
      CtDouble
    ], CtDouble, false))
  }
  else None
}

export let lookup_threads = (name: String) -> Option[Type] {
  if name == "Threads::channel_new" {
    Some(CtFn(no_params(), CtUnknown, true))
  }
  else if name == "Threads::send" {
    Some(CtFn([
      CtUnknown,
      CtUnknown
    ], CtUnit, true))
  }
  else if name == "Threads::recv" {
    Some(CtFn([
      CtUnknown
    ], CtUnknown, true))
  }
  else if name == "Threads::spawn" {
    Some(CtFn([
      CtFn(no_params(), CtUnknown, false)
    ], CtUnknown, true))
  }
  else if name == "Threads::wait" {
    Some(CtFn([
      CtUnknown
    ], CtUnknown, true))
  }
  else if name == "Threads::probe_wat" {
    Some(CtFn(no_params(), CtString, true))
  }
  else if name == "Threads::runtime_hints" {
    Some(CtFn(no_params(), CtUnknown, true))
  }
  else None
}

export let lookup_wasm_ops = (name: String) -> Option[Type] {
  if name == "i32_eq" {
    Some(CtFn([
      CtInt,
      CtInt
    ], CtBool, false))
  }
  else if name == "i32_eqz" {
    Some(CtFn([
      CtInt
    ], CtBool, false))
  }
  else if name == "i32_load" {
    Some(CtFn([
      CtUnknown,
      CtInt
    ], CtInt, false))
  }
  else if name == "i32_store" {
    Some(CtFn([
      CtUnknown,
      CtInt,
      CtInt
    ], CtUnit, false))
  }
  else if name == "i32_shr_u" {
    Some(CtFn([
      CtInt,
      CtInt
    ], CtInt, false))
  }
  else if name == "f32_eq" {
    Some(CtFn([
      CtDouble,
      CtDouble
    ], CtBool, false))
  }
  else if name == "f32_load" {
    Some(CtFn([
      CtUnknown,
      CtInt
    ], CtDouble, false))
  }
  else if name == "f32_store" {
    Some(CtFn([
      CtUnknown,
      CtInt,
      CtDouble
    ], CtUnit, false))
  }
  else if name == "f64_eq" {
    Some(CtFn([
      CtDouble,
      CtDouble
    ], CtBool, false))
  }
  else if name == "f64_load" {
    Some(CtFn([
      CtUnknown,
      CtInt
    ], CtDouble, false))
  }
  else if name == "f64_store" {
    Some(CtFn([
      CtUnknown,
      CtInt,
      CtDouble
    ], CtUnit, false))
  }
  else None
}

export let lookup_array_extra = (name: String) -> Option[Type] {
  if name == "Array::truncate" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt
    ], CtUnit, false))
  }
  else None
}

export let lookup_string_extra = (name: String) -> Option[Type] {
  if name == "String::join" {
    Some(CtFn([
      CtArray(CtString),
      CtString
    ], CtString, false))
  }
  else if name == "String::replace" {
    Some(CtFn([
      CtString,
      CtString,
      CtString
    ], CtString, false))
  }
  else if name == "String::split" {
    Some(CtFn([
      CtString,
      CtString
    ], CtArray(CtString), false))
  }
  else if name == "String::to_upper" {
    Some(CtFn([
      CtString
    ], CtString, false))
  }
  else if name == "String::trim" {
    Some(CtFn([
      CtString
    ], CtString, false))
  }
  else if name == "String::unicode_length" {
    Some(CtFn([
      CtString
    ], CtInt, false))
  }
  else if name == "Lines::parse" {
    Some(CtFn([
      CtArray(CtString)
    ], CtString, false))
  }
  else if name == "Lines::stringify" {
    Some(CtFn([
      CtString
    ], CtArray(CtString), false))
  }
  else None
}

export let lookup_extended = (name: String) -> Option[Type] {
  match lookup_numeric(name) {
    Some(t) => Some(t),
    None => match lookup_json(name) {
      Some(t) => Some(t),
      None => match lookup_char(name) {
        Some(t) => Some(t),
        None => match lookup_threads(name) {
          Some(t) => Some(t),
          None => match lookup_string_extra(name) {
            Some(t) => Some(t),
            None => match lookup_array_extra(name) {
              Some(t) => Some(t),
              None => lookup_wasm_ops(name)
            }
          }
        }
      }
    }
  }
}
