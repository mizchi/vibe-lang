import ./types.vibe {
  Type
}

let no_params = () -> Array[Type] {
  array_slice([
    CtUnknown
  ], 0, 0)
}

export let lookup_numeric = (name: String) -> Option[Type] {
  if string_equals(name, "parse_int") {
    Some(CtFn([CtString], CtInt, false))
  }
  else if string_equals(name, "parse_double") {
    Some(CtFn([CtString], CtDouble, false))
  }
  else if string_equals(name, "int_abs") {
    Some(CtFn([CtInt], CtInt, false))
  }
  else if string_equals(name, "int_is_even") {
    Some(CtFn([CtInt], CtBool, false))
  }
  else if string_equals(name, "int_max") {
    Some(CtFn([CtInt, CtInt], CtInt, false))
  }
  else if string_equals(name, "int_clamp") {
    Some(CtFn([CtInt, CtInt, CtInt], CtInt, false))
  }
  else if string_equals(name, "double_abs") {
    Some(CtFn([CtDouble], CtDouble, false))
  }
  else if string_equals(name, "double_floor") {
    Some(CtFn([CtDouble], CtInt, false))
  }
  else if string_equals(name, "double_max") {
    Some(CtFn([CtDouble, CtDouble], CtDouble, false))
  }
  else if string_equals(name, "int_to_float") {
    Some(CtFn([CtInt], CtDouble, false))
  }
  else if string_equals(name, "float_to_int") {
    Some(CtFn([CtDouble], CtInt, false))
  }
  else if string_equals(name, "float_to_double") {
    Some(CtFn([CtDouble], CtDouble, false))
  }
  else if string_equals(name, "double_to_float") {
    Some(CtFn([CtDouble], CtDouble, false))
  }
  else None
}

export let lookup_json = (name: String) -> Option[Type] {
  if string_equals(name, "to_json") {
    Some(CtFn([CtUnknown], CtString, false))
  }
  else if string_equals(name, "from_json") {
    Some(CtFn([CtString], CtUnknown, false))
  }
  else if string_equals(name, "to_jsonl") {
    Some(CtFn([CtUnknown], CtString, false))
  }
  else if string_equals(name, "from_jsonl") {
    Some(CtFn([CtString], CtArray(CtUnknown), false))
  }
  else if string_equals(name, "json_type") {
    Some(CtFn([CtUnknown], CtString, false))
  }
  else if string_equals(name, "json_get") {
    Some(CtFn([CtUnknown, CtString], CtUnknown, false))
  }
  else if string_equals(name, "json_index") {
    Some(CtFn([CtUnknown, CtInt], CtUnknown, false))
  }
  else if string_equals(name, "json_number") {
    Some(CtFn([CtUnknown], CtDouble, false))
  }
  else if string_equals(name, "json_bool") {
    Some(CtFn([CtUnknown], CtBool, false))
  }
  else if string_equals(name, "json_length") {
    Some(CtFn([CtUnknown], CtInt, false))
  }
  else if string_equals(name, "json_keys") {
    Some(CtFn([CtUnknown], CtArray(CtString), false))
  }
  else None
}

export let lookup_char = (name: String) -> Option[Type] {
  if string_equals(name, "char_to_int") {
    Some(CtFn([CtChar], CtInt, false))
  }
  else if string_equals(name, "char_from_int") {
    Some(CtFn([CtInt], CtChar, false))
  }
  else None
}

export let lookup_threads = (name: String) -> Option[Type] {
  if string_equals(name, "threads_channel_new") {
    Some(CtFn(no_params(), CtUnknown, true))
  }
  else if string_equals(name, "threads_send") {
    Some(CtFn([CtUnknown, CtUnknown], CtUnit, true))
  }
  else if string_equals(name, "threads_recv") {
    Some(CtFn([CtUnknown], CtUnknown, true))
  }
  else if string_equals(name, "threads_spawn") {
    Some(CtFn([CtFn(no_params(), CtUnknown, false)], CtUnknown, true))
  }
  else if string_equals(name, "threads_wait") {
    Some(CtFn([CtUnknown], CtUnknown, true))
  }
  else if string_equals(name, "threads_probe_wat") {
    Some(CtFn(no_params(), CtString, true))
  }
  else if string_equals(name, "threads_runtime_hints") {
    Some(CtFn(no_params(), CtUnknown, true))
  }
  else None
}

export let lookup_string_extra = (name: String) -> Option[Type] {
  if string_equals(name, "string_join") {
    Some(CtFn([CtArray(CtString), CtString], CtString, false))
  }
  else if string_equals(name, "string_replace") {
    Some(CtFn([CtString, CtString, CtString], CtString, false))
  }
  else if string_equals(name, "string_split") {
    Some(CtFn([CtString, CtString], CtArray(CtString), false))
  }
  else if string_equals(name, "string_to_upper") {
    Some(CtFn([CtString], CtString, false))
  }
  else if string_equals(name, "string_trim") {
    Some(CtFn([CtString], CtString, false))
  }
  else if string_equals(name, "string_unicode_length") {
    Some(CtFn([CtString], CtInt, false))
  }
  else if string_equals(name, "from_lines") {
    Some(CtFn([CtArray(CtString)], CtString, false))
  }
  else if string_equals(name, "to_lines") {
    Some(CtFn([CtString], CtArray(CtString), false))
  }
  else None
}

export let lookup_array_extra = (name: String) -> Option[Type] {
  if string_equals(name, "array_truncate") {
    Some(CtFn([CtArray(CtUnknown), CtInt], CtUnit, false))
  }
  else None
}

export let lookup_wasm_ops = (name: String) -> Option[Type] {
  if string_equals(name, "i32_eq") {
    Some(CtFn([CtInt, CtInt], CtBool, false))
  }
  else if string_equals(name, "i32_eqz") {
    Some(CtFn([CtInt], CtBool, false))
  }
  else if string_equals(name, "i32_load") {
    Some(CtFn([CtUnknown, CtInt], CtInt, false))
  }
  else if string_equals(name, "i32_store") {
    Some(CtFn([CtUnknown, CtInt, CtInt], CtUnit, false))
  }
  else if string_equals(name, "i32_shr_u") {
    Some(CtFn([CtInt, CtInt], CtInt, false))
  }
  else if string_equals(name, "f32_eq") {
    Some(CtFn([CtDouble, CtDouble], CtBool, false))
  }
  else if string_equals(name, "f32_load") {
    Some(CtFn([CtUnknown, CtInt], CtDouble, false))
  }
  else if string_equals(name, "f32_store") {
    Some(CtFn([CtUnknown, CtInt, CtDouble], CtUnit, false))
  }
  else if string_equals(name, "f64_eq") {
    Some(CtFn([CtDouble, CtDouble], CtBool, false))
  }
  else if string_equals(name, "f64_load") {
    Some(CtFn([CtUnknown, CtInt], CtDouble, false))
  }
  else if string_equals(name, "f64_store") {
    Some(CtFn([CtUnknown, CtInt, CtDouble], CtUnit, false))
  }
  else None
}

export let lookup_extended = (name: String) -> Option[Type] {
  match lookup_numeric(name) {
    Some(t) => Some(t),
    None => match lookup_json(name) {
      Some(t) => Some(t),
      None => match lookup_char(name) {
        Some(t) => Some(t),
        None => match lookup_threads(name) {
          Some(t) => Some(t),
          None => match lookup_string_extra(name) {
            Some(t) => Some(t),
            None => match lookup_array_extra(name) {
              Some(t) => Some(t),
              None => lookup_wasm_ops(name)
            }
          }
        }
      }
    }
  }
}
