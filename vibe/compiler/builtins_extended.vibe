//# Imports

import ./types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let register = (b: MapBuilder, name: String, t: Type) -> Unit {
  MapBuilder::set(b, name, t)
}

let build_extended_table = () -> Map[String, Type] {
  let b = MapBuilder::new()

  // Char
  register(b, "Char::to_int", CtFn([CtChar], CtInt, false))
  register(b, "Char::from_int", CtFn([CtInt], CtChar, false))

  // Json
  register(b, "Json::stringify", CtFn([CtUnknown], CtString, false))
  register(b, "Json::parse", CtFn([CtString], CtUnknown, false))
  register(b, "Json::stringify_lines", CtFn([CtUnknown], CtString, false))
  register(b, "Json::parse_lines", CtFn([CtString], CtArray(CtUnknown), false))
  register(b, "Json::type_of", CtFn([CtUnknown], CtString, false))
  register(b, "Json::get", CtFn([CtUnknown, CtString], CtUnknown, false))
  register(b, "Json::index", CtFn([CtUnknown, CtInt], CtUnknown, false))
  register(b, "Json::number", CtFn([CtUnknown], CtDouble, false))
  register(b, "Json::bool", CtFn([CtUnknown], CtBool, false))
  register(b, "Json::length", CtFn([CtUnknown], CtInt, false))
  register(b, "Json::keys", CtFn([CtUnknown], CtArray(CtString), false))
  register(b, "Json::string", CtFn([CtUnknown], CtString, false))

  // Numeric
  register(b, "Int::parse", CtFn([CtString], CtInt, false))
  register(b, "Double::parse", CtFn([CtString], CtDouble, false))
  register(b, "Int::abs", CtFn([CtInt], CtInt, false))
  register(b, "Int::is_even", CtFn([CtInt], CtBool, false))
  register(b, "Int::max", CtFn([CtInt, CtInt], CtInt, false))
  register(b, "Int::clamp", CtFn([CtInt, CtInt, CtInt], CtInt, false))
  register(b, "Double::abs", CtFn([CtDouble], CtDouble, false))
  register(b, "Double::floor", CtFn([CtDouble], CtInt, false))
  register(b, "Double::max", CtFn([CtDouble, CtDouble], CtDouble, false))
  register(b, "Int::to_float", CtFn([CtInt], CtDouble, false))
  register(b, "Float::to_int", CtFn([CtDouble], CtInt, false))
  register(b, "Float::to_double", CtFn([CtDouble], CtDouble, false))
  register(b, "Double::to_float", CtFn([CtDouble], CtDouble, false))

  // Threads
  register(b, "Threads::channel_new", CtFn(no_params(), CtUnknown, true))
  register(b, "Threads::send", CtFn([CtUnknown, CtUnknown], CtUnit, true))
  register(b, "Threads::recv", CtFn([CtUnknown], CtUnknown, true))
  register(b, "Threads::spawn", CtFn([CtFn(no_params(), CtUnknown, false)], CtUnknown, true))
  register(b, "Threads::wait", CtFn([CtUnknown], CtUnknown, true))
  register(b, "Threads::probe_wat", CtFn(no_params(), CtString, true))
  register(b, "Threads::runtime_hints", CtFn(no_params(), CtUnknown, true))

  // WASM ops
  register(b, "i32_eq", CtFn([CtInt, CtInt], CtBool, false))
  register(b, "i32_eqz", CtFn([CtInt], CtBool, false))
  register(b, "i32_load", CtFn([CtUnknown, CtInt], CtInt, false))
  register(b, "i32_store", CtFn([CtUnknown, CtInt, CtInt], CtUnit, false))
  register(b, "i32_shr_u", CtFn([CtInt, CtInt], CtInt, false))
  register(b, "f32_eq", CtFn([CtDouble, CtDouble], CtBool, false))
  register(b, "f32_load", CtFn([CtUnknown, CtInt], CtDouble, false))
  register(b, "f32_store", CtFn([CtUnknown, CtInt, CtDouble], CtUnit, false))
  register(b, "f64_eq", CtFn([CtDouble, CtDouble], CtBool, false))
  register(b, "f64_load", CtFn([CtUnknown, CtInt], CtDouble, false))
  register(b, "f64_store", CtFn([CtUnknown, CtInt, CtDouble], CtUnit, false))

  // Array extra
  register(b, "Array::truncate", CtFn([CtArray(CtUnknown), CtInt], CtUnit, false))

  // String extra
  register(b, "String::join", CtFn([CtArray(CtString), CtString], CtString, false))
  register(b, "String::replace", CtFn([CtString, CtString, CtString], CtString, false))
  register(b, "String::split", CtFn([CtString, CtString], CtArray(CtString), false))
  register(b, "String::to_upper", CtFn([CtString], CtString, false))
  register(b, "String::trim", CtFn([CtString], CtString, false))
  register(b, "String::unicode_length", CtFn([CtString], CtInt, false))
  register(b, "Lines::parse", CtFn([CtArray(CtString)], CtString, false))
  register(b, "Lines::stringify", CtFn([CtString], CtArray(CtString), false))

  MapBuilder::freeze(b)
}

let mut cached_extended_table: Option[Map[String, Type]] = None

export let lookup_extended = (name: String) -> Option[Type] {
  let table = match cached_extended_table {
    Some(t) => t,
    None => {
      let t = build_extended_table()
      cached_extended_table = Some(t)
      t
    }
  }
  if map_has(table, name) {
    Some(Map::get(table, name))
  } else {
    None
  }
}
