test "fibonacci: fib(0)=0" {
  let bytes = build_fibonacci_module()
  Fs::write_bytes("/tmp/test_vibe_fib.wasm", bytes)
  sh("wasmtime run --invoke fib /tmp/test_vibe_fib.wasm 0")
}

test "fibonacci: fib(10)=55" {
  let bytes = build_fibonacci_module()
  Fs::write_bytes("/tmp/test_vibe_fib.wasm", bytes)
  sh("wasmtime run --invoke fib /tmp/test_vibe_fib.wasm 10")
}

test "factorial: fact(1)=1" {
  let bytes = build_factorial_module()
  Fs::write_bytes("/tmp/test_vibe_fact.wasm", bytes)
  sh("wasmtime run --invoke fact /tmp/test_vibe_fact.wasm 1")
