test "factorial: fact(10)=3628800" {
  let bytes = build_factorial_module()
  Fs::write_bytes("/tmp/test_vibe_fact.wasm", bytes)
  sh("wasmtime run --invoke fact /tmp/test_vibe_fact.wasm 10")
