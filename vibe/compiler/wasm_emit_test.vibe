//# Imports

import ./bytebuf.vibe {
  bytebuf_length, bytebuf_new, bytebuf_to_bytes
}

import ./wasm_emit.vibe {
  build_add_module, build_arithmetic_module, build_call_module, build_factorial_module, build_fibonacci_module, build_hello_module, build_print_string_module, emit_header, string_to_data
}

//# Misc

test "wasm header" {
  let buf = bytebuf_new()
  emit_header(buf)
  assert(bytebuf_length(buf) == 8)
  let bytes = bytebuf_to_bytes(buf)
  assert(bytes[0] == 0)
  assert(bytes[1] == 97)
  assert(bytes[2] == 115)
  assert(bytes[3] == 109)
  assert(bytes[4] == 1)
}

test "build_add_module produces valid wasm" {
  let bytes = build_add_module()
  assert(Bytes::length(bytes) > 20)
  assert(bytes[0] == 0)
  assert(bytes[1] == 97)
  assert(bytes[2] == 115)
  assert(bytes[3] == 109)
}

test "build_add_module validates with wasmtime" {
  let bytes = build_add_module()
  Fs::write_bytes("/tmp/test_vibe_add.wasm", bytes)
  sh("wasmtime run --invoke add /tmp/test_vibe_add.wasm 3 4")
}

test "arithmetic module: add" {
  let bytes = build_arithmetic_module()
  Fs::write_bytes("/tmp/test_vibe_arith.wasm", bytes)
  sh("wasmtime run --invoke add /tmp/test_vibe_arith.wasm 10 20")
}

