test "hello world WASI module" {
  let bytes = build_hello_module()
  Fs::write_bytes("/tmp/test_vibe_hello.wasm", bytes)
  sh("wasmtime run /tmp/test_vibe_hello.wasm")
}

test "string_to_data" {
  let data = string_to_data("abc")
  assert(Array::length(data) == 3)
  assert(Array::get(data, 0) == 97)
  assert(Array::get(data, 1) == 98)
  assert(Array::get(data, 2) == 99)
}

test "print_string_module custom message" {
  let bytes = build_print_string_module("vibe codegen works!\n")
  Fs::write_bytes("/tmp/test_vibe_print.wasm", bytes)
  sh("wasmtime run /tmp/test_vibe_print.wasm")
}
