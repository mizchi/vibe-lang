//# Imports

import ./checker_normalize.vibe {
  normalize_type
}

import ./types.vibe {
  Type, TypeDef, types_equal
}

//# Functions

let empty_defs = () -> Array[TypeDef] {
  array_slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
}

//# Primitives pass through

test "normalize CtInt" {
  assert(types_equal(normalize_type(CtInt, empty_defs()), CtInt))
}

test "normalize CtString" {
  assert(types_equal(normalize_type(CtString, empty_defs()), CtString))
}

test "normalize CtBool" {
  assert(types_equal(normalize_type(CtBool, empty_defs()), CtBool))
}

test "normalize CtDouble" {
  assert(types_equal(normalize_type(CtDouble, empty_defs()), CtDouble))
}

test "normalize CtUnit" {
  assert(types_equal(normalize_type(CtUnit, empty_defs()), CtUnit))
}

test "normalize CtChar" {
  assert(types_equal(normalize_type(CtChar, empty_defs()), CtChar))
}

test "normalize CtBytes" {
  assert(types_equal(normalize_type(CtBytes, empty_defs()), CtBytes))
}

test "normalize CtVar" {
  assert(types_equal(normalize_type(CtVar(0), empty_defs()), CtVar(0)))
}

test "normalize CtUnknown" {
  assert(types_equal(normalize_type(CtUnknown, empty_defs()), CtUnknown))
}

//# TDAlias resolves

test "normalize TDAlias to Int" {
  let defs = [
    TDAlias("MyInt", CtInt)
  ]
  let ty = normalize_type(CtNamed("MyInt", array_slice([CtUnknown], 0, 0)), defs)
  assert(types_equal(ty, CtInt))
}

test "normalize chained TDAlias" {
  let defs = [
    TDAlias("A", CtNamed("B", array_slice([CtUnknown], 0, 0))),
    TDAlias("B", CtString)
  ]
  let ty = normalize_type(CtNamed("A", array_slice([CtUnknown], 0, 0)), defs)
  assert(types_equal(ty, CtString))
}

//# TDEnum resolves

test "normalize TDEnum" {
  let defs = [
    TDEnum("Color", array_slice([("Red", array_slice([CtUnknown], 0, 0))], 0, 0))
  ]
  let ty = normalize_type(CtNamed("Color", array_slice([CtUnknown], 0, 0)), defs)
  assert(types_equal(ty, CtEnum("Color")))
}

//# TDStruct resolves

test "normalize TDStruct" {
  let defs = [
    TDStruct("Point", array_slice([("x", CtInt)], 0, 0))
  ]
  let ty = normalize_type(CtNamed("Point", array_slice([CtUnknown], 0, 0)), defs)
  assert(types_equal(ty, CtStruct("Point")))
}

//# Nested types are normalized

test "normalize Array[MyAlias]" {
  let defs = [
    TDAlias("MyInt", CtInt)
  ]
  let ty = normalize_type(CtArray(CtNamed("MyInt", array_slice([CtUnknown], 0, 0))), defs)
  assert(types_equal(ty, CtArray(CtInt)))
}

test "normalize Option[MyAlias]" {
  let defs = [
    TDAlias("MyStr", CtString)
  ]
  let ty = normalize_type(CtOption(CtNamed("MyStr", array_slice([CtUnknown], 0, 0))), defs)
  assert(types_equal(ty, CtOption(CtString)))
}

test "normalize Tuple with aliases" {
  let defs = [
    TDAlias("A", CtInt),
    TDAlias("B", CtString)
  ]
  let ty = normalize_type(CtTuple([
    CtNamed("A", array_slice([CtUnknown], 0, 0)),
    CtNamed("B", array_slice([CtUnknown], 0, 0))
  ]), defs)
  assert(types_equal(ty, CtTuple([CtInt, CtString])))
}

test "normalize Fn with aliases" {
  let defs = [
    TDAlias("A", CtInt),
    TDAlias("B", CtString)
  ]
  let ty = normalize_type(CtFn([
    CtNamed("A", array_slice([CtUnknown], 0, 0))
  ], CtNamed("B", array_slice([CtUnknown], 0, 0)), false), defs)
  assert(types_equal(ty, CtFn([CtInt], CtString, false)))
}

test "normalize ForAll body" {
  let defs = [
    TDAlias("MyInt", CtInt)
  ]
  let empty_bounds = array_slice([
    (0, array_slice([""], 0, 0))
  ], 0, 0)
  let ty = normalize_type(CtForAll([1], empty_bounds, CtNamed("MyInt", array_slice([CtUnknown], 0, 0))), defs)
  assert(types_equal(ty, CtForAll([1], empty_bounds, CtInt)))
}

//# Recursive alias detection

test "normalize recursive alias no infinite loop" {
  let defs = [
    TDAlias("Rec", CtNamed("Rec", array_slice([CtUnknown], 0, 0)))
  ]
  // Should not infinite loop — returns CtNamed("Rec", ...) on second visit
  let ty = normalize_type(CtNamed("Rec", array_slice([CtUnknown], 0, 0)), defs)
  assert(types_equal(ty, CtNamed("Rec", array_slice([CtUnknown], 0, 0))))
}

//# Unknown Named type passes through

test "normalize unknown Named type" {
  let ty = normalize_type(CtNamed("Unknown", array_slice([CtUnknown], 0, 0)), empty_defs())
  assert(types_equal(ty, CtNamed("Unknown", array_slice([CtUnknown], 0, 0))))
}
