//# Imports

import ./checker_normalize.vibe {
  normalize_type
}

import ./types.vibe {
  Type, TypeDef, types_equal
}

//# Functions

let empty_defs: () -> Array[TypeDef] = () -> {
  Array::slice([
    TDAlias("_dummy", Array::slice([""], 0, 0), CtUnit)
  ], 0, 0)
}

//# Misc

test "normalize CtInt" {
  assert(types_equal(normalize_type(CtInt, empty_defs()), CtInt))
}

test "normalize CtString" {
  assert(types_equal(normalize_type(CtString, empty_defs()), CtString))
}

test "normalize CtBool" {
  assert(types_equal(normalize_type(CtBool, empty_defs()), CtBool))
}

test "normalize CtDouble" {
  assert(types_equal(normalize_type(CtDouble, empty_defs()), CtDouble))
}

test "normalize CtUnit" {
  assert(types_equal(normalize_type(CtUnit, empty_defs()), CtUnit))
}

test "normalize CtChar" {
  assert(types_equal(normalize_type(CtChar, empty_defs()), CtChar))
}

test "normalize CtBytes" {
  assert(types_equal(normalize_type(CtBytes, empty_defs()), CtBytes))
}

test "normalize CtVar" {
  assert(types_equal(normalize_type(CtVar(0), empty_defs()), CtVar(0)))
}

test "normalize CtUnknown" {
  assert(types_equal(normalize_type(CtUnknown, empty_defs()), CtUnknown))
}

test "normalize TDAlias to Int" {
  let defs = [
    TDAlias("MyInt", Array::slice([""], 0, 0), CtInt)
  ]
  let ty = normalize_type(CtNamed("MyInt", Array::slice([
    CtUnknown
  ], 0, 0)), defs)
  assert(types_equal(ty, CtInt))
}

test "normalize chained TDAlias" {
  let defs = [
    TDAlias("A", Array::slice([""], 0, 0), CtNamed("B", Array::slice([
      CtUnknown
    ], 0, 0))),
    TDAlias("B", Array::slice([""], 0, 0), CtString)
  ]
  let ty = normalize_type(CtNamed("A", Array::slice([
    CtUnknown
  ], 0, 0)), defs)
  assert(types_equal(ty, CtString))
}

test "normalize TDEnum" {
  let defs = [
    TDEnum("Color", Array::slice([""], 0, 0), Array::slice([
      ("Red", Array::slice([
        CtUnknown
      ], 0, 0))
    ], 0, 0))
  ]
  let ty = normalize_type(CtNamed("Color", Array::slice([
    CtUnknown
  ], 0, 0)), defs)
  assert(types_equal(ty, CtEnum("Color")))
}

test "normalize TDStruct" {
  let defs = [
    TDStruct("Point", Array::slice([
      ("x", CtInt)
    ], 0, 0), Array::slice([
      ""
    ], 0, 0))
  ]
  let ty = normalize_type(CtNamed("Point", Array::slice([
    CtUnknown
  ], 0, 0)), defs)
  assert(types_equal(ty, CtStruct("Point")))
}

test "normalize Array[MyAlias]" {
  let defs = [
    TDAlias("MyInt", Array::slice([""], 0, 0), CtInt)
  ]
  let ty = normalize_type(CtArray(CtNamed("MyInt", Array::slice([
    CtUnknown
  ], 0, 0))), defs)
  assert(types_equal(ty, CtArray(CtInt)))
}

test "normalize Option[MyAlias]" {
  let defs = [
    TDAlias("MyStr", Array::slice([""], 0, 0), CtString)
  ]
  let ty = normalize_type(CtOption(CtNamed("MyStr", Array::slice([
    CtUnknown
  ], 0, 0))), defs)
  assert(types_equal(ty, CtOption(CtString)))
}

test "normalize Tuple with aliases" {
  let defs = [
    TDAlias("A", Array::slice([""], 0, 0), CtInt),
    TDAlias("B", Array::slice([""], 0, 0), CtString)
  ]
  let ty = normalize_type(CtTuple([
    CtNamed("A", Array::slice([
      CtUnknown
    ], 0, 0)),
    CtNamed("B", Array::slice([
      CtUnknown
    ], 0, 0))
  ]), defs)
  assert(types_equal(ty, CtTuple([
    CtInt,
    CtString
  ])))
}

test "normalize Fn with aliases" {
  let defs = [
    TDAlias("A", Array::slice([""], 0, 0), CtInt),
    TDAlias("B", Array::slice([""], 0, 0), CtString)
  ]
  let ty = normalize_type(CtFn([
    CtNamed("A", Array::slice([
      CtUnknown
    ], 0, 0))
  ], CtNamed("B", Array::slice([
    CtUnknown
  ], 0, 0)), None), defs)
  assert(types_equal(ty, CtFn([
    CtInt
  ], CtString, None)))
}

test "normalize ForAll body" {
  let defs = [
    TDAlias("MyInt", Array::slice([""], 0, 0), CtInt)
  ]
  let empty_bounds = Array::slice([
    (0, Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let ty = normalize_type(CtForAll([
    1
  ], empty_bounds, CtNamed("MyInt", Array::slice([
    CtUnknown
  ], 0, 0))), defs)
  assert(types_equal(ty, CtForAll([
    1
  ], empty_bounds, CtInt)))
}

test "normalize recursive alias no infinite loop" {
  let defs = [
    TDAlias("Rec", Array::slice([""], 0, 0), CtNamed("Rec", Array::slice([
      CtUnknown
    ], 0, 0)))
  ]
  // Should not infinite loop — returns CtNamed("Rec", ...) on second visit
  let ty = normalize_type(CtNamed("Rec", Array::slice([
    CtUnknown
  ], 0, 0)), defs)
  assert(types_equal(ty, CtNamed("Rec", Array::slice([
    CtUnknown
  ], 0, 0))))
}

test "normalize unknown Named type" {
  let ty = normalize_type(CtNamed("Unknown", Array::slice([
    CtUnknown
  ], 0, 0)), empty_defs())
  assert(types_equal(ty, CtNamed("Unknown", Array::slice([
    CtUnknown
  ], 0, 0))))
}

test "alias update invalidates cached normalization" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let defs1 = [
    TDAlias("Box", Array::slice([""], 0, 0), CtInt)
  ]
  let ty1 = normalize_type(CtNamed("Box", no_args), defs1)
  assert(types_equal(ty1, CtInt))
  let defs2 = [
    TDAlias("Box", Array::slice([""], 0, 0), CtString)
  ]
  let ty2 = normalize_type(CtNamed("Box", no_args), defs2)
  assert(types_equal(ty2, CtString))
}

test "user alias overrides builtin Bytes" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let defs = [
    TDAlias("Bytes", Array::slice([""], 0, 0), CtArray(CtInt))
  ]
  let ty = normalize_type(CtNamed("Bytes", no_args), defs)
  assert(types_equal(ty, CtArray(CtInt)))
}

test "user alias overrides builtin Int" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let defs = [
    TDAlias("Int", Array::slice([""], 0, 0), CtDouble)
  ]
  let ty = normalize_type(CtNamed("Int", no_args), defs)
  assert(types_equal(ty, CtDouble))
}

test "builtin fallback no user alias passes through" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let ty = normalize_type(CtNamed("Int", no_args), empty_defs())
  assert(types_equal(ty, CtNamed("Int", no_args)))
}

test "builtin Array fallback passes through" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let ty = normalize_type(CtNamed("Array", [
    CtNamed("Int", no_args)
  ]), empty_defs())
  assert(types_equal(ty, CtNamed("Array", [
    CtNamed("Int", no_args)
  ])))
}

test "recursive enum ctor payload keeps named" {
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let defs = [
    TDEnum("Expr", Array::slice([""], 0, 0), [
      ("Lit", [
        CtInt
      ]),
      ("Pair", [
        CtNamed("Expr", no_args),
        CtNamed("Expr", no_args)
      ])
    ])
  ]
  let ty = normalize_type(CtNamed("Expr", no_args), defs)
  assert(types_equal(ty, CtEnum("Expr")))
}

test "normalize CtFn has_error true" {
  let defs = [
    TDAlias("A", Array::slice([""], 0, 0), CtInt)
  ]
  let ty = normalize_type(CtFn([
    CtNamed("A", Array::slice([
      CtUnknown
    ], 0, 0))
  ], CtString, Some("Error")), defs)
  assert(types_equal(ty, CtFn([
    CtInt
  ], CtString, Some("Error"))))
}

test "normalize nested Array[Option[alias]]" {
  let defs = [
    TDAlias("MyStr", Array::slice([""], 0, 0), CtString)
  ]
  let ty = normalize_type(CtArray(CtOption(CtNamed("MyStr", Array::slice([
    CtUnknown
  ], 0, 0)))), defs)
  assert(types_equal(ty, CtArray(CtOption(CtString))))
}

test "normalize CtEnum passthrough" {
  let ty = normalize_type(CtEnum("Color"), empty_defs())
  assert(types_equal(ty, CtEnum("Color")))
}

test "normalize CtStruct passthrough" {
  let ty = normalize_type(CtStruct("Point"), empty_defs())
  assert(types_equal(ty, CtStruct("Point")))
}

test "normalize Fn return alias" {
  let defs = [
    TDAlias("Num", Array::slice([""], 0, 0), CtInt)
  ]
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let ty = normalize_type(CtFn([
    CtString
  ], CtNamed("Num", no_args), Some("Error")), defs)
  assert(types_equal(ty, CtFn([
    CtString
  ], CtInt, Some("Error"))))
}

test "normalize Tuple empty" {
  let ty = normalize_type(CtTuple(Array::slice([
    CtUnknown
  ], 0, 0)), empty_defs())
  assert(types_equal(ty, CtTuple(Array::slice([
    CtUnknown
  ], 0, 0))))
}

test "normalize Option with enum inside" {
  let defs = [
    TDEnum("Status", Array::slice([""], 0, 0), [
      ("Ok", Array::slice([
        CtUnknown
      ], 0, 0)),
      ("Err", [
        CtString
      ])
    ])
  ]
  let no_args = Array::slice([
    CtUnknown
  ], 0, 0)
  let ty = normalize_type(CtOption(CtNamed("Status", no_args)), defs)
  assert(types_equal(ty, CtOption(CtEnum("Status"))))
}
