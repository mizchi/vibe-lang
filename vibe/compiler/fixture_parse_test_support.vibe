//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse_program
}

import ./printer.vibe {
  print_program
}

//# Functions

export let pp = (src: String) -> String {
  handle {
    let tokens = lex(src)
    let stmts = parse_program(tokens)
    print_program(stmts)
  } {
    Error(msg) => String::concat("ERROR: ", msg)
  }
}

export let parse_ok = (src: String) -> Bool {
  let output = pp(src)
  if String::length(output) > 6 && String::substring(output, 0, 6) == "ERROR:" {
    false
  } else true
}

export let roundtrip_ok = (src: String) -> Bool {
  let output1 = pp(src)
  if String::length(output1) > 6 && String::substring(output1, 0, 6) == "ERROR:" {
    false
  } else {
    let output2 = pp(output1)
    output1 == output2
  }
}
