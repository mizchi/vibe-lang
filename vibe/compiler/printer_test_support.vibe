//# Imports

import ./lexer.vibe {
  lex
}

import ./parser.vibe {
  parse
}

import ./printer.vibe {
  print_expr
}

//# Functions

export let roundtrip = (src: String) -> Bool with { Error } {
  let printed1 = print_expr(parse(lex(src)))
  let printed2 = print_expr(parse(lex(printed1)))
  String::equals(printed1, printed2)
}

export let roundtrip_eq = (src: String, expected: String) -> Bool with { Error } {
  let printed = print_expr(parse(lex(src)))
  String::equals(printed, expected)
}
