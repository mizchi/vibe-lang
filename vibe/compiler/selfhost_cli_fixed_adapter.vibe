//# Imports

import ./entry / compiler / file_compile {
  compile_file_fs_cached
}

import ./type_db.vibe {
  db_new
}

//# Functions

let fixed_entry_name = "answer"

let fixed_input_path = "_build/bench/selfhost_cli_adapter/fixed_adapter_input.vibe"

let fixed_output_path = "_build/bench/selfhost_cli_adapter/fixed_adapter_output.wasm"

let run = () -> Int with { Error, Fs } {
  let (bytes, _) = compile_file_fs_cached(db_new(), fixed_input_path, fixed_entry_name)
  Fs::write_bytes(fixed_output_path, bytes)
  0
}

run()
