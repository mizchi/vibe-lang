//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let bytes_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let bytes_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = bytes_no_params()
  Array::push(arr, a)
  arr
}

let bytes_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = bytes_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let bytes_four_params: (Type, Type, Type, Type) -> Array[Type] = (a, b, c, d) -> {
  let arr = bytes_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  Array::push(arr, d)
  arr
}

let bytes_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = bytes_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_bytes_get: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::get" {
    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtInt, None))
  }
  else None
}

let lookup_bytes_new: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::new" {
    Some(CtFn(bytes_no_params(), CtBytes, None))
  }
  else None
}

let lookup_bytes_set: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::set" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_blit: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::blit" {
    Some(CtFn(bytes_four_params(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_fill: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::fill" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_push: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::push" {
    Some(CtFn(bytes_two_params(CtBytes, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_slice: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::slice" {
    Some(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtBytes, None))
  }
  else None
}

let lookup_bytes_append: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::append" {
    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtUnit, None))
  }
  else None
}

let lookup_bytes_concat: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::concat" {
    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtBytes, None))
  }
  else None
}

let lookup_bytes_length: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::length" {
    Some(CtFn(bytes_one_param(CtBytes), CtInt, None))
  }
  else None
}

let lookup_bytes_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_bytes_new(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_length(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_get(name) {
        Some(t) => Some(t),
        None => lookup_bytes_set(name)
      }
    }
  }
}

let lookup_bytes_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_bytes_push(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_concat(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_slice(name) {
        Some(t) => Some(t),
        None => lookup_bytes_append(name)
      }
    }
  }
}

let lookup_bytes_to_array: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::to_array" {
    Some(CtFn(bytes_one_param(CtBytes), CtArray(CtInt), None))
  }
  else None
}

let lookup_bytes_from_array: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::from_array" {
    Some(CtFn(bytes_one_param(CtArray(CtInt)), CtBytes, None))
  }
  else None
}

let lookup_bytes_group_c: (String) -> Option[Type] = (name) -> {
  match lookup_bytes_blit(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_fill(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_from_array(name) {
        Some(t) => Some(t),
        None => lookup_bytes_to_array(name)
      }
    }
  }
}

export let lookup_bytes: (String) -> Option[Type] = (name) -> {
  match lookup_bytes_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_group_b(name) {
      Some(t) => Some(t),
      None => lookup_bytes_group_c(name)
    }
  }
}
