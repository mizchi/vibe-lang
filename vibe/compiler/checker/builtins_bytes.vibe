//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let four_params = (a: Type, b: Type, c: Type, d: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  Array::push(arr, d)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_bytes_get = (name: String) -> Option[Type] {
  if name == "Bytes::get" {
    Some(CtFn(two_params(CtBytes, CtInt), CtInt, None))
  }
  else None
}

let lookup_bytes_new = (name: String) -> Option[Type] {
  if name == "Bytes::new" {
    Some(CtFn(no_params(), CtBytes, None))
  }
  else None
}

let lookup_bytes_set = (name: String) -> Option[Type] {
  if name == "Bytes::set" {
    Some(CtFn(three_params(CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_blit = (name: String) -> Option[Type] {
  if name == "Bytes::blit" {
    Some(CtFn(four_params(CtBytes, CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_fill = (name: String) -> Option[Type] {
  if name == "Bytes::fill" {
    Some(CtFn(three_params(CtBytes, CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_push = (name: String) -> Option[Type] {
  if name == "Bytes::push" {
    Some(CtFn(two_params(CtBytes, CtInt), CtUnit, None))
  }
  else None
}

let lookup_bytes_slice = (name: String) -> Option[Type] {
  if name == "Bytes::slice" {
    Some(CtFn(three_params(CtBytes, CtInt, CtInt), CtBytes, None))
  }
  else None
}

let lookup_bytes_append = (name: String) -> Option[Type] {
  if name == "Bytes::append" {
    Some(CtFn(two_params(CtBytes, CtBytes), CtUnit, None))
  }
  else None
}

let lookup_bytes_concat = (name: String) -> Option[Type] {
  if name == "Bytes::concat" {
    Some(CtFn(two_params(CtBytes, CtBytes), CtBytes, None))
  }
  else None
}

let lookup_bytes_length = (name: String) -> Option[Type] {
  if name == "Bytes::length" {
    Some(CtFn(one_param(CtBytes), CtInt, None))
  }
  else None
}

let lookup_bytes_group_a = (name: String) -> Option[Type] {
  match lookup_bytes_new(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_length(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_get(name) {
        Some(t) => Some(t),
        None => lookup_bytes_set(name)
      }
    }
  }
}

let lookup_bytes_group_b = (name: String) -> Option[Type] {
  match lookup_bytes_push(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_concat(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_slice(name) {
        Some(t) => Some(t),
        None => lookup_bytes_append(name)
      }
    }
  }
}

let lookup_bytes_to_array = (name: String) -> Option[Type] {
  if name == "Bytes::to_array" {
    Some(CtFn(one_param(CtBytes), CtArray(CtInt), None))
  }
  else None
}

let lookup_bytes_from_array = (name: String) -> Option[Type] {
  if name == "Bytes::from_array" {
    Some(CtFn(one_param(CtArray(CtInt)), CtBytes, None))
  }
  else None
}

let lookup_bytes_group_c = (name: String) -> Option[Type] {
  match lookup_bytes_blit(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_fill(name) {
      Some(t) => Some(t),
      None => match lookup_bytes_from_array(name) {
        Some(t) => Some(t),
        None => lookup_bytes_to_array(name)
      }
    }
  }
}

export let lookup_bytes = (name: String) -> Option[Type] {
  match lookup_bytes_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_bytes_group_b(name) {
      Some(t) => Some(t),
      None => lookup_bytes_group_c(name)
    }
  }
}
