//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let lookup_io_a = (name: String) -> Option[Type] {
  match name {
    "sh" => Some(CtFn([
      CtString
    ], CtString, true)),
    "sh_lines" => Some(CtFn([
      CtString
    ], CtArray(CtString), true)),
    "path" => Some(CtFn([
      CtString
    ], CtUnknown, false)),
    "Path::to_string" => Some(CtFn([
      CtUnknown
    ], CtString, false)),
    "Path::is_absolute" => Some(CtFn([
      CtString
    ], CtBool, false)),
    "PromptText::new" => Some(CtFn([
      CtString
    ], CtString, false)),
    "Stdin::read_char" => Some(CtFn(no_params(), CtInt, true)),
    "Stdin::read_stream" => Some(CtFn(no_params(), CtString, true)),
    _ => None
  }
}

let lookup_io_b = (name: String) -> Option[Type] {
  match name {
    "Stdout::write_char" => Some(CtFn([
      CtInt
    ], CtUnit, false)),
    "Stdout::write_stream" => Some(CtFn([
      CtString
    ], CtUnit, false)),
    "Env::get" => Some(CtFn([
      CtString
    ], CtString, true)),
    "Env::args_len" => Some(CtFn(no_params(), CtInt, true)),
    "Env::args_get" => Some(CtFn([
      CtInt
    ], CtString, true)),
    "sleep" => Some(CtFn([
      CtInt
    ], CtUnit, false)),
    "Path::resolve" => Some(CtFn([
      CtString
    ], CtString, false)),
    _ => None
  }
}

export let lookup_io = (name: String) -> Option[Type] {
  match lookup_io_a(name) {
    Some(t) => Some(t),
    None => lookup_io_b(name)
  }
}
