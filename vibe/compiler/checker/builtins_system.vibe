//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let lookup_io_a = (name: String) -> Option[Type] {
  match name {
    "sh" => Some(CtFn([
      CtString
    ], CtString, Some("Process"))),
    "sh_lines" => Some(CtFn([
      CtString
    ], CtArray(CtString), Some("Process"))),
    "path" => Some(CtFn([
      CtString
    ], CtUnknown, None)),
    "Path::to_string" => Some(CtFn([
      CtUnknown
    ], CtString, None)),
    "Path::is_absolute" => Some(CtFn([
      CtString
    ], CtBool, None)),
    "PromptText::new" => Some(CtFn([
      CtString
    ], CtString, None)),
    "Stdin::read_char" => Some(CtFn(no_params(), CtInt, Some("Stdin"))),
    "Stdin::read_stream" => Some(CtFn(no_params(), CtString, Some("Stdin"))),
    _ => None
  }
}

let lookup_io_b = (name: String) -> Option[Type] {
  match name {
    "Stdout::write_char" => Some(CtFn([
      CtInt
    ], CtUnit, None)),
    "Stdout::write_stream" => Some(CtFn([
      CtString
    ], CtUnit, None)),
    "Env::get" => Some(CtFn([
      CtString
    ], CtString, Some("Env"))),
    "Env::args_len" => Some(CtFn(no_params(), CtInt, Some("Env"))),
    "Env::args_get" => Some(CtFn([
      CtInt
    ], CtString, Some("Env"))),
    "sleep" => Some(CtFn([
      CtInt
    ], CtUnit, None)),
    "Path::resolve" => Some(CtFn([
      CtString
    ], CtString, None)),
    _ => None
  }
}

export let lookup_io = (name: String) -> Option[Type] {
  match lookup_io_a(name) {
    Some(t) => Some(t),
    None => lookup_io_b(name)
  }
}
