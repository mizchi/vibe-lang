//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let lookup_string_index_of = (name: String) -> Option[Type] {
  if name == "String::index_of" {
    Some(CtFn(two_params(CtString, CtString), CtInt, false))
  }
  else None
}

let lookup_string_contains = (name: String) -> Option[Type] {
  if name == "String::contains" {
    Some(CtFn(two_params(CtString, CtString), CtBool, false))
  }
  else None
}

let lookup_string_starts_with = (name: String) -> Option[Type] {
  if name == "String::starts_with" {
    Some(CtFn(two_params(CtString, CtString), CtBool, false))
  }
  else None
}

let lookup_string_ends_with = (name: String) -> Option[Type] {
  if name == "String::ends_with" {
    Some(CtFn(two_params(CtString, CtString), CtBool, false))
  }
  else None
}

let lookup_string_from_char_code = (name: String) -> Option[Type] {
  if name == "String::from_char_code" {
    Some(CtFn(one_param(CtInt), CtString, false))
  }
  else None
}

let lookup_string_char_code_at = (name: String) -> Option[Type] {
  if name == "String::char_code_at" {
    Some(CtFn(two_params(CtString, CtInt), CtInt, false))
  }
  else None
}

let lookup_string_last_index_of = (name: String) -> Option[Type] {
  if name == "String::last_index_of" {
    Some(CtFn(two_params(CtString, CtString), CtInt, false))
  }
  else None
}

let lookup_string_split = (name: String) -> Option[Type] {
  if name == "String::split" {
    Some(CtFn(two_params(CtString, CtString), CtArray(CtString), false))
  }
  else None
}

let lookup_string_trim = (name: String) -> Option[Type] {
  if name == "String::trim" {
    Some(CtFn(one_param(CtString), CtString, false))
  }
  else None
}

let lookup_string_to_upper = (name: String) -> Option[Type] {
  if name == "String::to_upper" {
    Some(CtFn(one_param(CtString), CtString, false))
  }
  else None
}

let lookup_string_to_lower = (name: String) -> Option[Type] {
  if name == "String::to_lower" {
    Some(CtFn(one_param(CtString), CtString, false))
  }
  else None
}

let lookup_string_group_a = (name: String) -> Option[Type] {
  match lookup_string_index_of(name) {
    Some(t) => Some(t),
    None => match lookup_string_contains(name) {
      Some(t) => Some(t),
      None => match lookup_string_starts_with(name) {
        Some(t) => Some(t),
        None => lookup_string_ends_with(name)
      }
    }
  }
}

let lookup_string_group_b = (name: String) -> Option[Type] {
  match lookup_string_from_char_code(name) {
    Some(t) => Some(t),
    None => match lookup_string_char_code_at(name) {
      Some(t) => Some(t),
      None => match lookup_string_last_index_of(name) {
        Some(t) => Some(t),
        None => lookup_string_split(name)
      }
    }
  }
}

let lookup_string_group_c = (name: String) -> Option[Type] {
  match lookup_string_trim(name) {
    Some(t) => Some(t),
    None => match lookup_string_to_upper(name) {
      Some(t) => Some(t),
      None => lookup_string_to_lower(name)
    }
  }
}

export let lookup_string2 = (name: String) -> Option[Type] {
  match lookup_string_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_string_group_b(name) {
      Some(t) => Some(t),
      None => lookup_string_group_c(name)
    }
  }
}
