//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let lookup_string_trim = (name: String) -> Option[Type] {
  if name == "String::trim" {
    Some(CtFn(one_param(CtString), CtString, None))
  }
  else None
}

let lookup_string_split = (name: String) -> Option[Type] {
  if name == "String::split" {
    Some(CtFn(two_params(CtString, CtString), CtArray(CtString), None))
  }
  else None
}

let lookup_string_contains = (name: String) -> Option[Type] {
  if name == "String::contains" {
    Some(CtFn(two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string_index_of = (name: String) -> Option[Type] {
  if name == "String::index_of" {
    Some(CtFn(two_params(CtString, CtString), CtInt, None))
  }
  else None
}

let lookup_string_to_lower = (name: String) -> Option[Type] {
  if name == "String::to_lower" {
    Some(CtFn(one_param(CtString), CtString, None))
  }
  else None
}

let lookup_string_to_upper = (name: String) -> Option[Type] {
  if name == "String::to_upper" {
    Some(CtFn(one_param(CtString), CtString, None))
  }
  else None
}

let lookup_string2_group_c = (name: String) -> Option[Type] {
  match lookup_string_trim(name) {
    Some(t) => Some(t),
    None => match lookup_string_to_upper(name) {
      Some(t) => Some(t),
      None => lookup_string_to_lower(name)
    }
  }
}

let lookup_string_ends_with = (name: String) -> Option[Type] {
  if name == "String::ends_with" {
    Some(CtFn(two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string_starts_with = (name: String) -> Option[Type] {
  if name == "String::starts_with" {
    Some(CtFn(two_params(CtString, CtString), CtBool, None))
  }
  else None
}

// NOTE: These helpers must have file-unique names because the post-bundle
// `dedupe_dependency_value_defs` step in the wasm bundler deduplicates by
// let-binding name, and `builtins_string1.vibe` also defines helpers named
// `lookup_string_group_a` / `lookup_string_group_b` / `lookup_string_group_c`.
// If we reuse those names here, the string1 versions win (they come first in
// topological order) and every string2 method lookup silently returns None —
// which manifests as a trap in compiled-backend tests (#287). Renaming the
// helpers to `lookup_string2_group_*` sidesteps the collision. The proper
// fix is for the bundler to namespace non-exported let-bindings per source
// file; tracked separately.
let lookup_string2_group_a = (name: String) -> Option[Type] {
  match lookup_string_index_of(name) {
    Some(t) => Some(t),
    None => match lookup_string_contains(name) {
      Some(t) => Some(t),
      None => match lookup_string_starts_with(name) {
        Some(t) => Some(t),
        None => lookup_string_ends_with(name)
      }
    }
  }
}

let lookup_string_char_code_at = (name: String) -> Option[Type] {
  if name == "String::char_code_at" {
    Some(CtFn(two_params(CtString, CtInt), CtInt, None))
  }
  else None
}

let lookup_string_last_index_of = (name: String) -> Option[Type] {
  if name == "String::last_index_of" {
    Some(CtFn(two_params(CtString, CtString), CtInt, None))
  }
  else None
}

let lookup_string_from_char_code = (name: String) -> Option[Type] {
  if name == "String::from_char_code" {
    Some(CtFn(one_param(CtInt), CtString, None))
  }
  else None
}

let lookup_string2_group_b = (name: String) -> Option[Type] {
  match lookup_string_from_char_code(name) {
    Some(t) => Some(t),
    None => match lookup_string_char_code_at(name) {
      Some(t) => Some(t),
      None => match lookup_string_last_index_of(name) {
        Some(t) => Some(t),
        None => lookup_string_split(name)
      }
    }
  }
}

export let lookup_string2 = (name: String) -> Option[Type] {
  match lookup_string2_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_string2_group_b(name) {
      Some(t) => Some(t),
      None => lookup_string2_group_c(name)
    }
  }
}
