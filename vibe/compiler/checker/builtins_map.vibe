//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_mapbuilder_new = (name: String) -> Option[Type] {
  if name == "MapBuilder::new" {
    Some(CtFn(no_params(), CtUnknown, None))
  }
  else None
}

let lookup_mapbuilder_set = (name: String) -> Option[Type] {
  if name == "MapBuilder::set" {
    Some(CtFn(three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_mapbuilder_freeze = (name: String) -> Option[Type] {
  if name == "MapBuilder::freeze" {
    Some(CtFn(one_param(CtUnknown), CtUnknown, None))
  }
  else None
}

let lookup_map_get = (name: String) -> Option[Type] {
  if name == "Map::get" {
    Some(CtFn(two_params(CtUnknown, CtString), CtUnknown, None))
  }
  else None
}

let lookup_map_has = (name: String) -> Option[Type] {
  if name == "map_has" {
    Some(CtFn(two_params(CtUnknown, CtString), CtBool, None))
  }
  else None
}

let lookup_map_keys = (name: String) -> Option[Type] {
  if name == "Map::keys" {
    Some(CtFn(one_param(CtUnknown), CtArray(CtString), None))
  }
  else None
}

let lookup_map_has_key = (name: String) -> Option[Type] {
  if name == "Map::has_key" {
    Some(CtFn(two_params(CtUnknown, CtString), CtBool, None))
  }
  else None
}

let lookup_map_set = (name: String) -> Option[Type] {
  if name == "Map::set" {
    Some(CtFn(three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_map_group_a = (name: String) -> Option[Type] {
  match lookup_mapbuilder_new(name) {
    Some(t) => Some(t),
    None => match lookup_mapbuilder_set(name) {
      Some(t) => Some(t),
      None => match lookup_mapbuilder_freeze(name) {
        Some(t) => Some(t),
        None => lookup_map_get(name)
      }
    }
  }
}

let lookup_map_group_b = (name: String) -> Option[Type] {
  match lookup_map_has(name) {
    Some(t) => Some(t),
    None => match lookup_map_keys(name) {
      Some(t) => Some(t),
      None => match lookup_map_has_key(name) {
        Some(t) => Some(t),
        None => lookup_map_set(name)
      }
    }
  }
}

export let lookup_map = (name: String) -> Option[Type] {
  match lookup_map_group_a(name) {
    Some(t) => Some(t),
    None => lookup_map_group_b(name)
  }
}
