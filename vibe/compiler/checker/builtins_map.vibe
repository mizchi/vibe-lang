//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let map_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let map_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = map_no_params()
  Array::push(arr, a)
  arr
}

let map_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = map_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let map_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = map_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_map_get: (String) -> Option[Type] = (name) -> {
  if name == "Map::get" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtUnknown, None))
  }
  else None
}

let lookup_map_has: (String) -> Option[Type] = (name) -> {
  if name == "map_has" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))
  }
  else None
}

let lookup_map_set: (String) -> Option[Type] = (name) -> {
  if name == "Map::set" {
    // Functional update: returns the (new) map, matching the host checker
    // (src/checker typecheck_call_builtin "Map::set"), not Unit.
    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtNamed("Map", [
      CtString,
      CtUnknown
    ]), None))
  }
  else None
}

let lookup_map_keys: (String) -> Option[Type] = (name) -> {
  if name == "Map::keys" {
    Some(CtFn(map_one_param(CtUnknown), CtArray(CtString), None))
  }
  else None
}

let lookup_map_has_key: (String) -> Option[Type] = (name) -> {
  if name == "Map::has_key" {
    Some(CtFn(map_two_params(CtUnknown, CtString), CtBool, None))
  }
  else None
}

let lookup_map_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_map_has(name) {
    Some(t) => Some(t),
    None => match lookup_map_keys(name) {
      Some(t) => Some(t),
      None => match lookup_map_has_key(name) {
        Some(t) => Some(t),
        None => lookup_map_set(name)
      }
    }
  }
}

let lookup_mapbuilder_new: (String) -> Option[Type] = (name) -> {
  if name == "MapBuilder::new" {
    Some(CtFn(map_no_params(), CtUnknown, None))
  }
  else None
}

let lookup_mapbuilder_set: (String) -> Option[Type] = (name) -> {
  if name == "MapBuilder::set" {
    Some(CtFn(map_three_params(CtUnknown, CtString, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_mapbuilder_freeze: (String) -> Option[Type] = (name) -> {
  if name == "MapBuilder::freeze" {
    Some(CtFn(map_one_param(CtUnknown), CtUnknown, None))
  }
  else None
}

let lookup_map_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_mapbuilder_new(name) {
    Some(t) => Some(t),
    None => match lookup_mapbuilder_set(name) {
      Some(t) => Some(t),
      None => match lookup_mapbuilder_freeze(name) {
        Some(t) => Some(t),
        None => lookup_map_get(name)
      }
    }
  }
}

export let lookup_map: (String) -> Option[Type] = (name) -> {
  match lookup_map_group_a(name) {
    Some(t) => Some(t),
    None => lookup_map_group_b(name)
  }
}
