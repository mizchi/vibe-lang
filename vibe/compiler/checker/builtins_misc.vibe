//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_eq = (name: String) -> Option[Type] {
  if name == "eq" {
    Some(CtFn(two_params(CtInt, CtInt), CtBool, false))
  }
  else None
}

let lookup_not = (name: String) -> Option[Type] {
  if name == "not" {
    Some(CtFn(one_param(CtBool), CtBool, false))
  }
  else None
}

let lookup_to_string = (name: String) -> Option[Type] {
  if name == "__to_string" {
    Some(CtFn(one_param(CtUnknown), CtString, false))
  }
  else None
}

let lookup_index = (name: String) -> Option[Type] {
  if name == "__index" {
    Some(CtFn(two_params(CtUnknown, CtUnknown), CtUnknown, false))
  }
  else None
}

let lookup_slice = (name: String) -> Option[Type] {
  if name == "__slice" {
    Some(CtFn(three_params(CtUnknown, CtInt, CtInt), CtUnknown, false))
  }
  else None
}

let lookup_print = (name: String) -> Option[Type] {
  if name == "print" {
    Some(CtFn(one_param(CtString), CtUnit, false))
  }
  else None
}

let lookup_println = (name: String) -> Option[Type] {
  if name == "println" {
    Some(CtFn(one_param(CtString), CtUnit, false))
  }
  else None
}

let lookup_assert = (name: String) -> Option[Type] {
  if name == "assert" {
    Some(CtFn(one_param(CtBool), CtUnit, false))
  }
  else None
}

let lookup_throw = (name: String) -> Option[Type] {
  if name == "throw" {
    Some(CtFn(one_param(CtString), CtUnknown, true))
  }
  else None
}

let lookup_int_to_double = (name: String) -> Option[Type] {
  if name == "Int::to_double" {
    Some(CtFn(one_param(CtInt), CtDouble, false))
  }
  else None
}

let lookup_double_to_int = (name: String) -> Option[Type] {
  if name == "Double::to_int" {
    Some(CtFn(one_param(CtDouble), CtInt, false))
  }
  else None
}

let lookup_double_to_i64_bits = (name: String) -> Option[Type] {
  if name == "Double::to_i64_bits" {
    Some(CtFn(one_param(CtDouble), CtInt, false))
  }
  else None
}

let lookup_double_from_i64_bits = (name: String) -> Option[Type] {
  if name == "Double::from_i64_bits" {
    Some(CtFn(one_param(CtInt), CtDouble, false))
  }
  else None
}

let lookup_char_to_int = (name: String) -> Option[Type] {
  if name == "Char::to_int" {
    Some(CtFn(one_param(CtChar), CtInt, false))
  }
  else None
}

let lookup_char_from_int = (name: String) -> Option[Type] {
  if name == "Char::from_int" {
    Some(CtFn(one_param(CtInt), CtChar, false))
  }
  else None
}

let lookup_some = (name: String) -> Option[Type] {
  if name == "Some" {
    Some(CtFn(one_param(CtUnknown), CtOption(CtUnknown), false))
  }
  else None
}

let lookup_none = (name: String) -> Option[Type] {
  if name == "None" {
    Some(CtOption(CtUnknown))
  }
  else None
}

let lookup_misc_group_a = (name: String) -> Option[Type] {
  match lookup_eq(name) {
    Some(t) => Some(t),
    None => match lookup_not(name) {
      Some(t) => Some(t),
      None => match lookup_to_string(name) {
        Some(t) => Some(t),
        None => lookup_index(name)
      }
    }
  }
}

let lookup_misc_group_b = (name: String) -> Option[Type] {
  match lookup_slice(name) {
    Some(t) => Some(t),
    None => match lookup_print(name) {
      Some(t) => Some(t),
      None => match lookup_println(name) {
        Some(t) => Some(t),
        None => lookup_assert(name)
      }
    }
  }
}

let lookup_misc_group_c = (name: String) -> Option[Type] {
  match lookup_throw(name) {
    Some(t) => Some(t),
    None => match lookup_int_to_double(name) {
      Some(t) => Some(t),
      None => match lookup_double_to_int(name) {
        Some(t) => Some(t),
        None => lookup_double_to_i64_bits(name)
      }
    }
  }
}

let lookup_misc_group_d = (name: String) -> Option[Type] {
  match lookup_double_from_i64_bits(name) {
    Some(t) => Some(t),
    None => match lookup_char_to_int(name) {
      Some(t) => Some(t),
      None => match lookup_char_from_int(name) {
        Some(t) => Some(t),
        None => lookup_some(name)
      }
    }
  }
}

let lookup_misc_group_e = (name: String) -> Option[Type] {
  lookup_none(name)
}

export let lookup_misc = (name: String) -> Option[Type] {
  match lookup_misc_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_misc_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_misc_group_c(name) {
        Some(t) => Some(t),
        None => match lookup_misc_group_d(name) {
          Some(t) => Some(t),
          None => lookup_misc_group_e(name)
        }
      }
    }
  }
}
