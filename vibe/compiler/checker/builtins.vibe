//# Imports

import ../core/types.vibe {
  Type, resolve_builtin
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let lookup_fs = (name: String) -> Option[Type] {
  if String::equals(name, "Fs::read_file") {
    Some(CtFn([
      CtString
    ], CtString, true))
  }
  else if String::equals(name, "Fs::write_file") {
    Some(CtFn([
      CtString,
      CtString
    ], CtUnit, true))
  }
  else if String::equals(name, "Fs::read_bytes") {
    Some(CtFn([
      CtString
    ], CtBytes, true))
  }
  else if String::equals(name, "Fs::write_bytes") {
    Some(CtFn([
      CtString,
      CtBytes
    ], CtUnit, true))
  }
  else if String::equals(name, "Fs::exists") {
    Some(CtFn([
      CtString
    ], CtBool, true))
  }
  else if String::equals(name, "Fs::stat_token") {
    Some(CtFn([
      CtString
    ], CtInt, true))
  }
  else if String::equals(name, "Fs::readdir") {
    Some(CtFn([
      CtString
    ], CtArray(CtString), true))
  }
  else if String::equals(name, "Fs::is_dir") {
    Some(CtFn([
      CtString
    ], CtBool, true))
  }
  else if String::equals(name, "Fs::is_file") {
    Some(CtFn([
      CtString
    ], CtBool, true))
  }
  else if String::equals(name, "Fs::mkdir") {
    Some(CtFn([
      CtString
    ], CtUnit, true))
  }
  else if String::equals(name, "Fs::getcwd") {
    Some(CtFn(no_params(), CtString, true))
  }
  else if String::equals(name, "Fs::chdir") {
    Some(CtFn([
      CtString
    ], CtUnit, true))
  }
  else if String::equals(name, "Fs::remove") {
    Some(CtFn([
      CtString
    ], CtUnit, true))
  }
  else if String::equals(name, "Fs::copy") {
    Some(CtFn([
      CtString,
      CtString
    ], CtUnit, true))
  }
  else if String::equals(name, "Fs::append") {
    Some(CtFn([
      CtString,
      CtString
    ], CtUnit, true))
  }
  else None
}

