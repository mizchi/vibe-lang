//# Imports

import ../core/types.vibe {
  Type
}
import ./builtins_fs.vibe {
  lookup_fs
}
import ./builtins_map.vibe {
  lookup_map
}
import ./builtins_net.vibe {
  lookup_net
}
import ./builtins_misc.vibe {
  lookup_misc
}
import ./builtins_system.vibe {
  lookup_io
}
import ./builtins_array.vibe {
  lookup_array
}
import ./builtins_fixed_array.vibe {
  lookup_fixed_array
}
import ./builtins_bytes.vibe {
  lookup_bytes
}
import ./builtins_string1.vibe {
  lookup_string1
}
import ./builtins_string2.vibe {
  lookup_string2
}
import ./builtins_builders.vibe {
  lookup_array_builder, lookup_string_builder
}

//# Functions

let canonical_builtin_name = (name: String) -> String {
  match name {
    "Fs::ReadFile" => "Fs::read_file",
    "Fs::WriteFile" => "Fs::write_file",
    "Fs::ReadBytes" => "Fs::read_bytes",
    "Fs::WriteBytes" => "Fs::write_bytes",
    "Fs::Exists" => "Fs::exists",
    "Fs::StatToken" => "Fs::stat_token",
    "Fs::ReadDir" => "Fs::readdir",
    "Fs::IsDir" => "Fs::is_dir",
    "Fs::IsFile" => "Fs::is_file",
    "Fs::Mkdir" => "Fs::mkdir",
    "Fs::Getcwd" => "Fs::getcwd",
    "Fs::Chdir" => "Fs::chdir",
    "Fs::Remove" => "Fs::remove",
    "Fs::Copy" => "Fs::copy",
    "Fs::Append" => "Fs::append",
    "Env::Get" => "Env::get",
    "Env::ArgsLen" => "Env::args_len",
    "Env::ArgsGet" => "Env::args_get",
    _ => name
  }
}

export let lookup_builtin = (name: String) -> Option[Type] {
  let normalized = canonical_builtin_name(name)
  match lookup_array(normalized) {
    Some(t) => Some(t),
    None => match lookup_fixed_array(normalized) {
      Some(t) => Some(t),
      None => match lookup_array_builder(normalized) {
        Some(t) => Some(t),
        None => match lookup_string1(normalized) {
          Some(t) => Some(t),
          None => match lookup_string2(normalized) {
            Some(t) => Some(t),
            None => match lookup_string_builder(normalized) {
              Some(t) => Some(t),
              None => match lookup_bytes(normalized) {
                Some(t) => Some(t),
                None => match lookup_map(normalized) {
                  Some(t) => Some(t),
                  None => match lookup_io(normalized) {
                    Some(t) => Some(t),
                    None => match lookup_fs(normalized) {
                      Some(t) => Some(t),
                      None => match lookup_net(normalized) {
                        Some(t) => Some(t),
                        None => lookup_misc(normalized)
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
