//# Imports

import ../core/types.vibe {
  Type, resolve_builtin
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let lookup_fs = (name: String) -> Option[Type] {
  if name == "Fs::read_file" {
    Some(CtFn([
      CtString
    ], CtString, true))
  }
  else if name == "Fs::write_file" {
    Some(CtFn([
      CtString,
      CtString
    ], CtUnit, true))
  }
  else if name == "Fs::read_bytes" {
    Some(CtFn([
      CtString
    ], CtBytes, true))
  }
  else if name == "Fs::write_bytes" {
    Some(CtFn([
      CtString,
      CtBytes
    ], CtUnit, true))
  }
  else if name == "Fs::exists" {
    Some(CtFn([
      CtString
    ], CtBool, true))
  }
  else if name == "Fs::stat_token" {
    Some(CtFn([
      CtString
    ], CtInt, true))
  }
  else if name == "Fs::readdir" {
    Some(CtFn([
      CtString
    ], CtArray(CtString), true))
  }
  else if name == "Fs::is_dir" {
    Some(CtFn([
      CtString
    ], CtBool, true))
  }
  else if name == "Fs::is_file" {
    Some(CtFn([
      CtString
    ], CtBool, true))
  }
  else if name == "Fs::mkdir" {
    Some(CtFn([
      CtString
    ], CtUnit, true))
  }
  else if name == "Fs::getcwd" {
    Some(CtFn(no_params(), CtString, true))
  }
  else if name == "Fs::chdir" {
    Some(CtFn([
      CtString
    ], CtUnit, true))
  }
  else if name == "Fs::remove" {
    Some(CtFn([
      CtString
    ], CtUnit, true))
  }
  else if name == "Fs::copy" {
    Some(CtFn([
      CtString,
      CtString
    ], CtUnit, true))
  }
  else if name == "Fs::append" {
    Some(CtFn([
      CtString,
      CtString
    ], CtUnit, true))
  }
  else None
}

let lookup_io = (name: String) -> Option[Type] {
  if name == "sh" {
    Some(CtFn([
      CtString
    ], CtString, true))
  }
  else if name == "sh_lines" {
    Some(CtFn([
      CtString
    ], CtArray(CtString), true))
  }
  else if name == "path" {
    Some(CtFn([
      CtString
    ], CtUnknown, false))
  }
  else if name == "Path::to_string" {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if name == "Path::is_absolute" {
    Some(CtFn([
      CtString
    ], CtBool, false))
  }
  else if name == "PromptText::new" {
    Some(CtFn([
      CtString
    ], CtString, false))
  }
  else if name == "Stdin::read_char" {
    Some(CtFn(no_params(), CtInt, true))
  }
  else if name == "Stdin::read_stream" {
    Some(CtFn(no_params(), CtString, true))
  }
  else if name == "Stdout::write_char" {
    Some(CtFn([
      CtInt
    ], CtUnit, false))
  }
  else if name == "Stdout::write_stream" {
    Some(CtFn([
      CtString
    ], CtUnit, false))
  }
  else if name == "Env::get" {
    Some(CtFn([
      CtString
    ], CtString, true))
  }
  else if name == "Env::args_len" {
    Some(CtFn(no_params(), CtInt, true))
  }
  else if name == "Env::args_get" {
    Some(CtFn([
      CtInt
    ], CtString, true))
  }
  else if name == "sleep" {
    Some(CtFn([
      CtInt
    ], CtUnit, false))
  }
  else if name == "Path::resolve" {
    Some(CtFn([
      CtString
    ], CtString, false))
  }
  else None
}

