//# Imports

import ../core/types.vibe {
  Type, resolve_builtin
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let register = (b: MapBuilder, name: String, t: Type) -> Unit {
  MapBuilder::set(b, name, t)
}

let build_builtin_table = () -> Map[String, Type] {
  let b = MapBuilder::new()

  // Fs
  register(b, "Fs::read_file", CtFn([CtString], CtString, true))
  register(b, "Fs::write_file", CtFn([CtString, CtString], CtUnit, true))
  register(b, "Fs::read_bytes", CtFn([CtString], CtBytes, true))
  register(b, "Fs::write_bytes", CtFn([CtString, CtBytes], CtUnit, true))
  register(b, "Fs::exists", CtFn([CtString], CtBool, true))
  register(b, "Fs::stat_token", CtFn([CtString], CtInt, true))
  register(b, "Fs::readdir", CtFn([CtString], CtArray(CtString), true))
  register(b, "Fs::is_dir", CtFn([CtString], CtBool, true))
  register(b, "Fs::is_file", CtFn([CtString], CtBool, true))
  register(b, "Fs::mkdir", CtFn([CtString], CtUnit, true))
  register(b, "Fs::getcwd", CtFn(no_params(), CtString, true))
  register(b, "Fs::chdir", CtFn([CtString], CtUnit, true))
  register(b, "Fs::remove", CtFn([CtString], CtUnit, true))
  register(b, "Fs::copy", CtFn([CtString, CtString], CtUnit, true))
  register(b, "Fs::append", CtFn([CtString, CtString], CtUnit, true))

  // IO
  register(b, "sh", CtFn([CtString], CtString, true))
  register(b, "sh_lines", CtFn([CtString], CtArray(CtString), true))
  register(b, "path", CtFn([CtString], CtUnknown, false))
  register(b, "Path::to_string", CtFn([CtUnknown], CtString, false))
  register(b, "Path::is_absolute", CtFn([CtString], CtBool, false))
  register(b, "Path::resolve", CtFn([CtString], CtString, false))
  register(b, "PromptText::new", CtFn([CtString], CtString, false))
  register(b, "Stdin::read_char", CtFn(no_params(), CtInt, true))
  register(b, "Stdin::read_stream", CtFn(no_params(), CtString, true))
  register(b, "Stdout::write_char", CtFn([CtInt], CtUnit, false))
  register(b, "Stdout::write_stream", CtFn([CtString], CtUnit, false))
  register(b, "Env::get", CtFn([CtString], CtString, true))
  register(b, "Env::args_len", CtFn(no_params(), CtInt, true))
  register(b, "Env::args_get", CtFn([CtInt], CtString, true))
  register(b, "sleep", CtFn([CtInt], CtUnit, false))

  // Map
  register(b, "MapBuilder::new", CtFn(no_params(), CtUnknown, false))
  register(b, "MapBuilder::set", CtFn([CtUnknown, CtString, CtUnknown], CtUnit, false))
  register(b, "MapBuilder::freeze", CtFn([CtUnknown], CtUnknown, false))
  register(b, "Map::get", CtFn([CtUnknown, CtString], CtUnknown, false))
  register(b, "map_has", CtFn([CtUnknown, CtString], CtBool, false))
  register(b, "Map::keys", CtFn([CtUnknown], CtArray(CtString), false))

  // Net
  register(b, "Socket::tcp_connect", CtFn([CtString, CtInt], CtUnknown, true))
  register(b, "Socket::tcp_read", CtFn([CtUnknown, CtInt], CtString, true))
  register(b, "Socket::tcp_write", CtFn([CtUnknown, CtString], CtInt, true))
  register(b, "Socket::tcp_close", CtFn([CtUnknown], CtUnit, true))
  register(b, "Http::request", CtFn([CtString, CtString], CtUnknown, true))
  register(b, "Http::response_status", CtFn([CtUnknown], CtInt, false))
  register(b, "Http::response_header", CtFn([CtUnknown, CtString], CtString, false))
  register(b, "Http::response_body", CtFn([CtUnknown], CtString, true))
  register(b, "Http::close", CtFn([CtUnknown], CtUnit, false))
  register(b, "Http::listen", CtFn([CtString, CtInt], CtUnknown, true))
  register(b, "Http::accept", CtFn([CtUnknown], CtUnknown, true))
  register(b, "Http::request_method", CtFn([CtUnknown], CtString, false))
  register(b, "Http::request_header", CtFn([CtUnknown, CtString], CtString, false))
  register(b, "Http::respond", CtFn([CtUnknown, CtInt, CtString], CtUnit, true))

  // Misc
  register(b, "eq", CtFn([CtInt, CtInt], CtBool, false))
  register(b, "not", CtFn([CtBool], CtBool, false))
  register(b, "__to_string", CtFn([CtUnknown], CtString, false))
  register(b, "print", CtFn([CtString], CtUnit, false))
  register(b, "println", CtFn([CtString], CtUnit, false))
  register(b, "assert", CtFn([CtBool], CtUnit, false))
  register(b, "throw", CtFn([CtString], CtUnknown, true))
  register(b, "Int::to_double", CtFn([CtInt], CtDouble, false))
  register(b, "Double::to_int", CtFn([CtDouble], CtInt, false))
  register(b, "Double::to_i64_bits", CtFn([CtDouble], CtInt, false))
  register(b, "Double::from_i64_bits", CtFn([CtInt], CtDouble, false))

  // Array
  register(b, "array_new", CtFn(no_params(), CtArray(CtUnknown), false))
  register(b, "Array::length", CtFn([CtArray(CtUnknown)], CtInt, false))
  register(b, "Array::get", CtFn([CtArray(CtUnknown), CtInt], CtUnknown, false))
  register(b, "Array::set", CtFn([CtArray(CtUnknown), CtInt, CtUnknown], CtUnit, false))
  register(b, "Array::push", CtFn([CtArray(CtUnknown), CtUnknown], CtUnit, false))
  register(b, "Array::slice", CtFn([CtArray(CtUnknown), CtInt, CtInt], CtArray(CtUnknown), false))
  register(b, "Array::push_all", CtFn([CtArray(CtUnknown), CtArray(CtUnknown)], CtUnit, false))
  register(b, "Array::concat", CtFn([CtArray(CtUnknown), CtArray(CtUnknown)], CtArray(CtUnknown), false))

  // FixedArray
  register(b, "FixedArray::make", CtFn([CtInt, CtUnknown], CtArray(CtUnknown), false))
  register(b, "FixedArray::length", CtFn([CtArray(CtUnknown)], CtInt, false))
  register(b, "FixedArray::get", CtFn([CtArray(CtUnknown), CtInt], CtUnknown, false))
  register(b, "FixedArray::set", CtFn([CtArray(CtUnknown), CtInt, CtUnknown], CtUnit, false))
  register(b, "FixedArray::unsafe_set", CtFn([CtArray(CtUnknown), CtInt, CtUnknown], CtUnit, false))
  register(b, "FixedArray::blit", CtFn([CtArray(CtUnknown), CtInt, CtArray(CtUnknown), CtInt, CtInt], CtUnit, false))

  // Bytes
  register(b, "Bytes::new", CtFn(no_params(), CtBytes, false))
  register(b, "Bytes::length", CtFn([CtBytes], CtInt, false))
  register(b, "Bytes::get", CtFn([CtBytes, CtInt], CtInt, false))
  register(b, "Bytes::set", CtFn([CtBytes, CtInt, CtInt], CtUnit, false))
  register(b, "Bytes::push", CtFn([CtBytes, CtInt], CtUnit, false))
  register(b, "Bytes::concat", CtFn([CtBytes, CtBytes], CtBytes, false))
  register(b, "Bytes::slice", CtFn([CtBytes, CtInt, CtInt], CtBytes, false))
  register(b, "Bytes::from_array", CtFn([CtArray(CtInt)], CtBytes, false))
  register(b, "Bytes::to_array", CtFn([CtBytes], CtArray(CtInt), false))

  // String
  register(b, "String::concat", CtFn([CtString, CtString], CtString, false))
  register(b, "String::length", CtFn([CtString], CtInt, false))
  register(b, "String::equals", CtFn([CtString, CtString], CtBool, false))
  register(b, "String::substring", CtFn([CtString, CtInt, CtInt], CtString, false))
  register(b, "string_char_at", CtFn([CtString, CtInt], CtString, false))
  register(b, "String::index_of", CtFn([CtString, CtString], CtInt, false))
  register(b, "String::contains", CtFn([CtString, CtString], CtBool, false))
  register(b, "String::starts_with", CtFn([CtString, CtString], CtBool, false))
  register(b, "String::ends_with", CtFn([CtString, CtString], CtBool, false))
  register(b, "String::from_char_code", CtFn([CtInt], CtString, false))
  register(b, "String::char_code_at", CtFn([CtString, CtInt], CtInt, false))
  register(b, "String::last_index_of", CtFn([CtString, CtString], CtInt, false))

  // ArrayBuilder
  register(b, "ArrayBuilder::new", CtFn(no_params(), CtUnknown, false))
  register(b, "ArrayBuilder::push", CtFn([CtUnknown, CtUnknown], CtUnit, false))
  register(b, "ArrayBuilder::freeze", CtFn([CtUnknown], CtArray(CtUnknown), false))

  // StringBuilder
  register(b, "StringBuilder::new", CtFn(no_params(), CtUnknown, false))
  register(b, "StringBuilder::push", CtFn([CtUnknown, CtString], CtUnit, false))
  register(b, "StringBuilder::freeze", CtFn([CtUnknown], CtString, false))

  MapBuilder::freeze(b)
}

let mut cached_table: Option[Map[String, Type]] = None

export let lookup_builtin = (name: String) -> Option[Type] {
  let table = match cached_table {
    Some(t) => t,
    None => {
      let t = build_builtin_table()
      cached_table = Some(t)
      t
    }
  }
  match resolve_builtin(name) {
    Some(t) => Some(t),
    None => {
      if map_has(table, name) {
        Some(Map::get(table, name))
      } else {
        None
      }
    }
  }
}
