  }
  else if name == "not" {
    Some(CtFn([
      CtBool
    ], CtBool, false))
  }
  else if name == "__to_string" {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if name == "__index" {
    Some(CtFn([
      CtUnknown,
      CtUnknown
    ], CtUnknown, false))
  }
  else if name == "__slice" {
    Some(CtFn([
      CtUnknown,
      CtInt,
      CtInt
    ], CtUnknown, false))
  }
  else if name == "print" {
    Some(CtFn([
      CtString
    ], CtUnit, false))
  }
  else if name == "println" {
    Some(CtFn([
