    ], CtUnit, false))
  }
  else if name == "assert" {
    Some(CtFn([
      CtBool
    ], CtUnit, false))
  }
  else if name == "throw" {
    Some(CtFn([
      CtString
    ], CtUnknown, true))
  }
  else if name == "Int::to_double" {
    Some(CtFn([
      CtInt
    ], CtDouble, false))
  }
  else if name == "Double::to_int" {
    Some(CtFn([
      CtDouble
    ], CtInt, false))
  }
