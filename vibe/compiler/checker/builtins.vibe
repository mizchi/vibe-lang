let lookup_array = (name: String) -> Option[Type] {
  if name == "array_new" {
    Some(CtFn(no_params(), CtArray(CtUnknown), false))
  }
  else if name == "Array::length" {
    Some(CtFn([
      CtArray(CtUnknown)
    ], CtInt, false))
  }
  else if name == "Array::get" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt
    ], CtUnknown, false))
  }
  else if name == "Array::set" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtUnknown
    ], CtUnit, false))
  }
  else if name == "Array::push" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtUnknown
    ], CtUnit, false))
  }
  else if name == "Array::slice" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtInt
    ], CtArray(CtUnknown), false))
  }
  else if name == "Array::push_all" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtArray(CtUnknown)
    ], CtUnit, false))
  }
  else if name == "Array::concat" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtArray(CtUnknown)
    ], CtArray(CtUnknown), false))
  }
  else None
}

