//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let lookup_fs_copy = (name: String) -> Option[Type] {
  if name == "Fs::copy" {
    Some(CtFn(two_params(CtString, CtString), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_chdir = (name: String) -> Option[Type] {
  if name == "Fs::chdir" {
    Some(CtFn(one_param(CtString), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_mkdir = (name: String) -> Option[Type] {
  if name == "Fs::mkdir" {
    Some(CtFn(one_param(CtString), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_append = (name: String) -> Option[Type] {
  if name == "Fs::append" {
    Some(CtFn(two_params(CtString, CtString), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_exists = (name: String) -> Option[Type] {
  if name == "Fs::exists" {
    Some(CtFn(one_param(CtString), CtBool, Some("Fs")))
  }
  else None
}

let lookup_fs_getcwd = (name: String) -> Option[Type] {
  if name == "Fs::getcwd" {
    Some(CtFn(no_params(), CtString, Some("Fs")))
  }
  else None
}

let lookup_fs_is_dir = (name: String) -> Option[Type] {
  if name == "Fs::is_dir" {
    Some(CtFn(one_param(CtString), CtBool, Some("Fs")))
  }
  else None
}

let lookup_fs_remove = (name: String) -> Option[Type] {
  if name == "Fs::remove" {
    Some(CtFn(one_param(CtString), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_group_d = (name: String) -> Option[Type] {
  match lookup_fs_remove(name) {
    Some(t) => Some(t),
    None => match lookup_fs_copy(name) {
      Some(t) => Some(t),
      None => lookup_fs_append(name)
    }
  }
}

let lookup_fs_is_file = (name: String) -> Option[Type] {
  if name == "Fs::is_file" {
    Some(CtFn(one_param(CtString), CtBool, Some("Fs")))
  }
  else None
}

let lookup_fs_group_c = (name: String) -> Option[Type] {
  match lookup_fs_is_file(name) {
    Some(t) => Some(t),
    None => match lookup_fs_mkdir(name) {
      Some(t) => Some(t),
      None => match lookup_fs_getcwd(name) {
        Some(t) => Some(t),
        None => lookup_fs_chdir(name)
      }
    }
  }
}

let lookup_fs_readdir = (name: String) -> Option[Type] {
  if name == "Fs::readdir" {
    Some(CtFn(one_param(CtString), CtArray(CtString), Some("Fs")))
  }
  else None
}

let lookup_fs_read_file = (name: String) -> Option[Type] {
  if name == "Fs::read_file" {
    Some(CtFn(one_param(CtString), CtString, Some("Fs")))
  }
  else None
}

let lookup_fs_read_bytes = (name: String) -> Option[Type] {
  if name == "Fs::read_bytes" {
    Some(CtFn(one_param(CtString), CtBytes, Some("Fs")))
  }
  else None
}

let lookup_fs_stat_token = (name: String) -> Option[Type] {
  if name == "Fs::stat_token" {
    Some(CtFn(one_param(CtString), CtInt, Some("Fs")))
  }
  else None
}

let lookup_fs_group_b = (name: String) -> Option[Type] {
  match lookup_fs_exists(name) {
    Some(t) => Some(t),
    None => match lookup_fs_stat_token(name) {
      Some(t) => Some(t),
      None => match lookup_fs_readdir(name) {
        Some(t) => Some(t),
        None => lookup_fs_is_dir(name)
      }
    }
  }
}

let lookup_fs_write_file = (name: String) -> Option[Type] {
  if name == "Fs::write_file" {
    Some(CtFn(two_params(CtString, CtString), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_write_bytes = (name: String) -> Option[Type] {
  if name == "Fs::write_bytes" {
    Some(CtFn(two_params(CtString, CtBytes), CtUnit, Some("Fs")))
  }
  else None
}

let lookup_fs_group_a = (name: String) -> Option[Type] {
  match lookup_fs_read_file(name) {
    Some(t) => Some(t),
    None => match lookup_fs_write_file(name) {
      Some(t) => Some(t),
      None => match lookup_fs_read_bytes(name) {
        Some(t) => Some(t),
        None => lookup_fs_write_bytes(name)
      }
    }
  }
}

export let lookup_fs = (name: String) -> Option[Type] {
  match lookup_fs_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_fs_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_fs_group_c(name) {
        Some(t) => Some(t),
        None => lookup_fs_group_d(name)
      }
    }
  }
}
