//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let lookup_array_builder_new = (name: String) -> Option[Type] {
  if name == "ArrayBuilder::new" {
    Some(CtFn(no_params(), CtUnknown, false))
  }
  else None
}

let lookup_array_builder_push = (name: String) -> Option[Type] {
  if name == "ArrayBuilder::push" {
    Some(CtFn(two_params(CtUnknown, CtUnknown), CtUnit, false))
  }
  else None
}

let lookup_array_builder_freeze = (name: String) -> Option[Type] {
  if name == "ArrayBuilder::freeze" {
    Some(CtFn(one_param(CtUnknown), CtArray(CtUnknown), false))
  }
  else None
}

export let lookup_array_builder = (name: String) -> Option[Type] {
  match lookup_array_builder_new(name) {
    Some(t) => Some(t),
    None => match lookup_array_builder_push(name) {
      Some(t) => Some(t),
      None => lookup_array_builder_freeze(name)
    }
  }
}

let lookup_string_builder_new = (name: String) -> Option[Type] {
  if name == "StringBuilder::new" {
    Some(CtFn(no_params(), CtUnknown, false))
  }
  else None
}

let lookup_string_builder_push = (name: String) -> Option[Type] {
  if name == "StringBuilder::push" {
    Some(CtFn(two_params(CtUnknown, CtString), CtUnit, false))
  }
  else None
}

let lookup_string_builder_freeze = (name: String) -> Option[Type] {
  if name == "StringBuilder::freeze" {
    Some(CtFn(one_param(CtUnknown), CtString, false))
  }
  else None
}

export let lookup_string_builder = (name: String) -> Option[Type] {
  match lookup_string_builder_new(name) {
    Some(t) => Some(t),
    None => match lookup_string_builder_push(name) {
      Some(t) => Some(t),
      None => lookup_string_builder_freeze(name)
    }
  }
}
