//# Imports

import .. / checker_trait.vibe {
  register_builtin_traits
}

import .. / core / ast.vibe {
  Expr, Stmt, TypeExpr
}

import .. / core / types.vibe {
  Subst, Type, TypeDef, TypeEnv, collect_subst_bounds_pairs, env_bind, env_cache, env_flat_bindings, env_lookup_flat, generalize, resolve_builtin, subst_apply, trait_defined, type_implements_trait, type_to_string
}

import ./checker.vibe {
  check_expr, fn_return_env_name
}

import ./checker_resolve.vibe {
  resolve_type_expr, subst_type_params
}

//# Functions

let rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {
  if i >= Array::length(cache) {
    None
  }
  else {
    let (cached_name, cached_ty) = Array::get(cache, i)
    if cached_name == name {
      Some(cached_ty)
    }
    else import_cache_lookup(cache, name, i + 1)
  }
}

let bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {
  let env_bindings = env_flat_bindings(env)
  let import_cache = Array::slice([
    ("", CtUnknown)
  ], 0, 0)
  let nlen = Array::length(names)
  let mut i = 0
  let mut acc = env
  while i < nlen {
    let (name, alias) = Array::get(names, i)
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let ty = match import_cache_lookup(import_cache, name, 0) {
      Some(t) => t,
      None => {
        let resolved = match env_lookup_flat(env_bindings, name) {
          Some(t) => t,
          None => CtUnknown
        }
        Array::push(import_cache, (name, resolved))
        resolved
      }
    }
    let acc_with_name = env_bind(acc, bound_name, ty)
    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {
      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),
      None => acc_with_name
    }
    i = i + 1
  }
  acc
}

let annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {
  match ann {
    Some(te) => match te {
      TyFn(params, ret, _) => {
        let ret_box = Array::slice([
          ret
        ], 0, 1)
        let _ = Array::length(params)
        Some(resolve_type_expr(Array::get(ret_box, 0), defs))
      },
      _ => None
    },
    None => None
  }
}

let fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {
  match expr {
    EFn(_, _, _, ret_ty, _, _) => match ret_ty {
      Some(te) => Some(resolve_type_expr(te, defs)),
      None => None
    },
    _ => None
  }
}

let bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {
  env_bind(env, fn_return_env_name(name), ret_ty)
}

let bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {
  match annotation_return_type(ann, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => env
  }
}

let bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {
  match fn_expr_return_type(val, defs) {
    Some(ret_ty) => bind_fn_return(env, name, ret_ty),
    None => bind_annotation_return(env, name, ann, defs)
  }
}

let stmt_is_type_decl: (Stmt) -> Bool = (stmt) -> {
  match stmt {
    SEnum(_, _, _, _) => true,
    SSuberror(_, _, _) => true,
    SStruct(_, _, _) => true,
    STypeAlias(_, _, _, _) => true,
    _ => false
  }
}

// #613: process type declarations (enum / struct / type-alias / suberror) before
// value definitions so a `let` may construct or reference a type or constructor
// declared LATER in the same statement list (a forward reference). check_stmts
// records each type into `defs` and binds its constructors into `env` only when
// the declaration statement is reached, so without this a value defined before
// its enum saw neither the type nor its constructors and aborted the compile
// with an opaque trap (e.g. an imported module whose function constructs an enum
// value lands before the enum in the merged statement list). Codegen is already
// order-independent (the ctor table scans every statement up front), so this
// check-side reorder is sufficient. The partition is STABLE, so already-ordered
// (type-before-value) code is processed exactly as before, and relative order
// within each group is preserved.
let reorder_type_decls_first: (Array[Stmt], Int) -> Array[Stmt] = (stmts, start) -> {
  let out = Array::slice(stmts, 0, start)
  let n = Array::length(stmts)
  let mut i = start
  while i < n {
    let st = Array::get(stmts, i)
    if stmt_is_type_decl(st) {
      Array::push(out, st)
    }
    i = i + 1
  }
  let mut j = start
  while j < n {
    let st = Array::get(stmts, j)
    if !stmt_is_type_decl(st) {
      Array::push(out, st)
    }
    j = j + 1
  }
  out
}

export let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (TypeEnv, Subst, Int) = (raw_stmts, i, env, defs, s, c, errors, tytab) -> {
  let stmts = reorder_type_decls_first(raw_stmts, i)
  let mut idx = i
  let mut cur_env = env
  let mut cur_s = s
  let mut cur_c = c
  // #602: hoist top-level binding signatures so a `let` may reference another
  // top-level `let` defined later in the same statement list (a forward
  // reference). Without this, checking the earlier binding's body raised
  // "unknown name" and aborted the whole compile with an opaque trap.
  // check_stmts is only used for program / module statement lists — local
  // `let`s are ELet expressions checked in check_expr — so this does not affect
  // block scoping. An annotated binding hoists its declared type; an
  // un-annotated one hoists as CtUnknown (its precise type is filled in when its
  // own statement is reached, which shadows this pre-binding). Pre-binding only
  // adds names, and a later real binding shadows it, so ordered
  // (backward-reference) code is checked exactly as before.
  let mut hoist_i = idx
  while hoist_i < Array::length(stmts) {
    match Array::get(stmts, hoist_i) {
      SLet(_, _, hname, hann, _) => {
        let ht = match hann {
          Some(hte) => resolve_type_expr(hte, defs),
          None => CtUnknown
        }
        cur_env = env_bind(cur_env, hname, ht)
      },
      _ => ()
    }
    hoist_i = hoist_i + 1
  }
  while idx < Array::length(stmts) {
    let env = cur_env
    let s = cur_s
    let c = cur_c
    let stmt = Array::get(stmts, idx)
    let (new_env, s1, c1) = match stmt {
      SLet(_, is_rec, name, ann, val) => {
        let (vt, ns, nc) = if is_rec {
          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)
        } else {
          check_expr(val, env, defs, s, c, errors, tytab)
        }
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => generalize(ns, vt)
        }
        let env1 = env_bind(env, name, t)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetMut(name, ann, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)
        let t = match ann {
          Some(te) => resolve_type_expr(te, defs),
          None => vt
        }
        let env1 = env_bind(env, name, t)
        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)
      },
      SLetPat(pat, val) => {
        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)
        let new_env = match pat {
          PTuple(pats) => match vt {
            CtTuple(types) => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => if pi < Array::length(types) {
                    e = env_bind(e, name, Array::get(types, pi))
                  } else {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            },
            _ => {
              let mut e = env
              let mut pi = 0
              while pi < Array::length(pats) {
                match Array::get(pats, pi) {
                  PBind(name) => {
                    e = env_bind(e, name, CtUnknown)
                  },
                  _ => ()
                }
                pi = pi + 1
              }
              e
            }
          },
          PBind(name) => env_bind(env, name, vt),
          PStruct(_, fields) => {
            let mut e = env
            let mut fi = 0
            while fi < Array::length(fields) {
              let (_, fpat) = Array::get(fields, fi)
              match fpat {
                PBind(name) => {
                  e = env_bind(e, name, CtUnknown)
                },
                _ => ()
              }
              fi = fi + 1
            }
            e
          },
          _ => env
        }
        (new_env, ns, nc)
      },
      SEnum(_, name, params, variants) => {
        let param_len = Array::length(params)
        let param_var_ids = Array::slice([
          0
        ], 0, 0)
        let param_var_types = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut pi = 0
        while pi < param_len {
          let vid = c + pi
          Array::push(param_var_ids, vid)
          Array::push(param_var_types, CtVar(vid))
          pi = pi + 1
        }
        let ctor_result_type = if param_len == 0 {
          CtEnum(name)
        } else {
          CtNamed(name, param_var_types)
        }
        let ctor_bounds = Array::slice([
          (0, Array::slice([
            ""
          ], 0, 0))
        ], 0, 0)
        let resolved_variants = Array::slice([
          ("", Array::slice([
            CtUnknown
          ], 0, 0))
        ], 0, 0)
        let mut vi = 0
        while vi < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, vi)
          let resolved_vtypes = Array::slice([
            CtUnknown
          ], 0, 0)
          let mut ti = 0
          while ti < Array::length(vtypes) {
            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)
            Array::push(resolved_vtypes, vt)
            ti = ti + 1
          }
          Array::push(resolved_variants, (vname, resolved_vtypes))
          vi = vi + 1
        }
        Array::push(defs, TDEnum(name, params, resolved_variants))
        let mut env1 = env_bind(env, name, CtEnum(name))
        let mut ci2 = 0
        while ci2 < Array::length(variants) {
          let (vname, vtypes) = Array::get(variants, ci2)
          let ctor_ty = if Array::length(vtypes) == 0 {
            ctor_result_type
          } else {
            let resolved_args = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            while ai < Array::length(vtypes) {
              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)
              Array::push(resolved_args, arg_ty)
              ai = ai + 1
            }
            CtFn(resolved_args, ctor_result_type, None)
          }
          let exported_ctor_ty = if param_len == 0 {
            ctor_ty
          } else {
            CtForAll(param_var_ids, ctor_bounds, ctor_ty)
          }
          env1 = env_bind(env1, vname, exported_ctor_ty)
          match ctor_ty {
            CtFn(_, ret, _) => {
              let exported_ret_ty = if param_len == 0 {
                ret
              } else {
                CtForAll(param_var_ids, ctor_bounds, ret)
              }
              env1 = bind_fn_return(env1, vname, exported_ret_ty)
            },
            _ => ()
          }
          ci2 = ci2 + 1
        }
        (env1, s, c + param_len)
      },
      SStruct(_, name, field_defs) => {
        let resolved_fields = Array::slice([
          ("", CtUnit)
        ], 0, 0)
        let mut fi = 0
        while fi < Array::length(field_defs) {
          let (fname, ftype_expr) = Array::get(field_defs, fi)
          let ftype = resolve_type_expr(ftype_expr, defs)
          Array::push(resolved_fields, (fname, ftype))
          fi = fi + 1
        }
        Array::push(defs, TDStruct(name, resolved_fields))
        let field_types = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut fj = 0
        while fj < Array::length(resolved_fields) {
          let (_, fty) = Array::get(resolved_fields, fj)
          Array::push(field_types, fty)
          fj = fj + 1
        }
        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))
        (bind_fn_return(env1, name, CtStruct(name)), s, c)
      },
      STypeAlias(_, name, params, te) => {
        let t = resolve_type_expr(te, defs)
        // Record the alias (with its formal params) so an applied use
        // `Name[Arg]` expands via subst in resolve_type_expr's TyApp case.
        Array::push(defs, TDAlias(name, params, t))
        (env_bind(env, name, t), s, c)
      },
      SExternLet(name, te) => {
        let t = resolve_type_expr(te, defs)
        let env1 = env_bind(env, name, t)
        (bind_annotation_return(env1, name, Some(te), defs), s, c)
      },
      STest(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)
        (env, ns, nc)
      },
      SBench(_, body) => {
        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)
        (env, ns, nc)
      },
      SExpr(expr) => {
        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)
        (env, ns, nc)
      },
      SModule(_, _, body) => {
        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)
        (env, s, c)
      },
      SImport(_, names) => (bind_stmt_imports(env, names), s, c)
      ,
      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)
      ,
      SAliasDecl(_, _) => (env, s, c)
      ,
      STrait(_, name, supers) => {
        let is_open = false
        (EnvTraitDef(name, supers, is_open, env), s, c)
      },
      SImpl(_, _, trait_name, type_name) => {
        let target = match resolve_builtin(type_name) {
          Some(t) => t,
          None => CtNamed(type_name, Array::slice([
            CtUnknown
          ], 0, 0))
        }
        (EnvTraitImpl(trait_name, target, env), s, c)
      },
      _ => (env, s, c)
    }
    cur_env = new_env
    cur_s = s1
    cur_c = c1
    idx = idx + 1
  }
  (cur_env, cur_s, cur_c)
}

// #641 PR-2: enforce trait bounds. After inference, every bounded type variable
// recorded in the final substitution that resolved to a CONCRETE type must
// satisfy its bounds. Unresolved (still-polymorphic) vars are inherited by the
// caller, not violated, so they are skipped. One `no impl `Trait` for `Type``
// error per unsatisfied bound (matches fixtures/err_type_trait_*bound* messages).
let check_program_bounds: (TypeEnv, Subst, Array[String]) -> Unit = (env, s, errors) -> {
  let pairs = collect_subst_bounds_pairs(s)
  let n = Array::length(pairs)
  let mut i = 0
  while i < n {
    let (vid, bounds) = Array::get(pairs, i)
    let resolved = subst_apply(s, CtVar(vid))
    match resolved {
      CtVar(_) => (),
      CtUnknown => (),
      _ => {
        let bn = Array::length(bounds)
        let mut bi = 0
        while bi < bn {
          let b = Array::get(bounds, bi)
          if b != "" && not(type_implements_trait(env, s, resolved, b)) {
            Array::push(errors, String::concat("no impl `", String::concat(b, String::concat("` for `", String::concat(type_to_string(resolved), "`")))))
          }
          bi = bi + 1
        }
      }
    }
    i = i + 1
  }
}

export let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {
  let empty_defs = Array::slice([
    TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
  ], 0, 0)
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let tytab = Array::slice([
    (0, CtUnit)
  ], 0, 0)
  let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
  check_program_bounds(env, final_s, frozen_errors)
  if Array::length(frozen_errors) > 0 {
    throw(Array::get(frozen_errors, 0))
  }
  env
}

// Collecting variant of check_program for typed hover (vibe type-at): runs the
// same inference but RETURNS the recorded (offset, Type) table plus the FINAL
// substitution (check_stmts' 2nd value), instead of the TypeEnv. It degrades
// gracefully: any type error is swallowed and whatever table was collected so
// far is returned, so hovering inside a partially-bad file still resolves the
// names that were checked before the error. The table holds RAW (pre-final
// subst) types; callers resolve via subst_apply(finalSubst, ty).
export let check_program_type_table: (Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } = (stmts) -> {
  let empty_defs = Array::slice([
    TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
  ], 0, 0)
  let seeded_raw_env = if trait_defined(EnvEmpty, "Eq") {
    EnvEmpty
  } else {
    register_builtin_traits(EnvEmpty)
  }
  let seeded_env = env_cache(seeded_raw_env)
  let errors = ArrayBuilder::new()
  let frozen_errors = ArrayBuilder::freeze(errors)
  let tytab = Array::slice([
    (0, CtUnit)
  ], 0, 0)
  handle {
    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
    (tytab, final_s)
  } with Error {
    Throw(_) => (tytab, SubstEmpty)
  }
}

export let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {
  match initial_env {
    EnvEmpty => check_program(stmts),
    _ => {
      let empty_defs = Array::slice([
        TDAlias("_dummy", Array::slice([
      ""
    ], 0, 0), CtUnit)
      ], 0, 0)
      let cached_env = env_cache(initial_env)
      let seeded_raw_env = if trait_defined(cached_env, "Eq") {
        cached_env
      } else {
        register_builtin_traits(cached_env)
      }
      let seeded_env = env_cache(seeded_raw_env)
      let errors = ArrayBuilder::new()
      let frozen_errors = ArrayBuilder::freeze(errors)
      let tytab = Array::slice([
        (0, CtUnit)
      ], 0, 0)
      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)
      if Array::length(frozen_errors) > 0 {
        throw(Array::get(frozen_errors, 0))
      }
      env
    }
  }
}
