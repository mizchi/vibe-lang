//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let net_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let net_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = net_no_params()
  Array::push(arr, a)
  arr
}

let net_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = net_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let net_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = net_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_http_close: (String) -> Option[Type] = (name) -> {
  if name == "Http::close" {
    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some("HttpServer")))
  }
  else None
}

let lookup_http_accept: (String) -> Option[Type] = (name) -> {
  if name == "Http::accept" {
    Some(CtFn(net_one_param(CtUnknown), CtUnknown, Some("HttpServer")))
  }
  else None
}

let lookup_http_listen: (String) -> Option[Type] = (name) -> {
  if name == "Http::listen" {
    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some("HttpServer")))
  }
  else None
}

let lookup_http_request: (String) -> Option[Type] = (name) -> {
  if name == "Http::request" {
    Some(CtFn(net_two_params(CtString, CtString), CtUnknown, Some("HttpClient")))
  }
  else None
}

let lookup_http_respond: (String) -> Option[Type] = (name) -> {
  if name == "Http::respond" {
    Some(CtFn(net_three_params(CtUnknown, CtInt, CtString), CtUnit, Some("HttpServer")))
  }
  else None
}

let lookup_socket_tcp_read: (String) -> Option[Type] = (name) -> {
  if name == "Socket::tcp_read" {
    Some(CtFn(net_two_params(CtUnknown, CtInt), CtString, Some("TcpSocket")))
  }
  else None
}

let lookup_socket_tcp_close: (String) -> Option[Type] = (name) -> {
  if name == "Socket::tcp_close" {
    Some(CtFn(net_one_param(CtUnknown), CtUnit, Some("TcpSocket")))
  }
  else None
}

let lookup_socket_tcp_write: (String) -> Option[Type] = (name) -> {
  if name == "Socket::tcp_write" {
    Some(CtFn(net_two_params(CtUnknown, CtString), CtInt, Some("TcpSocket")))
  }
  else None
}

let lookup_http_response_body: (String) -> Option[Type] = (name) -> {
  if name == "Http::response_body" {
    Some(CtFn(net_one_param(CtUnknown), CtString, Some("HttpClient")))
  }
  else None
}

let lookup_socket_tcp_connect: (String) -> Option[Type] = (name) -> {
  if name == "Socket::tcp_connect" {
    Some(CtFn(net_two_params(CtString, CtInt), CtUnknown, Some("TcpSocket")))
  }
  else None
}

let lookup_net_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_socket_tcp_connect(name) {
    Some(t) => Some(t),
    None => match lookup_socket_tcp_read(name) {
      Some(t) => Some(t),
      None => match lookup_socket_tcp_write(name) {
        Some(t) => Some(t),
        None => lookup_socket_tcp_close(name)
      }
    }
  }
}

let lookup_http_request_header: (String) -> Option[Type] = (name) -> {
  if name == "Http::request_header" {
    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some("HttpIncoming")))
  }
  else None
}

let lookup_net_group_d: (String) -> Option[Type] = (name) -> {
  match lookup_http_request_header(name) {
    Some(t) => Some(t),
    None => lookup_http_respond(name)
  }
}

let lookup_http_request_method: (String) -> Option[Type] = (name) -> {
  if name == "Http::request_method" {
    Some(CtFn(net_one_param(CtUnknown), CtString, Some("HttpIncoming")))
  }
  else None
}

let lookup_net_group_c: (String) -> Option[Type] = (name) -> {
  match lookup_http_close(name) {
    Some(t) => Some(t),
    None => match lookup_http_listen(name) {
      Some(t) => Some(t),
      None => match lookup_http_accept(name) {
        Some(t) => Some(t),
        None => lookup_http_request_method(name)
      }
    }
  }
}

let lookup_http_response_header: (String) -> Option[Type] = (name) -> {
  if name == "Http::response_header" {
    Some(CtFn(net_two_params(CtUnknown, CtString), CtString, Some("HttpClient")))
  }
  else None
}

let lookup_http_response_status: (String) -> Option[Type] = (name) -> {
  if name == "Http::response_status" {
    Some(CtFn(net_one_param(CtUnknown), CtInt, Some("HttpClient")))
  }
  else None
}

let lookup_net_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_http_request(name) {
    Some(t) => Some(t),
    None => match lookup_http_response_status(name) {
      Some(t) => Some(t),
      None => match lookup_http_response_header(name) {
        Some(t) => Some(t),
        None => lookup_http_response_body(name)
      }
    }
  }
}

export let lookup_net: (String) -> Option[Type] = (name) -> {
  match lookup_net_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_net_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_net_group_c(name) {
        Some(t) => Some(t),
        None => lookup_net_group_d(name)
      }
    }
  }
}
