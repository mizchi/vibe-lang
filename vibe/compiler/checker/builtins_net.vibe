//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_socket_tcp_connect = (name: String) -> Option[Type] {
  if name == "Socket::tcp_connect" {
    Some(CtFn(two_params(CtString, CtInt), CtUnknown, Some("TcpSocket")))
  }
  else None
}

let lookup_socket_tcp_read = (name: String) -> Option[Type] {
  if name == "Socket::tcp_read" {
    Some(CtFn(two_params(CtUnknown, CtInt), CtString, Some("TcpSocket")))
  }
  else None
}

let lookup_socket_tcp_write = (name: String) -> Option[Type] {
  if name == "Socket::tcp_write" {
    Some(CtFn(two_params(CtUnknown, CtString), CtInt, Some("TcpSocket")))
  }
  else None
}

let lookup_socket_tcp_close = (name: String) -> Option[Type] {
  if name == "Socket::tcp_close" {
    Some(CtFn(one_param(CtUnknown), CtUnit, Some("TcpSocket")))
  }
  else None
}

let lookup_http_request = (name: String) -> Option[Type] {
  if name == "Http::request" {
    Some(CtFn(two_params(CtString, CtString), CtUnknown, Some("HttpClient")))
  }
  else None
}

let lookup_http_response_status = (name: String) -> Option[Type] {
  if name == "Http::response_status" {
    Some(CtFn(one_param(CtUnknown), CtInt, Some("HttpClient")))
  }
  else None
}

let lookup_http_response_header = (name: String) -> Option[Type] {
  if name == "Http::response_header" {
    Some(CtFn(two_params(CtUnknown, CtString), CtString, Some("HttpClient")))
  }
  else None
}

let lookup_http_response_body = (name: String) -> Option[Type] {
  if name == "Http::response_body" {
    Some(CtFn(one_param(CtUnknown), CtString, Some("HttpClient")))
  }
  else None
}

let lookup_http_close = (name: String) -> Option[Type] {
  if name == "Http::close" {
    Some(CtFn(one_param(CtUnknown), CtUnit, Some("HttpServer")))
  }
  else None
}

let lookup_http_listen = (name: String) -> Option[Type] {
  if name == "Http::listen" {
    Some(CtFn(two_params(CtString, CtInt), CtUnknown, Some("HttpServer")))
  }
  else None
}

let lookup_http_accept = (name: String) -> Option[Type] {
  if name == "Http::accept" {
    Some(CtFn(one_param(CtUnknown), CtUnknown, Some("HttpServer")))
  }
  else None
}

let lookup_http_request_method = (name: String) -> Option[Type] {
  if name == "Http::request_method" {
    Some(CtFn(one_param(CtUnknown), CtString, Some("HttpIncoming")))
  }
  else None
}

let lookup_http_request_header = (name: String) -> Option[Type] {
  if name == "Http::request_header" {
    Some(CtFn(two_params(CtUnknown, CtString), CtString, Some("HttpIncoming")))
  }
  else None
}

let lookup_http_respond = (name: String) -> Option[Type] {
  if name == "Http::respond" {
    Some(CtFn(three_params(CtUnknown, CtInt, CtString), CtUnit, Some("HttpServer")))
  }
  else None
}

let lookup_net_group_a = (name: String) -> Option[Type] {
  match lookup_socket_tcp_connect(name) {
    Some(t) => Some(t),
    None => match lookup_socket_tcp_read(name) {
      Some(t) => Some(t),
      None => match lookup_socket_tcp_write(name) {
        Some(t) => Some(t),
        None => lookup_socket_tcp_close(name)
      }
    }
  }
}

let lookup_net_group_b = (name: String) -> Option[Type] {
  match lookup_http_request(name) {
    Some(t) => Some(t),
    None => match lookup_http_response_status(name) {
      Some(t) => Some(t),
      None => match lookup_http_response_header(name) {
        Some(t) => Some(t),
        None => lookup_http_response_body(name)
      }
    }
  }
}

let lookup_net_group_c = (name: String) -> Option[Type] {
  match lookup_http_close(name) {
    Some(t) => Some(t),
    None => match lookup_http_listen(name) {
      Some(t) => Some(t),
      None => match lookup_http_accept(name) {
        Some(t) => Some(t),
        None => lookup_http_request_method(name)
      }
    }
  }
}

let lookup_net_group_d = (name: String) -> Option[Type] {
  match lookup_http_request_header(name) {
    Some(t) => Some(t),
    None => lookup_http_respond(name)
  }
}

export let lookup_net = (name: String) -> Option[Type] {
  match lookup_net_group_a(name) {
    Some(t) => Some(t),
    None => match lookup_net_group_b(name) {
      Some(t) => Some(t),
      None => match lookup_net_group_c(name) {
        Some(t) => Some(t),
        None => lookup_net_group_d(name)
      }
    }
  }
}
