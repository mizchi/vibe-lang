//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let array_no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let array_one_param: (Type) -> Array[Type] = (a) -> {
  let arr = array_no_params()
  Array::push(arr, a)
  arr
}

let array_two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let array_three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = array_no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_array_get: (String) -> Option[Type] = (name) -> {
  if name == "Array::get" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))
  }
  else None
}

let lookup_array_new: (String) -> Option[Type] = (name) -> {
  if name == "array_new" {
    Some(CtFn(array_no_params(), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_set: (String) -> Option[Type] = (name) -> {
  if name == "Array::set" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_array_push: (String) -> Option[Type] = (name) -> {
  if name == "Array::push" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_array_slice: (String) -> Option[Type] = (name) -> {
  if name == "Array::slice" {
    Some(CtFn(array_three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_concat: (String) -> Option[Type] = (name) -> {
  if name == "Array::concat" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_length: (String) -> Option[Type] = (name) -> {
  if name == "Array::length" {
    Some(CtFn(array_one_param(CtArray(CtUnknown)), CtInt, None))
  }
  else None
}

let lookup_array_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_array_new(name) {
    Some(t) => Some(t),
    None => match lookup_array_length(name) {
      Some(t) => Some(t),
      None => match lookup_array_get(name) {
        Some(t) => Some(t),
        None => lookup_array_set(name)
      }
    }
  }
}

let lookup_array_push_all: (String) -> Option[Type] = (name) -> {
  if name == "Array::push_all" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None))
  }
  else None
}

let lookup_array_truncate: (String) -> Option[Type] = (name) -> {
  if name == "Array::truncate" {
    Some(CtFn(array_two_params(CtArray(CtUnknown), CtInt), CtUnit, None))
  }
  else None
}

let lookup_array_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_array_push(name) {
    Some(t) => Some(t),
    None => match lookup_array_slice(name) {
      Some(t) => Some(t),
      None => match lookup_array_push_all(name) {
        Some(t) => Some(t),
        None => match lookup_array_truncate(name) {
          Some(t) => Some(t),
          None => lookup_array_concat(name)
        }
      }
    }
  }
}

export let lookup_array: (String) -> Option[Type] = (name) -> {
  match lookup_array_group_a(name) {
    Some(t) => Some(t),
    None => lookup_array_group_b(name)
  }
}
