//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_array_get = (name: String) -> Option[Type] {
  if name == "Array::get" {
    Some(CtFn(two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))
  }
  else None
}

let lookup_array_new = (name: String) -> Option[Type] {
  if name == "array_new" {
    Some(CtFn(no_params(), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_set = (name: String) -> Option[Type] {
  if name == "Array::set" {
    Some(CtFn(three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_array_push = (name: String) -> Option[Type] {
  if name == "Array::push" {
    Some(CtFn(two_params(CtArray(CtUnknown), CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_array_slice = (name: String) -> Option[Type] {
  if name == "Array::slice" {
    Some(CtFn(three_params(CtArray(CtUnknown), CtInt, CtInt), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_concat = (name: String) -> Option[Type] {
  if name == "Array::concat" {
    Some(CtFn(two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_array_length = (name: String) -> Option[Type] {
  if name == "Array::length" {
    Some(CtFn(one_param(CtArray(CtUnknown)), CtInt, None))
  }
  else None
}

let lookup_array_group_a = (name: String) -> Option[Type] {
  match lookup_array_new(name) {
    Some(t) => Some(t),
    None => match lookup_array_length(name) {
      Some(t) => Some(t),
      None => match lookup_array_get(name) {
        Some(t) => Some(t),
        None => lookup_array_set(name)
      }
    }
  }
}

let lookup_array_push_all = (name: String) -> Option[Type] {
  if name == "Array::push_all" {
    Some(CtFn(two_params(CtArray(CtUnknown), CtArray(CtUnknown)), CtUnit, None))
  }
  else None
}

let lookup_array_group_b = (name: String) -> Option[Type] {
  match lookup_array_push(name) {
    Some(t) => Some(t),
    None => match lookup_array_slice(name) {
      Some(t) => Some(t),
      None => match lookup_array_push_all(name) {
        Some(t) => Some(t),
        None => lookup_array_concat(name)
      }
    }
  }
}

export let lookup_array = (name: String) -> Option[Type] {
  match lookup_array_group_a(name) {
    Some(t) => Some(t),
    None => lookup_array_group_b(name)
  }
}
