//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_string_concat = (name: String) -> Option[Type] {
  if name == "String::concat" {
    Some(CtFn(two_params(CtString, CtString), CtString, None))
  }
  else None
}

let lookup_string_equals = (name: String) -> Option[Type] {
  if name == "String::equals" {
    Some(CtFn(two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string_length = (name: String) -> Option[Type] {
  if name == "String::length" {
    Some(CtFn(one_param(CtString), CtInt, None))
  }
  else None
}

let lookup_string_char_at = (name: String) -> Option[Type] {
  if name == "string_char_at" {
    Some(CtFn(two_params(CtString, CtInt), CtString, None))
  }
  else None
}

let lookup_string_group_a = (name: String) -> Option[Type] {
  match lookup_string_concat(name) {
    Some(t) => Some(t),
    None => match lookup_string_length(name) {
      Some(t) => Some(t),
      None => lookup_string_equals(name)
    }
  }
}

let lookup_string_substring = (name: String) -> Option[Type] {
  if name == "String::substring" {
    Some(CtFn(three_params(CtString, CtInt, CtInt), CtString, None))
  }
  else None
}

let lookup_string_group_b = (name: String) -> Option[Type] {
  match lookup_string_substring(name) {
    Some(t) => Some(t),
    None => lookup_string_char_at(name)
  }
}

export let lookup_string1 = (name: String) -> Option[Type] {
  match lookup_string_group_a(name) {
    Some(t) => Some(t),
    None => lookup_string_group_b(name)
  }
}
