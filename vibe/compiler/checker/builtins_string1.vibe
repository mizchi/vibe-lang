//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params: () -> Array[Type] = () -> {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param: (Type) -> Array[Type] = (a) -> {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params: (Type, Type) -> Array[Type] = (a, b) -> {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let three_params: (Type, Type, Type) -> Array[Type] = (a, b, c) -> {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_string_concat: (String) -> Option[Type] = (name) -> {
  if name == "String::concat" {
    Some(CtFn(two_params(CtString, CtString), CtString, None))
  }
  else None
}

let lookup_string_equals: (String) -> Option[Type] = (name) -> {
  if name == "String::equals" {
    Some(CtFn(two_params(CtString, CtString), CtBool, None))
  }
  else None
}

let lookup_string_length: (String) -> Option[Type] = (name) -> {
  if name == "String::length" {
    Some(CtFn(one_param(CtString), CtInt, None))
  }
  else None
}

let lookup_string_char_at: (String) -> Option[Type] = (name) -> {
  if name == "string_char_at" {
    Some(CtFn(two_params(CtString, CtInt), CtString, None))
  }
  else None
}

let lookup_string_group_a: (String) -> Option[Type] = (name) -> {
  match lookup_string_concat(name) {
    Some(t) => Some(t),
    None => match lookup_string_length(name) {
      Some(t) => Some(t),
      None => lookup_string_equals(name)
    }
  }
}

let lookup_string_substring: (String) -> Option[Type] = (name) -> {
  if name == "String::substring" {
    Some(CtFn(three_params(CtString, CtInt, CtInt), CtString, None))
  }
  else None
}

let lookup_string_group_b: (String) -> Option[Type] = (name) -> {
  match lookup_string_substring(name) {
    Some(t) => Some(t),
    None => lookup_string_char_at(name)
  }
}

export let lookup_string1: (String) -> Option[Type] = (name) -> {
  match lookup_string_group_a(name) {
    Some(t) => Some(t),
    None => lookup_string_group_b(name)
  }
}
