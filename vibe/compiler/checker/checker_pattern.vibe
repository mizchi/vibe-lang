//# Imports

import .. / core {
  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef
}

import ./checker_resolve.vibe {
  subst_type_params
}

//# Functions

let find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {
  let dlen = Array::length(defs)
  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {
    if di >= dlen {
      None
    } else {
      let d = Array::get(defs, di)
      match d {
        TDEnum(enum_name, _, variants) => {
          let vlen = Array::length(variants)
          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {
            if vi >= vlen {
              go_defs(di + 1)
            } else {
              let (vname, vtypes) = Array::get(variants, vi)
              if vname == ctor_name {
                Some((enum_name, vtypes))
              } else {
                go_variants(vi + 1)
              }
            }
          }
          go_variants(0)
        },
        _ => go_defs(di + 1)
      }
    }
  }
  go_defs(0)
}

export let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {
  match pat {
    PWild => env,
    PBind(name) => env_bind(env, name, scrutinee_ty),
    PInt(_) => env,
    PString(_) => env,
    PBool(_) => env,
    PCtor(name, sub_pats) => {
      let builtin_payload = match scrutinee_ty {
        CtOption(elem) => if name == "Some" {
          Some([
            elem
          ])
        } else if name == "None" {
          Some(Array::slice([
            CtUnknown
          ], 0, 0))
        } else {
          None
        },
        _ => None
      }
      let ctor_payload = match builtin_payload {
        Some(types) => Some(("Option", types)),
        None => find_ctor_in_defs(defs, name)
      }
      match ctor_payload {
        Some(info) => {
          let (enum_name, raw_payload) = info
          // Instantiate the variant's field types for a parameterized enum:
          // substitute the enum's formal params with the scrutinee's actual type
          // args (e.g. matching `Ok(inner)` on `Result[Result[T,E], E]` types
          // `inner` as `Result[T,E]`, not the bare enum param).
          let payload_types = match scrutinee_ty {
            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {
              Some(td) => match td {
                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {
                  for pt in raw_payload {
                    subst_type_params(pt, eparams, sargs)
                  }
                } else {
                  raw_payload
                },
                _ => raw_payload
              },
              None => raw_payload
            },
            _ => raw_payload
          }
          let splen = Array::length(sub_pats)
          let ptlen = Array::length(payload_types)
          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let sub_ty = if i < ptlen {
                Array::get(payload_types, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)
              bind_subs(i + 1, next_env)
            }
          }
          bind_subs(0, env)
        },
        None => {
          let splen = Array::length(sub_pats)
          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= splen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)
              bind_unknown(i + 1, next_env)
            }
          }
          bind_unknown(0, env)
        }
      }
    },
    PTuple(pats) => {
      let plen = Array::length(pats)
      match scrutinee_ty {
        CtTuple(elem_tys) => {
          let elen = Array::length(elem_tys)
          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let et = if i < elen {
                Array::get(elem_tys, i)
              } else {
                CtUnknown
              }
              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)
              bind_tuple(i + 1, next_env)
            }
          }
          bind_tuple(0, env)
        },
        _ => {
          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
            if i >= plen {
              acc_env
            } else {
              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)
              bind_unk(i + 1, next_env)
            }
          }
          bind_unk(0, env)
        }
      }
    },
    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs),
    PStruct(_, fields) => {
      let flen = Array::length(fields)
      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {
        if i >= flen {
          acc_env
        } else {
          let (_, fpat) = Array::get(fields, i)
          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs)
          bind_fields(i + 1, next_env)
        }
      }
      bind_fields(0, env)
    }
  }
}
