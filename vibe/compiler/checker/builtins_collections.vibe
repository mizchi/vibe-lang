//# Imports

import ../core/types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

export let lookup_array = (name: String) -> Option[Type] {
  if name == "array_new" {
    Some(CtFn(no_params(), CtArray(CtUnknown), false))
  }
  else if name == "Array::length" {
    Some(CtFn([
      CtArray(CtUnknown)
    ], CtInt, false))
  }
  else if name == "Array::get" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt
    ], CtUnknown, false))
  }
  else if name == "Array::set" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtUnknown
    ], CtUnit, false))
  }
  else if name == "Array::push" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtUnknown
    ], CtUnit, false))
  }
  else if name == "Array::slice" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtInt
    ], CtArray(CtUnknown), false))
  }
  else if name == "Array::push_all" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtArray(CtUnknown)
    ], CtUnit, false))
  }
  else if name == "Array::concat" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtArray(CtUnknown)
    ], CtArray(CtUnknown), false))
  }
  else None
}

export let lookup_fixed_array = (name: String) -> Option[Type] {
  if name == "FixedArray::make" {
    Some(CtFn([
      CtInt,
      CtUnknown
    ], CtArray(CtUnknown), false))
  }
  else if name == "FixedArray::length" {
    Some(CtFn([
      CtArray(CtUnknown)
    ], CtInt, false))
  }
  else if name == "FixedArray::get" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt
    ], CtUnknown, false))
  }
  else if name == "FixedArray::set" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtUnknown
    ], CtUnit, false))
  }
  else if name == "FixedArray::unsafe_set" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtUnknown
    ], CtUnit, false))
  }
  else if name == "FixedArray::blit" {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtArray(CtUnknown),
      CtInt,
      CtInt
    ], CtUnit, false))
  }
  else None
}

export let lookup_bytes = (name: String) -> Option[Type] {
  if name == "Bytes::new" {
    Some(CtFn(no_params(), CtBytes, false))
  }
  else if name == "Bytes::length" {
    Some(CtFn([
      CtBytes
    ], CtInt, false))
  }
  else if name == "Bytes::get" {
    Some(CtFn([
      CtBytes,
      CtInt
    ], CtInt, false))
  }
  else if name == "Bytes::set" {
    Some(CtFn([
      CtBytes,
      CtInt,
      CtInt
    ], CtUnit, false))
  }
  else if name == "Bytes::push" {
    Some(CtFn([
      CtBytes,
      CtInt
    ], CtUnit, false))
  }
  else if name == "Bytes::concat" {
    Some(CtFn([
      CtBytes,
      CtBytes
    ], CtBytes, false))
  }
  else if name == "Bytes::slice" {
    Some(CtFn([
      CtBytes,
      CtInt,
      CtInt
    ], CtBytes, false))
  }
  else if name == "Bytes::append" {
    Some(CtFn([
      CtBytes,
      CtBytes
    ], CtUnit, false))
  }
  else if name == "Bytes::blit" {
    Some(CtFn([
      CtBytes,
      CtBytes,
      CtInt,
      CtInt
    ], CtUnit, false))
  }
  else if name == "Bytes::fill" {
    Some(CtFn([
      CtBytes,
      CtInt,
      CtInt
    ], CtUnit, false))
  }
  else if name == "Bytes::from_array" {
    Some(CtFn([
      CtArray(CtInt)
    ], CtBytes, false))
  }
  else if name == "Bytes::to_array" {
    Some(CtFn([
      CtBytes
    ], CtArray(CtInt), false))
  }
  else None
}

export let lookup_string1 = (name: String) -> Option[Type] {
  if name == "String::concat" {
    Some(CtFn([
      CtString,
      CtString
    ], CtString, false))
  }
  else if name == "String::length" {
    Some(CtFn([
      CtString
    ], CtInt, false))
  }
  else if name == "String::equals" {
    Some(CtFn([
      CtString,
      CtString
    ], CtBool, false))
  }
  else if name == "String::substring" {
    Some(CtFn([
      CtString,
      CtInt,
      CtInt
    ], CtString, false))
  }
  else if name == "string_char_at" {
    Some(CtFn([
      CtString,
      CtInt
    ], CtString, false))
  }
  else None
}

