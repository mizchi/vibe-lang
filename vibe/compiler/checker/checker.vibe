//# Functions

let min_int: (Int, Int) -> Int = (a, b) -> {
  if a < b {
    a
  } else {
    b
  }
}

// Encode a real AST char offset into a strippable diagnostic marker so the
// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode
// the exact line:col instead of falling back to a first-occurrence text scan.
// String::concat only (never `+` / interpolation — both mis-codegen to NUL in
// selfhost). off < 0 => no marker (heuristic fallback retained).
let off_marker: (Int) -> String = (off) -> {
  if off >= 0 {
    String::concat(" [@off=", String::concat(__to_string(off), "]"))
  } else {
    ""
  }
}

// Like off_marker but also encodes the offending token's END offset as
// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an
// EXACT source range (line:colC-E) instead of the LSP guessing the token end
// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan
// stops at the dot). Falls back to the start-only marker when len <= 0. Use this
// where `off` is the START of a known-length named token (the symbol whose
// length matches the source span); keep plain off_marker where the offset is an
// anchor rather than the token start (e.g. a field error whose offset is the
// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).
let off_marker_len: (Int, Int) -> String = (off, len) -> {
  if off >= 0 && len > 0 {
    String::concat(" [@off=", String::concat(__to_string(off), String::concat(":", String::concat(__to_string(off + len), "]"))))
  } else {
    off_marker(off)
  }
}

let prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {
  let out = Array::slice([
    EUnit
  ], 0, 0)
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

// Replace the abstract `Self` type (resolved as `CtNamed("Self", _)`) inside a
// trait-method signature with the concrete receiver type, when typing a
// `T::method` call against a bounded generic parameter T.
let rec subst_self_in_type: (Type, Type) -> Type = (ty, self_ty) -> {
  match ty {
    CtNamed(n, args) => if n == "Self" {
      self_ty
    } else {
      let ra = for a in args {
        subst_self_in_type(a, self_ty)
      }
      CtNamed(n, ra)
    },
    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),
    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),
    CtTuple(elems) => CtTuple(for e in elems {
      subst_self_in_type(e, self_ty)
    }),
    CtFn(ps, ret, eff) => CtFn(for p in ps {
      subst_self_in_type(p, self_ty)
    }, subst_self_in_type(ret, self_ty), eff),
    _ => ty
  }
}

// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->
// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that
// resolves to a real type (primitive or declared) is kept; only truly-unknown
// named types — the trait's own element type params, which the uniform
// representation erases — are relaxed. (#636.)
let rec relax_unknown_named: (Type, Array[TypeDef]) -> Type = (ty, defs) -> {
  match ty {
    CtNamed(n, args) => {
      let known = match find_typedef(defs, n) {
        Some(_) => true,
        None => match resolve_builtin(n) {
          Some(_) => true,
          None => false
        }
      }
      if known {
        CtNamed(n, for a in args {
          relax_unknown_named(a, defs)
        })
      } else {
        CtUnknown
      }
    },
    CtArray(e) => CtArray(relax_unknown_named(e, defs)),
    CtOption(e) => CtOption(relax_unknown_named(e, defs)),
    CtTuple(es) => CtTuple(for e in es {
      relax_unknown_named(e, defs)
    }),
    CtFn(ps, r, eff) => CtFn(for p in ps {
      relax_unknown_named(p, defs)
    }, relax_unknown_named(r, defs), eff),
    _ => ty
  }
}

// Resolve a qualified identifier `T::method` where `T` is a bounded generic
// type parameter (`[T: Trait]`). If the head resolves to a type variable whose
// recorded bounds include a trait declaring `method`, return that method's
// signature with `Self` substituted by T. Returns None for any other qualified
// name (concrete `Type::method`, module-qualified names, etc.) so the existing
// resolution paths are untouched. (PR-3 component 2.)
let resolve_trait_method_ident: (String, TypeEnv, Array[TypeDef], Subst) -> Option[Type] = (name, env, defs, s) -> {
  let idx = String::index_of(name, "::")
  if idx < 0 {
    None
  } else {
    let head = String::substring(name, 0, idx)
    let method = String::substring(name, idx + 2, String::length(name))
    match env_lookup(env, head) {
      Some(head_ty) => match head_ty {
        CtVar(vid) => {
          let bounds = subst_bounds_for(s, vid)
          let self_ty = CtVar(vid)
          let mut result = None
          let mut bi = 0
          while bi < Array::length(bounds) {
            let pending = match result {
              None => true,
              _ => false
            }
            if pending {
              let trait_name = Array::get(bounds, bi)
              match trait_method_sig_deep(env, trait_name, method) {
                Some(sig) => {
                  let (params_te, ret_te) = sig
                  let resolved_params = for pte in params_te {
                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)
                  }
                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)
                  result = Some(CtFn(resolved_params, resolved_ret, None))
                },
                None => ()
              }
            } else {
              ()
            }
            bi = bi + 1
          }
          result
        },
        _ => None
      },
      None => None
    }
  }
}

let expr_ident_name_or_empty: (Expr) -> String = (expr) -> {
  match expr {
    EIdent(name, _) => name,
    _ => ""
  }
}

// Erase every effect annotation in a type (recursively), so an argument can be
// checked for STRUCTURAL compatibility independent of effects. Effects on
// function VALUES are inferred imprecisely (a `with { Error }` callback often
// arrives typed with no effect), so an effect-only difference must not be
// reported as a type error — only the structural shape is enforced here.
let rec strip_effects: (Type) -> Type = (ty) -> {
  match ty {
    CtFn(params, ret, _) => {
      let out = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut i = 0
      while i < Array::length(params) {
        Array::push(out, strip_effects(Array::get(params, i)))
        i = i + 1
      }
      CtFn(out, strip_effects(ret), None)
    },
    CtArray(elem) => CtArray(strip_effects(elem)),
    CtOption(elem) => CtOption(strip_effects(elem)),
    CtTuple(elems) => {
      let out = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut i = 0
      while i < Array::length(elems) {
        Array::push(out, strip_effects(Array::get(elems, i)))
        i = i + 1
      }
      CtTuple(out)
    },
    CtNamed(name, args) => {
      let out = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, strip_effects(Array::get(args, i)))
        i = i + 1
      }
      CtNamed(name, out)
    },
    _ => ty
  }
}

// True when a type is fully ground (mentions no type parameter / type
// variable). An unresolved type name resolves to `CtNamed(_, _)` (see
// resolve_type_expr), which for a struct field or function parameter means a
// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used
// both to restrict record struct-identity recovery to MONOMORPHIC structs (a
// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`
// relies on) and to gate structural-mismatch reporting to concrete types.
let rec type_is_ground: (Type) -> Bool = (t) -> {
  match t {
    CtNamed(_, _) => false,
    CtVar(_) => false,
    CtForAll(_, _, _) => false,
    CtTuple(items) => {
      let mut ok = true
      let mut i = 0
      while i < Array::length(items) {
        if !type_is_ground(Array::get(items, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    CtArray(e) => type_is_ground(e),
    CtOption(e) => type_is_ground(e),
    CtFn(ps, r, _) => {
      let mut ok = type_is_ground(r)
      let mut i = 0
      while i < Array::length(ps) {
        if !type_is_ground(Array::get(ps, i)) {
          ok = false
        }
        i = i + 1
      }
      ok
    },
    _ => true
  }
}

// True when every declared field type of a struct is ground (the struct is not
// generic). `S::{ ... }` for such a struct can safely be typed `CtStruct(S)`.
let struct_fields_ground: (Array[(String, Type)]) -> Bool = (dfields) -> {
  let mut ok = true
  let mut i = 0
  while i < Array::length(dfields) {
    let (_, ft) = Array::get(dfields, i)
    if !type_is_ground(ft) {
      ok = false
    }
    i = i + 1
  }
  ok
}

// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch
// (the checker historically swallowed these, accepting ill-typed programs).
// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with
// effects erased, and tolerate the difference if the structure matches — effect
// inference on function values is imprecise, so effect-only differences must not
// be reported here. Returns the (possibly extended) substitution.
export let check_assignable: (Type, Type, Subst, Array[String], String, Int) -> Subst = (expected, actual, s, errors, what, off) -> {
  match unify(expected, actual, s) {
    Some(su) => su,
    None => {
      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {
        Some(_) => true,
        None => false
      }
      // Only report when BOTH sides are fully ground (mention no type parameter
      // / type variable). The selfhost checker does not instantiate a generic
      // struct field's or function parameter's type params — they surface as
      // rigid `CtNamed(T, _)` — so a unify failure against a concrete
      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->
      // Option[(T, Int)]` field vs a concrete closure). Reporting only on
      // ground/ground keeps the genuine concrete-type mismatches (Int vs
      // String, struct field of the wrong concrete type) while not
      // over-rejecting polymorphic code.
      let both_ground = type_is_ground(subst_apply(s, expected)) && type_is_ground(subst_apply(s, actual))
      if structural || !both_ground {
        s
      } else {
        Array::push(errors, String::concat(what, String::concat(": expected ", String::concat(type_to_string(subst_apply(s, expected)), String::concat(", got ", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))
        s
      }
    }
  }
}

// Struct construction `S::{ ... }` drops the name `S` at parse time (becomes a
// bare ERecord), so the struct is resolved by matching the field-name SET. True
// when `declared` and `actual` have the same field names.
let struct_field_names_match: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (declared, actual) -> {
  if Array::length(declared) != Array::length(actual) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while i < Array::length(declared) {
      let (dn, _) = Array::get(declared, i)
      let mut found = false
      let mut j = 0
      while j < Array::length(actual) {
        let (an, _) = Array::get(actual, j)
        if an == dn {
          found = true
        }
        j = j + 1
      }
      if !found {
        ok = false
      }
      i = i + 1
    }
    ok
  }
}

let lookup_actual_field_ty: (Array[(String, Type)], String) -> Option[Type] = (actual, name) -> {
  let mut i = 0
  let mut out = None
  while i < Array::length(actual) {
    let (an, at) = Array::get(actual, i)
    if an == name {
      out = Some(at)
    }
    i = i + 1
  }
  out
}

// Check a record literal's field VALUES against the declared field types of the
// (uniquely) matching struct definition — previously unchecked, so
// `S::{ x: "oops" }` for `struct S { x: Int }` was accepted. Conservative: if 0
// or >1 structs share the field-name set, skip (no struct could be determined).
let check_record_fields: (Array[TypeDef], Array[(String, Type)], Subst, Array[String]) -> Subst = (defs, actual, s, errors) -> {
  let mut matchct = 0
  let mut matched_fields = Array::slice([
    ("", CtUnknown)
  ], 0, 0)
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(_, dfields, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        matched_fields = dfields
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 {
    let mut out = s
    let mut i = 0
    while i < Array::length(matched_fields) {
      let (fname, declared_ty) = Array::get(matched_fields, i)
      match lookup_actual_field_ty(actual, fname) {
        Some(actual_ty) => {
          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat("struct field type mismatch for ", fname), 0 - 1)
        },
        None => ()
      }
      i = i + 1
    }
    out
  } else {
    s
  }
}

// Resolve the (uniquely) matching struct name for a record literal's field-name
// set. Returns None when 0 or >1 structs share that field set (ambiguous), or
// when the matching struct is GENERIC (non-ground fields) — so a record's
// struct identity is only recovered for an unambiguous MONOMORPHIC struct. Used
// to give a bare `S::{ ... }` literal the type `CtStruct(S)` instead of
// CtUnknown, which in turn lets `mut`-field write checking see the struct
// without disturbing generic-struct inference.
let resolve_record_struct_name: (Array[TypeDef], Array[(String, Type)]) -> Option[String] = (defs, actual) -> {
  let mut matchct = 0
  let mut out = None
  let mut ground = false
  let mut di = 0
  while di < Array::length(defs) {
    match Array::get(defs, di) {
      TDStruct(sname, dfields, _) => if struct_field_names_match(dfields, actual) {
        matchct = matchct + 1
        out = Some(sname)
        ground = struct_fields_ground(dfields)
      },
      _ => ()
    }
    di = di + 1
  }
  if matchct == 1 && ground {
    out
  } else {
    None
  }
}

// Unify each argument against its parameter, REPORTING a type mismatch instead
// of silently swallowing it. `__to_string` (the polymorphic interpolation
// stringifier: `"\{x}"` -> `__to_string(x)` wraps values of any type, but the
// polyfill annotates it `(Int) -> String`) is exempt.
let unify_call_args: (Array[Type], Array[Type], Subst, Array[String], String, Int) -> Subst = (param_tys, arg_tys, s, errors, label, off) -> {
  let mut out = s
  let mut ui = 0
  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
  while ui < ul {
    let pty = Array::get(param_tys, ui)
    let aty = Array::get(arg_tys, ui)
    out = if label == "__to_string" {
      match unify(pty, aty, out) {
        Some(su) => su,
        None => out
      }
    } else {
      check_assignable(pty, aty, out, errors, String::concat("argument type mismatch for ", label), off)
    }
    ui = ui + 1
  }
  out
}

export let fn_return_env_name: (String) -> String = (name) -> {
  String::concat("__fn_ret__:", name)
}

let direct_builtin_return: (String) -> Option[Type] = (name) -> {
  if name == "Bytes::length" {
    Some(CtInt)
  }
  else if name == "iter_length" || name == "String::iter_length" || name == "Map::iter_length" {
    Some(CtInt)
  }
  else if name == "Array::length" {
    Some(CtInt)
  }
  else if name == "FixedArray::length" {
    Some(CtInt)
  }
  else if name == "String::length" {
    Some(CtInt)
  }
  else if name == "Bytes::get" || name == "String::index_of" || name == "String::char_code_at" || name == "String::last_index_of" || name == "Char::to_int" || name == "Double::to_int" || name == "Double::to_i64_bits" || name == "Double::to_i64_bits_lo" || name == "Double::to_i64_bits_hi" || name == "Env::args_len" || name == "Stdin::read_char" {
    Some(CtInt)
  }
  else if name == "String::equals" || name == "String::contains" || name == "String::starts_with" || name == "String::ends_with" || name == "Array::any" || name == "Array::all" || name == "Array::contains" || name == "Map::has_key" || name == "map_has" || name == "Path::is_absolute" || name == "Fs::exists" || name == "Fs::is_dir" || name == "Fs::is_file" || name == "eq" || name == "not" {
    Some(CtBool)
  }
  else if name == "String::concat" || name == "String::substring" || name == "String::trim" || name == "String::to_lower" || name == "String::to_upper" || name == "String::from_char_code" || name == "String::join" || name == "Array::join" || name == "Path::to_string" || name == "Path::resolve" || name == "PromptText::new" || name == "Stdin::read_stream" || name == "Env::get" || name == "Env::args_get" || name == "Fs::read_file" || name == "Fs::getcwd" || name == "sh" || name == "Lines::stringify" || name == "Llm::complete" || name == "Rlm::run" || name == "Rlm::finalize" || name == "__to_string" {
    Some(CtString)
  }
  else if name == "__len" {
    Some(CtInt)
  }
  else if name == "String::iter_get" {
    Some(CtInt)
  }
  else if name == "iter_get" || name == "Map::iter_get" || name == "iter_require" || name == "__neg" {
    Some(CtUnknown)
  }
  else if name == "Bytes::new" || name == "Bytes::concat" || name == "Bytes::slice" || name == "Bytes::from_array" || name == "Fs::read_bytes" {
    Some(CtBytes)
  }
  else if name == "Array::set" || name == "Array::push" || name == "Array::push_all" || name == "Array::truncate" || name == "Array::foreach" || name == "FixedArray::set" || name == "FixedArray::blit" || name == "FixedArray::unsafe_set" || name == "Bytes::set" || name == "Bytes::push" || name == "Bytes::append" || name == "Bytes::blit" || name == "Bytes::fill" || name == "MapBuilder::set" || name == "Stdout::write_char" || name == "Stdout::write_stream" || name == "sleep" || name == "Fs::copy" || name == "Fs::chdir" || name == "Fs::mkdir" || name == "Fs::append" || name == "Fs::remove" || name == "Fs::write_file" || name == "Fs::write_bytes" || name == "print" || name == "println" || name == "assert" || name == "assert_true" || name == "assert_eq" || name == "__set_field" {
    Some(CtUnit)
  }
  else if name == "Double::from_i64_bits" || name == "Int::to_double" {
    Some(CtDouble)
  }
  else if name == "Char::from_int" {
    Some(CtChar)
  }
  else if name == "Bytes::to_array" {
    Some(CtArray(CtInt))
  }
  else if name == "Map::keys" || name == "sh_lines" || name == "Lines::parse" {
    Some(CtArray(CtString))
  }
  else if name == "Array::slice" || name == "Array::concat" || name == "Array::filter" || name == "Array::reverse" || name == "Array::sort" || name == "FixedArray::make" {
    Some(CtArray(CtUnknown))
  }
  else if name == "Some" || name == "Array::find" {
    Some(CtOption(CtUnknown))
  }
  else {
    None
  }
}

let direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {
  match env_lookup(env, name) {
    Some(_) => None,
    None => direct_builtin_return(name)
  }
}

let is_logic_binop: (String) -> Bool = (op) -> {
  op == "&&"
  || op == "||"
}

let is_order_binop: (String) -> Bool = (op) -> {
  op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
}

let type_name_prefix: (Type) -> String = (ty) -> {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "Unit",
    CtBytes => "Bytes",
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, _) => name,
    _ => ""
  }
}

let is_equality_binop: (String) -> Bool = (op) -> {
  op == "=="
  || op == "!="
}

let unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {
  match unify(left_ty, target_ty, s) {
    Some(s1) => unify(right_ty, target_ty, s1),
    None => None
  }
}

let unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {
  match unify(left_ty, right_ty, s) {
    Some(s1) => Some((subst_apply(s1, left_ty), s1)),
    None => None
  }
}

let infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {
  match unify_same_binop_operands(left_ty, right_ty, s) {
    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {
      Some((resolved, s1))
    } else {
      None
    },
    None => None
  }
}

let infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String], Array[(Int, Type)]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors, tytab) -> {
  if is_logic_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Bool")))
        (CtUnknown, s)
      }
    }
  }
  else if is_equality_binop(op) {
    match unify(left_ty, right_ty, s) {
      Some(s1) => (CtBool, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must have same type")))
        (CtUnknown, s)
      }
    }
  }
  else if is_order_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtBool, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtBool, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, "Ord", s) {
          Some((_, s1)) => (CtBool, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "+" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {
          Some(s1) => (CtString, s1),
          None => match infer_named_trait_binop(env, left_ty, right_ty, "Add", s) {
            Some((resolved, s1)) => (resolved, s1),
            None => {
              Array::push(errors, "type mismatch in '+': operands must be Int, Double, or String")
              (CtUnknown, s)
            }
          }
        }
      }
    }
  }
  else if op == "-"
  || op == "*"
  || op == "/" {
    let trait_name = if op == "-" {
      "Sub"
    } else if op == "*" {
      "Mul"
    } else {
      "Div"
    }
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {
          Some((resolved, s1)) => (resolved, s1),
          None => {
            Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int or Double")))
            (CtUnknown, s)
          }
        }
      }
    }
  }
  else if op == "%" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, "type mismatch in '%': operands must be Int")
        (CtUnknown, s)
      }
    }
  }
  else if op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => {
        Array::push(errors, String::concat("type mismatch in '", String::concat(op, "': operands must be Int")))
        (CtUnknown, s)
      }
    }
  }
  else {
    Array::push(errors, String::concat("unknown operator: ", op))
    (CtUnknown, s)
  }
}

// Recursively replace type-parameter names (those bound to a CtVar in `env`)
// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type
// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and
// their args recursed. This lets a generic annotation like `Map[String, V]`
// resolve its inner `V` to the function's quantified var, so call sites can
// instantiate it (the previous shallow lookup only handled the outermost name).
let rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {
  match ty {
    CtNamed(name, args) => {
      let ra = for a in args {
        resolve_tparams_in(a, env)
      }
      match env_lookup(env, name) {
        Some(t) => match t {
          CtVar(_) => t,
          _ => CtNamed(name, ra)
        },
        None => CtNamed(name, ra)
      }
    },
    CtArray(e) => CtArray(resolve_tparams_in(e, env)),
    CtOption(e) => CtOption(resolve_tparams_in(e, env)),
    CtTuple(es) => CtTuple(for e in es {
      resolve_tparams_in(e, env)
    }),
    CtFn(ps, ret, eff) => {
      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {
        let out = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut i = 0
        while i < Array::length(types) {
          Array::push(out, resolve_tparams_in(Array::get(types, i), env))
          i = i + 1
        }
        out
      }
      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)
    },
    _ => ty
  }
}

// Record a call-site node's (raw, pre-final-subst) result type `ty` keyed by
// its real source char offset `call_off`, for typed-hover (vibe type-at) on
// `foo(x)` / `obj.method(x)`, then return `ty` unchanged so it can be dropped
// into the call-result tuple in place. Synthetic calls (call_off < 0) skip the
// push. Used at the ECall result sites (NOT by wrapping the giant ECall match,
// which the bootstrap seed parser cannot reparse when that match is nested one
// level deeper — only the interior result types are tagged).
let tab_call_ty: (Array[(Int, Type)], Int, Type) -> Type = (tytab, call_off, ty) -> {
  if call_off >= 0 {
    Array::push(tytab, (call_off, ty))
  } else {
    ()
  }
  ty
}

// Iteratively check a sequence/let SPINE (`ESeq` and `ELet`/`ELetMut`/`ELetRec`
// chains) instead of recursing into each `body`, so a long function body — a
// deep right-nested `let` chain — does not exhaust the wasm call stack during
// self-compile. `ce` is `check_expr` itself (threaded as a value to avoid a
// forward reference). Semantics are identical to the recursive arms: each `let`
// binds its (generalized, or raw for `mut`) value type into the env seen by the
// rest of the spine, and the final non-spine expression's result is returned.
let check_seq_spine: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab, ce) -> {
  let mut cur = expr
  let mut cenv = env
  let mut s1 = s
  let mut c1 = c
  let mut done = false
  let mut result = (CtUnit, s, c)
  while !done {
    match cur {
      ESeq(left, right) => {
        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        cur = right
      },
      ELet(name, val, body) => {
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)
        let gen = generalize(ns, vt)
        cenv = env_bind(cenv, name, gen)
        s1 = ns
        c1 = nc
        cur = body
      },
      ELetMut(name, val, body) => {
        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)
        cenv = env_bind(cenv, name, vt)
        s1 = ns
        c1 = nc
        cur = body
      },
      ELetRec(name, val, body) => {
        let (tv, c1b) = fresh_var(c1)
        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)
        let s2 = match unify(tv, vt, ns) {
          Some(su) => su,
          None => ns
        }
        let gen = generalize(s2, tv)
        cenv = env_bind(cenv, name, gen)
        s1 = s2
        c1 = nc
        cur = body
      },
      _ => {
        result = ce(cur, cenv, defs, s1, c1, errors, tytab)
        done = true
      }
    }
  }
  result
}

// #418: enforce that `obj.field = x` (which desugars to
// `__set_field(obj, "field", x)`) only targets a `mut`-declared struct field.
// Runs as a pure side-effect over a *throwaway* errors/tytab so it never
// perturbs the main type/subst flow — it only type-checks `obj` to learn its
// struct name, looks up that struct's `mut` field set, and pushes a single
// diagnostic to the real `errors` when the written field is not `mut`.
let field_write_mut_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, tytab, ce) -> {
  if name == "__set_field" && Array::length(args) == 3 {
    match Array::get(args, 1) {
      EString(field) => {
        let throwaway = Array::slice([""], 0, 0)
        let throwtab = Array::slice([(0, CtUnit)], 0, 0)
        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)
        match subst_apply(s, obj_ty) {
          CtStruct(sname) => match find_typedef(defs, sname) {
            Some(TDStruct(_, _, mut_names)) => {
              let mut found = false
              let mut i = 0
              while i < Array::length(mut_names) {
                if Array::get(mut_names, i) == field {
                  found = true
                } else {
                  ()
                }
                i = i + 1
              }
              if found {
                ()
              } else {
                Array::push(errors, String::concat("cannot assign to non-`mut` field `", String::concat(field, String::concat("` of struct ", sname))))
              }
            },
            _ => ()
          },
          _ => ()
        }
      },
      _ => ()
    }
  } else {
    ()
  }
}

export let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab) -> {
  match expr {
    EInt(_) => (CtInt, s, c),
    EFloat(_) => (CtDouble, s, c),
    EString(_) => (CtString, s, c),
    EBool(_) => (CtBool, s, c),
    EUnit => (CtUnit, s, c),
    EIdent(name, ident_off) => match env_lookup(env, name) {
      Some(t) => {
        let (ti, c1, new_bounds) = instantiate(t, c)
        let nblen = Array::length(new_bounds)
        let mut s1 = s
        let mut bi = 0
        while bi < nblen {
          let (vid, bounds) = Array::get(new_bounds, bi)
          if Array::length(bounds) != 0 {
            s1 = subst_add_bound(s1, vid, bounds)
          }
          bi = bi + 1
        }
        // Record this user identifier's inferred (raw, pre-final-subst) type
        // keyed by its real source offset, for typed-hover (vibe type-at) on
        // locals and parameters. Synthetic idents (off < 0) are skipped.
        if ident_off >= 0 {
          Array::push(tytab, (ident_off, ti))
        } else {
          ()
        }
        (ti, s1, c1)
      },
      None => match lookup_builtin(name) {
        Some(t) => {
          if ident_off >= 0 {
            Array::push(tytab, (ident_off, t))
          } else {
            ()
          }
          (t, s, c)
        },
        None => match resolve_trait_method_ident(name, env, defs, s) {
          Some(mty) => {
            if ident_off >= 0 {
              Array::push(tytab, (ident_off, mty))
            } else {
              ()
            }
            (mty, s, c)
          },
          None => {
            Array::push(errors, String::concat(String::concat("unknown name: ", name), off_marker_len(ident_off, String::length(name))))
            (CtUnknown, s, c)
          }
        }
      }
    },
    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELet(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    ELetMut(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),
    EIf(cond, then_e, else_e) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "if condition must be Bool")
      }
      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)
      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)
      // The two branches must agree when both yield a real value (previously
      // unchecked — `if c { 1 } else { "x" }` was accepted). A `CtUnit` branch
      // is tolerated: `if c { stmt }` desugars to an `else ()` whose value is
      // discarded, and a statement-position `if` need not have matching arms.
      let rtt = subst_apply(s3, tt)
      let ret = subst_apply(s3, et)
      let s3b = match rtt {
        CtUnit => s3,
        _ => match ret {
          CtUnit => s3,
          _ => check_assignable(rtt, ret, s3, errors, "if branches have incompatible types", 0 - 1)
        }
      }
      (tt, s3b, c3)
    },
    ECall(callee, args, call_off) => match callee {
      // `perform EffName::Op(opargs)` parses as ECall(EIdent("perform"),
      // [ECall(EIdent("EffName::Op"), opargs)]). The op name may be a builtin
      // effect (Stdin/Stdout/...) not registered in the checker env, so check
      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.
      // `resume(v)` likewise yields the continuation result (a fresh var;
      // handler arms are otherwise unchecked).
      EIdent(name, callee_off) => {
        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)
        if name == "perform" {
        if Array::length(args) == 1 {
          match Array::get(args, 0) {
            ECall(_, opargs, _) => {
              let oalen = Array::length(opargs)
              let mut s1 = s
              let mut c1 = c
              let mut ai = 0
              while ai < oalen {
                let (_, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)
                s1 = ns
                c1 = nc
                ai = ai + 1
              }
              let (tv, c2) = fresh_var(c1)
              (tv, s1, c2)
            },
            EIdent(_, _) => {
              let (tv, c2) = fresh_var(c)
              (tv, s, c2)
            },
            other => check_expr(other, env, defs, s, c, errors, tytab)
          }
        } else {
          (CtUnknown, s, c)
        }
      } else if name == "resume" {
        let alen = Array::length(args)
        let mut s1 = s
        let mut c1 = c
        let mut ai = 0
        while ai < alen {
          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)
          s1 = ns
          c1 = nc
          ai = ai + 1
        }
        let (tv, c2) = fresh_var(c1)
        (tv, s1, c2)
      } else if name == "Some" {
        if Array::length(args) == 1 {
          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)
          (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)
        } else {
          (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)
        }
      } else {
        match direct_call_return(env, name) {
          Some(ret_ty) => {
            let alen = Array::length(args)
            let mut ai = 0
            let mut s2 = s
            let mut c2 = c
            while ai < alen {
              let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)
          },
          None => {
            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)
            let alen = Array::length(args)
            let arg_tys = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            let mut s2 = s1
            let mut c2 = c1
            while ai < alen {
              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
              Array::push(arg_tys, at)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(name, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)
                let call_ret = Array::get(ret_box, 0)
                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
              },
              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
            }
          }
        }
        }
      },
      EDot(obj, method, _) => {
        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)
        let resolved = subst_apply(s1, obj_ty)
        let type_prefix = type_name_prefix(resolved)
        let qualified = String::concat(type_prefix, String::concat("::", method))
        let direct_ret = direct_call_return(env, qualified)
        let method_ty = match env_lookup(env, qualified) {
          Some(t) => {
            let (ti, c2, _) = instantiate(t, c1)
            (ti, s1, c2)
          },
          None => match lookup_builtin(qualified) {
            Some(t) => (t, s1, c1),
            None => (CtUnknown, s1, c1)
          }
        }
        let (mt, s2, c2) = method_ty
        let all_args = prepend_expr(obj, args)
        let alen = Array::length(all_args)
        let arg_tys = Array::slice([
          CtUnknown
        ], 0, 0)
        Array::push(arg_tys, obj_ty)
        let mut ai = 1
        let mut s3 = s2
        let mut c3 = c2
        while ai < alen {
          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)
          Array::push(arg_tys, at)
          s3 = ns
          c3 = nc
          ai = ai + 1
        }
        let applied_method_ty = match mt {
          CtFn(_, _, _) => mt,
          _ => subst_apply(s3, mt)
        }
        match applied_method_ty {
          CtFn(param_tys, ret, _) => {
            let ret_box = Array::slice([
              ret
            ], 0, 1)
            let call_param_tys = param_tys
            let plen = Array::length(param_tys)
            let alen2 = Array::length(arg_tys)
            if alen2 != plen {
              Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(qualified, String::concat(": expected ", String::concat(__to_string(plen), String::concat(" args, got ", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))
            }
            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)
            let call_ret = Array::get(ret_box, 0)
            let selected_ret = match direct_ret {
              Some(t) => t,
              None => call_ret
            }
            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)
          },
          _ => match direct_ret {
            Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),
            None => (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)
          }
        }
      },
      _ => {
        let callee_name0 = expr_ident_name_or_empty(callee)
        if callee_name0 != "" {
          match direct_call_return(env, callee_name0) {
            Some(ret_ty) => {
              let alen = Array::length(args)
              let mut ai = 0
              let mut s2 = s
              let mut c2 = c
              while ai < alen {
                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)
            },
            None => {
              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)
              let alen = Array::length(args)
              let arg_tys = Array::slice([
                CtUnknown
              ], 0, 0)
              let mut ai = 0
              let mut s2 = s1
              let mut c2 = c1
              while ai < alen {
                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
                Array::push(arg_tys, at)
                s2 = ns
                c2 = nc
                ai = ai + 1
              }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for ", String::concat(callee_name0, String::concat(": expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)
                let call_ret = Array::get(ret_box, 0)
                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
              },
              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
            }
            }
          }
        } else {
            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)
            let alen = Array::length(args)
            let arg_tys = Array::slice([
              CtUnknown
            ], 0, 0)
            let mut ai = 0
            let mut s2 = s1
            let mut c2 = c1
            while ai < alen {
              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)
              Array::push(arg_tys, at)
              s2 = ns
              c2 = nc
              ai = ai + 1
            }
            let applied_callee_ty = match ct {
              CtFn(_, _, _) => ct,
              _ => subst_apply(s2, ct)
            }
            match applied_callee_ty {
              CtFn(param_tys, ret, _) => {
                let ret_box = Array::slice([
                  ret
                ], 0, 1)
                let call_param_tys = param_tys
                let plen2 = Array::length(param_tys)
                let alen3 = Array::length(arg_tys)
                if alen3 != plen2 {
                  Array::push(errors, String::concat(String::concat("function arity mismatch for <expr>: expected ", String::concat(__to_string(plen2), String::concat(" args, got ", __to_string(alen3)))), off_marker(call_off)))
                }
                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, "<expr>", call_off)
                let call_ret = Array::get(ret_box, 0)
                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)
              },
              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),
              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)
            }
        }
      }
    },
    EBinOp(op, left, right) => {
      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)
      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)
      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)
      (subst_apply(s3, result_ty), s3, c2)
    },
    EUnaryOp(op, operand) => {
      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)
      if op == "!" {
        match subst_apply(s1, operand_ty) {
          CtBool => (CtBool, s1, c1),
          CtVar(_) => match unify(operand_ty, CtBool, s1) {
            Some(s2) => (CtBool, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else if op == "-" {
        match subst_apply(s1, operand_ty) {
          CtDouble => (CtDouble, s1, c1),
          CtInt => (CtInt, s1, c1),
          CtVar(_) => match unify(operand_ty, CtInt, s1) {
            Some(s2) => (CtInt, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else (CtUnknown, s1, c1)
    },
    EAssign(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)
      // The assigned value must be assignable to the variable's type
      // (previously unchecked — `y = "s"` for `let mut y = 1` was accepted).
      let s1b = match env_lookup(env, name) {
        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat("assignment type mismatch for ", name), 0 - 1),
        None => s1
      }
      check_expr(body, env, defs, s1b, c1, errors, tytab)
    },
    EAssignOp(_, _, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)
      check_expr(body, env, defs, s1, c1, errors, tytab)
    },
    EMatch(scrutinee, arms) => {
      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)
      let alen = Array::length(arms)
      if alen == 0 {
        (CtUnknown, s1, c1)
      }
      else {
        let mut result_ty = CtUnknown
        let mut si = s1
        let mut ci = c1
        let mut ai = 0
        while ai < alen {
          let (pat, body) = Array::get(arms, ai)
          let arm_env = check_pattern(pat, scr_ty, env, defs)
          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)
          if ai == 0 {
            result_ty = arm_ty
          }
          si = ns
          ci = nc
          ai = ai + 1
        }
        (result_ty, si, ci)
      }
    },
    EHandle(body, _) => check_expr(body, env, defs, s, c, errors, tytab),
    EWhile(cond, body) => {
      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)
      let resolved_ct = subst_apply(s1, ct)
      match resolved_ct {
        CtBool => (),
        CtUnknown => (),
        CtVar(_) => (),
        _ => Array::push(errors, "while condition must be Bool")
      }
      let (_, s2, c2) = check_expr(body, env, defs, s1, c1, errors, tytab)
      (CtUnit, s2, c2)
    },
    ELoop(params, body) => {
      let mut env1 = env
      let mut s1 = s
      let mut c1 = c
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)
        env1 = env_bind(env1, name, pt)
        s1 = ns
        c1 = nc
        i = i + 1
      }
      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1, errors, tytab)
      (CtUnit, s2, c2)
    },
    EForIn(name, index_name, iterable, body) => {
      // `for await x in s` reaches the checker as `for x in __await_iter(s)`
      // (the parser's marker; the dict-passing desugar strips it for codegen).
      // The marker is not a real function, so check the inner iterable directly.
      let real_iterable = match iterable {
        ECall(callee, args, _) => match callee {
          EIdent(nm, _) => if nm == "__await_iter" && Array::length(args) == 1 {
            Array::get(args, 0)
          } else iterable,
          _ => iterable
        },
        _ => iterable
      }
      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)
      // Element type bound by `for x in it`:
      //   - `Array[T]`                       -> T
      //   - a parameterized iterator type
      //     `C[T, ..]` (`LazyIter[T]`, async `Stream[T]`, `for await`'s
      //     desugared iterator, …) -> its FIRST type argument `T`. By the
      //     iterator convention `next(Self) -> Option[(T, Self)]` the element is
      //     the struct's first type parameter, so it is recoverable from the
      //     iterable's type alone — which matters across modules, where the
      //     `impl Iterator for C` lives in a dependency and is not in this file's
      //     import env (the dict-passing desugar drives codegen off the merged
      //     sources separately). Only `for` loops over a real iterable reach
      //     codegen, so a non-iterator never lands here in a valid program.
      //   - an iterator type with NO type argument (a bare struct value, or
      //     `Stream` in the eager Array-backed model, docs/spec §M2c-3) -> a
      //     fresh unification var, so the loop body's usage constrains the
      //     element instead of `CtUnknown` silently accepting any element use and
      //     dropping element-type safety.
      let it_resolved = subst_apply(s1, it)
      let (et, c1b) = match it_resolved {
        CtArray(elem) => (elem, c1),
        CtNamed(nm, args) => if Array::length(args) > 0 {
          (Array::get(args, 0), c1)
        } else if nm == "Stream" || type_name_has_iterator_impl(env, nm) {
          fresh_var(c1)
        } else (CtUnknown, c1),
        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {
          fresh_var(c1)
        } else (CtUnknown, c1),
        _ => (CtUnknown, c1)
      }
      let env2 = env_bind(env, name, et)
      let env3 = match index_name {
        Some(index_name) => env_bind(env2, index_name, CtInt),
        None => env2
      }
      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1b, errors, tytab)
      (CtArray(bt), s2, c2)
    },
    EDot(obj, field, dot_off) => {
      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)
      let resolved = subst_apply(s1, obj_ty)
      let field_ty = match resolved {
        CtStruct(sname) => match find_typedef(defs, sname) {
          Some(td) => match td {
            TDStruct(_, fields, _) => {
              let rec find_field: (Int) -> Option[Type] = (i) -> {
                if i >= Array::length(fields) {
                  None
                } else {
                  let (fname, ftype) = Array::get(fields, i)
                  if fname == field {
                    Some(ftype)
                  } else find_field(i + 1)
                }
              }
              match find_field(0) {
                Some(ft) => ft,
                None => {
                  Array::push(errors, String::concat(String::concat("unknown field '", String::concat(field, String::concat("' on struct ", sname))), off_marker(dot_off)))
                  CtUnknown
                }
              }
            },
            _ => CtUnknown
          },
          None => CtUnknown
        },
        _ => CtUnknown
      }
      // Record this field-access node's (raw, pre-final-subst) projection type
      // keyed by its real source offset, for typed-hover on `obj.field`.
      // Synthetic accesses (dot_off < 0) are skipped.
      if dot_off >= 0 {
        Array::push(tytab, (dot_off, field_ty))
      } else {
        ()
      }
      (field_ty, s1, c1)
    },
    EFn(tparams, tbounds, params, ret_ty, effect, body) => {
      let tplen = Array::length(tparams)
      let mut tp_env = env
      let mut s0 = s
      let mut c0 = c
      let mut tpi = 0
      while tpi < tplen {
        let tpname = Array::get(tparams, tpi)
        match fresh_var(c0) {
          (tv, nc) => {
            let vid = nc - 1
            let tblen = Array::length(tbounds)
            let mut bounds = Array::slice([
              ""
            ], 0, 0)
            let mut tbi = 0
            let mut found_bounds = false
            while tbi < tblen {
              let (bname, blist) = Array::get(tbounds, tbi)
              if !found_bounds && bname == tpname {
                bounds = blist
                found_bounds = true
              }
              tbi = tbi + 1
            }
            s0 = if Array::length(bounds) == 0 {
              s0
            } else subst_add_bound(s0, vid, bounds)
            tp_env = env_bind(tp_env, tpname, tv)
            c0 = nc
          },
          _ => ()
        }
        tpi = tpi + 1
      }
      let plen = Array::length(params)
      let mut fn_env = tp_env
      let mut s1 = s0
      let mut c1 = c0
      let param_types = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut pi = 0
      while pi < plen {
        let (raw_name, ann) = Array::get(params, pi)
        let nlen = String::length(raw_name)
        let name = if nlen > 0 {
          let lc = String::char_code_at(raw_name, nlen - 1)
          if lc == '~' || lc == '?' {
            raw_name[0: nlen - 1]
          } else raw_name
        } else raw_name
        let (pt, ns, nc) = match ann {
          Some(te) => {
            let resolved = resolve_type_expr(te, defs)
            let pt2 = resolve_tparams_in(resolved, fn_env)
            (pt2, s1, c1)
          },
          None => {
            let (tv, nc2) = fresh_var(c1)
            (tv, s1, nc2)
          }
        }
        fn_env = env_bind(fn_env, name, pt)
        Array::push(param_types, pt)
        s1 = ns
        c1 = nc
        pi = pi + 1
      }
      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1, errors, tytab)
      let (final_ret, s3) = match ret_ty {
        Some(te) => {
          let resolved = resolve_type_expr(te, defs)
          let resolved_ret = resolve_tparams_in(resolved, fn_env)
          match unify(bt, resolved_ret, s2) {
            Some(ns) => (subst_apply(ns, resolved_ret), ns),
            None => {
              Array::push(errors, String::concat("return type mismatch: expected ", String::concat(type_to_string(resolved_ret), String::concat(", got ", type_to_string(bt)))))
              (CtUnknown, s2)
            }
          }
        },
        None => (subst_apply(s2, bt), s2)
      }
      (CtFn(param_types, final_ret, effect), s3, c2)
    },
    EBreak(opt) => match opt {
      Some(e) => {
        let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)
        (CtUnit, s1, c1)
      },
      None => (CtUnit, s, c)
    },
    EContinue(args) => {
      let alen = Array::length(args)
      let mut s1 = s
      let mut c1 = c
      let mut ai = 0
      while ai < alen {
        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtUnit, s1, c1)
    },
    ERecord(fields) => {
      let flen = Array::length(fields)
      let mut s1 = s
      let mut c1 = c
      let field_tys = Array::slice([
        ("", CtUnknown)
      ], 0, 0)
      let mut fi = 0
      while fi < flen {
        let (fname, fval) = Array::get(fields, fi)
        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)
        Array::push(field_tys, (fname, ft))
        s1 = ns
        c1 = nc
        fi = fi + 1
      }
      // Check the field values against the matching struct's declared types.
      let s2 = check_record_fields(defs, field_tys, s1, errors)
      // Recover the struct identity (when unambiguous) so downstream uses — in
      // particular `mut`-field write checking — see a concrete `CtStruct`.
      let rec_ty = match resolve_record_struct_name(defs, field_tys) {
        Some(sname) => CtStruct(sname),
        None => CtUnknown
      }
      (rec_ty, s2, c1)
    },
    ETuple(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let tys = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut ti = 0
      while ti < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)
        Array::push(tys, it)
        s1 = ns
        c1 = nc
        ti = ti + 1
      }
      (CtTuple(tys), s1, c1)
    },
    EArray(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let mut elem_ty = CtUnknown
      let mut ai = 0
      while ai < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)
        if ai == 0 {
          elem_ty = it
        }
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtArray(elem_ty), s1, c1)
    },
    EReturn(e) => {
      let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)
      (CtUnknown, s1, c1)
    },
    _ => (CtUnknown, s, c)
  }
}
