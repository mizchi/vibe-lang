  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, subst_bounds_for, trait_method_sig_deep, type_implements_trait, type_name_has_iterator_impl, type_to_string, unify
