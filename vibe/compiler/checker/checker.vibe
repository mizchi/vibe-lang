//# Imports

import ../core/ast.vibe {
  Expr
}

import ../core/types.vibe {
  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, type_implements_trait, unify
}

import ./builtins.vibe {
  lookup_builtin
}

import ./checker_pattern.vibe {
  check_pattern
}

import ./checker_resolve.vibe {
  resolve_type_expr
}

//# Functions

let min_int = (a: Int, b: Int) -> Int {
  if a < b {
    a
  } else {
    b
  }
}

let prepend_expr = (first: Expr, rest: Array[Expr]) -> Array[Expr] {
  let out = Array::slice([
    EUnit
  ], 0, 0)
  Array::push(out, first)
  let mut i = 0
  while i < Array::length(rest) {
    Array::push(out, Array::get(rest, i))
    i = i + 1
  }
  out
}

let is_bool_binop = (op: String) -> Bool {
  op == "=="
  || op == "!="
  || op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
  || op == "&&"
  || op == "||"
}

let is_logic_binop = (op: String) -> Bool {
  op == "&&"
  || op == "||"
}

let is_equality_binop = (op: String) -> Bool {
  op == "=="
  || op == "!="
}

let is_order_binop = (op: String) -> Bool {
  op == "<"
  || op == ">"
  || op == "<="
  || op == ">="
}

let unify_binop_candidate = (left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {
  match unify(left_ty, target_ty, s) {
    Some(s1) => unify(right_ty, target_ty, s1),
    None => None
  }
}

let infer_binop_type = (op: String, left_ty: Type, right_ty: Type, s: Subst) -> (Type, Subst) {
  if is_logic_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {
      Some(s1) => (CtBool, s1),
      None => (CtUnknown, s)
    }
  }
  else if is_equality_binop(op) {
    match unify(left_ty, right_ty, s) {
      Some(s1) => (CtBool, s1),
      None => (CtUnknown, s)
    }
  }
  else if is_order_binop(op) {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtBool, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtBool, s1),
        None => (CtUnknown, s)
      }
    }
  }
  else if op == "+" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {
          Some(s1) => (CtString, s1),
          None => (CtUnknown, s)
        }
      }
    }
  }
  else if op == "-"
    || op == "*"
    || op == "/" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {
        Some(s1) => (CtDouble, s1),
        None => (CtUnknown, s)
      }
    }
  }
  else if op == "%" {
    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {
      Some(s1) => (CtInt, s1),
      None => (CtUnknown, s)
    }
  }
  else (CtUnknown, s)
}

let type_name_prefix = (ty: Type) -> String {
  match ty {
    CtInt => "Int",
    CtDouble => "Double",
    CtBool => "Bool",
    CtString => "String",
    CtChar => "Char",
    CtUnit => "Unit",
    CtBytes => "Bytes",
    CtArray(_) => "Array",
    CtOption(_) => "Option",
    CtEnum(name) => name,
    CtStruct(name) => name,
    CtNamed(name, _) => name,
    _ => ""
  }
}

export let rec check_expr = (expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int) -> (Type, Subst, Int) {
  match expr {
    EInt(_) => (CtInt, s, c),
    EFloat(_) => (CtDouble, s, c),
    EString(_) => (CtString, s, c),
    EBool(_) => (CtBool, s, c),
    EUnit => (CtUnit, s, c),
    EIdent(name) => match env_lookup(env, name) {
      Some(t) => {
        let (ti, c1, new_bounds) = instantiate(t, c)
        let nblen = Array::length(new_bounds)
        let mut s1 = s
        let mut bi = 0
        while bi < nblen {
          let (vid, bounds) = Array::get(new_bounds, bi)
          if !eq(Array::length(bounds), 0) {
            s1 = subst_add_bound(s1, vid, bounds)
          }
          bi = bi + 1
        }
        (ti, s1, c1)
      },
      None => match lookup_builtin(name) {
        Some(t) => (t, s, c),
        None => (CtUnknown, s, c)
      }
    }
    ,
    ESeq(left, right) => {
      let (_, s1, c1) = check_expr(left, env, defs, s, c)
      check_expr(right, env, defs, s1, c1)
    },
    ELet(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c)
      let gen = generalize(s1, vt)
      check_expr(body, env_bind(env, name, gen), defs, s1, c1)
    },
    ELetRec(name, val, body) => {
      let (tv, c1) = fresh_var(c)
      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1)
      let s2 = match unify(tv, vt, s1) {
        Some(su) => su,
        None => s1
      }
      let gen = generalize(s2, tv)
      check_expr(body, env_bind(env, name, gen), defs, s2, c2)
    },
    ELetMut(name, val, body) => {
      let (vt, s1, c1) = check_expr(val, env, defs, s, c)
      check_expr(body, env_bind(env, name, vt), defs, s1, c1)
    },
    EIf(cond, then_e, else_e) => {
      let (_, s1, c1) = check_expr(cond, env, defs, s, c)
      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1)
      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2)
      (tt, s3, c3)
    },
    ECall(callee, args) => match callee {
      EDot(obj, method) => {
        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)
        let resolved = subst_apply(s1, obj_ty)
        let type_prefix = type_name_prefix(resolved)
        let qualified = String::concat(type_prefix, String::concat("::", method))
        let method_ty = match env_lookup(env, qualified) {
          Some(t) => {
            let (ti, c2, _) = instantiate(t, c1)
            (ti, s1, c2)
          },
          None => match lookup_builtin(qualified) {
            Some(t) => (t, s1, c1),
            None => (CtUnknown, s1, c1)
          }
        }
        let (mt, s2, c2) = method_ty
        let all_args = prepend_expr(obj, args)
        let alen = Array::length(all_args)
        let arg_tys = Array::slice([
          CtUnknown
        ], 0, 0)
        Array::push(arg_tys, obj_ty)
        let mut ai = 1
        let mut s3 = s2
        let mut c3 = c2
        while ai < alen {
          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3)
          Array::push(arg_tys, at)
          s3 = ns
          c3 = nc
          ai = ai + 1
        }
        match subst_apply(s3, mt) {
          CtFn(param_tys, ret, _) => {
            let mut s4 = s3
            let mut ui = 0
            let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
            while ui < ul {
              s4 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s4) {
                Some(su) => su,
                None => s4
              }
              ui = ui + 1
            }
            (subst_apply(s4, ret), s4, c3)
          },
          _ => (CtUnknown, s3, c3)
        }
      },
      _ => {
        let (ct, s1, c1) = check_expr(callee, env, defs, s, c)
        let alen = Array::length(args)
        let arg_tys = Array::slice([
          CtUnknown
        ], 0, 0)
        let mut ai = 0
        let mut s2 = s1
        let mut c2 = c1
        while ai < alen {
          let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2)
          Array::push(arg_tys, at)
          s2 = ns
          c2 = nc
          ai = ai + 1
        }
        match subst_apply(s2, ct) {
          CtFn(param_tys, ret, _) => {
            let mut s3 = s2
            let mut ui = 0
            let ul = min_int(Array::length(arg_tys), Array::length(param_tys))
            while ui < ul {
              s3 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s3) {
                Some(su) => su,
                None => s3
              }
              ui = ui + 1
            }
            (subst_apply(s3, ret), s3, c2)
          },
          CtStruct(sname) => (CtStruct(sname), s2, c2),
          _ => (CtUnknown, s2, c2)
        }
      }
    },
    EBinOp(op, left, right) => {
      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c)
      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1)
      let (result_ty, s3) = infer_binop_type(
        op,
        subst_apply(s2, left_ty),
        subst_apply(s2, right_ty),
        s2
      )
      (subst_apply(s3, result_ty), s3, c2)
    },
    EUnaryOp(op, operand) => {
      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c)
      if op == "!" {
        match subst_apply(s1, operand_ty) {
          CtBool => (CtBool, s1, c1),
          CtVar(_) => match unify(operand_ty, CtBool, s1) {
            Some(s2) => (CtBool, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else if op == "-" {
        match subst_apply(s1, operand_ty) {
          CtDouble => (CtDouble, s1, c1),
          CtInt => (CtInt, s1, c1),
          CtVar(_) => match unify(operand_ty, CtInt, s1) {
            Some(s2) => (CtInt, s2, c1),
            None => (CtUnknown, s1, c1)
          },
          _ => (CtUnknown, s1, c1)
        }
      } else (CtUnknown, s1, c1)
    },
    EAssign(_, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c)
      check_expr(body, env, defs, s1, c1)
    },
    EAssignOp(_, _, val, body) => {
      let (_, s1, c1) = check_expr(val, env, defs, s, c)
      check_expr(body, env, defs, s1, c1)
    },
    EMatch(scrutinee, arms) => {
      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c)
      let alen = Array::length(arms)
      if eq(alen, 0) {
        (CtUnknown, s1, c1)
      }
      else {
        let mut result_ty = CtUnknown
        let mut si = s1
        let mut ci = c1
        let mut ai = 0
        while ai < alen {
          let (pat, body) = Array::get(arms, ai)
          let arm_env = check_pattern(pat, scr_ty, env, defs)
          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci)
          if eq(ai, 0) {
            result_ty = arm_ty
          }
          si = ns
          ci = nc
          ai = ai + 1
        }
        (result_ty, si, ci)
      }
    },
    EHandle(body, _) => check_expr(body, env, defs, s, c),
    EWhile(cond, body) => {
      let (_, s1, c1) = check_expr(cond, env, defs, s, c)
      let (_, s2, c2) = check_expr(body, env, defs, s1, c1)
      (CtUnit, s2, c2)
    },
    ELoop(params, body) => {
      let mut env1 = env
      let mut s1 = s
      let mut c1 = c
      let mut i = 0
      while i < Array::length(params) {
        let (name, init) = Array::get(params, i)
        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1)
        env1 = env_bind(env1, name, pt)
        s1 = ns
        c1 = nc
        i = i + 1
      }
      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1)
      (CtUnit, s2, c2)
    },
    EForIn(name, index_name, iterable, body) => {
      let (it, s1, c1) = check_expr(iterable, env, defs, s, c)
      let et = match it {
        CtArray(elem) => elem,
        _ => CtUnknown
      }
      let env2 = env_bind(env, name, et)
      let env3 = match index_name {
        Some(index_name) => env_bind(env2, index_name, CtInt),
        None => env2
      }
      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1)
      (CtArray(bt), s2, c2)
    },
    EDot(obj, field) => {
      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c)
      let resolved = subst_apply(s1, obj_ty)
      let field_ty = match resolved {
        CtStruct(sname) => match find_typedef(defs, sname) {
          Some(td) => match td {
            TDStruct(_, fields) => {
              let rec find_field = (i: Int) -> Type {
                if i >= Array::length(fields) {
                  CtUnknown
                } else {
                  let (fname, ftype) = Array::get(fields, i)
                  if fname == field {
                    ftype
                  } else find_field(i + 1)
                }
              }
              find_field(0)
            },
            _ => CtUnknown
          },
          None => CtUnknown
        },
        _ => CtUnknown
      }
      (field_ty, s1, c1)
    },
    EFn(tparams, tbounds, params, ret_ty, effect, body) => {
      let he = match effect {
        Some(_) => true,
        None => false
      }
      let tplen = Array::length(tparams)
      let rec alloc_tparams = (i: Int, acc_env: TypeEnv, acc_s: Subst, acc_c: Int) -> (TypeEnv, Subst, Int) {
        if i >= tplen {
          (acc_env, acc_s, acc_c)
        }
        else {
          let tpname = Array::get(tparams, i)
          let (tv, nc) = fresh_var(acc_c)
          let vid = nc - 1
          let tblen = Array::length(tbounds)
          let rec find_bounds = (j: Int) -> Array[String] {
            if j >= tblen {
              Array::slice([
                ""
              ], 0, 0)
            }
            else {
              let (bname, blist) = Array::get(tbounds, j)
              if bname == tpname {
                blist
              }
              else find_bounds(j + 1)
            }
          }
          let bounds = find_bounds(0)
          let ns = if eq(Array::length(bounds), 0) {
            acc_s
          }
          else subst_add_bound(acc_s, vid, bounds)
          alloc_tparams(i + 1, env_bind(acc_env, tpname, tv), ns, nc)
        }
      }
      let (tp_env, s0, c0) = alloc_tparams(0, env, s, c)
      let plen = Array::length(params)
      let mut fn_env = tp_env
      let mut s1 = s0
      let mut c1 = c0
      let param_types = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut pi = 0
      while pi < plen {
        let (name, ann) = Array::get(params, pi)
        let (pt, ns, nc) = match ann {
          Some(te) => {
            let resolved = resolve_type_expr(te, defs)
            let pt2 = match resolved {
              CtNamed(tn, _) => match env_lookup(fn_env, tn) {
                Some(t) => t,
                None => resolved
              },
              _ => resolved
            }
            (pt2, s1, c1)
          },
          None => {
            let (tv, nc2) = fresh_var(c1)
            (tv, s1, nc2)
          }
        }
        fn_env = env_bind(fn_env, name, pt)
        Array::push(param_types, pt)
        s1 = ns
        c1 = nc
        pi = pi + 1
      }
      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1)
      let (final_ret, s3) = match ret_ty {
        Some(te) => {
          let resolved = resolve_type_expr(te, defs)
          let resolved_ret = match resolved {
            CtNamed(tn, _) => match env_lookup(fn_env, tn) {
              Some(t) => t,
              None => resolved
            },
            _ => resolved
          }
          match unify(bt, resolved_ret, s2) {
            Some(ns) => (subst_apply(ns, resolved_ret), ns),
            None => (CtUnknown, s2)
          }
        },
        None => (subst_apply(s2, bt), s2)
      }
      let resolved_params = for p in param_types {
        subst_apply(s3, p)
      }
      (CtFn(resolved_params, final_ret, he), s3, c2)
    },
    EBreak(opt) => match opt {
      Some(e) => {
        let (_, s1, c1) = check_expr(e, env, defs, s, c)
        (CtUnit, s1, c1)
      },
      None => (CtUnit, s, c)
    }
    ,
    EContinue(args) => {
      let alen = Array::length(args)
      let mut s1 = s
      let mut c1 = c
      let mut ai = 0
      while ai < alen {
        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1)
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtUnit, s1, c1)
    },
    ERecord(fields) => {
      let flen = Array::length(fields)
      let mut s1 = s
      let mut c1 = c
      let mut fi = 0
      while fi < flen {
        let (_, fval) = Array::get(fields, fi)
        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1)
        s1 = ns
        c1 = nc
        fi = fi + 1
      }
      (CtUnknown, s1, c1)
    },
    ETuple(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let tys = Array::slice([
        CtUnknown
      ], 0, 0)
      let mut ti = 0
      while ti < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1)
        Array::push(tys, it)
        s1 = ns
        c1 = nc
        ti = ti + 1
      }
      (CtTuple(tys), s1, c1)
    },
    EArray(items) => {
      let ilen = Array::length(items)
      let mut s1 = s
      let mut c1 = c
      let mut elem_ty = CtUnknown
      let mut ai = 0
      while ai < ilen {
        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1)
        if eq(ai, 0) {
          elem_ty = it
        }
        s1 = ns
        c1 = nc
        ai = ai + 1
      }
      (CtArray(elem_ty), s1, c1)
    },
    _ => (CtUnknown, s, c)
  }
}
