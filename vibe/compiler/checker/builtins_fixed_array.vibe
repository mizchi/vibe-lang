//# Imports

import .. / core / types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  Array::slice([
    CtUnknown
  ], 0, 0)
}

let one_param = (a: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  arr
}

let two_params = (a: Type, b: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  arr
}

let five_params = (a: Type, b: Type, c: Type, d: Type, e: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  Array::push(arr, d)
  Array::push(arr, e)
  arr
}

let three_params = (a: Type, b: Type, c: Type) -> Array[Type] {
  let arr = no_params()
  Array::push(arr, a)
  Array::push(arr, b)
  Array::push(arr, c)
  arr
}

let lookup_fixed_array_get = (name: String) -> Option[Type] {
  if name == "FixedArray::get" {
    Some(CtFn(two_params(CtArray(CtUnknown), CtInt), CtUnknown, None))
  }
  else None
}

let lookup_fixed_array_set = (name: String) -> Option[Type] {
  if name == "FixedArray::set" {
    Some(CtFn(three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_fixed_array_blit = (name: String) -> Option[Type] {
  if name == "FixedArray::blit" {
    Some(CtFn(five_params(CtArray(CtUnknown), CtInt, CtArray(CtUnknown), CtInt, CtInt), CtUnit, None))
  }
  else None
}

let lookup_fixed_array_make = (name: String) -> Option[Type] {
  if name == "FixedArray::make" {
    Some(CtFn(two_params(CtInt, CtUnknown), CtArray(CtUnknown), None))
  }
  else None
}

let lookup_fixed_array_length = (name: String) -> Option[Type] {
  if name == "FixedArray::length" {
    Some(CtFn(one_param(CtArray(CtUnknown)), CtInt, None))
  }
  else None
}

let lookup_fixed_array_group_a = (name: String) -> Option[Type] {
  match lookup_fixed_array_make(name) {
    Some(t) => Some(t),
    None => match lookup_fixed_array_length(name) {
      Some(t) => Some(t),
      None => lookup_fixed_array_get(name)
    }
  }
}

let lookup_fixed_array_unsafe_set = (name: String) -> Option[Type] {
  if name == "FixedArray::unsafe_set" {
    Some(CtFn(three_params(CtArray(CtUnknown), CtInt, CtUnknown), CtUnit, None))
  }
  else None
}

let lookup_fixed_array_group_b = (name: String) -> Option[Type] {
  match lookup_fixed_array_set(name) {
    Some(t) => Some(t),
    None => match lookup_fixed_array_unsafe_set(name) {
      Some(t) => Some(t),
      None => lookup_fixed_array_blit(name)
    }
  }
}

export let lookup_fixed_array = (name: String) -> Option[Type] {
  match lookup_fixed_array_group_a(name) {
    Some(t) => Some(t),
    None => lookup_fixed_array_group_b(name)
  }
}
