//# Imports

import ./stmt_test_support.vibe {
  pp, ps
}

//# Misc

test "stmt_enum_multi_args" {
  let result = ps("enum Expr { EBinOp(String, Expr, Expr); EInt(Int) }")
  assert(String::equals(result, "enum Expr { EBinOp(String, Expr, Expr); EInt(Int) }"))
}

test "stmt_struct_complex_types" {
  let result = ps("struct Config { items: Array[String]; handler: (Int) -> Bool }")
  assert(String::equals(result, "struct Config { items: Array[String]; handler: (Int) -> Bool }"))
}

test "stmt_type_alias_fn" {
  let result = ps("type Handler = (String, Int) -> Bool")
  assert(String::equals(result, "type Handler = (String, Int) -> Bool"))
}

test "stmt_export_trait" {
  assert(String::equals(ps("export trait Eq"), "export trait Eq"))
}

test "stmt_suberror_single_payload" {
  let result = ps("suberror AppError(String)")
  assert(String::equals(result, "suberror AppError(String)"))
}

test "stmt_suberror_variants" {
  let result = ps("suberror AppError { NotFound; Invalid(String) }")
  assert(String::equals(result, "suberror AppError { NotFound; Invalid(String) }"))
}

test "stmt_export_suberror" {
  let result = ps("export suberror AppError(String)")
  assert(String::equals(result, "export suberror AppError(String)"))
}
