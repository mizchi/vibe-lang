let lookup_io = (name: String) -> Option[Type] {
  if string_equals(name, "sh") {
    Some(CtFn([CtString], CtString, true))
  }
  else if string_equals(name, "sh_lines") {
    Some(CtFn([CtString], CtArray(CtString), true))
  }
  else if string_equals(name, "path") {
    Some(CtFn([CtString], CtUnknown, false))
  }
  else if string_equals(name, "path_to_string") {
    Some(CtFn([CtUnknown], CtString, false))
  }
  else if string_equals(name, "path_is_absolute") {
    Some(CtFn([CtString], CtBool, false))
  }
  else if string_equals(name, "prompt_text") {
    Some(CtFn([CtString], CtString, false))
  }
  else if string_equals(name, "stdin_read_char") {
    Some(CtFn(no_params(), CtInt, true))
  }
  else if string_equals(name, "stdin_read_stream") {
    Some(CtFn(no_params(), CtString, true))
  }
  else if string_equals(name, "stdout_write_char") {
    Some(CtFn([CtInt], CtUnit, false))
  }
  else if string_equals(name, "stdout_write_stream") {
    Some(CtFn([CtString], CtUnit, false))
  }
  else if string_equals(name, "env_get") {
    Some(CtFn([CtString], CtString, true))
  }
  else if string_equals(name, "sleep") {
    Some(CtFn([CtInt], CtUnit, false))
  }
  else if string_equals(name, "dynamic_path_resolve") {
    Some(CtFn([CtString], CtString, false))
  }
  else None
}

