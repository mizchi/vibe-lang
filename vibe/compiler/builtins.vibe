  }
  else if string_equals(name, "http_respond") {
    Some(CtFn([CtUnknown, CtInt, CtString], CtUnit, true))
  }
  else None
}

export let lookup_builtin = (name: String) -> Option[Type] {
  let normalized_name = normalize_builtin_name(name)
  match lookup_array(normalized_name) {
    Some(t) => Some(t),
    None => match lookup_array_builder(normalized_name) {
      Some(t) => Some(t),
      None => match lookup_string1(normalized_name) {
        Some(t) => Some(t),
        None => match lookup_string2(normalized_name) {
          Some(t) => Some(t),
          None => match lookup_string_builder(normalized_name) {
            Some(t) => Some(t),
            None => match lookup_bytes(normalized_name) {
              Some(t) => Some(t),
              None => match lookup_map(normalized_name) {
                Some(t) => Some(t),
                None => match lookup_io(normalized_name) {
                  Some(t) => Some(t),
                  None => match lookup_fs(normalized_name) {
                    Some(t) => Some(t),
                    None => match lookup_net(normalized_name) {
                      Some(t) => Some(t),
                      None => lookup_misc(normalized_name)
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
