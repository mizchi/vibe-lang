//# Imports

import ./types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  array_slice([
    CtUnknown
  ], 0, 0)
}

export let normalize_builtin_name = (name: String) -> String {
  if string_equals(name, "map_builder") {
    "MapBuilder::new"
  }
  else if string_equals(name, "map_builder_set") {
    "MapBuilder::set"
  }
  else if string_equals(name, "map_builder_freeze") {
    "MapBuilder::freeze"
  }
  else name
}

let lookup_map = (name: String) -> Option[Type] {
  if string_equals(name, "MapBuilder::new") {
    Some(CtFn(no_params(), CtUnknown, false))
  }
  else if string_equals(name, "MapBuilder::set") {
    Some(CtFn([
      CtUnknown,
      CtString,
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "MapBuilder::freeze") {
    Some(CtFn([
      CtUnknown
    ], CtUnknown, false))
  }
  else if string_equals(name, "map_get") {
    Some(CtFn([
      CtUnknown,
      CtString
    ], CtUnknown, false))
  }
  else if string_equals(name, "map_has") {
    Some(CtFn([
      CtUnknown,
      CtString
    ], CtBool, false))
  }
  else if string_equals(name, "map_keys") {
    Some(CtFn([
      CtUnknown
    ], CtArray(CtString), false))
  }
  else None
}

let lookup_misc = (name: String) -> Option[Type] {
  if string_equals(name, "eq") {
    Some(CtFn([
      CtInt,
      CtInt
    ], CtBool, false))
  }
  else if string_equals(name, "not") {
    Some(CtFn([
      CtBool
    ], CtBool, false))
  }
  else if string_equals(name, "__to_string") {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if string_equals(name, "print") {
    Some(CtFn([
      CtString
    ], CtUnit, false))
  }
  else if string_equals(name, "println") {
    Some(CtFn([
      CtString
    ], CtUnit, false))
  }
  else if string_equals(name, "assert") {
    Some(CtFn([
      CtBool
    ], CtUnit, false))
  }
  else if string_equals(name, "throw") {
    Some(CtFn([
      CtString
    ], CtUnknown, true))
  }
  else if string_equals(name, "int_to_double") {
    Some(CtFn([
      CtInt
    ], CtDouble, false))
  }
  else if string_equals(name, "double_to_int") {
    Some(CtFn([
      CtDouble
    ], CtInt, false))
  }
  else if string_equals(name, "double_to_i64_bits") {
    Some(CtFn([
      CtDouble
    ], CtInt, false))
  }
  else if string_equals(name, "i64_bits_to_double") {
    Some(CtFn([
      CtInt
    ], CtDouble, false))
  }
  else None
}

let lookup_array = (name: String) -> Option[Type] {
  if string_equals(name, "array_length") {
    Some(CtFn([
      CtArray(CtUnknown)
    ], CtInt, false))
  }
  else if string_equals(name, "array_get") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt
    ], CtUnknown, false))
  }
  else if string_equals(name, "array_set") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "array_push") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "array_slice") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtInt
    ], CtArray(CtUnknown), false))
  }
  else if string_equals(name, "array_concat") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtArray(CtUnknown)
    ], CtArray(CtUnknown), false))
  }
  else None
}

