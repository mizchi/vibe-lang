let lookup_net = (name: String) -> Option[Type] {
  if string_equals(name, "socket_tcp_connect") {
    Some(CtFn([CtString, CtInt], CtUnknown, true))
  }
  else if string_equals(name, "socket_tcp_read") {
    Some(CtFn([CtUnknown, CtInt], CtString, true))
  }
  else if string_equals(name, "socket_tcp_write") {
    Some(CtFn([CtUnknown, CtString], CtInt, true))
  }
  else if string_equals(name, "socket_tcp_close") {
    Some(CtFn([CtUnknown], CtUnit, true))
  }
  else if string_equals(name, "http_request") {
    Some(CtFn([CtString, CtString], CtUnknown, true))
  }
  else if string_equals(name, "http_response_status") {
    Some(CtFn([CtUnknown], CtInt, false))
  }
  else if string_equals(name, "http_response_header") {
    Some(CtFn([CtUnknown, CtString], CtString, false))
  }
  else if string_equals(name, "http_response_body") {
    Some(CtFn([CtUnknown], CtString, true))
  }
  else if string_equals(name, "http_close") {
    Some(CtFn([CtUnknown], CtUnit, false))
  }
  else if string_equals(name, "http_listen") {
    Some(CtFn([CtString, CtInt], CtUnknown, true))
  }
  else if string_equals(name, "http_accept") {
    Some(CtFn([CtUnknown], CtUnknown, true))
  }
  else if string_equals(name, "http_request_method") {
    Some(CtFn([CtUnknown], CtString, false))
  }
  else if string_equals(name, "http_request_header") {
