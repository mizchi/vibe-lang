//# Imports

import ./types.vibe {
  Type
}

//# Functions

let no_params = () -> Array[Type] {
  array_slice([
    CtUnknown
  ], 0, 0)
}

let lookup_map = (name: String) -> Option[Type] {
  if string_equals(name, "map_builder") {
    Some(CtFn(no_params(), CtUnknown, false))
  }
  else if string_equals(name, "map_builder_set") {
    Some(CtFn([
      CtUnknown,
      CtString,
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "map_builder_freeze") {
    Some(CtFn([
      CtUnknown
    ], CtUnknown, false))
  }
  else if string_equals(name, "map_get") {
    Some(CtFn([
      CtUnknown,
      CtString
    ], CtUnknown, false))
  }
  else if string_equals(name, "map_has") {
    Some(CtFn([
      CtUnknown,
      CtString
    ], CtBool, false))
  }
  else if string_equals(name, "map_keys") {
    Some(CtFn([
      CtUnknown
    ], CtArray(CtString), false))
  }
  else None
}

let lookup_misc = (name: String) -> Option[Type] {
  if string_equals(name, "eq") {
    Some(CtFn([
      CtInt,
      CtInt
    ], CtBool, false))
  }
  else if string_equals(name, "not") {
    Some(CtFn([
      CtBool
    ], CtBool, false))
  }
  else if string_equals(name, "__to_string") {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else if string_equals(name, "print") {
    Some(CtFn([
      CtString
    ], CtUnit, false))
  }
  else if string_equals(name, "println") {
    Some(CtFn([
      CtString
    ], CtUnit, false))
  }
  else if string_equals(name, "assert") {
    Some(CtFn([
      CtBool
    ], CtUnit, false))
  }
  else if string_equals(name, "throw") {
    Some(CtFn([
      CtString
    ], CtUnknown, true))
  }
  else if string_equals(name, "int_to_double") {
    Some(CtFn([
      CtInt
    ], CtDouble, false))
  }
  else None
}

let lookup_array = (name: String) -> Option[Type] {
  if string_equals(name, "array_length") {
    Some(CtFn([
      CtArray(CtUnknown)
    ], CtInt, false))
  }
  else if string_equals(name, "array_get") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt
    ], CtUnknown, false))
  }
  else if string_equals(name, "array_set") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "array_push") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "array_slice") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtInt,
      CtInt
    ], CtArray(CtUnknown), false))
  }
  else if string_equals(name, "array_concat") {
    Some(CtFn([
      CtArray(CtUnknown),
      CtArray(CtUnknown)
    ], CtArray(CtUnknown), false))
  }
  else None
}

let lookup_bytes = (name: String) -> Option[Type] {
  if string_equals(name, "bytes_new") {
    Some(CtFn(no_params(), CtBytes, false))
  }
  else if string_equals(name, "bytes_length") {
    Some(CtFn([
      CtBytes
    ], CtInt, false))
  }
  else if string_equals(name, "bytes_get") {
    Some(CtFn([
      CtBytes,
      CtInt
    ], CtInt, false))
  }
  else if string_equals(name, "bytes_set") {
    Some(CtFn([
      CtBytes,
      CtInt,
      CtInt
    ], CtUnit, false))
  }
  else if string_equals(name, "bytes_push") {
    Some(CtFn([
      CtBytes,
      CtInt
    ], CtUnit, false))
  }
  else if string_equals(name, "bytes_concat") {
    Some(CtFn([
      CtBytes,
      CtBytes
    ], CtBytes, false))
  }
  else if string_equals(name, "bytes_slice") {
    Some(CtFn([
      CtBytes,
      CtInt,
      CtInt
    ], CtBytes, false))
  }
  else if string_equals(name, "bytes_from_array") {
    Some(CtFn([
      CtArray(CtInt)
    ], CtBytes, false))
  }
  else if string_equals(name, "bytes_to_array") {
    Some(CtFn([
      CtBytes
    ], CtArray(CtInt), false))
  }
  else None
}

let lookup_string1 = (name: String) -> Option[Type] {
  if string_equals(name, "string_concat") {
    Some(CtFn([
      CtString,
      CtString
    ], CtString, false))
  }
  else if string_equals(name, "string_length") {
    Some(CtFn([
      CtString
    ], CtInt, false))
  }
  else if string_equals(name, "string_equals") {
    Some(CtFn([
      CtString,
      CtString
    ], CtBool, false))
  }
  else if string_equals(name, "string_substring") {
    Some(CtFn([
      CtString,
      CtInt,
      CtInt
    ], CtString, false))
  }
  else if string_equals(name, "string_char_at") {
    Some(CtFn([
      CtString,
      CtInt
    ], CtString, false))
  }
  else None
}

let lookup_string2 = (name: String) -> Option[Type] {
  if string_equals(name, "string_index_of") {
    Some(CtFn([
      CtString,
      CtString
    ], CtInt, false))
  }
  else if string_equals(name, "string_contains") {
    Some(CtFn([
      CtString,
      CtString
    ], CtBool, false))
  }
  else if string_equals(name, "string_starts_with") {
    Some(CtFn([
      CtString,
      CtString
    ], CtBool, false))
  }
  else if string_equals(name, "string_ends_with") {
    Some(CtFn([
      CtString,
      CtString
    ], CtBool, false))
  }
  else if string_equals(name, "string_from_char_code") {
    Some(CtFn([
      CtInt
    ], CtString, false))
  }
  else if string_equals(name, "string_char_code_at") {
    Some(CtFn([
      CtString,
      CtInt
    ], CtInt, false))
  }
  else if string_equals(name, "string_last_index_of") {
    Some(CtFn([
      CtString,
      CtString
    ], CtInt, false))
  }
  else None
}

let lookup_array_builder = (name: String) -> Option[Type] {
  if string_equals(name, "array_builder") {
    Some(CtFn(no_params(), CtUnknown, false))
  }
  else if string_equals(name, "array_builder_push") {
    Some(CtFn([
      CtUnknown,
      CtUnknown
    ], CtUnit, false))
  }
  else if string_equals(name, "array_builder_freeze") {
    Some(CtFn([
      CtUnknown
    ], CtArray(CtUnknown), false))
  }
  else None
}

let lookup_string_builder = (name: String) -> Option[Type] {
  if string_equals(name, "string_builder") {
    Some(CtFn(no_params(), CtUnknown, false))
  }
  else if string_equals(name, "string_builder_push") {
    Some(CtFn([
      CtUnknown,
      CtString
    ], CtUnit, false))
  }
  else if string_equals(name, "string_builder_freeze") {
    Some(CtFn([
      CtUnknown
    ], CtString, false))
  }
  else None
}

export let lookup_builtin = (name: String) -> Option[Type] {
  match lookup_array(name) {
    Some(t) => Some(t),
    None => match lookup_array_builder(name) {
      Some(t) => Some(t),
      None => match lookup_string1(name) {
        Some(t) => Some(t),
        None => match lookup_string2(name) {
          Some(t) => Some(t),
          None => match lookup_string_builder(name) {
            Some(t) => Some(t),
            None => match lookup_bytes(name) {
              Some(t) => Some(t),
              None => match lookup_map(name) {
                Some(t) => Some(t),
                None => lookup_misc(name)
              }
            }
          }
        }
      }
    }
  }
}
