//# Imports

import ./core/ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

//# Functions

// #287 follow-up / B: ELoop lowering pass.
//
// The selfhost parser historically eager-desugared parameterized
// `loop(i = 10, acc = 0) { ... }` into a `letmut + while` form at
// parse time.  That worked for codegen (which only understands
// while+letmut+break+continue) but destroyed the AST roundtrip:
// `parse_print("loop (i = 10, ...) { ... }")` returned the desugared
// `{ let mut __loop_result = 0; ... }` form, breaking tests like
// `parser_loop_test.vibe:"parse parameterized loop"` that expect the
// original `loop (i = 10, ...) { ... }` syntax to be preserved.
//
// Fix: the parser now returns `ELoop(params, raw_body)` with
// break/continue still in their original form.  `compile_source`
// (and the other entry points in `entry/`) call `lower_loop_stmts`
// before codegen to re-apply the original desugaring — producing
// exactly the same AST that the parser used to emit directly, but
// AFTER print_expr has had a chance to see the ELoop node.

// Transform break(val) and continue(args) inside a loop body for
// desugaring. Mirrors parser_expr_primary.vibe:desugar_loop_body so
// the lowered loop has the same semantics as the eager-desugared form.
// break(val) → { __loop_result = val; break }
// continue(a, b) → { let __lt0 = a; ...; p0 = __lt0; ...; continue }
let rec desugar_loop_body_for_lower = (expr: Expr, param_names: Array[String]) -> Expr {
  match expr {
    EBreak(opt) => match opt {
      Some(val) => EAssign("__loop_result", desugar_loop_body_for_lower(val, param_names), EBreak(None)),
      None => EBreak(None)
    },
    EContinue(args) => {
      if Array::length(args) == 0 {
        EContinue(args)
      } else {
        let nargs = Array::length(args)
        let nparams = Array::length(param_names)
        if nargs > nparams {
          EContinue(args)
        } else {
          let mut result = EContinue(Array::slice([EUnit], 0, 0))
          let mut ci = nargs - 1
          while ci >= 0 {
            result = EAssign(Array::get(param_names, ci), EIdent(String::concat("__lt", __to_string(ci))), result)
            ci = ci - 1
          }
          let mut ci2 = nargs - 1
          while ci2 >= 0 {
            result = ELet(String::concat("__lt", __to_string(ci2)), desugar_loop_body_for_lower(Array::get(args, ci2), param_names), result)
            ci2 = ci2 - 1
          }
          result
        }
      }
    },
    // Do NOT recurse into nested ELoop/EWhile/EFn: their break/continue
    // target the inner loop/function, not the outer one we're lowering.
    EWhile(_, _) => expr,
    ELoop(_, _) => expr,
    EFn(_, _, _, _, _, _) => expr,
    EIf(c, t, e) => EIf(desugar_loop_body_for_lower(c, param_names), desugar_loop_body_for_lower(t, param_names), desugar_loop_body_for_lower(e, param_names)),
    ELet(n, v, b) => ELet(n, desugar_loop_body_for_lower(v, param_names), desugar_loop_body_for_lower(b, param_names)),
    ELetMut(n, v, b) => ELetMut(n, desugar_loop_body_for_lower(v, param_names), desugar_loop_body_for_lower(b, param_names)),
    ESeq(a, b) => ESeq(desugar_loop_body_for_lower(a, param_names), desugar_loop_body_for_lower(b, param_names)),
    EAssign(n, v, c) => EAssign(n, desugar_loop_body_for_lower(v, param_names), desugar_loop_body_for_lower(c, param_names)),
    // EMatch/EHandle: pass through unchanged. Limitation: break/continue
    // inside match/handle arms won't be desugared. Matches the
    // parser_expr_primary.vibe behavior before the split.
    EMatch(_, _) => expr,
    EHandle(_, _) => expr,
    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body_for_lower(l, param_names), desugar_loop_body_for_lower(r, param_names)),
    ECall(_, _) => expr,
    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body_for_lower(v, param_names), desugar_loop_body_for_lower(b, param_names)),
    EThrow(e) => EThrow(desugar_loop_body_for_lower(e, param_names)),
    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body_for_lower(e, param_names)),
    EDot(obj, field) => EDot(desugar_loop_body_for_lower(obj, param_names), field),
    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body_for_lower(v, param_names), desugar_loop_body_for_lower(c, param_names)),
    _ => expr
  }
}

// Extract parameter names from an ELoop params array.
let loop_param_names = (params: Array[(String, Expr)]) -> Array[String] {
  let out = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < Array::length(params) {
    let (name, _) = Array::get(params, i)
    Array::push(out, name)
    i = i + 1
  }
  out
}

// Build the parameter-initializer outer wrapper:
//   `ELetMut(p0, init0, ELetMut(p1, init1, ... inner))`
let wrap_loop_params = (params: Array[(String, Expr)], inner: Expr) -> Expr {
  let mut wrapped = inner
  let mut wi = Array::length(params) - 1
  while wi >= 0 {
    let (pname, pinit) = Array::get(params, wi)
    wrapped = ELetMut(pname, pinit, wrapped)
    wi = wi - 1
  }
  wrapped
}

// Main lowering walker: recursively descends into every expression
// and rewrites `ELoop(params, body)` into
//   `ELetMut(p0, init0, ... ELetMut(__loop_result, 0, ESeq(EWhile(true, desugared_body), EIdent("__loop_result"))) ...)`
// matching the historical eager-desugared form emitted by the parser.
export let rec lower_loop_expr = (expr: Expr) -> Expr {
  match expr {
    EInt(_) => expr,
    EFloat(_) => expr,
    EString(_) => expr,
    EBool(_) => expr,
    EIdent(_) => expr,
    EUnit => expr,
    EBreak(opt) => match opt {
      Some(inner) => EBreak(Some(lower_loop_expr(inner))),
      None => expr
    },
    EContinue(args) => {
      let out = Array::slice([EUnit], 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lower_loop_expr(Array::get(args, i)))
        i = i + 1
      }
      EContinue(out)
    },
    EThrow(e) => EThrow(lower_loop_expr(e)),
    EUnaryOp(op, e) => EUnaryOp(op, lower_loop_expr(e)),
    ETuple(items) => {
      let out = Array::slice([EUnit], 0, 0)
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lower_loop_expr(Array::get(items, i)))
        i = i + 1
      }
      ETuple(out)
    },
    EArray(items) => {
      let out = Array::slice([EUnit], 0, 0)
      let mut i = 0
      while i < Array::length(items) {
        Array::push(out, lower_loop_expr(Array::get(items, i)))
        i = i + 1
      }
      EArray(out)
    },
    ERecord(fields) => {
      let out = Array::slice([("", EUnit)], 0, 0)
      let mut i = 0
      while i < Array::length(fields) {
        let (fname, fval) = Array::get(fields, i)
        Array::push(out, (fname, lower_loop_expr(fval)))
        i = i + 1
      }
      ERecord(out)
    },
    EMap(fields) => {
      let out = Array::slice([("", EUnit)], 0, 0)
      let mut i = 0
      while i < Array::length(fields) {
        let (k, v) = Array::get(fields, i)
        Array::push(out, (k, lower_loop_expr(v)))
        i = i + 1
      }
      EMap(out)
    },
    EIf(cond, then_e, else_e) => EIf(lower_loop_expr(cond), lower_loop_expr(then_e), lower_loop_expr(else_e)),
    ELet(name, val, body) => ELet(name, lower_loop_expr(val), lower_loop_expr(body)),
    ELetRec(name, val, body) => ELetRec(name, lower_loop_expr(val), lower_loop_expr(body)),
    ELetMut(name, val, body) => ELetMut(name, lower_loop_expr(val), lower_loop_expr(body)),
    EAssign(name, val, body) => EAssign(name, lower_loop_expr(val), lower_loop_expr(body)),
    EAssignOp(name, op, val, body) => EAssignOp(name, op, lower_loop_expr(val), lower_loop_expr(body)),
    ESeq(a, b) => ESeq(lower_loop_expr(a), lower_loop_expr(b)),
    EBinOp(op, l, r) => EBinOp(op, lower_loop_expr(l), lower_loop_expr(r)),
    ECall(callee, args) => {
      let out = Array::slice([EUnit], 0, 0)
      let mut i = 0
      while i < Array::length(args) {
        Array::push(out, lower_loop_expr(Array::get(args, i)))
        i = i + 1
      }
      ECall(lower_loop_expr(callee), out)
    },
    EMatch(scr, arms) => {
      let out = Array::slice([(PWild, EUnit)], 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, body) = Array::get(arms, i)
        Array::push(out, (pat, lower_loop_expr(body)))
        i = i + 1
      }
      EMatch(lower_loop_expr(scr), out)
    },
    EHandle(body_expr, arms) => {
      let out = Array::slice([(PWild, EUnit)], 0, 0)
      let mut i = 0
      while i < Array::length(arms) {
        let (pat, arm_body) = Array::get(arms, i)
        Array::push(out, (pat, lower_loop_expr(arm_body)))
        i = i + 1
      }
      EHandle(lower_loop_expr(body_expr), out)
    },
    EWhile(cond, body) => EWhile(lower_loop_expr(cond), lower_loop_expr(body)),
    ELoop(params, body) => {
      // Lower nested loops in the body first.
      let inner_lowered = lower_loop_expr(body)
      // Extract param names for break/continue rewriting.
      let pnames = loop_param_names(params)
      // Desugar break(val)/continue(args) inside the body to assign +
      // bare break/continue.
      let desugared_body = desugar_loop_body_for_lower(inner_lowered, pnames)
      // Build the while+letmut wrapper around the desugared body.
      let while_expr = EWhile(EBool(true), desugared_body)
      let result = ELetMut("__loop_result", EInt(0),
        ESeq(while_expr, EIdent("__loop_result")))
      // Bind each param as a letmut around the whole thing, with
      // its (lowered) init expression.
      let lowered_params = Array::slice([("", EUnit)], 0, 0)
      let mut pi = 0
      while pi < Array::length(params) {
        let (pname, pinit) = Array::get(params, pi)
        Array::push(lowered_params, (pname, lower_loop_expr(pinit)))
        pi = pi + 1
      }
      wrap_loop_params(lowered_params, result)
    },
    EForIn(name, idx, iter, body) => EForIn(name, idx, lower_loop_expr(iter), lower_loop_expr(body)),
    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, lower_loop_expr(body)),
    EDot(obj, field) => EDot(lower_loop_expr(obj), field),
    ELabeledArg(label, name, e) => ELabeledArg(label, name, lower_loop_expr(e)),
    ESpread(e) => ESpread(lower_loop_expr(e)),
    EStringInterp(_) => expr
  }
}

// Lower a single top-level statement.
export let rec lower_loop_stmt = (stmt: Stmt) -> Stmt {
  match stmt {
    SLet(exported, is_rec, name, ty, body) => SLet(exported, is_rec, name, ty, lower_loop_expr(body)),
    SLetMut(name, ty, body) => SLetMut(name, ty, lower_loop_expr(body)),
    STest(name, body) => STest(name, lower_loop_expr(body)),
    SBench(name, body) => SBench(name, lower_loop_expr(body)),
    SExpr(e) => SExpr(lower_loop_expr(e)),
    SModule(exported, name, stmts) => SModule(exported, name, for s in stmts {
      lower_loop_stmt(s)
    }),
    // Type-level and import/export statements have no expressions
    // containing ELoop.
    SEnum(_, _, _) => stmt,
    SSuberror(_, _, _) => stmt,
    SEffectDef(_, _, _, _) => stmt,
    SStruct(_, _, _) => stmt,
    STypeAlias(_, _, _) => stmt,
    STrait(_, _, _) => stmt,
    SImpl(_, _, _, _) => stmt,
    SExternLet(_, _) => stmt,
    SImport(_, _) => stmt,
    SExport(_) => stmt,
    SReExport(_, _) => stmt,
    SAliasDecl(_, _) => stmt,
    SLetPat(pat, expr) => SLetPat(pat, lower_loop_expr(expr))
  }
}

// Entry point: lower all ELoops in a program's statement list.
export let lower_loop_stmts = (stmts: Array[Stmt]) -> Array[Stmt] {
  for s in stmts {
    lower_loop_stmt(s)
  }
}
