//# Imports

import ./selfhost_codegen_fingerprint.vibe {
  selfhost_codegen_fingerprint
}

import ../module_graph_path.vibe {
  resolution_env_seed
}

//# Functions

export let compact_string_fingerprint: (String) -> String = (source) -> {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

// Cache key version tag. TWO independent reasons to bump it (#630):
//  - cache FORMAT change (how `.hex` / `.tsv` entries are serialized): bump `vNN`.
//  - CODEGEN / wasm-ABI change (the SAME source now compiles to DIFFERENT wasm):
//    bump `cgNN`. The artifact cache is keyed by the source fingerprint only, so
//    without a codegen segment a codegen change returns a STALE compiled wasm for
//    unchanged source. Bump `cg` on any change to emitted wasm / runtime ABI.
//    The `cg` segment is `selfhost_codegen_fingerprint()` — a build-time hash of
//    all compiler source files (selfhost_sources_manifest.tsv), regenerated with
//    the bundle. So any codegen-source change automatically changes the key and
//    invalidates stale artifacts; no manual bump needed (#630). `vNN` is still a
//    manual knob for pure cache-FORMAT changes that don't change the source hash.
let persistent_cache_version_tag: () -> String = () -> {
  // v11 (#632): artifact cache switched from hex text (`.hex`) to raw binary
  // (`.bin`, via Fs::write_bytes / Fs::read_bytes) — a cache FORMAT change, so
  // the manual `vNN` knob is bumped. Old `.hex` entries are now unreferenced
  // (different key + suffix) and reclaimable via `pkf run cache-clean` (#631).
  String::concat("v11|cg-", selfhost_codegen_fingerprint())
}

let stable_cache_path: (String, String, String) -> String = (prefix, seed, suffix) -> {
  let raw = compact_string_fingerprint(String::concat("persistent-cache-", String::concat(persistent_cache_version_tag(), String::concat("|", seed))))
  // O(N) build via StringBuilder; the previous `token = String::concat(token, ...)`
  // per char was O(N²) over the fingerprint length (issue #366).
  let token_sb = StringBuilder::new()
  let mut i = 0
  while i < String::length(raw) {
    let c = String::char_code_at(raw, i)
    let piece = if c == 58 {
      "_"
    } else {
      String::from_char_code(c)
    }
    StringBuilder::push(token_sb, piece)
    i = i + 1
  }
  let token = StringBuilder::freeze(token_sb)
  String::concat("_build/vibe_", String::concat(prefix, String::concat("_", String::concat(token, suffix))))
}

let build_sources_fingerprint: (Array[(String, String)]) -> String = (sources) -> {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, i)
    let next = String::concat(acc, String::concat("|", compact_string_fingerprint(source)))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let persistent_artifact_cache_path: (String, String, String) -> String = (kind, entry_name, fingerprint) -> {
  stable_cache_path("selfhost_artifact", String::concat(kind, String::concat("|", String::concat(entry_name, String::concat("|", fingerprint)))), ".bin")
}

export let store_persistent_artifact: (String, String, String, Bytes) -> Unit with { Error, Fs } = (kind, entry_name, fingerprint, bytes) -> {
  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)
  // #632: store the compiled wasm RAW. Previously hex-encoded text (`.hex`),
  // doubling disk and paying encode/decode each store/load; the artifact is a
  // wasm binary (magic begins 0x00), so raw needs a byte-exact reader —
  // Fs::read_bytes (load below), the inverse of this Fs::write_bytes.
  Fs::write_bytes(path, bytes)
}

export let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {
  stable_cache_path("selfhost_dep_list", String::concat(path, String::concat("|", String::concat(source_fingerprint, resolution_env_seed()))), ".tsv")
}

export let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {
  stable_cache_path("selfhost_type_env_v2", fingerprint, ".tsv")
}

export let build_source_groups_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, i)
    let fingerprint = build_sources_fingerprint(sources)
    let next = String::concat(acc, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let normalize_persistent_cache_text: (String) -> String = (text) -> {
  let len = String::length(text)
  let mut start = 0
  while start < len && String::char_code_at(text, start) == 0 {
    start = start + 1
  }
  if start == 0 {
    text
  } else {
    text[start: len]
  }
}

export let load_persistent_artifact: (String, String, String) -> Option[Bytes] with { Error, Fs } = (kind, entry_name, fingerprint) -> {
  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    // #632: read the raw wasm back byte-exact. No hex decode and no leading-NUL
    // normalize (that was a workaround for the utf8 read_file text path; raw
    // Fs::read_bytes returns the file bytes verbatim, incl. the 0x00 wasm magic).
    Some(Fs::read_bytes(path))
  }
}

export let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {
  // #758 review (P1): the cached artifact is a RESOLVED graph — the external
  // lib roots and the freeze switch (#751) are part of its identity, or a
  // graph resolved without pins replays under VIBE_REQUIRE_PINS=1 (and a
  // VIBE_LIB change replays the previous roots). Same seed on the dep-list
  // and module-header caches below.
  stable_cache_path("selfhost_source_list", String::concat(entry_path, resolution_env_seed()), ".tsv")
}

export let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {
  stable_cache_path("selfhost_source_groups", String::concat(entry_path, resolution_env_seed()), ".tsv")
}

export let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {
  stable_cache_path("selfhost_module_header_v2", String::concat(path, String::concat("|", String::concat(source_fingerprint, resolution_env_seed()))), ".tsv")
}

export let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {
  stable_cache_path("selfhost_manifest_headers", entry_path, ".tsv")
}

export let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {
  stable_cache_path("selfhost_leaf_fp_v2", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}

let build_sources_fingerprint_from_compact_fingerprints: (Array[String]) -> String = (source_fingerprints) -> {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(source_fingerprints) {
    let next = String::concat(acc, String::concat("|", Array::get(source_fingerprints, i)))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let build_source_groups_fingerprint_from_compact_fingerprints: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, specs) = Array::get(groups, i)
    let source_fingerprints = Array::slice([
      ""
    ], 0, 0)
    let mut j = 0
    while j < Array::length(specs) {
      let (_, source_fingerprint) = Array::get(specs, j)
      Array::push(source_fingerprints, source_fingerprint)
      j = j + 1
    }
    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)
    let next = String::concat(acc, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String) -> String = (source_groups_fingerprint, entry_name) -> {
  compact_string_fingerprint(String::concat("fs-compile|", String::concat(source_groups_fingerprint, String::concat("|", entry_name))))
}

export let build_fs_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String) -> String = (source_groups, entry_name) -> {
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)
}

export let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String, String) -> String = (source_groups_fingerprint, entry_name, mode) -> {
  compact_string_fingerprint(String::concat("file-compile|", String::concat(source_groups_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode))))))
}

export let build_file_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String, String) -> String = (source_groups, entry_name, mode) -> {
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)
}

export let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {
  compact_string_fingerprint(String::concat("fs-compile-module|", source_groups_fingerprint))
}

export let build_fs_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {
  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))
}

export let build_file_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {
  compact_string_fingerprint(String::concat("file-compile-module|", source_groups_fingerprint))
}

export let build_file_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {
  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))
}
