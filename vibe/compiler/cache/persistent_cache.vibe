//# Functions

let bytes_to_hex_digit = (n: Int) -> String {
  if n < 10 {
    __to_string(n)
  } else if n == 10 {
    "a"
  } else if n == 11 {
    "b"
  } else if n == 12 {
    "c"
  } else if n == 13 {
    "d"
  } else if n == 14 {
    "e"
  } else {
    "f"
  }
}

let bytes_to_hex = (bytes: Bytes) -> String {
  // Use StringBuilder to keep this O(N): the previous
  // `out = String::concat(out, ...)` per nibble was O(N^2) (each
  // concat copies the entire prefix accumulated so far).
  let len = Bytes::length(bytes)
  let sb = StringBuilder::new()
  let mut i = 0
  while i < len {
    let byte = Bytes::get(bytes, i)
    let hi = byte / 16
    let lo = byte % 16
    StringBuilder::push(sb, bytes_to_hex_digit(hi))
    StringBuilder::push(sb, bytes_to_hex_digit(lo))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

let nibble_from_hex_char = (c: Int) -> Int with { Error } {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    throw("invalid hex digit")
  }
}

let hex_to_bytes = (hex: String) -> Bytes with { Error } {
  let len = String::length(hex)
  if len % 2 != 0 {
    throw("invalid hex length")
  } else {
    let out = Bytes::new()
    let mut i = 0
    while i < len {
      let hi = nibble_from_hex_char(String::char_code_at(hex, i))
      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))
      Bytes::push(out, hi * 16 + lo)
      i = i + 2
    }
    out
  }
}

export let compact_string_fingerprint = (source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  String::concat(__to_string(len), String::concat(":", String::concat(__to_string(h1), String::concat(":", __to_string(h2)))))
}

let stable_cache_path = (prefix: String, seed: String, suffix: String) -> String {
  let raw = compact_string_fingerprint(String::concat("persistent-cache-v3|", seed))
  let mut token = ""
  let mut i = 0
  while i < String::length(raw) {
    let c = String::char_code_at(raw, i)
    let piece = if c == 58 {
      "_"
    } else {
      String::from_char_code(c)
    }
    token = String::concat(token, piece)
    i = i + 1
  }
  String::concat("_build/vibe_", String::concat(prefix, String::concat("_", String::concat(token, suffix))))
}

let build_sources_fingerprint = (sources: Array[(String, String)]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, i)
    let next = String::concat(acc, String::concat("|", compact_string_fingerprint(source)))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let persistent_artifact_cache_path = (kind: String, entry_name: String, fingerprint: String) -> String {
  stable_cache_path("selfhost_artifact", String::concat(kind, String::concat("|", String::concat(entry_name, String::concat("|", fingerprint)))), ".hex")
}

export let store_persistent_artifact = (kind: String, entry_name: String, fingerprint: String, bytes: Bytes) -> Unit with { Error, Fs } {
  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)
  Fs::write_file(path, bytes_to_hex(bytes))
}

export let persistent_dep_list_cache_path = (path: String, source_fingerprint: String) -> String {
  stable_cache_path("selfhost_dep_list", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}

export let persistent_type_env_cache_path = (fingerprint: String) -> String {
  stable_cache_path("selfhost_type_env_v2", fingerprint, ".tsv")
}

export let build_source_groups_fingerprint = (groups: Array[(String, Array[(String, String)])]) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, i)
    let fingerprint = build_sources_fingerprint(sources)
    let next = String::concat(acc, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let normalize_persistent_cache_text = (text: String) -> String {
  let len = String::length(text)
  let mut start = 0
  while start < len && String::char_code_at(text, start) == 0 {
    start = start + 1
  }
  if start == 0 {
    text
  } else {
    text[start: len]
  }
}

export let load_persistent_artifact = (kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error, Fs } {
  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    Some(hex_to_bytes(normalize_persistent_cache_text(Fs::read_file(path))))
  }
}

export let persistent_source_list_cache_path = (entry_path: String) -> String {
  stable_cache_path("selfhost_source_list", entry_path, ".tsv")
}

export let persistent_source_group_cache_path = (entry_path: String) -> String {
  stable_cache_path("selfhost_source_groups", entry_path, ".tsv")
}

export let persistent_module_header_cache_path = (path: String, source_fingerprint: String) -> String {
  stable_cache_path("selfhost_module_header_v2", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}

export let persistent_manifest_header_cache_path = (entry_path: String) -> String {
  stable_cache_path("selfhost_manifest_headers", entry_path, ".tsv")
}

export let persistent_leaf_fingerprint_cache_path = (path: String, source_fingerprint: String) -> String {
  stable_cache_path("selfhost_leaf_fp_v2", String::concat(path, String::concat("|", source_fingerprint)), ".tsv")
}

let build_sources_fingerprint_from_compact_fingerprints = (source_fingerprints: Array[String]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(source_fingerprints) {
    let next = String::concat(acc, String::concat("|", Array::get(source_fingerprints, i)))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let build_source_groups_fingerprint_from_compact_fingerprints = (groups: Array[(String, Array[(String, String)])]) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, specs) = Array::get(groups, i)
    let source_fingerprints = Array::slice([
      ""
    ], 0, 0)
    let mut j = 0
    while j < Array::length(specs) {
      let (_, source_fingerprint) = Array::get(specs, j)
      Array::push(source_fingerprints, source_fingerprint)
      j = j + 1
    }
    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)
    let next = String::concat(acc, String::concat("|", String::concat(group_name, String::concat("=", fingerprint))))
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint = (source_groups_fingerprint: String, entry_name: String) -> String {
  compact_string_fingerprint(String::concat("fs-compile|", String::concat(source_groups_fingerprint, String::concat("|", entry_name))))
}

export let build_fs_compile_wasi_artifact_fingerprint = (source_groups: Array[(String, Array[(String, String)])], entry_name: String) -> String {
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)
}

export let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint = (source_groups_fingerprint: String, entry_name: String, mode: String) -> String {
  compact_string_fingerprint(String::concat("file-compile|", String::concat(source_groups_fingerprint, String::concat("|", String::concat(entry_name, String::concat("|", mode))))))
}

export let build_file_compile_wasi_artifact_fingerprint = (source_groups: Array[(String, Array[(String, String)])], entry_name: String, mode: String) -> String {
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)
}

export let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint = (source_groups_fingerprint: String) -> String {
  compact_string_fingerprint(String::concat("fs-compile-module|", source_groups_fingerprint))
}

export let build_fs_compile_module_artifact_fingerprint = (source_groups: Array[(String, Array[(String, String)])]) -> String {
  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))
}

export let build_file_compile_module_artifact_fingerprint_from_group_fingerprint = (source_groups_fingerprint: String) -> String {
  compact_string_fingerprint(String::concat("file-compile-module|", source_groups_fingerprint))
}

export let build_file_compile_module_artifact_fingerprint = (source_groups: Array[(String, Array[(String, String)])]) -> String {
  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))
}
