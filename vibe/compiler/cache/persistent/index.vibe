//# Functions

let string_to_bytes = (s: String) -> Bytes {
  let out = Array::slice([
    0
  ], 0, 0)
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Array::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  Bytes::from_array(out)
}

let bytes_to_hex_digit = (n: Int) -> String {
  if n < 10 {
    __to_string(n)
  } else if n == 10 {
    "a"
  } else if n == 11 {
    "b"
  } else if n == 12 {
    "c"
  } else if n == 13 {
    "d"
  } else if n == 14 {
    "e"
  } else {
    "f"
  }
}

let nibble_from_hex_char = (c: Int) -> Int with { Error } {
  if c >= 48 && c <= 57 {
    c - 48
  } else if c >= 97 && c <= 102 {
    c - 87
  } else if c >= 65 && c <= 70 {
    c - 55
  } else {
    throw("invalid hex digit")
  }
}

let bytes_to_hex = (bytes: Bytes) -> String {
  let len = Bytes::length(bytes)
  let mut i = 0
  let mut out = ""
  while i < len {
    let byte = Bytes::get(bytes, i)
    let hi = byte / 16
    let lo = byte % 16
    out = "\{out}\{bytes_to_hex_digit(hi)}"
    out = "\{out}\{bytes_to_hex_digit(lo)}"
    i = i + 1
  }
  out
}

let hex_to_bytes = (hex: String) -> Bytes with { Error } {
  let len = String::length(hex)
  if len % 2 != 0 {
    throw("invalid hex length")
  } else {
    let out = Array::slice([0], 0, 0)
    let mut i = 0
    while i < len {
      let hi = nibble_from_hex_char(String::char_code_at(hex, i))
      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))
      Array::push(out, hi * 16 + lo)
      i = i + 2
    }
    Bytes::from_array(out)
  }
}

export let compact_string_fingerprint = (source: String) -> String {
  let mod1 = 2147483647
  let mod2 = 2147483629
  let step1 = 131
  let step2 = 65599
  let len = String::length(source)
  let mut h1 = 17
  let mut h2 = 29
  let mut i = 0
  while i < len {
    let c = String::char_code_at(source, i)
    h1 = (h1 * step1 + c + 1) % mod1
    h2 = (h2 * step2 + c + i + 1) % mod2
    i = i + 1
  }
  "\{__to_string(len)}:\{__to_string(h1)}:\{__to_string(h2)}"
}

export let normalize_persistent_cache_text = (text: String) -> String {
  let len = String::length(text)
  let mut start = 0
  while start < len && String::char_code_at(text, start) == 0 {
    start = start + 1
  }
  if start == 0 {
    text
  } else {
    String::substring(text, start, len)
  }
}

let build_sources_fingerprint = (sources: Array[(String, String)]) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(sources) {
    let (_, source) = Array::get(sources, i)
    let next = "\{acc}|\{compact_string_fingerprint(source)}"
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

let build_sources_fingerprint_from_compact_fingerprints = (
  source_fingerprints: Array[String]
) -> String {
  let mut acc = "merged"
  let mut i = 0
  while i < Array::length(source_fingerprints) {
    let next = "\{acc}|\{Array::get(source_fingerprints, i)}"
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let build_source_groups_fingerprint = (groups: Array[(String, Array[(String, String)])]) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, i)
    let fingerprint = build_sources_fingerprint(sources)
    let next = "\{acc}|\{group_name}=\{fingerprint}"
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

export let build_source_groups_fingerprint_from_compact_fingerprints = (
  groups: Array[(String, Array[(String, String)])]
) -> String {
  let mut acc = "merged-groups"
  let mut i = 0
  while i < Array::length(groups) {
    let (group_name, specs) = Array::get(groups, i)
    let source_fingerprints = Array::slice([""], 0, 0)
    let mut j = 0
    while j < Array::length(specs) {
      let (_, source_fingerprint) = Array::get(specs, j)
      Array::push(source_fingerprints, source_fingerprint)
      j = j + 1
    }
    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)
    let next = "\{acc}|\{group_name}=\{fingerprint}"
    acc = compact_string_fingerprint(next)
    i = i + 1
  }
  acc
}

let stable_cache_path = (prefix: String, seed: String, suffix: String) -> String {
  let raw = compact_string_fingerprint("persistent-cache-v3|\{seed}")
  let mut token = ""
  let mut i = 0
  while i < String::length(raw) {
    let c = String::char_code_at(raw, i)
    token = "\{token}\{if c == 58 {
        "_"
      } else {
        String::from_char_code(c)
      }}"
    i = i + 1
  }
  "_build/vibe_\{prefix}_\{token}\{suffix}"
}

export let persistent_source_list_cache_path = (entry_path: String) -> String {
  stable_cache_path("selfhost_source_list", entry_path, ".tsv")
}

export let persistent_source_group_cache_path = (entry_path: String) -> String {
  stable_cache_path("selfhost_source_groups", entry_path, ".tsv")
}

export let persistent_manifest_header_cache_path = (entry_path: String) -> String {
