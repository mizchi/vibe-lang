  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(
    build_source_groups_fingerprint(source_groups)
  )
}

export let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint = (
  source_groups_fingerprint: String
) -> String {
  compact_string_fingerprint(
    "fs-compile-module|\{source_groups_fingerprint}"
  )
}

export let persistent_artifact_cache_path = (
  kind: String,
  entry_name: String,
  fingerprint: String
) -> String {
  stable_cache_path(
    "selfhost_artifact",
    "\{kind}|\{entry_name}|\{fingerprint}",
    ".hex"
  )
}

export let load_persistent_artifact = (
  kind: String,
  entry_name: String,
  fingerprint: String
) -> Option[Bytes] with { Error, Fs } {
  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)
  if !(Fs::exists(path)) {
    None
  } else {
    Some(hex_to_bytes(normalize_persistent_cache_text(Fs::read_file(path))))
  }
}

export let store_persistent_artifact = (
  kind: String,
  entry_name: String,
  fingerprint: String,
  bytes: Bytes
) -> Unit with { Error, Fs } {
  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)
  Fs::write_file(path, bytes_to_hex(bytes))
}
