export let build_file_compile_wasi_artifact_fingerprint = (
  source_groups: Array[(String, Array[(String, String)])],
  entry_name: String,
  mode: String
) -> String {
  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(
    build_source_groups_fingerprint(source_groups),
    entry_name,
    mode
  )
}

export let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint = (
  source_groups_fingerprint: String,
  entry_name: String,
  mode: String
) -> String {
  compact_string_fingerprint(
    "file-compile|\{source_groups_fingerprint}|\{entry_name}|\{mode}"
  )
}

export let build_file_compile_module_artifact_fingerprint = (
  source_groups: Array[(String, Array[(String, String)])]
) -> String {
  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(
    build_source_groups_fingerprint(source_groups)
  )
}

export let build_file_compile_module_artifact_fingerprint_from_group_fingerprint = (
  source_groups_fingerprint: String
) -> String {
  compact_string_fingerprint(
    "file-compile-module|\{source_groups_fingerprint}"
  )
}

export let build_fs_compile_wasi_artifact_fingerprint = (
  source_groups: Array[(String, Array[(String, String)])],
  entry_name: String
) -> String {
  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(
    build_source_groups_fingerprint(source_groups),
    entry_name
  )
}

export let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint = (
  source_groups_fingerprint: String,
  entry_name: String
) -> String {
  compact_string_fingerprint(
    "fs-compile|\{source_groups_fingerprint}|\{entry_name}"
  )
}

export let build_fs_compile_module_artifact_fingerprint = (
  source_groups: Array[(String, Array[(String, String)])]
