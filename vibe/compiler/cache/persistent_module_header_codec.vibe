//# Functions

let has_prefix = (line: String, prefix: String) -> Bool {
  let prefix_len = String::length(prefix)
  if String::length(line) < prefix_len {
    false
  } else {
    let mut ok = true
    let mut i = 0
    while ok && i < prefix_len {
      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)
      i = i + 1
    }
    ok
  }
}

let strip_trailing_cr = (line: String) -> String {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0: len - 1]
    } else {
      line
    }
  } else {
    line
  }
}

let parse_persistent_module_header_line = (
  deps: Array[String],
  exports: Array[String],
  line: String,
  saw_version: Bool
) -> Bool with { Error } {
  if String::length(line) == 0 {
    saw_version
  } else if has_prefix(line, "version\t") {
    let value = line[8: String::length(line)]
    if !(value == "1") {
      throw("invalid persistent module header version")
    }
    true
  } else if has_prefix(line, "dep\t") {
    let value = line[4: String::length(line)]
    if String::length(value) == 0 {
      throw("invalid persistent module header dep row")
    } else {
      Array::push(deps, value)
      saw_version
    }
  } else if has_prefix(line, "export\t") {
    let value = line[7: String::length(line)]
    if String::length(value) == 0 {
      throw("invalid persistent module header export row")
    } else {
      Array::push(exports, value)
      saw_version
    }
  } else {
    throw(String::concat("invalid persistent module header row: ", line))
  }
}

export let persistent_module_header_text = (deps: Array[String], exports: Array[String]) -> String {
  // O(N) via StringBuilder; previously `out = String::concat(out, ...)`
  // over both `deps` and `exports` was O((D+E)²).
  let buf = StringBuilder::new()
  StringBuilder::push(buf, "version\t1\n")
  let mut i = 0
  while i < Array::length(deps) {
    StringBuilder::push(buf, "dep\t")
    StringBuilder::push(buf, Array::get(deps, i))
    StringBuilder::push(buf, "\n")
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(exports) {
    StringBuilder::push(buf, "export\t")
    StringBuilder::push(buf, Array::get(exports, j))
    StringBuilder::push(buf, "\n")
    j = j + 1
  }
  StringBuilder::freeze(buf)
}

export let parse_persistent_module_header_text = (raw: String) -> (Array[String], Array[String]) with { Error } {
  let deps = Array::slice([
    ""
  ], 0, 0)
  let exports = Array::slice([
    ""
  ], 0, 0)
  let mut saw_version = false
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  while i < len {
    if String::char_code_at(raw, i) == 10 {
      let line = strip_trailing_cr(raw[line_start: i])
      saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)
      line_start = i + 1
    }
    i = i + 1
  }
  let line = strip_trailing_cr(raw[line_start: len])
  saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)
  if !saw_version {
    throw("missing persistent module header version")
  } else {
    (deps, exports)
  }
}
