//# Path helpers

let source_lookup: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    match found {
      Some(_) => (),
      None => {
        let (p, src) = Array::get(sources, i)
        if p == path_key {
          found = Some(src)
        }
      }
    }
    i = i + 1
  }
  found
}

let resolve_path_in_sources: (String, String, Array[(String, String)]) -> Option[(String, String)] = (base_dir, raw_path, sources) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = None
  while i < Array::length(candidates) {
    match found {
      Some(_) => (),
      None => {
        let candidate = Array::get(candidates, i)
        match source_lookup(sources, candidate) {
          Some(source) => {
            found = Some((candidate, source))
          }
          None => ()
        }
      }
    }
    i = i + 1
  }
  found
}

let resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  while i < Array::length(candidates) {
    if found == "" {
      let candidate = Array::get(candidates, i)
      let candidate_exists = perform Fs::Exists(candidate)
      if candidate_exists {
        found = candidate
      }
    }
    i = i + 1
  }
  if found == "" {
    Array::get(candidates, 0)
  } else {
    found
  }
}

// #740: normalized for the same reason as manifest_sources' join_path —
// manifest rows outside the compiler dir must key under the import-resolved
// spelling.
let join_path: (String, String) -> String = (base_dir, rel_path) -> {
  if base_dir == "" {
    normalize_path(rel_path)
  } else {
    normalize_path(String::concat(base_dir, String::concat("/", rel_path)))
  }
}

let strip_trailing_cr: (String) -> String = (line) -> {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0:len - 1]
    } else {
      line
    }
  } else {
    line
  }
}


let string_to_bytes: (String) -> Bytes = (s) -> {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

let special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {
  if String::ends_with(path, "selfhost_sources_bundle.vibe") {
    Some((
      Array::slice([""], 0, 0),
      ["selfhost_sources", "selfhost_source_groups"]
    ))
  } else {
    None
  }
}

let split_tsv_fields: (String) -> Array[String] = (line) -> {
  let fields = Array::slice([""], 0, 0)
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start:i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}

let header_value_separator = String::from_char_code(31)

let join_header_values: (Array[String]) -> String = (values) -> {
  // O(N) via StringBuilder (previous accumulator was O(N^2)).
  let sb = StringBuilder::new()
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      StringBuilder::push(sb, header_value_separator)
    }
    StringBuilder::push(sb, Array::get(values, i))
    i = i + 1
  }
  StringBuilder::freeze(sb)
}

let split_header_values: (String) -> Array[String] = (text) -> {
  let values = Array::slice([""], 0, 0)
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start:i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}

let empty_source_specs: () -> Array[(String, String)] = () -> {
  Array::slice([("", "")], 0, 0)
}

let copy_source_specs: (Array[(String, String)]) -> Array[(String, String)] = (sources) -> {
  let out = empty_source_specs()
  let mut i = 0
  while i < Array::length(sources) {
    Array::push(out, Array::get(sources, i))
    i = i + 1
  }
  out
}

let empty_group_specs: () -> Array[(String, String, String)] = () -> {
  Array::slice([("", "", "")], 0, 0)
}

let empty_source_cache_specs: () -> Array[(String, String, String)] = () -> {
  Array::slice([("", "", "")], 0, 0)
}

let empty_group_cache_specs: () -> Array[(String, String, String, String)] = () -> {
  Array::slice([("", "", "", "")], 0, 0)
}

let empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}

let push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {
  let group_count = Array::length(groups)
  let handled_by_tail = if group_count > 0 {
    let (last_name, last_sources) = Array::get(groups, group_count - 1)
    if last_name == group_name {
      Array::push(last_sources, (path, source))
      true
    } else {
      false
    }
  } else {
    false
  }
  if !handled_by_tail {
    let mut i = 0
    let mut found_index = -1
    while i < group_count {
      if found_index == -1 {
        let (name, sources) = Array::get(groups, i)
        if name == group_name {
          Array::push(sources, (path, source))
          found_index = i
        }
      }
      i = i + 1
    }
    if found_index == -1 {
      let sources = Array::slice([("", "")], 0, 0)
      Array::push(sources, (path, source))
      Array::push(groups, (group_name, sources))
    }
  }
}

let push_grouped_source_fingerprint: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source_fingerprint) -> {
  let group_count = Array::length(groups)
  let handled_by_tail = if group_count > 0 {
    let (last_name, last_specs) = Array::get(groups, group_count - 1)
    if last_name == group_name {
      Array::push(last_specs, (path, source_fingerprint))
      true
    } else {
      false
    }
  } else {
    false
  }
  if !handled_by_tail {
    let mut i = 0
    let mut found_index = -1
    while i < group_count {
      if found_index == -1 {
        let (name, specs) = Array::get(groups, i)
        if name == group_name {
          Array::push(specs, (path, source_fingerprint))
          found_index = i
        }
      }
      i = i + 1
    }
    if found_index == -1 {
      let specs = Array::slice([("", "")], 0, 0)
      Array::push(specs, (path, source_fingerprint))
      Array::push(groups, (group_name, specs))
    }
  }
}

let empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {
  Array::slice([("", "", "", "")], 0, 0)
}

let parse_persistent_source_list_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } = (raw) -> {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let sources = empty_source_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source list cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent source list cache version")
          }
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "source" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else {
          throw(String::concat("invalid persistent source list cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, sources)
}

let parse_persistent_source_group_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_group_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source group cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent source group cache version")
          }
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "group" {
          if version == 1 {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), "", Array::get(fields, 3)))
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))
          }
        } else {
          throw(String::concat("invalid persistent source group cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}

let matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
    } else {
      false
    }
  }
}

let load_source_if_cached_file_spec_matches: (String, String, String) -> Option[String] with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {
  if !(Fs::exists(path)) {
    None
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        Some(Fs::read_file(path))
      } else if String::length(source_fingerprint) > 0 {
        let source = Fs::read_file(path)
        if compact_string_fingerprint(source) == source_fingerprint {
          Some(source)
        } else {
          None
        }
      } else {
        None
      }
    } else if String::length(source_fingerprint) > 0 {
      let source = Fs::read_file(path)
      if compact_string_fingerprint(source) == source_fingerprint {
        Some(source)
      } else {
        None
      }
    } else {
      None
    }
  }
}

// #729/#730: EVERY path that turns an on-disk file into an in-memory source
// must apply the same ingestion transform — require-pin blanking, and for
// index.vibei contracts the conformance-checked facade desugar. The cold
// walk (collect_sources_rec) did; the persistent-cache reconstruction lanes
// below re-read RAW disk bytes, so a warm cache leaked undesugared contracts
// into the merge (masked until now because every compiler-bundle change
// invalidated the caches). Cache validity stays keyed on the RAW file.
// Exported (#741): the wasi_only MERGE lane (merge_sources.vibe) applies the
// same ingestion when collecting its import graph, so contract packages
// (.vibei) resolve in that lane too.
// #740: the facade output is marked so a second ingestion pass (the
// collect_source_groups_fs chokepoint below re-ingests EVERY collected
// source, including ones a cache-reconstruction branch already ingested)
// recognizes an already-desugared contract instead of re-parsing the facade
// as contract grammar (which would fail conformance with empty decls).
let contract_facade_marker = "// vibe: contract facade (desugared from .vibei)\n"

export let ingest_source_text_fs: (String, String) -> String with { Error, Fs } = (path, raw) -> {
  let (_, pin_blanked) = extract_require_pins(raw)
  if String::ends_with(path, ".vibei") {
    if String::starts_with(pin_blanked, contract_facade_marker) {
      pin_blanked
    } else {
      String::concat(contract_facade_marker, desugar_contract_source_fs(path, pin_blanked))
    }
  } else {
    pin_blanked
  }
}

// #740: manifest source loaders (manifest_sources.vibe) read RAW disk bytes;
// a .vibei contract reaching the grouped merge un-desugared left its imports
// unresolvable ("undefined variable (local): sha1 @call" — contract/index.vibe's
// @vibe/core import never rewrote). Ingest every collected source once here,
// the single point all collection branches (manifest, caches, recursive walk)
// flow through.
let ingest_grouped_sources_fs: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (groups) -> {
  let out = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (gname, gsources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(gsources) {
      let (spath, stext) = Array::get(gsources, si)
      push_grouped_source(out, gname, spath, ingest_source_text_fs(spath, stext))
      si = si + 1
    }
    gi = gi + 1
  }
  out
}

let rec load_cached_sources_rec: (Array[(String, String, String)], Int, Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } = (specs, index, out) -> {
  if index >= Array::length(specs) {
    Some(out)
  } else {
    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        Array::push(out, (path, ingest_source_text_fs(path, source)))
        load_cached_sources_rec(specs, index + 1, out)
      },
      None => None
    }
  }
}

let rec load_cached_grouped_sources_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        push_grouped_source(out, group_name, path, ingest_source_text_fs(path, source))
        load_cached_grouped_sources_rec(rows, index + 1, out)
      },
      None => None
    }
  }
}

let rec load_cached_group_fingerprint_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {
      None
    } else {
      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)
      load_cached_group_fingerprint_rec(rows, index + 1, out)
    }
  }
}

let manifest_cache_is_valid: (Option[(String, String, String)]) -> Bool with { Error, Fs } = (manifest) -> {
  match manifest {
    Some((path, stat_token_text, source_fingerprint)) =>
      matches_cached_file_spec(path, stat_token_text, source_fingerprint),
    None => true
  }
}

let load_persistent_sources_cache_if_valid: (String) -> Option[Array[(String, String)]] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs) = parse_persistent_source_list_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_sources_rec(specs, 0, empty_source_specs())
    }
  }
}

let load_persistent_source_groups_cache_if_valid: (String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())
    }
  }
}

let manifest_path_of: (Option[(String, String, String)]) -> Option[String] = (manifest) -> {
  match manifest {
    Some((path, _, _)) => Some(path),
    None => None
  }
}

let load_persistent_sources_from_group_cache_if_valid: (String) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      let specs = empty_source_cache_specs()
      let mut i = 0
      while i < Array::length(rows) {
        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)
        Array::push(specs, (path, stat_token_text, source_fingerprint))
        i = i + 1
      }
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) => Some((manifest_path_of(manifest), sources)),
        None => None
      }
    }
  }
}

let load_persistent_source_groups_from_source_list_cache_if_valid: (String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs) = parse_persistent_source_list_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) =>
          match try_load_manifest_rows(entry_path) {
            Some((base_dir, rows)) => {
              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)
              Some((manifest_path_of(manifest), groups))
            },
            None => {
              let groups = empty_grouped_sources()
              Array::push(groups, ("recursive", sources))
              Some((None, groups))
            }
          },
        None => None
      }
    }
  }
}

export let load_persistent_source_group_fingerprint_if_valid: (String) -> Option[String] with { Error, Fs } = (entry_path) -> {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {
        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),
        None => None
      }
    }
  }
}

let build_persistent_sources_cache_text: (Option[String], Array[(String, String)]) -> String with { Error, Fs } = (manifest_path, sources) -> {
  let mut out = "version\t2\n"
  match manifest_path {
    Some(path) => {
      out = String::concat(
        out,
        String::concat(
          "manifest\t",
          String::concat(
            path,
            String::concat(
              "\t",
              String::concat(
                __to_string(Fs::stat_token(path)),
                String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(path)), "\n"))
              )
            )
          )
        )
      )
    },
    None => ()
  }
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    out = String::concat(
      out,
      String::concat(
        "source\t",
        String::concat(
          path,
          String::concat(
            "\t",
            String::concat(
              __to_string(Fs::stat_token(path)),
              String::concat("\t", String::concat(compact_string_fingerprint(source), "\n"))
            )
          )
        )
      )
    )
    i = i + 1
  }
  out
}

let build_persistent_source_groups_cache_text: (Option[String], Array[(String, Array[(String, String)])]) -> String with { Error, Fs } = (manifest_path, groups) -> {
  let mut out = "version\t2\n"
  match manifest_path {
    Some(path) => {
      out = String::concat(
        out,
        String::concat(
          "manifest\t",
          String::concat(
            path,
            String::concat(
              "\t",
              String::concat(
                __to_string(Fs::stat_token(path)),
                String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(path)), "\n"))
              )
            )
          )
        )
      )
    },
    None => ()
  }
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      out = String::concat(
        out,
        String::concat(
          "group\t",
          String::concat(
            group_name,
            String::concat(
              "\t",
              String::concat(
                path,
                String::concat(
                  "\t",
                  String::concat(
                    __to_string(Fs::stat_token(path)),
                    String::concat("\t", String::concat(compact_string_fingerprint(source), "\n"))
                  )
                )
              )
            )
          )
        )
      )
      si = si + 1
    }
    gi = gi + 1
  }
  out
}

let collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {
  let deps = Array::slice([""], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      _ => ()
    }
    i = i + 1
  }
  deps
}

export let load_or_parse_module_header_fs: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {
  load_or_parse_module_header_fs_impl(path, source, parse_count)
}

let store_persistent_sources_cache: (String, Option[String], Array[(String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, sources) -> {
  Fs::write_file(
    persistent_source_list_cache_path(entry_path),
    build_persistent_sources_cache_text(manifest_path, sources)
  )
}

let store_persistent_source_groups_cache: (String, Option[String], Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } = (entry_path, manifest_path, groups) -> {
  Fs::write_file(
    persistent_source_group_cache_path(entry_path),
    build_persistent_source_groups_cache_text(manifest_path, groups)
  )
}

let copy_grouped_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] = (groups) -> {
  let out = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let copied_sources = copy_source_specs(sources)
    Array::push(out, (group_name, copied_sources))
    gi = gi + 1
  }
  out
}

let flatten_group_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (groups) -> {
  let out = empty_source_specs()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (_, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      Array::push(out, Array::get(sources, si))
      si = si + 1
    }
    gi = gi + 1
  }
  out
}

let filter_group_sources: (Array[(String, Array[(String, String)])], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (groups, ordered_sources) -> {
  let filtered = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let next_sources = empty_source_specs()
    let mut si = 0
    while si < Array::length(sources) {
      let pair = Array::get(sources, si)
      let (path, _) = pair
      match source_lookup(ordered_sources, path) {
        Some(_) => Array::push(next_sources, pair),
        None => ()
      }
      si = si + 1
    }
    if Array::length(next_sources) > 0 {
      Array::push(filtered, (group_name, next_sources))
    }
    gi = gi + 1
  }
  filtered
}

let special_bundle_source_groups: (String) -> Option[Array[(String, Array[(String, String)])]] = (entry_path) -> {
  let _ = entry_path
  None
}

let normalize_bundle_source_groups: (Array[(String, Array[(String, String)])], String, String) -> Array[(String, Array[(String, String)])] = (groups, main_path, main_source) -> {
  let normalized = empty_grouped_sources()
  let mut found = false
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let next_sources = empty_source_specs()
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      if path == main_path {
        Array::push(next_sources, (path, main_source))
        found = true
      } else {
        Array::push(next_sources, (path, source))
      }
      si = si + 1
    }
    Array::push(normalized, (group_name, next_sources))
    gi = gi + 1
  }
  if !found {
    let entry_sources = empty_source_specs()
    Array::push(entry_sources, (main_path, main_source))
    Array::push(normalized, ("entry", entry_sources))
  }
  normalized
}

let special_manifest_sources: (String) -> Option[(String, Array[(String, String)])] = (entry_path) -> {
  let _ = entry_path
  None
}

let special_manifest_source_groups: (String) -> Option[(String, Array[(String, Array[(String, String)])])] = (entry_path) -> {
  let _ = entry_path
  None
}


//# Helper functions

// Cache lookup helper
let cache_lookup: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while i < len {
    if done {
      i = len
    } else {
      let (p, e) = Array::get(cache, i)
      if p == path {
        result = Some(e)
        done = true
      }
      i = i + 1
    }
  }
  result
}

let export_marker_name: (String) -> String = (name) -> {
  String::concat("__vibe_internal_export__:", name)
}

let env_has_export_marker: (TypeEnv, String) -> Bool = (env, name) -> {
  match env_lookup(env, export_marker_name(name)) {
    Some(_) => true,
    None => false
  }
}

let bind_export_markers: (TypeEnv, Array[String]) -> TypeEnv = (env, exports) -> {
  let mut acc = env
  let mut i = 0
  while i < Array::length(exports) {
    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)
    i = i + 1
  }
  acc
}

// Bind imported names from a checked module's env
let rec bind_checked_imports: (Array[(String, Option[String])], Int, TypeEnv, TypeEnv) -> TypeEnv = (names, i, env, mod_env) -> {
  if i >= Array::length(names) {
    env
  } else {
    let (name, alias) = Array::get(names, i)
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let new_env = if env_has_export_marker(mod_env, name) {
      match env_lookup(mod_env, name) {
        Some(ty) => env_bind(env, bound_name, ty),
        None => env
      }
    } else {
      env
    }
    bind_checked_imports(names, i + 1, new_env, mod_env)
  }
}

//# Module Loader

// Check a module and return its TypeEnv, resolving imports recursively.
// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).
export let rec check_module: (String, String, Array[(String, String)], Array[String], Array[(String, TypeEnv)]) -> TypeEnv with { Error } = (source, path, sources, loading, checked_cache) -> {
  // Check cache first
  let cached = cache_lookup(checked_cache, path)
  match cached {
    Some(env) => env,
    None => {
      // Cycle detection
      if contains_path(loading, path) {
        throw(String::concat("import cycle detected: ", path))
      }
      let tokens = lex(source)
      let stmts = parse_program(tokens)
      let base_dir = dir_of_path(path)
      // Cycle-detection stack: push self before recursing through this
      // module's imports, truncate back when done. O(1) per frame vs.
      // the previous `Array::concat(loading, [path])`, which copied the
      // entire ancestor stack on every recursion and made nested module
      // loads O(depth²) — same idiom as `runtime/typecheck_fs.vibe`
      // (#366 truncate cutover).
      let saved_loading_len = Array::length(loading)
      Array::push(loading, path)

      // Resolve imports using while loop
      let mut import_env = EnvEmpty
      let mut ri = 0
      while ri < Array::length(stmts) {
        let stmt = Array::get(stmts, ri)
        import_env = match stmt {
          SImport(raw_path, names) => {
            match resolve_path_in_sources(base_dir, raw_path, sources) {
              None => throw(String::concat("module not found: ", resolve_import_path(base_dir, raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)
                bind_checked_imports(names, 0, import_env, mod_env)
              }
            }
          },
          SReExport(raw_path, names) => {
            match resolve_path_in_sources(base_dir, raw_path, sources) {
              None => throw(String::concat("module not found: ", resolve_import_path(base_dir, raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)
                bind_checked_imports(names, 0, import_env, mod_env)
              }
            }
          },
          _ => import_env
        }
        ri = ri + 1
      }
      Array::truncate(loading, saved_loading_len)

      // Type-check with imported env
      let empty_defs = Array::slice([TDAlias("_dummy", Array::slice([""], 0, 0), CtUnit)], 0, 0)
      let check_errors = Array::slice([
        ""
      ], 0, 0)
      // (8th arg: the typed-hover tytab — unused in this lane. The stale
      // 7-arg call only surfaced under the cold-cache whole-graph check,
      // #740 fallout.)
      let check_tytab = Array::slice([
        (0, CtUnit)
      ], 0, 0)
      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors, check_tytab)

      // Cache result
      let cached_env = bind_export_markers(env, collect_exports(stmts))
      Array::push(checked_cache, (path, cached_env))
      cached_env
    }
  }
}

//# FS-based source collection

// `visited` is a `path_set` (#533): this recursion runs once per import
// EDGE and the visited set grows to every module of the program, so the
// previous linear `contains_path` scan was O(edges × modules). The set is
// membership-only — `sources` keeps its own dependency-first order from
// the recursion, which is what callers consume.
// #729 (ADR-0063 Phase C-2): ingest an index.vibei contract. The contract is
// conformance-checked against its declared implementation files and desugared
// to plain facade source (re-export lines), so everything downstream of the
// loader — type db, merge plan, codegen — sees ordinary vibe source and needs
// no .vibei awareness. Implementation files are DECLARED by the contract
// (`import ./impl.vibe {}`) rather than discovered: the Fs effect has no
// directory listing yet (auto-discovery arrives with Fs::ReadDir, #730).
let desugar_contract_source_fs: (String, String) -> String with { Error, Fs } = (path, source) -> {
  let dir = dir_of_path(path)
  let sibling_index = String::concat(dir, "/index.vibe")
  if Fs::exists(sibling_index) {
    throw("both index.vibe and index.vibei exist in \{dir} (#729): a boundary has exactly one index")
  } else ()
  let (decls, opaque_names, extra) = parse_contract_program(lex(source))
  let (impl_raws, type_defs) = classify_contract_stmts(extra)
  let impl_units = Array::slice([
    ("", Array::slice([
      SExport(Array::slice([
        ""
      ], 0, 0))
    ], 0, 0))
  ], 0, 0)
  let union_stmts = Array::slice([
    SExport(Array::slice([
      ""
    ], 0, 0))
  ], 0, 0)
  let mut ri = 0
  while ri < Array::length(impl_raws) {
    let raw = Array::get(impl_raws, ri)
    let resolved = resolve_import_path(dir, raw)
    let impl_text = Fs::read_file(resolved)
    // impl files may carry their own require pin lines (extracted for real
    // when the file itself is ingested) — blank them for the conformance
    // parse here.
    let (_, impl_blanked) = extract_require_pins(impl_text)
    let impl_stmts = parse_program(lex(impl_blanked))
    Array::push(impl_units, (raw, impl_stmts))
    let mut si = 0
    while si < Array::length(impl_stmts) {
      Array::push(union_stmts, Array::get(impl_stmts, si))
      si = si + 1
    }
    ri = ri + 1
  }
  let errors = check_contract(decls, opaque_names, union_stmts)
  if Array::length(errors) > 0 {
    throw("\{path}: contract violation: \{String::join(errors, "; ")}")
  } else ()
  contract_facade_source(decls, opaque_names, type_defs, impl_units)
}

// #730 (D-2): both content-addressing hashes of a contract package, from its
// ORIGINAL on-disk texts (require lines included — they are part of the
// hashed content, which is what makes a direct pin fix the transitive
// closure). Paths in the package hash are package-relative ("index.vibei" +
// each impl's raw import spelling), so the hash is location-independent —
// the same function serves `vibe hash` on a working directory and store
// verification of an installed copy.
export let contract_package_hashes_fs: (String) -> (String, String) with { Error, Fs } = (path) -> {
  let raw = Fs::read_file(path)
  let (_, blanked) = extract_require_pins(raw)
  let (decls, opaques, extra) = parse_contract_program(lex(blanked))
  let (impl_raws, type_defs) = classify_contract_stmts(extra)
  let dir = dir_of_path(path)
  let sources = Array::slice([
    ("", "")
  ], 0, 0)
  Array::push(sources, ("index.vibei", raw))
  let mut ri = 0
  while ri < Array::length(impl_raws) {
    let iraw = Array::get(impl_raws, ri)
    let itext = Fs::read_file(resolve_import_path(dir, iraw))
    Array::push(sources, (iraw, itext))
    ri = ri + 1
  }
  (package_hash_from_sources(sources), contract_hash(decls, opaques, type_defs))
}

// #730 (D-3): fill missing require pins OFFLINE from the workspace store.
// `require @x/y 1.2.3` becomes `require @x/y 1.2.3 = #pkg:sha1:<hex>` when
// .vibe/store/@x/y/ is installed; a package absent from the store is an
// error (network fetch belongs to `vibe add`/`update`, never to fmt).
// Pinned lines pass through untouched, so the rewrite is idempotent.
export let fill_require_pins_fs: (String) -> String with { Error, Fs } = (source) -> {
  fill_require_pins_fs_mode(source, false)
}

// repin=true rewrites EVERY require line to the store's current hash —
// `vibe dedupe --apply` (#730 D-4): after updating a store package, one
// pass re-points all pins in a file at the installed copies. With the
// by-name store there is one installed version per package, so repinning
// IS conflict resolution.
export let fill_require_pins_fs_mode: (String, Bool) -> String with { Error, Fs } = (source, repin) -> {
  let sb = StringBuilder::new()
  let len = String::length(source)
  let mut pos = 0
  let mut scanning = true
  while pos < len {
    let mut nl = pos
    while nl < len && String::char_code_at(source, nl) != 10 {
      nl = nl + 1
    }
    let line = String::substring(source, pos, nl)
    let trimmed = String::trim(line)
    let mut emitted = false
    if scanning && String::starts_with(trimmed, "require ") {
      let (pins_one, _) = extract_require_pins(String::concat(trimmed, "\n"))
      if Array::length(pins_one) == 1 {
        let (pname, pver, ppin) = Array::get(pins_one, 0)
        if ppin == "" || repin {
          let store_index = String::concat(".vibe/store/", String::concat(pname, "/index.vibei"))
          if Fs::exists(store_index) {
            ()
          } else {
            throw("cannot pin \{pname} offline: not installed in the store (.vibe/store/\{pname}/)")
          }
          let (pkg_hash, _) = contract_package_hashes_fs(store_index)
          StringBuilder::push(sb, "require \{pname} \{pver} = #\{pkg_hash}")
          emitted = true
        } else ()
      } else ()
    } else {
      if String::length(trimmed) == 0 || String::starts_with(trimmed, "//") {
        ()
      } else {
        scanning = false
      }
    }
    if emitted {
      ()
    } else {
      StringBuilder::push(sb, line)
    }
    if nl < len {
      StringBuilder::push(sb, "\n")
    } else ()
    pos = nl + 1
  }
  StringBuilder::freeze(sb)
}

// #732 (Phase F): publish gate. Parse the previous and next contract
// surfaces and verify the claimed version bump is exactly what the diff
// requires (Elm-style machine-checked semver). Returns error strings;
// empty = the release claim is honest.
export let publish_check_fs: (String, String, String, String) -> Array[String] with { Error, Fs } = (prev_contract_path, next_contract_path, prev_version, next_version) -> {
  let (_, prev_blanked) = extract_require_pins(Fs::read_file(prev_contract_path))
  let (pd, po, pextra) = parse_contract_program(lex(prev_blanked))
  let (_, ptypes) = classify_contract_stmts(pextra)
  let (_, next_blanked) = extract_require_pins(Fs::read_file(next_contract_path))
  let (nd, no, nextra) = parse_contract_program(lex(next_blanked))
  let (_, ntypes) = classify_contract_stmts(nextra)
  verify_publish_bump(
    prev_version,
    next_version,
    contract_surface_lines(pd, po, ptypes),
    contract_surface_lines(nd, no, ntypes)
  )
}

// #730 (D-2): verify a store-resolved package against the importer's require
// pin. The store is laid out BY NAME (.vibe/store/@scope/name/) and trusted
// only through this hash check, so any mirror/copy mechanism is fine.
let verify_store_package_fs: (String, Array[(String, String, String)], String) -> Unit with { Error, Fs } = (importer, pins, store_index_path) -> {
  let prefix = ".vibe/store/"
  let suffix = "/index.vibei"
  let name = String::substring(
    store_index_path,
    String::length(prefix),
    String::length(store_index_path) - String::length(suffix)
  )
  let mut pin_hash = ""
  let mut pin_found = false
  let mut pi = 0
  while pi < Array::length(pins) {
    let (pname, _, phash) = Array::get(pins, pi)
    if pname == name {
      pin_hash = phash
      pin_found = true
    } else ()
    pi = pi + 1
  }
  if pin_found {
    ()
  } else {
    throw("no require pin for \{name} in \{importer} (add: require \{name} <x.y.z> = #<pkg-hash>; compute with `vibe hash`)")
  }
  if pin_hash == "" {
    throw("unpinned require for \{name} in \{importer}: run `vibe fmt` (VIBE_FILL_PINS=1) to insert the pin from the store")
  } else ()
  if Fs::exists(store_index_path) {
    ()
  } else {
    throw("package \{name} is not installed in the store (.vibe/store/\{name}/)")
  }
  let (actual, _) = contract_package_hashes_fs(store_index_path)
  if actual == pin_hash {
    ()
  } else {
    throw("pin mismatch for \{name}: \{importer} requires #\{pin_hash} but the store copy is #\{actual}")
  }
}

// #729 (Phase C-3): incoming boundary enforcement. A directory with an
// index.vibei contract is a boundary: files outside it may import only the
// contract itself, never package internals. Checked at every ancestor level
// of the target, so nested contract packages are boundaries too. Directories
// with a plain index.vibe keep the legacy permissive behavior until the
// Phase G migration (#732) — the existing tree imports files inside such
// directories directly. The escape rule (relative imports above the package
// root) arrives with @scope resolution (#730).
let enforce_incoming_boundary_fs: (String, String) -> Unit with { Error, Fs } = (importer, target) -> {
  let tlen = String::length(target)
  let mut p = 0
  while p < tlen {
    if String::char_code_at(target, p) == '/' && p > 0 {
      let dir = target[0:p]
      let contract = String::concat(dir, "/index.vibei")
      if target == contract {
        ()
      } else if Fs::exists(contract) {
        let dir_prefix = String::concat(dir, "/")
        if String::starts_with(importer, dir_prefix) {
          ()
        } else {
          throw("cannot import \{target} from outside its package boundary \{dir} (#729); import \{dir} (its contract) instead")
        }
      } else ()
    } else ()
    p = p + 1
  }
}

let rec collect_sources_rec: (String, Array[(String, String)], Array[Array[String]]) -> Unit with { Error, Fs } = (path, sources, visited) -> {
  if path_set_contains(visited, path) {
    ()
  }
  else {
    path_set_add(visited, path)
    let raw_source = Fs::read_file(path)
    // #730 (D-2): require pin lines are a leading directive, extracted and
    // blanked (offset-preserving) before anything parses the source.
    let (pins, pin_blanked) = extract_require_pins(raw_source)
    let source = if String::ends_with(path, ".vibei") {
      desugar_contract_source_fs(path, pin_blanked)
    } else {
      pin_blanked
    }
    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)
    // First, recurse into dependencies (imports and re-exports)
    let mut i = 0
    while i < Array::length(deps) {
      let dep = Array::get(deps, i)
      enforce_incoming_boundary_fs(path, dep)
      // Only a store PACKAGE reference (its contract) is pin-verified;
      // paths inside an already-verified store package (its impl files)
      // are covered by that package's hash.
      if String::starts_with(dep, ".vibe/store/") && String::ends_with(dep, "/index.vibei") {
        verify_store_package_fs(path, pins, dep)
      } else ()
      collect_sources_rec(dep, sources, visited)
      i = i + 1
    }
    // Then add this module (dependencies come first)
    Array::push(sources, (path, source))
  }
}

// Recursively collect all source files from filesystem, following imports and re-exports.
// Returns Array[(path, source)] in dependency order (dependencies first).
export let collect_all_sources_fs: (String) -> Array[(String, String)] with { Error, Fs } = (entry_path) -> {
  match special_manifest_sources(entry_path) {
    Some((manifest_path, sources)) => {
      let _ = manifest_path
      copy_source_specs(sources)
    },
    None =>
      match load_persistent_sources_cache_if_valid(entry_path) {
        Some(sources) => sources,
        None => {
          match try_collect_manifest_sources_fs(entry_path) {
            Some((manifest_path, sources)) => {
              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)
              sources
            },
            None => {
              match try_load_manifest_rows(entry_path) {
                Some((base_dir, rows)) => {
                  let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)
                  preloaded_sources
                },
                None => {
                  let sources = Array::slice([("", "")], 0, 0)
                  let visited = path_set_new()
                  collect_sources_rec(entry_path, sources, visited)
                  store_persistent_sources_cache(entry_path, None, sources)
                  sources
                }
              }
            }
          }
        }
      }
  }
}

// #740: the grouped merge (db_grouped_merged_source) treats the LAST
// flattened source as the export-rename plan entry — its exports stay
// UNRENAMED. Manifest collection returns sources in MANIFEST ROW ORDER, so a
// manifest-listed entry that is not the last needed row left some LATER dep
// exempt from renames instead of the entry: callers were rewritten to that
// dep's `_exp_<path>` names whose defs were never emitted ("undefined
// variable (local): ripple_get_fingerprint_exp_..." when FS-compiling
// runtime/typecheck_fs.vibe, row 152, whose ripple deps sit at rows 150-151).
// Centralized here (rather than in each collection branch) so groups
// reconstructed from PERSISTENT CACHES get the same ordering guarantee.
// No-op when the entry is already last (the plain recursive walk).
let move_entry_last_grouped: (Array[(String, Array[(String, String)])], String) -> Array[(String, Array[(String, String)])] = (groups, entry_path) -> {
  let glen = Array::length(groups)
  let mut total = 0
  let mut gi = 0
  while gi < glen {
    let (_, gsources) = Array::get(groups, gi)
    total = total + Array::length(gsources)
    gi = gi + 1
  }
  let mut seen = 0
  let mut entry_is_last = false
  let mut entry_found = false
  let mut entry_source = ""
  gi = 0
  while gi < glen {
    let (_, gsources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(gsources) {
      seen = seen + 1
      let (spath, stext) = Array::get(gsources, si)
      if spath == entry_path {
        entry_found = true
        entry_source = stext
        if seen == total {
          entry_is_last = true
        } else {
          ()
        }
      } else {
        ()
      }
      si = si + 1
    }
    gi = gi + 1
  }
  if !entry_found || entry_is_last {
    groups
  } else {
    let out = empty_grouped_sources()
    gi = 0
    while gi < glen {
      let (gname, gsources) = Array::get(groups, gi)
      let mut si = 0
      while si < Array::length(gsources) {
        let (spath, stext) = Array::get(gsources, si)
        if spath == entry_path {
          ()
        } else {
          push_grouped_source(out, gname, spath, stext)
        }
        si = si + 1
      }
      gi = gi + 1
    }
    push_grouped_source(out, "entry_last", entry_path, entry_source)
    out
  }
}

export let collect_source_groups_fs: (String) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  let collected = match special_manifest_source_groups(entry_path) {
    Some((manifest_path, groups)) => {
      let _ = manifest_path
      copy_grouped_sources(groups)
    },
    None =>
      match load_persistent_source_groups_cache_if_valid(entry_path) {
        Some(groups) => groups,
        None =>
          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {
            Some((manifest_path, groups)) => {
              store_persistent_source_groups_cache(entry_path, manifest_path, groups)
              groups
            },
            None =>
              match try_collect_manifest_source_groups_fs(entry_path) {
                Some((manifest_path, groups)) => {
                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                  groups
                },
                None =>
                  match try_load_manifest_rows(entry_path) {
                    Some((base_dir, rows)) => {
                      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                      let groups = empty_grouped_sources()
                      let mut j = 0
                      while j < Array::length(rows) {
                        let (group_name, rel_path) = Array::get(rows, j)
                        let path = join_path(base_dir, rel_path)
                        let mut found = ""
                        let mut k = 0
                        while k < Array::length(preloaded_sources) {
                          if found == "" {
                            let (source_path, source_text) = Array::get(preloaded_sources, k)
                            if source_path == path {
                              found = source_text
                            }
                          }
                          k = k + 1
                        }
                        if found == "" {
                          ()
                        } else {
                          push_grouped_source(groups, group_name, path, found)
                        }
                        j = j + 1
                      }
                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                      groups
                    },
                    None => {
                      let groups = empty_grouped_sources()
                      let recursive_sources = collect_all_sources_fs(entry_path)
                      Array::push(groups, ("recursive", recursive_sources))
                      store_persistent_source_groups_cache(entry_path, None, groups)
                      groups
                    }
                  }
              }
          }
      }
  }
  move_entry_last_grouped(ingest_grouped_sources_fs(collected), entry_path)
}

//# Module bundling — merge stmts from all modules in dependency order

// Given all sources (in dependency order), parse and merge their statements.
// Skips SImport, SReExport (already resolved). Keeps all definitions.
export let collect_merged_stmts: (Array[(String, String)]) -> Array[Stmt] with { Error } = (sources) -> {
  let merged = Array::slice([SExport(["_dummy"])], 0, 0)
  let mut si = 0
  while si < Array::length(sources) {
    let (_, src) = Array::get(sources, si)
    // Use lex+parse_program directly (skip resolve_interp_stmt to reduce heap pressure)
    let stmts = parse_program(lex(src))
    let mut j = 0
    while j < Array::length(stmts) {
      let stmt = Array::get(stmts, j)
      match stmt {
        SImport(_, _) => (),
        SReExport(_, _) => (),
        SAliasDecl(_, _) => (),
        _ => Array::push(merged, stmt)
      }
      j = j + 1
    }
    si = si + 1
  }
  merged
}
