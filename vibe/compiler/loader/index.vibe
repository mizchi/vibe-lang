//# Path helpers (inline to avoid cross-module import issues)

let dir_of = (file_path: String) -> String {
  let idx = String::last_index_of(file_path, "/")
  if idx < 0 {
    ""
  }
  else {
    file_path[0:idx]
  }
}

let normalize_path = (path: String) -> String {
  let mut parts = Array::slice([""], 0, 0)
  let len = String::length(path)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_sep = if i == len {
      true
    } else {
      String::char_code_at(path, i) == 47
    }
    if at_sep {
      let part = path[start:i]
      let skip_part = if String::length(part) == 0 {
        true
      } else {
        part == "."
      }
      if skip_part {
        ()
      } else if part == ".." {
        if Array::length(parts) > 0 {
          parts = Array::slice(parts, 0, Array::length(parts) - 1)
        }
      } else {
        Array::push(parts, part)
      }
      start = i + 1
    }
    i = i + 1
  }
  let mut out = ""
  i = 0
  while i < Array::length(parts) {
    if i > 0 {
      out = String::concat(out, "/")
    }
    out = String::concat(out, Array::get(parts, i))
    i = i + 1
  }
  out
}

let path_has_relative_prefix = (raw_path: String, len: Int) -> Bool {
  if len >= 2 {
    if raw_path[0:2] == "./" {
      true
    } else if len >= 3 {
      raw_path[0:3] == "../"
    } else {
      false
    }
  } else {
    false
  }
}

let resolve_path = (base_dir: String, raw_path: String) -> String {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    if base_dir == "" {
      raw_path
    } else {
      String::concat(base_dir, String::concat("/", raw_path))
    }
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    normalized
  } else {
    String::concat(normalized, ".vibe")
  }
}

let resolve_path_candidates = (base_dir: String, raw_path: String) -> Array[String] {
  let len = String::length(raw_path)
  let joined = if path_has_relative_prefix(raw_path, len) {
    if base_dir == "" {
      raw_path
    } else {
      String::concat(base_dir, String::concat("/", raw_path))
    }
  } else {
    raw_path
  }
  let normalized = normalize_path(joined)
  if String::ends_with(normalized, ".vibe") {
    [normalized]
  } else {
    [
      String::concat(normalized, ".vibe"),
      String::concat(normalized, "/index.vibe")
    ]
  }
}

let contains_str = (arr: Array[String], target: String) -> Bool {
  let mut i = 0
  let mut found = false
  while i < Array::length(arr) {
    if !found {
      if Array::get(arr, i) == target {
        found = true
      } else {
        ()
      }
    }
    i = i + 1
  }
  found
}

let source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {
  let mut i = 0
  let mut found = None
  while i < Array::length(sources) {
    match found {
      Some(_) => (),
      None => {
        let (p, src) = Array::get(sources, i)
        if p == path_key {
          found = Some(src)
        }
      }
    }
    i = i + 1
  }
  found
}

let resolve_path_in_sources = (base_dir: String, raw_path: String, sources: Array[(String, String)]) -> Option[(String, String)] {
  let candidates = resolve_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = None
  while i < Array::length(candidates) {
    match found {
      Some(_) => (),
      None => {
        let candidate = Array::get(candidates, i)
        match source_lookup(sources, candidate) {
          Some(source) => {
            found = Some((candidate, source))
          }
          None => ()
        }
      }
    }
    i = i + 1
  }
  found
}

let resolve_path_fs = (base_dir: String, raw_path: String) -> String {
  let candidates = resolve_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  while i < Array::length(candidates) {
    if found == "" {
      let candidate = Array::get(candidates, i)
      let candidate_exists = perform Fs::Exists(candidate)
      if candidate_exists {
        found = candidate
      }
    }
    i = i + 1
  }
  if found == "" {
    Array::get(candidates, 0)
  } else {
    found
  }
}

let join_path = (base_dir: String, rel_path: String) -> String {
  if base_dir == "" {
    rel_path
  } else {
    String::concat(base_dir, String::concat("/", rel_path))
  }
}

let strip_trailing_cr = (line: String) -> String {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0:len - 1]
    } else {
      line
    }
  } else {
    line
  }
}

let find_char = (s: String, target: Int) -> Int {
  let len = String::length(s)
  let mut i = 0
  let mut result = -1
  while i < len {
    if String::char_code_at(s, i) == target {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

let parse_source_manifest_rows = (manifest_source: String) -> Array[(String, String)] with { Error } {
  let rows = Array::slice([("", "")], 0, 0)
  let len = String::length(manifest_source)
  let mut line_start = 0
  let mut i = 0
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(manifest_source, i) == 10
    }
    if at_line_end {
      let raw_line = strip_trailing_cr(manifest_source[line_start:i])
      let line_len = String::length(raw_line)
      let has_content = line_len > 0
      let is_comment = if has_content {
        String::char_code_at(raw_line, 0) == 35
      } else {
        false
      }
      if has_content {
        if is_comment {
          ()
        } else {
        let tab_idx = find_char(raw_line, 9)
          let invalid_row = if tab_idx < 0 {
            true
          } else {
            tab_idx + 1 >= line_len
          }
          if invalid_row {
            throw(String::concat("invalid source manifest row: ", raw_line))
          }
          let group = raw_line[0:tab_idx]
          let path = raw_line[tab_idx + 1:line_len]
          Array::push(rows, (group, path))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  rows
}

let string_to_bytes = (s: String) -> Bytes {
  let out = Bytes::new()
  let len = String::length(s)
  let mut i = 0
  while i < len {
    Bytes::push(out, String::char_code_at(s, i))
    i = i + 1
  }
  out
}

let special_bundle_header = (path: String) -> Option[(Array[String], Array[String])] {
  if String::ends_with(path, "selfhost_sources_bundle.vibe") {
    Some((
      Array::slice([""], 0, 0),
      ["selfhost_sources", "selfhost_source_groups"]
    ))
  } else {
    None
  }
}

let split_tsv_fields = (line: String) -> Array[String] {
  let fields = Array::slice([""], 0, 0)
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start:i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}

let header_value_separator = String::from_char_code(31)

let join_header_values = (values: Array[String]) -> String {
  let mut out = ""
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      out = String::concat(out, header_value_separator)
    }
    out = String::concat(out, Array::get(values, i))
    i = i + 1
  }
  out
}

let split_header_values = (text: String) -> Array[String] {
  let values = Array::slice([""], 0, 0)
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start:i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}

let empty_source_specs = () -> Array[(String, String)] {
  Array::slice([("", "")], 0, 0)
}

let copy_source_specs = (sources: Array[(String, String)]) -> Array[(String, String)] {
  let out = empty_source_specs()
  let mut i = 0
  while i < Array::length(sources) {
    Array::push(out, Array::get(sources, i))
    i = i + 1
  }
  out
}

let empty_group_specs = () -> Array[(String, String, String)] {
  Array::slice([("", "", "")], 0, 0)
}

let empty_source_cache_specs = () -> Array[(String, String, String)] {
  Array::slice([("", "", "")], 0, 0)
}

let empty_group_cache_specs = () -> Array[(String, String, String, String)] {
  Array::slice([("", "", "", "")], 0, 0)
}

let empty_manifest_header_cache_rows = () -> Array[(String, String, String, String)] {
  Array::slice([("", "", "", "")], 0, 0)
}

let parse_persistent_source_list_cache = (
  raw: String
) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let sources = empty_source_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source list cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent source list cache version")
          }
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "source" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source list cache source row")
            }
            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else {
          throw(String::concat("invalid persistent source list cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, sources)
}

let parse_persistent_source_group_cache = (
  raw: String
) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_group_cache_specs()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent source group cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent source group cache version")
          }
        } else if tag == "manifest" {
          if version == 1 {
            if Array::length(fields) != 3 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), "", Array::get(fields, 2)))
          } else {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache manifest row")
            }
            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
          }
        } else if tag == "group" {
          if version == 1 {
            if Array::length(fields) != 4 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), "", Array::get(fields, 3)))
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent source group cache group row")
            }
            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))
          }
        } else {
          throw(String::concat("invalid persistent source group cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}

let parse_persistent_manifest_header_cache = (
  raw: String
) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_manifest_header_cache_rows()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent manifest header cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent manifest header cache version")
          }
        } else if tag == "manifest" {
          if Array::length(fields) != 4 {
            throw("invalid persistent manifest header cache manifest row")
          }
          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
        } else if tag == "header" {
          if version == 1 {
            if Array::length(fields) != 6 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(
              rows,
              (
                Array::get(fields, 1),
                Array::get(fields, 2),
                Array::get(fields, 3),
                Array::get(fields, 4)
              )
            )
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(
              rows,
              (
                Array::get(fields, 1),
                Array::get(fields, 2),
                Array::get(fields, 3),
                Array::get(fields, 4)
              )
            )
          }
        } else {
          throw(String::concat("invalid persistent manifest header cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}

let matches_cached_file_spec = (
  path: String,
  stat_token_text: String,
  source_fingerprint: String
) -> Bool with { Error, Fs } {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
    } else {
      false
    }
  }
}

let load_source_if_cached_file_spec_matches = (
  path: String,
  stat_token_text: String,
  source_fingerprint: String
) -> Option[String] with { Error, Fs } {
  if !(Fs::exists(path)) {
    None
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        Some(Fs::read_file(path))
      } else if String::length(source_fingerprint) > 0 {
        let source = Fs::read_file(path)
        if compact_string_fingerprint(source) == source_fingerprint {
          Some(source)
        } else {
          None
        }
      } else {
        None
      }
    } else if String::length(source_fingerprint) > 0 {
      let source = Fs::read_file(path)
      if compact_string_fingerprint(source) == source_fingerprint {
        Some(source)
      } else {
        None
      }
    } else {
      None
    }
  }
}

let rec load_cached_sources_rec = (
  specs: Array[(String, String, String)],
  index: Int,
  out: Array[(String, String)]
) -> Option[Array[(String, String)]] with { Error, Fs } {
  if index >= Array::length(specs) {
    Some(out)
  } else {
    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        Array::push(out, (path, source))
        load_cached_sources_rec(specs, index + 1, out)
      },
      None => None
    }
  }
}

let rec load_cached_grouped_sources_rec = (
  rows: Array[(String, String, String, String)],
  index: Int,
  out: Array[(String, Array[(String, String)])]
) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {
      Some(source) => {
        push_grouped_source(out, group_name, path, source)
        load_cached_grouped_sources_rec(rows, index + 1, out)
      },
      None => None
    }
  }
}

let rec load_cached_group_fingerprint_rec = (
  rows: Array[(String, String, String, String)],
  index: Int,
  out: Array[(String, Array[(String, String)])]
) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {
  if index >= Array::length(rows) {
    Some(out)
  } else {
    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)
    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {
      None
    } else {
      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)
      load_cached_group_fingerprint_rec(rows, index + 1, out)
    }
  }
}

let manifest_cache_is_valid = (manifest: Option[(String, String, String)]) -> Bool with { Error, Fs } {
  match manifest {
    Some((path, stat_token_text, source_fingerprint)) =>
      matches_cached_file_spec(path, stat_token_text, source_fingerprint),
    None => true
  }
}

let load_persistent_sources_cache_if_valid = (
  entry_path: String
) -> Option[Array[(String, String)]] with { Error, Fs } {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs) = parse_persistent_source_list_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_sources_rec(specs, 0, empty_source_specs())
    }
  }
}

let load_persistent_source_groups_cache_if_valid = (
  entry_path: String
) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())
    }
  }
}

let load_persistent_manifest_header_cache_if_valid = (
  entry_path: String,
  manifest_path: String,
  preloaded_sources: Array[(String, String)]
) -> Option[Array[(String, String, String, String)]] with { Error, Fs } {
  let cache_path = persistent_manifest_header_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_manifest_header_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    let manifest_ok = match manifest {
      Some((cached_path, stat_token_text, source_fingerprint)) =>
        cached_path == manifest_path &&
          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),
      None => false
    }
    if !manifest_ok {
      None
    } else {
      let mut valid = true
      let mut i = 0
      while i < Array::length(rows) {
        if valid {
          let (path, _, source_fingerprint, _) = Array::get(rows, i)
          match source_lookup(preloaded_sources, path) {
            Some(source) => {
              if !(compact_string_fingerprint(source) == source_fingerprint) {
                valid = false
              }
            },
            None => {
              valid = false
            }
          }
        }
        i = i + 1
      }
      if valid {
        Some(rows)
      } else {
        None
      }
    }
  }
}

let push_grouped_source_fingerprint = (
  groups: Array[(String, Array[(String, String)])],
  group_name: String,
  path: String,
  source_fingerprint: String
) -> Unit {
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, specs) = Array::get(groups, i)
    if name == group_name {
      Array::push(specs, (path, source_fingerprint))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let specs = Array::slice([("", "")], 0, 0)
    Array::push(specs, (path, source_fingerprint))
    Array::push(groups, (group_name, specs))
  }
}

let manifest_path_of = (manifest: Option[(String, String, String)]) -> Option[String] {
  match manifest {
    Some((path, _, _)) => Some(path),
    None => None
  }
}

let build_grouped_sources_from_manifest_rows = (
  base_dir: String,
  rows: Array[(String, String)],
  sources: Array[(String, String)]
) -> Array[(String, Array[(String, String)])] {
  let groups = empty_grouped_sources()
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    let mut found = ""
    let mut j = 0
    while j < Array::length(sources) {
      if found == "" {
        let (source_path, source_text) = Array::get(sources, j)
        if source_path == path {
          found = source_text
        }
      }
      j = j + 1
    }
    if found == "" {
      ()
    } else {
      push_grouped_source(groups, group_name, path, found)
    }
    i = i + 1
  }
  groups
}

let load_persistent_sources_from_group_cache_if_valid = (
  entry_path: String
) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      let specs = empty_source_cache_specs()
      let mut i = 0
      while i < Array::length(rows) {
        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)
        Array::push(specs, (path, stat_token_text, source_fingerprint))
        i = i + 1
      }
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) => Some((manifest_path_of(manifest), sources)),
        None => None
      }
    }
  }
}

let load_persistent_source_groups_from_source_list_cache_if_valid = (
  entry_path: String
) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } {
  let cache_path = persistent_source_list_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, specs) = parse_persistent_source_list_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_sources_rec(specs, 0, empty_source_specs()) {
        Some(sources) =>
          match try_load_manifest_rows(entry_path) {
            Some((base_dir, rows)) => {
              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)
              Some((manifest_path_of(manifest), groups))
            },
            None => {
              let groups = empty_grouped_sources()
              Array::push(groups, ("recursive", sources))
              Some((None, groups))
            }
          },
        None => None
      }
    }
  }
}

export let load_persistent_source_group_fingerprint_if_valid = (
  entry_path: String
) -> Option[String] with { Error, Fs } {
  let cache_path = persistent_source_group_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_source_group_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    if !(manifest_cache_is_valid(manifest)) {
      None
    } else {
      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {
        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),
        None => None
      }
    }
  }
}

let build_persistent_sources_cache_text = (
  manifest_path: Option[String],
  sources: Array[(String, String)]
  ) -> String with { Error, Fs } {
  let mut out = "version\t2\n"
  match manifest_path {
    Some(path) => {
      out = String::concat(
        out,
        String::concat(
          "manifest\t",
          String::concat(
            path,
            String::concat(
              "\t",
              String::concat(
                __to_string(Fs::stat_token(path)),
                String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(path)), "\n"))
              )
            )
          )
        )
      )
    },
    None => ()
  }
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    out = String::concat(
      out,
      String::concat(
        "source\t",
        String::concat(
          path,
          String::concat(
            "\t",
            String::concat(
              __to_string(Fs::stat_token(path)),
              String::concat("\t", String::concat(compact_string_fingerprint(source), "\n"))
            )
          )
        )
      )
    )
    i = i + 1
  }
  out
}

let build_persistent_source_groups_cache_text = (
  manifest_path: Option[String],
  groups: Array[(String, Array[(String, String)])]
) -> String with { Error, Fs } {
  let mut out = "version\t2\n"
  match manifest_path {
    Some(path) => {
      out = String::concat(
        out,
        String::concat(
          "manifest\t",
          String::concat(
            path,
            String::concat(
              "\t",
              String::concat(
                __to_string(Fs::stat_token(path)),
                String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(path)), "\n"))
              )
            )
          )
        )
      )
    },
    None => ()
  }
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let mut si = 0
    while si < Array::length(sources) {
      let (path, source) = Array::get(sources, si)
      out = String::concat(
        out,
        String::concat(
          "group\t",
          String::concat(
            group_name,
            String::concat(
              "\t",
              String::concat(
                path,
                String::concat(
                  "\t",
                  String::concat(
                    __to_string(Fs::stat_token(path)),
                    String::concat("\t", String::concat(compact_string_fingerprint(source), "\n"))
                  )
                )
              )
            )
          )
        )
      )
      si = si + 1
    }
    gi = gi + 1
  }
  out
}

let build_persistent_manifest_header_cache_text = (
  manifest_path: String,
  rows: Array[(String, String, String, String)]
) -> String with { Error, Fs } {
  let mut out = "version\t2\n"
  out = String::concat(
    out,
    String::concat(
      "manifest\t",
      String::concat(
        manifest_path,
        String::concat(
          "\t",
          String::concat(
            __to_string(Fs::stat_token(manifest_path)),
            String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), "\n"))
          )
        )
      )
    )
  )
  let mut i = 0
  while i < Array::length(rows) {
    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)
    out = String::concat(
      out,
      String::concat(
        "header\t",
        String::concat(
          path,
          String::concat(
            "\t",
            String::concat(
              stat_token_text,
              String::concat(
                "\t",
                String::concat(
                  source_fingerprint,
                  String::concat("\t", String::concat(deps_text, "\n"))
                )
              )
            )
          )
        )
      )
    )
    i = i + 1
  }
  out
}

let persistent_module_header_text = (deps: Array[String], exports: Array[String]) -> String {
  let mut out = "version\t1\n"
  let mut i = 0
  while i < Array::length(deps) {
    out = String::concat(
      out,
      String::concat("dep\t", String::concat(Array::get(deps, i), "\n"))
    )
    i = i + 1
  }
  let mut j = 0
  while j < Array::length(exports) {
    out = String::concat(
      out,
      String::concat("export\t", String::concat(Array::get(exports, j), "\n"))
    )
    j = j + 1
  }
  out
}

let parse_persistent_module_header_text = (raw: String) -> (Array[String], Array[String]) with { Error } {
  let deps = Array::slice([""], 0, 0)
  let exports = Array::slice([""], 0, 0)
  let mut saw_version = false
  let has_prefix = (line: String, prefix: String) -> Bool {
    let prefix_len = String::length(prefix)
    if String::length(line) < prefix_len {
      false
    } else {
      let mut ok = true
      let mut i = 0
      while ok && i < prefix_len {
        ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)
        i = i + 1
      }
      ok
    }
  }
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  while i < len {
    if String::char_code_at(raw, i) == 10 {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        if has_prefix(line, "version\t") {
          let value = line[8:String::length(line)]
          if !(value == "1") {
            throw("invalid persistent module header version")
          }
          saw_version = true
        } else if has_prefix(line, "dep\t") {
          let value = line[4:String::length(line)]
          if String::length(value) == 0 {
            throw("invalid persistent module header dep row")
          }
          Array::push(deps, value)
        } else if has_prefix(line, "export\t") {
          let value = line[7:String::length(line)]
          if String::length(value) == 0 {
            throw("invalid persistent module header export row")
          }
          Array::push(exports, value)
        } else {
          throw(String::concat("invalid persistent module header row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  let line = strip_trailing_cr(raw[line_start:len])
  if String::length(line) > 0 {
    if has_prefix(line, "version\t") {
      let value = line[8:String::length(line)]
      if !(value == "1") {
        throw("invalid persistent module header version")
      }
      saw_version = true
    } else if has_prefix(line, "dep\t") {
      let value = line[4:String::length(line)]
      if String::length(value) == 0 {
        throw("invalid persistent module header dep row")
      }
      Array::push(deps, value)
    } else if has_prefix(line, "export\t") {
      let value = line[7:String::length(line)]
      if String::length(value) == 0 {
        throw("invalid persistent module header export row")
      }
      Array::push(exports, value)
    } else {
      throw(String::concat("invalid persistent module header row: ", line))
    }
  }
  if !saw_version {
    throw("missing persistent module header version")
  } else {
    (deps, exports)
  }
}

let collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {
  let deps = Array::slice([""], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),
      _ => ()
    }
    i = i + 1
  }
  deps
}

export let load_or_parse_module_header_fs = (
  path: String,
  source: String,
  parse_count: Int
) -> (Array[String], Array[String], Int) with { Error, Fs } {
  load_or_parse_module_header_fs_impl(path, source, parse_count)
}

let store_persistent_manifest_header_cache = (
  entry_path: String,
  manifest_path: String,
  rows: Array[(String, String, String, String)]
) -> Unit with { Error, Fs } {
  Fs::write_file(
    persistent_manifest_header_cache_path(entry_path),
    build_persistent_manifest_header_cache_text(manifest_path, rows)
  )
}

let store_persistent_sources_cache = (
  entry_path: String,
  manifest_path: Option[String],
  sources: Array[(String, String)]
) -> Unit with { Error, Fs } {
  Fs::write_file(
    persistent_source_list_cache_path(entry_path),
    build_persistent_sources_cache_text(manifest_path, sources)
  )
}

let store_persistent_source_groups_cache = (
  entry_path: String,
  manifest_path: Option[String],
  groups: Array[(String, Array[(String, String)])]
) -> Unit with { Error, Fs } {
  Fs::write_file(
    persistent_source_group_cache_path(entry_path),
    build_persistent_source_groups_cache_text(manifest_path, groups)
  )
}

let empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}

let copy_grouped_sources = (
  groups: Array[(String, Array[(String, String)])]
) -> Array[(String, Array[(String, String)])] {
  let out = empty_grouped_sources()
  let mut gi = 0
  while gi < Array::length(groups) {
    let (group_name, sources) = Array::get(groups, gi)
    let copied_sources = copy_source_specs(sources)
    Array::push(out, (group_name, copied_sources))
    gi = gi + 1
  }
  out
}

let rec collect_needed_paths_rec = (
  path: String,
  preloaded_sources: Array[(String, String)],
  visited: Array[String]
) -> Unit with { Error, Fs } {
  if contains_str(visited, path) {
    ()
  } else {
    Array::push(visited, path)
    let source = match source_lookup(preloaded_sources, path) {
      Some(preloaded) => preloaded,
      None => Fs::read_file(path)
    }
    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)
    let mut i = 0
    while i < Array::length(deps) {
      collect_needed_paths_rec(Array::get(deps, i), preloaded_sources, visited)
      i = i + 1
    }
  }
}

let manifest_header_deps_lookup = (
  rows: Array[(String, String, String, String)],
  path: String
) -> Option[Array[String]] {
  let mut i = 0
  let mut found = None
  while i < Array::length(rows) {
    let (row_path, _, _, deps_text) = Array::get(rows, i)
    if row_path == path {
      found = Some(split_header_values(deps_text))
      i = Array::length(rows)
    } else {
      i = i + 1
    }
  }
  found
}

let manifest_header_row_for_path = (
  rows: Array[(String, String, String, String)],
  path: String
) -> Option[(String, String, String, String)] {
  let mut i = 0
  let mut found = None
  while i < Array::length(rows) {
    let row = Array::get(rows, i)
    let (row_path, _, _, _) = row
    if row_path == path {
      found = Some(row)
      i = Array::length(rows)
    } else {
      i = i + 1
    }
  }
  found
}

let append_manifest_header_row_if_missing = (
  rows: Array[(String, String, String, String)],
  row: (String, String, String, String)
) -> Unit {
  let (path, _, _, _) = row
  match manifest_header_row_for_path(rows, path) {
    Some(_) => (),
    None => Array::push(rows, row)
  }
}

let collect_needed_paths_from_manifest_headers = (
  path: String,
  preloaded_sources: Array[(String, String)],
  rows: Array[(String, String, String, String)]
) -> Array[String] with { Error, Fs } {
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let scheduled = Array::slice([""], 0, 0)
  Array::push(worklist, path)
  Array::push(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    if !(contains_str(visited, current)) {
      Array::push(visited, current)
      let deps = match manifest_header_deps_lookup(rows, current) {
        Some(found) => found,
        None => {
          let source = match source_lookup(preloaded_sources, current) {
            Some(preloaded) => preloaded,
            None => Fs::read_file(current)
          }
          let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)
          fallback_deps
        }
      }
      let mut dep_i = 0
      while dep_i < Array::length(deps) {
        let dep_path = Array::get(deps, dep_i)
        if !(contains_str(scheduled, dep_path)) {
          Array::push(worklist, dep_path)
          Array::push(scheduled, dep_path)
          work_len = work_len + 1
        }
        dep_i = dep_i + 1
      }
    }
    work_i = work_i + 1
  }
  visited
}

let collect_needed_paths_and_manifest_headers = (
  path: String,
  preloaded_sources: Array[(String, String)]
) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } {
  let rows = empty_manifest_header_cache_rows()
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let scheduled = Array::slice([""], 0, 0)
  Array::push(worklist, path)
  Array::push(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    if !(contains_str(visited, current)) {
      if work_i == 0 {
        Fs::write_file("_build/collect_manifest_helper_first_current.txt", current)
      }
      Array::push(visited, current)
      let source = match source_lookup(preloaded_sources, current) {
        Some(preloaded) => {
          if work_i == 0 {
            Fs::write_file("_build/collect_manifest_helper_first_source_lookup.txt", "1")
          }
          preloaded
        },
        None => {
          if work_i == 0 {
            Fs::write_file("_build/collect_manifest_helper_first_source_lookup.txt", "0")
          }
          Fs::read_file(current)
        }
      }
      let deps = match manifest_header_deps_lookup(rows, current) {
        Some(found) => found,
        None => {
          let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)
          append_manifest_header_row_if_missing(
            rows,
            (
              current,
              __to_string(Fs::stat_token(current)),
              compact_string_fingerprint(source),
              join_header_values(parsed_deps)
            )
          )
          parsed_deps
        }
      }
      if work_i == 0 {
        Fs::write_file("_build/collect_manifest_helper_first_rows_len.txt", __to_string(Array::length(rows)))
        Fs::write_file("_build/collect_manifest_helper_first_deps_len.txt", __to_string(Array::length(deps)))
      }
      let mut dep_i = 0
      while dep_i < Array::length(deps) {
        let dep_path = Array::get(deps, dep_i)
        if !(contains_str(scheduled, dep_path)) {
          Array::push(worklist, dep_path)
          Array::push(scheduled, dep_path)
          work_len = work_len + 1
        }
        dep_i = dep_i + 1
      }
      if work_i == 0 {
        Fs::write_file("_build/collect_manifest_helper_first_work_len.txt", __to_string(work_len))
      }
    }
    work_i = work_i + 1
  }
  Fs::write_file("_build/collect_manifest_helper_final_rows_len.txt", __to_string(Array::length(rows)))
  Fs::write_file("_build/collect_manifest_helper_final_visited_len.txt", __to_string(Array::length(visited)))
  Fs::write_file("_build/collect_manifest_helper_final_work_i.txt", __to_string(work_i))
  Fs::write_file("_build/collect_manifest_helper_final_work_len.txt", __to_string(work_len))
  (rows, visited)
}

let push_grouped_source = (
  groups: Array[(String, Array[(String, String)])],
  group_name: String,
  path: String,
  source: String
) -> Unit {
  let mut i = 0
  let mut found = false
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == group_name {
      Array::push(sources, (path, source))
      found = true
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  if !found {
    let sources = Array::slice([("", "")], 0, 0)
    Array::push(sources, (path, source))
    Array::push(groups, (group_name, sources))
  }
}

let try_load_manifest_rows = (entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {
  let base_dir = dir_of(entry_path)
  let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
  if !(Fs::exists(manifest_path)) {
    None
  } else {
    let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))
    let mut has_entry = false
    let mut i = 0
    while i < Array::length(rows) {
      let (_, rel_path) = Array::get(rows, i)
      let path = join_path(base_dir, rel_path)
      if path == entry_path {
        has_entry = true
      }
      i = i + 1
    }
    if has_entry {
      Some((base_dir, rows))
    } else {
      None
    }
  }
}

let load_manifest_full_sources = (
  base_dir: String,
  rows: Array[(String, String)]
) -> Array[(String, String)] with { Error, Fs } {
  let full_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    Array::push(full_sources, (path, Fs::read_file(path)))
    i = i + 1
  }
  full_sources
}

let try_collect_manifest_sources_fs = (entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let preloaded_sources = load_manifest_full_sources(base_dir, rows)
      let header_rows = match load_persistent_manifest_header_cache_if_valid(
        entry_path,
        manifest_path,
        preloaded_sources
      ) {
        Some(cached_rows) => cached_rows,
        None => {
          let built_rows = empty_manifest_header_cache_rows()
          let visited = Array::slice([""], 0, 0)
          let worklist = Array::slice([""], 0, 0)
          let scheduled = Array::slice([""], 0, 0)
          Array::push(worklist, entry_path)
          Array::push(scheduled, entry_path)
          let mut work_len = 1
          let mut work_i = 0
          loop {
            if work_i >= work_len {
              break
            }
            let current = Array::get(worklist, work_i)
            if !(contains_str(visited, current)) {
              Array::push(visited, current)
              let source = match source_lookup(preloaded_sources, current) {
                Some(preloaded) => preloaded,
                None => Fs::read_file(current)
              }
              let deps = match manifest_header_deps_lookup(built_rows, current) {
                Some(found) => found,
                None => {
                  let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)
                  append_manifest_header_row_if_missing(
                    built_rows,
                    (
                      current,
                      __to_string(Fs::stat_token(current)),
                      compact_string_fingerprint(source),
                      join_header_values(parsed_deps)
                    )
                  )
                  parsed_deps
                }
              }
              let mut dep_i = 0
              while dep_i < Array::length(deps) {
                let dep_path = Array::get(deps, dep_i)
                if !(contains_str(scheduled, dep_path)) {
                  Array::push(worklist, dep_path)
                  Array::push(scheduled, dep_path)
                  work_len = work_len + 1
                }
                dep_i = dep_i + 1
              }
            }
            work_i = work_i + 1
          }
          store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)
          built_rows
        }
      }
      let needed_paths = Array::slice([""], 0, 0)
      let worklist = Array::slice([""], 0, 0)
      let scheduled = Array::slice([""], 0, 0)
      Array::push(worklist, entry_path)
      Array::push(scheduled, entry_path)
      let mut work_len = 1
      let mut work_i = 0
      loop {
        if work_i >= work_len {
          break
        }
        let current = Array::get(worklist, work_i)
        if !(contains_str(needed_paths, current)) {
          Array::push(needed_paths, current)
          let deps = match manifest_header_deps_lookup(header_rows, current) {
            Some(found) => found,
            None => {
              let mut source = ""
              let mut lookup_i = 0
              while lookup_i < Array::length(preloaded_sources) {
                if source == "" {
                  let (source_path, source_text) = Array::get(preloaded_sources, lookup_i)
                  if source_path == current {
                    source = source_text
                  }
                }
                lookup_i = lookup_i + 1
              }
              if source == "" {
                source = Fs::read_file(current)
              }
              let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)
              fallback_deps
            }
          }
          let mut dep_i = 0
          while dep_i < Array::length(deps) {
            let dep_path = Array::get(deps, dep_i)
            if !(contains_str(scheduled, dep_path)) {
              Array::push(worklist, dep_path)
              Array::push(scheduled, dep_path)
              work_len = work_len + 1
            }
            dep_i = dep_i + 1
          }
        }
        work_i = work_i + 1
      }
      let sources = Array::slice([("", "")], 0, 0)
      let mut j = 0
      while j < Array::length(preloaded_sources) {
        let (path, source) = Array::get(preloaded_sources, j)
        if contains_str(needed_paths, path) {
          Array::push(sources, (path, source))
        }
        j = j + 1
      }
      Some((manifest_path, sources))
    },
    None => None
  }
}

let try_collect_manifest_source_groups_fs = (entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let preloaded_sources = load_manifest_full_sources(base_dir, rows)
      let header_rows = match load_persistent_manifest_header_cache_if_valid(
        entry_path,
        manifest_path,
        preloaded_sources
      ) {
        Some(cached_rows) => cached_rows,
        None => {
          let built_rows = empty_manifest_header_cache_rows()
          let visited = Array::slice([""], 0, 0)
          let worklist = Array::slice([""], 0, 0)
          let scheduled = Array::slice([""], 0, 0)
          Array::push(worklist, entry_path)
          Array::push(scheduled, entry_path)
          let mut work_len = 1
          let mut work_i = 0
          loop {
            if work_i >= work_len {
              break
            }
            let current = Array::get(worklist, work_i)
            if !(contains_str(visited, current)) {
              Array::push(visited, current)
              let source = match source_lookup(preloaded_sources, current) {
                Some(preloaded) => preloaded,
                None => Fs::read_file(current)
              }
              let deps = match manifest_header_deps_lookup(built_rows, current) {
                Some(found) => found,
                None => {
                  let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)
                  append_manifest_header_row_if_missing(
                    built_rows,
                    (
                      current,
                      __to_string(Fs::stat_token(current)),
                      compact_string_fingerprint(source),
                      join_header_values(parsed_deps)
                    )
                  )
                  parsed_deps
                }
              }
              let mut dep_i = 0
              while dep_i < Array::length(deps) {
                let dep_path = Array::get(deps, dep_i)
                if !(contains_str(scheduled, dep_path)) {
                  Array::push(worklist, dep_path)
                  Array::push(scheduled, dep_path)
                  work_len = work_len + 1
                }
                dep_i = dep_i + 1
              }
            }
            work_i = work_i + 1
          }
          store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)
          built_rows
        }
      }
      let needed_paths = Array::slice([""], 0, 0)
      let worklist = Array::slice([""], 0, 0)
      let scheduled = Array::slice([""], 0, 0)
      Array::push(worklist, entry_path)
      Array::push(scheduled, entry_path)
      let mut work_len = 1
      let mut work_i = 0
      loop {
        if work_i >= work_len {
          break
        }
        let current = Array::get(worklist, work_i)
        if !(contains_str(needed_paths, current)) {
          Array::push(needed_paths, current)
          let deps = match manifest_header_deps_lookup(header_rows, current) {
            Some(found) => found,
            None => {
              let source = match source_lookup(preloaded_sources, current) {
                Some(preloaded) => preloaded,
                None => Fs::read_file(current)
              }
              let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)
              fallback_deps
            }
          }
          let mut dep_i = 0
          while dep_i < Array::length(deps) {
            let dep_path = Array::get(deps, dep_i)
            if !(contains_str(scheduled, dep_path)) {
              Array::push(worklist, dep_path)
              Array::push(scheduled, dep_path)
              work_len = work_len + 1
            }
            dep_i = dep_i + 1
          }
        }
        work_i = work_i + 1
      }
      let groups = empty_grouped_sources()
      let mut j = 0
      while j < Array::length(rows) {
        let (group_name, rel_path) = Array::get(rows, j)
        let path = join_path(base_dir, rel_path)
        if contains_str(needed_paths, path) {
          let mut source = ""
          let mut lookup_j = 0
          while lookup_j < Array::length(preloaded_sources) {
            if source == "" {
              let (source_path, source_text) = Array::get(preloaded_sources, lookup_j)
              if source_path == path {
                source = source_text
              }
            }
            lookup_j = lookup_j + 1
          }
          if source == "" {
            ()
          } else {
            push_grouped_source(groups, group_name, path, source)
          }
        }
        j = j + 1
      }
      Some((manifest_path, groups))
    },
    None => None
  }
}

//# Helper functions

// Cache lookup helper
let cache_lookup = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {
  let len = Array::length(cache)
  let mut i = 0
  let mut result = None
  let mut done = false
  while i < len {
    if done {
      i = len
    } else {
      let (p, e) = Array::get(cache, i)
      if p == path {
        result = Some(e)
        done = true
      }
      i = i + 1
    }
  }
  result
}

let export_marker_name = (name: String) -> String {
  String::concat("__vibe_internal_export__:", name)
}

let env_has_export_marker = (env: TypeEnv, name: String) -> Bool {
  match env_lookup(env, export_marker_name(name)) {
    Some(_) => true,
    None => false
  }
}

let bind_export_markers = (env: TypeEnv, exports: Array[String]) -> TypeEnv {
  let mut acc = env
  let mut i = 0
  while i < Array::length(exports) {
    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)
    i = i + 1
  }
  acc
}

// Bind imported names from a checked module's env
let rec bind_checked_imports = (
  names: Array[(String, Option[String])],
  i: Int,
  env: TypeEnv,
  mod_env: TypeEnv
) -> TypeEnv {
  if i >= Array::length(names) {
    env
  } else {
    let (name, alias) = Array::get(names, i)
    let bound_name = match alias {
      Some(a) => a,
      None => name
    }
    let new_env = if env_has_export_marker(mod_env, name) {
      match env_lookup(mod_env, name) {
        Some(ty) => env_bind(env, bound_name, ty),
        None => env
      }
    } else {
      env
    }
    bind_checked_imports(names, i + 1, new_env, mod_env)
  }
}

//# Module Loader

// Check a module and return its TypeEnv, resolving imports recursively.
// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).
export let rec check_module = (
  source: String,
  path: String,
  sources: Array[(String, String)],
  loading: Array[String],
  checked_cache: Array[(String, TypeEnv)]
) -> TypeEnv with { Error } {
  // Check cache first
  let cached = cache_lookup(checked_cache, path)
  match cached {
    Some(env) => env,
    None => {
      // Cycle detection
      if contains_str(loading, path) {
        throw(String::concat("import cycle detected: ", path))
      }
      let tokens = lex(source)
      let stmts = parse_program(tokens)
      let base_dir = dir_of(path)
      let new_loading = Array::concat(loading, [path])

      // Resolve imports using while loop
      let mut import_env = EnvEmpty
      let mut ri = 0
      while ri < Array::length(stmts) {
        let stmt = Array::get(stmts, ri)
        import_env = match stmt {
          SImport(raw_path, names) => {
            match resolve_path_in_sources(base_dir, raw_path, sources) {
              None => throw(String::concat("module not found: ", resolve_path(base_dir, raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)
                bind_checked_imports(names, 0, import_env, mod_env)
              }
            }
          },
          SReExport(raw_path, names) => {
            match resolve_path_in_sources(base_dir, raw_path, sources) {
              None => throw(String::concat("module not found: ", resolve_path(base_dir, raw_path))),
              Some((resolved, mod_source)) => {
                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)
                bind_checked_imports(names, 0, import_env, mod_env)
              }
            }
          },
          _ => import_env
        }
        ri = ri + 1
      }

      // Type-check with imported env
      let empty_defs = Array::slice([TDAlias("_dummy", CtUnit)], 0, 0)
      let check_errors = Array::slice([
        ""
      ], 0, 0)
      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors)

      // Cache result
      let cached_env = bind_export_markers(env, collect_exports(stmts))
      Array::push(checked_cache, (path, cached_env))
      cached_env
    }
  }
}

//# FS-based source collection

let rec collect_sources_rec = (
  path: String,
  sources: Array[(String, String)],
  visited: Array[String]
) -> Unit with { Error, Fs } {
  Fs::write_file("_build/debug_loader_collect_stage.txt", String::concat("collect:", path))
  if contains_str(visited, path) {
    ()
  }
  else {
    Array::push(visited, path)
    let source = Fs::read_file(path)
    Fs::write_file("_build/debug_loader_collect_stage.txt", String::concat("read:", path))
    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)
    Fs::write_file("_build/debug_loader_collect_stage.txt", String::concat("deps:", __to_string(Array::length(deps))))
    // First, recurse into dependencies (imports and re-exports)
    let mut i = 0
    while i < Array::length(deps) {
      collect_sources_rec(Array::get(deps, i), sources, visited)
      i = i + 1
    }
    // Then add this module (dependencies come first)
    Array::push(sources, (path, source))
  }
}

// Recursively collect all source files from filesystem, following imports and re-exports.
// Returns Array[(path, source)] in dependency order (dependencies first).
export let collect_all_sources_fs = (entry_path: String) -> Array[(String, String)] with { Error, Fs } {
  match load_persistent_sources_cache_if_valid(entry_path) {
    Some(sources) => copy_source_specs(sources),
    None =>
      match try_collect_manifest_sources_fs(entry_path) {
        Some((manifest_path, sources)) => {
          store_persistent_sources_cache(entry_path, Some(manifest_path), sources)
          copy_source_specs(sources)
        },
        None =>
          match try_load_manifest_rows(entry_path) {
            Some((base_dir, rows)) => {
              let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
              let preloaded_sources = load_manifest_full_sources(base_dir, rows)
              store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)
              copy_source_specs(preloaded_sources)
            },
            None => {
              let sources = Array::slice([("", "")], 0, 0)
              let visited = Array::slice([""], 0, 0)
              collect_sources_rec(entry_path, sources, visited)
              store_persistent_sources_cache(entry_path, None, sources)
              copy_source_specs(sources)
            }
          }
      }
  }
}

export let collect_source_groups_fs = (entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs } {
  match load_persistent_source_groups_cache_if_valid(entry_path) {
    Some(groups) => copy_grouped_sources(groups),
    None =>
      match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {
        Some((manifest_path, groups)) => {
          store_persistent_source_groups_cache(entry_path, manifest_path, groups)
          copy_grouped_sources(groups)
        },
        None =>
          match try_collect_manifest_source_groups_fs(entry_path) {
            Some((manifest_path, groups)) => {
              store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
              copy_grouped_sources(groups)
            },
            None =>
              match try_load_manifest_rows(entry_path) {
                Some((base_dir, rows)) => {
                  let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)
                  let groups = empty_grouped_sources()
                  let mut j = 0
                  while j < Array::length(rows) {
                    let (group_name, rel_path) = Array::get(rows, j)
                    let path = join_path(base_dir, rel_path)
                    let mut found = ""
                    let mut k = 0
                    while k < Array::length(preloaded_sources) {
                      if found == "" {
                        let (source_path, source_text) = Array::get(preloaded_sources, k)
                        if source_path == path {
                          found = source_text
                        }
                      }
                      k = k + 1
                    }
                    if found == "" {
                      ()
                    } else {
                      push_grouped_source(groups, group_name, path, found)
                    }
                    j = j + 1
                  }
                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)
                  copy_grouped_sources(groups)
                },
                None => {
                  let groups = empty_grouped_sources()
                  let recursive_sources = collect_all_sources_fs(entry_path)
                  Array::push(groups, ("recursive", recursive_sources))
                  store_persistent_source_groups_cache(entry_path, None, groups)
                  copy_grouped_sources(groups)
                }
              }
          }
      }
  }
}

//# Module bundling — merge stmts from all modules in dependency order

// Given all sources (in dependency order), parse and merge their statements.
// Skips SImport, SReExport (already resolved). Keeps all definitions.
export let collect_merged_stmts = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {
  let merged = Array::slice([SExport(["_dummy"])], 0, 0)
  let mut si = 0
  while si < Array::length(sources) {
    let (_, src) = Array::get(sources, si)
    // Use lex+parse_program directly (skip resolve_interp_stmt to reduce heap pressure)
    let stmts = parse_program(lex(src))
    let mut j = 0
    while j < Array::length(stmts) {
      let stmt = Array::get(stmts, j)
      match stmt {
        SImport(_, _) => (),
        SReExport(_, _) => (),
        SAliasDecl(_, _) => (),
        _ => Array::push(merged, stmt)
      }
      j = j + 1
    }
    si = si + 1
  }
  merged
}
