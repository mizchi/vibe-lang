//# Imports

import .. / cache / persistent_module_header_codec.vibe {
  parse_persistent_module_header_text, persistent_module_header_text
}

import .. / cache / persistent_cache.vibe {
  compact_string_fingerprint, normalize_persistent_cache_text, persistent_module_header_cache_path
}

import .. / core / ast.vibe {
  Stmt
}

import .. / module_graph_path.vibe {
  dir_of_path, resolve_import_path_candidates
}

import .. / runtime / eval_loader {
  collect_exports
}

import .. / syntax / lexer.vibe {
  lex, lex_with_offsets
}

import .. / syntax / parser.vibe {
  parse_program, parse_program_located
}

import .. / contract / index.vibe {
  extract_require_pins, parse_contract_program
}

//# Functions

let resolve_path_fs: (String, String, String) -> String with { Fs } = (base_dir, raw_path, self_path) -> {
  let candidates = resolve_import_path_candidates(base_dir, raw_path)
  let mut i = 0
  let mut found = ""
  let mut fallback = ""
  while i < Array::length(candidates) {
    let candidate = Array::get(candidates, i)
    // A directory-style import from a same-named facade file resolves its
    // plain-file candidate to the IMPORTING file itself (`export ./codegen`
    // inside codegen.vibe -> codegen.vibe): a self-dep is never meant, it
    // only manufactures "type_db: import cycle detected". Skip it so the
    // probe falls through to <dir>/index.vibe(i).
    if candidate == self_path {
      ()
    } else {
      if fallback == "" {
        fallback = candidate
      } else {
        ()
      }
      if found == "" && Fs::exists(candidate) {
        found = candidate
      } else {
        ()
      }
    }
    i = i + 1
  }
  if found == "" {
    if fallback == "" {
      Array::get(candidates, 0)
    } else {
      fallback
    }
  } else {
    found
  }
}

let is_special_bundle_path: (String) -> Bool = (path) -> {
  String::ends_with(path, "selfhost_sources_bundle.vibe") || String::ends_with(path, "selfhost_cli_adapter_bundle.vibe") || String::ends_with(path, "selfbuild_runtime_entry_bundle.vibe")
}

let special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {
  if String::ends_with(path, "selfhost_sources_bundle.vibe") {
    Some((Array::slice([
      ""
    ], 0, 0), [
      "selfhost_sources",
      "selfhost_source_groups"
    ]))
  } else if String::ends_with(path, "selfhost_cli_adapter_bundle.vibe") {
    Some((Array::slice([
      ""
    ], 0, 0), [
      "selfhost_cli_adapter_sources",
      "selfhost_cli_adapter_source_groups",
      "selfhost_cli_adapter_ordered_sources",
      "selfhost_cli_adapter_merged_source",
      "selfhost_cli_adapter_module_source"
    ]))
  } else if String::ends_with(path, "selfbuild_runtime_entry_bundle.vibe") {
    Some((Array::slice([
      ""
    ], 0, 0), [
      "selfbuild_runtime_entry_source"
    ]))
  } else {
    None
  }
}

let collect_import_deps_from_stmts: (Array[Stmt], String, String) -> Array[String] with { Fs } = (stmts, base_dir, self_path) -> {
  let deps = Array::slice([
    ""
  ], 0, 0)
  let mut i = 0
  while i < Array::length(stmts) {
    match Array::get(stmts, i) {
      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path, self_path)),
      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path, self_path)),
      _ => ()
    }
    i = i + 1
  }
  deps
}

export let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {
  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))
  if Fs::exists(cache_path) {
    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))
    (parsed.0, parsed.1, parse_count)
  } else {
    // #708: dispatch on `is_special_bundle_path` (a plain Bool) rather than
    // matching `special_bundle_header(path)`'s Option result directly here,
    // and never nest the `Some((deps, exports))` tuple-in-option pattern in
    // the same match as the `None` arm's parse call. A compiler that is
    // itself self-hosted under RC traps ("wasm unreachable" in `tk_name`,
    // reached via `parse_stmt`) reading a corrupted Token tag when
    // `load_or_parse_module_header_fs_impl` is compiled with the call chain
    // that reaches `tk_name` (lex_with_offsets/parse_program_located, or
    // even the plain lex/parse_program pair) sitting inside ONE arm of a
    // `match` on `special_bundle_header(path)`'s `Option` result — even
    // though that arm is never taken for ordinary (non-bundle-file) input.
    // Splitting the dispatch into this Bool `if` (special_bundle_header is
    // then only ever called, and only ever `match`ed, inside the branch that
    // does NOT also reach the parser) reproducibly avoids the trap for the
    // simplest repro. NOT a full fix for #708: a structurally similar crash
    // still reproduces one level deeper (`parse_type_impl`, reached once the
    // input has a type annotation) -- root cause remains uncharacterized, and
    // this workaround likely needs to be repeated at that/other call sites.
    let header_result = if String::ends_with(path, ".vibei") {
      // #740 fallout: a .vibei contract is not ordinary program syntax
      // (bodyless fn/type declarations), so the full-program parse below
      // threw "expected = but got type". Only the COLD-cache lane reaches
      // this parse (warm runs read the cached header), which is why it
      // survived until the whole-graph cold repro. Parse with the contract
      // grammar instead: deps come from the implementation imports, the
      // export surface from decls + opaques + transparent type stmts.
      let (_, pin_blanked) = extract_require_pins(source)
      let (cdecls, copaques, cextra) = parse_contract_program(lex(pin_blanked))
      let cexports = collect_exports(cextra)
      let mut cdi = 0
      while cdi < Array::length(cdecls) {
        let (cdname, _) = Array::get(cdecls, cdi)
        Array::push(cexports, cdname)
        cdi = cdi + 1
      }
      let mut coi = 0
      while coi < Array::length(copaques) {
        let (coname, _) = Array::get(copaques, coi)
        Array::push(cexports, coname)
        coi = coi + 1
      }
      (collect_import_deps_from_stmts(cextra, dir_of_path(path), path), cexports, parse_count + 1)
    } else if is_special_bundle_path(path) {
      match special_bundle_header(path) {
        Some(pair) => {
          let deps = pair.0
          let exports = pair.1
          (deps, exports, parse_count)
        },
        None => (Array::slice([
          ""
        ], 0, 0), Array::slice([
          ""
        ], 0, 0), parse_count)
      }
    } else {
      let (tokens, starts, _ends) = lex_with_offsets(source)
      let stmts = handle {
        parse_program_located(tokens, starts, source)
      } with Error {
        Throw(msg) => throw(String::concat(path, String::concat(": ", msg)))
      }
      (collect_import_deps_from_stmts(stmts, dir_of_path(path), path), collect_exports(stmts), parse_count + 1)
    }
    let deps = header_result.0
    let exports = header_result.1
    let next_parse_count = header_result.2
    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))
    (deps, exports, next_parse_count)
  }
}
