//# Imports

import . / header_cache.vibe {
  load_or_parse_module_header_fs_impl
}

import .. / cache / persistent_cache.vibe {
  compact_string_fingerprint, normalize_persistent_cache_text, persistent_manifest_header_cache_path
}

import .. / module_graph_path.vibe {
  contains_path, dir_of_path, path_set_add, path_set_contains, path_set_new,
  resolve_import_path_candidates
}

import .. / syntax / lexer.vibe {
  lex
}

import .. / syntax / parser_base.vibe {
  collect_import_path, peek, skip_semi
}

import .. / syntax / token.vibe {
  Token
}

//# Path helpers

let join_path: (String, String) -> String = (base_dir, rel_path) -> {
  if base_dir == "" {
    rel_path
  } else {
    String::concat(base_dir, String::concat("/", rel_path))
  }
}

let resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {
  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {
    raw_path
  } else {
    let candidates = resolve_import_path_candidates(base_dir, raw_path)
    let mut i = 0
    let mut found = ""
    while i < Array::length(candidates) {
      if found == "" {
        let candidate = Array::get(candidates, i)
        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {
          found = candidate
        }
      }
      i = i + 1
    }
    if found == "" {
      Array::get(candidates, 0)
    } else {
      found
    }
  }
}

let starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {
  match tok {
    TDot => true,
    _ => false
  }
}

let is_ident_char: (Int) -> Bool = (c) -> {
  (c >= 'a' && c <= 'z') ||
    (c >= 'A' && c <= 'Z') ||
    (c >= '0' && c <= '9') ||
    c == '_'
}

let slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {
  let text_len = String::length(text)
  if start + text_len > String::length(s) {
    false
  } else {
    let mut i = 0
    let mut ok = true
    while ok && i < text_len {
      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)
      i = i + 1
    }
    ok
  }
}

let starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {
  let keyword_len = String::length(keyword)
  if !(slice_eq_text(s, pos, keyword)) {
    false
  } else {
    let before_ok = if pos == 0 {
      true
    } else {
      !(is_ident_char(String::char_code_at(s, pos - 1)))
    }
    let after_pos = pos + keyword_len
    let after_ok = if after_pos >= String::length(s) {
      true
    } else {
      !(is_ident_char(String::char_code_at(s, after_pos)))
    }
    before_ok && after_ok
  }
}

let skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {
  let mut pos = start
  let mut done = false
  while !done && pos < len {
    let c = String::char_code_at(s, pos)
    if c == ' ' || c == '\n' || c == '\t' || c == '\r' || c == ';' {
      pos = pos + 1
    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {
      pos = pos + 2
      while pos < len && String::char_code_at(s, pos) != '\n' {
        pos = pos + 1
      }
    } else {
      done = true
    }
  }
  pos
}

let scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {
  let mut pos = start
  let mut brace_depth = 0
  let mut in_string = false
  let mut string_quote = 0
  let mut escape = false
  let mut done = false
  while pos < len && !done {
    let c = String::char_code_at(s, pos)
    if in_string {
      if escape {
        escape = false
      } else if c == '\\' {
        escape = true
      } else if c == string_quote {
        in_string = false
      }
      pos = pos + 1
    } else if c == '"' || c == '\'' {
      in_string = true
      string_quote = c
      pos = pos + 1
    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {
      while pos < len && String::char_code_at(s, pos) != '\n' {
        pos = pos + 1
      }
    } else if c == '{' {
      brace_depth = brace_depth + 1
      pos = pos + 1
    } else if c == '}' {
      if brace_depth > 0 {
        brace_depth = brace_depth - 1
      }
      pos = pos + 1
    } else if brace_depth == 0 && (c == '\n' || c == ';') {
      done = true
    } else {
      pos = pos + 1
    }
  }
  pos
}

let skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {
  match peek(tokens, pos) {
    TLBrace => {
      let mut depth = 1
      let mut i = pos + 1
      while depth > 0 {
        match peek(tokens, i) {
          TLBrace => {
            depth = depth + 1
          },
          TRBrace => {
            depth = depth - 1
          },
          TEof => throw("unterminated brace list in manifest import scanner"),
          _ => ()
        }
        i = i + 1
      }
      i
    }
    _ => throw("expected '{' in manifest import scanner")
  }
}

let scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {
  let (raw_path, next_pos) = match peek(tokens, pos) {
    TIdent(name) =>
      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {
        (name, pos + 1)
      } else {
        collect_import_path(tokens, pos, "")
      },
    _ => collect_import_path(tokens, pos, "")
  }
  let after_path = match peek(tokens, next_pos) {
    TIdent(alias_name) =>
      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {
        next_pos + 1
      } else {
        next_pos
      },
    _ => next_pos
  }
  let end_pos = match peek(tokens, after_path) {
    TLBrace => skip_brace_list(tokens, after_path),
    _ => after_path
  }
  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)
}

let collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {
  let deps = Array::slice([""], 0, 0)
  let base_dir = dir_of_path(path)
  let len = String::length(source)
  let mut pos = 0
  let mut done = false
  while !done {
    pos = skip_header_ws_and_comments(source, len, pos)
    if pos >= len {
      done = true
    } else {
      let is_import = starts_with_keyword_at(source, pos, "import")
      let is_export = starts_with_keyword_at(source, pos, "export")
      if !(is_import || is_export) {
        done = true
      } else {
        let stmt_end = scan_header_stmt_end(source, len, pos)
        let stmt_source = source[pos:stmt_end]
        let tokens = lex(stmt_source)
        let stmt_pos = skip_semi(tokens, 0)
        match peek(tokens, stmt_pos) {
          TImport => {
            let (dep_path, _) = scan_header_import_dep(
              tokens,
              stmt_pos + 1,
              base_dir,
              manifest_path_index
            )
            Array::push(deps, dep_path)
          },
          TExport => {
            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {
              let (dep_path, _) = scan_header_import_dep(
                tokens,
                stmt_pos + 1,
                base_dir,
                manifest_path_index
              )
              Array::push(deps, dep_path)
            }
          },
          _ => {
            done = true
          }
        }
        pos = stmt_end
      }
    }
  }
  deps
}

let collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {
  handle {
    collect_manifest_header_deps_from_source(path, source, manifest_path_index)
  } with Error {
    Throw(err) => throw("manifest header scan failed for " + path + ": " + err)
  }
}

let is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {
  String::ends_with(path, "selfhost_sources_bundle.vibe")
}

let should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {
  if Map::has_key(manifest_path_index, dep_path) {
    true
  } else {
    !(is_manifest_external_terminal_dep(dep_path))
  }
}

let load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {
  handle {
    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)
    deps
  } with Error {
    Throw(err) => throw("module header parse failed for " + path + ": " + err)
  }
}

export let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(sources) {
    let (path, source) = Array::get(sources, i)
    MapBuilder::set(builder, path, source)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}

let source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {
  if Map::has_key(source_index, path_key) {
    Some(Map::get(source_index, path_key))
  } else {
    None
  }
}

export let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(paths) {
    MapBuilder::set(builder, Array::get(paths, i), true)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}

let empty_path_index: () -> Map[String, Bool] = () -> {
  let builder = MapBuilder::new()
  MapBuilder::freeze(builder)
}

let build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {
  let builder = MapBuilder::new()
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    MapBuilder::set(builder, join_path(base_dir, rel_path), true)
    i = i + 1
  }
  MapBuilder::freeze(builder)
}

let find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {
  let mut base_dir = dir_of_path(entry_path)
  let mut found = None
  let mut done = false
  loop {
    if done {
      break
    }
    let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
    if Fs::exists(manifest_path) {
      found = Some(base_dir)
      done = true
    } else if base_dir == "" {
      done = true
    } else {
      let parent = dir_of_path(base_dir)
      if parent == base_dir {
        done = true
      } else {
        base_dir = parent
      }
    }
  }
  found
}

let strip_trailing_cr: (String) -> String = (line) -> {
  let len = String::length(line)
  if len > 0 {
    if String::char_code_at(line, len - 1) == 13 {
      line[0:len - 1]
    } else {
      line
    }
  } else {
    line
  }
}

let find_char: (String, Int) -> Int = (s, target) -> {
  let len = String::length(s)
  let mut i = 0
  let mut result = -1
  while i < len {
    if String::char_code_at(s, i) == target {
      result = i
      i = len
    } else {
      i = i + 1
    }
  }
  result
}

let split_tsv_fields: (String) -> Array[String] = (line) -> {
  let fields = Array::slice([""], 0, 0)
  let len = String::length(line)
  let mut start = 0
  let mut i = 0
  while i <= len {
    let at_field_end = if i == len {
      true
    } else {
      String::char_code_at(line, i) == 9
    }
    if at_field_end {
      Array::push(fields, line[start:i])
      start = i + 1
    }
    i = i + 1
  }
  fields
}

let header_value_separator = String::from_char_code(31)

let join_header_values: (Array[String]) -> String = (values) -> {
  // O(N) join via StringBuilder; per-value String::concat was O(N²) (issue #366).
  let out = StringBuilder::new()
  let mut i = 0
  while i < Array::length(values) {
    if i > 0 {
      StringBuilder::push(out, header_value_separator)
    }
    StringBuilder::push(out, Array::get(values, i))
    i = i + 1
  }
  StringBuilder::freeze(out)
}

let split_header_values: (String) -> Array[String] = (text) -> {
  let values = Array::slice([""], 0, 0)
  if String::length(text) == 0 {
    values
  } else {
    let sep = String::char_code_at(header_value_separator, 0)
    let len = String::length(text)
    let mut start = 0
    let mut i = 0
    while i <= len {
      let at_value_end = if i == len {
        true
      } else {
        String::char_code_at(text, i) == sep
      }
      if at_value_end {
        Array::push(values, text[start:i])
        start = i + 1
      }
      i = i + 1
    }
    values
  }
}

let empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {
  Array::slice([("", "", "", "")], 0, 0)
}

let empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {
  Array::slice([("", Array::slice([("", "")], 0, 0))], 0, 0)
}

let ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(groups) {
    let (name, sources) = Array::get(groups, i)
    if name == group_name {
      found = Some(sources)
      i = Array::length(groups)
    } else {
      i = i + 1
    }
  }
  match found {
    Some(sources) => sources,
    None => {
      let sources = Array::slice([("", "")], 0, 0)
      Array::push(groups, (group_name, sources))
      sources
    }
  }
}

let build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {
  let groups = empty_grouped_sources()
  let mut last_group_name = ""
  let mut last_group_sources = Array::slice([("", "")], 0, 0)
  let mut has_last_group = false
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    match on_path(path) {
      Some(source) => {
        let bucket = if has_last_group && last_group_name == group_name {
          last_group_sources
        } else {
          let ensured = ensure_grouped_source_bucket(groups, group_name)
          last_group_name = group_name
          last_group_sources = ensured
          has_last_group = true
          ensured
        }
        Array::push(bucket, (path, source))
      },
      None => ()
    }
    i = i + 1
  }
  groups
}

//# Manifest parsing

let parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {
  let rows = Array::slice([("", "")], 0, 0)
  let len = String::length(manifest_source)
  let mut line_start = 0
  let mut i = 0
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(manifest_source, i) == 10
    }
    if at_line_end {
      let raw_line = strip_trailing_cr(manifest_source[line_start:i])
      let line_len = String::length(raw_line)
      let has_content = line_len > 0
      let is_comment = if has_content {
        String::char_code_at(raw_line, 0) == 35
      } else {
        false
      }
      if has_content {
        if is_comment {
          ()
        } else {
          let tab_idx = find_char(raw_line, 9)
          let invalid_row = if tab_idx < 0 {
            true
          } else {
            tab_idx + 1 >= line_len
          }
          if invalid_row {
            throw(String::concat("invalid source manifest row: ", raw_line))
          }
          let group = raw_line[0:tab_idx]
          let path = raw_line[tab_idx + 1:line_len]
          Array::push(rows, (group, path))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  rows
}

export let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  match find_manifest_base_dir(entry_path) {
    Some(base_dir) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))
      let mut has_entry = false
      let mut i = 0
      while i < Array::length(rows) {
        let (_, rel_path) = Array::get(rows, i)
        let path = join_path(base_dir, rel_path)
        if path == entry_path {
          has_entry = true
        }
        i = i + 1
      }
      if has_entry {
        Some((base_dir, rows))
      } else {
        None
      }
    },
    None => None
  }
}

export let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {
  let full_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    Array::push(full_sources, (path, Fs::read_file(path)))
    i = i + 1
  }
  full_sources
}

let load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {
  let sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(rows) {
    let (_, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    if Map::has_key(needed_path_index, path) {
      Array::push(sources, (path, Fs::read_file(path)))
    }
    i = i + 1
  }
  sources
}

let load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {
  let groups = empty_grouped_sources()
  let mut last_group_name = ""
  let mut last_group_sources = Array::slice([("", "")], 0, 0)
  let mut has_last_group = false
  let mut i = 0
  while i < Array::length(rows) {
    let (group_name, rel_path) = Array::get(rows, i)
    let path = join_path(base_dir, rel_path)
    if Map::has_key(needed_path_index, path) {
      let bucket = if has_last_group && last_group_name == group_name {
        last_group_sources
      } else {
        let ensured = ensure_grouped_source_bucket(groups, group_name)
        last_group_name = group_name
        last_group_sources = ensured
        has_last_group = true
        ensured
      }
      Array::push(bucket, (path, Fs::read_file(path)))
    }
    i = i + 1
  }
  groups
}

export let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {
  build_grouped_sources_from_manifest_rows_with_lookup(
    base_dir,
    rows,
    (path: String) -> Option[String] {
      source_lookup_in_index(source_index, path)
    }
  )
}

export let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {
  let source_index = build_manifest_source_index(sources)
  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)
}

export let filter_manifest_sources_by_path_index: (Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] = (preloaded_sources, needed_path_index) -> {
  let filtered_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(preloaded_sources) {
    let (path, source) = Array::get(preloaded_sources, i)
    if Map::has_key(needed_path_index, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  filtered_sources
}

export let filter_manifest_sources_by_paths: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {
  let needed_path_index = build_manifest_path_index(needed_paths)
  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)
}

export let filter_manifest_sources_by_paths_linear: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {
  let filtered_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(preloaded_sources) {
    let (path, source) = Array::get(preloaded_sources, i)
    if contains_path(needed_paths, path) {
      Array::push(filtered_sources, (path, source))
    }
    i = i + 1
  }
  filtered_sources
}

export let filter_manifest_sources_by_source_index: (Array[String], Map[String, String]) -> Array[(String, String)] = (needed_paths, preloaded_source_index) -> {
  let filtered_sources = Array::slice([("", "")], 0, 0)
  let mut i = 0
  while i < Array::length(needed_paths) {
    let path = Array::get(needed_paths, i)
    match source_lookup_in_index(preloaded_source_index, path) {
      Some(source) => Array::push(filtered_sources, (path, source)),
      None => ()
    }
    i = i + 1
  }
  filtered_sources
}

//# Manifest header cache

let parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {
  let len = String::length(raw)
  let mut line_start = 0
  let mut i = 0
  let mut version = 0
  let mut manifest = None
  let rows = empty_manifest_header_cache_rows()
  while i <= len {
    let at_line_end = if i == len {
      true
    } else {
      String::char_code_at(raw, i) == 10
    }
    if at_line_end {
      let line = strip_trailing_cr(raw[line_start:i])
      if String::length(line) > 0 {
        let fields = split_tsv_fields(line)
        let tag = Array::get(fields, 0)
        if tag == "version" {
          if Array::length(fields) != 2 {
            throw("invalid persistent manifest header cache version")
          }
          let version_text = Array::get(fields, 1)
          if version_text == "1" {
            version = 1
          } else if version_text == "2" {
            version = 2
          } else {
            throw("invalid persistent manifest header cache version")
          }
        } else if tag == "manifest" {
          if Array::length(fields) != 4 {
            throw("invalid persistent manifest header cache manifest row")
          }
          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))
        } else if tag == "header" {
          if version == 1 {
            if Array::length(fields) != 6 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(
              rows,
              (
                Array::get(fields, 1),
                Array::get(fields, 2),
                Array::get(fields, 3),
                Array::get(fields, 4)
              )
            )
          } else {
            if Array::length(fields) != 5 {
              throw("invalid persistent manifest header cache header row")
            }
            Array::push(
              rows,
              (
                Array::get(fields, 1),
                Array::get(fields, 2),
                Array::get(fields, 3),
                Array::get(fields, 4)
              )
            )
          }
        } else {
          throw(String::concat("invalid persistent manifest header cache row: ", line))
        }
      }
      line_start = i + 1
    }
    i = i + 1
  }
  (version, manifest, rows)
}

let matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {
  if !(Fs::exists(path)) {
    false
  } else {
    let has_stat_token = String::length(stat_token_text) > 0
    if has_stat_token {
      if __to_string(Fs::stat_token(path)) == stat_token_text {
        true
      } else if String::length(source_fingerprint) > 0 {
        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
      } else {
        false
      }
    } else if String::length(source_fingerprint) > 0 {
      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint
    } else {
      false
    }
  }
}

let load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {
  let cache_path = persistent_manifest_header_cache_path(entry_path)
  if !(Fs::exists(cache_path)) {
    None
  } else {
    let (_, manifest, rows) = parse_persistent_manifest_header_cache(
      normalize_persistent_cache_text(Fs::read_file(cache_path))
    )
    let manifest_ok = match manifest {
      Some((cached_path, stat_token_text, source_fingerprint)) =>
        cached_path == manifest_path &&
          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),
      None => false
    }
    if !manifest_ok {
      None
    } else {
      let mut valid = true
      let mut i = 0
      while i < Array::length(rows) {
        if valid {
          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)
          if !(Map::has_key(manifest_path_index, path)) {
            valid = false
          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {
            valid = false
          }
        }
        i = i + 1
      }
      if valid {
        Some(rows)
      } else {
        None
      }
    }
  }
}

let build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {
  let mut out = "version\t2\n"
  out = String::concat(
    out,
    String::concat(
      "manifest\t",
      String::concat(
        manifest_path,
        String::concat(
          "\t",
          String::concat(
            __to_string(Fs::stat_token(manifest_path)),
            String::concat("\t", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), "\n"))
          )
        )
      )
    )
  )
  let mut i = 0
  while i < Array::length(rows) {
    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)
    out = String::concat(
      out,
      String::concat(
        "header\t",
        String::concat(
          path,
          String::concat(
            "\t",
            String::concat(
              stat_token_text,
              String::concat(
                "\t",
                String::concat(
                  source_fingerprint,
                  String::concat("\t", String::concat(deps_text, "\n"))
                )
              )
            )
          )
        )
      )
    )
    i = i + 1
  }
  out
}

let store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {
  Fs::write_file(
    persistent_manifest_header_cache_path(entry_path),
    build_persistent_manifest_header_cache_text(manifest_path, rows)
  )
}

let manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {
  let mut i = 0
  let mut found = None
  while i < Array::length(rows) {
    let (row_path, _, _, deps_text) = Array::get(rows, i)
    if row_path == path {
      found = Some(split_header_values(deps_text))
      i = Array::length(rows)
    } else {
      i = i + 1
    }
  }
  found
}

// #533: schedule-time dedup via a mutable `path_set`. The previous
// `Map[String, Bool]` scheduled-set copied the whole map on every
// `Map::set` (O(N) per insert → O(N²) total) and linearly scanned it per
// `Map::has_key`; the pop-time `contains_path(visited, current)` guard
// was another O(edges × modules) scan that could never fire, because
// every worklist push is gated on the scheduled set, making worklist
// entries unique by construction. `visited` stays an insertion-ordered
// array — it is the returned needed-paths list. (Same pattern in the two
// sibling collectors below.)
let collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let scheduled = path_set_new()
  Array::push(worklist, path)
  path_set_add(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    Array::push(visited, current)
    let deps = match manifest_header_deps_lookup(rows, current) {
      Some(found) => found,
      None => {
        let source = Fs::read_file(current)
        if Map::has_key(manifest_path_index, current) {
          collect_manifest_header_deps_from_source_with_context(
            current,
            source,
            manifest_path_index
          )
        } else {
          load_or_parse_module_header_deps_with_context(current, source)
        }
      }
    }
    let mut dep_i = 0
    while dep_i < Array::length(deps) {
      let dep_path = Array::get(deps, dep_i)
      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
        !(path_set_contains(scheduled, dep_path)) {
        Array::push(worklist, dep_path)
        path_set_add(scheduled, dep_path)
        work_len = work_len + 1
      }
      dep_i = dep_i + 1
    }
    work_i = work_i + 1
  }
  visited
}

let collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {
  let rows = empty_manifest_header_cache_rows()
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let scheduled = path_set_new()
  Array::push(worklist, path)
  path_set_add(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    Array::push(visited, current)
    let source = Fs::read_file(current)
    let deps = match manifest_header_deps_lookup(rows, current) {
      Some(found) => found,
      None => {
        let parsed_deps = if Map::has_key(manifest_path_index, current) {
          collect_manifest_header_deps_from_source_with_context(
            current,
            source,
            manifest_path_index
          )
        } else {
          load_or_parse_module_header_deps_with_context(current, source)
        }
        Array::push(
          rows,
          (
            current,
            __to_string(Fs::stat_token(current)),
            compact_string_fingerprint(source),
            join_header_values(parsed_deps)
          )
        )
        parsed_deps
      }
    }
    let mut dep_i = 0
    while dep_i < Array::length(deps) {
      let dep_path = Array::get(deps, dep_i)
      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
        !(path_set_contains(scheduled, dep_path)) {
        Array::push(worklist, dep_path)
        path_set_add(scheduled, dep_path)
        work_len = work_len + 1
      }
      dep_i = dep_i + 1
    }
    work_i = work_i + 1
  }
  (rows, visited)
}

let collect_needed_paths_from_manifest_scan: (String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, manifest_path_index) -> {
  let visited = Array::slice([""], 0, 0)
  let worklist = Array::slice([""], 0, 0)
  let scheduled = path_set_new()
  Array::push(worklist, path)
  path_set_add(scheduled, path)
  let mut work_len = 1
  let mut work_i = 0
  loop {
    if work_i >= work_len {
      break
    }
    let current = Array::get(worklist, work_i)
    Array::push(visited, current)
    let source = Fs::read_file(current)
    let deps = if Map::has_key(manifest_path_index, current) {
      collect_manifest_header_deps_from_source_with_context(
        current,
        source,
        manifest_path_index
      )
    } else {
      load_or_parse_module_header_deps_with_context(current, source)
    }
    let mut dep_i = 0
    while dep_i < Array::length(deps) {
      let dep_path = Array::get(deps, dep_i)
      if should_schedule_manifest_dep(dep_path, manifest_path_index) &&
        !(path_set_contains(scheduled, dep_path)) {
        Array::push(worklist, dep_path)
        path_set_add(scheduled, dep_path)
        work_len = work_len + 1
      }
      dep_i = dep_i + 1
    }
    work_i = work_i + 1
  }
  visited
}

let load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {
  match load_persistent_manifest_header_cache_if_valid(
    entry_path,
    manifest_path,
    manifest_path_index
  ) {
    Some(cached_rows) => cached_rows,
    None => {
      let (built_rows, _) = collect_needed_paths_and_manifest_headers(
        entry_path,
        manifest_path_index
      )
      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)
      built_rows
    }
  }
}

export let probe_manifest_header_rows_count: (String) -> Int with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(
        entry_path,
        manifest_path,
        manifest_path_index
      )
      Array::length(header_rows)
    },
    None => throw("manifest rows unavailable")
  }
}

export let probe_manifest_header_rows_uncached_count: (String) -> Int with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let (header_rows, _) = collect_needed_paths_and_manifest_headers(
        entry_path,
        manifest_path_index
      )
      Array::length(header_rows)
    },
    None => throw("manifest rows unavailable")
  }
}

export let probe_manifest_needed_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(
        entry_path,
        manifest_path,
        manifest_path_index
      )
      let needed_paths = collect_needed_paths_from_manifest_headers(
        entry_path,
        manifest_path_index,
        header_rows
      )
      Array::length(needed_paths)
    },
    None => throw("manifest rows unavailable")
  }
}

export let probe_manifest_scan_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let needed_paths = collect_needed_paths_from_manifest_scan(
        entry_path,
        manifest_path_index
      )
      Array::length(needed_paths)
    },
    None => throw("manifest rows unavailable")
  }
}

//# Source collection

export let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(
        entry_path,
        manifest_path,
        manifest_path_index
      )
      let needed_paths = collect_needed_paths_from_manifest_headers(
        entry_path,
        manifest_path_index,
        header_rows
      )
      let needed_path_index = build_manifest_path_index(needed_paths)
      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)
      Some((manifest_path, sources))
    },
    None => None
  }
}

export let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {
  match try_load_manifest_rows(entry_path) {
    Some((base_dir, rows)) => {
      let manifest_path = join_path(base_dir, "selfhost_sources_manifest.tsv")
      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)
      let header_rows = load_or_collect_manifest_header_rows(
        entry_path,
        manifest_path,
        manifest_path_index
      )
      let needed_paths = collect_needed_paths_from_manifest_headers(
        entry_path,
        manifest_path_index,
        header_rows
      )
      let needed_path_index = build_manifest_path_index(needed_paths)
      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)
      Some((manifest_path, groups))
    },
    None => None
  }
}
