//# Imports

import ./compiler.vibe {
  compile_source, compile_source_wasi
}

//# CLI Entry Point
//
// Usage (via interpreter):
//   VIBE_INPUT=input.vibe VIBE_OUTPUT=output.wasm vibe run vibe/compiler/cli.vibe
//
// Optional env vars:
//   VIBE_ENTRY  — WASI entry function name (default: none, produces standalone module)
//   VIBE_INPUT  — input .vibe file path (required)
//   VIBE_OUTPUT — output .wasm file path (required)

export let main = () -> Int with { Error, Fs, Process, Env, Stdout, Stdin } {
  let input_path = env_get("VIBE_INPUT")
  let output_path = env_get("VIBE_OUTPUT")
  let entry = env_get("VIBE_ENTRY")

  if string_equals(input_path, "") {
    1
  }
  else if string_equals(output_path, "") {
    1
  }
  else {
    let source = fs_read_file(input_path)
    let bytes = if string_equals(entry, "") {
      compile_source(source)
    } else {
      compile_source_wasi(source, entry)
    }
    fs_write_bytes(output_path, bytes)
    0
  }
}
