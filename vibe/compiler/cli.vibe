//# Imports

import ./cli_cache.vibe {
  compile_jobs_cached, parse_batch_jobs_tsv
}

import ./type_db.vibe {
  db_new
}

//# Functions

export let main = () -> Int with { Error, Fs, Process, Env, Stdout, Stdin } {
  let batch_tsv = Env::get("VIBE_BATCH_TSV")
  let input_path = Env::get("VIBE_INPUT")
  let output_path = Env::get("VIBE_OUTPUT")
  let entry = Env::get("VIBE_ENTRY")
  if not(batch_tsv == "") {
    let jobs = parse_batch_jobs_tsv(batch_tsv)
    let _ = compile_jobs_cached(db_new(), jobs)
    0
  }
  else if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else {
    let _ = compile_jobs_cached(db_new(), [
      (input_path, output_path, entry)
    ])
    0
  }
}
