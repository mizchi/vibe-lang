//# Imports

import ./compiler.vibe {
  compile_source, compile_source_wasi
}

//# Functions

export let main = () -> Int with { Error, Fs, Process, Env, Stdout, Stdin } {
  let input_path = Env::get("VIBE_INPUT")
  let output_path = Env::get("VIBE_OUTPUT")
  let entry = Env::get("VIBE_ENTRY")
  if String::equals(input_path, "") {
    1
  }
  else if String::equals(output_path, "") {
    1
  }
  else {
    let source = Fs::read_file(input_path)
    let bytes = if String::equals(entry, "") {
      compile_source(source)
    } else {
      compile_source_wasi(source, entry)
    }
    Fs::write_bytes(output_path, bytes)
    0
  }
}
