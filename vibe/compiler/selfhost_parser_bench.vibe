//# Imports

import ./parser_hotspot_probe.vibe {
  load_parser_token_fixture,
  probe_parse_program_count,
  probe_parse_program_repeat_count
}

//# Misc

let (
  lexer_tokens,
  checker_tokens,
  parser_tokens,
  deep_tokens,
  match_tokens
) = load_parser_token_fixture()

bench "selfhost/parse_lexer_vibe" {
  let _ = handle {
    probe_parse_program_count(lexer_tokens)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/parse_checker_vibe" {
  let _ = handle {
    probe_parse_program_count(checker_tokens)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/parse_parser_vibe" {
  let _ = handle {
    probe_parse_program_count(parser_tokens)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/parse_deep_binop_chain" {
  let _ = handle {
    probe_parse_program_repeat_count(deep_tokens, 32)
  } with Error {
    Throw(_) => 0
  }
}

bench "selfhost/parse_wide_match" {
  let _ = handle {
    probe_parse_program_repeat_count(match_tokens, 32)
  } with Error {
    Throw(_) => 0
  }
}
