//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./checker_stmt.vibe {
  check_program, check_stmts
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, types_equal
}

//# Functions

let _no_tp = array_slice([
  ""
], 0, 0)

let _no_tb = array_slice([
  ("", _no_tp)
], 0, 0)

let empty_defs = () -> Array[TypeDef] {
  array_slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
}

let check_stmts_compat = (stmts: Array[Stmt]) -> TypeEnv {
  let (env, _, _) = check_stmts(stmts, 0, EnvEmpty, empty_defs(), SubstEmpty, 0)
  env
}

//# Misc

test "SLet binds int" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  let env = check_stmts_compat(stmts)
  let ty = env_lookup(env, "x")
  match ty {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SLet binds string" {
  let stmts = [
    SLet(false, false, "name", None, EString("hi"))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "name") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "SLetMut binds" {
  let stmts = [
    SLetMut("count", None, EInt(0))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "count") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SLet rec binds" {
  let body = EFn(_no_tp, _no_tb, [
    ("n", None)
  ], None, None, EInt(1))
  let stmts = [
    SLet(false, true, "fact", None, body)
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "fact") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SEnum binds type name" {
  let stmts = [
    SEnum(false, "Color", [
      ("Red", array_slice([
        TyUnit
      ], 0, 0))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "Color") {
    Some(t) => assert(types_equal(t, CtEnum("Color"))),
    None => assert(false)
  }
}

test "SStruct binds type name" {
  let stmts = [
    SStruct(false, "Point", [
      ("x", TyName("Int"))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "Point") {
    Some(t) => assert(types_equal(t, CtStruct("Point"))),
    None => assert(false)
  }
}

test "SExternLet binds" {
  let stmts = [
    SExternLet("print", TyFn([
      TyName("String")
    ], TyUnit))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "print") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "multiple stmts thread env" {
  let stmts = [
    SLet(false, false, "x", None, EInt(1)),
    SLet(false, false, "y", None, EString("hi")),
    SLet(false, false, "z", None, EBool(true))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
  match env_lookup(env, "y") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
  match env_lookup(env, "z") {
    Some(t) => assert(types_equal(t, CtBool)),
    None => assert(false)
  }
}

test "SExpr does not change env" {
  let stmts = [
    SExpr(EInt(42))
  ]
  let env = check_stmts_compat(stmts)
  match env {
    EnvEmpty => assert(true),
    _ => assert(false)
  }
}

test "STest does not change env" {
  let stmts = [
    STest("my test", EBool(true))
  ]
  let env = check_stmts_compat(stmts)
  match env {
    EnvEmpty => assert(true),
    _ => assert(false)
  }
}

test "check_program returns env" {
  let stmts = [
    SLet(false, false, "x", None, EInt(42))
  ]
  let env = check_program(stmts)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SLet with type annotation uses annotation" {
  let stmts = [
    SLet(false, false, "x", Some(TyName("Int")), EInt(42))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "x") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SLetMut with type annotation uses annotation" {
  let stmts = [
    SLetMut("count", Some(TyName("Int")), EInt(0))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "count") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SExternLet resolves simple type" {
  let stmts = [
    SExternLet("get_name", TyName("String"))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "get_name") {
    Some(t) => assert(types_equal(t, CtString)),
    None => assert(false)
  }
}

test "STypeAlias resolves builtin type" {
  let stmts = [
    STypeAlias(false, "MyInt", TyName("Int"))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "MyInt") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}

test "SImport binds imported names" {
  let stmts = [
    SImport("./foo.vibe", [
      ("bar", None)
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "bar") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SImport binds aliased name" {
  let stmts = [
    SImport("./foo.vibe", [
      ("bar", Some("baz"))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "baz") {
    Some(_) => assert(true),
    None => assert(false)
  }
}

test "SImport binds multiple names" {
  let stmts = [
    SImport("./mod.vibe", [
      ("a", None),
      ("b", Some("c"))
    ])
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "a") {
    Some(_) => match env_lookup(env, "c") {
      Some(_) => assert(true),
      None => assert(false)
    }
    ,
    None => assert(false)
  }
}

test "let uses previous binding" {
  let stmts = [
    SLet(false, false, "x", None, EInt(1)),
    SLet(false, false, "y", None, EIdent("x"))
  ]
  let env = check_stmts_compat(stmts)
  match env_lookup(env, "y") {
    Some(t) => assert(types_equal(t, CtInt)),
    None => assert(false)
  }
}
