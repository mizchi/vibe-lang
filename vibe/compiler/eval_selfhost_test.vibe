//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

test "selfhost: enum and ctor matching" {
  let src = "export enum Value {\n  VInt(Int);\n  VString(String);\n  VBool(Bool);\n  VUnit\n}\nlet v = VInt(42)\nlet result = match v {\n  VInt(n) => n,\n  _ => 0\n}"
  assert(string_equals(run_and_lookup(src, "result"), "42"))
}

test "selfhost: recursive value_to_string" {
  let src = "export enum Val {\n  VInt(Int);\n  VStr(String);\n  VBool(Bool);\n  VUnit\n}\nlet rec val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s,\n    VBool(b) => if b { \"true\" } else { \"false\" },\n    VUnit => \"()\"\n  }\n}\nlet result = val_to_str(VInt(99))"
  assert(string_equals(run_and_lookup(src, "result"), "99"))
}

test "selfhost: string_char_code_at" {
  let src = "let is_digit = (c: Int) -> Bool {\n  c >= 48 && c <= 57\n}\nlet s = \"abc123\"\nlet c0 = string_char_code_at(s, 0)\nlet c3 = string_char_code_at(s, 3)\nlet r0 = is_digit(c0)\nlet r3 = is_digit(c3)\nlet result = if r0 { \"bad\" } else { if r3 { \"ok\" } else { \"bad\" } }"
  assert(string_equals(run_and_lookup(src, "result"), "ok"))
}

test "selfhost: string_substring" {
  let src = "let path = \"dir/sub/file.vibe\"\nlet idx = string_last_index_of(path, \"/\")\nlet dir = string_substring(path, 0, idx)\nlet result = dir"
  assert(string_equals(run_and_lookup(src, "result"), "dir/sub"))
}

test "selfhost: string_ends_with" {
  let src = "let p1 = \"foo.vibe\"\nlet p2 = \"bar.txt\"\nlet r1 = string_ends_with(p1, \".vibe\")\nlet r2 = string_ends_with(p2, \".vibe\")\nlet result = if r1 { if r2 { \"bad\" } else { \"ok\" } } else { \"bad\" }"
  assert(string_equals(run_and_lookup(src, "result"), "ok"))
}

test "selfhost: multi-file import" {
  let sources = [
    ("main.vibe", "import ./vals.vibe { Val, VInt, VStr, val_to_str }\nlet v = VInt(77)\nlet result = val_to_str(v)"),
    ("vals.vibe", "export enum Val {\n  VInt(Int);\n  VStr(String)\n}\nexport let val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s\n  }\n}")
  ]
  assert(string_equals(run_with_imports(sources, "main.vibe", "result"), "77"))
}

test "selfhost: while loop counter" {
  let src = "let s = \"hello world\"\nlet len = string_length(s)\nlet mut count = 0\nwhile count < len {\n  count = count + 1\n}\nlet result = count"
  assert(string_equals(run_and_lookup(src, "result"), "11"))
}

test "selfhost: recursive array sum" {
  let src = "let rec sum_arr = (arr: Array[Int], i: Int) -> Int {\n  if i >= array_length(arr) { 0 }\n  else { array_get(arr, i) + sum_arr(arr, i + 1) }\n}\nlet result = sum_arr([10, 20, 30], 0)"
  assert(string_equals(run_and_lookup(src, "result"), "60"))
}
