//# Imports

import ./eval_e2e_helpers.vibe {
  run_and_lookup, run_with_imports
}

//# Misc

test "selfhost: enum and ctor matching" {
  let src = "export enum Value {\n  VInt(Int);\n  VString(String);\n  VBool(Bool);\n  VUnit\n}\nlet v = VInt(42)\nlet result = match v {\n  VInt(n) => n,\n  _ => 0\n}"
  assert(String::equals(run_and_lookup(src, "result"), "42"))
}

test "selfhost: recursive value_to_string" {
  let src = "export enum Val {\n  VInt(Int);\n  VStr(String);\n  VBool(Bool);\n  VUnit\n}\nlet rec val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s,\n    VBool(b) => if b { \"true\" } else { \"false\" },\n    VUnit => \"()\"\n  }\n}\nlet result = val_to_str(VInt(99))"
  assert(String::equals(run_and_lookup(src, "result"), "99"))
}

test "selfhost: String::char_code_at" {
  let src = "let is_digit = (c: Int) -> Bool {\n  c >= 48 && c <= 57\n}\nlet s = \"abc123\"\nlet c0 = String::char_code_at(s, 0)\nlet c3 = String::char_code_at(s, 3)\nlet r0 = is_digit(c0)\nlet r3 = is_digit(c3)\nlet result = if r0 { \"bad\" } else { if r3 { \"ok\" } else { \"bad\" } }"
  assert(String::equals(run_and_lookup(src, "result"), "ok"))
}

test "selfhost: String::substring" {
  let src = "let path = \"dir/sub/file.vibe\"\nlet idx = String::last_index_of(path, \"/\")\nlet dir = String::substring(path, 0, idx)\nlet result = dir"
  assert(String::equals(run_and_lookup(src, "result"), "dir/sub"))
}

test "selfhost: String::ends_with" {
  let src = "let p1 = \"foo.vibe\"\nlet p2 = \"bar.txt\"\nlet r1 = String::ends_with(p1, \".vibe\")\nlet r2 = String::ends_with(p2, \".vibe\")\nlet result = if r1 { if r2 { \"bad\" } else { \"ok\" } } else { \"bad\" }"
  assert(String::equals(run_and_lookup(src, "result"), "ok"))
}

test "selfhost: multi-file import" {
  let sources = [
    ("main.vibe", "import ./vals.vibe { Val, VInt, VStr, val_to_str }\nlet v = VInt(77)\nlet result = val_to_str(v)"),
    ("vals.vibe", "export enum Val {\n  VInt(Int);\n  VStr(String)\n}\nexport let val_to_str = (v: Val) -> String {\n  match v {\n    VInt(n) => __to_string(n),\n    VStr(s) => s\n  }\n}")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "77"))
}

test "selfhost: import alias" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { x as y }\nlet result = y"),
    ("lib.vibe", "export let x = 99")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "99"))
}

test "selfhost: import export block" {
  let sources = [
    ("main.vibe", "import ./lib.vibe { add }\nlet result = add(1, 2)"),
    ("lib.vibe", "let add = (a: Int, b: Int) -> Int { a + b }\nexport { add }")
  ]
  assert(String::equals(run_with_imports(sources, "main.vibe", "result"), "3"))
}

test "selfhost: forward reference" {
  let src = "let double_then_add = (x: Int) -> Int {\n  add_one(x * 2)\n}\nlet add_one = (x: Int) -> Int {\n  x + 1\n}\nlet result = double_then_add(5)"
  assert(String::equals(run_and_lookup(src, "result"), "11"))
}

test "selfhost: import cycle detected" {
  let sources = [
    ("a.vibe", "import ./b.vibe { y }\nexport let x = 1"),
    ("b.vibe", "import ./a.vibe { x }\nexport let y = 2")
  ]
  let result = run_with_imports(sources, "a.vibe", "x")
  assert(String::starts_with(result, "ERROR: import cycle"))
}

test "selfhost: import module not found" {
  let sources = [
    ("main.vibe", "import ./missing.vibe { x }\nlet result = x")
  ]
  let result = run_with_imports(sources, "main.vibe", "result")
  assert(String::starts_with(result, "ERROR: module not found"))
}
