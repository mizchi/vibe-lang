//# Imports

import ./codegen / wasi {
  compile_wasi_module_linked_impl
}

import ./core / ast.vibe {
  Expr, Stmt
}

import ./entry / source_compile / wasi_only / linked_artifacts.vibe {
  collect_linked_compile_inputs
}

import ./entry / source_compile / wasi_only / path_utils.vibe {
  empty_stmt_array
}

import ./entry / source_compile / wasi_only {
  compile_file_wasi_library, compile_source_wasi_only
}

//# Functions

export let read_arg = (index: Int) -> String {
  if perform Env::ArgsLen > index {
    perform Env::ArgsGet(index)
  } else {
    ""
  }
}

let read_arg_or_env = (index: Int, env_name: String) -> String {
  let value = read_arg(index)
  if value != "" {
    value
  } else {
    perform Env::Get(env_name)
  }
}

let append_stmt_array = (dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    Array::push(dst, Array::get(src, i))
    i = i + 1
  }
}

let linked_output_dir = (output_path: String) -> String {
  let len = String::length(output_path)
  if len >= 5 && output_path[len - 5: len] == ".wasm" {
    String::concat(output_path[0: len - 5], ".debug")
  } else {
    String::concat(output_path, ".debug")
  }
}

let empty_source_pairs = () -> Array[(String, String)] {
  Array::slice([
    ("", "")
  ], 0, 0)
}

export let compile_release_file = (input_path: String, entry_name: String) -> Bytes with { Error, Fs } {
  let source = perform Fs::ReadFile(input_path)
  compile_source_wasi_only(source, entry_name)
}

export let compile_debug_library = (dep_path: String) -> Bytes with { Error, Fs } {
  compile_file_wasi_library(dep_path)
}

let append_non_import_stmts = (dst: Array[Stmt], src: Array[Stmt]) -> Unit {
  let mut i = 0
  while i < Array::length(src) {
    match Array::get(src, i) {
      SImport(_, _) => (),
      SReExport(_, _) => (),
      SAliasDecl(_, _) => (),
      _ => Array::push(dst, Array::get(src, i))
    }
    i = i + 1
  }
}

export let build_linked_debug_entry = (input_path: String, entry_name: String) -> (Bytes, Array[(String, String)])with { Error, Fs } {
  let (entry_stmts, resolved_type_stmts, linked_imports, linked_dep_specs) = collect_linked_compile_inputs(input_path)
  let main_stmts = empty_stmt_array()
  append_stmt_array(main_stmts, resolved_type_stmts)
  append_non_import_stmts(main_stmts, entry_stmts)
  let bytes = compile_wasi_module_linked_impl(main_stmts, entry_name, empty_source_pairs(), linked_imports, false)
  (bytes, linked_dep_specs)
}

export let write_linked_debug_build = (input_path: String, output_path: String, entry_name: String) -> Unit with { Error, Fs } {
  let (entry_bytes, linked_dep_specs) = build_linked_debug_entry(input_path, entry_name)
  Fs::write_bytes(output_path, entry_bytes)
  let output_dir = linked_output_dir(output_path)
  let mut i = 0
  while i < Array::length(linked_dep_specs) {
    let (module_name, dep_path) = Array::get(linked_dep_specs, i)
    let lib_output_path = String::concat(output_dir, String::concat("/", String::concat(module_name, ".wasm")))
    let lib_bytes = compile_debug_library(dep_path)
    Fs::write_bytes(lib_output_path, lib_bytes)
    i = i + 1
  }
}

export let cli_main = () -> Int with { Error, Fs, Env } {
  let input_path = read_arg_or_env(0, "VIBE_INPUT")
  let output_path = read_arg_or_env(1, "VIBE_OUTPUT")
  let entry_name = read_arg_or_env(2, "VIBE_ENTRY")
  let mode = read_arg(3)
  if input_path == "" {
    1
  }
  else if output_path == "" {
    1
  }
  else if entry_name == "" {
    1
  }
  else if mode == "" || mode == "release" || mode == "no-dce" || mode == "mvp" {
    let bytes = compile_release_file(input_path, entry_name)
    Fs::write_bytes(output_path, bytes)
    0
  }
  else if mode == "debug" {
    write_linked_debug_build(input_path, output_path, entry_name)
    0
  }
  else {
    1
  }
}
