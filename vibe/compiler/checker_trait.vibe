//# Imports

import ./types.vibe {
  Subst, Type, TypeEnv, trait_defined, type_implements_trait, impls_overlap_for
}

//# Helpers

let empty_strings = () -> Array[String] {
  array_slice([""], 0, 0)
}

let one_super = (name: String) -> Array[String] {
  [name]
}

//# Functions

// Validate that all super-traits are defined before defining a trait
// Returns array of undefined super-trait names
export let validate_supers_defined = (env: TypeEnv, supers: Array[String]) -> Array[String] {
  let result = empty_strings()
  let len = array_length(supers)
  let rec go = (i: Int) -> Int {
    if i >= len {
      0
    } else {
      let name = array_get(supers, i)
      if not(trait_defined(env, name)) {
        array_push(result, name)
      }
      go(i + 1)
    }
  }
  let _ = go(0)
  result
}

// Validate that a trait impl doesn't overlap with existing impls
// Returns true if the impl is valid (no overlap)
export let validate_impl_no_overlap = (env: TypeEnv, trait_name: String, target: Type) -> Bool {
  not(impls_overlap_for(env, trait_name, target))
}

// Check if a type satisfies a trait bound
// Delegates to type_implements_trait but also checks builtin impls
export let satisfies_bound = (env: TypeEnv, s: Subst, ty: Type, bound: String) -> Bool {
  type_implements_trait(env, s, ty, bound)
}

// Validate that all bounds on a type variable are satisfied by a concrete type
// Returns array of unsatisfied bound names
export let check_bounds_satisfied = (env: TypeEnv, s: Subst, ty: Type, bounds: Array[String]) -> Array[String] {
  let result = empty_strings()
  let len = array_length(bounds)
  let rec go = (i: Int) -> Int {
    if i >= len {
      0
    } else {
      let bound = array_get(bounds, i)
      if not(satisfies_bound(env, s, ty, bound)) {
        array_push(result, bound)
      }
      go(i + 1)
    }
  }
  let _ = go(0)
  result
}

// Register builtin traits and their impls for primitive types
export let register_builtin_traits = (env: TypeEnv) -> TypeEnv {
  let no_supers = empty_strings()
  let eq_supers = one_super("Eq")

  // Define traits (order: Eq first since Ord depends on it)
  let e1 = EnvTraitDef("Eq", no_supers, false, env)
  let e2 = EnvTraitDef("Ord", eq_supers, false, e1)
  let e3 = EnvTraitDef("Add", no_supers, false, e2)
  let e4 = EnvTraitDef("Sub", no_supers, false, e3)
  let e5 = EnvTraitDef("Mul", no_supers, false, e4)
  let e6 = EnvTraitDef("Div", no_supers, false, e5)

  // Eq impls: Int, Double, String, Bool
  let e7 = EnvTraitImpl("Eq", CtInt, e6)
  let e8 = EnvTraitImpl("Eq", CtDouble, e7)
  let e9 = EnvTraitImpl("Eq", CtString, e8)
  let e10 = EnvTraitImpl("Eq", CtBool, e9)

  // Ord impls: Int, Double, String
  let e11 = EnvTraitImpl("Ord", CtInt, e10)
  let e12 = EnvTraitImpl("Ord", CtDouble, e11)
  let e13 = EnvTraitImpl("Ord", CtString, e12)

  // Add impls: Int, Double
  let e14 = EnvTraitImpl("Add", CtInt, e13)
  let e15 = EnvTraitImpl("Add", CtDouble, e14)

  // Sub impls: Int, Double
  let e16 = EnvTraitImpl("Sub", CtInt, e15)
  let e17 = EnvTraitImpl("Sub", CtDouble, e16)

  // Mul impls: Int, Double
  let e18 = EnvTraitImpl("Mul", CtInt, e17)
  let e19 = EnvTraitImpl("Mul", CtDouble, e18)

  // Div impls: Int, Double
  let e20 = EnvTraitImpl("Div", CtInt, e19)
  let e21 = EnvTraitImpl("Div", CtDouble, e20)

  e21
}
