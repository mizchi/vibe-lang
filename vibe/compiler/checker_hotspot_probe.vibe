//# Imports

import ./ast.vibe {
  Expr, Pat
}

import ./checker.vibe {
  check_expr
}

import ./polyfill.vibe {
  __to_string
}

import ./types.vibe {
  Subst, Type, TypeDef, TypeEnv, env_bind, env_cache, types_equal
}

//# Functions

let empty_defs_array = () -> Array[TypeDef] {
  Array::slice([
    TDAlias("_dummy", CtUnit)
  ], 0, 0)
}

let run_check = (expr: Expr, env: TypeEnv) -> Type with { Error } {
  let errors = Array::slice([
    ""
  ], 0, 0)
  match check_expr(expr, env, empty_defs_array(), SubstEmpty, 0, errors) {
    (ty, _, _) => if Array::length(errors) > 0 {
      throw(Array::get(errors, 0))
    } else {
      ty
    }
    ,
    _ => CtUnknown
  }
}

let int_var_name = (i: Int) -> String {
  String::concat("x_", __to_string(i))
}

let build_chained_lets = (n: Int) -> Expr {
  let mut i = n
  let mut body = EIdent(int_var_name(1))
  while i >= 1 {
    body = ELet(int_var_name(i), EInt(i), body)
    i = i - 1
  }
  body
}

let build_deep_binop = (n: Int) -> Expr {
  let mut i = n
  let mut acc = EInt(i)
  while i > 1 {
    i = i - 1
    acc = EBinOp("+", EInt(i), acc)
  }
  acc
}

let build_nested_if = (n: Int) -> Expr {
  let mut i = n
  let mut acc = EInt(0)
  while i > 0 {
    acc = EIf(EBool(true), EInt(i), acc)
    i = i - 1
  }
  acc
}

let build_large_match = (n: Int) -> Expr {
  let arms = Array::slice([
    (PWild, EUnit)
  ], 0, 0)
  let mut i = 0
  while i < n {
    Array::push(arms, (PInt(i), EInt(i * 2)))
    i = i + 1
  }
  Array::push(arms, (PWild, EInt(0 - 1)))
  EMatch(EInt(0), arms)
}

// Build a TypeEnv with `n` bindings (`x_1`..`x_n` : Int), then cache it via
// `env_cache` so subsequent env_lookup hits the EnvCached(Map, ...) fast path
// that goes through Map::has_key + Map::get. This is the path the README
// postmortem hypothesised is dominated by node + wasm startup at current N;
// the probes below exercise it in isolation so the cost is directly visible.
let build_cached_env = (n: Int) -> TypeEnv {
  let mut env = EnvEmpty
  let mut i = 1
  while i <= n {
    env = env_bind(env, int_var_name(i), CtInt)
    i = i + 1
  }
  env_cache(env)
}

// Build an expression that does `refs` EIdent lookups against names that exist
// in a `n`-entry env. Each EIdent triggers env_lookup, which on EnvCached walks
// Map::has_key then Map::get — both linear in the linear-Map emit.
let build_env_lookup_expr = (n: Int, refs: Int) -> Expr {
  // Round-robin the references across the env so the linear walk has to
  // traverse different distances (avg ~n/2 entries per lookup).
  let mut body = EIdent(int_var_name(1))
  let mut i = 0
  while i < refs {
    let name_idx = (i % n) + 1
    body = ESeq(EIdent(int_var_name(name_idx)), body)
    i = i + 1
  }
  body
}

let build_seq_chain = (n: Int) -> Expr {
  let mut i = n
  let mut acc = EInt(0)
  while i > 0 {
    acc = ESeq(EInt(i), acc)
    i = i - 1
  }
  acc
}

let check_to_int_flag = (expr: Expr) -> Int with { Error } {
  let ty = run_check(expr, EnvEmpty)
  if types_equal(ty, CtInt) {
    1
  } else {
    0
  }
}

export let probe_check_chained_lets = () -> Int with { Error } {
  check_to_int_flag(build_chained_lets(64))
}

export let probe_check_deep_binop = () -> Int with { Error } {
  check_to_int_flag(build_deep_binop(64))
}

export let probe_check_nested_if = () -> Int with { Error } {
  check_to_int_flag(build_nested_if(64))
}

export let probe_check_large_match = () -> Int with { Error } {
  check_to_int_flag(build_large_match(48))
}

export let probe_check_seq_chain = () -> Int with { Error } {
  check_to_int_flag(build_seq_chain(96))
}

// Cached-env lookup scaling. refs is fixed; only N changes. Linear-Map emit
// gives O(N) per lookup → wallclock scales linearly in N. Hash-backed Map
// would flatten this to ~constant.
let cached_env_lookup_count = (n: Int, refs: Int) -> Int with { Error } {
  let env = build_cached_env(n)
  let expr = build_env_lookup_expr(n, refs)
  let _ = run_check(expr, env)
  refs
}

export let probe_check_cached_env_lookups_n64 = () -> Int with { Error } {
  cached_env_lookup_count(64, 128)
}

export let probe_check_cached_env_lookups_n256 = () -> Int with { Error } {
  cached_env_lookup_count(256, 128)
}

export let probe_check_cached_env_lookups_n512 = () -> Int with { Error } {
  cached_env_lookup_count(512, 128)
}
