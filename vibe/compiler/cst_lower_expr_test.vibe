// Tests for CST lower: expression conversion

import ./token.vibe { Token }
import ./ast.vibe { Expr }
import ./cst.vibe { NodeKind, CstChild }
import ./lower.vibe {
  lower_expr
}

//# Lower: expression tests

test "lower EInt" {
  let node = CNode(NIntExpr, [CToken(TInt(42))])
  match lower_expr(node) {
    EInt(n) => assert(n == 42),
    _ => assert(false)
  }
}

test "lower EFloat" {
  let node = CNode(NFloatExpr, [CToken(TFloat(3.14))])
  match lower_expr(node) {
    EFloat(_) => assert(true),
    _ => assert(false)
  }
}

test "lower EString" {
  let node = CNode(NStringExpr, [CToken(TString("hi"))])
  match lower_expr(node) {
    EString(s) => assert(s == "hi"),
    _ => assert(false)
  }
}

test "lower EBool" {
  let node = CNode(NBoolExpr, [CToken(TIdent("true"))])
  match lower_expr(node) {
    EBool(b) => assert(b == true),
    _ => assert(false)
  }
}

test "lower EIdent" {
  let node = CNode(NIdentExpr, [CToken(TIdent("foo"))])
  match lower_expr(node) {
    EIdent(name) => assert(name == "foo"),
    _ => assert(false)
  }
}

test "lower EUnit" {
  let node = CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  match lower_expr(node) {
    EUnit => assert(true),
    _ => assert(false)
  }
}

test "lower ETuple" {
  let node = CNode(NTupleExpr, [
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRParen)
  ])
  match lower_expr(node) {
    ETuple(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower EArray" {
  let node = CNode(NArrayExpr, [
    CToken(TLBracket),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRBracket)
  ])
  match lower_expr(node) {
    EArray(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower ERecord" {
  let node = CNode(NRecordExpr, [
    CToken(TLBrace),
    CNode(NRecordField, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    ERecord(fields) => {
      assert(Array::length(fields) == 1)
    },
    _ => assert(false)
  }
}

test "lower EIf" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TElse),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EIf no else" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(1))])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower ELet" {
  let node = CNode(NLetExpr, [
    CToken(TLet),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(42))]),
    CNode(NIdentExpr, [CToken(TIdent("x"))])
  ])
  match lower_expr(node) {
    ELet(name, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower ELetMut" {
  let node = CNode(NLetMutExpr, [
    CToken(TLet),
    CToken(TMut),
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(0))]),
    CNode(NIdentExpr, [CToken(TIdent("x"))])
  ])
  match lower_expr(node) {
    ELetMut(name, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower ELetRec" {
  let node = CNode(NLetRecExpr, [
    CToken(TLet),
    CToken(TRec),
    CToken(TIdent("f")),
    CToken(TEq),
    CNode(NIdentExpr, [CToken(TIdent("f"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ])
  match lower_expr(node) {
    ELetRec(name, _, _) => assert(name == "f"),
    _ => assert(false)
  }
}

test "lower ESeq" {
  let node = CNode(NSeqExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TSemicolon),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    ESeq(_, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EBinOp plus" {
  let node = CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPlus),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EBinOp(op, _, _) => assert(op == "+"),
    _ => assert(false)
  }
}

test "lower EBinOp eq" {
  let node = CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TEqEq),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EBinOp(op, _, _) => assert(op == "=="),
    _ => assert(false)
  }
}

test "lower EUnaryOp neg" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TMinus),
    CNode(NIntExpr, [CToken(TInt(1))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "-"),
    _ => assert(false)
  }
}

test "lower EUnaryOp not" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TNot),
    CNode(NBoolExpr, [CToken(TIdent("true"))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "!"),
    _ => assert(false)
  }
}

test "lower ECall" {
  let node = CNode(NCallExpr, [
    CNode(NIdentExpr, [CToken(TIdent("f"))]),
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TRParen)
  ])
  match lower_expr(node) {
    ECall(callee, args) => {
      match callee { EIdent(n) => assert(n == "f"), _ => assert(false) }
      assert(Array::length(args) == 1)
    },
    _ => assert(false)
  }
}

test "lower EDot" {
  let node = CNode(NDotExpr, [
    CNode(NIdentExpr, [CToken(TIdent("obj"))]),
    CToken(TDot),
    CToken(TIdent("field"))
  ])
  match lower_expr(node) {
    EDot(_, name) => assert(name == "field"),
    _ => assert(false)
  }
}

test "lower EMatch" {
  let node = CNode(NMatchExpr, [
    CToken(TMatch),
    CNode(NIdentExpr, [CToken(TIdent("x"))]),
    CToken(TLBrace),
    CNode(NMatchArm, [
      CNode(NIntPat, [CToken(TInt(1))]),
      CToken(TArrow),
      CNode(NStringExpr, [CToken(TString("one"))])
    ]),
    CToken(TComma),
    CNode(NMatchArm, [
      CNode(NWildPat, [CToken(TIdent("_"))]),
      CToken(TArrow),
      CNode(NStringExpr, [CToken(TString("other"))])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    EMatch(_, arms) => assert(Array::length(arms) == 2),
    _ => assert(false)
  }
}

test "lower EWhile" {
  let node = CNode(NWhileExpr, [
    CToken(TWhile),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ])
  match lower_expr(node) {
    EWhile(_, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EBreak none" {
  let node = CNode(NBreakExpr, [CToken(TBreak)])
  match lower_expr(node) {
    EBreak(None) => assert(true),
    _ => assert(false)
  }
}

test "lower EBreak with value" {
  let node = CNode(NBreakExpr, [
    CToken(TBreak),
    CNode(NIntExpr, [CToken(TInt(42))])
  ])
  match lower_expr(node) {
    EBreak(Some(_)) => assert(true),
    _ => assert(false)
  }
}

test "lower EContinue" {
  let node = CNode(NContinueExpr, [CToken(TContinue)])
  match lower_expr(node) {
    EContinue(args) => assert(Array::length(args) == 0),
    _ => assert(false)
  }
}

test "lower EThrow" {
  let node = CNode(NThrowExpr, [
    CToken(TThrow),
    CNode(NStringExpr, [CToken(TString("err"))])
  ])
  match lower_expr(node) {
    EThrow(_) => assert(true),
    _ => assert(false)
  }
}

test "lower EAssign" {
  let node = CNode(NAssignExpr, [
    CToken(TIdent("x")),
    CToken(TEq),
    CNode(NIntExpr, [CToken(TInt(10))]),
    CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  ])
  match lower_expr(node) {
    EAssign(name, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}

test "lower EForIn" {
  let node = CNode(NForInExpr, [
    CToken(TFor),
    CToken(TIdent("x")),
    CToken(TIn),
    CNode(NIdentExpr, [CToken(TIdent("xs"))]),
    CNode(NIntExpr, [CToken(TInt(0))])
  ])
  match lower_expr(node) {
    EForIn(name, _, _) => assert(name == "x"),
    _ => assert(false)
  }
}
