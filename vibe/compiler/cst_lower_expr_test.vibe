// Tests for CST lower: expression conversion

import ./token.vibe { Token }
import ./ast.vibe { Expr }
import ./cst.vibe { NodeKind, CstChild }
import ./lower.vibe {
  lower_expr
}

//# Lower: expression tests

test "lower EInt" {
  let node = CNode(NIntExpr, [CToken(TInt(42))])
  match lower_expr(node) {
    EInt(n) => assert(n == 42),
    _ => assert(false)
  }
}

test "lower EFloat" {
  let node = CNode(NFloatExpr, [CToken(TFloat(3.14))])
  match lower_expr(node) {
    EFloat(_) => assert(true),
    _ => assert(false)
  }
}

test "lower EString" {
  let node = CNode(NStringExpr, [CToken(TString("hi"))])
  match lower_expr(node) {
    EString(s) => assert(s == "hi"),
    _ => assert(false)
  }
}

test "lower EBool" {
  let node = CNode(NBoolExpr, [CToken(TIdent("true"))])
  match lower_expr(node) {
    EBool(b) => assert(b == true),
    _ => assert(false)
  }
}

test "lower EIdent" {
  let node = CNode(NIdentExpr, [CToken(TIdent("foo"))])
  match lower_expr(node) {
    EIdent(name) => assert(name == "foo"),
    _ => assert(false)
  }
}

test "lower EUnit" {
  let node = CNode(NUnitExpr, [CToken(TLParen), CToken(TRParen)])
  match lower_expr(node) {
    EUnit => assert(true),
    _ => assert(false)
  }
}

test "lower ETuple" {
  let node = CNode(NTupleExpr, [
    CToken(TLParen),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRParen)
  ])
  match lower_expr(node) {
    ETuple(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower EArray" {
  let node = CNode(NArrayExpr, [
    CToken(TLBracket),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TComma),
    CNode(NIntExpr, [CToken(TInt(2))]),
    CToken(TRBracket)
  ])
  match lower_expr(node) {
    EArray(elems) => assert(Array::length(elems) == 2),
    _ => assert(false)
  }
}

test "lower ERecord" {
  let node = CNode(NRecordExpr, [
    CToken(TLBrace),
    CNode(NRecordField, [
      CToken(TIdent("x")),
      CToken(TColon),
      CNode(NIntExpr, [CToken(TInt(1))])
    ]),
    CToken(TRBrace)
  ])
  match lower_expr(node) {
    ERecord(fields) => {
      assert(Array::length(fields) == 1)
    },
    _ => assert(false)
  }
}

test "lower EIf" {
  let node = CNode(NIfExpr, [
    CToken(TIf),
    CNode(NBoolExpr, [CToken(TIdent("true"))]),
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TElse),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EIf(_, _, _) => assert(true),
    _ => assert(false)
  }
}

test "lower EBinOp plus" {
  let node = CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TPlus),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EBinOp(op, _, _) => assert(op == "+"),
    _ => assert(false)
  }
}

test "lower EBinOp eq" {
  let node = CNode(NBinOpExpr, [
    CNode(NIntExpr, [CToken(TInt(1))]),
    CToken(TEqEq),
    CNode(NIntExpr, [CToken(TInt(2))])
  ])
  match lower_expr(node) {
    EBinOp(op, _, _) => assert(op == "=="),
    _ => assert(false)
  }
}

test "lower EUnaryOp neg" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TMinus),
    CNode(NIntExpr, [CToken(TInt(1))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "-"),
    _ => assert(false)
  }
}

test "lower EUnaryOp not" {
  let node = CNode(NUnaryOpExpr, [
    CToken(TNot),
    CNode(NBoolExpr, [CToken(TIdent("true"))])
  ])
  match lower_expr(node) {
    EUnaryOp(op, _) => assert(op == "!"),
    _ => assert(false)
  }
}
