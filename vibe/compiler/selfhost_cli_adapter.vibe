//# Imports

import ./entry / source_compile / wasi_only {
  compile_source_wasi_only, compile_source_wasi_only_rc
}

//# Functions

export let cli_main: () -> Int with { Error, Fs, Env } = () -> {
  let input_path = perform Env::Get("VIBE_INPUT")
  let output_path = perform Env::Get("VIBE_OUTPUT")
  let entry_name = perform Env::Get("VIBE_ENTRY")
  let source = perform Fs::ReadFile(input_path)
  // ADR-0055 #493 cutover toggle: VIBE_RC=1 compiles on the Perceus RC codegen
  // path (Env::Get returns "" when unset, so default stays the bump path). Lets
  // the selfbuild/bootstrap/e2e gates exercise the whole compiler under RC.
  let rc_flag = perform Env::Get("VIBE_RC")
  let bytes = if rc_flag == "1" {
    compile_source_wasi_only_rc(source, entry_name)
  } else {
    compile_source_wasi_only(source, entry_name)
  }
  Fs::write_bytes(output_path, bytes)
  0
}
