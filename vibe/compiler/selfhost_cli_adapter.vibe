//# Imports

import ./type_db.vibe {
  db_new
}

import ./entry/compiler/file_compile/index.vibe {
  compile_file_fs_cached
}

export let cli_main = () -> Int with { Error, Fs, Env } {
  let input_path = Env::get("VIBE_INPUT")
  let output_path = Env::get("VIBE_OUTPUT")
  let entry_name = Env::get("VIBE_ENTRY")
  let (bytes, _) = compile_file_fs_cached(db_new(), input_path, entry_name)
  Fs::write_bytes(output_path, bytes)
  0
}
