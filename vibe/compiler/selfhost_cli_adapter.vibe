//# Imports

import ./type_db.vibe {
  db_new
}

import ./compiler.vibe {
  compile_file_fs_cached
}

let cli_arg_or_env = (index: Int, env_name: String) -> String with { Env } {
  if Env::args_len() > index {
    Env::args_get(index)
  } else {
    Env::get(env_name)
  }
}

export let cli_main = () -> Int with { Error, Fs, Env } {
  let input_path = cli_arg_or_env(0, "VIBE_INPUT")
  let output_path = cli_arg_or_env(1, "VIBE_OUTPUT")
  let entry_name = cli_arg_or_env(2, "VIBE_ENTRY")
  let (bytes, _) = compile_file_fs_cached(db_new(), input_path, entry_name)
  Fs::write_bytes(output_path, bytes)
  0
}
