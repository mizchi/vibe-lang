//# Imports

import ./ast.vibe {
  Expr, Pat, Stmt, TypeExpr
}

import ./symbol_index.vibe {
  collect_refs, collect_refs_stmts, collect_symbols, find_symbol
}

//# Functions

export let kind_to_string = (kind: Int) -> String {
  if kind == 0 {
    "function"
  }
  else if kind == 1 {
    "value"
  }
  else if kind == 2 {
    "type"
  }
  else if kind == 3 {
    "constructor"
  }
  else if kind == 4 {
    "trait"
  }
  else if kind == 5 {
    "module"
  }
  else {
    "unknown"
  }
}

export let hover_info = (symbols: Array[(String, Int, Bool)], name: String) -> String {
  match find_symbol(symbols, name) {
    Some(entry) => {
      let (_, kind, exported) = entry
      let kind_str = kind_to_string(kind)
      let scope = if exported {
        "(exported)"
      } else {
        "(local)"
      }
      String::concat(String::concat(String::concat(kind_str, " "), name), String::concat(" ", scope))
    },
    None => "unknown"
  }
}

export let format_symbol = (sym: (String, Int, Bool)) -> String {
  let (name, kind, exported) = sym
  let kind_str = kind_to_string(kind)
  let exp_str = if exported {
    "true"
  } else {
    "false"
  }
  String::concat(String::concat(String::concat(String::concat(kind_str, ":"), name), ":"), exp_str)
}

export let format_symbols = (symbols: Array[(String, Int, Bool)]) -> String {
  let len = Array::length(symbols)
  if len == 0 {
    ""
  }
  else {
    let mut result = format_symbol(Array::get(symbols, 0))
    let mut i = 1
    while i < len {
      result = String::concat(String::concat(result, "\n"), format_symbol(Array::get(symbols, i)))
      i = i + 1
    }
    result
  }
}

let array_contains_str = (arr: Array[String], s: String) -> Bool {
  let len = Array::length(arr)
  let mut i = 0
  let mut found = false
  while i < len {
    if String::equals(Array::get(arr, i), s) {
      found = true
    }
    i = i + 1
  }
  found
}

export let find_references_in = (stmts: Array[Stmt], target_name: String) -> Array[String] {
  let out = Array::slice([
    ""
  ], 0, 0)
  let len = Array::length(stmts)
  let mut i = 0
  while i < len {
    let stmt = Array::get(stmts, i)
    match stmt {
      SLet(_, _, name, _, body) => {
        let refs = collect_refs(body)
        if array_contains_str(refs, target_name) {
          Array::push(out, name)
        }
      },
      _ => {
      }
    }
    i = i + 1
  }
  out
}

export let generate_def_index = (stmts: Array[Stmt]) -> String {
  let syms = collect_symbols(stmts)
  format_symbols(syms)
}

export let generate_ref_index = (stmts: Array[Stmt]) -> String {
  let refs = collect_refs_stmts(stmts)
  let syms = collect_symbols(stmts)
  let len = Array::length(refs)
  if len == 0 {
    ""
  }
  else {
    let mut result = ""
    let mut i = 0
    while i < len {
      let name = Array::get(refs, i)
      let status = match find_symbol(syms, name) {
        Some(_) => "defined",
        None => "undefined"
      }
      let line = String::concat(String::concat(String::concat("ref:", name), ":"), status)
      if i == 0 {
        result = line
      } else {
        result = String::concat(String::concat(result, "\n"), line)
      }
      i = i + 1
    }
    result
  }
}

export let generate_lsif_report = (stmts: Array[Stmt]) -> String {
  let def_idx = generate_def_index(stmts)
  let ref_idx = generate_ref_index(stmts)
  String::concat(String::concat(String::concat("=== Definitions ===\n", def_idx), "\n=== References ===\n"), ref_idx)
}
