"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet field_index_in_gc: (Array[String], String) -> Int = (fnames, field) -> {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\nlet struct_field_index_gc: (CompileCtxGc, String, String) -> Int with { Error } = (ctx, sname, field) -> {\n  let names = ctx.ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  if sidx >= 0 {\n    let found = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in_gc(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\nlet compile_match_gc: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtxGc, Int, (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } = (buf, scrutinee, arms, local_names, next_local, ctx, ld, ce) -> {\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let (p, _) = Array::get(arms, ai)\n    match p {\n      PInt(n) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, n)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PBool(bv) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if bv {\n          1\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PCtor(cname_cond, _) => {\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n        let expected_tag = if ctor_ci >= 0 {\n          Array::get(ctx.ctor_table.tags, ctor_ci)\n        } else {\n          -1\n        }\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i32_const(buf, expected_tag)\n        emit_i32_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PString(sval) => {\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n        if str_idx >= 0 {\n          emit_local_get(buf, scrut_local)\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n          emit_call(buf, 4)\n          emit_i64_const(buf, 1)\n          emit_i64_eq(buf)\n          emit_if_i64(buf)\n        }\n        0\n      },\n      _ => 0\n    }\n    let names_len_at_arm = Array::length(local_names)\n    let (p2, arm_body) = Array::get(arms, ai)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    match p2 {\n      PCtor(_, cargs_bind) => {\n        let mut cbi = 0\n        while cbi < Array::length(cargs_bind) {\n          match Array::get(cargs_bind, cbi) {\n            PBind(pname) => {\n              let fl = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_