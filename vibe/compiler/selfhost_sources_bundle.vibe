size header at block_start+0 (= newcap*8 + 8)\\n    emit_local_get(b, 6)\\n    emit_local_get(b, 7)\\n    emit_i32_const(b, 8)\\n    emit_i32_mul(b)\\n    emit_i32_const(b, 8)\\n    emit_i32_add(b)\\n    emit_i32_store(b, 2, 0)\\n    // copy old elements into the new buffer's data area (block_start+8)\\n    emit_local_get(b, 6)\\n    emit_i32_const(b, 8)\\n    emit_i32_add(b)\\n    emit_local_get(b, 5)\\n    emit_local_get(b, 4)\\n    emit_i32_const(b, 8)\\n    emit_i32_mul(b)\\n    emit_memory_copy(b)\\n    // free the OLD buffer if it was a separate (grown) block, i.e. data_ptr\\n    // (local 5) != value+12 (the inline buffer at vptr+12). Push its value\\n    // pointer onto the free-list head (size@-8, next@-4 are already in place).\\n    emit_local_get(b, 5)\\n    emit_local_get(b, 2)\\n    emit_i32_const(b, 12)\\n    emit_i32_add(b)\\n    emit_i32_ne(b)\\n    emit_if_void(b)\\n    // #715 recurrence guard (VIBE_RC=shadow): double-free check for the\\n    // grown buffer -- a second free-list push of the same buffer makes two\\n    // later allocations return overlapping memory (type confusion), which\\n    // plain marking cannot catch. Works under quarantine too (marks are\\n    // permanent).\\n    if rc_shadow {\\n      emit_local_get(b, 5)\\n      emit_i32_const(b, rc_shadow_base())\\n      emit_i32_add(b)\\n      emit_i32_load8_u(b, 0, 0)\\n      emit_if_void(b)\\n      bytebuf_push(b, 0)\\n      emit_end(b)\\n    } else {\\n      ()\\n    }\\n    // #715 recurrence guard (VIBE_RC=shadow): mark the old grown buffer freed.\\n    if rc_shadow {\\n      emit_local_get(b, 5)\\n      emit_i32_const(b, rc_shadow_base())\\n      emit_i32_add(b)\\n      emit_i32_const(b, 1)\\n      emit_i32_store8(b, 0, 0)\\n    } else {\\n      ()\\n    }\\n    emit_local_get(b, 5)\\n    emit_i32_const(b, 4)\\n    emit_i32_sub(b)\\n    emit_global_get(b, 2)\\n    emit_i32_store(b, 2, 0)\\n    emit_local_get(b, 5)\\n    emit_global_set(b, 2)\\n    emit_end(b)\\n    // capacity = newcap; data_ptr = block_start+8; local5 = block_start+8\\n    emit_local_get(b, 2)\\n    emit_local_get(b, 7)\\n    emit_i32_store(b, 2, 0)\\n    emit_local_get(b, 2)\\n    emit_local_get(b, 6)\\n    emit_i32_const(b, 8)\\n    emit_i32_add(b)\\n    emit_i32_store(b, 2, 8)\\n    emit_local_get(b, 6)\\n    emit_i32_const(b, 8)\\n    emit_i32_add(b)\\n    emit_local_set(b, 5)\\n  } else {\\n    // non-RC: raw-bump a headerless buffer (never freed — the default path does\\n    // not reclaim).\\n    emit_global_get(b, 0)\\n    emit_local_tee(b, 6)\\n    emit_local_get(b, 7)\\n    emit_i32_const(b, 8)\\n    emit_i32_mul(b)\\n    emit_i32_add(b)\\n    emit_global_set(b, 0)\\n    emit_heap_memory_grow_check(b)\\n    emit_local_get(b, 6)\\n    emit_local_get(b, 5)\\n    emit_local_get(b, 4)\\n    emit_i32_const(b, 8)\\n    emit_i32_mul(b)\\n    emit_memory_copy(b)\\n    emit_local_get(b, 2)\\n    emit_local_get(b, 7)\\n    emit_i32_store(b, 2, 0)\\n    emit_local_get(b, 2)\\n    emit_local_get(b, 6)\\n    emit_i32_store(b, 2, 8)\\n    emit_local_get(b, 6)\\n    emit_local_set(b, 5)\\n  }\\n  emit_end(b)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 3)\\n  bytebuf_push(b, 116)\\n  emit_i32_add(b)\\n  emit_local_get(b, 1)\\n  emit_i64_store(b, 3, 0)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_i32_store(b, 2, 4)\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_89 = () -> (String, String) {\n  (\"vibe/compiler/codegen/builtin_bodies/bodies_core_a1.vibe\",\n\"//# Imports\\n\\nexport ./bodies_core_a1a.vibe {\\n  gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_set_body, gen_eq_body, gen_rc_drop_body, gen_rc_alloc_body, gen_str_eq_body, gen_str_len_body\\n}\\n\\nexport ./bodies_core_a1b.vibe {\\n  gen_arr_push_body\\n}\\n\\n//# Misc\\n\\nexport {\\n  gen_eq_body, gen_str_eq_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_set_body, gen_rc_drop_body, gen_rc_alloc_body,