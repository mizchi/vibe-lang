it_i32_wrap_i64(buf)\\n      emit_i32_const(buf, 8)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, local_idx)\\n      emit_i32_wrap_i64(buf)\\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\\n      emit_i64_store(buf, 3, 0)\\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n      nl2\\n      }\\n    } else {\\n      if ctx.enable_rc && (is_etuple(value) || is_earray(value) || is_erecord(value) || is_ctor_call(value, ctx.ctor_table) || is_nullary_ctor_ident(value, ctx.ctor_table) || expr_is_floatish(value, local_names, ctx)) {\\n        Array::push(ctx.heap_binding_names, name)\\n      } else {\\n        ()\\n      }\\n      let nl = compile_expr(buf, value, local_names, next_local + 1, ctx, ld)\\n      emit_local_set(buf, local_idx)\\n      // #715: the ELet path (tag 9) emits every dup the Perceus plan budgeted\\n      // for a binding (ctx.rc_dup_names) at its declaration site -- this\\n      // ELetMut path never did, while the matching scope-end drop below DID\\n      // fire. A `let mut found = None; while .. { match found { .. } }; found`\\n      // accumulator (checker_effects.vibe's lookup_fn_effs) gets a planned\\n      // dup from the #706 borrow-retention bump (the bare `match found`\\n      // borrow) plus a planned scope-end drop; with the dup silently skipped,\\n      // the tail-returned Option's only reference was consumed by the return\\n      // AND by the drop -- the caller's lifted `__m_scrut_N` scrutinee then\\n      // recursively re-dropped the freed block (byte-exact double-free\\n      // confirmed by the drop-site-stamped shadow diagnostic: first free at\\n      // this branch's scope-end drop, second inside\\n      // check_perform_effects_expr_tx). The guarded dup no-ops on scalars, so\\n      // over-emission for a scalar-planned name is harmless.\\n      if ctx.enable_rc {\\n        let mut mdbi = 0\\n        while mdbi < Array::length(ctx.rc_dup_names) {\\n          if Array::get(ctx.rc_dup_names, mdbi) == name {\\n            emit_rc_dup_guarded(buf, local_idx, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          mdbi = mdbi + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      let nl2 = compile_expr(buf, body, local_names, nl, ctx, ld)\\n      if ctx.enable_rc && array_contains_str(ctx.heap_binding_names, name) && array_contains_str(ctx.rc_drop_names, name) && ctx.rc_drop_func_idx >= 0 {\\n        if scope_tail_proj_root(body) == name {\\n          emit_local_set(buf, nl2)\\n          emit_rc_dup_guarded(buf, nl2, ctx.rc_shadow)\\n          emit_local_get(buf, local_idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n          emit_local_get(buf, nl2)\\n          nl2 + 1\\n        } else {\\n          emit_local_get(buf, local_idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n          nl2\\n        }\\n      } else {\\n        nl2\\n      }\\n    }\\n  } else if __tag == 12 {\\n    let name = get_eassign_name(expr)\\n    let value = get_eassign_val(expr)\\n    let body = get_eassign_body(expr)\\n    let idx = resolve_local(local_names, name, \\\"assign\\\")\\n    if array_contains_str(ctx.ref_cell_names, name) {\\n      emit_local_get(buf, idx)\\n      emit_i32_wrap_i64(buf)\\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n      emit_i64_store(buf, 3, 0)\\n      compile_expr(buf, body, local_names, nl, ctx, ld)\\n    } else {\\n      let is_heap_mut = ctx.enable_rc && ctx.rc_drop_func_idx >= 0 && array_contains_str(ctx.heap_binding_names, name)\\n      let is_self = assign_value_mentions(value, name)\\n      if is_heap_mut && is_self && reassign_self_reusable(value, name) {\\n        let old_temp = next_local\\n        let scratch = next_local + 1\\n        let base = next_local + 2\\n        emit_local_get(buf, idx)\\n        emit_local_set(buf, old_temp)\\n        let elems = get_etuple_elems(value)\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          let elem = Array::get(elems, ei)\\n          if (is_eident(elem) && get_eident_name(elem) == name) || (is_edot(elem) && proj_root_ident(elem) == name) {\\n            let _ = compile_expr(buf, elem, local_names, base, ctx, ld)\\n            emit_local_set(buf, scratch)\\n            emit_rc_dup_guarded(buf, scratch, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          ei = ei + 1\\n        }\\n        let nl = compile_expr(buf, value, local_names, base, ctx, ld)\\n        emit_local_set(buf, idx)\\n        emit_local_get(buf, old_temp)\\n        emit_call(buf, ctx.rc_drop_func_idx)\\n        compile_expr(buf, body, local_names, nl, ctx, ld)\\n      } else {\\n        if is_heap_mut && !is_self {\\n          emit_local_get(buf, idx)\\n          emit_call(buf, ctx.rc_drop_func_idx)\\n        } else {\\n          ()\\n        }\\n        let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n        emit_local_set(buf, idx)\\n        if is_heap_mut && !is_self && is_edot(value) {\\n          emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\\n        } else {\\n          ()\\n        }\\n        // #715: the Perceus plan's dup budget for a `let mut` binding\\n        // (ctx.rc_dup_names occurrences) is applied ONCE, to the INITIAL value\\n        // at the declaration site -- but the scope-end drop and every\\n        // remaining owning use consume the binding's CURRENT value. After a\\n        // reassignment, the freshly stored value carries only its own single\\n        // reference; without re-applying the budget here, the tail use plus\\n        // the scope-end drop over-consume it by exactly the planned dup count\\n        // (checker_effects.vibe's lookup_fn_effs: `let mut found = None;\\n        // ... found = Some(..) ...; found` -- the returned Some was freed by\\n        // the binding's scope-end drop while the caller still held it; the\\n        // #706 borrow-retention bump from the bare `match found` is what put\\n        // the +1 in the budget). Worst case this over-retains (a leak) when\\n        // part of the budget was already spent before the reassign -- the\\n        // codebase-wide \\\"leak/no-op at worst, never corrupt\\\" trade.\\n        if ctx.enable_rc && is_heap_mut && !is_self {\\n          let mut adbi = 0\\n          while adbi < Array::length(ctx.rc_dup_names) {\\n            if Array::get(ctx.rc_dup_names, adbi) == name {\\n              emit_rc_dup_guarded(buf, idx, ctx.rc_shadow)\\n            } else {\\n              ()\\n            }\\n            adbi = adbi + 1\\n          }\\n        } else {\\n          ()\\n        }\\n        compile_expr(buf, body, local_names, nl, ctx, ld)\\n      }\\n    }\\n  } else if __tag == 13 {\\n    let name = get_eassignop_name(expr)\\n    let op = get_eassignop_op(expr)\\n    let value = get_eassignop_val(expr)\\n    let body = get_eassignop_body(expr)\\n    let idx = resolve_local(local_names, name, \\\"assignop\\\")\\n    if array_contains_str(ctx.ref_cell_names, name) {\\n      emit_local_get(buf, idx)\\n      emit_i32_wrap_i64(buf)\\n      emit_local_get(buf, idx)\\n      emit_i32_wrap_i64(buf)\\n      emit_i64_load(buf, 3, 0)\\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n      emit_assignop_op(buf, op)\\n      emit_i64_store(buf, 3, 0)\\n      compile_expr(buf, body, local_names, nl, ctx, ld)\\n    } else {\\n      emit_local_get(buf, idx)\\n      let nl = compile_expr(buf, value, local_names, next_local, ctx, ld)\\n      emit_assignop_op(buf, op)\\n      emit_local_set(buf, idx)\\n      compile_expr(buf, body, local_names, nl, ctx, ld)\\n    }\\n  } else if __tag == 14 {\\n    let first = get_eseq_first(expr)\\n    let second = get_eseq_second(expr)\\n    emit_dbg_line_for(buf, first, ctx)\\n    let nl = compile_expr(buf, first, local_names, next_local, ctx, ld)\\n    emit_drop(buf)\\n    compile_expr(buf, second, local_names, nl, ctx, ld)\\n  } else {\\n    compile_expr_tail2(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_76 = () -> (String, String) {\n  (\"vibe/compiler/codegen/expr/compile_expr.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, cov_emit_branch, emit_binop_op, emit_box_float, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, emit_unbox_float, expr_tag, int_log_reset_above, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_ctor_call, is_efn, is_eident, is_etuple, is_nullary_ctor_ident, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport .. / wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./compile_call.vibe {\\n  compile_call\\n}\\n\\nimport ./compile_expr_tail.vibe {\\n  compile_expr_tail, expr_is_floatish, expr_is_intish\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\n//# Functions\\n\\n// #672: emit structural equality for two tuples (non-rc layout: element i at\\n// ptr+i*8, value = raw pointer). The arity comes from whichever operand is a\\n// tuple literal (the checker guarantees same-arity tuples on both sides).\\n// Evaluates each operand to a pointer in a temp local, then ANDs an element-wise\\n// generic `eq` over all elements. Produces a raw i64 0/1. `compile_expr_fn` is\\n// the main expression compiler, threaded to avoid a forward reference.\\nlet emit_tuple_struct_eq: (Bytes, Expr, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr_fn) -> {\\n  let lit = if is_etuple(lhs) {\\n    lhs\\n  } else {\\n    rhs\\n  }\\n  let num = Array::length(get_etuple_elems(lit))\\n  let aptr = next_local\\n  Array::push(local_names, \\\"__eqa\\\")\\n  let bptr = next_local + 1\\n  Array::push(local_names, \\\"__eqb\\\")\\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\\n  // RC tuples are tagged (`value = (block_start+8)|1`) and carry an 8-byte\\n  // header (type_id/length) before the fields, unlike the bare `i*8`-packed\\n  // non-RC layout — untag and skip the header so field reads land on the\\n  // actual elements instead of the header words (previously read as if they\\n  // were fields 0/1, making equal-valued tuples at different addresses\\n  // compare unequal; this is also why the RC path was disabled entirely\\n  // before this fix).\\n  if ctx.enable_rc {\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n  } else {\\n    ()\\n  }\\n  emit_local_set(buf, aptr)\\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\\n  if ctx.enable_rc {\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n  } else {\\n    ()\\n  }\\n  emit_local_set(buf, bptr)\\n  let field_off = if ctx.enable_rc {\\n    8\\n  } else {\\n    0\\n  }\\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n  emit_i64_const(buf, 1)\\n  let mut i = 0\\n  while i < num {\\n    emit_local_get(buf, aptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 3, field_off + i * 8)\\n    emit_local_get(buf, bptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 3, field_off + i * 8)\\n    emit_call(buf, eq_fidx)\\n    emit_i64_and(buf)\\n    i = i + 1\\n  }\\n  nl2\\n}\\n\\n// #672: structural equality for two enum constructor values (non-rc layout:\\n// value = ptr|1, tag i32 at ptr+0, field i at ptr+8+i*8). One operand is a ctor\\n// literal so the field count `fc` is statically known. Compares the runtime\\n// tags first (different variants => not equal, e.g. `Circle(5) != Point`), then\\n// — when tags match — ANDs an element-wise generic `eq` over the `fc` fields.\\n// Flat ctors (Int/String/Bool fields) are correct; nested-ctor fields fall back\\n// to `eq` (so recursive types stay non-structural — tracked in #672).\\nlet emit_ctor_struct_eq: (Bytes, Expr, Expr, Int, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, fc, local_names, next_local, ctx, ld, compile_expr_fn) -> {\\n  let aptr = next_local\\n  Array::push(local_names, \\\"__ceqa\\\")\\n  let bptr = next_local + 1\\n  Array::push(local_names, \\\"__ceqb\\\")\\n  let nl1 = compile_expr_fn(buf, lhs, local_names, next_local + 2, ctx, ld)\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, aptr)\\n  let nl2 = compile_expr_fn(buf, rhs, local_names, nl1, ctx, ld)\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, bptr)\\n  emit_local_get(buf, aptr)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_local_get(buf, bptr)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_eq(buf)\\n  emit_if_i64(buf)\\n  let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n  emit_i64_const(buf, 1)\\n  let mut i = 0\\n  while i < fc {\\n    emit_local_get(buf, aptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 3, 8 + i * 8)\\n    emit_local_get(buf, bptr)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 3, 8 + i * 8)\\n    emit_call(buf, eq_fidx)\\n    emit_i64_and(buf)\\n    i = i + 1\\n  }\\n  emit_else(buf)\\n  emit_i64_const(buf, 0)\\n  emit_end(buf)\\n  nl2\\n}\\n\\n// #672: emit the equality test for `lhs == rhs`, leaving a raw i64 0/1 on the\\n// stack (1 = equal). Routes through the structural comparators when an operand\\n// is a tuple / ctor literal (non-rc), else the generic runtime `eq`. Every `==`\\n// / `!=` codegen site — the general expression form AND the if / `!`-if / while\\n// condition fast-paths — calls this, so structural equality is consistent\\n// across all of them (the post-processing each site applies to the 0/1 result —\\n// `i32_wrap`/`i32_eqz`/rc-shift — is unchanged).\\nlet emit_eq_value: (Bytes, Expr, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, lhs, rhs, local_names, next_local, ctx, ld, ce) -> {\\n  if is_etuple(lhs) || is_etuple(rhs) {\\n    emit_tuple_struct_eq(buf, lhs, rhs, local_names, next_local, ctx, ld, ce)\\n  } else if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) || is_ctor_call(rhs, ctx.ctor_table) || is_nullary_ctor_ident(rhs, ctx.ctor_table) {\\n    let clit = if is_ctor_call(lhs, ctx.ctor_table) || is_nullary_ctor_ident(lhs, ctx.ctor_table) {\\n      lhs\\n    } else {\\n      rhs\\n    }\\n    let cfc = if is_ctor_call(clit, ctx.ctor_table) {\\n      Array::length(get_ecall_args(clit))\\n    } else {\\n      0\\n    }\\n    emit_ctor_struct_eq(buf, lhs, rhs, cfc, local_names, next_local, ctx, ld, ce)\\n  } else if expr_is_intish(lhs, local_names, ctx) || expr_is_intish(rhs, local_names, ctx) {\\n    // A definitely-integer comparison: a direct i64.eq is both faster and\\n    // CORRECT for the full value range, sidestepping the `eq` builtin's\\n    // string-pointer fall-back. The type checker guarantees the other operand\\n    // is the same scalar type, so one intish side is enough.\\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\\n    emit_i64_eq(buf)\\n    emit_i64_extend_i32_s(buf)\\n    nl2\\n  } else {\\n    let nl1 = ce(buf, lhs, local_names, next_local, ctx, ld)\\n    let nl2 = ce(buf, rhs, local_names, nl1, ctx, ld)\\n    let (eq_fidx, _, _) = resolve_func(ctx.func_table, \\\"eq\\\")\\n    emit_call(buf, eq_fidx)\\n    nl2\\n  }\\n}\\n\\nexport let rec compile_expr: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\\n  let __tag = expr_tag(expr)\\n  if __tag == 0 {\\n    let n = get_eint_value(expr)\\n    emit_i64_const(buf, n)\\n    if ctx.enable_rc {\\n      emit_i64_const(buf, 1)\\n      emit_i64_shl(buf)\\n    }\\n    next_local\\n  } else if __tag == 1 {\\n    let b_val = get_ebool_value(expr)\\n    emit_i64_const(buf, if b_val {\\n      if ctx.enable_rc {\\n        2\\n      } else {\\n        1\\n      }\\n    } else {\\n      0\\n    })\\n    next_local\\n  } else if __tag == 2 {\\n    let v = get_efloat_value(expr)\\n    let lo = Double::to_i64_bits_lo(v)\\n    let hi = Double::to_i64_bits_hi(v)\\n    emit_f64_const_lohi(buf, lo, hi)\\n    emit_i64_reinterpret_f64(buf)\\n    if ctx.enable_rc {\\n      Array::push(local_names, \\\"__fbits\\\")\\n      Array::push(local_names, \\\"__fbox\\\")\\n      emit_box_float(buf, ctx, next_local, next_local + 1)\\n      next_local + 2\\n    } else {\\n      next_local\\n    }\\n  } else if __tag == 3 {\\n    let s = get_estring_value(expr)\\n    let idx = str_table_lookup(ctx.str_table.strs, s)\\n    emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\\n    next_local\\n  } else if __tag == 4 {\\n    let name = get_eident_name(expr)\\n    let len = Array::length(local_names)\\n    let mut __tl_i = len - 1\\n    let mut __tl_result = -1\\n    while __tl_i >= 0 {\\n      if Array::get(local_names, __tl_i) == name {\\n        __tl_result = __tl_i\\n        __tl_i = -1\\n      } else {\\n        __tl_i = __tl_i - 1\\n      }\\n    }\\n    let local_idx = __tl_result\\n    if local_idx >= 0 {\\n      if array_contains_str(ctx.ref_cell_names, name) {\\n        emit_local_get(buf, local_idx)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 0)\\n      } else {\\n        emit_local_get(buf, local_idx)\\n      }\\n      next_local\\n    } else {\\n      let mut __ci_idx = -1\\n      let __ci_len = Array::length(ctx.const_int_names)\\n      let mut __ci_j = 0\\n      while __ci_j < __ci_len {\\n        if Array::get(ctx.const_int_names, __ci_j) == name {\\n          __ci_idx = __ci_j\\n          __ci_j = __ci_len\\n        } else {\\n          __ci_j = __ci_j + 1\\n        }\\n      }\\n      if __ci_idx >= 0 {\\n        emit_i64_const(buf, Array::get(ctx.const_int_values, __ci_idx))\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        next_local\\n      } else {\\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\\n        if ctor_idx >= 0 {\\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\\n          let ptr_l = next_local\\n          Array::push(local_names, \\\"__ctor_ptr\\\")\\n          if ctx.enable_rc {\\n            emit_i64_const(buf, 16)\\n            emit_call(buf, ctx.rc_alloc_func_idx)\\n            emit_local_set(buf, ptr_l)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 16)\\n            emit_i32_store(buf, 2, 0)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 1)\\n            emit_i32_store(buf, 2, 4)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 1)\\n            emit_i32_store8(buf, 0, 7)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, tag_c)\\n            emit_i32_store(buf, 2, 8)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 0)\\n            emit_i32_store(buf, 2, 12)\\n            emit_local_get(buf, ptr_l)\\n            emit_i64_const(buf, 8)\\n            emit_i64_add(buf)\\n            emit_i64_const(buf, 1)\\n            emit_i64_or(buf)\\n            next_local + 1\\n          } else {\\n            emit_global_get(buf, 0)\\n            emit_i64_extend_i32_u(buf)\\n            emit_local_set(buf, ptr_l)\\n            emit_global_get(buf, 0)\\n            emit_i32_const(buf, 8)\\n            emit_i32_add(buf)\\n            emit_global_set(buf, 0)\\n            emit_heap_grow_after_heap_set(buf, ctx)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, tag_c)\\n            emit_i32_store(buf, 2, 0)\\n            emit_local_get(buf, ptr_l)\\n            emit_i32_wrap_i64(buf)\\n            emit_i32_const(buf, 0)\\n            emit_i32_store(buf, 2, 4)\\n            emit_local_get(buf, ptr_l)\\n            emit_i64_const(buf, 1)\\n            emit_i64_or(buf)\\n            next_local + 1\\n          }\\n        } else {\\n          let fn_len = Array::length(ctx.func_table.names)\\n          let mut __tf_j = 0\\n          let mut __tf_result = -1\\n          while __tf_j < fn_len {\\n            if Array::get(ctx.func_table.names, __tf_j) == name {\\n              __tf_result = __tf_j\\n              __tf_j = fn_len\\n            } else {\\n              __tf_j = __tf_j + 1\\n            }\\n          }\\n          if __tf_result < 0 {\\n            let mut diag = String::concat(\\\"undefined variable (ident): \\\", name)\\n            diag = String::concat(diag, \\\" | locals=[\\\")\\n            let mut di = 0\\n            while di < len {\\n              if di > 0 {\\n                diag = String::concat(diag, \\\",\\\")\\n              }\\n              diag = String::concat(diag, Array::get(local_names, di))\\n              di = di + 1\\n            }\\n            diag = String::concat(diag, \\\"]\\\")\\n            throw(diag)\\n          }\\n          let fni = __tf_result\\n          let fidx = Array::get(ctx.func_table.indices, fni)\\n          if array_contains_str(ctx.thunk_names, name) {\\n            emit_i64_const(buf, 0)\\n            emit_call(buf, fidx)\\n            next_local\\n          } else {\\n            let table_slot = fidx - ctx.func_offset\\n            emit_i64_const(buf, (table_slot<<2)|2)\\n            next_local\\n          }\\n        }\\n      }\\n    }\\n  } else if __tag == 5 {\\n    let op = get_ebinop_op(expr)\\n    let lhs = get_ebinop_lhs(expr)\\n    let rhs = get_ebinop_rhs(expr)\\n    if op == \\\"==\\\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\\n      // #704: float `==`/`!=` under RC must NOT go through emit_eq_value — under\\n      // RC a float is a BOXED heap value, so the generic eq compares box\\n      // pointers (always unequal for two distinct boxes), making `0.0 == 0.0`\\n      // false. Divert floatish RC `==`/`!=` to the float branch below, which\\n      // unboxes and compares values with f64_eq/f64_ne. (Non-RC keeps the raw\\n      // i64-bits compare here, so the default path is byte-identical.)\\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nle\\n    } else if op == \\\"!=\\\" && !(ctx.enable_rc && (expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx))) {\\n      let nle = emit_eq_value(buf, lhs, rhs, local_names, next_local, ctx, ld, compile_expr)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nle\\n    } else if expr_is_floatish(lhs, local_names, ctx) || expr_is_floatish(rhs, local_names, ctx) {\\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n      if ctx.enable_rc {\\n        emit_unbox_float(buf)\\n      }\\n      emit_f64_reinterpret_i64(buf)\\n      if op == \\\"+\\\" || op == \\\"-\\\" || op == \\\"*\\\" || op == \\\"/\\\" {\\n        if op == \\\"+\\\" {\\n          emit_f64_add(buf)\\n        } else if op == \\\"-\\\" {\\n          emit_f64_sub(buf)\\n        } else if op == \\\"*\\\" {\\n          emit_f64_mul(buf)\\n        } else {\\n          emit_f64_div(buf)\\n        }\\n        emit_i64_reinterpret_f64(buf)\\n        if ctx.enable_rc {\\n          Array::push(local_names, \\\"__fbits\\\")\\n          Array::push(local_names, \\\"__fbox\\\")\\n          emit_box_float(buf, ctx, nl2, nl2 + 1)\\n          nl2 + 2\\n        } else {\\n          nl2\\n        }\\n      } else {\\n        if op == \\\"==\\\" {\\n          emit_f64_eq(buf)\\n        } else if op == \\\"!=\\\" {\\n          emit_f64_ne(buf)\\n        } else if op == \\\"<\\\" {\\n          emit_f64_lt(buf)\\n        } else if op == \\\">\\\" {\\n          emit_f64_gt(buf)\\n        } else if op == \\\"<=\\\" {\\n          emit_f64_le(buf)\\n        } else if op == \\\">=\\\" {\\n          emit_f64_ge(buf)\\n        } else {\\n          throw(String::concat(\\\"unsupported float binop: \\\", op))\\n        }\\n        emit_i64_extend_i32_s(buf)\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        }\\n        nl2\\n      }\\n    } else if ctx.enable_rc {\\n      if op == \\\"<<\\\" {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_i64_shl(buf)\\n        nl2\\n      } else if op == \\\">>\\\" {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shr_s(buf)\\n        emit_i64_shr_s(buf)\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n        nl2\\n      } else {\\n        let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n        let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n        emit_binop_op(buf, op)\\n        if op == \\\"*\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shr_s(buf)\\n        } else if op == \\\"/\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        } else if op == \\\"<\\\" || op == \\\">\\\" || op == \\\"<=\\\" || op == \\\">=\\\" {\\n          emit_i64_const(buf, 1)\\n          emit_i64_shl(buf)\\n        } else {\\n          ()\\n        }\\n        nl2\\n      }\\n    } else {\\n      let nl1 = compile_expr(buf, lhs, local_names, next_local, ctx, ld)\\n      let nl2 = compile_expr(buf, rhs, local_names, nl1, ctx, ld)\\n      emit_binop_op(buf, op)\\n      nl2\\n    }\\n  } else if __tag == 6 {\\n    let op = get_eunaryop_op(expr)\\n    let operand = get_eunaryop_expr(expr)\\n    if op == \\\"-\\\" {\\n      if expr_is_floatish(operand, local_names, ctx) {\\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n        emit_f64_reinterpret_i64(buf)\\n        emit_f64_neg(buf)\\n        emit_i64_reinterpret_f64(buf)\\n        nl\\n      } else {\\n        emit_i64_const(buf, 0)\\n        let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n        emit_i64_sub(buf)\\n        nl\\n      }\\n    } else if op == \\\"!\\\" {\\n      let nl = compile_expr(buf, operand, local_names, next_local, ctx, ld)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      if ctx.enable_rc {\\n        emit_i64_const(buf, 1)\\n        emit_i64_shl(buf)\\n      }\\n      nl\\n    } else {\\n      throw(String::concat(\\\"unsupported unary op: \\\", op))\\n    }\\n  } else if __tag == 7 {\\n    let cond = get_eif_cond(expr)\\n    let then_e = get_eif_then(expr)\\n    let else_e = get_eif_else(expr)\\n    let cond_tag = expr_tag(cond)\\n    let nl1 = if cond_tag == 5 {\\n      let cop = get_ebinop_op(cond)\\n      if cop == \\\"==\\\" || cop == \\\"!=\\\" || cop == \\\"<\\\" || cop == \\\">\\\" || cop == \\\"<=\\\" || cop == \\\">=\\\" {\\n        let clhs = get_ebinop_lhs(cond)\\n        let crhs = get_ebinop_rhs(cond)\\n        if cop == \\\"==\\\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\\n          emit_i32_wrap_i64(buf)\\n          cnl2\\n        } else if cop == \\\"!=\\\" && !(ctx.enable_rc && (expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx))) {\\n          let cnl2 = emit_eq_value(buf, clhs, crhs, local_names, next_local, ctx, ld, compile_expr)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_eqz(buf)\\n          cnl2\\n        } else if expr_is_floatish(clhs, local_names, ctx) || expr_is_floatish(crhs, local_names, ctx) {\\n          // #704: unbox boxed floats under RC before reinterpreting as f64, and\\n          // handle ==/!= here (f64_eq/f64_ne) so float equality in an if/while\\n          // condition compares values, not box pointers.\\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\\n          if ctx.enable_rc {\\n            emit_unbox_float(buf)\\n          } else {\\n            ()\\n          }\\n          emit_f64_reinterpret_i64(buf)\\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\\n          if ctx.enable_rc {\\n            emit_unbox_float(buf)\\n          } else {\\n            ()\\n          }\\n          emit_f64_reinterpret_i64(buf)\\n          if cop == \\\"==\\\" {\\n            emit_f64_eq(buf)\\n          }\\n          else if cop == \\\"!=\\\" {\\n            emit_f64_ne(buf)\\n          }\\n          else if cop == \\\"<\\\" {\\n            emit_f64_lt(buf)\\n          }\\n          else if cop == \\\">\\\" {\\n            emit_f64_gt(buf)\\n          }\\n          else if cop == \\\"<=\\\" {\\n            emit_f64_le(buf)\\n          }\\n          else {\\n            emit_f64_ge(buf)\\n          }\\n          cnl2\\n        } else {\\n          let cnl1 = compile_expr(buf, clhs, local_names, next_local, ctx, ld)\\n          let cnl2 = compile_expr(buf, crhs, local_names, cnl1, ctx, ld)\\n          if cop == \\\"<\\\" {\\n            emit_i64_lt_s(buf)\\n          }\\n          else if cop == \\\">\\\" {\\n            emit_i64_gt_s(buf)\\n          }\\n          else if cop == \\\"<=\\\" {\\n            emit_i64_le_s(buf)\\n          }\\n          else {\\n            emit_i64_ge_s(buf)\\n          }\\n          cnl2\\n        }\\n      } else {\\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n        emit_i32_wrap_i64(buf)\\n        cnl\\n      }\\n    } else if cond_tag == 1 {\\n      let b_val = get_ebool_value(cond)\\n      emit_i32_const(buf, if b_val {\\n        1\\n      } else {\\n        0\\n      })\\n      next_local\\n    } else if cond_tag == 6 {\\n      let uop = get_eunaryop_op(cond)\\n      let uoperand = get_eunaryop_expr(cond)\\n      if uop == \\\"!\\\" {\\n        let inner_tag = expr_tag(uoperand)\\n        if inner_tag == 5 {\\n          let iop = get_ebinop_op(uoperand)\\n          if iop == \\\"==\\\" || iop == \\\"!=\\\" || iop == \\\"<\\\" || iop == \\\">\\\" || iop == \\\"<=\\\" || iop == \\\">=\\\" {\\n            let ilhs = get_ebinop_lhs(uoperand)\\n            let irhs = get_ebinop_rhs(uoperand)\\n            if iop == \\\"==\\\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\\n              emit_i32_wrap_i64(buf)\\n              emit_i32_eqz(buf)\\n              inl2\\n            } else if iop == \\\"!=\\\" && !(ctx.enable_rc && (expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx))) {\\n              let inl2 = emit_eq_value(buf, ilhs, irhs, local_names, next_local, ctx, ld, compile_expr)\\n              emit_i32_wrap_i64(buf)\\n              emit_i32_eqz(buf)\\n              emit_i32_eqz(buf)\\n              inl2\\n            } else if expr_is_floatish(ilhs, local_names, ctx) || expr_is_floatish(irhs, local_names, ctx) {\\n              // #704: unbox boxed floats under RC; handle ==/!= via f64_eq/f64_ne.\\n              // This arm is `!(ilhs iop irhs)`, so the trailing eqz negates.\\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\\n              if ctx.enable_rc {\\n                emit_unbox_float(buf)\\n              } else {\\n                ()\\n              }\\n              emit_f64_reinterpret_i64(buf)\\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\\n              if ctx.enable_rc {\\n                emit_unbox_float(buf)\\n              } else {\\n                ()\\n              }\\n              emit_f64_reinterpret_i64(buf)\\n              if iop == \\\"==\\\" {\\n                emit_f64_eq(buf)\\n              }\\n              else if iop == \\\"!=\\\" {\\n                emit_f64_ne(buf)\\n              }\\n              else if iop == \\\"<\\\" {\\n                emit_f64_lt(buf)\\n              }\\n              else if iop == \\\">\\\" {\\n                emit_f64_gt(buf)\\n              }\\n              else if iop == \\\"<=\\\" {\\n                emit_f64_le(buf)\\n              }\\n              else {\\n                emit_f64_ge(buf)\\n              }\\n              emit_i32_eqz(buf)\\n              inl2\\n            } else {\\n              let inl1 = compile_expr(buf, ilhs, local_names, next_local, ctx, ld)\\n              let inl2 = compile_expr(buf, irhs, local_names, inl1, ctx, ld)\\n              if iop == \\\"<\\\" {\\n                emit_i64_lt_s(buf)\\n              }\\n              else if iop == \\\">\\\" {\\n                emit_i64_gt_s(buf)\\n              }\\n              else if iop == \\\"<=\\\" {\\n                emit_i64_le_s(buf)\\n              }\\n              else {\\n                emit_i64_ge_s(buf)\\n              }\\n              emit_i32_eqz(buf)\\n              inl2\\n            }\\n          } else {\\n            let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n            emit_i32_wrap_i64(buf)\\n            cnl\\n          }\\n        } else {\\n          let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n          emit_i32_wrap_i64(buf)\\n          cnl\\n        }\\n      } else {\\n        let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n        emit_i32_wrap_i64(buf)\\n        cnl\\n      }\\n    } else {\\n      let cnl = compile_expr(buf, cond, local_names, next_local, ctx, ld)\\n      emit_i32_wrap_i64(buf)\\n      cnl\\n    }\\n    emit_if_i64(buf)\\n    let ld_inner = if ld >= 0 {\\n      ld + 1\\n    } else {\\n      -1\\n    }\\n    let names_len_before = Array::length(local_names)\\n    // #cov branch: the then-branch was taken.\\n    cov_emit_branch(buf, ctx.cov)\\n    let nl2 = compile_expr(buf, then_e, local_names, nl1, ctx, ld_inner)\\n    emit_else(buf)\\n    Array::truncate(local_names, names_len_before)\\n    // #678: the then-branch may have logged integral slots >= names_len_before\\n    // that the else-branch is about to reuse; drop them so a non-`let` rebind\\n    // there is not misread as int.\\n    int_log_reset_above(ctx, names_len_before)\\n    // #cov branch: the else-branch was taken.\\n    cov_emit_branch(buf, ctx.cov)\\n    let nl3 = compile_expr(buf, else_e, local_names, nl1, ctx, ld_inner)\\n    emit_end(buf)\\n    let max_nl_if = if nl2 > nl3 {\\n      nl2\\n    } else {\\n      nl3\\n    }\\n    while Array::length(local_names) < max_nl_if {\\n      Array::push(local_names, \\\"\\\")\\n    }\\n    max_nl_if\\n  } else if __tag == 8 {\\n    compile_call(buf, get_ecall_callee(expr), get_ecall_args(expr), local_names, next_local, ctx, ld, compile_expr)\\n  } else {\\n    compile_expr_tail(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_77 = () -> (String, String) {\n  (\"vibe/compiler/codegen/expr/compile_module_expr.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Stmt, bytebuf_new, bytebuf_to_bytes\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, cov_disabled\\n}\\n\\nimport .. / wasm_emit {\\n  emit_code_section_with_locals, emit_export_section_multi, emit_function_section, emit_header, emit_type_section_multi\\n}\\n\\nimport ./compile_expr.vibe {\\n  compile_expr\\n}\\n\\n//# Functions\\n\\nexport let compile_module_expr: (Array[Stmt]) -> Bytes with { Error } = (stmts) -> {\\n  let fresh_int_array: () -> Array[Int] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_string_array: () -> Array[String] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_expr_array: () -> Array[Expr] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_bytes_matrix: () -> Array[Bytes] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fresh_string_matrix: () -> Array[Array[String]] = () -> {\\n    ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let fn_names_list = fresh_string_array()\\n  let fn_param_counts = fresh_int_array()\\n  let export_names = fresh_string_array()\\n  let export_indices = fresh_int_array()\\n  let fn_bodies_list = fresh_expr_array()\\n  let fn_param_names_list = fresh_string_matrix()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SLet(is_export, _, name, _, expr) => match expr {\\n        EFn(_, _, params, _, _, body) => {\\n          let cur_idx = Array::length(fn_names_list)\\n          Array::push(fn_names_list, name)\\n          Array::push(fn_param_counts, Array::length(params))\\n          Array::push(fn_bodies_list, body)\\n          let pnames = fresh_string_array()\\n          let mut pi = 0\\n          while pi < Array::length(params) {\\n            let (pname, _) = Array::get(params, pi)\\n            Array::push(pnames, pname)\\n            pi = pi + 1\\n          }\\n          Array::push(fn_param_names_list, pnames)\\n          if is_export {\\n            Array::push(export_names, name)\\n            Array::push(export_indices, cur_idx)\\n          }\\n          0\\n        },\\n        _ => 0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  let num_funcs = Array::length(fn_names_list)\\n  if num_funcs == 0 {\\n    let out = bytebuf_new()\\n    let empty_type_defs = fresh_int_array()\\n    let empty_type_indices = fresh_int_array()\\n    let empty_body = bytebuf_new()\\n    let empty_bodies = fresh_bytes_matrix()\\n    Array::push(empty_bodies, empty_body)\\n    let empty_local_counts = fresh_int_array()\\n    Array::push(empty_local_counts, 0)\\n    emit_header(out)\\n    emit_type_section_multi(out, empty_type_defs)\\n    emit_function_section(out, empty_type_indices)\\n    emit_code_section_with_locals(out, empty_bodies, empty_local_counts)\\n    bytebuf_to_bytes(out)\\n  } else {\\n    let fn_indices_list = fresh_int_array()\\n    let fn_returns_list = fresh_int_array()\\n    let fn_needs_env_list = ArrayBuilder::freeze(ArrayBuilder::new())\\n    let mut fi = 0\\n    while fi < num_funcs {\\n      Array::push(fn_indices_list, fi)\\n      Array::push(fn_returns_list, 1)\\n      Array::push(fn_needs_env_list, false)\\n      fi = fi + 1\\n    }\\n    let type_defs = fresh_int_array()\\n    let mut ti = 0\\n    while ti < num_funcs {\\n      Array::push(type_defs, Array::get(fn_param_counts, ti))\\n      Array::push(type_defs, 1)\\n      ti = ti + 1\\n    }\\n    let type_indices = fresh_int_array()\\n    let mut tii = 0\\n    while tii < num_funcs {\\n      Array::push(type_indices, tii)\\n      tii = tii + 1\\n    }\\n    let lt_m = LambdaTable::{\\n      bodies: fresh_bytes_matrix(),\\n      param_counts: fresh_int_array(),\\n      captures: fresh_string_matrix(),\\n      meta_i32: fresh_int_array(),\\n      meta_i64: fresh_int_array()\\n    }\\n    let empty_str_table = StrTable::{\\n      strs: fresh_string_array(),\\n      offsets: fresh_int_array(),\\n      lengths: fresh_int_array()\\n    }\\n    let empty_ctor_table = CtorTable::{\\n      names: fresh_string_array(),\\n      tags: fresh_int_array(),\\n      field_counts: fresh_int_array(),\\n      type_names: fresh_string_array(),\\n      struct_names: fresh_string_array(),\\n      struct_field_names: fresh_string_matrix()\\n    }\\n    let empty_thunk_names = fresh_string_array()\\n    let empty_const_int_names = fresh_string_array()\\n    let empty_const_int_values = fresh_int_array()\\n    let empty_rc_drop_names = fresh_string_array()\\n    let empty_rc_alias_dup_names = fresh_string_array()\\n    let empty_rc_dup_names = fresh_string_array()\\n    let bodies = fresh_bytes_matrix()\\n    let local_counts = fresh_int_array()\\n    let mut bi = 0\\n    while bi < num_funcs {\\n      let body = Array::get(fn_bodies_list, bi)\\n      let param_names = Array::get(fn_param_names_list, bi)\\n      let body_buf = bytebuf_new()\\n      let local_names = fresh_string_array()\\n      let mut pi = 0\\n      while pi < Array::length(param_names) {\\n        Array::push(local_names, Array::get(param_names, pi))\\n        pi = pi + 1\\n      }\\n      let param_count = Array::length(param_names)\\n      let empty_ref_cells = fresh_string_array()\\n      let compile_ctx = CompileCtx::{\\n        func_table: FuncTable::{\\n          names: fn_names_list,\\n          indices: fn_indices_list,\\n          params: fn_param_counts,\\n          returns: fn_returns_list,\\n          needs_env: fn_needs_env_list\\n        },\\n        str_table: empty_str_table,\\n        lambda_table: lt_m,\\n        num_user_funcs: num_funcs, func_offset: 0,\\n        ref_cell_names: empty_ref_cells,\\n        ctor_table: empty_ctor_table,\\n        thunk_names: empty_thunk_names,\\n        const_int_names: empty_const_int_names,\\n        const_int_values: empty_const_int_values,\\n        enable_rc: false,\\n        rc_shadow: false,\\n        rc_drop_names: empty_rc_drop_names,\\n        rc_alias_dup_names: empty_rc_alias_dup_names,\\n        heap_binding_names: fresh_string_array(),\\n        rc_drop_func_idx: -1,\\n        rc_alloc_func_idx: -1,\\n        heap_grow_check_func_idx: -1,\\n        rc_dup_names: empty_rc_dup_names,\\n        float_local_slots: fresh_int_array(),\\n        int_local_slots: fresh_int_array(),\\n        effect_names: fresh_string_array(),\\n        effect_op_keys: fresh_string_array(),\\n        effect_op_arities: fresh_int_array(),\\n        cov: cov_disabled(),\\n        dbg_line_idx: -1,\\n        dbg_line_nl: fresh_int_array(),\\n        dbg_line_file_id: 0,\\n        loop_borrowed_names: fresh_string_array(),\\n        loop_consumed_names: fresh_string_array(),\\n        borrow_ret_names: fresh_string_array(),\\n        scalar_ret_names: fresh_string_array()\\n      }\\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\\n      Array::push(bodies, body_buf)\\n      let extra = if final_nl > param_count {\\n        final_nl - param_count\\n      } else {\\n        0\\n      }\\n      Array::push(local_counts, extra)\\n      bi = bi + 1\\n    }\\n    let out = bytebuf_new()\\n    emit_header(out)\\n    emit_type_section_multi(out, type_defs)\\n    emit_function_section(out, type_indices)\\n    if Array::length(export_names) > 0 {\\n      emit_export_section_multi(out, export_names, export_indices)\\n    }\\n    emit_code_section_with_locals(out, bodies, local_counts)\\n    bytebuf_to_bytes(out)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_78 = () -> (String, String) {\n  (\"vibe/compiler/codegen/expr/core.vibe\",\n\"//# Imports\\n\\nexport ./compile_expr.vibe {\\n  compile_expr\\n}\\n\\nexport ./compile_module_expr.vibe {\\n  compile_module_expr\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_expr, compile_module_expr\\n}\\n\")\n}\n\nlet cli_adapter_source_79 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasi/linked_impl.vibe\",\n\"//# Imports\\n\\nexport ./linked_compile.vibe {\\n  compile_wasi_module_linked_impl,\\n  compile_wasi_module_with_sources_impl,\\n  compile_wasi_module_with_sources_coverage_impl,\\n  compile_wasi_module_with_sources_trace_impl,\\n  compile_wasi_module_with_sources_break_impl,\\n  compile_wasi_module_rc_impl\\n}\\n\\n//# Misc\\n\\nexport {\\n  compile_wasi_module_linked_impl,\\n  compile_wasi_module_with_sources_impl,\\n  compile_wasi_module_with_sources_coverage_impl,\\n  compile_wasi_module_with_sources_trace_impl,\\n  compile_wasi_module_with_sources_break_impl,\\n  compile_wasi_module_rc_impl\\n}\\n\")\n}\n\nlet cli_adapter_source_80 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasi/linked_helpers.vibe\",\n\"//# Imports\\n\\nimport .. / .. / builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\nimport .. / .. / core {\\n  Expr, Stmt\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str\\n}\\n\\n//# Functions\\n\\nlet expr_uses_builtin: (Expr, Array[String], String) -> Bool = (expr, fn_names, target) -> {\\n  let free_vars = collect_free_vars(expr, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), fn_names)\\n  let normalized_target = canonical_builtin_name(target)\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(free_vars) && !found {\\n    found = canonical_builtin_name(Array::get(free_vars, i)) == normalized_target\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nexport let rec stmts_use_builtin: (Array[Stmt], Array[String], String) -> Bool = (stmts, fn_names, target) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) && !found {\\n    found = match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => expr_uses_builtin(expr, fn_names, target),\\n      SLetMut(_, _, expr) => expr_uses_builtin(expr, fn_names, target),\\n      STest(_, expr) => expr_uses_builtin(expr, fn_names, target),\\n      SBench(_, expr) => expr_uses_builtin(expr, fn_names, target),\\n      SExpr(expr) => expr_uses_builtin(expr, fn_names, target),\\n      SModule(_, _, inner) => stmts_use_builtin(inner, fn_names, target),\\n      _ => false\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\")\n}\n\nlet cli_adapter_source_81 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasi/linked_compile.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / .. / desugar_trait_dict.vibe {\\n  desugar_trait_dicts\\n}\\n\\nimport .. / .. / normalize {\\n  lift_match_scrutinees, uniquify_shadowed_bindings\\n}\\n\\nimport .. / .. / perceus {\\n  PerceusAction, build_perceus_plan, build_perceus_plan_with_params, compute_borrow_returning_names, compute_scalar_returning_names, elaborate_heap_params, pa_is_alias_dup, pa_is_drop, pa_is_dup, param_is_heap_in_body\\n}\\n\\nimport .. / builtin_bodies {\\n  gen_arr_concat_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_push_all_body, gen_arr_push_body, gen_arr_set_body, gen_arr_slice_body, gen_arr_truncate_body, gen_bytes_append_body, gen_bytes_concat_body, gen_bytes_from_array_body, gen_bytes_get_body, gen_bytes_len_body, gen_bytes_new_body, gen_bytes_push_body, gen_bytes_set_body, gen_bytes_slice_body, gen_bytes_to_array_body, gen_eq_body, gen_rc_alloc_body, gen_rc_drop_body, gen_selfhost_sources_proper_body, gen_selfhost_sources_stub_body, gen_simd_scan_alnum_body, gen_simd_skip_ws_body, gen_str_char_code_at_body, gen_str_concat_body, gen_str_from_char_code_body, gen_str_len_body, gen_str_substring_body, gen_string_contains_body, gen_string_ends_with_body, gen_string_index_of_body, gen_string_join_body, gen_string_last_index_of_body, gen_string_split_body, gen_string_starts_with_body, gen_string_trim_body, static_arr_get_body, static_arr_len_body, static_arr_set_body, static_arr_truncate_body, static_double_to_int_body, static_fs_stub_body, static_fs_write_bytes_stub_body, static_identity_body, static_int_to_double_body, static_print_i64_body, static_print_str_body, static_str_char_code_at_body, static_str_eq_body, static_str_len_body\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in, scope_tail_proj_root, stmts_contain_exceptions\\n}\\n\\nimport .. / common_base {\\n  rc_shadow_reserve,\\n  CompileCtx, CovState, CtorTable, DbgProv, FuncTable, LambdaTable, StrTable, emit_rc_dup_guarded, empty_dbg_prov, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, fn_type_param_types, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, get_slet_type, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, build_newline_offsets, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport .. / expr {\\n  compile_expr\\n}\\n\\nimport .. / wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i64_store, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, emit_vibe_abi_custom_section, emit_function_name_section, string_to_data\\n}\\n\\nimport ./linked_helpers.vibe {\\n  stmts_use_builtin\\n}\\n\\n//# Functions\\n\\nlet wasm_page_size = 65536\\n\\nlet lc_fresh_int_array: () -> Array[Int] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nlet lc_fresh_bool_array: () -> Array[Bool] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nlet lc_fresh_bytes_array: () -> Array[Bytes] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nlet lc_fresh_string_array: () -> Array[String] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\n\\nlet lc_fresh_string_matrix: () -> Array[Array[String]] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nlet gen_heap_grow_check_body: () -> Bytes = () -> {\\n  let b = bytebuf_new()\\n  emit_heap_memory_grow_check(b)\\n  b\\n}\\n\\nlet default_wasi_memory_min_pages = 64\\n\\nexport let wasi_memory_min_pages_for_heap: (Int) -> Int = (heap_start) -> {\\n  let needed_pages = (heap_start + wasm_page_size - 1) / wasm_page_size\\n  if needed_pages > default_wasi_memory_min_pages {\\n    needed_pages\\n  } else {\\n    default_wasi_memory_min_pages\\n  }\\n}\\n\\nexport let compile_wasi_module_linked_impl: (Array[Stmt], String, Array[(String, String)], Array[(String, String, Int, Int)], Bool, Bool, Bool, Bool, Bool, Bool, DbgProv) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, linked_imports, library_mode, enable_rc, coverage, debug_trace, debug_break, rc_shadow, prov) -> {\\n  // Method-bearing-trait dictionary passing (#641 PR-3). Universal codegen\\n  // convergence point — runs here on the fully merged program before generic\\n  // type params are stripped (just below). No-op unless a method-bearing trait\\n  // is declared, and idempotent if an earlier pipeline stage already desugared.\\n  desugar_trait_dicts(stmts)\\n  // #707: functions whose entire body is transitively a tail-call to a\\n  // borrow-returning builtin (Array::get/Map::get/__index) -- e.g. a thin\\n  // `peek(toks, pos) -> Array::get(toks, pos)` wrapper. Computed once over the\\n  // whole merged program and threaded into every function's Perceus plan so a\\n  // `let v = peek(...)` binding (including the match-scrutinee-lift's\\n  // `let __m_scrut = peek(...)`, see normalize/index.vibe) is recognized the\\n  // same as a direct `let v = Array::get(...)` one.\\n  let lc_borrow_ret_names = compute_borrow_returning_names(stmts)\\n  // #710: see CompileCtx.scalar_ret_names' doc comment (common_base/index.vibe).\\n  let lc_scalar_ret_names = compute_scalar_returning_names(stmts)\\n  let fn_names_list = lc_fresh_string_array()\\n  let fn_param_counts = lc_fresh_int_array()\\n  let fn_needs_env_list = lc_fresh_bool_array()\\n  let fn_stmt_indices = lc_fresh_int_array()\\n  let thunk_names_list = lc_fresh_string_array()\\n  let const_int_names_list = lc_fresh_string_array()\\n  let const_int_values_list = lc_fresh_int_array()\\n  let export_fn_names = lc_fresh_string_array()\\n  let export_fn_user_indices = lc_fresh_int_array()\\n  let test_fn_names = lc_fresh_string_array()\\n  let empty_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let empty_bounds = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let empty_params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut pi = 0\\n  while pi < Array::length(stmts) {\\n    match Array::get(stmts, pi) {\\n      STest(tname, tbody) => {\\n        let test_fn = String::concat(\\\"__test_\\\", tname)\\n        Array::push(test_fn_names, test_fn)\\n        Array::set(stmts, pi, SLet(false, false, test_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(tbody, EInt(0)))))\\n      },\\n      SBench(bname, bbody) => {\\n        let bench_fn = String::concat(\\\"__bench_\\\", bname)\\n        Array::push(test_fn_names, bench_fn)\\n        Array::set(stmts, pi, SLet(false, false, bench_fn, None, EFn(empty_tp, empty_bounds, empty_params, None, None, ESeq(bbody, EInt(0)))))\\n      },\\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\\n          Array::set(stmts, pi, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\\n        }\\n        ,\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    pi = pi + 1\\n  }\\n  if Array::length(test_fn_names) > 0 {\\n    let mut has_entry = false\\n    let mut ei = 0\\n    while ei < Array::length(stmts) {\\n      match Array::get(stmts, ei) {\\n        SLet(is_exp, _, name, _, _) => if is_exp && name == entry_name {\\n          has_entry = true\\n        },\\n        _ => ()\\n      }\\n      ei = ei + 1\\n    }\\n    if !has_entry {\\n      ()\\n    }\\n  }\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    if is_slet(stmt) {\\n      let name = get_slet_name(stmt)\\n      let expr = get_slet_expr(stmt)\\n      let is_export = get_slet_export(stmt)\\n      let user_idx = Array::length(fn_names_list)\\n      // #715: `expr_tag(expr)` hoisted out of the `else` branch below and\\n      // computed here, unconditionally -- so it (like `is_efn(expr)` above)\\n      // contributes to `expr`'s always-consumed prefix instead of only being\\n      // paid for on the `else` path. This alone still leaves the `else`\\n      // branch's own nested if asymmetric (`get_eint_value`=1 use vs the\\n      // thunk fallback's 0), so the thunk fallback below also aliases `expr`\\n      // once (`let __sf_thunk_expr = expr`) to match. With both asymmetries\\n      // resolved, `then` and `else` each consume `expr` the same number of\\n      // times, so pc_emit's EIf MIN-merge (#705) lands on the SAME remaining\\n      // count regardless of which branch a given statement actually takes --\\n      // previously the merge could permanently assume more consumption than\\n      // a commonly-taken branch (int-constant or thunk statements, which are\\n      // NOT rare like a false `is_efn` check on a real function body) really\\n      // performed, skipping the loop-body scope-end drop and leaking `expr`\\n      // (a heap Expr node) on every such statement.\\n      let __sf_etag = expr_tag(expr)\\n      if is_efn(expr) {\\n        let params = get_efn_params(expr)\\n        Array::push(fn_names_list, name)\\n        Array::push(fn_param_counts, Array::length(params))\\n        Array::push(fn_needs_env_list, true)\\n        Array::push(fn_stmt_indices, i)\\n      } else {\\n        if (__sf_etag == 0) && !is_export {\\n          Array::push(const_int_names_list, name)\\n          Array::push(const_int_values_list, get_eint_value(expr))\\n        } else {\\n          let __sf_thunk_expr = expr\\n          Array::push(fn_names_list, name)\\n          Array::push(fn_param_counts, 0)\\n          Array::push(fn_needs_env_list, true)\\n          Array::push(fn_stmt_indices, i)\\n          Array::push(thunk_names_list, name)\\n        }\\n      }\\n      if is_export || library_mode {\\n        Array::push(export_fn_names, name)\\n        Array::push(export_fn_user_indices, user_idx)\\n      }\\n    }\\n    i = i + 1\\n  }\\n  let ctor_names_list = lc_fresh_string_array()\\n  Array::push(ctor_names_list, \\\"None\\\")\\n  Array::push(ctor_names_list, \\\"Some\\\")\\n  let ctor_tags_list = lc_fresh_int_array()\\n  Array::push(ctor_tags_list, 0)\\n  Array::push(ctor_tags_list, 1)\\n  let ctor_field_counts_list = lc_fresh_int_array()\\n  Array::push(ctor_field_counts_list, 0)\\n  Array::push(ctor_field_counts_list, 1)\\n  let ctor_type_names_list = lc_fresh_string_array()\\n  Array::push(ctor_type_names_list, \\\"Option\\\")\\n  Array::push(ctor_type_names_list, \\\"Option\\\")\\n  let mut type_index = 1\\n  let mut ei2 = 0\\n  while ei2 < Array::length(stmts) {\\n    match Array::get(stmts, ei2) {\\n      SEnum(_, ename, _, variants, _) => {\\n        type_index = type_index + 1\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vfields) = Array::get(variants, vi)\\n          Array::push(ctor_names_list, vname)\\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\\n          Array::push(ctor_field_counts_list, Array::length(vfields))\\n          Array::push(ctor_type_names_list, ename)\\n          vi = vi + 1\\n        }\\n        0\\n      },\\n      SStruct(_, sname, sfields, _, _) => {\\n        type_index = type_index + 1\\n        Array::push(ctor_names_list, sname)\\n        Array::push(ctor_tags_list, type_index<<16)\\n        Array::push(ctor_field_counts_list, Array::length(sfields))\\n        Array::push(ctor_type_names_list, sname)\\n        0\\n      },\\n      _ => 0\\n    }\\n    ei2 = ei2 + 1\\n  }\\n  let struct_names = lc_fresh_string_array()\\n  let struct_field_names = lc_fresh_string_matrix()\\n  let mut si = 0\\n  while si < Array::length(stmts) {\\n    match Array::get(stmts, si) {\\n      SStruct(_, sname, sfields, _, _) => {\\n        Array::push(struct_names, sname)\\n        let fnames = lc_fresh_string_array()\\n        let mut sfi = 0\\n        while sfi < Array::length(sfields) {\\n          let (fname, _) = Array::get(sfields, sfi)\\n          Array::push(fnames, fname)\\n          sfi = sfi + 1\\n        }\\n        Array::push(struct_field_names, fnames)\\n        ()\\n      },\\n      _ => ()\\n    }\\n    si = si + 1\\n  }\\n  let num_user_funcs = Array::length(fn_names_list)\\n  if num_user_funcs == 0 {\\n    throw(\\\"no functions found to compile\\\")\\n  }\\n  let mut entry_user_idx = -1\\n  let mut ei = 0\\n  while ei < num_user_funcs {\\n    if Array::get(fn_names_list, ei) == entry_name {\\n      entry_user_idx = ei\\n    }\\n    ei = ei + 1\\n  }\\n  let str_strs = collect_strings_stmts(stmts)\\n  let rec add_map_keys_expr: (Expr) -> Unit = (e) -> {\\n    match e {\\n      EMap(fields) => {\\n        let mut mi = 0\\n        while mi < Array::length(fields) {\\n          let (key, val) = Array::get(fields, mi)\\n          if !array_contains_str(str_strs, key) {\\n            Array::push(str_strs, key)\\n          }\\n          add_map_keys_expr(val)\\n          mi = mi + 1\\n        }\\n      },\\n      EStringInterp(parts) => {\\n        let mut pi3 = 0\\n        while pi3 < Array::length(parts) {\\n          if pi3 % 2 == 0 {\\n            let part = Array::get(parts, pi3)\\n            if String::length(part) > 0 && !array_contains_str(str_strs, part) {\\n              Array::push(str_strs, part)\\n            }\\n          }\\n          pi3 = pi3 + 1\\n        }\\n      },\\n      ELet(_, val, body) => {\\n        add_map_keys_expr(val); add_map_keys_expr(body)\\n      },\\n      ELetMut(_, val, body) => {\\n        add_map_keys_expr(val); add_map_keys_expr(body)\\n      },\\n      ELetRec(_, val, body) => {\\n        add_map_keys_expr(val); add_map_keys_expr(body)\\n      },\\n      ESeq(a, b) => {\\n        add_map_keys_expr(a); add_map_keys_expr(b)\\n      },\\n      EIf(c, t, e) => {\\n        add_map_keys_expr(c); add_map_keys_expr(t); add_map_keys_expr(e)\\n      },\\n      EFn(_, _, _, _, _, body) => add_map_keys_expr(body),\\n      EHandle(body, _) => add_map_keys_expr(body),\\n      ECall(callee, args, _) => {\\n        add_map_keys_expr(callee)\\n        let mut ai = 0\\n        while ai < Array::length(args) {\\n          add_map_keys_expr(Array::get(args, ai))\\n          ai = ai + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n  }\\n  let mut __mk = 0\\n  while __mk < Array::length(stmts) {\\n    match Array::get(stmts, __mk) {\\n      SLet(_, _, _, _, expr) => add_map_keys_expr(expr),\\n      STest(_, expr) => add_map_keys_expr(expr),\\n      SBench(_, expr) => add_map_keys_expr(expr),\\n      _ => ()\\n    }\\n    __mk = __mk + 1\\n  }\\n  // Always seed the empty string so codegen that materialises \\\"\\\" (e.g.\\n  // StringBuilder::freeze's join separator, Stream::to_string's accumulator)\\n  // can rely on str_table_lookup(\\\"\\\") succeeding even when the source never\\n  // mentions \\\"\\\" literally.\\n  if !array_contains_str(str_strs, \\\"\\\") {\\n    Array::push(str_strs, \\\"\\\")\\n  }\\n  let src_str_base = Array::length(str_strs)\\n  let num_src_pairs = Array::length(selfhost_srcs)\\n  let mut __src_i = 0\\n  while __src_i < num_src_pairs {\\n    let (__src_path, __src_content) = Array::get(selfhost_srcs, __src_i)\\n    Array::push(str_strs, __src_path)\\n    Array::push(str_strs, __src_content)\\n    __src_i = __src_i + 1\\n  }\\n  let num_strings = Array::length(str_strs)\\n  let data_base = 64\\n  let str_offsets = lc_fresh_int_array()\\n  let str_lengths = lc_fresh_int_array()\\n  let mut str_pos = data_base\\n  let mut si = 0\\n  while si < num_strings {\\n    let s = Array::get(str_strs, si)\\n    let slen = String::length(s)\\n    Array::push(str_offsets, str_pos)\\n    Array::push(str_lengths, slen)\\n    str_pos = str_pos + slen\\n    si = si + 1\\n  }\\n  let heap_start = ((str_pos + 7) / 8) * 8\\n  let effect_names_list = lc_fresh_string_array()\\n  let effect_op_keys_list = lc_fresh_string_array()\\n  let effect_op_arities_list = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut eff_collect_i = 0\\n  while eff_collect_i < Array::length(stmts) {\\n    match Array::get(stmts, eff_collect_i) {\\n      SEffectDef(_, eff_name, _, ops) => {\\n        if eff_name != \\\"Error\\\" && !array_contains_str(effect_names_list, eff_name) {\\n          Array::push(effect_names_list, eff_name)\\n        } else {\\n          ()\\n        }\\n        let mut op_i = 0\\n        while op_i < Array::length(ops) {\\n          let (op_name, op_params, _) = Array::get(ops, op_i)\\n          Array::push(effect_op_keys_list, String::concat(String::concat(eff_name, \\\"::\\\"), op_name))\\n          Array::push(effect_op_arities_list, Array::length(op_params))\\n          op_i = op_i + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    eff_collect_i = eff_collect_i + 1\\n  }\\n  // Per-effect region stride (#553). Each effect tag gets a reserved region\\n  // below the heap frontier holding the replay-handler control words (+0\\n  // perform counter, +8 resume-memo count) and the resume-memo array (+16 +\\n  // k*8). The replay model stores one i64 per `perform` resolved within a\\n  // `handle`, so the region is O(performs). At 8192 B (1022 entries) a loop\\n  // performing more than ~1022-2046 times overflowed the region into the live\\n  // heap, where the growing memo chased and clobbered the reused payload-tuple\\n  // free block (~8 B/iter past the threshold, ADR-0055). 131072 B (16382\\n  // entries) covers the full verify regime (N2=11000) with headroom; programs\\n  // performing more than ~16K times within one handle still spill (a hard\\n  // bound of the replay-based handler — unbounded performs need a\\n  // continuation-based handler). MUST stay in sync with the `* 131072` strides\\n  // in compile_call.vibe (perform) and compile_expr_tail6.vibe (handler arm).\\n  let eff_reserve = (Array::length(effect_names_list) + 1) * 131072\\n  // Function-level coverage (gated by `coverage`): a 1-byte-per-user-function\\n  // hit bitmap placed in a dedicated reserve ABOVE the effect regions and BELOW\\n  // the heap frontier, so it never collides with effect words or the live heap.\\n  // `cov_base` is a compile-time-constant address baked into each function's\\n  // prologue store. When coverage is off, cov_reserve is 0 and codegen output is\\n  // byte-identical to the normal build (the self-host fixpoint is unaffected).\\n  let cov_count = num_user_funcs\\n  let cov_base = heap_start + eff_reserve\\n  let cov_reserve = if coverage {\\n    ((cov_count + 7) / 8) * 8\\n  } else {\\n    0\\n  }\\n  // #cov branch coverage: a second 1-byte-per-branch hit region directly above\\n  // the function-hit region. Branch ids are assigned sequentially during codegen\\n  // (CovState.next), so the count is not known up front — reserve a fixed cap.\\n  // 65536 branches is generous headroom (the whole compiler has a few thousand).\\n  // Off => branch_reserve is 0 and the layout/codegen is byte-identical.\\n  let cov_branch_cap = 65536\\n  let cov_branch_base = cov_base + cov_reserve\\n  let cov_branch_reserve = if coverage {\\n    cov_branch_cap\\n  } else {\\n    0\\n  }\\n  // Function-call execution trace (debugger / DAP P1 groundwork, gated by\\n  // `debug_trace`). A dedicated region directly above the coverage regions and\\n  // below the heap frontier holds a 4-byte counter cell followed by a fixed-cap\\n  // log of i32 slots. Each user function's entry, in debug mode, appends its\\n  // own user index to the log (counter-bounded). A `vibe.trace` custom section\\n  // records the layout + function names so the runner can dump the entry\\n  // sequence. Off => trace_reserve is 0 and the layout/codegen is byte-identical\\n  // to a normal build (the self-host fixpoint is unaffected).\\n  let trace_cap = 4096\\n  let trace_counter_addr = cov_branch_base + cov_branch_reserve\\n  let trace_log_base = trace_counter_addr + 4\\n  let trace_reserve = if debug_trace {\\n    4 + trace_cap * 4\\n  } else {\\n    0\\n  }\\n  // debugger argument inspection (DAP P2, gated by `debug_break`). A dedicated\\n  // region directly above the trace region holds a 4-byte count cell followed by\\n  // a fixed-cap array of i64 slots. At each user function entry, in break mode,\\n  // the function's i64 parameters are spilled here (capped at dbgargs_cap) and\\n  // the count cell is set, BEFORE calling the `vibe::dbg_break` host hook. The\\n  // hook reads them out of guest memory and prints `args: [...]`. A\\n  // `vibe.dbgargs` custom section publishes the two addresses to the runner.\\n  // Off => dbgargs_reserve is 0 and the layout/codegen is byte-identical to a\\n  // normal build (the self-host fixpoint is unaffected).\\n  let dbgargs_cap = 16\\n  let dbgargs_count_addr = trace_counter_addr + trace_reserve\\n  let dbgargs_base = dbgargs_count_addr + 8\\n  let dbgargs_reserve = if debug_break {\\n    8 + dbgargs_cap * 8\\n  } else {\\n    0\\n  }\\n  let cov_state = CovState::{\\n    enabled: coverage,\\n    base: cov_branch_base,\\n    cap: cov_branch_cap,\\n    next: [\\n      0\\n    ],\\n    cur_fn: [\\n      0\\n    ],\\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n  let need_env_get_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Env::get\\\")\\n  let need_env_args_len_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Env::args_len\\\")\\n  let need_env_args_get_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Env::args_get\\\")\\n  let need_fs_read_file_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Fs::read_file\\\")\\n  let need_fs_exists_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Fs::exists\\\")\\n  let need_fs_stat_token_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Fs::stat_token\\\")\\n  let need_fs_write_file_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Fs::write_file\\\")\\n  let need_fs_write_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Fs::write_bytes\\\")\\n  // #632: `Fs::read_bytes(path) -> Bytes` — the binary-exact read counterpart of\\n  // Fs::write_bytes, a `vibe.fs_read_bytes (i64) -> i64` host import (type 3,\\n  // same shape as fs_read_file). Gated on use so non-users reserve no import\\n  // (fixpoint-safe). Lets the persistent artifact cache store/load wasm raw.\\n  let need_fs_read_bytes_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Fs::read_bytes\\\")\\n  let need_profiler_now_us_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Profiler::now_us\\\")\\n  // `sleep(ms)` (Async): a `vibe.sleep (i64) -> ()` host import. The host\\n  // implements it as an async function so the guest fiber genuinely\\n  // suspends/resumes (docs/spec/wasi-p3-async.md §2.3, examples/async_host).\\n  // Gated on use, so programs without `sleep` reserve no import (fixpoint-safe).\\n  let need_sleep_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"sleep\\\")\\n  // `Stdin::read_char() -> Int`: a value-returning `vibe.stdin_read_char () ->\\n  // i64` host import. Implemented async by the host (it can suspend the guest\\n  // until a char is available), so this is the data-consuming analog of `sleep`\\n  // — the shape of a host async source (HTTP body byte, stdin char). Gated on\\n  // use (fixpoint-safe).\\n  let need_stdin_read_char_builtin = stmts_use_builtin(stmts, fn_names_list, \\\"Stdin::read_char\\\")\\n  let mut next_import_idx = 1\\n  let env_get_import_idx = if need_env_get_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let env_args_len_import_idx = if need_env_args_len_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let env_args_get_import_idx = if need_env_args_get_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_read_file_import_idx = if need_fs_read_file_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_exists_import_idx = if need_fs_exists_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_stat_token_import_idx = if need_fs_stat_token_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_write_file_import_idx = if need_fs_write_file_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let fs_write_bytes_import_idx = if need_fs_write_bytes_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // #632: reserved immediately after fs_write_bytes; the import emission below\\n  // must stay in this same order so the index matches the descriptor.\\n  let fs_read_bytes_import_idx = if need_fs_read_bytes_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let profiler_now_us_import_idx = if need_profiler_now_us_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let sleep_import_idx = if need_sleep_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let stdin_read_char_import_idx = if need_stdin_read_char_builtin {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // debugger breakpoint (DAP P1): in break mode emit a conditional `vibe::dbg_break`\\n  // host import (() -> ()) called at each user-function entry. Default OFF, so\\n  // num_imported_funcs / func_offset are unchanged for normal builds (fixpoint).\\n  let dbg_break_import_idx = if debug_break {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  // Interior-line breakpoints (span-arc step5): in break mode with per-file\\n  // provenance, reserve a `vibe::dbg_line (i32 file_id, i32 line) -> ()` host\\n  // import called at each statement boundary. Each function's line is mapped\\n  // against ITS OWN source file (prov.file_nls[file_id]) so multi-file entries\\n  // work. Gated on `debug_break && prov has files`, so default builds reserve\\n  // nothing and stay byte-identical.\\n  let dbg_line_on = debug_break && Array::length(prov.files) > 0\\n  let dbg_line_import_idx = if dbg_line_on {\\n    let idx = next_import_idx\\n    next_import_idx = next_import_idx + 1\\n    idx\\n  } else {\\n    -1\\n  }\\n  let linked_import_indices = lc_fresh_int_array()\\n  let linked_import_names = lc_fresh_string_array()\\n  let mut li_i = 0\\n  while li_i < Array::length(linked_imports) {\\n    let (_, lfn_name, _, _) = Array::get(linked_imports, li_i)\\n    Array::push(linked_import_indices, next_import_idx)\\n    Array::push(linked_import_names, lfn_name)\\n    next_import_idx = next_import_idx + 1\\n    li_i = li_i + 1\\n  }\\n  let num_imported_funcs = next_import_idx\\n  let print_int_idx = num_imported_funcs\\n  let print_str_idx = print_int_idx + 1\\n  let str_len_idx = print_str_idx + 1\\n  let str_eq_idx = str_len_idx + 1\\n  let str_concat_idx = str_eq_idx + 1\\n  let arr_new_idx = str_concat_idx + 1\\n  let arr_len_idx = arr_new_idx + 1\\n  let arr_get_idx = arr_len_idx + 1\\n  let arr_push_idx = arr_get_idx + 1\\n  let arr_set_idx = arr_push_idx + 1\\n  let double_to_int_idx = arr_set_idx + 1\\n  let int_to_double_idx = double_to_int_idx + 1\\n  let str_char_code_at_idx = int_to_double_idx + 1\\n  let str_from_char_code_idx = str_char_code_at_idx + 1\\n  let str_substring_idx = str_from_char_code_idx + 1