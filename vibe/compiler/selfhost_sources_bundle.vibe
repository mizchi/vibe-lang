Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_load, align, offset)\n}\n\nexport let emit_i64_ge_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_ge_s)\n}\n\nexport let emit_i64_gt_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_gt_s)\n}\n\nexport let emit_i64_le_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_le_s)\n}\n\nexport let emit_i64_lt_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_lt_s)\n}\n\nexport let emit_ref_func = (buf: Bytes, func_idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, 210, func_idx)\n}\n\nexport let emit_ref_null = (buf: Bytes, heap_type_byte: Int) -> Unit {\n  bytebuf_push2(buf, 208, heap_type_byte)\n}\n\nlet op_i32_store8 = 58\n\nexport let emit_block_i64 = (buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_block, bt_i64)\n}\n\nexport let emit_i32_store = (buf: Bytes, align: Int, offset: Int) -> Unit {\n  bytebuf_push_opcode_u32_u32(buf, op_i32_store, align, offset)\n}\n\nexport let emit_i64_const = (buf: Bytes, value: Int) -> Unit {\n  bytebuf_push_opcode_s64(buf, op_i64_const, value)\n}\n\nexport let emit_i64_div_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_div_s)\n}\n\nexport let emit_i64_rem_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_rem_s)\n}\n\nexport let emit_i64_shr_s = (buf: Bytes) -> Unit {\n  bytebuf_push(buf, op_i64_shr_s)\n}\n\nexport let emit_local_get = (buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_get, idx)\n}\n\nexport let emit_local_set = (buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_set, idx)\n}\n\nexport let emit_local_tee = (buf: Bytes, idx: Int) -> Unit {\n  bytebuf_push_opcode_u32(buf, op_local_tee, idx)\n}\n\nexport let emit_loop_void = (buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_loop, bt_void)\n}\n\nlet op_i32_load8_u = 45\n\nexport let emit_block_void = (buf: Bytes) -> Unit {\n  bytebuf_push2(buf, op_block, bt_void)\n}\n\nexport let emit_i32_store8 = (buf: Bytes, align: Int, offset: Int) -> Un