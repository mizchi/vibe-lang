"//# Types\n\nexport enum Pat {\n  PWild;\n  PBind(String);\n  PInt(Int);\n  PString(String);\n  PBool(Bool);\n  PCtor(String, Array[Pat]);\n  PTuple(Array[Pat]);\n  POr(Pat, Pat)\n}\n\nexport enum TypeExpr {\n  TyName(String);\n  TyApp(String, Array[TypeExpr]);\n  TyFn(Array[TypeExpr], TypeExpr);\n  TyTuple(Array[TypeExpr]);\n  TyUnit\n}\n\nexport enum Expr {\n  EInt(Int);\n  EFloat(Double);\n  EString(String);\n  EBool(Bool);\n  EIdent(String);\n  ETuple(Array[Expr]);\n  EArray(Array[Expr]);\n  ERecord(Array[(String, Expr)]);\n  EIf(Expr, Expr, Expr);\n  ELet(String, Expr, Expr);\n  ELetRec(String, Expr, Expr);\n  ELetMut(String, Expr, Expr);\n  EAssign(String, Expr, Expr);\n  EAssignOp(String, String, Expr, Expr);\n  ESeq(Expr, Expr);\n  EMatch(Expr, Array[(Pat, Expr)]);\n  EHandle(Expr, Array[(Pat, Expr)]);\n  EWhile(Expr, Expr);\n  EForIn(String, Expr, Expr);\n  ECall(Expr, Array[Expr]);\n  EBinOp(String, Expr, Expr);\n  EUnaryOp(String, Expr);\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\n  EDot(Expr, String);\n  ELabeledArg(String, String, Expr);\n  EThrow(Expr);\n  EBreak(Option[Expr]);\n  EContinue(Array[Expr]);\n  EUnit\n}\n\nexport enum Stmt {\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\n  SLetMut(String, Option[TypeExpr], Expr);\n  SEnum(Bool, String, Array[(String, Array[TypeExpr])]);\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\n  STypeAlias(Bool, String, TypeExpr);\n  STrait(Bool, String, Array[String]);\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\n  SExternLet(String, TypeExpr);\n  SImport(String, Array[(String, Option[String])]);\n  STest(String, Expr);\n  SBench(String, Expr);\n  SExpr(Expr);\n  SExport(Array[String]);\n  SReExport(String, Array[(String, Option[String])]);\n  SModule(Bool, String, Array[Stmt])\n}\n")
