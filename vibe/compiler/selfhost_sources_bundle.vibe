tString), CtInt, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nlet lookup_http_response_body = (name: String) -> Option[Type] {\n  if name == \"Http::response_body\" {\n    Some(CtFn(one_param(CtUnknown), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_socket_tcp_connect = (name: String) -> Option[Type] {\n  if name == \"Socket::tcp_connect\" {\n    Some(CtFn(two_params(CtString, CtInt), CtUnknown, Some(\"TcpSocket\")))\n  }\n  else None\n}\n\nlet lookup_net_group_a = (name: String) -> Option[Type] {\n  match lookup_socket_tcp_connect(name) {\n    Some(t) => Some(t),\n    None => match lookup_socket_tcp_read(name) {\n      Some(t) => Some(t),\n      None => match lookup_socket_tcp_write(name) {\n        Some(t) => Some(t),\n        None => lookup_socket_tcp_close(name)\n      }\n    }\n  }\n}\n\nlet lookup_http_request_header = (name: String) -> Option[Type] {\n  if name == \"Http::request_header\" {\n    Some(CtFn(two_params(CtUnknown, CtString), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nlet lookup_net_group_d = (name: String) -> Option[Type] {\n  match lookup_http_request_header(name) {\n    Some(t) => Some(t),\n    None => lookup_http_respond(name)\n  }\n}\n\nlet lookup_http_request_method = (name: String) -> Option[Type] {\n  if name == \"Http::request_method\" {\n    Some(CtFn(one_param(CtUnknown), CtString, Some(\"HttpIncoming\")))\n  }\n  else None\n}\n\nlet lookup_net_group_c = (name: String) -> Option[Type] {\n  match lookup_http_close(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_listen(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_accept(name) {\n        Some(t) => Some(t),\n        None => lookup_http_request_method(name)\n      }\n    }\n  }\n}\n\nlet lookup_http_response_header = (name: String) -> Option[Type] {\n  if name == \"Http::response_header\" {\n    Some(CtFn(two_params(CtUnknown, CtString), CtString, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_http_response_status = (name: String) -> Option[Type] {\n  if name == \"Http::response_status\" {\n    Some(CtFn(one_param(CtUnknown), CtInt, Some(\"HttpClient\")))\n  }\n  else None\n}\n\nlet lookup_net_group_b = (name: String) -> Option[Type] {\n  match lookup_http_request(name) {\n    Some(t) => Some(t),\n    None => match lookup_http_response_status(name) {\n      Some(t) => Some(t),\n      None => match lookup_http_response_header(name) {\n        Some(t) => Some(t),\n        None => lookup_http_response_body(name)\n      }\n    }\n  }\n}\n\nexport let lookup_net = (name: String) -> Option[Type] {\n  match lookup_net_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_net_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_net_group_c(name) {\n        Some(t) => Some(t),\n        None => lookup_net_group_d(name)\n      }\n    }\n  }\n}\n")

  let source_26 = ("vibe/compiler/checker/builtins_misc.vibe",
"\n\n\nlet no_params = () -> Array[Type] {\n  Array::slice([\n    CtUnknown\n  ], 0, 0)\n}\n\nlet one_param = (a: Type) -> Array[Type] {\n  let arr = no_params()\n  Array::push(arr, a)\n  arr\n}\n\nlet lookup_not = (name: String) -> Option[Type] {\n  if name == \"not\" {\n    Some(CtFn(one_param(CtBool), CtBool, None))\n  }\n  else None\n}\n\nlet two_params = (a: Type, b: Type) -> Array[Type] {\n  let arr = no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  arr\n}\n\nlet lookup_eq = (name: String) -> Option[Type] {\n  if name == \"eq\" {\n    Some(CtFn(two_params(CtInt, CtInt), CtBool, None))\n  }\n  else None\n}\n\nlet lookup_none = (name: String) -> Option[Type] {\n  if name == \"None\" {\n    Some(CtOption(CtUnknown))\n  }\n  else None\n}\n\nlet lookup_some = (name: String) -> Option[Type] {\n  if name == \"Some\" {\n    Some(CtFn(one_param(CtUnknown), CtOption(CtUnknown), None))\n  }\n  else None\n}\n\nlet lookup_index = (name: String) -> Option[Type] {\n  if name == \"__index\" {\n    Some(CtFn(two_params(CtUnknown, CtUnknown), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_print = (name: String) -> Option[Type] {\n  if name == \"print\" {\n    Some(CtFn(one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_throw = (name: String) -> Option[Type] {\n  if name == \"throw\" {\n    Some(CtFn(one_param(CtString), CtUnknown, Some(\"Error\")))\n  }\n  else None\n}\n\nlet three_params = (a: Type, b: Type, c: Type) -> Array[Type] {\n  let arr = no_params()\n  Array::push(arr, a)\n  Array::push(arr, b)\n  Array::push(arr, c)\n  arr\n}\n\nlet lookup_slice = (name: String) -> Option[Type] {\n  if name == \"__slice\" {\n    Some(CtFn(three_params(CtUnknown, CtInt, CtInt), CtUnknown, None))\n  }\n  else None\n}\n\nlet lookup_assert = (name: String) -> Option[Type] {\n  if name == \"assert\" {\n    Some(CtFn(one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_true\" {\n    Some(CtFn(one_param(CtBool), CtUnit, None))\n  }\n  else if name == \"assert_eq\" {\n    Some(CtFn([\n      CtUnknown,\n      CtUnknown\n    ], CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_println = (name: String) -> Option[Type] {\n  if name == \"println\" {\n    Some(CtFn(one_param(CtString), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_to_string = (name: String) -> Option[Type] {\n  if name == \"__to_string\" {\n    Some(CtFn(one_param(CtUnknown), CtString, None))\n  }\n  else None\n}\n\nlet lookup_char_to_int = (name: String) -> Option[Type] {\n  if name == \"Char::to_int\" {\n    Some(CtFn(one_param(CtChar), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_a = (name: String) -> Option[Type] {\n  match lookup_eq(name) {\n    Some(t) => Some(t),\n    None => match lookup_not(name) {\n      Some(t) => Some(t),\n      None => match lookup_to_string(name) {\n        Some(t) => Some(t),\n        None => lookup_index(name)\n      }\n    }\n  }\n}\n\nlet lookup_misc_group_b = (name: String) -> Option[Type] {\n  match lookup_slice(name) {\n    Some(t) => Some(t),\n    None => match lookup_print(name) {\n      Some(t) => Some(t),\n      None => match lookup_println(name) {\n        Some(t) => Some(t),\n        None => lookup_assert(name)\n      }\n    }\n  }\n}\n\nlet lookup_misc_group_e = (name: String) -> Option[Type] {\n  lookup_none(name)\n}\n\nlet lookup_char_from_int = (name: String) -> Option[Type] {\n  if name == \"Char::from_int\" {\n    Some(CtFn(one_param(CtInt), CtChar, None))\n  }\n  else None\n}\n\nlet lookup_double_to_int = (name: String) -> Option[Type] {\n  if name == \"Double::to_int\" {\n    Some(CtFn(one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_int_to_double = (name: String) -> Option[Type] {\n  if name == \"Int::to_double\" {\n    Some(CtFn(one_param(CtInt), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_double_to_i64_bits = (name: String) -> Option[Type] {\n  if name == \"Double::to_i64_bits\" {\n    Some(CtFn(one_param(CtDouble), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_c = (name: String) -> Option[Type] {\n  match lookup_throw(name) {\n    Some(t) => Some(t),\n    None => match lookup_int_to_double(name) {\n      Some(t) => Some(t),\n      None => match lookup_double_to_int(name) {\n        Some(t) => Some(t),\n        None => lookup_double_to_i64_bits(name)\n      }\n    }\n  }\n}\n\nlet lookup_double_from_i64_bits = (name: String) -> Option[Type] {\n  if name == \"Double::from_i64_bits\" {\n    Some(CtFn(one_param(CtInt), CtDouble, None))\n  }\n  else None\n}\n\nlet lookup_misc_group_d = (name: String) -> Option[Type] {\n  match lookup_double_from_i64_bits(name) {\n    Some(t) => Some(t),\n    None => match lookup_char_to_int(name) {\n      Some(t) => Some(t),\n      None => match lookup_char_from_int(name) {\n        Some(t) => Some(t),\n        None => lookup_some(name)\n      }\n    }\n  }\n}\n\nexport let lookup_misc = (name: String) -> Option[Type] {\n  match lookup_misc_group_a(name) {\n    Some(t) => Some(t),\n    None => match lookup_misc_group_b(name) {\n      Some(t) => Some(t),\n      None => match lookup_misc_group_c(name) {\n        Some(t) => Some(t),\n        None => match lookup_misc_group_d(name) {\n          Some(t) => Some(t),\n          None => lookup_misc_group_e(name)\n        }\n      }\n    }\n  }\n}\n")

  let source_27 = ("vibe/compiler/checker/builtins_array.vibe",
