sics: \\\", String::concat(fname, \\\" unsupported on gc backend\\\")))\\n      }\\n      else {\\n        let fn_len2 = Array::length(ctx.func_table.names)\\n        let mut fn_idx_in_list = -1\\n        let mut __fi = 0\\n        while __fi < fn_len2 {\\n          if Array::get(ctx.func_table.names, __fi) == fname {\\n            fn_idx_in_list = __fi\\n            __fi = fn_len2\\n          } else {\\n            __fi = __fi + 1\\n          }\\n        }\\n        if fn_idx_in_list >= 0 {\\n          let fidx = Array::get(ctx.func_table.indices, fn_idx_in_list)\\n          let has_ret = Array::get(ctx.func_table.returns, fn_idx_in_list)\\n          let mut nl = next_local\\n          let mut ci = 0\\n          while ci < Array::length(args) {\\n            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\\n            ci = ci + 1\\n          }\\n          if ctx.func_offset > 0 {\\n            if fidx >= ctx.func_offset {\\n              emit_i64_const(buf, 0)\\n            }\\n          }\\n          emit_call(buf, fidx)\\n          if has_ret == 0 {\\n            emit_i64_const(buf, 0)\\n          }\\n          nl\\n        } else {\\n          let local_idx2 = resolve_local(local_names, fname, \\\"gc_call\\\")\\n          let num_args = Array::length(args)\\n          let fn_val_local = next_local\\n          let slot_local = next_local + 1\\n          let env_local = next_local + 2\\n          let mut nl = next_local + 3\\n          Array::push(local_names, \\\"__fn_val\\\")\\n          Array::push(local_names, \\\"__slot\\\")\\n          Array::push(local_names, \\\"__env\\\")\\n          emit_local_get(buf, local_idx2)\\n          emit_local_set(buf, fn_val_local)\\n          emit_closure_resolve(buf, fn_val_local, slot_local, env_local)\\n          let mut ci = 0\\n          while ci < num_args {\\n            nl = ce(buf, Array::get(args, ci), local_names, nl, ld)\\n            ci = ci + 1\\n          }\\n          emit_closure_call_tail(buf, env_l