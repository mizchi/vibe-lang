,\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  rc_shadow_base, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport .. / wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_heap_memory_grow_check, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\n//# Functions\\n\\nexport let gen_arr_get_body: (Bool) -> Bytes = (enable_rc) -> {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.\\n  if enable_rc {\\n    emit_i64_const(b, -2)\\n    emit_i64_and(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_i32_load(b, 2, 8)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 2)\\n  emit_local_get(b, 1)\\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 3)\\n  bytebuf_push(b, 116)\\n  emit_i32_add(b)\\n  emit_i64_load(b, 3, 0)\\n  b\\n}\\n\\nexport let gen_arr_len_body: (Bool) -> Bytes = (enable_rc) -> {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.\\n  if enable_rc {\\n    emit_i64_const(b, -2)\\n    emit_i64_and(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_i32_load(b, 2, 4)\\n  emit_i64_extend_i32_u(b)\\n  // ADR-0055 Stage 1: length is a count entering the value world; tag it.\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shl(b)\\n  }\\n  b\\n}\\n\\nexport let gen_arr_new_body: (Bool, Int) -> Bytes = (enable_rc, rc_alloc_idx) -> {\\n  let b = bytebuf_new()\\n  if enable_rc {\\n    // ADR-0055 Stage 2c: give array_new the same RC block header as literal\\n    // arrays ([alloc_size@0][rc_count@4][class@7]), value = block+8, so EVERY\\n    // odd array pointer is self-describing and the recursive rc_drop can reach\\n    // it safely. capacity 8, length 0, data_ptr = value+12 (block+20), inline\\n    // buffer 8 slots → total 84 (== a cap-8 literal, so the free-list reuses it).\\n    // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc) so\\n    // a freed array block is reused — a raw bump leaks one block per array_new in\\n    // a build-and-discard loop.\\n    emit_i64_const(b, 84)\\n    emit_call(b, rc_alloc_idx)\\n    emit_i32_wrap_i64(b)\\n    emit_local_set(b, 0)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 84)\\n    emit_i32_store(b, 2, 0)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 1)\\n    emit_i32_store(b, 2, 4)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 5)\\n    emit_i32_store8(b, 0, 7)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 8)\\n    emit_i32_store(b, 2, 8)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 0)\\n    emit_i32_store(b, 2, 12)\\n    emit_local_get(b, 0)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 20)\\n    emit_i32_add(b)\\n    emit_i32_store(b, 2, 16)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 8)\\n    emit_i32_add(b)\\n    emit_i64_extend_i32_u(b)\\n    emit_i64_const(b, 1)\\n    emit_i64_or(b)\\n  } else {\\n    emit_global_get(b, 0)\\n    emit_local_tee(b, 0)\\n    emit_i32_const(b, 76)\\n    emit_i32_add(b)\\n    emit_global_set(b, 0)\\n    emit_heap_memory_grow_check(b)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 8)\\n    emit_i32_store(b, 2, 0)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 0)\\n    emit_i32_store(b, 2, 4)\\n    emit_local_get(b, 0)\\n    emit_local_get(b, 0)\\n    emit_i32_const(b, 12)\\n    emit_i32_add(b)\\n    emit_i32_store(b, 2, 8)\\n    emit_local_get(b, 0)\\n    emit_i64_extend_i32_u(b)\\n  }\\n  b\\n}\\n\\nexport let gen_arr_set_body: (Bool) -> Bytes = (enable_rc) -> {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  // ADR-0055 Stage 2b: array value is an odd pointer; untag before use.\\n  if enable_rc {\\n    emit_i64_const(b, -2)\\n    emit_i64_and(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_i32_load(b, 2, 8)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 3)\\n  emit_local_get(b, 1)\\n  // ADR-0055 Stage 1: the index arrives tagged (n<<1); untag before use.\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 3)\\n  bytebuf_push(b, 116)\\n  emit_i32_add(b)\\n  emit_local_get(b, 2)\\n  emit_i64_store(b, 3, 0)\\n  b\\n}\\n\\n// ADR-0055 Stage 3: the generic recursive rc_drop helper (linear RC backend).\\n// Signature (i64 value) -> (): decrement the value's reference count and, at\\n// zero, recursively drop its heap fields before pushing the block onto the\\n// free-list (global 2). `self_idx` is this function's own wasm index so it can\\n// recurse into fields to arbitrary depth.\\n//\\n// Value representation (ADR-0055): a heap pointer is odd (`(block+8)|1`); an\\n// int/bool is even (`n<<1`). The block header is\\n//   [alloc_size@block+0][rc_count@block+4 (class id in high byte)] and\\n//   value = block+8 → live header at value-8 / value-4, payload at value+8.\\n// The drop-class byte (value-1) is: 1 = field-vector (tuple/record/ctor/\\n// closure: [_@value+0][count@value+4][fields@value+8+i*8]); 5 = array\\n// (length@value+4, data_ptr@value+8, elements at data_ptr+i*8). Anything else\\n// (leaf: int/bool/string/float/bare-fn, or an unheadered pointer) is freed\\n// without following fields.\\n//\\n// Locals: 0 = i64 v (param); 1 vptr, 2 class, 3 cnt, 4 idx, 5 dptr (i32);\\n// 6 = i64 field value.\\nexport let gen_rc_drop_body: (Int, Bool) -> Bytes = (self_idx, rc_shadow) -> {\\n  let b = bytebuf_new()\\n  // not a heap pointer (even) → nothing to do\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_and(b)\\n  emit_i64_eqz(b)\\n  emit_if_void(b)\\n  emit_return(b)\\n  emit_end(b)\\n  // string/bytes fat pointer ((offset<<32)|length): the data offset (>= 64)\\n  // lives in the high 32 bits, whereas every heap block address is < 2^32\\n  // (high 32 bits == 0). So if (v >> 32) != 0 it is a leaf fat pointer, not an\\n  // RC block → skip. (Values here are positive, so shr_s == shr_u.)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 32)\\n  emit_i64_shr_s(b)\\n  emit_i64_eqz(b)\\n  emit_i32_eqz(b)\\n  emit_if_void(b)\\n  emit_return(b)\\n  emit_end(b)\\n  // vptr = (v & -2) as i32  (untag the odd pointer to the value pointer)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, -2)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 1)\\n  // #715 recurrence guard (VIBE_RC=shadow): trap BEFORE the rc-- below if the\\n  // shadow byte says this block is already freed. For a freed block, vptr-4\\n  // is the free-list NEXT link, so a drop-of-freed would silently corrupt the\\n  // list (decrement the link) and usually return without reaching zero --\\n  // the entry check is the only reliable place to catch it.\\n  if rc_shadow {\\n    emit_local_get(b, 1)\\n    emit_i32_const(b, rc_shadow_base())\\n    emit_i32_add(b)\\n    emit_i32_load8_u(b, 0, 0)\\n    emit_if_void(b)\\n    bytebuf_push(b, 0)\\n    emit_end(b)\\n  } else {\\n    ()\\n  }\\n  // #720: a saturated rc (low 24 bits == 0xFFFFFF) marks an immortal block\\n  // (see emit_rc_word_inc_saturating) -- never decrement, never free.\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_i32_const(b, 16777215)\\n  bytebuf_push(b, 113)\\n  emit_i32_const(b, 16777215)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_return(b)\\n  emit_end(b)\\n  // rc_count-- : store(vptr-4, load(vptr-4) - 1). The class byte is the high\\n  // byte of the same word; subtracting 1 from a non-zero rc never borrows into\\n  // it, so it is preserved.\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_sub(b)\\n  emit_i32_store(b, 2, 0)\\n  // if rc (low 24 bits) != 0 → still referenced → return. `* 256` shifts the\\n  // class byte out of the 32-bit word so only rc is tested.\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_i32_const(b, 256)\\n  emit_i32_mul(b)\\n  emit_i32_eqz(b)\\n  emit_i32_eqz(b)\\n  emit_if_void(b)\\n  emit_return(b)\\n  emit_end(b)\\n  // class = load8u(vptr-1)\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 1)\\n  emit_i32_sub(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_local_set(b, 2)\\n  // field-vector (class 1): for idx in 0..count: rc_drop(load_i64(vptr+8+idx*8))\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 1)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 1)\\n  emit_i32_load(b, 2, 4)\\n  emit_local_set(b, 3)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 4)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 3)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 8)\\n  emit_i32_mul(b)\\n  emit_i32_add(b)\\n  emit_i64_load(b, 3, 8)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 6)\\n  emit_call(b, self_idx)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 4)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_end(b)\\n  // array (class 5): for idx in 0..length: rc_drop(load_i64(data_ptr+idx*8))\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 5)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 1)\\n  emit_i32_load(b, 2, 4)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 1)\\n  emit_i32_load(b, 2, 8)\\n  emit_local_set(b, 5)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 4)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 3)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 8)\\n  emit_i32_mul(b)\\n  emit_i32_add(b)\\n  emit_i64_load(b, 3, 0)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 6)\\n  emit_call(b, self_idx)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 4)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  // ADR-0055 Stage 4: free a grown (separate) data buffer. An inline buffer sits\\n  // at value+12 (vptr+12) and is freed with the block; a buffer grown by\\n  // Array::push is a headered block of its own (data_ptr = its value pointer, so\\n  // size@data_ptr-8, next@data_ptr-4) — push onto the free-list head when\\n  // data_ptr != vptr+12. Elements were already dropped by the loop above.\\n  emit_local_get(b, 5)\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 12)\\n  emit_i32_add(b)\\n  emit_i32_ne(b)\\n  emit_if_void(b)\\n  // #715 recurrence guard (VIBE_RC=shadow): double-free check for the\\n  // grown buffer -- a second free-list push of the same buffer makes two\\n  // later allocations return overlapping memory (type confusion), which\\n  // plain marking cannot catch. Works under quarantine too (marks are\\n  // permanent).\\n  if rc_shadow {\\n    emit_local_get(b, 5)\\n    emit_i32_const(b, rc_shadow_base())\\n    emit_i32_add(b)\\n    emit_i32_load8_u(b, 0, 0)\\n    emit_if_void(b)\\n    bytebuf_push(b, 0)\\n    emit_end(b)\\n  } else {\\n    ()\\n  }\\n  // #715 recurrence guard (VIBE_RC=shadow): mark the grown buffer freed.\\n  if rc_shadow {\\n    emit_local_get(b, 5)\\n    emit_i32_const(b, rc_shadow_base())\\n    emit_i32_add(b)\\n    emit_i32_const(b, 1)\\n    emit_i32_store8(b, 0, 0)\\n  } else {\\n    ()\\n  }\\n  emit_local_get(b, 5)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_global_get(b, 2)\\n  emit_i32_store(b, 2, 0)\\n  emit_local_get(b, 5)\\n  emit_global_set(b, 2)\\n  emit_end(b)\\n  emit_end(b)\\n  // map (class 6): count@value+0, then `count` entries of (key@+8, val@+16) on a\\n  // 16-byte stride (MapBuilder layout). Recursively drop each key and val, then\\n  // fall through to the common block free. (cnt = local 3, idx = local 4.)\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 6)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 1)\\n  emit_i32_load(b, 2, 0)\\n  emit_local_set(b, 3)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 4)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 3)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 16)\\n  emit_i32_mul(b)\\n  emit_i32_add(b)\\n  emit_i64_load(b, 3, 8)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 6)\\n  emit_call(b, self_idx)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 16)\\n  emit_i32_mul(b)\\n  emit_i32_add(b)\\n  emit_i64_load(b, 3, 16)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 6)\\n  emit_call(b, self_idx)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 4)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_end(b)\\n  // #699 ref cell (class 8): a heap-boxed `let mut` holds a single value at\\n  // vptr+0. Drop it recursively (scalar payloads are a no-op via the odd-check),\\n  // then fall through to the common free.\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 8)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 1)\\n  emit_i64_load(b, 3, 0)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 6)\\n  emit_call(b, self_idx)\\n  emit_end(b)\\n  // #699 closure (class 7): the env at vptr+8 holds `count`(@vptr+4) captures.\\n  // Captures are BORROWED (no dup at capture) EXCEPT owned RC ref cells, which\\n  // are stored odd-tagged with their own class byte 8. Drop only those (each was\\n  // dup'd at capture); all other captures — scalars and borrowed heap values\\n  // (class 1/5/6/7) — are skipped, preserving the borrowed-capture model. Then\\n  // fall through to the common free.\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 7)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 1)\\n  emit_i32_load(b, 2, 4)\\n  emit_local_set(b, 3)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 4)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 4)\\n  emit_local_get(b, 3)\\n  emit_i32_ge_u(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 8)\\n  emit_i32_mul(b)\\n  emit_i32_add(b)\\n  emit_i64_load(b, 3, 8)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 6)\\n  emit_i64_const(b, 1)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 6)\\n  emit_i64_const(b, -2)\\n  emit_i64_and(b)\\n  emit_i32_wrap_i64(b)\\n  emit_i32_const(b, 1)\\n  emit_i32_sub(b)\\n  emit_i32_load8_u(b, 0, 0)\\n  emit_i32_const(b, 8)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 6)\\n  emit_call(b, self_idx)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 4)\\n  emit_i32_const(b, 1)\\n  emit_i32_add(b)\\n  emit_local_set(b, 4)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_end(b)\\n  // #715 recurrence guard (VIBE_RC=shadow): mark this block freed so a later\\n  // dup-of-freed (emit_rc_dup_guarded) or drop-of-freed (entry check above)\\n  // traps deterministically at the faulting operation.\\n  if rc_shadow {\\n    emit_local_get(b, 1)\\n    emit_i32_const(b, rc_shadow_base())\\n    emit_i32_add(b)\\n    emit_i32_const(b, 1)\\n    emit_i32_store8(b, 0, 0)\\n  } else {\\n    ()\\n  }\\n  // free: push block onto the free-list head (global 2), reusing the rc slot\\n  // (vptr-4) as the next pointer — matching the inline allocator/drop.\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_global_get(b, 2)\\n  emit_i32_store(b, 2, 0)\\n  emit_local_get(b, 1)\\n  emit_global_set(b, 2)\\n  b\\n}\\n\\n// ADR-0055 Stage 4: generic free-list allocator. Param 0 (i64) = block size in\\n// bytes; returns the i64 block_start of a reusable block. The single LIFO\\n// free-list (global 2) holds value pointers linked through the rc_count word\\n// (cur-4) with the alloc_size at cur-8. A head-only size check (the previous\\n// inline allocator) misses a matching block whenever it is not at the head — so\\n// allocating sizes A,B,A,B... while freeing them recursively (which reverses the\\n// order on the LIFO) bump-allocates every other block even though a perfectly\\n// sized free block exists deeper in the list (a fragmentation \\\"leak\\\"). This\\n// helper instead WALKS the list for an exact-fit block and unlinks it, falling\\n// back to a bump only when none exists. Exact-fit only (no splitting), so it is\\n// drop-in compatible with the recursive rc_drop free path.\\n// Locals: 0=size(i64 param) 1=cur 2=prev 3=sz(i32) 4=result.\\nexport let gen_rc_alloc_body: (Bool) -> Bytes = (rc_shadow) -> {\\n  let b = bytebuf_new()\\n  // sz = (i32) size\\n  emit_local_get(b, 0)\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 3)\\n  // cur = free-list head (global 2); prev = 0\\n  emit_global_get(b, 2)\\n  emit_local_set(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 2)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  // cur == 0 → not found, break to the bump path\\n  emit_local_get(b, 1)\\n  emit_i32_eqz(b)\\n  emit_br_if(b, 1)\\n  // load(cur-8) == sz → exact-fit block found\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 8)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_local_get(b, 3)\\n  emit_i32_eq(b)\\n  emit_if_void(b)\\n  // unlink cur: prev == 0 ? global2 = load(cur-4) : store(prev-4, load(cur-4))\\n  emit_local_get(b, 2)\\n  emit_i32_eqz(b)\\n  emit_if_void(b)\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_global_set(b, 2)\\n  emit_else(b)\\n  emit_local_get(b, 2)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_i32_store(b, 2, 0)\\n  emit_end(b)\\n  // #715 recurrence guard (VIBE_RC=shadow): the block is live again -- clear\\n  // its freed-marker byte so later dups/drops of the reused block are legal.\\n  if rc_shadow {\\n    emit_local_get(b, 1)\\n    emit_i32_const(b, rc_shadow_base())\\n    emit_i32_add(b)\\n    emit_i32_const(b, 0)\\n    emit_i32_store8(b, 0, 0)\\n  } else {\\n    ()\\n  }\\n  // return block_start = cur - 8\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 8)\\n  emit_i32_sub(b)\\n  emit_i64_extend_i32_u(b)\\n  emit_return(b)\\n  emit_end(b)\\n  // prev = cur; cur = load(cur-4); continue\\n  emit_local_get(b, 1)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 1)\\n  emit_i32_const(b, 4)\\n  emit_i32_sub(b)\\n  emit_i32_load(b, 2, 0)\\n  emit_local_set(b, 1)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  // bump: result = global0; global0 += sz; return (i64) result\\n  emit_global_get(b, 0)\\n  emit_local_set(b, 4)\\n  emit_global_get(b, 0)\\n  emit_local_get(b, 3)\\n  emit_i32_add(b)\\n  emit_global_set(b, 0)\\n  emit_heap_memory_grow_check(b)\\n  emit_local_get(b, 4)\\n  emit_i64_extend_i32_u(b)\\n  b\\n}\\n\\nexport let gen_str_len_body: (Bool) -> Bytes = (enable_rc) -> {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  // ADR-0055 Stage 1: the length is a count entering the value world; tag it\\n  // (n<<1) under RC so the uniform caller-side untag recovers the true length.\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shl(b)\\n  }\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_87 = () -> (String, String) {\n  (\"vibe/compiler/codegen/builtin_bodies/bodies_core_a1a.vibe\",\n\"//# Imports\\n\\nexport ./bodies_core_a1a1.vibe {\\n  gen_eq_body, gen_str_eq_body\\n}\\n\\nexport ./bodies_core_a1a2.vibe {\\n  gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_set_body, gen_rc_drop_body, gen_rc_alloc_body, gen_str_len_body\\n}\\n\\n//# Misc\\n\\nexport {\\n  gen_eq_body, gen_str_eq_body, gen_arr_get_body, gen_arr_len_body, gen_arr_new_body, gen_arr_set_body, gen_rc_drop_body, gen_rc_alloc_body, gen_str_len_body\\n}\\n\")\n}\n\nlet cli_adapter_source_88 = () -> (String, String) {\n  (\"vibe/compiler/codegen/builtin_bodies/bodies_core_a1b.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  rc_shadow_base, CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_