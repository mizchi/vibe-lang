(CtFn(bytes_three_params(CtBytes, CtInt, CtInt), CtBytes, None))\n  }\n  else None\n}\n\nlet lookup_bytes_append: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::append\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtUnit, None))\n  }\n  else None\n}\n\nlet lookup_bytes_concat: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::concat\" {\n    Some(CtFn(bytes_two_params(CtBytes, CtBytes), CtBytes, None))\n  }\n  else None\n}\n\nlet lookup_bytes_length: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::length\" {\n    Some(CtFn(bytes_one_param(CtBytes), CtInt, None))\n  }\n  else None\n}\n\nlet lookup_bytes_group_a: (String) -> Option[Type] = (name) -> {\n  match lookup_bytes_new(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_length(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_get(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_set(name)\n      }\n    }\n  }\n}\n\nlet lookup_bytes_group_b: (String) -> Option[Type] = (name) -> {\n  match lookup_bytes_push(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_concat(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_slice(name) {\n        Some(t) => Some(t),\n        None => lookup_bytes_append(name)\n      }\n    }\n  }\n}\n\nlet lookup_bytes_to_array: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::to_array\" {\n    Some(CtFn(bytes_one_param(CtBytes), CtArray(CtInt), None))\n  }\n  else None\n}\n\nlet lookup_bytes_from_array: (String) -> Option[Type] = (name) -> {\n  if name == \"Bytes::from_array\" {\n    Some(CtFn(bytes_one_param(CtArray(CtInt)), CtBytes, None))\n  }\n  else None\n}\n\nlet lookup_bytes_group_c: (String) -> Option[Type] = (name) -> {\n  match lookup_bytes_blit(name) {\n    Some(t) => Some(t),\n    None => match lookup_bytes_fill(name) {\n      Some(t) => Some(t),\n      None => match lookup_bytes_from_array(name) {\n        Some(t) => Some(t),\n       