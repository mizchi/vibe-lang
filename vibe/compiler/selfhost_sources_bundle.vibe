bytebuf_push_vec_header(code_content, Array::length(bodies))\\n  let mut ci = 0\\n  while ci < Array::length(bodies) {\\n    let body = Array::get(bodies, ci)\\n    let func_buf = bytebuf_new()\\n    let ni32 = Array::get(meta_i32, ci)\\n    let ni64 = Array::get(meta_i64, ci)\\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\\n    let num_ref_locals = Array::length(ref_indices)\\n    if num_ref_locals == 0 {\\n      if ni32 == 0 {\\n        if ni64 == 0 {\\n          leb128_encode_u32(func_buf, 0)\\n        } else {\\n          leb128_encode_u32(func_buf, 1)\\n          leb128_encode_u32(func_buf, ni64)\\n          bytebuf_push(func_buf, 126)\\n        }\\n      } else {\\n        if ni64 == 0 {\\n          leb128_encode_u32(func_buf, 1)\\n          leb128_encode_u32(func_buf, ni32)\\n          bytebuf_push(func_buf, 127)\\n        } else {\\n          leb128_encode_u32(func_buf, 2)\\n          leb128_encode_u32(func_buf, ni32)\\n          bytebuf_push(func_buf, 127)\\n          leb128_encode_u32(func_buf, ni64)\\n          bytebuf_push(func_buf, 126)\\n        }\\n      }\\n    } else {\\n      let body_idx_in_user = ci - num_generated\\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\\n      let num_extra = ni64\\n      leb128_encode_u32(func_buf, num_extra)\\n      let mut rli = 0\\n      while rli < num_extra {\\n        let actual_local_idx = param_count_for_body + rli\\n        let mut is_ref = false\\n        let mut ri = 0\\n        while ri < num_ref_locals {\\n          if Array::get(ref_indices, ri) == actual_local_idx {\\n            is_ref = true\\n          }\\n          ri = ri + 1\\n        }\\n        leb128_encode_u32(func_buf, 1)\\n        if is_ref {\\n          bytebuf_push(func_buf, 100)\\n          leb128_encode_u32(func_buf, refcell_type_idx)\\n        } else {\\n          bytebuf_push(func_buf, 126)\\n        }\\n        rli = rli + 1\\n      }\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(code_content, func_buf)\\n    ci = ci + 1\\n  }\\n  bytebuf_push_section(out, 10, code_content)\\n  if num_strings > 0 {\\n    let data_offsets = Array::slice([\\n      0\\n    ], 0, 0)\\n    let data_bufs = fresh_bytes_array()\\n    let mut di = 0\\n    while di < num_strings {\\n      Array::push(data_offsets, Array::get(str_offsets, di))\\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\\n      di = di + 1\\n    }\\n    emit_data_section_multi(out, data_offsets, data_bufs)\\n  }\\n  bytebuf_to_bytes(out)\\n}\\n\")\n}\n\nlet cli_adapter_source_105 = () -> (String, String) {\n  (\"vibe/compiler/codegen/gc/backend_expr.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, mut_needs_ref_cell\\n}\\n\\nimport .. / common_base {\\n  CompileCtxGc, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, find_func_stmt, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, str_table_lookup\\n}\\n\\nimport .. / wasm_emit {\\n  emit_heap_memory_grow_check, emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_struct_get, emit_struct_new, emit_struct_set, emit_struct_type_raw, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./backend_builtins_array_alloc.vibe {\\n  gc_gen_arr_len_body, gc_gen_arr_new_body\\n}\\n\\nimport ./backend_builtins_array_get.vibe {\\n  gc_gen_arr_get_body\\n}\\n\\nimport ./backend_builtins_array_push.vibe {\\n  gc_gen_arr_push_body\\n}\\n\\nimport ./backend_builtins_array_set.vibe {\\n  gc_gen_arr_set_body\\n}\\n\\nimport ./backend_builtins_numeric.vibe {\\n  gc_gen_double_to_int_body, gc_gen_identity_body, gc_gen_int_to_double_body\\n}\\n\\nimport ./backend_builtins_print.vibe {\\n  gc_gen_print_i64_body, gc_gen_print_str_body\\n}\\n\\nimport ./backend_builtins_string.vibe {\\n  gc_gen_str_concat_body, gc_gen_str_eq_body, gc_gen_str_len_body\\n}\\n\\nimport ./backend_builtins_string_extra.vibe {\\n  gc_gen_str_char_code_at_body, gc_gen_str_from_char_code_body, gc_gen_str_substring_body\\n}\\n\\nimport ./backend_call.vibe {\\n  compile_call_gc\\n}\\n\\nimport ./backend_lambda_body.vibe {\\n  compile_lambda_gc\\n}\\n\\nimport ./backend_match.vibe {\\n  compile_match_gc\\n}\\n\\n//# Functions\\n\\nlet rec compile_expr_gc: (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld) -> {\\n  let ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error } = (b, e, ln, nl, d) -> {\\n    compile_expr_gc(b, e, ln, nl, ctx, d)\\n  }\\n  match expr {\\n    EInt(n) => {\\n      emit_i64_const(buf, n)\\n      next_local\\n    },\\n    EBool(b_val) => {\\n      emit_i64_const(buf, if b_val {\\n        1\\n      } else {\\n        0\\n      })\\n      next_local\\n    },\\n    EFloat(v) => {\\n      let bits = Double::to_i64_bits(v)\\n      emit_f64_const_bits(buf, bits)\\n      emit_i64_reinterpret_f64(buf)\\n      next_local\\n    },\\n    EString(s) => {\\n      let idx = str_table_lookup(ctx.str_table.strs, s)\\n      emit_str_ref(buf, Array::get(ctx.str_table.offsets, idx), Array::get(ctx.str_table.lengths, idx))\\n      next_local\\n    },\\n    EIdent(name, _) => {\\n      let len = Array::length(local_names)\\n      let rec try_local: (Int) -> Int = (i) -> {\\n        if i < 0 {\\n          -1\\n        }\\n        else if Array::get(local_names, i) == name {\\n          i\\n        }\\n        else try_local(i - 1)\\n      }\\n      let local_idx = try_local(len - 1)\\n      if local_idx >= 0 {\\n        if array_contains_str(ctx.ref_cell_names, name) {\\n          emit_local_get(buf, local_idx)\\n          emit_struct_get(buf, ctx.refcell_type_idx, 0)\\n        } else {\\n          emit_local_get(buf, local_idx)\\n        }\\n        next_local\\n      } else {\\n        let ctor_idx = lookup_ctor(ctx.ctor_table.names, name, 0)\\n        if ctor_idx >= 0 {\\n          let tag_c = Array::get(ctx.ctor_table.tags, ctor_idx)\\n          let ptr_l = next_local\\n          Array::push(local_names, \\\"__ctor_ptr\\\")\\n          emit_global_get(buf, 0)\\n          emit_i64_extend_i32_u(buf)\\n          emit_local_set(buf, ptr_l)\\n          emit_global_get(buf, 0)\\n          emit_i32_const(buf, 8)\\n          emit_i32_add(buf)\\n          emit_global_set(buf, 0)\\n          // #415: gc-lane heap bump must grow linear memory like the linear\\n          // backend does -- without this any allocation past the initial page\\n          // traps OOB (the gc smoke fixture only ever allocated a few bytes).\\n          emit_heap_memory_grow_check(buf)\\n          emit_local_get(buf, ptr_l)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_const(buf, tag_c)\\n          emit_i32_store(buf, 2, 0)\\n          emit_local_get(buf, ptr_l)\\n          emit_i32_wrap_i64(buf)\\n          emit_i32_const(buf, 0)\\n          emit_i32_store(buf, 2, 4)\\n          emit_local_get(buf, ptr_l)\\n          emit_i64_const(buf, 1)\\n          emit_i64_or(buf)\\n          next_local + 1\\n        } else {\\n          let fn_len = Array::length(ctx.func_table.names)\\n          let mut fni = -1\\n          let mut __fj = 0\\n          while __fj < fn_len {\\n            if Array::get(ctx.func_table.names, __fj) == name {\\n              fni = __fj\\n              __fj = fn_len\\n            } else {\\n              __fj = __fj + 1\\n            }\\n          }\\n          if fni < 0 {\\n            throw(String::concat(\\\"undefined variable: \\\", name))\\n          }\\n          let fidx = Array::get(ctx.func_table.indices, fni)\\n          let table_slot = fidx - ctx.func_offset\\n          emit_i64_const(buf, (table_slot<<2)|2)\\n          next_local\\n        }\\n      }\\n    },\\n    EBinOp(op, lhs, rhs) => {\\n      let nl1 = ce(buf, lhs, local_names, next_local, ld)\\n      let nl2 = ce(buf, rhs, local_names, nl1, ld)\\n      emit_binop_op(buf, op)\\n      nl2\\n    },\\n    EUnaryOp(op, operand) => if op == \\\"-\\\" {\\n      emit_i64_const(buf, 0)\\n      let nl = ce(buf, operand, local_names, next_local, ld)\\n      emit_i64_sub(buf)\\n      nl\\n    } else if op == \\\"!\\\" {\\n      let nl = ce(buf, operand, local_names, next_local, ld)\\n      emit_i64_eqz(buf)\\n      emit_i64_extend_i32_s(buf)\\n      nl\\n    } else {\\n      throw(String::concat(\\\"unsupported unary op: \\\", op))\\n    }\\n    ,\\n    EIf(cond, then_e, else_e) => {\\n      let nl1 = match cond {\\n        EBinOp(cop, clhs, crhs) => if cop == \\\"==\\\" || cop == \\\"!=\\\" || cop == \\\"<\\\" || cop == \\\">\\\" || cop == \\\"<=\\\" || cop == \\\">=\\\" {\\n          let cnl1 = ce(buf, clhs, local_names, next_local, ld)\\n          let cnl2 = ce(buf, crhs, local_names, cnl1, ld)\\n          if cop == \\\"==\\\" {\\n            emit_i64_eq(buf)\\n          }\\n          else if cop == \\\"!=\\\" {\\n            emit_i64_ne(buf)\\n          }\\n          else if cop == \\\"<\\\" {\\n            emit_i64_lt_s(buf)\\n          }\\n          else if cop == \\\">\\\" {\\n            emit_i64_gt_s(buf)\\n          }\\n          else if cop == \\\"<=\\\" {\\n            emit_i64_le_s(buf)\\n          }\\n          else {\\n            emit_i64_ge_s(buf)\\n          }\\n          cnl2\\n        } else {\\n          let cnl = ce(buf, cond, local_names, next_local, ld)\\n          emit_i32_wrap_i64(buf)\\n          cnl\\n        },\\n        EBool(b_val) => {\\n          emit_i32_const(buf, if b_val {\\n            1\\n          } else {\\n            0\\n          })\\n          next_local\\n        },\\n        _ => {\\n          let cnl = ce(buf, cond, local_names, next_local, ld)\\n          emit_i32_wrap_i64(buf)\\n          cnl\\n        }\\n      }\\n      emit_if_i64(buf)\\n      let ld_inner = if ld >= 0 {\\n        ld + 1\\n      } else {\\n        -1\\n      }\\n      let names_len_before = Array::length(local_names)\\n      let nl_then = ce(buf, then_e, local_names, nl1, ld_inner)\\n      emit_else(buf)\\n      Array::truncate(local_names, names_len_before)\\n      let nl_else = ce(buf, else_e, local_names, nl1, ld_inner)\\n      emit_end(buf)\\n      Array::truncate(local_names, names_len_before)\\n      let max_nl = if nl_then > nl_else {\\n        nl_then\\n      } else {\\n        nl_else\\n      }\\n      while Array::length(local_names) < max_nl {\\n        Array::push(local_names, \\\"\\\")\\n      }\\n      max_nl\\n    },\\n    ECall(callee, args, _) => compile_call_gc(buf, callee, args, local_names, next_local, ctx, ld, ce),\\n    ELet(name, value, body) => {\\n      let local_idx = next_local\\n      Array::push(local_names, name)\\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\\n      emit_local_set(buf, local_idx)\\n      ce(buf, body, local_names, nl, ld)\\n    },\\n    ELetRec(name, value, body) => {\\n      let local_idx = next_local\\n      Array::push(local_names, name)\\n      let nl = ce(buf, value, local_names, next_local + 1, ld)\\n      emit_local_set(buf, local_idx)\\n      match value {\\n        EFn(_, _, params, _, _, fn_body) => {\\n          let param_names_bp = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let mut bpi = 0\\n          while bpi < Array::length(params) {\\n            let (pn, _) = Array::get(params, bpi)\\n            Array::push(param_names_bp, pn)\\n            bpi = bpi + 1\\n          }\\n          let caps = collect_free_vars(fn_body, param_names_bp, Array::concat(ctx.func_table.names, ctx.ctor_table.names))\\n          let mut self_cap_idx = -1\\n          let mut bci = 0\\n          while bci < Array::length(caps) {\\n            if Array::get(caps, bci) == name {\\n              self_cap_idx = bci\\n            }\\n            bci = bci + 1\\n          }\\n          if self_cap_idx >= 0 {\\n            emit_local_get(buf, local_idx)\\n            emit_i64_const(buf, -4)\\n            emit_i64_and(buf)\\n            emit_i32_wrap_i64(buf)\\n            emit_local_get(buf, local_idx)\\n            emit_i64_store(buf, 3, 8 + self_cap_idx * 8)\\n          }\\n          0\\n        },\\n        _ => 0\\n      }\\n      ce(buf, body, local_names, nl, ld)\\n    },\\n    ELetMut(name, value, body) => {\\n      let local_idx = next_local\\n      Array::push(local_names, name)\\n      if mut_needs_ref_cell(body, name) {\\n        Array::push(ctx.ref_cell_names, name)\\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\\n        emit_struct_new(buf, ctx.refcell_type_idx)\\n        emit_local_set(buf, local_idx)\\n        Array::push(ctx.ref_local_indices, local_idx)\\n        let nl2 = ce(buf, body, local_names, nl, ld)\\n        nl2\\n      } else {\\n        let nl = ce(buf, value, local_names, next_local + 1, ld)\\n        emit_local_set(buf, local_idx)\\n        let nl2 = ce(buf, body, local_names, nl, ld)\\n        nl2\\n      }\\n    },\\n    EAssign(name, value, body) => {\\n      let idx = resolve_local(local_names, name, \\\"gc_var\\\")\\n      if array_contains_str(ctx.ref_cell_names, name) {\\n        emit_local_get(buf, idx)\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\\n        ce(buf, body, local_names, nl, ld)\\n      } else {\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_local_set(buf, idx)\\n        ce(buf, body, local_names, nl, ld)\\n      }\\n    },\\n    EAssignOp(name, op, value, body) => {\\n      let idx = resolve_local(local_names, name, \\\"gc_var\\\")\\n      if array_contains_str(ctx.ref_cell_names, name) {\\n        emit_local_get(buf, idx)\\n        emit_local_get(buf, idx)\\n        emit_struct_get(buf, ctx.refcell_type_idx, 0)\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_assignop_op(buf, op)\\n        emit_struct_set(buf, ctx.refcell_type_idx, 0)\\n        ce(buf, body, local_names, nl, ld)\\n      } else {\\n        emit_local_get(buf, idx)\\n        let nl = ce(buf, value, local_names, next_local, ld)\\n        emit_assignop_op(buf, op)\\n        emit_local_set(buf, idx)\\n        ce(buf, body, local_names, nl, ld)\\n      }\\n    },\\n    ESeq(first, second) => {\\n      let nl_s = ce(buf, first, local_names, next_local, ld)\\n      emit_drop(buf)\\n      ce(buf, second, local_names, nl_s, ld)\\n    },\\n    ETuple(elems) => {\\n      let num_elems = Array::length(elems)\\n      let alloc_size = num_elems * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__tuple_ptr\\\")\\n      let mut nl = next_local + 1\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_tee(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, alloc_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      // #415: gc-lane heap bump must grow linear memory like the linear\\n      // backend does -- without this any allocation past the initial page\\n      // traps OOB (the gc smoke fixture only ever allocated a few bytes).\\n      emit_heap_memory_grow_check(buf)\\n      let mut ti = 0\\n      while ti < num_elems {\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        nl = ce(buf, Array::get(elems, ti), local_names, nl, ld)\\n        emit_i64_store(buf, 3, ti * 8)\\n        ti = ti + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      nl\\n    },\\n    EMatch(scrutinee, arms) => compile_match_gc(buf, scrutinee, arms, local_names, next_local, ctx, ld, ce),\\n    EArray(elems) => {\\n      let (arr_new_idx, _, _) = resolve_func(ctx.func_table, \\\"array_new\\\")\\n      let (arr_push_idx, _, _) = resolve_func(ctx.func_table, \\\"Array::push\\\")\\n      let arr_local = next_local\\n      emit_call(buf, arr_new_idx)\\n      emit_local_set(buf, arr_local)\\n      Array::push(local_names, \\\"__arr_lit\\\")\\n      let mut nl = next_local + 1\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        emit_local_get(buf, arr_local)\\n        nl = ce(buf, Array::get(elems, ei), local_names, nl, ld)\\n        emit_call(buf, arr_push_idx)\\n  