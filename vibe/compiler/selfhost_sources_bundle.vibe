leb128_encode_u32(content, core_instance_idx)\\n      emit_name(content, Array::get(names, i))\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\nlet component_version_0 = 13\\nlet component_version_1 = 0\\nlet component_version_2 = 1\\nlet component_version_3 = 0\\nlet emit_component_header: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, component_magic_0)\\n  bytebuf_push(buf, component_magic_1)\\n  bytebuf_push(buf, component_magic_2)\\n  bytebuf_push(buf, component_magic_3)\\n  bytebuf_push(buf, component_version_0)\\n  bytebuf_push(buf, component_version_1)\\n  bytebuf_push(buf, component_version_2)\\n  bytebuf_push(buf, component_version_3)\\n}\\nlet section_core_instance = 2\\nlet comp_inst_arg_instance = 18\\nlet emit_core_module_section: (Bytes, Bytes) -> Unit = (buf, core_wasm) -> {\\n  bytebuf_push(buf, section_module)\\n  let wasm_len = Bytes::length(core_wasm)\\n  leb128_encode_u32(buf, wasm_len)\\n  bytebuf_push_buf(buf, core_wasm)\\n}\\nlet comp_underscores_to_dashes: (String) -> String = (name) -> {\\n  let len = String::length(name)\\n  let mut out = \\\"\\\"\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(name, i)\\n    if c == 95 {\\n      out = String::concat(out, \\\"-\\\")\\n    } else {\\n      out = String::concat(out, String::from_char_code(c))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\nlet normalize_comp_export_name: (String) -> String = (name) -> {\\n  comp_underscores_to_dashes(name)\\n}\\nlet emit_comp_export_section: (Bytes, String, Int) -> Unit = (buf, name, func_idx) -> {\\n  let export_name = normalize_comp_export_name(name)\\n  bytebuf_push(buf, section_export)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_name(content, export_name)\\n  bytebuf_push(content, comp_extern_func)\\n  leb128_encode_u32(content, func_idx)\\n  leb128_encode_u32(content, 0)\\n  emit_raw_content(buf, content)\\n}\\nlet emit_core_instance_from_exports: (Bytes, Int, Array[Int], Array[String], Array[Int]) -> Unit = (buf, num_modules, module_binding_counts, binding_func_names, binding_func_indices) -> {\\n  if num_modules == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_core_instance)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, num_modules)\\n    let mut offset = 0\\n    let mut m = 0\\n    while m < num_modules {\\n      let count = Array::get(module_binding_counts, m)\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, count)\\n      let mut b = 0\\n      while b < count {\\n        emit_name(content, Array::get(binding_func_names, offset + b))\\n        bytebuf_push(content, core_sort_func)\\n        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))\\n        b = b + 1\\n      }\\n      offset = offset + count\\n      m = m + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\nlet emit_core_instance_instantiate_section: (Bytes, Int, Array[String]) -> Unit = (buf, module_index, module_names) -> {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, module_index)\\n  leb128_encode_u32(content, Array::length(module_names))\\n  let mut i = 0\\n  while i < Array::length(module_names) {\\n    emit_name(content, Array::get(module_names, i))\\n    bytebuf_push(content, comp_inst_arg_instance)\\n    leb128_encode_u32(content, i)\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\nlet emit_canon_task_return: (Bytes, Int) -> Unit = (buf, result_valtype) -> {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 9)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, result_valtype)\\n  bytebuf_push(content, 0)\\n  emit_raw_content(buf, content)\\n}\\nlet emit_canon_lift_async_section: (Bytes, Int, Int) -> Unit = (buf, core_func_idx, type_idx) -> {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, core_func_idx)\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 6)\\n  leb128_encode_u32(content, type_idx)\\n  emit_raw_content(buf, content)\\n}\\nlet emit_comp_async_functype_section: (Bytes, Int) -> Unit = (buf, result_valtype) -> {\\n  bytebuf_push(buf, section_type)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 67)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, result_valtype)\\n  emit_raw_content(buf, content)\\n}\\nlet comp_valtype_to_core: (Int) -> Int = (v) -> {\\n  if v == comp_valtype_s64 {\\n    126\\n  }\\n  else {\\n    if v == comp_valtype_s32 {\\n      127\\n    }\\n    else {\\n      if v == comp_valtype_f32 {\\n        125\\n      }\\n      else {\\n        if v == comp_valtype_f64 {\\n          124\\n        }\\n        else {\\n          127\\n        }\\n      }\\n    }\\n  }\\n}\\nlet comp_generate_async_trampoline: (Int) -> Bytes = (core_valtype) -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let tc = bytebuf_new()\\n  bytebuf_push_vec_header(tc, 3)\\n  emit_func_type_raw(tc, [\\n    126\\n  ], [\\n    core_valtype\\n  ])\\n  emit_func_type_raw(tc, [\\n    core_valtype\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(tc, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, 1, tc)\\n  let ic = bytebuf_new()\\n  bytebuf_push_vec_header(ic, 2)\\n  emit_name(ic, \\\"main\\\")\\n  emit_name(ic, \\\"run\\\")\\n  bytebuf_push(ic, 0)\\n  bytebuf_push(ic, 0)\\n  emit_name(ic, \\\"cm\\\")\\n  emit_name(ic, \\\"task-return\\\")\\n  bytebuf_push(ic, 0)\\n  bytebuf_push(ic, 1)\\n  bytebuf_push_section(out, 2, ic)\\n  emit_function_section(out, [\\n    2\\n  ])\\n  emit_export_section(out, \\\"run\\\", 2)\\n  let body = bytebuf_new()\\n  emit_i64_const(body, 0)\\n  bytebuf_push(body, 16)\\n  leb128_encode_u32(body, 0)\\n  bytebuf_push(body, 16)\\n  leb128_encode_u32(body, 1)\\n  emit_code_section(out, [\\n    body\\n  ])\\n  bytebuf_to_bytes(out)\\n}\\nlet emit_core_instance_instantiate_args: (Bytes, Int, Array[String], Array[Int]) -> Unit = (buf, module_index, arg_names, arg_instance_indices) -> {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, module_index)\\n  leb128_encode_u32(content, Array::length(arg_names))\\n  let mut i = 0\\n  while i < Array::length(arg_names) {\\n    emit_name(content, Array::get(arg_names, i))\\n    bytebuf_push(content, comp_inst_arg_instance)\\n    leb128_encode_u32(content, Array::get(arg_instance_indices, i))\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\nlet comp_generate_wasi_fd_write_stub: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let tc = bytebuf_new()\\n  bytebuf_push_vec_header(tc, 1)\\n  emit_func_type_raw(tc, [\\n    127,\\n    127,\\n    127,\\n    127\\n  ], [\\n    127\\n  ])\\n  bytebuf_push_section(out, 1, tc)\\n  emit_function_section(out, [\\n    0\\n  ])\\n  emit_export_section(out, \\\"fd_write\\\", 0)\\n  let body = bytebuf_new()\\n  emit_i32_const(body, 0)\\n  emit_code_section(out, [\\n    body\\n  ])\\n  bytebuf_to_bytes(out)\\n}\\nexport let comp_emit_component_wasm_async_trampolined_p1: (Bytes, String, Int) -> Bytes = (main_core_wasm, export_name, comp_result_valtype) -> {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, main_core_wasm)\\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\\n  emit_core_instance_instantiate_section(buf, 2, Array::slice([\