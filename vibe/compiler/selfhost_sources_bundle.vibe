let mut di = 0\\n      while di < Array::length(arms) {\\n        let (apat, abody) = Array::get(arms, di)\\n        let aop = if is_pctor(apat) {\\n          effect_op_index(ctx.effect_op_keys, get_pctor_name(apat))\\n        } else {\\n          0 - 1\\n        }\\n        emit_global_get(buf, g_op_idx_global)\\n        emit_i64_const(buf, aop)\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        t6_bind_from_raw(buf, apat, raw_l, ctx, local_names)\\n        let anl = compile_expr(buf, abody, local_names, Array::length(local_names), ctx, ld)\\n        if anl > max_nl {\\n          max_nl = anl\\n        } else {\\n          ()\\n        }\\n        emit_else(buf)\\n        di = di + 1\\n      }\\n      bytebuf_push(buf, 0)\\n      let mut ce = 0\\n      while ce < Array::length(arms) {\\n        emit_end(buf)\\n        ce = ce + 1\\n      }\\n      max_nl\\n    } else {\\n      compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\\n    }\\n    emit_end(buf)\\n    emit_br(buf, 2)\\n    emit_end(buf)\\n    emit_drop(buf)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    bytebuf_push(buf, 0)\\n    emit_end(buf)\\n    nl2\\n  } else {\\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_71 = () -> (String, String) {\n  (\"vibe/compiler/codegen/expr/compile_expr_tail5.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_