_bytes\\n}\\n\\nexport let gen_arr_truncate_body: (Bool) -> Bytes = (enable_rc) -> {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  // ADR-0055: untag the odd array pointer under RC.\\n  if enable_rc {\\n    emit_i64_const(b, -2)\\n    emit_i64_and(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_local_get(b, 1)\\n  // ADR-0055: the new length arrives tagged; untag before storing.\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_i32_store(b, 2, 4)\\n  b\\n}\\n\\nexport let gen_string_split_body: (Bool, Int, Int, Int, Int, Int) -> Bytes = (enable_rc, arr_new_idx, arr_push_idx, str_len_idx, str_substring_idx, string_index_of_idx) -> {\\n  let b = bytebuf_new()\\n  emit_call(b, arr_new_idx)\\n  emit_local_set(b, 6)\\n  emit_local_get(b, 0)\\n  emit_call(b, str_len_idx)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 1)\\n  emit_call(b, str_len_idx)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 3)\\n  emit_i32_const(b, 0)\\n  emit_local_set(b, 4)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 4)\\n  emit_i64_extend_i32_u(b)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shl(b)\\n  }\\n  emit_local_get(b, 2)\\n  emit_i64_extend_i32_u(b)\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shl(b)\\n  }\\n  emit_call(b, str_substring_idx)\\n  emit_local_get(b, 1)\\n  emit_call(b, string_index_of_idx)\\n  // ADR-0055: String::index_of returns a tagged index under RC; untag for use.\\n  if enable_rc {\\n    emit_i64_const(b, 1)\\n    emit_i64_shr_s(b)\\n  }\\n  emit_i32_wrap_i64(b)\\n  emit_local_set(b, 5)\\n  emit_local_get(b, 5)\\n  emit_i32_const(b, 0)\\n  bytebuf_push(b, 72)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 6)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 4)\