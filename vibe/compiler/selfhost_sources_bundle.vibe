dapter.vibe\"\n  let sources = selfhost_cli_adapter_sources()\n  let source_groups = selfhost_cli_adapter_source_groups()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  let (bytes, _) = compile_with_source_groups_wasi_unchecked_cached(\n    db_new(),\n    adapter_source,\n    adapter_path,\n    source_groups,\n    \"cli_main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_cli_adapter_closure_len = () -> Int with { Error } {\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let sources = selfhost_cli_adapter_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  let (bytes, _) = compile_with_closure_sources_wasi_unchecked_cached(\n    db_new(),\n    adapter_source,\n    adapter_path,\n    sources,\n    \"cli_main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_cli_adapter_closure_ordered_source_count = () -> Int with { Error } {\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let sources = selfhost_cli_adapter_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  closure_ordered_source_count(adapter_source, adapter_path, sources)\n}\n\nexport let selfbuild_probe_cli_adapter_closure_merged_stmt_count = () -> Int with { Error } {\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let sources = selfhost_cli_adapter_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  closure_merged_stmt_count(adapter_source, adapter_path, sources)\n}\n\nexport let selfbuild_probe_cli_adapter_closure_pruned_stmt_count = () -> Int with { Error } {\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let sources = selfhost_cli_adapter_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  closure_pruned_stmt_count(adapter_source, adapter_path, sources, \"cli_main\")\n}\n\nexport let selfbuild_probe_cli_adapter_grouped_pruned_stmt_count = () -> Int with { Error } {\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let sources = selfhost_cli_adapter_sources()\n  let source_groups = selfhost_cli_adapter_source_groups()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  source_group_pruned_stmt_count(db_new(), adapter_source, adapter_path, source_groups, \"cli_main\")\n}\n\nexport let selfbuild_probe_compile_via_compiler_wrapper = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let main_source =\n    \"import ./entry/source_compile/index.vibe { compile_source_wasi }\\nlet run = () -> Int with { Error } { let _bytes = compile_source_wasi(\\\"let main = () -> Int { 42 }\\\", \\\"main\\\"); 0 }\"\n  let (bytes, _) = compile_with_modules_wasi_cached(\n    db_new(),\n    main_source,\n    \"vibe/compiler/probe_compile_wrapper.vibe\",\n    sources,\n    \"run\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_env_get_len = () -> Int with { Error } {\n  let bytes = compile_source_wasi(\n    \"let main = () -> Int with { Env } { let _x = Env::get(\\\"VIBE_INPUT\\\"); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_fs_read_file_len = () -> Int with { Error } {\n  let bytes = compile_source_wasi(\n    \"let main = () -> Int with { Fs } { let _x = Fs::read_file(\\\"/tmp/in.txt\\\"); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_fs_write_bytes_len = () -> Int with { Error } {\n  let bytes = compile_source_wasi(\n    \"let main = () -> Int with { Fs } { Fs::write_bytes(\\\"/tmp/out.wasm\\\", Bytes::from_array([1])); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\n// Debug probe: lex only\nexport let selfbuild_probe_lex = () -> Int with { Error } {\n  let tokens = lex(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  Array::length(tokens)\n}\n\n// Debug probe: parse only\nexport let selfbuild_probe_parse = () -> Int with { Error } {\n  let tokens = lex(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  let stmts = parse_program(tokens)\n  Array::length(stmts)\n}\n\n// Debug probe: check only\nexport let selfbuild_probe_check = () -> Int with { Error } {\n  let tokens = lex(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  1\n}\n\n// Debug probe: compile\nexport let selfbuild_probe_compile = () -> Int with { Error } {\n  let bytes = compile_source(\"let add = (a: Int, b: Int) -> Int { a + b }\")\n  Bytes::length(bytes)\n}\n\n// Debug probe: parse_count\nexport let selfbuild_probe_parse_count = () -> Int with { Error } {\n  let tokens = lex(\"let x = 42\")\n  let num_tokens = Array::length(tokens)\n  let stmts = parse_program(tokens)\n  let num_stmts = Array::length(stmts)\n  num_tokens * 1000 + num_stmts\n}\n\n// Debug probe: token tag\nexport let selfbuild_probe_token_tag = () -> Int with { Error } {\n  let tokens = lex(\"let x = 42\")\n  let first = Array::get(tokens, 0)\n  let tag = match first {\n    TLet => 1,\n    TEof => 2,\n    _ => 0\n  }\n  Array::length(tokens) * 100 + tag\n}\n\n// Debug probe: deep if-else chain\nexport let selfbuild_probe_deep_if = () -> Int with { Error } {\n  let c = 40\n  let result = if c == 43 { 1 }\n    else if c == 45 { 2 }\n    else if c == 42 { 3 }\n    else if c == 47 { 4 }\n    else if c == 37 { 5 }\n    else if c == 61 { 6 }\n    else if c == 33 { 7 }\n    else if c == 60 { 8 }\n    else if c == 62 { 9 }\n    else if c == 38 { 10 }\n    else if c == 124 { 11 }\n    else if c == 94 { 12 }\n    else if c == 40 { 13 }\n    else if c == 41 { 14 }\n    else if c == 123 { 15 }\n    else 0\n  result\n}\n\n// Debug probe: char code at position 10\nexport let selfbuild_probe_char_at = () -> Int with { Error } {\n  let s = \"let add = (a: Int, b: Int) -> Int { a + b }\"\n  String::char_code_at(s, 10)\n}\n\n// Debug probe: fn_count in merged stmts\nexport let selfbuild_probe_fn_count = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let merged = collect_merged_stmts(sources)\n  let mut count = 0\n  let mut i = 0\n  while i < Array::length(merged) {\n    let stmt = Array::get(merged, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => { count = count + 1 },\n          _ => ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  count\n}\n\n// Debug probe: selfhost_sources length\nexport let selfbuild_probe_sources_len = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  Array::length(sources)\n}\n\n// Debug probe: merged stmts length\nexport let selfbuild_probe_merged_len = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  let merged = collect_merged_stmts(sources)\n  Array::length(merged)\n}\n\nlet selfbuild_probe_compile_first = (n: Int) -> Int with { Error } {\n  let sources = selfhost_sources()\n  let first = Array::slice(sources, 0, n)\n  let merged = collect_merged_stmts(first)\n  let entry_tokens = lex(\"export let __probe_entry = () -> Int { 0 }\")\n  let entry_stmts = parse_program(entry_tokens)\n  let mut j = 0\n  while j < Array::length(entry_stmts) { Array::push(merged, Array::get(entry_stmts, j)); j = j + 1 }\n  let bytes = compile_wasi_module(merged, \"__probe_entry\")\n  Bytes::length(bytes)\n}\n\n// Binary search: compile first N source files\nexport let selfbuild_probe_compile_first_5 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(5)\n}\n\nexport let selfbuild_probe_compile_first_8 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(8)\n}\n\nexport let selfbuild_probe_compile_first_10 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(10)\n}\n\nexport let selfbuild_probe_compile_first_15 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(15)\n}\n\nexport let selfbuild_probe_compile_first_17 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(17)\n}\n\nexport let selfbuild_probe_compile_first_18 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(18)\n}\n\nexport let selfbuild_probe_compile_first_19 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(19)\n}\n\nexport let selfbuild_probe_compile_first_20 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(20)\n}\n\nexport let selfbuild_probe_compile_first_21 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(21)\n}\n\nexport let selfbuild_probe_compile_first_22 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(22)\n}\n\nexport let selfbuild_probe_compile_first_23 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(23)\n}\n\nexport let selfbuild_probe_compile_first_24 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(24)\n}\n\nexport let selfbuild_probe_compile_first_25 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(25)\n}\n\nexport let selfbuild_probe_compile_first_26 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(26)\n}\n\nexport let selfbuild_probe_compile_first_27 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(27)\n}\n\nexport let selfbuild_probe_compile_first_28 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(28)\n}\n\nexport let selfbuild_probe_compile_first_29 = () -> Int with { Error } {\n  selfbuild_probe_compile_first(29)\n}\n\n// Debug probe: warm TypeDb typecheck count1/count2 packed as count1*1000+count2\nexport let selfbuild_probe_type_db_cache_counts = () -> Int with { Error } {\n  let main_source = \"let main = () -> Int { 1 + 2 }\"\n  let db1 = db_set_source(db_new(), \"main.vibe\", main_source)\n  let db2 = db_typecheck(db1, \"main.vibe\")\n  let count1 = db_typecheck_count(db2)\n  let db3 = db_typecheck(db2, \"main.vibe\")\n  let count2 = db_typecheck_count(db3)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_parse_counts = () -> Int with { Error } {\n  let helper_source = \"export let add = (a: Int, b: Int) -> Int { a + b }\"\n  let main_source = \"import ./helpers.vibe { add }\\nlet main = () -> Int { add(1, 2) }\"\n  let sources = [(\"helpers.vibe\", helper_source)]\n  let db1 = prepare_modules_cached(db_new(), \"main.vibe\", main_source, sources)\n  let count1 = db_parse_count(db1)\n  let db2 = prepare_modules_cached(db1, \"main.vibe\", main_source, sources)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_fs_parse_counts = () -> Int with { Error, Fs } {\n  let helper_path = \"_build/persistent_type_env_probe_helper.vibe\"\n  let main_path = \"_build/persistent_type_env_probe_main.vibe\"\n  let helper_source = \"export let add = () -> Int { 1 }\"\n  let main_source = \"import ./persistent_type_env_probe_helper.vibe { add }\\nlet run = () -> Int { add() }\"\n  Fs::write_bytes(helper_path, string_to_bytes(helper_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([(\"\", \"\")], 0, 0))\n  let main_fp = build_type_db_fingerprint(main_source, [(helper_path, helper_fp)])\n  let helper_dep_cache = persistent_dep_list_cache_path(\n    helper_path,\n    compact_string_fingerprint(helper_source)\n  )\n  let main_dep_cache = persistent_dep_list_cache_path(\n    main_path,\n    compact_string_fingerprint(main_source)\n  )\n  remove_file_if_exists(helper_dep_cache)\n  remove_file_if_exists(main_dep_cache)\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main_fp))\n  let db1 = db_typecheck_fs(\n    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),\n    main_path\n  )\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(\n    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),\n    main_path\n  )\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_fs_multi_dep_parse_counts = () -> Int with { Error, Fs } {\n  let helper1_path = \"_build/persistent_type_env_multi_dep_helper1.vibe\"\n  let helper2_path = \"_build/persistent_type_env_multi_dep_helper2.vibe\"\n  let main_path = \"_build/persistent_type_env_multi_dep_main.vibe\"\n  let helper1_source = \"export let add1 = () -> Int { 1 }\"\n  let helper2_source = \"export let add2 = () -> Int { 2 }\"\n  let main_source = String::concat(\n    \"import ./persistent_type_env_multi_dep_helper1.vibe { add1 }\\n\",\n    String::concat(\n      \"import ./persistent_type_env_multi_dep_helper2.vibe { add2 }\\n\",\n      \"let run = () -> Int { add1() + add2() }\"\n    )\n  )\n  Fs::write_bytes(helper1_path, string_to_bytes(helper1_source))\n  Fs::write_bytes(helper2_path, string_to_bytes(helper2_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  let helper1_fp = build_type_db_fingerprint(helper1_source, Array::slice([(\"\", \"\")], 0, 0))\n  let helper2_fp = build_type_db_fingerprint(helper2_source, Array::slice([(\"\", \"\")], 0, 0))\n  let main_fp = build_type_db_fingerprint(\n    main_source,\n    [(helper1_path, helper1_fp), (helper2_path, helper2_fp)]\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(helper1_path, compact_string_fingerprint(helper1_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(helper2_path, compact_string_fingerprint(helper2_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main_path, compact_string_fingerprint(main_source))\n  )\n  remove_file_if_exists(persistent_type_env_cache_path(helper1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(helper2_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main_fp))\n  let db1 = db_typecheck_fs(\n    db_set_source(\n      db_set_source(\n        db_set_source(db_new(), helper1_path, helper1_source),\n        helper2_path,\n        helper2_source\n      ),\n      main_path,\n      main_source\n    ),\n    main_path\n  )\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(\n    db_set_source(\n      db_set_source(\n        db_set_source(db_new(), helper1_path, helper1_source),\n        helper2_path,\n        helper2_source\n      ),\n      main_path,\n      main_source\n    ),\n    main_path\n  )\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_merge_counts = () -> Int with { Error } {\n  let sources = [\n    (\"helpers.vibe\", \"export let add = (a: Int, b: Int) -> Int { a + b }\"),\n    (\"main.vibe\", \"import ./helpers.vibe { add }\\nlet main = () -> Int { add(1, 2) }\")\n  ]\n  let (_, _, db1) = db_merged_source(db_new(), \"main.vibe\", sources)\n  let count1 = db_merge_count(db1)\n  let (_, _, db2) = db_merged_source(db1, \"main.vibe\", sources)\n  let count2 = db_merge_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_group_merge_counts = () -> Int with { Error } {\n  let groups = [\n    (\"core\", [(\"helpers.vibe\", \"export let add = (a: Int, b: Int) -> Int { a + b }\")]),\n    (\"entry\", [(\"main.vibe\", \"import ./helpers.vibe { add }\\nlet main = () -> Int { add(1, 2) }\")])\n  ]\n  let (_, _, db1) = db_grouped_merged_source(db_new(), groups)\n  let count1 = db_merge_count(db1)\n  let (_, _, db2) = db_grouped_merged_source(db1, groups)\n  