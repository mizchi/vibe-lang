uld otherwise be misread —\\n  // a low word of 0 makes two unequal ints compare EQUAL, and a large low word\\n  // makes `str_eq`'s byte loop read out of bounds (the #664 class of bug, here\\n  // surfacing for `==`/`!=` on Int >= 2^32). Gate the fallback on both operands\\n  // looking like real strings; otherwise the values are simply not equal.\\n  emit_looks_like_string(b, 0)\\n  emit_looks_like_string(b, 1)\\n  bytebuf_push(b, 113)\\n  emit_if_i64(b)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_call(b, str_eq_idx)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  b\\n}\\n\")\n}\n\nlet cli_adapter_source_84 = () -> (String, String) {\n  (\"vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_str_eq.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_ea