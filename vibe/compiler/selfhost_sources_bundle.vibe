rams(CtString, CtInt, CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_substring(name) {\\n    Some(t) => Some(t),\\n    None => lookup_string_char_at(name)\\n  }\\n}\\n\\nexport let lookup_string1: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_group_a(name) {\\n    Some(t) => Some(t),\\n    None => lookup_string_group_b(name)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_34 = () -> (String, String) {\n  (\"vibe/compiler/checker/builtins_string2.vibe\",\n\"//# Imports\\n\\nimport .. / core / types.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nlet string2_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet string2_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = string2_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet string2_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = string2_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet lookup_string_trim: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::trim\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_split: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::split\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtArray(CtString), None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_contains: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::contains\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_index_of: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::index_of\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_to_lower: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::to_lower\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_to_upper: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::to_upper\\\" {\\n    Some(CtFn(string2_one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_c: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_trim(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_to_upper(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_to_lower(name)\\n    }\\n  }\\n}\\n\\nlet lookup_string_ends_with: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::ends_with\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_starts_with: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::starts_with\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string2_group_a: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_index_of(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_contains(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_starts_with(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_ends_with(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_string_char_code_at: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::char_code_at\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtInt), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_last_index_of: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::last_index_of\\\" {\\n    Some(CtFn(string2_two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_from_char_code: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::from_char_code\\\" {\\n    Some(CtFn(string2_one_param(CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string2_group_b: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_from_char_code(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_char_code_at(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_last_index_of(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_split(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_string2: (String) -> Option[Type] = (name) -> {\\n  match lookup_string2_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string2_group_b(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_group_c(name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_35 = () -> (String, String) {\n  (\"vibe/compiler/checker/builtins_builders.vibe\",\n\"//# Imports\\n\\nimport .. / core / types.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nlet builders_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet builders_one_param: (Type) -> Array[Type] = (a) -> {\\n  let arr = builders_no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet builders_two_params: (Type, Type) -> Array[Type] = (a, b) -> {\\n  let arr = builders_no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet lookup_array_builder_new: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"ArrayBuilder::new\\\" {\\n    Some(CtFn(builders_no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_array_builder_push: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"ArrayBuilder::push\\\" {\\n    Some(CtFn(builders_two_params(CtUnknown, CtUnknown), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_builder_new: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"StringBuilder::new\\\" {\\n    Some(CtFn(builders_no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_builder_push: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"StringBuilder::push\\\" {\\n    Some(CtFn(builders_two_params(CtUnknown, CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_array_builder_freeze: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"ArrayBuilder::freeze\\\" {\\n    Some(CtFn(builders_one_param(CtUnknown), CtArray(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nexport let lookup_array_builder: (String) -> Option[Type] = (name) -> {\\n  match lookup_array_builder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_array_builder_push(name) {\\n      Some(t) => Some(t),\\n      None => lookup_array_builder_freeze(name)\\n    }\\n  }\\n}\\n\\nlet lookup_string_builder_freeze: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"StringBuilder::freeze\\\" {\\n    Some(CtFn(builders_one_param(CtUnknown), CtString, None))\\n  }\\n  else None\\n}\\n\\nexport let lookup_string_builder: (String) -> Option[Type] = (name) -> {\\n  match lookup_string_builder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_builder_push(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_builder_freeze(name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_36 = () -> (String, String) {\n  (\"vibe/compiler/checker/builtins_async.vibe\",\n\"//# Imports\\n\\nimport .. / core / types.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\n// WASI 0.3 async front-end (M1a/M2/M-conc). See docs/spec/wasi-p3-async.md,\\n// ADR-0012.\\n//\\n// These are type-level / front-end only (no codegen yet): `Future[T]`,\\n// `Stream[T]`, `Task[T]` are represented structurally as CtNamed(name, _) so no\\n// core `Type` enum change is needed, and element/result types use CtUnknown\\n// (gradual), consistent with the rest of the builtin table. Operations that\\n// suspend or touch the async runtime carry the open-string `Async` effect, so\\n// the existing effect-escape check (checker_effects.vibe) requires them to be\\n// used inside `with { Async }` (or a handle body) — exactly like `throw`/`Error`.\\n\\nlet async_no_params: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\n// Future[T] + await (M1a).\\nlet lookup_future: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"await\\\" {\\n    // await: (Future[T]) -> T with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Future\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnknown, Some(\\\"Async\\\")))\\n  } else if name == \\\"Future::ready\\\" {\\n    // Future::ready: (T) -> Future[T]   (pure; an already-resolved future)\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtNamed(\\\"Future\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else {\\n    None\\n  }\\n}\\n\\n// Stream[T] — a pull-based async iterator (WASI 0.3 stream<T>), the async\\n// sibling of Iterator (ADR-0044): the same combinator shape (map/filter/fold)\\n// as the sync Iterator, but `next` yields a Future and `fold` is Async.\\nlet lookup_stream: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Stream::empty\\\" {\\n    // Stream::empty: () -> Stream[T]   (pure)\\n    Some(CtFn(async_no_params(), CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::once\\\" {\\n    // Stream::once: (T) -> Stream[T]   (pure; single-element stream)\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::next\\\" {\\n    // Stream::next: (Stream[T]) -> Future[Option[T]] with { Async }\\n    // None terminates the stream.\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ])\\n    ], CtNamed(\\\"Future\\\", [\\n      CtOption(CtUnknown)\\n    ]), Some(\\\"Async\\\")))\\n  } else if name == \\\"Stream::map\\\" {\\n    // Stream::map: (Stream[T], (T) -> U) -> Stream[U]   (lazy)\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ]),\\n      CtUnknown\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::filter\\\" {\\n    // Stream::filter: (Stream[T], (T) -> Bool) -> Stream[T]   (lazy)\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ]),\\n      CtUnknown\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtUnknown\\n    ]), None))\\n  } else if name == \\\"Stream::fold\\\" {\\n    // Stream::fold: (Stream[T], A, (A, T) -> A) -> Future[A] with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtUnknown\\n      ]),\\n      CtUnknown,\\n      CtUnknown\\n    ], CtNamed(\\\"Future\\\", [\\n      CtUnknown\\n    ]), Some(\\\"Async\\\")))\\n  } else {\\n    None\\n  }\\n}\\n\\n// Task[T] — structured concurrency + cancellation (WASI 0.3 task / waitable-set\\n// / future.cancel-*). spawn creates a child task bound to the enclosing async\\n// scope; join awaits it; cancel requests cancellation; race/timeout combine.\\nlet lookup_concurrency: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Task::spawn\\\" {\\n    // Task::spawn: (() -> T with { Async }) -> Task[T] with { Async }\\n    Some(CtFn([\\n      CtUnknown\\n    ], CtNamed(\\\"Task\\\", [\\n      CtUnknown\\n    ]), Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::join\\\" {\\n    // Task::join: (Task[T]) -> T with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnknown, Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::cancel\\\" {\\n    // Task::cancel: (Task[T]) -> Unit with { Async }\\n    Some(CtFn([\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnit, Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::race\\\" {\\n    // Task::race: (Task[T], Task[T]) -> T with { Async }  (loser is cancelled)\\n    Some(CtFn([\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ]),\\n      CtNamed(\\\"Task\\\", [\\n        CtUnknown\\n      ])\\n    ], CtUnknown, Some(\\\"Async\\\")))\\n  } else if name == \\\"Task::timeout\\\" {\\n    // Task::timeout: (Int, () -> T with { Async }) -> Option[T] with { Async }\\n    // None on deadline (the inner task is cancelled).\\n    Some(CtFn([\\n      CtInt,\\n      CtUnknown\\n    ], CtOption(CtUnknown), Some(\\\"Async\\\")))\\n  } else {\\n    None\\n  }\\n}\\n\\n// ByteStream = Stream[Int] — WASI 0.3 stream<u8> / HTTP body bridge (M2c).\\n// `String::to_bytes` exposes a String's bytes as a ByteStream so request/response\\n// bodies can be consumed with the Stream combinators (map/filter/fold/next). It\\n// is pure & eager on the linear backend (the bytes are already in memory).\\nlet lookup_bytestream: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"String::to_bytes\\\" {\\n    // String::to_bytes: (String) -> Stream[Int]   (ByteStream)\\n    Some(CtFn([\\n      CtString\\n    ], CtNamed(\\\"Stream\\\", [\\n      CtInt\\n    ]), None))\\n  } else if name == \\\"Stream::to_string\\\" {\\n    // Stream::to_string: (Stream[Int]) -> String   (ByteStream -> String;\\n    // collect a byte stream into a response body)\\n    Some(CtFn([\\n      CtNamed(\\\"Stream\\\", [\\n        CtInt\\n      ])\\n    ], CtString, None))\\n  } else {\\n    None\\n  }\\n}\\n\\nexport let lookup_async: (String) -> Option[Type] = (name) -> {\\n  match lookup_future(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_stream(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_concurrency(name) {\\n        Some(t) => Some(t),\\n        None => lookup_bytestream(name)\\n      }\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_37 = () -> (String, String) {\n  (\"vibe/compiler/checker/checker_resolve.vibe\",\n\"//# Imports\\n\\nimport .. / core / ast.vibe {\\n  TypeExpr\\n}\\n\\nimport .. / core / types.vibe {\\n  Type, TypeDef, find_typedef, resolve_builtin\\n}\\n\\n//# Functions\\n\\n// Substitute a parameterized type alias's formal params with actual type args.\\n// The alias body was resolved with its params as free `CtNamed(<param>, _)`\\n// names; replace each by the corresponding actual argument (recursively).\\nexport let rec subst_type_params: (Type, Array[String], Array[Type]) -> Type = (ty, params, args) -> {\\n  match ty {\\n    CtNamed(name, targs) => {\\n      let mut idx = 0 - 1\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        if Array::get(params, i) == name {\\n          idx = i\\n        }\\n        i = i + 1\\n      }\\n      if idx >= 0 && idx < Array::length(args) {\\n        Array::get(args, idx)\\n      } else {\\n        CtNamed(name, for a in targs {\\n          subst_type_params(a, params, args)\\n        })\\n      }\\n    },\\n    CtArray(e) => CtArray(subst_type_params(e, params, args)),\\n    CtOption(e) => CtOption(subst_type_params(e, params, args)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      subst_type_params(e, params, args)\\n    }),\\n    CtFn(ps, ret, eff) => {\\n      let subst_params: (Array[Type]) -> Array[Type] = (types) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(types) {\\n          Array::push(out, subst_type_params(Array::get(types, i), params, args))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(subst_params(ps), subst_type_params(ret, params, args), eff)\\n    },\\n    _ => ty\\n  }\\n}\\n\\nexport let rec resolve_type_expr: (TypeExpr, Array[TypeDef]) -> Type = (te, defs) -> {\\n  match te {\\n    TyUnit => CtUnit,\\n    TyName(name) => match resolve_builtin(name) {\\n      Some(t) => t,\\n      None => match find_typedef(defs, name) {\\n        Some(td) => match td {\\n          TDEnum(n, _, _) => CtEnum(n),\\n          TDStruct(n, _, _) => CtStruct(n),\\n          TDAlias(_, _, t) => t\\n        },\\n        None => CtNamed(name, Array::slice([\\n          CtUnknown\\n        ], 0, 0))\\n      }\\n    },\\n    TyApp(name, args) => {\\n      let ra = for a in args {\\n        resolve_type_expr(a, defs)\\n      }\\n      if name == \\\"Array\\\" {\\n        if Array::length(ra) == 1 {\\n          CtArray(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else if name == \\\"Option\\\" {\\n        if Array::length(ra) == 1 {\\n          CtOption(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else {\\n        // Expand a parameterized type alias `Foo[A] = Body` applied as `Foo[X]`\\n        // by substituting its formal params; otherwise it stays nominal.\\n        match find_typedef(defs, name) {\\n          Some(td) => match td {\\n            TDAlias(_, params, body) => subst_type_params(body, params, ra),\\n            _ => CtNamed(name, ra)\\n          },\\n          None => CtNamed(name, ra)\\n        }\\n      }\\n    },\\n    TyTuple(elems) => {\\n      let r = for e in elems {\\n        resolve_type_expr(e, defs)\\n      }\\n      CtTuple(r)\\n    },\\n    TyFn(params, ret, effect_name) => {\\n      let ret_box = Array::slice([\\n        ret\\n      ], 0, 1)\\n      let rp = for p in params {\\n        resolve_type_expr(p, defs)\\n      }\\n      CtFn(rp, resolve_type_expr(Array::get(ret_box, 0), defs), effect_name)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_38 = () -> (String, String) {\n  (\"vibe/compiler/checker/checker_pattern.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\\n}\\n\\nimport ./checker_resolve.vibe {\\n  subst_type_params\\n}\\n\\n//# Functions\\n\\nlet find_ctor_in_defs: (Array[TypeDef], String) -> Option[(String, Array[Type])] = (defs, ctor_name) -> {\\n  let dlen = Array::length(defs)\\n  let rec go_defs: (Int) -> Option[(String, Array[Type])] = (di) -> {\\n    if di >= dlen {\\n      None\\n    } else {\\n      let d = Array::get(defs, di)\\n      match d {\\n        TDEnum(enum_name, _, variants) => {\\n          let vlen = Array::length(variants)\\n          let rec go_variants: (Int) -> Option[(String, Array[Type])] = (vi) -> {\\n            if vi >= vlen {\\n              go_defs(di + 1)\\n            } else {\\n              let (vname, vtypes) = Array::get(variants, vi)\\n              if vname == ctor_name {\\n                Some((enum_name, vtypes))\\n              } else {\\n                go_variants(vi + 1)\\n              }\\n            }\\n          }\\n          go_variants(0)\\n        },\\n        _ => go_defs(di + 1)\\n      }\\n    }\\n  }\\n  go_defs(0)\\n}\\n\\nexport let rec check_pattern: (Pat, Type, TypeEnv, Array[TypeDef], Array[String]) -> TypeEnv = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef], errors: Array[String]) -> TypeEnv {\\n  match pat {\\n    PWild => env,\\n    PBind(name) => env_bind(env, name, scrutinee_ty),\\n    // A literal pattern can only match a scrutinee of its own type. When the\\n    // scrutinee resolves to a concrete type that is NOT that literal's type\\n    // (`match 5 { \\\"x\\\" => .. }`, or a nested `Some(true)` over `Option[Int]`),\\n    // it is a type error. Type variables / unknown / named (generic) scrutinees\\n    // are tolerated.\\n    PInt(_) => {\\n      match scrutinee_ty {\\n        CtInt => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"integer literal pattern cannot match a non-Int scrutinee\\\")\\n      }\\n      env\\n    },\\n    PString(_) => {\\n      match scrutinee_ty {\\n        CtString => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"string literal pattern cannot match a non-String scrutinee\\\")\\n      }\\n      env\\n    },\\n    PBool(_) => {\\n      match scrutinee_ty {\\n        CtBool => (),\\n        CtVar(_) => (),\\n        CtUnknown => (),\\n        CtNamed(_, _) => (),\\n        _ => Array::push(errors, \\\"boolean literal pattern cannot match a non-Bool scrutinee\\\")\\n      }\\n      env\\n    },\\n    PCtor(name, sub_pats) => {\\n      let builtin_payload = match scrutinee_ty {\\n        CtOption(elem) => if name == \\\"Some\\\" {\\n          Some([\\n            elem\\n          ])\\n        } else if name == \\\"None\\\" {\\n          Some(Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        } else {\\n          None\\n        },\\n        _ => None\\n      }\\n      let ctor_payload = match builtin_payload {\\n        Some(types) => Some((\\\"Option\\\", types)),\\n        None => find_ctor_in_defs(defs, name)\\n      }\\n      match ctor_payload {\\n        Some(info) => {\\n          let (enum_name, raw_payload) = info\\n          // Instantiate the variant's field types for a parameterized enum:\\n          // substitute the enum's formal params with the scrutinee's actual type\\n          // args (e.g. matching `Ok(inner)` on `Result[Result[T,E], E]` types\\n          // `inner` as `Result[T,E]`, not the bare enum param).\\n          let payload_types = match scrutinee_ty {\\n            CtNamed(_, sargs) => match find_typedef(defs, enum_name) {\\n              Some(td) => match td {\\n                TDEnum(_, eparams, _) => if Array::length(eparams) > 0 && Array::length(sargs) > 0 {\\n                  for pt in raw_payload {\\n                    subst_type_params(pt, eparams, sargs)\\n                  }\\n                } else {\\n                  raw_payload\\n                },\\n                _ => raw_payload\\n              },\\n              None => raw_payload\\n            },\\n            _ => raw_payload\\n          }\\n          let splen = Array::length(sub_pats)\\n          let ptlen = Array::length(payload_types)\\n          // A constructor pattern can only match a value whose type is the\\n          // corresponding enum (or builtin Option). A concrete NON-enum type —\\n          // a scalar (`match 5 { Red => .. }`), a function (`match N { N(a) =>\\n          // .. }` where the bare ctor `N` is the `(Int) -> E` partial\\n          // application), an Array or a Tuple — can never be that enum.\\n          // Type vars / unknown / named / enum / option scrutinees are tolerated.\\n          let non_enum_scrutinee = match scrutinee_ty {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtBytes => true,\\n            CtFn(_, _, _) => true,\\n            CtArray(_) => true,\\n            CtTuple(_) => true,\\n            _ => false\\n          }\\n          if non_enum_scrutinee {\\n            Array::push(errors, String::concat(\\\"constructor pattern `\\\", String::concat(name, String::concat(\\\"` (of \\\", String::concat(enum_name, \\\") cannot match this scrutinee type\\\")))))\\n          } else {\\n            ()\\n          }\\n          // The pattern must bind exactly the variant's payload arity —\\n          // `Pair(a)` for `Pair(Int, Int)` binds a garbage/oob 2nd field, and\\n          // binding MORE than exists is likewise wrong. Skip the builtin\\n          // `Option` (its `None` carries a synthetic 1-element payload).\\n          if enum_name != \\\"Option\\\" && splen != ptlen {\\n            Array::push(errors, String::concat(\\\"constructor pattern `\\\", String::concat(name, String::concat(\\\"` expects \\\", String::concat(__to_string(ptlen), String::concat(\\\" field(s) but binds \\\", __to_string(splen)))))))\\n          } else {\\n            ()\\n          }\\n          let rec bind_subs: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let sub_ty = if i < ptlen {\\n                Array::get(payload_types, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs, errors)\\n              bind_subs(i + 1, next_env)\\n            }\\n          }\\n          bind_subs(0, env)\\n        },\\n        None => {\\n          let splen = Array::length(sub_pats)\\n          let rec bind_unknown: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs, errors)\\n              bind_unknown(i + 1, next_env)\\n            }\\n          }\\n          bind_unknown(0, env)\\n        }\\n      }\\n    },\\n    PTuple(pats) => {\\n      let plen = Array::length(pats)\\n      match scrutinee_ty {\\n        CtTuple(elem_tys) => {\\n          let elen = Array::length(elem_tys)\\n          // A tuple pattern must bind exactly the scrutinee tuple's arity —\\n          // `let (a, b, c) = (1, 2)` was accepted and would read past the\\n          // tuple (binding `c` to garbage). Tuples have a fixed, fully known\\n          // arity, so this is always a real error.\\n          if plen != elen {\\n            Array::push(errors, String::concat(\\\"tuple pattern binds \\\", String::concat(__to_string(plen), String::concat(\\\" elements but the value is a \\\", String::concat(__to_string(elen), \\\"-tuple\\\")))))\\n          } else {\\n            ()\\n          }\\n          let rec bind_tuple: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let et = if i < elen {\\n                Array::get(elem_tys, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs, errors)\\n              bind_tuple(i + 1, next_env)\\n            }\\n          }\\n          bind_tuple(0, env)\\n        },\\n        _ => {\\n          // A tuple pattern can only match a tuple value. `let (a, b) = 5`\\n          // (desugared to `match 5 { (a, b) => .. }`) was accepted and bound\\n          // `a`/`b` to garbage. When the scrutinee resolves to a concrete\\n          // NON-tuple type (a scalar, array, option, fn, struct, enum), this is\\n          // a real error. Type vars / unknown / named (generic) scrutinees stay\\n          // tolerated.\\n          let concrete_non_tuple = match scrutinee_ty {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtBytes => true,\\n            CtArray(_) => true,\\n            CtOption(_) => true,\\n            CtFn(_, _, _) => true,\\n            CtStruct(_) => true,\\n            CtEnum(_) => true,\\n            _ => false\\n          }\\n          if concrete_non_tuple {\\n            Array::push(errors, String::concat(\\\"tuple pattern binds \\\", String::concat(__to_string(plen), \\\" elements but the value is not a tuple\\\")))\\n          } else {\\n            ()\\n          }\\n          let rec bind_unk: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs, errors)\\n              bind_unk(i + 1, next_env)\\n            }\\n          }\\n          bind_unk(0, env)\\n        }\\n      }\\n    },\\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs, errors),\\n    PStruct(_, fields) => {\\n      let flen = Array::length(fields)\\n      let rec bind_fields: (Int, TypeEnv) -> TypeEnv = (i, acc_env) -> {\\n        if i >= flen {\\n          acc_env\\n        } else {\\n          let (_, fpat) = Array::get(fields, i)\\n          let next_env = check_pattern(fpat, CtUnknown, acc_env, defs, errors)\\n          bind_fields(i + 1, next_env)\\n        }\\n      }\\n      bind_fields(0, env)\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_39 = () -> (String, String) {\n  (\"vibe/compiler/checker_trait.vibe\",\n\"//# Imports\\n\\nimport ./types.vibe {\\n  Subst, Type, TypeEnv, impls_overlap_for, trait_defined, type_implements_trait\\n}\\n\\nimport ./ast.vibe {\\n  TypeExpr\\n}\\n\\n//# Functions\\n\\nlet one_super: (String) -> Array[String] = (name) -> {\\n  [\\n    name\\n  ]\\n}\\n\\nlet no_trait_methods: () -> Array[(String, Array[TypeExpr], TypeExpr)] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nlet no_type_args: () -> Array[Type] = () -> {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet empty_strings: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nexport let satisfies_bound: (TypeEnv, Subst, Type, String) -> Bool = (env, s, ty, bound) -> {\\n  type_implements_trait(env, s, ty, bound)\\n}\\n\\nexport let check_bounds_satisfied: (TypeEnv, Subst, Type, Array[String]) -> Array[String] = (env, s, ty, bounds) -> {\\n  let result = empty_strings()\\n  let len = Array::length(bounds)\\n  let rec go: (Int) -> Int = (i) -> {\\n    if i >= len {\\n      0\\n    } else {\\n      let bound = Array::get(bounds, i)\\n      if not(satisfies_bound(env, s, ty, bound)) {\\n        Array::push(result, bound)\\n      }\\n      go(i + 1)\\n    }\\n  }\\n  let _ = go(0)\\n  result\\n}\\n\\nexport let register_builtin_traits: (TypeEnv) -> TypeEnv = (env) -> {\\n  let no_supers = empty_strings()\\n  let eq_supers = one_super(\\\"Eq\\\")\\n  let i64_type = CtNamed(\\\"i64\\\", no_type_args())\\n  let u8_type = CtNamed(\\\"u8\\\", no_type_args())\\n  let u16_type = CtNamed(\\\"u16\\\", no_type_args())\\n  let u32_type = CtNamed(\\\"u32\\\", no_type_args())\\n  let u64_type = CtNamed(\\\"u64\\\", no_type_args())\\n  let i16_type = CtNamed(\\\"i16\\\", no_type_args())\\n  let nm = no_trait_methods()\\n  let e1 = EnvTraitDef(\\\"Eq\\\", no_supers, false, nm, env)\\n  let e2 = EnvTraitDef(\\\"Ord\\\", eq_supers, false, nm, e1)\\n  let e3 = EnvTraitDef(\\\"Add\\\", no_supers, false, nm, e2)\\n  let e4 = EnvTraitDef(\\\"Sub\\\", no_supers, false, nm, e3)\\n  let e5 = EnvTraitDef(\\\"Mul\\\", no_supers, false, nm, e4)\\n  let e6 = EnvTraitDef(\\\"Div\\\", no_supers, false, nm, e5)\\n  let e7 = EnvTraitImpl(\\\"Eq\\\", CtInt, e6)\\n  let e8 = EnvTraitImpl(\\\"Eq\\\", CtDouble, e7)\\n  let e9 = EnvTraitImpl(\\\"Eq\\\", CtString, e8)\\n  let e10 = EnvTraitImpl(\\\"Eq\\\", CtBool, e9)\\n  let e11 = EnvTraitImpl(\\\"Ord\\\", CtInt, e10)\\n  let e12 = EnvTraitImpl(\\\"Ord\\\", CtDouble, e11)\\n  let e13 = EnvTraitImpl(\\\"Ord\\\", CtString, e12)\\n  let e14 = EnvTraitImpl(\\\"Add\\\", CtInt, e13)\\n  let e15 = EnvTraitImpl(\\\"Add\\\", CtDouble, e14)\\n  let e16 = EnvTraitImpl(\\\"Sub\\\", CtInt, e15)\\n  let e17 = EnvTraitImpl(\\\"Sub\\\", CtDouble, e16)\\n  let e18 = EnvTraitImpl(\\\"Mul\\\", CtInt, e17)\\n  let e19 = EnvTraitImpl(\\\"Mul\\\", CtDouble, e18)\\n  let e20 = EnvTraitImpl(\\\"Div\\\", CtInt, e19)\\n  let e21 = EnvTraitImpl(\\\"Div\\\", CtDouble, e20)\\n  let e22 = EnvTraitImpl(\\\"Eq\\\", i64_type, e21)\\n  let e23 = EnvTraitImpl(\\\"Eq\\\", u8_type, e22)\\n  let e24 = EnvTraitImpl(\\\"Eq\\\", u16_type, e23)\\n  let e25 = EnvTraitImpl(\\\"Eq\\\", u32_type, e24)\\n  let e26 = EnvTraitImpl(\\\"Eq\\\", u64_type, e25)\\n  let e27 = EnvTraitImpl(\\\"Eq\\\", i16_type, e26)\\n  let e28 = EnvTraitImpl(\\\"Ord\\\", i64_type, e27)\\n  let e29 = EnvTraitImpl(\\\"Ord\\\", u8_type, e28)\\n  let e30 = EnvTraitImpl(\\\"Ord\\\", u16_type, e29)\\n  let e31 = EnvTraitImpl(\\\"Ord\\\", u32_type, e30)\\n  let e32 = EnvTraitImpl(\\\"Ord\\\", u64_type, e31)\\n  let e33 = EnvTraitImpl(\\\"Ord\\\", i16_type, e32)\\n  let e34 = EnvTraitImpl(\\\"Add\\\", i64_type, e33)\\n  let e35 = EnvTraitImpl(\\\"Add\\\", u8_type, e34)\\n  let e36 = EnvTraitImpl(\\\"Add\\\", u16_type, e35)\\n  let e37 = EnvTraitImpl(\\\"Add\\\", u32_type, e36)\\n  let e38 = EnvTraitImpl(\\\"Add\\\", u64_type, e37)\\n  let e39 = EnvTraitImpl(\\\"Add\\\", i16_type, e38)\\n  let e40 = EnvTraitImpl(\\\"Sub\\\", i64_type, e39)\\n  let e41 = EnvTraitImpl(\\\"Sub\\\", u8_type, e40)\\n  let e42 = EnvTraitImpl(\\\"Sub\\\", u16_type, e41)\\n  let e43 = EnvTraitImpl(\\\"Sub\\\", u32_type, e42)\\n  let e44 = EnvTraitImpl(\\\"Sub\\\", u64_type, e43)\\n  let e45 = EnvTraitImpl(\\\"Sub\\\", i16_type, e44)\\n  let e46 = EnvTraitImpl(\\\"Mul\\\", i64_type, e45)\\n  let e47 = EnvTraitImpl(\\\"Mul\\\", u8_type, e46)\\n  let e48 = EnvTraitImpl(\\\"Mul\\\", u16_type, e47)\\n  let e49 = EnvTraitImpl(\\\"Mul\\\", u32_type, e48)\\n  let e50 = EnvTraitImpl(\\\"Mul\\\", u64_type, e49)\\n  let e51 = EnvTraitImpl(\\\"Mul\\\", i16_type, e50)\\n  let e52 = EnvTraitImpl(\\\"Div\\\", i64_type, e51)\\n  let e53 = EnvTraitImpl(\\\"Div\\\", u8_type, e52)\\n  let e54 = EnvTraitImpl(\\\"Div\\\", u16_type, e53)\\n  let e55 = EnvTraitImpl(\\\"Div\\\", u32_type, e54)\\n  let e56 = EnvTraitImpl(\\\"Div\\\", u64_type, e55)\\n  let e57 = EnvTraitImpl(\\\"Div\\\", i16_type, e56)\\n  e57\\n}\\n\\nexport let validate_supers_defined: (TypeEnv, Array[String]) -> Array[String] = (env, supers) -> {\\n  let result = empty_strings()\\n  let len = Array::length(supers)\\n  let rec go: (Int) -> Int = (i) -> {\\n    if i >= len {\\n      0\\n    } else {\\n      let name = Array::get(supers, i)\\n      if not(trait_defined(env, name)) {\\n        Array::push(result, name)\\n      }\\n      go(i + 1)\\n    }\\n  }\\n  let _ = go(0)\\n  result\\n}\\n\\nexport let validate_impl_no_overlap: (TypeEnv, String, Type) -> Bool = (env, trait_name, target) -> {\\n  not(impls_overlap_for(env, trait_name, target))\\n}\\n\")\n}\n\nlet cli_adapter_source_40 = () -> (String, String) {\n  (\"vibe/compiler/checker_effects.vibe\",\n\"//# Imports\\n\\nimport ./ast.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\nimport ./builtins.vibe {\\n  lookup_builtin\\n}\\n\\nimport ./types.vibe {\\n  Type, TypeEnv, env_lookup\\n}\\n\\n//# Types\\n\\nexport enum EffectError {\\n  EEThrowOutsideEffect(String);\\n  EEEffectfulCallOutsideEffect(String);\\n  EEPerformUndeclaredEffect(String, String);\\n  EEAssignImmutable(String)\\n}\\n\\n//# Functions\\n\\nlet is_effectful_type: (Type) -> Bool = (ty) -> {\\n  match ty {\\n    CtFn(_, _, Some(_)) => true,\\n    _ => false\\n  }\\n}\\n\\nlet is_effectful_name: (String, TypeEnv) -> Bool = (name, env) -> {\\n  match env_lookup(env, name) {\\n    Some(ty) => is_effectful_type(ty),\\n    None => {\\n      let normalized = canonical_builtin_name(name)\\n      match lookup_builtin(normalized) {\\n        Some(ty) => is_effectful_type(ty),\\n        None => false\\n      }\\n    }\\n  }\\n}\\n\\nexport let rec check_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_effect) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    EThrow(_) => {\\n      if !in_effect {\\n        Array::push(errors, EEThrowOutsideEffect(\\\"throw\\\"))\\n      }\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      let body_errs = check_effects_expr(body, env, true)\\n      let mut i = 0\\n      while i < Array::length(body_errs) {\\n        Array::push(errors, Array::get(body_errs, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        let arm_errs = check_effects_expr(arm_body, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(arm_errs) {\\n          Array::push(errors, Array::get(arm_errs, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(name, _) => if !in_effect && is_effectful_name(name, env) {\\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\\n        }\\n        ,\\n        _ => ()\\n      }\\n      let ce = check_effects_expr(callee, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        let ae = check_effects_expr(Array::get(args, ai), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ae) {\\n          Array::push(errors, Array::get(ae, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, _, _, effect, body) => {\\n      let fn_in_effect = match effect {\\n        Some(_) => true,\\n        None => false\\n      }\\n      let body_errs = check_effects_expr(body, env, fn_in_effect)\\n      let mut i = 0\\n      while i < Array::length(body_errs) {\\n        Array::push(errors, Array::get(body_errs, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELetMut(_, val, body) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      let ae = check_effects_expr(a, env, in_effect)\\n      let be = check_effects_expr(b, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ae) {\\n        Array::push(errors, Array::get(ae, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      let ce = check_effects_expr(cond, env, in_effect)\\n      let te = check_effects_expr(then_e, env, in_effect)\\n      let ee = check_effects_expr(else_e, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(te) {\\n        Array::push(errors, Array::get(te, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ee) {\\n        Array::push(errors, Array::get(ee, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let se = check_effects_expr(scrutinee, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(se) {\\n        Array::push(errors, Array::get(se, i))\\n        i = i + 1\\n      }\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        let ae = check_effects_expr(arm_body, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ae) {\\n          Array::push(errors, Array::get(ae, j))\\n          j = j + 1\\n        }\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      let ce = check_effects_expr(cond, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        let pe = check_effects_expr(init, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(pe) {\\n          Array::push(errors, Array::get(pe, j))\\n          j = j + 1\\n        }\\n        i = i + 1\\n      }\\n      let be = check_effects_expr(body, env, in_effect)\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EForIn(_, _, iter, body) => {\\n      let ie = check_effects_expr(iter, env, in_effect)\\n      let be = check_effects_expr(body, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ie) {\\n        Array::push(errors, Array::get(ie, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(be) {\\n        Array::push(errors, Array::get(be, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      let le = check_effects_expr(left, env, in_effect)\\n      let re = check_effects_expr(right, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(le) {\\n        Array::push(errors, Array::get(le, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(re) {\\n        Array::push(errors, Array::get(re, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EReturn(e) => check_effects_expr(e, env, in_effect),\\n    EUnaryOp(_, operand) => check_effects_expr(operand, env, in_effect),\\n    EAssign(_, val, cont) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let ce = check_effects_expr(cont, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EAssignOp(_, _, val, cont) => {\\n      let ve = check_effects_expr(val, env, in_effect)\\n      let ce = check_effects_expr(cont, env, in_effect)\\n      let mut i = 0\\n      while i < Array::length(ve) {\\n        Array::push(errors, Array::get(ve, i))\\n        i = i + 1\\n      }\\n      i = 0\\n      while i < Array::length(ce) {\\n        Array::push(errors, Array::get(ce, i))\\n        i = i + 1\\n      }\\n      errors\\n    },\\n    EDot(obj, _, _) => check_effects_expr(obj, env, in_effect),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ee) {\\n          Array::push(errors, Array::get(ee, j))\\n          j = j + 1\\n        }\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        let ee = check_effects_expr(Array::get(elems, ei), env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(ee) {\\n          Array::push(errors, Array::get(ee, j))\\n          j = j + 1\\n        }\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(fields) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        let fe = check_effects_expr(fval, env, in_effect)\\n        let mut j = 0\\n        while j < Array::length(fe) {\\n          Array::push(errors, Array::get(fe, j))\\n          j = j + 1\\n        }\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\nexport let check_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {\\n  match stmt {\\n    SLet(_, _, _, _, body) => check_effects_expr(body, env, false),\\n    SLetMut(_, _, body) => check_effects_expr(body, env, false),\\n    STest(_, body) => check_effects_expr(body, env, false),\\n    SBench(_, body) => check_effects_expr(body, env, false),\\n    SExpr(e) => check_effects_expr(e, env, false),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport let check_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let se = check_effects_stmt(Array::get(stmts, i), env)\\n    let mut j = 0\\n    while j < Array::length(se) {\\n      Array::push(errors, Array::get(se, j))\\n      j = j + 1\\n    }\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\nexport let effect_error_to_string: (EffectError) -> String = (err) -> {\\n  match err {\\n    EEThrowOutsideEffect(msg) => String::concat(\\\"throw outside effectful context: \\\", msg),\\n    EEEffectfulCallOutsideEffect(name) => String::concat(\\\"effectful call outside effectful context: \\\", name),\\n    EEPerformUndeclaredEffect(op, eff) => String::concat(\\\"use of undeclared effect `\\\", String::concat(eff, String::concat(\\\"` (\\\", String::concat(op, \\\"); add it to the function's `with { ... }` or wrap in a `handle`\\\")))),\\n    EEAssignImmutable(name) => String::concat(\\\"cannot assign to immutable binding `\\\", String::concat(name, \\\"` (declare it with `let mut`)\\\"))\\n  }\\n}\\n\\n//# Async-scoped effect enforcement (the pass wired into `check_program`)\\n//\\n// The general `check_effects_expr` above treats every effect identically and is\\n// far too strict to enable across the un-annotated selfhost source (441 `throw`\\n// sites alone would fail). This pass enforces ONLY the `Async` effect, and only\\n// for async PRIMITIVES — the builtins `await(..)` / `sleep(..)` / `Stream::next`\\n// whose type carries `with { Async }`, including the `await(..)` the `for await`\\n// desugar injects over a Future-returning iterator. A primitive must appear\\n// inside a function/lambda annotated `with { Async }`.\\n//\\n// Crucially it does NOT propagate to user functions that merely COMPOSE async\\n// work: calling a `with { Async }` helper (e.g. `async_iter_collect`) from a\\n// sync context is allowed (await is the identity on the synchronous backend,\\n// and on a real async backend the value/Future mismatch is a separate type\\n// error). Only env-absent BUILTIN primitives are checked, so the compiler /\\n// prelude — which use `Async` only in the disciplined async_iter terminals —\\n// stay green while `for await` over an async stream becomes sound (#2+#3).\\n\\nlet effect_opt_is_async: (Option[String]) -> Bool = (eff) -> {\\n  match eff {\\n    Some(s) => String::contains(s, \\\"Async\\\"),\\n    None => false\\n  }\\n}\\n\\n// True only for async-effect BUILTIN primitives (await/sleep/Stream::next/...).\\n// A name bound in `env` (a user/prelude function) is intentionally NOT treated\\n// as a primitive even if its type is `with { Async }`.\\nlet is_async_primitive: (String, TypeEnv) -> Bool = (name, env) -> {\\n  match env_lookup(env, name) {\\n    Some(_) => false,\\n    None => {\\n      let normalized = canonical_builtin_name(name)\\n      match lookup_builtin(normalized) {\\n        Some(ty) => match ty {\\n          CtFn(_, _, eff) => effect_opt_is_async(eff),\\n          _ => false\\n        },\\n        None => false\\n      }\\n    }\\n  }\\n}\\n\\nlet append_eff_errs: (Array[EffectError], Array[EffectError]) -> Unit = (dst, src) -> {\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::push(dst, Array::get(src, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport let rec check_async_effects_expr: (Expr, TypeEnv, Bool) -> Array[EffectError] = (expr, env, in_async) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(name, _) => if !in_async && is_async_primitive(name, env) {\\n          Array::push(errors, EEEffectfulCallOutsideEffect(name))\\n        }\\n        ,\\n        _ => ()\\n      }\\n      append_eff_errs(errors, check_async_effects_expr(callee, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(args, ai), env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, _, _, effect, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(body, env, effect_opt_is_async(effect)))\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELetMut(_, val, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      append_eff_errs(errors, check_async_effects_expr(a, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(b, env, in_async))\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(then_e, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(else_e, env, in_async))\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      append_eff_errs(errors, check_async_effects_expr(scrutinee, env, in_async))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_async_effects_expr(arm_body, env, in_async))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(cond, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        append_eff_errs(errors, check_async_effects_expr(init, env, in_async))\\n        i = i + 1\\n      }\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    EForIn(_, _, iter, body) => {\\n      append_eff_errs(errors, check_async_effects_expr(iter, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(body, env, in_async))\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      append_eff_errs(errors, check_async_effects_expr(left, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(right, env, in_async))\\n      errors\\n    },\\n    EReturn(e) => check_async_effects_expr(e, env, in_async),\\n    EUnaryOp(_, operand) => check_async_effects_expr(operand, env, in_async),\\n    EThrow(e) => check_async_effects_expr(e, env, in_async),\\n    EAssign(_, val, cont) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\\n      errors\\n    },\\n    EAssignOp(_, _, val, cont) => {\\n      append_eff_errs(errors, check_async_effects_expr(val, env, in_async))\\n      append_eff_errs(errors, check_async_effects_expr(cont, env, in_async))\\n      errors\\n    },\\n    EDot(obj, _, _) => check_async_effects_expr(obj, env, in_async),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_async_effects_expr(Array::get(elems, ei), env, in_async))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(fields) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        append_eff_errs(errors, check_async_effects_expr(fval, env, in_async))\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\n// A function body runs in an `{Async}` context if EITHER the lambda's inline\\n// effect OR the binding's declared signature type carries `Async`.\\nlet sig_type_is_async: (Option[TypeExpr]) -> Bool = (topt) -> {\\n  match topt {\\n    Some(TyFn(_, _, eff)) => effect_opt_is_async(eff),\\n    _ => false\\n  }\\n}\\n\\nlet check_async_effects_binding: (Option[TypeExpr], Expr, TypeEnv) -> Array[EffectError] = (ty, body, env) -> {\\n  let sig_async = sig_type_is_async(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, fbody) => check_async_effects_expr(fbody, env, sig_async || effect_opt_is_async(eff)),\\n    _ => check_async_effects_expr(body, env, sig_async)\\n  }\\n}\\n\\nexport let check_async_effects_stmt: (Stmt, TypeEnv) -> Array[EffectError] = (stmt, env) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, body) => check_async_effects_binding(ty, body, env),\\n    SLetMut(_, ty, body) => check_async_effects_binding(ty, body, env),\\n    STest(_, body) => check_async_effects_expr(body, env, false),\\n    SBench(_, body) => check_async_effects_expr(body, env, false),\\n    SExpr(e) => check_async_effects_expr(e, env, false),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\nexport let check_async_effects_stmts: (Array[Stmt], TypeEnv) -> Array[EffectError] = (stmts, env) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    append_eff_errs(errors, check_async_effects_stmt(Array::get(stmts, i), env))\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\n//# perform-discipline enforcement (#626 criterion 1)\\n//\\n// `perform EffName::Op(..)` may only occur where `EffName` is in scope: either\\n// the enclosing function/lambda declares it in `with { ... }`, or the perform\\n// is inside a `handle` (which discharges it). Otherwise it is a type error —\\n// \\\"performing an undeclared effect\\\". This realizes the first acceptance\\n// criterion of #626 (the checker formerly accepted undeclared performs because\\n// it never resolved which effect an op belongs to).\\n//\\n// A `handle` is treated CONSERVATIVELY as discharging any effect for its body\\n// (we do not yet read which specific effect its arms handle), so a perform\\n// inside any handle is allowed — this never rejects a valid program; it only\\n// declines to flag the (rarer) perform-of-a-different-effect-inside-a-handle\\n// case, which full row tracking (#626 criteria 2/4) will cover.\\n\\n// Split a `with { A, B }` annotation into trimmed, deduped effect labels.\\nlet effect_decl_labels: (Option[String]) -> Array[String] = (eff) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match eff {\\n    None => out,\\n    Some(s) => {\\n      let raw = String::split(s, \\\",\\\")\\n      let mut i = 0\\n      while i < Array::length(raw) {\\n        let label = String::trim(Array::get(raw, i))\\n        if String::length(label) > 0 {\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == label {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, label)\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n  }\\n}\\n\\n// A single lowercase letter is an effect VARIABLE (polymorphic row tail in the\\n// current representation): a function declaring `with { e }` may perform any\\n// effect, so treat such a declaration as authorizing everything.\\nlet label_is_effect_var: (String) -> Bool = (name) -> {\\n  String::length(name) == 1 && String::char_code_at(name, 0) >= 97 && String::char_code_at(name, 0) <= 122\\n}\\n\\nlet decl_authorizes_effect: (Array[String], String) -> Bool = (labels, eff_name) -> {\\n  let mut i = 0\\n  let mut ok = false\\n  while i < Array::length(labels) {\\n    let l = Array::get(labels, i)\\n    if l == eff_name {\\n      ok = true\\n    } else if label_is_effect_var(l) {\\n      ok = true\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\n// `perform EffName::Op` — the op identifier is `EffName::Op`; the effect is the\\n// segment before `::`.\\nlet effect_name_of_op: (String) -> String = (op_name) -> {\\n  let idx = String::index_of(op_name, \\\"::\\\")\\n  if idx > 0 {\\n    op_name[0:idx]\\n  } else {\\n    op_name\\n  }\\n}\\n\\n// #626 criterion 3 (call-site propagation, builtin slice): calling an effectful\\n// BUILTIN (e.g. `Fs::read_file`, `Env::args_len`) requires the enclosing\\n// function to declare that effect, exactly like `perform`. Returns the required\\n// effect, or None for pure builtins / non-builtins. `Error` (the 441-site throw\\n// discipline) and `Async` (composition-allowed; handled by the async pass) are\\n// deliberately excluded from this slice.\\nlet builtin_call_effect: (String) -> Option[String] = (name) -> {\\n  // Fast path: every effectful builtin in this slice is a QUALIFIED name\\n  // (`Fs::read_file`, `Env::args_len`, `Stdin::...`, `Stdout::...`, ...), so a\\n  // callee with no `::` can never be one. Skipping `lookup_builtin` for the\\n  // (vastly more common) unqualified calls keeps the pass cheap enough to run\\n  // over the whole compiler source within the seed's heap during self-build.\\n  if String::index_of(name, \\\"::\\\") < 0 {\\n    None\\n  } else {\\n    let normalized = canonical_builtin_name(name)\\n    match lookup_builtin(normalized) {\\n      Some(ty) => match ty {\\n        CtFn(_, _, Some(eff)) => if eff == \\\"Error\\\" {\\n          None\\n        } else if eff == \\\"Async\\\" {\\n          None\\n        } else {\\n          Some(eff)\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\nlet labels_union: (Array[String], Array[String]) -> Array[String] = (a, b) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(a) {\\n    Array::push(out, Array::get(a, i))\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(b) {\\n    let l = Array::get(b, j)\\n    let mut seen = false\\n    let mut k = 0\\n    while k < Array::length(out) {\\n      if Array::get(out, k) == l {\\n        seen = true\\n      }\\n      k = k + 1\\n    }\\n    if !seen {\\n      Array::push(out, l)\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\n// #626 criterion 2: a `handle ... with E` DISCHARGES E for its body — after\\n// handling E the body need not declare it. The parser qualifies each handler\\n// arm pattern as `E::Op`, so the discharged effect names are recoverable as the\\n// `::`-prefixes of the arm constructor patterns. Returns the distinct effects a\\n// handle discharges (empty if none could be determined — then the body stays\\n// conservatively permissive, never over-strict).\\nlet collect_handle_effects: (Array[(Pat, Expr)]) -> Array[String] = (arms) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (pat, _) = Array::get(arms, i)\\n    match pat {\\n      PCtor(name, _) => {\\n        let idx = String::index_of(name, \\\"::\\\")\\n        if idx > 0 {\\n          let eff = name[0:idx]\\n          let mut seen = false\\n          let mut j = 0\\n          while j < Array::length(out) {\\n            if Array::get(out, j) == eff {\\n              seen = true\\n            }\\n            j = j + 1\\n          }\\n          if !seen {\\n            Array::push(out, eff)\\n          }\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Walk an expression's effect discipline with an EXPLICIT WORK STACK instead of\\n// recursion, so the pass never exhausts the wasm call stack however deeply the\\n// compiler's own source nests (long `let`/`seq` spines AND nested\\n// if/match/call forms). Each stack item carries its (expr, declared, in_handle)\\n// context: `EFn` resets `declared` to its own effect row, `EHandle` augments it\\n// with the discharged effects (criterion 2). Order of traversal differs from a\\n// recursive pre-order walk, but the SET of effect errors found is identical, so\\n// the accept/reject decision is unchanged.\\n// The declared effect row of a top-level binding: the signature's `with { ... }`\\n// unioned with an EFn body's own effect annotation (`let f = (x) -> { .. } with\\n// { E }`). Used to build the call-graph effect map for transitive enforcement.\\nlet fn_binding_effects: (Option[TypeExpr], Expr) -> Array[String] = (ty, body) -> {\\n  let sig = sig_type_effect_labels(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, _) => labels_union(sig, effect_decl_labels(eff)),\\n    _ => sig\\n  }\\n}\\n\\n// Look up a called function's declared effect row by linear scan over PARALLEL\\n// arrays (names[i] <-> effs[i]). A `Map` here allocates per lookup and, across\\n// the compiler's tens of thousands of call sites, exhausts the GC-less bump heap\\n// (#626 OOM); the linear scan allocates nothing.\\nlet lookup_fn_effs: (Array[String], Array[Array[String]], String) -> Option[Array[String]] = (names, effs, name) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(names) {\\n    match found {\\n      None => if Array::get(names, i) == name {\\n        found = Some(Array::get(effs, i))\\n      } else {\\n        ()\\n      },\\n      Some(_) => ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\n// Transitive effect enforcement (#626): a call to a user function `G` that\\n// declares `with { E }` leaks E into the caller unless the caller declares E or\\n// the call is under a `handle ... with E`. Combined with the DIRECT discipline\\n// (every function that itself performs/invokes an effectful builtin must declare\\n// it — already enforced), this propagates effect requirements up the call graph\\n// level by level: every effectful leaf is annotated, so a one-level check at\\n// each call site is complete. `fn_names`/`fn_effs` is the call-graph map (empty\\n// => transitive check disabled, preserving the direct-only behavior).\\nexport let check_perform_effects_expr_tx: (Expr, Array[String], Bool, Array[String], Array[Array[String]]) -> Array[EffectError] = (root, root_declared, root_in_handle, fn_names, fn_effs) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let stack = Array::slice([\\n    (root, root_declared, root_in_handle)\\n  ], 0, 1)\\n  while Array::length(stack) > 0 {\\n    let n = Array::length(stack)\\n    let (expr, declared, in_handle) = Array::get(stack, n - 1)\\n    Array::truncate(stack, n - 1)\\n    match expr {\\n      ECall(callee, args, _) => {\\n        match callee {\\n          EIdent(name, _) => {\\n            if name == \\\"perform\\\" && Array::length(args) == 1 {\\n              match Array::get(args, 0) {\\n                ECall(op_callee, _, _) => match op_callee {\\n                  EIdent(op_name, _) => {\\n                    let eff = effect_name_of_op(op_name)\\n                    if !in_handle && !decl_authorizes_effect(declared, eff) {\\n                      Array::push(errors, EEPerformUndeclaredEffect(op_name, eff))\\n                    } else {\\n                      ()\\n                    }\\n                  },\\n                  _ => ()\\n                },\\n                _ => ()\\n              }\\n            } else {\\n              match builtin_call_effect(name) {\\n                Some(eff) => if !in_handle && !decl_authorizes_effect(declared, eff) {\\n                  Array::push(errors, EEPerformUndeclaredEffect(name, eff))\\n                } else {\\n                  ()\\n                },\\n                None => ()\\n              }\\n            }\\n            // Transitive (#626): calling a user function leaks its declared\\n            // effects into this context unless declared here or under a handle.\\n            // Scope = concrete RESOURCE effects (Fs/Env/Stdin/Stdout/...): the\\n            // DIRECT discipline already excludes `Error` (the throw row is\\n            // pervasive — nearly every function can throw) and `Async`\\n            // (composition is allowed; the async pass governs it), so the\\n            // transitive pass mirrors that exclusion. Effect-variable rows\\n            // (polymorphic) impose nothing.\\n            match lookup_fn_effs(fn_names, fn_effs, name) {\\n              Some(callee_effs) => {\\n                let mut ti = 0\\n                while ti < Array::length(callee_effs) {\\n                  let teff = Array::get(callee_effs, ti)\\n                  if String::length(teff) > 0 && teff != \\\"Error\\\" && teff != \\\"Async\\\" && !label_is_effect_var(teff) && !in_handle && !decl_authorizes_effect(declared, teff) {\\n                    Array::push(errors, EEPerformUndeclaredEffect(name, teff))\\n                  } else {\\n                    ()\\n                  }\\n                  ti = ti + 1\\n                }\\n              },\\n              None => ()\\n            }\\n          },\\n          _ => ()\\n        }\\n        Array::push(stack, (callee, declared, in_handle))\\n        let mut ai = 0\\n        while ai < Array::length(args) {\\n          Array::push(stack, (Array::get(args, ai), declared, in_handle))\\n          ai = ai + 1\\n        }\\n      },\\n      EFn(_, _, _, _, effect, body) => {\\n        Array::push(stack, (body, effect_decl_labels(effect), false))\\n      },\\n      EHandle(body, arms) => {\\n        let discharged = collect_handle_effects(arms)\\n        let body_declared = labels_union(declared, discharged)\\n        let body_in_handle = if Array::length(discharged) == 0 {\\n          true\\n        } else {\\n          in_handle\\n        }\\n        Array::push(stack, (body, body_declared, body_in_handle))\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, ai)\\n          Array::push(stack, (arm_body, declared, in_handle))\\n          ai = ai + 1\\n        }\\n      },\\n      ELet(_, val, body) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ELetRec(_, val, body) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ELetMut(_, val, body) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ESeq(a, b) => {\\n        Array::push(stack, (a, declared, in_handle))\\n        Array::push(stack, (b, declared, in_handle))\\n      },\\n      EIf(cond, then_e, else_e) => {\\n        Array::push(stack, (cond, declared, in_handle))\\n        Array::push(stack, (then_e, declared, in_handle))\\n        Array::push(stack, (else_e, declared, in_handle))\\n      },\\n      EMatch(scrutinee, arms) => {\\n        Array::push(stack, (scrutinee, declared, in_handle))\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, ai)\\n          Array::push(stack, (arm_body, declared, in_handle))\\n          ai = ai + 1\\n        }\\n      },\\n      EWhile(cond, body) => {\\n        Array::push(stack, (cond, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      ELoop(params, body) => {\\n        let mut i = 0\\n        while i < Array::length(params) {\\n          let (_, init) = Array::get(params, i)\\n          Array::push(stack, (init, declared, in_handle))\\n          i = i + 1\\n        }\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      EForIn(_, _, iter, body) => {\\n        Array::push(stack, (iter, declared, in_handle))\\n        Array::push(stack, (body, declared, in_handle))\\n      },\\n      EBinOp(_, left, right) => {\\n        Array::push(stack, (left, declared, in_handle))\\n        Array::push(stack, (right, declared, in_handle))\\n      },\\n      EReturn(e) => Array::push(stack, (e, declared, in_handle)),\\n      EUnaryOp(_, operand) => Array::push(stack, (operand, declared, in_handle)),\\n      EThrow(e) => Array::push(stack, (e, declared, in_handle)),\\n      EAssign(_, val, cont) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (cont, declared, in_handle))\\n      },\\n      EAssignOp(_, _, val, cont) => {\\n        Array::push(stack, (val, declared, in_handle))\\n        Array::push(stack, (cont, declared, in_handle))\\n      },\\n      EDot(obj, _, _) => Array::push(stack, (obj, declared, in_handle)),\\n      ETuple(elems) => {\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle))\\n          ei = ei + 1\\n        }\\n      },\\n      EArray(elems) => {\\n        let mut ei = 0\\n        while ei < Array::length(elems) {\\n          Array::push(stack, (Array::get(elems, ei), declared, in_handle))\\n          ei = ei + 1\\n        }\\n      },\\n      ERecord(fields) => {\\n        let mut fi = 0\\n        while fi < Array::length(fields) {\\n          let (_, fval) = Array::get(fields, fi)\\n          Array::push(stack, (fval, declared, in_handle))\\n          fi = fi + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n  }\\n  errors\\n}\\n\\nlet sig_type_effect_labels: (Option[TypeExpr]) -> Array[String] = (topt) -> {\\n  match topt {\\n    Some(TyFn(_, _, eff)) => effect_decl_labels(eff),\\n    _ => effect_decl_labels(None)\\n  }\\n}\\n\\n// Public 3-arg entry: the direct-only check (no call-graph map), preserving the\\n// pre-transitive behavior for unit tests and any non-stmts caller.\\nexport let check_perform_effects_expr: (Expr, Array[String], Bool) -> Array[EffectError] = (root, root_declared, root_in_handle) -> {\\n  check_perform_effects_expr_tx(root, root_declared, root_in_handle, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0))\\n}\\n\\nlet check_perform_effects_binding_tx: (Option[TypeExpr], Expr, Array[String], Array[Array[String]]) -> Array[EffectError] = (ty, body, fn_names, fn_effs) -> {\\n  let sig_labels = sig_type_effect_labels(ty)\\n  match body {\\n    EFn(_, _, _, _, eff, fbody) => check_perform_effects_expr_tx(fbody, labels_union(sig_labels, effect_decl_labels(eff)), false, fn_names, fn_effs),\\n    _ => check_perform_effects_expr_tx(body, sig_labels, false, fn_names, fn_effs)\\n  }\\n}\\n\\nlet check_perform_effects_stmt_tx: (Stmt, Array[String], Array[Array[String]]) -> Array[EffectError] = (stmt, fn_names, fn_effs) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, body) => check_perform_effects_binding_tx(ty, body, fn_names, fn_effs),\\n    SLetMut(_, ty, body) => check_perform_effects_binding_tx(ty, body, fn_names, fn_effs),\\n    STest(_, body) => check_perform_effects_expr_tx(body, effect_decl_labels(None), false, fn_names, fn_effs),\\n    SBench(_, body) => check_perform_effects_expr_tx(body, effect_decl_labels(None), false, fn_names, fn_effs),\\n    SExpr(e) => check_perform_effects_expr_tx(e, effect_decl_labels(None), false, fn_names, fn_effs),\\n    _ => Array::slice([\\n      EEThrowOutsideEffect(\\\"\\\")\\n    ], 0, 0)\\n  }\\n}\\n\\n// Public 1-arg entry: direct-only (empty map). Kept for unit tests.\\nexport let check_perform_effects_stmt: (Stmt) -> Array[EffectError] = (stmt) -> {\\n  check_perform_effects_stmt_tx(stmt, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0))\\n}\\n\\nexport let check_perform_effects_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {\\n  // Build the call-graph effect map (parallel arrays) from every top-level\\n  // binding's declared row, then run the per-stmt check WITH transitive\\n  // enforcement so a caller must declare (or handle) the effects of the\\n  // functions it invokes.\\n  let fn_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SLet(_, _, name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      SLetMut(name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      _ => ()\\n    }\\n    m = m + 1\\n  }\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    append_eff_errs(errors, check_perform_effects_stmt_tx(Array::get(stmts, i), fn_names, fn_effs))\\n    i = i + 1\\n  }\\n  errors\\n}\\n\\n// #634 (ADR-0026): pure-test result cache verdict. A `test {}` block's result\\n// is safe to cache/skip only when running it depends on nothing external — no\\n// I/O, no non-determinism — so it is a deterministic function of source + deps +\\n// compiler version. file_tests_cacheable is true iff the file has at least one\\n// `test {}` block and EVERY test block is transitively effect-free.\\n//\\n// Reuses the transitive effect walk: a test body checked with an EMPTY declared\\n// row reports an error for ANY effect it reaches that a `handle` does not\\n// discharge — Fs/Http/Env/custom effects and `perform`, propagated through the\\n// call-graph effect map (fn_names/fn_effs). `Error` (assert/throw) and `Async`\\n// are excluded by that pass, so they stay cacheable; a `handle` that fully\\n// discharges its effects (e.g. a fixed-seed Rng handler) also stays cacheable.\\n// Zero errors => cacheable.\\n//\\n// Known limitation (documented like ADR-0026 EC-7): an effect the type system\\n// does not surface here is invisible — notably a DIRECT `sh`/`sh_lines` call in\\n// a test body (they carry `Process` but are unqualified, so the builtin effect\\n// lookup's qualified-name fast-path skips them). `sh` reached THROUGH a user\\n// function IS caught (the function declares `with { Process }`, which lands in\\n// fn_effs). Conservative otherwise: it never marks an impure test cacheable\\n// except this narrow direct-shell case.\\nexport let file_tests_cacheable: (Array[Stmt]) -> Bool = (stmts) -> {\\n  let fn_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let fn_effs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SLet(_, _, name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      SLetMut(name, ty, body) => {\\n        Array::push(fn_names, name)\\n        Array::push(fn_effs, fn_binding_effects(ty, body))\\n      },\\n      _ => ()\\n    }\\n    m = m + 1\\n  }\\n  let empty_decl = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut any_test = false\\n  let mut all_ok = true\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      STest(_, body) => {\\n        any_test = true\\n        let errs = check_perform_effects_expr_tx(body, empty_decl, false, fn_names, fn_effs)\\n        if Array::length(errs) != 0 {\\n          all_ok = false\\n        } else {\\n          ()\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  any_test && all_ok\\n}\\n\\n//# Mutability discipline: reassignment requires a `let mut` binding.\\n//\\n// `let x = ...` is immutable (docs/cheatsheet.md); only `let mut x` may be\\n// reassigned. The checker previously accepted `let x = 1; x = 2`. This pass\\n// walks expressions carrying the SET of names that are reassignable in scope\\n// and reports an `x = e` / `x op= e` whose target is not in that set.\\n//\\n// The set only ever GROWS down a scope (never shrinks), so the pass can only\\n// produce false NEGATIVES, never false positives: every form that introduces a\\n// reassignable or freshly-rebindable name — `let mut`, function parameters,\\n// loop accumulators, `for` variables, and pattern binds — is added, so the\\n// only thing flagged is reassignment of a plain immutable `let`. Nested\\n// functions INHERIT the outer set (a closure may mutate a captured `let mut`).\\n\\nlet mut_has: (Array[String], String) -> Bool = (xs, n) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(xs) {\\n    if Array::get(xs, i) == n {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet mut_with: (Array[String], String) -> Array[String] = (base, name) -> {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  Array::push(out, name)\\n  out\\n}\\n\\nlet rec collect_pat_binds_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {\\n  match pat {\\n    PBind(name) => Array::push(acc, name),\\n    PCtor(_, subs) => {\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        collect_pat_binds_into(Array::get(subs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    PTuple(subs) => {\\n      let mut i = 0\\n      while i < Array::length(subs) {\\n        collect_pat_binds_into(Array::get(subs, i), acc)\\n        i = i + 1\\n      }\\n    },\\n    POr(l, r) => {\\n      collect_pat_binds_into(l, acc)\\n      collect_pat_binds_into(r, acc)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        collect_pat_binds_into(fp, acc)\\n        i = i + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\n\\nlet mut_with_pat: (Array[String], Pat) -> Array[String] = (base, pat) -> {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  collect_pat_binds_into(pat, out)\\n  out\\n}\\n\\nlet mut_with_params: (Array[String], Array[(String, Option[TypeExpr])]) -> Array[String] = (base, params) -> {\\n  let out = Array::slice(base, 0, Array::length(base))\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (pname, _) = Array::get(params, i)\\n    Array::push(out, pname)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let rec check_mutability_expr: (Expr, Array[String]) -> Array[EffectError] = (expr, mutable) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  match expr {\\n    ECall(callee, args, _) => {\\n      append_eff_errs(errors, check_mutability_expr(callee, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(args) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(args, ai), mutable))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      append_eff_errs(errors, check_mutability_expr(body, mut_with_params(mutable, params)))\\n      errors\\n    },\\n    EHandle(body, arms) => {\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    ELet(_, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELetRec(_, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELetMut(name, val, body) => {\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mut_with(mutable, name)))\\n      errors\\n    },\\n    ESeq(a, b) => {\\n      append_eff_errs(errors, check_mutability_expr(a, mutable))\\n      append_eff_errs(errors, check_mutability_expr(b, mutable))\\n      errors\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\\n      append_eff_errs(errors, check_mutability_expr(then_e, mutable))\\n      append_eff_errs(errors, check_mutability_expr(else_e, mutable))\\n      errors\\n    },\\n    EMatch(scrutinee, arms) => {\\n      append_eff_errs(errors, check_mutability_expr(scrutinee, mutable))\\n      let mut ai = 0\\n      while ai < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, ai)\\n        append_eff_errs(errors, check_mutability_expr(arm_body, mut_with_pat(mutable, pat)))\\n        ai = ai + 1\\n      }\\n      errors\\n    },\\n    EWhile(cond, body) => {\\n      append_eff_errs(errors, check_mutability_expr(cond, mutable))\\n      append_eff_errs(errors, check_mutability_expr(body, mutable))\\n      errors\\n    },\\n    ELoop(params, body) => {\\n      let loopmut = Array::slice(mutable, 0, Array::length(mutable))\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, init) = Array::get(params, i)\\n        append_eff_errs(errors, check_mutability_expr(init, mutable))\\n        Array::push(loopmut, pname)\\n        i = i + 1\\n      }\\n      append_eff_errs(errors, check_mutability_expr(body, loopmut))\\n      errors\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      append_eff_errs(errors, check_mutability_expr(iter, mutable))\\n      let base = mut_with(mutable, name)\\n      let formut = match index_name {\\n        Some(idx) => mut_with(base, idx),\\n        None => base\\n      }\\n      append_eff_errs(errors, check_mutability_expr(body, formut))\\n      errors\\n    },\\n    EBinOp(_, left, right) => {\\n      append_eff_errs(errors, check_mutability_expr(left, mutable))\\n      append_eff_errs(errors, check_mutability_expr(right, mutable))\\n      errors\\n    },\\n    EReturn(e) => check_mutability_expr(e, mutable),\\n    EUnaryOp(_, operand) => check_mutability_expr(operand, mutable),\\n    EThrow(e) => check_mutability_expr(e, mutable),\\n    EAssign(name, val, cont) => {\\n      if !mut_has(mutable, name) {\\n        Array::push(errors, EEAssignImmutable(name))\\n      } else {\\n        ()\\n      }\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\\n      errors\\n    },\\n    EAssignOp(name, _, val, cont) => {\\n      if !mut_has(mutable, name) {\\n        Array::push(errors, EEAssignImmutable(name))\\n      } else {\\n        ()\\n      }\\n      append_eff_errs(errors, check_mutability_expr(val, mutable))\\n      append_eff_errs(errors, check_mutability_expr(cont, mutable))\\n      errors\\n    },\\n    EDot(obj, _, _) => check_mutability_expr(obj, mutable),\\n    ETuple(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    EArray(elems) => {\\n      let mut ei = 0\\n      while ei < Array::length(elems) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(elems, ei), mutable))\\n        ei = ei + 1\\n      }\\n      errors\\n    },\\n    ERecord(fields) => {\\n      let mut fi = 0\\n      while fi < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, fi)\\n        append_eff_errs(errors, check_mutability_expr(fval, mutable))\\n        fi = fi + 1\\n      }\\n      errors\\n    },\\n    // #629 step 3-2: forms previously dropped to `_ => errors`, so an illegal\\n    // reassignment (`x = e` where x is an immutable `let`) sitting inside a map\\n    // literal, labeled argument, spread, break value, or continue argument went\\n    // unflagged. Recurse with the SAME mutable set (these forms introduce no new\\n    // bindings), keeping the pass sound: still no false positives, just fewer\\n    // false negatives.\\n    EMap(entries) => {\\n      let mut mi = 0\\n      while mi < Array::length(entries) {\\n        let (_, mval) = Array::get(entries, mi)\\n        append_eff_errs(errors, check_mutability_expr(mval, mutable))\\n        mi = mi + 1\\n      }\\n      errors\\n    },\\n    ELabeledArg(_, _, inner) => check_mutability_expr(inner, mutable),\\n    ESpread(inner) => check_mutability_expr(inner, mutable),\\n    EBreak(opt) => match opt {\\n      Some(e) => check_mutability_expr(e, mutable),\\n      None => errors\\n    },\\n    EContinue(cargs) => {\\n      let mut ci = 0\\n      while ci < Array::length(cargs) {\\n        append_eff_errs(errors, check_mutability_expr(Array::get(cargs, ci), mutable))\\n        ci = ci + 1\\n      }\\n      errors\\n    },\\n    _ => errors\\n  }\\n}\\n\\nlet check_mutability_binding: (Expr) -> Array[EffectError] = (body) -> {\\n  match body {\\n    EFn(_, _, params, _, _, fbody) => check_mutability_expr(fbody, mut_with_params(Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), params)),\\n    _ => check_mutability_expr(body, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  }\\n}\\n\\nexport let check_mutability_stmts: (Array[Stmt]) -> Array[EffectError] = (stmts) -> {\\n  let errors = Array::slice([\\n    EEThrowOutsideEffect(\\\"\\\")\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, body) => append_eff_errs(errors, check_mutability_binding(body)),\\n      SLetMut(_, _, body) => append_eff_errs(errors, check_mutability_binding(body)),\\n      STest(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      SBench(_, body) => append_eff_errs(errors, check_mutability_expr(body, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      SExpr(e) => append_eff_errs(errors, check_mutability_expr(e, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  errors\\n}\\n\")\n}\n\nlet cli_adapter_source_41 = () -> (String, String) {\n  (\"vibe/compiler/checker/checker.vibe\",\n\"//# Imports\\n\\nimport .. / core / ast.vibe {\\n  Expr\\n}\\n\\nimport .. / core / types.vibe {\\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, subst_bounds_for, trait_method_sig_deep, type_implements_trait, type_name_has_iterator_impl, type_to_string, unify\\n}\\n\\nimport ./builtins.vibe {\\n  lookup_builtin\\n}\\n\\nimport ./checker_pattern.vibe {\\n  check_pattern\\n}\\n\\nimport ./checker_resolve.vibe {\\n  resolve_type_expr\\n}\\n\\n//# Functions\\n\\nlet min_int: (Int, Int) -> Int = (a, b) -> {\\n  if a < b {\\n    a\\n  } else {\\n    b\\n  }\\n}\\n\\n// Encode a real AST char offset into a strippable diagnostic marker so the\\n// located-diagnostics layer (typecheck_fs.vibe::locate_type_error) can decode\\n// the exact line:col instead of falling back to a first-occurrence text scan.\\n// String::concat only (never `+` / interpolation — both mis-codegen to NUL in\\n// selfhost). off < 0 => no marker (heuristic fallback retained).\\nlet off_marker: (Int) -> String = (off) -> {\\n  if off >= 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), \\\"]\\\"))\\n  } else {\\n    \\\"\\\"\\n  }\\n}\\n\\n// Like off_marker but also encodes the offending token's END offset as\\n// `[@off=N:M]` (M = off + len), so the located-diagnostics layer can emit an\\n// EXACT source range (line:colC-E) instead of the LSP guessing the token end\\n// with a word-scan — which mis-handles qualified names like `Mod.foo` (the scan\\n// stops at the dot). Falls back to the start-only marker when len <= 0. Use this\\n// where `off` is the START of a known-length named token (the symbol whose\\n// length matches the source span); keep plain off_marker where the offset is an\\n// anchor rather than the token start (e.g. a field error whose offset is the\\n// base expr). String::concat only (NUL-miscodegen hazard for `+`/interpolation).\\nlet off_marker_len: (Int, Int) -> String = (off, len) -> {\\n  if off >= 0 && len > 0 {\\n    String::concat(\\\" [@off=\\\", String::concat(__to_string(off), String::concat(\\\":\\\", String::concat(__to_string(off + len), \\\"]\\\"))))\\n  } else {\\n    off_marker(off)\\n  }\\n}\\n\\nlet prepend_expr: (Expr, Array[Expr]) -> Array[Expr] = (first, rest) -> {\\n  let out = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  Array::push(out, first)\\n  let mut i = 0\\n  while i < Array::length(rest) {\\n    Array::push(out, Array::get(rest, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// Replace the abstract `Self` type (resolved as `CtNamed(\\\"Self\\\", _)`) inside a\\n// trait-method signature with the concrete receiver type, when typing a\\n// `T::method` call against a bounded generic parameter T.\\nlet rec subst_self_in_type: (Type, Type) -> Type = (ty, self_ty) -> {\\n  match ty {\\n    CtNamed(n, args) => if n == \\\"Self\\\" {\\n      self_ty\\n    } else {\\n      let ra = for a in args {\\n        subst_self_in_type(a, self_ty)\\n      }\\n      CtNamed(n, ra)\\n    },\\n    CtArray(e) => CtArray(subst_self_in_type(e, self_ty)),\\n    CtOption(e) => CtOption(subst_self_in_type(e, self_ty)),\\n    CtTuple(elems) => CtTuple(for e in elems {\\n      subst_self_in_type(e, self_ty)\\n    }),\\n    CtFn(ps, ret, eff) => CtFn(for p in ps {\\n      subst_self_in_type(p, self_ty)\\n    }, subst_self_in_type(ret, self_ty), eff),\\n    _ => ty\\n  }\\n}\\n\\n// Relax a trait type parameter (e.g. the `T` in `Iterator[T] { next(Self) ->\\n// Option[T] }`) to `CtUnknown` so it unifies at the call site. A name that\\n// resolves to a real type (primitive or declared) is kept; only truly-unknown\\n// named types — the trait's own element type params, which the uniform\\n// representation erases — are relaxed. (#636.)\\nlet rec relax_unknown_named: (Type, Array[TypeDef]) -> Type = (ty, defs) -> {\\n  match ty {\\n    CtNamed(n, args) => {\\n      let known = match find_typedef(defs, n) {\\n        Some(_) => true,\\n        None => match resolve_builtin(n) {\\n          Some(_) => true,\\n          None => false\\n        }\\n      }\\n      if known {\\n        CtNamed(n, for a in args {\\n          relax_unknown_named(a, defs)\\n        })\\n      } else {\\n        CtUnknown\\n      }\\n    },\\n    CtArray(e) => CtArray(relax_unknown_named(e, defs)),\\n    CtOption(e) => CtOption(relax_unknown_named(e, defs)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      relax_unknown_named(e, defs)\\n    }),\\n    CtFn(ps, r, eff) => CtFn(for p in ps {\\n      relax_unknown_named(p, defs)\\n    }, relax_unknown_named(r, defs), eff),\\n    _ => ty\\n  }\\n}\\n\\n// Resolve a qualified identifier `T::method` where `T` is a bounded generic\\n// type parameter (`[T: Trait]`). If the head resolves to a type variable whose\\n// recorded bounds include a trait declaring `method`, return that method's\\n// signature with `Self` substituted by T. Returns None for any other qualified\\n// name (concrete `Type::method`, module-qualified names, etc.) so the existing\\n// resolution paths are untouched. (PR-3 component 2.)\\nlet resolve_trait_method_ident: (String, TypeEnv, Array[TypeDef], Subst) -> Option[Type] = (name, env, defs, s) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let method = String::substring(name, idx + 2, String::length(name))\\n    match env_lookup(env, head) {\\n      Some(head_ty) => match head_ty {\\n        CtVar(vid) => {\\n          let bounds = subst_bounds_for(s, vid)\\n          let self_ty = CtVar(vid)\\n          let mut result = None\\n          let mut bi = 0\\n          while bi < Array::length(bounds) {\\n            let pending = match result {\\n              None => true,\\n              _ => false\\n            }\\n            if pending {\\n              let trait_name = Array::get(bounds, bi)\\n              match trait_method_sig_deep(env, trait_name, method) {\\n                Some(sig) => {\\n                  let (params_te, ret_te) = sig\\n                  let resolved_params = for pte in params_te {\\n                    relax_unknown_named(subst_self_in_type(resolve_type_expr(pte, defs), self_ty), defs)\\n                  }\\n                  let resolved_ret = relax_unknown_named(subst_self_in_type(resolve_type_expr(ret_te, defs), self_ty), defs)\\n                  result = Some(CtFn(resolved_params, resolved_ret, None))\\n                },\\n                None => ()\\n              }\\n            } else {\\n              ()\\n            }\\n            bi = bi + 1\\n          }\\n          result\\n        },\\n        _ => None\\n      },\\n      None => None\\n    }\\n  }\\n}\\n\\n// Resolve a qualified constructor reference `Enum::Variant` (e.g. `Color::Red`,\\n// `Sh::Circle`) to the bare variant's constructor type. The bare variant name\\n// is already bound in `env` by the SEnum case; we only confirm `head` names a\\n// known enum that actually owns `member` (so unrelated `T::method` names fall\\n// through to the `unknown name` path). Returns the polymorphic env type as-is;\\n// callers instantiate it exactly like a bare ident. (#672 qualified ctors.)\\nlet resolve_qualified_ctor_ident: (String, TypeEnv, Array[TypeDef]) -> Option[Type] = (name, env, defs) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    let member = String::substring(name, idx + 2, String::length(name))\\n    match find_typedef(defs, head) {\\n      Some(TDEnum(_, _, variants)) => {\\n        let mut found = false\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, _) = Array::get(variants, vi)\\n          if vname == member {\\n            found = true\\n          } else {\\n            ()\\n          }\\n          vi = vi + 1\\n        }\\n        if found {\\n          env_lookup(env, member)\\n        } else {\\n          None\\n        }\\n      },\\n      _ => None\\n    }\\n  }\\n}\\n\\nlet expr_ident_name_or_empty: (Expr) -> String = (expr) -> {\\n  match expr {\\n    EIdent(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\n// Erase every effect annotation in a type (recursively), so an argument can be\\n// checked for STRUCTURAL compatibility independent of effects. Effects on\\n// function VALUES are inferred imprecisely (a `with { Error }` callback often\\n// arrives typed with no effect), so an effect-only difference must not be\\n// reported as a type error — only the structural shape is enforced here.\\nlet rec strip_effects: (Type) -> Type = (ty) -> {\\n  match ty {\\n    CtFn(params, ret, _) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        Array::push(out, strip_effects(Array::get(params, i)))\\n        i = i + 1\\n      }\\n      CtFn(out, strip_effects(ret), None)\\n    },\\n    CtArray(elem) => CtArray(strip_effects(elem)),\\n    CtOption(elem) => CtOption(strip_effects(elem)),\\n    CtTuple(elems) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        Array::push(out, strip_effects(Array::get(elems, i)))\\n        i = i + 1\\n      }\\n      CtTuple(out)\\n    },\\n    CtNamed(name, args) => {\\n      let out = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        Array::push(out, strip_effects(Array::get(args, i)))\\n        i = i + 1\\n      }\\n      CtNamed(name, out)\\n    },\\n    _ => ty\\n  }\\n}\\n\\n// True when a type is fully ground (mentions no type parameter / type\\n// variable). An unresolved type name resolves to `CtNamed(_, _)` (see\\n// resolve_type_expr), which for a struct field or function parameter means a\\n// generic parameter like `T`; `CtVar`/`CtForAll` are likewise non-ground. Used\\n// both to restrict record struct-identity recovery to MONOMORPHIC structs (a\\n// bare `CtStruct(LazyIter)` would erase the element type that `for x in it`\\n// relies on) and to gate structural-mismatch reporting to concrete types.\\n// #635: does a match-arm body DIVERGE (early-`return`), yielding no value to the\\n// match? The `?`-operator desugar lowers `val?` to\\n//   match val { Some(v) => v, None => return None }\\n// whose `None` arm is `return None` — it must not force the match's result type\\n// (else `T` vs `Option[T]` clashes). A diverging arm is a bare `return`, or a\\n// block (`ESeq`) whose final expr diverges.\\nlet rec arm_body_diverges: (Expr) -> Bool = (body) -> {\\n  match body {\\n    EReturn(_) => true,\\n    ESeq(_, rest) => arm_body_diverges(rest),\\n    _ => false\\n  }\\n}\\n\\nlet rec type_is_ground: (Type) -> Bool = (t) -> {\\n  match t {\\n    CtNamed(_, _) => false,\\n    CtVar(_) => false,\\n    CtForAll(_, _, _) => false,\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_is_ground(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_is_ground(e),\\n    CtOption(e) => type_is_ground(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_is_ground(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_is_ground(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\n// True when a type mentions no RIGID type parameter (`CtNamed` / `CtForAll`) but\\n// MAY contain inference variables (`CtVar`). Used to recognise an `actual` type\\n// whose only flexibility is unification variables: if such a type fails to unify\\n// against a fully GROUND expected type, no instantiation of its variables can\\n// make it match, so the mismatch is real (unlike an un-instantiated generic\\n// param `CtNamed(T)`, which the checker simply has not substituted yet).\\nlet rec type_no_named: (Type) -> Bool = (t) -> {\\n  match t {\\n    CtNamed(_, _) => false,\\n    CtForAll(_, _, _) => false,\\n    CtTuple(items) => {\\n      let mut ok = true\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        if !type_no_named(Array::get(items, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    CtArray(e) => type_no_named(e),\\n    CtOption(e) => type_no_named(e),\\n    CtFn(ps, r, _) => {\\n      let mut ok = type_no_named(r)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        if !type_no_named(Array::get(ps, i)) {\\n          ok = false\\n        }\\n        i = i + 1\\n      }\\n      ok\\n    },\\n    _ => true\\n  }\\n}\\n\\n// A small tag for a type's TOP-LEVEL constructor, or 0 for a type whose head is\\n// not concrete (a type variable / unresolved named param / unknown / forall).\\n// Two types with DIFFERENT non-zero heads can never be made equal by any\\n// instantiation of their inner type parameters (an `Int` is never an `Array[T]`\\n// for any `T`), so such a unify failure is a real mismatch even when the inner\\n// parts are generic — which the whole-type groundness gate misses.\\nlet head_kind: (Type) -> Int = (t) -> {\\n  match t {\\n    CtInt => 1,\\n    CtDouble => 2,\\n    CtBool => 3,\\n    CtString => 4,\\n    CtChar => 5,\\n    CtUnit => 6,\\n    CtBytes => 7,\\n    CtTuple(_) => 8,\\n    CtArray(_) => 9,\\n    CtOption(_) => 10,\\n    CtStruct(_) => 11,\\n    CtEnum(_) => 12,\\n    CtFn(_, _, _) => 13,\\n    _ => 0\\n  }\\n}\\n\\n// True when every declared field type of a struct is ground (the struct is not\\n// generic). `S::{ ... }` for such a struct can safely be typed `CtStruct(S)`.\\nlet struct_fields_ground: (Array[(String, Type)]) -> Bool = (dfields) -> {\\n  let mut ok = true\\n  let mut i = 0\\n  while i < Array::length(dfields) {\\n    let (_, ft) = Array::get(dfields, i)\\n    if !type_is_ground(ft) {\\n      ok = false\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\n// Unify `expected` with `actual`, REPORTING only a genuine STRUCTURAL mismatch\\n// (the checker historically swallowed these, accepting ill-typed programs).\\n// `unify` already accepts `CtUnknown`/`CtVar` freely; on failure we retry with\\n// effects erased, and tolerate the difference if the structure matches — effect\\n// inference on function values is imprecise, so effect-only differences must not\\n// be reported here. Returns the (possibly extended) substitution.\\nexport let check_assignable: (Type, Type, Subst, Array[String], String, Int) -> Subst = (expected, actual, s, errors, what, off) -> {\\n  match unify(expected, actual, s) {\\n    Some(su) => su,\\n    None => {\\n      let structural = match unify(strip_effects(expected), strip_effects(actual), s) {\\n        Some(_) => true,\\n        None => false\\n      }\\n      // Only report when BOTH sides are fully ground (mention no type parameter\\n      // / type variable). The selfhost checker does not instantiate a generic\\n      // struct field's or function parameter's type params — they surface as\\n      // rigid `CtNamed(T, _)` — so a unify failure against a concrete\\n      // instantiation there is NOT a real mismatch (e.g. a `pull: (Int) ->\\n      // Option[(T, Int)]` field vs a concrete closure). Reporting only on\\n      // ground/ground keeps the genuine concrete-type mismatches (Int vs\\n      // String, struct field of the wrong concrete type) while not\\n      // over-rejecting polymorphic code.\\n      // Report when the EXPECTED type is fully ground and the ACTUAL type\\n      // mentions no rigid type parameter (inference variables are fine). A\\n      // unify failure under those conditions is genuine: no instantiation of\\n      // the actual's variables can satisfy the concrete expected type (this is\\n      // what catches `let g: (Int) -> String = (n) -> { n }`). A non-ground\\n      // expected, or an actual carrying an un-instantiated generic `CtNamed`,\\n      // is still tolerated to avoid over-rejecting polymorphic code.\\n      let reportable = type_is_ground(subst_apply(s, expected)) && type_no_named(subst_apply(s, actual))\\n      // Also report when the two types have DIFFERENT concrete top-level\\n      // constructors (e.g. `Array[T]` vs `Int` from `Array::length(5)`): no\\n      // instantiation of inner type parameters can reconcile them, so it is a\\n      // real mismatch even though the expected type is non-ground. A\\n      // var/named/unknown head (kind 0) on either side stays tolerated.\\n      let eh = head_kind(subst_apply(s, expected))\\n      let ah = head_kind(subst_apply(s, actual))\\n      let head_differ = eh != 0 && ah != 0 && eh != ah\\n      if structural || !(reportable || head_differ) {\\n        s\\n      } else {\\n        Array::push(errors, String::concat(what, String::concat(\\\": expected \\\", String::concat(type_to_string(subst_apply(s, expected)), String::concat(\\\", got \\\", String::concat(type_to_string(subst_apply(s, actual)), off_marker(off)))))))\\n        s\\n      }\\n    }\\n  }\\n}\\n\\n// Struct construction `S::{ ... }` drops the name `S` at parse time (becomes a\\n// bare ERecord), so the struct is resolved by matching the field-name SET. True\\n// when `declared` and `actual` have the same field names.\\nlet struct_field_names_match: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (declared, actual) -> {\\n  if Array::length(declared) != Array::length(actual) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while i < Array::length(declared) {\\n      let (dn, _) = Array::get(declared, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(actual) {\\n        let (an, _) = Array::get(actual, j)\\n        if an == dn {\\n          found = true\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nlet lookup_actual_field_ty: (Array[(String, Type)], String) -> Option[Type] = (actual, name) -> {\\n  let mut i = 0\\n  let mut out = None\\n  while i < Array::length(actual) {\\n    let (an, at) = Array::get(actual, i)\\n    if an == name {\\n      out = Some(at)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n// True when `dfields` (a struct's declared fields) is a STRICT superset of the\\n// record literal's `actual` fields: every provided field name appears in the\\n// struct, and the struct declares strictly more fields. Used to flag a record\\n// that omits required fields.\\nlet struct_is_strict_superset: (Array[(String, Type)], Array[(String, Type)]) -> Bool = (dfields, actual) -> {\\n  if Array::length(dfields) <= Array::length(actual) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut all_in = true\\n    while i < Array::length(actual) {\\n      let (an, _) = Array::get(actual, i)\\n      let mut found = false\\n      let mut j = 0\\n      while j < Array::length(dfields) {\\n        let (dn, _) = Array::get(dfields, j)\\n        if dn == an {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        j = j + 1\\n      }\\n      if !found {\\n        all_in = false\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    all_in\\n  }\\n}\\n\\n// Check a record literal's field VALUES against the declared field types of the\\n// (uniquely) matching struct definition — previously unchecked, so\\n// `S::{ x: \\\"oops\\\" }` for `struct S { x: Int }` was accepted. Conservative: if 0\\n// or >1 structs share the field-name set, skip (no struct could be determined).\\nlet check_record_fields: (Array[TypeDef], Array[(String, Type)], Subst, Array[String]) -> Subst = (defs, actual, s, errors) -> {\\n  let mut matchct = 0\\n  let mut matched_fields = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let mut di = 0\\n  while di < Array::length(defs) {\\n    match Array::get(defs, di) {\\n      TDStruct(_, dfields, _) => if struct_field_names_match(dfields, actual) {\\n        matchct = matchct + 1\\n        matched_fields = dfields\\n      },\\n      _ => ()\\n    }\\n    di = di + 1\\n  }\\n  if matchct == 1 {\\n    let mut out = s\\n    let mut i = 0\\n    while i < Array::length(matched_fields) {\\n      let (fname, declared_ty) = Array::get(matched_fields, i)\\n      match lookup_actual_field_ty(actual, fname) {\\n        Some(actual_ty) => {\\n          out = check_assignable(declared_ty, subst_apply(out, actual_ty), out, errors, String::concat(\\\"struct field type mismatch for \\\", fname), 0 - 1)\\n        },\\n        None => ()\\n      }\\n      i = i + 1\\n    }\\n    out\\n  } else {\\n    // No struct has EXACTLY this field set. If exactly one struct is a strict\\n    // SUPERSET (contains every provided field and at least one more), the record\\n    // is that struct with fields MISSING — a real soundness hole, since the\\n    // omitted fields would be left uninitialized. Reported only when the\\n    // superset is unique (otherwise the intended struct is ambiguous → skip).\\n    let mut supct = 0\\n    let mut sup_name = \\\"\\\"\\n    let mut sup_fields = Array::slice([\\n      (\\\"\\\", CtUnknown)\\n    ], 0, 0)\\n    let mut dj = 0\\n    while dj < Array::length(defs) {\\n      match Array::get(defs, dj) {\\n        TDStruct(sname, dfields, _) => if struct_is_strict_superset(dfields, actual) {\\n          supct = supct + 1\\n          sup_name = sname\\n          sup_fields = dfields\\n        },\\n        _ => ()\\n      }\\n      dj = dj + 1\\n    }\\n    if supct == 1 {\\n      let mut fi = 0\\n      while fi < Array::length(sup_fields) {\\n        let (dn, _) = Array::get(sup_fields, fi)\\n        match lookup_actual_field_ty(actual, dn) {\\n          Some(_) => (),\\n          None => Array::push(errors, String::concat(\\\"missing field `\\\", String::concat(dn, String::concat(\\\"` in construction of struct \\\", sup_name))))\\n        }\\n        fi = fi + 1\\n      }\\n      s\\n    } else {\\n      s\\n    }\\n  }\\n}\\n\\n// Resolve the (uniquely) matching struct name for a record literal's field-name\\n// set. Returns None when 0 or >1 structs share that field set (ambiguous), or\\n// when the matching struct is GENERIC (non-ground fields) — so a record's\\n// struct identity is only recovered for an unambiguous MONOMORPHIC struct. Used\\n// to give a bare `S::{ ... }` literal the type `CtStruct(S)` instead of\\n// CtUnknown, which in turn lets `mut`-field write checking see the struct\\n// without disturbing generic-struct inference.\\nlet resolve_record_struct_name: (Array[TypeDef], Array[(String, Type)]) -> Option[String] = (defs, actual) -> {\\n  let mut matchct = 0\\n  let mut out = None\\n  let mut ground = false\\n  let mut di = 0\\n  while di < Array::length(defs) {\\n    match Array::get(defs, di) {\\n      TDStruct(sname, dfields, _) => if struct_field_names_match(dfields, actual) {\\n        matchct = matchct + 1\\n        out = Some(sname)\\n        ground = struct_fields_ground(dfields)\\n      },\\n      _ => ()\\n    }\\n    di = di + 1\\n  }\\n  if matchct == 1 && ground {\\n    out\\n  } else {\\n    None\\n  }\\n}\\n\\n// Unify each argument against its parameter, REPORTING a type mismatch instead\\n// of silently swallowing it. `__to_string` (the polymorphic interpolation\\n// stringifier: `\\\"\\\\{x}\\\"` -> `__to_string(x)` wraps values of any type, but the\\n// polyfill annotates it `(Int) -> String`) is exempt.\\nlet unify_call_args: (Array[Type], Array[Type], Subst, Array[String], String, Int) -> Subst = (param_tys, arg_tys, s, errors, label, off) -> {\\n  let mut out = s\\n  let mut ui = 0\\n  let ul = min_int(Array::length(arg_tys), Array::length(param_tys))\\n  while ui < ul {\\n    let pty = Array::get(param_tys, ui)\\n    let aty = Array::get(arg_tys, ui)\\n    out = if label == \\\"__to_string\\\" {\\n      match unify(pty, aty, out) {\\n        Some(su) => su,\\n        None => out\\n      }\\n    } else {\\n      check_assignable(pty, aty, out, errors, String::concat(\\\"argument type mismatch for \\\", label), off)\\n    }\\n    ui = ui + 1\\n  }\\n  out\\n}\\n\\nexport let fn_return_env_name: (String) -> String = (name) -> {\\n  String::concat(\\\"__fn_ret__:\\\", name)\\n}\\n\\nlet direct_builtin_return: (String) -> Option[Type] = (name) -> {\\n  if name == \\\"Bytes::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"iter_length\\\" || name == \\\"String::iter_length\\\" || name == \\\"Map::iter_length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Array::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"FixedArray::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::length\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Bytes::get\\\" || name == \\\"String::index_of\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::last_index_of\\\" || name == \\\"Char::to_int\\\" || name == \\\"Double::to_int\\\" || name == \\\"Double::to_i64_bits\\\" || name == \\\"Double::to_i64_bits_lo\\\" || name == \\\"Double::to_i64_bits_hi\\\" || name == \\\"Env::args_len\\\" || name == \\\"Stdin::read_char\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::equals\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::contains\\\" || name == \\\"Map::has_key\\\" || name == \\\"map_has\\\" || name == \\\"Path::is_absolute\\\" || name == \\\"Fs::exists\\\" || name == \\\"Fs::is_dir\\\" || name == \\\"Fs::is_file\\\" || name == \\\"eq\\\" || name == \\\"not\\\" {\\n    Some(CtBool)\\n  }\\n  else if name == \\\"String::concat\\\" || name == \\\"String::substring\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::from_char_code\\\" || name == \\\"String::join\\\" || name == \\\"Array::join\\\" || name == \\\"Path::to_string\\\" || name == \\\"Path::resolve\\\" || name == \\\"PromptText::new\\\" || name == \\\"Stdin::read_stream\\\" || name == \\\"Env::get\\\" || name == \\\"Env::args_get\\\" || name == \\\"Fs::read_file\\\" || name == \\\"Fs::getcwd\\\" || name == \\\"sh\\\" || name == \\\"Lines::stringify\\\" || name == \\\"Llm::complete\\\" || name == \\\"Rlm::run\\\" || name == \\\"Rlm::finalize\\\" || name == \\\"__to_string\\\" {\\n    Some(CtString)\\n  }\\n  else if name == \\\"__len\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"String::iter_get\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"iter_get\\\" || name == \\\"Map::iter_get\\\" || name == \\\"iter_require\\\" || name == \\\"__neg\\\" {\\n    Some(CtUnknown)\\n  }\\n  else if name == \\\"Bytes::new\\\" || name == \\\"Bytes::concat\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::from_array\\\" || name == \\\"Fs::read_bytes\\\" {\\n    Some(CtBytes)\\n  }\\n  else if name == \\\"Array::set\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::foreach\\\" || name == \\\"FixedArray::set\\\" || name == \\\"FixedArray::blit\\\" || name == \\\"FixedArray::unsafe_set\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::blit\\\" || name == \\\"Bytes::fill\\\" || name == \\\"MapBuilder::set\\\" || name == \\\"Stdout::write_char\\\" || name == \\\"Stdout::write_stream\\\" || name == \\\"sleep\\\" || name == \\\"Fs::copy\\\" || name == \\\"Fs::chdir\\\" || name == \\\"Fs::mkdir\\\" || name == \\\"Fs::append\\\" || name == \\\"Fs::remove\\\" || name == \\\"Fs::write_file\\\" || name == \\\"Fs::write_bytes\\\" || name == \\\"print\\\" || name == \\\"println\\\" || name == \\\"assert\\\" || name == \\\"assert_true\\\" || name == \\\"assert_eq\\\" || name == \\\"__set_field\\\" {\\n    Some(CtUnit)\\n  }\\n  else if name == \\\"Double::from_i64_bits\\\" || name == \\\"Int::to_double\\\" || name == \\\"Double::to_float\\\" || name == \\\"Float::to_double\\\" {\\n    Some(CtDouble)\\n  }\\n  else if name == \\\"Char::from_int\\\" {\\n    Some(CtChar)\\n  }\\n  else if name == \\\"Bytes::to_array\\\" {\\n    Some(CtArray(CtInt))\\n  }\\n  else if name == \\\"Map::keys\\\" || name == \\\"sh_lines\\\" || name == \\\"Lines::parse\\\" {\\n    Some(CtArray(CtString))\\n  }\\n  else if name == \\\"Array::slice\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::filter\\\" || name == \\\"Array::reverse\\\" || name == \\\"Array::sort\\\" || name == \\\"FixedArray::make\\\" {\\n    Some(CtArray(CtUnknown))\\n  }\\n  else if name == \\\"Some\\\" || name == \\\"Array::find\\\" {\\n    Some(CtOption(CtUnknown))\\n  }\\n  else {\\n    None\\n  }\\n}\\n\\nlet direct_call_return: (TypeEnv, String) -> Option[Type] = (env, name) -> {\\n  match env_lookup(env, name) {\\n    Some(_) => None,\\n    None => direct_builtin_return(name)\\n  }\\n}\\n\\n// Expected TOP-LEVEL head-kind (see `head_kind`) of a builtin's FIRST argument,\\n// for the container/string builtins whose receiver head is unambiguous. 0 means\\n// \\\"unchecked\\\". Used to catch `Array::length(5)` / `String::length(5)` etc. on\\n// the direct-call fast path WITHOUT a per-call `lookup_builtin` (the #626\\n// seed-heap OOM constraint). Only entries whose first-arg head is certain are\\n// listed; anything else returns 0 (tolerated).\\nlet builtin_first_arg_head: (String) -> Int = (name) -> {\\n  if name == \\\"Array::length\\\" || name == \\\"Array::get\\\" || name == \\\"Array::set\\\" || name == \\\"Array::push\\\" || name == \\\"Array::push_all\\\" || name == \\\"Array::slice\\\" || name == \\\"Array::concat\\\" || name == \\\"Array::reverse\\\" || name == \\\"Array::truncate\\\" || name == \\\"Array::foreach\\\" || name == \\\"Array::contains\\\" || name == \\\"Array::any\\\" || name == \\\"Array::all\\\" || name == \\\"Array::find\\\" || name == \\\"Array::filter\\\" {\\n    9\\n  } else if name == \\\"String::length\\\" || name == \\\"String::substring\\\" || name == \\\"String::trim\\\" || name == \\\"String::to_lower\\\" || name == \\\"String::to_upper\\\" || name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::char_code_at\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" || name == \\\"String::concat\\\" {\\n    4\\n  } else if name == \\\"Bytes::length\\\" || name == \\\"Bytes::get\\\" || name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" || name == \\\"Bytes::to_array\\\" || name == \\\"Bytes::push\\\" || name == \\\"Bytes::append\\\" || name == \\\"Bytes::blit\\\" || name == \\\"Bytes::fill\\\" {\\n    7\\n  } else {\\n    0\\n  }\\n}\\n\\n// Expected head-kind for argument position `i` (i >= 1) of fixed-signature\\n// builtins, mirroring `builtin_first_arg_head` for the non-receiver args.\\n// `direct_call_return` types these polymorphically, so passing e.g. an Int as\\n// the second arg of `String::concat`, or a String as the index of\\n// `String::substring`, slipped through. 0 = tolerate (no certain head). Only\\n// monomorphic, non-callback positions are listed (so HOF args like Array::map's\\n// function stay untouched — those need real signature inference, not a head).\\nlet builtin_arg_head_rest: (String, Int) -> Int = (name, i) -> {\\n  // String head = 4, Int head = 1, Bytes head = 7 (see head_kind).\\n  if name == \\\"String::concat\\\" {\\n    if i == 1 { 4 } else { 0 }\\n  } else if name == \\\"String::index_of\\\" || name == \\\"String::last_index_of\\\" || name == \\\"String::contains\\\" || name == \\\"String::starts_with\\\" || name == \\\"String::ends_with\\\" || name == \\\"String::split\\\" {\\n    if i == 1 { 4 } else { 0 }\\n  } else if name == \\\"String::substring\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else if name == \\\"String::char_code_at\\\" {\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::get\\\" {\\n    if i == 1 { 1 } else { 0 }\\n  } else if name == \\\"Bytes::set\\\" || name == \\\"Bytes::slice\\\" {\\n    if i == 1 || i == 2 { 1 } else { 0 }\\n  } else {\\n    0\\n  }\\n}\\n\\n// Check a higher-order builtin's callback parameter against the type it will be\\n// fed. `recv_ty` / `fn_ty` are already subst-applied; when the receiver is a\\n// concrete `CtArray(elem)` and the callback is a `CtFn` with a parameter at\\n// `pidx`, require `elem` to be assignable to that parameter type. Ground-gated\\n// via check_assignable, so an unannotated callback param (a fresh CtVar that\\n// the body never pins to a concrete type) stays tolerant — only an explicit\\n// wrong annotation (or a body that pins the param to a mismatching concrete\\n// type) is rejected. `expected_ty` is the param (the slot), `elem` the value.\\nlet check_hof_param_vs_elem: (Type, Type, Int, Subst, Array[String], String) -> Subst = (recv_ty, fn_ty, pidx, s, errors, msg) -> {\\n  match recv_ty {\\n    CtArray(elem) => match fn_ty {\\n      CtFn(ptys, _, _) => if Array::length(ptys) > pidx {\\n        check_assignable(subst_apply(s, Array::get(ptys, pidx)), subst_apply(s, elem), s, errors, msg, 0 - 1)\\n      } else {\\n        s\\n      },\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\n// Require two array operands to share an element type (Array::concat /\\n// Array::push_all). `a_app` / `b_app` are already subst-applied; when both are\\n// concrete `CtArray`, ground-gated check_assignable compares their element\\n// types (generic / var operands stay tolerant).\\nlet check_two_array_elems: (Type, Type, Subst, Array[String], String) -> Subst = (a_app, b_app, s, errors, msg) -> {\\n  match a_app {\\n    CtArray(ea) => match b_app {\\n      CtArray(eb) => check_assignable(subst_apply(s, ea), subst_apply(s, eb), s, errors, msg, 0 - 1),\\n      _ => s\\n    },\\n    _ => s\\n  }\\n}\\n\\n// Declared type of a (monomorphic) struct field by name, or None if the struct\\n// or field is unknown. Used to recognise a field-stored-function call\\n// `b.f(args)` when no method/builtin `T::f` exists.\\nlet struct_field_type: (Array[TypeDef], String, String) -> Option[Type] = (defs, sname, field) -> {\\n  match find_typedef(defs, sname) {\\n    Some(td) => match td {\\n      TDStruct(_, fields, _) => {\\n        let rec go: (Int) -> Option[Type] = (i) -> {\\n          if i >= Array::length(fields) {\\n            None\\n          } else {\\n            let (fname, ftype) = Array::get(fields, i)\\n            if fname == field { Some(ftype) } else { go(i + 1) }\\n          }\\n        }\\n        go(0)\\n      },\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet is_logic_binop: (String) -> Bool = (op) -> {\\n  op == \\\"&&\\\"\\n  || op == \\\"||\\\"\\n}\\n\\nlet is_order_binop: (String) -> Bool = (op) -> {\\n  op == \\\"<\\\"\\n  || op == \\\">\\\"\\n  || op == \\\"<=\\\"\\n  || op == \\\">=\\\"\\n}\\n\\nlet type_name_prefix: (Type) -> String = (ty) -> {\\n  match ty {\\n    CtInt => \\\"Int\\\",\\n    CtDouble => \\\"Double\\\",\\n    CtBool => \\\"Bool\\\",\\n    CtString => \\\"String\\\",\\n    CtChar => \\\"Char\\\",\\n    CtUnit => \\\"Unit\\\",\\n    CtBytes => \\\"Bytes\\\",\\n    CtArray(_) => \\\"Array\\\",\\n    CtOption(_) => \\\"Option\\\",\\n    CtEnum(name) => name,\\n    CtStruct(name) => name,\\n    CtNamed(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nlet is_equality_binop: (String) -> Bool = (op) -> {\\n  op == \\\"==\\\"\\n  || op == \\\"!=\\\"\\n}\\n\\nlet unify_binop_candidate: (Type, Type, Type, Subst) -> Option[Subst] = (left_ty, right_ty, target_ty, s) -> {\\n  match unify(left_ty, target_ty, s) {\\n    Some(s1) => unify(right_ty, target_ty, s1),\\n    None => None\\n  }\\n}\\n\\nlet unify_same_binop_operands: (Type, Type, Subst) -> Option[(Type, Subst)] = (left_ty, right_ty, s) -> {\\n  match unify(left_ty, right_ty, s) {\\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\\n    None => None\\n  }\\n}\\n\\nlet infer_named_trait_binop: (TypeEnv, Type, Type, String, Subst) -> Option[(Type, Subst)] = (env, left_ty, right_ty, trait_name, s) -> {\\n  match unify_same_binop_operands(left_ty, right_ty, s) {\\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\\n      Some((resolved, s1))\\n    } else {\\n      None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet infer_binop_type: (String, Type, Type, TypeEnv, Subst, Array[String], Array[(Int, Type)]) -> (Type, Subst) = (op, left_ty, right_ty, env, s, errors, tytab) -> {\\n  if is_logic_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Bool\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_equality_binop(op) {\\n    match unify(left_ty, right_ty, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must have same type\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_order_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtBool, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Ord\\\", s) {\\n          Some((_, s1)) => (CtBool, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"+\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\\n          Some(s1) => (CtString, s1),\\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Add\\\", s) {\\n            Some((resolved, s1)) => (resolved, s1),\\n            None => {\\n              Array::push(errors, \\\"type mismatch in '+': operands must be Int, Double, or String\\\")\\n              (CtUnknown, s)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"-\\\"\\n  || op == \\\"*\\\"\\n  || op == \\\"/\\\" {\\n    let trait_name = if op == \\\"-\\\" {\\n      \\\"Sub\\\"\\n    } else if op == \\\"*\\\" {\\n      \\\"Mul\\\"\\n    } else {\\n      \\\"Div\\\"\\n    }\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\\n          Some((resolved, s1)) => (resolved, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"%\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, \\\"type mismatch in '%': operands must be Int\\\")\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else {\\n    Array::push(errors, String::concat(\\\"unknown operator: \\\", op))\\n    (CtUnknown, s)\\n  }\\n}\\n\\n// Recursively replace type-parameter names (those bound to a CtVar in `env`)\\n// with that CtVar, including ones nested inside Array/Option/Tuple/Fn/Named type\\n// args. Type constructors (enum/struct names, not bound to a CtVar) are kept and\\n// their args recursed. This lets a generic annotation like `Map[String, V]`\\n// resolve its inner `V` to the function's quantified var, so call sites can\\n// instantiate it (the previous shallow lookup only handled the outermost name).\\nlet rec resolve_tparams_in: (Type, TypeEnv) -> Type = (ty, env) -> {\\n  match ty {\\n    CtNamed(name, args) => {\\n      let ra = for a in args {\\n        resolve_tparams_in(a, env)\\n      }\\n      match env_lookup(env, name) {\\n        Some(t) => match t {\\n          CtVar(_) => t,\\n          _ => CtNamed(name, ra)\\n        },\\n        None => CtNamed(name, ra)\\n      }\\n    },\\n    CtArray(e) => CtArray(resolve_tparams_in(e, env)),\\n    CtOption(e) => CtOption(resolve_tparams_in(e, env)),\\n    CtTuple(es) => CtTuple(for e in es {\\n      resolve_tparams_in(e, env)\\n    }),\\n    CtFn(ps, ret, eff) => {\\n      let resolve_params: (Array[Type]) -> Array[Type] = (types) -> {\\n        let out = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut i = 0\\n        while i < Array::length(types) {\\n          Array::push(out, resolve_tparams_in(Array::get(types, i), env))\\n          i = i + 1\\n        }\\n        out\\n      }\\n      CtFn(resolve_params(ps), resolve_tparams_in(ret, env), eff)\\n    },\\n    _ => ty\\n  }\\n}\\n\\n// Record a call-site node's (raw, pre-final-subst) result type `ty` keyed by\\n// its real source char offset `call_off`, for typed-hover (vibe type-at) on\\n// `foo(x)` / `obj.method(x)`, then return `ty` unchanged so it can be dropped\\n// into the call-result tuple in place. Synthetic calls (call_off < 0) skip the\\n// push. Used at the ECall result sites (NOT by wrapping the giant ECall match,\\n// which the bootstrap seed parser cannot reparse when that match is nested one\\n// level deeper — only the interior result types are tagged).\\nlet tab_call_ty: (Array[(Int, Type)], Int, Type) -> Type = (tytab, call_off, ty) -> {\\n  if call_off >= 0 {\\n    Array::push(tytab, (call_off, ty))\\n  } else {\\n    ()\\n  }\\n  ty\\n}\\n\\n// Iteratively check a sequence/let SPINE (`ESeq` and `ELet`/`ELetMut`/`ELetRec`\\n// chains) instead of recursing into each `body`, so a long function body — a\\n// deep right-nested `let` chain — does not exhaust the wasm call stack during\\n// self-compile. `ce` is `check_expr` itself (threaded as a value to avoid a\\n// forward reference). Semantics are identical to the recursive arms: each `let`\\n// binds its (generalized, or raw for `mut`) value type into the env seen by the\\n// rest of the spine, and the final non-spine expression's result is returned.\\nlet check_seq_spine: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab, ce) -> {\\n  let mut cur = expr\\n  let mut cenv = env\\n  let mut s1 = s\\n  let mut c1 = c\\n  let mut done = false\\n  let mut result = (CtUnit, s, c)\\n  while !done {\\n    match cur {\\n      ESeq(left, right) => {\\n        let (_, ns, nc) = ce(left, cenv, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        cur = right\\n      },\\n      ELet(name, val, body) => {\\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\\n        let gen = generalize(ns, vt)\\n        cenv = env_bind(cenv, name, gen)\\n        s1 = ns\\n        c1 = nc\\n        cur = body\\n      },\\n      ELetMut(name, val, body) => {\\n        let (vt, ns, nc) = ce(val, cenv, defs, s1, c1, errors, tytab)\\n        cenv = env_bind(cenv, name, vt)\\n        s1 = ns\\n        c1 = nc\\n        cur = body\\n      },\\n      ELetRec(name, val, body) => {\\n        let (tv, c1b) = fresh_var(c1)\\n        let (vt, ns, nc) = ce(val, env_bind(cenv, name, tv), defs, s1, c1b, errors, tytab)\\n        let s2 = match unify(tv, vt, ns) {\\n          Some(su) => su,\\n          None => ns\\n        }\\n        let gen = generalize(s2, tv)\\n        cenv = env_bind(cenv, name, gen)\\n        s1 = s2\\n        c1 = nc\\n        cur = body\\n      },\\n      _ => {\\n        result = ce(cur, cenv, defs, s1, c1, errors, tytab)\\n        done = true\\n      }\\n    }\\n  }\\n  result\\n}\\n\\n// #418: enforce that `obj.field = x` (which desugars to\\n// `__set_field(obj, \\\"field\\\", x)`) only targets a `mut`-declared struct field.\\n// Runs as a pure side-effect over a *throwaway* errors/tytab so it never\\n// perturbs the main type/subst flow — it only type-checks `obj` to learn its\\n// struct name, looks up that struct's `mut` field set, and pushes a single\\n// diagnostic to the real `errors` when the written field is not `mut`.\\nlet field_write_mut_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, tytab, ce) -> {\\n  if name == \\\"__set_field\\\" && Array::length(args) == 3 {\\n    match Array::get(args, 1) {\\n      EString(field) => {\\n        let throwaway = Array::slice([\\\"\\\"], 0, 0)\\n        let throwtab = Array::slice([(0, CtUnit)], 0, 0)\\n        let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\\n        match subst_apply(s, obj_ty) {\\n          CtStruct(sname) => match find_typedef(defs, sname) {\\n            Some(TDStruct(_, dfields, mut_names)) => {\\n              let mut found = false\\n              let mut i = 0\\n              while i < Array::length(mut_names) {\\n                if Array::get(mut_names, i) == field {\\n                  found = true\\n                } else {\\n                  ()\\n                }\\n                i = i + 1\\n              }\\n              if found {\\n                ()\\n              } else {\\n                Array::push(errors, String::concat(\\\"cannot assign to non-`mut` field `\\\", String::concat(field, String::concat(\\\"` of struct \\\", sname))))\\n              }\\n              // The written value must match the field's declared type\\n              // (`p.x = \\\"s\\\"` for `x: Int` was accepted). Ground-gated via\\n              // check_assignable so a generic field type is not over-rejected.\\n              let mut fty = CtUnknown\\n              let mut has_field = false\\n              let mut fi = 0\\n              while fi < Array::length(dfields) {\\n                let (fn2, ft) = Array::get(dfields, fi)\\n                if fn2 == field {\\n                  fty = ft\\n                  has_field = true\\n                } else {\\n                  ()\\n                }\\n                fi = fi + 1\\n              }\\n              if has_field {\\n                let (val_ty, _, _) = ce(Array::get(args, 2), env, defs, s, c, throwaway, throwtab)\\n                let _ = check_assignable(subst_apply(s, fty), subst_apply(s, val_ty), s, errors, String::concat(\\\"type mismatch writing field `\\\", String::concat(field, \\\"`\\\")), 0 - 1)\\n                ()\\n              } else {\\n                ()\\n              }\\n            },\\n            _ => ()\\n          },\\n          _ => ()\\n        }\\n      },\\n      _ => ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\n// `obj[i]` desugars to `__index(obj, i)`, typed fully polymorphically, so\\n// indexing a non-indexable scalar (`let n = 5; n[0]`) was accepted silently.\\n// Report when `obj` resolves to a concrete scalar that cannot be indexed\\n// (Array/String/Bytes ARE indexable; type vars / unknown / named stay\\n// tolerated). Pure side-effect over a throwaway error/type table.\\nlet index_target_check: (String, Array[Expr], TypeEnv, Array[TypeDef], Subst, Int, Array[String], (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int)) -> Unit = (name, args, env, defs, s, c, errors, ce) -> {\\n  if name == \\\"__index\\\" && Array::length(args) == 2 {\\n    let throwaway = Array::slice([\\\"\\\"], 0, 0)\\n    let throwtab = Array::slice([(0, CtUnit)], 0, 0)\\n    let (obj_ty, _, _) = ce(Array::get(args, 0), env, defs, s, c, throwaway, throwtab)\\n    let resolved_obj = subst_apply(s, obj_ty)\\n    let not_indexable = match resolved_obj {\\n      CtInt => true,\\n      CtDouble => true,\\n      CtBool => true,\\n      CtChar => true,\\n      CtUnit => true,\\n      _ => false\\n    }\\n    if not_indexable {\\n      Array::push(errors, \\\"cannot index a non-indexable value (expected Array, String, or Bytes)\\\")\\n    } else {\\n      // For an indexable receiver (Array/String/Bytes), the subscript must be an\\n      // Int — `a[\\\"x\\\"]` was accepted silently. Only flag a concrete non-Int index;\\n      // type vars / unknown / named stay tolerated.\\n      let indexable = match resolved_obj {\\n        CtArray(_) => true,\\n        CtString => true,\\n        CtBytes => true,\\n        _ => false\\n      }\\n      if indexable {\\n        let throwaway2 = Array::slice([\\\"\\\"], 0, 0)\\n        let throwtab2 = Array::slice([(0, CtUnit)], 0, 0)\\n        let (idx_ty, _, _) = ce(Array::get(args, 1), env, defs, s, c, throwaway2, throwtab2)\\n        let bad_index = match subst_apply(s, idx_ty) {\\n          CtInt => false,\\n          _ => type_is_ground(subst_apply(s, idx_ty))\\n        }\\n        if bad_index {\\n          Array::push(errors, \\\"index must be an Int\\\")\\n        } else {\\n          ()\\n        }\\n      } else {\\n        ()\\n      }\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\n// An arm pattern is a CATCH-ALL (makes a match exhaustive regardless of which\\n// constructors precede it) when it is a wildcard or a bare binding. `POr` is a\\n// catch-all if either side is.\\nlet rec pat_is_catchall: (Pat) -> Bool = (pat) -> {\\n  match pat {\\n    PWild => true,\\n    PBind(_) => true,\\n    POr(l, r) => pat_is_catchall(l) || pat_is_catchall(r),\\n    _ => false\\n  }\\n}\\n\\n// Collect the constructor names a pattern matches at the TOP level (for enum\\n// exhaustiveness). `POr` contributes from both sides; other patterns none.\\nlet rec collect_ctor_names_into: (Pat, Array[String]) -> Unit = (pat, acc) -> {\\n  match pat {\\n    PCtor(name, _) => Array::push(acc, name),\\n    POr(l, r) => {\\n      collect_ctor_names_into(l, acc)\\n      collect_ctor_names_into(r, acc)\\n    },\\n    _ => ()\\n  }\\n}\\n\\n// Parse a tuple projection field (`t.0`, `t.5`) — the field is the all-digit\\n// index string. Returns None for a non-numeric field (a real `.method`/.field)\\n// so only genuine tuple projections are bounds-checked.\\nlet parse_tuple_index: (String) -> Option[Int] = (s) -> {\\n  let len = String::length(s)\\n  if len == 0 {\\n    None\\n  } else {\\n    let mut i = 0\\n    let mut val = 0\\n    let mut ok = true\\n    while i < len {\\n      let cc = String::char_code_at(s, i)\\n      if cc >= 48 && cc <= 57 {\\n        val = val * 10 + (cc - 48)\\n      } else {\\n        ok = false\\n      }\\n      i = i + 1\\n    }\\n    if ok {\\n      Some(val)\\n    } else {\\n      None\\n    }\\n  }\\n}\\n\\nexport let rec check_expr: (Expr, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (Type, Subst, Int) = (expr, env, defs, s, c, errors, tytab) -> {\\n  match expr {\\n    EInt(_) => (CtInt, s, c),\\n    EFloat(_) => (CtDouble, s, c),\\n    EString(_) => (CtString, s, c),\\n    EBool(_) => (CtBool, s, c),\\n    EUnit => (CtUnit, s, c),\\n    EIdent(name, ident_off) => match env_lookup(env, name) {\\n      Some(t) => {\\n        let (ti, c1, new_bounds) = instantiate(t, c)\\n        let nblen = Array::length(new_bounds)\\n        let mut s1 = s\\n        let mut bi = 0\\n        while bi < nblen {\\n          let (vid, bounds) = Array::get(new_bounds, bi)\\n          if Array::length(bounds) != 0 {\\n            s1 = subst_add_bound(s1, vid, bounds)\\n          }\\n          bi = bi + 1\\n        }\\n        // Record this user identifier's inferred (raw, pre-final-subst) type\\n        // keyed by its real source offset, for typed-hover (vibe type-at) on\\n        // locals and parameters. Synthetic idents (off < 0) are skipped.\\n        if ident_off >= 0 {\\n          Array::push(tytab, (ident_off, ti))\\n        } else {\\n          ()\\n        }\\n        (ti, s1, c1)\\n      },\\n      None => match lookup_builtin(name) {\\n        Some(t) => {\\n          if ident_off >= 0 {\\n            Array::push(tytab, (ident_off, t))\\n          } else {\\n            ()\\n          }\\n          (t, s, c)\\n        },\\n        None => match resolve_trait_method_ident(name, env, defs, s) {\\n          Some(mty) => {\\n            if ident_off >= 0 {\\n              Array::push(tytab, (ident_off, mty))\\n            } else {\\n              ()\\n            }\\n            (mty, s, c)\\n          },\\n          None => match resolve_qualified_ctor_ident(name, env, defs) {\\n            Some(ct) => {\\n              let (ti, c1, new_bounds) = instantiate(ct, c)\\n              let nblen = Array::length(new_bounds)\\n              let mut s1 = s\\n              let mut bi = 0\\n              while bi < nblen {\\n                let (vid, bounds) = Array::get(new_bounds, bi)\\n                if Array::length(bounds) != 0 {\\n                  s1 = subst_add_bound(s1, vid, bounds)\\n                } else {\\n                  ()\\n                }\\n                bi = bi + 1\\n              }\\n              if ident_off >= 0 {\\n                Array::push(tytab, (ident_off, ti))\\n              } else {\\n                ()\\n              }\\n              (ti, s1, c1)\\n            },\\n            None => {\\n              Array::push(errors, String::concat(String::concat(\\\"unknown name: \\\", name), off_marker_len(ident_off, String::length(name))))\\n              (CtUnknown, s, c)\\n            }\\n          }\\n        }\\n      }\\n    },\\n    ESeq(_, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELet(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELetRec(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    ELetMut(_, _, _) => check_seq_spine(expr, env, defs, s, c, errors, tytab, check_expr),\\n    EIf(cond, then_e, else_e) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"if condition must be Bool\\\")\\n      }\\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors, tytab)\\n      let (et, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors, tytab)\\n      // The two branches must agree when both yield a real value (previously\\n      // unchecked — `if c { 1 } else { \\\"x\\\" }` was accepted). A `CtUnit` branch\\n      // is tolerated: `if c { stmt }` desugars to an `else ()` whose value is\\n      // discarded, and a statement-position `if` need not have matching arms.\\n      let rtt = subst_apply(s3, tt)\\n      let ret = subst_apply(s3, et)\\n      // When one branch yields Unit (an else-less `if`, whose missing else is\\n      // `()`, or an explicit `()` branch), the branches need not agree and the\\n      // expression yields Unit as a VALUE — so `let x: Int = if c { 1 }` is\\n      // rejected (it returns Unit when c is false) while a statement-position\\n      // `if` is harmless (its value is discarded). Only when BOTH branches yield\\n      // a real (non-Unit) value must they agree, and the result is that type.\\n      let (s3b, if_ty) = match rtt {\\n        CtUnit => (s3, CtUnit),\\n        _ => match ret {\\n          CtUnit => (s3, CtUnit),\\n          _ => (check_assignable(rtt, ret, s3, errors, \\\"if branches have incompatible types\\\", 0 - 1), tt)\\n        }\\n      }\\n      (if_ty, s3b, c3)\\n    },\\n    ECall(callee, args, call_off) => match callee {\\n      // `perform EffName::Op(opargs)` parses as ECall(EIdent(\\\"perform\\\"),\\n      // [ECall(EIdent(\\\"EffName::Op\\\"), opargs)]). The op name may be a builtin\\n      // effect (Stdin/Stdout/...) not registered in the checker env, so check\\n      // only the op ARGUMENTS (not the op callee) and yield a fresh result type.\\n      // `resume(v)` likewise yields the continuation result (a fresh var;\\n      // handler arms are otherwise unchecked).\\n      EIdent(name, callee_off) => {\\n        field_write_mut_check(name, args, env, defs, s, c, errors, tytab, check_expr)\\n        index_target_check(name, args, env, defs, s, c, errors, check_expr)\\n        if name == \\\"perform\\\" {\\n        if Array::length(args) == 1 {\\n          match Array::get(args, 0) {\\n            ECall(_, opargs, _) => {\\n              let oalen = Array::length(opargs)\\n              let mut s1 = s\\n              let mut c1 = c\\n              let mut ai = 0\\n              while ai < oalen {\\n                let (_, ns, nc) = check_expr(Array::get(opargs, ai), env, defs, s1, c1, errors, tytab)\\n                s1 = ns\\n                c1 = nc\\n                ai = ai + 1\\n              }\\n              let (tv, c2) = fresh_var(c1)\\n              (tv, s1, c2)\\n            },\\n            EIdent(_, _) => {\\n              let (tv, c2) = fresh_var(c)\\n              (tv, s, c2)\\n            },\\n            other => check_expr(other, env, defs, s, c, errors, tytab)\\n          }\\n        } else {\\n          (CtUnknown, s, c)\\n        }\\n      } else if name == \\\"resume\\\" {\\n        let alen = Array::length(args)\\n        let mut s1 = s\\n        let mut c1 = c\\n        let mut ai = 0\\n        while ai < alen {\\n          let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\\n          s1 = ns\\n          c1 = nc\\n          ai = ai + 1\\n        }\\n        let (tv, c2) = fresh_var(c1)\\n        (tv, s1, c2)\\n      } else if name == \\\"Some\\\" {\\n        if Array::length(args) == 1 {\\n          let (at, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n          (tab_call_ty(tytab, call_off, CtOption(subst_apply(s1, at))), s1, c1)\\n        } else {\\n          // `Some` takes exactly one payload — `Some(1, 2)` was accepted.\\n          Array::push(errors, String::concat(String::concat(\\\"Some expects 1 argument, got \\\", __to_string(Array::length(args))), off_marker_len(callee_off, 4)))\\n          (tab_call_ty(tytab, call_off, CtOption(CtUnknown)), s, c)\\n        }\\n      } else if name == \\\"__index\\\" && Array::length(args) == 2 {\\n        // `obj[i]` (`__index(obj, i)`) is typed polymorphically by the builtin\\n        // table, losing the result type — `let s: String = a[0]` over an\\n        // `Array[Int]` slipped through. When the receiver resolves to\\n        // `CtArray(elem)`, refine the result to `elem`; String/Bytes indexing\\n        // yields the char/byte code (`Int`) so `let s: String = \\\"abc\\\"[0]`\\n        // (which returns 97) must be rejected. Var / unknown / named receivers\\n        // keep the conservative CtUnknown. (index_target_check above still\\n        // validates the receiver/subscript shapes on a throwaway channel.)\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let result = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => elem,\\n          CtString => CtInt,\\n          CtBytes => CtInt,\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s2, c2)\\n      } else if name == \\\"Array::push\\\" && Array::length(args) == 2 {\\n        // `Array::push(a, v)` requires `v` to match `a`'s element type — pushing\\n        // a String into an `Array[Int]` was accepted (direct_call_return only\\n        // checks arg-0 head). Check the value against a concrete element type;\\n        // generic / var element types stay tolerant (check_assignable is ground-\\n        // gated).\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (val_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => check_assignable(subst_apply(s2, elem), subst_apply(s2, val_ty), s2, errors, \\\"Array::push value type mismatch\\\", 0 - 1),\\n          _ => s2\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"Array::set\\\" && Array::length(args) == 3 {\\n        // `Array::set(a, i, v)` requires `v` to match `a`'s element type (the 3rd\\n        // arg was unchecked). Same ground-gated discipline as Array::push.\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (val_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let s4 = match subst_apply(s3, obj_ty) {\\n          CtArray(elem) => check_assignable(subst_apply(s3, elem), subst_apply(s3, val_ty), s3, errors, \\\"Array::set value type mismatch\\\", 0 - 1),\\n          _ => s3\\n        }\\n        (tab_call_ty(tytab, call_off, CtUnit), s4, c3)\\n      } else if name == \\\"Array::push_all\\\" && Array::length(args) == 2 {\\n        // `Array::push_all(a, b)` appends every element of `b` into `a`, so the\\n        // two arrays must share an element type — `Array::push_all([1], [\\\"x\\\"])`\\n        // merged Int and String elements and slipped through (push_all had no\\n        // value/element check, only the arg-0 head). Same ground-gated discipline\\n        // as Array::concat.\\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_two_array_elems(subst_apply(s2, a_ty), subst_apply(s2, b_ty), s2, errors, \\\"Array::push_all element type mismatch\\\")\\n        (tab_call_ty(tytab, call_off, CtUnit), s3, c2)\\n      } else if name == \\\"Array::get\\\" && Array::length(args) == 2 {\\n        // `Array::get(a, i)` returns the element type, but `direct_call_return`\\n        // types it CtUnknown — `let s: String = Array::get(intArr, 0)` slipped\\n        // through. Refine the result to the element type from a concrete\\n        // `CtArray(elem)` receiver (var / generic receivers stay CtUnknown).\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let result = match subst_apply(s2, obj_ty) {\\n          CtArray(elem) => elem,\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s2, c2)\\n      } else if name == \\\"Array::reverse\\\" && Array::length(args) == 1 {\\n        // Returns an array of the same element type (was CtUnknown).\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let result = match subst_apply(s1, obj_ty) {\\n          CtArray(elem) => CtArray(elem),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s1, c1)\\n      } else if name == \\\"Array::concat\\\" && Array::length(args) == 2 {\\n        // Returns an array of the receivers' element type (was CtUnknown). Refine\\n        // from the first concrete `CtArray(elem)` operand, and require the two\\n        // operands' element types to agree — `Array::concat([1], [\\\"x\\\"])` mixed\\n        // `Array[Int]` with `Array[String]` and slipped through (the result was\\n        // refined to the first operand but the second was never checked).\\n        let (a_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (b_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let a_app = subst_apply(s2, a_ty)\\n        let b_app = subst_apply(s2, b_ty)\\n        let s3 = check_two_array_elems(a_app, b_app, s2, errors, \\\"Array::concat element type mismatch\\\")\\n        let result = match a_app {\\n          CtArray(elem) => CtArray(elem),\\n          _ => match b_app {\\n            CtArray(elem) => CtArray(elem),\\n            _ => CtUnknown\\n          }\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else if name == \\\"Array::slice\\\" && Array::length(args) == 3 {\\n        // `Array::slice(a, lo, hi)` returns an array of the SAME element type,\\n        // typed CtUnknown by the builtin table (`let s: String =\\n        // Array::get(Array::slice(ints, 0, 1), 0)` slipped through). Refine to\\n        // `CtArray(elem)` from a concrete receiver.\\n        let (obj_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (_, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (_, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let result = match subst_apply(s3, obj_ty) {\\n          CtArray(elem) => CtArray(elem),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c3)\\n      } else if name == \\\"Array::fold\\\" && Array::length(args) == 3 {\\n        // `Array::fold(a, init, f)` returns the accumulator type — i.e. `init`'s\\n        // type — but was typed CtUnknown, so `let s: String = Array::fold(ints,\\n        // 0, add)` slipped through. Refine the result to the init value's type.\\n        // Also check the callback `(acc, x)` params: `acc` against `init`'s type\\n        // and `x` against the array element type (`Array::fold([1,2], 0, (acc:\\n        // String, x) -> ...)` slipped through). Ground-gated.\\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (init_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let (fn_ty, s3, c3) = check_expr(Array::get(args, 2), env, defs, s2, c2, errors, tytab)\\n        let s4 = match subst_apply(s3, fn_ty) {\\n          CtFn(ptys, _, _) => if Array::length(ptys) >= 1 {\\n            check_assignable(subst_apply(s3, Array::get(ptys, 0)), subst_apply(s3, init_ty), s3, errors, \\\"Array::fold accumulator type mismatch\\\", 0 - 1)\\n          } else {\\n            s3\\n          },\\n          _ => s3\\n        }\\n        let s5 = check_hof_param_vs_elem(subst_apply(s4, recv_ty), subst_apply(s4, fn_ty), 1, s4, errors, \\\"Array::fold element parameter type mismatch\\\")\\n        (tab_call_ty(tytab, call_off, subst_apply(s5, init_ty)), s5, c3)\\n      } else if name == \\\"Array::map\\\" && Array::length(args) == 2 {\\n        // `Array::map(a, f)` returns `Array[R]` where R is f's return type —\\n        // typed CtUnknown by the builtin table, so the mapped element type was\\n        // lost (`let s: String = Array::get(Array::map(ints, inc), 0)`). Refine\\n        // the result element to the mapping function's concrete return type; a\\n        // non-function / var f stays CtUnknown. Also check the callback's first\\n        // parameter type against the array element type — `Array::map([1,2],\\n        // (s: String) -> ...)` applied a `(String)->_` over `Array[Int]` and\\n        // slipped through. Ground-gated, so an unannotated `(x) -> ...` param\\n        // (CtVar) stays tolerant.\\n        let (recv_ty, s1, c1) = check_expr(Array::get(args, 0), env, defs, s, c, errors, tytab)\\n        let (fn_ty, s2, c2) = check_expr(Array::get(args, 1), env, defs, s1, c1, errors, tytab)\\n        let s3 = check_hof_param_vs_elem(subst_apply(s2, recv_ty), subst_apply(s2, fn_ty), 0, s2, errors, \\\"Array::map function parameter type mismatch\\\")\\n        let result = match subst_apply(s3, fn_ty) {\\n          CtFn(_, ret, _) => CtArray(ret),\\n          _ => CtUnknown\\n        }\\n        (tab_call_ty(tytab, call_off, result), s3, c2)\\n      } else {\\n        match direct_call_return(env, name) {\\n          Some(ret_ty) => {\\n            let alen = Array::length(args)\\n            let want_head = builtin_first_arg_head(name)\\n            let mut ai = 0\\n            let mut s2 = s\\n            let mut c2 = c\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              // First-argument head check for container/string builtins: the\\n              // receiver's top-level constructor must match (`Array::length(5)`\\n              // passes an Int where an Array is required). A non-concrete head\\n              // (var / generic / unknown) is tolerated.\\n              if ai == 0 && want_head != 0 {\\n                let got_head = head_kind(subst_apply(s2, at))\\n                if got_head != 0 && got_head != want_head {\\n                  Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, \\\": receiver type \\\")), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\\n                } else {\\n                  ()\\n                }\\n              } else if ai >= 1 {\\n                // Non-receiver argument head check for fixed-signature builtins\\n                // (`String::concat(\\\"a\\\", 1)`, `String::substring(s, \\\"x\\\", 2)`).\\n                let want_rest = builtin_arg_head_rest(name, ai)\\n                if want_rest != 0 {\\n                  let got_head = head_kind(subst_apply(s2, at))\\n                  if got_head != 0 && got_head != want_rest {\\n                    Array::push(errors, String::concat(String::concat(\\\"argument type mismatch for \\\", String::concat(name, String::concat(\\\" (arg \\\", String::concat(__to_string(ai), \\\"): \\\")))), String::concat(type_to_string(subst_apply(s2, at)), off_marker_len(callee_off, String::length(name)))))\\n                  } else {\\n                    ()\\n                  }\\n                } else {\\n                  ()\\n                }\\n              } else {\\n                ()\\n              }\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\\n          },\\n          None => {\\n            let (ct, s1, c1) = check_expr(EIdent(name, -1), env, defs, s, c, errors, tytab)\\n            let alen = Array::length(args)\\n            let arg_tys = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            let mut s2 = s1\\n            let mut c2 = c1\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              Array::push(arg_tys, at)\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(name, String::concat(\\\": expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))), off_marker_len(callee_off, String::length(name))))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, name, callee_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              other => {\\n                // Calling a value whose type is a concrete NON-callable scalar /\\n                // aggregate (e.g. `let x = 5; x(3)`) was previously accepted\\n                // silently. A type variable / unknown / named (generic) callee\\n                // is tolerated — it may yet resolve to a function.\\n                let not_callable = match other {\\n                  CtInt => true,\\n                  CtDouble => true,\\n                  CtBool => true,\\n                  CtString => true,\\n                  CtChar => true,\\n                  CtUnit => true,\\n                  CtBytes => true,\\n                  CtTuple(_) => true,\\n                  CtArray(_) => true,\\n                  // A constructed `Option`/enum value (`let o = Some(1); o(2)`)\\n                  // is not callable — constructors themselves are typed `CtFn`,\\n                  // so a `CtOption`/`CtEnum` callee is always a built value.\\n                  CtOption(_) => true,\\n                  CtEnum(_) => true,\\n                  _ => false\\n                }\\n                if not_callable {\\n                  Array::push(errors, String::concat(String::concat(\\\"calling a non-function value: \\\", name), off_marker_len(callee_off, String::length(name))))\\n                } else {\\n                  ()\\n                }\\n                (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n              }\\n            }\\n          }\\n        }\\n        }\\n      },\\n      EDot(obj, method, _) => {\\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\\n        let resolved = subst_apply(s1, obj_ty)\\n        let type_prefix = type_name_prefix(resolved)\\n        let qualified = String::concat(type_prefix, String::concat(\\\"::\\\", method))\\n        let direct_ret = direct_call_return(env, qualified)\\n        let method_ty = match env_lookup(env, qualified) {\\n          Some(t) => {\\n            let (ti, c2, _) = instantiate(t, c1)\\n            (ti, s1, c2)\\n          },\\n          None => match lookup_builtin(qualified) {\\n            Some(t) => (t, s1, c1),\\n            None => (CtUnknown, s1, c1)\\n          }\\n        }\\n        let (mt, s2, c2) = method_ty\\n        let all_args = prepend_expr(obj, args)\\n        let alen = Array::length(all_args)\\n        let arg_tys = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        Array::push(arg_tys, obj_ty)\\n        let mut ai = 1\\n        let mut s3 = s2\\n        let mut c3 = c2\\n        while ai < alen {\\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors, tytab)\\n          Array::push(arg_tys, at)\\n          s3 = ns\\n          c3 = nc\\n          ai = ai + 1\\n        }\\n        let applied_method_ty = match mt {\\n          CtFn(_, _, _) => mt,\\n          _ => subst_apply(s3, mt)\\n        }\\n        match applied_method_ty {\\n          CtFn(param_tys, ret, _) => {\\n            let ret_box = Array::slice([\\n              ret\\n            ], 0, 1)\\n            let call_param_tys = param_tys\\n            let plen = Array::length(param_tys)\\n            let alen2 = Array::length(arg_tys)\\n            if alen2 != plen {\\n              Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(qualified, String::concat(\\\": expected \\\", String::concat(__to_string(plen), String::concat(\\\" args, got \\\", __to_string(alen2)))))), off_marker_len(call_off, String::length(qualified))))\\n            }\\n            let s4 = unify_call_args(call_param_tys, arg_tys, s3, errors, qualified, call_off)\\n            let call_ret = Array::get(ret_box, 0)\\n            let selected_ret = match direct_ret {\\n              Some(t) => t,\\n              None => call_ret\\n            }\\n            (tab_call_ty(tytab, call_off, subst_apply(s4, selected_ret)), s4, c3)\\n          },\\n          _ => {\\n            // No method/builtin `T::method` resolved. If the receiver is a\\n            // concrete struct whose field `method` holds a FUNCTION, this is a\\n            // field-stored-function call `b.f(args)` (the receiver is NOT an\\n            // argument). Arg-check the explicit args against the field's\\n            // parameter types and use its return type — `(b.f)(\\\"s\\\")` with `f:\\n            // (Int) -> Int` was otherwise unchecked. Ground-gated via\\n            // unify_call_args; generic-struct receivers stay CtUnknown so no\\n            // over-rejection.\\n            let field_fn = match subst_apply(s3, obj_ty) {\\n              CtStruct(sname) => struct_field_type(defs, sname, method),\\n              _ => None\\n            }\\n            match field_fn {\\n              Some(CtFn(fpts, fret, _)) => {\\n                let explicit = Array::slice(arg_tys, 1, Array::length(arg_tys))\\n                if Array::length(fpts) != Array::length(explicit) {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(qualified, String::concat(\\\": expected \\\", String::concat(__to_string(Array::length(fpts)), String::concat(\\\" args, got \\\", __to_string(Array::length(explicit))))))), off_marker_len(call_off, String::length(qualified))))\\n                }\\n                let s4 = unify_call_args(fpts, explicit, s3, errors, qualified, call_off)\\n                (tab_call_ty(tytab, call_off, subst_apply(s4, fret)), s4, c3)\\n              },\\n              _ => match direct_ret {\\n                Some(t) => (tab_call_ty(tytab, call_off, t), s3, c3),\\n                None => (tab_call_ty(tytab, call_off, CtUnknown), s3, c3)\\n              }\\n            }\\n          }\\n        }\\n      },\\n      _ => {\\n        let callee_name0 = expr_ident_name_or_empty(callee)\\n        if callee_name0 != \\\"\\\" {\\n          match direct_call_return(env, callee_name0) {\\n            Some(ret_ty) => {\\n              let alen = Array::length(args)\\n              let mut ai = 0\\n              let mut s2 = s\\n              let mut c2 = c\\n              while ai < alen {\\n                let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n                s2 = ns\\n                c2 = nc\\n                ai = ai + 1\\n              }\\n              (tab_call_ty(tytab, call_off, subst_apply(s2, ret_ty)), s2, c2)\\n            },\\n            None => {\\n              let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\\n              let alen = Array::length(args)\\n              let arg_tys = Array::slice([\\n                CtUnknown\\n              ], 0, 0)\\n              let mut ai = 0\\n              let mut s2 = s1\\n              let mut c2 = c1\\n              while ai < alen {\\n                let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n                Array::push(arg_tys, at)\\n                s2 = ns\\n                c2 = nc\\n                ai = ai + 1\\n              }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for \\\", String::concat(callee_name0, String::concat(\\\": expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))), off_marker_len(call_off, String::length(callee_name0))))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, callee_name0, call_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n            }\\n            }\\n          }\\n        } else {\\n            let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors, tytab)\\n            let alen = Array::length(args)\\n            let arg_tys = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            let mut s2 = s1\\n            let mut c2 = c1\\n            while ai < alen {\\n              let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors, tytab)\\n              Array::push(arg_tys, at)\\n              s2 = ns\\n              c2 = nc\\n              ai = ai + 1\\n            }\\n            let applied_callee_ty = match ct {\\n              CtFn(_, _, _) => ct,\\n              _ => subst_apply(s2, ct)\\n            }\\n            match applied_callee_ty {\\n              CtFn(param_tys, ret, _) => {\\n                let ret_box = Array::slice([\\n                  ret\\n                ], 0, 1)\\n                let call_param_tys = param_tys\\n                let plen2 = Array::length(param_tys)\\n                let alen3 = Array::length(arg_tys)\\n                if alen3 != plen2 {\\n                  Array::push(errors, String::concat(String::concat(\\\"function arity mismatch for <expr>: expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))), off_marker(call_off)))\\n                }\\n                let s3 = unify_call_args(call_param_tys, arg_tys, s2, errors, \\\"<expr>\\\", call_off)\\n                let call_ret = Array::get(ret_box, 0)\\n                (tab_call_ty(tytab, call_off, subst_apply(s3, call_ret)), s3, c2)\\n              },\\n              CtStruct(sname) => (tab_call_ty(tytab, call_off, CtStruct(sname)), s2, c2),\\n              _ => (tab_call_ty(tytab, call_off, CtUnknown), s2, c2)\\n            }\\n        }\\n      }\\n    },\\n    EBinOp(op, left, right) => {\\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors, tytab)\\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors, tytab)\\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors, tytab)\\n      (subst_apply(s3, result_ty), s3, c2)\\n    },\\n    EUnaryOp(op, operand) => {\\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors, tytab)\\n      if op == \\\"!\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtBool => (CtBool, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\\n            Some(s2) => (CtBool, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          other => {\\n            // `!x` on a concrete non-Bool operand (`!5`) was accepted silently.\\n            // A non-ground/Unknown operand is tolerated (may resolve to Bool).\\n            let flag = match other {\\n              CtUnknown => false,\\n              _ => type_is_ground(other)\\n            }\\n            if flag {\\n              Array::push(errors, \\\"operand of `!` must be Bool\\\")\\n            } else {\\n              ()\\n            }\\n            (CtUnknown, s1, c1)\\n          }\\n        }\\n      } else if op == \\\"-\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtDouble => (CtDouble, s1, c1),\\n          CtInt => (CtInt, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\\n            Some(s2) => (CtInt, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          other => {\\n            // Unary `-` on a concrete non-numeric operand (`-\\\"hi\\\"`) was accepted\\n            // silently. A non-ground / Unknown operand is tolerated.\\n            let flag = match other {\\n              CtUnknown => false,\\n              _ => type_is_ground(other)\\n            }\\n            if flag {\\n              Array::push(errors, \\\"operand of unary `-` must be Int or Double\\\")\\n            } else {\\n              ()\\n            }\\n            (CtUnknown, s1, c1)\\n          }\\n        }\\n      } else (CtUnknown, s1, c1)\\n    },\\n    EAssign(name, val, body) => {\\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\\n      // The assigned value must be assignable to the variable's type\\n      // (previously unchecked — `y = \\\"s\\\"` for `let mut y = 1` was accepted).\\n      let s1b = match env_lookup(env, name) {\\n        Some(var_ty) => check_assignable(var_ty, subst_apply(s1, vt), s1, errors, String::concat(\\\"assignment type mismatch for \\\", name), 0 - 1),\\n        None => s1\\n      }\\n      check_expr(body, env, defs, s1b, c1, errors, tytab)\\n    },\\n    EAssignOp(_, _, val, body) => {\\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors, tytab)\\n      check_expr(body, env, defs, s1, c1, errors, tytab)\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors, tytab)\\n      let alen = Array::length(arms)\\n      if alen == 0 {\\n        (CtUnknown, s1, c1)\\n      }\\n      else {\\n        let mut result_ty = CtUnknown\\n        // Whether to cross-check arm types. Enabled only when the first arm's\\n        // type resolves to a SIMPLE scalar (Int/Double/Bool/String/Char) — that\\n        // covers the real bug (`match x { 0 => 1, _ => \\\"s\\\" }`) while skipping\\n        // the per-arm `subst_apply` for matches whose arms yield large tuple /\\n        // struct / function types (e.g. the compiler's own `(Type, Subst, Int)`\\n        // returning matches), which would otherwise balloon the self-compile\\n        // heap. CtUnknown/CtVar/aggregate first arms are left unchecked.\\n        let mut check_arms = false\\n        let mut si = s1\\n        let mut ci = c1\\n        let mut ai = 0\\n        while ai < alen {\\n          let (pat, body) = Array::get(arms, ai)\\n          let arm_env = check_pattern(pat, scr_ty, env, defs, errors)\\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors, tytab)\\n          si = ns\\n          ci = nc\\n          if ai == 0 {\\n            result_ty = arm_ty\\n            check_arms = match subst_apply(si, arm_ty) {\\n              CtInt => true,\\n              CtDouble => true,\\n              CtBool => true,\\n              CtString => true,\\n              CtChar => true,\\n              _ => false\\n            }\\n          } else {\\n            if check_arms {\\n              // Tolerate a `CtUnit` arm (statement-position match); rely on\\n              // check_assignable's ground/ground gate otherwise. Also tolerate a\\n              // DIVERGING arm whose body is an early `return` (#635): `val?`\\n              // lowers to `match val { Some(v) => v, None => return None }` — the\\n              // `return` arm yields no value to the match, so it must not force\\n              // the match's result type (it would clash `T` vs `Option[T]`).\\n              let r2 = subst_apply(si, arm_ty)\\n              si = if arm_body_diverges(body) {\\n                si\\n              } else {\\n                match r2 {\\n                  CtUnit => si,\\n                  _ => check_assignable(result_ty, r2, si, errors, \\\"match arms have incompatible types\\\", 0 - 1)\\n                }\\n              }\\n            } else {\\n              ()\\n            }\\n          }\\n          ai = ai + 1\\n        }\\n        // Exhaustiveness: when the scrutinee is a concrete user enum, the arms\\n        // must either include a catch-all (`_` / bind) or cover EVERY variant —\\n        // otherwise an unhandled variant traps at runtime. Conservative: only a\\n        // concrete enum whose definition is known is checked; anything else\\n        // (builtin Option/bool, type vars, non-enum) is left alone.\\n        let enum_name_opt = match subst_apply(si, scr_ty) {\\n          CtEnum(en) => Some(en),\\n          CtNamed(en, _) => Some(en),\\n          _ => None\\n        }\\n        match enum_name_opt {\\n          Some(en) => match find_typedef(defs, en) {\\n            Some(TDEnum(_, _, variants)) => {\\n              let mut has_catchall = false\\n              let covered = Array::slice([\\n                \\\"\\\"\\n              ], 0, 0)\\n              let mut ax = 0\\n              while ax < Array::length(arms) {\\n                let (apat, _) = Array::get(arms, ax)\\n                if pat_is_catchall(apat) {\\n                  has_catchall = true\\n                } else {\\n                  ()\\n                }\\n                collect_ctor_names_into(apat, covered)\\n                ax = ax + 1\\n              }\\n              if has_catchall {\\n                ()\\n              } else {\\n                let mut vi = 0\\n                while vi < Array::length(variants) {\\n                  let (vname, _) = Array::get(variants, vi)\\n                  let mut found = false\\n                  let mut ci2 = 0\\n                  while ci2 < Array::length(covered) {\\n                    if Array::get(covered, ci2) == vname {\\n                      found = true\\n                    } else {\\n                      ()\\n                    }\\n                    ci2 = ci2 + 1\\n                  }\\n                  if found {\\n                    ()\\n                  } else {\\n                    Array::push(errors, String::concat(\\\"non-exhaustive match: variant `\\\", String::concat(vname, String::concat(\\\"` of enum \\\", String::concat(en, \\\" is not handled (add it or a `_` arm)\\\")))))\\n                  }\\n                  vi = vi + 1\\n                }\\n              }\\n            },\\n            _ => ()\\n          },\\n          None => ()\\n        }\\n        (result_ty, si, ci)\\n      }\\n    },\\n    EHandle(body, _) => check_expr(body, env, defs, s, c, errors, tytab),\\n    EWhile(cond, body) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors, tytab)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"while condition must be Bool\\\")\\n      }\\n      let (_, s2, c2) = check_expr(body, env_bind(env, \\\"__in_loop__\\\", CtUnit), defs, s1, c1, errors, tytab)\\n      (CtUnit, s2, c2)\\n    },\\n    ELoop(params, body) => {\\n      let mut env1 = env\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, init) = Array::get(params, i)\\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors, tytab)\\n        env1 = env_bind(env1, name, pt)\\n        s1 = ns\\n        c1 = nc\\n        i = i + 1\\n      }\\n      let (_, s2, c2) = check_expr(body, env_bind(env1, \\\"__in_loop__\\\", CtUnit), defs, s1, c1, errors, tytab)\\n      (CtUnit, s2, c2)\\n    },\\n    EForIn(name, index_name, iterable, body) => {\\n      // `for await x in s` reaches the checker as `for x in __await_iter(s)`\\n      // (the parser's marker; the dict-passing desugar strips it for codegen).\\n      // The marker is not a real function, so check the inner iterable directly.\\n      let real_iterable = match iterable {\\n        ECall(callee, args, _) => match callee {\\n          EIdent(nm, _) => if nm == \\\"__await_iter\\\" && Array::length(args) == 1 {\\n            Array::get(args, 0)\\n          } else iterable,\\n          _ => iterable\\n        },\\n        _ => iterable\\n      }\\n      let (it, s1, c1) = check_expr(real_iterable, env, defs, s, c, errors, tytab)\\n      // Element type bound by `for x in it`:\\n      //   - `Array[T]`                       -> T\\n      //   - a parameterized iterator type\\n      //     `C[T, ..]` (`LazyIter[T]`, async `Stream[T]`, `for await`'s\\n      //     desugared iterator, …) -> its FIRST type argument `T`. By the\\n      //     iterator convention `next(Self) -> Option[(T, Self)]` the element is\\n      //     the struct's first type parameter, so it is recoverable from the\\n      //     iterable's type alone — which matters across modules, where the\\n      //     `impl Iterator for C` lives in a dependency and is not in this file's\\n      //     import env (the dict-passing desugar drives codegen off the merged\\n      //     sources separately). Only `for` loops over a real iterable reach\\n      //     codegen, so a non-iterator never lands here in a valid program.\\n      //   - an iterator type with NO type argument (a bare struct value, or\\n      //     `Stream` in the eager Array-backed model, docs/spec §M2c-3) -> a\\n      //     fresh unification var, so the loop body's usage constrains the\\n      //     element instead of `CtUnknown` silently accepting any element use and\\n      //     dropping element-type safety.\\n      let it_resolved = subst_apply(s1, it)\\n      let (et, c1b) = match it_resolved {\\n        CtArray(elem) => (elem, c1),\\n        CtNamed(nm, args) => if Array::length(args) > 0 {\\n          (Array::get(args, 0), c1)\\n        } else if nm == \\\"Stream\\\" || type_name_has_iterator_impl(env, nm) {\\n          fresh_var(c1)\\n        } else (CtUnknown, c1),\\n        CtStruct(nm) => if type_name_has_iterator_impl(env, nm) {\\n          fresh_var(c1)\\n        } else (CtUnknown, c1),\\n        other => {\\n          // `for x in 5` over a primitive scalar can never be an iterable and\\n          // was accepted silently. Only flag the unambiguously non-iterable\\n          // primitives — a struct/named type may have an Iterator impl in\\n          // another module (see above), so those stay tolerated.\\n          let flag = match other {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtUnit => true,\\n            CtChar => true,\\n            _ => false\\n          }\\n          if flag {\\n            Array::push(errors, \\\"for loop requires an iterable (Array or iterator)\\\")\\n          } else {\\n            ()\\n          }\\n          (CtUnknown, c1)\\n        }\\n      }\\n      let env2 = env_bind(env, name, et)\\n      let env3 = match index_name {\\n        Some(index_name) => env_bind(env2, index_name, CtInt),\\n        None => env2\\n      }\\n      let (bt, s2, c2) = check_expr(body, env_bind(env3, \\\"__in_loop__\\\", CtUnit), defs, s1, c1b, errors, tytab)\\n      (CtArray(bt), s2, c2)\\n    },\\n    EDot(obj, field, dot_off) => {\\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors, tytab)\\n      let resolved = subst_apply(s1, obj_ty)\\n      let field_ty = match resolved {\\n        CtStruct(sname) => match find_typedef(defs, sname) {\\n          Some(td) => match td {\\n            TDStruct(_, fields, _) => {\\n              let rec find_field: (Int) -> Option[Type] = (i) -> {\\n                if i >= Array::length(fields) {\\n                  None\\n                } else {\\n                  let (fname, ftype) = Array::get(fields, i)\\n                  if fname == field {\\n                    Some(ftype)\\n                  } else find_field(i + 1)\\n                }\\n              }\\n              match find_field(0) {\\n                Some(ft) => ft,\\n                None => {\\n                  Array::push(errors, String::concat(String::concat(\\\"unknown field '\\\", String::concat(field, String::concat(\\\"' on struct \\\", sname))), off_marker(dot_off)))\\n                  CtUnknown\\n                }\\n              }\\n            },\\n            _ => CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        // `t.N` tuple projection: the index must be in range, else it reads an\\n        // out-of-bounds slot (`(1, 2).5` was accepted). When `field` is a\\n        // numeric index and the tuple arity is known, bounds-check it.\\n        CtTuple(elems) => match parse_tuple_index(field) {\\n          Some(idx) => if idx >= 0 && idx < Array::length(elems) {\\n            Array::get(elems, idx)\\n          } else {\\n            Array::push(errors, String::concat(String::concat(\\\"tuple index \\\", String::concat(field, String::concat(\\\" out of range for a \\\", String::concat(__to_string(Array::length(elems)), \\\"-tuple\\\")))), off_marker(dot_off)))\\n            CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        // Field access on a concrete NON-struct value (`o.x` where `o :\\n        // Option[P]`, or a scalar / function) is a type error — only structs\\n        // (and tuple `.N`) have fields. Type vars / unknown / named scrutinees\\n        // are tolerated; CtString/CtBytes/CtArray are NOT flagged because `.m`\\n        // on them parses as a method call elsewhere, not a value-position EDot.\\n        other => {\\n          let not_struct = match other {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtChar => true,\\n            CtUnit => true,\\n            CtOption(_) => true,\\n            CtFn(_, _, _) => true,\\n            _ => false\\n          }\\n          if not_struct {\\n            Array::push(errors, String::concat(String::concat(\\\"field access `.\\\", String::concat(field, \\\"` on a non-struct value\\\")), off_marker(dot_off)))\\n          } else {\\n            ()\\n          }\\n          CtUnknown\\n        }\\n      }\\n      // Record this field-access node's (raw, pre-final-subst) projection type\\n      // keyed by its real source offset, for typed-hover on `obj.field`.\\n      // Synthetic accesses (dot_off < 0) are skipped.\\n      if dot_off >= 0 {\\n        Array::push(tytab, (dot_off, field_ty))\\n      } else {\\n        ()\\n      }\\n      (field_ty, s1, c1)\\n    },\\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\\n      let tplen = Array::length(tparams)\\n      let mut tp_env = env\\n      let mut s0 = s\\n      let mut c0 = c\\n      let mut tpi = 0\\n      while tpi < tplen {\\n        let tpname = Array::get(tparams, tpi)\\n        match fresh_var(c0) {\\n          (tv, nc) => {\\n            let vid = nc - 1\\n            let tblen = Array::length(tbounds)\\n            let mut bounds = Array::slice([\\n              \\\"\\\"\\n            ], 0, 0)\\n            let mut tbi = 0\\n            let mut found_bounds = false\\n            while tbi < tblen {\\n              let (bname, blist) = Array::get(tbounds, tbi)\\n              if !found_bounds && bname == tpname {\\n                bounds = blist\\n                found_bounds = true\\n              }\\n              tbi = tbi + 1\\n            }\\n            s0 = if Array::length(bounds) == 0 {\\n              s0\\n            } else subst_add_bound(s0, vid, bounds)\\n            tp_env = env_bind(tp_env, tpname, tv)\\n            c0 = nc\\n          },\\n          _ => ()\\n        }\\n        tpi = tpi + 1\\n      }\\n      let plen = Array::length(params)\\n      let mut fn_env = tp_env\\n      let mut s1 = s0\\n      let mut c1 = c0\\n      let param_types = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut pi = 0\\n      while pi < plen {\\n        let (raw_name, ann) = Array::get(params, pi)\\n        let nlen = String::length(raw_name)\\n        let name = if nlen > 0 {\\n          let lc = String::char_code_at(raw_name, nlen - 1)\\n          if lc == '~' || lc == '?' {\\n            raw_name[0: nlen - 1]\\n          } else raw_name\\n        } else raw_name\\n        let (pt, ns, nc) = match ann {\\n          Some(te) => {\\n            let resolved = resolve_type_expr(te, defs)\\n            let pt2 = resolve_tparams_in(resolved, fn_env)\\n            (pt2, s1, c1)\\n          },\\n          None => {\\n            let (tv, nc2) = fresh_var(c1)\\n            (tv, s1, nc2)\\n          }\\n        }\\n        fn_env = env_bind(fn_env, name, pt)\\n        Array::push(param_types, pt)\\n        s1 = ns\\n        c1 = nc\\n        pi = pi + 1\\n      }\\n      // Bind the function's annotated return type under a sentinel so an\\n      // explicit `return e` inside the body can be checked against it (the body\\n      // value is checked below, but `return` short-circuits and was otherwise\\n      // unchecked — `() -> Int { return \\\"x\\\" }` was accepted). Nested functions\\n      // rebind the sentinel, so `return` always targets the nearest enclosing\\n      // function's type.\\n      let body_env = match ret_ty {\\n        Some(rte) => env_bind(fn_env, \\\"__return__\\\", resolve_tparams_in(resolve_type_expr(rte, defs), fn_env)),\\n        None => fn_env\\n      }\\n      let (bt, s2, c2) = check_expr(body, body_env, defs, s1, c1, errors, tytab)\\n      let (final_ret, s3) = match ret_ty {\\n        Some(te) => {\\n          let resolved = resolve_type_expr(te, defs)\\n          let resolved_ret = resolve_tparams_in(resolved, fn_env)\\n          match unify(bt, resolved_ret, s2) {\\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\\n            None => {\\n              Array::push(errors, String::concat(\\\"return type mismatch: expected \\\", String::concat(type_to_string(resolved_ret), String::concat(\\\", got \\\", type_to_string(bt)))))\\n              (CtUnknown, s2)\\n            }\\n          }\\n        },\\n        None => (subst_apply(s2, bt), s2)\\n      }\\n      (CtFn(param_types, final_ret, effect), s3, c2)\\n    },\\n    EBreak(opt) => {\\n      // `break` is only meaningful inside a loop. Loop bodies bind the\\n      // `__in_loop__` sentinel; its absence means this `break` is outside any\\n      // loop (`() -> { break }`). Threaded through env, so if/match/let/seq\\n      // inside a loop still see it; a nested function does not introduce one, so\\n      // a `break` there is (conservatively) left unchecked rather than flagged.\\n      match env_lookup(env, \\\"__in_loop__\\\") {\\n        Some(_) => (),\\n        None => Array::push(errors, \\\"`break` outside a loop\\\")\\n      }\\n      match opt {\\n        Some(e) => {\\n          let (_, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\\n          (CtUnit, s1, c1)\\n        },\\n        None => (CtUnit, s, c)\\n      }\\n    },\\n    EContinue(args) => {\\n      match env_lookup(env, \\\"__in_loop__\\\") {\\n        Some(_) => (),\\n        None => Array::push(errors, \\\"`continue` outside a loop\\\")\\n      }\\n      let alen = Array::length(args)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut ai = 0\\n      while ai < alen {\\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        ai = ai + 1\\n      }\\n      (CtUnit, s1, c1)\\n    },\\n    ERecord(fields) => {\\n      let flen = Array::length(fields)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let field_tys = Array::slice([\\n        (\\\"\\\", CtUnknown)\\n      ], 0, 0)\\n      let mut fi = 0\\n      while fi < flen {\\n        let (fname, fval) = Array::get(fields, fi)\\n        // A field may be given only once in a record literal (`P::{ x: 1, x: 2 }`\\n        // silently kept the last). Report a duplicate by scanning the names\\n        // already collected.\\n        let mut dj = 0\\n        let mut dup = false\\n        while dj < Array::length(field_tys) {\\n          let (pn, _) = Array::get(field_tys, dj)\\n          if pn == fname {\\n            dup = true\\n          } else {\\n            ()\\n          }\\n          dj = dj + 1\\n        }\\n        if dup {\\n          Array::push(errors, String::concat(\\\"duplicate field `\\\", String::concat(fname, \\\"` in record literal\\\")))\\n        } else {\\n          ()\\n        }\\n        let (ft, ns, nc) = check_expr(fval, env, defs, s1, c1, errors, tytab)\\n        Array::push(field_tys, (fname, ft))\\n        s1 = ns\\n        c1 = nc\\n        fi = fi + 1\\n      }\\n      // Check the field values against the matching struct's declared types.\\n      let s2 = check_record_fields(defs, field_tys, s1, errors)\\n      // Recover the struct identity (when unambiguous) so downstream uses — in\\n      // particular `mut`-field write checking — see a concrete `CtStruct`.\\n      let rec_ty = match resolve_record_struct_name(defs, field_tys) {\\n        Some(sname) => CtStruct(sname),\\n        None => CtUnknown\\n      }\\n      (rec_ty, s2, c1)\\n    },\\n    ETuple(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let tys = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut ti = 0\\n      while ti < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors, tytab)\\n        Array::push(tys, it)\\n        s1 = ns\\n        c1 = nc\\n        ti = ti + 1\\n      }\\n      (CtTuple(tys), s1, c1)\\n    },\\n    EArray(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut elem_ty = CtUnknown\\n      // Cross-check elements only when the first element is a simple scalar, or\\n      // a one-level array of scalars (`[[1], [\\\"x\\\"]]` — `Array[Int]` vs\\n      // `Array[String]`) — see EMatch: this catches the cheap, bounded cases\\n      // while skipping the per-element `subst_apply` for arrays of large\\n      // struct/tuple values that pressure the self-compile heap.\\n      let mut check_elems = false\\n      let mut ai = 0\\n      while ai < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors, tytab)\\n        s1 = ns\\n        c1 = nc\\n        if ai == 0 {\\n          elem_ty = it\\n          check_elems = match subst_apply(s1, it) {\\n            CtInt => true,\\n            CtDouble => true,\\n            CtBool => true,\\n            CtString => true,\\n            CtChar => true,\\n            CtArray(inner) => match inner {\\n              CtInt => true,\\n              CtDouble => true,\\n              CtBool => true,\\n              CtString => true,\\n              CtChar => true,\\n              _ => false\\n            },\\n            _ => false\\n          }\\n        } else {\\n          if check_elems {\\n            s1 = check_assignable(elem_ty, subst_apply(s1, it), s1, errors, \\\"array elements have incompatible types\\\", 0 - 1)\\n          } else {\\n            ()\\n          }\\n        }\\n        ai = ai + 1\\n      }\\n      (CtArray(elem_ty), s1, c1)\\n    },\\n    EReturn(e) => {\\n      let (et, s1, c1) = check_expr(e, env, defs, s, c, errors, tytab)\\n      // Check the returned value against the enclosing function's annotated\\n      // return type (bound as `__return__` by the EFn arm). Ground-gated via\\n      // check_assignable, so a generic return type is not over-rejected.\\n      match env_lookup(env, \\\"__return__\\\") {\\n        Some(rt) => {\\n          let _ = check_assignable(subst_apply(s1, rt), subst_apply(s1, et), s1, errors, \\\"return type mismatch\\\", 0 - 1)\\n          ()\\n        },\\n        None => ()\\n      }\\n      // The expression value of `return e` is `e`'s type, not CtUnknown. A lambda\\n      // whose body is a bare `return e` (`(n) -> { return n }`) otherwise inferred\\n      // a CtUnknown return type, so when its type came from OUTER unification\\n      // (`let g: (Int) -> String = (n) -> { return n }`) the return/result\\n      // mismatch was hidden — the no-`return` form `(n) -> { n }` is rejected, so\\n      // the `return` form must be too. Propagating `et` makes them identical.\\n      (et, s1, c1)\\n    },\\n    _ => (CtUnknown, s, c)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_42 = () -> (String, String) {\n  (\"vibe/compiler/checker/checker_stmt.vibe\",\n\"//# Imports\\n\\nimport .. / checker_trait.vibe {\\n  register_builtin_traits\\n}\\n\\nimport .. / checker_effects.vibe {\\n  check_async_effects_stmts, check_mutability_stmts, check_perform_effects_stmts, effect_error_to_string\\n}\\n\\nimport .. / core / ast.vibe {\\n  Expr, Stmt, TypeExpr\\n}\\n\\nimport .. / core / types.vibe {\\n  Subst, Type, TypeDef, TypeEnv, collect_subst_bounds_pairs, env_bind, env_cache, env_flat_bindings, env_lookup_flat, generalize, resolve_builtin, subst_apply, trait_defined, type_implements_trait, type_to_string\\n}\\n\\nimport ./checker.vibe {\\n  check_assignable, check_expr, fn_return_env_name\\n}\\n\\nimport ./checker_resolve.vibe {\\n  resolve_type_expr, subst_type_params\\n}\\n\\nimport .. / desugar_trait_dict.vibe {\\n  desugar_railway_binds, inject_trait_method_generics\\n}\\n\\n//# Functions\\n\\nlet rec import_cache_lookup: (Array[(String, Type)], String, Int) -> Option[Type] = (cache, name, i) -> {\\n  if i >= Array::length(cache) {\\n    None\\n  }\\n  else {\\n    let (cached_name, cached_ty) = Array::get(cache, i)\\n    if cached_name == name {\\n      Some(cached_ty)\\n    }\\n    else import_cache_lookup(cache, name, i + 1)\\n  }\\n}\\n\\nlet bind_stmt_imports: (TypeEnv, Array[(String, Option[String])]) -> TypeEnv = (env, names) -> {\\n  let env_bindings = env_flat_bindings(env)\\n  let import_cache = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let nlen = Array::length(names)\\n  let mut i = 0\\n  let mut acc = env\\n  while i < nlen {\\n    let (name, alias) = Array::get(names, i)\\n    let bound_name = match alias {\\n      Some(a) => a,\\n      None => name\\n    }\\n    let ty = match import_cache_lookup(import_cache, name, 0) {\\n      Some(t) => t,\\n      None => {\\n        let resolved = match env_lookup_flat(env_bindings, name) {\\n          Some(t) => t,\\n          None => CtUnknown\\n        }\\n        Array::push(import_cache, (name, resolved))\\n        resolved\\n      }\\n    }\\n    let acc_with_name = env_bind(acc, bound_name, ty)\\n    acc = match env_lookup_flat(env_bindings, fn_return_env_name(name)) {\\n      Some(ret_ty) => env_bind(acc_with_name, fn_return_env_name(bound_name), ret_ty),\\n      None => acc_with_name\\n    }\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet annotation_return_type: (Option[TypeExpr], Array[TypeDef]) -> Option[Type] = (ann, defs) -> {\\n  match ann {\\n    Some(te) => match te {\\n      TyFn(params, ret, _) => {\\n        let ret_box = Array::slice([\\n          ret\\n        ], 0, 1)\\n        let _ = Array::length(params)\\n        Some(resolve_type_expr(Array::get(ret_box, 0), defs))\\n      },\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet fn_expr_return_type: (Expr, Array[TypeDef]) -> Option[Type] = (expr, defs) -> {\\n  match expr {\\n    EFn(_, _, _, ret_ty, _, _) => match ret_ty {\\n      Some(te) => Some(resolve_type_expr(te, defs)),\\n      None => None\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet bind_fn_return: (TypeEnv, String, Type) -> TypeEnv = (env, name, ret_ty) -> {\\n  env_bind(env, fn_return_env_name(name), ret_ty)\\n}\\n\\nlet bind_annotation_return: (TypeEnv, String, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, ann, defs) -> {\\n  match annotation_return_type(ann, defs) {\\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\\n    None => env\\n  }\\n}\\n\\nlet bind_value_or_annotation_return: (TypeEnv, String, Expr, Option[TypeExpr], Array[TypeDef]) -> TypeEnv = (env, name, val, ann, defs) -> {\\n  match fn_expr_return_type(val, defs) {\\n    Some(ret_ty) => bind_fn_return(env, name, ret_ty),\\n    None => bind_annotation_return(env, name, ann, defs)\\n  }\\n}\\n\\nlet struct_derives_has: (Array[String], String) -> Bool = (derives, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(derives) {\\n    if Array::get(derives, i) == name {\\n      found = true\\n      i = Array::length(derives)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\n// The derivable traits the structural `derive(...)` desugar understands. Any\\n// other name in a `derive(...)` clause is rejected with `unknown trait: <name>`\\n// (#638) so a typo / unsupported trait fails the compile instead of silently\\n// generating nothing.\\nlet derive_name_is_known: (String) -> Bool = (name) -> {\\n  name == \\\"Eq\\\" || name == \\\"Ord\\\" || name == \\\"Show\\\" || name == \\\"Hash\\\" || name == \\\"Default\\\"\\n}\\n\\nlet validate_derives: (Array[String], Array[String]) -> Unit = (derives, errors) -> {\\n  let mut i = 0\\n  while i < Array::length(derives) {\\n    let name = Array::get(derives, i)\\n    if name != \\\"\\\" && !derive_name_is_known(name) {\\n      Array::push(errors, String::concat(\\\"unknown trait: \\\", name))\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nlet stmt_is_type_decl: (Stmt) -> Bool = (stmt) -> {\\n  match stmt {\\n    SEnum(_, _, _, _, _) => true,\\n    SSuberror(_, _, _) => true,\\n    SStruct(_, _, _, _, _) => true,\\n    STypeAlias(_, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\n// #613: process type declarations (enum / struct / type-alias / suberror) before\\n// value definitions so a `let` may construct or reference a type or constructor\\n// declared LATER in the same statement list (a forward reference). check_stmts\\n// records each type into `defs` and binds its constructors into `env` only when\\n// the declaration statement is reached, so without this a value defined before\\n// its enum saw neither the type nor its constructors and aborted the compile\\n// with an opaque trap (e.g. an imported module whose function constructs an enum\\n// value lands before the enum in the merged statement list). Codegen is already\\n// order-independent (the ctor table scans every statement up front), so this\\n// check-side reorder is sufficient. The partition is STABLE, so already-ordered\\n// (type-before-value) code is processed exactly as before, and relative order\\n// within each group is preserved.\\nlet reorder_type_decls_first: (Array[Stmt], Int) -> Array[Stmt] = (stmts, start) -> {\\n  let out = Array::slice(stmts, 0, start)\\n  let n = Array::length(stmts)\\n  let mut i = start\\n  while i < n {\\n    let st = Array::get(stmts, i)\\n    if stmt_is_type_decl(st) {\\n      Array::push(out, st)\\n    }\\n    i = i + 1\\n  }\\n  let mut j = start\\n  while j < n {\\n    let st = Array::get(stmts, j)\\n    if !stmt_is_type_decl(st) {\\n      Array::push(out, st)\\n    }\\n    j = j + 1\\n  }\\n  out\\n}\\n\\nexport let rec check_stmts: (Array[Stmt], Int, TypeEnv, Array[TypeDef], Subst, Int, Array[String], Array[(Int, Type)]) -> (TypeEnv, Subst, Int) = (raw_stmts, i, env, defs, s, c, errors, tytab) -> {\\n  let stmts = reorder_type_decls_first(raw_stmts, i)\\n  let mut idx = i\\n  let mut cur_env = env\\n  let mut cur_s = s\\n  let mut cur_c = c\\n  // #602: hoist top-level binding signatures so a `let` may reference another\\n  // top-level `let` defined later in the same statement list (a forward\\n  // reference). Without this, checking the earlier binding's body raised\\n  // \\\"unknown name\\\" and aborted the whole compile with an opaque trap.\\n  // check_stmts is only used for program / module statement lists — local\\n  // `let`s are ELet expressions checked in check_expr — so this does not affect\\n  // block scoping. An annotated binding hoists its declared type; an\\n  // un-annotated one hoists as CtUnknown (its precise type is filled in when its\\n  // own statement is reached, which shadows this pre-binding). Pre-binding only\\n  // adds names, and a later real binding shadows it, so ordered\\n  // (backward-reference) code is checked exactly as before.\\n  let mut hoist_i = idx\\n  while hoist_i < Array::length(stmts) {\\n    match Array::get(stmts, hoist_i) {\\n      SLet(_, _, hname, hann, _) => {\\n        let ht = match hann {\\n          Some(hte) => resolve_type_expr(hte, defs),\\n          None => CtUnknown\\n        }\\n        cur_env = env_bind(cur_env, hname, ht)\\n      },\\n      _ => ()\\n    }\\n    hoist_i = hoist_i + 1\\n  }\\n  while idx < Array::length(stmts) {\\n    let env = cur_env\\n    let s = cur_s\\n    let c = cur_c\\n    let stmt = Array::get(stmts, idx)\\n    let (new_env, s1, c1) = match stmt {\\n      SLet(_, is_rec, name, ann, val) => {\\n        let (vt, ns0, nc) = if is_rec {\\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors, tytab)\\n        } else {\\n          check_expr(val, env, defs, s, c, errors, tytab)\\n        }\\n        // The value must be assignable to a declared annotation (previously\\n        // unchecked — `let x: Int = \\\"s\\\"` was accepted).\\n        let ns = match ann {\\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\\\"binding type mismatch for \\\", name), 0 - 1),\\n          None => ns0\\n        }\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => generalize(ns, vt)\\n        }\\n        let env1 = env_bind(env, name, t)\\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\\n      },\\n      SLetMut(name, ann, val) => {\\n        let (vt, ns0, nc) = check_expr(val, env, defs, s, c, errors, tytab)\\n        let ns = match ann {\\n          Some(te) => check_assignable(resolve_type_expr(te, defs), subst_apply(ns0, vt), ns0, errors, String::concat(\\\"binding type mismatch for \\\", name), 0 - 1),\\n          None => ns0\\n        }\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => vt\\n        }\\n        let env1 = env_bind(env, name, t)\\n        (bind_value_or_annotation_return(env1, name, val, ann, defs), ns, nc)\\n      },\\n      SLetPat(pat, val) => {\\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors, tytab)\\n        let new_env = match pat {\\n          PTuple(pats) => match vt {\\n            CtTuple(types) => {\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => if pi < Array::length(types) {\\n                    e = env_bind(e, name, Array::get(types, pi))\\n                  } else {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            },\\n            _ => {\\n              // A tuple pattern can only destructure a tuple value. `let (a, b) =\\n              // 5` was accepted and bound `a`/`b` to garbage. When the value\\n              // resolves to a concrete NON-tuple type (a scalar, array, option,\\n              // fn, struct, enum), this is a real error. Type vars / unknown /\\n              // named (generic) values stay tolerated.\\n              let concrete_non_tuple = match subst_apply(ns, vt) {\\n                CtInt => true,\\n                CtDouble => true,\\n                CtBool => true,\\n                CtString => true,\\n                CtChar => true,\\n                CtUnit => true,\\n                CtBytes => true,\\n                CtArray(_) => true,\\n                CtOption(_) => true,\\n                CtFn(_, _, _) => true,\\n                CtStruct(_) => true,\\n                CtEnum(_) => true,\\n                _ => false\\n              }\\n              if concrete_non_tuple {\\n                Array::push(errors, \\\"tuple pattern cannot destructure a non-tuple value\\\")\\n              } else {\\n                ()\\n              }\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            }\\n          },\\n          PBind(name) => env_bind(env, name, vt),\\n          PStruct(_, fields) => {\\n            let mut e = env\\n            let mut fi = 0\\n            while fi < Array::length(fields) {\\n              let (_, fpat) = Array::get(fields, fi)\\n              match fpat {\\n                PBind(name) => {\\n                  e = env_bind(e, name, CtUnknown)\\n                },\\n                _ => ()\\n              }\\n              fi = fi + 1\\n            }\\n            e\\n          },\\n          _ => env\\n        }\\n        (new_env, ns, nc)\\n      },\\n      SEnum(_, name, params, variants, enum_derives) => {\\n        validate_derives(enum_derives, errors)\\n        let param_len = Array::length(params)\\n        let param_var_ids = Array::slice([\\n          0\\n        ], 0, 0)\\n        let param_var_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut pi = 0\\n        while pi < param_len {\\n          let vid = c + pi\\n          Array::push(param_var_ids, vid)\\n          Array::push(param_var_types, CtVar(vid))\\n          pi = pi + 1\\n        }\\n        let ctor_result_type = if param_len == 0 {\\n          CtEnum(name)\\n        } else {\\n          CtNamed(name, param_var_types)\\n        }\\n        let ctor_bounds = Array::slice([\\n          (0, Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        ], 0, 0)\\n        let resolved_variants = Array::slice([\\n          (\\\"\\\", Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        ], 0, 0)\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, vi)\\n          let resolved_vtypes = Array::slice([\\n            CtUnknown\\n          ], 0, 0)\\n          let mut ti = 0\\n          while ti < Array::length(vtypes) {\\n            let vt = subst_type_params(resolve_type_expr(Array::get(vtypes, ti), defs), params, param_var_types)\\n            Array::push(resolved_vtypes, vt)\\n            ti = ti + 1\\n          }\\n          Array::push(resolved_variants, (vname, resolved_vtypes))\\n          vi = vi + 1\\n        }\\n        Array::push(defs, TDEnum(name, params, resolved_variants))\\n        let mut env1 = env_bind(env, name, CtEnum(name))\\n        let mut ci2 = 0\\n        while ci2 < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, ci2)\\n          let ctor_ty = if Array::length(vtypes) == 0 {\\n            ctor_result_type\\n          } else {\\n            let resolved_args = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            while ai < Array::length(vtypes) {\\n              let arg_ty = subst_type_params(resolve_type_expr(Array::get(vtypes, ai), defs), params, param_var_types)\\n              Array::push(resolved_args, arg_ty)\\n              ai = ai + 1\\n            }\\n            CtFn(resolved_args, ctor_result_type, None)\\n          }\\n          let exported_ctor_ty = if param_len == 0 {\\n            ctor_ty\\n          } else {\\n            CtForAll(param_var_ids, ctor_bounds, ctor_ty)\\n          }\\n          env1 = env_bind(env1, vname, exported_ctor_ty)\\n          match ctor_ty {\\n            CtFn(_, ret, _) => {\\n              let exported_ret_ty = if param_len == 0 {\\n                ret\\n              } else {\\n                CtForAll(param_var_ids, ctor_bounds, ret)\\n              }\\n              env1 = bind_fn_return(env1, vname, exported_ret_ty)\\n            },\\n            _ => ()\\n          }\\n          ci2 = ci2 + 1\\n        }\\n        // #672: pre-bind the generated structural `E::equals` (every enum gets\\n        // one) so `==` dispatch call sites resolve at check time.\\n        let env_eq = env_bind(env1, String::concat(name, \\\"::equals\\\"), CtFn([\\n          ctor_result_type,\\n          ctor_result_type\\n        ], CtBool, None))\\n        // #638: pre-bind the signatures the enum-derive desugar will generate, so\\n        // `E::compare` / `E::to_string` / `E::default` resolve at check time (the\\n        // FS-compile path checks before the codegen-time desugar runs).\\n        let env_ord = if struct_derives_has(enum_derives, \\\"Ord\\\") {\\n          env_bind(env_eq, String::concat(name, \\\"::compare\\\"), CtFn([\\n            ctor_result_type,\\n            ctor_result_type\\n          ], CtInt, None))\\n        } else {\\n          env_eq\\n        }\\n        let env_show = if struct_derives_has(enum_derives, \\\"Show\\\") || struct_derives_has(enum_derives, \\\"Hash\\\") {\\n          env_bind(env_ord, String::concat(name, \\\"::to_string\\\"), CtFn([\\n            ctor_result_type\\n          ], CtString, None))\\n        } else {\\n          env_ord\\n        }\\n        // #694: `derive(Hash)` generates `E::hash_key(Self) -> String` (the\\n        // structural Map key), so pre-bind its signature at check time too, AND\\n        // register `impl Hash for E` so a `[K: Hash]` bound is satisfied by the\\n        // derived enum.\\n        let env_hash = if struct_derives_has(enum_derives, \\\"Hash\\\") {\\n          let env_h = EnvTraitImpl(\\\"Hash\\\", ctor_result_type, env_show)\\n          env_bind(env_h, String::concat(name, \\\"::hash_key\\\"), CtFn([\\n            ctor_result_type\\n          ], CtString, None))\\n        } else {\\n          env_show\\n        }\\n        let env_default = if struct_derives_has(enum_derives, \\\"Default\\\") {\\n          env_bind(env_hash, String::concat(name, \\\"::default\\\"), CtFn(Array::slice([\\n            CtUnit\\n          ], 0, 0), ctor_result_type, None))\\n        } else {\\n          env_hash\\n        }\\n        (env_default, s, c + param_len)\\n      },\\n      SStruct(_, name, field_defs, derives, mut_fields) => {\\n        validate_derives(derives, errors)\\n        let resolved_fields = Array::slice([\\n          (\\\"\\\", CtUnit)\\n        ], 0, 0)\\n        let mut fi = 0\\n        while fi < Array::length(field_defs) {\\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\\n          let ftype = resolve_type_expr(ftype_expr, defs)\\n          Array::push(resolved_fields, (fname, ftype))\\n          fi = fi + 1\\n        }\\n        Array::push(defs, TDStruct(name, resolved_fields, mut_fields))\\n        let field_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut fj = 0\\n        while fj < Array::length(resolved_fields) {\\n          let (_, fty) = Array::get(resolved_fields, fj)\\n          Array::push(field_types, fty)\\n          fj = fj + 1\\n        }\\n        let env1 = env_bind(env, name, CtFn(field_types, CtStruct(name), None))\\n        // #638: pre-bind the signatures of the structural functions that the\\n        // derive desugar will generate, so `Type::compare` / `Type::to_string`\\n        // resolve at check time (the FS-compile path checks before the\\n        // codegen-time desugar runs).\\n        let env2 = if struct_derives_has(derives, \\\"Ord\\\") {\\n          env_bind(env1, String::concat(name, \\\"::compare\\\"), CtFn([\\n            CtStruct(name),\\n            CtStruct(name)\\n          ], CtInt, None))\\n        } else {\\n          env1\\n        }\\n        let env3 = if struct_derives_has(derives, \\\"Show\\\") || struct_derives_has(derives, \\\"Hash\\\") {\\n          env_bind(env2, String::concat(name, \\\"::to_string\\\"), CtFn([\\n            CtStruct(name)\\n          ], CtString, None))\\n        } else {\\n          env2\\n        }\\n        // #672: every struct gets a generated structural `T::equals` (the `==`\\n        // dispatch relies on it), so pre-bind its signature unconditionally.\\n        let env4 = env_bind(env3, String::concat(name, \\\"::equals\\\"), CtFn([\\n          CtStruct(name),\\n          CtStruct(name)\\n        ], CtBool, None))\\n        // #694: `derive(Hash)` generates `T::hash_key(Self) -> String` (the\\n        // structural Map key), so pre-bind its signature at check time too, AND\\n        // register `impl Hash for T` so a `[K: Hash]` bound (e.g. `get_by`) is\\n        // satisfied by the derived type.\\n        let env_hash = if struct_derives_has(derives, \\\"Hash\\\") {\\n          let env_h = EnvTraitImpl(\\\"Hash\\\", CtStruct(name), env4)\\n          env_bind(env_h, String::concat(name, \\\"::hash_key\\\"), CtFn([\\n            CtStruct(name)\\n          ], CtString, None))\\n        } else {\\n          env4\\n        }\\n        // #638: `derive(Default)` generates `T::default() -> T` (a zero-arg fn,\\n        // so the CtFn parameter list is empty).\\n        let env5 = if struct_derives_has(derives, \\\"Default\\\") {\\n          env_bind(env_hash, String::concat(name, \\\"::default\\\"), CtFn(Array::slice([\\n            CtUnit\\n          ], 0, 0), CtStruct(name), None))\\n        } else {\\n          env_hash\\n        }\\n        (bind_fn_return(env5, name, CtStruct(name)), s, c)\\n      },\\n      STypeAlias(_, name, params, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        // Record the alias (with its formal params) so an applied use\\n        // `Name[Arg]` expands via subst in resolve_type_expr's TyApp case.\\n        Array::push(defs, TDAlias(name, params, t))\\n        (env_bind(env, name, t), s, c)\\n      },\\n      SExternLet(name, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        let env1 = env_bind(env, name, t)\\n        (bind_annotation_return(env1, name, Some(te), defs), s, c)\\n      },\\n      STest(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SBench(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SExpr(expr) => {\\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors, tytab)\\n        (env, ns, nc)\\n      },\\n      SModule(_, _, body) => {\\n        let _ = check_stmts(body, 0, env, defs, s, c, errors, tytab)\\n        (env, s, c)\\n      },\\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SAliasDecl(_, _) => (env, s, c)\\n      ,\\n      STrait(_, name, supers, methods, _) => {\\n        let is_open = false\\n        (EnvTraitDef(name, supers, is_open, methods, env), s, c)\\n      },\\n      SImpl(tparams, tbounds, trait_name, type_name) => {\\n        let target = match resolve_builtin(type_name) {\\n          Some(t) => t,\\n          None => CtNamed(type_name, Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        }\\n        // A generic impl `impl [T] Trait for C` (type parameters present) is\\n        // registered as `EnvTraitImplGen` so trait resolution can match the\\n        // family `C[..]` against a concrete `C[K]` by constructor (the target's\\n        // type args are erased). A plain `impl Trait for C` stays a nominal\\n        // `EnvTraitImpl`. (#5 generic impls, Increment A.)\\n        let new_env = if Array::length(tparams) > 0 {\\n          EnvTraitImplGen(trait_name, tparams, tbounds, target, env)\\n        } else {\\n          EnvTraitImpl(trait_name, target, env)\\n        }\\n        (new_env, s, c)\\n      },\\n      _ => (env, s, c)\\n    }\\n    cur_env = new_env\\n    cur_s = s1\\n    cur_c = c1\\n    idx = idx + 1\\n  }\\n  (cur_env, cur_s, cur_c)\\n}\\n\\n// #641 PR-2: enforce trait bounds. After inference, every bounded type variable\\n// recorded in the final substitution that resolved to a CONCRETE type must\\n// satisfy its bounds. Unresolved (still-polymorphic) vars are inherited by the\\n// caller, not violated, so they are skipped. One `no impl `Trait` for `Type``\\n// error per unsatisfied bound (matches fixtures/err_type_trait_*bound* messages).\\nlet check_program_bounds: (TypeEnv, Subst, Array[String]) -> Unit = (env, s, errors) -> {\\n  let pairs = collect_subst_bounds_pairs(s)\\n  let n = Array::length(pairs)\\n  let mut i = 0\\n  while i < n {\\n    let (vid, bounds) = Array::get(pairs, i)\\n    let resolved = subst_apply(s, CtVar(vid))\\n    match resolved {\\n      CtVar(_) => (),\\n      CtUnknown => (),\\n      _ => {\\n        let bn = Array::length(bounds)\\n        let mut bi = 0\\n        while bi < bn {\\n          let b = Array::get(bounds, bi)\\n          if b != \\\"\\\" && not(type_implements_trait(env, s, resolved, b)) {\\n            Array::push(errors, String::concat(\\\"no impl `\\\", String::concat(b, String::concat(\\\"` for `\\\", String::concat(type_to_string(resolved), \\\"`\\\")))))\\n          }\\n          bi = bi + 1\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n// Append `Async`-escape diagnostics (an async primitive used outside an\\n// `{Async}` context) to the type-error list, but only when type checking is\\n// otherwise clean so we surface the real error first.\\nlet collect_async_effect_errors: (Array[Stmt], TypeEnv, Array[String]) -> Unit = (stmts, env, frozen_errors) -> {\\n  if Array::length(frozen_errors) == 0 {\\n    let eff_errs = check_async_effects_stmts(stmts, env)\\n    let mut i = 0\\n    while i < Array::length(eff_errs) {\\n      Array::push(frozen_errors, effect_error_to_string(Array::get(eff_errs, i)))\\n      i = i + 1\\n    }\\n    if Array::length(frozen_errors) == 0 {\\n      let perform_errs = check_perform_effects_stmts(stmts)\\n      let mut j = 0\\n      while j < Array::length(perform_errs) {\\n        Array::push(frozen_errors, effect_error_to_string(Array::get(perform_errs, j)))\\n        j = j + 1\\n      }\\n    }\\n    if Array::length(frozen_errors) == 0 {\\n      let mut_errs = check_mutability_stmts(stmts)\\n      let mut k = 0\\n      while k < Array::length(mut_errs) {\\n        Array::push(frozen_errors, effect_error_to_string(Array::get(mut_errs, k)))\\n        k = k + 1\\n      }\\n    }\\n  }\\n}\\n\\nexport let check_program: (Array[Stmt]) -> TypeEnv with { Error } = (stmts) -> {\\n  // Rank-1 method generics (#684): re-attach trait-method `[X: Bound]` binders\\n  // to impl free functions before checking, so `X::method` in an impl body\\n  // resolves on every path (the FS-compile path type-checks before the codegen\\n  // desugar runs). In-place + idempotent + inert without a method-level binder.\\n  inject_trait_method_generics(stmts)\\n  // #635: lower `let*`/`?` railway sentinels (`__try_bind`/`__try_op`) by the\\n  // operand's head type BEFORE checking, so the checker never sees the\\n  // sentinels (the codegen-time desugar runs later, but the FS-compile path\\n  // type-checks first). In-place, idempotent, inert without `let*`/`?`.\\n  desugar_railway_binds(stmts)\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n  ], 0, 0)\\n  let seeded_raw_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let seeded_env = env_cache(seeded_raw_env)\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let tytab = Array::slice([\\n    (0, CtUnit)\\n  ], 0, 0)\\n  let (env, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n  check_program_bounds(env, final_s, frozen_errors)\\n  collect_async_effect_errors(stmts, env, frozen_errors)\\n  if Array::length(frozen_errors) > 0 {\\n    throw(Array::get(frozen_errors, 0))\\n  }\\n  env\\n}\\n\\n// Collecting variant of check_program for typed hover (vibe type-at): runs the\\n// same inference but RETURNS the recorded (offset, Type) table plus the FINAL\\n// substitution (check_stmts' 2nd value), instead of the TypeEnv. It degrades\\n// gracefully: any type error is swallowed and whatever table was collected so\\n// far is returned, so hovering inside a partially-bad file still resolves the\\n// names that were checked before the error. The table holds RAW (pre-final\\n// subst) types; callers resolve via subst_apply(finalSubst, ty).\\nexport let check_program_type_table: (Array[Stmt]) -> (Array[(Int, Type)], Subst) with { Error } = (stmts) -> {\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n  ], 0, 0)\\n  let seeded_raw_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let seeded_env = env_cache(seeded_raw_env)\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let tytab = Array::slice([\\n    (0, CtUnit)\\n  ], 0, 0)\\n  handle {\\n    let (_, final_s, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n    (tytab, final_s)\\n  } with Error {\\n    Throw(_) => (tytab, SubstEmpty)\\n  }\\n}\\n\\nexport let check_program_with_env: (Array[Stmt], TypeEnv) -> TypeEnv with { Error } = (stmts, initial_env) -> {\\n  match initial_env {\\n    EnvEmpty => check_program(stmts),\\n    _ => {\\n      inject_trait_method_generics(stmts)\\n      // #635: lower `let*`/`?` railway sentinels before checking (see\\n      // check_program). This path checks each imported/entry file pre-codegen.\\n      desugar_railway_binds(stmts)\\n      let empty_defs = Array::slice([\\n        TDAlias(\\\"_dummy\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), CtUnit)\\n      ], 0, 0)\\n      let cached_env = env_cache(initial_env)\\n      let seeded_raw_env = if trait_defined(cached_env, \\\"Eq\\\") {\\n        cached_env\\n      } else {\\n        register_builtin_traits(cached_env)\\n      }\\n      let seeded_env = env_cache(seeded_raw_env)\\n      let errors = ArrayBuilder::new()\\n      let frozen_errors = ArrayBuilder::freeze(errors)\\n      let tytab = Array::slice([\\n        (0, CtUnit)\\n      ], 0, 0)\\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors, tytab)\\n      collect_async_effect_errors(stmts, env, frozen_errors)\\n      if Array::length(frozen_errors) > 0 {\\n        throw(Array::get(frozen_errors, 0))\\n      }\\n      env\\n    }\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_43 = () -> (String, String) {\n  (\"vibe/compiler/builtin_name.vibe\",\n\"//# Functions\\n\\nexport let canonical_builtin_name: (String) -> String = (name) -> {\\n  match name {\\n    \\\"Fs::ReadFile\\\" => \\\"Fs::read_file\\\",\\n    \\\"Fs::WriteFile\\\" => \\\"Fs::write_file\\\",\\n    \\\"Fs::ReadBytes\\\" => \\\"Fs::read_bytes\\\",\\n    \\\"Fs::WriteBytes\\\" => \\\"Fs::write_bytes\\\",\\n    \\\"Fs::Exists\\\" => \\\"Fs::exists\\\",\\n    \\\"Fs::StatToken\\\" => \\\"Fs::stat_token\\\",\\n    \\\"Fs::ReadDir\\\" => \\\"Fs::readdir\\\",\\n    \\\"Fs::IsDir\\\" => \\\"Fs::is_dir\\\",\\n    \\\"Fs::IsFile\\\" => \\\"Fs::is_file\\\",\\n    \\\"Fs::Mkdir\\\" => \\\"Fs::mkdir\\\",\\n    \\\"Fs::Getcwd\\\" => \\\"Fs::getcwd\\\",\\n    \\\"Fs::Chdir\\\" => \\\"Fs::chdir\\\",\\n    \\\"Fs::Remove\\\" => \\\"Fs::remove\\\",\\n    \\\"Fs::Copy\\\" => \\\"Fs::copy\\\",\\n    \\\"Fs::Append\\\" => \\\"Fs::append\\\",\\n    \\\"Env::Get\\\" => \\\"Env::get\\\",\\n    \\\"Env::ArgsLen\\\" => \\\"Env::args_len\\\",\\n    \\\"Env::ArgsGet\\\" => \\\"Env::args_get\\\",\\n    \\\"Profiler::NowUs\\\" => \\\"Profiler::now_us\\\",\\n    _ => name\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_44 = () -> (String, String) {\n  (\"vibe/compiler/builtins.vibe\",\n\"//# Imports\\n\\nexport ./checker {\\n  lookup_builtin\\n}\\n\\n//# Misc\\n\\nexport {\\n  lookup_builtin\\n}\\n\")\n}\n\nlet cli_adapter_source_45 = () -> (String, String) {\n  (\"vibe/compiler/checker.vibe\",\n\"//# Imports\\n\\nexport ./checker / checker.vibe {\\n  check_expr\\n}\\n\\n//# Misc\\n\\nexport {\\n  check_expr\\n}\\n\")\n}\n\nlet cli_adapter_source_46 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/index.vibe\",\n\"export ./sections.vibe {\\n  emit_header, emit_func_type, emit_type_section_multi, emit_type_section,\\n  emit_function_section, emit_name, emit_export_section_multi, emit_export_section,\\n  emit_memory_section, emit_code_section, emit_code_section_with_locals,\\n  emit_i32_const, emit_end, emit_func_type_raw, emit_import_section_func,\\n  emit_data_section, emit_global_section_i32_mut, emit_global_get, emit_global_set,\\n  emit_heap_memory_grow_check, emit_export_memory, emit_exports_with_memory, emit_exports_full,\\n  emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\\nexport ./instructions.vibe {\\n  emit_local_get, emit_local_set, emit_local_tee,\\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor, emit_i64_shl,\\n  emit_i64_shr_s, emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz, emit_call, emit_drop,\\n  emit_return, emit_block_void, emit_block_i64, emit_loop_void, emit_if_void,\\n  emit_if_i64, emit_else, emit_br, emit_br_if, emit_i64_extend_i32_s,\\n  emit_i32_wrap_i64, emit_i32_add, emit_i32_store, emit_i64_store, emit_i32_load,\\n  emit_i32_store8, emit_i32_load8_u, emit_f64_const_bits, emit_f64_const_lohi, emit_f64_add,\\n  emit_f64_sub, emit_f64_mul, emit_f64_div, emit_f64_eq, emit_f64_ne,\\n  emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge, emit_f64_neg,\\n  emit_i64_reinterpret_f64, emit_f64_reinterpret_i64, emit_i64_trunc_f64_s,\\n  emit_f64_convert_i64_s, emit_call_indirect, emit_table_section_funcref,\\n  emit_element_section_active, emit_struct_type_raw, emit_struct_new,\\n  emit_struct_get, emit_struct_set, emit_ref_func, emit_call_ref, emit_ref_null\\n}\\n\\nexport ./builders.vibe {\\n  build_add_module, build_call_module, build_arithmetic_module,\\n  build_fibonacci_module, build_factorial_module, build_hello_module,\\n  string_to_data, emit_data_section_multi, build_print_string_module\\n}\\n\\nexport ./simd.vibe {\\n  emit_v128_load, emit_v128_store, emit_i8x16_splat, emit_i8x16_eq,\\n  emit_i8x16_le_u, emit_i8x16_ge_u, emit_i8x16_swizzle,\\n  emit_i8x16_sub, emit_i8x16_min_u,\\n  emit_v128_any_true, emit_i8x16_all_true, emit_i8x16_bitmask,\\n  emit_v128_and, emit_v128_or, emit_v128_not,\\n  emit_v128_const, emit_v128_const_zero, emit_v128_const_splat_byte\\n}\\n\\nexport ./simd_patterns.vibe {\\n  emit_simd_memcmp_16, emit_simd_find_byte_16,\\n  emit_scalar_memcmp_16_unrolled, emit_scalar_find_byte_16_unrolled\\n}\\n\")\n}\n\nlet cli_adapter_source_47 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/sections.vibe\",\n\"//# Imports\\n\\nexport ./base.vibe {\\n  emit_code_section, emit_code_section_with_locals, emit_end, emit_export_section, emit_export_section_multi, emit_func_type, emit_function_section, emit_header, emit_i32_const, emit_memory_section, emit_name, emit_type_section, emit_type_section_multi\\n}\\n\\nexport ./extra.vibe {\\n  emit_data_section, emit_export_memory, emit_exports_full, emit_exports_with_memory, emit_func_type_raw, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_heap_memory_grow_check, emit_import_section_func\\n}\\n\\nexport ./metadata.vibe {\\n  emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_global_get, emit_global_set, emit_heap_memory_grow_check, emit_code_section, emit_data_section, emit_exports_full, emit_type_section, emit_export_memory, emit_func_type_raw, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_exports_with_memory, emit_import_section_func, emit_export_section_multi, emit_global_section_i32_mut, emit_code_section_with_locals, emit_vibe_abi_custom_section, emit_function_name_section\\n}\\n\")\n}\n\nlet cli_adapter_source_48 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/metadata.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\n// Emit the standard WebAssembly \\\"name\\\" custom section with a function-names\\n// subsection (id 1) naming `count` consecutive functions starting at\\n// `base_index`. Custom sections are ignored at execution time, so this only\\n// improves tooling/trace readability (e.g. wasm backtraces show `main` instead\\n// of `<wasm function N>`). This is debugger P0 groundwork (ADR-0035 /\\n// docs/release-roadmap.md テーマ3): a source-line map can be layered on later.\\nexport let emit_function_name_section: (Bytes, Array[String], Int) -> Unit = (out, names, base_index) -> {\\n  let count = Array::length(names)\\n  if count == 0 {\\n    ()\\n  } else {\\n    let content = bytebuf_new()\\n    bytebuf_push_string(content, \\\"name\\\")\\n    // function-names subsection: vec of (funcidx, name), funcidx ascending.\\n    let namemap = bytebuf_new()\\n    leb128_encode_u32(namemap, count)\\n    let mut i = 0\\n    while i < count {\\n      leb128_encode_u32(namemap, base_index + i)\\n      bytebuf_push_string(namemap, Array::get(names, i))\\n      i = i + 1\\n    }\\n    bytebuf_push_section(content, 1, namemap)\\n    bytebuf_push_section(out, 0, content)\\n  }\\n}\\n\\nlet emit_ascii_payload: (Bytes, String) -> Unit = (buf, text) -> {\\n  let len = String::length(text)\\n  let mut i = 0\\n  while i < len {\\n    bytebuf_push(buf, String::char_code_at(text, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport let emit_vibe_abi_custom_section: (Bytes, String) -> Unit = (out, host_import_abi) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_string(content, \\\"vibe.abi\\\")\\n  emit_ascii_payload(content, \\\"version=1\\\\n\\\")\\n  emit_ascii_payload(content, String::concat(\\\"host_import_abi=\\\", host_import_abi))\\n  emit_ascii_payload(content, \\\"\\\\n\\\")\\n  bytebuf_push_section(out, 0, content)\\n}\\n\")\n}\n\nlet cli_adapter_source_49 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/base.vibe\",\n\"//# Imports\\n\\nexport ./code_helpers.vibe {\\n  emit_code_section, emit_code_section_with_locals, emit_end, emit_i32_const, emit_memory_section\\n}\\n\\nexport ./header_types.vibe {\\n  emit_export_section, emit_export_section_multi, emit_func_type, emit_function_section, emit_header, emit_name, emit_type_section, emit_type_section_multi\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_code_section, emit_type_section, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_export_section_multi, emit_code_section_with_locals\\n}\\n\")\n}\n\nlet cli_adapter_source_50 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/header_types.vibe\",\n\"//# Imports\\n\\nexport ./header_core.vibe {\\n  emit_func_type, emit_header, emit_type_section, emit_type_section_multi\\n}\\n\\nexport ./header_exports.vibe {\\n  emit_export_section, emit_export_section_multi, emit_function_section, emit_name\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_name, emit_header, emit_func_type, emit_type_section, emit_export_section, emit_function_section, emit_type_section_multi, emit_export_section_multi\\n}\\n\")\n}\n\nlet cli_adapter_source_51 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/header_core.vibe\",\n\"//# Imports\\n\\nexport ./header_magic.vibe {\\n  emit_header\\n}\\n\\nexport ./header_type_sections.vibe {\\n  emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_header, emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\")\n}\n\nlet cli_adapter_source_52 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/header_magic.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_push, bytebuf_push3\\n}\\n\\n//# Functions\\n\\nexport let emit_header: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push3(buf, 0, 97, 115)\\n  bytebuf_push3(buf, 109, 1, 0)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\")\n}\n\nlet cli_adapter_source_53 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/header_type_sections.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport let emit_func_type: (Bytes, Int, Int) -> Unit = (buf, param_count, result_count) -> {\\n  bytebuf_push(buf, 96)\\n  leb128_encode_u32(buf, param_count)\\n  let mut i = 0\\n  while i < param_count {\\n    bytebuf_push(buf, 126)\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, result_count)\\n  let mut j = 0\\n  while j < result_count {\\n    bytebuf_push(buf, 126)\\n    j = j + 1\\n  }\\n}\\n\\nexport let emit_type_section_multi: (Bytes, Array[Int]) -> Unit = (out, type_defs) -> {\\n  let count = Array::length(type_defs) / 2\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 1, content)\\n}\\n\\nexport let emit_type_section: (Bytes, Int, Int) -> Unit = (out, param_count, result_count) -> {\\n  let type_defs = Array::slice([\\n    0\\n  ], 0, 0)\\n  Array::push(type_defs, param_count)\\n  Array::push(type_defs, result_count)\\n  emit_type_section_multi(out, type_defs)\\n}\\n\")\n}\n\nlet cli_adapter_source_54 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/header_exports.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport let emit_name: (Bytes, String) -> Unit = (buf, name) -> {\\n  bytebuf_push_string(buf, name)\\n}\\n\\nexport let emit_function_section: (Bytes, Array[Int]) -> Unit = (out, type_indices) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(type_indices))\\n  let mut i = 0\\n  while i < Array::length(type_indices) {\\n    leb128_encode_u32(content, Array::get(type_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 3, content)\\n}\\n\\nexport let emit_export_section_multi: (Bytes, Array[String], Array[Int]) -> Unit = (out, names, func_indices) -> {\\n  let count = Array::length(names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_name(content, Array::get(names, i))\\n    bytebuf_push(content, 0)\\n    leb128_encode_u32(content, Array::get(func_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 7, content)\\n}\\n\\nexport let emit_export_section: (Bytes, String, Int) -> Unit = (out, name, func_idx) -> {\\n  emit_export_section_multi(out, [\\n    name\\n  ], [\\n    func_idx\\n  ])\\n}\\n\")\n}\n\nlet cli_adapter_source_55 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/code_helpers.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_opcode_s64, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport let emit_end: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, 11)\\n}\\n\\nexport let emit_i32_const: (Bytes, Int) -> Unit = (buf, value) -> {\\n  bytebuf_push_opcode_s64(buf, 65, value)\\n}\\n\\nexport let emit_code_section: (Bytes, Array[Bytes]) -> Unit = (out, bodies) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let func_buf = bytebuf_new()\\n    leb128_encode_u32(func_buf, 0)\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\\nexport let emit_memory_section: (Bytes, Int) -> Unit = (out, min_pages) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, min_pages)\\n  bytebuf_push_section(out, 5, content)\\n}\\n\\nexport let emit_code_section_with_locals: (Bytes, Array[Bytes], Array[Int]) -> Unit = (out, bodies, local_counts) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let num_locals = Array::get(local_counts, i)\\n    let func_buf = bytebuf_new()\\n    if num_locals == 0 {\\n      leb128_encode_u32(func_buf, 0)\\n    } else {\\n      leb128_encode_u32(func_buf, 1)\\n      leb128_encode_u32(func_buf, num_locals)\\n      bytebuf_push(func_buf, 126)\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\")\n}\n\nlet cli_adapter_source_56 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/extra.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push_buf, bytebuf_push_opcode_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\nimport ./base.vibe {\\n  emit_end, emit_i32_const, emit_name\\n}\\n\\n//# Functions\\n\\nlet vt_i32 = 127\\n\\nlet sec_data = 11\\n\\nlet type_func = 96\\n\\nlet sec_export = 7\\n\\nlet sec_global = 6\\n\\nlet sec_import = 2\\n\\nlet export_func = 0\\n\\nlet export_memory = 2\\n\\nlet op_global_get = 35\\n\\nlet op_global_set = 36\\n\\nlet op_i32_add = 106\\n\\nlet op_i32_sub = 107\\n\\nlet op_i32_shr_u = 118\\n\\nlet op_i32_gt_u = 75\\n\\nlet op_memory_size = 63\\n\\nlet op_memory_grow = 64\\n\\nlet op_drop = 26\\n\\nlet op_if = 4\\n\\nlet bt_void = 64\\n\\nexport let emit_global_get: (Bytes, Int) -> Unit = (buf, idx) -> {\\n  bytebuf_push_opcode_u32(buf, op_global_get, idx)\\n}\\n\\nexport let emit_heap_memory_grow_check: (Bytes) -> Unit = (buf) -> {\\n  // Grow memory to `(heap_ptr + 65536) >> 16` pages — i.e. ALWAYS at least one\\n  // page past `heap_ptr`. The previous `+ 65535` rounded to `ceil(heap_ptr /\\n  // 65536)`, which holds only `[0, heap_ptr)`; when `heap_ptr` lands exactly on\\n  // a page boundary that leaves `memory_size == heap_ptr`, and an access at\\n  // `heap_ptr` (the next slot the bump allocator hands out) traps with\\n  // \\\"memory access out of bounds\\\". The `+ 65536` reserves a guard page so\\n  // `heap_ptr` itself is always addressable. Monotonic: never grows LESS than\\n  // before, so it cannot under-allocate.\\n  emit_global_get(buf, 0)\\n  emit_i32_const(buf, 65536)\\n  bytebuf_push(buf, op_i32_add)\\n  emit_i32_const(buf, 16)\\n  bytebuf_push(buf, op_i32_shr_u)\\n  bytebuf_push2(buf, op_memory_size, 0)\\n  bytebuf_push(buf, op_i32_gt_u)\\n  bytebuf_push2(buf, op_if, bt_void)\\n  emit_global_get(buf, 0)\\n  emit_i32_const(buf, 65536)\\n  bytebuf_push(buf, op_i32_add)\\n  emit_i32_const(buf, 16)\\n  bytebuf_push(buf, op_i32_shr_u)\\n  bytebuf_push2(buf, op_memory_size, 0)\\n  bytebuf_push(buf, op_i32_sub)\\n  bytebuf_push2(buf, op_memory_grow, 0)\\n  bytebuf_push(buf, op_drop)\\n  emit_end(buf)\\n}\\n\\nexport let emit_global_set: (Bytes, Int) -> Unit = (buf, idx) -> {\\n  bytebuf_push_opcode_u32(buf, op_global_set, idx)\\n}\\n\\nexport let emit_data_section: (Bytes, Int, Bytes) -> Unit = (out, offset, data) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_i32_const(content, offset)\\n  emit_end(content)\\n  leb128_encode_u32(content, Bytes::length(data))\\n  bytebuf_push_buf(content, data)\\n  bytebuf_push_section(out, sec_data, content)\\n}\\n\\nexport let emit_exports_full: (Bytes, Array[String], Array[Int], String, Int, Array[String], Array[Int]) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx, global_names, global_indices) -> {\\n  let count = Array::length(fn_names) + 1 + Array::length(global_names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < Array::length(fn_names) {\\n    emit_name(content, Array::get(fn_names, i))\\n    bytebuf_push(content, export_func)\\n    leb128_encode_u32(content, Array::get(fn_indices, i))\\n    i = i + 1\\n  }\\n  emit_name(content, mem_name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  let mut gi = 0\\n  while gi < Array::length(global_names) {\\n    emit_name(content, Array::get(global_names, gi))\\n    bytebuf_push(content, 3)\\n    leb128_encode_u32(content, Array::get(global_indices, gi))\\n    gi = gi + 1\\n  }\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport let emit_export_memory: (Bytes, String, Int) -> Unit = (out, name, mem_idx) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  emit_name(content, name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport let emit_func_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, param_types, result_types) -> {\\n  bytebuf_push(buf, type_func)\\n  leb128_encode_u32(buf, Array::length(param_types))\\n  let mut i = 0\\n  while i < Array::length(param_types) {\\n    bytebuf_push(buf, Array::get(param_types, i))\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, Array::length(result_types))\\n  let mut j = 0\\n  while j < Array::length(result_types) {\\n    bytebuf_push(buf, Array::get(result_types, j))\\n    j = j + 1\\n  }\\n}\\n\\nexport let emit_exports_with_memory: (Bytes, Array[String], Array[Int], String, Int) -> Unit = (out, fn_names, fn_indices, mem_name, mem_idx) -> {\\n  let count = Array::length(fn_names) + 1\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < Array::length(fn_names) {\\n    emit_name(content, Array::get(fn_names, i))\\n    bytebuf_push(content, export_func)\\n    leb128_encode_u32(content, Array::get(fn_indices, i))\\n    i = i + 1\\n  }\\n  emit_name(content, mem_name)\\n  bytebuf_push(content, export_memory)\\n  leb128_encode_u32(content, mem_idx)\\n  bytebuf_push_section(out, sec_export, content)\\n}\\n\\nexport let emit_import_section_func: (Bytes, String, String, Int) -> Unit = (out, module_name, field_name, type_idx) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  emit_name(content, module_name)\\n  emit_name(content, field_name)\\n  bytebuf_push(content, export_func)\\n  leb128_encode_u32(content, type_idx)\\n  bytebuf_push_section(out, sec_import, content)\\n}\\n\\nexport let emit_global_section_i32_mut: (Bytes, Int) -> Unit = (out, init_value) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push2(content, vt_i32, 1)\\n  emit_i32_const(content, init_value)\\n  emit_end(content)\\n  bytebuf_push_section(out, sec_global, content)\\n}\\n\")\n}\n\nlet cli_adapter_source_57 = () -> (String, String) {\n  (\"vibe/compiler/codegen/wasm_emit/instructions.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push9, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_opcode_u32_u32, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\nimport ./sections.vibe {\\n  emit_end, emit_i32_const\\n}\\n\\n//# Functions\\n\\nlet op_br = 12\\n\\nlet op_if = 4\\n\\nlet bt_i64 = 126\\n\\nlet bt_void = 64\\n\\nexport let emit_br: (Bytes, Int) -> Unit = (buf, label) -> {\\n  bytebuf_push_opcode_u32(buf, op_br, label)\\n}\\n\\nlet op_call = 16\\n\\nlet op_drop = 26\\n\\nlet op_else = 5\\n\\nlet op_loop = 3\\n\\nlet op_block = 2\\n\\nlet op_br_if = 13\\n\\nexport let emit_call: (Bytes, Int) -> Unit = (buf, func_idx) -> {\\n  bytebuf_push_opcode_u32(buf, op_call, func_idx)\\n}\\n\\nexport let emit_drop: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_drop)\\n}\\n\\nexport let emit_else: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_else)\\n}\\n\\nlet op_f64_eq = 97\\n\\nlet op_f64_ge = 102\\n\\nlet op_f64_gt = 100\\n\\nlet op_f64_le = 101\\n\\nlet op_f64_lt = 99\\n\\nlet op_f64_ne = 98\\n\\nlet op_i64_eq = 81\\n\\nlet op_i64_ne = 82\\n\