let selfhost_source_109 = () -> (String, String) {
  ("vibe/compiler/codegen/gc/backend_body.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport let compile_wasi_module_gc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\n  let fn_names_list = Array::slice([\n    \"\"\n  ], 0, 0)\n  let fn_param_counts = Array::slice([\n    0\n  ], 0, 0)\n  let fn_needs_env_list = Array::slice([\n    true\n  ], 0, 0)\n  let user_func_stmts = Array::slice([\n    SExpr(EUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    match stmt {\n      SLet(_, _, name, _, expr) => match expr {\n        EFn(_, _, params, _, _, _) => {\n          Array::push(fn_names_list, name)\n          Array::push(fn_param_counts, Array::length(params))\n          Array::push(fn_needs_env_list, true)\n          Array::push(user_func_stmts, stmt)\n          0\n        },\n        _ => 0\n      }\n      ,\n      _ => 0\n    }\n    i = i + 1\n  }\n  let ctor_names_list = Array::slice([\n    \"None\",\n    \"Some\"\n  ], 0, 2)\n  let ctor_tags_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_field_counts_list = Array::slice([\n    0,\n    1\n  ], 0, 2)\n  let ctor_type_names_list = Array::slice([\n    \"Option\",\n    \"Option\"\n  ], 0, 2)\n  let mut type_index = 1\n  let mut ei2 = 0\n  while ei2 < Array::length(stmts) {\n    match Array::get(stmts, ei2) {\n      SEnum(_, ename, _, variants, _) => {\n        type_index = type_index + 1\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, vfields) = Array::get(variants, vi)\n          Array::push(ctor_names_list, vname)\n          Array::push(ctor_tags_list, (type_index<<16)|vi)\n          Array::push(ctor_field_counts_list, Array::length(vfields))\n          Array::push(ctor_type_names_list, ename)\n          vi = vi + 1\n        }\n        0\n      },\n      SStruct(_, sname, sfields, _, _) => {\n        type_index = type_index + 1\n        Array::push(ctor_names_list, sname)\n        Array::push(ctor_tags_list, type_index<<16)\