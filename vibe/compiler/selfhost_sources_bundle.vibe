let selfhost_source_164 = () -> (String, String) {
  ("vibe/compiler/entry/source_compile/wasi_only/merge_sources.vibe",
"\n\n\n\n\n\n\n\n\n\n\nlet string_array_contains_local: (Array[String], String) -> Bool = (items, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet append_fs_import_alias_collision_defs: (Array[Stmt], String, Array[Stmt]) -> Unit with { Error, Fs } = (merged, current_path, stmts) -> {\n  let refs = collect_import_alias_collision_refs(stmts)\n  let emitted = Array::slice([\n    \"\"\n  ], 0, 0)\n  let base_dir = dir_of_path(current_path)\n  let mut i = 0\n  while i < Array::length(refs) {\n    let (raw_path, original, local) = Array::get(refs, i)\n    if !string_array_contains_local(emitted, local) {\n      let resolved = resolve_import_path(base_dir, raw_path)\n      let source = perform Fs::ReadFile(resolved)\n      let source_stmts = namespace_private_value_stmts(\n        resolved,\n        parse_program(lex(source))\n      )\n      let mut j = 0\n      let mut done = false\n      while j < Array::length(source_stmts) && !done {\n        match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\n          Some(local_stmt) => {\n            Array::push(merged, local_stmt)\n            Array::push(emitted, local)\n            done = true\n          },\n          None => ()\n        }\n        j = j + 1\n      }\n    }\n    i = i + 1\n  }\n}\n\nlet rec collect_merged_stmts_recursive_impl: (String, String, Array[Stmt], Array[String]) -> Unit with { Error, Fs } = (entry_path, path, merged, visited) -> {\n  if contains_path(visited, path) {\n    ()\n  }\n  else {\n    Array::push(visited, path)\n    let source = perform Fs::ReadFile(path)\n    let stmts = parse_program(lex(source))\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_import_path(base_dir, raw_path)\n          collect_merged_stmts_recursive_impl(entry_path, resolved, merged, visited)\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_import_path(base_dir, raw_path)\n          collect_merged_stmts_recursive_impl(entry_path, resolved, merged, visited)\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    let namespaced_stmts = if path == entry_path {\n      stmts\n    } else {\n      namespace_private_value_stmts(path, stmts)\n    }\n    if stmts_have_import_deep(stmts) {\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\n      append_fs_import_alias_collision_defs(merged, path, stmts)\n      append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\n    } else {\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\n    }\n  }\n}\n\nlet collect_merged_stmts_recursive: (String, Array[Stmt], Array[String]) -> Unit with { Error, Fs } = (path, merged, visited) -> {\n  collect_merged_stmts_recursive_impl(path, path, merged, visited)\n}\n\nexport let compile_file_wasi_only: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\n  let stmts = empty_stmt_array()\n  let visited = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  strip_generic_type_params(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\n\nexport {\n  collect_merged_stmts_recursive\n}\n\nexport {\n  compile_file_wasi_only, collect_merged_stmts_recursive\n}\n")
}

