   Array::push(func_type_indices, 3)\\n  } else {\\n    ()\\n  }\\n  Array::push(func_type_indices, 2)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 8)\\n  let mut fti = 0\\n  while fti < num_user_funcs {\\n    let upc = Array::get(fn_param_counts, fti)\\n    Array::push(func_type_indices, num_base_types + upc)\\n    fti = fti + 1\\n  }\\n  Array::push(func_type_indices, 2)\\n  Array::push(func_type_indices, 5)\\n  let mut lfi = 0\\n  while lfi < num_lambdas {\\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\\n    Array::push(func_type_indices, num_base_types + lam_user_params)\\n    lfi = lfi + 1\\n  }\\n  if Array::length(func_type_indices) != Array::length(bodies) {\\n    throw(\\\"WASI codegen internal error: function section and code section count mismatch\\\")\\n  }\\n  emit_function_section(out, func_type_indices)\\n  let total_table_entries = num_user_funcs + num_lambdas\\n  if total_table_entries > 0 {\\n    emit_table_section_funcref(out, total_table_entries)\\n  }\\n  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + (if rc_shadow {\\n    rc_shadow_reserve()\\n  } else {\\n    0\\n  })))\\n  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)\\n  if uses_exceptions {\\n    let tag_content = bytebuf_new()\\n    let num_tags = Array::length(effect_names_list) + 4\\n    bytebuf_push_vec_header(tag_content, num_tags)\\n    let mut tag_emit_i = 0\\n    while tag_emit_i < num_tags {\\n      bytebuf_push(tag_content, 0)\\n      leb128_encode_u32(tag_content, 1)\\n      tag_emit_i = tag_emit_i + 1\\n    }\\n    bytebuf_push_section(out, 13, tag_content)\\n  } else {\\n    ()\\n  }\\n  let global_content = bytebuf_new()\\n  if enable_rc {\\n    bytebuf_push_vec_header(global_content, 7)\\n  } else {\\n    bytebuf_push_vec_header(global_content, 6)\\n  }\\n  bytebuf_push(global_content, 127)\\n  bytebuf_push(global_content, 1)\\n  emit_i32_const(global_content, heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  if enable_rc {\\n    bytebuf_push(global_content, 127)\\n    bytebuf_push(global_content, 1)\\n    emit_i32_const(global_content, 0)\\n    emit_end(global_content)\\n  }\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 127)\\n  bytebuf_push(global_content, 1)\\n  emit_i32_const(global_content, heap_start)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push_section(out, 6, global_content)\\n  let start_func_idx = func_offset + num_user_funcs\\n  let run_func_idx = start_func_idx + 1\\n  let all_export_names = lc_fresh_string_array()\\n  let all_export_indices = lc_fresh_int_array()\\n  if !library_mode {\\n    Array::push(all_export_names, \\\"_start\\\")\\n    Array::push(all_export_indices, start_func_idx)\\n  }\\n  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {\\n    Array::push(all_export_names, entry_name)\\n    Array::push(all_export_indices, entry_func_idx)\\n  }\\n  let mut exi = 0\\n  while exi < Array::length(export_fn_names) {\\n    let ename = Array::get(export_fn_names, exi)\\n    let skip_export = library_mode && ename == entry_name\\n    if !skip_export && !array_contains_str(all_export_names, ename) {\\n      Array::push(all_export_names, ename)\\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\\n    }\\n    exi = exi + 1\\n  }\\n  let mut bxi = 0\\n  while bxi < Array::length(test_fn_names) {\\n    let bname = Array::get(test_fn_names, bxi)\\n    if String::starts_with(bname, \\\"__bench_\\\") && !array_contains_str(all_export_names, bname) {\\n      let mut bj = 0\\n      let mut bfound = 0 - 1\\n      while bj < num_user_funcs {\\n        if Array::get(fn_names_list, bj) == bname {\\n          bfound = bj\\n          bj = num_user_funcs\\n        } else {\\n          bj = bj + 1\\n        }\\n      }\\n      if bfound >= 0 {\\n        Array::push(all_export_names, bname)\\n        Array::push(all_export_indices, bfound + func_offset)\\n      }\\n    }\\n    bxi = bxi + 1\\n  }\\n  let export_content = bytebuf_new()\\n  let export_count = Array::length(all_export_names) + 1 +\\n  (if library_mode {\\n    0\\n  } else {\\n    1 + (if uses_exceptions {\\n      1\\n    } else {\\n      0\\n    })\\n  })\\n  bytebuf_push_vec_header(export_content, export_count)\\n  let mut efi = 0\\n  while efi < Array::length(all_export_names) {\\n    emit_name(export_content, Array::get(all_export_names, efi))\\n    bytebuf_push(export_content, 0)\\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\\n    efi = efi + 1\\n  }\\n  emit_name(export_content, \\\"memory\\\")\\n  bytebuf_push(export_content, 2)\\n  leb128_encode_u32(export_content, 0)\\n  if !library_mode {\\n    emit_name(export_content, \\\"__heap_ptr\\\")\\n    bytebuf_push(export_content, 3)\\n    leb128_encode_u32(export_content, 0)\\n    if uses_exceptions {\\n      emit_name(export_content, \\\"error\\\")\\n      bytebuf_push(export_content, 4)\\n      leb128_encode_u32(export_content, 0)\\n    } else {\\n      ()\\n    }\\n  }\\n  bytebuf_push_section(out, 7, export_content)\\n  if total_table_entries > 0 {\\n    let table_func_indices = lc_fresh_int_array()\\n    let mut tei = 0\\n    while tei < num_user_funcs {\\n      Array::push(table_func_indices, func_offset + tei)\\n      tei = tei + 1\\n    }\\n    let mut tej = 0\\n    while tej < num_lambdas {\\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\\n      tej = tej + 1\\n    }\\n    emit_element_section_active(out, table_func_indices)\\n  }\\n  let code_content = bytebuf_new()\\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\\n  let mut ci = 0\\n  while ci < Array::length(bodies) {\\n    let body = Array::get(bodies, ci)\\n    let func_buf = bytebuf_new()\\n    let ni32 = Array::get(meta_i32, ci)\\n    let ni64 = Array::get(meta_i64, ci)\\n    if ni32 == 0 {\\n      if ni64 == 0 {\\n        leb128_encode_u32(func_buf, 0)\\n      } else {\\n        leb128_encode_u32(func_buf, 1)\\n        leb128_encode_u32(func_buf, ni64)\\n        bytebuf_push(func_buf, 126)\\n      }\\n    } else {\\n      if ni64 == 0 {\\n        leb128_encode_u32(func_buf, 1)\\n        leb128_encode_u32(func_buf, ni32)\\n        bytebuf_push(func_buf, 127)\\n      } else {\\n        leb128_encode_u32(func_buf, 2)\\n        leb128_encode_u32(func_buf, ni32)\\n        bytebuf_push(func_buf, 127)\\n        leb128_encode_u32(func_buf, ni64)\\n        bytebuf_push(func_buf, 126)\\n      }\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(code_content, func_buf)\\n    ci = ci + 1\\n  }\\n  bytebuf_push_section(out, 10, code_content)\\n  if num_strings > 0 {\\n    let data_offsets = lc_fresh_int_array()\\n    let data_bufs = lc_fresh_bytes_array()\\n    let mut di = 0\\n    while di < num_strings {\\n      Array::push(data_offsets, Array::get(str_offsets, di))\\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\\n      di = di + 1\\n    }\\n    emit_data_section_multi(out, data_offsets, data_bufs)\\n  }\\n  emit_function_name_section(out, fn_names_list, func_offset)\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let compile_wasi_module_rc_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts_in, entry_name) -> {\\n  let stmts = elaborate_heap_params(stmts_in)\\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, false, false, empty_dbg_prov())\\n}\\n\\nexport let compile_wasi_module_rc_shadow_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts_in, entry_name) -> {\\n  let stmts = elaborate_heap_params(stmts_in)\\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, false, true, empty_dbg_prov())\\n}\\n\\nexport let compile_wasi_module_with_sources_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, false, false, false, false, false, empty_dbg_prov())\\n}\\n\\nexport let compile_wasi_module_with_sources_coverage_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, true, false, false, false, empty_dbg_prov())\\n}\\n\\nexport let compile_wasi_module_with_sources_trace_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, true, false, false, empty_dbg_prov())\\n}\\n\\nexport let compile_wasi_module_with_sources_break_impl: (Array[Stmt], String, Array[(String, String)], DbgProv) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, prov) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, true, false, prov)\\n}\\n\\n\\n\\nexport {\\n  compile_wasi_module_linked_impl,\\n  compile_wasi_module_with_sources_impl,\\n  compile_wasi_module_with_sources_coverage_impl,\\n  compile_wasi_module_with_sources_trace_impl,\\n  compile_wasi_module_with_sources_break_impl,\\n  compile_wasi_module_rc_impl\\n}\\n\\n\\n\\nexport let compile_wasi_module_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_with_sources_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0))\\n}\\n\\nexport let compile_wasi_module_coverage_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_with_sources_coverage_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0))\\n}\\n\\nexport let compile_wasi_module_trace_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_with_sources_trace_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0))\\n}\\n\\nexport let compile_wasi_module_break_impl: (Array[Stmt], String, DbgProv) -> Bytes with { Error } = (stmts, entry_name, prov) -> {\\n  compile_wasi_module_with_sources_break_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), prov)\\n}\\n\\n\\n\\n\\n\\nexport let parse_interp_expr: (Array[Token]) -> Expr with { Error } = (tokens) -> {\\n  let (stmt, _) = parse_stmt(tokens, [], 0)\\n  match stmt {\\n    SExpr(expr) => expr,\\n    _ => throw(\\\"expected interpolation expression\\\")\\n  }\\n}\\n\\n\\n\\n\\n\\nexport let collect_interp_exprs: (Array[String]) -> Array[Expr] with { Error } = (parts) -> {\\n  let plen = Array::length(parts)\\n  let exprs = ArrayBuilder::new()\\n  let mut i = 0\\n  while i < plen {\\n    let lit = Array::get(parts, i)\\n    if String::length(lit) > 0 {\\n      ArrayBuilder::push(exprs, EString(lit))\\n    }\\n    if i + 1 < plen {\\n      let expr_src = Array::get(parts, i + 1)\\n      let part_tokens = lex(expr_src)\\n      let part_expr = parse_interp_expr(part_tokens)\\n      ArrayBuilder::push(exprs, ECall(EIdent(\\\"__to_string\\\", -1), [\\n        part_expr\\n      ], -1))\\n    }\\n    i = i + 2\\n  }\\n  ArrayBuilder::freeze(exprs)\\n}\\n\\n\\n\\nlet concat_exprs: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n  let b = ArrayBuilder::new()\\n  ArrayBuilder::push(b, lhs)\\n  ArrayBuilder::push(b, rhs)\\n  let args = ArrayBuilder::freeze(b)\\n  ECall(EIdent(\\\"String::concat\\\", -1), args, -1)\\n}\\n\\nexport let fold_interp_exprs_loop: (Array[Expr], Int, Expr, Int) -> Expr = (result_arr, result_len, result0, j0) -> {\\n  let mut result = result0\\n  let mut j = j0\\n  while j < result_len {\\n    let rhs = Array::get(result_arr, j)\\n    result = concat_exprs(result, rhs)\\n    j = j + 1\\n  }\\n  result\\n}\\n\\n\\n\\n\\nexport let fold_interp_exprs_nonempty: (Array[Expr], Int) -> Expr = (result_arr, result_len) -> {\\n  let first = Array::get(result_arr, 0)\\n  fold_interp_exprs_loop(result_arr, result_len, first, 1)\\n}\\n\\n\\n\\n\\nexport let fold_interp_exprs: (Array[Expr]) -> Expr = (result_arr) -> {\\n  let result_len = Array::length(result_arr)\\n  if result_len == 0 {\\n    EString(\\\"\\\")\\n  } else {\\n    fold_interp_exprs_nonempty(result_arr, result_len)\\n  }\\n}\\n\\n\\n\\nexport {\\n  fold_interp_exprs\\n}\\n\\n\\n\\nexport {\\n  fold_interp_exprs\\n}\\n\\n\\n\\n\\n\\nexport let rewrite_interp_string: (Array[String]) -> Expr with { Error } = (parts) -> {\\n  let result_arr = collect_interp_exprs(parts)\\n  fold_interp_exprs(result_arr)\\n}\\n\\n\\n\\nexport {\\n  rewrite_interp_string\\n}\\n\\n\\n\\nexport {\\n  rewrite_interp_string\\n}\\n\\n\\n\\n\\nexport let rec rewrite_interp: (Expr) -> Expr with { Error } = (e) -> {\\n  match e {\\n    EStringInterp(parts) => rewrite_interp_string(parts),\\n    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),\\n    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),\\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\\n    ECall(callee, args, off) => ECall(rewrite_interp(callee), for arg in args {\\n      rewrite_interp(arg)\\n    }, off),\\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\\n      let (pat, body) = arm; (pat, rewrite_interp(body))\\n    }),\\n    _ => e\\n  }\\n}\\n\\n\\n\\nexport {\\n  rewrite_interp\\n}\\n\\n\\n\\n\\n\\nexport let expand_interp_stmts: (Array[Stmt]) -> Unit with { Error } = (stmts) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\\n      ,\\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\\n      ,\\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\\n      ,\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  desugar_trait_dicts(stmts)\\n}\\n\\n\\n\\nexport let strip_generic_type_params: (Array[Stmt]) -> Unit = (stmts) -> {\\n  let empty_tp = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let empty_bounds = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\\n        }\\n        ,\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\n\\n\\n\\nexport {\\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_push_buf, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32, bytebuf_push_string\\n}\\n\\nexport {\\n  bytebuf_new, bytebuf_push, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_length, bytebuf_push_buf, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_string, bytebuf_push_section, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32, bytebuf_push_vec_header, bytebuf_push_opcode_u32_u32\\n}\\n\\n\\n\\nexport {\\n  emit_br, emit_end, emit_call, emit_drop, emit_else, emit_name, emit_br_if, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_ne, emit_header, emit_i64_eq, emit_i64_ne, emit_i64_or, emit_if_i64, emit_return, emit_f64_add, emit_f64_div, emit_f64_mul, emit_f64_neg, emit_f64_sub, emit_i32_add, emit_i64_add, emit_i64_and, emit_i64_eqz, emit_i64_mul, emit_i64_shl, emit_i64_sub, emit_i64_xor, emit_if_void, emit_call_ref, emit_i32_load, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_ref_func, emit_ref_null, emit_block_i64, emit_func_type, emit_i32_const, emit_i32_store, emit_i64_const, emit_i64_div_s, emit_i64_rem_s, emit_i64_shr_s, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, string_to_data, emit_block_void, emit_global_get, emit_global_set, emit_i32_store8, emit_struct_get, emit_struct_new, emit_struct_set, build_add_