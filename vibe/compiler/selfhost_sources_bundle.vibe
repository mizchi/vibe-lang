0)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 4)\n  emit_local_get(b, 1)\n  emit_i64_const(b, 32)\n  emit_i64_shr_s(b)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 5)\n  emit_i32_const(b, 0)\n  emit_local_set(b, 6)\n  emit_block_i64(b)\n  emit_block_void(b)\n  emit_loop_void(b)\n  emit_local_get(b, 6)\n  emit_local_get(b, 2)\n  emit_i32_ge_u(b)\n  emit_br_if(b, 1)\n  // break to inner block_void\n  emit_local_get(b, 4)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_local_get(b, 5)\n  emit_local_get(b, 6)\n  emit_i32_add(b)\n  emit_i32_load8_u(b, 0, 0)\n  emit_i32_ne(b)\n  emit_if_void(b)\n  emit_i64_const(b, 0)\n  // false\n  emit_br(b, 3)\n  // break to block_i64 with false\n  emit_end(b)\n  emit_local_get(b, 6)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_local_set(b, 6)\n  emit_br(b, 0)\n  // continue loop\n  emit_end(b)\n  emit_end(b)\n  emit_i64_const(b, 1)\n  emit_end(b)\n  emit_end(b)\n  b\n}\n\nexport let gen_arr_get_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  // 0x74 i32.shl\n  emit_i32_add(b)\n  emit_i64_load(b, 3, 0)\n  b\n}\n\nexport let gen_arr_len_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 4)\n  // header[4] = length\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gen_arr_new_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_global_get(b, 0)\n  emit_local_tee(b, 0)\n  emit_i32_const(b, 76)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 8)\n  emit_i32_store(b, 2, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 0)\n  emit_i32_store(b, 2, 4)\n  emit_local_get(b, 0)\n  emit_local_get(b, 0)\n  emit_i32_const(b, 12)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 8)\n  emit_local_get(b, 0)\n  emit_i64_extend_i32_u(b)\n  b\n}\n\nexport let gen_arr_set_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 3)\n  emit_local_get(b, 3)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 2)\n  emit_i64_store(b, 3, 0)\n  b\n}\n\nexport let gen_str_len_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i64_const(b, 4294967295)\n  // 0xFFFFFFFF\n  emit_i64_and(b)\n  b\n}\n\nexport let gen_arr_push_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 3)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 5)\n  emit_local_get(b, 4)\n  emit_local_get(b, 3)\n  emit_i32_ge_u(b)\n  emit_if_void(b)\n  emit_local_get(b, 3)\n  emit_i32_const(b, 2)\n  emit_i32_mul(b)\n  emit_local_set(b, 7)\n  emit_global_get(b, 0)\n  emit_local_tee(b, 6)\n  emit_local_get(b, 7)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  emit_local_get(b, 6)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_memory_copy(b)\n  emit_local_get(b, 2)\n  emit_local_get(b, 7)\n  emit_i32_store(b, 2, 0)\n  // cap = new_cap\n  emit_local_get(b, 2)\n  emit_local_get(b, 6)\n  emit_i32_store(b, 2, 8)\n  // data_ptr = new_data\n  emit_local_get(b, 6)\n  emit_local_set(b, 5)\n  emit_end(b)\n  emit_local_get(b, 5)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 3)\n  bytebuf_push(b, 116)\n  // i32.shl\n  emit_i32_add(b)\n  emit_local_get(b, 1)\n  emit_i64_store(b, 3, 0)\n  emit_local_get(b, 2)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 1)\n  emit_i32_add(b)\n  emit_i32_store(b, 2, 4)\n  b\n}\n\n// Array::push_all(dst, src) -> Unit\n// Appends all elements of src to dst in-place using memory.copy.\n// Layout: offset 0 = cap, offset 4 = len, offset 8 = data_ptr\n// Elements are i64 (8 bytes each) at data_ptr + idx*8.\n// Locals: 0=dst(i64), 1=src(i64), 2=dst_ptr(i32), 3=src_ptr(i32),\n//         4=dst_len(i32), 5=src_len(i32), 6=dst_data(i32), 7=src_data(i32),\n//         8=dst_cap(i32), 9=new_cap(i32), 10=new_data(i32)\nexport let gen_arr_push_all_body = () -> Array[Int] {\n  let b = bytebuf_new()\n  // dst_ptr = untag(dst)\n  emit_local_get(b, 0)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 2)\n  // src_ptr = untag(src)\n  emit_local_get(b, 1)\n  emit_i32_wrap_i64(b)\n  emit_local_set(b, 3)\n  // dst_len = dst_ptr[4]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 4)\n  // src_len = src_ptr[4]\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 4)\n  emit_local_set(b, 5)\n  // dst_data = dst_ptr[8]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 6)\n  // src_data = src_ptr[8]\n  emit_local_get(b, 3)\n  emit_i32_load(b, 2, 8)\n  emit_local_set(b, 7)\n  // dst_cap = dst_ptr[0]\n  emit_local_get(b, 2)\n  emit_i32_load(b, 2, 0)\n  emit_local_set(b, 8)\n  // if dst_len + src_len > dst_cap { grow }\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_local_get(b, 8)\n  emit_i32_gt_u(b)\n  emit_if_void(b)\n  // new_cap = (dst_len + src_len) * 2\n  emit_local_get(b, 4)\n  emit_local_get(b, 5)\n  emit_i32_add(b)\n  emit_i32_const(b, 2)\n  emit_i32_mul(b)\n  emit_local_set(b, 9)\n  // new_data = heap; heap += new_cap * 8\n  emit_global_get(b, 0)\n  emit_local_tee(b, 10)\n  emit_local_get(b, 9)\n  emit_i32_const(b, 8)\n  emit_i32_mul(b)\n  emit_i32_add(b)\n  emit_global_set(b, 0)\n  // memory.copy(new_data, dst_data, dst_len * 8)\n  emit_local_get(b, 10)\n  emit_local_get(b, 6)\n  emit_local_get(b, 4)\n  emit_i32_const(b, 