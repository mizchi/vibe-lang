  let source_94 = ("vibe/compiler/codegen/gc/backend_match.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet compile_match_gc = (buf: Bytes, scrutinee: Expr, arms: Array[(Pat, Expr)], local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, ce: (Bytes, Expr, Array[String], Int, Int) -> Int with { Error }) -> Int with { Error } {\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, scrutinee, local_names, next_local + 1, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(arms)\n  let catchall_idx = find_catchall_idx(arms)\n  let num_cond_arms = catchall_idx\n  let mut max_nl = nl1\n  let mut ai = 0\n  while ai < num_cond_arms {\n    let (p, _) = Array::get(arms, ai)\n    match p {\n      PInt(n) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, n)\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PBool(bv) => {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if bv {\n          1\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PCtor(cname_cond, _) => {\n        let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n        let expected_tag = if ctor_ci >= 0 {\n          Array::get(ctx.ctor_table.tags, ctor_ci)\n        } else {\n          -1\n        }\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n        emit_i32_wrap_i64(buf)\n        emit_i32_load(buf, 2, 0)\n        emit_i32_const(buf, expected_tag)\n        emit_i32_eq(buf)\n        emit_if_i64(buf)\n        0\n      },\n      PString(sval) => {\n        let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n        if str_idx >= 0 {\n          emit_local_get(buf, scrut_local)\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n          emit_call(buf, 4)\n          emit_i64_const(buf, 1)\n          emit_i64_eq(buf)\n          emit_if_i64(buf)\n        }\n        0\n      },\n      _ => 0\n    }\n    let names_len_at_arm = Array::length(local_names)\n    let (p2, arm_body) = Array::get(arms, ai)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    match p2 {\n      PCtor(_, cargs_bind) => {\n        let mut cbi = 0\n        while cbi < Array::length(cargs_bind) {\n          match Array::get(cargs_bind, cbi) {\n            PBind(pname) => {\n              let fl = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi * 8)\n              emit_local_set(buf, fl)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi = cbi + 1\n        }\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl {\n          max_nl = arm_nl\n        }\n        0\n      },\n      PTuple(tpats) => {\n        let mut tbi = 0\n        while tbi < Array::length(tpats) {\n          match Array::get(tpats, tbi) {\n            PBind(tname) => {\n              let tl = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + tbi * 8)\n              emit_local_set(buf, tl)\n              Array::push(local_names, tname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          tbi = tbi + 1\n        }\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl {\n          max_nl = arm_nl\n        }\n        0\n      },\n      PBind(bname_arm) => {\n        let bl = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bl)\n        Array::push(local_names, bname_arm)\n        let arm_nl = ce(buf, arm_body, local_names, Array::length(local_names), ld_arm)\n        if arm_nl > max_nl {\n          max_nl = arm_nl\n        }\n        0\n      },\n      _ => {\n        let arm_nl = ce(buf, arm_body, local_names, nl1, ld_arm)\n        if arm_nl > max_nl {\n          max_nl = arm_nl\n        }\n        0\n      }\n    }\n    emit_else(buf)\n    Array::truncate(local_names, names_len_at_arm)\n    ai = ai + 1\n  }\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let _names_len_at_catch = Array::length(local_names)\n  if catchall_idx < num_arms {\n    let (cp, cbody) = Array::get(arms, catchall_idx)\n    let catch_nl = match cp {\n      PBind(bname) => {\n        let bind_local = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, bind_local)\n        Array::push(local_names, bname)\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PCtor(_cname, cargs) => {\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          match Array::get(cargs, cbi2) {\n            PBind(pname) => {\n              let fl2 = Array::length(local_names)\n              emit_local_get(buf, scrut_local)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + cbi2 * 8)\n              emit_local_set(buf, fl2)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => 0\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      PTuple(pats) => {\n        let ptr_local2 = Array::length(local_names)\n        emit_local_get(buf, scrut_local)\n        emit_local_set(buf, ptr_local2)\n        Array::push(local_names, \"__tup_ptr2\")\n        let mut pi2 = 0\n        while pi2 < Array::length(pats) {\n          let tp = Array::get(pats, pi2)\n          match tp {\n            PBind(pname) => {\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            },\n            PWild => 0,\n            _ => throw(\"unsupported pattern in tuple destructure\")\n          }\n          pi2 = pi2 + 1\n        }\n        ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n      },\n      _ => ce(buf, cbody, local_names, Array::length(local_names), ld_catch)\n    }\n    if catch_nl > max_nl {\n      max_nl = catch_nl\n    }\n    0\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n\n\nexport {\n  compile_match_gc\n}\n")

  let source_95 = ("vibe/compiler/codegen/gc/backend_lambda_ctx.vibe",
"\n\n\nlet make_lambda_ctx_gc = (ctx: CompileCtxGc, ref_cell_names: Array[String], ref_local_indices: Array[Int]) -> CompileCtxGc {\n  CompileCtxGc::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: ref_cell_names, ref_local_indices: ref_local_indices,\n    refcell_type_idx: ctx.refcell_type_idx, closure_type_base: ctx.closure_type_base,\n    ctor_table: ctx.ctor_table\n  }\n}\n\n\nexport {\n  make_lambda_ctx_gc\n}\n")

  let source_96 = ("vibe/compiler/codegen/gc/backend_lambda_emit.vibe",
"\n\n\n\n\n\nlet emit_lambda_closure_gc = (buf: Bytes, captures: Array[String], num_captures: Int, local_names: Array[String], next_local: Int, table_slot: Int) -> Int with { Error } {\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let cap_idx = resolve_local(local_names, cap_name, \"gc_cap\")\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cap_idx)\n      emit_i64_store(buf, 3, 8 + csi * 8)\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n\n\nexport {\n  emit_lambda_closure_gc\n}\n")

  let source_97 = ("vibe/compiler/codegen/gc/backend_lambda_sig.vibe",
"\n\n\n\nexport type CompileLambdaGcFn = (Bytes, Expr, Array[String], Int, CompileCtxGc, Int) -> Int with { Error }\n")

  let source_98 = ("vibe/compiler/codegen/gc/backend_lambda_body.vibe",
"\n\n\n\n\n\n\n\n\nexport let compile_lambda_gc = (buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtxGc, ld: Int, compile_fn: CompileLambdaGcFn) -> Int with { Error } {\n  let (captures, num_captures, user_params) = collect_lambda_captures_gc(params, fn_body, ctx)\n  let (lam_buf, final_lam_nl) = compile_lambda_inner_gc(params, fn_body, captures, user_params, ctx, compile_fn, ld)\n  let lambda_idx = record_lambda_meta_gc(ctx, lam_buf, user_params, captures, final_lam_nl)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  emit_lambda_closure_gc(buf, captures, num_captures, local_names, next_local, table_slot)\n}\n")

  let source_99 = ("vibe/compiler/codegen/gc/backend_lambda_collect.vibe",
"\n\n\n\n\nexport let collect_lambda_captures_gc = (params: Array[(String, Option[TypeExpr])], fn_body: Expr, ctx: CompileCtxGc) -> (Array[String], Int, Int) {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let func_table = ctx.func_table\n  let ctor_table = ctx.ctor_table\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(func_table.names, ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  (captures, num_captures, user_params)\n}\n")

  let source_100 = ("vibe/compiler/codegen/gc/backend_lambda_inner.vibe",
"\n\n\n\n\n\n\n\nexport let compile_lambda_inner_gc = (params: Array[(String, Option[TypeExpr])], fn_body: Expr, captures: Array[String], user_params: Int, ctx: CompileCtxGc, compile_fn: CompileLambdaGcFn, ld: Int) -> (Bytes, Int)with { Error } {\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname, _) = Array::get(params, lpi)\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let lam_ref_local_indices = Array::slice([\n    0\n  ], 0, 0)\n  let num_captures = Array::length(captures)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = make_lambda_ctx_gc(ctx, lam_ref_cells, lam_ref_local_indices)\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, ld)\n  (lam_buf, final_lam_nl)\n}\n")

  let source_101 = ("vibe/compiler/codegen/gc/backend_lambda_record.vibe",
"\n\n\nexport let record_lambda_meta_gc = (ctx: CompileCtxGc, lam_buf: Bytes, user_params: Int, captures: Array[String], final_lam_nl: Int) -> Int {\n  let lambda_table = ctx.lambda_table\n  let lambda_idx = Array::length(lambda_table.bodies)\n  Array::push(lambda_table.bodies, lam_buf)\n  Array::push(lambda_table.param_counts, user_params + 1)\n  Array::push(lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if final_lam_nl > min_lam_nl {\n    extra_lam = final_lam_nl - min_lam_nl\n  }\n  Array::push(lambda_table.meta_i32, 0)\n  Array::push(lambda_table.meta_i64, extra_lam)\n  lambda_idx\n}\n")

  let source_102 = ("vibe/compiler/codegen/index.vibe",
"\n\n\n\n\nexport let compile_module = (stmts: Array[Stmt]) -> Bytes with { Error } {\n  compile_module_expr(stmts)\n}\n\nexport let compile_wasi_module_with_sources = (stmts: Array[Stmt], entry_name: String, selfhost_srcs: Array[(String, String)]) -> Bytes with { Error } {\n  compile_wasi_module_with_sources_impl(stmts, entry_name, selfhost_srcs)\n}\n\nexport let compile_wasi_module = (stmts: Array[Stmt], entry_name: String) -> Bytes with { Error } {\n  compile_wasi_module_impl(stmts, entry_name)\n}\n")

  let source_103 = ("vibe/compiler/codegen.vibe",
"\n\n\nexport {\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources\n}\n")

  let source_104 = ("vibe/compiler/runtime/eval_loader/index.vibe",
"\n\n\n\n\n\nlet rec resolve_interp_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EStringInterp(parts) => {\n      let plen = Array::length(parts)\n      let exprs = ArrayBuilder::new()\n      let mut i = 0\n      while i < plen {\n        let lit = Array::get(parts, i)\n        if String::length(lit) > 0 {\n          ArrayBuilder::push(exprs, EString(lit))\n        }\n        if i + 1 < plen {\n          let expr_src = Array::get(parts, i + 1)\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\n          ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\"), [\n            resolved\n          ]))\n        }\n        i = i + 2\n      }\n      let out = ArrayBuilder::freeze(exprs)\n      let len = Array::length(out)\n      if len == 0 {\n        EString(\"\")\n      }\n      else {\n        let mut acc = Array::get(out, 0)\n        let mut j = 1\n        while j < len {\n          acc = ECall(EIdent(\"String::concat\"), [\n            acc,\n            Array::get(out, j)\n          ])\n          j = j + 1\n        }\n        acc\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    EIdent(_) => expr,\n    ETuple(elems) => ETuple(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    EArray(elems) => EArray(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    ERecord(fields) => ERecord(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EMap(fields) => EMap(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\n    ELet(name, value, body) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetMut(name, value, body) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_interp_expr(init)) }, resolve_interp_expr(body)),\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\n    ECall(callee, args) => ECall(resolve_interp_expr(callee), for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\n    EDot(inner, field) => EDot(resolve_interp_expr(inner), field),\n    EThrow(inner) => EThrow(resolve_interp_expr(inner)),\n    EBreak(opt) => match opt {\n      None => expr,\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\n    },\n    EContinue(args) => EContinue(for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\n  }\n}\n\nlet resolve_interp_stmt = (stmt: Stmt) -> Stmt with { Error } {\n  match stmt {\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\n    _ => stmt\n  }\n}\n\nexport let contains_str = (arr: Array[String], target: String) -> Bool {\n  let rec go = (i: Int) -> Bool {\n    if i >= Array::length(arr) {\n      false\n    }\n    else {\n      if Array::get(arr, i) == target {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let rec go = (i: Int) -> Option[String] {\n    if i >= Array::length(sources) {\n      None\n    }\n    else {\n      let (p, src) = Array::get(sources, i)\n      if p == path_key {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let load_and_parse = (source: String) -> Array[Stmt] with { Error } {\n  let tokens = lex(source)\n  for stmt in parse_program(tokens) {\n    resolve_interp_stmt(stmt)\n  }\n}\n\nexport let collect_exports = (stmts: Array[Stmt]) -> Array[String] {\n  let rec go = (i: Int, acc: Array[String]) -> Array[String] {\n    if i >= Array::length(stmts) {\n      acc\n    }\n    else {\n      let stmt = Array::get(stmts, i)\n      let new_acc = match stmt {\n        SLet(true, _, name, _, _) => Array::concat(acc, [\n          name\n        ]),\n        SEnum(true, _, variants) => {\n          let rec add_ctors = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= Array::length(variants) {\n              a\n            }\n            else {\n              let (cname, _) = Array::get(variants, j)\n              add_ctors(j + 1, Array::concat(a, [\n                cname\n              ]))\n            }\n          }\n          add_ctors(0, acc)\n        },\n        SExport(names) => {\n          let rec add_names = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= Array::length(names) {\n              a\n            }\n            else {\n              add_names(j + 1, Array::concat(a, [\n                Array::get(names, j)\n              ]))\n            }\n          }\n          add_names(0, acc)\n        },\n        SReExport(_, names) => {\n          let rec add_names = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= Array::length(names) {\n              a\n            }\n            else {\n              let (name, _) = Array::get(names, j)\n              add_names(j + 1, Array::concat(a, [\n                name\n              ]))\n            }\n          }\n          add_names(0, acc)\n        },\n        _ => acc\n      }\n      go(i + 1, new_acc)\n    }\n  }\n  go(0, Array::slice([\n    \"\"\n  ], 0, 0))\n}\n")

  let source_105 = ("vibe/compiler/ripple/index.vibe",
"export let version = \"0.1.0\"\n\n\nexport {\n  RippleDb,\n  ripple_new,\n  ripple_set_source,\n  ripple_get_source,\n  ripple_get_fingerprint,\n  ripple_get_deps,\n  ripple_record_eval,\n  ripple_eval_count\n}\n")

  let source_106 = ("vibe/compiler/ripple/ripple.vibe",
"\nexport enum RippleDb {\n  RippleDb(Array[(String, String)], Array[(String, String)], Array[(String, Array[String])], Int)\n}\n\n\nlet empty_strings = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_deps_pairs = () -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", empty_strings())\n  ], 0, 0)\n}\n\nlet rec lookup_deps_entry = (entries: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {\n  if i >= Array::length(entries) {\n    None\n  }\n  else {\n    let (k, deps) = Array::get(entries, i)\n    if k == key {\n      Some(deps)\n    }\n    else {\n      lookup_deps_entry(entries, key, i + 1)\n    }\n  }\n}\n\nexport let ripple_get_deps = (db: RippleDb, path: String) -> Option[Array[String]] {\n  match db {\n    RippleDb(_, _, deps_map, _) => lookup_deps_entry(deps_map, path, 0)\n  }\n}\n\nexport let ripple_eval_count = (db: RippleDb) -> Int {\n  match db {\n    RippleDb(_, _, _, count) => count\n  }\n}\n\nlet upsert_deps_entry = (entries: Array[(String, Array[String])], key: String, deps: Array[String]) -> Array[(String, Array[String])] {\n  let len = Array::length(entries)\n  let b = ArrayBuilder::new()\n  let rec go = (i: Int, found: Bool) -> Array[(String, Array[String])] {\n    if i >= len {\n      if found {\n        ArrayBuilder::freeze(b)\n      } else {\n        ArrayBuilder::push(b, (key, deps))\n        ArrayBuilder::freeze(b)\n      }\n    } else {\n      let (k, existing) = Array::get(entries, i)\n      if k == key {\n        ArrayBuilder::push(b, (key, deps))\n        go(i + 1, true)\n      } else {\n        ArrayBuilder::push(b, (k, existing))\n        go(i + 1, found)\n      }\n    }\n  }\n  go(0, false)\n}\n\nlet empty_string_pairs = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nexport let ripple_new = () -> RippleDb {\n  RippleDb(empty_string_pairs(), empty_string_pairs(), empty_deps_pairs(), 0)\n}\n\nlet rec lookup_string_entry = (entries: Array[(String, String)], key: String, i: Int) -> Option[String] {\n  if i >= Array::length(entries) {\n    None\n  }\n  else {\n    let (k, v) = Array::get(entries, i)\n    if k == key {\n      Some(v)\n    }\n    else {\n      lookup_string_entry(entries, key, i + 1)\n    }\n  }\n}\n\nexport let ripple_get_source = (db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(sources, _, _, _) => lookup_string_entry(sources, path, 0)\n  }\n}\n\nlet upsert_string_entry = (entries: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(entries)\n  let b = ArrayBuilder::new()\n  let rec go = (i: Int, found: Bool) -> Array[(String, String)] {\n    if i >= len {\n      if found {\n        ArrayBuilder::freeze(b)\n      } else {\n        ArrayBuilder::push(b, (key, value))\n        ArrayBuilder::freeze(b)\n      }\n    } else {\n      let (k, v) = Array::get(entries, i)\n      if k == key {\n        ArrayBuilder::push(b, (key, value))\n        go(i + 1, true)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        go(i + 1, found)\n      }\n    }\n  }\n  go(0, false)\n}\n\nexport let ripple_set_source = (db: RippleDb, path: String, source: String) -> RippleDb {\n  match db {\n    RippleDb(sources, fingerprints, deps_map, eval_count) => RippleDb(upsert_string_entry(sources, path, source), fingerprints, deps_map, eval_count)\n  }\n}\n\nexport let ripple_record_eval = (db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {\n  match db {\n    RippleDb(sources, fingerprints, deps_map, eval_count) => match lookup_string_entry(fingerprints, path, 0) {\n      Some(prev_fp) => if prev_fp == fingerprint {\n        RippleDb(sources, fingerprints, deps_map, eval_count)\n      } else {\n        RippleDb(sources, upsert_string_entry(fingerprints, path, fingerprint), upsert_deps_entry(deps_map, path, deps), eval_count + 1)\n      },\n      None => RippleDb(sources, upsert_string_entry(fingerprints, path, fingerprint), upsert_deps_entry(deps_map, path, deps), eval_count + 1)\n    }\n  }\n}\n\nexport let ripple_get_fingerprint = (db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(_, fingerprints, _, _) => lookup_string_entry(fingerprints, path, 0)\n  }\n}\n")

  let source_107 = ("vibe/compiler/runtime/typecheck_fs.vibe",
"\n\n\n\n\n\n\n\n\n\n\nlet dir_of = dir_of_path\n\nlet empty_stack = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet resolve_path = resolve_import_path\n\nlet empty_dep_fps = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet lookup_env_cache = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let rec go = (i: Int) -> Option[TypeEnv] {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nlet build_import_env = (stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          let dep_env = match lookup_env_cache(cache, resolved) {\n            Some(e) => e,\n            None => EnvEmpty\n          }\n          let dep_bindings = env_flat_bindings(dep_env)\n          let nlen = Array::length(names)\n          let rec bind_names = (j: Int, nacc: TypeEnv) -> TypeEnv {\n            if j >= nlen {\n              nacc\n            } else {\n              let (name, alias) = Array::get(names, j)\n              let bound_name = match alias {\n                Some(a) => a,\n                None => name\n              }\n              let ty = match env_lookup_flat(dep_bindings, name) {\n                Some(t) => t,\n                None => CtUnknown\n              }\n              bind_names(j + 1, env_bind(nacc, bound_name, ty))\n            }\n          }\n          bind_names(0, acc)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nlet upsert_env_cache = (cache: Array[(String, TypeEnv)], path: String, env: TypeEnv) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build = (i: Int) -> Array[(String, TypeEnv)] {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet build_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(acc, String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet copy_string_array = (items: Array[String]) -> Array[String] {\n  let len = Array::length(items)\n  let rec go = (index: Int, acc: Array[String]) -> Array[String] {\n    if index >= len {\n      acc\n    } else {\n      go(index + 1, Array::concat(acc, [\n        Array::get(items, index)\n      ]))\n    }\n  }\n  go(0, empty_stack())\n}\n\nlet lookup_string_pair = (pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let rec go = (i: Int) -> Option[String] {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_string_pair = (pairs: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build = (i: Int) -> Array[(String, String)] {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet parse_program_with_path = (path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    parse_program(lex(source))\n  } {\n    Error(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nlet store_persistent_type_env = (fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\n}\n\nlet finish_typecheck_fs_impl = (rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, source: String, deps: Array[String], fingerprint: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int)with { Error, Fs } {\n  match load_persistent_type_env(fingerprint) {\n    Some(cached_env) => {\n      let next_env_cache = upsert_env_cache(env_cache, path, cached_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n    },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let final_parse_count = parse_count + 1\n      let import_env = build_import_env(stmts, dir_of(path), env_cache)\n      let checked_env = match import_env {\n        EnvEmpty => check_program(stmts),\n        _ => check_program_with_env(stmts, import_env)\n      }\n      store_persistent_type_env(fingerprint, checked_env)\n      if Array::length(deps) == 0 {\n        Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))\n      } else {\n        ()\n      }\n      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n      (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)\n    }\n  }\n}\n\nlet collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let len = Array::length(stmts)\n  let rec go = (i: Int, acc: Array[String]) -> Array[String] {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => if String::length(raw_path) == 0 {\n          acc\n        } else {\n          let resolved = resolve_path(base_dir, raw_path)\n          if contains_str(acc, resolved) {\n            acc\n          } else {\n            Array::concat(acc, [\n              resolved\n            ])\n          }\n        }\n        ,\n        SReExport(raw_path, _) => if String::length(raw_path) == 0 {\n          acc\n        } else {\n          let resolved = resolve_path(base_dir, raw_path)\n          if contains_str(acc, resolved) {\n            acc\n          } else {\n            Array::concat(acc, [\n              resolved\n            ])\n          }\n        }\n        ,\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_stack())\n}\n\nlet load_or_parse_deps_for_source_fs = (dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int)with { Error } {\n  let stmts = parse_program_with_path(path, source)\n  let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n  (deps, upsert_string_pair(dep_source_cache, path, source), parse_count + 1)\n}\n\nlet resolve_deps_for_source_fs = (rdb: RippleDb, dep_source_cache: Array[(String, String)], path: String, source: String, parse_count: Int) -> (Array[String], Array[(String, String)], Int)with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n    if cached_source == source {\n      match ripple_get_deps(rdb, path) {\n        Some(deps) => (deps, dep_source_cache, parse_count),\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      }\n    } else {\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n    },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nlet rec ensure_fingerprint_fs_go = (rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int)with { Error, Fs } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => match load_persistent_leaf_fingerprint(path, source) {\n        Some(leaf_fingerprint) =>\n        match load_persistent_type_env(leaf_fingerprint) {\n          Some(cached_env) => {\n            let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n            if !(Fs::exists(dep_cache_path)) {\n              Fs::write_file(dep_cache_path, persistent_dep_list_text(empty_stack()))\n            } else {\n              ()\n            }\n            let next_env_cache = upsert_env_cache(env_cache, path, cached_env)\n            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n            (leaf_fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n          },\n          None =>\n          continue_fingerprint_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)\n        },\n        None =>\n        continue_fingerprint_fs_impl(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)\n      }\n    }\n  }\n}\n\nexport let ensure_fingerprint_fs_impl = (rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int)with { Error, Fs } {\n  ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)\n}\n\nlet continue_fingerprint_fs_impl = (rdb: RippleDb, env_cache: Array[(String, TypeEnv)], dep_source_cache: Array[(String, String)], parse_count: Int, path: String, stack: Array[String], source: String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int)with { Error, Fs } {\n  let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\n  let deps = copy_string_array(deps_raw)\n  Fs::write_file(persistent_dep_list_cache_path(path, compact_string_fingerprint(source)), persistent_dep_list_text(deps))\n  let dlen = Array::length(deps)\n  let next_stack = Array::concat(stack, [\n    path\n  ])\n  let mut i = 0\n  let mut db_after_deps = rdb\n  let mut env_cache_after_deps = env_cache\n  let mut dep_source_cache_after_deps = next_dep_source_cache\n  let mut parse_count_after_deps = initial_parse_count\n  let dep_fps = empty_dep_fps()\n  while i < dlen {\n    let dep_path = Array::get(deps, i)\n    let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, next_stack)\n    db_after_deps = next_db\n    env_cache_after_deps = next_env_cache\n    dep_source_cache_after_deps = next_dep_source_cache2\n    parse_count_after_deps = next_parse_count\n    Array::push(dep_fps, (dep_path, dep_fp))\n    i = i + 1\n  }\n  let fingerprint = build_fingerprint(source, dep_fps)\n  match ripple_get_fingerprint(db_after_deps, path) {\n    Some(cached_fp) =>\n    if cached_fp == fingerprint {\n      (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\n    } else {\n      finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n    },\n    None =>\n    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\n  }\n}\n")

  let source_108 = ("vibe/compiler/runtime/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\nenum StringTriple {\n  StringTriple(String, String, String)\n}\n\nenum TypeDbState {\n  TypeDbState(\n    RippleDb,\n    Array[(String, TypeEnv)],\n    Array[(String, String)],\n    Array[StringTriple],\n    Array[StringTriple],\n    Array[StringTriple],\n    Int,\n    Int,\n    Int,\n    Int\n  )\n}\n\nexport enum TypeDb {\n  TypeDb(TypeDbState)\n}\n\n\nlet unwrap_db = (db: TypeDb) -> TypeDbState {\n  match db {\n    TypeDb(state) => state\n  }\n}\n\nlet wrap_db = (state: TypeDbState) -> TypeDb {\n  TypeDb(state)\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet dir_of = dir_of_path\n\nlet resolve_path = resolve_import_path\n\nlet parse_program_with_path = (path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    parse_program(lex(source))\n  } {\n    Error(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nlet add_dep = (acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {\n  if String::length(raw_path) == 0 {\n    acc\n  } else {\n    let resolved = resolve_path(base_dir, raw_path)\n    if contains_str(acc, resolved) {\n      acc\n    } else {\n      Array::concat(acc, [\n        resolved\n      ])\n    }\n  }\n}\n\nlet empty_stack = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_dep_fps = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_env_cache = () -> Array[(String, TypeEnv)] {\n  Array::slice([\n    (\"\", EnvEmpty)\n  ], 0, 0)\n}\n\nlet empty_string_pairs = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_string_triples = () -> Array[StringTriple] {\n  Array::slice([\n    StringTriple(\"\", \"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_stmt_array = () -> Array[Stmt] {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nlet empty_type_bindings = () -> Array[(String, Type)] {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let db_new = () -> TypeDb {\n  wrap_db(\n    TypeDbState(\n      ripple_new(),\n      empty_env_cache(),\n      empty_string_pairs(),\n      empty_string_triples(),\n      empty_string_triples(),\n      empty_string_triples(),\n      0,\n      0,\n      0,\n      0\n    )\n  )\n}\n\nlet lookup_string_pair = (pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let rec go = (i: Int) -> Option[String] {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_string_pair = (\n  pairs: Array[(String, String)],\n  key: String,\n  value: String\n) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build = (i: Int) -> Array[(String, String)] {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if k == key {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet lookup_source_cache = (\n  cache: Array[StringTriple],\n  path: String,\n  fingerprint: String\n) -> Option[String] {\n  let len = Array::length(cache)\n  let rec go = (i: Int) -> Option[String] {\n    if i >= len {\n      None\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, source) =>\n          if p == path && fp == fingerprint {\n            Some(source)\n          } else {\n            go(i + 1)\n          }\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_source_cache = (\n  cache: Array[StringTriple],\n  path: String,\n  fingerprint: String,\n  source: String\n) -> Array[StringTriple] {\n  let len = Array::length(cache)\n  let rec build = (i: Int, acc: Array[StringTriple]) -> Array[StringTriple] {\n    if i >= len {\n      acc\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, existing) =>\n          if p == path && fp == fingerprint {\n            build(i + 1, acc)\n          } else {\n            build(i + 1, Array::concat(acc, [\n              StringTriple(p, fp, existing)\n            ]))\n          }\n      }\n    }\n  }\n  Array::concat(build(0, empty_string_triples()), [\n    StringTriple(path, fingerprint, source)\n  ])\n}\n\nexport let db_set_source = (db: TypeDb, path: String, source: String) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          ripple_set_source(rdb, path, source),\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n  }\n}\n\nlet lookup_env_cache = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let rec go = (i: Int) -> Option[TypeEnv] {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if p == path {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let db_check_env = (db: TypeDb, path: String) -> Option[TypeEnv] {\n  match unwrap_db(db) {\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\n  }\n}\n\nlet build_import_env = (stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          let dep_env = match lookup_env_cache(cache, resolved) {\n            Some(e) => e,\n            None => EnvEmpty\n          }\n          let dep_bindings = env_flat_bindings(dep_env)\n          let nlen = Array::length(names)\n          let rec bind_names = (j: Int, nacc: TypeEnv) -> TypeEnv {\n            if j >= nlen {\n              nacc\n            } else {\n              let (name, alias) = Array::get(names, j)\n              let bound_name = match alias {\n                Some(a) => a,\n                None => name\n              }\n              let ty = match env_lookup_flat(dep_bindings, name) {\n                Some(t) => t,\n                None => CtUnknown\n              }\n              bind_names(j + 1, env_bind(nacc, bound_name, ty))\n            }\n          }\n          bind_names(0, acc)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nlet upsert_env_cache = (\n  cache: Array[(String, TypeEnv)],\n  path: String,\n  env: TypeEnv\n) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build = (i: Int) -> Array[(String, TypeEnv)] {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet compact_string_fingerprint = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet store_persistent_type_env = (fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_type_env_cache_path(fingerprint),\n    persistent_type_env_cache_text(env)\n  )\n}\n\nlet build_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let db_typecheck_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\n  }\n}\n\nexport let db_parse_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\n  }\n}\n\nexport let db_merge_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\n  }\n}\n\nexport let db_module_source_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\n  }\n}\n\nexport let db_codegen_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\n  }\n}\n\nlet collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let len = Array::length(stmts)\n  let rec go = (i: Int, acc: Array[String]) -> Array[String] {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_stack())\n}\n\nlet resolve_deps_for_source = (\n  rdb: RippleDb,\n  dep_source_cache: Array[(String, String)],\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[(String, String)], Int) with { Error } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if cached_source == source {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n            (\n              deps,\n              upsert_string_pair(dep_source_cache, path, source),\n              parse_count + 1\n            )\n          }\n        }\n      } else {\n        let stmts = parse_program_with_path(path, source)\n        let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n        (\n          deps,\n          upsert_string_pair(dep_source_cache, path, source),\n          parse_count + 1\n        )\n      },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n      (\n        deps,\n        upsert_string_pair(dep_source_cache, path, source),\n        parse_count + 1\n      )\n    }\n  }\n}\n\nlet load_or_parse_deps_for_source_fs = (\n  dep_source_cache: Array[(String, String)],\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[(String, String)], Int) with { Error } {\n  let stmts = parse_program_with_path(path, source)\n  let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n  (\n    deps,\n    upsert_string_pair(dep_source_cache, path, source),\n    parse_count + 1\n  )\n}\n\nlet resolve_deps_for_source_fs = (\n  rdb: RippleDb,\n  dep_source_cache: Array[(String, String)],\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if cached_source == source {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n        }\n      } else {\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nlet rec ensure_fingerprint = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  stack: Array[String]\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(\n          rdb,\n          dep_source_cache,\n          path,\n          source,\n          parse_count\n        )\n        let dlen = Array::length(deps)\n        let next_stack = Array::concat(stack, [\n          path\n        ])\n        let rec resolve_nested = (\n          i: Int,\n          dep_acc: Array[(String, String)],\n          dep_db: RippleDb,\n          dep_env_cache: Array[(String, TypeEnv)],\n          dep_source_cache2: Array[(String, String)],\n          dep_parse_count: Int\n        ) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n          if i >= dlen {\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\n          } else {\n            let dep_path = Array::get(deps, i)\n            let (\n              dep_fp,\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            ) = ensure_fingerprint(\n              dep_db,\n              dep_env_cache,\n              dep_source_cache2,\n              dep_parse_count,\n              dep_path,\n              next_stack\n            )\n            resolve_nested(\n              i + 1,\n              Array::concat(dep_acc, [\n                (dep_path, dep_fp)\n              ]),\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            )\n          }\n        }\n        let resolved_nested = resolve_nested(\n          0,\n          empty_dep_fps(),\n          rdb,\n          env_cache,\n          next_dep_source_cache,\n          initial_parse_count\n        )\n        let dep_fps = resolved_nested.0\n        let db_after_deps = resolved_nested.1\n        let env_cache_after_deps = resolved_nested.2\n        let dep_source_cache_after_deps = resolved_nested.3\n        let parse_count_after_deps = resolved_nested.4\n        let fingerprint = build_fingerprint(source, dep_fps)\n        match ripple_get_fingerprint(db_after_deps, path) {\n          Some(cached_fp) =>\n            if cached_fp == fingerprint {\n              (\n                fingerprint,\n                db_after_deps,\n                env_cache_after_deps,\n                dep_source_cache_after_deps,\n                parse_count_after_deps\n              )\n            } else {\n              let stmts = parse_program_with_path(path, source)\n              let final_parse_count = parse_count_after_deps + 1\n              let import_env = build_import_env(stmts, dir_of(path), env_cache_after_deps)\n              let checked_env = check_program_with_env(stmts, import_env)\n              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n              (\n                fingerprint,\n                next_db,\n                next_env_cache,\n                dep_source_cache_after_deps,\n                final_parse_count\n              )\n            },\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (\n              fingerprint,\n              next_db,\n              next_env_cache,\n              dep_source_cache_after_deps,\n              final_parse_count\n            )\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let db_typecheck = (db: TypeDb, path: String) -> TypeDb with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_stack()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nlet rec ensure_fingerprint_fs = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  stack: Array[String]\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        match load_persistent_leaf_fingerprint(path, source) {\n          Some(leaf_fingerprint) =>\n            match load_persistent_type_env(leaf_fingerprint) {\n              Some(cached_env) => {\n                let next_env_cache = upsert_env_cache(env_cache, path, cached_env)\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n                (\n                  leaf_fingerprint,\n                  next_db,\n                  next_env_cache,\n                  dep_source_cache,\n                  parse_count\n                )\n              },\n              None => continue_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)\n            },\n          None => continue_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)\n        }\n      }\n    }\n  }\n}\n\nlet continue_fingerprint_fs = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  stack: Array[String],\n  source: String\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(\n    rdb,\n    dep_source_cache,\n    path,\n    source,\n    parse_count\n  )\n  Fs::write_file(\n    persistent_dep_list_cache_path(path, compact_string_fingerprint(source)),\n    persistent_dep_list_text(deps)\n  )\n  let dlen = Array::length(deps)\n  let next_stack = Array::concat(stack, [\n    path\n  ])\n  let dep_fps = empty_dep_fps()\n  let rec load_deps = (\n    index: Int,\n    current_db: RippleDb,\n    current_env_cache: Array[(String, TypeEnv)],\n    current_dep_source_cache: Array[(String, String)],\n    current_parse_count: Int\n  ) -> (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n    if index >= dlen {\n      (\n        current_db,\n        current_env_cache,\n        current_dep_source_cache,\n        current_parse_count\n      )\n    } else {\n      let dep_path = Array::get(deps, index)\n      let (\n        dep_fp,\n        next_db,\n        next_env_cache,\n        next_dep_source_cache2,\n        next_parse_count\n      ) = ensure_fingerprint_fs(\n        current_db,\n        current_env_cache,\n        current_dep_source_cache,\n        current_parse_count,\n        dep_path,\n        next_stack\n      )\n      Array::push(dep_fps, (dep_path, dep_fp))\n      load_deps(\n        index + 1,\n        next_db,\n        next_env_cache,\n        next_dep_source_cache2,\n        next_parse_count\n      )\n    }\n  }\n  let (\n    db_after_deps,\n    env_cache_after_deps,\n    dep_source_cache_after_deps,\n    parse_count_after_deps\n  ) = load_deps(0, rdb, env_cache, next_dep_source_cache, initial_parse_count)\n  let fingerprint = build_fingerprint(source, dep_fps)\n  match ripple_get_fingerprint(db_after_deps, path) {\n    Some(cached_fp) =>\n      if cached_fp == fingerprint {\n        (\n          fingerprint,\n          db_after_deps,\n          env_cache_after_deps,\n          dep_source_cache_after_deps,\n          parse_count_after_deps\n        )\n      } else {\n        finish_typecheck_fs(\n          db_after_deps,\n          env_cache_after_deps,\n          dep_source_cache_after_deps,\n          parse_count_after_deps,\n          path,\n          source,\n          deps,\n          fingerprint\n        )\n      },\n    None =>\n      finish_typecheck_fs(\n        db_after_deps,\n        env_cache_after_deps,\n        dep_source_cache_after_deps,\n        parse_count_after_deps,\n        path,\n        source,\n        deps,\n        fingerprint\n      )\n  }\n}\n\nlet finish_typecheck_fs = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  source: String,\n  deps: Array[String],\n  fingerprint: String\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_type_env(fingerprint) {\n    Some(cached_env) => {\n      let next_env_cache = upsert_env_cache(env_cache, path, cached_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n    },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let final_parse_count = parse_count + 1\n      let import_env = build_import_env(stmts, dir_of(path), env_cache)\n      let checked_env = check_program_with_env(stmts, import_env)\n      store_persistent_type_env(fingerprint, checked_env)\n      if Array::length(deps) == 0 {\n        Fs::write_file(\n          persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)),\n          persistent_leaf_fingerprint_text(fingerprint)\n        )\n      } else {\n        ()\n      }\n      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n      (\n        fingerprint,\n        next_db,\n        next_env_cache,\n        dep_source_cache,\n        final_parse_count\n      )\n    }\n  }\n}\n\nexport let db_typecheck_fs = (db: TypeDb, path: String) -> TypeDb with { Error, Fs } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint_fs_impl(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_stack()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nexport let db_program_source = (db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {\n  let checked = db_typecheck(db, path)\n  match unwrap_db(checked) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\n      match ripple_get_source(rdb, path) {\n        None => throw(String::concat(\"missing:\", path)),\n        Some(source) =>\n          match ripple_get_fingerprint(rdb, path) {\n            Some(fingerprint) => (source, fingerprint, checked),\n            None => (source, source, checked)\n          }\n      }\n  }\n}\n\nlet build_merge_fingerprint = (sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", compact_string_fingerprint(source))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_grouped_merge_fingerprint = (group_fingerprints: Array[(String, String)]) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(group_fingerprints) {\n    let (group_name, fingerprint) = Array::get(group_fingerprints, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_merged_source = (sources: Array[(String, String)]) -> String with { Error } {\n  let merged = empty_stmt_array()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, source) = Array::get(sources, si)\n    let stmts = parse_program_with_path(\"(merged)\", source)\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt),\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  print_program(merged)\n}\n\nlet join_group_sources = (group_sources: Array[(String, String)]) -> String {\n  let len = Array::length(group_sources)\n  let rec go = (i: Int, acc: String) -> String {\n    if i >= len {\n      acc\n    } else {\n      let (_, source) = Array::get(group_sources, i)\n      let next = if acc == \"\" {\n        source\n      } else {\n        String::concat(acc, String::concat(\"\\n\", source))\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, \"\")\n}\n\nexport let db_merged_source = (\n  db: TypeDb,\n  _entry_path: String,\n  sources: Array[(String, String)]\n) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let merge_fingerprint = build_merge_fingerprint(sources)\n      let merge_cache_key = \"merged\"\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\n        None => {\n          let merged_source = build_merged_source(sources)\n          let next_merged_cache = upsert_source_cache(\n            merged_cache,\n            merge_cache_key,\n            merge_fingerprint,\n            merged_source\n          )\n          (\n            merged_source,\n            merge_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nexport let db_grouped_merged_source = (\n  db: TypeDb,\n  groups: Array[(String, Array[(String, String)])]\n) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let rec load_groups = (\n        i: Int,\n        group_fingerprints: Array[(String, String)],\n        group_sources: Array[(String, String)],\n        cache_acc: Array[StringTriple],\n        merge_count_acc: Int\n      ) -> (Array[(String, String)], Array[(String, String)], Array[StringTriple], Int) with { Error } {\n        if i >= Array::length(groups) {\n          (group_fingerprints, group_sources, cache_acc, merge_count_acc)\n        } else {\n          let (group_name, sources) = Array::get(groups, i)\n          let fingerprint = build_merge_fingerprint(sources)\n          let cache_key = String::concat(\"merged-group|\", group_name)\n          match lookup_source_cache(cache_acc, cache_key, fingerprint) {\n            Some(source) =>\n              load_groups(\n                i + 1,\n                Array::concat(group_fingerprints, [(group_name, fingerprint)]),\n                Array::concat(group_sources, [(group_name, source)]),\n                cache_acc,\n                merge_count_acc\n              ),\n            None => {\n              let source = build_merged_source(sources)\n              let next_cache = upsert_source_cache(cache_acc, cache_key, fingerprint, source)\n              load_groups(\n                i + 1,\n                Array::concat(group_fingerprints, [(group_name, fingerprint)]),\n                Array::concat(group_sources, [(group_name, source)]),\n                next_cache,\n                merge_count_acc + 1\n              )\n            }\n          }\n        }\n      }\n      let (group_fingerprints, group_sources, next_merged_cache, next_merge_count) = load_groups(\n        0,\n        empty_string_pairs(),\n        empty_string_pairs(),\n        merged_cache,\n        merge_count\n      )\n      let grouped_fingerprint = build_grouped_merge_fingerprint(group_fingerprints)\n      let grouped_cache_key = \"merged-groups\"\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\n        Some(source) =>\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count,\n                module_source_count,\n                codegen_count\n              )\n            )\n          ),\n        None => {\n          let source = join_group_sources(group_sources)\n          let final_merged_cache = upsert_source_cache(\n            next_merged_cache,\n            grouped_cache_key,\n            grouped_fingerprint,\n            source\n          )\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                final_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nlet build_module_source = (source: String) -> String with { Error } {\n  let stmts = parse_program(lex(source))\n  let filtered = empty_stmt_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let keep = match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => true,\n          _ => false\n        }\n      },\n      _ => false\n    }\n    if keep {\n      Array::push(filtered, stmt)\n    }\n    i = i + 1\n  }\n  print_program(filtered)\n}\n\nexport let db_module_source = (db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let module_cache_key = \"module-source\"\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\n        Some(module_source) => (module_source, db),\n        None => {\n          let module_source = build_module_source(source)\n          let next_module_source_cache = upsert_source_cache(\n            module_source_cache,\n            module_cache_key,\n            fingerprint,\n            module_source\n          )\n          (\n            module_source,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                merged_cache,\n                next_module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count,\n                module_source_count + 1,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nlet artifact_cache_key = (kind: String, entry_name: String) -> String {\n  String::concat(kind, String::concat(\"|\", entry_name))\n}\n\nlet bytes_to_hex_digit = (n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nlet nibble_from_hex_char = (c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nlet bytes_to_hex = (bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  let mut out = \"\"\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    out = String::concat(out, bytes_to_hex_digit(hi))\n    out = String::concat(out, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  out\n}\n\nlet hex_to_bytes = (hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Bytes::new()\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Bytes::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    out\n  }\n}\n\nexport let db_load_artifact = (db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\n      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\n        Some(hex) => Some(hex_to_bytes(hex)),\n        None => None\n      }\n  }\n}\n\nexport let db_store_artifact = (\n  db: TypeDb,\n  _path: String,\n  kind: String,\n  entry_name: String,\n  fingerprint: String,\n  bytes: Bytes\n) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          rdb,\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          upsert_source_cache(\n            artifact_cache,\n            artifact_cache_key(kind, entry_name),\n            fingerprint,\n            bytes_to_hex(bytes)\n          ),\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count + 1\n        )\n      )\n  }\n}\n")

  let source_109 = ("vibe/compiler/type_db.vibe",
"\n\n\nexport {\n  TypeDb, db_new, db_check_env, db_typecheck, db_typecheck_fs, db_set_source, db_merge_count, db_parse_count, db_codegen_count, db_load_artifact, db_merged_source, db_module_source, db_program_source, db_store_artifact, db_typecheck_count, db_module_source_count, db_grouped_merged_source\n}\n\nexport {\n  TypeDb, db_new, db_check_env, db_typecheck, db_set_source, db_merge_count, db_parse_count, db_typecheck_fs, db_codegen_count, db_load_artifact, db_merged_source, db_module_source, db_program_source, db_store_artifact, db_typecheck_count, db_module_source_count, db_grouped_merged_source\n}\n")

  let source_110 = ("vibe/compiler/cache/persistent/index.vibe",
"\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet bytes_to_hex_digit = (n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nlet nibble_from_hex_char = (c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nlet bytes_to_hex = (bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  let mut out = \"\"\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    out = String::concat(out, bytes_to_hex_digit(hi))\n    out = String::concat(out, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  out\n}\n\nlet hex_to_bytes = (hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Bytes::new()\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Bytes::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    out\n  }\n}\n\nexport let compact_string_fingerprint = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nexport let normalize_persistent_cache_text = (text: String) -> String {\n  let len = String::length(text)\n  let mut start = 0\n  while start < len && String::char_code_at(text, start) == 0 {\n    start = start + 1\n  }\n  if start == 0 {\n    text\n  } else {\n    text[start:len]\n  }\n}\n\nlet build_sources_fingerprint = (sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", compact_string_fingerprint(source))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_sources_fingerprint_from_compact_fingerprints = (\n  source_fingerprints: Array[String]\n) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(source_fingerprints) {\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", Array::get(source_fingerprints, i))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_source_groups_fingerprint = (groups: Array[(String, Array[(String, String)])]) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, i)\n    let fingerprint = build_sources_fingerprint(sources)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_source_groups_fingerprint_from_compact_fingerprints = (\n  groups: Array[(String, Array[(String, String)])]\n) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, specs) = Array::get(groups, i)\n    let source_fingerprints = Array::slice([\"\"], 0, 0)\n    let mut j = 0\n    while j < Array::length(specs) {\n      let (_, source_fingerprint) = Array::get(specs, j)\n      Array::push(source_fingerprints, source_fingerprint)\n      j = j + 1\n    }\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet stable_cache_path = (prefix: String, seed: String, suffix: String) -> String {\n  let raw = compact_string_fingerprint(String::concat(\"persistent-cache-v3|\", seed))\n  let mut token = \"\"\n  let mut i = 0\n  while i < String::length(raw) {\n    let c = String::char_code_at(raw, i)\n    let piece = if c == 58 {\n      \"_\"\n    } else {\n      String::from_char_code(c)\n    }\n    token = String::concat(\n      token,\n      piece\n    )\n    i = i + 1\n  }\n  String::concat(\n    \"_build/vibe_\",\n    String::concat(\n      prefix,\n      String::concat(\n        \"_\",\n        String::concat(token, suffix)\n      )\n    )\n  )\n}\n\nexport let persistent_source_list_cache_path = (entry_path: String) -> String {\n  stable_cache_path(\"selfhost_source_list\", entry_path, \".tsv\")\n}\n\nexport let persistent_source_group_cache_path = (entry_path: String) -> String {\n  stable_cache_path(\"selfhost_source_groups\", entry_path, \".tsv\")\n}\n\nexport let persistent_manifest_header_cache_path = (entry_path: String) -> String {\n  stable_cache_path(\"selfhost_manifest_headers\", entry_path, \".tsv\")\n}\n\nexport let persistent_type_env_cache_path = (fingerprint: String) -> String {\n  stable_cache_path(\"selfhost_type_env_v2\", fingerprint, \".tsv\")\n}\n\nexport let persistent_dep_list_cache_path = (path: String, source_fingerprint: String) -> String {\n  stable_cache_path(\n    \"selfhost_dep_list\",\n    String::concat(path, String::concat(\"|\", source_fingerprint)),\n    \".tsv\"\n  )\n}\n\nexport let persistent_leaf_fingerprint_cache_path = (path: String, source_fingerprint: String) -> String {\n  stable_cache_path(\n    \"selfhost_leaf_fp_v2\",\n    String::concat(path, String::concat(\"|\", source_fingerprint)),\n    \".tsv\"\n  )\n}\n\nexport let persistent_module_header_cache_path = (path: String, source_fingerprint: String) -> String {\n  stable_cache_path(\n    \"selfhost_module_header_v2\",\n    String::concat(path, String::concat(\"|\", source_fingerprint)),\n    \".tsv\"\n  )\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String,\n  mode: String\n) -> String {\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups),\n    entry_name,\n    mode\n  )\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String,\n  entry_name: String,\n  mode: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\n      \"file-compile|\",\n      String::concat(\n        source_groups_fingerprint,\n        String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode)))\n      )\n    )\n  )\n}\n\nexport let build_file_compile_module_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])]\n) -> String {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups)\n  )\n}\n\nexport let build_file_compile_module_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\"file-compile-module|\", source_groups_fingerprint)\n  )\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> String {\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups),\n    entry_name\n  )\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String,\n  entry_name: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\n      \"fs-compile|\",\n      String::concat(source_groups_fingerprint, String::concat(\"|\", entry_name))\n    )\n  )\n}\n\nexport let build_fs_compile_module_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])]\n) -> String {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups)\n  )\n}\n\nexport let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\"fs-compile-module|\", source_groups_fingerprint)\n  )\n}\n\nexport let persistent_artifact_cache_path = (\n  kind: String,\n  entry_name: String,\n  fingerprint: String\n) -> String {\n  stable_cache_path(\n    \"selfhost_artifact\",\n    String::concat(kind, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", fingerprint)))),\n    \".hex\"\n  )\n}\n\nexport let load_persistent_artifact = (\n  kind: String,\n  entry_name: String,\n  fingerprint: String\n) -> Option[Bytes] with { Error, Fs } {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    Some(hex_to_bytes(normalize_persistent_cache_text(Fs::read_file(path))))\n  }\n}\n\nexport let store_persistent_artifact = (\n  kind: String,\n  entry_name: String,\n  fingerprint: String,\n  bytes: Bytes\n) -> Unit with { Error, Fs } {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  Fs::write_file(path, bytes_to_hex(bytes))\n}\n")

  let source_111 = ("vibe/compiler/loader/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\n\nlet dir_of = dir_of_path\n\nlet resolve_path = resolve_import_path\n\nlet resolve_path_candidates = resolve_import_path_candidates\n\nlet contains_str = contains_path\n\nlet source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    match found {\n      Some(_) => (),\n      None => {\n        let (p, src) = Array::get(sources, i)\n        if p == path_key {\n          found = Some(src)\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet resolve_path_in_sources = (base_dir: String, raw_path: String, sources: Array[(String, String)]) -> Option[(String, String)] {\n  let candidates = resolve_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(candidates) {\n    match found {\n      Some(_) => (),\n      None => {\n        let candidate = Array::get(candidates, i)\n        match source_lookup(sources, candidate) {\n          Some(source) => {\n            found = Some((candidate, source))\n          }\n          None => ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet resolve_path_fs = (base_dir: String, raw_path: String) -> String {\n  let candidates = resolve_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(candidates) {\n    if found == \"\" {\n      let candidate = Array::get(candidates, i)\n      let candidate_exists = perform Fs::Exists(candidate)\n      if candidate_exists {\n        found = candidate\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    found\n  }\n}\n\nlet join_path = (base_dir: String, rel_path: String) -> String {\n  if base_dir == \"\" {\n    rel_path\n  } else {\n    String::concat(base_dir, String::concat(\"/\", rel_path))\n  }\n}\n\nlet strip_trailing_cr = (line: String) -> String {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nlet find_char = (s: String, target: Int) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet parse_source_manifest_rows = (manifest_source: String) -> Array[(String, String)] with { Error } {\n  let rows = Array::slice([(\"\", \"\")], 0, 0)\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(manifest_source, i) == 10\n    }\n    if at_line_end {\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\n      let line_len = String::length(raw_line)\n      let has_content = line_len > 0\n      let is_comment = if has_content {\n        String::char_code_at(raw_line, 0) == 35\n      } else {\n        false\n      }\n      if has_content {\n        if is_comment {\n          ()\n        } else {\n        let tab_idx = find_char(raw_line, 9)\n          let invalid_row = if tab_idx < 0 {\n            true\n          } else {\n            tab_idx + 1 >= line_len\n          }\n          if invalid_row {\n            throw(String::concat(\"invalid source manifest row: \", raw_line))\n          }\n          let group = raw_line[0:tab_idx]\n          let path = raw_line[tab_idx + 1:line_len]\n          Array::push(rows, (group, path))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet special_bundle_header = (path: String) -> Option[(Array[String], Array[String])] {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((\n      Array::slice([\"\"], 0, 0),\n      [\"selfhost_sources\", \"selfhost_source_groups\"]\n    ))\n  } else {\n    None\n  }\n}\n\nlet split_tsv_fields = (line: String) -> Array[String] {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values = (values: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      out = String::concat(out, header_value_separator)\n    }\n    out = String::concat(out, Array::get(values, i))\n    i = i + 1\n  }\n  out\n}\n\nlet split_header_values = (text: String) -> Array[String] {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_source_specs = () -> Array[(String, String)] {\n  Array::slice([(\"\", \"\")], 0, 0)\n}\n\nlet copy_source_specs = (sources: Array[(String, String)]) -> Array[(String, String)] {\n  let out = empty_source_specs()\n  let mut i = 0\n  while i < Array::length(sources) {\n    Array::push(out, Array::get(sources, i))\n    i = i + 1\n  }\n  out\n}\n\nlet empty_group_specs = () -> Array[(String, String, String)] {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_source_cache_specs = () -> Array[(String, String, String)] {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_group_cache_specs = () -> Array[(String, String, String, String)] {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_manifest_header_cache_rows = () -> Array[(String, String, String, String)] {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet parse_persistent_source_list_cache = (\n  raw: String\n) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let sources = empty_source_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent source list cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"source\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source list cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, sources)\n}\n\nlet parse_persistent_source_group_cache = (\n  raw: String\n) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_group_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent source group cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"group\" {\n          if version == 1 {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \"\", Array::get(fields, 3)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source group cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet parse_persistent_manifest_header_cache = (\n  raw: String\n) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if tag == \"header\" {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec = (\n  path: String,\n  stat_token_text: String,\n  source_fingerprint: String\n) -> Bool with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nlet load_source_if_cached_file_spec_matches = (\n  path: String,\n  stat_token_text: String,\n  source_fingerprint: String\n) -> Option[String] with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        Some(Fs::read_file(path))\n      } else if String::length(source_fingerprint) > 0 {\n        let source = Fs::read_file(path)\n        if compact_string_fingerprint(source) == source_fingerprint {\n          Some(source)\n        } else {\n          None\n        }\n      } else {\n        None\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      let source = Fs::read_file(path)\n      if compact_string_fingerprint(source) == source_fingerprint {\n        Some(source)\n      } else {\n        None\n      }\n    } else {\n      None\n    }\n  }\n}\n\nlet rec load_cached_sources_rec = (\n  specs: Array[(String, String, String)],\n  index: Int,\n  out: Array[(String, String)]\n) -> Option[Array[(String, String)]] with { Error, Fs } {\n  if index >= Array::length(specs) {\n    Some(out)\n  } else {\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        Array::push(out, (path, source))\n        load_cached_sources_rec(specs, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nlet rec load_cached_grouped_sources_rec = (\n  rows: Array[(String, String, String, String)],\n  index: Int,\n  out: Array[(String, Array[(String, String)])]\n) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        push_grouped_source(out, group_name, path, source)\n        load_cached_grouped_sources_rec(rows, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nlet rec load_cached_group_fingerprint_rec = (\n  rows: Array[(String, String, String, String)],\n  index: Int,\n  out: Array[(String, Array[(String, String)])]\n) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n      None\n    } else {\n      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)\n      load_cached_group_fingerprint_rec(rows, index + 1, out)\n    }\n  }\n}\n\nlet manifest_cache_is_valid = (manifest: Option[(String, String, String)]) -> Bool with { Error, Fs } {\n  match manifest {\n    Some((path, stat_token_text, source_fingerprint)) =>\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\n    None => true\n  }\n}\n\nlet load_persistent_sources_cache_if_valid = (\n  entry_path: String\n) -> Option[Array[(String, String)]] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_sources_rec(specs, 0, empty_source_specs())\n    }\n  }\n}\n\nlet load_persistent_source_groups_cache_if_valid = (\n  entry_path: String\n) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\n    }\n  }\n}\n\nlet load_persistent_manifest_header_cache_if_valid = (\n  entry_path: String,\n  manifest_path: String,\n  preloaded_sources: Array[(String, String)]\n) -> Option[Array[(String, String, String, String)]] with { Error, Fs } {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n        cached_path == manifest_path &&\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, _, source_fingerprint, _) = Array::get(rows, i)\n          match source_lookup(preloaded_sources, path) {\n            Some(source) => {\n              if !(compact_string_fingerprint(source) == source_fingerprint) {\n                valid = false\n              }\n            },\n            None => {\n              valid = false\n            }\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet push_grouped_source_fingerprint = (\n  groups: Array[(String, Array[(String, String)])],\n  group_name: String,\n  path: String,\n  source_fingerprint: String\n) -> Unit {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, specs) = Array::get(groups, i)\n    if name == group_name {\n      Array::push(specs, (path, source_fingerprint))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let specs = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(specs, (path, source_fingerprint))\n    Array::push(groups, (group_name, specs))\n  }\n}\n\nlet manifest_path_of = (manifest: Option[(String, String, String)]) -> Option[String] {\n  match manifest {\n    Some((path, _, _)) => Some(path),\n    None => None\n  }\n}\n\nlet build_grouped_sources_from_manifest_rows = (\n  base_dir: String,\n  rows: Array[(String, String)],\n  sources: Array[(String, String)]\n) -> Array[(String, Array[(String, String)])] {\n  let groups = empty_grouped_sources()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    let mut found = \"\"\n    let mut j = 0\n    while j < Array::length(sources) {\n      if found == \"\" {\n        let (source_path, source_text) = Array::get(sources, j)\n        if source_path == path {\n          found = source_text\n        }\n      }\n      j = j + 1\n    }\n    if found == \"\" {\n      ()\n    } else {\n      push_grouped_source(groups, group_name, path, found)\n    }\n    i = i + 1\n  }\n  groups\n}\n\nlet load_persistent_sources_from_group_cache_if_valid = (\n  entry_path: String\n) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let specs = empty_source_cache_specs()\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n        Array::push(specs, (path, stat_token_text, source_fingerprint))\n        i = i + 1\n      }\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) => Some((manifest_path_of(manifest), sources)),\n        None => None\n      }\n    }\n  }\n}\n\nlet load_persistent_source_groups_from_source_list_cache_if_valid = (\n  entry_path: String\n) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) =>\n          match try_load_manifest_rows(entry_path) {\n            Some((base_dir, rows)) => {\n              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\n              Some((manifest_path_of(manifest), groups))\n            },\n            None => {\n              let groups = empty_grouped_sources()\n              Array::push(groups, (\"recursive\", sources))\n              Some((None, groups))\n            }\n          },\n        None => None\n      }\n    }\n  }\n}\n\nexport let load_persistent_source_group_fingerprint_if_valid = (\n  entry_path: String\n) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {\n        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),\n        None => None\n      }\n    }\n  }\n}\n\nlet build_persistent_sources_cache_text = (\n  manifest_path: Option[String],\n  sources: Array[(String, String)]\n  ) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"source\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              __to_string(Fs::stat_token(path)),\n              String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet build_persistent_source_groups_cache_text = (\n  manifest_path: Option[String],\n  groups: Array[(String, Array[(String, String)])]\n) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      out = String::concat(\n        out,\n        String::concat(\n          \"group\\t\",\n          String::concat(\n            group_name,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                path,\n                String::concat(\n                  \"\\t\",\n                  String::concat(\n                    __to_string(Fs::stat_token(path)),\n                    String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n                  )\n                )\n              )\n            )\n          )\n        )\n      )\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet build_persistent_manifest_header_cache_text = (\n  manifest_path: String,\n  rows: Array[(String, String, String, String)]\n) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(\n    out,\n    String::concat(\n      \"manifest\\t\",\n      String::concat(\n        manifest_path,\n        String::concat(\n          \"\\t\",\n          String::concat(\n            __to_string(Fs::stat_token(manifest_path)),\n            String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \"\\n\"))\n          )\n        )\n      )\n    )\n  )\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"header\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              stat_token_text,\n              String::concat(\n                \"\\t\",\n                String::concat(\n                  source_fingerprint,\n                  String::concat(\"\\t\", String::concat(deps_text, \"\\n\"))\n                )\n              )\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let deps = Array::slice([\"\"], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport let load_or_parse_module_header_fs = (\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\n}\n\nlet store_persistent_manifest_header_cache = (\n  entry_path: String,\n  manifest_path: String,\n  rows: Array[(String, String, String, String)]\n) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_manifest_header_cache_path(entry_path),\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\n  )\n}\n\nlet store_persistent_sources_cache = (\n  entry_path: String,\n  manifest_path: Option[String],\n  sources: Array[(String, String)]\n) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_source_list_cache_path(entry_path),\n    build_persistent_sources_cache_text(manifest_path, sources)\n  )\n}\n\nlet store_persistent_source_groups_cache = (\n  entry_path: String,\n  manifest_path: Option[String],\n  groups: Array[(String, Array[(String, String)])]\n) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_source_group_cache_path(entry_path),\n    build_persistent_source_groups_cache_text(manifest_path, groups)\n  )\n}\n\nlet empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet copy_grouped_sources = (\n  groups: Array[(String, Array[(String, String)])]\n) -> Array[(String, Array[(String, String)])] {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let copied_sources = copy_source_specs(sources)\n    Array::push(out, (group_name, copied_sources))\n    gi = gi + 1\n  }\n  out\n}\n\nlet flatten_group_sources = (\n  groups: Array[(String, Array[(String, String)])]\n) -> Array[(String, String)] {\n  let out = empty_source_specs()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(out, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet filter_group_sources = (\n  groups: Array[(String, Array[(String, String)])],\n  ordered_sources: Array[(String, String)]\n) -> Array[(String, Array[(String, String)])] {\n  let filtered = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      match source_lookup(ordered_sources, path) {\n        Some(_) => Array::push(next_sources, pair),\n        None => ()\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered\n}\n\nlet special_bundle_source_groups = (\n  entry_path: String\n) -> Option[Array[(String, Array[(String, String)])]] {\n  if entry_path == \"vibe/compiler/index.vibe\" {\n    Some(copy_grouped_sources(selfhost_source_groups()))\n  } else if entry_path == \"vibe/compiler/selfhost_cli_adapter.vibe\" {\n    Some(copy_grouped_sources(selfhost_cli_adapter_source_groups()))\n  } else {\n    None\n  }\n}\n\nlet normalize_bundle_source_groups = (\n  groups: Array[(String, Array[(String, String)])],\n  main_path: String,\n  main_source: String\n) -> Array[(String, Array[(String, String)])] {\n  let normalized = empty_grouped_sources()\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = empty_source_specs()\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nlet special_manifest_sources = (\n  entry_path: String\n) -> Option[(String, Array[(String, String)])] {\n  let manifest_path = join_path(dir_of(entry_path), \"selfhost_sources_manifest.tsv\")\n  if entry_path == \"vibe/compiler/index.vibe\" {\n    Some((manifest_path, copy_source_specs(selfhost_sources())))\n  } else if entry_path == \"vibe/compiler/selfhost_cli_adapter.vibe\" {\n    Some((manifest_path, copy_source_specs(selfhost_cli_adapter_sources())))\n  } else {\n    None\n  }\n}\n\nlet special_manifest_source_groups = (\n  entry_path: String\n) -> Option[(String, Array[(String, Array[(String, String)])])] {\n  let manifest_path = join_path(dir_of(entry_path), \"selfhost_sources_manifest.tsv\")\n  if entry_path == \"vibe/compiler/index.vibe\" {\n    Some((manifest_path, copy_grouped_sources(selfhost_source_groups())))\n  } else if entry_path == \"vibe/compiler/selfhost_cli_adapter.vibe\" {\n    Some((manifest_path, copy_grouped_sources(selfhost_cli_adapter_source_groups())))\n  } else {\n    None\n  }\n}\n\nlet rec collect_needed_paths_rec = (\n  path: String,\n  preloaded_sources: Array[(String, String)],\n  visited: Array[String]\n) -> Unit with { Error, Fs } {\n  if contains_str(visited, path) {\n    ()\n  } else {\n    Array::push(visited, path)\n    let source = match source_lookup(preloaded_sources, path) {\n      Some(preloaded) => preloaded,\n      None => Fs::read_file(path)\n    }\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      collect_needed_paths_rec(Array::get(deps, i), preloaded_sources, visited)\n      i = i + 1\n    }\n  }\n}\n\nlet manifest_header_deps_lookup = (\n  rows: Array[(String, String, String, String)],\n  path: String\n) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if row_path == path {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet manifest_header_row_for_path = (\n  rows: Array[(String, String, String, String)],\n  path: String\n) -> Option[(String, String, String, String)] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let row = Array::get(rows, i)\n    let (row_path, _, _, _) = row\n    if row_path == path {\n      found = Some(row)\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet append_manifest_header_row_if_missing = (\n  rows: Array[(String, String, String, String)],\n  row: (String, String, String, String)\n) -> Unit {\n  let (path, _, _, _) = row\n  match manifest_header_row_for_path(rows, path) {\n    Some(_) => (),\n    None => Array::push(rows, row)\n  }\n}\n\nlet collect_needed_paths_from_manifest_headers = (\n  path: String,\n  preloaded_sources: Array[(String, String)],\n  rows: Array[(String, String, String, String)]\n) -> Array[String] with { Error, Fs } {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = Array::slice([\"\"], 0, 0)\n  Array::push(worklist, path)\n  Array::push(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_str(visited, current)) {\n      Array::push(visited, current)\n      let deps = match manifest_header_deps_lookup(rows, current) {\n        Some(found) => found,\n        None => {\n          let source = match source_lookup(preloaded_sources, current) {\n            Some(preloaded) => preloaded,\n            None => Fs::read_file(current)\n          }\n          let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n          fallback_deps\n        }\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if !(contains_str(scheduled, dep_path)) {\n          Array::push(worklist, dep_path)\n          Array::push(scheduled, dep_path)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet collect_needed_paths_and_manifest_headers = (\n  path: String,\n  preloaded_sources: Array[(String, String)]\n) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = Array::slice([\"\"], 0, 0)\n  Array::push(worklist, path)\n  Array::push(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_str(visited, current)) {\n      Array::push(visited, current)\n      let source = match source_lookup(preloaded_sources, current) {\n        Some(preloaded) => preloaded,\n        None => Fs::read_file(current)\n      }\n      let deps = match manifest_header_deps_lookup(rows, current) {\n        Some(found) => found,\n        None => {\n          let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n          append_manifest_header_row_if_missing(\n            rows,\n            (\n              current,\n              __to_string(Fs::stat_token(current)),\n              compact_string_fingerprint(source),\n              join_header_values(parsed_deps)\n            )\n          )\n          parsed_deps\n        }\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if !(contains_str(scheduled, dep_path)) {\n          Array::push(worklist, dep_path)\n          Array::push(scheduled, dep_path)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n    }\n    work_i = work_i + 1\n  }\n  (rows, visited)\n}\n\nlet push_grouped_source = (\n  groups: Array[(String, Array[(String, String)])],\n  group_name: String,\n  path: String,\n  source: String\n) -> Unit {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if name == group_name {\n      Array::push(sources, (path, source))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(sources, (path, source))\n    Array::push(groups, (group_name, sources))\n  }\n}\n\nlet try_load_manifest_rows = (entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  let base_dir = dir_of(entry_path)\n  let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n  if !(Fs::exists(manifest_path)) {\n    None\n  } else {\n    let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n    let mut has_entry = false\n    let mut i = 0\n    while i < Array::length(rows) {\n      let (_, rel_path) = Array::get(rows, i)\n      let path = join_path(base_dir, rel_path)\n      if path == entry_path {\n        has_entry = true\n      }\n      i = i + 1\n    }\n    if has_entry {\n      Some((base_dir, rows))\n    } else {\n      None\n    }\n  }\n}\n\nlet load_manifest_full_sources = (\n  base_dir: String,\n  rows: Array[(String, String)]\n) -> Array[(String, String)] with { Error, Fs } {\n  let full_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nlet try_collect_manifest_sources_fs = (entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n      let header_rows = match load_persistent_manifest_header_cache_if_valid(\n        entry_path,\n        manifest_path,\n        preloaded_sources\n      ) {\n        Some(cached_rows) => {\n          cached_rows\n        },\n        None => {\n          let built_rows = empty_manifest_header_cache_rows()\n          let visited = Array::slice([\"\"], 0, 0)\n          let worklist = Array::slice([\"\"], 0, 0)\n          let scheduled = Array::slice([\"\"], 0, 0)\n          Array::push(worklist, entry_path)\n          Array::push(scheduled, entry_path)\n          let mut work_len = 1\n          let mut work_i = 0\n          loop {\n            if work_i >= work_len {\n              break\n            }\n            let current = Array::get(worklist, work_i)\n            if !(contains_str(visited, current)) {\n              Array::push(visited, current)\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let deps = match manifest_header_deps_lookup(built_rows, current) {\n                Some(found) => found,\n                None => {\n                  let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n                  append_manifest_header_row_if_missing(\n                    built_rows,\n                    (\n                      current,\n                      __to_string(Fs::stat_token(current)),\n                      compact_string_fingerprint(source),\n                      join_header_values(parsed_deps)\n                    )\n                  )\n                  parsed_deps\n                }\n              }\n              let mut dep_i = 0\n              while dep_i < Array::length(deps) {\n                let dep_path = Array::get(deps, dep_i)\n                if !(contains_str(scheduled, dep_path)) {\n                  Array::push(worklist, dep_path)\n                  Array::push(scheduled, dep_path)\n                  work_len = work_len + 1\n                }\n                dep_i = dep_i + 1\n              }\n            }\n            work_i = work_i + 1\n          }\n          store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n          built_rows\n        }\n      }\n      let needed_paths = Array::slice([\"\"], 0, 0)\n      let worklist = Array::slice([\"\"], 0, 0)\n      let scheduled = Array::slice([\"\"], 0, 0)\n      Array::push(worklist, entry_path)\n      Array::push(scheduled, entry_path)\n      let mut work_len = 1\n      let mut work_i = 0\n      loop {\n        if work_i >= work_len {\n          break\n        }\n        let current = Array::get(worklist, work_i)\n        if !(contains_str(needed_paths, current)) {\n          Array::push(needed_paths, current)\n          let deps = match manifest_header_deps_lookup(header_rows, current) {\n            Some(found) => found,\n            None => {\n              let mut source = \"\"\n              let mut lookup_i = 0\n              while lookup_i < Array::length(preloaded_sources) {\n                if source == \"\" {\n                  let (source_path, source_text) = Array::get(preloaded_sources, lookup_i)\n                  if source_path == current {\n                    source = source_text\n                  }\n                }\n                lookup_i = lookup_i + 1\n              }\n              if source == \"\" {\n                source = Fs::read_file(current)\n              }\n              let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n              fallback_deps\n            }\n          }\n          let mut dep_i = 0\n          while dep_i < Array::length(deps) {\n            let dep_path = Array::get(deps, dep_i)\n            if !(contains_str(scheduled, dep_path)) {\n              Array::push(worklist, dep_path)\n              Array::push(scheduled, dep_path)\n              work_len = work_len + 1\n            }\n            dep_i = dep_i + 1\n          }\n        }\n        work_i = work_i + 1\n      }\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      let mut j = 0\n      while j < Array::length(preloaded_sources) {\n        let (path, source) = Array::get(preloaded_sources, j)\n        if contains_str(needed_paths, path) {\n          Array::push(sources, (path, source))\n        }\n        j = j + 1\n      }\n      Some((manifest_path, sources))\n    },\n    None => {\n      None\n    }\n  }\n}\n\nlet try_collect_manifest_source_groups_fs = (entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n      let header_rows = match load_persistent_manifest_header_cache_if_valid(\n        entry_path,\n        manifest_path,\n        preloaded_sources\n      ) {\n        Some(cached_rows) => cached_rows,\n        None => {\n          let built_rows = empty_manifest_header_cache_rows()\n          let visited = Array::slice([\"\"], 0, 0)\n          let worklist = Array::slice([\"\"], 0, 0)\n          let scheduled = Array::slice([\"\"], 0, 0)\n          Array::push(worklist, entry_path)\n          Array::push(scheduled, entry_path)\n          let mut work_len = 1\n          let mut work_i = 0\n          loop {\n            if work_i >= work_len {\n              break\n            }\n            let current = Array::get(worklist, work_i)\n            if !(contains_str(visited, current)) {\n              Array::push(visited, current)\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let deps = match manifest_header_deps_lookup(built_rows, current) {\n                Some(found) => found,\n                None => {\n                  let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n                  append_manifest_header_row_if_missing(\n                    built_rows,\n                    (\n                      current,\n                      __to_string(Fs::stat_token(current)),\n                      compact_string_fingerprint(source),\n                      join_header_values(parsed_deps)\n                    )\n                  )\n                  parsed_deps\n                }\n              }\n              let mut dep_i = 0\n              while dep_i < Array::length(deps) {\n                let dep_path = Array::get(deps, dep_i)\n                if !(contains_str(scheduled, dep_path)) {\n                  Array::push(worklist, dep_path)\n                  Array::push(scheduled, dep_path)\n                  work_len = work_len + 1\n                }\n                dep_i = dep_i + 1\n              }\n            }\n            work_i = work_i + 1\n          }\n          store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n          built_rows\n        }\n      }\n      let needed_paths = Array::slice([\"\"], 0, 0)\n      let worklist = Array::slice([\"\"], 0, 0)\n      let scheduled = Array::slice([\"\"], 0, 0)\n      Array::push(worklist, entry_path)\n      Array::push(scheduled, entry_path)\n      let mut work_len = 1\n      let mut work_i = 0\n      loop {\n        if work_i >= work_len {\n          break\n        }\n        let current = Array::get(worklist, work_i)\n        if !(contains_str(needed_paths, current)) {\n          Array::push(needed_paths, current)\n          let deps = match manifest_header_deps_lookup(header_rows, current) {\n            Some(found) => found,\n            None => {\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n              fallback_deps\n            }\n          }\n          let mut dep_i = 0\n          while dep_i < Array::length(deps) {\n            let dep_path = Array::get(deps, dep_i)\n            if !(contains_str(scheduled, dep_path)) {\n              Array::push(worklist, dep_path)\n              Array::push(scheduled, dep_path)\n              work_len = work_len + 1\n            }\n            dep_i = dep_i + 1\n          }\n        }\n        work_i = work_i + 1\n      }\n      let groups = empty_grouped_sources()\n      let mut j = 0\n      while j < Array::length(rows) {\n        let (group_name, rel_path) = Array::get(rows, j)\n        let path = join_path(base_dir, rel_path)\n        if contains_str(needed_paths, path) {\n          let mut source = \"\"\n          let mut lookup_j = 0\n          while lookup_j < Array::length(preloaded_sources) {\n            if source == \"\" {\n              let (source_path, source_text) = Array::get(preloaded_sources, lookup_j)\n              if source_path == path {\n                source = source_text\n              }\n            }\n            lookup_j = lookup_j + 1\n          }\n          if source == \"\" {\n            ()\n          } else {\n            push_grouped_source(groups, group_name, path, source)\n          }\n        }\n        j = j + 1\n      }\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n\n\nlet cache_lookup = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet export_marker_name = (name: String) -> String {\n  String::concat(\"__vibe_internal_export__:\", name)\n}\n\nlet env_has_export_marker = (env: TypeEnv, name: String) -> Bool {\n  match env_lookup(env, export_marker_name(name)) {\n    Some(_) => true,\n    None => false\n  }\n}\n\nlet bind_export_markers = (env: TypeEnv, exports: Array[String]) -> TypeEnv {\n  let mut acc = env\n  let mut i = 0\n  while i < Array::length(exports) {\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\n    i = i + 1\n  }\n  acc\n}\n\nlet rec bind_checked_imports = (\n  names: Array[(String, Option[String])],\n  i: Int,\n  env: TypeEnv,\n  mod_env: TypeEnv\n) -> TypeEnv {\n  if i >= Array::length(names) {\n    env\n  } else {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if env_has_export_marker(mod_env, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env)\n  }\n}\n\n\nexport let rec check_module = (\n  source: String,\n  path: String,\n  sources: Array[(String, String)],\n  loading: Array[String],\n  checked_cache: Array[(String, TypeEnv)]\n) -> TypeEnv with { Error } {\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      if contains_str(loading, path) {\n        throw(String::concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of(path)\n      let new_loading = Array::concat(loading, [path])\n\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < Array::length(stmts) {\n        let stmt = Array::get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          SReExport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n\n      let empty_defs = Array::slice([TDAlias(\"_dummy\", CtUnit)], 0, 0)\n      let check_errors = Array::slice([\n        \"\"\n      ], 0, 0)\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors)\n\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\n      Array::push(checked_cache, (path, cached_env))\n      cached_env\n    }\n  }\n}\n\n\nlet rec collect_sources_rec = (\n  path: String,\n  sources: Array[(String, String)],\n  visited: Array[String]\n) -> Unit with { Error, Fs } {\n  if contains_str(visited, path) {\n    ()\n  }\n  else {\n    Array::push(visited, path)\n    let source = Fs::read_file(path)\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      collect_sources_rec(Array::get(deps, i), sources, visited)\n      i = i + 1\n    }\n    Array::push(sources, (path, source))\n  }\n}\n\nexport let collect_all_sources_fs = (entry_path: String) -> Array[(String, String)] with { Error, Fs } {\n  match special_manifest_sources(entry_path) {\n    Some((manifest_path, sources)) => {\n      let _ = manifest_path\n      copy_source_specs(sources)\n    },\n    None =>\n      match load_persistent_sources_cache_if_valid(entry_path) {\n        Some(sources) => {\n          copy_source_specs(sources)\n        },\n        None => {\n          match try_collect_manifest_sources_fs(entry_path) {\n            Some((manifest_path, sources)) => {\n              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\n              copy_source_specs(sources)\n            },\n            None => {\n              match try_load_manifest_rows(entry_path) {\n                Some((base_dir, rows)) => {\n                  let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\n                  copy_source_specs(preloaded_sources)\n                },\n                None => {\n                  let sources = Array::slice([(\"\", \"\")], 0, 0)\n                  let visited = Array::slice([\"\"], 0, 0)\n                  collect_sources_rec(entry_path, sources, visited)\n                  store_persistent_sources_cache(entry_path, None, sources)\n                  copy_source_specs(sources)\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}\n\nexport let collect_source_groups_fs = (entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  match special_manifest_source_groups(entry_path) {\n    Some((manifest_path, groups)) => {\n      let _ = manifest_path\n      copy_grouped_sources(groups)\n    },\n    None =>\n      match load_persistent_source_groups_cache_if_valid(entry_path) {\n        Some(groups) => copy_grouped_sources(groups),\n        None =>\n          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\n            Some((manifest_path, groups)) => {\n              store_persistent_source_groups_cache(entry_path, manifest_path, groups)\n              copy_grouped_sources(groups)\n            },\n            None =>\n              match try_collect_manifest_source_groups_fs(entry_path) {\n                Some((manifest_path, groups)) => {\n                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                  copy_grouped_sources(groups)\n                },\n                None =>\n                  match try_load_manifest_rows(entry_path) {\n                    Some((base_dir, rows)) => {\n                      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                      let groups = empty_grouped_sources()\n                      let mut j = 0\n                      while j < Array::length(rows) {\n                        let (group_name, rel_path) = Array::get(rows, j)\n                        let path = join_path(base_dir, rel_path)\n                        let mut found = \"\"\n                        let mut k = 0\n                        while k < Array::length(preloaded_sources) {\n                          if found == \"\" {\n                            let (source_path, source_text) = Array::get(preloaded_sources, k)\n                            if source_path == path {\n                              found = source_text\n                            }\n                          }\n                          k = k + 1\n                        }\n                        if found == \"\" {\n                          ()\n                        } else {\n                          push_grouped_source(groups, group_name, path, found)\n                        }\n                        j = j + 1\n                      }\n                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                      copy_grouped_sources(groups)\n                    },\n                    None => {\n                      let groups = empty_grouped_sources()\n                      let recursive_sources = collect_all_sources_fs(entry_path)\n                      Array::push(groups, (\"recursive\", recursive_sources))\n                      store_persistent_source_groups_cache(entry_path, None, groups)\n                      copy_grouped_sources(groups)\n                    }\n                  }\n              }\n          }\n      }\n  }\n}\n\n\nexport let collect_merged_stmts = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = Array::slice([SExport([\"_dummy\"])], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, src) = Array::get(sources, si)\n    let stmts = parse_program(lex(src))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n")

  let source_112 = ("vibe/compiler/module_loader.vibe",
"\n\n\nexport {\n  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\n}\n")

  let source_113 = ("vibe/compiler/entry/source_compile/index.vibe",
"\n\n\n\n\n\n\n\nexport let compile_source = (source: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_module(stmts)\n}\n\nexport let compile_source_wasi = (source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\nexport let compile_source_wasi_mode = (source: String, entry_name: String, mode: String) -> Bytes with { Error } {\n  if mode == \"mvp\" {\n    let tokens = lex(source)\n    let stmts = parse_program(tokens)\n    let _ = check_program(stmts)\n    let pruned_stmts = dce_stmts(stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_source_wasi(source, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n")

  let source_114 = ("vibe/compiler/entry/source_compile/wasi_only/index.vibe",
"\n\n")

  let source_115 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess.vibe",
"\n\n\n\n\nexport {\n  expand_interp_stmts, compile_source_wasi_only, strip_generic_type_params\n}\n")

  let source_116 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_strip.vibe",
"\n\n\nexport let strip_generic_type_params = (stmts: Array[Stmt]) -> Unit {\n  let empty_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let empty_bounds = Array::slice([\n    (\"\", Array::slice([\n      \"\"\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(sl_exp, sl_rec, sl_name, sl_ann, sl_expr) => match sl_expr {\n        EFn(tparams, _, params, ret, eff, body) => if Array::length(tparams) > 0 {\n          Array::set(stmts, i, SLet(sl_exp, sl_rec, sl_name, sl_ann, EFn(empty_tp, empty_bounds, params, ret, eff, body)))\n        }\n        ,\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n")

  let source_117 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp.vibe",
"\n\n\n\nexport let expand_interp_stmts = (stmts: Array[Stmt]) -> Unit with { Error } {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, is_rec, name, ann, expr) => Array::set(stmts, i, SLet(exp, is_rec, name, ann, rewrite_interp(expr)))\n      ,\n      STest(name, expr) => Array::set(stmts, i, STest(name, rewrite_interp(expr)))\n      ,\n      SBench(name, expr) => Array::set(stmts, i, SBench(name, rewrite_interp(expr)))\n      ,\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n")

  let source_118 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_parse.vibe",
"\n\n\n\n\nexport let parse_interp_expr = (tokens: Array[Token]) -> Expr with { Error } {\n  let (stmt, _) = parse_stmt(tokens, 0)\n  match stmt {\n    SExpr(expr) => expr,\n    _ => throw(\"expected interpolation expression\")\n  }\n}\n")

  let source_119 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string.vibe",
"\n\n\nexport {\n  rewrite_interp_string\n}\n")

  let source_120 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_impl.vibe",
"\n\n\nexport {\n  rewrite_interp_string\n}\n")

  let source_121 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_build.vibe",
"\n\n\n\n\nexport let rewrite_interp_string = (parts: Array[String]) -> Expr with { Error } {\n  let result_arr = collect_interp_exprs(parts)\n  fold_interp_exprs(result_arr)\n}\n")

  let source_122 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_collect.vibe",
"\n\n\n\n\nexport let collect_interp_exprs = (parts: Array[String]) -> Array[Expr] with { Error } {\n  let plen = Array::length(parts)\n  let exprs = ArrayBuilder::new()\n  let mut i = 0\n  while i < plen {\n    let lit = Array::get(parts, i)\n    if String::length(lit) > 0 {\n      ArrayBuilder::push(exprs, EString(lit))\n    }\n    if i + 1 < plen {\n      let expr_src = Array::get(parts, i + 1)\n      let part_tokens = lex(expr_src)\n      let part_expr = parse_interp_expr(part_tokens)\n      ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\"), [\n        part_expr\n      ]))\n    }\n    i = i + 2\n  }\n  ArrayBuilder::freeze(exprs)\n}\n")

  let source_123 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold.vibe",
"\n\n\nexport {\n  fold_interp_exprs\n}\n")

  let source_124 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_impl.vibe",
"\n\n\nexport {\n  fold_interp_exprs\n}\n")

  let source_125 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_core.vibe",
"\n\n\n\nexport let fold_interp_exprs = (result_arr: Array[Expr]) -> Expr {\n  let result_len = Array::length(result_arr)\n  if result_len == 0 {\n    EString(\"\")\n  } else {\n    fold_interp_exprs_nonempty(result_arr, result_len)\n  }\n}\n")

  let source_126 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_nonempty.vibe",
"\n\n\n\nexport let fold_interp_exprs_nonempty = (result_arr: Array[Expr], result_len: Int) -> Expr {\n  let first = Array::get(result_arr, 0)\n  fold_interp_exprs_loop(result_arr, result_len, first, 1)\n}\n")

  let source_127 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_string_fold_loop.vibe",
"\n\n\nlet concat_exprs = (lhs: Expr, rhs: Expr) -> Expr {\n  let b = ArrayBuilder::new()\n  ArrayBuilder::push(b, lhs)\n  ArrayBuilder::push(b, rhs)\n  let args = ArrayBuilder::freeze(b)\n  ECall(EIdent(\"String::concat\"), args)\n}\n\nexport let fold_interp_exprs_loop = (result_arr: Array[Expr], result_len: Int, result0: Expr, j0: Int) -> Expr {\n  let mut result = result0\n  let mut j = j0\n  while j < result_len {\n    let rhs = Array::get(result_arr, j)\n    result = concat_exprs(result, rhs)\n    j = j + 1\n  }\n  result\n}\n")

  let source_128 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_rewrite.vibe",
"\n\n\nexport {\n  rewrite_interp\n}\n")

  let source_129 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_interp_rewrite_impl.vibe",
"\n\n\n\nexport let rec rewrite_interp = (e: Expr) -> Expr with { Error } {\n  match e {\n    EStringInterp(parts) => rewrite_interp_string(parts),\n    ELet(name, val, body) => ELet(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetMut(name, val, body) => ELetMut(name, rewrite_interp(val), rewrite_interp(body)),\n    ELetRec(name, val, body) => ELetRec(name, rewrite_interp(val), rewrite_interp(body)),\n    ESeq(a, b) => ESeq(rewrite_interp(a), rewrite_interp(b)),\n    ECall(callee, args) => ECall(rewrite_interp(callee), for arg in args {\n      rewrite_interp(arg)\n    }),\n    EIf(c, t, e2) => EIf(rewrite_interp(c), rewrite_interp(t), rewrite_interp(e2)),\n    EFn(tp, tb, params, ret, eff, body) => EFn(tp, tb, params, ret, eff, rewrite_interp(body)),\n    EMatch(scrut, arms) => EMatch(rewrite_interp(scrut), for arm in arms {\n      let (pat, body) = arm; (pat, rewrite_interp(body))\n    }),\n    _ => e\n  }\n}\n")

  let source_130 = ("vibe/compiler/entry/source_compile/wasi_only/preprocess_compile.vibe",
"\n\n\n\n\n\n\n\nexport let compile_source_wasi_only = (source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  strip_generic_type_params(stmts)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n")

  let source_131 = ("vibe/compiler/entry/source_compile/wasi_only/path_utils.vibe",
"\n\n\nlet empty_stmt_array = () -> Array[Stmt] {\n  Array::slice([\n    SExpr(EInt(0))\n  ], 0, 0)\n}\n\n\nexport {\n  empty_stmt_array\n}\n")

  let source_132 = ("vibe/compiler/entry/source_compile/wasi_only/merge_sources.vibe",
"\n\n\n\n\n\n\n\n\n\nlet rec collect_merged_stmts_recursive = (path: String, merged: Array[Stmt], visited: Array[String]) -> Unit with { Error, Fs } {\n  if contains_path(visited, path) {\n    ()\n  }\n  else {\n    Array::push(visited, path)\n    let source = perform Fs::ReadFile(path)\n    let stmts = parse_program(lex(source))\n    let base_dir = dir_of_path(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_import_path(base_dir, raw_path)\n          collect_merged_stmts_recursive(resolved, merged, visited)\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_import_path(base_dir, raw_path)\n          collect_merged_stmts_recursive(resolved, merged, visited)\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    let mut j = 0\n    while j < Array::length(stmts) {\n      match Array::get(stmts, j) {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, Array::get(stmts, j))\n      }\n      j = j + 1\n    }\n  }\n}\n\nexport let compile_file_wasi_only = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_merged_stmts_recursive(entry_path, stmts, visited)\n  strip_generic_type_params(stmts)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\n\nexport {\n  collect_merged_stmts_recursive\n}\n\nexport {\n  compile_file_wasi_only, collect_merged_stmts_recursive\n}\n")

  let source_133 = ("vibe/compiler/entry/source_compile/wasi_only/linked.vibe",
"\n\n\n\nexport {\n  compile_file_wasi_linked, compile_file_wasi_library, compile_file_wasi_linked_artifacts\n}\n")

  let source_134 = ("vibe/compiler/entry/source_compile/wasi_only/linked_helpers.vibe",
"\n\n\n\n\n\n\n\n\nlet rec resolve_reexport_chain = (source_path: String, items: Array[(String, Option[String])], module_name: String, linked_imports: Array[(String, String, Int, Int)], type_stmts: Array[Stmt], depth: Int) -> Unit with { Error, Fs } {\n  if depth > 10 {\n    ()\n  }\n  else {\n    let source = perform Fs::ReadFile(source_path)\n    let stmts = parse_program(lex(source))\n    let source_dir = dir_of_path(source_path)\n    let wanted_names = Array::slice([\n      \"\"\n    ], 0, 0)\n    let mut wi = 0\n    while wi < Array::length(items) {\n      let (name, _) = Array::get(items, wi)\n      Array::push(wanted_names, name)\n      wi = wi + 1\n    }\n    let mut si = 0\n    while si < Array::length(stmts) {\n      match Array::get(stmts, si) {\n        SLet(true, _, name, _, EFn(_, _, params, _, _, _)) => if contains_name(wanted_names, name) {\n          let export_name = get_export_name(items, name)\n          Array::push(linked_imports, (module_name, export_name, Array::length(params), 1))\n        }\n        ,\n        SEnum(true, name, _) => if contains_name(wanted_names, name) {\n          Array::push(type_stmts, Array::get(stmts, si))\n        }\n        ,\n        SReExport(raw_path, inner_items) => {\n          let filtered = Array::slice([\n            (\"\", None)\n          ], 0, 0)\n          let mut fi = 0\n          while fi < Array::length(inner_items) {\n            let (iname, irename) = Array::get(inner_items, fi)\n            if contains_name(wanted_names, iname) {\n              Array::push(filtered, (iname, irename))\n            }\n            fi = fi + 1\n          }\n          if Array::length(filtered) > 0 {\n            let resolved = resolve_import_path(source_dir, raw_path)\n            resolve_reexport_chain(resolved, filtered, module_name, linked_imports, type_stmts, depth + 1)\n          }\n        },\n        _ => ()\n      }\n      si = si + 1\n    }\n  }\n}\n\n\nexport {\n  path_to_module_name, resolve_reexport_chain\n}\n")

  let source_135 = ("vibe/compiler/entry/source_compile/wasi_only/linked_artifacts.vibe",
"\n\n\n\n\n\n\n\n\n\n\nexport let compile_file_wasi_linked_artifacts = (entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)], Array[(String, String)])with { Error, Fs } {\n  let entry_source = perform Fs::ReadFile(entry_path)\n  let entry_stmts = parse_program(lex(entry_source))\n  let entry_dir = dir_of_path(entry_path)\n  let dep_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ei = 0\n  while ei < Array::length(entry_stmts) {\n    match Array::get(entry_stmts, ei) {\n      SImport(raw_path, items) => if Array::length(items) > 0 {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        if !contains_path(dep_paths, resolved) {\n          Array::push(dep_paths, resolved)\n        }\n      }\n      ,\n      SReExport(raw_path, _) => {\n        let resolved = resolve_import_path(entry_dir, raw_path)\n        if !contains_path(dep_paths, resolved) {\n          Array::push(dep_paths, resolved)\n        }\n      },\n      _ => ()\n    }\n    ei = ei + 1\n  }\n  let linked_imports = Array::slice([\n    (\"\", \"\", 0, 0)\n  ], 0, 0)\n  let linked_dep_paths = Array::slice([\n    \"\"\n  ], 0, 0)\n  let linked_dep_specs = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let resolved_type_stmts = Array::slice([\n    SExpr(EInt(0))\n  ], 0, 0)\n  let mut di = 0\n  while di < Array::length(dep_paths) {\n    let dep_path = Array::get(dep_paths, di)\n    let dep_source = perform Fs::ReadFile(dep_path)\n    let dep_stmts = parse_program(lex(dep_source))\n    let module_name = path_to_module_name(dep_path)\n    let dep_dir = dir_of_path(dep_path)\n    let mut has_linked = false\n    let mut dsi = 0\n    while dsi < Array::length(dep_stmts) {\n      match Array::get(dep_stmts, dsi) {\n        SLet(true, _, name, _, EFn(_, _, params, _, _, _)) => {\n          Array::push(linked_imports, (module_name, name, Array::length(params), 1))\n          has_linked = true\n        },\n        SReExport(raw_path, items) => {\n          let resolved = resolve_import_path(dep_dir, raw_path)\n          resolve_reexport_chain(resolved, items, module_name, linked_imports, resolved_type_stmts, 0)\n          has_linked = true\n        },\n        SEnum(true, _, _) => Array::push(resolved_type_stmts, Array::get(dep_stmts, dsi))\n        ,\n        _ => ()\n      }\n      dsi = dsi + 1\n    }\n    if has_linked {\n      Array::push(linked_dep_paths, dep_path)\n      Array::push(linked_dep_specs, (module_name, dep_path))\n    }\n    di = di + 1\n  }\n  let stmts = empty_stmt_array()\n  let mut rti = 0\n  while rti < Array::length(resolved_type_stmts) {\n    Array::push(stmts, Array::get(resolved_type_stmts, rti))\n    rti = rti + 1\n  }\n  let mut esi = 0\n  while esi < Array::length(entry_stmts) {\n    Array::push(stmts, Array::get(entry_stmts, esi))\n    esi = esi + 1\n  }\n  strip_generic_type_params(stmts)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  let wasm = compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\n    (\"\", \"\")\n  ], 0, 0), linked_imports, false)\n  (wasm, linked_imports, linked_dep_specs)\n}\n\nexport let compile_file_wasi_linked = (entry_path: String, entry_name: String) -> (Bytes, Array[(String, String, Int, Int)])with { Error, Fs } {\n  let (wasm, linked_imports, _) = compile_file_wasi_linked_artifacts(entry_path, entry_name)\n  (wasm, linked_imports)\n}\n")

  let source_136 = ("vibe/compiler/entry/source_compile/wasi_only/linked_library.vibe",
"\n\n\n\n\n\n\n\n\n\nexport let compile_file_wasi_library = (dep_path: String) -> Bytes with { Error, Fs } {\n  let stmts = empty_stmt_array()\n  let visited = Array::slice([\n    \"\"\n  ], 0, 0)\n  collect_merged_stmts_recursive(dep_path, stmts, visited)\n  strip_generic_type_params(stmts)\n  expand_interp_stmts(stmts)\n  let _ = check_program(stmts)\n  compile_wasi_module_linked_impl(stmts, \"_start\", Array::slice([\n    (\"\", \"\")\n  ], 0, 0), Array::slice([\n    (\"\", \"\", 0, 0)\n  ], 0, 0), true)\n}\n")

  let source_137 = ("vibe/compiler/entry/compiler/fs_compile/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\n\nlet empty_stmt_array = () -> Array[Stmt] {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nlet seed_type_db = (db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb {\n  let mut seeded = db\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    seeded = db_set_source(seeded, path, source)\n    i = i + 1\n  }\n  db_set_source(seeded, main_path, main_source)\n}\n\nlet flatten_source_groups = (source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = Array::slice([(\"\", \"\")], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nlet normalize_source_groups = (\n  source_groups: Array[(String, Array[(String, String)])],\n  main_path: String,\n  main_source: String\n) -> Array[(String, Array[(String, String)])] {\n  let normalized = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nlet contains_source_path = (sources: Array[(String, String)], target_path: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(sources) && !found {\n    let (path, _) = Array::get(sources, i)\n    if path == target_path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet filter_source_groups = (\n  source_groups: Array[(String, Array[(String, String)])],\n  ordered_sources: Array[(String, String)]\n) -> Array[(String, Array[(String, String)])] {\n  let filtered_groups = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      if contains_source_path(ordered_sources, path) {\n        Array::push(next_sources, pair)\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered_groups, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered_groups\n}\n\nexport let source_group_total_source_count = (\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int {\n  let mut total = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    total = total + Array::length(sources)\n    gi = gi + 1\n  }\n  total\n}\n\nexport let source_group_ordered_source_count = (\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  Array::length(ordered_sources)\n}\n\nexport let source_group_filtered_group_count = (\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  Array::length(filtered_groups)\n}\n\nexport let prepare_modules_cached = (db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with { Error } {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck(seeded, main_path)\n}\n\nlet prepare_modules_persistent_fs_cached = (db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck_fs(seeded, main_path)\n}\n\nexport let source_group_prepare_typecheck_count = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  db_typecheck_count(next_db)\n}\n\nexport let grouped_source_merged_len = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, _, _) = db_grouped_merged_source(next_db, filtered_groups)\n  String::length(merged_source)\n}\n\nexport let source_group_module_source_len = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, _) = db_module_source(module_db, merge_fingerprint, merged_source)\n  String::length(module_source)\n}\n\nexport let compile_with_modules = (main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_modules_cached(db_new(), main_source, main_path, sources)\n  bytes\n}\n\nexport let compile_with_modules_wasi = (main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_modules_wasi_cached(db_new(), main_source, main_path, sources, entry_name)\n  bytes\n}\n\nlet artifact_fingerprint_from_source = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet build_merge_fingerprint_inline = (sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", artifact_fingerprint_from_source(source))\n    )\n    acc = artifact_fingerprint_from_source(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_merged_stmts_inline = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = empty_stmt_array()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, source) = Array::get(sources, si)\n    let stmts = parse_program(lex(source))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt),\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n\nlet prune_entry_stmts = (stmts: Array[Stmt], entry_name: String) -> Array[Stmt] {\n  dce_stmts(stmts, [entry_name])\n}\n\nexport let closure_ordered_source_count = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)]\n) -> Int with { Error } {\n  Array::length(collect_inline_sources_ordered(main_path, main_source, sources))\n}\n\nexport let closure_merged_stmt_count = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)]\n) -> Int with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  Array::length(merged_stmts)\n}\n\nexport let closure_pruned_stmt_count = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String\n) -> Int with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport let source_group_pruned_stmt_count = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let _ = db\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport let compile_with_modules_cached = (db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)]) -> (Bytes, TypeDb) with { Error } {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_merged_source(next_db, main_path, ordered_sources)\n  let (module_source, codegen_db) = db_module_source(merge_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n  match db_load_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let stmts = parse_program(lex(module_source))\n      let bytes = compile_module(stmts)\n      (bytes, db_store_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_modules_wasi_cached = (db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String,\n  mode: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if mode == \"mvp\" {\n    \"wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if mode == \"mvp\" {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String,\n  mode: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if mode == \"mvp\" {\n    \"wasi-mvp-unchecked\"\n  } else if mode == \"no-dce\" {\n    \"wasi-unchecked\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if mode == \"mvp\" {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_unchecked = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String,\n  mode: String\n) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_closure_sources_wasi_mode_unchecked_cached(\n    db_new(),\n    main_source,\n    main_path,\n    sources,\n    entry_name,\n    mode\n  )\n  bytes\n}\n\nexport let compile_with_closure_sources_wasi_mode_uncached = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String,\n  mode: String\n) -> Bytes with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  if mode == \"mvp\" {\n    let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport let compile_with_source_groups_wasi_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, merge_fingerprint, codegen_db) = db_grouped_merged_source(next_db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_wasi_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_grouped_merged_source(db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, merge_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_via_module_source_wasi_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(module_source, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let module_stmts = parse_program(lex(module_source))\n      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)\n      let bytes = compile_wasi_module_impl(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_file_fs = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_module = (entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n\nexport let prepare_file_fs_cached = (db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nlet prepare_file_fs_from_source_groups_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error } {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = source_lookup_or_throw(sources, entry_path)\n  prepare_modules_cached(db, entry_path, main_source, sources)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error, Fs } {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = source_lookup_or_throw(sources, entry_path)\n  prepare_modules_persistent_fs_cached(db, entry_path, main_source, sources)\n}\n\nlet compile_file_fs_cached_slow = (\n  db: TypeDb,\n  entry_path: String,\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name\n  )\n  match load_persistent_artifact(\"fs-compile-wasi\", entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)\n      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)\n      match db_load_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(merged_source))\n          let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n          let bytes = compile_wasi_module(pruned_stmts, entry_name)\n          store_persistent_artifact(\n            \"fs-compile-wasi\",\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_cached = (db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-wasi\",\n        entry_name,\n        build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n      },\n    None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n  }\n}\n\nlet compile_file_fs_module_cached_slow = (\n  db: TypeDb,\n  entry_path: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\"fs-compile-module\", \"\", persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"fs-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached = (db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-module\",\n        \"\",\n        build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n")

  let source_138 = ("vibe/compiler/entry/compiler/file_compile/index.vibe",
"\n\n\n\n\n\n\n\n\n\nlet artifact_fingerprint_from_source = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet seed_type_db_from_source_groups = (\n  db: TypeDb,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nlet prepare_file_fs_from_source_groups_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport let prepare_file_fs_cached = (db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nexport let compile_file_fs = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_mode = (entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let (merged_source, _, _) = db_grouped_merged_source(next_db, source_groups)\n  let merged_stmts = parse_program(lex(merged_source))\n  if mode == \"mvp\" {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if mode == \"no-dce\" {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport let compile_file_fs_module = (entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n\nexport let compile_file_fs_cached = (db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nlet compile_file_fs_mode_cached_slow = (\n  db: TypeDb,\n  entry_path: String,\n  entry_name: String,\n  mode: String,\n  persistent_artifact_kind: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)\n      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)\n      let artifact_kind = if mode == \"mvp\" {\n        \"wasi-mvp\"\n      } else if mode == \"no-dce\" {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(codegen_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(merged_source))\n          let bytes = if mode == \"mvp\" {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_mode_cached = (db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let persistent_artifact_kind = if mode == \"mvp\" {\n    \"file-compile-wasi-mvp\"\n  } else if mode == \"no-dce\" {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nlet compile_file_fs_module_cached_slow = (\n  db: TypeDb,\n  entry_path: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\n    \"file-compile-module\",\n    \"\",\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"file-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached = (db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"file-compile-module\",\n        \"\",\n        build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n")

  let source_139 = ("vibe/compiler/entry/cli_cache/index.vibe",
"\n\n\n\n\nlet strip_trailing_cr = (line: String) -> String {\n  let len = String::length(line)\n  if len > 0 && String::char_code_at(line, len - 1) == 13 {\n    line[0:len - 1]\n  } else {\n    line\n  }\n}\n\nlet split_tsv_fields = (line: String) -> Array[String] {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(line, i) == 9 {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  Array::push(fields, line[start:len])\n  fields\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet remove_file_if_exists = (path: String) -> Unit with { Fs } {\n  if Fs::exists(path) {\n    Fs::remove(path)\n  } else {\n    ()\n  }\n}\n\nlet build_type_db_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let dep_pair = Array::get(dep_fps, i)\n    let dep_path = dep_pair.0\n    let dep_fp = dep_pair.1\n    acc = compact_string_fingerprint(\n      String::concat(\n        acc,\n        String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n      )\n    )\n    i = i + 1\n  }\n  acc\n}\n\nexport let parse_batch_jobs_tsv = (raw: String) -> Array[(String, String, String)] with { Error } {\n  let jobs = Array::slice([(\"\", \"\", \"\")], 0, 0)\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let field_count = Array::length(fields)\n        if field_count < 2 || field_count > 3 {\n          throw(\"invalid VIBE_BATCH_TSV row: expected 2 or 3 tab-separated columns\")\n        }\n        let input_path = Array::get(fields, 0)\n        let output_path = Array::get(fields, 1)\n        let entry_name = if field_count == 3 { Array::get(fields, 2) } else { \"\" }\n        if String::length(input_path) == 0 || String::length(output_path) == 0 {\n          throw(\"invalid VIBE_BATCH_TSV row: input/output path must be non-empty\")\n        }\n        Array::push(jobs, (input_path, output_path, entry_name))\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  jobs\n}\n\nlet compile_job_cached = (db: TypeDb, input_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  if entry_name == \"\" {\n    compile_file_fs_module_cached(db, input_path)\n  } else {\n    compile_file_fs_cached(db, input_path, entry_name)\n  }\n}\n\nlet prepare_jobs_cached_impl = (db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  let mut next_db = db\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, _, _) = Array::get(jobs, i)\n    next_db = prepare_file_fs_cached(next_db, input_path)\n    i = i + 1\n  }\n  next_db\n}\n\nexport let prepare_jobs_cached = (db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  prepare_jobs_cached_impl(db, jobs)\n}\n\nexport let compile_jobs_cached = (db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  let mut next_db = if Array::length(jobs) > 1 {\n    prepare_jobs_cached_impl(db, jobs)\n  } else {\n    db\n  }\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, output_path, entry_name) = Array::get(jobs, i)\n    let (bytes, compiled_db) = compile_job_cached(next_db, input_path, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    next_db = compiled_db\n    i = i + 1\n  }\n  next_db\n}\n\nexport let selfbuild_probe_cli_cache_counts = () -> Int with { Error, Fs } {\n  let helper_path = \"/tmp/vibe_selfhost_cli_cache_v4_helper.vibe\"\n  let main_path = \"/tmp/vibe_selfhost_cli_cache_v4_main.vibe\"\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_write_sources\")\n  Fs::write_bytes(\n    helper_path,\n    string_to_bytes(\"export let add = (a: Int, b: Int) -> Int { a + b }\")\n  )\n  Fs::write_bytes(\n    main_path,\n    string_to_bytes(\"import ./vibe_selfhost_cli_cache_v4_helper.vibe { add }\\nlet run = () -> Int { add(1, 2) }\")\n  )\n  let jobs = [(main_path, \"/tmp/vibe_selfhost_cli_cache_v4_out.wasm\", \"run\")]\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_prepare1\")\n  let db1 = prepare_jobs_cached_impl(db_new(), jobs)\n  Fs::write_file(\n    \"_build/cli_cache_counts_inner_v1.txt\",\n    String::concat(\"after_prepare1:\", __to_string(db_typecheck_count(db1)))\n  )\n  let count1 = db_typecheck_count(db1)\n  Fs::write_file(\"_build/cli_cache_counts_inner_v1.txt\", \"before_prepare2\")\n  let db2 = prepare_jobs_cached_impl(db1, jobs)\n  Fs::write_file(\n    \"_build/cli_cache_counts_inner_v1.txt\",\n    String::concat(\"after_prepare2:\", __to_string(db_typecheck_count(db2)))\n  )\n  let count2 = db_typecheck_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_cli_file_cache_counts = () -> Int with { Error, Fs } {\n  selfbuild_probe_cli_cache_counts()\n}\n\nlet clear_prepare_probe_caches = (\n  helper_path: String,\n  helper_source: String,\n  main1_path: String,\n  main1_source: String,\n  main2_path: String,\n  main2_source: String\n) -> Unit with { Fs } {\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([(\"\", \"\")], 0, 0))\n  let main1_fp = build_type_db_fingerprint(main1_source, [(helper_path, helper_fp)])\n  let main2_fp = build_type_db_fingerprint(main2_source, [(helper_path, helper_fp)])\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(helper_path, compact_string_fingerprint(helper_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main1_path, compact_string_fingerprint(main1_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main2_path, compact_string_fingerprint(main2_source))\n  )\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main2_fp))\n}\n\nlet prepare_probe_sources = (\n  helper_path: String,\n  main1_path: String,\n  main2_path: String\n) -> (String, String, String) {\n  let helper_source = \"export let add = (a: Int, b: Int) -> Int { a + b }\"\n  let main1_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run = () -> Int { add(1, 2) }\"\n    )\n  )\n  let main2_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run = () -> Int { add(3, 4) }\"\n    )\n  )\n  (helper_source, main1_source, main2_source)\n}\n\nexport let selfbuild_probe_cli_prepare_batch_parse_counts = () -> Int with { Error, Fs } {\n  let fresh_helper_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_helper.vibe\"\n  let fresh_main1_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.vibe\"\n  let fresh_main2_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.vibe\"\n  let shared_helper_path = \"/tmp/vibe_selfhost_cli_prepare_shared_helper.vibe\"\n  let shared_main1_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main1.vibe\"\n  let shared_main2_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main2.vibe\"\n  let (fresh_helper_source, fresh_main1_source, fresh_main2_source) = prepare_probe_sources(\n    fresh_helper_path,\n    fresh_main1_path,\n    fresh_main2_path\n  )\n  let (shared_helper_source, shared_main1_source, shared_main2_source) = prepare_probe_sources(\n    shared_helper_path,\n    shared_main1_path,\n    shared_main2_path\n  )\n  Fs::write_bytes(fresh_helper_path, string_to_bytes(fresh_helper_source))\n  Fs::write_bytes(fresh_main1_path, string_to_bytes(fresh_main1_source))\n  Fs::write_bytes(fresh_main2_path, string_to_bytes(fresh_main2_source))\n  Fs::write_bytes(shared_helper_path, string_to_bytes(shared_helper_source))\n  Fs::write_bytes(shared_main1_path, string_to_bytes(shared_main1_source))\n  Fs::write_bytes(shared_main2_path, string_to_bytes(shared_main2_source))\n  clear_prepare_probe_caches(\n    fresh_helper_path,\n    fresh_helper_source,\n    fresh_main1_path,\n    fresh_main1_source,\n    fresh_main2_path,\n    fresh_main2_source\n  )\n  clear_prepare_probe_caches(\n    shared_helper_path,\n    shared_helper_source,\n    shared_main1_path,\n    shared_main1_source,\n    shared_main2_path,\n    shared_main2_source\n  )\n  let fresh_count1 = db_parse_count(prepare_jobs_cached_impl(db_new(), [\n    (fresh_main1_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.wasm\", \"run\")\n  ]))\n  let fresh_count2 = db_parse_count(prepare_jobs_cached_impl(db_new(), [\n    (fresh_main2_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.wasm\", \"run\")\n  ]))\n  let shared_count = db_parse_count(prepare_jobs_cached_impl(db_new(), [\n    (shared_main1_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main1.wasm\", \"run\"),\n    (shared_main2_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main2.wasm\", \"run\")\n  ]))\n  (fresh_count1 + fresh_count2) * 1000 + shared_count\n}\n")

  let source_140 = ("vibe/compiler/cli_cache.vibe",
"\n\n\nexport {\n  compile_jobs_cached, prepare_jobs_cached, parse_batch_jobs_tsv, selfbuild_probe_cli_cache_counts, selfbuild_probe_cli_file_cache_counts, selfbuild_probe_cli_prepare_batch_parse_counts\n}\n")

  let source_141 = ("vibe/compiler/selfhost_cli_adapter.vibe",
"\n\n\nexport let cli_main = () -> Int with { Error, Fs, Env } {\n  let input_path = perform Env::Get(\"VIBE_INPUT\")\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  let entry_name = perform Env::Get(\"VIBE_ENTRY\")\n  let source = perform Fs::ReadFile(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Fs::write_bytes(output_path, bytes)\n  0\n}\n")

  let source_142 = ("vibe/compiler/selfhost_cli_adapter_bundle.vibe",
"\n\nlet empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {\n  let (path, source) = pair\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if String::equals(name, group_name) {\n      Array::push(sources, (path, source))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(sources, (path, source))\n    Array::push(groups, (group_name, sources))\n  }\n}\n\n  let source_0 = (\"vibe/compiler/core/polyfill.vibe\",\n\"//# Functions\\n\\nexport let __to_string = (n: Int) -> String {\\n  if n == 0 {\\n    \\\"0\\\"\\n  } else {\\n    let mut val = n\\n    let mut neg = false\\n    if val < 0 {\\n      neg = true\\n      val = 0 - val\\n    }\\n    let digits = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    while val > 0 {\\n      let d = val - (val / 10) * 10\\n      let ch = if d == 0 {\\n        \\\"0\\\"\\n      }\\n      else if d == 1 {\\n        \\\"1\\\"\\n      }\\n      else if d == 2 {\\n        \\\"2\\\"\\n      }\\n      else if d == 3 {\\n        \\\"3\\\"\\n      }\\n      else if d == 4 {\\n        \\\"4\\\"\\n      }\\n      else if d == 5 {\\n        \\\"5\\\"\\n      }\\n      else if d == 6 {\\n        \\\"6\\\"\\n      }\\n      else if d == 7 {\\n        \\\"7\\\"\\n      }\\n      else if d == 8 {\\n        \\\"8\\\"\\n      }\\n      else {\\n        \\\"9\\\"\\n      }\\n      Array::push(digits, ch)\\n      val = val / 10\\n    }\\n    let mut result = if neg {\\n      \\\"-\\\"\\n    } else {\\n      \\\"\\\"\\n    }\\n    let mut i = Array::length(digits) - 1\\n    while i >= 0 {\\n      result = String::concat(result, Array::get(digits, i))\\n      i = i - 1\\n    }\\n    result\\n  }\\n}\\n\")\n\n  let source_1 = (\"vibe/compiler/core/bytebuf.vibe\",\n\"//# Functions\\n\\nexport let bytebuf_new = () -> Bytes {\\n  Bytes::new()\\n}\\n\\nexport let bytebuf_push = (buf: Bytes, byte: Int) -> Unit {\\n  Bytes::push(buf, byte)\\n}\\n\\nexport let bytebuf_push2 = (buf: Bytes, b1: Int, b2: Int) -> Unit {\\n  bytebuf_push(buf, b1)\\n  bytebuf_push(buf, b2)\\n}\\n\\nexport let bytebuf_push3 = (buf: Bytes, b1: Int, b2: Int, b3: Int) -> Unit {\\n  bytebuf_push(buf, b1)\\n  bytebuf_push(buf, b2)\\n  bytebuf_push(buf, b3)\\n}\\n\\nexport let bytebuf_push9 = (buf: Bytes, b1: Int, b2: Int, b3: Int, b4: Int, b5: Int, b6: Int, b7: Int, b8: Int, b9: Int) -> Unit {\\n  bytebuf_push(buf, b1)\\n  bytebuf_push(buf, b2)\\n  bytebuf_push(buf, b3)\\n  bytebuf_push(buf, b4)\\n  bytebuf_push(buf, b5)\\n  bytebuf_push(buf, b6)\\n  bytebuf_push(buf, b7)\\n  bytebuf_push(buf, b8)\\n  bytebuf_push(buf, b9)\\n}\\n\\nexport let bytebuf_length = (buf: Bytes) -> Int {\\n  Bytes::length(buf)\\n}\\n\\nexport let bytebuf_push_buf = (dst: Bytes, src: Bytes) -> Unit {\\n  Bytes::append(dst, src)\\n}\\n\\nexport let bytebuf_to_bytes = (buf: Bytes) -> Bytes {\\n  buf\\n}\\n\\nexport let leb128_encode_s32 = (buf: Bytes, value: Int) -> Unit {\\n  if value >= (0 - 64) && value < 64 {\\n    Bytes::push(buf, value&127)\\n  } else {\\n    if value >= (0 - 8192) && value < 8192 {\\n      Bytes::push(buf, (value&127)|128)\\n      Bytes::push(buf, (value>>7)&127)\\n    } else {\\n      let mut v = value\\n      let mut more = true\\n      while more {\\n        let byte = v&127\\n        v = v>>7\\n        if (v == 0) && (byte&64) == 0 {\\n          Bytes::push(buf, byte)\\n          more = false\\n        } else {\\n          if (v == 0 - 1) && (byte&64) != 0 {\\n            Bytes::push(buf, byte)\\n            more = false\\n          } else {\\n            Bytes::push(buf, byte|128)\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport let leb128_encode_s64 = (buf: Bytes, value: Int) -> Unit {\\n  leb128_encode_s32(buf, value)\\n}\\n\\nexport let leb128_encode_u32 = (buf: Bytes, value: Int) -> Unit {\\n  if value >= 0 && value < 128 {\\n    Bytes::push(buf, value)\\n  } else {\\n    if value >= 128 && value < 16384 {\\n      Bytes::push(buf, (value&127)|128)\\n      Bytes::push(buf, (value>>7)&127)\\n    } else {\\n      let mut v = value\\n      let mut more = true\\n      while more {\\n        let byte = v&127\\n        v = (v>>7)&((1<<25) - 1)\\n        if v == 0 {\\n          Bytes::push(buf, byte)\\n          more = false\\n        } else {\\n          Bytes::push(buf, byte|128)\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport let bytebuf_push_string = (buf: Bytes, s: String) -> Unit {\\n  let slen = String::length(s)\\n  leb128_encode_u32(buf, slen)\\n  let mut i = 0\\n  while i < slen {\\n    bytebuf_push(buf, String::char_code_at(s, i))\\n    i = i + 1\\n  }\\n}\\n\\nexport let bytebuf_push_section = (out: Bytes, section_id: Int, content: Bytes) -> Unit {\\n  bytebuf_push(out, section_id)\\n  leb128_encode_u32(out, bytebuf_length(content))\\n  bytebuf_push_buf(out, content)\\n}\\n\\nexport let bytebuf_push_opcode_s64 = (buf: Bytes, opcode: Int, value: Int) -> Unit {\\n  bytebuf_push(buf, opcode)\\n  leb128_encode_s32(buf, value)\\n}\\n\\nexport let bytebuf_push_opcode_u32 = (buf: Bytes, opcode: Int, value: Int) -> Unit {\\n  if value >= 0 && value < 128 {\\n    Bytes::push(buf, opcode)\\n    Bytes::push(buf, value)\\n  } else {\\n    if value >= 128 && value < 16384 {\\n      Bytes::push(buf, opcode)\\n      Bytes::push(buf, (value&127)|128)\\n      Bytes::push(buf, (value>>7)&127)\\n    } else {\\n      Bytes::push(buf, opcode)\\n      leb128_encode_u32(buf, value)\\n    }\\n  }\\n}\\n\\nexport let bytebuf_push_vec_header = (buf: Bytes, count: Int) -> Unit {\\n  leb128_encode_u32(buf, count)\\n}\\n\\nexport let bytebuf_push_opcode_u32_u32 = (buf: Bytes, opcode: Int, a: Int, b: Int) -> Unit {\\n  bytebuf_push(buf, opcode)\\n  leb128_encode_u32(buf, a)\\n  leb128_encode_u32(buf, b)\\n}\\n\")\n\n  let source_2 = (\"vibe/compiler/core/ast.vibe\",\n\"//# Types\\n\\nexport enum Pat {\\n  PWild;\\n  PBind(String);\\n  PInt(Int);\\n  PString(String);\\n  PBool(Bool);\\n  PCtor(String, Array[Pat]);\\n  PTuple(Array[Pat]);\\n  POr(Pat, Pat)\\n}\\n\\nexport enum TypeExpr {\\n  TyName(String);\\n  TyApp(String, Array[TypeExpr]);\\n  TyFn(Array[TypeExpr], TypeExpr, Option[String]);\\n  TyTuple(Array[TypeExpr]);\\n  TyUnit\\n}\\n\\nexport enum Expr {\\n  EInt(Int);\\n  EFloat(Double);\\n  EString(String);\\n  EBool(Bool);\\n  EIdent(String);\\n  ETuple(Array[Expr]);\\n  EArray(Array[Expr]);\\n  ERecord(Array[(String, Expr)]);\\n  EIf(Expr, Expr, Expr);\\n  ELet(String, Expr, Expr);\\n  ELetRec(String, Expr, Expr);\\n  ELetMut(String, Expr, Expr);\\n  EAssign(String, Expr, Expr);\\n  EAssignOp(String, String, Expr, Expr);\\n  ESeq(Expr, Expr);\\n  EMatch(Expr, Array[(Pat, Expr)]);\\n  EHandle(Expr, Array[(Pat, Expr)]);\\n  EWhile(Expr, Expr);\\n  ELoop(Array[(String, Expr)], Expr);\\n  EForIn(String, Option[String], Expr, Expr);\\n  ECall(Expr, Array[Expr]);\\n  EBinOp(String, Expr, Expr);\\n  EUnaryOp(String, Expr);\\n  EFn(Array[String], Array[(String, Array[String])], Array[(String, Option[TypeExpr])], Option[TypeExpr], Option[String], Expr);\\n  EDot(Expr, String);\\n  ELabeledArg(String, String, Expr);\\n  EThrow(Expr);\\n  EBreak(Option[Expr]);\\n  EContinue(Array[Expr]);\\n  EMap(Array[(String, Expr)]);\\n  ESpread(Expr);\\n  EStringInterp(Array[String]);\\n  EUnit\\n}\\n\\nexport enum Stmt {\\n  SLet(Bool, Bool, String, Option[TypeExpr], Expr);\\n  SLetMut(String, Option[TypeExpr], Expr);\\n  SEnum(Bool, String, Array[(String, Array[TypeExpr])]);\\n  SSuberror(Bool, String, Array[(String, Array[TypeExpr])]);\\n  SStruct(Bool, String, Array[(String, TypeExpr)]);\\n  STypeAlias(Bool, String, TypeExpr);\\n  STrait(Bool, String, Array[String]);\\n  SImpl(Array[String], Array[(String, Array[String])], String, String);\\n  SExternLet(String, TypeExpr);\\n  SImport(String, Array[(String, Option[String])]);\\n  STest(String, Expr);\\n  SBench(String, Expr);\\n  SExpr(Expr);\\n  SExport(Array[String]);\\n  SReExport(String, Array[(String, Option[String])]);\\n  SAliasDecl(String, String);\\n  SLetPat(Pat, Expr);\\n  SModule(Bool, String, Array[Stmt]);\\n  SEffectDef(Bool, String, Array[String], Array[(String, Array[TypeExpr], TypeExpr)])\\n}\\n\")\n\n  let source_3 = (\"vibe/compiler/core/types.vibe\",\n\"//# Types\\n\\nexport enum Type {\\n  CtInt;\\n  CtDouble;\\n  CtBool;\\n  CtString;\\n  CtChar;\\n  CtUnit;\\n  CtTuple(Array[Type]);\\n  CtArray(Type);\\n  CtOption(Type);\\n  CtFn(Array[Type], Type, Option[String]);\\n  CtEnum(String);\\n  CtStruct(String);\\n  CtBytes;\\n  CtNamed(String, Array[Type]);\\n  CtVar(Int);\\n  CtForAll(Array[Int], Array[(Int, Array[String])], Type);\\n  CtUnknown\\n}\\n\\nexport enum TypeDef {\\n  TDEnum(String, Array[(String, Array[Type])]);\\n  TDStruct(String, Array[(String, Type)]);\\n  TDAlias(String, Type)\\n}\\n\\nexport enum TypeEnv {\\n  EnvEmpty;\\n  EnvBind(String, Type, TypeEnv);\\n  EnvTraitDef(String, Array[String], Bool, TypeEnv);\\n  EnvTraitImpl(String, Type, TypeEnv);\\n  EnvTraitImplGen(String, Array[String], Array[(String, Array[String])], Type, TypeEnv);\\n  EnvCached(Map[String, Type], TypeEnv)\\n}\\n\\nexport enum Subst {\\n  SubstEmpty;\\n  SubstBind(Int, Type, Subst);\\n  SubstBound(Int, Array[String], Subst);\\n  SubstCached(Map[String, Type], Map[String, Array[String]], Subst)\\n}\\n\\n//# Functions\\n\\nexport let env_bind = (env: TypeEnv, name: String, ty: Type) -> TypeEnv {\\n  EnvBind(name, ty, env)\\n}\\n\\nexport let env_cache = (env: TypeEnv) -> TypeEnv {\\n  let is_empty = match env {\\n    EnvEmpty => true,\\n    _ => false\\n  }\\n  if is_empty {\\n    EnvEmpty\\n  } else {\\n    let names = ArrayBuilder::new()\\n    let types = ArrayBuilder::new()\\n    let rec collect = (cur: TypeEnv) -> Unit {\\n      match cur {\\n        EnvEmpty => (),\\n        EnvBind(n, ty, rest) => {\\n          ArrayBuilder::push(names, n)\\n          ArrayBuilder::push(types, ty)\\n          collect(rest)\\n        },\\n        EnvTraitDef(_, _, _, rest) => collect(rest),\\n        EnvTraitImpl(_, _, rest) => collect(rest),\\n        EnvTraitImplGen(_, _, _, _, rest) => collect(rest),\\n        EnvCached(_, rest) => collect(rest)\\n      }\\n    }\\n    collect(env)\\n    let na = ArrayBuilder::freeze(names)\\n    let ta = ArrayBuilder::freeze(types)\\n    let cache = MapBuilder::new()\\n    let len = Array::length(na)\\n    let mut i = 0\\n    while i < len {\\n      let idx = len - i - 1\\n      MapBuilder::set(cache, Array::get(na, idx), Array::get(ta, idx))\\n      i = i + 1\\n    }\\n    EnvCached(MapBuilder::freeze(cache), env)\\n  }\\n}\\n\\nexport let fresh_var = (c: Int) -> (Type, Int) {\\n  (CtVar(c), c + 1)\\n}\\n\\nexport let rec occurs_in = (id: Int, ty: Type) -> Bool {\\n  match ty {\\n    CtVar(vid) => (id == vid),\\n    CtFn(params, ret, _) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(params) {\\n        if occurs_in(id, Array::get(params, i)) {\\n          found = true\\n          i = Array::length(params)\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found || occurs_in(id, ret)\\n    },\\n    CtArray(elem) => occurs_in(id, elem),\\n    CtOption(elem) => occurs_in(id, elem),\\n    CtTuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if occurs_in(id, Array::get(elems, i)) {\\n          found = true\\n          i = Array::length(elems)\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    CtForAll(_, _, body) => occurs_in(id, body),\\n    _ => false\\n  }\\n}\\n\\nexport let rec env_lookup = (env: TypeEnv, name: String) -> Option[Type] {\\n  match env {\\n    EnvEmpty => None,\\n    EnvBind(n, ty, rest) => if n == name {\\n      Some(ty)\\n    } else {\\n      env_lookup(rest, name)\\n    },\\n    EnvTraitDef(_, _, _, rest) => env_lookup(rest, name),\\n    EnvTraitImpl(_, _, rest) => env_lookup(rest, name),\\n    EnvTraitImplGen(_, _, _, _, rest) => env_lookup(rest, name),\\n    EnvCached(cache, rest) => if Map::has_key(cache, name) {\\n      Some(Map::get(cache, name))\\n    } else {\\n      env_lookup(rest, name)\\n    }\\n  }\\n}\\n\\nexport let env_bind_all = (env: TypeEnv, bindings: Array[(String, Type)]) -> TypeEnv {\\n  let len = Array::length(bindings)\\n  let mut i = 0\\n  let mut acc = env\\n  while i < len {\\n    let (name, ty) = Array::get(bindings, i)\\n    acc = EnvBind(name, ty, acc)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nexport let find_typedef = (defs: Array[TypeDef], name: String) -> Option[TypeDef] {\\n  let len = Array::length(defs)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let d = Array::get(defs, i)\\n      let dname = match d {\\n        TDEnum(n, _) => n,\\n        TDStruct(n, _) => n,\\n        TDAlias(n, _) => n\\n      }\\n      if dname == name {\\n        result = Some(d)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nexport let subst_lookup = (s: Subst, id: Int) -> Option[Type] {\\n  let mut cur = s\\n  let mut out = None\\n  let mut done = false\\n  let key = __to_string(id)\\n  while !done {\\n    match cur {\\n      SubstEmpty => {\\n        done = true\\n      },\\n      SubstBind(i, ty, rest) => if i == id {\\n        out = Some(ty)\\n        done = true\\n      } else {\\n        cur = rest\\n      }\\n      ,\\n      SubstBound(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstCached(cache, _, rest) => if Map::has_key(cache, key) {\\n        out = Some(Map::get(cache, key))\\n        done = true\\n      } else {\\n        cur = rest\\n      }\\n    }\\n  }\\n  out\\n}\\n\\nexport let rec trait_supers = (env: TypeEnv, name: String) -> Array[String] {\\n  let empty = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match env {\\n    EnvEmpty => empty,\\n    EnvBind(_, _, rest) => trait_supers(rest, name),\\n    EnvTraitDef(tname, supers, _, rest) => if tname == name {\\n      supers\\n    } else trait_supers(rest, name),\\n    EnvTraitImpl(_, _, rest) => trait_supers(rest, name),\\n    EnvTraitImplGen(_, _, _, _, rest) => trait_supers(rest, name),\\n    EnvCached(_, rest) => trait_supers(rest, name)\\n  }\\n}\\n\\nlet rec array_has_int = (arr: Array[Int], val: Int, i: Int) -> Bool {\\n  if i >= Array::length(arr) {\\n    false\\n  }\\n  else if Array::get(arr, i) == val {\\n    true\\n  }\\n  else array_has_int(arr, val, i + 1)\\n}\\n\\nlet int_array_has = (arr: Array[Int], v: Int) -> Bool {\\n  let slen = Array::length(arr)\\n  let mut si = 0\\n  let mut sfound = false\\n  let mut sdone = false\\n  while !sdone {\\n    if si >= slen {\\n      sdone = true\\n    } else if Array::get(arr, si) == v {\\n      sfound = true\\n      sdone = true\\n    } else {\\n      si = si + 1\\n    }\\n  }\\n  sfound\\n}\\n\\nexport let rec subst_apply = (s: Subst, ty: Type) -> Type {\\n  match ty {\\n    CtInt => ty,\\n    CtBool => ty,\\n    CtString => ty,\\n    CtUnit => ty,\\n    CtDouble => ty,\\n    CtChar => ty,\\n    CtBytes => ty,\\n    CtUnknown => ty,\\n    CtVar(_) => {\\n      let mut cur = ty\\n      let mut out = ty\\n      let mut done = false\\n      let mut seen = Array::slice([\\n        0\\n      ], 0, 0)\\n      while !done {\\n        match cur {\\n          CtVar(vid) => if int_array_has(seen, vid) {\\n            out = cur\\n            done = true\\n          } else {\\n            Array::push(seen, vid)\\n            match subst_lookup(s, vid) {\\n              Some(next) => {\\n                cur = next\\n                out = next\\n              },\\n              None => {\\n                out = cur\\n                done = true\\n              }\\n            }\\n          },\\n          _ => {\\n            out = subst_apply(s, cur)\\n            done = true\\n          }\\n        }\\n      }\\n      out\\n    },\\n    CtFn(params, ret, effect_name) => {\\n      let rp = for p in params {\\n        subst_apply(s, p)\\n      }\\n      CtFn(rp, subst_apply(s, ret), effect_name)\\n    },\\n    CtArray(elem) => CtArray(subst_apply(s, elem)),\\n    CtOption(elem) => CtOption(subst_apply(s, elem)),\\n    CtTuple(elems) => CtTuple(for e in elems {\\n      subst_apply(s, e)\\n    }),\\n    CtForAll(_, _, _) => ty,\\n    _ => ty\\n  }\\n}\\n\\nexport let rec trait_defined = (env: TypeEnv, name: String) -> Bool {\\n  match env {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => trait_defined(rest, name),\\n    EnvTraitDef(tname, _, _, rest) => if tname == name {\\n      true\\n    } else trait_defined(rest, name),\\n    EnvTraitImpl(_, _, rest) => trait_defined(rest, name),\\n    EnvTraitImplGen(_, _, _, _, rest) => trait_defined(rest, name),\\n    EnvCached(_, rest) => trait_defined(rest, name)\\n  }\\n}\\n\\nexport let rec type_to_string = (ty: Type) -> String {\\n  match ty {\\n    CtInt => \\\"Int\\\",\\n    CtDouble => \\\"Double\\\",\\n    CtBool => \\\"Bool\\\",\\n    CtString => \\\"String\\\",\\n    CtChar => \\\"Char\\\",\\n    CtUnit => \\\"()\\\",\\n    CtBytes => \\\"Bytes\\\",\\n    CtVar(id) => \\\"?t\\\\{id}\\\",\\n    CtForAll(vars, _, body) => {\\n      let vlen = Array::length(vars)\\n      let mut vi = 0\\n      let mut vacc = \\\"\\\"\\n      while vi < vlen {\\n        let v = \\\"?t\\\\{Array::get(vars, vi)}\\\"\\n        let next = if vi > 0 {\\n          \\\"\\\\{vacc} \\\\{v}\\\"\\n        } else v\\n        vacc = next\\n        vi = vi + 1\\n      }\\n      \\\"forall \\\\{vacc}. \\\\{type_to_string(body)}\\\"\\n    },\\n    CtUnknown => \\\"?\\\",\\n    CtArray(elem) => \\\"Array[\\\\{type_to_string(elem)}]\\\",\\n    CtOption(elem) => \\\"Option[\\\\{type_to_string(elem)}]\\\",\\n    CtEnum(name) => name,\\n    CtStruct(name) => name,\\n    CtNamed(name, args) => if Array::length(args) == 0 {\\n      name\\n    } else {\\n      let parts = for arg in args {\\n        type_to_string(arg)\\n      }\\n      let mut i = 0\\n      let mut joined = \\\"\\\"\\n      while i < Array::length(parts) {\\n        joined = if i > 0 {\\n          \\\"\\\\{joined}, \\\\{Array::get(parts, i)}\\\"\\n        } else Array::get(parts, i)\\n        i = i + 1\\n      }\\n      \\\"\\\\{name}[\\\\{joined}]\\\"\\n    },\\n    CtTuple(elems) => {\\n      let parts = for e in elems {\\n        type_to_string(e)\\n      }\\n      let mut i = 0\\n      let mut joined = \\\"\\\"\\n      while i < Array::length(parts) {\\n        joined = if i > 0 {\\n          \\\"\\\\{joined}, \\\\{Array::get(parts, i)}\\\"\\n        } else Array::get(parts, i)\\n        i = i + 1\\n      }\\n      \\\"(\\\\{joined})\\\"\\n    },\\n    CtFn(params, ret, effect_name) => {\\n      let parts = for p in params {\\n        type_to_string(p)\\n      }\\n      let mut i = 0\\n      let mut joined = \\\"\\\"\\n      while i < Array::length(parts) {\\n        joined = if i > 0 {\\n          \\\"\\\\{joined}, \\\\{Array::get(parts, i)}\\\"\\n        } else Array::get(parts, i)\\n        i = i + 1\\n      }\\n      let base = \\\"(\\\\{joined}) -> \\\\{type_to_string(ret)}\\\"\\n      match effect_name {\\n        Some(name) => \\\"\\\\{base} with {\\\\{name}}\\\",\\n        None => base\\n      }\\n    }\\n  }\\n}\\n\\nlet empty_type_args = () -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nexport let env_lookup_flat = (bindings: Array[(String, Type)], name: String) -> Option[Type] {\\n  let len = Array::length(bindings)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (n, ty) = Array::get(bindings, i)\\n      if n == name {\\n        result = Some(ty)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\n\\nexport let resolve_builtin = (name: String) -> Option[Type] {\\n  if name == \\\"Int\\\" || name == \\\"i32\\\" {\\n    Some(CtInt)\\n  }\\n  else if name == \\\"Double\\\" || name == \\\"f64\\\" {\\n    Some(CtDouble)\\n  }\\n  else if name == \\\"Bool\\\" {\\n    Some(CtBool)\\n  }\\n  else if name == \\\"String\\\" {\\n    Some(CtString)\\n  }\\n  else if name == \\\"Char\\\" {\\n    Some(CtChar)\\n  }\\n  else if name == \\\"Unit\\\" {\\n    Some(CtUnit)\\n  }\\n  else if name == \\\"Bytes\\\" {\\n    Some(CtBytes)\\n  }\\n  else if name == \\\"i64\\\"\\n  || name == \\\"u8\\\"\\n  || name == \\\"u16\\\"\\n  || name == \\\"u32\\\"\\n  || name == \\\"u64\\\"\\n  || name == \\\"i16\\\"\\n  || name == \\\"v128\\\" {\\n    Some(CtNamed(name, empty_type_args()))\\n  }\\n  else None\\n}\\n\\nexport let subst_add_bound = (s: Subst, id: Int, bounds: Array[String]) -> Subst {\\n  SubstBound(id, bounds, s)\\n}\\n\\nlet empty_var_bounds = () -> Array[(Int, Array[String])] {\\n  Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\nlet rec int_bounds_has_id = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Bool {\\n  if i >= Array::length(pairs) {\\n    false\\n  } else {\\n    let (pid, _) = Array::get(pairs, i)\\n    if pid == id {\\n      true\\n    } else {\\n      int_bounds_has_id(pairs, id, i + 1)\\n    }\\n  }\\n}\\n\\nlet rec int_bounds_lookup = (pairs: Array[(Int, Array[String])], id: Int, i: Int) -> Array[String] {\\n  if i >= Array::length(pairs) {\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  } else {\\n    let (pid, bounds) = Array::get(pairs, i)\\n    if pid == id {\\n      bounds\\n    } else {\\n      int_bounds_lookup(pairs, id, i + 1)\\n    }\\n  }\\n}\\n\\nlet rec int_int_lookup_or = (pairs: Array[(Int, Int)], key: Int, fallback: Int, i: Int) -> Int {\\n  if i >= Array::length(pairs) {\\n    fallback\\n  } else {\\n    let (k, v) = Array::get(pairs, i)\\n    if k == key {\\n      v\\n    } else {\\n      int_int_lookup_or(pairs, key, fallback, i + 1)\\n    }\\n  }\\n}\\n\\nexport let instantiate = (ty: Type, c: Int) -> (Type, Int, Array[(Int, Array[String])]) {\\n  match ty {\\n    CtForAll(bound_vars, var_bounds, body) => {\\n      let blen = Array::length(bound_vars)\\n      let id_map = Array::slice([\\n        (0, 0)\\n      ], 0, 0)\\n      let mut bi = 0\\n      let mut bacc = SubstEmpty\\n      let mut bnc = c\\n      while bi < blen {\\n        let old_id = Array::get(bound_vars, bi)\\n        Array::push(id_map, (old_id, bnc))\\n        bacc = SubstBind(old_id, CtVar(bnc), bacc)\\n        bnc = bnc + 1\\n        bi = bi + 1\\n      }\\n      let inst_s = bacc\\n      let id_map2 = id_map\\n      let c1 = bnc\\n      let new_bounds = Array::slice([\\n        (0, Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n      ], 0, 0)\\n      for var_bound in var_bounds {\\n        let (old_id, bounds) = var_bound\\n        let new_id = int_int_lookup_or(id_map2, old_id, old_id, 0)\\n        Array::push(new_bounds, (new_id, bounds))\\n      };\\n      (subst_apply(inst_s, body), c1, new_bounds)\\n    },\\n    _ => (ty, c, empty_var_bounds())\\n  }\\n}\\n\\nexport let rec trait_is_subtrait = (env: TypeEnv, sub: String, super_name: String) -> Bool {\\n  if sub == super_name {\\n    true\\n  }\\n  else {\\n    let supers = trait_supers(env, sub)\\n    let slen = Array::length(supers)\\n    let mut si = 0\\n    let mut sresult = false\\n    let mut sdone = false\\n    while !sdone {\\n      if si >= slen {\\n        sdone = true\\n      } else {\\n        let s = Array::get(supers, si)\\n        if s == super_name {\\n          sresult = true\\n          sdone = true\\n        } else if trait_is_subtrait(env, s, super_name) {\\n          sresult = true\\n          sdone = true\\n        } else {\\n          si = si + 1\\n        }\\n      }\\n    }\\n    sresult\\n  }\\n}\\n\\nlet rec collect_tvars_walk = (t: Type, out: Array[Int]) -> Int {\\n  match t {\\n    CtVar(id) => {\\n      if !array_has_int(out, id, 0) {\\n        Array::push(out, id)\\n      }\\n      0\\n    },\\n    CtFn(params, ret, _) => {\\n      for p in params {\\n        let _ = collect_tvars_walk(p, out)\\n      }\\n      collect_tvars_walk(ret, out)\\n    },\\n    CtArray(elem) => collect_tvars_walk(elem, out),\\n    CtOption(elem) => collect_tvars_walk(elem, out),\\n    CtTuple(elems) => {\\n      for e in elems {\\n        let _ = collect_tvars_walk(e, out)\\n      }\\n      0\\n    },\\n    CtForAll(_, _, body) => collect_tvars_walk(body, out),\\n    _ => 0\\n  }\\n}\\n\\nexport let collect_tvars = (ty: Type) -> Array[Int] {\\n  let out = Array::slice([\\n    0\\n  ], 0, 0)\\n  let _ = collect_tvars_walk(ty, out)\\n  out\\n}\\n\\nlet empty_env_bindings = () -> Array[(String, Type)] {\\n  Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n}\\n\\nexport let env_flat_bindings = (env: TypeEnv) -> Array[(String, Type)] {\\n  let out = empty_env_bindings()\\n  let rec collect = (cur: TypeEnv) -> Unit {\\n    match cur {\\n      EnvEmpty => (),\\n      EnvBind(name, ty, rest) => {\\n        Array::push(out, (name, ty))\\n        collect(rest)\\n      },\\n      EnvTraitDef(_, _, _, rest) => collect(rest),\\n      EnvTraitImpl(_, _, rest) => collect(rest),\\n      EnvTraitImplGen(_, _, _, _, rest) => collect(rest),\\n      EnvCached(_, rest) => collect(rest)\\n    }\\n  }\\n  collect(env)\\n  out\\n}\\n\\nlet string_array_equal = (left: Array[String], right: Array[String]) -> Bool {\\n  let len = Array::length(left)\\n  let mut i = 0\\n  let mut result = true\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else if Array::get(left, i) != Array::get(right, i) {\\n      result = false\\n      done = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nlet option_string_equal = (left: Option[String], right: Option[String]) -> Bool {\\n  match left {\\n    Some(left_name) => match right {\\n      Some(right_name) => left_name == right_name,\\n      None => false\\n    },\\n    None => match right {\\n      Some(_) => false,\\n      None => true\\n    }\\n  }\\n}\\n\\nexport let rec types_equal = (a: Type, b: Type) -> Bool {\\n  match a {\\n    CtInt => match b {\\n      CtInt => true,\\n      _ => false\\n    },\\n    CtDouble => match b {\\n      CtDouble => true,\\n      _ => false\\n    },\\n    CtBool => match b {\\n      CtBool => true,\\n      _ => false\\n    },\\n    CtString => match b {\\n      CtString => true,\\n      _ => false\\n    },\\n    CtChar => match b {\\n      CtChar => true,\\n      _ => false\\n    },\\n    CtUnit => match b {\\n      CtUnit => true,\\n      _ => false\\n    },\\n    CtBytes => match b {\\n      CtBytes => true,\\n      _ => false\\n    },\\n    CtUnknown => match b {\\n      CtUnknown => true,\\n      _ => false\\n    },\\n    CtVar(aid) => match b {\\n      CtVar(bid) => (aid == bid),\\n      _ => false\\n    },\\n    CtArray(aelem) => match b {\\n      CtArray(belem) => types_equal(aelem, belem),\\n      _ => false\\n    },\\n    CtOption(aelem) => match b {\\n      CtOption(belem) => types_equal(aelem, belem),\\n      _ => false\\n    },\\n    CtEnum(aname) => match b {\\n      CtEnum(bname) => aname == bname,\\n      _ => false\\n    },\\n    CtStruct(aname) => match b {\\n      CtStruct(bname) => aname == bname,\\n      _ => false\\n    },\\n    CtNamed(aname, aargs) => match b {\\n      CtNamed(bname, bargs) =>\\n      if aname != bname {\\n        false\\n      } else if Array::length(aargs) != Array::length(bargs) {\\n        false\\n      } else {\\n        let tae_len = Array::length(aargs)\\n        let mut tae_i = 0\\n        let mut tae_result = true\\n        let mut tae_done = false\\n        while !tae_done {\\n          if tae_i >= tae_len {\\n            tae_done = true\\n          } else {\\n            if types_equal(Array::get(aargs, tae_i), Array::get(bargs, tae_i)) {\\n              tae_i = tae_i + 1\\n            } else {\\n              tae_result = false\\n              tae_done = true\\n            }\\n          }\\n        }\\n        tae_result\\n      },\\n      _ => false\\n    },\\n    CtTuple(aelems) => match b {\\n      CtTuple(belems) =>\\n      if Array::length(aelems) != Array::length(belems) {\\n        false\\n      } else {\\n        let tae_len2 = Array::length(aelems)\\n        let mut tae_i2 = 0\\n        let mut tae_result2 = true\\n        let mut tae_done2 = false\\n        while !tae_done2 {\\n          if tae_i2 >= tae_len2 {\\n            tae_done2 = true\\n          } else {\\n            if types_equal(Array::get(aelems, tae_i2), Array::get(belems, tae_i2)) {\\n              tae_i2 = tae_i2 + 1\\n            } else {\\n              tae_result2 = false\\n              tae_done2 = true\\n            }\\n          }\\n        }\\n        tae_result2\\n      },\\n      _ => false\\n    },\\n    CtFn(aparams, aret, aeffect) => match b {\\n      CtFn(bparams, bret, beffect) =>\\n      if Array::length(aparams) != Array::length(bparams) {\\n        false\\n      } else if option_string_equal(aeffect, beffect) {\\n        let tae_len3 = Array::length(aparams)\\n        let mut tae_i3 = 0\\n        let mut tae_result3 = true\\n        let mut tae_done3 = false\\n        while !tae_done3 {\\n          if tae_i3 >= tae_len3 {\\n            tae_done3 = true\\n          } else {\\n            if types_equal(Array::get(aparams, tae_i3), Array::get(bparams, tae_i3)) {\\n              tae_i3 = tae_i3 + 1\\n            } else {\\n              tae_result3 = false\\n              tae_done3 = true\\n            }\\n          }\\n        }\\n        if tae_result3 {\\n          types_equal(aret, bret)\\n        } else {\\n          false\\n        }\\n      } else {\\n        false\\n      },\\n      _ => false\\n    },\\n    CtForAll(avars, abounds, abody) => match b {\\n      CtForAll(bvars, bbounds, bbody) => if Array::length(avars) != Array::length(bvars) {\\n        false\\n      } else if Array::length(abounds) != Array::length(bbounds) {\\n        false\\n      } else {\\n        let vlen = Array::length(avars)\\n        let mut vi = 0\\n        let mut vresult = true\\n        let mut vdone = false\\n        while !vdone {\\n          if vi >= vlen {\\n            vdone = true\\n          } else if Array::get(avars, vi) != Array::get(bvars, vi) {\\n            vresult = false\\n            vdone = true\\n          } else {\\n            vi = vi + 1\\n          }\\n        }\\n        if vresult {\\n          let fbe_len = Array::length(abounds)\\n          let mut fbe_i = 0\\n          let mut fbe_result = true\\n          let mut fbe_done = false\\n          while !fbe_done {\\n            if fbe_i >= fbe_len {\\n              fbe_done = true\\n            } else {\\n              let (lvar, lbounds) = Array::get(abounds, fbe_i)\\n              let (rvar, rbounds) = Array::get(bbounds, fbe_i)\\n              if lvar != rvar {\\n                fbe_result = false\\n                fbe_done = true\\n              } else if Array::length(lbounds) != Array::length(rbounds) {\\n                fbe_result = false\\n                fbe_done = true\\n              } else {\\n                if string_array_equal(lbounds, rbounds) {\\n                  fbe_i = fbe_i + 1\\n                } else {\\n                  fbe_result = false\\n                  fbe_done = true\\n                }\\n              }\\n            }\\n          }\\n          if fbe_result {\\n            types_equal(abody, bbody)\\n          } else {\\n            false\\n          }\\n        } else {\\n          false\\n        }\\n      }\\n      ,\\n      _ => false\\n    }\\n  }\\n}\\n\\nexport let rec unify = (a: Type, b: Type, s: Subst) -> Option[Subst] {\\n  let ta = subst_apply(s, a)\\n  let tb = subst_apply(s, b)\\n  if types_equal(ta, tb) {\\n    Some(s)\\n  }\\n  else match ta {\\n    CtVar(id) => if occurs_in(id, tb) {\\n      None\\n    } else Some(SubstBind(id, tb, s)),\\n    _ => match tb {\\n      CtVar(id) => if occurs_in(id, ta) {\\n        None\\n      } else Some(SubstBind(id, ta, s)),\\n      _ => match ta {\\n        CtUnknown => Some(s),\\n        _ => match tb {\\n          CtUnknown => Some(s),\\n          _ => match ta {\\n            CtForAll(_, _, body_a) => match tb {\\n              CtForAll(_, _, body_b) => unify(body_a, body_b, s),\\n              _ => unify(body_a, tb, s)\\n            },\\n            _ => match tb {\\n              CtForAll(_, _, body_b) => unify(ta, body_b, s),\\n              _ => match ta {\\n                CtArray(ea) => match tb {\\n                  CtArray(eb) => unify(ea, eb, s),\\n                  _ => None\\n                },\\n                CtOption(ea) => match tb {\\n                  CtOption(eb) => unify(ea, eb, s),\\n                  _ => None\\n                },\\n                CtFn(pa, ra, aeffect) => match tb {\\n                  CtFn(pb, rb, beffect) => if Array::length(pa) != Array::length(pb) {\\n                    None\\n                  }\\n                  else if !option_string_equal(aeffect, beffect) {\\n                    None\\n                  }\\n                  else {\\n                    let ul_len = Array::length(pa)\\n                    let mut ul_i = 0\\n                    let mut ul_acc = s\\n                    let mut ul_result = Some(s)\\n                    let mut ul_done = false\\n                    while !ul_done {\\n                      if ul_i >= ul_len {\\n                        ul_result = Some(ul_acc)\\n                        ul_done = true\\n                      } else {\\n                        match unify(Array::get(pa, ul_i), Array::get(pb, ul_i), ul_acc) {\\n                          Some(s2) => {\\n                            ul_acc = s2\\n                            ul_i = ul_i + 1\\n                          },\\n                          None => {\\n                            ul_result = None\\n                            ul_done = true\\n                          }\\n                        }\\n                      }\\n                    }\\n                    match ul_result {\\n                      Some(s2) => unify(ra, rb, s2),\\n                      None => None\\n                    }\\n                  },\\n                  _ => None\\n                },\\n                CtTuple(ea) => match tb {\\n                  CtTuple(eb) => if Array::length(ea) != Array::length(eb) {\\n                    None\\n                  }\\n                  else {\\n                    let ul_len2 = Array::length(ea)\\n                    let mut ul_i2 = 0\\n                    let mut ul_acc2 = s\\n                    let mut ul_result2 = Some(s)\\n                    let mut ul_done2 = false\\n                    while !ul_done2 {\\n                      if ul_i2 >= ul_len2 {\\n                        ul_result2 = Some(ul_acc2)\\n                        ul_done2 = true\\n                      } else {\\n                        match unify(Array::get(ea, ul_i2), Array::get(eb, ul_i2), ul_acc2) {\\n                          Some(s2) => {\\n                            ul_acc2 = s2\\n                            ul_i2 = ul_i2 + 1\\n                          },\\n                          None => {\\n                            ul_result2 = None\\n                            ul_done2 = true\\n                          }\\n                        }\\n                      }\\n                    }\\n                    ul_result2\\n                  },\\n                  _ => None\\n                },\\n                CtEnum(a_name) => match tb {\\n                  CtEnum(b_name) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  _ => None\\n                },\\n                CtStruct(a_name) => match tb {\\n                  CtStruct(b_name) => if a_name == b_name {\\n                    Some(s)\\n                  } else None,\\n                  _ => None\\n                },\\n                CtNamed(a_name, a_args) => match tb {\\n                  CtNamed(b_name, b_args) => if a_name != b_name {\\n                    None\\n                  }\\n                  else if Array::length(a_args) != Array::length(b_args) {\\n                    None\\n                  }\\n                  else {\\n                    let ul_len3 = Array::length(a_args)\\n                    let mut ul_i3 = 0\\n                    let mut ul_acc3 = s\\n                    let mut ul_result3 = Some(s)\\n                    let mut ul_done3 = false\\n                    while !ul_done3 {\\n                      if ul_i3 >= ul_len3 {\\n                        ul_result3 = Some(ul_acc3)\\n                        ul_done3 = true\\n                      } else {\\n                        match unify(Array::get(a_args, ul_i3), Array::get(b_args, ul_i3), ul_acc3) {\\n                          Some(s2) => {\\n                            ul_acc3 = s2\\n                            ul_i3 = ul_i3 + 1\\n                          },\\n                          None => {\\n                            ul_result3 = None\\n                            ul_done3 = true\\n                          }\\n                        }\\n                      }\\n                    }\\n                    ul_result3\\n                  },\\n                  _ => None\\n                },\\n                _ => None\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nexport let types_compatible = (expected: Type, actual: Type) -> Bool {\\n  match expected {\\n    CtUnknown => true,\\n    _ => match actual {\\n      CtUnknown => true,\\n      _ => types_equal(expected, actual)\\n    }\\n  }\\n}\\n\\nexport let rec impls_overlap_for = (env: TypeEnv, trait_name: String, new_target: Type) -> Bool {\\n  match env {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => impls_overlap_for(rest, trait_name, new_target),\\n    EnvTraitDef(_, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\\n      if types_equal(target, new_target) {\\n        true\\n      }\\n      else impls_overlap_for(rest, trait_name, new_target)\\n    } else impls_overlap_for(rest, trait_name, new_target),\\n    EnvTraitImplGen(_, _, _, _, rest) => impls_overlap_for(rest, trait_name, new_target),\\n    EnvCached(_, rest) => impls_overlap_for(rest, trait_name, new_target)\\n  }\\n}\\n\\nlet rec type_implements_check_env = (e: TypeEnv, trait_name: String, resolved: Type) -> Bool {\\n  match e {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => type_implements_check_env(rest, trait_name, resolved),\\n    EnvTraitDef(_, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\\n    EnvTraitImpl(tname, target, rest) => if tname == trait_name {\\n      if types_equal(target, resolved) {\\n        true\\n      }\\n      else type_implements_check_env(rest, trait_name, resolved)\\n    } else type_implements_check_env(rest, trait_name, resolved),\\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_env(rest, trait_name, resolved),\\n    EnvCached(_, rest) => type_implements_check_env(rest, trait_name, resolved)\\n  }\\n}\\n\\nlet collect_subst_bounds_pairs = (s: Subst) -> Array[(Int, Array[String])] {\\n  let out = Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut cur = s\\n  let mut done = false\\n  while !done {\\n    match cur {\\n      SubstEmpty => {\\n        done = true\\n      },\\n      SubstBind(_, _, rest) => {\\n        cur = rest\\n      },\\n      SubstBound(id, bounds, rest) => {\\n        if !int_bounds_has_id(out, id, 0) {\\n          Array::push(out, (id, bounds))\\n        }\\n        cur = rest\\n      },\\n      SubstCached(_, _, rest) => {\\n        cur = rest\\n      }\\n    }\\n  }\\n  out\\n}\\n\\nexport let generalize = (s: Subst, ty: Type) -> Type {\\n  let resolved = subst_apply(s, ty)\\n  let tvars = collect_tvars(resolved)\\n  if Array::length(tvars) == 0 {\\n    resolved\\n  }\\n  else {\\n    let bounds_pairs = collect_subst_bounds_pairs(s)\\n    let var_bounds = Array::slice([\\n      (0, Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))\\n    ], 0, 0)\\n    for vid in tvars {\\n      let bounds = int_bounds_lookup(bounds_pairs, vid, 0)\\n      if Array::length(bounds) != 0 {\\n        Array::push(var_bounds, (vid, bounds))\\n      }\\n    }\\n    CtForAll(tvars, var_bounds, resolved)\\n  }\\n}\\n\\nlet rec type_implements_check_super = (e2: TypeEnv, full_env: TypeEnv, trait_name: String, resolved: Type) -> Bool {\\n  match e2 {\\n    EnvEmpty => false,\\n    EnvBind(_, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvTraitDef(_, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvTraitImpl(tname, target, rest) => if types_equal(target, resolved) {\\n      if trait_is_subtrait(full_env, tname, trait_name) {\\n        true\\n      }\\n      else type_implements_check_super(rest, full_env, trait_name, resolved)\\n    } else type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvTraitImplGen(_, _, _, _, rest) => type_implements_check_super(rest, full_env, trait_name, resolved),\\n    EnvCached(_, rest) => type_implements_check_super(rest, full_env, trait_name, resolved)\\n  }\\n}\\n\\nexport let rec type_implements_trait = (env: TypeEnv, s: Subst, ty: Type, trait_name: String) -> Bool {\\n  let resolved = subst_apply(s, ty)\\n  if type_implements_check_env(env, trait_name, resolved) {\\n    true\\n  }\\n  else {\\n    let supers = trait_supers(env, trait_name)\\n    let slen = Array::length(supers)\\n    if slen == 0 {\\n      false\\n    }\\n    else {\\n      type_implements_check_super(env, env, trait_name, resolved)\\n    }\\n  }\\n}\\n\")\n\n  let source_4 = (\"vibe/compiler/core/dce.vibe\",\n\"//# Imports\\n\\nimport ./ast.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\n//# Functions\\n\\nlet clone_arr = (arr: Array[String]) -> Array[String] {\\n  Array::slice(arr, 0, Array::length(arr))\\n}\\n\\nlet stmt_name = (stmt: Stmt) -> Option[String] {\\n  match stmt {\\n    SLet(_, _, name, _, _) => Some(name),\\n    SLetMut(name, _, _) => Some(name),\\n    _ => None\\n  }\\n}\\n\\nlet array_contains_str = (arr: Array[String], s: String) -> Bool {\\n  let len = Array::length(arr)\\n  let rec search = (i: Int) -> Bool {\\n    if i >= len {\\n      false\\n    }\\n    else if Array::get(arr, i) == s {\\n      true\\n    }\\n    else search(i + 1)\\n  }\\n  search(0)\\n}\\n\\nlet add_ref = (out: Array[String], bound: Array[String], name: String) -> Int {\\n  if not(array_contains_str(bound, name)) {\\n    if not(array_contains_str(out, name)) {\\n      Array::push(out, name)\\n    }\\n  }\\n  0\\n}\\n\\nlet rec collect_pat_bindings = (pat: Pat, bound: Array[String]) -> Int {\\n  match pat {\\n    PWild => 0,\\n    PBind(name) => {\\n      Array::push(bound, name)\\n      0\\n    },\\n    PInt(_) => 0,\\n    PString(_) => 0,\\n    PBool(_) => 0,\\n    PCtor(_, pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pat_bindings(Array::get(pats, i), bound)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pat_bindings(Array::get(pats, i), bound)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(p1, p2) => {\\n      collect_pat_bindings(p1, bound)\\n      collect_pat_bindings(p2, bound)\\n      0\\n    }\\n  }\\n}\\n\\nlet rec collect_refs_into = (expr: Expr, bound: Array[String], out: Array[String]) -> Int {\\n  match expr {\\n    EIdent(name) => add_ref(out, bound, name),\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EBreak(_) => 0,\\n    EContinue(_) => 0,\\n    EThrow(e) => collect_refs_into(e, bound, out),\\n    EUnaryOp(_, e) => collect_refs_into(e, bound, out),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        collect_refs_into(Array::get(items, i), bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        collect_refs_into(Array::get(items, i), bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ERecord(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, val) = Array::get(fields, i)\\n        collect_refs_into(val, bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EBinOp(_, l, r) => {\\n      collect_refs_into(l, bound, out)\\n      collect_refs_into(r, bound, out)\\n      0\\n    },\\n    ECall(callee, args) => {\\n      collect_refs_into(callee, bound, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_refs_into(Array::get(args, i), bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      collect_refs_into(cond, bound, out)\\n      collect_refs_into(then_e, bound, out)\\n      collect_refs_into(else_e, bound, out)\\n      0\\n    },\\n    ELet(name, val, body) => {\\n      collect_refs_into(val, bound, out)\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    ELetRec(name, val, body) => {\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      collect_refs_into(val, bound2, out)\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    ELetMut(name, val, body) => {\\n      collect_refs_into(val, bound, out)\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EAssign(_, val, body) => {\\n      collect_refs_into(val, bound, out)\\n      collect_refs_into(body, bound, out)\\n      0\\n    },\\n    EAssignOp(_, _, val, body) => {\\n      collect_refs_into(val, bound, out)\\n      collect_refs_into(body, bound, out)\\n      0\\n    },\\n    ESeq(l, r) => {\\n      collect_refs_into(l, bound, out)\\n      collect_refs_into(r, bound, out)\\n      0\\n    },\\n    EMatch(scr, arms) => {\\n      collect_refs_into(scr, bound, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, body) = Array::get(arms, i)\\n        let bound2 = clone_arr(bound)\\n        collect_pat_bindings(pat, bound2)\\n        collect_refs_into(body, bound2, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EHandle(body_expr, arms) => {\\n      collect_refs_into(body_expr, bound, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, arm_body) = Array::get(arms, i)\\n        let bound2 = clone_arr(bound)\\n        collect_pat_bindings(pat, bound2)\\n        collect_refs_into(arm_body, bound2, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EWhile(cond, body) => {\\n      collect_refs_into(cond, bound, out)\\n      collect_refs_into(body, bound, out)\\n      0\\n    },\\n    ELoop(params, body) => {\\n      let bound2 = clone_arr(bound)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, init) = Array::get(params, i)\\n        collect_refs_into(init, bound2, out)\\n        Array::push(bound2, name)\\n        i = i + 1\\n      }\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      collect_refs_into(iter, bound, out)\\n      let bound2 = clone_arr(bound)\\n      Array::push(bound2, name)\\n      match index_name {\\n        Some(index_name) => Array::push(bound2, index_name),\\n        None => ()\\n      }\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      let bound2 = clone_arr(bound)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, _) = Array::get(params, i)\\n        Array::push(bound2, pname)\\n        i = i + 1\\n      }\\n      collect_refs_into(body, bound2, out)\\n      0\\n    },\\n    EDot(obj, _) => {\\n      collect_refs_into(obj, bound, out)\\n      0\\n    },\\n    ELabeledArg(_, _, e) => {\\n      collect_refs_into(e, bound, out)\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, val) = Array::get(fields, i)\\n        collect_refs_into(val, bound, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ESpread(e) => {\\n      collect_refs_into(e, bound, out)\\n      0\\n    },\\n    EStringInterp(_) => 0\\n  }\\n}\\n\\nlet collect_refs = (expr: Expr, bound: Array[String]) -> Array[String] {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  collect_refs_into(expr, bound, out)\\n  out\\n}\\n\\nlet is_type_or_structural = (stmt: Stmt) -> Bool {\\n  match stmt {\\n    SEnum(_, _, _) => true,\\n    SSuberror(_, _, _) => true,\\n    SEffectDef(_, _, _, _) => true,\\n    SStruct(_, _, _) => true,\\n    STypeAlias(_, _, _) => true,\\n    STrait(_, _, _) => true,\\n    SImpl(_, _, _, _) => true,\\n    SExternLet(_, _) => true,\\n    SImport(_, _) => true,\\n    SAliasDecl(_, _) => true,\\n    STest(_, _) => true,\\n    SBench(_, _) => true,\\n    SExpr(_) => true,\\n    SExport(_) => true,\\n    SReExport(_, _) => true,\\n    SModule(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let dce_stmts = (stmts: Array[Stmt], entry_names: Array[String]) -> Array[Stmt] {\\n  let empty_bound = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let def_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let def_refs = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt_name(stmt) {\\n      Some(name) => {\\n        Array::push(def_names, name)\\n        let refs = match stmt {\\n          SLet(_, _, _, _, expr) => collect_refs(expr, empty_bound),\\n          SLetMut(_, _, expr) => collect_refs(expr, empty_bound),\\n          _ => Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n        }\\n        Array::push(def_refs, refs)\\n        0\\n      },\\n      None => 0\\n    }\\n    i = i + 1\\n  }\\n  let reachable = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let queue = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut j = 0\\n  while j < Array::length(entry_names) {\\n    let name = Array::get(entry_names, j)\\n    if not(array_contains_str(reachable, name)) {\\n      Array::push(reachable, name)\\n      Array::push(queue, name)\\n    }\\n    j = j + 1\\n  }\\n  let mut qi = 0\\n  while qi < Array::length(queue) {\\n    let current = Array::get(queue, qi)\\n    qi = qi + 1\\n    let mut k = 0\\n    while k < Array::length(def_names) {\\n      if Array::get(def_names, k) == current {\\n        let refs = Array::get(def_refs, k)\\n        let mut r = 0\\n        while r < Array::length(refs) {\\n          let dep = Array::get(refs, r)\\n          if not(array_contains_str(reachable, dep)) {\\n            Array::push(reachable, dep)\\n            Array::push(queue, dep)\\n          }\\n          r = r + 1\\n        }\\n      }\\n      k = k + 1\\n    }\\n  }\\n  let result = Array::slice([\\n    Array::get(stmts, 0)\\n  ], 0, 0)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    let stmt = Array::get(stmts, m)\\n    if is_type_or_structural(stmt) {\\n      Array::push(result, stmt)\\n    } else {\\n      match stmt_name(stmt) {\\n        Some(name) => if array_contains_str(reachable, name) {\\n          Array::push(result, stmt)\\n        },\\n        None => Array::push(result, stmt)\\n      }\\n    }\\n    m = m + 1\\n  }\\n  result\\n}\\n\")\n\n  let source_5 = (\"vibe/compiler/core/index.vibe\",\n\"export let version = \\\"0.1.0\\\"\\n\\nexport ./ast.vibe {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nexport ./polyfill.vibe {\\n  __to_string\\n}\\n\\nexport ./bytebuf.vibe {\\n  bytebuf_new, bytebuf_push, bytebuf_length, bytebuf_to_bytes, leb128_encode_s32, leb128_encode_s64, leb128_encode_u32, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_push_buf, bytebuf_push2, bytebuf_push3, bytebuf_push9, bytebuf_push_opcode_u32, bytebuf_push_opcode_s64, bytebuf_push_opcode_u32_u32, bytebuf_push_string\\n}\\n\\nexport ./dce.vibe {\\n  dce_stmts\\n}\\n\\nexport ./types.vibe {\\n  Type, TypeDef, TypeEnv, Subst, env_bind, fresh_var, occurs_in, env_lookup, env_cache, env_flat_bindings, env_lookup_flat, types_equal, env_bind_all, find_typedef, subst_lookup, subst_apply, unify, trait_supers, collect_tvars, generalize, trait_defined, type_to_string, resolve_builtin, subst_add_bound, instantiate, types_compatible, impls_overlap_for, trait_is_subtrait, type_implements_trait\\n}\\n\")\n\n  let source_6 = (\"vibe/compiler/syntax/token.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  __to_string\\n}\\n\\nimport ./float_format.vibe {\\n  double_to_string_compiler\\n}\\n\\n//# Types\\n\\nexport enum Token {\\n  TInt(Int);\\n  TFloat(Double);\\n  TString(String);\\n  TIdent(String);\\n  TLet;\\n  TRec;\\n  TMut;\\n  TFn;\\n  TIf;\\n  TElse;\\n  TMatch;\\n  TDo;\\n  TEnum;\\n  TStruct;\\n  TType;\\n  TTrait;\\n  TImpl;\\n  TExport;\\n  TTest;\\n  TWhile;\\n  TFor;\\n  TIn;\\n  TLoop;\\n  TBreak;\\n  TContinue;\\n  TReturn;\\n  TWith;\\n  THandle;\\n  TThrow;\\n  TRaise;\\n  TYield;\\n  TBench;\\n  TDeclare;\\n  TAs;\\n  TModule;\\n  TSuberror;\\n  TDerive;\\n  TOpen;\\n  TImport;\\n  TPlus;\\n  TMinus;\\n  TStar;\\n  TSlash;\\n  TPercent;\\n  TEqEq;\\n  TNeq;\\n  TLt;\\n  TLte;\\n  TGt;\\n  TGte;\\n  TAnd;\\n  TOr;\\n  TNot;\\n  TBitAnd;\\n  TBitOr;\\n  TBitXor;\\n  TLShift;\\n  TRShift;\\n  TPipeGt;\\n  TArrow;\\n  TThinArrow;\\n  TEq;\\n  TDot;\\n  TColon;\\n  TDoubleColon;\\n  TComma;\\n  TSemicolon;\\n  THash;\\n  TTilde;\\n  TQuestion;\\n  TPlusEq;\\n  TMinusEq;\\n  TStarEq;\\n  TSlashEq;\\n  TPercentEq;\\n  TLParen;\\n  TRParen;\\n  TLBrace;\\n  TRBrace;\\n  TLBracket;\\n  TRBracket;\\n  TDotDot;\\n  TDotDotDot;\\n  TStringInterp(Array[String]);\\n  TEof\\n}\\n\\n//# Functions\\n\\nexport let token_to_string = (t: Token) -> String {\\n  match t {\\n    TInt(n) => String::concat(\\\"TInt(\\\", String::concat(__to_string(n), \\\")\\\")),\\n    TFloat(n) =>\\n    String::concat(\\\"TFloat(\\\", String::concat(double_to_string_compiler(n), \\\")\\\")),\\n    TString(s) => String::concat(\\\"TString(\\\\\\\"\\\", String::concat(s, \\\"\\\\\\\")\\\")),\\n    TIdent(s) => String::concat(\\\"TIdent(\\\", String::concat(s, \\\")\\\")),\\n    TLet => \\\"TLet\\\",\\n    TRec => \\\"TRec\\\",\\n    TMut => \\\"TMut\\\",\\n    TFn => \\\"TFn\\\",\\n    TIf => \\\"TIf\\\",\\n    TElse => \\\"TElse\\\",\\n    TMatch => \\\"TMatch\\\",\\n    TDo => \\\"TDo\\\",\\n    TEnum => \\\"TEnum\\\",\\n    TStruct => \\\"TStruct\\\",\\n    TType => \\\"TType\\\",\\n    TTrait => \\\"TTrait\\\",\\n    TImpl => \\\"TImpl\\\",\\n    TExport => \\\"TExport\\\",\\n    TTest => \\\"TTest\\\",\\n    TWhile => \\\"TWhile\\\",\\n    TFor => \\\"TFor\\\",\\n    TIn => \\\"TIn\\\",\\n    TLoop => \\\"TLoop\\\",\\n    TBreak => \\\"TBreak\\\",\\n    TContinue => \\\"TContinue\\\",\\n    TReturn => \\\"TReturn\\\",\\n    TWith => \\\"TWith\\\",\\n    THandle => \\\"THandle\\\",\\n    TThrow => \\\"TThrow\\\",\\n    TRaise => \\\"TRaise\\\",\\n    TYield => \\\"TYield\\\",\\n    TBench => \\\"TBench\\\",\\n    TDeclare => \\\"TDeclare\\\",\\n    TAs => \\\"TAs\\\",\\n    TModule => \\\"TModule\\\",\\n    TSuberror => \\\"TSuberror\\\",\\n    TDerive => \\\"TDerive\\\",\\n    TOpen => \\\"TOpen\\\",\\n    TImport => \\\"TImport\\\",\\n    TPlus => \\\"TPlus\\\",\\n    TMinus => \\\"TMinus\\\",\\n    TStar => \\\"TStar\\\",\\n    TSlash => \\\"TSlash\\\",\\n    TPercent => \\\"TPercent\\\",\\n    TEqEq => \\\"TEqEq\\\",\\n    TNeq => \\\"TNeq\\\",\\n    TLt => \\\"TLt\\\",\\n    TLte => \\\"TLte\\\",\\n    TGt => \\\"TGt\\\",\\n    TGte => \\\"TGte\\\",\\n    TAnd => \\\"TAnd\\\",\\n    TOr => \\\"TOr\\\",\\n    TNot => \\\"TNot\\\",\\n    TBitAnd => \\\"TBitAnd\\\",\\n    TBitOr => \\\"TBitOr\\\",\\n    TBitXor => \\\"TBitXor\\\",\\n    TLShift => \\\"TLShift\\\",\\n    TRShift => \\\"TRShift\\\",\\n    TPipeGt => \\\"TPipeGt\\\",\\n    TArrow => \\\"TArrow\\\",\\n    TThinArrow => \\\"TThinArrow\\\",\\n    TEq => \\\"TEq\\\",\\n    TDot => \\\"TDot\\\",\\n    TColon => \\\"TColon\\\",\\n    TDoubleColon => \\\"TDoubleColon\\\",\\n    TComma => \\\"TComma\\\",\\n    TSemicolon => \\\"TSemicolon\\\",\\n    THash => \\\"THash\\\",\\n    TTilde => \\\"TTilde\\\",\\n    TQuestion => \\\"TQuestion\\\",\\n    TPlusEq => \\\"TPlusEq\\\",\\n    TMinusEq => \\\"TMinusEq\\\",\\n    TStarEq => \\\"TStarEq\\\",\\n    TSlashEq => \\\"TSlashEq\\\",\\n    TPercentEq => \\\"TPercentEq\\\",\\n    TLParen => \\\"TLParen\\\",\\n    TRParen => \\\"TRParen\\\",\\n    TLBrace => \\\"TLBrace\\\",\\n    TRBrace => \\\"TRBrace\\\",\\n    TLBracket => \\\"TLBracket\\\",\\n    TRBracket => \\\"TRBracket\\\",\\n    TDotDot => \\\"TDotDot\\\",\\n    TDotDotDot => \\\"TDotDotDot\\\",\\n    TStringInterp(_) => \\\"TStringInterp\\\",\\n    TEof => \\\"TEof\\\"\\n  }\\n}\\n\")\n\n  let source_7 = (\"vibe/compiler/syntax/float_format.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  __to_string\\n}\\n\\n//# Functions\\n\\nlet zero_pad_6 = (n: Int) -> String {\\n  let s = __to_string(n)\\n  let len = String::length(s)\\n  if len >= 6 {\\n    s\\n  } else {\\n    let mut out = \\\"\\\"\\n    let mut i = len\\n    while i < 6 {\\n      out = String::concat(out, \\\"0\\\")\\n      i = i + 1\\n    }\\n    String::concat(out, s)\\n  }\\n}\\n\\nlet trim_trailing_zeros = (s: String) -> String {\\n  let mut end = String::length(s)\\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\\n    end = end - 1\\n  }\\n  if end <= 0 {\\n    \\\"\\\"\\n  } else {\\n    s[0: end]\\n  }\\n}\\n\\nexport let double_to_string_compiler = (d: Double) -> String {\\n  if d != d {\\n    \\\"nan\\\"\\n  } else {\\n    let neg = d < 0.0\\n    let abs_d = if neg {\\n      0.0 - d\\n    } else {\\n      d\\n    }\\n    let int_part = Double::to_int(abs_d)\\n    let frac = abs_d - Int::to_double(int_part)\\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\\n    let int_norm = if eq(scaled_raw, 1000000) {\\n      int_part + 1\\n    } else {\\n      int_part\\n    }\\n    let frac_norm = if eq(scaled_raw, 1000000) {\\n      0\\n    } else {\\n      scaled_raw\\n    }\\n    let int_s = __to_string(int_norm)\\n    let frac_s = if eq(frac_norm, 0) {\\n      \\\"\\\"\\n    } else {\\n      trim_trailing_zeros(zero_pad_6(frac_norm))\\n    }\\n    let body = if String::length(frac_s) == 0 {\\n      int_s\\n    } else {\\n      String::concat(int_s, String::concat(\\\".\\\", frac_s))\\n    }\\n    if neg {\\n      String::concat(\\\"-\\\", body)\\n    } else {\\n      body\\n    }\\n  }\\n}\\n\")\n\n  let source_8 = (\"vibe/compiler/syntax/lexer.vibe\",\n\"//# Imports\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nlet is_ws = (c: Int) -> Bool {\\n  c == ' ' || c == '\\\\n' || c == '\\\\t' || c == '\\\\r'\\n}\\n\\nlet is_alpha = (c: Int) -> Bool {\\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\\n}\\n\\nlet is_digit = (c: Int) -> Bool {\\n  c >= '0' && c <= '9'\\n}\\n\\nlet is_alnum = (c: Int) -> Bool {\\n  is_alpha(c) || is_digit(c)\\n}\\n\\nlet lex_char = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\\n  let start = i + 1\\n  if start >= len {\\n    throw(\\\"unterminated char literal\\\")\\n  }\\n  let c = String::char_code_at(s, start)\\n  if c == '\\\\\\\\' {\\n    let esc_pos = start + 1\\n    if esc_pos >= len {\\n      throw(\\\"unterminated char escape\\\")\\n    }\\n    let esc = String::char_code_at(s, esc_pos)\\n    let val = if esc == 'n' {\\n      10\\n    }\\n    else if esc == 't' {\\n      9\\n    }\\n    else if esc == 'r' {\\n      13\\n    }\\n    else if esc == '\\\\\\\\' {\\n      92\\n    }\\n    else if esc == '\\\\'' {\\n      39\\n    }\\n    else if esc == '0' {\\n      0\\n    }\\n    else throw(\\\"invalid char escape\\\")\\n    let close = esc_pos + 1\\n    if close >= len || String::char_code_at(s, close) != '\\\\'' {\\n      throw(\\\"expected closing quote for char literal\\\")\\n    };\\n    (TInt(val), close + 1)\\n  } else {\\n    let close = start + 1\\n    if close >= len || String::char_code_at(s, close) != '\\\\'' {\\n      throw(\\\"expected closing quote for char literal\\\")\\n    };\\n    (TInt(c), close + 1)\\n  }\\n}\\n\\nlet slice_eq = (source: String, start: Int, end: Int, text: String) -> Bool {\\n  let len = end - start\\n  let text_len = String::length(text)\\n  if len != text_len {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while ok && i < text_len {\\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nlet is_hex_digit = (c: Int) -> Bool {\\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\\n}\\n\\nlet keyword_lookup = (source: String, start: Int, end: Int) -> Option[Token] {\\n  let len = end - start\\n  if len == 2 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"fn\\\") {\\n        Some(TIdent(\\\"fn\\\"))\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"if\\\") {\\n        Some(TIf)\\n      } else if slice_eq(source, start, end, \\\"in\\\") {\\n        Some(TIn)\\n      } else None\\n    } else if c0 == 'd' {\\n      if slice_eq(source, start, end, \\\"do\\\") {\\n        Some(TDo)\\n      } else None\\n    } else if c0 == 'a' {\\n      if slice_eq(source, start, end, \\\"as\\\") {\\n        Some(TAs)\\n      } else None\\n    } else None\\n  } else if len == 3 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'l' {\\n      if slice_eq(source, start, end, \\\"let\\\") {\\n        Some(TLet)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"rec\\\") {\\n        Some(TRec)\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"mut\\\") {\\n        Some(TMut)\\n      } else None\\n    } else if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"for\\\") {\\n        Some(TFor)\\n      } else None\\n    } else None\\n  } else if len == 4 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'e' {\\n      if slice_eq(source, start, end, \\\"else\\\") {\\n        Some(TElse)\\n      } else if slice_eq(source, start, end, \\\"enum\\\") {\\n        Some(TEnum)\\n      } else None\\n    } else if c0 == 't' {\\n      if slice_eq(source, start, end, \\\"true\\\") {\\n        Some(TIdent(\\\"true\\\"))\\n      } else if slice_eq(source, start, end, \\\"type\\\") {\\n        Some(TType)\\n      } else if slice_eq(source, start, end, \\\"test\\\") {\\n        Some(TTest)\\n      } else None\\n    } else if c0 == 'w' {\\n      if slice_eq(source, start, end, \\\"with\\\") {\\n        Some(TWith)\\n      } else None\\n    } else if c0 == 'l' {\\n      if slice_eq(source, start, end, \\\"loop\\\") {\\n        Some(TLoop)\\n      } else None\\n    } else if c0 == 'o' {\\n      if slice_eq(source, start, end, \\\"open\\\") {\\n        Some(TOpen)\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"impl\\\") {\\n        Some(TImpl)\\n      } else None\\n    } else None\\n  } else if len == 5 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"false\\\") {\\n        Some(TIdent(\\\"false\\\"))\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"match\\\") {\\n        Some(TMatch)\\n      } else None\\n    } else if c0 == 't' {\\n      if slice_eq(source, start, end, \\\"trait\\\") {\\n        Some(TTrait)\\n      } else if slice_eq(source, start, end, \\\"throw\\\") {\\n        Some(TThrow)\\n      } else None\\n    } else if c0 == 'w' {\\n      if slice_eq(source, start, end, \\\"while\\\") {\\n        Some(TWhile)\\n      } else None\\n    } else if c0 == 'b' {\\n      if slice_eq(source, start, end, \\\"break\\\") {\\n        Some(TBreak)\\n      } else if slice_eq(source, start, end, \\\"bench\\\") {\\n        Some(TBench)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"raise\\\") {\\n        Some(TRaise)\\n      } else None\\n    } else if c0 == 'y' {\\n      if slice_eq(source, start, end, \\\"yield\\\") {\\n        Some(TYield)\\n      } else None\\n    } else None\\n  } else if len == 6 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 's' {\\n      if slice_eq(source, start, end, \\\"struct\\\") {\\n        Some(TStruct)\\n      } else None\\n    } else if c0 == 'e' {\\n      if slice_eq(source, start, end, \\\"export\\\") {\\n        Some(TExport)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"return\\\") {\\n        Some(TReturn)\\n      } else None\\n    } else if c0 == 'h' {\\n      if slice_eq(source, start, end, \\\"handle\\\") {\\n        Some(THandle)\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"module\\\") {\\n        Some(TModule)\\n      } else None\\n    } else if c0 == 'd' {\\n      if slice_eq(source, start, end, \\\"derive\\\") {\\n        Some(TDerive)\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"import\\\") {\\n        Some(TImport)\\n      } else None\\n    } else None\\n  } else if len == 7 {\\n    if slice_eq(source, start, end, \\\"declare\\\") {\\n      Some(TDeclare)\\n    } else None\\n  } else if len == 8 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'c' {\\n      if slice_eq(source, start, end, \\\"continue\\\") {\\n        Some(TContinue)\\n      } else None\\n    } else if c0 == 's' {\\n      if slice_eq(source, start, end, \\\"suberror\\\") {\\n        Some(TSuberror)\\n      } else None\\n    } else None\\n  } else None\\n}\\n\\nlet scan_ident_end = (s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  while out < len && is_alnum(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nlet lex_ident = (s: String, len: Int, i: Int) -> (Token, Int) {\\n  let end = scan_ident_end(s, len, i)\\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\\n    let ri_start = end + 1\\n    let ri_end = scan_ident_end(s, len, ri_start)\\n    (TIdent(s[ri_start: ri_end]), ri_end)\\n  }\\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\\\"' {\\n    let mut ri = end + 1\\n    while ri < len && String::char_code_at(s, ri) != '\\\"' {\\n      ri = ri + 1\\n    }\\n    (TString(s[end + 1: ri]), if ri >= len {\\n      ri\\n    } else {\\n      ri + 1\\n    })\\n  } else {\\n    match keyword_lookup(s, i, end) {\\n      Some(tok) => (tok, end),\\n      None => (TIdent(s[i: end]), end)\\n    }\\n  }\\n}\\n\\nlet scan_digits_end = (s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  while out < len && is_digit(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nlet scan_interp_end = (s: String, len: Int, idx: Int, depth: Int) -> Int with { Error } {\\n  let mut out = idx\\n  let mut current_depth = depth\\n  let mut found = -1\\n  while out < len && found < 0 {\\n    let c = String::char_code_at(s, out)\\n    if c == '{' {\\n      current_depth = current_depth + 1\\n    } else if c == '}' {\\n      if current_depth == 1 {\\n        found = out\\n      } else {\\n        current_depth = current_depth - 1\\n      }\\n    }\\n    if found < 0 {\\n      out = out + 1\\n    }\\n  }\\n  if found >= 0 {\\n    found\\n  } else {\\n    throw(\\\"unterminated string interpolation\\\")\\n  }\\n}\\n\\nlet parse_frac_digits = (s: String, len: Int, i: Int, acc: Double, scale: Double) -> (Double, Int) {\\n  let mut out_i = i\\n  let mut out_acc = acc\\n  let mut out_scale = scale\\n  let mut done = false\\n  while out_i < len && !done {\\n    let c = String::char_code_at(s, out_i)\\n    if is_digit(c) {\\n      out_acc = out_acc + Int::to_double(c - 48) / out_scale\\n      out_scale = out_scale * 10.0\\n      out_i = out_i + 1\\n    } else {\\n      done = true\\n    }\\n  }\\n  (out_acc, out_i)\\n}\\n\\nlet empty_string_array = () -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet skip_until_newline = (s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  let mut done = false\\n  while out < len && !done {\\n    if String::char_code_at(s, out) == '\\\\n' {\\n      out = out + 1\\n      done = true\\n    } else {\\n      out = out + 1\\n    }\\n  }\\n  out\\n}\\n\\nlet skip_ws = (s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  let mut skipping = true\\n  while skipping && out < len {\\n    let c = String::char_code_at(s, out)\\n    if is_ws(c) {\\n      out = out + 1\\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\\n      out = skip_until_newline(s, len, out + 2)\\n    } else {\\n      skipping = false\\n    }\\n  }\\n  out\\n}\\n\\nlet concat_string_parts = (parts: Array[String], tail: String) -> String {\\n  let mut out = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(parts) {\\n    out = String::concat(out, Array::get(parts, i))\\n    i = i + 1\\n  }\\n  String::concat(out, tail)\\n}\\n\\nlet lex_string_go = (s: String, len: Int, idx: Int, start: Int, parts_acc: Array[String], has_interp: Bool, parts: ArrayBuilder[String]) -> (Token, Int)with { Error } {\\n  let mut current_idx = idx\\n  let mut current_start = start\\n  let mut current_parts_acc = parts_acc\\n  let mut current_has_interp = has_interp\\n  let mut out_tok = TEof\\n  let mut out_next = -1\\n  let mut done = false\\n  while !done {\\n    if current_idx >= len {\\n      throw(\\\"unterminated string\\\")\\n    }\\n    let c = String::char_code_at(s, current_idx)\\n    if c == '\\\"' {\\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\\n      if current_has_interp {\\n        ArrayBuilder::push(parts, value)\\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts))\\n        out_next = current_idx + 1\\n      } else {\\n        out_tok = TString(value)\\n        out_next = current_idx + 1\\n      }\\n      done = true\\n    } else if c == '\\\\\\\\' {\\n      let chunk = s[current_start: current_idx]\\n      let next = current_idx + 1\\n      if next >= len {\\n        throw(\\\"unterminated string escape\\\")\\n      }\\n      let esc = String::char_code_at(s, next)\\n      if esc == '{' || esc == '(' {\\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\\n        let interp_end = if esc == '{' {\\n          scan_interp_end(s, len, next + 1, 1)\\n        } else {\\n          let mut ie = next + 1\\n          let mut depth = 1\\n          while ie < len && depth > 0 {\\n            let ic = String::char_code_at(s, ie)\\n            if ic == '(' {\\n              depth = depth + 1\\n            }\\n            else if ic == ')' {\\n              depth = depth - 1\\n            }\\n            ie = ie + 1\\n          }\\n          ie - 1\\n        }\\n        let expr_src = s[next + 1: interp_end]\\n        ArrayBuilder::push(parts, expr_src)\\n        current_idx = interp_end + 1\\n        current_start = interp_end + 1\\n        current_parts_acc = empty_string_array()\\n        current_has_interp = true\\n      } else {\\n        let escaped = if esc == '\\\"' {\\n          \\\"\\\\\\\"\\\"\\n        }\\n        else if esc == '\\\\\\\\' {\\n          \\\"\\\\\\\\\\\"\\n        }\\n        else if esc == 'n' {\\n          \\\"\\\\n\\\"\\n        }\\n        else if esc == 't' {\\n          \\\"\\\\t\\\"\\n        }\\n        else if esc == 'r' {\\n          String::from_char_code(13)\\n        }\\n        else if esc == '0' {\\n          String::from_char_code(0)\\n        }\\n        else throw(\\\"invalid escape sequence\\\")\\n        Array::push(current_parts_acc, chunk)\\n        Array::push(current_parts_acc, escaped)\\n        current_idx = next + 1\\n        current_start = next + 1\\n      }\\n    } else {\\n      current_idx = current_idx + 1\\n    }\\n  }\\n  (out_tok, out_next)\\n}\\n\\nlet lex_string = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())\\n}\\n\\nlet scan_hex_digits_end = (s: String, len: Int, i: Int) -> Int {\\n  let mut out = i\\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nlet parse_hex_from_string = (s: String) -> Int {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut acc = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    let digit = if c >= '0' && c <= '9' {\\n      c - 48\\n    } else if c >= 'a' && c <= 'f' {\\n      c - 87\\n    } else c - 55\\n    acc = acc * 16 + digit\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet parse_int_from_string = (s: String) -> Int {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut acc = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    acc = acc * 10 + (c - 48)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet lex_decimal = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\\n  let int_end = scan_digits_end(s, len, i)\\n  if int_end == i {\\n    throw(\\\"expected digit\\\")\\n  }\\n  if int_end < len && String::char_code_at(s, int_end) == '.' {\\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\\n      let int_str = s[i: int_end]\\n      let int_val = Int::to_double(parse_int_from_string(int_str))\\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\\n        (TFloat(int_val + frac_val), frac_end + 1)\\n      } else {\\n        (TFloat(int_val + frac_val), frac_end)\\n      }\\n    } else {\\n      let int_str = s[i: int_end];\\n      (TInt(parse_int_from_string(int_str)), int_end)\\n    }\\n  } else {\\n    let int_str = s[i: int_end];\\n    (TInt(parse_int_from_string(int_str)), int_end)\\n  }\\n}\\n\\nlet lex_number = (s: String, len: Int, i: Int) -> (Token, Int)with { Error } {\\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\\n    let next_c = String::char_code_at(s, i + 1)\\n    if next_c == 'x' || next_c == 'X' {\\n      let hex_start = i + 2\\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\\n      if hex_end == hex_start {\\n        throw(\\\"expected hex digit after 0x\\\")\\n      }\\n      let hex_str = s[hex_start: hex_end];\\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\\n    } else lex_decimal(s, len, i)\\n  } else lex_decimal(s, len, i)\\n}\\n\\nexport let lex = (source: String) -> Array[Token] with { Error } {\\n  let len = String::length(source)\\n  {\\n    let b = ArrayBuilder::new()\\n    let mut pos = skip_ws(source, len, 0)\\n    while pos < len {\\n      let c = String::char_code_at(source, pos)\\n      let (tok, next) = if is_alpha(c) {\\n        lex_ident(source, len, pos)\\n      } else if is_digit(c) {\\n        lex_number(source, len, pos)\\n      } else if c == '\\\"' {\\n        lex_string(source, len, pos)\\n      } else if c == '+' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TPlusEq, pos + 2)\\n        } else (TPlus, pos + 1)\\n      } else if c == '-' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n          (TThinArrow, pos + 2)\\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TMinusEq, pos + 2)\\n        } else (TMinus, pos + 1)\\n      } else if c == '*' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TStarEq, pos + 2)\\n        } else (TStar, pos + 1)\\n      } else if c == '/' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TSlashEq, pos + 2)\\n        } else (TSlash, pos + 1)\\n      } else if c == '%' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TPercentEq, pos + 2)\\n        } else (TPercent, pos + 1)\\n      } else if c == '=' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TEqEq, pos + 2)\\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n          (TArrow, pos + 2)\\n        } else (TEq, pos + 1)\\n      } else if c == '!' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TNeq, pos + 2)\\n        } else (TNot, pos + 1)\\n      } else if c == '<' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TLte, pos + 2)\\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\\n          (TLShift, pos + 2)\\n        } else (TLt, pos + 1)\\n      } else if c == '>' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n          (TGte, pos + 2)\\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n          (TRShift, pos + 2)\\n        } else (TGt, pos + 1)\\n      } else if c == '&' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\\n          (TAnd, pos + 2)\\n        } else (TBitAnd, pos + 1)\\n      } else if c == '|' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\\n          (TOr, pos + 2)\\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n          (TPipeGt, pos + 2)\\n        } else (TBitOr, pos + 1)\\n      } else if c == '^' {\\n        (TBitXor, pos + 1)\\n      } else if c == '(' {\\n        (TLParen, pos + 1)\\n      } else if c == ')' {\\n        (TRParen, pos + 1)\\n      } else if c == '{' {\\n        (TLBrace, pos + 1)\\n      } else if c == '}' {\\n        (TRBrace, pos + 1)\\n      } else if c == '[' {\\n        (TLBracket, pos + 1)\\n      } else if c == ']' {\\n        (TRBracket, pos + 1)\\n      } else if c == ',' {\\n        (TComma, pos + 1)\\n      } else if c == ';' {\\n        (TSemicolon, pos + 1)\\n      } else if c == '.' {\\n        if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\\n          (TDotDotDot, pos + 3)\\n        } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\\n          (TDotDot, pos + 2)\\n        } else (TDot, pos + 1)\\n      } else if c == ':' {\\n        if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\\n          (TDoubleColon, pos + 2)\\n        } else (TColon, pos + 1)\\n      } else if c == '#' {\\n        (THash, pos + 1)\\n      } else if c == '~' {\\n        (TTilde, pos + 1)\\n      } else if c == '?' {\\n        (TQuestion, pos + 1)\\n      } else if c == '@' {\\n        let mut end = pos + 1\\n        while end < len && is_alnum(String::char_code_at(source, end)) {\\n          end = end + 1\\n        }\\n        if end > pos + 1 {\\n          (TIdent(String::substring(source, pos, end)), end)\\n        } else {\\n          throw(\\\"unexpected '@' without identifier\\\")\\n        }\\n      } else if c == '\\\\'' {\\n        lex_char(source, len, pos)\\n      } else throw(String::concat(\\\"unexpected character: \\\", String::from_char_code(c)))\\n      ArrayBuilder::push(b, tok)\\n      pos = skip_ws(source, len, next)\\n    }\\n    ArrayBuilder::push(b, TEof)\\n    ArrayBuilder::freeze(b)\\n  }\\n}\\n\\nexport let lex_ok = (source: String) -> Bool {\\n  handle {\\n    let _ = lex(source)\\n    true\\n  } {\\n    Error(_) => false\\n  }\\n}\\n\")\n\n  let source_9 = (\"vibe/compiler/syntax/parser.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./parser_base.vibe {\\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, skip_semi, tk_name\\n}\\n\\nimport ./parser_expr.vibe {\\n  parse, parse_expr, parse_impl, parse_let_stmt, parse_ok\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nlet mode_block = 20\\n\\nlet empty_names = () -> Array[String] {\\n  Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n}\\n\\nlet parse_test_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TString(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_impl(tokens, br, mode_block);\\n      (STest(name, body), end)\\n    },\\n    _ => throw(\\\"expected test name string\\\")\\n  }\\n}\\n\\nlet parse_bench_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TString(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_impl(tokens, br, mode_block);\\n      (SBench(name, body), end)\\n    },\\n    _ => throw(\\\"expected bench name string\\\")\\n  }\\n}\\n\\nlet rec parse_export_names_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[String]) -> (Array[String], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        parse_export_names_rest(tokens, pos + 2, b)\\n      },\\n      _ => throw(\\\"expected name in export list\\\")\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or '}' in export list\\\")\\n  }\\n}\\n\\nlet rec parse_import_items_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (item, next) = parse_import_item(tokens, pos + 1)\\n        ArrayBuilder::push(b, item)\\n        parse_import_items_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or '}' in import list\\\")\\n  }\\n}\\n\\nlet parse_import_items = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[String])], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_import_items(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_import_item(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_import_items_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nlet parse_import_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(name, items), end)\\n    } else {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      match peek(tokens, bp) {\\n        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\\n          let alias_str = String::substring(alias_name, 1, String::length(alias_name))\\n          (SAliasDecl(alias_str, path), bp + 1)\\n        } else {\\n          let br = expect_tk(tokens, bp, \\\"{\\\")\\n          let (items, end) = parse_import_items(tokens, br);\\n          (SImport(path, items), end)\\n        },\\n        _ => {\\n          let br = expect_tk(tokens, bp, \\\"{\\\")\\n          let (items, end) = parse_import_items(tokens, br);\\n          (SImport(path, items), end)\\n        }\\n      }\\n    },\\n    _ => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(path, items), end)\\n    }\\n  }\\n}\\n\\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (field, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        parse_struct_fields_rest(tokens, next, b)\\n      }\\n    },\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (field, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        parse_struct_fields_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ';', ',' or '}' in struct\\\")\\n  }\\n}\\n\\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_fields(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_struct_field(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_struct_fields_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (fields, end) = parse_struct_fields(tokens, br);\\n      (SStruct(exported, name, fields), end)\\n    },\\n    _ => throw(\\\"expected struct name\\\")\\n  }\\n}\\n\\nlet parse_export_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TLet => parse_let_stmt(tokens, pos + 1, true),\\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\\n    TStruct => parse_struct_stmt(tokens, pos + 1, true),\\n    TIdent(ident_name) => if ident_name == \\\"effect\\\" {\\n      parse_effect_stmt(tokens, pos + 1, true)\\n    } else {\\n      throw(String::concat(\\\"unexpected token in export: \\\", ident_name))\\n    },\\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\\n    TOpen => match peek(tokens, pos + 1) {\\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\\n      _ => throw(\\\"expected 'trait' after 'open'\\\")\\n    },\\n    TLBrace => match peek(tokens, pos + 1) {\\n      TRBrace => (SExport(empty_names()), pos + 2),\\n      TIdent(name) => {\\n        let b = ArrayBuilder::new()\\n        ArrayBuilder::push(b, name)\\n        let (names, end) = parse_export_names_rest(tokens, pos + 2, b);\\n        (SExport(names), end)\\n      },\\n      _ => throw(\\\"expected name in export list\\\")\\n    },\\n    TDot => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SReExport(path, items), end)\\n    },\\n    _ => throw(\\\"unexpected after 'export': \\\\{tk_name(peek(tokens, pos))}\\\")\\n  }\\n}\\n\\nlet parse_percent_symbol_name = (tokens: Array[Token], pos: Int, label: String) -> (String, Int)with { Error } {\\n  let pp = expect_tk(tokens, pos, \\\"%\\\")\\n  match peek(tokens, pp) {\\n    TIdent(name) => (\\\"%\\\\{name}\\\", pp + 1),\\n    _ => throw(\\\"expected \\\\{label} after '%'\\\")\\n  }\\n}\\n\\nlet parse_extern_let_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  let lp = expect_tk(tokens, pos, \\\"let\\\")\\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \\\"extern symbol name\\\")\\n  let cp = expect_tk(tokens, np, \\\":\\\")\\n  let (ty, end) = parse_type(tokens, cp);\\n  (SExternLet(name, ty), end)\\n}\\n\\nexport let rec parse_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  let rec parse_module_body = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Stmt]) -> (Array[Stmt], Int)with { Error } {\\n    match peek(tokens, pos) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n      _ => {\\n        let (stmt, next) = parse_stmt(tokens, pos)\\n        ArrayBuilder::push(b, stmt)\\n        parse_module_body(tokens, next, b)\\n      }\\n    }\\n  }\\n  let head = peek(tokens, pos)\\n  match head {\\n    TLet => parse_let_stmt(tokens, pos + 1, false),\\n    TExport => match peek(tokens, pos + 1) {\\n      TModule => match peek(tokens, pos + 2) {\\n        TIdent(name) => {\\n          let br = expect_tk(tokens, pos + 3, \\\"{\\\")\\n          {\\n            let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\\n            (SModule(true, name, stmts), end)\\n          }\\n        },\\n        _ => throw(\\\"expected module name\\\")\\n      },\\n      _ => parse_export_stmt(tokens, pos + 1)\\n    },\\n    TModule => match peek(tokens, pos + 1) {\\n      TIdent(name) => {\\n        let br = expect_tk(tokens, pos + 2, \\\"{\\\")\\n        {\\n          let (stmts, end) = parse_module_body(tokens, br, ArrayBuilder::new());\\n          (SModule(false, name, stmts), end)\\n        }\\n      },\\n      _ => throw(\\\"expected module name\\\")\\n    },\\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\\n    TStruct => parse_struct_stmt(tokens, pos + 1, false),\\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\\n    TTest => parse_test_stmt(tokens, pos + 1),\\n    TBench => parse_bench_stmt(tokens, pos + 1),\\n    TImport => parse_import_stmt(tokens, pos + 1),\\n    TIdent(name) => if name == \\\"effect\\\" {\\n      parse_effect_stmt(tokens, pos + 1, false)\\n    } else if name == \\\"extern\\\" {\\n      parse_extern_let_stmt(tokens, pos + 1)\\n    } else if name == \\\"use\\\" {\\n      throw(\\\"'use' syntax is removed; use 'import <module-ref> { ... }'\\\")\\n    } else {\\n      let (e, next) = parse_impl(tokens, pos, 0)\\n      match peek(tokens, next) {\\n        TEq => match e {\\n          EIdent(name) => {\\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\\n            (SExpr(EAssign(name, val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TPlusEq => match e {\\n          EIdent(name) => {\\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"+\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TMinusEq => match e {\\n          EIdent(name) => {\\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"-\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TStarEq => match e {\\n          EIdent(name) => {\\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"*\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TSlashEq => match e {\\n          EIdent(name) => {\\n            let (val, vn) = parse_impl(tokens, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"/\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        _ => (SExpr(e), next)\\n      }\\n    },\\n    _ => {\\n      let (e, next) = parse_impl(tokens, pos, 0);\\n      (SExpr(e), next)\\n    }\\n  }\\n}\\n\\nexport let parse_program = (tokens: Array[Token]) -> Array[Stmt] with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut pos = 0\\n  while !is_tk(peek(tokens, pos), \\\"eof\\\") {\\n    pos = skip_semi(tokens, pos)\\n    if is_tk(peek(tokens, pos), \\\"eof\\\") {\\n      break\\n    }\\n    let (stmt, next) = if is_tk(peek(tokens, pos), \\\"impl\\\") {\\n      parse_impl_stmt_dispatch(tokens, pos + 1)\\n    } else {\\n      parse_stmt(tokens, pos)\\n    }\\n    ArrayBuilder::push(b, stmt)\\n    pos = next\\n  }\\n  ArrayBuilder::freeze(b)\\n}\\n\\n//# Misc\\n\\nexport {\\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\\n}\\n\\nexport {\\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\\n}\\n\")\n\n  let source_10 = (\"vibe/compiler/syntax/parser_base.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nlet peek = (tokens: Array[Token], pos: Int) -> Token {\\n  if pos < Array::length(tokens) {\\n    Array::get(tokens, pos)\\n  } else TEof\\n}\\n\\nlet _no_tp = () -> Array[String] {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet _no_tb = () -> Array[(String, Array[String])] {\\n  Array::slice([\\n    (\\\"\\\", _no_tp())\\n  ], 0, 0)\\n}\\n\\nlet mode_if = 21\\n\\nlet tk_name = (tok: Token) -> String {\\n  match tok {\\n    TInt(_) => \\\"int\\\",\\n    TFloat(_) => \\\"float\\\",\\n    TString(_) => \\\"string\\\",\\n    TStringInterp(_) => \\\"string\\\",\\n    TIdent(_) => \\\"ident\\\",\\n    TLet => \\\"let\\\",\\n    TRec => \\\"rec\\\",\\n    TMut => \\\"mut\\\",\\n    TFn => \\\"fn\\\",\\n    TIf => \\\"if\\\",\\n    TElse => \\\"else\\\",\\n    TMatch => \\\"match\\\",\\n    TDo => \\\"do\\\",\\n    TEnum => \\\"enum\\\",\\n    TStruct => \\\"struct\\\",\\n    TType => \\\"type\\\",\\n    TTrait => \\\"trait\\\",\\n    TImpl => \\\"impl\\\",\\n    TExport => \\\"export\\\",\\n    TTest => \\\"test\\\",\\n    TWhile => \\\"while\\\",\\n    TFor => \\\"for\\\",\\n    TIn => \\\"in\\\",\\n    TLoop => \\\"loop\\\",\\n    TBreak => \\\"break\\\",\\n    TContinue => \\\"continue\\\",\\n    TReturn => \\\"return\\\",\\n    TWith => \\\"with\\\",\\n    THandle => \\\"handle\\\",\\n    TThrow => \\\"throw\\\",\\n    TRaise => \\\"raise\\\",\\n    TYield => \\\"yield\\\",\\n    TBench => \\\"bench\\\",\\n    TDeclare => \\\"declare\\\",\\n    TAs => \\\"as\\\",\\n    TModule => \\\"module\\\",\\n    TSuberror => \\\"suberror\\\",\\n    TDerive => \\\"derive\\\",\\n    TOpen => \\\"open\\\",\\n    TImport => \\\"import\\\",\\n    TPlus => \\\"+\\\",\\n    TMinus => \\\"-\\\",\\n    TStar => \\\"*\\\",\\n    TSlash => \\\"/\\\",\\n    TPercent => \\\"%\\\",\\n    TEqEq => \\\"==\\\",\\n    TNeq => \\\"!=\\\",\\n    TLt => \\\"<\\\",\\n    TLte => \\\"<=\\\",\\n    TGt => \\\">\\\",\\n    TGte => \\\">=\\\",\\n    TAnd => \\\"&&\\\",\\n    TOr => \\\"||\\\",\\n    TNot => \\\"!\\\",\\n    TBitAnd => \\\"&\\\",\\n    TBitOr => \\\"|\\\",\\n    TBitXor => \\\"^\\\",\\n    TLShift => \\\"<<\\\",\\n    TRShift => \\\">>\\\",\\n    TPipeGt => \\\"|>\\\",\\n    TArrow => \\\"=>\\\",\\n    TThinArrow => \\\"->\\\",\\n    TEq => \\\"=\\\",\\n    TDot => \\\".\\\",\\n    TColon => \\\":\\\",\\n    TDoubleColon => \\\"::\\\",\\n    TComma => \\\",\\\",\\n    TSemicolon => \\\";\\\",\\n    THash => \\\"#\\\",\\n    TTilde => \\\"~\\\",\\n    TQuestion => \\\"?\\\",\\n    TPlusEq => \\\"+=\\\",\\n    TMinusEq => \\\"-=\\\",\\n    TStarEq => \\\"*=\\\",\\n    TSlashEq => \\\"/=\\\",\\n    TPercentEq => \\\"%=\\\",\\n    TLParen => \\\"(\\\",\\n    TRParen => \\\")\\\",\\n    TLBrace => \\\"{\\\",\\n    TRBrace => \\\"}\\\",\\n    TLBracket => \\\"[\\\",\\n    TRBracket => \\\"]\\\",\\n    TDotDot => \\\"..\\\",\\n    TDotDotDot => \\\"...\\\",\\n    TStringInterp(_) => \\\"string\\\",\\n    TEof => \\\"eof\\\"\\n  }\\n}\\n\\nlet is_tk = (tok: Token, name: String) -> Bool {\\n  tk_name(tok) == name\\n}\\n\\nlet expect_tk = (tokens: Array[Token], pos: Int, expected: String) -> Int with { Error } {\\n  if is_tk(peek(tokens, pos), expected) {\\n    pos + 1\\n  }\\n  else throw(\\\"expected \\\\{expected} but got \\\\{tk_name(peek(tokens, pos))}\\\")\\n}\\n\\nlet skip_semi = (tokens: Array[Token], pos: Int) -> Int {\\n  match peek(tokens, pos) {\\n    TSemicolon => pos + 1,\\n    _ => pos\\n  }\\n}\\n\\nlet empty_arms = () -> Array[(Pat, Expr)] {\\n  Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n}\\n\\nlet empty_pats = () -> Array[Pat] {\\n  Array::slice([\\n    PWild\\n  ], 0, 0)\\n}\\n\\nlet mode_block = 20\\n\\nlet mode_match = 22\\n\\nlet mode_while = 23\\n\\nlet empty_ctors = () -> Array[(String, Array[TypeExpr])] {\\n  Array::slice([\\n    (\\\"_\\\", Array::slice([\\n      TyUnit\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\nlet empty_exprs = () -> Array[Expr] {\\n  Array::slice([\\n    EUnit\\n  ], 0, 0)\\n}\\n\\nlet mode_for_in = 25\\n\\nlet mode_handle = 24\\n\\nlet empty_fields = () -> Array[(String, TypeExpr)] {\\n  Array::slice([\\n    (\\\"_\\\", TyUnit)\\n  ], 0, 0)\\n}\\n\\nlet empty_params = () -> Array[(String, Option[TypeExpr])] {\\n  Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n}\\n\\nlet rec parse_pattern = (tokens: Array[Token], pos: Int) -> (Pat, Int)with { Error } {\\n  let rec parse_pat_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[Pat]) -> (Array[Pat], Int)with { Error } {\\n    match peek(tokens, pos) {\\n      TComma => {\\n        let (p, pn) = parse_pattern(tokens, pos + 1)\\n        ArrayBuilder::push(b, p)\\n        parse_pat_cont(tokens, pn, b)\\n      },\\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n      _ => throw(\\\"expected ',' or ')' in pattern list\\\")\\n    }\\n  }\\n  let parse_pats_until_rparen = (tokens: Array[Token], pos: Int) -> (Array[Pat], Int)with { Error } {\\n    match peek(tokens, pos) {\\n      TRParen => (empty_pats(), pos + 1),\\n      _ => {\\n        let (f, fn1) = parse_pattern(tokens, pos)\\n        let b = ArrayBuilder::new()\\n        ArrayBuilder::push(b, f)\\n        parse_pat_cont(tokens, fn1, b)\\n      }\\n    }\\n  }\\n  let (pat, next) = match peek(tokens, pos) {\\n    TInt(n) => (PInt(n), pos + 1),\\n    TFloat(_) => (PWild, pos + 1),\\n    TString(s) => (PString(s), pos + 1),\\n    TIdent(name) => {\\n      let next_is_lbrace = match peek(tokens, pos + 1) {\\n        TLBrace => true,\\n        _ => false\\n      }\\n      if name == \\\"true\\\" {\\n        (PBool(true), pos + 1)\\n      }\\n      else if name == \\\"false\\\" {\\n        (PBool(false), pos + 1)\\n      }\\n      else if name == \\\"_\\\" {\\n        (PWild, pos + 1)\\n      }\\n      else if name == \\\"record\\\" && next_is_lbrace {\\n        let mut rp = pos + 2\\n        let field_pats_b = ArrayBuilder::new()\\n        let mut rd = true\\n        while rd {\\n          match peek(tokens, rp) {\\n            TRBrace => {\\n              rd = false\\n            },\\n            TIdent(fname) => {\\n              match peek(tokens, rp + 1) {\\n                TColon => {\\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\\n                  ArrayBuilder::push(field_pats_b, fp)\\n                  rp = fnext\\n                },\\n                TComma => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                },\\n                TRBrace => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                },\\n                _ => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                }\\n              }\\n              match peek(tokens, rp) {\\n                TComma => {\\n                  rp = rp + 1\\n                },\\n                _ => ()\\n              }\\n            },\\n            _ => {\\n              rp = rp + 1\\n            }\\n          }\\n        }\\n        let rp2 = rp + 1\\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\\n      }\\n      else {\\n        let fc = String::char_code_at(name, 0)\\n        if fc >= 65 && fc <= 90 {\\n          match peek(tokens, pos + 1) {\\n            TLParen => {\\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\\n              (PCtor(name, args), end)\\n            },\\n            TDoubleColon => match peek(tokens, pos + 2) {\\n              TLBrace => {\\n                let mut sp = pos + 3\\n                let field_pats = ArrayBuilder::new()\\n                let mut sd = true\\n                while sd {\\n                  match peek(tokens, sp) {\\n                    TRBrace => {\\n                      sd = false\\n                    },\\n                    TIdent(fname) => {\\n                      ArrayBuilder::push(field_pats, PBind(fname))\\n                      sp = sp + 1\\n                      match peek(tokens, sp) {\\n                        TComma => {\\n                          sp = sp + 1\\n                        },\\n                        _ => ()\\n                      }\\n                    },\\n                    _ => {\\n                      sd = false\\n                    }\\n                  }\\n                }\\n                (PTuple(ArrayBuilder::freeze(field_pats)), sp + 1)\\n              },\\n              _ => (PCtor(name, empty_pats()), pos + 1)\\n            },\\n            _ => (PCtor(name, empty_pats()), pos + 1)\\n          }\\n        } else (PBind(name), pos + 1)\\n      }\\n    },\\n    TLParen => match peek(tokens, pos + 1) {\\n      TRParen => (PTuple(empty_pats()), pos + 2),\\n      _ => {\\n        let (f, n1) = parse_pattern(tokens, pos + 1)\\n        match peek(tokens, n1) {\\n          TRParen => (f, n1 + 1),\\n          TComma => {\\n            let b = ArrayBuilder::new()\\n            ArrayBuilder::push(b, f)\\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\\n            (PTuple(rest), end)\\n          },\\n          _ => throw(\\\"expected ')' or ',' in pattern\\\")\\n        }\\n      }\\n    },\\n    _ => throw(\\\"unexpected in pattern: \\\\{tk_name(peek(tokens, pos))}\\\")\\n  }\\n  match peek(tokens, next) {\\n    TBitOr => {\\n      let (right, end) = parse_pattern(tokens, next + 1);\\n      (POr(pat, right), end)\\n    },\\n    _ => (pat, next)\\n  }\\n}\\n\\nlet parse_impl_stmt = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  let empty_strings = Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n  let empty_bounds = Array::slice([\\n    (\\\"_\\\", empty_strings)\\n  ], 0, 0)\\n  match peek(tokens, pos) {\\n    TLBracket => throw(\\\"impl type parameters are not supported yet\\\")\\n    ,\\n    TIdent(trait_name) => {\\n      let fp = expect_tk(tokens, pos + 1, \\\"for\\\")\\n      match peek(tokens, fp) {\\n        TIdent(type_name) => (SImpl(empty_strings, empty_bounds, trait_name, type_name), fp + 1),\\n        _ => throw(\\\"expected type name after 'for'\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected trait name after 'impl'\\\")\\n  }\\n}\\n\\nlet empty_type_exprs = () -> Array[TypeExpr] {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\nlet parse_trait_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  let empty_strings = Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TColon => {\\n        let rec parse_supers = (p: Int, acc: Array[String]) -> (Array[String], Int) {\\n          match peek(tokens, p) {\\n            TIdent(sname) => match peek(tokens, p + 1) {\\n              TPlus => parse_supers(p + 2, Array::concat(acc, [\\n                sname\\n              ])),\\n              _ => (Array::concat(acc, [\\n                sname\\n              ]), p + 1)\\n            },\\n            _ => (acc, p)\\n          }\\n        }\\n        let (supers, np) = parse_supers(pos + 2, empty_strings);\\n        (STrait(exported, name, supers), np)\\n      },\\n      _ => (STrait(exported, name, empty_strings), pos + 1)\\n    },\\n    _ => throw(\\\"expected trait name\\\")\\n  }\\n}\\n\\nlet is_expr_end_token = (tok: Token) -> Bool {\\n  match tok {\\n    TInt(_) => true,\\n    TFloat(_) => true,\\n    TString(_) => true,\\n    TStringInterp(_) => true,\\n    TIdent(_) => true,\\n    TRParen => true,\\n    TRBracket => true,\\n    TRBrace => true,\\n    _ => false\\n  }\\n}\\n\\nlet is_non_pipe_infix = (tok: Token) -> Bool {\\n  match tok {\\n    TOr => true,\\n    TAnd => true,\\n    TEqEq => true,\\n    TNeq => true,\\n    TLt => true,\\n    TLte => true,\\n    TGt => true,\\n    TGte => true,\\n    TBitOr => true,\\n    TBitXor => true,\\n    TBitAnd => true,\\n    TLShift => true,\\n    TRShift => true,\\n    TPlus => true,\\n    TMinus => true,\\n    TStar => true,\\n    TSlash => true,\\n    TPercent => true,\\n    _ => false\\n  }\\n}\\n\\nlet parse_import_item = (tokens: Array[Token], pos: Int) -> ((String, Option[String]), Int)with { Error } {\\n  let parse_import_name = (name_pos: Int) -> ((String, Option[String]), Int)with { Error } {\\n    match peek(tokens, name_pos) {\\n      TIdent(name) => match peek(tokens, name_pos + 1) {\\n        TAs => match peek(tokens, name_pos + 2) {\\n          TIdent(alias) => ((name, Some(alias)), name_pos + 3),\\n          _ => throw(\\\"expected alias name after 'as'\\\")\\n        },\\n        _ => ((name, None), name_pos + 1)\\n      },\\n      _ => throw(\\\"expected import item name\\\")\\n    }\\n  }\\n  match peek(tokens, pos) {\\n    TIdent(_) => parse_import_name(pos),\\n    TType => parse_import_name(pos + 1),\\n    TTrait => parse_import_name(pos + 1),\\n    _ => throw(\\\"expected import item name\\\")\\n  }\\n}\\n\\nlet empty_import_items = () -> Array[(String, Option[String])] {\\n  Array::slice([\\n    (\\\"_\\\", None)\\n  ], 0, 0)\\n}\\n\\nlet parse_binding_name = (tokens: Array[Token], pos: Int) -> (String, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) => (String::concat(name, String::concat(\\\"::\\\", member)), pos + 3),\\n        _ => throw(\\\"expected qualified member name after '::'\\\")\\n      },\\n      _ => (name, pos + 1)\\n    },\\n    _ => throw(\\\"expected name after 'let'\\\")\\n  }\\n}\\n\\nlet rec collect_import_path = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TLBrace => (acc, pos),\\n    TDot => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}.\\\"),\\n    TDotDot => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}..\\\"),\\n    TSlash => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}/\\\"),\\n    TIdent(name) => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}\\\\{name}\\\"),\\n    TMinus => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}-\\\"),\\n    TModule => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}module\\\"),\\n    TType => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}type\\\"),\\n    TMatch => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}match\\\"),\\n    TTest => collect_import_path(tokens, pos + 1, \\\"\\\\{acc}test\\\"),\\n    _ => throw(\\\"unexpected token in import path: \\\\{tk_name(peek(tokens, pos))}\\\")\\n  }\\n}\\n\\nlet rec collect_effect_names = (tokens: Array[Token], pos: Int, acc: String) -> (String, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (acc, pos + 1),\\n    TIdent(name) => {\\n      let new_acc = if String::length(acc) == 0 {\\n        name\\n      } else \\\"\\\\{acc}, \\\\{name}\\\"\\n      match peek(tokens, pos + 1) {\\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\\n        TRBrace => (new_acc, pos + 2),\\n        _ => throw(\\\"expected ',' or '}' in effect list\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected effect name or '}'\\\")\\n  }\\n}\\n\\nlet rec parse_type_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (TypeExpr, Int)with { Error } {\\n  let rec type_list_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\\n    match peek(tokens, pos) {\\n      TComma => {\\n        let ts = match peek(tokens, pos + 1) {\\n          TIdent(_) => match peek(tokens, pos + 2) {\\n            TColon => pos + 3,\\n            TTilde => match peek(tokens, pos + 3) {\\n              TColon => pos + 4,\\n              _ => pos + 1\\n            },\\n            TQuestion => match peek(tokens, pos + 3) {\\n              TColon => pos + 4,\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          },\\n          _ => pos + 1\\n        }\\n        let (ty, next) = parse_type_impl(tokens, ts, 0)\\n        ArrayBuilder::push(b, ty)\\n        type_list_rest(tokens, next, b)\\n      },\\n      _ => (ArrayBuilder::freeze(b), pos)\\n    }\\n  }\\n  if mode == 0 {\\n    let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\\n    match peek(tokens, atom_next) {\\n      TThinArrow => {\\n        let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\\n        let params = match atom_ty {\\n          TyUnit => empty_type_exprs(),\\n          TyTuple(elems) => elems,\\n          _ => [\\n            atom_ty\\n          ]\\n        }\\n        let rn2 = match peek(tokens, rn) {\\n          TWith => {\\n            let p1 = rn + 1\\n            match peek(tokens, p1) {\\n              TLBrace => {\\n                let mut p2 = p1 + 1\\n                let mut done = false\\n                while !done {\\n                  match peek(tokens, p2) {\\n                    TRBrace => {\\n                      done = true\\n                    },\\n                    _ => {\\n                      p2 = p2 + 1\\n                    }\\n                  }\\n                }\\n                p2 + 1\\n              },\\n              _ => rn\\n            }\\n          },\\n          _ => rn\\n        };\\n        let effect_pair = match peek(tokens, rn2) {\\n          TWith => {\\n            let with_pos = expect_tk(tokens, rn2 + 1, \\\"{\\\")\\n            let effect_name_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n            (Some(effect_name_pair.0), effect_name_pair.1)\\n          },\\n          _ => (None, rn2)\\n        }\\n        (TyFn(params, ret, effect_pair.0), effect_pair.1)\\n      },\\n      _ => (atom_ty, atom_next)\\n    }\\n  } else match peek(tokens, pos) {\\n    TLParen => match peek(tokens, pos + 1) {\\n      TRParen => (TyUnit, pos + 2),\\n      _ => {\\n        let ty_start = match peek(tokens, pos + 1) {\\n          TIdent(_) => match peek(tokens, pos + 2) {\\n            TColon => pos + 3,\\n            TTilde => match peek(tokens, pos + 3) {\\n              TColon => pos + 4,\\n              _ => pos + 1\\n            },\\n            TQuestion => match peek(tokens, pos + 3) {\\n              TColon => pos + 4,\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          },\\n          _ => pos + 1\\n        }\\n        let (first, n1) = parse_type_impl(tokens, ty_start, 0)\\n        match peek(tokens, n1) {\\n          TRParen => (first, n1 + 1),\\n          TComma => {\\n            let b = ArrayBuilder::new()\\n            ArrayBuilder::push(b, first)\\n            let (rest, end) = type_list_rest(tokens, n1, b)\\n            let en = expect_tk(tokens, end, \\\")\\\");\\n            (TyTuple(rest), en)\\n          },\\n          _ => throw(\\\"expected ')' or ',' in type\\\")\\n        }\\n      }\\n    },\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLBracket => {\\n        let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n        match peek(tokens, n1) {\\n          TRBracket => (TyApp(name, [\\n            first\\n          ]), n1 + 1),\\n          TComma => {\\n            let b = ArrayBuilder::new()\\n            ArrayBuilder::push(b, first)\\n            let (rest, end) = type_list_rest(tokens, n1, b)\\n            let en = expect_tk(tokens, end, \\\"]\\\");\\n            (TyApp(name, rest), en)\\n          },\\n          _ => throw(\\\"expected ']' or ',' in type application\\\")\\n        }\\n      },\\n      _ => (TyName(name), pos + 1)\\n    },\\n    _ => throw(\\\"expected type but got \\\\{tk_name(peek(tokens, pos))}\\\")\\n  }\\n}\\n\\nexport let parse_type = (tokens: Array[Token], pos: Int) -> (TypeExpr, Int)with { Error } {\\n  parse_type_impl(tokens, pos, 0)\\n}\\n\\nlet parse_one_param = (tokens: Array[Token], pos: Int) -> ((String, Option[TypeExpr]), Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TTilde => {\\n        let labeled_name = \\\"\\\\{name}~\\\"\\n        match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\\n            ((labeled_name, Some(ty)), tp)\\n          },\\n          _ => ((labeled_name, None), pos + 2)\\n        }\\n      },\\n      TQuestion => {\\n        let opt_name = \\\"\\\\{name}?\\\"\\n        match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\\n            ((opt_name, Some(ty)), tp)\\n          },\\n          _ => ((opt_name, None), pos + 2)\\n        }\\n      },\\n      TColon => {\\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\\n        let tp2 = match peek(tokens, tp) {\\n          TColon => {\\n            let mut bp = tp + 1\\n            let mut bd = true\\n            while bd {\\n              match peek(tokens, bp) {\\n                TIdent(_) => {\\n                  bp = bp + 1; match peek(tokens, bp) {\\n                    TPlus => {\\n                      bp = bp + 1\\n                    },\\n                    _ => {\\n                      bd = false\\n                    }\\n                  }\\n                },\\n                _ => {\\n                  bd = false\\n                }\\n              }\\n            }\\n            bp\\n          },\\n          _ => tp\\n        }\\n        ((name, Some(ty)), tp2)\\n      },\\n      _ => ((name, None), pos + 1)\\n    },\\n    _ => throw(\\\"expected parameter name\\\")\\n  }\\n}\\n\\nlet rec parse_param_cont = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (p, pn) = parse_one_param(tokens, pos + 1)\\n        ArrayBuilder::push(b, p)\\n        parse_param_cont(tokens, pn, b)\\n      }\\n    },\\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or ')' in param list\\\")\\n  }\\n}\\n\\nlet parse_param_list = (tokens: Array[Token], pos: Int) -> (Array[(String, Option[TypeExpr])], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRParen => (empty_params(), pos + 1),\\n    _ => {\\n      let (f, fn1) = parse_one_param(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, f)\\n      parse_param_cont(tokens, fn1, b)\\n    }\\n  }\\n}\\n\\nlet parse_struct_field = (tokens: Array[Token], pos: Int) -> ((String, TypeExpr), Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let cn = expect_tk(tokens, pos + 1, \\\":\\\")\\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\\n      ((name, ty), next)\\n    },\\n    _ => throw(\\\"expected field name\\\")\\n  }\\n}\\n\\nlet rec is_lambda_start_impl = (tokens: Array[Token], pos: Int, depth: Int, has_colon: Bool) -> Bool {\\n  match peek(tokens, pos) {\\n    TColon => if depth == 0 {\\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\\n    TRParen => if depth == 0 {\\n      match peek(tokens, pos + 1) {\\n        TThinArrow => true,\\n        TLBrace => true,\\n        _ => false\\n      }\\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\\n    TEof => false,\\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\\n  }\\n}\\n\\nlet is_lambda_start = (tokens: Array[Token], pos: Int) -> Bool {\\n  is_lambda_start_impl(tokens, pos, 0, false)\\n}\\n\\nlet rec parse_ctor_types_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\\n      ArrayBuilder::push(b, ty)\\n      parse_ctor_types_rest(tokens, next, b)\\n    },\\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or ')' in constructor types\\\")\\n  }\\n}\\n\\nlet parse_enum_ctor = (tokens: Array[Token], pos: Int) -> ((String, Array[TypeExpr]), Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLParen => match peek(tokens, pos + 2) {\\n        TRParen => ((name, empty_type_exprs()), pos + 3),\\n        _ => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, first)\\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\\n          ((name, types), end)\\n        }\\n      },\\n      _ => ((name, empty_type_exprs()), pos + 1)\\n    },\\n    _ => throw(\\\"expected constructor name\\\")\\n  }\\n}\\n\\nlet rec parse_enum_ctors_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\\n        ArrayBuilder::push(b, ctor)\\n        parse_enum_ctors_rest(tokens, next, b)\\n      }\\n    },\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\\n        ArrayBuilder::push(b, ctor)\\n        parse_enum_ctors_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ';', ',' or '}' in enum\\\")\\n  }\\n}\\n\\nlet parse_enum_ctors = (tokens: Array[Token], pos: Int) -> (Array[(String, Array[TypeExpr])], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_ctors(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_enum_ctor(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_enum_ctors_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nlet parse_enum_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let after_name = match peek(tokens, pos + 1) {\\n        TLBracket => {\\n          let mut skip = pos + 2\\n          let mut depth = 1\\n          while depth > 0 {\\n            match peek(tokens, skip) {\\n              TLBracket => {\\n                depth = depth + 1; skip = skip + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1; skip = skip + 1\\n              },\\n              _ => {\\n                skip = skip + 1\\n              }\\n            }\\n          }\\n          skip\\n        },\\n        _ => pos + 1\\n      }\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (ctors, end) = parse_enum_ctors(tokens, br);\\n      (SEnum(exported, name, ctors), end)\\n    },\\n    _ => throw(\\\"expected enum name\\\")\\n  }\\n}\\n\\nlet parse_suberror_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLParen => match peek(tokens, pos + 2) {\\n        TRParen => {\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\\n        },\\n        _ => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          let args_b = ArrayBuilder::new()\\n          ArrayBuilder::push(args_b, first)\\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\\n          let ctors_b = ArrayBuilder::new()\\n          ArrayBuilder::push(ctors_b, (name, args))\\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\\n        }\\n      },\\n      TLBrace => {\\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\\n        (SSuberror(exported, name, ctors), end)\\n      },\\n      _ => throw(\\\"expected '(' or '{' after suberror name\\\")\\n    },\\n    _ => throw(\\\"expected suberror name\\\")\\n  }\\n}\\n\\nlet parse_type_alias_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let ep = expect_tk(tokens, pos + 1, \\\"=\\\")\\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\\n      (STypeAlias(exported, name, ty), next)\\n    },\\n    _ => throw(\\\"expected type alias name\\\")\\n  }\\n}\\n\\nlet parse_type_params_list = (tokens: Array[Token], pos: Int) -> (Array[String], Int)with { Error } {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\n// Parse effect declaration: effect Name[T] { Op(Args) -> Ret; ... }\\nlet parse_effect_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\\n        TLBracket => parse_type_params_list(tokens, pos + 2),\\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\\n      }\\n      let br = expect_tk(tokens, after_params, \\\"{\\\")\\n      let ops_b = ArrayBuilder::new()\\n      let mut p = br\\n      while true {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            break\\n          },\\n          TIdent(op_name) => {\\n            let (params, after_op_params) = match peek(tokens, p + 1) {\\n              TLParen => {\\n                let params_b = ArrayBuilder::new()\\n                let mut pp = p + 2\\n                match peek(tokens, pp) {\\n                  TRParen => (ArrayBuilder::freeze(params_b), pp + 1),\\n                  _ => {\\n                    let (first_type, n1) = parse_type_impl(tokens, pp, 0)\\n                    ArrayBuilder::push(params_b, first_type)\\n                    pp = n1\\n                    while true {\\n                      match peek(tokens, pp) {\\n                        TComma => {\\n                          let (next_type, n2) = parse_type_impl(tokens, pp + 1, 0)\\n                          ArrayBuilder::push(params_b, next_type)\\n                          pp = n2\\n                        },\\n                        TRParen => {\\n                          pp = pp + 1\\n                          break\\n                        },\\n                        _ => throw(\\\"expected ',' or ')' in effect op params\\\")\\n                      }\\n                    }\\n                    (ArrayBuilder::freeze(params_b), pp)\\n                  }\\n                }\\n              },\\n              _ => (ArrayBuilder::freeze(ArrayBuilder::new()), p + 1)\\n            }\\n            let arrow_pos = expect_tk(tokens, after_op_params, \\\"->\\\")\\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\\n            p = match peek(tokens, after_ret) {\\n              TSemicolon => after_ret + 1,\\n              _ => after_ret\\n            }\\n          },\\n          _ => throw(\\\"expected effect operation name or '}'\\\")\\n        }\\n      }\\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\\n    },\\n    _ => throw(\\\"expected effect name\\\")\\n  }\\n}\\n\\nlet parse_impl_stmt_dispatch = (tokens: Array[Token], pos: Int) -> (Stmt, Int)with { Error } {\\n  parse_impl_stmt(tokens, pos)\\n}\\n\\nlet rec parse_struct_fields_rest = (tokens: Array[Token], pos: Int, b: ArrayBuilder[(String, TypeExpr)]) -> (Array[(String, TypeExpr)], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (field, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        parse_struct_fields_rest(tokens, next, b)\\n      }\\n    },\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (field, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        parse_struct_fields_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ';', ',' or '}' in struct\\\")\\n  }\\n}\\n\\nlet parse_struct_fields = (tokens: Array[Token], pos: Int) -> (Array[(String, TypeExpr)], Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_fields(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_struct_field(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_struct_fields_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nlet parse_struct_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (fields, end) = parse_struct_fields(tokens, br);\\n      (SStruct(exported, name, fields), end)\\n    },\\n    _ => throw(\\\"expected struct name\\\")\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, skip_semi, tk_name\\n}\\n\\nexport {\\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\")\n\n  let source_11 = (\"vibe/compiler/syntax/parser_expr.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  Expr, Pat, Stmt, TypeExpr\\n}\\n\\nimport ./parser_base.vibe {\\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_pattern, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, peek, tk_name\\n}\\n\\nimport ./parser_expr_core.vibe {\\n  parse_infix\\n}\\n\\nimport ./parser_expr_dispatch.vibe {\\n  parse_impl_dispatch\\n}\\n\\nimport ./token.vibe {\\n  Token\\n}\\n\\n//# Functions\\n\\nexport let parse_impl = (tokens: Array[Token], pos: Int, mode: Int) -> (Expr, Int)with { Error } {\\n  let rec parse_recur = (rtoks: Array[Token], rpos: Int, rmode: Int) -> (Expr, Int)with { Error } {\\n    if rmode >= 0 && rmode <= 10 {\\n      parse_infix(rtoks, rpos, rmode, rpos, parse_recur)\\n    } else {\\n      parse_impl_dispatch(rtoks, rpos, rmode, parse_recur)\\n    }\\n  }\\n  parse_recur(tokens, pos, mode)\\n}\\n\\nexport let parse = (tokens: Array[Token]) -> Expr with { Error } {\\n  let (e, next) = parse_impl(tokens, 0, 0)\\n  match peek(tokens, next) {\\n    TEof => e,\\n    _ => throw(\\\"unexpected after expression: \\\\{tk_name(peek(tokens, next))}\\\")\\n  }\\n}\\n\\nexport let parse_ok = (tokens: Array[Token]) -> Bool {\\n  handle {\\n    let _ = parse(tokens)\\n    true\\n  } {\\n    Error(_) => false\\n  }\\n}\\n\\nexport let parse_expr = (tokens: Array[Token], pos: Int) -> (Expr, Int)with { Error } {\\n  parse_impl(tokens, pos, 0)\\n}\\n\\nlet skip_generic_value_start = (tokens: Array[Token], pos: Int) -> Int {\\n  match peek(tokens, pos) {\\n    TLBracket => match peek(tokens, pos + 1) {\\n      TIdent(_) => {\\n        let maybe_generic = match peek(tokens, pos + 2) {\\n          TRBracket => match peek(tokens, pos + 3) {\\n            TLParen => true,\\n            _ => false\\n          },\\n          TColon => true,\\n          TComma => true,\\n          _ => false\\n        }\\n        if maybe_generic {\\n          let mut scan_pos = pos + 1\\n          let mut depth = 1\\n          while depth > 0 {\\n            match peek(tokens, scan_pos) {\\n              TLBracket => {\\n                depth = depth + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1\\n              },\\n              _ => ()\\n            }\\n            scan_pos = scan_pos + 1\\n          }\\n          scan_pos\\n        } else {\\n          pos\\n        }\\n      },\\n      _ => pos\\n    },\\n    _ => pos\\n  }\\n}\\n\\nlet parse_let_stmt = (tokens: Array[Token], pos: Int, exported: Bool) -> (Stmt, Int)with { Error } {\\n  match peek(tokens, pos) {\\n    TRec => {\\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\\n        TColon => {\\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0)\\n          (Some(ty), tp)\\n        },\\n        _ => (None, name_next)\\n      }\\n      let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n      let val_start_r = skip_generic_value_start(tokens, ep)\\n      let val_pair = parse_impl(tokens, val_start_r, 0)\\n      let val = val_pair.0\\n      let val_next = val_pair.1\\n      (SLet(exported, true, name, ty_opt, val), val_next)\\n    },\\n    TMut => match peek(tokens, pos + 1) {\\n      TIdent(name) => {\\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\\n            (Some(ty), tp)\\n          },\\n          _ => (None, pos + 2)\\n        }\\n        let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n        let val_pair = parse_impl(tokens, ep, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        (SLetMut(name, ty_opt, val), val_next)\\n      },\\n      _ => throw(\\\"expected name after 'let mut'\\\")\\n    },\\n    TLParen => {\\n      let (pat, pat_next) = parse_pattern(tokens, pos)\\n      let ep = expect_tk(tokens, pat_next, \\\"=\\\")\\n      let val_pair = parse_impl(tokens, ep, 0)\\n      let val = val_pair.0\\n      let val_next = val_pair.1\\n      (SLetPat(pat, val), val_next)\\n    },\\n    TIdent(_name0) => {\\n      let (name, name_next) = parse_binding_name(tokens, pos)\\n      let (ty_opt, eq_pos) = match peek(tokens, name_next) {\\n        TColon => {\\n          let (ty, tp) = parse_type_impl(tokens, name_next + 1, 0)\\n          (Some(ty), tp)\\n        },\\n        _ => (None, name_next)\\n      }\\n      let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n      let val_start = skip_generic_value_start(tokens, ep)\\n      let val_pair = parse_impl(tokens, val_start, 0)\\n      let val = val_pair.0\\n      let val_next = val_pair.1\\n      (SLet(exported, false, name, ty_opt, val), val_next)\\n    },\\n    _ => throw(\\\"expected name after 'let'\\\")\\n  }\\n}\\n\\n//# Misc\\n\\nexport {\\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\\n}\\n\\nexport {\\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\")\n\n  let source_12 = (\"vibe/compiler/checker/builtins.vibe\",\n\"//# Imports\\n\\nimport .. / builtin_name.vibe {\\n  canonical_builtin_name\\n}\\n\\nimport .. / core / types.vibe {\\n  Type\\n}\\n\\nimport ./builtins_array.vibe {\\n  lookup_array\\n}\\n\\nimport ./builtins_builders.vibe {\\n  lookup_array_builder, lookup_string_builder\\n}\\n\\nimport ./builtins_bytes.vibe {\\n  lookup_bytes\\n}\\n\\nimport ./builtins_fixed_array.vibe {\\n  lookup_fixed_array\\n}\\n\\nimport ./builtins_fs.vibe {\\n  lookup_fs\\n}\\n\\nimport ./builtins_map.vibe {\\n  lookup_map\\n}\\n\\nimport ./builtins_misc.vibe {\\n  lookup_misc\\n}\\n\\nimport ./builtins_net.vibe {\\n  lookup_net\\n}\\n\\nimport ./builtins_string1.vibe {\\n  lookup_string1\\n}\\n\\nimport ./builtins_string2.vibe {\\n  lookup_string2\\n}\\n\\nimport ./builtins_system.vibe {\\n  lookup_io\\n}\\n\\n//# Functions\\n\\nexport let lookup_builtin = (name: String) -> Option[Type] {\\n  let normalized = canonical_builtin_name(name)\\n  match lookup_array(normalized) {\\n    Some(t) => Some(t),\\n    None => match lookup_fixed_array(normalized) {\\n      Some(t) => Some(t),\\n      None => match lookup_array_builder(normalized) {\\n        Some(t) => Some(t),\\n        None => match lookup_string1(normalized) {\\n          Some(t) => Some(t),\\n          None => match lookup_string2(normalized) {\\n            Some(t) => Some(t),\\n            None => match lookup_string_builder(normalized) {\\n              Some(t) => Some(t),\\n              None => match lookup_bytes(normalized) {\\n                Some(t) => Some(t),\\n                None => match lookup_map(normalized) {\\n                  Some(t) => Some(t),\\n                  None => match lookup_io(normalized) {\\n                    Some(t) => Some(t),\\n                    None => match lookup_fs(normalized) {\\n                      Some(t) => Some(t),\\n                      None => match lookup_net(normalized) {\\n                        Some(t) => Some(t),\\n                        None => lookup_misc(normalized)\\n                      }\\n                    }\\n                  }\\n                }\\n              }\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\")\n\n  let source_13 = (\"vibe/compiler/checker/builtins_fs.vibe\",\n\"//# Imports\\n\\nimport .. / core / types.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nlet no_params = () -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet one_param = (a: Type) -> Array[Type] {\\n  let arr = no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet two_params = (a: Type, b: Type) -> Array[Type] {\\n  let arr = no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet lookup_fs_copy = (name: String) -> Option[Type] {\\n  if name == \\\"Fs::copy\\\" {\\n    Some(CtFn(two_params(CtString, CtString), CtUnit, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_chdir = (name: String) -> Option[Type] {\\n  if name == \\\"Fs::chdir\\\" {\\n    Some(CtFn(one_param(CtString), CtUnit, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}\\n\\nlet lookup_fs_mkdir = (name: String) -> Option[Type] {\\n  if name == \\\"Fs::mkdir\\\" {\\n    Some(CtFn(one_param(CtString), CtUnit, Some(\\\"Fs\\\")))\\n  }\\n  else None\\n}