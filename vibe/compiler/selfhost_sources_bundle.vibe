    Array::push(local_names, pname)\\n    } else {\\n      emit_drop(buf)\\n    }\\n    if uses_frontier {\\n      emit_global_get(buf, g_rbuf)\\n      emit_i32_const(buf, eff_off)\\n      emit_i32_add(buf)\\n      emit_i64_extend_i32_u(buf)\\n      emit_global_set(buf, g_cur)\\n    } else {\\n      ()\\n    }\\n    emit_block_i64(buf)\\n    bytebuf_push(buf, 31)\\n    bytebuf_push(buf, 126)\\n    bytebuf_push(buf, 1)\\n    bytebuf_push(buf, 0)\\n    bytebuf_push(buf, 1)\\n    bytebuf_push(buf, 0)\\n    let nl2 = if needs_op_dispatch {\\n      let mut max_nl = Array::length(local_names)\\n      let mut di = 0\\n      while di < Array::length(arms) {\\n        let (apat, abody) = Array::get(arms, di)\\n        let aop = if is_pctor(apat) {\\n          effect_op_index(ctx.effect_op_keys, get_pctor_name(apat))\\n        } else {\\n          0 - 1\\n        }\\n        emit_global_get(buf, g_op_idx_global)\\n        emit_i64_const(buf, aop)\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n        t6_bind_from_raw(buf, apat, raw_l, ctx, local_names)\\n        let anl = compile_expr(buf, abody, local_names, Array::length(local_names), ctx, ld)\\n        if anl > max_nl {\\n          max_nl = anl\\n        } else {\\n          ()\\n        }\\n        emit_else(buf)\\n        di = di + 1\\n      }\\n      bytebuf_push(buf, 0)\\n      let mut ce = 0\\n      while ce < Array::length(arms) {\\n        emit_end(buf)\\n        ce = ce + 1\\n      }\\n      max_nl\\n    } else {\\n      compile_expr(buf, fallback_expr, local_names, Array::length(local_names), ctx, ld)\\n    }\\n    emit_end(buf)\\n    emit_br(buf, 2)\\n    emit_end(buf)\\n    emit_drop(buf)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    bytebuf_push(buf, 0)\\n    emit_end(buf)\\n    nl2\\n  } else {\\n    compile_expr(buf, body, local_names, next_local, ctx, ld)\\n  }\\n}\\nexport let compile_expr_tail7: (Bytes, Array[String], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, parts, local_names, next_local, ctx, ld, compile_expr) -> {\\n  let make_concat_expr: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\\n    Array::push(args, lhs)\\n    Array::push(args, rhs)\\n    ECall(EIdent(\\\"String::concat\\\", -1), args, -1)\\n  }\\n  let make_to_string_expr: (String) -> Expr = (name) -> {\\n    let args = ArrayBuilder::freeze(ArrayBuilder::new())\\n    Array::push(args, EIdent(name, -1))\\n    ECall(EIdent(\\\"__to_string\\\", -1), args, -1)\\n  }\\n  let plen = Array::length(parts)\\n  let mut result = EString(\\\"\\\")\\n  let mut has_val = false\\n  let mut si2 = 0\\n  while si2 < plen {\\n    let part = Array::get(parts, si2)\\n    if si2 % 2 == 0 {\\n      if String::length(part) > 0 {\\n        if has_val {\\n          result = make_concat_expr(result, EString(part))\\n        } else {\\n          result = EString(part)\\n          has_val = true\\n        }\\n      }\\n    } else {\\n      let ep = make_to_string_expr(part)\\n      if has_val {\\n        result = make_concat_expr(result, ep)\\n      } else {\\n        result = ep\\n        has_val = true\\n      }\\n    }\\n    si2 = si2 + 1\\n  }\\n  compile_expr(buf, result, local_names, next_local, ctx, ld)\\n}\\nexport let compile_expr_tail5: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\\n  match expr {\\n    EForIn(_, _, _, _) => throw(\\\"unsupported expression in codegen: EForIn\\\"),\\n    EHandle(body, arms) => compile_expr_tail6(buf, body, arms, local_names, next_local, ctx, ld, compile_expr)\\n    ,\\n    EStringInterp(parts) => compile_expr_tail7(buf, parts, local_names, next_local, ctx, ld, compile_expr)\\n    ,\\n    ELabeledArg(_, _, val) => compile_expr(buf, val, local_names, next_local, ctx, ld)\\n    ,\\n    _ => throw(\\\"unsupported expression in codegen: unknown\\\")\\n  }\\n}\\nlet expr_is_projection: (Expr) -> Bool = (e) -> {\\n  match e {\\n    EDot(_, _, _) => true,\\n    _ => false\\n  }\\n}\\nexport let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\\n  match expr {\\n    EDot(obj, field, _) => {\\n      let fc = String::char_code_at(field, 0)\\n      let mut field_idx = if fc >= 48 && fc <= 57 {\\n        let mut vi = 0\\n        let mut vp = 0\\n        while vp < String::length(field) {\\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\\n          vp = vp + 1\\n        }\\n        vi\\n      } else {\\n        let mut si_search = 0\\n        let mut found = -1\\n        while si_search < Array::length(ctx.ctor_table.struct_names) {\\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)\\n          let mut fi = 0\\n          while fi < Array::length(fnames) {\\n            if Array::get(fnames, fi) == field {\\n              found = fi\\n              fi = Array::length(fnames)\\n            } else {\\n              fi = fi + 1\\n            }\\n          }\\n          if found >= 0 {\\n            si_search = Array::length(ctx.ctor_table.struct_names)\\n          } else {\\n            si_search = si_search + 1\\n          }\\n        }\\n        if found < 0 {\\n          throw(String::concat(\\\"unknown struct field: \\\", field))\\n        }\\n        found\\n      }\\n      let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\\n      if fc >= 48 && fc <= 57 {\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n        }\\n        emit_i32_wrap_i64(buf)\\n        let toff = if ctx.enable_rc {\\n          8 + field_idx * 8\\n        } else {\\n         