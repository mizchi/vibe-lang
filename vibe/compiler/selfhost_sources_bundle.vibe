  let source_53 = ("vibe/compiler/codegen/expr/compile_match.vibe",
"\n\n\n\n\n\n\nexport let compile_match = (buf: Bytes, expr: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    let __cond_p = get_arm_pat(Array::get(__match_arms, ai))\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          1\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, str_eq_fi)\n              emit_i32_wrap_i64(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else {\n            let rec emit_or_check = (pat: Pat) -> Unit {\n              match pat {\n                POr(left, right) => {\n                  emit_or_check(left)\n                  emit_or_check(right)\n                  bytebuf_push(buf, 114)\n                },\n                PInt(n) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, n)\n                  emit_i64_eq(buf)\n                },\n                PCtor(cname, cargs) => {\n                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)\n                  let ctag = if ci >= 0 {\n                    Array::get(ctx.ctor_table.tags, ci)\n                  } else {\n                    -1\n                  }\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i32_load(buf, 2, 0)\n                  emit_i32_const(buf, ctag)\n                  emit_i32_eq(buf)\n                  if Array::length(cargs) == 1 {\n                    match Array::get(cargs, 0) {\n                      PInt(n) => {\n                        emit_local_get(buf, scrut_local)\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                        emit_i32_wrap_i64(buf)\n                        emit_i64_load(buf, 3, 8)\n                        emit_i64_const(buf, n)\n                        emit_i64_eq(buf)\n                        bytebuf_push(buf, 113)\n                      },\n                      _ => ()\n                    }\n                  }\n                },\n                _ => emit_i32_const(buf, 1)\n              }\n            }\n            emit_or_check(__cond_p)\n            emit_if_i64(buf)\n            0\n          }\n        }\n      }\n    }\n    let __arm_body = get_arm_body(Array::get(__match_arms, ai))\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < Array::length(cargs_bind) {\n        let __sub_p = Array::get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          Array::push(local_names, pname)\n        } else if is_ptuple(__sub_p) {\n          let tpats = get_ptuple_pats(__sub_p)\n          let tup_local = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, tup_local)\n          Array::push(local_names, \"__ctor_tup\")\n          let mut ti = 0\n          while ti < Array::length(tpats) {\n            let tp = Array::get(tpats, ti)\n            if is_pbind(tp) {\n              let tpname = get_pbind_name(tp)\n              let tfl = Array::length(local_names)\n              emit_local_get(buf, tup_local)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, ti * 8)\n              emit_local_set(buf, tfl)\n              Array::push(local_names, tpname)\n            }\n            ti = ti + 1\n          }\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let __catch_p = get_arm_pat(__catch_arm)\n    let __catch_body = get_arm_body(__catch_arm)\n    0\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n    } else {\n      if is_pctor(__catch_p) {\n        let cargs = get_pctor_args(__catch_p)\n        let mut cbi2 = 0\n        while cbi2 < Array::length(cargs) {\n          let __sub_p2 = Array::get(cargs, cbi2)\n          if is_pbind(__sub_p2) {\n            let pname = get_pbind_name(__sub_p2)\n            let fl2 = Array::length(local_names)\n            emit_local_get(buf, scrut_local)\n            emit_i64_const(buf, -2)\n            emit_i64_and(buf)\n            emit_i32_wrap_i64(buf)\n            emit_i64_load(buf, 3, 8 + cbi2 * 8)\n            emit_local_set(buf, fl2)\n            Array::push(local_names, pname)\n          }\n          cbi2 = cbi2 + 1\n        }\n        ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n      } else {\n        if is_ptuple(__catch_p) {\n          let pats = get_ptuple_pats(__catch_p)\n          let ptr_local2 = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_local_set(buf, ptr_local2)\n          Array::push(local_names, \"__tup_ptr2\")\n          let mut pi2 = 0\n          while pi2 < Array::length(pats) {\n            let __tp = Array::get(pats, pi2)\n            if is_pbind(__tp) {\n              let pname = get_pbind_name(__tp)\n              let field_l = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, field_l)\n              Array::push(local_names, pname)\n              0\n            } else if is_ptuple(__tp) {\n              let sub_pats = get_ptuple_pats(__tp)\n              let sub_ptr = Array::length(local_names)\n              emit_local_get(buf, ptr_local2)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, pi2 * 8)\n              emit_local_set(buf, sub_ptr)\n              Array::push(local_names, \"__sub_tup\")\n              let mut si3 = 0\n              while si3 < Array::length(sub_pats) {\n                let sp = Array::get(sub_pats, si3)\n                if is_pbind(sp) {\n                  let spname = get_pbind_name(sp)\n                  let sfl = Array::length(local_names)\n                  emit_local_get(buf, sub_ptr)\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, si3 * 8)\n                  emit_local_set(buf, sfl)\n                  Array::push(local_names, spname)\n                }\n                si3 = si3 + 1\n              }\n              0\n            } else {\n              if is_pwild(__tp) {\n                0\n              } else {\n                throw(\"unsupported pattern in tuple destructure\")\n              }\n            }\n            pi2 = pi2 + 1\n          }\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        } else {\n          ce(buf, __catch_body, local_names, Array::length(local_names), ctx, ld_catch)\n        }\n      }\n    }\n  } else {\n    bytebuf_push(buf, 0)\n    0\n  }\n  if catch_nl > max_nl {\n    max_nl = catch_nl\n  }\n  let mut ci2 = 0\n  while ci2 < num_cond_arms {\n    emit_end(buf)\n    ci2 = ci2 + 1\n  }\n  while Array::length(local_names) < max_nl {\n    Array::push(local_names, \"\")\n  }\n  max_nl\n}\n")

  let source_54 = ("vibe/compiler/codegen/expr/compile_lambda.vibe",
"\n\n\n\n\n\n\nexport let compile_lambda = (buf: Bytes, params: Array[(String, Option[TypeExpr])], fn_body: Expr, local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, compile_fn: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  let param_names_arr = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut pi = 0\n  while pi < Array::length(params) {\n    let (pname, _) = Array::get(params, pi)\n    Array::push(param_names_arr, pname)\n    pi = pi + 1\n  }\n  let fn_and_ctor = Array::concat(ctx.func_table.names, ctx.ctor_table.names)\n  let captures = collect_free_vars(fn_body, param_names_arr, fn_and_ctor)\n  let num_captures = Array::length(captures)\n  let user_params = Array::length(params)\n  let lam_buf = bytebuf_new()\n  let lam_locals = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut lpi = 0\n  while lpi < user_params {\n    let (lpname_raw, _) = Array::get(params, lpi)\n    let lpnlen = String::length(lpname_raw)\n    let lpname = if lpnlen > 0 {\n      let lpc = String::char_code_at(lpname_raw, lpnlen - 1)\n      if lpc == '~' {\n        lpname_raw[0: lpnlen - 1]\n      } else if lpc == '?' {\n        lpname_raw[0: lpnlen - 1]\n      } else {\n        lpname_raw\n      }\n    } else lpname_raw\n    Array::push(lam_locals, lpname)\n    lpi = lpi + 1\n  }\n  Array::push(lam_locals, \"__env\")\n  let env_param_idx = user_params\n  let lam_nl_start = user_params + 1\n  let lam_ref_cells = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut ci3 = 0\n  let mut lam_nl = lam_nl_start\n  while ci3 < num_captures {\n    let cap_local = lam_nl\n    let cap_name = Array::get(captures, ci3)\n    emit_local_get(lam_buf, env_param_idx)\n    emit_i32_wrap_i64(lam_buf)\n    emit_i64_load(lam_buf, 3, 8 + ci3 * 8)\n    emit_local_set(lam_buf, cap_local)\n    Array::push(lam_locals, cap_name)\n    if array_contains_str(ctx.ref_cell_names, cap_name) {\n      Array::push(lam_ref_cells, cap_name)\n    }\n    lam_nl = lam_nl + 1\n    ci3 = ci3 + 1\n  }\n  let lam_ctx = CompileCtx::{\n    func_table: ctx.func_table, str_table: ctx.str_table,\n    lambda_table: ctx.lambda_table,\n    num_user_funcs: ctx.num_user_funcs, func_offset: ctx.func_offset,\n    ref_cell_names: lam_ref_cells, ctor_table: ctx.ctor_table,\n    thunk_names: ctx.thunk_names,\n    const_int_names: ctx.const_int_names,\n    const_int_values: ctx.const_int_values\n  }\n  let final_lam_nl = compile_fn(lam_buf, fn_body, lam_locals, lam_nl, lam_ctx, -1)\n  let lambda_idx = Array::length(ctx.lambda_table.bodies)\n  Array::push(ctx.lambda_table.bodies, lam_buf)\n  Array::push(ctx.lambda_table.param_counts, user_params + 1)\n  Array::push(ctx.lambda_table.captures, captures)\n  let mut extra_lam = 0\n  let min_lam_nl = user_params + 1\n  if final_lam_nl > min_lam_nl {\n    extra_lam = final_lam_nl - min_lam_nl\n  }\n  Array::push(ctx.lambda_table.meta_i32, 0)\n  Array::push(ctx.lambda_table.meta_i64, extra_lam)\n  let table_slot = ctx.num_user_funcs + lambda_idx\n  if num_captures == 0 {\n    emit_i64_const(buf, (table_slot<<2)|2)\n    next_local\n  } else {\n    let alloc_size = 8 + num_captures * 8\n    let ptr_local = next_local\n    let nl2 = next_local + 1\n    Array::push(local_names, \"__closure_ptr\")\n    emit_global_get(buf, 0)\n    emit_i64_extend_i32_u(buf)\n    emit_local_tee(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, alloc_size)\n    emit_i32_add(buf)\n    emit_global_set(buf, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, table_slot)\n    emit_i32_store(buf, 2, 0)\n    emit_local_get(buf, ptr_local)\n    emit_i32_wrap_i64(buf)\n    emit_i32_const(buf, num_captures)\n    emit_i32_store(buf, 2, 4)\n    let mut csi = 0\n    while csi < num_captures {\n      let cap_name = Array::get(captures, csi)\n      let mut __cap_resolve = -1\n      let mut __cri = Array::length(local_names) - 1\n      while __cri >= 0 {\n        if Array::get(local_names, __cri) == cap_name {\n          __cap_resolve = __cri\n          __cri = -1\n        } else {\n          __cri = __cri - 1\n        }\n      }\n      if __cap_resolve >= 0 {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, __cap_resolve)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      } else {\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_i64_const(buf, 0)\n        emit_i64_store(buf, 3, 8 + csi * 8)\n      }\n      csi = csi + 1\n    }\n    emit_local_get(buf, ptr_local)\n    emit_i64_const(buf, 1)\n    emit_i64_or(buf)\n    nl2\n  }\n}\n")

  let source_55 = ("vibe/compiler/codegen/expr/compile_call.vibe",
"\n\n\n\n\n\n\n\n\nexport let compile_call = (buf: Bytes, callee: Expr, args: Array[Expr], local_names: Array[String], next_local: Int, ctx: CompileCtx, ld: Int, ce: (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } {\n  if is_eident(callee) {\n    let fname = get_eident_name(callee)\n    let fn_len2 = Array::length(ctx.func_table.names)\n    let mut fn_idx_in_list = -1\n    let mut __tr_j = 0\n    while __tr_j < fn_len2 {\n      if Array::get(ctx.func_table.names, __tr_j) == fname {\n        fn_idx_in_list = __tr_j\n        __tr_j = fn_len2\n      } else {\n        __tr_j = __tr_j + 1\n      }\n    }\n    let mut local_idx_hint = -1\n    let mut li = Array::length(local_names) - 1\n    while li >= 0 {\n      if Array::get(local_names, li) == fname {\n        local_idx_hint = li\n        li = -1\n      } else {\n        li = li - 1\n      }\n    }\n    let prefer_bound_call = fn_idx_in_list >= 0 || local_idx_hint >= 0\n    let ctor_lookup_idx = lookup_ctor(ctx.ctor_table.names, fname, 0)\n    if ctor_lookup_idx >= 0 {\n      let tag = Array::get(ctx.ctor_table.tags, ctor_lookup_idx)\n      let fc = Array::get(ctx.ctor_table.field_counts, ctor_lookup_idx)\n      let obj_size = 8 + fc * 8\n      let ptr_local = next_local\n      Array::push(local_names, \"__ctor_ptr\")\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, ptr_local)\n      emit_global_get(buf, 0)\n      emit_i32_const(buf, obj_size)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, tag)\n      emit_i32_store(buf, 2, 0)\n      emit_local_get(buf, ptr_local)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, fc)\n      emit_i32_store(buf, 2, 4)\n      let actual_args = if Array::length(args) == 1 {\n        match Array::get(args, 0) {\n          ERecord(rec_fields) => {\n            let mut si2 = 0\n            let mut sn_idx = -1\n            while si2 < Array::length(ctx.ctor_table.struct_names) {\n              if Array::get(ctx.ctor_table.struct_names, si2) == fname {\n                sn_idx = si2\n                si2 = Array::length(ctx.ctor_table.struct_names)\n              } else {\n                si2 = si2 + 1\n              }\n            }\n            if sn_idx >= 0 {\n              let def_fnames = Array::get(ctx.ctor_table.struct_field_names, sn_idx)\n              let ordered = Array::slice([\n                EUnit\n              ], 0, 0)\n              let mut oi = 0\n              while oi < Array::length(def_fnames) {\n                let target_name = Array::get(def_fnames, oi)\n                let mut ri = 0\n                let mut found_rfv = EUnit\n                while ri < Array::length(rec_fields) {\n                  let (rfn, rfv) = Array::get(rec_fields, ri)\n                  if rfn == target_name {\n                    found_rfv = rfv\n                    ri = Array::length(rec_fields)\n                  } else {\n                    ri = ri + 1\n                  }\n                }\n                Array::push(ordered, found_rfv)\n                oi = oi + 1\n              }\n              ordered\n            } else {\n              args\n            }\n          },\n          _ => args\n        }\n      } else {\n        args\n      }\n      let mut nl_c = next_local + 1\n      let mut fi_c = 0\n      while fi_c < Array::length(actual_args) {\n        nl_c = ce(buf, Array::get(actual_args, fi_c), local_names, nl_c, ctx, ld)\n        let val_local = nl_c\n        Array::push(local_names, \"__ctor_val\")\n        emit_local_set(buf, val_local)\n        nl_c = nl_c + 1\n        emit_local_get(buf, ptr_local)\n        emit_i32_wrap_i64(buf)\n        emit_local_get(buf, val_local)\n        emit_i64_store(buf, 3, 8 + fi_c * 8)\n        fi_c = fi_c + 1\n      }\n      emit_local_get(buf, ptr_local)\n      emit_i64_const(buf, 1)\n      emit_i64_or(buf)\n      nl_c\n    }\n    else if !prefer_bound_call && fname == \"eq\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"not\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i64_eqz(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"add\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_add(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"sub\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_sub(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"mul\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_mul(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"lt\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"perform\" {\n      let mut nl = next_local\n      emit_global_get(buf, 1)\n      emit_i64_const(buf, 0)\n      emit_i64_ne(buf)\n      emit_if_i64(buf)\n      emit_global_get(buf, 1)\n      emit_i64_const(buf, 0)\n      emit_global_set(buf, 1)\n      emit_else(buf)\n      nl = ce(buf, Array::get(args, 0), local_names, nl, ctx, ld)\n      bytebuf_push(buf, 8)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"path\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"__float_bits\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"__to_string\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      let val_l = nl\n      let neg_l = nl + 1\n      let cur_l = nl + 2\n      let abs_l = nl + 3\n      let hp_l = nl + 4\n      let len_l = nl + 5\n      Array::push(local_names, \"__ts_val\")\n      Array::push(local_names, \"__ts_neg\")\n      Array::push(local_names, \"__ts_cur\")\n      Array::push(local_names, \"__ts_abs\")\n      Array::push(local_names, \"__ts_hp\")\n      Array::push(local_names, \"__ts_len\")\n      emit_local_set(buf, val_l)\n      emit_block_i64(buf)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 32)\n      bytebuf_push(buf, 136)\n      emit_local_tee(buf, abs_l)\n      emit_i64_const(buf, 0)\n      emit_i64_gt_s(buf)\n      emit_local_get(buf, abs_l)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_i64_lt_s(buf)\n      bytebuf_push(buf, 113)\n      emit_if_void(buf)\n      emit_local_get(buf, val_l)\n      emit_br(buf, 1)\n      emit_end(buf)\n      emit_i64_const(buf, 46)\n      emit_local_set(buf, cur_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 0)\n      emit_i64_lt_s(buf)\n      emit_i64_extend_i32_s(buf)\n      emit_local_set(buf, neg_l)\n      emit_local_get(buf, val_l)\n      emit_i64_const(buf, 0)\n      emit_i64_lt_s(buf)\n      emit_if_i64(buf)\n      emit_i64_const(buf, 0)\n      emit_local_get(buf, val_l)\n      emit_i64_sub(buf)\n      emit_else(buf)\n      emit_local_get(buf, val_l)\n      emit_end(buf)\n      emit_local_set(buf, abs_l)\n      emit_local_get(buf, abs_l)\n      emit_i64_eqz(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 48)\n      emit_i32_store8(buf, 0, 0)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_sub(buf)\n      emit_local_set(buf, cur_l)\n      emit_end(buf)\n      emit_block_void(buf)\n      emit_loop_void(buf)\n      emit_local_get(buf, abs_l)\n      emit_i64_eqz(buf)\n      emit_br_if(buf, 1)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, abs_l)\n      emit_i64_const(buf, 10)\n      emit_i64_rem_s(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 48)\n      emit_i32_add(buf)\n      emit_i32_store8(buf, 0, 0)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_sub(buf)\n      emit_local_set(buf, cur_l)\n      emit_local_get(buf, abs_l)\n      emit_i64_const(buf, 10)\n      emit_i64_div_s(buf)\n      emit_local_set(buf, abs_l)\n      emit_br(buf, 0)\n      emit_end(buf)\n      emit_end(buf)\n      emit_local_get(buf, neg_l)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_local_get(buf, cur_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 45)\n      emit_i32_store8(buf, 0, 0)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_sub(buf)\n      emit_local_set(buf, cur_l)\n      emit_end(buf)\n      emit_global_get(buf, 0)\n      emit_i64_extend_i32_u(buf)\n      emit_local_set(buf, hp_l)\n      emit_i64_const(buf, 46)\n      emit_local_get(buf, cur_l)\n      emit_i64_sub(buf)\n      emit_local_set(buf, len_l)\n      emit_local_get(buf, hp_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, cur_l)\n      emit_i64_const(buf, 1)\n      emit_i64_add(buf)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_memory_copy(buf)\n      emit_local_get(buf, hp_l)\n      emit_i32_wrap_i64(buf)\n      emit_local_get(buf, len_l)\n      emit_i32_wrap_i64(buf)\n      emit_i32_const(buf, 7)\n      emit_i32_add(buf)\n      emit_i32_const(buf, -8)\n      bytebuf_push(buf, 113)\n      emit_i32_add(buf)\n      emit_global_set(buf, 0)\n      emit_local_get(buf, hp_l)\n      emit_i64_const(buf, 32)\n      emit_i64_shl(buf)\n      emit_local_get(buf, len_l)\n      emit_i64_or(buf)\n      emit_end(buf)\n      nl + 6\n    }\n    else if fname == \"Int::to_double\" || fname == \"Int::to_float\" || fname == \"Float::to_int\" || fname == \"Float::to_double\" || fname == \"Double::to_int\" || fname == \"Double::to_float\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if !prefer_bound_call && fname == \"resume\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_global_set(buf, 1)\n      emit_i64_const(buf, 0)\n      bytebuf_push(buf, 8)\n      bytebuf_push(buf, 1)\n      nl\n    }\n    else if !prefer_bound_call && fname == \"assert\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_else(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"assert_true\" {\n      let nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      emit_i32_wrap_i64(buf)\n      emit_if_void(buf)\n      emit_else(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"assert_eq\" {\n      let mut nl = ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n      nl = ce(buf, Array::get(args, 1), local_names, nl, ctx, ld)\n      emit_i64_eq(buf)\n      emit_if_void(buf)\n      emit_else(buf)\n      bytebuf_push(buf, 0)\n      emit_end(buf)\n      emit_i64_const(buf, 0)\n      nl\n    }\n    else if fname == \"Double::to_i64_bits\" {\n      ce(buf, Array::get(args, 0), local_names, next_local, ctx, ld)\n    }\n    else if fname == \"String::ends_with\" {\n     