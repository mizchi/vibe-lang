ne => None\\n          }\\n        }\\n        Array::push(np, (ssn, resolved_ty))\\n        spi = spi + 1\\n      }\\n      np\\n    } else {\\n      // #715: alias `__sf_slet_type` once here too, matching `then`'s single\\n      // use (via `fn_type_param_types`) now that it is hoisted above -- see\\n      // that binding's doc comment.\\n      let __sf_lnp_ty = __sf_slet_type\\n      Array::slice([\\n        (\\\"\\\", None)\\n      ], 0, 0)\\n    }\\n    // debugger breakpoint (DAP P1): in break mode, call the host hook\\n    // `vibe::dbg_break` at this user function's entry. The hook inspects the\\n    // wasm backtrace to name the entering function and pauses when it is in the\\n    // breakpoint set. Stack-neutral (() -> ()), so prepending is safe.\\n    if debug_break {\\n      // DAP P2: spill this function's i64 parameters into the dbgargs region so\\n      // the host hook can read and print them. All user-function wasm params are\\n      // i64 (vibe value ABI); locals 0..nparams-1 hold the params at entry.\\n      let dbg_nparams = Array::length(lc_norm_params)\\n      let dbg_n = if dbg_nparams > dbgargs_cap {\\n        dbgargs_cap\\n      } else {\\n        dbg_nparams\\n      }\\n      let mut dbg_pi = 0\\n      while dbg_pi < dbg_n {\\n        emit_i32_const(body_buf, dbgargs_base + dbg_pi * 8)\\n        emit_local_get(body_buf, dbg_pi)\\n        emit_i64_store(body_buf, 3, 0)\\n        dbg_pi = dbg_pi + 1\\n      }\\n      emit_i32_const(body_buf, dbgargs_count_addr)\\n      emit_i32_const(body_buf, dbg_n)\\n      emit_i32_store(body_buf, 2, 0)\\n      emit_call(body_buf, dbg_break_import_idx)\\n    } else {\\n      ()\\n    }\\n    let local_names = lc_fresh_string_array()\\n    let fn_name_dbg = Array::get(fn_names_list, bi)\\n    let rc_drops = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let rc_alias_dups = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let rc_dups = Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n    let lc_heap_params = lc_fresh_string_array()\\n    // #715: computed once, unconditionally (regardless of `enable_rc`), and\\n    // reused below both for the Perceus plan and for the actual codegen call\\n    // to `compile_expr` -- instead of a separate `get_efn_body(__bi_expr)`\\n    // call under `enable_rc` (as `fbody`) AND another one further down (as\\n    // `body`, inside the `is_efn(__bi_expr)` block). Each independent\\n    // `get_efn_body(__bi_expr)`/`get_efn_params(__bi_expr)` call is a real\\n    // additional owning \\\"use\\\" of `__bi_expr` for Perceus's purposes (neither\\n    // is registered in `is_borrow_arg0_call`), inflating the dup budget\\n    // `__bi_expr` statically needs. See the `lc_norm_params` doc comment\\n    // above (the same redundant-call pattern, already fixed once for\\n    // `get_efn_params`) for the full double-free mechanism this avoids.\\n    let __bi_body = if is_efn(__bi_expr) {\\n      get_efn_body(__bi_expr)\\n    } else {\\n      __bi_expr\\n    }\\n    if enable_rc {\\n      let plan = build_perceus_plan_with_params(lc_norm_params, __bi_body, lc_borrow_ret_names)\\n      let mut lhpi = 0\\n      while lhpi < Array::length(lc_norm_params) {\\n        let (lhpn, lhpt) = Array::get(lc_norm_params, lhpi)\\n        if param_is_heap_in_body(lhpn, lhpt, __bi_body) {\\n          Array::push(lc_heap_params, lhpn)\\n        } else {\\n          ()\\n        }\\n        lhpi = lhpi + 1\\n      }\\n      let mut di = 0\\n      while di < Array::length(plan) {\\n        let pa = Array::get(plan, di)\\n        if pa_is_drop(pa) {\\n          Array::push(rc_drops, pa.name)\\n        } else if pa_is_alias_dup(pa) {\\n          Array::push(rc_alias_dups, pa.name)\\n        } else if pa_is_dup(pa) {\\n          Array::push(rc_dups, pa.name)\\n        } else {\\n          ()\\n        }\\n        di = di + 1\\n      }\\n    }\\n    // Interior-line breakpoints: this function's source file id + that file's\\n    // newline index (for mapping its statement offsets to lines). Off => 0/empty.\\n    let dbg_fid = if dbg_line_on {\\n      Array::get(prov.stmt_file_id, Array::get(fn_stmt_indices, bi))\\n    } else {\\n      0\\n    }\\n    let dbg_nls = if dbg_line_on {\\n      Array::get(prov.file_nls, dbg_fid)\\n    } else {\\n      lc_fresh_int_array()\\n    }\\n    let compile_ctx = CompileCtx::{\\n      func_table: FuncTable::{\\n        names: all_fn_names_list,\\n        indices: all_fn_indices_list,\\n        params: all_fn_param_counts,\\n        returns: all_fn_returns_list,\\n        needs_env: all_fn_needs_env_list\\n      },\\n      str_table: StrTable::{\\n        strs: str_strs, offsets: str_offsets, lengths: str_lengths\\n      },\\n      lambda_table: lt_w,\\n      num_user_funcs: num_user_funcs, func_offset: func_offset,\\n      ref_cell_names: lc_fresh_string_array(),\\n      ctor_table: CtorTable::{\\n        names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\\n      },\\n      thunk_names: thunk_names_list,\\n      const_int_names: const_int_names_list,\\n      const_int_values: const_int_values_list,\\n      enable_rc: enable_rc,\\n      rc_shadow: rc_shadow,\\n      rc_drop_names: rc_drops,\\n      rc_alias_dup_names: rc_alias_dups,\\n      heap_binding_names: lc_heap_params,\\n      rc_drop_func_idx: if enable_rc {\\n        rc_drop_idx\\n      } else {\\n        -1\\n      },\\n      rc_alloc_func_idx: if enable_rc {\\n        rc_alloc_idx\\n      } else {\\n        -1\\n      },\\n      heap_grow_check_func_idx: heap_grow_check_idx,\\n      rc_dup_names: rc_dups,\\n      float_local_slots: lc_fresh_int_array(),\\n      int_local_slots: lc_fresh_int_array(),\\n      effect_names: effect_names_list,\\n      effect_op_keys: effect_op_keys_list,\\n      effect_op_arities: effect_op_arities_list,\\n      cov: cov_state,\\n      dbg_line_idx: dbg_line_import_idx,\\n      dbg_line_nl: dbg_nls,\\n      dbg_line_file_id: dbg_fid,\\n      loop_borrowed_names: lc_fresh_string_array(),\\n      loop_consumed_names: lc_fresh_string_array(),\\n      borrow_ret_names: lc_borrow_ret_names,\\n      scalar_ret_names: lc_scalar_ret_names\\n    }\\n    if is_efn(__bi_expr) {\\n      // #715: `lc_norm_params` (built above from `get_efn_params(__bi_expr)`)\\n      // already carries each parameter's `~`/`?`-stripped name in `.0` --\\n      // reuse it instead of a second `get_efn_params(__bi_expr)` call plus a\\n      // duplicate stripping pass (see the `__bi_body` doc comment above).\\n      let body = __bi_body\\n      let mut pi = 0\\n      while pi < Array::length(lc_norm_params) {\\n        let (pname, _) = Array::get(lc_norm_params, pi)\\n        Array::push(local_names, pname)\\n        pi = pi + 1\\n      }\\n      Array::push(local_names, \\\"__env\\\")\\n      let param_count = Array::length(lc_norm_params) + 1\\n      if enable_rc {\\n        let mut edi = 0\\n        while edi < Array::length(lc_norm_params) {\\n          let (edn, _edt) = Array::get(lc_norm_params, edi)\\n          if array_contains_str(lc_heap_params, edn) {\\n            let mut edc = 0\\n            let mut edj = 0\\n            while edj < Array::length(rc_dups) {\\n              if Array::get(rc_dups, edj) == edn {\\n                edc = edc + 1\\n              } else {\\n                ()\\n              }\\n              edj = edj + 1\\n            }\\n            let mut ede = 0\\n            while ede < edc {\\n              emit_rc_dup_guarded(body_buf, edi, rc_shadow)\\n              ede = ede + 1\\n            }\\n          } else {\\n            ()\\n          }\\n          edi = edi + 1\\n        }\\n      } else {\\n        ()\\n      }\\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\\n      let mut tail_nl = final_nl\\n      if enable_rc && rc_drop_idx >= 0 {\\n        let tail_root = scope_tail_proj_root(body)\\n        // #706 leak follow-up: a loop-borrowed param's protective rc_dup (see\\n        // compile_call.vibe's cc_is_loop_borrowed_ident sites) is matched by the\\n        // callee's OWN internal drop each iteration — it never touches this\\n        // function's own slot-held reference. The Perceus plan still counts that\\n        // textual occurrence as \\\"one real consume\\\" (so `remaining` hits 0 and no\\n        // PaDrop is emitted), leaking the binding's own reference once per such\\n        // occurrence. Count each param's occurrences in loop_consumed_names and\\n        // emit that many EXTRA rc_drop calls here — purely additive to the\\n        // existing rc_drops accounting, so it cannot perturb any decision the\\n        // plan and codegen already agree on elsewhere.\\n        let mut need_dup = false\\n        let mut tci = 0\\n        while tci < Array::length(lc_norm_params) {\\n          let (tcn, _tct) = Array::get(lc_norm_params, tci)\\n          let mut tcn_loop_extra = 0\\n          let mut tcle = 0\\n          while tcle < Array::length(compile_ctx.loop_consumed_names) {\\n            if Array::get(compile_ctx.loop_consumed_names, tcle) == tcn {\\n              tcn_loop_extra = tcn_loop_extra + 1\\n            } else {\\n              ()\\n            }\\n            tcle = tcle + 1\\n          }\\n          if array_contains_str(lc_heap_params, tcn) && (array_contains_str(rc_drops, tcn) || tcn_loop_extra > 0) && tcn == tail_root {\\n            need_dup = true\\n          } else {\\n            ()\\n          }\\n          tci = tci + 1\\n        }\\n        let rtemp = final_nl\\n        if need_dup {\\n          emit_local_set(body_buf, rtemp)\\n          emit_rc_dup_guarded(body_buf, rtemp, rc_shadow)\\n          tail_nl = final_nl + 1\\n        } else {\\n          ()\\n        }\\n        let mut tdj = 0\\n        while tdj < Array::length(lc_norm_params) {\\n          let (tdn, _tdt) = Array::get(lc_norm_params, tdj)\\n          if array_contains_str(lc_heap_params, tdn) {\\n            if array_contains_str(rc_drops, tdn) {\\n              emit_local_get(body_buf, tdj)\\n              emit_call(body_buf, rc_drop_idx)\\n            } else {\\n              ()\\n            }\\n            let mut tdle = 0\\n            while tdle < Array::length(compile_ctx.loop_consumed_names) {\\n              if Array::get(compile_ctx.loop_consumed_names, tdle) == tdn {\\n                emit_local_get(body_buf, tdj)\\n                emit_call(body_buf, rc_drop_idx)\\n              } else {\\n                ()\\n              }\\n              tdle = tdle + 1\\n            }\\n          } else {\\n            ()\\n          }\\n          tdj = tdj + 1\\n        }\\n        if need_dup {\\n          emit_local_get(body_buf, rtemp)\\n        } else {\\n          ()\\n        }\\n      } else {\\n        ()\\n      }\\n      if enable_rc && fn_name_dbg == entry_name {\\n        emit_i64_const(body_buf, 1)\\n        emit_i64_shr_s(body_buf)\\n      }\\n      Array::push(bodies, body_buf)\\n      let extra = if tail_nl > param_count {\\n        tail_nl - param_count\\n      } else {\\n        0\\n      }\\n      Array::push(meta_i32, 0)\\n      Array::push(meta_i64, extra)\\n    } else {\\n      Array::push(local_names, \\\"__env\\\")\\n      let param_count = 1\\n      let final_nl = compile_expr(body_buf, __bi_expr, local_names, param_count, compile_ctx, -1)\\n      if enable_rc && fn_name_dbg == entry_name {\\n        emit_i64_const(body_buf, 1)\\n        emit_i64_shr_s(body_buf)\\n      }\\n      Array::push(bodies, body_buf)\\n      let extra = if final_nl > param_count {\\n        final_nl - param_count\\n      } else {\\n        0\\n      }\\n      Array::push(meta_i32, 0)\\n      Array::push(meta_i64, extra)\\n    }\\n    bi = bi + 1\\n  }\\n  let num_lambdas = Array::length(lt_w.bodies)\\n  let start_body = bytebuf_new()\\n  let entry_func_idx = if entry_user_idx >= 0 {\\n    entry_user_idx + func_offset\\n  } else {\\n    -1\\n  }\\n  if entry_user_idx >= 0 {\\n    let entry_params = Array::get(fn_param_counts, entry_user_idx)\\n    if entry_params != 0 {\\n      throw(\\\"WASI entry function must take 0 parameters\\\")\\n    }\\n    emit_i64_const(start_body, 0)\\n    emit_call(start_body, entry_func_idx)\\n    emit_call(start_body, print_int_idx)\\n  } else {\\n    let mut sti = 0\\n    while sti < Array::length(test_fn_names) {\\n      let stname = Array::get(test_fn_names, sti)\\n      let mut __stj = 0\\n      let mut __stf = -1\\n      while __stj < Array::length(fn_names_list) {\\n        if Array::get(fn_names_list, __stj) == stname {\\n          __stf = __stj\\n        }\\n        __stj = __stj + 1\\n      }\\n      if __stf >= 0 {\\n        emit_i64_const(start_body, 0)\\n        emit_call(start_body, func_offset + __stf)\\n        emit_drop(start_body)\\n      }\\n      sti = sti + 1\\n    }\\n  }\\n  Array::push(bodies, start_body)\\n  Array::push(meta_i32, 0)\\n  Array::push(meta_i64, 0)\\n  let run_body = bytebuf_new()\\n  if entry_func_idx >= 0 {\\n    emit_i64_const(run_body, 0)\\n    emit_call(run_body, entry_func_idx)\\n  } else {\\n    let mut rti = 0\\n    while rti < Array::length(test_fn_names) {\\n      let tname = Array::get(test_fn_names, rti)\\n      let mut __rtj = 0\\n      let mut __rtf = -1\\n      while __rtj < Array::length(fn_names_list) {\\n        if Array::get(fn_names_list, __rtj) == tname {\\n          __rtf = __rtj\\n        }\\n        __rtj = __rtj + 1\\n      }\\n      if __rtf >= 0 {\\n        emit_i64_const(run_body, 0)\\n        emit_call(run_body, func_offset + __rtf)\\n        emit_drop(run_body)\\n      }\\n      rti = rti + 1\\n    }\\n    emit_i64_const(run_body, 0)\\n  }\\n  Array::push(bodies, run_body)\\n  Array::push(meta_i32, 0)\\n  Array::push(meta_i64, 0)\\n  let mut li = 0\\n  while li < num_lambdas {\\n    Array::push(bodies, Array::get(lt_w.bodies, li))\\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\\n    li = li + 1\\n  }\\n  let mut max_closure_arity = -1\\n  let mut lai = 0\\n  while lai < num_lambdas {\\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\\n    if lpc > max_closure_arity {\\n      max_closure_arity = lpc\\n    }\\n    lai = lai + 1\\n  }\\n  let mut uai = 0\\n  while uai < num_user_funcs {\\n    let upc = Array::get(fn_param_counts, uai)\\n    if upc > max_closure_arity {\\n      max_closure_arity = upc\\n    }\\n    uai = uai + 1\\n  }\\n  let mut iai = 0\\n  while iai < Array::length(linked_imports) {\\n    let (_, _, ipc, _) = Array::get(linked_imports, iai)\\n    if ipc > max_closure_arity {\\n      max_closure_arity = ipc\\n    }\\n    iai = iai + 1\\n  }\\n  let num_closure_types = if max_closure_arity >= 0 {\\n    max_closure_arity + 1\\n  } else {\\n    0\\n  }\\n  // Interior-line breakpoints (span-arc step5): when active, the `vibe::dbg_line`\\n  // import needs an `(i32) -> ()` func type. No existing base type is `(i32)->()`\\n  // (type 1 is `(i64)->()`), so append one new type AFTER all base + closure\\n  // types at index `num_base_types + num_closure_types`. This is strictly beyond\\n  // every linked-import type index (which use `num_base_types + lparams`, bounded\\n  // by num_closure_types), so existing indices are unshifted. -1 when off.\\n  let dbg_line_type_idx = if dbg_line_on {\\n    num_base_types + num_closure_types\\n  } else {\\n    -1\\n  }\\n  let extra_dbg_types = if dbg_line_on {\\n    1\\n  } else {\\n    0\\n  }\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types + extra_dbg_types)\\n  emit_func_type_raw(type_content, [\\n    127,\\n    127,\\n    127,\\n    127\\n  ], [\\n    127\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126\\n  ], [\\n    126\\n  ])\\n  let mut cti = 0\\n  while cti < num_closure_types {\\n    let num_params = cti + 1\\n    let ct_params = lc_fresh_int_array()\\n    let mut cpti = 0\\n    while cpti < num_params {\\n      Array::push(ct_params, 126)\\n      cpti = cpti + 1\\n    }\\n    emit_func_type_raw(type_content, ct_params, [\\n      126\\n    ])\\n    cti = cti + 1\\n  }\\n  // Interior-line breakpoints: append the `(i32, i32) -> ()` type for\\n  // `vibe::dbg_line` (127 = i32; params = file_id, line). Only when active, so the\\n  // type section is byte-identical off.\\n  if dbg_line_on {\\n    emit_func_type_raw(type_content, [\\n      127,\\n      127\\n    ], Array::slice([\\n      0\\n    ], 0, 0))\\n  } else {\\n    ()\\n  }\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_vibe_abi_custom_section(out, \\\"raw\\\")\\n  // #cov: emit a `vibe_cov` custom section describing the function-hit bitmap.\\n  // Layout of the payload: i32 LE cov_base, i32 LE cov_count, then the\\n  // user-function names (one per line, in bitmap-index order). The consumer\\n  // reads memory[cov_base .. cov_base+cov_count] after running and maps each\\n  // hit byte back to a name. Only present in coverage builds.\\n  if coverage {\\n    let cov_content = bytebuf_new()\\n    let cov_name = \\\"vibe_cov\\\"\\n    leb128_encode_u32(cov_content, String::length(cov_name))\\n    let mut cni = 0\\n    while cni < String::length(cov_name) {\\n      bytebuf_push(cov_content, String::char_code_at(cov_name, cni))\\n      cni = cni + 1\\n    }\\n    bytebuf_push(cov_content, cov_base & 255)\\n    bytebuf_push(cov_content, (cov_base >> 8) & 255)\\n    bytebuf_push(cov_content, (cov_base >> 16) & 255)\\n    bytebuf_push(cov_content, (cov_base >> 24) & 255)\\n    bytebuf_push(cov_content, cov_count & 255)\\n    bytebuf_push(cov_content, (cov_count >> 8) & 255)\\n    bytebuf_push(cov_content, (cov_count >> 16) & 255)\\n    bytebuf_push(cov_content, (cov_count >> 24) & 255)\\n    let mut covni = 0\\n    while covni < num_user_funcs {\\n      let covnm = Array::get(fn_names_list, covni)\\n      let covnml = String::length(covnm)\\n      let mut covci = 0\\n      while covci < covnml {\\n        bytebuf_push(cov_content, String::char_code_at(covnm, covci))\\n        covci = covci + 1\\n      }\\n      bytebuf_push(cov_content, 10)\\n      covni = covni + 1\\n    }\\n    bytebuf_push_section(out, 0, cov_content)\\n    // #cov branch: a `vibe_cov_branch` custom section describing the branch-hit\\n    // bitmap. Payload: i32 LE branch_base, i32 LE branch_count, then\\n    // branch_count i32 LE entries giving the owning user-function index per\\n    // branch id (in id order). The consumer reads memory[base .. base+count]\\n    // after running and attributes each hit branch to its function (names from\\n    // the `vibe_cov` section), so it can report per-function branch coverage.\\n    let covb_content = bytebuf_new()\\n    let covb_name = \\\"vibe_cov_branch\\\"\\n    leb128_encode_u32(covb_content, String::length(covb_name))\\n    let mut covbni = 0\\n    while covbni < String::length(covb_name) {\\n      bytebuf_push(covb_content, String::char_code_at(covb_name, covbni))\\n      covbni = covbni + 1\\n    }\\n    let covb_count = Array::get(cov_state.next, 0)\\n    bytebuf_push(covb_content, cov_branch_base & 255)\\n    bytebuf_push(covb_content, (cov_branch_base >> 8) & 255)\\n    bytebuf_push(covb_content, (cov_branch_base >> 16) & 255)\\n    bytebuf_push(covb_content, (cov_branch_base >> 24) & 255)\\n    bytebuf_push(covb_content, covb_count & 255)\\n    bytebuf_push(covb_content, (covb_count >> 8) & 255)\\n    bytebuf_push(covb_content, (covb_count >> 16) & 255)\\n    bytebuf_push(covb_content, (covb_count >> 24) & 255)\\n    let mut covbi = 0\\n    while covbi < covb_count {\\n      let owner = Array::get(cov_state.owners, covbi)\\n      bytebuf_push(covb_content, owner & 255)\\n      bytebuf_push(covb_content, (owner >> 8) & 255)\\n      bytebuf_push(covb_content, (owner >> 16) & 255)\\n      bytebuf_push(covb_content, (owner >> 24) & 255)\\n      covbi = covbi + 1\\n    }\\n    bytebuf_push_section(out, 0, covb_content)\\n  } else {\\n    ()\\n  }\\n  // debugger trace (DAP P1 groundwork): emit a `vibe.trace` custom section\\n  // describing the in-memory trace log. Payload layout: i32 LE counter_addr,\\n  // i32 LE log_base, i32 LE cap, then the user-function names (one per line, in\\n  // user-index order — the same list the name section uses). The runner reads\\n  // memory[counter_addr] for the count, then `count` i32 entries from log_base,\\n  // and maps each index to a name. Only present in debug-trace builds.\\n  if debug_trace {\\n    let tr_content = bytebuf_new()\\n    let tr_name = \\\"vibe.trace\\\"\\n    leb128_encode_u32(tr_content, String::length(tr_name))\\n    let mut trni = 0\\n    while trni < String::length(tr_name) {\\n      bytebuf_push(tr_content, String::char_code_at(tr_name, trni))\\n      trni = trni + 1\\n    }\\n    bytebuf_push(tr_content, trace_counter_addr & 255)\\n    bytebuf_push(tr_content, (trace_counter_addr >> 8) & 255)\\n    bytebuf_push(tr_content, (trace_counter_addr >> 16) & 255)\\n    bytebuf_push(tr_content, (trace_counter_addr >> 24) & 255)\\n    bytebuf_push(tr_content, trace_log_base & 255)\\n    bytebuf_push(tr_content, (trace_log_base >> 8) & 255)\\n    bytebuf_push(tr_content, (trace_log_base >> 16) & 255)\\n    bytebuf_push(tr_content, (trace_log_base >> 24) & 255)\\n    bytebuf_push(tr_content, trace_cap & 255)\\n    bytebuf_push(tr_content, (trace_cap >> 8) & 255)\\n    bytebuf_push(tr_content, (trace_cap >> 16) & 255)\\n    bytebuf_push(tr_content, (trace_cap >> 24) & 255)\\n    let mut trni2 = 0\\n    while trni2 < num_user_funcs {\\n      let trnm = Array::get(fn_names_list, trni2)\\n      let trnml = String::length(trnm)\\n      let mut trci = 0\\n      while trci < trnml {\\n        bytebuf_push(tr_content, String::char_code_at(trnm, trci))\\n        trci = trci + 1\\n      }\\n      bytebuf_push(tr_content, 10)\\n      trni2 = trni2 + 1\\n    }\\n    bytebuf_push_section(out, 0, tr_content)\\n  } else {\\n    ()\\n  }\\n  // debugger argument inspection (DAP P2): emit a `vibe.dbgargs` custom section\\n  // publishing the addresses + value ABI the runner reads. Payload layout:\\n  // i32 LE dbgargs_count_addr, i32 LE dbgargs_base, i32 LE tag_mode. At a\\n  // breakpoint the runner reads memory[count_addr] (i32) for the arg count, then\\n  // that many i64 values from dbgargs_base, decoding each per tag_mode:\\n  //   tag_mode 0 (enable_rc off): values are plain untagged i64 ints.\\n  //   tag_mode 1 (enable_rc on):  values are 1-bit tagged — low bit 0 => int\\n  //                               (raw >> 1), low bit 1 => heap pointer (hex).\\n  // Only present in break builds.\\n  if debug_break {\\n    let da_content = bytebuf_new()\\n    let da_name = \\\"vibe.dbgargs\\\"\\n    leb128_encode_u32(da_content, String::length(da_name))\\n    let mut dani = 0\\n    while dani < String::length(da_name) {\\n      bytebuf_push(da_content, String::char_code_at(da_name, dani))\\n      dani = dani + 1\\n    }\\n    bytebuf_push(da_content, dbgargs_count_addr & 255)\\n    bytebuf_push(da_content, (dbgargs_count_addr >> 8) & 255)\\n    bytebuf_push(da_content, (dbgargs_count_addr >> 16) & 255)\\n    bytebuf_push(da_content, (dbgargs_count_addr >> 24) & 255)\\n    bytebuf_push(da_content, dbgargs_base & 255)\\n    bytebuf_push(da_content, (dbgargs_base >> 8) & 255)\\n    bytebuf_push(da_content, (dbgargs_base >> 16) & 255)\\n    bytebuf_push(da_content, (dbgargs_base >> 24) & 255)\\n    let da_tag_mode = if enable_rc {\\n      1\\n    } else {\\n      0\\n    }\\n    bytebuf_push(da_content, da_tag_mode & 255)\\n    bytebuf_push(da_content, (da_tag_mode >> 8) & 255)\\n    bytebuf_push(da_content, (da_tag_mode >> 16) & 255)\\n    bytebuf_push(da_content, (da_tag_mode >> 24) & 255)\\n    bytebuf_push_section(out, 0, da_content)\\n  } else {\\n    ()\\n  }\\n  // debugger named-parameter inspection (DAP P4): emit a `vibe.dbgnames` custom\\n  // section listing, per user function (in user-index order — the same order as\\n  // the name section / fn_names_list / vibe.dbgargs spill), that function's name\\n  // followed by its parameter names. One record per function, terminated by\\n  // newline (10); within a record fields are tab-delimited (9): the first field\\n  // is the function name, the remaining fields are the parameter names. A\\n  // function with no params emits just its name + newline. Names are capped at\\n  // dbgargs_cap to match the spilled value count. The runner keys a map by\\n  // function name so entering-function F's names can be paired with F's spilled\\n  // values to print `args: [name=value]`. Only present in break builds; off =>\\n  // byte-identical to a normal build (fixpoint preserved).\\n  if debug_break {\\n    let dn_content = bytebuf_new()\\n    let dn_name = \\\"vibe.dbgnames\\\"\\n    leb128_encode_u32(dn_content, String::length(dn_name))\\n    let mut dnni = 0\\n    while dnni < String::length(dn_name) {\\n      bytebuf_push(dn_content, String::char_code_at(dn_name, dnni))\\n      dnni = dnni + 1\\n    }\\n    let mut dnfi = 0\\n    while dnfi < num_user_funcs {\\n      let dn_fnname = Array::get(fn_names_list, dnfi)\\n      let mut dn_fci = 0\\n      while dn_fci < String::length(dn_fnname) {\\n        bytebuf_push(dn_content, String::char_code_at(dn_fnname, dn_fci))\\n        dn_fci = dn_fci + 1\\n      }\\n      let dn_stmt = Array::get(stmts, Array::get(fn_stmt_indices, dnfi))\\n      let dn_expr = get_slet_expr(dn_stmt)\\n      if is_efn(dn_expr) {\\n        let dn_params = get_efn_params(dn_expr)\\n        let dn_np = Array::length(dn_params)\\n        let dn_n = if dn_np > dbgargs_cap {\\n          dbgargs_cap\\n        } else {\\n          dn_np\\n        }\\n        let mut dn_pi = 0\\n        while dn_pi < dn_n {\\n          let (dn_pname_raw, _) = Array::get(dn_params, dn_pi)\\n          let dn_pnl = String::length(dn_pname_raw)\\n          let dn_pname = if dn_pnl > 0 {\\n            let dn_plc = String::char_code_at(dn_pname_raw, dn_pnl - 1)\\n            if dn_plc == '~' || dn_plc == '?' {\\n              dn_pname_raw[0: dn_pnl - 1]\\n            } else {\\n              dn_pname_raw\\n            }\\n          } else {\\n            dn_pname_raw\\n          }\\n          bytebuf_push(dn_content, 9)\\n          let mut dn_ci = 0\\n          while dn_ci < String::length(dn_pname) {\\n            bytebuf_push(dn_content, String::char_code_at(dn_pname, dn_ci))\\n            dn_ci = dn_ci + 1\\n          }\\n          dn_pi = dn_pi + 1\\n        }\\n      } else {\\n        // #715: `dn_expr` is a fresh per-iteration owned binding (like\\n        // `__bi_expr` in the main codegen loop above), and -- unlike\\n        // `__bi_expr` -- `is_efn(dn_expr)` is NOT overwhelmingly true here:\\n        // `fn_stmt_indices` legitimately mixes real functions with non-\\n        // function \\\"thunk\\\" entries (constant initializers), so this `else`\\n        // is a common, not rare, runtime path. An empty `else { () }` uses\\n        // `dn_expr` zero times while `then` uses it once (via\\n        // `get_efn_params`), so `pc_emit`'s EIf MIN-merge (#705) permanently\\n        // carries the `then`-consumed (lower) remaining forward even on the\\n        // iterations that really take this branch -- the loop-body scope-end\\n        // drop for `dn_expr` is then skipped based on that borrowed count,\\n        // leaking `dn_expr` on every thunk entry. Call `is_efn` again here,\\n        // discarding the result, purely to consume `dn_expr` exactly once --\\n        // matching `then`'s single consuming use so both branches leave the\\n        // same remaining count and the plan's assumption holds either way.\\n        is_efn(dn_expr)\\n      }\\n      bytebuf_push(dn_content, 10)\\n      dnfi = dnfi + 1\\n    }\\n    bytebuf_push_section(out, 0, dn_content)\\n  } else {\\n    ()\\n  }\\n  // Interior-line breakpoints (span-arc step5, multi-file): emit a `vibe.dbgfiles`\\n  // custom section listing the source-file basenames in file-id order, one per\\n  // line (terminated by newline 10). `vibe::dbg_line(file_id, line)` passes the\\n  // file id; the runner indexes this table to recover the basename and match a\\n  // `--break <file>:<line>` spec. Only present when dbg_line is active, so off =>\\n  // byte-identical (fixpoint preserved).\\n  if dbg_line_on {\\n    let df_content = bytebuf_new()\\n    let df_name = \\\"vibe.dbgfiles\\\"\\n    leb128_encode_u32(df_content, String::length(df_name))\\n    let mut dfni = 0\\n    while dfni < String::length(df_name) {\\n      bytebuf_push(df_content, String::char_code_at(df_name, dfni))\\n      dfni = dfni + 1\\n    }\\n    let mut dffi = 0\\n    while dffi < Array::length(prov.files) {\\n      let df_base = Array::get(prov.files, dffi)\\n      let mut df_ci = 0\\n      while df_ci < String::length(df_base) {\\n        bytebuf_push(df_content, String::char_code_at(df_base, df_ci))\\n        df_ci = df_ci + 1\\n      }\\n      bytebuf_push(df_content, 10)\\n      dffi = dffi + 1\\n    }\\n    bytebuf_push_section(out, 0, df_content)\\n  } else {\\n    ()\\n  }\\n  bytebuf_push_section(out, 1, type_content)\\n  let import_content = bytebuf_new()\\n  bytebuf_push_vec_header(import_content, num_imported_funcs)\\n  emit_name(import_content, \\\"wasi_snapshot_preview1\\\")\\n  emit_name(import_content, \\\"fd_write\\\")\\n  bytebuf_push(import_content, 0)\\n  leb128_encode_u32(import_content, 0)\\n  if env_get_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"env-get\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if env_args_len_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"args-len\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  }\\n  if env_args_get_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"args-get\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_read_file_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_read_file\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_exists_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_exists\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_stat_token_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_stat_token\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if fs_write_file_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_write_file\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  }\\n  if fs_write_bytes_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_write_bytes\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 6)\\n  }\\n  // #632: fs_read_bytes — emitted right after fs_write_bytes to match its\\n  // reserved index. Type 3 is `(i64) -> i64` (same as fs_read_file).\\n  if fs_read_bytes_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"fs_read_bytes\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 3)\\n  }\\n  if profiler_now_us_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"profile-now-us\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  }\\n  // `vibe.sleep (i64) -> ()` — reserved index after profiler, matching the\\n  // allocation order above. Type 1 is `(i64) -> ()`.\\n  if sleep_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"sleep\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 1)\\n  } else {\\n    ()\\n  }\\n  // `vibe.stdin_read_char () -> i64` — after sleep, matching allocation order.\\n  // Type 5 is `() -> i64` (same as profile-now-us).\\n  if stdin_read_char_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"stdin_read_char\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 5)\\n  } else {\\n    ()\\n  }\\n  if dbg_break_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"dbg_break\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, 2)\\n  }\\n  // Interior-line breakpoints (span-arc step5): emit the `vibe::dbg_line` import\\n  // descriptor here, AFTER dbg_break and BEFORE the linked imports, matching its\\n  // reserved import index order. Type index is the appended `(i32) -> ()` type.\\n  if dbg_line_import_idx >= 0 {\\n    emit_name(import_content, \\\"vibe\\\")\\n    emit_name(import_content, \\\"dbg_line\\\")\\n    bytebuf_push(import_content, 0)\\n    leb128_encode_u32(import_content, dbg_line_type_idx)\\n  } else {\\n    ()\\n  }\\n  let mut li_emit = 0\\n  while li_emit < Array::length(linked_imports) {\\n    let (lmod, lfn, lparams, _) = Array::get(linked_imports, li_emit)\\n    emit_name(import_content, lmod)\\n    emit_name(import_content, lfn)\\n    bytebuf_push(import_content, 0)\\n    let type_idx = num_base_types + lparams\\n    leb128_encode_u32(import_content, type_idx)\\n    li_emit = li_emit + 1\\n  }\\n  bytebuf_push_section(out, 2, import_content)\\n  let func_type_indices = lc_fresh_int_array()\\n  Array::push(func_type_indices, 1)\\n  Array::push(func_type_indices, 1)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 5)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 7)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 5)\\n  Array::push(func_type_indices, 5)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 7)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  if enable_rc {\\n    Array::push(func_type_indices, 1)\\n    Array::push(func_type_indices, 3)\\n  } else {\\n    ()\\n  }\\n  Array::push(func_type_indices, 2)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 8)\\n  let mut fti = 0\\n  while fti < num_user_funcs {\\n    let upc = Array::get(fn_param_counts, fti)\\n    Array::push(func_type_indices, num_base_types + upc)\\n    fti = fti + 1\\n  }\\n  Array::push(func_type_indices, 2)\\n  Array::push(func_type_indices, 5)\\n  let mut lfi = 0\\n  while lfi < num_lambdas {\\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\\n    Array::push(func_type_indices, num_base_types + lam_user_params)\\n    lfi = lfi + 1\\n  }\\n  if Array::length(func_type_indices) != Array::length(bodies) {\\n    throw(\\\"WASI codegen internal error: function section and code section count mismatch\\\")\\n  }\\n  emit_function_section(out, func_type_indices)\\n  let total_table_entries = num_user_funcs + num_lambdas\\n  if total_table_entries > 0 {\\n    emit_table_section_funcref(out, total_table_entries)\\n  }\\n  emit_memory_section(out, wasi_memory_min_pages_for_heap(heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve + (if rc_shadow {\\n    rc_shadow_reserve()\\n  } else {\\n    0\\n  })))\\n  // #721: emit the tag section only when something can reference a tag --\\n  // EThrow (`throw 2`), EHandle (try_table over tags 0-3), or a declared\\n  // effect (per-effect tags at index 4+). Pure-compute modules then carry no\\n  // exceptions machinery at all, which keeps V8 off its slower exnref module\\n  // path (~35% wall on call-heavy code; wasmtime is indifferent).\\n  let uses_exceptions = Array::length(effect_names_list) > 0 || stmts_contain_exceptions(stmts)\\n  if uses_exceptions {\\n    let tag_content = bytebuf_new()\\n    let num_tags = Array::length(effect_names_list) + 4\\n    bytebuf_push_vec_header(tag_content, num_tags)\\n    let mut tag_emit_i = 0\\n    while tag_emit_i < num_tags {\\n      bytebuf_push(tag_content, 0)\\n      leb128_encode_u32(tag_content, 1)\\n      tag_emit_i = tag_emit_i + 1\\n    }\\n    bytebuf_push_section(out, 13, tag_content)\\n  } else {\\n    ()\\n  }\\n  let global_content = bytebuf_new()\\n  if enable_rc {\\n    bytebuf_push_vec_header(global_content, 7)\\n  } else {\\n    bytebuf_push_vec_header(global_content, 6)\\n  }\\n  bytebuf_push(global_content, 127)\\n  bytebuf_push(global_content, 1)\\n  emit_i32_const(global_content, heap_start + eff_reserve + cov_reserve + cov_branch_reserve + trace_reserve + dbgargs_reserve)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  if enable_rc {\\n    bytebuf_push(global_content, 127)\\n    bytebuf_push(global_content, 1)\\n    emit_i32_const(global_content, 0)\\n    emit_end(global_content)\\n  }\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push(global_content, 127)\\n  bytebuf_push(global_content, 1)\\n  emit_i32_const(global_content, heap_start)\\n  emit_end(global_content)\\n  // #665: g_op_index (i64, mut) — operation index of the perform unwinding to a\\n  // handler, for multi-operation dispatch. Appended last; index = rc ? 6 : 5.\\n  bytebuf_push(global_content, 126)\\n  bytebuf_push(global_content, 1)\\n  emit_i64_const(global_content, 0)\\n  emit_end(global_content)\\n  bytebuf_push_section(out, 6, global_content)\\n  let start_func_idx = func_offset + num_user_funcs\\n  let run_func_idx = start_func_idx + 1\\n  let all_export_names = lc_fresh_string_array()\\n  let all_export_indices = lc_fresh_int_array()\\n  if !library_mode {\\n    Array::push(all_export_names, \\\"_start\\\")\\n    Array::push(all_export_indices, start_func_idx)\\n  }\\n  if !library_mode && entry_func_idx >= 0 && !array_contains_str(all_export_names, entry_name) {\\n    Array::push(all_export_names, entry_name)\\n    Array::push(all_export_indices, entry_func_idx)\\n  }\\n  let mut exi = 0\\n  while exi < Array::length(export_fn_names) {\\n    let ename = Array::get(export_fn_names, exi)\\n    let skip_export = library_mode && ename == entry_name\\n    if !skip_export && !array_contains_str(all_export_names, ename) {\\n      Array::push(all_export_names, ename)\\n      Array::push(all_export_indices, Array::get(export_fn_user_indices, exi) + func_offset)\\n    }\\n    exi = exi + 1\\n  }\\n  // Per-block bench: export each `__bench_<name>` function so the runner's\\n  // `--bench` mode can time benchmark blocks individually (instead of running the\\n  // whole `_start`). Only `__no_entry__` test/bench builds populate test_fn_names,\\n  // so normal builds (incl. the compiler self-compile) are byte-identical. The\\n  // wasm index of a user function at user-index `j` is `j + func_offset`.\\n  let mut bxi = 0\\n  while bxi < Array::length(test_fn_names) {\\n    let bname = Array::get(test_fn_names, bxi)\\n    if String::starts_with(bname, \\\"__bench_\\\") && !array_contains_str(all_export_names, bname) {\\n      let mut bj = 0\\n      let mut bfound = 0 - 1\\n      while bj < num_user_funcs {\\n        if Array::get(fn_names_list, bj) == bname {\\n          bfound = bj\\n          bj = num_user_funcs\\n        } else {\\n          bj = bj + 1\\n        }\\n      }\\n      if bfound >= 0 {\\n        Array::push(all_export_names, bname)\\n        Array::push(all_export_indices, bfound + func_offset)\\n      }\\n    }\\n    bxi = bxi + 1\\n  }\\n  let export_content = bytebuf_new()\\n  // #721: the \\\"error\\\" tag export exists only when the tag section does.\\n  let export_count = Array::length(all_export_names) + 1 +\\n  (if library_mode {\\n    0\\n  } else {\\n    1 + (if uses_exceptions {\\n      1\\n    } else {\\n      0\\n    })\\n  })\\n  bytebuf_push_vec_header(export_content, export_count)\\n  let mut efi = 0\\n  while efi < Array::length(all_export_names) {\\n    emit_name(export_content, Array::get(all_export_names, efi))\\n    bytebuf_push(export_content, 0)\\n    leb128_encode_u32(export_content, Array::get(all_export_indices, efi))\\n    efi = efi + 1\\n  }\\n  emit_name(export_content, \\\"memory\\\")\\n  bytebuf_push(export_content, 2)\\n  leb128_encode_u32(export_content, 0)\\n  if !library_mode {\\n    emit_name(export_content, \\\"__heap_ptr\\\")\\n    bytebuf_push(export_content, 3)\\n    leb128_encode_u32(export_content, 0)\\n    if uses_exceptions {\\n      emit_name(export_content, \\\"error\\\")\\n      bytebuf_push(export_content, 4)\\n      leb128_encode_u32(export_content, 0)\\n    } else {\\n      ()\\n    }\\n  }\\n  bytebuf_push_section(out, 7, export_content)\\n  if total_table_entries > 0 {\\n    let table_func_indices = lc_fresh_int_array()\\n    let mut tei = 0\\n    while tei < num_user_funcs {\\n      Array::push(table_func_indices, func_offset + tei)\\n      tei = tei + 1\\n    }\\n    let mut tej = 0\\n    while tej < num_lambdas {\\n      Array::push(table_func_indices, run_func_idx + 1 + tej)\\n      tej = tej + 1\\n    }\\n    emit_element_section_active(out, table_func_indices)\\n  }\\n  let code_content = bytebuf_new()\\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\\n  let mut ci = 0\\n  while ci < Array::length(bodies) {\\n    let body = Array::get(bodies, ci)\\n    let func_buf = bytebuf_new()\\n    let ni32 = Array::get(meta_i32, ci)\\n    let ni64 = Array::get(meta_i64, ci)\\n    if ni32 == 0 {\\n      if ni64 == 0 {\\n        leb128_encode_u32(func_buf, 0)\\n      } else {\\n        leb128_encode_u32(func_buf, 1)\\n        leb128_encode_u32(func_buf, ni64)\\n        bytebuf_push(func_buf, 126)\\n      }\\n    } else {\\n      if ni64 == 0 {\\n        leb128_encode_u32(func_buf, 1)\\n        leb128_encode_u32(func_buf, ni32)\\n        bytebuf_push(func_buf, 127)\\n      } else {\\n        leb128_encode_u32(func_buf, 2)\\n        leb128_encode_u32(func_buf, ni32)\\n        bytebuf_push(func_buf, 127)\\n        leb128_encode_u32(func_buf, ni64)\\n        bytebuf_push(func_buf, 126)\\n      }\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(code_content, func_buf)\\n    ci = ci + 1\\n  }\\n  bytebuf_push_section(out, 10, code_content)\\n  if num_strings > 0 {\\n    let data_offsets = lc_fresh_int_array()\\n    let data_bufs = lc_fresh_bytes_array()\\n    let mut di = 0\\n    while di < num_strings {\\n      Array::push(data_offsets, Array::get(str_offsets, di))\\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\\n      di = di + 1\\n    }\\n    emit_data_section_multi(out, data_offsets, data_bufs)\\n  }\\n  // Name section (debugger P0 / ADR-0035): name the user functions so wasm\\n  // backtraces and tooling show `main` etc. instead of `<wasm function N>`.\\n  // User functions occupy consecutive indices starting at `func_offset`.\\n  emit_function_name_section(out, fn_names_list, func_offset)\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let compile_wasi_module_rc_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts_in, entry_name) -> {\\n  let stmts = elaborate_heap_params(stmts_in)\\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, false, false, empty_dbg_prov())\\n}\\n\\n// #715 recurrence guard: RC + shadow-liveness instrumentation (VIBE_RC=shadow).\\nexport let compile_wasi_module_rc_shadow_impl: (Array[Stmt], String) -> Bytes with { Error } = (stmts_in, entry_name) -> {\\n  let stmts = elaborate_heap_params(stmts_in)\\n  compile_wasi_module_linked_impl(stmts, entry_name, Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0), Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, false, true, empty_dbg_prov())\\n}\\n\\nexport let compile_wasi_module_with_sources_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, false, false, false, false, false, empty_dbg_prov())\\n}\\n\\n// Coverage build (#cov): compile with function-level hit instrumentation +\\n// `vibe_cov` custom section. Same as compile_wasi_module_with_sources_impl but\\n// with coverage enabled.\\nexport let compile_wasi_module_with_sources_coverage_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, true, false, false, false, empty_dbg_prov())\\n}\\n\\n// Trace build (debugger / DAP P1 groundwork): compile with function-call\\n// execution-trace instrumentation + `vibe.trace` custom section. Same as\\n// compile_wasi_module_with_sources_impl but with debug_trace enabled.\\nexport let compile_wasi_module_with_sources_trace_impl: (Array[Stmt], String, Array[(String, String)]) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, true, false, false, empty_dbg_prov())\\n}\\n\\n// Break build (debugger / DAP P1): compile with `vibe::dbg_break` host-hook\\n// instrumentation at each user function entry. Same as\\n// compile_wasi_module_with_sources_impl but with debug_break enabled.\\nexport let compile_wasi_module_with_sources_break_impl: (Array[Stmt], String, Array[(String, String)], DbgProv) -> Bytes with { Error } = (stmts, entry_name, selfhost_srcs, prov) -> {\\n  compile_wasi_module_linked_impl(stmts, entry_name, selfhost_srcs, Array::slice([\\n    (\\\"\\\", \\\"\\\", 0, 0)\\n  ], 0, 0), false, true, false, false, true, false, prov)\\n}\\n\")\n}\n\nlet cli_adapter_source_82 = () -> (String, String) {\n  (\"vibe/compiler/component_codegen.vibe\",\n\"//# Imports\\n\\nimport ./bytebuf.vibe {\\n  bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport ./wasm_emit.vibe {\\n  emit_code_section, emit_export_section, emit_func_type_raw, emit_function_section, emit_header, emit_i32_add, emit_i32_const, emit_i32_store, emit_i64_const, emit_local_get, emit_local_set, emit_name\\n}\\n\\n//# Functions\\n\\nlet read_uleb: (Bytes, Int) -> (Int, Int) = (bytes, start) -> {\\n  let mut value = 0\\n  let mut shift = 0\\n  let mut i = start\\n  let len = Bytes::length(bytes)\\n  let mut done = false\\n  while (i < len) && (done == false) {\\n    let b = Bytes::get(bytes, i)\\n    value = value|((b&127)<<shift)\\n    i = i + 1\\n    if (b&128) == 0 {\\n      done = true\\n    } else {\\n      shift = shift + 7\\n    }\\n  }\\n  (value, i)\\n}\\n\\nlet section_type = 7\\n\\nlet core_sort_mem = 2\\n\\nlet new_int_array: () -> Array[Int] = () -> {\\n  Array::slice([\\n    0\\n  ], 0, 0)\\n}\\n\\nlet section_alias = 6\\n\\nlet section_canon = 8\\n\\nlet core_sort_func = 0\\n\\nlet read_name_info: (Bytes, Int) -> (Int, Int) = (bytes, start) -> {\\n  read_uleb(bytes, start)\\n}\\n\\nlet skip_name: (Bytes, Int) -> Int = (bytes, start) -> {\\n  let (name_len, after_len) = read_name_info(bytes, start)\\n  after_len + name_len\\n}\\n\\nlet section_export = 11\\n\\nlet section_import = 10\\n\\nlet section_module = 1\\n\\nlet parse_type_sigs: (Bytes, Int, Int, Array[Array[Int]]) -> Unit = (bytes, sec_start, sec_end, out_sigs) -> {\\n  let mut j = sec_start\\n  let (type_count, next_j) = read_uleb(bytes, j)\\n  j = next_j\\n  let mut t = 0\\n  while t < type_count {\\n    if j >= sec_end {\\n      t = type_count\\n    }\\n    else {\\n      let form = Bytes::get(bytes, j)\\n      j = j + 1\\n      if form != 96 {\\n        t = type_count\\n      }\\n      else {\\n        let sig = new_int_array()\\n        let (param_count, next_j2) = read_uleb(bytes, j)\\n        j = next_j2\\n        Array::push(sig, param_count)\\n        let mut p = 0\\n        while p < param_count {\\n          if j >= sec_end {\\n            p = param_count\\n          }\\n          else {\\n            Array::push(sig, Bytes::get(bytes, j))\\n            j = j + 1\\n            p = p + 1\\n          }\\n        }\\n        let (result_count, next_j3) = read_uleb(bytes, j)\\n        j = next_j3\\n        Array::push(sig, result_count)\\n        let mut rv = 0\\n        while rv < result_count {\\n          if j >= sec_end {\\n            rv = result_count\\n          }\\n          else {\\n            Array::push(sig, Bytes::get(bytes, j))\\n            j = j + 1\\n            rv = rv + 1\\n          }\\n        }\\n        Array::push(out_sigs, sig)\\n        t = t + 1\\n      }\\n    }\\n  }\\n}\\n\\nlet comp_extern_func = 1\\n\\nlet comp_valtype_f32 = 118\\n\\nlet comp_valtype_f64 = 117\\n\\nlet comp_valtype_s32 = 122\\n\\nlet comp_valtype_s64 = 120\\n\\nlet emit_raw_content: (Bytes, Bytes) -> Unit = (buf, content) -> {\\n  leb128_encode_u32(buf, Bytes::length(content))\\n  bytebuf_push_buf(buf, content)\\n}\\n\\nlet read_name_string: (Bytes, Int) -> String = (bytes, start) -> {\\n  let (name_len, after_len) = read_name_info(bytes, start)\\n  // Char-by-char: was `s = String::concat(s, char)` per byte, O(N²) on\\n  // the name length (which can be hundreds of chars for mangled\\n  // identifiers).\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < name_len {\\n    StringBuilder::push(buf, String::from_char_code(Bytes::get(bytes, after_len + i)))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\n\\nlet skip_wasm_limits: (Bytes, Int, Int) -> Int = (bytes, start, end_pos) -> {\\n  let mut i = start\\n  if i >= end_pos {\\n    end_pos\\n  }\\n  else {\\n    let flags = Bytes::get(bytes, i)\\n    i = i + 1\\n    let (min_limit, next_i1) = read_uleb(bytes, i)\\n    let _ = min_limit\\n    i = next_i1\\n    if (flags&1) != 0 {\\n      let (max_limit, next_i2) = read_uleb(bytes, i)\\n      let _ = max_limit\\n      i = next_i2\\n    }\\n    if (flags&4) != 0 {\\n      let (page_size, next_i3) = read_uleb(bytes, i)\\n      let _ = page_size\\n      i = next_i3\\n    }\\n    if i > end_pos {\\n      end_pos\\n    } else {\\n      i\\n    }\\n  }\\n}\\n\\nlet component_magic_0 = 0\\n\\nlet component_magic_1 = 97\\n\\nlet component_magic_2 = 115\\n\\nlet component_magic_3 = 109\\n\\nlet emit_alias_section: (Bytes, Int, Array[String], Array[Int]) -> Unit = (buf, core_instance_idx, names, sorts) -> {\\n  let count = Array::length(names)\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_alias)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      bytebuf_push(content, 0)\\n      bytebuf_push(content, Array::get(sorts, i))\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, core_instance_idx)\\n      emit_name(content, Array::get(names, i))\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nlet comp_valtype_string = 115\\n\\nlet component_version_0 = 13\\n\\nlet component_version_1 = 0\\n\\nlet component_version_2 = 1\\n\\nlet component_version_3 = 0\\n\\nlet core_to_comp_valtype: (Int) -> Int = (v) -> {\\n  if v == 127 {\\n    comp_valtype_s32\\n  }\\n  else {\\n    if v == 126 {\\n      comp_valtype_s64\\n    }\\n    else {\\n      if v == 125 {\\n        comp_valtype_f32\\n      }\\n      else {\\n        if v == 124 {\\n          comp_valtype_f64\\n        }\\n        else {\\n          0 - 1\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nlet emit_canon_lift_func: (Bytes, Int, Int, Int, Int, Int) -> Unit = (content, core_func_idx, type_idx, need_string, memory_idx, realloc_idx) -> {\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, core_func_idx)\\n  if need_string != 0 {\\n    leb128_encode_u32(content, 3)\\n    bytebuf_push(content, 0)\\n    bytebuf_push(content, 3)\\n    leb128_encode_u32(content, memory_idx)\\n    bytebuf_push(content, 4)\\n    leb128_encode_u32(content, realloc_idx)\\n  } else {\\n    leb128_encode_u32(content, 0)\\n  }\\n  leb128_encode_u32(content, type_idx)\\n}\\n\\nlet emit_component_header: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, component_magic_0)\\n  bytebuf_push(buf, component_magic_1)\\n  bytebuf_push(buf, component_magic_2)\\n  bytebuf_push(buf, component_magic_3)\\n  bytebuf_push(buf, component_version_0)\\n  bytebuf_push(buf, component_version_1)\\n  bytebuf_push(buf, component_version_2)\\n  bytebuf_push(buf, component_version_3)\\n}\\n\\nlet section_core_instance = 2\\n\\nlet skip_core_import_desc: (Bytes, Int, Int, Int) -> Int = (bytes, start, kind, end_pos) -> {\\n  let mut i = start\\n  if kind == 1 {\\n    if i < end_pos {\\n      i = i + 1\\n    }\\n    i = skip_wasm_limits(bytes, i, end_pos)\\n  } else {\\n    if kind == 2 {\\n      i = skip_wasm_limits(bytes, i, end_pos)\\n    } else {\\n      if kind == 3 {\\n        if (i + 2) <= end_pos {\\n          i = i + 2\\n        } else {\\n          i = end_pos\\n        }\\n      } else {\\n        if kind == 4 {\\n          if i < end_pos {\\n            i = i + 1\\n          }\\n          let (type_idx, next_i) = read_uleb(bytes, i)\\n          let _ = type_idx\\n          i = next_i\\n        } else {\\n          i = end_pos\\n        }\\n      }\\n    }\\n  }\\n  if i > end_pos {\\n    end_pos\\n  } else {\\n    i\\n  }\\n}\\n\\nlet parse_core_exports: (Bytes, Array[String], Array[Int], Array[Array[Int]]) -> Int = (core_wasm, out_names, out_func_indices, out_type_sigs) -> {\\n  let len = Bytes::length(core_wasm)\\n  if len < 8 {\\n    0\\n  }\\n  else {\\n    let type_sigs = Array::slice([\\n      [\\n        0\\n      ]\\n    ], 0, 0)\\n    let func_type_indices = new_int_array()\\n    let mut import_func_count = 0\\n    let mut i = 8\\n    let mut export_count = 0\\n    while i < len {\\n      let sec_id = Bytes::get(core_wasm, i)\\n      i = i + 1\\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\\n      i = next_i\\n      let sec_end = i + sec_size\\n      if sec_end > len {\\n        i = len\\n      }\\n      else {\\n        if sec_id == 1 {\\n          parse_type_sigs(core_wasm, i, sec_end, type_sigs)\\n        } else {\\n          if sec_id == 2 {\\n            let mut j = i\\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\\n            j = next_j\\n            let mut imp = 0\\n            while imp < imp_count {\\n              if j >= sec_end {\\n                imp = imp_count\\n              }\\n              else {\\n                j = skip_name(core_wasm, j)\\n                j = skip_name(core_wasm, j)\\n                if j >= sec_end {\\n                  imp = imp_count\\n                }\\n                else {\\n                  let kind = Bytes::get(core_wasm, j)\\n                  j = j + 1\\n                  if kind == 0 {\\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\\n                    let _ = type_idx\\n                    j = next_j2\\n                    import_func_count = import_func_count + 1\\n                  } else {\\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\\n                  }\\n                  imp = imp + 1\\n                }\\n              }\\n            }\\n          } else {\\n            if sec_id == 3 {\\n              let mut j = i\\n              let (func_count, next_j) = read_uleb(core_wasm, j)\\n              j = next_j\\n              let mut f = 0\\n              while f < func_count {\\n                if j >= sec_end {\\n                  f = func_count\\n                }\\n                else {\\n                  let (type_idx, next_j2) = read_uleb(core_wasm, j)\\n                  Array::push(func_type_indices, type_idx)\\n                  j = next_j2\\n                  f = f + 1\\n                }\\n              }\\n            } else {\\n              if sec_id == 7 {\\n                let mut j = i\\n                let (exp_count, next_j) = read_uleb(core_wasm, j)\\n                j = next_j\\n                let mut e = 0\\n                while e < exp_count {\\n                  if j >= sec_end {\\n                    e = exp_count\\n                  }\\n                  else {\\n                    let name = read_name_string(core_wasm, j)\\n                    j = skip_name(core_wasm, j)\\n                    if j >= sec_end {\\n                      e = exp_count\\n                    }\\n                    else {\\n                      let kind = Bytes::get(core_wasm, j)\\n                      j = j + 1\\n                      let (index, next_j2) = read_uleb(core_wasm, j)\\n                      j = next_j2\\n                      if kind == 0 {\\n                        let type_idx = if index < import_func_count {\\n                          0 - 1\\n                        }\\n                        else {\\n                          let local_idx = index - import_func_count\\n                          if local_idx < Array::length(func_type_indices) {\\n                            Array::get(func_type_indices, local_idx)\\n                          } else {\\n                            0 - 1\\n                          }\\n                        }\\n                        if (type_idx >= 0) && (type_idx < Array::length(type_sigs)) {\\n                          Array::push(out_names, name)\\n                          Array::push(out_func_indices, index)\\n                          Array::push(out_type_sigs, Array::get(type_sigs, type_idx))\\n                          export_count = export_count + 1\\n                        }\\n                      }\\n                      e = e + 1\\n                    }\\n                  }\\n                }\\n              }\\n            }\\n          }\\n        }\\n        i = sec_end\\n      }\\n    }\\n    export_count\\n  }\\n}\\n\\nlet parse_core_imports: (Bytes, Array[String], Array[String], Array[Int], Array[Array[Int]]) -> Int = (core_wasm, out_module_names, out_func_names, out_type_indices, out_type_sigs) -> {\\n  let len = Bytes::length(core_wasm)\\n  if len < 8 {\\n    0\\n  }\\n  else {\\n    let mut i = 8\\n    let mut import_count = 0\\n    while i < len {\\n      let sec_id = Bytes::get(core_wasm, i)\\n      i = i + 1\\n      let (sec_size, next_i) = read_uleb(core_wasm, i)\\n      i = next_i\\n      let sec_end = i + sec_size\\n      if sec_end > len {\\n        i = len\\n      }\\n      else {\\n        if sec_id == 1 {\\n          parse_type_sigs(core_wasm, i, sec_end, out_type_sigs)\\n        } else {\\n          if sec_id == 2 {\\n            let mut j = i\\n            let (imp_count, next_j) = read_uleb(core_wasm, j)\\n            j = next_j\\n            let mut imp = 0\\n            while imp < imp_count {\\n              if j >= sec_end {\\n                imp = imp_count\\n              }\\n              else {\\n                let mod_name = read_name_string(core_wasm, j)\\n                j = skip_name(core_wasm, j)\\n                let fn_name = read_name_string(core_wasm, j)\\n                j = skip_name(core_wasm, j)\\n                if j >= sec_end {\\n                  imp = imp_count\\n                }\\n                else {\\n                  let kind = Bytes::get(core_wasm, j)\\n                  j = j + 1\\n                  if kind == 0 {\\n                    let (type_idx, next_j2) = read_uleb(core_wasm, j)\\n                    j = next_j2\\n                    Array::push(out_module_names, mod_name)\\n                    Array::push(out_func_names, fn_name)\\n                    Array::push(out_type_indices, type_idx)\\n                    import_count = import_count + 1\\n                  } else {\\n                    j = skip_core_import_desc(core_wasm, j, kind, sec_end)\\n                  }\\n                  imp = imp + 1\\n                }\\n              }\\n            }\\n          }\\n        }\\n        i = sec_end\\n      }\\n    }\\n    import_count\\n  }\\n}\\n\\nlet build_import_plan: (Bytes, Array[String], Array[String], Array[Int], Array[String], Array[Int], Array[Array[Int]], Array[Array[String]], Array[Array[Int]]) -> Int = (core_wasm, out_import_names, out_binding_func_names, out_binding_func_indices, out_unique_module_names, out_module_binding_counts, out_comp_params, out_comp_param_names, out_comp_results) -> {\\n  let imp_module_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let imp_func_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let imp_type_indices = new_int_array()\\n  let type_sigs = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let _ = parse_core_imports(core_wasm, imp_module_names, imp_func_names, imp_type_indices, type_sigs)\\n  let seen_keys = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_idx_map_keys = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_idx_map_vals = new_int_array()\\n  let mut binding_count = 0\\n  let mut i = 0\\n  while i < Array::length(imp_module_names) {\\n    let mod_name = Array::get(imp_module_names, i)\\n    let fn_name = Array::get(imp_func_names, i)\\n    let key = \\\"\\\\{mod_name}||\\\\{fn_name}\\\"\\n    let mut already = false\\n    let mut s = 0\\n    while s < Array::length(seen_keys) {\\n      if Array::get(seen_keys, s) == key {\\n        already = true\\n      }\\n      s = s + 1\\n    }\\n    if already == false {\\n      Array::push(seen_keys, key)\\n      let type_idx = Array::get(imp_type_indices, i)\\n      if type_idx < Array::length(type_sigs) {\\n        let sig = Array::get(type_sigs, type_idx)\\n        let param_count = Array::get(sig, 0)\\n        let result_count_index = 1 + param_count\\n        let result_count = Array::get(sig, result_count_index)\\n        let comp_params = new_int_array()\\n        let mut valid = true\\n        let mut p = 0\\n        while p < param_count {\\n          let cv = core_to_comp_valtype(Array::get(sig, 1 + p))\\n          if cv < 0 {\\n            valid = false\\n          }\\n          else {\\n            Array::push(comp_params, cv)\\n          }\\n          p = p + 1\\n        }\\n        let comp_results = new_int_array()\\n        let mut r = 0\\n        while r < result_count {\\n          let cv = core_to_comp_valtype(Array::get(sig, result_count_index + 1 + r))\\n          if cv < 0 {\\n            valid = false\\n          }\\n          else {\\n            Array::push(comp_results, cv)\\n          }\\n          r = r + 1\\n        }\\n        if valid {\\n          let mut mod_idx = 0 - 1\\n          let mut mi = 0\\n          while mi < Array::length(module_idx_map_keys) {\\n            if Array::get(module_idx_map_keys, mi) == mod_name {\\n              mod_idx = Array::get(module_idx_map_vals, mi)\\n            }\\n            mi = mi + 1\\n          }\\n          if mod_idx < 0 {\\n            mod_idx = Array::length(out_unique_module_names)\\n            Array::push(out_unique_module_names, mod_name)\\n            Array::push(out_module_binding_counts, 0)\\n            Array::push(module_idx_map_keys, mod_name)\\n            Array::push(module_idx_map_vals, mod_idx)\\n          }\\n          let import_name = \\\"import-\\\\{binding_count}\\\"\\n          Array::push(out_import_names, import_name)\\n          Array::push(out_binding_func_names, fn_name)\\n          Array::push(out_binding_func_indices, binding_count)\\n          Array::push(out_comp_params, comp_params)\\n          let empty_names = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          Array::push(out_comp_param_names, empty_names)\\n          Array::push(out_comp_results, comp_results)\\n          let cur = Array::get(out_module_binding_counts, mod_idx)\\n          Array::set(out_module_binding_counts, mod_idx, cur + 1)\\n          binding_count = binding_count + 1\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  binding_count\\n}\\n\\nlet comp_inst_arg_instance = 18\\n\\nlet emit_canon_lift_section: (Bytes, Int, Int) -> Unit = (buf, core_func_idx, type_idx) -> {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  emit_canon_lift_func(content, core_func_idx, type_idx, 0, 0, 0)\\n  emit_raw_content(buf, content)\\n}\\n\\nlet emit_canon_lower_section: (Bytes, Int) -> Unit = (buf, count) -> {\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_canon)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      bytebuf_push(content, 1)\\n      bytebuf_push(content, 0)\\n      leb128_encode_u32(content, i)\\n      leb128_encode_u32(content, 0)\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nlet emit_comp_import_section: (Bytes, Array[String], Int) -> Unit = (buf, import_names, count) -> {\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_import)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      bytebuf_push(content, 0)\\n      emit_name(content, Array::get(import_names, i))\\n      bytebuf_push(content, comp_extern_func)\\n      leb128_encode_u32(content, i)\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nlet emit_core_module_section: (Bytes, Bytes) -> Unit = (buf, core_wasm) -> {\\n  bytebuf_push(buf, section_module)\\n  let wasm_len = Bytes::length(core_wasm)\\n  leb128_encode_u32(buf, wasm_len)\\n  bytebuf_push_buf(buf, core_wasm)\\n}\\n\\nlet emit_alias_run_and_memory: (Bytes, Int) -> Unit = (buf, core_instance_idx) -> {\\n  emit_alias_section(buf, core_instance_idx, [\\n    \\\"_start\\\",\\n    \\\"memory\\\"\\n  ], [\\n    core_sort_func,\\n    core_sort_mem\\n  ])\\n}\\n\\n// Seed-compatible `_` -> `-` rewrite. `String::replace_all` is newer than the\\n// pinned selfhost seed's frozen prelude, so a manual char loop keeps this file\\n// buildable from the fixed seed (docs/selfhost-bootstrap.md, new-feature rule).\\nlet comp_underscores_to_dashes: (String) -> String = (name) -> {\\n  let len = String::length(name)\\n  let mut out = \\\"\\\"\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(name, i)\\n    if c == 95 {\\n      out = String::concat(out, \\\"-\\\")\\n    } else {\\n      out = String::concat(out, String::from_char_code(c))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet normalize_comp_param_name: (String) -> String = (name) -> {\\n  comp_underscores_to_dashes(name)\\n}\\n\\nlet emit_comp_func_type: (Bytes, Array[Int], Array[String], Array[Int], Int) -> Unit = (content, param_types, param_names, result_types, is_async) -> {\\n  if is_async != 0 {\\n    bytebuf_push(content, 67)\\n  } else {\\n    bytebuf_push(content, 64)\\n  }\\n  leb128_encode_u32(content, Array::length(param_types))\\n  let mut i = 0\\n  while i < Array::length(param_types) {\\n    let name = if i < Array::length(param_names) {\\n      normalize_comp_param_name(Array::get(param_names, i))\\n    }\\n    else {\\n      \\\"p\\\\{i}\\\"\\n    }\\n    emit_name(content, name)\\n    bytebuf_push(content, Array::get(param_types, i))\\n    i = i + 1\\n  }\\n  if Array::length(result_types) == 0 {\\n    bytebuf_push(content, 1)\\n    leb128_encode_u32(content, 0)\\n  } else {\\n    if Array::length(result_types) == 1 {\\n      bytebuf_push(content, 0)\\n      bytebuf_push(content, Array::get(result_types, 0))\\n    } else {\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, Array::length(result_types))\\n      let mut r = 0\\n      while r < Array::length(result_types) {\\n        emit_name(content, \\\"r\\\\{r}\\\")\\n        bytebuf_push(content, Array::get(result_types, r))\\n        r = r + 1\\n      }\\n    }\\n  }\\n}\\n\\nlet emit_comp_type_section: (Bytes, Array[Array[Int]], Array[Array[String]], Array[Array[Int]], Array[Int]) -> Unit = (buf, sigs_params, sigs_param_names, sigs_results, sigs_async) -> {\\n  let count = Array::length(sigs_params)\\n  if count == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_type)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, count)\\n    let mut i = 0\\n    while i < count {\\n      emit_comp_func_type(content, Array::get(sigs_params, i), Array::get(sigs_param_names, i), Array::get(sigs_results, i), Array::get(sigs_async, i))\\n      i = i + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nlet emit_comp_type_section_run: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, section_type)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  emit_comp_func_type(content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    \\\"\\\"\\n  ], 0, 0), [\\n    comp_valtype_s64\\n  ], 0)\\n  emit_raw_content(buf, content)\\n}\\n\\nlet normalize_comp_export_name: (String) -> String = (name) -> {\\n  comp_underscores_to_dashes(name)\\n}\\n\\nlet emit_comp_export_section: (Bytes, String, Int) -> Unit = (buf, name, func_idx) -> {\\n  let export_name = normalize_comp_export_name(name)\\n  bytebuf_push(buf, section_export)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_name(content, export_name)\\n  bytebuf_push(content, comp_extern_func)\\n  leb128_encode_u32(content, func_idx)\\n  leb128_encode_u32(content, 0)\\n  emit_raw_content(buf, content)\\n}\\n\\nexport let comp_generate_string_trampoline: (Int, Int) -> Bytes = (string_param_count, call_run_init) -> {\\n  let buf = bytebuf_new()\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 97)\\n  bytebuf_push(buf, 115)\\n  bytebuf_push(buf, 109)\\n  bytebuf_push(buf, 1)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n  let body = bytebuf_new()\\n  let type_sec = bytebuf_new()\\n  leb128_encode_u32(type_sec, if call_run_init != 0 {\\n    4\\n  } else {\\n    3\\n  })\\n  bytebuf_push(type_sec, 96)\\n  leb128_encode_u32(type_sec, string_param_count + 1)\\n  let mut ti = 0\\n  while ti < string_param_count {\\n    bytebuf_push(type_sec, 126)\\n    ti = ti + 1\\n  }\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 126)\\n  bytebuf_push(type_sec, 96)\\n  bytebuf_push(type_sec, 4)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 127)\\n  bytebuf_push(type_sec, 96)\\n  leb128_encode_u32(type_sec, string_param_count * 2)\\n  let mut ci = 0\\n  while ci < (string_param_count * 2) {\\n    bytebuf_push(type_sec, 127)\\n    ci = ci + 1\\n  }\\n  bytebuf_push(type_sec, 1)\\n  bytebuf_push(type_sec, 126)\\n  if call_run_init != 0 {\\n    bytebuf_push(type_sec, 96)\\n    leb128_encode_u32(type_sec, 0)\\n    bytebuf_push(type_sec, 1)\\n    bytebuf_push(type_sec, 126)\\n  }\\n  bytebuf_push_section(body, 1, type_sec)\\n  let import_sec = bytebuf_new()\\n  leb128_encode_u32(import_sec, if call_run_init != 0 {\\n    4\\n  } else {\\n    3\\n  })\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"target_func\\\")\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 0)\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"cabi_realloc\\\")\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 1)\\n  if call_run_init != 0 {\\n    emit_name(import_sec, \\\"env\\\")\\n    emit_name(import_sec, \\\"run_init\\\")\\n    bytebuf_push(import_sec, 0)\\n    leb128_encode_u32(import_sec, 3)\\n  }\\n  emit_name(import_sec, \\\"env\\\")\\n  emit_name(import_sec, \\\"memory\\\")\\n  bytebuf_push(import_sec, 2)\\n  bytebuf_push(import_sec, 0)\\n  leb128_encode_u32(import_sec, 0)\\n  bytebuf_push_section(body, 2, import_sec)\\n  let func_sec = bytebuf_new()\\n  leb128_encode_u32(func_sec, 1)\\n  leb128_encode_u32(func_sec, 2)\\n  bytebuf_push_section(body, 3, func_sec)\\n  let export_sec = bytebuf_new()\\n  leb128_encode_u32(export_sec, 1)\\n  emit_name(export_sec, \\\"canon_func\\\")\\n  bytebuf_push(export_sec, 0)\\n  leb128_encode_u32(export_sec, if call_run_init != 0 {\\n    3\\n  } else {\\n    2\\n  })\\n  bytebuf_push_section(body, 7, export_sec)\\n  let code_sec = bytebuf_new()\\n  leb128_encode_u32(code_sec, 1)\\n  let func_body = bytebuf_new()\\n  leb128_encode_u32(func_body, 2)\\n  leb128_encode_u32(func_body, string_param_count)\\n  bytebuf_push(func_body, 126)\\n  leb128_encode_u32(func_body, string_param_count)\\n  bytebuf_push(func_body, 127)\\n  if call_run_init != 0 {\\n    bytebuf_push(func_body, 16)\\n    leb128_encode_u32(func_body, 2)\\n    bytebuf_push(func_body, 26)\\n  }\\n  let tagged_base = string_param_count * 2\\n  let obj_base = tagged_base + string_param_count\\n  let mut si = 0\\n  while si < string_param_count {\\n    let ptr_local = si * 2\\n    let len_local = (si * 2) + 1\\n    let tagged_local = tagged_base + si\\n    let obj_local = obj_base + si\\n    emit_i32_const(func_body, 0)\\n    emit_i32_const(func_body, 0)\\n    emit_i32_const(func_body, 4)\\n    emit_local_get(func_body, len_local)\\n    emit_i32_const(func_body, 8)\\n    emit_i32_add(func_body)\\n    bytebuf_push(func_body, 16)\\n    leb128_encode_u32(func_body, 1)\\n    emit_local_set(func_body, obj_local)\\n    emit_local_get(func_body, obj_local)\\n    emit_i32_const(func_body, 1)\\n    emit_i32_store(func_body, 0, 0)\\n    emit_local_get(func_body, obj_local)\\n    emit_local_get(func_body, len_local)\\n    emit_i32_store(func_body, 0, 4)\\n    emit_local_get(func_body, obj_local)\\n    emit_i32_const(func_body, 8)\\n    emit_i32_add(func_body)\\n    emit_local_get(func_body, ptr_local)\\n    emit_local_get(func_body, len_local)\\n    bytebuf_push(func_body, 252)\\n    leb128_encode_u32(func_body, 10)\\n    bytebuf_push(func_body, 0)\\n    bytebuf_push(func_body, 0)\\n    emit_local_get(func_body, obj_local)\\n    bytebuf_push(func_body, 173)\\n    bytebuf_push(func_body, 66)\\n    leb128_encode_s64(func_body, 1)\\n    bytebuf_push(func_body, 132)\\n    emit_local_set(func_body, tagged_local)\\n    si = si + 1\\n  }\\n  let mut ci2 = 0\\n  while ci2 < string_param_count {\\n    emit_local_get(func_body, tagged_base + ci2)\\n    ci2 = ci2 + 1\\n  }\\n  emit_i32_const(func_body, 0)\\n  bytebuf_push(func_body, 16)\\n  leb128_encode_u32(func_body, 0)\\n  bytebuf_push(func_body, 11)\\n  leb128_encode_u32(code_sec, Bytes::length(func_body))\\n  bytebuf_push_buf(code_sec, func_body)\\n  bytebuf_push_section(body, 10, code_sec)\\n  bytebuf_push_buf(buf, body)\\n  bytebuf_to_bytes(buf)\\n}\\n\\nlet emit_core_instance_from_exports: (Bytes, Int, Array[Int], Array[String], Array[Int]) -> Unit = (buf, num_modules, module_binding_counts, binding_func_names, binding_func_indices) -> {\\n  if num_modules == 0 {\\n    ()\\n  }\\n  else {\\n    bytebuf_push(buf, section_core_instance)\\n    let content = bytebuf_new()\\n    leb128_encode_u32(content, num_modules)\\n    let mut offset = 0\\n    let mut m = 0\\n    while m < num_modules {\\n      let count = Array::get(module_binding_counts, m)\\n      bytebuf_push(content, 1)\\n      leb128_encode_u32(content, count)\\n      let mut b = 0\\n      while b < count {\\n        emit_name(content, Array::get(binding_func_names, offset + b))\\n        bytebuf_push(content, core_sort_func)\\n        leb128_encode_u32(content, Array::get(binding_func_indices, offset + b))\\n        b = b + 1\\n      }\\n      offset = offset + count\\n      m = m + 1\\n    }\\n    emit_raw_content(buf, content)\\n  }\\n}\\n\\nlet emit_core_instance_instantiate_section: (Bytes, Int, Array[String]) -> Unit = (buf, module_index, module_names) -> {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, module_index)\\n  leb128_encode_u32(content, Array::length(module_names))\\n  let mut i = 0\\n  while i < Array::length(module_names) {\\n    emit_name(content, Array::get(module_names, i))\\n    bytebuf_push(content, comp_inst_arg_instance)\\n    leb128_encode_u32(content, i)\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\n\\nexport let comp_emit_component_wasm: (Bytes) -> Bytes = (core_wasm) -> {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_core_instance_instantiate_section(buf, 0, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  emit_alias_run_and_memory(buf, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\nexport let comp_emit_component_wasm_with_lift: (Bytes, String) -> Bytes = (core_wasm, export_name) -> {\\n  let import_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_indices = new_int_array()\\n  let unique_module_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_binding_counts = new_int_array()\\n  let comp_params = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let comp_param_names = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let comp_results = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\\n  let main_instance_idx = Array::length(unique_module_names)\\n  let run_core_func_idx = import_func_count\\n  let run_type_idx = import_func_count\\n  let run_func_idx = import_func_count\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  let async_flags = new_int_array()\\n  let mut af = 0\\n  while af < import_func_count {\\n    Array::push(async_flags, 0)\\n    af = af + 1\\n  }\\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\\n  emit_comp_import_section(buf, import_names, import_func_count)\\n  emit_canon_lower_section(buf, import_func_count)\\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\\n  emit_alias_run_and_memory(buf, main_instance_idx)\\n  emit_comp_type_section_run(buf)\\n  emit_canon_lift_section(buf, run_core_func_idx, run_type_idx)\\n  emit_comp_export_section(buf, export_name, run_func_idx)\\n  bytebuf_to_bytes(buf)\\n}\\n\\nexport let comp_emit_component_wasm_with_string_lift: (Bytes, String, String, Int, Array[String], Int) -> Bytes = (core_wasm, target_func_name, export_name, string_param_count, param_names, is_async) -> {\\n  let import_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let binding_func_indices = new_int_array()\\n  let unique_module_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let module_binding_counts = new_int_array()\\n  let comp_params = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let comp_param_names = Array::slice([\\n    Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  ], 0, 0)\\n  let comp_results = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let export_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let export_func_indices = new_int_array()\\n  let export_type_sigs = Array::slice([\\n    [\\n      0\\n    ]\\n  ], 0, 0)\\n  let import_func_count = build_import_plan(core_wasm, import_names, binding_func_names, binding_func_indices, unique_module_names, module_binding_counts, comp_params, comp_param_names, comp_results)\\n  let _ = parse_core_exports(core_wasm, export_names, export_func_indices, export_type_sigs)\\n  let mut call_run_init = 0\\n  let mut ei = 0\\n  while ei < Array::length(export_names) {\\n    if Array::get(export_names, ei) == \\\"_start\\\" {\\n      call_run_init = 1\\n      ei = Array::length(export_names)\\n    } else {\\n      ei = ei + 1\\n    }\\n  }\\n  let has_distinct_run_alias =\\n  if (call_run_init != 0) && (target_func_name != \\\"_start\\\") {\\n    1\\n  } else {\\n    0\\n  }\\n  let main_instance_idx = Array::length(unique_module_names)\\n  let trampoline_wasm = comp_generate_string_trampoline(string_param_count, call_run_init)\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_core_module_section(buf, trampoline_wasm)\\n  let async_flags = new_int_array()\\n  let mut af = 0\\n  while af < import_func_count {\\n    Array::push(async_flags, 0)\\n    af = af + 1\\n  }\\n  emit_comp_type_section(buf, comp_params, comp_param_names, comp_results, async_flags)\\n  emit_comp_import_section(buf, import_names, import_func_count)\\n  emit_canon_lower_section(buf, import_func_count)\\n  emit_core_instance_from_exports(buf, Array::length(unique_module_names), module_binding_counts, binding_func_names, binding_func_indices)\\n  emit_core_instance_instantiate_section(buf, 0, unique_module_names)\\n  let alias_names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let alias_sorts = new_int_array()\\n  Array::push(alias_names, target_func_name)\\n  Array::push(alias_sorts, core_sort_func)\\n  Array::push(alias_names, \\\"cabi_realloc\\\")\\n  Array::push(alias_sorts, core_sort_func)\\n  if has_distinct_run_alias != 0 {\\n    Array::push(alias_names, \\\"_start\\\")\\n    Array::push(alias_sorts, core_sort_func)\\n  }\\n  Array::push(alias_names, \\\"memory\\\")\\n  Array::push(alias_sorts, core_sort_mem)\\n  emit_alias_section(buf, main_instance_idx, alias_names, alias_sorts)\\n  let target_func_core_idx = import_func_count\\n  let cabi_realloc_core_idx = import_func_count + 1\\n  let run_init_core_idx =\\n  if call_run_init != 0 {\\n    if has_distinct_run_alias != 0 {\\n      import_func_count + 2\\n    } else {\\n      target_func_core_idx\\n    }\\n  } else {\\n    0 - 1\\n  }\\n  bytebuf_push(buf, section_core_instance)\\n  let tramp_env = bytebuf_new()\\n  leb128_encode_u32(tramp_env, 1)\\n  bytebuf_push(tramp_env, 1)\\n  leb128_encode_u32(tramp_env, if call_run_init != 0 {\\n    4\\n  } else {\\n    3\\n  })\\n  emit_name(tramp_env, \\\"target_func\\\")\\n  bytebuf_push(tramp_env, core_sort_func)\\n  leb128_encode_u32(tramp_env, target_func_core_idx)\\n  emit_name(tramp_env, \\\"cabi_realloc\\\")\\n  bytebuf_push(tramp_env, core_sort_func)\\n  leb128_encode_u32(tramp_env, cabi_realloc_core_idx)\\n  if call_run_init != 0 {\\n    emit_name(tramp_env, \\\"run_init\\\")\\n    bytebuf_push(tramp_env, core_sort_func)\\n    leb128_encode_u32(tramp_env, run_init_core_idx)\\n  }\\n  emit_name(tramp_env, \\\"memory\\\")\\n  bytebuf_push(tramp_env, core_sort_mem)\\n  leb128_encode_u32(tramp_env, 0)\\n  emit_raw_content(buf, tramp_env)\\n  let env_instance_idx = main_instance_idx + 1\\n  bytebuf_push(buf, section_core_instance)\\n  let tramp_inst = bytebuf_new()\\n  leb128_encode_u32(tramp_inst, 1)\\n  bytebuf_push(tramp_inst, 0)\\n  leb128_encode_u32(tramp_inst, 1)\\n  leb128_encode_u32(tramp_inst, 1)\\n  emit_name(tramp_inst, \\\"env\\\")\\n  bytebuf_push(tramp_inst, comp_inst_arg_instance)\\n  leb128_encode_u32(tramp_inst, env_instance_idx)\\n  emit_raw_content(buf, tramp_inst)\\n  let trampoline_instance_idx = env_instance_idx + 1\\n  emit_alias_section(buf, trampoline_instance_idx, [\\n    \\\"canon_func\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  let alias_func_count = if has_distinct_run_alias != 0 {\\n    3\\n  } else {\\n    2\\n  }\\n  let canon_func_core_idx = import_func_count + alias_func_count\\n  bytebuf_push(buf, section_type)\\n  let type_content = bytebuf_new()\\n  leb128_encode_u32(type_content, 1)\\n  if is_async != 0 {\\n    bytebuf_push(type_content, 67)\\n  } else {\\n    bytebuf_push(type_content, 64)\\n  }\\n  leb128_encode_u32(type_content, string_param_count)\\n  let mut pi = 0\\n  while pi < string_param_count {\\n    let pname = if pi < Array::length(param_names) {\\n      normalize_comp_param_name(Array::get(param_names, pi))\\n    }\\n    else {\\n      \\\"p\\\\{pi}\\\"\\n    }\\n    emit_name(type_content, pname)\\n    bytebuf_push(type_content, comp_valtype_string)\\n    pi = pi + 1\\n  }\\n  bytebuf_push(type_content, 0)\\n  bytebuf_push(type_content, comp_valtype_s64)\\n  emit_raw_content(buf, type_content)\\n  let component_type_idx = import_func_count\\n  bytebuf_push(buf, section_canon)\\n  let canon_content = bytebuf_new()\\n  leb128_encode_u32(canon_content, 1)\\n  emit_canon_lift_func(canon_content, canon_func_core_idx, component_type_idx, 1, 0, cabi_realloc_core_idx)\\n  emit_raw_content(buf, canon_content)\\n  let lifted_func_idx = import_func_count\\n  emit_comp_export_section(buf, export_name, lifted_func_idx)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// WASI 0.3 async (M1b, docs/spec/wasi-p3-async.md §3.2). The `task.return`\\n// canonical built-in lowers to a core func `(param <result>) -> ()` that\\n// delivers an async-lifted export's result. Encoding verified byte-for-byte\\n// against src/x/cm_async/cm_async_lift_probe.wat (runs on wasmtime 45):\\n// section 0x08, body `01 09 00 <valtype> 00` (count=1; opcode 0x09; result\\n// Some(valtype); empty options).\\nlet emit_canon_task_return: (Bytes, Int) -> Unit = (buf, result_valtype) -> {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 9)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, result_valtype)\\n  bytebuf_push(content, 0)\\n  emit_raw_content(buf, content)\\n}\\n\\n// Async (callback-less / stackful) `canon lift`. Unlike emit_canon_lift_func it\\n// carries the async canonopt (0x06). Verified body: `01 00 00 <core_func_idx>\\n// 01 06 <type_idx>` (count=1; lift; core-func sort; idx; 1 option = async).\\nlet emit_canon_lift_async_section: (Bytes, Int, Int) -> Unit = (buf, core_func_idx, type_idx) -> {\\n  bytebuf_push(buf, section_canon)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, core_func_idx)\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 6)\\n  leb128_encode_u32(content, type_idx)\\n  emit_raw_content(buf, content)\\n}\\n\\n// Component type section with a single async func type `() -> <result>`.\\n// Verified body: `01 43 00 00 <valtype>` (count=1; async functype opcode 0x43;\\n// 0 params; result-form 0x00 + valtype).\\nlet emit_comp_async_functype_section: (Bytes, Int) -> Unit = (buf, result_valtype) -> {\\n  bytebuf_push(buf, section_type)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 67)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, 0)\\n  bytebuf_push(content, result_valtype)\\n  emit_raw_content(buf, content)\\n}\\n\\n// Wrap a core module that imports (\\\"cm\\\",\\\"task-return\\\") and exports a void `run`\\n// into an async-lifted component export. Section order mirrors\\n// cm_async_lift_probe.wat (verified to run on wasmtime 45 with\\n// -W concurrency-support=y component-model-async=y component-model-async-stackful=y).\\n// `result_valtype` is the component valtype of the lifted result (e.g.\\n// comp_valtype_s64 for vibe Int).\\nexport let comp_emit_component_wasm_async: (Bytes, String, Int) -> Bytes = (core_wasm, export_name, result_valtype) -> {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, core_wasm)\\n  emit_canon_task_return(buf, result_valtype)\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"task-return\\\"\\n  ], [\\n    0\\n  ])\\n  emit_core_instance_instantiate_section(buf, 0, [\\n    \\\"cm\\\"\\n  ])\\n  emit_comp_async_functype_section(buf, result_valtype)\\n  emit_alias_section(buf, 1, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_canon_lift_async_section(buf, 1, 0)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// Map a component valtype to the core valtype it lowers from (inverse of\\n// core_to_comp_valtype). Used to type the trampoline module's entry/task-return.\\nlet comp_valtype_to_core: (Int) -> Int = (v) -> {\\n  if v == comp_valtype_s64 {\\n    126\\n  }\\n  else {\\n    if v == comp_valtype_s32 {\\n      127\\n    }\\n    else {\\n      if v == comp_valtype_f32 {\\n        125\\n      }\\n      else {\\n        if v == comp_valtype_f64 {\\n          124\\n        }\\n        else {\\n          127\\n        }\\n      }\\n    }\\n  }\\n}\\n\\n// M1b-2 (docs/spec/wasi-p3-async.md §3.4). Async trampoline core module: imports\\n// the normally-compiled entry (\\\"main\\\",\\\"run\\\" : () -> <core_valtype>) and\\n// (\\\"cm\\\",\\\"task-return\\\" : (<core_valtype>) -> ()), and exports a void `run` that\\n// calls the entry and forwards its result to task.return. Byte template verified\\n// against src/x/cm_async/cm_async_trampoline_probe.wat (runs on wasmtime 45).\\nlet comp_generate_async_trampoline: (Int) -> Bytes = (core_valtype) -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let tc = bytebuf_new()\\n  bytebuf_push_vec_header(tc, 3)\\n  // type0: the entry `run` — a nullary vibe fn compiles to (param i64) -> result\\n  // (the i64 is the unit argument), so the trampoline passes a dummy i64.\\n  emit_func_type_raw(tc, [\\n    126\\n  ], [\\n    core_valtype\\n  ])\\n  emit_func_type_raw(tc, [\\n    core_valtype\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(tc, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, 1, tc)\\n  let ic = bytebuf_new()\\n  bytebuf_push_vec_header(ic, 2)\\n  emit_name(ic, \\\"main\\\")\\n  emit_name(ic, \\\"run\\\")\\n  bytebuf_push(ic, 0)\\n  bytebuf_push(ic, 0)\\n  emit_name(ic, \\\"cm\\\")\\n  emit_name(ic, \\\"task-return\\\")\\n  bytebuf_push(ic, 0)\\n  bytebuf_push(ic, 1)\\n  bytebuf_push_section(out, 2, ic)\\n  emit_function_section(out, [\\n    2\\n  ])\\n  emit_export_section(out, \\\"run\\\", 2)\\n  let body = bytebuf_new()\\n  emit_i64_const(body, 0)\\n  bytebuf_push(body, 16)\\n  leb128_encode_u32(body, 0)\\n  bytebuf_push(body, 16)\\n  leb128_encode_u32(body, 1)\\n  emit_code_section(out, [\\n    body\\n  ])\\n  bytebuf_to_bytes(out)\\n}\\n\\n// Instantiate a core module with explicit (arg-name -> core-instance-index) args.\\n// Unlike emit_core_instance_instantiate_section, the arg instance indices need\\n// not be sequential.\\nlet emit_core_instance_instantiate_args: (Bytes, Int, Array[String], Array[Int]) -> Unit = (buf, module_index, arg_names, arg_instance_indices) -> {\\n  bytebuf_push(buf, section_core_instance)\\n  let content = bytebuf_new()\\n  leb128_encode_u32(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, module_index)\\n  leb128_encode_u32(content, Array::length(arg_names))\\n  let mut i = 0\\n  while i < Array::length(arg_names) {\\n    emit_name(content, Array::get(arg_names, i))\\n    bytebuf_push(content, comp_inst_arg_instance)\\n    leb128_encode_u32(content, Array::get(arg_instance_indices, i))\\n    i = i + 1\\n  }\\n  emit_raw_content(buf, content)\\n}\\n\\n// Wrap a normally-compiled core module (exporting `run : () -> <core>`, value\\n// returned directly) into an async-lifted component export via the trampoline\\n// (two-module) approach — no change to the core module / linked_compile needed.\\n// `comp_result_valtype` is the component valtype of the lifted result\\n// (comp_valtype_s64 for vibe Int). Section order mirrors\\n// cm_async_trampoline_probe.wat (verified to run on wasmtime 45).\\nexport let comp_emit_component_wasm_async_trampolined: (Bytes, String, Int) -> Bytes = (main_core_wasm, export_name, comp_result_valtype) -> {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, main_core_wasm)\\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\\n  emit_core_instance_instantiate_section(buf, 0, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  emit_canon_task_return(buf, comp_result_valtype)\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"task-return\\\"\\n  ], [\\n    0\\n  ])\\n  emit_alias_section(buf, 0, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"run\\\"\\n  ], [\\n    1\\n  ])\\n  emit_core_instance_instantiate_args(buf, 1, [\\n    \\\"main\\\",\\n    \\\"cm\\\"\\n  ], [\\n    2,\\n    1\\n  ])\\n  emit_comp_async_functype_section(buf, comp_result_valtype)\\n  emit_alias_section(buf, 3, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_canon_lift_async_section(buf, 2, 0)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\\n// M1b-2d: a no-op `wasi_snapshot_preview1.fd_write` stub core module\\n// (`(i32,i32,i32,i32) -> i32` returning 0). selfhost-compiled core modules\\n// import fd_write from wasi_snapshot_preview1 for their runtime preamble; the\\n// stub satisfies that import so the async component is self-contained and\\n// instantiable without an external preview1 adapter.\\nlet comp_generate_wasi_fd_write_stub: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let tc = bytebuf_new()\\n  bytebuf_push_vec_header(tc, 1)\\n  emit_func_type_raw(tc, [\\n    127,\\n    127,\\n    127,\\n    127\\n  ], [\\n    127\\n  ])\\n  bytebuf_push_section(out, 1, tc)\\n  emit_function_section(out, [\\n    0\\n  ])\\n  emit_export_section(out, \\\"fd_write\\\", 0)\\n  let body = bytebuf_new()\\n  emit_i32_const(body, 0)\\n  emit_code_section(out, [\\n    body\\n  ])\\n  bytebuf_to_bytes(out)\\n}\\n\\n// Like comp_emit_component_wasm_async_trampolined, but for a main core module\\n// that imports `wasi_snapshot_preview1.fd_write` (every selfhost core does). A\\n// fd_write stub module is instantiated first and supplied to the main module's\\n// instantiation, making the async component fully self-contained / runnable.\\n// core instances: 0=wasi-stub, 1=main(+wasi), 2=cm(task-return), 3=env(run),\\n// 4=trampoline. core funcs: 0=task.return, 1=main.run, 2=trampoline.run.\\nexport let comp_emit_component_wasm_async_trampolined_p1: (Bytes, String, Int) -> Bytes = (main_core_wasm, export_name, comp_result_valtype) -> {\\n  let buf = bytebuf_new()\\n  emit_component_header(buf)\\n  emit_core_module_section(buf, main_core_wasm)\\n  emit_core_module_section(buf, comp_generate_async_trampoline(comp_valtype_to_core(comp_result_valtype)))\\n  emit_core_module_section(buf, comp_generate_wasi_fd_write_stub())\\n  emit_core_instance_instantiate_section(buf, 2, Array::slice([\\n    \\\"\\\"\\n  ], 0, 0))\\n  emit_core_instance_instantiate_args(buf, 0, [\\n    \\\"wasi_snapshot_preview1\\\"\\n  ], [\\n    0\\n  ])\\n  emit_canon_task_return(buf, comp_result_valtype)\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"task-return\\\"\\n  ], [\\n    0\\n  ])\\n  emit_alias_section(buf, 1, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_core_instance_from_exports(buf, 1, [\\n    1\\n  ], [\\n    \\\"run\\\"\\n  ], [\\n    1\\n  ])\\n  emit_core_instance_instantiate_args(buf, 1, [\\n    \\\"main\\\",\\n    \\\"cm\\\"\\n  ], [\\n    3,\\n    2\\n  ])\\n  emit_comp_async_functype_section(buf, comp_result_valtype)\\n  emit_alias_section(buf, 4, [\\n    \\\"run\\\"\\n  ], [\\n    core_sort_func\\n  ])\\n  emit_canon_lift_async_section(buf, 2, 0)\\n  emit_comp_export_section(buf, export_name, 0)\\n  bytebuf_to_bytes(buf)\\n}\\n\")\n}\n\nlet cli_adapter_source_83 = () -> (String, String) {\n  (\"vibe/compiler/codegen/builtin_bodies/bodies_core_a1a1_eq.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_gt_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassi