let selfhost_source_70 = () -> (String, String) {
  ("vibe/compiler/codegen/expr/compile_match.vibe",
"\n\n\n\n\n\n\n\nlet emit_rc_dup_guarded_n: (Bytes, Int, Int, Bool) -> Unit = (buf, local_idx, n, rc_shadow) -> {\n  let mut k = 0\n  while k < n {\n    emit_rc_dup_guarded(buf, local_idx, rc_shadow)\n    k = k + 1\n  }\n}\n\nlet rec bind_match_pat: (Bytes, Int, Pat, Bool, Array[String], CompileCtx, Expr) -> Unit = (buf, base_local, container_pat, is_ctor_layout, local_names, ctx, body) -> {\n  let elems = if is_ctor_layout {\n    get_pctor_args(container_pat)\n  } else {\n    get_ptuple_pats(container_pat)\n  }\n  let mut i = 0\n  while i < Array::length(elems) {\n    let ep = Array::get(elems, i)\n    let off = if is_ctor_layout {\n      8 + i * 8\n    } else if ctx.enable_rc {\n      8 + i * 8\n    } else {\n      i * 8\n    }\n    let clear_tag = is_ctor_layout || ctx.enable_rc\n    if is_pbind(ep) {\n      let nm = get_pbind_name(ep)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, false, local_names, ctx, body)\n    } else if is_pctor(ep) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      if clear_tag {\n        emit_i64_const(buf, -2)\n        emit_i64_and(buf)\n      } else {\n        ()\n      }\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, ep, true, local_names, ctx, body)\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n}\n\nlet find_struct_index: (CompileCtx, String) -> Int = (ctx, sname) -> {\n  let names = ctx.ctor_table.struct_names\n  let mut si = 0\n  let mut sidx = -1\n  while si < Array::length(names) {\n    if Array::get(names, si) == sname {\n      sidx = si\n      si = Array::length(names)\n    } else {\n      si = si + 1\n    }\n  }\n  sidx\n}\n\nlet field_index_in: (Array[String], String) -> Int = (fnames, field) -> {\n  let mut fi = 0\n  let mut found = -1\n  while fi < Array::length(fnames) {\n    if Array::get(fnames, fi) == field {\n      found = fi\n      fi = Array::length(fnames)\n    } else {\n      fi = fi + 1\n    }\n  }\n  found\n}\n\nlet struct_field_index: (CompileCtx, String, String) -> Int with { Error } = (ctx, sname, field) -> {\n  let sidx = find_struct_index(ctx, sname)\n  if sidx >= 0 {\n    let found = field_index_in(Array::get(ctx.ctor_table.struct_field_names, sidx), field)\n    if found < 0 {\n      throw(String::concat(String::concat(String::concat(\"unknown field `\", field), \"` in struct \"), sname))\n    } else {\n      found\n    }\n  } else {\n    let names = ctx.ctor_table.struct_names\n    let mut gsi = 0\n    let mut gfound = -1\n    while gsi < Array::length(names) {\n      let f = field_index_in(Array::get(ctx.ctor_table.struct_field_names, gsi), field)\n      if f >= 0 {\n        gfound = f\n        gsi = Array::length(names)\n      } else {\n        gsi = gsi + 1\n      }\n    }\n    if gfound < 0 {\n      throw(String::concat(\"unknown struct field in pattern: \", field))\n    } else {\n      gfound\n    }\n  }\n}\n\nlet rec bind_struct_pat: (Bytes, Int, String, Array[(String, Pat)], Array[String], CompileCtx, Expr) -> Unit with { Error } = (buf, base_local, sname, fields, local_names, ctx, body) -> {\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, subpat) = Array::get(fields, i)\n    let off = 8 + struct_field_index(ctx, sname, fname) * 8\n    if is_pbind(subpat) {\n      let nm = get_pbind_name(subpat)\n      let fl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, fl)\n      if ctx.enable_rc {\n        emit_rc_dup_guarded_n(buf, fl, md_consume_count(body, nm), ctx.rc_shadow)\n      } else {\n        ()\n      }\n      Array::push(local_names, nm)\n    } else if is_ptuple(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, false, local_names, ctx, body)\n    } else if is_pctor(subpat) {\n      let sl = Array::length(local_names)\n      emit_local_get(buf, base_local)\n      emit_i64_const(buf, -2)\n      emit_i64_and(buf)\n      emit_i32_wrap_i64(buf)\n      emit_i64_load(buf, 3, off)\n      emit_local_set(buf, sl)\n      Array::push(local_names, \"__bind_sub\")\n      bind_match_pat(buf, sl, subpat, true, local_names, ctx, body)\n    } else {\n      match subpat {\n        PStruct(__sname, sfields) => {\n          let sl = Array::length(local_names)\n          emit_local_get(buf, base_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, off)\n          emit_local_set(buf, sl)\n          Array::push(local_names, \"__bind_sub\")\n          bind_struct_pat(buf, sl, __sname, sfields, local_names, ctx, body)\n        },\n        _ => ()\n      }\n    }\n    i = i + 1\n  }\n}\n\nexport let compile_match: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, ce) -> {\n  let __match_scrutinee = get_match_scrutinee(expr)\n  let __match_arms = get_match_arms(expr)\n  let scrut_local = next_local\n  Array::push(local_names, \"__match_scrut\")\n  let nl1 = ce(buf, __match_scrutinee, local_names, next_local + 1, ctx, ld)\n  emit_local_set(buf, scrut_local)\n  let num_arms = Array::length(__match_arms)\n  let catchall_idx = find_catchall_idx(__match_arms)\n  let num_cond_arms = catchall_idx\n  let mut ai = 0\n  let mut max_nl = nl1\n  let names_len_at_match = Array::length(local_names)\n  let rec emit_pat_test: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    match sp {\n      POr(__l, __r) => {\n        emit_pat_test(__l, load_field)\n        emit_pat_test(__r, load_field)\n        bytebuf_push(buf, 114)\n      },\n      _ => {\n        if is_pint(sp) {\n          load_field()\n          emit_i64_const(buf, get_pint_value(sp))\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pbool(sp) {\n          load_field()\n          emit_i64_const(buf, if get_pbool_value(sp) {\n            1\n          } else {\n            0\n          })\n          if ctx.enable_rc {\n            emit_i64_const(buf, 1)\n            emit_i64_shl(buf)\n          }\n          emit_i64_eq(buf)\n        } else if is_pstring(sp) {\n          let __sv = get_pstring_value(sp)\n          let __si = str_table_lookup(ctx.str_table.strs, __sv)\n          if __si >= 0 {\n            let (__seq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n            load_field()\n            emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n            emit_call(buf, __seq_fi)\n            emit_i32_wrap_i64(buf)\n          } else {\n            emit_i32_const(buf, 1)\n          }\n        } else if is_pctor(sp) {\n          let __ncname = get_pctor_name(sp)\n          let __nci = lookup_ctor(ctx.ctor_table.names, __ncname, 0)\n          let __ntag = if __nci >= 0 {\n            Array::get(ctx.ctor_table.tags, __nci)\n          } else {\n            -1\n          }\n          load_field()\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, __ntag)\n          emit_i32_eq(buf)\n          let __nargs = get_pctor_args(sp)\n          let mut __nany = false\n          let mut __nj = 0\n          while __nj < Array::length(__nargs) {\n            let __np = Array::get(__nargs, __nj)\n            if is_pbind(__np) || is_pwild(__np) {\n              ()\n            } else {\n              __nany = true\n            }\n            __nj = __nj + 1\n          }\n          if __nany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __nk = 0\n            while __nk < Array::length(__nargs) {\n              let __nkk = __nk\n              let __np2 = Array::get(__nargs, __nkk)\n              if is_pbind(__np2) || is_pwild(__np2) {\n                ()\n              } else {\n                let __nload: () -> Unit = () -> {\n                  load_field()\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i64_load(buf, 3, 8 + __nkk * 8)\n                }\n                emit_pat_test(__np2, __nload)\n                bytebuf_push(buf, 113)\n              }\n              __nk = __nk + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n        } else if is_ptuple(sp) {\n          emit_i32_const(buf, 1)\n          let __tpats = get_ptuple_pats(sp)\n          let mut __tk = 0\n          while __tk < Array::length(__tpats) {\n            let __tkk = __tk\n            let __tload: () -> Unit = () -> {\n              load_field()\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc {\n                8 + __tkk * 8\n              } else {\n                __tkk * 8\n              })\n            }\n            emit_pat_test(Array::get(__tpats, __tkk), __tload)\n            bytebuf_push(buf, 113)\n            __tk = __tk + 1\n          }\n        } else {\n          emit_i32_const(buf, 1)\n        }\n      }\n    }\n  }\n  let emit_sub_tests: (Pat, () -> Unit) -> Unit = (sp, load_field) -> {\n    if is_pbind(sp) || is_pwild(sp) {\n      ()\n    } else {\n      emit_pat_test(sp, load_field)\n      bytebuf_push(buf, 113)\n    }\n  }\n  while ai < num_cond_arms {\n    Array::truncate(local_names, names_len_at_match)\n    int_log_reset_above(ctx, names_len_at_match)\n    let (__cond_p, __arm_body) = Array::get(__match_arms, ai)\n    let __cond_done = if is_pint(__cond_p) {\n      emit_local_get(buf, scrut_local)\n      emit_i64_const(buf, get_pint_value(__cond_p))\n      if ctx.enable_rc {\n        emit_i64_const(buf, 1)\n        emit_i64_shl(buf)\n      }\n      emit_i64_eq(buf)\n      emit_if_i64(buf)\n      0\n    } else {\n      if is_pbool(__cond_p) {\n        emit_local_get(buf, scrut_local)\n        emit_i64_const(buf, if get_pbool_value(__cond_p) {\n          if ctx.enable_rc { 2 } else { 1 }\n        } else {\n          0\n        })\n        emit_i64_eq(buf)\n        emit_if_i64(buf)\n        0\n      } else {\n        if is_pctor(__cond_p) {\n          let cname_cond = get_pctor_name(__cond_p)\n          let ctor_ci = lookup_ctor(ctx.ctor_table.names, cname_cond, 0)\n          let expected_tag = if ctor_ci >= 0 {\n            Array::get(ctx.ctor_table.tags, ctor_ci)\n          } else {\n            -1\n          }\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i32_load(buf, 2, 0)\n          emit_i32_const(buf, expected_tag)\n          emit_i32_eq(buf)\n          let __cargs_cond = get_pctor_args(__cond_p)\n          let mut __cany = false\n          let mut __cj = 0\n          while __cj < Array::length(__cargs_cond) {\n            let __cp = Array::get(__cargs_cond, __cj)\n            if is_pbind(__cp) || is_pwild(__cp) {\n              ()\n            } else {\n              __cany = true\n            }\n            __cj = __cj + 1\n          }\n          if __cany {\n            bytebuf_push(buf, 4)\n            bytebuf_push(buf, 127)\n            emit_i32_const(buf, 1)\n            let mut __ck = 0\n            while __ck < Array::length(__cargs_cond) {\n              let __ckk = __ck\n              let __cload: () -> Unit = () -> {\n                emit_local_get(buf, scrut_local)\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, 8 + __ckk * 8)\n              }\n              emit_sub_tests(Array::get(__cargs_cond, __ckk), __cload)\n              __ck = __ck + 1\n            }\n            emit_else(buf)\n            emit_i32_const(buf, 0)\n            emit_end(buf)\n          } else {\n            ()\n          }\n          emit_if_i64(buf)\n          0\n        } else {\n          if is_pstring(__cond_p) {\n            let sval = get_pstring_value(__cond_p)\n            let str_idx = str_table_lookup(ctx.str_table.strs, sval)\n            if str_idx >= 0 {\n              let (str_eq_fi, _, _) = resolve_func(ctx.func_table, \"eq\")\n              emit_local_get(buf, scrut_local)\n              emit_str_ref(buf, Array::get(ctx.str_table.offsets, str_idx), Array::get(ctx.str_table.lengths, str_idx))\n              emit_call(buf, str_eq_fi)\n              emit_i32_wrap_i64(buf)\n              emit_if_i64(buf)\n            }\n            0\n          } else if is_ptuple(__cond_p) {\n            emit_i32_const(buf, 1)\n            let __tpats_cond = get_ptuple_pats(__cond_p)\n            let mut __tck = 0\n            while __tck < Array::length(__tpats_cond) {\n              let __tckk = __tck\n              let __tcload: () -> Unit = () -> {\n                emit_local_get(buf, scrut_local)\n                if ctx.enable_rc {\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                } else {\n                  ()\n                }\n                emit_i32_wrap_i64(buf)\n                emit_i64_load(buf, 3, if ctx.enable_rc {\n                  8 + __tckk * 8\n                } else {\n                  __tckk * 8\n                })\n              }\n              emit_sub_tests(Array::get(__tpats_cond, __tckk), __tcload)\n              __tck = __tck + 1\n            }\n            emit_if_i64(buf)\n            0\n          } else {\n            let rec emit_or_check: (Pat) -> Unit = (pat) -> {\n              match pat {\n                POr(left, right) => {\n                  emit_or_check(left)\n                  emit_or_check(right)\n                  bytebuf_push(buf, 114)\n                },\n                PInt(n) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, n)\n                  if ctx.enable_rc {\n                    emit_i64_const(buf, 1)\n                    emit_i64_shl(buf)\n                  }\n                  emit_i64_eq(buf)\n                },\n                PCtor(cname, cargs) => {\n                  let ci = lookup_ctor(ctx.ctor_table.names, cname, 0)\n                  let ctag = if ci >= 0 {\n                    Array::get(ctx.ctor_table.tags, ci)\n                  } else {\n                    -1\n                  }\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, -2)\n                  emit_i64_and(buf)\n                  emit_i32_wrap_i64(buf)\n                  emit_i32_load(buf, 2, 0)\n                  emit_i32_const(buf, ctag)\n                  emit_i32_eq(buf)\n                  if Array::length(cargs) == 1 {\n                    match Array::get(cargs, 0) {\n                      PInt(n) => {\n                        emit_local_get(buf, scrut_local)\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                        emit_i32_wrap_i64(buf)\n                        emit_i64_load(buf, 3, 8)\n                        emit_i64_const(buf, n)\n                        if ctx.enable_rc {\n                          emit_i64_const(buf, 1)\n                          emit_i64_shl(buf)\n                        }\n                        emit_i64_eq(buf)\n                        bytebuf_push(buf, 113)\n                      },\n                      _ => ()\n                    }\n                  }\n                },\n                PBool(b) => {\n                  emit_local_get(buf, scrut_local)\n                  emit_i64_const(buf, if b {\n                    if ctx.enable_rc { 2 } else { 1 }\n                  } else {\n                    0\n                  })\n                  emit_i64_eq(buf)\n                },\n                PString(sv) => {\n                  let __si = str_table_lookup(ctx.str_table.strs, sv)\n                  if __si >= 0 {\n                    let (__eqfi, _, _) = resolve_func(ctx.func_table, \"eq\")\n                    emit_local_get(buf, scrut_local)\n                    emit_str_ref(buf, Array::get(ctx.str_table.offsets, __si), Array::get(ctx.str_table.lengths, __si))\n                    emit_call(buf, __eqfi)\n                    emit_i32_wrap_i64(buf)\n                  } else {\n                    emit_i32_const(buf, 1)\n                  }\n                },\n                PTuple(tpats) => {\n                  emit_i32_const(buf, 1)\n                  let mut __ok = 0\n                  while __ok < Array::length(tpats) {\n                    let __okk = __ok\n                    let __oload: () -> Unit = () -> {\n                      emit_local_get(buf, scrut_local)\n                      if ctx.enable_rc {\n                        emit_i64_const(buf, -2)\n                        emit_i64_and(buf)\n                      } else {\n                        ()\n                      }\n                      emit_i32_wrap_i64(buf)\n                      emit_i64_load(buf, 3, if ctx.enable_rc {\n                        8 + __okk * 8\n                      } else {\n                        __okk * 8\n                      })\n                    }\n                    emit_sub_tests(Array::get(tpats, __okk), __oload)\n                    __ok = __ok + 1\n                  }\n                },\n                _ => emit_i32_const(buf, 1)\n              }\n            }\n            emit_or_check(__cond_p)\n            emit_if_i64(buf)\n            0\n          }\n        }\n      }\n    }\n    cov_emit_branch(buf, ctx.cov)\n    let ld_arm = if ld >= 0 {\n      ld + ai + 1\n    } else {\n      -1\n    }\n    let arm_nl = if is_pctor(__cond_p) {\n      let cargs_bind = get_pctor_args(__cond_p)\n      let mut cbi = 0\n      while cbi < Array::length(cargs_bind) {\n        let __sub_p = Array::get(cargs_bind, cbi)\n        if is_pbind(__sub_p) {\n          let pname = get_pbind_name(__sub_p)\n          let fl = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, fl)\n          if ctx.enable_rc {\n            emit_rc_dup_guarded_n(buf, fl, md_consume_count(__arm_body, pname), ctx.rc_shadow)\n          } else {\n            ()\n          }\n          Array::push(local_names, pname)\n        } else if is_ptuple(__sub_p) {\n          let tpats = get_ptuple_pats(__sub_p)\n          let tup_local = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, tup_local)\n          Array::push(local_names, \"__ctor_tup\")\n          let mut ti = 0\n          while ti < Array::length(tpats) {\n            let tp = Array::get(tpats, ti)\n            if is_pbind(tp) {\n              let tpname = get_pbind_name(tp)\n              let tfl = Array::length(local_names)\n              emit_local_get(buf, tup_local)\n              if ctx.enable_rc {\n                emit_i64_const(buf, -2)\n                emit_i64_and(buf)\n              }\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, if ctx.enable_rc { 8 + ti * 8 } else { ti * 8 })\n              emit_local_set(buf, tfl)\n              if ctx.enable_rc {\n                emit_rc_dup_guarded_n(buf, tfl, md_consume_count(__arm_body, tpname), ctx.rc_shadow)\n              } else {\n                ()\n              }\n              Array::push(local_names, tpname)\n            }\n            ti = ti + 1\n          }\n        } else if is_pctor(__sub_p) {\n          let __nargs = get_pctor_args(__sub_p)\n          let __ntmp = Array::length(local_names)\n          emit_local_get(buf, scrut_local)\n          emit_i64_const(buf, -2)\n          emit_i64_and(buf)\n          emit_i32_wrap_i64(buf)\n          emit_i64_load(buf, 3, 8 + cbi * 8)\n          emit_local_set(buf, __ntmp)\n          Array::push(local_names, \"__ctor_nested\")\n          let mut __nj = 0\n          while __nj < Array::length(__nargs) {\n            let __np = Array::get(__nargs, __nj)\n            if is_pbind(__np) {\n              let __npname = get_pbind_name(__np)\n              let __nfl = Array::length(local_names)\n              emit_local_get(buf, __ntmp)\n              emit_i64_const(buf, -2)\n              emit_i64_and(buf)\n              emit_i32_wrap_i64(buf)\n              emit_i64_load(buf, 3, 8 + __nj * 8)\n              emit_local_set(buf, __nfl)\n              if ctx.enable_rc {\n                emit_rc_dup_guarded_n(buf, __nfl, md_consume_count(__arm_body, __npname), ctx.rc_shadow)\n              } else {\n                ()\n              }\n              Array::push(local_names, __npname)\n            }\n            __nj = __nj + 1\n          }\n        }\n        cbi = cbi + 1\n      }\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else if is_ptuple(__cond_p) {\n      let tup_ptr = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, tup_ptr)\n      Array::push(local_names, \"__cond_tup\")\n      bind_match_pat(buf, tup_ptr, __cond_p, false, local_names, ctx, __arm_body)\n      ce(buf, __arm_body, local_names, Array::length(local_names), ctx, ld_arm)\n    } else {\n      ce(buf, __arm_body, local_names, nl1, ctx, ld_arm)\n    }\n    if arm_nl > max_nl {\n      max_nl = arm_nl\n    }\n    emit_else(buf)\n    ai = ai + 1\n  }\n  Array::truncate(local_names, names_len_at_match)\n  int_log_reset_above(ctx, names_len_at_match)\n  let ld_catch = if ld >= 0 {\n    ld + num_cond_arms\n  } else {\n    -1\n  }\n  let catch_nl = if catchall_idx < num_arms {\n    let __catch_arm = Array::get(__match_arms, catchall_idx)\n    let (__catch_p, __catch_body) = __catch_arm\n    0\n    if num_cond_arms > 0 {\n      cov_emit_branch(buf, ctx.cov)\n    } else {\n      ()\n    }\n    if is_pbind(__catch_p) {\n      let bname = get_pbind_name(__catch_p)\n      let bind_local = Array::length(local_names)\n      emit_local_get(buf, scrut_local)\n      emit_local_set(buf, bind_local)\n      Array::push(local_names, bname)\n      ce