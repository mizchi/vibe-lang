let selfhost_source_135 = () -> (String, String) {
  ("vibe/compiler/cache/persistent_cache.vibe",
"\n\n\nexport let compact_string_fingerprint: (String) -> String = (source) -> {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(__to_string(len), String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2)))))\n}\n\nlet persistent_cache_version_tag: () -> String = () -> {\n  String::concat(\"v11|cg-\", selfhost_codegen_fingerprint())\n}\n\nlet stable_cache_path: (String, String, String) -> String = (prefix, seed, suffix) -> {\n  let raw = compact_string_fingerprint(String::concat(\"persistent-cache-\", String::concat(persistent_cache_version_tag(), String::concat(\"|\", seed))))\n  let token_sb = StringBuilder::new()\n  let mut i = 0\n  while i < String::length(raw) {\n    let c = String::char_code_at(raw, i)\n    let piece = if c == 58 {\n      \"_\"\n    } else {\n      String::from_char_code(c)\n    }\n    StringBuilder::push(token_sb, piece)\n    i = i + 1\n  }\n  let token = StringBuilder::freeze(token_sb)\n  String::concat(\"_build/vibe_\", String::concat(prefix, String::concat(\"_\", String::concat(token, suffix))))\n}\n\nlet build_sources_fingerprint: (Array[(String, String)]) -> String = (sources) -> {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(acc, String::concat(\"|\", compact_string_fingerprint(source)))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let persistent_artifact_cache_path: (String, String, String) -> String = (kind, entry_name, fingerprint) -> {\n  stable_cache_path(\"selfhost_artifact\", String::concat(kind, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", fingerprint)))), \".bin\")\n}\n\nexport let store_persistent_artifact: (String, String, String, Bytes) -> Unit with { Error, Fs } = (kind, entry_name, fingerprint, bytes) -> {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  Fs::write_bytes(path, bytes)\n}\n\nexport let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  stable_cache_path(\"selfhost_dep_list\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nexport let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {\n  stable_cache_path(\"selfhost_type_env_v2\", fingerprint, \".tsv\")\n}\n\nexport let build_source_groups_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, i)\n    let fingerprint = build_sources_fingerprint(sources)\n    let next = String::concat(acc, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let normalize_persistent_cache_text: (String) -> String = (text) -> {\n  let len = String::length(text)\n  let mut start = 0\n  while start < len && String::char_code_at(text, start) == 0 {\n    start = start + 1\n  }\n  if start == 0 {\n    text\n  } else {\n    text[start: len]\n  }\n}\n\nexport let load_persistent_artifact: (String, String, String) -> Option[Bytes] with { Error, Fs } = (kind, entry_name, fingerprint) -> {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    Some(Fs::read_bytes(path))\n  }\n}\n\nexport let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {\n  stable_cache_path(\"selfhost_source_list\", entry_path, \".tsv\")\n}\n\nexport let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {\n  stable_cache_path(\"selfhost_source_groups\", entry_path, \".tsv\")\n}\n\nexport let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  stable_cache_path(\"selfhost_module_header_v2\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nexport let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {\n  stable_cache_path(\"selfhost_manifest_headers\", entry_path, \".tsv\")\n}\n\nexport let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\n  stable_cache_path(\"selfhost_leaf_fp_v2\", String::concat(path, String::concat(\"|\", source_fingerprint)), \".tsv\")\n}\n\nlet build_sources_fingerprint_from_compact_fingerprints: (Array[String]) -> String = (source_fingerprints) -> {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(source_fingerprints) {\n    let next = String::concat(acc, String::concat(\"|\", Array::get(source_fingerprints, i)))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_source_groups_fingerprint_from_compact_fingerprints: (Array[(String, Array[(String, String)])]) -> String = (groups) -> {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, specs) = Array::get(groups, i)\n    let source_fingerprints = Array::slice([\n      \"\"\n    ], 0, 0)\n    let mut j = 0\n    while j < Array::length(specs) {\n      let (_, source_fingerprint) = Array::get(specs, j)\n      Array::push(source_fingerprints, source_fingerprint)\n      j = j + 1\n    }\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)\n    let next = String::concat(acc, String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint))))\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String) -> String = (source_groups_fingerprint, entry_name) -> {\n  compact_string_fingerprint(String::concat(\"fs-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", entry_name))))\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String) -> String = (source_groups, entry_name) -> {\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name)\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint: (String, String, String) -> String = (source_groups_fingerprint, entry_name, mode) -> {\n  compact_string_fingerprint(String::concat(\"file-compile|\", String::concat(source_groups_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))))\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint: (Array[(String, Array[(String, String)])], String, String) -> String = (source_groups, entry_name, mode) -> {\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups), entry_name, mode)\n}\n\nexport let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {\n  compact_string_fingerprint(String::concat(\"fs-compile-module|\", source_groups_fingerprint))\n}\n\nexport let build_fs_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\n}\n\nexport let build_file_compile_module_artifact_fingerprint_from_group_fingerprint: (String) -> String = (source_groups_fingerprint) -> {\n  compact_string_fingerprint(String::concat(\"file-compile-module|\", source_groups_fingerprint))\n}\n\nexport let build_file_compile_module_artifact_fingerprint: (Array[(String, Array[(String, String)])]) -> String = (source_groups) -> {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(build_source_groups_fingerprint(source_groups))\n}\n")
}

let selfhost_source_136 = () -> (String, String) {
  ("vibe/compiler/module_graph_path.vibe",
"\nexport let dir_of_path: (String) -> String = (file_path) -> {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else if idx == 0 {\n    \"/\"\n  } else {\n    file_path[0: idx]\n  }\n}\n\nexport let contains_name: (Array[String], String) -> Bool = (items, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(items) && !found {\n    if Array::get(items, i) == name {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let contains_path: (Array[String], String) -> Bool = (visited, path) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(visited) && !found {\n    if Array::get(visited, i) == path {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nexport let normalize_path: (String) -> String = (path) -> {\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\n  let mut parts = Array::slice([\n    \"\"\n  ], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_sep = if i == len {\n      true\n    } else {\n      String::char_code_at(path, i) == 47\n    }\n    if at_sep {\n      let part = path[start: i]\n      let skip_part = if String::length(part) == 0 {\n        true\n      } else {\n        part == \".\"\n      }\n      if skip_part {\n        ()\n      } else if part == \"..\" {\n        if Array::length(parts) > 0 {\n          Array::truncate(parts, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let buf = StringBuilder::new()\n  if is_absolute {\n    StringBuilder::push(buf, \"/\")\n  }\n  let mut pi = 0\n  while pi < Array::length(parts) {\n    if pi > 0 {\n      StringBuilder::push(buf, \"/\")\n    }\n    StringBuilder::push(buf, Array::get(parts, pi))\n    pi = pi + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let get_export_name: (Array[(String, Option[String])], String) -> String = (items, name) -> {\n  let mut result = name\n  let mut i = 0\n  while i < Array::length(items) {\n    let (iname, irename) = Array::get(items, i)\n    if iname == name {\n      match irename {\n        Some(alias) => {\n          result = alias\n        },\n        None => ()\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {\n  if base_dir == \"\" || base_dir == \"/\" {\n    String::concat(base_dir, raw_path)\n  } else {\n    String::concat(base_dir, String::concat(\"/\", raw_path))\n  }\n}\n\nexport let path_to_module_name: (String) -> String = (path) -> {\n  let len = String::length(path)\n  let mut last_slash = -1\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(path, i) == 47 {\n      last_slash = i\n    }\n    i = i + 1\n  }\n  let base = if last_slash >= 0 {\n    path[last_slash + 1: len]\n  } else {\n    path\n  }\n  let base_len = String::length(base)\n  if String::ends_with(base, \".vibe\") {\n    base[0: base_len - 5]\n  } else {\n    base\n  }\n}\n\nexport let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {\n  if len >= 2 {\n    if raw_path[0: 2] == \"./\" {\n      true\n    } else if len >= 3 {\n      raw_path[0: 3] == \"../\"\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n}\n\nexport let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\nexport let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {\n  let len = String::length(raw_path)\n  let joined = if path_has_relative_prefix(raw_path, len) {\n    join_relative_path(base_dir, raw_path)\n  } else {\n    raw_path\n  }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    [\n      normalized\n    ]\n  } else {\n    [\n      String::concat(normalized, \".vibe\"),\n      String::concat(normalized, \"/index.vibe\")\n    ]\n  }\n}\n")
}

let selfhost_source_137 = () -> (String, String) {
  ("vibe/compiler/cache/persistent_module_header_codec.vibe",
"\nlet has_prefix: (String, String) -> Bool = (line, prefix) -> {\n  let prefix_len = String::length(prefix)\n  if String::length(line) < prefix_len {\n    false\n  } else {\n    let mut ok = true\n    let mut i = 0\n    while ok && i < prefix_len {\n      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0: len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nlet parse_persistent_module_header_line: (Array[String], Array[String], String, Bool) -> Bool with { Error } = (deps, exports, line, saw_version) -> {\n  if String::length(line) == 0 {\n    saw_version\n  } else if has_prefix(line, \"version\\t\") {\n    let value = line[8: String::length(line)]\n    if !(value == \"1\") {\n      throw(\"invalid persistent module header version\")\n    }\n    true\n  } else if has_prefix(line, \"dep\\t\") {\n    let value = line[4: String::length(line)]\n    if String::length(value) == 0 {\n      throw(\"invalid persistent module header dep row\")\n    } else {\n      Array::push(deps, value)\n      saw_version\n    }\n  } else if has_prefix(line, \"export\\t\") {\n    let value = line[7: String::length(line)]\n    if String::length(value) == 0 {\n      throw(\"invalid persistent module header export row\")\n    } else {\n      Array::push(exports, value)\n      saw_version\n    }\n  } else {\n    throw(String::concat(\"invalid persistent module header row: \", line))\n  }\n}\n\nexport let persistent_module_header_text: (Array[String], Array[String]) -> String = (deps, exports) -> {\n  let buf = StringBuilder::new()\n  StringBuilder::push(buf, \"version\\t1\\n\")\n  let mut i = 0\n  while i < Array::length(deps) {\n    StringBuilder::push(buf, \"dep\\t\")\n    StringBuilder::push(buf, Array::get(deps, i))\n    StringBuilder::push(buf, \"\\n\")\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(exports) {\n    StringBuilder::push(buf, \"export\\t\")\n    StringBuilder::push(buf, Array::get(exports, j))\n    StringBuilder::push(buf, \"\\n\")\n    j = j + 1\n  }\n  StringBuilder::freeze(buf)\n}\n\nexport let parse_persistent_module_header_text: (String) -> (Array[String], Array[String]) with { Error } = (raw) -> {\n  let deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let exports = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut saw_version = false\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(raw[line_start: i])\n      saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  let line = strip_trailing_cr(raw[line_start: len])\n  saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\n  if !saw_version {\n    throw(\"missing persistent module header version\")\n  } else {\n    (deps, exports)\n  }\n}\n")
}

let selfhost_source_138 = () -> (String, String) {
  ("vibe/compiler/loader/header_cache.vibe",
"\n\n\n\n\n\n\n\n\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(candidates) {\n    if found == \"\" {\n      let candidate = Array::get(candidates, i)\n      if Fs::exists(candidate) {\n        found = candidate\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    found\n  }\n}\n\nlet is_special_bundle_path: (String) -> Bool = (path) -> {\n  String::ends_with(path, \"selfhost_sources_bundle.vibe\") || String::ends_with(path, \"selfhost_cli_adapter_bundle.vibe\") || String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\")\n}\n\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfhost_sources\",\n      \"selfhost_source_groups\"\n    ]))\n  } else if String::ends_with(path, \"selfhost_cli_adapter_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfhost_cli_adapter_sources\",\n      \"selfhost_cli_adapter_source_groups\",\n      \"selfhost_cli_adapter_ordered_sources\",\n      \"selfhost_cli_adapter_merged_source\",\n      \"selfhost_cli_adapter_module_source\"\n    ]))\n  } else if String::ends_with(path, \"selfbuild_runtime_entry_bundle.vibe\") {\n    Some((Array::slice([\n      \"\"\n    ], 0, 0), [\n      \"selfbuild_runtime_entry_source\"\n    ]))\n  } else {\n    None\n  }\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\n  let deps = Array::slice([\n    \"\"\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  if Fs::exists(cache_path) {\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\n    (parsed.0, parsed.1, parse_count)\n  } else {\n    let header_result = if is_special_bundle_path(path) {\n      match special_bundle_header(path) {\n        Some(pair) => {\n          let deps = pair.0\n          let exports = pair.1\n          (deps, exports, parse_count)\n        },\n        None => (Array::slice([\n          \"\"\n        ], 0, 0), Array::slice([\n          \"\"\n        ], 0, 0), parse_count)\n      }\n    } else {\n      let (tokens, starts, _ends) = lex_with_offsets(source)\n      let stmts = handle {\n        parse_program_located(tokens, starts, source)\n      } with Error {\n        Throw(msg) => throw(String::concat(path, String::concat(\": \", msg)))\n      }\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path)), collect_exports(stmts), parse_count + 1)\n    }\n    let deps = header_result.0\n    let exports = header_result.1\n    let next_parse_count = header_result.2\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))\n    (deps, exports, next_parse_count)\n  }\n}\n")
}

let selfhost_source_139 = () -> (String, String) {
  ("vibe/compiler/loader/manifest_sources.vibe",
"\n\n\n\n\n\n\n\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\n  if base_dir == \"\" {\n    rel_path\n  } else {\n    String::concat(base_dir, String::concat(\"/\", rel_path))\n  }\n}\n\nlet resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\n    raw_path\n  } else {\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\n    let mut i = 0\n    let mut found = \"\"\n    while i < Array::length(candidates) {\n      if found == \"\" {\n        let candidate = Array::get(candidates, i)\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\n          found = candidate\n        }\n      }\n      i = i + 1\n    }\n    if found == \"\" {\n      Array::get(candidates, 0)\n    } else {\n      found\n    }\n  }\n}\n\nlet starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {\n  match tok {\n    TDot => true,\n    _ => false\n  }\n}\n\nlet is_ident_char: (Int) -> Bool = (c) -> {\n  (c >= 'a' && c <= 'z') ||\n    (c >= 'A' && c <= 'Z') ||\n    (c >= '0' && c <= '9') ||\n    c == '_'\n}\n\nlet slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {\n  let text_len = String::length(text)\n  if start + text_len > String::length(s) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while ok && i < text_len {\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\n      i = i + 1\n    }\n    ok\n  }\n}\n\nlet starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {\n  let keyword_len = String::length(keyword)\n  if !(slice_eq_text(s, pos, keyword)) {\n    false\n  } else {\n    let before_ok = if pos == 0 {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\n    }\n    let after_pos = pos + keyword_len\n    let after_ok = if after_pos >= String::length(s) {\n      true\n    } else {\n      !(is_ident_char(String::char_code_at(s, after_pos)))\n    }\n    before_ok && after_ok\n  }\n}\n\nlet skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {\n  let mut pos = start\n  let mut done = false\n  while !done && pos < len {\n    let c = String::char_code_at(s, pos)\n    if c == ' ' || c == '\\n' || c == '\\t' || c == '\\r' || c == ';' {\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      pos = pos + 2\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else {\n      done = true\n    }\n  }\n  pos\n}\n\nlet scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {\n  let mut pos = start\n  let mut brace_depth = 0\n  let mut in_string = false\n  let mut string_quote = 0\n  let mut escape = false\n  let mut done = false\n  while pos < len && !done {\n    let c = String::char_code_at(s, pos)\n    if in_string {\n      if escape {\n        escape = false\n      } else if c == '\\\\' {\n        escape = true\n      } else if c == string_quote {\n        in_string = false\n      }\n      pos = pos + 1\n    } else if c == '\"' || c == '\\'' {\n      in_string = true\n      string_quote = c\n      pos = pos + 1\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\n      while pos < len && String::char_code_at(s, pos) != '\\n' {\n        pos = pos + 1\n      }\n    } else if c == '{' {\n      brace_depth = brace_depth + 1\n      pos = pos + 1\n    } else if c == '}' {\n      if brace_depth > 0 {\n        brace_depth = brace_depth - 1\n      }\n      pos = pos + 1\n    } else if brace_depth == 0 && (c == '\\n' || c == ';') {\n      done = true\n    } else {\n      pos = pos + 1\n    }\n  }\n  pos\n}\n\nlet skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\n  match peek(tokens, pos) {\n    TLBrace => {\n      let mut depth = 1\n      let mut i = pos + 1\n      while depth > 0 {\n        match peek(tokens, i) {\n          TLBrace => {\n            depth = depth + 1\n          },\n          TRBrace => {\n            depth = depth - 1\n          },\n          TEof => throw(\"unterminated brace list in manifest import scanner\"),\n          _ => ()\n        }\n        i = i + 1\n      }\n      i\n    }\n    _ => throw(\"expected '{' in manifest import scanner\")\n  }\n}\n\nlet scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {\n  let (raw_path, next_pos) = match peek(tokens, pos) {\n    TIdent(name) =>\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\n        (name, pos + 1)\n      } else {\n        collect_import_path(tokens, pos, \"\")\n      },\n    _ => collect_import_path(tokens, pos, \"\")\n  }\n  let after_path = match peek(tokens, next_pos) {\n    TIdent(alias_name) =>\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\n        next_pos + 1\n      } else {\n        next_pos\n      },\n    _ => next_pos\n  }\n  let end_pos = match peek(tokens, after_path) {\n    TLBrace => skip_brace_list(tokens, after_path),\n    _ => after_path\n  }\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\n}\n\nlet collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\n  let deps = Array::slice([\"\"], 0, 0)\n  let base_dir = dir_of_path(path)\n  let len = String::length(source)\n  let mut pos = 0\n  let mut done = false\n  while !done {\n    pos = skip_header_ws_and_comments(source, len, pos)\n    if pos >= len {\n      done = true\n    } else {\n      let is_import = starts_with_keyword_at(source, pos, \"import\")\n      let is_export = starts_with_keyword_at(source, pos, \"export\")\n      if !(is_import || is_export) {\n        done = true\n      } else {\n        let stmt_end = scan_header_stmt_end(source, len, pos)\n        let stmt_source = source[pos:stmt_end]\n        let tokens = lex(stmt_source)\n        let stmt_pos = skip_semi(tokens, 0)\n        match peek(tokens, stmt_pos) {\n          TImport => {\n            let (dep_path, _) = scan_header_import_dep(\n              tokens,\n              stmt_pos + 1,\n              base_dir,\n              manifest_path_index\n            )\n            Array::push(deps, dep_path)\n          },\n          TExport => {\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\n              let (dep_path, _) = scan_header_import_dep(\n                tokens,\n                stmt_pos + 1,\n                base_dir,\n                manifest_path_index\n              )\n              Array::push(deps, dep_path)\n            }\n          },\n          _ => {\n            done = true\n          }\n        }\n        pos = stmt_end\n      }\n    }\n  }\n  deps\n}\n\nlet collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\n  handle {\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\n  } with Error {\n    Throw(err) => throw(\"manifest header scan failed for \" + path + \": \" + err)\n  }\n}\n\nlet is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {\n  String::ends_with(path, \"selfhost_sources_bundle.vibe\")\n}\n\nlet should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {\n  if Map::has_key(manifest_path_index, dep_path) {\n    true\n  } else {\n    !(is_manifest_external_terminal_dep(dep_path))\n  }\n}\n\nlet load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {\n  handle {\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\n    deps\n  } with Error {\n    Throw(err) => throw(\"module header parse failed for \" + path + \": \" + err)\n  }\n}\n\nexport let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    MapBuilder::set(builder, path, source)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {\n  if Map::has_key(source_index, path_key) {\n    Some(Map::get(source_index, path_key))\n  } else {\n    None\n  }\n}\n\nexport let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(paths) {\n    MapBuilder::set(builder, Array::get(paths, i), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet empty_path_index: () -> Map[String, Bool] = () -> {\n  let builder = MapBuilder::new()\n  MapBuilder::freeze(builder)\n}\n\nlet build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {\n  let builder = MapBuilder::new()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\n    i = i + 1\n  }\n  MapBuilder::freeze(builder)\n}\n\nlet find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {\n  let mut base_dir = dir_of_path(entry_path)\n  let mut found = None\n  let mut done = false\n  loop {\n    if done {\n      break\n    }\n    let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n    if Fs::exists(manifest_path) {\n      found = Some(base_dir)\n      done = true\n    } else if base_dir == \"\" {\n      done = true\n    } else {\n      let parent = dir_of_path(base_dir)\n      if parent == base_dir {\n        done = true\n      } else {\n        base_dir = parent\n      }\n    }\n  }\n  found\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\nlet find_char: (String, Int) -> Int = (s, target) -> {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values: (Array[String]) -> String = (values) -> {\n  let out = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(out, header_value_separator)\n    }\n    StringBuilder::push(out, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(out)\n}\n\nlet split_header_values: (String) -> Array[String] = (text) -> {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if name == group_name {\n      found = Some(sources)\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  match found {\n    Some(sources) => sources,\n    None => {\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(groups, (group_name, sources))\n      sources\n    }\n  }\n}\n\nlet build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    match on_path(path) {\n      Some(source) => {\n        let bucket = if has_last_group && last_group_name == group_name {\n          last_group_sources\n        } else {\n          let ensured = ensure_grouped_source_bucket(groups, group_name)\n          last_group_name = group_name\n          last_group_sources = ensured\n          has_last_group = true\n          ensured\n        }\n        Array::push(bucket, (path, source))\n      },\n      None => ()\n    }\n    i = i + 1\n  }\n  groups\n}\n\n\nlet parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {\n  let rows = Array::slice([(\"\", \"\")], 0, 0)\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(manifest_source, i) == 10\n    }\n    if at_line_end {\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\n      let line_len = String::length(raw_line)\n      let has_content = line_len > 0\n      let is_comment = if has_content {\n        String::char_code_at(raw_line, 0) == 35\n      } else {\n        false\n      }\n      if has_content {\n        if is_comment {\n          ()\n        } else {\n          let tab_idx = find_char(raw_line, 9)\n          let invalid_row = if tab_idx < 0 {\n            true\n          } else {\n            tab_idx + 1 >= line_len\n          }\n          if invalid_row {\n            throw(String::concat(\"invalid source manifest row: \", raw_line))\n          }\n          let group = raw_line[0:tab_idx]\n          let path = raw_line[tab_idx + 1:line_len]\n          Array::push(rows, (group, path))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nexport let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match find_manifest_base_dir(entry_path) {\n    Some(base_dir) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n      let mut has_entry = false\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, rel_path) = Array::get(rows, i)\n        let path = join_path(base_dir, rel_path)\n        if path == entry_path {\n          has_entry = true\n        }\n        i = i + 1\n      }\n      if has_entry {\n        Some((base_dir, rows))\n      } else {\n        None\n      }\n    },\n    None => None\n  }\n}\n\nexport let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {\n  let full_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nlet load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\n  let sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(sources, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  sources\n}\n\nlet load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\n  let groups = empty_grouped_sources()\n  let mut last_group_name = \"\"\n  let mut last_group_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut has_last_group = false\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    if Map::has_key(needed_path_index, path) {\n      let bucket = if has_last_group && last_group_name == group_name {\n        last_group_sources\n      } else {\n        let ensured = ensure_grouped_source_bucket(groups, group_name)\n        last_group_name = group_name\n        last_group_sources = ensured\n        has_last_group = true\n        ensured\n      }\n      Array::push(bucket, (path, Fs::read_file(path)))\n    }\n    i = i + 1\n  }\n  groups\n}\n\nexport let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {\n  build_grouped_sources_from_manifest_rows_with_lookup(\n    base_dir,\n    rows,\n    (path: String) -> Option[String] {\n      source_lookup_in_index(source_index, path)\n    }\n  )\n}\n\nexport let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {\n  let source_index = build_manifest_source_index(sources)\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\n}\n\nexport let filter_manifest_sources_by_path_index: (Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] = (preloaded_sources, needed_path_index) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if Map::has_key(needed_path_index, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport let filter_manifest_sources_by_paths: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\n  let needed_path_index = build_manifest_path_index(needed_paths)\n  filter_manifest_sources_by_path_index(preloaded_sources, needed_path_index)\n}\n\nexport let filter_manifest_sources_by_paths_linear: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (preloaded_sources, needed_paths) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(preloaded_sources) {\n    let (path, source) = Array::get(preloaded_sources, i)\n    if contains_path(needed_paths, path) {\n      Array::push(filtered_sources, (path, source))\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\nexport let filter_manifest_sources_by_source_index: (Array[String], Map[String, String]) -> Array[(String, String)] = (needed_paths, preloaded_source_index) -> {\n  let filtered_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(needed_paths) {\n    let path = Array::get(needed_paths, i)\n    match source_lookup_in_index(preloaded_source_index, path) {\n      Some(source) => Array::push(filtered_sources, (path, source)),\n      None => ()\n    }\n    i = i + 1\n  }\n  filtered_sources\n}\n\n\nlet parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if tag == \"header\" {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nlet load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n        cached_path == manifest_path &&\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\n          if !(Map::has_key(manifest_path_index, path)) {\n            valid = false\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n            valid = false\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(\n    out,\n    String::concat(\n      \"manifest\\t\",\n      String::concat(\n        manifest_path,\n        String::concat(\n          \"\\t\",\n          String::concat(\n            __to_string(Fs::stat_token(manifest_path)),\n            String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \"\\n\"))\n          )\n        )\n      )\n    )\n  )\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"header\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              stat_token_text,\n              String::concat(\n                \"\\t\",\n                String::concat(\n                  source_fingerprint,\n                  String::concat(\"\\t\", String::concat(deps_text, \"\\n\"))\n                )\n              )\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {\n  Fs::write_file(\n    persistent_manifest_header_cache_path(entry_path),\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\n  )\n}\n\nlet manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if row_path == path {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let mut scheduled_set = empty_path_index()\n  Array::push(worklist, path)\n  scheduled_set = Map::set(scheduled_set, path, true)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_path(visited, current)) {\n      Array::push(visited, current)\n      let deps = match manifest_header_deps_lookup(rows, current) {\n        Some(found) => found,\n        None => {\n          let source = Fs::read_file(current)\n          if Map::has_key(manifest_path_index, current) {\n            collect_manifest_header_deps_from_source_with_context(\n              current,\n              source,\n              manifest_path_index\n            )\n          } else {\n            load_or_parse_module_header_deps_with_context(current, source)\n          }\n        }\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n          !Map::has_key(scheduled_set, dep_path) {\n          Array::push(worklist, dep_path)\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let mut scheduled_set = empty_path_index()\n  Array::push(worklist, path)\n  scheduled_set = Map::set(scheduled_set, path, true)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_path(visited, current)) {\n      Array::push(visited, current)\n      let source = Fs::read_file(current)\n      let deps = match manifest_header_deps_lookup(rows, current) {\n        Some(found) => found,\n        None => {\n          let parsed_deps = if Map::has_key(manifest_path_index, current) {\n            collect_manifest_header_deps_from_source_with_context(\n              current,\n              source,\n              manifest_path_index\n            )\n          } else {\n            load_or_parse_module_header_deps_with_context(current, source)\n          }\n          Array::push(\n            rows,\n            (\n              current,\n              __to_string(Fs::stat_token(current)),\n              compact_string_fingerprint(source),\n              join_header_values(parsed_deps)\n            )\n          )\n          parsed_deps\n        }\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n          !Map::has_key(scheduled_set, dep_path) {\n          Array::push(worklist, dep_path)\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n    }\n    work_i = work_i + 1\n  }\n  (rows, visited)\n}\n\nlet collect_needed_paths_from_manifest_scan: (String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, manifest_path_index) -> {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let mut scheduled_set = empty_path_index()\n  Array::push(worklist, path)\n  scheduled_set = Map::set(scheduled_set, path, true)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_path(visited, current)) {\n      Array::push(visited, current)\n      let source = Fs::read_file(current)\n      let deps = if Map::has_key(manifest_path_index, current) {\n        collect_manifest_header_deps_from_source_with_context(\n          current,\n          source,\n          manifest_path_index\n        )\n      } else {\n        load_or_parse_module_header_deps_with_context(current, source)\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\n          !Map::has_key(scheduled_set, dep_path) {\n          Array::push(worklist, dep_path)\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\n  match load_persistent_manifest_header_cache_if_valid(\n    entry_path,\n    manifest_path,\n    manifest_path_index\n  ) {\n    Some(cached_rows) => cached_rows,\n    None => {\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n      built_rows\n    }\n  }\n}\n\nexport let probe_manifest_header_rows_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_header_rows_uncached_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let (header_rows, _) = collect_needed_paths_and_manifest_headers(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(header_rows)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_needed_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\nexport let probe_manifest_scan_paths_count: (String) -> Int with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let needed_paths = collect_needed_paths_from_manifest_scan(\n        entry_path,\n        manifest_path_index\n      )\n      Array::length(needed_paths)\n    },\n    None => throw(\"manifest rows unavailable\")\n  }\n}\n\n\nexport let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, sources))\n    },\n    None => None\n  }\n}\n\nexport let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\n      let header_rows = load_or_collect_manifest_header_rows(\n        entry_path,\n        manifest_path,\n        manifest_path_index\n      )\n      let needed_paths = collect_needed_paths_from_manifest_headers(\n        entry_path,\n        manifest_path_index,\n        header_rows\n      )\n      let needed_path_index = build_manifest_path_index(needed_paths)\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n")
}

let selfhost_source_140 = () -> (String, String) {
  ("vibe/compiler/loader/index.vibe",
"\n\n\n\n\n\n\n\n\n\n\n\nlet source_lookup: (Array[(String, String)], String) -> Option[String] = (sources, path_key) -> {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    match found {\n      Some(_) => (),\n      None => {\n        let (p, src) = Array::get(sources, i)\n        if p == path_key {\n          found = Some(src)\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet resolve_path_in_sources: (String, String, Array[(String, String)]) -> Option[(String, String)] = (base_dir, raw_path, sources) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(candidates) {\n    match found {\n      Some(_) => (),\n      None => {\n        let candidate = Array::get(candidates, i)\n        match source_lookup(sources, candidate) {\n          Some(source) => {\n            found = Some((candidate, source))\n          }\n          None => ()\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\n  let mut i = 0\n  let mut found = \"\"\n  while i < Array::length(candidates) {\n    if found == \"\" {\n      let candidate = Array::get(candidates, i)\n      let candidate_exists = perform Fs::Exists(candidate)\n      if candidate_exists {\n        found = candidate\n      }\n    }\n    i = i + 1\n  }\n  if found == \"\" {\n    Array::get(candidates, 0)\n  } else {\n    found\n  }\n}\n\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\n  if base_dir == \"\" {\n    rel_path\n  } else {\n    String::concat(base_dir, String::concat(\"/\", rel_path))\n  }\n}\n\nlet strip_trailing_cr: (String) -> String = (line) -> {\n  let len = String::length(line)\n  if len > 0 {\n    if String::char_code_at(line, len - 1) == 13 {\n      line[0:len - 1]\n    } else {\n      line\n    }\n  } else {\n    line\n  }\n}\n\n\nlet string_to_bytes: (String) -> Bytes = (s) -> {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((\n      Array::slice([\"\"], 0, 0),\n      [\"selfhost_sources\", \"selfhost_source_groups\"]\n    ))\n  } else {\n    None\n  }\n}\n\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    let at_field_end = if i == len {\n      true\n    } else {\n      String::char_code_at(line, i) == 9\n    }\n    if at_field_end {\n      Array::push(fields, line[start:i])\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values: (Array[String]) -> String = (values) -> {\n  let sb = StringBuilder::new()\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      StringBuilder::push(sb, header_value_separator)\n    }\n    StringBuilder::push(sb, Array::get(values, i))\n    i = i + 1\n  }\n  StringBuilder::freeze(sb)\n}\n\nlet split_header_values: (String) -> Array[String] = (text) -> {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      let at_value_end = if i == len {\n        true\n      } else {\n        String::char_code_at(text, i) == sep\n      }\n      if at_value_end {\n        Array::push(values, text[start:i])\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_source_specs: () -> Array[(String, String)] = () -> {\n  Array::slice([(\"\", \"\")], 0, 0)\n}\n\nlet copy_source_specs: (Array[(String, String)]) -> Array[(String, String)] = (sources) -> {\n  let out = empty_source_specs()\n  let mut i = 0\n  while i < Array::length(sources) {\n    Array::push(out, Array::get(sources, i))\n    i = i + 1\n  }\n  out\n}\n\nlet empty_group_specs: () -> Array[(String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_source_cache_specs: () -> Array[(String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_group_cache_specs: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_sources) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_sources, (path, source))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, sources) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(sources, (path, source))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(sources, (path, source))\n      Array::push(groups, (group_name, sources))\n    }\n  }\n}\n\nlet push_grouped_source_fingerprint: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source_fingerprint) -> {\n  let group_count = Array::length(groups)\n  let handled_by_tail = if group_count > 0 {\n    let (last_name, last_specs) = Array::get(groups, group_count - 1)\n    if last_name == group_name {\n      Array::push(last_specs, (path, source_fingerprint))\n      true\n    } else {\n      false\n    }\n  } else {\n    false\n  }\n  if !handled_by_tail {\n    let mut i = 0\n    let mut found_index = -1\n    while i < group_count {\n      if found_index == -1 {\n        let (name, specs) = Array::get(groups, i)\n        if name == group_name {\n          Array::push(specs, (path, source_fingerprint))\n          found_index = i\n        }\n      }\n      i = i + 1\n    }\n    if found_index == -1 {\n      let specs = Array::slice([(\"\", \"\")], 0, 0)\n      Array::push(specs, (path, source_fingerprint))\n      Array::push(groups, (group_name, specs))\n    }\n  }\n}\n\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet parse_persistent_source_list_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let sources = empty_source_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent source list cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"source\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source list cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, sources)\n}\n\nlet parse_persistent_source_group_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_group_cache_specs()\n  while i <= len {\n    let at_line_end = if i == len {\n      true\n    } else {\n      String::char_code_at(raw, i) == 10\n    }\n    if at_line_end {\n      let line = strip_trailing_cr(raw[line_start:i])\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if tag == \"version\" {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if version_text == \"1\" {\n            version = 1\n          } else if version_text == \"2\" {\n            version = 2\n          } else {\n            throw(\"invalid persistent source group cache version\")\n          }\n        } else if tag == \"manifest\" {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if tag == \"group\" {\n          if version == 1 {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \"\", Array::get(fields, 3)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source group cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        true\n      } else if String::length(source_fingerprint) > 0 {\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n      } else {\n        false\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\n    } else {\n      false\n    }\n  }\n}\n\nlet load_source_if_cached_file_spec_matches: (String, String, String) -> Option[String] with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let has_stat_token = String::length(stat_token_text) > 0\n    if has_stat_token {\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\n        Some(Fs::read_file(path))\n      } else if String::length(source_fingerprint) > 0 {\n        let source = Fs::read_file(path)\n        if compact_string_fingerprint(source) == source_fingerprint {\n          Some(source)\n        } else {\n          None\n        }\n      } else {\n        None\n      }\n    } else if String::length(source_fingerprint) > 0 {\n      let source = Fs::read_file(path)\n      if compact_string_fingerprint(source) == source_fingerprint {\n        Some(source)\n      } else {\n        None\n      }\n    } else {\n      None\n    }\n  }\n}\n\nlet rec load_cached_sources_rec: (Array[(String, String, String)], Int, Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } = (specs, index, out) -> {\n  if index >= Array::length(specs) {\n    Some(out)\n  } else {\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        Array::push(out, (path, source))\n        load_cached_sources_rec(specs, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nlet rec load_cached_grouped_sources_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n      Some(source) => {\n        push_grouped_source(out, group_name, path, source)\n        load_cached_grouped_sources_rec(rows, index + 1, out)\n      },\n      None => None\n    }\n  }\n}\n\nlet rec load_cached_group_fingerprint_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\n  if index >= Array::length(rows) {\n    Some(out)\n  } else {\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\n    if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n      None\n    } else {\n      push_grouped_source_fingerprint(out, group_name, path, source_fingerprint)\n      load_cached_group_fingerprint_rec(rows, index + 1, out)\n    }\n  }\n}\n\nlet manifest_cache_is_valid: (Option[(String, String, String)]) -> Bool with { Error, Fs } = (manifest) -> {\n  match manifest {\n    Some((path, stat_token_text, source_fingerprint)) =>\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\n    None => true\n  }\n}\n\nlet load_persistent_sources_cache_if_valid: (String) -> Option[Array[(String, String)]] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_sources_rec(specs, 0, empty_source_specs())\n    }\n  }\n}\n\nlet load_persistent_source_groups_cache_if_valid: (String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\n    }\n  }\n}\n\nlet manifest_path_of: (Option[(String, String, String)]) -> Option[String] = (manifest) -> {\n  match manifest {\n    Some((path, _, _)) => Some(path),\n    None => None\n  }\n}\n\nlet load_persistent_sources_from_group_cache_if_valid: (String) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let specs = empty_source_cache_specs()\n      let mut i = 0\n      while i < Array::length(rows) {\n        let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n        Array::push(specs, (path, stat_token_text, source_fingerprint))\n        i = i + 1\n      }\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) => Some((manifest_path_of(manifest), sources)),\n        None => None\n      }\n    }\n  }\n}\n\nlet load_persistent_source_groups_from_source_list_cache_if_valid: (String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\n        Some(sources) =>\n          match try_load_manifest_rows(entry_path) {\n            Some((base_dir, rows)) => {\n              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\n              Some((manifest_path_of(manifest), groups))\n            },\n            None => {\n              let groups = empty_grouped_sources()\n              Array::push(groups, (\"recursive\", sources))\n              Some((None, groups))\n            }\n          },\n        None => None\n      }\n    }\n  }\n}\n\nexport let load_persistent_source_group_fingerprint_if_valid: (String) -> Option[String] with { Error, Fs } = (entry_path) -> {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      match load_cached_group_fingerprint_rec(rows, 0, empty_grouped_sources()) {\n        Some(groups) => Some(build_source_groups_fingerprint_from_compact_fingerprints(groups)),\n        None => None\n      }\n    }\n  }\n}\n\nlet build_persistent_sources_cache_text: (Option[String], Array[(String, String)]) -> String with { Error, Fs } = (manifest_path, sources) -> {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"source\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              __to_string(Fs::stat_token(path)),\n              String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet build_persistent_source_groups_cache_text: (Option[String], Array[(String, Array[(String, String)])]) -> String with { Error, Fs } = (manifest_path, groups) -> {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      out = String::concat(\n        out,\n        String::concat(\n          \"group\\t\",\n          String::concat(\n            group_name,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                path,\n                String::concat(\n                  \"\\t\",\n                  String::concat(\n                    __to_string(Fs::stat_token(path)),\n                    String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n                  )\n                )\n              )\n            )\n          )\n        )\n      )\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\n  let deps = Array::slice([\"\"], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport let load_or_parse_module_header_fs: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\n}\n\nlet store_persistent_sources_cache: (String, Option[String], Array[(String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, sources) -> {\n  Fs::write_file(\n    persistent_source_list_cache_path(entry_path),\n    build_persistent_sources_cache_text(manifest_path, sources)\n  )\n}\n\nlet store_persistent_source_groups_cache: (String, Option[String], Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } = (entry_path, manifest_path, groups) -> {\n  Fs::write_file(\n    persistent_source_group_cache_path(entry_path),\n    build_persistent_source_groups_cache_text(manifest_path, groups)\n  )\n}\n\nlet copy_grouped_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] = (groups) -> {\n  let out = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let copied_sources = copy_source_specs(sources)\n    Array::push(out, (group_name, copied_sources))\n    gi = gi + 1\n  }\n  out\n}\n\nlet flatten_group_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, String)] = (groups) -> {\n  let out = empty_source_specs()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (_, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(out, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet filter_group_sources: (Array[(String, Array[(String, String)])], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (groups, ordered_sources) -> {\n  let filtered = empty_grouped_sources()\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      match source_lookup(ordered_sources, path) {\n        Some(_) => Array::push(next_sources, pair),\n        None => ()\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered\n}\n\nlet special_bundle_source_groups: (String) -> Option[Array[(String, Array[(String, String)])]] = (entry_path) -> {\n  let _ = entry_path\n  None\n}\n\nlet normalize_bundle_source_groups: (Array[(String, Array[(String, String)])], String, String) -> Array[(String, Array[(String, String)])] = (groups, main_path, main_source) -> {\n  let normalized = empty_grouped_sources()\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let next_sources = empty_source_specs()\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if path == main_path {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = empty_source_specs()\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nlet special_manifest_sources: (String) -> Option[(String, Array[(String, String)])] = (entry_path) -> {\n  let _ = entry_path\n  None\n}\n\nlet special_manifest_source_groups: (String) -> Option[(String, Array[(String, Array[(String, String)])])] = (entry_path) -> {\n  let _ = entry_path\n  None\n}\n\n\n\nlet cache_lookup: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if p == path {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet export_marker_name: (String) -> String = (name) -> {\n  String::concat(\"__vibe_internal_export__:\", name)\n}\n\nlet env_has_export_marker: (TypeEnv, String) -> Bool = (env, name) -> {\n  match env_lookup(env, export_marker_name(name)) {\n    Some(_) => true,\n    None => false\n  }\n}\n\nlet bind_export_markers: (TypeEnv, Array[String]) -> TypeEnv = (env, exports) -> {\n  let mut acc = env\n  let mut i = 0\n  while i < Array::length(exports) {\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\n    i = i + 1\n  }\n  acc\n}\n\nlet rec bind_checked_imports: (Array[(String, Option[String])], Int, TypeEnv, TypeEnv) -> TypeEnv = (names, i, env, mod_env) -> {\n  if i >= Array::length(names) {\n    env\n  } else {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if env_has_export_marker(mod_env, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env)\n  }\n}\n\n\nexport let rec check_module: (String, String, Array[(String, String)], Array[String], Array[(String, TypeEnv)]) -> TypeEnv with { Error } = (source, path, sources, loading, checked_cache) -> {\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      if contains_path(loading, path) {\n        throw(String::concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of_path(path)\n      let saved_loading_len = Array::length(loading)\n      Array::push(loading, path)\n\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < Array::length(stmts) {\n        let stmt = Array::get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          SReExport(raw_path, names) => {\n            match resolve_path_in_sources(base_dir, raw_path, sources) {\n              None => throw(String::concat(\"module not found: \", resolve_import_path(base_dir, raw_path))),\n              Some((resolved, mod_source)) => {\n                let mod_env = check_module(mod_source, resolved, sources, loading, checked_cache)\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n      Array::truncate(loading, saved_loading_len)\n\n      let empty_defs = Array::slice([TDAlias(\"_dummy\", Array::slice([\"\"], 0, 0), CtUnit)], 0, 0)\n      let check_errors = Array::slice([\n        \"\"\n      ], 0, 0)\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0, check_errors)\n\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\n      Array::push(checked_cache, (path, cached_env))\n      cached_env\n    }\n  }\n}\n\n\nlet rec collect_sources_rec: (String, Array[(String, String)], Array[String]) -> Unit with { Error, Fs } = (path, sources, visited) -> {\n  if contains_path(visited, path) {\n    ()\n  }\n  else {\n    Array::push(visited, path)\n    let source = Fs::read_file(path)\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      collect_sources_rec(Array::get(deps, i), sources, visited)\n      i = i + 1\n    }\n    Array::push(sources, (path, source))\n  }\n}\n\nexport let collect_all_sources_fs: (String) -> Array[(String, String)] with { Error, Fs } = (entry_path) -> {\n  match special_manifest_sources(entry_path) {\n    Some((manifest_path, sources)) => {\n      let _ = manifest_path\n      copy_source_specs(sources)\n    },\n    None =>\n      match load_persistent_sources_cache_if_valid(entry_path) {\n        Some(sources) => sources,\n        None => {\n          match try_collect_manifest_sources_fs(entry_path) {\n            Some((manifest_path, sources)) => {\n              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\n              sources\n            },\n            None => {\n              match try_load_manifest_rows(entry_path) {\n                Some((base_dir, rows)) => {\n                  let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\n                  preloaded_sources\n                },\n                None => {\n                  let sources = Array::slice([(\"\", \"\")], 0, 0)\n                  let visited = Array::slice([\"\"], 0, 0)\n                  collect_sources_rec(entry_path, sources, visited)\n                  store_persistent_sources_cache(entry_path, None, sources)\n                  sources\n                }\n              }\n            }\n          }\n        }\n      }\n  }\n}\n\nexport let collect_source_groups_fs: (String) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\n  match special_manifest_source_groups(entry_path) {\n    Some((manifest_path, groups)) => {\n      let _ = manifest_path\n      copy_grouped_sources(groups)\n    },\n    None =>\n      match load_persistent_source_groups_cache_if_valid(entry_path) {\n        Some(groups) => groups,\n        None =>\n          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\n            Some((manifest_path, groups)) => {\n              store_persistent_source_groups_cache(entry_path, manifest_path, groups)\n              groups\n            },\n            None =>\n              match try_collect_manifest_source_groups_fs(entry_path) {\n                Some((manifest_path, groups)) => {\n                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                  groups\n                },\n                None =>\n                  match try_load_manifest_rows(entry_path) {\n                    Some((base_dir, rows)) => {\n                      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n                      let groups = empty_grouped_sources()\n                      let mut j = 0\n                      while j < Array::length(rows) {\n                        let (group_name, rel_path) = Array::get(rows, j)\n                        let path = join_path(base_dir, rel_path)\n                        let mut found = \"\"\n                        let mut k = 0\n                        while k < Array::length(preloaded_sources) {\n                          if found == \"\" {\n                            let (source_path, source_text) = Array::get(preloaded_sources, k)\n                            if source_path == path {\n                              found = source_text\n                            }\n                          }\n                          k = k + 1\n                        }\n                        if found == \"\" {\n                          ()\n                        } else {\n                          push_grouped_source(groups, group_name, path, found)\n                        }\n                        j = j + 1\n                      }\n                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n                      groups\n                    },\n                    None => {\n                      let groups = empty_grouped_sources()\n                      let recursive_sources = collect_all_sources_fs(entry_path)\n                      Array::push(groups, (\"recursive\", recursive_sources))\n                      store_persistent_source_groups_cache(entry_path, None, groups)\n                      groups\n                    }\n                  }\n              }\n          }\n      }\n  }\n}\n\n\nexport let collect_merged_stmts: (Array[(String, String)]) -> Array[Stmt] with { Error } = (sources) -> {\n  let merged = Array::slice([SExport([\"_dummy\"])], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, src) = Array::get(sources, si)\n    let stmts = parse_program(lex(src))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        SAliasDecl(_, _) => (),\n        _ => Array::push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n")
}

let selfhost_source_141 = () -> (String, String) {
  ("vibe/compiler/module_loader.vibe",
"\n\n\nexport {\n  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\n}\n")
}

let selfhost_source_142 = () -> (String, String) {
  ("vibe/compiler/normalize/index.vibe",
"\n\n\n\n\n\n\n\nlet empty_stmts: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExport([])\n  ], 0, 0)\n}\n\nlet empty_strs: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet join_module_name: (String, String) -> String = (prefix, name) -> {\n  if prefix == \"\" {\n    name\n  } else {\n    String::concat(prefix, String::concat(\"::\", name))\n  }\n}\n\nlet rec module_value_aliases: (Array[Stmt], String, Array[(String, String)]) -> Int = (body, prefix, out) -> {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(_, _, name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SLetMut(name, _, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SExternLet(name, _) => {\n        Array::push(out, (name, join_module_name(prefix, name)))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  0\n}\n\nlet rec flatten_module_body: (Array[Stmt], String, Array[(String, String)], Array[Stmt]) -> Int = (body, prefix, aliases, out) -> {\n  let mut i = 0\n  while i < Array::length(body) {\n    match Array::get(body, i) {\n      SLet(exp, is_rec, name, ty, b) => {\n        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\n        0\n      },\n      SLetMut(name, ty, b) => {\n        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\n        0\n      },\n      SExternLet(name, ty) => {\n        Array::push(out, SExternLet(join_module_name(prefix, name), ty))\n        0\n      },\n      SModule(_, inner, inner_body) => {\n        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)\n        0\n      },\n      other => {\n        Array::push(out, other)\n        0\n      }\n    }\n    i = i + 1\n  }\n  0\n}\n\nlet is_module_stmt: (Stmt) -> Bool = (stmt) -> {\n  match stmt {\n    SModule(_, _, _) => true,\n    _ => false\n  }\n}\n\n\nlet exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let roots = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, _, name, _, _) => if exp || String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SLetMut(name, _, _) => if String::contains(name, \"::\") {\n        Array::push(roots, name)\n      },\n      SExport(names) => {\n        let mut j = 0\n        while j < Array::length(names) {\n          Array::push(roots, Array::get(names, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  roots\n}\n\nlet aggregate_export_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let names = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SExport(exported) => {\n        let mut j = 0\n        while j < Array::length(exported) {\n          Array::push(names, Array::get(exported, j))\n          j = j + 1\n        }\n        0\n      },\n      _ => 0\n    }\n    i = i + 1\n  }\n  names\n}\n\nlet str_array_has: (Array[String], String) -> Bool = (arr, target) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if Array::get(arr, i) == target {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet promote_aggregate_exports: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, agg) -> {\n  let result = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let promoted = match stmt {\n      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {\n        SLet(true, is_rec, name, ty, body)\n      } else {\n        stmt\n      },\n      _ => stmt\n    }\n    Array::push(result, promoted)\n    i = i + 1\n  }\n  result\n}\n\n\nlet rec collect_type_names_into: (TypeExpr, Array[String]) -> Int = (ty, out) -> {\n  match ty {\n    TyName(n) => {\n      Array::push(out, n)\n      0\n    },\n    TyApp(n, args) => {\n      Array::push(out, n)\n      let mut i = 0\n      while i < Array::length(args) {\n        let _ = collect_type_names_into(Array::get(args, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyFn(params, ret, _) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let _ = collect_type_names_into(Array::get(params, i), out)\n        i = i + 1\n      }\n      let _ = collect_type_names_into(ret, out)\n      0\n    },\n    TyTuple(items) => {\n      let mut i = 0\n      while i < Array::length(items) {\n        let _ = collect_type_names_into(Array::get(items, i), out)\n        i = i + 1\n      }\n      0\n    },\n    TyUnit => 0\n  }\n}\n\nlet collect_opt_type_into: (Option[TypeExpr], Array[String]) -> Int = (ty_opt, out) -> {\n  match ty_opt {\n    Some(ty) => collect_type_names_into(ty, out),\n    None => 0\n  }\n}\n\nlet collect_stmt_type_refs_into: (Stmt, Array[String]) -> Int = (stmt, out) -> {\n  match stmt {\n    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),\n    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),\n    SExternLet(_, ty) => collect_type_names_into(ty, out),\n    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),\n    SStruct(_, _, fields, _, _) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fty) = Array::get(fields, i)\n        let _ = collect_type_names_into(fty, out)\n        i = i + 1\n      }\n      0\n    },\n    SEnum(_, _, _, ctors, _) => {\n      let mut i = 0\n      while i < Array::length(ctors) {\n        let (_, args) = Array::get(ctors, i)\n        let mut j = 0\n        while j < Array::length(args) {\n          let _ = collect_type_names_into(Array::get(args, j), out)\n          j = j + 1\n        }\n        i = i + 1\n      }\n      0\n    },\n    SImpl(_, _, _, type_name) => {\n      Array::push(out, type_name)\n      0\n    },\n    _ => 0\n  }\n}\n\n\nlet drop_unused_type_aliases: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let referenced = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let mut k = 0\n  while k < Array::length(stmts) {\n    let stmt = Array::get(stmts, k)\n    let keep = match stmt {\n      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),\n      _ => true\n    }\n    if keep {\n      Array::push(result, stmt)\n    }\n    k = k + 1\n  }\n  result\n}\n\n\nlet stmt_section: (Stmt) -> Int = (stmt) -> {\n  match stmt {\n    SImport(_, _) => 0,\n    SReExport(_, _) => 0,\n    SAliasDecl(_, _) => 0,\n    SEnum(_, _, _, _, _) => 1,\n    SSuberror(_, _, _) => 1,\n    SStruct(_, _, _, _, _) => 1,\n    STypeAlias(_, _, _, _) => 1,\n    STrait(_, _, _, _, _) => 1,\n    SImpl(_, _, _, _) => 1,\n    SEffectDef(_, _, _, _) => 1,\n    SExternLet(_, _) => 1,\n    SLet(_, _, _, _, _) => 2,\n    SLetMut(_, _, _) => 2,\n    SLetPat(_, _) => 2,\n    STest(_, _) => 3,\n    SBench(_, _) => 3,\n    SExport(_) => 9,\n    SExpr(_) => 9,\n    _ => 9\n  }\n}\n\nlet section_header: (Int) -> String = (section) -> {\n  if section == 0 {\n    \"//# Imports\"\n  } else if section == 1 {\n    \"//# Types\"\n  } else if section == 2 {\n    \"//# Functions\"\n  } else {\n    \"//# Tests\"\n  }\n}\n\nlet render_section: (Array[Stmt], Int) -> String = (stmts, section) -> {\n  let parts = empty_strs()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if stmt_section(stmt) == section {\n      Array::push(parts, print_stmt(stmt))\n    }\n    i = i + 1\n  }\n  if Array::length(parts) == 0 {\n    \"\"\n  } else {\n    let body = String::join(parts, \"\\n\\n\")\n    String::concat(section_header(section), String::concat(\"\\n\\n\", body))\n  }\n}\n\n\nlet normalize_empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet all_params_typed: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\n  let mut i = 0\n  let mut ok = true\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(_) => 0,\n      None => {\n        ok = false\n        0\n      }\n    }\n    i = i + 1\n  }\n  ok\n}\n\nlet param_type_list: (Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] = (params) -> {\n  let out = normalize_empty_type_exprs()\n  let mut i = 0\n  while i < Array::length(params) {\n    let (_, ty_opt) = Array::get(params, i)\n    match ty_opt {\n      Some(ty) => Array::push(out, ty),\n      None => 0\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet strip_param_types: (Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (params) -> {\n  let out = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(params) {\n    let (name, _) = Array::get(params, i)\n    Array::push(out, (name, None))\n    i = i + 1\n  }\n  out\n}\n\nlet hoist_lambda_let: (Stmt) -> Stmt = (stmt) -> {\n  match stmt {\n    SLet(exp, is_rec, name, ty, value) => match ty {\n      Some(_) => stmt,\n      None => match value {\n        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {\n          None => stmt,\n          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {\n            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))\n          } else {\n            stmt\n          }\n        },\n        _ => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nlet hoist_lambda_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n\nlet fold_int_binop: (String, Int, Int) -> Option[Int] = (op, a, b) -> {\n  if op == \"+\" {\n    Some(a + b)\n  } else if op == \"-\" {\n    Some(a - b)\n  } else if op == \"*\" {\n    Some(a * b)\n  } else {\n    None\n  }\n}\n\nlet rec fold_expr: (Expr) -> Expr = (expr) -> {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      fold_expr(it)\n    }),\n    EArray(items) => EArray(for it in items {\n      fold_expr(it)\n    }),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f\n      (n, fold_expr(v))\n    }),\n    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),\n    ELet(n, v, b) => ELet(n, fold_expr(v), fold_expr(b)),\n    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),\n    ELetMut(n, v, b) => ELetMut(n, fold_expr(v), fold_expr(b)),\n    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),\n    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),\n    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {\n      let (p, e) = a\n      (p, fold_expr(e))\n    }),\n    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, fold_expr(init))\n    }, fold_expr(b)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),\n    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {\n      fold_expr(a)\n    }, off),\n    EBinOp(op, l, r) => {\n      let fl = fold_expr(l)\n      let fr = fold_expr(r)\n      match fl {\n        EInt(a) => match fr {\n          EInt(b) => match fold_int_binop(op, a, b) {\n            Some(v) => EInt(v),\n            None => EBinOp(op, fl, fr)\n          },\n          _ => EBinOp(op, fl, fr)\n        },\n        _ => EBinOp(op, fl, fr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),\n    EDot(e, field, off) => EDot(fold_expr(e), field, off),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),\n    EThrow(e) => EThrow(fold_expr(e)),\n    EReturn(e) => EReturn(fold_expr(e)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(fold_expr(v))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      fold_expr(a)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, fold_expr(v))\n    }),\n    ESpread(e) => ESpread(fold_expr(e))\n  }\n}\n\nlet fresh_shadow_name: (Array[Int], String) -> String = (counter, name) -> {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(String::concat(\"__shadow_\", __to_string(n)), String::concat(\"_\", name))\n}\n\nlet uq_lookup: (Map[String, String], String) -> String = (env, name) -> {\n  if Map::has_key(env, name) {\n    Map::get(env, name)\n  } else {\n    name\n  }\n}\n\nlet uq_seen_contains: (Array[String], String) -> Bool = (seen, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(seen) {\n    if Array::get(seen, i) == name {\n      found = true\n    } else {\n      ()\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet uq_bind_name: (String, Map[String, String], Array[Int], Array[String]) -> (String, Map[String, String]) = (name, env, counter, seen) -> {\n  let nlen = String::length(name)\n  let lastc = if nlen > 0 {\n    String::char_code_at(name, nlen - 1)\n  } else {\n    0\n  }\n  if lastc == '~' || lastc == '?' {\n    (name, env)\n  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {\n    let fresh = fresh_shadow_name(counter, name)\n    (fresh, Map::set(env, name, fresh))\n  } else {\n    Array::push(seen, name)\n    (name, Map::set(env, name, name))\n  }\n}\n\nlet rec uq_pat_names: (Pat, Array[String]) -> Unit = (pat, out) -> {\n  match pat {\n    PBind(name) => Array::push(out, name),\n    PCtor(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        uq_pat_names(Array::get(args, i), out)\n        i = i + 1\n      }\n    },\n    PTuple(pats) => {\n      let mut i = 0\n      while i < Array::length(pats) {\n        uq_pat_names(Array::get(pats, i), out)\n        i = i + 1\n      }\n    },\n    POr(l, _r) => uq_pat_names(l, out),\n    PStruct(_, fields) => {\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (_, fp) = Array::get(fields, i)\n        uq_pat_names(fp, out)\n        i = i + 1\n      }\n    },\n    PInt(_) => (),\n    PString(_) => (),\n    PBool(_) => (),\n    PWild => ()\n  }\n}\n\nlet rec uq_pat_rewrite: (Pat, Map[String, String]) -> Pat = (pat, env) -> {\n  match pat {\n    PBind(name) => PBind(uq_lookup(env, name)),\n    PCtor(name, args) => PCtor(name, for a in args {\n      uq_pat_rewrite(a, env)\n    }),\n    PTuple(pats) => PTuple(for a in pats {\n      uq_pat_rewrite(a, env)\n    }),\n    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),\n    PStruct(name, fields) => PStruct(name, for f in fields {\n      let (fname, fp) = f\n      (fname, uq_pat_rewrite(fp, env))\n    }),\n    _ => pat\n  }\n}\n\nlet uq_bind_pat: (Pat, Map[String, String], Array[Int], Array[String]) -> (Pat, Map[String, String]) = (pat, env, counter, seen) -> {\n  let names: Array[String] = [\n  ]\n  uq_pat_names(pat, names)\n  let mut env2 = env\n  let mut i = 0\n  while i < Array::length(names) {\n    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)\n    env2 = env3\n    i = i + 1\n  }\n  (uq_pat_rewrite(pat, env2), env2)\n}\n\nexport let rec uniquify_shadowed_bindings: (Expr, Map[String, String], Array[Int], Array[String]) -> Expr = (expr, env, counter, seen) -> {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(name, off) => EIdent(uq_lookup(env, name), off),\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    EArray(items) => EArray(for it in items {\n      uniquify_shadowed_bindings(it, env, counter, seen)\n    }),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f\n      (n, uniquify_shadowed_bindings(v, env, counter, seen))\n    }),\n    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),\n    ELet(n, v, b) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    ELetRec(n, v, b) => {\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)\n      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    ELetMut(n, v, b) => {\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\n      let (p, e) = a\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\n    }),\n    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\n    ELoop(params, b) => {\n      let mut env2 = env\n      let zipped: Array[(String, Expr)] = [\n      ]\n      let mut pi = 0\n      while pi < Array::length(params) {\n        let (pn, init) = Array::get(params, pi)\n        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(zipped, (pn2, init2))\n        pi = pi + 1\n      }\n      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))\n    },\n    EForIn(n, idx, it, b) => {\n      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\n      let (idx2, env3) = match idx {\n        Some(iname) => {\n          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)\n          (Some(iname2), envI)\n        },\n        None => (None, env2)\n      }\n      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))\n    },\n    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),\n    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),\n    EFn(tp, bounds, params, ret, eff, body) => {\n      let mut env2 = env\n      let params2: Array[(String, Option[TypeExpr])] = [\n      ]\n      let mut fi = 0\n      while fi < Array::length(params) {\n        let (pn, pty) = Array::get(params, fi)\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\n        env2 = envN\n        Array::push(params2, (pn2, pty))\n        fi = fi + 1\n      }\n      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))\n    },\n    EDot(e, field, off) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),\n    EThrow(e) => EThrow(uniquify_shadowed_bindings(e, env, counter, seen)),\n    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      uniquify_shadowed_bindings(a, env, counter, seen)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, uniquify_shadowed_bindings(v, env, counter, seen))\n    }),\n    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))\n  }\n}\n\nlet fresh_m_scrut_name: (Array[Int]) -> String = (counter) -> {\n  let n = Array::get(counter, 0)\n  Array::set(counter, 0, n + 1)\n  String::concat(\"__m_scrut_\", __to_string(n))\n}\n\nexport let rec lift_match_scrutinees: (Expr, Array[Int]) -> Expr = (expr, counter) -> {\n  match expr {\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EIdent(_, _) => expr,\n    EUnit => expr,\n    EStringInterp(_) => expr,\n    ETuple(items) => ETuple(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    EArray(items) => EArray(for it in items {\n      lift_match_scrutinees(it, counter)\n    }),\n    ERecord(fields) => ERecord(for f in fields {\n      let (n, v) = f\n      (n, lift_match_scrutinees(v, counter))\n    }),\n    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),\n    ELet(n, v, b) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ELetMut(n, v, b) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\n    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),\n    EMatch(s, arms) => {\n      let lifted_arms = for a in arms {\n        let (p, e) = a\n        (p, lift_match_scrutinees(e, counter))\n      }\n      let ls = lift_match_scrutinees(s, counter)\n      match ls {\n        EIdent(_, _) => EMatch(ls, lifted_arms),\n        _ => {\n          let fresh = fresh_m_scrut_name(counter)\n          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms))\n        }\n      }\n    },\n    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {\n      let (p, e) = a\n      (p, lift_match_scrutinees(e, counter))\n    }),\n    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),\n    ELoop(params, b) => ELoop(for pr in params {\n      let (n, init) = pr\n      (n, lift_match_scrutinees(init, counter))\n    }, lift_match_scrutinees(b, counter)),\n    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),\n    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {\n      lift_match_scrutinees(a, counter)\n    }, off),\n    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),\n    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),\n    EDot(e, field, off) => EDot(lift_match_scrutinees(e, counter), field, off),\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),\n    EThrow(e) => EThrow(lift_match_scrutinees(e, counter)),\n    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),\n    EBreak(opt) => match opt {\n      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),\n      None => EBreak(None)\n    },\n    EContinue(args) => EContinue(for a in args {\n      lift_match_scrutinees(a, counter)\n    }),\n    EMap(fields) => EMap(for f in fields {\n      let (k, v) = f\n      (k, lift_match_scrutinees(v, counter))\n    }),\n    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))\n  }\n}\n\nlet fold_stmt: (Stmt) -> Stmt = (stmt) -> {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),\n    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),\n    STest(n, body) => STest(n, fold_expr(body)),\n    SBench(n, body) => SBench(n, fold_expr(body)),\n    SExpr(e) => SExpr(fold_expr(e)),\n    SLetPat(p, body) => SLetPat(p, fold_expr(body)),\n    _ => stmt\n  }\n}\n\nlet fold_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, fold_stmt(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\n\nlet literal_type: (Expr) -> Option[TypeExpr] = (e) -> {\n  match e {\n    EInt(_) => Some(TyName(\"Int\")),\n    EBool(_) => Some(TyName(\"Bool\")),\n    EString(_) => Some(TyName(\"String\")),\n    EFloat(_) => Some(TyName(\"Double\")),\n    _ => None\n  }\n}\n\nlet annotate_literal_let: (Stmt) -> Stmt = (stmt) -> {\n  match stmt {\n    SLet(exp, is_rec, name, ty, body) => match ty {\n      Some(_) => stmt,\n      None => match literal_type(body) {\n        Some(t) => SLet(exp, is_rec, name, Some(t), body),\n        None => stmt\n      }\n    },\n    _ => stmt\n  }\n}\n\nlet annotate_literal_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let out = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::push(out, annotate_literal_let(Array::get(stmts, i)))\n    i = i + 1\n  }\n  out\n}\n\nexport let normalize_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\n  let nonmods = empty_stmts()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    if !is_module_stmt(stmt) {\n      Array::push(nonmods, stmt)\n    }\n    i = i + 1\n  }\n  let result = empty_stmts()\n  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))\n  Array::push_all(result, live_top)\n  let mut m = 0\n  while m < Array::length(stmts) {\n    match Array::get(stmts, m) {\n      SModule(_, name, body) => {\n        let live_body = dce_stmts(body, exported_value_names(body))\n        let aliases = Array::slice([\n          (\"\", \"\")\n        ], 0, 0)\n        let _ = module_value_aliases(live_body, name, aliases)\n        let _ = flatten_module_body(live_body, name, aliases, result)\n        0\n      },\n      _ => 0\n    }\n    m = m + 1\n  }\n  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))\n  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))\n}\n\nexport let normalize_source: (String) -> String with { Error } = (src) -> {\n  let toks_cfg = lex(src)\n  let mut ci = 0\n  while ci < Array::length(toks_cfg) {\n    match Array::get(toks_cfg, ci) {\n      THash => throw(\"cannot normalize a source containing #cfg directives\"),\n      _ => ()\n    }\n    ci = ci + 1\n  }\n  let stmts = parse_program(toks_cfg)\n  let kept = normalize_stmts(stmts)\n  let sections = empty_strs()\n  let mut s = 0\n  while s <= 3 {\n    let rendered = render_section(kept, s)\n    if rendered != \"\" {\n      Array::push(sections, rendered)\n    }\n    s = s + 1\n  }\n  String::concat(String::join(sections, \"\\n\\n\"), \"\\n\")\n}\n")
}

let selfhost_source_143 = () -> (String, String) {
  ("vibe/compiler/desugar_trait_dict.vibe",
"\n\n\n\nlet empty_expr_array: () -> Array[Expr] = () -> {\n  Array::slice([\n    EUnit\n  ], 0, 0)\n}\n\nlet empty_str_array: () -> Array[String] = () -> {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\n  Array::slice([\n    TyUnit\n  ], 0, 0)\n}\n\nlet method_names_of_sigs: (Array[(String, Array[TypeExpr], TypeExpr)]) -> Array[String] = (methods) -> {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(methods) {\n    let (mname, _, _) = Array::get(methods, i)\n    Array::push(out, mname)\n    i = i + 1\n  }\n  out\n}\n\nlet str_array_contains: (Array[String], String) -> Bool = (arr, val) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if Array::get(arr, i) == val {\n      found = true\n      i = Array::length(arr)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet split_qualified: (String) -> Option[(String, String)] = (name) -> {\n  let idx = String::index_of(name, \"::\")\n  if idx < 0 {\n    None\n  } else {\n    let head = String::substring(name, 0, idx)\n    let member = String::substring(name, idx + 2, String::length(name))\n    Some((head, member))\n  }\n}\n\nlet dict_struct_name: (String) -> String = (trait_name) -> {\n  String::concat(trait_name, \"Dict\")\n}\n\nlet dict_param_name: (String, String) -> String = (trait_name, tparam) -> {\n  String::concat(\"__dict_\", String::concat(trait_name, String::concat(\"_\", tparam)))\n}\n\nlet collect_method_traits: (Array[Stmt]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", Array::slice([\n      (\"\", empty_type_exprs(), TyUnit)\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, methods, _) => if Array::length(methods) > 0 {\n        Array::push(out, (tname, methods))\n      } else {\n        ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\n\nlet empty_method_gens: () -> Array[(String, Array[String], Array[(String, Array[String])])] = () -> {\n  Array::slice([\n    (\"\", empty_str_array(), Array::slice([\n      (\"\", empty_str_array())\n    ], 0, 0))\n  ], 0, 0)\n}\n\nlet collect_trait_method_gens: (Array[Stmt]) -> Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", empty_method_gens())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, _, _, method_gens) => {\n        let mut any = false\n        let mut j = 0\n        while j < Array::length(method_gens) {\n          let (_, tps, _) = Array::get(method_gens, j)\n          if Array::length(tps) > 0 {\n            any = true\n          } else {\n            ()\n          }\n          j = j + 1\n        }\n        if any {\n          Array::push(out, (tname, method_gens))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_method_gen: (Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], String, String) -> Option[(Array[String], Array[(String, Array[String])])] = (table, trait_name, method) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(table) {\n    let (tn, gens) = Array::get(table, i)\n    if tn == trait_name {\n      let mut j = 0\n      while j < Array::length(gens) {\n        let (mname, tps, bounds) = Array::get(gens, j)\n        if mname == method && Array::length(tps) > 0 {\n          result = Some((tps, bounds))\n          j = Array::length(gens)\n        } else {\n          j = j + 1\n        }\n      }\n      i = Array::length(table)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet collect_impl_trait_map: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(_, _, trait_name, type_name) => Array::push(out, (type_name, trait_name)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_trait_method_param_types: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[Array[TypeExpr]] = (traits, trait_name, method) -> {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(sigs) {\n        let (mname, ptypes, _) = Array::get(sigs, j)\n        if mname == method {\n          result = Some(ptypes)\n          j = Array::length(sigs)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    None => None\n  }\n}\n\nlet find_method_generic_for_impl: (Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String, String) -> Option[(Array[String], Array[(String, Array[String])], Array[TypeExpr])] = (impl_map, gen_table, traits, type_name, method) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(impl_map) {\n    let (tn, trait_name) = Array::get(impl_map, i)\n    if tn == type_name {\n      match lookup_method_gen(gen_table, trait_name, method) {\n        Some(g) => {\n          let (tps, bounds) = g\n          match lookup_trait_method_param_types(traits, trait_name, method) {\n            Some(ptypes) => {\n              result = Some((tps, bounds, ptypes))\n              i = Array::length(impl_map)\n            },\n            None => {\n              i = i + 1\n            }\n          }\n        },\n        None => {\n          i = i + 1\n        }\n      }\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet annotate_params_from_sig: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, ptypes) -> {\n  let out = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    let new_ann = match ann {\n      Some(_) => ann,\n      None => if i < Array::length(ptypes) {\n        Some(Array::get(ptypes, i))\n      } else {\n        None\n      }\n    }\n    Array::push(out, (pname, new_ann))\n    i = i + 1\n  }\n  out\n}\n\nlet inject_method_generics: (Array[Stmt], Array[(String, String)], Array[(String, Array[(String, Array[String], Array[(String, Array[String])])])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, impl_map, gen_table, traits) -> {\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(exp, isrec, qname, ann, body) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => if Array::length(tparams) == 0 {\n          match split_qualified(qname) {\n            Some(parts) => {\n              let (cname, method) = parts\n              match find_method_generic_for_impl(impl_map, gen_table, traits, cname, method) {\n                Some(g) => {\n                  let (mtparams, mtbounds, ptypes) = g\n                  let new_params = annotate_params_from_sig(params, ptypes)\n                  let new_efn = EFn(mtparams, mtbounds, new_params, ret, eff, fbody)\n                  Array::set(stmts, i, SLet(exp, isrec, qname, ann, new_efn))\n                },\n                None => ()\n              }\n            },\n            None => ()\n          }\n        } else {\n          ()\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n}\n\nlet inject_trait_method_generics_with: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Unit = (stmts, traits) -> {\n  let method_gen_table = collect_trait_method_gens(stmts)\n  if Array::length(method_gen_table) > 0 {\n    let impl_map = collect_impl_trait_map(stmts)\n    inject_method_generics(stmts, impl_map, method_gen_table, traits)\n  } else {\n    ()\n  }\n}\n\nexport let inject_trait_method_generics: (Array[Stmt]) -> Unit = (stmts) -> {\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  inject_trait_method_generics_with(stmts, traits)\n}\n\nlet collect_trait_supers: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", empty_str_array())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      STrait(_, tname, supers, _, _) => Array::push(out, (tname, supers)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_supers: (Array[(String, Array[String])], String) -> Array[String] = (supers_map, name) -> {\n  let mut i = 0\n  let mut result = empty_str_array()\n  while i < Array::length(supers_map) {\n    let (tname, supers) = Array::get(supers_map, i)\n    if tname == name {\n      result = supers\n      i = Array::length(supers_map)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet rec flatten_trait_sigs_into: (String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[String], Array[(String, Array[TypeExpr], TypeExpr)]) -> Unit = (tname, traits_raw, supers_map, acc_names, out) -> {\n  let supers = lookup_supers(supers_map, tname)\n  let mut s = 0\n  while s < Array::length(supers) {\n    flatten_trait_sigs_into(Array::get(supers, s), traits_raw, supers_map, acc_names, out)\n    s = s + 1\n  }\n  match lookup_trait_sigs(traits_raw, tname) {\n    Some(sigs) => {\n      let mut i = 0\n      while i < Array::length(sigs) {\n        let (mname, params, ret) = Array::get(sigs, i)\n        if str_array_contains(acc_names, mname) {\n          ()\n        } else {\n          Array::push(acc_names, mname)\n          Array::push(out, (mname, params, ret))\n        }\n        i = i + 1\n      }\n    },\n    None => ()\n  }\n}\n\nlet flatten_traits: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])]) -> Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])] = (traits_raw, supers_map) -> {\n  let out = Array::slice([\n    (\"\", Array::slice([\n      (\"\", empty_type_exprs(), TyUnit)\n    ], 0, 0))\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(traits_raw) {\n    let (tname, _) = Array::get(traits_raw, i)\n    let acc_names = empty_str_array()\n    let flat = Array::slice([\n      (\"\", empty_type_exprs(), TyUnit)\n    ], 0, 0)\n    flatten_trait_sigs_into(tname, traits_raw, supers_map, acc_names, flat)\n    Array::push(out, (tname, flat))\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_trait_sigs: (Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], String) -> Option[Array[(String, Array[TypeExpr], TypeExpr)]] = (traits, name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(traits) {\n    let (tname, sigs) = Array::get(traits, i)\n    if tname == name {\n      result = Some(sigs)\n      i = Array::length(traits)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet collect_struct_field_sets: (Array[Stmt]) -> Array[(String, Array[String])] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", empty_str_array())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, fields, _, _) => {\n        let names = empty_str_array()\n        let mut j = 0\n        while j < Array::length(fields) {\n          let (fname, _) = Array::get(fields, j)\n          Array::push(names, fname)\n          j = j + 1\n        }\n        Array::push(out, (sname, names))\n      },\n      SEnum(_, ename, _, _, _) => Array::push(out, (ename, empty_str_array())),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet make_dict_struct_stmt: (String, Array[(String, Array[TypeExpr], TypeExpr)]) -> Stmt = (trait_name, sigs) -> {\n  let fields = Array::slice([\n    (\"\", TyUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(sigs) {\n    let (mname, params, ret) = Array::get(sigs, i)\n    Array::push(fields, (mname, TyFn(params, ret, None)))\n    i = i + 1\n  }\n  SStruct(false, dict_struct_name(trait_name), fields, empty_str_array(), empty_str_array())\n}\n\nlet field_sets_match: (Array[String], Array[String]) -> Bool = (a, b) -> {\n  if Array::length(a) != Array::length(b) {\n    false\n  } else {\n    let mut i = 0\n    let mut ok = true\n    while i < Array::length(a) {\n      if str_array_contains(b, Array::get(a, i)) {\n        i = i + 1\n      } else {\n        ok = false\n        i = Array::length(a)\n      }\n    }\n    ok\n  }\n}\n\nlet struct_set_has: (Array[(String, Array[String])], String) -> Bool = (struct_sets, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(struct_sets) {\n    let (sname, _) = Array::get(struct_sets, i)\n    if sname == name {\n      found = true\n      i = Array::length(struct_sets)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet lookup_var_type: (Array[(String, String)], String) -> Option[String] = (var_types, name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(var_types) {\n    let (vn, vt) = Array::get(var_types, i)\n    if vn == name {\n      result = Some(vt)\n      i = Array::length(var_types)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet ctor_enum_of_name: (Array[(String, String)], String) -> Option[String] = (fn_returns, name) -> {\n  match fn_return_type(fn_returns, name) {\n    Some(t) => Some(t),\n    None => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match fn_return_type(fn_returns, member) {\n          Some(en) => if en == head {\n            Some(en)\n          } else {\n            None\n          },\n          None => None\n        }\n      },\n      None => None\n    }\n  }\n}\n\nlet infer_arg_type_name: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Option[String] = (arg, struct_sets, var_types, fn_returns) -> {\n  match arg {\n    EInt(_) => Some(\"Int\"),\n    EBool(_) => Some(\"Bool\"),\n    EString(_) => Some(\"String\"),\n    EFloat(_) => Some(\"Double\"),\n    EArray(_) => Some(\"Array\"),\n    EIdent(name, _) => if name == \"None\" {\n      Some(\"Option\")\n    } else {\n      match lookup_var_type(var_types, name) {\n        Some(t) => Some(t),\n        None => ctor_enum_of_name(fn_returns, name)\n      }\n    },\n    ECall(callee, _, _) => match callee {\n      EIdent(\"Some\", _) => Some(\"Option\"),\n      EIdent(\"Ok\", _) => Some(\"Result\"),\n      EIdent(\"Err\", _) => Some(\"Result\"),\n      EIdent(fname, _) => ctor_enum_of_name(fn_returns, fname),\n      EFn(_, _, params, _, _, _) => if Array::length(params) == 1 {\n        let (_, ann) = Array::get(params, 0)\n        match ann {\n          Some(TyName(n)) => Some(n),\n          Some(TyApp(n, _)) => Some(n),\n          _ => None\n        }\n      } else {\n        None\n      },\n      _ => None\n    },\n    ERecord(fields) => {\n      let names = empty_str_array()\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, _) = Array::get(fields, i)\n        Array::push(names, fname)\n        i = i + 1\n      }\n      let mut j = 0\n      let mut result = None\n      while j < Array::length(struct_sets) {\n        let (sname, sfields) = Array::get(struct_sets, j)\n        if field_sets_match(names, sfields) {\n          result = Some(sname)\n          j = Array::length(struct_sets)\n        } else {\n          j = j + 1\n        }\n      }\n      result\n    },\n    _ => None\n  }\n}\n\nlet empty_threaded: () -> Array[(String, String, Int)] = () -> {\n  Array::slice([\n    (\"\", \"\", 0)\n  ], 0, 0)\n}\n\nlet empty_dict_binds: () -> Array[(String, String, String, Array[String])] = () -> {\n  Array::slice([\n    (\"\", \"\", \"\", empty_str_array())\n  ], 0, 0)\n}\n\nlet already_threaded: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\n  if Array::length(params) == 0 {\n    false\n  } else {\n    let (pname, _) = Array::get(params, 0)\n    String::starts_with(pname, \"__dict_\")\n  }\n}\n\nlet find_recv_index: (Array[(String, Option[TypeExpr])], String) -> Int = (params, tp) -> {\n  let mut i = 0\n  let mut idx = -1\n  while i < Array::length(params) {\n    let (_, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(n)) => if n == tp {\n        idx = i\n        i = Array::length(params)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  idx\n}\n\nlet qualified_head: (String) -> String = (name) -> {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (head, _) = parts\n      head\n    },\n    None => \"\"\n  }\n}\n\nlet collect_generic_impl_types: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImpl(tparams, tbounds, _, type_name) => if Array::length(tparams) > 0 {\n        let mut has_bound = false\n        let mut bi = 0\n        while bi < Array::length(tbounds) {\n          let (_, bs) = Array::get(tbounds, bi)\n          let mut bj = 0\n          while bj < Array::length(bs) {\n            if Array::get(bs, bj) != \"\" {\n              has_bound = true\n            } else {\n              ()\n            }\n            bj = bj + 1\n          }\n          bi = bi + 1\n        }\n        if has_bound {\n          Array::push(out, type_name)\n        } else {\n          ()\n        }\n      } else (),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet build_gens: (Array[Stmt], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[String]) -> Array[(String, Array[(String, String, Int)])] = (stmts, traits, gimpl_types) -> {\n  let out = Array::slice([\n    (\"\", empty_threaded())\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, bounds, params, _, _, _) => if already_threaded(params) {\n          ()\n        } else {\n          let threaded = empty_threaded()\n          let mut bi = 0\n          while bi < Array::length(bounds) {\n            let (tp, trait_list) = Array::get(bounds, bi)\n            let mut ti = 0\n            while ti < Array::length(trait_list) {\n              let tr = Array::get(trait_list, ti)\n              match lookup_trait_sigs(traits, tr) {\n                Some(_) => {\n                  let ridx = find_recv_index(params, tp)\n                  if ridx >= 0 {\n                    Array::push(threaded, (tp, tr, ridx))\n                  } else if str_array_contains(gimpl_types, qualified_head(fname)) {\n                    Array::push(threaded, (tp, tr, 0 - 1))\n                  } else {\n                    ()\n                  }\n                },\n                None => ()\n              }\n              ti = ti + 1\n            }\n            bi = bi + 1\n          }\n          if Array::length(threaded) > 0 {\n            Array::push(out, (fname, threaded))\n          } else {\n            ()\n          }\n        },\n        _ => ()\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet lookup_gen: (Array[(String, Array[(String, String, Int)])], String) -> Option[Array[(String, String, Int)]] = (gens, name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(gens) {\n    let (gname, threaded) = Array::get(gens, i)\n    if gname == name {\n      result = Some(threaded)\n      i = Array::length(gens)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet find_dict_for_method: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, head, member) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, _, dict_pname, methods) = Array::get(dict_binds, i)\n    if tp == head && str_array_contains(methods, member) {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet find_dict_for_trait: (Array[(String, String, String, Array[String])], String, String) -> Option[String] = (dict_binds, tparam, trait_name) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(dict_binds) {\n    let (tp, tr, dict_pname, _) = Array::get(dict_binds, i)\n    if tp == tparam && tr == trait_name {\n      result = Some(dict_pname)\n      i = Array::length(dict_binds)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet first_array_elem: (Expr) -> Option[Expr] = (e) -> {\n  match e {\n    EArray(elems) => if Array::length(elems) > 0 {\n      Some(Array::get(elems, 0))\n    } else None,\n    _ => None\n  }\n}\n\nlet rec build_concrete_dict: (String, String, Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[(String, String, Int)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String)], Expr) -> Option[Expr] = (cname, trait_name, traits, gens, struct_sets, var_types, fn_returns, arg_expr) -> {\n  match lookup_trait_sigs(traits, trait_name) {\n    Some(sigs) => {\n      let mnames = method_names_of_sigs(sigs)\n      let recfields = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut mi = 0\n      let mut failed = false\n      while mi < Array::length(mnames) {\n        let m = Array::get(mnames, mi)\n        let qm = String::concat(cname, String::concat(\"::\", m))\n        if not(fn_exists(fn_returns, qm)) {\n          failed = true\n        } else {\n        match lookup_gen(gens, qm) {\n          Some(threaded) => {\n            match first_array_elem(arg_expr) {\n              Some(elem) => match infer_arg_type_name(elem, struct_sets, var_types, fn_returns) {\n                Some(en) => {\n                  let callargs = empty_expr_array()\n                  let mut bi = 0\n                  let mut subok = true\n                  while bi < Array::length(threaded) {\n                    let (_, btrait, _) = Array::get(threaded, bi)\n                    match build_concrete_dict(en, btrait, traits, gens, struct_sets, var_types, fn_returns, elem) {\n                      Some(sd) => Array::push(callargs, sd),\n                      None => {\n                        subok = false\n                      }\n                    }\n                    bi = bi + 1\n                  }\n                  if subok {\n                    Array::push(callargs, EIdent(\"__w\", -1))\n                    let closure = EFn(empty_str_array(), Array::slice([\n                      (\"\", empty_str_array())\n                    ], 0, 0), Array::slice([\n                      (\"__w\", None)\n                    ], 0, 1), None, None, ECall(EIdent(qm, -1), callargs, -1))\n                    Array::push(recfields, (m, closure))\n                  } else {\n                    failed = true\n                  }\n                },\n                None => {\n                  failed = true\n                }\n              },\n              None => {\n                failed = true\n              }\n            }\n          },\n          None => Array::push(recfields, (m, EIdent(qm, -1)))\n        }\n        }\n        mi = mi + 1\n      }\n      if failed {\n        None\n      } else {\n        Some(ERecord(recfields))\n      }\n    },\n    None => None\n  }\n}\n\nlet synth_dicts: (Array[(String, String, Int)], Array[Expr], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, Array[(String, String, Int)])]) -> Option[Array[Expr]] = (threaded, orig_args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) -> {\n  let dicts = empty_expr_array()\n  let mut ok = true\n  let mut bi = 0\n  while bi < Array::length(threaded) {\n    let (_, trait_name, recv_idx) = Array::get(threaded, bi)\n    if ok && recv_idx >= 0 && recv_idx < Array::length(orig_args) {\n      let recv_arg = Array::get(orig_args, recv_idx)\n      match infer_arg_type_name(recv_arg, struct_sets, var_types, fn_returns) {\n        Some(nm) => match find_dict_for_trait(dict_binds, nm, trait_name) {\n          Some(dict_pname) => Array::push(dicts, EIdent(dict_pname, -1)),\n          None => match build_concrete_dict(nm, trait_name, traits, gens, struct_sets, var_types, fn_returns, recv_arg) {\n            Some(dict) => Array::push(dicts, dict),\n            None => {\n              ok = false\n            }\n          }\n        },\n        None => {\n          ok = false\n        }\n      }\n    } else {\n      ok = false\n    }\n    bi = bi + 1\n  }\n  if ok {\n    Some(dicts)\n  } else {\n    None\n  }\n}\n\nlet concat_expr_arrays: (Array[Expr], Array[Expr]) -> Array[Expr] = (a, b) -> {\n  let out = empty_expr_array()\n  let mut i = 0\n  while i < Array::length(a) {\n    Array::push(out, Array::get(a, i))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(b) {\n    Array::push(out, Array::get(b, j))\n    j = j + 1\n  }\n  out\n}\n\nlet seed_var_types: (Array[(String, Option[TypeExpr])], Array[String], Array[(String, String)]) -> Array[(String, String)] = (params, tparams, base) -> {\n  let _ = tparams\n  let out = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut b = 0\n  while b < Array::length(base) {\n    Array::push(out, Array::get(base, b))\n    b = b + 1\n  }\n  let mut i = 0\n  while i < Array::length(params) {\n    let (pname, ann) = Array::get(params, i)\n    match ann {\n      Some(TyName(tn)) => Array::push(out, (pname, tn)),\n      Some(TyApp(tn, _)) => Array::push(out, (pname, tn)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet collect_fn_returns: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\n  let out = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, fname, _, body) => match body {\n        EFn(_, _, _, ret, _, _) => {\n          let rn = match ret {\n            Some(te) => match te {\n              TyName(n) => n,\n              TyApp(n, _) => n,\n              _ => \"\"\n            },\n            None => \"\"\n          }\n          Array::push(out, (fname, rn))\n        },\n        _ => ()\n      },\n      SEnum(_, ename, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (vname, _) = Array::get(variants, vi)\n          Array::push(out, (vname, ename))\n          vi = vi + 1\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet fn_exists: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(fn_returns) {\n    let (n, _) = Array::get(fn_returns, i)\n    if n == fname {\n      found = true\n      i = Array::length(fn_returns)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet fn_return_type: (Array[(String, String)], String) -> Option[String] = (fn_returns, fname) -> {\n  let mut i = 0\n  let mut result = None\n  while i < Array::length(fn_returns) {\n    let (n, rt) = Array::get(fn_returns, i)\n    if n == fname {\n      result = if String::length(rt) == 0 {\n        None\n      } else Some(rt)\n      i = Array::length(fn_returns)\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet build_iter_for_with: (String, Expr, Expr, Expr) -> Expr = (name, nextcall, iter, body) -> {\n  let some_arm = (PCtor(\"Some\", [\n    PTuple([\n      PBind(name),\n      PBind(\"__iter_rest\")\n    ])\n  ]), EAssign(\"__iter_cur\", EIdent(\"__iter_rest\", -1), body))\n  let none_arm = (PCtor(\"None\", Array::slice([\n    PWild\n  ], 0, 0)), EAssign(\"__iter_go\", EBool(false), EUnit))\n  let loop_body = EMatch(nextcall, [\n    some_arm,\n    none_arm\n  ])\n  ELet(\"__iter_src\", iter, ELetMut(\"__iter_cur\", EIdent(\"__iter_src\", -1), ELetMut(\"__iter_go\", EBool(true), EWhile(EIdent(\"__iter_go\", -1), loop_body))))\n}\n\nlet next_call_for: (String) -> Expr = (ctype) -> {\n  ECall(EIdent(String::concat(ctype, \"::next\"), -1), [\n    EIdent(\"__iter_cur\", -1)\n  ], -1)\n}\n\nlet build_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\n  build_iter_for_with(name, next_call_for(ctype), iter, body)\n}\n\nlet build_await_iter_for: (String, String, Expr, Expr) -> Expr = (name, ctype, iter, body) -> {\n  let awaited = ECall(EIdent(\"await\", -1), [\n    next_call_for(ctype)\n  ], -1)\n  build_iter_for_with(name, awaited, iter, body)\n}\n\nlet build_pull_for_in: (String, Option[String], Expr, Expr) -> Expr = (value_name, index_name, iterable, body) -> {\n  let some_arm = match index_name {\n    Some(ix) => ESeq(body, EAssign(ix, EBinOp(\"+\", EIdent(ix, -1), EInt(1)), EUnit)),\n    None => ESeq(body, EUnit)\n  }\n  let loop_body = EMatch(ECall(EIdent(\"__pull_next\", -1), Array::slice([\n    EUnit\n  ], 0, 0), -1), [\n    (PCtor(\"Some\", [\n      PBind(value_name)\n    ]), some_arm),\n    (PCtor(\"None\", Array::slice([\n      PWild\n    ], 0, 0)), EAssign(\"__pull_continue\", EBool(false), EUnit))\n  ])\n  let core_loop = ELetMut(\"__pull_continue\", EBool(true), EWhile(EIdent(\"__pull_continue\", -1), loop_body))\n  let with_index = match index_name {\n    Some(ix) => ELetMut(ix, EInt(0), core_loop),\n    None => core_loop\n  }\n  ELet(\"__pull_next\", iterable, with_index)\n}\n\nlet for_await_inner: (Expr) -> Option[Expr] = (iter) -> {\n  match iter {\n    ECall(callee, args, _) => match callee {\n      EIdent(nm, _) => if nm == \"__await_iter\" && Array::length(args) == 1 {\n        Some(Array::get(args, 0))\n      } else {\n        None\n      },\n      _ => None\n    },\n    _ => None\n  }\n}\n\nlet fn_return_is_future: (Array[(String, String)], String) -> Bool = (fn_returns, fname) -> {\n  match fn_return_type(fn_returns, fname) {\n    Some(head) => head == \"Future\",\n    None => false\n  }\n}\n\nlet classify_for_await_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns) -> {\n  match infer_arg_type_name(inner, struct_sets, var_types, fn_returns) {\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      if fn_return_is_future(fn_returns, String::concat(tn, \"::next\")) {\n        build_await_iter_for(name, tn, rinner, rbody)\n      } else {\n        build_iter_for(name, tn, rinner, rbody)\n      }\n    } else {\n      build_pull_for_in(name, idx, rinner, rbody)\n    },\n    None => build_pull_for_in(name, idx, rinner, rbody)\n  }\n}\n\nlet classify_sync_for_loop: (String, Option[String], Expr, Expr, Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns) -> {\n  match infer_arg_type_name(iter, struct_sets, var_types, fn_returns) {\n    Some(tn) => if fn_exists(fn_returns, String::concat(tn, \"::next\")) {\n      build_iter_for(name, tn, riter, rbody)\n    } else {\n      match fn_return_type(fn_returns, String::concat(tn, \"::iter\")) {\n        Some(itertype) => build_iter_for(name, itertype, ECall(EIdent(String::concat(tn, \"::iter\"), -1), [\n          riter\n        ], -1), rbody),\n        None => EForIn(name, idx, riter, rbody)\n      }\n    },\n    None => EForIn(name, idx, riter, rbody)\n  }\n}\n\nlet extend_var_types: (Array[(String, String)], String, Option[String]) -> Array[(String, String)] = (var_types, name, inferred) -> {\n  match inferred {\n    Some(tname) => {\n      let out = Array::slice([\n        (\"\", \"\")\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(var_types) {\n        Array::push(out, Array::get(var_types, i))\n        i = i + 1\n      }\n      Array::push(out, (name, tname))\n      out\n    },\n    None => var_types\n  }\n}\n\nlet qual_ctor_member: (String, String, Array[(String, Array[String])], Array[(String, String)]) -> Option[String] = (head, member, struct_sets, fn_returns) -> {\n  if struct_set_has(struct_sets, head) {\n    match fn_return_type(fn_returns, member) {\n      Some(en) => if en == head {\n        Some(member)\n      } else {\n        None\n      },\n      None => None\n    }\n  } else {\n    None\n  }\n}\n\nlet try_sentinel: (Expr, Array[Expr]) -> Int = (callee, args) -> {\n  match callee {\n    EIdent(n, _) => if n == \"__try_bind\" {\n      if Array::length(args) == 2 {\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, _) => if Array::length(ps) == 1 {\n            0\n          } else {\n            2\n          },\n          _ => 2\n        }\n      } else {\n        2\n      }\n    } else if n == \"__try_op\" {\n      if Array::length(args) == 1 {\n        1\n      } else {\n        2\n      }\n    } else {\n      2\n    },\n    _ => 2\n  }\n}\n\nlet lower_try_bind: (Expr, String, Expr, Option[String]) -> Expr = (val, name, rest, inferred) -> {\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EIdent(\"None\", -1))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(name)\n        ]), rest),\n        (PCtor(\"Err\", [\n          PBind(\"__bind_err\")\n        ]), ECall(EIdent(\"Err\", -1), [\n          EIdent(\"__bind_err\", -1)\n        ], -1))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(name)\n      ]), rest),\n      (PCtor(\"Err\", [\n        PBind(\"__bind_err\")\n      ]), ECall(EIdent(\"Err\", -1), [\n        EIdent(\"__bind_err\", -1)\n      ], -1))\n    ])\n  }\n}\n\nlet lower_try_op: (Expr, Option[String]) -> Expr = (val, inferred) -> {\n  match inferred {\n    Some(tn) => if tn == \"Option\" {\n      EMatch(val, [\n        (PCtor(\"Some\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EReturn(EIdent(\"None\", -1)))\n      ])\n    } else {\n      EMatch(val, [\n        (PCtor(\"Ok\", [\n          PBind(\"__try_v\")\n        ]), EIdent(\"__try_v\", -1)),\n        (PCtor(\"Err\", [\n          PBind(\"__try_e\")\n        ]), EReturn(ECall(EIdent(\"Err\", -1), [\n          EIdent(\"__try_e\", -1)\n        ], -1)))\n      ])\n    },\n    None => EMatch(val, [\n      (PCtor(\"Ok\", [\n        PBind(\"__try_v\")\n      ]), EIdent(\"__try_v\", -1)),\n      (PCtor(\"Err\", [\n        PBind(\"__try_e\")\n      ]), EReturn(ECall(EIdent(\"Err\", -1), [\n        EIdent(\"__try_e\", -1)\n      ], -1)))\n    ])\n  }\n}\n\nlet rec railway_rw: (Expr, Array[(String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, struct_sets, var_types, fn_returns) -> {\n  match expr {\n    ECall(callee, args, off) => {\n      let k = try_sentinel(callee, args)\n      if k == 0 {\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            let body_vars = extend_var_types(var_types, name, inferred)\n            let rwrest = railway_rw(rest, struct_sets, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if k == 1 {\n        let val = Array::get(args, 0)\n        let rwval = railway_rw(val, struct_sets, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n        ECall(railway_rw(callee, struct_sets, var_types, fn_returns), for a in args {\n          railway_rw(a, struct_sets, var_types, fn_returns)\n        }, off)\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(e) => ESpread(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EStringInterp(_) => expr,\n    EIdent(_, _) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    }),\n    ERecord(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, railway_rw(fval, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(out)\n    },\n    EMap(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, railway_rw(v, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(t, struct_sets, var_types, fn_returns), railway_rw(e, struct_sets, var_types, fn_returns)),\n    ELet(name, val, body) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\n    },\n    ELetRec(name, val, body) => ELetRec(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    ELetMut(name, val, body) => {\n      let new_val = railway_rw(val, struct_sets, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, railway_rw(body, struct_sets, body_vars, fn_returns))\n    },\n    EAssign(name, val, cont) => EAssign(name, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, railway_rw(val, struct_sets, var_types, fn_returns), railway_rw(cont, struct_sets, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(railway_rw(a, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, railway_rw(b, struct_sets, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(railway_rw(scrut, struct_sets, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(railway_rw(c, struct_sets, var_types, fn_returns), railway_rw(b, struct_sets, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, railway_rw(init, struct_sets, var_types, fn_returns))\n    }, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => EForIn(name, idx, railway_rw(iter, struct_sets, var_types, fn_returns), railway_rw(body, struct_sets, var_types, fn_returns)),\n    EBinOp(op, l, r) => EBinOp(op, railway_rw(l, struct_sets, var_types, fn_returns), railway_rw(r, struct_sets, var_types, fn_returns)),\n    EUnaryOp(op, e) => EUnaryOp(op, railway_rw(e, struct_sets, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, railway_rw(body, struct_sets, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off) => EDot(railway_rw(obj, struct_sets, var_types, fn_returns), field, off),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, railway_rw(body, struct_sets, var_types, fn_returns)),\n    EThrow(e) => EThrow(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EReturn(e) => EReturn(railway_rw(e, struct_sets, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(railway_rw(e, struct_sets, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      railway_rw(e, struct_sets, var_types, fn_returns)\n    })\n  }\n}\n\nlet rec railway_rw_stmt: (Stmt, Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (s, struct_sets, fn_returns) -> {\n  let no_vars = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  match s {\n    SLet(exp, isrec, fname, ann, body) => SLet(exp, isrec, fname, ann, railway_rw(body, struct_sets, no_vars, fn_returns)),\n    SLetMut(name, ty, e) => SLetMut(name, ty, railway_rw(e, struct_sets, no_vars, fn_returns)),\n    STest(name, body) => STest(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\n    SBench(name, body) => SBench(name, railway_rw(body, struct_sets, no_vars, fn_returns)),\n    SExpr(e) => SExpr(railway_rw(e, struct_sets, no_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for inner in body {\n      railway_rw_stmt(inner, struct_sets, fn_returns)\n    }),\n    _ => s\n  }\n}\n\nexport let desugar_railway_binds: (Array[Stmt]) -> Unit = (stmts) -> {\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, railway_rw_stmt(Array::get(stmts, i), struct_sets, fn_returns))\n    i = i + 1\n  }\n}\n\nlet rec rewrite_expr: (Expr, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String, String, Array[String])], Array[(String, String)], Array[(String, String)]) -> Expr = (expr, gens, traits, struct_sets, dict_binds, var_types, fn_returns) -> {\n  match expr {\n    EIdent(name, off) => match split_qualified(name) {\n      Some(parts) => {\n        let (head, member) = parts\n        match find_dict_for_method(dict_binds, head, member) {\n          Some(dict_pname) => EDot(EIdent(dict_pname, -1), member, -1),\n          None => match qual_ctor_member(head, member, struct_sets, fn_returns) {\n            Some(m) => EIdent(m, off),\n            None => expr\n          }\n        }\n      },\n      None => expr\n    },\n    ECall(callee, args, off) => {\n      let try_kind = try_sentinel(callee, args)\n      if try_kind == 0 {\n        let val = Array::get(args, 0)\n        match Array::get(args, 1) {\n          EFn(_, _, ps, _, _, rest) => {\n            let (name, _) = Array::get(ps, 0)\n            let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n            let inferred = infer_arg_type_name(val, struct_sets, var_types, fn_returns)\n            let body_vars = extend_var_types(var_types, name, inferred)\n            let rwrest = rewrite_expr(rest, gens, traits, struct_sets, dict_binds, body_vars, fn_returns)\n            lower_try_bind(rwval, name, rwrest, inferred)\n          },\n          _ => EUnit\n        }\n      } else if try_kind == 1 {\n        let val = Array::get(args, 0)\n        let rwval = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n        lower_try_op(rwval, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      } else {\n      let rwargs = for a in args {\n        rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      }\n      match callee {\n        EIdent(name0, coff) => {\n          let name = match split_qualified(name0) {\n            Some(parts0) => {\n              let (h0, m0) = parts0\n              match qual_ctor_member(h0, m0, struct_sets, fn_returns) {\n                Some(mm) => mm,\n                None => name0\n              }\n            },\n            None => name0\n          }\n          let as_method = match split_qualified(name) {\n            Some(parts) => {\n              let (head, member) = parts\n              find_dict_for_method(dict_binds, head, member)\n            },\n            None => None\n          }\n          match as_method {\n            Some(dict_pname) => ECall(EDot(EIdent(dict_pname, -1), member_of(name), -1), rwargs, off),\n            None => match lookup_gen(gens, name) {\n              Some(threaded) => match synth_dicts(threaded, args, traits, struct_sets, var_types, dict_binds, fn_returns, gens) {\n                Some(dicts) => ECall(EIdent(name, coff), concat_expr_arrays(dicts, rwargs), off),\n                None => ECall(EIdent(name, coff), rwargs, off)\n              },\n              None => ECall(EIdent(name, coff), rwargs, off)\n            }\n          }\n        },\n        EDot(obj, m, doff) => ECall(EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), m, doff), rwargs, off),\n        _ => ECall(rewrite_expr(callee, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rwargs, off)\n      }\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    ESpread(_) => expr,\n    EStringInterp(_) => expr,\n    ETuple(elems) => ETuple(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    EArray(elems) => EArray(for e in elems {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    }),\n    ERecord(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (fname, fval) = Array::get(fields, i)\n        Array::push(out, (fname, rewrite_expr(fval, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      ERecord(out)\n    },\n    EMap(fields) => {\n      let out = Array::slice([\n        (\"\", EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(fields) {\n        let (k, v) = Array::get(fields, i)\n        Array::push(out, (k, rewrite_expr(v, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMap(out)\n    },\n    EIf(c, t, e) => EIf(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(t, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELet(name, val, body) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELet(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\n    },\n    ELetRec(name, val, body) => ELetRec(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELetMut(name, val, body) => {\n      let new_val = rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let body_vars = extend_var_types(var_types, name, infer_arg_type_name(val, struct_sets, var_types, fn_returns))\n      ELetMut(name, new_val, rewrite_expr(body, gens, traits, struct_sets, dict_binds, body_vars, fn_returns))\n    },\n    EAssign(name, val, cont) => EAssign(name, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EAssignOp(name, op, val, cont) => EAssignOp(name, op, rewrite_expr(val, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(cont, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ESeq(a, b) => ESeq(rewrite_expr(a, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EMatch(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EMatch(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EHandle(scrut, arms) => {\n      let out = Array::slice([\n        (PWild, EUnit)\n      ], 0, 0)\n      let mut i = 0\n      while i < Array::length(arms) {\n        let (p, b) = Array::get(arms, i)\n        Array::push(out, (p, rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)))\n        i = i + 1\n      }\n      EHandle(rewrite_expr(scrut, gens, traits, struct_sets, dict_binds, var_types, fn_returns), out)\n    },\n    EWhile(c, b) => EWhile(rewrite_expr(c, gens, traits, struct_sets, dict_binds, var_types, fn_returns), rewrite_expr(b, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    ELoop(params, body) => ELoop(for param in params {\n      let (name, init) = param\n      (name, rewrite_expr(init, gens, traits, struct_sets, dict_binds, var_types, fn_returns))\n    }, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EForIn(name, idx, iter, body) => {\n      let rbody = rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      match for_await_inner(iter) {\n        Some(inner) => {\n          let rinner = rewrite_expr(inner, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          classify_for_await_loop(name, idx, inner, rinner, rbody, struct_sets, var_types, fn_returns)\n        },\n        None => {\n          let riter = rewrite_expr(iter, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n          if Array::length(traits) == 0 {\n            EForIn(name, idx, riter, rbody)\n          } else {\n            classify_sync_for_loop(name, idx, iter, riter, rbody, struct_sets, var_types, fn_returns)\n          }\n        }\n      }\n    },\n    EBinOp(op, l, r) => {\n      let rl = rewrite_expr(l, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      let rr = rewrite_expr(r, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n      if op == \"==\" || op == \"!=\" {\n        let empty_l = is_empty_array_lit(l)\n        let empty_r = is_empty_array_lit(r)\n        let arr_elem = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        if empty_l || empty_r {\n          let other = if empty_l {\n            rr\n          } else {\n            rl\n          }\n          let lencmp = EBinOp(\"==\", ECall(EIdent(\"Array::length\", -1), [\n            other\n          ], -1), EInt(0))\n          if op == \"==\" {\n            lencmp\n          } else {\n            ECall(EIdent(\"not\", -1), [\n              lencmp\n            ], -1)\n          }\n        } else {\n        match arr_elem {\n          Some(elem) => {\n            let call = ECall(EIdent(arr_equals_name(elem), -1), [\n              rl,\n              rr\n            ], -1)\n            if op == \"==\" {\n              call\n            } else {\n              ECall(EIdent(\"not\", -1), [\n                call\n              ], -1)\n            }\n          },\n          None => {\n            let ty = match infer_arg_type_name(l, struct_sets, var_types, fn_returns) {\n              Some(t) => Some(t),\n              None => infer_arg_type_name(r, struct_sets, var_types, fn_returns)\n            }\n            match ty {\n              Some(t) => if struct_set_has(struct_sets, t) {\n                let call = ECall(EIdent(String::concat(t, \"::equals\"), -1), [\n                  rl,\n                  rr\n                ], -1)\n                if op == \"==\" {\n                  call\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    call\n                  ], -1)\n                }\n              } else if t == \"Option\" {\n                let eqm = opt_eq_match(rl, rr)\n                if op == \"==\" {\n                  eqm\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    eqm\n                  ], -1)\n                }\n              } else if t == \"Result\" {\n                let eqm = result_eq_match(rl, rr)\n                if op == \"==\" {\n                  eqm\n                } else {\n                  ECall(EIdent(\"not\", -1), [\n                    eqm\n                  ], -1)\n                }\n              } else {\n                EBinOp(op, rl, rr)\n              },\n              None => EBinOp(op, rl, rr)\n            }\n          }\n        }\n        }\n      } else {\n        EBinOp(op, rl, rr)\n      }\n    },\n    EUnaryOp(op, e) => EUnaryOp(op, rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EFn(tp, bs, ps, ret, eff, body) => EFn(tp, bs, ps, ret, eff, rewrite_expr(body, gens, traits, struct_sets, dict_binds, seed_var_types(ps, tp, var_types), fn_returns)),\n    EDot(obj, field, off) => EDot(rewrite_expr(obj, gens, traits, struct_sets, dict_binds, var_types, fn_returns), field, off),\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_expr(body, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EThrow(e) => EThrow(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EReturn(e) => EReturn(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)),\n    EBreak(opt) => match opt {\n      Some(e) => EBreak(Some(rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns))),\n      None => expr\n    },\n    EContinue(exprs) => EContinue(for e in exprs {\n      rewrite_expr(e, gens, traits, struct_sets, dict_binds, var_types, fn_returns)\n    })\n  }\n}\n\nlet member_of: (String) -> String = (name) -> {\n  match split_qualified(name) {\n    Some(parts) => {\n      let (_, member) = parts\n      member\n    },\n    None => name\n  }\n}\n\nlet dict_binds_of: (Array[(String, String, Int)], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])]) -> Array[(String, String, String, Array[String])] = (threaded, traits) -> {\n  let out = empty_dict_binds()\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let methods = match lookup_trait_sigs(traits, trait_name) {\n      Some(sigs) => method_names_of_sigs(sigs),\n      None => empty_str_array()\n    }\n    Array::push(out, (tp, trait_name, dict_param_name(trait_name, tp), methods))\n    i = i + 1\n  }\n  out\n}\n\nlet thread_dict_params: (Array[(String, String, Int)], Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (threaded, params) -> {\n  let result = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(threaded) {\n    let (tp, trait_name, _) = Array::get(threaded, i)\n    let dty = TyApp(dict_struct_name(trait_name), [\n      TyName(tp)\n    ])\n    Array::push(result, (dict_param_name(trait_name, tp), Some(dty)))\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(params) {\n    Array::push(result, Array::get(params, j))\n    j = j + 1\n  }\n  result\n}\n\nlet rewrite_stmt: (Stmt, Array[(String, Array[(String, String, Int)])], Array[(String, Array[(String, Array[TypeExpr], TypeExpr)])], Array[(String, Array[String])], Array[(String, String)]) -> Stmt = (stmt, gens, traits, struct_sets, fn_returns) -> {\n  let no_binds = empty_dict_binds()\n  let no_vars = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  match stmt {\n    SLet(exp, isrec, fname, ann, body) => match lookup_gen(gens, fname) {\n      Some(threaded) => match body {\n        EFn(tparams, bounds, params, ret, eff, fbody) => {\n          let binds = dict_binds_of(threaded, traits)\n          let new_params = thread_dict_params(threaded, params)\n          let seeded = seed_var_types(params, tparams, no_vars)\n          let new_body = rewrite_expr(fbody, gens, traits, struct_sets, binds, seeded, fn_returns)\n          SLet(exp, isrec, fname, ann, EFn(tparams, bounds, new_params, ret, eff, new_body))\n        },\n        _ => stmt\n      },\n      None => SLet(exp, isrec, fname, ann, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns))\n    },\n    SLetMut(name, ty, e) => SLetMut(name, ty, rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    STest(name, body) => STest(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    SBench(name, body) => SBench(name, rewrite_expr(body, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    SExpr(e) => SExpr(rewrite_expr(e, gens, traits, struct_sets, no_binds, no_vars, fn_returns)),\n    SModule(exp, name, body) => SModule(exp, name, for s in body {\n      rewrite_stmt(s, gens, traits, struct_sets, fn_returns)\n    }),\n    _ => stmt\n  }\n}\n\n\nlet qualified_name: (String, String) -> String = (tname, method) -> {\n  String::concat(tname, String::concat(\"::\", method))\n}\n\nlet top_level_fn_exists: (Array[Stmt], String) -> Bool = (stmts, fname) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SLet(_, _, name, _, _) => if name == fname {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\nlet concat2: (Expr, Expr) -> Expr = (a, b) -> {\n  ECall(EIdent(\"String::concat\", -1), [\n    a,\n    b\n  ], -1)\n}\n\nlet rec ts_type_key: (TypeExpr) -> String = (ty) -> {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", ts_type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\nlet arr_to_string_name: (TypeExpr) -> String = (t) -> {\n  String::concat(\"__arr_to_string__\", ts_type_key(t))\n}\n\nlet rec show_for_typed: (TypeExpr, Expr, Array[String]) -> Expr = (fty, val, known_types) -> {\n  match fty {\n    TyName(\"String\") => val,\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner = show_for_typed(t, EIdent(\"__os_v\", -1), known_types)\n      let some_body = concat2(EString(\"Some(\"), concat2(inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__os_v\")\n        ], 0, 1)), some_body),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EString(\"None\"))\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_inner = show_for_typed(t, EIdent(\"__rs_v\", -1), known_types)\n      let err_inner = show_for_typed(e, EIdent(\"__rs_v\", -1), known_types)\n      let ok_body = concat2(EString(\"Ok(\"), concat2(ok_inner, EString(\")\")))\n      let err_body = concat2(EString(\"Err(\"), concat2(err_inner, EString(\")\")))\n      EMatch(val, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), ok_body),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__rs_v\")\n        ], 0, 1)), err_body)\n      ], 0, 2))\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let pats = Array::slice([\n        PWild\n      ], 0, 0)\n      let mut i = 0\n      while i < n {\n        Array::push(pats, PBind(String::concat(\"__ts_t\", idx_str(i))))\n        i = i + 1\n      }\n      let segs = empty_expr_array()\n      Array::push(segs, EString(\"(\"))\n      let mut k = 0\n      while k < n {\n        if k > 0 {\n          Array::push(segs, EString(\", \"))\n        } else {\n          ()\n        }\n        Array::push(segs, show_for_typed(Array::get(ts, k), EIdent(String::concat(\"__ts_t\", idx_str(k)), -1), known_types))\n        k = k + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      EMatch(val, Array::slice([\n        (PTuple(pats), acc)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_to_string_name(Array::get(args, 0)), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"to_string\"), -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    } else {\n      ECall(EIdent(\"__to_string\", -1), Array::slice([\n        val\n      ], 0, 1), -1)\n    },\n    _ => ECall(EIdent(\"__to_string\", -1), Array::slice([\n      val\n    ], 0, 1), -1)\n  }\n}\n\nlet field_show_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\n  show_for_typed(fty, EDot(EIdent(\"self\", -1), fname, -1), known_types)\n}\n\nlet gen_arr_to_string_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\n  let elem_get = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__as_i\", -1)\n  ], 0, 2), -1)\n  let elem_show = show_for_typed(elem_ty, elem_get, known_types)\n  let sep = EIf(EBinOp(\"==\", EIdent(\"__as_i\", -1), EInt(0)), EString(\"\"), EString(\", \"))\n  let append = concat2(concat2(EIdent(\"__as_acc\", -1), sep), elem_show)\n  let set_acc = EAssign(\"__as_acc\", append, EUnit)\n  let incr = EAssign(\"__as_i\", EBinOp(\"+\", EIdent(\"__as_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_acc, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__as_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let closed = concat2(EIdent(\"__as_acc\", -1), EString(\"]\"))\n  let body = ELetMut(\"__as_i\", EInt(0), ELetMut(\"__as_acc\", EString(\"[\"), ESeq(while_loop, closed)))\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, arr_to_string_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\nlet gen_show_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\n  let segs = empty_expr_array()\n  Array::push(segs, EString(String::concat(tname, \" { \")))\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    let sep = if i == 0 {\n      \"\"\n    } else \", \"\n    Array::push(segs, EString(String::concat(sep, String::concat(fname, \": \"))))\n    Array::push(segs, field_show_expr(fname, fty, known_types))\n    i = i + 1\n  }\n  Array::push(segs, EString(\" }\"))\n  let mut body = Array::get(segs, Array::length(segs) - 1)\n  let mut j = Array::length(segs) - 2\n  while j >= 0 {\n    body = concat2(Array::get(segs, j), body)\n    j = j - 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\nlet is_scalar_type_name: (String) -> Bool = (n) -> {\n  n == \"Int\" || n == \"Double\" || n == \"Bool\" || n == \"String\" || n == \"Char\" || n == \"Unit\" || n == \"Bytes\"\n}\n\nlet rec type_key: (TypeExpr) -> String = (ty) -> {\n  match ty {\n    TyName(n) => n,\n    TyApp(n, args) => {\n      let mut s = n\n      let mut i = 0\n      while i < Array::length(args) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(args, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyTuple(ts) => {\n      let mut s = \"Tup\"\n      let mut i = 0\n      while i < Array::length(ts) {\n        s = String::concat(s, String::concat(\"_\", type_key(Array::get(ts, i))))\n        i = i + 1\n      }\n      s\n    },\n    TyUnit => \"Unit\",\n    _ => \"Any\"\n  }\n}\n\nlet arr_equals_name: (TypeExpr) -> String = (t) -> {\n  String::concat(\"__arr_equals__\", type_key(t))\n}\n\nlet opt_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  let some_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let none_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"None\", Array::slice([\n      PWild\n    ], 0, 0)), EBool(true)),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Some\", Array::slice([\n      PBind(\"__oeq_l\")\n    ], 0, 1)), some_inner),\n    (PCtor(\"None\", Array::slice([\n      PWild\n    ], 0, 0)), none_inner)\n  ], 0, 2))\n}\n\nlet result_eq_match: (Expr, Expr) -> Expr = (lhs, rhs) -> {\n  let ok_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  let err_inner = EMatch(rhs, Array::slice([\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_r\")\n    ], 0, 1)), EBinOp(\"==\", EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1))),\n    (PWild, EBool(false))\n  ], 0, 2))\n  EMatch(lhs, Array::slice([\n    (PCtor(\"Ok\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), ok_inner),\n    (PCtor(\"Err\", Array::slice([\n      PBind(\"__req_l\")\n    ], 0, 1)), err_inner)\n  ], 0, 2))\n}\n\nlet rec eq_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\n  match fty {\n    TyName(n) => if n == \"Double\" || n == \"Float\" {\n      EBinOp(\"==\", ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        lhs\n      ], 0, 1), -1), ECall(EIdent(\"Double::to_float\", -1), Array::slice([\n        rhs\n      ], 0, 1), -1))\n    } else if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Option\", args) => if Array::length(args) == 1 {\n      let t = Array::get(args, 0)\n      let inner_eq = eq_for_typed(t, EIdent(\"__oeq_l\", -1), EIdent(\"__oeq_r\", -1), known_types)\n      let some_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_r\")\n        ], 0, 1)), inner_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let none_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), EBool(true)),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Some\", Array::slice([\n          PBind(\"__oeq_l\")\n        ], 0, 1)), some_inner),\n        (PCtor(\"None\", Array::slice([\n          PWild\n        ], 0, 0)), none_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(\"Result\", args) => if Array::length(args) == 2 {\n      let t = Array::get(args, 0)\n      let e = Array::get(args, 1)\n      let ok_eq = eq_for_typed(t, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let err_eq = eq_for_typed(e, EIdent(\"__req_l\", -1), EIdent(\"__req_r\", -1), known_types)\n      let ok_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), ok_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      let err_inner = EMatch(rhs, Array::slice([\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_r\")\n        ], 0, 1)), err_eq),\n        (PWild, EBool(false))\n      ], 0, 2))\n      EMatch(lhs, Array::slice([\n        (PCtor(\"Ok\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), ok_inner),\n        (PCtor(\"Err\", Array::slice([\n          PBind(\"__req_l\")\n        ], 0, 1)), err_inner)\n      ], 0, 2))\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyTuple(ts) => {\n      let n = Array::length(ts)\n      let lpats = Array::slice([\n        PWild\n      ], 0, 0)\n      let rpats = Array::slice([\n        PWild\n      ], 0, 0)\n      let mut i = 0\n      while i < n {\n        Array::push(lpats, PBind(String::concat(\"__teq_l\", idx_str(i))))\n        Array::push(rpats, PBind(String::concat(\"__teq_r\", idx_str(i))))\n        i = i + 1\n      }\n      let mut conj = EBool(true)\n      let mut j = n - 1\n      while j >= 0 {\n        let cmp = eq_for_typed(Array::get(ts, j), EIdent(String::concat(\"__teq_l\", idx_str(j)), -1), EIdent(String::concat(\"__teq_r\", idx_str(j)), -1), known_types)\n        conj = EBinOp(\"&&\", cmp, conj)\n        j = j - 1\n      }\n      let inner = EMatch(rhs, Array::slice([\n        (PTuple(rpats), conj)\n      ], 0, 1))\n      EMatch(lhs, Array::slice([\n        (PTuple(lpats), inner)\n      ], 0, 1))\n    },\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      ECall(EIdent(arr_equals_name(Array::get(args, 0)), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"equals\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EBinOp(\"==\", lhs, rhs)\n    },\n    _ => EBinOp(\"==\", lhs, rhs)\n  }\n}\n\nlet gen_arr_equals_fn: (TypeExpr, Array[String]) -> Stmt = (elem_ty, known_types) -> {\n  let len_a = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)\n  let len_b = ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"b\", -1)\n  ], 0, 1), -1)\n  let elem_a = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"a\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_b = ECall(EIdent(\"Array::get\", -1), Array::slice([\n    EIdent(\"b\", -1),\n    EIdent(\"__ae_i\", -1)\n  ], 0, 2), -1)\n  let elem_eq = eq_for_typed(elem_ty, elem_a, elem_b, known_types)\n  let not_eq = ECall(EIdent(\"not\", -1), Array::slice([\n    elem_eq\n  ], 0, 1), -1)\n  let set_false = EIf(not_eq, EAssign(\"__ae_ok\", EBool(false), EUnit), EUnit)\n  let incr = EAssign(\"__ae_i\", EBinOp(\"+\", EIdent(\"__ae_i\", -1), EInt(1)), EUnit)\n  let loop_body = ESeq(set_false, incr)\n  let while_loop = EWhile(EBinOp(\"<\", EIdent(\"__ae_i\", -1), ECall(EIdent(\"Array::length\", -1), Array::slice([\n    EIdent(\"a\", -1)\n  ], 0, 1), -1)), loop_body)\n  let body_eq = ELetMut(\"__ae_i\", EInt(0), ELetMut(\"__ae_ok\", EBool(true), ESeq(while_loop, EIdent(\"__ae_ok\", -1))))\n  let body = EIf(EBinOp(\"!=\", len_a, len_b), EBool(false), body_eq)\n  let arr_ty = TyApp(\"Array\", Array::slice([\n    elem_ty\n  ], 0, 1))\n  let params = Array::slice([\n    (\"a\", Some(arr_ty)),\n    (\"b\", Some(arr_ty))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, arr_equals_name(elem_ty), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\nlet field_eq_expr: (String, TypeExpr, Array[String]) -> Expr = (fname, fty, known_types) -> {\n  eq_for_typed(fty, EDot(EIdent(\"a\", -1), fname, -1), EDot(EIdent(\"b\", -1), fname, -1), known_types)\n}\n\nlet gen_eq_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\n  let mut body = EBool(true)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, fty) = Array::get(fields, i)\n    body = EBinOp(\"&&\", field_eq_expr(fname, fty, known_types), body)\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, body))\n}\n\nlet digit_str: (Int) -> String = (d) -> {\n  if d == 0 {\n    \"0\"\n  } else if d == 1 {\n    \"1\"\n  } else if d == 2 {\n    \"2\"\n  } else if d == 3 {\n    \"3\"\n  } else if d == 4 {\n    \"4\"\n  } else if d == 5 {\n    \"5\"\n  } else if d == 6 {\n    \"6\"\n  } else if d == 7 {\n    \"7\"\n  } else if d == 8 {\n    \"8\"\n  } else {\n    \"9\"\n  }\n}\n\nlet rec idx_str: (Int) -> String = (n) -> {\n  if n < 10 {\n    digit_str(n)\n  } else {\n    String::concat(idx_str(n / 10), digit_str(n % 10))\n  }\n}\n\nlet gen_enum_eq_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let outer_arms = Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let abinds = Array::slice([\n      PWild\n    ], 0, 0)\n    let bbinds = Array::slice([\n      PWild\n    ], 0, 0)\n    let mut fi = 0\n    while fi < nf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(fi))))\n      Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let mut body = EBool(true)\n    let mut bi = nf - 1\n    while bi >= 0 {\n      let cmp = eq_for_typed(Array::get(ftypes, bi), EIdent(String::concat(\"__a\", idx_str(bi)), -1), EIdent(String::concat(\"__b\", idx_str(bi)), -1), known_types)\n      body = EBinOp(\"&&\", cmp, body)\n      bi = bi - 1\n    }\n    let inner_arms = Array::slice([\n      (PCtor(vname, bbinds), body),\n      (PWild, EBool(false))\n    ], 0, 2)\n    let inner = EMatch(EIdent(\"b\", -1), inner_arms)\n    Array::push(outer_arms, (PCtor(vname, abinds), inner))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"equals\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Bool\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\nlet gen_compare_fn: (String, Array[(String, TypeExpr)]) -> Stmt = (tname, fields) -> {\n  let neg_one = 0 - 1\n  let mut body = EInt(0)\n  let mut i = Array::length(fields) - 1\n  while i >= 0 {\n    let (fname, _) = Array::get(fields, i)\n    let af = EDot(EIdent(\"a\", -1), fname, -1)\n    let bf = EDot(EIdent(\"b\", -1), fname, -1)\n    body = EIf(EBinOp(\"<\", af, bf), EInt(neg_one), EIf(EBinOp(\">\", af, bf), EInt(1), body))\n    i = i - 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(tname))),\n    (\"b\", Some(TyName(tname)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, body))\n}\n\nlet show_expr_typed: (Expr, TypeExpr, Array[String]) -> Expr = (val, fty, known_types) -> {\n  show_for_typed(fty, val, known_types)\n}\n\nlet gen_enum_show_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let arms = Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n  let mut vi = 0\n  while vi < Array::length(variants) {\n    let (vname, ftypes) = Array::get(variants, vi)\n    let nf = Array::length(ftypes)\n    let binds = Array::slice([\n      PWild\n    ], 0, 0)\n    let mut fi = 0\n    while fi < nf {\n      Array::push(binds, PBind(String::concat(\"__s\", idx_str(fi))))\n      fi = fi + 1\n    }\n    let body = if nf == 0 {\n      EString(vname)\n    } else {\n      let segs = empty_expr_array()\n      Array::push(segs, EString(String::concat(vname, \"(\")))\n      let mut si = 0\n      while si < nf {\n        let sep = if si == 0 {\n          \"\"\n        } else \", \"\n        if sep != \"\" {\n          Array::push(segs, EString(sep))\n        } else {\n          ()\n        }\n        Array::push(segs, show_expr_typed(EIdent(String::concat(\"__s\", idx_str(si)), -1), Array::get(ftypes, si), known_types))\n        si = si + 1\n      }\n      Array::push(segs, EString(\")\"))\n      let mut acc = Array::get(segs, Array::length(segs) - 1)\n      let mut j = Array::length(segs) - 2\n      while j >= 0 {\n        acc = concat2(Array::get(segs, j), acc)\n        j = j - 1\n      }\n      acc\n    }\n    Array::push(arms, (PCtor(vname, binds), body))\n    vi = vi + 1\n  }\n  let params = Array::slice([\n    (\"self\", Some(TyName(ename)))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"to_string\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, EMatch(EIdent(\"self\", -1), arms)))\n}\n\nlet gen_hash_key_fn: (String) -> Stmt = (tname) -> {\n  let body = ECall(EIdent(qualified_name(tname, \"to_string\"), -1), Array::slice([\n    EIdent(\"self\", -1)\n  ], 0, 1), -1)\n  let params = Array::slice([\n    (\"self\", Some(TyName(tname)))\n  ], 0, 1)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"hash_key\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"String\")), None, body))\n}\n\nlet collect_show_array_elems: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, keys) -> {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let et = Array::get(args, 0)\n      let k = ts_type_key(et)\n      if str_array_contains(keys, k) {\n        ()\n      } else {\n        Array::push(keys, k)\n        Array::push(acc, et)\n      }\n    } else {\n      ()\n    },\n    _ => ()\n  }\n}\n\nlet compare_for_typed: (TypeExpr, Expr, Expr, Array[String]) -> Expr = (fty, lhs, rhs, known_types) -> {\n  let neg_one = 0 - 1\n  match fty {\n    TyName(n) => if !is_scalar_type_name(n) && str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"compare\"), -1), Array::slice([\n        lhs,\n        rhs\n      ], 0, 2), -1)\n    } else {\n      EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n    },\n    _ => EIf(EBinOp(\"<\", lhs, rhs), EInt(neg_one), EIf(EBinOp(\">\", lhs, rhs), EInt(1), EInt(0)))\n  }\n}\n\nlet gen_enum_compare_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let neg_one = 0 - 1\n  let outer_arms = Array::slice([\n    (PWild, EUnit)\n  ], 0, 0)\n  let mut ai = 0\n  while ai < Array::length(variants) {\n    let (avname, aftypes) = Array::get(variants, ai)\n    let anf = Array::length(aftypes)\n    let abinds = Array::slice([\n      PWild\n    ], 0, 0)\n    let mut afi = 0\n    while afi < anf {\n      Array::push(abinds, PBind(String::concat(\"__a\", idx_str(afi))))\n      afi = afi + 1\n    }\n    let inner_arms = Array::slice([\n      (PWild, EUnit)\n    ], 0, 0)\n    let mut bi = 0\n    while bi < Array::length(variants) {\n      let (bvname, bftypes) = Array::get(variants, bi)\n      let bnf = Array::length(bftypes)\n      let bbinds = Array::slice([\n        PWild\n      ], 0, 0)\n      let mut bfi = 0\n      while bfi < bnf {\n        Array::push(bbinds, PBind(String::concat(\"__b\", idx_str(bfi))))\n        bfi = bfi + 1\n      }\n      let arm_body = if ai == bi {\n        let mut body = EInt(0)\n        let mut pi = anf - 1\n        while pi >= 0 {\n          let cmp = compare_for_typed(Array::get(aftypes, pi), EIdent(String::concat(\"__a\", idx_str(pi)), -1), EIdent(String::concat(\"__b\", idx_str(pi)), -1), known_types)\n          let prev = body\n          body = EIf(EBinOp(\"<\", cmp, EInt(0)), EInt(neg_one), EIf(EBinOp(\">\", cmp, EInt(0)), EInt(1), prev))\n          pi = pi - 1\n        }\n        body\n      } else if ai < bi {\n        EInt(neg_one)\n      } else {\n        EInt(1)\n      }\n      Array::push(inner_arms, (PCtor(bvname, bbinds), arm_body))\n      bi = bi + 1\n    }\n    Array::push(outer_arms, (PCtor(avname, abinds), EMatch(EIdent(\"b\", -1), inner_arms)))\n    ai = ai + 1\n  }\n  let params = Array::slice([\n    (\"a\", Some(TyName(ename))),\n    (\"b\", Some(TyName(ename)))\n  ], 0, 2)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"compare\"), None, EFn(no_tp, no_tb, params, Some(TyName(\"Int\")), None, EMatch(EIdent(\"a\", -1), outer_arms)))\n}\n\nlet default_for_type: (TypeExpr, Array[String]) -> Expr = (fty, known_types) -> {\n  match fty {\n    TyName(\"Int\") => EInt(0),\n    TyName(\"Double\") => EFloat(0.0),\n    TyName(\"Float\") => EFloat(0.0),\n    TyName(\"Bool\") => EBool(false),\n    TyName(\"String\") => EString(\"\"),\n    TyName(\"Unit\") => EUnit,\n    TyName(n) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyApp(\"Option\", _) => EIdent(\"None\", -1),\n    TyApp(\"Array\", _) => EArray(empty_expr_array()),\n    TyApp(n, _) => if str_array_contains(known_types, n) {\n      ECall(EIdent(qualified_name(n, \"default\"), -1), empty_expr_array(), -1)\n    } else {\n      EUnit\n    },\n    TyUnit => EUnit,\n    _ => EUnit\n  }\n}\n\nlet gen_default_fn: (String, Array[(String, TypeExpr)], Array[String]) -> Stmt = (tname, fields, known_types) -> {\n  let rec_fields = Array::slice([\n    (\"\", EUnit)\n  ], 0, 0)\n  let mut i = 0\n  while i < Array::length(fields) {\n    let (fname, fty) = Array::get(fields, i)\n    Array::push(rec_fields, (fname, default_for_type(fty, known_types)))\n    i = i + 1\n  }\n  let no_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(tname, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(tname)), None, ERecord(rec_fields)))\n}\n\nlet gen_enum_default_fn: (String, Array[(String, Array[TypeExpr])], Array[String]) -> Stmt = (ename, variants, known_types) -> {\n  let (vname, ftypes) = Array::get(variants, 0)\n  let body = if Array::length(ftypes) == 0 {\n    EIdent(vname, -1)\n  } else {\n    let args = empty_expr_array()\n    let mut i = 0\n    while i < Array::length(ftypes) {\n      Array::push(args, default_for_type(Array::get(ftypes, i), known_types))\n      i = i + 1\n    }\n    ECall(EIdent(vname, -1), args, -1)\n  }\n  let no_params = Array::slice([\n    (\"\", None)\n  ], 0, 0)\n  let no_tp = Array::slice([\n    \"\"\n  ], 0, 0)\n  let no_tb = Array::slice([\n    (\"\", no_tp)\n  ], 0, 0)\n  SLet(false, false, qualified_name(ename, \"default\"), None, EFn(no_tp, no_tb, no_params, Some(TyName(ename)), None, body))\n}\n\nlet rec collect_array_elem_types: (TypeExpr, Array[TypeExpr], Array[String]) -> Unit = (ty, acc, acc_keys) -> {\n  match ty {\n    TyApp(\"Array\", args) => if Array::length(args) == 1 {\n      let e = Array::get(args, 0)\n      let k = type_key(e)\n      if !str_array_contains(acc_keys, k) {\n        Array::push(acc, e)\n        Array::push(acc_keys, k)\n      } else {\n        ()\n      }\n      collect_array_elem_types(e, acc, acc_keys)\n    } else {\n      ()\n    },\n    TyApp(_, args) => {\n      let mut i = 0\n      while i < Array::length(args) {\n        collect_array_elem_types(Array::get(args, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    TyTuple(ts) => {\n      let mut i = 0\n      while i < Array::length(ts) {\n        collect_array_elem_types(Array::get(ts, i), acc, acc_keys)\n        i = i + 1\n      }\n    },\n    _ => ()\n  }\n}\n\nlet is_empty_array_lit: (Expr) -> Bool = (e) -> {\n  match e {\n    EArray(elems) => Array::length(elems) == 0,\n    _ => false\n  }\n}\n\nlet rec infer_earray_elem_type: (Expr) -> Option[TypeExpr] = (arr) -> {\n  match arr {\n    EArray(elems) => if Array::length(elems) == 0 {\n      None\n    } else {\n      match Array::get(elems, 0) {\n        EInt(_) => Some(TyName(\"Int\")),\n        EBool(_) => Some(TyName(\"Bool\")),\n        EString(_) => Some(TyName(\"String\")),\n        EFloat(_) => Some(TyName(\"Double\")),\n        EArray(_) => match infer_earray_elem_type(Array::get(elems, 0)) {\n          Some(inner) => Some(TyApp(\"Array\", Array::slice([\n            inner\n          ], 0, 1))),\n          None => None\n        },\n        _ => None\n      }\n    },\n    _ => None\n  }\n}\n\nlet rec collect_bare_array_eq_keys: (Expr, Array[TypeExpr], Array[String]) -> Unit = (e, acc, acc_keys) -> {\n  match e {\n    EBinOp(op, l, r) => {\n      if op == \"==\" || op == \"!=\" {\n        let et = match infer_earray_elem_type(l) {\n          Some(t) => Some(t),\n          None => infer_earray_elem_type(r)\n        }\n        match et {\n          Some(t) => {\n            let k = type_key(t)\n            if !str_array_contains(acc_keys, k) {\n              Array::push(acc, t)\n              Array::push(acc_keys, k)\n            } else {\n              ()\n            }\n            collect_array_elem_types(t, acc, acc_keys)\n          },\n          None => ()\n        }\n      } else {\n        ()\n      }\n      collect_bare_array_eq_keys(l, acc, acc_keys)\n      collect_bare_array_eq_keys(r, acc, acc_keys)\n    },\n    EInt(_) => (),\n    EFloat(_) => (),\n    EString(_) => (),\n    EBool(_) => (),\n    EIdent(_, _) => (),\n    EUnit => (),\n    ETuple(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    EArray(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ERecord(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EMap(fs) => {\n      let mut i = 0\n      while i < Array::length(fs) {\n        let (_, fe) = Array::get(fs, i)\n        collect_bare_array_eq_keys(fe, acc, acc_keys)\n        i = i + 1\n      }\n    },\n    EIf(c, t, el) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(t, acc, acc_keys)\n      collect_bare_array_eq_keys(el, acc, acc_keys)\n    },\n    ELet(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetRec(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELetMut(_, v, b) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EAssign(_, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    EAssignOp(_, _, v, c) => {\n      collect_bare_array_eq_keys(v, acc, acc_keys)\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n    },\n    ESeq(a, b) => {\n      collect_bare_array_eq_keys(a, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EMatch(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EHandle(s, arms) => {\n      collect_bare_array_eq_keys(s, acc, acc_keys)\n      collect_bare_array_eq_keys_arms(arms, acc, acc_keys)\n    },\n    EWhile(c, b) => {\n      collect_bare_array_eq_keys(c, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ELoop(params, b) => {\n      let mut i = 0\n      while i < Array::length(params) {\n        let (_, init) = Array::get(params, i)\n        collect_bare_array_eq_keys(init, acc, acc_keys)\n        i = i + 1\n      }\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    EForIn(_, _, it, b) => {\n      collect_bare_array_eq_keys(it, acc, acc_keys)\n      collect_bare_array_eq_keys(b, acc, acc_keys)\n    },\n    ECall(callee, args, _) => {\n      collect_bare_array_eq_keys(callee, acc, acc_keys)\n      collect_bare_array_eq_keys_list(args, acc, acc_keys)\n    },\n    EUnaryOp(_, x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EFn(_, _, _, _, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EDot(o, _, _) => collect_bare_array_eq_keys(o, acc, acc_keys),\n    ELabeledArg(_, _, b) => collect_bare_array_eq_keys(b, acc, acc_keys),\n    EThrow(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EReturn(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    EBreak(opt) => match opt {\n      Some(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n      None => ()\n    },\n    EContinue(es) => collect_bare_array_eq_keys_list(es, acc, acc_keys),\n    ESpread(x) => collect_bare_array_eq_keys(x, acc, acc_keys),\n    _ => ()\n  }\n}\n\nlet collect_bare_array_eq_keys_list: (Array[Expr], Array[TypeExpr], Array[String]) -> Unit = (es, acc, acc_keys) -> {\n  let mut i = 0\n  while i < Array::length(es) {\n    collect_bare_array_eq_keys(Array::get(es, i), acc, acc_keys)\n    i = i + 1\n  }\n}\n\nlet collect_bare_array_eq_keys_arms: (Array[(Pat, Expr)], Array[TypeExpr], Array[String]) -> Unit = (arms, acc, acc_keys) -> {\n  let mut i = 0\n  while i < Array::length(arms) {\n    let (_, b) = Array::get(arms, i)\n    collect_bare_array_eq_keys(b, acc, acc_keys)\n    i = i + 1\n  }\n}\n\nlet collect_decl_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\n  let out = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, _, _, _) => Array::push(out, name),\n      SEnum(_, ename, _, _, _) => Array::push(out, ename),\n      _ => ()\n    }\n    i = i + 1\n  }\n  out\n}\n\nexport let desugar_derives: (Array[Stmt]) -> Unit = (stmts) -> {\n  let gen = empty_stmt_list()\n  let known_types = collect_decl_type_names(stmts)\n  let arr_elems = empty_type_exprs()\n  let arr_keys = empty_str_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, name, fields, derives, _) => {\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(name, \"to_string\")) {\n          Array::push(gen, gen_show_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(name, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(name))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut fi = 0\n          while fi < Array::length(fields) {\n            let (_, fty) = Array::get(fields, fi)\n            collect_show_array_elems(fty, arr_elems, arr_keys)\n            fi = fi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(name, \"compare\")) {\n          Array::push(gen, gen_compare_fn(name, fields))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(name, \"default\")) {\n          Array::push(gen, gen_default_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n        if !top_level_fn_exists(stmts, qualified_name(name, \"equals\")) {\n          Array::push(gen, gen_eq_fn(name, fields, known_types))\n        } else {\n          ()\n        }\n      },\n      SEnum(_, ename, _, variants, derives) => {\n        if (str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\")) && !top_level_fn_exists(stmts, qualified_name(ename, \"to_string\")) {\n          Array::push(gen, gen_enum_show_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Hash\") && !top_level_fn_exists(stmts, qualified_name(ename, \"hash_key\")) {\n          Array::push(gen, gen_hash_key_fn(ename))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Show\") || str_array_contains(derives, \"Hash\") {\n          let mut vi = 0\n          while vi < Array::length(variants) {\n            let (_, ftypes) = Array::get(variants, vi)\n            let mut ti = 0\n            while ti < Array::length(ftypes) {\n              collect_show_array_elems(Array::get(ftypes, ti), arr_elems, arr_keys)\n              ti = ti + 1\n            }\n            vi = vi + 1\n          }\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Ord\") && !top_level_fn_exists(stmts, qualified_name(ename, \"compare\")) {\n          Array::push(gen, gen_enum_compare_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if str_array_contains(derives, \"Default\") && !top_level_fn_exists(stmts, qualified_name(ename, \"default\")) {\n          Array::push(gen, gen_enum_default_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n        if !top_level_fn_exists(stmts, qualified_name(ename, \"equals\")) {\n          Array::push(gen, gen_enum_eq_fn(ename, variants, known_types))\n        } else {\n          ()\n        }\n      },\n      _ => ()\n    }\n    i = i + 1\n  }\n  let elem_types = empty_type_exprs()\n  let elem_keys = empty_str_array()\n  let mut si = 0\n  while si < Array::length(stmts) {\n    match Array::get(stmts, si) {\n      SStruct(_, _, fields, _, _) => {\n        let mut fi = 0\n        while fi < Array::length(fields) {\n          let (_, fty) = Array::get(fields, fi)\n          collect_array_elem_types(fty, elem_types, elem_keys)\n          fi = fi + 1\n        }\n      },\n      SEnum(_, _, _, variants, _) => {\n        let mut vi = 0\n        while vi < Array::length(variants) {\n          let (_, ftypes) = Array::get(variants, vi)\n          let mut ti = 0\n          while ti < Array::length(ftypes) {\n            collect_array_elem_types(Array::get(ftypes, ti), elem_types, elem_keys)\n            ti = ti + 1\n          }\n          vi = vi + 1\n        }\n      },\n      SLet(_, _, _, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SLetMut(_, _, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SExpr(e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      STest(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      SBench(_, e) => collect_bare_array_eq_keys(e, elem_types, elem_keys),\n      _ => ()\n    }\n    si = si + 1\n  }\n  let mut wi = 0\n  while wi < Array::length(elem_types) {\n    collect_array_elem_types(Array::get(elem_types, wi), elem_types, elem_keys)\n    wi = wi + 1\n  }\n  let mut ei = 0\n  while ei < Array::length(elem_types) {\n    let et = Array::get(elem_types, ei)\n    if !top_level_fn_exists(stmts, arr_equals_name(et)) {\n      Array::push(gen, gen_arr_equals_fn(et, known_types))\n    } else {\n      ()\n    }\n    ei = ei + 1\n  }\n  let mut wi2 = 0\n  while wi2 < Array::length(arr_elems) {\n    collect_show_array_elems(Array::get(arr_elems, wi2), arr_elems, arr_keys)\n    wi2 = wi2 + 1\n  }\n  let mut ei2 = 0\n  while ei2 < Array::length(arr_elems) {\n    let et2 = Array::get(arr_elems, ei2)\n    if !top_level_fn_exists(stmts, arr_to_string_name(et2)) {\n      Array::push(gen, gen_arr_to_string_fn(et2, known_types))\n    } else {\n      ()\n    }\n    ei2 = ei2 + 1\n  }\n  let mut g = 0\n  while g < Array::length(gen) {\n    Array::push(stmts, Array::get(gen, g))\n    g = g + 1\n  }\n}\n\nlet empty_stmt_list: () -> Array[Stmt] = () -> {\n  Array::slice([\n    SExport([\n      \"\"\n    ])\n  ], 0, 0)\n}\n\nlet struct_decl_exists: (Array[Stmt], String) -> Bool = (stmts, name) -> {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SStruct(_, sname, _, _, _) => if sname == name {\n        found = true\n        i = Array::length(stmts)\n      } else {\n        i = i + 1\n      },\n      _ => {\n        i = i + 1\n      }\n    }\n  }\n  found\n}\n\nexport let desugar_trait_dicts: (Array[Stmt]) -> Unit = (stmts) -> {\n  desugar_derives(stmts)\n  let traits_raw = collect_method_traits(stmts)\n  let supers_map = collect_trait_supers(stmts)\n  let traits = flatten_traits(traits_raw, supers_map)\n  inject_trait_method_generics_with(stmts, traits)\n  let struct_sets = collect_struct_field_sets(stmts)\n  let fn_returns = collect_fn_returns(stmts)\n  let gimpl_types = collect_generic_impl_types(stmts)\n  let gens = build_gens(stmts, traits, gimpl_types)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    Array::set(stmts, i, rewrite_stmt(Array::get(stmts, i), gens, traits, struct_sets, fn_returns))\n    i = i + 1\n  }\n  if Array::length(traits_raw) == 0 {\n    ()\n  } else {\n    let mut ti = 0\n    while ti < Array::length(traits) {\n      let (trait_name, sigs) = Array::get(traits, ti)\n      if struct_decl_exists(stmts, dict_struct_name(trait_name)) {\n        ()\n      } else {\n        Array::push(stmts, make_dict_struct_stmt(trait_name, sigs))\n      }\n      ti = ti + 1\n    }\n  }\n}\n")
}

