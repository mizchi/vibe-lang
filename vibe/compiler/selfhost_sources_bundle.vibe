_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./compile_call.vibe {\\n  cc_is_borrow_ret_call, cc_is_loop_borrowed_ident, compile_call\\n}\\n\\nimport ./compile_expr_tail5.vibe {\\n  compile_expr_tail5\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\n//# Functions\\n\\n// A field projection `a.f` (EDot) read as a record-field value is a BORROW of\\n// the source aggregate. The constructed record OWNS its fields (its drop class\\n// recursively drops them), so the borrowed projection must be retained (#704)\\n// — otherwise dropping the source frees the value while the new record still\\n// points at it. Perceus tracks named bindings but emits no action for bare\\n// projections, so this guarded dup is the only owner-increment and does not\\n// double-count. Lambda literals (EFn) and other fresh values are already owned.\\nlet expr_is_projection: (Expr) -> Bool = (e) -> {\\n  match e {\\n    EDot(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let compile_expr_tail4: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\\n  match expr {\\n    EDot(obj, field, _) => {\\n      let fc = String::char_code_at(field, 0)\\n      let mut field_idx = if fc >= 48 && fc <= 57 {\\n        let mut vi = 0\\n        let mut vp = 0\\n        while vp < String::length(field) {\\n          vi = vi * 10 + (String::char_code_at(field, vp) - 48)\\n          vp = vp + 1\\n        }\\n        vi\\n      } else {\\n        let mut si_search = 0\\n        let mut found = -1\\n        while si_search < Array::length(ctx.ctor_table.struct_names) {\\n          let fnames = Array::get(ctx.ctor_table.struct_field_names, si_search)\\n          let mut fi = 0\\n          while fi < Array::length(fnames) {\\n            if Array::get(fnames, fi) == field {\\n              found = fi\\n              fi = Array::length(fnames)\\n            } else {\\n              fi = fi + 1\\n            }\\n          }\\n          if found >= 0 {\\n            si_search = Array::length(ctx.ctor_table.struct_names)\\n          } else {\\n            si_search = si_search + 1\\n          }\\n        }\\n        if found < 0 {\\n          throw(String::concat(\\\"unknown struct field: \\\", field))\\n        }\\n        found\\n      }\\n      let nl1 = compile_expr(buf, obj, local_names, next_local, ctx, ld)\\n      if fc >= 48 && fc <= 57 {\\n        // RC mode: the tuple value is an odd pointer (Stage 2); untag before use.\\n        if ctx.enable_rc {\\n          emit_i64_const(buf, -2)\\n          emit_i64_and(buf)\\n        }\\n        emit_i32_wrap_i64(buf)\\n        // RC mode: tuples carry an 8-byte header, so the payload starts at +8.\\n        let toff = if ctx.enable_rc {\\n          8 + field_idx * 8\\n        } else {\\n          field_idx * 8\\n        }\\n        emit_i64_load(buf, 3, toff)\\n      } else {\\n        emit_i64_const(buf, -2)\\n        emit_i64_and(buf)\\n        emit_i32_wrap_i64(buf)\\n        emit_i64_load(buf, 3, 8 + field_idx * 8)\\n      }\\n      nl1\\n    },\\n    ERecord(fields) => {\\n      let flen = Array::length(fields)\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__rec_ptr\\\")\\n      if ctx.enable_rc {\\n        // RC layout (mirrors the tuple in compile_expr_tail2.vibe):\\n        //   block_start: [alloc_size@0][rc_count@4][type_id@8][length@12][payload@16...]\\n        // The record value is (block_start+8) | 1 (records stay tagged), so the\\n        // live header is [alloc_size@ptr-8][rc_count@ptr-4][type_id@ptr+0]\\n        // [length@ptr+4] and field access stays at +8 (untag cancels the +8\\n        // pointer shift). type_id 0 preserves the existing record read semantics.\\n        let total = 16 + flen * 8\\n        // ADR-0055 Stage 4: allocate via the free-list search helper (__rc_alloc).\\n        emit_i64_const(buf, total)\\n        emit_call(buf, ctx.rc_alloc_func_idx)\\n        emit_local_set(buf, ptr_local)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, total)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store(buf, 2, 4)\\n        // ADR-0055 Stage 2c/3: drop-class byte (block+7) = 1 (field-vector); a\\n        // record is [type_id@value+0][len@value+4][fields@value+8+i*8], the same\\n        // shape the recursive rc_drop loops.\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 1)\\n        emit_i32_store8(buf, 0, 7)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 0)\\n        emit_i32_store(buf, 2, 8)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, flen)\\n        emit_i32_store(buf, 2, 12)\\n        let mut nl_r = next_local + 1\\n        let mut ri = 0\\n        while ri < flen {\\n          let (_, fexpr) = Array::get(fields, ri)\\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\\n          let val_local = nl_r\\n          Array::push(local_names, \\\"__rec_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_r = nl_r + 1\\n          // #708 follow-up (Codex review): a record field sourced from a\\n          // borrow-returning call (Array::get/Map::get/__rec_field/a user\\n          // wrapper) is exactly as much a borrow as a bare projection `a.f`\\n          // (see the comment above) -- without this retain, dropping the\\n          // source container after storing its element into an owning\\n          // record double-frees the element once the record is later\\n          // dropped too.\\n          // #715: also retain a bare-ident field whose binding is borrow-bound\\n          // or loop-borrowed (cc_is_loop_borrowed_ident) -- same gap as the\\n          // ETuple case in compile_expr_tail2.vibe (see the comment there).\\n          if ctx.enable_rc && (expr_is_projection(fexpr) || cc_is_borrow_ret_call(fexpr, ctx) || cc_is_loop_borrowed_ident(fexpr, ctx)) {\\n            emit_rc_dup_guarded(buf, val_local, ctx.rc_shadow)\\n          } else {\\n            ()\\n          }\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 16 + ri * 8)\\n          ri = ri + 1\\n        }\\n        // record value = (block_start + 8) | 1\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 8)\\n        emit_i64_add(buf)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_r\\n      } else {\\n        let obj_size = 8 + flen * 8\\n        emit_global_get(buf, 0)\\n        emit_i64_extend_i32_u(buf)\\n        emit_local_set(buf, ptr_local)\\n        emit_global_get(buf, 0)\\n        emit_i32_const(buf, obj_size)\\n        emit_i32_add(buf)\\n        emit_global_set(buf, 0)\\n        emit_heap_grow_after_heap_set(buf, ctx)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, 0)\\n        emit_i32_store(buf, 2, 0)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_const(buf, flen)\\n        emit_i32_store(buf, 2, 4)\\n        let mut nl_r = next_local + 1\\n        let mut ri = 0\\n        while ri < flen {\\n          let (_, fexpr) = Array::get(fields, ri)\\n          nl_r = compile_expr(buf, fexpr, local_names, nl_r, ctx, ld)\\n          let val_local = nl_r\\n          Array::push(local_names, \\\"__rec_val\\\")\\n          emit_local_set(buf, val_local)\\n          nl_r = nl_r + 1\\n          emit_local_get(buf, ptr_local)\\n          emit_i32_wrap_i64(buf)\\n          emit_local_get(buf, val_local)\\n          emit_i64_store(buf, 3, 8 + ri * 8)\\n          ri = ri + 1\\n        }\\n        emit_local_get(buf, ptr_local)\\n        emit_i64_const(buf, 1)\\n        emit_i64_or(buf)\\n        nl_r\\n      }\\n    },\\n    EMap(fields) => {\\n      let flen = Array::length(fields)\\n      let obj_size = 8 + flen * 2 * 8\\n      let ptr_local = next_local\\n      Array::push(local_names, \\\"__map_ptr\\\")\\n      emit_global_get(buf, 0)\\n      emit_i64_extend_i32_u(buf)\\n      emit_local_set(buf, ptr_local)\\n      emit_global_get(buf, 0)\\n      emit_i32_const(buf, obj_size)\\n      emit_i32_add(buf)\\n      emit_global_set(buf, 0)\\n      emit_heap_grow_after_heap_set(buf, ctx)\\n      emit_local_get(buf, ptr_local)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_const(buf, flen)\\n      emit_i32_store(buf, 2, 0)\\n      let mut nl_m = next_local + 1\\n      let mut mi = 0\\n      while mi < flen {\\n        let (key, val_expr) = Array::get(fields, mi)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        let key_idx = str_table_lookup(ctx.str_table.strs, key)\\n        if key_idx >= 0 {\\n          emit_str_ref(buf, Array::get(ctx.str_table.offsets, key_idx), Array::get(ctx.str_table.lengths, key_idx))\\n        } else {\\n          emit_i64_const(buf, 0)\\n        }\\n        emit_i64_store(buf, 3, 8 + mi * 16)\\n        emit_local_get(buf, ptr_local)\\n        emit_i32_wrap_i64(buf)\\n        nl_m = compile_expr(buf, val_expr, local_names, nl_m, ctx, ld)\\n        let val_local = nl_m\\n        Array::push(local_names, \\\"__map_val\\\")\\n        emit_local_set(buf, val_local)\\n        nl_m = nl_m + 1\\n        emit_local_get(buf, val_local)\\n        emit_i64_store(buf, 3, 8 + mi * 16 + 8)\\n        mi = mi + 1\\n      }\\n      emit_local_get(buf, ptr_local)\\n      nl_m\\n    },\\n    _ => compile_expr_tail5(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_73 = () -> (String, String) {\n  (\"vibe/compiler/codegen/expr/compile_expr_tail3.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_eletrec_val, get_eseq_first, get_eseq_second, get_estring_value, get_ereturn_expr, get_ethrow_expr, get_etuple_elems, get_eunaryop_expr, get_eunaryop_op, get_ewhile_body, get_ewhile_cond, get_match_arms, get_match_scrutinee, get_pbind_name, get_pbool_value, get_pctor_args, get_pctor_name, get_pint_value, get_pstring_value, get_ptuple_pats, get_slet_export, str_table_lookup\\n}\\n\\nimport .. / wasm_emit {\\n  emit_block_i64, emit_block_void, emit_br, emit_br_if, emit_call, emit_call_indirect, emit_code_section, emit_code_section_with_locals, emit_data_section, emit_data_section_multi, emit_drop, emit_element_section_active, emit_else, emit_end, emit_export_section, emit_export_section_multi, emit_exports_full, emit_exports_with_memory, emit_f64_add, emit_f64_const_bits, emit_f64_convert_i64_s, emit_f64_div, emit_f64_eq, emit_f64_ge, emit_f64_gt, emit_f64_le, emit_f64_lt, emit_f64_mul, emit_f64_ne, emit_f64_neg, emit_f64_reinterpret_i64, emit_f64_sub, emit_func_type_raw, emit_function_section, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_header, emit_i32_add, emit_i32_const, emit_i32_load, emit_i32_load8_u, emit_i32_store, emit_i32_store8, emit_i32_wrap_i64, emit_i64_add, emit_i64_and, emit_i64_const, emit_i64_div_s, emit_i64_eq, emit_i64_eqz, emit_i64_extend_i32_s, emit_i64_ge_s, emit_i64_gt_s, emit_i64_le_s, emit_i64_lt_s, emit_i64_mul, emit_i64_ne, emit_i64_or, emit_i64_reinterpret_f64, emit_i64_rem_s, emit_i64_shl, emit_i64_shr_s, emit_i64_sub, emit_i64_trunc_f64_s, emit_i64_xor, emit_if_i64, emit_if_void, emit_import_section_func, emit_local_get, emit_local_set, emit_local_tee, emit_loop_void, emit_memory_section, emit_name, emit_return, emit_table_section_funcref, emit_type_section, emit_type_section_multi, string_to_data\\n}\\n\\nimport ./compile_call.vibe {\\n  compile_call\\n}\\n\\nimport ./compile_expr_tail4.vibe {\\n  compile_expr_tail4\\n}\\n\\nimport ./compile_lambda.vibe {\\n  compile_lambda\\n}\\n\\nimport ./compile_match.vibe {\\n  compile_match\\n}\\n\\n//# Functions\\n\\nexport let compile_expr_tail3: (Bytes, Expr, Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, expr, local_names, next_local, ctx, ld, compile_expr) -> {\\n  let __tag = expr_tag(expr)\\n  if __tag == 19 {\\n    let cond = get_ewhile_cond(expr)\\n    let body = get_ewhile_body(expr)\\n    // #706: the locals live at the loop header are loop-borrowed — a consume of\\n    // one inside the cond/body re-executes each iteration and must dup so the\\n    // value survives the back-edge. Record them (RC only); restore after. Names\\n    // declared inside the body are appended past lb_base and removed by truncate.\\n    let lb_base = Array::length(ctx.loop_borrowed_names)\\n    if ctx.enable_rc {\\n      let mut lbi = 0\\n      while lbi < Array::length(local_names) {\\n        Array::push(ctx.loop_borrowed_names, Array::get(local_names, lbi))\\n        lbi = lbi + 1\\n      }\\n    } else {\\n      ()\\n    }\\n    emit_block_void(buf)\\n    emit_loop_void(buf)\\n    let w_cond_tag = expr_tag(cond)\\n    let nl1 = if w_cond_tag == 5 {\\n      let wcop = get_ebinop_op(cond)\\n      if wcop == \\\"<\\\" || wcop == \\\">\\\" || wcop == \\\"<=\\\" || wcop == \\\">=\\\" {\\n        let wlhs = get_ebinop_lhs(cond)\\n        let wrhs = get_ebinop_rhs(cond)\\n        let wnl1 = compile_expr(buf, wlhs, local_names, next_local, ctx, ld + 1)\\n        let wnl2 = compile_expr(buf, wrhs, local_names, wnl1, ctx, ld + 1)\\n        if wcop == \\\"<\\\" {\\n          emit_i64_lt_s(buf); emit_i32_eqz(buf)\\n        }\\n        else if wcop == \\\">\\\" {\\n          emit_i64_gt_s(buf); emit_i32_eqz(buf)\\n        }\\n        else if wcop == \\\"<=\\\" {\\n          emit_i64_le_s(buf); emit_i32_eqz(buf)\\n        }\\n        else {\\n          emit_i64_ge_s(buf); emit_i32_eqz(buf)\\n        }\\n        wnl2\\n      } else {\\n        let wnl = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)\\n        emit_i64_eqz(buf)\\n        wnl\\n      }\\n    } else {\\n      let wnl = compile_expr(buf, cond, local_names, next_local, ctx, ld + 1)\\n      emit_i64_eqz(buf)\\n      wnl\\n    }\\n    emit_br_if(buf, 1)\\n    let nl2 = compile_expr(buf, body, local_names, nl1, ctx, ld + 1)\\n    emit_drop(buf)\\n    emit_br(buf, 0)\\n    emit_end(buf)\\n    emit_end(buf)\\n    Array::truncate(ctx.loop_borrowed_names, lb_base)\\n    emit_i64_const(buf, 0)\\n    nl2\\n  } else if __tag == 20 {\\n    emit_br(buf, ld + 1)\\n    emit_i64_const(buf, 0)\\n    next_local\\n  } else if __tag == 21 {\\n    emit_br(buf, ld)\\n    emit_i64_const(buf, 0)\\n    next_local\\n  } else if __tag == 22 {\\n    emit_i64_const(buf, 0)\\n    next_local\\n  } else if __tag == 23 {\\n    let msg_expr = get_ethrow_expr(expr)\\n    let nl = compile_expr(buf, msg_expr, local_names, next_local, ctx, ld)\\n    bytebuf_push(buf, 8)\\n    bytebuf_push(buf, 2)\\n    nl\\n  } else if __tag == 24 {\\n    compile_lambda(buf, get_efn_params(expr), get_efn_body(expr), local_names, next_local, ctx, ld, compile_expr)\\n  } else if __tag == 26 {\\n    let ret_expr = get_ereturn_expr(expr)\\n    let nl = compile_expr(buf, ret_expr, local_names, next_local, ctx, ld)\\n    emit_return(buf)\\n    nl\\n  } else {\\n    compile_expr_tail4(buf, expr, local_names, next_local, ctx, ld, compile_expr)\\n  }\\n}\\n\")\n}\n\nlet cli_adapter_source_74 = () -> (String, String) {\n  (\"vibe/compiler/codegen/expr/compile_expr_tail2.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  Expr, Pat, Stmt, TypeExpr, bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, bytebuf_to_bytes, leb128_encode_s64, leb128_encode_u32\\n}\\n\\nimport .. / common_analysis {\\n  collect_free_vars, collect_strings_stmts, emit_closure_call_tail, emit_closure_resolve, emit_i64_extend_i32_u, is_mut_captured_in\\n}\\n\\nimport .. / common_base {\\n  CompileCtx, CtorTable, FuncTable, LambdaTable, StrTable, emit_binop_op, emit_heap_grow_after_heap_set, emit_i32_eq, emit_i32_eqz, emit_i32_ge_u, emit_i32_mul, emit_i32_ne, emit_i32_sub, emit_i64_load, emit_i64_store, emit_rc_dup_guarded, emit_str_ref, expr_tag, get_arm_body, get_arm_pat, get_ebinop_op, get_efn_body, get_eif_cond, get_eif_else, get_eif_then, get_elet_body, get_elet_name, get_elet_val, get_slet_expr, get_slet_name, is_efn, is_eident, is_etuple, is_pbind, is_pbool, is_pctor, is_pint, is_pstring, is_ptuple, is_pwild, is_slet, lookup_ctor, resolve_func, resolve_local\\n}\\n\\nimport .. / common_extractors {\\n  array_contains_str, emit_assignop_op, emit_memory_copy, find_catchall_idx, get_earray_elems, get_eassign_body, get_eassign_name, get_eassign_val, get_eassignop_body, get_eassignop_name, get_eassignop_op, get_eassignop_val, get_ebinop_lhs, get_ebinop_rhs, get_ebool_value, get_ecall_args, get_ecall_callee, get_efloat_value, get_efn_params, get_eforin_body, get_eforin_index, get_eforin_iter, get_eforin_name, get_eident_name, get_eint_value, get_eletmut_body, get_eletmut_name, get_eletmut_val, get_eletrec_body, get_eletrec_name, get_e