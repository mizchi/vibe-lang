, (bits>>56)&255)\\n}\\n\\nexport let emit_f64_const_lohi: (Bytes, Int, Int) -> Unit = (buf, lo, hi) -> {\\n  bytebuf_push9(buf, 68, lo&255, (lo>>8)&255, (lo>>16)&255, (lo>>24)&255, hi&255, (hi>>8)&255, (hi>>16)&255, (hi>>24)&255)\\n}\\n\\nlet op_i64_extend_i32_s = 172\\n\\nexport let emit_i64_trunc_f64_s: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i64_trunc_f64_s)\\n}\\n\\nexport let emit_struct_type_raw: (Bytes, Array[Int], Array[Int]) -> Unit = (buf, field_types, field_muts) -> {\\n  bytebuf_push_opcode_u32(buf, 95, Array::length(field_types))\\n  let mut i = 0\\n  while i < Array::length(field_types) {\\n    bytebuf_push2(buf, Array::get(field_types, i), Array::get(field_muts, i))\\n    i = i + 1\\n  }\\n}\\n\\nlet op_f64_convert_i64_s = 185\\n\\nexport let emit_i64_extend_i32_s: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i64_extend_i32_s)\\n}\\n\\nexport let emit_f64_convert_i64_s: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_convert_i64_s)\\n}\\n\\nlet op_f64_reinterpret_i64 = 191\\n\\nlet op_i64_reinterpret_f64 = 189\\n\\nexport let emit_f64_reinterpret_i64: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_f64_reinterpret_i64)\\n}\\n\\nexport let emit_i64_reinterpret_f64: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i64_reinterpret_f64)\\n}\\n\\nexport let emit_table_section_funcref: (Bytes, Int) -> Unit = (out, num_entries) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push2(content, type_funcref, 0)\\n  leb128_encode_u32(content, num_entries)\\n  bytebuf_push_section(out, sec_table, content)\\n}\\n\\nexport let emit_element_section_active: (Bytes, Array[Int]) -> Unit = (out, func_indices) -> {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  emit_i32_const(content, 0)\\n  emit_end(content)\\n  leb128_encode_u32(content, Array::length(func_indices))\\n  let mut i = 0\\n  while i < Array::length(func_indices) {\\n    leb128_encode_u32(content, Array::get(func_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, sec_element, content)\\n}\\n\\n\\n\\n\\n\\nlet builders_vt_i32 = 127\\n\\nlet builders_sec_data = 11\\n\\nlet sec_type = 1\\n\\nexport let string_to_data: (String) -> Bytes = (s) -> {\\n  let buf = bytebuf_new()\\n  let len = String::length(s)\\n  let mut i = 0\\n  while i < len {\\n    bytebuf_push(buf, String::char_code_at(s, i))\\n    i = i + 1\\n  }\\n  buf\\n}\\n\\nlet empty_int_array: () -> Array[Int] = () -> {\\n  Array::slice([\\n    0\\n  ], 0, 0)\\n}\\n\\nlet pair_int_array: (Int, Int) -> Array[Int] = (v0, v1) -> {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  values\\n}\\n\\nlet quad_int_array: (Int, Int, Int, Int) -> Array[Int] = (v0, v1, v2, v3) -> {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  Array::push(values, v3)\\n  values\\n}\\n\\nlet triple_int_array: (Int, Int, Int) -> Array[Int] = (v0, v1, v2) -> {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  values\\n}\\n\\nlet empty_bytes_array: () -> Array[Bytes] = () -> {\\n  Array::slice([\\n    bytebuf_new()\\n  ], 0, 0)\\n}\\n\\nlet pair_bytes_array: (Bytes, Bytes) -> Array[Bytes] = (v0, v1) -> {\\n  let values = empty_bytes_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  values\\n}\\n\\nlet builders_empty_string_array: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet pair_string_array: (String, String) -> Array[String] = (v0, v1) -> {\\n  let values = builders_empty_string_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  values\\n}\\n\\nexport let build_call_module: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section_multi(out, quad_int_array(1, 1, 2, 1))\\n  emit_function_section(out, pair_int_array(0, 1))\\n  emit_export_section_multi(out, pair_string_array(\\\"square\\\", \\\"sum_sq\\\"), pair_int_array(0, 1))\\n  let sq_body = bytebuf_new()\\n  emit_local_get(sq_body, 0)\\n  emit_local_get(sq_body, 0)\\n  emit_i64_mul(sq_body)\\n  let ss_body = bytebuf_new()\\n  emit_local_get(ss_body, 0)\\n  emit_call(ss_body, 0)\\n  emit_local_get(ss_body, 1)\\n  emit_call(ss_body, 0)\\n  emit_i64_add(ss_body)\\n  emit_code_section(out, pair_bytes_array(sq_body, ss_body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nlet triple_bytes_array: (Bytes, Bytes, Bytes) -> Array[Bytes] = (v0, v1, v2) -> {\\n  let values = empty_bytes_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  values\\n}\\n\\nlet singleton_int_array: (Int) -> Array[Int] = (v0) -> {\\n  let values = empty_int_array()\\n  Array::push(values, v0)\\n  values\\n}\\n\\nlet triple_string_array: (String, String, String) -> Array[String] = (v0, v1, v2) -> {\\n  let values = builders_empty_string_array()\\n  Array::push(values, v0)\\n  Array::push(values, v1)\\n  Array::push(values, v2)\\n  values\\n}\\n\\nlet singleton_bytes_array: (Bytes) -> Array[Bytes] = (v0) -> {\\n  let values = empty_bytes_array()\\n  Array::push(values, v0)\\n  values\\n}\\n\\nexport let build_add_module: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 2, 1)\\n  emit_function_section(out, singleton_int_array(0))\\n  emit_export_section(out, \\\"add\\\", 0)\\n  let body = bytebuf_new()\\n  emit_local_get(body, 0)\\n  emit_local_get(body, 1)\\n  emit_i64_add(body)\\n  emit_code_section(out, singleton_bytes_array(body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let build_factorial_module: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 1, 1)\\n  emit_function_section(out, singleton_int_array(0))\\n  emit_export_section(out, \\\"fact\\\", 0)\\n  let b = bytebuf_new()\\n  emit_i64_const(b, 1)\\n  emit_local_set(b, 1)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_le_s(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 0)\\n  emit_i64_mul(b)\\n  emit_local_set(b, 1)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 0)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 1)\\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(1))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let build_fibonacci_module: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 1, 1)\\n  emit_function_section(out, singleton_int_array(0))\\n  emit_export_section(out, \\\"fib\\\", 0)\\n  let b = bytebuf_new()\\n  emit_i64_const(b, 0)\\n  emit_local_set(b, 1)\\n  emit_i64_const(b, 1)\\n  emit_local_set(b, 2)\\n  emit_block_void(b)\\n  emit_loop_void(b)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 0)\\n  emit_i64_le_s(b)\\n  emit_br_if(b, 1)\\n  emit_local_get(b, 1)\\n  emit_local_get(b, 2)\\n  emit_i64_add(b)\\n  emit_local_set(b, 3)\\n  emit_local_get(b, 2)\\n  emit_local_set(b, 1)\\n  emit_local_get(b, 3)\\n  emit_local_set(b, 2)\\n  emit_local_get(b, 0)\\n  emit_i64_const(b, 1)\\n  emit_i64_sub(b)\\n  emit_local_set(b, 0)\\n  emit_br(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  emit_local_get(b, 1)\\n  emit_code_section_with_locals(out, singleton_bytes_array(b), singleton_int_array(3))\\n  bytebuf_to_bytes(out)\\n}\\n\\nlet singleton_string_array: (String) -> Array[String] = (v0) -> {\\n  let values = builders_empty_string_array()\\n  Array::push(values, v0)\\n  values\\n}\\n\\nexport let build_hello_module: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, 2)\\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, sec_type, type_content)\\n  emit_import_section_func(out, \\\"wasi_snapshot_preview1\\\", \\\"fd_write\\\", 0)\\n  emit_function_section(out, singleton_int_array(1))\\n  emit_memory_section(out, 1)\\n  emit_exports_with_memory(out, singleton_string_array(\\\"_start\\\"), singleton_int_array(1), \\\"memory\\\", 0)\\n  let b = bytebuf_new()\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 8)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 4)\\n  emit_i32_const(b, 12)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 100)\\n  emit_call(b, 0)\\n  emit_drop(b)\\n  emit_code_section(out, singleton_bytes_array(b))\\n  let hello_data = bytebuf_new()\\n  bytebuf_push(hello_data, 104)\\n  bytebuf_push(hello_data, 101)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 111)\\n  bytebuf_push(hello_data, 32)\\n  bytebuf_push(hello_data, 119)\\n  bytebuf_push(hello_data, 111)\\n  bytebuf_push(hello_data, 114)\\n  bytebuf_push(hello_data, 108)\\n  bytebuf_push(hello_data, 100)\\n  bytebuf_push(hello_data, 10)\\n  emit_data_section(out, 8, hello_data)\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let build_arithmetic_module: () -> Bytes = () -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  emit_type_section(out, 2, 1)\\n  emit_function_section(out, triple_int_array(0, 0, 0))\\n  emit_export_section_multi(out, triple_string_array(\\\"add\\\", \\\"sub\\\", \\\"mul\\\"), triple_int_array(0, 1, 2))\\n  let add_body = bytebuf_new()\\n  emit_local_get(add_body, 0)\\n  emit_local_get(add_body, 1)\\n  emit_i64_add(add_body)\\n  let sub_body = bytebuf_new()\\n  emit_local_get(sub_body, 0)\\n  emit_local_get(sub_body, 1)\\n  emit_i64_sub(sub_body)\\n  let mul_body = bytebuf_new()\\n  emit_local_get(mul_body, 0)\\n  emit_local_get(mul_body, 1)\\n  emit_i64_mul(mul_body)\\n  emit_code_section(out, triple_bytes_array(add_body, sub_body, mul_body))\\n  bytebuf_to_bytes(out)\\n}\\n\\nexport let emit_data_section_multi: (Bytes, Array[Int], Array[Bytes]) -> Unit = (out, offsets, datas) -> {\\n  let count = Array::length(offsets)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    bytebuf_push(content, 0)\\n    emit_i32_const(content, Array::get(offsets, i))\\n    emit_end(content)\\n    let data = Array::get(datas, i)\\n    leb128_encode_u32(content, Bytes::length(data))\\n    bytebuf_push_buf(content, data)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, builders_sec_data, content)\\n}\\n\\nexport let build_print_string_module: (String) -> Bytes = (msg) -> {\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, 2)\\n  emit_func_type_raw(type_content, quad_int_array(builders_vt_i32, builders_vt_i32, builders_vt_i32, builders_vt_i32), singleton_int_array(builders_vt_i32))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  bytebuf_push_section(out, sec_type, type_content)\\n  emit_import_section_func(out, \\\"wasi_snapshot_preview1\\\", \\\"fd_write\\\", 0)\\n  emit_function_section(out, singleton_int_array(1))\\n  emit_memory_section(out, 1)\\n  emit_exports_with_memory(out, singleton_string_array(\\\"_start\\\"), singleton_int_array(1), \\\"memory\\\", 0)\\n  let str_data = string_to_data(msg)\\n  let str_len = Bytes::length(str_data)\\n  let b = bytebuf_new()\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 16)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 4)\\n  emit_i32_const(b, str_len)\\n  emit_i32_store(b, 2, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 0)\\n  emit_i32_const(b, 1)\\n  emit_i32_const(b, 8)\\n  emit_call(b, 0)\\n  emit_drop(b)\\n  emit_code_section(out, singleton_bytes_array(b))\\n  emit_data_section(out, 16, str_data)\\n  bytebuf_to_bytes(out)\\n}\\n\\n\\n\\nlet simd_prefix = 253\\n\\nlet simd_v128_load = 0\\nlet simd_v128_store = 11\\n\\nlet simd_i8x16_splat = 15\\n\\nlet simd_i8x16_swizzle = 14\\n\\nlet simd_i8x16_eq = 35\\nlet simd_i8x16_le_u = 42\\nlet simd_i8x16_ge_u = 44\\n\\nlet simd_i8x16_sub = 113\\nlet simd_i8x16_min_u = 119\\n\\nlet simd_v128_any_true = 83\\n\\nlet simd_v128_and = 78\\nlet simd_v128_not = 77\\n\\nlet simd_i8x16_all_true = 99\\nlet simd_i8x16_bitmask = 100\\n\\nlet simd_v128_const = 12\\n\\n\\nexport let emit_v128_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_load)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport let emit_v128_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_store)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\n\\nexport let emit_i8x16_splat: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_splat)\\n}\\n\\n\\nexport let emit_i8x16_eq: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_eq)\\n}\\n\\nexport let emit_i8x16_le_u: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_le_u)\\n}\\n\\nexport let emit_i8x16_ge_u: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_ge_u)\\n}\\n\\nexport let emit_i8x16_swizzle: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_swizzle)\\n}\\n\\nexport let emit_i8x16_sub: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_sub)\\n}\\n\\nexport let emit_i8x16_min_u: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_min_u)\\n}\\n\\n\\nexport let emit_v128_any_true: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_any_true)\\n}\\n\\nexport let emit_i8x16_all_true: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_all_true)\\n}\\n\\nexport let emit_i8x16_bitmask: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_i8x16_bitmask)\\n}\\n\\n\\nexport let emit_v128_and: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_and)\\n}\\n\\nexport let emit_v128_or: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, 80)\\n}\\n\\nexport let emit_v128_not: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_not)\\n}\\n\\n\\nexport let emit_v128_const: (Bytes, Array[Int]) -> Unit = (buf, lanes) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_const)\\n  let n = Array::length(lanes)\\n  let mut i = 0\\n  while i < 16 {\\n    let b = if i < n {\\n      Array::get(lanes, i)\\n    } else {\\n      0\\n    }\\n    bytebuf_push(buf, b & 255)\\n    i = i + 1\\n  }\\n}\\n\\nexport let emit_v128_const_zero: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_const)\\n  let mut i = 0\\n  while i < 16 {\\n    bytebuf_push(buf, 0)\\n    i = i + 1\\n  }\\n}\\n\\nexport let emit_v128_const_splat_byte: (Bytes, Int) -> Unit = (buf, byte_val) -> {\\n  bytebuf_push(buf, simd_prefix)\\n  leb128_encode_u32(buf, simd_v128_const)\\n  let mut i = 0\\n  while i < 16 {\\n    bytebuf_push(buf, byte_val & 255)\\n    i = i + 1\\n  }\\n}\\n\\n\\n\\n\\n\\n\\nexport let emit_simd_memcmp_16: (Bytes) -> Unit = (buf) -> {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n\\n  emit_local_get(buf, 1)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n\\n  emit_i8x16_eq(buf)\\n  emit_i8x16_all_true(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n\\nexport let emit_simd_find_byte_16: (Bytes) -> Unit = (buf) -> {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n\\n  emit_local_get(buf, 1)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n\\n  emit_i8x16_eq(buf)\\n  emit_i8x16_bitmask(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n\\nexport let emit_simd_skip_whitespace_16: (Bytes) -> Unit = (buf) -> {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n  emit_local_set(buf, 2)  // local2 = chunk\\n\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x20)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x09)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n\\n  emit_v128_or(buf)\\n\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x0A)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n\\n  emit_v128_or(buf)\\n\\n  emit_local_get(buf, 2)\\n  emit_i64_const(buf, 0x0D)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n\\n  emit_v128_or(buf)\\n\\n  emit_v128_not(buf)\\n  emit_i8x16_bitmask(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n\\nexport let emit_simd_is_identifier_char_16: (Bytes) -> Unit = (buf) -> {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_v128_load(buf, 0, 0)\\n  emit_local_set(buf, 1)  // local1 = chunk\\n\\n  emit_local_get(buf, 1)\\n  emit_i64_const(buf, 0x5F)\\n  emit_i32_wrap_i64(buf)\\n  emit_i8x16_splat(buf)\\n  emit_i8x16_eq(buf)\\n\\n\\n  emit_i8x16_bitmask(buf)\\n  emit_i64_extend_i32_s(buf)\\n}\\n\\n\\nlet emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\\n  bytebuf_push(buf, 41)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\n\\nexport let emit_scalar_memcmp_16_unrolled: (Bytes) -> Unit = (buf) -> {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 0, 0)\\n\\n  emit_local_get(buf, 1)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 0, 0)\\n\\n  emit_i64_eq(buf)\\n  emit_if_i64(buf)\\n    emit_local_get(buf, 0)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 0, 8)\\n\\n    emit_local_get(buf, 1)\\n    emit_i32_wrap_i64(buf)\\n    emit_i64_load(buf, 0, 8)\\n\\n    emit_i64_eq(buf)\\n    emit_i64_extend_i32_s(buf)\\n  emit_else(buf)\\n    emit_i64_const(buf, 0)\\n  emit_end(buf)\\n}\\n\\n\\nexport let emit_scalar_find_byte_16_unrolled: (Bytes) -> Unit = (buf) -> {\\n  emit_local_get(buf, 0)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load8_u(buf, 0, 0)\\n  emit_i64_extend_i32_s(buf)\\n  emit_local_get(buf, 1)\\n  emit_i64_eq(buf)\\n  emit_if_i64(buf)\\n    emit_i64_const(buf, 1)\\n    emit_return(buf)\\n  emit_else(buf)\\n    emit_local_get(buf, 0)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_load8_u(buf, 0, 1)\\n    emit_i64_extend_i32_s(buf)\\n    emit_local_get(buf, 1)\\n    emit_i64_eq(buf)\\n    emit_if_i64(buf)\\n      emit_i64_const(buf, 2)\\n      emit_return(buf)\\n    emit_else(buf)\\n      emit_local_get(buf, 0)\\n      emit_i32_wrap_i64(buf)\\n      emit_i32_load8_u(buf, 0, 2)\\n      emit_i64_extend_i32_s(buf)\\n      emit_local_get(buf, 1)\\n      emit_i64_eq(buf)\\n      emit_if_i64(buf)\\n        emit_i64_const(buf, 4)\\n        emit_return(buf)\\n      emit_else(buf)\\n        emit_local_get(buf, 0)\\n        emit_i32_wrap_i64(buf)\\n        emit_i32_load8_u(buf, 0, 3)\\n        emit_i64_extend_i32_s(buf)\\n        emit_local_get(buf, 1)\\n        emit_i64_eq(buf)\\n        emit_if_i64(buf)\\n          emit_i64_const(buf, 8)\\n          emit_return(buf)\\n        emit_else(buf)\\n          emit_i64_const(buf, 0)\\n        emit_end(buf)\\n      emit_end(buf)\\n    emit_end(buf)\\n  emit_end(buf)\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\nexport struct FuncTable {\\n  names: Array[String];\\n  indices: Array[Int];\\n  params: Array[Int];\\n  returns: Array[Int];\\n  needs_env: Array[Bool]\\n}\\n\\nexport struct StrTable {\\n  strs: Array[String];\\n  offsets: Array[Int];\\n  lengths: Array[Int]\\n}\\n\\nexport struct LambdaTable {\\n  bodies: Array[Bytes];\\n  param_counts: Array[Int];\\n  captures: Array[Array[String]];\\n  meta_i32: Array[Int];\\n  meta_i64: Array[Int]\\n}\\n\\nexport struct CtorTable {\\n  names: Array[String];\\n  tags: Array[Int];\\n  field_counts: Array[Int];\\n  type_names: Array[String];\\n  struct_names: Array[String];\\n  struct_field_names: Array[Array[String]]\\n}\\n\\nexport struct CovState {\\n  enabled: Bool;\\n  base: Int;\\n  cap: Int;\\n  next: Array[Int];\\n  cur_fn: Array[Int];\\n  owners: Array[Int]\\n}\\n\\nexport let cov_disabled: () -> CovState = () -> {\\n  CovState::{\\n    enabled: false,\\n    base: 0,\\n    cap: 0,\\n    next: [\\n      0\\n    ],\\n    cur_fn: [\\n      0\\n    ],\\n    owners: ArrayBuilder::freeze(ArrayBuilder::new())\\n  }\\n}\\n\\nexport let cov_emit_branch: (Bytes, CovState) -> Unit = (buf, cov) -> {\\n  if cov.enabled {\\n    let id = Array::get(cov.next, 0)\\n    if id < cov.cap {\\n      Array::set(cov.next, 0, id + 1)\\n      Array::push(cov.owners, Array::get(cov.cur_fn, 0))\\n      emit_i32_const(buf, cov.base + id)\\n      emit_i32_const(buf, 1)\\n      emit_i32_store8(buf, 0, 0)\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\n\\nexport struct CompileCtx {\\n  func_table: FuncTable;\\n  str_table: StrTable;\\n  lambda_table: LambdaTable;\\n  num_user_funcs: Int;\\n  func_offset: Int;\\n  ref_cell_names: Array[String];\\n  ctor_table: CtorTable;\\n  thunk_names: Array[String];\\n  const_int_names: Array[String];\\n  const_int_values: Array[Int];\\n  enable_rc: Bool;\\n  rc_shadow: Bool;\\n  rc_drop_names: Array[String];\\n  rc_alias_dup_names: Array[String];\\n  heap_binding_names: Array[String];\\n  rc_drop_func_idx: Int;\\n  rc_alloc_func_idx: Int;\\n  heap_grow_check_func_idx: Int;\\n  rc_dup_names: Array[String];\\n  float_local_slots: Array[Int];\\n  int_local_slots: Array[Int];\\n  effect_names: Array[String];\\n  effect_op_keys: Array[String];\\n  effect_op_arities: Array[Int];\\n  cov: CovState;\\n  dbg_line_idx: Int;\\n  dbg_line_nl: Array[Int];\\n  dbg_line_file_id: Int;\\n  loop_borrowed_names: Array[String];\\n  loop_consumed_names: Array[String];\\n  borrow_ret_names: Array[String];\\n  scalar_ret_names: Array[String]\\n}\\n\\nexport struct DbgProv {\\n  files: Array[String];\\n  file_nls: Array[Array[Int]];\\n  stmt_file_id: Array[Int]\\n}\\n\\nexport let empty_dbg_prov: () -> DbgProv = () -> {\\n  DbgProv::{\\n    files: Array::slice([\\n      \\\"\\\"\\n    ], 0, 0),\\n    file_nls: Array::slice([\\n      Array::slice([\\n        0\\n      ], 0, 0)\\n    ], 0, 0),\\n    stmt_file_id: Array::slice([\\n      0\\n    ], 0, 0)\\n  }\\n}\\n\\nexport struct CompileCtxGc {\\n  func_table: FuncTable;\\n  str_table: StrTable;\\n  lambda_table: LambdaTable;\\n  num_user_funcs: Int;\\n  func_offset: Int;\\n  ref_cell_names: Array[String];\\n  ref_local_indices: Array[Int];\\n  refcell_type_idx: Int;\\n  closure_type_base: Int;\\n  ctor_table: CtorTable\\n}\\n\\n\\nexport let int_log_reset_above: (CompileCtx, Int) -> Unit = (ctx, floor) -> {\\n  let arr = ctx.int_local_slots\\n  let n = Array::length(arr)\\n  let mut w = 0\\n  let mut i = 0\\n  while i < n {\\n    let e = Array::get(arr, i)\\n    if e / 2 < floor {\\n      Array::set(arr, w, e)\\n      w = w + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  Array::truncate(arr, w)\\n}\\n\\nexport let is_efn: (Expr) -> Bool = (expr) -> {\\n  match expr {\\n    EFn(_, _, _, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pint: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PInt(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_slet: (Stmt) -> Bool = (stmt) -> {\\n  match stmt {\\n    SLet(_, _, _, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let expr_tag: (Expr) -> Int = (expr) -> {\\n  match expr {\\n    EInt(_) => 0,\\n    EBool(_) => 1,\\n    EFloat(_) => 2,\\n    EString(_) => 3,\\n    EIdent(_, _) => 4,\\n    EBinOp(_, _, _) => 5,\\n    EUnaryOp(_, _) => 6,\\n    EIf(_, _, _) => 7,\\n    ECall(_, _, _) => 8,\\n    ELet(_, _, _) => 9,\\n    ELetRec(_, _, _) => 10,\\n    ELetMut(_, _, _) => 11,\\n    EAssign(_, _, _) => 12,\\n    EAssignOp(_, _, _, _) => 13,\\n    ESeq(_, _) => 14,\\n    ETuple(_) => 15,\\n    EMatch(_, _) => 16,\\n    EArray(_) => 17,\\n    EForIn(_, _, _, _) => 18,\\n    EWhile(_, _) => 19,\\n    EBreak(_) => 20,\\n    EContinue(_) => 21,\\n    EUnit => 22,\\n    EThrow(_) => 23,\\n    EFn(_, _, _, _, _, _) => 24,\\n    ELoop(_, _) => 25,\\n    EReturn(_) => 26,\\n    _ => -1\\n  }\\n}\\n\\nexport let is_pbind: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PBind(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pbool: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PBool(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pctor: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PCtor(_, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pwild: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PWild => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_earray: (Expr) -> Bool = (expr) -> {\\n  match expr {\\n    EArray(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_eident: (Expr) -> Bool = (expr) -> {\\n  match expr {\\n    EIdent(_, _) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_etuple: (Expr) -> Bool = (expr) -> {\\n  match expr {\\n    ETuple(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_ptuple: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PTuple(_) => true,\\n    _ => false\\n  }\\n}\\n\\nlet op_i32_eq = 70\\n\\nlet op_i32_ne = 71\\n\\nexport let is_erecord: (Expr) -> Bool = (expr) -> {\\n  match expr {\\n    ERecord(_) => true,\\n    _ => false\\n  }\\n}\\n\\nexport let is_pstring: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PString(_) => true,\\n    _ => false\\n  }\\n}\\n\\nlet op_i32_eqz = 69\\n\\nlet op_i32_mul = 108\\n\\nlet op_i32_sub = 107\\n\\nexport let emit_i32_eq: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_eq)\\n}\\n\\nexport let emit_i32_ne: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_ne)\\n}\\n\\nexport let get_arm_pat: ((Pat, Expr)) -> Pat = (arm) -> {\\n  let (p, _) = arm\\n  p\\n}\\n\\nexport let rec lookup_ctor: (Array[String], String, Int) -> Int = (ctor_names, name, i) -> {\\n  if i >= Array::length(ctor_names) {\\n    -1\\n  }\\n  else if Array::get(ctor_names, i) == name {\\n    i\\n  }\\n  else lookup_ctor(ctor_names, name, i + 1)\\n}\\n\\nlet op_i32_ge_u = 79\\n\\nlet op_i32_gt_u = 75\\n\\nlet op_i64_load = 41\\n\\nexport let emit_i32_eqz: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_eqz)\\n}\\n\\nexport let emit_i32_mul: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_mul)\\n}\\n\\nexport let emit_i32_sub: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_sub)\\n}\\n\\nexport let emit_str_ref: (Bytes, Int, Int) -> Unit = (buf, offset, length) -> {\\n  emit_i64_const(buf, offset)\\n  emit_i64_const(buf, 32)\\n  emit_i64_shl(buf)\\n  emit_i64_const(buf, length)\\n  emit_i64_or(buf)\\n}\\n\\nexport let get_arm_body: ((Pat, Expr)) -> Expr = (arm) -> {\\n  let (_, b) = arm\\n  b\\n}\\n\\nexport let get_efn_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EFn(_, _, _, _, _, body) => body,\\n    _ => throw(\\\"not EFn\\\")\\n  }\\n}\\n\\nexport let get_eif_cond: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EIf(c, _, _) => c,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport let get_eif_else: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EIf(_, _, e) => e,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport let get_eif_then: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EIf(_, t, _) => t,\\n    _ => throw(\\\"not EIf\\\")\\n  }\\n}\\n\\nexport let get_elet_val: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ELet(_, val, _) => val,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport let is_ctor_call: (Expr, CtorTable) -> Bool = (value, ct) -> {\\n  match value {\\n    ECall(callee, _, _) => match callee {\\n      EIdent(nm, _) => lookup_ctor(ct.names, nm, 0) >= 0,\\n      _ => false\\n    },\\n    _ => false\\n  }\\n}\\n\\nlet op_i64_store = 55\\n\\nexport let resolve_func: (FuncTable, String) -> (Int, Int, Int) with { Error } = (ft, name) -> {\\n  let len = Array::length(ft.names)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(ft.names, i) == name {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"undefined function: \\\", name))\\n  };\\n  (Array::get(ft.indices, found), Array::get(ft.params, found), Array::get(ft.returns, found))\\n}\\n\\nexport let emit_binop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {\\n  if op == \\\"+\\\" {\\n    emit_i64_add(buf)\\n  }\\n  else if op == \\\"-\\\" {\\n    emit_i64_sub(buf)\\n  }\\n  else if op == \\\"*\\\" {\\n    emit_i64_mul(buf)\\n  }\\n  else if op == \\\"/\\\" {\\n    emit_i64_div_s(buf)\\n  }\\n  else if op == \\\"%\\\" {\\n    emit_i64_rem_s(buf)\\n  }\\n  else if op == \\\"&\\\" {\\n    emit_i64_and(buf)\\n  }\\n  else if op == \\\"|\\\" {\\n    emit_i64_or(buf)\\n  }\\n  else if op == \\\"^\\\" {\\n    emit_i64_xor(buf)\\n  }\\n  else if op == \\\"<<\\\" {\\n    emit_i64_shl(buf)\\n  }\\n  else if op == \\\">>\\\" {\\n    emit_i64_shr_s(buf)\\n  }\\n  else if op == \\\"==\\\" {\\n    emit_i64_eq(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"!=\\\" {\\n    emit_i64_ne(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"<\\\" {\\n    emit_i64_lt_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\">\\\" {\\n    emit_i64_gt_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"<=\\\" {\\n    emit_i64_le_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\">=\\\" {\\n    emit_i64_ge_s(buf); emit_i64_extend_i32_s(buf)\\n  }\\n  else if op == \\\"&&\\\" {\\n    emit_i64_and(buf)\\n  }\\n  else if op == \\\"||\\\" {\\n    emit_i64_or(buf)\\n  }\\n  else {\\n    throw(String::concat(\\\"unsupported binop: \\\", op))\\n  }\\n}\\n\\nexport let emit_i32_ge_u: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_ge_u)\\n}\\n\\nexport let emit_i32_gt_u: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i32_gt_u)\\n}\\n\\nexport let emit_i64_load: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\\n  bytebuf_push(buf, op_i64_load)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport let get_ebinop_op: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EBinOp(op, _, _) => op,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport let get_elet_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ELet(_, _, body) => body,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport let get_elet_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    ELet(name, _, _) => name,\\n    _ => throw(\\\"not ELet\\\")\\n  }\\n}\\n\\nexport let get_func_body: (Stmt) -> Expr with { Error } = (stmt) -> {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => match expr {\\n      EFn(_, _, _, _, _, body) => body,\\n      _ => throw(\\\"get_func_body: not a function\\\")\\n    },\\n    _ => throw(\\\"get_func_body: not a let statement\\\")\\n  }\\n}\\n\\nexport let get_slet_expr: (Stmt) -> Expr with { Error } = (stmt) -> {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => expr,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport let get_slet_name: (Stmt) -> String with { Error } = (stmt) -> {\\n  match stmt {\\n    SLet(_, _, name, _, _) => name,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport let get_slet_type: (Stmt) -> Option[TypeExpr] = (stmt) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, _) => ty,\\n    _ => None\\n  }\\n}\\n\\nexport let resolve_local: (Array[String], String, String) -> Int with { Error } = (names, name, tag) -> {\\n  let mut i = Array::length(names) - 1\\n  let mut result = -1\\n  while i >= 0 {\\n    if Array::get(names, i) == name {\\n      result = i\\n      i = -1\\n    } else {\\n      i = i - 1\\n    }\\n  }\\n  if result < 0 {\\n    throw(String::concat(String::concat(\\\"undefined variable (local): \\\", name), String::concat(\\\" @\\\", tag)))\\n  }\\n  result\\n}\\n\\nexport let emit_i64_store: (Bytes, Int, Int) -> Unit = (buf, align, offset) -> {\\n  bytebuf_push(buf, op_i64_store)\\n  leb128_encode_u32(buf, align)\\n  leb128_encode_u32(buf, offset)\\n}\\n\\nexport let emit_box_float: (Bytes, CompileCtx, Int, Int) -> Unit = (buf, ctx, bits_local, box_local) -> {\\n  emit_local_set(buf, bits_local)\\n  emit_i64_const(buf, 16)\\n  emit_call(buf, ctx.rc_alloc_func_idx)\\n  emit_local_set(buf, box_local)\\n  emit_local_get(buf, box_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_const(buf, 16)\\n  emit_i32_store(buf, 2, 0)\\n  emit_local_get(buf, box_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_const(buf, 1)\\n  emit_i32_store(buf, 2, 4)\\n  emit_local_get(buf, box_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_local_get(buf, bits_local)\\n  emit_i64_store(buf, 3, 8)\\n  emit_local_get(buf, box_local)\\n  emit_i64_const(buf, 8)\\n  emit_i64_add(buf)\\n  emit_i64_const(buf, 1)\\n  emit_i64_or(buf)\\n}\\n\\nexport let find_func_stmt: (Array[Stmt], String) -> Stmt with { Error } = (stmts, name) -> {\\n  let len = Array::length(stmts)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SLet(_, _, sname, _, _) => if sname == name {\\n        found = i\\n        i = len\\n      },\\n      _ => ()\\n    }\\n    if found < 0 {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"function not found: \\\", name))\\n  }\\n  Array::get(stmts, found)\\n}\\n\\nexport let emit_unbox_float: (Bytes) -> Unit = (buf) -> {\\n  emit_i64_const(buf, -2)\\n  emit_i64_and(buf)\\n  emit_i32_wrap_i64(buf)\\n  emit_i64_load(buf, 3, 0)\\n}\\n\\nexport let emit_index_one: (Bytes, CompileCtx) -> Unit = (buf, ctx) -> {\\n  if ctx.enable_rc {\\n    emit_i64_const(buf, 2)\\n  } else {\\n    emit_i64_const(buf, 1)\\n  }\\n}\\n\\nexport let rc_shadow_base: () -> Int = () -> {\\n  268435456\\n}\\n\\nexport let rc_shadow_reserve: () -> Int = () -> {\\n  536870912\\n}\\n\\nexport let emit_rc_word_inc_saturating: (Bytes, () -> Unit) -> Unit = (buf, push_addr) -> {\\n  push_addr()\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 16777215)\\n  bytebuf_push(buf, 113)\\n  emit_i32_const(buf, 16777215)\\n  emit_i32_ne(buf)\\n  emit_if_void(buf)\\n  push_addr()\\n  push_addr()\\n  emit_i32_load(buf, 2, 0)\\n  emit_i32_const(buf, 1)\\n  emit_i32_add(buf)\\n  emit_i32_store(buf, 2, 0)\\n  emit_end(buf)\\n}\\n\\nexport let emit_rc_dup_guarded: (Bytes, Int, Bool) -> Unit = (buf, local_idx, rc_shadow) -> {\\n  emit_local_get(buf, local_idx)\\n  emit_i64_const(buf, 1)\\n  emit_i64_and(buf)\\n  emit_i32_wrap_i64(buf)\\n  emit_if_void(buf)\\n  emit_local_get(buf, local_idx)\\n  emit_i64_const(buf, 32)\\n  emit_i64_shr_s(buf)\\n  emit_i64_eqz(buf)\\n  emit_if_void(buf)\\n  if rc_shadow {\\n    emit_local_get(buf, local_idx)\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, rc_shadow_base())\\n    emit_i32_add(buf)\\n    emit_i32_load8_u(buf, 0, 0)\\n    emit_if_void(buf)\\n    bytebuf_push(buf, 0)\\n    emit_end(buf)\\n  } else {\\n    ()\\n  }\\n  emit_rc_word_inc_saturating(buf, () -> {\\n    emit_local_get(buf, local_idx)\\n    emit_i64_const(buf, -2)\\n    emit_i64_and(buf)\\n    emit_i32_wrap_i64(buf)\\n    emit_i32_const(buf, 4)\\n    emit_i32_sub(buf)\\n  })\\n  emit_end(buf)\\n  emit_end(buf)\\n}\\n\\nexport let fn_type_param_types: (Option[TypeExpr]) -> Option[Array[TypeExpr]] = (ty) -> {\\n  match ty {\\n    Some(t) =>\\n    match t {\\n      TyFn(args, _, _) => Some(args),\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nexport let is_nullary_ctor_ident: (Expr, CtorTable) -> Bool = (value, ct) -> {\\n  match value {\\n    EIdent(nm, _) => lookup_ctor(ct.names, nm, 0) >= 0,\\n    _ => false\\n  }\\n}\\n\\nexport let name_has_effect_prefix: (String, String) -> Bool = (full, eff) -> {\\n  let el = String::length(eff)\\n  let fl = String::length(full)\\n  if fl < el + 2 {\\n    false\\n  } else {\\n    let mut ok = true\\n    let mut j = 0\\n    while j < el {\\n      if String::char_code_at(full, j) != String::char_code_at(eff, j) {\\n        ok = false\\n        j = el\\n      } else {\\n        j = j + 1\\n      }\\n    }\\n    ok && String::char_code_at(full, el) == 58 && String::char_code_at(full, el + 1) == 58\\n  }\\n}\\n\\nexport let effect_name_to_tag: (Array[String], String) -> Int = (effect_names, full) -> {\\n  let n = Array::length(effect_names)\\n  let mut result = 3 + n\\n  let mut i = 0\\n  while i < n {\\n    if name_has_effect_prefix(full, Array::get(effect_names, i)) {\\n      result = 3 + i\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport let effect_op_declared_arity: (Array[String], Array[Int], String) -> Int = (keys, arities, full) -> {\\n  let n = Array::length(keys)\\n  let mut result = -1\\n  let mut i = 0\\n  while i < n {\\n    if Array::get(keys, i) == full {\\n      result = Array::get(arities, i)\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport let effect_op_index: (Array[String], String) -> Int = (keys, full) -> {\\n  let n = Array::length(keys)\\n  let mut result = 0 - 1\\n  let mut i = 0\\n  while i < n {\\n    if Array::get(keys, i) == full {\\n      result = i\\n      i = n\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport let emit_heap_grow_after_heap_set: (Bytes, CompileCtx) -> Unit = (buf, ctx) -> {\\n  if ctx.heap_grow_check_func_idx >= 0 {\\n    emit_call(buf, ctx.heap_grow_check_func_idx)\\n  } else {\\n    ()\\n  }\\n}\\n\\n\\n\\nlet zero_pad_6: (Int) -> String = (n) -> {\\n  let s = __to_string(n)\\n  let len = String::length(s)\\n  if len >= 6 {\\n    s\\n  } else {\\n    let mut out = \\\"\\\"\\n    let mut i = len\\n    while i < 6 {\\n      out = String::concat(out, \\\"0\\\")\\n      i = i + 1\\n    }\\n    String::concat(out, s)\\n  }\\n}\\n\\nlet trim_trailing_zeros: (String) -> String = (s) -> {\\n  let mut end = String::length(s)\\n  while end > 0 && String::char_code_at(s, end - 1) == 48 {\\n    end = end - 1\\n  }\\n  if end <= 0 {\\n    \\\"\\\"\\n  } else {\\n    s[0: end]\\n  }\\n}\\n\\nexport let double_to_string_compiler: (Double) -> String = (d) -> {\\n  if d != d {\\n    \\\"nan\\\"\\n  } else {\\n    let neg = d < 0.0\\n    let abs_d = if neg {\\n      0.0 - d\\n    } else {\\n      d\\n    }\\n    let int_part = Double::to_int(abs_d)\\n    let frac = abs_d - Int::to_double(int_part)\\n    let scaled_raw = Double::to_int(frac * 1000000.0 + 0.5)\\n    let int_norm = if scaled_raw == 1000000 {\\n      int_part + 1\\n    } else {\\n      int_part\\n    }\\n    let frac_norm = if scaled_raw == 1000000 {\\n      0\\n    } else {\\n      scaled_raw\\n    }\\n    let int_s = __to_string(int_norm)\\n    let frac_s = if frac_norm == 0 {\\n      \\\"\\\"\\n    } else {\\n      trim_trailing_zeros(zero_pad_6(frac_norm))\\n    }\\n    let body = if String::length(frac_s) == 0 {\\n      int_s\\n    } else {\\n      String::concat(int_s, String::concat(\\\".\\\", frac_s))\\n    }\\n    if neg {\\n      String::concat(\\\"-\\\", body)\\n    } else {\\n      body\\n    }\\n  }\\n}\\n\\n\\n\\n\\nexport enum Token {\\n  TInt(Int);\\n  TFloat(Double);\\n  TString(String);\\n  TIdent(String);\\n  TLet;\\n  TRec;\\n  TMut;\\n  TFn;\\n  TIf;\\n  TElse;\\n  TMatch;\\n  TIs;\\n  TDo;\\n  TEnum;\\n  TStruct;\\n  TType;\\n  TTrait;\\n  TImpl;\\n  TExport;\\n  TTest;\\n  TWhile;\\n  TFor;\\n  TIn;\\n  TLoop;\\n  TBreak;\\n  TContinue;\\n  TReturn;\\n  TWith;\\n  THandle;\\n  TThrow;\\n  TRaise;\\n  TYield;\\n  TBench;\\n  TDeclare;\\n  TAs;\\n  TModule;\\n  TSuberror;\\n  TDerive;\\n  TOpen;\\n  TImport;\\n  TPlus;\\n  TMinus;\\n  TStar;\\n  TSlash;\\n  TPercent;\\n  TEqEq;\\n  TNeq;\\n  TLt;\\n  TLte;\\n  TGt;\\n  TGte;\\n  TAnd;\\n  TOr;\\n  TNot;\\n  TBitAnd;\\n  TBitOr;\\n  TBitXor;\\n  TLShift;\\n  TRShift;\\n  TPipeGt;\\n  TArrow;\\n  TThinArrow;\\n  TEq;\\n  TDot;\\n  TColon;\\n  TDoubleColon;\\n  TComma;\\n  TSemicolon;\\n  THash;\\n  TTilde;\\n  TQuestion;\\n  TPlusEq;\\n  TMinusEq;\\n  TStarEq;\\n  TSlashEq;\\n  TPercentEq;\\n  TLParen;\\n  TRParen;\\n  TLBrace;\\n  TRBrace;\\n  TLBracket;\\n  TRBracket;\\n  TDotDot;\\n  TDotDotDot;\\n  TStringInterp(Array[String]);\\n  TEof\\n}\\n\\n\\nexport let token_to_string: (Token) -> String = (t) -> {\\n  match t {\\n    TInt(n) => String::concat(\\\"TInt(\\\", String::concat(__to_string(n), \\\")\\\")),\\n    TFloat(n) =>\\n    String::concat(\\\"TFloat(\\\", String::concat(double_to_string_compiler(n), \\\")\\\")),\\n    TString(s) => String::concat(\\\"TString(\\\\\\\"\\\", String::concat(s, \\\"\\\\\\\")\\\")),\\n    TIdent(s) => String::concat(\\\"TIdent(\\\", String::concat(s, \\\")\\\")),\\n    TLet => \\\"TLet\\\",\\n    TRec => \\\"TRec\\\",\\n    TMut => \\\"TMut\\\",\\n    TFn => \\\"TFn\\\",\\n    TIf => \\\"TIf\\\",\\n    TElse => \\\"TElse\\\",\\n    TMatch => \\\"TMatch\\\",\\n    TIs => \\\"TIs\\\",\\n    TDo => \\\"TDo\\\",\\n    TEnum => \\\"TEnum\\\",\\n    TStruct => \\\"TStruct\\\",\\n    TType => \\\"TType\\\",\\n    TTrait => \\\"TTrait\\\",\\n    TImpl => \\\"TImpl\\\",\\n    TExport => \\\"TExport\\\",\\n    TTest => \\\"TTest\\\",\\n    TWhile => \\\"TWhile\\\",\\n    TFor => \\\"TFor\\\",\\n    TIn => \\\"TIn\\\",\\n    TLoop => \\\"TLoop\\\",\\n    TBreak => \\\"TBreak\\\",\\n    TContinue => \\\"TContinue\\\",\\n    TReturn => \\\"TReturn\\\",\\n    TWith => \\\"TWith\\\",\\n    THandle => \\\"THandle\\\",\\n    TThrow => \\\"TThrow\\\",\\n    TRaise => \\\"TRaise\\\",\\n    TYield => \\\"TYield\\\",\\n    TBench => \\\"TBench\\\",\\n    TDeclare => \\\"TDeclare\\\",\\n    TAs => \\\"TAs\\\",\\n    TModule => \\\"TModule\\\",\\n    TSuberror => \\\"TSuberror\\\",\\n    TDerive => \\\"TDerive\\\",\\n    TOpen => \\\"TOpen\\\",\\n    TImport => \\\"TImport\\\",\\n    TPlus => \\\"TPlus\\\",\\n    TMinus => \\\"TMinus\\\",\\n    TStar => \\\"TStar\\\",\\n    TSlash => \\\"TSlash\\\",\\n    TPercent => \\\"TPercent\\\",\\n    TEqEq => \\\"TEqEq\\\",\\n    TNeq => \\\"TNeq\\\",\\n    TLt => \\\"TLt\\\",\\n    TLte => \\\"TLte\\\",\\n    TGt => \\\"TGt\\\",\\n    TGte => \\\"TGte\\\",\\n    TAnd => \\\"TAnd\\\",\\n    TOr => \\\"TOr\\\",\\n    TNot => \\\"TNot\\\",\\n    TBitAnd => \\\"TBitAnd\\\",\\n    TBitOr => \\\"TBitOr\\\",\\n    TBitXor => \\\"TBitXor\\\",\\n    TLShift => \\\"TLShift\\\",\\n    TRShift => \\\"TRShift\\\",\\n    TPipeGt => \\\"TPipeGt\\\",\\n    TArrow => \\\"TArrow\\\",\\n    TThinArrow => \\\"TThinArrow\\\",\\n    TEq => \\\"TEq\\\",\\n    TDot => \\\"TDot\\\",\\n    TColon => \\\"TColon\\\",\\n    TDoubleColon => \\\"TDoubleColon\\\",\\n    TComma => \\\"TComma\\\",\\n    TSemicolon => \\\"TSemicolon\\\",\\n    THash => \\\"THash\\\",\\n    TTilde => \\\"TTilde\\\",\\n    TQuestion => \\\"TQuestion\\\",\\n    TPlusEq => \\\"TPlusEq\\\",\\n    TMinusEq => \\\"TMinusEq\\\",\\n    TStarEq => \\\"TStarEq\\\",\\n    TSlashEq => \\\"TSlashEq\\\",\\n    TPercentEq => \\\"TPercentEq\\\",\\n    TLParen => \\\"TLParen\\\",\\n    TRParen => \\\"TRParen\\\",\\n    TLBrace => \\\"TLBrace\\\",\\n    TRBrace => \\\"TRBrace\\\",\\n    TLBracket => \\\"TLBracket\\\",\\n    TRBracket => \\\"TRBracket\\\",\\n    TDotDot => \\\"TDotDot\\\",\\n    TDotDotDot => \\\"TDotDotDot\\\",\\n    TStringInterp(_) => \\\"TStringInterp\\\",\\n    TEof => \\\"TEof\\\"\\n  }\\n}\\n\\n\\n\\nlet is_ws: (Int) -> Bool = (c) -> {\\n  c == ' ' || c == '\\\\n' || c == '\\\\t' || c == '\\\\r'\\n}\\n\\nlet is_alpha: (Int) -> Bool = (c) -> {\\n  (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'\\n}\\n\\nlet is_digit: (Int) -> Bool = (c) -> {\\n  c >= '0' && c <= '9'\\n}\\n\\nlet is_alnum: (Int) -> Bool = (c) -> {\\n  is_alpha(c) || is_digit(c)\\n}\\n\\nlet lex_char: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\\n  let start = i + 1\\n  if start >= len {\\n    throw(\\\"unterminated char literal\\\")\\n  }\\n  let c = String::char_code_at(s, start)\\n  if c == '\\\\\\\\' {\\n    let esc_pos = start + 1\\n    if esc_pos >= len {\\n      throw(\\\"unterminated char escape\\\")\\n    }\\n    let esc = String::char_code_at(s, esc_pos)\\n    let val = if esc == 'n' {\\n      10\\n    }\\n    else if esc == 't' {\\n      9\\n    }\\n    else if esc == 'r' {\\n      13\\n    }\\n    else if esc == '\\\\\\\\' {\\n      92\\n    }\\n    else if esc == '\\\\'' {\\n      39\\n    }\\n    else if esc == '0' {\\n      0\\n    }\\n    else throw(\\\"invalid char escape\\\")\\n    let close = esc_pos + 1\\n    if close >= len || String::char_code_at(s, close) != '\\\\'' {\\n      throw(\\\"expected closing quote for char literal\\\")\\n    };\\n    (TInt(val), close + 1)\\n  } else {\\n    let close = start + 1\\n    if close >= len || String::char_code_at(s, close) != '\\\\'' {\\n      throw(\\\"expected closing quote for char literal\\\")\\n    };\\n    (TInt(c), close + 1)\\n  }\\n}\\n\\nlet slice_eq: (String, Int, Int, String) -> Bool = (source, start, end, text) -> {\\n  let len = end - start\\n  let text_len = String::length(text)\\n  if len != text_len {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while ok && i < text_len {\\n      ok = String::char_code_at(source, start + i) == String::char_code_at(text, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\n\\nlet is_hex_digit: (Int) -> Bool = (c) -> {\\n  (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')\\n}\\n\\nlet keyword_lookup: (String, Int, Int) -> Option[Token] = (source, start, end) -> {\\n  let len = end - start\\n  if len == 2 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"fn\\\") {\\n        Some(TIdent(\\\"fn\\\"))\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"if\\\") {\\n        Some(TIf)\\n      } else if slice_eq(source, start, end, \\\"in\\\") {\\n        Some(TIn)\\n      } else if slice_eq(source, start, end, \\\"is\\\") {\\n        Some(TIs)\\n      } else None\\n    } else if c0 == 'd' {\\n      if slice_eq(source, start, end, \\\"do\\\") {\\n        Some(TDo)\\n      } else None\\n    } else if c0 == 'a' {\\n      if slice_eq(source, start, end, \\\"as\\\") {\\n        Some(TAs)\\n      } else None\\n    } else None\\n  } else if len == 3 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'l' {\\n      if slice_eq(source, start, end, \\\"let\\\") {\\n        Some(TLet)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"rec\\\") {\\n        Some(TRec)\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"mut\\\") {\\n        Some(TMut)\\n      } else None\\n    } else if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"for\\\") {\\n        Some(TFor)\\n      } else None\\n    } else None\\n  } else if len == 4 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'e' {\\n      if slice_eq(source, start, end, \\\"else\\\") {\\n        Some(TElse)\\n      } else if slice_eq(source, start, end, \\\"enum\\\") {\\n        Some(TEnum)\\n      } else None\\n    } else if c0 == 't' {\\n      if slice_eq(source, start, end, \\\"true\\\") {\\n        Some(TIdent(\\\"true\\\"))\\n      } else if slice_eq(source, start, end, \\\"type\\\") {\\n        Some(TType)\\n      } else if slice_eq(source, start, end, \\\"test\\\") {\\n        Some(TTest)\\n      } else None\\n    } else if c0 == 'w' {\\n      if slice_eq(source, start, end, \\\"with\\\") {\\n        Some(TWith)\\n      } else None\\n    } else if c0 == 'l' {\\n      if slice_eq(source, start, end, \\\"loop\\\") {\\n        Some(TLoop)\\n      } else None\\n    } else if c0 == 'o' {\\n      if slice_eq(source, start, end, \\\"open\\\") {\\n        Some(TOpen)\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"impl\\\") {\\n        Some(TImpl)\\n      } else None\\n    } else None\\n  } else if len == 5 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'f' {\\n      if slice_eq(source, start, end, \\\"false\\\") {\\n        Some(TIdent(\\\"false\\\"))\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"match\\\") {\\n        Some(TMatch)\\n      } else None\\n    } else if c0 == 't' {\\n      if slice_eq(source, start, end, \\\"trait\\\") {\\n        Some(TTrait)\\n      } else if slice_eq(source, start, end, \\\"throw\\\") {\\n        Some(TThrow)\\n      } else None\\n    } else if c0 == 'w' {\\n      if slice_eq(source, start, end, \\\"while\\\") {\\n        Some(TWhile)\\n      } else None\\n    } else if c0 == 'b' {\\n      if slice_eq(source, start, end, \\\"break\\\") {\\n        Some(TBreak)\\n      } else if slice_eq(source, start, end, \\\"bench\\\") {\\n        Some(TBench)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"raise\\\") {\\n        Some(TRaise)\\n      } else None\\n    } else if c0 == 'y' {\\n      if slice_eq(source, start, end, \\\"yield\\\") {\\n        Some(TYield)\\n      } else None\\n    } else None\\n  } else if len == 6 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 's' {\\n      if slice_eq(source, start, end, \\\"struct\\\") {\\n        Some(TStruct)\\n      } else None\\n    } else if c0 == 'e' {\\n      if slice_eq(source, start, end, \\\"export\\\") {\\n        Some(TExport)\\n      } else None\\n    } else if c0 == 'r' {\\n      if slice_eq(source, start, end, \\\"return\\\") {\\n        Some(TReturn)\\n      } else None\\n    } else if c0 == 'h' {\\n      if slice_eq(source, start, end, \\\"handle\\\") {\\n        Some(THandle)\\n      } else None\\n    } else if c0 == 'm' {\\n      if slice_eq(source, start, end, \\\"module\\\") {\\n        Some(TModule)\\n      } else None\\n    } else if c0 == 'd' {\\n      if slice_eq(source, start, end, \\\"derive\\\") {\\n        Some(TDerive)\\n      } else None\\n    } else if c0 == 'i' {\\n      if slice_eq(source, start, end, \\\"import\\\") {\\n        Some(TImport)\\n      } else None\\n    } else None\\n  } else if len == 7 {\\n    if slice_eq(source, start, end, \\\"declare\\\") {\\n      Some(TDeclare)\\n    } else None\\n  } else if len == 8 {\\n    let c0 = String::char_code_at(source, start)\\n    if c0 == 'c' {\\n      if slice_eq(source, start, end, \\\"continue\\\") {\\n        Some(TContinue)\\n      } else None\\n    } else if c0 == 's' {\\n      if slice_eq(source, start, end, \\\"suberror\\\") {\\n        Some(TSuberror)\\n      } else None\\n    } else None\\n  } else None\\n}\\n\\nlet scan_ident_end: (String, Int, Int) -> Int = (s, len, i) -> {\\n  let mut out = i\\n  while out < len && is_alnum(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nlet lex_ident: (String, Int, Int) -> (Token, Int) = (s, len, i) -> {\\n  let end = scan_ident_end(s, len, i)\\n  if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '#' {\\n    let ri_start = end + 1\\n    let ri_end = scan_ident_end(s, len, ri_start)\\n    (TIdent(s[ri_start: ri_end]), ri_end)\\n  }\\n  else if end == i + 1 && String::char_code_at(s, i) == 'r' && end < len && String::char_code_at(s, end) == '\\\"' {\\n    let mut ri = end + 1\\n    while ri < len && String::char_code_at(s, ri) != '\\\"' {\\n      ri = ri + 1\\n    }\\n    (TString(s[end + 1: ri]), if ri >= len {\\n      ri\\n    } else {\\n      ri + 1\\n    })\\n  } else {\\n    match keyword_lookup(s, i, end) {\\n      Some(tok) => (tok, end),\\n      None => (TIdent(s[i: end]), end)\\n    }\\n  }\\n}\\n\\nlet scan_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\\n  let mut out = i\\n  while out < len && is_digit(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nlet scan_interp_end: (String, Int, Int, Int) -> Int with { Error } = (s, len, idx, depth) -> {\\n  let mut out = idx\\n  let mut current_depth = depth\\n  let mut found = -1\\n  while out < len && found < 0 {\\n    let c = String::char_code_at(s, out)\\n    if c == '{' {\\n      current_depth = current_depth + 1\\n    } else if c == '}' {\\n      if current_depth == 1 {\\n        found = out\\n      } else {\\n        current_depth = current_depth - 1\\n      }\\n    }\\n    if found < 0 {\\n      out = out + 1\\n    }\\n  }\\n  if found >= 0 {\\n    found\\n  } else {\\n    throw(\\\"unterminated string interpolation\\\")\\n  }\\n}\\n\\nlet parse_frac_digits: (String, Int, Int, Double, Double) -> (Double, Int) = (s, len, i, acc, scale) -> {\\n  let mut out_i = i\\n  let mut out_acc = acc\\n  let mut out_scale = scale\\n  let mut done = false\\n  while out_i < len && !done {\\n    let c = String::char_code_at(s, out_i)\\n    if is_digit(c) {\\n      out_acc = out_acc + Int::to_double(c - 48) / out_scale\\n      out_scale = out_scale * 10.0\\n      out_i = out_i + 1\\n    } else {\\n      done = true\\n    }\\n  }\\n  (out_acc, out_i)\\n}\\n\\nlet empty_string_array: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet skip_until_newline: (String, Int, Int) -> Int = (s, len, i) -> {\\n  let mut out = i\\n  let mut done = false\\n  while out < len && !done {\\n    if String::char_code_at(s, out) == '\\\\n' {\\n      out = out + 1\\n      done = true\\n    } else {\\n      out = out + 1\\n    }\\n  }\\n  out\\n}\\n\\nlet skip_ws_with_newline: (String, Int, Int) -> (Int, Bool) = (s, len, i) -> {\\n  let mut out = i\\n  let mut saw_newline = false\\n  let mut skipping = true\\n  while skipping && out < len {\\n    let c = String::char_code_at(s, out)\\n    if is_ws(c) {\\n      if c == '\\\\n' {\\n        saw_newline = true\\n      } else {\\n        ()\\n      }\\n      out = out + 1\\n    } else if c == '/' && out + 1 < len && String::char_code_at(s, out + 1) == '/' {\\n      let next = skip_until_newline(s, len, out + 2)\\n      if next > out + 2 && String::char_code_at(s, next - 1) == '\\\\n' {\\n        saw_newline = true\\n      } else {\\n        ()\\n      }\\n      out = next\\n    } else {\\n      skipping = false\\n    }\\n  }\\n  (out, saw_newline)\\n}\\n\\nlet concat_string_parts: (Array[String], String) -> String = (parts, tail) -> {\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(parts) {\\n    StringBuilder::push(out, Array::get(parts, i))\\n    i = i + 1\\n  }\\n  StringBuilder::push(out, tail)\\n  StringBuilder::freeze(out)\\n}\\n\\nlet lex_string_go: (String, Int, Int, Int, Array[String], Bool, ArrayBuilder[String]) -> (Token, Int) with { Error } = (s, len, idx, start, parts_acc, has_interp, parts) -> {\\n  let mut current_idx = idx\\n  let mut current_start = start\\n  let mut current_parts_acc = parts_acc\\n  let mut current_has_interp = has_interp\\n  let mut out_tok = TEof\\n  let mut out_next = -1\\n  let mut done = false\\n  while !done {\\n    if current_idx >= len {\\n      throw(\\\"unterminated string\\\")\\n    }\\n    let c = String::char_code_at(s, current_idx)\\n    if c == '\\\"' {\\n      let value = concat_string_parts(current_parts_acc, s[current_start: current_idx])\\n      if current_has_interp {\\n        ArrayBuilder::push(parts, value)\\n        out_tok = TStringInterp(ArrayBuilder::freeze(parts))\\n        out_next = current_idx + 1\\n      } else {\\n        out_tok = TString(value)\\n        out_next = current_idx + 1\\n      }\\n      done = true\\n    } else if c == '\\\\\\\\' {\\n      let chunk = s[current_start: current_idx]\\n      let next = current_idx + 1\\n      if next >= len {\\n        throw(\\\"unterminated string escape\\\")\\n      }\\n      let esc = String::char_code_at(s, next)\\n      if esc == '{' || esc == '(' {\\n        ArrayBuilder::push(parts, concat_string_parts(current_parts_acc, chunk))\\n        let interp_end = if esc == '{' {\\n          scan_interp_end(s, len, next + 1, 1)\\n        } else {\\n          let mut ie = next + 1\\n          let mut depth = 1\\n          while ie < len && depth > 0 {\\n            let ic = String::char_code_at(s, ie)\\n            if ic == '(' {\\n              depth = depth + 1\\n            }\\n            else if ic == ')' {\\n              depth = depth - 1\\n            }\\n            ie = ie + 1\\n          }\\n          ie - 1\\n        }\\n        let expr_src = s[next + 1: interp_end]\\n        ArrayBuilder::push(parts, expr_src)\\n        current_idx = interp_end + 1\\n        current_start = interp_end + 1\\n        current_parts_acc = empty_string_array()\\n        current_has_interp = true\\n      } else {\\n        let escaped = if esc == '\\\"' {\\n          \\\"\\\\\\\"\\\"\\n        }\\n        else if esc == '\\\\\\\\' {\\n          \\\"\\\\\\\\\\\"\\n        }\\n        else if esc == 'n' {\\n          \\\"\\\\n\\\"\\n        }\\n        else if esc == 't' {\\n          \\\"\\\\t\\\"\\n        }\\n        else if esc == 'r' {\\n          String::from_char_code(13)\\n        }\\n        else if esc == '0' {\\n          String::from_char_code(0)\\n        }\\n        else throw(\\\"invalid escape sequence\\\")\\n        Array::push(current_parts_acc, chunk)\\n        Array::push(current_parts_acc, escaped)\\n        current_idx = next + 1\\n        current_start = next + 1\\n      }\\n    } else {\\n      current_idx = current_idx + 1\\n    }\\n  }\\n  (out_tok, out_next)\\n}\\n\\nlet lex_string: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\\n  lex_string_go(s, len, i + 1, i + 1, empty_string_array(), false, ArrayBuilder::new())\\n}\\n\\nlet scan_hex_digits_end: (String, Int, Int) -> Int = (s, len, i) -> {\\n  let mut out = i\\n  while out < len && is_hex_digit(String::char_code_at(s, out)) {\\n    out = out + 1\\n  }\\n  out\\n}\\n\\nlet parse_hex_from_string: (String) -> Int = (s) -> {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut acc = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    let digit = if c >= '0' && c <= '9' {\\n      c - 48\\n    } else if c >= 'a' && c <= 'f' {\\n      c - 87\\n    } else c - 55\\n    acc = acc * 16 + digit\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet parse_int_from_string: (String) -> Int = (s) -> {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut acc = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    acc = acc * 10 + (c - 48)\\n    i = i + 1\\n  }\\n  acc\\n}\\n\\nlet lex_decimal: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\\n  let int_end = scan_digits_end(s, len, i)\\n  if int_end == i {\\n    throw(\\\"expected digit\\\")\\n  }\\n  let after_field_dot = i >= 1 && String::char_code_at(s, i - 1) == '.' && (i < 2 || String::char_code_at(s, i - 2) != '.')\\n  if !after_field_dot && int_end < len && String::char_code_at(s, int_end) == '.' {\\n    if int_end + 1 < len && is_digit(String::char_code_at(s, int_end + 1)) {\\n      let int_str = s[i: int_end]\\n      let int_val = Int::to_double(parse_int_from_string(int_str))\\n      let (frac_val, frac_end) = parse_frac_digits(s, len, int_end + 1, 0.0, 10.0);\\n      if frac_end < len && String::char_code_at(s, frac_end) == 'f' {\\n        (TFloat(int_val + frac_val), frac_end + 1)\\n      } else {\\n        (TFloat(int_val + frac_val), frac_end)\\n      }\\n    } else {\\n      let int_str = s[i: int_end];\\n      (TInt(parse_int_from_string(int_str)), int_end)\\n    }\\n  } else if int_end < len && String::char_code_at(s, int_end) == 'f' {\\n    let int_str = s[i: int_end]\\n    let int_val = Int::to_double(parse_int_from_string(int_str))\\n    (TFloat(int_val), int_end + 1)\\n  } else {\\n    let int_str = s[i: int_end];\\n    (TInt(parse_int_from_string(int_str)), int_end)\\n  }\\n}\\n\\nlet lex_number: (String, Int, Int) -> (Token, Int) with { Error } = (s, len, i) -> {\\n  if i + 1 < len && String::char_code_at(s, i) == '0' {\\n    let next_c = String::char_code_at(s, i + 1)\\n    if next_c == 'x' || next_c == 'X' {\\n      let hex_start = i + 2\\n      let hex_end = scan_hex_digits_end(s, len, hex_start)\\n      if hex_end == hex_start {\\n        throw(\\\"expected hex digit after 0x\\\")\\n      }\\n      let hex_str = s[hex_start: hex_end];\\n      (TInt(parse_hex_from_string(hex_str)), hex_end)\\n    } else lex_decimal(s, len, i)\\n  } else lex_decimal(s, len, i)\\n}\\n\\nlet is_expr_ending_tok: (Token) -> Bool = (t) -> {\\n  match t {\\n    TRParen => true,\\n    TRBracket => true,\\n    TRBrace => true,\\n    TIdent(_) => true,\\n    TInt(_) => true,\\n    TFloat(_) => true,\\n    TString(_) => true,\\n    _ => false\\n  }\\n}\\n\\nlet lex_one_token: (String, Int, Int) -> (Token, Int) with { Error } = (source, len, pos) -> {\\n  let c = String::char_code_at(source, pos)\\n  if is_alpha(c) {\\n    lex_ident(source, len, pos)\\n  } else if is_digit(c) {\\n    lex_number(source, len, pos)\\n  } else if c == '\\\"' {\\n    lex_string(source, len, pos)\\n  } else if c == '+' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TPlusEq, pos + 2)\\n    } else (TPlus, pos + 1)\\n  } else if c == '-' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TThinArrow, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TMinusEq, pos + 2)\\n    } else (TMinus, pos + 1)\\n  } else if c == '*' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TStarEq, pos + 2)\\n    } else (TStar, pos + 1)\\n  } else if c == '/' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TSlashEq, pos + 2)\\n    } else (TSlash, pos + 1)\\n  } else if c == '%' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TPercentEq, pos + 2)\\n    } else (TPercent, pos + 1)\\n  } else if c == '=' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TEqEq, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TArrow, pos + 2)\\n    } else (TEq, pos + 1)\\n  } else if c == '!' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TNeq, pos + 2)\\n    } else (TNot, pos + 1)\\n  } else if c == '<' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TLte, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '<' {\\n      (TLShift, pos + 2)\\n    } else (TLt, pos + 1)\\n  } else if c == '>' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '=' {\\n      (TGte, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TRShift, pos + 2)\\n    } else (TGt, pos + 1)\\n  } else if c == '&' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '&' {\\n      (TAnd, pos + 2)\\n    } else (TBitAnd, pos + 1)\\n  } else if c == '|' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == '|' {\\n      (TOr, pos + 2)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '>' {\\n      (TPipeGt, pos + 2)\\n    } else (TBitOr, pos + 1)\\n  } else if c == '^' {\\n    (TBitXor, pos + 1)\\n  } else if c == '(' {\\n    (TLParen, pos + 1)\\n  } else if c == ')' {\\n    (TRParen, pos + 1)\\n  } else if c == '{' {\\n    (TLBrace, pos + 1)\\n  } else if c == '}' {\\n    (TRBrace, pos + 1)\\n  } else if c == '[' {\\n    (TLBracket, pos + 1)\\n  } else if c == ']' {\\n    (TRBracket, pos + 1)\\n  } else if c == ',' {\\n    (TComma, pos + 1)\\n  } else if c == ';' {\\n    (TSemicolon, pos + 1)\\n  } else if c == '.' {\\n    if pos + 2 < len && String::char_code_at(source, pos + 1) == '.' && String::char_code_at(source, pos + 2) == '.' {\\n      (TDotDotDot, pos + 3)\\n    } else if pos + 1 < len && String::char_code_at(source, pos + 1) == '.' {\\n      (TDotDot, pos + 2)\\n    } else (TDot, pos + 1)\\n  } else if c == ':' {\\n    if pos + 1 < len && String::char_code_at(source, pos + 1) == ':' {\\n      (TDoubleColon, pos + 2)\\n    } else (TColon, pos + 1)\\n  } else if c == '#' {\\n    (THash, pos + 1)\\n  } else if c == '~' {\\n    (TTilde, pos + 1)\\n  } else if c == '?' {\\n    (TQuestion, pos + 1)\\n  } else if c == '@' {\\n    let mut end = pos + 1\\n    while end < len && is_alnum(String::char_code_at(source, end)) {\\n      end = end + 1\\n    }\\n    if end > pos + 1 {\\n      (TIdent(String::substring(source, pos, end)), end)\\n    } else {\\n      throw(\\\"unexpected '@' without identifier\\\")\\n    }\\n  } else if c == '\\\\'' {\\n    lex_char(source, len, pos)\\n  } else throw(String::concat(\\\"unexpected character: \\\", String::from_char_code(c)))\\n}\\n\\nexport let lex_with_offsets: (String) -> (Array[Token], Array[Int], Array[Int]) with { Error } = (source) -> {\\n  let len = String::length(source)\\n  {\\n    let b = ArrayBuilder::new()\\n    let starts = ArrayBuilder::new()\\n    let ends = ArrayBuilder::new()\\n    let mut prev_tok = TEof\\n    let first_skip = skip_ws_with_newline(source, len, 0)\\n    let mut pos = first_skip.0\\n    let mut nl_before = first_skip.1\\n    while pos < len {\\n      let c = String::char_code_at(source, pos)\\n      let (tok, next) = lex_one_token(source, len, pos)\\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\\n        ArrayBuilder::push(b, TSemicolon)\\n        ArrayBuilder::push(starts, pos)\\n        ArrayBuilder::push(ends, pos)\\n      } else {\\n        ()\\n      }\\n      ArrayBuilder::push(b, tok)\\n      ArrayBuilder::push(starts, pos)\\n      ArrayBuilder::push(ends, next)\\n      prev_tok = tok\\n      let skipped = skip_ws_with_newline(source, len, next)\\n      pos = skipped.0\\n      nl_before = skipped.1\\n    }\\n    ArrayBuilder::push(b, TEof)\\n    ArrayBuilder::push(starts, len)\\n    ArrayBuilder::push(ends, len)\\n    (ArrayBuilder::freeze(b), ArrayBuilder::freeze(starts), ArrayBuilder::freeze(ends))\\n  }\\n}\\n\\nexport let offset_to_line_col: (String, Int) -> (Int, Int) = (source, offset) -> {\\n  let len = String::length(source)\\n  let bound = if offset < len { offset } else { len }\\n  let mut i = 0\\n  let mut line = 1\\n  let mut col = 1\\n  while i < bound {\\n    if String::char_code_at(source, i) == 10 {\\n      line = line + 1\\n      col = 1\\n    } else {\\n      col = col + 1\\n    }\\n    i = i + 1\\n  }\\n  (line, col)\\n}\\n\\nexport let lex: (String) -> Array[Token] with { Error } = (source) -> {\\n  let len = String::length(source)\\n  {\\n    let b = ArrayBuilder::new()\\n    let mut prev_tok = TEof\\n    let first_skip = skip_ws_with_newline(source, len, 0)\\n    let mut pos = first_skip.0\\n    let mut nl_before = first_skip.1\\n    while pos < len {\\n      let c = String::char_code_at(source, pos)\\n      let (tok, next) = lex_one_token(source, len, pos)\\n      if (c == '[' || c == '(') && nl_before && is_expr_ending_tok(prev_tok) {\\n        ArrayBuilder::push(b, TSemicolon)\\n      } else {\\n        ()\\n      }\\n      ArrayBuilder::push(b, tok)\\n      prev_tok = tok\\n      let skipped = skip_ws_with_newline(source, len, next)\\n      pos = skipped.0\\n      nl_before = skipped.1\\n    }\\n    ArrayBuilder::push(b, TEof)\\n    ArrayBuilder::freeze(b)\\n  }\\n}\\n\\nexport let lex_ok: (String) -> Bool = (source) -> {\\n  handle {\\n    let _ = lex(source)\\n    true\\n  } with Error {\\n    Throw(_) => false\\n  }\\n}\\n\\n\\n\\n\\nlet peek: (Array[Token], Int) -> Token = (tokens, pos) -> {\\n  if pos < Array::length(tokens) {\\n    Array::get(tokens, pos)\\n  } else TEof\\n}\\n\\nlet _no_tp: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet _no_tb: () -> Array[(String, Array[String])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", _no_tp())\\n  ], 0, 0)\\n}\\n\\nlet mode_if = 21\\n\\nlet tk_name: (Token) -> String = (tok) -> {\\n  match tok {\\n    TInt(_) => \\\"int\\\",\\n    TFloat(_) => \\\"float\\\",\\n    TString(_) => \\\"string\\\",\\n    TStringInterp(_) => \\\"string\\\",\\n    TIdent(_) => \\\"ident\\\",\\n    TLet => \\\"let\\\",\\n    TRec => \\\"rec\\\",\\n    TMut => \\\"mut\\\",\\n    TFn => \\\"fn\\\",\\n    TIf => \\\"if\\\",\\n    TElse => \\\"else\\\",\\n    TMatch => \\\"match\\\",\\n    TIs => \\\"is\\\",\\n    TDo => \\\"do\\\",\\n    TEnum => \\\"enum\\\",\\n    TStruct => \\\"struct\\\",\\n    TType => \\\"type\\\",\\n    TTrait => \\\"trait\\\",\\n    TImpl => \\\"impl\\\",\\n    TExport => \\\"export\\\",\\n    TTest => \\\"test\\\",\\n    TWhile => \\\"while\\\",\\n    TFor => \\\"for\\\",\\n    TIn => \\\"in\\\",\\n    TLoop => \\\"loop\\\",\\n    TBreak => \\\"break\\\",\\n    TContinue => \\\"continue\\\",\\n    TReturn => \\\"return\\\",\\n    TWith => \\\"with\\\",\\n    THandle => \\\"handle\\\",\\n    TThrow => \\\"throw\\\",\\n    TRaise => \\\"raise\\\",\\n    TYield => \\\"yield\\\",\\n    TBench => \\\"bench\\\",\\n    TDeclare => \\\"declare\\\",\\n    TAs => \\\"as\\\",\\n    TModule => \\\"module\\\",\\n    TSuberror => \\\"suberror\\\",\\n    TDerive => \\\"derive\\\",\\n    TOpen => \\\"open\\\",\\n    TImport => \\\"import\\\",\\n    TPlus => \\\"+\\\",\\n    TMinus => \\\"-\\\",\\n    TStar => \\\"*\\\",\\n    TSlash => \\\"/\\\",\\n    TPercent => \\\"%\\\",\\n    TEqEq => \\\"==\\\",\\n    TNeq => \\\"!=\\\",\\n    TLt => \\\"<\\\",\\n    TLte => \\\"<=\\\",\\n    TGt => \\\">\\\",\\n    TGte => \\\">=\\\",\\n    TAnd => \\\"&&\\\",\\n    TOr => \\\"||\\\",\\n    TNot => \\\"!\\\",\\n    TBitAnd => \\\"&\\\",\\n    TBitOr => \\\"|\\\",\\n    TBitXor => \\\"^\\\",\\n    TLShift => \\\"<<\\\",\\n    TRShift => \\\">>\\\",\\n    TPipeGt => \\\"|>\\\",\\n    TArrow => \\\"=>\\\",\\n    TThinArrow => \\\"->\\\",\\n    TEq => \\\"=\\\",\\n    TDot => \\\".\\\",\\n    TColon => \\\":\\\",\\n    TDoubleColon => \\\"::\\\",\\n    TComma => \\\",\\\",\\n    TSemicolon => \\\";\\\",\\n    THash => \\\"#\\\",\\n    TTilde => \\\"~\\\",\\n    TQuestion => \\\"?\\\",\\n    TPlusEq => \\\"+=\\\",\\n    TMinusEq => \\\"-=\\\",\\n    TStarEq => \\\"*=\\\",\\n    TSlashEq => \\\"/=\\\",\\n    TPercentEq => \\\"%=\\\",\\n    TLParen => \\\"(\\\",\\n    TRParen => \\\")\\\",\\n    TLBrace => \\\"{\\\",\\n    TRBrace => \\\"}\\\",\\n    TLBracket => \\\"[\\\",\\n    TRBracket => \\\"]\\\",\\n    TDotDot => \\\"..\\\",\\n    TDotDotDot => \\\"...\\\",\\n    TStringInterp(_) => \\\"string\\\",\\n    TEof => \\\"eof\\\"\\n  }\\n}\\n\\nlet is_tk: (Token, String) -> Bool = (tok, name) -> {\\n  tk_name(tok) == name\\n}\\n\\nlet expect_tk: (Array[Token], Int, String) -> Int with { Error } = (tokens, pos, expected) -> {\\n  if is_tk(peek(tokens, pos), expected) {\\n    pos + 1\\n  } else {\\n    let actual = tk_name(peek(tokens, pos))\\n    throw(\\\"expected \\\\{expected} but got \\\\{actual}\\\")\\n  }\\n}\\n\\nlet skip_semi: (Array[Token], Int) -> Int = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TSemicolon => pos + 1,\\n    _ => pos\\n  }\\n}\\n\\nlet empty_arms: () -> Array[(Pat, Expr)] = () -> {\\n  Array::slice([\\n    (PWild, EUnit)\\n  ], 0, 0)\\n}\\n\\nlet empty_pats: () -> Array[Pat] = () -> {\\n  Array::slice([\\n    PWild\\n  ], 0, 0)\\n}\\n\\nlet mode_block = 20\\n\\nlet mode_match = 22\\n\\nlet mode_while = 23\\n\\nlet empty_ctors: () -> Array[(String, Array[TypeExpr])] = () -> {\\n  Array::slice([\\n    (\\\"_\\\", Array::slice([\\n      TyUnit\\n    ], 0, 0))\\n  ], 0, 0)\\n}\\n\\nlet empty_exprs: () -> Array[Expr] = () -> {\\n  Array::slice([\\n    EUnit\\n  ], 0, 0)\\n}\\n\\nlet mode_for_in = 25\\n\\nlet mode_handle = 24\\n\\nexport let parse_derive_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\\n  let names = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  match peek(tokens, pos) {\\n    TDerive => match peek(tokens, pos + 1) {\\n      TLParen => {\\n        let mut dp = pos + 2\\n        let mut dd = true\\n        while dd {\\n          match peek(tokens, dp) {\\n            TRParen => {\\n              dd = false\\n              dp = dp + 1\\n            },\\n            TComma => {\\n              dp = dp + 1\\n            },\\n            TIdent(name) => {\\n              Array::push(names, name)\\n              dp = dp + 1\\n            },\\n            _ => throw(\\\"expected derive identifier\\\")\\n          }\\n        }\\n        (names, dp)\\n      },\\n      _ => (names, pos)\\n    },\\n    _ => (names, pos)\\n  }\\n}\\n\\nexport let skip_derive: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\\n  let (_, next) = parse_derive_names(tokens, pos)\\n  next\\n}\\n\\nlet empty_fields: () -> Array[(String, TypeExpr)] = () -> {\\n  Array::slice([\\n    (\\\"_\\\", TyUnit)\\n  ], 0, 0)\\n}\\n\\nlet empty_params: () -> Array[(String, Option[TypeExpr])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n}\\n\\nlet rec parse_pattern: (Array[Token], Int) -> (Pat, Int) with { Error } = (tokens, pos) -> {\\n  let rec parse_pat_cont: (Array[Token], Int, ArrayBuilder[Pat]) -> (Array[Pat], Int) with { Error } = (tokens, pos, b) -> {\\n    match peek(tokens, pos) {\\n      TComma => {\\n        let (p, pn) = parse_pattern(tokens, pos + 1)\\n        ArrayBuilder::push(b, p)\\n        parse_pat_cont(tokens, pn, b)\\n      },\\n      TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n      _ => throw(\\\"expected ',' or ')' in pattern list\\\")\\n    }\\n  }\\n  let parse_pats_until_rparen: (Array[Token], Int) -> (Array[Pat], Int) with { Error } = (tokens, pos) -> {\\n    match peek(tokens, pos) {\\n      TRParen => (empty_pats(), pos + 1),\\n      _ => {\\n        let (f, fn1) = parse_pattern(tokens, pos)\\n        let b = ArrayBuilder::new()\\n        ArrayBuilder::push(b, f)\\n        parse_pat_cont(tokens, fn1, b)\\n      }\\n    }\\n  }\\n  let (pat, next) = match peek(tokens, pos) {\\n    TInt(n) => (PInt(n), pos + 1),\\n    TMinus => match peek(tokens, pos + 1) {\\n      TInt(n) => (PInt(0 - n), pos + 2),\\n      TFloat(_) => (PWild, pos + 2),\\n      _ => throw(\\\"expected number literal after '-' in pattern\\\")\\n    },\\n    TFloat(_) => (PWild, pos + 1),\\n    TString(s) => (PString(s), pos + 1),\\n    TIdent(name) => {\\n      let next_is_lbrace = match peek(tokens, pos + 1) {\\n        TLBrace => true,\\n        _ => false\\n      }\\n      if name == \\\"true\\\" {\\n        (PBool(true), pos + 1)\\n      }\\n      else if name == \\\"false\\\" {\\n        (PBool(false), pos + 1)\\n      }\\n      else if name == \\\"_\\\" {\\n        (PWild, pos + 1)\\n      }\\n      else if name == \\\"record\\\" && next_is_lbrace {\\n        let mut rp = pos + 2\\n        let field_pats_b = ArrayBuilder::new()\\n        let mut rd = true\\n        while rd {\\n          match peek(tokens, rp) {\\n            TRBrace => {\\n              rd = false\\n            },\\n            TIdent(fname) => {\\n              match peek(tokens, rp + 1) {\\n                TColon => {\\n                  let (fp, fnext) = parse_pattern(tokens, rp + 2)\\n                  ArrayBuilder::push(field_pats_b, fp)\\n                  rp = fnext\\n                },\\n                TComma => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                },\\n                TRBrace => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                },\\n                _ => {\\n                  ArrayBuilder::push(field_pats_b, PBind(fname)); rp = rp + 1\\n                }\\n              }\\n              match peek(tokens, rp) {\\n                TComma => {\\n                  rp = rp + 1\\n                },\\n                _ => ()\\n              }\\n            },\\n            _ => {\\n              rp = rp + 1\\n            }\\n          }\\n        }\\n        let rp2 = rp + 1\\n        (PTuple(ArrayBuilder::freeze(field_pats_b)), rp2)\\n      }\\n      else {\\n        let fc = String::char_code_at(name, 0)\\n        if fc >= 65 && fc <= 90 {\\n          match peek(tokens, pos + 1) {\\n            TLParen => {\\n              let (args, end) = parse_pats_until_rparen(tokens, pos + 2);\\n              (PCtor(name, args), end)\\n            },\\n            TDoubleColon => match peek(tokens, pos + 2) {\\n              TLBrace => {\\n                let mut sp = pos + 3\\n                let field_pats = ArrayBuilder::new()\\n                let mut sd = true\\n                while sd {\\n                  match peek(tokens, sp) {\\n                    TRBrace => {\\n                      sd = false\\n                    },\\n                    TIdent(fname) => {\\n                      ArrayBuilder::push(field_pats, (fname, PBind(fname)))\\n                      sp = sp + 1\\n                      match peek(tokens, sp) {\\n                        TComma => {\\n                          sp = sp + 1\\n                        },\\n                        _ => ()\\n                      }\\n                    },\\n                    _ => {\\n                      sd = false\\n                    }\\n                  }\\n                }\\n                (PStruct(name, ArrayBuilder::freeze(field_pats)), sp + 1)\\n              },\\n              _ => (PCtor(name, empty_pats()), pos + 1)\\n            },\\n            _ => (PCtor(name, empty_pats()), pos + 1)\\n          }\\n        } else (PBind(name), pos + 1)\\n      }\\n    },\\n    TLParen => match peek(tokens, pos + 1) {\\n      TRParen => (PTuple(empty_pats()), pos + 2),\\n      _ => {\\n        let (f, n1) = parse_pattern(tokens, pos + 1)\\n        match peek(tokens, n1) {\\n          TRParen => (f, n1 + 1),\\n          TComma => {\\n            let b = ArrayBuilder::new()\\n            ArrayBuilder::push(b, f)\\n            let (rest, end) = parse_pat_cont(tokens, n1, b);\\n            (PTuple(rest), end)\\n          },\\n          _ => throw(\\\"expected ')' or ',' in pattern\\\")\\n        }\\n      }\\n    },\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"unexpected in pattern: \\\\{actual}\\\")\\n    }\\n  }\\n  match peek(tokens, next) {\\n    TBitOr => {\\n      let (right, end) = parse_pattern(tokens, next + 1);\\n      (POr(pat, right), end)\\n    },\\n    _ => (pat, next)\\n  }\\n}\\n\\nlet empty_type_exprs: () -> Array[TypeExpr] = () -> {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\nexport let skip_braced_body: (Array[Token], Int) -> Int = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let mut bp = pos + 1\\n      let mut depth = 1\\n      while depth > 0 {\\n        match peek(tokens, bp) {\\n          TLBrace => {\\n            depth = depth + 1\\n            bp = bp + 1\\n          },\\n          TRBrace => {\\n            depth = depth - 1\\n            bp = bp + 1\\n          },\\n          _ => {\\n            bp = bp + 1\\n          }\\n        }\\n      }\\n      bp\\n    },\\n    _ => pos\\n  }\\n}\\n\\nlet parse_method_tp_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nlet parse_method_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = parse_method_tp_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in method type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\nlet parse_trait_methods: (Array[Token], Int) -> (Array[(String, Array[TypeExpr], TypeExpr)], Array[(String, Array[String], Array[(String, Array[String])])], Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let sigs_b = ArrayBuilder::new()\\n      let gens_b = ArrayBuilder::new()\\n      let mut p = pos + 1\\n      while true {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            break\\n          },\\n          TIdent(method_name) => {\\n            let after_colon = match peek(tokens, p + 1) {\\n              TColon => p + 2,\\n              _ => p + 1\\n            }\\n            let (mtparams, mtbounds, after_binder) = match peek(tokens, after_colon) {\\n              TLBracket => parse_method_type_params(tokens, after_colon + 1),\\n              _ => (_no_tp(), _no_tb(), after_colon)\\n            }\\n            let (params, after_method_params) = match peek(tokens, after_binder) {\\n              TLParen => {\\n                let (params_ty, after_paren) = parse_type_impl(tokens, after_binder, 1)\\n                let params = match params_ty {\\n                  TyUnit => empty_type_exprs(),\\n                  TyTuple(elems) => elems,\\n                  _ => [\\n                    params_ty\\n                  ]\\n                }\\n                (params, after_paren)\\n              },\\n              _ => (empty_type_exprs(), after_binder)\\n            }\\n            let arrow_pos = expect_tk(tokens, after_method_params, \\\"->\\\")\\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\\n            ArrayBuilder::push(sigs_b, (method_name, params, ret_type))\\n            ArrayBuilder::push(gens_b, (method_name, mtparams, mtbounds))\\n            p = match peek(tokens, after_ret) {\\n              TSemicolon => after_ret + 1,\\n              _ => after_ret\\n            }\\n          },\\n          _ => throw(\\\"expected trait method signature or '}'\\\")\\n        }\\n      }\\n      (ArrayBuilder::freeze(sigs_b), ArrayBuilder::freeze(gens_b), p)\\n    },\\n    _ => (ArrayBuilder::freeze(ArrayBuilder::new()), ArrayBuilder::freeze(ArrayBuilder::new()), pos)\\n  }\\n}\\n\\nlet parse_trait_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  let empty_strings = Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let after_name = skip_bracketed_args(tokens, pos + 1)\\n      match peek(tokens, after_name) {\\n        TColon => {\\n          let supers = empty_strings\\n          let mut p = after_name + 1\\n          let mut done = false\\n          while !done {\\n            match peek(tokens, p) {\\n              TIdent(sname) => match peek(tokens, p + 1) {\\n                TPlus => {\\n                  Array::push(supers, sname)\\n                  p = p + 2\\n                },\\n                _ => {\\n                  Array::push(supers, sname)\\n                  p = p + 1\\n                  done = true\\n                }\\n              },\\n              _ => {\\n                done = true\\n              }\\n            }\\n          }\\n          let np = p\\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, np)\\n          (STrait(exported, name, supers, methods, method_gens), body_end)\\n        },\\n        _ => {\\n          let (methods, method_gens, body_end) = parse_trait_methods(tokens, after_name)\\n          (STrait(exported, name, empty_strings, methods, method_gens), body_end)\\n        }\\n      }\\n    },\\n    _ => throw(\\\"expected trait name\\\")\\n  }\\n}\\n\\nlet is_expr_end_token: (Token) -> Bool = (tok) -> {\\n  match tok {\\n    TInt(_) => true,\\n    TFloat(_) => true,\\n    TString(_) => true,\\n    TStringInterp(_) => true,\\n    TIdent(_) => true,\\n    TRParen => true,\\n    TRBracket => true,\\n    TRBrace => true,\\n    _ => false\\n  }\\n}\\n\\nlet is_non_pipe_infix: (Token) -> Bool = (tok) -> {\\n  match tok {\\n    TOr => true,\\n    TAnd => true,\\n    TEqEq => true,\\n    TNeq => true,\\n    TLt => true,\\n    TLte => true,\\n    TGt => true,\\n    TGte => true,\\n    TBitOr => true,\\n    TBitXor => true,\\n    TBitAnd => true,\\n    TLShift => true,\\n    TRShift => true,\\n    TPlus => true,\\n    TMinus => true,\\n    TStar => true,\\n    TSlash => true,\\n    TPercent => true,\\n    _ => false\\n  }\\n}\\n\\nlet parse_import_item: (Array[Token], Int) -> ((String, Option[String]), Int) with { Error } = (tokens, pos) -> {\\n  let parse_import_name: (Int) -> ((String, Option[String]), Int) with { Error } = (name_pos) -> {\\n    match peek(tokens, name_pos) {\\n      TIdent(name) => {\\n        let (base, after) = match peek(tokens, name_pos + 1) {\\n          TDoubleColon => match peek(tokens, name_pos + 2) {\\n            TIdent(member) =>\\n            (String::concat(name, String::concat(\\\"::\\\", member)), name_pos + 3),\\n            _ => throw(\\\"expected qualified member name after '::'\\\")\\n          },\\n          _ => (name, name_pos + 1)\\n        }\\n        match peek(tokens, after) {\\n          TAs => match peek(tokens, after + 1) {\\n            TIdent(alias) => ((base, Some(alias)), after + 2),\\n            _ => throw(\\\"expected alias name after 'as'\\\")\\n          },\\n          _ => ((base, None), after)\\n        }\\n      },\\n      _ => throw(\\\"expected import item name\\\")\\n    }\\n  }\\n  match peek(tokens, pos) {\\n    TIdent(_) => parse_import_name(pos),\\n    TType => parse_import_name(pos + 1),\\n    TTrait => parse_import_name(pos + 1),\\n    _ => throw(\\\"expected import item name\\\")\\n  }\\n}\\n\\nlet empty_import_items: () -> Array[(String, Option[String])] = () -> {\\n  Array::slice([\\n    (\\\"_\\\", None)\\n  ], 0, 0)\\n}\\n\\nlet parse_binding_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) => (String::concat(name, String::concat(\\\"::\\\", member)), pos + 3),\\n        _ => throw(\\\"expected qualified member name after '::'\\\")\\n      },\\n      _ => (name, pos + 1)\\n    },\\n    _ => throw(\\\"expected name after 'let'\\\")\\n  }\\n}\\n\\nlet rec collect_import_path: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\\n  match peek(tokens, pos) {\\n    TLBrace => (acc, pos),\\n    TDot => collect_import_path(tokens, pos + 1, String::concat(acc, \\\".\\\")),\\n    TDotDot => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"..\\\")),\\n    TSlash => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"/\\\")),\\n    TIdent(name) => collect_import_path(tokens, pos + 1, String::concat(acc, name)),\\n    TMinus => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"-\\\")),\\n    TModule => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"module\\\")),\\n    TType => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"type\\\")),\\n    TMatch => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"match\\\")),\\n    TTest => collect_import_path(tokens, pos + 1, String::concat(acc, \\\"test\\\")),\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(String::concat(\\\"unexpected token in import path: \\\", actual))\\n    }\\n  }\\n}\\n\\nlet skip_bracketed_args: (Array[Token], Int) -> Int = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBracket => {\\n      let mut bp = pos + 1\\n      let mut depth = 1\\n      while depth > 0 {\\n        match peek(tokens, bp) {\\n          TLBracket => {\\n            depth = depth + 1\\n            bp = bp + 1\\n          },\\n          TRBracket => {\\n            depth = depth - 1\\n            bp = bp + 1\\n          },\\n          TEof => {\\n            depth = 0\\n          },\\n          _ => {\\n            bp = bp + 1\\n          }\\n        }\\n      }\\n      bp\\n    },\\n    _ => pos\\n  }\\n}\\n\\nlet rec collect_effect_names: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, acc) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (acc, pos + 1),\\n    TIdent(name) => {\\n      let new_acc = if String::length(acc) == 0 {\\n        name\\n      } else \\\"\\\\{acc}, \\\\{name}\\\"\\n      match peek(tokens, pos + 1) {\\n        TComma => collect_effect_names(tokens, pos + 2, new_acc),\\n        TRBrace => (new_acc, pos + 2),\\n        _ => throw(\\\"expected ',' or '}' in effect list\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected effect name or '}'\\\")\\n  }\\n}\\n\\nlet rec parse_type_impl: (Array[Token], Int, Int) -> (TypeExpr, Int) with { Error } = (tokens, pos, mode) -> {\\n  let rec type_list_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\\n    match peek(tokens, pos) {\\n      TComma => match peek(tokens, pos + 1) {\\n        TRParen|TRBracket => (ArrayBuilder::freeze(b), pos + 1),\\n        _ => {\\n          let ts = match peek(tokens, pos + 1) {\\n            TIdent(_) => match peek(tokens, pos + 2) {\\n              TColon => pos + 3,\\n              TTilde => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              TQuestion => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          }\\n          let (ty, next) = parse_type_impl(tokens, ts, 0)\\n          ArrayBuilder::push(b, ty)\\n          type_list_rest(tokens, next, b)\\n        }\\n      }\\n      ,\\n      _ => (ArrayBuilder::freeze(b), pos)\\n    }\\n  }\\n  let parse_effect_suffix: (Array[Token], Int) -> (Option[String], Int) with { Error } = (tokens, rn) -> {\\n    match peek(tokens, rn) {\\n      TWith => {\\n        let with_pos = expect_tk(tokens, rn + 1, \\\"{\\\")\\n        let effect_name_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n        (Some(effect_name_pair.0), effect_name_pair.1)\\n      },\\n      _ => (None, rn)\\n    }\\n  }\\n  if mode == 0 {\\n    match peek(tokens, pos) {\\n      TLParen => match peek(tokens, pos + 1) {\\n        TRParen => {\\n          let after = pos + 2\\n          match peek(tokens, after) {\\n            TThinArrow => {\\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\\n              let eff = parse_effect_suffix(tokens, rn)\\n              (TyFn(empty_type_exprs(), ret, eff.0), eff.1)\\n            },\\n            _ => (TyUnit, after)\\n          }\\n        },\\n        _ => {\\n          let ty_start = match peek(tokens, pos + 1) {\\n            TIdent(_) => match peek(tokens, pos + 2) {\\n              TColon => pos + 3,\\n              TTilde => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              TQuestion => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          }\\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\\n          let (elems, after) = match peek(tokens, n1) {\\n            TRParen => ([\\n              first\\n            ], n1 + 1),\\n            TComma => {\\n              let b = ArrayBuilder::new()\\n              ArrayBuilder::push(b, first)\\n              let (rest, end) = type_list_rest(tokens, n1, b)\\n              let en = expect_tk(tokens, end, \\\")\\\");\\n              (rest, en)\\n            },\\n            _ => throw(\\\"expected ')' or ',' in type\\\")\\n          }\\n          match peek(tokens, after) {\\n            TThinArrow => {\\n              let (ret, rn) = parse_type_impl(tokens, after + 1, 0)\\n              let eff = parse_effect_suffix(tokens, rn)\\n              (TyFn(elems, ret, eff.0), eff.1)\\n            },\\n            _ => {\\n              let atom = if Array::length(elems) == 1 {\\n                Array::get(elems, 0)\\n              } else {\\n                TyTuple(elems)\\n              }\\n              match peek(tokens, after) {\\n                TQuestion => (TyApp(\\\"Option\\\", [\\n                  atom\\n                ]), after + 1),\\n                _ => (atom, after)\\n              }\\n            }\\n          }\\n        }\\n      },\\n      _ => {\\n        let (atom_ty, atom_next) = parse_type_impl(tokens, pos, 1)\\n        match peek(tokens, atom_next) {\\n          TThinArrow => {\\n            let (ret, rn) = parse_type_impl(tokens, atom_next + 1, 0)\\n            let eff = parse_effect_suffix(tokens, rn)\\n            (TyFn([\\n              atom_ty\\n            ], ret, eff.0), eff.1)\\n          },\\n          _ => (atom_ty, atom_next)\\n        }\\n      }\\n    }\\n  } else {\\n    let (base_ty, base_next) = match peek(tokens, pos) {\\n      TLParen => match peek(tokens, pos + 1) {\\n        TRParen => (TyUnit, pos + 2),\\n        _ => {\\n          let ty_start = match peek(tokens, pos + 1) {\\n            TIdent(_) => match peek(tokens, pos + 2) {\\n              TColon => pos + 3,\\n              TTilde => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              TQuestion => match peek(tokens, pos + 3) {\\n                TColon => pos + 4,\\n                _ => pos + 1\\n              },\\n              _ => pos + 1\\n            },\\n            _ => pos + 1\\n          }\\n          let (first, n1) = parse_type_impl(tokens, ty_start, 0)\\n          match peek(tokens, n1) {\\n            TRParen => (first, n1 + 1),\\n            TComma => {\\n              let b = ArrayBuilder::new()\\n              ArrayBuilder::push(b, first)\\n              let (rest, end) = type_list_rest(tokens, n1, b)\\n              let en = expect_tk(tokens, end, \\\")\\\");\\n              (TyTuple(rest), en)\\n            },\\n            _ => throw(\\\"expected ')' or ',' in type\\\")\\n          }\\n        }\\n      },\\n      TIdent(name) => match peek(tokens, pos + 1) {\\n        TLBracket => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          match peek(tokens, n1) {\\n            TRBracket => (TyApp(name, [\\n              first\\n            ]), n1 + 1),\\n            TComma => {\\n              let b = ArrayBuilder::new()\\n              ArrayBuilder::push(b, first)\\n              let (rest, end) = type_list_rest(tokens, n1, b)\\n              let en = expect_tk(tokens, end, \\\"]\\\");\\n              (TyApp(name, rest), en)\\n            },\\n            _ => throw(\\\"expected ']' or ',' in type application\\\")\\n          }\\n        },\\n        _ => (TyName(name), pos + 1)\\n      },\\n      _ => {\\n        let actual = tk_name(peek(tokens, pos))\\n        throw(\\\"expected type but got \\\\{actual}\\\")\\n      }\\n    }\\n    match peek(tokens, base_next) {\\n      TQuestion => (TyApp(\\\"Option\\\", [\\n        base_ty\\n      ]), base_next + 1),\\n      _ => (base_ty, base_next)\\n    }\\n  }\\n}\\n\\nexport let parse_type: (Array[Token], Int) -> (TypeExpr, Int) with { Error } = (tokens, pos) -> {\\n  parse_type_impl(tokens, pos, 0)\\n}\\n\\nlet parse_one_param: (Array[Token], Int) -> ((String, Option[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TTilde => {\\n        let labeled_name = \\\"\\\\{name}~\\\"\\n        match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\\n            ((labeled_name, Some(ty)), tp)\\n          },\\n          _ => ((labeled_name, None), pos + 2)\\n        }\\n      },\\n      TQuestion => {\\n        let opt_name = \\\"\\\\{name}?\\\"\\n        match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0);\\n            ((opt_name, Some(ty)), tp)\\n          },\\n          _ => ((opt_name, None), pos + 2)\\n        }\\n      },\\n      TColon => {\\n        let (ty, tp) = parse_type_impl(tokens, pos + 2, 0);\\n        let tp2 = match peek(tokens, tp) {\\n          TColon => {\\n            let mut bp = tp + 1\\n            let mut bd = true\\n            while bd {\\n              match peek(tokens, bp) {\\n                TIdent(_) => {\\n                  bp = bp + 1; match peek(tokens, bp) {\\n                    TPlus => {\\n                      bp = bp + 1\\n                    },\\n                    _ => {\\n                      bd = false\\n                    }\\n                  }\\n                },\\n                _ => {\\n                  bd = false\\n                }\\n              }\\n            }\\n            bp\\n          },\\n          _ => tp\\n        }\\n        ((name, Some(ty)), tp2)\\n      },\\n      _ => ((name, None), pos + 1)\\n    },\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"expected parameter name at #\\\\{pos} token=\\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nlet rec parse_param_cont: (Array[Token], Int, ArrayBuilder[(String, Option[TypeExpr])]) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRParen => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (p, pn) = parse_one_param(tokens, pos + 1)\\n        ArrayBuilder::push(b, p)\\n        parse_param_cont(tokens, pn, b)\\n      }\\n    },\\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"expected ',' or ')' in param list at #\\\\{pos} token=\\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nlet parse_param_list: (Array[Token], Int) -> (Array[(String, Option[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TRParen => (empty_params(), pos + 1),\\n    _ => {\\n      let (f, fn1) = parse_one_param(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, f)\\n      parse_param_cont(tokens, fn1, b)\\n    }\\n  }\\n}\\n\\nlet parse_struct_field: (Array[Token], Int) -> ((String, TypeExpr), Bool, Int) with { Error } = (tokens, pos) -> {\\n  let (is_mut, p) = match peek(tokens, pos) {\\n    TMut => (true, pos + 1),\\n    _ => (false, pos)\\n  }\\n  match peek(tokens, p) {\\n    TIdent(name) => {\\n      let cn = expect_tk(tokens, p + 1, \\\":\\\")\\n      let (ty, next) = parse_type_impl(tokens, cn, 0);\\n      ((name, ty), is_mut, next)\\n    },\\n    _ => throw(\\\"expected field name\\\")\\n  }\\n}\\n\\nlet rec is_lambda_start_impl: (Array[Token], Int, Int, Bool) -> Bool = (tokens, pos, depth, has_colon) -> {\\n  match peek(tokens, pos) {\\n    TColon => if depth == 0 {\\n      is_lambda_start_impl(tokens, pos + 1, depth, true)\\n    } else is_lambda_start_impl(tokens, pos + 1, depth, has_colon),\\n    TRParen => if depth == 0 {\\n      match peek(tokens, pos + 1) {\\n        TThinArrow => true,\\n        TLBrace => has_colon,\\n        _ => false\\n      }\\n    } else is_lambda_start_impl(tokens, pos + 1, depth - 1, has_colon),\\n    TLParen => is_lambda_start_impl(tokens, pos + 1, depth + 1, has_colon),\\n    TEof => false,\\n    _ => is_lambda_start_impl(tokens, pos + 1, depth, has_colon)\\n  }\\n}\\n\\nlet is_lambda_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\\n  is_lambda_start_impl(tokens, pos, 0, false)\\n}\\n\\nlet rec parse_ctor_types_rest: (Array[Token], Int, ArrayBuilder[TypeExpr]) -> (Array[TypeExpr], Int) with { Error } = (tokens, pos, b) -> {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      let (ty, next) = parse_type_impl(tokens, pos + 1, 0)\\n      ArrayBuilder::push(b, ty)\\n      parse_ctor_types_rest(tokens, next, b)\\n    },\\n    TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or ')' in constructor types\\\")\\n  }\\n}\\n\\nlet parse_enum_ctor: (Array[Token], Int) -> ((String, Array[TypeExpr]), Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLParen => match peek(tokens, pos + 2) {\\n        TRParen => ((name, empty_type_exprs()), pos + 3),\\n        _ => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, first)\\n          let (types, end) = parse_ctor_types_rest(tokens, n1, b);\\n          ((name, types), end)\\n        }\\n      },\\n      _ => ((name, empty_type_exprs()), pos + 1)\\n    },\\n    _ => throw(\\\"expected constructor name\\\")\\n  }\\n}\\n\\nlet rec parse_enum_ctors_rest: (Array[Token], Int, ArrayBuilder[(String, Array[TypeExpr])]) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos, b) -> {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\\n        ArrayBuilder::push(b, ctor)\\n        parse_enum_ctors_rest(tokens, next, b)\\n      }\\n    },\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (ctor, next) = parse_enum_ctor(tokens, pos + 1)\\n        ArrayBuilder::push(b, ctor)\\n        parse_enum_ctors_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ';', ',' or '}' in enum\\\")\\n  }\\n}\\n\\nlet parse_enum_ctors: (Array[Token], Int) -> (Array[(String, Array[TypeExpr])], Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_ctors(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_enum_ctor(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_enum_ctors_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nlet parse_enum_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (params, after_name) = match peek(tokens, pos + 1) {\\n        TLBracket => {\\n          let b = ArrayBuilder::new()\\n          let mut skip = pos + 2\\n          let mut depth = 1\\n          let mut expect_name = true\\n          while depth > 0 {\\n            match peek(tokens, skip) {\\n              TLBracket => {\\n                depth = depth + 1; skip = skip + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1; skip = skip + 1\\n              },\\n              TComma => {\\n                if depth == 1 {\\n                  expect_name = true\\n                }\\n                skip = skip + 1\\n              },\\n              TIdent(nm) => {\\n                if depth == 1 && expect_name {\\n                  ArrayBuilder::push(b, nm)\\n                  expect_name = false\\n                }\\n                skip = skip + 1\\n              },\\n              _ => {\\n                skip = skip + 1\\n              }\\n            }\\n          }\\n          (ArrayBuilder::freeze(b), skip)\\n        },\\n        _ => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), pos + 1)\\n      }\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (ctors, end) = parse_enum_ctors(tokens, br);\\n      let (derives, final_pos) = parse_derive_names(tokens, end)\\n      (SEnum(exported, name, params, ctors, derives), final_pos)\\n    },\\n    _ => throw(\\\"expected enum name\\\")\\n  }\\n}\\n\\nlet parse_suberror_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TLParen => match peek(tokens, pos + 2) {\\n        TRParen => {\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, (name, empty_type_exprs()))\\n          (SSuberror(exported, name, ArrayBuilder::freeze(b)), pos + 3)\\n        },\\n        _ => {\\n          let (first, n1) = parse_type_impl(tokens, pos + 2, 0)\\n          let args_b = ArrayBuilder::new()\\n          ArrayBuilder::push(args_b, first)\\n          let (args, end) = parse_ctor_types_rest(tokens, n1, args_b)\\n          let ctors_b = ArrayBuilder::new()\\n          ArrayBuilder::push(ctors_b, (name, args))\\n          (SSuberror(exported, name, ArrayBuilder::freeze(ctors_b)), end)\\n        }\\n      },\\n      TLBrace => {\\n        let (ctors, end) = parse_enum_ctors(tokens, pos + 2);\\n        (SSuberror(exported, name, ctors), end)\\n      },\\n      _ => throw(\\\"expected '(' or '{' after suberror name\\\")\\n    },\\n    _ => throw(\\\"expected suberror name\\\")\\n  }\\n}\\n\\nlet parse_impl_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nlet parse_impl_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = parse_impl_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in impl type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\nlet parse_impl_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\\n  let (type_params, type_bounds, after_tp) = match peek(tokens, pos) {\\n    TLBracket => parse_impl_type_params(tokens, pos + 1),\\n    _ => (_no_tp(), _no_tb(), pos)\\n  }\\n  match peek(tokens, after_tp) {\\n    TIdent(trait_name) => {\\n      let fp = expect_tk(tokens, after_tp + 1, \\\"for\\\")\\n      match peek(tokens, fp) {\\n        TIdent(type_name) => {\\n          let after_targs = skip_bracketed_args(tokens, fp + 1)\\n          (SImpl(type_params, type_bounds, trait_name, type_name), after_targs)\\n        },\\n        _ => throw(\\\"expected type name after 'for'\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected trait name after 'impl'\\\")\\n  }\\n}\\n\\nlet parse_type_params_list: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nlet parse_effect_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (type_params, after_params) = match peek(tokens, pos + 1) {\\n        TLBracket => parse_type_params_list(tokens, pos + 2),\\n        _ => (ArrayBuilder::freeze(ArrayBuilder::new()), pos + 1)\\n      }\\n      let br = expect_tk(tokens, after_params, \\\"{\\\")\\n      let ops_b = ArrayBuilder::new()\\n      let mut p = br\\n      while true {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            break\\n          },\\n          TIdent(op_name) => {\\n            let (params, after_op_params) = match peek(tokens, p + 1) {\\n              TLParen => {\\n                let (params_ty, after_paren) = parse_type_impl(tokens, p + 1, 1)\\n                let params = match params_ty {\\n                  TyUnit => empty_type_exprs(),\\n                  TyTuple(elems) => elems,\\n                  _ => [\\n                    params_ty\\n                  ]\\n                }\\n                (params, after_paren)\\n              },\\n              _ => (empty_type_exprs(), p + 1)\\n            }\\n            let arrow_pos = expect_tk(tokens, after_op_params, \\\"->\\\")\\n            let (ret_type, after_ret) = parse_type_impl(tokens, arrow_pos, 0)\\n            ArrayBuilder::push(ops_b, (op_name, params, ret_type))\\n            p = match peek(tokens, after_ret) {\\n              TSemicolon => after_ret + 1,\\n              _ => after_ret\\n            }\\n          },\\n          _ => throw(\\\"expected effect operation name or '}'\\\")\\n        }\\n      }\\n      (SEffectDef(exported, name, type_params, ArrayBuilder::freeze(ops_b)), p)\\n    },\\n    _ => throw(\\\"expected effect name\\\")\\n  }\\n}\\n\\nlet parse_type_alias_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let (params, after_name) = match peek(tokens, pos + 1) {\\n        TLBracket => parse_type_params_list(tokens, pos + 2),\\n        _ => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), pos + 1)\\n      }\\n      let ep = expect_tk(tokens, after_name, \\\"=\\\")\\n      let (ty, next) = parse_type_impl(tokens, ep, 0);\\n      (STypeAlias(exported, name, params, ty), next)\\n    },\\n    _ => throw(\\\"expected type alias name\\\")\\n  }\\n}\\n\\nlet parse_impl_stmt_dispatch: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\\n  parse_impl_stmt(tokens, pos)\\n}\\n\\nlet push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {\\n  if is_mut {\\n    let (fname, _) = field\\n    ArrayBuilder::push(mb, fname)\\n  } else {\\n    ()\\n  }\\n}\\n\\nlet rec parse_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\\n      _ => {\\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        push_mut_name(mb, field, is_mut)\\n        parse_struct_fields_rest(tokens, next, b, mb)\\n      }\\n    },\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\\n      _ => {\\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        push_mut_name(mb, field, is_mut)\\n        parse_struct_fields_rest(tokens, next, b, mb)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\\n    _ => throw(\\\"expected ';', ',' or '}' in struct\\\")\\n  }\\n}\\n\\nlet parse_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_fields(), Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), pos + 1),\\n    _ => {\\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      let mb = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      push_mut_name(mb, first, is_mut)\\n      parse_struct_fields_rest(tokens, next, b, mb)\\n    }\\n  }\\n}\\n\\nlet parse_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let after_name = skip_bracketed_args(tokens, pos + 1)\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (fields, mut_names, end) = parse_struct_fields(tokens, br);\\n      let (derives, final_pos) = parse_derive_names(tokens, end)\\n      (SStruct(exported, name, fields, derives, mut_names), final_pos)\\n    },\\n    _ => throw(\\\"expected struct name\\\")\\n  }\\n}\\n\\n\\nexport {\\n  _no_tb, _no_tp, collect_effect_names, collect_import_path, empty_arms, empty_exprs, empty_fields, empty_import_items, empty_params, empty_pats, empty_type_exprs, expect_tk, is_expr_end_token, is_lambda_start, is_non_pipe_infix, is_tk, mode_block, mode_for_in, mode_handle, mode_if, mode_match, mode_while, parse_binding_name, parse_effect_stmt, parse_enum_stmt, parse_impl_stmt_dispatch, parse_import_item, parse_param_list, parse_pattern, parse_struct_field, parse_struct_stmt, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, parse_type_impl, parse_derive_names, peek, skip_derive, skip_semi, tk_name\\n}\\n\\nexport {\\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, skip_derive, parse_derive_names, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\\nexport {\\n  peek, is_tk, _no_tb, _no_tp, mode_if, tk_name, expect_tk, skip_semi, empty_arms, empty_pats, mode_block, mode_match, mode_while, parse_type, empty_exprs, mode_for_in, mode_handle, skip_derive, parse_derive_names, empty_fields, empty_params, parse_pattern, is_lambda_start, parse_enum_stmt, parse_type_impl, empty_type_exprs, parse_param_list, parse_trait_stmt, is_expr_end_token, is_non_pipe_infix, parse_effect_stmt, parse_import_item, parse_struct_stmt, empty_import_items, parse_binding_name, parse_struct_field, collect_import_path, parse_suberror_stmt, collect_effect_names, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\\n\\n\\n\\n\\n\\nlet build_interp_expr: (Array[String], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Expr with { Error } = (parts, parse_recur) -> {\\n  let concat_expr: (Expr, Expr) -> Expr = (a, b) -> {\\n    ECall(EIdent(\\\"String::concat\\\", -1), [\\n      a,\\n      b\\n    ], -1)\\n  }\\n  let plen = Array::length(parts)\\n  let mut result = EString(\\\"\\\")\\n  let mut has_val = false\\n  let mut i = 0\\n  while i < plen {\\n    let part = Array::get(parts, i)\\n    if i % 2 == 0 {\\n      if String::length(part) > 0 {\\n        let piece = EString(part)\\n        result = if has_val {\\n          concat_expr(result, piece)\\n        } else {\\n          piece\\n        }\\n        has_val = true\\n      } else {\\n        ()\\n      }\\n    } else {\\n      let (pe, _) = parse_recur(lex(part), 0, 0)\\n      let piece = ECall(EIdent(\\\"__to_string\\\", -1), [\\n        pe\\n      ], -1)\\n      result = if has_val {\\n        concat_expr(result, piece)\\n      } else {\\n        piece\\n      }\\n      has_val = true\\n    }\\n    i = i + 1\\n  }\\n  result\\n}\\n\\nlet rec desugar_loop_body: (Expr, Array[String]) -> Expr = (expr, param_names) -> {\\n  match expr {\\n    EBreak(opt) => match opt {\\n      Some(val) => EAssign(\\\"__loop_result\\\", desugar_loop_body(val, param_names), EBreak(None)),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => {\\n      if Array::length(args) == 0 {\\n        EContinue(args)\\n      } else {\\n        let nargs = Array::length(args)\\n        let nparams = Array::length(param_names)\\n        if nargs > nparams {\\n          EContinue(args)\\n        } else {\\n        let mut result = EContinue(Array::slice([EUnit], 0, 0))\\n        let mut ci = nargs - 1\\n        while ci >= 0 {\\n          result = EAssign(Array::get(param_names, ci), EIdent(String::concat(\\\"__lt\\\", __to_string(ci)), -1), result)\\n          ci = ci - 1\\n        }\\n        let mut ci2 = nargs - 1\\n        while ci2 >= 0 {\\n          result = ELet(String::concat(\\\"__lt\\\", __to_string(ci2)), desugar_loop_body(Array::get(args, ci2), param_names), result)\\n          ci2 = ci2 - 1\\n        }\\n        result\\n        }\\n      }\\n    },\\n    EWhile(_, _) => expr,\\n    ELoop(_, _) => expr,\\n    EFn(_, _, _, _, _, _) => expr,\\n    EIf(c, t, e) => EIf(desugar_loop_body(c, param_names), desugar_loop_body(t, param_names), desugar_loop_body(e, param_names)),\\n    ELet(n, v, b) => ELet(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\\n    ELetMut(n, v, b) => ELetMut(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\\n    ESeq(a, b) => ESeq(desugar_loop_body(a, param_names), desugar_loop_body(b, param_names)),\\n    EAssign(n, v, c) => EAssign(n, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\\n    EMatch(_, _) => expr,\\n    EHandle(_, _) => expr,\\n    EBinOp(op, l, r) => EBinOp(op, desugar_loop_body(l, param_names), desugar_loop_body(r, param_names)),\\n    ECall(_, _, _) => expr,\\n    ELetRec(n, v, b) => ELetRec(n, desugar_loop_body(v, param_names), desugar_loop_body(b, param_names)),\\n    EThrow(e) => EThrow(desugar_loop_body(e, param_names)),\\n    EUnaryOp(op, e) => EUnaryOp(op, desugar_loop_body(e, param_names)),\\n    EDot(obj, field, off) => EDot(desugar_loop_body(obj, param_names), field, off),\\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, desugar_loop_body(v, param_names), desugar_loop_body(c, param_names)),\\n    _ => expr\\n  }\\n}\\n\\n\\nlet parse_loop_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TLParen => {\\n      let param_names_b = ArrayBuilder::new()\\n      let param_inits_b = ArrayBuilder::new()\\n      let mut cur = pos + 2\\n      let mut done = false\\n      while !done {\\n        match peek(tokens, cur) {\\n          TRParen => {\\n            cur = cur + 1\\n            done = true\\n          },\\n          TIdent(name) => {\\n            let eq_pos = expect_tk(tokens, cur + 1, \\\"=\\\")\\n            let (init, next_pos) = parse_recur(tokens, eq_pos, 0)\\n            ArrayBuilder::push(param_names_b, name)\\n            ArrayBuilder::push(param_inits_b, init)\\n            match peek(tokens, next_pos) {\\n              TComma => {\\n                cur = next_pos + 1\\n              },\\n              TRParen => {\\n                cur = next_pos + 1\\n                done = true\\n              },\\n              _ => throw(\\\"expected ',' or ')' in loop params\\\")\\n            }\\n          },\\n          _ => throw(\\\"expected loop parameter name or ')'\\\")\\n        }\\n      }\\n      let body_pos = expect_tk(tokens, cur, \\\"{\\\")\\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\\n      let pnames = ArrayBuilder::freeze(param_names_b)\\n      let pinits = ArrayBuilder::freeze(param_inits_b)\\n      let transformed_body = desugar_loop_body(body, pnames)\\n      let while_expr = EWhile(EBool(true), transformed_body)\\n      let result = ELetMut(\\\"__loop_result\\\", EInt(0),\\n        ESeq(while_expr, EIdent(\\\"__loop_result\\\", -1)))\\n      let mut wrapped = result\\n      let mut wi = Array::length(pnames) - 1\\n      while wi >= 0 {\\n        wrapped = ELetMut(Array::get(pnames, wi), Array::get(pinits, wi), wrapped)\\n        wi = wi - 1\\n      }\\n      (wrapped, end_pos)\\n    },\\n    _ => {\\n      let body_pos = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\\n      (EWhile(EBool(true), body), end_pos)\\n    }\\n  }\\n}\\n\\nlet parse_break_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TRBrace => (EBreak(None), pos + 1),\\n    TSemicolon => (EBreak(None), pos + 1),\\n    TEof => (EBreak(None), pos + 1),\\n    _ => {\\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      (EBreak(Some(expr)), next_pos)\\n    }\\n  }\\n}\\n\\nlet parse_throw_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  let open_pos = expect_tk(tokens, pos + 1, \\\"(\\\")\\n  let (expr, next_pos) = parse_recur(tokens, open_pos, 0)\\n  let close_pos = expect_tk(tokens, next_pos, \\\")\\\")\\n  (EThrow(expr), close_pos)\\n}\\n\\nlet parse_return_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TRBrace => (EReturn(EUnit), pos + 1),\\n    TSemicolon => (EReturn(EUnit), pos + 1),\\n    TEof => (EReturn(EUnit), pos + 1),\\n    _ => {\\n      let (expr, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      (EReturn(expr), next_pos)\\n    }\\n  }\\n}\\n\\nlet parse_perform_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TRParen => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TRBracket => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TRBrace => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TComma => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TSemicolon => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    TEof => (EIdent(\\\"perform\\\", -1), pos + 1),\\n    _ => {\\n      let (arg, next_pos) = parse_recur(tokens, pos + 1, 10)\\n      (ECall(EIdent(\\\"perform\\\", -1), [\\n        arg\\n      ], offset_at(starts, pos)), next_pos)\\n    }\\n  }\\n}\\n\\nlet rec parse_array_elems_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      let next_pos = pos + 1\\n      match peek(tokens, next_pos) {\\n        TRBracket => (ArrayBuilder::freeze(b), next_pos),\\n        TDotDotDot => {\\n          let (expr, end_pos) = parse_recur(tokens, next_pos + 1, 0)\\n          ArrayBuilder::push(b, ESpread(expr))\\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\\n        },\\n        _ => {\\n          let (expr, end_pos) = parse_recur(tokens, next_pos, 0)\\n          ArrayBuilder::push(b, expr)\\n          parse_array_elems_rest(tokens, starts, end_pos, b, parse_recur)\\n        }\\n      }\\n    },\\n    _ => (ArrayBuilder::freeze(b), pos)\\n  }\\n}\\n\\nlet parse_array_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TRBracket => (EArray(empty_exprs()), pos + 2),\\n    TDotDotDot => {\\n      let b = ArrayBuilder::new()\\n      let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\\n      ArrayBuilder::push(b, ESpread(first))\\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\\n      let close_pos = expect_tk(tokens, end_pos, \\\"]\\\")\\n      (EArray(items), close_pos)\\n    },\\n    _ => {\\n      let b = ArrayBuilder::new()\\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      ArrayBuilder::push(b, first)\\n      let (items, end_pos) = parse_array_elems_rest(tokens, starts, next_pos, b, parse_recur)\\n      let close_pos = expect_tk(tokens, end_pos, \\\"]\\\")\\n      (EArray(items), close_pos)\\n    }\\n  }\\n}\\n\\nlet rec parse_comma_exprs_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TComma => {\\n      match peek(tokens, pos + 1) {\\n        TRParen => (ArrayBuilder::freeze(b), pos + 1),\\n        _ => {\\n          let (e, next) = parse_recur(tokens, pos + 1, 0)\\n          ArrayBuilder::push(b, e)\\n          parse_comma_exprs_rest(tokens, starts, next, b, parse_recur)\\n        }\\n      }\\n    },\\n    _ => (ArrayBuilder::freeze(b), pos)\\n  }\\n}\\n\\nlet parse_continue_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TLParen => {\\n      let b = ArrayBuilder::new()\\n      match peek(tokens, pos + 2) {\\n        TRParen => (EContinue(empty_exprs()), pos + 3),\\n        _ => {\\n          let (first, next_pos) = parse_recur(tokens, pos + 2, 0)\\n          ArrayBuilder::push(b, first)\\n          let (args, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\\n          let close_pos = expect_tk(tokens, end_pos, \\\")\\\")\\n          (EContinue(args), close_pos)\\n        }\\n      }\\n    },\\n    _ => (EContinue(empty_exprs()), pos + 1)\\n  }\\n}\\n\\nlet parse_control_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TLBrace => parse_recur(tokens, pos + 1, 20),\\n    TIf => parse_recur(tokens, pos + 1, 21),\\n    TMatch => parse_recur(tokens, pos + 1, 22),\\n    THandle => parse_recur(tokens, pos + 1, 24),\\n    TWhile => parse_recur(tokens, pos + 1, 23),\\n    TFor => parse_recur(tokens, pos + 1, 25),\\n    TThrow => parse_throw_primary(tokens, starts, pos, parse_recur),\\n    TBreak => parse_break_primary(tokens, starts, pos, parse_recur),\\n    TContinue => parse_continue_primary(tokens, starts, pos, parse_recur),\\n    TRaise => throw(\\\"'raise' is deprecated, use 'throw(expr)' instead\\\"),\\n    TReturn => parse_return_primary(tokens, starts, pos, parse_recur),\\n    TDo => throw(\\\"'do' is reserved; use 'while' or 'for' instead\\\"),\\n    TLoop => parse_loop_primary(tokens, starts, pos, parse_recur),\\n    TYield => throw(\\\"'yield' is not supported\\\"),\\n    TDeclare => throw(\\\"'declare' is not supported\\\"),\\n    _ => {\\n      let prev_name = if pos > 0 {\\n        tk_name(peek(tokens, pos - 1))\\n      } else {\\n        \\\"start\\\"\\n      }\\n      let actual = tk_name(peek(tokens, pos))\\n      let next_name = tk_name(peek(tokens, pos + 1))\\n      throw(\\\"unexpected token at #\\\\{pos}: \\\\{actual} (prev=\\\\{prev_name}, next=\\\\{next_name})\\\")\\n    }\\n  }\\n}\\n\\nlet rec parse_ctor_record_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    TIdent(fname) => {\\n      let colon_pos = expect_tk(tokens, pos + 1, \\\":\\\")\\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\\n      ArrayBuilder::push(b, (fname, val))\\n      match peek(tokens, next_pos) {\\n        TComma => parse_ctor_record_fields(tokens, starts, next_pos + 1, b, parse_recur),\\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\\n        _ => throw(\\\"expected ',' or '}' in record literal\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected field name or '}' in record literal\\\")\\n  }\\n}\\n\\nlet parse_generic_fn_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  let mut skip_pos = pos + 1\\n  let mut depth = 1\\n  while depth > 0 {\\n    match peek(tokens, skip_pos) {\\n      TLBracket => {\\n        depth = depth + 1\\n      },\\n      TRBracket => {\\n        depth = depth - 1\\n      },\\n      _ => ()\\n    }\\n    skip_pos = skip_pos + 1\\n  }\\n  let (params, after_params) = parse_param_list(tokens, skip_pos)\\n  match peek(tokens, after_params) {\\n    TThinArrow => {\\n      let (ret_ty, ret_pos) = parse_type_impl(tokens, after_params + 1, 0)\\n      let effect_pair = match peek(tokens, ret_pos) {\\n        TWith => {\\n          let with_pos = expect_tk(tokens, ret_pos + 1, \\\"{\\\")\\n          let effect_name_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n          let effect_name = effect_name_pair.0\\n          let end_pos = effect_name_pair.1\\n          (Some(effect_name), end_pos)\\n        },\\n        _ => (None, ret_pos)\\n      }\\n      let effect = effect_pair.0\\n      let effect_next = effect_pair.1\\n      let body_pos = expect_tk(tokens, effect_next, \\\"{\\\")\\n      let (body, end_pos) = parse_recur(tokens, body_pos, 20)\\n      (EFn(_no_tp(), _no_tb(), params, Some(ret_ty), effect, body), end_pos)\\n    },\\n    TLBrace => {\\n      let (body, end_pos) = parse_recur(tokens, after_params + 1, 20)\\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end_pos)\\n    },\\n    _ => throw(\\\"expected '->' or '{' after generic function params\\\")\\n  }\\n}\\n\\nlet is_generic_fn_start: (Array[Token], Int) -> Bool = (tokens, pos) -> {\\n  match peek(tokens, pos + 1) {\\n    TIdent(_) => {\\n      let mut p = pos + 2\\n      let mut depth = 1\\n      while depth > 0 {\\n        match peek(tokens, p) {\\n          TLBracket => {\\n            depth = depth + 1\\n          },\\n          TRBracket => {\\n            depth = depth - 1\\n          },\\n          TEof => {\\n            depth = 0\\n          },\\n          _ => ()\\n        }\\n        p = p + 1\\n      }\\n      match peek(tokens, p) {\\n        TLParen => true,\\n        _ => false\\n      }\\n    },\\n    _ => false\\n  }\\n}\\n\\nlet parse_bracket_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  if is_generic_fn_start(tokens, pos) {\\n    parse_generic_fn_primary(tokens, starts, pos, parse_recur)\\n  } else {\\n    parse_array_primary(tokens, starts, pos, parse_recur)\\n  }\\n}\\n\\nlet rec parse_map_literal_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    TIdent(fname) => {\\n      let colon_pos = expect_tk(tokens, pos + 1, \\\":\\\")\\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\\n      ArrayBuilder::push(b, (fname, val))\\n      match peek(tokens, next_pos) {\\n        TComma => parse_map_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\\n        _ => throw(\\\"expected ',' or '}' in map literal\\\")\\n      }\\n    },\\n    TString(skey) => {\\n      let colon_pos = expect_tk(tokens, pos + 1, \\\":\\\")\\n      let (val, next_pos) = parse_recur(tokens, colon_pos, 0)\\n      ArrayBuilder::push(b, (skey, val))\\n      match peek(tokens, next_pos) {\\n        TComma => parse_map_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\\n        _ => throw(\\\"expected ',' or '}' in map literal\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected field name or '}' in map literal\\\")\\n  }\\n}\\n\\nlet parse_paren_tuple_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos + 1) {\\n    TRParen => (EUnit, pos + 2),\\n    _ => {\\n      let (first, next_pos) = parse_recur(tokens, pos + 1, 0)\\n      match peek(tokens, next_pos) {\\n        TRParen => (first, next_pos + 1),\\n        TComma => {\\n          let b = ArrayBuilder::new()\\n          ArrayBuilder::push(b, first)\\n          let (items, end_pos) = parse_comma_exprs_rest(tokens, starts, next_pos, b, parse_recur)\\n          let close_pos = expect_tk(tokens, end_pos, \\\")\\\")\\n          (ETuple(items), close_pos)\\n        },\\n        _ => throw(\\\"expected ')' or ','\\\")\\n      }\\n    }\\n  }\\n}\\n\\nlet parse_paren_lambda_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  let (params, after_params) = parse_param_list(tokens, pos + 1)\\n  match peek(tokens, after_params) {\\n    TThinArrow => {\\n      let after_arrow = after_params + 1\\n      match peek(tokens, after_arrow) {\\n        TIdent(_) => {\\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\\n          match peek(tokens, ty_pos) {\\n            TLBrace => {\\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\\n            },\\n            TWith => {\\n              let with_pos = expect_tk(tokens, ty_pos + 1, \\\"{\\\")\\n              let effect_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n              let effect_name = effect_pair.0\\n              let effect_next = effect_pair.1\\n              let body_pos = expect_tk(tokens, effect_next, \\\"{\\\")\\n              let (body, end) = parse_recur(tokens, body_pos, 20)\\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\\n            },\\n            _ => {\\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n            }\\n          }\\n        },\\n        TLParen => {\\n          let (ty, ty_pos) = parse_type_impl(tokens, after_arrow, 0)\\n          match peek(tokens, ty_pos) {\\n            TLBrace => {\\n              let (body, end) = parse_recur(tokens, ty_pos + 1, 20)\\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), None, body), end)\\n            },\\n            TWith => {\\n              let with_pos = expect_tk(tokens, ty_pos + 1, \\\"{\\\")\\n              let effect_pair = collect_effect_names(tokens, with_pos, \\\"\\\")\\n              let effect_name = effect_pair.0\\n              let effect_next = effect_pair.1\\n              let body_pos = expect_tk(tokens, effect_next, \\\"{\\\")\\n              let (body, end) = parse_recur(tokens, body_pos, 20)\\n              (EFn(_no_tp(), _no_tb(), params, Some(ty), Some(effect_name), body), end)\\n            },\\n            _ => {\\n              let (body, end) = parse_recur(tokens, after_arrow, 0)\\n              (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n            }\\n          }\\n        },\\n        _ => {\\n          let (body, end) = parse_recur(tokens, after_arrow, 0)\\n          (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n        }\\n      }\\n    },\\n    TLBrace => {\\n      let (body, end) = parse_recur(tokens, after_params + 1, 20)\\n      (EFn(_no_tp(), _no_tb(), params, None, None, body), end)\\n    },\\n    _ => throw(\\\"expected '->' or '{' after fn params\\\")\\n  }\\n}\\n\\nlet parse_paren_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  if is_lambda_start(tokens, pos + 1) {\\n    parse_paren_lambda_primary(tokens, starts, pos, parse_recur)\\n  } else {\\n    parse_paren_tuple_primary(tokens, starts, pos, parse_recur)\\n  }\\n}\\n\\nlet rec parse_record_literal_fields: (Array[Token], Array[Int], Int, ArrayBuilder[(String, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[(String, Expr)], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    TIdent(fname) => {\\n      let (val, next_pos) = match peek(tokens, pos + 1) {\\n        TComma => (EIdent(fname, -1), pos + 1),\\n        TRBrace => (EIdent(fname, -1), pos + 1),\\n        _ => {\\n          let colon_pos = expect_tk(tokens, pos + 1, \\\":\\\")\\n          parse_recur(tokens, colon_pos, 0)\\n        }\\n      }\\n      ArrayBuilder::push(b, (fname, val))\\n      match peek(tokens, next_pos) {\\n        TComma => parse_record_literal_fields(tokens, starts, next_pos + 1, b, parse_recur),\\n        TRBrace => (ArrayBuilder::freeze(b), next_pos + 1),\\n        _ => throw(\\\"expected ',' or '}' in record literal\\\")\\n      }\\n    },\\n    _ => throw(\\\"expected field name or '}' in record literal\\\")\\n  }\\n}\\n\\nlet offset_at: (Array[Int], Int) -> Int = (starts, p) -> {\\n  if p >= 0 && p < Array::length(starts) {\\n    Array::get(starts, p)\\n  } else {\\n    -1\\n  }\\n}\\n\\nlet parse_ident_primary: (Array[Token], Array[Int], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, name, parse_recur) -> {\\n  if name == \\\"true\\\" {\\n    (EBool(true), pos + 1)\\n  } else if name == \\\"false\\\" {\\n    (EBool(false), pos + 1)\\n  } else if name == \\\"perform\\\" {\\n    parse_perform_primary(tokens, starts, pos, parse_recur)\\n  } else if name == \\\"record\\\" {\\n    match peek(tokens, pos + 1) {\\n      TLBrace => {\\n        let b = ArrayBuilder::new()\\n        let (fields, end_pos) = parse_record_literal_fields(tokens, starts, pos + 2, b, parse_recur)\\n        (ERecord(fields), end_pos)\\n      },\\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n    }\\n  } else if name == \\\"map\\\" {\\n    match peek(tokens, pos + 1) {\\n      TLBrace => {\\n        let b = ArrayBuilder::new()\\n        let (fields, end_pos) = parse_map_literal_fields(tokens, starts, pos + 2, b, parse_recur)\\n        (EMap(fields), end_pos)\\n      },\\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n    }\\n  } else {\\n    match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) => (EIdent(String::concat(name, String::concat(\\\"::\\\", member)), offset_at(starts, pos)), pos + 3),\\n        TLBrace => {\\n          let b = ArrayBuilder::new()\\n          let (fields, end_pos) = parse_ctor_record_fields(tokens, starts, pos + 3, b, parse_recur)\\n          (ERecord(fields), end_pos)\\n        },\\n        _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n      },\\n      _ => (EIdent(name, offset_at(starts, pos)), pos + 1)\\n    }\\n  }\\n}\\n\\nexport let parse_primary: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TInt(n) => (EInt(n), pos + 1),\\n    TFloat(n) => (EFloat(n), pos + 1),\\n    TString(s) => (EString(s), pos + 1),\\n    TStringInterp(parts) => (build_interp_expr(parts, parse_recur), pos + 1),\\n    TIdent(name) => parse_ident_primary(tokens, starts, pos, name, parse_recur),\\n    TLParen => parse_paren_primary(tokens, starts, pos, parse_recur),\\n    TLBracket => parse_bracket_primary(tokens, starts, pos, parse_recur),\\n    _ => parse_control_primary(tokens, starts, pos, parse_recur)\\n  }\\n}\\n\\n\\n\\n\\n\\n\\nlet binop_op: (Token) -> String with { Error } = (tok) -> {\\n  match tok {\\n    TOr => \\\"||\\\",\\n    TAnd => \\\"&&\\\",\\n    TPipeGt => \\\"|>\\\",\\n    TEqEq => \\\"==\\\",\\n    TNeq => \\\"!=\\\",\\n    TLt => \\\"<\\\",\\n    TLte => \\\"<=\\\",\\n    TGt => \\\">\\\",\\n    TGte => \\\">=\\\",\\n    TBitOr => \\\"|\\\",\\n    TBitXor => \\\"^\\\",\\n    TBitAnd => \\\"&\\\",\\n    TLShift => \\\"<<\\\",\\n    TRShift => \\\">>\\\",\\n    TPlus => \\\"+\\\",\\n    TMinus => \\\"-\\\",\\n    TStar => \\\"*\\\",\\n    TSlash => \\\"/\\\",\\n    TPercent => \\\"%\\\",\\n    _ => throw(\\\"internal parser error: not a binary operator\\\")\\n  }\\n}\\n\\nlet binop_prec: (Token) -> Int = (tok) -> {\\n  match tok {\\n    TOr => 0,\\n    TAnd => 1,\\n    TPipeGt => 2,\\n    TEqEq => 3,\\n    TNeq => 3,\\n    TLt => 3,\\n    TLte => 3,\\n    TGt => 3,\\n    TGte => 3,\\n    TBitOr => 4,\\n    TBitXor => 5,\\n    TBitAnd => 6,\\n    TLShift => 7,\\n    TRShift => 7,\\n    TPlus => 8,\\n    TMinus => 8,\\n    TStar => 9,\\n    TSlash => 9,\\n    TPercent => 9,\\n    _ => -1\\n  }\\n}\\n\\nlet callee_offset: (Expr) -> Int = (callee) -> {\\n  match callee {\\n    EIdent(_, off) => off,\\n    EDot(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\\n    ECall(inner, _, off) => if off >= 0 { off } else { callee_offset(inner) },\\n    _ => -1\\n  }\\n}\\n\\nlet index_expr: (Expr, Expr) -> Expr = (cur_expr, idx) -> {\\n  let args = empty_exprs()\\n  Array::push(args, cur_expr)\\n  Array::push(args, idx)\\n  ECall(EIdent(\\\"__index\\\", -1), args, -1)\\n}\\n\\nlet pipe_arg_is_hole: (Expr) -> Bool = (arg) -> {\\n  match arg {\\n    EIdent(n, _) => n == \\\"_\\\",\\n    _ => false\\n  }\\n}\\n\\nlet pipe_desugar: (Expr, Expr) -> Expr = (lhs, rhs) -> {\\n  match rhs {\\n    ECall(callee, args, off) => {\\n      let mut has_hole = false\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        if pipe_arg_is_hole(Array::get(args, i)) {\\n          has_hole = true\\n          i = Array::length(args)\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      if has_hole {\\n        let out = empty_exprs()\\n        let mut j = 0\\n        while j < Array::length(args) {\\n          let a = Array::get(args, j)\\n          if pipe_arg_is_hole(a) {\\n            Array::push(out, lhs)\\n          } else {\\n            Array::push(out, a)\\n          }\\n          j = j + 1\\n        }\\n        ECall(callee, out, off)\\n      } else {\\n        ECall(callee, Array::concat([\\n          lhs\\n        ], args), off)\\n      }\\n    },\\n    _ => ECall(rhs, [\\n      lhs\\n    ], callee_offset(rhs))\\n  }\\n}\\n\\nlet parse_call_arg: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TThinArrow => {\\n        let (body, end) = parse_recur(tokens, pos + 2, 0)\\n        (EFn(_no_tp(), _no_tb(), [\\n          (name, None)\\n        ], None, None, body), end)\\n      },\\n      TTilde => match peek(tokens, pos + 2) {\\n        TEq => {\\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\\n          (ELabeledArg(name, \\\"~\\\", val), end)\\n        },\\n        _ => parse_recur(tokens, pos, 0)\\n      },\\n      TQuestion => match peek(tokens, pos + 2) {\\n        TEq => {\\n          let (val, end) = parse_recur(tokens, pos + 3, 0)\\n          (ELabeledArg(name, \\\"?\\\", val), end)\\n        },\\n        _ => parse_recur(tokens, pos, 0)\\n      },\\n      TEq => {\\n        let (val, end) = parse_recur(tokens, pos + 2, 0)\\n        (ELabeledArg(name, \\\"~\\\", val), end)\\n      },\\n      _ => parse_recur(tokens, pos, 0)\\n    },\\n    _ => parse_recur(tokens, pos, 0)\\n  }\\n}\\n\\nlet has_placeholder_arg: (Expr) -> Bool = (arg) -> {\\n  match arg {\\n    EIdent(n, _) => n == \\\"_\\\",\\n    EBinOp(_, l, r) => {\\n      let left_has = match l {\\n        EIdent(n, _) => n == \\\"_\\\",\\n        _ => false\\n      }\\n      let right_has = match r {\\n        EIdent(n, _) => n == \\\"_\\\",\\n        _ => false\\n      }\\n      left_has || right_has\\n    },\\n    _ => false\\n  }\\n}\\n\\nlet slice_from_idx_expr: (Expr, Expr, Expr) -> Expr = (cur_expr, idx, end_expr) -> {\\n  let args = empty_exprs()\\n  Array::push(args, cur_expr)\\n  Array::push(args, idx)\\n  Array::push(args, end_expr)\\n  ECall(EIdent(\\\"__slice\\\", -1), args, -1)\\n}\\n\\nlet has_placeholder_args: (Array[Expr]) -> Bool = (args) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(args) {\\n    if has_placeholder_arg(Array::get(args, i)) {\\n      found = true\\n      i = Array::length(args)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet parse_call_args_rest: (Array[Token], Array[Int], Int, ArrayBuilder[Expr], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Array[Expr], Int) with { Error } = (tokens, starts, pos, b, parse_recur) -> {\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TComma => match peek(tokens, p + 1) {\\n        TRParen => {\\n          p = p + 1\\n          done = true\\n        },\\n        _ => {\\n          let (e, next) = parse_call_arg(tokens, starts, p + 1, parse_recur)\\n          ArrayBuilder::push(b, e)\\n          p = next\\n        }\\n      }\\n      ,\\n      _ => {\\n        done = true\\n      }\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nlet slice_from_zero_expr: (Expr, Expr) -> Expr = (cur_expr, end_expr) -> {\\n  let args = empty_exprs()\\n  Array::push(args, cur_expr)\\n  Array::push(args, EInt(0))\\n  Array::push(args, end_expr)\\n  ECall(EIdent(\\\"__slice\\\", -1), args, -1)\\n}\\n\\nlet wrap_placeholder_arg: (Expr) -> Expr = (arg) -> {\\n  let mut pc = 0\\n  let params = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let replaced = match arg {\\n    EIdent(n, _) => if n == \\\"_\\\" {\\n      let pn = \\\"__ph0\\\"\\n      Array::push(params, (pn, None))\\n      EIdent(pn, -1)\\n    } else {\\n      arg\\n    }\\n    ,\\n    EBinOp(op, l, r) => {\\n      let nl = match l {\\n        EIdent(n, _) => if n == \\\"_\\\" {\\n          let pn = String::concat(\\\"__ph\\\", __to_string(pc))\\n          Array::push(params, (pn, None))\\n          pc = pc + 1\\n          EIdent(pn, -1)\\n        } else {\\n          l\\n        }\\n        ,\\n        _ => l\\n      }\\n      let nr = match r {\\n        EIdent(n, _) => if n == \\\"_\\\" {\\n          let pn = String::concat(\\\"__ph\\\", __to_string(pc))\\n          Array::push(params, (pn, None))\\n          pc = pc + 1\\n          EIdent(pn, -1)\\n        } else {\\n          r\\n        }\\n        ,\\n        _ => r\\n      }\\n      EBinOp(op, nl, nr)\\n    },\\n    _ => arg\\n  }\\n  EFn(_no_tp(), _no_tb(), params, None, None, replaced)\\n}\\n\\nlet has_non_pipe_infix_top: (Array[Token], Int, Int) -> Bool = (tokens, start, end) -> {\\n  let rec go: (Int, Int, Bool) -> Bool = (i, depth, prev_top_end) -> {\\n    if i >= end {\\n      false\\n    } else {\\n      let tok = peek(tokens, i)\\n      if depth == 0 {\\n        if is_non_pipe_infix(tok) {\\n          if prev_top_end {\\n            true\\n          } else {\\n            go(i + 1, 0, false)\\n          }\\n        } else {\\n          match tok {\\n            TLParen => go(i + 1, 1, false),\\n            TLBracket => go(i + 1, 1, false),\\n            TLBrace => go(i + 1, 1, false),\\n            _ => go(i + 1, 0, is_expr_end_token(tok))\\n          }\\n        }\\n      } else {\\n        match tok {\\n          TLParen => go(i + 1, depth + 1, prev_top_end),\\n          TLBracket => go(i + 1, depth + 1, prev_top_end),\\n          TLBrace => go(i + 1, depth + 1, prev_top_end),\\n          TRParen => if depth == 1 {\\n            go(i + 1, 0, true)\\n          } else {\\n            go(i + 1, depth - 1, prev_top_end)\\n          },\\n          TRBracket => if depth == 1 {\\n            go(i + 1, 0, true)\\n          } else {\\n            go(i + 1, depth - 1, prev_top_end)\\n          },\\n          TRBrace => if depth == 1 {\\n            go(i + 1, 0, true)\\n          } else {\\n            go(i + 1, depth - 1, prev_top_end)\\n          },\\n          _ => go(i + 1, depth, prev_top_end)\\n        }\\n      }\\n    }\\n  }\\n  go(start, 0, false)\\n}\\n\\nlet desugar_placeholder_args: (Array[Expr]) -> Array[Expr] = (args) -> {\\n  let out = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(args) {\\n    let arg = Array::get(args, i)\\n    if pipe_arg_is_hole(arg) {\\n      Array::push(out, arg)\\n    } else if has_placeholder_arg(arg) {\\n      Array::push(out, wrap_placeholder_arg(arg))\\n    } else {\\n      Array::push(out, arg)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet rec parse_postfix: (Array[Token], Array[Int], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, expr, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TLParen => match expr {\\n      ECall(_, _, _) => (expr, pos),\\n      EArray(_) => (expr, pos),\\n      ETuple(_) => (expr, pos),\\n      ERecord(_) => (expr, pos),\\n      EMap(_) => (expr, pos),\\n      EInt(_) => (expr, pos),\\n      EFloat(_) => (expr, pos),\\n      EString(_) => (expr, pos),\\n      EStringInterp(_) => (expr, pos),\\n      EBool(_) => (expr, pos),\\n      EUnit => (expr, pos),\\n      EWhile(_, _) => (expr, pos),\\n      EIf(_, _, _) => (expr, pos),\\n      EMatch(_, _) => (expr, pos),\\n      ELoop(_, _) => (expr, pos),\\n      EForIn(_, _, _, _) => (expr, pos),\\n      EHandle(_, _) => (expr, pos),\\n      _ => match peek(tokens, pos + 1) {\\n        TRParen => parse_postfix(tokens, starts, pos + 2, ECall(expr, empty_exprs(), callee_offset(expr)), parse_recur),\\n        _ => {\\n          let b = ArrayBuilder::new()\\n          let (first_arg, next_pos) = parse_call_arg(tokens, starts, pos + 1, parse_recur)\\n          ArrayBuilder::push(b, first_arg)\\n          let (args, end_pos) = parse_call_args_rest(tokens, starts, next_pos, b, parse_recur)\\n          let close_pos = expect_tk(tokens, end_pos, \\\")\\\")\\n          let call_args = if has_placeholder_args(args) {\\n            desugar_placeholder_args(args)\\n          } else {\\n            args\\n          }\\n          parse_postfix(tokens, starts, close_pos, ECall(expr, call_args, callee_offset(expr)), parse_recur)\\n        }\\n      },\\n    },\\n    TLBracket => match peek(tokens, pos + 1) {\\n      TColon => match peek(tokens, pos + 2) {\\n        TRBracket => {\\n          let end_expr = ECall(EIdent(\\\"__len\\\", -1), [\\n            expr\\n          ], -1)\\n          parse_postfix(tokens, starts, pos + 3, slice_from_zero_expr(expr, end_expr), parse_recur)\\n        },\\n        _ => {\\n          let (end_expr, end_next) = parse_recur(tokens, pos + 2, 0)\\n          let close_pos = match peek(tokens, end_next) {\\n            TRBracket => end_next + 1,\\n            _ => throw(\\\"expected ']'\\\")\\n          }\\n          parse_postfix(tokens, starts, close_pos, slice_from_zero_expr(expr, end_expr), parse_recur)\\n        }\\n      },\\n      _ => {\\n        let (idx, idx_next) = parse_recur(tokens, pos + 1, 0)\\n        match peek(tokens, idx_next) {\\n          TColon => match peek(tokens, idx_next + 1) {\\n            TRBracket => {\\n              let end_expr = ECall(EIdent(\\\"__len\\\", -1), [\\n                expr\\n              ], -1)\\n              parse_postfix(tokens, starts, idx_next + 2, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\\n            },\\n            _ => {\\n              let (end_expr, end_next) = parse_recur(tokens, idx_next + 1, 0)\\n              let close_pos = match peek(tokens, end_next) {\\n                TRBracket => end_next + 1,\\n                _ => throw(\\\"expected ']'\\\")\\n              }\\n              parse_postfix(tokens, starts, close_pos, slice_from_idx_expr(expr, idx, end_expr), parse_recur)\\n            }\\n          },\\n          _ => {\\n            let close_pos = match peek(tokens, idx_next) {\\n              TRBracket => idx_next + 1,\\n              _ => throw(\\\"expected ']'\\\")\\n            }\\n            parse_postfix(tokens, starts, close_pos, index_expr(expr, idx), parse_recur)\\n          }\\n        }\\n      }\\n    },\\n    TDot => match peek(tokens, pos + 1) {\\n      TIdent(field) => parse_postfix(tokens, starts, pos + 2, EDot(expr, field, callee_offset(expr)), parse_recur),\\n      TInt(idx) => parse_postfix(tokens, starts, pos + 2, EDot(expr, __to_string(idx), callee_offset(expr)), parse_recur),\\n      _ => (expr, pos)\\n    },\\n    TQuestion => parse_postfix(tokens, starts, pos + 1, ECall(EIdent(\\\"__try_op\\\", -1), [\\n      expr\\n    ], -1), parse_recur),\\n    _ => (expr, pos)\\n  }\\n}\\n\\nlet rec parse_prefix: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TMinus => {\\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\\n      (EUnaryOp(\\\"-\\\", e), next)\\n    },\\n    TNot => {\\n      let (e, next) = parse_prefix(tokens, starts, pos + 1, parse_recur)\\n      (EUnaryOp(\\\"!\\\", e), next)\\n    },\\n    _ => {\\n      let (e, next) = parse_primary(tokens, starts, pos, parse_recur)\\n      parse_postfix(tokens, starts, next, e, parse_recur)\\n    }\\n  }\\n}\\n\\nlet rec parse_infix_loop: (Array[Token], Array[Int], Expr, Int, Int, Int, Bool, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, left, next, min_prec, expr_start, cmp_locked, parse_recur) -> {\\n  let tok = peek(tokens, next)\\n  let prec = binop_prec(tok)\\n  let should_stop = if prec < min_prec {\\n    true\\n  } else if cmp_locked {\\n    prec == 3\\n  } else {\\n    false\\n  }\\n  if should_stop {\\n    (left, next)\\n  } else {\\n    let is_pipe = match tok {\\n      TPipeGt => true,\\n      _ => false\\n    }\\n    let op = binop_op(tok)\\n    if is_pipe {\\n      if has_non_pipe_infix_top(tokens, expr_start, next) {\\n        throw(\\\"cannot mix '|>' with other infix operators without explicit parentheses\\\")\\n      }\\n    }\\n    let (right0, right_next0) = parse_prefix(tokens, starts, next + 1, parse_recur)\\n    let (right, rn) = parse_infix_loop(tokens, starts, right0, right_next0, prec + 1, next + 1, false, parse_recur)\\n    if is_pipe {\\n      if has_non_pipe_infix_top(tokens, next + 1, rn) {\\n        throw(\\\"cannot mix '|>' with other infix operators without explicit parentheses\\\")\\n      }\\n    }\\n    let combined = if is_pipe {\\n      pipe_desugar(left, right)\\n    } else {\\n      EBinOp(op, left, right)\\n    }\\n    let next_cmp_locked = if prec == 3 {\\n      true\\n    } else {\\n      cmp_locked\\n    }\\n    parse_infix_loop(tokens, starts, combined, rn, min_prec, expr_start, next_cmp_locked, parse_recur)\\n  }\\n}\\n\\nexport let parse_infix_no_is: (Array[Token], Array[Int], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, min_prec, expr_start, parse_recur) -> {\\n  let (left0, next0) = parse_prefix(tokens, starts, pos, parse_recur)\\n  parse_infix_loop(tokens, starts, left0, next0, min_prec, expr_start, false, parse_recur)\\n}\\n\\nexport let parse_infix: (Array[Token], Array[Int], Int, Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, min_prec, expr_start, parse_recur) -> {\\n  let (expr, en) = parse_infix_no_is(tokens, starts, pos, min_prec, expr_start, parse_recur)\\n  match peek(tokens, en) {\\n    TIs => {\\n      let (pat, pn) = parse_pattern(tokens, en + 1)\\n      (EMatch(expr, [\\n        (pat, EBool(true)),\\n        (PWild, EBool(false))\\n      ]), pn)\\n    },\\n    TIdent(kw) => if kw == \\\"is\\\" {\\n      let (pat, pn) = parse_pattern(tokens, en + 1)\\n      (EMatch(expr, [\\n        (pat, EBool(true)),\\n        (PWild, EBool(false))\\n      ]), pn)\\n    } else {\\n      (expr, en)\\n    },\\n    _ => (expr, en)\\n  }\\n}\\n\\n\\n\\n\\n\\n\\nlet ascribe_wrap: (Expr, TypeExpr) -> Expr = (val, ty) -> {\\n  let tparams = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let tbounds = Array::slice([\\n    (\\\"\\\", Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let params = [\\n    (\\\"__asc\\\", Some(ty))\\n  ]\\n  let lam = EFn(tparams, tbounds, params, None, None, EIdent(\\\"__asc\\\", 0 - 1))\\n  ECall(lam, [\\n    val\\n  ], 0 - 1)\\n}\\n\\nlet distribute_local_fn_ann: (TypeExpr, Expr) -> Option[Expr] = (ann_ty, val) -> {\\n  match ann_ty {\\n    TyFn(param_types, ret_ty, effect_name) => match val {\\n      EFn(tp, tb, params, ret_opt, effect_opt, body) => {\\n        if Array::length(params) != Array::length(param_types) {\\n          None\\n        } else {\\n          let out = ArrayBuilder::new()\\n          let mut i = 0\\n          while i < Array::length(params) {\\n            let (pname, pann) = Array::get(params, i)\\n            let next_ann = match pann {\\n              Some(_) => pann,\\n              None => Some(Array::get(param_types, i))\\n            }\\n            ArrayBuilder::push(out, (pname, next_ann))\\n            i = i + 1\\n          }\\n          let next_ret = match ret_opt {\\n            Some(_) => ret_opt,\\n            None => Some(ret_ty)\\n          }\\n          let next_eff = match effect_opt {\\n            Some(_) => effect_opt,\\n            None => effect_name\\n          }\\n          Some(EFn(tp, tb, ArrayBuilder::freeze(out), next_ret, next_eff, body))\\n        }\\n      },\\n      _ => None\\n    },\\n    _ => None\\n  }\\n}\\n\\nenum BlockStep {\\n  StepSeq(Expr);\\n  StepValue(Expr);\\n  StepLet(String, Expr);\\n  StepLetMut(String, Expr);\\n  StepLetRec(String, Expr);\\n  StepAssign(String, Expr);\\n  StepAssignOp(String, String, Expr);\\n  StepPattern(Pat, Expr);\\n  StepStructDestr(Pat, Expr);\\n  StepRecordDestr(Pat, Expr);\\n  StepBind(String, Expr)\\n}\\n\\nlet rec desugar_guarded: (Array[(Pat, Expr, Expr)], Int, Expr) -> Array[(Pat, Expr)] = (arms, i, scrut) -> {\\n  if i >= Array::length(arms) {\\n    empty_arms()\\n  } else {\\n    let (pat, guard, body) = Array::get(arms, i)\\n    let rest = desugar_guarded(arms, i + 1, scrut)\\n    let no_guard = match guard {\\n      EBool(bv) => bv,\\n      _ => false\\n    }\\n    let arm_body = if no_guard {\\n      body\\n    } else {\\n      EIf(guard, body, EMatch(scrut, rest))\\n    }\\n    let out = ArrayBuilder::new()\\n    ArrayBuilder::push(out, (pat, arm_body))\\n    let mut j = 0\\n    while j < Array::length(rest) {\\n      ArrayBuilder::push(out, Array::get(rest, j))\\n      j = j + 1\\n    }\\n    ArrayBuilder::freeze(out)\\n  }\\n}\\n\\nlet rec collect_match_arms: (Array[Token], Array[Int], Int, ArrayBuilder[(Pat, Expr, Expr)], Array[Bool], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> Int with { Error } = (tokens, starts, pos, b, hg, parse_recur) -> {\\n  let (pat, pa) = parse_pattern(tokens, pos)\\n  let (guard, after_g) = match peek(tokens, pa) {\\n    TIf => {\\n      Array::set(hg, 0, true)\\n      parse_recur(tokens, pa + 1, 0)\\n    },\\n    _ => (EBool(true), pa)\\n  }\\n  let arrow = expect_tk(tokens, after_g, \\\"=>\\\")\\n  let (body, bn) = parse_recur(tokens, arrow, 0)\\n  ArrayBuilder::push(b, (pat, guard, body))\\n  match peek(tokens, bn) {\\n    TComma => match peek(tokens, bn + 1) {\\n      TRBrace => bn + 2,\\n      _ => collect_match_arms(tokens, starts, bn + 1, b, hg, parse_recur)\\n    },\\n    TRBrace => bn + 1,\\n    _ => collect_match_arms(tokens, starts, bn, b, hg, parse_recur)\\n  }\\n}\\n\\nlet rec qualify_handle_arm_pattern: (String, Pat) -> Pat = (effect_name, pat) -> {\\n  match pat {\\n    PCtor(name, args) => if String::contains(name, \\\"::\\\") {\\n      PCtor(name, args)\\n    } else {\\n      PCtor(String::concat(effect_name, String::concat(\\\"::\\\", name)), args)\\n    },\\n    POr(left, right) => POr(qualify_handle_arm_pattern(effect_name, left), qualify_handle_arm_pattern(effect_name, right)),\\n    _ => pat\\n  }\\n}\\n\\nlet parse_handle_arm: (Array[Token], Array[Int], Int, String, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> ((Pat, Expr), Int) with { Error } = (tokens, starts, pos, effect_name, parse_recur) -> {\\n  let (pat, pat_next) = parse_pattern(tokens, pos)\\n  let qualified_pat = qualify_handle_arm_pattern(effect_name, pat)\\n  let arrow_pos = expect_tk(tokens, pat_next, \\\"=>\\\")\\n  let (expr, next) = parse_recur(tokens, arrow_pos, 0)\\n  ((qualified_pat, expr), next)\\n}\\n\\nlet rec parse_handle_rest: (Array[Token], Array[Int], Int, Expr, String, ArrayBuilder[(Pat, Expr)], (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, body, effect_name, b, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 2),\\n      _ => {\\n        let (arm, next) = parse_handle_arm(tokens, starts, pos + 1, effect_name, parse_recur)\\n        ArrayBuilder::push(b, arm)\\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\\n      }\\n    },\\n    TRBrace => (EHandle(body, ArrayBuilder::freeze(b)), pos + 1),\\n    _ => throw(\\\"expected ';' or '}' in handle arm list\\\")\\n  }\\n}\\n\\nlet parse_block_after_expr: (Array[Token], Int, Expr, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, pos, e, parse_recur) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (e, pos + 1),\\n    TSemicolon => {\\n      let (rest, end) = parse_recur(tokens, pos + 1, 20)\\n      (ESeq(e, rest), end)\\n    },\\n    TEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssign(name, val, rest), end)\\n      },\\n      EDot(obj, field, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        let set_args = empty_exprs()\\n        Array::push(set_args, obj)\\n        Array::push(set_args, EString(field))\\n        Array::push(set_args, val)\\n        (ESeq(ECall(EIdent(\\\"__set_field\\\", -1), set_args, -1), rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TPlusEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"+\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TMinusEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"-\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TStarEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"*\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TSlashEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"/\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    TPercentEq => match e {\\n      EIdent(name, _) => {\\n        let val_pair = parse_recur(tokens, pos + 1, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        let a = skip_semi(tokens, val_next)\\n        let (rest, end) = parse_recur(tokens, a, 20)\\n        (EAssignOp(name, \\\"%\\\", val, rest), end)\\n      },\\n      _ => throw(\\\"invalid assignment target\\\")\\n    },\\n    _ => {\\n      let (rest, end) = parse_recur(tokens, pos, 20)\\n      if end <= pos {\\n        throw(\\\"internal parser error: block continuation did not advance\\\")\\n      } else {\\n        (ESeq(e, rest), end)\\n      }\\n    }\\n  }\\n}\\n\\nlet parse_block_value_body: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Expr, Int, Int) with { Error } = (tokens, eq, parse_recur) -> {\\n  let val_pair = parse_recur(tokens, eq, 0)\\n  let val = val_pair.0\\n  let val_next = val_pair.1\\n  let a = skip_semi(tokens, val_next)\\n  let (body, end) = parse_recur(tokens, a, 20)\\n  (val, body, end, a)\\n}\\n\\nlet parse_block_value_only: (Array[Token], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, value_pos, parse_recur) -> {\\n  let val_pair = parse_recur(tokens, value_pos, 0)\\n  (val_pair.0, skip_semi(tokens, val_pair.1))\\n}\\n\\nlet apply_struct_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\\n  let val_name = \\\"__struct_destr\\\"\\n  let mut desugar = rest\\n  match pat {\\n    PStruct(_, fields) => {\\n      let mut di = Array::length(fields) - 1\\n      while di >= 0 {\\n        let (fname, fpat) = Array::get(fields, di)\\n        match fpat {\\n          PBind(bname) => {\\n            desugar = ELet(bname, EDot(EIdent(val_name, -1), fname, -1), desugar)\\n          },\\n          _ => ()\\n        }\\n        di = di - 1\\n      }\\n    },\\n    _ => ()\\n  }\\n  ELet(val_name, val, desugar)\\n}\\n\\nlet apply_record_destr: (Pat, Expr, Expr) -> Expr = (pat, val, rest) -> {\\n  let val_name = \\\"__rec_destr\\\"\\n  let mut desugar = rest\\n  match pat {\\n    PTuple(field_pats) => {\\n      let mut di = Array::length(field_pats) - 1\\n      while di >= 0 {\\n        let fp = Array::get(field_pats, di)\\n        match fp {\\n          PBind(bname) => {\\n            desugar = ELet(bname, ECall(EIdent(\\\"__rec_field\\\", -1), [\\n              EIdent(val_name, -1),\\n              EInt(di)\\n            ], -1), desugar)\\n          },\\n          PTuple(sub_pats) => {\\n            let sub_name = String::concat(\\\"__rec_sub_\\\", __to_string(di))\\n            let mut si = Array::length(sub_pats) - 1\\n            while si >= 0 {\\n              match Array::get(sub_pats, si) {\\n                PBind(sname) => {\\n                  desugar = ELet(sname, EDot(EIdent(sub_name, -1), __to_string(si), -1), desugar)\\n                },\\n                _ => ()\\n              }\\n              si = si - 1\\n            }\\n            desugar = ELet(sub_name, ECall(EIdent(\\\"__rec_field\\\", -1), [\\n              EIdent(val_name, -1),\\n              EInt(di)\\n            ], -1), desugar)\\n          },\\n          _ => ()\\n        }\\n        di = di - 1\\n      }\\n    },\\n    _ => ()\\n  }\\n  ELet(val_name, val, desugar)\\n}\\n\\nlet apply_block_step: (BlockStep, Expr) -> Expr = (step, rest) -> {\\n  match step {\\n    StepSeq(expr) => ESeq(expr, rest),\\n    StepValue(expr) => expr,\\n    StepLet(name, val) => ELet(name, val, rest),\\n    StepLetMut(name, val) => ELetMut(name, val, rest),\\n    StepLetRec(name, val) => ELetRec(name, val, rest),\\n    StepAssign(name, val) => EAssign(name, val, rest),\\n    StepAssignOp(name, op, val) => EAssignOp(name, op, val, rest),\\n    StepPattern(pat, val) => EMatch(val, [\\n      (pat, rest)\\n    ]),\\n    StepStructDestr(pat, val) => apply_struct_destr(pat, val, rest),\\n    StepRecordDestr(pat, val) => apply_record_destr(pat, val, rest),\\n    StepBind(name, val) => ECall(EIdent(\\\"__try_bind\\\", -1), [\\n      val,\\n      EFn(Array::slice([\\n        \\\"\\\"\\n      ], 0, 0), Array::slice([\\n        (\\\"\\\", Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n      ], 0, 0), [\\n        (name, None)\\n      ], None, None, rest)\\n    ], -1)\\n  }\\n}\\n\\nlet fold_block_steps: (Array[BlockStep]) -> Expr = (steps) -> {\\n  let mut result = EUnit\\n  let mut i = Array::length(steps) - 1\\n  while i >= 0 {\\n    result = apply_block_step(Array::get(steps, i), result)\\n    i = i - 1\\n  }\\n  result\\n}\\n\\nlet parse_impl_block: (Array[Token], Array[Int], Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, parse_recur) -> {\\n  let steps = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut end_pos = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TRBrace => {\\n        end_pos = p + 1\\n        done = true\\n      },\\n      TEof => throw(\\\"unexpected eof in block\\\"),\\n      TEnum => {\\n        let (enum_stmt, enum_end) = parse_enum_stmt(tokens, p + 1, false)\\n        match enum_stmt {\\n          SEnum(_, _, _, variants, _) => {\\n            let mut vi = 0\\n            while vi < Array::length(variants) {\\n              let (vname, vfields) = Array::get(variants, vi)\\n              if Array::length(vfields) == 0 {\\n                ArrayBuilder::push(steps, StepLet(vname, EInt(vi)))\\n              }\\n              vi = vi + 1\\n            }\\n          },\\n          _ => ()\\n        }\\n        p = enum_end\\n      },\\n      TStruct => {\\n        let (_, struct_end) = parse_struct_stmt(tokens, p + 1, false)\\n        p = struct_end\\n      },\\n      TLet => {\\n        let next = p + 1\\n        match peek(tokens, next) {\\n          TRec => match peek(tokens, next + 1) {\\n            TIdent(name) => {\\n              let (rec_ann, eq_pos_r) = match peek(tokens, next + 2) {\\n                TColon => {\\n                  let (rty, tp) = parse_type_impl(tokens, next + 3, 0)\\n                  (Some(rty), tp)\\n                },\\n                _ => (None, next + 2)\\n              }\\n              let eq = expect_tk(tokens, eq_pos_r, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              if next_pos <= eq {\\n                throw(\\\"internal parser error: block let-rec parser did not advance\\\")\\n              } else {\\n                let val2 = match rec_ann {\\n                  Some(the_type) => match distribute_local_fn_ann(the_type, val) {\\n                    Some(distributed) => distributed,\\n                    None => val\\n                  },\\n                  None => val\\n                }\\n                ArrayBuilder::push(steps, StepLetRec(name, val2))\\n                p = next_pos\\n              }\\n            },\\n            _ => throw(\\\"expected identifier after 'let rec'\\\")\\n          },\\n          TMut => match peek(tokens, next + 1) {\\n            TIdent(name) => {\\n              let eq_pos_m = match peek(tokens, next + 2) {\\n                TColon => {\\n                  let (_, tp) = parse_type_impl(tokens, next + 3, 0)\\n                  tp\\n                },\\n                _ => next + 2\\n              }\\n              let eq = expect_tk(tokens, eq_pos_m, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              if next_pos <= eq {\\n                throw(\\\"internal parser error: block let-mut parser did not advance\\\")\\n              } else {\\n                ArrayBuilder::push(steps, StepLetMut(name, val))\\n                p = next_pos\\n              }\\n            },\\n            _ => throw(\\\"expected identifier after 'let mut'\\\")\\n          },\\n          TStar => match peek(tokens, next + 1) {\\n            TIdent(name) => {\\n              let eq = expect_tk(tokens, next + 2, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              if next_pos <= eq {\\n                throw(\\\"internal parser error: block let* parser did not advance\\\")\\n              } else {\\n                ArrayBuilder::push(steps, StepBind(name, val))\\n                p = next_pos\\n              }\\n            },\\n            _ => throw(\\\"expected identifier after 'let*'\\\")\\n          },\\n          TIdent(name) => {\\n            let after_name = peek(tokens, next + 1)\\n            let next_is_struct_destr = match after_name {\\n              TDoubleColon => {\\n                let fc = String::char_code_at(name, 0)\\n                if fc >= 65 && fc <= 90 {\\n                  match peek(tokens, next + 2) {\\n                    TLBrace => true,\\n                    _ => false\\n                  }\\n                } else {\\n                  false\\n                }\\n              },\\n              _ => false\\n            }\\n            let next_is_record_destr = match after_name {\\n              TLBrace => name == \\\"record\\\",\\n              _ => false\\n            }\\n            if next_is_struct_destr {\\n              let (pat, pn) = parse_pattern(tokens, next)\\n              let eq = expect_tk(tokens, pn, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              ArrayBuilder::push(steps, StepStructDestr(pat, val))\\n              p = next_pos\\n            } else if next_is_record_destr {\\n              let (pat, pn) = parse_pattern(tokens, next)\\n              let eq = expect_tk(tokens, pn, \\\"=\\\")\\n              let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n              ArrayBuilder::push(steps, StepRecordDestr(pat, val))\\n              p = next_pos\\n            } else {\\n              match after_name {\\n                TLParen => {\\n                  let (pat, pn) = parse_pattern(tokens, next)\\n                  let eq = expect_tk(tokens, pn, \\\"=\\\")\\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n                  if next_pos <= eq {\\n                    throw(\\\"internal parser error: block let-ctor-pat parser did not advance\\\")\\n                  } else {\\n                    ArrayBuilder::push(steps, StepPattern(pat, val))\\n                    p = next_pos\\n                  }\\n                },\\n                _ => {\\n                  let (ann_type, eq_pos) = match after_name {\\n                    TColon => {\\n                      let (the_type, tp) = parse_type_impl(tokens, next + 2, 0)\\n                      (Some(the_type), tp)\\n                    },\\n                    _ => (None, next + 1)\\n                  }\\n                  let eq = expect_tk(tokens, eq_pos, \\\"=\\\")\\n                  let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n                  if next_pos <= eq {\\n                    throw(\\\"internal parser error: block let parser did not advance\\\")\\n                  } else {\\n                    let val2 = match ann_type {\\n                      Some(the_type) => match distribute_local_fn_ann(the_type, val) {\\n                        Some(distributed) => distributed,\\n                        None => ascribe_wrap(val, the_type)\\n                      },\\n                      None => val\\n                    }\\n                    ArrayBuilder::push(steps, StepLet(name, val2))\\n                    p = next_pos\\n                  }\\n                }\\n              }\\n            }\\n          },\\n          TLParen => {\\n            let (pat, pn) = parse_pattern(tokens, next)\\n            let eq = expect_tk(tokens, pn, \\\"=\\\")\\n            let (val, next_pos) = parse_block_value_only(tokens, eq, parse_recur)\\n            if next_pos <= eq {\\n              throw(\\\"internal parser error: block let-pat parser did not advance\\\")\\n            } else {\\n              ArrayBuilder::push(steps, StepPattern(pat, val))\\n              p = next_pos\\n            }\\n          },\\n          _ => throw(\\\"expected identifier after 'let'\\\")\\n        }\\n      },\\n      _ => {\\n        let (e, next) = parse_recur(tokens, p, 0)\\n        if next <= p {\\n          throw(\\\"internal parser error: block expr parser did not advance\\\")\\n        } else {\\n          match peek(tokens, next) {\\n            TRBrace => {\\n              ArrayBuilder::push(steps, StepValue(e))\\n              end_pos = next + 1\\n              done = true\\n            },\\n            TSemicolon => {\\n              ArrayBuilder::push(steps, StepSeq(e))\\n              p = next + 1\\n            },\\n            TEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssign(name, val))\\n                p = next_pos\\n              },\\n              EDot(obj, field, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                let set_args = empty_exprs()\\n                Array::push(set_args, obj)\\n                Array::push(set_args, EString(field))\\n                Array::push(set_args, val)\\n                ArrayBuilder::push(steps, StepSeq(ECall(EIdent(\\\"__set_field\\\", -1), set_args, -1)))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TPlusEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"+\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TMinusEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"-\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TStarEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"*\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TSlashEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"/\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            TPercentEq => match e {\\n              EIdent(name, _) => {\\n                let (val, next_pos) = parse_block_value_only(tokens, next + 1, parse_recur)\\n                ArrayBuilder::push(steps, StepAssignOp(name, \\\"%\\\", val))\\n                p = next_pos\\n              },\\n              _ => throw(\\\"invalid assignment target\\\")\\n            },\\n            _ => {\\n              ArrayBuilder::push(steps, StepSeq(e))\\n              p = next\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  (fold_block_steps(ArrayBuilder::freeze(steps)), end_pos)\\n}\\n\\n\\nexport let parse_impl_dispatch: (Array[Token], Array[Int], Int, Int, (Array[Token], Int, Int) -> (Expr, Int) with { Error }) -> (Expr, Int) with { Error } = (tokens, starts, pos, mode, parse_recur) -> {\\n  if mode == 20 {\\n    parse_impl_block(tokens, starts, pos, parse_recur)\\n  } else if mode == 21 {\\n    let (cond, cn) = parse_infix_no_is(tokens, starts, pos, 0, pos, parse_recur)\\n    let mut is_mode = false\\n    let mut is_pat_val = PWild\\n    let mut brace_pos = cn\\n    match peek(tokens, cn) {\\n      TIs => {\\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\\n        is_mode = true\\n        is_pat_val = pat\\n        brace_pos = pn\\n      },\\n      TIdent(kw) => if kw == \\\"is\\\" {\\n        let (pat, pn) = parse_pattern(tokens, cn + 1)\\n        is_mode = true\\n        is_pat_val = pat\\n        brace_pos = pn\\n      },\\n      _ => ()\\n    }\\n    let br = expect_tk(tokens, brace_pos, \\\"{\\\")\\n    let (then_e, tn) = parse_recur(tokens, br, 20)\\n    let (else_e, end_pos) = match peek(tokens, tn) {\\n      TElse => match peek(tokens, tn + 1) {\\n        TIf => parse_recur(tokens, tn + 2, 21),\\n        TLBrace => parse_recur(tokens, tn + 2, 20),\\n        _ => parse_recur(tokens, tn + 1, 0)\\n      },\\n      _ => (EUnit, tn)\\n    }\\n    if is_mode {\\n      (EMatch(cond, [\\n        (is_pat_val, then_e),\\n        (PWild, else_e)\\n      ]), end_pos)\\n    } else {\\n      (EIf(cond, then_e, else_e), end_pos)\\n    }\\n  } else if mode == 22 {\\n    let (scrutinee, sn) = parse_recur(tokens, pos, 0)\\n    let br = expect_tk(tokens, sn, \\\"{\\\")\\n    match peek(tokens, br) {\\n      TRBrace => (EMatch(scrutinee, empty_arms()), br + 1),\\n      _ => {\\n        let ab = ArrayBuilder::new()\\n        let hg = [false]\\n        let endpos = collect_match_arms(tokens, starts, br, ab, hg, parse_recur)\\n        let arms3 = ArrayBuilder::freeze(ab)\\n        if Array::get(hg, 0) {\\n          let final_arms = desugar_guarded(arms3, 0, EIdent(\\\"__mg\\\", 0 - 1))\\n          (ELet(\\\"__mg\\\", scrutinee, EMatch(EIdent(\\\"__mg\\\", 0 - 1), final_arms)), endpos)\\n        } else {\\n          let plain = ArrayBuilder::new()\\n          let mut k = 0\\n          while k < Array::length(arms3) {\\n            let (p, _, bd) = Array::get(arms3, k)\\n            ArrayBuilder::push(plain, (p, bd))\\n            k = k + 1\\n          }\\n          (EMatch(scrutinee, ArrayBuilder::freeze(plain)), endpos)\\n        }\\n      }\\n    }\\n  } else if mode == 23 {\\n    let (cond, cn) = parse_recur(tokens, pos, 0)\\n    let br = expect_tk(tokens, cn, \\\"{\\\")\\n    let (body, end) = parse_recur(tokens, br, 20)\\n    (EWhile(cond, body), end)\\n  } else if mode == 24 {\\n    let br = expect_tk(tokens, pos, \\\"{\\\")\\n    let (body, bn) = parse_recur(tokens, br, 20)\\n    let wp = expect_tk(tokens, bn, \\\"with\\\")\\n    let (effect_name, effect_next) = match peek(tokens, wp) {\\n      TIdent(name) => (name, wp + 1),\\n      _ => throw(\\\"expected effect name after 'with'\\\")\\n    }\\n    let hb = expect_tk(tokens, effect_next, \\\"{\\\")\\n    match peek(tokens, hb) {\\n      TRBrace => (EHandle(body, empty_arms()), hb + 1),\\n      _ => {\\n        let b = ArrayBuilder::new()\\n        let (arm, next) = parse_handle_arm(tokens, starts, hb, effect_name, parse_recur)\\n        ArrayBuilder::push(b, arm)\\n        parse_handle_rest(tokens, starts, next, body, effect_name, b, parse_recur)\\n      }\\n    }\\n  } else if mode == 25 {\\n    let mut start = pos\\n    let mut is_await = false\\n    match peek(tokens, pos) {\\n      TIdent(marker) => if marker == \\\"await\\\" {\\n        match peek(tokens, pos + 1) {\\n          TIdent(_) => { start = pos + 1; is_await = true },\\n          _ => ()\\n        }\\n      } else (),\\n      _ => ()\\n    }\\n    match peek(tokens, start) {\\n      TIdent(first_name) => match peek(tokens, start + 1) {\\n        TComma => match peek(tokens, start + 2) {\\n          TIdent(second_name) => {\\n            let ip = expect_tk(tokens, start + 3, \\\"in\\\")\\n            match parse_recur(tokens, ip, 0) {\\n              (iterable, after_iter) => {\\n                let bb = expect_tk(tokens, after_iter, \\\"{\\\")\\n                let (body, end) = parse_recur(tokens, bb, 20)\\n                let loop_expr = if is_await {\\n                  EForIn(second_name, Some(first_name), ECall(EIdent(\\\"__await_iter\\\", -1), [\\n                    iterable\\n                  ], -1), body)\\n                } else {\\n                  EForIn(second_name, Some(first_name), iterable, body)\\n                }\\n                (loop_expr, end)\\n              },\\n              _ => throw(\\\"unreachable: parse_recur for for-in\\\")\\n            }\\n          },\\n          _ => throw(\\\"expected value binding name after ','\\\")\\n        },\\n        _ => {\\n          let ip = expect_tk(tokens, start + 1, \\\"in\\\")\\n          match parse_recur(tokens, ip, 0) {\\n            (iterable, after_iter) => {\\n              let bb = expect_tk(tokens, after_iter, \\\"{\\\")\\n              let (body, end) = parse_recur(tokens, bb, 20)\\n              let loop_expr = if is_await {\\n                EForIn(first_name, None, ECall(EIdent(\\\"__await_iter\\\", -1), [\\n                  iterable\\n                ], -1), body)\\n              } else {\\n                EForIn(first_name, None, iterable, body)\\n              }\\n              (loop_expr, end)\\n            },\\n            _ => throw(\\\"unreachable: parse_recur for for-in\\\")\\n          }\\n        }\\n      }\\n      ,\\n      _ => throw(\\\"expected identifier after 'for'\\\")\\n    }\\n  } else {\\n    let actual = tk_name(peek(tokens, pos))\\n    throw(\\\"internal parser error: unknown parse mode \\\\{mode} at #\\\\{pos} token=\\\\{actual}\\\")\\n  }\\n}\\n\\n\\n\\n\\n\\n\\n\\nexport let parse_impl: (Array[Token], Array[Int], Int, Int) -> (Expr, Int) with { Error } = (tokens, starts, pos, mode) -> {\\n  let rec parse_recur: (Array[Token], Int, Int) -> (Expr, Int) with { Error } = (rtoks, rpos, rmode) -> {\\n    if rmode >= 0 && rmode <= 10 {\\n      parse_infix(rtoks, starts, rpos, rmode, rpos, parse_recur)\\n    } else {\\n      parse_impl_dispatch(rtoks, starts, rpos, rmode, parse_recur)\\n    }\\n  }\\n  parse_recur(tokens, pos, mode)\\n}\\n\\nexport let parse: (Array[Token]) -> Expr with { Error } = (tokens) -> {\\n  let (e, next) = parse_impl(tokens, [], 0, 0)\\n  match peek(tokens, next) {\\n    TEof => e,\\n    _ => {\\n      let actual = tk_name(peek(tokens, next))\\n      throw(\\\"unexpected after expression: \\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nexport let parse_ok: (Array[Token]) -> Bool = (tokens) -> {\\n  handle {\\n    let _ = parse(tokens)\\n    true\\n  } with Error {\\n    Throw(_) => false\\n  }\\n}\\n\\nexport let parse_expr: (Array[Token], Int) -> (Expr, Int) with { Error } = (tokens, pos) -> {\\n  parse_impl(tokens, [], pos, 0)\\n}\\n\\nlet parse_type_param_bound_names: (Array[Token], Int) -> (Array[String], Int) with { Error } = (tokens, pos) -> {\\n  let b = ArrayBuilder::new()\\n  let mut p = pos\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, p) {\\n      TIdent(name) => {\\n        ArrayBuilder::push(b, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TPlus => {\\n            p = p + 1\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n      },\\n      _ => throw(\\\"expected trait bound name\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), p)\\n}\\n\\nlet parse_let_type_params: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\\n  let names = ArrayBuilder::new()\\n  let bounds = ArrayBuilder::new()\\n  let mut p = pos\\n  while true {\\n    match peek(tokens, p) {\\n      TRBracket => {\\n        p = p + 1\\n        break\\n      },\\n      TIdent(name) => {\\n        ArrayBuilder::push(names, name)\\n        p = p + 1\\n        match peek(tokens, p) {\\n          TColon => {\\n            let (bound_names, next) = parse_type_param_bound_names(tokens, p + 1)\\n            ArrayBuilder::push(bounds, (name, bound_names))\\n            p = next\\n          },\\n          _ => ()\\n        }\\n        match peek(tokens, p) {\\n          TComma => {\\n            p = p + 1\\n          },\\n          TRBracket => {\\n            p = p + 1\\n            break\\n          },\\n          _ => throw(\\\"expected ',' or ']' in type params\\\")\\n        }\\n      },\\n      _ => throw(\\\"expected type parameter name or ']'\\\")\\n    }\\n  }\\n  (ArrayBuilder::freeze(names), ArrayBuilder::freeze(bounds), p)\\n}\\n\\nlet parse_let_annotation: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], TypeExpr, Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBracket => {\\n      let (type_params, type_bounds, after_params) = parse_let_type_params(tokens, pos + 1)\\n      let (ty, next) = parse_type_impl(tokens, after_params, 0)\\n      (type_params, type_bounds, ty, next)\\n    },\\n    _ => {\\n      let (ty, next) = parse_type_impl(tokens, pos, 0)\\n      (_no_tp(), _no_tb(), ty, next)\\n    }\\n  }\\n}\\n\\nlet apply_fn_annotation_params: (Array[(String, Option[TypeExpr])], Array[TypeExpr]) -> Array[(String, Option[TypeExpr])] = (params, param_types) -> {\\n  if Array::length(params) != Array::length(param_types) {\\n    params\\n  } else {\\n    let out = ArrayBuilder::new()\\n    let mut i = 0\\n    while i < Array::length(params) {\\n      let (name, ann) = Array::get(params, i)\\n      let next_ann = match ann {\\n        Some(_) => ann,\\n        None => Some(Array::get(param_types, i))\\n      }\\n      ArrayBuilder::push(out, (name, next_ann))\\n      i = i + 1\\n    }\\n    ArrayBuilder::freeze(out)\\n  }\\n}\\n\\nlet apply_generic_fn_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr, Array[TypeExpr], TypeExpr, Option[String]) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val, param_types, ret_ty, effect_name) -> {\\n  match val {\\n    EFn(existing_type_params, existing_type_bounds, params, ret_opt, effect_opt, body) => {\\n      let next_params = apply_fn_annotation_params(params, param_types)\\n      let next_ret = match ret_opt {\\n        Some(_) => ret_opt,\\n        None => Some(ret_ty)\\n      }\\n      let next_effect = match effect_opt {\\n        Some(_) => effect_opt,\\n        None => effect_name\\n      }\\n      let next_type_params = if Array::length(type_params) > 0 {\\n        type_params\\n      } else existing_type_params\\n      let next_type_bounds = if Array::length(type_params) > 0 {\\n        type_bounds\\n      } else existing_type_bounds\\n      let next_ann = if Array::length(type_params) > 0 {\\n        None\\n      } else ann\\n      (next_ann, EFn(next_type_params, next_type_bounds, next_params, next_ret, next_effect, body))\\n    },\\n    _ => (ann, val)\\n  }\\n}\\n\\nlet apply_generic_let_annotation: (Array[String], Array[(String, Array[String])], Option[TypeExpr], Expr) -> (Option[TypeExpr], Expr) = (type_params, type_bounds, ann, val) -> {\\n  match ann {\\n    Some(ann_ty) => match ann_ty {\\n      TyFn(param_types, ret_ty, effect_name) => apply_generic_fn_annotation(type_params, type_bounds, ann, val, param_types, ret_ty, effect_name),\\n      _ => (ann, val)\\n    },\\n    _ => (ann, val)\\n  }\\n}\\n\\nlet apply_value_bracket_type_params: (Array[String], Array[(String, Array[String])], Expr) -> Expr = (tps, tbs, val) -> {\\n  if Array::length(tps) == 0 {\\n    val\\n  } else {\\n    match val {\\n      EFn(existing_tp, existing_tb, params, ret, eff, body) => {\\n        let next_tp = if Array::length(existing_tp) > 0 {\\n          existing_tp\\n        } else tps\\n        let next_tb = if Array::length(existing_tp) > 0 {\\n          existing_tb\\n        } else tbs\\n        EFn(next_tp, next_tb, params, ret, eff, body)\\n      },\\n      _ => val\\n    }\\n  }\\n}\\n\\nlet skip_generic_value_start: (Array[Token], Int) -> Int = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBracket => match peek(tokens, pos + 1) {\\n      TIdent(_) => {\\n        let maybe_generic = match peek(tokens, pos + 2) {\\n          TRBracket => match peek(tokens, pos + 3) {\\n            TLParen => true,\\n            _ => false\\n          },\\n          TColon => true,\\n          TComma => true,\\n          _ => false\\n        }\\n        if maybe_generic {\\n          let mut scan_pos = pos + 1\\n          let mut depth = 1\\n          while depth > 0 {\\n            match peek(tokens, scan_pos) {\\n              TLBracket => {\\n                depth = depth + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1\\n              },\\n              _ => ()\\n            }\\n            scan_pos = scan_pos + 1\\n          }\\n          scan_pos\\n        } else {\\n          pos\\n        }\\n      },\\n      _ => pos\\n    },\\n    _ => pos\\n  }\\n}\\n\\nlet parse_value_bracket_header: (Array[Token], Int) -> (Array[String], Array[(String, Array[String])], Int) with { Error } = (tokens, pos) -> {\\n  let skipped = skip_generic_value_start(tokens, pos)\\n  if skipped == pos {\\n    (_no_tp(), _no_tb(), pos)\\n  } else {\\n    match peek(tokens, pos) {\\n      TLBracket => {\\n        let (tps, tbs, _after) = parse_let_type_params(tokens, pos + 1)\\n        (tps, tbs, skipped)\\n      },\\n      _ => (_no_tp(), _no_tb(), skipped)\\n    }\\n  }\\n}\\n\\nlet parse_let_stmt: (Array[Token], Array[Int], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, starts, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TRec => {\\n      let (name, name_next) = parse_binding_name(tokens, pos + 1)\\n      let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\\n        TColon => {\\n          let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\\n          (tparams, tbounds, Some(ty), tp)\\n        },\\n        _ => (_no_tp(), _no_tb(), None, name_next)\\n      }\\n      let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n      let (bracket_tps, bracket_tbs, val_start_r) = parse_value_bracket_header(tokens, ep)\\n      let val_pair = parse_impl(tokens, starts, val_start_r, 0)\\n      let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\\n      let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\\n      let val_next = val_pair.1\\n      (SLet(exported, true, name, final_ty_opt, val), val_next)\\n    },\\n    TMut => match peek(tokens, pos + 1) {\\n      TIdent(name) => {\\n        let (ty_opt, eq_pos) = match peek(tokens, pos + 2) {\\n          TColon => {\\n            let (ty, tp) = parse_type_impl(tokens, pos + 3, 0)\\n            (Some(ty), tp)\\n          },\\n          _ => (None, pos + 2)\\n        }\\n        let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n        let val_pair = parse_impl(tokens, starts, ep, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        (SLetMut(name, ty_opt, val), val_next)\\n      },\\n      _ => throw(\\\"expected name after 'let mut'\\\")\\n    },\\n    TLParen => {\\n      let (pat, pat_next) = parse_pattern(tokens, pos)\\n      let ep = expect_tk(tokens, pat_next, \\\"=\\\")\\n      let val_pair = parse_impl(tokens, starts, ep, 0)\\n      let val = val_pair.0\\n      let val_next = val_pair.1\\n      (SLetPat(pat, val), val_next)\\n    },\\n    TIdent(_name0) => {\\n      let is_struct_destructure = match peek(tokens, pos + 1) {\\n        TDoubleColon => match peek(tokens, pos + 2) {\\n          TLBrace => true,\\n          _ => false\\n        },\\n        _ => false\\n      }\\n      if is_struct_destructure {\\n        let (pat, pat_next) = parse_pattern(tokens, pos)\\n        let ep = expect_tk(tokens, pat_next, \\\"=\\\")\\n        let val_pair = parse_impl(tokens, starts, ep, 0)\\n        let val = val_pair.0\\n        let val_next = val_pair.1\\n        (SLetPat(pat, val), val_next)\\n      } else {\\n        let (name, name_next) = parse_binding_name(tokens, pos)\\n        let (type_params, type_bounds, ty_opt, eq_pos) = match peek(tokens, name_next) {\\n          TColon => {\\n            let (tparams, tbounds, ty, tp) = parse_let_annotation(tokens, name_next + 1)\\n            (tparams, tbounds, Some(ty), tp)\\n          },\\n          _ => (_no_tp(), _no_tb(), None, name_next)\\n        }\\n        let ep = expect_tk(tokens, eq_pos, \\\"=\\\")\\n        let (bracket_tps, bracket_tbs, val_start) = parse_value_bracket_header(tokens, ep)\\n        let val_pair = parse_impl(tokens, starts, val_start, 0)\\n        let val_with_tp = apply_value_bracket_type_params(bracket_tps, bracket_tbs, val_pair.0)\\n        let (final_ty_opt, val) = apply_generic_let_annotation(type_params, type_bounds, ty_opt, val_with_tp)\\n        let val_next = val_pair.1\\n        (SLet(exported, false, name, final_ty_opt, val), val_next)\\n      }\\n    },\\n    _ => throw(\\\"expected name after 'let'\\\")\\n  }\\n}\\n\\n\\nexport {\\n  collect_import_path, empty_fields, empty_import_items, expect_tk, is_tk, parse, parse_effect_stmt, parse_enum_stmt, parse_expr, parse_impl, parse_impl_stmt_dispatch, parse_import_item, parse_let_stmt, parse_ok, parse_struct_field, parse_suberror_stmt, parse_trait_stmt, parse_type, parse_type_alias_stmt, peek, tk_name\\n}\\n\\nexport {\\n  peek, is_tk, parse, tk_name, parse_ok, expect_tk, parse_expr, parse_impl, parse_type, empty_fields, parse_let_stmt, parse_enum_stmt, parse_trait_stmt, parse_effect_stmt, parse_import_item, empty_import_items, parse_struct_field, collect_import_path, parse_suberror_stmt, parse_type_alias_stmt, parse_impl_stmt_dispatch\\n}\\n\\n\\n\\n\\n\\n\\n\\nlet parser_mode_block = 20\\n\\nlet empty_names: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"_\\\"\\n  ], 0, 0)\\n}\\n\\nlet parse_test_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\\n  match peek(tokens, pos) {\\n    TString(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\\n      (STest(name, body), end)\\n    },\\n    _ => throw(\\\"expected test name string\\\")\\n  }\\n}\\n\\nlet parse_bench_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\\n  match peek(tokens, pos) {\\n    TString(name) => {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (body, end) = parse_impl(tokens, starts, br, parser_mode_block);\\n      (SBench(name, body), end)\\n    },\\n    _ => throw(\\\"expected bench name string\\\")\\n  }\\n}\\n\\nlet parse_export_name: (Array[Token], Int) -> (String, Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => match peek(tokens, pos + 1) {\\n      TDoubleColon => match peek(tokens, pos + 2) {\\n        TIdent(member) =>\\n          (String::concat(name, String::concat(\\\"::\\\", member)), pos + 3),\\n        _ => throw(\\\"expected qualified member name after '::'\\\")\\n      },\\n      _ => (name, pos + 1)\\n    },\\n    _ => throw(\\\"expected name in export list\\\")\\n  }\\n}\\n\\nlet rec parse_export_names_rest: (Array[Token], Int, ArrayBuilder[String]) -> (Array[String], Int) with { Error } = (tokens, pos, b) -> {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      TIdent(_) => {\\n        let (nm, after) = parse_export_name(tokens, pos + 1)\\n        ArrayBuilder::push(b, nm)\\n        parse_export_names_rest(tokens, after, b)\\n      },\\n      _ => throw(\\\"expected name in export list\\\")\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or '}' in export list\\\")\\n  }\\n}\\n\\nlet rec parse_import_items_rest: (Array[Token], Int, ArrayBuilder[(String, Option[String])]) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos, b) -> {\\n  match peek(tokens, pos) {\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), pos + 2),\\n      _ => {\\n        let (item, next) = parse_import_item(tokens, pos + 1)\\n        ArrayBuilder::push(b, item)\\n        parse_import_items_rest(tokens, next, b)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => throw(\\\"expected ',' or '}' in import list\\\")\\n  }\\n}\\n\\nlet parse_import_items: (Array[Token], Int) -> (Array[(String, Option[String])], Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_import_items(), pos + 1),\\n    _ => {\\n      let (first, next) = parse_import_item(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      parse_import_items_rest(tokens, next, b)\\n    }\\n  }\\n}\\n\\nlet parse_import_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => if String::length(name) > 1 && String::char_code_at(name, 0) == '@' {\\n      let br = expect_tk(tokens, pos + 1, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(name, items), end)\\n    } else {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      match peek(tokens, bp) {\\n        TIdent(alias_name) => if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == '@' {\\n          let alias_str = String::substring(alias_name, 1, String::length(alias_name))\\n          (SAliasDecl(alias_str, path), bp + 1)\\n        } else {\\n          let br = expect_tk(tokens, bp, \\\"{\\\")\\n          let (items, end) = parse_import_items(tokens, br);\\n          (SImport(path, items), end)\\n        },\\n        _ => {\\n          let br = expect_tk(tokens, bp, \\\"{\\\")\\n          let (items, end) = parse_import_items(tokens, br);\\n          (SImport(path, items), end)\\n        }\\n      }\\n    },\\n    _ => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SImport(path, items), end)\\n    }\\n  }\\n}\\n\\nlet tl_push_mut_name: (ArrayBuilder[String], (String, TypeExpr), Bool) -> Unit = (mb, field, is_mut) -> {\\n  if is_mut {\\n    let (fname, _) = field\\n    ArrayBuilder::push(mb, fname)\\n  } else {\\n    ()\\n  }\\n}\\n\\nlet rec parse_toplevel_struct_fields_rest: (Array[Token], Int, ArrayBuilder[(String, TypeExpr)], ArrayBuilder[String]) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos, b, mb) -> {\\n  match peek(tokens, pos) {\\n    TSemicolon => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\\n      _ => {\\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        tl_push_mut_name(mb, field, is_mut)\\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\\n      }\\n    },\\n    TComma => match peek(tokens, pos + 1) {\\n      TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 2),\\n      _ => {\\n        let (field, is_mut, next) = parse_struct_field(tokens, pos + 1)\\n        ArrayBuilder::push(b, field)\\n        tl_push_mut_name(mb, field, is_mut)\\n        parse_toplevel_struct_fields_rest(tokens, next, b, mb)\\n      }\\n    },\\n    TRBrace => (ArrayBuilder::freeze(b), ArrayBuilder::freeze(mb), pos + 1),\\n    _ => throw(\\\"expected ';', ',' or '}' in struct\\\")\\n  }\\n}\\n\\nlet parse_toplevel_struct_fields: (Array[Token], Int) -> (Array[(String, TypeExpr)], Array[String], Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (empty_fields(), Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), pos + 1),\\n    _ => {\\n      let (first, is_mut, next) = parse_struct_field(tokens, pos)\\n      let b = ArrayBuilder::new()\\n      let mb = ArrayBuilder::new()\\n      ArrayBuilder::push(b, first)\\n      tl_push_mut_name(mb, first, is_mut)\\n      parse_toplevel_struct_fields_rest(tokens, next, b, mb)\\n    }\\n  }\\n}\\n\\nlet parse_toplevel_struct_stmt: (Array[Token], Int, Bool) -> (Stmt, Int) with { Error } = (tokens, pos, exported) -> {\\n  match peek(tokens, pos) {\\n    TIdent(name) => {\\n      let after_name = match peek(tokens, pos + 1) {\\n        TLBracket => {\\n          let mut skip = pos + 2\\n          let mut depth = 1\\n          while depth > 0 {\\n            match peek(tokens, skip) {\\n              TLBracket => {\\n                depth = depth + 1; skip = skip + 1\\n              },\\n              TRBracket => {\\n                depth = depth - 1; skip = skip + 1\\n              },\\n              TEof => {\\n                depth = 0\\n              },\\n              _ => {\\n                skip = skip + 1\\n              }\\n            }\\n          }\\n          skip\\n        },\\n        _ => pos + 1\\n      }\\n      let br = expect_tk(tokens, after_name, \\\"{\\\")\\n      let (fields, mut_names, end) = parse_toplevel_struct_fields(tokens, br);\\n      let (derives, final_pos) = parse_derive_names(tokens, end)\\n      (SStruct(exported, name, fields, derives, mut_names), final_pos)\\n    },\\n    _ => throw(\\\"expected struct name\\\")\\n  }\\n}\\n\\nlet parse_export_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\\n  match peek(tokens, pos) {\\n    TLet => parse_let_stmt(tokens, starts, pos + 1, true),\\n    TEnum => parse_enum_stmt(tokens, pos + 1, true),\\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, true),\\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, true),\\n    TIdent(ident_name) => if ident_name == \\\"effect\\\" {\\n      parse_effect_stmt(tokens, pos + 1, true)\\n    } else {\\n      throw(String::concat(\\\"unexpected token in export: \\\", ident_name))\\n    },\\n    TType => parse_type_alias_stmt(tokens, pos + 1, true),\\n    TTrait => parse_trait_stmt(tokens, pos + 1, true),\\n    TOpen => match peek(tokens, pos + 1) {\\n      TTrait => parse_trait_stmt(tokens, pos + 2, true),\\n      _ => throw(\\\"expected 'trait' after 'open'\\\")\\n    },\\n    TLBrace => match peek(tokens, pos + 1) {\\n      TRBrace => (SExport(empty_names()), pos + 2),\\n      TIdent(_) => {\\n        let (first, after) = parse_export_name(tokens, pos + 1)\\n        let b = ArrayBuilder::new()\\n        ArrayBuilder::push(b, first)\\n        let (names, end) = parse_export_names_rest(tokens, after, b);\\n        (SExport(names), end)\\n      },\\n      _ => throw(\\\"expected name in export list\\\")\\n    },\\n    TDot => {\\n      let (path, bp) = collect_import_path(tokens, pos, \\\"\\\")\\n      let br = expect_tk(tokens, bp, \\\"{\\\")\\n      let (items, end) = parse_import_items(tokens, br);\\n      (SReExport(path, items), end)\\n    },\\n    _ => {\\n      let actual = tk_name(peek(tokens, pos))\\n      throw(\\\"unexpected after 'export': \\\\{actual}\\\")\\n    }\\n  }\\n}\\n\\nlet parse_percent_symbol_name: (Array[Token], Int, String) -> (String, Int) with { Error } = (tokens, pos, label) -> {\\n  let pp = expect_tk(tokens, pos, \\\"%\\\")\\n  match peek(tokens, pp) {\\n    TIdent(name) => (\\\"%\\\\{name}\\\", pp + 1),\\n    _ => throw(\\\"expected \\\\{label} after '%'\\\")\\n  }\\n}\\n\\nlet parse_extern_let_stmt: (Array[Token], Int) -> (Stmt, Int) with { Error } = (tokens, pos) -> {\\n  let lp = expect_tk(tokens, pos, \\\"let\\\")\\n  let (name, np) = parse_percent_symbol_name(tokens, lp, \\\"extern symbol name\\\")\\n  let cp = expect_tk(tokens, np, \\\":\\\")\\n  let (ty, end) = parse_type(tokens, cp);\\n  (SExternLet(name, ty), end)\\n}\\n\\nlet rec parse_module_body_with: ((Array[Token], Int) -> (Stmt, Int) with { Error }, Array[Token], Int, ArrayBuilder[Stmt]) -> (Array[Stmt], Int) with { Error } = (parse_stmt_fn, tokens, pos, b) -> {\\n  match peek(tokens, pos) {\\n    TRBrace => (ArrayBuilder::freeze(b), pos + 1),\\n    _ => {\\n      let (stmt, next) = parse_stmt_fn(tokens, pos)\\n      ArrayBuilder::push(b, stmt)\\n      parse_module_body_with(parse_stmt_fn, tokens, next, b)\\n    }\\n  }\\n}\\n\\nexport let rec parse_stmt: (Array[Token], Array[Int], Int) -> (Stmt, Int) with { Error } = (tokens, starts, pos) -> {\\n  let parse_stmt_closure: (Array[Token], Int) -> (Stmt, Int) with { Error } = (t, p) -> {\\n    parse_stmt(t, starts, p)\\n  }\\n  let head = peek(tokens, pos)\\n  match head {\\n    TLet => parse_let_stmt(tokens, starts, pos + 1, false),\\n    TExport => match peek(tokens, pos + 1) {\\n      TModule => match peek(tokens, pos + 2) {\\n        TIdent(name) => {\\n          let br = expect_tk(tokens, pos + 3, \\\"{\\\")\\n          {\\n            let (stmts, end) = parse_module_body_with(parse_stmt_closure, tokens, br, ArrayBuilder::new());\\n            (SModule(true, name, stmts), end)\\n          }\\n        },\\n        _ => throw(\\\"expected module name\\\")\\n      },\\n      _ => parse_export_stmt(tokens, starts, pos + 1)\\n    },\\n    TModule => match peek(tokens, pos + 1) {\\n      TIdent(name) => {\\n        let br = expect_tk(tokens, pos + 2, \\\"{\\\")\\n        {\\n          let (stmts, end) = parse_module_body_with(parse_stmt_closure, tokens, br, ArrayBuilder::new());\\n          (SModule(false, name, stmts), end)\\n        }\\n      },\\n      _ => throw(\\\"expected module name\\\")\\n    },\\n    TEnum => parse_enum_stmt(tokens, pos + 1, false),\\n    TSuberror => parse_suberror_stmt(tokens, pos + 1, false),\\n    TStruct => parse_toplevel_struct_stmt(tokens, pos + 1, false),\\n    TType => parse_type_alias_stmt(tokens, pos + 1, false),\\n    TTrait => parse_trait_stmt(tokens, pos + 1, false),\\n    TTest => parse_test_stmt(tokens, starts, pos + 1),\\n    TBench => parse_bench_stmt(tokens, starts, pos + 1),\\n    TImport => parse_import_stmt(tokens, pos + 1),\\n    TIdent(name) => match name {\\n      \\\"effect\\\" => parse_effect_stmt(tokens, pos + 1, false),\\n      \\\"extern\\\" => parse_extern_let_stmt(tokens, pos + 1),\\n      \\\"use\\\" => throw(\\\"'use' syntax is removed; use 'import <module-ref> { ... }'\\\"),\\n      _ => {\\n      let (e, next) = parse_impl(tokens, starts, pos, 0)\\n      match peek(tokens, next) {\\n        TEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssign(name, val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TPlusEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"+\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TMinusEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"-\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TStarEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"*\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        TSlashEq => match e {\\n          EIdent(name, _) => {\\n            let (val, vn) = parse_impl(tokens, starts, next + 1, 0)\\n            (SExpr(EAssignOp(name, \\\"/\\\", val, EUnit)), vn)\\n          },\\n          _ => (SExpr(e), next)\\n        },\\n        _ => (SExpr(e), next)\\n      }\\n      }\\n    },\\n    _ => {\\n      let (e, next) = parse_impl(tokens, starts, pos, 0);\\n      (SExpr(e), next)\\n    }\\n  }\\n}\\n\\nlet parse_impl_methods: (Array[Token], Int, Stmt) -> (Array[Stmt], Int) with { Error } = (tokens, pos, simpl) -> {\\n  let out = ArrayBuilder::new()\\n  ArrayBuilder::push(out, simpl)\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let type_name = match simpl {\\n        SImpl(_, _, _, tn) => tn,\\n        _ => \\\"\\\"\\n      }\\n      let impl_tparams = match simpl {\\n        SImpl(tp, _, _, _) => tp,\\n        _ => Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n      }\\n      let impl_tbounds = match simpl {\\n        SImpl(_, tb, _, _) => tb,\\n        _ => Array::slice([\\n          (\\\"\\\", Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        ], 0, 0)\\n      }\\n      let mut p = pos + 1\\n      let mut done = false\\n      while !done {\\n        match peek(tokens, p) {\\n          TRBrace => {\\n            p = p + 1\\n            done = true\\n          },\\n          TIdent(mname) => {\\n            let (efn, p2) = parse_expr(tokens, p + 1)\\n            let efn2 = if Array::length(impl_tparams) > 0 {\\n              match efn {\\n                EFn(mtp, mtb, mparams, mret, meff, mbody) => EFn(Array::concat(impl_tparams, mtp), Array::concat(impl_tbounds, mtb), mparams, mret, meff, mbody),\\n                _ => efn\\n              }\\n            } else {\\n              efn\\n            }\\n            let qname = String::concat(type_name, String::concat(\\\"::\\\", mname))\\n            ArrayBuilder::push(out, SLet(false, true, qname, None, efn2))\\n            p = match peek(tokens, p2) {\\n              TSemicolon => p2 + 1,\\n              _ => p2\\n            }\\n          },\\n          _ => throw(\\\"expected impl method name or '}'\\\")\\n        }\\n      }\\n      (ArrayBuilder::freeze(out), p)\\n    },\\n    _ => (ArrayBuilder::freeze(out), pos)\\n  }\\n}\\n\\n\\nlet parse_cfg_directive: (Array[Token], Int) -> (String, String, Int) with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TIdent(dname) => {\\n      if dname == \\\"cfg\\\" || dname == \\\"cfg_enable\\\" {\\n        match peek(tokens, pos + 1) {\\n          TLParen => match peek(tokens, pos + 2) {\\n            TIdent(flag) => match peek(tokens, pos + 3) {\\n              TRParen => (dname, flag, pos + 4),\\n              _ => throw(\\\"expected ')' after #cfg flag name\\\")\\n            },\\n            _ => throw(\\\"expected flag name in #cfg(...)\\\")\\n          },\\n          _ => throw(\\\"expected '(' after #cfg\\\")\\n        }\\n      } else {\\n        throw(String::concat(\\\"unknown # directive: \\\", dname))\\n      }\\n    },\\n    _ => throw(\\\"expected directive name after '#'\\\")\\n  }\\n}\\n\\nlet cfg_scan_enabled: (Array[Token]) -> Array[String] with { Error } = (tokens) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  let n = Array::length(tokens)\\n  while i < n {\\n    match Array::get(tokens, i) {\\n      THash => {\\n        let (dname, flag, next) = parse_cfg_directive(tokens, i + 1)\\n        if dname == \\\"cfg_enable\\\" {\\n          Array::push(out, flag)\\n        } else {\\n          ()\\n        }\\n        i = next\\n      },\\n      _ => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  out\\n}\\n\\nlet cfg_flag_active: (Array[String], String) -> Bool = (active, flag) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(active) {\\n    if Array::get(active, i) == flag {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nexport let parse_program: (Array[Token]) -> Array[Stmt] with { Error } = (tokens) -> {\\n  let cfg_active = cfg_scan_enabled(tokens)\\n  let b = ArrayBuilder::new()\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\\n        if dname == \\\"cfg_enable\\\" || cfg_flag_active(cfg_active, flag) {\\n          pos = dnext\\n        } else {\\n          match peek(tokens, dnext) {\\n            TImpl => {\\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\\n              pos = dn\\n            },\\n            _ => {\\n              let (_dropped, dn) = parse_stmt(tokens, [], dnext)\\n              pos = dn\\n            }\\n          }\\n        }\\n      },\\n      TImpl => {\\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n        let (impl_stmts, next) = parse_impl_methods(tokens, hp, simpl)\\n        let mut ii = 0\\n        while ii < Array::length(impl_stmts) {\\n          ArrayBuilder::push(b, Array::get(impl_stmts, ii))\\n          ii = ii + 1\\n        }\\n        pos = next\\n      },\\n      _ => {\\n        let (stmt, next) = parse_stmt(tokens, [], pos)\\n        ArrayBuilder::push(b, stmt)\\n        pos = next\\n      }\\n    }\\n  }\\n  ArrayBuilder::freeze(b)\\n}\\n\\nexport let parse_program_located: (Array[Token], Array[Int], String) -> Array[Stmt] with { Error } = (tokens, starts, source) -> {\\n  let cfg_active = cfg_scan_enabled(tokens)\\n  let b = ArrayBuilder::new()\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\\n        if dname == \\\"cfg_enable\\\" || cfg_flag_active(cfg_active, flag) {\\n          pos = dnext\\n        } else {\\n          match peek(tokens, dnext) {\\n            TImpl => {\\n              let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\\n              let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\\n              pos = dn\\n            },\\n            _ => {\\n              let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\\n              pos = dn\\n            }\\n          }\\n        }\\n      },\\n      _ => {\\n        let start_pos = pos\\n        let (stmts, next) = handle {\\n          match peek(tokens, pos) {\\n            TImpl => {\\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n              parse_impl_methods(tokens, hp, simpl)\\n            },\\n            _ => {\\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\\n              ([\\n                stmt\\n              ], n)\\n            }\\n          }\\n        } with Error {\\n          Throw(msg) => {\\n            let off = if start_pos < Array::length(starts) {\\n              Array::get(starts, start_pos)\\n            } else {\\n              0\\n            }\\n            let (line, col) = offset_to_line_col(source, off)\\n            let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n            throw(String::concat(loc, msg))\\n          }\\n        }\\n        let mut ii = 0\\n        while ii < Array::length(stmts) {\\n          ArrayBuilder::push(b, Array::get(stmts, ii))\\n          ii = ii + 1\\n        }\\n        pos = next\\n      }\\n    }\\n  }\\n  ArrayBuilder::freeze(b)\\n}\\n\\nlet is_recovery_point: (Token) -> Bool = (t) -> {\\n  match t {\\n    TLet => true,\\n    TExport => true,\\n    TModule => true,\\n    TEnum => true,\\n    TSuberror => true,\\n    TStruct => true,\\n    TType => true,\\n    TTrait => true,\\n    TTest => true,\\n    TBench => true,\\n    TImport => true,\\n    TImpl => true,\\n    TDeclare => true,\\n    TOpen => true,\\n    TSemicolon => true,\\n    TEof => true,\\n    _ => false\\n  }\\n}\\n\\nexport let parse_program_recovering: (Array[Token], Array[Int], String) -> (Array[Stmt], Array[String]) with { Error } = (tokens, starts, source) -> {\\n  let cfg_active = handle {\\n    cfg_scan_enabled(tokens)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      \\\"\\\"\\n    ], 0, 0)\\n  }\\n  let b = ArrayBuilder::new()\\n  let diags = ArrayBuilder::new()\\n  let n = Array::length(tokens)\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        let cfg_res = handle {\\n          let (dname, flag, dnext) = parse_cfg_directive(tokens, pos + 1)\\n          if dname == \\\"cfg_enable\\\" || cfg_flag_active(cfg_active, flag) {\\n            dnext\\n          } else {\\n            match peek(tokens, dnext) {\\n              TImpl => {\\n                let (simpl_d, hp_d) = parse_impl_stmt_dispatch(tokens, dnext + 1)\\n                let (_dropped, dn) = parse_impl_methods(tokens, hp_d, simpl_d)\\n                dn\\n              },\\n              _ => {\\n                let (_dropped, dn) = parse_stmt(tokens, starts, dnext)\\n                dn\\n              }\\n            }\\n          }\\n        } with Error {\\n          Throw(_) => 0 - 1\\n        }\\n        if cfg_res >= 0 {\\n          pos = cfg_res\\n        } else {\\n          let mut rp = pos + 1\\n          while rp < n && !is_recovery_point(Array::get(tokens, rp)) {\\n            rp = rp + 1\\n          }\\n          pos = rp\\n        }\\n      },\\n      _ => {\\n        let start_pos = pos\\n        let res = handle {\\n          let (stmts, next) = match peek(tokens, pos) {\\n            TImpl => {\\n              let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n              parse_impl_methods(tokens, hp, simpl)\\n            },\\n            _ => {\\n              let (stmt, n) = parse_stmt(tokens, starts, pos)\\n              ([\\n                stmt\\n              ], n)\\n            }\\n          }\\n          Some((stmts, next))\\n        } with Error {\\n          Throw(msg) => {\\n            let off = if start_pos < Array::length(starts) {\\n              Array::get(starts, start_pos)\\n            } else {\\n              0\\n            }\\n            let (line, col) = offset_to_line_col(source, off)\\n            let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n            ArrayBuilder::push(diags, String::concat(loc, msg))\\n            None\\n          }\\n        }\\n        match res {\\n          Some((stmts, next)) => {\\n            let mut ii = 0\\n            while ii < Array::length(stmts) {\\n              ArrayBuilder::push(b, Array::get(stmts, ii))\\n              ii = ii + 1\\n            }\\n            pos = next\\n          },\\n          None => {\\n            let mut rp = start_pos + 1\\n            let mut sync = false\\n            while !sync {\\n              if rp >= n {\\n                sync = true\\n              } else {\\n                let t = peek(tokens, rp)\\n                if is_recovery_point(t) {\\n                  sync = true\\n                } else {\\n                  rp = rp + 1\\n                }\\n              }\\n            }\\n            pos = rp\\n          }\\n        }\\n      }\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(diags))\\n}\\n\\nexport let parse_program_spans: (Array[Token], Array[Int], Array[Int]) -> (Array[Stmt], Array[Int], Array[Int]) with { Error } = (tokens, starts, ends) -> {\\n  let b = ArrayBuilder::new()\\n  let span_start = ArrayBuilder::new()\\n  let span_end = ArrayBuilder::new()\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    match peek(tokens, pos) {\\n      TEof => {\\n        done = true\\n      },\\n      TSemicolon => {\\n        pos = pos + 1\\n      },\\n      THash => {\\n        throw(\\\"#cfg directives are not supported in module-source emission\\\")\\n      },\\n      TImpl => {\\n        let st = Array::get(starts, pos)\\n        let (simpl, hp) = parse_impl_stmt_dispatch(tokens, pos + 1)\\n        let next = skip_braced_body(tokens, hp)\\n        ArrayBuilder::push(b, simpl)\\n        ArrayBuilder::push(span_start, st)\\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\\n        pos = next\\n      },\\n      _ => {\\n        let st = Array::get(starts, pos)\\n        let (stmt, next) = parse_stmt(tokens, starts, pos)\\n        ArrayBuilder::push(b, stmt)\\n        ArrayBuilder::push(span_start, st)\\n        ArrayBuilder::push(span_end, Array::get(ends, next - 1))\\n        pos = next\\n      }\\n    }\\n  }\\n  (ArrayBuilder::freeze(b), ArrayBuilder::freeze(span_start), ArrayBuilder::freeze(span_end))\\n}\\n\\n\\nexport {\\n  Pat, Expr, Stmt, TypeExpr, parse, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\\n}\\n\\nexport {\\n  Pat, Expr, Stmt, parse, TypeExpr, parse_ok, parse_expr, parse_stmt, parse_type, parse_program\\n}\\n\\n\\n\\n\\n\\n\\nlet rec resolve_expr: (Expr) -> Expr with { Error } = (e) -> {\\n  let desugar_parts: (Array[String]) -> Expr with { Error } = (parts) -> {\\n    let plen = Array::length(parts)\\n    let exprs = ArrayBuilder::new()\\n    let mut i = 0\\n    while i < plen {\\n      let lit = Array::get(parts, i)\\n      if String::length(lit) > 0 {\\n        ArrayBuilder::push(exprs, EString(lit))\\n      }\\n      if i + 1 < plen {\\n        let expr_src = Array::get(parts, i + 1)\\n        let expr_tokens = lex(expr_src)\\n        let parsed = parse(expr_tokens)\\n        let resolved = resolve_expr(parsed)\\n        ArrayBuilder::push(exprs, ECall(EIdent(\\\"__to_string\\\", -1), [\\n          resolved\\n        ], -1))\\n      }\\n      i = i + 2\\n    }\\n    let result_arr = ArrayBuilder::freeze(exprs)\\n    let result_len = Array::length(result_arr)\\n    if result_len == 0 {\\n      EString(\\\"\\\")\\n    } else {\\n      let mut result = Array::get(result_arr, 0)\\n      let mut j = 1\\n      while j < result_len {\\n        result = ECall(EIdent(\\\"String::concat\\\", -1), [\\n          result,\\n          Array::get(result_arr, j)\\n        ], -1)\\n        j = j + 1\\n      }\\n      result\\n    }\\n  }\\n  let resolve_arr: (Array[Expr]) -> Array[Expr] with { Error } = (exprs) -> {\\n    for ex in exprs {\\n      resolve_expr(ex)\\n    }\\n  }\\n  match e {\\n    EStringInterp(parts) => desugar_parts(parts),\\n    EInt(_) => e,\\n    EFloat(_) => e,\\n    EString(_) => e,\\n    EBool(_) => e,\\n    EUnit => e,\\n    EIdent(_, _) => e,\\n    ETuple(elems) => ETuple(resolve_arr(elems)),\\n    EArray(elems) => EArray(resolve_arr(elems)),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f; (n, resolve_expr(v))\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (n, v) = f; (n, resolve_expr(v))\\n    }),\\n    EIf(c, t, el) => EIf(resolve_expr(c), resolve_expr(t), resolve_expr(el)),\\n    ELet(n, v, b) => ELet(n, resolve_expr(v), resolve_expr(b)),\\n    ELetRec(n, v, b) => ELetRec(n, resolve_expr(v), resolve_expr(b)),\\n    ELetMut(n, v, b) => ELetMut(n, resolve_expr(v), resolve_expr(b)),\\n    EAssign(n, v, b) => EAssign(n, resolve_expr(v), resolve_expr(b)),\\n    EAssignOp(n, op, v, b) => EAssignOp(n, op, resolve_expr(v), resolve_expr(b)),\\n    ESeq(a, b) => ESeq(resolve_expr(a), resolve_expr(b)),\\n    EMatch(s, arms) => EMatch(resolve_expr(s), for a in arms {\\n      let (p, ex) = a; (p, resolve_expr(ex))\\n    }),\\n    EHandle(body, arms) => EHandle(resolve_expr(body), for a in arms {\\n      let (p, ex) = a; (p, resolve_expr(ex))\\n    }),\\n    EWhile(c, b) => EWhile(resolve_expr(c), resolve_expr(b)),\\n    ELoop(params, body) => ELoop(for param in params {\\n      let (name, init) = param; (name, resolve_expr(init))\\n    }, resolve_expr(body)),\\n    EForIn(vn, idx, it, b) => EForIn(vn, idx, resolve_expr(it), resolve_expr(b)),\\n    ECall(callee, args, off) => ECall(resolve_expr(callee), resolve_arr(args), off),\\n    EBinOp(op, l, r) => EBinOp(op, resolve_expr(l), resolve_expr(r)),\\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_expr(inner)),\\n    EFn(a, b, params, ret, eff, body) => EFn(a, b, params, ret, eff, resolve_expr(body)),\\n    EDot(inner, field, off) => EDot(resolve_expr(inner), field, off),\\n    EThrow(inner) => EThrow(resolve_expr(inner)),\\n    EReturn(inner) => EReturn(resolve_expr(inner)),\\n    EBreak(opt) => match opt {\\n      None => e,\\n      Some(v) => EBreak(Some(resolve_expr(v)))\\n    },\\n    EContinue(args) => EContinue(resolve_arr(args)),\\n    ELabeledArg(n, m, v) => ELabeledArg(n, m, resolve_expr(v)),\\n    ESpread(inner) => ESpread(resolve_expr(inner))\\n  }\\n}\\n\\nlet resolve_stmt: (Stmt) -> Stmt with { Error } = (s) -> {\\n  match s {\\n    SLet(exp, is_rec, name, ty, val) => SLet(exp, is_rec, name, ty, resolve_expr(val)),\\n    SLetMut(name, ty, val) => SLetMut(name, ty, resolve_expr(val)),\\n    STest(name, body) => STest(name, resolve_expr(body)),\\n    SBench(name, body) => SBench(name, resolve_expr(body)),\\n    SExpr(e) => SExpr(resolve_expr(e)),\\n    _ => s\\n  }\\n}\\n\\nexport let resolve_interp_expr: (Expr) -> Expr with { Error } = (e) -> {\\n  resolve_expr(e)\\n}\\n\\nexport let resolve_interp_stmts: (Array[Stmt]) -> Array[Stmt] with { Error } = (stmts) -> {\\n  for s in stmts {\\n    resolve_stmt(s)\\n  }\\n}\\n\\n\\n\\n\\nlet join: (Array[String], String) -> String = (arr, sep) -> {\\n  let len = Array::length(arr)\\n  if len == 0 {\\n    \\\"\\\"\\n  } else {\\n    let b = ArrayBuilder::new()\\n    let mut i = 0\\n    while i < len {\\n      if i > 0 {\\n        ArrayBuilder::push(b, sep)\\n      }\\n      ArrayBuilder::push(b, Array::get(arr, i))\\n      i = i + 1\\n    }\\n    String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n  }\\n}\\n\\nlet escape_string: (String) -> String = (s) -> {\\n  let len = String::length(s)\\n  let b = ArrayBuilder::new()\\n  let push_chunk: (Int, Int) -> Unit = (start, end) -> {\\n    if end > start {\\n      ArrayBuilder::push(b, s[start: end])\\n    }\\n  }\\n  let mut i = 0\\n  let mut start = 0\\n  while i < len {\\n    let c = String::char_code_at(s, i)\\n    if c == '\\\"' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\\\\\\\\"\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == '\\\\\\\\' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\\\\\\\\\\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == '\\\\n' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\n\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == '\\\\t' {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\t\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == 13 {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\r\\\")\\n      i = i + 1\\n      start = i\\n    } else if c == 0 {\\n      push_chunk(start, i)\\n      ArrayBuilder::push(b, \\\"\\\\\\\\0\\\")\\n      i = i + 1\\n      start = i\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  push_chunk(start, len)\\n  String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n}\\n\\nexport let rec print_pat: (Pat) -> String = (p) -> {\\n  match p {\\n    PWild => \\\"_\\\",\\n    PBind(name) => name,\\n    PInt(n) => __to_string(n),\\n    PString(s) => String::concat(\\\"\\\\\\\"\\\", String::concat(escape_string(s), \\\"\\\\\\\"\\\")),\\n    PBool(b) => if b {\\n      \\\"true\\\"\\n    } else \\\"false\\\",\\n    PCtor(name, args) => if Array::length(args) == 0 {\\n      name\\n    } else {\\n      let parts = for arg in args {\\n        print_pat(arg)\\n      }\\n      String::concat(name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))\\n    },\\n    PTuple(elems) => {\\n      let parts = for elem in elems {\\n        print_pat(elem)\\n      }\\n      String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\"))\\n    },\\n    POr(left, right) => String::concat(print_pat(left), String::concat(\\\" | \\\", print_pat(right))),\\n    PStruct(name, _) => String::concat(name, \\\"::{...}\\\")\\n  }\\n}\\n\\nlet handle_effect_name_from_ctor: (String) -> Option[String] = (name) -> {\\n  let idx = String::last_index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    None\\n  } else {\\n    Some(name[0: idx])\\n  }\\n}\\n\\nlet rec infer_handle_effect_name_from_pat: (Pat) -> Option[String] = (pat) -> {\\n  match pat {\\n    PCtor(name, _) => handle_effect_name_from_ctor(name),\\n    POr(left, right) => match infer_handle_effect_name_from_pat(left) {\\n      Some(name) => Some(name),\\n      None => infer_handle_effect_name_from_pat(right)\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet infer_handle_effect_name: (Array[(Pat, Expr)]) -> String = (arms) -> {\\n  let mut i = 0\\n  let mut effect_name = \\\"Error\\\"\\n  let mut found = false\\n  while i < Array::length(arms) && !found {\\n    let (pat, _) = Array::get(arms, i)\\n    match infer_handle_effect_name_from_pat(pat) {\\n      Some(name) => {\\n        effect_name = name\\n        found = true\\n      },\\n      None => {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  effect_name\\n}\\n\\nlet strip_handle_effect_ctor: (String, String) -> String = (effect_name, ctor_name) -> {\\n  let prefix = String::concat(effect_name, \\\"::\\\")\\n  if String::starts_with(ctor_name, prefix) {\\n    let prefix_len = String::length(prefix)\\n    let ctor_len = String::length(ctor_name)\\n    ctor_name[prefix_len: ctor_len]\\n  } else {\\n    ctor_name\\n  }\\n}\\n\\nlet rec print_handle_pat: (String, Pat) -> String = (effect_name, pat) -> {\\n  match pat {\\n    PCtor(name, args) => {\\n      let short_name = strip_handle_effect_ctor(effect_name, name)\\n      if Array::length(args) == 0 {\\n        short_name\\n      } else {\\n        let parts = for arg in args {\\n          print_pat(arg)\\n        }\\n        String::concat(short_name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))\\n      }\\n    },\\n    POr(left, right) => String::concat(print_handle_pat(effect_name, left), String::concat(\\\" | \\\", print_handle_pat(effect_name, right))),\\n    _ => print_pat(pat)\\n  }\\n}\\n\\nlet map_to_strings: (Array[Expr], (Expr) -> String) -> Array[String] = (exprs, f) -> {\\n  for expr in exprs {\\n    f(expr)\\n  }\\n}\\n\\nexport let rec print_type_expr: (TypeExpr) -> String = (ty) -> {\\n  match ty {\\n    TyName(name) => name,\\n    TyUnit => \\\"()\\\",\\n    TyApp(name, args) => {\\n      let parts = for arg in args {\\n        print_type_expr(arg)\\n      }\\n      String::concat(name, String::concat(\\\"[\\\", String::concat(join(parts, \\\", \\\"), \\\"]\\\")))\\n    },\\n    TyFn(params, ret, effect_name) => {\\n      let parts = for param in params {\\n        print_type_expr(param)\\n      }\\n      let base = String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), String::concat(\\\") -> \\\", print_type_expr(ret))))\\n      match effect_name {\\n        Some(name) => String::concat(base, String::concat(\\\" with { \\\", String::concat(name, \\\" }\\\"))),\\n        None => base\\n      }\\n    },\\n    TyTuple(elems) => {\\n      let parts = for elem in elems {\\n        print_type_expr(elem)\\n      }\\n      String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\"))\\n    }\\n  }\\n}\\n\\nlet print_ctor: (String, Array[TypeExpr]) -> String = (name, args) -> {\\n  if Array::length(args) == 0 {\\n    name\\n  }\\n  else {\\n    let parts = for arg in args {\\n      print_type_expr(arg)\\n    }\\n    String::concat(name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))\\n  }\\n}\\n\\nlet print_fn_type_params: (Array[String], Array[(String, Array[String])]) -> String = (type_params, bounds) -> {\\n  if Array::length(type_params) == 0 {\\n    \\\"\\\"\\n  } else {\\n    let parts = for tp in type_params {\\n      let mut found = Array::slice([\\n        \\\"\\\"\\n      ], 0, 0)\\n      let mut bi = 0\\n      while bi < Array::length(bounds) {\\n        let (bname, blist) = Array::get(bounds, bi)\\n        if bname == tp {\\n          found = blist\\n        }\\n        bi = bi + 1\\n      }\\n      if Array::length(found) == 0 {\\n        tp\\n      } else {\\n        String::concat(tp, String::concat(\\\": \\\", join(found, \\\" + \\\")))\\n      }\\n    }\\n    String::concat(\\\"[\\\", String::concat(join(parts, \\\", \\\"), \\\"]\\\"))\\n  }\\n}\\n\\nexport let rec print_expr: (Expr) -> String = (e) -> {\\n  match e {\\n    EInt(n) => __to_string(n),\\n    EFloat(n) => double_to_string_compiler(n),\\n    EString(s) => String::concat(\\\"\\\\\\\"\\\", String::concat(escape_string(s), \\\"\\\\\\\"\\\")),\\n    EBool(b) => if b {\\n      \\\"true\\\"\\n    } else \\\"false\\\",\\n    EIdent(name, _) => name,\\n    EUnit => \\\"()\\\",\\n    ETuple(elems) => String::concat(\\\"(\\\", String::concat(join(map_to_strings(elems, print_expr), \\\", \\\"), \\\")\\\")),\\n    EArray(elems) => String::concat(\\\"[\\\", String::concat(join(map_to_strings(elems, print_expr), \\\", \\\"), \\\"]\\\")),\\n    ERecord(fields) => {\\n      let parts = for field in fields {\\n        let (name, val) = field\\n        String::concat(name, String::concat(\\\": \\\", print_expr(val)))\\n      }\\n      String::concat(\\\"record { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))\\n    },\\n    EIf(cond, then_e, else_e) => match else_e {\\n      EUnit => String::concat(\\\"if \\\", String::concat(print_expr(cond), String::concat(\\\" { \\\", String::concat(print_expr(then_e), \\\" }\\\")))),\\n      _ => String::concat(\\\"if \\\", String::concat(print_expr(cond), String::concat(\\\" { \\\", String::concat(print_expr(then_e), String::concat(\\\" } else { \\\", String::concat(print_expr(else_e), \\\" }\\\"))))))\\n    },\\n    ELet(name, val, body) => String::concat(\\\"{ let \\\", String::concat(name, String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    ELetRec(name, val, body) => String::concat(\\\"{ let rec \\\", String::concat(name, String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    ELetMut(name, val, body) => String::concat(\\\"{ let mut \\\", String::concat(name, String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    EAssign(name, val, body) => String::concat(\\\"{ \\\", String::concat(name, String::concat(\\\" = \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))),\\n    EAssignOp(name, op, val, body) => String::concat(\\\"{ \\\", String::concat(name, String::concat(\\\" \\\", String::concat(op, String::concat(\\\"= \\\", String::concat(print_expr(val), String::concat(\\\"; \\\", String::concat(print_expr(body), \\\" }\\\")))))))),\\n    ESeq(a, b) => String::concat(\\\"{ \\\", String::concat(print_expr(a), String::concat(\\\"; \\\", String::concat(print_expr(b), \\\" }\\\")))),\\n    EMatch(scrutinee, arms) => {\\n      let parts = for arm in arms {\\n        let (pat, expr) = arm\\n        String::concat(print_pat(pat), String::concat(\\\" => \\\", print_expr(expr)))\\n      }\\n      String::concat(\\\"match \\\", String::concat(print_expr(scrutinee), String::concat(\\\" { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))))\\n    },\\n    EHandle(body, arms) => {\\n      let effect_name = infer_handle_effect_name(arms)\\n      let parts = for arm in arms {\\n        let (pat, expr) = arm\\n        String::concat(print_handle_pat(effect_name, pat), String::concat(\\\" => \\\", print_expr(expr)))\\n      }\\n      String::concat(\\\"handle { \\\", String::concat(print_expr(body), String::concat(\\\" } with \\\", String::concat(effect_name, String::concat(\\\" { \\\", String::concat(join(parts, \\\"; \\\"), \\\" }\\\"))))))\\n    },\\n    EWhile(cond, body) => String::concat(\\\"while \\\", String::concat(print_expr(cond), String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))),\\n    ELoop(params, body) => {\\n      let parts = for param in params {\\n        let (name, init) = param\\n        String::concat(name, String::concat(\\\" = \\\", print_expr(init)))\\n      }\\n      String::concat(\\\"loop (\\\", String::concat(join(parts, \\\", \\\"), String::concat(\\\") { \\\", String::concat(print_expr(body), \\\" }\\\"))))\\n    },\\n    EForIn(value_name, index_name, iterable, body) => {\\n      let binding = match index_name {\\n        Some(index_name) => String::concat(index_name, String::concat(\\\", \\\", value_name)),\\n        None => value_name\\n      }\\n      String::concat(\\\"for \\\", String::concat(binding, String::concat(\\\" in \\\", String::concat(print_expr(iterable), String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\"))))))\\n    },\\n    ECall(callee, args, _) => match callee {\\n      EIdent(\\\"perform\\\", _) => if Array::length(args) == 1 {\\n        String::concat(\\\"perform \\\", print_expr(Array::get(args, 0)))\\n      } else {\\n        String::concat(print_expr(callee), String::concat(\\\"(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")))\\n      },\\n      _ => String::concat(print_expr(callee), String::concat(\\\"(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")))\\n    },\\n    EBinOp(op, left, right) => String::concat(\\\"(\\\", String::concat(print_expr(left), String::concat(\\\" \\\", String::concat(op, String::concat(\\\" \\\", String::concat(print_expr(right), \\\")\\\")))))),\\n    EUnaryOp(op, expr) => String::concat(\\\"(\\\", String::concat(op, String::concat(print_expr(expr), \\\")\\\"))),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => {\\n      let tp_str = print_fn_type_params(type_params, bounds)\\n      let parts = for param in params {\\n        let (name, ty_opt) = param\\n        match ty_opt {\\n          Some(ty) => String::concat(name, String::concat(\\\": \\\", print_type_expr(ty))),\\n          None => name\\n        }\\n      }\\n      let ret_str = match ret_ty {\\n        Some(rt) => {\\n          let eff_str = match effect {\\n            Some(e) => String::concat(\\\" with { \\\", String::concat(e, \\\" }\\\")),\\n            None => \\\"\\\"\\n          }\\n          String::concat(\\\") -> \\\", String::concat(print_type_expr(rt), String::concat(eff_str, String::concat(\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))))\\n        },\\n        None => String::concat(\\\") -> { \\\", String::concat(print_expr(body), \\\" }\\\"))\\n      }\\n      String::concat(tp_str, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), ret_str)))\\n    },\\n    EDot(expr, field, _) => String::concat(print_expr(expr), String::concat(\\\".\\\", field)),\\n    EThrow(e) => String::concat(\\\"throw(\\\", String::concat(print_expr(e), \\\")\\\")),\\n    EReturn(e) => String::concat(\\\"return \\\", print_expr(e)),\\n    EBreak(opt) => match opt {\\n      None => \\\"break\\\",\\n      Some(v) => String::concat(\\\"break \\\", print_expr(v))\\n    },\\n    EContinue(args) => if Array::length(args) == 0 {\\n      \\\"continue\\\"\\n    } else String::concat(\\\"continue(\\\", String::concat(join(map_to_strings(args, print_expr), \\\", \\\"), \\\")\\\")),\\n    ELabeledArg(name, _modifier, val) => String::concat(name, String::concat(\\\"=\\\", print_expr(val))),\\n    EMap(fields) => if Array::length(fields) == 0 {\\n      \\\"map {}\\\"\\n    } else {\\n      let parts = for field in fields {\\n        let (k, v) = field\\n        String::concat(k, String::concat(\\\": \\\", print_expr(v)))\\n      }\\n      String::concat(\\\"map { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))\\n    },\\n    ESpread(inner) => String::concat(\\\"...\\\", print_expr(inner)),\\n    EStringInterp(parts) => String::concat(\\\"\\\\\\\"\\\", String::concat(join(parts, \\\"\\\"), \\\"\\\\\\\"\\\"))\\n  }\\n}\\n\\nlet print_annotated_let_value: (Option[TypeExpr], Expr) -> String = (ty_opt, val) -> {\\n  match ty_opt {\\n    Some(TyFn(_, _, _)) => match val {\\n      EFn(type_params, bounds, params, _, _, body) => {\\n        let tp_str = print_fn_type_params(type_params, bounds)\\n        let parts = for param in params {\\n          let (name, _) = param\\n          name\\n        }\\n        String::concat(\\n          tp_str,\\n          String::concat(\\n            \\\"(\\\",\\n            String::concat(\\n              join(parts, \\\", \\\"),\\n              String::concat(\\\") -> { \\\", String::concat(print_expr(body), \\\" }\\\"))\\n            )\\n          )\\n        )\\n      },\\n      _ => print_expr(val)\\n    },\\n    _ => print_expr(val)\\n  }\\n}\\n\\nlet print_ctor_list: (Array[(String, Array[TypeExpr])]) -> String = (ctors) -> {\\n  let parts = for ctor in ctors {\\n    let (name, args) = ctor\\n    print_ctor(name, args)\\n  }\\n  join(parts, \\\"; \\\")\\n}\\n\\nexport let rec print_stmt: (Stmt) -> String = (s) -> {\\n  let prefix: (Bool) -> String = (exported) -> {\\n    if exported {\\n      \\\"export \\\"\\n    } else \\\"\\\"\\n  }\\n  match s {\\n    SLet(exported, is_rec, name, ty_opt, val) => {\\n      let p = prefix(exported)\\n      let r = if is_rec {\\n        \\\"let rec \\\"\\n      } else \\\"let \\\"\\n      let t = match ty_opt {\\n        Some(ty) => String::concat(\\\": \\\", print_type_expr(ty)),\\n        None => \\\"\\\"\\n      }\\n      String::concat(p, String::concat(r, String::concat(name, String::concat(t, String::concat(\\\" = \\\", print_annotated_let_value(ty_opt, val))))))\\n    },\\n    SLetMut(name, ty_opt, val) => {\\n      let t = match ty_opt {\\n        Some(ty) => String::concat(\\\": \\\", print_type_expr(ty)),\\n        None => \\\"\\\"\\n      }\\n      String::concat(\\\"let mut \\\", String::concat(name, String::concat(t, String::concat(\\\" = \\\", print_expr(val)))))\\n    },\\n    SEnum(exported, name, _, ctors, _) => String::concat(prefix(exported), String::concat(\\\"enum \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(print_ctor_list(ctors), \\\" }\\\"))))),\\n    SSuberror(exported, name, ctors) => {\\n      let p = prefix(exported)\\n      if Array::length(ctors) == 1 {\\n        let (ctor_name, ctor_args) = Array::get(ctors, 0)\\n        if ctor_name == name {\\n          let parts = for arg in ctor_args {\\n            print_type_expr(arg)\\n          }\\n          String::concat(p, String::concat(\\\"suberror \\\", String::concat(name, String::concat(\\\"(\\\", String::concat(join(parts, \\\", \\\"), \\\")\\\")))))\\n        }\\n        else String::concat(p, String::concat(\\\"suberror \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(print_ctor_list(ctors), \\\" }\\\")))))\\n      } else String::concat(p, String::concat(\\\"suberror \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(print_ctor_list(ctors), \\\" }\\\")))))\\n    },\\n    SStruct(exported, name, fields, derives, mut_names) => {\\n      let parts = for field in fields {\\n        let (fn1, ty) = field\\n        let mut is_mut = false\\n        let mut mi = 0\\n        while mi < Array::length(mut_names) {\\n          if Array::get(mut_names, mi) == fn1 {\\n            is_mut = true\\n          }\\n          mi = mi + 1\\n        }\\n        let mp = if is_mut {\\n          \\\"mut \\\"\\n        } else {\\n          \\\"\\\"\\n        }\\n        String::concat(mp, String::concat(fn1, String::concat(\\\": \\\", print_type_expr(ty))))\\n      }\\n      let base = String::concat(prefix(exported), String::concat(\\\"struct \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(join(parts, \\\"; \\\"), \\\" }\\\")))))\\n      if Array::length(derives) == 0 {\\n        base\\n      } else {\\n        String::concat(base, String::concat(\\\" derive(\\\", String::concat(join(derives, \\\", \\\"), \\\")\\\")))\\n      }\\n    },\\n    STypeAlias(exported, name, _, ty) => String::concat(prefix(exported), String::concat(\\\"type \\\", String::concat(name, String::concat(\\\" = \\\", print_type_expr(ty))))),\\n    STrait(exported, name, supers, methods, _) => {\\n      let base = String::concat(prefix(exported), String::concat(\\\"trait \\\", name))\\n      let head = if Array::length(supers) == 0 {\\n        base\\n      }\\n      else String::concat(base, String::concat(\\\": \\\", join(supers, \\\" + \\\")))\\n      if Array::length(methods) == 0 {\\n        head\\n      } else {\\n        let method_parts = for m in methods {\\n          let (method_name, params, ret) = m\\n          let params_str = if Array::length(params) > 0 {\\n            String::concat(\\\"(\\\", String::concat(join(for pt in params {\\n              print_type_expr(pt)\\n            }, \\\", \\\"), \\\")\\\"))\\n          } else \\\"\\\"\\n          String::concat(\\\"  \\\", String::concat(method_name, String::concat(params_str, String::concat(\\\" -> \\\", print_type_expr(ret)))))\\n        }\\n        String::concat(head, String::concat(\\\" {\\\\n\\\", String::concat(join(method_parts, \\\";\\\\n\\\"), \\\"\\\\n}\\\")))\\n      }\\n    },\\n    SImpl(tparams, _, trait_name, type_name) => {\\n      let head = if Array::length(tparams) == 0 {\\n        \\\"impl \\\"\\n      } else {\\n        String::concat(\\\"impl [\\\", String::concat(join(tparams, \\\", \\\"), \\\"] \\\"))\\n      }\\n      String::concat(head, String::concat(trait_name, String::concat(\\\" for \\\", type_name)))\\n    },\\n    SExternLet(name, ty) => String::concat(\\\"extern let \\\", String::concat(name, String::concat(\\\": \\\", print_type_expr(ty)))),\\n    SImport(path, items) => {\\n      let parts = for item in items {\\n        let (name, alias) = item\\n        match alias {\\n          Some(a) => String::concat(name, String::concat(\\\" as \\\", a)),\\n          None => name\\n        }\\n      }\\n      String::concat(\\\"import \\\", String::concat(path, String::concat(\\\" { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))))\\n    },\\n    STest(name, body) => String::concat(\\\"test \\\\\\\"\\\", String::concat(name, String::concat(\\\"\\\\\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))),\\n    SBench(name, body) => String::concat(\\\"bench \\\\\\\"\\\", String::concat(name, String::concat(\\\"\\\\\\\" { \\\", String::concat(print_expr(body), \\\" }\\\")))),\\n    SExpr(e) => print_expr(e),\\n    SExport(names) => String::concat(\\\"export { \\\", String::concat(join(names, \\\", \\\"), \\\" }\\\")),\\n    SReExport(path, items) => {\\n      let parts = for item in items {\\n        let (name, alias) = item\\n        match alias {\\n          Some(a) => String::concat(name, String::concat(\\\" as \\\", a)),\\n          None => name\\n        }\\n      }\\n      String::concat(\\\"export \\\", String::concat(path, String::concat(\\\" { \\\", String::concat(join(parts, \\\", \\\"), \\\" }\\\"))))\\n    },\\n    SAliasDecl(alias_name, source_path) => String::concat(\\\"import \\\", String::concat(source_path, String::concat(\\\" @\\\", alias_name))),\\n    SLetPat(pat, expr) => String::concat(\\\"let \\\", String::concat(print_pat(pat), String::concat(\\\" = \\\", print_expr(expr)))),\\n    SModule(exported, name, stmts) => {\\n      let parts = for s in stmts {\\n        print_stmt(s)\\n      }\\n      let p = if exported {\\n        \\\"export \\\"\\n      } else \\\"\\\"\\n      String::concat(p, String::concat(\\\"module \\\", String::concat(name, String::concat(\\\" { \\\", String::concat(join(parts, \\\"\\\\n\\\"), \\\" }\\\")))))\\n    },\\n    SEffectDef(exported, name, type_params, ops) => {\\n      let p = if exported {\\n        \\\"export \\\"\\n      } else \\\"\\\"\\n      let tp = if Array::length(type_params) > 0 {\\n        String::concat(\\\"[\\\", String::concat(join(type_params, \\\", \\\"), \\\"]\\\"))\\n      } else \\\"\\\"\\n      let op_parts = for op in ops {\\n        let (op_name, params, ret) = op\\n        let params_str = if Array::length(params) > 0 {\\n          String::concat(\\\"(\\\", String::concat(join(for pt in params {\\n            print_type_expr(pt)\\n          }, \\\", \\\"), \\\")\\\"))\\n        } else \\\"\\\"\\n        String::concat(\\\"  \\\", String::concat(op_name, String::concat(params_str, String::concat(\\\" -> \\\", print_type_expr(ret)))))\\n      }\\n      String::concat(p, String::concat(\\\"effect \\\", String::concat(name, String::concat(tp, String::concat(\\\" {\\\\n\\\", String::concat(join(op_parts, \\\";\\\\n\\\"), \\\"\\\\n}\\\"))))))\\n    }\\n  }\\n}\\n\\nlet needs_program_separator: (String) -> Bool = (stmt_text) -> {\\n  if String::length(stmt_text) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(stmt_text, 0)\\n    c == '(' || c == '['\\n  }\\n}\\n\\nexport let print_program: (Array[Stmt]) -> String = (stmts) -> {\\n  let len = Array::length(stmts)\\n  let b = ArrayBuilder::new()\\n  let mut i = 0\\n  while i < len {\\n    let stmt_text = print_stmt(Array::get(stmts, i))\\n    if i > 0 {\\n      let sep = if needs_program_separator(stmt_text) {\\n        \\\";\\\\n\\\"\\n      } else \\\"\\\\n\\\"\\n      ArrayBuilder::push(b, sep)\\n    }\\n    ArrayBuilder::push(b, stmt_text)\\n    i = i + 1\\n  }\\n  String::join(ArrayBuilder::freeze(b), \\\"\\\")\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\nexport let version = \\\"0.0.1\\\"\\n\\n\\n\\nlet empty_aliases: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet empty_strings: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet empty_import_refs: () -> Array[(String, String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\n\\nlet string_array_contains: (Array[String], String) -> Bool = (items, target) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    if Array::get(items, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet import_ref_array_contains_local: (Array[(String, String, String)], String) -> Bool = (items, target) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    let (_, _, local) = Array::get(items, i)\\n    if local == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet import_ref_has_other_path_for_original: (Array[(String, String, String)], String, String) -> Bool = (items, raw_path, original) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    let (other_path, other_original, _) = Array::get(items, i)\\n    if other_original == original && other_path != raw_path {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet lookup_alias: (Array[(String, String)], String) -> Option[String] = (aliases, name) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(aliases) {\\n    let (alias, original) = Array::get(aliases, i)\\n    if alias == name {\\n      found = Some(original)\\n      i = Array::length(aliases)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet alias_map_without_name: (Array[(String, String)], String) -> Array[(String, String)] = (aliases, name) -> {\\n  let out = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(aliases) {\\n    let (alias, original) = Array::get(aliases, i)\\n    if alias != name {\\n      Array::push(out, (alias, original))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet alias_map_without_names: (Array[(String, String)], Array[String]) -> Array[(String, String)] = (aliases, names) -> {\\n  let out = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(aliases) {\\n    let (alias, original) = Array::get(aliases, i)\\n    if !string_array_contains(names, alias) {\\n      Array::push(out, (alias, original))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet rec pat_binds_name: (Pat, String) -> Bool = (pat, name) -> {\\n  match pat {\\n    PBind(bound) => bound == name,\\n    PCtor(_, pats) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(pats) && !found {\\n        if pat_binds_name(Array::get(pats, i), name) {\\n          found = true\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    PTuple(pats) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(pats) && !found {\\n        if pat_binds_name(Array::get(pats, i), name) {\\n          found = true\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    POr(left, right) => pat_binds_name(left, name) || pat_binds_name(right, name),\\n    PStruct(_, fields) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(fields) && !found {\\n        let (_, field_pat) = Array::get(fields, i)\\n        if pat_binds_name(field_pat, name) {\\n          found = true\\n        } else {\\n          i = i + 1\\n        }\\n      }\\n      found\\n    },\\n    _ => false\\n  }\\n}\\n\\nlet alias_map_without_pat: (Array[(String, String)], Pat) -> Array[(String, String)] = (aliases, pat) -> {\\n  let out = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(aliases) {\\n    let (alias, original) = Array::get(aliases, i)\\n    if !pat_binds_name(pat, alias) {\\n      Array::push(out, (alias, original))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet param_binds_name: (Array[(String, Option[TypeExpr])], String) -> Bool = (params, name) -> {\\n  let mut found = false\\n  let mut i = 0\\n  while i < Array::length(params) && !found {\\n    let (param_name, _) = Array::get(params, i)\\n    if param_name == name {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet alias_map_without_params: (Array[(String, String)], Array[(String, Option[TypeExpr])]) -> Array[(String, String)] = (aliases, params) -> {\\n  let out = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(aliases) {\\n    let (alias, original) = Array::get(aliases, i)\\n    if !param_binds_name(params, alias) {\\n      Array::push(out, (alias, original))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let rec rewrite_import_alias_expr: (Expr, Array[(String, String)]) -> Expr = (expr, aliases) -> {\\n  match expr {\\n    EIdent(name, _) => match lookup_alias(aliases, name) {\\n      Some(original) => EIdent(original, -1),\\n      None => expr\\n    },\\n    ETuple(items) => ETuple(for item in items {\\n      rewrite_import_alias_expr(item, aliases)\\n    }),\\n    EArray(items) => EArray(for item in items {\\n      rewrite_import_alias_expr(item, aliases)\\n    }),\\n    ERecord(fields) => ERecord(for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_import_alias_expr(value, aliases))\\n    }),\\n    EIf(cond, then_expr, else_expr) => EIf(\\n      rewrite_import_alias_expr(cond, aliases),\\n      rewrite_import_alias_expr(then_expr, aliases),\\n      rewrite_import_alias_expr(else_expr, aliases)\\n    ),\\n    ELet(name, value, body) => ELet(\\n      name,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\\n    ),\\n    ELetRec(name, value, body) => {\\n      let body_aliases = alias_map_without_name(aliases, name)\\n      ELetRec(\\n        name,\\n        rewrite_import_alias_expr(value, body_aliases),\\n        rewrite_import_alias_expr(body, body_aliases)\\n      )\\n    },\\n    ELetMut(name, value, body) => ELetMut(\\n      name,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\\n    ),\\n    EAssign(name, value, body) => EAssign(\\n      name,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, aliases)\\n    ),\\n    EAssignOp(name, op, value, body) => EAssignOp(\\n      name,\\n      op,\\n      rewrite_import_alias_expr(value, aliases),\\n      rewrite_import_alias_expr(body, aliases)\\n    ),\\n    ESeq(left, right) => ESeq(\\n      rewrite_import_alias_expr(left, aliases),\\n      rewrite_import_alias_expr(right, aliases)\\n    ),\\n    EMatch(scrutinee, arms) => EMatch(rewrite_import_alias_expr(scrutinee, aliases), for arm in arms {\\n      let (pat, body) = arm\\n      (pat, rewrite_import_alias_expr(body, alias_map_without_pat(aliases, pat)))\\n    }),\\n    EHandle(body, arms) => EHandle(rewrite_import_alias_expr(body, aliases), for arm in arms {\\n      let (pat, arm_body) = arm\\n      (pat, rewrite_import_alias_expr(arm_body, alias_map_without_pat(aliases, pat)))\\n    }),\\n    EWhile(cond, body) => EWhile(\\n      rewrite_import_alias_expr(cond, aliases),\\n      rewrite_import_alias_expr(body, aliases)\\n    ),\\n    ELoop(params, body) => {\\n      let out_params = for param in params {\\n        let (name, init) = param\\n        (name, rewrite_import_alias_expr(init, aliases))\\n      }\\n      let mut body_aliases = aliases\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, _) = Array::get(params, i)\\n        body_aliases = alias_map_without_name(body_aliases, name)\\n        i = i + 1\\n      }\\n      ELoop(out_params, rewrite_import_alias_expr(body, body_aliases))\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      let body_aliases = match index_name {\\n        Some(index_name) => alias_map_without_name(alias_map_without_name(aliases, name), index_name),\\n        None => alias_map_without_name(aliases, name)\\n      }\\n      EForIn(\\n        name,\\n        index_name,\\n        rewrite_import_alias_expr(iter, aliases),\\n        rewrite_import_alias_expr(body, body_aliases)\\n      )\\n    },\\n    ECall(callee, args, off) => ECall(rewrite_import_alias_expr(callee, aliases), for arg in args {\\n      rewrite_import_alias_expr(arg, aliases)\\n    }, off),\\n    EBinOp(op, left, right) => EBinOp(\\n      op,\\n      rewrite_import_alias_expr(left, aliases),\\n      rewrite_import_alias_expr(right, aliases)\\n    ),\\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_import_alias_expr(value, aliases)),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\\n      type_params,\\n      bounds,\\n      params,\\n      ret_ty,\\n      effect,\\n      rewrite_import_alias_expr(body, alias_map_without_params(aliases, params))\\n    ),\\n    EDot(obj, field, off) => EDot(rewrite_import_alias_expr(obj, aliases), field, off),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_import_alias_expr(body, aliases)),\\n    EThrow(value) => EThrow(rewrite_import_alias_expr(value, aliases)),\\n    EReturn(value) => EReturn(rewrite_import_alias_expr(value, aliases)),\\n    EBreak(value) => match value {\\n      Some(value) => EBreak(Some(rewrite_import_alias_expr(value, aliases))),\\n      None => expr\\n    },\\n    EContinue(values) => EContinue(for value in values {\\n      rewrite_import_alias_expr(value, aliases)\\n    }),\\n    EMap(fields) => EMap(for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_import_alias_expr(value, aliases))\\n    }),\\n    ESpread(value) => ESpread(rewrite_import_alias_expr(value, aliases)),\\n    _ => expr\\n  }\\n}\\n\\nexport let collect_import_aliases: (Array[Stmt]) -> Array[(String, String)] = (stmts) -> {\\n  let aliases = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(_, items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let (original, alias_opt) = Array::get(items, j)\\n          match alias_opt {\\n            Some(alias) => if alias != original {\\n              Array::push(aliases, (alias, original))\\n            },\\n            None => ()\\n          }\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  aliases\\n}\\n\\nlet collect_import_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {\\n  let refs = empty_import_refs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let (original, alias_opt) = Array::get(items, j)\\n          let local = match alias_opt {\\n            Some(alias) => alias,\\n            None => original\\n          }\\n          Array::push(refs, (raw_path, original, local))\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  refs\\n}\\n\\nexport let collect_import_alias_collision_refs: (Array[Stmt]) -> Array[(String, String, String)] = (stmts) -> {\\n  let refs = collect_import_refs(stmts)\\n  let out = empty_import_refs()\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (raw_path, original, local) = Array::get(refs, i)\\n    if import_ref_has_other_path_for_original(refs, raw_path, original) && !import_ref_array_contains_local(out, local) {\\n      Array::push(out, (raw_path, original, local))\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let collect_import_alias_collision_locals: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let refs = collect_import_alias_collision_refs(stmts)\\n  let out = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (_, _, local) = Array::get(refs, i)\\n    if !string_array_contains(out, local) {\\n      Array::push(out, local)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let rec rewrite_import_alias_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, aliases) -> {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, body) => SLet(\\n      exported,\\n      is_rec,\\n      name,\\n      ty,\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\\n    ),\\n    SLetMut(name, ty, body) => SLetMut(\\n      name,\\n      ty,\\n      rewrite_import_alias_expr(body, alias_map_without_name(aliases, name))\\n    ),\\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, aliases)),\\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, aliases)),\\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, aliases)),\\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, aliases)),\\n    SModule(exported, name, stmts) => {\\n      let module_aliases = collect_import_aliases(stmts)\\n      SModule(exported, name, for inner_stmt in stmts {\\n        rewrite_import_alias_stmt(inner_stmt, module_aliases)\\n      })\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nexport let rec stmts_have_import_deep: (Array[Stmt]) -> Bool = (stmts) -> {\\n  let rec stmt_has_import_deep: (Stmt) -> Bool = (stmt) -> {\\n    match stmt {\\n      SImport(_, _) => true,\\n      SModule(_, _, inner_stmts) => stmts_have_import_deep(inner_stmts),\\n      _ => false\\n    }\\n  }\\n  let mut found = false\\n  let mut i = 0\\n  while i < Array::length(stmts) && !found {\\n    if stmt_has_import_deep(Array::get(stmts, i)) {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nexport let append_non_import_stmts_without_alias_rewrite: (Array[Stmt], Array[Stmt]) -> Unit = (merged, stmts) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SImport(_, _) => (),\\n      SReExport(_, _) => (),\\n      SAliasDecl(_, _) => (),\\n      _ => Array::push(merged, stmt)\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport let append_import_alias_rewritten_non_import_stmts_skipping: (Array[Stmt], Array[Stmt], Array[String]) -> Unit = (merged, stmts, skipped_locals) -> {\\n  let aliases = alias_map_without_names(collect_import_aliases(stmts), skipped_locals)\\n  let should_rewrite = Array::length(aliases) > 0\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    match stmt {\\n      SImport(_, _) => (),\\n      SReExport(_, _) => (),\\n      SAliasDecl(_, _) => (),\\n      SModule(_, _, _) => Array::push(merged, rewrite_import_alias_stmt(stmt, aliases)),\\n      _ => if should_rewrite {\\n        Array::push(merged, rewrite_import_alias_stmt(stmt, aliases))\\n      } else {\\n        Array::push(merged, stmt)\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\n\\nexport let append_import_alias_rewritten_non_import_stmts: (Array[Stmt], Array[Stmt]) -> Unit = (merged, stmts) -> {\\n  append_import_alias_rewritten_non_import_stmts_skipping(merged, stmts, empty_strings())\\n}\\n\\nexport let rewrite_imported_value_stmt_to_local: (Stmt, String, String) -> Option[Stmt] = (stmt, original, local) -> {\\n  let aliases = Array::slice([\\n    (original, local)\\n  ], 0, 1)\\n  let rewrite_value: (Expr) -> Expr = (expr) -> {\\n    if original == local {\\n      expr\\n    } else {\\n      rewrite_import_alias_expr(expr, aliases)\\n    }\\n  }\\n  match stmt {\\n    SLet(_, is_rec, name, ty, body) => if name == original {\\n      Some(SLet(false, is_rec, local, ty, rewrite_value(body)))\\n    } else {\\n      None\\n    },\\n    SLetMut(name, ty, body) => if name == original {\\n      Some(SLetMut(local, ty, rewrite_value(body)))\\n    } else {\\n      None\\n    },\\n    _ => None\\n  }\\n}\\n\\nlet sanitize_namespace_char: (Int) -> String = (code) -> {\\n  if (code >= 'a' && code <= 'z') || (code >= 'A' && code <= 'Z') || (code >= '0' && code <= '9') || code == '_' {\\n    String::from_char_code(code)\\n  } else {\\n    \\\"_\\\"\\n  }\\n}\\n\\nlet sanitize_namespace_path: (String) -> String = (path) -> {\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < String::length(path) {\\n    StringBuilder::push(out, sanitize_namespace_char(String::char_code_at(path, i)))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(out)\\n}\\n\\nlet namespace_private_name: (String, String) -> String = (path, name) -> {\\n  String::concat(name, String::concat(\\\"_dep_\\\", sanitize_namespace_path(path)))\\n}\\n\\nlet namespace_private_name_with_suffix: (String, String) -> String = (namespace_suffix, name) -> {\\n  String::concat(name, String::concat(\\\"_dep_\\\", namespace_suffix))\\n}\\n\\nlet namespace_private_name_lazy: (String, String, Array[String]) -> String = (path, name, suffix_box) -> {\\n  let current = Array::get(suffix_box, 0)\\n  let suffix = if String::length(current) == 0 {\\n    let sanitized = sanitize_namespace_path(path)\\n    Array::set(suffix_box, 0, sanitized)\\n    sanitized\\n  } else {\\n    current\\n  }\\n  namespace_private_name_with_suffix(suffix, name)\\n}\\n\\nlet collect_exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let names = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(true, _, name, _, _) => if !string_array_contains(names, name) {\\n        Array::push(names, name)\\n      },\\n      SExport(items) => {\\n        let mut j = 0\\n        while j < Array::length(items) {\\n          let name = Array::get(items, j)\\n          if !string_array_contains(names, name) {\\n            Array::push(names, name)\\n          }\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\nlet collect_exported_type_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let names = empty_strings()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SStruct(true, name, _, _, _) => Array::push(names, name),\\n      SEnum(true, name, _, _, _) => Array::push(names, name),\\n      STrait(true, name, _, _, _) => Array::push(names, name),\\n      STypeAlias(true, name, _, _) => Array::push(names, name),\\n      SSuberror(true, name, _) => Array::push(names, name),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\nlet qualified_method_of_exported_type: (String, Array[String]) -> Bool = (name, exported_types) -> {\\n  let idx = String::index_of(name, \\\"::\\\")\\n  if idx < 0 {\\n    false\\n  } else {\\n    let head = String::substring(name, 0, idx)\\n    string_array_contains(exported_types, head)\\n  }\\n}\\n\\nlet collect_private_value_renames: (String, Array[Stmt], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, namespace_suffix_box, exported) -> {\\n  let renames = empty_aliases()\\n  let exported_types = collect_exported_type_names(stmts)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(false, _, name, _, _) => if !string_array_contains(exported, name) && !qualified_method_of_exported_type(name, exported_types) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      SLetMut(name, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  renames\\n}\\n\\nlet rec rewrite_private_type_expr: (TypeExpr, Array[(String, String)]) -> TypeExpr = (ty, renames) -> {\\n  match ty {\\n    TyName(name) => match lookup_alias(renames, name) {\\n      Some(renamed) => TyName(renamed),\\n      None => ty\\n    },\\n    TyApp(name, args) => {\\n      let next_name = match lookup_alias(renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      TyApp(next_name, for arg in args {\\n        rewrite_private_type_expr(arg, renames)\\n      })\\n    },\\n    TyFn(params, ret, effect_name) => TyFn(\\n      for param in params {\\n        rewrite_private_type_expr(param, renames)\\n      },\\n      rewrite_private_type_expr(ret, renames),\\n      effect_name\\n    ),\\n    TyTuple(items) => TyTuple(for item in items {\\n      rewrite_private_type_expr(item, renames)\\n    }),\\n    TyUnit => ty\\n  }\\n}\\n\\nlet rewrite_private_type_opt: (Option[TypeExpr], Array[(String, String)]) -> Option[TypeExpr] = (ty, renames) -> {\\n  match ty {\\n    Some(inner) => Some(rewrite_private_type_expr(inner, renames)),\\n    None => None\\n  }\\n}\\n\\nlet rewrite_private_params: (Array[(String, Option[TypeExpr])], Array[(String, String)]) -> Array[(String, Option[TypeExpr])] = (params, type_renames) -> {\\n  for param in params {\\n    let (name, ty) = param\\n    (name, rewrite_private_type_opt(ty, type_renames))\\n  }\\n}\\n\\nlet rec rewrite_private_type_ctor_pat: (Pat, Array[(String, String)], Array[(String, String)]) -> Pat = (pat, type_renames, ctor_renames) -> {\\n  match pat {\\n    PCtor(name, pats) => {\\n      let next_name = match lookup_alias(ctor_renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      PCtor(next_name, for item in pats {\\n        rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\\n      })\\n    },\\n    PTuple(pats) => PTuple(for item in pats {\\n      rewrite_private_type_ctor_pat(item, type_renames, ctor_renames)\\n    }),\\n    POr(left, right) => POr(\\n      rewrite_private_type_ctor_pat(left, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_pat(right, type_renames, ctor_renames)\\n    ),\\n    PStruct(name, fields) => {\\n      let next_name = match lookup_alias(type_renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      PStruct(next_name, for field in fields {\\n        let (field_name, field_pat) = field\\n        (field_name, rewrite_private_type_ctor_pat(field_pat, type_renames, ctor_renames))\\n      })\\n    },\\n    _ => pat\\n  }\\n}\\n\\nlet rec rewrite_private_type_ctor_expr: (Expr, Array[(String, String)], Array[(String, String)]) -> Expr = (expr, type_renames, ctor_renames) -> {\\n  match expr {\\n    EIdent(name, _) => match lookup_alias(ctor_renames, name) {\\n      Some(renamed) => EIdent(renamed, -1),\\n      None => expr\\n    },\\n    ETuple(items) => ETuple(for item in items {\\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\\n    }),\\n    EArray(items) => EArray(for item in items {\\n      rewrite_private_type_ctor_expr(item, type_renames, ctor_renames)\\n    }),\\n    ERecord(fields) => ERecord(for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\\n    }),\\n    EIf(cond, then_expr, else_expr) => EIf(\\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(then_expr, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(else_expr, type_renames, ctor_renames)\\n    ),\\n    ELet(name, value, body) => ELet(\\n      name,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n    ),\\n    ELetRec(name, value, body) => {\\n      let body_ctors = alias_map_without_name(ctor_renames, name)\\n      ELetRec(\\n        name,\\n        rewrite_private_type_ctor_expr(value, type_renames, body_ctors),\\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\\n      )\\n    },\\n    ELetMut(name, value, body) => ELetMut(\\n      name,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n    ),\\n    EAssign(name, value, body) => EAssign(\\n      name,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\\n    ),\\n    EAssignOp(name, op, value, body) => EAssignOp(\\n      name,\\n      op,\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\\n    ),\\n    ESeq(left, right) => ESeq(\\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\\n    ),\\n    EMatch(scrutinee, arms) => EMatch(\\n      rewrite_private_type_ctor_expr(scrutinee, type_renames, ctor_renames),\\n      for arm in arms {\\n        let (pat, body) = arm\\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n        (next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n      }\\n    ),\\n    EHandle(body, arms) => EHandle(\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames),\\n      for arm in arms {\\n        let (pat, arm_body) = arm\\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n        (next_pat, rewrite_private_type_ctor_expr(arm_body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n      }\\n    ),\\n    EWhile(cond, body) => EWhile(\\n      rewrite_private_type_ctor_expr(cond, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)\\n    ),\\n    ELoop(params, body) => {\\n      let out_params = for param in params {\\n        let (name, init) = param\\n        (name, rewrite_private_type_ctor_expr(init, type_renames, ctor_renames))\\n      }\\n      let mut body_ctors = ctor_renames\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, _) = Array::get(params, i)\\n        body_ctors = alias_map_without_name(body_ctors, name)\\n        i = i + 1\\n      }\\n      ELoop(out_params, rewrite_private_type_ctor_expr(body, type_renames, body_ctors))\\n    },\\n    EForIn(name, index_name, iter, body) => {\\n      let body_ctors = match index_name {\\n        Some(index_name) => alias_map_without_name(alias_map_without_name(ctor_renames, name), index_name),\\n        None => alias_map_without_name(ctor_renames, name)\\n      }\\n      EForIn(\\n        name,\\n        index_name,\\n        rewrite_private_type_ctor_expr(iter, type_renames, ctor_renames),\\n        rewrite_private_type_ctor_expr(body, type_renames, body_ctors)\\n      )\\n    },\\n    ECall(callee, args, off) => ECall(\\n      rewrite_private_type_ctor_expr(callee, type_renames, ctor_renames),\\n      for arg in args {\\n        rewrite_private_type_ctor_expr(arg, type_renames, ctor_renames)\\n      },\\n      off\\n    ),\\n    EBinOp(op, left, right) => EBinOp(\\n      op,\\n      rewrite_private_type_ctor_expr(left, type_renames, ctor_renames),\\n      rewrite_private_type_ctor_expr(right, type_renames, ctor_renames)\\n    ),\\n    EUnaryOp(op, value) => EUnaryOp(op, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(\\n      type_params,\\n      bounds,\\n      rewrite_private_params(params, type_renames),\\n      rewrite_private_type_opt(ret_ty, type_renames),\\n      effect,\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_params(ctor_renames, params))\\n    ),\\n    EDot(obj, field, off) => EDot(rewrite_private_type_ctor_expr(obj, type_renames, ctor_renames), field, off),\\n    ELabeledArg(label, name, body) => ELabeledArg(label, name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    EThrow(value) => EThrow(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    EReturn(value) => EReturn(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    EBreak(value) => match value {\\n      Some(value) => EBreak(Some(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))),\\n      None => expr\\n    },\\n    EContinue(values) => EContinue(for value in values {\\n      rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)\\n    }),\\n    EMap(fields) => EMap(for field in fields {\\n      let (name, value) = field\\n      (name, rewrite_private_type_ctor_expr(value, type_renames, ctor_renames))\\n    }),\\n    ESpread(value) => ESpread(rewrite_private_type_ctor_expr(value, type_renames, ctor_renames)),\\n    _ => expr\\n  }\\n}\\n\\nlet collect_private_type_renames: (String, Array[Stmt], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, namespace_suffix_box, exported) -> {\\n  let renames = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEnum(false, name, _, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      SStruct(false, name, _, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      STypeAlias(false, name, _, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      SSuberror(false, name, _) => if !string_array_contains(exported, name) {\\n        Array::push(renames, (name, namespace_private_name_lazy(path, name, namespace_suffix_box)))\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  renames\\n}\\n\\nlet collect_private_ctor_renames: (String, Array[Stmt], Array[(String, String)], Array[String], Array[String]) -> Array[(String, String)] = (path, stmts, type_renames, namespace_suffix_box, exported) -> {\\n  let renames = empty_aliases()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEnum(false, type_name, _, ctors, _) => if !string_array_contains(exported, type_name) {\\n        let mut j = 0\\n        while j < Array::length(ctors) {\\n          let (ctor_name, _) = Array::get(ctors, j)\\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\\n          j = j + 1\\n        }\\n      },\\n      SSuberror(false, type_name, ctors) => if !string_array_contains(exported, type_name) {\\n        let mut j = 0\\n        while j < Array::length(ctors) {\\n          let (ctor_name, _) = Array::get(ctors, j)\\n          Array::push(renames, (ctor_name, namespace_private_name_lazy(path, ctor_name, namespace_suffix_box)))\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  type_renames\\n  renames\\n}\\n\\nexport let rec namespace_private_value_stmts: (String, Array[Stmt]) -> Array[Stmt] = (path, stmts) -> {\\n  let namespace_private_type_ctor_stmt_local: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {\\n    match stmt {\\n      SLet(exported, is_rec, name, ty, body) => SLet(\\n        exported,\\n        is_rec,\\n        name,\\n        rewrite_private_type_opt(ty, type_renames),\\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n      ),\\n      SLetMut(name, ty, body) => SLetMut(\\n        name,\\n        rewrite_private_type_opt(ty, type_renames),\\n        rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n      ),\\n      SEnum(exported, name, params, ctors, derives) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        SEnum(exported, next_name, params, for ctor in ctors {\\n          let (ctor_name, args) = ctor\\n          let next_ctor = if exported {\\n            ctor_name\\n          } else {\\n            match lookup_alias(ctor_renames, ctor_name) {\\n              Some(renamed) => renamed,\\n              None => ctor_name\\n            }\\n          }\\n          (next_ctor, for arg in args {\\n            rewrite_private_type_expr(arg, type_renames)\\n          })\\n        }, derives)\\n      },\\n      SSuberror(exported, name, ctors) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        SSuberror(exported, next_name, for ctor in ctors {\\n          let (ctor_name, args) = ctor\\n          let next_ctor = if exported {\\n            ctor_name\\n          } else {\\n            match lookup_alias(ctor_renames, ctor_name) {\\n              Some(renamed) => renamed,\\n              None => ctor_name\\n            }\\n          }\\n          (next_ctor, for arg in args {\\n            rewrite_private_type_expr(arg, type_renames)\\n          })\\n        })\\n      },\\n      SStruct(exported, name, fields, derives, mut_fields) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        SStruct(exported, next_name, for field in fields {\\n          let (field_name, field_ty) = field\\n          (field_name, rewrite_private_type_expr(field_ty, type_renames))\\n        }, derives, mut_fields)\\n      },\\n      STypeAlias(exported, name, params, target) => {\\n        let next_name = if exported {\\n          name\\n        } else {\\n          match lookup_alias(type_renames, name) {\\n            Some(renamed) => renamed,\\n            None => name\\n          }\\n        }\\n        STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\\n      },\\n      SImpl(tparams, bounds, trait_name, target_name) => {\\n        let next_target = match lookup_alias(type_renames, target_name) {\\n          Some(renamed) => renamed,\\n          None => target_name\\n        }\\n        SImpl(tparams, bounds, trait_name, next_target)\\n      },\\n      SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\\n      STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n      SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n      SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n      SLetPat(pat, body) => {\\n        let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n        SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n      },\\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\\n      SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\\n        let (op_name, op_params, ret_ty) = op\\n        (op_name, for param in op_params {\\n          rewrite_private_type_expr(param, type_renames)\\n        }, rewrite_private_type_expr(ret_ty, type_renames))\\n      }),\\n      _ => stmt\\n    }\\n  }\\n  let namespace_private_stmt_local: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {\\n    match stmt {\\n      SLet(exported, is_rec, name, ty, body) => {\\n        let next_name = match lookup_alias(renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n        SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\\n      },\\n      SLetMut(name, ty, body) => {\\n        let next_name = match lookup_alias(renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n        SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\\n      },\\n      STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\\n      SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\\n      SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\\n      SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\\n      SModule(exported, name, body_stmts) => SModule(exported, name, namespace_private_value_stmts(name, body_stmts)),\\n      _ => stmt\\n    }\\n  }\\n  let namespace_suffix_box = [\\\"\\\"]\\n  let exported = collect_exported_value_names(stmts)\\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\\n  let value_renamed = if Array::length(renames) == 0 {\\n    stmts\\n  } else {\\n    for stmt in stmts {\\n      namespace_private_stmt_local(stmt, renames)\\n    }\\n  }\\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\\n    value_renamed\\n  } else {\\n    for stmt in value_renamed {\\n      namespace_private_type_ctor_stmt_local(stmt, type_renames, ctor_renames)\\n    }\\n  }\\n}\\n\\nlet namespace_private_type_ctor_stmt: (Stmt, Array[(String, String)], Array[(String, String)]) -> Stmt = (stmt, type_renames, ctor_renames) -> {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, body) => SLet(\\n      exported,\\n      is_rec,\\n      name,\\n      rewrite_private_type_opt(ty, type_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n    ),\\n    SLetMut(name, ty, body) => SLetMut(\\n      name,\\n      rewrite_private_type_opt(ty, type_renames),\\n      rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_name(ctor_renames, name))\\n    ),\\n    SEnum(exported, name, params, ctors, derives) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      SEnum(exported, next_name, params, for ctor in ctors {\\n        let (ctor_name, args) = ctor\\n        let next_ctor = if exported {\\n          ctor_name\\n        } else {\\n          match lookup_alias(ctor_renames, ctor_name) {\\n            Some(renamed) => renamed,\\n            None => ctor_name\\n          }\\n        }\\n        (next_ctor, for arg in args {\\n          rewrite_private_type_expr(arg, type_renames)\\n        })\\n      }, derives)\\n    },\\n    SSuberror(exported, name, ctors) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      SSuberror(exported, next_name, for ctor in ctors {\\n        let (ctor_name, args) = ctor\\n        let next_ctor = if exported {\\n          ctor_name\\n        } else {\\n          match lookup_alias(ctor_renames, ctor_name) {\\n            Some(renamed) => renamed,\\n            None => ctor_name\\n          }\\n        }\\n        (next_ctor, for arg in args {\\n          rewrite_private_type_expr(arg, type_renames)\\n        })\\n      })\\n    },\\n    SStruct(exported, name, fields, derives, mut_fields) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      SStruct(exported, next_name, for field in fields {\\n        let (field_name, field_ty) = field\\n        (field_name, rewrite_private_type_expr(field_ty, type_renames))\\n      }, derives, mut_fields)\\n    },\\n    STypeAlias(exported, name, params, target) => {\\n      let next_name = if exported {\\n        name\\n      } else {\\n        match lookup_alias(type_renames, name) {\\n          Some(renamed) => renamed,\\n          None => name\\n        }\\n      }\\n      STypeAlias(exported, next_name, params, rewrite_private_type_expr(target, type_renames))\\n    },\\n    SImpl(tparams, bounds, trait_name, target_name) => {\\n      let next_target = match lookup_alias(type_renames, target_name) {\\n        Some(renamed) => renamed,\\n        None => target_name\\n      }\\n      SImpl(tparams, bounds, trait_name, next_target)\\n    },\\n    SExternLet(name, ty) => SExternLet(name, rewrite_private_type_expr(ty, type_renames)),\\n    STest(name, body) => STest(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    SBench(name, body) => SBench(name, rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    SExpr(body) => SExpr(rewrite_private_type_ctor_expr(body, type_renames, ctor_renames)),\\n    SLetPat(pat, body) => {\\n      let next_pat = rewrite_private_type_ctor_pat(pat, type_renames, ctor_renames)\\n      SLetPat(next_pat, rewrite_private_type_ctor_expr(body, type_renames, alias_map_without_pat(ctor_renames, next_pat)))\\n    },\\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\\n    SEffectDef(exported, name, params, ops) => SEffectDef(exported, name, params, for op in ops {\\n      let (op_name, op_params, ret_ty) = op\\n      (op_name, for param in op_params {\\n        rewrite_private_type_expr(param, type_renames)\\n      }, rewrite_private_type_expr(ret_ty, type_renames))\\n    }),\\n    _ => stmt\\n  }\\n}\\n\\nlet namespace_private_stmt: (Stmt, Array[(String, String)]) -> Stmt = (stmt, renames) -> {\\n  match stmt {\\n    SLet(exported, is_rec, name, ty, body) => {\\n      let next_name = match lookup_alias(renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      SLet(exported, is_rec, next_name, ty, rewrite_import_alias_expr(body, renames))\\n    },\\n    SLetMut(name, ty, body) => {\\n      let next_name = match lookup_alias(renames, name) {\\n        Some(renamed) => renamed,\\n        None => name\\n      }\\n      SLetMut(next_name, ty, rewrite_import_alias_expr(body, renames))\\n    },\\n    STest(name, body) => STest(name, rewrite_import_alias_expr(body, renames)),\\n    SBench(name, body) => SBench(name, rewrite_import_alias_expr(body, renames)),\\n    SExpr(body) => SExpr(rewrite_import_alias_expr(body, renames)),\\n    SLetPat(pat, body) => SLetPat(pat, rewrite_import_alias_expr(body, renames)),\\n    SModule(exported, name, stmts) => SModule(exported, name, namespace_private_value_stmts(name, stmts)),\\n    _ => stmt\\n  }\\n}\\n\\nlet namespace_private_value_stmts_legacy_ordered: (String, Array[Stmt]) -> Array[Stmt] = (path, stmts) -> {\\n  let namespace_suffix_box = [\\\"\\\"]\\n  let exported = collect_exported_value_names(stmts)\\n  let renames = collect_private_value_renames(path, stmts, namespace_suffix_box, exported)\\n  let value_renamed = if Array::length(renames) == 0 {\\n    stmts\\n  } else {\\n    for stmt in stmts {\\n      namespace_private_stmt(stmt, renames)\\n    }\\n  }\\n  let type_renames = collect_private_type_renames(path, value_renamed, namespace_suffix_box, exported)\\n  let ctor_renames = collect_private_ctor_renames(path, value_renamed, type_renames, namespace_suffix_box, exported)\\n  if Array::length(type_renames) == 0 && Array::length(ctor_renames) == 0 {\\n    value_renamed\\n  } else {\\n    for stmt in value_renamed {\\n      namespace_private_type_ctor_stmt(stmt, type_renames, ctor_renames)\\n    }\\n  }\\n}\\n\\n\\n\\n\\n\\n\\n\\n\\nlet empty_stmts: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExport([])\\n  ], 0, 0)\\n}\\n\\nlet empty_strs: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\n\\nlet join_module_name: (String, String) -> String = (prefix, name) -> {\\n  if prefix == \\\"\\\" {\\n    name\\n  } else {\\n    String::concat(prefix, String::concat(\\\"::\\\", name))\\n  }\\n}\\n\\nlet rec module_value_aliases: (Array[Stmt], String, Array[(String, String)]) -> Int = (body, prefix, out) -> {\\n  let mut i = 0\\n  while i < Array::length(body) {\\n    match Array::get(body, i) {\\n      SLet(_, _, name, _, _) => {\\n        Array::push(out, (name, join_module_name(prefix, name)))\\n        0\\n      },\\n      SLetMut(name, _, _) => {\\n        Array::push(out, (name, join_module_name(prefix, name)))\\n        0\\n      },\\n      SExternLet(name, _) => {\\n        Array::push(out, (name, join_module_name(prefix, name)))\\n        0\\n      },\\n      SModule(_, inner, inner_body) => {\\n        let _ = module_value_aliases(inner_body, join_module_name(prefix, inner), out)\\n        0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  0\\n}\\n\\nlet rec flatten_module_body: (Array[Stmt], String, Array[(String, String)], Array[Stmt]) -> Int = (body, prefix, aliases, out) -> {\\n  let mut i = 0\\n  while i < Array::length(body) {\\n    match Array::get(body, i) {\\n      SLet(exp, is_rec, name, ty, b) => {\\n        Array::push(out, SLet(exp, is_rec, join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\\n        0\\n      },\\n      SLetMut(name, ty, b) => {\\n        Array::push(out, SLetMut(join_module_name(prefix, name), ty, rewrite_import_alias_expr(b, aliases)))\\n        0\\n      },\\n      SExternLet(name, ty) => {\\n        Array::push(out, SExternLet(join_module_name(prefix, name), ty))\\n        0\\n      },\\n      SModule(_, inner, inner_body) => {\\n        let _ = flatten_module_body(inner_body, join_module_name(prefix, inner), aliases, out)\\n        0\\n      },\\n      other => {\\n        Array::push(out, other)\\n        0\\n      }\\n    }\\n    i = i + 1\\n  }\\n  0\\n}\\n\\nlet is_module_stmt: (Stmt) -> Bool = (stmt) -> {\\n  match stmt {\\n    SModule(_, _, _) => true,\\n    _ => false\\n  }\\n}\\n\\n\\nlet exported_value_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let roots = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(exp, _, name, _, _) => if exp || String::contains(name, \\\"::\\\") {\\n        Array::push(roots, name)\\n      },\\n      SLetMut(name, _, _) => if String::contains(name, \\\"::\\\") {\\n        Array::push(roots, name)\\n      },\\n      SExport(names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          Array::push(roots, Array::get(names, j))\\n          j = j + 1\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  roots\\n}\\n\\nlet aggregate_export_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let names = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SExport(exported) => {\\n        let mut j = 0\\n        while j < Array::length(exported) {\\n          Array::push(names, Array::get(exported, j))\\n          j = j + 1\\n        }\\n        0\\n      },\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  names\\n}\\n\\nlet str_array_has: (Array[String], String) -> Bool = (arr, target) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) && !found {\\n    if Array::get(arr, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nlet promote_aggregate_exports: (Array[Stmt], Array[String]) -> Array[Stmt] = (stmts, agg) -> {\\n  let result = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let promoted = match stmt {\\n      SLet(exp, is_rec, name, ty, body) => if !exp && str_array_has(agg, name) {\\n        SLet(true, is_rec, name, ty, body)\\n      } else {\\n        stmt\\n      },\\n      _ => stmt\\n    }\\n    Array::push(result, promoted)\\n    i = i + 1\\n  }\\n  result\\n}\\n\\n\\nlet rec collect_type_names_into: (TypeExpr, Array[String]) -> Int = (ty, out) -> {\\n  match ty {\\n    TyName(n) => {\\n      Array::push(out, n)\\n      0\\n    },\\n    TyApp(n, args) => {\\n      Array::push(out, n)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let _ = collect_type_names_into(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    TyFn(params, ret, _) => {\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let _ = collect_type_names_into(Array::get(params, i), out)\\n        i = i + 1\\n      }\\n      let _ = collect_type_names_into(ret, out)\\n      0\\n    },\\n    TyTuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        let _ = collect_type_names_into(Array::get(items, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    TyUnit => 0\\n  }\\n}\\n\\nlet collect_opt_type_into: (Option[TypeExpr], Array[String]) -> Int = (ty_opt, out) -> {\\n  match ty_opt {\\n    Some(ty) => collect_type_names_into(ty, out),\\n    None => 0\\n  }\\n}\\n\\nlet collect_stmt_type_refs_into: (Stmt, Array[String]) -> Int = (stmt, out) -> {\\n  match stmt {\\n    SLet(_, _, _, ty, _) => collect_opt_type_into(ty, out),\\n    SLetMut(_, ty, _) => collect_opt_type_into(ty, out),\\n    SExternLet(_, ty) => collect_type_names_into(ty, out),\\n    STypeAlias(_, _, _, rhs) => collect_type_names_into(rhs, out),\\n    SStruct(_, _, fields, _, _) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fty) = Array::get(fields, i)\\n        let _ = collect_type_names_into(fty, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    SEnum(_, _, _, ctors, _) => {\\n      let mut i = 0\\n      while i < Array::length(ctors) {\\n        let (_, args) = Array::get(ctors, i)\\n        let mut j = 0\\n        while j < Array::length(args) {\\n          let _ = collect_type_names_into(Array::get(args, j), out)\\n          j = j + 1\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    SImpl(_, _, _, type_name) => {\\n      Array::push(out, type_name)\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\n\\nlet drop_unused_type_aliases: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let referenced = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let _ = collect_stmt_type_refs_into(Array::get(stmts, i), referenced)\\n    i = i + 1\\n  }\\n  let result = empty_stmts()\\n  let mut k = 0\\n  while k < Array::length(stmts) {\\n    let stmt = Array::get(stmts, k)\\n    let keep = match stmt {\\n      STypeAlias(exp, name, _, _) => exp || str_array_has(referenced, name),\\n      _ => true\\n    }\\n    if keep {\\n      Array::push(result, stmt)\\n    }\\n    k = k + 1\\n  }\\n  result\\n}\\n\\n\\nlet stmt_section: (Stmt) -> Int = (stmt) -> {\\n  match stmt {\\n    SImport(_, _) => 0,\\n    SReExport(_, _) => 0,\\n    SAliasDecl(_, _) => 0,\\n    SEnum(_, _, _, _, _) => 1,\\n    SSuberror(_, _, _) => 1,\\n    SStruct(_, _, _, _, _) => 1,\\n    STypeAlias(_, _, _, _) => 1,\\n    STrait(_, _, _, _, _) => 1,\\n    SImpl(_, _, _, _) => 1,\\n    SEffectDef(_, _, _, _) => 1,\\n    SExternLet(_, _) => 1,\\n    SLet(_, _, _, _, _) => 2,\\n    SLetMut(_, _, _) => 2,\\n    SLetPat(_, _) => 2,\\n    STest(_, _) => 3,\\n    SBench(_, _) => 3,\\n    SExport(_) => 9,\\n    SExpr(_) => 9,\\n    _ => 9\\n  }\\n}\\n\\nlet section_header: (Int) -> String = (section) -> {\\n  if section == 0 {\\n    \\\"//# Imports\\\"\\n  } else if section == 1 {\\n    \\\"//# Types\\\"\\n  } else if section == 2 {\\n    \\\"//# Functions\\\"\\n  } else {\\n    \\\"//# Tests\\\"\\n  }\\n}\\n\\nlet render_section: (Array[Stmt], Int) -> String = (stmts, section) -> {\\n  let parts = empty_strs()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    if stmt_section(stmt) == section {\\n      Array::push(parts, print_stmt(stmt))\\n    }\\n    i = i + 1\\n  }\\n  if Array::length(parts) == 0 {\\n    \\\"\\\"\\n  } else {\\n    let body = String::join(parts, \\\"\\\\n\\\\n\\\")\\n    String::concat(section_header(section), String::concat(\\\"\\\\n\\\\n\\\", body))\\n  }\\n}\\n\\n\\nlet normalize_empty_type_exprs: () -> Array[TypeExpr] = () -> {\\n  Array::slice([\\n    TyUnit\\n  ], 0, 0)\\n}\\n\\nlet all_params_typed: (Array[(String, Option[TypeExpr])]) -> Bool = (params) -> {\\n  let mut i = 0\\n  let mut ok = true\\n  while i < Array::length(params) {\\n    let (_, ty_opt) = Array::get(params, i)\\n    match ty_opt {\\n      Some(_) => 0,\\n      None => {\\n        ok = false\\n        0\\n      }\\n    }\\n    i = i + 1\\n  }\\n  ok\\n}\\n\\nlet param_type_list: (Array[(String, Option[TypeExpr])]) -> Array[TypeExpr] = (params) -> {\\n  let out = normalize_empty_type_exprs()\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (_, ty_opt) = Array::get(params, i)\\n    match ty_opt {\\n      Some(ty) => Array::push(out, ty),\\n      None => 0\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet strip_param_types: (Array[(String, Option[TypeExpr])]) -> Array[(String, Option[TypeExpr])] = (params) -> {\\n  let out = Array::slice([\\n    (\\\"\\\", None)\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (name, _) = Array::get(params, i)\\n    Array::push(out, (name, None))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet hoist_lambda_let: (Stmt) -> Stmt = (stmt) -> {\\n  match stmt {\\n    SLet(exp, is_rec, name, ty, value) => match ty {\\n      Some(_) => stmt,\\n      None => match value {\\n        EFn(type_params, bounds, params, ret_opt, effect, body) => match ret_opt {\\n          None => stmt,\\n          Some(ret_ty) => if Array::length(type_params) == 0 && all_params_typed(params) {\\n            SLet(exp, is_rec, name, Some(TyFn(param_type_list(params), ret_ty, effect)), EFn(type_params, bounds, strip_param_types(params), None, None, body))\\n          } else {\\n            stmt\\n          }\\n        },\\n        _ => stmt\\n      }\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nlet hoist_lambda_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let out = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::push(out, hoist_lambda_let(Array::get(stmts, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n\\nlet fold_int_binop: (String, Int, Int) -> Option[Int] = (op, a, b) -> {\\n  if op == \\\"+\\\" {\\n    Some(a + b)\\n  } else if op == \\\"-\\\" {\\n    Some(a - b)\\n  } else if op == \\\"*\\\" {\\n    Some(a * b)\\n  } else {\\n    None\\n  }\\n}\\n\\nlet rec fold_expr: (Expr) -> Expr = (expr) -> {\\n  match expr {\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EIdent(_, _) => expr,\\n    EUnit => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(items) => ETuple(for it in items {\\n      fold_expr(it)\\n    }),\\n    EArray(items) => EArray(for it in items {\\n      fold_expr(it)\\n    }),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f\\n      (n, fold_expr(v))\\n    }),\\n    EIf(c, t, e) => EIf(fold_expr(c), fold_expr(t), fold_expr(e)),\\n    ELet(n, v, b) => ELet(n, fold_expr(v), fold_expr(b)),\\n    ELetRec(n, v, b) => ELetRec(n, fold_expr(v), fold_expr(b)),\\n    ELetMut(n, v, b) => ELetMut(n, fold_expr(v), fold_expr(b)),\\n    EAssign(n, v, b) => EAssign(n, fold_expr(v), fold_expr(b)),\\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, fold_expr(v), fold_expr(b)),\\n    ESeq(a, b) => ESeq(fold_expr(a), fold_expr(b)),\\n    EMatch(s, arms) => EMatch(fold_expr(s), for a in arms {\\n      let (p, e) = a\\n      (p, fold_expr(e))\\n    }),\\n    EHandle(s, arms) => EHandle(fold_expr(s), for a in arms {\\n      let (p, e) = a\\n      (p, fold_expr(e))\\n    }),\\n    EWhile(c, b) => EWhile(fold_expr(c), fold_expr(b)),\\n    ELoop(params, b) => ELoop(for pr in params {\\n      let (n, init) = pr\\n      (n, fold_expr(init))\\n    }, fold_expr(b)),\\n    EForIn(n, idx, it, b) => EForIn(n, idx, fold_expr(it), fold_expr(b)),\\n    ECall(callee, args, off) => ECall(fold_expr(callee), for a in args {\\n      fold_expr(a)\\n    }, off),\\n    EBinOp(op, l, r) => {\\n      let fl = fold_expr(l)\\n      let fr = fold_expr(r)\\n      match fl {\\n        EInt(a) => match fr {\\n          EInt(b) => match fold_int_binop(op, a, b) {\\n            Some(v) => EInt(v),\\n            None => EBinOp(op, fl, fr)\\n          },\\n          _ => EBinOp(op, fl, fr)\\n        },\\n        _ => EBinOp(op, fl, fr)\\n      }\\n    },\\n    EUnaryOp(op, e) => EUnaryOp(op, fold_expr(e)),\\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, fold_expr(body)),\\n    EDot(e, field, off) => EDot(fold_expr(e), field, off),\\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, fold_expr(v)),\\n    EThrow(e) => EThrow(fold_expr(e)),\\n    EReturn(e) => EReturn(fold_expr(e)),\\n    EBreak(opt) => match opt {\\n      Some(v) => EBreak(Some(fold_expr(v))),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => EContinue(for a in args {\\n      fold_expr(a)\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (k, v) = f\\n      (k, fold_expr(v))\\n    }),\\n    ESpread(e) => ESpread(fold_expr(e))\\n  }\\n}\\n\\nlet fresh_shadow_name: (Array[Int], String) -> String = (counter, name) -> {\\n  let n = Array::get(counter, 0)\\n  Array::set(counter, 0, n + 1)\\n  String::concat(String::concat(\\\"__shadow_\\\", __to_string(n)), String::concat(\\\"_\\\", name))\\n}\\n\\nlet uq_lookup: (Map[String, String], String) -> String = (env, name) -> {\\n  if Map::has_key(env, name) {\\n    Map::get(env, name)\\n  } else {\\n    name\\n  }\\n}\\n\\nlet uq_seen_contains: (Array[String], String) -> Bool = (seen, name) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(seen) {\\n    if Array::get(seen, i) == name {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet uq_bind_name: (String, Map[String, String], Array[Int], Array[String]) -> (String, Map[String, String]) = (name, env, counter, seen) -> {\\n  let nlen = String::length(name)\\n  let lastc = if nlen > 0 {\\n    String::char_code_at(name, nlen - 1)\\n  } else {\\n    0\\n  }\\n  if lastc == '~' || lastc == '?' {\\n    (name, env)\\n  } else if Map::has_key(env, name) || uq_seen_contains(seen, name) {\\n    let fresh = fresh_shadow_name(counter, name)\\n    (fresh, Map::set(env, name, fresh))\\n  } else {\\n    Array::push(seen, name)\\n    (name, Map::set(env, name, name))\\n  }\\n}\\n\\nlet rec uq_pat_names: (Pat, Array[String]) -> Unit = (pat, out) -> {\\n  match pat {\\n    PBind(name) => Array::push(out, name),\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        uq_pat_names(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        uq_pat_names(Array::get(pats, i), out)\\n        i = i + 1\\n      }\\n    },\\n    POr(l, _r) => uq_pat_names(l, out),\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        uq_pat_names(fp, out)\\n        i = i + 1\\n      }\\n    },\\n    PInt(_) => (),\\n    PString(_) => (),\\n    PBool(_) => (),\\n    PWild => ()\\n  }\\n}\\n\\nlet rec uq_pat_rewrite: (Pat, Map[String, String]) -> Pat = (pat, env) -> {\\n  match pat {\\n    PBind(name) => PBind(uq_lookup(env, name)),\\n    PCtor(name, args) => PCtor(name, for a in args {\\n      uq_pat_rewrite(a, env)\\n    }),\\n    PTuple(pats) => PTuple(for a in pats {\\n      uq_pat_rewrite(a, env)\\n    }),\\n    POr(l, r) => POr(uq_pat_rewrite(l, env), uq_pat_rewrite(r, env)),\\n    PStruct(name, fields) => PStruct(name, for f in fields {\\n      let (fname, fp) = f\\n      (fname, uq_pat_rewrite(fp, env))\\n    }),\\n    _ => pat\\n  }\\n}\\n\\nlet uq_bind_pat: (Pat, Map[String, String], Array[Int], Array[String]) -> (Pat, Map[String, String]) = (pat, env, counter, seen) -> {\\n  let names: Array[String] = [\\n  ]\\n  uq_pat_names(pat, names)\\n  let mut env2 = env\\n  let mut i = 0\\n  while i < Array::length(names) {\\n    let (_, env3) = uq_bind_name(Array::get(names, i), env2, counter, seen)\\n    env2 = env3\\n    i = i + 1\\n  }\\n  (uq_pat_rewrite(pat, env2), env2)\\n}\\n\\nexport let rec uniquify_shadowed_bindings: (Expr, Map[String, String], Array[Int], Array[String]) -> Expr = (expr, env, counter, seen) -> {\\n  match expr {\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EIdent(name, off) => EIdent(uq_lookup(env, name), off),\\n    EUnit => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(items) => ETuple(for it in items {\\n      uniquify_shadowed_bindings(it, env, counter, seen)\\n    }),\\n    EArray(items) => EArray(for it in items {\\n      uniquify_shadowed_bindings(it, env, counter, seen)\\n    }),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f\\n      (n, uniquify_shadowed_bindings(v, env, counter, seen))\\n    }),\\n    EIf(c, t, e) => EIf(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(t, env, counter, seen), uniquify_shadowed_bindings(e, env, counter, seen)),\\n    ELet(n, v, b) => {\\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      ELet(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    ELetRec(n, v, b) => {\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      let v2 = uniquify_shadowed_bindings(v, env2, counter, seen)\\n      ELetRec(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    ELetMut(n, v, b) => {\\n      let v2 = uniquify_shadowed_bindings(v, env, counter, seen)\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      ELetMut(n2, v2, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    EAssign(n, v, b) => EAssign(uq_lookup(env, n), uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    EAssignOp(n, op, v, b) => EAssignOp(uq_lookup(env, n), op, uniquify_shadowed_bindings(v, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    ESeq(a, b) => ESeq(uniquify_shadowed_bindings(a, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    EMatch(s, arms) => EMatch(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\\n      let (p, e) = a\\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\\n    }),\\n    EHandle(s, arms) => EHandle(uniquify_shadowed_bindings(s, env, counter, seen), for a in arms {\\n      let (p, e) = a\\n      let (p2, env2) = uq_bind_pat(p, env, counter, seen)\\n      (p2, uniquify_shadowed_bindings(e, env2, counter, seen))\\n    }),\\n    EWhile(c, b) => EWhile(uniquify_shadowed_bindings(c, env, counter, seen), uniquify_shadowed_bindings(b, env, counter, seen)),\\n    ELoop(params, b) => {\\n      let mut env2 = env\\n      let zipped: Array[(String, Expr)] = [\\n      ]\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pn, init) = Array::get(params, pi)\\n        let init2 = uniquify_shadowed_bindings(init, env, counter, seen)\\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\\n        env2 = envN\\n        Array::push(zipped, (pn2, init2))\\n        pi = pi + 1\\n      }\\n      ELoop(zipped, uniquify_shadowed_bindings(b, env2, counter, seen))\\n    },\\n    EForIn(n, idx, it, b) => {\\n      let it2 = uniquify_shadowed_bindings(it, env, counter, seen)\\n      let (n2, env2) = uq_bind_name(n, env, counter, seen)\\n      let (idx2, env3) = match idx {\\n        Some(iname) => {\\n          let (iname2, envI) = uq_bind_name(iname, env2, counter, seen)\\n          (Some(iname2), envI)\\n        },\\n        None => (None, env2)\\n      }\\n      EForIn(n2, idx2, it2, uniquify_shadowed_bindings(b, env3, counter, seen))\\n    },\\n    ECall(callee, args, off) => ECall(uniquify_shadowed_bindings(callee, env, counter, seen), for a in args {\\n      uniquify_shadowed_bindings(a, env, counter, seen)\\n    }, off),\\n    EBinOp(op, l, r) => EBinOp(op, uniquify_shadowed_bindings(l, env, counter, seen), uniquify_shadowed_bindings(r, env, counter, seen)),\\n    EUnaryOp(op, e) => EUnaryOp(op, uniquify_shadowed_bindings(e, env, counter, seen)),\\n    EFn(tp, bounds, params, ret, eff, body) => {\\n      let mut env2 = env\\n      let params2: Array[(String, Option[TypeExpr])] = [\\n      ]\\n      let mut fi = 0\\n      while fi < Array::length(params) {\\n        let (pn, pty) = Array::get(params, fi)\\n        let (pn2, envN) = uq_bind_name(pn, env2, counter, seen)\\n        env2 = envN\\n        Array::push(params2, (pn2, pty))\\n        fi = fi + 1\\n      }\\n      EFn(tp, bounds, params2, ret, eff, uniquify_shadowed_bindings(body, env2, counter, seen))\\n    },\\n    EDot(e, field, off) => EDot(uniquify_shadowed_bindings(e, env, counter, seen), field, off),\\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, uniquify_shadowed_bindings(v, env, counter, seen)),\\n    EThrow(e) => EThrow(uniquify_shadowed_bindings(e, env, counter, seen)),\\n    EReturn(e) => EReturn(uniquify_shadowed_bindings(e, env, counter, seen)),\\n    EBreak(opt) => match opt {\\n      Some(v) => EBreak(Some(uniquify_shadowed_bindings(v, env, counter, seen))),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => EContinue(for a in args {\\n      uniquify_shadowed_bindings(a, env, counter, seen)\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (k, v) = f\\n      (k, uniquify_shadowed_bindings(v, env, counter, seen))\\n    }),\\n    ESpread(e) => ESpread(uniquify_shadowed_bindings(e, env, counter, seen))\\n  }\\n}\\n\\nlet fresh_m_scrut_name: (Array[Int]) -> String = (counter) -> {\\n  let n = Array::get(counter, 0)\\n  Array::set(counter, 0, n + 1)\\n  String::concat(\\\"__m_scrut_\\\", __to_string(n))\\n}\\n\\nexport let rec lift_match_scrutinees: (Expr, Array[Int]) -> Expr = (expr, counter) -> {\\n  match expr {\\n    EInt(_) => expr,\\n    EFloat(_) => expr,\\n    EString(_) => expr,\\n    EBool(_) => expr,\\n    EIdent(_, _) => expr,\\n    EUnit => expr,\\n    EStringInterp(_) => expr,\\n    ETuple(items) => ETuple(for it in items {\\n      lift_match_scrutinees(it, counter)\\n    }),\\n    EArray(items) => EArray(for it in items {\\n      lift_match_scrutinees(it, counter)\\n    }),\\n    ERecord(fields) => ERecord(for f in fields {\\n      let (n, v) = f\\n      (n, lift_match_scrutinees(v, counter))\\n    }),\\n    EIf(c, t, e) => EIf(lift_match_scrutinees(c, counter), lift_match_scrutinees(t, counter), lift_match_scrutinees(e, counter)),\\n    ELet(n, v, b) => ELet(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    ELetRec(n, v, b) => ELetRec(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    ELetMut(n, v, b) => ELetMut(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    EAssign(n, v, b) => EAssign(n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    EAssignOp(op, n, v, b) => EAssignOp(op, n, lift_match_scrutinees(v, counter), lift_match_scrutinees(b, counter)),\\n    ESeq(a, b) => ESeq(lift_match_scrutinees(a, counter), lift_match_scrutinees(b, counter)),\\n    EMatch(s, arms) => {\\n      let lifted_arms = for a in arms {\\n        let (p, e) = a\\n        (p, lift_match_scrutinees(e, counter))\\n      }\\n      let ls = lift_match_scrutinees(s, counter)\\n      match ls {\\n        EIdent(_, _) => EMatch(ls, lifted_arms),\\n        _ => {\\n          let fresh = fresh_m_scrut_name(counter)\\n          ELet(fresh, ls, EMatch(EIdent(fresh, -1), lifted_arms))\\n        }\\n      }\\n    },\\n    EHandle(s, arms) => EHandle(lift_match_scrutinees(s, counter), for a in arms {\\n      let (p, e) = a\\n      (p, lift_match_scrutinees(e, counter))\\n    }),\\n    EWhile(c, b) => EWhile(lift_match_scrutinees(c, counter), lift_match_scrutinees(b, counter)),\\n    ELoop(params, b) => ELoop(for pr in params {\\n      let (n, init) = pr\\n      (n, lift_match_scrutinees(init, counter))\\n    }, lift_match_scrutinees(b, counter)),\\n    EForIn(n, idx, it, b) => EForIn(n, idx, lift_match_scrutinees(it, counter), lift_match_scrutinees(b, counter)),\\n    ECall(callee, args, off) => ECall(lift_match_scrutinees(callee, counter), for a in args {\\n      lift_match_scrutinees(a, counter)\\n    }, off),\\n    EBinOp(op, l, r) => EBinOp(op, lift_match_scrutinees(l, counter), lift_match_scrutinees(r, counter)),\\n    EUnaryOp(op, e) => EUnaryOp(op, lift_match_scrutinees(e, counter)),\\n    EFn(tp, bounds, params, ret, eff, body) => EFn(tp, bounds, params, ret, eff, lift_match_scrutinees(body, counter)),\\n    EDot(e, field, off) => EDot(lift_match_scrutinees(e, counter), field, off),\\n    ELabeledArg(label, modifier, v) => ELabeledArg(label, modifier, lift_match_scrutinees(v, counter)),\\n    EThrow(e) => EThrow(lift_match_scrutinees(e, counter)),\\n    EReturn(e) => EReturn(lift_match_scrutinees(e, counter)),\\n    EBreak(opt) => match opt {\\n      Some(v) => EBreak(Some(lift_match_scrutinees(v, counter))),\\n      None => EBreak(None)\\n    },\\n    EContinue(args) => EContinue(for a in args {\\n      lift_match_scrutinees(a, counter)\\n    }),\\n    EMap(fields) => EMap(for f in fields {\\n      let (k, v) = f\\n      (k, lift_match_scrutinees(v, counter))\\n    }),\\n    ESpread(e) => ESpread(lift_match_scrutinees(e, counter))\\n  }\\n}\\n\\nlet fold_stmt: (Stmt) -> Stmt = (stmt) -> {\\n  match stmt {\\n    SLet(exp, is_rec, name, ty, body) => SLet(exp, is_rec, name, ty, fold_expr(body)),\\n    SLetMut(name, ty, body) => SLetMut(name, ty, fold_expr(body)),\\n    STest(n, body) => STest(n, fold_expr(body)),\\n    SBench(n, body) => SBench(n, fold_expr(body)),\\n    SExpr(e) => SExpr(fold_expr(e)),\\n    SLetPat(p, body) => SLetPat(p, fold_expr(body)),\\n    _ => stmt\\n  }\\n}\\n\\nlet fold_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let out = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::push(out, fold_stmt(Array::get(stmts, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\n\\nlet literal_type: (Expr) -> Option[TypeExpr] = (e) -> {\\n  match e {\\n    EInt(_) => Some(TyName(\\\"Int\\\")),\\n    EBool(_) => Some(TyName(\\\"Bool\\\")),\\n    EString(_) => Some(TyName(\\\"String\\\")),\\n    EFloat(_) => Some(TyName(\\\"Double\\\")),\\n    _ => None\\n  }\\n}\\n\\nlet annotate_literal_let: (Stmt) -> Stmt = (stmt) -> {\\n  match stmt {\\n    SLet(exp, is_rec, name, ty, body) => match ty {\\n      Some(_) => stmt,\\n      None => match literal_type(body) {\\n        Some(t) => SLet(exp, is_rec, name, Some(t), body),\\n        None => stmt\\n      }\\n    },\\n    _ => stmt\\n  }\\n}\\n\\nlet annotate_literal_lets: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let out = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    Array::push(out, annotate_literal_let(Array::get(stmts, i)))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let normalize_stmts: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let nonmods = empty_stmts()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    if !is_module_stmt(stmt) {\\n      Array::push(nonmods, stmt)\\n    }\\n    i = i + 1\\n  }\\n  let result = empty_stmts()\\n  let live_top = dce_stmts(nonmods, exported_value_names(nonmods))\\n  Array::push_all(result, live_top)\\n  let mut m = 0\\n  while m < Array::length(stmts) {\\n    match Array::get(stmts, m) {\\n      SModule(_, name, body) => {\\n        let live_body = dce_stmts(body, exported_value_names(body))\\n        let aliases = Array::slice([\\n          (\\\"\\\", \\\"\\\")\\n        ], 0, 0)\\n        let _ = module_value_aliases(live_body, name, aliases)\\n        let _ = flatten_module_body(live_body, name, aliases, result)\\n        0\\n      },\\n      _ => 0\\n    }\\n    m = m + 1\\n  }\\n  let promoted = promote_aggregate_exports(result, aggregate_export_names(stmts))\\n  hoist_lambda_lets(annotate_literal_lets(fold_stmts(drop_unused_type_aliases(promoted))))\\n}\\n\\nexport let normalize_source: (String) -> String with { Error } = (src) -> {\\n  let toks_cfg = lex(src)\\n  let mut ci = 0\\n  while ci < Array::length(toks_cfg) {\\n    match Array::get(toks_cfg, ci) {\\n      THash => throw(\\\"cannot normalize a source containing #cfg directives\\\"),\\n      _ => ()\\n    }\\n    ci = ci + 1\\n  }\\n  let stmts = parse_program(toks_cfg)\\n  let kept = normalize_stmts(stmts)\\n  let sections = empty_strs()\\n  let mut s = 0\\n  while s <= 3 {\\n    let rendered = render_section(kept, s)\\n    if rendered != \\\"\\\" {\\n      Array::push(sections, rendered)\\n    }\\n    s = s + 1\\n  }\\n  String::concat(String::join(sections, \\\"\\\\n\\\\n\\\"), \\\"\\\\n\\\")\\n}\\n\\n\\n\\nlet op_prefix = 252\\n\\n\\nexport let rec first_offset: (Expr) -> Int = (e) -> {\\n  match e {\\n    EIdent(_, off) => off,\\n    ECall(callee, _, off) => if off >= 0 { off } else { first_offset(callee) },\\n    EDot(base, _, off) => if off >= 0 { off } else { first_offset(base) },\\n    EBinOp(_, lhs, _) => first_offset(lhs),\\n    EUnaryOp(_, inner) => first_offset(inner),\\n    ELet(_, val, _) => first_offset(val),\\n    ELetRec(_, val, _) => first_offset(val),\\n    ELetMut(_, val, _) => first_offset(val),\\n    EAssign(_, val, _) => first_offset(val),\\n    EAssignOp(_, _, val, _) => first_offset(val),\\n    ESeq(first, _) => first_offset(first),\\n    EIf(cond, _, _) => first_offset(cond),\\n    EMatch(scrut, _) => first_offset(scrut),\\n    EThrow(inner) => first_offset(inner),\\n    EReturn(inner) => first_offset(inner),\\n    _ => -1\\n  }\\n}\\n\\nexport let offset_to_line: (Array[Int], Int) -> Int = (nl, off) -> {\\n  let n = Array::length(nl)\\n  let mut i = 0\\n  let mut count = 0\\n  while i < n {\\n    if Array::get(nl, i) < off {\\n      count = count + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  count + 1\\n}\\n\\nexport let build_newline_offsets: (String) -> Array[Int] = (src) -> {\\n  let arr = Array::slice([\\n    0\\n  ], 0, 0)\\n  let n = String::length(src)\\n  let mut i = 0\\n  while i < n {\\n    if String::char_code_at(src, i) == 10 {\\n      Array::push(arr, i)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  arr\\n}\\n\\nexport let get_ebinop_lhs: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EBinOp(_, lhs, _) => lhs,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport let get_ebinop_rhs: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EBinOp(_, _, rhs) => rhs,\\n    _ => throw(\\\"not EBinOp\\\")\\n  }\\n}\\n\\nexport let get_ecall_args: (Expr) -> Array[Expr] with { Error } = (expr) -> {\\n  match expr {\\n    ECall(_, args, _) => args,\\n    _ => throw(\\\"not ECall\\\")\\n  }\\n}\\n\\nexport let get_efn_params: (Expr) -> Array[(String, Option[TypeExpr])] with { Error } = (expr) -> {\\n  match expr {\\n    EFn(_, _, params, _, _, _) => params,\\n    _ => throw(\\\"not EFn\\\")\\n  }\\n}\\n\\nexport let get_eint_value: (Expr) -> Int with { Error } = (expr) -> {\\n  match expr {\\n    EInt(n) => n,\\n    _ => throw(\\\"not EInt\\\")\\n  }\\n}\\n\\nexport let get_eseq_first: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ESeq(first, _) => first,\\n    _ => throw(\\\"not ESeq\\\")\\n  }\\n}\\n\\nexport let get_match_arms: (Expr) -> Array[(Pat, Expr)] with { Error } = (expr) -> {\\n  match expr {\\n    EMatch(_, arms) => arms,\\n    _ => throw(\\\"get_match_arms: not an EMatch\\\")\\n  }\\n}\\n\\nexport let get_pbind_name: (Pat) -> String with { Error } = (p) -> {\\n  match p {\\n    PBind(name) => name,\\n    _ => throw(\\\"get_pbind_name: not a PBind\\\")\\n  }\\n}\\n\\nexport let get_pctor_args: (Pat) -> Array[Pat] with { Error } = (p) -> {\\n  match p {\\n    PCtor(_, args) => args,\\n    _ => throw(\\\"get_pctor_args: not a PCtor\\\")\\n  }\\n}\\n\\nexport let get_pctor_name: (Pat) -> String with { Error } = (p) -> {\\n  match p {\\n    PCtor(name, _) => name,\\n    _ => throw(\\\"get_pctor_name: not a PCtor\\\")\\n  }\\n}\\n\\nexport let get_pint_value: (Pat) -> Int with { Error } = (p) -> {\\n  match p {\\n    PInt(n) => n,\\n    _ => throw(\\\"get_pint_value: not a PInt\\\")\\n  }\\n}\\n\\nexport let get_eassign_val: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EAssign(_, val, _) => val,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport let get_ebool_value: (Expr) -> Bool with { Error } = (expr) -> {\\n  match expr {\\n    EBool(b) => b,\\n    _ => throw(\\\"not EBool\\\")\\n  }\\n}\\n\\nexport let get_eforin_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EForIn(_, _, _, body) => body,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eforin_iter: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EForIn(_, _, iter, _) => iter,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eforin_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EForIn(name, _, _, _) => name,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eforin_index: (Expr) -> Option[String] with { Error } = (expr) -> {\\n  match expr {\\n    EForIn(_, index_name, _, _) => index_name,\\n    _ => throw(\\\"not EForIn\\\")\\n  }\\n}\\n\\nexport let get_eident_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EIdent(name, _) => name,\\n    _ => throw(\\\"not EIdent\\\")\\n  }\\n}\\n\\nexport let get_eletmut_val: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ELetMut(_, val, _) => val,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport let get_eletrec_val: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ELetRec(_, val, _) => val,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport let get_eseq_second: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ESeq(_, second) => second,\\n    _ => throw(\\\"not ESeq\\\")\\n  }\\n}\\n\\nexport let get_ereturn_expr: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EReturn(e) => e,\\n    _ => throw(\\\"not EReturn\\\")\\n  }\\n}\\n\\nexport let get_ethrow_expr: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EThrow(e) => e,\\n    _ => throw(\\\"not EThrow\\\")\\n  }\\n}\\n\\nexport let get_eunaryop_op: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EUnaryOp(op, _) => op,\\n    _ => throw(\\\"not EUnaryOp\\\")\\n  }\\n}\\n\\nexport let get_ewhile_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EWhile(_, body) => body,\\n    _ => throw(\\\"not EWhile\\\")\\n  }\\n}\\n\\nexport let get_ewhile_cond: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EWhile(cond, _) => cond,\\n    _ => throw(\\\"not EWhile\\\")\\n  }\\n}\\n\\nexport let get_pbool_value: (Pat) -> Bool with { Error } = (p) -> {\\n  match p {\\n    PBool(v) => v,\\n    _ => throw(\\\"get_pbool_value: not a PBool\\\")\\n  }\\n}\\n\\nexport let get_ptuple_pats: (Pat) -> Array[Pat] with { Error } = (p) -> {\\n  match p {\\n    PTuple(pats) => pats,\\n    _ => throw(\\\"get_ptuple_pats: not a PTuple\\\")\\n  }\\n}\\n\\nexport let get_slet_export: (Stmt) -> Bool with { Error } = (stmt) -> {\\n  match stmt {\\n    SLet(is_export, _, _, _, _) => is_export,\\n    _ => throw(\\\"not SLet\\\")\\n  }\\n}\\n\\nexport let rec is_catchall_pat: (Pat) -> Bool = (p) -> {\\n  match p {\\n    PWild => true,\\n    PBind(_) => true,\\n    PTuple(pats) => {\\n      let mut i = 0\\n      let mut all_catch = true\\n      while i < Array::length(pats) {\\n        if !is_catchall_pat(Array::get(pats, i)) {\\n          all_catch = false\\n        }\\n        i = i + 1\\n      }\\n      all_catch\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      let mut all_catch = true\\n      while i < Array::length(fields) {\\n        let (_, sp) = Array::get(fields, i)\\n        if !is_catchall_pat(sp) {\\n          all_catch = false\\n        }\\n        i = i + 1\\n      }\\n      all_catch\\n    },\\n    _ => false\\n  }\\n}\\n\\nexport let emit_assignop_op: (Bytes, String) -> Unit with { Error } = (buf, op) -> {\\n  if op == \\\"+\\\" {\\n    emit_i64_add(buf)\\n  }\\n  else if op == \\\"-\\\" {\\n    emit_i64_sub(buf)\\n  }\\n  else if op == \\\"*\\\" {\\n    emit_i64_mul(buf)\\n  }\\n  else if op == \\\"/\\\" {\\n    emit_i64_div_s(buf)\\n  }\\n  else if op == \\\"%\\\" {\\n    emit_i64_rem_s(buf)\\n  }\\n  else {\\n    throw(String::concat(\\\"unsupported assign op: \\\", op))\\n  }\\n}\\n\\nexport let emit_memory_copy: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_prefix)\\n  leb128_encode_u32(buf, 10)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\\nexport let get_earray_elems: (Expr) -> Array[Expr] with { Error } = (expr) -> {\\n  match expr {\\n    EArray(elems) => elems,\\n    _ => throw(\\\"not EArray\\\")\\n  }\\n}\\n\\nexport let get_eassign_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EAssign(_, _, body) => body,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport let get_eassign_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EAssign(name, _, _) => name,\\n    _ => throw(\\\"not EAssign\\\")\\n  }\\n}\\n\\nexport let get_eassignop_op: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EAssignOp(_, op, _, _) => op,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_ecall_callee: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ECall(callee, _, _) => callee,\\n    _ => throw(\\\"not ECall\\\")\\n  }\\n}\\n\\nexport let get_efloat_value: (Expr) -> Double with { Error } = (expr) -> {\\n  match expr {\\n    EFloat(v) => v,\\n    _ => throw(\\\"not EFloat\\\")\\n  }\\n}\\n\\nexport let get_eletmut_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ELetMut(_, _, body) => body,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport let get_eletmut_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    ELetMut(name, _, _) => name,\\n    _ => throw(\\\"not ELetMut\\\")\\n  }\\n}\\n\\nexport let get_eletrec_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    ELetRec(_, _, body) => body,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport let get_eletrec_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    ELetRec(name, _, _) => name,\\n    _ => throw(\\\"not ELetRec\\\")\\n  }\\n}\\n\\nexport let get_etuple_elems: (Expr) -> Array[Expr] with { Error } = (expr) -> {\\n  match expr {\\n    ETuple(elems) => elems,\\n    _ => throw(\\\"get_etuple_elems: not an ETuple\\\")\\n  }\\n}\\n\\nexport let str_table_lookup: (Array[String], String) -> Int with { Error } = (strs, s) -> {\\n  let len = Array::length(strs)\\n  let mut i = 0\\n  let mut found = -1\\n  while i < len {\\n    if Array::get(strs, i) == s {\\n      found = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if found < 0 {\\n    throw(String::concat(\\\"string not in table: \\\", s))\\n  }\\n  found\\n}\\n\\nexport let find_catchall_idx: (Array[(Pat, Expr)]) -> Int = (arms) -> {\\n  let num = Array::length(arms)\\n  let mut idx = 0\\n  let mut result = num\\n  while idx < num {\\n    let (p, _) = Array::get(arms, idx)\\n    if is_catchall_pat(p) {\\n      result = idx\\n      idx = num\\n    } else {\\n      idx = idx + 1\\n    }\\n  }\\n  result\\n}\\n\\nexport let get_eassignop_val: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EAssignOp(_, _, val, _) => val,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_estring_value: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EString(s) => s,\\n    _ => throw(\\\"not EString\\\")\\n  }\\n}\\n\\nexport let get_eunaryop_expr: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EUnaryOp(_, e) => e,\\n    _ => throw(\\\"not EUnaryOp\\\")\\n  }\\n}\\n\\nexport let get_pstring_value: (Pat) -> String with { Error } = (p) -> {\\n  match p {\\n    PString(s) => s,\\n    _ => throw(\\\"get_pstring_value: not a PString\\\")\\n  }\\n}\\n\\nexport let array_contains_str: (Array[String], String) -> Bool = (arr, s) -> {\\n  let len = Array::length(arr)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len {\\n    if Array::get(arr, i) == s {\\n      found = true\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\n\\nexport let get_eassignop_body: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EAssignOp(_, _, _, body) => body,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_eassignop_name: (Expr) -> String with { Error } = (expr) -> {\\n  match expr {\\n    EAssignOp(name, _, _, _) => name,\\n    _ => throw(\\\"not EAssignOp\\\")\\n  }\\n}\\n\\nexport let get_match_scrutinee: (Expr) -> Expr with { Error } = (expr) -> {\\n  match expr {\\n    EMatch(scrutinee, _) => scrutinee,\\n    _ => throw(\\\"get_match_scrutinee: not an EMatch\\\")\\n  }\\n}\\n\\n\\n\\n\\nlet op_i64_extend_i32_u = 173\\n\\n\\nlet common_analysis_fresh_string_array: () -> Array[String] = () -> {\\n  ArrayBuilder::freeze(ArrayBuilder::new())\\n}\\n\\nlet rec collect_strings_pat: (Pat, Array[String]) -> Int = (pat, out) -> {\\n  match pat {\\n    PString(s) => {\\n      let mut pf = false\\n      let mut pi = 0\\n      while pi < Array::length(out) {\\n        if Array::get(out, pi) == s {\\n          pf = true\\n        }\\n        pi = pi + 1\\n      }\\n      if !pf {\\n        Array::push(out, s)\\n      }\\n      0\\n    },\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let _ = collect_strings_pat(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        let _ = collect_strings_pat(Array::get(pats, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, r) => {\\n      let _ = collect_strings_pat(l, out)\\n      let _ = collect_strings_pat(r, out)\\n      0\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        let _ = collect_strings_pat(fp, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport let rec collect_strings_expr: (Expr, Array[String]) -> Int = (expr, out) -> {\\n  match expr {\\n    EString(s) => {\\n      let mut found = false\\n      let mut i = 0\\n      while i < Array::length(out) {\\n        if Array::get(out, i) == s {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      if !found {\\n        Array::push(out, s)\\n      }\\n      0\\n    },\\n    EBinOp(_, lhs, rhs) => {\\n      collect_strings_expr(lhs, out)\\n      collect_strings_expr(rhs, out)\\n    },\\n    EUnaryOp(_, operand) => collect_strings_expr(operand, out),\\n    EIf(cond, then_e, else_e) => {\\n      collect_strings_expr(cond, out)\\n      collect_strings_expr(then_e, out)\\n      collect_strings_expr(else_e, out)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_strings_expr(callee, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_strings_expr(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELet(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ELetRec(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ELetMut(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EAssign(_, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EAssignOp(_, _, value, body) => {\\n      collect_strings_expr(value, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ESeq(first, second) => {\\n      collect_strings_expr(first, out)\\n      collect_strings_expr(second, out)\\n    },\\n    EWhile(cond, body) => {\\n      collect_strings_expr(cond, out)\\n      collect_strings_expr(body, out)\\n    },\\n    EForIn(_, _, iter_e, body) => {\\n      collect_strings_expr(iter_e, out)\\n      collect_strings_expr(body, out)\\n    },\\n    ETuple(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_strings_expr(Array::get(elems, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_strings_expr(Array::get(elems, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(scrutinee, arms) => {\\n      collect_strings_expr(scrutinee, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, arm_expr) = Array::get(arms, i)\\n        let _ = collect_strings_pat(pat, out)\\n        collect_strings_expr(arm_expr, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EFn(_, _, _, _, _, body) => collect_strings_expr(body, out),\\n    EThrow(msg) => collect_strings_expr(msg, out),\\n    EReturn(msg) => collect_strings_expr(msg, out),\\n    EStringInterp(parts) => {\\n      let mut si_p = 0\\n      while si_p < Array::length(parts) {\\n        if si_p % 2 == 0 {\\n          let part = Array::get(parts, si_p)\\n          if String::length(part) > 0 {\\n            let mut found = false\\n            let mut fi2 = 0\\n            while fi2 < Array::length(out) {\\n              if Array::get(out, fi2) == part { found = true }\\n              fi2 = fi2 + 1\\n            }\\n            if !found { Array::push(out, part) }\\n          }\\n        }\\n        si_p = si_p + 1\\n      }\\n      0\\n    },\\n    EHandle(body, arms) => {\\n      collect_strings_expr(body, out)\\n      let mut hi = 0\\n      while hi < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, hi)\\n        collect_strings_expr(arm_expr, out)\\n        hi = hi + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut mi = 0\\n      while mi < Array::length(fields) {\\n        let (key, val) = Array::get(fields, mi)\\n        let mut kf = false\\n        let mut ki = 0\\n        while ki < Array::length(out) {\\n          if Array::get(out, ki) == key { kf = true }\\n          ki = ki + 1\\n        }\\n        if !kf { Array::push(out, key) }\\n        collect_strings_expr(val, out)\\n        mi = mi + 1\\n      }\\n      0\\n    },\\n    ERecord(fields) => {\\n      let mut ri = 0\\n      while ri < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, ri)\\n        collect_strings_expr(fval, out)\\n        ri = ri + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _, _) => collect_strings_expr(obj, out),\\n    ELabeledArg(_, _, val) => collect_strings_expr(val, out),\\n    _ => 0\\n  }\\n}\\n\\nexport let get_func_param_names: (Stmt) -> Array[String] with { Error } = (stmt) -> {\\n  match stmt {\\n    SLet(_, _, _, _, expr) => match expr {\\n      EFn(_, _, params, _, _, _) => {\\n        let names = common_analysis_fresh_string_array()\\n        let mut i = 0\\n        while i < Array::length(params) {\\n          let (pname, _) = Array::get(params, i)\\n          let plen2 = String::length(pname)\\n          let clean_name = if plen2 > 0 {\\n            let last_char = String::char_code_at(pname, plen2 - 1)\\n            if last_char == '~' || last_char == '?' {\\n              pname[0:plen2 - 1]\\n            } else pname\\n          } else pname\\n          Array::push(names, clean_name)\\n          i = i + 1\\n        }\\n        names\\n      },\\n      _ => throw(\\\"get_func_param_names: not a function\\\")\\n    },\\n    _ => throw(\\\"get_func_param_names: not a let statement\\\")\\n  }\\n}\\n\\nexport let rec expr_contains_exceptions: (Expr) -> Bool = (expr) -> {\\n  match expr {\\n    EThrow(_) => true,\\n    EHandle(_, _) => true,\\n    EBinOp(_, lhs, rhs) => expr_contains_exceptions(lhs) || expr_contains_exceptions(rhs),\\n    EUnaryOp(_, operand) => expr_contains_exceptions(operand),\\n    EIf(cond, then_e, else_e) =>\\n    expr_contains_exceptions(cond) || expr_contains_exceptions(then_e) || expr_contains_exceptions(else_e),\\n    ECall(callee, args, _) => {\\n      let mut found = match callee {\\n        EIdent(cname, _) => cname == \\\"resume\\\",\\n        _ => expr_contains_exceptions(callee)\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        if expr_contains_exceptions(Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    ELetRec(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    ELetMut(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    EAssign(_, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    EAssignOp(_, _, value, body) => expr_contains_exceptions(value) || expr_contains_exceptions(body),\\n    ESeq(first, second) => expr_contains_exceptions(first) || expr_contains_exceptions(second),\\n    EWhile(cond, body) => expr_contains_exceptions(cond) || expr_contains_exceptions(body),\\n    EForIn(_, _, iter_e, body) => expr_contains_exceptions(iter_e) || expr_contains_exceptions(body),\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      let mut found = expr_contains_exceptions(body)\\n      while i < Array::length(params) {\\n        let (_, iv) = Array::get(params, i)\\n        if expr_contains_exceptions(iv) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMatch(scrut, arms) => {\\n      let mut i = 0\\n      let mut found = expr_contains_exceptions(scrut)\\n      while i < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, i)\\n        if expr_contains_exceptions(arm_body) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EFn(_, _, _, _, _, body) => expr_contains_exceptions(body),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_contains_exceptions(Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_contains_exceptions(Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ERecord(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_contains_exceptions(fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_contains_exceptions(fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EDot(obj, _, _) => expr_contains_exceptions(obj),\\n    ELabeledArg(_, _, inner) => expr_contains_exceptions(inner),\\n    EReturn(inner) => expr_contains_exceptions(inner),\\n    ESpread(inner) => expr_contains_exceptions(inner),\\n    EBreak(opt) => match opt {\\n      Some(inner) => expr_contains_exceptions(inner),\\n      None => false\\n    },\\n    EContinue(args) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if expr_contains_exceptions(Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EInt(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EBool(_) => false,\\n    EIdent(_, _) => false,\\n    EStringInterp(_) => false,\\n    EUnit => false\\n  }\\n}\\n\\nexport let rec stmts_contain_exceptions: (Array[Stmt]) -> Bool = (stmts) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SLetMut(_, _, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SLetPat(_, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SExpr(expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      STest(_, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SBench(_, expr) => if expr_contains_exceptions(expr) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      SModule(_, _, inner) => if stmts_contain_exceptions(inner) {\\n        found = true\\n      } else {\\n        ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nexport let collect_strings_stmts: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out = common_analysis_fresh_string_array()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, _, _, expr) => collect_strings_expr(expr, out),\\n      _ => 0\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let emit_i64_extend_i32_u: (Bytes) -> Unit = (buf) -> {\\n  bytebuf_push(buf, op_i64_extend_i32_u)\\n}\\n\\nexport let emit_closure_resolve: (Bytes, Int, Int, Int) -> Unit = (buf, fn_val_local, slot_local, env_local) -> {\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, 3)\\n  emit_i64_and(buf)\\n  emit_i64_const(buf, 2)\\n  emit_i64_eq(buf)\\n  emit_if_void(buf)\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, 2)\\n  emit_i64_shr_s(buf)\\n  emit_local_set(buf, slot_local)\\n  emit_i64_const(buf, 0)\\n  emit_local_set(buf, env_local)\\n  emit_else(buf)\\n  emit_local_get(buf, fn_val_local)\\n  emit_i64_const(buf, -4)\\n  emit_i64_and(buf)\\n  emit_local_set(buf, env_local)\\n  emit_local_get(buf, env_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_i32_load(buf, 2, 0)\\n  emit_i64_extend_i32_u(buf)\\n  emit_local_set(buf, slot_local)\\n  emit_end(buf)\\n}\\n\\nexport let emit_closure_call_tail: (Bytes, Int, Int, Int, Int) -> Unit = (buf, env_local, slot_local, closure_type_base, num_args) -> {\\n  emit_local_get(buf, env_local)\\n  emit_local_get(buf, slot_local)\\n  emit_i32_wrap_i64(buf)\\n  emit_call_indirect(buf, closure_type_base + num_args)\\n}\\n\\nlet rec collect_pattern_bindings: (Pat, Array[String]) -> Int = (pat, bindings) -> {\\n  match pat {\\n    PBind(name) => {\\n      Array::push(bindings, name); 0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        collect_pattern_bindings(Array::get(pats, i), bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PCtor(_, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_pattern_bindings(Array::get(args, i), bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, r) => {\\n      collect_pattern_bindings(l, bindings); collect_pattern_bindings(r, bindings)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fpat) = Array::get(fields, i)\\n        collect_pattern_bindings(fpat, bindings)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nlet is_inlined_async_builtin: (String) -> Bool = (name) -> {\\n  name == \\\"await\\\" || name == \\\"Future::ready\\\" || name == \\\"Task::spawn\\\" || name == \\\"Task::join\\\" || name == \\\"Task::cancel\\\" || name == \\\"Task::race\\\" || name == \\\"Task::timeout\\\" || name == \\\"Stream::empty\\\" || name == \\\"Stream::once\\\" || name == \\\"Stream::map\\\" || name == \\\"Stream::filter\\\" || name == \\\"Stream::fold\\\" || name == \\\"Stream::next\\\" || name == \\\"String::to_bytes\\\" || name == \\\"Stream::to_string\\\"\\n}\\n\\nexport let rec collect_free_vars_expr: (Expr, Array[String], Array[String], Array[String]) -> Int = (expr, bound, fn_names, out) -> {\\n  match expr {\\n    EIdent(name, _) => if array_contains_str(bound, name) {\\n      0\\n    }\\n    else if array_contains_str(fn_names, name) {\\n      0\\n    }\\n    else if is_inlined_async_builtin(name) {\\n      0\\n    }\\n    else if array_contains_str(out, name) {\\n      0\\n    }\\n    else {\\n      Array::push(out, name)\\n      0\\n    },\\n    EInt(_) => 0,\\n    EBool(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EUnit => 0,\\n    EBinOp(_, lhs, rhs) => {\\n      collect_free_vars_expr(lhs, bound, fn_names, out); collect_free_vars_expr(rhs, bound, fn_names, out)\\n    },\\n    EUnaryOp(_, operand) => collect_free_vars_expr(operand, bound, fn_names, out),\\n    EIf(cond, then_e, else_e) => {\\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(then_e, bound, fn_names, out); collect_free_vars_expr(else_e, bound, fn_names, out)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_free_vars_expr(callee, bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        collect_free_vars_expr(Array::get(args, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELet(name, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ELetRec(name, value, body) => {\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ELetMut(name, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, name)\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    EAssign(_, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    EAssignOp(_, _, value, body) => {\\n      collect_free_vars_expr(value, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    ESeq(first, second) => {\\n      collect_free_vars_expr(first, bound, fn_names, out); collect_free_vars_expr(second, bound, fn_names, out)\\n    },\\n    EWhile(cond, body) => {\\n      collect_free_vars_expr(cond, bound, fn_names, out); collect_free_vars_expr(body, bound, fn_names, out)\\n    },\\n    EForIn(var_name, index_name, iter_e, body) => {\\n      collect_free_vars_expr(iter_e, bound, fn_names, out)\\n      let saved = Array::length(bound)\\n      Array::push(bound, var_name)\\n      match index_name {\\n        Some(index_name) => Array::push(bound, index_name),\\n        None => ()\\n      }\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    ETuple(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      while i < Array::length(elems) {\\n        collect_free_vars_expr(Array::get(elems, i), bound, fn_names, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(scrutinee, arms) => {\\n      collect_free_vars_expr(scrutinee, bound, fn_names, out)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (arm_pat, arm_expr) = Array::get(arms, i)\\n        let saved = Array::length(bound)\\n        collect_pattern_bindings(arm_pat, bound)\\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\\n        Array::truncate(bound, saved)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EFn(_, _, params, _, _, body) => {\\n      let saved = Array::length(bound)\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pname_raw, _) = Array::get(params, pi)\\n        let pnl = String::length(pname_raw)\\n        let pname = if pnl > 0 {\\n          let plc = String::char_code_at(pname_raw, pnl - 1)\\n          if plc == '~' || plc == '?' { pname_raw[0:pnl - 1] } else pname_raw\\n        } else pname_raw\\n        Array::push(bound, pname)\\n        pi = pi + 1\\n      }\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      Array::truncate(bound, saved)\\n      0\\n    },\\n    EBreak(_) => 0,\\n    EContinue(_) => 0,\\n    EThrow(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\\n    EReturn(msg) => collect_free_vars_expr(msg, bound, fn_names, out),\\n    EHandle(body, arms) => {\\n      collect_free_vars_expr(body, bound, fn_names, out)\\n      let mut hi = 0\\n      while hi < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, hi)\\n        collect_free_vars_expr(arm_expr, bound, fn_names, out)\\n        hi = hi + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _, _) => collect_free_vars_expr(obj, bound, fn_names, out),\\n    ERecord(fields) => {\\n      let mut ri = 0\\n      while ri < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, ri)\\n        collect_free_vars_expr(fval, bound, fn_names, out)\\n        ri = ri + 1\\n      }\\n      0\\n    },\\n    ELabeledArg(_, _, arg_expr) => collect_free_vars_expr(arg_expr, bound, fn_names, out),\\n    _ => 0\\n  }\\n}\\n\\nexport let collect_free_vars: (Expr, Array[String], Array[String]) -> Array[String] = (body, param_names, fn_names) -> {\\n  let out = common_analysis_fresh_string_array()\\n  let bound = Array::slice(param_names, 0, Array::length(param_names))\\n  collect_free_vars_expr(body, bound, fn_names, out)\\n  out\\n}\\n\\nexport let rec proj_root_ident: (Expr) -> String = (e) -> {\\n  match e {\\n    EDot(obj, _, _) => proj_root_ident(obj),\\n    EIdent(nm, _) => nm,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nexport let rec scope_tail_proj_root: (Expr) -> String = (e) -> {\\n  match e {\\n    ELet(_, _, b) => scope_tail_proj_root(b),\\n    ELetMut(_, _, b) => scope_tail_proj_root(b),\\n    ELetRec(_, _, b) => scope_tail_proj_root(b),\\n    ESeq(_, b) => scope_tail_proj_root(b),\\n    EAssign(_, _, b) => scope_tail_proj_root(b),\\n    EAssignOp(_, _, _, b) => scope_tail_proj_root(b),\\n    EDot(obj, _, _) => proj_root_ident(obj),\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nexport let rec is_mut_captured_in: (Expr, String) -> Bool = (expr, name) -> {\\n  match expr {\\n    EIdent(_, _) => false,\\n    EInt(_) => false,\\n    EBool(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EUnit => false,\\n    EBinOp(_, lhs, rhs) => is_mut_captured_in(lhs, name) || is_mut_captured_in(rhs, name),\\n    EUnaryOp(_, operand) => is_mut_captured_in(operand, name),\\n    EIf(cond, then_e, else_e) => is_mut_captured_in(cond, name) || is_mut_captured_in(then_e, name) || is_mut_captured_in(else_e, name),\\n    ECall(callee, args, _) => if is_mut_captured_in(callee, name) {\\n      true\\n    }\\n    else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if is_mut_captured_in(Array::get(args, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(n, value, body) => if n == name {\\n      is_mut_captured_in(value, name)\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    ELetRec(n, value, body) => if n == name {\\n      false\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    ELetMut(n, value, body) => if n == name {\\n      is_mut_captured_in(value, name)\\n    }\\n    else {\\n      is_mut_captured_in(value, name) || is_mut_captured_in(body, name)\\n    },\\n    EAssign(_, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\\n    EAssignOp(_, _, value, body) => is_mut_captured_in(value, name) || is_mut_captured_in(body, name),\\n    ESeq(first, second) => is_mut_captured_in(first, name) || is_mut_captured_in(second, name),\\n    EWhile(cond, body) => is_mut_captured_in(cond, name) || is_mut_captured_in(body, name),\\n    EForIn(_, _, iter_e, body) => is_mut_captured_in(iter_e, name) || is_mut_captured_in(body, name),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if is_mut_captured_in(Array::get(elems, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if is_mut_captured_in(Array::get(elems, i), name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMatch(scrutinee, arms) => if is_mut_captured_in(scrutinee, name) {\\n      true\\n    }\\n    else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, i)\\n        if is_mut_captured_in(arm_expr, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EFn(_, _, params, _, _, fn_body) => {\\n      let mut shadowed = false\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pname, _) = Array::get(params, pi)\\n        if pname == name {\\n          shadowed = true\\n        }\\n        pi = pi + 1\\n      }\\n      if shadowed {\\n        false\\n      }\\n      else {\\n        let param_names = Array::slice([\\n          \\\"\\\"\\n        ], 0, 0)\\n        let mut pi2 = 0\\n        while pi2 < Array::length(params) {\\n          let (pname2, _) = Array::get(params, pi2)\\n          Array::push(param_names, pname2)\\n          pi2 = pi2 + 1\\n        }\\n        let fv = collect_free_vars(fn_body, param_names, Array::slice([\\n          \\\"\\\"\\n        ], 0, 0))\\n        if array_contains_str(fv, name) {\\n          true\\n        }\\n        else {\\n          is_mut_captured_in(fn_body, name)\\n        }\\n      }\\n    },\\n    EBreak(_) => false,\\n    EContinue(_) => false,\\n    EThrow(msg) => is_mut_captured_in(msg, name),\\n    EReturn(msg) => is_mut_captured_in(msg, name),\\n    ERecord(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if is_mut_captured_in(fval, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMap(entries) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(entries) {\\n        let (_, mval) = Array::get(entries, i)\\n        if is_mut_captured_in(mval, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EHandle(body, arms) => if is_mut_captured_in(body, name) {\\n      true\\n    } else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(arms) {\\n        let (_, arm_expr) = Array::get(arms, i)\\n        if is_mut_captured_in(arm_expr, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELoop(params, body) => if is_mut_captured_in(body, name) {\\n      true\\n    } else {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        if is_mut_captured_in(init, name) {\\n          found = true\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EDot(obj, _, _) => is_mut_captured_in(obj, name),\\n    ELabeledArg(_, _, inner) => is_mut_captured_in(inner, name),\\n    ESpread(inner) => is_mut_captured_in(inner, name),\\n    _ => false\\n  }\\n}\\n\\nexport let mut_needs_ref_cell: (Expr, String) -> Bool = (body, name) -> {\\n  is_mut_captured_in(body, name)\\n}\\n\\nexport let md_is_borrow_arg0_call: (String) -> Bool = (f) -> {\\n  f == \\\"__index\\\" || f == \\\"Array::get\\\" || f == \\\"Array::length\\\" || f == \\\"Array::set\\\" || f == \\\"Array::push\\\" || f == \\\"ArrayBuilder::push\\\" || f == \\\"StringBuilder::push\\\" || f == \\\"MapBuilder::set\\\" || f == \\\"Map::get\\\" || f == \\\"Map::keys\\\" || f == \\\"Map::has_key\\\" || f == \\\"Map::set\\\" || f == \\\"Bytes::push\\\" || f == \\\"Bytes::set\\\" || f == \\\"Bytes::get\\\" || f == \\\"Bytes::length\\\" || f == \\\"__rec_field\\\"\\n}\\n\\nlet md_max: (Int, Int) -> Int = (a, b) -> {\\n  if a > b { a } else { b }\\n}\\n\\nexport let rec md_consume_count: (Expr, String) -> Int = (e, name) -> {\\n  match e {\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EStringInterp(_) => 0,\\n    EIdent(n, _) => if n == name { 1 } else { 0 },\\n    ETuple(items) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        acc = acc + md_consume_count(Array::get(items, i), name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EArray(items) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        acc = acc + md_consume_count(Array::get(items, i), name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    ERecord(fields) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, v) = Array::get(fields, i)\\n        acc = acc + md_consume_count(v, name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EMap(fields) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, v) = Array::get(fields, i)\\n        acc = acc + md_consume_count(v, name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EIf(c, t, el) =>\\n    md_consume_count(c, name) + md_max(md_consume_count(t, name), md_consume_count(el, name)),\\n    ELet(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    ELetRec(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    ELetMut(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    EAssign(_, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    EAssignOp(_, _, v, b) => md_consume_count(v, name) + md_consume_count(b, name),\\n    ESeq(a, b) => md_consume_count(a, name) + md_consume_count(b, name),\\n    EMatch(s, arms) => {\\n      let mut mx = 0\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (_, v) = Array::get(arms, i)\\n        mx = md_max(mx, md_consume_count(v, name))\\n        i = i + 1\\n      }\\n      let scr = match s {\\n        EIdent(_, _) => 0,\\n        _ => md_consume_count(s, name)\\n      }\\n      scr + mx\\n    },\\n    EHandle(s, arms) => {\\n      let mut mx = 0\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (_, v) = Array::get(arms, i)\\n        mx = md_max(mx, md_consume_count(v, name))\\n        i = i + 1\\n      }\\n      let scr = match s {\\n        EIdent(_, _) => 0,\\n        _ => md_consume_count(s, name)\\n      }\\n      scr + mx\\n    },\\n    EWhile(c, b) => md_consume_count(c, name) + md_consume_count(b, name),\\n    ELoop(params, b) => {\\n      let mut acc = md_consume_count(b, name)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (_, v) = Array::get(params, i)\\n        acc = acc + md_consume_count(v, name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    EForIn(_, _, it, b) => md_consume_count(it, name) + md_consume_count(b, name),\\n    ECall(callee, args, _) => {\\n      let borrow0 = match callee {\\n        EIdent(f, _) => md_is_borrow_arg0_call(f),\\n        _ => false\\n      }\\n      let start = if borrow0 && Array::length(args) >= 1 {\\n        1\\n      } else {\\n        0\\n      }\\n      let head = if start == 1 {\\n        match Array::get(args, 0) {\\n          EIdent(_, _) => 0,\\n          _ => md_consume_count(Array::get(args, 0), name)\\n        }\\n      } else {\\n        0\\n      }\\n      let callee_c = match callee {\\n        EIdent(_, _) => 0,\\n        _ => md_consume_count(callee, name)\\n      }\\n      let mut acc = callee_c + head\\n      let mut ri = start\\n      while ri < Array::length(args) {\\n        acc = acc + md_consume_count(Array::get(args, ri), name)\\n        ri = ri + 1\\n      }\\n      acc\\n    },\\n    EBinOp(_, l, r) => md_consume_count(l, name) + md_consume_count(r, name),\\n    EUnaryOp(_, x) => md_consume_count(x, name),\\n    EFn(_, _, _, _, _, body) => md_consume_count(body, name),\\n    EDot(x, _, _) => md_consume_count(x, name),\\n    ELabeledArg(_, _, v) => md_consume_count(v, name),\\n    EThrow(x) => md_consume_count(x, name),\\n    EReturn(x) => md_consume_count(x, name),\\n    EBreak(opt) => match opt {\\n      Some(v) => md_consume_count(v, name),\\n      None => 0\\n    },\\n    EContinue(args) => {\\n      let mut acc = 0\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        acc = acc + md_consume_count(Array::get(args, i), name)\\n        i = i + 1\\n      }\\n      acc\\n    },\\n    ESpread(x) => md_consume_count(x, name)\\n  }\\n}\\n\\n\\n\\n\\n\\nexport enum PerceusActionKind {\\n  PaDup;\\n  PaDrop;\\n  PaAliasDup\\n}\\n\\nexport struct PerceusAction {\\n  kind: PerceusActionKind;\\n  name: String\\n}\\n\\nstruct PCtx {\\n  mut next_id: Int;\\n  mut seq_id: Int;\\n  pctx_names: Array[String];\\n  uses: Array[Int];\\n  borrows: Array[Int];\\n  scalar: Array[Bool];\\n  remaining: Array[Int];\\n  actions: Array[PerceusAction]\\n}\\n\\nstruct HeapInferCtx {\\n  ctors: Array[String];\\n  heap_fns: Array[String]\\n}\\n\\n\\nlet zeros: (Int) -> Array[Int] = (n) -> {\\n  let out: Array[Int] = [\\n  ]\\n  let mut i = 0\\n  while i < n {\\n    Array::push(out, 0)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet int_max: (Int, Int) -> Int = (a, b) -> {\\n  if a > b {\\n    a\\n  } else {\\n    b\\n  }\\n}\\n\\nlet name_in: (Array[String], String) -> Bool = (arr, s) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == s {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet pe_push: (PCtx, PerceusActionKind, String) -> Int = (ctx, kind, name) -> {\\n  Array::push(ctx.actions, PerceusAction::{\\n    kind: kind, name: name\\n  })\\n  0\\n}\\n\\nlet pe_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\\n  if Map::has_key(scope, name) {\\n    let id = Map::get(scope, name)\\n    let rem = Array::get(ctx.remaining, id)\\n    if rem > 1 && !Array::get(ctx.scalar, id) {\\n      pe_push(ctx, PaDup, name)\\n    } else {\\n      0\\n    }\\n    if rem > 0 {\\n      Array::set(ctx.remaining, id, rem - 1)\\n    }\\n  }\\n  0\\n}\\n\\nlet pctx_new: () -> PCtx = () -> {\\n  PCtx::{\\n    next_id: 0,\\n    seq_id: 0,\\n    pctx_names: [\\n    ],\\n    uses: [\\n    ],\\n    borrows: [\\n    ],\\n    scalar: [\\n    ],\\n    remaining: [\\n    ],\\n    actions: [\\n    ],\\n  }\\n}\\n\\nlet copy_ints: (Array[Int]) -> Array[Int] = (src) -> {\\n  let out: Array[Int] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::push(out, Array::get(src, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let pa_is_dup: (PerceusAction) -> Bool = (a) -> {\\n  match a.kind {\\n    PaDup => true,\\n    PaDrop => false,\\n    PaAliasDup => false\\n  }\\n}\\n\\nlet rec pat_names: (Pat, Array[String]) -> Int = (pat, out) -> {\\n  match pat {\\n    PBind(name) => {\\n      Array::push(out, name)\\n      0\\n    },\\n    PCtor(_n, args) => {\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        pat_names(Array::get(args, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    PTuple(pats) => {\\n      let mut i = 0\\n      while i < Array::length(pats) {\\n        pat_names(Array::get(pats, i), out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    POr(l, _r) => pat_names(l, out),\\n    PStruct(_n, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pat_names((Array::get(fields, i)).1, out)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport let pa_is_drop: (PerceusAction) -> Bool = (a) -> {\\n  match a.kind {\\n    PaDrop => true,\\n    PaDup => false,\\n    PaAliasDup => false\\n  }\\n}\\n\\nlet pc_declare: (PCtx, String, Bool) -> Int = (ctx, name, scalar) -> {\\n  let id = ctx.next_id\\n  Array::push(ctx.pctx_names, name)\\n  Array::push(ctx.uses, 0)\\n  Array::push(ctx.borrows, 0)\\n  Array::push(ctx.scalar, scalar)\\n  ctx.next_id = id + 1\\n  id\\n}\\n\\nlet pe_declare: (PCtx, String) -> Int = (ctx, _name) -> {\\n  let id = ctx.next_id\\n  let owning = Array::get(ctx.uses, id)\\n  let init = if owning == 0 {\\n    1\\n  } else {\\n    owning\\n  }\\n  Array::push(ctx.remaining, init)\\n  ctx.next_id = id + 1\\n  id\\n}\\n\\nlet pc_count_use: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\\n  if Map::has_key(scope, name) {\\n    let id = Map::get(scope, name)\\n    Array::set(ctx.uses, id, Array::get(ctx.uses, id) + 1)\\n  }\\n  0\\n}\\n\\nlet pe_scope_end: (PCtx, Int, String) -> Int = (ctx, id, name) -> {\\n  if Array::get(ctx.remaining, id) > 0 && !Array::get(ctx.scalar, id) {\\n    pe_push(ctx, PaDrop, name)\\n    Array::set(ctx.remaining, id, 0)\\n  }\\n  0\\n}\\n\\nlet next_seq_name: (PCtx) -> String = (ctx) -> {\\n  let nm = \\\"__seq\\\" + __to_string(ctx.seq_id)\\n  ctx.seq_id = ctx.seq_id + 1\\n  nm\\n}\\n\\nlet fn_param_names: (Array[(String, Option[TypeExpr])]) -> Array[String] = (params) -> {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    Array::push(out, (Array::get(params, i)).0)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet is_v128_box_call: (String) -> Bool = (fname) -> {\\n  fname == \\\"v128_load\\\" || fname == \\\"v128_splat_i8x16\\\" || fname == \\\"v128_eq_i8x16\\\" || fname == \\\"v128_le_u_i8x16\\\" || fname == \\\"v128_ge_u_i8x16\\\" || fname == \\\"v128_and\\\" || fname == \\\"v128_or\\\" || fname == \\\"v128_not\\\"\\n}\\n\\nlet array_contains_str_pctx: (Array[String], String) -> Bool = (arr, s) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(arr) {\\n    if Array::get(arr, i) == s {\\n      found = true\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\n\\nlet borrow_ret_marker = \\\"BR:\\\"\\n\\nlet is_borrow_ret_fname: (PCtx, String) -> Bool = (ctx, fname) -> {\\n  fname == \\\"Array::get\\\" || fname == \\\"Map::get\\\" || fname == \\\"__index\\\" || fname == \\\"__rec_field\\\" || array_contains_str_pctx(ctx.pctx_names, String::concat(borrow_ret_marker, fname))\\n}\\n\\nlet tail_is_borrow_ret_safe: (Array[String], Expr) -> Bool = (known, e0) -> {\\n  let worklist = [e0]\\n  let mut all_safe = true\\n  let mut i = 0\\n  while i < Array::length(worklist) {\\n    match Array::get(worklist, i) {\\n      ELet(_, _, b) => Array::push(worklist, b),\\n      ELetMut(_, _, b) => Array::push(worklist, b),\\n      ELetRec(_, _, b) => Array::push(worklist, b),\\n      ESeq(_, b) => Array::push(worklist, b),\\n      EAssign(_, _, b) => Array::push(worklist, b),\\n      EAssignOp(_, _, _, b) => Array::push(worklist, b),\\n      EIf(_, t, el) => {\\n        Array::push(worklist, t)\\n        Array::push(worklist, el)\\n      },\\n      EMatch(_, arms) => {\\n        let mut ai = 0\\n        while ai < Array::length(arms) {\\n          let (_p, ae) = Array::get(arms, ai)\\n          Array::push(worklist, ae)\\n          ai = ai + 1\\n        }\\n      },\\n      ECall(callee_e, _, _) =>\\n      match callee_e {\\n        EIdent(callee, _) =>\\n        if !array_contains_str_pctx(known, callee) {\\n          all_safe = false\\n        } else {\\n          ()\\n        },\\n        _ => {\\n          all_safe = false\\n        }\\n      },\\n      EIdent(_, _) => (),\\n      EThrow(_) => (),\\n      _ => {\\n        all_safe = false\\n      }\\n    }\\n    i = i + 1\\n  }\\n  all_safe\\n}\\n\\nlet rec strip_wrappers_for_borrow_ret: (Expr) -> Expr = (e) -> {\\n  match e {\\n    ELet(_, _, b) => strip_wrappers_for_borrow_ret(b),\\n    ELetMut(_, _, b) => strip_wrappers_for_borrow_ret(b),\\n    ELetRec(_, _, b) => strip_wrappers_for_borrow_ret(b),\\n    ESeq(_, b) => strip_wrappers_for_borrow_ret(b),\\n    EAssign(_, _, b) => strip_wrappers_for_borrow_ret(b),\\n    EAssignOp(_, _, _, b) => strip_wrappers_for_borrow_ret(b),\\n    _ => e\\n  }\\n}\\n\\nexport let compute_borrow_returning_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let known: Array[String] = [\\n    \\\"Array::get\\\", \\\"Map::get\\\", \\\"__index\\\", \\\"__rec_field\\\"\\n  ]\\n  let mut changed = true\\n  while changed {\\n    changed = false\\n    let mut i = 0\\n    while i < Array::length(stmts) {\\n      match Array::get(stmts, i) {\\n        SLet(_, _, name, _, value) =>\\n        if !array_contains_str_pctx(known, name) {\\n          match value {\\n            EFn(_, _, _, _, _, body) => {\\n              let top = strip_wrappers_for_borrow_ret(body)\\n              let eligible_shape = match top {\\n                ECall(_, _, _) => true,\\n                EIf(_, _, _) => true,\\n                EMatch(_, _) => true,\\n                _ => false\\n              }\\n              if eligible_shape && tail_is_borrow_ret_safe(known, top) {\\n                Array::push(known, name)\\n                changed = true\\n              } else {\\n                ()\\n              }\\n            },\\n            _ => ()\\n          }\\n        } else {\\n          ()\\n        },\\n        _ => ()\\n      }\\n      i = i + 1\\n    }\\n  }\\n  known\\n}\\n\\nlet fn_sig_return_type: (Option[TypeExpr]) -> Option[TypeExpr] = (ty) -> {\\n  match ty {\\n    Some(t) =>\\n    match t {\\n      TyFn(_, ret, _) => Some(ret),\\n      _ => None\\n    },\\n    None => None\\n  }\\n}\\n\\nexport let compute_scalar_returning_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, ty, value) =>\\n      match value {\\n        EFn(_, _, _, _, _, _) =>\\n        match fn_sig_return_type(ty) {\\n          Some(ret) =>\\n          if !type_expr_is_heap(Some(ret)) {\\n            Array::push(out, name)\\n          } else {\\n            ()\\n          },\\n          None => ()\\n        },\\n        _ => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet is_scalar_expr: (PCtx, Expr) -> Bool = (ctx, e) -> {\\n  match e {\\n    EInt(_) => true,\\n    EBool(_) => true,\\n    EFloat(_) => true,\\n    EUnit => true,\\n    ECall(EIdent(fname, _), _, _) => is_v128_box_call(fname) || is_borrow_ret_fname(ctx, fname),\\n    _ => false\\n  }\\n}\\n\\nlet pat_shadow_env: (Pat, Map[String, Bool]) -> Map[String, Bool] = (pat, env) -> {\\n  let names: Array[String] = [\\n  ]\\n  pat_names(pat, names)\\n  let mut env2 = env\\n  let mut j = 0\\n  while j < Array::length(names) {\\n    env2 = Map::set(env2, Array::get(names, j), false)\\n    j = j + 1\\n  }\\n  env2\\n}\\n\\nlet restore_prefix: (Array[Int], Array[Int]) -> Int = (dst, src) -> {\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::set(dst, i, Array::get(src, i))\\n    i = i + 1\\n  }\\n  0\\n}\\n\\nlet is_heap_literal: (Expr) -> Bool = (e) -> {\\n  match e {\\n    ETuple(_) => true,\\n    EArray(_) => true,\\n    ERecord(_) => true,\\n    _ => false\\n  }\\n}\\n\\nlet is_heap_value: (Expr, Map[String, Bool], HeapInferCtx) -> Bool = (e, env, hctx) -> {\\n  if is_heap_literal(e) {\\n    true\\n  } else {\\n    match e {\\n      ECall(callee, args, _) =>\\n      match callee {\\n        EIdent(c, _) =>\\n        if Map::has_key(env, c) {\\n          false\\n        } else {\\n          (Array::length(args) > 0 && name_in(hctx.ctors, c)) ||\\n          name_in(hctx.heap_fns, c)\\n        },\\n        _ => false\\n      },\\n      _ => false\\n    }\\n  }\\n}\\n\\nlet arg_class: (Expr, Map[String, Bool], HeapInferCtx) -> Bool = (arg, env, hctx) -> {\\n  if is_heap_value(arg, env, hctx) {\\n    true\\n  } else {\\n    match arg {\\n      EIdent(n, _) => if Map::has_key(env, n) {\\n        Map::get(env, n)\\n      } else {\\n        false\\n      },\\n      _ => false\\n    }\\n  }\\n}\\n\\nlet rec analyze_calls: (String, Expr, Map[String, Bool], Array[Array[Bool]], Array[Bool], HeapInferCtx) -> Int = (name, e_in, env_in, calls, esc, hctx) -> {\\n  let mut e = e_in\\n  let mut env = env_in\\n  let mut looping = true\\n  while looping {\\n    looping = false\\n    match e {\\n    EIdent(n, _) => {\\n      if n == name {\\n        Array::set(esc, 0, true)\\n      } else {\\n        ()\\n      }\\n      0\\n    },\\n    ECall(callee, args, _) => {\\n      let is_self = match callee {\\n        EIdent(cn, _) => cn == name,\\n        _ => false\\n      }\\n      if is_self {\\n        let cls: Array[Bool] = [\\n        ]\\n        let mut k = 0\\n        while k < Array::length(args) {\\n          Array::push(cls, arg_class(Array::get(args, k), env, hctx))\\n          k = k + 1\\n        }\\n        Array::push(calls, cls)\\n      } else {\\n        let _ = analyze_calls(name, callee, env, calls, esc, hctx)\\n        ()\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        analyze_calls(name, Array::get(args, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _, _) => analyze_calls(name, obj, env, calls, esc, hctx),\\n    ELet(n, v, b) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      env = Map::set(env, n, is_heap_value(v, env, hctx))\\n      e = b\\n      looping = true\\n    },\\n    ELetRec(n, v, b) => {\\n      env = Map::set(env, n, false)\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      e = b\\n      looping = true\\n    },\\n    ELetMut(n, v, b) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      env = Map::set(env, n, false)\\n      e = b\\n      looping = true\\n    },\\n    EAssign(_, v, c) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      e = c\\n      looping = true\\n    },\\n    EAssignOp(_, _, v, c) => {\\n      analyze_calls(name, v, env, calls, esc, hctx)\\n      e = c\\n      looping = true\\n    },\\n    ESeq(a, b) => {\\n      analyze_calls(name, a, env, calls, esc, hctx)\\n      e = b\\n      looping = true\\n    },\\n    EIf(c, t, el) => {\\n      analyze_calls(name, c, env, calls, esc, hctx)\\n      analyze_calls(name, t, env, calls, esc, hctx)\\n      analyze_calls(name, el, env, calls, esc, hctx)\\n      0\\n    },\\n    EWhile(c, b) => {\\n      analyze_calls(name, c, env, calls, esc, hctx)\\n      analyze_calls(name, b, env, calls, esc, hctx)\\n      0\\n    },\\n    EForIn(v0, ix, it, b) => {\\n      analyze_calls(name, it, env, calls, esc, hctx)\\n      let env1 = Map::set(env, v0, false)\\n      let env2 = match ix {\\n        Some(ixn) => Map::set(env1, ixn, false),\\n        None => env1\\n      }\\n      analyze_calls(name, b, env2, calls, esc, hctx)\\n      0\\n    },\\n    EBinOp(_, l, r) => {\\n      analyze_calls(name, l, env, calls, esc, hctx)\\n      analyze_calls(name, r, env, calls, esc, hctx)\\n      0\\n    },\\n    EUnaryOp(_, o) => analyze_calls(name, o, env, calls, esc, hctx),\\n    EFn(_, _, params, _, _, b) => {\\n      let mut env2 = env\\n      let mut pi = 0\\n      while pi < Array::length(params) {\\n        let (pn, _) = Array::get(params, pi)\\n        env2 = Map::set(env2, pn, false)\\n        pi = pi + 1\\n      }\\n      analyze_calls(name, b, env2, calls, esc, hctx)\\n      0\\n    },\\n    ETuple(xs) => {\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(xs) => {\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMatch(s, arms) => {\\n      analyze_calls(name, s, env, calls, esc, hctx)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, ab) = Array::get(arms, i)\\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EHandle(b, arms) => {\\n      analyze_calls(name, b, env, calls, esc, hctx)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (pat, ab) = Array::get(arms, i)\\n        analyze_calls(name, ab, pat_shadow_env(pat, env), calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELoop(ps, b) => {\\n      let mut env2 = env\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        let (pn, iv) = Array::get(ps, i)\\n        analyze_calls(name, iv, env2, calls, esc, hctx)\\n        env2 = Map::set(env2, pn, false)\\n        i = i + 1\\n      }\\n      analyze_calls(name, b, env2, calls, esc, hctx)\\n      0\\n    },\\n    ERecord(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fv) = Array::get(fs, i)\\n        analyze_calls(name, fv, env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMap(fs) => {\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (_, fv) = Array::get(fs, i)\\n        analyze_calls(name, fv, env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ELabeledArg(_, _, x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    EThrow(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    EReturn(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    ESpread(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n    EBreak(o) =>\\n    match o {\\n      Some(x) => analyze_calls(name, x, env, calls, esc, hctx),\\n      None => 0\\n    },\\n    EContinue(xs) => {\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        analyze_calls(name, Array::get(xs, i), env, calls, esc, hctx)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EStringInterp(_) => 0,\\n    EUnit => 0\\n  }\\n  }\\n  0\\n}\\n\\nexport let pa_is_alias_dup: (PerceusAction) -> Bool = (a) -> {\\n  match a.kind {\\n    PaAliasDup => true,\\n    PaDup => false,\\n    PaDrop => false\\n  }\\n}\\n\\nlet pc_count_borrow: (PCtx, Map[String, Int], String) -> Int = (ctx, scope, name) -> {\\n  if Map::has_key(scope, name) {\\n    let id = Map::get(scope, name)\\n    Array::set(ctx.borrows, id, Array::get(ctx.borrows, id) + 1)\\n  }\\n  0\\n}\\n\\nlet rec type_contains_fn: (TypeExpr) -> Bool = (t) -> {\\n  match t {\\n    TyFn(_, _, _) => true,\\n    TyTuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if type_contains_fn(Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    TyApp(_, args) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if type_contains_fn(Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    TyName(_) => false,\\n    TyUnit => false\\n  }\\n}\\n\\nlet all_calls_heap_at: (Int, Array[Array[Bool]]) -> Bool = (idx, calls) -> {\\n  let mut ci = 0\\n  let mut all_heap = true\\n  while ci < Array::length(calls) {\\n    let cls = Array::get(calls, ci)\\n    if idx >= Array::length(cls) {\\n      all_heap = false\\n    } else if !Array::get(cls, idx) {\\n      all_heap = false\\n    } else {\\n      ()\\n    }\\n    ci = ci + 1\\n  }\\n  all_heap\\n}\\n\\nlet type_name_is_heap: (String) -> Bool = (n) -> {\\n  if String::length(n) == 0 {\\n    false\\n  } else {\\n    let c0 = String::char_code_at(n, 0)\\n    if c0 < 'A' || c0 > 'Z' {\\n      false\\n    } else if n == \\\"Int\\\" || n == \\\"Bool\\\" || n == \\\"Double\\\" || n == \\\"Float\\\" || n == \\\"String\\\" || n == \\\"Bytes\\\" || n == \\\"Char\\\" || n == \\\"Unit\\\" || n == \\\"V128\\\" {\\n      false\\n    } else {\\n      true\\n    }\\n  }\\n}\\n\\nexport let type_expr_is_heap: (Option[TypeExpr]) -> Bool = (ot) -> {\\n  match ot {\\n    None => false,\\n    Some(t) =>\\n    match t {\\n      TyFn(_, _, _) => true,\\n      _ =>\\n      if type_contains_fn(t) {\\n        false\\n      } else {\\n        match t {\\n          TyTuple(_) => true,\\n          TyApp(_, _) => true,\\n          TyName(n) => type_name_is_heap(n),\\n          TyFn(_, _, _) => false,\\n          TyUnit => false\\n        }\\n      }\\n    }\\n  }\\n}\\n\\nlet collect_ctor_names: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SEnum(_, _, _, variants, _) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (vn, _) = Array::get(variants, j)\\n          Array::push(out, vn)\\n          j = j + 1\\n        }\\n      },\\n      SSuberror(_, _, variants) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (vn, _) = Array::get(variants, j)\\n          Array::push(out, vn)\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet inferred_heap_type: () -> TypeExpr = () -> {\\n  TyTuple(Array::slice([\\n    TyUnit\\n  ], 0, 0))\\n}\\n\\nlet fill_lambda_params: (String, Expr, Expr, HeapInferCtx) -> Expr = (name, efn, body, hctx) -> {\\n  match efn {\\n    EFn(tps, bounds, params, ret, eff, fnbody) => {\\n      let calls: Array[Array[Bool]] = [\\n      ]\\n      let esc = [\\n        false\\n      ]\\n      let env0: Map[String, Bool] = map {\\n      }\\n      analyze_calls(name, body, env0, calls, esc, hctx)\\n      if Array::get(esc, 0) || Array::length(calls) == 0 {\\n        efn\\n      } else {\\n        let new_params = Array::slice(params, 0, 0)\\n        let mut pi = 0\\n        while pi < Array::length(params) {\\n          let (pname, pty) = Array::get(params, pi)\\n          let filled = match pty {\\n            Some(_) => (pname, pty),\\n            None =>\\n            if all_calls_heap_at(pi, calls) {\\n              (pname, Some(inferred_heap_type()))\\n            } else {\\n              (pname, pty)\\n            }\\n          }\\n          Array::push(new_params, filled)\\n          pi = pi + 1\\n        }\\n        EFn(tps, bounds, new_params, ret, eff, fnbody)\\n      }\\n    },\\n    _ => efn\\n  }\\n}\\n\\nlet rec elaborate_rw: (Expr, HeapInferCtx) -> Expr = (e, hctx) -> {\\n  match e {\\n    ELet(n, v, b) => {\\n      let v2 = elaborate_rw(v, hctx)\\n      let v3 = fill_lambda_params(n, v2, b, hctx)\\n      ELet(n, v3, elaborate_rw(b, hctx))\\n    },\\n    ELetRec(n, v, b) => {\\n      let v2 = elaborate_rw(v, hctx)\\n      let v3 = fill_lambda_params(n, v2, b, hctx)\\n      ELetRec(n, v3, elaborate_rw(b, hctx))\\n    },\\n    ELetMut(n, v, b) => ELetMut(n, elaborate_rw(v, hctx), elaborate_rw(b, hctx)),\\n    EAssign(n, v, c) => EAssign(n, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\\n    EAssignOp(n, op, v, c) => EAssignOp(n, op, elaborate_rw(v, hctx), elaborate_rw(c, hctx)),\\n    ESeq(a, b) => ESeq(elaborate_rw(a, hctx), elaborate_rw(b, hctx)),\\n    EIf(c, t, el) => EIf(elaborate_rw(c, hctx), elaborate_rw(t, hctx), elaborate_rw(el, hctx)),\\n    EWhile(c, b) => EWhile(elaborate_rw(c, hctx), elaborate_rw(b, hctx)),\\n    EForIn(n, ix, it, b) => EForIn(n, ix, elaborate_rw(it, hctx), elaborate_rw(b, hctx)),\\n    EFn(tps, bounds, params, ret, eff, fb) =>\\n    EFn(tps, bounds, params, ret, eff, elaborate_rw(fb, hctx)),\\n    ECall(callee, args, off) => {\\n      let new_args = Array::slice(args, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        Array::push(new_args, elaborate_rw(Array::get(args, i), hctx))\\n        i = i + 1\\n      }\\n      ECall(elaborate_rw(callee, hctx), new_args, off)\\n    },\\n    EBinOp(op, l, r) => EBinOp(op, elaborate_rw(l, hctx), elaborate_rw(r, hctx)),\\n    EUnaryOp(op, o) => EUnaryOp(op, elaborate_rw(o, hctx)),\\n    EDot(o, f, off) => EDot(elaborate_rw(o, hctx), f, off),\\n    ETuple(xs) => {\\n      let ys = Array::slice(xs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\\n        i = i + 1\\n      }\\n      ETuple(ys)\\n    },\\n    EArray(xs) => {\\n      let ys = Array::slice(xs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\\n        i = i + 1\\n      }\\n      EArray(ys)\\n    },\\n    EMatch(s, arms) => {\\n      let new_arms = Array::slice(arms, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, ab) = Array::get(arms, i)\\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\\n        i = i + 1\\n      }\\n      EMatch(elaborate_rw(s, hctx), new_arms)\\n    },\\n    EHandle(b, arms) => {\\n      let new_arms = Array::slice(arms, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(arms) {\\n        let (p, ab) = Array::get(arms, i)\\n        Array::push(new_arms, (p, elaborate_rw(ab, hctx)))\\n        i = i + 1\\n      }\\n      EHandle(elaborate_rw(b, hctx), new_arms)\\n    },\\n    ELoop(ps, b) => {\\n      let new_ps = Array::slice(ps, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(ps) {\\n        let (pn, iv) = Array::get(ps, i)\\n        Array::push(new_ps, (pn, elaborate_rw(iv, hctx)))\\n        i = i + 1\\n      }\\n      ELoop(new_ps, elaborate_rw(b, hctx))\\n    },\\n    ERecord(fs) => {\\n      let new_fs = Array::slice(fs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (fn0, fv) = Array::get(fs, i)\\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\\n        i = i + 1\\n      }\\n      ERecord(new_fs)\\n    },\\n    EMap(fs) => {\\n      let new_fs = Array::slice(fs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(fs) {\\n        let (fn0, fv) = Array::get(fs, i)\\n        Array::push(new_fs, (fn0, elaborate_rw(fv, hctx)))\\n        i = i + 1\\n      }\\n      EMap(new_fs)\\n    },\\n    ELabeledArg(l, k, x) => ELabeledArg(l, k, elaborate_rw(x, hctx)),\\n    EThrow(x) => EThrow(elaborate_rw(x, hctx)),\\n    EReturn(x) => EReturn(elaborate_rw(x, hctx)),\\n    ESpread(x) => ESpread(elaborate_rw(x, hctx)),\\n    EBreak(o) =>\\n    match o {\\n      Some(x) => EBreak(Some(elaborate_rw(x, hctx))),\\n      None => EBreak(None)\\n    },\\n    EContinue(xs) => {\\n      let ys = Array::slice(xs, 0, 0)\\n      let mut i = 0\\n      while i < Array::length(xs) {\\n        Array::push(ys, elaborate_rw(Array::get(xs, i), hctx))\\n        i = i + 1\\n      }\\n      EContinue(ys)\\n    },\\n    EInt(_) => e,\\n    EFloat(_) => e,\\n    EString(_) => e,\\n    EBool(_) => e,\\n    EIdent(_, _) => e,\\n    EStringInterp(_) => e,\\n    EUnit => e\\n  }\\n}\\n\\nlet is_borrow_arg0_call: (String) -> Bool = (f) -> {\\n  f == \\\"__index\\\" || f == \\\"Array::get\\\" || f == \\\"Array::length\\\" || f == \\\"Array::set\\\" || f == \\\"Array::push\\\" || f == \\\"ArrayBuilder::push\\\" || f == \\\"StringBuilder::push\\\" || f == \\\"MapBuilder::set\\\" || f == \\\"Map::get\\\" || f == \\\"Map::keys\\\" || f == \\\"Map::has_key\\\" || f == \\\"Map::set\\\" || f == \\\"Bytes::push\\\" || f == \\\"Bytes::set\\\" || f == \\\"Bytes::get\\\" || f == \\\"Bytes::length\\\" || f == \\\"__rec_field\\\"\\n}\\n\\nexport let rec pc_emit: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {\\n  match expr {\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EStringInterp(_) => 0,\\n    EIdent(x, _) => pe_use(ctx, scope, x),\\n    ECall(callee, args, _) => {\\n      let is_index = match callee {\\n        EIdent(f, _) => is_borrow_arg0_call(f),\\n        _ => false\\n      }\\n      match callee {\\n        EIdent(_, _) => 0,\\n        _ => pc_emit(ctx, scope, callee)\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let arg = Array::get(args, i)\\n        if is_index && i == 0 {\\n          match arg {\\n            EIdent(_, _) => 0,\\n            _ => pc_emit(ctx, scope, arg)\\n          }\\n        } else {\\n          pc_emit(ctx, scope, arg)\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _field, _) => match obj {\\n      EIdent(_, _) => 0,\\n      _ => pc_emit(ctx, scope, obj)\\n    }\\n    ,\\n    ELet(name, value, body) => {\\n      match value {\\n        EIdent(src, _) => {\\n          if Map::has_key(scope, src) {\\n            let sid = Map::get(scope, src)\\n            let rem = Array::get(ctx.remaining, sid)\\n            if rem > 1 && !Array::get(ctx.scalar, sid) {\\n              pe_push(ctx, PaAliasDup, name)\\n            } else {\\n              0\\n            }\\n            if rem > 0 {\\n              Array::set(ctx.remaining, sid, rem - 1)\\n            }\\n          } else {\\n            ()\\n          }\\n          0\\n        },\\n        _ => pc_emit(ctx, scope, value)\\n      }\\n      let id = pe_declare(ctx, name)\\n      pc_emit(ctx, Map::set(scope, name, id), body)\\n      pe_scope_end(ctx, id, name)\\n    },\\n    ELetMut(name, value, body) => {\\n      pc_emit(ctx, scope, value)\\n      let id = pe_declare(ctx, name)\\n      pc_emit(ctx, Map::set(scope, name, id), body)\\n      pe_scope_end(ctx, id, name)\\n    },\\n    ELetRec(name, value, body) => {\\n      let id = pe_declare(ctx, name)\\n      let s2 = Map::set(scope, name, id)\\n      pc_emit(ctx, s2, value)\\n      pc_emit(ctx, s2, body)\\n      pe_scope_end(ctx, id, name)\\n    },\\n    EAssign(_name, value, body) => {\\n      pc_emit(ctx, scope, value)\\n      pc_emit(ctx, scope, body)\\n    },\\n    EAssignOp(_op, _name, value, body) => {\\n      pc_emit(ctx, scope, value)\\n      pc_emit(ctx, scope, body)\\n    },\\n    ESeq(a, b) => {\\n      pc_emit(ctx, scope, a)\\n      let nm = next_seq_name(ctx)\\n      let id = pe_declare(ctx, nm)\\n      pc_emit(ctx, scope, b)\\n      pe_scope_end(ctx, id, nm)\\n    },\\n    EBinOp(_op, l, r) => {\\n      pc_emit(ctx, scope, l)\\n      pc_emit(ctx, scope, r)\\n    },\\n    EUnaryOp(_op, e) => pc_emit(ctx, scope, e),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_emit(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_emit(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ERecord(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_emit(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      pc_emit(ctx, scope, cond)\\n      let snap = copy_ints(ctx.remaining)\\n      pc_emit(ctx, scope, then_e)\\n      let then_rem = copy_ints(ctx.remaining)\\n      restore_prefix(ctx.remaining, snap)\\n      pc_emit(ctx, scope, else_e)\\n      let mut i = 0\\n      while i < Array::length(snap) {\\n        if Array::get(then_rem, i) < Array::get(ctx.remaining, i) {\\n          Array::set(ctx.remaining, i, Array::get(then_rem, i))\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EWhile(cond, body) => {\\n      pc_emit(ctx, scope, cond)\\n      pc_emit(ctx, scope, body)\\n    },\\n    EReturn(e) => pc_emit(ctx, scope, e),\\n    EThrow(e) => pc_emit(ctx, scope, e),\\n    ESpread(e) => pc_emit(ctx, scope, e),\\n    ELabeledArg(_l, _n, e) => pc_emit(ctx, scope, e),\\n    EBreak(opt) => match opt {\\n      Some(e) => pc_emit(ctx, scope, e),\\n      None => 0\\n    }\\n    ,\\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\\n      ])\\n      let mut i = 0\\n      while i < Array::length(caps) {\\n        pe_use(ctx, scope, Array::get(caps, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EForIn(value_name, index_opt, iterable, fbody) => {\\n      pc_emit(ctx, scope, iterable)\\n      let idv = pe_declare(ctx, value_name)\\n      let s2 = Map::set(scope, value_name, idv)\\n      let s3 = match index_opt {\\n        Some(idx) => {\\n          let idi = pe_declare(ctx, idx)\\n          Map::set(s2, idx, idi)\\n        },\\n        None => s2\\n      }\\n      pc_emit(ctx, s3, fbody)\\n      pe_scope_end(ctx, idv, value_name)\\n    },\\n    ELoop(params, lbody) => {\\n      let mut s = scope\\n      let pids: Array[Int] = [\\n      ]\\n      let pnames: Array[String] = [\\n      ]\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let p = Array::get(params, i)\\n        pc_emit(ctx, scope, p.1)\\n        let pid = pe_declare(ctx, p.0)\\n        s = Map::set(s, p.0, pid)\\n        Array::push(pids, pid)\\n        Array::push(pnames, p.0)\\n        i = i + 1\\n      }\\n      pc_emit(ctx, s, lbody)\\n      let mut j = 0\\n      while j < Array::length(pids) {\\n        pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\\n        j = j + 1\\n      }\\n      0\\n    },\\n    EMatch(scrut, arms) => {\\n      match scrut {\\n        EIdent(_, _) => 0,\\n        _ => pc_emit(ctx, scope, scrut)\\n      }\\n      let snap = copy_ints(ctx.remaining)\\n      let minrem = copy_ints(snap)\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.remaining, snap)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let pids: Array[Int] = [\\n        ]\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pe_declare(ctx, nm)\\n          s = Map::set(s, nm, pid)\\n          Array::push(pids, pid)\\n          k = k + 1\\n        }\\n        pc_emit(ctx, s, arm.1)\\n        let mut j = 0\\n        while j < Array::length(pids) {\\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\\n          j = j + 1\\n        }\\n        let mut mi = 0\\n        while mi < Array::length(snap) {\\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\\n          } else {\\n            ()\\n          }\\n          mi = mi + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.remaining, minrem)\\n      0\\n    },\\n    EHandle(hbody, arms) => {\\n      let snap = copy_ints(ctx.remaining)\\n      pc_emit(ctx, scope, hbody)\\n      let minrem = copy_ints(ctx.remaining)\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.remaining, snap)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let pids: Array[Int] = [\\n        ]\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pe_declare(ctx, nm)\\n          s = Map::set(s, nm, pid)\\n          Array::push(pids, pid)\\n          k = k + 1\\n        }\\n        pc_emit(ctx, s, arm.1)\\n        let mut j = 0\\n        while j < Array::length(pids) {\\n          pe_scope_end(ctx, Array::get(pids, j), Array::get(pnames, j))\\n          j = j + 1\\n        }\\n        let mut mi = 0\\n        while mi < Array::length(snap) {\\n          if Array::get(ctx.remaining, mi) < Array::get(minrem, mi) {\\n            Array::set(minrem, mi, Array::get(ctx.remaining, mi))\\n          } else {\\n            ()\\n          }\\n          mi = mi + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.remaining, minrem)\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nexport let rec pc_count: (PCtx, Map[String, Int], Expr) -> Int = (ctx, scope, expr) -> {\\n  match expr {\\n    EInt(_) => 0,\\n    EFloat(_) => 0,\\n    EString(_) => 0,\\n    EBool(_) => 0,\\n    EUnit => 0,\\n    EStringInterp(_) => 0,\\n    EIdent(x, _) => pc_count_use(ctx, scope, x),\\n    ECall(callee, args, _) => {\\n      match callee {\\n        EIdent(f, _) => if is_borrow_arg0_call(f) {\\n          0\\n        } else {\\n          pc_count_borrow(ctx, scope, f)\\n        }\\n        ,\\n        _ => pc_count(ctx, scope, callee)\\n      }\\n      let is_index = match callee {\\n        EIdent(f, _) => is_borrow_arg0_call(f),\\n        _ => false\\n      }\\n      let mut i = 0\\n      while i < Array::length(args) {\\n        let arg = Array::get(args, i)\\n        if is_index && i == 0 {\\n          match arg {\\n            EIdent(obj, _) => pc_count_borrow(ctx, scope, obj),\\n            _ => pc_count(ctx, scope, arg)\\n          }\\n        } else {\\n          pc_count(ctx, scope, arg)\\n        }\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EDot(obj, _field, _) => match obj {\\n      EIdent(x, _) => pc_count_borrow(ctx, scope, x),\\n      _ => pc_count(ctx, scope, obj)\\n    }\\n    ,\\n    ELet(name, value, body) => {\\n      pc_count(ctx, scope, value)\\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\\n      pc_count(ctx, Map::set(scope, name, id), body)\\n    },\\n    ELetMut(name, value, body) => {\\n      pc_count(ctx, scope, value)\\n      let id = pc_declare(ctx, name, is_scalar_expr(ctx, value))\\n      pc_count(ctx, Map::set(scope, name, id), body)\\n    },\\n    ELetRec(name, value, body) => {\\n      let id = pc_declare(ctx, name, false)\\n      let s2 = Map::set(scope, name, id)\\n      pc_count(ctx, s2, value)\\n      pc_count(ctx, s2, body)\\n    },\\n    EAssign(_name, value, body) => {\\n      pc_count(ctx, scope, value)\\n      pc_count(ctx, scope, body)\\n    },\\n    EAssignOp(_op, _name, value, body) => {\\n      pc_count(ctx, scope, value)\\n      pc_count(ctx, scope, body)\\n    },\\n    ESeq(a, b) => {\\n      pc_count(ctx, scope, a)\\n      let nm = next_seq_name(ctx)\\n      let _id = pc_declare(ctx, nm, is_scalar_expr(ctx, a))\\n      pc_count(ctx, scope, b)\\n    },\\n    EBinOp(_op, l, r) => {\\n      pc_count(ctx, scope, l)\\n      pc_count(ctx, scope, r)\\n    },\\n    EUnaryOp(_op, e) => pc_count(ctx, scope, e),\\n    ETuple(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_count(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EArray(items) => {\\n      let mut i = 0\\n      while i < Array::length(items) {\\n        pc_count(ctx, scope, Array::get(items, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    ERecord(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        pc_count(ctx, scope, (Array::get(fields, i)).1)\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      pc_count(ctx, scope, cond)\\n      let snap_u = copy_ints(ctx.uses)\\n      let snap_b = copy_ints(ctx.borrows)\\n      pc_count(ctx, scope, then_e)\\n      let then_u = copy_ints(ctx.uses)\\n      let then_b = copy_ints(ctx.borrows)\\n      restore_prefix(ctx.uses, snap_u)\\n      restore_prefix(ctx.borrows, snap_b)\\n      pc_count(ctx, scope, else_e)\\n      let mut id = 0\\n      while id < Array::length(snap_u) {\\n        let base_u = Array::get(snap_u, id)\\n        let dt = Array::get(then_u, id) - base_u\\n        let de = Array::get(ctx.uses, id) - base_u\\n        Array::set(ctx.uses, id, base_u + int_max(dt, de))\\n        let base_b = Array::get(snap_b, id)\\n        let dtb = Array::get(then_b, id) - base_b\\n        let deb = Array::get(ctx.borrows, id) - base_b\\n        Array::set(ctx.borrows, id, base_b + int_max(dtb, deb))\\n        id = id + 1\\n      }\\n      0\\n    },\\n    EWhile(cond, body) => {\\n      pc_count(ctx, scope, cond)\\n      pc_count(ctx, scope, body)\\n    },\\n    EReturn(e) => pc_count(ctx, scope, e),\\n    EThrow(e) => pc_count(ctx, scope, e),\\n    ESpread(e) => pc_count(ctx, scope, e),\\n    ELabeledArg(_l, _n, e) => pc_count(ctx, scope, e),\\n    EBreak(opt) => match opt {\\n      Some(e) => pc_count(ctx, scope, e),\\n      None => 0\\n    }\\n    ,\\n    EFn(_tp, _tb, params, _ret, _eff, fbody) => {\\n      let caps = collect_free_vars(fbody, fn_param_names(params), [\\n      ])\\n      let mut i = 0\\n      while i < Array::length(caps) {\\n        pc_count_use(ctx, scope, Array::get(caps, i))\\n        i = i + 1\\n      }\\n      0\\n    },\\n    EForIn(value_name, index_opt, iterable, fbody) => {\\n      pc_count(ctx, scope, iterable)\\n      let idv = pc_declare(ctx, value_name, false)\\n      let s2 = Map::set(scope, value_name, idv)\\n      let s3 = match index_opt {\\n        Some(idx) => {\\n          let idi = pc_declare(ctx, idx, true)\\n          Map::set(s2, idx, idi)\\n        },\\n        None => s2\\n      }\\n      pc_count(ctx, s3, fbody)\\n    },\\n    ELoop(params, lbody) => {\\n      let mut s = scope\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let p = Array::get(params, i)\\n        pc_count(ctx, scope, p.1)\\n        let pid = pc_declare(ctx, p.0, is_scalar_expr(ctx, p.1))\\n        s = Map::set(s, p.0, pid)\\n        i = i + 1\\n      }\\n      pc_count(ctx, s, lbody)\\n    },\\n    EMatch(scrut, arms) => {\\n      match scrut {\\n        EIdent(sx, _) => pc_count_borrow(ctx, scope, sx),\\n        _ => pc_count(ctx, scope, scrut)\\n      }\\n      let snap_u = copy_ints(ctx.uses)\\n      let snap_b = copy_ints(ctx.borrows)\\n      let max_u = zeros(Array::length(snap_u))\\n      let max_b = zeros(Array::length(snap_b))\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.uses, snap_u)\\n        restore_prefix(ctx.borrows, snap_b)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pc_declare(ctx, nm, false)\\n          s = Map::set(s, nm, pid)\\n          k = k + 1\\n        }\\n        pc_count(ctx, s, arm.1)\\n        let mut id = 0\\n        while id < Array::length(snap_u) {\\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\\n          if du > Array::get(max_u, id) {\\n            Array::set(max_u, id, du)\\n          }\\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\\n          if db > Array::get(max_b, id) {\\n            Array::set(max_b, id, db)\\n          }\\n          id = id + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.uses, snap_u)\\n      restore_prefix(ctx.borrows, snap_b)\\n      let mut id2 = 0\\n      while id2 < Array::length(snap_u) {\\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\\n        id2 = id2 + 1\\n      }\\n      0\\n    },\\n    EHandle(hbody, arms) => {\\n      let snap_u = copy_ints(ctx.uses)\\n      let snap_b = copy_ints(ctx.borrows)\\n      let max_u = zeros(Array::length(snap_u))\\n      let max_b = zeros(Array::length(snap_b))\\n      pc_count(ctx, scope, hbody)\\n      let mut id0 = 0\\n      while id0 < Array::length(snap_u) {\\n        let du = Array::get(ctx.uses, id0) - Array::get(snap_u, id0)\\n        if du > Array::get(max_u, id0) {\\n          Array::set(max_u, id0, du)\\n        }\\n        let db = Array::get(ctx.borrows, id0) - Array::get(snap_b, id0)\\n        if db > Array::get(max_b, id0) {\\n          Array::set(max_b, id0, db)\\n        }\\n        id0 = id0 + 1\\n      }\\n      let mut a = 0\\n      while a < Array::length(arms) {\\n        let arm = Array::get(arms, a)\\n        restore_prefix(ctx.uses, snap_u)\\n        restore_prefix(ctx.borrows, snap_b)\\n        let pnames: Array[String] = [\\n        ]\\n        pat_names(arm.0, pnames)\\n        let mut s = scope\\n        let mut k = 0\\n        while k < Array::length(pnames) {\\n          let nm = Array::get(pnames, k)\\n          let pid = pc_declare(ctx, nm, false)\\n          s = Map::set(s, nm, pid)\\n          k = k + 1\\n        }\\n        pc_count(ctx, s, arm.1)\\n        let mut id = 0\\n        while id < Array::length(snap_u) {\\n          let du = Array::get(ctx.uses, id) - Array::get(snap_u, id)\\n          if du > Array::get(max_u, id) {\\n            Array::set(max_u, id, du)\\n          }\\n          let db = Array::get(ctx.borrows, id) - Array::get(snap_b, id)\\n          if db > Array::get(max_b, id) {\\n            Array::set(max_b, id, db)\\n          }\\n          id = id + 1\\n        }\\n        a = a + 1\\n      }\\n      restore_prefix(ctx.uses, snap_u)\\n      restore_prefix(ctx.borrows, snap_b)\\n      let mut id2 = 0\\n      while id2 < Array::length(snap_u) {\\n        Array::set(ctx.uses, id2, Array::get(snap_u, id2) + Array::get(max_u, id2))\\n        Array::set(ctx.borrows, id2, Array::get(snap_b, id2) + Array::get(max_b, id2))\\n        id2 = id2 + 1\\n      }\\n      0\\n    },\\n    _ => 0\\n  }\\n}\\n\\nlet pctx_apply_borrow_retention: (PCtx) -> Int = (ctx) -> {\\n  let mut bid = 0\\n  while bid < ctx.next_id {\\n    if Array::get(ctx.borrows, bid) > 0 {\\n      Array::set(ctx.uses, bid, Array::get(ctx.uses, bid) + 1)\\n    } else {\\n      ()\\n    }\\n    bid = bid + 1\\n  }\\n  0\\n}\\n\\nexport let build_perceus_plan: (Expr) -> Array[PerceusAction] = (body) -> {\\n  let ctx = pctx_new()\\n  let empty: Map[String, Int] = map {\\n  }\\n  pc_count(ctx, empty, body)\\n  pctx_apply_borrow_retention(ctx)\\n  ctx.next_id = 0\\n  ctx.seq_id = 0\\n  pc_emit(ctx, empty, body)\\n  ctx.actions\\n}\\n\\nlet collect_heap_ret_fns: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out: Array[String] = [\\n  ]\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(_, _, fname, oty, _) =>\\n      match oty {\\n        Some(ty) =>\\n        match ty {\\n          TyFn(_, ret, _) =>\\n          if type_expr_is_heap(Some(ret)) {\\n            Array::push(out, fname)\\n          } else {\\n            ()\\n          },\\n          _ => ()\\n        },\\n        None => ()\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nexport let elaborate_heap_params: (Array[Stmt]) -> Array[Stmt] = (stmts) -> {\\n  let hctx = HeapInferCtx::{\\n    ctors: collect_ctor_names(stmts),\\n    heap_fns: collect_heap_ret_fns(stmts),\\n  }\\n  let out = Array::slice(stmts, 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let s = Array::get(stmts, i)\\n    let s2 = match s {\\n      SLet(a, b, n, t, e) => SLet(a, b, n, t, elaborate_rw(e, hctx)),\\n      SExpr(e) => SExpr(elaborate_rw(e, hctx)),\\n      _ => s\\n    }\\n    Array::push(out, s2)\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet rec expr_projects_or_matches: (String, Expr) -> Bool = (name, e) -> {\\n  match e {\\n    EDot(obj, _, _) =>\\n    match obj {\\n      EIdent(n, _) => n == name,\\n      _ => expr_projects_or_matches(name, obj)\\n    },\\n    EMatch(scrut, arms) => {\\n      let hit = match scrut {\\n        EIdent(n, _) => n == name,\\n        _ => expr_projects_or_matches(name, scrut)\\n      }\\n      if hit {\\n        true\\n      } else {\\n        let mut i = 0\\n        let mut found = false\\n        while i < Array::length(arms) {\\n          let (_, arm_body) = Array::get(arms, i)\\n          if expr_projects_or_matches(name, arm_body) {\\n            found = true\\n          } else {\\n            ()\\n          }\\n          i = i + 1\\n        }\\n        found\\n      }\\n    },\\n    EHandle(body, arms) => {\\n      let mut i = 0\\n      let mut found = expr_projects_or_matches(name, body)\\n      while i < Array::length(arms) {\\n        let (_, arm_body) = Array::get(arms, i)\\n        if expr_projects_or_matches(name, arm_body) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELet(_, val, body) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\\n    ELetRec(_, val, body) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\\n    ELetMut(_, val, body) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, body),\\n    EAssign(_, val, cont) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\\n    EAssignOp(_, _, val, cont) =>\\n    expr_projects_or_matches(name, val) || expr_projects_or_matches(name, cont),\\n    ESeq(a, b) =>\\n    expr_projects_or_matches(name, a) || expr_projects_or_matches(name, b),\\n    EIf(c, t, el) =>\\n    expr_projects_or_matches(name, c) ||\\n    expr_projects_or_matches(name, t) ||\\n    expr_projects_or_matches(name, el),\\n    EWhile(c, b) =>\\n    expr_projects_or_matches(name, c) || expr_projects_or_matches(name, b),\\n    EForIn(_, _, iter, body) =>\\n    expr_projects_or_matches(name, iter) || expr_projects_or_matches(name, body),\\n    ECall(callee, args, _) => {\\n      let mut i = 0\\n      let mut found = expr_projects_or_matches(name, callee)\\n      while i < Array::length(args) {\\n        if expr_projects_or_matches(name, Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EBinOp(_, l, r) =>\\n    expr_projects_or_matches(name, l) || expr_projects_or_matches(name, r),\\n    EUnaryOp(_, o) => expr_projects_or_matches(name, o),\\n    EFn(_, _, _, _, _, body) => expr_projects_or_matches(name, body),\\n    ETuple(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EArray(elems) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(elems) {\\n        if expr_projects_or_matches(name, Array::get(elems, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELoop(params, body) => {\\n      let mut i = 0\\n      let mut found = expr_projects_or_matches(name, body)\\n      while i < Array::length(params) {\\n        let (_, init) = Array::get(params, i)\\n        if expr_projects_or_matches(name, init) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ERecord(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_projects_or_matches(name, fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EMap(fields) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(fields) {\\n        let (_, fval) = Array::get(fields, i)\\n        if expr_projects_or_matches(name, fval) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    ELabeledArg(_, _, inner) => expr_projects_or_matches(name, inner),\\n    EThrow(inner) => expr_projects_or_matches(name, inner),\\n    EReturn(inner) => expr_projects_or_matches(name, inner),\\n    ESpread(inner) => expr_projects_or_matches(name, inner),\\n    EBreak(opt) =>\\n    match opt {\\n      Some(inner) => expr_projects_or_matches(name, inner),\\n      None => false\\n    },\\n    EContinue(args) => {\\n      let mut i = 0\\n      let mut found = false\\n      while i < Array::length(args) {\\n        if expr_projects_or_matches(name, Array::get(args, i)) {\\n          found = true\\n        } else {\\n          ()\\n        }\\n        i = i + 1\\n      }\\n      found\\n    },\\n    EInt(_) => false,\\n    EFloat(_) => false,\\n    EString(_) => false,\\n    EBool(_) => false,\\n    EIdent(_, _) => false,\\n    EStringInterp(_) => false,\\n    EUnit => false\\n  }\\n}\\n\\nexport let param_is_heap_in_body: (String, Option[TypeExpr], Expr) -> Bool = (name, otype, body,) -> {\\n  if type_expr_is_heap(otype) {\\n    true\\n  } else {\\n    match otype {\\n      None => expr_projects_or_matches(name, body),\\n      Some(_) => false\\n    }\\n  }\\n}\\n\\nexport let build_perceus_plan_with_params: (Array[(String, Option[TypeExpr])], Expr, Array[String]) -> Array[PerceusAction] = (params, body, borrow_ret_names) -> {\\n  let ctx = pctx_new()\\n  let mut bri = 0\\n  while bri < Array::length(borrow_ret_names) {\\n    Array::push(ctx.pctx_names, String::concat(borrow_ret_marker, Array::get(borrow_ret_names, bri)))\\n    bri = bri + 1\\n  }\\n  let mut scope: Map[String, Int] = map {\\n  }\\n  let mut pi = 0\\n  while pi < Array::length(params) {\\n    let (pname, ptype) = Array::get(params, pi)\\n    let id = pc_declare(ctx, pname, !param_is_heap_in_body(pname, ptype, body))\\n    scope = Map::set(scope, pname, id)\\n    pi = pi + 1\\n  }\\n  pc_count(ctx, scope, body)\\n  pctx_apply_borrow_retention(ctx)\\n  ctx.next_id = 0\\n  ctx.seq_id = 0\\n  let mut scope2: Map[String, Int] = map {\\n  }\\n  let param_ids = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut pj = 0\\n  while pj < Array::length(params) {\\n    let (pname, _) = Array::get(params, pj)\\n    let id = pe_declare(ctx, pname)\\n    scope2 = Map::set(scope2, pname, id)\\n    Array::push(param_ids, id)\\n    pj = pj + 1\\n  }\\n  pc_emit(ctx, scope2, body)\\n  let mut pk = 0\\n  while pk < Array::length(params) {\\n    let (pname, _) = Array::get(params, pk)\\n    pe_scope_end(ctx, Array::get(param_ids, pk), pname)\\n    pk = pk + 1\\n  }\\n  ctx.actions\\n}\\n\\n\\n\\n\\n\\n\\n\\nlet emit_mem_size_bytes: (Bytes) -> Unit = (b) -> {\\n  bytebuf_push(b, 63)\\n  bytebuf_push(b, 0)\\n  emit_i64_extend_i32_u(b)\\n  emit_i64_const(b, 65536)\\n  emit_i64_mul(b)\\n}\\n\\nlet emit_looks_like_string: (Bytes, Int) -> Unit = (b, slot) -> {\\n  emit_local_get(b, slot)\\n  emit_i64_const(b, 32)\\n  bytebuf_push(b, 136)\\n  emit_local_get(b, slot)\\n  emit_i64_const(b, 4294967295)\\n  emit_i64_and(b)\\n  emit_i64_add(b)\\n  emit_mem_size_bytes(b)\\n  emit_i64_le_s(b)\\n}\\n\\nexport let gen_eq_body: (Int) -> Bytes = (str_eq_idx) -> {\\n  let b = bytebuf_new()\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_i64_eq(b)\\n  emit_if_i64(b)\\n  emit_i64_const(b, 1)\\n  emit_else(b)\\n  emit_looks_like_string(b, 0)\\n  emit_looks_like_string(b, 1)\\n  bytebuf_push(b, 113)\\n  emit_if_i64(b)\\n  emit_local_get(b, 0)\\n  emit_local_get(b, 1)\\n  emit_call(b, str_eq_idx)\\n  emit_else(b)\\n  emit_i64_const(b, 0)\\n  emit_end(b)\\n  emit_end(b)\\n  b\\n}\\n\\n\\n\\n\\n\\n\\n\\nexport let gen_str_eq_body: () -> Bytes = () -> {\\n  let b = bytebuf_n