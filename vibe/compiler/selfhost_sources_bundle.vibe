    ()\\n    }\\n    i = i + 1\\n  }\\n  c\\n}\\n\\n\\nexport let compile_expr_tail6: (Bytes, Expr, Array[(Pat, Expr)], Array[String], Int, CompileCtx, Int, (Bytes, Expr, Array[String], Int, CompileCtx, Int) -> Int with { Error }) -> Int with { Error } = (buf, body, arms, local_names, next_local, ctx, ld, compile_expr) -> {\\n  if Array::length(arms) > 0 {\\n    let (catch_pat, fallback_expr) = Array::get(arms, 0)\\n    let is_error = is_pctor(catch_pat) && get_pctor_name(catch_pat) == \\\"Error::Throw\\\"\\n    // #665: a handler over a MULTI-operation effect must dispatch the performed\\n    // operation (g_op_index) to the matching arm. Single-operation effects and\\n    // `Error` keep the original single-arm path unchanged.\\n    let handled_eff = if is_pctor(catch_pat) {\\n      let op_full = get_pctor_name(catch_pat)\\n      let sep = String::index_of(op_full, \\\"::\\\")\\n      if sep > 0 {\\n        op_full[0:sep]\\n      } else {\\n        \\\"\\\"\\n      }\\n    } else {\\n      \\\"\\\"\\n    }\\n    let needs_op_dispatch = !is_error && String::length(handled_eff) > 0 && t6_effect_op_count(ctx.effect_op_keys, handled_eff) > 1\\n    let g_op_idx_global = if ctx.enable_rc {\\n      6\\n    } else {\\n      5\\n    }\\n    let catch_tag = if is_error {\\n      2\\n    } else if is_pctor(catch_pat) {\\n      effect_name_to_tag(ctx.effect_names, get_pctor_name(catch_pat))\\n    } else {\\n      3 + Array::length(ctx.effect_names)\\n    }\\n    let uses_frontier = !is_error\\n    // #553: per-effect region stride; MUST match eff_reserve in\\n    // linked_compile.vibe and compile_call.vibe.\\n    let eff_off = (catch_tag - 3) * 131072\\n    let g_rbuf = if ctx.enable_rc {\\n      5\\n    } else {\\n      4\\n    }\\n    let g_cur = if ctx.enable_rc {\\n      3\\n    } else {\\n      2\\n    }\\n    if uses_frontier {\\n      emit_global_get(buf, g_rbuf)\\n      emit_i32_const(buf, eff_off)\\n      emit_i32_add(buf)\\n      emit_i64_const(buf, 0)\\n      emit