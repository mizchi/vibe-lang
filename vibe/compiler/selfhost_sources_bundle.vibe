\\n        EBinOp(wcop, wlhs, wrhs) => if wcop == \\\"==\\\" || wcop == \\\"!=\\\" || wcop == \\\"<\\\" || wcop == \\\">\\\" || wcop == \\\"<=\\\" || wcop == \\\">=\\\" {\\n          let wnl1 = ce(buf, wlhs, local_names, next_local, ld + 1)\\n          let wnl2 = ce(buf, wrhs, local_names, wnl1, ld + 1)\\n          if wcop == \\\"==\\\" {\\n            emit_i64_eq(buf)\\n          }\\n          else if wcop == \\\"!=\\\" {\\n            emit_i64_ne(buf)\\n          }\\n          else if wcop == \\\"<\\\" {\\n            emit_i64_lt_s(buf)\\n          }\\n          else if wcop == \\\">\\\" {\\n            emit_i64_gt_s(buf)\\n          }\\n          else if wcop == \\\"<=\\\" {\\n            emit_i64_le_s(buf)\\n          }\\n          else {\\n            emit_i64_ge_s(buf)\\n          }\\n          emit_i32_eqz(buf)\\n          wnl2\\n        } else {\\n          let wnl = ce(buf, cond, local_names, next_local, ld + 1)\\n          emit_i64_eqz(buf)\\n          wnl\\n        },\\n        _ => {\\n          let wnl = ce(buf, cond, local_names, next_local, ld + 1)\\n          emit_i64_eqz(buf)\\n          wnl\\n        }\\n      }\\n      emit_br_if(buf, 1)\\n      let nl2 = ce(buf, body, local_names, nl1, ld + 1)\\n      emit_drop(buf)\\n      emit_br(buf, 0)\\n      emit_end(buf)\\n      emit_end(buf)\\n      emit_i64_const(buf, 0)\\n      nl2\\n    },\\n    EBreak(_) => {\\n      emit_br(buf, ld + 1)\\n      emit_i64_const(buf, 0)\\n      next_local\\n    },\\n    EContinue(_) => {\\n      emit_br(buf, ld)\\n      emit_i64_const(buf, 0)\\n      next_local\\n    },\\n    EUnit => {\\n      emit_i64_const(buf, 0)\\n      next_local\\n    },\\n    EThrow(msg_expr) => {\\n      let nl = ce(buf, msg_expr, local_names, next_local, ld)\\n      emit_drop(buf)\\n      bytebuf_push(buf, 0)\\n      nl\\n    },\\n    EReturn(ret_expr) => {\\n      let nl = ce(buf, ret_expr, local_names, next_local, ld)\\n      emit_return(buf)\\n      nl\\n    },\\n    EFn(_, _, params, _, _,