 = (a, b) -> { a + b }\"\n  let main_source = \"import ./helpers.vibe { add }\\nlet main: () -> Int = () -> { add(1, 2) }\"\n  let sources = [\n    (\"helpers.vibe\", helper_source)\n  ]\n  let db1 = prepare_modules_cached(db_new(), \"main.vibe\", main_source, sources)\n  let count1 = db_parse_count(db1)\n  let db2 = prepare_modules_cached(db1, \"main.vibe\", main_source, sources)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_codegen_counts: () -> Int with { Error } = () -> {\n  let main_source = \"let main: () -> Int = () -> { 1 + 2 }\"\n  let sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let result1 = compile_with_modules_cached(db_new(), main_source, \"main.vibe\", sources)\n  let db1 = result1.1\n  let count1 = db_codegen_count(db1)\n  let result2 = compile_with_modules_cached(db1, main_source, \"main.vibe\", sources)\n  let db2 = result2.1\n  let count2 = db_codegen_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_fs_parse_counts: () -> Int with { Error, Fs } = () -> {\n  let helper_path = \"_build/persistent_type_env_probe_helper.vibe\"\n  let main_path = \"_build/persistent_type_env_probe_main.vibe\"\n  let helper_source = \"export let add: () -> Int = () -> { 1 }\"\n  let main_source = \"import ./persistent_type_env_probe_helper.vibe { add }\\nlet run: () -> Int = () -> { add() }\"\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n  let main_fp = build_type_db_fingerprint(main_source, [\n    (helper_path, helper_fp)\n  ])\n  Fs::write_bytes(helper_path, string_to_bytes(helper_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  remove_file_if_exists(persistent_dep_list_cache_path(helper_path, compact_string_fingerprint(helper_source)))\n  remove_file_if_exists(persistent_dep_list_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(helper_path, compact_string_fingerprint(helper_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(helper_path, compact_string_fingerprint(helper_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main_fp))\n  let db1 = db_typecheck_fs(db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source), main_path)\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source), main_path)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_group_merge_counts: () -> Int with { Error } = () -> {\n  let groups = [\n    (\"core\", [\n      (\"helpers.vibe\", \"export let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n    ]),\n    (\"entry\", [\n      (\"main.vibe\", \"import ./helpers.vibe { add }\\nlet main: () -> Int = () -> { add(1, 2) }\")\n    ])\n  ]\n  let result1 = db_grouped_merged_source(db_new(), groups)\n  let db1 = result1.2\n  let count1 = db_merge_count(db1)\n  let result2 = db_grouped_merged_source(db1, groups)\n  let db2 = result2.2\n  let count2 = db_merge_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_module_source_counts: () -> Int with { Error } = () -> {\n  let main_source = \"let main: () -> Int = () -> { 1 + 2 }\"\n  let sources = Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n  let result1 = compile_with_modules_cached(db_new(), main_source, \"main_a.vibe\", sources)\n  let db1 = result1.1\n  let count1 = db_module_source_count(db1)\n  let result2 = compile_with_modules_cached(db1, main_source, \"main_b.vibe\", sources)\n  let db2 = result2.1\n  let count2 = db_module_source_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_probe_type_db_fs_multi_dep_parse_counts: () -> Int with { Error, Fs } = () -> {\n  let helper1_path = \"_build/persistent_type_env_multi_dep_helper1.vibe\"\n  let helper2_path = \"_build/persistent_type_env_multi_dep_helper2.vibe\"\n  let main_path = \"_build/persistent_type_env_multi_dep_main.vibe\"\n  let helper1_source = \"export let add1: () -> Int = () -> { 1 }\"\n  let helper2_source = \"export let add2: () -> Int = () -> { 2 }\"\n  let main_source = String::concat(\"import ./persistent_type_env_multi_dep_helper1.vibe { add1 }\\n\", String::concat(\"import ./persistent_type_env_multi_dep_helper2.vibe { add2 }\\n\", \"let run: () -> Int = () -> { add1() + add2() }\"))\n  Fs::write_bytes(helper1_path, string_to_bytes(helper1_source))\n  Fs::write_bytes(helper2_path, string_to_bytes(helper2_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  let helper1_fp = build_type_db_fingerprint(helper1_source, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n  let helper2_fp = build_type_db_fingerprint(helper2_source, Array::slice([\n    (\"\", \"\")\n  ], 0, 0))\n  let main_fp = build_type_db_fingerprint(main_source, [\n    (helper1_path, helper1_fp),\n    (helper2_path, helper2_fp)\n  ])\n  remove_file_if_exists(persistent_dep_list_cache_path(helper1_path, compact_string_fingerprint(helper1_source)))\n  remove_file_if_exists(persistent_dep_list_cache_path(helper2_path, compact_string_fingerprint(helper2_source)))\n  remove_file_if_exists(persistent_dep_list_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(helper1_path, compact_string_fingerprint(helper1_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(helper2_path, compact_string_fingerprint(helper2_source)))\n  remove_file_if_exists(persistent_module_header_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(helper1_path, compact_string_fingerprint(helper1_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(helper2_path, compact_string_fingerprint(helper2_source)))\n  remove_file_if_exists(persistent_leaf_fingerprint_cache_path(main_path, compact_string_fingerprint(main_source)))\n  remove_file_if_exists(persistent_type_env_cache_path(helper1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(helper2_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main_fp))\n  let db1 = db_typecheck_fs(db_set_source(db_set_source(db_set_source(db_new(), helper1_path, helper1_source), helper2_path, helper2_source), main_path, main_source), main_path)\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(db_set_source(db_set_source(db_set_source(db_new(), helper1_path, helper1_source), helper2_path, helper2_source), main_path, main_source), main_path)\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n")
