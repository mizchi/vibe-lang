      Array::push(local_names, \\\"__env\\\")\\n          let param_count = Array::length(params) + 1\\n          let ref_cell_names_f = Array::slice([\\n            \\\"\\\"\\n          ], 0, 0)\\n          let ref_local_indices_f = Array::slice([\\n            0\\n          ], 0, 0)\\n          let ft = FuncTable::{\\n            names: ft_names,\\n            indices: ft_indices,\\n            params: ft_params,\\n            returns: ft_returns,\\n            needs_env: ft_needs_env\\n          }\\n          let st = StrTable::{\\n            strs: str_strs, offsets: str_offsets, lengths: str_lengths\\n          }\\n          let ct = CtorTable::{\\n            names: ctor_names_list, tags: ctor_tags_list, field_counts: ctor_field_counts_list, type_names: ctor_type_names_list, struct_names: struct_names, struct_field_names: struct_field_names\\n          }\\n          let func_ctx = CompileCtxGc::{\\n            func_table: ft, str_table: st, lambda_table: lt_w,\\n            num_user_funcs: num_user_funcs, func_offset: func_offset,\\n            ref_cell_names: ref_cell_names_f, ref_local_indices: ref_local_indices_f,\\n            refcell_type_idx: refcell_type_idx, closure_type_base: closure_type_base,\\n            ctor_table: ct\\n          }\\n          let final_nl = compile_expr_gc(body_buf, body, local_names, param_count, func_ctx, -1)\\n          Array::push(bodies, body_buf)\\n          let extra = if final_nl > param_count {\\n            final_nl - param_count\\n          } else {\\n            0\\n          }\\n          Array::push(meta_i32, 0)\\n          Array::push(meta_i64, extra)\\n          Array::push(user_ref_local_indices_all, ref_local_indices_f)\\n        },\\n        _ => throw(\\\"expected function\\\")\\n      }\\n      ,\\n      _ => throw(\\\"expected let statement\\\")\\n    }\\n    bi = bi + 1\\n  }\\n  let num_lambdas = Array::length(lt_w.bodies)\\n  let start_body = bytebuf_new()\\n  let entry_func_idx = entry_user_idx + func_offset\\n  let entry_params = Array::get(ft_params, entry_user_idx)\\n  if entry_params != 0 {\\n    throw(\\\"WASI entry function must take 0 parameters\\\")\\n  }\\n  emit_i64_const(start_body, 0)\\n  emit_call(start_body, entry_func_idx)\\n  emit_call(start_body, 1)\\n  Array::push(bodies, start_body)\\n  Array::push(meta_i32, 0)\\n  Array::push(meta_i64, 0)\\n  Array::push(user_ref_local_indices_all, Array::slice([\\n    0\\n  ], 0, 0))\\n  let mut li = 0\\n  while li < num_lambdas {\\n    Array::push(bodies, Array::get(lt_w.bodies, li))\\n    Array::push(meta_i32, Array::get(lt_w.meta_i32, li))\\n    Array::push(meta_i64, Array::get(lt_w.meta_i64, li))\\n    Array::push(user_ref_local_indices_all, Array::slice([\\n      0\\n    ], 0, 0))\\n    li = li + 1\\n  }\\n  let mut max_closure_arity = -1\\n  let mut lai = 0\\n  while lai < num_lambdas {\\n    let lpc = Array::get(lt_w.param_counts, lai) - 1\\n    if lpc > max_closure_arity {\\n      max_closure_arity = lpc\\n    }\\n    lai = lai + 1\\n  }\\n  let mut uai2 = 0\\n  while uai2 < num_user_funcs {\\n    let upc = Array::get(ft_params, uai2)\\n    if upc > max_closure_arity {\\n      max_closure_arity = upc\\n    }\\n    uai2 = uai2 + 1\\n  }\\n  let num_closure_types = if max_closure_arity >= 0 {\\n    max_closure_arity + 1\\n  } else {\\n    0\\n  }\\n  let num_base_types = 11\\n  let type_content = bytebuf_new()\\n  bytebuf_push_vec_header(type_content, num_base_types + num_closure_types)\\n  emit_func_type_raw(type_content, [\\n    127,\\n    127,\\n    127,\\n    127\\n  ], [\\n    127\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, Array::slice([\\n    0\\n  ], 0, 0), [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126\\n  ], [\\n    126\\n  ])\\n  emit_func_type_raw(type_content, [\\n    126,\\n    126,\\n    126,\\n    126\\n  ], Array::slice([\\n    0\\n  ], 0, 0))\\n  emit_struct_type_raw(type_content, [\\n    126\\n  ], [\\n    1\\n  ])\\n  let mut cti = 0\\n  while cti < num_closure_types {\\n    let num_params = cti + 1\\n    let ct_params = Array::slice([\\n      0\\n    ], 0, 0)\\n    let mut cpti = 0\\n    while cpti < num_params {\\n      Array::push(ct_params, 126)\\n      cpti = cpti + 1\\n    }\\n    emit_func_type_raw(type_content, ct_params, [\\n      126\\n    ])\\n    cti = cti + 1\\n  }\\n  let out = bytebuf_new()\\n  emit_header(out)\\n  bytebuf_push_section(out, 1, type_content)\\n  emit_import_section_func(out, \\\"wasi_snapshot_preview1\\\", \\\"fd_write\\\", 0)\\n  let func_type_indices = Array::slice([\\n    0\\n  ], 0, 0)\\n  Array::push(func_type_indices, 1)\\n  Array::push(func_type_indices, 1)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 5)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 7)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 5)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 7)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 6)\\n  Array::push(func_type_indices, 4)\\n  Array::push(func_type_indices, 8)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 3)\\n  Array::push(func_type_indices, 9)\\n  Array::push(func_type_indices, 7)\\n  let mut fti = 0\\n  while fti < num_user_funcs {\\n    let upc = Array::get(ft_params, fti)\\n    Array::push(func_type_indices, closure_type_base + upc)\\n    fti = fti + 1\\n  }\\n  Array::push(func_type_indices, 2)\\n  let mut lfi = 0\\n  while lfi < num_lambdas {\\n    let lam_user_params = Array::get(lt_w.param_counts, lfi) - 1\\n    Array::push(func_type_indices, closure_type_base + lam_user_params)\\n    lfi = lfi + 1\\n  }\\n  emit_function_section(out, func_type_indices)\\n  let total_table_entries = num_user_funcs + num_lambdas\\n  if total_table_entries > 0 {\\n    emit_table_section_funcref(out, total_table_entries)\\n  }\\n  emit_memory_section(out, 1)\\n  emit_global_section_i32_mut(out, heap_start)\\n  let start_func_idx = func_offset + num_user_funcs\\n  emit_exports_with_memory(out, [\\n    \\\"_start\\\"\\n  ], [\\n    start_func_idx\\n  ], \\\"memory\\\", 0)\\n  if total_table_entries > 0 {\\n    let table_func_indices = Array::slice([\\n      0\\n    ], 0, 0)\\n    let mut tei = 0\\n    while tei < num_user_funcs {\\n      Array::push(table_func_indices, func_offset + tei)\\n      tei = tei + 1\\n    }\\n    let mut tej = 0\\n    while tej < num_lambdas {\\n      Array::push(table_func_indices, start_func_idx + 1 + tej)\\n      tej = tej + 1\\n    }\\n    emit_element_section_active(out, table_func_indices)\\n  }\\n  let code_content = bytebuf_new()\\n  bytebuf_push_vec_header(code_content, Array::length(bodies))\\n  let mut ci = 0\\n  while ci < Array::length(bodies) {\\n    let body = Array::get(bodies, ci)\\n    let func_buf = bytebuf_new()\\n    let ni32 = Array::get(meta_i32, ci)\\n    let ni64 = Array::get(meta_i64, ci)\\n    let ref_indices = Array::get(user_ref_local_indices_all, ci)\\n    let num_ref_locals = Array::length(ref_indices)\\n    if num_ref_locals == 0 {\\n      if ni32 == 0 {\\n        if ni64 == 0 {\\n          leb128_encode_u32(func_buf, 0)\\n        } else {\\n          leb128_encode_u32(func_buf, 1)\\n          leb128_encode_u32(func_buf, ni64)\\n          bytebuf_push(func_buf, 126)\\n        }\\n      } else {\\n        if ni64 == 0 {\\n          leb128_encode_u32(func_buf, 1)\\n          leb128_encode_u32(func_buf, ni32)\\n          bytebuf_push(func_buf, 127)\\n        } else {\\n          leb128_encode_u32(func_buf, 2)\\n          leb128_encode_u32(func_buf, ni32)\\n          bytebuf_push(func_buf, 127)\\n          leb128_encode_u32(func_buf, ni64)\\n          bytebuf_push(func_buf, 126)\\n        }\\n      }\\n    } else {\\n      let body_idx_in_user = ci - num_generated\\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\\n      let num_extra = ni64\\n      leb128_encode_u32(func_buf, num_extra)\\n      let mut rli = 0\\n      while rli < num_extra {\\n        let actual_local_idx = param_count_for_body + rli\\n        let mut is_ref = false\\n        let mut ri = 0\\n        while ri < num_ref_locals {\\n          if Array::get(ref_indices, ri) == actual_local_idx {\\n            is_ref = true\\n          }\\n          ri = ri + 1\\n        }\\n        leb128_encode_u32(func_buf, 1)\\n        if is_ref {\\n          bytebuf_push(func_buf, 100)\\n          leb128_encode_u32(func_buf, refcell_type_idx)\\n        } else {\\n          bytebuf_push(func_buf, 126)\\n        }\\n        rli = rli + 1\\n      }\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(code_content, func_buf)\\n    ci = ci + 1\\n  }\\n  bytebuf_push_section(out, 10, code_content)\\n  if num_strings > 0 {\\n    let data_offsets = Array::slice([\\n      0\\n    ], 0, 0)\\n    let data_bufs = fresh_bytes_array()\\n    let mut di = 0\\n    while di < num_strings {\\n      Array::push(data_offsets, Array::get(str_offsets, di))\\n      Array::push(data_bufs, string_to_data(Array::get(str_strs, di)))\\n      di = di + 1\\n    }\\n    emit_data_section_multi(out, data_offsets, data_bufs)\\n  }\\n  bytebuf_to_bytes(out)\\n}\\nexport let compile_source_gc_only: (String, String) -> Bytes with { Error } = (source, entry_name) -> {\\n  let tokens = lex(source)\\n  let stmts = parse_program(tokens)\\n  let _ = check_program(stmts)\\n  compile_wasi_module_gc(stmts, entry_name)\\n}\\nexport let build_module_source_from_source: (String, String) -> String with { Error } = (source, entry_name) -> {\\n  let lexed = lex_with_offsets(source)\\n  let tokens = lexed.0\\n  let starts = lexed.1\\n  let ends = lexed.2\\n  let parsed = parse_program_spans(tokens, starts, ends)\\n  let stmts = parsed.0\\n  let span_start = parsed.1\\n  let span_end = parsed.2\\n  let keep = dce_keep_flags(stmts, [entry_name])\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    if Array::get(keep, i) {\\n      let s = Array::get(span_start, i)\\n      let e = Array::get(span_end, i)\\n      if e > s {\\n        let snippet = String::substring(source, s, e)\\n        StringBuilder::push(buf, snippet)\\n        let n = String::length(snippet)\\n        if n == 0 || String::char_code_at(snippet, n - 1) != '\\\\n' {\\n          StringBuilder::push(buf, \\\"\\\\n\\\")\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\nexport let build_funcmap_from_source: (String) -> String with { Error } = (source) -> {\\n  let lexed = lex_with_offsets(source)\\n  let tokens = lexed.0\\n  let starts = lexed.1\\n  let ends = lexed.2\\n  let parsed = parse_program_spans(tokens, starts, ends)\\n  let stmts = parsed.0\\n  let span_start = parsed.1\\n  let buf = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let stmt = Array::get(stmts, i)\\n    let entry = match stmt {\\n      SLet(_, _, name, _, expr) => match expr {\\n        EFn(_, _, _, _, _, _) => {\\n          let off = Array::get(span_start, i)\\n          let lc = offset_to_line_col(source, off)\\n          let line = lc.0\\n          String::concat(name, String::concat(\\\"\\\\t\\\", String::concat(__to_string(line), \\\"\\\\n\\\")))\\n        },\\n        _ => \\\"\\\"\\n      },\\n      _ => \\\"\\\"\\n    }\\n    StringBuilder::push(buf, entry)\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\nexport let compile_wasi_module: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_impl(stmts, entry_name)\\n}\\nexport let compile_wasi_module_rc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_rc_impl(stmts, entry_name)\\n}\\nexport let compile_wasi_module_coverage: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_coverage_impl(stmts, entry_name)\\n}\\nexport let compile_wasi_module_trace: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_trace_impl(stmts, entry_name)\\n}\\nexport let compile_wasi_module_break: (Array[Stmt], String, DbgProv) -> Bytes with { Error } = (stmts, entry_name, prov) -> {\\n  compile_wasi_module_break_impl(stmts, entry_name, prov)\\n}\\nexport let compile_wasi_module_rc: (Array[Stmt], String) -> Bytes with { Error } = (stmts, entry_name) -> {\\n  compile_wasi_module_rc_impl(stmts, entry_name)\\n}\\nexport let contains_str: (Array[String], String) -> Bool = (arr, target) -> {\\n  let rec go: (Int) -> Bool = (i) -> {\\n    if i >= Array::length(arr) {\\n      false\\n    }\\n    else {\\n      if Array::get(arr, i) == target {\\n        true\\n      }\\n      else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\nexport let collect_exports: (Array[Stmt]) -> Array[String] = (stmts) -> {\\n  let out = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SLet(true, _, name, _, _) => Array::push(out, name),\\n      SEnum(true, _, _, variants, _) => {\\n        let mut j = 0\\n        while j < Array::length(variants) {\\n          let (cname, _) = Array::get(variants, j)\\n          Array::push(out, cname)\\n          j = j + 1\\n        }\\n      },\\n      SExport(names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          Array::push(out, Array::get(names, j))\\n          j = j + 1\\n        }\\n      },\\n      SReExport(_, names) => {\\n        let mut j = 0\\n        while j < Array::length(names) {\\n          let (name, _) = Array::get(names, j)\\n          Array::push(out, name)\\n          j = j + 1\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\nlet has_prefix: (String, String) -> Bool = (line, prefix) -> {\\n  let prefix_len = String::length(prefix)\\n  if String::length(line) < prefix_len {\\n    false\\n  } else {\\n    let mut ok = true\\n    let mut i = 0\\n    while ok && i < prefix_len {\\n      ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\nlet strip_trailing_cr: (String) -> String = (line) -> {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0: len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\nlet parse_persistent_module_header_line: (Array[String], Array[String], String, Bool) -> Bool with { Error } = (deps, exports, line, saw_version) -> {\\n  if String::length(line) == 0 {\\n    saw_version\\n  } else if has_prefix(line, \\\"version\\\\t\\\") {\\n    let value = line[8: String::length(line)]\\n    if !(value == \\\"1\\\") {\\n      throw(\\\"invalid persistent module header version\\\")\\n    }\\n    true\\n  } else if has_prefix(line, \\\"dep\\\\t\\\") {\\n    let value = line[4: String::length(line)]\\n    if String::length(value) == 0 {\\n      throw(\\\"invalid persistent module header dep row\\\")\\n    } else {\\n      Array::push(deps, value)\\n      saw_version\\n    }\\n  } else if has_prefix(line, \\\"export\\\\t\\\") {\\n    let value = line[7: String::length(line)]\\n    if String::length(value) == 0 {\\n      throw(\\\"invalid persistent module header export row\\\")\\n    } else {\\n      Array::push(exports, value)\\n      saw_version\\n    }\\n  } else {\\n    throw(String::concat(\\\"invalid persistent module header row: \\\", line))\\n  }\\n}\\nexport let persistent_module_header_text: (Array[String], Array[String]) -> String = (deps, exports) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"version\\\\t1\\\\n\\\")\\n  let mut i = 0\\n  while i < Array::length(deps) {\\n    StringBuilder::push(buf, \\\"dep\\\\t\\\")\\n    StringBuilder::push(buf, Array::get(deps, i))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    i = i + 1\\n  }\\n  let mut j = 0\\n  while j < Array::length(exports) {\\n    StringBuilder::push(buf, \\\"export\\\\t\\\")\\n    StringBuilder::push(buf, Array::get(exports, j))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    j = j + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\nexport let parse_persistent_module_header_text: (String) -> (Array[String], Array[String]) with { Error } = (raw) -> {\\n  let deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let exports = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut saw_version = false\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  while i < len {\\n    if String::char_code_at(raw, i) == 10 {\\n      let line = strip_trailing_cr(raw[line_start: i])\\n      saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  let line = strip_trailing_cr(raw[line_start: len])\\n  saw_version = parse_persistent_module_header_line(deps, exports, line, saw_version)\\n  if !saw_version {\\n    throw(\\\"missing persistent module header version\\\")\\n  } else {\\n    (deps, exports)\\n  }\\n}\\nexport let selfhost_codegen_fingerprint: () -> String = () -> {\\n  \\\"9706cb6f901dd9f8\\\"\\n}\\nexport let compact_string_fingerprint: (String) -> String = (source) -> {\\n  let mod1 = 2147483647\\n  let mod2 = 2147483629\\n  let step1 = 131\\n  let step2 = 65599\\n  let len = String::length(source)\\n  let mut h1 = 17\\n  let mut h2 = 29\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(source, i)\\n    h1 = (h1 * step1 + c + 1) % mod1\\n    h2 = (h2 * step2 + c + i + 1) % mod2\\n    i = i + 1\\n  }\\n  String::concat(__to_string(len), String::concat(\\\":\\\", String::concat(__to_string(h1), String::concat(\\\":\\\", __to_string(h2)))))\\n}\\nlet persistent_cache_version_tag: () -> String = () -> {\\n  String::concat(\\\"v11|cg-\\\", selfhost_codegen_fingerprint())\\n}\\nlet stable_cache_path: (String, String, String) -> String = (prefix, seed, suffix) -> {\\n  let raw = compact_string_fingerprint(String::concat(\\\"persistent-cache-\\\", String::concat(persistent_cache_version_tag(), String::concat(\\\"|\\\", seed))))\\n  let token_sb = StringBuilder::new()\\n  let mut i = 0\\n  while i < String::length(raw) {\\n    let c = String::char_code_at(raw, i)\\n    let piece = if c == 58 {\\n      \\\"_\\\"\\n    } else {\\n      String::from_char_code(c)\\n    }\\n    StringBuilder::push(token_sb, piece)\\n    i = i + 1\\n  }\\n  let token = StringBuilder::freeze(token_sb)\\n  String::concat(\\\"_build/vibe_\\\", String::concat(prefix, String::concat(\\\"_\\\", String::concat(token, suffix))))\\n}\\nexport let persistent_dep_list_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_dep_list\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\nexport let persistent_type_env_cache_path: (String) -> String = (fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_type_env_v2\\\", fingerprint, \\\".tsv\\\")\\n}\\nexport let normalize_persistent_cache_text: (String) -> String = (text) -> {\\n  let len = String::length(text)\\n  let mut start = 0\\n  while start < len && String::char_code_at(text, start) == 0 {\\n    start = start + 1\\n  }\\n  if start == 0 {\\n    text\\n  } else {\\n    text[start: len]\\n  }\\n}\\nexport let persistent_source_list_cache_path: (String) -> String = (entry_path) -> {\\n  stable_cache_path(\\\"selfhost_source_list\\\", entry_path, \\\".tsv\\\")\\n}\\nexport let persistent_source_group_cache_path: (String) -> String = (entry_path) -> {\\n  stable_cache_path(\\\"selfhost_source_groups\\\", entry_path, \\\".tsv\\\")\\n}\\nexport let persistent_module_header_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_module_header_v2\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\nexport let persistent_manifest_header_cache_path: (String) -> String = (entry_path) -> {\\n  stable_cache_path(\\\"selfhost_manifest_headers\\\", entry_path, \\\".tsv\\\")\\n}\\nexport let persistent_leaf_fingerprint_cache_path: (String, String) -> String = (path, source_fingerprint) -> {\\n  stable_cache_path(\\\"selfhost_leaf_fp_v2\\\", String::concat(path, String::concat(\\\"|\\\", source_fingerprint)), \\\".tsv\\\")\\n}\\nexport let dir_of_path: (String) -> String = (file_path) -> {\\n  let idx = String::last_index_of(file_path, \\\"/\\\")\\n  if idx < 0 {\\n    \\\"\\\"\\n  } else if idx == 0 {\\n    \\\"/\\\"\\n  } else {\\n    file_path[0: idx]\\n  }\\n}\\nexport let contains_path: (Array[String], String) -> Bool = (visited, path) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(visited) && !found {\\n    if Array::get(visited, i) == path {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\nexport let normalize_path: (String) -> String = (path) -> {\\n  let is_absolute = String::length(path) > 0 && String::char_code_at(path, 0) == 47\\n  let mut parts = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let len = String::length(path)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_sep = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(path, i) == 47\\n    }\\n    if at_sep {\\n      let part = path[start: i]\\n      let skip_part = if String::length(part) == 0 {\\n        true\\n      } else {\\n        part == \\\".\\\"\\n      }\\n      if skip_part {\\n        ()\\n      } else if part == \\\"..\\\" {\\n        if Array::length(parts) > 0 {\\n          Array::truncate(parts, Array::length(parts) - 1)\\n        }\\n      } else {\\n        Array::push(parts, part)\\n      }\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  let buf = StringBuilder::new()\\n  if is_absolute {\\n    StringBuilder::push(buf, \\\"/\\\")\\n  }\\n  let mut pi = 0\\n  while pi < Array::length(parts) {\\n    if pi > 0 {\\n      StringBuilder::push(buf, \\\"/\\\")\\n    }\\n    StringBuilder::push(buf, Array::get(parts, pi))\\n    pi = pi + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\nlet join_relative_path: (String, String) -> String = (base_dir, raw_path) -> {\\n  if base_dir == \\\"\\\" || base_dir == \\\"/\\\" {\\n    String::concat(base_dir, raw_path)\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", raw_path))\\n  }\\n}\\nexport let path_has_relative_prefix: (String, Int) -> Bool = (raw_path, len) -> {\\n  if len >= 2 {\\n    if raw_path[0: 2] == \\\"./\\\" {\\n      true\\n    } else if len >= 3 {\\n      raw_path[0: 3] == \\\"../\\\"\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n}\\nexport let resolve_import_path: (String, String) -> String = (base_dir, raw_path) -> {\\n  let len = String::length(raw_path)\\n  let joined = if path_has_relative_prefix(raw_path, len) {\\n    join_relative_path(base_dir, raw_path)\\n  } else {\\n    raw_path\\n  }\\n  let normalized = normalize_path(joined)\\n  if String::ends_with(normalized, \\\".vibe\\\") {\\n    normalized\\n  } else {\\n    String::concat(normalized, \\\".vibe\\\")\\n  }\\n}\\nexport let resolve_import_path_candidates: (String, String) -> Array[String] = (base_dir, raw_path) -> {\\n  let len = String::length(raw_path)\\n  let joined = if path_has_relative_prefix(raw_path, len) {\\n    join_relative_path(base_dir, raw_path)\\n  } else {\\n    raw_path\\n  }\\n  let normalized = normalize_path(joined)\\n  if String::ends_with(normalized, \\\".vibe\\\") {\\n    [\\n      normalized\\n    ]\\n  } else {\\n    [\\n      String::concat(normalized, \\\".vibe\\\"),\\n      String::concat(normalized, \\\"/index.vibe\\\")\\n    ]\\n  }\\n}\\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut i = 0\\n  let mut found = \\\"\\\"\\n  while i < Array::length(candidates) {\\n    if found == \\\"\\\" {\\n      let candidate = Array::get(candidates, i)\\n      if Fs::exists(candidate) {\\n        found = candidate\\n      }\\n    }\\n    i = i + 1\\n  }\\n  if found == \\\"\\\" {\\n    Array::get(candidates, 0)\\n  } else {\\n    found\\n  }\\n}\\nlet is_special_bundle_path: (String) -> Bool = (path) -> {\\n  String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\") || String::ends_with(path, \\\"selfhost_cli_adapter_bundle.vibe\\\") || String::ends_with(path, \\\"selfbuild_runtime_entry_bundle.vibe\\\")\\n}\\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\\n  if String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfhost_sources\\\",\\n      \\\"selfhost_source_groups\\\"\\n    ]))\\n  } else if String::ends_with(path, \\\"selfhost_cli_adapter_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfhost_cli_adapter_sources\\\",\\n      \\\"selfhost_cli_adapter_source_groups\\\",\\n      \\\"selfhost_cli_adapter_ordered_sources\\\",\\n      \\\"selfhost_cli_adapter_merged_source\\\",\\n      \\\"selfhost_cli_adapter_module_source\\\"\\n    ]))\\n  } else if String::ends_with(path, \\\"selfbuild_runtime_entry_bundle.vibe\\\") {\\n    Some((Array::slice([\\n      \\\"\\\"\\n    ], 0, 0), [\\n      \\\"selfbuild_runtime_entry_source\\\"\\n    ]))\\n  } else {\\n    None\\n  }\\n}\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\\n  let deps = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  deps\\n}\\nexport let load_or_parse_module_header_fs_impl: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\\n  if Fs::exists(cache_path) {\\n    let parsed = parse_persistent_module_header_text(normalize_persistent_cache_text(Fs::read_file(cache_path)))\\n    (parsed.0, parsed.1, parse_count)\\n  } else {\\n    let header_result = if is_special_bundle_path(path) {\\n      match special_bundle_header(path) {\\n        Some(pair) => {\\n          let deps = pair.0\\n          let exports = pair.1\\n          (deps, exports, parse_count)\\n        },\\n        None => (Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), Array::slice([\\n          \\\"\\\"\\n        ], 0, 0), parse_count)\\n      }\\n    } else {\\n      let (tokens, starts, _ends) = lex_with_offsets(source)\\n      let stmts = handle {\\n        parse_program_located(tokens, starts, source)\\n      } with Error {\\n        Throw(msg) => throw(String::concat(path, String::concat(\\\": \\\", msg)))\\n      }\\n      (collect_import_deps_from_stmts(stmts, dir_of_path(path)), collect_exports(stmts), parse_count + 1)\\n    }\\n    let deps = header_result.0\\n    let exports = header_result.1\\n    let next_parse_count = header_result.2\\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))\\n    (deps, exports, next_parse_count)\\n  }\\n}\\nimport . / header_cache.vibe {\\n  load_or_parse_module_header_fs_impl\\n}\\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\\n  if base_dir == \\\"\\\" {\\n    rel_path\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", rel_path))\\n  }\\n}\\nlet resolve_manifest_dep_path: (String, String, Map[String, Bool]) -> String with { Error, Fs } = (base_dir, raw_path, manifest_path_index) -> {\\n  if String::length(raw_path) > 0 && String::char_code_at(raw_path, 0) == 64 {\\n    raw_path\\n  } else {\\n    let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n    let mut i = 0\\n    let mut found = \\\"\\\"\\n    while i < Array::length(candidates) {\\n      if found == \\\"\\\" {\\n        let candidate = Array::get(candidates, i)\\n        if Map::has_key(manifest_path_index, candidate) || Fs::exists(candidate) {\\n          found = candidate\\n        }\\n      }\\n      i = i + 1\\n    }\\n    if found == \\\"\\\" {\\n      Array::get(candidates, 0)\\n    } else {\\n      found\\n    }\\n  }\\n}\\nlet starts_with_reexport_path_token: (Token) -> Bool = (tok) -> {\\n  match tok {\\n    TDot => true,\\n    _ => false\\n  }\\n}\\nlet is_ident_char: (Int) -> Bool = (c) -> {\\n  (c >= 'a' && c <= 'z') ||\\n    (c >= 'A' && c <= 'Z') ||\\n    (c >= '0' && c <= '9') ||\\n    c == '_'\\n}\\nlet slice_eq_text: (String, Int, String) -> Bool = (s, start, text) -> {\\n  let text_len = String::length(text)\\n  if start + text_len > String::length(s) {\\n    false\\n  } else {\\n    let mut i = 0\\n    let mut ok = true\\n    while ok && i < text_len {\\n      ok = String::char_code_at(s, start + i) == String::char_code_at(text, i)\\n      i = i + 1\\n    }\\n    ok\\n  }\\n}\\nlet starts_with_keyword_at: (String, Int, String) -> Bool = (s, pos, keyword) -> {\\n  let keyword_len = String::length(keyword)\\n  if !(slice_eq_text(s, pos, keyword)) {\\n    false\\n  } else {\\n    let before_ok = if pos == 0 {\\n      true\\n    } else {\\n      !(is_ident_char(String::char_code_at(s, pos - 1)))\\n    }\\n    let after_pos = pos + keyword_len\\n    let after_ok = if after_pos >= String::length(s) {\\n      true\\n    } else {\\n      !(is_ident_char(String::char_code_at(s, after_pos)))\\n    }\\n    before_ok && after_ok\\n  }\\n}\\nlet skip_header_ws_and_comments: (String, Int, Int) -> Int = (s, len, start) -> {\\n  let mut pos = start\\n  let mut done = false\\n  while !done && pos < len {\\n    let c = String::char_code_at(s, pos)\\n    if c == ' ' || c == '\\\\n' || c == '\\\\t' || c == '\\\\r' || c == ';' {\\n      pos = pos + 1\\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\\n      pos = pos + 2\\n      while pos < len && String::char_code_at(s, pos) != '\\\\n' {\\n        pos = pos + 1\\n      }\\n    } else {\\n      done = true\\n    }\\n  }\\n  pos\\n}\\nlet scan_header_stmt_end: (String, Int, Int) -> Int with { Error } = (s, len, start) -> {\\n  let mut pos = start\\n  let mut brace_depth = 0\\n  let mut in_string = false\\n  let mut string_quote = 0\\n  let mut escape = false\\n  let mut done = false\\n  while pos < len && !done {\\n    let c = String::char_code_at(s, pos)\\n    if in_string {\\n      if escape {\\n        escape = false\\n      } else if c == '\\\\\\\\' {\\n        escape = true\\n      } else if c == string_quote {\\n        in_string = false\\n      }\\n      pos = pos + 1\\n    } else if c == '\\\"' || c == '\\\\'' {\\n      in_string = true\\n      string_quote = c\\n      pos = pos + 1\\n    } else if c == '/' && pos + 1 < len && String::char_code_at(s, pos + 1) == '/' {\\n      while pos < len && String::char_code_at(s, pos) != '\\\\n' {\\n        pos = pos + 1\\n      }\\n    } else if c == '{' {\\n      brace_depth = brace_depth + 1\\n      pos = pos + 1\\n    } else if c == '}' {\\n      if brace_depth > 0 {\\n        brace_depth = brace_depth - 1\\n      }\\n      pos = pos + 1\\n    } else if brace_depth == 0 && (c == '\\\\n' || c == ';') {\\n      done = true\\n    } else {\\n      pos = pos + 1\\n    }\\n  }\\n  pos\\n}\\nlet skip_brace_list: (Array[Token], Int) -> Int with { Error } = (tokens, pos) -> {\\n  match peek(tokens, pos) {\\n    TLBrace => {\\n      let mut depth = 1\\n      let mut i = pos + 1\\n      while depth > 0 {\\n        match peek(tokens, i) {\\n          TLBrace => {\\n            depth = depth + 1\\n          },\\n          TRBrace => {\\n            depth = depth - 1\\n          },\\n          TEof => throw(\\\"unterminated brace list in manifest import scanner\\\"),\\n          _ => ()\\n        }\\n        i = i + 1\\n      }\\n      i\\n    }\\n    _ => throw(\\\"expected '{' in manifest import scanner\\\")\\n  }\\n}\\nlet scan_header_import_dep: (Array[Token], Int, String, Map[String, Bool]) -> (String, Int) with { Error, Fs } = (tokens, pos, base_dir, manifest_path_index) -> {\\n  let (raw_path, next_pos) = match peek(tokens, pos) {\\n    TIdent(name) =>\\n      if String::length(name) > 1 && String::char_code_at(name, 0) == 64 {\\n        (name, pos + 1)\\n      } else {\\n        collect_import_path(tokens, pos, \\\"\\\")\\n      },\\n    _ => collect_import_path(tokens, pos, \\\"\\\")\\n  }\\n  let after_path = match peek(tokens, next_pos) {\\n    TIdent(alias_name) =>\\n      if String::length(alias_name) > 1 && String::char_code_at(alias_name, 0) == 64 {\\n        next_pos + 1\\n      } else {\\n        next_pos\\n      },\\n    _ => next_pos\\n  }\\n  let end_pos = match peek(tokens, after_path) {\\n    TLBrace => skip_brace_list(tokens, after_path),\\n    _ => after_path\\n  }\\n  (resolve_manifest_dep_path(base_dir, raw_path, manifest_path_index), end_pos)\\n}\\nlet collect_manifest_header_deps_from_source: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\\n  let deps = Array::slice([\\\"\\\"], 0, 0)\\n  let base_dir = dir_of_path(path)\\n  let len = String::length(source)\\n  let mut pos = 0\\n  let mut done = false\\n  while !done {\\n    pos = skip_header_ws_and_comments(source, len, pos)\\n    if pos >= len {\\n      done = true\\n    } else {\\n      let is_import = starts_with_keyword_at(source, pos, \\\"import\\\")\\n      let is_export = starts_with_keyword_at(source, pos, \\\"export\\\")\\n      if !(is_import || is_export) {\\n        done = true\\n      } else {\\n        let stmt_end = scan_header_stmt_end(source, len, pos)\\n        let stmt_source = source[pos:stmt_end]\\n        let tokens = lex(stmt_source)\\n        let stmt_pos = skip_semi(tokens, 0)\\n        match peek(tokens, stmt_pos) {\\n          TImport => {\\n            let (dep_path, _) = scan_header_import_dep(\\n              tokens,\\n              stmt_pos + 1,\\n              base_dir,\\n              manifest_path_index\\n            )\\n            Array::push(deps, dep_path)\\n          },\\n          TExport => {\\n            if starts_with_reexport_path_token(peek(tokens, stmt_pos + 1)) {\\n              let (dep_path, _) = scan_header_import_dep(\\n                tokens,\\n                stmt_pos + 1,\\n                base_dir,\\n                manifest_path_index\\n              )\\n              Array::push(deps, dep_path)\\n            }\\n          },\\n          _ => {\\n            done = true\\n          }\\n        }\\n        pos = stmt_end\\n      }\\n    }\\n  }\\n  deps\\n}\\nlet collect_manifest_header_deps_from_source_with_context: (String, String, Map[String, Bool]) -> Array[String] with { Error, Fs } = (path, source, manifest_path_index) -> {\\n  handle {\\n    collect_manifest_header_deps_from_source(path, source, manifest_path_index)\\n  } with Error {\\n    Throw(err) => throw(\\\"manifest header scan failed for \\\" + path + \\\": \\\" + err)\\n  }\\n}\\nlet is_manifest_external_terminal_dep: (String) -> Bool = (path) -> {\\n  String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\")\\n}\\nlet should_schedule_manifest_dep: (String, Map[String, Bool]) -> Bool = (dep_path, manifest_path_index) -> {\\n  if Map::has_key(manifest_path_index, dep_path) {\\n    true\\n  } else {\\n    !(is_manifest_external_terminal_dep(dep_path))\\n  }\\n}\\nlet load_or_parse_module_header_deps_with_context: (String, String) -> Array[String] with { Error, Fs } = (path, source) -> {\\n  handle {\\n    let (deps, _, _) = load_or_parse_module_header_fs_impl(path, source, 0)\\n    deps\\n  } with Error {\\n    Throw(err) => throw(\\\"module header parse failed for \\\" + path + \\\": \\\" + err)\\n  }\\n}\\nexport let build_manifest_source_index: (Array[(String, String)]) -> Map[String, String] = (sources) -> {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    MapBuilder::set(builder, path, source)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\nlet source_lookup_in_index: (Map[String, String], String) -> Option[String] = (source_index, path_key) -> {\\n  if Map::has_key(source_index, path_key) {\\n    Some(Map::get(source_index, path_key))\\n  } else {\\n    None\\n  }\\n}\\nexport let build_manifest_path_index: (Array[String]) -> Map[String, Bool] = (paths) -> {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(paths) {\\n    MapBuilder::set(builder, Array::get(paths, i), true)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\nlet empty_path_index: () -> Map[String, Bool] = () -> {\\n  let builder = MapBuilder::new()\\n  MapBuilder::freeze(builder)\\n}\\nlet build_manifest_path_index_from_rows: (String, Array[(String, String)]) -> Map[String, Bool] = (base_dir, rows) -> {\\n  let builder = MapBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    MapBuilder::set(builder, join_path(base_dir, rel_path), true)\\n    i = i + 1\\n  }\\n  MapBuilder::freeze(builder)\\n}\\nlet find_manifest_base_dir: (String) -> Option[String] with { Fs } = (entry_path) -> {\\n  let mut base_dir = dir_of_path(entry_path)\\n  let mut found = None\\n  let mut done = false\\n  loop {\\n    if done {\\n      break\\n    }\\n    let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n    if Fs::exists(manifest_path) {\\n      found = Some(base_dir)\\n      done = true\\n    } else if base_dir == \\\"\\\" {\\n      done = true\\n    } else {\\n      let parent = dir_of_path(base_dir)\\n      if parent == base_dir {\\n        done = true\\n      } else {\\n        base_dir = parent\\n      }\\n    }\\n  }\\n  found\\n}\\nlet strip_trailing_cr: (String) -> String = (line) -> {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0:len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\nlet find_char: (String, Int) -> Int = (s, target) -> {\\n  let len = String::length(s)\\n  let mut i = 0\\n  let mut result = -1\\n  while i < len {\\n    if String::char_code_at(s, i) == target {\\n      result = i\\n      i = len\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  result\\n}\\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\\n  let fields = Array::slice([\\\"\\\"], 0, 0)\\n  let len = String::length(line)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_field_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(line, i) == 9\\n    }\\n    if at_field_end {\\n      Array::push(fields, line[start:i])\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  fields\\n}\\nlet header_value_separator = String::from_char_code(31)\\nlet join_header_values: (Array[String]) -> String = (values) -> {\\n  let out = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(values) {\\n    if i > 0 {\\n      StringBuilder::push(out, header_value_separator)\\n    }\\n    StringBuilder::push(out, Array::get(values, i))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(out)\\n}\\nlet split_header_values: (String) -> Array[String] = (text) -> {\\n  let values = Array::slice([\\\"\\\"], 0, 0)\\n  if String::length(text) == 0 {\\n    values\\n  } else {\\n    let sep = String::char_code_at(header_value_separator, 0)\\n    let len = String::length(text)\\n    let mut start = 0\\n    let mut i = 0\\n    while i <= len {\\n      let at_value_end = if i == len {\\n        true\\n      } else {\\n        String::char_code_at(text, i) == sep\\n      }\\n      if at_value_end {\\n        Array::push(values, text[start:i])\\n        start = i + 1\\n      }\\n      i = i + 1\\n    }\\n    values\\n  }\\n}\\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\\n  Array::slice([(\\\"\\\", Array::slice([(\\\"\\\", \\\"\\\")], 0, 0))], 0, 0)\\n}\\nlet ensure_grouped_source_bucket: (Array[(String, Array[(String, String)])], String) -> Array[(String, String)] = (groups, group_name) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(groups) {\\n    let (name, sources) = Array::get(groups, i)\\n    if name == group_name {\\n      found = Some(sources)\\n      i = Array::length(groups)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  match found {\\n    Some(sources) => sources,\\n    None => {\\n      let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n      Array::push(groups, (group_name, sources))\\n      sources\\n    }\\n  }\\n}\\nlet build_grouped_sources_from_manifest_rows_with_lookup: (String, Array[(String, String)], (String) -> Option[String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, on_path) -> {\\n  let groups = empty_grouped_sources()\\n  let mut last_group_name = \\\"\\\"\\n  let mut last_group_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut has_last_group = false\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (group_name, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    match on_path(path) {\\n      Some(source) => {\\n        let bucket = if has_last_group && last_group_name == group_name {\\n          last_group_sources\\n        } else {\\n          let ensured = ensure_grouped_source_bucket(groups, group_name)\\n          last_group_name = group_name\\n          last_group_sources = ensured\\n          has_last_group = true\\n          ensured\\n        }\\n        Array::push(bucket, (path, source))\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  groups\\n}\\nlet parse_source_manifest_rows: (String) -> Array[(String, String)] with { Error } = (manifest_source) -> {\\n  let rows = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let len = String::length(manifest_source)\\n  let mut line_start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(manifest_source, i) == 10\\n    }\\n    if at_line_end {\\n      let raw_line = strip_trailing_cr(manifest_source[line_start:i])\\n      let line_len = String::length(raw_line)\\n      let has_content = line_len > 0\\n      let is_comment = if has_content {\\n        String::char_code_at(raw_line, 0) == 35\\n      } else {\\n        false\\n      }\\n      if has_content {\\n        if is_comment {\\n          ()\\n        } else {\\n          let tab_idx = find_char(raw_line, 9)\\n          let invalid_row = if tab_idx < 0 {\\n            true\\n          } else {\\n            tab_idx + 1 >= line_len\\n          }\\n          if invalid_row {\\n            throw(String::concat(\\\"invalid source manifest row: \\\", raw_line))\\n          }\\n          let group = raw_line[0:tab_idx]\\n          let path = raw_line[tab_idx + 1:line_len]\\n          Array::push(rows, (group, path))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  rows\\n}\\nexport let try_load_manifest_rows: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  match find_manifest_base_dir(entry_path) {\\n    Some(base_dir) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\\n      let mut has_entry = false\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        let (_, rel_path) = Array::get(rows, i)\\n        let path = join_path(base_dir, rel_path)\\n        if path == entry_path {\\n          has_entry = true\\n        }\\n        i = i + 1\\n      }\\n      if has_entry {\\n        Some((base_dir, rows))\\n      } else {\\n        None\\n      }\\n    },\\n    None => None\\n  }\\n}\\nexport let load_manifest_full_sources: (String, Array[(String, String)]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows) -> {\\n  let full_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    Array::push(full_sources, (path, Fs::read_file(path)))\\n    i = i + 1\\n  }\\n  full_sources\\n}\\nlet load_manifest_sources_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, String)] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\\n  let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (_, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    if Map::has_key(needed_path_index, path) {\\n      Array::push(sources, (path, Fs::read_file(path)))\\n    }\\n    i = i + 1\\n  }\\n  sources\\n}\\nlet load_manifest_source_groups_by_path_index: (String, Array[(String, String)], Map[String, Bool]) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (base_dir, rows, needed_path_index) -> {\\n  let groups = empty_grouped_sources()\\n  let mut last_group_name = \\\"\\\"\\n  let mut last_group_sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n  let mut has_last_group = false\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (group_name, rel_path) = Array::get(rows, i)\\n    let path = join_path(base_dir, rel_path)\\n    if Map::has_key(needed_path_index, path) {\\n      let bucket = if has_last_group && last_group_name == group_name {\\n        last_group_sources\\n      } else {\\n        let ensured = ensure_grouped_source_bucket(groups, group_name)\\n        last_group_name = group_name\\n        last_group_sources = ensured\\n        has_last_group = true\\n        ensured\\n      }\\n      Array::push(bucket, (path, Fs::read_file(path)))\\n    }\\n    i = i + 1\\n  }\\n  groups\\n}\\nexport let build_grouped_sources_from_manifest_row_source_index: (String, Array[(String, String)], Map[String, String]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, source_index) -> {\\n  build_grouped_sources_from_manifest_rows_with_lookup(\\n    base_dir,\\n    rows,\\n    (path: String) -> Option[String] {\\n      source_lookup_in_index(source_index, path)\\n    }\\n  )\\n}\\nexport let build_grouped_sources_from_manifest_rows: (String, Array[(String, String)], Array[(String, String)]) -> Array[(String, Array[(String, String)])] = (base_dir, rows, sources) -> {\\n  let source_index = build_manifest_source_index(sources)\\n  build_grouped_sources_from_manifest_row_source_index(base_dir, rows, source_index)\\n}\\nlet parse_persistent_manifest_header_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let rows = empty_manifest_header_cache_rows()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent manifest header cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent manifest header cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if Array::length(fields) != 4 {\\n            throw(\\\"invalid persistent manifest header cache manifest row\\\")\\n          }\\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n        } else if tag == \\\"header\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 6 {\\n              throw(\\\"invalid persistent manifest header cache header row\\\")\\n            }\\n            Array::push(\\n              rows,\\n              (\\n                Array::get(fields, 1),\\n                Array::get(fields, 2),\\n                Array::get(fields, 3),\\n                Array::get(fields, 4)\\n              )\\n            )\\n          } else {\\n            if Array::length(fields) != 5 {\\n              throw(\\\"invalid persistent manifest header cache header row\\\")\\n            }\\n            Array::push(\\n              rows,\\n              (\\n                Array::get(fields, 1),\\n                Array::get(fields, 2),\\n                Array::get(fields, 3),\\n                Array::get(fields, 4)\\n              )\\n            )\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent manifest header cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, rows)\\n}\\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\\n  if !(Fs::exists(path)) {\\n    false\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        true\\n      } else if String::length(source_fingerprint) > 0 {\\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n      } else {\\n        false\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n    } else {\\n      false\\n    }\\n  }\\n}\\nlet load_persistent_manifest_header_cache_if_valid: (String, String, Map[String, Bool]) -> Option[Array[(String, String, String, String)]] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    let manifest_ok = match manifest {\\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\\n        cached_path == manifest_path &&\\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\\n      None => false\\n    }\\n    if !manifest_ok {\\n      None\\n    } else {\\n      let mut valid = true\\n      let mut i = 0\\n      while i < Array::length(rows) {\\n        if valid {\\n          let (path, stat_token_text, source_fingerprint, _) = Array::get(rows, i)\\n          if !(Map::has_key(manifest_path_index, path)) {\\n            valid = false\\n          } else if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\\n            valid = false\\n          }\\n        }\\n        i = i + 1\\n      }\\n      if valid {\\n        Some(rows)\\n      } else {\\n        None\\n      }\\n    }\\n  }\\n}\\nlet build_persistent_manifest_header_cache_text: (String, Array[(String, String, String, String)]) -> String with { Error, Fs } = (manifest_path, rows) -> {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  out = String::concat(\\n    out,\\n    String::concat(\\n      \\\"manifest\\\\t\\\",\\n      String::concat(\\n        manifest_path,\\n        String::concat(\\n          \\\"\\\\t\\\",\\n          String::concat(\\n            __to_string(Fs::stat_token(manifest_path)),\\n            String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \\\"\\\\n\\\"))\\n          )\\n        )\\n      )\\n    )\\n  )\\n  let mut i = 0\\n  while i < Array::length(rows) {\\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\\n    out = String::concat(\\n      out,\\n      String::concat(\\n        \\\"header\\\\t\\\",\\n        String::concat(\\n          path,\\n          String::concat(\\n            \\\"\\\\t\\\",\\n            String::concat(\\n              stat_token_text,\\n              String::concat(\\n                \\\"\\\\t\\\",\\n                String::concat(\\n                  source_fingerprint,\\n                  String::concat(\\\"\\\\t\\\", String::concat(deps_text, \\\"\\\\n\\\"))\\n                )\\n              )\\n            )\\n          )\\n        )\\n      )\\n    )\\n    i = i + 1\\n  }\\n  out\\n}\\nlet store_persistent_manifest_header_cache: (String, String, Array[(String, String, String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, rows) -> {\\n  Fs::write_file(\\n    persistent_manifest_header_cache_path(entry_path),\\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\\n  )\\n}\\nlet manifest_header_deps_lookup: (Array[(String, String, String, String)], String) -> Option[Array[String]] = (rows, path) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(rows) {\\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\\n    if row_path == path {\\n      found = Some(split_header_values(deps_text))\\n      i = Array::length(rows)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\nlet collect_needed_paths_from_manifest_headers: (String, Map[String, Bool], Array[(String, String, String, String)]) -> Array[String] with { Error, Fs } = (path, manifest_path_index, rows) -> {\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let mut scheduled_set = empty_path_index()\\n  Array::push(worklist, path)\\n  scheduled_set = Map::set(scheduled_set, path, true)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    if !(contains_path(visited, current)) {\\n      Array::push(visited, current)\\n      let deps = match manifest_header_deps_lookup(rows, current) {\\n        Some(found) => found,\\n        None => {\\n          let source = Fs::read_file(current)\\n          if Map::has_key(manifest_path_index, current) {\\n            collect_manifest_header_deps_from_source_with_context(\\n              current,\\n              source,\\n              manifest_path_index\\n            )\\n          } else {\\n            load_or_parse_module_header_deps_with_context(current, source)\\n          }\\n        }\\n      }\\n      let mut dep_i = 0\\n      while dep_i < Array::length(deps) {\\n        let dep_path = Array::get(deps, dep_i)\\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n          !Map::has_key(scheduled_set, dep_path) {\\n          Array::push(worklist, dep_path)\\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\\n          work_len = work_len + 1\\n        }\\n        dep_i = dep_i + 1\\n      }\\n    }\\n    work_i = work_i + 1\\n  }\\n  visited\\n}\\nlet collect_needed_paths_and_manifest_headers: (String, Map[String, Bool]) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } = (path, manifest_path_index) -> {\\n  let rows = empty_manifest_header_cache_rows()\\n  let visited = Array::slice([\\\"\\\"], 0, 0)\\n  let worklist = Array::slice([\\\"\\\"], 0, 0)\\n  let mut scheduled_set = empty_path_index()\\n  Array::push(worklist, path)\\n  scheduled_set = Map::set(scheduled_set, path, true)\\n  let mut work_len = 1\\n  let mut work_i = 0\\n  loop {\\n    if work_i >= work_len {\\n      break\\n    }\\n    let current = Array::get(worklist, work_i)\\n    if !(contains_path(visited, current)) {\\n      Array::push(visited, current)\\n      let source = Fs::read_file(current)\\n      let deps = match manifest_header_deps_lookup(rows, current) {\\n        Some(found) => found,\\n        None => {\\n          let parsed_deps = if Map::has_key(manifest_path_index, current) {\\n            collect_manifest_header_deps_from_source_with_context(\\n              current,\\n              source,\\n              manifest_path_index\\n            )\\n          } else {\\n            load_or_parse_module_header_deps_with_context(current, source)\\n          }\\n          Array::push(\\n            rows,\\n            (\\n              current,\\n              __to_string(Fs::stat_token(current)),\\n              compact_string_fingerprint(source),\\n              join_header_values(parsed_deps)\\n            )\\n          )\\n          parsed_deps\\n        }\\n      }\\n      let mut dep_i = 0\\n      while dep_i < Array::length(deps) {\\n        let dep_path = Array::get(deps, dep_i)\\n        if should_schedule_manifest_dep(dep_path, manifest_path_index) &&\\n          !Map::has_key(scheduled_set, dep_path) {\\n          Array::push(worklist, dep_path)\\n          scheduled_set = Map::set(scheduled_set, dep_path, true)\\n          work_len = work_len + 1\\n        }\\n        dep_i = dep_i + 1\\n      }\\n    }\\n    work_i = work_i + 1\\n  }\\n  (rows, visited)\\n}\\nlet load_or_collect_manifest_header_rows: (String, String, Map[String, Bool]) -> Array[(String, String, String, String)] with { Error, Fs } = (entry_path, manifest_path, manifest_path_index) -> {\\n  match load_persistent_manifest_header_cache_if_valid(\\n    entry_path,\\n    manifest_path,\\n    manifest_path_index\\n  ) {\\n    Some(cached_rows) => cached_rows,\\n    None => {\\n      let (built_rows, _) = collect_needed_paths_and_manifest_headers(\\n        entry_path,\\n        manifest_path_index\\n      )\\n      store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\\n      built_rows\\n    }\\n  }\\n}\\nexport let try_collect_manifest_sources_fs: (String) -> Option[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      let needed_path_index = build_manifest_path_index(needed_paths)\\n      let sources = load_manifest_sources_by_path_index(base_dir, rows, needed_path_index)\\n      Some((manifest_path, sources))\\n    },\\n    None => None\\n  }\\n}\\nexport let try_collect_manifest_source_groups_fs: (String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\\n  match try_load_manifest_rows(entry_path) {\\n    Some((base_dir, rows)) => {\\n      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n      let manifest_path_index = build_manifest_path_index_from_rows(base_dir, rows)\\n      let header_rows = load_or_collect_manifest_header_rows(\\n        entry_path,\\n        manifest_path,\\n        manifest_path_index\\n      )\\n      let needed_paths = collect_needed_paths_from_manifest_headers(\\n        entry_path,\\n        manifest_path_index,\\n        header_rows\\n      )\\n      let needed_path_index = build_manifest_path_index(needed_paths)\\n      let groups = load_manifest_source_groups_by_path_index(base_dir, rows, needed_path_index)\\n      Some((manifest_path, groups))\\n    },\\n    None => None\\n  }\\n}\\nlet resolve_path_fs: (String, String) -> String with { Fs } = (base_dir, raw_path) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut i = 0\\n  let mut found = \\\"\\\"\\n  while i < Array::length(candidates) {\\n    if found == \\\"\\\" {\\n      let candidate = Array::get(candidates, i)\\n      let candidate_exists = perform Fs::Exists(candidate)\\n      if candidate_exists {\\n        found = candidate\\n      }\\n    }\\n    i = i + 1\\n  }\\n  if found == \\\"\\\" {\\n    Array::get(candidates, 0)\\n  } else {\\n    found\\n  }\\n}\\nlet join_path: (String, String) -> String = (base_dir, rel_path) -> {\\n  if base_dir == \\\"\\\" {\\n    rel_path\\n  } else {\\n    String::concat(base_dir, String::concat(\\\"/\\\", rel_path))\\n  }\\n}\\nlet strip_trailing_cr: (String) -> String = (line) -> {\\n  let len = String::length(line)\\n  if len > 0 {\\n    if String::char_code_at(line, len - 1) == 13 {\\n      line[0:len - 1]\\n    } else {\\n      line\\n    }\\n  } else {\\n    line\\n  }\\n}\\nlet special_bundle_header: (String) -> Option[(Array[String], Array[String])] = (path) -> {\\n  if String::ends_with(path, \\\"selfhost_sources_bundle.vibe\\\") {\\n    Some((\\n      Array::slice([\\\"\\\"], 0, 0),\\n      [\\\"selfhost_sources\\\", \\\"selfhost_source_groups\\\"]\\n    ))\\n  } else {\\n    None\\n  }\\n}\\nlet split_tsv_fields: (String) -> Array[String] = (line) -> {\\n  let fields = Array::slice([\\\"\\\"], 0, 0)\\n  let len = String::length(line)\\n  let mut start = 0\\n  let mut i = 0\\n  while i <= len {\\n    let at_field_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(line, i) == 9\\n    }\\n    if at_field_end {\\n      Array::push(fields, line[start:i])\\n      start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  fields\\n}\\nlet header_value_separator = String::from_char_code(31)\\nlet join_header_values: (Array[String]) -> String = (values) -> {\\n  let sb = StringBuilder::new()\\n  let mut i = 0\\n  while i < Array::length(values) {\\n    if i > 0 {\\n      StringBuilder::push(sb, header_value_separator)\\n    }\\n    StringBuilder::push(sb, Array::get(values, i))\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(sb)\\n}\\nlet split_header_values: (String) -> Array[String] = (text) -> {\\n  let values = Array::slice([\\\"\\\"], 0, 0)\\n  if String::length(text) == 0 {\\n    values\\n  } else {\\n    let sep = String::char_code_at(header_value_separator, 0)\\n    let len = String::length(text)\\n    let mut start = 0\\n    let mut i = 0\\n    while i <= len {\\n      let at_value_end = if i == len {\\n        true\\n      } else {\\n        String::char_code_at(text, i) == sep\\n      }\\n      if at_value_end {\\n        Array::push(values, text[start:i])\\n        start = i + 1\\n      }\\n      i = i + 1\\n    }\\n    values\\n  }\\n}\\nlet empty_source_specs: () -> Array[(String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n}\\nlet copy_source_specs: (Array[(String, String)]) -> Array[(String, String)] = (sources) -> {\\n  let out = empty_source_specs()\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    Array::push(out, Array::get(sources, i))\\n    i = i + 1\\n  }\\n  out\\n}\\nlet empty_source_cache_specs: () -> Array[(String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\nlet empty_group_cache_specs: () -> Array[(String, String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\nlet empty_grouped_sources: () -> Array[(String, Array[(String, String)])] = () -> {\\n  Array::slice([(\\\"\\\", Array::slice([(\\\"\\\", \\\"\\\")], 0, 0))], 0, 0)\\n}\\nlet push_grouped_source: (Array[(String, Array[(String, String)])], String, String, String) -> Unit = (groups, group_name, path, source) -> {\\n  let group_count = Array::length(groups)\\n  let handled_by_tail = if group_count > 0 {\\n    let (last_name, last_sources) = Array::get(groups, group_count - 1)\\n    if last_name == group_name {\\n      Array::push(last_sources, (path, source))\\n      true\\n    } else {\\n      false\\n    }\\n  } else {\\n    false\\n  }\\n  if !handled_by_tail {\\n    let mut i = 0\\n    let mut found_index = -1\\n    while i < group_count {\\n      if found_index == -1 {\\n        let (name, sources) = Array::get(groups, i)\\n        if name == group_name {\\n          Array::push(sources, (path, source))\\n          found_index = i\\n        }\\n      }\\n      i = i + 1\\n    }\\n    if found_index == -1 {\\n      let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n      Array::push(sources, (path, source))\\n      Array::push(groups, (group_name, sources))\\n    }\\n  }\\n}\\nlet empty_manifest_header_cache_rows: () -> Array[(String, String, String, String)] = () -> {\\n  Array::slice([(\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\")], 0, 0)\\n}\\nlet parse_persistent_source_list_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } = (raw) -> {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let sources = empty_source_cache_specs()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent source list cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent source list cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 3 {\\n              throw(\\\"invalid persistent source list cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), \\\"\\\", Array::get(fields, 2)))\\n          } else {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source list cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n          }\\n        } else if tag == \\\"source\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 3 {\\n              throw(\\\"invalid persistent source list cache source row\\\")\\n            }\\n            Array::push(sources, (Array::get(fields, 1), \\\"\\\", Array::get(fields, 2)))\\n          } else {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source list cache source row\\\")\\n            }\\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent source list cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, sources)\\n}\\nlet parse_persistent_source_group_cache: (String) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } = (raw) -> {\\n  let len = String::length(raw)\\n  let mut line_start = 0\\n  let mut i = 0\\n  let mut version = 0\\n  let mut manifest = None\\n  let rows = empty_group_cache_specs()\\n  while i <= len {\\n    let at_line_end = if i == len {\\n      true\\n    } else {\\n      String::char_code_at(raw, i) == 10\\n    }\\n    if at_line_end {\\n      let line = strip_trailing_cr(raw[line_start:i])\\n      if String::length(line) > 0 {\\n        let fields = split_tsv_fields(line)\\n        let tag = Array::get(fields, 0)\\n        if tag == \\\"version\\\" {\\n          if Array::length(fields) != 2 {\\n            throw(\\\"invalid persistent source group cache version\\\")\\n          }\\n          let version_text = Array::get(fields, 1)\\n          if version_text == \\\"1\\\" {\\n            version = 1\\n          } else if version_text == \\\"2\\\" {\\n            version = 2\\n          } else {\\n            throw(\\\"invalid persistent source group cache version\\\")\\n          }\\n        } else if tag == \\\"manifest\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 3 {\\n              throw(\\\"invalid persistent source group cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), \\\"\\\", Array::get(fields, 2)))\\n          } else {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source group cache manifest row\\\")\\n            }\\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\\n          }\\n        } else if tag == \\\"group\\\" {\\n          if version == 1 {\\n            if Array::length(fields) != 4 {\\n              throw(\\\"invalid persistent source group cache group row\\\")\\n            }\\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \\\"\\\", Array::get(fields, 3)))\\n          } else {\\n            if Array::length(fields) != 5 {\\n              throw(\\\"invalid persistent source group cache group row\\\")\\n            }\\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\\n          }\\n        } else {\\n          throw(String::concat(\\\"invalid persistent source group cache row: \\\", line))\\n        }\\n      }\\n      line_start = i + 1\\n    }\\n    i = i + 1\\n  }\\n  (version, manifest, rows)\\n}\\nlet matches_cached_file_spec: (String, String, String) -> Bool with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\\n  if !(Fs::exists(path)) {\\n    false\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        true\\n      } else if String::length(source_fingerprint) > 0 {\\n        compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n      } else {\\n        false\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      compact_string_fingerprint(Fs::read_file(path)) == source_fingerprint\\n    } else {\\n      false\\n    }\\n  }\\n}\\nlet load_source_if_cached_file_spec_matches: (String, String, String) -> Option[String] with { Error, Fs } = (path, stat_token_text, source_fingerprint) -> {\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    let has_stat_token = String::length(stat_token_text) > 0\\n    if has_stat_token {\\n      if __to_string(Fs::stat_token(path)) == stat_token_text {\\n        Some(Fs::read_file(path))\\n      } else if String::length(source_fingerprint) > 0 {\\n        let source = Fs::read_file(path)\\n        if compact_string_fingerprint(source) == source_fingerprint {\\n          Some(source)\\n        } else {\\n          None\\n        }\\n      } else {\\n        None\\n      }\\n    } else if String::length(source_fingerprint) > 0 {\\n      let source = Fs::read_file(path)\\n      if compact_string_fingerprint(source) == source_fingerprint {\\n        Some(source)\\n      } else {\\n        None\\n      }\\n    } else {\\n      None\\n    }\\n  }\\n}\\nlet rec load_cached_sources_rec: (Array[(String, String, String)], Int, Array[(String, String)]) -> Option[Array[(String, String)]] with { Error, Fs } = (specs, index, out) -> {\\n  if index >= Array::length(specs) {\\n    Some(out)\\n  } else {\\n    let (path, stat_token_text, source_fingerprint) = Array::get(specs, index)\\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\\n      Some(source) => {\\n        Array::push(out, (path, source))\\n        load_cached_sources_rec(specs, index + 1, out)\\n      },\\n      None => None\\n    }\\n  }\\n}\\nlet rec load_cached_grouped_sources_rec: (Array[(String, String, String, String)], Int, Array[(String, Array[(String, String)])]) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (rows, index, out) -> {\\n  if index >= Array::length(rows) {\\n    Some(out)\\n  } else {\\n    let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, index)\\n    match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\\n      Some(source) => {\\n        push_grouped_source(out, group_name, path, source)\\n        load_cached_grouped_sources_rec(rows, index + 1, out)\\n      },\\n      None => None\\n    }\\n  }\\n}\\nlet manifest_cache_is_valid: (Option[(String, String, String)]) -> Bool with { Error, Fs } = (manifest) -> {\\n  match manifest {\\n    Some((path, stat_token_text, source_fingerprint)) =>\\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\\n    None => true\\n  }\\n}\\nlet load_persistent_sources_cache_if_valid: (String) -> Option[Array[(String, String)]] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_list_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      load_cached_sources_rec(specs, 0, empty_source_specs())\\n    }\\n  }\\n}\\nlet load_persistent_source_groups_cache_if_valid: (String) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_group_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      load_cached_grouped_sources_rec(rows, 0, empty_grouped_sources())\\n    }\\n  }\\n}\\nlet manifest_path_of: (Option[(String, String, String)]) -> Option[String] = (manifest) -> {\\n  match manifest {\\n    Some((path, _, _)) => Some(path),\\n    None => None\\n  }\\n}\\nlet load_persistent_source_groups_from_source_list_cache_if_valid: (String) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } = (entry_path) -> {\\n  let cache_path = persistent_source_list_cache_path(entry_path)\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    )\\n    if !(manifest_cache_is_valid(manifest)) {\\n      None\\n    } else {\\n      match load_cached_sources_rec(specs, 0, empty_source_specs()) {\\n        Some(sources) =>\\n          match try_load_manifest_rows(entry_path) {\\n            Some((base_dir, rows)) => {\\n              let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\\n              Some((manifest_path_of(manifest), groups))\\n            },\\n            None => {\\n              let groups = empty_grouped_sources()\\n              Array::push(groups, (\\\"recursive\\\", sources))\\n              Some((None, groups))\\n            }\\n          },\\n        None => None\\n      }\\n    }\\n  }\\n}\\nlet build_persistent_sources_cache_text: (Option[String], Array[(String, String)]) -> String with { Error, Fs } = (manifest_path, sources) -> {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  match manifest_path {\\n    Some(path) => {\\n      out = String::concat(\\n        out,\\n        String::concat(\\n          \\\"manifest\\\\t\\\",\\n          String::concat(\\n            path,\\n            String::concat(\\n              \\\"\\\\t\\\",\\n              String::concat(\\n                __to_string(Fs::stat_token(path)),\\n                String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \\\"\\\\n\\\"))\\n              )\\n            )\\n          )\\n        )\\n      )\\n    },\\n    None => ()\\n  }\\n  let mut i = 0\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    out = String::concat(\\n      out,\\n      String::concat(\\n        \\\"source\\\\t\\\",\\n        String::concat(\\n          path,\\n          String::concat(\\n            \\\"\\\\t\\\",\\n            String::concat(\\n              __to_string(Fs::stat_token(path)),\\n              String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(source), \\\"\\\\n\\\"))\\n            )\\n          )\\n        )\\n      )\\n    )\\n    i = i + 1\\n  }\\n  out\\n}\\nlet build_persistent_source_groups_cache_text: (Option[String], Array[(String, Array[(String, String)])]) -> String with { Error, Fs } = (manifest_path, groups) -> {\\n  let mut out = \\\"version\\\\t2\\\\n\\\"\\n  match manifest_path {\\n    Some(path) => {\\n      out = String::concat(\\n        out,\\n        String::concat(\\n          \\\"manifest\\\\t\\\",\\n          String::concat(\\n            path,\\n            String::concat(\\n              \\\"\\\\t\\\",\\n              String::concat(\\n                __to_string(Fs::stat_token(path)),\\n                String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \\\"\\\\n\\\"))\\n              )\\n            )\\n          )\\n        )\\n      )\\n    },\\n    None => ()\\n  }\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, gi)\\n    let mut si = 0\\n    while si < Array::length(sources) {\\n      let (path, source) = Array::get(sources, si)\\n      out = String::concat(\\n        out,\\n        String::concat(\\n          \\\"group\\\\t\\\",\\n          String::concat(\\n            group_name,\\n            String::concat(\\n              \\\"\\\\t\\\",\\n              String::concat(\\n                path,\\n                String::concat(\\n                  \\\"\\\\t\\\",\\n                  String::concat(\\n                    __to_string(Fs::stat_token(path)),\\n                    String::concat(\\\"\\\\t\\\", String::concat(compact_string_fingerprint(source), \\\"\\\\n\\\"))\\n                  )\\n                )\\n              )\\n            )\\n          )\\n        )\\n      )\\n      si = si + 1\\n    }\\n    gi = gi + 1\\n  }\\n  out\\n}\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] with { Fs } = (stmts, base_dir) -> {\\n  let deps = Array::slice([\\\"\\\"], 0, 0)\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      SReExport(raw_path, _) => Array::push(deps, resolve_path_fs(base_dir, raw_path)),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  deps\\n}\\nexport let load_or_parse_module_header_fs: (String, String, Int) -> (Array[String], Array[String], Int) with { Error, Fs } = (path, source, parse_count) -> {\\n  load_or_parse_module_header_fs_impl(path, source, parse_count)\\n}\\nlet store_persistent_sources_cache: (String, Option[String], Array[(String, String)]) -> Unit with { Error, Fs } = (entry_path, manifest_path, sources) -> {\\n  Fs::write_file(\\n    persistent_source_list_cache_path(entry_path),\\n    build_persistent_sources_cache_text(manifest_path, sources)\\n  )\\n}\\nlet store_persistent_source_groups_cache: (String, Option[String], Array[(String, Array[(String, String)])]) -> Unit with { Error, Fs } = (entry_path, manifest_path, groups) -> {\\n  Fs::write_file(\\n    persistent_source_group_cache_path(entry_path),\\n    build_persistent_source_groups_cache_text(manifest_path, groups)\\n  )\\n}\\nlet copy_grouped_sources: (Array[(String, Array[(String, String)])]) -> Array[(String, Array[(String, String)])] = (groups) -> {\\n  let out = empty_grouped_sources()\\n  let mut gi = 0\\n  while gi < Array::length(groups) {\\n    let (group_name, sources) = Array::get(groups, gi)\\n    let copied_sources = copy_source_specs(sources)\\n    Array::push(out, (group_name, copied_sources))\\n    gi = gi + 1\\n  }\\n  out\\n}\\nlet special_manifest_sources: (String) -> Option[(String, Array[(String, String)])] = (entry_path) -> {\\n  let _ = entry_path\\n  None\\n}\\nlet special_manifest_source_groups: (String) -> Option[(String, Array[(String, Array[(String, String)])])] = (entry_path) -> {\\n  let _ = entry_path\\n  None\\n}\\nlet rec collect_sources_rec: (String, Array[(String, String)], Array[String]) -> Unit with { Error, Fs } = (path, sources, visited) -> {\\n  if contains_path(visited, path) {\\n    ()\\n  }\\n  else {\\n    Array::push(visited, path)\\n    let source = Fs::read_file(path)\\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\\n    let mut i = 0\\n    while i < Array::length(deps) {\\n      collect_sources_rec(Array::get(deps, i), sources, visited)\\n      i = i + 1\\n    }\\n    Array::push(sources, (path, source))\\n  }\\n}\\nexport let collect_all_sources_fs: (String) -> Array[(String, String)] with { Error, Fs } = (entry_path) -> {\\n  match special_manifest_sources(entry_path) {\\n    Some((manifest_path, sources)) => {\\n      let _ = manifest_path\\n      copy_source_specs(sources)\\n    },\\n    None =>\\n      match load_persistent_sources_cache_if_valid(entry_path) {\\n        Some(sources) => sources,\\n        None => {\\n          match try_collect_manifest_sources_fs(entry_path) {\\n            Some((manifest_path, sources)) => {\\n              store_persistent_sources_cache(entry_path, Some(manifest_path), sources)\\n              sources\\n            },\\n            None => {\\n              match try_load_manifest_rows(entry_path) {\\n                Some((base_dir, rows)) => {\\n                  let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n                  let preloaded_sources = load_manifest_full_sources(base_dir, rows)\\n                  store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\\n                  preloaded_sources\\n                },\\n                None => {\\n                  let sources = Array::slice([(\\\"\\\", \\\"\\\")], 0, 0)\\n                  let visited = Array::slice([\\\"\\\"], 0, 0)\\n                  collect_sources_rec(entry_path, sources, visited)\\n                  store_persistent_sources_cache(entry_path, None, sources)\\n                  sources\\n                }\\n              }\\n            }\\n          }\\n        }\\n      }\\n  }\\n}\\nexport let collect_source_groups_fs: (String) -> Array[(String, Array[(String, String)])] with { Error, Fs } = (entry_path) -> {\\n  match special_manifest_source_groups(entry_path) {\\n    Some((manifest_path, groups)) => {\\n      let _ = manifest_path\\n      copy_grouped_sources(groups)\\n    },\\n    None =>\\n      match load_persistent_source_groups_cache_if_valid(entry_path) {\\n        Some(groups) => groups,\\n        None =>\\n          match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\\n            Some((manifest_path, groups)) => {\\n              store_persistent_source_groups_cache(entry_path, manifest_path, groups)\\n              groups\\n            },\\n            None =>\\n              match try_collect_manifest_source_groups_fs(entry_path) {\\n                Some((manifest_path, groups)) => {\\n                  store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\\n                  groups\\n                },\\n                None =>\\n                  match try_load_manifest_rows(entry_path) {\\n                    Some((base_dir, rows)) => {\\n                      let manifest_path = join_path(base_dir, \\\"selfhost_sources_manifest.tsv\\\")\\n                      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\\n                      let groups = empty_grouped_sources()\\n                      let mut j = 0\\n                      while j < Array::length(rows) {\\n                        let (group_name, rel_path) = Array::get(rows, j)\\n                        let path = join_path(base_dir, rel_path)\\n                        let mut found = \\\"\\\"\\n                        let mut k = 0\\n                        while k < Array::length(preloaded_sources) {\\n                          if found == \\\"\\\" {\\n                            let (source_path, source_text) = Array::get(preloaded_sources, k)\\n                            if source_path == path {\\n                              found = source_text\\n                            }\\n                          }\\n                          k = k + 1\\n                        }\\n                        if found == \\\"\\\" {\\n                          ()\\n                        } else {\\n                          push_grouped_source(groups, group_name, path, found)\\n                        }\\n                        j = j + 1\\n                      }\\n                      store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\\n                      groups\\n                    },\\n                    None => {\\n                      let groups = empty_grouped_sources()\\n                      let recursive_sources = collect_all_sources_fs(entry_path)\\n                      Array::push(groups, (\\\"recursive\\\", recursive_sources))\\n                      store_persistent_source_groups_cache(entry_path, None, groups)\\n                      groups\\n                    }\\n                  }\\n              }\\n          }\\n      }\\n  }\\n}\\nlet empty_stmt_array: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExpr(EInt(0))\\n  ], 0, 0)\\n}\\nexport {\\n  empty_stmt_array\\n}\\nexport {\\n  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs, load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\\n}\\nexport enum StrMap {\\n  StrMap(Array[Array[(String, String)]])\\n}\\nexport enum DepsMap {\\n  DepsMap(Array[Array[(String, Array[String])]])\\n}\\nexport enum RippleDb {\\n  RippleDb(StrMap, StrMap, DepsMap, Array[Int])\\n}\\nlet nbuckets: () -> Int = () -> {\\n  256\\n}\\nlet bucket_mask: () -> Int = () -> {\\n  255\\n}\\nlet hash_bucket: (String) -> Int = (key) -> {\\n  let len = String::length(key)\\n  let rec go: (Int, Int) -> Int = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let c = String::char_code_at(key, i)\\n      let mixed = (acc ^ c) * 16777619\\n      let bounded = mixed & 1073741823\\n      go(i + 1, bounded)\\n    }\\n  }\\n  let h = go(0, 2166136261 & 1073741823)\\n  h & bucket_mask()\\n}\\nlet empty_strings: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\nlet empty_string_pairs: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\nlet empty_deps_pairs: () -> Array[(String, Array[String])] = () -> {\\n  Array::slice([\\n    (\\\"\\\", empty_strings())\\n  ], 0, 0)\\n}\\nlet new_string_buckets: () -> Array[Array[(String, String)]] = () -> {\\n  let n = nbuckets()\\n  let b = ArrayBuilder::new()\\n  let rec go: (Int) -> Unit = (i) -> {\\n    if i >= n {\\n      ()\\n    } else {\\n      ArrayBuilder::push(b, empty_string_pairs())\\n      go(i + 1)\\n    }\\n  }\\n  go(0)\\n  ArrayBuilder::freeze(b)\\n}\\nlet new_deps_buckets: () -> Array[Array[(String, Array[String])]] = () -> {\\n  let n = nbuckets()\\n  let b = ArrayBuilder::new()\\n  let rec go: (Int) -> Unit = (i) -> {\\n    if i >= n {\\n      ()\\n    } else {\\n      ArrayBuilder::push(b, empty_deps_pairs())\\n      go(i + 1)\\n    }\\n  }\\n  go(0)\\n  ArrayBuilder::freeze(b)\\n}\\nlet strmap_new: () -> StrMap = () -> {\\n  StrMap(new_string_buckets())\\n}\\nlet rec assoc_get_string: (Array[(String, String)], String, Int) -> Option[String] = (bucket, key, i) -> {\\n  if i >= Array::length(bucket) {\\n    None\\n  } else {\\n    let (k, v) = Array::get(bucket, i)\\n    if k == key {\\n      Some(v)\\n    } else {\\n      assoc_get_string(bucket, key, i + 1)\\n    }\\n  }\\n}\\nlet strmap_get: (StrMap, String) -> Option[String] = (m, key) -> {\\n  match m {\\n    StrMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      assoc_get_string(bucket, key, 0)\\n    }\\n  }\\n}\\nlet strmap_set: (StrMap, String, String) -> Unit = (m, key, value) -> {\\n  match m {\\n    StrMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      let len = Array::length(bucket)\\n      let rec go: (Int) -> Unit = (i) -> {\\n        if i >= len {\\n          Array::push(bucket, (key, value))\\n        } else {\\n          let (k, _) = Array::get(bucket, i)\\n          if k == key {\\n            Array::set(bucket, i, (key, value))\\n          } else {\\n            go(i + 1)\\n          }\\n        }\\n      }\\n      go(0)\\n    }\\n  }\\n}\\nlet depsmap_new: () -> DepsMap = () -> {\\n  DepsMap(new_deps_buckets())\\n}\\nlet rec assoc_get_deps: (Array[(String, Array[String])], String, Int) -> Option[Array[String]] = (bucket, key, i) -> {\\n  if i >= Array::length(bucket) {\\n    None\\n  } else {\\n    let (k, v) = Array::get(bucket, i)\\n    if k == key {\\n      Some(v)\\n    } else {\\n      assoc_get_deps(bucket, key, i + 1)\\n    }\\n  }\\n}\\nlet depsmap_get: (DepsMap, String) -> Option[Array[String]] = (m, key) -> {\\n  match m {\\n    DepsMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      assoc_get_deps(bucket, key, 0)\\n    }\\n  }\\n}\\nlet depsmap_set: (DepsMap, String, Array[String]) -> Unit = (m, key, deps) -> {\\n  match m {\\n    DepsMap(buckets) => {\\n      let idx = hash_bucket(key)\\n      let bucket = Array::get(buckets, idx)\\n      let len = Array::length(bucket)\\n      let rec go: (Int) -> Unit = (i) -> {\\n        if i >= len {\\n          Array::push(bucket, (key, deps))\\n        } else {\\n          let (k, _) = Array::get(bucket, i)\\n          if k == key {\\n            Array::set(bucket, i, (key, deps))\\n          } else {\\n            go(i + 1)\\n          }\\n        }\\n      }\\n      go(0)\\n    }\\n  }\\n}\\nexport let ripple_new: () -> RippleDb = () -> {\\n  let count = ArrayBuilder::new()\\n  ArrayBuilder::push(count, 0)\\n  RippleDb(strmap_new(), strmap_new(), depsmap_new(), ArrayBuilder::freeze(count))\\n}\\nexport let ripple_get_source: (RippleDb, String) -> Option[String] = (db, path) -> {\\n  match db {\\n    RippleDb(sources, _, _, _) => strmap_get(sources, path)\\n  }\\n}\\nexport let ripple_get_fingerprint: (RippleDb, String) -> Option[String] = (db, path) -> {\\n  match db {\\n    RippleDb(_, fingerprints, _, _) => strmap_get(fingerprints, path)\\n  }\\n}\\nexport let ripple_get_deps: (RippleDb, String) -> Option[Array[String]] = (db, path) -> {\\n  match db {\\n    RippleDb(_, _, deps_map, _) => depsmap_get(deps_map, path)\\n  }\\n}\\nexport let ripple_set_source: (RippleDb, String, String) -> RippleDb = (db, path, source) -> {\\n  match db {\\n    RippleDb(sources, _, _, _) => {\\n      strmap_set(sources, path, source)\\n      db\\n    }\\n  }\\n}\\nexport let ripple_record_eval: (RippleDb, String, String, Array[String]) -> RippleDb = (db, path, fingerprint, deps) -> {\\n  match db {\\n    RippleDb(_, fingerprints, deps_map, count) => match strmap_get(fingerprints, path) {\\n      Some(prev_fp) => if prev_fp == fingerprint {\\n        db\\n      } else {\\n        strmap_set(fingerprints, path, fingerprint)\\n        depsmap_set(deps_map, path, deps)\\n        Array::set(count, 0, Array::get(count, 0) + 1)\\n        db\\n      },\\n      None => {\\n        strmap_set(fingerprints, path, fingerprint)\\n        depsmap_set(deps_map, path, deps)\\n        Array::set(count, 0, Array::get(count, 0) + 1)\\n        db\\n      }\\n    }\\n  }\\n}\\nexport {\\n  RippleDb,\\n  ripple_new,\\n  ripple_set_source,\\n  ripple_get_source,\\n  ripple_get_fingerprint,\\n  ripple_get_deps,\\n  ripple_record_eval,\\n  ripple_eval_count\\n}\\nlet parse_int_unwrap: (String, Int) -> Int = (raw, fallback) -> {\\n  let len = String::length(raw)\\n  let mut result = 0\\n  let mut i = 0\\n  let mut neg = false\\n  let mut valid = true\\n  if len == 0 { valid = false }\\n  if valid {\\n    if String::char_code_at(raw, 0) == 45 { neg = true; i = 1 }\\n  }\\n  while valid {\\n    if i >= len { break }\\n    let c = String::char_code_at(raw, i)\\n    if c < 48 { valid = false }\\n    else if c > 57 { valid = false }\\n    else {\\n      result = result * 10 + (c - 48)\\n      i = i + 1\\n    }\\n  }\\n  if valid {\\n    if neg { 0 - result } else result\\n  } else fallback\\n}\\nlet serialize_segment: (String) -> String = (text) -> {\\n  let len = String::length(text)\\n  let len_str = __to_string(len)\\n  let colon_text = String::concat(\\\":\\\", text)\\n  String::concat(len_str, colon_text)\\n}\\nlet decode_effect_name: (String) -> String = (raw) -> {\\n  if raw == \\\"\\\" || raw == \\\"0\\\" {\\n    \\\"\\\"\\n  } else if raw == \\\"1\\\" {\\n    \\\"Error\\\"\\n  } else {\\n    raw\\n  }\\n}\\nlet parse_count_header: (String, Int, Int) -> (Int, Int) with { Error } = (text, pos, terminator) -> {\\n  let len = String::length(text)\\n  let mut i = pos\\n  while i < len && String::char_code_at(text, i) != terminator {\\n    i = i + 1\\n  }\\n  if i >= len {\\n    throw(\\\"invalid persistent type env payload\\\")\\n  } else {\\n    let parsed = parse_int_unwrap(text[pos: i], 0)\\n    (parsed, i + 1)\\n  }\\n}\\nlet parse_segment: (String, Int) -> (String, Int) with { Error } = (text, pos) -> {\\n  let (seg_len, start) = parse_count_header(text, pos, 58)\\n  let end = start + seg_len\\n  if end > String::length(text) {\\n    throw(\\\"invalid persistent type env segment\\\")\\n  } else {\\n    (text[start: end], end)\\n  }\\n}\\nlet parse_int_array: (String, Int) -> (Array[Int], Int) with { Error } = (text, pos) -> {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (raw, next_cursor) = parse_segment(text, cursor)\\n    let parsed_val = parse_int_unwrap(raw, 0)\\n    Array::push(items, parsed_val)\\n    cursor = next_cursor\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env int array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\nlet parse_string_array: (String, Int) -> (Array[String], Int) with { Error } = (text, pos) -> {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (item, next_cursor) = parse_segment(text, cursor)\\n    Array::push(items, item)\\n    cursor = next_cursor\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env string array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\nlet parse_bounds_array: (String, Int) -> (Array[(Int, Array[String])], Int) with { Error } = (text, pos) -> {\\n  let (count, start) = parse_count_header(text, pos, 91)\\n  let items = Array::slice([\\n    (0, Array::slice([\\n      \\\"\\\"\\n    ], 0, 0))\\n  ], 0, 0)\\n  let mut i = 0\\n  let mut cursor = start\\n  while i < count {\\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\\n    let parsed_id = parse_int_unwrap(raw_id, 0)\\n    Array::push(items, (parsed_id, bounds))\\n    cursor = next_cursor2\\n    i = i + 1\\n  }\\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n    throw(\\\"invalid persistent type env bounds array\\\")\\n  } else {\\n    (items, cursor + 1)\\n  }\\n}\\nlet rec parse_cached_type: (String, Int) -> (Type, Int) with { Error } = (source, pos) -> {\\n  let rec parse_type_array: (String, Int) -> (Array[Type], Int) with { Error } = (text, pos) -> {\\n    let (count, start) = parse_count_header(text, pos, 91)\\n    let items = Array::slice([\\n      CtUnknown\\n    ], 0, 0)\\n    let mut i = 0\\n    let mut cursor = start\\n    while i < count {\\n      let (raw, next_cursor) = parse_segment(text, cursor)\\n      let (item, end_cursor) = parse_cached_type(raw, 0)\\n      if end_cursor != String::length(raw) {\\n        throw(\\\"invalid persistent type env nested type\\\")\\n      } else {\\n        Array::push(items, item)\\n        cursor = next_cursor\\n        i = i + 1\\n      }\\n    }\\n    if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\\n      throw(\\\"invalid persistent type env type array\\\")\\n    } else {\\n      (items, cursor + 1)\\n    }\\n  }\\n  if pos >= String::length(source) {\\n    throw(\\\"invalid persistent type env type\\\")\\n  } else {\\n    let tag = String::char_code_at(source, pos)\\n    match tag {\\n      73 => (CtInt, pos + 1),\\n      68 => (CtDouble, pos + 1),\\n      66 => (CtBool, pos + 1),\\n      71 => (CtString, pos + 1),\\n      72 => (CtChar, pos + 1),\\n      85 => (CtUnit, pos + 1),\\n      89 => (CtBytes, pos + 1),\\n      88 => (CtUnknown, pos + 1),\\n      86 => {\\n        let (raw, next_pos) = parse_segment(source, pos + 1)\\n        let var_id = parse_int_unwrap(raw, 0)\\n        (CtVar(var_id), next_pos)\\n      },\\n      69 => {\\n        let (name, next_pos) = parse_segment(source, pos + 1)\\n        (CtEnum(name), next_pos)\\n      },\\n      82 => {\\n        let (name, next_pos) = parse_segment(source, pos + 1)\\n        (CtStruct(name), next_pos)\\n      },\\n      65 => {\\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\\n        (CtArray(elem), next_pos)\\n      },\\n      79 => {\\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\\n        (CtOption(elem), next_pos)\\n      },\\n      84 => {\\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\\n        (CtTuple(elems), next_pos)\\n      },\\n      70 => {\\n        let (raw_effect, next_pos1) = parse_segment(source, pos + 1)\\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\\n        let eff_raw = decode_effect_name(raw_effect)\\n        let eff_name = if String::length(eff_raw) > 0 { Some(eff_raw) } else { None }\\n        (CtFn(params, ret, eff_name), next_pos3)\\n      },\\n      78 => {\\n        let (name, next_pos1) = parse_segment(source, pos + 1)\\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\\n        (CtNamed(name, args), next_pos2)\\n      },\\n      81 => {\\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\\n        (CtForAll(vars, bounds, body), next_pos3)\\n      },\\n      _ => throw(\\\"invalid persistent type env type tag\\\")\\n    }\\n  }\\n}\\nlet serialize_int_array: (Array[Int]) -> String = (items) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    StringBuilder::push(buf, serialize_segment(__to_string(Array::get(items, i))))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\nlet serialize_string_array: (Array[String]) -> String = (items) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    StringBuilder::push(buf, serialize_segment(Array::get(items, i)))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\nlet serialize_bounds_array: (Array[(Int, Array[String])]) -> String = (items) -> {\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, __to_string(Array::length(items)))\\n  StringBuilder::push(buf, \\\"[\\\")\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    let (id, bounds) = Array::get(items, i)\\n    StringBuilder::push(buf, serialize_segment(__to_string(id)))\\n    StringBuilder::push(buf, serialize_string_array(bounds))\\n    i = i + 1\\n  }\\n  StringBuilder::push(buf, \\\"]\\\")\\n  StringBuilder::freeze(buf)\\n}\\nlet rec serialize_type: (Type) -> String = (ty) -> {\\n  let rec serialize_type_array: (Array[Type]) -> String = (items) -> {\\n    let buf = StringBuilder::new()\\n    StringBuilder::push(buf, __to_string(Array::length(items)))\\n    StringBuilder::push(buf, \\\"[\\\")\\n    let mut i = 0\\n    while i < Array::length(items) {\\n      StringBuilder::push(buf, serialize_segment(serialize_type(Array::get(items, i))))\\n      i = i + 1\\n    }\\n    StringBuilder::push(buf, \\\"]\\\")\\n    StringBuilder::freeze(buf)\\n  }\\n  match ty {\\n    CtInt => \\\"I\\\",\\n    CtDouble => \\\"D\\\",\\n    CtBool => \\\"B\\\",\\n    CtString => \\\"G\\\",\\n    CtChar => \\\"H\\\",\\n    CtUnit => \\\"U\\\",\\n    CtBytes => \\\"Y\\\",\\n    CtUnknown => \\\"X\\\",\\n    CtVar(id) => String::concat(\\\"V\\\", serialize_segment(__to_string(id))),\\n    CtEnum(name) => String::concat(\\\"E\\\", serialize_segment(name)),\\n    CtStruct(name) => String::concat(\\\"R\\\", serialize_segment(name)),\\n    CtArray(elem) => String::concat(\\\"A\\\", serialize_type(elem)),\\n    CtOption(elem) => String::concat(\\\"O\\\", serialize_type(elem)),\\n    CtTuple(elems) => String::concat(\\\"T\\\", serialize_type_array(elems)),\\n    CtFn(params, ret, effect_name) => {\\n      let eff_str = if effect_name is Some(n) { n } else { \\\"\\\" }\\n      String::concat(\\\"F\\\", String::concat(serialize_segment(eff_str), String::concat(serialize_type_array(params), serialize_type(ret))))\\n    },\\n    CtNamed(name, args) =>\\n    String::concat(\\\"N\\\", String::concat(serialize_segment(name), serialize_type_array(args))),\\n    CtForAll(vars, bounds, body) =>\\n    String::concat(\\\"Q\\\", String::concat(serialize_int_array(vars), String::concat(serialize_bounds_array(bounds), serialize_type(body))))\\n  }\\n}\\nexport let persistent_dep_list_text: (Array[String]) -> String = (deps) -> {\\n  if Array::length(deps) == 0 {\\n    \\\"\\\"\\n  } else if Array::length(deps) == 1 {\\n    String::concat(\\\"version\\\\t3\\\\n\\\", Array::get(deps, 0))\\n  } else {\\n    String::concat(\\\"version\\\\t2\\\\n\\\", serialize_string_array(deps))\\n  }\\n}\\nexport let load_persistent_dep_list: (String, String) -> Option[Array[String]] with { Error, Fs } = (path, source) -> {\\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    if String::length(text) == 0 {\\n      Some(Array::slice([\\n        \\\"\\\"\\n      ], 0, 0))\\n    } else {\\n      let v2_prefix = \\\"version\\\\t2\\\\n\\\"\\n      let v3_prefix = \\\"version\\\\t3\\\\n\\\"\\n      let text_len = String::length(text)\\n      let v2_len = String::length(v2_prefix)\\n      let v3_len = String::length(v3_prefix)\\n      if text_len >= v2_len &&\\n      text[0: v2_len] == v2_prefix {\\n        let body = text[v2_len: text_len]\\n        let (deps, end_pos) = parse_string_array(body, 0)\\n        if end_pos == String::length(body) {\\n          Some(deps)\\n        } else {\\n          throw(String::concat(\\\"invalid persistent dep list body: \\\", cache_path))\\n        }\\n      } else if text_len >= v3_len &&\\n      text[0: v3_len] == v3_prefix {\\n        let dep = text[v3_len: text_len]\\n        if String::length(dep) == 0 {\\n          Some(Array::slice([\\n            \\\"\\\"\\n          ], 0, 0))\\n        } else {\\n          Some([dep])\\n        }\\n      } else {\\n        throw(String::concat(\\\"invalid persistent dep list header: \\\", cache_path))\\n      }\\n    }\\n  }\\n}\\nlet rebuild_persistent_type_env: (Array[(String, Type)]) -> TypeEnv = (bindings) -> {\\n  EnvFlat(bindings)\\n}\\nexport let load_persistent_type_env: (String) -> Option[TypeEnv] with { Error, Fs } = (fingerprint) -> {\\n  let path = persistent_type_env_cache_path(fingerprint)\\n  if !(Fs::exists(path)) {\\n    None\\n  } else {\\n    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), \\\"\\\\n\\\")\\n    let len = Array::length(lines)\\n    let rec go: (Int, Bool, Array[(String, Type)]) -> Option[TypeEnv] with { Error } = (index, version_ok, bindings) -> {\\n      if index >= len {\\n        if version_ok {\\n          Some(rebuild_persistent_type_env(bindings))\\n        } else {\\n          None\\n        }\\n      } else {\\n        let line = Array::get(lines, index)\\n        if String::length(line) == 0 {\\n          go(index + 1, version_ok, bindings)\\n        } else {\\n          let parts = String::split(line, \\\"\\\\t\\\")\\n          if !version_ok {\\n            if Array::length(parts) == 2 &&\\n            Array::get(parts, 0) == \\\"version\\\" &&\\n            Array::get(parts, 1) == \\\"1\\\" {\\n              go(index + 1, true, bindings)\\n            } else {\\n              throw(String::concat(\\\"invalid persistent type env header: \\\", line))\\n            }\\n          } else if Array::length(parts) == 3 && Array::get(parts, 0) == \\\"bind\\\" {\\n            let raw_type = Array::get(parts, 2)\\n            let (ty, end_pos) = parse_cached_type(raw_type, 0)\\n            if end_pos != String::length(raw_type) {\\n              throw(String::concat(\\\"invalid persistent type env bind row: \\\", line))\\n            } else {\\n              Array::push(bindings, (Array::get(parts, 1), ty))\\n              go(index + 1, true, bindings)\\n            }\\n          } else {\\n            throw(String::concat(\\\"invalid persistent type env row: \\\", line))\\n          }\\n        }\\n      }\\n    }\\n    go(0, false, Array::slice([\\n      (\\\"\\\", CtUnknown)\\n    ], 0, 0))\\n  }\\n}\\nexport let persistent_type_env_cache_text: (TypeEnv) -> String = (env) -> {\\n  let bindings = env_flat_bindings(env)\\n  let buf = StringBuilder::new()\\n  StringBuilder::push(buf, \\\"version\\\\t1\\\\n\\\")\\n  let mut i = 0\\n  while i < Array::length(bindings) {\\n    let (name, ty) = Array::get(bindings, i)\\n    StringBuilder::push(buf, \\\"bind\\\\t\\\")\\n    StringBuilder::push(buf, name)\\n    StringBuilder::push(buf, \\\"\\\\t\\\")\\n    StringBuilder::push(buf, serialize_type(ty))\\n    StringBuilder::push(buf, \\\"\\\\n\\\")\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(buf)\\n}\\nexport let load_persistent_leaf_fingerprint: (String, String) -> Option[String] with { Error, Fs } = (path, source) -> {\\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(cache_path)) {\\n    None\\n  } else {\\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\\n    let prefix = \\\"version\\\\t1\\\\n\\\"\\n    if String::length(text) > String::length(prefix) &&\\n    text[0: String::length(prefix)] == prefix {\\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\\n    } else {\\n      None\\n    }\\n  }\\n}\\nexport let persistent_leaf_fingerprint_text: (String) -> String = (fingerprint) -> {\\n  String::concat(\\\"version\\\\t1\\\\n\\\", String::concat(fingerprint, \\\"\\\\n\\\"))\\n}\\nlet empty_stack: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\nlet empty_dep_fps: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\nlet lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (p, env) = Array::get(cache, i)\\n      if p == path {\\n        result = Some(env)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\nlet resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut selected = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(candidates) && selected == \\\"\\\" {\\n    let candidate = Array::get(candidates, i)\\n    match lookup_env_cache(cache, candidate) {\\n      Some(_) => {\\n        selected = candidate\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  if selected == \\\"\\\" {\\n    resolve_import_path(base_dir, raw_path)\\n  } else {\\n    selected\\n  }\\n}\\nlet starts_with_upper: (String) -> Bool = (name) -> {\\n  if String::length(name) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 65 && c <= 90\\n  }\\n}\\nlet rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {\\n  match ty {\\n    CtEnum(name) => name == type_name,\\n    CtNamed(name, _) => name == type_name,\\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\\n    _ => false\\n  }\\n}\\nlet bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {\\n  let mut out = acc\\n  let mut i = 0\\n  while i < Array::length(dep_bindings) {\\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\\n      out = env_bind(out, candidate_name, candidate_ty)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\nlet bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {\\n  let dep_env = match lookup_env_cache(cache, resolved) {\\n    Some(e) => e,\\n    None => EnvEmpty\\n  }\\n  let dep_bindings = env_flat_bindings(dep_env)\\n  let nlen = Array::length(names)\\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\\n    if j >= nlen {\\n      nacc\\n    } else {\\n      let (name, alias) = Array::get(names, j)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match env_lookup_flat(dep_bindings, name) {\\n        Some(t) => t,\\n        None => CtUnknown\\n      }\\n      let with_name = env_bind(nacc, bound_name, ty)\\n      let with_companions = match ty {\\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\\n        _ => if starts_with_upper(name) {\\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\\n        } else {\\n          with_name\\n        }\\n      }\\n      bind_names(j + 1, with_companions)\\n    }\\n  }\\n  bind_names(0, acc)\\n}\\nlet build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        SReExport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, EnvEmpty)\\n}\\nlet upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {\\n  let len = Array::length(cache)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len && !found {\\n    let (p, _) = Array::get(cache, i)\\n    if p == path {\\n      Array::set(cache, i, (path, env))\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if !found {\\n    Array::push(cache, (path, env))\\n  }\\n  cache\\n}\\nlet ensure_env_cache_for_path: (RippleDb, Array[(String, TypeEnv)], String) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, path) -> {\\n  match lookup_env_cache(env_cache, path) {\\n    Some(_) => env_cache,\\n    None =>\\n    match ripple_get_fingerprint(rdb, path) {\\n      Some(fingerprint) =>\\n      match load_persistent_type_env(fingerprint) {\\n        Some(cached_env) => upsert_env_cache(env_cache, path, cached_env),\\n        None => env_cache\\n      },\\n      None => env_cache\\n    }\\n  }\\n}\\nlet ensure_env_cache_for_paths: (RippleDb, Array[(String, TypeEnv)], Array[String]) -> Array[(String, TypeEnv)] with { Error, Fs } = (rdb, env_cache, paths) -> {\\n  let mut cache = env_cache\\n  let mut i = 0\\n  while i < Array::length(paths) {\\n    cache = ensure_env_cache_for_path(rdb, cache, Array::get(paths, i))\\n    i = i + 1\\n  }\\n  cache\\n}\\nlet build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\\n  let mut acc = compact_string_fingerprint(source)\\n  let mut i = 0\\n  while i < Array::length(dep_fps) {\\n    let dep_pair = Array::get(dep_fps, i)\\n    let dep_path = dep_pair.0\\n    let dep_fp = dep_pair.1\\n    let next = String::concat(acc, String::concat(\\\"|\\\", String::concat(dep_path, String::concat(\\\"=\\\", dep_fp))))\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\nlet copy_string_array: (Array[String]) -> Array[String] = (items) -> {\\n  let out = empty_stack()\\n  let mut i = 0\\n  let len = Array::length(items)\\n  while i < len {\\n    Array::push(out, Array::get(items, i))\\n    i = i + 1\\n  }\\n  out\\n}\\nlet lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {\\n  let len = Array::length(pairs)\\n  let mut i = 0\\n  let mut result = None\\n  let mut done = false\\n  while !done {\\n    if i >= len {\\n      done = true\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        result = Some(v)\\n        done = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n  result\\n}\\nlet upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {\\n  let len = Array::length(pairs)\\n  let mut i = 0\\n  let mut found = false\\n  while i < len && !found {\\n    let (k, _) = Array::get(pairs, i)\\n    if k == key {\\n      Array::set(pairs, i, (key, value))\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  if !found {\\n    Array::push(pairs, (key, value))\\n  }\\n  pairs\\n}\\nlet parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\\n  handle {\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    parse_program_located(tokens, starts, source)\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\nlet store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {\\n  Fs::write_file(persistent_type_env_cache_path(fingerprint), persistent_type_env_cache_text(env))\\n}\\nlet write_persistent_dep_list_if_missing: (String, String, Array[String]) -> Unit with { Fs } = (path, source, deps) -> {\\n  let dep_cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\\n  if !(Fs::exists(dep_cache_path)) {\\n    Fs::write_file(dep_cache_path, persistent_dep_list_text(deps))\\n  } else {\\n    ()\\n  }\\n}\\nlet typecheck_ident_run: (String, Int) -> Int = (s, start) -> {\\n  let len = String::length(s)\\n  let mut e = start\\n  let mut go = true\\n  while go && e < len {\\n    let c = String::char_code_at(s, e)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    if is_id {\\n      e = e + 1\\n    } else {\\n      go = false\\n    }\\n  }\\n  e\\n}\\nlet locate_by_marker: (String, String, String) -> String = (source, msg, marker) -> {\\n  let mi = String::index_of(msg, marker)\\n  if mi < 0 {\\n    msg\\n  } else {\\n    let sstart = mi + String::length(marker)\\n    let send = typecheck_ident_run(msg, sstart)\\n    if send <= sstart {\\n      msg\\n    } else {\\n      let sym = String::substring(msg, sstart, send)\\n      let off = String::index_of(source, sym)\\n      if off < 0 {\\n        msg\\n      } else {\\n        let (line, col) = offset_to_line_col(source, off)\\n        let loc = String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n        String::concat(loc, msg)\\n      }\\n    }\\n  }\\n}\\nlet locate_type_error_heuristic: (String, String) -> String = (source, msg) -> {\\n  if String::index_of(msg, \\\"line \\\") == 0 {\\n    msg\\n  } else {\\n    let with_name = locate_by_marker(source, msg, \\\"unknown name: \\\")\\n    if with_name != msg {\\n      with_name\\n    } else {\\n      let with_arity = locate_by_marker(source, msg, \\\"function arity mismatch for \\\")\\n      if with_arity != msg {\\n        with_arity\\n      } else {\\n        let with_field = locate_by_marker(source, msg, \\\"unknown field \\\")\\n        if with_field != msg {\\n          with_field\\n        } else {\\n          locate_by_marker(source, msg, \\\"unknown constructor \\\")\\n        }\\n      }\\n    }\\n  }\\n}\\nlet offset_line_col_prefix: (String, Int) -> String = (source, off) -> {\\n  let (line, col) = offset_to_line_col(source, off)\\n  String::concat(\\\"line \\\", String::concat(__to_string(line), String::concat(\\\":\\\", String::concat(__to_string(col), \\\": \\\"))))\\n}\\nlet offset_line_col_range_prefix: (String, Int, Int) -> String = (source, start, endo) -> {\\n  let (l1, c1) = offset_to_line_col(source, start)\\n  let (l2, c2) = offset_to_line_col(source, endo)\\n  if l1 == l2 && endo > start {\\n    String::concat(\\\"line \\\", String::concat(__to_string(l1), String::concat(\\\":\\\", String::concat(__to_string(c1), String::concat(\\\"-\\\", String::concat(__to_string(c2), \\\": \\\"))))))\\n  } else {\\n    offset_line_col_prefix(source, start)\\n  }\\n}\\nlet parse_offset_digits: (String, Int, Int) -> Int = (msg, start, end) -> {\\n  if end <= start {\\n    -1\\n  } else {\\n    let mut i = start\\n    let mut acc = 0\\n    let mut ok = true\\n    while ok && i < end {\\n      let c = String::char_code_at(msg, i)\\n      if c >= '0' && c <= '9' {\\n        acc = acc * 10 + (c - '0')\\n        i = i + 1\\n      } else {\\n        ok = false\\n      }\\n    }\\n    if ok {\\n      acc\\n    } else {\\n      -1\\n    }\\n  }\\n}\\nlet locate_type_error: (String, String) -> String = (source, msg) -> {\\n  let marker = \\\" [@off=\\\"\\n  let mi = String::index_of(msg, marker)\\n  if mi < 0 {\\n    locate_type_error_heuristic(source, msg)\\n  } else {\\n    let inner_start = mi + String::length(marker)\\n    let rel_end = String::index_of(String::substring(msg, inner_start, String::length(msg)), \\\"]\\\")\\n    if rel_end < 0 {\\n      locate_type_error_heuristic(source, String::substring(msg, 0, mi))\\n    } else {\\n      let close = inner_start + rel_end\\n      let inner = String::substring(msg, inner_start, close)\\n      let colon = String::index_of(inner, \\\":\\\")\\n      let n = if colon < 0 {\\n        parse_offset_digits(inner, 0, String::length(inner))\\n      } else {\\n        parse_offset_digits(inner, 0, colon)\\n      }\\n      let m = if colon < 0 {\\n        -1\\n      } else {\\n        parse_offset_digits(inner, colon + 1, String::length(inner))\\n      }\\n      let stripped = String::concat(String::substring(msg, 0, mi), String::substring(msg, close + 1, String::length(msg)))\\n      let slen = String::length(source)\\n      if n >= 0 && n < slen {\\n        if m > n && m <= slen {\\n          String::concat(offset_line_col_range_prefix(source, n, m), stripped)\\n        } else {\\n          String::concat(offset_line_col_prefix(source, n), stripped)\\n        }\\n      } else {\\n        locate_type_error_heuristic(source, stripped)\\n      }\\n    }\\n  }\\n}\\nlet finish_typecheck_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, String, Array[String], String) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, source, deps, fingerprint) -> {\\n  if Fs::exists(persistent_type_env_cache_path(fingerprint)) {\\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\\n    (fingerprint, next_db, env_cache, dep_source_cache, parse_count)\\n  } else {\\n    let stmts = parse_program_with_path(path, source)\\n    let final_parse_count = parse_count + 1\\n    let import_env_cache = ensure_env_cache_for_paths(rdb, env_cache, deps)\\n    let import_env = build_import_env(stmts, dir_of_path(path), import_env_cache)\\n    let checked_env = handle {\\n      match import_env {\\n        EnvEmpty => check_program(stmts),\\n        _ => check_program_with_env(stmts, import_env)\\n      }\\n    } with Error {\\n      Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), locate_type_error(source, msg)))\\n    }\\n    store_persistent_type_env(fingerprint, checked_env)\\n    if Array::length(deps) == 0 {\\n      Fs::write_file(persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)), persistent_leaf_fingerprint_text(fingerprint))\\n    } else {\\n      ()\\n    }\\n    let next_env_cache = upsert_env_cache(import_env_cache, path, checked_env)\\n    let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\\n    (fingerprint, next_db, next_env_cache, dep_source_cache, final_parse_count)\\n  }\\n}\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {\\n  let out = empty_stack()\\n  let mut i = 0\\n  let len = Array::length(stmts)\\n  while i < len {\\n    match Array::get(stmts, i) {\\n      SImport(raw_path, _) => if String::length(raw_path) > 0 {\\n        let resolved = resolve_import_path(base_dir, raw_path)\\n        if !contains_str(out, resolved) {\\n          Array::push(out, resolved)\\n        }\\n      },\\n      SReExport(raw_path, _) => if String::length(raw_path) > 0 {\\n        let resolved = resolve_import_path(base_dir, raw_path)\\n        if !contains_str(out, resolved) {\\n          Array::push(out, resolved)\\n        }\\n      },\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\nlet load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {\\n  match load_persistent_dep_list(path, source) {\\n    Some(deps) => (deps, upsert_string_pair(dep_source_cache, path, source), parse_count),\\n    None => {\\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\\n      (deps, upsert_string_pair(dep_source_cache, path, source), next_parse_count)\\n    }\\n  }\\n}\\nlet resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n    if cached_source == source {\\n      match ripple_get_deps(rdb, path) {\\n        Some(deps) => (deps, dep_source_cache, parse_count),\\n        None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n      }\\n    } else {\\n      load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n    },\\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n  }\\n}\\nlet rec ensure_fingerprint_fs_go: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\\n  if contains_str(stack, path) {\\n    throw(String::concat(\\\"type_db: import cycle detected at \\\", path))\\n  } else {\\n    match ripple_get_source(rdb, path) {\\n      None => (String::concat(\\\"missing:\\\", path), rdb, env_cache, dep_source_cache, parse_count),\\n      Some(source) => match lookup_string_pair(dep_source_cache, path) {\\n        Some(cached_source) => if cached_source == source {\\n          match ripple_get_fingerprint(rdb, path) {\\n            Some(cached_fingerprint) =>\\n            (cached_fingerprint, rdb, env_cache, dep_source_cache, parse_count),\\n            None => match load_persistent_leaf_fingerprint(path, source) {\\n              Some(leaf_fingerprint) => {\\n                write_persistent_dep_list_if_missing(path, source, empty_stack())\\n                let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n                (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n              },\\n              None => {\\n                let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n                let deps = copy_string_array(deps_raw)\\n                write_persistent_dep_list_if_missing(path, source, deps)\\n                let dlen = Array::length(deps)\\n                let saved_stack_len = Array::length(stack)\\n                Array::push(stack, path)\\n                let mut i = 0\\n                let mut db_after_deps = rdb\\n                let mut env_cache_after_deps = env_cache\\n                let mut dep_source_cache_after_deps = next_dep_source_cache\\n                let mut parse_count_after_deps = initial_parse_count\\n                let dep_fps = empty_dep_fps()\\n                while i < dlen {\\n                  let dep_path = Array::get(deps, i)\\n                  let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n                  db_after_deps = next_db\\n                  env_cache_after_deps = next_env_cache\\n                  dep_source_cache_after_deps = next_dep_source_cache2\\n                  parse_count_after_deps = next_parse_count\\n                  Array::push(dep_fps, (dep_path, dep_fp))\\n                  i = i + 1\\n                }\\n                Array::truncate(stack, saved_stack_len)\\n                let fingerprint = build_fingerprint(source, dep_fps)\\n                match ripple_get_fingerprint(db_after_deps, path) {\\n                  Some(cached_fp) =>\\n                  if cached_fp == fingerprint {\\n                    (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n                  } else {\\n                    finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                  },\\n                  None =>\\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                }\\n              }\\n            }\\n          }\\n        } else {\\n          match load_persistent_leaf_fingerprint(path, source) {\\n            Some(leaf_fingerprint) => {\\n              write_persistent_dep_list_if_missing(path, source, empty_stack())\\n              let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n              let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n              (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n            },\\n            None => {\\n              let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n              let deps = copy_string_array(deps_raw)\\n              write_persistent_dep_list_if_missing(path, source, deps)\\n              let dlen = Array::length(deps)\\n              let saved_stack_len = Array::length(stack)\\n              Array::push(stack, path)\\n              let mut i = 0\\n              let mut db_after_deps = rdb\\n              let mut env_cache_after_deps = env_cache\\n              let mut dep_source_cache_after_deps = next_dep_source_cache\\n              let mut parse_count_after_deps = initial_parse_count\\n              let dep_fps = empty_dep_fps()\\n              while i < dlen {\\n                let dep_path = Array::get(deps, i)\\n                let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n                db_after_deps = next_db\\n                env_cache_after_deps = next_env_cache\\n                dep_source_cache_after_deps = next_dep_source_cache2\\n                parse_count_after_deps = next_parse_count\\n                Array::push(dep_fps, (dep_path, dep_fp))\\n                i = i + 1\\n              }\\n              Array::truncate(stack, saved_stack_len)\\n              let fingerprint = build_fingerprint(source, dep_fps)\\n              match ripple_get_fingerprint(db_after_deps, path) {\\n                Some(cached_fp) =>\\n                if cached_fp == fingerprint {\\n                  (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n                } else {\\n                  finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n                },\\n                None =>\\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n              }\\n            }\\n          }\\n        },\\n        None =>\\n        match load_persistent_leaf_fingerprint(path, source) {\\n          Some(leaf_fingerprint) => {\\n            write_persistent_dep_list_if_missing(path, source, empty_stack())\\n            let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\\n            let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\\n            (leaf_fingerprint, next_db, env_cache, next_dep_source_cache, parse_count)\\n          },\\n          None => {\\n            let (deps_raw, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(rdb, dep_source_cache, path, source, parse_count)\\n            let deps = copy_string_array(deps_raw)\\n            write_persistent_dep_list_if_missing(path, source, deps)\\n            let dlen = Array::length(deps)\\n            let saved_stack_len = Array::length(stack)\\n            Array::push(stack, path)\\n            let mut i = 0\\n            let mut db_after_deps = rdb\\n            let mut env_cache_after_deps = env_cache\\n            let mut dep_source_cache_after_deps = next_dep_source_cache\\n            let mut parse_count_after_deps = initial_parse_count\\n            let dep_fps = empty_dep_fps()\\n            while i < dlen {\\n              let dep_path = Array::get(deps, i)\\n              let (dep_fp, next_db, next_env_cache, next_dep_source_cache2, next_parse_count) = ensure_fingerprint_fs_go(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, dep_path, stack)\\n              db_after_deps = next_db\\n              env_cache_after_deps = next_env_cache\\n              dep_source_cache_after_deps = next_dep_source_cache2\\n              parse_count_after_deps = next_parse_count\\n              Array::push(dep_fps, (dep_path, dep_fp))\\n              i = i + 1\\n            }\\n            Array::truncate(stack, saved_stack_len)\\n            let fingerprint = build_fingerprint(source, dep_fps)\\n            match ripple_get_fingerprint(db_after_deps, path) {\\n              Some(cached_fp) =>\\n              if cached_fp == fingerprint {\\n                (fingerprint, db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps)\\n              } else {\\n                finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n              },\\n              None =>\\n              finish_typecheck_fs_impl(db_after_deps, env_cache_after_deps, dep_source_cache_after_deps, parse_count_after_deps, path, source, deps, fingerprint)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\nexport let ensure_fingerprint_fs_impl: (RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int, String, Array[String]) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } = (rdb, env_cache, dep_source_cache, parse_count, path, stack) -> {\\n  let (fingerprint, next_db, next_env_cache, next_dep_source_cache, next_parse_count) = ensure_fingerprint_fs_go(rdb, env_cache, dep_source_cache, parse_count, path, stack)\\n  let final_env_cache = ensure_env_cache_for_path(next_db, next_env_cache, path)\\n  (fingerprint, next_db, final_env_cache, next_dep_source_cache, next_parse_count)\\n}\\nexport let collect_all_diagnostics: (String) -> Array[String] with { Error } = (source) -> {\\n  let (tokens, starts, _ends) = lex_with_offsets(source)\\n  let (stmts, parse_diags) = parse_program_recovering(tokens, starts, source)\\n  if Array::length(parse_diags) > 0 {\\n    parse_diags\\n  } else {\\n    handle {\\n      let _env = check_program(stmts)\\n      Array::slice([\\n        \\\"_\\\"\\n      ], 0, 0)\\n    } with Error {\\n      Throw(msg) => [\\n        locate_type_error(source, msg)\\n      ]\\n    }\\n  }\\n}\\nenum StringTriple {\\n  StringTriple(String, String, String)\\n}\\nenum TypeDbState {\\n  TypeDbState(\\n    RippleDb,\\n    Array[(String, TypeEnv)],\\n    Array[(String, String)],\\n    Array[StringTriple],\\n    Array[StringTriple],\\n    Array[StringTriple],\\n    Int,\\n    Int,\\n    Int,\\n    Int\\n  )\\n}\\nexport enum TypeDb {\\n  TypeDb(TypeDbState)\\n}\\nlet unwrap_db: (TypeDb) -> TypeDbState = (db) -> {\\n  match db {\\n    TypeDb(state) => state\\n  }\\n}\\nlet wrap_db: (TypeDbState) -> TypeDb = (state) -> {\\n  TypeDb(state)\\n}\\nlet parse_program_with_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\\n  handle {\\n    parse_program(lex(source))\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\nlet add_dep: (Array[String], String, String) -> Array[String] = (acc, raw_path, base_dir) -> {\\n  if String::length(raw_path) == 0 {\\n    acc\\n  } else {\\n    let resolved = resolve_import_path(base_dir, raw_path)\\n    if contains_str(acc, resolved) {\\n      acc\\n    } else {\\n      Array::push(acc, resolved)\\n      acc\\n    }\\n  }\\n}\\nlet empty_strings: () -> Array[String] = () -> {\\n  Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n}\\nlet empty_dep_fps: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\nlet empty_env_cache: () -> Array[(String, TypeEnv)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", EnvEmpty)\\n  ], 0, 0)\\n}\\nlet empty_string_pairs: () -> Array[(String, String)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\nlet empty_string_triples: () -> Array[StringTriple] = () -> {\\n  Array::slice([\\n    StringTriple(\\\"\\\", \\\"\\\", \\\"\\\")\\n  ], 0, 0)\\n}\\nlet empty_stmt_array: () -> Array[Stmt] = () -> {\\n  Array::slice([\\n    SExport([\\\"_dummy\\\"])\\n  ], 0, 0)\\n}\\nexport let db_new: () -> TypeDb = () -> {\\n  wrap_db(\\n    TypeDbState(\\n      ripple_new(),\\n      empty_env_cache(),\\n      empty_string_pairs(),\\n      empty_string_triples(),\\n      empty_string_triples(),\\n      empty_string_triples(),\\n      0,\\n      0,\\n      0,\\n      0\\n    )\\n  )\\n}\\nlet lookup_string_pair: (Array[(String, String)], String) -> Option[String] = (pairs, key) -> {\\n  let len = Array::length(pairs)\\n  let rec go: (Int) -> Option[String] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        Some(v)\\n      } else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\nlet upsert_string_pair: (Array[(String, String)], String, String) -> Array[(String, String)] = (pairs, key, value) -> {\\n  let len = Array::length(pairs)\\n  let b = ArrayBuilder::new()\\n  let rec build: (Int) -> Array[(String, String)] = (i) -> {\\n    if i >= len {\\n      ArrayBuilder::push(b, (key, value))\\n      ArrayBuilder::freeze(b)\\n    } else {\\n      let (k, v) = Array::get(pairs, i)\\n      if k == key {\\n        build(i + 1)\\n      } else {\\n        ArrayBuilder::push(b, (k, v))\\n        build(i + 1)\\n      }\\n    }\\n  }\\n  build(0)\\n}\\nexport let db_set_source: (TypeDb, String, String) -> TypeDb = (db, path, source) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\\n      wrap_db(\\n        TypeDbState(\\n          ripple_set_source(rdb, path, source),\\n          env_cache,\\n          dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n  }\\n}\\nlet lookup_env_cache: (Array[(String, TypeEnv)], String) -> Option[TypeEnv] = (cache, path) -> {\\n  let len = Array::length(cache)\\n  let rec go: (Int) -> Option[TypeEnv] = (i) -> {\\n    if i >= len {\\n      None\\n    } else {\\n      let (p, env) = Array::get(cache, i)\\n      if p == path {\\n        Some(env)\\n      } else {\\n        go(i + 1)\\n      }\\n    }\\n  }\\n  go(0)\\n}\\nlet resolve_cached_import_path: (String, String, Array[(String, TypeEnv)]) -> String = (base_dir, raw_path, cache) -> {\\n  let candidates = resolve_import_path_candidates(base_dir, raw_path)\\n  let mut selected = \\\"\\\"\\n  let mut i = 0\\n  while i < Array::length(candidates) && selected == \\\"\\\" {\\n    let candidate = Array::get(candidates, i)\\n    match lookup_env_cache(cache, candidate) {\\n      Some(_) => {\\n        selected = candidate\\n      },\\n      None => ()\\n    }\\n    i = i + 1\\n  }\\n  if selected == \\\"\\\" {\\n    resolve_import_path(base_dir, raw_path)\\n  } else {\\n    selected\\n  }\\n}\\nlet starts_with_upper: (String) -> Bool = (name) -> {\\n  if String::length(name) == 0 {\\n    false\\n  } else {\\n    let c = String::char_code_at(name, 0)\\n    c >= 65 && c <= 90\\n  }\\n}\\nlet rec type_returns_name: (Type, String) -> Bool = (ty, type_name) -> {\\n  match ty {\\n    CtEnum(name) => name == type_name,\\n    CtNamed(name, _) => name == type_name,\\n    CtFn(_, ret, _) => type_returns_name(ret, type_name),\\n    CtForAll(_, _, body) => type_returns_name(body, type_name),\\n    _ => false\\n  }\\n}\\nlet bind_enum_constructor_companions: (TypeEnv, Array[(String, Type)], String) -> TypeEnv = (acc, dep_bindings, enum_name) -> {\\n  let mut out = acc\\n  let mut i = 0\\n  while i < Array::length(dep_bindings) {\\n    let (candidate_name, candidate_ty) = Array::get(dep_bindings, i)\\n    if candidate_name != enum_name && starts_with_upper(candidate_name) && type_returns_name(candidate_ty, enum_name) {\\n      out = env_bind(out, candidate_name, candidate_ty)\\n    }\\n    i = i + 1\\n  }\\n  out\\n}\\nlet bind_import_names_from_cache: (TypeEnv, String, Array[(String, Option[String])], Array[(String, TypeEnv)]) -> TypeEnv = (acc, resolved, names, cache) -> {\\n  let dep_env = match lookup_env_cache(cache, resolved) {\\n    Some(e) => e,\\n    None => EnvEmpty\\n  }\\n  let dep_bindings = env_flat_bindings(dep_env)\\n  let nlen = Array::length(names)\\n  let rec bind_names: (Int, TypeEnv) -> TypeEnv = (j, nacc) -> {\\n    if j >= nlen {\\n      nacc\\n    } else {\\n      let (name, alias) = Array::get(names, j)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match env_lookup_flat(dep_bindings, name) {\\n        Some(t) => t,\\n        None => CtUnknown\\n      }\\n      let with_name = env_bind(nacc, bound_name, ty)\\n      let with_companions = match ty {\\n        CtEnum(enum_name) => bind_enum_constructor_companions(with_name, dep_bindings, enum_name),\\n        _ => if starts_with_upper(name) {\\n          bind_enum_constructor_companions(with_name, dep_bindings, name)\\n        } else {\\n          with_name\\n        }\\n      }\\n      bind_names(j + 1, with_companions)\\n    }\\n  }\\n  bind_names(0, acc)\\n}\\nlet build_import_env: (Array[Stmt], String, Array[(String, TypeEnv)]) -> TypeEnv = (stmts, base_dir, cache) -> {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, TypeEnv) -> TypeEnv = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        SReExport(raw_path, names) => {\\n          let resolved = resolve_cached_import_path(base_dir, raw_path, cache)\\n          bind_import_names_from_cache(acc, resolved, names, cache)\\n        },\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, EnvEmpty)\\n}\\nlet upsert_env_cache: (Array[(String, TypeEnv)], String, TypeEnv) -> Array[(String, TypeEnv)] = (cache, path, env) -> {\\n  let len = Array::length(cache)\\n  let b = ArrayBuilder::new()\\n  let rec build: (Int) -> Array[(String, TypeEnv)] = (i) -> {\\n    if i >= len {\\n      ArrayBuilder::push(b, (path, env))\\n      ArrayBuilder::freeze(b)\\n    } else {\\n      let (p, e) = Array::get(cache, i)\\n      if p == path {\\n        build(i + 1)\\n      } else {\\n        ArrayBuilder::push(b, (p, e))\\n        build(i + 1)\\n      }\\n    }\\n  }\\n  build(0)\\n}\\nlet compact_string_fingerprint: (String) -> String = (source) -> {\\n  let mod1 = 2147483647\\n  let mod2 = 2147483629\\n  let step1 = 131\\n  let step2 = 65599\\n  let len = String::length(source)\\n  let mut h1 = 17\\n  let mut h2 = 29\\n  let mut i = 0\\n  while i < len {\\n    let c = String::char_code_at(source, i)\\n    h1 = (h1 * step1 + c + 1) % mod1\\n    h2 = (h2 * step2 + c + i + 1) % mod2\\n    i = i + 1\\n  }\\n  String::concat(\\n    __to_string(len),\\n    String::concat(\\\":\\\", String::concat(__to_string(h1), String::concat(\\\":\\\", __to_string(h2))))\\n  )\\n}\\nlet store_persistent_type_env: (String, TypeEnv) -> Unit with { Error, Fs } = (fingerprint, env) -> {\\n  Fs::write_file(\\n    persistent_type_env_cache_path(fingerprint),\\n    persistent_type_env_cache_text(env)\\n  )\\n}\\nlet build_fingerprint: (String, Array[(String, String)]) -> String = (source, dep_fps) -> {\\n  let mut acc = compact_string_fingerprint(source)\\n  let mut i = 0\\n  while i < Array::length(dep_fps) {\\n    let dep_pair = Array::get(dep_fps, i)\\n    let dep_path = dep_pair.0\\n    let dep_fp = dep_pair.1\\n    let next = String::concat(\\n      acc,\\n      String::concat(\\\"|\\\", String::concat(dep_path, String::concat(\\\"=\\\", dep_fp)))\\n    )\\n    acc = compact_string_fingerprint(next)\\n    i = i + 1\\n  }\\n  acc\\n}\\nlet collect_import_deps_from_stmts: (Array[Stmt], String) -> Array[String] = (stmts, base_dir) -> {\\n  let len = Array::length(stmts)\\n  let rec go: (Int, Array[String]) -> Array[String] = (i, acc) -> {\\n    if i >= len {\\n      acc\\n    } else {\\n      let next = match Array::get(stmts, i) {\\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\\n        _ => acc\\n      }\\n      go(i + 1, next)\\n    }\\n  }\\n  go(0, empty_strings())\\n}\\nlet load_or_parse_deps_for_source_fs: (Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (dep_source_cache, path, source, parse_count) -> {\\n  match load_persistent_dep_list(path, source) {\\n    Some(deps) => (\\n      deps,\\n      upsert_string_pair(dep_source_cache, path, source),\\n      parse_count\\n    ),\\n    None => {\\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\\n      (\\n        deps,\\n        upsert_string_pair(dep_source_cache, path, source),\\n        next_parse_count\\n      )\\n    }\\n  }\\n}\\nlet resolve_deps_for_source_fs: (RippleDb, Array[(String, String)], String, String, Int) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } = (rdb, dep_source_cache, path, source, parse_count) -> {\\n  match lookup_string_pair(dep_source_cache, path) {\\n    Some(cached_source) =>\\n      if cached_source == source {\\n        match ripple_get_deps(rdb, path) {\\n          Some(deps) => (deps, dep_source_cache, parse_count),\\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n        }\\n      } else {\\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n      },\\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\\n  }\\n}\\nexport let db_typecheck_fs: (TypeDb, String) -> TypeDb with { Error, Fs } = (db, path) -> {\\n  match unwrap_db(db) {\\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\\n      let (\\n        _,\\n        next_rdb,\\n        next_env_cache,\\n        next_dep_source_cache,\\n        next_parse_count\\n      ) = ensure_fingerprint_fs_impl(\\n        rdb,\\n        env_cache,\\n        dep_source_cache,\\n        parse_count,\\n        path,\\n        empty_strings()\\n      )\\n      wrap_db(\\n        TypeDbState(\\n          next_rdb,\\n          next_env_cache,\\n          next_dep_source_cache,\\n          merged_cache,\\n          module_source_cache,\\n          artifact_cache,\\n          next_parse_count,\\n          merge_count,\\n          module_source_count,\\n          codegen_count\\n        )\\n      )\\n    }\\n  }\\n}\\nlet lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    if path == target_path {\\n      found = Some(source)\\n      i = Array::length(sources)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\nlet append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {\\n  let refs = collect_import_alias_collision_refs(stmts)\\n  let emitted = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let base_dir = dir_of_path(current_path)\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (raw_path, original, local) = Array::get(refs, i)\\n    if !contains_str(emitted, local) {\\n      let resolved = resolve_import_path(base_dir, raw_path)\\n      match lookup_source_by_path(sources, resolved) {\\n        Some(source) => {\\n          let source_stmts = namespace_private_value_stmts(\\n            resolved,\\n            parse_program_with_path(resolved, source)\\n          )\\n          let mut j = 0\\n          let mut done = false\\n          while j < Array::length(source_stmts) && !done {\\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\\n              Some(local_stmt) => {\\n                Array::push(merged, local_stmt)\\n                Array::push(emitted, local)\\n                done = true\\n              },\\n              None => ()\\n            }\\n            j = j + 1\\n          }\\n        },\\n        None => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\nexport effect Profiler {\\n  NowUs -> Int\\n}\\nlet seed_type_db_from_source_groups: (TypeDb, Array[(String, Array[(String, String)])]) -> TypeDb = (db, source_groups) -> {\\n  let mut seeded = db\\n  let mut gi = 0\\n  while gi < Array::length(source_groups) {\\n    let (_, sources) = Array::get(source_groups, gi)\\n    let mut si = 0\\n    while si < Array::length(sources) {\\n      let (path, source) = Array::get(sources, si)\\n      seeded = db_set_source(seeded, path, source)\\n      si = si + 1\\n    }\\n    gi = gi + 1\\n  }\\n  seeded\\n}\\nlet append_stmt_array: (Array[Stmt], Array[Stmt]) -> Unit = (dst, src) -> {\\n  let mut i = 0\\n  while i < Array::length(src) {\\n    Array::push(dst, Array::get(src, i))\\n    i = i + 1\\n  }\\n}\\nlet string_array_contains: (Array[String], String) -> Bool = (items, target) -> {\\n  let mut i = 0\\n  let mut found = false\\n  while i < Array::length(items) && !found {\\n    if Array::get(items, i) == target {\\n      found = true\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\nlet lookup_source_by_path: (Array[(String, String)], String) -> Option[String] = (sources, target_path) -> {\\n  let mut i = 0\\n  let mut found = None\\n  while i < Array::length(sources) {\\n    let (path, source) = Array::get(sources, i)\\n    if path == target_path {\\n      found = Some(source)\\n      i = Array::length(sources)\\n    } else {\\n      i = i + 1\\n    }\\n  }\\n  found\\n}\\nlet parse_program_for_path: (String, String) -> Array[Stmt] with { Error } = (path, source) -> {\\n  handle {\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    parse_program_located(tokens, starts, source)\\n  } with Error {\\n    Throw(msg) => throw(String::concat(String::concat(path, \\\": \\\"), msg))\\n  }\\n}\\nlet append_import_alias_collision_defs_from_sources: (Array[Stmt], String, Array[Stmt], Array[(String, String)]) -> Unit with { Error } = (merged, current_path, stmts, sources) -> {\\n  let refs = collect_import_alias_collision_refs(stmts)\\n  let emitted = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let base_dir = dir_of_path(current_path)\\n  let mut i = 0\\n  while i < Array::length(refs) {\\n    let (raw_path, original, local) = Array::get(refs, i)\\n    if !string_array_contains(emitted, local) {\\n      let resolved = resolve_import_path(base_dir, raw_path)\\n      match lookup_source_by_path(sources, resolved) {\\n        Some(source) => {\\n          let source_stmts = namespace_private_value_stmts(\\n            resolved,\\n            parse_program_for_path(resolved, source)\\n          )\\n          let mut j = 0\\n          let mut done = false\\n          while j < Array::length(source_stmts) && !done {\\n            match rewrite_imported_value_stmt_to_local(Array::get(source_stmts, j), original, local) {\\n              Some(local_stmt) => {\\n                Array::push(merged, local_stmt)\\n                Array::push(emitted, local)\\n                done = true\\n              },\\n              None => ()\\n            }\\n            j = j + 1\\n          }\\n        },\\n        None => ()\\n      }\\n    }\\n    i = i + 1\\n  }\\n}\\nlet build_merged_stmts_from_sources: (String, Array[(String, String)]) -> Array[Stmt] with { Error } = (entry_path, sources) -> {\\n  let merged = empty_stmt_array()\\n  let source_count = Array::length(sources)\\n  let mut si = 0\\n  while si < source_count {\\n    let (path, source) = Array::get(sources, si)\\n    let stmts = parse_program_for_path(path, source)\\n    let is_entry_source = if entry_path == \\\"\\\" {\\n      si == source_count - 1\\n    } else {\\n      path == entry_path\\n    }\\n    let namespaced_stmts = if is_entry_source {\\n      stmts\\n    } else {\\n      namespace_private_value_stmts(path, stmts)\\n    }\\n    if stmts_have_import_deep(stmts) {\\n      let skipped_locals = collect_import_alias_collision_locals(stmts)\\n      append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)\\n      append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\\n    } else {\\n      append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\\n    }\\n    si = si + 1\\n  }\\n  merged\\n}\\nlet build_grouped_merged_stmts: (Array[(String, Array[(String, String)])]) -> Array[Stmt] with { Error } = (source_groups) -> {\\n  let merged = empty_stmt_array()\\n  let mut gi = 0\\n  while gi < Array::length(source_groups) {\\n    let (_, sources) = Array::get(source_groups, gi)\\n    let group_stmts = build_merged_stmts_from_sources(\\\"\\\", sources)\\n    append_stmt_array(merged, group_stmts)\\n    gi = gi + 1\\n  }\\n  merged\\n}\\nlet path_basename: (String) -> String = (p) -> {\\n  let n = String::length(p)\\n  let mut last = 0 - 1\\n  let mut i = 0\\n  while i < n {\\n    if String::char_code_at(p, i) == 47 {\\n      last = i\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  String::substring(p, last + 1, n)\\n}\\nlet file_newline_offsets: (String) -> Array[Int] = (src) -> {\\n  let arr = Array::slice([\\n    0\\n  ], 0, 0)\\n  let n = String::length(src)\\n  let mut i = 0\\n  while i < n {\\n    if String::char_code_at(src, i) == 10 {\\n      Array::push(arr, i)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  arr\\n}\\nlet build_grouped_merged_stmts_prov: (Array[(String, Array[(String, String)])]) -> (Array[Stmt], Array[String], Array[Array[Int]], Array[Int]) with { Error } = (source_groups) -> {\\n  let merged = empty_stmt_array()\\n  let files = Array::slice([\\n    \\\"\\\"\\n  ], 0, 0)\\n  let file_nls = Array::slice([\\n    Array::slice([\\n      0\\n    ], 0, 0)\\n  ], 0, 0)\\n  let stmt_file_id = Array::slice([\\n    0\\n  ], 0, 0)\\n  let mut gi = 0\\n  while gi < Array::length(source_groups) {\\n    let (_, sources) = Array::get(source_groups, gi)\\n    let source_count = Array::length(sources)\\n    let mut si = 0\\n    while si < source_count {\\n      let (path, source) = Array::get(sources, si)\\n      let file_id = Array::length(files)\\n      Array::push(files, path_basename(path))\\n      Array::push(file_nls, file_newline_offsets(source))\\n      let before = Array::length(merged)\\n      let stmts = parse_program_for_path(path, source)\\n      let is_entry_source = si == source_count - 1\\n      let namespaced_stmts = if is_entry_source {\\n        stmts\\n      } else {\\n        namespace_private_value_stmts(path, stmts)\\n      }\\n      if stmts_have_import_deep(stmts) {\\n        let skipped_locals = collect_import_alias_collision_locals(stmts)\\n        append_import_alias_collision_defs_from_sources(merged, path, stmts, sources)\\n        append_import_alias_rewritten_non_import_stmts_skipping(merged, namespaced_stmts, skipped_locals)\\n      } else {\\n        append_non_import_stmts_without_alias_rewrite(merged, namespaced_stmts)\\n      }\\n      let after = Array::length(merged)\\n      let mut k = before\\n      while k < after {\\n        Array::push(stmt_file_id, file_id)\\n        k = k + 1\\n      }\\n      si = si + 1\\n    }\\n    gi = gi + 1\\n  }\\n  (merged, files, file_nls, stmt_file_id)\\n}\\nlet prepare_file_fs_from_source_groups_persistent_cached: (TypeDb, String, Array[(String, Array[(String, String)])]) -> TypeDb with { Error, Fs } = (db, entry_path, source_groups) -> {\\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\\n  db_typecheck_fs(seeded, entry_path)\\n}\\nexport let compile_file_fs_mode: (String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode) -> {\\n  let source_groups = collect_source_groups_fs(entry_path)\\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\\n  let _ = next_db\\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\\n  if mode == \\\"mvp\\\" {\\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\\n    compile_wasi_module_impl(pruned_stmts, entry_name)\\n  } else if mode == \\\"no-dce\\\" {\\n    compile_wasi_module(merged_stmts, entry_name)\\n  } else {\\n    throw(String::concat(\\\"unsupported compile mode: \\\", mode))\\n  }\\n}\\nexport let compile_file_fs_mode_rc: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\\n  let source_groups = collect_source_groups_fs(entry_path)\\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\\n  let _ = next_db\\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\\n  compile_wasi_module_rc(merged_stmts, entry_name)\\n}\\nexport let compile_file_fs_mode_testmeta: (String, String, String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name, mode, meta_out) -> {\\n  let source_groups = collect_source_groups_fs(entry_path)\\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\\n  let _ = next_db\\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\\n  let cacheable = if meta_out != \\\"\\\" {\\n    file_tests_cacheable(merged_stmts)\\n  } else {\\n    false\\n  }\\n  let bytes = if mode == \\\"mvp\\\" {\\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\\n    compile_wasi_module_impl(pruned_stmts, entry_name)\\n  } else if mode == \\\"no-dce\\\" {\\n    compile_wasi_module(merged_stmts, entry_name)\\n  } else {\\n    throw(String::concat(\\\"unsupported compile mode: \\\", mode))\\n  }\\n  if meta_out != \\\"\\\" {\\n    Fs::write_file(meta_out, if cacheable {\\n      \\\"1\\\"\\n    } else {\\n      \\\"0\\\"\\n    })\\n  } else {\\n    ()\\n  }\\n  bytes\\n}\\nexport let compile_file_fs_mode_coverage: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\\n  let source_groups = collect_source_groups_fs(entry_path)\\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\\n  let _ = next_db\\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\\n  compile_wasi_module_coverage(merged_stmts, entry_name)\\n}\\nexport let compile_file_fs_mode_trace: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\\n  let source_groups = collect_source_groups_fs(entry_path)\\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\\n  let _ = next_db\\n  let merged_stmts = build_grouped_merged_stmts(source_groups)\\n  compile_wasi_module_trace(merged_stmts, entry_name)\\n}\\nexport let compile_file_fs_mode_break: (String, String) -> Bytes with { Error, Fs } = (entry_path, entry_name) -> {\\n  let source_groups = collect_source_groups_fs(entry_path)\\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\\n  let _ = next_db\\n  let (merged_stmts, dbg_files, dbg_file_nls, dbg_stmt_file_id) = build_grouped_merged_stmts_prov(source_groups)\\n  compile_wasi_module_break(merged_stmts, entry_name, DbgProv::{\\n    files: dbg_files,\\n    file_nls: dbg_file_nls,\\n    stmt_file_id: dbg_stmt_file_id\\n  })\\n}\\nlet line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {\\n  let len = String::length(source)\\n  let mut i = 0\\n  let mut cur_line = 1\\n  while cur_line < line && i < len {\\n    if String::char_code_at(source, i) == 10 {\\n      cur_line = cur_line + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  let off = i + (col - 1)\\n  if off < 0 {\\n    0\\n  } else if off > len {\\n    len\\n  } else {\\n    off\\n  }\\n}\\nenum IdentHit {\\n  IdentHit(String, Int)\\n}\\nlet empty_hits: () -> Array[IdentHit] = () -> {\\n  Array::slice([\\n    IdentHit(\\\"\\\", -1)\\n  ], 0, 0)\\n}\\nlet rec collect_expr: (Expr, Array[IdentHit]) -> Unit = (expr, acc) -> {\\n  match expr {\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(name, off) => {\\n      if off >= 0 {\\n        Array::push(acc, IdentHit(name, off))\\n      } else {\\n        ()\\n      }\\n    },\\n    EUnit => (),\\n    EStringInterp(_) => (),\\n    ETuple(items) => collect_exprs(items, acc),\\n    EArray(items) => collect_exprs(items, acc),\\n    ERecord(fields) => collect_field_exprs(fields, acc),\\n    EIf(c, t, e) => {\\n      collect_expr(c, acc)\\n      collect_expr(t, acc)\\n      collect_expr(e, acc)\\n    },\\n    ELet(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELetRec(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELetMut(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    EAssign(_, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    EAssignOp(_, _, v, b) => {\\n      collect_expr(v, acc)\\n      collect_expr(b, acc)\\n    },\\n    ESeq(a, b) => {\\n      collect_expr(a, acc)\\n      collect_expr(b, acc)\\n    },\\n    EMatch(s, arms) => {\\n      collect_expr(s, acc)\\n      collect_arm_exprs(arms, acc)\\n    },\\n    EHandle(s, arms) => {\\n      collect_expr(s, acc)\\n      collect_arm_exprs(arms, acc)\\n    },\\n    EWhile(c, b) => {\\n      collect_expr(c, acc)\\n      collect_expr(b, acc)\\n    },\\n    ELoop(params, b) => {\\n      collect_loop_param_exprs(params, acc)\\n      collect_expr(b, acc)\\n    },\\n    EForIn(_, _, it, b) => {\\n      collect_expr(it, acc)\\n      collect_expr(b, acc)\\n    },\\n    ECall(callee, args, _) => {\\n      collect_expr(callee, acc)\\n      collect_exprs(args, acc)\\n    },\\n    EBinOp(_, l, r) => {\\n      collect_expr(l, acc)\\n      collect_expr(r, acc)\\n    },\\n    EUnaryOp(_, e) => collect_expr(e, acc),\\n    EFn(_, _, _, _, _, body) => collect_expr(body, acc),\\n    EDot(e, _, _) => collect_expr(e, acc),\\n    ELabeledArg(_, _, v) => collect_expr(v, acc),\\n    EThrow(e) => collect_expr(e, acc),\\n    EReturn(e) => collect_expr(e, acc),\\n    EBreak(opt) => match opt {\\n      Some(v) => collect_expr(v, acc),\\n      None => ()\\n    },\\n    EContinue(args) => collect_exprs(args, acc),\\n    EMap(fields) => collect_field_exprs(fields, acc),\\n    ESpread(e) => collect_expr(e, acc)\\n  }\\n}\\nlet collect_exprs: (Array[Expr], Array[IdentHit]) -> Unit = (items, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    collect_expr(Array::get(items, i), acc)\\n    i = i + 1\\n  }\\n}\\nlet collect_field_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (fields, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (_, v) = Array::get(fields, i)\\n    collect_expr(v, acc)\\n    i = i + 1\\n  }\\n}\\nlet collect_arm_exprs: (Array[(Pat, Expr)], Array[IdentHit]) -> Unit = (arms, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (_, e) = Array::get(arms, i)\\n    collect_expr(e, acc)\\n    i = i + 1\\n  }\\n}\\nlet collect_loop_param_exprs: (Array[(String, Expr)], Array[IdentHit]) -> Unit = (params, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(params) {\\n    let (_, init) = Array::get(params, i)\\n    collect_expr(init, acc)\\n    i = i + 1\\n  }\\n}\\nlet collect_stmt: (Stmt, Array[IdentHit]) -> Unit = (stmt, acc) -> {\\n  match stmt {\\n    SLet(_, _, _, _, body) => collect_expr(body, acc),\\n    SLetMut(_, _, body) => collect_expr(body, acc),\\n    STest(_, body) => collect_expr(body, acc),\\n    SBench(_, body) => collect_expr(body, acc),\\n    SExpr(e) => collect_expr(e, acc),\\n    SLetPat(_, body) => collect_expr(body, acc),\\n    SModule(_, _, body) => collect_stmts(body, acc),\\n    _ => ()\\n  }\\n}\\nlet collect_stmts: (Array[Stmt], Array[IdentHit]) -> Unit = (stmts, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    collect_stmt(Array::get(stmts, i), acc)\\n    i = i + 1\\n  }\\n}\\nlet is_boundary_at: (String, Int) -> Bool = (source, off) -> {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\nlet push_binding_name_hit: (String, Int, Int, String, Array[IdentHit]) -> Unit = (source, start, end, name, acc) -> {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    ()\\n  } else {\\n    let limit = if end > String::length(source) { String::length(source) } else { end }\\n    let mut i = if start < 0 { 0 } else { start }\\n    let mut found = false\\n    while !found && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && is_boundary_at(source, i - 1) && is_boundary_at(source, i + nlen) {\\n        Array::push(acc, IdentHit(name, i))\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\nlet collect_binding_name_hits: (Array[Stmt], Array[Int], Array[Int], String, Array[IdentHit]) -> Unit = (stmts, span_start, span_end, source, acc) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    let start = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\\n    let end = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\\n    match Array::get(stmts, i) {\\n      SLet(_, _, name, _, _) => push_binding_name_hit(source, start, end, name, acc),\\n      SLetMut(name, _, _) => push_binding_name_hit(source, start, end, name, acc),\\n      _ => ()\\n    }\\n    i = i + 1\\n  }\\n}\\nlet pick_ident_at: (Array[IdentHit], Int) -> String = (hits, tgt) -> {\\n  let mut best_name = \\\"\\\"\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      IdentHit(name, off) => {\\n        let span_end = off + String::length(name)\\n        if off <= tgt && tgt < span_end && off > best_off {\\n          best_name = name\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  best_name\\n}\\nlet pick_ident_off: (Array[IdentHit], Int) -> Int = (hits, tgt) -> {\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      IdentHit(name, off) => {\\n        let span_end = off + String::length(name)\\n        if off <= tgt && tgt < span_end && off > best_off {\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  best_off\\n}\\nlet tytab_lookup: (Array[(Int, Type)], Int) -> Option[Type] = (table, off) -> {\\n  let mut found = None\\n  let mut i = 0\\n  while i < Array::length(table) {\\n    let (toff, tty) = Array::get(table, i)\\n    if toff == off {\\n      found = Some(tty)\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  found\\n}\\nexport let type_at_source: (String, Int, Int) -> String = (source, line, col) -> {\\n  handle {\\n    let tgt = line_col_to_offset(source, line, col)\\n    let (tokens, starts, ends) = lex_with_offsets(source)\\n    let stmts = parse_program_located(tokens, starts, source)\\n    let hits = empty_hits()\\n    collect_stmts(stmts, hits)\\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\\n    collect_binding_name_hits(span_stmts, span_start, span_end, source, hits)\\n    let name = pick_ident_at(hits, tgt)\\n    if name == \\\"\\\" {\\n      \\\"\\\"\\n    } else {\\n      let chosen_off = pick_ident_off(hits, tgt)\\n      let (table, final_s) = check_program_type_table(stmts)\\n      let table_hit = if chosen_off >= 0 {\\n        tytab_lookup(table, chosen_off)\\n      } else {\\n        None\\n      }\\n      match table_hit {\\n        Some(rec_ty) => type_to_string(subst_apply(final_s, rec_ty)),\\n        None => {\\n          let env = check_program(stmts)\\n          match env_lookup(env, name) {\\n            Some(t) => type_to_string(t),\\n            None => \\\"\\\"\\n          }\\n        }\\n      }\\n    }\\n  } with Error {\\n    Throw(_) => \\\"\\\"\\n  }\\n}\\nlet bind_line_col_to_offset: (String, Int, Int) -> Int = (source, line, col) -> {\\n  let len = String::length(source)\\n  let mut i = 0\\n  let mut cur_line = 1\\n  while cur_line < line && i < len {\\n    if String::char_code_at(source, i) == 10 {\\n      cur_line = cur_line + 1\\n    } else {\\n      ()\\n    }\\n    i = i + 1\\n  }\\n  let off = i + (col - 1)\\n  if off < 0 {\\n    0\\n  } else if off > len {\\n    len\\n  } else {\\n    off\\n  }\\n}\\nenum BindHit {\\n  BindHit(String, Int, Int)\\n}\\nlet bind_empty_hits: () -> Array[BindHit] = () -> {\\n  Array::slice([\\n    BindHit(\\\"\\\", -1, 0)\\n  ], 0, 0)\\n}\\nlet bind_is_boundary_at: (String, Int) -> Bool = (source, off) -> {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\nlet bind_find_word: (String, String, Int) -> Int = (source, name, from) -> {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    -1\\n  } else {\\n    let limit = String::length(source)\\n    let mut i = if from < 0 { 0 } else { from }\\n    let mut found = -1\\n    while found < 0 && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && bind_is_boundary_at(source, i - 1) && bind_is_boundary_at(source, i + nlen) {\\n        found = i\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n    found\\n  }\\n}\\nstruct BindState {\\n  hits: Array[BindHit];\\n  scope_names: Array[String];\\n  scope_ids: Array[Int];\\n  floor: Array[Int];\\n  source: String\\n}\\nlet bind_box_int: (Int) -> Array[Int] = (v) -> {\\n  let arr = Array::slice([0], 0, 0)\\n  Array::push(arr, v)\\n  arr\\n}\\nlet bind_new_state: (String) -> BindState = (source) -> {\\n  BindState::{\\n    hits: bind_empty_hits(),\\n    scope_names: Array::slice([\\\"\\\"], 0, 0),\\n    scope_ids: Array::slice([0], 0, 0),\\n    floor: bind_box_int(0),\\n    source: source\\n  }\\n}\\nlet bind_resolve: (BindState, String) -> Int = (st, name) -> {\\n  let n = Array::length(st.scope_names)\\n  let mut i = n - 1\\n  let mut found = 0\\n  while i >= 0 && found == 0 {\\n    if Array::get(st.scope_names, i) == name {\\n      found = Array::get(st.scope_ids, i)\\n    } else {\\n      ()\\n    }\\n    i = i - 1\\n  }\\n  found\\n}\\nlet bind_pop_scope: (BindState, Int) -> Unit = (st, mark) -> {\\n  Array::truncate(st.scope_names, mark)\\n  Array::truncate(st.scope_ids, mark)\\n}\\nlet bind_recover_binder: (BindState, String) -> Int = (st, name) -> {\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  let id = if off >= 0 { off + 1 } else { 0 }\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, id))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n  id\\n}\\nlet bind_push_binder: (BindState, String, Int) -> Unit = (st, name, id) -> {\\n  Array::push(st.scope_names, name)\\n  Array::push(st.scope_ids, id)\\n}\\nlet bind_introduce: (BindState, String) -> Unit = (st, name) -> {\\n  let id = bind_recover_binder(st, name)\\n  bind_push_binder(st, name, id)\\n}\\nlet bind_record_ref: (BindState, String, Int) -> Unit = (st, name, off) -> {\\n  if off >= 0 {\\n    let key = bind_resolve(st, name)\\n    Array::push(st.hits, BindHit(name, off, key))\\n    if off >= Array::get(st.floor, 0) {\\n      Array::set(st.floor, 0, off + String::length(name))\\n    } else {\\n      ()\\n    }\\n  } else {\\n    ()\\n  }\\n}\\nlet bind_record_assign_target: (BindState, String) -> Unit = (st, name) -> {\\n  let key = bind_resolve(st, name)\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, key))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n}\\nlet rec bind_introduce_pat: (BindState, Pat) -> Unit = (st, pat) -> {\\n  match pat {\\n    PWild => (),\\n    PBind(name) => bind_introduce(st, name),\\n    PInt(_) => (),\\n    PString(_) => (),\\n    PBool(_) => (),\\n    PCtor(_, sub) => bind_introduce_pats(st, sub),\\n    PTuple(sub) => bind_introduce_pats(st, sub),\\n    POr(a, b) => {\\n      bind_introduce_pat(st, a)\\n      bind_introduce_pat(st, b)\\n    },\\n    PStruct(_, fields) => {\\n      let mut i = 0\\n      while i < Array::length(fields) {\\n        let (_, fp) = Array::get(fields, i)\\n        bind_introduce_pat(st, fp)\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\nlet bind_introduce_pats: (BindState, Array[Pat]) -> Unit = (st, sub) -> {\\n  let mut i = 0\\n  while i < Array::length(sub) {\\n    bind_introduce_pat(st, Array::get(sub, i))\\n    i = i + 1\\n  }\\n}\\nlet rec bind_walk_expr: (BindState, Expr) -> Unit = (st, expr) -> {\\n  match expr {\\n    EInt(_) => (),\\n    EFloat(_) => (),\\n    EString(_) => (),\\n    EBool(_) => (),\\n    EIdent(name, off) => bind_record_ref(st, name, off),\\n    EUnit => (),\\n    EStringInterp(_) => (),\\n    ETuple(items) => bind_walk_exprs(st, items),\\n    EArray(items) => bind_walk_exprs(st, items),\\n    ERecord(fields) => bind_walk_field_exprs(st, fields),\\n    EIf(c, t, e) => {\\n      bind_walk_expr(st, c)\\n      bind_walk_expr(st, t)\\n      bind_walk_expr(st, e)\\n    },\\n    ELet(name, v, b) => {\\n      let id = bind_recover_binder(st, name)\\n      bind_walk_expr(st, v)\\n      let mark = Array::length(st.scope_names)\\n      bind_push_binder(st, name, id)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ELetRec(name, v, b) => {\\n      let mark = Array::length(st.scope_names)\\n      bind_introduce(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ELetMut(name, v, b) => {\\n      let id = bind_recover_binder(st, name)\\n      bind_walk_expr(st, v)\\n      let mark = Array::length(st.scope_names)\\n      bind_push_binder(st, name, id)\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    EAssign(name, v, b) => {\\n      bind_record_assign_target(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n    },\\n    EAssignOp(name, _, v, b) => {\\n      bind_record_assign_target(st, name)\\n      bind_walk_expr(st, v)\\n      bind_walk_expr(st, b)\\n    },\\n    ESeq(a, b) => {\\n      bind_walk_expr(st, a)\\n      bind_walk_expr(st, b)\\n    },\\n    EMatch(s, arms) => {\\n      bind_walk_expr(st, s)\\n      bind_walk_arms(st, arms)\\n    },\\n    EHandle(s, arms) => {\\n      bind_walk_expr(st, s)\\n      bind_walk_arms(st, arms)\\n    },\\n    EWhile(c, b) => {\\n      bind_walk_expr(st, c)\\n      bind_walk_expr(st, b)\\n    },\\n    ELoop(params, b) => {\\n      let mark = Array::length(st.scope_names)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, init) = Array::get(params, i)\\n        bind_walk_expr(st, init)\\n        bind_introduce(st, pname)\\n        i = i + 1\\n      }\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    EForIn(name, idx_opt, it, b) => {\\n      bind_walk_expr(st, it)\\n      let mark = Array::length(st.scope_names)\\n      bind_introduce(st, name)\\n      match idx_opt {\\n        Some(idx) => bind_introduce(st, idx),\\n        None => ()\\n      }\\n      bind_walk_expr(st, b)\\n      bind_pop_scope(st, mark)\\n    },\\n    ECall(callee, args, _) => {\\n      bind_walk_expr(st, callee)\\n      bind_walk_exprs(st, args)\\n    },\\n    EBinOp(_, l, r) => {\\n      bind_walk_expr(st, l)\\n      bind_walk_expr(st, r)\\n    },\\n    EUnaryOp(_, e) => bind_walk_expr(st, e),\\n    EFn(_, _, params, _, _, body) => {\\n      let mark = Array::length(st.scope_names)\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (pname, _) = Array::get(params, i)\\n        bind_introduce(st, pname)\\n        i = i + 1\\n      }\\n      bind_walk_expr(st, body)\\n      bind_pop_scope(st, mark)\\n    },\\n    EDot(e, _, _) => bind_walk_expr(st, e),\\n    ELabeledArg(_, _, v) => bind_walk_expr(st, v),\\n    EThrow(e) => bind_walk_expr(st, e),\\n    EReturn(e) => bind_walk_expr(st, e),\\n    EBreak(opt) => match opt {\\n      Some(v) => bind_walk_expr(st, v),\\n      None => ()\\n    },\\n    EContinue(args) => bind_walk_exprs(st, args),\\n    EMap(fields) => bind_walk_field_exprs(st, fields),\\n    ESpread(e) => bind_walk_expr(st, e)\\n  }\\n}\\nlet bind_walk_exprs: (BindState, Array[Expr]) -> Unit = (st, items) -> {\\n  let mut i = 0\\n  while i < Array::length(items) {\\n    bind_walk_expr(st, Array::get(items, i))\\n    i = i + 1\\n  }\\n}\\nlet bind_walk_field_exprs: (BindState, Array[(String, Expr)]) -> Unit = (st, fields) -> {\\n  let mut i = 0\\n  while i < Array::length(fields) {\\n    let (_, v) = Array::get(fields, i)\\n    bind_walk_expr(st, v)\\n    i = i + 1\\n  }\\n}\\nlet bind_walk_arms: (BindState, Array[(Pat, Expr)]) -> Unit = (st, arms) -> {\\n  let mut i = 0\\n  while i < Array::length(arms) {\\n    let (pat, e) = Array::get(arms, i)\\n    let mark = Array::length(st.scope_names)\\n    bind_introduce_pat(st, pat)\\n    bind_walk_expr(st, e)\\n    bind_pop_scope(st, mark)\\n    i = i + 1\\n  }\\n}\\nlet bind_record_module_binder: (BindState, String) -> Unit = (st, name) -> {\\n  let from = Array::get(st.floor, 0)\\n  let off = bind_find_word(st.source, name, from)\\n  if off >= 0 {\\n    Array::push(st.hits, BindHit(name, off, 0))\\n    Array::set(st.floor, 0, off + String::length(name))\\n  } else {\\n    ()\\n  }\\n}\\nlet bind_walk_stmt: (BindState, Stmt) -> Unit = (st, stmt) -> {\\n  match stmt {\\n    SLet(_, _, name, _, body) => {\\n      bind_record_module_binder(st, name)\\n      bind_walk_expr(st, body)\\n    },\\n    SLetMut(name, _, body) => {\\n      bind_record_module_binder(st, name)\\n      bind_walk_expr(st, body)\\n    },\\n    STest(_, body) => bind_walk_expr(st, body),\\n    SBench(_, body) => bind_walk_expr(st, body),\\n    SExpr(e) => bind_walk_expr(st, e),\\n    SLetPat(_, body) => bind_walk_expr(st, body),\\n    SModule(_, _, body) => bind_walk_stmts(st, body),\\n    _ => ()\\n  }\\n}\\nlet bind_walk_stmts: (BindState, Array[Stmt]) -> Unit = (st, stmts) -> {\\n  let mut i = 0\\n  while i < Array::length(stmts) {\\n    bind_walk_stmt(st, Array::get(stmts, i))\\n    i = i + 1\\n  }\\n}\\nlet bind_pick_at: (Array[BindHit], Int) -> (String, Int) = (hits, tgt) -> {\\n  let mut best_name = \\\"\\\"\\n  let mut best_key = 0\\n  let mut best_off = -1\\n  let mut i = 0\\n  while i < Array::length(hits) {\\n    match Array::get(hits, i) {\\n      BindHit(name, off, key) => {\\n        let span_end = off + String::length(name)\\n        if off >= 0 && off <= tgt && tgt < span_end && off > best_off {\\n          best_name = name\\n          best_key = key\\n          best_off = off\\n        } else {\\n          ()\\n        }\\n      }\\n    }\\n    i = i + 1\\n  }\\n  (best_name, best_key)\\n}\\nlet bind_insert_sorted_unique: (Array[(Int, Int)], Int, Int) -> Unit = (out, start, end) -> {\\n  let n = Array::length(out)\\n  let mut dup = false\\n  let mut idx = n\\n  let mut j = 0\\n  while j < n {\\n    let (s, _) = Array::get(out, j)\\n    if s == start {\\n      dup = true\\n    } else {\\n      ()\\n    }\\n    if s > start && idx == n {\\n      idx = j\\n    } else {\\n      ()\\n    }\\n    j = j + 1\\n  }\\n  if dup {\\n    ()\\n  } else if idx == n {\\n    Array::push(out, (start, end))\\n  } else {\\n    Array::push(out, Array::get(out, n - 1))\\n    let mut k = n - 1\\n    while k > idx {\\n      Array::set(out, k, Array::get(out, k - 1))\\n      k = k - 1\\n    }\\n    Array::set(out, idx, (start, end))\\n  }\\n}\\nlet binding_occurrences_impl: (String, Int, Int) -> Array[(Int, Int)] with { Error } = (source, line, col) -> {\\n  {\\n    let tgt = bind_line_col_to_offset(source, line, col)\\n    let (tokens, starts, _ends) = lex_with_offsets(source)\\n    let stmts = parse_program_located(tokens, starts, source)\\n    let st = bind_new_state(source)\\n    bind_walk_stmts(st, stmts)\\n    let hits = st.hits\\n    let (name, key) = bind_pick_at(hits, tgt)\\n    let out = Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n    if name == \\\"\\\" {\\n      out\\n    } else {\\n      let mut i = 0\\n      while i < Array::length(hits) {\\n        match Array::get(hits, i) {\\n          BindHit(hname, hoff, hkey) => {\\n            if hname == name && hkey == key && hoff >= 0 {\\n              bind_insert_sorted_unique(out, hoff, hoff + String::length(hname))\\n            } else {\\n              ()\\n            }\\n          }\\n        }\\n        i = i + 1\\n      }\\n      out\\n    }\\n  }\\n}\\nexport let binding_occurrences: (String, Int, Int) -> Array[(Int, Int)] = (source, line, col) -> {\\n  handle {\\n    binding_occurrences_impl(source, line, col)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      (0, 0)\\n    ], 0, 0)\\n  }\\n}\\nlet sym_is_boundary_at: (String, Int) -> Bool = (source, off) -> {\\n  if off < 0 || off >= String::length(source) {\\n    true\\n  } else {\\n    let c = String::char_code_at(source, off)\\n    let is_id = (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'\\n    !is_id\\n  }\\n}\\nlet sym_box_int: (Int) -> Array[Int] = (v) -> {\\n  let arr = Array::slice([0], 0, 0)\\n  Array::push(arr, v)\\n  arr\\n}\\nlet sym_empty_items: () -> Array[(String, Int, Int, Int)] = () -> {\\n  Array::slice([\\n    (\\\"\\\", 0, 0, 0)\\n  ], 0, 0)\\n}\\nlet sym_emit: (Array[(String, Int, Int, Int)], String, String, Int, Array[Int], Int) -> Unit = (out, source, name, kind, floor, hi) -> {\\n  let nlen = String::length(name)\\n  if nlen == 0 {\\n    ()\\n  } else {\\n    let limit = if hi > String::length(source) { String::length(source) } else { hi }\\n    let mut i = Array::get(floor, 0)\\n    if i < 0 {\\n      i = 0\\n    } else {\\n      ()\\n    }\\n    let mut found = false\\n    while !found && i + nlen <= limit {\\n      if String::substring(source, i, i + nlen) == name && sym_is_boundary_at(source, i - 1) && sym_is_boundary_at(source, i + nlen) {\\n        Array::push(out, (name, kind, i, i + nlen))\\n        Array::set(floor, 0, i + nlen)\\n        found = true\\n      } else {\\n        i = i + 1\\n      }\\n    }\\n  }\\n}\\nlet sym_let_kind: (Expr) -> Int = (body) -> {\\n  match body {\\n    EFn(_, _, _, _, _, _) => 12,\\n    _ => 13\\n  }\\n}\\nlet rec sym_walk_stmt: (Array[(String, Int, Int, Int)], String, Stmt, Array[Int], Int) -> Unit = (out, source, stmt, floor, hi) -> {\\n  match stmt {\\n    SLet(_, _, name, _, body) => sym_emit(out, source, name, sym_let_kind(body), floor, hi),\\n    SLetMut(name, _, _) => sym_emit(out, source, name, 13, floor, hi),\\n    SEnum(_, name, _, _, _) => sym_emit(out, source, name, 10, floor, hi),\\n    SSuberror(_, name, _) => sym_emit(out, source, name, 10, floor, hi),\\n    SStruct(_, name, _, _, _) => sym_emit(out, source, name, 23, floor, hi),\\n    STypeAlias(_, name, _, _) => sym_emit(out, source, name, 26, floor, hi),\\n    STrait(_, name, _, _, _) => sym_emit(out, source, name, 11, floor, hi),\\n    SEffectDef(_, name, _, _) => sym_emit(out, source, name, 24, floor, hi),\\n    SModule(_, name, body) => {\\n      sym_emit(out, source, name, 2, floor, hi)\\n      let mut j = 0\\n      while j < Array::length(body) {\\n        sym_walk_stmt(out, source, Array::get(body, j), floor, hi)\\n        j = j + 1\\n      }\\n    },\\n    _ => ()\\n  }\\n}\\nlet symbol_spans_impl: (String) -> Array[(String, Int, Int, Int)] with { Error } = (source) -> {\\n  {\\n    let (tokens, starts, ends) = lex_with_offsets(source)\\n    let (span_stmts, span_start, span_end) = parse_program_spans(tokens, starts, ends)\\n    let out = sym_empty_items()\\n    let mut i = 0\\n    while i < Array::length(span_stmts) {\\n      let lo = if i < Array::length(span_start) { Array::get(span_start, i) } else { 0 }\\n      let hi = if i < Array::length(span_end) { Array::get(span_end, i) } else { String::length(source) }\\n      let floor = sym_box_int(lo)\\n      sym_walk_stmt(out, source, Array::get(span_stmts, i), floor, hi)\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\nexport let symbol_spans: (String) -> Array[(String, Int, Int, Int)] = (source) -> {\\n  handle {\\n    symbol_spans_impl(source)\\n  } with Error {\\n    Throw(_) => Array::slice([\\n      (\\\"\\\", 0, 0, 0)\\n    ], 0, 0)\\n  }\\n}\\nlet join_lines: (Array[String]) -> String = (items) -> {\\n  let n = Array::length(items)\\n  if n == 0 {\\n    \\\"\\\"\\n  } else {\\n    let acc = StringBuilder::new()\\n    StringBuilder::push(acc, Array::get(items, 0))\\n    let mut i = 1\\n    while i < n {\\n      StringBuilder::push(acc, \\\"\\\\n\\\")\\n      StringBuilder::push(acc, Array::get(items, i))\\n      i = i + 1\\n    }\\n    StringBuilder::freeze(acc)\\n  }\\n}\\nlet join_symbol_spans: (Array[(String, Int, Int, Int)]) -> String = (syms) -> {\\n  let n = Array::length(syms)\\n  let acc = StringBuilder::new()\\n  let mut first = true\\n  let mut i = 0\\n  while i < n {\\n    let (name, kind, s, e) = Array::get(syms, i)\\n    if String::length(name) == 0 {\\n      ()\\n    } else {\\n      let line = String::concat(name, String::concat(\\\" \\\", String::concat(__to_string(kind), String::concat(\\\" \\\", String::concat(__to_string(s), String::concat(\\\" \\\", __to_string(e)))))))\\n      if first {\\n        StringBuilder::push(acc, line)\\n        first = false\\n      } else {\\n        StringBuilder::push(acc, \\\"\\\\n\\\")\\n        StringBuilder::push(acc, line)\\n      }\\n    }\\n    i = i + 1\\n  }\\n  StringBuilder::freeze(acc)\\n}\\nlet join_binding_occurrences: (Array[(Int, Int)]) -> String = (occ) -> {\\n  let n = Array::length(occ)\\n  if n == 0 {\\n    \\\"\\\"\\n  } else {\\n    let (s0, e0) = Array::get(occ, 0)\\n    let acc = StringBuilder::new()\\n    StringBuilder::push(acc, String::concat(__to_string(s0), String::concat(\\\" \\\", __to_string(e0))))\\n    let mut i = 1\\n    while i < n {\\n      let (s, e) = Array::get(occ, i)\\n      let line = String::concat(__to_string(s), String::concat(\\\" \\\", __to_string(e)))\\n      StringBuilder::push(acc, \\\"\\\\n\\\")\\n      StringBuilder::push(acc, line)\\n      i = i + 1\\n    }\\n    StringBuilder::freeze(acc)\\n  }\\n}\\nlet parse_int_or: (String, Int) -> Int = (s, default) -> {\\n  let len = String::length(s)\\n  if len == 0 {\\n    default\\n  } else {\\n    let mut i = 0\\n    let mut acc = 0\\n    let mut ok = true\\n    while ok && i < len {\\n      let c = String::char_code_at(s, i)\\n      if c >= '0' && c <= '9' {\\n        acc = acc * 10 + (c - '0')\\n        i = i + 1\\n      } else {\\n        ok = false\\n      }\\n    }\\n    if ok {\\n      acc\\n    } else {\\n      default\\n    }\\n  }\\n}\\nlet adapter_string_to_bytes: (String) -> Bytes = (s) -> {\\n  let out = Array::slice([\\n    0\\n  ], 0, 0)\\n  let len = String::length(s)\\n  let mut i = 0\\n  while i < len {\\n    Array::push(out, String::char_code_at(s, i))\\n    i = i + 1\\n  }\\n  Bytes::from_array(out)\\n}\\nlet read_arg_or_env: (Int, String) -> String with { Env } = (index, env_name) -> {\\n  let value = Env::args_get(index)\\n  if value != \\\"\\\" {\\n    value\\n  } else {\\n    Env::get(env_name)\\n  }\\n}\\nlet own_host_string: (String) -> String = (value) -> {\\n  String::concat(\\\"\\\", value)\\n}\\nlet profile_memory_mark: (Bool) -> Unit with { Env } = (enabled) -> {\\n  if enabled {\\n    let _ = Env::get(\\\"VIBE_PROFILE_MEMORY_MARK\\\")\\n    ()\\n  } else {\\n    ()\\n  }\\n}\\nlet apply_cfg_env: (String, String) -> String = (source, cfg_csv) -> {\\n  if cfg_csv == \\\"\\\" {\\n    source\\n  } else {\\n    let parts = String::split(cfg_csv, \\\",\\\")\\n    let mut out = source\\n    let mut i = 0\\n    while i < Array::length(parts) {\\n      let flag = String::trim(Array::get(parts, i))\\n      if String::length(flag) > 0 {\\n        out = String::concat(out, String::concat(\\\"\\\\n#cfg_enable(\\\", String::concat(flag, \\\")\\\")))\\n      } else {\\n        ()\\n      }\\n      i = i + 1\\n    }\\n    out\\n  }\\n}\\nlet compile_source_for_rc_flag: (String, String, String) -> Bytes with { Error } = (source, entry_name, rc_flag) -> {\\n  if rc_flag == \\\"shadow\\\" {\\n    compile_source_wasi_only_rc_shadow(source, entry_name)\\n  } else if rc_flag != \\\"0\\\" {\\n    compile_source_wasi_only_rc(source, entry_name)\\n  } else {\\n    compile_source_wasi_only(source, entry_name)\\n  }\\n}\\nlet emit_compile_diag: (String, String) -> Int with { Fs } = (output_path, msg) -> {\\n  Fs::write_file(String::concat(output_path, \\\".diag\\\"), msg)\\n  1\\n}\\nlet write_funcmap_sidecar: (String, String) -> Int with { Fs, Error } = (input_path, output_path) -> {\\n  let src = Fs::read_file(input_path)\\n  let text = build_funcmap_from_source(src)\\n  Fs::write_bytes(String::concat(output_path, \\\".funcmap\\\"), adapter_string_to_bytes(text))\\n  0\\n}\\nexport let cli_main: () -> Int with { Error, Fs, Env } = () -> {\\n  let input_path = own_host_string(read_arg_or_env(0, \\\"VIBE_INPUT\\\"))\\n  let output_path = own_host_string(read_arg_or_env(1, \\\"VIBE_OUTPUT\\\"))\\n  let entry_name = own_host_string(read_arg_or_env(2, \\\"VIBE_ENTRY\\\"))\\n  let mark_memory = Env::get(\\\"VIBE_PROFILE_MEMORY_MARKS\\\") == \\\"1\\\"\\n  if Env::get(\\\"VIBE_FS_COMPILE\\\") == \\\"1\\\" {\\n    return handle {\\n      let bytes = if Env::get(\\\"VIBE_COVERAGE\\\") == \\\"1\\\" {\\n        compile_file_fs_mode_coverage(input_path, entry_name)\\n      } else if Env::get(\\\"VIBE_DEBUG_BREAK\\\") == \\\"1\\\" {\\n        compile_file_fs_mode_break(input_path, entry_name)\\n      } else if Env::get(\\\"VIBE_DEBUG\\\") == \\\"1\\\" {\\n        compile_file_fs_mode_trace(input_path, entry_name)\\n      } else if Env::get(\\\"VIBE_RC\\\") != \\\"0\\\" {\\n        compile_file_fs_mode_rc(input_path, entry_name)\\n      } else {\\n        let testmeta_out = Env::get(\\\"VIBE_TESTMETA_OUT\\\")\\n        if testmeta_out != \\\"\\\" {\\n          compile_file_fs_mode_testmeta(input_path, entry_name, \\\"no-dce\\\", testmeta_out)\\n        } else {\\n          compile_file_fs_mode(input_path, entry_name, \\\"no-dce\\\")\\n        }\\n      }\\n      Fs::write_bytes(output_path, bytes)\\n      let _funcmap_rc = handle {\\n        write_funcmap_sidecar(input_path, output_path)\\n      } with Error {\\n        Throw(_) => 0\\n      }\\n      0\\n    } with Error {\\n      Throw(msg) => emit_compile_diag(output_path, msg)\\n    }\\n  }\\n  if Env::get(\\\"VIBE_NORMALIZE\\\") == \\\"1\\\" {\\n    let normalized = normalize_source(Fs::read_file(input_path))\\n    Fs::write_bytes(output_path, adapter_string_to_bytes(normalized))\\n    return 0\\n  }\\n  if Env::get(\\\"VIBE_TYPE_AT\\\") == \\\"1\\\" {\\n    let src = Fs::read_file(input_path)\\n    let line = parse_int_or(Env::get(\\\"VIBE_TYPE_LINE\\\"), 1)\\n    let col = parse_int_or(Env::get(\\\"VIBE_TYPE_COL\\\"), 1)\\n    let ty = type_at_source(src, line, col)\\n    Fs::write_bytes(output_path, adapter_string_to_bytes(ty))\\n    return 0\\n  }\\n  if Env::get(\\\"VIBE_BINDING_AT\\\") == \\\"1\\\" {\\n    let src = Fs::read_file(input_path)\\n    let line = parse_int_or(Env::get(\\\"VIBE_TYPE_LINE\\\"), 1)\\n    let col = parse_int_or(Env::get(\\\"VIBE_TYPE_COL\\\"), 1)\\n    let occ = binding_occurrences(src, line, col)\\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_binding_occurrences(occ)))\\n    return 0\\n  }\\n  if Env::get(\\\"VIBE_SYMBOLS\\\") == \\\"1\\\" {\\n    let src = Fs::read_file(input_path)\\n    let syms = symbol_spans(src)\\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_symbol_spans(syms)))\\n    return 0\\n  }\\n  if Env::get(\\\"VIBE_DIAGNOSTICS\\\") == \\\"1\\\" {\\n    let src = Fs::read_file(input_path)\\n    let diags = collect_all_diagnostics(src)\\n    Fs::write_bytes(output_path, adapter_string_to_bytes(join_lines(diags)))\\n    return 0\\n  }\\n  let source = Fs::read_file(input_path)\\n  profile_memory_mark(mark_memory)\\n  if Env::get(\\\"VIBE_EMIT_MODULE_SOURCE\\\") == \\\"1\\\" {\\n    let module_source = build_module_source_from_source(source, entry_name)\\n    Fs::write_bytes(output_path, adapter_string_to_bytes(module_source))\\n    profile_memory_mark(mark_memory)\\n    0\\n  } else {\\n    handle {\\n      let rc_flag = Env::get(\\\"VIBE_RC\\\")\\n      let source_cfg = apply_cfg_env(source, Env::get(\\\"VIBE_CFG\\\"))\\n      let bytes = if Env::get(\\\"VIBE_COVERAGE\\\") == \\\"1\\\" {\\n        compile_source_wasi_only_coverage(source_cfg, entry_name)\\n      } else if Env::get(\\\"VIBE_BACKEND\\\") == \\\"gc\\\" {\\n        compile_source_gc_only(source_cfg, entry_name)\\n      } else {\\n        compile_source_for_rc_flag(source_cfg, entry_name, rc_flag)\\n      }\\n      profile_memory_mark(mark_memory)\\n      Fs::write_bytes(output_path, bytes)\\n      profile_memory_mark(mark_memory)\\n      0\\n    } with Error {\\n      Throw(msg) => emit_compile_diag(output_path, msg)\\n    }\\n  }\\n}\\n\"\n}\n")
}

