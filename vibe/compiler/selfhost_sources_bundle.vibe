       if ni64 == 0 {\n          leb128_encode_u32(func_buf, 0)\n        } else {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      } else {\n        if ni64 == 0 {\n          leb128_encode_u32(func_buf, 1)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n        } else {\n          leb128_encode_u32(func_buf, 2)\n          leb128_encode_u32(func_buf, ni32)\n          bytebuf_push(func_buf, 127)\n          leb128_encode_u32(func_buf, ni64)\n          bytebuf_push(func_buf, 126)\n        }\n      }\n    } else {\n      let body_idx_in_user = ci - num_generated\n      let param_count_for_body = Array::get(ft_params, body_idx_in_user) + 1\n      let num_extra = ni64\n      leb128_encode_u32(func_buf, num_extra)\n      let mut rli = 0\n      while rli < num_extra {\n        let actual_local_idx = param_count_for_body + rli\n        let mut is_ref = false\n        let mut ri = 0\n        while ri < num_ref_locals {\n          if Array::get(ref_indices, ri) == actual_local_idx {\n            is_ref = true\n          }\n          ri = ri + 1\n        }\n        leb128_encode_u32(func_buf, 1)\n        if is_ref {\n          bytebuf_push(func_buf, 100)\n          leb128_encode_u32(func_buf, refcell_type_idx)\n        } else {\n          bytebuf_push(func_buf, 126)\n        }\n        rli = rli + 1\n      }\n    }\n    bytebuf_push_buf(func_buf, body)\n    bytebuf_push(func_buf, 11)\n    leb128_encode_u32(code_content, bytebuf_length(func_buf))\n    bytebuf_push_buf(code_content, func_buf)\n    ci = ci + 1\n  }\n  bytebuf_push_section(out, 10, code_content)\n  if num_strings > 0 {\n    let data_offsets = Array::slice([\n      0\n    ], 0, 0)\n    let data_bufs = fresh_bytes_array()\n    let mut di = 0\n    while di < num_strings {\n      Array::push(data_offsets, Array::get(str_offsets, di))\n      Array::push(data_bufs, string_to_data(Array::get(s