ng_matrix()\n      let empty_thunk_names = fresh_string_array()\n      let compile_ctx = CompileCtx::{\n        func_table: FuncTable::{\n          names: fn_names_list, indices: fn_indices_list, params: fn_param_counts, returns: fn_returns_list\n        },\n        str_table: StrTable::{\n          strs: empty_strs, offsets: empty_offs, lengths: empty_lens\n        },\n        lambda_table: lt_m,\n        num_user_funcs: num_funcs, func_offset: 0,\n        ref_cell_names: empty_ref_cells,\n        ctor_table: CtorTable::{\n          names: empty_ctor_names, tags: empty_ctor_tags, field_counts: empty_ctor_field_counts, type_names: empty_ctor_type_names, struct_names: empty_ctor_struct_names, struct_field_names: empty_ctor_struct_field_names\n        },\n        thunk_names: empty_thunk_names\n      }\n      let final_nl = compile_expr(body_buf, body, local_names, param_count, compile_ctx, -1)\n      Array::push(bodies, body_buf)\n      let extra = if final_nl > param_count {\n        final_nl - param_count\n      } else {\n        0\n      }\n      Array::push(local_counts, extra)\n      bi = bi + 1\n    }\n    let out = bytebuf_new()\n    emit_header(out)\n    emit_type_section_multi(out, type_defs)\n    emit_function_section(out, type_indices)\n    if Array::length(export_names) > 0 {\n      emit_export_section_multi(out, export_names, export_indices)\n    }\n    emit_code_section_with_locals(out, bodies, local_counts)\n    bytebuf_to_bytes(out)\n  }\n}\n")

