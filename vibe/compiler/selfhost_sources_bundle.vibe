"//# Polyfill for builtins not in selfhost codegen\n\nlet __to_string = (n: Int) -> String {\n  if n == 0 {\n    \"0\"\n  } else {\n    let mut val = n\n    let mut neg = false\n    if val < 0 {\n      neg = true\n      val = 0 - val\n    }\n    let digits = array_slice([\"\"], 0, 0)\n    while val > 0 {\n      let d = val - (val / 10) * 10\n      let ch = if d == 0 { \"0\" }\n        else if d == 1 { \"1\" }\n        else if d == 2 { \"2\" }\n        else if d == 3 { \"3\" }\n        else if d == 4 { \"4\" }\n        else if d == 5 { \"5\" }\n        else if d == 6 { \"6\" }\n        else if d == 7 { \"7\" }\n        else if d == 8 { \"8\" }\n        else { \"9\" }\n      array_push(digits, ch)\n      val = val / 10\n    }\n    let mut result = if neg { \"-\" } else { \"\" }\n    let mut i = array_length(digits) - 1\n    while i >= 0 {\n      result = string_concat(result, array_get(digits, i))\n      i = i - 1\n    }\n    result\n  }\n}\n")
