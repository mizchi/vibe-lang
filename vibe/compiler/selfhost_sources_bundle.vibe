"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nexport let version = \"0.0.1\"\n\nexport let compiler_lex = lex\n\nexport let compiler_parse = parse\n\nexport let compiler_parse_ok = parse_ok\n\nexport let compiler_print_pat = print_pat\n\nexport let compiler_parse_expr = parse_expr\n\nexport let compiler_parse_stmt = parse_stmt\n\nexport let compiler_parse_type = parse_type\n\nexport let compiler_print_expr = print_expr\n\nexport let compiler_print_stmt = print_stmt\n\nexport let compiler_parse_program = parse_program\n\nexport let compiler_print_program = print_program\n\nexport let compiler_print_type_expr = print_type_expr\n\nlet build_selfhost_cli_adapter_bytes: () -> Bytes with { Error } = () -> {\n  let module_source = selfhost_cli_adapter_module_source()\n  if module_source == \"\" {\n    throw(\"selfhost_cli_adapter_module_source is empty\")\n  }\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let source_groups = selfhost_cli_adapter_source_groups()\n  let (bytes, _) = compile_with_source_groups_via_module_source_wasi_unchecked_cached(\n    db_new(),\n    module_source,\n    adapter_path,\n    source_groups,\n    \"cli_main\"\n  )\n  bytes\n}\n\nlet build_selfhost_cli_adapter_bytes_rc: () -> Bytes with { Error } = () -> {\n  let module_source = selfhost_cli_adapter_module_source()\n  if module_source == \"\" {\n    throw(\"selfhost_cli_adapter_module_source is empty\")\n  }\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let source_groups = selfhost_cli_adapter_source_groups()\n  let (bytes, _) = compile_with_source_groups_via_module_source_wasi_unchecked_rc(\n    db_new(),\n    module_source,\n    adapter_path,\n    source_groups,\n    \"cli_main\"\n  )\n  bytes\n}\n\nlet string_to_bytes: (String) -> Bytes = (s) -> {\n  let out = Bytes::new()\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Bytes::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  out\n}\n\nlet compile_selfhost_cli_adapter_to: (String) -> Int with { Error, Fs } = (output_path) -> {\n  if output_path == \"\" {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nlet selfhost_cli_trigger_path = \"_build/bench/selfhost_cli_adapter/.compile_cli_trigger\"\nlet selfhost_cli_stage1_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_stage1.wasm\"\nlet selfhost_cli_merged_dump_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_merged_dump.vibe\"\nlet selfhost_cli_module_dump_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_module_dump.vibe\"\n\nexport let selfbuild_entry: () -> Int with { Error, Fs } = () -> {\n  handle {\n    if perform Fs::Exists(selfhost_cli_trigger_path) {\n      compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)\n    } else {\n      0\n    }\n  } with Error {\n    Throw(_) => 0\n  }\n}\n\nexport let selfbuild_write_cli_adapter: () -> Int with { Error, Fs } = () -> {\n  compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)\n}\n\nexport let selfbuild_dump_cli_adapter_merged_source: () -> Int with { Error, Fs } = () -> {\n  Fs::write_bytes(\n    selfhost_cli_merged_dump_path,\n    string_to_bytes(selfhost_cli_adapter_merged_source())\n  )\n  0\n}\n\nexport let selfbuild_dump_cli_adapter_module_source: () -> Int with { Error, Fs } = () -> {\n  Fs::write_bytes(\n    selfhost_cli_module_dump_path,\n    string_to_bytes(selfhost_cli_adapter_module_source())\n  )\n  0\n}\n\nexport let selfbuild_dump_cli_adapter_merged_source_env: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))\n  0\n}\n\nexport let selfbuild_dump_cli_adapter_module_source_env: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_module_source()))\n  0\n}\n\nexport let probe_dump_cli_adapter_merged_source_env: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))\n  0\n}\n\nexport let probe_dump_cli_adapter_module_source_env: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_module_source()))\n  0\n}\n\nexport let probe_write_bytes_smoke: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(\"ok\\n\"))\n  0\n}\n\nexport let selfbuild_cli_env_entry: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = perform Env::Get(\"VIBE_INPUT\")\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  let entry_name = perform Env::Get(\"VIBE_ENTRY\")\n  if input_path == \"\" {\n    1\n  }\n  else if output_path == \"\" {\n    1\n  }\n  else if entry_name == \"\" {\n    1\n  }\n  else {\n    let source = perform Fs::ReadFile(input_path)\n    let bytes = compile_source_wasi_only(source, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_probe_cli_env_read_len: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = perform Env::Get(\"VIBE_INPUT\")\n  let source = perform Fs::ReadFile(input_path)\n  String::length(source)\n}\n\nexport let selfbuild_probe_cli_env_compile_len: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = perform Env::Get(\"VIBE_INPUT\")\n  let entry_name = perform Env::Get(\"VIBE_ENTRY\")\n  let source = perform Fs::ReadFile(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_cli_args_read_len: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = if perform Env::ArgsLen > 0 { perform Env::ArgsGet(0) } else { \"\" }\n  let source = perform Fs::ReadFile(input_path)\n  String::length(source)\n}\n\nexport let selfbuild_probe_cli_args_compile_len: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = if perform Env::ArgsLen > 0 { perform Env::ArgsGet(0) } else { \"\" }\n  let entry_name = if perform Env::ArgsLen > 2 { perform Env::ArgsGet(2) } else { \"\" }\n  let source = perform Fs::ReadFile(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_cli_args_entry: () -> Int with { Error, Fs, Env } = () -> {\n  let input_path = if perform Env::ArgsLen > 0 { perform Env::ArgsGet(0) } else { \"\" }\n  let output_path = if perform Env::ArgsLen > 1 { perform Env::ArgsGet(1) } else { \"\" }\n  let entry_name = if perform Env::ArgsLen > 2 { perform Env::ArgsGet(2) } else { \"\" }\n  if input_path == \"\" {\n    1\n  }\n  else if output_path == \"\" {\n    1\n  }\n  else if entry_name == \"\" {\n    1\n  }\n  else {\n    let source = perform Fs::ReadFile(input_path)\n    let bytes = if perform Env::Get(\"VIBE_RC\") != \"0\" {\n      compile_source_wasi_only_rc(source, entry_name)\n    } else {\n      compile_source_wasi_only(source, entry_name)\n    }\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_cli_entry: () -> Int with { Error, Fs } = () -> {\n  let input_path = \"_build/bench/selfhost_cli_adapter/adapter_input.vibe\"\n  let output_path = \"_build/bench/selfhost_cli_adapter/adapter_output.wasm\"\n  if input_path == \"\" {\n    1\n  }\n  else if output_path == \"\" {\n    1\n  }\n  else {\n    let (bytes, _) = compile_file_fs_cached(db_new(), input_path, \"main\")\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_compile_stage2: () -> Bytes with { Error } = () -> {\n  let main_source = selfbuild_runtime_entry_source()\n  if main_source == \"\" { throw(\"selfbuild_runtime_entry_source is empty\") }\n  compile_source_wasi_only(main_source, \"selfbuild_entry\")\n}\n\nexport let selfbuild_compile_cli_adapter: () -> Bytes with { Error } = () -> {\n  build_selfhost_cli_adapter_bytes()\n}\n\nexport let selfbuild_compile_cli_adapter_rc_env: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  if output_path == \"\" {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes_rc()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_compile_cli_adapter_env: () -> Int with { Error, Fs, Env } = () -> {\n  let output_path = perform Env::Get(\"VIBE_OUTPUT\")\n  if output_path == \"\" {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_probe_compile_cli_adapter_embedded_module_len: () -> Int with { Error } = () -> {\n  let bytes = build_selfhost_cli_adapter_bytes()\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_env_get_len: () -> Int with { Error } = () -> {\n  let bytes = compile_source_wasi(\n    \"let main: () -> Int = () -> { let _x = perform Env::Get(\\\"VIBE_INPUT\\\"); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_fs_read_file_len: () -> Int with { Error } = () -> {\n  let bytes = compile_source_wasi(\n    \"let main: () -> Int = () -> { let _x = perform Fs::ReadFile(\\\"/tmp/in.txt\\\"); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_compile_fs_write_bytes_len: () -> Int with { Error } = () -> {\n  let bytes = compile_source_wasi(\n    \"let main: () -> Int = () -> { Fs::write_bytes(\\\"/tmp/out.wasm\\\", Bytes::from_array([1])); 0 }\",\n    \"main\"\n  )\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_stage1_probe_cli_cache_counts: () -> Int with { Error, Fs } = () -> {\n  selfbuild_probe_cli_cache_counts()\n}\n\nexport let selfbuild_stage1_probe_cli_file_cache_counts: () -> Int with { Error, Fs } = () -> {\n  selfbuild_probe_cli_file_cache_counts()\n}\n\nexport let selfbuild_stage1_probe_type_db_cache_counts: () -> Int with { Error } = () -> {\n  selfbuild_probe_type_db_cache_counts()\n}\n\nexport let selfbuild_stage1_probe_type_db_fs_parse_counts: () -> Int with { Error, Fs } = () -> {\n  let helper_path = \"_build/persistent_type_env_probe_helper.vibe\"\n  let main_path = \"_build/persistent_type_env_probe_main.vibe\"\n  let helper_source = \"export let add: () -> Int = () -> { 1 }\"\n  let main_source = \"import ./persistent_type_env_probe_helper.vibe { add }\\nlet run: () -> Int = () -> { add() }\"\n  Fs::write_bytes(helper_path, string_to_bytes(helper_source))\n  Fs::write_bytes(main_path, string_to_bytes(main_source))\n  let db1 = db_typecheck_fs(\n    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),\n    main_path\n  )\n  let count1 = db_parse_count(db1)\n  let db2 = db_typecheck_fs(\n    db_set_source(db_set_source(db_new(), helper_path, helper_source), main_path, main_source),\n    main_path\n  )\n  let count2 = db_parse_count(db2)\n  count1 * 1000 + count2\n}\n\nexport let selfbuild_stage1_probe_type_db_group_merge_counts: () -> Int with { Error } = () -> {\n  selfbuild_probe_type_db_group_merge_counts()\n}\n\nexport let selfbuild_stage1_probe_type_db_module_source_counts: () -> Int with { Error } = () -> {\n  selfbuild_probe_type_db_module_source_counts()\n}\n\nexport let selfbuild_stage1_probe_type_db_codegen_counts: () -> Int with { Error } = () -> {\n  selfbuild_probe_type_db_codegen_counts()\n}\n\nexport let selfbuild_probe_lex: () -> Int with { Error } = () -> {\n  let tokens = lex(\"let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n  Array::length(tokens)\n}\n\nexport let selfbuild_probe_parse: () -> Int with { Error } = () -> {\n  let tokens = lex(\"let add: (Int, Int) -> Int = (a, b) -> { a + b }\")\n  let stmts = parse_program(tokens)\n  Array::length(stmts)\n}\n\nexport {\n  Pat, lex, Expr, Stmt, Token, Type, TypeEnv, Subst, TypeDef, TypeDb,\n  parse, version, TypeExpr, parse_ok, print_pat, parse_expr, parse_stmt, parse_type,\n  print_expr, print_stmt, compiler_lex, parse_program, print_program, compiler_parse,\n  print_type_expr, token_to_string, compiler_parse_ok, compiler_print_pat,\n  compiler_parse_expr, compiler_parse_stmt, compiler_parse_type, compiler_print_expr,\n  compiler_print_stmt, compiler_parse_program, compiler_print_program,\n  compiler_print_type_expr,\n  check_program, check_program_with_env, check_stmts,\n  db_new, db_set_source, db_check_env, db_typecheck, db_typecheck_count,\n  db_parse_count, db_merge_count, db_module_source_count, db_codegen_count,\n  db_program_source, db_merged_source, db_grouped_merged_source, db_module_source,\n  db_load_artifact, db_store_artifact,\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources,\n  compile_source, compile_source_wasi,\n  compile_with_modules, compile_with_modules_wasi, prepare_modules_cached,\n  compile_with_modules_cached, compile_with_modules_wasi_cached,\n  compile_file_fs, compile_file_fs_module, prepare_file_fs_cached,\n  compile_file_fs_cached, compile_file_fs_module_cached,\n  parse_batch_jobs_tsv, prepare_jobs_cached, compile_jobs_cached,\n  selfbuild_probe_cli_cache_counts, selfbuild_probe_cli_file_cache_counts,\n  selfbuild_probe_type_db_cache_counts, selfbuild_probe_type_db_fs_parse_counts,\n  selfbuild_probe_type_db_group_merge_counts,\n  selfbuild_probe_type_db_module_source_counts, selfbuild_probe_type_db_codegen_counts,\n  selfbuild_compile_stage2, selfbuild_compile_cli_adapter, selfbuild_entry,\n  selfbuild_write_cli_adapter, selfbuild_cli_env_entry,\n  selfbuild_cli_args_entry\n}\n")
}

