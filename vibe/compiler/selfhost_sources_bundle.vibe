"//# Imports\n\nexport ./codegen {\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources\n}\n\n//# Misc\n\nexport {\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources\n}\n")

  let source_52 = ("vibe/compiler/runtime/eval_loader/index.vibe",
"//# Imports\n\nimport ../../syntax/lexer.vibe {\n  lex\n}\n\nimport ../../syntax/parser.vibe {\n  parse,\n  parse_program\n}\n\nimport ../../core/index.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\n//# Functions\n\nlet rec resolve_interp_expr = (expr: Expr) -> Expr with { Error } {\n  match expr {\n    EStringInterp(parts) => {\n      let plen = Array::length(parts)\n      let exprs = ArrayBuilder::new()\n      let mut i = 0\n      while i < plen {\n        let lit = Array::get(parts, i)\n        if String::length(lit) > 0 {\n          ArrayBuilder::push(exprs, EString(lit))\n        }\n        if i + 1 < plen {\n          let expr_src = Array::get(parts, i + 1)\n          let resolved = resolve_interp_expr(parse(lex(expr_src)))\n          ArrayBuilder::push(exprs, ECall(EIdent(\"__to_string\"), [\n            resolved\n          ]))\n        }\n        i = i + 2\n      }\n      let out = ArrayBuilder::freeze(exprs)\n      let len = Array::length(out)\n      if len == 0 {\n        EString(\"\")\n      }\n      else {\n        let mut acc = Array::get(out, 0)\n        let mut j = 1\n        while j < len {\n          acc = ECall(EIdent(\"String::concat\"), [\n            acc,\n            Array::get(out, j)\n          ])\n          j = j + 1\n        }\n        acc\n      }\n    },\n    EInt(_) => expr,\n    EFloat(_) => expr,\n    EString(_) => expr,\n    EBool(_) => expr,\n    EUnit => expr,\n    EIdent(_) => expr,\n    ETuple(elems) => ETuple(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    EArray(elems) => EArray(for elem in elems {\n      resolve_interp_expr(elem)\n    }),\n    ERecord(fields) => ERecord(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EMap(fields) => EMap(for field in fields { let (name, value) = field; (name, resolve_interp_expr(value)) }),\n    EIf(cond, then_expr, else_expr) => EIf(resolve_interp_expr(cond), resolve_interp_expr(then_expr), resolve_interp_expr(else_expr)),\n    ELet(name, value, body) => ELet(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetRec(name, value, body) => ELetRec(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ELetMut(name, value, body) => ELetMut(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssign(name, value, body) => EAssign(name, resolve_interp_expr(value), resolve_interp_expr(body)),\n    EAssignOp(name, op, value, body) => EAssignOp(name, op, resolve_interp_expr(value), resolve_interp_expr(body)),\n    ESeq(left, right) => ESeq(resolve_interp_expr(left), resolve_interp_expr(right)),\n    EMatch(scrutinee, arms) => EMatch(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EHandle(scrutinee, arms) => EHandle(resolve_interp_expr(scrutinee), for arm in arms { let (pat, body) = arm; (pat, resolve_interp_expr(body)) }),\n    EWhile(cond, body) => EWhile(resolve_interp_expr(cond), resolve_interp_expr(body)),\n    ELoop(params, body) => ELoop(for param in params { let (name, init) = param; (name, resolve_interp_expr(init)) }, resolve_interp_expr(body)),\n    EForIn(name, index_name, iter, body) => EForIn(name, index_name, resolve_interp_expr(iter), resolve_interp_expr(body)),\n    ECall(callee, args) => ECall(resolve_interp_expr(callee), for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    EBinOp(op, left, right) => EBinOp(op, resolve_interp_expr(left), resolve_interp_expr(right)),\n    EUnaryOp(op, inner) => EUnaryOp(op, resolve_interp_expr(inner)),\n    EFn(type_params, bounds, params, ret_ty, effect, body) => EFn(type_params, bounds, params, ret_ty, effect, resolve_interp_expr(body)),\n    EDot(inner, field) => EDot(resolve_interp_expr(inner), field),\n    EThrow(inner) => EThrow(resolve_interp_expr(inner)),\n    EBreak(opt) => match opt {\n      None => expr,\n      Some(value) => EBreak(Some(resolve_interp_expr(value)))\n    },\n    EContinue(args) => EContinue(for arg in args {\n      resolve_interp_expr(arg)\n    }),\n    ELabeledArg(label, name, value) => ELabeledArg(label, name, resolve_interp_expr(value)),\n    ESpread(inner) => ESpread(resolve_interp_expr(inner))\n  }\n}\n\nlet resolve_interp_stmt = (stmt: Stmt) -> Stmt with { Error } {\n  match stmt {\n    SLet(exported, is_rec, name, ty, value) => SLet(exported, is_rec, name, ty, resolve_interp_expr(value)),\n    SLetMut(name, ty, value) => SLetMut(name, ty, resolve_interp_expr(value)),\n    STest(name, body) => STest(name, resolve_interp_expr(body)),\n    SBench(name, body) => SBench(name, resolve_interp_expr(body)),\n    SExpr(expr) => SExpr(resolve_interp_expr(expr)),\n    _ => stmt\n  }\n}\n\nexport let contains_str = (arr: Array[String], target: String) -> Bool {\n  let rec go = (i: Int) -> Bool {\n    if i >= Array::length(arr) {\n      false\n    }\n    else {\n      if String::equals(Array::get(arr, i), target) {\n        true\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let rec go = (i: Int) -> Option[String] {\n    if i >= Array::length(sources) {\n      None\n    }\n    else {\n      let (p, src) = Array::get(sources, i)\n      if String::equals(p, path_key) {\n        Some(src)\n      }\n      else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let load_and_parse = (source: String) -> Array[Stmt] with { Error } {\n  let tokens = lex(source)\n  for stmt in parse_program(tokens) {\n    resolve_interp_stmt(stmt)\n  }\n}\n\nexport let collect_exports = (stmts: Array[Stmt]) -> Array[String] {\n  let rec go = (i: Int, acc: Array[String]) -> Array[String] {\n    if i >= Array::length(stmts) {\n      acc\n    }\n    else {\n      let stmt = Array::get(stmts, i)\n      let new_acc = match stmt {\n        SLet(true, _, name, _, _) => Array::concat(acc, [\n          name\n        ]),\n        SEnum(true, _, variants) => {\n          let rec add_ctors = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= Array::length(variants) {\n              a\n            }\n            else {\n              let (cname, _) = Array::get(variants, j)\n              add_ctors(j + 1, Array::concat(a, [\n                cname\n              ]))\n            }\n          }\n          add_ctors(0, acc)\n        },\n        SExport(names) => {\n          let rec add_names = (j: Int, a: Array[String]) -> Array[String] {\n            if j >= Array::length(names) {\n              a\n            }\n            else {\n              add_names(j + 1, Array::concat(a, [\n                Array::get(names, j)\n              ]))\n            }\n          }\n          add_names(0, acc)\n        },\n        _ => acc\n      }\n      go(i + 1, new_acc)\n    }\n  }\n  go(0, Array::slice([\n    \"\"\n  ], 0, 0))\n}\n\nexport let exports_contains = (exports: Array[String], name: String) -> Bool {\n  contains_str(exports, name)\n}\n")

  let source_53 = ("vibe/compiler/eval_loader.vibe",
"//# Imports\n\nexport ./runtime / eval_loader {\n  collect_exports, contains_str, exports_contains, load_and_parse, source_lookup\n}\n\n//# Misc\n\nexport {\n  contains_str, source_lookup, load_and_parse, collect_exports, exports_contains\n}\n")

  let source_54 = ("vibe/compiler/ripple/index.vibe",
"export let version = \"0.1.0\"\n\nexport ./ripple.vibe {\n  RippleDb,\n  ripple_new,\n  ripple_set_source,\n  ripple_get_source,\n  ripple_get_fingerprint,\n  ripple_get_deps,\n  ripple_record_eval,\n  ripple_eval_count\n}\n\nexport {\n  RippleDb,\n  ripple_new,\n  ripple_set_source,\n  ripple_get_source,\n  ripple_get_fingerprint,\n  ripple_get_deps,\n  ripple_record_eval,\n  ripple_eval_count\n}\n")

  let source_55 = ("vibe/compiler/ripple/ripple.vibe",
"//# Types\n\nexport enum RippleDb {\n  RippleDb(Array[(String, String)], Array[(String, String)], Array[(String, Array[String])], Int)\n}\n\n//# Functions\n\nlet empty_strings = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_deps_pairs = () -> Array[(String, Array[String])] {\n  Array::slice([\n    (\"\", empty_strings())\n  ], 0, 0)\n}\n\nlet rec lookup_deps_entry = (entries: Array[(String, Array[String])], key: String, i: Int) -> Option[Array[String]] {\n  if i >= Array::length(entries) {\n    None\n  }\n  else {\n    let (k, deps) = Array::get(entries, i)\n    if String::equals(k, key) {\n      Some(deps)\n    }\n    else {\n      lookup_deps_entry(entries, key, i + 1)\n    }\n  }\n}\n\nexport let ripple_get_deps = (db: RippleDb, path: String) -> Option[Array[String]] {\n  match db {\n    RippleDb(_, _, deps_map, _) => lookup_deps_entry(deps_map, path, 0)\n  }\n}\n\nexport let ripple_eval_count = (db: RippleDb) -> Int {\n  match db {\n    RippleDb(_, _, _, count) => count\n  }\n}\n\nlet upsert_deps_entry = (entries: Array[(String, Array[String])], key: String, deps: Array[String]) -> Array[(String, Array[String])] {\n  let len = Array::length(entries)\n  let b = ArrayBuilder::new()\n  let rec go = (i: Int, found: Bool) -> Array[(String, Array[String])] {\n    if i >= len {\n      if found {\n        ArrayBuilder::freeze(b)\n      } else {\n        ArrayBuilder::push(b, (key, deps))\n        ArrayBuilder::freeze(b)\n      }\n    } else {\n      let (k, existing) = Array::get(entries, i)\n      if String::equals(k, key) {\n        ArrayBuilder::push(b, (key, deps))\n        go(i + 1, true)\n      } else {\n        ArrayBuilder::push(b, (k, existing))\n        go(i + 1, found)\n      }\n    }\n  }\n  go(0, false)\n}\n\nlet empty_string_pairs = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nexport let ripple_new = () -> RippleDb {\n  RippleDb(empty_string_pairs(), empty_string_pairs(), empty_deps_pairs(), 0)\n}\n\nlet rec lookup_string_entry = (entries: Array[(String, String)], key: String, i: Int) -> Option[String] {\n  if i >= Array::length(entries) {\n    None\n  }\n  else {\n    let (k, v) = Array::get(entries, i)\n    if String::equals(k, key) {\n      Some(v)\n    }\n    else {\n      lookup_string_entry(entries, key, i + 1)\n    }\n  }\n}\n\nexport let ripple_get_source = (db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(sources, _, _, _) => lookup_string_entry(sources, path, 0)\n  }\n}\n\nlet upsert_string_entry = (entries: Array[(String, String)], key: String, value: String) -> Array[(String, String)] {\n  let len = Array::length(entries)\n  let b = ArrayBuilder::new()\n  let rec go = (i: Int, found: Bool) -> Array[(String, String)] {\n    if i >= len {\n      if found {\n        ArrayBuilder::freeze(b)\n      } else {\n        ArrayBuilder::push(b, (key, value))\n        ArrayBuilder::freeze(b)\n      }\n    } else {\n      let (k, v) = Array::get(entries, i)\n      if String::equals(k, key) {\n        ArrayBuilder::push(b, (key, value))\n        go(i + 1, true)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        go(i + 1, found)\n      }\n    }\n  }\n  go(0, false)\n}\n\nexport let ripple_set_source = (db: RippleDb, path: String, source: String) -> RippleDb {\n  match db {\n    RippleDb(sources, fingerprints, deps_map, eval_count) => RippleDb(upsert_string_entry(sources, path, source), fingerprints, deps_map, eval_count)\n  }\n}\n\nexport let ripple_record_eval = (db: RippleDb, path: String, fingerprint: String, deps: Array[String]) -> RippleDb {\n  match db {\n    RippleDb(sources, fingerprints, deps_map, eval_count) => match lookup_string_entry(fingerprints, path, 0) {\n      Some(prev_fp) => if String::equals(prev_fp, fingerprint) {\n        RippleDb(sources, fingerprints, deps_map, eval_count)\n      } else {\n        RippleDb(sources, upsert_string_entry(fingerprints, path, fingerprint), upsert_deps_entry(deps_map, path, deps), eval_count + 1)\n      }\n      ,\n      None => RippleDb(sources, upsert_string_entry(fingerprints, path, fingerprint), upsert_deps_entry(deps_map, path, deps), eval_count + 1)\n    }\n  }\n}\n\nexport let ripple_get_fingerprint = (db: RippleDb, path: String) -> Option[String] {\n  match db {\n    RippleDb(_, fingerprints, _, _) => lookup_string_entry(fingerprints, path, 0)\n  }\n}\n")

  let source_56 = ("vibe/compiler/runtime/index.vibe",
"//# Imports\n\nimport ../core/index.vibe {\n  Stmt,\n  Type,\n  TypeEnv,\n  env_bind,\n  env_flat_bindings,\n  env_lookup_flat\n}\n\nimport ../checker/index.vibe {\n  check_program_with_env\n}\n\nimport ./eval_loader/index.vibe {\n  contains_str\n}\n\nimport ../syntax/index.vibe {\n  lex,\n  parse_program,\n  print_program\n}\n\nimport ../module_loader.vibe {\n  load_or_parse_module_header_fs\n}\n\nimport ../cache/persistent/index.vibe {\n  normalize_persistent_cache_text,\n  persistent_dep_list_cache_path, persistent_leaf_fingerprint_cache_path,\n  persistent_type_env_cache_path\n}\n\nimport ../ripple/index.vibe {\n  RippleDb,\n  ripple_eval_count,\n  ripple_get_deps,\n  ripple_get_fingerprint,\n  ripple_get_source,\n  ripple_new,\n  ripple_record_eval,\n  ripple_set_source\n}\n\n//# Types\n\nenum StringTriple {\n  StringTriple(String, String, String)\n}\n\nenum TypeDbState {\n  TypeDbState(\n    RippleDb,\n    Array[(String, TypeEnv)],\n    Array[(String, String)],\n    Array[StringTriple],\n    Array[StringTriple],\n    Array[StringTriple],\n    Int,\n    Int,\n    Int,\n    Int\n  )\n}\n\nexport enum TypeDb {\n  TypeDb(TypeDbState)\n}\n\n//# Functions\n\nlet unwrap_db = (db: TypeDb) -> TypeDbState {\n  match db {\n    TypeDb(state) => state\n  }\n}\n\nlet wrap_db = (state: TypeDbState) -> TypeDb {\n  TypeDb(state)\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nlet dir_of = (file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else {\n    String::substring(file_path, 0, idx)\n  }\n}\n\nlet resolve_path = (base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  if len >= 3 {\n    if String::equals(String::substring(raw_path, 0, 3), \"../\") {\n      let rest = String::substring(raw_path, 3, len)\n      let parent = dir_of(base_dir)\n      let resolved = if String::ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        String::concat(rest, \".vibe\")\n      }\n      if String::equals(parent, \"\") {\n        resolved\n      } else {\n        String::concat(parent, String::concat(\"/\", resolved))\n      }\n    } else if String::equals(String::substring(raw_path, 0, 2), \"./\") {\n      let rest = String::substring(raw_path, 2, len)\n      let resolved = if String::ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        String::concat(rest, \".vibe\")\n      }\n      if String::equals(base_dir, \"\") {\n        resolved\n      } else {\n        String::concat(base_dir, String::concat(\"/\", resolved))\n      }\n    } else {\n      raw_path\n    }\n  } else if len >= 2 {\n    if String::equals(String::substring(raw_path, 0, 2), \"./\") {\n      let rest = String::substring(raw_path, 2, len)\n      let resolved = if String::ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        String::concat(rest, \".vibe\")\n      }\n      if String::equals(base_dir, \"\") {\n        resolved\n      } else {\n        String::concat(base_dir, String::concat(\"/\", resolved))\n      }\n    } else {\n      raw_path\n    }\n  } else {\n    raw_path\n  }\n}\n\nlet parse_program_with_path = (path: String, source: String) -> Array[Stmt] with { Error } {\n  handle {\n    parse_program(lex(source))\n  } {\n    Error(msg) => throw(String::concat(String::concat(path, \": \"), msg))\n  }\n}\n\nlet add_dep = (acc: Array[String], raw_path: String, base_dir: String) -> Array[String] {\n  if String::length(raw_path) == 0 {\n    acc\n  } else {\n    let resolved = resolve_path(base_dir, raw_path)\n    if contains_str(acc, resolved) {\n      acc\n    } else {\n      Array::concat(acc, [\n        resolved\n      ])\n    }\n  }\n}\n\nlet empty_stack = () -> Array[String] {\n  Array::slice([\n    \"\"\n  ], 0, 0)\n}\n\nlet empty_dep_fps = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_env_cache = () -> Array[(String, TypeEnv)] {\n  Array::slice([\n    (\"\", EnvEmpty)\n  ], 0, 0)\n}\n\nlet empty_string_pairs = () -> Array[(String, String)] {\n  Array::slice([\n    (\"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_string_triples = () -> Array[StringTriple] {\n  Array::slice([\n    StringTriple(\"\", \"\", \"\")\n  ], 0, 0)\n}\n\nlet empty_stmt_array = () -> Array[Stmt] {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nlet empty_type_bindings = () -> Array[(String, Type)] {\n  Array::slice([\n    (\"\", CtUnknown)\n  ], 0, 0)\n}\n\nexport let db_new = () -> TypeDb {\n  wrap_db(\n    TypeDbState(\n      ripple_new(),\n      empty_env_cache(),\n      empty_string_pairs(),\n      empty_string_triples(),\n      empty_string_triples(),\n      empty_string_triples(),\n      0,\n      0,\n      0,\n      0\n    )\n  )\n}\n\nlet lookup_string_pair = (pairs: Array[(String, String)], key: String) -> Option[String] {\n  let len = Array::length(pairs)\n  let rec go = (i: Int) -> Option[String] {\n    if i >= len {\n      None\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if String::equals(k, key) {\n        Some(v)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_string_pair = (\n  pairs: Array[(String, String)],\n  key: String,\n  value: String\n) -> Array[(String, String)] {\n  let len = Array::length(pairs)\n  let b = ArrayBuilder::new()\n  let rec build = (i: Int) -> Array[(String, String)] {\n    if i >= len {\n      ArrayBuilder::push(b, (key, value))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (k, v) = Array::get(pairs, i)\n      if String::equals(k, key) {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (k, v))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet lookup_source_cache = (\n  cache: Array[StringTriple],\n  path: String,\n  fingerprint: String\n) -> Option[String] {\n  let len = Array::length(cache)\n  let rec go = (i: Int) -> Option[String] {\n    if i >= len {\n      None\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, source) =>\n          if String::equals(p, path) && String::equals(fp, fingerprint) {\n            Some(source)\n          } else {\n            go(i + 1)\n          }\n      }\n    }\n  }\n  go(0)\n}\n\nlet upsert_source_cache = (\n  cache: Array[StringTriple],\n  path: String,\n  fingerprint: String,\n  source: String\n) -> Array[StringTriple] {\n  let len = Array::length(cache)\n  let rec build = (i: Int, acc: Array[StringTriple]) -> Array[StringTriple] {\n    if i >= len {\n      acc\n    } else {\n      match Array::get(cache, i) {\n        StringTriple(p, fp, existing) =>\n          if String::equals(p, path) && String::equals(fp, fingerprint) {\n            build(i + 1, acc)\n          } else {\n            build(i + 1, Array::concat(acc, [\n              StringTriple(p, fp, existing)\n            ]))\n          }\n      }\n    }\n  }\n  Array::concat(build(0, empty_string_triples()), [\n    StringTriple(path, fingerprint, source)\n  ])\n}\n\nexport let db_set_source = (db: TypeDb, path: String, source: String) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          ripple_set_source(rdb, path, source),\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n  }\n}\n\nlet lookup_env_cache = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let rec go = (i: Int) -> Option[TypeEnv] {\n    if i >= len {\n      None\n    } else {\n      let (p, env) = Array::get(cache, i)\n      if String::equals(p, path) {\n        Some(env)\n      } else {\n        go(i + 1)\n      }\n    }\n  }\n  go(0)\n}\n\nexport let db_check_env = (db: TypeDb, path: String) -> Option[TypeEnv] {\n  match unwrap_db(db) {\n    TypeDbState(_, cache, _, _, _, _, _, _, _, _) => lookup_env_cache(cache, path)\n  }\n}\n\nlet build_import_env = (stmts: Array[Stmt], base_dir: String, cache: Array[(String, TypeEnv)]) -> TypeEnv {\n  let len = Array::length(stmts)\n  let rec go = (i: Int, acc: TypeEnv) -> TypeEnv {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, names) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          let dep_env = match lookup_env_cache(cache, resolved) {\n            Some(e) => e,\n            None => EnvEmpty\n          }\n          let dep_bindings = env_flat_bindings(dep_env)\n          let nlen = Array::length(names)\n          let rec bind_names = (j: Int, nacc: TypeEnv) -> TypeEnv {\n            if j >= nlen {\n              nacc\n            } else {\n              let (name, alias) = Array::get(names, j)\n              let bound_name = match alias {\n                Some(a) => a,\n                None => name\n              }\n              let ty = match env_lookup_flat(dep_bindings, name) {\n                Some(t) => t,\n                None => CtUnknown\n              }\n              bind_names(j + 1, env_bind(nacc, bound_name, ty))\n            }\n          }\n          bind_names(0, acc)\n        },\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, EnvEmpty)\n}\n\nlet upsert_env_cache = (\n  cache: Array[(String, TypeEnv)],\n  path: String,\n  env: TypeEnv\n) -> Array[(String, TypeEnv)] {\n  let len = Array::length(cache)\n  let b = ArrayBuilder::new()\n  let rec build = (i: Int) -> Array[(String, TypeEnv)] {\n    if i >= len {\n      ArrayBuilder::push(b, (path, env))\n      ArrayBuilder::freeze(b)\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if String::equals(p, path) {\n        build(i + 1)\n      } else {\n        ArrayBuilder::push(b, (p, e))\n        build(i + 1)\n      }\n    }\n  }\n  build(0)\n}\n\nlet compact_string_fingerprint = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet serialize_segment = (text: String) -> String {\n  String::concat(__to_string(String::length(text)), String::concat(\":\", text))\n}\n\nlet parse_count_header = (text: String, pos: Int, terminator: Int) -> (Int, Int) with { Error } {\n  let len = String::length(text)\n  let mut i = pos\n  while i < len && String::char_code_at(text, i) != terminator {\n    i = i + 1\n  }\n  if i >= len {\n    throw(\"invalid persistent type env payload\")\n  } else {\n    (Int::parse(String::substring(text, pos, i)), i + 1)\n  }\n}\n\nlet parse_segment = (text: String, pos: Int) -> (String, Int) with { Error } {\n  let (seg_len, start) = parse_count_header(text, pos, 58)\n  let end = start + seg_len\n  if end > String::length(text) {\n    throw(\"invalid persistent type env segment\")\n  } else {\n    (String::substring(text, start, end), end)\n  }\n}\n\nlet serialize_string_array = (items: Array[String]) -> String {\n  let mut out = String::concat(__to_string(Array::length(items)), \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    out = String::concat(out, serialize_segment(Array::get(items, i)))\n    i = i + 1\n  }\n  String::concat(out, \"]\")\n}\n\nlet parse_string_array = (text: String, pos: Int) -> (Array[String], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([\"\"], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (item, next_cursor) = parse_segment(text, cursor)\n    Array::push(items, item)\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env string array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet serialize_int_array = (items: Array[Int]) -> String {\n  let mut out = String::concat(__to_string(Array::length(items)), \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    out = String::concat(out, serialize_segment(__to_string(Array::get(items, i))))\n    i = i + 1\n  }\n  String::concat(out, \"]\")\n}\n\nlet parse_int_array = (text: String, pos: Int) -> (Array[Int], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([0], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw, next_cursor) = parse_segment(text, cursor)\n    Array::push(items, Int::parse(raw))\n    cursor = next_cursor\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env int array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet serialize_bounds_array = (items: Array[(Int, Array[String])]) -> String {\n  let mut out = String::concat(__to_string(Array::length(items)), \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    let (id, bounds) = Array::get(items, i)\n    out = String::concat(out, serialize_segment(__to_string(id)))\n    out = String::concat(out, serialize_string_array(bounds))\n    i = i + 1\n  }\n  String::concat(out, \"]\")\n}\n\nlet parse_bounds_array = (text: String, pos: Int) -> (Array[(Int, Array[String])], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([(0, Array::slice([\"\"], 0, 0))], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw_id, next_cursor) = parse_segment(text, cursor)\n    let (bounds, next_cursor2) = parse_string_array(text, next_cursor)\n    Array::push(items, (Int::parse(raw_id), bounds))\n    cursor = next_cursor2\n    i = i + 1\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env bounds array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet rec serialize_type = (ty: Type) -> String {\n  match ty {\n    CtInt => \"I\",\n    CtDouble => \"D\",\n    CtBool => \"B\",\n    CtString => \"G\",\n    CtChar => \"H\",\n    CtUnit => \"U\",\n    CtBytes => \"Y\",\n    CtUnknown => \"X\",\n    CtVar(id) => String::concat(\"V\", serialize_segment(__to_string(id))),\n    CtEnum(name) => String::concat(\"E\", serialize_segment(name)),\n    CtStruct(name) => String::concat(\"R\", serialize_segment(name)),\n    CtArray(elem) => String::concat(\"A\", serialize_type(elem)),\n    CtOption(elem) => String::concat(\"O\", serialize_type(elem)),\n    CtTuple(elems) => String::concat(\"T\", serialize_type_array(elems)),\n    CtFn(params, ret, has_error) =>\n      String::concat(\n        \"F\",\n        String::concat(\n          serialize_segment(if has_error { \"1\" } else { \"0\" }),\n          String::concat(serialize_type_array(params), serialize_type(ret))\n        )\n      ),\n    CtNamed(name, args) =>\n      String::concat(\"N\", String::concat(serialize_segment(name), serialize_type_array(args))),\n    CtForAll(vars, bounds, body) =>\n      String::concat(\n        \"Q\",\n        String::concat(\n          serialize_int_array(vars),\n          String::concat(serialize_bounds_array(bounds), serialize_type(body))\n        )\n      )\n  }\n}\n\nlet serialize_type_array = (items: Array[Type]) -> String {\n  let mut out = String::concat(__to_string(Array::length(items)), \"[\")\n  let mut i = 0\n  while i < Array::length(items) {\n    out = String::concat(out, serialize_segment(serialize_type(Array::get(items, i))))\n    i = i + 1\n  }\n  String::concat(out, \"]\")\n}\n\nlet parse_type_array = (text: String, pos: Int) -> (Array[Type], Int) with { Error } {\n  let (count, start) = parse_count_header(text, pos, 91)\n  let items = Array::slice([CtUnknown], 0, 0)\n  let mut i = 0\n  let mut cursor = start\n  while i < count {\n    let (raw, next_cursor) = parse_segment(text, cursor)\n    let (item, end_cursor) = parse_cached_type(raw, 0)\n    if end_cursor != String::length(raw) {\n      throw(\"invalid persistent type env nested type\")\n    } else {\n      Array::push(items, item)\n      cursor = next_cursor\n      i = i + 1\n    }\n  }\n  if cursor >= String::length(text) || String::char_code_at(text, cursor) != 93 {\n    throw(\"invalid persistent type env type array\")\n  } else {\n    (items, cursor + 1)\n  }\n}\n\nlet persistent_type_env_cache_text = (env: TypeEnv) -> String {\n  let bindings = env_flat_bindings(env)\n  let mut out = \"version\\t1\\n\"\n  let mut i = 0\n  while i < Array::length(bindings) {\n    let (name, ty) = Array::get(bindings, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"bind\\t\",\n        String::concat(name, String::concat(\"\\t\", String::concat(serialize_type(ty), \"\\n\")))\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet parse_cached_type = (source: String, pos: Int) -> (Type, Int) with { Error } {\n  if pos >= String::length(source) {\n    throw(\"invalid persistent type env type\")\n  } else {\n    let tag = String::char_code_at(source, pos)\n    match tag {\n      73 => (CtInt, pos + 1),\n      68 => (CtDouble, pos + 1),\n      66 => (CtBool, pos + 1),\n      71 => (CtString, pos + 1),\n      72 => (CtChar, pos + 1),\n      85 => (CtUnit, pos + 1),\n      89 => (CtBytes, pos + 1),\n      88 => (CtUnknown, pos + 1),\n      86 => {\n        let (raw, next_pos) = parse_segment(source, pos + 1)\n        (CtVar(Int::parse(raw)), next_pos)\n      },\n      69 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtEnum(name), next_pos)\n      },\n      82 => {\n        let (name, next_pos) = parse_segment(source, pos + 1)\n        (CtStruct(name), next_pos)\n      },\n      65 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtArray(elem), next_pos)\n      },\n      79 => {\n        let (elem, next_pos) = parse_cached_type(source, pos + 1)\n        (CtOption(elem), next_pos)\n      },\n      84 => {\n        let (elems, next_pos) = parse_type_array(source, pos + 1)\n        (CtTuple(elems), next_pos)\n      },\n      70 => {\n        let (raw_flag, next_pos1) = parse_segment(source, pos + 1)\n        let (params, next_pos2) = parse_type_array(source, next_pos1)\n        let (ret, next_pos3) = parse_cached_type(source, next_pos2)\n        (CtFn(params, ret, String::equals(raw_flag, \"1\")), next_pos3)\n      },\n      78 => {\n        let (name, next_pos1) = parse_segment(source, pos + 1)\n        let (args, next_pos2) = parse_type_array(source, next_pos1)\n        (CtNamed(name, args), next_pos2)\n      },\n      81 => {\n        let (vars, next_pos1) = parse_int_array(source, pos + 1)\n        let (bounds, next_pos2) = parse_bounds_array(source, next_pos1)\n        let (body, next_pos3) = parse_cached_type(source, next_pos2)\n        (CtForAll(vars, bounds, body), next_pos3)\n      },\n      _ => throw(\"invalid persistent type env type tag\")\n    }\n  }\n}\n\nlet load_persistent_type_env = (fingerprint: String) -> Option[TypeEnv] with { Error, Fs } {\n  let path = persistent_type_env_cache_path(fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    let lines = String::split(normalize_persistent_cache_text(Fs::read_file(path)), \"\\n\")\n    let bindings = empty_type_bindings()\n    let mut version_ok = false\n    let mut i = 0\n    while i < Array::length(lines) {\n      let line = Array::get(lines, i)\n      if String::length(line) == 0 {\n        ()\n      } else {\n        let parts = String::split(line, \"\\t\")\n        if !version_ok {\n          if Array::length(parts) == 2 &&\n            String::equals(Array::get(parts, 0), \"version\") &&\n            String::equals(Array::get(parts, 1), \"1\") {\n            version_ok = true\n          } else {\n            throw(String::concat(\"invalid persistent type env header: \", line))\n          }\n        } else if Array::length(parts) == 3 && String::equals(Array::get(parts, 0), \"bind\") {\n          let raw_type = Array::get(parts, 2)\n          let (ty, end_pos) = parse_cached_type(raw_type, 0)\n          if end_pos != String::length(raw_type) {\n            throw(String::concat(\"invalid persistent type env row: \", line))\n          }\n          Array::push(bindings, (Array::get(parts, 1), ty))\n        } else {\n          throw(String::concat(\"invalid persistent type env row: \", line))\n        }\n      }\n      i = i + 1\n    }\n    if version_ok {\n      Some(rebuild_persistent_type_env(bindings))\n    } else {\n      None\n    }\n  }\n}\n\nlet parse_persistent_dep_list_text = (text: String) -> Array[String] with { Error } {\n  let prefix = \"version\\t2\\n\"\n  if String::length(text) < String::length(prefix) ||\n    !(String::equals(String::substring(text, 0, String::length(prefix)), prefix)) {\n    throw(\"invalid persistent dep cache header\")\n  } else {\n    let body = String::substring(text, String::length(prefix), String::length(text))\n    let (deps, end) = parse_string_array(body, 0)\n    if end != String::length(body) {\n      throw(\"invalid persistent dep cache body\")\n    } else {\n      deps\n    }\n  }\n}\n\nlet persistent_dep_list_text = (deps: Array[String]) -> String {\n  if Array::length(deps) == 0 {\n    \"\"\n  } else if Array::length(deps) == 1 {\n    String::concat(\"version\\t3\\n\", Array::get(deps, 0))\n  } else {\n    String::concat(\"version\\t2\\n\", serialize_string_array(deps))\n  }\n}\n\nlet persistent_leaf_fingerprint_text = (fingerprint: String) -> String {\n  String::concat(\"version\\t1\\n\", String::concat(fingerprint, \"\\n\"))\n}\n\nlet load_persistent_leaf_fingerprint = (path: String, source: String) -> Option[String] with { Fs } {\n  let cache_path = persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source))\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    let prefix = \"version\\t1\\n\"\n    if String::length(text) > String::length(prefix) &&\n      String::equals(String::substring(text, 0, String::length(prefix)), prefix) {\n      Some(String::substring(text, String::length(prefix), String::length(text) - 1))\n    } else {\n      None\n    }\n  }\n}\n\nlet load_or_parse_deps_for_source_fs = (\n  dep_source_cache: Array[(String, String)],\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  let next_dep_source_cache = upsert_string_pair(dep_source_cache, path, source)\n  let cache_path = persistent_dep_list_cache_path(path, compact_string_fingerprint(source))\n  if Fs::exists(cache_path) {\n    let text = normalize_persistent_cache_text(Fs::read_file(cache_path))\n    let prefix = \"version\\t2\\n\"\n    let single_prefix = \"version\\t3\\n\"\n    if String::length(text) == 0 {\n      (empty_stack(), next_dep_source_cache, parse_count)\n    } else if String::length(text) >= String::length(single_prefix) &&\n      String::equals(String::substring(text, 0, String::length(single_prefix)), single_prefix) {\n      let dep = String::substring(text, String::length(single_prefix), String::length(text))\n      ([dep], next_dep_source_cache, parse_count)\n    } else if String::length(text) >= String::length(prefix) &&\n      String::equals(String::substring(text, 0, String::length(prefix)), prefix) {\n      (parse_persistent_dep_list_text(text), next_dep_source_cache, parse_count)\n    } else {\n      let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n      Fs::write_file(cache_path, persistent_dep_list_text(deps))\n      (deps, next_dep_source_cache, next_parse_count)\n    }\n  } else {\n    let (deps, _, next_parse_count) = load_or_parse_module_header_fs(path, source, parse_count)\n    Fs::write_file(cache_path, persistent_dep_list_text(deps))\n    (deps, next_dep_source_cache, next_parse_count)\n  }\n}\n\nlet rebuild_persistent_type_env = (bindings: Array[(String, Type)]) -> TypeEnv {\n  let mut env = EnvEmpty\n  let mut i = Array::length(bindings) - 1\n  while i >= 0 {\n    let (name, ty) = Array::get(bindings, i)\n    env = env_bind(env, name, ty)\n    i = i - 1\n  }\n  env\n}\n\nlet store_persistent_type_env = (fingerprint: String, env: TypeEnv) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_type_env_cache_path(fingerprint),\n    persistent_type_env_cache_text(env)\n  )\n}\n\nlet build_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let (dep_path, dep_fp) = Array::get(dep_fps, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let db_typecheck_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) => ripple_eval_count(rdb)\n  }\n}\n\nexport let db_parse_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, parse_count, _, _, _) => parse_count\n  }\n}\n\nexport let db_merge_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, merge_count, _, _) => merge_count\n  }\n}\n\nexport let db_module_source_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, module_source_count, _) => module_source_count\n  }\n}\n\nexport let db_codegen_count = (db: TypeDb) -> Int {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, _, _, _, _, codegen_count) => codegen_count\n  }\n}\n\nlet collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let len = Array::length(stmts)\n  let rec go = (i: Int, acc: Array[String]) -> Array[String] {\n    if i >= len {\n      acc\n    } else {\n      let next = match Array::get(stmts, i) {\n        SImport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        SReExport(raw_path, _) => add_dep(acc, raw_path, base_dir),\n        _ => acc\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, empty_stack())\n}\n\nlet resolve_deps_for_source = (\n  rdb: RippleDb,\n  dep_source_cache: Array[(String, String)],\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[(String, String)], Int) with { Error } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if String::equals(cached_source, source) {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n            (\n              deps,\n              upsert_string_pair(dep_source_cache, path, source),\n              parse_count + 1\n            )\n          }\n        }\n      } else {\n        let stmts = parse_program_with_path(path, source)\n        let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n        (\n          deps,\n          upsert_string_pair(dep_source_cache, path, source),\n          parse_count + 1\n        )\n      },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let deps = collect_import_deps_from_stmts(stmts, dir_of(path))\n      (\n        deps,\n        upsert_string_pair(dep_source_cache, path, source),\n        parse_count + 1\n      )\n    }\n  }\n}\n\nlet resolve_deps_for_source_fs = (\n  rdb: RippleDb,\n  dep_source_cache: Array[(String, String)],\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[(String, String)], Int) with { Error, Fs } {\n  match lookup_string_pair(dep_source_cache, path) {\n    Some(cached_source) =>\n      if String::equals(cached_source, source) {\n        match ripple_get_deps(rdb, path) {\n          Some(deps) => (deps, dep_source_cache, parse_count),\n          None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n        }\n      } else {\n        load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n      },\n    None => load_or_parse_deps_for_source_fs(dep_source_cache, path, source, parse_count)\n  }\n}\n\nlet rec ensure_fingerprint = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  stack: Array[String]\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source(\n          rdb,\n          dep_source_cache,\n          path,\n          source,\n          parse_count\n        )\n        let dlen = Array::length(deps)\n        let next_stack = Array::concat(stack, [\n          path\n        ])\n        let rec resolve_nested = (\n          i: Int,\n          dep_acc: Array[(String, String)],\n          dep_db: RippleDb,\n          dep_env_cache: Array[(String, TypeEnv)],\n          dep_source_cache2: Array[(String, String)],\n          dep_parse_count: Int\n        ) -> (Array[(String, String)], RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error } {\n          if i >= dlen {\n            (dep_acc, dep_db, dep_env_cache, dep_source_cache2, dep_parse_count)\n          } else {\n            let dep_path = Array::get(deps, i)\n            let (\n              dep_fp,\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            ) = ensure_fingerprint(\n              dep_db,\n              dep_env_cache,\n              dep_source_cache2,\n              dep_parse_count,\n              dep_path,\n              next_stack\n            )\n            resolve_nested(\n              i + 1,\n              Array::concat(dep_acc, [\n                (dep_path, dep_fp)\n              ]),\n              next_db,\n              next_env_cache,\n              next_dep_source_cache2,\n              next_parse_count\n            )\n          }\n        }\n        let (\n          dep_fps,\n          db_after_deps,\n          env_cache_after_deps,\n          dep_source_cache_after_deps,\n          parse_count_after_deps\n        ) = resolve_nested(\n          0,\n          empty_dep_fps(),\n          rdb,\n          env_cache,\n          next_dep_source_cache,\n          initial_parse_count\n        )\n        let fingerprint = build_fingerprint(source, dep_fps)\n        match ripple_get_fingerprint(db_after_deps, path) {\n          Some(cached_fp) =>\n            if String::equals(cached_fp, fingerprint) {\n              (\n                fingerprint,\n                db_after_deps,\n                env_cache_after_deps,\n                dep_source_cache_after_deps,\n                parse_count_after_deps\n              )\n            } else {\n              let stmts = parse_program_with_path(path, source)\n              let final_parse_count = parse_count_after_deps + 1\n              let import_env = build_import_env(stmts, dir_of(path), env_cache_after_deps)\n              let checked_env = check_program_with_env(stmts, import_env)\n              let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n              let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n              (\n                fingerprint,\n                next_db,\n                next_env_cache,\n                dep_source_cache_after_deps,\n                final_parse_count\n              )\n            },\n          None => {\n            let stmts = parse_program_with_path(path, source)\n            let final_parse_count = parse_count_after_deps + 1\n            let import_env = build_import_env(stmts, dir_of(path), env_cache_after_deps)\n            let checked_env = check_program_with_env(stmts, import_env)\n            let next_env_cache = upsert_env_cache(env_cache_after_deps, path, checked_env)\n            let next_db = ripple_record_eval(db_after_deps, path, fingerprint, deps)\n            (\n              fingerprint,\n              next_db,\n              next_env_cache,\n              dep_source_cache_after_deps,\n              final_parse_count\n            )\n          }\n        }\n      }\n    }\n  }\n}\n\nexport let db_typecheck = (db: TypeDb, path: String) -> TypeDb with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_stack()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nlet rec ensure_fingerprint_fs = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  stack: Array[String]\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  if contains_str(stack, path) {\n    throw(String::concat(\"type_db: import cycle detected at \", path))\n  } else {\n    match ripple_get_source(rdb, path) {\n      None => (String::concat(\"missing:\", path), rdb, env_cache, dep_source_cache, parse_count),\n      Some(source) => {\n        match load_persistent_leaf_fingerprint(path, source) {\n          Some(leaf_fingerprint) =>\n            match load_persistent_type_env(leaf_fingerprint) {\n              Some(cached_env) => {\n                let next_env_cache = upsert_env_cache(env_cache, path, cached_env)\n                let next_db = ripple_record_eval(rdb, path, leaf_fingerprint, empty_stack())\n                (\n                  leaf_fingerprint,\n                  next_db,\n                  next_env_cache,\n                  dep_source_cache,\n                  parse_count\n                )\n              },\n              None => continue_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)\n            },\n          None => continue_fingerprint_fs(rdb, env_cache, dep_source_cache, parse_count, path, stack, source)\n        }\n      }\n    }\n  }\n}\n\nlet continue_fingerprint_fs = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  stack: Array[String],\n  source: String\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  let (deps, next_dep_source_cache, initial_parse_count) = resolve_deps_for_source_fs(\n    rdb,\n    dep_source_cache,\n    path,\n    source,\n    parse_count\n  )\n  Fs::write_file(\n    persistent_dep_list_cache_path(path, compact_string_fingerprint(source)),\n    persistent_dep_list_text(deps)\n  )\n  let dlen = Array::length(deps)\n  let next_stack = Array::concat(stack, [\n    path\n  ])\n  let dep_fps = empty_dep_fps()\n  let mut db_after_deps = rdb\n  let mut env_cache_after_deps = env_cache\n  let mut dep_source_cache_after_deps = next_dep_source_cache\n  let mut parse_count_after_deps = initial_parse_count\n  let mut i = 0\n  while i < dlen {\n    let dep_path = Array::get(deps, i)\n    let (\n      dep_fp,\n      next_db,\n      next_env_cache,\n      next_dep_source_cache2,\n      next_parse_count\n    ) = ensure_fingerprint_fs(\n      db_after_deps,\n      env_cache_after_deps,\n      dep_source_cache_after_deps,\n      parse_count_after_deps,\n      dep_path,\n      next_stack\n    )\n    Array::push(dep_fps, (dep_path, dep_fp))\n    db_after_deps = next_db\n    env_cache_after_deps = next_env_cache\n    dep_source_cache_after_deps = next_dep_source_cache2\n    parse_count_after_deps = next_parse_count\n    i = i + 1\n  }\n  let fingerprint = build_fingerprint(source, dep_fps)\n  match ripple_get_fingerprint(db_after_deps, path) {\n    Some(cached_fp) =>\n      if String::equals(cached_fp, fingerprint) {\n        (\n          fingerprint,\n          db_after_deps,\n          env_cache_after_deps,\n          dep_source_cache_after_deps,\n          parse_count_after_deps\n        )\n      } else {\n        finish_typecheck_fs(\n          db_after_deps,\n          env_cache_after_deps,\n          dep_source_cache_after_deps,\n          parse_count_after_deps,\n          path,\n          source,\n          deps,\n          fingerprint\n        )\n      },\n    None =>\n      finish_typecheck_fs(\n        db_after_deps,\n        env_cache_after_deps,\n        dep_source_cache_after_deps,\n        parse_count_after_deps,\n        path,\n        source,\n        deps,\n        fingerprint\n      )\n  }\n}\n\nlet finish_typecheck_fs = (\n  rdb: RippleDb,\n  env_cache: Array[(String, TypeEnv)],\n  dep_source_cache: Array[(String, String)],\n  parse_count: Int,\n  path: String,\n  source: String,\n  deps: Array[String],\n  fingerprint: String\n) -> (String, RippleDb, Array[(String, TypeEnv)], Array[(String, String)], Int) with { Error, Fs } {\n  match load_persistent_type_env(fingerprint) {\n    Some(cached_env) => {\n      let next_env_cache = upsert_env_cache(env_cache, path, cached_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n      (fingerprint, next_db, next_env_cache, dep_source_cache, parse_count)\n    },\n    None => {\n      let stmts = parse_program_with_path(path, source)\n      let final_parse_count = parse_count + 1\n      let import_env = build_import_env(stmts, dir_of(path), env_cache)\n      let checked_env = check_program_with_env(stmts, import_env)\n      store_persistent_type_env(fingerprint, checked_env)\n      if Array::length(deps) == 0 {\n        Fs::write_file(\n          persistent_leaf_fingerprint_cache_path(path, compact_string_fingerprint(source)),\n          persistent_leaf_fingerprint_text(fingerprint)\n        )\n      } else {\n        ()\n      }\n      let next_env_cache = upsert_env_cache(env_cache, path, checked_env)\n      let next_db = ripple_record_eval(rdb, path, fingerprint, deps)\n      (\n        fingerprint,\n        next_db,\n        next_env_cache,\n        dep_source_cache,\n        final_parse_count\n      )\n    }\n  }\n}\n\nexport let db_typecheck_fs = (db: TypeDb, path: String) -> TypeDb with { Error, Fs } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let (\n        _,\n        next_rdb,\n        next_env_cache,\n        next_dep_source_cache,\n        next_parse_count\n      ) = ensure_fingerprint_fs(\n        rdb,\n        env_cache,\n        dep_source_cache,\n        parse_count,\n        path,\n        empty_stack()\n      )\n      wrap_db(\n        TypeDbState(\n          next_rdb,\n          next_env_cache,\n          next_dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          artifact_cache,\n          next_parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count\n        )\n      )\n    }\n  }\n}\n\nexport let db_program_source = (db: TypeDb, path: String) -> (String, String, TypeDb) with { Error } {\n  let checked = db_typecheck(db, path)\n  match unwrap_db(checked) {\n    TypeDbState(rdb, _, _, _, _, _, _, _, _, _) =>\n      match ripple_get_source(rdb, path) {\n        None => throw(String::concat(\"missing:\", path)),\n        Some(source) =>\n          match ripple_get_fingerprint(rdb, path) {\n            Some(fingerprint) => (source, fingerprint, checked),\n            None => (source, source, checked)\n          }\n      }\n  }\n}\n\nlet build_merge_fingerprint = (sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", compact_string_fingerprint(source))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_grouped_merge_fingerprint = (group_fingerprints: Array[(String, String)]) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(group_fingerprints) {\n    let (group_name, fingerprint) = Array::get(group_fingerprints, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_merged_source = (sources: Array[(String, String)]) -> String with { Error } {\n  let merged = empty_stmt_array()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, source) = Array::get(sources, si)\n    let stmts = parse_program_with_path(\"(merged)\", source)\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        _ => Array::push(merged, stmt),\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  print_program(merged)\n}\n\nlet join_group_sources = (group_sources: Array[(String, String)]) -> String {\n  let len = Array::length(group_sources)\n  let rec go = (i: Int, acc: String) -> String {\n    if i >= len {\n      acc\n    } else {\n      let (_, source) = Array::get(group_sources, i)\n      let next = if String::equals(acc, \"\") {\n        source\n      } else {\n        String::concat(acc, String::concat(\"\\n\", source))\n      }\n      go(i + 1, next)\n    }\n  }\n  go(0, \"\")\n}\n\nexport let db_merged_source = (\n  db: TypeDb,\n  _entry_path: String,\n  sources: Array[(String, String)]\n) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let merge_fingerprint = build_merge_fingerprint(sources)\n      let merge_cache_key = \"merged\"\n      match lookup_source_cache(merged_cache, merge_cache_key, merge_fingerprint) {\n        Some(merged_source) => (merged_source, merge_fingerprint, db),\n        None => {\n          let merged_source = build_merged_source(sources)\n          let next_merged_cache = upsert_source_cache(\n            merged_cache,\n            merge_cache_key,\n            merge_fingerprint,\n            merged_source\n          )\n          (\n            merged_source,\n            merge_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nexport let db_grouped_merged_source = (\n  db: TypeDb,\n  groups: Array[(String, Array[(String, String)])]\n) -> (String, String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let rec load_groups = (\n        i: Int,\n        group_fingerprints: Array[(String, String)],\n        group_sources: Array[(String, String)],\n        cache_acc: Array[StringTriple],\n        merge_count_acc: Int\n      ) -> (Array[(String, String)], Array[(String, String)], Array[StringTriple], Int) with { Error } {\n        if i >= Array::length(groups) {\n          (group_fingerprints, group_sources, cache_acc, merge_count_acc)\n        } else {\n          let (group_name, sources) = Array::get(groups, i)\n          let fingerprint = build_merge_fingerprint(sources)\n          let cache_key = String::concat(\"merged-group|\", group_name)\n          match lookup_source_cache(cache_acc, cache_key, fingerprint) {\n            Some(source) =>\n              load_groups(\n                i + 1,\n                Array::concat(group_fingerprints, [(group_name, fingerprint)]),\n                Array::concat(group_sources, [(group_name, source)]),\n                cache_acc,\n                merge_count_acc\n              ),\n            None => {\n              let source = build_merged_source(sources)\n              let next_cache = upsert_source_cache(cache_acc, cache_key, fingerprint, source)\n              load_groups(\n                i + 1,\n                Array::concat(group_fingerprints, [(group_name, fingerprint)]),\n                Array::concat(group_sources, [(group_name, source)]),\n                next_cache,\n                merge_count_acc + 1\n              )\n            }\n          }\n        }\n      }\n      let (group_fingerprints, group_sources, next_merged_cache, next_merge_count) = load_groups(\n        0,\n        empty_string_pairs(),\n        empty_string_pairs(),\n        merged_cache,\n        merge_count\n      )\n      let grouped_fingerprint = build_grouped_merge_fingerprint(group_fingerprints)\n      let grouped_cache_key = \"merged-groups\"\n      match lookup_source_cache(next_merged_cache, grouped_cache_key, grouped_fingerprint) {\n        Some(source) =>\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                next_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count,\n                module_source_count,\n                codegen_count\n              )\n            )\n          ),\n        None => {\n          let source = join_group_sources(group_sources)\n          let final_merged_cache = upsert_source_cache(\n            next_merged_cache,\n            grouped_cache_key,\n            grouped_fingerprint,\n            source\n          )\n          (\n            source,\n            grouped_fingerprint,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                final_merged_cache,\n                module_source_cache,\n                artifact_cache,\n                parse_count,\n                next_merge_count + 1,\n                module_source_count,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nlet build_module_source = (source: String) -> String with { Error } {\n  let stmts = parse_program(lex(source))\n  let filtered = empty_stmt_array()\n  let mut i = 0\n  while i < Array::length(stmts) {\n    let stmt = Array::get(stmts, i)\n    let keep = match stmt {\n      SLet(_, _, _, _, expr) => {\n        match expr {\n          EFn(_, _, _, _, _, _) => true,\n          _ => false\n        }\n      },\n      _ => false\n    }\n    if keep {\n      Array::push(filtered, stmt)\n    }\n    i = i + 1\n  }\n  print_program(filtered)\n}\n\nexport let db_module_source = (db: TypeDb, fingerprint: String, source: String) -> (String, TypeDb) with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) => {\n      let module_cache_key = \"module-source\"\n      match lookup_source_cache(module_source_cache, module_cache_key, fingerprint) {\n        Some(module_source) => (module_source, db),\n        None => {\n          let module_source = build_module_source(source)\n          let next_module_source_cache = upsert_source_cache(\n            module_source_cache,\n            module_cache_key,\n            fingerprint,\n            module_source\n          )\n          (\n            module_source,\n            wrap_db(\n              TypeDbState(\n                rdb,\n                env_cache,\n                dep_source_cache,\n                merged_cache,\n                next_module_source_cache,\n                artifact_cache,\n                parse_count,\n                merge_count,\n                module_source_count + 1,\n                codegen_count\n              )\n            )\n          )\n        }\n      }\n    }\n  }\n}\n\nlet artifact_cache_key = (kind: String, entry_name: String) -> String {\n  String::concat(kind, String::concat(\"|\", entry_name))\n}\n\nlet bytes_to_hex_digit = (n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nlet nibble_from_hex_char = (c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nlet bytes_to_hex = (bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  let mut out = \"\"\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    out = String::concat(out, bytes_to_hex_digit(hi))\n    out = String::concat(out, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  out\n}\n\nlet hex_to_bytes = (hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Array::slice([0], 0, 0)\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Array::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    Bytes::from_array(out)\n  }\n}\n\nexport let db_load_artifact = (db: TypeDb, _path: String, kind: String, entry_name: String, fingerprint: String) -> Option[Bytes] with { Error } {\n  match unwrap_db(db) {\n    TypeDbState(_, _, _, _, _, artifact_cache, _, _, _, _) =>\n      match lookup_source_cache(artifact_cache, artifact_cache_key(kind, entry_name), fingerprint) {\n        Some(hex) => Some(hex_to_bytes(hex)),\n        None => None\n      }\n  }\n}\n\nexport let db_store_artifact = (\n  db: TypeDb,\n  _path: String,\n  kind: String,\n  entry_name: String,\n  fingerprint: String,\n  bytes: Bytes\n) -> TypeDb {\n  match unwrap_db(db) {\n    TypeDbState(rdb, env_cache, dep_source_cache, merged_cache, module_source_cache, artifact_cache, parse_count, merge_count, module_source_count, codegen_count) =>\n      wrap_db(\n        TypeDbState(\n          rdb,\n          env_cache,\n          dep_source_cache,\n          merged_cache,\n          module_source_cache,\n          upsert_source_cache(\n            artifact_cache,\n            artifact_cache_key(kind, entry_name),\n            fingerprint,\n            bytes_to_hex(bytes)\n          ),\n          parse_count,\n          merge_count,\n          module_source_count,\n          codegen_count + 1\n        )\n      )\n  }\n}\n")

  let source_57 = ("vibe/compiler/type_db.vibe",
"//# Imports\n\nexport ./runtime {\n  TypeDb, db_check_env, db_codegen_count, db_grouped_merged_source, db_load_artifact, db_merge_count, db_merged_source, db_module_source, db_module_source_count, db_new, db_parse_count, db_program_source, db_set_source, db_store_artifact, db_typecheck, db_typecheck_count, db_typecheck_fs\n}\n\n//# Misc\n\nexport {\n  TypeDb, db_new, db_check_env, db_typecheck, db_typecheck_fs, db_set_source, db_merge_count, db_parse_count, db_codegen_count, db_load_artifact, db_merged_source, db_module_source, db_program_source, db_store_artifact, db_typecheck_count, db_module_source_count, db_grouped_merged_source\n}\n")

  let source_58 = ("vibe/compiler/cache/persistent/index.vibe",
"//# Functions\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Array::slice([\n    0\n  ], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nlet bytes_to_hex_digit = (n: Int) -> String {\n  if n < 10 {\n    __to_string(n)\n  } else if n == 10 {\n    \"a\"\n  } else if n == 11 {\n    \"b\"\n  } else if n == 12 {\n    \"c\"\n  } else if n == 13 {\n    \"d\"\n  } else if n == 14 {\n    \"e\"\n  } else {\n    \"f\"\n  }\n}\n\nlet nibble_from_hex_char = (c: Int) -> Int with { Error } {\n  if c >= 48 && c <= 57 {\n    c - 48\n  } else if c >= 97 && c <= 102 {\n    c - 87\n  } else if c >= 65 && c <= 70 {\n    c - 55\n  } else {\n    throw(\"invalid hex digit\")\n  }\n}\n\nlet bytes_to_hex = (bytes: Bytes) -> String {\n  let len = Bytes::length(bytes)\n  let mut i = 0\n  let mut out = \"\"\n  while i < len {\n    let byte = Bytes::get(bytes, i)\n    let hi = byte / 16\n    let lo = byte % 16\n    out = String::concat(out, bytes_to_hex_digit(hi))\n    out = String::concat(out, bytes_to_hex_digit(lo))\n    i = i + 1\n  }\n  out\n}\n\nlet hex_to_bytes = (hex: String) -> Bytes with { Error } {\n  let len = String::length(hex)\n  if len % 2 != 0 {\n    throw(\"invalid hex length\")\n  } else {\n    let out = Array::slice([0], 0, 0)\n    let mut i = 0\n    while i < len {\n      let hi = nibble_from_hex_char(String::char_code_at(hex, i))\n      let lo = nibble_from_hex_char(String::char_code_at(hex, i + 1))\n      Array::push(out, hi * 16 + lo)\n      i = i + 2\n    }\n    Bytes::from_array(out)\n  }\n}\n\nexport let compact_string_fingerprint = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nexport let normalize_persistent_cache_text = (text: String) -> String {\n  let len = String::length(text)\n  let mut start = 0\n  while start < len && String::char_code_at(text, start) == 0 {\n    start = start + 1\n  }\n  if start == 0 {\n    text\n  } else {\n    String::substring(text, start, len)\n  }\n}\n\nlet build_sources_fingerprint = (sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", compact_string_fingerprint(source))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_sources_fingerprint_from_compact_fingerprints = (\n  source_fingerprints: Array[String]\n) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(source_fingerprints) {\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", Array::get(source_fingerprints, i))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_source_groups_fingerprint = (groups: Array[(String, Array[(String, String)])]) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, i)\n    let fingerprint = build_sources_fingerprint(sources)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nexport let build_source_groups_fingerprint_from_compact_fingerprints = (\n  groups: Array[(String, Array[(String, String)])]\n) -> String {\n  let mut acc = \"merged-groups\"\n  let mut i = 0\n  while i < Array::length(groups) {\n    let (group_name, specs) = Array::get(groups, i)\n    let source_fingerprints = Array::slice([\"\"], 0, 0)\n    let mut j = 0\n    while j < Array::length(specs) {\n      let (_, source_fingerprint) = Array::get(specs, j)\n      Array::push(source_fingerprints, source_fingerprint)\n      j = j + 1\n    }\n    let fingerprint = build_sources_fingerprint_from_compact_fingerprints(source_fingerprints)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", String::concat(group_name, String::concat(\"=\", fingerprint)))\n    )\n    acc = compact_string_fingerprint(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet stable_cache_path = (prefix: String, seed: String, suffix: String) -> String {\n  let raw = compact_string_fingerprint(String::concat(\"persistent-cache-v1|\", seed))\n  let mut token = \"\"\n  let mut i = 0\n  while i < String::length(raw) {\n    let c = String::char_code_at(raw, i)\n    token = String::concat(\n      token,\n      if c == 58 {\n        \"_\"\n      } else {\n        String::from_char_code(c)\n      }\n    )\n    i = i + 1\n  }\n  String::concat(\n    \"_build/vibe_\",\n    String::concat(\n      prefix,\n      String::concat(\n        \"_\",\n        String::concat(token, suffix)\n      )\n    )\n  )\n}\n\nexport let persistent_source_list_cache_path = (entry_path: String) -> String {\n  stable_cache_path(\"selfhost_source_list\", entry_path, \".tsv\")\n}\n\nexport let persistent_source_group_cache_path = (entry_path: String) -> String {\n  stable_cache_path(\"selfhost_source_groups\", entry_path, \".tsv\")\n}\n\nexport let persistent_manifest_header_cache_path = (entry_path: String) -> String {\n  stable_cache_path(\"selfhost_manifest_headers\", entry_path, \".tsv\")\n}\n\nexport let persistent_type_env_cache_path = (fingerprint: String) -> String {\n  stable_cache_path(\"selfhost_type_env\", fingerprint, \".tsv\")\n}\n\nexport let persistent_dep_list_cache_path = (path: String, source_fingerprint: String) -> String {\n  stable_cache_path(\n    \"selfhost_dep_list\",\n    String::concat(path, String::concat(\"|\", source_fingerprint)),\n    \".tsv\"\n  )\n}\n\nexport let persistent_leaf_fingerprint_cache_path = (path: String, source_fingerprint: String) -> String {\n  stable_cache_path(\n    \"selfhost_leaf_fp\",\n    String::concat(path, String::concat(\"|\", source_fingerprint)),\n    \".tsv\"\n  )\n}\n\nexport let persistent_module_header_cache_path = (path: String, source_fingerprint: String) -> String {\n  stable_cache_path(\n    \"selfhost_module_header\",\n    String::concat(path, String::concat(\"|\", source_fingerprint)),\n    \".tsv\"\n  )\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String,\n  mode: String\n) -> String {\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups),\n    entry_name,\n    mode\n  )\n}\n\nexport let build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String,\n  entry_name: String,\n  mode: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\n      \"file-compile|\",\n      String::concat(\n        source_groups_fingerprint,\n        String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode)))\n      )\n    )\n  )\n}\n\nexport let build_file_compile_module_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])]\n) -> String {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups)\n  )\n}\n\nexport let build_file_compile_module_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\"file-compile-module|\", source_groups_fingerprint)\n  )\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> String {\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups),\n    entry_name\n  )\n}\n\nexport let build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String,\n  entry_name: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\n      \"fs-compile|\",\n      String::concat(source_groups_fingerprint, String::concat(\"|\", entry_name))\n    )\n  )\n}\n\nexport let build_fs_compile_module_artifact_fingerprint = (\n  source_groups: Array[(String, Array[(String, String)])]\n) -> String {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(\n    build_source_groups_fingerprint(source_groups)\n  )\n}\n\nexport let build_fs_compile_module_artifact_fingerprint_from_group_fingerprint = (\n  source_groups_fingerprint: String\n) -> String {\n  compact_string_fingerprint(\n    String::concat(\"fs-compile-module|\", source_groups_fingerprint)\n  )\n}\n\nexport let persistent_artifact_cache_path = (\n  kind: String,\n  entry_name: String,\n  fingerprint: String\n) -> String {\n  stable_cache_path(\n    \"selfhost_artifact\",\n    String::concat(kind, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", fingerprint)))),\n    \".hex\"\n  )\n}\n\nexport let load_persistent_artifact = (\n  kind: String,\n  entry_name: String,\n  fingerprint: String\n) -> Option[Bytes] with { Error, Fs } {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  if !(Fs::exists(path)) {\n    None\n  } else {\n    Some(hex_to_bytes(normalize_persistent_cache_text(Fs::read_file(path))))\n  }\n}\n\nexport let store_persistent_artifact = (\n  kind: String,\n  entry_name: String,\n  fingerprint: String,\n  bytes: Bytes\n) -> Unit with { Error, Fs } {\n  let path = persistent_artifact_cache_path(kind, entry_name, fingerprint)\n  Fs::write_file(path, bytes_to_hex(bytes))\n}\n")

  let source_59 = ("vibe/compiler/loader/index.vibe",
"//# Imports\n\nimport ../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../core/ast.vibe {\n  Stmt,\n}\n\nimport ../core/types.vibe {\n  Subst,\n  Type,\n  TypeDef,\n  TypeEnv,\n  env_bind,\n  env_lookup\n}\n\nimport ../checker/checker_stmt.vibe {\n  check_stmts\n}\n\nimport ../runtime/eval_loader/index.vibe {\n  collect_exports, load_and_parse\n}\n\nimport ../cache/persistent/index.vibe {\n  build_source_groups_fingerprint_from_compact_fingerprints,\n  compact_string_fingerprint,\n  normalize_persistent_cache_text,\n  persistent_manifest_header_cache_path,\n  persistent_module_header_cache_path,\n  persistent_source_group_cache_path,\n  persistent_source_list_cache_path\n}\n\n//# Path helpers (inline to avoid cross-module import issues)\n\nlet dir_of = (file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  }\n  else {\n    String::substring(file_path, 0, idx)\n  }\n}\n\nlet normalize_path = (path: String) -> String {\n  let mut parts = Array::slice([\"\"], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(path, i) == 47 {\n      let part = String::substring(path, start, i)\n      if String::length(part) == 0 || String::equals(part, \".\") {\n        ()\n      } else if String::equals(part, \"..\") {\n        if Array::length(parts) > 0 {\n          parts = Array::slice(parts, 0, Array::length(parts) - 1)\n        }\n      } else {\n        Array::push(parts, part)\n      }\n      start = i + 1\n    }\n    i = i + 1\n  }\n  let mut out = \"\"\n  i = 0\n  while i < Array::length(parts) {\n    if i > 0 {\n      out = String::concat(out, \"/\")\n    }\n    out = String::concat(out, Array::get(parts, i))\n    i = i + 1\n  }\n  out\n}\n\nlet resolve_path = (base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  let joined = if (len >= 2 && String::equals(String::substring(raw_path, 0, 2), \"./\")) ||\n    (len >= 3 && String::equals(String::substring(raw_path, 0, 3), \"../\")) {\n      if String::equals(base_dir, \"\") {\n        raw_path\n      } else {\n        String::concat(base_dir, String::concat(\"/\", raw_path))\n      }\n    } else {\n      raw_path\n    }\n  let normalized = normalize_path(joined)\n  if String::ends_with(normalized, \".vibe\") {\n    normalized\n  } else {\n    String::concat(normalized, \".vibe\")\n  }\n}\n\nlet contains_str = (arr: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) {\n    if !found && String::equals(Array::get(arr, i), target) {\n      found = true\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    match found {\n      Some(_) => (),\n      None => {\n        let (p, src) = Array::get(sources, i)\n        if String::equals(p, path_key) {\n          found = Some(src)\n        }\n      }\n    }\n    i = i + 1\n  }\n  found\n}\n\nlet join_path = (base_dir: String, rel_path: String) -> String {\n  if String::equals(base_dir, \"\") {\n    rel_path\n  } else {\n    String::concat(base_dir, String::concat(\"/\", rel_path))\n  }\n}\n\nlet strip_trailing_cr = (line: String) -> String {\n  let len = String::length(line)\n  if len > 0 && String::char_code_at(line, len - 1) == 13 {\n    String::substring(line, 0, len - 1)\n  } else {\n    line\n  }\n}\n\nlet find_char = (s: String, target: Int) -> Int {\n  let len = String::length(s)\n  let mut i = 0\n  let mut result = -1\n  while i < len {\n    if String::char_code_at(s, i) == target {\n      result = i\n      i = len\n    } else {\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet parse_source_manifest_rows = (manifest_source: String) -> Array[(String, String)] with { Error } {\n  let rows = Array::slice([(\"\", \"\")], 0, 0)\n  let len = String::length(manifest_source)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(manifest_source, i) == 10 {\n      let raw_line = strip_trailing_cr(String::substring(manifest_source, line_start, i))\n      let line_len = String::length(raw_line)\n      if line_len > 0 && String::char_code_at(raw_line, 0) != 35 {\n        let tab_idx = find_char(raw_line, 9)\n        if tab_idx < 0 || tab_idx + 1 >= line_len {\n          throw(String::concat(\"invalid source manifest row: \", raw_line))\n        }\n        let group = String::substring(raw_line, 0, tab_idx)\n        let path = String::substring(raw_line, tab_idx + 1, line_len)\n        Array::push(rows, (group, path))\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  rows\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Array::slice([0], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nlet special_bundle_header = (path: String) -> Option[(Array[String], Array[String])] {\n  if String::ends_with(path, \"selfhost_sources_bundle.vibe\") {\n    Some((\n      Array::slice([\"\"], 0, 0),\n      [\"selfhost_sources\", \"selfhost_source_groups\"]\n    ))\n  } else {\n    None\n  }\n}\n\nlet split_tsv_fields = (line: String) -> Array[String] {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(line, i) == 9 {\n      Array::push(fields, String::substring(line, start, i))\n      start = i + 1\n    }\n    i = i + 1\n  }\n  fields\n}\n\nlet header_value_separator = String::from_char_code(31)\n\nlet join_header_values = (values: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(values) {\n    if i > 0 {\n      out = String::concat(out, header_value_separator)\n    }\n    out = String::concat(out, Array::get(values, i))\n    i = i + 1\n  }\n  out\n}\n\nlet split_header_values = (text: String) -> Array[String] {\n  let values = Array::slice([\"\"], 0, 0)\n  if String::length(text) == 0 {\n    values\n  } else {\n    let sep = String::char_code_at(header_value_separator, 0)\n    let len = String::length(text)\n    let mut start = 0\n    let mut i = 0\n    while i <= len {\n      if i == len || String::char_code_at(text, i) == sep {\n        Array::push(values, String::substring(text, start, i))\n        start = i + 1\n      }\n      i = i + 1\n    }\n    values\n  }\n}\n\nlet empty_source_specs = () -> Array[(String, String)] {\n  Array::slice([(\"\", \"\")], 0, 0)\n}\n\nlet empty_group_specs = () -> Array[(String, String, String)] {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_source_cache_specs = () -> Array[(String, String, String)] {\n  Array::slice([(\"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_group_cache_specs = () -> Array[(String, String, String, String)] {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet empty_manifest_header_cache_rows = () -> Array[(String, String, String, String)] {\n  Array::slice([(\"\", \"\", \"\", \"\")], 0, 0)\n}\n\nlet parse_persistent_source_list_cache = (\n  raw: String\n) -> (Int, Option[(String, String, String)], Array[(String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let sources = empty_source_cache_specs()\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(String::substring(raw, line_start, i))\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if String::equals(tag, \"version\") {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source list cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if String::equals(version_text, \"1\") {\n            version = 1\n          } else if String::equals(version_text, \"2\") {\n            version = 2\n          } else {\n            throw(\"invalid persistent source list cache version\")\n          }\n        } else if String::equals(tag, \"manifest\") {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if String::equals(tag, \"source\") {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source list cache source row\")\n            }\n            Array::push(sources, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source list cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, sources)\n}\n\nlet parse_persistent_source_group_cache = (\n  raw: String\n) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_group_cache_specs()\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(String::substring(raw, line_start, i))\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if String::equals(tag, \"version\") {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent source group cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if String::equals(version_text, \"1\") {\n            version = 1\n          } else if String::equals(version_text, \"2\") {\n            version = 2\n          } else {\n            throw(\"invalid persistent source group cache version\")\n          }\n        } else if String::equals(tag, \"manifest\") {\n          if version == 1 {\n            if Array::length(fields) != 3 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), \"\", Array::get(fields, 2)))\n          } else {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache manifest row\")\n            }\n            manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n          }\n        } else if String::equals(tag, \"group\") {\n          if version == 1 {\n            if Array::length(fields) != 4 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), \"\", Array::get(fields, 3)))\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent source group cache group row\")\n            }\n            Array::push(rows, (Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3), Array::get(fields, 4)))\n          }\n        } else {\n          throw(String::concat(\"invalid persistent source group cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet parse_persistent_manifest_header_cache = (\n  raw: String\n) -> (Int, Option[(String, String, String)], Array[(String, String, String, String)]) with { Error } {\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  let mut version = 0\n  let mut manifest = None\n  let rows = empty_manifest_header_cache_rows()\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(String::substring(raw, line_start, i))\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let tag = Array::get(fields, 0)\n        if String::equals(tag, \"version\") {\n          if Array::length(fields) != 2 {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n          let version_text = Array::get(fields, 1)\n          if String::equals(version_text, \"1\") {\n            version = 1\n          } else if String::equals(version_text, \"2\") {\n            version = 2\n          } else {\n            throw(\"invalid persistent manifest header cache version\")\n          }\n        } else if String::equals(tag, \"manifest\") {\n          if Array::length(fields) != 4 {\n            throw(\"invalid persistent manifest header cache manifest row\")\n          }\n          manifest = Some((Array::get(fields, 1), Array::get(fields, 2), Array::get(fields, 3)))\n        } else if String::equals(tag, \"header\") {\n          if version == 1 {\n            if Array::length(fields) != 6 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          } else {\n            if Array::length(fields) != 5 {\n              throw(\"invalid persistent manifest header cache header row\")\n            }\n            Array::push(\n              rows,\n              (\n                Array::get(fields, 1),\n                Array::get(fields, 2),\n                Array::get(fields, 3),\n                Array::get(fields, 4)\n              )\n            )\n          }\n        } else {\n          throw(String::concat(\"invalid persistent manifest header cache row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  (version, manifest, rows)\n}\n\nlet matches_cached_file_spec = (\n  path: String,\n  stat_token_text: String,\n  source_fingerprint: String\n) -> Bool with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    false\n  } else {\n    if String::length(stat_token_text) > 0 &&\n      String::equals(__to_string(Fs::stat_token(path)), stat_token_text) {\n      true\n    } else if String::length(source_fingerprint) > 0 {\n      String::equals(compact_string_fingerprint(Fs::read_file(path)), source_fingerprint)\n    } else {\n      false\n    }\n  }\n}\n\nlet load_source_if_cached_file_spec_matches = (\n  path: String,\n  stat_token_text: String,\n  source_fingerprint: String\n) -> Option[String] with { Error, Fs } {\n  if !(Fs::exists(path)) {\n    None\n  } else if String::length(stat_token_text) > 0 &&\n    String::equals(__to_string(Fs::stat_token(path)), stat_token_text) {\n    Some(Fs::read_file(path))\n  } else if String::length(source_fingerprint) > 0 {\n    let source = Fs::read_file(path)\n    if String::equals(compact_string_fingerprint(source), source_fingerprint) {\n      Some(source)\n    } else {\n      None\n    }\n  } else {\n    None\n  }\n}\n\nlet manifest_cache_is_valid = (manifest: Option[(String, String, String)]) -> Bool with { Error, Fs } {\n  match manifest {\n    Some((path, stat_token_text, source_fingerprint)) =>\n      matches_cached_file_spec(path, stat_token_text, source_fingerprint),\n    None => true\n  }\n}\n\nlet load_persistent_sources_cache_if_valid = (\n  entry_path: String\n) -> Option[Array[(String, String)]] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let sources = empty_source_specs()\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(specs) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint) = Array::get(specs, i)\n          match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n            Some(source) => Array::push(sources, (path, source)),\n            None => {\n              valid = false\n            }\n          }\n        }\n        i = i + 1\n      }\n      if valid { Some(sources) } else { None }\n    }\n  }\n}\n\nlet load_persistent_source_groups_cache_if_valid = (\n  entry_path: String\n) -> Option[Array[(String, Array[(String, String)])]] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let groups = empty_grouped_sources()\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n          match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n            Some(source) => push_grouped_source(groups, group_name, path, source),\n            None => {\n              valid = false\n            }\n          }\n        }\n        i = i + 1\n      }\n      if valid { Some(groups) } else { None }\n    }\n  }\n}\n\nlet load_persistent_manifest_header_cache_if_valid = (\n  entry_path: String,\n  manifest_path: String,\n  preloaded_sources: Array[(String, String)]\n) -> Option[Array[(String, String, String, String)]] with { Error, Fs } {\n  let cache_path = persistent_manifest_header_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_manifest_header_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    let manifest_ok = match manifest {\n      Some((cached_path, stat_token_text, source_fingerprint)) =>\n        String::equals(cached_path, manifest_path) &&\n          matches_cached_file_spec(manifest_path, stat_token_text, source_fingerprint),\n      None => false\n    }\n    if !manifest_ok {\n      None\n    } else {\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (path, _, source_fingerprint, _) = Array::get(rows, i)\n          match source_lookup(preloaded_sources, path) {\n            Some(source) => {\n              if !(String::equals(compact_string_fingerprint(source), source_fingerprint)) {\n                valid = false\n              }\n            },\n            None => {\n              valid = false\n            }\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(rows)\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet push_grouped_source_fingerprint = (\n  groups: Array[(String, Array[(String, String)])],\n  group_name: String,\n  path: String,\n  source_fingerprint: String\n) -> Unit {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, specs) = Array::get(groups, i)\n    if String::equals(name, group_name) {\n      Array::push(specs, (path, source_fingerprint))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let specs = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(specs, (path, source_fingerprint))\n    Array::push(groups, (group_name, specs))\n  }\n}\n\nlet manifest_path_of = (manifest: Option[(String, String, String)]) -> Option[String] {\n  match manifest {\n    Some((path, _, _)) => Some(path),\n    None => None\n  }\n}\n\nlet build_grouped_sources_from_manifest_rows = (\n  base_dir: String,\n  rows: Array[(String, String)],\n  sources: Array[(String, String)]\n) -> Array[(String, Array[(String, String)])] {\n  let groups = empty_grouped_sources()\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (group_name, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    match source_lookup(sources, path) {\n      Some(source) => push_grouped_source(groups, group_name, path, source),\n      None => ()\n    }\n    i = i + 1\n  }\n  groups\n}\n\nlet load_persistent_sources_from_group_cache_if_valid = (\n  entry_path: String\n) -> Option[(Option[String], Array[(String, String)])] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let sources = empty_source_specs()\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (_, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n          match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n            Some(source) => Array::push(sources, (path, source)),\n            None => {\n              valid = false\n            }\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some((manifest_path_of(manifest), sources))\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet load_persistent_source_groups_from_source_list_cache_if_valid = (\n  entry_path: String\n) -> Option[(Option[String], Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  let cache_path = persistent_source_list_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, specs) = parse_persistent_source_list_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let sources = empty_source_specs()\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(specs) {\n        if valid {\n          let (path, stat_token_text, source_fingerprint) = Array::get(specs, i)\n          match load_source_if_cached_file_spec_matches(path, stat_token_text, source_fingerprint) {\n            Some(source) => Array::push(sources, (path, source)),\n            None => {\n              valid = false\n            }\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        match try_load_manifest_rows(entry_path) {\n          Some((base_dir, rows)) => {\n            let groups = build_grouped_sources_from_manifest_rows(base_dir, rows, sources)\n            Some((manifest_path_of(manifest), groups))\n          },\n          None => {\n            let groups = empty_grouped_sources()\n            Array::push(groups, (\"recursive\", sources))\n            Some((None, groups))\n          }\n        }\n      } else {\n        None\n      }\n    }\n  }\n}\n\nexport let load_persistent_source_group_fingerprint_if_valid = (\n  entry_path: String\n) -> Option[String] with { Error, Fs } {\n  let cache_path = persistent_source_group_cache_path(entry_path)\n  if !(Fs::exists(cache_path)) {\n    None\n  } else {\n    let (_, manifest, rows) = parse_persistent_source_group_cache(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    if !(manifest_cache_is_valid(manifest)) {\n      None\n    } else {\n      let groups = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n      let mut valid = true\n      let mut i = 0\n      while i < Array::length(rows) {\n        if valid {\n          let (group_name, path, stat_token_text, source_fingerprint) = Array::get(rows, i)\n          if !(matches_cached_file_spec(path, stat_token_text, source_fingerprint)) {\n            valid = false\n          } else {\n            push_grouped_source_fingerprint(groups, group_name, path, source_fingerprint)\n          }\n        }\n        i = i + 1\n      }\n      if valid {\n        Some(build_source_groups_fingerprint_from_compact_fingerprints(groups))\n      } else {\n        None\n      }\n    }\n  }\n}\n\nlet build_persistent_sources_cache_text = (\n  manifest_path: Option[String],\n  sources: Array[(String, String)]\n  ) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"source\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              __to_string(Fs::stat_token(path)),\n              String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet build_persistent_source_groups_cache_text = (\n  manifest_path: Option[String],\n  groups: Array[(String, Array[(String, String)])]\n) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  match manifest_path {\n    Some(path) => {\n      out = String::concat(\n        out,\n        String::concat(\n          \"manifest\\t\",\n          String::concat(\n            path,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                __to_string(Fs::stat_token(path)),\n                String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(path)), \"\\n\"))\n              )\n            )\n          )\n        )\n      )\n    },\n    None => ()\n  }\n  let mut gi = 0\n  while gi < Array::length(groups) {\n    let (group_name, sources) = Array::get(groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      out = String::concat(\n        out,\n        String::concat(\n          \"group\\t\",\n          String::concat(\n            group_name,\n            String::concat(\n              \"\\t\",\n              String::concat(\n                path,\n                String::concat(\n                  \"\\t\",\n                  String::concat(\n                    __to_string(Fs::stat_token(path)),\n                    String::concat(\"\\t\", String::concat(compact_string_fingerprint(source), \"\\n\"))\n                  )\n                )\n              )\n            )\n          )\n        )\n      )\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  out\n}\n\nlet build_persistent_manifest_header_cache_text = (\n  manifest_path: String,\n  rows: Array[(String, String, String, String)]\n) -> String with { Error, Fs } {\n  let mut out = \"version\\t2\\n\"\n  out = String::concat(\n    out,\n    String::concat(\n      \"manifest\\t\",\n      String::concat(\n        manifest_path,\n        String::concat(\n          \"\\t\",\n          String::concat(\n            __to_string(Fs::stat_token(manifest_path)),\n            String::concat(\"\\t\", String::concat(compact_string_fingerprint(Fs::read_file(manifest_path)), \"\\n\"))\n          )\n        )\n      )\n    )\n  )\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (path, stat_token_text, source_fingerprint, deps_text) = Array::get(rows, i)\n    out = String::concat(\n      out,\n      String::concat(\n        \"header\\t\",\n        String::concat(\n          path,\n          String::concat(\n            \"\\t\",\n            String::concat(\n              stat_token_text,\n              String::concat(\n                \"\\t\",\n                String::concat(\n                  source_fingerprint,\n                  String::concat(\"\\t\", String::concat(deps_text, \"\\n\"))\n                )\n              )\n            )\n          )\n        )\n      )\n    )\n    i = i + 1\n  }\n  out\n}\n\nlet persistent_module_header_text = (deps: Array[String], exports: Array[String]) -> String {\n  let mut out = \"version\\t1\\n\"\n  let mut i = 0\n  while i < Array::length(deps) {\n    out = String::concat(\n      out,\n      String::concat(\"dep\\t\", String::concat(Array::get(deps, i), \"\\n\"))\n    )\n    i = i + 1\n  }\n  let mut j = 0\n  while j < Array::length(exports) {\n    out = String::concat(\n      out,\n      String::concat(\"export\\t\", String::concat(Array::get(exports, j), \"\\n\"))\n    )\n    j = j + 1\n  }\n  out\n}\n\nlet parse_persistent_module_header_text = (raw: String) -> (Array[String], Array[String]) with { Error } {\n  let deps = Array::slice([\"\"], 0, 0)\n  let exports = Array::slice([\"\"], 0, 0)\n  let mut saw_version = false\n  let has_prefix = (line: String, prefix: String) -> Bool {\n    let prefix_len = String::length(prefix)\n    if String::length(line) < prefix_len {\n      false\n    } else {\n      let mut ok = true\n      let mut i = 0\n      while ok && i < prefix_len {\n        ok = String::char_code_at(line, i) == String::char_code_at(prefix, i)\n        i = i + 1\n      }\n      ok\n    }\n  }\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(String::substring(raw, line_start, i))\n      if String::length(line) > 0 {\n        if has_prefix(line, \"version\\t\") {\n          let value = String::substring(line, 8, String::length(line))\n          if !(String::equals(value, \"1\")) {\n            throw(\"invalid persistent module header version\")\n          }\n          saw_version = true\n        } else if has_prefix(line, \"dep\\t\") {\n          let value = String::substring(line, 4, String::length(line))\n          if String::length(value) == 0 {\n            throw(\"invalid persistent module header dep row\")\n          }\n          Array::push(deps, value)\n        } else if has_prefix(line, \"export\\t\") {\n          let value = String::substring(line, 7, String::length(line))\n          if String::length(value) == 0 {\n            throw(\"invalid persistent module header export row\")\n          }\n          Array::push(exports, value)\n        } else {\n          throw(String::concat(\"invalid persistent module header row: \", line))\n        }\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  let line = strip_trailing_cr(String::substring(raw, line_start, len))\n  if String::length(line) > 0 {\n    if has_prefix(line, \"version\\t\") {\n      let value = String::substring(line, 8, String::length(line))\n      if !(String::equals(value, \"1\")) {\n        throw(\"invalid persistent module header version\")\n      }\n      saw_version = true\n    } else if has_prefix(line, \"dep\\t\") {\n      let value = String::substring(line, 4, String::length(line))\n      if String::length(value) == 0 {\n        throw(\"invalid persistent module header dep row\")\n      }\n      Array::push(deps, value)\n    } else if has_prefix(line, \"export\\t\") {\n      let value = String::substring(line, 7, String::length(line))\n      if String::length(value) == 0 {\n        throw(\"invalid persistent module header export row\")\n      }\n      Array::push(exports, value)\n    } else {\n      throw(String::concat(\"invalid persistent module header row: \", line))\n    }\n  }\n  if !saw_version {\n    throw(\"missing persistent module header version\")\n  } else {\n    (deps, exports)\n  }\n}\n\nlet collect_import_deps_from_stmts = (stmts: Array[Stmt], base_dir: String) -> Array[String] {\n  let deps = Array::slice([\"\"], 0, 0)\n  let mut i = 0\n  while i < Array::length(stmts) {\n    match Array::get(stmts, i) {\n      SImport(raw_path, _) => Array::push(deps, resolve_path(base_dir, raw_path)),\n      SReExport(raw_path, _) => Array::push(deps, resolve_path(base_dir, raw_path)),\n      _ => ()\n    }\n    i = i + 1\n  }\n  deps\n}\n\nexport let load_or_parse_module_header_fs = (\n  path: String,\n  source: String,\n  parse_count: Int\n) -> (Array[String], Array[String], Int) with { Error, Fs } {\n  let cache_path = persistent_module_header_cache_path(path, compact_string_fingerprint(source))\n  if Fs::exists(cache_path) {\n    let (deps, exports) = parse_persistent_module_header_text(\n      normalize_persistent_cache_text(Fs::read_file(cache_path))\n    )\n    (deps, exports, parse_count)\n  } else {\n    let (deps, exports, next_parse_count) = match special_bundle_header(path) {\n      Some((deps, exports)) => (deps, exports, parse_count),\n      None => {\n        let stmts = parse_program(lex(source))\n        (\n          collect_import_deps_from_stmts(stmts, dir_of(path)),\n          collect_exports(stmts),\n          parse_count + 1\n        )\n      }\n    }\n    Fs::write_file(cache_path, persistent_module_header_text(deps, exports))\n    (deps, exports, next_parse_count)\n  }\n}\n\nlet store_persistent_manifest_header_cache = (\n  entry_path: String,\n  manifest_path: String,\n  rows: Array[(String, String, String, String)]\n) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_manifest_header_cache_path(entry_path),\n    build_persistent_manifest_header_cache_text(manifest_path, rows)\n  )\n}\n\nlet store_persistent_sources_cache = (\n  entry_path: String,\n  manifest_path: Option[String],\n  sources: Array[(String, String)]\n) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_source_list_cache_path(entry_path),\n    build_persistent_sources_cache_text(manifest_path, sources)\n  )\n}\n\nlet store_persistent_source_groups_cache = (\n  entry_path: String,\n  manifest_path: Option[String],\n  groups: Array[(String, Array[(String, String)])]\n) -> Unit with { Error, Fs } {\n  Fs::write_file(\n    persistent_source_group_cache_path(entry_path),\n    build_persistent_source_groups_cache_text(manifest_path, groups)\n  )\n}\n\nlet empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet rec collect_needed_paths_rec = (\n  path: String,\n  preloaded_sources: Array[(String, String)],\n  visited: Array[String]\n) -> Unit with { Error, Fs } {\n  if contains_str(visited, path) {\n    ()\n  } else {\n    Array::push(visited, path)\n    let source = match source_lookup(preloaded_sources, path) {\n      Some(preloaded) => preloaded,\n      None => Fs::read_file(path)\n    }\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    let mut i = 0\n    while i < Array::length(deps) {\n      collect_needed_paths_rec(Array::get(deps, i), preloaded_sources, visited)\n      i = i + 1\n    }\n  }\n}\n\nlet manifest_header_deps_lookup = (\n  rows: Array[(String, String, String, String)],\n  path: String\n) -> Option[Array[String]] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let (row_path, _, _, deps_text) = Array::get(rows, i)\n    if String::equals(row_path, path) {\n      found = Some(split_header_values(deps_text))\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet manifest_header_row_for_path = (\n  rows: Array[(String, String, String, String)],\n  path: String\n) -> Option[(String, String, String, String)] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(rows) {\n    let row = Array::get(rows, i)\n    let (row_path, _, _, _) = row\n    if String::equals(row_path, path) {\n      found = Some(row)\n      i = Array::length(rows)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet append_manifest_header_row_if_missing = (\n  rows: Array[(String, String, String, String)],\n  row: (String, String, String, String)\n) -> Unit {\n  let (path, _, _, _) = row\n  match manifest_header_row_for_path(rows, path) {\n    Some(_) => (),\n    None => Array::push(rows, row)\n  }\n}\n\nlet collect_needed_paths_from_manifest_headers = (\n  path: String,\n  preloaded_sources: Array[(String, String)],\n  rows: Array[(String, String, String, String)]\n) -> Array[String] with { Error, Fs } {\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = Array::slice([\"\"], 0, 0)\n  Array::push(worklist, path)\n  Array::push(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_str(visited, current)) {\n      Array::push(visited, current)\n      let deps = match manifest_header_deps_lookup(rows, current) {\n        Some(found) => found,\n        None => {\n          let source = match source_lookup(preloaded_sources, current) {\n            Some(preloaded) => preloaded,\n            None => Fs::read_file(current)\n          }\n          let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n          fallback_deps\n        }\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if !(contains_str(scheduled, dep_path)) {\n          Array::push(worklist, dep_path)\n          Array::push(scheduled, dep_path)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n    }\n    work_i = work_i + 1\n  }\n  visited\n}\n\nlet collect_needed_paths_and_manifest_headers = (\n  path: String,\n  preloaded_sources: Array[(String, String)]\n) -> (Array[(String, String, String, String)], Array[String]) with { Error, Fs } {\n  let rows = empty_manifest_header_cache_rows()\n  let visited = Array::slice([\"\"], 0, 0)\n  let worklist = Array::slice([\"\"], 0, 0)\n  let scheduled = Array::slice([\"\"], 0, 0)\n  Array::push(worklist, path)\n  Array::push(scheduled, path)\n  let mut work_len = 1\n  let mut work_i = 0\n  loop {\n    if work_i >= work_len {\n      break\n    }\n    let current = Array::get(worklist, work_i)\n    if !(contains_str(visited, current)) {\n      if work_i == 0 {\n        Fs::write_file(\"_build/collect_manifest_helper_first_current.txt\", current)\n      }\n      Array::push(visited, current)\n      let source = match source_lookup(preloaded_sources, current) {\n        Some(preloaded) => {\n          if work_i == 0 {\n            Fs::write_file(\"_build/collect_manifest_helper_first_source_lookup.txt\", \"1\")\n          }\n          preloaded\n        },\n        None => {\n          if work_i == 0 {\n            Fs::write_file(\"_build/collect_manifest_helper_first_source_lookup.txt\", \"0\")\n          }\n          Fs::read_file(current)\n        }\n      }\n      let deps = match manifest_header_deps_lookup(rows, current) {\n        Some(found) => found,\n        None => {\n          let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n          append_manifest_header_row_if_missing(\n            rows,\n            (\n              current,\n              __to_string(Fs::stat_token(current)),\n              compact_string_fingerprint(source),\n              join_header_values(parsed_deps)\n            )\n          )\n          parsed_deps\n        }\n      }\n      if work_i == 0 {\n        Fs::write_file(\"_build/collect_manifest_helper_first_rows_len.txt\", __to_string(Array::length(rows)))\n        Fs::write_file(\"_build/collect_manifest_helper_first_deps_len.txt\", __to_string(Array::length(deps)))\n      }\n      let mut dep_i = 0\n      while dep_i < Array::length(deps) {\n        let dep_path = Array::get(deps, dep_i)\n        if !(contains_str(scheduled, dep_path)) {\n          Array::push(worklist, dep_path)\n          Array::push(scheduled, dep_path)\n          work_len = work_len + 1\n        }\n        dep_i = dep_i + 1\n      }\n      if work_i == 0 {\n        Fs::write_file(\"_build/collect_manifest_helper_first_work_len.txt\", __to_string(work_len))\n      }\n    }\n    work_i = work_i + 1\n  }\n  Fs::write_file(\"_build/collect_manifest_helper_final_rows_len.txt\", __to_string(Array::length(rows)))\n  Fs::write_file(\"_build/collect_manifest_helper_final_visited_len.txt\", __to_string(Array::length(visited)))\n  Fs::write_file(\"_build/collect_manifest_helper_final_work_i.txt\", __to_string(work_i))\n  Fs::write_file(\"_build/collect_manifest_helper_final_work_len.txt\", __to_string(work_len))\n  (rows, visited)\n}\n\nlet push_grouped_source = (\n  groups: Array[(String, Array[(String, String)])],\n  group_name: String,\n  path: String,\n  source: String\n) -> Unit {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if String::equals(name, group_name) {\n      Array::push(sources, (path, source))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(sources, (path, source))\n    Array::push(groups, (group_name, sources))\n  }\n}\n\nlet try_load_manifest_rows = (entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  let base_dir = dir_of(entry_path)\n  let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n  if !(Fs::exists(manifest_path)) {\n    None\n  } else {\n    let rows = parse_source_manifest_rows(Fs::read_file(manifest_path))\n    let mut has_entry = false\n    let mut i = 0\n    while i < Array::length(rows) {\n      let (_, rel_path) = Array::get(rows, i)\n      let path = join_path(base_dir, rel_path)\n      if String::equals(path, entry_path) {\n        has_entry = true\n      }\n      i = i + 1\n    }\n    if has_entry {\n      Some((base_dir, rows))\n    } else {\n      None\n    }\n  }\n}\n\nlet load_manifest_full_sources = (\n  base_dir: String,\n  rows: Array[(String, String)]\n) -> Array[(String, String)] with { Error, Fs } {\n  let full_sources = Array::slice([(\"\", \"\")], 0, 0)\n  let mut i = 0\n  while i < Array::length(rows) {\n    let (_, rel_path) = Array::get(rows, i)\n    let path = join_path(base_dir, rel_path)\n    Array::push(full_sources, (path, Fs::read_file(path)))\n    i = i + 1\n  }\n  full_sources\n}\n\nlet try_collect_manifest_sources_fs = (entry_path: String) -> Option[(String, Array[(String, String)])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n      let header_rows = match load_persistent_manifest_header_cache_if_valid(\n        entry_path,\n        manifest_path,\n        preloaded_sources\n      ) {\n        Some(cached_rows) => cached_rows,\n        None => {\n          let built_rows = empty_manifest_header_cache_rows()\n          let visited = Array::slice([\"\"], 0, 0)\n          let worklist = Array::slice([\"\"], 0, 0)\n          let scheduled = Array::slice([\"\"], 0, 0)\n          Array::push(worklist, entry_path)\n          Array::push(scheduled, entry_path)\n          let mut work_len = 1\n          let mut work_i = 0\n          loop {\n            if work_i >= work_len {\n              break\n            }\n            let current = Array::get(worklist, work_i)\n            if !(contains_str(visited, current)) {\n              Array::push(visited, current)\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let deps = match manifest_header_deps_lookup(built_rows, current) {\n                Some(found) => found,\n                None => {\n                  let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n                  append_manifest_header_row_if_missing(\n                    built_rows,\n                    (\n                      current,\n                      __to_string(Fs::stat_token(current)),\n                      compact_string_fingerprint(source),\n                      join_header_values(parsed_deps)\n                    )\n                  )\n                  parsed_deps\n                }\n              }\n              let mut dep_i = 0\n              while dep_i < Array::length(deps) {\n                let dep_path = Array::get(deps, dep_i)\n                if !(contains_str(scheduled, dep_path)) {\n                  Array::push(worklist, dep_path)\n                  Array::push(scheduled, dep_path)\n                  work_len = work_len + 1\n                }\n                dep_i = dep_i + 1\n              }\n            }\n            work_i = work_i + 1\n          }\n          store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n          built_rows\n        }\n      }\n      let needed_paths = Array::slice([\"\"], 0, 0)\n      let worklist = Array::slice([\"\"], 0, 0)\n      let scheduled = Array::slice([\"\"], 0, 0)\n      Array::push(worklist, entry_path)\n      Array::push(scheduled, entry_path)\n      let mut work_len = 1\n      let mut work_i = 0\n      loop {\n        if work_i >= work_len {\n          break\n        }\n        let current = Array::get(worklist, work_i)\n        if !(contains_str(needed_paths, current)) {\n          Array::push(needed_paths, current)\n          let deps = match manifest_header_deps_lookup(header_rows, current) {\n            Some(found) => found,\n            None => {\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n              fallback_deps\n            }\n          }\n          let mut dep_i = 0\n          while dep_i < Array::length(deps) {\n            let dep_path = Array::get(deps, dep_i)\n            if !(contains_str(scheduled, dep_path)) {\n              Array::push(worklist, dep_path)\n              Array::push(scheduled, dep_path)\n              work_len = work_len + 1\n            }\n            dep_i = dep_i + 1\n          }\n        }\n        work_i = work_i + 1\n      }\n      let sources = Array::slice([(\"\", \"\")], 0, 0)\n      let mut j = 0\n      while j < Array::length(preloaded_sources) {\n        let (path, source) = Array::get(preloaded_sources, j)\n        if contains_str(needed_paths, path) {\n          Array::push(sources, (path, source))\n        }\n        j = j + 1\n      }\n      Some((manifest_path, sources))\n    },\n    None => None\n  }\n}\n\nlet try_collect_manifest_source_groups_fs = (entry_path: String) -> Option[(String, Array[(String, Array[(String, String)])])] with { Error, Fs } {\n  match try_load_manifest_rows(entry_path) {\n    Some((base_dir, rows)) => {\n      let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n      let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n      let header_rows = match load_persistent_manifest_header_cache_if_valid(\n        entry_path,\n        manifest_path,\n        preloaded_sources\n      ) {\n        Some(cached_rows) => cached_rows,\n        None => {\n          let built_rows = empty_manifest_header_cache_rows()\n          let visited = Array::slice([\"\"], 0, 0)\n          let worklist = Array::slice([\"\"], 0, 0)\n          let scheduled = Array::slice([\"\"], 0, 0)\n          Array::push(worklist, entry_path)\n          Array::push(scheduled, entry_path)\n          let mut work_len = 1\n          let mut work_i = 0\n          loop {\n            if work_i >= work_len {\n              break\n            }\n            let current = Array::get(worklist, work_i)\n            if !(contains_str(visited, current)) {\n              Array::push(visited, current)\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let deps = match manifest_header_deps_lookup(built_rows, current) {\n                Some(found) => found,\n                None => {\n                  let (parsed_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n                  append_manifest_header_row_if_missing(\n                    built_rows,\n                    (\n                      current,\n                      __to_string(Fs::stat_token(current)),\n                      compact_string_fingerprint(source),\n                      join_header_values(parsed_deps)\n                    )\n                  )\n                  parsed_deps\n                }\n              }\n              let mut dep_i = 0\n              while dep_i < Array::length(deps) {\n                let dep_path = Array::get(deps, dep_i)\n                if !(contains_str(scheduled, dep_path)) {\n                  Array::push(worklist, dep_path)\n                  Array::push(scheduled, dep_path)\n                  work_len = work_len + 1\n                }\n                dep_i = dep_i + 1\n              }\n            }\n            work_i = work_i + 1\n          }\n          store_persistent_manifest_header_cache(entry_path, manifest_path, built_rows)\n          built_rows\n        }\n      }\n      let needed_paths = Array::slice([\"\"], 0, 0)\n      let worklist = Array::slice([\"\"], 0, 0)\n      let scheduled = Array::slice([\"\"], 0, 0)\n      Array::push(worklist, entry_path)\n      Array::push(scheduled, entry_path)\n      let mut work_len = 1\n      let mut work_i = 0\n      loop {\n        if work_i >= work_len {\n          break\n        }\n        let current = Array::get(worklist, work_i)\n        if !(contains_str(needed_paths, current)) {\n          Array::push(needed_paths, current)\n          let deps = match manifest_header_deps_lookup(header_rows, current) {\n            Some(found) => found,\n            None => {\n              let source = match source_lookup(preloaded_sources, current) {\n                Some(preloaded) => preloaded,\n                None => Fs::read_file(current)\n              }\n              let (fallback_deps, _, _) = load_or_parse_module_header_fs(current, source, 0)\n              fallback_deps\n            }\n          }\n          let mut dep_i = 0\n          while dep_i < Array::length(deps) {\n            let dep_path = Array::get(deps, dep_i)\n            if !(contains_str(scheduled, dep_path)) {\n              Array::push(worklist, dep_path)\n              Array::push(scheduled, dep_path)\n              work_len = work_len + 1\n            }\n            dep_i = dep_i + 1\n          }\n        }\n        work_i = work_i + 1\n      }\n      let groups = empty_grouped_sources()\n      let mut j = 0\n      while j < Array::length(rows) {\n        let (group_name, rel_path) = Array::get(rows, j)\n        let path = join_path(base_dir, rel_path)\n        if contains_str(needed_paths, path) {\n          match source_lookup(preloaded_sources, path) {\n            Some(source) => push_grouped_source(groups, group_name, path, source),\n            None => ()\n          }\n        }\n        j = j + 1\n      }\n      Some((manifest_path, groups))\n    },\n    None => None\n  }\n}\n\n//# Helper functions\n\n// Cache lookup helper\nlet cache_lookup = (cache: Array[(String, TypeEnv)], path: String) -> Option[TypeEnv] {\n  let len = Array::length(cache)\n  let mut i = 0\n  let mut result = None\n  let mut done = false\n  while i < len {\n    if done {\n      i = len\n    } else {\n      let (p, e) = Array::get(cache, i)\n      if String::equals(p, path) {\n        result = Some(e)\n        done = true\n      }\n      i = i + 1\n    }\n  }\n  result\n}\n\nlet export_marker_name = (name: String) -> String {\n  String::concat(\"__vibe_internal_export__:\", name)\n}\n\nlet env_has_export_marker = (env: TypeEnv, name: String) -> Bool {\n  match env_lookup(env, export_marker_name(name)) {\n    Some(_) => true,\n    None => false\n  }\n}\n\nlet bind_export_markers = (env: TypeEnv, exports: Array[String]) -> TypeEnv {\n  let mut acc = env\n  let mut i = 0\n  while i < Array::length(exports) {\n    acc = env_bind(acc, export_marker_name(Array::get(exports, i)), CtUnit)\n    i = i + 1\n  }\n  acc\n}\n\n// Bind imported names from a checked module's env\nlet rec bind_checked_imports = (\n  names: Array[(String, Option[String])],\n  i: Int,\n  env: TypeEnv,\n  mod_env: TypeEnv\n) -> TypeEnv {\n  if i >= Array::length(names) {\n    env\n  } else {\n    let (name, alias) = Array::get(names, i)\n    let bound_name = match alias {\n      Some(a) => a,\n      None => name\n    }\n    let new_env = if env_has_export_marker(mod_env, name) {\n      match env_lookup(mod_env, name) {\n        Some(ty) => env_bind(env, bound_name, ty),\n        None => env\n      }\n    } else {\n      env\n    }\n    bind_checked_imports(names, i + 1, new_env, mod_env)\n  }\n}\n\n//# Module Loader\n\n// Check a module and return its TypeEnv, resolving imports recursively.\n// resolve_imports is inlined to avoid mutual recursion (vibe has no forward references).\nexport let rec check_module = (\n  source: String,\n  path: String,\n  sources: Array[(String, String)],\n  loading: Array[String],\n  checked_cache: Array[(String, TypeEnv)]\n) -> TypeEnv with { Error } {\n  // Check cache first\n  let cached = cache_lookup(checked_cache, path)\n  match cached {\n    Some(env) => env,\n    None => {\n      // Cycle detection\n      if contains_str(loading, path) {\n        throw(String::concat(\"import cycle detected: \", path))\n      }\n      let tokens = lex(source)\n      let stmts = parse_program(tokens)\n      let base_dir = dir_of(path)\n      let new_loading = Array::concat(loading, [path])\n\n      // Resolve imports using while loop\n      let mut import_env = EnvEmpty\n      let mut ri = 0\n      while ri < Array::length(stmts) {\n        let stmt = Array::get(stmts, ri)\n        import_env = match stmt {\n          SImport(raw_path, names) => {\n            let resolved = resolve_path(base_dir, raw_path)\n            match source_lookup(sources, resolved) {\n              None => throw(String::concat(\"module not found: \", resolved)),\n              Some(mod_source) => {\n                // Recursively check the imported module\n                let mod_env = check_module(mod_source, resolved, sources, new_loading, checked_cache)\n                // Bind exported names into current env\n                bind_checked_imports(names, 0, import_env, mod_env)\n              }\n            }\n          },\n          _ => import_env\n        }\n        ri = ri + 1\n      }\n\n      // Type-check with imported env\n      let empty_defs = Array::slice([TDAlias(\"_dummy\", CtUnit)], 0, 0)\n      let (env, _, _) = check_stmts(stmts, 0, import_env, empty_defs, SubstEmpty, 0)\n\n      // Cache result\n      let cached_env = bind_export_markers(env, collect_exports(stmts))\n      Array::push(checked_cache, (path, cached_env))\n      cached_env\n    }\n  }\n}\n\n//# FS-based source collection\n\nlet rec collect_sources_rec = (\n  path: String,\n  sources: Array[(String, String)],\n  visited: Array[String]\n) -> Unit with { Error, Fs } {\n  if contains_str(visited, path) {\n    ()\n  }\n  else {\n    Array::push(visited, path)\n    let source = Fs::read_file(path)\n    let (deps, _, _) = load_or_parse_module_header_fs(path, source, 0)\n    // First, recurse into dependencies (imports and re-exports)\n    let mut i = 0\n    while i < Array::length(deps) {\n      collect_sources_rec(Array::get(deps, i), sources, visited)\n      i = i + 1\n    }\n    // Then add this module (dependencies come first)\n    Array::push(sources, (path, source))\n  }\n}\n\n// Recursively collect all source files from filesystem, following imports and re-exports.\n// Returns Array[(path, source)] in dependency order (dependencies first).\nexport let collect_all_sources_fs = (entry_path: String) -> Array[(String, String)] with { Error, Fs } {\n  match load_persistent_sources_cache_if_valid(entry_path) {\n    Some(sources) => sources,\n    None =>\n      match load_persistent_sources_from_group_cache_if_valid(entry_path) {\n        Some((manifest_path, sources)) => {\n          store_persistent_sources_cache(entry_path, manifest_path, sources)\n          sources\n        },\n        None =>\n      match try_load_manifest_rows(entry_path) {\n        Some((base_dir, rows)) => {\n          let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n          let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n          store_persistent_sources_cache(entry_path, Some(manifest_path), preloaded_sources)\n          preloaded_sources\n        },\n        None => {\n          let sources = Array::slice([(\"\", \"\")], 0, 0)\n          let visited = Array::slice([\"\"], 0, 0)\n          collect_sources_rec(entry_path, sources, visited)\n          store_persistent_sources_cache(entry_path, None, sources)\n          sources\n        }\n      }\n      }\n  }\n}\n\nexport let collect_source_groups_fs = (entry_path: String) -> Array[(String, Array[(String, String)])] with { Error, Fs } {\n  match load_persistent_source_groups_cache_if_valid(entry_path) {\n    Some(groups) => groups,\n    None =>\n      match load_persistent_source_groups_from_source_list_cache_if_valid(entry_path) {\n        Some((manifest_path, groups)) => {\n          store_persistent_source_groups_cache(entry_path, manifest_path, groups)\n          groups\n        },\n        None =>\n      match try_load_manifest_rows(entry_path) {\n        Some((base_dir, rows)) => {\n          let manifest_path = join_path(base_dir, \"selfhost_sources_manifest.tsv\")\n          let preloaded_sources = load_manifest_full_sources(base_dir, rows)\n          let groups = empty_grouped_sources()\n          let mut j = 0\n          while j < Array::length(rows) {\n            let (group_name, rel_path) = Array::get(rows, j)\n            let path = join_path(base_dir, rel_path)\n            match source_lookup(preloaded_sources, path) {\n              Some(source) => push_grouped_source(groups, group_name, path, source),\n              None => ()\n            }\n            j = j + 1\n          }\n          store_persistent_source_groups_cache(entry_path, Some(manifest_path), groups)\n          groups\n        },\n        None => {\n          let groups = empty_grouped_sources()\n          Array::push(groups, (\"recursive\", collect_all_sources_fs(entry_path)))\n          store_persistent_source_groups_cache(entry_path, None, groups)\n          groups\n        }\n      }\n      }\n  }\n}\n\n//# Module bundling — merge stmts from all modules in dependency order\n\n// Given all sources (in dependency order), parse and merge their statements.\n// Skips SImport, SReExport (already resolved). Keeps all definitions.\nexport let collect_merged_stmts = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = Array::slice([SExport([\"_dummy\"])], 0, 0)\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, src) = Array::get(sources, si)\n    let stmts = load_and_parse(src)\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        _ => Array::push(merged, stmt)\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n")

  let source_60 = ("vibe/compiler/module_loader.vibe",
"//# Imports\n\nexport ./loader {\n  check_module, collect_all_sources_fs, collect_merged_stmts, collect_source_groups_fs,\n  load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\n//# Misc\n\nexport {\n  check_module, collect_merged_stmts, collect_all_sources_fs, collect_source_groups_fs,\n  load_or_parse_module_header_fs, load_persistent_source_group_fingerprint_if_valid\n}\n")

  let source_61 = ("vibe/compiler/entry/source_compile/index.vibe",
"//# Imports\n\nimport ../../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../checker/checker_stmt.vibe {\n  check_program\n}\n\nimport ../../codegen/index.vibe {\n  compile_module\n}\n\nimport ../../codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\nimport ../../core/dce.vibe {\n  dce_stmts\n}\n\n//# Functions\n\nexport let compile_source = (source: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_module(stmts)\n}\n\nexport let compile_source_wasi = (source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n\nexport let compile_source_wasi_mode = (source: String, entry_name: String, mode: String) -> Bytes with { Error } {\n  if String::equals(mode, \"mvp\") {\n    let tokens = lex(source)\n    let stmts = parse_program(tokens)\n    let _ = check_program(stmts)\n    let pruned_stmts = dce_stmts(stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if String::equals(mode, \"no-dce\") {\n    compile_source_wasi(source, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n")

  let source_62 = ("vibe/compiler/entry/source_compile/wasi_only/index.vibe",
"//# Imports\n\nimport ../../../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../../checker/checker_stmt.vibe {\n  check_program\n}\n\nimport ../../../codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\n//# Functions\n\nexport let compile_source_wasi_only = (source: String, entry_name: String) -> Bytes with { Error } {\n  let tokens = lex(source)\n  let stmts = parse_program(tokens)\n  let _ = check_program(stmts)\n  compile_wasi_module_impl(stmts, entry_name)\n}\n")

  let source_63 = ("vibe/compiler/entry/compiler/index.vibe",
"import ../source_compile/index.vibe {\n  compile_source,\n  compile_source_wasi\n}\n\nimport ./fs_compile/index.vibe {\n  prepare_modules_cached,\n  compile_with_modules,\n  compile_with_modules_wasi,\n  compile_with_modules_cached,\n  compile_with_modules_wasi_cached,\n  compile_with_closure_sources_wasi_cached,\n  compile_with_closure_sources_wasi_mode_cached,\n  compile_with_source_groups_wasi_cached,\n  compile_with_source_groups_wasi_unchecked_cached\n}\n\nimport ./file_compile/index.vibe {\n  compile_file_fs,\n  compile_file_fs_mode,\n  compile_file_fs_module,\n  prepare_file_fs_cached,\n  compile_file_fs_cached,\n  compile_file_fs_mode_cached,\n  compile_file_fs_module_cached\n}\n\nexport {\n  compile_source,\n  compile_source_wasi,\n  prepare_modules_cached,\n  compile_with_modules,\n  compile_with_modules_wasi,\n  compile_with_modules_cached,\n  compile_with_modules_wasi_cached,\n  compile_with_closure_sources_wasi_cached,\n  compile_with_closure_sources_wasi_mode_cached,\n  compile_with_source_groups_wasi_cached,\n  compile_with_source_groups_wasi_unchecked_cached,\n  compile_file_fs,\n  compile_file_fs_mode,\n  compile_file_fs_module,\n  prepare_file_fs_cached,\n  compile_file_fs_cached,\n  compile_file_fs_mode_cached,\n  compile_file_fs_module_cached\n}\n")

  let source_64 = ("vibe/compiler/entry/compiler/fs_compile/index.vibe",
"//# Imports\n\nimport ../../../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../../core/ast.vibe {\n  Stmt\n}\n\nimport ../../../codegen/index.vibe {\n  compile_module, compile_wasi_module\n}\n\nimport ../../../codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\nimport ../../../checker/checker_stmt.vibe {\n  check_program\n}\n\nimport ../../../core/index.vibe {\n  dce_stmts\n}\n\nimport ../../../loader/index.vibe {\n  collect_all_sources_fs, collect_source_groups_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\nimport ../../../runtime/index.vibe {\n  TypeDb, db_new, db_set_source, db_typecheck, db_typecheck_fs, db_merged_source,\n  db_grouped_merged_source, db_module_source, db_load_artifact, db_store_artifact\n}\n\nimport ../../../cache/persistent/index.vibe {\n  build_fs_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_fs_compile_module_artifact_fingerprint,\n  build_fs_compile_wasi_artifact_fingerprint,\n  load_persistent_artifact,\n  store_persistent_artifact\n}\n\n//# Functions\n\nlet contains_str = (arr: Array[String], target: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(arr) && !found {\n    if String::equals(Array::get(arr, i), target) {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet source_lookup = (sources: Array[(String, String)], path_key: String) -> Option[String] {\n  let mut i = 0\n  let mut found = None\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    if String::equals(path, path_key) {\n      found = Some(source)\n      i = Array::length(sources)\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet dir_of = (file_path: String) -> String {\n  let idx = String::last_index_of(file_path, \"/\")\n  if idx < 0 {\n    \"\"\n  } else {\n    String::substring(file_path, 0, idx)\n  }\n}\n\nlet split_path_segments = (path: String) -> Array[String] {\n  let segments = Array::slice([\"\"], 0, 0)\n  let len = String::length(path)\n  let mut start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(path, i) == 47 {\n      Array::push(segments, String::substring(path, start, i))\n      start = i + 1\n    }\n    i = i + 1\n  }\n  segments\n}\n\nlet join_path_segments = (segments: Array[String]) -> String {\n  let mut out = \"\"\n  let mut i = 0\n  while i < Array::length(segments) {\n    let seg = Array::get(segments, i)\n    if String::length(seg) > 0 {\n      out = if String::equals(out, \"\") {\n        seg\n      } else {\n        String::concat(out, String::concat(\"/\", seg))\n      }\n    }\n    i = i + 1\n  }\n  out\n}\n\nlet normalize_path = (path: String) -> String {\n  let raw_segments = split_path_segments(path)\n  let normalized = Array::slice([\"\"], 0, 0)\n  let mut i = 0\n  while i < Array::length(raw_segments) {\n    let seg = Array::get(raw_segments, i)\n    if String::length(seg) == 0 || String::equals(seg, \".\") {\n      ()\n    } else if String::equals(seg, \"..\") {\n      let norm_len = Array::length(normalized)\n      if norm_len > 0 {\n        Array::truncate(normalized, norm_len - 1)\n      }\n    } else {\n      Array::push(normalized, seg)\n    }\n    i = i + 1\n  }\n  join_path_segments(normalized)\n}\n\nlet resolve_path = (base_dir: String, raw_path: String) -> String {\n  let len = String::length(raw_path)\n  if len >= 3 {\n    if String::equals(String::substring(raw_path, 0, 3), \"../\") {\n      let rest = String::substring(raw_path, 3, len)\n      let parent = dir_of(base_dir)\n      let resolved = if String::ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        String::concat(rest, \".vibe\")\n      }\n      if String::equals(parent, \"\") {\n        normalize_path(resolved)\n      } else {\n        normalize_path(String::concat(parent, String::concat(\"/\", resolved)))\n      }\n    } else if String::equals(String::substring(raw_path, 0, 2), \"./\") {\n      let rest = String::substring(raw_path, 2, len)\n      let resolved = if String::ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        String::concat(rest, \".vibe\")\n      }\n      if String::equals(base_dir, \"\") {\n        normalize_path(resolved)\n      } else {\n        normalize_path(String::concat(base_dir, String::concat(\"/\", resolved)))\n      }\n    } else {\n      normalize_path(raw_path)\n    }\n  } else if len >= 2 {\n    if String::equals(String::substring(raw_path, 0, 2), \"./\") {\n      let rest = String::substring(raw_path, 2, len)\n      let resolved = if String::ends_with(rest, \".vibe\") {\n        rest\n      } else {\n        String::concat(rest, \".vibe\")\n      }\n      if String::equals(base_dir, \"\") {\n        normalize_path(resolved)\n      } else {\n        normalize_path(String::concat(base_dir, String::concat(\"/\", resolved)))\n      }\n    } else {\n      normalize_path(raw_path)\n    }\n  } else {\n    normalize_path(raw_path)\n  }\n}\n\nlet rec collect_inline_sources = (\n  path: String,\n  source: String,\n  sources: Array[(String, String)],\n  ordered: Array[(String, String)],\n  visited: Array[String]\n) -> Unit with { Error } {\n  if contains_str(visited, path) {\n    ()\n  } else {\n    Array::push(visited, path)\n    let stmts = parse_program(lex(source))\n    let base_dir = dir_of(path)\n    let mut i = 0\n    while i < Array::length(stmts) {\n      match Array::get(stmts, i) {\n        SImport(raw_path, _) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          match source_lookup(sources, resolved) {\n            Some(dep_source) => collect_inline_sources(resolved, dep_source, sources, ordered, visited),\n            None => throw(String::concat(\"module not found: \", resolved))\n          }\n        },\n        SReExport(raw_path, _) => {\n          let resolved = resolve_path(base_dir, raw_path)\n          match source_lookup(sources, resolved) {\n            Some(dep_source) => collect_inline_sources(resolved, dep_source, sources, ordered, visited),\n            None => throw(String::concat(\"module not found: \", resolved))\n          }\n        },\n        _ => ()\n      }\n      i = i + 1\n    }\n    Array::push(ordered, (path, source))\n  }\n}\n\nlet collect_inline_sources_ordered = (\n  main_path: String,\n  main_source: String,\n  sources: Array[(String, String)]\n) -> Array[(String, String)] with { Error } {\n  let ordered = Array::slice([(\"\", \"\")], 0, 0)\n  let visited = Array::slice([\"\"], 0, 0)\n  collect_inline_sources(main_path, main_source, sources, ordered, visited)\n  ordered\n}\n\nlet empty_stmt_array = () -> Array[Stmt] {\n  Array::slice([\n    SExport([\"_dummy\"])\n  ], 0, 0)\n}\n\nlet seed_type_db = (db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb {\n  let mut seeded = db\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (path, source) = Array::get(sources, i)\n    seeded = db_set_source(seeded, path, source)\n    i = i + 1\n  }\n  db_set_source(seeded, main_path, main_source)\n}\n\nlet flatten_source_groups = (source_groups: Array[(String, Array[(String, String)])]) -> Array[(String, String)] {\n  let flat = Array::slice([(\"\", \"\")], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      Array::push(flat, Array::get(sources, si))\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  flat\n}\n\nlet normalize_source_groups = (\n  source_groups: Array[(String, Array[(String, String)])],\n  main_path: String,\n  main_source: String\n) -> Array[(String, Array[(String, String)])] {\n  let normalized = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut found = false\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      if String::equals(path, main_path) {\n        Array::push(next_sources, (path, main_source))\n        found = true\n      } else {\n        Array::push(next_sources, (path, source))\n      }\n      si = si + 1\n    }\n    Array::push(normalized, (group_name, next_sources))\n    gi = gi + 1\n  }\n  if !found {\n    let entry_sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(entry_sources, (main_path, main_source))\n    Array::push(normalized, (\"entry\", entry_sources))\n  }\n  normalized\n}\n\nlet contains_source_path = (sources: Array[(String, String)], target_path: String) -> Bool {\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(sources) && !found {\n    let (path, _) = Array::get(sources, i)\n    if String::equals(path, target_path) {\n      found = true\n    } else {\n      i = i + 1\n    }\n  }\n  found\n}\n\nlet filter_source_groups = (\n  source_groups: Array[(String, Array[(String, String)])],\n  ordered_sources: Array[(String, String)]\n) -> Array[(String, Array[(String, String)])] {\n  let filtered_groups = Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (group_name, sources) = Array::get(source_groups, gi)\n    let next_sources = Array::slice([(\"\", \"\")], 0, 0)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let pair = Array::get(sources, si)\n      let (path, _) = pair\n      if contains_source_path(ordered_sources, path) {\n        Array::push(next_sources, pair)\n      }\n      si = si + 1\n    }\n    if Array::length(next_sources) > 0 {\n      Array::push(filtered_groups, (group_name, next_sources))\n    }\n    gi = gi + 1\n  }\n  filtered_groups\n}\n\nexport let source_group_total_source_count = (\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int {\n  let mut total = 0\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    total = total + Array::length(sources)\n    gi = gi + 1\n  }\n  total\n}\n\nexport let source_group_ordered_source_count = (\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  Array::length(ordered_sources)\n}\n\nexport let source_group_filtered_group_count = (\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  Array::length(filtered_groups)\n}\n\nexport let prepare_modules_cached = (db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with { Error } {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck(seeded, main_path)\n}\n\nlet prepare_modules_persistent_fs_cached = (db: TypeDb, main_path: String, main_source: String, sources: Array[(String, String)]) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db(db, main_path, main_source, sources)\n  db_typecheck_fs(seeded, main_path)\n}\n\nexport let source_group_prepare_typecheck_count = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  db_typecheck_count(next_db)\n}\n\nexport let grouped_source_merged_len = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, _, _) = db_grouped_merged_source(next_db, filtered_groups)\n  String::length(merged_source)\n}\n\nexport let source_group_module_source_len = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, _) = db_module_source(module_db, merge_fingerprint, merged_source)\n  String::length(module_source)\n}\n\nexport let compile_with_modules = (main_source: String, main_path: String, sources: Array[(String, String)]) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_modules_cached(db_new(), main_source, main_path, sources)\n  bytes\n}\n\nexport let compile_with_modules_wasi = (main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> Bytes with { Error } {\n  let (bytes, _) = compile_with_modules_wasi_cached(db_new(), main_source, main_path, sources, entry_name)\n  bytes\n}\n\nlet artifact_fingerprint_from_source = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet build_merge_fingerprint_inline = (sources: Array[(String, String)]) -> String {\n  let mut acc = \"merged\"\n  let mut i = 0\n  while i < Array::length(sources) {\n    let (_, source) = Array::get(sources, i)\n    let next = String::concat(\n      acc,\n      String::concat(\"|\", artifact_fingerprint_from_source(source))\n    )\n    acc = artifact_fingerprint_from_source(next)\n    i = i + 1\n  }\n  acc\n}\n\nlet build_merged_stmts_inline = (sources: Array[(String, String)]) -> Array[Stmt] with { Error } {\n  let merged = empty_stmt_array()\n  let mut si = 0\n  while si < Array::length(sources) {\n    let (_, source) = Array::get(sources, si)\n    let stmts = parse_program(lex(source))\n    let mut j = 0\n    while j < Array::length(stmts) {\n      let stmt = Array::get(stmts, j)\n      match stmt {\n        SImport(_, _) => (),\n        SReExport(_, _) => (),\n        _ => Array::push(merged, stmt),\n      }\n      j = j + 1\n    }\n    si = si + 1\n  }\n  merged\n}\n\nlet prune_entry_stmts = (stmts: Array[Stmt], entry_name: String) -> Array[Stmt] {\n  dce_stmts(stmts, [entry_name])\n}\n\nexport let closure_ordered_source_count = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)]\n) -> Int with { Error } {\n  Array::length(collect_inline_sources_ordered(main_path, main_source, sources))\n}\n\nexport let closure_merged_stmt_count = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)]\n) -> Int with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  Array::length(merged_stmts)\n}\n\nexport let closure_pruned_stmt_count = (\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String\n) -> Int with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merged_stmts = build_merged_stmts_inline(ordered_sources)\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport let source_group_pruned_stmt_count = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> Int with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, _, _) = db_grouped_merged_source(db, filtered_groups)\n  let merged_stmts = parse_program(lex(merged_source))\n  let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n  Array::length(pruned_stmts)\n}\n\nexport let compile_with_modules_cached = (db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)]) -> (Bytes, TypeDb) with { Error } {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_merged_source(next_db, main_path, ordered_sources)\n  let (module_source, codegen_db) = db_module_source(merge_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n  match db_load_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let stmts = parse_program(lex(module_source))\n      let bytes = compile_module(stmts)\n      (bytes, db_store_artifact(codegen_db, main_path, \"module\", \"\", artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_modules_wasi_cached = (db: TypeDb, main_source: String, main_path: String, sources: Array[(String, String)], entry_name: String) -> (Bytes, TypeDb) with { Error } {\n  let next_db = prepare_modules_cached(db, main_path, main_source, sources)\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(next_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_mode_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String,\n  mode: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let next_db = prepare_modules_cached(db, main_path, main_source, ordered_sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_kind = if String::equals(mode, \"mvp\") {\n    \"wasi-mvp\"\n  } else if String::equals(mode, \"no-dce\") {\n    \"wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", String::concat(entry_name, String::concat(\"|\", mode))))\n  )\n  match db_load_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, next_db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let bytes = if String::equals(mode, \"mvp\") {\n        let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n        compile_wasi_module_impl(pruned_stmts, entry_name)\n      } else {\n        compile_wasi_module(merged_stmts, entry_name)\n      }\n      (bytes, db_store_artifact(next_db, main_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_closure_sources_wasi_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  sources: Array[(String, String)],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let ordered_sources = collect_inline_sources_ordered(main_path, main_source, sources)\n  let merge_fingerprint = build_merge_fingerprint_inline(ordered_sources)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let merged_stmts = build_merged_stmts_inline(ordered_sources)\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_wasi_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let next_db = prepare_modules_cached(\n    db,\n    main_path,\n    main_source,\n    ordered_sources\n  )\n  let (merged_source, merge_fingerprint, codegen_db) = db_grouped_merged_source(next_db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_wasi_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, merge_db) = db_grouped_merged_source(db, filtered_groups)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(merge_fingerprint, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, merge_db),\n    None => {\n      let merged_stmts = parse_program(lex(merged_source))\n      let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(merge_db, main_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_with_source_groups_via_module_source_wasi_unchecked_cached = (\n  db: TypeDb,\n  main_source: String,\n  main_path: String,\n  source_groups: Array[(String, Array[(String, String)])],\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error } {\n  let normalized_groups = normalize_source_groups(source_groups, main_path, main_source)\n  let ordered_sources = collect_inline_sources_ordered(\n    main_path,\n    main_source,\n    flatten_source_groups(normalized_groups)\n  )\n  let filtered_groups = filter_source_groups(normalized_groups, ordered_sources)\n  let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(db, filtered_groups)\n  let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n  let artifact_fingerprint = artifact_fingerprint_from_source(\n    String::concat(module_source, String::concat(\"|\", entry_name))\n  )\n  match db_load_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint) {\n    Some(bytes) => (bytes, codegen_db),\n    None => {\n      let module_stmts = parse_program(lex(module_source))\n      let pruned_stmts = prune_entry_stmts(module_stmts, entry_name)\n      let bytes = compile_wasi_module(pruned_stmts, entry_name)\n      (bytes, db_store_artifact(codegen_db, main_path, \"wasi-module-source\", entry_name, artifact_fingerprint, bytes))\n    }\n  }\n}\n\nexport let compile_file_fs = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_module = (entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n\nexport let prepare_file_fs_cached = (db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nlet prepare_file_fs_from_source_groups_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error } {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = match source_lookup(sources, entry_path) {\n    Some(source) => source,\n    None => throw(String::concat(\"module not found: \", entry_path))\n  }\n  prepare_modules_cached(db, entry_path, main_source, sources)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error, Fs } {\n  let sources = flatten_source_groups(source_groups)\n  let main_source = match source_lookup(sources, entry_path) {\n    Some(source) => source,\n    None => throw(String::concat(\"module not found: \", entry_path))\n  }\n  prepare_modules_persistent_fs_cached(db, entry_path, main_source, sources)\n}\n\nlet compile_file_fs_cached_slow = (\n  db: TypeDb,\n  entry_path: String,\n  entry_name: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name\n  )\n  match load_persistent_artifact(\"fs-compile-wasi\", entry_name, persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)\n      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)\n      match db_load_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(merged_source))\n          let pruned_stmts = prune_entry_stmts(merged_stmts, entry_name)\n          let bytes = compile_wasi_module(pruned_stmts, entry_name)\n          store_persistent_artifact(\n            \"fs-compile-wasi\",\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"wasi\", entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_cached = (db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-wasi\",\n        entry_name,\n        build_fs_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n      },\n    None => compile_file_fs_cached_slow(db, entry_path, entry_name)\n  }\n}\n\nlet compile_file_fs_module_cached_slow = (\n  db: TypeDb,\n  entry_path: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_fs_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\"fs-compile-module\", \"\", persistent_artifact_fingerprint) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"fs-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached = (db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"fs-compile-module\",\n        \"\",\n        build_fs_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n")

  let source_65 = ("vibe/compiler/entry/compiler/file_compile/index.vibe",
"//# Imports\n\nimport ../../../syntax/lexer.vibe {\n  lex,\n}\n\nimport ../../../syntax/parser.vibe {\n  parse_program\n}\n\nimport ../../../codegen/index.vibe {\n  compile_module, compile_wasi_module\n}\n\nimport ../../../codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\nimport ../../../loader/index.vibe {\n  collect_source_groups_fs, load_persistent_source_group_fingerprint_if_valid\n}\n\nimport ../../../core/dce.vibe {\n  dce_stmts\n}\n\nimport ../../../runtime/index.vibe {\n  TypeDb, db_new, db_set_source, db_typecheck, db_grouped_merged_source,\n  db_typecheck_fs, db_module_source, db_load_artifact, db_store_artifact\n}\n\nimport ../../../cache/persistent/index.vibe {\n  build_file_compile_module_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint,\n  build_file_compile_module_artifact_fingerprint,\n  build_file_compile_wasi_artifact_fingerprint,\n  load_persistent_artifact,\n  store_persistent_artifact\n}\n\n//# Functions\n\nlet artifact_fingerprint_from_source = (source: String) -> String {\n  let mod1 = 2147483647\n  let mod2 = 2147483629\n  let step1 = 131\n  let step2 = 65599\n  let len = String::length(source)\n  let mut h1 = 17\n  let mut h2 = 29\n  let mut i = 0\n  while i < len {\n    let c = String::char_code_at(source, i)\n    h1 = (h1 * step1 + c + 1) % mod1\n    h2 = (h2 * step2 + c + i + 1) % mod2\n    i = i + 1\n  }\n  String::concat(\n    __to_string(len),\n    String::concat(\":\", String::concat(__to_string(h1), String::concat(\":\", __to_string(h2))))\n  )\n}\n\nlet seed_type_db_from_source_groups = (\n  db: TypeDb,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb {\n  let mut seeded = db\n  let mut gi = 0\n  while gi < Array::length(source_groups) {\n    let (_, sources) = Array::get(source_groups, gi)\n    let mut si = 0\n    while si < Array::length(sources) {\n      let (path, source) = Array::get(sources, si)\n      seeded = db_set_source(seeded, path, source)\n      si = si + 1\n    }\n    gi = gi + 1\n  }\n  seeded\n}\n\nlet prepare_file_fs_from_source_groups_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck(seeded, entry_path)\n}\n\nlet prepare_file_fs_from_source_groups_persistent_cached = (\n  db: TypeDb,\n  entry_path: String,\n  source_groups: Array[(String, Array[(String, String)])]\n) -> TypeDb with { Error, Fs } {\n  let seeded = seed_type_db_from_source_groups(db, source_groups)\n  db_typecheck_fs(seeded, entry_path)\n}\n\nexport let prepare_file_fs_cached = (db: TypeDb, entry_path: String) -> TypeDb with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n}\n\nexport let compile_file_fs = (entry_path: String, entry_name: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_cached(db_new(), entry_path, entry_name)\n  bytes\n}\n\nexport let compile_file_fs_mode = (entry_path: String, entry_name: String, mode: String) -> Bytes with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let next_db = prepare_file_fs_from_source_groups_persistent_cached(db_new(), entry_path, source_groups)\n  let (merged_source, _, _) = db_grouped_merged_source(next_db, source_groups)\n  let merged_stmts = parse_program(lex(merged_source))\n  if String::equals(mode, \"mvp\") {\n    let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n    compile_wasi_module_impl(pruned_stmts, entry_name)\n  } else if String::equals(mode, \"no-dce\") {\n    compile_wasi_module(merged_stmts, entry_name)\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n}\n\nexport let compile_file_fs_module = (entry_path: String) -> Bytes with { Error, Fs } {\n  let (bytes, _) = compile_file_fs_module_cached(db_new(), entry_path)\n  bytes\n}\n\nexport let compile_file_fs_cached = (db: TypeDb, entry_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  compile_file_fs_mode_cached(db, entry_path, entry_name, \"no-dce\")\n}\n\nlet compile_file_fs_mode_cached_slow = (\n  db: TypeDb,\n  entry_path: String,\n  entry_name: String,\n  mode: String,\n  persistent_artifact_kind: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_wasi_artifact_fingerprint(\n    source_groups,\n    entry_name,\n    mode\n  )\n  match load_persistent_artifact(\n    persistent_artifact_kind,\n    entry_name,\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, _, codegen_db) = db_grouped_merged_source(next_db, source_groups)\n      let artifact_fingerprint = artifact_fingerprint_from_source(merged_source)\n      let artifact_kind = if String::equals(mode, \"mvp\") {\n        \"wasi-mvp\"\n      } else if String::equals(mode, \"no-dce\") {\n        \"wasi\"\n      } else {\n        throw(String::concat(\"unsupported compile mode: \", mode))\n      }\n      match db_load_artifact(codegen_db, entry_path, artifact_kind, entry_name, artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(merged_source))\n          let bytes = if String::equals(mode, \"mvp\") {\n            let pruned_stmts = dce_stmts(merged_stmts, [entry_name])\n            compile_wasi_module_impl(pruned_stmts, entry_name)\n          } else {\n            compile_wasi_module(merged_stmts, entry_name)\n          }\n          store_persistent_artifact(\n            persistent_artifact_kind,\n            entry_name,\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, artifact_kind, entry_name, artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_mode_cached = (db: TypeDb, entry_path: String, entry_name: String, mode: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  let persistent_artifact_kind = if String::equals(mode, \"mvp\") {\n    \"file-compile-wasi-mvp\"\n  } else if String::equals(mode, \"no-dce\") {\n    \"file-compile-wasi\"\n  } else {\n    throw(String::concat(\"unsupported compile mode: \", mode))\n  }\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        persistent_artifact_kind,\n        entry_name,\n        build_file_compile_wasi_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint,\n          entry_name,\n          mode\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n      },\n    None => compile_file_fs_mode_cached_slow(db, entry_path, entry_name, mode, persistent_artifact_kind)\n  }\n}\n\nlet compile_file_fs_module_cached_slow = (\n  db: TypeDb,\n  entry_path: String\n) -> (Bytes, TypeDb) with { Error, Fs } {\n  let source_groups = collect_source_groups_fs(entry_path)\n  let persistent_artifact_fingerprint = build_file_compile_module_artifact_fingerprint(\n    source_groups\n  )\n  match load_persistent_artifact(\n    \"file-compile-module\",\n    \"\",\n    persistent_artifact_fingerprint\n  ) {\n    Some(bytes) => (bytes, db),\n    None => {\n      let next_db = prepare_file_fs_from_source_groups_persistent_cached(db, entry_path, source_groups)\n      let (merged_source, merge_fingerprint, module_db) = db_grouped_merged_source(next_db, source_groups)\n      let (module_source, codegen_db) = db_module_source(module_db, merge_fingerprint, merged_source)\n      let artifact_fingerprint = artifact_fingerprint_from_source(module_source)\n      match db_load_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint) {\n        Some(bytes) => (bytes, codegen_db),\n        None => {\n          let merged_stmts = parse_program(lex(module_source))\n          let bytes = compile_module(merged_stmts)\n          store_persistent_artifact(\n            \"file-compile-module\",\n            \"\",\n            persistent_artifact_fingerprint,\n            bytes\n          )\n          (bytes, db_store_artifact(codegen_db, entry_path, \"module\", \"\", artifact_fingerprint, bytes))\n        }\n      }\n    }\n  }\n}\n\nexport let compile_file_fs_module_cached = (db: TypeDb, entry_path: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  match load_persistent_source_group_fingerprint_if_valid(entry_path) {\n    Some(source_groups_fingerprint) =>\n      match load_persistent_artifact(\n        \"file-compile-module\",\n        \"\",\n        build_file_compile_module_artifact_fingerprint_from_group_fingerprint(\n          source_groups_fingerprint\n        )\n      ) {\n        Some(bytes) => (bytes, db),\n        None => compile_file_fs_module_cached_slow(db, entry_path)\n      },\n    None => compile_file_fs_module_cached_slow(db, entry_path)\n  }\n}\n")

  let source_66 = ("vibe/compiler/compiler.vibe",
"//# Imports\n\nexport ./entry / compiler {\n  compile_file_fs, compile_file_fs_cached, compile_file_fs_module, compile_file_fs_module_cached, compile_source, compile_source_wasi, compile_with_closure_sources_wasi_cached, compile_with_modules, compile_with_modules_cached, compile_with_modules_wasi, compile_with_modules_wasi_cached, compile_with_source_groups_wasi_cached, compile_with_source_groups_wasi_unchecked_cached, prepare_file_fs_cached, prepare_modules_cached\n}\n\n//# Misc\n\nexport {\n  compile_source, compile_file_fs, compile_source_wasi, compile_with_modules, compile_file_fs_cached, compile_file_fs_module, prepare_file_fs_cached, prepare_modules_cached, compile_with_modules_wasi, compile_with_modules_cached, compile_file_fs_module_cached, compile_with_modules_wasi_cached, compile_with_source_groups_wasi_cached, compile_with_closure_sources_wasi_cached, compile_with_source_groups_wasi_unchecked_cached\n}\n")

  let source_67 = ("vibe/compiler/entry/cli_cache/index.vibe",
"//# Imports\n\nimport ../compiler/file_compile/index.vibe {\n  prepare_file_fs_cached, compile_file_fs_cached, compile_file_fs_module_cached\n}\n\nimport ../../runtime/index.vibe {\n  TypeDb, db_new, db_parse_count, db_typecheck_count\n}\n\nimport ../../cache/persistent/index.vibe {\n  compact_string_fingerprint, persistent_dep_list_cache_path, persistent_type_env_cache_path\n}\n\n//# Functions\n\nlet strip_trailing_cr = (line: String) -> String {\n  let len = String::length(line)\n  if len > 0 && String::char_code_at(line, len - 1) == 13 {\n    String::substring(line, 0, len - 1)\n  } else {\n    line\n  }\n}\n\nlet split_tsv_fields = (line: String) -> Array[String] {\n  let fields = Array::slice([\"\"], 0, 0)\n  let len = String::length(line)\n  let mut start = 0\n  let mut i = 0\n  while i < len {\n    if String::char_code_at(line, i) == 9 {\n      Array::push(fields, String::substring(line, start, i))\n      start = i + 1\n    }\n    i = i + 1\n  }\n  Array::push(fields, String::substring(line, start, len))\n  fields\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Array::slice([0], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nlet remove_file_if_exists = (path: String) -> Unit with { Fs } {\n  if Fs::exists(path) {\n    Fs::remove(path)\n  } else {\n    ()\n  }\n}\n\nlet build_type_db_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let (dep_path, dep_fp) = Array::get(dep_fps, i)\n    acc = compact_string_fingerprint(\n      String::concat(\n        acc,\n        String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n      )\n    )\n    i = i + 1\n  }\n  acc\n}\n\nexport let parse_batch_jobs_tsv = (raw: String) -> Array[(String, String, String)] with { Error } {\n  let jobs = Array::slice([(\"\", \"\", \"\")], 0, 0)\n  let len = String::length(raw)\n  let mut line_start = 0\n  let mut i = 0\n  while i <= len {\n    if i == len || String::char_code_at(raw, i) == 10 {\n      let line = strip_trailing_cr(String::substring(raw, line_start, i))\n      if String::length(line) > 0 {\n        let fields = split_tsv_fields(line)\n        let field_count = Array::length(fields)\n        if field_count < 2 || field_count > 3 {\n          throw(\"invalid VIBE_BATCH_TSV row: expected 2 or 3 tab-separated columns\")\n        }\n        let input_path = Array::get(fields, 0)\n        let output_path = Array::get(fields, 1)\n        let entry_name = if field_count == 3 { Array::get(fields, 2) } else { \"\" }\n        if String::length(input_path) == 0 || String::length(output_path) == 0 {\n          throw(\"invalid VIBE_BATCH_TSV row: input/output path must be non-empty\")\n        }\n        Array::push(jobs, (input_path, output_path, entry_name))\n      }\n      line_start = i + 1\n    }\n    i = i + 1\n  }\n  jobs\n}\n\nlet compile_job_cached = (db: TypeDb, input_path: String, entry_name: String) -> (Bytes, TypeDb) with { Error, Fs } {\n  if String::equals(entry_name, \"\") {\n    compile_file_fs_module_cached(db, input_path)\n  } else {\n    compile_file_fs_cached(db, input_path, entry_name)\n  }\n}\n\nexport let prepare_jobs_cached = (db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  let mut next_db = db\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, _, _) = Array::get(jobs, i)\n    next_db = prepare_file_fs_cached(next_db, input_path)\n    i = i + 1\n  }\n  next_db\n}\n\nexport let compile_jobs_cached = (db: TypeDb, jobs: Array[(String, String, String)]) -> TypeDb with { Error, Fs } {\n  let mut next_db = if Array::length(jobs) > 1 {\n    prepare_jobs_cached(db, jobs)\n  } else {\n    db\n  }\n  let mut i = 0\n  while i < Array::length(jobs) {\n    let (input_path, output_path, entry_name) = Array::get(jobs, i)\n    let (bytes, compiled_db) = compile_job_cached(next_db, input_path, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    next_db = compiled_db\n    i = i + 1\n  }\n  next_db\n}\n\nexport let selfbuild_probe_cli_cache_counts = () -> Int with { Error, Fs } {\n  let helper_path = \"/tmp/vibe_selfhost_cli_cache_helper.vibe\"\n  let main_path = \"/tmp/vibe_selfhost_cli_cache_main.vibe\"\n  Fs::write_bytes(\n    helper_path,\n    string_to_bytes(\"export let add = (a: Int, b: Int) -> Int { a + b }\")\n  )\n  Fs::write_bytes(\n    main_path,\n    string_to_bytes(\"import ./vibe_selfhost_cli_cache_helper.vibe { add }\\nlet run = () -> Int { add(1, 2) }\")\n  )\n  let jobs = [(main_path, \"/tmp/vibe_selfhost_cli_cache_out.wasm\", \"run\")]\n  let db1 = prepare_jobs_cached(db_new(), jobs)\n  let count1 = db_typecheck_count(db1)\n  let db2 = prepare_jobs_cached(db1, jobs)\n  let count2 = db_typecheck_count(db2)\n  count1 * 1000 + count2\n}\n\nlet clear_prepare_probe_caches = (\n  helper_path: String,\n  helper_source: String,\n  main1_path: String,\n  main1_source: String,\n  main2_path: String,\n  main2_source: String\n) -> Unit with { Fs } {\n  let helper_fp = build_type_db_fingerprint(helper_source, Array::slice([(\"\", \"\")], 0, 0))\n  let main1_fp = build_type_db_fingerprint(main1_source, [(helper_path, helper_fp)])\n  let main2_fp = build_type_db_fingerprint(main2_source, [(helper_path, helper_fp)])\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(helper_path, compact_string_fingerprint(helper_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main1_path, compact_string_fingerprint(main1_source))\n  )\n  remove_file_if_exists(\n    persistent_dep_list_cache_path(main2_path, compact_string_fingerprint(main2_source))\n  )\n  remove_file_if_exists(persistent_type_env_cache_path(helper_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main1_fp))\n  remove_file_if_exists(persistent_type_env_cache_path(main2_fp))\n}\n\nlet prepare_probe_sources = (\n  helper_path: String,\n  main1_path: String,\n  main2_path: String\n) -> (String, String, String) {\n  let helper_source = \"export let add = (a: Int, b: Int) -> Int { a + b }\"\n  let main1_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run = () -> Int { add(1, 2) }\"\n    )\n  )\n  let main2_source = String::concat(\n    \"import ./\",\n    String::concat(\n      String::substring(helper_path, String::last_index_of(helper_path, \"/\") + 1, String::length(helper_path)),\n      \" { add }\\nlet run = () -> Int { add(3, 4) }\"\n    )\n  )\n  (helper_source, main1_source, main2_source)\n}\n\nexport let selfbuild_probe_cli_prepare_batch_parse_counts = () -> Int with { Error, Fs } {\n  let fresh_helper_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_helper.vibe\"\n  let fresh_main1_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.vibe\"\n  let fresh_main2_path = \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.vibe\"\n  let shared_helper_path = \"/tmp/vibe_selfhost_cli_prepare_shared_helper.vibe\"\n  let shared_main1_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main1.vibe\"\n  let shared_main2_path = \"/tmp/vibe_selfhost_cli_prepare_shared_main2.vibe\"\n  let (fresh_helper_source, fresh_main1_source, fresh_main2_source) = prepare_probe_sources(\n    fresh_helper_path,\n    fresh_main1_path,\n    fresh_main2_path\n  )\n  let (shared_helper_source, shared_main1_source, shared_main2_source) = prepare_probe_sources(\n    shared_helper_path,\n    shared_main1_path,\n    shared_main2_path\n  )\n  Fs::write_bytes(fresh_helper_path, string_to_bytes(fresh_helper_source))\n  Fs::write_bytes(fresh_main1_path, string_to_bytes(fresh_main1_source))\n  Fs::write_bytes(fresh_main2_path, string_to_bytes(fresh_main2_source))\n  Fs::write_bytes(shared_helper_path, string_to_bytes(shared_helper_source))\n  Fs::write_bytes(shared_main1_path, string_to_bytes(shared_main1_source))\n  Fs::write_bytes(shared_main2_path, string_to_bytes(shared_main2_source))\n  clear_prepare_probe_caches(\n    fresh_helper_path,\n    fresh_helper_source,\n    fresh_main1_path,\n    fresh_main1_source,\n    fresh_main2_path,\n    fresh_main2_source\n  )\n  clear_prepare_probe_caches(\n    shared_helper_path,\n    shared_helper_source,\n    shared_main1_path,\n    shared_main1_source,\n    shared_main2_path,\n    shared_main2_source\n  )\n  let fresh_count1 = db_parse_count(prepare_jobs_cached(db_new(), [\n    (fresh_main1_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main1.wasm\", \"run\")\n  ]))\n  let fresh_count2 = db_parse_count(prepare_jobs_cached(db_new(), [\n    (fresh_main2_path, \"/tmp/vibe_selfhost_cli_prepare_fresh_main2.wasm\", \"run\")\n  ]))\n  let shared_count = db_parse_count(prepare_jobs_cached(db_new(), [\n    (shared_main1_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main1.wasm\", \"run\"),\n    (shared_main2_path, \"/tmp/vibe_selfhost_cli_prepare_shared_main2.wasm\", \"run\")\n  ]))\n  (fresh_count1 + fresh_count2) * 1000 + shared_count\n}\n")

  let source_68 = ("vibe/compiler/cli_cache.vibe",
"//# Imports\n\nexport ./entry / cli_cache {\n  compile_jobs_cached, parse_batch_jobs_tsv, prepare_jobs_cached,\n  selfbuild_probe_cli_cache_counts, selfbuild_probe_cli_prepare_batch_parse_counts\n}\n\n//# Misc\n\nexport {\n  compile_jobs_cached,\n  prepare_jobs_cached,\n  parse_batch_jobs_tsv,\n  selfbuild_probe_cli_cache_counts,\n  selfbuild_probe_cli_prepare_batch_parse_counts\n}\n")

  let source_69 = ("vibe/compiler/selfhost_cli_adapter.vibe",
"//# Imports\n\nimport ./entry / source_compile / wasi_only {\n  compile_source_wasi_only\n}\n\n//# Functions\n\nexport let cli_main = () -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  let entry_name = Env::get(\"VIBE_ENTRY\")\n  let source = Fs::read_file(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Fs::write_bytes(output_path, bytes)\n  0\n}\n")

  let source_70 = ("vibe/compiler/selfhost_cli_adapter_bundle.vibe",
"// AUTO-GENERATED by scripts/generate_selfhost_bundle.sh\n// Do not edit manually. Regenerate with: bash scripts/generate_selfhost_bundle.sh\n\n//# Selfhost CLI adapter bundle\n\nlet empty_grouped_sources = () -> Array[(String, Array[(String, String)])] {\n  Array::slice([(\"\", Array::slice([(\"\", \"\")], 0, 0))], 0, 0)\n}\n\nlet push_grouped_source_pair = (groups: Array[(String, Array[(String, String)])], group_name: String, pair: (String, String)) -> Unit {\n  let (path, source) = pair\n  let mut i = 0\n  let mut found = false\n  while i < Array::length(groups) {\n    let (name, sources) = Array::get(groups, i)\n    if String::equals(name, group_name) {\n      Array::push(sources, (path, source))\n      found = true\n      i = Array::length(groups)\n    } else {\n      i = i + 1\n    }\n  }\n  if !found {\n    let sources = Array::slice([(\"\", \"\")], 0, 0)\n    Array::push(sources, (path, source))\n    Array::push(groups, (group_name, sources))\n  }\n}\n\n  let source_0 = (\"vibe/compiler/selfhost_cli_adapter.vibe\",\n\"//# Imports\\n\\nimport ./entry / source_compile / wasi_only {\\n  compile_source_wasi_only\\n}\\n\\n//# Functions\\n\\nexport let cli_main = () -> Int with { Error, Fs, Env } {\\n  let input_path = Env::get(\\\"VIBE_INPUT\\\")\\n  let output_path = Env::get(\\\"VIBE_OUTPUT\\\")\\n  let entry_name = Env::get(\\\"VIBE_ENTRY\\\")\\n  let source = Fs::read_file(input_path)\\n  let bytes = compile_source_wasi_only(source, entry_name)\\n  Fs::write_bytes(output_path, bytes)\\n  0\\n}\\n\")\n\nexport let selfhost_cli_adapter_sources = () -> Array[(String, String)] {\n  let sources = Array::slice([(\"\", \"\")], 0, 0)\n  Array::push(sources, source_0)\n  sources\n}\n\nexport let selfhost_cli_adapter_source_groups = () -> Array[(String, Array[(String, String)])] {\n  let groups = empty_grouped_sources()\n  push_grouped_source_pair(groups, \"entry\", source_0)\n  groups\n}\n\nexport let selfhost_cli_adapter_ordered_sources = () -> Array[(String, String)] {\n  let sources = Array::slice([(\"\", \"\")], 0, 0)\n  Array::push(sources, source_0)\n  sources\n}\n\nlet selfhost_cli_adapter_merged_source_value = \n\"export let cli_main = () -> Int with { Error, Fs, Env } {\\n  let input_path = Env::get(\\\"VIBE_INPUT\\\")\\n  let output_path = Env::get(\\\"VIBE_OUTPUT\\\")\\n  let entry_name = Env::get(\\\"VIBE_ENTRY\\\")\\n  let source = Fs::read_file(input_path)\\n  let bytes = compile_source_wasi_only(source, entry_name)\\n  Fs::write_bytes(output_path, bytes)\\n  0\\n}\\n\"\n\nexport let selfhost_cli_adapter_merged_source = () -> String {\n  selfhost_cli_adapter_merged_source_value\n}\n\nlet selfhost_cli_adapter_module_source_value = \n\"export let cli_main = () -> Int with { Error, Fs, Env } {\\n  let input_path = Env::get(\\\"VIBE_INPUT\\\")\\n  let output_path = Env::get(\\\"VIBE_OUTPUT\\\")\\n  let entry_name = Env::get(\\\"VIBE_ENTRY\\\")\\n  let source = Fs::read_file(input_path)\\n  let bytes = compile_source_wasi_only(source, entry_name)\\n  Fs::write_bytes(output_path, bytes)\\n  0\\n}\\n\"\n\nexport let selfhost_cli_adapter_module_source = () -> String {\n  selfhost_cli_adapter_module_source_value\n}\n")

  let source_71 = ("vibe/compiler/selfbuild_runtime_entry_bundle.vibe",
"// AUTO-GENERATED by scripts/generate_selfhost_bundle.sh\n// Do not edit manually. Regenerate with: bash scripts/generate_selfhost_bundle.sh\n\n//# Selfbuild runtime entry bundle\n\nlet selfbuild_runtime_entry_source_chunk_0 = \"//# Functions\\n\\nexport let run = () -> Int {\\n  0\\n}\\n\\nexport let selfbuild_entry = () -> Int {\\n  0\\n}\\n\"\n\nexport let selfbuild_runtime_entry_source = () -> String {\n  selfbuild_runtime_entry_source_chunk_0\n}\n")

  let source_72 = ("vibe/compiler/index.vibe",
"//# Imports\n\nexport ./ast.vibe {\n  Expr, Pat, Stmt, TypeExpr\n}\n\nexport ./lexer.vibe {\n  lex\n}\n\nexport ./parser.vibe {\n  parse, parse_expr, parse_ok, parse_program, parse_stmt, parse_type\n}\n\nexport ./printer.vibe {\n  print_expr, print_pat, print_program, print_stmt, print_type_expr\n}\n\nexport ./token.vibe {\n  Token, token_to_string\n}\n\nexport ./types.vibe {\n  Subst, Type, TypeDef, TypeEnv\n}\n\nexport ./type_db.vibe {\n  TypeDb, db_new, db_set_source, db_check_env, db_typecheck, db_typecheck_fs, db_typecheck_count,\n  db_parse_count, db_merge_count, db_module_source_count, db_codegen_count,\n  db_program_source, db_merged_source, db_grouped_merged_source, db_module_source,\n  db_load_artifact, db_store_artifact\n}\n\nexport ./cli_cache.vibe {\n  parse_batch_jobs_tsv, prepare_jobs_cached, compile_jobs_cached,\n  selfbuild_probe_cli_cache_counts, selfbuild_probe_cli_prepare_batch_parse_counts\n}\n\nexport ./checker_stmt.vibe {\n  check_program, check_program_with_env, check_stmts\n}\n\nexport ./codegen.vibe {\n  compile_module, compile_wasi_module, compile_wasi_module_with_sources\n}\n\nexport ./codegen_gc.vibe {\n  compile_wasi_module_gc\n}\n\nimport ./entry/source_compile/index.vibe {\n  compile_source, compile_source_wasi\n}\n\nimport ./entry/source_compile/wasi_only/index.vibe {\n  compile_source_wasi_only\n}\n\nimport ./entry/compiler/fs_compile/index.vibe {\n  compile_with_modules, compile_with_modules_wasi,\n  prepare_modules_cached, compile_with_modules_cached, compile_with_modules_wasi_cached,\n  compile_with_closure_sources_wasi_cached, compile_with_closure_sources_wasi_unchecked_cached,\n  compile_with_source_groups_wasi_cached, compile_with_source_groups_wasi_unchecked_cached,\n  compile_with_source_groups_via_module_source_wasi_unchecked_cached,\n  source_group_total_source_count, source_group_ordered_source_count,\n  source_group_filtered_group_count, source_group_prepare_typecheck_count,\n  grouped_source_merged_len, closure_ordered_source_count, closure_merged_stmt_count,\n  closure_pruned_stmt_count, source_group_pruned_stmt_count, source_group_module_source_len,\n  compile_file_fs, compile_file_fs_module, prepare_file_fs_cached,\n  compile_file_fs_cached, compile_file_fs_module_cached\n}\n\nimport ./entry/compiler/file_compile/index.vibe {\n  compile_file_fs_mode_cached\n}\n\nimport ./module_loader.vibe {\n  collect_all_sources_fs, collect_merged_stmts, collect_source_groups_fs\n}\n\nimport ./selfhost_sources_bundle.vibe {\n  selfhost_sources, selfhost_source_groups\n}\n\nimport ./selfhost_cli_adapter_bundle.vibe {\n  selfhost_cli_adapter_sources, selfhost_cli_adapter_source_groups,\n  selfhost_cli_adapter_merged_source, selfhost_cli_adapter_module_source\n}\n\nimport ./selfbuild_runtime_entry_bundle.vibe {\n  selfbuild_runtime_entry_source\n}\n\nimport ./cache / persistent {\n  build_file_compile_wasi_artifact_fingerprint,\n  compact_string_fingerprint,\n  persistent_artifact_cache_path,\n  persistent_dep_list_cache_path,\n  persistent_type_env_cache_path\n}\n\nimport ./core/index.vibe {\n  dce_stmts\n}\n\nimport ./codegen/wasi/index.vibe {\n  compile_wasi_module_impl\n}\n\nimport ./codegen_common_base.vibe {\n  is_slet, is_efn, get_slet_name, get_slet_expr, get_efn_body\n}\n\nimport ./codegen_common_extractors.vibe {\n  get_efn_params, array_contains_str\n}\n\nimport ./codegen_common_analysis.vibe {\n  collect_free_vars\n}\n\n//# Functions\n\nexport let version = \"0.1.0\"\n\nexport let compiler_lex = lex\n\nexport let compiler_parse = parse\n\nexport let compiler_parse_ok = parse_ok\n\nexport let compiler_print_pat = print_pat\n\nexport let compiler_parse_expr = parse_expr\n\nexport let compiler_parse_stmt = parse_stmt\n\nexport let compiler_parse_type = parse_type\n\nexport let compiler_print_expr = print_expr\n\nexport let compiler_print_stmt = print_stmt\n\nexport let compiler_parse_program = parse_program\n\nexport let compiler_print_program = print_program\n\nexport let compiler_print_type_expr = print_type_expr\n\nlet build_selfhost_cli_adapter_bytes = () -> Bytes with { Error } {\n  let module_source = selfhost_cli_adapter_module_source()\n  if String::equals(module_source, \"\") {\n    throw(\"selfhost_cli_adapter_module_source is empty\")\n  }\n  let stmts = parse_program(lex(module_source))\n  let pruned_stmts = dce_stmts(stmts, [\"cli_main\"])\n  compile_wasi_module_impl(pruned_stmts, \"cli_main\")\n}\n\nlet string_to_bytes = (s: String) -> Bytes {\n  let out = Array::slice([0], 0, 0)\n  let len = String::length(s)\n  let mut i = 0\n  while i < len {\n    Array::push(out, String::char_code_at(s, i))\n    i = i + 1\n  }\n  Bytes::from_array(out)\n}\n\nlet remove_file_if_exists = (path: String) -> Unit with { Fs } {\n  if Fs::exists(path) {\n    Fs::remove(path)\n  } else {\n    ()\n  }\n}\n\nlet build_type_db_fingerprint = (source: String, dep_fps: Array[(String, String)]) -> String {\n  let mut acc = compact_string_fingerprint(source)\n  let mut i = 0\n  while i < Array::length(dep_fps) {\n    let (dep_path, dep_fp) = Array::get(dep_fps, i)\n    acc = compact_string_fingerprint(\n      String::concat(\n        acc,\n        String::concat(\"|\", String::concat(dep_path, String::concat(\"=\", dep_fp)))\n      )\n    )\n    i = i + 1\n  }\n  acc\n}\n\nlet compile_selfhost_cli_adapter_to = (output_path: String) -> Int with { Error, Fs } {\n  if String::equals(output_path, \"\") {\n    1\n  } else {\n    let bytes = build_selfhost_cli_adapter_bytes()\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nlet selfhost_cli_trigger_path = \"_build/bench/selfhost_cli_adapter/.compile_cli_trigger\"\nlet selfhost_cli_stage1_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_stage1.wasm\"\nlet selfhost_cli_merged_dump_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_merged_dump.vibe\"\nlet selfhost_cli_module_dump_path = \"_build/bench/selfhost_cli_adapter/selfhost_cli_adapter_module_dump.vibe\"\n\n// Lightweight entry for WASI _start/run wrapper.\nexport let selfbuild_entry = () -> Int with { Error, Fs } {\n  handle {\n    if Fs::exists(selfhost_cli_trigger_path) {\n      compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)\n    } else {\n      0\n    }\n  } {\n    Error(_) => 0\n  }\n}\n\nexport let selfbuild_write_cli_adapter = () -> Int with { Error, Fs } {\n  compile_selfhost_cli_adapter_to(selfhost_cli_stage1_path)\n}\n\nexport let selfbuild_dump_cli_adapter_merged_source = () -> Int with { Error, Fs } {\n  Fs::write_bytes(\n    selfhost_cli_merged_dump_path,\n    string_to_bytes(selfhost_cli_adapter_merged_source())\n  )\n  0\n}\n\nexport let selfbuild_dump_cli_adapter_module_source = () -> Int with { Error, Fs } {\n  Fs::write_bytes(\n    selfhost_cli_module_dump_path,\n    string_to_bytes(selfhost_cli_adapter_module_source())\n  )\n  0\n}\n\nexport let selfbuild_dump_cli_adapter_merged_source_env = () -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))\n  0\n}\n\nexport let selfbuild_dump_cli_adapter_module_source_env = () -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_module_source()))\n  0\n}\n\nexport let probe_dump_cli_adapter_merged_source_env = () -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_merged_source()))\n  0\n}\n\nexport let probe_dump_cli_adapter_module_source_env = () -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(selfhost_cli_adapter_module_source()))\n  0\n}\n\nexport let probe_write_bytes_smoke = () -> Int with { Error, Fs, Env } {\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  Fs::write_bytes(output_path, string_to_bytes(\"ok\\n\"))\n  0\n}\n\nexport let selfbuild_cli_env_entry = () -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let output_path = Env::get(\"VIBE_OUTPUT\")\n  let entry_name = Env::get(\"VIBE_ENTRY\")\n  if String::equals(input_path, \"\") {\n    1\n  }\n  else if String::equals(output_path, \"\") {\n    1\n  }\n  else if String::equals(entry_name, \"\") {\n    1\n  }\n  else {\n    let source = Fs::read_file(input_path)\n    let bytes = compile_source_wasi_only(source, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_probe_cli_env_read_len = () -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let source = Fs::read_file(input_path)\n  String::length(source)\n}\n\nexport let selfbuild_probe_cli_env_compile_len = () -> Int with { Error, Fs, Env } {\n  let input_path = Env::get(\"VIBE_INPUT\")\n  let entry_name = Env::get(\"VIBE_ENTRY\")\n  let source = Fs::read_file(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_probe_cli_args_read_len = () -> Int with { Error, Fs, Env } {\n  let input_path = if Env::args_len() > 0 { Env::args_get(0) } else { \"\" }\n  let source = Fs::read_file(input_path)\n  String::length(source)\n}\n\nexport let selfbuild_probe_cli_args_compile_len = () -> Int with { Error, Fs, Env } {\n  let input_path = if Env::args_len() > 0 { Env::args_get(0) } else { \"\" }\n  let entry_name = if Env::args_len() > 2 { Env::args_get(2) } else { \"\" }\n  let source = Fs::read_file(input_path)\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nexport let selfbuild_cli_args_entry = () -> Int with { Error, Fs, Env } {\n  let input_path = if Env::args_len() > 0 { Env::args_get(0) } else { \"\" }\n  let output_path = if Env::args_len() > 1 { Env::args_get(1) } else { \"\" }\n  let entry_name = if Env::args_len() > 2 { Env::args_get(2) } else { \"\" }\n  if String::equals(input_path, \"\") {\n    1\n  }\n  else if String::equals(output_path, \"\") {\n    1\n  }\n  else if String::equals(entry_name, \"\") {\n    1\n  }\n  else {\n    let source = Fs::read_file(input_path)\n    let bytes = compile_source_wasi_only(source, entry_name)\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\nexport let selfbuild_cli_entry = () -> Int with { Error, Fs } {\n  let input_path = \"_build/bench/selfhost_cli_adapter/adapter_input.vibe\"\n  let output_path = \"_build/bench/selfhost_cli_adapter/adapter_output.wasm\"\n  if String::equals(input_path, \"\") {\n    1\n  }\n  else if String::equals(output_path, \"\") {\n    1\n  }\n  else {\n    let (bytes, _) = compile_file_fs_cached(db_new(), input_path, \"main\")\n    Fs::write_bytes(output_path, bytes)\n    0\n  }\n}\n\n// selfbuild helper: use the selfhost compiler's own compile pipeline to compile stage2.\nexport let selfbuild_compile_stage2 = () -> Bytes with { Error } {\n  let main_source = selfbuild_runtime_entry_source()\n  if String::equals(main_source, \"\") { throw(\"selfbuild_runtime_entry_source is empty\") }\n  compile_source_wasi_only(main_source, \"selfbuild_entry\")\n}\n\nlet lookup_selfhost_source = (sources: Array[(String, String)], path: String) -> String with { Error } {\n  let mut i = 0\n  let mut found = false\n  let mut result = \"\"\n  while i < Array::length(sources) && !found {\n    let (candidate_path, source) = Array::get(sources, i)\n    if String::equals(candidate_path, path) {\n      result = source\n      found = true\n    }\n    i = i + 1\n  }\n  if found {\n    result\n  } else {\n    throw(String::concat(\"selfhost source not found: \", path))\n  }\n}\n\nlet load_cli_adapter_merged_source = () -> String with { Error } {\n  let sources = selfhost_cli_adapter_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  let prepared = prepare_modules_cached(db_new(), adapter_path, adapter_source, sources)\n  let (merged_source, _, _) = db_merged_source(prepared, adapter_path, sources)\n  merged_source\n}\n\nlet load_cli_adapter_program_source = () -> String with { Error } {\n  let sources = selfhost_cli_adapter_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_cli_adapter_sources is empty\") }\n  let adapter_path = \"vibe/compiler/selfhost_cli_adapter.vibe\"\n  let adapter_source = lookup_selfhost_source(sources, adapter_path)\n  let prepared = prepare_modules_cached(db_new(), adapter_path, adapter_source, sources)\n  let (program_source, _, _) = db_program_source(prepared, adapter_path)\n  program_source\n}\n\nlet find_unexpected_control_char = (source: String) -> Int {\n  let len = String::length(source)\n  let mut i = 0\n  let mut result = -1\n  while i < len && result < 0 {\n    let c = String::char_code_at(source, i)\n    let allowed = c == 9 || c == 10 || c == 13 || c >= 32\n    if !allowed {\n      result = i * 1000 + c\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet probe_selfhost_source_control = (path: String) -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let source = lookup_selfhost_source(sources, path)\n  find_unexpected_control_char(source)\n}\n\nlet probe_all_selfhost_source_controls = () -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let mut i = 0\n  let mut result = -1\n  while i < Array::length(sources) && result < 0 {\n    let (_, source) = Array::get(sources, i)\n    let control = find_unexpected_control_char(source)\n    if control >= 0 {\n      result = i * 1000000 + control\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet probe_prepare_source = (main_source: String, main_path: String) -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let prepared = prepare_modules_cached(db_new(), main_path, main_source, sources)\n  db_typecheck_count(prepared)\n}\n\nlet probe_parse_selfhost_source = (path: String) -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let source = lookup_selfhost_source(sources, path)\n  let stmts = parse_program(lex(source))\n  Array::length(stmts)\n}\n\nlet probe_lex_selfhost_source = (path: String) -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let source = lookup_selfhost_source(sources, path)\n  let tokens = lex(source)\n  Array::length(tokens)\n}\n\nlet probe_parse_stmt_progress_selfhost_source = (path: String) -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_sources is empty (stub)\") }\n  let source = lookup_selfhost_source(sources, path)\n  let tokens = lex(source)\n  let mut pos = 0\n  let mut stmt_index = 0\n  let mut result = -1\n  let mut done = false\n  while !done {\n    if pos >= Array::length(tokens) {\n      result = stmt_index * 100000 + pos\n      done = true\n    } else {\n      match Array::get(tokens, pos) {\n        TEof => {\n          result = stmt_index * 100000 + pos\n          done = true\n        },\n        _ => {\n          handle {\n            let (_, next) = parse_stmt(tokens, pos)\n            pos = next\n            stmt_index = stmt_index + 1\n          } {\n            Error(_) => {\n              result = stmt_index * 100000 + pos\n              done = true\n            }\n          }\n        }\n      }\n    }\n  }\n  result\n}\n\nlet probe_parse_import_stmt = (source: String) -> Int with { Error } {\n  let tokens = lex(source)\n  let (_, next) = parse_stmt(tokens, 0)\n  next\n}\n\nlet probe_lex_source = (source: String) -> Int with { Error } {\n  Array::length(lex(source))\n}\n\nlet probe_parse_source = (source: String) -> Int with { Error } {\n  let stmts = parse_program(lex(source))\n  Array::length(stmts)\n}\n\nlet probe_check_source = (source: String) -> Int with { Error } {\n  let stmts = parse_program(lex(source))\n  let _ = check_program(stmts)\n  1\n}\n\nlet probe_compile_source_len = (source: String, entry_name: String) -> Int with { Error } {\n  let bytes = compile_source_wasi_only(source, entry_name)\n  Bytes::length(bytes)\n}\n\nlet probe_parse_stmt_progress_source = (source: String) -> Int with { Error } {\n  let tokens = lex(source)\n  let mut pos = 0\n  let mut stmt_index = 0\n  let mut result = -1\n  let mut done = false\n  while !done {\n    if pos >= Array::length(tokens) {\n      result = stmt_index * 100000 + pos\n      done = true\n    } else {\n      match Array::get(tokens, pos) {\n        TEof => {\n          result = stmt_index * 100000 + pos\n          done = true\n        },\n        _ => {\n          handle {\n            let (_, next) = parse_stmt(tokens, pos)\n            pos = next\n            stmt_index = stmt_index + 1\n          } {\n            Error(_) => {\n              result = stmt_index * 100000 + pos\n              done = true\n            }\n          }\n        }\n      }\n    }\n  }\n  result\n}\n\nlet probe_parse_sources_first_failure = (sources: Array[(String, String)]) -> Int with { Error } {\n  let mut i = 0\n  let mut result = -1\n  while i < Array::length(sources) && result < 0 {\n    let (_, source) = Array::get(sources, i)\n    handle {\n      let _ = parse_program(lex(source))\n      ()\n    } {\n      Error(_) => {\n        result = i * 1000000 + probe_parse_stmt_progress_source(source)\n      }\n    }\n    i = i + 1\n  }\n  result\n}\n\nlet probe_compile_cli_adapter_like = (main_source: String) -> Int with { Error } {\n  let sources = selfhost_sources()\n  if Array::length(sources) == 0 { throw(\"selfhost_