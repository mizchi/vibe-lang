   Some(CtFn(two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_index_of = (name: String) -> Option[Type] {\\n  if name == \\\"String::index_of\\\" {\\n    Some(CtFn(two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_to_lower = (name: String) -> Option[Type] {\\n  if name == \\\"String::to_lower\\\" {\\n    Some(CtFn(one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_to_upper = (name: String) -> Option[Type] {\\n  if name == \\\"String::to_upper\\\" {\\n    Some(CtFn(one_param(CtString), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_c = (name: String) -> Option[Type] {\\n  match lookup_string_trim(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_to_upper(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_to_lower(name)\\n    }\\n  }\\n}\\n\\nlet lookup_string_ends_with = (name: String) -> Option[Type] {\\n  if name == \\\"String::ends_with\\\" {\\n    Some(CtFn(two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_starts_with = (name: String) -> Option[Type] {\\n  if name == \\\"String::starts_with\\\" {\\n    Some(CtFn(two_params(CtString, CtString), CtBool, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_a = (name: String) -> Option[Type] {\\n  match lookup_string_index_of(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_contains(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_starts_with(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_ends_with(name)\\n      }\\n    }\\n  }\\n}\\n\\nlet lookup_string_char_code_at = (name: String) -> Option[Type] {\\n  if name == \\\"String::char_code_at\\\" {\\n    Some(CtFn(two_params(CtString, CtInt), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_last_index_of = (name: String) -> Option[Type] {\\n  if name == \\\"String::last_index_of\\\" {\\n    Some(CtFn(two_params(CtString, CtString), CtInt, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_from_char_code = (name: String) -> Option[Type] {\\n  if name == \\\"String::from_char_code\\\" {\\n    Some(CtFn(one_param(CtInt), CtString, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_group_b = (name: String) -> Option[Type] {\\n  match lookup_string_from_char_code(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_char_code_at(name) {\\n      Some(t) => Some(t),\\n      None => match lookup_string_last_index_of(name) {\\n        Some(t) => Some(t),\\n        None => lookup_string_split(name)\\n      }\\n    }\\n  }\\n}\\n\\nexport let lookup_string2 = (name: String) -> Option[Type] {\\n  match lookup_string_group_a(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_group_b(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_group_c(name)\\n    }\\n  }\\n}\\n\")\n\n  let source_23 = (\"vibe/compiler/checker/builtins_builders.vibe\",\n\"//# Imports\\n\\nimport .. / core / types.vibe {\\n  Type\\n}\\n\\n//# Functions\\n\\nlet no_params = () -> Array[Type] {\\n  Array::slice([\\n    CtUnknown\\n  ], 0, 0)\\n}\\n\\nlet one_param = (a: Type) -> Array[Type] {\\n  let arr = no_params()\\n  Array::push(arr, a)\\n  arr\\n}\\n\\nlet two_params = (a: Type, b: Type) -> Array[Type] {\\n  let arr = no_params()\\n  Array::push(arr, a)\\n  Array::push(arr, b)\\n  arr\\n}\\n\\nlet lookup_array_builder_new = (name: String) -> Option[Type] {\\n  if name == \\\"ArrayBuilder::new\\\" {\\n    Some(CtFn(no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_array_builder_push = (name: String) -> Option[Type] {\\n  if name == \\\"ArrayBuilder::push\\\" {\\n    Some(CtFn(two_params(CtUnknown, CtUnknown), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_builder_new = (name: String) -> Option[Type] {\\n  if name == \\\"StringBuilder::new\\\" {\\n    Some(CtFn(no_params(), CtUnknown, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_string_builder_push = (name: String) -> Option[Type] {\\n  if name == \\\"StringBuilder::push\\\" {\\n    Some(CtFn(two_params(CtUnknown, CtString), CtUnit, None))\\n  }\\n  else None\\n}\\n\\nlet lookup_array_builder_freeze = (name: String) -> Option[Type] {\\n  if name == \\\"ArrayBuilder::freeze\\\" {\\n    Some(CtFn(one_param(CtUnknown), CtArray(CtUnknown), None))\\n  }\\n  else None\\n}\\n\\nexport let lookup_array_builder = (name: String) -> Option[Type] {\\n  match lookup_array_builder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_array_builder_push(name) {\\n      Some(t) => Some(t),\\n      None => lookup_array_builder_freeze(name)\\n    }\\n  }\\n}\\n\\nlet lookup_string_builder_freeze = (name: String) -> Option[Type] {\\n  if name == \\\"StringBuilder::freeze\\\" {\\n    Some(CtFn(one_param(CtUnknown), CtString, None))\\n  }\\n  else None\\n}\\n\\nexport let lookup_string_builder = (name: String) -> Option[Type] {\\n  match lookup_string_builder_new(name) {\\n    Some(t) => Some(t),\\n    None => match lookup_string_builder_push(name) {\\n      Some(t) => Some(t),\\n      None => lookup_string_builder_freeze(name)\\n    }\\n  }\\n}\\n\")\n\n  let source_24 = (\"vibe/compiler/checker/checker_resolve.vibe\",\n\"//# Imports\\n\\nimport .. / core / ast.vibe {\\n  TypeExpr\\n}\\n\\nimport .. / core / types.vibe {\\n  Type, TypeDef, find_typedef, resolve_builtin\\n}\\n\\n//# Functions\\n\\nexport let rec resolve_type_expr = (te: TypeExpr, defs: Array[TypeDef]) -> Type {\\n  match te {\\n    TyUnit => CtUnit,\\n    TyName(name) => match resolve_builtin(name) {\\n      Some(t) => t,\\n      None => match find_typedef(defs, name) {\\n        Some(td) => match td {\\n          TDEnum(n, _) => CtEnum(n),\\n          TDStruct(n, _) => CtStruct(n),\\n          TDAlias(_, t) => t\\n        },\\n        None => CtNamed(name, Array::slice([\\n          CtUnknown\\n        ], 0, 0))\\n      }\\n    },\\n    TyApp(name, args) => {\\n      let ra = for a in args {\\n        resolve_type_expr(a, defs)\\n      }\\n      if name == \\\"Array\\\" {\\n        if Array::length(ra) == 1 {\\n          CtArray(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else if name == \\\"Option\\\" {\\n        if Array::length(ra) == 1 {\\n          CtOption(Array::get(ra, 0))\\n        }\\n        else CtNamed(name, ra)\\n      } else CtNamed(name, ra)\\n    },\\n    TyTuple(elems) => {\\n      let r = for e in elems {\\n        resolve_type_expr(e, defs)\\n      }\\n      CtTuple(r)\\n    },\\n    TyFn(params, ret, effect_name) => {\\n      let rp = for p in params {\\n        resolve_type_expr(p, defs)\\n      }\\n      CtFn(rp, resolve_type_expr(ret, defs), effect_name)\\n    }\\n  }\\n}\\n\")\n\n  let source_25 = (\"vibe/compiler/checker/checker_pattern.vibe\",\n\"//# Imports\\n\\nimport .. / core {\\n  Pat, Type, TypeDef, TypeEnv, env_bind, find_typedef\\n}\\n\\n//# Functions\\n\\nlet find_ctor_in_defs = (defs: Array[TypeDef], ctor_name: String) -> Option[(String, Array[Type])] {\\n  let dlen = Array::length(defs)\\n  let rec go_defs = (di: Int) -> Option[(String, Array[Type])] {\\n    if di >= dlen {\\n      None\\n    } else {\\n      let d = Array::get(defs, di)\\n      match d {\\n        TDEnum(enum_name, variants) => {\\n          let vlen = Array::length(variants)\\n          let rec go_variants = (vi: Int) -> Option[(String, Array[Type])] {\\n            if vi >= vlen {\\n              go_defs(di + 1)\\n            } else {\\n              let (vname, vtypes) = Array::get(variants, vi)\\n              if vname == ctor_name {\\n                Some((enum_name, vtypes))\\n              } else {\\n                go_variants(vi + 1)\\n              }\\n            }\\n          }\\n          go_variants(0)\\n        },\\n        _ => go_defs(di + 1)\\n      }\\n    }\\n  }\\n  go_defs(0)\\n}\\n\\nexport let rec check_pattern = (pat: Pat, scrutinee_ty: Type, env: TypeEnv, defs: Array[TypeDef]) -> TypeEnv {\\n  match pat {\\n    PWild => env,\\n    PBind(name) => env_bind(env, name, scrutinee_ty),\\n    PInt(_) => env,\\n    PString(_) => env,\\n    PBool(_) => env,\\n    PCtor(name, sub_pats) => {\\n      // Resolve builtin Option type: CtOption(elem) has ctors Some(elem) and None\\n      let builtin_payload = match scrutinee_ty {\\n        CtOption(elem) => if name == \\\"Some\\\" {\\n          Some([elem])\\n        } else if name == \\\"None\\\" {\\n          Some(Array::slice([CtUnknown], 0, 0))\\n        } else {\\n          None\\n        },\\n        _ => None\\n      }\\n      let ctor_payload = match builtin_payload {\\n        Some(types) => Some((\\\"Option\\\", types)),\\n        None => find_ctor_in_defs(defs, name)\\n      }\\n      match ctor_payload {\\n        Some(info) => {\\n          let (_, payload_types) = info\\n          let splen = Array::length(sub_pats)\\n          let ptlen = Array::length(payload_types)\\n          let rec bind_subs = (i: Int, acc_env: TypeEnv) -> TypeEnv {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let sub_ty = if i < ptlen {\\n                Array::get(payload_types, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(sub_pats, i), sub_ty, acc_env, defs)\\n              bind_subs(i + 1, next_env)\\n            }\\n          }\\n          bind_subs(0, env)\\n        },\\n        None => {\\n          let splen = Array::length(sub_pats)\\n          let rec bind_unknown = (i: Int, acc_env: TypeEnv) -> TypeEnv {\\n            if i >= splen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(sub_pats, i), CtUnknown, acc_env, defs)\\n              bind_unknown(i + 1, next_env)\\n            }\\n          }\\n          bind_unknown(0, env)\\n        }\\n      }\\n    },\\n    PTuple(pats) => {\\n      let plen = Array::length(pats)\\n      match scrutinee_ty {\\n        CtTuple(elem_tys) => {\\n          let elen = Array::length(elem_tys)\\n          let rec bind_tuple = (i: Int, acc_env: TypeEnv) -> TypeEnv {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let et = if i < elen {\\n                Array::get(elem_tys, i)\\n              } else {\\n                CtUnknown\\n              }\\n              let next_env = check_pattern(Array::get(pats, i), et, acc_env, defs)\\n              bind_tuple(i + 1, next_env)\\n            }\\n          }\\n          bind_tuple(0, env)\\n        },\\n        _ => {\\n          let rec bind_unk = (i: Int, acc_env: TypeEnv) -> TypeEnv {\\n            if i >= plen {\\n              acc_env\\n            } else {\\n              let next_env = check_pattern(Array::get(pats, i), CtUnknown, acc_env, defs)\\n              bind_unk(i + 1, next_env)\\n            }\\n          }\\n          bind_unk(0, env)\\n        }\\n      }\\n    },\\n    POr(left, _right) => check_pattern(left, scrutinee_ty, env, defs)\\n  }\\n}\\n\")\n\n  let source_26 = (\"vibe/compiler/checker/checker.vibe\",\n\"//# Imports\\n\\nimport .. / core / ast.vibe {\\n  Expr\\n}\\n\\nimport .. / core / types.vibe {\\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_lookup, find_typedef, fresh_var, generalize, instantiate, resolve_builtin, subst_add_bound, subst_apply, type_implements_trait, unify\\n}\\n\\nimport ./builtins.vibe {\\n  lookup_builtin\\n}\\n\\nimport ./checker_pattern.vibe {\\n  check_pattern\\n}\\n\\nimport ./checker_resolve.vibe {\\n  resolve_type_expr\\n}\\n\\n//# Functions\\n\\nlet min_int = (a: Int, b: Int) -> Int {\\n  if a < b {\\n    a\\n  } else {\\n    b\\n  }\\n}\\n\\nlet prepend_expr = (first: Expr, rest: Array[Expr]) -> Array[Expr] {\\n  let out = Array::slice([\\n    EUnit\\n  ], 0, 0)\\n  Array::push(out, first)\\n  let mut i = 0\\n  while i < Array::length(rest) {\\n    Array::push(out, Array::get(rest, i))\\n    i = i + 1\\n  }\\n  out\\n}\\n\\nlet is_logic_binop = (op: String) -> Bool {\\n  op == \\\"&&\\\"\\n  || op == \\\"||\\\"\\n}\\n\\nlet is_order_binop = (op: String) -> Bool {\\n  op == \\\"<\\\"\\n  || op == \\\">\\\"\\n  || op == \\\"<=\\\"\\n  || op == \\\">=\\\"\\n}\\n\\nlet type_name_prefix = (ty: Type) -> String {\\n  match ty {\\n    CtInt => \\\"Int\\\",\\n    CtDouble => \\\"Double\\\",\\n    CtBool => \\\"Bool\\\",\\n    CtString => \\\"String\\\",\\n    CtChar => \\\"Char\\\",\\n    CtUnit => \\\"Unit\\\",\\n    CtBytes => \\\"Bytes\\\",\\n    CtArray(_) => \\\"Array\\\",\\n    CtOption(_) => \\\"Option\\\",\\n    CtEnum(name) => name,\\n    CtStruct(name) => name,\\n    CtNamed(name, _) => name,\\n    _ => \\\"\\\"\\n  }\\n}\\n\\nlet is_equality_binop = (op: String) -> Bool {\\n  op == \\\"==\\\"\\n  || op == \\\"!=\\\"\\n}\\n\\nlet unify_binop_candidate = (left_ty: Type, right_ty: Type, target_ty: Type, s: Subst) -> Option[Subst] {\\n  match unify(left_ty, target_ty, s) {\\n    Some(s1) => unify(right_ty, target_ty, s1),\\n    None => None\\n  }\\n}\\n\\nlet unify_same_binop_operands = (left_ty: Type, right_ty: Type, s: Subst) -> Option[(Type, Subst)] {\\n  match unify(left_ty, right_ty, s) {\\n    Some(s1) => Some((subst_apply(s1, left_ty), s1)),\\n    None => None\\n  }\\n}\\n\\nlet infer_named_trait_binop = (env: TypeEnv, left_ty: Type, right_ty: Type, trait_name: String, s: Subst,) -> Option[(Type, Subst)] {\\n  match unify_same_binop_operands(left_ty, right_ty, s) {\\n    Some((resolved, s1)) => if type_implements_trait(env, s1, resolved, trait_name) {\\n      Some((resolved, s1))\\n    } else {\\n      None\\n    },\\n    None => None\\n  }\\n}\\n\\nlet infer_binop_type = (op: String, left_ty: Type, right_ty: Type, env: TypeEnv, s: Subst, errors: Array[String]) -> (Type, Subst) {\\n  if is_logic_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtBool, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Bool\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_equality_binop(op) {\\n    match unify(left_ty, right_ty, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must have same type\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if is_order_binop(op) {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtBool, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtBool, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Ord\\\", s) {\\n          Some((_, s1)) => (CtBool, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"+\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match unify_binop_candidate(left_ty, right_ty, CtString, s) {\\n          Some(s1) => (CtString, s1),\\n          None => match infer_named_trait_binop(env, left_ty, right_ty, \\\"Add\\\", s) {\\n            Some((resolved, s1)) => (resolved, s1),\\n            None => {\\n              Array::push(errors, \\\"type mismatch in '+': operands must be Int, Double, or String\\\")\\n              (CtUnknown, s)\\n            }\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"-\\\"\\n  || op == \\\"*\\\"\\n  || op == \\\"/\\\" {\\n    let trait_name = if op == \\\"-\\\" {\\n      \\\"Sub\\\"\\n    } else if op == \\\"*\\\" {\\n      \\\"Mul\\\"\\n    } else {\\n      \\\"Div\\\"\\n    }\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => match unify_binop_candidate(left_ty, right_ty, CtDouble, s) {\\n        Some(s1) => (CtDouble, s1),\\n        None => match infer_named_trait_binop(env, left_ty, right_ty, trait_name, s) {\\n          Some((resolved, s1)) => (resolved, s1),\\n          None => {\\n            Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int or Double\\\")))\\n            (CtUnknown, s)\\n          }\\n        }\\n      }\\n    }\\n  }\\n  else if op == \\\"%\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, \\\"type mismatch in '%': operands must be Int\\\")\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else if op == \\\"&\\\" || op == \\\"|\\\" || op == \\\"^\\\" || op == \\\"<<\\\" || op == \\\">>\\\" {\\n    match unify_binop_candidate(left_ty, right_ty, CtInt, s) {\\n      Some(s1) => (CtInt, s1),\\n      None => {\\n        Array::push(errors, String::concat(\\\"type mismatch in '\\\", String::concat(op, \\\"': operands must be Int\\\")))\\n        (CtUnknown, s)\\n      }\\n    }\\n  }\\n  else {\\n    Array::push(errors, String::concat(\\\"unknown operator: \\\", op))\\n    (CtUnknown, s)\\n  }\\n}\\n\\nexport let rec check_expr = (expr: Expr, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String]) -> (Type, Subst, Int) {\\n  match expr {\\n    EInt(_) => (CtInt, s, c),\\n    EFloat(_) => (CtDouble, s, c),\\n    EString(_) => (CtString, s, c),\\n    EBool(_) => (CtBool, s, c),\\n    EUnit => (CtUnit, s, c),\\n    EIdent(name) => match env_lookup(env, name) {\\n      Some(t) => {\\n        let (ti, c1, new_bounds) = instantiate(t, c)\\n        let nblen = Array::length(new_bounds)\\n        let mut s1 = s\\n        let mut bi = 0\\n        while bi < nblen {\\n          let (vid, bounds) = Array::get(new_bounds, bi)\\n          if !eq(Array::length(bounds), 0) {\\n            s1 = subst_add_bound(s1, vid, bounds)\\n          }\\n          bi = bi + 1\\n        }\\n        (ti, s1, c1)\\n      },\\n      None => match lookup_builtin(name) {\\n        Some(t) => (t, s, c),\\n        None => {\\n          Array::push(errors, String::concat(\\\"unknown name: \\\", name))\\n          (CtUnknown, s, c)\\n        }\\n      }\\n    },\\n    ESeq(left, right) => {\\n      let (_, s1, c1) = check_expr(left, env, defs, s, c, errors)\\n      check_expr(right, env, defs, s1, c1, errors)\\n    },\\n    ELet(name, val, body) => {\\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)\\n      let gen = generalize(s1, vt)\\n      check_expr(body, env_bind(env, name, gen), defs, s1, c1, errors)\\n    },\\n    ELetRec(name, val, body) => {\\n      let (tv, c1) = fresh_var(c)\\n      let (vt, s1, c2) = check_expr(val, env_bind(env, name, tv), defs, s, c1, errors)\\n      let s2 = match unify(tv, vt, s1) {\\n        Some(su) => su,\\n        None => s1\\n      }\\n      let gen = generalize(s2, tv)\\n      check_expr(body, env_bind(env, name, gen), defs, s2, c2, errors)\\n    },\\n    ELetMut(name, val, body) => {\\n      let (vt, s1, c1) = check_expr(val, env, defs, s, c, errors)\\n      check_expr(body, env_bind(env, name, vt), defs, s1, c1, errors)\\n    },\\n    EIf(cond, then_e, else_e) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"if condition must be Bool\\\")\\n      }\\n      let (tt, s2, c2) = check_expr(then_e, env, defs, s1, c1, errors)\\n      let (_, s3, c3) = check_expr(else_e, env, defs, s2, c2, errors)\\n      (tt, s3, c3)\\n    },\\n    ECall(callee, args) => match callee {\\n      EDot(obj, method) => {\\n        let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)\\n        let resolved = subst_apply(s1, obj_ty)\\n        let type_prefix = type_name_prefix(resolved)\\n        let qualified = String::concat(type_prefix, String::concat(\\\"::\\\", method))\\n        let method_ty = match env_lookup(env, qualified) {\\n          Some(t) => {\\n            let (ti, c2, _) = instantiate(t, c1)\\n            (ti, s1, c2)\\n          },\\n          None => match lookup_builtin(qualified) {\\n            Some(t) => (t, s1, c1),\\n            None => (CtUnknown, s1, c1)\\n          }\\n        }\\n        let (mt, s2, c2) = method_ty\\n        let all_args = prepend_expr(obj, args)\\n        let alen = Array::length(all_args)\\n        let arg_tys = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        Array::push(arg_tys, obj_ty)\\n        let mut ai = 1\\n        let mut s3 = s2\\n        let mut c3 = c2\\n        while ai < alen {\\n          let (at, ns, nc) = check_expr(Array::get(all_args, ai), env, defs, s3, c3, errors)\\n          Array::push(arg_tys, at)\\n          s3 = ns\\n          c3 = nc\\n          ai = ai + 1\\n        }\\n        match subst_apply(s3, mt) {\\n          CtFn(param_tys, ret, _) => {\\n            let plen = Array::length(param_tys)\\n            let alen2 = Array::length(arg_tys)\\n            if alen2 != plen {\\n              Array::push(errors, String::concat(\\\"function arity mismatch: expected \\\", String::concat(__to_string(plen), String::concat(\\\" args, got \\\", __to_string(alen2)))))\\n            }\\n            let mut s4 = s3\\n            let mut ui = 0\\n            while ui < plen {\\n              s4 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s4) {\\n                Some(su) => su,\\n                None => s4\\n              }\\n              ui = ui + 1\\n            }\\n            (subst_apply(s4, ret), s4, c3)\\n          },\\n          _ => (CtUnknown, s3, c3)\\n        }\\n      },\\n      _ => {\\n        let (ct, s1, c1) = check_expr(callee, env, defs, s, c, errors)\\n        let alen = Array::length(args)\\n        let arg_tys = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut ai = 0\\n        let mut s2 = s1\\n        let mut c2 = c1\\n        while ai < alen {\\n          let (at, ns, nc) = check_expr(Array::get(args, ai), env, defs, s2, c2, errors)\\n          Array::push(arg_tys, at)\\n          s2 = ns\\n          c2 = nc\\n          ai = ai + 1\\n        }\\n        match subst_apply(s2, ct) {\\n          CtFn(param_tys, ret, _) => {\\n            let plen2 = Array::length(param_tys)\\n            let alen3 = Array::length(arg_tys)\\n            if alen3 != plen2 {\\n              Array::push(errors, String::concat(\\\"function arity mismatch: expected \\\", String::concat(__to_string(plen2), String::concat(\\\" args, got \\\", __to_string(alen3)))))\\n            }\\n            let mut s3 = s2\\n            let mut ui = 0\\n            let ul = min_int(alen3, plen2)\\n            while ui < ul {\\n              s3 = match unify(Array::get(param_tys, ui), Array::get(arg_tys, ui), s3) {\\n                Some(su) => su,\\n                None => s3\\n              }\\n              ui = ui + 1\\n            }\\n            (subst_apply(s3, ret), s3, c2)\\n          },\\n          CtStruct(sname) => (CtStruct(sname), s2, c2),\\n          _ => (CtUnknown, s2, c2)\\n        }\\n      }\\n    },\\n    EBinOp(op, left, right) => {\\n      let (left_ty, s1, c1) = check_expr(left, env, defs, s, c, errors)\\n      let (right_ty, s2, c2) = check_expr(right, env, defs, s1, c1, errors)\\n      let (result_ty, s3) = infer_binop_type(op, subst_apply(s2, left_ty), subst_apply(s2, right_ty), env, s2, errors)\\n      (subst_apply(s3, result_ty), s3, c2)\\n    },\\n    EUnaryOp(op, operand) => {\\n      let (operand_ty, s1, c1) = check_expr(operand, env, defs, s, c, errors)\\n      if op == \\\"!\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtBool => (CtBool, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtBool, s1) {\\n            Some(s2) => (CtBool, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          _ => (CtUnknown, s1, c1)\\n        }\\n      } else if op == \\\"-\\\" {\\n        match subst_apply(s1, operand_ty) {\\n          CtDouble => (CtDouble, s1, c1),\\n          CtInt => (CtInt, s1, c1),\\n          CtVar(_) => match unify(operand_ty, CtInt, s1) {\\n            Some(s2) => (CtInt, s2, c1),\\n            None => (CtUnknown, s1, c1)\\n          },\\n          _ => (CtUnknown, s1, c1)\\n        }\\n      } else (CtUnknown, s1, c1)\\n    },\\n    EAssign(_, val, body) => {\\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)\\n      check_expr(body, env, defs, s1, c1, errors)\\n    },\\n    EAssignOp(_, _, val, body) => {\\n      let (_, s1, c1) = check_expr(val, env, defs, s, c, errors)\\n      check_expr(body, env, defs, s1, c1, errors)\\n    },\\n    EMatch(scrutinee, arms) => {\\n      let (scr_ty, s1, c1) = check_expr(scrutinee, env, defs, s, c, errors)\\n      let alen = Array::length(arms)\\n      if eq(alen, 0) {\\n        (CtUnknown, s1, c1)\\n      }\\n      else {\\n        let mut result_ty = CtUnknown\\n        let mut si = s1\\n        let mut ci = c1\\n        let mut ai = 0\\n        while ai < alen {\\n          let (pat, body) = Array::get(arms, ai)\\n          let arm_env = check_pattern(pat, scr_ty, env, defs)\\n          let (arm_ty, ns, nc) = check_expr(body, arm_env, defs, si, ci, errors)\\n          if eq(ai, 0) {\\n            result_ty = arm_ty\\n          }\\n          si = ns\\n          ci = nc\\n          ai = ai + 1\\n        }\\n        (result_ty, si, ci)\\n      }\\n    },\\n    EHandle(body, _) => check_expr(body, env, defs, s, c, errors),\\n    EWhile(cond, body) => {\\n      let (ct, s1, c1) = check_expr(cond, env, defs, s, c, errors)\\n      let resolved_ct = subst_apply(s1, ct)\\n      match resolved_ct {\\n        CtBool => (),\\n        CtUnknown => (),\\n        CtVar(_) => (),\\n        _ => Array::push(errors, \\\"while condition must be Bool\\\")\\n      }\\n      let (_, s2, c2) = check_expr(body, env, defs, s1, c1, errors)\\n      (CtUnit, s2, c2)\\n    },\\n    ELoop(params, body) => {\\n      let mut env1 = env\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut i = 0\\n      while i < Array::length(params) {\\n        let (name, init) = Array::get(params, i)\\n        let (pt, ns, nc) = check_expr(init, env1, defs, s1, c1, errors)\\n        env1 = env_bind(env1, name, pt)\\n        s1 = ns\\n        c1 = nc\\n        i = i + 1\\n      }\\n      let (_, s2, c2) = check_expr(body, env1, defs, s1, c1, errors)\\n      (CtUnit, s2, c2)\\n    },\\n    EForIn(name, index_name, iterable, body) => {\\n      let (it, s1, c1) = check_expr(iterable, env, defs, s, c, errors)\\n      let et = match it {\\n        CtArray(elem) => elem,\\n        _ => CtUnknown\\n      }\\n      let env2 = env_bind(env, name, et)\\n      let env3 = match index_name {\\n        Some(index_name) => env_bind(env2, index_name, CtInt),\\n        None => env2\\n      }\\n      let (bt, s2, c2) = check_expr(body, env3, defs, s1, c1, errors)\\n      (CtArray(bt), s2, c2)\\n    },\\n    EDot(obj, field) => {\\n      let (obj_ty, s1, c1) = check_expr(obj, env, defs, s, c, errors)\\n      let resolved = subst_apply(s1, obj_ty)\\n      let field_ty = match resolved {\\n        CtStruct(sname) => match find_typedef(defs, sname) {\\n          Some(td) => match td {\\n            TDStruct(_, fields) => {\\n              let rec find_field = (i: Int) -> Type {\\n                if i >= Array::length(fields) {\\n                  CtUnknown\\n                } else {\\n                  let (fname, ftype) = Array::get(fields, i)\\n                  if fname == field {\\n                    ftype\\n                  } else find_field(i + 1)\\n                }\\n              }\\n              find_field(0)\\n            },\\n            _ => CtUnknown\\n          },\\n          None => CtUnknown\\n        },\\n        _ => CtUnknown\\n      }\\n      (field_ty, s1, c1)\\n    },\\n    EFn(tparams, tbounds, params, ret_ty, effect, body) => {\\n      let tplen = Array::length(tparams)\\n      let mut tp_env = env\\n      let mut s0 = s\\n      let mut c0 = c\\n      let mut tpi = 0\\n      while tpi < tplen {\\n        let tpname = Array::get(tparams, tpi)\\n        match fresh_var(c0) {\\n          (tv, nc) => {\\n            let vid = nc - 1\\n            let tblen = Array::length(tbounds)\\n            let mut bounds = Array::slice([\\n              \\\"\\\"\\n            ], 0, 0)\\n            let mut tbi = 0\\n            let mut found_bounds = false\\n            while tbi < tblen {\\n              let (bname, blist) = Array::get(tbounds, tbi)\\n              if !found_bounds && bname == tpname {\\n                bounds = blist\\n                found_bounds = true\\n              }\\n              tbi = tbi + 1\\n            }\\n            s0 = if eq(Array::length(bounds), 0) {\\n              s0\\n            } else subst_add_bound(s0, vid, bounds)\\n            tp_env = env_bind(tp_env, tpname, tv)\\n            c0 = nc\\n          },\\n          _ => ()\\n        }\\n        tpi = tpi + 1\\n      }\\n      let plen = Array::length(params)\\n      let mut fn_env = tp_env\\n      let mut s1 = s0\\n      let mut c1 = c0\\n      let param_types = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut pi = 0\\n      while pi < plen {\\n        let (raw_name, ann) = Array::get(params, pi)\\n        let nlen = String::length(raw_name)\\n        let name = if nlen > 0 {\\n          let lc = String::char_code_at(raw_name, nlen - 1)\\n          if lc == '~' || lc == '?' {\\n            raw_name[0: nlen - 1]\\n          } else raw_name\\n        } else raw_name\\n        let (pt, ns, nc) = match ann {\\n          Some(te) => {\\n            let resolved = resolve_type_expr(te, defs)\\n            let pt2 = match resolved {\\n              CtNamed(tn, _) => match env_lookup(fn_env, tn) {\\n                Some(t) => t,\\n                None => resolved\\n              },\\n              _ => resolved\\n            }\\n            (pt2, s1, c1)\\n          },\\n          None => {\\n            let (tv, nc2) = fresh_var(c1)\\n            (tv, s1, nc2)\\n          }\\n        }\\n        fn_env = env_bind(fn_env, name, pt)\\n        Array::push(param_types, pt)\\n        s1 = ns\\n        c1 = nc\\n        pi = pi + 1\\n      }\\n      let (bt, s2, c2) = check_expr(body, fn_env, defs, s1, c1, errors)\\n      let (final_ret, s3) = match ret_ty {\\n        Some(te) => {\\n          let resolved = resolve_type_expr(te, defs)\\n          let resolved_ret = match resolved {\\n            CtNamed(tn, _) => match env_lookup(fn_env, tn) {\\n              Some(t) => t,\\n              None => resolved\\n            },\\n            _ => resolved\\n          }\\n          match unify(bt, resolved_ret, s2) {\\n            Some(ns) => (subst_apply(ns, resolved_ret), ns),\\n            None => {\\n              Array::push(errors, String::concat(\\\"return type mismatch: expected \\\", String::concat(type_to_string(resolved_ret), String::concat(\\\", got \\\", type_to_string(bt)))))\\n              (CtUnknown, s2)\\n            }\\n          }\\n        },\\n        None => (subst_apply(s2, bt), s2)\\n      }\\n      let resolved_params = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut rpi = 0\\n      while rpi < Array::length(param_types) {\\n        Array::push(resolved_params, subst_apply(s3, Array::get(param_types, rpi)))\\n        rpi = rpi + 1\\n      }\\n      (CtFn(resolved_params, final_ret, effect), s3, c2)\\n    },\\n    EBreak(opt) => match opt {\\n      Some(e) => {\\n        let (_, s1, c1) = check_expr(e, env, defs, s, c, errors)\\n        (CtUnit, s1, c1)\\n      },\\n      None => (CtUnit, s, c)\\n    },\\n    EContinue(args) => {\\n      let alen = Array::length(args)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut ai = 0\\n      while ai < alen {\\n        let (_, ns, nc) = check_expr(Array::get(args, ai), env, defs, s1, c1, errors)\\n        s1 = ns\\n        c1 = nc\\n        ai = ai + 1\\n      }\\n      (CtUnit, s1, c1)\\n    },\\n    ERecord(fields) => {\\n      let flen = Array::length(fields)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut fi = 0\\n      while fi < flen {\\n        let (_, fval) = Array::get(fields, fi)\\n        let (_, ns, nc) = check_expr(fval, env, defs, s1, c1, errors)\\n        s1 = ns\\n        c1 = nc\\n        fi = fi + 1\\n      }\\n      (CtUnknown, s1, c1)\\n    },\\n    ETuple(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let tys = Array::slice([\\n        CtUnknown\\n      ], 0, 0)\\n      let mut ti = 0\\n      while ti < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ti), env, defs, s1, c1, errors)\\n        Array::push(tys, it)\\n        s1 = ns\\n        c1 = nc\\n        ti = ti + 1\\n      }\\n      (CtTuple(tys), s1, c1)\\n    },\\n    EArray(items) => {\\n      let ilen = Array::length(items)\\n      let mut s1 = s\\n      let mut c1 = c\\n      let mut elem_ty = CtUnknown\\n      let mut ai = 0\\n      while ai < ilen {\\n        let (it, ns, nc) = check_expr(Array::get(items, ai), env, defs, s1, c1, errors)\\n        if eq(ai, 0) {\\n          elem_ty = it\\n        }\\n        s1 = ns\\n        c1 = nc\\n        ai = ai + 1\\n      }\\n      (CtArray(elem_ty), s1, c1)\\n    },\\n    _ => (CtUnknown, s, c)\\n  }\\n}\\n\")\n\n  let source_27 = (\"vibe/compiler/checker/checker_stmt.vibe\",\n\"//# Imports\\n\\nimport .. / checker_trait.vibe {\\n  register_builtin_traits\\n}\\n\\nimport .. / core / ast.vibe {\\n  Stmt\\n}\\n\\nimport .. / core / types.vibe {\\n  Subst, Type, TypeDef, TypeEnv, env_bind, env_cache, env_flat_bindings, env_lookup_flat, generalize, impls_overlap_for, resolve_builtin, subst_apply, trait_defined\\n}\\n\\nimport ./checker.vibe {\\n  check_expr\\n}\\n\\nimport ./checker_resolve.vibe {\\n  resolve_type_expr\\n}\\n\\n//# Functions\\n\\nlet rec import_cache_lookup = (cache: Array[(String, Type)], name: String, i: Int) -> Option[Type] {\\n  if i >= Array::length(cache) {\\n    None\\n  }\\n  else {\\n    let (cached_name, cached_ty) = Array::get(cache, i)\\n    if cached_name == name {\\n      Some(cached_ty)\\n    }\\n    else import_cache_lookup(cache, name, i + 1)\\n  }\\n}\\n\\nlet bind_stmt_imports = (env: TypeEnv, names: Array[(String, Option[String])]) -> TypeEnv {\\n  let env_bindings = env_flat_bindings(env)\\n  let import_cache = Array::slice([\\n    (\\\"\\\", CtUnknown)\\n  ], 0, 0)\\n  let nlen = Array::length(names)\\n  let rec bind_imports = (i: Int, acc: TypeEnv) -> TypeEnv {\\n    if i >= nlen {\\n      acc\\n    }\\n    else {\\n      let (name, alias) = Array::get(names, i)\\n      let bound_name = match alias {\\n        Some(a) => a,\\n        None => name\\n      }\\n      let ty = match import_cache_lookup(import_cache, name, 0) {\\n        Some(t) => t,\\n        None => {\\n          let resolved = match env_lookup_flat(env_bindings, name) {\\n            Some(t) => t,\\n            None => CtUnknown\\n          }\\n          Array::push(import_cache, (name, resolved))\\n          resolved\\n        }\\n      }\\n      bind_imports(i + 1, env_bind(acc, bound_name, ty))\\n    }\\n  }\\n  bind_imports(0, env)\\n}\\n\\nexport let rec check_stmts = (stmts: Array[Stmt], i: Int, env: TypeEnv, defs: Array[TypeDef], s: Subst, c: Int, errors: Array[String]) -> (TypeEnv, Subst, Int) {\\n  if i >= Array::length(stmts) {\\n    (env, s, c)\\n  } else {\\n    let stmt = Array::get(stmts, i)\\n    let (new_env, s1, c1) = match stmt {\\n      SLet(_, is_rec, name, ann, val) => {\\n        let (vt, ns, nc) = if is_rec {\\n          check_expr(val, env_bind(env, name, CtUnknown), defs, s, c, errors)\\n        } else {\\n          check_expr(val, env, defs, s, c, errors)\\n        }\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => generalize(ns, vt)\\n        }\\n        (env_bind(env, name, t), ns, nc)\\n      },\\n      SLetMut(name, ann, val) => {\\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)\\n        let t = match ann {\\n          Some(te) => resolve_type_expr(te, defs),\\n          None => vt\\n        }\\n        (env_bind(env, name, t), ns, nc)\\n      },\\n      SLetPat(pat, val) => {\\n        let (vt, ns, nc) = check_expr(val, env, defs, s, c, errors)\\n        let new_env = match pat {\\n          PTuple(pats) => match vt {\\n            CtTuple(types) => {\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => if pi < Array::length(types) {\\n                    e = env_bind(e, name, Array::get(types, pi))\\n                  } else {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            },\\n            _ => {\\n              let mut e = env\\n              let mut pi = 0\\n              while pi < Array::length(pats) {\\n                match Array::get(pats, pi) {\\n                  PBind(name) => {\\n                    e = env_bind(e, name, CtUnknown)\\n                  },\\n                  _ => ()\\n                }\\n                pi = pi + 1\\n              }\\n              e\\n            }\\n          },\\n          PBind(name) => env_bind(env, name, vt),\\n          _ => env\\n        }\\n        (new_env, ns, nc)\\n      },\\n      SEnum(_, name, variants) => {\\n        let resolved_variants = Array::slice([\\n          (\\\"\\\", Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        ], 0, 0)\\n        let mut vi = 0\\n        while vi < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, vi)\\n          let resolved_vtypes = Array::slice([\\n            CtUnknown\\n          ], 0, 0)\\n          let mut ti = 0\\n          while ti < Array::length(vtypes) {\\n            let vt = resolve_type_expr(Array::get(vtypes, ti), defs)\\n            Array::push(resolved_vtypes, vt)\\n            ti = ti + 1\\n          }\\n          Array::push(resolved_variants, (vname, resolved_vtypes))\\n          vi = vi + 1\\n        }\\n        Array::push(defs, TDEnum(name, resolved_variants))\\n        let mut env1 = env_bind(env, name, CtEnum(name))\\n        let mut ci2 = 0\\n        while ci2 < Array::length(variants) {\\n          let (vname, vtypes) = Array::get(variants, ci2)\\n          if eq(Array::length(vtypes), 0) {\\n            env1 = env_bind(env1, vname, CtEnum(name))\\n          } else {\\n            let resolved_args = Array::slice([\\n              CtUnknown\\n            ], 0, 0)\\n            let mut ai = 0\\n            while ai < Array::length(vtypes) {\\n              Array::push(resolved_args, resolve_type_expr(Array::get(vtypes, ai), defs))\\n              ai = ai + 1\\n            }\\n            env1 = env_bind(env1, vname, CtFn(resolved_args, CtEnum(name), None))\\n          }\\n          ci2 = ci2 + 1\\n        }\\n        (env1, s, c)\\n      },\\n      SStruct(_, name, field_defs) => {\\n        let resolved_fields = Array::slice([\\n          (\\\"\\\", CtUnit)\\n        ], 0, 0)\\n        let mut fi = 0\\n        while fi < Array::length(field_defs) {\\n          let (fname, ftype_expr) = Array::get(field_defs, fi)\\n          let ftype = resolve_type_expr(ftype_expr, defs)\\n          Array::push(resolved_fields, (fname, ftype))\\n          fi = fi + 1\\n        }\\n        Array::push(defs, TDStruct(name, resolved_fields))\\n        let field_types = Array::slice([\\n          CtUnknown\\n        ], 0, 0)\\n        let mut fj = 0\\n        while fj < Array::length(resolved_fields) {\\n          let (_, fty) = Array::get(resolved_fields, fj)\\n          Array::push(field_types, fty)\\n          fj = fj + 1\\n        }\\n        (env_bind(env, name, CtFn(field_types, CtStruct(name), None)), s, c)\\n      },\\n      STypeAlias(_, name, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        (env_bind(env, name, t), s, c)\\n      },\\n      SExternLet(name, te) => {\\n        let t = resolve_type_expr(te, defs)\\n        (env_bind(env, name, t), s, c)\\n      },\\n      STest(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)\\n        (env, ns, nc)\\n      },\\n      SBench(_, body) => {\\n        let (_, ns, nc) = check_expr(body, env, defs, s, c, errors)\\n        (env, ns, nc)\\n      },\\n      SExpr(expr) => {\\n        let (_, ns, nc) = check_expr(expr, env, defs, s, c, errors)\\n        (env, ns, nc)\\n      },\\n      SModule(_, _, body) => {\\n        let _ = check_stmts(body, 0, env, defs, s, c, errors)\\n        (env, s, c)\\n      },\\n      SImport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SReExport(_, names) => (bind_stmt_imports(env, names), s, c)\\n      ,\\n      SAliasDecl(_, _) => (env, s, c)\\n      ,\\n      STrait(_, name, supers) => {\\n        let is_open = false\\n        (EnvTraitDef(name, supers, is_open, env), s, c)\\n      },\\n      SImpl(_, _, trait_name, type_name) => {\\n        let target = match resolve_builtin(type_name) {\\n          Some(t) => t,\\n          None => CtNamed(type_name, Array::slice([\\n            CtUnknown\\n          ], 0, 0))\\n        }\\n        (EnvTraitImpl(trait_name, target, env), s, c)\\n      },\\n      _ => (env, s, c)\\n    }\\n    check_stmts(stmts, i + 1, new_env, defs, s1, c1, errors)\\n  }\\n}\\n\\nexport let check_program = (stmts: Array[Stmt]) -> TypeEnv with { Error } {\\n  let empty_defs = Array::slice([\\n    TDAlias(\\\"_dummy\\\", CtUnit)\\n  ], 0, 0)\\n  let seeded_env = if trait_defined(EnvEmpty, \\\"Eq\\\") {\\n    EnvEmpty\\n  } else {\\n    register_builtin_traits(EnvEmpty)\\n  }\\n  let errors = ArrayBuilder::new()\\n  let frozen_errors = ArrayBuilder::freeze(errors)\\n  let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)\\n  if Array::length(frozen_errors) > 0 {\\n    throw(Array::get(frozen_errors, 0))\\n  }\\n  env\\n}\\n\\nexport let check_program_with_env = (stmts: Array[Stmt], initial_env: TypeEnv) -> TypeEnv with { Error } {\\n  match initial_env {\\n    EnvEmpty => check_program(stmts),\\n    _ => {\\n      let empty_defs = Array::slice([\\n        TDAlias(\\\"_dummy\\\", CtUnit)\\n      ], 0, 0)\\n      let cached_env = env_cache(initial_env)\\n      let seeded_env = if trait_defined(cached_env, \\\"Eq\\\") {\\n        cached_env\\n      } else {\\n        register_builtin_traits(cached_env)\\n      }\\n      let errors = ArrayBuilder::new()\\n      let frozen_errors = ArrayBuilder::freeze(errors)\\n      let (env, _, _) = check_stmts(stmts, 0, seeded_env, empty_defs, SubstEmpty, 0, frozen_errors)\\n      if Array::length(frozen_errors) > 0 {\\n        throw(Array::get(frozen_errors, 0))\\n      }\\n      env\\n    }\\n  }\\n}\\n\")\n\n  let source_28 = (\"vibe/compiler/codegen/wasm_emit/index.vibe\",\n\"export ./sections.vibe {\\n  emit_header, emit_func_type, emit_type_section_multi, emit_type_section,\\n  emit_function_section, emit_name, emit_export_section_multi, emit_export_section,\\n  emit_memory_section, emit_code_section, emit_code_section_with_locals,\\n  emit_i32_const, emit_end, emit_func_type_raw, emit_import_section_func,\\n  emit_data_section, emit_global_section_i32_mut, emit_global_get, emit_global_set,\\n  emit_export_memory, emit_exports_with_memory, emit_exports_full\\n}\\n\\nexport ./instructions.vibe {\\n  emit_local_get, emit_local_set, emit_local_tee,\\n  emit_i64_const, emit_i64_add, emit_i64_sub, emit_i64_mul, emit_i64_div_s,\\n  emit_i64_rem_s, emit_i64_and, emit_i64_or, emit_i64_xor, emit_i64_shl,\\n  emit_i64_shr_s, emit_i64_eq, emit_i64_ne, emit_i64_lt_s, emit_i64_gt_s,\\n  emit_i64_le_s, emit_i64_ge_s, emit_i64_eqz, emit_call, emit_drop,\\n  emit_return, emit_block_void, emit_block_i64, emit_loop_void, emit_if_void,\\n  emit_if_i64, emit_else, emit_br, emit_br_if, emit_i64_extend_i32_s,\\n  emit_i32_wrap_i64, emit_i32_add, emit_i32_store, emit_i32_load,\\n  emit_i32_store8, emit_i32_load8_u, emit_f64_const_bits, emit_f64_add,\\n  emit_f64_sub, emit_f64_mul, emit_f64_div, emit_f64_eq, emit_f64_ne,\\n  emit_f64_lt, emit_f64_gt, emit_f64_le, emit_f64_ge, emit_f64_neg,\\n  emit_i64_reinterpret_f64, emit_f64_reinterpret_i64, emit_i64_trunc_f64_s,\\n  emit_f64_convert_i64_s, emit_call_indirect, emit_table_section_funcref,\\n  emit_element_section_active, emit_struct_type_raw, emit_struct_new,\\n  emit_struct_get, emit_struct_set, emit_ref_func, emit_call_ref, emit_ref_null\\n}\\n\\nexport ./builders.vibe {\\n  build_add_module, build_call_module, build_arithmetic_module,\\n  build_fibonacci_module, build_factorial_module, build_hello_module,\\n  string_to_data, emit_data_section_multi, build_print_string_module\\n}\\n\\nexport ./simd.vibe {\\n  emit_v128_load, emit_v128_store, emit_i8x16_splat, emit_i8x16_eq,\\n  emit_v128_any_true, emit_i8x16_all_true, emit_i8x16_bitmask,\\n  emit_v128_and, emit_v128_not, emit_v128_const_zero, emit_v128_const_splat_byte\\n}\\n\\nexport ./simd_patterns.vibe {\\n  emit_simd_memcmp_16, emit_simd_find_byte_16,\\n  emit_scalar_memcmp_16_unrolled, emit_scalar_find_byte_16_unrolled\\n}\\n\")\n\n  let source_29 = (\"vibe/compiler/codegen/wasm_emit/sections.vibe\",\n\"//# Imports\\n\\nexport ./base.vibe {\\n  emit_code_section, emit_code_section_with_locals, emit_end, emit_export_section, emit_export_section_multi, emit_func_type, emit_function_section, emit_header, emit_i32_const, emit_memory_section, emit_name, emit_type_section, emit_type_section_multi\\n}\\n\\nexport ./extra.vibe {\\n  emit_data_section, emit_export_memory, emit_exports_full, emit_exports_with_memory, emit_func_type_raw, emit_global_get, emit_global_section_i32_mut, emit_global_set, emit_import_section_func\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_global_get, emit_global_set, emit_code_section, emit_data_section, emit_exports_full, emit_type_section, emit_export_memory, emit_func_type_raw, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_exports_with_memory, emit_import_section_func, emit_export_section_multi, emit_global_section_i32_mut, emit_code_section_with_locals\\n}\\n\")\n\n  let source_30 = (\"vibe/compiler/codegen/wasm_emit/base.vibe\",\n\"//# Imports\\n\\nexport ./code_helpers.vibe {\\n  emit_code_section, emit_code_section_with_locals, emit_end, emit_i32_const, emit_memory_section\\n}\\n\\nexport ./header_types.vibe {\\n  emit_export_section, emit_export_section_multi, emit_func_type, emit_function_section, emit_header, emit_name, emit_type_section, emit_type_section_multi\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_end, emit_name, emit_header, emit_func_type, emit_i32_const, emit_code_section, emit_type_section, emit_export_section, emit_memory_section, emit_function_section, emit_type_section_multi, emit_export_section_multi, emit_code_section_with_locals\\n}\\n\")\n\n  let source_31 = (\"vibe/compiler/codegen/wasm_emit/header_types.vibe\",\n\"//# Imports\\n\\nexport ./header_core.vibe {\\n  emit_func_type, emit_header, emit_type_section, emit_type_section_multi\\n}\\n\\nexport ./header_exports.vibe {\\n  emit_export_section, emit_export_section_multi, emit_function_section, emit_name\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_name, emit_header, emit_func_type, emit_type_section, emit_export_section, emit_function_section, emit_type_section_multi, emit_export_section_multi\\n}\\n\")\n\n  let source_32 = (\"vibe/compiler/codegen/wasm_emit/header_core.vibe\",\n\"//# Imports\\n\\nexport ./header_magic.vibe {\\n  emit_header\\n}\\n\\nexport ./header_type_sections.vibe {\\n  emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\\n//# Misc\\n\\nexport {\\n  emit_header, emit_func_type, emit_type_section, emit_type_section_multi\\n}\\n\")\n\n  let source_33 = (\"vibe/compiler/codegen/wasm_emit/header_magic.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_push, bytebuf_push3\\n}\\n\\n//# Functions\\n\\nexport let emit_header = (buf: Bytes) -> Unit {\\n  bytebuf_push3(buf, 0, 97, 115)\\n  bytebuf_push3(buf, 109, 1, 0)\\n  bytebuf_push(buf, 0)\\n  bytebuf_push(buf, 0)\\n}\\n\")\n\n  let source_34 = (\"vibe/compiler/codegen/wasm_emit/header_type_sections.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport let emit_func_type = (buf: Bytes, param_count: Int, result_count: Int) -> Unit {\\n  bytebuf_push(buf, 96)\\n  leb128_encode_u32(buf, param_count)\\n  let mut i = 0\\n  while i < param_count {\\n    bytebuf_push(buf, 126)\\n    i = i + 1\\n  }\\n  leb128_encode_u32(buf, result_count)\\n  let mut j = 0\\n  while j < result_count {\\n    bytebuf_push(buf, 126)\\n    j = j + 1\\n  }\\n}\\n\\nexport let emit_type_section_multi = (out: Bytes, type_defs: Array[Int]) -> Unit {\\n  let count = Array::length(type_defs) / 2\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_func_type(content, Array::get(type_defs, i * 2), Array::get(type_defs, (i * 2) + 1))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 1, content)\\n}\\n\\nexport let emit_type_section = (out: Bytes, param_count: Int, result_count: Int) -> Unit {\\n  let type_defs = Array::slice([\\n    0\\n  ], 0, 0)\\n  Array::push(type_defs, param_count)\\n  Array::push(type_defs, result_count)\\n  emit_type_section_multi(out, type_defs)\\n}\\n\")\n\n  let source_35 = (\"vibe/compiler/codegen/wasm_emit/header_exports.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_new, bytebuf_push, bytebuf_push_section, bytebuf_push_string, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport let emit_name = (buf: Bytes, name: String) -> Unit {\\n  bytebuf_push_string(buf, name)\\n}\\n\\nexport let emit_function_section = (out: Bytes, type_indices: Array[Int]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(type_indices))\\n  let mut i = 0\\n  while i < Array::length(type_indices) {\\n    leb128_encode_u32(content, Array::get(type_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 3, content)\\n}\\n\\nexport let emit_export_section_multi = (out: Bytes, names: Array[String], func_indices: Array[Int]) -> Unit {\\n  let count = Array::length(names)\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, count)\\n  let mut i = 0\\n  while i < count {\\n    emit_name(content, Array::get(names, i))\\n    bytebuf_push(content, 0)\\n    leb128_encode_u32(content, Array::get(func_indices, i))\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 7, content)\\n}\\n\\nexport let emit_export_section = (out: Bytes, name: String, func_idx: Int) -> Unit {\\n  emit_export_section_multi(out, [\\n    name\\n  ], [\\n    func_idx\\n  ])\\n}\\n\")\n\n  let source_36 = (\"vibe/compiler/codegen/wasm_emit/code_helpers.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\\n  bytebuf_length, bytebuf_new, bytebuf_push, bytebuf_push_buf, bytebuf_push_opcode_s64, bytebuf_push_section, bytebuf_push_vec_header, leb128_encode_u32\\n}\\n\\n//# Functions\\n\\nexport let emit_end = (buf: Bytes) -> Unit {\\n  bytebuf_push(buf, 11)\\n}\\n\\nexport let emit_i32_const = (buf: Bytes, value: Int) -> Unit {\\n  bytebuf_push_opcode_s64(buf, 65, value)\\n}\\n\\nexport let emit_code_section = (out: Bytes, bodies: Array[Bytes]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let func_buf = bytebuf_new()\\n    leb128_encode_u32(func_buf, 0)\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\\nexport let emit_memory_section = (out: Bytes, min_pages: Int) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, 1)\\n  bytebuf_push(content, 0)\\n  leb128_encode_u32(content, min_pages)\\n  bytebuf_push_section(out, 5, content)\\n}\\n\\nexport let emit_code_section_with_locals = (out: Bytes, bodies: Array[Bytes], local_counts: Array[Int]) -> Unit {\\n  let content = bytebuf_new()\\n  bytebuf_push_vec_header(content, Array::length(bodies))\\n  let mut i = 0\\n  while i < Array::length(bodies) {\\n    let body = Array::get(bodies, i)\\n    let num_locals = Array::get(local_counts, i)\\n    let func_buf = bytebuf_new()\\n    if num_locals == 0 {\\n      leb128_encode_u32(func_buf, 0)\\n    } else {\\n      leb128_encode_u32(func_buf, 1)\\n      leb128_encode_u32(func_buf, num_locals)\\n      bytebuf_push(func_buf, 126)\\n    }\\n    bytebuf_push_buf(func_buf, body)\\n    bytebuf_push(func_buf, 11)\\n    leb128_encode_u32(content, bytebuf_length(func_buf))\\n    bytebuf_push_buf(content, func_buf)\\n    i = i + 1\\n  }\\n  bytebuf_push_section(out, 10, content)\\n}\\n\")\n\n  let source_37 = (\"vibe/compiler/codegen/wasm_emit/extra.vibe\",\n\"//# Imports\\n\\nimport .. / .. / core {\